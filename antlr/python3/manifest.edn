 ;; Every Java helper gets `package yang.python.antlr.gen;` prepended.
 ;; Exact-text replacements, applied in order after that. Upstream builds
 ;; NEWLINE and DEDENT with CommonToken(start, stop) at the end of the
 ;; newline-plus-indentation lexeme and never sets their text, so ANTLR reads
 ;; their text back from whatever source sits there: a NEWLINE before an
 ;; INDENT reads a space, and a DEDENT reads the newline it follows. The patch
 ;; puts NEWLINE on its newline characters and makes DEDENT zero-width
 ;; (stop = start - 1), so every token's span is the source it came from.
 :patches
 {"Java/Python3LexerBase.java"
  [["            emit(commonToken(Python3Lexer.NEWLINE, newLine));"
    "            emit(positionedToken(Python3Lexer.NEWLINE, this._tokenStartCharIndex, this._tokenStartCharIndex + newLine.length() - 1));"]
   ["        CommonToken dedent = commonToken(Python3Lexer.DEDENT, \"\");"
    "        CommonToken dedent = positionedToken(Python3Lexer.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);"]
   ["            this.emit(commonToken(Python3Lexer.NEWLINE, \"\\n\"));"
    "            this.emit(positionedToken(Python3Lexer.NEWLINE, this.getCharIndex(), this.getCharIndex() - 1));"]
   ["    private CommonToken commonToken(int type, String text) {"
    "    private CommonToken positionedToken(int type, int start, int stop) {\n        return new CommonToken(this._tokenFactorySourcePair, type, DEFAULT_TOKEN_CHANNEL, start, stop);\n    }\n\n    private CommonToken commonToken(int type, String text) {"]]},
