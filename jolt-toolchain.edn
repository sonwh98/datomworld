;; The jolt host lane's toolchain declaration
;; (docs/design/yin.repl-jolt-implementation.md §6.1, §6.4).
;;
;; `bb bootstrap:jolt` materializes exactly this into build/tools/jolt and
;; verifies it; ordinary runs never pull. Changing any pin here goes through
;; the upgrade gate (`qualify:jolt-upgrade`, §6.4), never silently.
{:jolt
 {:origin "https://github.com/jolt-lang/jolt"
  :sha "96d7b8662d7c491722445bf976b2e25e36ce5d63"
  :committed "2026-10-19T08:26:43-04:00"
  ;; ruling 4 (§13.4): kept although untagged
  :tag :none
  :nearest-release-tag {:tag "v0.8.23"
                        :sha "a0ac71c3f638fe55158bd01b4ecbb0dd3d7545e5"}
  :describe "vnightly-16-g96d7b866"
  :dir "build/tools/jolt"
  ;; recursive submodule SHAs at :sha (git submodule status --recursive);
  ;; bootstrap refuses a checkout whose submodules differ
  :submodules {"vendor/cli" "14f07644080070246974942415a104228d9a6b04"
               "vendor/clojure-test-suite" "489b6743e8421687ef96cec557830acf258d1886"
               "vendor/fs" "5b273b8a943a622593fbc85fca6761c5a39d6d66"
               "vendor/grenadine" "688e0ed6618582eccc8c8b745243ceac92835e03"
               "vendor/irregex" "c948a704fc732914a243c1643bfe359913d11c7b"
               "vendor/process" "43bdd65e189f2ccacc56662c53a21f5470ff1500"
               "vendor/sci" "32d62a5136ad3dc148588752f5bcc4cc30b14752"}
  ;; proposed default 2 (§13.2): none recorded, so none applied
  :patches []}

 ;; Host OS packages (owner 2026-10-20: Linux = the Debian family with apt).
 ;; `bb bootstrap:jolt` checks :required with dpkg-query on hosts whose
 ;; /etc/os-release ID or ID_LIKE names debian, BEFORE anything mise builds,
 ;; and fails naming the missing packages and the exact
 ;; `sudo apt-get install -y ...` command. It never runs sudo or apt.
 ;; :unverified entries are candidates with no step shown to need them yet;
 ;; they are listed, not checked. Chez and CMake stay mise-provided.
 :os-packages
 {:debian
  {:required
   {;; mise builds Chez 10.4.1 from source and links it against ncurses;
    ;; verified on shiva (Ubuntu 24.04.5): "cannot find -lncurses" until
    ;; this was installed (docs/orchestrator-log.md, J0b-on-shiva entry)
    "libncurses-dev" "mise Chez source build (link)"
    ;; Chez's expression editor (c/expeditor.c:1189-1212) reads the X11
    ;; clipboard; verified on jupiter (Ubuntu 24.04.5): the build failed with
    ;; "c/expeditor.c:1191: fatal error: X11/Xlib.h: No such file or
    ;; directory" until this was installed (shiva had the headers already,
    ;; so it never failed there). Chez's configure also offers --disable-x11
    ;; and --disable-curses, which the mise plugin does not pass.
    "libx11-dev" "mise Chez source build (compile, X11 clipboard in the editor)"
    ;; the same Chez source build compiles and links C (the failing step
    ;; above was its link); present on shiva, so not independently shown
    "gcc" "mise Chez source build (C compiler)"
    "make" "mise Chez source build (make)"
    ;; bootstrap:jolt clones jolt and its submodules (src/dev/jolt_bootstrap.clj)
    "git" "bootstrap:jolt clone and verification"
    ;; J1b: native/jolt-crypto compiles against the libcrypto headers
    ;; (openssl/evp.h) and links the declared :native :libcrypto path
    "libssl-dev" "J1b native build (libcrypto headers and link, native/jolt-crypto)"}
   ;; J1b runtime: the package owning the declared libcrypto.so.3 differs per
   ;; release, so any ONE of these satisfies it (dpkg -S on shiva, Ubuntu
   ;; 24.04: libssl3t64; Debian bookworm and Ubuntu 22.04: libssl3). Checked
   ;; by `bb build:jolt-native`, not by `bb bootstrap:jolt` (which checks
   ;; :required only). The library itself is checked against :native
   ;; :libcrypto :qualified.
   :runtime-any-of
   {"libcrypto.so.3 (J1b dao.host.hash/sign)" ["libssl3t64" "libssl3"]}
   :unverified
   {;; J0c native build (jolt-j0c branch, bb build:jolt-native) compiles the
    ;; ANTLR4 C++ runtime and wrapper and unzips the runtime source; shown on
    ;; macOS only, not yet on a Debian host
    "g++" "J0c native build (C++ compiler)"
    "unzip" "J0c native build (runtime source archive)"}}
  ;; Homebrew is assumed on macOS and not enforced; the libcrypto it provides
  ;; is checked by path and version instead (:native :libcrypto, J1b).
  :macos {:manager :homebrew :enforced false
          :packages {"openssl@3" "libcrypto for dao.host.hash/sign (J1b)"}}}

 ;; Provisioned by mise from the exact pins in mise.toml. JOLT_CHEZ is always
 ;; set explicitly (build/tools/jolt-env.sh), never left to jolt's PATH search.
 :chez {:version "10.4.1"
        :provider :mise
        :mise-tool "chezscheme"
        :threaded true
        :binary "bin/scheme"}
 :cmake {:version "4.4.4"
         :provider :mise
         :mise-tool "cmake"}

 ;; Recorded at J0a round 1 on the platforms actually run.
 :observed
 {:macos-arm64 {:os "macOS 26.6.2 (25G83)"
                :chez-path "~/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme"
                :cmake-path "~/.local/share/mise/installs/cmake/4.4.4/cmake-4.4.4-macos-universal/CMake.app/Contents/bin/cmake"
                :cc "Apple clang version 21.0.0 (clang-2100.1.1.101)"
                ;; J1b, 2026-10-21 (Homebrew openssl@3)
                :libcrypto {:path "/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib"
                            :resolved "/opt/homebrew/Cellar/openssl@3/3.6.3/lib/libcrypto.3.dylib"
                            :version "OpenSSL 3.6.3 9 Jun 2026"}}
  ;; shiva.stigmergy.systems, J1b 2026-10-21 (scratch clone ~/ci/datomworld-jolt-j1b)
  :linux-x86_64 {:os "Ubuntu 24.04.5 LTS (kernel 6.8.0-147-generic)"
                 :chez-path "~/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme"
                 :cmake-path "~/.local/share/mise/installs/cmake/4.4.4/cmake-4.4.4-linux-x86_64/bin/cmake"
                 :cc "cc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0"
                 :libcrypto {:path "/usr/lib/x86_64-linux-gnu/libcrypto.so.3"
                             :resolved "/usr/lib/x86_64-linux-gnu/libcrypto.so.3"
                             :version "OpenSSL 3.0.13 30 Jan 2024"
                             :package "libssl3t64 3.0.13-0ubuntu3.16"}}}

 ;; Vendored native sources (§6.1, Q4): fetched by `bb build:jolt-native`
 ;; only when absent from build/native/src, accepted only at the pinned
 ;; SHA-256, built with the mise-pinned CMake into build/native/<platform>/.
 ;; Nothing downloads during namespace loading. :libcrypto is the one system
 ;; (not vendored) entry: declared by path and minimum version, never fetched.
 :native
 {:antlr4-cpp-runtime
  {:version "4.13.2"
   :license "BSD-3-Clause"
   ;; the official C++ runtime source distribution (antlr4 doc/cpp-target.md);
   ;; the GitHub release carries no C++ asset
   :url "https://www.antlr.org/download/antlr4-cpp-runtime-4.13.2-source.zip"
   :sha256 "0ed13668906e86dbc0dcddf30fdee68c10203dea4e83852b4edb810821bee3c4"
   :upstream {:repo "https://github.com/antlr/antlr4"
              :tag "4.13.2"
              :tag-object "2ac185af855ff39b4b8c41854b756767099c356f"
              :commit "cc82115a4e7f53d71d9d905caa2c2dfa4da58899"
              :path "runtime/Cpp"}
   ;; static, position-independent: linked into the one wrapper dylib that
   ;; jolt loads, so no second library or rpath is resolved at load time.
   ;; Tests off: ANTLR_BUILD_CPP_TESTS=ON downloads googletest at configure
   ;; time.
   :cmake-flags ["-DCMAKE_BUILD_TYPE=Release"
                 "-DANTLR_BUILD_CPP_TESTS=OFF"
                 "-DANTLR_BUILD_SHARED=OFF"
                 "-DANTLR_BUILD_STATIC=ON"
                 "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
                 "-DCMAKE_CXX_STANDARD=17"]}

  ;; §6.2: the upstream BLAKE3 C reference (c/ of the release), built static
  ;; and position-independent and linked into native/jolt-crypto. Portable C
  ;; only (BLAKE3_SIMD_TYPE=none, the option name verified in c/CMakeLists.txt
  ;; at this tag); SIMD is a later, separately measured change.
  :blake3
  {:version "1.8.7"
   :license "CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception"
   ;; GitHub's tag archive; downloaded twice 2026-10-21, both SHA-256 equal
   :url "https://github.com/BLAKE3-team/BLAKE3/archive/refs/tags/1.8.7.tar.gz"
   :sha256 "c6782a28842b1c0478524ac06a4f2ede784038ee298d6e2162c0b089c4306a3c"
   ;; saved under build/native/src by this name (the URL ends in 1.8.7.tar.gz)
   :archive-name "BLAKE3-1.8.7.tar.gz"
   :upstream {:repo "https://github.com/BLAKE3-team/BLAKE3"
              :tag "1.8.7"
              ;; a lightweight tag: refs/tags/1.8.7 names the commit directly
              :commit "f3149ec5bb5449af877ba20377a11008ff499fa2"
              :released "2026-08-20T09:06:20Z"
              :path "c"}
   :cmake-flags ["-DCMAKE_BUILD_TYPE=Release"
                 "-DBUILD_SHARED_LIBS=OFF"
                 "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
                 "-DCMAKE_INSTALL_LIBDIR=lib"
                 "-DBLAKE3_SIMD_TYPE=none"
                 "-DBLAKE3_USE_TBB=OFF"
                 "-DBLAKE3_FETCH_TBB=OFF"
                 "-DBUILD_TESTING=OFF"]}

  ;; §6.3 / Q4: the SYSTEM libcrypto, never vendored. native/jolt-crypto links
  ;; it by :path (install name on macOS, -rpath on Linux). Never Apple's
  ;; libcrypto (it aborts inside EVP_Digest).
  ;;
  ;; :qualified is the one library per platform that passed the J1b gates:
  ;; its canonical real path, exact OpenSSL_version_num and the SHA-256 of
  ;; the file. Any difference fails closed until requalified, so a Homebrew
  ;; or apt upgrade (new version, and on Homebrew a repointed opt/ link), and
  ;; a same-path, same-version package replacement (new digest) all refuse:
  ;;   * `bb build:jolt-native` (check-libcrypto!) fails on a canonical path
  ;;     or digest that differs (it cannot read the version without loading
  ;;     the library);
  ;;   * loading dao.host.hash fails on canonical path, version or digest, as
  ;;     the wrapper reports them for the library the EVP entries resolved to.
  ;; :min-version is separate: the lowest version a requalification may
  ;; accept.
  ;;
  ;; Requalification (the upgrade gate, §6.4), on the platform that changed:
  ;;   1. `bb build:jolt-native --requalify` (builds against the changed
  ;;      library; skips only the :qualified comparison, and says so in the
  ;;      build record);
  ;;   2. `bb qualify:jolt-libcrypto` prints the observed {:canonical-path
  ;;      :version-num :version :sha256} (the digest computed by bb and by
  ;;      the library, required equal; the version at least :min-version)
  ;;      and changes nothing;
  ;;   3. replace this platform's :qualified entry with it, review the diff;
  ;;   4. `bb build:jolt-native`, `bb compare:jolt-host`, `bb
  ;;      probe:jolt-crypto`, all of which must pass.
  :libcrypto
  {:provider :system
   :soname {:darwin-arm64 "libcrypto.3.dylib" :linux-x86_64 "libcrypto.so.3"}
   :path {:darwin-arm64 "/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib"
          :linux-x86_64 "/usr/lib/x86_64-linux-gnu/libcrypto.so.3"}
   :include {:darwin-arm64 "/opt/homebrew/opt/openssl@3/include"
             :linux-x86_64 "/usr/include"}
   :min-version "3.0.0"
   ;; qualified 2026-10-21 (J1b): macOS from this checkout, Linux on shiva
   :qualified
   {:darwin-arm64 {:canonical-path "/opt/homebrew/Cellar/openssl@3/3.6.3/lib/libcrypto.3.dylib"
                   :version-num 811597872
                   :version "OpenSSL 3.6.3 9 Jun 2026"
                   :sha256 "a12805a18cd5e4f733fa8727b91afa08b587f9da5a760517cd79cb508a3a3f71"}
    :linux-x86_64 {:canonical-path "/usr/lib/x86_64-linux-gnu/libcrypto.so.3"
                   :version-num 805306576
                   :version "OpenSSL 3.0.13 30 Jan 2024"
                   :sha256 "6866ed711dab8927e1bf82bf1cd30e828bdfc34f3cc1e83b1c9eb01ce6c37d9a"}}
   ;; Debian runtime packages: checked by `bb build:jolt-native`, NOT by
   ;; `bb bootstrap:jolt` (which checks only :os-packages :debian :required,
   ;; libssl-dev among them); macOS: Homebrew openssl@3, unenforced
   :debian-runtime-any-of ["libssl3t64" "libssl3"]}}}
