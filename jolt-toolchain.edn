;; The jolt host lane's toolchain declaration
;; (docs/design/yin.repl-jolt-implementation.md §6.1, §6.4).
;;
;; `bb bootstrap:jolt` materializes exactly this into build/tools/jolt and
;; verifies it; ordinary runs never pull. Changing any pin here goes through
;; the upgrade gate (`qualify:jolt-upgrade`, §6.4), never silently.
{:jolt
 {:origin "https://github.com/jolt-lang/jolt"
  :sha "96d7b8662d7c491722445bf976b2e25e36ce5d63"
  :committed "2026-10-19T08:26:43-04:00"
  ;; ruling 4 (§13.4): kept although untagged
  :tag :none
  :nearest-release-tag {:tag "v0.8.23"
                        :sha "a0ac71c3f638fe55158bd01b4ecbb0dd3d7545e5"}
  :describe "vnightly-16-g96d7b866"
  :dir "build/tools/jolt"
  ;; recursive submodule SHAs at :sha (git submodule status --recursive);
  ;; bootstrap refuses a checkout whose submodules differ
  :submodules {"vendor/cli" "14f07644080070246974942415a104228d9a6b04"
               "vendor/clojure-test-suite" "489b6743e8421687ef96cec557830acf258d1886"
               "vendor/fs" "5b273b8a943a622593fbc85fca6761c5a39d6d66"
               "vendor/grenadine" "688e0ed6618582eccc8c8b745243ceac92835e03"
               "vendor/irregex" "c948a704fc732914a243c1643bfe359913d11c7b"
               "vendor/process" "43bdd65e189f2ccacc56662c53a21f5470ff1500"
               "vendor/sci" "32d62a5136ad3dc148588752f5bcc4cc30b14752"}
  ;; proposed default 2 (§13.2): none recorded, so none applied
  :patches []}

 ;; Provisioned by mise from the exact pins in mise.toml. JOLT_CHEZ is always
 ;; set explicitly (build/tools/jolt-env.sh), never left to jolt's PATH search.
 :chez {:version "10.4.1"
        :provider :mise
        :mise-tool "chezscheme"
        :threaded true
        :binary "bin/scheme"}
 :cmake {:version "4.4.4"
         :provider :mise
         :mise-tool "cmake"}

 ;; Recorded at J0a round 1 on the platforms actually run.
 :observed
 {:macos-arm64 {:os "macOS 26.6.2 (25G83)"
                :chez-path "~/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme"
                :cmake-path "~/.local/share/mise/installs/cmake/4.4.4/cmake-4.4.4-macos-universal/CMake.app/Contents/bin/cmake"
                :cc "Apple clang version 21.0.0 (clang-2100.1.1.101)"}
  ;; shiva.stigmergy.systems: not yet provisioned or run
  :linux-x86_64 nil}

 ;; Vendored native sources (§6.1, Q4): fetched by `bb build:jolt-native`
 ;; only when absent from build/native/src, accepted only at the pinned
 ;; SHA-256, built with the mise-pinned CMake into build/native/<platform>/.
 ;; Nothing downloads during namespace loading. Not yet declared: libblake3
 ;; and the libcrypto path/version per platform.
 :native
 {:antlr4-cpp-runtime
  {:version "4.13.2"
   :license "BSD-3-Clause"
   ;; the official C++ runtime source distribution (antlr4 doc/cpp-target.md);
   ;; the GitHub release carries no C++ asset
   :url "https://www.antlr.org/download/antlr4-cpp-runtime-4.13.2-source.zip"
   :sha256 "0ed13668906e86dbc0dcddf30fdee68c10203dea4e83852b4edb810821bee3c4"
   :upstream {:repo "https://github.com/antlr/antlr4"
              :tag "4.13.2"
              :tag-object "2ac185af855ff39b4b8c41854b756767099c356f"
              :commit "cc82115a4e7f53d71d9d905caa2c2dfa4da58899"
              :path "runtime/Cpp"}
   ;; static, position-independent: linked into the one wrapper dylib that
   ;; jolt loads, so no second library or rpath is resolved at load time.
   ;; Tests off: ANTLR_BUILD_CPP_TESTS=ON downloads googletest at configure
   ;; time.
   :cmake-flags ["-DCMAKE_BUILD_TYPE=Release"
                 "-DANTLR_BUILD_CPP_TESTS=OFF"
                 "-DANTLR_BUILD_SHARED=OFF"
                 "-DANTLR_BUILD_STATIC=ON"
                 "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
                 "-DCMAKE_CXX_STANDARD=17"]}}}
