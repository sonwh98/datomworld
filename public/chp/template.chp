[:html {:lang "en"}
 [:head
  [:meta {:charset "utf-8"}]
  [:meta {:name "viewport" :content "width=device-width, initial-scale=1"}]
  [:title :template/title]
  [:link {:rel "preconnect" :href "https://fonts.googleapis.com"}]
  [:link {:rel "preconnect" :href "https://fonts.gstatic.com" :crossorigin true}]
  [:link {:href "https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap"
          :rel "stylesheet"}]
  [:link {:rel "stylesheet" :href "/css/datomworld.css"}]
  [:link {:rel "stylesheet"
          :href "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/night-owl.min.css"}]]
 [:body.page
  [:header.site-header
   [:div.section-inner
    [:a.brand {:href "/"}
     [:span.brand-mark "☯"]
     [:span.brand-name "Datom.World"]]
    [:nav.primary-nav
     [:a {:href "/yin.chp"} "Yin"]
     [:a {:href "/yang.chp"} "Yang"]
     [:a {:href "/dao-stream.chp"} "DaoStream"]
     [:a {:href "/dao-jing.chp"} "DaoJing"]
     [:a {:href "/dao-space.chp"} "DaoSpace"]
     [:a {:href "/post-graphics.chp"} "PostGraphics"]
     [:a {:href "/shibi.chp"} "Shibi"]
     [:a {:href "/blog/index.chp"} "Blog"]
     [:a {:href "/faq.chp"} "FAQ"]
     [:a.nav-icon {:href "https://github.com/sonwh98/datomworld" :title "GitHub" :target "_blank" :rel "noreferrer"}
      [:svg {:viewBox "0 0 24 24" :width "18" :height "18" :fill "currentColor"}
       [:path {:d "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"}]]]
     [:a.btn.btn-nav {:href "/demo.html"} "Live Demo"]]]]
  [:main#top
   :template/content]
  [:footer.site-footer
   [:div.section-inner
    [:div.footer-grid
     [:div.footer-col-main
      [:div.footer-brand
       [:span.brand-mark "☯"]
       [:span.brand-text "Datom.World"]]
      [:p.footer-tagline "A sovereign computational paradigm built on immutable tuples and continuous streams."]]
     [:div.footer-col
      [:h4 "Architecture"]
      [:ul
       [:li [:a {:href "/yin.chp"} "Yin VM"]]
       [:li [:a {:href "/yang.chp"} "Yang Compiler"]]
       [:li [:a {:href "/dao-stream.chp"} "DaoStream"]]
       [:li [:a {:href "/dao-jing.chp"} "DaoJing"]]
       [:li [:a {:href "/dao-space.chp"} "DaoSpace"]]]]
     [:div.footer-col
      [:h4 "Ecosystem"]
      [:ul
       [:li [:a {:href "/post-graphics.chp"} "PostGraphics"]]
       [:li [:a {:href "/shibi.chp"} "Shibi Anti-Spam"]]
       [:li [:a {:href "/demo.html"} "Browser Demo"]]
       [:li [:a {:href "/blog/index.chp"} "Research Blog"]]]]
     [:div.footer-col
      [:h4 "Source & Protocol"]
      [:ul
       [:li [:a {:href "https://github.com/sonwh98/datomworld" :target "_blank" :rel "noreferrer"} "GitHub Repo"]]
       [:li [:a {:href "/faq.chp"} "Frequently Asked"]]
       [:li [:a {:href "mailto:hello@datom.world"} "Contact"]]]]]
    [:div.footer-bottom
     [:p "© " [:span {:id "year"}] " Datom.World. Crafted for collective and synthetic intelligence."]
     [:script "document.getElementById('year').textContent = new Date().getFullYear();"]]]]
  [:script {:src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"}]
  [:script {:src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/clojure.min.js"}]
  [:script "hljs.highlightAll();"]]]
