           [:li
            [:a {:href "/blog/datomworld-as-kernel-os.blog"} "Datom.World as an Operating System: A Kernel Built From Streams, Interpreters, and Yin.vm Isolation"]]
           [:li
            [:a {:href "/yin.chp"} "Yin VM"]
            " and "
            [:a {:href "/dao-stream.chp"} "DaoStream"]]]]]]}
