=================\n   103\t\n   104\t(defn- entities\n   105\t  [datoms]\n   106\t  (reduce (fn [acc [e a val]] (assoc-in acc [e a] val)) {} datoms))\n   107\t\n   108\t\n   109\t(defn- instructions\n   110\t  \"Instruction entities in pc order, each with its eid under :e.\"\n   111\t  [code-datoms]\n   112\t  (->> (entities code-datoms)\n   113\t       (keep (fn [[e attrs]] (when (:yin.code/op attrs) (assoc attrs :e e))))\n   114\t       (sort-by :yin.code/pc)\n   115\t       vec))\n   116\t\n   117\t\n   118\t(defn- segment\n   119\t  [code-datoms]\n   120\t  (let [[[e attrs]] (filter #(= :segment (:yin.code/type (val %)))\n   121\t                            (entities code-datoms))]\n   122\t    (assoc attrs :e e)))\n   123\t\n   124\t\n   125\t(defn- lowered\n   126\t  \"An AST, its datoms and root, and the code lowered from those datoms.\"\n   127\t  [ast]\n   128\t  (let [[root ast-datoms] (vm/ast->datoms-with-root ast)]\n   129\t    {:root root, :ast-datoms ast-datoms, :code (linearize/lower ast-datoms)}))\n   130\t\n   131\t\n   132\t;; =============================================================================\n   133\t;; Structural contract\n   134\t;; =============================================================================\n   135\t\n   136\t(deftest lowered-segments-are-well-formed\n   137\t  (doseq [[label ast] corpus]\n   138\t    (testing label\n   139\t      (is (nil? (code/well-formed? (:code (lowered ast))))))))\n   140\t\n   141\t\n   142\t(deftest pcs-are-dense\n   143\t  (doseq [[label ast] corpus]\n   144\t    (testing label\n   145\t      (let [code (:code (lowered ast))\n   146\t            insts (instructions code)\n   147\t            seg (segment code)]\n   148\t        (is (= 1 (count (filter #(= :yin.code/type (second %)) code))))\n   149\t        (is (= (count insts) (:yin.code/length seg)))\n   150\t        (is (= (range (:yin.code/length seg)) (map :yin.code/pc insts)))\n   151\t        (is (= (map :yin.code/pc insts)\n   152\t