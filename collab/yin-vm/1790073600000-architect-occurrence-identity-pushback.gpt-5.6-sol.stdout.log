type :vm/resume, :parked-id :p2, :val (lit 1)}\n   698\t      {:type :dao.stream.apply/call, :op :op/echo, :operands [(lit 1)]}\n   699\t      {:type :dao.stream.apply/call, :op :op/ping, :operands [(lit 1)]}\n   700\t      (lam '[x] (v 'x))\n   701\t      {:type :lambda, :macro? true, :params '[x], :body (v 'x)})))\n   702\t\n   703\t\n   704\t(deftest operand-order-changes-the-hash\n   705\t  (let [left (project (app (v 'f) (v 'x) (v 'y)))\n   706\t        right (project (app (v 'f) (v 'y) (v 'x)))]\n   707\t    (is (not= (:fingerprint left) (:fingerprint right)))\n   708\t    (is (not= (:records left) (:records right)))))\n   709\t\n   710\t\n   711\t(deftest tree-and-graph-emission-are-one-merkle-graph\n   712\t  (let [shared (assoc (lam '[x] (v 'x)) :eid -60)\n   713\t        graph (project (app (v 'list) shared shared))\n   714\t        tree (project (app (v 'list) (lam '[x] (v 'x)) (lam '[x] (v 'x))))]\n   715\t    (is (= (:records tree) (:records graph)))\n   716\t    (is (= (:fingerprint tree) (:fingerprint graph)))\n   717\t    (is (= 4 (count (:records graph)))\n   718\t        \"app, free list, one hash-consed lambda, its bound body\")))\n   719\t\n   720\t\n   721\t(deftest equal-subterms-hash-cons-to-one-record\n   722\t  (let [p (project (app (v 'f) (lam '[x] (v 'x)) (lam '[y] (v 'y))))\n   723\t        lambdas (filter #(= :lambda (:yin.debruijn/type %)) (vals (:records p)))]\n   724\t    (is (= 1 (count lambdas))\n   725\t        \"two alpha-equal source lambdas are one projected record\")\n   726\t    (is (= 4 (count (:records p))))))\n   727\t\n   728\t\n   729\t(deftest shared-under-unequal-contexts-hash-differently\n   730\t  (let [body (assoc (v 'x) :eid -41)\n   731\t        p (project (app (v 'list) (lam '[x] body) (lam '[y] body)))\n   732\t        vars (vals (:records p))\n   733\t        bound-h (:yin.debruijn/hash (some #(when (:yin.debruijn/bound %) %) vars))\n   734\t        free-h (:yin.debruijn/hash (some #(when (= 'x (:yin.debruijn/free %)) %) vars))]\n   735\t    (is (not= bound-h free-h))\n   736\t    (is (= 6 (count (:records p)))\n   737\t        \"the two lambdas stay distinct: their bodies differ by resolution\")))\n   738\t\n   739\t\n   740\t(deftest the-storage-adapter-round-trips\n   741\t  (let [p (project every-type)\n   742\t        ds (d/projected->datoms p)\n   743\t        by-entity (group-by first ds)\n   744\t        roots (filter #(= :yin.debruijn/root (nth % 1)) ds)\n   745\t        root-e (first (first roots))\n  1315\t  (let [p (project (app (v 'f)\n  1316\t                        {:type :lambda, :macro? true, :params '[x], :body (v 'x)}\n  1317\t                        (lit false)\n  1318\t                        (lit nil)\n  1319\t                        (lit #{\"a\" 1 :k})\n  1320\t                        (lit (list 1.5 -0.0 (/ 0.0 0.0)))\n  1321\t                        (lit {\"é\" [1 2.5]})))]\n  1322\t    (is (= (:fingerprint p)\n  1323\t           (:fingerprint (d/datoms->projected (d/projected->datoms p))))\n  1324\t        \"the gate adds nothing the writer does not already guarantee: false\n  1325\t         literals, nil, a true :macro?, sets, doubles, NaN, and NFC keys\n  1326\t         round-trip\")))\n  1327\t\n  1328\t\n  1329\t(defn- doubling-chain\n  1330\t  \"`depth` applications, each of whose two operands is the previous\n  1331\t   level — ONE shared source entity per level, so the unfolded term has\n  1332\t   2^depth leaves while the emitted graph grows linearly.\"\n  1333\t  [depth]\n  1334\t  (reduce (fn [prev k]\n  1335\t            (assoc (app (v 'f) prev prev) :eid (- -1000 k)))\n  1336\t          (assoc (lit 0) :eid -999)\n  1337\t          (range depth)))\n  1338\t\n  1339\t\n  1340\t(defn- doubling-tree\n  1341\t  [depth]\n  1342\t  (reduce (fn [prev _] (app (v 'f) prev prev)) (lit 0) (range depth)))\n  1343\t\n  1344\t\n  1345\t(deftest shared-subgraphs-are-minted-once\ntest/yin/vm/debruijn_test.cljc:457:(deftest shared-nodes-resolve-per-their