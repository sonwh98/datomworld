{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Diny5J7EcX233SBMqDez3R","type":"tool_result","content":"640\t            (is (= (:medium c) (get-in c' [:holder-configs \"h9\" :medium]))))))\n641\t      (finally\n642\t        (cleanup-world! w)))))\n643\t\n644\t\n645\t(deftest a-stopped-composition-receives-its-holders-stopped-and-runs-no-program-test\n646\t  (let [w (exclusive-world)]\n647\t    (try\n648\t      (let [c (drive (:c w) \"h1\" (phase-of :running) 60)\n649\t            c (compose/hand-off c \"h1\")\n650\t            c (drive c \"h1\" (phase-of :exited) 60)\n651\t            st (get-in c [:holders \"h1\"])\n652\t            address (get-in st [:detail :yin.k/address])\n653\t            bytes ((:get-bytes-fn (:store w)) address ::absent)\n654\t            c (compose/stop c)]\n655\t        (is (= c (compose/program-step c))\n656\t            \"the composition's own latch: program stepping is a no-op once\n657\t             stop has latched\")\n658\t        (testing \"a holder added after the latch arrives stopped\"\n659\t          (let [c' (compose/holder c \"h2\" (merge (holder-seams \"prog-c\" {\"prog-c\" (:prog w)})\n660\t                                                 {:bytes bytes :address address}))]\n661\t            (is (true? (get-in c' [:holders \"h2\" :stopped?]))\n662\t                \"the late holder was latched at its addition\")\n663\t            (let [stepped (reduce (fn [c _] (compose/step c)) c' (range 5))]\n664\t              (is (= :validating (:phase (get-in stepped [:holders \"h2\"])))\n665\t                  \"five whole ticks later it never validated: no program\n666\t                   work ran for it\")\n667\t              (is (= :exited (:phase (get-in stepped [:holders \"h1\"])))))))\n668\t        (testing \"a source added after the latch arrives stopped\"\n669\t          (let [c' (compose/source c \"h3\" (merge (holder-seams \"prog-c\" {})\n670\t                                                 {:machine (parked-reader-over\n671\t                                                             (int-stream \"prog-c\"))}))]\n672\t            (is (true? (get-in c' [:holders \"h3\" :stopped?]))\n673\t                \"the late source was latched at its addition\")\n674\t            (let [stepped (reduce (fn [c _] (compose/step c)) c' (range 5))]\n675\t              (is (= :exporting (:phase (get-in stepped [:holders \"h3\"])))\n676\t                  \"five whole ticks later its export never began: no\n677\t                   program work ran for it\")))))\n678\t      (finally\n679\t        (cleanup-world! w)))))\n680\t\n681\t\n682\t(deftest a-source-index-is-checked-at-open-test\n683\t  (doseq [mode [:fork :exclusive]\n684\t          index [nil {}]]\n685\t    (let [cfg {:mode mode :source-index index\n686\t               :renewal-interval {:s 10}\n687\t               :store (mem/create-content-mem)\n688\t               :diagnostics (log-writer)\n689\t               :medium \"compose-test\"\n690\t               :clock (fn [] {:s 1})\n691\t               :failure-model :process-crash\n692\t               :backend (journal/memory-backend (atom []) nil)\n693\t               :duration {:s 30}}]\n694\t      (is (thrown-with-msg?\n695\t            #?(:cljd Object :clj Exception :cljs js/Error)\n696\t            #\"source index\"\n697\t            (compose/open! (if (nil? index) (dissoc cfg :source-index) cfg)))))))\n698\t\n699\t\n700\t(deftest a-journal-substrate-is-checked-at-open-test\n701\t  (let [open! (fn [journals]\n702\t                (compose/open! {:source-index (fn [] @s/source-index)\n703\t                                :mode :fork\n704\t                                :renewal-interval {:s 10}\n705\t                                :store (mem/create-content-mem)\n706\t                                :diagnostics (log-writer)\n707\t                                :medium \"compose-test\"\n708\t                                :clock (fn [] {:s 1})\n709\t                                :journals journals}))\n710\t        exclusive! (fn [journals]\n711\t                     (compose/open! {:source-index (fn [] @s/source-index)\n712\t                                     :mode :exclusive\n713\t                                     :failure-model :process-crash\n714\t                                     :backend (journal/memory-backend\n715\t                                                (atom []) nil)\n716\t                                     :duration {:s 30}\n717\t                                     :renewal-interval {:s 10}\n718\t                                     :store (mem/create-content-mem)\n719\t                                     :diagnostics (log-writer)\n720\t                                     :medium \"compose-test\"\n721\t                                     :clock (fn [] {:s 1})\n722\t                                     :journals journals}))\n723\t        memory (fn [_holder] (journal/memory-backend (atom []) nil))]\n724\t    (is (thrown-with-msg?\n725\t          #?(:cljd Object :clj Exception :cljs js/Error)\n726\t          #\"a journal substrate\"\n727\t          (open! 42)))\n728\t    (is (thrown-with-msg?\n729\t          #?(:cljd Object :clj Exception :cljs js/Error)\n730\t          #\"a journal substrate\"\n731\t          (open! {:progress-backend! 7}))\n732\t        \"the substrate's suppliers are (fn [holder] backend)\")\n733\t    (testing \"an exclusive composition requires the substrate: nil, empty, partial and undeclared each refuse at open\"\n734\t      (let [refused {:yin.k/status :yin.k/unsatisfied\n735\t                     :yin.k/reason :journals-uncapable\n736\t                     :yin.k/policy :yin.k/exclusive}\n737\t            refuse (fn [journals]\n738\t                     (select-keys (exclusive! journals)\n739\t                                  [:yin.k/status :yin.k/reason :yin.k/policy]))]"}]},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"449