arrier outcome]\n628\t   :lives\n629\t   [(fn [_]\n630\t      {:on :src :kind :parked :inbound {\"h1\" :answering}\n631\t       :ops [[:carrier outcome]\n632\t             [:source \"h1\"]\n633\t             [:until-journal \"h1\" :yin.k/attempt :yin.k/offer 30 :step]\n634\t             [:abort \"h1\"]\n635\t             [:snapshot :after-abort]\n636\t             [:die :after-abort]]})\n637\t    (fn [_]\n638\t      {:on :rcv :kind :parked\n639\t       :ops (if (contains? #{:dao.stream/full :dao.stream/refused} outcome)\n640\t              [[:source \"h1\"] [:ticks 10]]\n641\t              [[:source \"h1\"]\n642\t               [:abort \"h1\"]\n643\t               [:snapshot :restarted-abort]\n644\t               [:ticks 30]])})]\n645\t   :check\n646\t   (fn [results inspection]\n647\t     (let [[l1 l2] results\n648\t           legal? (contains? #{:dao.stream/full :dao.stream/refused} outcome)\n649\t           st (get-in (snapshot-of l1 :after-abort) [:holders \"h1\"])\n650\t           journal (get-in inspection [:journals \"h1\"])\n651\t           o (:yin.k/occurrence (first (records journal :yin.k/minted nil)))\n652\t           attempts (records journal :yin.k/attempt :yin.k/offer)\n653\t           p (:projection inspection)]\n654\t       (is (:killed? l1))\n655\t       (is (some #(= outcome (:yin.k/append %)) attempts) \"the attempt journaled the carrier's answer\")\n656\t       (if legal?\n657\t         (do (is (= :aborted (:phase st)) (pr-str st))\n658\t             (is (= {:yin.k/aborted o} (:detail st)))\n659\t             (is (seq (records journal :yin.k/aborted nil)) \"the abort is durable\")\n660\t             (is (= :aborted (:phase (holder l2 \"h1\"))) \"an aborted export stays aborted across the kill\")\n661\t             (is (nil? (get-in p [:occurrences o])) \"the authority never heard of it\"))\n662\t         (do (is (= :yin.k/refused (:status st)))\n663\t             (is (= {:yin.k/reason :offer-possibly-accepted} (:detail st)))\n664\t             (is (empty? (records journal :yin.k/aborted nil)))\n665\t             (is (= {:yin.k/reason :restarted}\n666\t                    (get-in (snapshot-of l2 :restarted-abort) [:holders \"h1\" :detail])))\n667\t             (is (= :running (:phase (holder l2 \"h1\"))) \"the reopened export completes under its grant\")\n668\t             (is (= 1 (count (get-in p [:occurrences o :yin.k/variants]))))\n669\t             (is (= 1 (count (filter #(= o (:yin.k/occurrence %)) (vals (:leases p))))))))))})\n670\t\n671\t\n672\t;; =============================================================================\n673\t;; Row 1: one admitted holder over two encodings of O, two candidates\n674\t;; =============================================================================\n675\t\n676\t\n677\t(def row1\n678\t  {:id [:row-1]\n679\t   :holders [\"h1\" \"h2\" \"h3\"]\n680\t   :lives\n681\t   [(fn [_]\n682\t      {:on :src :kind :parked :cut :export/after-offer-ack\n683\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n684\t    (fn [_]\n685\t      ;; the second encoding is minted on the receiver host\n686\t      {:on :rcv :kind :parked\n687\t       :ops [[:source \"h1\"]\n688\t             [:offer-variant \"h1\"]\n689\t             [:candidate \"h2\" {:kind :fence :of \"h1\"}]\n690\t             [:candidate \"h3\" {:kind :variant}]\n691\t             [:until-some :running 90]\n692\t             [:ticks 10]\n693\t             [:snapshot :race]]})\n694\t    (fn [_]\n695\t      {:on :src :kind :parked :prog [\"B\"]\n696\t       :ops [[:source \"h1\"]\n697\t             [:until \"h1\" :running 90]\n698\t             [:snapshot :source-granted]\n699\t             [:until \"h1\" :safepoint 30]]})]\n700\t   :check\n701\t   (fn [results _inspection]\n702\t     (let [[l1 l2 l3] results\n703\t           race (snapshot-of l2 :race)\n704\t           hs (:holders race)\n705\t           running (filterv #(= :running (:phase (val %))) hs)\n706\t           o (:occurrence (second (first running)