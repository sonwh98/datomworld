{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PhtjkK778jfAMB9EQSCKhz","type":"tool_result","content":"940\t  \"Every reply the composition's front wrote into holder `h`'s reply\n941\t   journal (both tenures': the journal is durable).\"\n942\t  [c h]\n943\t  (journal-values (get-in c [:reply-journals h :journal])))\n944\t\n945\t\n946\t(defn holder-summary\n947\t  [st]\n948\t  (->data (merge (select-keys st [:phase :status :detail :occurrence :lease])\n949\t                 {:epoch (get-in st [:evidence :yin.k/binding :yin.k/epoch])\n950\t                  :next-op-seq (get-in st [:machine :yin.k/custody :yin.k/next-op-seq])\n951\t                  :stopped? (:stopped? st)\n952\t                  :machine? (some? (:machine st))})))\n953\t\n954\t\n955\t(defn snapshot\n956\t  \"Everything a check may read of the live world, as data.\"\n957\t  [ctx w]\n958\t  (let [c (:c w)\n959\t        hs (sort (keys (:holders c)))]\n960\t    {:holders (into {} (map (fn [h] [h (holder-summary (get-in c [:holders h]))])) hs)\n961\t     :policy (:yin.k/policy c)\n962\t     :projection (->data (projection-of c))\n963\t     :journals (into {} (map (fn [h] [h (->data (journal-records-of c h))])) hs)\n964\t     :replies (into {} (map (fn [h] [h (->data (replies-of c h))])) hs)\n965\t     :inbound (into {} (map (fn [h] [h (->data (inbound-of c h nil))])) hs)\n966\t     :targets (if-some [i (:target w)]\n967\t                {:target (->data i)\n968\t                 :values (->data (read-values (compose/target-reader c i)))}\n969\t                {})\n970\t     :outcomes (if-some [r (compose/outcome-reader c)]\n971\t                 (->data (read-values r))\n972\t                 [])\n973\t     :side (if-some [side (:side w)] (->data (read-values side)) [])\n974\t     :fences (into {}\n975\t                   (keep (fn [r]\n976\t                           (when (= :yin.k/fenced (:yin.k/journal r))\n977\t                             (let [a (:yin.k/address r)\n978\t                                   bs ((:get-bytes-fn (:store w)) a nil)]\n979\t                               [a (when bs (digest-of bs))]))))\n980\t                   (mapcat #(journal-records-of c %) hs))\n981\t     :packs (into {}\n982\t                  (keep (fn [r]\n983\t                          (when (= :yin.k/fenced (:yin.k/journal r))\n984\t                            (let [a (:yin.k/address r)\n985\t                                  bs ((:get-bytes-fn (:store w)) a nil)]\n986\t                              (when bs\n987\t                                (let [wire (cbor/decode bs)]\n988\t                                  [a {:root (:yin.k/root wire)\n989\t                                      :baseline (checkpoint/inspect a bs)\n990\t                                      :sorted? (= (mapv first (:yin.k/rows wire))\n991\t                                                  (vec (sort (map first (:yin.k/rows wire)))))\n992\t                                      :canonical-bytes (digest-of (cbor/encode (rows/emit (rows/decode wire))))}]))))))\n993\t                  (mapcat #(journal-records-of c %) hs))\n994\t     :diagnostics (->data (read-values (:diagnostics w)))\n995\t     :arbitration (->data (compose/arbitration c))\n996\t     :counts {:attaches @(:attaches ctx) :observes @(:observes ctx)}\n997\t     :clock @(:clock w)}))\n998\t\n999\t\n1000\t;; =============================================================================\n1001\t;; The life's program: plain-data operations over the composition\n1002\t;; =============================================================================\n1003\t\n1004\t\n1005\t(defn- durable-records\n1006\t  \"Holder `h`'s progress journal: through the composition when this life\n1007\t   composes `h`, else read from its durable directory (a holder a\n1008\t   previous life ran).\"\n1009\t  [w h]\n1010\t  (if (contains? (get-in w [:c :holders]) h)\n1011\t    (journal-records-of (:c w) h)\n1012\t    (let [b (open-file-backend! (str (:journals (paths (:root w))) \"/\" h \"-progress\"))]\n1013\t      (try\n1014\t        (journal-values (:dao.stream/handle (journal/open! b nil)))\n1015\t        (finally (file-journal/close! b))))))\n1016\t\n1017\t\n1018\t(defn- checkpoint-from\n1019\t  \"The checkpoint a candidate is added over, read from the durable\n1020\t   journal of `of` and the store: :fence the source's export, :successor\n1021\t   the exit's successor, or an explicit {:address a}.\"\n1022\t  [w {:keys [kind of address]}]\n1023\t  (let [records (durable-records w of)\n1024\t        fence (fn [o]\n1025\t                (some (fn [r]\n1026\t                        (when (and (= :yin.k/fenced (:yin.k/journal r))\n1027\t                                   (or (nil? o) (= o (:yin.k/occurrence r))))\n1028\t                          r))\n1029\t                      records))\n1030\t        address (case kind\n1031\t                  :fence (:yin.k/address (fence nil))\n1032\t                  :successor (let [mint (last (filter\n1033\t                                                (fn [r]\n1034\t                                                  (and (= :yin.k/minted (:yin.k/journal r))\n1035\t                                                       (= :yin.k/successor (:yin.k/role r))))\n1036\t                                                records))]\n1037\t                               (:yin.k/address (fence (:yin.k/occurrence mint))))\n1038\t                  :variant (:address (:variant w))\n1039\t                  :address address)\n1040\t        bs (when address ((:get-bytes-fn (:store w)) address nil))]\n1041\t    (when (nil? bs)\n1042\t      (throw (ex-info \"stage E: the checkpoint is absent from the store\"\n1043\t                      {:checkpoint {:kind kind :of of :address (->data address)}})))\n1044\t    {:address address :bytes bs}))\n1045\t\n1046\t\n1047\t(defn- inbound-for\n1048\t  \"Holder `h`'s inbound, when the life's spec names one: :answering, a\n1049\t   carrier whose appends answer the life's carrier outcome; :held, a\n1050\t   stream the front cannot read while the life holds the partition.\"\n1051\t  [w h]\n1052\t  (case (get (:inbound w) h)\n1053\t    :answering {:inbound (answering-inbound (str \"inbound-\" h) (:carrier w))}\n1054\t    :held {:inbound (held-inbound (str \"inbound-\" h) (:held w))}\n1055\t    nil))\n1056\t\n1057\t\n1058\t(defn- offer-variant!\n1059\t  \"A second encoding of the occurrence holder `h` fenced: the same root\n1060\t   with reversed rows in different canonical bytes, put in the store\n1061\t   and offered through `h`'s own inbound.  Answers {:address :bytes}.\"\n1062\t  [w h]\n1063\t  (let [{:keys [address bytes]} (checkpoint-from w {:kind :fence :of h})\n1064\t        body (cbor/decode bytes)\n1065\t        o (:yin.k/occurrence (checkpoint/inspect address bytes))\n1066\t        v-bytes (cbor/encode (update body :yin.k/rows #(vec (reverse %))))\n1067\t        v-address (rows/pack-address (cbor/decode v-bytes))]\n1068\t    ((:put-bytes-fn (:store w)) v-address v-bytes)\n1069\t    (stream/append! (get-in w [:c :inbounds h])\n1070\t                    {:yin.k/request :yin.k/offer\n1071\t                     :yin.k/request-id [:stage-e/variant (str address)]\n1072\t                     :yin.k/id v-address\n1073\t                     :yin.k/bytes v-bytes\n1074\t                     :yin.k/medium \"stage-e\"})\n1075\t    {:address v-address :bytes v-bytes :occurrence o}))\n1076\t\n1077\t\n1078\t(defn- holder-config\n1079\t  [ctx w extra]\n1080\t  (merge (holder-seams ctx w) extra))\n1081\t\n1082\t\n1083\t(defn- add-source\n1084\t  [ctx w h]\n1085\t  (update w :c compose/source h (holder-config ctx w (merge {:machine (source-machine w)}\n1086\t                                                            (inbound-for w h)))))\n1087\t\n1088\t\n1089\t(defn- add-candidate\n1090\t  [ctx w h checkpoint opts]\n1091\t  (let [{:keys [address bytes]} (checkpoint-from w checkpoint)\n1092\t        seams (holder-config ctx w (merge {:bytes bytes :address address}\n1093\t                                          (inbound-for w h)))\n1094\t        seams (if (= :none (:attach opts))\n1095\t                (assoc seams :attach! (fn [_] {:dao.stream/outcome :dao.stream/not-found}))\n1096\t                seams)]\n1097\t    (update w :c compose/holder h seams)))\n1098\t\n1099\t\n1100\t(defn- dead?\n1101\t  [ctx]\n1102\t  @(:dead ctx))\n1103\t\n1104\t\n1105\t(defn- tick!\n1106\t  \"One tick of `f` over the world's composition; the life's tick cut is\n1107\t   checked after it.  A dead life ends here.\"\n1108\t  [ctx w f]\n1109\t  (let [c' (f (:c w))\n1110\t        w (assoc w :c c')]\n1111\t    (when (dead? ctx) (dead-throw!))\n1112\t    (let [spec (cut-spec ctx)]\n1113\t      (when (and (some? spec) (= :tick (:site spec)) (nil? @(:fired ctx))\n1114\t                 ((:match spec) c'))\n1115\t        (fire! ctx {:site :tick\n1116\t                    :holders (into {} (map (fn [[h st]] [h (holder-summary st)])) (:holders c'))\n1117\t                    :inbound (into {} (map (fn [h] [h (->data (inbound-of c' h nil))]))\n1118\t                                   (keys (:holders c')))})))\n1119\t    w))\n1120\t\n1121\t\n1122\t(def ^:private planes\n1123\t  {:step compose/step\n1124\t   :control compose/control-step\n1125\t   :program compose/program-step})\n1126\t\n1127\t\n1128\t(defn- phase?\n1129\t  [w h phase]\n1130\t  (= phase (get-in w [:c :holders h :phase])))\n1131\t\n1132\t\n1133\t(defn- until\n1134\t  \"Ticks of `plane` until `pred` holds of the world or `n` are spent;\n1135\t   answers [world held?].\"\n1136\t  [ctx w plane pred n]\n1137\t  (loop [w w k 0]\n1138\t    (if (pred w)\n1139\t      [w true]\n1140\t      (if (>= k n)\n1141\t        [w false]\n1142\t        (recur (tick! ctx w (get planes plane)) (inc k))))))\n1143\t\n1144\t\n1145\t(defn- admit-request\n1146\t  [rid target envelope]\n1147\t  {:yin.k/request :yin.k/admit\n1148\t   :yin.k/request-id rid\n1149\t   :yin.k/target target\n1150\t   :yin.k/fenced-envelope envelope})\n1151\t\n1152\t\n1153\t(defn- envelope\n1154\t  [lease epoch op-id value]\n1155\t  {:yin.k/envelope :yin.k/fenced-v1\n1156\t   :yin.k/incarnation lease\n1157\t   :yin.k/epoch epoch\n1158\t   :yin.k/op-id op-id\n1159\t   :yin.k/value value})\n1160\t\n1161\t\n1162\t(defn- holder-binding\n1163\t  [w h]\n1164\t  (let [st (get-in w [:c :holders h])]\n1165\t    {:lease (:lease st)\n1166\t     :epoch (get-in st [:evidence :yin.k/binding :yin.k/epoch])\n1167\t     :occurrence (:occurrence st)}))\n1168\t\n1169\t\n1170\t(defn- resolve-arg\n1171\t  \"Operation arguments may name a holder's live binding: [:binding h k].\"\n1172\t  [w x]\n1173\t  (if (and (vector? x) (= :binding (first x)))\n1174\t    (get (holder-binding w (nth x 1)) (nth x 2))\n1175\t    x))\n1176\t\n1177\t\n1178\t(defn- admit!\n1179\t  \"Append an authored admit to holder `h`'s inbound and run control ticks\n1180\t   until its reply lands (or `n` are spent).\"\n1181\t  [ctx w h {:keys [rid target lease epoch op-id value await?]}]\n1182\t  (let [target (cond (= :other target) (:other w)\n1183\t                     (some? target) (resolve-arg w target)\n1184\t                     :else (:target w))\n1185\t        lease (resolve-arg w lease)\n1186\t        epoch (resolve-arg w epoch)\n1187\t        op-id (into {} (map (fn [[k v]] [k (resolve-arg w v)])) op-id)\n1188\t        n (count (replies-of (:c w) h))]\n1189\t    (stream/append! (get-in w [:c :inbounds h])\n1190\t                    (admit-request rid target (envelope lease epoch op-id value)))\n1191\t    (if (false? await?)\n1192\t      (tick! ctx w compose/control-step)\n1193\t      (first (until ctx w :control #(> (count (replies-of (:c %) h)) n) 20)))))\n1194\t\n1195\t\n1196\t(defn- run-op\n1197\t  \"One operation of a life's program; answers [world report-additions].\"\n1198\t  [ctx w [op & args]]\n1199\t  (case op\n1200\t    :source [(add-source ctx w (first args)) nil]\n1201\t    :candidate (let [[h checkpoint opts] args]\n1202\t                 [(add-candidate ctx w h checkpoint opts) nil])\n1203\t    :until (let [[h phase n plane] args\n1204\t                 [w held?] (until ctx w (or plane :step) #(phase? % h phase) n)]\n1205\t             [w {:until [[h phase held?]]}])\n1206\t    :until-status (let [[h status n] args\n1207\t                        [w held?] (until ctx w :step\n1208\t                                         #(= status (get-in % [:c :holders h :status])) n)]\n1209\t                    [w {:until [[h status held?]]}])\n1210\t    :until-inbound (let [[h kind n plane] args\n1211\t                         [w held?] (until ctx w (or plane :step)\n1212\t                                          #(seq (inbound-of (:c %) h kind)) n)]\n1213\t                     [w {:until [[h kind held?]]}])\n1214\t    :until-reply (let [[h kind n plane] args\n1215\t                       [w held?] (until ctx w (or plane :step)\n1216\t                                        #(some (fn [r] (= kind (:yin.k/reply r)))\n1217\t                                               (replies-of (:c %) h))\n1218\t                                        n)]\n1219\t                   [w {:until [[h kind held?]]}])\n1220\t    :until-some (let [[phase n] args\n1221\t                      [w held?] (until ctx w :step\n1222\t                                       (fn [w]\n1223\t                                         (some #(= phase (:phase %))\n1224\t                                               (vals (get-in w [:c :holders]))))\n1225\t                                       n)]\n1226\t                  [w {:until [[:some phase held?]]}])\n1227\t    :until-journal (let [[h kind action n plane] args\n1228\t                         [w held?] (until ctx w (or plane :step)\n1229\t                                          #(holder-records-match?\n1230\t                                             (:c %) h (record-is kind action))\n1231\t                                          n)]\n1232\t                     [w {:until [[h kind action held?]]}])\n1233\t    :ticks (let [[n plane] args]\n1234\t             [(reduce (fn [w _] (tick! ctx w (get planes (or plane :step)))) w (range n)) nil])\n1235\t    :hand-off [(update w :c compose/hand-off (first args)) nil]\n1236\t    :abort [(update w :c compose/abort (first args)) nil]\n1237\t    :clock (do (reset! (:clock w) (first args)) [w nil])\n1238\t    :append-prog (do (stream/append! (:prog w) (first args)) [w nil])\n1239\t    :admit (let [[h req] args] [(admit! ctx w h req) nil])\n1240\t    :enroll-other (let [e (compose/enroll! (:c w))]\n1241\t                    [(assoc w :other (:yin.k/target e)) {:other (->data (:yin.k/target e))}])\n1242\t    :snapshot (let [snap (snapshot ctx w)]\n1243\t                ((:emit! ctx) {:event :snapshot :key (first args) :snapshot snap})\n1244\t                [w {:snapshots {(first args) snap}}])\n1245\t    :binding (let [b (->data (holder-binding w (first args)))]\n1246\t               ((:emit! ctx) {:event :binding :holder (first args) :binding b})\n1247\t               [w {:bindings {(first args) b}}])\n1248\t    :inject (let [[h request] args\n1249\t                  n (count (replies-of (:c w) h))]\n1250\t              (stream/append! (get-in w [:c :inbounds h]) request)\n1251\t              [(first (until ctx w :control #(> (count (replies-of (:c %) h)) n) 20)) nil])\n1252\t    :offer-variant (let [[h] args\n1253\t                         v (offer-variant! w h)]\n1254\t                     ((:emit! ctx) {:event :variant :address (:address v)})\n1255\t                     [(assoc w :variant v) {:variant (->data (:address v))\n1256\t                                            :variant-baseline (checkpoint/inspect (:address v) (:bytes v))}])\n1257\t    :carrier (do (reset! (:carrier w) (first args)) [w nil])\n1258\t    :hold (do (reset! (:held w) (first args)) [w nil])\n1259\t    :partition-authority (do (reset! (:partitioned w) (first args)) [w nil])\n1260\t    :die (fire! ctx {:site :explicit :at (first args)})\n1261\t    :at-open (let [snap (snapshot ctx w)]\n1262\t               ((:emit! ctx) {:event :snapshot :key :at-open :snapshot snap})\n1263\t               [w {:at-open snap}])))\n1264\t\n1265\t\n1266\t(defn- merge-report\n1267\t  [report additions]\n1268\t  (merge-with (fn [a b] (if (and (map? a) (map? b)) (merge a b) (into a b)))\n1269\t              report additions))\n1270\t\n1271\t\n1272\t(defn- fork-row\n1273\t  \"A fork per host: fork runs when selected and is labelled fork, and an\n1274\t   exclusive requirement over a memory authority is refused, never\n1275\t   downgraded.\"\n1276\t  [ctx spec]\n1277\t  (let [refused (compose/open! {:source-index (fn [] @s/source-index)\n1278\t                                :mode :exclusive\n1279\t                                :failure-model :process-crash\n1280\t                                :backend (journal/memory-backend (atom []) nil)\n1281\t                                :duration {:s 30}\n1282\t                                :renewal-interval {:s 10}\n1283\t                                :store (jing-file/create-content-file\n1284\t                                         (str (:root spec) \"/refused.jing\"))\n1285\t                                :diagnostics (log-writer)\n1286\t                                :medium \"stage-e\"\n1287\t                                :clock (fn [] {:s 1})\n1288\t                                :journals (compose/file-journals\n1289\t                                            (str (:root spec) \"/refused\"))})\n1290\t        w (open-world! ctx (assoc spec :mode :fork :kind :parked))]\n1291\t    (try\n1292\t      (let [w (add-source ctx w \"h1\")\n1293\t            [w held?] (until ctx w :step #(phase? % \"h1\" :lifted) 12)]\n1294\t        {:refused (->data (dissoc refused :yin.vm.ucf.compose/composition))\n1295\t         :refused-composed? (some? (:yin.vm.ucf.compose/composition refused))\n1296\t         :fork {:held? held?\n1297\t                :policy (:yin.k/policy (:c w))\n1298\t                :status-policy (:yin.k/policy (compose/status (:c w)))\n1299\t                :arbitration (->data (compose/arbitration (:c w)))\n1300\t                :holder (holder-summary (get-in w [:c :holders \"h1\"]))\n1301\t                :address (->data (get-in w [:c :holders \"h1\" :detail :yin.k/address]))\n1302\t                :journal (->data (journal-records-of (:c w) \"h1\"))\n1303\t                :offers (->data (inbound-of (:c w) \"h1\" :yin.k/offer))\n1304\t                :fronts (count (:fronts (:c w)))\n1305\t                :outcome-reader? (some? (compose/outcome-reader (:c w)))}})\n1306\t      (finally (close-world! w)))))\n1307\t\n1308\t\n1309\t(defn run-life\n1310\t  \"Run one life of `spec` under `ctx` and answer its report (plain data).\n1311\t\n1312\t   spec:\n1313\t     :root     the scenario root (the durable media)\n1314\t     :kind     :parked (the parked-reader source of rows 1, 2, 6, 7) or\n1315\t               :rows (the reading-writer source over an enrolled target\n1316\t               of rows 3, 4, 5, 8)\n1317\t     :target   the enrolled target a :rows life reuses (absent: enroll,\n1318\t               emitting {:event :enrolled})\n1319\t     :clock    the life's starting clock reading, in seconds\n1320\t     :prog     the program stream's values this life sees\n1321\t     :source   the source stream's values; :evict-floor its eviction\n1322\t     :unreadable addresses the store cannot read\n1323\t     :attach   :none for an attach table that holds nothing\n1324\t     :ops      the life's program, a vector of operations (run-op)\n1325\t     :lose-authority true to destroy the authority's state first\n1326\t     :fork-row true for the per-host fork row instead\n1327\t\n1328\t   The cut, when any, is the context's.  A dead life throws ::killed\n1329\t   out of here; the caller (peer or in-process runner) decides what a\n1330\t   kill means.\"\n1331\t  [ctx spec]\n1332\t  (when (:lose-authority spec)\n1333\t    (destroy-authority! (:root spec)))\n1334\t  (cond\n1335\t    (:fork-row spec)\n1336\t    (fork-row ctx spec)\n1337\t\n1338\t    ;; a lost ledger the durable backend itself refuses to open never\n1339\t    ;; reaches the composition: fail stop, reported as data\n1340\t    (and (:lose-authority spec)\n1341\t         (not= :dao.stream/ok\n1342\t               (:dao.stream/outcome\n1343\t                 (let [r (file-journal/backend! (:authority (paths (:root spec))))]\n1344\t                   (when-some [b (::file-journal/backend r)] (file-journal/close! b))\n1345\t                   r))))\n1346\t    {:refusal {:stage :authority-backend\n1347\t               :answer (->data (file-journal/backend! (:authority (paths (:root spec)))))}}\n1348\t\n1349\t    :else\n1350\t    (let [w (open-world! ctx spec)]\n1351\t      (if-some [refusal (:refusal w)]\n1352\t        (do (close-world! w)\n1353\t            {:refusal refusal})\n1354\t        (let [result (atom w)]\n1355\t          (try\n1356\t            (let [[w report] (reduce (fn [[w report] op]\n1357\t                                       (let [[w additions] (run-op ctx w op)]\n1358\t                                         (reset! result w)\n1359\t                                         [w (merge-report report additions)]))\n1360\t                                     [w {}]\n1361\t                                     (:ops spec))]\n1362\t              (reset! result w)\n1363\t              (assoc report :final (snapshot ctx w)))\n1364\t            (finally\n1365\t              (when-not (dead? ctx)\n1366\t                (close-world! @result)))))))))\n1367\t\n1368\t\n1369\t;; =============================================================================\n1370\t;; Inspection: the durable state after every life, read without mutating it\n1371\t;; =============================================================================\n1372\t\n1373\t\n1374\t(defn inspect\n1375\t  \"Read the durable state under `root` without mutating it: the\n1376\t   authority's projection through `authority/open!` (no reclaim, unlike\n1377\t   the grantor's reopen), the enrolled `targets`' committed values, the\n1378\t   outcome projection, each holder's progress and reply journal, and the\n1379\t   side log.\"\n1380\t  [{:keys [root holders targets]}]\n1381\t  (let [p (paths root)\n1382\t        backend (::file-journal/backend (file-journal/backend! (:authority p)))\n1383\t        opened (if backend (authority/open! backend nil) {:yin.k/status :backend-refused})\n1384\t        a (::authority/authority opened)\n1385\t        open-journal (fn [dir]\n1386\t                       (let [b (open-file-backend! dir)\n1387\t                             j (:dao.stream/handle (journal/open! b nil))]\n1388\t                         [b j]))\n1389\t        read-dir (fn [dir]\n1390\t                   (let [[b j] (open-journal dir)]\n1391\t                     (try (->data (journal-values j))\n1392\t                          (finally (file-journal/close! b)))))]\n1393\t    (try\n1394\t      {:status (:yin.k/status opened)\n1395\t       :projection (->data (when a (authority/projection a)))\n1396\t       :targets (into {}\n1397\t                      (map (fn [i]\n1398\t                             [(->data i) (if-some [r (when a (authority/target-reader a i))]\n1399\t                                           (->data (read-values r))\n1400\t                                           :absent)]))\n1401\t                      targets)\n1402\t       :outcomes (if a (->data (read-values (admission/outcome-reader a))) [])\n1403\t       :journals (into {} (map (fn [h] [h (read-dir (str (:journals p) \"/\" h \"-progress\"))]))\n1404\t                       holders)\n1405\t       :replies (into {} (map (fn [h] [h (read-dir (str (:journals p) \"/\" h \"-reply\"))]))\n1406\t                      holders)\n1407\t       :side (read-dir (:side p))}\n1408\t      (finally\n1409\t        (when a (authority/close! a))\n1410\t        (when backend (file-journal/close! backend))))))\n1411\t"}]},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"38270ab1-38a2-4c45-a0dc-01e637d4ff32","timestamp":"2026-10-13T18:38:07.928Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_world.cljc","content":"  \"Every reply the composition's front wrote into holder `h`'s reply\n   journal (both tenures': the journal is durable).\"\n  [c h]\n  (journal-values (get-in c [:reply-journals h :journal])))\n\n\n(defn holder-summary\n  [st]\n  (->data (merge (select-keys st [:phase :status :detail :occurrence :lease])\n                 {:epoch (get-in st [:evidence :yin.k/binding :yin.k/epoch])\n                  :next-op-seq (get-in st [:machine :yin.k/custody :yin.k/next-op-seq])\n                  :stopped? (:stopped? st)\n                  :machine? (some? (:machine st))})))\n\n\n(defn snapshot\n  \"Everything a check may read of the live world, as data.\"\n  [ctx w]\n  (let [c (:c w)\n        hs (sort (keys (:holders c)))]\n    {:holders (into {} (map (fn [h] [h (holder-summary (get-in c [:holders h]))])) hs)\n     :policy (:yin.k/policy c)\n     :projection (->data (projection-of c))\n     :journals (into {} (map (fn [h] [h (->data (journal-records-of c h))])) hs)\n     :replies (into {} (map (fn [h] [h (->data (replies-of c h))])) hs)\n     :inbound (into {} (map (fn [h] [h (->data (inbound-of c h nil))])) hs)\n     :targets (if-some [i (:target w)]\n                {:target (->data i)\n                 :values (->data (read-values (compose/target-reader c i)))}\n                {})\n     :outcomes (if-some [r (compose/outcome-reader c)]\n                 (->data (read-values r))\n                 [])\n     :side (if-some [side (:side w)] (->data (read-values side)) [])\n     :fences (into {}\n                   (keep (fn [r]\n                           (when (= :yin.k/fenced (:yin.k/journal r))\n                             (let [a (:yin.k/address r)\n                                   bs ((:get-bytes-fn (:store w)) a nil)]\n                               [a (when bs (digest-of bs))]))))\n                   (mapcat #(journal-records-of c %) hs))\n     :packs (into {}\n                  (keep (fn [r]\n                          (when (= :yin.k/fenced (:yin.k/journal r))\n                            (let [a (:yin.k/address r)\n                                  bs ((:get-bytes-fn (:store w)) a nil)]\n                              (when bs\n                                (let [wire (cbor/decode bs)]\n                                  [a {:root (:yin.k/root wire)\n                                      :baseline (checkpoint/inspect a bs)\n                                      :sorted? (= (mapv first (:yin.k/rows wire))\n                                                  (vec (sort (map first (:yin.k/rows wire)))))\n                                      :canonical-bytes (digest-of (cbor/encode (rows/emit (rows/decode wire))))}]))))))\n                  (mapcat #(journal-records-of c %) hs))\n     :diagnostics (->data (read-values (:diagnostics w)))\n     :arbitration (->data (compose/arbitration c))\n     :counts {:attaches @(:attaches ctx) :observes @(:observes ctx)}\n     :clock @(:clock w)}))\n\n\n;; =============================================================================\n;; The life's program: plain-data operations over the composition\n;; =============================================================================\n\n\n(defn- durable-records\n  \"Holder `h`'s progress journal: through the composition when this life\n   composes `h`, else read from its durable directory (a holder a\n   previous life ran).\"\n  [w h]\n  (if (contains? (get-in w [:c :holders]) h)\n    (journal-records-of (:c w) h)\n    (let [b (open-file-backend! (str (:journals (paths (:root w))) \"/\" h \"-progress\"))]\n      (try\n        (journal-values (:dao.stream/handle (journal/open! b nil)))\n        (finally (file-journal/close! b))))))\n\n\n(defn- checkpoint-from\n  \"The checkpoint a candidate is added over, read from the durable\n   journal of `of` and the store: :fence the source's export, :successor\n   the exit's successor, or an explicit {:address a}.\"\n  [w {:keys [kind of address]}]\n  (let [records (durable-records w of)\n        fence (fn [o]\n                (some (fn [r]\n                        (when (and (= :yin.k/fenced (:yin.k/journal r))\n                                   (or (nil? o) (= o (:yin.k/occurrence r))))\n                          r))\n                      records))\n        address (case kind\n                  :fence (:yin.k/address (fence nil))\n                  :successor (let [mint (last (filter\n                                                (fn [r]\n                                                  (and (= :yin.k/minted (:yin.k/journal r))\n                                                       (= :yin.k/successor (:yin.k/role r))))\n                                                records))]\n                               (:yin.k/address (fence (:yin.k/occurrence mint))))\n                  :variant (:address (:variant w))\n                  :address address)\n        bs (when address ((:get-bytes-fn (:store w)) address nil))]\n    (when (nil? bs)\n      (throw (ex-info \"stage E: the checkpoint is absent from the store\"\n                      {:checkpoint {:kind kind :of of :address (->data address)}})))\n    {:address address :bytes bs}))\n\n\n(defn- inbound-for\n  \"Holder `h`'s inbound, when the life's spec names one: :answering, a\n   carrier whose appends answer the life's carrier outcome; :held, a\n   stream the front cannot read while the life holds the partition.\"\n  [w h]\n  (case (get (:inbound w) h)\n    :answering {:inbound (answering-inbound (str \"inbound-\" h) (:carrier w))}\n    :held {:inbound (held-inbound (str \"inbound-\" h) (:held w))}\n    nil))\n\n\n(defn- offer-variant!\n  \"A second encoding of the occurrence holder `h` fenced: the same root\n   with reversed rows in different canonical bytes, put in the store\n   and offered through `h`'s own inbound.  Answers {:address :bytes}.\"\n  [w h]\n  (let [{:keys [address bytes]} (checkpoint-from w {:kind :fence :of h})\n        body (cbor/decode bytes)\n        o (:yin.k/occurrence (checkpoint/inspect address bytes))\n        v-bytes (cbor/encode (update body :yin.k/rows #(vec (reverse %))))\n        v-address (rows/pack-address (cbor/decode v-bytes))]\n    ((:put-bytes-fn (:store w)) v-address v-bytes)\n    (stream/append! (get-in w [:c :inbounds h])\n                    {:yin.k/request :yin.k/offer\n                     :yin.k/request-id [:stage-e/variant (str address)]\n                     :yin.k/id v-address\n                     :yin.k/bytes v-bytes\n                     :yin.k/medium \"stage-e\"})\n    {:address v-address :bytes v-bytes :occurrence o}))\n\n\n(defn- holder-config\n  [ctx w extra]\n  (merge (holder-seams ctx w) extra))\n\n\n(defn- add-source\n  [ctx w h]\n  (update w :c compose/source h (holder-config ctx w (merge {:machine (source-machine w)}\n                                                            (inbound-for w h)))))\n\n\n(defn- add-candidate\n  [ctx w h checkpoint opts]\n  (let [{:keys [address bytes]} (checkpoint-from w checkpoint)\n        seams (holder-config ctx w (merge {:bytes bytes :address address}\n                                          (inbound-for w h)))\n        seams (if (= :none (:attach opts))\n                (assoc seams :attach! (fn [_] {:dao.stream/outcome :dao.stream/not-found}))\n                seams)]\n    (update w :c compose/holder h seams)))\n\n\n(defn- dead?\n  [ctx]\n  @(:dead ctx))\n\n\n(defn- tick!\n  \"One tick of `f` over the world's composition; the life's tick cut is\n   checked after it.  A dead life ends here.\"\n  [ctx w f]\n  (let [c' (f (:c w))\n        w (assoc w :c c')]\n    (when (dead? ctx) (dead-throw!))\n    (let [spec (cut-spec ctx)]\n      (when (and (some? spec) (= :tick (:site spec)) (nil? @(:fired ctx))\n                 ((:match spec) c'))\n        (fire! ctx {:site :tick\n                    :holders (into {} (map (fn [[h st]] [h (holder-summary st)])) (:holders c'))\n                    :inbound (into {} (map (fn [h] [h (->data (inbound-of c' h nil))]))\n                                   (keys (:holders c')))})))\n    w))\n\n\n(def ^:private planes\n  {:step compose/step\n   :control compose/control-step\n   :program compose/program-step})\n\n\n(defn- phase?\n  [w h phase]\n  (= phase (get-in w [:c :holders h :phase])))\n\n\n(defn- until\n  \"Ticks of `plane` until `pred` holds of the world or `n` are spent;\n   answers [world held?].\"\n  [ctx w plane pred n]\n  (loop [w w k 0]\n    (if (pred w)\n      [w true]\n      (if (>= k n)\n        [w false]\n        (recur (tick! ctx w (get planes plane)) (inc k))))))\n\n\n(defn- admit-request\n  [rid target envelope]\n  {:yin.k/request :yin.k/admit\n   :yin.k/request-id rid\n   :yin.k/target target\n   :yin.k/fenced-envelope envelope})\n\n\n(defn- envelope\n  [lease epoch op-id value]\n  {:yin.k/envelope :yin.k/fenced-v1\n   :yin.k/incarnation lease\n   :yin.k/epoch epoch\n   :yin.k/op-id op-id\n   :yin.k/value value})\n\n\n(defn- holder-binding\n  [w h]\n  (let [st (get-in w [:c :holders h])]\n    {:lease (:lease st)\n     :epoch (get-in st [:evidence :yin.k/binding :yin.k/epoch])\n     :occurrence (:occurrence st)}))\n\n\n(defn- resolve-arg\n  \"Operation arguments may name a holder's live binding: [:binding h k].\"\n  [w x]\n  (if (and (vector? x) (= :binding (first x)))\n    (get (holder-binding w (nth x 1)) (nth x 2))\n    x))\n\n\n(defn- admit!\n  \"Append an authored admit to holder `h`'s inbound and run control ticks\n   until its reply lands (or `n` are spent).\"\n  [ctx w h {:keys [rid target lease epoch op-id value await?]}]\n  (let [target (cond (= :other target) (:other w)\n                     (some? target) (resolve-arg w target)\n                     :else (:target w))\n        lease (resolve-arg w lease)\n        epoch (resolve-arg w epoch)\n        op-id (into {} (map (fn [[k v]] [k (resolve-arg w v)])) op-id)\n        n (count (replies-of (:c w) h))]\n    (stream/append! (get-in w [:c :inbounds h])\n                    (admit-request rid target (envelope lease epoch op-id value)))\n    (if (false? await?)\n      (tick! ctx w compose/control-step)\n      (first (until ctx w :control #(> (count (replies-of (:c %) h)) n) 20)))))\n\n\n(defn- run-op\n  \"One operation of a life's program; answers [world report-additions].\"\n  [ctx w [op & args]]\n  (case op\n    :source [(add-source ctx w (first args)) nil]\n    :candidate (let [[h checkpoint opts] args]\n                 [(add-candidate ctx w h checkpoint opts) nil])\n    :until (let [[h phase n plane] args\n                 [w held?] (until ctx w (or plane :step) #(phase? % h phase) n)]\n             [w {:until [[h phase held?]]}])\n    :until-status (let [[h status n] args\n                        [w held?] (until ctx w :step\n                                         #(= status (get-in % [:c :holders h :status])) n)]\n                    [w {:until [[h status held?]]}])\n    :until-inbound (let [[h kind n plane] args\n                         [w held?] (until ctx w (or plane :step)\n                                          #(seq (inbound-of (:c %) h kind)) n)]\n                     [w {:until [[h kind held?]]}])\n    :until-reply (let [[h kind n plane] args\n                       [w held?] (until ctx w (or plane :step)\n                                        #(some (fn [r] (= kind (:yin.k/reply r)))\n                                               (replies-of (:c %) h))\n                                        n)]\n                   [w {:until [[h kind held?]]}])\n    :until-some (let [[phase n] args\n                      [w held?] (until ctx w :step\n                                       (fn [w]\n                                         (some #(= phase (:phase %))\n                                               (vals (get-in w [:c :holders]))))\n                                       n)]\n                  [w {:until [[:some phase held?]]}])\n    :until-journal (let [[h kind action n plane] args\n                         [w held?] (until ctx w (or plane :step)\n                                          #(holder-records-match?\n                                             (:c %) h (record-is kind action))\n                                          n)]\n                     [w {:until [[h kind action held?]]}])\n    :ticks (let [[n plane] args]\n             [(reduce (fn [w _] (tick! ctx w (get planes (or plane :step)))) w (range n)) nil])\n    :hand-off [(update w :c compose/hand-off (first args)) nil]\n    :abort [(update w :c compose/abort (first args)) nil]\n    :clock (do (reset! (:clock w) (first args)) [w nil])\n    :append-prog (do (stream/append! (:prog w) (first args)) [w nil])\n    :admit (let [[h req] args] [(admit! ctx w h req) nil])\n    :enroll-other (let [e (compose/enroll! (:c w))]\n                    [(assoc w :other (:yin.k/target e)) {:other (->data (:yin.k/target e))}])\n    :snapshot (let [snap (snapshot ctx w)]\n                ((:emit! ctx) {:event :snapshot :key (first args) :snapshot snap})\n                [w {:snapshots {(first args) snap}}])\n    :binding (let [b (->data (holder-binding w (first args)))]\n               ((:emit! ctx) {:event :binding :holder (first args) :binding b})\n               [w {:bindings {(first args) b}}])\n    :inject (let [[h request] args\n                  n (count (replies-of (:c w) h))]\n              (stream/append! (get-in w [:c :inbounds h]) request)\n              [(first (until ctx w :control #(> (count (replies-of (:c %) h)) n) 20)) nil])\n    :offer-variant (let [[h] args\n                         v (offer-variant! w h)]\n                     ((:emit! ctx) {:event :variant :address (:address v)})\n                     [(assoc w :variant v) {:variant (->data (:address v))\n                                            :variant-baseline (checkpoint/inspect (:address v) (:bytes v))}])\n    :carrier (do (reset! (:carrier w) (first args)) [w nil])\n    :hold (do (reset! (:held w) (first args)) [w nil])\n    :partition-authority (do (reset! (:partitioned w) (first args)) [w nil])\n    :die (fire! ctx {:site :explicit :at (first args)})\n    :at-open (let [snap (snapshot ctx w)]\n               ((:emit! ctx) {:event :snapshot :key :at-open :snapshot snap})\n               [w {:at-open snap}])))\n\n\n(defn- merge-report\n  [report additions]\n  (merge-with (fn [a b] (if (and (map? a) (map? b)) (merge a b) (into a b)))\n              report additions))\n\n\n(defn- fork-row\n  \"A fork per host: fork runs when selected and is labelled fork, and an\n   exclusive requirement over a memory authority is refused, never\n   downgraded.\"\n  [ctx spec]\n  (let [refused (compose/open! {:source-index (fn [] @s/source-index)\n                                :mode :exclusive\n                                :failure-model :process-crash\n                                :backend (journal/memory-backend (atom []) nil)\n                                :duration {:s 30}\n                                :renewal-interval {:s 10}\n                                :store (jing-file/create-content-file\n                                         (str (:root spec) \"/refused.jing\"))\n                                :diagnostics (log-writer)\n                                :medium \"stage-e\"\n                                :clock (fn [] {:s 1})\n                                :journals (compose/file-journals\n                                            (str (:root spec) \"/refused\"))})\n        w (open-world! ctx (assoc spec :mode :fork :kind :parked))]\n    (try\n      (let [w (add-source ctx w \"h1\")\n            [w held?] (until ctx w :step #(phase? % \"h1\" :lifted) 12)]\n        {:refused (->data (dissoc refused :yin.vm.ucf.compose/composition))\n         :refused-composed? (some? (:yin.vm.ucf.compose/composition refused))\n         :fork {:held? held?\n                :policy (:yin.k/policy (:c w))\n                :status-policy (:yin.k/policy (compose/status (:c w)))\n                :arbitration (->data (compose/arbitration (:c w)))\n                :holder (holder-summary (get-in w [:c :holders \"h1\"]))\n                :address (->data (get-in w [:c :holders \"h1\" :detail :yin.k/address]))\n                :journal (->data (journal-records-of (:c w) \"h1\"))\n                :offers (->data (inbound-of (:c w) \"h1\" :yin.k/offer))\n                :fronts (count (:fronts (:c w)))\n                :outcome-reader? (some? (compose/outcome-reader (:c w)))}})\n      (finally (close-world! w)))))\n\n\n(defn run-life\n  \"Run one life of `spec` under `ctx` and answer its report (plain data).\n\n   spec:\n     :root     the scenario root (the durable media)\n     :kind     :parked (the parked-reader source of rows 1, 2, 6, 7) or\n               :rows (the reading-writer source over an enrolled target\n               of rows 3, 4, 5, 8)\n     :target   the enrolled target a :rows life reuses (absent: enroll,\n               emitting {:event :enrolled})\n     :clock    the life's starting clock reading, in seconds\n     :prog     the program stream's values this life sees\n     :source   the source stream's values; :evict-floor its eviction\n     :unreadable addresses the store cannot read\n     :attach   :none for an attach table that holds nothing\n     :ops      the life's program, a vector of operations (run-op)\n     :lose-authority true to destroy the authority's state first\n     :fork-row true for the per-host fork row instead\n\n   The cut, when any, is the context's.  A dead life throws ::killed\n   out of here; the caller (peer or in-process runner) decides what a\n   kill means.\"\n  [ctx spec]\n  (when (:lose-authority spec)\n    (destroy-authority! (:root spec)))\n  (cond\n    (:fork-row spec)\n    (fork-row ctx spec)\n\n    ;; a lost ledger the durable backend itself refuses to open never\n    ;; reaches the composition: fail stop, reported as data\n    (and (:lose-authority spec)\n         (not= :dao.stream/ok\n               (:dao.stream/outcome\n                 (let [r (file-journal/backend! (:authority (paths (:root spec))))]\n                   (when-some [b (::file-journal/backend r)] (file-journal/close! b))\n                   r))))\n    {:refusal {:stage :authority-backend\n               :answer (->data (file-journal/backend! (:authority (paths (:root spec)))))}}\n\n    :else\n    (let [w (open-world! ctx spec)]\n      (if-some [refusal (:refusal w)]\n        (do (close-world! w)\n            {:refusal refusal})\n        (let [result (atom w)]\n          (try\n            (let [[w report] (reduce (fn [[w report] op]\n                                       (let [[w additions] (run-op ctx w op)]\n                                         (reset! result w)\n                                         [w (merge-report report additions)]))\n                                     [w {}]\n                                     (:ops spec))]\n              (reset! result w)\n              (assoc report :final (snapshot ctx w)))\n            (finally\n              (when-not (dead? ctx)\n                (close-world! @result)))))))))\n\n\n;; =============================================================================\n;; Inspection: the durable state after every life, read without mutating it\n;; =============================================================================\n\n\n(defn inspect\n  \"Read the durable state under `root` without mutating it: the\n   authority's projection through `authority/open!` (no reclaim, unlike\n   the grantor's reopen), the enrolled `targets`' committed values, the\n   outcome projection, each holder's progress and reply journal, and the\n   side log.\"\n  [{:keys [root holders targets]}]\n  (let [p (paths root)\n        backend (::file-journal/backend (file-journal/backend! (:authority p)))\n        opened (if backend (authority/open! backend nil) {:yin.k/status :backend-refused})\n        a (::authority/authority opened)\n        open-journal (fn [dir]\n                       (let [b (open-file-backend! dir)\n                             j (:dao.stream/handle (journal/open! b nil))]\n                         [b j]))\n        read-dir (fn [dir]\n                   (let [[b j] (open-journal dir)]\n                     (try (->data (journal-values j))\n                          (finally (file-journal/close! b)))))]\n    (try\n      {:status (:yin.k/status opened)\n       :projection (->data (when a (authority/projection a)))\n       :targets (into {}\n                      (map (fn [i]\n                             [(->data i) (if-some [r (when a (authority/target-reader a i))]\n                                           (->data (read-values r))\n                                           :absent)]))\n                      targets)\n       :outcomes (if a (->data (read-values (admission/outcome-reader a))) [])\n       :journals (into {} (map (fn [h] [h (read-dir (str (:journals p) \"/\" h \"-progress\"))]))\n                       holders)\n       :replies (into {} (map (fn [h] [h (read-dir (str (:journals p) \"/\" h \"-reply\"))]))\n                      holders)\n       :side (read-dir (:side p))}\n      (finally\n        (when a (authority/close! a))\n        (when backend (file-journal/close! backend))))))\n","numLines":472,"startLine":940,"totalLines":1411}},"tool_result_meta":[{"id":"toolu_01PhtjkK778jfAMB9EQSCKhz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
