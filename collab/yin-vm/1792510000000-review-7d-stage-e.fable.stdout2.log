ime.time()-t0)}s)\")\n    finally:\n        with open(path, \"wb\") as f: f.write(backup)\n        with open(path, \"rb\") as f: restored = f.read()\n        assert restored == backup, \"RESTORE FAILED \" + m[\"name\"]\n        rc = subprocess.run([\"git\", \"diff\", \"--quiet\", \"--\", m[\"file\"]], cwd=ROOT).returncode\n        assert rc == 0, \"git diff not quiet after restore \" + m[\"name\"]\n    line = m[\"name\"] + \"\\n  \" + \"\\n  \".join(outs)\n    print(line, flush=True)\n    results.append(line)\n\nwith open(os.path.join(OUT, \"summary.txt\"), \"w\") as f:\n    f.write(\"\\n\".join(results) + \"\\n\")\nprint(\"ALL RESTORED; git diff --quiet -- src test:\",\n      subprocess.run([\"git\", \"diff\", \"--quiet\", \"--\", \"src\", \"test\"], cwd=ROOT).returncode)\n"}}}
