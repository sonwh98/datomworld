{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D51dMUa17uxjR2bvZK7A7M","type":"tool_result","content":"420\t  [bs]\n421\t  (try\n422\t    (::journal/value (cbor/decode bs))\n423\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n424\t\n425\t\n426\t(defn- fail-hit!\n427\t  \"Whether the life's uncertain-append failure ({:like cut-name\n428\t   :persist? bool}) matches this write at `site`: the first match only.\"\n429\t  [ctx site subject]\n430\t  (when-some [{:keys [like]} (:fail ctx)]\n431\t    (let [spec (get cuts like)]\n432\t      (when (and (nil? @(:failed ctx))\n433\t                 (= site (:site spec))\n434\t                 ((:match spec) subject))\n435\t        (reset! (:failed ctx) {:site site :like like})\n436\t        true))))\n437\t\n438\t\n439\t(defn mortal-backend\n440\t  \"Journal backend `b` at `site`, mortal under `ctx`: once the life is\n441\t   dead every frame write throws having written nothing, and the life's\n442\t   cut, when it names this site, fires before or after its frame.\"\n443\t  [ctx site b]\n444\t  (swap! (:opened ctx) conj [:backend b])\n445\t  (let [write! (::journal/write-frame! b)\n446\t        truncate! (::journal/truncate! b)]\n447\t    (assoc b\n448\t           ::journal/write-frame!\n449\t           (fn [bs]\n450\t             (when @(:dead ctx) (dead-throw!))\n451\t             (when (fail-hit! ctx site (frame-record bs))\n452\t               ;; an uncertain append: the frame lands or not, and the\n453\t               ;; writer is answered a throw either way -- the process\n454\t               ;; lives on, its journal's answer unknown\n455\t               (when (:persist? (:fail ctx)) (write! bs))\n456\t               ((:emit! ctx) {:event :uncertain :site site\n457\t                              :persisted? (boolean (:persist? (:fail ctx)))\n458\t                              :record (->data (frame-record bs))})\n459\t               (throw (ex-info \"stage E: an uncertain append\" {::uncertain true})))\n460\t             (let [hit (hit! ctx site (frame-record bs))]\n461\t               (when (= :before hit)\n462\t                 (fire! ctx {:site site :when :before\n463\t                             :record (->data (frame-record bs))}))\n464\t               (let [r (write! bs)]\n465\t                 (when (= :after hit)\n466\t                   (fire! ctx {:site site :when :after\n467\t                               :record (->data (frame-record bs))}))\n468\t                 r)))\n469\t           ::journal/truncate!\n470\t           (fn [n]\n471\t             (when @(:dead ctx) (dead-throw!))\n472\t             (truncate! n)))))\n473\t\n474\t\n475\t(defn mortal-store\n476\t  \"Content store `base`, mortal under `ctx`, its puts cut at :store; its\n477\t   gets answer the default for every address in `unreadable` (an\n478\t   accepted checkpoint whose bytes cannot be read).\"\n479\t  [ctx base unreadable]\n480\t  (swap! (:opened ctx) conj [:store base])\n481\t  (let [put! (:put-bytes-fn base)\n482\t        get! (:get-bytes-fn base)]\n483\t    (assoc base\n484\t           :put-bytes-fn\n485\t           (fn [address bs]\n486\t             (when @(:dead ctx) (dead-throw!))\n487\t             (let [hit (hit! ctx :store {:address address})]\n488\t               (when (= :before hit)\n489\t                 (fire! ctx {:site :store :when :before :address address}))\n490\t               (let [r (put! address bs)]\n491\t                 (when (= :after hit)\n492\t                   (fire! ctx {:site :store :when :after :address address}))\n493\t                 r)))\n494\t           :get-bytes-fn\n495\t           (fn\n496\t             ([address] (get! address))\n497\t             ([address default]\n498\t              (if (contains? unreadable address)\n499\t                default\n500\t                (get! address default)))))))\n501\t\n502\t\n503\t(defn- open-file-backend!\n504\t  [dir]\n505\t  (ensure-dir! dir)\n506\t  (let [r (file-journal/backend! dir)]\n507\t    (or (::file-journal/backend r)\n508\t        (throw (ex-info \"stage E: a durable journal directory refused\"\n509\t                        {:dir dir :answer r})))))\n510\t\n511\t\n512\t(defn- mortal-journals\n513\t  \"compose/file-journals over `root`, every backend it opens mortal at\n514\t   [:progress h] or [:reply h].\"\n515\t  [ctx root]\n516\t  (let [base (compose/file-journals root)]\n517\t    (assoc base\n518\t           :progress-backend!\n519\t           (fn [h] (mortal-backend ctx [:progress h] ((:progress-backend! base) h)))\n520\t           :reply-backend!\n521\t           (fn [h] (mortal-backend ctx [:reply h] ((:reply-backend! base) h))))))\n522\t\n523\t\n524\t;; =============================================================================\n525\t;; Streams outside custody\n526\t;; =============================================================================\n527\t\n528\t\n529\t(defn scenario-stream\n530\t  \"A stream outside custody, rebuilt by every life under its fixed\n531\t   `identity`: `values` at integer positions from zero, positions below\n532\t   `floor` evicted (their reads answer gap with the floor as the\n533\t   successor cursor).  Integer positions make a position lifted from one\n534\t   life's instance a valid cursor on the next life's.\"\n535\t  [identity values floor]\n536\t  (let [vs (atom (vec values))]\n537\t    (reify\n538\t      stream/IDaoStreamDescriptor\n539\t      (descriptor\n540\t        [_]\n541\t        {:dao.stream/outcome :dao.stream/ok\n542\t         :dao.stream/identity identity\n543\t         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n544\t                                 :dao.stream/identity identity}})\n545\t\n546\t\n547\t      stream/IDaoStreamReader\n548\t\n549\t      (cursor\n550\t        [_ _anchor]\n551\t        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor floor})\n552\t\n553\t      (next\n554\t        [_ cursor]\n555\t        (let [values @vs]\n556\t          (cond\n557\t            (not (and (integer? cursor) (<= 0 cursor (count values))))\n558\t            {:dao.stream/outcome :dao.stream/invalid-cursor}\n559\t            (< cursor floor)\n560\t            {:dao.stream/outcome :dao.stream/gap :dao.stream/cursor floor}\n561\t            (< cursor (count values))\n562\t            {:dao.stream/outcome :dao.stream/ok\n563\t             :dao.stream/value (nth values cursor)\n564\t             :dao.stream/cursor (inc cursor)}\n565\t            :else {:dao.stream/outcome :dao.stream/blocked})))\n566\t\n567\t\n568\t      stream/IDaoStreamWriter\n569\t\n570\t      (append!\n571\t        [_ x]\n572\t        (swap! vs conj x)\n573\t        {:dao.stream/outcome :dao.stream/ok}))))\n574\t\n575\t\n576\t(defn journal-stream\n577\t  \"A durable stream over journal handle `j` under the fixed `identity`:\n578\t   integer positions over the journal's own, so every life reads the\n579\t   whole history any life appended -- the side log of at-least-once\n580\t   external IO.\"\n581\t  [identity j]\n582\t  (let [jid (:dao.stream/identity (stream/descriptor j))]\n583\t    (reify\n584\t      stream/IDaoStreamDescriptor\n585\t      (descriptor\n586\t        [_]\n587\t        {:dao.stream/outcome :dao.stream/ok\n588\t         :dao.stream/identity identity\n589\t         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n590\t                                 :dao.stream/identity identity}})\n591\t\n592\t\n593\t      stream/IDaoStreamReader\n594\t\n595\t      (cursor\n596\t        [_ _anchor]\n597\t        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n598\t\n599\t      (next\n600\t        [_ cursor]\n601\t        (if-not (and (integer? cursor) (<= 0 cursor))\n602\t          {:dao.stream/outcome :dao.stream/invalid-cursor}\n603\t          (let [r (stream/next j {:dao.stream.memory-log/identity jid\n604\t                                  :dao.stream.memory-log/position cursor})]\n605\t            (case (:dao.stream/outcome r)\n606\t              :dao.stream/ok {:dao.stream/outcome :dao.stream/ok\n607\t                              :dao.stream/value (:dao.stream/value r)\n608\t                              :dao.stream/cursor (inc cursor)}\n609\t              {:dao.stream/outcome :dao.stream/blocked}))))\n610\t\n611\t\n612\t      stream/IDaoStreamWriter\n613\t\n614\t      (append!\n615\t        [_ x]\n616\t        (stream/append! j x)))))\n617\t\n618\t\n619\t(defn- answering-inbound\n620\t  \"A log-shaped inbound whose appends answer `@outcome`: :dao.stream/ok\n621\t   lands the request; any other outcome lands nothing (the carrier full,\n622\t   refusing, or failing under the send).\"\n623\t  [identity outcome]\n624\t  (let [values (atom [])]\n625\t    (reify\n626\t      stream/IDaoStreamDescriptor\n627\t      (descriptor\n628\t        [_]\n629\t        {:dao.stream/outcome :dao.stream/ok\n630\t         :dao.stream/identity identity\n631\t         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n632\t                                 :dao.stream/identity identity}})\n633\t\n634\t\n635\t      stream/IDaoStreamReader\n636\t\n637\t      (cursor\n638\t        [_ _anchor]\n639\t        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n640\t\n641\t      (next\n642\t        [_ cursor]\n643\t        (let [vs @values]\n644\t          (cond\n645\t            (not (and (integer? cursor) (<= 0 cursor (count vs))))\n646\t            {:dao.stream/outcome :dao.stream/invalid-cursor}\n647\t            (< cursor (count vs))\n648\t            {:dao.stream/outcome :dao.stream/ok\n649\t             :dao.stream/value (nth vs cursor)\n650\t             :dao.stream/cursor (inc cursor)}\n651\t            :else {:dao.stream/outcome :dao.stream/blocked})))\n652\t\n653\t\n654\t      stream/IDaoStreamWriter\n655\t\n656\t      (append!\n657\t        [_ x]\n658\t        (let [o @outcome]\n659\t          (when (= :dao.stream/ok o) (swap! values conj x))\n660\t          {:dao.stream/outcome o})))))\n661\t\n662\t\n663\t(defn- held-inbound\n664\t  \"A log-shaped inbound whose reads answer :blocked while `held` (an\n665\t   atom) is truthy: the holder's requests land, but the authority's\n666\t   front cannot read them -- the holder partitioned from its\n667\t   authority.  Healed, the front reads every request that landed.\"\n668\t  [identity held]\n669\t  (let [values (atom [])]\n670\t    (reify\n671\t      stream/IDaoStreamDescriptor\n672\t      (descriptor\n673\t        [_]\n674\t        {:dao.stream/outcome :dao.stream/ok\n675\t         :dao.stream/identity identity\n676\t         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n677\t                                 :dao.stream/identity identity}})\n678\t\n679\t\n680\t      stream/IDaoStreamReader\n681\t\n682\t      (cursor\n683\t        [_ _anchor]\n684\t        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n685\t\n686\t      (next\n687\t        [_ cursor]\n688\t        (if @held\n689\t          {:dao.stream/outcome :dao.stream/blocked}\n690\t          (let [vs @values]\n691\t            (cond\n692\t              (not (and (integer? cursor) (<= 0 cursor (count vs))))\n693\t              {:dao.stream/outcome :dao.stream/invalid-cursor}\n694\t              (< cursor (count vs))\n695\t              {:dao.stream/outcome :dao.stream/ok\n696\t               :dao.stream/value (nth vs cursor)\n697\t               :dao.stream/cursor (inc cursor)}\n698\t              :else {:dao.stream/outcome :dao.stream/blocked}))))\n699\t\n700\t\n701\t      stream/IDaoStreamWriter\n702\t\n703\t      (append!\n704\t        [_ x]\n705\t        (swap! values conj x)\n706\t        {:dao.stream/outcome :dao.stream/ok}))))\n707\t\n708\t\n709\t(defn- log-writer\n710\t  []\n711\t  (:dao.stream/handle\n712\t    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n713\t\n714\t\n715\t;; =============================================================================\n716\t;; Machines and holder seams\n717\t;; =============================================================================\n718\t\n719\t\n720\t(def prog-id \"prog-c\")\n721\t(def source-id \"src-s\")\n722\t(def side-id \"side-x\")\n723\t\n724\t\n725\t(defn- parked-reader-over\n726\t  \"A real gated machine over `source`, parked on its first read: one\n727\t   more delivered value and it halts with :done.\"\n728\t  [source]\n729\t  (let [m0 (s/load-ast (s/new-machine)\n730\t                       (s/then {:type :stream/next, :source (s/v 'c)}\n731\t                               (s/lit :done)))\n732\t        [sref m1] (engine/attach-resource m0 source)\n733\t        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)]\n734\t    (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))))\n735\t\n736\t\n737\t(defn- reading-writer\n738\t  \"A real gated machine over `source`, parked on its first read: the\n739\t   value it reads is written to the enrolled `target`, then :side to\n740\t   `side`, then it halts with :done.\"\n741\t  [source target side]\n742\t  (let [m0 (s/load-ast (s/new-machine)\n743\t                       (s/let1 'v (s/next-of (s/v 'c))\n744\t                               (s/then {:type :stream/put, :target (s/v 'w),\n745\t                                        :val (s/v 'v)}\n746\t                                       (s/then {:type :stream/put,\n747\t                                                :target (s/v 'x),\n748\t                                                :val (s/lit :side)}\n749\t                                               (s/lit :done)))))\n750\t        [sref m1] (engine/attach-resource m0 source)\n751\t        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n752\t        [wref m3] (engine/attach-resource m2 target)\n753\t        [xref m4] (engine/attach-resource m3 side)]\n754\t    (vm/run (assoc m4 :store {'c cref, 'w wref, 'x xref}\n755\t                   :yin.k/gate :running))))\n756\t\n757\t\n758\t(defn- attach-over\n759\t  [ctx table]\n760\t  (fn [descriptor]\n761\t    (swap! (:attaches ctx) inc)\n762\t    (if-some [h (get table (:dao.stream/identity descriptor))]\n763\t      {:dao.stream/outcome :dao.stream/ok :dao.stream/handle h}\n764\t      {:dao.stream/outcome :dao.stream/not-found})))\n765\t\n766\t\n767\t(defn- observe-over\n768\t  [ctx]\n769\t  (fn [h op arg]\n770\t    (swap! (:observes ctx) inc)\n771\t    (case op\n772\t      :next (stream/next h arg)\n773\t      :cursor (stream/cursor h arg))))\n774\t\n775\t\n776\t(defn- same-id-server\n777\t  []\n778\t  (fn [h]\n779\t    (let [id (:dao.stream/identity (stream/descriptor h))]\n780\t      {:dao.stream/identity id\n781\t       :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n782\t                            :dao.stream/identity id}})))\n783\t\n784\t\n785\t;; =============================================================================\n786\t;; Opening a life's world\n787\t;; =============================================================================\n788\t\n789\t\n790\t(defn- composition-config\n791\t  [w mode]\n792\t  (cond-> {:mode mode\n793\t           :source-index (fn [] @s/source-index)\n794\t           :renewal-interval {:s 10}\n795\t           :store (:store w)\n796\t           :diagnostics (:diagnostics w)\n797\t           :medium \"stage-e\"\n798\t           :clock (fn [] {:s @(:clock w)})}\n799\t    (= :exclusive mode) (assoc :failure-model :process-crash\n800\t                               :backend (:authority-backend w)\n801\t                               :duration {:s 30}\n802\t                               :journals (:journals w))))\n803\t\n804\t\n805\t(defn- world-table\n806\t  \"The holder table and protection of the life's world kind.\"\n807\t  [w]\n808\t  (case (:kind w)\n809\t    :parked {:table (if (= :none (:attach w)) {} {prog-id (:prog w)})\n810\t             :protection {prog-id :at-least-once}}\n811\t    :rows {:table (cond-> {source-id (:source w) side-id (:side w)}\n812\t                    (:target w) (assoc (:target w) (:reader w)))\n813\t           :protection (cond-> {source-id :at-least-once side-id :at-least-once}\n814\t                         (:target w) (assoc (:target w) :enrolled))}))\n815\t\n816\t\n817\t(defn- holder-seams\n818\t  [ctx w]\n819\t  (let [{:keys [table protection]} (world-table w)]\n820\t    {:protection protection\n821\t     :receiver (s/new-machine)\n822\t     :attach! (attach-over ctx table)\n823\t     :observe! (observe-over ctx)\n824\t     :serve! (if (= :parked (:kind w))\n825\t               (fn [_h]\n826\t                 {:dao.stream/identity prog-id\n827\t                  :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n828\t                                       :dao.stream/identity prog-id}})\n829\t               (same-id-server))}))\n830\t\n831\t\n832\t(defn- source-machine\n833\t  [w]\n834\t  (case (:kind w)\n835\t    :parked (parked-reader-over (scenario-stream prog-id [] 0))\n836\t    :rows (reading-writer (:source w) (:reader w) (:side w))))\n837\t\n838\t\n839\t(defn open-world!\n840\t  \"Open the life's world over `spec`: the durable media, mortal under\n841\t   `ctx`, and the composition over them.  Answers the world map with\n842\t   :c the open composition, or :refusal the composition's data refusal.\"\n843\t  [ctx spec]\n844\t  (let [{:keys [root kind mode]} spec\n845\t        mode (or mode :exclusive)\n846\t        p (paths root)\n847\t        _ (ensure-dir! root)\n848\t        partitioned (atom false)\n849\t        authority-backend (when (= :exclusive mode)\n850\t                            (let [b (mortal-backend ctx :authority\n851\t                                                    (open-file-backend! (:authority p)))\n852\t                                  write! (::journal/write-frame! b)]\n853\t                              ;; the protected consumer partitioned from\n854\t                              ;; its authority: every frame write fails\n855\t                              ;; while the flag stands\n856\t                              (assoc b ::journal/write-frame!\n857\t                                     (fn [bs]\n858\t                                       (if @partitioned\n859\t                                         (throw (ex-info \"stage E: the authority is partitioned\" {}))\n860\t                                         (write! bs))))))\n861\t        store (mortal-store ctx (jing-file/create-content-file (:store p))\n862\t                            (set (:unreadable spec)))\n863\t        side-backend (when (= :rows kind)\n864\t                       (mortal-backend ctx :side (open-file-backend! (:side p))))\n865\t        side (when side-backend\n866\t               (journal-stream side-id (:dao.stream/handle (journal/open! side-backend nil))))\n867\t        w {:root root\n868\t           :kind kind\n869\t           :mode mode\n870\t           :attach (:attach spec)\n871\t           :clock (atom (or (:clock spec) 1))\n872\t           :store store\n873\t           :diagnostics (log-writer)\n874\t           :authority-backend authority-backend\n875\t           :side-backend side-backend\n876\t           :journals (if (= :exclusive mode)\n877\t                       (mortal-journals ctx (:journals p))\n878\t                       (compose/memory-journals (atom {})))\n879\t           :prog (scenario-stream prog-id (or (:prog spec) []) 0)\n880\t           :source (scenario-stream source-id (or (:source spec) [\"A\"])\n881\t                                    (or (:evict-floor spec) 0))\n882\t           :side side\n883\t           :partitioned partitioned\n884\t           :carrier (atom :dao.stream/ok)\n885\t           :held (atom false)\n886\t           :inbound (:inbound spec)}\n887\t        opened (compose/open! (composition-config w mode))\n888\t        c (:yin.vm.ucf.compose/composition opened)]\n889\t    (if (nil? c)\n890\t      (assoc w :refusal (->data opened))\n891\t      (let [w (assoc w :c c)]\n892\t        (if (= :rows kind)\n893\t          (let [i (or (:target spec)\n894\t                      (let [e (compose/enroll! c)]\n895\t                        ((:emit! ctx) {:event :enrolled :target (:yin.k/target e)})\n896\t                        (:yin.k/target e)))]\n897\t            (assoc w :target i :reader (compose/target-reader c i)))\n898\t          w)))))\n899\t\n900\t\n901\t(defn release-dead!\n902\t  \"What the operating system does for a killed process, done for a life\n903\t   killed in this process: every file backend and the store it opened\n904\t   released, nothing written.\"\n905\t  [ctx]\n906\t  (doseq [[kind x] @(:opened ctx)]\n907\t    (try\n908\t      (case kind\n909\t        :backend (when (contains? x ::file-journal/close!) (file-journal/close! x))\n910\t        :store ((:close-fn x)))\n911\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))))\n912\t\n913\t\n914\t(defn close-world!\n915\t  \"Release everything a live world holds: the composition (its journal\n916\t   backends), the authority backend, the side log and the store.\"\n917\t  [w]\n918\t  (let [safe (fn [f]\n919\t               (try (f) (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))]\n920\t    (when-some [c (:c w)] (safe #(compose/close! c)))\n921\t    (when-some [b (:authority-backend w)] (safe #(file-journal/close! b)))\n922\t    (when-some [b (:side-backend w)] (safe #(file-journal/close! b)))\n923\t    (when-some [close! (get-in w [:store :close-fn])] (safe close!))\n924\t    nil))\n925\t\n926\t\n927\t;; =============================================================================\n928\t;; Reading a live world\n929\t;; =============================================================================\n930\t\n931\t\n932\t(defn- journal-values\n933\t  [j]\n934\t  (if (nil? j)\n935\t    []\n936\t    (read-values j)))\n937\t\n938\t\n939\t(defn replies-of"}]},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"c64ae968-7195-4ea6-bbce-2ec018084aa8","timestamp":"2026-10-13T18:38:06.434Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_world.cljc","content":"  [bs]\n  (try\n    (::journal/value (cbor/decode bs))\n    (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n\n\n(defn- fail-hit!\n  \"Whether the life's uncertain-append failure ({:like cut-name\n   :persist? bool}) matches this write at `site`: the first match only.\"\n  [ctx site subject]\n  (when-some [{:keys [like]} (:fail ctx)]\n    (let [spec (get cuts like)]\n      (when (and (nil? @(:failed ctx))\n                 (= site (:site spec))\n                 ((:match spec) subject))\n        (reset! (:failed ctx) {:site site :like like})\n        true))))\n\n\n(defn mortal-backend\n  \"Journal backend `b` at `site`, mortal under `ctx`: once the life is\n   dead every frame write throws having written nothing, and the life's\n   cut, when it names this site, fires before or after its frame.\"\n  [ctx site b]\n  (swap! (:opened ctx) conj [:backend b])\n  (let [write! (::journal/write-frame! b)\n        truncate! (::journal/truncate! b)]\n    (assoc b\n           ::journal/write-frame!\n           (fn [bs]\n             (when @(:dead ctx) (dead-throw!))\n             (when (fail-hit! ctx site (frame-record bs))\n               ;; an uncertain append: the frame lands or not, and the\n               ;; writer is answered a throw either way -- the process\n               ;; lives on, its journal's answer unknown\n               (when (:persist? (:fail ctx)) (write! bs))\n               ((:emit! ctx) {:event :uncertain :site site\n                              :persisted? (boolean (:persist? (:fail ctx)))\n                              :record (->data (frame-record bs))})\n               (throw (ex-info \"stage E: an uncertain append\" {::uncertain true})))\n             (let [hit (hit! ctx site (frame-record bs))]\n               (when (= :before hit)\n                 (fire! ctx {:site site :when :before\n                             :record (->data (frame-record bs))}))\n               (let [r (write! bs)]\n                 (when (= :after hit)\n                   (fire! ctx {:site site :when :after\n                               :record (->data (frame-record bs))}))\n                 r)))\n           ::journal/truncate!\n           (fn [n]\n             (when @(:dead ctx) (dead-throw!))\n             (truncate! n)))))\n\n\n(defn mortal-store\n  \"Content store `base`, mortal under `ctx`, its puts cut at :store; its\n   gets answer the default for every address in `unreadable` (an\n   accepted checkpoint whose bytes cannot be read).\"\n  [ctx base unreadable]\n  (swap! (:opened ctx) conj [:store base])\n  (let [put! (:put-bytes-fn base)\n        get! (:get-bytes-fn base)]\n    (assoc base\n           :put-bytes-fn\n           (fn [address bs]\n             (when @(:dead ctx) (dead-throw!))\n             (let [hit (hit! ctx :store {:address address})]\n               (when (= :before hit)\n                 (fire! ctx {:site :store :when :before :address address}))\n               (let [r (put! address bs)]\n                 (when (= :after hit)\n                   (fire! ctx {:site :store :when :after :address address}))\n                 r)))\n           :get-bytes-fn\n           (fn\n             ([address] (get! address))\n             ([address default]\n              (if (contains? unreadable address)\n                default\n                (get! address default)))))))\n\n\n(defn- open-file-backend!\n  [dir]\n  (ensure-dir! dir)\n  (let [r (file-journal/backend! dir)]\n    (or (::file-journal/backend r)\n        (throw (ex-info \"stage E: a durable journal directory refused\"\n                        {:dir dir :answer r})))))\n\n\n(defn- mortal-journals\n  \"compose/file-journals over `root`, every backend it opens mortal at\n   [:progress h] or [:reply h].\"\n  [ctx root]\n  (let [base (compose/file-journals root)]\n    (assoc base\n           :progress-backend!\n           (fn [h] (mortal-backend ctx [:progress h] ((:progress-backend! base) h)))\n           :reply-backend!\n           (fn [h] (mortal-backend ctx [:reply h] ((:reply-backend! base) h))))))\n\n\n;; =============================================================================\n;; Streams outside custody\n;; =============================================================================\n\n\n(defn scenario-stream\n  \"A stream outside custody, rebuilt by every life under its fixed\n   `identity`: `values` at integer positions from zero, positions below\n   `floor` evicted (their reads answer gap with the floor as the\n   successor cursor).  Integer positions make a position lifted from one\n   life's instance a valid cursor on the next life's.\"\n  [identity values floor]\n  (let [vs (atom (vec values))]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor floor})\n\n      (next\n        [_ cursor]\n        (let [values @vs]\n          (cond\n            (not (and (integer? cursor) (<= 0 cursor (count values))))\n            {:dao.stream/outcome :dao.stream/invalid-cursor}\n            (< cursor floor)\n            {:dao.stream/outcome :dao.stream/gap :dao.stream/cursor floor}\n            (< cursor (count values))\n            {:dao.stream/outcome :dao.stream/ok\n             :dao.stream/value (nth values cursor)\n             :dao.stream/cursor (inc cursor)}\n            :else {:dao.stream/outcome :dao.stream/blocked})))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (swap! vs conj x)\n        {:dao.stream/outcome :dao.stream/ok}))))\n\n\n(defn journal-stream\n  \"A durable stream over journal handle `j` under the fixed `identity`:\n   integer positions over the journal's own, so every life reads the\n   whole history any life appended -- the side log of at-least-once\n   external IO.\"\n  [identity j]\n  (let [jid (:dao.stream/identity (stream/descriptor j))]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (if-not (and (integer? cursor) (<= 0 cursor))\n          {:dao.stream/outcome :dao.stream/invalid-cursor}\n          (let [r (stream/next j {:dao.stream.memory-log/identity jid\n                                  :dao.stream.memory-log/position cursor})]\n            (case (:dao.stream/outcome r)\n              :dao.stream/ok {:dao.stream/outcome :dao.stream/ok\n                              :dao.stream/value (:dao.stream/value r)\n                              :dao.stream/cursor (inc cursor)}\n              {:dao.stream/outcome :dao.stream/blocked}))))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (stream/append! j x)))))\n\n\n(defn- answering-inbound\n  \"A log-shaped inbound whose appends answer `@outcome`: :dao.stream/ok\n   lands the request; any other outcome lands nothing (the carrier full,\n   refusing, or failing under the send).\"\n  [identity outcome]\n  (let [values (atom [])]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (let [vs @values]\n          (cond\n            (not (and (integer? cursor) (<= 0 cursor (count vs))))\n            {:dao.stream/outcome :dao.stream/invalid-cursor}\n            (< cursor (count vs))\n            {:dao.stream/outcome :dao.stream/ok\n             :dao.stream/value (nth vs cursor)\n             :dao.stream/cursor (inc cursor)}\n            :else {:dao.stream/outcome :dao.stream/blocked})))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (let [o @outcome]\n          (when (= :dao.stream/ok o) (swap! values conj x))\n          {:dao.stream/outcome o})))))\n\n\n(defn- held-inbound\n  \"A log-shaped inbound whose reads answer :blocked while `held` (an\n   atom) is truthy: the holder's requests land, but the authority's\n   front cannot read them -- the holder partitioned from its\n   authority.  Healed, the front reads every request that landed.\"\n  [identity held]\n  (let [values (atom [])]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (if @held\n          {:dao.stream/outcome :dao.stream/blocked}\n          (let [vs @values]\n            (cond\n              (not (and (integer? cursor) (<= 0 cursor (count vs))))\n              {:dao.stream/outcome :dao.stream/invalid-cursor}\n              (< cursor (count vs))\n              {:dao.stream/outcome :dao.stream/ok\n               :dao.stream/value (nth vs cursor)\n               :dao.stream/cursor (inc cursor)}\n              :else {:dao.stream/outcome :dao.stream/blocked}))))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (swap! values conj x)\n        {:dao.stream/outcome :dao.stream/ok}))))\n\n\n(defn- log-writer\n  []\n  (:dao.stream/handle\n    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n\n\n;; =============================================================================\n;; Machines and holder seams\n;; =============================================================================\n\n\n(def prog-id \"prog-c\")\n(def source-id \"src-s\")\n(def side-id \"side-x\")\n\n\n(defn- parked-reader-over\n  \"A real gated machine over `source`, parked on its first read: one\n   more delivered value and it halts with :done.\"\n  [source]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/then {:type :stream/next, :source (s/v 'c)}\n                               (s/lit :done)))\n        [sref m1] (engine/attach-resource m0 source)\n        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)]\n    (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))))\n\n\n(defn- reading-writer\n  \"A real gated machine over `source`, parked on its first read: the\n   value it reads is written to the enrolled `target`, then :side to\n   `side`, then it halts with :done.\"\n  [source target side]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/let1 'v (s/next-of (s/v 'c))\n                               (s/then {:type :stream/put, :target (s/v 'w),\n                                        :val (s/v 'v)}\n                                       (s/then {:type :stream/put,\n                                                :target (s/v 'x),\n                                                :val (s/lit :side)}\n                                               (s/lit :done)))))\n        [sref m1] (engine/attach-resource m0 source)\n        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n        [wref m3] (engine/attach-resource m2 target)\n        [xref m4] (engine/attach-resource m3 side)]\n    (vm/run (assoc m4 :store {'c cref, 'w wref, 'x xref}\n                   :yin.k/gate :running))))\n\n\n(defn- attach-over\n  [ctx table]\n  (fn [descriptor]\n    (swap! (:attaches ctx) inc)\n    (if-some [h (get table (:dao.stream/identity descriptor))]\n      {:dao.stream/outcome :dao.stream/ok :dao.stream/handle h}\n      {:dao.stream/outcome :dao.stream/not-found})))\n\n\n(defn- observe-over\n  [ctx]\n  (fn [h op arg]\n    (swap! (:observes ctx) inc)\n    (case op\n      :next (stream/next h arg)\n      :cursor (stream/cursor h arg))))\n\n\n(defn- same-id-server\n  []\n  (fn [h]\n    (let [id (:dao.stream/identity (stream/descriptor h))]\n      {:dao.stream/identity id\n       :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n                            :dao.stream/identity id}})))\n\n\n;; =============================================================================\n;; Opening a life's world\n;; =============================================================================\n\n\n(defn- composition-config\n  [w mode]\n  (cond-> {:mode mode\n           :source-index (fn [] @s/source-index)\n           :renewal-interval {:s 10}\n           :store (:store w)\n           :diagnostics (:diagnostics w)\n           :medium \"stage-e\"\n           :clock (fn [] {:s @(:clock w)})}\n    (= :exclusive mode) (assoc :failure-model :process-crash\n                               :backend (:authority-backend w)\n                               :duration {:s 30}\n                               :journals (:journals w))))\n\n\n(defn- world-table\n  \"The holder table and protection of the life's world kind.\"\n  [w]\n  (case (:kind w)\n    :parked {:table (if (= :none (:attach w)) {} {prog-id (:prog w)})\n             :protection {prog-id :at-least-once}}\n    :rows {:table (cond-> {source-id (:source w) side-id (:side w)}\n                    (:target w) (assoc (:target w) (:reader w)))\n           :protection (cond-> {source-id :at-least-once side-id :at-least-once}\n                         (:target w) (assoc (:target w) :enrolled))}))\n\n\n(defn- holder-seams\n  [ctx w]\n  (let [{:keys [table protection]} (world-table w)]\n    {:protection protection\n     :receiver (s/new-machine)\n     :attach! (attach-over ctx table)\n     :observe! (observe-over ctx)\n     :serve! (if (= :parked (:kind w))\n               (fn [_h]\n                 {:dao.stream/identity prog-id\n                  :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n                                       :dao.stream/identity prog-id}})\n               (same-id-server))}))\n\n\n(defn- source-machine\n  [w]\n  (case (:kind w)\n    :parked (parked-reader-over (scenario-stream prog-id [] 0))\n    :rows (reading-writer (:source w) (:reader w) (:side w))))\n\n\n(defn open-world!\n  \"Open the life's world over `spec`: the durable media, mortal under\n   `ctx`, and the composition over them.  Answers the world map with\n   :c the open composition, or :refusal the composition's data refusal.\"\n  [ctx spec]\n  (let [{:keys [root kind mode]} spec\n        mode (or mode :exclusive)\n        p (paths root)\n        _ (ensure-dir! root)\n        partitioned (atom false)\n        authority-backend (when (= :exclusive mode)\n                            (let [b (mortal-backend ctx :authority\n                                                    (open-file-backend! (:authority p)))\n                                  write! (::journal/write-frame! b)]\n                              ;; the protected consumer partitioned from\n                              ;; its authority: every frame write fails\n                              ;; while the flag stands\n                              (assoc b ::journal/write-frame!\n                                     (fn [bs]\n                                       (if @partitioned\n                                         (throw (ex-info \"stage E: the authority is partitioned\" {}))\n                                         (write! bs))))))\n        store (mortal-store ctx (jing-file/create-content-file (:store p))\n                            (set (:unreadable spec)))\n        side-backend (when (= :rows kind)\n                       (mortal-backend ctx :side (open-file-backend! (:side p))))\n        side (when side-backend\n               (journal-stream side-id (:dao.stream/handle (journal/open! side-backend nil))))\n        w {:root root\n           :kind kind\n           :mode mode\n           :attach (:attach spec)\n           :clock (atom (or (:clock spec) 1))\n           :store store\n           :diagnostics (log-writer)\n           :authority-backend authority-backend\n           :side-backend side-backend\n           :journals (if (= :exclusive mode)\n                       (mortal-journals ctx (:journals p))\n                       (compose/memory-journals (atom {})))\n           :prog (scenario-stream prog-id (or (:prog spec) []) 0)\n           :source (scenario-stream source-id (or (:source spec) [\"A\"])\n                                    (or (:evict-floor spec) 0))\n           :side side\n           :partitioned partitioned\n           :carrier (atom :dao.stream/ok)\n           :held (atom false)\n           :inbound (:inbound spec)}\n        opened (compose/open! (composition-config w mode))\n        c (:yin.vm.ucf.compose/composition opened)]\n    (if (nil? c)\n      (assoc w :refusal (->data opened))\n      (let [w (assoc w :c c)]\n        (if (= :rows kind)\n          (let [i (or (:target spec)\n                      (let [e (compose/enroll! c)]\n                        ((:emit! ctx) {:event :enrolled :target (:yin.k/target e)})\n                        (:yin.k/target e)))]\n            (assoc w :target i :reader (compose/target-reader c i)))\n          w)))))\n\n\n(defn release-dead!\n  \"What the operating system does for a killed process, done for a life\n   killed in this process: every file backend and the store it opened\n   released, nothing written.\"\n  [ctx]\n  (doseq [[kind x] @(:opened ctx)]\n    (try\n      (case kind\n        :backend (when (contains? x ::file-journal/close!) (file-journal/close! x))\n        :store ((:close-fn x)))\n      (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))))\n\n\n(defn close-world!\n  \"Release everything a live world holds: the composition (its journal\n   backends), the authority backend, the side log and the store.\"\n  [w]\n  (let [safe (fn [f]\n               (try (f) (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))]\n    (when-some [c (:c w)] (safe #(compose/close! c)))\n    (when-some [b (:authority-backend w)] (safe #(file-journal/close! b)))\n    (when-some [b (:side-backend w)] (safe #(file-journal/close! b)))\n    (when-some [close! (get-in w [:store :close-fn])] (safe close!))\n    nil))\n\n\n;; =============================================================================\n;; Reading a live world\n;; =============================================================================\n\n\n(defn- journal-values\n  [j]\n  (if (nil? j)\n    []\n    (read-values j)))\n\n\n(defn replies-of","numLines":520,"startLine":420,"totalLines":1411}},"tool_result_meta":[{"id":"toolu_01D51dMUa17uxjR2bvZK7A7M","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
