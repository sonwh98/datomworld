{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U8A6Brx6SgoWKU2gGpxFrX","type":"tool_result","content":"140\t\n141\t(defn- live-leases\n142\t  \"The leases a projection shows live (no cause), as entries.\"\n143\t  [p]\n144\t  (filterv #(nil? (:dao.lease/cause %)) (vals (:leases p))))\n145\t\n146\t\n147\t;; =============================================================================\n148\t;; Row 7: kills around completion, and the successor run on the receiver\n149\t;; =============================================================================\n150\t\n151\t\n152\t(def row7-cuts\n153\t  [nil\n154\t   :row7/after-successor-append\n155\t   :row7/after-resumed-report\n156\t   :row7/after-release-append\n157\t   :row7/after-closure])\n158\t\n159\t\n160\t(defn row7\n161\t  \"Row 7 over one ordered host pair: the source runs, hands off and exits\n162\t   on :src, killed at `cut` (none: a clean handoff); the receiver host\n163\t   recovers the source's exit from its journals and finishes it, then\n164\t   runs the recorded successor once from the canonical bytes in the\n165\t   store, its program input delivered on the receiver -- every value\n166\t   crossing between the two runtimes is a durable byte.\"\n167\t  [cut]\n168\t  {:id [:row-7 cut]\n169\t   :holders [\"h1\" \"h2\" \"h3\" \"h4\" \"h5\"]\n170\t   :lives\n171\t   [(fn [_]\n172\t      {:on :src :kind :parked :cut cut\n173\t       :ops [[:source \"h1\"]\n174\t             [:until \"h1\" :running 60]\n175\t             [:binding \"h1\"]\n176\t             [:hand-off \"h1\"]\n177\t             [:until \"h1\" :exited 80]]})\n178\t    (fn [results]\n179\t      (when (:killed? (peek results))\n180\t        {:on :rcv :kind :parked\n181\t         :ops (if (= :row7/after-successor-append cut)\n182\t                ;; the attempted successor's candidate competes from the\n183\t                ;; start; the regranted origin hands off on its activation\n184\t                ;; tick (one tick later its machine holds an unapplied\n185\t                ;; observation and is no liftable safepoint, UCF 7.4.1)\n186\t                [[:at-open]\n187\t                 [:source \"h1\"]\n188\t                 [:candidate \"h5\" {:kind :successor :of \"h1\"}]\n189\t                 [:until \"h1\" :running 90]\n190\t                 [:snapshot :before-closure]\n191\t                 [:hand-off \"h1\"]\n192\t                 [:until \"h1\" :exited 90]]\n193\t                [[:at-open]\n194\t                 [:source \"h1\"]\n195\t                 [:until \"h1\" :exited 90]])}))\n196\t    (fn [_]\n197\t      {:on :rcv :kind :parked\n198\t       :ops [[:candidate \"h2\" {:kind :successor :of \"h1\"}]\n199\t             [:until \"h2\" :running 60]\n200\t             [:binding \"h2\"]\n201\t             [:candidate \"h3\" {:kind :successor :of \"h1\"}]\n202\t             [:candidate \"h4\" {:kind :fence :of \"h1\"}]\n203\t             [:ticks 10]\n204\t             [:snapshot :eligibility]\n205\t             [:append-prog \"B\"]\n206\t             [:until \"h2\" :exited 80]]})]\n207\t   :check\n208\t   (fn [results inspection]\n209\t     (let [l1 (first results)\n210\t           l1-binding (binding-of l1 \"h1\")\n211\t           origin (:occurrence l1-binding)\n212\t           origin-lease (:lease l1-binding)\n213\t           recovery (when (:killed? l1) (nth results 1))\n214\t           l3 (peek results)\n215\t           p (:projection inspection)\n216\t           h1-journal (get-in inspection [:journals \"h1\"])\n217\t           successor-mint (last (filter #(and (= :yin.k/minted (:yin.k/journal %))\n218\t                                              (= :yin.k/successor (:yin.k/role %)))\n219\t                                        h1-journal))\n220\t           successor (:yin.k/occurrence successor-mint)]\n221\t       (is (some? origin) \"the source was granted and ran\")\n222\t       (if (nil? cut)\n223\t         (do (is (not (:killed? l1)))\n224\t             (is (= :exited (:phase (holder l1 \"h1\"))) \"a clean exit on the source host\"))\n225\t         (do (is (:killed? l1) \"the source host was killed at the cut\")\n226\t             (is (= cut (:cut (cut-fired l1))))))\n227\t       (when recovery\n228\t         (let [at-open (:projection (snapshot-of recovery :at-open))]\n229\t           (testing \"a recoverable authority restart advances the epoch before new admission\"\n230\t             (when-not (= :row7/after-closure cut)\n231\t               (is (= :policy (get-in at-open [:leases origin-lease :dao.lease/cause]))\n232\t                   \"the reopened authority reclaimed the live tenure, cause :policy\")\n233\t               (is (= 1 (get-in at-open [:occurrences origin :yin.k/epoch]))\n234\t                   \"and raised the epoch once, before any holder was admitted\")\n235\t               (is (nil? (get-in at-open [:occurrences origin :dao.lease/lease])))))\n236\t           (if (= :row7/after-successor-append cut)\n237\t             (let [before (snapshot-of recovery :before-closure)\n238\t                   attempted (get-in before [:holders \"h5\"])]\n239\t               (is (= :running (get-in before [:holders \"h1\" :phase]))\n240\t                   \"an unaccepted report recovers the last recorded checkpoint\")\n241\t               (is (= :exited (:phase (holder recovery \"h1\")))\n242\t                   \"whose regrant hands off and exits on the receiver host\")\n243\t               (is (= origin (get-in before [:holders \"h1\" :occurrence])))\n244\t               (is (nil? (get-in before [:projection :occurrences origin :yin.k/closed])))\n245\t               (is (not= :running (:phase attempted))\n246\t                   \"before closure no successor is eligible\")\n247\t               (is (nil? (:lease attempted))))\n248\t             (is (= :exited (:phase (holder recovery \"h1\")))\n249\t                 \"the receiver host finished the recovered exit\"))))\n250\t       (testing \"the origin's completion\"\n251\t         (is (some? (get-in p [:occurrences origin :yin.k/closed]))\n252\t             \"the closure stands\")\n253\t         (is (nil? (get-in p [:occurrences origin :dao.lease/lease])))\n254\t         (is (= 1 (count (distinct (map #(get-in % [:yin.k/request :yin.k/request-id])\n255\t                                        (filter #(= origin (:yin.k/occurrence %))\n256\t                                                (records h1-journal :yin.k/intent :yin.k/resumed))))))\n257\t             \"every report of the origin is the identical request\"))\n258\t       (testing \"the successor, run on the receiver from durable bytes\"\n259\t         (let [elig (snapshot-of l3 :eligibility)\n260\t               h2 (get-in elig [:holders \"h2\"])]\n261\t           (is (some? successor))\n262\t           (is (= successor (:occurrence h2)) \"the recorded successor runs\")\n263\t           (is (= :running (:phase h2)))\n264\t           (is (= 0 (:epoch h2)) \"a successor's first grant binds epoch 0\")\n265\t           (is (not= :running (get-in elig [:holders \"h3\" :phase]))\n266\t               \"the recorded successor is eligible once\")\n267\t           (is (nil? (get-in elig [:holders \"h3\" :lease])))\n268\t           (is (not= :running (get-in elig [:holders \"h4\" :phase]))\n269\t               \"after closure the origin never grants again\")\n270\t           (is (nil? (get-in elig [:holders \"h4\" :lease])))\n271\t           (is (= 1 (count (filter #(= successor (:yin.k/occurrence %))\n272\t                                   (live-leases (:projection elig)))))\n273\t               \"one live tenure of the successor\")\n274\t           (is (= :exited (:phase (holder l3 \"h2\")))\n275\t               \"the successor read its input on the receiver and exited\")\n276\t           (is (some? (get-in p [:occurrences successor :yin.k/closed]))\n277\t               \"and its own closure stands\")))))})\n278\t\n279\t\n280\t;; =============================================================================\n281\t;; Shared readers for the rows-world scenarios\n282\t;; =============================================================================\n283\t\n284\t\n285\t(defn- id0\n286\t  [o]\n287\t  {:yin.k/occurrence o :yin.k/seq 0})\n288\t\n289\t\n290\t(defn- admit-replies\n291\t  \"The :yin.k/admit replies of a reply journal, in order.\"\n292\t  [replies]\n293\t  (filterv #(= :yin.k/admit (:yin.k/reply %)) replies))\n294\t\n295\t\n296\t(defn- admissions\n297\t  [replies]\n298\t  (mapv #(get-in % [:yin.k/answer :yin.k/admission]) (admit-replies replies)))\n299\t\n300\t\n301\t(defn- reply-to\n302\t  \"The answer of the reply whose request id is `rid`.\"\n303\t  [replies rid]\n304\t  (some #(when (= rid (:yin.k/request-id %)) (:yin.k/answer %)) replies))\n305\t\n306\t\n307\t(defn- target-values\n308\t  [inspection results]\n309\t  (get-in inspection [:targets (enrolled-target results)]))\n310\t\n311\t\n312\t(defn- cut-event\n313\t  [result]\n314\t  (some #(when (= :cut (:event %)) %) (:events result)))\n315\t\n316\t\n317\t(defn- cut-inbound\n318\t  \"The requests of `kind` holder `h` had sent when its life was killed at\n319\t   a tick cut.\"\n320\t  [result h kind]\n321\t  (filterv #(= kind (:yin.k/request %)) (get-in (cut-event result) [:at :inbound h])))\n322\t\n323\t\n324\t(defn- rows-recovery\n325\t  \"The rows-world life that recovers holder h1 on the receiver host.\"\n326\t  [results ops]\n327\t  {:on :rcv :kind :rows :target (enrolled-target results) :ops ops})\n328\t\n329\t\n330\t;; =============================================================================\n331\t;; Row 4: kills around the atomic effect commitment and the result append\n332\t;; =============================================================================\n333\t\n334\t\n335\t(def row4-cuts\n336\t  [:row4/before-commit :row4/after-commit :row4/before-result-append])\n337\t\n338\t\n339\t(defn row4\n340\t  [cut]\n341\t  {:id [:row-4 cut]\n342\t   :lives\n343\t   [(fn [_]\n344\t      {:on :src :kind :rows :cut cut\n345\t       :ops [[:source \"h1\"]\n346\t             [:until \"h1\" :running 60]\n347\t             [:binding \"h1\"]\n348\t             [:until-inbound \"h1\" :yin.k/admit 40]\n349\t             [:snapshot :admit-sent]\n350\t             [:until \"h1\" :safepoint 60]]})\n351\t    (fn [results]\n352\t      (rows-recovery results [[:at-open] [:source \"h1\"] [:until \"h1\" :safepoint 90]]))]\n353\t   :check\n354\t   (fn [results inspection]\n355\t     (let [[l1 l2] results\n356\t           b (binding-of l1 \"h1\")\n357\t           id (id0 (:occurrence b))\n358\t           sent (filterv #(= :yin.k/admit (:yin.k/request %))\n359\t                         (get-in (snapshot-of l1 :admit-sent) [:inbound \"h1\"]))\n360\t           resent (filterv #(= :yin.k/admit (:yin.k/request %))\n361\t                           (get-in (final l2) [:inbound \"h1\"]))\n362\t           replies (admit-replies (get-in inspection [:replies \"h1\"]))\n363\t           answers (mapv :yin.k/answer replies)\n364\t           outcomes (:outcomes inspection)\n365\t           committed (filterv #(= :committed (:yin.k/admission %)) answers)]\n366\t       (is (:killed? l1) \"the first tenure was killed at the cut\")\n367\t       (is (= cut (:cut (cut-event l1))))\n368\t       (is (seq sent))\n369\t       (is (every? #(= id (get-in % [:yin.k/fenced-envelope :yin.k/op-id])) (concat sent resent))\n370\t           \"the write carries the one stable id in both tenures\")\n371\t       (is (every? #(= \"A\" (get-in % [:yin.k/fenced-envelope :yin.k/value])) (concat sent resent))\n372\t           \"and the same intent\")\n373\t       (is (seq resent) \"the regranted tenure retried the write\")\n374\t       (is (= :policy (get-in (snapshot-of l2 :at-open)\n375\t                              [:projection :leases (:lease b) :dao.lease/cause]))\n376\t           \"the reopened authority reclaimed the killed tenure\")\n377\t       (is (= [\"A\"] (target-values inspection results)) \"exactly one commit on the enrolled target\")\n378\t       (is (= 1 (count outcomes)) \"one committed outcome in the ledger\")\n379\t       (is (= id (:yin.k/op-id (first outcomes))))\n380\t       (is (every? #(= id (:yin.k/op-id %)) answers) \"every answer names the stable id\")\n381\t       (is (every? #{:committed :replayed} (map :yin.k/admission answers)) (pr-str answers))\n382\t       (is (<= (count committed) 1))\n383\t       (is (= (if (= :row4/before-commit cut) 1 0) (count committed))\n384\t           (str \"a commit the cut prevented is the regrant's; one the cut kept \"\n385\t                \"is replayed, its reply lost with the killed process\"))\n386\t       (is (every? #(= (:yin.k/effect-result (first outcomes)) (:yin.k/effect-result %)) answers)\n387\t           \"every answer redelivers the recorded result\")\n388\t       (is (pos? (count (:side inspection)))\n389\t           \"the at-least-once side effect outside the transaction ran (no exactly-once claimed)\")))})\n390\t\n391\t\n392\t;; =============================================================================\n393\t;; Row 3: an effect delayed under epoch e, delivered across a reclaim to e+1\n394\t;; =============================================================================\n395\t\n396\t\n397\t(def row3-variants [:uncarried :committed])\n398\t\n399\t\n400\t(defn row3\n401\t  [variant]\n402\t  {:id [:row-3 variant]\n403\t   :lives\n404\t   [(fn [_]\n405\t      {:on :src :kind :rows\n406\t       :cut (case variant :uncarried :row4/admit-uncarried :committed :clause8/committed)\n407\t       :ops [[:source \"h1\"]\n408\t             [:until \"h1\" :running 60]\n409\t             [:binding \"h1\"]\n410\t             [:until \"h1\" :safepoint 60]]})\n411\t    (fn [results]\n412\t      (let [b (binding-of (first results) \"h1\")\n413\t            id (id0 (:occurrence b))\n414\t            ;; the delayed effect: the killed tenure's own admit request,\n415\t            ;; under its lease and epoch, as it stood when it was killed\n416\t            ;; (the committed variant's was carried; it is rebuilt from\n417\t            ;; the binding the same way)\n418\t            delayed (or (first (cut-inbound (first results) \"h1\" :yin.k/admit))\n419\t                        {:yin.k/request :yin.k/admit\n420\t                         :yin.k/request-id [:stage-e/delayed (:lease b)]\n421\t                         :yin.k/target (enrolled-target results)\n422\t                         :yin.k/fenced-envelope {:yin.k/envelope :yin.k/fenced-v1\n423\t                                                 :yin.k/incarnation (:lease b)\n424\t                                                 :yin.k/epoch (:epoch b)\n425\t                                                 :yin.k/op-id id\n426\t                                                 :yin.k/value \"A\"}})\n427\t            equal (fn [n]\n428\t                    [:admit \"h1\" {:rid [:stage-e/equal n]\n429\t                                  :lease [:binding \"h1\" :lease]\n430\t                                  :epoch [:binding \"h1\" :epoch]\n431\t                                  :op-id {:yin.k/occurrence [:binding \"h1\" :occurrence]\n432\t                                          :yin.k/seq 0}\n433\t                                  :value \"A\"}])]\n434\t        (rows-recovery results\n435\t                       [[:at-open]\n436\t                        [:source \"h1\"]\n437\t                        [:until \"h1\" :safepoint 90]\n438\t                        [:binding \"h1\"]\n439\t                        [:inject \"h1\" (assoc delayed :yin.k/request-id [:stage-e/delayed (:lease b)])]\n440\t                        (equal 1)\n441\t                        (equal 2)])))]\n442\t   :check\n443\t   (fn [results inspection]\n444\t     (let [[l1 l2] results\n445\t           b1 (binding-of l1 \"h1\")\n446\t           b2 (binding-of l2 \"h1\")\n447\t           replies (get-in inspection [:replies \"h1\"])\n448\t           stale (reply-to replies [:stage-e/delayed (:lease b1)])\n449\t           e1 (reply-to replies [:stage-e/equal 1])\n450\t           e2 (reply-to replies [:stage-e/equal 2])\n451\t           outcome (first (:outcomes inspection))]\n452\t       (is (:killed? l1))\n453\t       (is (= 0 (:epoch b1)) \"the delayed effect was issued under epoch 0\")\n454\t       (is (= 1 (:epoch b2)) \"the reclaim raised the epoch; the regrant holds epoch 1\")\n455\t       (is (not= (:lease b1) (:lease b2)))\n456\t       (is (= :stale (:yin.k/admission stale)) (pr-str stale))\n457\t       (is (= 1 (:yin.k/observed-epoch stale)) \"the stale answer names the current epoch\")\n458\t       (is (= [:replayed :replayed] [(:yin.k/admission e1) (:yin.k/admission e2)])\n459\t           \"the current holder's equal id and intent replays, twice\")\n460\t       (is (= (:yin.k/effect-result outcome) (:yin.k/effect-result e1) (:yin.k/effect-result e2))\n461\t           \"both answer the one stored result\")\n462\t       (is (= 1 (count (:outcomes inspection))) \"one commit in the ledger\")\n463\t       (is (= [\"A\"] (target-values inspection results))\n464\t           (str \"never both: \" (case variant\n465\t                                 :uncarried \"refusal after the reclaim, the regrant commits\"\n466\t                                 :committed \"commit before the reclaim, the regrant replays\")))\n467\t       (is (= (case variant :uncarried 1 :committed 0)\n468\t              (count (filter #(and (= :committed (get-in % [:yin.k/answer :yin.k/admission]))\n469\t                                   (= (:lease b2) (get-in % [:yin.k/answer :yin.k/incarnation])))\n470\t                             (admit-replies replies))))\n471\t           \"the regrant commits only what the killed tenure never committed\")))})\n472\t\n473\t\n474\t;; =============================================================================\n475\t;; Row 5: an evicted kept-cursor value after a real kill\n476\t;; =============================================================================\n477\t\n478\t\n479\t(def row5-variants [:with-inputs :without-inputs])\n480\t\n481\t\n482\t(defn row5\n483\t  [variant]\n484\t  {:id [:row-5 variant]\n485\t   :lives\n486\t   [(fn [_]\n487\t      {:on :src :kind :rows\n488\t       :cut (case variant :with-inputs :row5/input-carried :without-inputs :row5/input-uncarried)\n489\t       :ops [[:source \"h1\"]\n490\t             [:until \"h1\" :running 60]\n491\t             [:binding \"h1\"]\n492\t             [:until \"h1\" :safepoint 60]]})\n493\t    (fn [results]\n494\t      (assoc (rows-recovery\n495\t               results\n496\t               (case variant\n497\t                 :with-inputs [[:source \"h1\"]\n498\t                               [:until \"h1\" :safepoint 90]\n499\t                               [:binding \"h1\"]\n500\t                               [:admit \"h1\" {:rid [:stage-e/divergent 0]\n501\t                                             :lease [:binding \"h1\" :lease]\n502\t                                             :epoch [:binding \"h1\" :epoch]\n503\t                                             :op-id {:yin.k/occurrence [:binding \"h1\" :occurrence]\n504\t                                                     :yin.k/seq 0}\n505\t                                             :value \"Z\"}]]\n506\t                 :without-inputs [[:source \"h1\"]\n507\t                                  [:ticks 40]]))\n508\t             ;; the kept position's value is evicted before the recovery\n509\t             :evict-floor 1))]\n510\t   :check\n511\t   (fn [results inspection]\n512\t     (let [[l1 l2] results\n513\t           counts (get-in (final l2) [:counts])\n514\t           replies (get-in inspection [:replies \"h1\"])\n515\t           o (:occurrence (binding-of l1 \"h1\"))]\n516\t       (is (:killed? l1))\n517\t       (case variant\n518\t         :with-inputs\n519\t         (let [conflict (reply-to replies [:stage-e/divergent 0])]\n520\t           (is (= 0 (:observes counts))\n521\t               \"the recovery replayed its durable input, observing nothing live\")\n522\t           (is (= [\"A\"] (target-values inspection results))\n523\t               \"replay reproduced the old intent and result, not the eviction\")\n524\t           (is (= :intent-conflict (:yin.k/admission conflict)) (pr-str conflict))\n525\t           (is (= (id0 o) (:yin.k/op-id conflict)))\n526\t           (is (not (contains? conflict :yin.k/effect-result)) \"a conflict commits nothing\")\n527\t           (is (true? (get-in inspection [:projection :occurrences o :yin.k/quarantined]))\n528\t               \"divergence at the same id quarantined the occurrence\"))\n529\t         :without-inputs\n530\t         (do (is (pos? (:observes counts))\n531\t                 \"no durable input: the recovery re-read live, into the eviction\")\n532\t             (is (not-any? #{\"A\"} (target-values inspection results))\n533\t                 \"nothing is replayed from evidence that was never recorded\")\n534\t             (is (not-any? #{:intent-conflict :input-conflict} (admissions replies))\n535\t                 \"no intent stood at the id, so nothing diverged\")\n536\t             ;; PINNED, pending an Architect ruling (reported): the\n537\t             ;; eviction reaches the program as the gap marker and the\n538\t             ;; program's write of it commits at the id as a fresh effect\n539\t             (is (= [:dao.stream/gap] (target-values inspection results))\n540\t                 \"observed: the exposed gap marker is the first and only commit\")))))})\n541\t\n542\t\n543\t;; =============================================================================\n544\t;; Row 2: export phases, carrier failures, kill and reopen after each\n545\t;; =============================================================================\n546\t\n547\t\n548\t(def row2-pre-fence-cuts\n549\t  [:export/after-minted :export/after-serve-intent :export/after-serve-ack\n550\t   :export/after-store-intent :export/store-put-before :export/store-put-after\n551\t   :export/body-put-before :export/body-put-after :export/after-store-ack\n552\t   :export/before-fenced])\n553\t\n554\t\n555\t(def row2-post-fence-cuts\n556\t  [:export/after-fenced :export/after-offer-intent :export/after-offer-attempt\n557\t   :export/after-offer-ack])\n558\t\n559\t"}]},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"2aeb3eee-78ca-452c-a7e8-0485720699ff","timestamp":"2026-10-13T18:37:54.359Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_scenarios.cljc","content":"\n(defn- live-leases\n  \"The leases a projection shows live (no cause), as entries.\"\n  [p]\n  (filterv #(nil? (:dao.lease/cause %)) (vals (:leases p))))\n\n\n;; =============================================================================\n;; Row 7: kills around completion, and the successor run on the receiver\n;; =============================================================================\n\n\n(def row7-cuts\n  [nil\n   :row7/after-successor-append\n   :row7/after-resumed-report\n   :row7/after-release-append\n   :row7/after-closure])\n\n\n(defn row7\n  \"Row 7 over one ordered host pair: the source runs, hands off and exits\n   on :src, killed at `cut` (none: a clean handoff); the receiver host\n   recovers the source's exit from its journals and finishes it, then\n   runs the recorded successor once from the canonical bytes in the\n   store, its program input delivered on the receiver -- every value\n   crossing between the two runtimes is a durable byte.\"\n  [cut]\n  {:id [:row-7 cut]\n   :holders [\"h1\" \"h2\" \"h3\" \"h4\" \"h5\"]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut cut\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 60]\n             [:binding \"h1\"]\n             [:hand-off \"h1\"]\n             [:until \"h1\" :exited 80]]})\n    (fn [results]\n      (when (:killed? (peek results))\n        {:on :rcv :kind :parked\n         :ops (if (= :row7/after-successor-append cut)\n                ;; the attempted successor's candidate competes from the\n                ;; start; the regranted origin hands off on its activation\n                ;; tick (one tick later its machine holds an unapplied\n                ;; observation and is no liftable safepoint, UCF 7.4.1)\n                [[:at-open]\n                 [:source \"h1\"]\n                 [:candidate \"h5\" {:kind :successor :of \"h1\"}]\n                 [:until \"h1\" :running 90]\n                 [:snapshot :before-closure]\n                 [:hand-off \"h1\"]\n                 [:until \"h1\" :exited 90]]\n                [[:at-open]\n                 [:source \"h1\"]\n                 [:until \"h1\" :exited 90]])}))\n    (fn [_]\n      {:on :rcv :kind :parked\n       :ops [[:candidate \"h2\" {:kind :successor :of \"h1\"}]\n             [:until \"h2\" :running 60]\n             [:binding \"h2\"]\n             [:candidate \"h3\" {:kind :successor :of \"h1\"}]\n             [:candidate \"h4\" {:kind :fence :of \"h1\"}]\n             [:ticks 10]\n             [:snapshot :eligibility]\n             [:append-prog \"B\"]\n             [:until \"h2\" :exited 80]]})]\n   :check\n   (fn [results inspection]\n     (let [l1 (first results)\n           l1-binding (binding-of l1 \"h1\")\n           origin (:occurrence l1-binding)\n           origin-lease (:lease l1-binding)\n           recovery (when (:killed? l1) (nth results 1))\n           l3 (peek results)\n           p (:projection inspection)\n           h1-journal (get-in inspection [:journals \"h1\"])\n           successor-mint (last (filter #(and (= :yin.k/minted (:yin.k/journal %))\n                                              (= :yin.k/successor (:yin.k/role %)))\n                                        h1-journal))\n           successor (:yin.k/occurrence successor-mint)]\n       (is (some? origin) \"the source was granted and ran\")\n       (if (nil? cut)\n         (do (is (not (:killed? l1)))\n             (is (= :exited (:phase (holder l1 \"h1\"))) \"a clean exit on the source host\"))\n         (do (is (:killed? l1) \"the source host was killed at the cut\")\n             (is (= cut (:cut (cut-fired l1))))))\n       (when recovery\n         (let [at-open (:projection (snapshot-of recovery :at-open))]\n           (testing \"a recoverable authority restart advances the epoch before new admission\"\n             (when-not (= :row7/after-closure cut)\n               (is (= :policy (get-in at-open [:leases origin-lease :dao.lease/cause]))\n                   \"the reopened authority reclaimed the live tenure, cause :policy\")\n               (is (= 1 (get-in at-open [:occurrences origin :yin.k/epoch]))\n                   \"and raised the epoch once, before any holder was admitted\")\n               (is (nil? (get-in at-open [:occurrences origin :dao.lease/lease])))))\n           (if (= :row7/after-successor-append cut)\n             (let [before (snapshot-of recovery :before-closure)\n                   attempted (get-in before [:holders \"h5\"])]\n               (is (= :running (get-in before [:holders \"h1\" :phase]))\n                   \"an unaccepted report recovers the last recorded checkpoint\")\n               (is (= :exited (:phase (holder recovery \"h1\")))\n                   \"whose regrant hands off and exits on the receiver host\")\n               (is (= origin (get-in before [:holders \"h1\" :occurrence])))\n               (is (nil? (get-in before [:projection :occurrences origin :yin.k/closed])))\n               (is (not= :running (:phase attempted))\n                   \"before closure no successor is eligible\")\n               (is (nil? (:lease attempted))))\n             (is (= :exited (:phase (holder recovery \"h1\")))\n                 \"the receiver host finished the recovered exit\"))))\n       (testing \"the origin's completion\"\n         (is (some? (get-in p [:occurrences origin :yin.k/closed]))\n             \"the closure stands\")\n         (is (nil? (get-in p [:occurrences origin :dao.lease/lease])))\n         (is (= 1 (count (distinct (map #(get-in % [:yin.k/request :yin.k/request-id])\n                                        (filter #(= origin (:yin.k/occurrence %))\n                                                (records h1-journal :yin.k/intent :yin.k/resumed))))))\n             \"every report of the origin is the identical request\"))\n       (testing \"the successor, run on the receiver from durable bytes\"\n         (let [elig (snapshot-of l3 :eligibility)\n               h2 (get-in elig [:holders \"h2\"])]\n           (is (some? successor))\n           (is (= successor (:occurrence h2)) \"the recorded successor runs\")\n           (is (= :running (:phase h2)))\n           (is (= 0 (:epoch h2)) \"a successor's first grant binds epoch 0\")\n           (is (not= :running (get-in elig [:holders \"h3\" :phase]))\n               \"the recorded successor is eligible once\")\n           (is (nil? (get-in elig [:holders \"h3\" :lease])))\n           (is (not= :running (get-in elig [:holders \"h4\" :phase]))\n               \"after closure the origin never grants again\")\n           (is (nil? (get-in elig [:holders \"h4\" :lease])))\n           (is (= 1 (count (filter #(= successor (:yin.k/occurrence %))\n                                   (live-leases (:projection elig)))))\n               \"one live tenure of the successor\")\n           (is (= :exited (:phase (holder l3 \"h2\")))\n               \"the successor read its input on the receiver and exited\")\n           (is (some? (get-in p [:occurrences successor :yin.k/closed]))\n               \"and its own closure stands\")))))})\n\n\n;; =============================================================================\n;; Shared readers for the rows-world scenarios\n;; =============================================================================\n\n\n(defn- id0\n  [o]\n  {:yin.k/occurrence o :yin.k/seq 0})\n\n\n(defn- admit-replies\n  \"The :yin.k/admit replies of a reply journal, in order.\"\n  [replies]\n  (filterv #(= :yin.k/admit (:yin.k/reply %)) replies))\n\n\n(defn- admissions\n  [replies]\n  (mapv #(get-in % [:yin.k/answer :yin.k/admission]) (admit-replies replies)))\n\n\n(defn- reply-to\n  \"The answer of the reply whose request id is `rid`.\"\n  [replies rid]\n  (some #(when (= rid (:yin.k/request-id %)) (:yin.k/answer %)) replies))\n\n\n(defn- target-values\n  [inspection results]\n  (get-in inspection [:targets (enrolled-target results)]))\n\n\n(defn- cut-event\n  [result]\n  (some #(when (= :cut (:event %)) %) (:events result)))\n\n\n(defn- cut-inbound\n  \"The requests of `kind` holder `h` had sent when its life was killed at\n   a tick cut.\"\n  [result h kind]\n  (filterv #(= kind (:yin.k/request %)) (get-in (cut-event result) [:at :inbound h])))\n\n\n(defn- rows-recovery\n  \"The rows-world life that recovers holder h1 on the receiver host.\"\n  [results ops]\n  {:on :rcv :kind :rows :target (enrolled-target results) :ops ops})\n\n\n;; =============================================================================\n;; Row 4: kills around the atomic effect commitment and the result append\n;; =============================================================================\n\n\n(def row4-cuts\n  [:row4/before-commit :row4/after-commit :row4/before-result-append])\n\n\n(defn row4\n  [cut]\n  {:id [:row-4 cut]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows :cut cut\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 60]\n             [:binding \"h1\"]\n             [:until-inbound \"h1\" :yin.k/admit 40]\n             [:snapshot :admit-sent]\n             [:until \"h1\" :safepoint 60]]})\n    (fn [results]\n      (rows-recovery results [[:at-open] [:source \"h1\"] [:until \"h1\" :safepoint 90]]))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           b (binding-of l1 \"h1\")\n           id (id0 (:occurrence b))\n           sent (filterv #(= :yin.k/admit (:yin.k/request %))\n                         (get-in (snapshot-of l1 :admit-sent) [:inbound \"h1\"]))\n           resent (filterv #(= :yin.k/admit (:yin.k/request %))\n                           (get-in (final l2) [:inbound \"h1\"]))\n           replies (admit-replies (get-in inspection [:replies \"h1\"]))\n           answers (mapv :yin.k/answer replies)\n           outcomes (:outcomes inspection)\n           committed (filterv #(= :committed (:yin.k/admission %)) answers)]\n       (is (:killed? l1) \"the first tenure was killed at the cut\")\n       (is (= cut (:cut (cut-event l1))))\n       (is (seq sent))\n       (is (every? #(= id (get-in % [:yin.k/fenced-envelope :yin.k/op-id])) (concat sent resent))\n           \"the write carries the one stable id in both tenures\")\n       (is (every? #(= \"A\" (get-in % [:yin.k/fenced-envelope :yin.k/value])) (concat sent resent))\n           \"and the same intent\")\n       (is (seq resent) \"the regranted tenure retried the write\")\n       (is (= :policy (get-in (snapshot-of l2 :at-open)\n                              [:projection :leases (:lease b) :dao.lease/cause]))\n           \"the reopened authority reclaimed the killed tenure\")\n       (is (= [\"A\"] (target-values inspection results)) \"exactly one commit on the enrolled target\")\n       (is (= 1 (count outcomes)) \"one committed outcome in the ledger\")\n       (is (= id (:yin.k/op-id (first outcomes))))\n       (is (every? #(= id (:yin.k/op-id %)) answers) \"every answer names the stable id\")\n       (is (every? #{:committed :replayed} (map :yin.k/admission answers)) (pr-str answers))\n       (is (<= (count committed) 1))\n       (is (= (if (= :row4/before-commit cut) 1 0) (count committed))\n           (str \"a commit the cut prevented is the regrant's; one the cut kept \"\n                \"is replayed, its reply lost with the killed process\"))\n       (is (every? #(= (:yin.k/effect-result (first outcomes)) (:yin.k/effect-result %)) answers)\n           \"every answer redelivers the recorded result\")\n       (is (pos? (count (:side inspection)))\n           \"the at-least-once side effect outside the transaction ran (no exactly-once claimed)\")))})\n\n\n;; =============================================================================\n;; Row 3: an effect delayed under epoch e, delivered across a reclaim to e+1\n;; =============================================================================\n\n\n(def row3-variants [:uncarried :committed])\n\n\n(defn row3\n  [variant]\n  {:id [:row-3 variant]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows\n       :cut (case variant :uncarried :row4/admit-uncarried :committed :clause8/committed)\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 60]\n             [:binding \"h1\"]\n             [:until \"h1\" :safepoint 60]]})\n    (fn [results]\n      (let [b (binding-of (first results) \"h1\")\n            id (id0 (:occurrence b))\n            ;; the delayed effect: the killed tenure's own admit request,\n            ;; under its lease and epoch, as it stood when it was killed\n            ;; (the committed variant's was carried; it is rebuilt from\n            ;; the binding the same way)\n            delayed (or (first (cut-inbound (first results) \"h1\" :yin.k/admit))\n                        {:yin.k/request :yin.k/admit\n                         :yin.k/request-id [:stage-e/delayed (:lease b)]\n                         :yin.k/target (enrolled-target results)\n                         :yin.k/fenced-envelope {:yin.k/envelope :yin.k/fenced-v1\n                                                 :yin.k/incarnation (:lease b)\n                                                 :yin.k/epoch (:epoch b)\n                                                 :yin.k/op-id id\n                                                 :yin.k/value \"A\"}})\n            equal (fn [n]\n                    [:admit \"h1\" {:rid [:stage-e/equal n]\n                                  :lease [:binding \"h1\" :lease]\n                                  :epoch [:binding \"h1\" :epoch]\n                                  :op-id {:yin.k/occurrence [:binding \"h1\" :occurrence]\n                                          :yin.k/seq 0}\n                                  :value \"A\"}])]\n        (rows-recovery results\n                       [[:at-open]\n                        [:source \"h1\"]\n                        [:until \"h1\" :safepoint 90]\n                        [:binding \"h1\"]\n                        [:inject \"h1\" (assoc delayed :yin.k/request-id [:stage-e/delayed (:lease b)])]\n                        (equal 1)\n                        (equal 2)])))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           b1 (binding-of l1 \"h1\")\n           b2 (binding-of l2 \"h1\")\n           replies (get-in inspection [:replies \"h1\"])\n           stale (reply-to replies [:stage-e/delayed (:lease b1)])\n           e1 (reply-to replies [:stage-e/equal 1])\n           e2 (reply-to replies [:stage-e/equal 2])\n           outcome (first (:outcomes inspection))]\n       (is (:killed? l1))\n       (is (= 0 (:epoch b1)) \"the delayed effect was issued under epoch 0\")\n       (is (= 1 (:epoch b2)) \"the reclaim raised the epoch; the regrant holds epoch 1\")\n       (is (not= (:lease b1) (:lease b2)))\n       (is (= :stale (:yin.k/admission stale)) (pr-str stale))\n       (is (= 1 (:yin.k/observed-epoch stale)) \"the stale answer names the current epoch\")\n       (is (= [:replayed :replayed] [(:yin.k/admission e1) (:yin.k/admission e2)])\n           \"the current holder's equal id and intent replays, twice\")\n       (is (= (:yin.k/effect-result outcome) (:yin.k/effect-result e1) (:yin.k/effect-result e2))\n           \"both answer the one stored result\")\n       (is (= 1 (count (:outcomes inspection))) \"one commit in the ledger\")\n       (is (= [\"A\"] (target-values inspection results))\n           (str \"never both: \" (case variant\n                                 :uncarried \"refusal after the reclaim, the regrant commits\"\n                                 :committed \"commit before the reclaim, the regrant replays\")))\n       (is (= (case variant :uncarried 1 :committed 0)\n              (count (filter #(and (= :committed (get-in % [:yin.k/answer :yin.k/admission]))\n                                   (= (:lease b2) (get-in % [:yin.k/answer :yin.k/incarnation])))\n                             (admit-replies replies))))\n           \"the regrant commits only what the killed tenure never committed\")))})\n\n\n;; =============================================================================\n;; Row 5: an evicted kept-cursor value after a real kill\n;; =============================================================================\n\n\n(def row5-variants [:with-inputs :without-inputs])\n\n\n(defn row5\n  [variant]\n  {:id [:row-5 variant]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows\n       :cut (case variant :with-inputs :row5/input-carried :without-inputs :row5/input-uncarried)\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 60]\n             [:binding \"h1\"]\n             [:until \"h1\" :safepoint 60]]})\n    (fn [results]\n      (assoc (rows-recovery\n               results\n               (case variant\n                 :with-inputs [[:source \"h1\"]\n                               [:until \"h1\" :safepoint 90]\n                               [:binding \"h1\"]\n                               [:admit \"h1\" {:rid [:stage-e/divergent 0]\n                                             :lease [:binding \"h1\" :lease]\n                                             :epoch [:binding \"h1\" :epoch]\n                                             :op-id {:yin.k/occurrence [:binding \"h1\" :occurrence]\n                                                     :yin.k/seq 0}\n                                             :value \"Z\"}]]\n                 :without-inputs [[:source \"h1\"]\n                                  [:ticks 40]]))\n             ;; the kept position's value is evicted before the recovery\n             :evict-floor 1))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           counts (get-in (final l2) [:counts])\n           replies (get-in inspection [:replies \"h1\"])\n           o (:occurrence (binding-of l1 \"h1\"))]\n       (is (:killed? l1))\n       (case variant\n         :with-inputs\n         (let [conflict (reply-to replies [:stage-e/divergent 0])]\n           (is (= 0 (:observes counts))\n               \"the recovery replayed its durable input, observing nothing live\")\n           (is (= [\"A\"] (target-values inspection results))\n               \"replay reproduced the old intent and result, not the eviction\")\n           (is (= :intent-conflict (:yin.k/admission conflict)) (pr-str conflict))\n           (is (= (id0 o) (:yin.k/op-id conflict)))\n           (is (not (contains? conflict :yin.k/effect-result)) \"a conflict commits nothing\")\n           (is (true? (get-in inspection [:projection :occurrences o :yin.k/quarantined]))\n               \"divergence at the same id quarantined the occurrence\"))\n         :without-inputs\n         (do (is (pos? (:observes counts))\n                 \"no durable input: the recovery re-read live, into the eviction\")\n             (is (not-any? #{\"A\"} (target-values inspection results))\n                 \"nothing is replayed from evidence that was never recorded\")\n             (is (not-any? #{:intent-conflict :input-conflict} (admissions replies))\n                 \"no intent stood at the id, so nothing diverged\")\n             ;; PINNED, pending an Architect ruling (reported): the\n             ;; eviction reaches the program as the gap marker and the\n             ;; program's write of it commits at the id as a fresh effect\n             (is (= [:dao.stream/gap] (target-values inspection results))\n                 \"observed: the exposed gap marker is the first and only commit\")))))})\n\n\n;; =============================================================================\n;; Row 2: export phases, carrier failures, kill and reopen after each\n;; =============================================================================\n\n\n(def row2-pre-fence-cuts\n  [:export/after-minted :export/after-serve-intent :export/after-serve-ack\n   :export/after-store-intent :export/store-put-before :export/store-put-after\n   :export/body-put-before :export/body-put-after :export/after-store-ack\n   :export/before-fenced])\n\n\n(def row2-post-fence-cuts\n  [:export/after-fenced :export/after-offer-intent :export/after-offer-attempt\n   :export/after-offer-ack])\n\n","numLines":420,"startLine":140,"totalLines":1327}},"tool_result_meta":[{"id":"toolu_01U8A6Brx6SgoWKU2gGpxFrX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
