{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012NaUDvfHxsMGuEfKCm8jj1","type":"tool_result","content":"140\t\n141\t\n142\t(defn run-life-in-process!\n143\t  \"Run one life of `spec` as a peer process on `host`: answer the same\n144\t   result shape as the in-process runner, with the host and pid beside\n145\t   it.  A cut event is a kill: the process is destroyed forcibly the\n146\t   moment it reports its cut.\"\n147\t  [host spec]\n148\t  (let [spec-file (io/file (:root spec) (str \"life-\" (random-uuid) \".edn\"))\n149\t        _ (io/make-parents spec-file)\n150\t        _ (spit spec-file (binding [*print-namespace-maps* false] (pr-str spec)))\n151\t        err-file (io/file (str (.getPath spec-file) \".err\"))\n152\t        process (-> (ProcessBuilder. ^java.util.List (command host (.getPath spec-file)))\n153\t                    (.redirectError err-file)\n154\t                    (.start))]\n155\t    (try\n156\t      (.close (.getOutputStream process))\n157\t      (let [q (line-pump process)\n158\t            deadline (+ (System/currentTimeMillis) life-ms)]\n159\t        (loop [events []]\n160\t          (let [left (- deadline (System/currentTimeMillis))\n161\t                line (when (pos? left) (.poll q left TimeUnit/MILLISECONDS))]\n162\t            (cond\n163\t              (nil? line)\n164\t              (throw (ex-info \"stage E: a life exceeded its deadline\"\n165\t                              {:host host :spec spec :events events\n166\t                               :stderr (slurp err-file)}))\n167\t\n168\t              (= ::eof line)\n169\t              (throw (ex-info \"stage E: a peer ended without a report\"\n170\t                              {:host host :spec spec :events events\n171\t                               :exit (.waitFor process)\n172\t                               :stderr (slurp err-file)}))\n173\t\n174\t              :else\n175\t              (let [e (parse-event line)\n176\t                    events (if e (conj events e) events)]\n177\t                (case (:event e)\n178\t                  :cut (do (destroy! process)\n179\t                           {:spec spec :events events :killed? true\n180\t                            :host host :pid (:pid (first events))\n181\t                            :exit (.exitValue process)})\n182\t                  :done (do (.waitFor process 60 TimeUnit/SECONDS)\n183\t                            {:spec spec :events events :killed? false\n184\t                             :report (:report e)\n185\t                             :host host :pid (:pid (first events))})\n186\t                  :error (throw (ex-info (str \"stage E: a peer failed: \" (:message e))\n187\t                                         {:host host :spec spec :event e\n188\t                                          :stderr (slurp err-file)}))\n189\t                  (recur events)))))))\n190\t      (finally\n191\t        (when (.isAlive process) (destroy! process))))))\n192\t\n193\t\n194\t;; =============================================================================\n195\t;; The durability record\n196\t;; =============================================================================\n197\t\n198\t\n199\t(def ^:private record-file \"target/stage-e-durability.edn\")\n200\t\n201\t\n202\t(defn- record!\n203\t  [scenario [src rcv] results]\n204\t  (let [line {:scenario (:id scenario)\n205\t              :transport :separate-processes\n206\t              :pair [src rcv]\n207\t              :lives (mapv (fn [r]\n208\t                             {:host (:host r)\n209\t                              :role (get-in r [:spec :on])\n210\t                              :pid (:pid r)\n211\t                              :cut (get-in r [:spec :cut])\n212\t                              :killed? (:killed? r)\n213\t                              :exit (:exit r)})\n214\t                           results)}]\n215\t    (io/make-parents record-file)\n216\t    (spit record-file (str (pr-str line) \"\\n\") :append true)\n217\t    line))\n218\t\n219\t\n220\t(defn run-pair!\n221\t  \"Run `scenario` over ordered host pair [src rcv]: each life on the host\n222\t   its :on names, the inspection and the check here.\"\n223\t  [scenario [src rcv :as pair]]\n224\t  (let [results (sc/run-scenario scenario\n225\t                                 (fn [spec]\n226\t                                   (run-life-in-process! (case (:on spec) :src src :rcv rcv)\n227\t                                                         spec))\n228\t                                 (str pair \" (separate processes)\"))]\n229\t    (testing (str (:id scenario) \" \" pair \" separate processes\")\n230\t      (is (apply distinct? (keep :pid results))\n231\t          \"every life ran in its own operating-system process\")\n232\t      (is (every? #(= (case (get-in % [:spec :on]) :src src :rcv rcv) (:host %)) results)\n233\t          \"every life ran on the host its role names\")\n234\t      (is (every? #(if (:killed? %) (not= 0 (:exit %)) (or (nil? (:exit %)) (zero? (:exit %)))) results)\n235\t          \"killed lives terminated with a fatal exit code\"))\n236\t    (record! scenario pair results)))\n237\t\n238\t\n239\t;; =============================================================================\n240\t;; The rows\n241\t;; =============================================================================\n242\t\n243\t\n244\t(defn- run-pairs!\n245\t  \"Run every scenario over every pair, the pairs concurrently (each\n246\t   scenario owns its root, and no port is used, so pairs never share a\n247\t   medium); the scenarios of one pair in order.\"\n248\t  [scenarios pairs]\n249\t  (let [runs (mapv (fn [pair]\n250\t                     (future\n251\t                       (doseq [s scenarios]\n252\t                         (run-pair! s pair))))\n253\t                   pairs)]\n254\t    (doseq [r runs] @r)))\n255\t\n256\t\n257\t(deftest ^:slow fork-per-host-across-processes-test\n258\t  (run-pairs