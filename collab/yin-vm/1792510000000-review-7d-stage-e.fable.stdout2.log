============================================\n737\t;; Row 6: partition -- the holder's requests, the protected consumer's\n738\t;; authority, and a lost reply -- with time advanced only by ticks\n739\t;; =============================================================================\n740\t\n741\t\n742\t(def row6-request-partition\n743\t  {:id [:row-6 :request-partition]\n744\t   :lives\n745\t   [(fn [_]\n746\t      {:on :src :kind :parked :inbound {\"h1\" :held}\n747\t       :ops [[:source \"h1\"]\n748\t             [:until \"h1\" :running 60]\n749\t             [:binding \"h1\"]\n750\t             ;; the partition: the holder's requests stop reaching the front\n751\t             [:hold true]\n752\t             [:clock 25]\n753\t             [:ticks 4 :control]\n754\t             [:snapshot :renewal-held]\n755\t             ;; time passes the grant's duration only by appended ticks\n756\t             [:clock 45]\n757\t             [:ticks 4 :control]\n758\t             [:snapshot :lapsed]\n759\t             ;; healed: every held request reaches the front at once\n760\t             [:hold false]\n761\t             [:ticks 12]\n762\t             [:snapshot :healed]\n763\t             [:die :after-heal]]})\n764\t    (fn [_]\n765\t      {:on :rcv :kind :parked :clock 50\n766\t       :ops [[:at-open] [:source \"h1\"] [:until \"h1\" :running 90] [:binding \"h1\"]]})]\n767\t   :check\n768\t   (fn [results inspection]\n769\t     (let [[l1 l2] results\n770\t           b1 (binding-of l1 \"h1\")\n771\t           held (snapshot-of l1 :renewal-held)\n772\t           lapsed (snapshot-of l1 :lapsed)\n773\t           healed (snapshot-of l1 :healed)\n774\t           renewals (records (get-in held [:journals \"h1\"]) :yin.k/intent :yin.k/renewal)\n775\t           p (:projection inspection)]\n776\t       (is (seq renewals) \"the renewal was due and journaled\")\n777\t       (is (some #(= :dao.stream/ok (:yin.k/append %))\n778\t                 (records (get-in held [:journals \"h1\"]) :yin.k/attempt :yin.k/renewal))\n779\t           \"and sent into the partition (the carrier took it; the front cannot read it)\")\n780\t       (is (nil? (get-in held [:projection :leases (:lease b1) :dao.lease/cause]))\n781\t           \"inside its duration the tenure stands: nothing is inferred from silence\")\n782\t       (is (some? (get-in lapsed [:projection :leases (:lease b1) :dao.lease/cause]))\n783\t           \"past the duration, at an appended tick, the judge lapsed it\")\n784\t       (is (not= :running (get-in lapsed [:holders \"h1\" :phase]))\n785\t           \"the partitioned holder stopped running\")\n786\t       (is (= {:yin.k/status :yin.k/ended :cause :lease-bound}\n787\t              {:yin.k/status (get-in lapsed [:holders \"h1\" :status])\n788\t               :cause (get-in lapsed [:holders \"h1\" :detail :cause])})\n789\t           \"it ended on its own lease bound: no inference from an absent lapse\")\n790\t       (let [renewals (filterv #(= :yin.k/renewal (:yin.k/request %)) (get-in healed [:inbound \"h1\"]))]\n791\t         (is (seq renewals) \"healed, the held renewals reached the front\")\n792\t         (is (apply = (map :yin.k/request-id renewals)) \"every retry is the identical request\"))\n793\t       (is (true? (get-in healed [:holders \"h1\" :detail :dao.lease/released]))\n794\t           \"the ended run's release was carried once the partition healed\")\n795\t       (is (<= (count (live-leases (:projection healed))) 1) \"never two live tenures\")\n796\t       (is (:killed? l1))\n797\t       (let [b2 (binding-of l2 \"h1\")]\n798\t         (is (= :running (:phase (holder l2 \"h1\"))))\n799\t         (is (not= (:lease b1) (:lease b2)) \"the regrant is a fresh tenure\")\n800\t         (is (= 1 (count (live-leases p))))\n801\t         (is (every? (fn [[_ n]] (= 1 n)) (frequencies (keys (:answered p))))\n802\t             \"each proposal id is answered exactly once\"))))})\n803\t\n804\t\n805\t(def row6-consumer-partition\n806\t  {:id [:row-6 :consumer-partition]\n807\t   :lives\n808\t   [(fn [_]\n809\t      {:on :src :kind :rows\n810\t       :ops [[:source \"h1\"]\n811\t             [:until \"h1\" :running 60]\n812\t             [:binding \"h1\"]\n813\t             [:until-inbound \"h1\" :yin.k/admit 40]\n814\t             [:snapshot :before-partition]\n815\t             [:partition-authority true]\n816\t             [:until-reply \"h1\" :yin.k/admit 40 :control]\n817\t             [:snapshot :suspended]\n818\t             [:die :partitioned]]})\n819\t    (fn [results]\n820\t      (rows-recovery results [[:at-open] [:source \"h1\"] [:until \"h1\" :safepoint 90]]))]\n821\t   :check\n822\t   (fn [results inspection]\n823\t     (let [[l1 l2] results\n824\t           b (binding-of l1 \"h1\")\n825\t           snap (snapshot-of l1 :suspended)\n826\t           first-reply (:yin.k/answer (first (admit-replies (get-in snap [:replies \"h1\"]))))]\n827\t       (is (= {:yin.k/admission :suspended\n828\t               :yin.k/op-id (id0 (:occurrence b))\n829\t               :yin.k/incarnation (:lease b)\n830\t               :yin.k/arbitration {:dao.stream/identity\n831\t                                   (get-in (snapshot-of l1 :before-partition)\n832\t                                           [:arbitration :dao.stream/identity])}}\n833\t              first-reply)\n834\t           \"the exact 7.9 suspended map: no result, no epoch claim\")\n835\t       (is (= :suspended (:yin.k/admission first-reply))\n836\t           \"protected admission suspends without its authority\")\n837\t       (is (not (contains? first-reply :yin.k/effect-result)) \"a suspension commits nothing\")\n838\t       (is (= [] (get-in snap [:targets :values])) \"nothing reached the target while partitioned\")\n839\t       (is (:killed? l1))\n840\t       (is (= :policy (get-in (snapshot-of l2 :at-open)\n841\t                              [:projection :leases (:lease b) :dao.lease/cause]))\n842\t           \"the recoverable restart reclaimed the tenure before new admission\")\n843\t       (is (= [\"A\"] (target-values inspection results)) \"the regrant committed once\")\n844\t       (is (= 1 (count (:outcomes inspection))))))})\n845\t\n846\t\n847\t(def row6-lost-reply\n848\t  {:id [:row-6 :lost-reply]\n849\t   :lives\n850\t   [(fn [_]\n851\t      {:on :src :kind :parked :cut :row6/proposal-reply-lost\n852\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n853\t    (fn [_]\n854\t      {:on :rcv :kind :parked\n855\t       :ops [[:at-open] [:source \"h1\"] [:until \"h1\" :running 90] [:binding \"h1\"]]})]\n856\t   :check\n857\t   (fn [results inspection]\n858\t     (let [[l1 l2] results\n859\t           journal (get-in inspection [:journals \"h1\"])\n860\t           intents (records journal :yin.k/intent :yin.k/proposal)\n861\t           p (:projection inspection)]\n862\t       (is (:killed? l1) \"the process died before the front appended the proposal's reply\")\n863\t       (is (= :running (:phase (holder l2 \"h1\"))))\n864\t       (is (every? (fn [[_ n]] (= 1 n)) (frequencies (keys (:answered p))))\n865\t           \"the judge answered each proposal id exactly once\")\n866\t       (is (= 1 (count (live-leases p))) \"one live tenure\")\n867\t       (is (= (count (distinct (map #(get-in % [:yin.k/request :yin.k/request-id]) intents)))\n868\t              (count (distinct (map #(get-in % [:yin.k/request :dao.lease/proposal]) intents))))\n869\t           \"every resend of a proposal is its identical request\")))})\n870\t\n871\t\n872\t;; =============================================================================\n873\t;; Clause 8: the admission order through the composition after a real kill\n874\t;; =============================================================================\n875\t\n876\t\n877\t(defn- admit-op\n878\t  [h rid lease epoch seq value & {:keys [occurrence target await?]}]\n879\t  [:admit h (cond-> {:rid rid :lease lease :epoch epoch\n880\t                     :op-id {:yin.k/occurrence (or occurrence [:binding \"h1\" :occurrence])\n881\t                             :yin.k/seq seq}\n882\t                     :value value}\n883\t              target (assoc :target target)\n884\t              (some? await?) (assoc :await? await?))])\n885\t\n886\t\n887\t(def clause8-variants [:order :cross-target])\n888\t\n889\t\n890\t(defn clause8\n891\t  [variant]\n892\t  {:id [:clause-8 variant]\n893\t   :holders [\"h1\" \"h7\"]\n894\t   :lives\n895\t   [(fn [_]\n896\t      {:on :src :kind :rows :cut :clause8/committed\n897\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"] [:until \"h1\" :safepoint 60]]})\n898\t    (fn [results]\n899\t      (let [old (binding-of (first results) \"h1\")\n900\t            L [:binding \"h1\" :lease]\n901\t            E [:binding \"h1\" :epoch]]\n902\t        (rows-recovery\n903\t          results\n904\t          (into [[:at-open]\n905\t                 [:source \"h1\"]\n906\t                 [:until \"h1\" :safepoint 90]\n907\t                 [:binding \"h1\"]\n908\t                 [:candidate \"h7\" {:kind :fence :of \"h1\"}]]\n909\t                (case variant\n910\t                  :order\n911\t                  [(admit-op \"h7\" [:e8 :wrong-author] L E 0 \"A\" :await? false)\n912\t                   (admit-op \"h1\" [:e8 :stale-epoch] L 0 0 \"A\")\n913\t                   (admit-op \"h1\" [:e8 :stale-lease] (:lease old) (:epoch old) 0 \"A\")\n914\t                   (admit-op \"h1\" [:e8 :foreign] L E 0 \"A\" :occurrence \"00000000-0000-4000-8000-000000000000\"\n915\t                             :await? false)\n916\t                   (admit-op \"h1\" [:e8 :equal] L E 0 \"A\")\n917\t                   (admit-op \"h1\" [:e8 :fresh] L E 1 \"B\")\n918\t                   (admit-op \"h1\" [:e8 :different] L E 0 \"Z\")\n919\t                   (admit-op \"h1\" [:e8 :after-quarantine] L E 2 \"C\")\n920\t                   [:partition-authority true]\n921\t                   (admit-op \"h1\" [:e8 :unreadable-authority] L E 3 \"D\")\n922\t                   [:snapshot :order]]\n923\t                  :cross-target\n924\t                  [[:enroll-other]\n925\t                   (admit-op \"h1\" [:e8 :cross-target] L E 0 \"A\" :target :other)\n926\t                   [:snapshot :order]])))))]\n927\t   :check\n928\t   (fn [results inspection]\n929\t     (let [[l1 l2] results\n930\t           old (binding-of l1 \"h1\")\n931\t           now (binding-of l2 \"h1\")\n932\t           o (:occurrence now)\n933\t           snap (snapshot-of l2 :order)\n934\t           replies (get-in snap [:replies \"h1\"])\n935\t           r (fn [k] (reply-to replies [:e8 k]))\n936\t           diag (fn [defect] (filterv #(= defect (:yin.k/defect %)) (:diagnostics snap)))\n937\t           outcome (fn [admission id & kvs]\n938\t                     (merge {:yin.k/admission admission :yin.k/op-id id\n939\t                             :yin.k/incarnation (:lease now)}\n940\t                            (apply hash-map kvs)))]\n941\t       (is (:killed? l1) \"the first tenure was killed after its commit\")\n942\t       (is (= 1 (:epoch now)) \"the regrant runs at the raised epoch\")\n943\t       (case variant\n944\t         :order\n945\t         (do\n946\t           (is (empty? (get-in snap [:replies \"h7\"])) \"a wrong author is never replied\")\n947\t           (is (= 1 (count (diag :wrong-author))) \"it is diagnosed, committing nothing\")\n948\t           (is (= (outcome :stale (id0 o) :yin.k/observed-epoch 1 :yin.k/observed-lease (:lease now))\n949\t                  (r :stale-epoch))\n950\t               \"stale epoch\")\n951\t           (is (= {:yin.k/admission :stale :yin.k/op-id (id0 o) :yin.k/incarnation (:lease old)\n952\t                   :yin.k/observed-epoch 1 :yin.k/observed-lease (:lease now)}\n953\t                  (r :stale-lease))\n954\t               \"stale lease\")\n955\t           (is (nil? (r :foreign)) \"a foreign id is never replied\")\n956\t           (is (= 1 (count (diag :foreign-op-id))))\n957\t           (is (= :replayed (:yin.k/admission (r :equal))) \"equal intent replays\")\n958\t           (is (= (:yin.k/effect-result (first (:outcomes inspection)))\n959\t                  (:yin.k/effect-result (r :equal)))\n960\t               \"with the stored result\")\n961\t           (is (= (outcome :committed {:yin.k/occurrence o :yin.k/seq 1}\n962\t                           :yin.k/effect-result {:dao.stream/outcome :dao.stream/ok})\n963\t                  (r :fresh))\n964\t               \"a fresh id commits: the exact map\")\n965\t           (is (= :intent-conflict (:yin.k/admission (r :different))) (pr-str (r :different)))\n966\t           (is (= (id0 o) (:yin.k/op-id (r :different))))\n967\t           (is (not (contains? (r :different) :yin.k/effect-result)))\n968\t           (is (true? (get-in snap [:projection :occurrences o :yin.k/quarantined]))\n969\t               \"the conflict quarantined the occurrence\")\n970\t           (is (= :suspended (:yin.k/admission (r :after-quarantine))) \"the quarantine suspends\")\n971\t           (is (= :suspended (:yin.k/admission (r :unreadable-authority)))\n972\t               \"an unreadable authority suspends\")\n973\t           (is (= [\"A\" \"B\"] (target-values inspection results))\n974\t               \"only the first commit and the fresh id ever reached the target\"))\n975\t         :cross-target\n976\t         (let [answer (r :cross-target)\n977\t               other (:other (:report l2))]\n978\t           (is (= :intent-conflict (:yin.k/admission answer)) (pr-str answer))\n979\t           (is (= (id0 o) (:yin.k/op-id answer)))\n980\t           (is (true? (get-in snap [:projection :occurrences o :yin.k/quarantined]))\n981\t               \"the shared id namespace conflicts across targets and quarantines\")\n982\t           (is (= [\"A\"] (target-values inspection results)))\n983\t           (is (= [] (get-in inspection [:targets other] [])) \"the other target received nothing\")))))})\n984\t\n985\t\n986\t(def clause8-closed\n987\t  \"A closed occurrence's stale answer and a closed ancestor's id at its\n988\t   successor, after a real kill of the exit.\"\n989\t  {:id [:clause-8 :closed]\n990\t   :holders [\"h1\" \"h2\"]\n991\t   :lives\n992\t   [(fn [_]\n993\t      {:on :src :kind :parked :cut :row7/after-closure\n994\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n995\t             [:hand-off \"h1\"] [:until \"h1\" :exited 80]]})\n996\t    (fn [results]\n997\t      (let [old (binding-of (first results) \"h1\")]\n998\t        {:on :rcv :kind :parked\n999\t         :ops [[:source \"h1\"]\n1000\t               [:until \"h1\" :exited 60]\n1001\t               [:candidate \"h2\" {:kind :successor :of \"h1\"}]\n1002\t               [:until \"h2\" :running 60]\n1003\t               [:binding \"h2\"]\n1004\t               [:enroll-other]\n1005\t               (admit-op \"h1\" [:e8 :closed] (:lease old) (:epoch old) 0 \"A\"\n1006\t                         :occurrence (:occurrence old) :target :other)\n1007\t               (admit-op \"h2\" [:e8 :ancestor] [:binding \"h2\" :lease] [:binding \"h2\" :epoch] 0 \"A\"\n1008\t                         :occurrence (:occurrence old) :target :other :await? false)\n1009\t               [:snapshot :closed]]}))]\n1010\t   :check\n1011\t   (fn [results _inspection]\n1012\t     (let [[l1 l2] results\n1013\t           old (binding-of l1 \"h1\")\n1014\t           snap (snapshot-of l2 :closed)\n1015\t           closed (reply-to (get-in snap [:replies \"h1\"]) [:e8 :closed])]\n1016\t       (is (:killed? l1))\n1017\t       (is (= :stale (:yin.k/admission closed)) (pr-str closed))\n1018\t       (is (true? (:yin.k/closed closed)) \"the stale answer names the closure\")\n1019\t       (is (nil? (reply-to (get-in snap [:replies \"h2\"]) [:e8 :ancestor]))\n1020\t           \"an inherited id from a closed ancestor is never replied\")\n1021\t       (is (some #(and (= :foreign-op-id (:yin.k/defect %))\n1022\t                       (= \"h2\" (:yin.k/author %))\n1023\t                       (= (id0 (:occurrence old)) (get-in % [:yin.k/claimed :yin.k/op-id])))\n1024\t                 (:diagnostics snap))\n1025\t           \"it is diagnosed foreign at the successor\")))})\n1026\t\n1027\t\n1028\t;; =============================================================================\n1029\t;; The inbox retention machine and the journal brackets (D15a, D14)\n1030\t;; =============================================================================\n1031\t\n1032\t\n1033\t(def journal-cuts\n1034\t  [:inbox/before-retention :inbox/after-retention\n1035\t   :journal/after-proposal-intent :journal/before-proposal-attempt\n1036\t   :journal/after-grant-ack :journal/after-resumed-intent :journal/after-release-intent])\n1037\t\n1038\t\n1039\t(def uncertain-retentions\n1040\t  [{:like :inbox/before-retention :persist? false}\n1041\t   {:like :inbox/before-retention :persist? true}])\n1042\t\n1043\t\n1044\t(defn- inbox-key\n1045\t  [r]\n1046\t  [(:yin.k/lane r) (:yin.k/identity r) (:yin.k/position r)])\n1047\t\n1048\t\n1049\t(defn journal-row\n1050\t  \"A kill at one journal boundary (`cut`), or an uncertain append that\n1051\t   stalls the live driver before the kill (`fail`).\"\n1052\t  [{:keys [cut fail]}]\n1053\t  (let [exit-cut? (= :journal/after-release-intent cut)\n1054\t        report-cut? (= :journal/after-resumed-intent cut)]\n1055\t    {:id [:journal (or cut fail)]\n1056\t     :lives\n1057\t     [(fn [_]\n1058\t        (if fail\n1059\t          {:on :src :kind :parked :fail fail\n1060\t           :ops [[:source \"h1\"] [:until \"h1\" :running 40] [:snapshot :stalled] [:die :stalled]]}\n1061\t          {:on :src :kind :parked :cut cut\n1062\t           :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n1063\t                 [:hand-off \"h1\"] [:until \"h1\" :exited 80]]}))\n1064\t      (fn [_]\n1065\t        {:on :rcv :kind :parked\n1066\t         :ops (if exit-cut?\n1067\t                [[:at-open] [:source \"h1\"] [:until \"h1\" :exited 90]]\n1068\t                [[:at-open] [:source \"h1\"] [:until \"h1\" :running 90] [:binding \"h1\"]])})]\n1069\t     :check\n1070\t     (fn [results inspection]\n1071\t       (let [[l1 l2] results\n1072\t             journal (get-in inspection [:journals \"h1\"])\n1073\t             inbox (records journal :yin.k/inbox nil)\n1074\t             at (:at (cut-event l1))\n1075\t             p (:projection inspection)]\n1076\t         (is (:killed? l1))\n1077\t         (is (every? (fn [[_ n]] (= 1 n)) (frequencies (map inbox-key inbox)))\n1078\t             \"every source position is retained once: one queue entry, never two\")\n1079\t         (is (<= (count (records journal :yin.k/minted nil)) 2) \"no occurrence re-minted\")\n1080\t         (cond\n1081\t           fail\n1082\t           (let [stalled (get-in (snapshot-of l1 :stalled) [:holders \"h1\"])\n1083\t                 uncertain (some #(when (= :uncertain (:event %)) %) (:events l1))]\n1084\t             (is (some? uncertain) \"the retention append was answered uncertain\")\n1085\t             (is (= :stalled (:phase stalled)) (str \"an uncertain append stalls: \" (pr-str stalled)))\n1086\t             (is (false? (:machine? stalled)) \"nothing dispatched past it\")\n1087\t             (is (= 1 (count (filter #(= (inbox-key (:record uncertain)) (inbox-key %)) inbox)))\n1088\t                 \"reopen reconciled the position: retained once whether it landed or not\")\n1089\t             (is (= :running (:phase (holder l2 \"h1\"))) \"and the recovered holder ran\"))\n1090\t\n1091\t           (= :inbox/before-retention cut)\n1092\t           (let [lost (:record at)\n1093\t                 again (some #(when (= (inbox-key lost) (inbox-key %)) %) inbox)]\n1094\t             (is (some? again) \"the fresh driver re-read the source position\")\n1095\t             (is (= lost again)\n1096\t                 \"the same attributed record at the same position: lane, identity, author, record\"))\n1097\t\n1098\t           (= :inbox/after-retention cut)\n1099\t           (is (= 1 (count (filter #(= (inbox-key (:record at)) (inbox-key %)) inbox)))\n1100\t               \"retained before the kill, the record is one queue entry after it\")\n1101\t\n1102\t           (= :journal/after-grant-ack cut)\n1103\t           (let [b1 (binding-of l1 \"h1\")\n1104\t                 b2 (binding-of l2 \"h1\")]\n1105\t             (is (not= (:lease b1) (:lease b2))\n1106\t                 \"a restarted holder with a journaled grant never resumes it: a fresh tenure\")\n1107\t             (is (= :policy (get-in p [:leases (or (:lease b1)\n1108\t                                                   (get-in at [:record :dao.lease/lease]))\n1109\t                                       :dao.lease/cause]))\n1110\t                 \"the journaled grant was reclaimed\"))\n1111\t\n1112\t           report-cut?\n1113\t           (let [o (:occurrence (binding-of l1 \"h1\"))]\n1114\t             (is (empty? (records (get-in (snapshot-of l2 :at-open) [:journals \"h1\"])\n1115\t                                  :yin.k/attempt :yin.k/resumed))\n1116\t                 \"the report's intent stood, its attempt never happened\")\n1117\t             (is (= :running (:phase (holder l2 \"h1\")))\n1118\t                 \"no report was accepted: the last recorded checkpoint is regranted\")\n1119\t             (is (= o (:occurrence (holder l2 \"h1\"))))\n1120\t             (is (nil? (get-in p [:occurrences o :yin.k/closed])) \"nothing closed\"))\n1121\t\n1122\t           exit-cut?\n1123\t           (let [intents (records journal :yin.k/intent :yin.k/release)]\n1124\t             (is (= :exited (:phase (holder l2 \"h1\"))) \"the recovered exit completes\")\n1125\t             (is (= 1 (count (distinct (map #(get-in % [:yin.k/request :yin.k/request-id]) intents))))\n1126\t                 \"every resend after the intent is the identical request\"))\n1127\t\n1128\t           :else\n1129\t           (do (is (= :running (:phase (holder l2 \"h1\"))))\n1130\t               (is (every? (fn [[_ n]] (= 1 n)) (frequencies (keys (:answered p))))\n1131\t                   \"each proposal id answered once\")\n1132\t               (is (= 1 (count (live-leases p))) \"one live tenure\")))))}))\n1133\t\n1134\t\n1135\t;; =============================================================================\n1136\t;; Clause 3: the sequence counter across a kill between assign and\n1137\t;; discharge, and an id carried by the checkpoint\n1138\t;; =============================================================================\n1139\t\n1140\t\n1141\t(def clause3-regrant\n1142\t  {:id [:clause-3 :regrant]\n1143\t   :lives\n1144\t   [(fn [_]\n1145\t      {:on :src :kind :rows :cut :seq/after-assign\n1146\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"] [:until \"h1\" :safepoint 60]]})\n1147\t    (fn [results]\n1148\t      (rows-recovery results [[:source \"h1\"]\n1149\t                              [:until-inbound \"h1\" :yin.k/admit 90]\n1150\t                              [:snapshot :reassigned]\n1151\t                              [:until \"h1\" :safepoint 60]]))]\n1152\t   :check\n1153\t   (fn [results inspection]\n1154\t     (let [[l1 l2] results\n1155\t           at (:at (cut-event l1))\n1156\t           o (:occurrence (binding-of l1 \"h1\"))\n1157\t           first-admit (first (filter #(= :yin.k/admit (:yin.k/request %)) (get-in at [:inbound \"h1\"])))\n1158\t           re (snapshot-of l2 :reassigned)\n1159\t           second-admit (first (filter #(= :yin.k/admit (:yin.k/request %)) (get-in re [:inbound \"h1\"])))]\n1160\t       (is (:killed? l1) \"killed between the id's assignment and its discharge\")\n1161\t       (is (= 1 (get-in at [:holders \"h1\" :next-op-seq])) \"assign-before-append: one increment\")\n1162\t       (is (= (id0 o) (get-in first-admit [:yin.k/fenced-envelope :yin.k/op-id])))\n1163\t       (is (= 1 (get-in re [:holders \"h1\" :next-op-seq]))\n1164\t           \"the regrant restored the counter exactly: the same one assignment\")\n1165\t       (is (= (get-in first-admit [:yin.k/fenced-envelope :yin.k/op-id])\n1166\t              (get-in second-admit [:yin.k/fenced-envelope :yin.k/op-id]))\n1167\t           \"the same id\")\n1168\t       (is (= \"A\" (get-in second-admit [:yin.k/fenced-envelope :yin.k/value])) \"the same intent\")\n1169\t       (is (= [\"A\"] (target-values inspection results)) \"committed once\")))})\n1170\t\n1171\t\n1172\t(def clause3-carried\n1173\t  \"An id assigned before the export rides the successor's bytes across a\n1174\t   kill of the exit and is retried, fenced, by the successor's holder.\"\n1175\t  {:id [:clause-3 :carried-put]\n1176\t   :holders [\"h1\" \"h2\"]\n1177\t   :lives\n1178\t   [(fn [_]\n1179\t      {:on :src :kind :rows :cut :row7/after-closure\n1180\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n1181\t             [:until-inbound \"h1\" :yin.k/admit 40]\n1182\t             [:hand-off \"h1\"] [:until \"h1\" :exited 80]]})\n1183\t    (fn [results]\n1184\t      (rows-recovery results [[:source \"h1\"]\n1185\t                              [:until \"h1\" :exited 60]\n1186\t                              [:candidate \"h2\" {:kind :successor :of \"h1\"}]\n1187\t                              [:until \"h2\" :running 60]\n1188\t                              [:binding \"h2\"]\n1189\t                              [:snapshot :successor-running]\n1190\t                              [:until \"h2\" :safepoint 60]]))]\n1191\t   :check\n1192\t   (fn [results inspection]\n1193\t     (let [[l1 l2] results\n1194\t           o (:occurrence (binding-of l1 \"h1\"))\n1195\t           run (snapshot-of l2 :successor-running)\n1196\t           admits (filter #(= :yin.k/admit (:yin.k/request %)) (get-in (final l2) [:inbound \"h2\"]))]\n1197\t       (is (:killed? l1))\n1198\t       (is (= 1 (get-in run [:holders \"h2\" :next-op-seq]))\n1199\t           \"the successor's counter is the carried one\")\n1200\t       (is (every? #(= (id0 o) (get-in % [:yin.k/fenced-envelope :yin.k/op-id])) admits)\n1201\t           \"the successor retries the origin's carried id unchanged\")\n1202\t       (is (every? #{:committed :replayed} (admissions (get-in inspection [:replies \"h2\"]))))\n1203\t       (is (= [\"A\"] (target-values inspection results)) \"the carried write commits once across the chain\")))})\n1204\t\n1205\t\n1206\t;; =============================================================================\n1207\t;; Fork, per host\n1208\t;; =============================================================================\n1209\t\n1210\t\n1211\t(def fork-row\n1212\t  {:id [:fork]\n1213\t   :lives [(fn [_] {:on :src :fork-row true})]\n1214\t   :check\n1215\t   (fn [results _inspection]\n1216\t     (let [r (:report (first results))]\n1217\t       (is (= :yin.k/unsatisfied (get-in r [:refused :yin.k/status])))\n1218\t       (is (= :exclusive-uncapable (get-in r [:refused :yin.k/reason]))\n1219\t           \"exclusive over a memory authority is refused\")\n1220\t       (is (= :yin.k/exclusive (get-in r [:refused :yin.k/policy])) \"never downgraded to fork\")\n1221\t       (is (false? (:refused-composed? r)) \"nothing was composed\")\n1222\t       (is (true? (get-in r [:fork :held?])))\n1223\t       (is (= :yin.k/fork (get-in r [:fork :policy])) \"fork runs when selected, labelled fork\")\n1224\t       (is (= :yin.k/fork (get-in r [:fork :status-policy])))\n1225\t       (is (nil? (get-in r [:fork :arbitration])))\n1226\t       (is (= :lifted (get-in r [:fork :holder :phase])))\n1227\t       (is (some? (get-in r [:fork :address])))\n1228\t       (is (= [] (get-in r [:fork :journal])) \"no custody bracket\")\n1229\t       (is (= [] (get-in r [:fork :offers])) \"nothing offered\")\n1230\t       (is (= 0 (get-in r [:fork :fronts])))\n1231\t       (is (false? (get-in r [:fork :outcome-reader?])))))})\n1232\t\n1233\t\n1234\t;; =============================================================================\n1235\t;; Row 7, continued: a failure-lower successor and a lost authority\n1236\t;; =============================================================================\n1237\t\n1238\t\n1239\t(def row7-failure-lower\n1240\t  \"The successor's first candidate cannot attach its stream: its lower\n1241\t   fails after the grant, it releases, and the successor is offered to\n1242\t   the next candidate instead of completing.\"\n1243\t  {:id [:row-7 :failure-lower]\n1244\t   :holders [\"h1\" \"h2\" \"h3\"]\n1245\t   :lives\n1246\t   [(fn [_]\n1247\t      {:on :src :kind :parked :cut :row7/after-closure\n1248\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n1249\t             [:hand-off \"h1\"] [:until \"h1\" :exited 80]]})\n1250\t    (fn [_]\n1251\t      {:on :rcv :kind :parked\n1252\t       :ops [[:source \"h1\"]\n1253\t             [:until \"h1\" :exited 60]\n1254\t             [:candidate \"h2\" {:kind :successor :of \"h1\"} {:attach :none}]\n1255\t             [:until \"h2\" :failed 60]\n1256\t             [:ticks 4]\n1257\t             [:snapshot :failed-lower]\n1258\t             [:candidate \"h3\" {:kind :successor :of \"h1\"}]\n1259\t             [:until \"h3\" :running 60]\n1260\t             [:binding \"h3\"]]})]\n1261\t   :check\n1262\t   (fn [results inspection]\n1263\t     (let [[l1 l2] results\n1264\t           o (:occurrence (binding-of l1 \"h1\"))\n1265\t           failed (snapshot-of l2 :failed-lower)\n1266\t           h2 (get-in failed [:holders \"h2\"])\n1267\t           s (:occurrence h2)\n1268\t           b3 (binding-of l2 \"h3\")]\n1269\t       (is (:killed? l1))\n1270\t       (is (= :failed (:phase h2)) (pr-str h2))\n1271\t       (is (= :yin.k/unsatisfied (:status h2)))\n1272\t       (is (= {:dao.stream/identity world/prog-id :dao.lease/released true} (:detail h2))\n1273\t           \"the failed lower names the stream, after its release\")\n1274\t       (is (false? (:machine? h2)) \"no machine was exposed\")\n1275\t       (is (nil? (get-in failed [:projection :occurrences s :yin.k/closed]))\n1276\t           \"a failure-lower release never completes the successor\")\n1277\t       (is (nil? (get-in failed [:projection :occurrences s :dao.lease/lease])))\n1278\t       (is (some? (get-in inspection [:projection :occurrences o :yin.k/closed]))\n1279\t           \"the origin's closure stands\")\n1280\t       (is (= s (:occurrence b3)) \"the successor is reoffered to the next candidate\")\n1281\t       (is (= 1 (:epoch b3)) \"at the epoch the release advanced\")))})\n1282\t\n1283\t\n1284\t(def row7-lost-authority\n1285\t  \"The authority's state is permanently lost between lives: the next\n1286\t   open refuses, nothing is composed and nothing runs -- fail stop,\n1287\t   never a downgrade to fork.\"\n1288\t  {:id [:row-7 :lost-authority]\n1289\t   :lives\n1290\t   [(fn [_]\n1291\t      {:on :src :kind :parked :cut :row7/while-running\n1292\t       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n1293\t    (fn [_]\n1294\t      {:on :rcv :kind :parked :lose-authority true\n1295\t       :ops [[:source \"h1\"] [:until \"h1\" :running 30]]})]\n1296\t   :check\n1297\t   (fn [results inspection]\n1298\t     (let [[l1 l2] results\n1299\t           refusal (get-in l2 [:report :refusal])]\n1300\t       (is (:killed? l1))\n1301\t       (is (or (and (= :yin.k/unsatisfied (:yin.k/status refusal))\n1302\t                    (= :authority-refused (:yin.k/reason refusal)))\n1303\t               (and (= :authority-backend (:stage refusal))\n1304\t                    (= :dao.stream/transport-error\n1305\t                       (get-in refusal [:answer :dao.stream/outcome]))))\n1306\t           (str \"the lost authority is refused as data, by the composition or by \"\n1307\t                \"its durable backend before it: \" (pr-str refusal)))\n1308\t       (is (nil? (get-in l2 [:report :final])) \"nothing was composed, so nothing ran\")\n1309\t       (is (not= :open (:status inspection)) \"the lost ledger opens for no one\")))})\n1310\t\n1311\t\n1312\t(def all-scenarios\n1313\t  \"Every scenario, in run order.\"\n1314\t  (concat [fork-row]\n1315\t          (map row7 row7-cuts)\n1316\t          [row7-failure-lower row7-lost-authority]\n1317\t          (map row4 row4-cuts)\n1318\t          (map row3 row3-variants)\n1319\t          (map row5 row5-variants)\n1320\t          (map row2 (concat row2-pre-fence-cuts row2-post-fence-cuts))\n1321\t          (map row2-carrier row2-carriers)\n1322\t          [row1 row6-request-partition row6-consumer-partition row6-lost-reply]\n1323\t          (map clause8 clause8-variants)\n1324\t          [clause8-closed clause3-regrant clause3-carried]\n1325\t          (map #(journal-row {:cut %}) journal-cuts)\n1326\t          (map #(journal-row {:fail %}) uncertain-retentions)))\n1327\t"}]},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"02b1baee-7d67-4fac-9ec4-3277a45ec90c","timestamp":"2026-10-13T18:37:57.837Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_scenarios.cljc","content":"(defn row2\n  [cut]\n  {:id [:row-2 cut]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut cut\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n    (fn [_]\n      {:on :rcv :kind :parked\n       :ops [[:at-open]\n             [:source \"h1\"]\n             [:snapshot :recovered]\n             [:abort \"h1\"]\n             [:snapshot :after-abort]\n             [:until \"h1\" :running 60]\n             [:ticks 4]]})]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           journal (get-in inspection [:journals \"h1\"])\n           minted (records journal :yin.k/minted nil)\n           o (:yin.k/occurrence (first minted))\n           aborted (get-in (snapshot-of l2 :after-abort) [:holders \"h1\"])\n           st (holder l2 \"h1\")\n           p (:projection inspection)]\n       (is (:killed? l1) \"the export driver was killed at the phase\")\n       (is (<= (count minted) 1) \"one occurrence: never re-minted across the kill\")\n       (if (some #{cut} row2-pre-fence-cuts)\n         (do (is (not= :running (:phase st))\n                 (str \"an incomplete preparation never runs: \" (pr-str st)))\n             (is (false? (:machine? st)))\n             (is (empty? (records journal :yin.k/fenced nil)) \"nothing fenced over incomplete objects\")\n             (is (empty? (records journal :yin.k/intent :yin.k/offer)) \"nothing offered\")\n             (is (or (nil? o) (nil? (get-in p [:occurrences o])))\n                 \"the authority never heard of the occurrence\")\n             (is (zero? (get-in (final l2) [:counts :attaches])) \"no program IO through the kill\"))\n         (let [fence (first (records journal :yin.k/fenced nil))\n               offers (filterv #(= :yin.k/offer (:yin.k/request %))\n                               (get-in (final l2) [:inbound \"h1\"]))]\n           (is (= :yin.k/refused (:status aborted)))\n           (is (= {:yin.k/reason :restarted} (:detail aborted))\n               \"a restarted export never aborts: its offer may have landed\")\n           (is (= :running (:phase st)) \"the fenced source resent its offer, was granted, and runs\")\n           (is (= 1 (count (get-in p [:occurrences o :yin.k/variants])))\n               \"duplicate offer evidence admits one variant of one O\")\n           (is (= 1 (count (filter #(= o (:yin.k/occurrence %)) (vals (:leases p)))))\n               \"duplicate evidence creates no second grant\")\n           (is (= 1 (get-in (snapshot-of l2 :recovered) [:counts :attaches]))\n               \"reopening the fenced source attached once, administratively (D14 rehydration)\")\n           (is (= 0 (get-in (snapshot-of l2 :recovered) [:counts :observes]))\n               \"and observed nothing: no program IO before its grant\")\n           (is (= 2 (get-in (final l2) [:counts :attaches])) \"then one activation, under its own grant\")\n           (when (seq offers)\n             (is (every? #(= (get-in (final l2) [:fences (:yin.k/address fence)]) (:yin.k/bytes %))\n                         offers)\n                 \"the rehydrated export resends the exact stored handoff bytes\"))))))})\n\n\n(def row2-carriers\n  [:dao.stream/full :dao.stream/refused :dao.stream/transport-error :dao.stream/ok])\n\n\n(defn row2-carrier\n  \"A carrier answering `outcome` to every offer append: abort is legal\n   only while no offer can have landed; then the export driver is killed\n   and reopened on the receiver host, where no restarted export aborts.\"\n  [outcome]\n  {:id [:row-2-carrier outcome]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :inbound {\"h1\" :answering}\n       :ops [[:carrier outcome]\n             [:source \"h1\"]\n             [:until-journal \"h1\" :yin.k/attempt :yin.k/offer 30 :step]\n             [:abort \"h1\"]\n             [:snapshot :after-abort]\n             [:die :after-abort]]})\n    (fn [_]\n      {:on :rcv :kind :parked\n       :ops (if (contains? #{:dao.stream/full :dao.stream/refused} outcome)\n              [[:source \"h1\"] [:ticks 10]]\n              [[:source \"h1\"]\n               [:abort \"h1\"]\n               [:snapshot :restarted-abort]\n               [:ticks 30]])})]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           legal? (contains? #{:dao.stream/full :dao.stream/refused} outcome)\n           st (get-in (snapshot-of l1 :after-abort) [:holders \"h1\"])\n           journal (get-in inspection [:journals \"h1\"])\n           o (:yin.k/occurrence (first (records journal :yin.k/minted nil)))\n           attempts (records journal :yin.k/attempt :yin.k/offer)\n           p (:projection inspection)]\n       (is (:killed? l1))\n       (is (some #(= outcome (:yin.k/append %)) attempts) \"the attempt journaled the carrier's answer\")\n       (if legal?\n         (do (is (= :aborted (:phase st)) (pr-str st))\n             (is (= {:yin.k/aborted o} (:detail st)))\n             (is (seq (records journal :yin.k/aborted nil)) \"the abort is durable\")\n             (is (= :aborted (:phase (holder l2 \"h1\"))) \"an aborted export stays aborted across the kill\")\n             (is (nil? (get-in p [:occurrences o])) \"the authority never heard of it\"))\n         (do (is (= :yin.k/refused (:status st)))\n             (is (= {:yin.k/reason :offer-possibly-accepted} (:detail st)))\n             (is (empty? (records journal :yin.k/aborted nil)))\n             (is (= {:yin.k/reason :restarted}\n                    (get-in (snapshot-of l2 :restarted-abort) [:holders \"h1\" :detail])))\n             (is (= :running (:phase (holder l2 \"h1\"))) \"the reopened export completes under its grant\")\n             (is (= 1 (count (get-in p [:occurrences o :yin.k/variants]))))\n             (is (= 1 (count (filter #(= o (:yin.k/occurrence %)) (vals (:leases p))))))))))})\n\n\n;; =============================================================================\n;; Row 1: one admitted holder over two encodings of O, two candidates\n;; =============================================================================\n\n\n(def row1\n  {:id [:row-1]\n   :holders [\"h1\" \"h2\" \"h3\"]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut :export/after-offer-ack\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n    (fn [_]\n      ;; the second encoding is minted on the receiver host\n      {:on :rcv :kind :parked\n       :ops [[:source \"h1\"]\n             [:offer-variant \"h1\"]\n             [:candidate \"h2\" {:kind :fence :of \"h1\"}]\n             [:candidate \"h3\" {:kind :variant}]\n             [:until-some :running 90]\n             [:ticks 10]\n             [:snapshot :race]]})\n    (fn [_]\n      {:on :src :kind :parked :prog [\"B\"]\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 90]\n             [:snapshot :source-granted]\n             [:until \"h1\" :safepoint 30]]})]\n   :check\n   (fn [results _inspection]\n     (let [[l1 l2 l3] results\n           race (snapshot-of l2 :race)\n           hs (:holders race)\n           running (filterv #(= :running (:phase (val %))) hs)\n           o (:occurrence (second (first running)))\n           p (:projection race)]\n       (is (:killed? l1) \"the source was killed after its offer, before its own grant\")\n       (is (= 1 (count running)) (str \"one admitted holder: \" (pr-str hs)))\n       (is (every? (fn [[_ st]]\n                     (or (= :running (:phase st))\n                         (and (nil? (:lease st))\n                              (contains? #{:yin.k/awaiting-grant :yin.k/not-holder}\n                                         (:status st)))))\n                   hs)\n           \"every competitor awaits or is refused\")\n       (let [variants (get-in p [:occurrences o :yin.k/variants])\n             variant (get-in l2 [:report :variant])\n             original (first (remove #{variant} variants))]\n         (is (not= original variant) \"reversed rows have another pack address\")\n         (is (= (get-in race [:packs original :baseline])\n                (get-in l2 [:report :variant-baseline]))\n             \"both encodings have the same root and custody baseline\"))\n       (is (= 2 (count (get-in p [:occurrences o :yin.k/variants])))\n           \"both encodings are variants of the one occurrence\")\n       (is (= 1 (count (filter #(= o (:yin.k/occurrence %)) (live-leases p)))))\n       (is (= 2 (get-in race [:counts :attaches]))\n           (str \"one administrative attach reopening the fenced source and one activation: \"\n                \"no competitor attached, the source emitted nothing of its own\"))\n       (is (= :running (get-in (snapshot-of l3 :source-granted) [:holders \"h1\" :phase]))\n           \"the source resumes only under its own grant\")\n       (is (= o (get-in (snapshot-of l3 :source-granted) [:holders \"h1\" :occurrence])))\n       (is (= :safepoint (:phase (holder l3 \"h1\"))) \"and runs its program under it\")))})\n\n\n;; =============================================================================\n;; Row 6: partition -- the holder's requests, the protected consumer's\n;; authority, and a lost reply -- with time advanced only by ticks\n;; =============================================================================\n\n\n(def row6-request-partition\n  {:id [:row-6 :request-partition]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :inbound {\"h1\" :held}\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 60]\n             [:binding \"h1\"]\n             ;; the partition: the holder's requests stop reaching the front\n             [:hold true]\n             [:clock 25]\n             [:ticks 4 :control]\n             [:snapshot :renewal-held]\n             ;; time passes the grant's duration only by appended ticks\n             [:clock 45]\n             [:ticks 4 :control]\n             [:snapshot :lapsed]\n             ;; healed: every held request reaches the front at once\n             [:hold false]\n             [:ticks 12]\n             [:snapshot :healed]\n             [:die :after-heal]]})\n    (fn [_]\n      {:on :rcv :kind :parked :clock 50\n       :ops [[:at-open] [:source \"h1\"] [:until \"h1\" :running 90] [:binding \"h1\"]]})]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           b1 (binding-of l1 \"h1\")\n           held (snapshot-of l1 :renewal-held)\n           lapsed (snapshot-of l1 :lapsed)\n           healed (snapshot-of l1 :healed)\n           renewals (records (get-in held [:journals \"h1\"]) :yin.k/intent :yin.k/renewal)\n           p (:projection inspection)]\n       (is (seq renewals) \"the renewal was due and journaled\")\n       (is (some #(= :dao.stream/ok (:yin.k/append %))\n                 (records (get-in held [:journals \"h1\"]) :yin.k/attempt :yin.k/renewal))\n           \"and sent into the partition (the carrier took it; the front cannot read it)\")\n       (is (nil? (get-in held [:projection :leases (:lease b1) :dao.lease/cause]))\n           \"inside its duration the tenure stands: nothing is inferred from silence\")\n       (is (some? (get-in lapsed [:projection :leases (:lease b1) :dao.lease/cause]))\n           \"past the duration, at an appended tick, the judge lapsed it\")\n       (is (not= :running (get-in lapsed [:holders \"h1\" :phase]))\n           \"the partitioned holder stopped running\")\n       (is (= {:yin.k/status :yin.k/ended :cause :lease-bound}\n              {:yin.k/status (get-in lapsed [:holders \"h1\" :status])\n               :cause (get-in lapsed [:holders \"h1\" :detail :cause])})\n           \"it ended on its own lease bound: no inference from an absent lapse\")\n       (let [renewals (filterv #(= :yin.k/renewal (:yin.k/request %)) (get-in healed [:inbound \"h1\"]))]\n         (is (seq renewals) \"healed, the held renewals reached the front\")\n         (is (apply = (map :yin.k/request-id renewals)) \"every retry is the identical request\"))\n       (is (true? (get-in healed [:holders \"h1\" :detail :dao.lease/released]))\n           \"the ended run's release was carried once the partition healed\")\n       (is (<= (count (live-leases (:projection healed))) 1) \"never two live tenures\")\n       (is (:killed? l1))\n       (let [b2 (binding-of l2 \"h1\")]\n         (is (= :running (:phase (holder l2 \"h1\"))))\n         (is (not= (:lease b1) (:lease b2)) \"the regrant is a fresh tenure\")\n         (is (= 1 (count (live-leases p))))\n         (is (every? (fn [[_ n]] (= 1 n)) (frequencies (keys (:answered p))))\n             \"each proposal id is answered exactly once\"))))})\n\n\n(def row6-consumer-partition\n  {:id [:row-6 :consumer-partition]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :running 60]\n             [:binding \"h1\"]\n             [:until-inbound \"h1\" :yin.k/admit 40]\n             [:snapshot :before-partition]\n             [:partition-authority true]\n             [:until-reply \"h1\" :yin.k/admit 40 :control]\n             [:snapshot :suspended]\n             [:die :partitioned]]})\n    (fn [results]\n      (rows-recovery results [[:at-open] [:source \"h1\"] [:until \"h1\" :safepoint 90]]))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           b (binding-of l1 \"h1\")\n           snap (snapshot-of l1 :suspended)\n           first-reply (:yin.k/answer (first (admit-replies (get-in snap [:replies \"h1\"]))))]\n       (is (= {:yin.k/admission :suspended\n               :yin.k/op-id (id0 (:occurrence b))\n               :yin.k/incarnation (:lease b)\n               :yin.k/arbitration {:dao.stream/identity\n                                   (get-in (snapshot-of l1 :before-partition)\n                                           [:arbitration :dao.stream/identity])}}\n              first-reply)\n           \"the exact 7.9 suspended map: no result, no epoch claim\")\n       (is (= :suspended (:yin.k/admission first-reply))\n           \"protected admission suspends without its authority\")\n       (is (not (contains? first-reply :yin.k/effect-result)) \"a suspension commits nothing\")\n       (is (= [] (get-in snap [:targets :values])) \"nothing reached the target while partitioned\")\n       (is (:killed? l1))\n       (is (= :policy (get-in (snapshot-of l2 :at-open)\n                              [:projection :leases (:lease b) :dao.lease/cause]))\n           \"the recoverable restart reclaimed the tenure before new admission\")\n       (is (= [\"A\"] (target-values inspection results)) \"the regrant committed once\")\n       (is (= 1 (count (:outcomes inspection))))))})\n\n\n(def row6-lost-reply\n  {:id [:row-6 :lost-reply]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut :row6/proposal-reply-lost\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n    (fn [_]\n      {:on :rcv :kind :parked\n       :ops [[:at-open] [:source \"h1\"] [:until \"h1\" :running 90] [:binding \"h1\"]]})]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           journal (get-in inspection [:journals \"h1\"])\n           intents (records journal :yin.k/intent :yin.k/proposal)\n           p (:projection inspection)]\n       (is (:killed? l1) \"the process died before the front appended the proposal's reply\")\n       (is (= :running (:phase (holder l2 \"h1\"))))\n       (is (every? (fn [[_ n]] (= 1 n)) (frequencies (keys (:answered p))))\n           \"the judge answered each proposal id exactly once\")\n       (is (= 1 (count (live-leases p))) \"one live tenure\")\n       (is (= (count (distinct (map #(get-in % [:yin.k/request :yin.k/request-id]) intents)))\n              (count (distinct (map #(get-in % [:yin.k/request :dao.lease/proposal]) intents))))\n           \"every resend of a proposal is its identical request\")))})\n\n\n;; =============================================================================\n;; Clause 8: the admission order through the composition after a real kill\n;; =============================================================================\n\n\n(defn- admit-op\n  [h rid lease epoch seq value & {:keys [occurrence target await?]}]\n  [:admit h (cond-> {:rid rid :lease lease :epoch epoch\n                     :op-id {:yin.k/occurrence (or occurrence [:binding \"h1\" :occurrence])\n                             :yin.k/seq seq}\n                     :value value}\n              target (assoc :target target)\n              (some? await?) (assoc :await? await?))])\n\n\n(def clause8-variants [:order :cross-target])\n\n\n(defn clause8\n  [variant]\n  {:id [:clause-8 variant]\n   :holders [\"h1\" \"h7\"]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows :cut :clause8/committed\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"] [:until \"h1\" :safepoint 60]]})\n    (fn [results]\n      (let [old (binding-of (first results) \"h1\")\n            L [:binding \"h1\" :lease]\n            E [:binding \"h1\" :epoch]]\n        (rows-recovery\n          results\n          (into [[:at-open]\n                 [:source \"h1\"]\n                 [:until \"h1\" :safepoint 90]\n                 [:binding \"h1\"]\n                 [:candidate \"h7\" {:kind :fence :of \"h1\"}]]\n                (case variant\n                  :order\n                  [(admit-op \"h7\" [:e8 :wrong-author] L E 0 \"A\" :await? false)\n                   (admit-op \"h1\" [:e8 :stale-epoch] L 0 0 \"A\")\n                   (admit-op \"h1\" [:e8 :stale-lease] (:lease old) (:epoch old) 0 \"A\")\n                   (admit-op \"h1\" [:e8 :foreign] L E 0 \"A\" :occurrence \"00000000-0000-4000-8000-000000000000\"\n                             :await? false)\n                   (admit-op \"h1\" [:e8 :equal] L E 0 \"A\")\n                   (admit-op \"h1\" [:e8 :fresh] L E 1 \"B\")\n                   (admit-op \"h1\" [:e8 :different] L E 0 \"Z\")\n                   (admit-op \"h1\" [:e8 :after-quarantine] L E 2 \"C\")\n                   [:partition-authority true]\n                   (admit-op \"h1\" [:e8 :unreadable-authority] L E 3 \"D\")\n                   [:snapshot :order]]\n                  :cross-target\n                  [[:enroll-other]\n                   (admit-op \"h1\" [:e8 :cross-target] L E 0 \"A\" :target :other)\n                   [:snapshot :order]])))))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           old (binding-of l1 \"h1\")\n           now (binding-of l2 \"h1\")\n           o (:occurrence now)\n           snap (snapshot-of l2 :order)\n           replies (get-in snap [:replies \"h1\"])\n           r (fn [k] (reply-to replies [:e8 k]))\n           diag (fn [defect] (filterv #(= defect (:yin.k/defect %)) (:diagnostics snap)))\n           outcome (fn [admission id & kvs]\n                     (merge {:yin.k/admission admission :yin.k/op-id id\n                             :yin.k/incarnation (:lease now)}\n                            (apply hash-map kvs)))]\n       (is (:killed? l1) \"the first tenure was killed after its commit\")\n       (is (= 1 (:epoch now)) \"the regrant runs at the raised epoch\")\n       (case variant\n         :order\n         (do\n           (is (empty? (get-in snap [:replies \"h7\"])) \"a wrong author is never replied\")\n           (is (= 1 (count (diag :wrong-author))) \"it is diagnosed, committing nothing\")\n           (is (= (outcome :stale (id0 o) :yin.k/observed-epoch 1 :yin.k/observed-lease (:lease now))\n                  (r :stale-epoch))\n               \"stale epoch\")\n           (is (= {:yin.k/admission :stale :yin.k/op-id (id0 o) :yin.k/incarnation (:lease old)\n                   :yin.k/observed-epoch 1 :yin.k/observed-lease (:lease now)}\n                  (r :stale-lease))\n               \"stale lease\")\n           (is (nil? (r :foreign)) \"a foreign id is never replied\")\n           (is (= 1 (count (diag :foreign-op-id))))\n           (is (= :replayed (:yin.k/admission (r :equal))) \"equal intent replays\")\n           (is (= (:yin.k/effect-result (first (:outcomes inspection)))\n                  (:yin.k/effect-result (r :equal)))\n               \"with the stored result\")\n           (is (= (outcome :committed {:yin.k/occurrence o :yin.k/seq 1}\n                           :yin.k/effect-result {:dao.stream/outcome :dao.stream/ok})\n                  (r :fresh))\n               \"a fresh id commits: the exact map\")\n           (is (= :intent-conflict (:yin.k/admission (r :different))) (pr-str (r :different)))\n           (is (= (id0 o) (:yin.k/op-id (r :different))))\n           (is (not (contains? (r :different) :yin.k/effect-result)))\n           (is (true? (get-in snap [:projection :occurrences o :yin.k/quarantined]))\n               \"the conflict quarantined the occurrence\")\n           (is (= :suspended (:yin.k/admission (r :after-quarantine))) \"the quarantine suspends\")\n           (is (= :suspended (:yin.k/admission (r :unreadable-authority)))\n               \"an unreadable authority suspends\")\n           (is (= [\"A\" \"B\"] (target-values inspection results))\n               \"only the first commit and the fresh id ever reached the target\"))\n         :cross-target\n         (let [answer (r :cross-target)\n               other (:other (:report l2))]\n           (is (= :intent-conflict (:yin.k/admission answer)) (pr-str answer))\n           (is (= (id0 o) (:yin.k/op-id answer)))\n           (is (true? (get-in snap [:projection :occurrences o :yin.k/quarantined]))\n               \"the shared id namespace conflicts across targets and quarantines\")\n           (is (= [\"A\"] (target-values inspection results)))\n           (is (= [] (get-in inspection [:targets other] [])) \"the other target received nothing\")))))})\n\n\n(def clause8-closed\n  \"A closed occurrence's stale answer and a closed ancestor's id at its\n   successor, after a real kill of the exit.\"\n  {:id [:clause-8 :closed]\n   :holders [\"h1\" \"h2\"]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut :row7/after-closure\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n             [:hand-off \"h1\"] [:until \"h1\" :exited 80]]})\n    (fn [results]\n      (let [old (binding-of (first results) \"h1\")]\n        {:on :rcv :kind :parked\n         :ops [[:source \"h1\"]\n               [:until \"h1\" :exited 60]\n               [:candidate \"h2\" {:kind :successor :of \"h1\"}]\n               [:until \"h2\" :running 60]\n               [:binding \"h2\"]\n               [:enroll-other]\n               (admit-op \"h1\" [:e8 :closed] (:lease old) (:epoch old) 0 \"A\"\n                         :occurrence (:occurrence old) :target :other)\n               (admit-op \"h2\" [:e8 :ancestor] [:binding \"h2\" :lease] [:binding \"h2\" :epoch] 0 \"A\"\n                         :occurrence (:occurrence old) :target :other :await? false)\n               [:snapshot :closed]]}))]\n   :check\n   (fn [results _inspection]\n     (let [[l1 l2] results\n           old (binding-of l1 \"h1\")\n           snap (snapshot-of l2 :closed)\n           closed (reply-to (get-in snap [:replies \"h1\"]) [:e8 :closed])]\n       (is (:killed? l1))\n       (is (= :stale (:yin.k/admission closed)) (pr-str closed))\n       (is (true? (:yin.k/closed closed)) \"the stale answer names the closure\")\n       (is (nil? (reply-to (get-in snap [:replies \"h2\"]) [:e8 :ancestor]))\n           \"an inherited id from a closed ancestor is never replied\")\n       (is (some #(and (= :foreign-op-id (:yin.k/defect %))\n                       (= \"h2\" (:yin.k/author %))\n                       (= (id0 (:occurrence old)) (get-in % [:yin.k/claimed :yin.k/op-id])))\n                 (:diagnostics snap))\n           \"it is diagnosed foreign at the successor\")))})\n\n\n;; =============================================================================\n;; The inbox retention machine and the journal brackets (D15a, D14)\n;; =============================================================================\n\n\n(def journal-cuts\n  [:inbox/before-retention :inbox/after-retention\n   :journal/after-proposal-intent :journal/before-proposal-attempt\n   :journal/after-grant-ack :journal/after-resumed-intent :journal/after-release-intent])\n\n\n(def uncertain-retentions\n  [{:like :inbox/before-retention :persist? false}\n   {:like :inbox/before-retention :persist? true}])\n\n\n(defn- inbox-key\n  [r]\n  [(:yin.k/lane r) (:yin.k/identity r) (:yin.k/position r)])\n\n\n(defn journal-row\n  \"A kill at one journal boundary (`cut`), or an uncertain append that\n   stalls the live driver before the kill (`fail`).\"\n  [{:keys [cut fail]}]\n  (let [exit-cut? (= :journal/after-release-intent cut)\n        report-cut? (= :journal/after-resumed-intent cut)]\n    {:id [:journal (or cut fail)]\n     :lives\n     [(fn [_]\n        (if fail\n          {:on :src :kind :parked :fail fail\n           :ops [[:source \"h1\"] [:until \"h1\" :running 40] [:snapshot :stalled] [:die :stalled]]}\n          {:on :src :kind :parked :cut cut\n           :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n                 [:hand-off \"h1\"] [:until \"h1\" :exited 80]]}))\n      (fn [_]\n        {:on :rcv :kind :parked\n         :ops (if exit-cut?\n                [[:at-open] [:source \"h1\"] [:until \"h1\" :exited 90]]\n                [[:at-open] [:source \"h1\"] [:until \"h1\" :running 90] [:binding \"h1\"]])})]\n     :check\n     (fn [results inspection]\n       (let [[l1 l2] results\n             journal (get-in inspection [:journals \"h1\"])\n             inbox (records journal :yin.k/inbox nil)\n             at (:at (cut-event l1))\n             p (:projection inspection)]\n         (is (:killed? l1))\n         (is (every? (fn [[_ n]] (= 1 n)) (frequencies (map inbox-key inbox)))\n             \"every source position is retained once: one queue entry, never two\")\n         (is (<= (count (records journal :yin.k/minted nil)) 2) \"no occurrence re-minted\")\n         (cond\n           fail\n           (let [stalled (get-in (snapshot-of l1 :stalled) [:holders \"h1\"])\n                 uncertain (some #(when (= :uncertain (:event %)) %) (:events l1))]\n             (is (some? uncertain) \"the retention append was answered uncertain\")\n             (is (= :stalled (:phase stalled)) (str \"an uncertain append stalls: \" (pr-str stalled)))\n             (is (false? (:machine? stalled)) \"nothing dispatched past it\")\n             (is (= 1 (count (filter #(= (inbox-key (:record uncertain)) (inbox-key %)) inbox)))\n                 \"reopen reconciled the position: retained once whether it landed or not\")\n             (is (= :running (:phase (holder l2 \"h1\"))) \"and the recovered holder ran\"))\n\n           (= :inbox/before-retention cut)\n           (let [lost (:record at)\n                 again (some #(when (= (inbox-key lost) (inbox-key %)) %) inbox)]\n             (is (some? again) \"the fresh driver re-read the source position\")\n             (is (= lost again)\n                 \"the same attributed record at the same position: lane, identity, author, record\"))\n\n           (= :inbox/after-retention cut)\n           (is (= 1 (count (filter #(= (inbox-key (:record at)) (inbox-key %)) inbox)))\n               \"retained before the kill, the record is one queue entry after it\")\n\n           (= :journal/after-grant-ack cut)\n           (let [b1 (binding-of l1 \"h1\")\n                 b2 (binding-of l2 \"h1\")]\n             (is (not= (:lease b1) (:lease b2))\n                 \"a restarted holder with a journaled grant never resumes it: a fresh tenure\")\n             (is (= :policy (get-in p [:leases (or (:lease b1)\n                                                   (get-in at [:record :dao.lease/lease]))\n                                       :dao.lease/cause]))\n                 \"the journaled grant was reclaimed\"))\n\n           report-cut?\n           (let [o (:occurrence (binding-of l1 \"h1\"))]\n             (is (empty? (records (get-in (snapshot-of l2 :at-open) [:journals \"h1\"])\n                                  :yin.k/attempt :yin.k/resumed))\n                 \"the report's intent stood, its attempt never happened\")\n             (is (= :running (:phase (holder l2 \"h1\")))\n                 \"no report was accepted: the last recorded checkpoint is regranted\")\n             (is (= o (:occurrence (holder l2 \"h1\"))))\n             (is (nil? (get-in p [:occurrences o :yin.k/closed])) \"nothing closed\"))\n\n           exit-cut?\n           (let [intents (records journal :yin.k/intent :yin.k/release)]\n             (is (= :exited (:phase (holder l2 \"h1\"))) \"the recovered exit completes\")\n             (is (= 1 (count (distinct (map #(get-in % [:yin.k/request :yin.k/request-id]) intents))))\n                 \"every resend after the intent is the identical request\"))\n\n           :else\n           (do (is (= :running (:phase (holder l2 \"h1\"))))\n               (is (every? (fn [[_ n]] (= 1 n)) (frequencies (keys (:answered p))))\n                   \"each proposal id answered once\")\n               (is (= 1 (count (live-leases p))) \"one live tenure\")))))}))\n\n\n;; =============================================================================\n;; Clause 3: the sequence counter across a kill between assign and\n;; discharge, and an id carried by the checkpoint\n;; =============================================================================\n\n\n(def clause3-regrant\n  {:id [:clause-3 :regrant]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows :cut :seq/after-assign\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"] [:until \"h1\" :safepoint 60]]})\n    (fn [results]\n      (rows-recovery results [[:source \"h1\"]\n                              [:until-inbound \"h1\" :yin.k/admit 90]\n                              [:snapshot :reassigned]\n                              [:until \"h1\" :safepoint 60]]))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           at (:at (cut-event l1))\n           o (:occurrence (binding-of l1 \"h1\"))\n           first-admit (first (filter #(= :yin.k/admit (:yin.k/request %)) (get-in at [:inbound \"h1\"])))\n           re (snapshot-of l2 :reassigned)\n           second-admit (first (filter #(= :yin.k/admit (:yin.k/request %)) (get-in re [:inbound \"h1\"])))]\n       (is (:killed? l1) \"killed between the id's assignment and its discharge\")\n       (is (= 1 (get-in at [:holders \"h1\" :next-op-seq])) \"assign-before-append: one increment\")\n       (is (= (id0 o) (get-in first-admit [:yin.k/fenced-envelope :yin.k/op-id])))\n       (is (= 1 (get-in re [:holders \"h1\" :next-op-seq]))\n           \"the regrant restored the counter exactly: the same one assignment\")\n       (is (= (get-in first-admit [:yin.k/fenced-envelope :yin.k/op-id])\n              (get-in second-admit [:yin.k/fenced-envelope :yin.k/op-id]))\n           \"the same id\")\n       (is (= \"A\" (get-in second-admit [:yin.k/fenced-envelope :yin.k/value])) \"the same intent\")\n       (is (= [\"A\"] (target-values inspection results)) \"committed once\")))})\n\n\n(def clause3-carried\n  \"An id assigned before the export rides the successor's bytes across a\n   kill of the exit and is retried, fenced, by the successor's holder.\"\n  {:id [:clause-3 :carried-put]\n   :holders [\"h1\" \"h2\"]\n   :lives\n   [(fn [_]\n      {:on :src :kind :rows :cut :row7/after-closure\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n             [:until-inbound \"h1\" :yin.k/admit 40]\n             [:hand-off \"h1\"] [:until \"h1\" :exited 80]]})\n    (fn [results]\n      (rows-recovery results [[:source \"h1\"]\n                              [:until \"h1\" :exited 60]\n                              [:candidate \"h2\" {:kind :successor :of \"h1\"}]\n                              [:until \"h2\" :running 60]\n                              [:binding \"h2\"]\n                              [:snapshot :successor-running]\n                              [:until \"h2\" :safepoint 60]]))]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           o (:occurrence (binding-of l1 \"h1\"))\n           run (snapshot-of l2 :successor-running)\n           admits (filter #(= :yin.k/admit (:yin.k/request %)) (get-in (final l2) [:inbound \"h2\"]))]\n       (is (:killed? l1))\n       (is (= 1 (get-in run [:holders \"h2\" :next-op-seq]))\n           \"the successor's counter is the carried one\")\n       (is (every? #(= (id0 o) (get-in % [:yin.k/fenced-envelope :yin.k/op-id])) admits)\n           \"the successor retries the origin's carried id unchanged\")\n       (is (every? #{:committed :replayed} (admissions (get-in inspection [:replies \"h2\"]))))\n       (is (= [\"A\"] (target-values inspection results)) \"the carried write commits once across the chain\")))})\n\n\n;; =============================================================================\n;; Fork, per host\n;; =============================================================================\n\n\n(def fork-row\n  {:id [:fork]\n   :lives [(fn [_] {:on :src :fork-row true})]\n   :check\n   (fn [results _inspection]\n     (let [r (:report (first results))]\n       (is (= :yin.k/unsatisfied (get-in r [:refused :yin.k/status])))\n       (is (= :exclusive-uncapable (get-in r [:refused :yin.k/reason]))\n           \"exclusive over a memory authority is refused\")\n       (is (= :yin.k/exclusive (get-in r [:refused :yin.k/policy])) \"never downgraded to fork\")\n       (is (false? (:refused-composed? r)) \"nothing was composed\")\n       (is (true? (get-in r [:fork :held?])))\n       (is (= :yin.k/fork (get-in r [:fork :policy])) \"fork runs when selected, labelled fork\")\n       (is (= :yin.k/fork (get-in r [:fork :status-policy])))\n       (is (nil? (get-in r [:fork :arbitration])))\n       (is (= :lifted (get-in r [:fork :holder :phase])))\n       (is (some? (get-in r [:fork :address])))\n       (is (= [] (get-in r [:fork :journal])) \"no custody bracket\")\n       (is (= [] (get-in r [:fork :offers])) \"nothing offered\")\n       (is (= 0 (get-in r [:fork :fronts])))\n       (is (false? (get-in r [:fork :outcome-reader?])))))})\n\n\n;; =============================================================================\n;; Row 7, continued: a failure-lower successor and a lost authority\n;; =============================================================================\n\n\n(def row7-failure-lower\n  \"The successor's first candidate cannot attach its stream: its lower\n   fails after the grant, it releases, and the successor is offered to\n   the next candidate instead of completing.\"\n  {:id [:row-7 :failure-lower]\n   :holders [\"h1\" \"h2\" \"h3\"]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut :row7/after-closure\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60] [:binding \"h1\"]\n             [:hand-off \"h1\"] [:until \"h1\" :exited 80]]})\n    (fn [_]\n      {:on :rcv :kind :parked\n       :ops [[:source \"h1\"]\n             [:until \"h1\" :exited 60]\n             [:candidate \"h2\" {:kind :successor :of \"h1\"} {:attach :none}]\n             [:until \"h2\" :failed 60]\n             [:ticks 4]\n             [:snapshot :failed-lower]\n             [:candidate \"h3\" {:kind :successor :of \"h1\"}]\n             [:until \"h3\" :running 60]\n             [:binding \"h3\"]]})]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           o (:occurrence (binding-of l1 \"h1\"))\n           failed (snapshot-of l2 :failed-lower)\n           h2 (get-in failed [:holders \"h2\"])\n           s (:occurrence h2)\n           b3 (binding-of l2 \"h3\")]\n       (is (:killed? l1))\n       (is (= :failed (:phase h2)) (pr-str h2))\n       (is (= :yin.k/unsatisfied (:status h2)))\n       (is (= {:dao.stream/identity world/prog-id :dao.lease/released true} (:detail h2))\n           \"the failed lower names the stream, after its release\")\n       (is (false? (:machine? h2)) \"no machine was exposed\")\n       (is (nil? (get-in failed [:projection :occurrences s :yin.k/closed]))\n           \"a failure-lower release never completes the successor\")\n       (is (nil? (get-in failed [:projection :occurrences s :dao.lease/lease])))\n       (is (some? (get-in inspection [:projection :occurrences o :yin.k/closed]))\n           \"the origin's closure stands\")\n       (is (= s (:occurrence b3)) \"the successor is reoffered to the next candidate\")\n       (is (= 1 (:epoch b3)) \"at the epoch the release advanced\")))})\n\n\n(def row7-lost-authority\n  \"The authority's state is permanently lost between lives: the next\n   open refuses, nothing is composed and nothing runs -- fail stop,\n   never a downgrade to fork.\"\n  {:id [:row-7 :lost-authority]\n   :lives\n   [(fn [_]\n      {:on :src :kind :parked :cut :row7/while-running\n       :ops [[:source \"h1\"] [:until \"h1\" :running 60]]})\n    (fn [_]\n      {:on :rcv :kind :parked :lose-authority true\n       :ops [[:source \"h1\"] [:until \"h1\" :running 30]]})]\n   :check\n   (fn [results inspection]\n     (let [[l1 l2] results\n           refusal (get-in l2 [:report :refusal])]\n       (is (:killed? l1))\n       (is (or (and (= :yin.k/unsatisfied (:yin.k/status refusal))\n                    (= :authority-refused (:yin.k/reason refusal)))\n               (and (= :authority-backend (:stage refusal))\n                    (= :dao.stream/transport-error\n                       (get-in refusal [:answer :dao.stream/outcome]))))\n           (str \"the lost authority is refused as data, by the composition or by \"\n                \"its durable backend before it: \" (pr-str refusal)))\n       (is (nil? (get-in l2 [:report :final])) \"nothing was composed, so nothing ran\")\n       (is (not= :open (:status inspection)) \"the lost ledger opens for no one\")))})\n\n\n(def all-scenarios\n  \"Every scenario, in run order.\"\n  (concat [fork-row]\n          (map row7 row7-cuts)\n          [row7-failure-lower row7-lost-authority]\n          (map row4 row4-cuts)\n          (map row3 row3-variants)\n          (map row5 row5-variants)\n          (map row2 (concat row2-pre-fence-cuts row2-post-fence-cuts))\n          (map row2-carrier row2-carriers)\n          [row1 row6-request-partition row6-consumer-partition row6-lost-reply]\n          (map clause8 clause8-variants)\n          [clause8-closed clause3-regrant clause3-carried]\n          (map #(journal-row {:cut %}) journal-cuts)\n          (map #(journal-row {:fail %}) uncertain-retentions)))\n","numLines":768,"startLine":560,"totalLines":1327}},"tool_result_meta":[{"id":"toolu_01HhDjfKiVdVLhyfTL8phzFP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CfziqXKqKJ1krnBY38C91","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01V7w9HpX8psuaacxa72qMzK","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_world.cljc","offset":1,"limit":420},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":10593,"cache_read_input_tokens":72161,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10593},"output_tokens":63,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"d04f20f5-f7dd-4ed0-beb9-9a3bfb4cd236","timestamp":"2026-10-13T18:37:58.075Z","request_id":"req_011CfziqX4DmRU3jDEvZVDua","wire_tool_inputs":{"toolu_01V7w9HpX8psuaacxa72qMzK":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_world.cljc","offset":1,"limit":420}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V7w9HpX8psuaacxa72qMzK","type":"tool_result","content":"1\t(ns yin.vm.ucf.stage-e-world\n2\t  \"M-next stage E: the world one life of a crash/partition scenario runs\n3\t   in, driven only through `yin.vm.ucf.compose` (linker-dht 14.2.4,\n4\t   UCF 7.11.1 clause 10 and the composition halves of clauses 3 and 8).\n5\t\n6\t   A scenario is a sequence of lives over one root directory.  Every\n7\t   piece of state a later life may read lives on durable file media\n8\t   under that root -- the authority's ledger (a dao.stream.journal.file\n9\t   backend), every holder's progress and reply journal\n10\t   (`compose/file-journals`), the content store (a dao.jing.file\n11\t   content file, the node's carrier for bodies and code) and the side\n12\t   log of at-least-once external IO -- so a life is a fresh runtime:\n13\t   nothing in memory crosses from one life to the next.  The program\n14\t   and source streams are outside custody; each life rebuilds its own\n15\t   instance of them under their fixed identities from the life's spec,\n16\t   the way a receiver attaches a stream by its carried descriptor.\n17\t\n18\t   A life is plain data (`run-life`'s spec) and so is everything it\n19\t   reports, so the same life runs in this process (the isolated-runtime\n20\t   mode every lane has, Dart's only form) or inside a separate operating\n21\t   system process (`yin.vm.ucf.stage-e-peer`, the JVM and Node process\n22\t   transport) and its report is compared as data either way.\n23\t\n24\t   Kills.  Every durable medium is wrapped mortal: a named cut (the\n25\t   `cuts` table) fires at one exact boundary -- before or after a given\n26\t   journal frame, before or after a given content-store put, or after a\n27\t   composition tick whose state matches -- and from then on the life is\n28\t   dead.  Inside a peer process the cut prints its event and blocks\n29\t   until the parent destroys the process (SIGKILL); in this process it\n30\t   marks every medium dead (no further durable write happens) and\n31\t   unwinds, and the runner releases the locks the dead runtime held --\n32\t   the only thing an operating system does for a killed process.\"\n33\t  (:require [dao.jing :as jing]\n34\t            [dao.jing.cbor :as cbor]\n35\t            [dao.jing.file :as jing-file]\n36\t            [dao.stream :as stream]\n37\t            [dao.stream.journal :as journal]\n38\t            [dao.stream.journal.file :as file-journal]\n39\t            [dao.stream.memory-log :as memory-log]\n40\t            #?@(:cljd [[\"dart:io\" :as dart-io]\n41\t                       [\"dart:typed_data\" :as typed]]\n42\t                :clj [[clojure.java.io :as io]])\n43\t            [yin.vm :as vm]\n44\t            [yin.vm.engine :as engine]\n45\t            [yin.vm.ucf.authority :as authority]\n46\t            [yin.vm.ucf.authority.admission :as admission]\n47\t            [yin.vm.ucf.compose :as compose]\n48\t            [yin.vm.ucf.rows-support :as s]\n49\t            [yin.vm.ucf.rows :as rows]\n50\t            [yin.vm.ucf.rows.checkpoint :as checkpoint]))\n51\t\n52\t\n53\t;; =============================================================================\n54\t;; Plain data\n55\t;; =============================================================================\n56\t\n57\t\n58\t(defn- host-bytes?\n59\t  [x]\n60\t  #?(:clj (bytes? x)\n61\t     :cljs (instance? js/Uint8Array x)\n62\t     :cljd (instance? typed/Uint8List x)))\n63\t\n64\t\n65\t(defn ->data\n66\t  \"`x` as plain data every host prints and reads back the same: maps,\n67\t   vectors, sets, scalars.  Host bytes become their blake3 digest\n68\t   ({::bytes hex}), so two byte strings compare equal exactly when their\n69\t   bytes are; anything else that is not data (a handle, a function, a\n70\t   machine) becomes {::opaque true}.\"\n71\t  [x]\n72\t  (cond\n73\t    (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n74\t        (number? x) (uuid? x))\n75\t    x\n76\t\n77\t    (host-bytes? x) {::bytes (jing/digest-bytes :blake3 x)}\n78\t    (map? x) (into {} (map (fn [[k v]] [(->data k) (->data v)])) x)\n79\t    (vector? x) (mapv ->data x)\n80\t    (set? x) (into #{} (map ->data) x)\n81\t    (sequential? x) (mapv ->data x)\n82\t    :else {::opaque true}))\n83\t\n84\t\n85\t(defn digest-of\n86\t  \"The digest form ->data gives host bytes `bs`.\"\n87\t  [bs]\n88\t  {::bytes (jing/digest-bytes :blake3 bs)})\n89\t\n90\t\n91\t;; =============================================================================\n92\t;; Scratch roots\n93\t;; =============================================================================\n94\t\n95\t\n96\t(defn temp-root\n97\t  \"A fresh scratch root under target/.\"\n98\t  []\n99\t  (str \"target/stage-e-\" (random-uuid)))\n100\t\n101\t\n102\t(defn cleanup-root!\n103\t  [dir]\n104\t  #?(:cljd (try (.deleteSync (dart-io/Directory. dir) .recursive true)\n105\t                (catch Object _ nil))\n106\t     :clj (letfn [(delete-recursively!\n107\t                    [f]\n108\t                    (when (.isDirectory f)\n109\t                      (doseq [child (.listFiles f)]\n110\t                        (delete-recursively! child)))\n111\t                    (.delete f))]\n112\t            (delete-recursively! (io/file dir)))\n113\t     :cljs (try (.rmSync (js/require \"fs\") dir #js {:recursive true :force true})\n114\t                (catch :default _ nil))))\n115\t\n116\t\n117\t(defn- ensure-dir!\n118\t  [dir]\n119\t  #?(:cljd (let [d (dart-io/Directory. dir)]\n120\t             (when-not (.existsSync d) (.createSync d .recursive true)))\n121\t     :clj (.mkdirs (io/file dir))\n122\t     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n123\t\n124\t\n125\t(defn paths\n126\t  \"The durable media of the world over `root`.\"\n127\t  [root]\n128\t  {:authority (str root \"/authority\")\n129\t   :journals (str root \"/journals\")\n130\t   :store (str root \"/store.jing\")\n131\t   :side (str root \"/side\")})\n132\t\n133\t\n134\t(defn destroy-authority!\n135\t  \"Permanently lose the authority's state under `root`: its content file\n136\t   is overwritten with bytes that are no content log, the way a lost\n137\t   disk leaves it.  No reopen can recover a ledger from it.\"\n138\t  [root]\n139\t  (let [path (str (:authority (paths root)) \"/\" file-journal/content-name)]\n140\t    #?(:cljd (.writeAsStringSync (dart-io/File. path) \"lost authority state\")\n141\t       :clj (spit path \"lost authority state\")\n142\t       :cljs (.writeFileSync (js/require \"fs\") path \"lost authority state\"))))\n143\t\n144\t\n145\t;; =============================================================================\n146\t;; The life context: events, counters, the cut and the kill\n147\t;; =============================================================================\n148\t\n149\t\n150\t(defn context\n151\t  \"A life's context.  `emit!` takes each event map as it happens (a peer\n152\t   prints it at once); `at-cut` is called when the life's cut fires: a\n153\t   peer's never returns -- the parent kills the process inside it -- and\n154\t   the in-process runner's returns so the life can unwind dead.\"\n155\t  [{:keys [cut fail emit! at-cut]}]\n156\t  {:cut cut\n157\t   :fail fail\n158\t   :failed (atom nil)\n159\t   :emit! (or emit! (fn [_]))\n160\t   :at-cut (or at-cut (fn []))\n161\t   :dead (atom false)\n162\t   :fired (atom nil)\n163\t   :hits (atom {})\n164\t   :attaches (atom 0)\n165\t   :observes (atom 0)\n166\t   :opened (atom [])})\n167\t\n168\t\n169\t(defn killed?\n170\t  [e]\n171\t  (true? (::killed (ex-data e))))\n172\t\n173\t\n174\t(defn- dead-throw!\n175\t  []\n176\t  (throw (ex-info \"stage E: a dead runtime wrote nothing\" {::killed true})))\n177\t\n178\t\n179\t(defn- fire!\n180\t  [ctx at]\n181\t  (reset! (:fired ctx) at)\n182\t  (reset! (:dead ctx) true)\n183\t  ((:emit! ctx) {:event :cut :cut (:cut ctx) :at at})\n184\t  ((:at-cut ctx))\n185\t  (throw (ex-info \"stage E: killed at a cut\" {::killed true :cut (:cut ctx)})))\n186\t\n187\t\n188\t;; =============================================================================\n189\t;; The named cuts\n190\t;; =============================================================================\n191\t\n192\t\n193\t(defn- record-is\n194\t  [journal-kind action]\n195\t  (fn [r]\n196\t    (and (= journal-kind (:yin.k/journal r))\n197\t         (or (nil? action) (= action (:yin.k/action r))))))\n198\t\n199\t\n200\t(defn- projection-of\n201\t  [c]\n202\t  (when-some [a (:authority c)]\n203\t    (authority/projection a)))\n204\t\n205\t\n206\t(defn- journal-records-of\n207\t  \"Holder `h`'s whole progress journal, read through a fresh open of its\n208\t   backend (the restart's view).\"\n209\t  [c h]\n210\t  (let [backend (get-in c [:progress h :backend])\n211\t        j (if (some? backend)\n212\t            (:dao.stream/handle (journal/open! backend nil))\n213\t            (compose/journal-of c h))]\n214\t    (if (nil? j)\n215\t      []\n216\t      (loop [cursor (:dao.stream/cursor (stream/cursor j :dao.stream/oldest))\n217\t             records []]\n218\t        (let [answer (stream/next j cursor)]\n219\t          (if (= :dao.stream/ok (:dao.stream/outcome answer))\n220\t            (recur (:dao.stream/cursor answer) (conj records (:dao.stream/value answer)))\n221\t            records))))))\n222\t\n223\t\n224\t(defn- holder-records-match?\n225\t  [c h pred]\n226\t  (boolean (some pred (journal-records-of c h))))\n227\t\n228\t\n229\t(defn- exit-occurrence\n230\t  [c h]\n231\t  (get-in c [:holders h :exit :occurrence]))\n232\t\n233\t\n234\t(defn- read-values\n235\t  [h]\n236\t  (loop [cursor (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n237\t         values []]\n238\t    (let [r (stream/next h cursor)]\n239\t      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count values) 1000))\n240\t        (recur (:dao.stream/cursor r) (conj values (:dao.stream/value r)))\n241\t        values))))\n242\t\n243\t\n244\t(defn inbound-of\n245\t  \"The requests of `kind` (every request when nil) that reached holder\n246\t   `h`'s inbound in this life, in stream order.\"\n247\t  [c h kind]\n248\t  (if-some [inbound (get-in c [:inbounds h])]\n249\t    (filterv #(or (nil? kind) (= kind (:yin.k/request %))) (read-values inbound))\n250\t    []))\n251\t\n252\t\n253\t(defn- admission-commit?\n254\t  \"Whether ledger record `r` is the transaction that commits an admitted\n255\t   effect: one of its datoms is the :yin.k/admitted custody fact.\"\n256\t  [r]\n257\t  (boolean (some (fn [d]\n258\t                   (and (sequential? d)\n259\t                        (= :yin.k/custody (nth d 1 nil))\n260\t                        (= :yin.k/admitted (nth d 2 nil))))\n261\t                 (get-in r [:dao.space/transaction :datoms]))))\n262\t\n263\t\n264\t(def cuts\n265\t  \"Every named cut a scenario may ask for: where it fires and when.\n266\t   :site is a journal ([:progress h] or [:reply h]), :authority, :store\n267\t   or :tick; :when is :before or :after the matched write (a tick cut\n268\t   fires after the tick whose composition matches); :match is a\n269\t   predicate over the decoded journal record, the put ({:address a}) or\n270\t   the composition; :nth counts matches (default 1).\"\n271\t  {;; ---- row 7: completion\n272\t   :row7/after-successor-append\n273\t   {:site :tick\n274\t    :match (fn [c]\n275\t             (let [s (exit-occurrence c \"h1\")]\n276\t               (and (some? s)\n277\t                    (holder-records-match?\n278\t                      c \"h1\" #(and ((record-is :yin.k/attempt :yin.k/offer) %)\n279\t                                   (= s (:yin.k/occurrence %)))))))}\n280\t   :row7/after-resumed-report\n281\t   {:site :tick\n282\t    :match (fn [c]\n283\t             (let [l (get-in c [:holders \"h1\" :lease])]\n284\t               (and (some? l)\n285\t                    (some? (get-in (projection-of c) [:leases l :yin.k/result])))))}\n286\t   :row7/after-release-append\n287\t   {:site :tick\n288\t    :match (fn [c]\n289\t             (holder-records-match?\n290\t               c \"h1\" #(and ((record-is :yin.k/attempt :yin.k/release) %)\n291\t                            (= :dao.stream/ok (:yin.k/append %)))))}\n292\t   :row7/after-closure\n293\t   {:site :tick\n294\t    :match (fn [c]\n295\t             (let [o (get-in c [:holders \"h1\" :occurrence])]\n296\t               (and (some? o)\n297\t                    (some? (get-in (projection-of c) [:occurrences o :yin.k/closed])))))}\n298\t   :row7/while-running\n299\t   {:site :tick\n300\t    :match (fn [c] (= :running (get-in c [:holders \"h1\" :phase])))}\n301\t\n302\t   ;; ---- row 4 and clause 8: around the atomic effect commitment (the\n303\t   ;; ledger transaction that records the admitted effect)\n304\t   :row4/before-commit\n305\t   {:site :authority :when :before :match admission-commit?}\n306\t   :row4/after-commit\n307\t   {:site :authority :when :after :match admission-commit?}\n308\t   :row4/before-result-append\n309\t   {:site [:reply \"h1\"] :when :before\n310\t    :match (fn [r] (= :yin.k/admit (:yin.k/reply r)))}\n311\t   :row4/admit-uncarried\n312\t   {:site :tick\n313\t    :match (fn [c] (seq (inbound-of c \"h1\" :yin.k/admit)))}\n314\t\n315\t   ;; ---- row 5: the input record\n316\t   :row5/input-uncarried\n317\t   {:site :tick\n318\t    :match (fn [c] (seq (inbound-of c \"h1\" :yin.k/input)))}\n319\t   :row5/input-carried\n320\t   {:site [:reply \"h1\"] :when :after\n321\t    :match (fn [r] (= :yin.k/input (:yin.k/reply r)))}\n322\t\n323\t   ;; ---- row 2 and the D14 journal brackets: the export's phases\n324\t   :export/after-minted\n325\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/minted nil)}\n326\t   :export/after-serve-intent\n327\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/serve)}\n328\t   :export/after-serve-ack\n329\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/serve)}\n330\t   :export/after-store-intent\n331\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/store)}\n332\t   :export/store-put-before\n333\t   {:site :store :when :before :match (fn [_] true)}\n334\t   :export/store-put-after\n335\t   {:site :store :when :after :match (fn [_] true)}\n336\t   :export/after-store-ack\n337\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/store)}\n338\t   :export/before-fenced\n339\t   {:site [:progress \"h1\"] :when :before :match (record-is :yin.k/fenced nil)}\n340\t   :export/after-fenced\n341\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/fenced nil)}\n342\t   :export/after-offer-intent\n343\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/offer)}\n344\t   :export/after-offer-attempt\n345\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/attempt :yin.k/offer)}\n346\t   :export/after-offer-ack\n347\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/offer)}\n348\t\n349\t   ;; ---- the inbox retention machine (D15a) and the grant bracket\n350\t   :inbox/before-retention\n351\t   {:site [:progress \"h1\"] :when :before :match (record-is :yin.k/inbox nil)}\n352\t   :inbox/after-retention\n353\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/inbox nil)}\n354\t   :journal/before-proposal-attempt\n355\t   {:site [:progress \"h1\"] :when :before :match (record-is :yin.k/attempt :yin.k/proposal)}\n356\t   :journal/after-proposal-intent\n357\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/proposal)}\n358\t   :journal/after-grant-ack\n359\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/grant)}\n360\t   :journal/after-resumed-intent\n361\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/resumed)}\n362\t   :journal/after-release-intent\n363\t   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/release)}\n364\t\n365\t   ;; ---- clause 8: after the first commit's reply stands\n366\t   :clause8/committed\n367\t   {:site :tick\n368\t    :match (fn [c]\n369\t             (some #(and (= :yin.k/admit (:yin.k/reply %))\n370\t                         (= :committed (get-in % [:yin.k/answer :yin.k/admission])))\n371\t                   (if-some [j (get-in c [:reply-journals \"h1\" :journal])]\n372\t                     (read-values j)\n373\t                     [])))}\n374\t\n375\t   ;; ---- row 6: a lost reply (the process dies before the front's\n376\t   ;; append of the proposal's reply)\n377\t   :row6/proposal-reply-lost\n378\t   {:site [:reply \"h1\"] :when :before\n379\t    :match (fn [r] (= :yin.k/proposal (:yin.k/reply r)))}\n380\t\n381\t   ;; ---- the freeze's second stored object (the body)\n382\t   :export/body-put-before\n383\t   {:site :store :when :before :match (fn [_] true) :nth 2}\n384\t   :export/body-put-after\n385\t   {:site :store :when :after :match (fn [_] true) :nth 2}\n386\t\n387\t   ;; ---- clause 3: between assign and discharge\n388\t   :seq/after-assign\n389\t   {:site :tick\n390\t    :match (fn [c] (seq (inbound-of c \"h1\" :yin.k/admit)))}})\n391\t\n392\t\n393\t(defn- cut-spec\n394\t  [ctx]\n395\t  (when-some [k (:cut ctx)]\n396\t    (or (get cuts k)\n397\t        (throw (ex-info \"stage E: unknown cut\" {:cut k})))))\n398\t\n399\t\n400\t(defn- hit!\n401\t  \"Whether the life's cut matches this write at `site` (counted against\n402\t   :nth), answering :before, :after or nil.\"\n403\t  [ctx site subject]\n404\t  (let [spec (cut-spec ctx)]\n405\t    (when (and (some? spec)\n406\t               (nil? @(:fired ctx))\n407\t               (= site (:site spec))\n408\t               ((:match spec) subject))\n409\t      (let [n (get (swap! (:hits ctx) update site (fnil inc 0)) site)]\n410\t        (when (= n (or (:nth spec) 1))\n411\t          (or (:when spec) :after))))))\n412\t\n413\t\n414\t;; =============================================================================\n415\t;; Mortal media\n416\t;; =============================================================================\n417\t\n418\t\n419\t(defn- frame-record\n420\t  [bs]"}]},"parent_tool_use_id":null,"session_id":"c88f8d87-995f-4b00-89ec-984c8c9878f0","uuid":"432ce0b2-955e-4503-8971-530adc0a841f","timestamp":"2026-10-13T18:37:58.082Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7d/test/yin/vm/ucf/stage_e_world.cljc","content":"(ns yin.vm.ucf.stage-e-world\n  \"M-next stage E: the world one life of a crash/partition scenario runs\n   in, driven only through `yin.vm.ucf.compose` (linker-dht 14.2.4,\n   UCF 7.11.1 clause 10 and the composition halves of clauses 3 and 8).\n\n   A scenario is a sequence of lives over one root directory.  Every\n   piece of state a later life may read lives on durable file media\n   under that root -- the authority's ledger (a dao.stream.journal.file\n   backend), every holder's progress and reply journal\n   (`compose/file-journals`), the content store (a dao.jing.file\n   content file, the node's carrier for bodies and code) and the side\n   log of at-least-once external IO -- so a life is a fresh runtime:\n   nothing in memory crosses from one life to the next.  The program\n   and source streams are outside custody; each life rebuilds its own\n   instance of them under their fixed identities from the life's spec,\n   the way a receiver attaches a stream by its carried descriptor.\n\n   A life is plain data (`run-life`'s spec) and so is everything it\n   reports, so the same life runs in this process (the isolated-runtime\n   mode every lane has, Dart's only form) or inside a separate operating\n   system process (`yin.vm.ucf.stage-e-peer`, the JVM and Node process\n   transport) and its report is compared as data either way.\n\n   Kills.  Every durable medium is wrapped mortal: a named cut (the\n   `cuts` table) fires at one exact boundary -- before or after a given\n   journal frame, before or after a given content-store put, or after a\n   composition tick whose state matches -- and from then on the life is\n   dead.  Inside a peer process the cut prints its event and blocks\n   until the parent destroys the process (SIGKILL); in this process it\n   marks every medium dead (no further durable write happens) and\n   unwinds, and the runner releases the locks the dead runtime held --\n   the only thing an operating system does for a killed process.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.file :as jing-file]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.journal.file :as file-journal]\n            [dao.stream.memory-log :as memory-log]\n            #?@(:cljd [[\"dart:io\" :as dart-io]\n                       [\"dart:typed_data\" :as typed]]\n                :clj [[clojure.java.io :as io]])\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.admission :as admission]\n            [yin.vm.ucf.compose :as compose]\n            [yin.vm.ucf.rows-support :as s]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows.checkpoint :as checkpoint]))\n\n\n;; =============================================================================\n;; Plain data\n;; =============================================================================\n\n\n(defn- host-bytes?\n  [x]\n  #?(:clj (bytes? x)\n     :cljs (instance? js/Uint8Array x)\n     :cljd (instance? typed/Uint8List x)))\n\n\n(defn ->data\n  \"`x` as plain data every host prints and reads back the same: maps,\n   vectors, sets, scalars.  Host bytes become their blake3 digest\n   ({::bytes hex}), so two byte strings compare equal exactly when their\n   bytes are; anything else that is not data (a handle, a function, a\n   machine) becomes {::opaque true}.\"\n  [x]\n  (cond\n    (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n        (number? x) (uuid? x))\n    x\n\n    (host-bytes? x) {::bytes (jing/digest-bytes :blake3 x)}\n    (map? x) (into {} (map (fn [[k v]] [(->data k) (->data v)])) x)\n    (vector? x) (mapv ->data x)\n    (set? x) (into #{} (map ->data) x)\n    (sequential? x) (mapv ->data x)\n    :else {::opaque true}))\n\n\n(defn digest-of\n  \"The digest form ->data gives host bytes `bs`.\"\n  [bs]\n  {::bytes (jing/digest-bytes :blake3 bs)})\n\n\n;; =============================================================================\n;; Scratch roots\n;; =============================================================================\n\n\n(defn temp-root\n  \"A fresh scratch root under target/.\"\n  []\n  (str \"target/stage-e-\" (random-uuid)))\n\n\n(defn cleanup-root!\n  [dir]\n  #?(:cljd (try (.deleteSync (dart-io/Directory. dir) .recursive true)\n                (catch Object _ nil))\n     :clj (letfn [(delete-recursively!\n                    [f]\n                    (when (.isDirectory f)\n                      (doseq [child (.listFiles f)]\n                        (delete-recursively! child)))\n                    (.delete f))]\n            (delete-recursively! (io/file dir)))\n     :cljs (try (.rmSync (js/require \"fs\") dir #js {:recursive true :force true})\n                (catch :default _ nil))))\n\n\n(defn- ensure-dir!\n  [dir]\n  #?(:cljd (let [d (dart-io/Directory. dir)]\n             (when-not (.existsSync d) (.createSync d .recursive true)))\n     :clj (.mkdirs (io/file dir))\n     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n\n\n(defn paths\n  \"The durable media of the world over `root`.\"\n  [root]\n  {:authority (str root \"/authority\")\n   :journals (str root \"/journals\")\n   :store (str root \"/store.jing\")\n   :side (str root \"/side\")})\n\n\n(defn destroy-authority!\n  \"Permanently lose the authority's state under `root`: its content file\n   is overwritten with bytes that are no content log, the way a lost\n   disk leaves it.  No reopen can recover a ledger from it.\"\n  [root]\n  (let [path (str (:authority (paths root)) \"/\" file-journal/content-name)]\n    #?(:cljd (.writeAsStringSync (dart-io/File. path) \"lost authority state\")\n       :clj (spit path \"lost authority state\")\n       :cljs (.writeFileSync (js/require \"fs\") path \"lost authority state\"))))\n\n\n;; =============================================================================\n;; The life context: events, counters, the cut and the kill\n;; =============================================================================\n\n\n(defn context\n  \"A life's context.  `emit!` takes each event map as it happens (a peer\n   prints it at once); `at-cut` is called when the life's cut fires: a\n   peer's never returns -- the parent kills the process inside it -- and\n   the in-process runner's returns so the life can unwind dead.\"\n  [{:keys [cut fail emit! at-cut]}]\n  {:cut cut\n   :fail fail\n   :failed (atom nil)\n   :emit! (or emit! (fn [_]))\n   :at-cut (or at-cut (fn []))\n   :dead (atom false)\n   :fired (atom nil)\n   :hits (atom {})\n   :attaches (atom 0)\n   :observes (atom 0)\n   :opened (atom [])})\n\n\n(defn killed?\n  [e]\n  (true? (::killed (ex-data e))))\n\n\n(defn- dead-throw!\n  []\n  (throw (ex-info \"stage E: a dead runtime wrote nothing\" {::killed true})))\n\n\n(defn- fire!\n  [ctx at]\n  (reset! (:fired ctx) at)\n  (reset! (:dead ctx) true)\n  ((:emit! ctx) {:event :cut :cut (:cut ctx) :at at})\n  ((:at-cut ctx))\n  (throw (ex-info \"stage E: killed at a cut\" {::killed true :cut (:cut ctx)})))\n\n\n;; =============================================================================\n;; The named cuts\n;; =============================================================================\n\n\n(defn- record-is\n  [journal-kind action]\n  (fn [r]\n    (and (= journal-kind (:yin.k/journal r))\n         (or (nil? action) (= action (:yin.k/action r))))))\n\n\n(defn- projection-of\n  [c]\n  (when-some [a (:authority c)]\n    (authority/projection a)))\n\n\n(defn- journal-records-of\n  \"Holder `h`'s whole progress journal, read through a fresh open of its\n   backend (the restart's view).\"\n  [c h]\n  (let [backend (get-in c [:progress h :backend])\n        j (if (some? backend)\n            (:dao.stream/handle (journal/open! backend nil))\n            (compose/journal-of c h))]\n    (if (nil? j)\n      []\n      (loop [cursor (:dao.stream/cursor (stream/cursor j :dao.stream/oldest))\n             records []]\n        (let [answer (stream/next j cursor)]\n          (if (= :dao.stream/ok (:dao.stream/outcome answer))\n            (recur (:dao.stream/cursor answer) (conj records (:dao.stream/value answer)))\n            records))))))\n\n\n(defn- holder-records-match?\n  [c h pred]\n  (boolean (some pred (journal-records-of c h))))\n\n\n(defn- exit-occurrence\n  [c h]\n  (get-in c [:holders h :exit :occurrence]))\n\n\n(defn- read-values\n  [h]\n  (loop [cursor (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n         values []]\n    (let [r (stream/next h cursor)]\n      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count values) 1000))\n        (recur (:dao.stream/cursor r) (conj values (:dao.stream/value r)))\n        values))))\n\n\n(defn inbound-of\n  \"The requests of `kind` (every request when nil) that reached holder\n   `h`'s inbound in this life, in stream order.\"\n  [c h kind]\n  (if-some [inbound (get-in c [:inbounds h])]\n    (filterv #(or (nil? kind) (= kind (:yin.k/request %))) (read-values inbound))\n    []))\n\n\n(defn- admission-commit?\n  \"Whether ledger record `r` is the transaction that commits an admitted\n   effect: one of its datoms is the :yin.k/admitted custody fact.\"\n  [r]\n  (boolean (some (fn [d]\n                   (and (sequential? d)\n                        (= :yin.k/custody (nth d 1 nil))\n                        (= :yin.k/admitted (nth d 2 nil))))\n                 (get-in r [:dao.space/transaction :datoms]))))\n\n\n(def cuts\n  \"Every named cut a scenario may ask for: where it fires and when.\n   :site is a journal ([:progress h] or [:reply h]), :authority, :store\n   or :tick; :when is :before or :after the matched write (a tick cut\n   fires after the tick whose composition matches); :match is a\n   predicate over the decoded journal record, the put ({:address a}) or\n   the composition; :nth counts matches (default 1).\"\n  {;; ---- row 7: completion\n   :row7/after-successor-append\n   {:site :tick\n    :match (fn [c]\n             (let [s (exit-occurrence c \"h1\")]\n               (and (some? s)\n                    (holder-records-match?\n                      c \"h1\" #(and ((record-is :yin.k/attempt :yin.k/offer) %)\n                                   (= s (:yin.k/occurrence %)))))))}\n   :row7/after-resumed-report\n   {:site :tick\n    :match (fn [c]\n             (let [l (get-in c [:holders \"h1\" :lease])]\n               (and (some? l)\n                    (some? (get-in (projection-of c) [:leases l :yin.k/result])))))}\n   :row7/after-release-append\n   {:site :tick\n    :match (fn [c]\n             (holder-records-match?\n               c \"h1\" #(and ((record-is :yin.k/attempt :yin.k/release) %)\n                            (= :dao.stream/ok (:yin.k/append %)))))}\n   :row7/after-closure\n   {:site :tick\n    :match (fn [c]\n             (let [o (get-in c [:holders \"h1\" :occurrence])]\n               (and (some? o)\n                    (some? (get-in (projection-of c) [:occurrences o :yin.k/closed])))))}\n   :row7/while-running\n   {:site :tick\n    :match (fn [c] (= :running (get-in c [:holders \"h1\" :phase])))}\n\n   ;; ---- row 4 and clause 8: around the atomic effect commitment (the\n   ;; ledger transaction that records the admitted effect)\n   :row4/before-commit\n   {:site :authority :when :before :match admission-commit?}\n   :row4/after-commit\n   {:site :authority :when :after :match admission-commit?}\n   :row4/before-result-append\n   {:site [:reply \"h1\"] :when :before\n    :match (fn [r] (= :yin.k/admit (:yin.k/reply r)))}\n   :row4/admit-uncarried\n   {:site :tick\n    :match (fn [c] (seq (inbound-of c \"h1\" :yin.k/admit)))}\n\n   ;; ---- row 5: the input record\n   :row5/input-uncarried\n   {:site :tick\n    :match (fn [c] (seq (inbound-of c \"h1\" :yin.k/input)))}\n   :row5/input-carried\n   {:site [:reply \"h1\"] :when :after\n    :match (fn [r] (= :yin.k/input (:yin.k/reply r)))}\n\n   ;; ---- row 2 and the D14 journal brackets: the export's phases\n   :export/after-minted\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/minted nil)}\n   :export/after-serve-intent\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/serve)}\n   :export/after-serve-ack\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/serve)}\n   :export/after-store-intent\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/store)}\n   :export/store-put-before\n   {:site :store :when :before :match (fn [_] true)}\n   :export/store-put-after\n   {:site :store :when :after :match (fn [_] true)}\n   :export/after-store-ack\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/store)}\n   :export/before-fenced\n   {:site [:progress \"h1\"] :when :before :match (record-is :yin.k/fenced nil)}\n   :export/after-fenced\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/fenced nil)}\n   :export/after-offer-intent\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/offer)}\n   :export/after-offer-attempt\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/attempt :yin.k/offer)}\n   :export/after-offer-ack\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/offer)}\n\n   ;; ---- the inbox retention machine (D15a) and the grant bracket\n   :inbox/before-retention\n   {:site [:progress \"h1\"] :when :before :match (record-is :yin.k/inbox nil)}\n   :inbox/after-retention\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/inbox nil)}\n   :journal/before-proposal-attempt\n   {:site [:progress \"h1\"] :when :before :match (record-is :yin.k/attempt :yin.k/proposal)}\n   :journal/after-proposal-intent\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/proposal)}\n   :journal/after-grant-ack\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/ack :yin.k/grant)}\n   :journal/after-resumed-intent\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/resumed)}\n   :journal/after-release-intent\n   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/intent :yin.k/release)}\n\n   ;; ---- clause 8: after the first commit's reply stands\n   :clause8/committed\n   {:site :tick\n    :match (fn [c]\n             (some #(and (= :yin.k/admit (:yin.k/reply %))\n                         (= :committed (get-in % [:yin.k/answer :yin.k/admission])))\n                   (if-some [j (get-in c [:reply-journals \"h1\" :journal])]\n                     (read-values j)\n                     [])))}\n\n   ;; ---- row 6: a lost reply (the process dies before the front's\n   ;; append of the proposal's reply)\n   :row6/proposal-reply-lost\n   {:site [:reply \"h1\"] :when :before\n    :match (fn [r] (= :yin.k/proposal (:yin.k/reply r)))}\n\n   ;; ---- the freeze's second stored object (the body)\n   :export/body-put-before\n   {:site :store :when :before :match (fn [_] true) :nth 2}\n   :export/body-put-after\n   {:site :store :when :after :match (fn [_] true) :nth 2}\n\n   ;; ---- clause 3: between assign and discharge\n   :seq/after-assign\n   {:site :tick\n    :match (fn [c] (seq (inbound-of c \"h1\" :yin.k/admit)))}})\n\n\n(defn- cut-spec\n  [ctx]\n  (when-some [k (:cut ctx)]\n    (or (get cuts k)\n        (throw (ex-info \"stage E: unknown cut\" {:cut k})))))\n\n\n(defn- hit!\n  \"Whether the life's cut matches this write at `site` (counted against\n   :nth), answering :before, :after or nil.\"\n  [ctx site subject]\n  (let [spec (cut-spec ctx)]\n    (when (and (some? spec)\n               (nil? @(:fired ctx))\n               (= site (:site spec))\n               ((:match spec) subject))\n      (let [n (get (swap! (:hits ctx) update site (fnil inc 0)) site)]\n        (when (= n (or (:nth spec) 1))\n          (or (:when spec) :after))))))\n\n\n;; =============================================================================\n;; Mortal media\n;; =============================================================================\n\n\n(defn- frame-record\n  [bs]","numLines":420,"startLine":1,"totalLines":1411}},"tool_result_meta":[{"id":"toolu_01V7w9HpX8psuaacxa72qMzK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
