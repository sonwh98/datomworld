d! :duplicate-key [id])))))\n       (letfn [(expand-slot\n                 [d x]\n                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n                       :else x))\n       #?(:cljs (js/Number.isSafeInteger x) :default true)))\n\n\n(def ^:private operand-kind-checks\n  \"Every operand kind this dimension's table uses except :pc, which\n   `target-bounds-rule` owns because judging it needs the vector's own\n   length.\"\n  {:data vm/plain-data?,\n   :sym symbol?,\n   :kw keyword?,\n   ;; a non-nil :str operand must also be well-formed UTF-16 (the same\n   ;; guard `encode-scalar` applies to a :string value), so a malformed\n   ;; :str operand is rejected here, before hashing -- not only inside\n   ;; `encode-operand`\n   :str (fn [x] (or (nil? x) (and (string? x) (well-formed-utf16? x)))),\n   :bool (fn [x] (or (nil? x) (boolean? x))),\n   :buffer (fn [x] (or (nil? x) (nonneg-int? x))),\n   :uint nonneg-int?})\n\n\n(defn- operand-kind-rule\n  [v]\n  (some (fn [pc]\n          (let [t (nth v pc), kinds (tuple-kinds t)]\n            (some (fn [i]\n                    (let [check (get operand-kind-checks (nth kinds (dec i)))]\n                      (when (and check (not (check (nth t i))))\n                        (tuple-defect :operand-kind pc))))\n                  (range 1 (count t)))))\n        (range (count v))))\n\n\n(def ^:private saturated-operands\n  \"This dimension's saturated operands, frozen under\n   `lowering-contract-version` 2. Each `[mnemonic index]` must be\n   materialized even when its operand-kind check tolerates nil.\n   :ffi-call's argc is also rejected as nil by its :uint kind check.\"\n  #{[:gensym 1] [:stream-make 1] [:call 2] [:ffi-call 2]})\n\n\n(defn- saturation-rule\n  [v]\n  (some (fn [pc]\n          (let [t (nth v pc)]\n            (when (some #(and (contains? saturated-operands [(mnemonic-of t) %])\n                              (nil? (nth t %)))\n                        (range 1 (count t)))\n              (tuple-defect :saturation pc))))\n        (range (count v))))\n\n\n(defn- target-bounds-rule\n  [v]\n  (let [length (count v)]\n    (some (fn [pc]\n            (let [t (nth v pc), kinds (tuple-kinds t)]\n              (some (fn [i]\n                      (when (= :pc (nth kinds (dec i)))\n                        (let [x (nth t i)]\n                          (when-not (and (nonneg-int? x) (<= x (dec length)))\n                            (tuple-defect :target-bounds pc)))))\n                    (range 1 (count t)))))\n          (range (count v)))))\n\n\n(defn- terminator-rule\n  [v]\n  (let [pc (dec (count v))]\n    (when-not (contains? terminators (mnemonic-of (nth v pc)))\n      (tuple-defect :terminator pc))))\n\n\n\n(def ^:private operand-kind-checks\n  {:reg nonneg-int?,\n   :uint nonneg-int?,\n   :regs (fn [x] (and (vector? x) (every? nonneg-int? x))),\n   :str string?,\n   :kw keyword?,\n   :sym symbol?,\n   :data vm/plain-data?,\n   :bool boolean?})\n\n\n(defn- operand-kind-rule\n  [{:keys [instructions]}]\n  (some (fn [pc]\n          (let [t (nth instructions pc), kinds (tuple-kinds t)]\n            (some (fn [i]\n                    (let [check (get operand-kind-checks (nth kinds (dec i)))]\n                      (when (and check (not (check (nth t i))))\n                        (tuple-defect :operand-kind pc))))\n                  (range 1 (count t)))))\n        (range (count instructions))))\n\n\n(defn- target-bounds-rule\n  [{:keys [instructions]}]\n  (let [length (count instructions)]\n    (some (fn [pc]\n            (let [t (nth instructions pc), kinds (tuple-kinds t)]\n              (some (fn [i]\n                      (when (= :pc (nth kinds (dec i)))\n                        (let [x (nth t i)]\n                          (when-not (and (nonneg-int? x) (< x length))\n                            (tuple-defect :target-bounds pc)))))\n                    (range 1 (count t)))))\n          (range (count instructions)))))\n\n\n(defn- body-scope-rule\n  \"Bodies must exactly and contiguously partition `[0, length)` in the\n   order given, body 0 starting at pc 0 (design section 4.2's own body\n   layout, matching the lowerer's emission order: main body first, then\n   each out-of-line lambda body in discovery order). Every `:closure`\n   tuple's `body-pc` must name exactly one declared body's own `:start`,\n   and that body's `:locals` must equal the `:closure`'s own declared\n   arity -- two different bodies, or a body of the wrong arity, at one\n   `body-pc` is a defect here, not merely a `target-bounds` pass.\"\n  [{:keys [bodies instructions]}]\n  (let [length (count instructions)\n        n (count bodies)]\n    (or (when (zero? n) (body-defect :no-bodies 0))\n        (some (fn [i]\n                (let [{:keys [locals registers start end]} (nth bodies i)]\n                  (when-not (and (nonneg-int? locals) (nonneg-int? registers)\n                                 (nonneg-int? start) (nonneg-int? end)\n                                 (<= start end) (< end length)\n                                 (<= locals registers))\n                    (body-defect :body-shape i))))\n              (range n))\n        (some (fn [i]\n    (decimal? x) :decimal\n    (ratio? x) :rational\n    :else (refuse :unsupported-value\n                  (str \"not a portable number: \" (type-name x)))))\n\n\n(defn- numeric-content-key\n  \"The kind-strict identity of numeric x, the same distinctions content\n   addressing makes: kind, then within float64 the exact bits (so the zero\n   sign counts, and every NaN is the one canonical NaN), within decimal the\n   exponent (scale) and mantissa, within rational the reduced numerator and\n   denominator. Integer width is not identity. Built from strings and\n   keywords, so equal content gives equal keys on every host.\"\n  [x]\n  (case (numeric-kind x)\n    :integer (do #?(:cljs (when (and (number? x)\n                                     (not (js/Number.isSafeInteger x)))\n                            (refuse :unsupported-value\n                                    (str \"unsafe integral JavaScript number: \"\n                                         \"its value is already rounded\"))))\n                 [::integer (str (big x))])\n    :float64 (let [[neg e f] (float-fields (float-value x))]\n               (if (and (= e 0x7ff) (pos? (bsign f)))\n                 [::float64 :nan]\n                 [::float64 neg e (str f)]))\n    :decimal [::decimal\n              (str (decimal-exponent x))\n              (str (big (decimal-mantissa x)))]\n    :rational (let [[_ n d] (exact x)]\n                [::rational (str n) (str d)])))\n\n\n(defn content-key\n  \"A host value whose host `=` and `hash` agree with content=: numbers by\n   their kind-strict identity, byte strings by content, identifiers by their\n   namespace and name fields, lists and vectors alike (README ruling A6)\n   element by element, maps and sets by members, metadata ignored, any other\n   value as itself. A caller keys a host map or set by it to get\n   kind-strict content identity from host collections (JVM `=` merges\n   0.0 with -0.0 and 1.0M with 1.00M; ClojureScript merges slash-crossed\n   identifiers). The same traversal as equiv, with the kind-strict numeric\n   key in place of num=.\"\n  [x]\n  (cond\n    (numeric? x) (numeric-content-key x)\n    (wire/byte-payload? x) [::bytes (bytes-hex x)]\n    (or (keyword? x) (symbol? x)) [::identifier (identifier-key x)]\n    (sequential-value? x) (mapv content-key x)\n    (map? x) (into {} (map (fn [[k v]] [(content-key k) (content-key v)])) x)\n    (set? x) (into #{} (map content-key) x)\n    :else x))\n\n\n(defn content=\n  \"Portable kind-strict decoded equality: two values are content= exactly\n   when content addressing would give them the same identity. Numbers must\n   share kind (integer, float64, decimal, rational), and within kind the\n   float zero sign, the decimal scale and the exact value; host integer\n   width is not significant, and canonical NaNs are equal (every NaN has\n   the one canonical encoding). Collections recurse the way equiv does,\n   metadata ignored. Unlike equiv, (content= 1 1.0) is false.\"\n(ns yin.vm.semantic.parity-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as walker]\n            [yin.vm.parity-test :as b0]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.values :as values]\n            [yin.vm.semantic :as sr]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.semantic.corpus :as corpus :refer [lit v lam app tail if-node def!]]\n            [yin.vm.semantic.linearize :as sr-linearize]))\n\n\n(def slice-4a-mnemonics\n  #{:const :var :closure :jump :branch-false :define :gensym :store-get\n    :store-put :halt :return :call})\n\n\n(defn slice-4a-eligible?\n  [ast]\n  (every? #(contains? slice-4a-mnemonics (nth % 0))\n          (:vector (sr-linearize/project ast))))\n\n\n(defn trace-normalize\n  [value]\n  (cond\n    (values/continuation? value) :continuation\n    (values/host-typed? value) (trace-normalize (values/payload value))\n    (and (map? value) (= :closure (:type value))) {:type :closure :params (:params value)}\n    (and (map? value) (contains? #{:stream-ref :cursor-ref} (:type value)))\n    (select-keys value [:type :id])\n    (fn? value) :host-fn\n    (map? value) (into {} (map (fn [[k v]] [(trace-normalize k) (trace-normalize v)]) value))\n    (vector? value) (mapv trace-normalize value)\n    (set? value) (into #{} (map trace-normalize value))\n    (seq? value) (mapv trace-normalize value)\n    :else value))\n\n\n(defn register-machine\n  ([ast] (register-machine ast {}))\n  ([ast opts]\n   (sr/load-vector (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret} opts))\n                   (:vector (sr-linearize/project ast)) code/contract)))\n\n\n(defn walker-machine\n  [ast]\n  (walker/vm-load-rows (tu/create-vm) (vm/ast->semantic-bytecode ast) vm/ast-contract))\n\n\n(defn outcome\n  [machine]\n  (try (let [result (vm/run machine)]\n         {:value (trace-normalize (vm/value result)) :halted? (vm/halted? result)\n          :blocked? (vm/blocked? result) :store (trace-normalize (vm/store result))})\n       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n         {:error (ex-message e)})))\n\n\n(defn then\n  [a b]\n  (corpus/app (corpus/lam '[ignored] b) a))\n\n\n;; Respelled from rule-r-test/definition-programs, which is private.\n(def definition-programs\n  [[\"define then read\" (then (corpus/def! 'x (corpus/lit 1))\n                             (corpus/def! 'y (corpus/app (corpus/v '+) (corpus/v 'x) (corpus/lit 1)))) 2 {'x 1 'y 2}]\n   [\"redefine x twice reads the second value\"\n    (then (corpus/def! 'x (corpus/lit 1)) (then (corpus/def! 'x (corpus/lit 2)) (corpus/v 'x))) 2 {'x 2}]\n   [\"a definition's value is its own value\" (corpus/def! 'z (corpus/lit 9)) 9 {'z 9}]\n   [\"a stored closure is called by name\"\n    (then (corpus/def! 'f (corpus/lam '[n] (corpus/app (corpus/v '*) (corpus/v 'n) (corpus/lit 2))))\n          (then (corpus/def! 'r (corpus/app (corpus/v 'f) (corpus/lit 5))) (corpus/v 'r))) 10 {'r 10}]\n   [\"the reserved symbol as a literal value is data\" (corpus/def! 'q (corpus/lit 'yin/def)) 'yin/def {'q 'yin/def}]])\n\n\n(deftest b0-values\n  (let [rows b0/corpus]\n    (is (= 26 (count rows)))\n    (doseq [[label ast expected] rows]\n      (testing label\n        (doseq [machine [(register-machine ast) (walker-machine ast)]]\n          (let [result (vm/run machine)]\n            (is (= (trace-normalize expected) (trace-normalize (vm/value result))))\n            (is (vm/halted? result))))))))\n\n\n(deftest corpus-outcomes\n  (let [rows corpus/programs]\n    (is (= 32 (count rows)))\n    (doseq [[label ast] rows]\n      (testing label (is (= (outcome (walker-machine ast)) (outcome (register-machine ast))))))))\n\n\n(deftest rule-r-definitions\n  (is (= 5 (count definition-programs)))\n  (doseq [[label ast expected slice] definition-programs]\n    (testing label\n      (is (slice-4a-eligible? ast))\n      (doseq [machine [(register-machine ast) (walker-machine ast)]]\n        (let [result (vm/run machine)]\n          (is (= expected (vm/value result)))\n          (is (= slice (select-keys (vm/store result) (keys slice)))))))))\n\n\n;; Slice-4a extras stay separate from the phase-3 corpus and its pinned addresses.\n(def slice-4a-extra-rows\n  [[:parameter-shadowing\n    (corpus/app (corpus/lam '[x]\n                            (corpus/app (corpus/lam '[x] (corpus/v 'x)) (corpus/lit 2)))\n                (corpus/lit 1))\n    2]\n   [:caller-env-after-return\n    (corpus/app (corpus/lam '[x]\n                            (corpus/app (corpus/v 'list)\n                                        (corpus/app (corpus/lam '[x] (corpus/lit 2)) (corpus/lit 9))\n                                        (corpus/v 'x)))\n                (corpus/lit 1))\n    '(2 1)]])\n\n\n(deftest extra-row-values\n  (is (= 2 (count slice-4a-extra-rows)))\n  (doseq [[label ast expected] slice-4a-extra-rows]\n    (testing label\n      (is (slice-4a-eligible? ast))\n      (let [walker (vm/run (walker/vm-load-rows (tu/create-vm {:env {'list list}})\n                                                (vm/ast->semantic-bytecode ast) vm/ast-contract))\n            register (vm/run (register-machine ast {:env {'list list}}))]\n        (doseq [result [walker register]]\n          (is (= expected (vm/value result)))\n          (is (= (trace-normalize expected) (trace-normalize (vm/value result))))\n          (is (vm/halted? result)))\n        (is (= (trace-normalize (vm/value walker))\n               (trace-normalize (vm/value register))))))))\n\n\n(def capture {:type :vm/current-continuation})\n\n\n(defn with-k\n  [body]\n  (app (lam '[r] body) capture))\n\n\n;; The five reviewed continuation programs; arity-two is checked separately.\n(def continuation-programs\n  [[:escape (app (v '+)\n                 (lit 1)\n                 (with-k (if-node (app (v '=) (v 'r) (lit 7))\n                                  (app (v '+) (v 'r) (lit 1))\n                                  (app (v '+)\n                                       (lit 1000)\n                                       (app (v 'r) (lit 7)))))) 9]\n   [:tail-invoke (app (v '+)\n                      (lit 1)\n                      (with-k (if-node (app (v '=) (v 'r) (lit 7))\n                                       (v 'r)\n                                       (tail (app (v 'r) (lit 7)))))) 8]\n   [:re-entry (then\n                (def! 'count (lit 0))\n                (app (lam ['x]\n                          (then (if-node (app (v '=) (v 'count) (lit 0))\n                                         (def! 'saved (v 'x))\n                                         (lit nil))\n                                (if-node (app (v '<) (v 'count) (lit 3))\n                                         (then (def! 'count\n                                                 (app (v '+) (v 'count) (lit 1)))\n                                               (app (v 'saved)\n                                                    (app (v '*)\n                                                         (lit 10)\n                                                         (v 'count))))\n                                         (app (v 'conj)\n                                              (app (v 'conj) (lit []) (v 'x))\n                                              (v 'count)))))\n                     (app (lam [] capture)))) [30 3]]\n   [:store-after-invoke (with-k (if-node (app (v '=) (v 'r) (lit 1))\n                                         (app (v 'conj)\n                                              (app (v 'conj) (lit []) (v 'r))\n                                              (v 'mark))\n                                         (then (def! 'mark (lit :written))\n                                               (app (v 'r) (lit 1))))) [1 :written]]\n   [:arity-zero (with-k (if-node (app (v '=) (v 'r) (lit 1))\n                                 (v 'r)\n                                 (apply app (v 'r)\n                                        (repeat 0 (lit 1))))) [:thrown \"Continuation expects exactly one argument\"]]])\n\n\n(defn continuation-outcome\n  [machine]\n  (try\n    (loop [machine machine steps 0]\n      (cond\n        (vm/halted? machine) (outcome machine)\n        (vm/blocked? machine) {:error \"Continuation parity test blocked\"}\n        (= steps 10000) {:error \"Continuation parity step bound exhausted\"}\n        :else (recur (vm/step machine) (inc steps))))\n    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n      {:error (ex-message e)})))\n\n\n(deftest continuation-outcomes\n  (is (= 5 (count continuation-programs)))\n  (doseq [[label ast expected] continuation-programs]\n    (testing label\n      (let [w (continuation-outcome (walker-machine ast)) r (continuation-outcome (register-machine ast))]\n        (is (= w r))\n        (if (and (vector? expected) (= :thrown (first expected)))\n          (is (= (second expected) (:error r)))\n          (is (= expected (:value r))))))))\n\n\n(deftest ffi-round-trip-parity\n  (let [ast {:type :dao.stream.apply/call :op :op/echo :operands [(lit 42)]}\n        run (fn [register?]\n              (let [seen (atom []) opts {:bridge {:op/echo (fn [x] (swap! seen conj x) x)}}\n                    machine (if register? (register-machine ast opts)\n                                (walker/vm-load-rows (tu/create-vm opts) (vm/ast->semantic-bytecode ast) vm/ast-contract))]\n                [(outcome machine) @seen]))]\n    (is (= (run false) (run true)))\n    (is (= 42 (get-in (run true) [0 :value])))\n    (is (= [42] (second (run true))))))\n\n\n(deftest stream-run-parity\n  (doseq [register? [false true]]\n    (let [load (fn [machine ast]\n                 (if register? (sr/load-ast machine (vm/ast->datoms ast) vm/ast-contract)\n                     (walker/vm-load-rows machine (vm/ast->semantic-bytecode ast) vm/ast-contract)))\n          base (if register? (register-machine {:type :stream/make :buffer 4})\n                   (walker-machine {:type :stream/make :buffer 4}))\n          made (vm/run base) s (vm/value made)\n          read {:type :stream/next :source {:type :stream/cursor :source (lit s)}}\n          blocked (vm/run (load made read))\n          put (vm/run (load made {:type :stream/put :target (lit s) :val (lit 99)}))\n          got (vm/run (load put read))\n          closed (vm/run (load got {:type :stream/close :source (lit s)}))]\n      (is (vm/blocked? blocked))\n      (is (= :yin/blocked (vm/value blocked)))\n      (is (= 99 (vm/value put)))\n      (is (= 99 (vm/value got)))\n      (is (nil? (vm/value closed)))\n      (is (vm/halted? closed)))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' test/yin/vm/debruijn_code_test.cljc; sed -n '1,110p' test/yin/vm/debruijn_register_code_test.cljc; sed -n '1,130p' test/yin/vm/ucf/rows_test.cljc; sed -n '1035,1145p' test/yin/vm/semantic/safepoint_harness_test.cljc; cat test/yin/vm/malformed_rows.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' test/yin/vm/debruijn_code_test.cljc; sed -n '1,110p' test/yin/vm/debruijn_register_code_test.cljc; sed -n '1,130p' test/yin/vm/ucf/rows_test.cljc; sed -n '1035,1145p' test/yin/vm/semantic/safepoint_harness_test.cljc; cat test/yin/vm/malformed_rows.cljc\"","aggregated_output":"(ns yin.vm.debruijn-code-test\n  \"B1 (docs/design/yin.vm.debruijn.stack.md S2): standalone tests of the\n   `:yin.debruijn.code/*` dimension and its validator -- hand-built\n   canonical instruction vectors, plus the retained B0 normalization\n   contract and execution fixtures. Golden\n   bytes and H values are pinned literals, computed once against this\n   file's own encoding and checked on every host lane this test file\n   compiles for; a later change to the opcode table, the scalar tag\n   order, or the framing byte rules must fail these fixtures rather than\n   silently forking H (verified manually during development: a one-line\n   reorder of `scalar-classes` was tried and reverted, and it broke every\n   golden fixture below -- see the final report).\"\n  (:require [clojure.set :as set]\n            [clojure.test :refer [deftest is testing]]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as ast-walker]\n            [yin.vm.parity-test :as parity]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm-test :as vm-test]\n            [yin.vm.debruijn-code :as dc]))\n\n\n;; =============================================================================\n;; Malformed rows are rejected\n;; =============================================================================\n\n(deftest malformed-rows-are-rejected\n  (testing \"an empty vector\"\n    (is (= {:rule :nonempty, :pc 0} (dc/image-defect []))))\n  (testing \"an unknown mnemonic\"\n    (is (= {:rule :mnemonic, :pc 0} (dc/image-defect [[:nope] [:return]]))))\n  (testing \"wrong arity (:const takes exactly one operand)\"\n    (is (= {:rule :arity, :pc 0} (dc/image-defect [[:const 1 2] [:return]]))))\n  (testing \"wrong operand kind (:gensym's prefix is :str)\"\n    (is (= {:rule :operand-kind, :pc 0} (dc/image-defect [[:gensym 5] [:return]]))))\n  (testing \"an unsaturated operand (:gensym's prefix may not be nil)\"\n    (is (= {:rule :saturation, :pc 0} (dc/image-defect [[:gensym nil] [:return]]))))\n  (testing \"a block that does not end in a terminator\"\n    (is (= {:rule :terminator, :pc 0} (dc/image-defect [[:const 1]]))))\n  (testing \"a shape-valid vector is accepted\"\n    (is (nil? (dc/image-defect [[:const 1] [:return]])))))\n\n\n;; =============================================================================\n;; Out-of-range bound operands are rejected\n;; =============================================================================\n\n(deftest out-of-range-bound-operands-are-rejected\n  (testing \"a dangling :jump target\"\n    (is (= {:rule :target-bounds, :pc 0} (dc/image-defect [[:jump 5] [:return]]))))\n  (testing \"a dangling :closure body\"\n    (is (= {:rule :target-bounds, :pc 0} (dc/image-defect [[:closure 1 9] [:return]]))))\n  (testing \"the design's own [5 0] case: depth 5 past a one-level chain\"\n    (let [image [[:closure 1 3] [:push] [:return] [:load-bound 5 0] [:return]]]\n      (is (nil? (dc/well-formed-image? image))\n          \"shape-valid on its own -- the generic structural rules alone accept it\")\n      (is (= {:rule :scope, :pc 3} (dc/image-defect image))\n          \"the scope rule rejects it before execution\")))\n  (testing \"position out of range for the enclosing arity\"\n    (let [image [[:closure 1 2] [:return] [:load-bound 0 3] [:return]]]\n      (is (= {:rule :scope, :pc 2} (dc/image-defect image)))))\n  (testing \"a negative depth or position\"\n    (is (= {:rule :operand-kind, :pc 2}\n           (dc/image-defect [[:closure 1 2] [:return] [:load-bound -1 0] [:return]]))\n        \"a negative :uint operand is already rejected by the generic shape rule\"))\n  (testing \"a valid bound reference at depth 0 is accepted\"\n    (is (nil? (dc/image-defect [[:closure 1 2] [:return] [:load-bound 0 0] [:return]]))))\n  (testing \"nested closures: depth counts frames outward through the chain\"\n    ;; outer closure arity 2 (body at pc 2), inner closure arity 1 (body at\n    ;; pc 5); the inner body's depth 1 reaches the outer frame's position 1\n    (let [image [[:closure 2 2]                     ; pc 0\n                 [:return]                            ; pc 1\n                 [:closure 1 5]                        ; pc 2 (outer body)\n                 [:push]                                ; pc 3\n                 [:return]                              ; pc 4\n                 [:load-bound 1 1]                       ; pc 5 (inner body)\n                 [:return]]]                             ; pc 6\n      (is (nil? (dc/image-defect image)) \"depth 1 reaches the outer frame\")\n      (is (= {:rule :scope, :pc 5}\n             (dc/image-defect (assoc image 5 [:load-bound 2 0])))\n          \"depth 2 has no third enclosing frame\"))))\n\n\n;; =============================================================================\n;; Two closures declaring different arities for one body pc are rejected\n;; (debruijn-b1-fix P1-2): the reviewer's exact fixture, in both\n;; declaration orders, proving the fix does not just pick one winner by\n;; walk order but rejects the conflict itself.\n;; =============================================================================\n\n(deftest conflicting-body-declarations-are-rejected\n  (testing \"arity-2 declared first, arity-1 second\"\n    (is (= {:rule :scope-conflict, :pc 3}\n           (dc/image-defect [[:closure 2 3] [:closure 1 3] [:return]\n                             [:load-bound 0 1] [:return]]))))\n  (testing \"the same fixture with the two :closure instructions swapped\"\n    (is (= {:rule :scope-conflict, :pc 3}\n           (dc/image-defect [[:closure 1 3] [:closure 2 3] [:return]\n                             [:load-bound 0 1] [:return]]))\n        \"rejected either way -- not just when the smaller arity is walked first\")))\n\n\n;; =============================================================================\n;; Exact scalar spelling is preserved through encode/hash\n;; =============================================================================\n\n(def ^:private const-return\n  \"One :const value framed by a single :return -- the minimal carrier for\n   every scalar-spelling fixture below.\"\n  (fn [v] [[:const v] [:return]]))\n\n\n(deftest exact-scalar-spelling-is-preserved\n  ;; 1 vs 1.0 is its own JVM/Dart-only test below\n  ;; (`one-vs-one-point-zero-distinct-on-jvm-and-dart`): a JS number\n  ;; carries no long/double provenance of its own once it is integral, so\n  ;; CLJS cannot hold that distinction (S2 item 4) and is excluded here.\n  (testing \"composed and decomposed e-acute hash to distinct values (no NFC)\"\n    (let [composed (const-return \"é\")\n          decomposed (const-return \"é\")]\n      (is (not= composed decomposed) \"the two strings are not even = as data\")\n      (is (not= (dc/image-hash composed) (dc/image-hash decomposed))\n          \"and their images hash distinctly, proving no NFC silently unified them\")))\n  (testing \"exact UTF-8 bytes: a string's encoded content is the string itself, unmodified\"\n    (is (= \"0700000005hello\" (dc/encode-scalar \"hello\")))))\n\n\n;; =============================================================================\n;; A ratio fixture: encoded on the JVM, refused where there is no ratio type.\n;; Dart joins CLJS here (`host-ratio?`): ClojureDart has no ratio type and\n;; no `numerator`/`denominator`, so a `1/2` literal is not even reader-safe\n;; outside the :clj branch (S2 item 5's own comment on this, below).\n;; =============================================================================\n\n(deftest ratio-fixture\n  (testing \"the JVM choice: ratio has its own scalar class and encodes\"\n    #?(:clj\n       (do\n         (is (= :ratio (dc/scalar-class 1/2)))\n(ns yin.vm.debruijn-register-code-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [yin.vm.parity-test :as parity]\n            [yin.vm.semantic.corpus :refer [lit if-node]]\n            [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [yin.vm.debruijn-register-code :as rcode]))\n\n\n(deftest golden-descriptor-hash-test\n  (is (= \"aa757659a28f9787e44cd04d02d9f4412eba1088d46a1b07adf9fa820d07e74c\"\n         rcode/descriptor-hash)))\n\n\n;; Register contract facts retained through projected semantic vectors.\n\n\n;; =============================================================================\n;; 1. The register descriptor's contract version\n;; =============================================================================\n\n(def register-contract-version\n  \"4, the version of the `:yin.debruijn.register/*` descriptor's\n   contract (the \\\"r2\\\" contract, Rule R's `:define`). Bumped only when\n   register opcode shape, allocation, scalar framing, or control-flow\n   rules change.\"\n  4)\n\n\n(deftest register-contract-version-is-a-frozen-positive-integer\n  (is (integer? register-contract-version))\n  (is (pos? register-contract-version))\n  (is (= 4 register-contract-version) \"Rule R version\"))\n\n\n;; =============================================================================\n;; 2. The operand mapping (design section 4.4)\n;; =============================================================================\n;; Frozen vocabulary from the original register operand-mapping contract.\n\n(def resolver-node-type-vocabulary\n  \"The original register contract vocabulary; preserved as a format fact.\"\n  #{:literal :variable :lambda :application :dao.stream.apply/call :if\n    :vm/gensym :vm/store-get :vm/store-put :stream/make :stream/put\n    :stream/cursor :stream/next :stream/close :vm/park\n    :vm/current-continuation :vm/resume})\n\n\n(def register-instruction-mnemonics\n  \"Section 4.4's register instruction set, as data, so the operand\n   mapping below can be checked against it without hand-copying mnemonic\n   spellings into each entry's assertion.\"\n  #{:const :load-bound :load-free :closure :move :call :branch-false\n    :jump :return :halt :store-get :store-put :gensym :stream-make\n    :stream-put :stream-cursor :stream-next :stream-close :ffi-call\n    :current-continuation :park :resume})\n\n\n(def node-type->register-mapping\n  \"For every resolved-tuple node type in `resolver-node-type-vocabulary`,\n   which register instruction shape from section 4.4's table it maps to.\n   `:variable` carries two shapes under one key because its register\n   mapping depends on the resolution it already carries (bound vs free),\n   not on its node type alone.\"\n  {:literal\n   {:register-instructions [:const], :shape \"[op rd value]\"}\n\n   :variable\n   {:register-instructions [:load-bound :load-free]\n    :bound {:instruction :load-bound, :shape \"[op rd depth position]\"}\n    :free {:instruction :load-free, :shape \"[op rd name]\"}}\n\n   :lambda\n   {:register-instructions [:closure], :shape \"[op rd arity body-pc]\"}\n\n   :application\n   {:register-instructions [:call]\n    :shape \"[op rd fn-reg arg-regs tail? live]\"}\n\n   :if\n   {:register-instructions [:branch-false :jump]\n    :shape \"[op cond-reg target] then [op target]; both arms write the\n             expression's one destination register (design section 4.3)\"}\n\n   :dao.stream.apply/call\n   {:register-instructions [:ffi-call]\n    :shape \"[op rd ffi-op arg-regs live]\"}\n\n   :stream/make\n   {:register-instructions [:stream-make], :shape \"[op rd capacity]\"}\n\n   :stream/put\n   {:register-instructions [:stream-put]\n    :shape \"[op rd stream-reg value-reg live]\"}\n\n   :stream/cursor\n   {:register-instructions [:stream-cursor], :shape \"[op rd stream-reg]\"}\n\n   :stream/next\n   {:register-instructions [:stream-next]\n    :shape \"[op rd cursor-reg live]\"}\n\n   :stream/close\n   {:register-instructions [:stream-close], :shape \"[op rd stream-reg]\"}\n\n   :vm/gensym\n   {:register-instructions [:gensym], :shape \"[op rd prefix]\"}\n\n   :vm/store-get\n   {:register-instructions [:store-get], :shape \"[op rd key]\"}\n(ns yin.vm.ucf.rows-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yang.python.antlr.int-contract-fixtures :as ints]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]\n            [yin.vm.ucf.rows-support :as support]\n            [dao.test-slow :as slow]\n            [yin.vm.semantic.frame-test :as ft]\n            [yin.vm.values :as values]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.rows :as rows]))\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n(defn task-node\n  [cursor-cells result]\n  (rows/node :task [3 rows/profile :halted :root 0 (rows/node :bindings [])\n                    (rows/node :store []) [] (rows/node :parked-table [])\n                    (rows/node :cursor-cells (mapcat identity cursor-cells)) {} {} [] [] nil result nil]))\n\n\n(defn cursor-cell-body\n  [stream position]\n  (rows/node :cursor-cell-body [(rows/node :stream [stream {:peer stream}]) position]))\n\n\n(defn fixture\n  [a b x y]\n  (let [payload [:row (rows/node :map\n                                 [[:lit 'both] [:row (rows/node :set [[:cursor-cell x] [:cursor-cell y]])]\n                                  [:lit 'one] [:cursor-cell x]\n                                  [:lit 'streams] [:row (rows/node :set [[:row (rows/node :stream [a {:peer a}])]\n                                                                         [:row (rows/node :stream [b {:peer b}])]])]\n                                  [:lit 'cursors] [:row (rows/node :map [[:cursor-cell x] [:lit :x] [:cursor-cell y] [:lit :y]])]])]\n        task (task-node [[x (cursor-cell-body a 0)] [y (cursor-cell-body b 0)]] [:lit nil])]\n    (rows/node :task (assoc (:slots task) 6 (rows/node :store ['payload payload])))))\n\n\n(declare portable-frame)\n\n\n(defn- encoded\n  [x]\n  (cond (and (map? x) (contains? x :yin.k/row)) [:row (:yin.k/row x)]\n        (and (map? x) (contains? x :yin.k/cursor-cell)) [:cursor-cell (:yin.k/cursor-cell x)]\n        :else [:lit x]))\n\n\n(defn- portable-value\n  [m x]\n  ;; Classify native test values into the decoded codec domain. No seals\n  ;; travel. Captures retain their entire act and K; closures retain the\n  ;; code address, binders, lexical bindings and module context.\n  (cond\n    (values/continuation? x)\n    {:yin.k/row (rows/node :reified\n                           [(rows/decode (rows/frame->rows\n                                           (portable-frame m (ft/canonical m (values/payload x) false)) encoded))])}\n    (values/closure? x)\n    (let [p (values/payload x) e (:env p)]\n      {:yin.k/row (rows/node :closure [(get-in m [:code (:segment p) :address]) (:entry p) (:params p)\n                                       (rows/node :bindings\n                                                  (mapcat (fn [[k v]] [k (encoded (portable-value m v))])\n                                                          (sort #(cbor/encoded-compare (first %1) (first %2))\n                                                                (engine/without-store-of e))))\n                                       (engine/env-store-of e)])})\n    (fn? x) {:yin.k/row (rows/node :prim ['fixture/primitive])}\n    (and (map? x) (= :cursor-ref (:type x))) {:yin.k/cursor-cell (:id x)}\n    (and (map? x) (= :stream-ref (:type x))) {:yin.k/row (rows/node :stream [(:id x) :fixture/served])}\n    (coll? x)\n    (let [kind (cond (map? x) :map (vector? x) :vec (set? x) :set :else :list)\n          xs (if (map? x) (mapcat identity x) x)\n          vs (mapv #(encoded (portable-value m %)) xs)]\n      (if (some #(not= :lit (first %)) vs)\n        {:yin.k/row (rows/node kind vs)}\n        x))\n    :else x))\n\n\n(defn portable-frame\n  [m f]\n  (let [bindings (fn [mappings] (into {} (map (fn [[k v]] [k (portable-value m v)])) mappings))\n        env #(update % :yin.k/bindings bindings)]\n    (cond-> (update f :yin.k/k #(mapv (fn [k]\n                                        (-> k (update :yin.k/env env)\n                                            (update :yin.k/window bindings))) %))\n      (= :act (:yin.k/state f)) (update :yin.k/env env)\n      (= :act (:yin.k/state f)) (update :yin.k/window bindings)\n      (contains? f :yin.k/pending) (update :yin.k/pending #(case (:yin.k/reason %)\n                                                             :next (assoc % :yin.k/cursor-cell :test/cursor)\n                                                             :put (assoc % :yin.k/stream (rows/node :stream [:fixture/w :fixture/served])\n                                                                         :yin.k/value \"v\" :yin.k/op-id nil) %)))))\n\n\n(deftest bijection\n  (doseq [fixture (ft/reference-machines)\n          {:keys [frame]} (ft/reference-frames fixture)]\n    (let [f (portable-frame (:machine fixture) frame) wire (rows/frame->rows f encoded) back (rows/rows->frame wire)]\n      (is (= f back))\n      (is (= (:yin.k/root wire) (:yin.k/root (rows/frame->rows back encoded)))))))\n\n\n(deftest row-ids-are-jing-default\n  (let [wire (rows/emit (fixture :stream/a :stream/b :source/x :source/y))]\n    (is (seq (:yin.k/rows wire)))\n    (doseq [[id & body] (:yin.k/rows wire)]\n      (is (= id (jing/segment-key (vec body))))\n      (is (= :blake3 (:algorithm (jing/parse-segment-address id)))))))\n\n\n(deftest carrier-row-algorithm-is-part-of-the-profile\n  (let [wire (rows/emit (task-node [] [:lit nil]))\n        root (:yin.k/root wire)\n        body (subvec (first (filter #(= root (first %)) (:yin.k/rows wire))) 1)\n        sha (jing/segment-key body {:algorithm :sha256})\n        foreign (-> wire\n                    (assoc :yin.k/root sha)\n                    (update :yin.k/rows #(mapv (fn [r] (if (= root (first r)) (assoc r 0 sha) r)) %)))\n        refusal (error #(rows/decode foreign))]\n    (is (jing/segment-matches? sha body))\n    (is (= :task (:kind (rows/decode wire))))\n    (is (= :yin.k/undecodable (:yin.k/status refusal)))\n      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches)))))\n\n\n;; =============================================================================\n;; Acceptance 8: the two ported tests\n;; =============================================================================\n\n(defn parked-reader\n  []\n  (let [m0 (vm/run (load-program (machine) (with-stream (s/then read-op read-op))))\n        src (s/stream-of m0)]\n    (stream/append! src \"A\")\n    [(vm/run m0) src]))\n\n\n(deftest a-nonempty-ready-queue-is-not-quiescent\n  (let [[parked src] (parked-reader)\n        _ (stream/append! src \"B\")\n        woken (engine/check-wait-set parked)\n        n (atom 0)\n        {:keys [serve!]} (served #{:reader})\n        d (error #(rows/lift-task woken (fn [h] (swap! n inc) (serve! h)) (lift-opts)))]\n    (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n    (is (= :yin.k/not-quiescent (:yin.k/status d)) (pr-str d))\n    (is (zero? @n) \"no stream was served\")))\n\n\n(defn two-callers\n  []\n  (let [call-in (s/ring 8) call-out (s/ring 8)\n        m (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                          :call-out-cursor (vm/mint-oldest call-out :test)})\n                                (s/then (s/call-node :op/echo \"hello\") (s/call-node :op/echo \"world\"))))\n        e1 (first (:wait-set m))]\n    [(assoc m :wait-set [e1 (assoc e1 :call-id :parked-9)]) call-out (:call-id e1)]))\n\n\n(defn answer-both!\n  [call-out first-id]\n  (stream/append! call-out (apply2/success-response :parked-9 \"second\"))\n  (stream/append! call-out (apply2/success-response first-id \"first\")))\n\n\n(defn sweep\n  [m peers]\n  (loop [m (engine/check-wait-set m) n 12]\n    (if (or (zero? n) (empty? (:wait-set m)))\n      m\n      (do (run! s/serve-mirror! peers) (recur (engine/check-wait-set m) (dec n))))))\n\n\n(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n  (let [[ref-m ref-out id] (two-callers)\n        _ (answer-both! ref-out id)\n        expected (mapv :value (:ready-queue (sweep ref-m [])))\n        [m call-out id] (two-callers)\n        {:keys [serve! toy peer]} (served #{:reader})\n        wire (rows/lift-task m serve! (lift-opts))\n        task (root-task wire)\n        pendings (mapv #(second (:slots %)) (slot task 13))\n        own-out (s/ring 8)\n        {:keys [attach!] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine {:attach-stream attach! :call-in (s/ring 8) :call-out own-out\n                                        :call-out-cursor (vm/mint-oldest own-out :test)})\n                              wire attach!)\n        [w1 w2] (:wait-set recv)\n        _ (answer-both! call-out id)\n        swept (sweep recv [peer])]\n    (is (= [:ffi :ffi] (mapv #(first (:slots %)) pendings)))\n    (is (= [id :parked-9] (mapv #(nth (:slots %) 2) pendings)))\n    (is (= 1 (quot (count (:slots (slot task 9))) 2)) \"the two waiters name one cursor cell\")\n    (is (= (nth (:slots (first pendings)) 1) (nth (:slots (second pendings)) 1)))\n    (is (= (:cursor-ref w1) (:cursor-ref w2)) \"the lower gives both waiters one fresh cursor entry\")\n    (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity\")\n    (is (= [(apply2/success-response :parked-9 \"second\") (apply2/success-response id \"first\")] expected))\n    (is (empty? (:wait-set swept)))\n    (is (= expected (mapv :value (:ready-queue swept)))\n        \"the receiver wakes the same waiters with the same responses\")))\n\n\n(deftest act-ffi-bookkeeping\n  ;; Row 24: row 3's bookkeeping record travels in the parked table under\n  ;; its call id, and the validator accepts it in context :parked.\n  (let [world (bare 24)\n        {:keys [serve!]} (served #{:reader})\n        task (root-task (rows/lift-task (:machine world) serve! (lift-opts)))\n        [p state] (:slots (slot task 8))]\n    (is (= (:call-id world) p))\n    (is (= :act (:kind state)))\n    (is (= [:ffi (:call-id world)] [(first (:slots (first-pending task))) (nth (:slots (first-pending task)) 2)]))\n    (is (nil? (rows/validate-frames task)))))\n\n\n(deftest a-stream-shared-across-the-tree-attaches-once\n  ;; Row 10 with the link-request stream named from the root's store and\n  ;; from the install child's: one identity, reached by two tasks.\n  (let [m (:machine (bare 10))\n        child (get-in m [:installs 'host.mod :vm])\n        ref-in (fn [x] (engine/issue-ref x :stream-ref module/link-request-resource))\n        m (-> m\n              (update :store assoc 'rq (ref-in m))\n              (assoc-in [:installs 'host.mod :vm] (update child :store assoc 'rq (ref-in child))))\n        {:keys [serve! toy]} (served #{:reader :writer})\n        wire (rows/lift-task m serve! (lift-opts))\n        task (root-task wire)\n        {:keys [attach!] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n        lowered-child (get-in recv [:installs 'host.mod :vm])\n        handle (fn [x] (get (:resources x) (:id (get-in x [:store 'rq]))))]\n    (is (< (count (stream-identities wire)) (stream-occurrences task)) \"the tree reaches one identity twice\")\n(ns yin.vm.malformed-rows\n  \"The §7.4/§7.5 published sets: malformed row sets and malformed canonical\n   instruction vectors, one per rule, for §7.2 part 3's same-refusal\n   conformance.\"\n  (:require [dao.jing :as jing]))\n\n\n(defn- valid-row\n  [body]\n  (let [id (jing/segment-key body)]\n    [id (into [id] body)]))\n\n\n(defn- one-row-bc\n  [body]\n  (let [[id row] (valid-row body)]\n    {:root id, :rows {id row}}))\n\n\n(def ^:private fake-address-a (keyword \"segment\" (str \"sha256-\" (apply str (repeat 64 \"a\")))))\n(def ^:private fake-address-b (keyword \"segment\" (str \"sha256-\" (apply str (repeat 64 \"b\")))))\n\n\n(def malformed-row-sets\n  \"`{name [expected-defect bc]}`, one `{:root :rows}` value per §7.4 rule.\"\n  (let [[missing-id] (valid-row [:literal 999])\n        [lit1-id lit1-row] (valid-row [:literal 1])\n        [lit2-id lit2-row] (valid-row [:literal 2])]\n    {:tag [{:rule :tag, :path []} (one-row-bc [:not-a-tag])]\n     :arity [{:rule :arity, :path []} (one-row-bc [:literal 1 2])]\n     :slot-kind-str [{:rule :slot-kind, :path [1]} (one-row-bc [:vm/gensym :not-a-string])]\n     :slot-kind-node [{:rule :slot-kind, :path [1]} (one-row-bc [:stream/next 123])]\n     :slot-kind-nodes [{:rule :slot-kind, :path [2]} (one-row-bc [:application fake-address-a :not-a-vector false])]\n     ;; a host function has no content address (dao.jing's canonical\n     ;; encoding refuses it), so this row sits at a fake one: `:slot-kind`\n     ;; is structural and never consults the address\n     :slot-kind-data [{:rule :slot-kind, :path [2]}\n                      {:root fake-address-a,\n                       :rows {fake-address-a\n                              [fake-address-a :vm/store-put :key-ok (fn [])]}}]\n     :slot-kind-sym [{:rule :slot-kind, :path [1]} (one-row-bc [:variable \"not-a-sym\"])]\n     :slot-kind-kw [{:rule :slot-kind, :path [1]} (one-row-bc [:vm/resume \"not-a-kw\" fake-address-a])]\n     :slot-kind-int [{:rule :slot-kind, :path [1]} (one-row-bc [:stream/make :not-int])]\n     :saturation [{:rule :saturation, :path [1]} (one-row-bc [:vm/gensym nil])]\n     :id-resolves [{:rule :id-resolves, :path [1]} (one-row-bc [:application missing-id [] false])]\n     :acyclic [{:rule :acyclic, :path []}\n               {:root fake-address-a,\n                :rows {fake-address-a [fake-address-a :stream/cursor fake-address-b],\n                       fake-address-b [fake-address-b :stream/cursor fake-address-a]}}]\n     :root-reachable [{:rule :root-reachable, :id lit2-id}\n                      {:root lit1-id, :rows {lit1-id lit1-row, lit2-id lit2-row}}]}))\n\n\n(def malformed-vectors\n  \"`{name [expected-defect vector]}`, one canonical instruction vector per\n   §7.5 rule (a rule with several judged kinds or encodings has several\n   entries). The `[[:jump 9]]` entry is correctly hashed — its address is\n   `(jing/segment-key [[:jump 9]])`, exactly the content hash of what it\n   is — and refused anyway: a correct hash is never structural\n   validation. The list-encoding entries pin the canonical positional\n   form (UCF §7.3.2): the outer sequence and every tuple are vectors.\"\n  {:nonempty [{:rule :nonempty, :pc 0} []]\n   :nonempty-outer-list [{:rule :nonempty, :pc 0} '([:halt])]\n   :mnemonic [{:rule :mnemonic, :pc 0} [[:frobnicate]]]\n   :mnemonic-inner-list [{:rule :mnemonic, :pc 0} '[(:halt)]]\n   :arity [{:rule :arity, :pc 0} [[:const 1 2] [:halt]]]\n   :operand-kind [{:rule :operand-kind, :pc 0} [[:var \"not-a-sym\"] [:halt]]]\n   :operand-kind-bool [{:rule :operand-kind, :pc 0} [[:call 0 :truthy] [:halt]]]\n   :operand-kind-buffer [{:rule :operand-kind, :pc 0} [[:stream-make :bad] [:halt]]]\n   :saturation [{:rule :saturation, :pc 0} [[:gensym nil] [:halt]]]\n   :target-bounds [{:rule :target-bounds, :pc 0} [[:jump 9]]]\n   :terminator [{:rule :terminator, :pc 0} [[:const 1]]]\n   :argc [{:rule :argc, :pc 0} [[:call -1 false] [:halt]]]})\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'params|binders|:syms|:closure|well-formed|load-image|load-vector' src/cljc/yin/vm/debruijn{_code,_register_code}.cljc | tail -65; sed -n '199,300p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '419,427p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '580,730p' test/yin/vm/semantic/safepoint_harness_test.cljc; rg -n 'numeric|nan-valued|duplicate' test/yin/vm/ucf/rows_test.cljc; rg -n 'G10|G12|G13|4.1|5. Doc' collab/1793430000000-architect-gap-list.report.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'params|binders|:syms|:closure|well-formed|load-image|load-vector' src/cljc/yin/vm/debruijn{_code,_register_code}.cljc | tail -65; sed -n '199,300p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '419,427p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '580,730p' test/yin/vm/semantic/safepoint_harness_test.cljc; rg -n 'numeric|nan-valued|duplicate' test/yin/vm/ucf/rows_test.cljc; rg -n 'G10|G12|G13|4.1|5. Doc' collab/1793430000000-architect-gap-list.report.md\"","aggregated_output":"src/cljc/yin/vm/debruijn_register_code.cljc:83:   :closure [[:yin.debruijn.register/rd :reg]\nsrc/cljc/yin/vm/debruijn_register_code.cljc:328:    (:const :load-bound :load-free :closure :move\nsrc/cljc/yin/vm/debruijn_register_code.cljc:483:   each out-of-line lambda body in discovery order). Every `:closure`\nsrc/cljc/yin/vm/debruijn_register_code.cljc:485:   and that body's `:locals` must equal the `:closure`'s own declared\nsrc/cljc/yin/vm/debruijn_register_code.cljc:512:                    (when (= :closure (mnemonic-of t))\nsrc/cljc/yin/vm/debruijn_register_code.cljc:517:                          (tuple-defect :closure-target pc)\nsrc/cljc/yin/vm/debruijn_register_code.cljc:519:                          (tuple-defect :closure-arity pc)\nsrc/cljc/yin/vm/debruijn_register_code.cljc:543:   run over it. `:closure` targets are a different operand (checked by\nsrc/cljc/yin/vm/debruijn_code.cljc:11:   (depth + position), `:load-free` (name), and `:closure` (arity + body\nsrc/cljc/yin/vm/debruijn_code.cljc:55:   :closure [[:yin.debruijn.code/arity :uint] [:yin.debruijn.code/body :pc]],\nsrc/cljc/yin/vm/debruijn_code.cljc:249:(defn- well-formed-utf16?\nsrc/cljc/yin/vm/debruijn_code.cljc:252:   well-formed-utf16?` enforces, independently written rather than\nsrc/cljc/yin/vm/debruijn_code.cljc:271:  (and (or (nil? (namespace x)) (well-formed-utf16? (namespace x)))\nsrc/cljc/yin/vm/debruijn_code.cljc:272:       (well-formed-utf16? (name x))))\nsrc/cljc/yin/vm/debruijn_code.cljc:366:    (string? v) (when (well-formed-utf16? v) :string)\nsrc/cljc/yin/vm/debruijn_code.cljc:416:   unpaired UTF-16 surrogate, which `well-formed-utf16?` already refuses\nsrc/cljc/yin/vm/debruijn_code.cljc:505:    ;; it gets the same well-formed-utf16? guard a :const string value\nsrc/cljc/yin/vm/debruijn_code.cljc:593:;; Two passes: generic structural well-formedness over this dimension's\nsrc/cljc/yin/vm/debruijn_code.cljc:650:   ;; a non-nil :str operand must also be well-formed UTF-16 (the same\nsrc/cljc/yin/vm/debruijn_code.cljc:654:   :str (fn [x] (or (nil? x) (and (string? x) (well-formed-utf16? x)))),\nsrc/cljc/yin/vm/debruijn_code.cljc:717:(defn well-formed-image?\nsrc/cljc/yin/vm/debruijn_code.cljc:718:  \"Generic structural well-formedness of one canonical instruction vector\nsrc/cljc/yin/vm/debruijn_code.cljc:742:   collecting the `[body-pc chain]` of every nested :closure this walk\nsrc/cljc/yin/vm/debruijn_code.cljc:743:   passes through -- a :closure instruction's own body is a different\nsrc/cljc/yin/vm/debruijn_code.cljc:745:   continues past the :closure instruction itself into the rest of this\nsrc/cljc/yin/vm/debruijn_code.cljc:750:   second :closure declaration -- stops the walk and reports that pc as\nsrc/cljc/yin/vm/debruijn_code.cljc:768:              nested' (if (= :closure op)\nsrc/cljc/yin/vm/debruijn_code.cljc:780:   :closure's declared body -- the S3 scope resolver's own data, built\nsrc/cljc/yin/vm/debruijn_code.cljc:786:   Two :closure instructions -- anywhere in the image, in either order,\nsrc/cljc/yin/vm/debruijn_code.cljc:810:  \"S3's second scope check, over and above `well-formed-image?`'s\nsrc/cljc/yin/vm/debruijn_code.cljc:816:   here even though `well-formed-image?` alone would accept it.\nsrc/cljc/yin/vm/debruijn_code.cljc:818:   Two :closure instructions declaring different arities for the same\nsrc/cljc/yin/vm/debruijn_code.cljc:865:  (or (well-formed-image? v) (reserved-defect v) (scope-defect v)))\n;; The corpus: four segments around one parking expression\n;; =============================================================================\n\n(defn cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn nest\n  [d op]\n  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n\n\n(def segments\n  \"[label wrap expected-of-bare-result] (§5.2).\"\n  [[:bare identity identity]\n   [:operand #(cat-of (s/lit [:operand]) %) (fn [r] [:operand r])]\n   [:depth-3 #(nest 3 %) (fn [r] [3 [2 [1 r]]])]\n   [:captured #(s/let1 'k (s/lit :captured)\n                       (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n                               (s/app (s/v 'f) (s/lit :arg))))\n    (fn [r] [:captured :arg r])]])\n\n\n(defn with-stream\n  [body]\n  (s/let1 's {:type :stream/make :buffer 4} (s/let1 'c (s/cursor-of (s/v 's)) body)))\n\n\n(defn tail\n  [ast]\n  (assoc ast :tail? true))\n\n\n(defn normalize\n  [x]\n  (cond\n    (values/continuation? x) :continuation\n    (values/closure? x) :closure\n    (vector? x) (mapv normalize x)\n    (seq? x) (apply list (map normalize x))\n    (set? x) (into #{} (map normalize) x)\n    (map? x) (into {} (map (fn [[k v]] [(normalize k) (normalize v)])) x)\n    :else x))\n\n\n;; =============================================================================\n;; The rows of §5.2: one builder each, answering the parked machine\n;; =============================================================================\n;;\n;; A world: :machine, :kind, :reason (blocked rows), :steps (each followed by\n;; a drive) or :resume, :finish (records the effect trace), :trace, and\n;; :receiver (fresh opts and a finish for the receiver's own composition).\n\n(defn reader\n  \"A reader parked on (next-of c); :pre values are appended and the\n   machine re-run first.\"\n  ([wrap op] (reader wrap op [] \"B\" {}))\n  ([wrap op pre value opts]\n   (let [m0 (vm/run (load-program (machine opts) (with-stream (with-cat (wrap op)))))\n         src (s/stream-of m0)\n         m (reduce (fn [m x] (stream/append! src x) (vm/run m)) m0 pre)]\n     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src value)] :trace (atom [])})))\n\n\n(defn writer\n  [wrap]\n  (let [trace (atom [])\n        w (s/one-slot-stream \"w\")\n        _ (stream/append! w :warmed)\n        m0 (load-program (machine) (with-cat (wrap {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")})))\n        [ref m1] (engine/attach-resource m0 w)\n        take! #(swap! trace conj (:dao.stream/value (stream/next w 0)))]\n    {:machine (vm/run (assoc m1 :store {'w ref})) :kind :blocked :reason :put :surfaces #{:reader :writer}\n     :steps [take!] :finish take! :trace trace}))\n\n\n(defn own-call-pair\n  [trace]\n  (let [own-in (s/ring 8) own-out (s/ring 8)]\n    {:opts {:call-in own-in :call-out own-out :call-out-cursor (vm/mint-oldest own-out :test)}\n     :finish #(swap! trace into (tu/drain own-in))}))\n\n\n(defn caller\n  [wrap call-in call-out]\n  (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                  :call-out-cursor (vm/mint-oldest call-out :test)})\n                        (with-cat (wrap (s/call-node :op/echo \"hello\"))))))\n\n\n(defn sent-ffi\n  [wrap]\n  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n        m (caller wrap call-in call-out)\n        id (ffi/response-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi :call-id id\n(defn parking\n  [m]\n  (let [pid (:id (vm/value m))]\n    {:machine m :kind :parked :pid pid :trace (atom [])\n     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n\n\n(defn module-store-cursors\n  \"An explicit park whose module store holds two cursor references nothing\n\n(defn stream-identities\n  \"The distinct stream identities of the whole carrier, install children\n   included: one row table serves the tree.\"\n  [wire]\n  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n\n\n(defn rows-in\n  \"Every row node the decoded tree x reaches, once per path.\"\n  [x]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots)) (cons x (rows-in (:slots x)))\n    (sequential? x) (mapcat rows-in x)\n    :else nil))\n\n\n(defn stream-occurrences\n  \"How many times the decoded tree reaches a :stream row.\"\n  [x]\n  (count (filter #(= :stream (:kind %)) (rows-in x))))\n\n\n(defn slot\n  [task i]\n  (nth (:slots task) i))\n\n\n(defn first-pending\n  [task]\n  (second (:slots (first (slot task 13)))))\n\n\n(defn laws\n  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n  [world expected]\n  (let [{:keys [wire relift corr corr2 attaches] :as got} (handed-off world)\n        task (root-task wire)]\n    (is (= (:kind world) (slot task 2)))\n    (is (= (count (stream-identities wire)) attaches) \"one attach per distinct stream identity\")\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n\n;; =============================================================================\n;; Acceptance 1: 89 runs\n;; =============================================================================\n\n(deftest ^:slow every-row-every-segment-matches-the-reference\n  (slow/guard\n    \"every-row-every-segment-matches-the-reference\"\n    (fn []\n      (let [cases (matrix-cases) runs (atom 0)]\n        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n        (doseq [[n label expected build] cases]\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (let [counted (atom [0 0])]\n    (doseq [[n r build] rows]\n      (testing (str \"row \" n)\n        (let [ref (reference (build identity))\n              {:keys [wire attaches]} (laws (build identity) ref)]\n          (when (some? r) (is (= r (:value ref))))\n          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n    ;; outside laws, so deleting its count assertion leaves one standing\n    (is (pos? (first @counted)) \"the corpus attaches streams\")\n    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n\n\n(deftest tail-states-carry-no-window\n  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n    (testing (str \"row \" label)\n      (let [{:keys [serve!]} (served #{:reader :writer})\n            wire (rows/lift-task (:machine world) serve! (lift-opts))\n            state (wait-state wire)\n            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n        (is (= :tail (:kind state)))\n        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n        (is (= 5 (count row)) \"[id :tail A site k]\")\n        (is (not-any? #(= :window (second %))\n                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n        (let [entry (first (:wait-set (:machine world)))]\n          (is (= {:deliver :return} (:deliver entry)))\n          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n\n\n(deftest tail-states-lower-to-through-k-delivery\n  (doseq [n [6 9 12]]\n    (testing (str \"row \" n)\n      (let [ref (reference (bare n))\n            {:keys [recv] :as got} (laws (bare n) ref)\n            entry (first (:wait-set recv))]\n        (is (= {:deliver :return} (:deliver entry)))\n        (is (contains? entry :site))\n        (is (not-any? #(contains? entry %) [:window :env :pc]) \"the lowered tail carries no window\")\n        (is (= (:value ref) (:value got))))))\n  (let [ref (reference (tail-effect-halt))\n        {:keys [recv] :as got} (laws (tail-effect-halt) ref)]\n    (is (= [] (:k (first (:wait-set recv)))) \"row 20: an empty K\")\n    (is (= \"B\" (:value got)) \"a tail effect with no frame to pop halts with the value\")))\n\n\n(deftest install-rows-carry-the-child\n  (doseq [[n phase] [[10 :parked] [11 :running] [12 :parked]]]\n    (testing (str \"row \" n)\n174:        (is (contains? #{:row-order :duplicate-key} (:yin.k/kind d)))))))\n220:    (is (= :duplicate-row (:yin.k/kind (error #(rows/decode (update wire :yin.k/rows conj (first (:yin.k/rows wire))))))))\n277:    (is (= :duplicate-key\n554:(deftest census-is-numeric-from-ten-cursor-cells\n1059:(deftest numeric-scalars-round-trip-through-rows\n1286:(deftest nan-valued-row-slots-are-canonical\n23:Not blockers: the P2/P3 ledger rows (§4.1), the lower-side design questions 6b Q1-Q10 (§3), and the doc residues (§5).\n33:- `repl.cljc:154-156` `packet->vector`: the one projection, `linearize/project-rows` over the expanded packet.\n42:- UCF §7.4.1 :672-674: \"a continuation may be lifted only at a safepoint\"; frozen §4.1 table; continuation §0.2.\n84:| 5 Derivations | `derive_test.cljc:348, :565` lexical-address law (stack, register), `:238-294` and `:421-574` goldens, validation, determinism, `:324, :543` execution oracles, `:619` `^:slow c4-execution-oracle`; scanner agreement and pinned goldens `scan_test.cljc:231-264` (`^:slow`) | **met** (old-scanner answers are now historical pins, as §10 says) |\n95:| dao.jing is syntax | the kernel calls only `jing/segment-key`/`segment-matches?` (`semantic.cljc:431-432`); the carrier emits content rows under Jing's default digest; nothing in `dao.jing` learned a row shape | none |\n108:Ledger status today (`docs/agents/known-gaps.md`): see §4.1.\n124:| G3 | continuation §11 Q1/Q10: install `:running` wire phase | `rows.cljc:1637, :1843` admit `#{:running :parked}`; `engine.cljc:1491, :1506` assign `:running` only inside one sweep; row 11 is hand-built (`safepoint_harness_test.cljc` row 11) | (b) | narrow to `:parked`: half a day, removes a synthetic row; leaving it: a wire state no engine reaches is accepted |\n128:| G7 | UCF §7.4.1 safepoint-only lift vs the owner's open question on `:running` roots | refused at `rows.cljc:1653` (§1.2) | (b) owner-deferred | 3-4 days + 2 for backends; capability gap only |\n131:| G10 | derivations §1379 `:tree-unavailable` composition defect | landed as text in `yin.vm.linker.md:31, :242`; no `:tree-unavailable` symbol in `src` (grep) — the lift refuses `:yin.k/unsatisfied {:yin.k/missing {:yin.k/trees …}}` instead (`rows.cljc:1684-1685`) | (d) | align the linker doc's word with the code's outcome, or add the linker-side kind when a native image is served with no known tree; today publication always records the tree (`publish.cljc`) |\n132:| G11 | ucf-revisions §6 :481-488 \"contract-pinned AST and semantic identities ... named, not landed\" | not landed | (b) low | out of this kernel's scope; would amend UCF §7.3.2 address semantics |\n133:| G12 | known-gaps rows 21 (binder refusal defence), 25 (`decode*` distinct), 22 (8d successor tests), 26 (`malformed-vectors` dead fixture), 28-29 (historical citations, prose) | as the ledger says; verified `malformed_rows.cljc` still present, `scan_test.cljc:214` does not read it | (c) P2/P3 | one test slice, one doc slice (§6) |\n134:| G13 | datom.world.md \"Peer observers\" wording vs `scan.cljc`/`vm.cljc` Datalog use; \"identified by H\" wording | §1.5 notes | (d) | two docstring sentences |\n142:### 4.1 Ledger rows owned by this seat, status today\n161:## 5. Doc-only residues found today (d)\n171:| 4 | G12 P2 pair: `decode*` key equality + binder-refusal defence | 1 day, 2 rounds | rows_test, debruijn kernel tests |\n172:| 5 | G12 P3 test slice: 8d successor tests, delete `malformed-vectors`, `parity_test` `:refer` tidy | 0.5 day | quick tier |\n173:| 6 | §5 doc pass + G10/G13 wording + UCF clause 10 record | 0.5 day, 1 round | Architect read |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '225,255p' test/yin/vm/host_typed_values_test.cljc; sed -n '1,105p' src/cljc/yin/vm/debruijn_code.cljc; sed -n '70,100p' src/cljc/yin/vm/debruijn_register_code.cljc; sed -n '1280,1315p' test/yin/vm/ucf/rows_test.cljc; sed -n '295,320p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '490,580p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '140,168p' collab/1793430000000-architect-gap-list.report.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '225,255p' test/yin/vm/host_typed_values_test.cljc; sed -n '1,105p' src/cljc/yin/vm/debruijn_code.cljc; sed -n '70,100p' src/cljc/yin/vm/debruijn_register_code.cljc; sed -n '1280,1315p' test/yin/vm/ucf/rows_test.cljc; sed -n '295,320p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '490,580p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '140,168p' collab/1793430000000-architect-gap-list.report.md\"","aggregated_output":"                        vm/ast-contract))\n\n\n(def ^:private raw-runners\n  \"Each VM fed a binder by the path that reaches its own refusal: the\n   walker its map AST (the row validator would refuse first), the semantic\n   VM its AST through the lowering, and the positional kernels the AST\n   their semantic projection admits. The semantic code loader also refuses a\n   non-symbol binder by operand kind, so its transition check is defence\n   in depth that no loader reaches. Each takes the program to run.\"\n  {:ast-walker (fn [ast]\n                 (vm/run (walker/vm-load-program (walker/create-vm opts)\n                                                 (vm/ast->datoms ast)\n                                                 vm/ast-contract))),\n   :semantic (fn [ast]\n               (vm/run (load-semantic-ast (semantic/create-vm opts)\n                                          (vm/ast->datoms ast)))),\n   :stack (fn [ast] (run-on :stack ast)),\n   :register (fn [ast] (run-on :register ast))})\n\n\n(deftest a-non-symbol-binder-is-refused-test\n  (doseq [[k run] raw-runners\n          [binder kind] bad-binders]\n    (let [refusal (refusal-of #(vm/value (run (walk/postwalk-replace\n                                                {'p binder}\n                                                store-of-program))))]\n      (if (contains? #{:stack :register} k)\n        ;; The projected row entry refuses malformed binders before derivation.\n        (is (= {:rule :slot-kind, :path [1 1]} refusal) (str k \" \" (pr-str binder)))\n        (is (= {:reason :non-symbol-parameter, :kind kind}\n(ns yin.vm.debruijn-code\n  \"B1 (docs/design/yin.vm.debruijn.stack.md S2): the executable de Bruijn\n   image dimension (`:yin.debruijn.code/*`) and its validator. Standalone:\n   no lowerer (B2), no VM (B3), no linker (B6) -- only the dimension's\n   descriptor, its own opcode table, its own exact scalar encoder, the\n   one function that computes H (`image-hash`), and the validator that is\n   the sole admitter of an executable image on this path (S3).\n\n   The opcode table is this dimension's own literal data, frozen under\n   `lowering-contract-version` 2. Its 23 mnemonics include `:load-bound`\n   (depth + position), `:load-free` (name), and `:closure` (arity + body\n   pc). The small framing and length-prefix helpers below (`to-hex`, `framed`,\n   `int64-le-hex`, `double-le-hex`, `utf8-byte-length`, `code-unit-at`)\n   are copied from `yin.vm.debruijn`, which documents them as meant to be\n   copied, not imported. The UTF-16 surrogate-pairing guard is\n   independently reimplemented to the same rule, not copied, per this\n   phase's own instruction.\n\n   This dimension's own executable scalar encoder is deliberately\n   distinct from `yin.vm.debruijn/encode-value`: it never applies NFC to\n   strings or identifier parts (exact bytes as supplied), it never folds\n   an integral double into a long (1 and 1.0 hash distinctly), and it\n   supports :ratio and :bigint as their own classes rather than excluding\n   them -- the merged projection's canonical-value-table declares both\n   out of its own domain; this dimension does not inherit that\n   exclusion. Host support for a class is explicit per host (see\n   `host-supported-scalar-classes`).\n\n   B1 does not build a decode/receive path: `image-hash`, `encode-image`,\n   and `encode-scalar` all go from an already-constructed Clojure value\n   (a hand-built canonical instruction vector, or a scalar inside one) to\n   its canonical bytes and hash. The 'CLJS receiver refuses a foreign\n   image whose wire bytes claim :double for an integral value' rule (S2)\n   describes a later receive/decode path this phase does not implement;\n   see the final report for why that is out of this file box.\"\n  (:require [clojure.set :as set]\n            [dao.jing :as jing]\n            ;; used by the CLJS branch of host-double? only\n            #_{:clj-kondo/ignore [:unused-namespace]}\n            [dao.jing.cbor :as cbor]\n            [yin.vm :as vm])\n  #?(:cljd (:import [\"dart:typed_data\" ByteData])))\n\n\n;; =============================================================================\n;; The opcode table: this dimension's own data, frozen under lowering-contract-version 2\n;; =============================================================================\n\n(def opcode-table\n  \"This dimension's literal operand table, frozen under\n   `lowering-contract-version` 2: mnemonic -> ordered `[attribute kind]`\n   operands. Lexical references carry depth and position or a free name;\n   closures carry an arity and body pc.\"\n  {:const [[:yin.debruijn.code/value :data]],\n   :closure [[:yin.debruijn.code/arity :uint] [:yin.debruijn.code/body :pc]],\n   :load-bound [[:yin.debruijn.code/depth :uint] [:yin.debruijn.code/position :uint]],\n   :load-free [[:yin.debruijn.code/name :sym]],\n   :push [],\n   :call [[:yin.debruijn.code/argc :uint] [:yin.debruijn.code/tail? :bool]],\n   :return [],\n   :jump [[:yin.debruijn.code/target :pc]],\n   :branch-false [[:yin.debruijn.code/target :pc]],\n   :halt [],\n   :gensym [[:yin.debruijn.code/prefix :str]],\n   :store-get [[:yin.debruijn.code/key :data]],\n   :store-put [[:yin.debruijn.code/key :data] [:yin.debruijn.code/value :data]],\n   :stream-make [[:yin.debruijn.code/buffer :buffer]],\n   :stream-put [],\n   :stream-cursor [],\n   :stream-next [],\n   :stream-close [],\n   :park [],\n   :resume [[:yin.debruijn.code/parked-id :kw]],\n   :current-continuation [],\n   :ffi-call [[:yin.debruijn.code/ffi-op :kw] [:yin.debruijn.code/argc :uint]],\n   :define [[:yin.debruijn.code/name :sym]]})\n\n\n(def ^:private terminators #{:jump :return :halt})\n\n\n(def mnemonics\n  (set (keys opcode-table)))\n\n\n;; =============================================================================\n;; The descriptor\n;; =============================================================================\n\n(def scalar-classes\n  \"This dimension's own executable scalar domain (S2), in the fixed order\n   that assigns each class its tag byte below. Deliberately distinct from\n   `yin.vm.debruijn/canonical-value-table`: :ratio and :bigint are their\n   own classes here, not excluded, and :int64 is named :long (S2's own\n   wording) with no NFC or integral-double folding anywhere in this\n   table's encoding.\"\n  [:nil :bool :long :double :ratio :bigint :char :string :keyword :symbol\n   :vector :list :map :set])\n\n\n(def lowering-contract-version\n  \"Bumped whenever this dimension's opcode table, scalar table, or byte\n   rules change shape -- the version the descriptor hash folds in, so an\n   incompatible lowering never collides with an old image's H. 2 (the\n   `\\\"b2\\\"` contract, `yin.vm/stack-contract`): Rule R's `:define`.\"\n(def opcode-table\n  \"Design section 4.4's register instruction set, in positional operand-\n   table form.\"\n  {:const [[:yin.debruijn.register/rd :reg]\n           [:yin.debruijn.register/value :data]]\n\n   :load-bound [[:yin.debruijn.register/rd :reg]\n                [:yin.debruijn.register/depth :uint]\n                [:yin.debruijn.register/position :uint]]\n\n   :load-free [[:yin.debruijn.register/rd :reg]\n               [:yin.debruijn.register/name :sym]]\n\n   :closure [[:yin.debruijn.register/rd :reg]\n             [:yin.debruijn.register/arity :uint]\n             [:yin.debruijn.register/body-pc :pc]]\n\n   :move [[:yin.debruijn.register/rd :reg]\n          [:yin.debruijn.register/rs :reg]]\n\n   :call [[:yin.debruijn.register/rd :reg]\n          [:yin.debruijn.register/fn-reg :reg]\n          [:yin.debruijn.register/arg-regs :regs]\n          [:yin.debruijn.register/tail? :bool]\n          [:yin.debruijn.register/live :data]]\n\n   :branch-false [[:yin.debruijn.register/cond-reg :reg]\n                  [:yin.debruijn.register/target :pc]]\n\n   :jump [[:yin.debruijn.register/target :pc]]\n\n      (is (seq (:code recv)) \"the result-only closure carries its code\")\n      (when (seq (:module-stores m))\n        (is (= 2 @count))\n        (is (= #{'c 'd} (set (keys (get-in recv [:module-stores 'host.mod])))))))))\n\n\n(deftest nan-valued-row-slots-are-canonical\n  (let [base (task-node [] [:lit nil])\n        bindings (rows/node :task (assoc (:slots base) 5\n                                         (rows/node :bindings ['x [:lit (* 1.0 ##NaN)]])))\n        body (cursor-cell-body :s 0)]\n    (doseq [task [bindings\n                  (task-node [[:x body]] [:row (rows/node :set [[:lit ##NaN] [:cursor-cell :x]])])\n                  (task-node [[:x body]] [:row (rows/node :map [[:lit :n] [:lit ##NaN]\n                                                                [:lit :c] [:cursor-cell :x]])])]]\n      (let [wire (rows/emit task)]\n        (is (nil? (error #(rows/decode wire))))\n        (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))))))\n\n\n(deftest link-pending-frame-bijection\n  (doseq [try? [true false]\n          pending [{:yin.k/reason :link-request :yin.k/link-id [:t0 7] :yin.k/name 'host.mod\n                    :yin.k/request-stream (rows/node :stream [:request :served])\n                    :yin.k/response-stream (rows/node :stream [:response :served])\n                    :yin.k/cursor-cell :response/cell :yin.k/envelope {:yin.link/id [:t0 7]}\n                    :yin.k/op-id nil}\n                   {:yin.k/reason :link-response :yin.k/link-id [:t0 7] :yin.k/name 'host.mod\n                    :yin.k/request-stream (rows/node :stream [:request :served])\n                    :yin.k/response-stream (rows/node :stream [:response :served])\n                    :yin.k/cursor-cell :response/cell}\n                   {:yin.k/reason :install :yin.k/name 'host.mod}]]\n    (let [f (assoc ft/worked-frame :yin.k/pending (assoc pending :yin.k/try? try?))\n          wire (rows/frame->rows f encoded)]\n      (is (= f (rows/rows->frame wire))))))\n(defn sent-ffi\n  [wrap]\n  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n        m (caller wrap call-in call-out)\n        id (ffi/response-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi :call-id id\n     :steps [#(stream/append! call-out (apply2/success-response id \"echo!\"))]\n     :finish #(swap! trace into (tu/drain call-in))\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn retained-ffi\n  [wrap]\n  (let [trace (atom []) call-in (s/one-slot-stream \"call-in\") call-out (s/ring 8)\n        _ (stream/append! call-in :warmed)\n        m (caller wrap call-in call-out)\n        id (ffi/request-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n     :steps [#(stream/next call-in 0)\n             (fn []\n               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn module-response\n(defn tail-effect-halt\n  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n   call (stream/next! c) with an empty K.\"\n  []\n  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n        src (s/stream-of m)]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n;; =============================================================================\n;; The two runs\n;; =============================================================================\n\n(defn drive-local\n  [m]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n\n\n(defn drive-peers\n  [m peers]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n))\n      m\n      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n\n\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/remote-attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n        attaches @n\n        again (served surfaces)\n        relift (rows/lift-task recv (:serve! again) (lift-opts))\n        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn root-task\n  [wire]\n  (rows/decode wire))\n\n\n## 4. Ledger and evidence\n\n### 4.1 Ledger rows owned by this seat, status today\n| row | severity | status |\n|---|---|---|\n| `:try?` not carried (36) | P1 | open; G1; UCF seat, L-d-1b |\n| `decode*` host-`distinct` keys (25) | P2 | open |\n| binder refusal collapsed to the projection (21) | P2 | accepted as design for the merge; follow-up slice unscheduled |\n| 8d partial mappings need two successor tests (22) | P3 | open |\n| `malformed-vectors` dead fixture (26) | P3 | open |\n| historical v3 section citations (28), prose residues (29) | P3 | open |\n| `frame.cljc` NaN (24) | P3 | closed on master (bindings= in `frame.cljc:64-77`) |\n| scan golden (18), `rows.cljc` lint (19), register doc prose (20), phase-8 deaths (27) | — | closed/recorded |\n\n### 4.2 Lane evidence\n| lane | status |\n|---|---|\n| JVM focused run here (`vm`, `code`, `analysis`, `frame`, `parity`, `walker-trace`, `load-paths`, `safepoint-harness`, `layout`, `derive`, `effects`, `link`, `rows`, `rows-custody`, `semantic-engine`, `semantic-ffi`) | **verified**: 254 tests, 15302 assertions, 0 failures, 0 errors; counterexample searches 0 failures |\n| JVM quick tier 4005-4007 / slow 22 namespaces, Node fast, Node slow C4, Dart fast | reported (log :11275; my closing report) |\n| Dart slow | **no record at the phase-8 head** (G9) |\n\n## 5. Doc-only residues found today (d)\nUCF §7.11 clause 10 :3363-3365 (Stage E host matrix now run); `yin.vm.linker.dht.md:3400` (`yin.vm.completion` acceptance line); `linker.cljc:657, :675` and `layout.cljc:13` \"identity\" wording; `scan.cljc` docstring on its Datalog use; `vm/semantic-bytecode-grammar` (`vm.cljc:998`) is the AST row-slot table, not bytecode; the ledger's P3 citation rows.\n\n## 6. Recommended order of follow-up slices\n\n| # | slice | effort | gate |\n|---|---|---|---|\n| 1 | G1 `:try?` on link pendings (L-d-1b) | 1 day codex, 2 rounds | rows/harness/link tests; fixture re-mint recorded |\n","exit_code":0,"status":"completed"}}
