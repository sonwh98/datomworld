ntract)\n            (rvm/attach-image k (:register sg) vm/register-contract))\n        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n                 :halted? false :blocked? false :value nil)]\n    (if (= :stack kind)\n      (assoc k :stack [])\n      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n\n\n(defn load-program\n  [m ast]\n  (if (= :semantic (lane-of m))\n    (sr/load-vector m (project ast) code/contract)\n    (kernel-load m (project ast))))\n\n\n(defn lane-closure\n  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n  [m c]\n  (if (= :semantic (lane-of m))\n    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\ncollab/1793400000000-architect-phase8-closing.report.md:42:- P3-2: the 8d partial-mappings row is added (\"open: name two successor tests\"). Met.\ncollab/1793430000000-architect-gap-list.report.md:148:| 8d partial mappings need two successor tests (22) | P3 | open |\ncollab/1793470000000-engineer-followup-1.prompt.md:10:Worktree /Users/sto/workspace/datomworld-srvm-followup (branch srvm-followup-1 @ origin/master 9ab9e792). Read ./collab/1793430000000-architect-gap-list.report.md (rows G12, G13, G10, section 4.1 ledger, section 5 doc residues, section 6), ./collab/1792083677000-architect-frame-nan-review.report.md (the decode* P2-1 finding), ./collab/1793400000000-architect-phase8-closing.report.md, docs/agents/known-gaps.md rows (binder refusal; decode* map-key; 8d partial mappings; malformed-vectors; historical citations; prose residues). DO, in three parts, each its own logical commit-sized diff:\ncollab/1793470000000-engineer-followup-1.promp