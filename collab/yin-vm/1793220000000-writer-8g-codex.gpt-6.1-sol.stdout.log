{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport pathlib,subprocess,re,urllib.parse\nfiles={pathlib.Path(x) for x in subprocess.check_output(['git','diff','--name-only','--diff-filter=AM'],text=True).splitlines() if x.endswith('.md')}\nfiles.update(pathlib.Path('docs/design').glob('yin.vm.semantic.*.md'))\nbad=[];count=0\nfor p in sorted(files):\n s=p.read_text()\n for m in re.finditer(r'\"'!?'\"\\\\[[\"'^'\"\\\\]\\\\n]*\\\\]\\\\(([\"'^)]+)'\"\\\\)',s):\n  url=m[1].strip().split(' \\\"')[0].strip('<>');u=urllib.parse.urlsplit(url)\n  if u.scheme or u.netloc: continue\n  d=(p.parent/urllib.parse.unquote(u.path)).resolve() if u.path else p.resolve();count+=1\n  if not d.exists():bad.append(f'{p}: missing {url}');continue\n  if u.fragment and d.suffix=='.md':\n   t=d.read_text();anchors=set(re.findall(r'<a\\\\s+(?:name|id)=\\\"([\"'^\"]+)\"'\"',t))\n   for h in re.findall(r'\"'^#{1,6}'\"\\\\s+(.+)',t,re.M):\n    h=re.sub(r'<[\"'^>]*>'\"','',h).strip().lower();h=re.sub(r'[\"'^'\"\\\\w\\\\- ]','',h);anchors.add(h.replace(' ','-'))\n   if urllib.parse.unquote(u.fragment) not in anchors:bad.append(f'{p}: missing anchor {url}')\nprint(f'{len(files)} docs; {count} relative links; {len(bad)} failures')\nprint('\\\\n'.join(bad))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
