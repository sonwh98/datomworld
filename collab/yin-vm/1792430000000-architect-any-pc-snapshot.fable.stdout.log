2711\t  [datoms]\n2712\t  (group-by first (vec datoms)))\n2713\t\n2714\t\n2715\t(defn frame-versions\n2716\t  [frame]\n2717\t  (loop [f frame\n2718\t         acc #{}]\n2719\t    (if (map? f)\n2720\t      (let [acc (cond-> acc (:compiled-version f) (conj (:compiled-version f)))]\n2721\t        (recur (:next f) acc))\n2722\t      acc)))\n2723\t\n2724\t\n2725\t(defn collect-frame-versions\n2726\t  [frames]\n2727\t  (reduce (fn [acc f] (into acc (frame-versions f))) #{} (or frames [])))\n2728\t\n2729\t\n2730\t(defn pinned-compiled-versions\n2731\t  [vm]\n2732\t  (let [active (:active-compiled-version vm)\n2733\t        k-versions (frame-versions (:k vm))\n2734\t        parked-versions (collect-frame-versions (vals (:parked vm)))\n2735\t        ready-versions (collect-frame-versions (:ready-queue vm))\n2736\t        wait-versions (collect-frame-versions (:wait-set vm))]\n2737\t    (cond-> (clojure.set/union k-versions\n2738\t                               parked-versions\n2739\t                               ready-versions"}]},"parent_tool_use_id":null,"session_id":"f7716a8d-bcb9-4b49-9ad0-ed6a5daed388","uuid":"77290bc2-ccf9-40c0-bf72-9e0ce6e7772d","timestamp":"2026-10-13T09:47:58.959Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/engine.cljc","content":"  [state v]\n  (let [gc (gc-of state)\n        since (inc (:since gc))]\n    (if (>= since (:threshold gc))\n      (collect state [v])\n      (assoc state :gc (assoc gc :since since)))))\n\n\n(defn pin-refs\n  \"`state` with every cell `v` holds a ref to pinned for the task's life\n   (owner decision 1). A value appended to a stream or carried by an FFI\n   request leaves the VM's view, so no trace could find a ref inside it\n   when it comes back.\"\n  [state v]\n  (if (or (scalar? v) (empty? (:heap state)))\n    state\n    (let [ids (trace state (:heap state) {:data [v]} #{} false)]\n      (if (seq ids)\n        (assoc state :gc (update (gc-of state) :pinned into ids))\n        state))))\n\n\n(defn handle-effect\n  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n   park-entry-fns maps :stream/put and :stream/next to functions that build\n   wait entries.\n\n   `effect` must be a `yin.vm.effect` value minted by `module/make-effect`\n   (D4); a map, whatever its keys, is data and is refused here.\n\n   A parked entry is stored as the builder left it plus, for a writer, the\n   `:datom` it retries: registers and resource ids only. Neither the live\n   stream handle nor a restore closure is attached — `check-wait-set`\n   resolves handles from `:resources` at every poll, and the scheduler that pops\n   a woken entry dispatches restoration itself — so a blocked entry is pure\n   data and survives serialization.\"\n  [state effect {:keys [park-entry-fns], :as opts}]\n  (when-not (module/effect? effect)\n    (fail \"Not an effect\" {:reason :not-an-effect}))\n  (let [park-entry (get park-entry-fns (:effect effect))\n        result\n        (case (:effect effect)\n          :vm/store-put {:state (put-active state\n                                            (store-context state)\n                                            (:key effect)\n                                            (:val effect)),\n                         :value (:val effect),\n                         :blocked? false}\n          :stream/make\n          (let [[id s'] (gensym state \"stream\")\n                [stream-ref new-state] (handle-make s' effect id)]\n            {:state new-state, :value stream-ref, :blocked? false})\n          :stream/cursor\n          (let [[id s'] (gensym state \"cursor\")\n                [cursor-ref new-state]\n                (case (gate-refuse! state effect)\n                  :running\n                  (handle-cursor-unminted s' effect id (or (:id-counter state) 0))\n                  (handle-cursor s' effect id))]\n            {:state new-state, :value cursor-ref, :blocked? false})\n          :stream/put\n          (let [state (pin-refs state (:val effect))\n                result (handle-put state effect)]\n            (if (:park result)\n              (let [built-entry (when park-entry\n                                  (park-entry state effect result))\n                    built-entry (if (and built-entry (not (:datom built-entry)))\n                                  (assoc built-entry :datom (:val effect))\n                                  built-entry)]\n                (if (and built-entry (= :running (vm/gate-mode state)))\n                  (let [[n s'] (issue-number (:state result))]\n                    (handle-stream-block\n                      (assoc result :state s')\n                      (assoc built-entry :yin.k/issue n)))\n                  (handle-stream-block result built-entry)))\n              {:state (:state result),\n               :value (:value result),\n               :blocked? false}))\n          :stream/next\n          (let [result (handle-next state effect)]\n            (if (:park result)\n              (let [built-entry (when park-entry\n                                  (park-entry state effect result))]\n                (handle-stream-block result built-entry))\n              {:state (:state result),\n               :value (:value result),\n               :blocked? false}))\n          :stream/poll\n          (let [result (handle-poll state effect)]\n            (if (and (:park result) (= :running (vm/gate-mode state)))\n              (let [builder (or (get park-entry-fns :stream/poll)\n                                (get park-entry-fns :stream/next))\n                    built (when builder (builder state effect result))]\n                (handle-stream-block\n                  result\n                  (when built\n                    (assoc built\n                           :reason :observe\n                           :op :poll\n                           :cursor-ref (:cursor-ref result)\n                           :stream-id (:stream-id result)))))\n              {:state (:state result),\n               :value (:value result),\n               :blocked? false}))\n          :stream/close\n          (let [_ (gate-refuse! state effect)\n                close-result (handle-close state effect)]\n            {:state (:state close-result), :value nil, :blocked? false})\n          ;; `:heap` is VM state, not continuation state: a write is seen\n          ;; by every holder of the ref and survives continuation invocation\n          :cell/new\n          (let [[id s'] (gensym (count-allocation state (:val effect)) \"cell\")\n                ref (issue-ref s' :cell-ref id)]\n            {:state (heap-write s' id (:seal ref) (:val effect)),\n             :value ref,\n             :blocked? false})\n          :cell/get\n          (let [id (check-ref! state :cell/get :cell-ref (:cell effect))]\n            ;; the content is answered as data, never re-interpreted\n            {:state state,\n             :value (get-in state [:heap id :value]),\n             :blocked? false})\n          :cell/set!\n          (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n            {:state (heap-write state id (get-in state [:heap id :seal])\n                                (:val effect)),\n             :value (:val effect),\n             :blocked? false})\n          (let [[id s'] (gensym state \"effect\")\n                handler (module/get-effect-handler (:modules state)\n                                                   (:effect effect))]\n            (if handler\n              (handler s' effect (assoc opts :id id))\n              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n    (update result\n            :state\n            (fn [result-state]\n              (telemetry/emit-snapshot (assoc result-state\n                                              :value (:value result))\n                                       :effect\n                                       {:effect-type (:effect effect)})))))\n\n\n;; =============================================================================\n;; Program Cache Machinery\n;; =============================================================================\n\n(def default-compiled-cache-limit 8)\n\n\n(defn build-program-index\n  [datoms]\n  (group-by first (vec datoms)))\n\n\n(defn frame-versions\n  [frame]\n  (loop [f frame\n         acc #{}]\n    (if (map? f)\n      (let [acc (cond-> acc (:compiled-version f) (conj (:compiled-version f)))]\n        (recur (:next f) acc))\n      acc)))\n\n\n(defn collect-frame-versions\n  [frames]\n  (reduce (fn [acc f] (into acc (frame-versions f))) #{} (or frames [])))\n\n\n(defn pinned-compiled-versions\n  [vm]\n  (let [active (:active-compiled-version vm)\n        k-versions (frame-versions (:k vm))\n        parked-versions (collect-frame-versions (vals (:parked vm)))\n        ready-versions (collect-frame-versions (:ready-queue vm))\n        wait-versions (collect-frame-versions (:wait-set vm))]\n    (cond-> (clojure.set/union k-versions\n                               parked-versions\n                               ready-versions","numLines":180,"startLine":2560,"totalLines":2789}},"tool_result_meta":[{"id":"toolu_014je3LPMUvxNUozbrR1PsSK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011Cfz2QtMmskVVxV6WzXknz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01R2VdvMxfYqGNCJkd2FEeJd","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/debruijn/stack.cljc","offset":500,"limit":310},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":13736,"cache_read_input_tokens":132190,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13736},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7716a8d-bcb9-4b49-9ad0-ed6a5daed388","uuid":"37973062-f7ec-4224-a744-029a57ad2203","timestamp":"2026-10-13T09:48:00.193Z","request_id":"req_011Cfz2Qt3B7CWVTqftpHQVw","wire_tool_inputs":{"toolu_01R2VdvMxfYqGNCJkd2FEeJd":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/debruijn/stack.cljc","offset":500,"limit":310}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R2VdvMxfYqGNCJkd2FEeJd","type":"tool_result","content":"500\t\n501\t\n502\t(defn- refuse-continuation!\n503\t  [base entry]\n504\t  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n505\t                  {:reason :foreign-format,\n506\t                   :rule :continuation-format,\n507\t                   :format (:format entry),\n508\t                   :hash (:hash entry),\n509\t                   :image (:image entry),\n510\t                   :expected-format format-tag,\n511\t                   :expected-hash (:hash base),\n512\t                   :images (:images base)})))\n513\t\n514\t\n515\t(defn- return-transition\n516\t  \"Deliver a result through the caller's frame, or halt when K is empty.\"\n517\t  [vm val]\n518\t  (if-let [frame (peek (:continuation vm))]\n519\t    (assoc vm\n520\t           :pc (:return-pc frame)\n521\t           :frames (:frames frame)\n522\t           :stack (conj (subvec (:stack vm) 0 (:stack-base frame)) val)\n523\t           :continuation (pop (:continuation vm))\n524\t           :store-of (:store-of frame))\n525\t    (assoc vm :halted? true :stack [val] :value val :store-of nil)))\n526\t\n527\t\n528\t(defn stack-restore\n529\t  \"This machine's one restore function, `base entry val -> state`\n530\t   (`yin.vm.engine.md` section 2.1; design section 4.1, item 4). `base` is\n531\t   the state after the engine has done its part; `entry` is the wait, ready,\n532\t   or parked record; `val` is the value the parked instruction receives.\n533\t\n534\t   It first refuses with a qualified `:continuation-format` outcome unless\n535\t   the entry's `:format` is `:yin.debruijn.code` and its `:image` is a row\n536\t   of the offset table (yin.vm.linker.md section 7.3, r6): a continuation\n537\t   from the named VM, from the register kernel, or from an image this\n538\t   kernel does not hold is never interpreted here. `:hash` is never a\n539\t   restore key: it changes at every `attach-image`, while the table only\n540\t   grows, so an entry parked before an attach still names its row.\n541\t\n542\t   Then the FFI two-step, on the entry keys the `yin.vm.ffi` convention\n543\t   owns, in the semantic VM's placement:\n544\t\n545\t   - A `:request-sent` entry is a writer whose retained request has now been\n546\t     appended. It must not resume: its registers are re-parked as the\n547\t     call-out reader (`ffi/response-wait-entry`) and the machine stays\n548\t     blocked.\n549\t   - A `:call-id` entry is a response reader. The woken value is a response\n550\t     envelope, so `ffi/call-result` unwraps it and checks correlation, and\n551\t     the parked call leaves `:parked` rather than accumulating.\n552\t\n553\t   A `:return-result` entry delivers through the return transition.\n554\t   Otherwise the registers are written from the entry and `val` is conjed\n555\t   onto the restored `:stack` -- the B3 obligation that every\n556\t   value-producing opcode lands on the stack, since there is no\n557\t   accumulator. `:segment` is never written from the entry: the code space\n558\t   is kernel state, and since appending moves nothing, the entry's\n559\t   absolute pcs and stack bases still name what they named.\"\n560\t  [base entry val]\n561\t  (when-not (and (= format-tag (:format entry))\n562\t                 (some #(= (:image entry) (nth % 0)) (:images base)))\n563\t    (refuse-continuation! base entry))\n564\t  (if (:request-sent entry)\n565\t    (-> base\n566\t        (update :wait-set (fnil conj [])\n567\t                (ffi/response-wait-entry entry (:call-id entry)))\n568\t        (assoc :value :yin/blocked\n569\t               :blocked? true\n570\t               :halted? false))\n571\t    (let [call-id (:call-id entry)\n572\t          base (if call-id (update base :parked dissoc call-id) base)\n573\t          val (if call-id (ffi/call-result val call-id) val)\n574\t          restored (assoc base\n575\t                          :pc (:pc entry)\n576\t                          :frames (:frames entry)\n577\t                          :continuation (:continuation entry)\n578\t                          :stack (vec (:stack entry))\n579\t                          :store-of (:store-of entry)\n580\t                          :value val\n581\t                          :halted? false)]\n582\t      (if (= :return-result (:resume-mode entry))\n583\t        (return-transition restored val)\n584\t        (assoc restored :stack (conj (:stack restored) val))))))\n585\t\n586\t\n587\t(defn- park-entry-fns\n588\t  \"Wait-entry builders for an instruction whose effect may block (design\n589\t   section 4.1, item 5): each closes over the post-instruction registers\n590\t   and returns them merged with `:reason` and the resource ids from the\n591\t   handler's result. Nothing else is attached: no handle, no closure, no\n592\t   restore function.\"\n593\t  [vm pc' stack']\n594\t  (let [site (nth (:segment vm) (:pc vm))\n595\t        regs (cond-> (registers vm pc' stack')\n596\t               (and (= :call (first site)) (true? (nth site 2)))\n597\t               (assoc :resume-mode :return-result))]\n598\t    {:stream/put (fn [_state _effect result]\n599\t                   (assoc regs\n600\t                          :reason :put\n601\t                          :stream-id (:stream-id result))),\n602\t     :stream/next (fn [_state _effect result]\n603\t                    (assoc regs\n604\t                           :reason :next\n605\t                           :cursor-ref (:cursor-ref result)\n606\t                           :stream-id (:stream-id result))),\n607\t     :module/require (fn [_state _effect _result] regs)}))\n608\t\n609\t\n610\t(defn- run-effect\n611\t  \"Dispatch one effect through the engine from the instruction at `(:pc vm)`\n612\t   with `stack'` its operand stack after popping the instruction's operands.\n613\t   On a value the machine continues at pc+1 with the value on the stack; on\n614\t   a park the engine has already placed the pure-data entry in the wait set\n615\t   and marked the machine blocked, and the registers mirror that entry.\"\n616\t  [vm effect stack']\n617\t  (let [pc' (inc (:pc vm))\n618\t        {:keys [state value blocked?]}\n619\t        (engine/handle-effect vm\n620\t                              effect\n621\t                              {:park-entry-fns (park-entry-fns vm pc' stack')})]\n622\t    (if blocked?\n623\t      (assoc state :pc pc' :stack stack')\n624\t      (assoc state :pc pc' :stack (conj stack' value)))))\n625\t\n626\t\n627\t(defn- ffi-call\n628\t  \"`[:ffi-call op argc]`: park-and-call over the FFI pair (the two-step of\n629\t   `yin.vm.engine.md` section 4). The continuation after the call is parked,\n630\t   its id is the call's correlation id, and the request is appended to the\n631\t   call-in stream. An `ok` append waits on the call-out cursor for the\n632\t   correlated response; a `full` append waits as a writer retrying the\n633\t   identical request, and `stack-restore` turns that writer into the\n634\t   response reader when it wakes.\"\n635\t  [vm op argc]\n636\t  (let [{:keys [pc stack resources]} vm\n637\t        total (count stack)\n638\t        args (subvec stack (- total argc))\n639\t        stack' (subvec stack 0 (- total argc))\n640\t        ;; The pair is checked before parking: an error raised after\n641\t        ;; park-continuation would strand a continuation in :parked and\n642\t        ;; consume an id counter.\n643\t        {:keys [call-in]} (ffi/require-call-pair! resources op)\n644\t        regs (registers vm (inc pc) stack')\n645\t        call-id (ffi/call-id vm (engine/park-id vm))\n646\t        ;; the request carries `args` out of the VM's view\n647\t        parked (engine/park-continuation (assoc (engine/pin-refs vm args)\n648\t                                                :pc (inc pc)\n649\t                                                :stack stack')\n650\t                                         regs\n651\t                                         call-id)\n652\t        request (apply2/request call-id op args)\n653\t        result (ffi/put-request vm call-in request)\n654\t        blocked (fn [entry]\n655\t                  (-> parked\n656\t                      (update :wait-set (fnil conj []) entry)\n657\t                      (assoc :value :yin/blocked\n658\t                             :blocked? true\n659\t                             :halted? false)))]\n660\t    (case (:dao.stream/outcome result)\n661\t      :dao.stream/ok (blocked (ffi/response-wait-entry regs call-id))\n662\t      :dao.stream/full (blocked (assoc regs\n663\t                                       :request-sent true\n664\t                                       :call-id call-id\n665\t                                       :op op\n666\t                                       :reason :put\n667\t                                       :stream-id vm/call-in-stream-key\n668\t                                       :datom request))\n669\t      (throw (ex-info \"FFI request could not be appended\"\n670\t                      {:op op,\n671\t                       :outcome (or (:dao.stream/outcome result)\n672\t                                    (:dao.stream.apply/outcome result))})))))\n673\t\n674\t\n675\t;; =============================================================================\n676\t;; The step function\n677\t;; =============================================================================\n678\t\n679\t(defn- step1\n680\t  \"Execute exactly one instruction and return the resulting VM. Assumes the\n681\t   VM's continuation is active; callers (`step`, `run`) check that first.\"\n682\t  [vm]\n683\t  (let [{:keys [segment pc frames free-env stack continuation\n684\t                primitives modules store-of]}\n685\t        vm\n686\t        inst (nth segment pc)\n687\t        op (nth inst 0)]\n688\t    (case op\n689\t      :const\n690\t      (assoc vm :pc (inc pc) :stack (conj stack (nth inst 1)))\n691\t\n692\t      :load-bound\n693\t      (let [depth (nth inst 1), position (nth inst 2)]\n694\t        (assoc vm\n695\t               :pc (inc pc)\n696\t               :stack (conj stack (frame-value frames depth position))))\n697\t\n698\t      :load-free\n699\t      (let [name (nth inst 1)\n700\t            value (engine/resolve-var free-env\n701\t                                      (engine/active-store vm store-of)\n702\t                                      primitives modules name)]\n703\t        (assoc vm :pc (inc pc) :stack (conj stack value)))\n704\t\n705\t      ;; This positional dimension has no `:macro?` flag on `:closure` (it\n706\t      ;; is named-datom-only, section 4): the instruction carries only\n707\t      ;; arity and a body pc, so there is nothing here to ignore.\n708\t      :closure\n709\t      (let [arity (nth inst 1), body-pc (nth inst 2)]\n710\t        (assoc vm\n711\t               :pc (inc pc)\n712\t               :stack (conj stack\n713\t                            (values/closure\n714\t                              (:owner vm)\n715\t                              (cond-> {:type :closure, :arity arity,\n716\t                                       :body-pc body-pc, :frames frames}\n717\t                                store-of (assoc :store-of store-of))))))\n718\t\n719\t      ;; The named VM (semantic.cljc) keeps a separate `val` accumulator\n720\t      ;; distinct from its operand stack `St`, so `:push` there commits\n721\t      ;; `val` onto `St` (St <- St ++ [val]). This machine has no such\n722\t      ;; split: every value-producing case already conjes its result\n723\t      ;; straight onto `:stack`. By the time control reaches a `:push`,\n724\t      ;; the value it would push is already there -- so here it is a no-op\n725\t      ;; that only advances `pc`. Every value-producing opcode below\n726\t      ;; (:stream-*, :gensym, :current-continuation, :resume, and the\n727\t      ;; restore after :ffi-call) honours this, or a `:push` immediately\n728\t      ;; after it would silently drop the value -- there is no `val`\n729\t      ;; register to recover it from.\n730\t      :push\n731\t      (assoc vm :pc (inc pc))\n732\t\n733\t      :call\n734\t      (let [argc (nth inst 1), tail? (nth inst 2)\n735\t            total (count stack)\n736\t            f-pos (- total argc 1)\n737\t            f (nth stack f-pos)\n738\t            args (subvec stack (inc f-pos) total)\n739\t            stack' (subvec stack 0 f-pos)]\n740\t        (case (engine/operator-kind vm f)\n741\t          :closure\n742\t          (let [c (values/payload f)\n743\t                locals (bind-positional (:arity c) args)\n744\t                body-frames (conj (:frames c) locals)\n745\t                continuation' (if tail?\n746\t                                continuation\n747\t                                (conj continuation\n748\t                                      (cond-> {:return-pc (inc pc),\n749\t                                               :frames frames,\n750\t                                               :stack-base (count stack')}\n751\t                                        store-of (assoc :store-of store-of))))]\n752\t            (assoc vm\n753\t                   :pc (:body-pc c)\n754\t                   :frames body-frames\n755\t                   :stack stack'\n756\t                   :continuation continuation'\n757\t                   :store-of (:store-of c)))\n758\t\n759\t          ;; A primitive host function, resolved by :load-free. The same\n760\t          ;; path the named engine's `apply-call` uses for a `fn?` callee:\n761\t          ;; a plain result lands on the stack; an effect descriptor (a\n762\t          ;; `require`, a `stream` module call) is dispatched\n763\t          ;; through the engine and may park with the continuation after\n764\t          ;; the call site.\n765\t          :host-fn\n766\t          (let [result (apply f args)]\n767\t            (if (module/effect? result)\n768\t              (run-effect (engine/check-callee-effect! vm f result)\n769\t                          result\n770\t                          stack')\n771\t              (assoc vm :pc (inc pc) :stack (conj stack' result))))\n772\t\n773\t          ;; A captured continuation: abortive, so the call site's stack,\n774\t          ;; frames and return frames are dropped and the captured\n775\t          ;; registers are restored with the argument on the stack, as a\n776\t          ;; resume would deliver it. The store is not a register.\n777\t          :continuation\n778\t          (stack-restore vm\n779\t                         (values/payload f)\n780\t                         (engine/continuation-argument args))))\n781\t\n782\t      :return\n783\t      (return-transition vm (peek stack))\n784\t\n785\t      :jump\n786\t      (assoc vm :pc (nth inst 1))\n787\t\n788\t      :branch-false\n789\t      (let [val (peek stack), stack' (pop stack)]\n790\t        (if val\n791\t          (assoc vm :pc (inc pc) :stack stack')\n792\t          (assoc vm :pc (nth inst 1) :stack stack')))\n793\t\n794\t      :halt\n795\t      (assoc vm :halted? true, :value (peek stack), :store-of nil)\n796\t\n797\t      ;; A module closure's store instructions route to its module store,\n798\t      ;; with no ambient fallback (yin.vm.linker.md section 7.3, r7).\n799\t      :store-get\n800\t      (let [key (nth inst 1)]\n801\t        (assoc vm\n802\t               :pc (inc pc)\n803\t               :stack (conj stack (get (engine/active-store vm store-of)\n804\t                                       key))))\n805\t\n806\t      :store-put\n807\t      (let [key (nth inst 1), value (nth inst 2)]\n808\t        (assoc (engine/put-active vm store-of key value)\n809\t               :pc (inc pc)"}]},"parent_tool_use_id":null,"session_id":"f7716a8d-bcb9-4b49-9ad0-ed6a5daed388","uuid":"9b6b5c5e-5f06-4cdf-8024-176ff66981c7","timestamp":"2026-10-13T09:48:00.206Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/debruijn/stack.cljc","content":"\n\n(defn- refuse-continuation!\n  [base entry]\n  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n                  {:reason :foreign-format,\n                   :rule :continuation-format,\n                   :format (:format entry),\n                   :hash (:hash entry),\n                   :image (:image entry),\n                   :expected-format format-tag,\n                   :expected-hash (:hash base),\n                   :images (:images base)})))\n\n\n(defn- return-transition\n  \"Deliver a result through the caller's frame, or halt when K is empty.\"\n  [vm val]\n  (if-let [frame (peek (:continuation vm))]\n    (assoc vm\n           :pc (:return-pc frame)\n           :frames (:frames frame)\n           :stack (conj (subvec (:stack vm) 0 (:stack-base frame)) val)\n           :continuation (pop (:continuation vm))\n           :store-of (:store-of frame))\n    (assoc vm :halted? true :stack [val] :value val :store-of nil)))\n\n\n(defn stack-restore\n  \"This machine's one restore function, `base entry val -> state`\n   (`yin.vm.engine.md` section 2.1; design section 4.1, item 4). `base` is\n   the state after the engine has done its part; `entry` is the wait, ready,\n   or parked record; `val` is the value the parked instruction receives.\n\n   It first refuses with a qualified `:continuation-format` outcome unless\n   the entry's `:format` is `:yin.debruijn.code` and its `:image` is a row\n   of the offset table (yin.vm.linker.md section 7.3, r6): a continuation\n   from the named VM, from the register kernel, or from an image this\n   kernel does not hold is never interpreted here. `:hash` is never a\n   restore key: it changes at every `attach-image`, while the table only\n   grows, so an entry parked before an attach still names its row.\n\n   Then the FFI two-step, on the entry keys the `yin.vm.ffi` convention\n   owns, in the semantic VM's placement:\n\n   - A `:request-sent` entry is a writer whose retained request has now been\n     appended. It must not resume: its registers are re-parked as the\n     call-out reader (`ffi/response-wait-entry`) and the machine stays\n     blocked.\n   - A `:call-id` entry is a response reader. The woken value is a response\n     envelope, so `ffi/call-result` unwraps it and checks correlation, and\n     the parked call leaves `:parked` rather than accumulating.\n\n   A `:return-result` entry delivers through the return transition.\n   Otherwise the registers are written from the entry and `val` is conjed\n   onto the restored `:stack` -- the B3 obligation that every\n   value-producing opcode lands on the stack, since there is no\n   accumulator. `:segment` is never written from the entry: the code space\n   is kernel state, and since appending moves nothing, the entry's\n   absolute pcs and stack bases still name what they named.\"\n  [base entry val]\n  (when-not (and (= format-tag (:format entry))\n                 (some #(= (:image entry) (nth % 0)) (:images base)))\n    (refuse-continuation! base entry))\n  (if (:request-sent entry)\n    (-> base\n        (update :wait-set (fnil conj [])\n                (ffi/response-wait-entry entry (:call-id entry)))\n        (assoc :value :yin/blocked\n               :blocked? true\n               :halted? false))\n    (let [call-id (:call-id entry)\n          base (if call-id (update base :parked dissoc call-id) base)\n          val (if call-id (ffi/call-result val call-id) val)\n          restored (assoc base\n                          :pc (:pc entry)\n                          :frames (:frames entry)\n                          :continuation (:continuation entry)\n                          :stack (vec (:stack entry))\n                          :store-of (:store-of entry)\n                          :value val\n                          :halted? false)]\n      (if (= :return-result (:resume-mode entry))\n        (return-transition restored val)\n        (assoc restored :stack (conj (:stack restored) val))))))\n\n\n(defn- park-entry-fns\n  \"Wait-entry builders for an instruction whose effect may block (design\n   section 4.1, item 5): each closes over the post-instruction registers\n   and returns them merged with `:reason` and the resource ids from the\n   handler's result. Nothing else is attached: no handle, no closure, no\n   restore function.\"\n  [vm pc' stack']\n  (let [site (nth (:segment vm) (:pc vm))\n        regs (cond-> (registers vm pc' stack')\n               (and (= :call (first site)) (true? (nth site 2)))\n               (assoc :resume-mode :return-result))]\n    {:stream/put (fn [_state _effect result]\n                   (assoc regs\n                          :reason :put\n                          :stream-id (:stream-id result))),\n     :stream/next (fn [_state _effect result]\n                    (assoc regs\n                           :reason :next\n                           :cursor-ref (:cursor-ref result)\n                           :stream-id (:stream-id result))),\n     :module/require (fn [_state _effect _result] regs)}))\n\n\n(defn- run-effect\n  \"Dispatch one effect through the engine from the instruction at `(:pc vm)`\n   with `stack'` its operand stack after popping the instruction's operands.\n   On a value the machine continues at pc+1 with the value on the stack; on\n   a park the engine has already placed the pure-data entry in the wait set\n   and marked the machine blocked, and the registers mirror that entry.\"\n  [vm effect stack']\n  (let [pc' (inc (:pc vm))\n        {:keys [state value blocked?]}\n        (engine/handle-effect vm\n                              effect\n                              {:park-entry-fns (park-entry-fns vm pc' stack')})]\n    (if blocked?\n      (assoc state :pc pc' :stack stack')\n      (assoc state :pc pc' :stack (conj stack' value)))))\n\n\n(defn- ffi-call\n  \"`[:ffi-call op argc]`: park-and-call over the FFI pair (the two-step of\n   `yin.vm.engine.md` section 4). The continuation after the call is parked,\n   its id is the call's correlation id, and the request is appended to the\n   call-in stream. An `ok` append waits on the call-out cursor for the\n   correlated response; a `full` append waits as a writer retrying the\n   identical request, and `stack-restore` turns that writer into the\n   response reader when it wakes.\"\n  [vm op argc]\n  (let [{:keys [pc stack resources]} vm\n        total (count stack)\n        args (subvec stack (- total argc))\n        stack' (subvec stack 0 (- total argc))\n        ;; The pair is checked before parking: an error raised after\n        ;; park-continuation would strand a continuation in :parked and\n        ;; consume an id counter.\n        {:keys [call-in]} (ffi/require-call-pair! resources op)\n        regs (registers vm (inc pc) stack')\n        call-id (ffi/call-id vm (engine/park-id vm))\n        ;; the request carries `args` out of the VM's view\n        parked (engine/park-continuation (assoc (engine/pin-refs vm args)\n                                                :pc (inc pc)\n                                                :stack stack')\n                                         regs\n                                         call-id)\n        request (apply2/request call-id op args)\n        result (ffi/put-request vm call-in request)\n        blocked (fn [entry]\n                  (-> parked\n                      (update :wait-set (fnil conj []) entry)\n                      (assoc :value :yin/blocked\n                             :blocked? true\n                             :halted? false)))]\n    (case (:dao.stream/outcome result)\n      :dao.stream/ok (blocked (ffi/response-wait-entry regs call-id))\n      :dao.stream/full (blocked (assoc regs\n                                       :request-sent true\n                                       :call-id call-id\n                                       :op op\n                                       :reason :put\n                                       :stream-id vm/call-in-stream-key\n                                       :datom request))\n      (throw (ex-info \"FFI request could not be appended\"\n                      {:op op,\n                       :outcome (or (:dao.stream/outcome result)\n                                    (:dao.stream.apply/outcome result))})))))\n\n\n;; =============================================================================\n;; The step function\n;; =============================================================================\n\n(defn- step1\n  \"Execute exactly one instruction and return the resulting VM. Assumes the\n   VM's continuation is active; callers (`step`, `run`) check that first.\"\n  [vm]\n  (let [{:keys [segment pc frames free-env stack continuation\n                primitives modules store-of]}\n        vm\n        inst (nth segment pc)\n        op (nth inst 0)]\n    (case op\n      :const\n      (assoc vm :pc (inc pc) :stack (conj stack (nth inst 1)))\n\n      :load-bound\n      (let [depth (nth inst 1), position (nth inst 2)]\n        (assoc vm\n               :pc (inc pc)\n               :stack (conj stack (frame-value frames depth position))))\n\n      :load-free\n      (let [name (nth inst 1)\n            value (engine/resolve-var free-env\n                                      (engine/active-store vm store-of)\n                                      primitives modules name)]\n        (assoc vm :pc (inc pc) :stack (conj stack value)))\n\n      ;; This positional dimension has no `:macro?` flag on `:closure` (it\n      ;; is named-datom-only, section 4): the instruction carries only\n      ;; arity and a body pc, so there is nothing here to ignore.\n      :closure\n      (let [arity (nth inst 1), body-pc (nth inst 2)]\n        (assoc vm\n               :pc (inc pc)\n               :stack (conj stack\n                            (values/closure\n                              (:owner vm)\n                              (cond-> {:type :closure, :arity arity,\n                                       :body-pc body-pc, :frames frames}\n                                store-of (assoc :store-of store-of))))))\n\n      ;; The named VM (semantic.cljc) keeps a separate `val` accumulator\n      ;; distinct from its operand stack `St`, so `:push` there commits\n      ;; `val` onto `St` (St <- St ++ [val]). This machine has no such\n      ;; split: every value-producing case already conjes its result\n      ;; straight onto `:stack`. By the time control reaches a `:push`,\n      ;; the value it would push is already there -- so here it is a no-op\n      ;; that only advances `pc`. Every value-producing opcode below\n      ;; (:stream-*, :gensym, :current-continuation, :resume, and the\n      ;; restore after :ffi-call) honours this, or a `:push` immediately\n      ;; after it would silently drop the value -- there is no `val`\n      ;; register to recover it from.\n      :push\n      (assoc vm :pc (inc pc))\n\n      :call\n      (let [argc (nth inst 1), tail? (nth inst 2)\n            total (count stack)\n            f-pos (- total argc 1)\n            f (nth stack f-pos)\n            args (subvec stack (inc f-pos) total)\n            stack' (subvec stack 0 f-pos)]\n        (case (engine/operator-kind vm f)\n          :closure\n          (let [c (values/payload f)\n                locals (bind-positional (:arity c) args)\n                body-frames (conj (:frames c) locals)\n                continuation' (if tail?\n                                continuation\n                                (conj continuation\n                                      (cond-> {:return-pc (inc pc),\n                                               :frames frames,\n                                               :stack-base (count stack')}\n                                        store-of (assoc :store-of store-of))))]\n            (assoc vm\n                   :pc (:body-pc c)\n                   :frames body-frames\n                   :stack stack'\n                   :continuation continuation'\n                   :store-of (:store-of c)))\n\n          ;; A primitive host function, resolved by :load-free. The same\n          ;; path the named engine's `apply-call` uses for a `fn?` callee:\n          ;; a plain result lands on the stack; an effect descriptor (a\n          ;; `require`, a `stream` module call) is dispatched\n          ;; through the engine and may park with the continuation after\n          ;; the call site.\n          :host-fn\n          (let [result (apply f args)]\n            (if (module/effect? result)\n              (run-effect (engine/check-callee-effect! vm f result)\n                          result\n                          stack')\n              (assoc vm :pc (inc pc) :stack (conj stack' result))))\n\n          ;; A captured continuation: abortive, so the call site's stack,\n          ;; frames and return frames are dropped and the captured\n          ;; registers are restored with the argument on the stack, as a\n          ;; resume would deliver it. The store is not a register.\n          :continuation\n          (stack-restore vm\n                         (values/payload f)\n                         (engine/continuation-argument args))))\n\n      :return\n      (return-transition vm (peek stack))\n\n      :jump\n      (assoc vm :pc (nth inst 1))\n\n      :branch-false\n      (let [val (peek stack), stack' (pop stack)]\n        (if val\n          (assoc vm :pc (inc pc) :stack stack')\n          (assoc vm :pc (nth inst 1) :stack stack')))\n\n      :halt\n      (assoc vm :halted? true, :value (peek stack), :store-of nil)\n\n      ;; A module closure's store instructions route to its module store,\n      ;; with no ambient fallback (yin.vm.linker.md section 7.3, r7).\n      :store-get\n      (let [key (nth inst 1)]\n        (assoc vm\n               :pc (inc pc)\n               :stack (conj stack (get (engine/active-store vm store-of)\n                                       key))))\n\n      :store-put\n      (let [key (nth inst 1), value (nth inst 2)]\n        (assoc (engine/put-active vm store-of key value)\n               :pc (inc pc)","numLines":310,"startLine":500,"totalLines":1027}},"tool_result_meta":[{"id":"toolu_01R2VdvMxfYqGNCJkd2FEeJd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
