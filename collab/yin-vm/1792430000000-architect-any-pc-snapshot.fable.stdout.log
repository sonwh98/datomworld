rap)]))\n633\t                                 segments)))\n634\t              rows)\n635\t        [20 :unwrapped \"B\" tail-effect-halt]))\n636\t\n637\t\n638\t(defn bare\n639\t  [n]\n640\t  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n641\t    (build identity)))\n642\t\n643\t\n644\t;; =============================================================================\n645\t;; Acceptance 1: 89 runs\n646\t;; =============================================================================\n647\t\n648\t(deftest ^:slow every-row-every-segment-matches-the-reference\n649\t  (slow/guard\n650\t    \"every-row-every-segment-matches-the-reference\"\n651\t    (fn []\n652\t      (let [cases (matrix-cases) runs (atom 0)]\n653\t        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n654\t        (doseq [[n label expected build] cases]\n655\t          (testing (str \"row \" n \" \" (name label))\n656\t            (let [ref (reference (build))]\n657\t              (when (some? expected)\n658\t                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n659\t              (laws (build) ref)\n660\t              (swap! runs inc))))\n661\t        (is (= 89 @runs))))))\n662\t\n663\t\n664\t(deftest bare-rows-match-the-reference\n665\t  ;; The quick-tier slice of acceptance 1: every row once, bare.\n666\t  (let [counted (atom [0 0])]\n667\t    (doseq [[n r build] rows]\n668\t      (testing (str \"row \" n)\n669\t        (let [ref (reference (build identity))\n670\t              {:keys [wire attaches]} (laws (build identity) ref)]\n671\t          (when (some? r) (is (= r (:value ref))))\n672\t          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n673\t    ;; outside laws, so deleting its count assertion leaves one standing\n674\t    (is (pos? (first @counted)) \"the corpus attaches streams\")\n675\t    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n676\t\n677\t\n678\t;; =============================================================================\n679\t;; Acceptance 2-6\n680\t;; =============================================================================\n681\t\n682\t(defn wait-state\n683\t  [wire]\n684\t  (first (:slots (first (slot (root-task wire) 13)))))\n685\t\n686\t\n687\t(deftest tail-states-carry-no-window\n688\t  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n689\t    (testing (str \"row \" label)"}]},"parent_tool_use_id":null,"session_id":"f7716a8d-bcb9-4b49-9ad0-ed6a5daed388","uuid":"c55a47c5-04d3-4583-a810-0a1335707314","timestamp":"2026-10-13T09:48:05.227Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"(defn first-pending\n  [task]\n  (second (:slots (first (slot task 13)))))\n\n\n(defn laws\n  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n  [world expected]\n  (let [{:keys [wire relift corr corr2 attaches] :as got} (handed-off world)\n        task (root-task wire)]\n    (is (= (:kind world) (slot task 2)))\n    (is (= (count (stream-identities wire)) attaches) \"one attach per distinct stream identity\")\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n\n;; =============================================================================\n;; Acceptance 1: 89 runs\n;; =============================================================================\n\n(deftest ^:slow every-row-every-segment-matches-the-reference\n  (slow/guard\n    \"every-row-every-segment-matches-the-reference\"\n    (fn []\n      (let [cases (matrix-cases) runs (atom 0)]\n        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n        (doseq [[n label expected build] cases]\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (let [counted (atom [0 0])]\n    (doseq [[n r build] rows]\n      (testing (str \"row \" n)\n        (let [ref (reference (build identity))\n              {:keys [wire attaches]} (laws (build identity) ref)]\n          (when (some? r) (is (= r (:value ref))))\n          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n    ;; outside laws, so deleting its count assertion leaves one standing\n    (is (pos? (first @counted)) \"the corpus attaches streams\")\n    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n\n\n(deftest tail-states-carry-no-window\n  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n    (testing (str \"row \" label)","numLines":90,"startLine":600,"totalLines":1931}},"tool_result_meta":[{"id":"toolu_0149Qwd95ktRVdCxFFWoubh2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
