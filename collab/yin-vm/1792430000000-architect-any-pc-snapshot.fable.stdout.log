{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011Cfz2dNq88BMsMzAvBUoug","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015eLUUzhoYazrY5z1EAi3PR","name":"Write","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/semantic_register/anypc_probe_test.cljc","content":"(ns yin.vm.semantic-register.anypc-probe-test\n  \"Throwaway probe: how many pcs the harness corpus has (static), and the\n   dynamic step count of representative rows. Deleted after the report.\"\n  (:require [clojure.test :refer [deftest is]]\n            [yin.vm :as vm]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.safepoint-harness-test :as h]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(defn- parking? [t]\n  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n      (= :call (nth t 0))))\n\n\n(defn- static-counts [vs]\n  (reduce (fn [acc v]\n            (let [reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n              (-> acc\n                  (update :pcs + (count v))\n                  (update :reachable + (count reach))\n                  (update :parking + (count (filter #(parking? (nth v %)) reach)))\n                  (update :vectors inc))))\n          {:pcs 0 :reachable 0 :parking 0 :vectors 0}\n          vs))\n\n\n(defn- steps-to-park [ast]\n  (loop [m (h/load-program (h/machine) ast) n 0]\n    (if (or (vm/blocked? m) (vm/halted? m) (> n 100000))\n      n\n      (recur (vm/step m) (inc n)))))\n\n\n(deftest probe\n  (let [cases (h/matrix-cases)\n        totals (atom {:pcs 0 :reachable 0 :parking 0 :vectors 0 :cases 0})\n        lane (atom {:pcs 0 :reachable 0 :parking 0 :vectors 0 :cases 0})\n        link #{7 8 9 10 11 12 17}]\n    (doseq [[n _ _ build] cases]\n      (let [vs (h/scoped (fn [] (build) (vals @h/*projected*)))\n            c (static-counts vs)]\n        (swap! totals #(merge-with + % (assoc c :cases 1)))\n        (when-not (contains? link n) (swap! lane #(merge-with + % (assoc c :cases 1))))))\n    (println \"STATIC reference matrix:\" @totals)\n    (println \"STATIC lane fragment:\" @lane)\n    (let [row1 (s/let1 'a h/read-op (h/cat-of (h/cat-of (s/lit []) (s/v 'a)) h/read-op))\n          row22 (s/let1 'pair (s/lam ['p 'q] (h/cat-of (h/cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n                        (s/app (s/v 'pair) (s/lit nil) h/read-op))]\n      (doseq [[label wrap _] h/segments]\n        (let [a1 (h/with-stream (h/with-cat (wrap row1)))\n              a22 (h/with-stream (h/with-cat (wrap row22)))\n              v1 (h/project a1) v22 (h/project a22)]\n          (println \"DYNAMIC\" label \"row1 steps\" (steps-to-park a1) \"pcs\" (count v1)\n                   \"row22 steps\" (steps-to-park a22) \"pcs\" (count v22)))))\n    (is true)))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":22635,"cache_read_input_tokens":198110,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22635},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f7716a8d-bcb9-4b49-9ad0-ed6a5daed388","uuid":"d7caf4bd-aad4-4fc7-b7fd-2584da4b557c","timestamp":"2026-10-13T09:51:10.250Z","request_id":"req_011Cfz2dNX2QfbymDjLegL5y","wire_tool_inputs":{"toolu_015eLUUzhoYazrY5z1EAi3PR":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/semantic_register/anypc_probe_test.cljc","content":"(ns yin.vm.semantic-register.anypc-probe-test\n  \"Throwaway probe: how many pcs the harness corpus has (static), and the\n   dynamic step count of representative rows. Deleted after the report.\"\n  (:require [clojure.test :refer [deftest is]]\n            [yin.vm :as vm]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.safepoint-harness-test :as h]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(defn- parking? [t]\n  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n      (= :call (nth t 0))))\n\n\n(defn- static-counts [vs]\n  (reduce (fn [acc v]\n            (let [reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n              (-> acc\n                  (update :pcs + (count v))\n                  (update :reachable + (count reach))\n                  (update :parking + (count (filter #(parking? (nth v %)) reach)))\n                  (update :vectors inc))))\n          {:pcs 0 :reachable 0 :parking 0 :vectors 0}\n          vs))\n\n\n(defn- steps-to-park [ast]\n  (loop [m (h/load-program (h/machine) ast) n 0]\n    (if (or (vm/blocked? m) (vm/halted? m) (> n 100000))\n      n\n      (recur (vm/step m) (inc n)))))\n\n\n(deftest probe\n  (let [cases (h/matrix-cases)\n        totals (atom {:pcs 0 :reachable 0 :parking 0 :vectors 0 :cases 0})\n        lane (atom {:pcs 0 :reachable 0 :parking 0 :vectors 0 :cases 0})\n        link #{7 8 9 10 11 12 17}]\n    (doseq [[n _ _ build] cases]\n      (let [vs (h/scoped (fn [] (build) (vals @h/*projected*)))\n            c (static-counts vs)]\n        (swap! totals #(merge-with + % (assoc c :cases 1)))\n        (when-not (contains? link n) (swap! lane #(merge-with + % (assoc c :cases 1))))))\n    (println \"STATIC reference matrix:\" @totals)\n    (println \"STATIC lane fragment:\" @lane)\n    (let [row1 (s/let1 'a h/read-op (h/cat-of (h/cat-of (s/lit []) (s/v 'a)) h/read-op))\n          row22 (s/let1 'pair (s/lam ['p 'q] (h/cat-of (h/cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n                        (s/app (s/v 'pair) (s/lit nil) h/read-op))]\n      (doseq [[label wrap _] h/segments]\n        (let [a1 (h/with-stream (h/with-cat (wrap row1)))\n              a22 (h/with-stream (h/with-cat (wrap row22)))\n              v1 (h/project a1) v22 (h/project a22)]\n          (println \"DYNAMIC\" label \"row1 steps\" (steps-to-park a1) \"pcs\" (count v1)\n                   \"row22 steps\" (steps-to-park a22) \"pcs\" (count v22)))))\n    (is true)))\n"}}}
