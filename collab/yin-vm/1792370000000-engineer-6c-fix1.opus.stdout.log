6\t(defn logical-root\n1487\t  \"§5.5: the lift's root id with every lane identity replaced by the\n1488\t   fixture's logical name.\"\n1489\t  [wire m peer]\n1490\t  (:yin.k/root (rows/canonical-under (rows/emit (logical-positions (rows/decode wire) m))\n1491\t                                     (logical-names m peer))))\n1492\t\n1493\t\n1494\t(defn lane-root\n1495\t  \"Build on lane, lift: [root under the logical names, the lane's own\n1496\t   reference run].\"\n1497\t  [lane build]\n1498\t  (scoped\n1499\t    (fn []\n1500\t      (let [world (on-lane lane build)\n1501\t            {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n1502\t            wire (lane-lift (:machine world) serve!)]\n1503\t        (is (nil? (rows/validate-frames (rows/decode wire))) \"law 6 on every lane\")\n1504\t        [(logical-root wire (:machine world) peer)\n1505\t         (reference (on-lane lane build))]))))\n1506\t\n1507\t\n1508\t(defn canonical-equality\n1509\t  \"Law 4 for one case: the three lanes lift to one root, and each lane's\n1510\t   own run answers the reference.\"\n1511\t  [build expected]\n1512\t  (let [roots (mapv #(lane-root % build) lanes)]\n1513\t    (is (apply = (map first roots)) \"law 4: one root id on every lane\")\n1514\t    (doseq [[lane [_ ref]] (map vector lanes roots)]\n1515\t      (is (:halted ref) (str lane \" completes\"))\n1516\t      (when (some? expected) (is (= expected (:value ref)) (str lane \" answers the reference\"))))\n1517\t    roots))\n1518\t\n1519\t\n1520\t(deftest cross-engine-canonical-equality-bare"}]},"parent_tool_use_id":null,"session_id":"3f1acc3a-6522-479d-80d2-e73f91937106","uuid":"e25ef927-a1df-4682-8e7a-8902f9a66a76","timestamp":"2026-10-12T18:39:50.525Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"\n\n(defn logical-names\n  \"§5.5's explicit correspondence: each served identity to the resource\n   key the lifted machine holds that handle under. The fixture builds the\n   same program on every lane, so one key names one logical stream.\"\n  [m peer]\n  (into {} (map (fn [[id e]]\n                  [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n                          (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n        @(:table peer)))\n\n\n(defn ring-names\n  \"{stream identity -> resource key} over every stream m holds.\"\n  [m]\n  (into {} (keep (fn [[k h]]\n                   (when (satisfies? stream/IDaoStreamDescriptor h)\n                     [(:dao.stream/identity (stream/descriptor h)) k])))\n        (:resources m)))\n\n\n(defn logical-positions\n  \"The task with each cursor position's embedded stream identity renamed\n   to its logical name. A ring buffer cursor carries its stream's\n   identity, which §5.5's marker substitution does not reach (reported\n   as a design defect), so the cross-lane comparison renames it under\n   the same fixture correspondence.\"\n  [task m]\n  (let [names (ring-names m)\n        k :dao.stream.ringbuffer/identity]\n    (replace-nodes task #(= :cursor-cell-body (:kind %))\n                   (fn [n]\n                     (update-in n [:slots 1]\n                                (fn [p]\n                                  (if (and (map? p) (contains? names (get p k)))\n                                    (assoc p k (get names (get p k)))\n                                    p)))))))\n\n\n(defn logical-root\n  \"§5.5: the lift's root id with every lane identity replaced by the\n   fixture's logical name.\"\n  [wire m peer]\n  (:yin.k/root (rows/canonical-under (rows/emit (logical-positions (rows/decode wire) m))\n                                     (logical-names m peer))))\n\n\n(defn lane-root\n  \"Build on lane, lift: [root under the logical names, the lane's own\n   reference run].\"\n  [lane build]\n  (scoped\n    (fn []\n      (let [world (on-lane lane build)\n            {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n            wire (lane-lift (:machine world) serve!)]\n        (is (nil? (rows/validate-frames (rows/decode wire))) \"law 6 on every lane\")\n        [(logical-root wire (:machine world) peer)\n         (reference (on-lane lane build))]))))\n\n\n(defn canonical-equality\n  \"Law 4 for one case: the three lanes lift to one root, and each lane's\n   own run answers the reference.\"\n  [build expected]\n  (let [roots (mapv #(lane-root % build) lanes)]\n    (is (apply = (map first roots)) \"law 4: one root id on every lane\")\n    (doseq [[lane [_ ref]] (map vector lanes roots)]\n      (is (:halted ref) (str lane \" completes\"))\n      (when (some? expected) (is (= expected (:value ref)) (str lane \" answers the reference\"))))\n    roots))\n\n\n(deftest cross-engine-canonical-equality-bare","numLines":75,"startLine":1446,"totalLines":1693}},"tool_result_meta":[{"id":"toolu_01G4wDTJpunGwzqJk4SSz6kN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
