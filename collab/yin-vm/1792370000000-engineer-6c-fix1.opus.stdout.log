{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AmJ66gE3WdmykrKAJYZM81","type":"tool_result","content":"20\t   layout refusals close the file.\"\n21\t  (:require [clojure.test :refer [deftest is testing]]\n22\t            [dao.jing :as jing]\n23\t            [dao.stream :as stream]\n24\t            [dao.stream.apply :as apply2]\n25\t            [dao.test-slow :as slow]\n26\t            [yin.vm :as vm]\n27\t            [yin.vm.engine :as engine]\n28\t            [yin.vm.ffi :as ffi]\n29\t            [yin.vm.module :as module]\n30\t            [yin.vm.values :as values]\n31\t            [yin.vm.test-utils :as tu]\n32\t            [yin.vm.semantic-register :as sr]\n33\t            [yin.vm.debruijn.register :as rvm]\n34\t            [yin.vm.debruijn.stack :as dvm]\n35\t            [yin.vm.semantic-register.code :as code]\n36\t            [yin.vm.semantic-register.frame :as frame]\n37\t            [yin.vm.semantic-register.frame-test :as ft]\n38\t            [yin.vm.semantic-register.layout :as layout]\n39\t            [yin.vm.semantic-register.linearize :as linearize]\n40\t            [yin.vm.ucf.lift-support :as support]\n41\t            [yin.vm.ucf.rows :as rows]\n42\t            [yin.vm.ucf.v2-support :as s]))\n43\t\n44\t\n45\t;; =============================================================================\n46\t;; The composition: code by A, the source index, one machine builder\n47\t;; =============================================================================\n48\t\n49\t(def source-index\n50\t  \"The composition's {A #{tree-address}} (§6.1): every vector this\n51\t   harness projects is recorded beside the address of its AST.\"\n52\t  (atom {}))\n53\t\n54\t\n55\t(def code-index\n56\t  \"{A v}: every vector this harness projects, for the layouts' spaces.\"\n57\t  (atom {}))\n58\t\n59\t\n60\t(defn project\n61\t  [ast]\n62\t  (let [v (:vector (linearize/project ast))\n63\t        a (jing/segment-key v)]\n64\t    (swap! source-index update a (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n65\t    (swap! code-index assoc a v)\n66\t    v))\n67\t\n68\t\n69\t(def stream-modules (module/register-stream-module (module/default-registry)))\n70\t\n71\t\n72\t(def ^:dynamic *lane*\n73\t  \"The kernel a world is built on: :semantic-register (the reference\n74\t   lane), or :stack or :register, which run A's derived image and lift\n75\t   and lower through the layouts (§5.3).\"\n76\t  :semantic-register)\n77\t\n78\t\n79\t(def lanes [:semantic-register :stack :register])\n80\t\n81\t\n82\t(defn- composition\n83\t  [opts]\n84\t  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n85\t          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n86\t          :modules stream-modules}\n87\t         opts))\n88\t\n89\t\n90\t(defn- kernel-opts\n91\t  \"A de Bruijn kernel's options for the same composition: the full\n92\t   primitive table, and the initial environment as :free-env.\"\n93\t  [opts]\n94\t  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n95\t    (contains? opts :env) (assoc :free-env (:env opts))))\n96\t\n97\t\n98\t(defn machine\n99\t  ([] (machine {}))\n100\t  ([opts]\n101\t   (case *lane*\n102\t     :semantic-register (sr/create-vm (composition opts))\n103\t     :stack (dvm/create-vm [] (kernel-opts opts))\n104\t     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n105\t\n106\t\n107\t(defn lane-of\n108\t  [m]\n109\t  (let [f (:format (module/link-format m))]\n110\t    (cond (= dvm/format-tag f) :stack\n111\t          (= rvm/format-tag f) :register\n112\t          :else :semantic-register)))\n113\t\n114\t\n115\t(def segment-of\n116\t  \"layout/segment, once per A.\"\n117\t  (memoize layout/segment))\n118\t\n119\t\n120\t(defn kernel-space\n121\t  \"The layout space of the A vectors whose images de Bruijn kernel k holds.\"\n122\t  [k]\n123\t  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n124\t        held (into #{} (map first) (:images k))]\n125\t    (layout/space (filter #(contains? held (id %)) (map segment-of (vals @code-index))))))\n126\t\n127\t\n128\t(defn- kernel-load\n129\t  \"Attach v's derived image and start it at its row, beside whatever the\n130\t   kernel already holds: parked records keep naming their own rows.\"\n131\t  [k v]\n132\t  (let [kind (lane-of k)\n133\t        sg (segment-of v)\n134\t        k (if (= :stack kind)\n135\t            (dvm/attach-image k (:stack sg) vm/stack-contract)\n136\t            (rvm/attach-image k (:register sg) vm/register-contract))\n137\t        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n138\t                 :halted? false :blocked? false :value nil)]\n139\t    (if (= :stack kind)\n140\t      (assoc k :stack [])\n141\t      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n142\t\n143\t\n144\t(defn load-program\n145\t  [m ast]\n146\t  (if (= :semantic-register (lane-of m))\n147\t    (sr/load-vector m (project ast) code/contract)\n148\t    (kernel-load m (project ast))))\n149\t\n150\t\n151\t(defn lane-closure\n152\t  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n153\t  [m c]\n154\t  (if (= :semantic-register (lane-of m))\n155\t    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n156\t    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n157\t\n158\t\n159\t(defn lift-opts\n160\t  []\n161\t  {:source-index @source-index})\n162\t\n163\t\n164\t(defn error\n165\t  [f]\n166\t  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n167\t\n168\t\n169\t;; =============================================================================\n170\t;; The corpus: four segments around one parking expression\n171\t;; =============================================================================\n172\t\n173\t(defn cat-of\n174\t  [p q]\n175\t  (s/app (s/v 'cat) p q))\n176\t\n177\t\n178\t(defn with-cat\n179\t  [ast]\n180\t  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n181\t\n182\t\n183\t(defn nest\n184\t  [d op]\n185\t  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n186\t\n187\t\n188\t(def segments\n189\t  \"[label wrap expected-of-bare-result] (§5.2).\""}]},"parent_tool_use_id":null,"session_id":"3f1acc3a-6522-479d-80d2-e73f91937106","uuid":"5c7bde03-b653-462f-a2f0-32a4cda54e8e","timestamp":"2026-10-12T18:32:40.869Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"   layout refusals close the file.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.apply :as apply2]\n            [dao.test-slow :as slow]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.semantic-register :as sr]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.frame-test :as ft]\n            [yin.vm.semantic-register.layout :as layout]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.ucf.lift-support :as support]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n;; =============================================================================\n;; The composition: code by A, the source index, one machine builder\n;; =============================================================================\n\n(def source-index\n  \"The composition's {A #{tree-address}} (§6.1): every vector this\n   harness projects is recorded beside the address of its AST.\"\n  (atom {}))\n\n\n(def code-index\n  \"{A v}: every vector this harness projects, for the layouts' spaces.\"\n  (atom {}))\n\n\n(defn project\n  [ast]\n  (let [v (:vector (linearize/project ast))\n        a (jing/segment-key v)]\n    (swap! source-index update a (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n    (swap! code-index assoc a v)\n    v))\n\n\n(def stream-modules (module/register-stream-module (module/default-registry)))\n\n\n(def ^:dynamic *lane*\n  \"The kernel a world is built on: :semantic-register (the reference\n   lane), or :stack or :register, which run A's derived image and lift\n   and lower through the layouts (§5.3).\"\n  :semantic-register)\n\n\n(def lanes [:semantic-register :stack :register])\n\n\n(defn- composition\n  [opts]\n  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n          :modules stream-modules}\n         opts))\n\n\n(defn- kernel-opts\n  \"A de Bruijn kernel's options for the same composition: the full\n   primitive table, and the initial environment as :free-env.\"\n  [opts]\n  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n    (contains? opts :env) (assoc :free-env (:env opts))))\n\n\n(defn machine\n  ([] (machine {}))\n  ([opts]\n   (case *lane*\n     :semantic-register (sr/create-vm (composition opts))\n     :stack (dvm/create-vm [] (kernel-opts opts))\n     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n\n\n(defn lane-of\n  [m]\n  (let [f (:format (module/link-format m))]\n    (cond (= dvm/format-tag f) :stack\n          (= rvm/format-tag f) :register\n          :else :semantic-register)))\n\n\n(def segment-of\n  \"layout/segment, once per A.\"\n  (memoize layout/segment))\n\n\n(defn kernel-space\n  \"The layout space of the A vectors whose images de Bruijn kernel k holds.\"\n  [k]\n  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n        held (into #{} (map first) (:images k))]\n    (layout/space (filter #(contains? held (id %)) (map segment-of (vals @code-index))))))\n\n\n(defn- kernel-load\n  \"Attach v's derived image and start it at its row, beside whatever the\n   kernel already holds: parked records keep naming their own rows.\"\n  [k v]\n  (let [kind (lane-of k)\n        sg (segment-of v)\n        k (if (= :stack kind)\n            (dvm/attach-image k (:stack sg) vm/stack-contract)\n            (rvm/attach-image k (:register sg) vm/register-contract))\n        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n                 :halted? false :blocked? false :value nil)]\n    (if (= :stack kind)\n      (assoc k :stack [])\n      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n\n\n(defn load-program\n  [m ast]\n  (if (= :semantic-register (lane-of m))\n    (sr/load-vector m (project ast) code/contract)\n    (kernel-load m (project ast))))\n\n\n(defn lane-closure\n  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n  [m c]\n  (if (= :semantic-register (lane-of m))\n    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n;; =============================================================================\n;; The corpus: four segments around one parking expression\n;; =============================================================================\n\n(defn cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn nest\n  [d op]\n  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n\n\n(def segments\n  \"[label wrap expected-of-bare-result] (§5.2).\"","numLines":170,"startLine":20,"totalLines":1672}},"tool_result_meta":[{"id":"toolu_01AmJ66gE3WdmykrKAJYZM81","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfxpdDrxpdYeef3HTNMdn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01E9rjf1Vwze4bPbHNxVgqaW","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","offset":1385,"limit":290},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2182,"cache_read_input_tokens":78282,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2182},"output_tokens":45,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3f1acc3a-6522-479d-80d2-e73f91937106","uuid":"942c8cdf-c17a-40a8-8cbf-4d9cb79bdd91","timestamp":"2026-10-12T18:32:41.445Z","request_id":"req_011CfxpdDc5so529NkidtbFw","wire_tool_inputs":{"toolu_01E9rjf1Vwze4bPbHNxVgqaW":{"file_path":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","offset":1385,"limit":290}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E9rjf1Vwze4bPbHNxVgqaW","type":"tool_result","content":"1385\t\n1386\t;; =============================================================================\n1387\t;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n1388\t;; =============================================================================\n1389\t\n1390\t(def link-rows\n1391\t  \"Rows the de Bruijn lanes do not carry: a require installs a child and\n1392\t   attaches a module image in the kernel's own format, and the layouts\n1393\t   of §4 reconstruct no install child (canonical-task refuses\n1394\t   :installs).\"\n1395\t  #{7 8 9 10 11 12 17})\n1396\t\n1397\t\n1398\t(def lane-rows\n1399\t  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n1400\t  (filterv #(not (contains? link-rows (first %))) rows))\n1401\t\n1402\t\n1403\t(defn lane-cases\n1404\t  \"15 lane rows x 4 segments, plus row 20 once: [row segment expected build].\"\n1405\t  []\n1406\t  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n1407\t\n1408\t\n1409\t(defn on-lane\n1410\t  [lane build]\n1411\t  (binding [*lane* lane] (build)))\n1412\t\n1413\t\n1414\t(defn lane-lift\n1415\t  \"The lift of §7.1 on m's own lane.\"\n1416\t  [m serve!]\n1417\t  (if (= :semantic-register (lane-of m))\n1418\t    (rows/lift-task m serve! (lift-opts))\n1419\t    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n1420\t\n1421\t\n1422\t(defn lane-lower\n1423\t  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n1424\t  [lane opts wire attach!]\n1425\t  (let [scratch (on-lane :semantic-register #(machine opts))]\n1426\t    (if (= :semantic-register lane)\n1427\t      (rows/lower-task scratch wire attach!)\n1428\t      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n1429\t\n1430\t\n1431\t(defn logical-names\n1432\t  \"§5.5's explicit correspondence: each served identity to the resource\n1433\t   key the lifted machine holds that handle under. The fixture builds the\n1434\t   same program on every lane, so one key names one logical stream.\"\n1435\t  [m peer]\n1436\t  (into {} (map (fn [[id e]]\n1437\t                  [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n1438\t                          (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n1439\t        @(:table peer)))\n1440\t\n1441\t\n1442\t(defn ring-names\n1443\t  \"{stream identity -> resource key} over every stream m holds.\"\n1444\t  [m]\n1445\t  (into {} (keep (fn [[k h]]\n1446\t                   (when (satisfies? stream/IDaoStreamDescriptor h)\n1447\t                     [(:dao.stream/identity (stream/descriptor h)) k])))\n1448\t        (:resources m)))\n1449\t\n1450\t\n1451\t(defn logical-positions\n1452\t  \"The task with each cursor position's embedded stream identity renamed\n1453\t   to its logical name. A ring buffer cursor carries its stream's\n1454\t   identity, which §5.5's marker substitution does not reach (reported\n1455\t   as a design defect), so the cross-lane comparison renames it under\n1456\t   the same fixture correspondence.\"\n1457\t  [task m]\n1458\t  (let [names (ring-names m)\n1459\t        k :dao.stream.ringbuffer/identity]\n1460\t    (replace-nodes task #(= :cursor-cell-body (:kind %))\n1461\t                   (fn [n]\n1462\t                     (update-in n [:slots 1]\n1463\t                                (fn [p]\n1464\t                                  (if (and (map? p) (contains? names (get p k)))\n1465\t                                    (assoc p k (get names (get p k)))\n1466\t                                    p)))))))\n1467\t\n1468\t\n1469\t(defn logical-root\n1470\t  \"§5.5: the lift's root id with every lane identity replaced by the\n1471\t   fixture's logical name.\"\n1472\t  [wire m peer]\n1473\t  (:yin.k/root (rows/canonical-under (rows/emit (logical-positions (rows/decode wire) m))\n1474\t                                     (logical-names m peer))))\n1475\t\n1476\t\n1477\t(defn lane-root\n1478\t  \"Build on lane, lift: [root under the logical names, the lane's own\n1479\t   reference run].\"\n1480\t  [lane build]\n1481\t  (let [world (on-lane lane build)\n1482\t        {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n1483\t        wire (lane-lift (:machine world) serve!)]\n1484\t    (is (nil? (rows/validate-frames (rows/decode wire))) \"law 6 on every lane\")\n1485\t    [(logical-root wire (:machine world) peer)\n1486\t     (reference (on-lane lane build))]))\n1487\t\n1488\t\n1489\t(defn canonical-equality\n1490\t  \"Law 4 for one case: the three lanes lift to one root, and each lane's\n1491\t   own run answers the reference.\"\n1492\t  [build expected]\n1493\t  (let [roots (mapv #(lane-root % build) lanes)]\n1494\t    (is (apply = (map first roots)) \"law 4: one root id on every lane\")\n1495\t    (doseq [[lane [_ ref]] (map vector lanes roots)]\n1496\t      (is (:halted ref) (str lane \" completes\"))\n1497\t      (when (some? expected) (is (= expected (:value ref)) (str lane \" answers the reference\"))))\n1498\t    roots))\n1499\t\n1500\t\n1501\t(deftest cross-engine-canonical-equality-bare\n1502\t  ;; the quick-tier slice of acceptance 10: every lane row once, bare\n1503\t  (let [n (atom 0)]\n1504\t    (doseq [[row r build] lane-rows]\n1505\t      (testing (str \"row \" row)\n1506\t        (canonical-equality #(build identity) r)\n1507\t        (swap! n inc)))\n1508\t    (testing \"row 20\"\n1509\t      (canonical-equality tail-effect-halt \"B\")\n1510\t      (swap! n inc))\n1511\t    (is (= 16 @n))))\n1512\t\n1513\t\n1514\t(deftest ^:slow cross-engine-canonical-equality\n1515\t  (slow/guard\n1516\t    \"cross-engine-canonical-equality\"\n1517\t    (fn []\n1518\t      (let [cases (lane-cases) n (atom 0)]\n1519\t        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n1520\t        (doseq [[row label expected build] cases]\n1521\t          (testing (str \"row \" row \" \" (name label))\n1522\t            (canonical-equality build expected)\n1523\t            (swap! n inc)))\n1524\t        (is (= 61 @n))))))\n1525\t\n1526\t\n1527\t(def ordered-pairs\n1528\t  \"Law 5's six ordered pairs of distinct lanes.\"\n1529\t  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n1530\t\n1531\t\n1532\t(def unlowerable\n1533\t  \"[row receiver] pairs a de Bruijn receiver cannot continue: row 4's\n1534\t   retained FFI re-parks through the kernel's own call-out pair\n1535\t   (ffi/response-wait-entry), not the carried response cursor cell the\n1536\t   semantic-register kernel restores. A kernel seam, reported.\"\n1537\t  #{[4 :stack] [4 :register]})\n1538\t\n1539\t\n1540\t(defn crossed\n1541\t  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n1542\t   source's streams: the run's observables and attaches.\"\n1543\t  [from to build]\n1544\t  (let [world (on-lane from build)\n1545\t        {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n1546\t        wire (lane-lift (:machine world) serve!)\n1547\t        receiver ((or (:receiver world) (constantly nil)))\n1548\t        {:keys [attach!] n :count} (recording-attacher toy)\n1549\t        recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n1550\t        _ (is (= to (lane-of recv)))\n1551\t        attaches @n\n1552\t        done (satisfy world recv #(drive-peers % [peer]))\n1553\t        _ (s/serve-mirror! peer)]\n1554\t    (when-let [f (:finish world)] (f))\n1555\t    (when-let [f (:finish receiver)] (f))\n1556\t    {:attaches attaches :wire wire\n1557\t     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n1558\t\n1559\t\n1560\t(defn cross-lowering\n1561\t  \"Law 5 for one case: every admitted ordered pair continues to the\n1562\t   reference. Answers the pairs that ran.\"\n1563\t  [row build]\n1564\t  (let [ref (reference (on-lane :semantic-register build))]\n1565\t    (is (:halted ref))\n1566\t    (reduce (fn [ran [from to]]\n1567\t              (if (contains? unlowerable [row to])\n1568\t                ran\n1569\t                (testing (str (name from) \" -> \" (name to))\n1570\t                  (let [got (crossed from to build)]\n1571\t                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n1572\t                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n1573\t                        \"law 5: the lowered run continues to the reference\")\n1574\t                    (conj ran [from to])))))\n1575\t            []\n1576\t            ordered-pairs)))\n1577\t\n1578\t\n1579\t(deftest cross-engine-lowering-bare\n1580\t  ;; the quick-tier slice of acceptance 11: every lane row once, bare\n1581\t  (is (= 6 (count ordered-pairs)))\n1582\t  (let [ran (atom 0)]\n1583\t    (doseq [[row _ build] lane-rows]\n1584\t      (testing (str \"row \" row)\n1585\t        (let [pairs (cross-lowering row #(build identity))]\n1586\t          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n1587\t          (swap! ran + (count pairs)))))\n1588\t    (testing \"row 20\"\n1589\t      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n1590\t      (swap! ran + 6))\n1591\t    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n1592\t\n1593\t\n1594\t(deftest ^:slow cross-engine-lowering\n1595\t  (slow/guard\n1596\t    \"cross-engine-lowering\"\n1597\t    (fn []\n1598\t      (let [ran (atom 0) cases (lane-cases)]\n1599\t        (is (= 61 (count cases)))\n1600\t        (doseq [[row label _ build] cases]\n1601\t          (testing (str \"row \" row \" \" (name label))\n1602\t            (swap! ran + (count (cross-lowering row build)))))\n1603\t        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n1604\t\n1605\t\n1606\t(defn register-judge\n1607\t  \"The frame validator's verdict on register entry `entry` of m,\n1608\t   reconstructed through the layout.\"\n1609\t  [m entry]\n1610\t  (let [sp (kernel-space m)\n1611\t        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n1612\t        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n1613\t        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n1614\t    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n1615\t\n1616\t\n1617\t(defn spare-register\n1618\t  \"A physical register of the entry's body outside its live set and its\n1619\t   destination that R gives exactly one virtual.\"\n1620\t  [m entry]\n1621\t  (let [sg (val (first (:segments (kernel-space m))))\n1622\t        site (- (:site-pc entry) (layout/offset :register m sg))\n1623\t        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n1624\t        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n1625\t    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n1626\t\n1627\t\n1628\t(deftest layout-refusals\n1629\t  (testing \"a kernel stepped to a non-safepoint pc\"\n1630\t    (doseq [lane [:stack :register]]\n1631\t      (testing (name lane)\n1632\t        (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n1633\t              n (atom 0)\n1634\t              {:keys [serve!]} (served #{:reader})\n1635\t              d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n1636\t          (is (not (vm/halted? m)))\n1637\t          (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n1638\t          (is (zero? @n) \"no stream was served\")\n1639\t          (testing \", its registers read as a payload\"\n1640\t            (let [entry (if (= :stack lane)\n1641\t                          (select-keys m [:pc :frames :stack :continuation])\n1642\t                          (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n1643\t                  cx (layout/lift-context m (kernel-space m) (:owner m))]\n1644\t              (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))\n1645\t  (testing \"a register entry whose live was tampered\"\n1646\t    (let [m (:machine (on-lane :register #(bare 1)))\n1647\t          entry (first (:wait-set m))\n1648\t          live (:live entry)\n1649\t          spare (spare-register m entry)]\n1650\t      (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n1651\t      (is (seq live))\n1652\t      (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n1653\t          \"a live register dropped\")\n1654\t      (is (some? spare))\n1655\t      (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n1656\t                                                    :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n1657\t          \"a dead register added\")))\n1658\t  (testing \"a primitive in a window: the register kernel cannot hold it, refused before any attach\"\n1659\t    (let [build #(reader % (s/app (s/v 'conj) (s/lit []) read-op))\n1660\t          world (build identity)\n1661\t          {:keys [serve! toy]} (served #{:reader})\n1662\t          wire (rows/lift-task (:machine world) serve! (lift-opts))\n1663\t          {:keys [attach!] n :count} (recording-attacher toy)\n1664\t          d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n1665\t      (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n1666\t      (is (zero? @n) \"refused before any attachment\")\n1667\t      (testing \", the stack kernel holds it\"\n1668\t        (let [ref (reference (build identity))\n1669\t              got (crossed :semantic-register :stack #(build identity))]\n1670\t          (is (= [\"B\"] (:value ref)))\n1671\t          (is (= (:value ref) (:value got))))))))\n1672\t"}]},"parent_tool_use_id":null,"session_id":"3f1acc3a-6522-479d-80d2-e73f91937106","uuid":"6b56b8b4-3652-4780-a2ac-f400cb731e16","timestamp":"2026-10-12T18:32:41.459Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"\n;; =============================================================================\n;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n;; =============================================================================\n\n(def link-rows\n  \"Rows the de Bruijn lanes do not carry: a require installs a child and\n   attaches a module image in the kernel's own format, and the layouts\n   of §4 reconstruct no install child (canonical-task refuses\n   :installs).\"\n  #{7 8 9 10 11 12 17})\n\n\n(def lane-rows\n  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n  (filterv #(not (contains? link-rows (first %))) rows))\n\n\n(defn lane-cases\n  \"15 lane rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n\n\n(defn on-lane\n  [lane build]\n  (binding [*lane* lane] (build)))\n\n\n(defn lane-lift\n  \"The lift of §7.1 on m's own lane.\"\n  [m serve!]\n  (if (= :semantic-register (lane-of m))\n    (rows/lift-task m serve! (lift-opts))\n    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n\n\n(defn lane-lower\n  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n  [lane opts wire attach!]\n  (let [scratch (on-lane :semantic-register #(machine opts))]\n    (if (= :semantic-register lane)\n      (rows/lower-task scratch wire attach!)\n      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n\n\n(defn logical-names\n  \"§5.5's explicit correspondence: each served identity to the resource\n   key the lifted machine holds that handle under. The fixture builds the\n   same program on every lane, so one key names one logical stream.\"\n  [m peer]\n  (into {} (map (fn [[id e]]\n                  [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n                          (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n        @(:table peer)))\n\n\n(defn ring-names\n  \"{stream identity -> resource key} over every stream m holds.\"\n  [m]\n  (into {} (keep (fn [[k h]]\n                   (when (satisfies? stream/IDaoStreamDescriptor h)\n                     [(:dao.stream/identity (stream/descriptor h)) k])))\n        (:resources m)))\n\n\n(defn logical-positions\n  \"The task with each cursor position's embedded stream identity renamed\n   to its logical name. A ring buffer cursor carries its stream's\n   identity, which §5.5's marker substitution does not reach (reported\n   as a design defect), so the cross-lane comparison renames it under\n   the same fixture correspondence.\"\n  [task m]\n  (let [names (ring-names m)\n        k :dao.stream.ringbuffer/identity]\n    (replace-nodes task #(= :cursor-cell-body (:kind %))\n                   (fn [n]\n                     (update-in n [:slots 1]\n                                (fn [p]\n                                  (if (and (map? p) (contains? names (get p k)))\n                                    (assoc p k (get names (get p k)))\n                                    p)))))))\n\n\n(defn logical-root\n  \"§5.5: the lift's root id with every lane identity replaced by the\n   fixture's logical name.\"\n  [wire m peer]\n  (:yin.k/root (rows/canonical-under (rows/emit (logical-positions (rows/decode wire) m))\n                                     (logical-names m peer))))\n\n\n(defn lane-root\n  \"Build on lane, lift: [root under the logical names, the lane's own\n   reference run].\"\n  [lane build]\n  (let [world (on-lane lane build)\n        {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n        wire (lane-lift (:machine world) serve!)]\n    (is (nil? (rows/validate-frames (rows/decode wire))) \"law 6 on every lane\")\n    [(logical-root wire (:machine world) peer)\n     (reference (on-lane lane build))]))\n\n\n(defn canonical-equality\n  \"Law 4 for one case: the three lanes lift to one root, and each lane's\n   own run answers the reference.\"\n  [build expected]\n  (let [roots (mapv #(lane-root % build) lanes)]\n    (is (apply = (map first roots)) \"law 4: one root id on every lane\")\n    (doseq [[lane [_ ref]] (map vector lanes roots)]\n      (is (:halted ref) (str lane \" completes\"))\n      (when (some? expected) (is (= expected (:value ref)) (str lane \" answers the reference\"))))\n    roots))\n\n\n(deftest cross-engine-canonical-equality-bare\n  ;; the quick-tier slice of acceptance 10: every lane row once, bare\n  (let [n (atom 0)]\n    (doseq [[row r build] lane-rows]\n      (testing (str \"row \" row)\n        (canonical-equality #(build identity) r)\n        (swap! n inc)))\n    (testing \"row 20\"\n      (canonical-equality tail-effect-halt \"B\")\n      (swap! n inc))\n    (is (= 16 @n))))\n\n\n(deftest ^:slow cross-engine-canonical-equality\n  (slow/guard\n    \"cross-engine-canonical-equality\"\n    (fn []\n      (let [cases (lane-cases) n (atom 0)]\n        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n        (doseq [[row label expected build] cases]\n          (testing (str \"row \" row \" \" (name label))\n            (canonical-equality build expected)\n            (swap! n inc)))\n        (is (= 61 @n))))))\n\n\n(def ordered-pairs\n  \"Law 5's six ordered pairs of distinct lanes.\"\n  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n\n\n(def unlowerable\n  \"[row receiver] pairs a de Bruijn receiver cannot continue: row 4's\n   retained FFI re-parks through the kernel's own call-out pair\n   (ffi/response-wait-entry), not the carried response cursor cell the\n   semantic-register kernel restores. A kernel seam, reported.\"\n  #{[4 :stack] [4 :register]})\n\n\n(defn crossed\n  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n   source's streams: the run's observables and attaches.\"\n  [from to build]\n  (let [world (on-lane from build)\n        {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n        wire (lane-lift (:machine world) serve!)\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach!] n :count} (recording-attacher toy)\n        recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n        _ (is (= to (lane-of recv)))\n        attaches @n\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:attaches attaches :wire wire\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn cross-lowering\n  \"Law 5 for one case: every admitted ordered pair continues to the\n   reference. Answers the pairs that ran.\"\n  [row build]\n  (let [ref (reference (on-lane :semantic-register build))]\n    (is (:halted ref))\n    (reduce (fn [ran [from to]]\n              (if (contains? unlowerable [row to])\n                ran\n                (testing (str (name from) \" -> \" (name to))\n                  (let [got (crossed from to build)]\n                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n                        \"law 5: the lowered run continues to the reference\")\n                    (conj ran [from to])))))\n            []\n            ordered-pairs)))\n\n\n(deftest cross-engine-lowering-bare\n  ;; the quick-tier slice of acceptance 11: every lane row once, bare\n  (is (= 6 (count ordered-pairs)))\n  (let [ran (atom 0)]\n    (doseq [[row _ build] lane-rows]\n      (testing (str \"row \" row)\n        (let [pairs (cross-lowering row #(build identity))]\n          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n          (swap! ran + (count pairs)))))\n    (testing \"row 20\"\n      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n      (swap! ran + 6))\n    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n\n\n(deftest ^:slow cross-engine-lowering\n  (slow/guard\n    \"cross-engine-lowering\"\n    (fn []\n      (let [ran (atom 0) cases (lane-cases)]\n        (is (= 61 (count cases)))\n        (doseq [[row label _ build] cases]\n          (testing (str \"row \" row \" \" (name label))\n            (swap! ran + (count (cross-lowering row build)))))\n        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n\n\n(defn register-judge\n  \"The frame validator's verdict on register entry `entry` of m,\n   reconstructed through the layout.\"\n  [m entry]\n  (let [sp (kernel-space m)\n        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n\n\n(defn spare-register\n  \"A physical register of the entry's body outside its live set and its\n   destination that R gives exactly one virtual.\"\n  [m entry]\n  (let [sg (val (first (:segments (kernel-space m))))\n        site (- (:site-pc entry) (layout/offset :register m sg))\n        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n\n\n(deftest layout-refusals\n  (testing \"a kernel stepped to a non-safepoint pc\"\n    (doseq [lane [:stack :register]]\n      (testing (name lane)\n        (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n              n (atom 0)\n              {:keys [serve!]} (served #{:reader})\n              d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n          (is (not (vm/halted? m)))\n          (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n          (is (zero? @n) \"no stream was served\")\n          (testing \", its registers read as a payload\"\n            (let [entry (if (= :stack lane)\n                          (select-keys m [:pc :frames :stack :continuation])\n                          (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n                  cx (layout/lift-context m (kernel-space m) (:owner m))]\n              (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))\n  (testing \"a register entry whose live was tampered\"\n    (let [m (:machine (on-lane :register #(bare 1)))\n          entry (first (:wait-set m))\n          live (:live entry)\n          spare (spare-register m entry)]\n      (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n      (is (seq live))\n      (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n          \"a live register dropped\")\n      (is (some? spare))\n      (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n                                                    :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n          \"a dead register added\")))\n  (testing \"a primitive in a window: the register kernel cannot hold it, refused before any attach\"\n    (let [build #(reader % (s/app (s/v 'conj) (s/lit []) read-op))\n          world (build identity)\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task (:machine world) serve! (lift-opts))\n          {:keys [attach!] n :count} (recording-attacher toy)\n          d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n      (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n      (is (zero? @n) \"refused before any attachment\")\n      (testing \", the stack kernel holds it\"\n        (let [ref (reference (build identity))\n              got (crossed :semantic-register :stack #(build identity))]\n          (is (= [\"B\"] (:value ref)))\n          (is (= (:value ref) (:value got))))))))\n","numLines":288,"startLine":1385,"totalLines":1672}},"tool_result_meta":[{"id":"toolu_01E9rjf1Vwze4bPbHNxVgqaW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
