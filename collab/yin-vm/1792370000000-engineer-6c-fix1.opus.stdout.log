{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017DVaQRxkn8gGhEnr6je2fK","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.layout-test\n2\t  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic-register-vm.continuation.md\n3\t   §8.3): the register pairing and live sets, the register destination from\n4\t   A, the stack correspondence, operand layout and K slices, E\n5\t   reconstruction, closures both ways, and the unobservable fill of a\n6\t   lowered tail. The static items run over C, the B0 corpus and the\n7\t   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n8\t   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n9\t  (:require [clojure.test :refer [deftest is testing]]\n10\t            [dao.stream :as stream]\n11\t            [yin.vm :as vm]\n12\t            [yin.vm.debruijn-register-code :as rcode]\n13\t            [yin.vm.debruijn.register :as rvm]\n14\t            [yin.vm.debruijn.stack :as dvm]\n15\t            [yin.vm.engine :as engine]\n16\t            [yin.vm.parity-test :as b0]\n17\t            [yin.vm.values :as values]\n18\t            [yin.vm.semantic-register.analysis :as analysis]\n19\t            [yin.vm.semantic-register.code :as code]\n20\t            [yin.vm.semantic-register.corpus :as corpus]\n21\t            [yin.vm.semantic-register.layout :as layout]\n22\t            [yin.vm.semantic-register.linearize :as linearize]\n23\t            [yin.vm.semantic-register.safepoint-harness-test :as h]\n24\t            [yin.vm.ucf.v2-support :as s]))\n25\t\n26\t\n27\t(def C\n28\t  \"[label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n29\t   operand position, whose dead layout syntax reads registers other than\n30\t   the call's own (phase-5 §6.3's last golden).\"\n31\t  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n32\t        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n33\t\n34\t\n35\t(defn projected\n36\t  [ast]\n37\t  (:vector (linearize/project ast)))\n38\t\n39\t\n40\t(defn reachable-pcs\n41\t  \"Every pc reachable from its body's start.\"\n42\t  [v]\n43\t  (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v)))\n44\t\n45\t\n46\t(defn boundary?\n47\t  [t]\n48\t  (contains? rcode/boundary-opcodes (nth t 0)))\n49\t\n50\t\n51\t(defn parking?\n52\t  \"A non-tail parking instruction (rule A1).\"\n53\t  [t]\n54\t  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n55\t      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n56\t\n57\t\n58\t;; =============================================================================\n59\t;; 1-2: the register kernel's static layout\n60\t;; =============================================================================\n61\t\n62\t(deftest register-pairing\n63\t  (let [checked (atom [0 0])]\n64\t    (doseq [[label ast] C]\n65\t      (testing (str label)\n66\t        (let [v (projected ast)\n67\t              sg (layout/segment v)\n68\t              bodies (:bodies sg)]\n69\t          ;; phys is total on every body's named virtuals and single-valued\n70\t          (doseq [[pc x s] (:pairs sg)]\n71\t            (is (= s (layout/phys sg pc x)) (str \"pc \" pc \" virtual \" x)))\n72\t          (doseq [b (range (count bodies))]\n73\t            (let [named (into #{} (keep (fn [[pc x]] (when (= b (code/body-index bodies pc)) x))) (:pairs sg))]\n74\t              (is (= named (set (keys (nth (:phys sg) b)))))))\n75\t          ;; virt is single-valued on live-out's physical image\n76\t          (doseq [p (sort (reachable-pcs v))\n77\t                  :when (boundary? (nth v p))]\n78\t            (let [lo (layout/live-out sg p)]\n79\t              (is (= (count lo) (count (set (map #(layout/phys sg p %) lo))))\n80\t                  (str \"distinct live virtuals hold distinct slots at pc \" p))\n81\t              (doseq [x lo]\n82\t                (is (= x (layout/virt sg p (layout/phys sg p x))))))\n83\t            (swap! checked update 1 inc))\n84\t          (swap! checked update 0 inc))))\n85\t    (is (= (count C) (first @checked)))\n86\t    (is (< 50 (second @checked)) \"reachable boundaries checked\")))\n87\t\n88\t\n89\t(deftest register-live-is-live-out\n90\t  (let [tails (atom 0)]\n91\t    (doseq [[label ast] C]\n92\t      (testing (str label)\n93\t        (let [v (projected ast)\n94\t              sg (layout/segment v)]\n95\t          (doseq [p (sort (reachable-pcs v))\n96\t                  :let [t (nth v p)]\n97\t                  :when (boundary? t)]\n98\t            (let [live (nth (nth (:instructions (:register sg)) p) (rcode/live-slot-index (nth t 0)))]\n99\t              (is (= (layout/register-live sg p) live) (str \"pc \" p))\n100\t              (when (code/tail-call? t)\n101\t                (swap! tails inc)\n102\t                (is (= [] live (layout/register-live sg p)) \"a tail boundary's live is []\")))))))\n103\t    (is (pos? @tails))))\n104\t\n105\t\n106\t;; =============================================================================\n107\t;; 3: rd from A, never the physical destination\n108\t;; =============================================================================\n109\t\n110\t(def worked-ast (second (first (filter #(= :worked-example (first %)) corpus/programs))))\n111\t\n112\t\n113\t(defn lifted-waits\n114\t  \"The canonical wait entries of world machine m: the evaluator's own, or a\n115\t   de Bruijn kernel's through the layout.\"\n116\t  [m]\n117\t  (if (= :semantic-register (h/lane-of m))\n118\t    (:wait-set m)\n119\t    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n120\t\n121\t\n122\t(deftest register-rd-from-a\n123\t  (testing \"the worked example parked at its inner call\"\n124\t    (let [m0 (h/on-lane :register h/machine)\n125\t          [sref m1] (engine/attach-resource m0 (s/ring 4))\n126\t          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n127\t          next! (engine/resolve-var {} {} vm/primitives h/stream-modules 'stream/next!)\n128\t          m (vm/run (h/load-program (assoc m2 :free-env {'f (get vm/primitives 'conj) 'g next! 'x cref 'y 2})\n129\t                                    worked-ast))\n130\t          entry (first (:wait-set m))\n131\t          [p] (lifted-waits m)\n132\t          v (projected worked-ast)]\n133\t      (is (vm/blocked? m))\n134\t      (is (= [:call 2 3 [4] false] (nth v 3)) \"the inner call\")\n135\t      (is (= 4 (:pc p)))\n136\t      (is (= {:deliver :rd :rd 2} (:deliver p)) \"the canonical rd is A's 2\")\n137\t      (is (= 3 (:dest entry)) \"the kernel's dest is the physical 3\")\n138\t      (is (= #{1} (set (keys (:window p)))) \"saved(4, 2)\")))\n139\t  (testing \"the K frames of :depth-3 take rd from A\"\n140\t    (let [[_ wrap] (nth h/segments 2)\n141\t          build #(h/reader wrap h/read-op)\n142\t          reference (first (:wait-set (:machine (h/on-lane :semantic-register build))))\n143\t          m (:machine (h/on-lane :register build))\n144\t          entry (first (:wait-set m))\n145\t          [p] (lifted-waits m)]\n146\t      (is (= :depth-3 (first (nth h/segments 2))))\n147\t      (is (= 6 (count (:k p))) \"three bindings, three nest applications\")\n148\t      (is (= (mapv :rd (:k reference)) (mapv :rd (:k p))) \"the evaluator's return destinations\")\n149\t      (is (some (fn [[f kf]] (not= (:rd f) (:dest kf))) (map vector (:k p) (:continuation entry)))\n150\t          \"some physical dest differs from its virtual rd\"))))\n151\t\n152\t\n153\t;; =============================================================================\n154\t;; 4-5: the stack correspondence and operand layout\n155\t;; =============================================================================\n156\t\n157\t(defn family\n158\t  [op]\n159\t  (case op (:load-bound :load-free) :var op))\n160\t\n161\t\n162\t(deftest stack-correspondence\n163\t  (doseq [[label ast] C]\n164\t    (testing (str label)\n165\t      (let [v (projected ast)\n166\t            sg (layout/segment v)\n167\t            h (:stack sg)]\n168\t        (is (= (count v) (count (:a->h sg))) \"one non-push H instruction per A pc\")\n169\t        (is (= (count h) (+ (count v) (count (filter #(= :push (first %)) h)))))\n170\t        (doseq [k (range (count v))]\n171\t          (is (= (nth (nth v k) 0) (family (nth (nth h (nth (:a->h sg) k)) 0)))\n172\t              (str \"the k-th non-push instruction, k = \" k))\n173\t          (is (= k (get (:h->a sg) (nth (:a->h sg) k)))))))))\n174\t\n175\t\n176\t(deftest stack-layout-is-the-saved-set\n177\t  (let [checked (atom 0)]\n178\t    (doseq [[label ast] C]\n179\t      (testing (str label)\n180\t        (let [v (projected ast)\n181\t              sg (layout/segment v)\n182\t              a (:analysis sg)]\n183\t          (doseq [p (sort (reachable-pcs v))\n184\t                  :let [t (nth v p)]\n185\t                  :when (parking? t)]\n186\t            (is (= (analysis/saved a (inc p) (code/rd t)) (set (layout/stack-layout sg p))) (str \"pc \" p))\n187\t            (is (apply distinct? (cons ::bottom (layout/stack-layout sg p))))\n188\t            (swap! checked inc)))))\n189\t    (is (< 20 @checked)))\n190\t  (testing \"the worked cases\"\n191\t    (let [first-call (fn [v] (first (keep-indexed (fn [pc t] (when (= :call (first t)) pc)) v)))]\n192\t      (doseq [ast [worked-ast\n193\t                   (corpus/app (corpus/v 'f) (corpus/if-node (corpus/v 'c) (corpus/app (corpus/v 'g)) (corpus/lit 2))\n194\t                               (corpus/v 'y))]]\n195\t        (let [v (projected ast)\n196\t              sg (layout/segment v)]\n197\t          (is (= [1] (layout/stack-layout sg (first-call v))) \"[f], f in register 1\"))))))\n198\t\n199\t\n200\t;; =============================================================================\n201\t;; 6: K slices partition the operand stack\n202\t;; =============================================================================\n203\t\n204\t(defn stack-frames\n205\t  \"[[A-pc slice] …] for return frames then the current activation of\n206\t   stack entry e of kernel k, reading the kernel's own offset table.\"\n207\t  [k e]\n208\t  (let [sp (h/kernel-space k)\n209\t        a-pc (fn [abs]\n210\t               (let [[ident rel] (dvm/image-pc k abs)\n211\t                     sg (some #(when (= ident (:stack-id %)) %) (vals (:segments sp)))]\n212\t                 [sg (inc (get (:h->a sg) (dec rel)))]))\n213\t        parts (layout/slices (vec (:stack e)) (mapv :stack-base (:continuation e)))]\n214\t    (mapv (fn [abs slice] (conj (a-pc abs) slice))\n215\t          (conj (mapv :return-pc (:continuation e)) (:pc e))\n216\t          parts)))\n217\t\n218\t\n219\t(defn non-tail?\n220\t  \"6c-pre marks a tail call's park :return-result.\"\n221\t  [e]\n222\t  (not= :return-result (:resume-mode e)))\n223\t\n224\t\n225\t(deftest stack-slices-partition\n226\t  (let [checked (atom 0)]\n227\t    (doseq [[row label _ build] (h/lane-cases)\n228\t            :when (contains? #{:bare :depth-3 :unwrapped} label)]\n229\t      (testing (str \"row \" row \" \" (name label))\n230\t        (let [k (:machine (h/on-lane :stack build))]\n231\t          (doseq [e (concat (:wait-set k) (vals (:parked k)))\n232\t                  :when (non-tail? e)]\n233\t            (let [frames (stack-frames k e)]\n234\t              (is (= (vec (:stack e)) (into [] (mapcat #(nth % 2)) frames)) \"the slices partition the stack\")\n235\t              (doseq [[sg pc slice] frames]\n236\t                (is (= (count (layout/stack-layout sg (dec pc))) (count slice))))\n237\t              (swap! checked inc))))))\n238\t    (is (< 20 @checked)))\n239\t  (testing \"the multi-frame fixture\"\n240\t    (let [expr (h/cat-of (s/lit [1])\n241\t                         (s/app (s/lam ['x] (h/cat-of (s/lit [2])\n242\t                                                      (s/app (s/lam ['y] (h/cat-of (s/lit [3]) h/read-op))\n243\t                                                             (s/lit 2))))\n244\t                                (s/lit 1)))\n245\t          world (h/on-lane :stack #(h/reader identity expr))\n246\t          k (:machine world)\n247\t          e (first (:wait-set k))\n248\t          st (:stack e)]\n249\t      (is (= [0 0 0 2 4] (mapv :stack-base (:continuation e))) \"the bases, pinned from the kernel\")\n250\t      (is (= 6 (count st)))\n251\t      (is (= [[] [] [] 2 2 2] (mapv #(if (empty? %) [] (count %)) (layout/slices (vec st) [0 0 0 2 4]))))\n252\t      (is (= [[1] [2] [3]] (mapv #(nth st %) [1 3 5])) \"each slice holds its activation's cat and literal\")\n253\t      (is (every? values/closure? (map #(nth st %) [0 2 4])))\n254\t      (is (= (vec st) (into [] cat (layout/slices (vec st) [0 0 0 2 4]))))\n255\t      (let [sp (h/kernel-space k)\n256\t            p (layout/lift-state (layout/lift-context k sp (:owner k)) e)\n257\t            fresh (layout/attach-space (h/on-lane :stack h/machine) sp)\n258\t            lowered (layout/lower-state (layout/lower-context fresh sp) p)]\n259\t        (is (= 5 (count (:k p))))\n260\t        (is (= [0 0 0 2 4] (mapv :stack-base (:continuation lowered))) \"the lowering emits the same bases\")\n261\t        (is (= 6 (count (:stack lowered))))\n262\t        (is (= (h/normalize (:stack e)) (h/normalize (:stack lowered))))\n263\t        (stream/append! (s/stream-of k) \"B\")\n264\t        (is (= [1 [2 [3 \"B\"]]] (h/normalize (vm/value (h/drive-local (assoc fresh :wait-set [lowered] :blocked? true\n265\t                                                                            :halted? false :value :yin/blocked\n266\t                                                                            :resources (:resources k))))))\n267\t            \"and it continues\")))))\n268\t\n269\t\n270\t;; =============================================================================\n271\t;; 7: E reconstruction\n272\t;; =============================================================================\n273\t\n274\t(def env-programs\n275\t  \"The B2 duplicate-parameter, nested-closure and nested-lambdas shapes,\n276\t   each blocked on a read inside its innermost body.\"\n277\t  (let [read-into (fn [& xs] (reduce (fn [acc x] (h/cat-of acc x)) (s/lit []) (concat xs [h/read-op])))]\n278\t    [[:duplicate-param (s/app (s/lam ['x 'x] (read-into (s/v 'x))) (s/lit 1) (s/lit 2)) [2 \"B\"]]\n279\t     [:nested-closure (s/app (s/app (s/lam ['a 'a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n280\t      [nil 2 \"B\"]]\n281\t     [:nested-lambdas (s/app (s/app (s/lam ['a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n282\t      [1 2 \"B\"]]]))\n283\t\n284\t\n285\t(defn envs\n286\t  \"Every E of a machine's canonical waits and parked records, outermost\n287\t   K frame first, values normalised.\"\n288\t  [m]\n289\t  (let [waits (lifted-waits m)\n290\t        parked (if (= :semantic-register (h/lane-of m))\n291\t                 (vals (:parked m))\n292\t                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n293\t    (h/normalize (mapv (fn [p] (conj (mapv :env (:k p)) (:env p))) (concat waits (sort-by :id parked))))))\n294\t\n295\t\n296\t(deftest env-reconstruction\n297\t  (let [checked (atom 0)\n298\t        cases (into (mapv (fn [[row label _ build]] [(str \"row \" row \" \" (name label)) build]) (h/lane-cases))\n299\t                    (map (fn [[label ast]] [(name label) #(h/reader identity ast)]))\n300\t                    env-programs)]\n301\t    (doseq [[label build] cases]\n302\t      (testing label\n303\t        (let [expected (envs (:machine (h/on-lane :semantic-register build)))]\n304\t          (doseq [lane [:stack :register]]\n305\t            (is (= expected (envs (:machine (h/on-lane lane build)))) (str (name lane) \"'s E is the evaluator's\"))\n306\t            (swap! checked inc)))))\n307\t    (is (= (* 2 (+ 61 3)) @checked)))\n308\t  (testing \"row 21: the read's E binds x to 1, the free environment keeps 99\"\n309\t    (let [build #(h/free-env-world identity {'x 99})]\n310\t      (doseq [lane h/lanes]\n311\t        (let [m (:machine (h/on-lane lane build))\n312\t              [p] (lifted-waits m)]\n313\t          (is (= 1 (get-in p [:env 'x])))\n314\t          (is (= {'x 99} (:free-env m)))))))\n315\t  (testing \"the env programs answer\"\n316\t    (doseq [[label ast expected] env-programs\n317\t            lane h/lanes]\n318\t      (is (= expected (:value (h/reference (h/on-lane lane #(h/reader identity ast))))) (str label \" \" lane)))))\n319\t\n320\t\n321\t;; =============================================================================\n322\t;; 8: closures, canonical and positional, both ways\n323\t;; =============================================================================\n324\t\n325\t(def closure-programs\n326\t  \"\\\"closure value\\\", \\\"higher order\\\" (its closure held across a read)\n327\t   and :duplicate-param, as halted values or lexical bindings.\"\n328\t  [[:closure-value (s/lam ['x] (s/v 'x))]\n329\t   [:higher-order (s/app (s/lam ['f] (h/cat-of (s/app (s/v 'f) (s/lit 5)) h/read-op)) (s/lam ['x] (s/v 'x)))]\n330\t   [:duplicate-param (s/app (s/lam ['x 'x] (s/lam ['y] (s/v 'x))) (s/lit 1) (s/lit 2))]])\n331\t\n332\t\n333\t(defn closures-in\n334\t  [x]\n335\t  (cond\n336\t    (values/closure? x) [x]\n337\t    (map? x) (mapcat closures-in (concat (keys x) (vals x)))\n338\t    (coll? x) (mapcat closures-in x)\n339\t    :else nil))\n340\t\n341\t\n342\t(defn kernel-closures\n343\t  \"Every positional closure of de Bruijn kernel k's value and its waits'\n344\t   frames.\"\n345\t  [k]\n346\t  (closures-in [(:value k) (mapv :frames (:wait-set k))]))\n347\t\n348\t\n349\t(defn canonical-shape\n350\t  \"A canonical closure payload with its segment named by A.\"\n351\t  [address c]\n352\t  (h/normalize (assoc (select-keys c [:params :entry :env]) :segment (address (:segment c)))))\n353\t\n354\t\n355\t(deftest closures-round-trip\n356\t  (let [checked (atom 0)]\n357\t    (doseq [[label ast] closure-programs\n358\t            lane [:stack :register]]\n359\t      (testing (str (name label) \" \" (name lane))\n360\t        (let [sr (:machine (h/on-lane :semantic-register #(h/reader identity ast)))\n361\t              k (:machine (h/on-lane lane #(h/reader identity ast)))\n362\t              sp (h/kernel-space k)\n363\t              cx (layout/lift-context k sp (:owner k))\n364\t              lx (layout/lower-context k sp)\n365\t              expected (mapv #(canonical-shape (fn [seg] (get-in sr [:code seg :address])) (values/payload %))\n366\t                             (closures-in [(:value sr) (mapv :env (:wait-set sr))]))\n367\t              positional (kernel-closures k)\n368\t              canonical (mapv #(layout/canonical-value cx %) positional)]\n369\t          (is (seq positional))\n370\t          (is (= (set expected) (set (map #(canonical-shape identity (values/payload %)) canonical)))\n371\t              \"positional -> canonical is the evaluator's closure\")\n372\t          (doseq [[p c] (map vector positional canonical)]\n373\t            (let [back (values/payload (layout/positional-value lx c))]\n374\t              (is (= (select-keys (values/payload p) [:arity :body-pc :store-of]) (select-keys back [:arity :body-pc :store-of])))\n375\t              (is (= (h/normalize (values/payload c))\n376\t                     (h/normalize (values/payload (layout/canonical-value cx (layout/positional-value lx c)))))\n377\t                  \"canonical -> positional -> canonical is the identity\")\n378\t              (if (and (= :duplicate-param label) (= [1 2] (peek (:frames (values/payload p)))))\n379\t                (is (= [2 2] (peek (:frames back))) \"the shadowed position reads as the visible x\")\n380\t                (is (= (h/normalize (:frames (values/payload p))) (h/normalize (:frames back)))\n381\t                    \"positional -> canonical -> positional keeps every frame\"))\n382\t              (swap! checked inc))))))\n383\t    (is (<= 6 @checked)))\n384\t  (testing \"the duplicate binder's visible value survives\"\n385\t    (let [k (:machine (h/on-lane :stack #(h/reader identity (s/app (second (nth closure-programs 2)) (s/lit 7)))))]\n386\t      (is (= 2 (vm/value k))))))\n387\t\n388\t\n389\t;; =============================================================================\n390\t;; 9: a lowered tail's frames and store-of are unobservable\n391\t;; =============================================================================\n392\t\n393\t(defn tail-lowered\n394\t  \"Row n lifted on the reference lane and lowered into lane, its tail\n395\t   entries' :frames and :store-of replaced by fill when given: the run's\n396\t   observables and the entries as lowered.\"\n397\t  [build lane fill]\n398\t  (let [world (h/on-lane :semantic-register build)\n399\t        {:keys [toy peer serve!]} (h/served #{:reader})\n400\t        wire (h/lane-lift (:machine world) serve!)\n401\t        {:keys [attach!]} (h/recording-attacher toy)\n402\t        recv (h/lane-lower lane {:attach-stream attach!} wire attach!)\n403\t        entries (:wait-set recv)\n404\t        recv (if fill\n405\t               (assoc recv :wait-set (mapv #(if (= :return-result (:resume-mode %)) (merge % fill) %) entries))\n406\t               recv)\n407\t        done (h/satisfy world recv #(h/drive-peers % [peer]))]\n408\t    {:entries entries :observed [(vm/halted? done) (h/normalize (vm/value done)) (h/normalize (vm/store done))]}))\n409\t\n410\t\n411\t(deftest tail-lowering-is-unobservable\n412\t  (let [checked (atom 0)]\n413\t    (doseq [[n build] [[6 #(h/bare 6)] [20 h/tail-effect-halt]]\n414\t            lane [:stack :register]]\n415\t      (testing (str \"row \" n \" \" (name lane))\n416\t        (let [plain (tail-lowered build lane nil)\n417\t              junk (tail-lowered build lane {:frames [[:junk 1] [:junk 2]] :store-of 'junk.mod})\n418\t              [entry] (:entries plain)]\n419\t          (is (= :return-result (:resume-mode entry)))\n420\t          (is (= [] (:frames entry)) \"lowered with []\")\n421\t          (is (nil? (:store-of entry)) \"and no store-of\")\n422\t          (is (= (:observed plain) (:observed junk)) \"arbitrary values change nothing\")\n423\t          (is (= \"B\" (second (:observed plain))))\n424\t          (swap! checked inc))))\n425\t    (is (= 4 @checked) \"rows 6 and 20 on both de Bruijn lanes; 9 and 12 are link rows\")))\n426\t"}]},"parent_tool_use_id":null,"session_id":"3f1acc3a-6522-479d-80d2-e73f91937106","uuid":"67cad64c-f82a-4735-8aeb-612ce9362a1c","timestamp":"2026-10-12T18:32:34.316Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/layout_test.cljc","content":"(ns yin.vm.semantic-register.layout-test\n  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic-register-vm.continuation.md\n   §8.3): the register pairing and live sets, the register destination from\n   A, the stack correspondence, operand layout and K slices, E\n   reconstruction, closures both ways, and the unobservable fill of a\n   lowered tail. The static items run over C, the B0 corpus and the\n   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.engine :as engine]\n            [yin.vm.parity-test :as b0]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.corpus :as corpus]\n            [yin.vm.semantic-register.layout :as layout]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.safepoint-harness-test :as h]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(def C\n  \"[label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n   operand position, whose dead layout syntax reads registers other than\n   the call's own (phase-5 §6.3's last golden).\"\n  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n\n\n(defn projected\n  [ast]\n  (:vector (linearize/project ast)))\n\n\n(defn reachable-pcs\n  \"Every pc reachable from its body's start.\"\n  [v]\n  (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v)))\n\n\n(defn boundary?\n  [t]\n  (contains? rcode/boundary-opcodes (nth t 0)))\n\n\n(defn parking?\n  \"A non-tail parking instruction (rule A1).\"\n  [t]\n  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n\n\n;; =============================================================================\n;; 1-2: the register kernel's static layout\n;; =============================================================================\n\n(deftest register-pairing\n  (let [checked (atom [0 0])]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)\n              bodies (:bodies sg)]\n          ;; phys is total on every body's named virtuals and single-valued\n          (doseq [[pc x s] (:pairs sg)]\n            (is (= s (layout/phys sg pc x)) (str \"pc \" pc \" virtual \" x)))\n          (doseq [b (range (count bodies))]\n            (let [named (into #{} (keep (fn [[pc x]] (when (= b (code/body-index bodies pc)) x))) (:pairs sg))]\n              (is (= named (set (keys (nth (:phys sg) b)))))))\n          ;; virt is single-valued on live-out's physical image\n          (doseq [p (sort (reachable-pcs v))\n                  :when (boundary? (nth v p))]\n            (let [lo (layout/live-out sg p)]\n              (is (= (count lo) (count (set (map #(layout/phys sg p %) lo))))\n                  (str \"distinct live virtuals hold distinct slots at pc \" p))\n              (doseq [x lo]\n                (is (= x (layout/virt sg p (layout/phys sg p x))))))\n            (swap! checked update 1 inc))\n          (swap! checked update 0 inc))))\n    (is (= (count C) (first @checked)))\n    (is (< 50 (second @checked)) \"reachable boundaries checked\")))\n\n\n(deftest register-live-is-live-out\n  (let [tails (atom 0)]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)]\n          (doseq [p (sort (reachable-pcs v))\n                  :let [t (nth v p)]\n                  :when (boundary? t)]\n            (let [live (nth (nth (:instructions (:register sg)) p) (rcode/live-slot-index (nth t 0)))]\n              (is (= (layout/register-live sg p) live) (str \"pc \" p))\n              (when (code/tail-call? t)\n                (swap! tails inc)\n                (is (= [] live (layout/register-live sg p)) \"a tail boundary's live is []\")))))))\n    (is (pos? @tails))))\n\n\n;; =============================================================================\n;; 3: rd from A, never the physical destination\n;; =============================================================================\n\n(def worked-ast (second (first (filter #(= :worked-example (first %)) corpus/programs))))\n\n\n(defn lifted-waits\n  \"The canonical wait entries of world machine m: the evaluator's own, or a\n   de Bruijn kernel's through the layout.\"\n  [m]\n  (if (= :semantic-register (h/lane-of m))\n    (:wait-set m)\n    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n\n\n(deftest register-rd-from-a\n  (testing \"the worked example parked at its inner call\"\n    (let [m0 (h/on-lane :register h/machine)\n          [sref m1] (engine/attach-resource m0 (s/ring 4))\n          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n          next! (engine/resolve-var {} {} vm/primitives h/stream-modules 'stream/next!)\n          m (vm/run (h/load-program (assoc m2 :free-env {'f (get vm/primitives 'conj) 'g next! 'x cref 'y 2})\n                                    worked-ast))\n          entry (first (:wait-set m))\n          [p] (lifted-waits m)\n          v (projected worked-ast)]\n      (is (vm/blocked? m))\n      (is (= [:call 2 3 [4] false] (nth v 3)) \"the inner call\")\n      (is (= 4 (:pc p)))\n      (is (= {:deliver :rd :rd 2} (:deliver p)) \"the canonical rd is A's 2\")\n      (is (= 3 (:dest entry)) \"the kernel's dest is the physical 3\")\n      (is (= #{1} (set (keys (:window p)))) \"saved(4, 2)\")))\n  (testing \"the K frames of :depth-3 take rd from A\"\n    (let [[_ wrap] (nth h/segments 2)\n          build #(h/reader wrap h/read-op)\n          reference (first (:wait-set (:machine (h/on-lane :semantic-register build))))\n          m (:machine (h/on-lane :register build))\n          entry (first (:wait-set m))\n          [p] (lifted-waits m)]\n      (is (= :depth-3 (first (nth h/segments 2))))\n      (is (= 6 (count (:k p))) \"three bindings, three nest applications\")\n      (is (= (mapv :rd (:k reference)) (mapv :rd (:k p))) \"the evaluator's return destinations\")\n      (is (some (fn [[f kf]] (not= (:rd f) (:dest kf))) (map vector (:k p) (:continuation entry)))\n          \"some physical dest differs from its virtual rd\"))))\n\n\n;; =============================================================================\n;; 4-5: the stack correspondence and operand layout\n;; =============================================================================\n\n(defn family\n  [op]\n  (case op (:load-bound :load-free) :var op))\n\n\n(deftest stack-correspondence\n  (doseq [[label ast] C]\n    (testing (str label)\n      (let [v (projected ast)\n            sg (layout/segment v)\n            h (:stack sg)]\n        (is (= (count v) (count (:a->h sg))) \"one non-push H instruction per A pc\")\n        (is (= (count h) (+ (count v) (count (filter #(= :push (first %)) h)))))\n        (doseq [k (range (count v))]\n          (is (= (nth (nth v k) 0) (family (nth (nth h (nth (:a->h sg) k)) 0)))\n              (str \"the k-th non-push instruction, k = \" k))\n          (is (= k (get (:h->a sg) (nth (:a->h sg) k)))))))))\n\n\n(deftest stack-layout-is-the-saved-set\n  (let [checked (atom 0)]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)\n              a (:analysis sg)]\n          (doseq [p (sort (reachable-pcs v))\n                  :let [t (nth v p)]\n                  :when (parking? t)]\n            (is (= (analysis/saved a (inc p) (code/rd t)) (set (layout/stack-layout sg p))) (str \"pc \" p))\n            (is (apply distinct? (cons ::bottom (layout/stack-layout sg p))))\n            (swap! checked inc)))))\n    (is (< 20 @checked)))\n  (testing \"the worked cases\"\n    (let [first-call (fn [v] (first (keep-indexed (fn [pc t] (when (= :call (first t)) pc)) v)))]\n      (doseq [ast [worked-ast\n                   (corpus/app (corpus/v 'f) (corpus/if-node (corpus/v 'c) (corpus/app (corpus/v 'g)) (corpus/lit 2))\n                               (corpus/v 'y))]]\n        (let [v (projected ast)\n              sg (layout/segment v)]\n          (is (= [1] (layout/stack-layout sg (first-call v))) \"[f], f in register 1\"))))))\n\n\n;; =============================================================================\n;; 6: K slices partition the operand stack\n;; =============================================================================\n\n(defn stack-frames\n  \"[[A-pc slice] …] for return frames then the current activation of\n   stack entry e of kernel k, reading the kernel's own offset table.\"\n  [k e]\n  (let [sp (h/kernel-space k)\n        a-pc (fn [abs]\n               (let [[ident rel] (dvm/image-pc k abs)\n                     sg (some #(when (= ident (:stack-id %)) %) (vals (:segments sp)))]\n                 [sg (inc (get (:h->a sg) (dec rel)))]))\n        parts (layout/slices (vec (:stack e)) (mapv :stack-base (:continuation e)))]\n    (mapv (fn [abs slice] (conj (a-pc abs) slice))\n          (conj (mapv :return-pc (:continuation e)) (:pc e))\n          parts)))\n\n\n(defn non-tail?\n  \"6c-pre marks a tail call's park :return-result.\"\n  [e]\n  (not= :return-result (:resume-mode e)))\n\n\n(deftest stack-slices-partition\n  (let [checked (atom 0)]\n    (doseq [[row label _ build] (h/lane-cases)\n            :when (contains? #{:bare :depth-3 :unwrapped} label)]\n      (testing (str \"row \" row \" \" (name label))\n        (let [k (:machine (h/on-lane :stack build))]\n          (doseq [e (concat (:wait-set k) (vals (:parked k)))\n                  :when (non-tail? e)]\n            (let [frames (stack-frames k e)]\n              (is (= (vec (:stack e)) (into [] (mapcat #(nth % 2)) frames)) \"the slices partition the stack\")\n              (doseq [[sg pc slice] frames]\n                (is (= (count (layout/stack-layout sg (dec pc))) (count slice))))\n              (swap! checked inc))))))\n    (is (< 20 @checked)))\n  (testing \"the multi-frame fixture\"\n    (let [expr (h/cat-of (s/lit [1])\n                         (s/app (s/lam ['x] (h/cat-of (s/lit [2])\n                                                      (s/app (s/lam ['y] (h/cat-of (s/lit [3]) h/read-op))\n                                                             (s/lit 2))))\n                                (s/lit 1)))\n          world (h/on-lane :stack #(h/reader identity expr))\n          k (:machine world)\n          e (first (:wait-set k))\n          st (:stack e)]\n      (is (= [0 0 0 2 4] (mapv :stack-base (:continuation e))) \"the bases, pinned from the kernel\")\n      (is (= 6 (count st)))\n      (is (= [[] [] [] 2 2 2] (mapv #(if (empty? %) [] (count %)) (layout/slices (vec st) [0 0 0 2 4]))))\n      (is (= [[1] [2] [3]] (mapv #(nth st %) [1 3 5])) \"each slice holds its activation's cat and literal\")\n      (is (every? values/closure? (map #(nth st %) [0 2 4])))\n      (is (= (vec st) (into [] cat (layout/slices (vec st) [0 0 0 2 4]))))\n      (let [sp (h/kernel-space k)\n            p (layout/lift-state (layout/lift-context k sp (:owner k)) e)\n            fresh (layout/attach-space (h/on-lane :stack h/machine) sp)\n            lowered (layout/lower-state (layout/lower-context fresh sp) p)]\n        (is (= 5 (count (:k p))))\n        (is (= [0 0 0 2 4] (mapv :stack-base (:continuation lowered))) \"the lowering emits the same bases\")\n        (is (= 6 (count (:stack lowered))))\n        (is (= (h/normalize (:stack e)) (h/normalize (:stack lowered))))\n        (stream/append! (s/stream-of k) \"B\")\n        (is (= [1 [2 [3 \"B\"]]] (h/normalize (vm/value (h/drive-local (assoc fresh :wait-set [lowered] :blocked? true\n                                                                            :halted? false :value :yin/blocked\n                                                                            :resources (:resources k))))))\n            \"and it continues\")))))\n\n\n;; =============================================================================\n;; 7: E reconstruction\n;; =============================================================================\n\n(def env-programs\n  \"The B2 duplicate-parameter, nested-closure and nested-lambdas shapes,\n   each blocked on a read inside its innermost body.\"\n  (let [read-into (fn [& xs] (reduce (fn [acc x] (h/cat-of acc x)) (s/lit []) (concat xs [h/read-op])))]\n    [[:duplicate-param (s/app (s/lam ['x 'x] (read-into (s/v 'x))) (s/lit 1) (s/lit 2)) [2 \"B\"]]\n     [:nested-closure (s/app (s/app (s/lam ['a 'a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n      [nil 2 \"B\"]]\n     [:nested-lambdas (s/app (s/app (s/lam ['a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n      [1 2 \"B\"]]]))\n\n\n(defn envs\n  \"Every E of a machine's canonical waits and parked records, outermost\n   K frame first, values normalised.\"\n  [m]\n  (let [waits (lifted-waits m)\n        parked (if (= :semantic-register (h/lane-of m))\n                 (vals (:parked m))\n                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n    (h/normalize (mapv (fn [p] (conj (mapv :env (:k p)) (:env p))) (concat waits (sort-by :id parked))))))\n\n\n(deftest env-reconstruction\n  (let [checked (atom 0)\n        cases (into (mapv (fn [[row label _ build]] [(str \"row \" row \" \" (name label)) build]) (h/lane-cases))\n                    (map (fn [[label ast]] [(name label) #(h/reader identity ast)]))\n                    env-programs)]\n    (doseq [[label build] cases]\n      (testing label\n        (let [expected (envs (:machine (h/on-lane :semantic-register build)))]\n          (doseq [lane [:stack :register]]\n            (is (= expected (envs (:machine (h/on-lane lane build)))) (str (name lane) \"'s E is the evaluator's\"))\n            (swap! checked inc)))))\n    (is (= (* 2 (+ 61 3)) @checked)))\n  (testing \"row 21: the read's E binds x to 1, the free environment keeps 99\"\n    (let [build #(h/free-env-world identity {'x 99})]\n      (doseq [lane h/lanes]\n        (let [m (:machine (h/on-lane lane build))\n              [p] (lifted-waits m)]\n          (is (= 1 (get-in p [:env 'x])))\n          (is (= {'x 99} (:free-env m)))))))\n  (testing \"the env programs answer\"\n    (doseq [[label ast expected] env-programs\n            lane h/lanes]\n      (is (= expected (:value (h/reference (h/on-lane lane #(h/reader identity ast))))) (str label \" \" lane)))))\n\n\n;; =============================================================================\n;; 8: closures, canonical and positional, both ways\n;; =============================================================================\n\n(def closure-programs\n  \"\\\"closure value\\\", \\\"higher order\\\" (its closure held across a read)\n   and :duplicate-param, as halted values or lexical bindings.\"\n  [[:closure-value (s/lam ['x] (s/v 'x))]\n   [:higher-order (s/app (s/lam ['f] (h/cat-of (s/app (s/v 'f) (s/lit 5)) h/read-op)) (s/lam ['x] (s/v 'x)))]\n   [:duplicate-param (s/app (s/lam ['x 'x] (s/lam ['y] (s/v 'x))) (s/lit 1) (s/lit 2))]])\n\n\n(defn closures-in\n  [x]\n  (cond\n    (values/closure? x) [x]\n    (map? x) (mapcat closures-in (concat (keys x) (vals x)))\n    (coll? x) (mapcat closures-in x)\n    :else nil))\n\n\n(defn kernel-closures\n  \"Every positional closure of de Bruijn kernel k's value and its waits'\n   frames.\"\n  [k]\n  (closures-in [(:value k) (mapv :frames (:wait-set k))]))\n\n\n(defn canonical-shape\n  \"A canonical closure payload with its segment named by A.\"\n  [address c]\n  (h/normalize (assoc (select-keys c [:params :entry :env]) :segment (address (:segment c)))))\n\n\n(deftest closures-round-trip\n  (let [checked (atom 0)]\n    (doseq [[label ast] closure-programs\n            lane [:stack :register]]\n      (testing (str (name label) \" \" (name lane))\n        (let [sr (:machine (h/on-lane :semantic-register #(h/reader identity ast)))\n              k (:machine (h/on-lane lane #(h/reader identity ast)))\n              sp (h/kernel-space k)\n              cx (layout/lift-context k sp (:owner k))\n              lx (layout/lower-context k sp)\n              expected (mapv #(canonical-shape (fn [seg] (get-in sr [:code seg :address])) (values/payload %))\n                             (closures-in [(:value sr) (mapv :env (:wait-set sr))]))\n              positional (kernel-closures k)\n              canonical (mapv #(layout/canonical-value cx %) positional)]\n          (is (seq positional))\n          (is (= (set expected) (set (map #(canonical-shape identity (values/payload %)) canonical)))\n              \"positional -> canonical is the evaluator's closure\")\n          (doseq [[p c] (map vector positional canonical)]\n            (let [back (values/payload (layout/positional-value lx c))]\n              (is (= (select-keys (values/payload p) [:arity :body-pc :store-of]) (select-keys back [:arity :body-pc :store-of])))\n              (is (= (h/normalize (values/payload c))\n                     (h/normalize (values/payload (layout/canonical-value cx (layout/positional-value lx c)))))\n                  \"canonical -> positional -> canonical is the identity\")\n              (if (and (= :duplicate-param label) (= [1 2] (peek (:frames (values/payload p)))))\n                (is (= [2 2] (peek (:frames back))) \"the shadowed position reads as the visible x\")\n                (is (= (h/normalize (:frames (values/payload p))) (h/normalize (:frames back)))\n                    \"positional -> canonical -> positional keeps every frame\"))\n              (swap! checked inc))))))\n    (is (<= 6 @checked)))\n  (testing \"the duplicate binder's visible value survives\"\n    (let [k (:machine (h/on-lane :stack #(h/reader identity (s/app (second (nth closure-programs 2)) (s/lit 7)))))]\n      (is (= 2 (vm/value k))))))\n\n\n;; =============================================================================\n;; 9: a lowered tail's frames and store-of are unobservable\n;; =============================================================================\n\n(defn tail-lowered\n  \"Row n lifted on the reference lane and lowered into lane, its tail\n   entries' :frames and :store-of replaced by fill when given: the run's\n   observables and the entries as lowered.\"\n  [build lane fill]\n  (let [world (h/on-lane :semantic-register build)\n        {:keys [toy peer serve!]} (h/served #{:reader})\n        wire (h/lane-lift (:machine world) serve!)\n        {:keys [attach!]} (h/recording-attacher toy)\n        recv (h/lane-lower lane {:attach-stream attach!} wire attach!)\n        entries (:wait-set recv)\n        recv (if fill\n               (assoc recv :wait-set (mapv #(if (= :return-result (:resume-mode %)) (merge % fill) %) entries))\n               recv)\n        done (h/satisfy world recv #(h/drive-peers % [peer]))]\n    {:entries entries :observed [(vm/halted? done) (h/normalize (vm/value done)) (h/normalize (vm/store done))]}))\n\n\n(deftest tail-lowering-is-unobservable\n  (let [checked (atom 0)]\n    (doseq [[n build] [[6 #(h/bare 6)] [20 h/tail-effect-halt]]\n            lane [:stack :register]]\n      (testing (str \"row \" n \" \" (name lane))\n        (let [plain (tail-lowered build lane nil)\n              junk (tail-lowered build lane {:frames [[:junk 1] [:junk 2]] :store-of 'junk.mod})\n              [entry] (:entries plain)]\n          (is (= :return-result (:resume-mode entry)))\n          (is (= [] (:frames entry)) \"lowered with []\")\n          (is (nil? (:store-of entry)) \"and no store-of\")\n          (is (= (:observed plain) (:observed junk)) \"arbitrary values change nothing\")\n          (is (= \"B\" (second (:observed plain))))\n          (swap! checked inc))))\n    (is (= 4 @checked) \"rows 6 and 20 on both de Bruijn lanes; 9 and 12 are link rows\")))\n","numLines":426,"startLine":1,"totalLines":426}},"tool_result_meta":[{"id":"toolu_017DVaQRxkn8gGhEnr6je2fK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
