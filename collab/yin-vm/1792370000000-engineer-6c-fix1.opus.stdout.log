ld) 1)))))\n844\t                     @memo)]\n845\t        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n846\t\n847\t\n848\t(defn pairs-of\n849\t  [n]\n850\t  (mapv vec (partition 2 (:slots n))))\n851\t\n852\t\n853\t(defn rebuild\n854\t  [n f]\n855\t  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n856\t\n857\t\n858\t(defn lowered\n859\t  \"Lower wire into a fresh receiver: [outcome attaches].\""}]},"parent_tool_use_id":null,"session_id":"3f1acc3a-6522-479d-80d2-e73f91937106","uuid":"d1e8c746-7281-4aeb-80d7-9d5014c44c3e","timestamp":"2026-10-12T18:39:26.958Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"\n;; =============================================================================\n;; Acceptance 7: refusals, before any attachment\n;; =============================================================================\n\n(defn update-at\n  [x path f]\n  (if (empty? path)\n    (f x)\n    (if (map? x)\n      (update-in x [:slots (first path)] update-at (rest path) f)\n      (update x (first path) update-at (rest path) f))))\n\n\n(defn replace-nodes\n  \"Every row node matching pred, anywhere under x, replaced by (f node).\"\n  [x pred f]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots))\n    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n    (vector? x) (mapv #(replace-nodes % pred f) x)\n    :else x))\n\n\n(defn replace-row\n  \"The wire with row id's body replaced and every ancestor rehashed,\n   without canonicalizing slots: a tamper below the abstract emitter.\"\n  [wire id body]\n  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n        memo (atom {})]\n    (letfn [(rewrite\n              [x]\n              (cond\n                (contains? index x)\n                (or (get @memo x)\n                    (let [b (mapv rewrite (if (= x id) body (subvec (ge