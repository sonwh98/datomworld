te state\n   441\t            last-result nil]\n   442\t       (if (zero? remaining)\n   443\t         (or last-result (rpc-result :dao.stream.rpc/idle state))\n   444\t         (let [result (poll-read state)\n   445\t               next-state (:dao.stream.rpc/state result)\n   446\t               outcome (:dao.stream.rpc/outcome result)]\n   447\t           (if (or (:terminal next-state)\n   448\t                   (= outcome :dao.stream.rpc/idle))\n   449\t             result\n   450\t             (recur (dec remaining) next-state result))))))))\n   451\t\n   452\t\n   453\t(defn take-completed\n   454\t  \"Return `[completions next-state]`, clearing the unpublished completion\n   455\t   outbox exactly once.  The caller owns publication and must call this only\n   456\t   from its single state-owning driver step.\"\n   457\t  [state]\n   458\t  [(:completed state) (assoc state :completed [])])\n   459\t\n   460\t\n   285\t      (step-result :dao.stream.apply/response-undeliverable\n   286\t                   (-> state\n   287\t                       (assoc :request-cursor (:pending-successor state)\n   288\t                              :terminal outcome)\n   289\t                       clear-pending)\n   290\t                   :dao.stream.apply/response response\n   291\t                   :dao.stream.apply/append put-result))))\n   292\t\n   293\t\n   294\t(defn- terminal-result\n   295\t  [state outcome read-result]\n   296\t  (step-result :dao.stream.apply/terminal\n   297\t               (assoc state :terminal outcome)\n   298\t               :dao.stream.apply/read read-result))\n   299\t\n   300\t\n   301\t(defn serve-once!\n   302\t  \"Advance one server session by at most one request and one response append.\n   303\t\n   304\t   `state` is explicit caller-owned data.  A computed response and its exact\n   305\t   successor cursor remain in that state until append succeeds, so retrying on\n   306\t   `:dao.stream/full` cannot invoke the handler twice.  This function neither\n   307\t   loops nor waits.\"\n   308\t  [handlers request-handle response-handle state]\n   309\t  (cond\n   310\t    (:terminal state)\n   311\t    (step-result :dao.stream.apply/terminal state)\n   312\t\n   313\t    (:pending-response state)\n   314\t    (deliver-pending response-handle state)\n   315\t\n   316\t    :else\n   317\t    (let [read-result (next-request request-handle (:request-cursor state))\n   318\t          outcome (:dao.stream/outcome read-result)]\n   319\t      (case outcome\n   320\t        :dao.stream/ok\n   321\t        (let [request-value (:dao.stream/value read-result)\n   322\t              successor (:dao.stream/cursor read-result)]\n   323\t          (if-let [response (dispatch-request handlers request-value)]\n   324\t            (deliver-pending response-handle\n   325\t                             (retain-response state response successor))\n   326\t            ;; A malformed element with no usable id cannot be correlated, but\n   327\t            ;; it still advances exactly once and becomes a local diagnostic.\n   328\t            (step-result :dao.stream.apply/malformed-request\n   329\t                         (-> state\n   330\t                             (assoc :request-cursor successor)\n   331\t                             (update :diagnostics conj\n   332\t                                     {:dao.stream.apply/code\n   333\t                                      :dao.stream.apply/malformed-request\n   334\t                                      :dao.stream.apply/value request-value}))\n   335\t                         :dao.stream.apply/read read-result)))\n   336\t\n   337\t        :dao.stream/blocked\n   338\t        (step-result :dao.stream.apply/idle state\n   339\t                     :dao.stream.apply/read read-result)\n   340\t\n   341\t        :dao.stream/gap\n   342\t        (step-result :dao.stream.apply/gap\n   343\t                     (-> state\n   344\t                         (assoc :request-cursor (:dao.stream/cursor read-result))\n   345\t                         (update :diagnostics conj\n   346\t                                 {:dao.stream.apply/code\n   347\t                                  :dao.stream.apply/request-gap}))\n   348\t                     :dao.stream.apply/read read-result)\n   349\t\n   350\t        (:dao.stream/end :dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n","exit_code":0,"status":"completed"}}
