not a complete-retention transport\"\n   454\t                          {:outcome (:dao.stream/outcome r), :result r})))))))\n   455\t\n   456\t\n   457\t(defn- recording-content-handle\n   458\t  \"Temporary in-memory content store for the publish build. :put-content-fn\n   459\t   records each unique node blob on first insertion (answering :present for\n   460\t   duplicates, so the recorded order is first-insertion order, deduplicated);\n   461\t   :get-content-fn reads recorded blobs back. Addresses are minted by\n   462\t   jing/materialize! through dao.data.btree.storage/kv-storage, so the\n   463\t   recorded order is exactly the store-tree children-before-parent traversal.\n   464\t   The handle is a build-time value: no global state is introduced.\"\n   465\t  []\n   190\t  [state medium outcome]\n   191\t  (assoc-in state [:ledger medium] outcome))\n   192\t\n   193\t\n   194\t(defn drain-output\n   195\t  \"Drain the output medium into text, total over every `next` outcome.\n   196\t\n   197\t   `ok` advances to the exact successor the handle returned.  `gap` prints a\n   198\t   loss notice and resumes at the recovery cursor.  `end`, `cursor-mismatch`,\n   199\t   `invalid-cursor`, and `transport-error` print a notice, leave the cursor\n   200\t   unchanged, and end the drain.  Whatever ended the drain is recorded in the\n   201\t   ledger, so `repl-state` never has to ask a stream how it is.\"\n   202\t  [state]\n   203\t  (let [output (:output-stream state)\n   204\t        cursor (:output-cursor state)]\n   205\t    (cond\n   206\t      (nil? output) [(ledger state :output :untried) \"\"]\n   207\t      (nil? cursor) [(ledger state :output :dao.stream/invalid-cursor)\n   208\t                     \";; output unreadable: no cursor was minted\\n\"]\n   209\t      :else\n   210\t      (loop [remaining drain-budget\n   211\t             cursor cursor\n   212\t             chunks []]\n   213\t        (if (zero? remaining)\n   214\t          [(-> state\n   215\t               (assoc :output-cursor cursor)\n   216\t               (ledger :output :dao.stream/blocked))\n   217\t           (apply str chunks)]\n   218\t          (let [result (stream/next output cursor)\n   219\t                outcome (:dao.stream/outcome result)]\n   220\t            (case outcome\n   221\t              :dao.stream/ok\n   222\t              (recur (dec remaining)\n   223\t                     (:dao.stream/cursor result)\n   224\t                     (conj chunks (chunk-text (:dao.stream/value result))))\n   225\t\n   226\t              :dao.stream/gap\n   227\t              (recur (dec remaining)\n   228\t                     (:dao.stream/cursor result)\n   229\t                     (conj chunks \";; output lost: resumed at the recovery cursor\\n\"))\n   230\t\n   231\t              :dao.stream/blocked\n   232\t              [(-> state\n   233\t                   (assoc :output-cursor cursor)\n   234\t                   (ledger :output outcome))\n   235\t               (apply str chunks)]\n   175\t   stream.\n   176\t\n   177\t   Returns {:handled? true :vm vm' :request-id id} when a response was\n   178\t   appended, or {:handled? false :vm vm ...} otherwise. A `:terminal` key\n   179\t   names the outcome that ended the bridge.\"\n   180\t  [vm]\n   181\t  (let [bridge (:bridge vm)\n   182\t        handlers (:handlers bridge)\n   183\t        cursor (:cursor bridge)]\n   184\t    (cond\n   185\t      (:terminal bridge) {:handled? false, :vm vm, :terminal (:terminal bridge)}\n   186\t      (:pending-response bridge)\n   187\t      (deliver-response vm\n   188\t                        (:pending-response bridge)\n   189\t                        (:pending-successor bridge)\n   190\t                        (:pending-request-id bridge))\n   191\t      :else\n   192\t      (let [call-in (get (:store vm) vm/call-in-stream-key)\n   193\t            _ (when (nil? call-in)\n   194\t                (throw (ex-info \"This VM has no call-in stream to