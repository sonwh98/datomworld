nt-state endpoint)))\n   575\t          :when (and (= :pending (:status slot))\n   576\t                     (= :closed (:phase @(:handle-state slot))))]\n   577\t    (release-slot! endpoint index (:attachment slot)))\n   578\t  (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   579\t          :when (= :pending (:status slot))]\n   580\t    (let [next (stream/next (:dao.stream/handle (:ack slot)) (:ack-cursor slot))]\n   581\t      (when (= :dao.stream/ok (:dao.stream/outcome next))\n   582\t        (swap! (:state endpoint) assoc-in [:slots index :ack-cursor] (:dao.stream/cursor next))\n   583\t        (let [ack (:dao.stream/value next)]\n   584\t          (cond\n   585\t            (not= (:attachment slot) (:ws/attachment ack)) nil\n   586\t            (valid-ack? ack (:attachment slot)) (accept-slot! endpoint index slot ack)\n   587\t            :else (let [hstate (:handle-state slot)]\n   588\t                    (swap! hstate assoc :phase :closed)\n   589\t                    (invoke-close! (:socket @hstate) protocol-close-code \"dao.stream/invalid-ack\")\n   590\t                    (terminal! hstate (:attachment slot) :ws/closed)\n   591\t                    (release-slot! endpoint index (:attachment slot))))))))\n   592\t  ;; Expiry is deliberately clock-domain explicit.  An endpoint composition\n   593\t  ;; may set `:opened-at` when it accepts an offer; this transport does not\n   594\t  ;; invent wall-clock time or a scheduler.\n   595\t  (when-let [expiry (:expiry-ms (:config endpoint))]\n   596\t    (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   597\t            :when (and (= :pending (:status slot)) (:opened-at slot)\n   598\t                       (<= (+ (:opened-at slot) expiry) now))]\n   599\t      (let [hstate (:handle-state slot)]\n   600\t        (swap! hstate assoc :phase :closed)\n   601\t        (invoke-close! (:socket @hstate) 1000 \"dao.stream/acceptance-expired\")\n   602\t        (terminal! hstate (:attachment slot) :ws/closed)\n   603\t        (release-slot! endpoint index (:attachment slot)))))\n   604\t  endpoint)\n     1\t(ns dao.stream.serving\n     2\t  \"Host-owned WebSocket serving composition for DaoStream v2.\n     3\t\n     4\t   This namespace deliberately has no listener, scheduler, transport directory,\n     5\t   or application protocol.  It wires an already-composed endpoint, its bounded\n     6\t   handoff media, and a host-owned path table into one explicit driver.  The host\n     7\t   decides when to call `step!`, supplies its clock, and owns the endpoint start\n     8\t   and stop effects.\"\n     9\t  (:require [dao.stream :as stream]\n    10\t            [dao.stream.forward :as forward]\n    11\t            [dao.stream.ws :as ws]))\n    12\t\n    13\t\n    14\t(defn- target-handle\n    15\t  [x]\n    16\t  (if (and (map? x) (contains? x :dao.stream/handle))\n    17\t    (:dao.stream/handle x)\n    18\t    x))\n    19\t\n    20\t\n    21\t(defn- reader?\n    22\t  [x]\n    23\t  (stream/reader? (target-handle x)))\n    24\t\n    25\t\n    26\t(defn- writer-target?\n    27\t  [x]\n    28\t  (and (map? x)\n    29\t       (stream/writer? (:dao.stream/handle x))\n    30\t       (contains? (:dao.stream/surface x) :writer)))\n    31\t\n    32\t\n    33\t(defn- terminal-event?\n    34\t  [event]\n    35\t  (contains? #{:ws/closed :ws/ended} (:ws/event event)))\n    36\t\n    37\t\n    38\t(defn- call-close!\n    39\t  [f handle]\n    40\t  (try\n    41\t    (f handle)\n    42\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n    43\t      {:dao.stream/outcome :dao.stream/transport-error})))\n    44\t\n    45\t\n    46\t(defn- supplied-stream?\n    47\t  [{:keys [descriptor stream]} path]\n    48\t  (and (ws/descriptor? descriptor)\n    49\t       (= path (:ws/path descriptor))\n    50\t       (stream/reader? stream)))\n    51\t\n    52\t\n    53\t(defn- valid-slot?\n    54\t  [slot]\n    55\t  (and (reader? (:offer-reader slot))\n    56\t       (some? (:offer-cursor slot))\n    57\t       (writer-target? (:ack-writer slot))))\n    58\t\n    59\t\n    60\t(defn- traffic-session\n    61\t  \"Validate the composition-created medium.  The factory must have minted the\n    62\t   reader cursor before acknowledgement; accepting first would permit an open\n    63\t   or payload event to outrun the reader position.\"\n    64\t  [offer made]\n    65\t  (let [{:keys [traffic admission reader cursor]} made\n    66\t        socket-handle (get-in offer [:ws/handle :dao.stream/handle])]\n    67\t    (when (and (writer-target? traffic)\n    68\t               (ws/admission? admission)\n    69\t               (reader? reader)\n    70\t               (some? cursor))\n    71\t      {:socket-handle socket-handle\n    72\t       :traffic traffic\n    73\t       :admission admission\n    74\t       :traffic-reader (target-handle reader)\n    75\t       :traffic-cursor cursor})))\n    76\t\n    77\t\n    78\t(defn make-serving\n    79\t  \"Construct an inert serving composition.  It starts only when `start!` is\n    80\t   called, and advances only when the host calls `step!` with an explicit time.\n    81\t\n    82\t   Required config is deliberately concrete composition data:\n    83\t\n    84\t   * `:endpoint` is a `dao.stream.ws/make-endpoint` value.\n    85\t   * `:served` maps canonical `:ws/path` strings to\n    86\t     `{:descriptor <ws descriptor> :stream <reader handle>}`.  It is the\n    87\t     host's resolution table, not a DaoStream registry.\n    88\t   * `:control-reader` and `:control-cursor` observe the endpoint's pre-accept\n    89\t     control medium.\n    90\t   * `:slots` are in the endpoint's handoff order and contain `:offer-reader`,\n    91\t     an already-minted `:offer-cursor`, and an `:ack-writer` target.\n    92\t   * `:make-traffic` receives an accepted offer and returns a newly-created\n    93\t     per-attachment traffic medium, its declaration, reader, and minted cursor.\n    94\t   * `:start-endpoint!`, `:stop-endpoint!`, and `:close-ended!` are host policy\n    95\t     functions.  `:close-ended!` must perform the WebSocket 4000 close; generic\n    96\t     DaoStream `close!` means only detachment.\n    97\t\n    98\t   `:inbound-step`, when supplied, is an explicit application interpreter run\n    99\t   by this driver for non-terminal per-attachment traffic events.  Omitting it\n   100\t   means inbound payload is deliberately not appended to the served stream.\"\n   101\t  [{:keys [endpoint served control-reader control-cursor slots make-traffic\n   102\t           start-endpoint! stop-endpoint!]\n   103\t    :as config}]\n   104\t  (when-not endpoint\n   105\t    (throw (ex-info \"serving composition needs an endpoint\" {:config config})))\n   106\t  (when-not (and (map? served) (seq served)\n   107\t                 (every? (fn [[path entry]] (supplied-stream? entry path)) served))\n   108\t    (throw (ex-info \"serving composition needs canonical paths and reader streams\"\n   109\t                    {:served served})))\n   110\t  ;; `ws/make-endpoint` intentionally receives only descriptors while this\n   111\t  ;; composition additionally owns the source handles.  When given that\n   112\t  ;; concrete endpoint, reject two subtly different host path tables rather\n   113\t  ;; than acknowledging an offer for a stream this driver would forward from\n   114\t  ;; somewhere else.\n   115\t  (when-let [endpoint-served (get-in endpoint [:config :served])]\n   116\t    (let [descriptors (into {} (map (fn [[path entry]] [path (:descriptor entry)])) served)]\n   117\t      (when-not (= endpoint-served descriptors)\n   118\t        (throw (ex-info \"endpoint and serving resolution tables disagree\"\n   119\t                        {:endpoint-served endpoint-served :served descriptors})))))\n   120\t  (when-not (and (reader? control-reader) (some? control-cursor))\n   330\t(defn step!\n   331\t  \"Advance exactly one