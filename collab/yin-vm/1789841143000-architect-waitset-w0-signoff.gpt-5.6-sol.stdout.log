aiting — `blocked` for a reader,\n   287\t   `full` for a writer, the only two outcomes that can change on their own —\n   288\t   and otherwise the ready-entry updates `{:value :status}`, plus `:cursor`\n   289\t   for a reader that moved. `end` and `gap` resolve to the values the\n   290\t   immediate path yields; any other outcome resolves under its own keyword\n   291\t   for `resume-from-run-queue` to raise. A parked writer retries by\n   292\t   appending: the append is an effect of this poll. An entry with no known\n   293\t   `:reason` keeps waiting.\"\n   294\t  [entry]\n   295\t  (case (:reason entry)\n   296\t    :next (let [result (stream/next (:stream entry) (:cursor entry))\n   297\t                o (outcome result)]\n   298\t            (case o\n   299\t              :dao.stream/ok {:value (:dao.stream/value result),\n   300\t                              :status :ok,\n   301\t                              :cursor (:dao.stream/cursor result)}\n   302\t              :dao.stream/blocked nil\n   303\t              :dao.stream/end {:value nil, :status :end}\n   304\t              :dao.stream/gap {:value :dao.stream/gap,\n   305\t                               :status :dao.stream/gap,\n   306\t                               :cursor (:dao.stream/cursor result)}\n   307\t              {:value o, :status o}))\n   308\t    :put (let [o (outcome (stream/append! (:stream entry) (:datom entry)))]\n   309\t           (case o\n   310\t             :dao.stream/ok {:value (:datom entry), :status :ok}\n   311\t             :dao.stream/full nil\n   312\t             {:value o, :status o}))\n   313\t    nil))\n   314\t\n   315\t\n   316\t(defn check-wait-set\n   317\t  \"Check wait-set entries against their transports.\n   318\t\n   319\t   Every entry is resolved to a live handle and an opaque cursor out of the\n   320\t   store and polled with a synchronous `next` or `append!` — resolution\n   321\t   happens per poll, so the stored entry itself never carries a handle.\n   322\t   There is no transport-local waking to fall back from: this is the only\n   323\t   mechanism.\n   324\t\n   325\t   Entries are polled one at a time in wait-set order, and a woken reader's\n   326\t   successor cursor is written back to the store before the next entry is\n   327\t   resolved. Waiters sharing a cursor-ref therefore read distinct values — the\n   328\t   value at the cursor wakes the first, its successor wakes the next — instead\n   329\t   of every waiter reading the value at the shared pre-poll cursor. An entry\n   330\t   that stays waiting is retained in its stored, resource-id form; the\n   331\t   resolved copy was for this poll only.\"\n   332\t  [state]\n   333\t  (let [wait-set (:wait-set state)]\n   334\t    (if (empty? wait-set)\n   335\t      state\n   336\t      (loop [remaining wait-set\n   337\t             store (:store state)\n   338\t             waiting []\n   339\t             woken []]\n   340\t        (if (empty? remaining)\n   341\t          (let [v (assoc state\n   342\t                         :store store\n   343\t                         :wait-set waiting)]\n   344\t            (update v\n   345\t                    :ready-queue (fnil into [])\n   346\t                    (make-woken-run-queue-entries v woken)))\n   347\t          (let [entry (first remaining)\n   348\t                augmented (augment-wait-entry store entry)]\n   349\t            (if-let [updates (poll-wait-entry augmented)]\n   350\t              (let [raw (merge augmented updates)\n   351\t                    cursor-id (:id (:cursor-ref raw))\n   352\t                    ;; A woken reader's successor is stored before later\n   353\t                    ;; entries resolve, so a shared cursor-ref advances\n   354\t                    ;; within the round.\n   355\t                    store (if (and cursor-id (:cursor raw))\n   356\t                            (assoc store\n   357\t                                   cursor-id\n   358\t                                   (assoc (get store cursor-id)\n   359\t                                          :cursor (:cursor raw)))\n   360\t                            store)]\n   361\t                (recur (rest remaining)\n   362\t                       store\n   363\t                       waiting\n   364\t                       (conj woken {:entry raw,\n   365\t                                    :value (:value raw),\n   366\t                                    :cursor (:cursor raw),\n   367\t                                    :store-updates (:store-updates raw)})))\n   368\t              (recur (rest remaining) store (conj waiting entry) woken))))))))\n   369\t\n   370\t\n   371\t(declare handle-effect resume-continuation)\n   372\t\n   373\t\n   374\t(defn run-loop\n   375\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n   376\t   `resume-fn` pops and restores them.\"\n   377\t  [state active? step-fn resume-fn]\n   378\t  (loop [v state]\n   379\t    (let [q (or (:ready-queue v) [])]\n   380\t      (cond (active? v) (recur (step-fn v))\n   381\t            (:blocked? v) (let [v' (check-wait-set v)]\n   382\t                            (if-let [resumed (resume-fn v')]\n   383\t                              (recur resumed)\n   384\t                              (telemetry/emit-snapshot v' :blocked)))\n   385\t            (seq q) (if-let [resumed (resume-fn v)]\n   386\t                      (recur resumed)\n   387\t                      v)\n   388\t            :else (if (:halted? v) (telemetry/emit-snapshot v :halt) v)))))\n   389\t\n   390\t\n   391\t(defn- terminal-resume-outcome\n   392\t  \"The outcome a woken entry resolved with, when it is one the immediate\n   393\t   path raises as an error. `handle-put` and `handle-next` throw for every\n   394\t   outcome outside ok/end/gap, and whether the first attempt blocked must not\n   395\t   change that. An entry that was never polled carries no status.\"\n     1\t(ns yin.repl\n     2\t  \"Host entry points for the DaoStream v2 Yin REPL.\n     3\t\n     4\t   The one thing this namespace adds to `yin.repl.driver` is cadence, which\n     5\t   the DaoStream contract leaves to the runtime.  Per host, a line producer\n     6\t   appends what was typed to the input medium and returns; one ticker owns the\n     7\t   state value and calls `repl-step` serially.  There is no second state owner,\n     8\t   and no line handler evaluates, requests, polls, or prints.\n     9\t\n    10\t   `yin.repl` is untouched and keeps its aliases; this is a second REPL beside\n    11\t   it.\"\n    12\t  (:require #?@(:cljd [[\"dart:async\" :as async]\n    13\t                       [\"dart:convert\" :as convert]\n    14\t                       [\"dart:core\" :as dart-core]\n    15\t                       [\"dart:io\" :as io]])\n    16\t            [yin.repl.driver :as driver]\n    17\t            [yin.repl.host :as host]\n    18\t            [yin.repl.serve :as serve]))\n    19\t\n    20\t\n    21\t(def tick-millis\n    22\t  \"Cadence of the single step owner.  Slow enough to cost nothing while idle,\n    23\t   fast enough that a remote result prints without waiting for a keystroke.\"\n    24\t  25)\n    25\t\n    26\t\n    27\t(def prompt \"yin> \")\n    28\t\n    29\t\n    30\t(def telemetry-text\n    31\t  (str \"--telemetry and --telemetry-stream are not part of the DaoStream v2 \"\n    32\t       \"REPL slice: the v2 emit path is built (yin.vm.telemetry, opt-in via \"\n    33\t       \"the :telemetry {:stream ...} construction option — \"\n    34\t       \"yin.vm.telemetry.implementation-plan.md), but composing a sink into \"\n    35\t       \"this shell is not, so the flags are rejected rather than ignored\"))\n    36\t\n    37\t\n    38\t(defn parse-args\n    39\t  \"Parse the host arguments.  `--telemetry` and `--telemetry-stream` are\n    40\t   rejected rather than ignored, and the rejection names the v1 REPL.\"\n    41\t  [args]\n    42\t  (loop [args (seq args)\n    43\t         opts {:headless? false :host nil :port nil :rejected []}]\n    44\t    (if-let [arg (first args)]\n    45\t      (case arg\n    46\t        \"--port\" (recur (nnext args)\n    47\t                        (assoc opts :port (when-let [p (second args)]\n    48\t                                            #?(:cljd (int/parse p)\n    49\t                                               :cljs (js/parseInt p 10)\n    50\t                                               :clj (Long/parseLong p)))))\n    51\t        \"--host\" (recur (nnext args) (assoc opts :host (second args)))\n    52\t        \"--headless\" (recur (next args) (assoc opts :headless? true))\n    53\t        \"--telemetry\" (recur (next args) (update opts :rejected conj arg))\n    54\t        \"--telemetry-stream\" (recur (nnext args) (update opts :rejected conj arg))\n    55\t        (recur (next args) (update opts :extra (fnil conj []) arg)))\n    56\t      opts)))\n    57\t\n    58\t\n    59\t(defn boot\n    60\t  \"Create the composition: one shell, one input medium, one cursor held only by\n    61\t   the step owner, and the host WebSocket adapter `(connect …)` attaches\n    62\t   through.\"\n    63\t  ([] (boot {}))\n    64\t  ([opts] (driver/create-state {:host (or (:adapter opts) (host/websocket))})))\n    65\t\n    66\t\n    67\t(defn boot-server\n    68\t  \"Compose the served endpoint for `--port`, or nil when no port was asked for.\n    69\t\n    70\t   `serve!` returns immediately.  Whether a listener bound is a fact the\n    71\t   endpoint's lifecycle medium reports, and the ticker prints it.\"\n    72\t  [opts]\n    73\t  (when (:port opts)\n    74\t    (serve/serve! {:bind-port (:port opts)\n    75\t                   :bind-host (or (:host opts) serve/default-bind-host)\n    76\t                   :host (or (:adapter opts) (host/websocket))})))\n    77\t\n    78\t\n    79\t(defn- entry-text\n    80\t  [entry]\n    81\t  (or (get entry driver/text-key) (get entry serve/text-key)))\n    82\t\n    83\t\n    84\t(defn banner\n    85\t  \"Text the composition prints before the first prompt, given parsed options.\"\n    86\t  [opts]\n    87\t  (cond-> []\n    88\t    (seq (:rejected opts)) (conj telemetry-text)\n    89\t    (and (:headless? opts) (not (:port opts)))\n    90\t    (conj \"--headless has nothing to attend without a served endpoint\")))\n    91\t\n    92\t\n    93\t(defn step-all\n    94\t  \"One tick of the single step owner: the local shell first, then the served\n    95\t   endpoint — against the same shell value.  A `--port` process serves one\n    96\t   shared shell, as v1's atom made it: the driver evaluates this tick's local\n    97\t   lines first, so a definition typed at the local prompt is already in the\n    98\t   shell the endpoint evaluates remote requests against in the same tick, and\n    99\t   the endpoint's shell — remote definitions included — is threaded back before\n   100\t   the next tick.  Returns `[state server lines]`; the caller only prints.\"\n   101\t  [state server now]\n   102\t  (let [stepped (driver/repl-step state now)\n   103\t        [entries state'] (driver/take-outbox stepped)\n   104\t        server' (when server (serve/step (assoc-in server [:repl] (:repl state'))\n   105\t                                         now))\n   106\t        [server-entries server''] (if server'\n   107\t                                    (serve/take-outbox server')\n   108\t                                    [[] nil])\n   109\t        state'' (if server'' (assoc state' :repl (:repl server'')) state')]\n   110\t    [state'' server'' (mapv entry-text (into (vec entries) server-entries))]))\n   111\t\n   112\t\n   113\t;; =============================================================================\n   114\t;; Shutdown\n   115\t;; =============================================================================\n   340\t\n   341\t#?(:cljd\n   342\t   (do\n   343\t     (defn- write-line!\n   344\t       [message]\n   345\t       (println message))\n   346\t\n   347\t     (defn- print-prompt!\n   348\t       []\n   349\t       (.write io/stdout prompt)\n   350\t       (.flush io/stdout))\n   351\t\n   352\t     (defn- run-dart!\n   353\t       \"One `Timer.periodic` owns both values.  A synchronous poll loop would\n   354\t        deadlock the Dart event loop: IO never progresses, so `blocked` never\n   355\t        clears.\n   356\t\n   357\t        `:stopping` is nil while the shell runs and a tick budget afterwards:\n   358\t        the endpoint is asked to stop once and stepped until it reports it, so\n   359\t        the host does not exit with a live listener.\"\n   360\t       [state server headless?]\n   361\t       (let [box (atom {:state state :server server :stopping nil})]\n   362\t         (async/Timer.periodic\n   363\t           (dart-core/Duration .milliseconds tick-millis)\n   364\t           (fn [^async/Timer timer]\n   365\t             (let [{:keys [state server stopping]} @box\n   366\t                   now (.-millisecondsSinceEpoch (dart-core/DateTime.now))\n   367\t                   finish! (fn []\n   368\t                             (.cancel timer)\n   369\t                             (io/exit 0)\n   370\t                             nil)]\n   371\t               (if (nil? stopping)\n   372\t                 (let [[state' server' lines] (step-all state server now)]\n   373\t                   (reset! box {:state state' :server server' :stopping nil})\n   374\t                   (doseq [line lines]\n   375\t                     (write-line! line))\n   376\t                   (cond\n   377\t                     (:running? state')\n   378\t                     (when (and (seq lines) (not headless?))\n   379\t                       (print-prompt!))\n   380\t\n   381\t                     server'\n   382\t                     (do (swap! box assoc\n   383\t                                :server (serve/stop! server')\n   384\t                                :stopping stop-ticks)\n   385\t                         nil)\n   386\t\n   387\t                     :else (finish!)))\n   388\t                 (let [[server' lines stopped?] (stop-tick server now)]\n   389\t                   (doseq [line lines]\n   390\t                     (write-line! line))\n   391\t                   (cond\n   392\t                     stopped? (finish!)\n   393\t                     (zero? stopping) (do (write-line! stop-timeout-text)\n   394\t                                          (finish!))\n   395\t                     :else (do (swap! box assoc\n   396\t                                      :server server'\n   397\t                                      :stopping (dec stopping))\n   398\t                               nil)))))))))\n   399\t\n   400\t     (defn -main\n   401\t       [& args]\n   402\t       (let [opts (parse-args args)\n   403\t             state (boot opts)\n   404\t             server (boot-server opts)\n   405\t             headless? (boolean (:headless? opts))]\n   406\t         (doseq [line (banner opts)]\n   407\t           (write-line! line))\n   408\t         (if headless?\n   409\t           ;; Headless has no reader, so the explicit stop trigger is the host\n   410\t           ;; signal: it appends a line and returns, like any producer.\n   411\t           (-> (.watch io/ProcessSignal.sigint)\n   412\t               (.listen (fn [_signal] (request-stop! state))))\n   413\t           (do (-> io/stdin\n   414\t                   (.transform (.-decoder convert/utf8))\n   415\t                   (.transform (convert/LineSplitter.))\n   416\t                   (.listen (fn [line] (driver/submit-line! (:input state) line))\n   417\t                            .onDone (fn [] (driver/submit-line! (:input state) \"(quit)\"))))\n   418\t               (print-prompt!)))\n   419\t         (run-dart! state server headless?)))\n   420\t\n","exit_code":0,"status":"completed"}}
