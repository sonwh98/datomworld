e\n   595\t      (let [result (stream/next (:reader session) (:cursor session))\n   596\t            outcome (:dao.stream/outcome result)]\n   597\t        (case outcome\n   598\t          :dao.stream/ok\n   599\t          (interpret-element endpoint attachment\n   600\t                             (:dao.stream/value result)\n   601\t                             (:dao.stream/cursor result))\n   602\t\n   603\t          :dao.stream/blocked endpoint\n   604\t\n   605\t          ;; A defective peer can still overrun its own request medium.  The\n   606\t          ;; session is closed rather than left with an unanswerable request.\n   607\t          :dao.stream/gap\n   608\t          (-> endpoint\n   609\t              (assoc-in [:sessions attachment :cursor] (:dao.stream/cursor result))\n   610\t              (publish :yin.repl.serve/notice\n   611\t                       (str \";; requests lost from \" attachment \"; closing it\"))\n   612\t              (close-attachment! attachment :dao.stream/gap))\n   613\t\n   614\t          (close-attachment! endpoint attachment outcome))))))\n   615\t\n   616\t\n   617\t(defn- advance-sessions\n   618\t  [endpoint]\n   619\t  (reduce session-step endpoint (keys (:sessions endpoint))))\n   620\t\n   621\t\n   622\t;; =============================================================================\n   623\t;; The driver step\n   624\t;; =============================================================================\n   625\t\n   626\t(defn stopped?\n   627\t  \"True when nothing more is owed to this endpoint's shutdown: it reported\n   628\t   `:stopped`, or it never composed a serving driver at all.\n   629\t\n   630\t   A refused bind configuration or a missing host package leaves an endpoint\n   631\t   that owns its media and its reason and nothing else.  No host close\n   632\t   completion exists to deposit `:stopped` for it, so a shutdown that waited for\n   633\t   one would spend its whole budget and then report a timeout for a listener\n   634\t   that never bound.\"\n   635\t  [endpoint]\n   636\t  (or (nil? endpoint)\n   637\t      (= :stopped (:status endpoint))\n   638\t      (nil? (:serving endpoint))))\n   639\t\n   640\t\n   641\t(defn stop!\n   642\t  \"Initiate stop, claiming nothing about completion.\n   643\t\n   644\t   Closing the service stream is what makes a connected client deposit\n   645\t   `:ws/ended` rather than `:ws/closed`; the serving composition performs that\n   646\t   transport-specific close on its next step.  Only the host close completion\n   647\t   deposits `:stopped`, and only `step` consuming it marks the stop complete and\n   648\t   releases the resolution-table entry.\n   649\t\n   650\t   An endpoint with no serving driver is left exactly as it is: it holds no\n   651\t   listener and no attachment, so there is nothing to initiate, and marking it\n   652\t   `:stopping` would both claim a stop nobody can complete and erase the status\n   653\t   that says why it never started.\"\n   654\t  [endpoint]\n   655\t  (if (or (contains? #{:stopping :stopped} (:status endpoint))\n   656\t          (nil? (:serving endpoint)))\n   657\t    endpoint\n   658\t    (do\n   659\t      (when (:service endpoint)\n   660\t        (stream/close! (:service endpoint)))\n   661\t      (assoc endpoint :status :stopping))))\n   662\t\n   663\t\n   664\t(defn- finish-stop\n   665\t  [endpoint]\n   666\t  (if (and (= :stopping (:status endpoint))\n   667\t           (not (:stop-initiated? endpoint))\n   668\t           (:serving endpoint))\n   669\t    (let [result (serving/stop! (:serving endpoint))\n   670\t          endpoint (assoc endpoint :stop-initiated? true)]\n   671\t      (if (= :dao.stream/transport-error (:dao.stream/outcome result))\n   672\t        ;; A synchronous release failure has no later host completion to\n   673\t        ;; observe.  The composition owns that fact and resolves locally,\n   674\t        ;; retaining the structured reason in the ordinary notice stream.\n   675\t        (-> endpoint\n   676\t            (assoc :status :stopped :resolution nil)\n   677\t            (publish :yin.repl.serve/notice\n   678\t                     (str \"Endpoint stopped without host completion: \"\n   679\t                          (pr-str (data/summarize (:dao.stream/diagnostic result) diagnostic-bounds)))))\n   680\t        endpoint))\n   681\t    endpoint))\n   682\t\n   683\t\n   684\t(defn step\n   685\t  \"Advance the endpoint once at `now`, returning the next endpoint value.\n   686\t\n   687\t   Ordering is intentional: lifecycle first, so a bind result is known before\n   688\t   anything claims to be serving; then the transport and serving composition;\n   689\t   then session adoption; then one bounded step per session against the single\n   690\t   shared REPL state.\"\n   691\t  [endpoint now]\n   692\t  (if-not endpoint\n   693\t    endpoint\n   694\t    (let [endpoint (drain-lifecycle endpoint)]\n   695\t      (if-not (:serving endpoint)\n   696\t        ;; An endpoint that never composed a serving driver — a refused bind\n   697\t        ;; configuration or a missing host package — still owns and reports its\n   698\t        ;; lifecycle medium; it simply has no sessions to advance.\n   699\t        endpoint\n   700\t        (do\n   701\t          (serving/step! (:serving endpoint) now)\n   702\t          (-> endpoint\n   703\t              sync-sessions\n   704\t              advance-sessions\n   705\t              finish-stop))))))\n   706\t\n   707\t\n   708\t(defn summary\n   709\t  \"A serializable summary of endpoint state, for `(repl-state)` and tests.\"\n   710\t  [endpoint]\n   115\t  (assoc state :adapter nil :queued [] :outstanding nil :retrying nil))\n   116\t\n   117\t\n   118\t(defn- publish\n   119\t  [state event text]\n   120\t  (if (str/blank? (str text))\n   121\t    state\n   122\t    (update state :outbox conj {event-key event text-key text})))\n   123\t\n   124\t\n   125\t;; =============================================================================\n   126\t;; Input\n   127\t;; =============================================================================\n   128\t\n   129\t(defn- drain-input\n   130\t  \"Read up to `input-budget` input elements, total over every `next` outcome.\n   131\t   A gap means typed lines were evicted: the loss is published, the recovery\n   132\t   cursor is taken, and none of the missing input is evaluated.\"\n   133\t  [state]\n   134\t  (loop [remaining input-budget\n   135\t         state state\n   136\t         lines []]\n   137\t    (if (or (zero? remaining) (nil? (:input-cursor state)))\n   138\t      [state lines]\n   139\t      (let [result (stream/next (:input state) (:input-cursor state))\n   140\t            outcome (:dao.stream/outcome result)]\n   141\t        (case outcome\n   142\t          :dao.stream/ok\n   143\t          (recur (dec remaining)\n   144\t                 (assoc state :input-cursor (:dao.stream/cursor result))\n   145\t                 (conj lines (get (:dao.stream/value result) line-key)))\n   146\t\n   147\t          :dao.stream/gap\n   148\t          (recur (dec remaining)\n   149\t                 (-> state\n   150\t                     (assoc :input-cursor (:dao.stream/cursor result))\n   151\t                     (publish :yin.repl.driver/notice\n   152\t                              \";; input lost: typed lines were evicted before this step\"))\n   153\t                 lines)\n   154\t\n   155\t          :dao.stream/blocked\n   156\t          [(assoc state :input-ledger outcome) lines]\n   157\t\n   158\t          [(-> state\n   159\t               (assoc :input-ledger outcome)\n   160\t               (publish :yin.repl.driver/notice\n   465\t\n   466\t\n   467\t(defn- publish-adapter-events\n   468\t  \"Move the adapter's event outbox into the driver's, exactly once.\"\n   469\t  [state]\n   470\t  (let [[events adapter] (adapter/take-events (:adapter state))]\n   471\t    (reduce (fn [state event]\n   472\t              (-> state\n   473\t                  (cond-> (clears-outstanding? state event)\n   474\t                    (assoc :outstanding nil))\n   475\t                  (publish (completion-event-kind event) (completion-text event))))\n   476\t            (assoc state :adapter adapter)\n   477\t            events)))\n   478\t\n   479\t\n   480\t(defn- poll-remote\n   481\t  [state]\n   482\t  (if-not (:adapter state)\n   483\t    state\n   484\t    (let [result (adapter/poll-responses (:adapter state) response-budget)]\n   485\t      (publish-adapter-events (assoc state :adapter\n   486\t                                     (:yin.repl.adapter/state result))))))\n   487\t\n   488\t\n   489\t(defn- observe-connection\n   490\t  \"Publish the boundary's neutral lifecycle facts.  `Connected to …` is printed\n   491\t   here, when `/established` is observed, and never when `attach!` returned.\"\n   492\t  [state]\n   493\t  (if-not (:connection state)\n   494\t    state\n   495\t    (let [[connection events] (connect/observe (:connection state))]\n   496\t      (reduce (fn [state event]\n   497\t                (publish state\n   498\t                         (get event connect/event-key)\n   499\t                         (get event connect/text-key)))\n   500\t              (assoc state :connection connection)\n   501\t              events))))\n   502\t\n   503\t\n   504\t(defn- retry-unsent\n   505\t  \"The one path that resends a retained envelope.  It is owed only while RPC\n   506\t   still holds it: an abandoned request leaves nothing to retry, whatever the\n   507\t   driver last recorded.\"\n   508\t  [state]\n   509\t  (if (and (remote-routed? state)\n   510\t           (remote-unsent? state)\n   511\t           (:retrying state)\n   512\t           (not (remote-terminal state)))\n   513\t    (submit-remote state (:retrying state))\n   514\t    state))\n   515\t\n   516\t\n   517\t(defn- release-queue\n   518\t  [state]\n   519\t  (if (and (remote-routed? state)\n   520\t           (not (remote-terminal state))\n   521\t           (seq (:queued state))\n   522\t           (not (:outstanding state))\n   523\t           (not (:retrying state))\n   524\t           (not (remote-unsent? state)))\n   525\t    (let [[line & rest-lines] (:queued state)]\n   526\t      (-> state\n   527\t          (assoc :queued (vec rest-lines))\n   528\t          (submit-remote line)))\n   529\t    state))\n   530\t\n   531\t\n   532\t;; =============================================================================\n   533\t;; The step\n   534\t;; =============================================================================\n   535\t\n   536\t(defn repl-step\n   537\t  \"Advance the REPL once.  Called by exactly one ticker per host; never loops on\n   538\t   `:dao.stream/blocked`.  `now` is the host's clock reading, recorded but not\n   539\t   waited on: this layer has no deadline of its own.\"\n   540\t  [state now]\n   541\t  (let [state (assoc state :last-tick now)\n   542\t        state (retry-unsent state)\n   543\t        ;; Completions and lifecycle are observed before this tick's lines are\n   544\t        ;; handled, so a `(connect …)` typed in the same tick as the drop that\n   545\t        ;; makes it legal sees the terminal fact rather than being told the\n   546\t        ;; shell is already connected.\n   547\t        state (poll-remote state)\n   548\t        state (observe-connection state)\n   549\t        [state lines] (drain-input state)\n   550\t        state (reduce handle-line state lines)]\n   551\t    (release-queue state)))\n   700\t  outputs for the causing runtime input; a full diagnostic stream later\n   701\t  parks on that value without recursive diagnostics.\"\n   702\t  [binding destination value]\n   703\t  (let [interval (park-interval-key destination value)\n   704\t        same-interval? (= interval (:park binding))\n   705\t        binding (assoc binding :park interval)]\n   706\t    (if (and (= :dispatch destination) (not same-interval?))\n   707\t      (let [causing-seq (:runtime/seq value)\n   708\t            assigned (keep (fn [entry]\n   709\t                             (let [v (:value entry)]\n   710\t                               (when (= causing-seq (:runtime/seq v))\n   711\t                                 (:output/seq v))))\n   712\t                           (:pending binding))\n   713\t            diagnostic {:diagnostic/kind :dao.gui.event/dispatch-backpressure,\n   714\t                        :severity :warning,\n   715\t                        :reason :dispatch-stream-full,\n   716\t                        :runtime/seq causing-seq,\n   717\t                        :output/seq (inc (long (reduce max -1 assigned)))}]\n   718\t        (update binding\n   719\t                :pending\n   720\t                conj\n   721\t                {:destination :diagnostic, :value diagnostic}))\n   722\t      binding)))\n   723\t\n   724\t\n   725\t(defn- flush-pending\n   726\t  \"Append pending outputs in order until the queue empties or one parks.\n   727\t  Appended values leave the queue and are never appended again. A nil\n   728\t  destination stream is a permissive sink for that destination.\"\n   729\t  [binding]\n   730\t  (loop [binding binding]\n   731\t    (let [pending (:pending binding)]\n   732\t      (if (empty? pending)\n   733\t        (assoc binding :park nil)\n   734\t        (let [{:keys [destination value]} (first pending)\n   735\t              stream (get-in binding [:outputs destination])]\n   736\t          (if (nil? stream)\n   737\t            (recur (update binding :pending subvec 1))\n   738\t            (let [outcome (:dao.stream/outcome (ds/append! stream value))]\n   739\t              (cond\n   740\t                ;; only full parks: a transport may refuse transiently\n   741\t                (= :dao.stream/full outcome)\n   742\t                (enter-park binding destination value)\n   743\t                (= :dao.stream/ok outcome)\n   744\t                (recur (update binding :pending subvec 1))\n   745\t                ;; closed, invalid-value, and transport-error mean the\n   746\t                ;; output is gone: drop the value with one diagnostic\n   747\t                ;; rather than parking on it or retrying\n   748\t                :else (do (prn \"dao.gui.event output gone; dropping pending\"\n   749\t                               {:destination destination, :outcome outcome})\n   750\t                          (recur (update binding :pending subvec 1)))))))))))\n   751\t\n   752\t\n   753\t(defn- close-outputs\n   754\t  \"Close every runtime-owned output stream. The input stream is owned by\n   755\t  the multiplexer and is never closed here.\"\n   756\t  [binding]\n   757\t  (doseq [k output-destinations]\n   758\t    (when-let [stream (get-in binding [:outputs k])] (ds/close! stream)))\n   759\t  (assoc binding :closed? true))\n   760\t\n   761\t\n   762\t(defn advance\n   763\t  \"The public binding driver over DaoStream v2 handles. Retries pending\n   764\t  output in order before reading; reads at most one runtime input per\n   765\t  call; consumes it exactly once and retains the cursor even if its output\n   766\t  subsequently parks; steps the total reducer and routes the ordered\n   767\t  outputs to their destination streams. Returns {:binding next-binding\n   768\t  :status ...} where status is :advanced, :parked, :blocked, :end,\n   769\t  :input-gap, :transport-error, or :closed; an :input-gap result also\n   770\t  carries :recovery-cursor, the cursor the gap outcome carried. After one\n   771\t  valid teardown input is fully flushed the binding closes all seven\n   772\t  runtime-owned outputs; later inputs are ignored. A terminal input\n   773\t  outcome is retained: later calls return :transport-error without\n   774\t  reading again.\"\n   775\t  [binding]\n   776\t  (if (:closed? binding)\n   777\t    {:binding binding, :status :closed}\n   778\t    (let [flushed (flush-pending binding)]\n   779\t      (cond\n   780\t        (:park flushed) {:binding flushed, :status :parked}\n   781\t        (:teardown? flushed) {:binding (close-outputs flushed), :status :closed}\n   782\t        ;; the input lane died on a terminal outcome: report it again\n   783\t        ;; without issuing another read\n   784\t        (:input-error? flushed) {:binding flushed, :status :transport-error}\n   785\t        :else\n","exit_code":0,"status":"completed"}}
