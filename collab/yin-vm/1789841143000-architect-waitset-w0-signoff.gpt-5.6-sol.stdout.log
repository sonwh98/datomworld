2\t   run-fn must be the VM-specific raw runner that advances the VM until halt\n   233\t   or block without recursively calling vm/run again.\"\n   234\t  [vm run-fn]\n   235\t  (if-not (installed? vm)\n   236\t    (run-fn vm)\n   237\t    (loop [v (run-fn vm)]\n   238\t      (if (:blocked? v)\n   239\t        (let [{:keys [handled? diagnostic vm]} (bridge-step v)]\n   240\t          (cond handled? (recur (run-fn vm))\n   241\t                ;; A malformed request consumed as a diagnostic advanced the\n   242\t                ;; cursor, so there may be a real request behind it.\n   243\t                diagnostic (recur vm)\n   244\t                :else vm))\n   245\t        v))))\n   115\t\n   116\t\n   117\t(defn new-stream\n   118\t  \"Create one ring buffer handle or throw.\"\n   119\t  []\n   120\t  (let [result (make-stream stream-capacity)]\n   121\t    (if (= :dao.stream/ok (:dao.stream/outcome result))\n   122\t      (:dao.stream/handle result)\n   123\t      (throw (ex-info \"Demo stream creation failed\" {:result result})))))\n   124\t\n   125\t\n   126\t(defn put-continuation!\n   127\t  \"Append one continuation as a single-element batch. Returns the result so\n   128\t   the caller can see the outcome.\"\n   129\t  [writer continuation]\n   130\t  (stream/append! writer [continuation]))\n   131\t\n   132\t\n   133\t(defn read-continuation!\n   134\t  \"Read one continuation at the reader's cursor, advancing to the exact\n   135\t   successor. `next` returns a whole batch, so the single element is the\n   136\t   continuation this medium carries; anything else is a lost read and is\n   137\t   reported rather than returned.\"\n   138\t  [reader cursor]\n   139\t  (let [result (stream/next reader cursor)\n   140\t        outcome (:dao.stream/outcome result)\n   141\t        batch (:dao.stream/value result)]\n   142\t    (if (and (= :dao.stream/ok outcome) (= 1 (count batch)))\n   143\t      {:value (nth batch 0), :cursor (:dao.stream/cursor result)}\n