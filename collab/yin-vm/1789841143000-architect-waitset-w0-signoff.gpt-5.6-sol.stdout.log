113\t               ;; The cursor advanced only because the append answered ok;\n   114\t               ;; `observe/step` owns that ordering.\n   115\t               :advance\n   116\t               (recur (:cursor observed) (dec remaining) resumes (inc forwarded))\n   117\t\n   118\t               ;; Source `blocked` and destination `full` are the same answer\n   119\t               ;; to this interpreter: no progress, cursor kept, step again.\n   120\t               :retry\n   121\t               (result-state cursor :retry forwarded outcome)\n   122\t\n   438\t   is read, so the first defect in stream order is the one reported and no\n   439\t   read happens past it. A well-formed but unexpected outcome means the handle\n   440\t   is not the transport the composition owes.\"\n   441\t  [local-stream]\n   442\t  (let [mint (checked :cursor (stream/cursor local-stream :dao.stream/oldest))]\n   443\t    (when-not (= :dao.stream/ok (:dao.stream/outcome mint))\n   444\t      (throw (ex-info \"local stream refused an :oldest cursor\" {:result mint})))\n   445\t    (loop [cursor (:dao.stream/cursor mint)\n   446\t           datoms []]\n   447\t      (let [r (checked :next (stream/next local-stream cursor))]\n   448\t        (case (:dao.stream/outcome r)\n   449\t          :dao.stream/ok\n   450\t          (recur (:dao.stream/cursor r)\n   451\t                 (into datoms (element-datoms (:dao.stream/value r))))\n   452\t          (:dao.stream/blocked :dao.stream/end) datoms\n   453\t          (throw (ex-info \"local stream is not a complete-retention transport\"\n   454\t                          {:outcome (:dao.stream/outcome r), :result r})))))))\n   455\t\n   456\t\n   229\t(defn maybe-run\n   230\t  \"Run a VM with bridge dispatch if explicit bridge handlers are installed.\n   231\t\n   232\t   run-fn must be the VM-specific raw runner that advances the VM until halt\n   233\t   or block without recursively calling vm/run again.\"\n   234\t  [vm run-fn]\n   235\t