\t                (.setDaemon true)\n   987\t                (.setName \"dao.jing.remote/content-endpoint\")\n   988\t                (.start))\n   989\t              {:port (or @bound-port port)\n   990\t               :stop! (fn []\n   991\t                        (when (compare-and-set! running true false)\n   992\t                          (serving/stop! composition)\n   993\t                          nil))\n   994\t               :serving composition\n   995\t               :lifecycle lifecycle})))))))\n   996\t\n   997\t\n   998\t#?(:clj (comment\n   999\t          (require '[dao.jing.file :as file])\n  1000\t          (def store\n   375\t          :dao.stream.apply/detached\n   376\t          (let [state (lose-outstanding state lifecycle true)]\n   377\t            (rpc-result :dao.stream.rpc/lost state :dao.stream.rpc/reason lifecycle))\n   378\t\n   379\t          (:dao.stream.apply/ended\n   380\t            :dao.stream.apply/not-found\n   381\t            :dao.stream.apply/transport-error)\n   382\t          (let [state (lose-outstanding state lifecycle true)]\n   383\t            (rpc-result :dao.stream.rpc/lost state :dao.stream.rpc/reason lifecycle))\n   384\t\n   385\t          (handle-event state (diagnostic-event :dao.stream.rpc/unhandled-event event))))\n   386\t\n   387\t      :else\n   388\t      (handle-event state (diagnostic-event :dao.stream.rpc/unhandled-event event)))))\n   389\t\n   390\t\n   391\t(defn- poll-read\n   392\t  [state]\n   393\t  (let [read-result (valid-operation-result :next (stream/next (:reader state) (:cursor state)))\n   394\t        outcome (:dao.stream/outcome read-result)]\n   395\t    (case outcome\n   396\t      :dao.stream/ok\n   397\t      ;; Advance before decoding. A malformed or unsolicited element is thereby\n   398\t      ;; consumed exactly once and cannot poison polling.\n   399\t      (handle-event (assoc state :cursor (:dao.stream/cursor read-result))\n   400\t                    (decode-value state (:da