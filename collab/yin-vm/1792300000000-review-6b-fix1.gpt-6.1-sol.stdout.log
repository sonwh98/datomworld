:yin.k/name mn :yin.k/phase phase}))\n    (when-not (try (cbor/encode response) true\n                   (catch #?(:cljd Object :clj Throwable :cljs :default) _e false))\n      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n    (node :install [mn phase parent response\n                    (lift-task* (:vm inst) (:serve! ctx) (dissoc opts :free-env) :child)])))\n\n\n(defn- lift-task*\n  [m serve! opts role]\n  (when (seq (:ready-queue m))\n    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n  (when-some [h (unliftable-hold m)]\n(defn halted-with-empty-queue?\n  \"Returns true if the VM has halted and its ready-queue is empty.\"\n  [vm]\n  (and (boolean (:halted? vm)) (empty? (or (:ready-queue vm) []))))\n\n\n(defn restore-initial-env\n  \"After eval, restore :env to initial-env when the computation halted.\n   Blocked and parked states keep the active lexical env for resumption.\"\n  [initial-env result]\n  (if (halted-with-empty-queue? result) (assoc result :env initial-env) result))\n    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n     :receiver (constantly {:opts {:modules (:modules m)}})}))\n\n\n(defn run-beside\n  [m ast]\n  (vm/run (load-program m ast)))\n\n\n(defn parking\n  [m]\n52:   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n53:   :env [[:ref :bindings] :optional-D]\n54:   :closure [:A :N :syms [:ref :bindings] :optional-D]\n65:   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n164:    (contains? #{:map :bindings :store :parked-table} kind)\n293:(def ^:private keyed-structural #{:bindings :store :parked-table})\n912:         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n999:  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n1051:  (let [[bindings store-of] (:slots n)]