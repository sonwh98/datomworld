n   617\t   supplies may already hold results from another shell or an earlier\n   170\t\n   171\t(defn- prepare-env\n   172\t  \"Walk the user env. For each value that is a v2 handle, allocate a fresh\n   173\t   store key, replace the env value with a :stream-ref pointing at that key,\n   174\t   and record the handle in :store-updates so the caller can splice it into\n   175\t   the VM store. Non-handle values pass through unchanged.\"\n   176\t  [env]\n   177\t  (reduce-kv (fn [acc sym v]\n   178\t               (if (host-stream? v)\n   179\t                 (let [id (keyword (str \"await-stream-\" (name (gensym \"\"))))]\n   180\t                   (-> acc\n   181\t                       (assoc-in [:env sym] {:type :stream-ref, :id id})\n   182\t                       (assoc-in [:store-updates id] v)))\n   183\t                 (assoc-in acc [:env sym] v)))\n   184\t             {:env {}, :store-updates {}}\n   185\t             env))\n   186\t\n   187\t\n   188\t(defn- result-map\n   189\t  [proc vm-state]\n   190\t  {:type :dao.await/result,\n   191\t   :vm vm-state,\n   192\t   :value (vm/value vm-state),\n   193\t   :blocked? (vm/blocked? vm-state),\n   194\t   :proc proc})\n   195\t\n   196\t\n   197\t(defn run\n   198\t  \"Drive a process on a fresh yin.vm ast-walker VM until it returns a\n   199\t   value or parks on a stream effect.\n   200\t\n   201\t   opts are host-composition options passed to yin.vm.ast-walker/create-vm\n   202\t   (:make-stream, :primitives, :call-in/:call-out, :bridge). :env always\n   203\t   comes from the process, and :modules is the caller's registry with the\n   204\t   await bindings layered on top, so await names always resolve.\n   205\t\n   206\t   Returns a result map:\n   207\t     {:type :dao.await/result\n   208\t      :vm   <vm state>\n   209\t      :value <result-value | :yin/blocked>\n   210\t      :blocked? <bool>\n   211\t      :proc <original process descriptor>}\n   212\t\n   213\t   A blocked process is resumed with (await/resume result) once the host has\n   214\t   appended to (or closed) the stream a parked entry is waiting on.\"\n   215\t  ([proc] (run proc {}))\n   216\t  ([proc opts]\n   217\t   (let [{:keys [env store-updates]} (prepare-env (:env proc))\n   218\t         vm (-> (ast-walker/create-vm\n   219\t                  (assoc opts\n   220\t                         :modules (registry (:modules opts))\n   221\t                         :env env))\n   222\t                (update :store merge store-updates))\n   223\t         after (vm/eval vm (:ast proc))]\n   224\t     (result-map proc after))))\n    54\t(defn resolve-var\n    55\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n    56\t\n    57\t   The registry is a value supplied by the composition, not a global.\"\n    58\t  [env store primitives registry name]\n    59\t  (if-let [pair (find env name)]\n    60\t    (val pair)\n    61\t    (if-let [pair (find store name)]\n    62\t      (val pair)\n    63\t      (if-let [pair (find primitives name)]\n    64\t        (vm/primitive-function (val pair))\n    65\t        (if-let [resolved (when (namespace name)\n    66\t                            (module/resolve-module\n    67\t                              registry\n    68\t                              (symbol (str (namespace name)\n    69\t                                           \".\"\n    70\t                                           (clojure.core/name name)))))]\n    71\t          resolved\n    72\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n    73\t                {:symbol name}))))))\n    74\t\n    75\t\n    76\t(defn- gen-id\n   280\t   the entry: another waiter on the same cursor-ref may have advanced the\n   281\t   stored cursor since. `:advance` is the sweep's old write-back: it\n   282\t   commits a woken reader's successor — or recovery — cursor to the store\n   283\t   before later entries resolve, so a shared cursor-ref advances within the\n   284\t   round.\"\n   285\t  {:resolve (fn [store entry]\n   286\t              (if-let [cursor-ref (:cursor-ref entry)]\n   287\t                (let [cursor-data (get store (:id cursor-ref))]\n   288\t                  {:stream (or (:stream entry)\n   289\t                               (get store (:stream-id cursor-data)))\n   290\t                   :cursor (:cursor cursor-data)})\n   291\t                {:stream (or (:stream entry) (get store (:stream-id entry)))\n   292\t                 :value (:datom entry)}))\n   293\t   :advance (fn [store entry cursor]\n   294\t              (let [cursor-id (:id (:cursor-ref entry))]\n   295\t                (if cursor-id\n   296\t                  (assoc store\n   297\t                         cursor-id\n   298\t                         (assoc (get store cursor-id) :cursor cursor))\n   299\t                  store)))})\n   300\t\n   404\t(defn resume-from-run-queue\n   405\t  \"Pop first entry from the ready-queue, merge store-updates, and restore\n   406\t   VM-specific context.\n   407\t\n   408\t   Restoration is dispatched here rather than carried on the entry, so a\n   409\t   ready entry holds registers, ids, and values — never a closure. The\n   410\t   terminal-outcome check runs before the restore: a woken retry that ended\n   411\t   in an outcome the immediate operation raises as an error must fail the\n   412\t   same way here, not reach Yin code as a value.\n   413\t\n   414\t   `restore-fn` is called with three arguments, `base entry val`, where\n   415\t   `val` is the woken `:value` — the same signature `resume-continuation`\n   416\t   uses, so one restore serves both engine call sites\n   417\t   (`yin.vm.engine.md` §7, edit 2).\"\n   418\t  [state restore-fn]\n   419\t  (let [run-queue (or (:ready-queue state) [])]\n   420\t    (when (seq run-queue)\n   421\t      (let [entry (first run-queue)\n   422\t            rest-queue (subvec run-queue 1)\n   423\t            base (assoc state\n   424\t                        :ready-queue rest-queue\n   425\t                        :store (merge (:store state) (:store-updates entry))\n   426\t                        :blocked? false\n   427\t                        :halted? false)]\n   428\t        (if-let [terminal (terminal-resume-outcome entry)]\n   429\t          (throw-terminal-resume! entry terminal)\n   430\t          (restore-fn base entry (:value entry)))))))\n   385\t\n   386\t\n   387\t(defn unsatisfied-names\n   388\t  \"The lexically required names of a static safepoint that the frame's\n   389\t   environment does not bind and that `resolvable` (store, primitives,\n   390\t   modules -- the rest of `resolve-var`'s order) does not answer: the\n   391\t   conformance check that a frame carries what its code will read.\"\n   392\t  [safepoint frame resolvable]\n   393\t  (vec (remove (fn [n]\n   394\t                 (or (contains? (:env frame) n) (resolvable n)))\n   395\t               (:yin.safepoint/lexically-required safepoint))))\n","exit_code":0,"status":"completed"}}
