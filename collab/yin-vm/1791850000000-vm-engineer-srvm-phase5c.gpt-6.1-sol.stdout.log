   (java.net.http\n      HttpClient\n      HttpClient$Redirect\n      HttpRequest\n      HttpResponse$BodyHandlers)\n    (java.security\n      MessageDigest)\n    (javax.tools\n      ToolProvider)))\n\n\n(def manifest-path \"antlr/python3/manifest.edn\")\n\n(def build-dir \"build/antlr/python3\")\n\n\n(defn- sha256\n  [^bytes bs]\n  (let [d (.digest (MessageDigest/getInstance \"SHA-256\") bs)]\n    (apply str (map #(format \"%02x\" (bit-and % 0xff)) d))))\n\n\n(defn- http-get-bytes\n  ^bytes [url]\n  (let [client (-> (HttpClient/newBuilder)\n                   (.followRedirects HttpClient$Redirect/NORMAL)\n                   (.build))\n        req (-> (HttpRequest/newBuilder (URI/create url))\n                (.header \"User-Agent\" \"datomworld-yang-antlr-gen\")\n                (.build))\n        resp (.send client req (HttpResponse$BodyHandlers/ofByteArray))]\n    (when-not (= 200 (.statusCode resp))\n      (throw (ex-info \"Fetch failed\" {:url url, :status (.statusCode resp)})))\n    (.body resp)))\n\n\n(defn- read-manifest\n  []\n  (edn/read-string (slurp manifest-path)))\n\n\n(defn- raw-url\n86:               (io/copy bs target)\n88:    (.exists target) (read-bytes target)\n90:            (io/copy bs target)\n104:                     :let [target (io/file src-dir (str/replace file \"/\" \"__\"))\n105:                           bs (source-bytes! grammar file entry target)\n112:                 (do (.delete target)\n204:  (let [classes (io/file build-dir \"classes\")\n209:    (delete-tree! classes)\n210:    (.mkdirs classes)\n216:                                        (System/getProperty \"java.class.path\")\n217:                                        \"-d\" (.getPath classes)]\n220:        (throw (ex-info \"javac failed\" {:exit rc}))))\n221:    classes))\n241:    (println \"generated\" (count digests) \"java files; classes in\"\n242:             (str build-dir \"/classes\"))\n","exit_code":0,"status":"completed"}}
