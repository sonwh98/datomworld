set (vals profiles)))\n    75\t\n    76\t\n    77\t(defn profile-engine\n    78\t  \"The engine of `profile` when it is exactly one registry entry, the\n    79\t   inner version compared on the canonical integer kind so a float\n    80\t   carrier never equals its integral value; nil otherwise.\"\n    81\t  [profile]\n    82\t  (when (and (map? profile) (= 3 (count profile)))\n    83\t    (let [engine (:yin.k/engine profile)\n    84\t          p (get profiles engine)\n    85\t          v (:yin.k/version profile)]\n    86\t      (when (and p\n    87\t                 (= (:yin.code/contract p) (:yin.code/contract profile))\n    88\t                 (cbor/numeric? v)\n    89\t                 (= :integer (cbor/numeric-kind v))\n    90\t                 (cbor/num= v (:yin.k/version p)))\n    91\t        engine))))\n    92\t\n    93\t\n    94\t;; =============================================================================\n    95\t;; The canonical instruction vector (S7.3.2)\n   247\t(defn code-address\n   248\t  \"`:yin.code/hash` of a canonical vector: its `dao.jing` segment address.\n   249\t   UCF mints no second addressing scheme.\"\n   250\t  [v]\n   251\t  (jing/segment-key v))\n   252\t\n   434\t(defn activation-state\n   435\t  \"The dynamic half of a parked configuration, read off a frame -- a wait\n   436\t   entry or parked record `{segment pc env stack k}` -- never derived from\n   437\t   code: the absolute operand-stack depth, the names E actually binds, and\n   438\t   each return frame's activation base.\"\n   439\t  [frame]\n   440\t  {:yin.k/depth (count (:stack frame)),\n   441\t   :yin.k/bound (vec (sort-by str (keys (:env frame)))),\n   442\t   :yin.k/stack-bases (mapv :stack-base (:k frame))})\n   443\t\n   491\t(def ^:private wire-of-kind\n   492\t  \"The wire variants each static safepoint kind admits.  The static map\n   493\t   says where an instruction may park; the observed entry says why this\n   494\t   activation did.  An explicit park admits no waiter at all, and an\n   495\t   `:effectful-call` admits whatever effect the activation actually\n   496\t   produced -- a read, a write, an FFI state or a link state -- because\n   497\t   the instruction's kind selects none of them.\"\n   498\t  {:explicit-park #{}\n   499\t   :blocked-read #{:next}\n   500\t   :blocked-write #{:put}\n   501\t   :ffi-sent #{:ffi}\n   502\t   :ffi-retained #{:ffi-request}\n   503\t   :effectful-call #{:next :put :ffi :ffi-request\n   504\t                     :link-request :link-response :install}})\n   505\t\n   674\t(defn- lift-pending!\n   675\t  \"The S7.4.3 pending of one observed entry, in `yin.vm.ucf.remote`'s\n   676\t   wire shapes, minted through THIS export's one cell and marker maps:\n   677\t   the cell a waiter names is the same cell a closure or the store\n   678\t   reaches, and the response route a retained call held is a cell like\n   679\t   any other, at its kept position.\"\n   680\t  [vm serve! found encode entry]\n   681\t  (case (observed-wire entry (:engine (:v2 @found)))\n   682\t    :next\n   683\t    {:yin.k/reason :next\n   684\t     :yin.k/cell (cell-for! vm serve! found\n   685\t                            (get-in entry [:cursor-ref :id]))}\n   686\t\n   687\t    :ffi\n   688\t    (cond-> {:yin.k/reason :ffi\n   689\t             :yin.k/call-id (entry-call-id (:engine (:v2 @found)) entry)\n   690\t             :yin.k/cell (cell-for! vm serve! found\n   691\t                                    (get-in entry [:cursor-ref :id]))}\n   692\t      (contains? entry :op) (assoc :yin.k/op (:op entry)))\n   693\t\n   694\t    :put\n   695\t    (do (when-not (contains? entry :datom)\n   696\t          (non-portable! :incomplete-write\n   697\t                         {:yin.k/pc (:pc entry)}))\n   698\t        {:yin.k/reason :put\n   699\t         :yin.k/stream (marker-for! vm serve! found (:stream-id entry))\n   700\t         :yin.k/value (encode (:datom entry))})\n   701\t\n   702\t    :ffi-request\n   703\t    (let [route (if (and (:response-cursor entry)\n   704\t                         (:response-stream entry)\n   705\t                         (:yin.k/recovery-cell-ids vm))\n   706\t                  {:id (:response-cursor entry)\n   707\t                   :stream-id (:response-stream entry)}\n   708\t                  (call-out-cell (:resources vm)))]\n   709\t      (if (nil? route)\n   710\t        (unsatisfied!)\n   711\t        (let [envelope (:datom entry)]\n   712\t          {:yin.k/reason :ffi-request\n   713\t           :yin.k/call-id (entry-call-id (:engine (:v2 @found)) entry)\n   714\t           :yin.k/request-envelope (encode envelope)\n   715\t           :yin.k/request-op (or (apply2/request-op envelope)\n   716\t                                 (:op entry)\n   717\t                                 (:op (:k entry)))\n   718\t           :yin.k/request-args (apply2/request-args envelope)\n   719\t           :yin.k/request (marker-for! vm serve! found\n   720\t                                       (:stream-id entry))\n   721\t           :yin.k/response (marker-for! vm serve! found\n   722\t                                        (:stream-id route))\n   723\t           :yin.k/response-cell (cell-for! vm serve! found\n   724\t                                           (:id route))})))\n   725\t\n   726\t    (:link-request :link-response)\n   727\t    (let [reason (:reason entry)\n   728\t          kept (:cursor entry)]\n   729\t      (cond-> {:yin.k/reason reason\n   730\t               :yin.k/link-id (:link-id entry)\n   731\t               :yin.k/name (:name entry)\n   732\t               :yin.k/request (marker-for! vm serve! found\n   733\t                                           (:request entry))\n   734\t               :yin.k/response (marker-for! vm serve! found\n   735\t                                            (:response entry))\n   736\t               :yin.k/cell (cell-at! vm serve! found\n   737\t                                     [(:response entry) kept]\n   738\t                                     (:response entry) kept)}\n   739\t        (= :link-request reason)\n   740\t        (assoc :yin.k/envelope (encode (:envelope entry)))))\n   741\t\n   742\t    :install\n   743\t    (do (when-not (contains? (:installs vm) (:name entry))\n   744\t          (non-portable! :incomplete-install {:yin.k/name (:name entry)}))\n   745\t        {:yin.k/reason :install\n   746\t         :yin.k/name (:name entry)})\n   747\t\n   748\t    (undecodable! {:yin.k/reason (:reason entry)\n   749\t                   :yin.k/path [:yin.k/wait (:pc entry)]})))\n   750\t\n   897\t(defn- stack-registers-v2\n   898\t  [found encode vm payload]\n   899\t  (let [layout (mapv first (stack-payload-rows vm payload))\n   900\t        store! (fn [m]\n   901\t                 (when (some? m) (swap! found update :stores conj m))\n   902\t                 m)]\n   903\t    (swap! found update :segments into layout)\n   904\t    (cond-> {:yin.k/layout layout\n   905\t             :yin.k/image (:image payload)\n   906\t             :yin.k/pc (:pc payload)\n   907\t             :yin.k/frames (mapv #(mapv encode %) (:frames payload))\n   908\t             :yin.k/stack (mapv encode (:stack payload))\n   909\t             :yin.k/continuation\n   910\t             (mapv (fn [f]\n   911\t                     (when-not (every? #{:return-pc :frames :stack-base\n   912\t                                         :store-of}\n   913\t                                       (keys f))\n   914\t                       (non-portable! :inconsistent-state\n   915\t                                      {:yin.k/hint :frame}))\n   916\t                     (cond-> {:yin.k/return-pc (:return-pc f)\n   917\t                              :yin.k/frames (mapv #(mapv encode %)\n   918\t                                                  (:frames f))\n   919\t                              :yin.k/stack-base (:stack-base f)}\n   920\t                       (some? (:store-of f))\n   921\t                       (assoc :yin.k/store-of (store! (:store-of f)))))\n   922\t                   (:continuation payload))}\n   923\t      (some? (:store-of payload))\n   924\t      (assoc :yin.k/store-of (store! (:store-of payload))))))\n   925\t\n   926\t\n   927\t(defn- register-payload-rows\n   928\t  \"The prefix of `vm`'s offset table a register `payload` was captured\n   929\t   under: the shortest one whose lengths sum to the payload's code\n   930\t   space, reproduced by that prefix and by its hash.\"\n   931\t  [vm {:keys [segment] :as payload}]\n   932\t  (let [rows (vec (:images vm))\n   933\t        n (count (:instructions segment))\n   934\t        prefix (some (fn [i]\n   935\t                       (let [[_ off len] (nth rows (dec i))]\n   936\t                         (when (= n (+ off len)) (subvec rows 0 i))))\n   937\t                     (range 1 (inc (count rows))))]\n   938\t    (when (or (nil? prefix)\n   939\t              (nil? (register/layout-images segment prefix))\n   940\t              (not= (:hash payload) (rcode/register-hash segment)))\n   941\t      (non-portable! :inconsistent-state {:yin.k/hint :layout}))\n   942\t    prefix))\n   943\t\n   944\t\n   945\t(defn- register-registers-v2\n   946\t  [found encode vm payload]\n   947\t  (let [layout (mapv first (register-payload-rows vm payload))\n   948\t        store! (fn [m]\n   949\t                 (when (some? m) (swap! found update :stores conj m))\n   950\t                 m)\n   951\t        pairs (fn [regs] (mapv (fn [[r x]] [r (encode x)]) regs))\n   952\t        frames (fn [fs] (mapv #(mapv encode %) fs))]\n   953\t    (swap! found update :segments into layout)\n   954\t    (cond-> {:yin.k/layout layout\n   955\t             :yin.k/image (:image payload)\n   956\t             :yin.k/site-pc (:site-pc payload)\n   957\t             :yin.k/pc (:pc payload)\n   958\t             :yin.k/frames (frames (:frames payload))\n   959\t             :yin.k/regs (pairs (:regs payload))\n   960\t             :yin.k/live (:live payload)\n   961\t             :yin.k/continuation\n   962\t             (mapv (fn [f]\n   963\t                     (when-not (every? #{:site-pc :return-pc :frames :regs\n   964\t                                         :live :dest :store-of}\n   965\t                                       (keys f))\n   966\t                       (non-portable! :inconsistent-state\n   967\t                                      {:yin.k/hint :frame}))\n   968\t                     (cond-> {:yin.k/site-pc (:site-pc f)\n   969\t                              :yin.k/return-pc (:return-pc f)\n   970\t                              :yin.k/frames (frames (:frames f))\n   971\t                              :yin.k/regs (pairs (:regs f))\n   972\t                              :yin.k/live (:live f)\n   973\t                              :yin.k/dest (:dest f)}\n   974\t                       (some? (:store-of f))\n   975\t                       (assoc :yin.k/store-of (store! (:store-of f)))))\n   976\t                   (:continuation payload))\n   977\t             :yin.k/dest (:dest payload)\n   978\t             :yin.k/resume-mode (:resume-mode payload)}\n   979\t      (some? (:store-of payload))\n   980\t      (assoc :yin.k/store-of (store! (:store-of payload))))))\n","exit_code":0,"status":"completed"}}
