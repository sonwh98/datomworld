\t   :window (select-keys W (analysis/saved facts (inc pc) rd))\n    65\t   :k K :deliver {:deliver :rd :rd rd}})\n    66\t\n    67\t\n    68\t(defn- entry-builders\n    69\t  [payload]\n    70\t  {:stream/put (fn [_state _effect result]\n    71\t                 (assoc payload :reason :put :stream-id (:stream-id result)))\n    72\t   :stream/next (fn [_state _effect result]\n    73\t                  (assoc payload :reason :next :cursor-ref (:cursor-ref result)\n    74\t                         :stream-id (:stream-id result)))})\n    75\t\n    76\t\n    77\t(defn- act-builders\n    78\t  [seg pc E W K rd facts]\n    79\t  (entry-builders (act-payload seg pc E W K rd facts)))\n    80\t\n    81\t\n    82\t(defn- tail-builders\n    83\t  [seg pc K]\n    84\t  (entry-builders {:segment seg :site pc :k K :deliver {:deliver :return}}))\n    97\t(defn register-restore\n    98\t  \"Deliver a value to an activation or through its saved return frames.\n    99\t   FFI request phases and decoding are deferred to phase 4b stage 2.\"\n   100\t  ([base entry] (register-restore base entry (:value entry)))\n   101\t  ([base entry value]\n   102\t   (case (get-in entry [:deliver :deliver])\n   103\t     :rd (put-registers base (:segment entry) (:pc entry)\n   104\t                        (assoc (:window entry) (get-in entry [:deliver :rd]) value)\n   105\t                        (:env entry) (:k entry))\n   106\t     :return (if-let [frame (peek (:k entry))]\n   107\t               (put-registers base (:segment frame) (:pc frame)\n   108\t                              (:window (return-to frame value))\n   109\t                              (:env frame) (pop (:k entry)))\n   110\t               (assoc (put-registers base nil nil {}\n   111\t                                     (engine/without-store-of (:env base)) nil)\n   112\t                      :value value))\n   113\t     (throw (ex-info \"Entry carries no delivery record\" {:rule :deliver :entry entry})))))\n   114\t\n   115\t\n   116\t(defn- not-in-slice!\n   225\t                (if-let [[next-state value] (:continue r)]\n   226\t                  (recur next-state seg (inc pc) (assoc (:window next-state) rd value)\n   227\t                         (:env next-state) (or (:k next-state) []) remaining)\n   228\t                  (:stop r)))\n   229\t              :current-continuation\n   230\t              (let [rd (nth inst 1)\n   231\t                    payload (assoc (act-payload seg pc E W K rd (:analysis image)) :type :reified-continuation)]\n   232\t                (recur machine seg (inc pc) (assoc W rd (values/continuation (:owner machine) payload)) E K remaining))\n   233\t              :park (-> (put-registers machine seg pc W E K)\n   234\t                        (engine/park-continuation (act-payload seg pc E W K (nth inst 1) (:analysis image)))\n   235\t                        (assoc :control nil :k nil))\n   236\t              :resume (let [restored (engine/resume-continuation (put-registers machine seg pc W E K)\n   382\t  module/IModuleKernel\n   383\t  (gc-roots [machine]\n   384\t    {:kernel [(:control machine) (:k machine)]\n   385\t     :values [(:env machine) (:window machine) (:value machine)]})\n   386\t  (gc-children [_ _x] nil))\n   582\t\n   583\t(defn- held?\n   584\t  [x]\n   585\t  (and (map? x) (contains? x :yin.k/held)))\n   586\t\n   587\t\n   588\t(defn- unliftable-hold\n   589\t  \"The first thing `vm` holds that has no wire pending variant at any\n   590\t   version, as the data the refusal carries, or nil: a held observation\n   591\t   -- an `:observe` entry, or an entry or cursor cell carrying\n   592\t   `:yin.k/held` --, a reachable unminted cursor cell, a pending close,\n   593\t   or a `:link-request` entry whose response cursor is not installed.\n   594\t   Entering exporting refuses the same holds over the whole task (D8);\n  1450\t             ;; lift, not \"version 1\": version 2 selects it too, and the\n  1451\t             ;; version is dispatched separately, by `v2?` and the body's\n  1452\t             ;; validated structural role (v2 amendment, section 10).\n  1453\t             jing-codec? (boolean (or (some? header) (::jing-codec opts) v2?))\n  1454\t             keyed (or (:serve-keyed opts) (fn [_ h] (serve! h)))\n  1455\t             ;; grounded: ClojureDart compiles a many-key assoc onto nil\n  1456\t             ;; as a conj, whose answer is a list no dissoc accepts\n  1457\t             opts (assoc (or opts {})\n  1458\t                         :path (or (:path opts) [])\n  1459\t                         ::jing-codec jing-codec?\n  1460\t                         ::enrolled (or (:yin.k/enrolled header)\n   127\t(defn load-ast\n   128\t  \"`ast` loaded into `machine` of `engine`.\"\n   129\t  [engine machine ast]\n   130\t  (case engine\n   131\t    :semantic (semantic/load-vector machine (semantic-vector ast)\n   132\t                                    vm/semantic-contract)\n   133\t    :stack (stack/load-image machine\n   134\t                             (:image (dl/adapt (vm/ast->datoms ast)))\n   135\t                             vm/stack-contract)\n   136\t    :register (register/load-image\n   137\t                machine\n   138\t                (:image (rc/adapt (vm/ast->datoms ast)))\n   139\t                vm/register-contract)\n   140\t    :walker (walker/vm-load-rows machine (vm/ast->semantic-bytecode ast)\n   141\t                                 vm/ast-contract)))\n   142\t\n   453\t(defn parked-installer\n   454\t  \"A real machine parked at `:install` with a live blocked child:\n   455\t   answers [parked child-stream].\"\n   456\t  [engine]\n   457\t  (let [request (ring 64)\n   458\t        response (ring 64)\n   459\t        m0 (vm/run (load-ast engine (linking-machine engine request response)\n   460\t                             (then (require-program 'host.mod)\n   531\t(defn stream-blind\n   532\t  \"`body` with every served stream identity and channel replaced by a\n   533\t   placeholder: two lifts over different served tables compare by the\n   534\t   census alone.\"\n   535\t  [body]\n   536\t  (walk/postwalk (fn [x]\n   537\t                   (if (and (map? x) (contains? x :dao.stream/identity))\n   538\t                     (assoc x :dao.stream/identity :served\n   539\t                            :dao.stream/channel :served)\n   540\t                     x))\n   541\t                 body))\n   542\t\n   543\t\n   544\t(defn run-beside\n   395\t(defprotocol IModuleKernel\n   396\t  \"What a kernel supplies the install child and the `linked` transition\n   397\t   (yin.vm.linker.md section 7.3). Every method is a pure function of a\n   398\t   VM value; the engine owns the phases, the kernel owns its coordinates.\"\n   399\t\n   400\t  (link-format\n   401\t    [vm]\n   402\t    \"`{:format kw :contract s}`: the format this kernel links, and the\n   403\t     execution contract it runs.\")\n   404\t\n   405\t  (spawn-module\n   406\t    [vm image opts]\n   407\t    \"A fresh VM of this backend with the verified `image` loaded by the\n   408\t     ordinary loader, holding nothing of `vm`'s state but its composition\n   409\t     values (primitives, stream constructor, link pair). `opts` carries\n   410\t     `:modules` (the child's module view), `:origin`, and `:ancestry`.\")\n   411\t\n   412\t  (image-identity\n   413\t    [vm image]\n   414\t    \"The identity this kernel's code space names `image` by: H, R, the\n   415\t     vector's address, or the tree's root row id.\")\n   416\t\n   417\t  (image-holds?\nrecomputes the same function on every receiving host.\n\n**Checked, not assumed** (§6.2 item 4). For every boundary pc `p`, let\nthe **virtual live-out** be `⋃ { L(s) : s ∈ (analysis/successors v p) }`\nover the **actual** successors of §8.1 (`analysis.cljc:15-28`: none for\na tail `:call`, `:return`, `:halt`, `:resume`; the target for `:jump`;\nboth for `:branch-false`; `p+1` otherwise). The filled `live` must equal\nthe sorted physical image of `(virtual-live-out(p) − {rd})`. For a\nnon-tail boundary that is `L(p+1) − {rd}`; for a **tail `:call`** the\nsuccessor set is empty, so the virtual live-out is `{}` and `live` is\n`[]`, which is also what `body-liveness` returns and what\n`live-tail-rule` requires (`debruijn_register_code.cljc:621-628`).\n`L(p+1)` itself is **not** the right comparison for a tail call: in\n### 3.2 The walk\n\n**DECIDED** (frozen §8.3 steps 2 and 4, with the adapter step 3 removed:\n§9.1 F9). One emitter over the resolved vector's parse trees\n(`(:bodies (resolve v))`, each with `:expr`). Labels are symbolic while\nemitting and resolved to pcs in a second pass; bodies are emitted out of\nline, main first, then a FIFO queue that every emitted `:closure`\nappends to and that bodies discovered inside bodies join at the back\n(frozen §3.3 item 1; this is the order A itself has, so the stack image's\nbody order equals A's and R's, while its pcs are its own).\n\n```\nemit(node):\n  [:const rd v]                      → [:const v]\n  [:load-bound rd d q]               → [:load-bound d q]\n  [:load-free rd n]                  → [:load-free n]\n  [:closure rd arity body-pc]        → L := fresh label; enqueue (L, body-at body-pc); [:closure arity L]\n  [:call rd f args tail?]            → emit(f-child); [:push]; for each arg child: emit(child); [:push];\n                                       [:call (count args) tail?]\n  {:op :if …} with children [c t e]  → emit(c); [:branch-false Lelse]; emit(t); [:jump Lend];\n                                       Lelse: emit(e); Lend:\n  [:define rd name rs]               → emit(rs-child); [:define name]\n  [:gensym rd p]                     → [:gensym p]        ; and likewise :store-get k, :store-put k x,\n                                                           ; :stream-make b, :current-continuation, :park\n  [:stream-put rd s x]               → emit(s); [:push]; emit(x); [:stream-put]\n  [:stream-cursor rd s] / :stream-next / :stream-close\n                                     → emit(s); [:stream-cursor] / [:stream-next] / [:stream-close]\n  [:ffi-call rd op args]             → for each arg child: emit(child); [:push]; [:ffi-call op (count args)]\n  [:resume id x]                     → emit(x); [:resume id]\nbody(main): emit(expr); [:halt]      body(lambda): emit(expr); [:return]\n```\n\nChildren are the parse node's `:children` in order, which is `code/uses`\norder, which is §3.1's evaluation order. The walk is defined by the\n   680\t\n   681\t      :load-free\n   682\t      (let [name (nth inst 1)\n   683\t            value (engine/resolve-var free-env\n   684\t                                      (engine/active-store vm store-of)\n   685\t                                      primitives modules name)]\n   686\t        (assoc vm :pc (inc pc) :stack (conj stack value)))\n   687\t\n   688\t      ;; This positional dimension has no `:macro?` flag on `:closure` (it\n   689\t      ;; is named-datom-only, section 4): the instruction carries only\n   690\t      ;; arity and a body pc, so there is nothing here to ignore.\n   691\t      :closure\n   692\t      (let [arity (nth inst 1), body-pc (nth inst 2)]\n   693\t        (assoc vm\n   694\t               :pc (inc pc)\n   695\t               :stack (conj stack\n   696\t                            (values/closure\n   697\t                              (:owner vm)\n   698\t                              (cond-> {:type :closure, :arity arity,\n   699\t                                       :body-pc body-pc, :frames frames}\n   700\t                                store-of (assoc :store-of store-of))))))\n   701\t\n   702\t      ;; The named VM (semantic.cljc) keeps a separate `val` accumulator\n   703\t      ;; distinct from its operand stack `St`, so `:push` there commits\n   704\t      ;; `val` onto `St` (St <- St ++ [val]). This machine has no such\n   705\t      ;; split: every value-producing case already conjes its result\n   706\t      ;; straight onto `:stack`. By the time control reaches a `:push`,\n   707\t      ;; the value it would push is already there -- so here it is a no-op\n120:   registry can give it a meaning. Every executing variable lookup of\n814:                      (or (:primitive-canonical-names vm) {})\n829:   handle's descriptor and logical identity, never the handle. A handle\n843:  \"The logical cursor cell (UCF 7.5.3) the cursor resource `id` of `vm`\n895:                (non-portable! :non-canonicalizable\n908:                (non-portable! :non-canonicalizable {:yin.k/hint (:type x)})\n1056:   halt, mutations included -- and the logical cursor cells the encoded\n1212:        receiver {:free-env (or (:free-env state) {}),\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/yin.vm.universal-continuation-format.md | sed -n '525,630p'; nl -ba docs/design/yin.vm.semantic-register-vm.continuation.md | sed -n '685,731p;852,879p'; nl -ba docs/design/yin.vm.ucf-transport-tuples.md | sed -n '33,50p;386,427p'; nl -ba src/cljc/yin/vm/semantic_register/linearize.cljc | sed -n '35,83p'; nl -ba test/yin/vm/ucf/safepoint_harness_test.cljc | sed -n '368,402p;591,604p;675,693p'; nl -ba test/yin/vm/ucf/lift_support.cljc | sed -n '307,316p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/yin.vm.universal-continuation-format.md | sed -n '525,630p'; nl -ba docs/design/yin.vm.semantic-register-vm.continuation.md | sed -n '685,731p;852,879p'; nl -ba docs/design/yin.vm.ucf-transport-tuples.md | sed -n '33,50p;386,427p'; nl -ba src/cljc/yin/vm/semantic_register/linearize.cljc | sed -n '35,83p'; nl -ba test/yin/vm/ucf/safepoint_harness_test.cljc | sed -n '368,402p;591,604p;675,693p'; nl -ba test/yin/vm/ucf/lift_support.cljc | sed -n '307,316p'\"","aggregated_output":"   525\treference path: the direct path is primary and is the reference; the\n   526\tprojection path is derived from it. Both invoke the same validator, and\n   527\tnothing may depend on which path a conforming engine takes.\n   528\t\n   529\tOn lowering, the resumer resolves each address in this order and stops at the\n   530\tfirst hit:\n   531\t\n   532\t1. its own code index for the value's stamp, keyed by address, each entry\n   533\t   verified once by hashing and grammar-validating its vector;\n   534\t2. `:yin.k/carried` in the value itself, verified the same way before load;\n   535\t3. a `dao.jing` read by address, verified the same way.\n   536\t\n   537\tVerification is two checks, always both: the vector must hash to the address\n   538\tit claims (`:yin.k/hash-mismatch` otherwise), and it must satisfy the stamp's\n   539\ttuple grammar — mnemonic set, arity, operand kinds, saturations in place\n   540\t(`:yin.k/undecodable` naming the pc otherwise; a correct hash is not\n   541\tstructural validation, the same rule the value decoder applies, §7.5.1). A\n   542\tmiss is `:yin.k/unsatisfied` naming the address (§7.6.5); nothing from a\n   543\tvalue that fails either check is loaded.\n   544\t\n   545\t**The address index is additive; local-id immutability stands.** The §3.1\n   546\trule — an id already holding a different image is a load error, an identical\n   547\treload accepted — is unchanged by UCF, and the first draft's claim that a\n   548\thash check *replaces* it was wrong: two different, correctly hashed segments\n   549\tcan claim the same local id, and redirecting an existing id would silently\n   550\trewire every frame that names it. A lowering engine therefore keeps two\n   551\tmaps: `:code {local-id image}` under the §3.1 rule, and a separate\n   552\t`{stamp {address image}}` index with an `address → local-id` alias column.\n   553\tSegments loaded *by address* may mint fresh local ids; they may never reuse a\n   554\tlive one, and the alias column is checked so one address never lands under\n   555\ttwo local ids in one VM.\n   556\t\n   557\t**The continuation's own identity and the occurrence.** `:yin.k/id` is the\n   558\t`dao.jing` segment address of the UCF map with `:yin.k/id` removed — and by\n   559\tthe same no-alias argument, the payload published under `:yin.k/id` is the\n   560\t**id-less body**; a reader reconstructs the envelope with\n   561\t`(assoc body :yin.k/id (dao.jing/segment-key body))`. Equal continuations\n   562\tconverge; an idempotent re-publication of one encoding is a no-op. But\n   563\tencodings legitimately differ (§7.5.3), so `:yin.k/id` is *not* what custody,\n   564\tchains, or grants name. They name `:yin.k/occurrence` — the checkpoint\n   565\toccurrence id, minted exactly once, when a park is first exported, unique\n   566\tunder the emitter's attribution, and carried unchanged by every authorized\n   567\tsnapshot variant and every retry of the same park (§7.7.2). A re-emission\n   568\tafter a failed publication reuses the occurrence; it never mints a second\n   569\trunnable checkpoint.\n   570\t\n   571\t## §7.4 Safepoints — where a canonical configuration exists (blocker 1)\n   572\t\n   573\t### 7.4.1 Only safepoints lift, and the table is the machine's\n   574\t\n   575\tThe linear machine's registers are canonical only *between* instructions.\n   576\tInside a `:call` that has popped its operands but not yet pushed a frame, or\n   577\tinside a superinstruction the loader fused (§6.4), no ⟨C, E, S, K⟩ exists\n   578\tthat both describes the state and is expressible in the §2.4 vocabulary.\n   579\tUCF resolves this by rule rather than by metadata: **a continuation may be\n   580\tlifted only at a safepoint**, and a safepoint is a transition of the\n   581\treference machine at which the machine parks. The first draft's table\n   582\tpresented itself as complete while omitting the parks that arrive through\n   583\t`:call` — a called host function that returns an effect blocks exactly as an\n   584\tinstruction effect does, through `apply-call` → `handle-effect` →\n   585\t`call-park-entries`, and both ordinary and tail calls reach that path\n   586\t(`yin.vm.semantic`, `apply-call`). The complete set:\n   587\t\n   588\t| Safepoint kind | Raised by | Canonical resume pc | Stack in frame (St) | Accumulator on resume |\n   589\t|---|---|---|---|---|\n   590\t| explicit park | `:park` | `pc+1` | St at park | the resume value |\n   591\t| blocked read | `:stream-next` → `blocked` | `pc+1` | St (cursor ref was in `val`) | the read value; `nil` on `end`, `:dao.stream/gap` on gap |\n   592\t| blocked write | `:stream-put` → `full` | `pc+1` | St minus the popped target ref | the written value, on retry `ok` |\n   593\t| FFI call, sent | `:ffi-call` → `:dao.stream/ok` | `pc+1` | St minus the popped args | the correlated response's `ok` value; its `error` raises |\n   594\t| FFI call, retained | `:ffi-call` → `:dao.stream/full` | `pc+1` | St minus the popped args | as sent, once the request is appended and the response correlates |\n   595\t| effectful call | `:call`/`:tailcall` whose operator yields a blocking effect (`require`, stream-module functions, effect handlers) | `pc+1` | St minus the popped operator and args | the effect's resume value, per its kind as above |\n   596\t| halt | `:halt`, `:return` with empty K | — | — | not resumable; a `:yin.k/type :yin.k/result` travels instead |\n   597\t\n   598\tTwo corrections to the first draft's table stand beside the addition.\n   599\t`:current-continuation` is **not** a safepoint: it does not park — it\n   600\treifies `val ← {seg, pc+1, E, St, K}` and continues, so a reified\n   601\tcontinuation is a *value class* of the encoding (§7.5.1), never a lift\n   602\tpoint. And `pc+1` as the resume pc is verified sound for every row above:\n   603\t§2.6 requires the final pc to be a terminator, so every listed instruction\n   604\thas a successor in its own segment.\n   605\t\n   606\tThe `:yin.k/frame` is exactly the wait-entry shape of `yin.vm.semantic.md`\n   607\t§3.5, with segments replaced by addresses and values by their portable\n   608\tencodings (§7.5):\n   609\t\n   610\t```clojure\n   611\t:yin.k/frame\n   612\t{:yin.k/segment  :segment/sha256-3f1a…\n   613\t :yin.k/pc       5                         ; the resume pc, already pc+1\n   614\t :yin.k/reason   :next                     ; :park | :next | :put | :ffi\n   615\t                                          ; | :ffi-request | :call-effect\n   616\t                                          ; | :link-request | :link-response\n   617\t                                          ; | :install\n   618\t :yin.k/val      nil                       ; accumulator; nil except where §7.4.3 pre-fills it\n   619\t :yin.k/stack    [ … ]                     ; St per the table above, encoded\n   620\t :yin.k/env      { sym → encoded value }   ; E\n   621\t :yin.k/k        [ {:yin.k/frame-type :return                    ; or :eval-call / :request-sent,\n   622\t                    :yin.k/segment :segment/sha256-…             ; which also carry :yin.k/call-id\n   623\t                    :yin.k/pc 5 :yin.k/env {…} :yin.k/stack-base 0} … ]   ; K, innermost last\n   624\t :yin.k/pending  {…}}                      ; the wait it was in, §7.4.3 — one variant per reason\n   625\t```\n   626\t\n   627\t**Linker safepoints (M4).** Every block marked (linker M4) is specified by\n   628\t`yin.vm.linker.md`; the private resources table, sealed references and\n   629\tinstall child were implemented in M4 (S3 ships r8-r11, the install child\n   630\tand link-module; S4 ships manifests). The running VM implements the\n   685\t4. **Cross-engine canonical equality** (new, the law ruling 6 makes\n   686\t   possible): for one program at one safepoint, the canonical row sets\n   687\t   lifted from the three lanes are **equal by root id** after\n   688\t   stream-blinding and under controlled composition identities\n   689\t   (occurrence, origin, resource descriptors fixed by the harness).\n   690\t   This is the strongest statement of \"one truth, many interpretations\"\n   691\t   the phase can test: the same `act`, the same window, the same `K`,\n   692\t   the same `E`, whatever kernel held it.\n   693\t5. **Cross-engine lowering.** a row set lifted on one lane lowers on\n   694\t   each of the other two and continues to the reference result (the\n   695\t   6 ordered pairs).\n   696\t6. **Validator agreement.** every frame of every lifted row set passes\n   697\t   `frame/defect` in its context; every tampered row of §5.2 is refused\n   698\t   with the named kind; the validator's verdict is identical whichever\n   699\t   lane produced the frame.\n   700\t\n   701\t### 5.5 Observables and normalisation\n   702\t\n   703\t**DECIDED** (phase-5 §6.1.2 `native-normalize`, reused). Results and\n   704\teffect traces are compared under one normalisation applied to every\n   705\tside: host-typed values unwrapped; a closure (host type or `{:type\n   706\t:closure}` map) → `:closure` (a canonical closure carries `params` and a\n   707\tnamed `env`, a de Bruijn one arity and frames; only closure-ness is\n   708\tcommon to a value that crossed between them); a continuation →\n   709\t`:continuation`; stream and cursor refs → `{:type t :id id}`; host fns →\n   710\t`:host-fn`; collections recursively. Equality of **frames** (laws 2 and\n   711\t4) is by row-set root id, which is exact and needs no normalisation\n   712\tbeyond stream-blinding.\n   713\t\n   714\t### 5.6 Static checks the harness runs once per corpus segment\n   715\t\n   716\t1. `frame/defect` on every frame the reference lane mints: nil.\n   717\t2. For every parking pc `p` of `v`: `(analysis/saved a (inc p) rd)` has\n   718\t   no member `≥ k(body(p))` and does not contain `rd`.\n   719\t3. Register layout: `phys→virt(p, s)` is single-valued at every pc `p`\n   720\t   and every physical slot `s` of `L(p) ∪ def(p−1)`'s image; the live\n   721\t   operand of every boundary instruction of `R` equals the sorted\n   722\t   physical image of `saved(p+1, rd)`.\n   723\t4. Stack layout: the k-th non-push instruction of `H` has the mnemonic\n   724\t   family of `v[k]` (`:var` ↔ `:load-bound`/`:load-free`, `:closure` ↔\n   725\t   `:closure`, else equal mnemonics) for every `k`; counts agree.\n   726\t5. Stack layout: `(set (stack-layout p)) = (analysis/saved a (inc p) rd)`\n   727\t   for every parking pc `p`.\n   728\t6. `E` reconstruction: at every safepoint reached, the layout's `E`\n   729\t   equals the reference lane's `E` (as maps, values normalised).\n   730\t7. Closure reconstruction: canonical ↔ positional closures round-trip on\n   731\t   the `\"closure value\"` and `\"higher order\"` B0 rows and on\n   852\tit lifts; FFI and link rows wait for 4b stage 2 and are 6b's.\n   853\t**Touches nothing of 4b or 5.**\n   854\t\n   855\t**Acceptance (6a).**\n   856\t\n   857\t1. `frame-test/rules-are-independent-of-engine`: `frame/defect` takes a\n   858\t   keyed frame and a code map only; its namespace requires no kernel\n   859\t   namespace (asserted by inspecting the `ns` form's requires in the\n   860\t   test, a string check over the source file read as a resource on the\n   861\t   JVM lane, `#?(:cljd nil :clj …)`).\n   862\t2. `frame-test/every-reference-frame-validates`: for every program of\n   863\t   the phase-5 corpus `C` that parks on 4b stage 1 (the blocked-read,\n   864\t   blocked-write, park and capture rows over the four segments of\n   865\t   §5.2), every `act`, `tail`, return frame, parked record and reified\n   866\t   value the register evaluator mints passes `defect` in its context.\n   867\t3. `frame-test/each-rule-refuses-its-tamper`: for each of rules 1-14 one\n   868\t   tampered frame built from a valid one, refused with that rule's kind\n   869\t   and a path naming the slot; fourteen rows, each named by kind.\n   870\t4. `frame-test/nil-valued-register-is-a-member`: a program whose live\n   871\t   register holds nil at the safepoint (`(f (stream-next c) nil-reg)`\n   872\t   with `[:const r nil]` evaluated before the read) validates with the\n   873\t   key present; the same frame with the key filtered out is\n   874\t   `:window-missing`.\n   875\t5. `frame-test/worked-example-saved`: on `:worked-example`'s vector, a\n   876\t   frame at pc 4 with window `{1 <f>}` and `rd 2` validates; `{1 <f> 2 x}`\n   877\t   is `:window-self`; `{}` is `:window-missing`; `{1 <f> 3 x}` is\n   878\t   `:window-extra` (`saved(4, 2) = {1}`, `analysis_test.cljc:131-139`).\n   879\t6. `rows-test/bijection`: `frame->rows ∘ rows->frame` and the converse\n    33\t   typed position, sharing is Merkle, and a program's data is wrapped\n    34\t   where it can be confused with a reference. What does not collapse is\n    35\t   the per-entity decision between content and identity, which this\n    36\t   carrier makes a property of the row kind and then commits to the root\n    37\t   through a census.\n    38\t3. *Tuples are the transport form only.* They exist between a lift and a\n    39\t   lower. At rest they are rows like any other and queryable by the\n    40\t   ordinary interpreter. Nothing executes them; the destination lowers\n    41\t   them into its native representation.\n    42\t\n    43\tThis proposal chooses positional rows: a row kind fixes a slot list, one\n    44\ttable serves encoder and decoder, and a row's Merkle id commits to its\n    45\tchildren inline, as code rows already do. EAV is expressive enough and\n    46\tnothing in the invariants rules it out; positional rows are chosen for\n    47\tcompactness, closedness, and consistency with the existing row\n    48\tconventions, not because EAV was rejected by review.\n    49\t\n    50\t## 2. Positioning: body version 3, same profiles\n   386\t   contract         ; the profile map, plain  (amendment §1)\n   387\t   kind             ; :blocked | :parked | :halted\n   388\t   role             ; :root | :child\n   389\t   id-counter       ; N                       (UCF §7.6.3)\n   390\t   store-cref\n   391\t   module-stores    ; crefs sorted by M\n   392\t   parked-cref      ; :parked-table\n   393\t   cells-cref       ; :cells census\n   394\t   requires         ; plain: UCF §7.6.1's map, unchanged\n   395\t   code             ; plain: {A code-payload …}, each payload verified to hash to its key (§7.2.1)\n   396\t   installs         ; crefs to :install rows, sorted by module name\n   397\t   frames           ; crefs to :wait rows, IN WAIT ORDER   (:blocked, :parked)\n   398\t   parked-id        ; P or nil                              (:parked only)\n   399\t   result           ; V or nil                              (:halted only)\n   400\t   custody]         ; plain, see below\n   401\t```\n   402\t\n   403\tKind rules are §7.2.1's: `:blocked` has nonempty frames and neither\n   404\tparked-id nor result; `:parked` has frames (possibly empty), a parked-id\n   405\tnaming a key of the parked table, no result; `:halted` has a result and\n   406\tneither frames nor parked-id. Frames restore in carried order and are\n   407\tnever collapsed to one; a task with an empty ready queue may hold several\n   408\tordered waits.\n   409\t\n   410\t`custody` is the custody arm carried as plain data, under the rules of\n   411\t§7.2.1 and amendment §3, by role, kind and policy:\n   412\t\n   413\t| role | kind | policy | `custody` |\n   414\t|---|---|---|---|\n   415\t| root | blocked / parked | exclusive | `{:yin.k/policy :yin.k/exclusive :yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq}` plus `:yin.k/origin` on every successor, absent on a first export |\n   416\t| root | blocked / parked | fork | `{:yin.k/policy :yin.k/fork}` |\n   417\t| root | halted | exclusive | `{:yin.k/origin …}` only: a result is not a lease subject |\n   418\t| root | halted | fork | nil: a fork halt has no custody data and a first fork halt has no origin to carry |\n   419\t| child | any | — | nil; validated with its root's occurrence, origin and counter passed down |\n   420\t\n   421\tThe explicit fork policy spelling projects onto the amendment's\n   422\tempty-header fork representation: a version-3 fork root is admitted\n   423\texactly as a version-0 body is, proposes nothing, and is never upgraded\n   424\tto custody; an exclusive-only receiver refuses it as\n   425\t`:yin.k/profile-mismatch`. Admission semantics are the governing ones\n   426\tunchanged; only the spelling is new. No body carries an epoch.\n   427\t\n    35\t   slot 2), from `vm/semantic-bytecode-grammar`. Provenance path steps\n    36\t   are these positions in both lanes.\"\n    37\t  (reduce-kv (fn [m tag slots]\n    38\t               (reduce (fn [m i]\n    39\t                         (assoc m [tag (first (nth slots i))] (+ 2 i)))\n    40\t                       m\n    41\t                       (range (count slots))))\n    42\t             {}\n    43\t             vm/semantic-bytecode-grammar))\n    44\t\n    45\t\n    46\t(def ^:private defaults\n    47\t  \"§2.4 / UCF §7.3.2 saturation, applied before lowering. The row lane's\n    48\t   rows are already saturated; the datom lane's facts may omit these.\"\n    49\t  {[:vm/gensym :prefix] \"id\",\n    50\t   [:stream/make :buffer] vm/default-stream-capacity,\n    51\t   [:application :operands] [],\n    52\t   [:dao.stream.apply/call :operands] []})\n    53\t\n    54\t\n    55\t(defn- flatten-tree\n    56\t  \"The §3.3 walk from `root` over `reader`, `{:tag (fn [id]) :slot (fn\n    57\t   [id field]) :check (fn [id])}`. `:check` runs on entering each lowered\n    58\t   node and throws to refuse it. Returns `{:code [tuple …] :sources [[id\n    59\t   path] …]}`, one source per pc, labels resolved to pcs.\"\n    60\t  [{:keys [tag slot check]} root]\n    61\t  (let [code (volatile! [])\n    62\t        sources (volatile! [])\n    63\t        labels (volatile! {})\n    64\t        bodies (volatile! [])\n    65\t        label-count (volatile! 0)\n    66\t        regs (volatile! 0)\n    67\t        fresh-label! (fn [] (vswap! label-count inc))\n    68\t        mark! (fn [l] (vswap! labels assoc l (count @code)))\n    69\t        emit! (fn [id path t]\n    70\t                (vswap! sources conj [id path])\n    71\t                (vswap! code conj t))\n    72\t        field (fn [id f]\n    73\t                (let [x (slot id f)]\n    74\t                  (if (nil? x) (get defaults [(tag id) f]) x)))\n    75\t        pos (fn [id f] (get slot-position [(tag id) f]))]\n    76\t    (letfn\n    77\t      [(definition?\n    78\t         [id]\n    79\t         (let [op (slot id :operator)]\n    80\t           (and (= :variable (tag op))\n    81\t                (= vm/definition-operator (slot op :name)))))\n    82\t       (expr\n    83\t         [id path]\n   368\t(defn- reference\n   369\t  [world]\n   370\t  (let [done (satisfy world (:machine world) #(s/drive-local % 6))]\n   371\t    (when-let [f (:finish world)] (f))\n   372\t    {:halted (vm/halted? done), :value (vm/value done), :trace @(:trace world)}))\n   373\t\n   374\t\n   375\t(defn- handed-off\n   376\t  \"Lift the row's machine, lower it into a fresh receiver, relift that\n   377\t   receiver at once, then satisfy the wait through the source's streams.\n   378\t   The mirror is stepped once more after the run: a lowered writer's\n   379\t   append reaches the source only through the mirror (see D4).\"\n   380\t  [engine version world]\n   381\t  (let [t (s/toy)\n   382\t        peer (s/served-peer t)\n   383\t        surfaces (or (:surfaces world) #{:reader})\n   384\t        export (lift (:machine world) version t peer surfaces)\n   385\t        receiver ((or (:receiver world) (constantly nil)))\n   386\t        attach! (s/attacher t)\n   387\t        r (when (= :ok (:status export))\n   388\t            (handoff/resume-task\n   389\t              (s/new-machine engine (merge {:attach-stream attach!}\n   390\t                                           (:opts receiver)))\n   391\t              (:bytes export) attach! {:address (:address export)}))\n   392\t        recv (:vm r)\n   393\t        t2 (s/toy)\n   394\t        relift (when recv (lift recv version t2 (s/served-peer t2) surfaces))\n   395\t        done (when recv (satisfy world recv #(drive-peers % [peer] 6)))\n   396\t        _ (s/serve-mirror! peer)]\n   397\t    (when-let [f (:finish world)] (f))\n   398\t    (when-let [f (:finish receiver)] (f))\n   399\t    {:export export, :lower r, :recv recv, :relift relift,\n   400\t     :halted (some-> done vm/halted?), :value (some-> done vm/value),\n   401\t     :trace @(:trace world)}))\n   402\t\n   591\t(deftest a-nonempty-ready-queue-is-not-quiescent\n   592\t  (doseq [[engine version] lanes]\n   593\t    (testing (str (name engine) \" v\" version)\n   594\t      (let [[parked src] (s/parked-reader engine)\n   595\t            _ (stream/append! src \"B\")\n   596\t            woken (engine/check-wait-set parked)\n   597\t            t (s/toy)\n   598\t            [serve! n] (counting-server t (s/served-peer t) #{:reader})\n   599\t            r (handoff/export-task woken serve! (when (= 2 version) {:version 2}))]\n   600\t        (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n   601\t        (is (= :yin.k/not-quiescent (:yin.k/status r)) (pr-str r))\n   602\t        (is (not (contains? r :bytes)) \"nothing is published\")\n   603\t        (is (zero? @n) \"no stream was served\")))))\n   604\t\n   675\t(deftest a-held-immediate-refuses-export\n   676\t  (doseq [[engine version] lanes]\n   677\t    (testing (str (name engine) \" v\" version)\n   678\t      (let [m0 (s/load-ast engine (s/new-machine engine {:modules stream-modules})\n   679\t                           (s/app (s/v 'stream/poll!) (s/v 'c)))\n   680\t            [sref m1] (engine/attach-resource m0 (s/ring 8))\n   681\t            [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n   682\t            held (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))\n   683\t            t (s/toy)\n   684\t            [serve! n] (counting-server t (s/served-peer t) #{:reader})\n   685\t            r (handoff/export-task held serve! (when (= 2 version) {:version 2}))]\n   686\t        (is (= [:observe] (mapv :reason (:wait-set held)))\n   687\t            \"the gated poll is held as the D4 :observe entry\")\n   688\t        (is (= :yin.k/non-portable (:yin.k/status r)) (pr-str r))\n   689\t        (is (= :reason-mismatch (:yin.k/kind r)))\n   690\t        (is (= :observe (:yin.k/hold r)))\n   691\t        (is (not (contains? r :bytes)))\n   692\t        (is (zero? @n) \"refused before any stream was served\")))))\n   693\t\n   307\t    (vm/run m0)))\n   308\t\n   309\t\n   310\t(defn parked-module-store-cursors\n   311\t  \"A real machine parked at an explicit park whose module store for\n   312\t   'host.mod holds two cursor references nothing else reaches, named by\n   313\t   a module closure in the task store -- the shape a lowered module\n   314\t   closure has, its environment naming the module whose store it runs\n   315\t   against -- so the module-store snapshot's walk is the first place\n   316\t   either cell is minted.\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"The two stack examples and the register saved-window example check out. I found concrete gaps in the stack K slices, register return destinations, tail-state reconstruction, and free-environment recovery. The amendments also leave several contradictory clauses in the carrier draft; I’ll identify those precisely in the findings."}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/yin.vm.universal-continuation-format.md | sed -n '658,729p'; nl -ba docs/design/yin.vm.semantic-register-vm.continuation.md | sed -n '326,380p'; nl -ba src/cljc/yin/vm/debruijn_register_effects.cljc | sed -n '1,45p'; rg -n 'defn continuation-payload|return-result|live' src/cljc/yin/vm/debruijn_register_effects.cljc | head -22; rg -n 'tail-call-operand|call 2.*true|tail' docs/design/yin.vm.semantic-register-vm.derivations.md | tail -14; git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/yin.vm.universal-continuation-format.md | sed -n '658,729p'; nl -ba docs/design/yin.vm.semantic-register-vm.continuation.md | sed -n '326,380p'; nl -ba src/cljc/yin/vm/debruijn_register_effects.cljc | sed -n '1,45p'; rg -n 'defn continuation-payload|return-result|live' src/cljc/yin/vm/debruijn_register_effects.cljc | head -22; rg -n 'tail-call-operand|call 2.*true|tail' docs/design/yin.vm.semantic-register-vm.derivations.md | tail -14; git status --short\"","aggregated_output":"   658\t\n   659\tThe pending variants of the three reasons are in section 7.4.3.\n   660\t\n   661\t**Quiescence.** The migration unit is one task: the whole blocked machine\n   662\t(§7.6.3). Lifting additionally requires the machine's ready-queue to be\n   663\tempty — a machine with runnable work queued is mid-scheduling, its next\n   664\tconfiguration is not the parked one, and lift answers `:yin.k/not-quiescent`.\n   665\t\n   666\t### 7.4.2 Safepoint maps for foreign engines: static facts only\n   667\t\n   668\tThe reference machine needs no metadata because its registers *are* the\n   669\tcanonical configuration. A foreign engine — a register allocator over the\n   670\timage, a WebAssembly lowering, a JIT — keeps its state in physical locations\n   671\tof its own choosing, and the first draft promised it reconstruction data\n   672\tthat is not a function of the code: absolute stack depth and environment\n   673\tkey sets at a pc depend on the *activation* — a closure enters with the\n   674\tcaller's residual operand stack and an environment formed from its captured\n   675\tenvironment plus arguments (`apply-call`), and §2.6 enforces no equal stack\n   676\theights at joins, so the same pc is legitimately reached at many depths.\n   677\tNone of that is derivable, and none of it needs to be: **the frame carries\n   678\tit.** E, St, and every K frame's `:stack-base` and env travel in the value;\n   679\ta foreign engine lowers the canonical frame directly.\n   680\t\n   681\tWhat *is* a function of the canonical vector alone, and what such an engine\n   682\tmust publish — **per segment and per engine profile**, derived from the\n   683\tcanonical stream at its own load time — is the static half:\n   684\t\n   685\t```clojure\n   686\t[[sp :yin.safepoint/segment      :segment/sha256-3f1a…]  ; the code, by address\n   687\t [sp :yin.safepoint/engine       :wasm32/v1]             ; the engine profile that produced this layout\n   688\t [sp :yin.safepoint/pc           5]                      ; canonical resume pc\n   689\t [sp :yin.safepoint/stack-effect -1]                     ; Δ|St| across the parking instruction (static)\n   690\t [sp :yin.safepoint/lexically-required [x conn]]         ; names this pc can read from E (static)\n   691\t [sp :yin.safepoint/layout       {…}]]                   ; engine-owned: physical slot → canonical slot\n   692\t```\n   693\t\n   694\tRules:\n   695\t\n   696\t- `stack-effect` and `lexically-required` are **derived from the canonical\n   697\t  vector alone**, by the same static walk the linearizer performs (§5.3).\n   698\t  They are identical for every engine and checkable against the reference\n   699\t  machine by a conformance test that runs the segment to each safepoint and\n   700\t  compares the observed deltas and E-reads. Absolute depth, activation\n   701\t  bases, captured environments, and physical layouts are **not** claimed,\n   702\t  not derived, and not in this table; they are the frame's business.\n   703\t- `:yin.safepoint/layout` is opaque to the protocol. It is a memo the engine\n   704\t  keeps so that its `lift` is a table lookup. It never travels in a UCF\n   705\t  value; a resumer that is a different engine has its own.\n   706\t- `lift(engine-state, layout) → canonical frame` and\n   707\t  `lower(canonical frame, layout) → engine-state` are total on safepoints and\n   708\t  undefined elsewhere. The conformance obligation is `lift ∘ lower = id` on\n   709\t  canonical frames, tested against the reference machine's own frames —\n   710\t  which is possible precisely because the dynamic half rides in the frame.\n   711\t- A request to lift at a pc that is not a safepoint of the segment returns\n   712\t  `:yin.k/not-at-safepoint` naming the pc. An engine that wants finer\n   713\t  interruption granularity must lower the program to a segment that\n   714\t  *contains* a `:park` where it wants one: that is a different instruction\n   715\t  record, a different address, and a different profile. An engine may not\n   716\t  invent safepoints a record does not have, and two engines that disagree\n   717\t  about the safepoint set of one address are not both conforming.\n   718\t\n   719\tSafepoints are datoms, so a query can ask \"where can this program be\n   720\tmigrated?\" without running it, and a debugger's breakpoint set is a subset of\n   721\tthe safepoint set by construction.\n   722\t\n   723\t### 7.4.3 The pending wait travels as data — complete, and resumable elsewhere\n   724\t\n   725\tA parked machine was waiting for something. That something is a resource of\n   726\tthe emitter's host, and the resumer cannot poll it. `:yin.k/pending` records\n   727\tthe wait in resource-independent terms so the resumer can re-establish an\n   728\t*equivalent* wait, or decide it cannot. The first draft carried sketches;\n   729\tthe set here is exhaustive over §7.4.1's reasons, and each variant carries\n   326\t;; => nil, or {:yin.k/kind k :yin.k/path p …}\n   327\t```\n   328\t\n   329\tin **PROPOSED** namespace `yin.vm.semantic-register.frame`, file\n   330\t`src/cljc/yin/vm/semantic_register/frame.cljc`, requiring only\n   331\t`yin.vm.semantic-register.code` (`body-ranges`, `body-index`, `rd`,\n   332\t`tail-call?`, `registers`-per-body via `parse`),\n   333\t`yin.vm.semantic-register.analysis` (`analyze`, `saved`) and `yin.vm`\n   334\t(`reserved-name?`). It knows no kernel, no engine, no stream: a frame a\n   335\tstack kernel lifted and a frame the register evaluator lifted are judged\n   336\tby the same function on the same inputs.\n   337\t\n   338\t### 3.2 The rules\n   339\t\n   340\tRules run in order; the first defect wins; every defect carries\n   341\t`:yin.k/kind` and `:yin.k/path` (the frame key path, `[:yin.k/k i …]` for\n   342\ta return frame). `a = (analysis/analyze v)` is computed once per segment.\n   343\t\"The instruction at `pc−1`\" is `(nth v (dec pc))`; `body(p)` is\n   344\t`(code/body-index (code/body-ranges v) p)`; `k(body)` is the body's\n   345\tregister count (`code/parse`'s `:registers`).\n   346\t\n   347\t| # | Rule | Refusal kind |\n   348\t|---|---|---|\n   349\t| 1 | **Shape.** An `act` has exactly `:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env :yin.k/window :yin.k/deliver :yin.k/k` and optionally `:yin.k/pending`; a `tail` exactly `:yin.k/state :yin.k/segment :yin.k/site :yin.k/deliver :yin.k/k` and optionally `:yin.k/pending`; no other key; `:yin.k/state` is `:act` or `:tail` | `:frame-shape` |\n   350\t| 2 | **Segment.** `:yin.k/segment` names a key of `code`; the same for every return frame's segment | `:segment` |\n   351\t| 3 | **Bounds.** `pc` is an exact integer with `0 < pc < (count v)`; a return frame's `pc` likewise; a `tail`'s `site` with `0 ≤ site < (count v)` | `:pc-bounds` |\n   352\t| 4 | **Window representation.** `:yin.k/window` is a map whose keys are exact non-negative integers (on the wire: sorted ascending, unique); values are `V`; a nil value is a present key | `:window-representation` |\n   353\t| 5 | **Body scope.** every window key is `< k(body(pc))` and `body(pc)` is the body of `pc−1` (a resume pc never crosses a body boundary: `pc−1` and `pc` are in one body, which holds because no body ends in a parking instruction, frozen §3.4 rule 6) | `:window-scope` |\n   354\t| 6 | **Site.** the instruction at `pc−1` of an `act` is one of `:stream-next :stream-put :ffi-call :call :park :current-continuation`, and for a `:call` it is **not** a tail call (`code/tail-call?` false); a `tail`'s `site` instruction is a `:call` with `tail?` true | `:site` |\n   355\t| 7 | **Destination.** `(:yin.k/rd (:yin.k/deliver act))` equals `(code/rd (nth v (dec pc)))` | `:destination` |\n   356\t| 8 | **Membership.** `(set (keys window)) = (analysis/saved a pc rd)`: a key outside the set is `:window-extra`, a member missing is `:window-missing`, `rd` present is `:window-self` (checked before the set comparison so it is named separately) | `:window-extra` / `:window-missing` / `:window-self` |\n   357\t| 9 | **Delivery mode.** an `act`'s deliver is exactly `{:yin.k/deliver :rd :yin.k/rd r}` with `r` an exact integer; a `tail`'s exactly `{:yin.k/deliver :return}`; a `tail` has no `:yin.k/window`, `:yin.k/env` or `:yin.k/pc` (rule 1 already) | `:deliver` |\n   358\t| 10 | **Return frames.** `:yin.k/k` is a vector; each frame has exactly `:yin.k/frame-type :return :yin.k/segment :yin.k/pc :yin.k/env :yin.k/window :yin.k/rd`; the instruction at `frame.pc−1` in `frame.segment` is a `:call` with `tail?` false; `frame.rd` equals that call's `rd`; `(set (keys frame.window)) = (analysis/saved aₛ frame.pc frame.rd)` in that segment's analysis, with the three membership kinds as rule 8; window keys `< k(body(frame.pc))` | `:return-site` / `:return-destination` / `:return-window-*` |\n   359\t| 11 | **Environment.** `:yin.k/env` (of an `act` and of every return frame) is `{:yin.k/bindings {S V …}}` optionally with `:yin.k/store-of M`; every binding key is a symbol and none is `yin/def` (Rule R; `vm/reserved-name?`) | `:env` / `:reserved-name` |\n   360\t| 12 | **Reason compatibility.** when `:yin.k/pending` is present, its reason is admitted by the instruction at `pc−1` (`act`) or `site` (`tail`): `:stream-next` → `:next`; `:stream-put` → `:put`; `:ffi-call` → `:ffi` or `:ffi-request`; `:call` → `:next :put :ffi :ffi-request :link-request :link-response :install`; `:park` and `:current-continuation` admit **no** pending (frozen §4.1; `wire-of-kind`, `handoff.cljc:491-504`; ucf-revisions §8: the static kind gates, the observed reason decides) | `:reason-mismatch` |\n   361\t| 13 | **Captured context.** when the frame is judged as a reified value (`context :captured`): it is an `act`, has no pending, and `pc−1` is `:current-continuation` | `:captured-site` |\n   362\t| 14 | **Parked context.** when judged as a parked-table entry (`context :parked`): an `act` whose `pc−1` is `:park` and no pending; or, when the table key is the call id of a live `:ffi`/`:ffi-request` pending of the same task, an `act` whose `pc−1` is `:ffi-call` or a `tail` whose site's call is the parking call (bookkeeping) | `:parked-site` |\n   363\t\n   364\tThe validator takes a `context` argument, one of `:wait`, `:captured`,\n   365\t`:parked`, selecting rules 12-14. Rule 8 is the frozen §4.2 membership\n   366\tcheck; rules 5, 10 and 12 are its \"body scope\", \"return-frame sites\" and\n   367\t\"pending compatibility\"; rules 6-7 its \"site/pc pairing\" and\n   368\t\"destination equality\"; rule 9 \"delivery mode\". Nothing here reads\n   369\t`:yin.k/live`, a stack depth or a stack base: those were the stack\n   370\tmachine's (v2 amendment §5.1-5.3) and have no counterpart.\n   371\t\n   372\t### 3.3 Where the validator runs\n   373\t\n   374\t**DECIDED** (draft §8 step 7, replaced; §10.3). On lower, after the\n   375\tgate, structure, graph and hash steps (draft §8 steps 1-4) and before\n   376\tcanonical numbering, **every** `:act`, `:tail`, `:kframe`, `:reified`\n   377\tand parked-table state is decoded to its keyed frame and judged by\n   378\t`frame/defect` with its context; a defect is `:yin.k/undecodable` with\n   379\tthe rule's kind and the row path. On lift, the same function runs over\n   380\tevery frame the lift assembled before any row is emitted (a frame the\n     1\t(ns yin.vm.debruijn-register-effects\n     2\t  \"R2 (docs/design/yin.vm.debruijn.register.md S5.2): pure effect\n     3\t   descriptors, sparse continuation snapshots, and wait-entry\n     4\t   validators for the de Bruijn register VM.\n     5\t\n     6\t   This namespace is pure data construction and validation only. It reads\n     7\t   no host clock, stream, namespace registry, or mutable state.\"\n     8\t  (:require [dao.stream.apply :as apply2]\n     9\t            [yin.vm :as vm]\n    10\t            [yin.vm.debruijn-register-code :as rcode]))\n    11\t\n    12\t\n    13\t(def format-tag\n    14\t  \"The format identity keyword for register VM continuations.\"\n    15\t  :yin.debruijn.register)\n    16\t\n    17\t\n    18\t(def boundary-opcodes\n    19\t  \"The set of six instruction opcodes that form suspension or\n    20\t   continuation boundaries.\"\n    21\t  rcode/boundary-opcodes)\n    22\t\n    23\t\n    24\t;; =============================================================================\n    25\t;; 1. Effect descriptors (design section 5.2.1)\n    26\t;; =============================================================================\n    27\t\n    28\t(defn effect-descriptor\n    29\t  \"Purely construct a normalized engine effect descriptor from a register\n    30\t   instruction and the current body's complete register vector, or nil when\n    31\t   the instruction produces no engine effect.\n    32\t   Precondition: `instruction` came from a validator-approved image.\n    33\t\n    34\t   The descriptor is plain portable data, not an in-machine effect (D4):\n    35\t   a map is never dispatched. A kernel that dispatches it mints the effect\n    36\t   at that boundary with `module/make-effect`.\"\n    37\t  [instruction registers]\n    38\t  (case (first instruction)\n    39\t    :store-put\n    40\t    (let [[_ _ key value] instruction]\n    41\t      {:effect :vm/store-put, :key key, :val value})\n    42\t\n    43\t    :stream-make\n    44\t    (let [[_ _ capacity] instruction]\n    45\t      {:effect :stream/make, :capacity capacity})\n48:    (let [[_ _ sr vr _live] instruction]\n58:    (let [[_ _ cr _live] instruction]\n84:(defn continuation-payload\n86:   suspending or boundary instruction. Extracts only live registers in\n98:          live-idx (rcode/live-slot-index op)\n99:          live (nth instruction live-idx)\n102:          resume-mode (if tail? :return-result :write-result)\n103:          regs (mapv (fn [r] [r (nth (:registers runtime) r)]) live)\n110:               :live live,\n163:    (let [{:keys [site-pc return-pc frames regs live dest]} frame]\n179:                            call-live (nth inst 5)]\n190:                            (when-not (= call-live live)\n191:                              {:rule :continuation-live,\n192:                               :expected call-live,\n193:                               :actual live,\n198:                            (when-not (= live (mapv (fn [p] (nth p 0)) regs))\n297:        (let [{:keys [segment site-pc pc resume-mode live regs dest frames\n310:                          expected-mode (if tail? :return-result :write-result)\n311:                          inst-live (nth inst (rcode/live-slot-index op))]\n317:                          (when-not (and (vector? live)\n318:                                         (every? nonneg-int? live)\n319:                                         (ascending-distinct? live)\n777:`[[:closure 1 6] [:push] [:const 10] [:push] [:call 1 false] [:halt] [:load-free +] [:push] [:load-bound 0 0] [:push] [:const 1] [:push] [:call 2 true] [:return]]`.\n824:**9. A tail call as an operand: `(f (g x) y)` with the inner call marked\n825:`:tail? true`** (the shape §2.5's law must handle; not in any corpus, so\n827:[:call 2 3 [4] true] [:var 5 y] [:call 0 1 [2 5] false] [:halt 0]` (the\n831:live 4,5 → `[0,5]`; `v3:[1,3]`; `v4:[2,3]`; `v2`: def 3 (the tail call\n837:**`[]`**: the tail call has no successor, so its virtual live-out is `{}`\n846:exist (`(+ 1 2)`, `(f (g x) y)`, `((f))`, `(f (if c 1 2) y)`, the tail\n1167:body, unreachable components included, and for a tail `:call` it is\n1172:`L(pc+1) − {rd}` for a non-tail boundary and the empty set for a tail\n1188:>    `:push`, operands with `:push` each, `:call argc tail?`, labels for\n1422:   tail-call-as-operand image with `live [] ` on the tail call is among\n1429:   `analysis/successors` minus `rd`; every tail `:call` has `live []`\n1481:   `:if-in-tail` `[[< true] [loop true] [- true]]`.\n1484:   no site; `:store-ops` `[k false] [:n false]`, one site; `:if-in-tail`\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-ESlKXaxO' (errno=Operation not permitted)\n2026-10-11 01:46:27.671 xcodebuild[24251:55421926]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-11 01:46:28.018 xcodebuild[24251:55421922] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-vSYtzCDX' (errno=Operation not permitted)\n2026-10-11 01:46:28.746 xcodebuild[24256:55421954]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-11 01:46:29.032 xcodebuild[24256:55421953] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\n?? collab/1791730000000-architect-srvm-phase6-design.claude-fable-5-1.stdout.log\n?? collab/1791730000000-architect-srvm-phase6-design.prompt.md\n?? collab/1791730000000-architect-srvm-phase6-design.report.md\n?? collab/1791760000000-architect-srvm-phase6-design-review.gpt-6.1-sol.stdout.log\n?? coll