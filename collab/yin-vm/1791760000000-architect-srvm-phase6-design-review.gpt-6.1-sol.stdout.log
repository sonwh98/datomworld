let [frame (peek K)]\n   148\t                                       (recur machine (:segment frame) (:pc frame)\n   251\t   As for the walker: there is no `:in-stream` (program observation belongs\n   252\t   to `dao.stream.observer`), and construction is all-or-nothing — the FFI\n   253\t   pair and its call-out cursor are stream operations whose failure fails\n   254\t   here.\"\n   255\t  ([] (create-vm {}))\n   256\t  ([opts]\n   257\t   (when (contains? opts :in-stream)\n   258\t     (throw (ex-info\n   259\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n   260\t              {:in-stream (:in-stream opts)})))\n   261\t   (let [env (vm/check-bindings! :env (or (:env opts) {}))\n   262\t         base (vm/empty-state\n   263\t                (assoc (select-keys opts\n   264\t                                    [:primitives :primitive-profiles\n   265\t                                     :primitive-canonical-names :modules\n   266\t                                     :make-stream :call-in :call-out\n   220\t                    effect (case op\n   221\t                             :stream-make (module/make-effect :stream/make {:capacity (nth inst 2)})\n   222\t                             :stream-cursor (module/make-effect :stream/cursor {:stream (get W (nth inst 2))})\n   223\t                             :stream-close (module/make-effect :stream/close {:stream (get W (nth inst 2))})\n   224\t                             :stream-put (module/make-effect :stream/put {:stream (get W (nth inst 2)) :val (get W (nth inst 3))})\n   225\t                             :stream-next (module/make-effect :stream/next {:cursor (get W (nth inst 2))}))\n   226\t                    r (run-effect machine seg pc W E K effect\n   227\t                                  (when (contains? #{:stream-put :stream-next} op)\n   228\t                                    (act-builders seg pc E W K rd (:analysis image))))]\n   229\t                (if-let [[next-state value] (:continue r)]\n   230\t                  (recur next-state seg (inc pc) (assoc (:window next-state) rd value)\n   231\t                         (:env next-state) (or (:k next-state) []) remaining)\n   232\t                  (:stop r)))\n   233\t              :ffi-call\n   234\t              (let [rd (nth inst 1) ffi-op (nth inst 2)\n   235\t                    args (mapv #(get W %) (nth inst 3))\n   236\t                    {:keys [call-in]} (ffi/require-call-pair! (:resources machine) ffi-op)\n   237\t                    state (put-registers (engine/pin-refs machine args) seg pc W E K)\n   238\t                    call-id (ffi/call-id state (engine/park-id state))\n   239\t                    payload (act-payload seg pc E W K rd (:analysis image))\n   380\t                                     :make-stream :call-in :call-out\n   381\t                                     :call-out-cursor :ffi-caller-id\n   382\t                                     :call-capacity :link-request\n   383\t                                     :link-response :origin :ancestry\n   384\t                                     :capability-secret :secret-source\n   385\t                                     :attach-stream :gc-threshold])\n   386\t                       :telemetry (:telemetry opts)\n   387\t                       :vm-model :semantic-register))]\n   388\t     (-> (map->RegisterVM (merge base\n   389\t                                 {:bridge nil,\n   390\t                                  :program nil,\n   391\t                                  :control nil,\n   392\t                                  :env env,\n   393\t                                  :window {},\n   394\t                                  :k nil,\n   395\t                                  :value nil,\n   396\t                                  :code {},\n   390\t   path answers as data -- so the wake answers them as data too.\"\n   391\t  {:next #{:dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n   392\t           :dao.stream/transport-error}\n   393\t   :put #{:dao.stream/closed :dao.stream/invalid-value\n   394\t          :dao.stream/transport-error}})\n   395\t\n   396\t\n   397\t(def ^:private wake-value-statuses\n   398\t  \"The statuses a woken entry resumes with its poll's own value, by wait\n   399\t   reason: ok, end and gap for a parked reader, ok alone for a parked\n   400\t   writer -- the write outcome set has no end and no gap, so those\n   401\t   keywords on an append are outcomes outside this contract version and\n   402\t   refuse. An entry that was never polled carries no status and resumes\n   403\t   with the value it already holds.\"\n   404\t  {:next #{nil :ok :end :dao.stream/gap}\n   405\t   :put #{nil :ok}})\n   406\t\n   407\t\n   408\t(defn- wake-refusal?\n   409\t  \"True when a woken `:next`/`:put` entry's `status` is one the immediate\n   410\t   path answers as the shaped refusal: `:dao.stream/refused`, or a\n   411\t   well-formed outcome outside this contract version -- a newer contract,\n   412\t   not a defect. The declared error outcomes are terminal instead, and\n   413\t   the value statuses carry their poll's own value.\"\n   414\t  [reason status]\n   415\t  (and (contains? #{:next :put} reason)\n   416\t       (not (contains? (get wake-value-statuses reason) status))\n   417\t       (not (contains? (get wake-error-outcomes reason) status))))\n   418\t\n   419\t\n   420\t(defn make-woken-run-queue-entries\n55:(defn bind-params\n   326\t(defn absolute-pc\n   327\t  \"Lower `[identity rel-pc]` to an absolute pc of `vm` by its offset\n   328\t   table, or nil when the identity is no row of it or `rel-pc` is no pc\n   329\t   `image-pc` lifts into that row.\"\n   330\t  [vm [ident rel-pc]]\n   331\t  (let [images (:images vm)]\n   332\t    (some (fn [[id off :as row]]\n   333\t            (when (and (= id ident)\n   334\t                       (nat-int? rel-pc)\n   335\t                       (= row (effects/image-row images (+ off rel-pc))))\n   336\t              (+ off rel-pc)))\n   337\t          images)))\n   125\t                :when rd]\n   126\t          (is (= (disj (analysis/live a (inc pc)) rd)\n   127\t                 (analysis/saved a (inc pc) rd)))\n   128\t          (is (not (contains? (analysis/saved a (inc pc) rd) rd))))))))\n   129\t\n   130\t\n   131\t(deftest saved-window-of-a-non-tail-call\n   132\t  ;; (f (g x) y): while (g x) runs, f's register 1 must survive the call;\n   133\t  ;; at the resume pc 4, L = {1 2} and saved(4, 2) = {1}.\n   134\t  (let [v (:vector (get corpus/goldens :worked-example))\n   135\t        a (analysis/analyze v)]\n   136\t    (is (= #{1 2} (analysis/live a 4)))\n   137\t    (is (= #{1} (analysis/saved a 4 2)))\n   138\t    (is (= #{1 2 5} (analysis/live a 5)))\n   139\t    (is (= #{} (analysis/live a 0)))))\n   140\t\n   141\t\n   142\t(deftest structural-slot-of-a-definition-less-id\n50:## 2. Positioning: body version 3, same profiles\n52:Body versions 0 and 1 (UCF §7.2.1) and 2 (the amendment) are nested\n56:`:yin.k/profile-mismatch` carrying the version found and the set it\n61:The execution profile is untouched. `:yin.k/contract` carries exactly the\n62:amendment §1 profile map `{:yin.k/engine e :yin.code/contract c\n64:gate (one profile per task and install tree). Code stamps `\"v3\"`, `\"b2\"`,\n70:This document tables the **semantic** profile's registers, frames and\n72:profile only**: a version-3 body whose profile map names `:stack`,\n73:`:register` or `:walker` fails closed at the profile gate\n74:(`:yin.k/profile-mismatch`) until those profiles' row tables and\n76:code addresses and profile maps unchanged. Like version 2,\n77:version 3 transports native suspended state within a profile and does not\n79:implements canonical semantic-VM execution in its own layout, UCF §7.4.2)\n80:is the semantic profile lowered through that engine's value profile, and\n81:value profiles are a separate document (§10.6).\n285:| `:prim` | `name-S` | the named primitive after the profile check (UCF §7.5.2); the profile lives in requires |\n287:| `:reified` | `regs-cref` | `{:yin.k/tag :yin.k/frame :yin.k/registers R}`: a captured continuation, no wait |\n302:| `:regs` | `segment-A  pc-N  env-cref  stack-cref  k-cref` |\n305:| `:kframe` | `segment-A  pc-N  env-cref  stack-base-N` |\n306:| `:wait` | `regs-cref  pending-cref` |\n308:`:regs` is amendment §5.1's `R` for the semantic profile, and nothing\n310:with a pending; a reified value and a parked record reference `:regs`\n312:segment pc env stack-base}`; the semantic profile has no other frame\n313:type on the wire (walker effect frames belong to the walker profile's\n361:| `:parked-table` | `P₁ regs-cref₁ P₂ regs-cref₂ …` sorted by P |\n378:contract and the child's profile agree (`yin.vm.linker.md` §5, §9;\n386:   contract         ; the profile map, plain  (amendment §1)\n425:`:yin.k/profile-mismatch`. Admission semantics are the governing ones\n611:   integer 3, else `:yin.k/profile-mismatch` (version found, supported\n619:   child's version, then every profile map against the registry (only\n620:   the semantic profile is supported, §2), then require all versions 3\n621:   and all profiles equal to the root's. Malformed task structure is\n622:   `:yin.k/undecodable`; an unsupported version or profile is\n623:   `:yin.k/profile-mismatch`; the two are never conflated.\n678:   modules, streams, cursor profiles are `:yin.k/unsatisfied`; a body\n696:`:yin.k/profile-mismatch`, `:yin.k/undecodable` with `:yin.k/path` as\n708:§7.5.4 and §7.2.1 specify. The nested carrier's value table\n717:  version-3 state `S` in the semantic profile **for which `lower(S)`\n740:  is **partial**: a legacy body normalizes with semantic preservation\n743:  profile version 3 does not yet support); it never substitutes a\n744:  version-3 address for an admitted legacy checkpoint. Exact mutual\n746:  nested projection (§10.3).\n768:   layout.\n769:3. **The nested grammar.** Versions 0, 1 and 2 remain compatibility\n770:   inputs. One canonical nested projection of version 3 is kept for\n774:4. **Contract stamp.** The profile map and code contracts do not move; a\n778:5. **Reified and parked.** Sharing immutable `:regs` rows is acceptable;\n782:6. **Foreign-engine value profiles.** Required before any implementation\n785:   resource and profile requirements, refusal sets, and safepoint\n792:7. **Other profile tables.** Deferral is acceptable for a semantic-only\n794:   profiles fail closed at the gate (§2) until their complete tables and\n795:   validation rules are published, with their profiles and code\n800:   different address that never silently replaces an admitted legacy\n836:Still open after this revision: none beyond the other-profile tables\n841:Code identity, the contract stamp and profile registry, safepoints,\n              [:yin.code/arg-regs :regs]],\n   :current-continuation [[:yin.code/rd :reg]],\n   :park [[:yin.code/rd :reg]],\n   :resume [[:yin.code/parked-id :kw] [:yin.code/value-reg :reg]],\n   :define [[:yin.code/rd :reg] [:yin.code/name :sym] [:yin.code/rs :reg]]})\n\n\n(def mnemonics\n  \"The §2.3 vocabulary. There is no `:push` and no `:move`.\"\n  (set (keys operand-table)))\n\n\n(defn reg?\n  \"A register id: a non-negative integer.\"\n  [x]\n  (and (integer? x) (not (neg? x))))\n\n\n(defn rd\n  \"The destination slot of tuple `t`, or nil when its mnemonic has none\n   (`:branch-false`, `:jump`, `:return`, `:halt`, `:resume`).\"\n  [t]\n  (when (= :yin.code/rd (ffirst (get operand-table (nth t 0))))\n    (nth t 1)))\n\n\n(defn uses\n  \"The register operands of tuple `t` in table order, which is §3.1's\n   child order: `:reg` operands other than the destination, and each\n   element of a `:regs` operand. Values are returned as they stand; rules\n   that judge registers filter with `reg?`.\"\n  [t]\n  (into []\n        (comp (map-indexed (fn [i [a kind]]\n                             (cond (= :yin.code/rd a) nil\n                                   (= :reg kind) [(nth t (inc i))]\n                                   (= :regs kind) (nth t (inc i))\n                                   :else nil)))\n              cat)\n        (get operand-table (nth t 0))))\n\n\n(defn tail-call?\n  \"True for a `:call` whose `tail?` is exactly true: a runtime terminator\n   (§3.3 item 4).\"\n  [t]\n  (and (= :call (nth t 0)) (true? (nth t 4))))\n\n\n(defn runtime-terminator?\n   `:noncanonical-registers` `:noncanonical-layout` (13).\"\n  [v]\n  (let [ctx (context v)]\n    (some #(% ctx) rules)))\n\n\n(defn parse\n  \"The parsed bodies of a well-formed vector, in pc order: `[{:start s\n   :end e :owner closure-pc-or-nil :expr tree :registers k} …]`.\"\n  [v]\n  (mapv (fn [body] (assoc body :registers (registers v body)))\n        (:bodies (parse-bodies v))))\n\n\n(defn load-vector\n  \"The direct load path (code-as-tuples §7.1): require the `\\\"v4\\\"`\n   stamp (`:contract-missing`, `:contract-mismatch`), validate under\n   §3.4 (a defect throws naming rule and pc), and return the image\n   `{:vector v :address A :bodies [{:start :end :owner :registers} …]}`,\n   A being `ucf/code-address` of the vector. Both load paths end here, so\n   they run one validator and yield one image.\"\n  [v stamp]\n  (vm/check-contract! contract stamp)\n  (when-let [defect (well-formed? v)]\n    (throw (ex-info (str \"Cannot load vector: \" (name (:rule defect))\n                         \" (pc \" (:pc defect) \")\")\n                    {:defect defect})))\n  {:vector v,\n   :address (ucf/code-address v),\nexplicitly for required fields. All structural maps in this amendment\nare closed: unlisted keys refuse. Optional absence has one spelling.\nGuest literal maps remain open data because they are wrapped as values.\n\nAll named integer/version checks distinguish wire scalar kinds before\nhost numeric equality. Canonical bytes are Jing's canonical CBOR bytes;\nretain float64 and other numeric carrier classes while validating hashes.\nOnly the established execution bridge converts scalars for execution.\nDo not recompute a code hash after coercing `1.0` to `1` on JavaScript.\n\nAn environment `E` has this exact shape:\n\n```clojure\n{:yin.k/bindings {S V ...}\n :yin.k/store-of M}                 ; optional; omit outside a module\n```\n\nLower reconstructs the native named environment, adding\n","exit_code":0,"status":"completed"}}
