   "The stateless lowering: a program that carries the prelude."
   [packet]
   (first (lower-session packet nil)))
+
+
+;; =============================================================================
+;; The linked profile (C4 slice I3)
+;; =============================================================================
+
+(defn- require-node
+  [m]
+  (u/sexp->uast (list 'require (list 'quote m))))
+
+
+(defn lower-linked-session
+  "`lower-session` under the linked profile: the runtime is the module
+   `py` and each imported module is `pym.<mangled>`, delivered by the
+   shell's link source. A submission requires the modules it imports
+   (ruling 4's hoisted delivery); the first of a session then requires
+   `py` and allocates the task's runtime state with `(py/init!)`, and
+   later ones find both in the task. The imports are delivered first:
+   each closure pins `py` itself, and a refused import refuses the
+   submission before any of it runs."
+  [packet session]
+  (let [packet (checked-packet packet)
+        imports (mapv require-node
+                      (map lower/module-symbol
+                           (lower/imported-module-names packet)))
+        runtime (when-not (= :primed session)
+                  [(require-node prelude/module-name)
+                   (u/sexp->uast '(py/init!))])]
+    [(u/mark-tails (u/seq-nodes (-> imports
+                                    (into runtime)
+                                    (conj (main-node packet)))))
+     :primed]))
+
+
+(defn link-admission
+  "The admission the shell applies to the links of a linked submission,
+   given the shell's `{:key}`: `principal-admission` naming the session's
+   own principal, the key it publishes under, as the importer's. A name
+   only another principal asserts is refused until L-e (ruling 19), and
+   with no key every signed name is; the shell's direct name entries are
+   always admitted."
+  [{:keys [key]}]
+  (publication/principal-admission (if key [(:public key)] [])))
+
+
+(defn linked-binding
+  "The frontend binding of the linked profile over the parse stage
+   `parse` (source text to CST packet): `yang.frontend`'s
+   `:parse`/`:lower`/`:lower-session`, the `:output` display, and the
+   `:link-admission` the shell applies to every link its programs
+   request."
+  [parse]
+  {:parse parse,
+   :lower #(first (lower-linked-session % nil)),
+   :lower-session lower-linked-session,
+   :display :output,
+   :link-admission link-admission})
