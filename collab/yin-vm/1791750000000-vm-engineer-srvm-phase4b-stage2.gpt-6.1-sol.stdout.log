endency completeness\n    :obligations (constantly [])},\n   :stack\n''',1)\n p.write_text(s)\np=Path('test/yin/vm/semantic_register/vm_test.cljc');s=p.read_text();s=s[:s.index('\\\\n\\\\n(deftest stage2-deferred-arms')]+ '\\\\n';p.write_text(s)\np=Path('test/yin/vm/semantic_register/parity_test.cljc');s=p.read_text();a=s.index('(defn stage1-eligible?');b=s.index('(defn trace-normalize',a);s=s[:a]+s[b:];s=s.replace('(filter #(stage1-eligible? (second %)) b0/corpus)','b0/corpus').replace('(filter #(stage1-eligible? (second %)) corpus/programs)','corpus/programs').replace('(= 30 (count rows))','(= 32 (count rows))');p.write_text(s)\np=Path('test/yin/vm/semantic_register/walker_trace_test.cljc');s=p.read_text().replace(':current-continuation} op)',':current-continuation :ffi-call} op)').replace('(filter #(parity/stage1-eligible? (second %))\\\\n                     (concat b0/corpus corpus/programs parity/definition-programs))','(concat b0/corpus corpus/programs parity/definition-programs)').replace('(= 61 (count rows))','(= 63 (count rows))').replace('      (is (parity/stage1-eligible? ast))\\\\n','');p.write_text(s)\np=Path('test/yin/vm/semantic_register/effects_test.cljc');s=p.read_text().replace('[dao.stream :as stream]','[dao.stream :as stream]\\\\n            [dao.stream.apply :as apply2]\\\\n            [yin.vm.ffi :as ffi]').replace('      (vm/halted? machine) machine','      (vm/halted? machine) machine\\\\n      (vm/blocked? machine) (throw (ex-info \\\"Continuation value test blocked\\\" {:steps steps}))');p.write_text(s)\nPY\nsed -n '160,208p' test/yin/vm/effect_forgery_test.cljc; sed -n '885,920p' test/yin/vm/semantic_test.cljc; sed -n '195,256p' test/yin/vm/linker_require_test.cljc; sed -n '1088,1120p' test/yin/vm/linker_require_test.cljc\"","aggregated_output":";; =============================================================================\n\n(defn- store-put\n  [key val]\n  (module/make-effect :vm/store-put {:key key, :val val}))\n\n\n(def ^:private host-registry\n  (module/register-host-module\n    (module/default-registry)\n    'my.lib\n    {'sneak (fn [] (store-put 'k3 1)), 'declared (fn [] (store-put 'k4 2))}\n    {'sneak (vm/primitive-profile 'sneak :pure [0] #{} :none),\n     'declared (vm/primitive-profile 'declared :effectful [0]\n                                     #{:vm/store-put} :none)}))\n\n\n(deftest host-module-effect-outside-its-profile-is-refused-test\n  (testing \"A host export profiled :pure that returns an effect is refused\n            with a qualified error, and writes nothing\"\n    (doseq [[k result] (on-every-vm {:modules host-registry}\n                                    (app (v 'my.lib/sneak)))]\n      (is (= [:thrown\n              {:yin.k/status :yin.k/undeclared-effect,\n               :yin.k/effect :vm/store-put,\n               :yin.k/effects #{}}]\n             result)\n          (str k))))\n  (testing \"An export declaring the effect passes\"\n    (doseq [[k result] (on-every-vm {:modules host-registry}\n                                    (app (v 'my.lib/declared)))]\n      (is (= 2 (vm/value result)) (str k))\n      (is (= 2 (get (vm/store result) 'k4)) (str k)))))\n\n\n(deftest profiled-primitive-effect-outside-its-profile-is-refused-test\n  (let [entry (fn [name class effects f]\n                (assoc (vm/primitive-profile name class [0] effects :none)\n                       :yin.k/function f))\n        prims (assoc vm/primitives\n                     'sneak (entry 'sneak :pure #{} #(store-put 'k5 1))\n                     'declared (entry 'declared :effectful #{:vm/store-put}\n                                      #(store-put 'k6 2)))]\n    (testing \"A primitive profiled :pure that returns an effect is refused\"\n      (doseq [[k result] (on-every-vm {:primitives prims}\n                                      (app (v 'sneak)))]\n        (is (= :yin.k/undeclared-effect\n               (:yin.k/status (second result)))\n            (str k))))\n(deftest semantic-restore-retained-response-route-test\n  (let [base {:parked {:parked-0 {:continuation true}}}\n        entry (fn [extra]\n                (merge {:segment 0, :pc 3, :env {}, :stack [], :k [],\n                        :request-sent true, :call-id :parked-0,\n                        :reason :put, :stream-id :yin/call-in,\n                        :datom {:request true}}\n                       extra))]\n    (testing \"an ordinary retained writer waits on the fixed call-out keys\"\n      (let [restored (semantic/semantic-restore base (entry nil))\n            [wait] (:wait-set restored)]\n        (is (true? (:blocked? restored)))\n        (is (false? (:halted? restored)))\n        (is (= :next (:reason wait)))\n        (is (= :parked-0 (:call-id wait)))\n        (is (= 3 (:pc wait)))\n        (is (= vm/call-out-cursor-key (get-in wait [:cursor-ref :id])))\n        (is (= vm/call-out-stream-key (:stream-id wait)))))\n    (testing \"a lowered retained writer waits on its carried route\"\n      (let [restored (semantic/semantic-restore\n                       base\n                       (entry {:stream-id :yin.k/k-7,\n                               :response-cursor :yin.k/k-9,\n                               :response-stream :yin.k/k-8}))\n            [wait] (:wait-set restored)]\n        (is (true? (:blocked? restored)))\n        (is (= :next (:reason wait)))\n        (is (= :parked-0 (:call-id wait)))\n        (is (= :yin.k/k-9 (get-in wait [:cursor-ref :id]))\n            \"the carried response cell's allocated key\")\n        (is (= :yin.k/k-8 (:stream-id wait))\n            \"the carried response reflection's allocated key\")\n        (is (= 3 (:pc wait)))\n        (is (contains? (:parked restored) :parked-0)\n            \"the parked call is untouched until its response lands\")))))\n                                          (map (fn [[id row]]\n                                                 [id (subvec row 1)]))\n                                          (:rows bc)))))}})\n\n\n;; =============================================================================\n;; The link pair and the stub responder\n;; =============================================================================\n\n(defn- link-pair\n  \"The link pair, and the directory of every stream the composition made,\n   by logical identity, which its attacher resolves.\"\n  []\n  {:request (tu/new-stream 64),\n   :response (tu/new-stream 64),\n   :streams (atom {})})\n\n\n(defn- composition\n  \"One task's composition over `pair`: the ring buffer, recorded so a\n   lowered stream reference (r9) can attach to it; a deterministic\n   capability secret, and a deterministic source minting each install\n   child's own (r10).\"\n  [pair]\n  (let [streams (:streams pair)]\n    {:primitives vm/primitives,\n     :modules (module/default-registry),\n     :make-stream (fn [capacity]\n                    (let [r (tu/make-stream capacity)]\n                      (swap! streams assoc (:dao.stream/identity r)\n                             (:dao.stream/handle r))\n                      r)),\n     :capability-secret tu/secret,\n     :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n     :attach-stream (ringbuffer/make-attacher (fn [ident]\n                                                (get @streams ident))),\n     :link-request (:request pair),\n     :link-response (:response pair)}))\n\n\n(defn- responder\n  \"A stub linker over `pair`: `table` maps a module name to the response\n   body it answers every request for that name with.\"\n  [pair table]\n  {:pair pair,\n   :table table,\n   :cursor (:dao.stream/cursor (stream/cursor (:request pair)\n                                              stream/anchor-oldest)),\n   :requests []})\n\n\n(defn- respond!\n  \"Read every request the stub has not yet seen and append its response,\n   in request order. Returns the advanced responder.\"\n  [r]\n  (loop [r r]\n    (let [res (stream/next (get-in r [:pair :request]) (:cursor r))]\n      (if (= :dao.stream/ok (:dao.stream/outcome res))\n        (let [request (:dao.stream/value res)\n              body (get (:table r) (:yin.link/name request)\n                        {:status :refused,\n                         :reason :absent,\n                                       ;; no backend's loader admits it\n                                       {:bodies [],\n                                        :instructions [[:bogus]],\n                                        :root :absent,\n                                        :rows {}}))]\n        (testing \"validated requires every export bound: :export-missing\"\n          (is (= :export-missing (:reason missing)))\n          (is (= ['absent] (:names missing))))\n        (testing \"a loader defect refuses the install at loading\"\n          (is (= :refused (:status defect)))\n          (is (= :loading (:phase defect))))))))\n\n\n(deftest a-marker-of-another-binding-discipline-is-refused-test\n  (let [stack-task (vm/run (dvm/create-vm (stack-image (returning 1))\n                                          {:primitives vm/primitives,\n                                           :contract vm/stack-contract}))\n        closure (values/payload (get (vm/store stack-task) 'f))\n        marker (module/lift-closure stack-task closure identity)\n        semantic-task (semantic/create-vm {})\n        register-task (rvm/create-vm nil {})]\n    (is (= :positional (:yin.k/binding marker)))\n    (is (= :binding-mismatch\n           (:reason (refusal-of #(module/lower-closure semantic-task marker\n                                                       identity)))))\n    (is (= :binding-mismatch\n           (:reason (refusal-of #(module/lower-closure register-task marker\n                                                       identity))))\n        \"a positional marker lowers only into its own format\")))\n\n\n;; =============================================================================\n;; A publication defect refuses the install (section 7.3, `refused`)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat >> test/yin/vm/semantic_register/effects_test.cljc <<'EOF'\n\n\n(defn ffi-node\n  [op & operands]\n  {:type :dao.stream.apply/call :op op :operands (vec operands)})\n\n\n(defn ffi-program\n  []\n  (app (v 'vector) (lit nil) (ffi-node :op/echo (lit 7)) (lit 2)))\n\n\n(deftest ffi-sent\n  (let [before (until-inst (parity/register-machine (ffi-program)\n                                                  {:env {'vector vector} :ffi-caller-id :caller}) :ffi-call)\n        {:keys [segment pc]} (:control before)\n        rd (second (nth (get-in before [:code segment :vector]) pc))\n        blocked (vm/step before) entry (first (:wait-set blocked)) call-id (:call-id entry)]\n    (is (vm/blocked? blocked))\n    (is (nil? (:control blocked))) (is (nil? (:k blocked)))\n    (is (= [:caller :parked-0] call-id))\n    (is (= :next (:reason entry)))\n    (is (= {1 vector 2 nil} (:window entry)))\n    (is (= {:deliver :rd :rd 3} (:deliver entry)))\n    (is (= rd 3))\n    (is (= (inc pc) (:pc entry)))\n    (is (= (:env before) (:env entry)))\n    (is (= (select-keys (:window before) (analysis/saved (get-in before [:code segment :analysis]) (inc pc) rd))\n           (:window entry)))\n    (is (not-any? #(contains? entry %) [:datom :request-sent :op]))\n    (is (= (select-keys entry [:segment :pc :env :window :k :deliver])\n           (select-keys (get (:parked blocked) call-id) [:segment :pc :env :window :k :deliver])))\n    (let [bridge (ffi/bridge-step (ffi/attach blocked {:op/echo identity}))\n          ready (engine/check-wait-set (:vm bridge))\n          restored (engine/resume-from-run-queue ready sr/register-restore)]\n      (is (:handled? bridge))\n      (is (= (assoc (:window entry) rd 7) (:window restored)))\n      (is (empty? (:parked restored)))\n      (is (= [nil 7 2] (vm/value (vm/run restored)))))))\n\n\n(deftest ffi-retained\n  (let [call-in (:dao.stream/handle (one-slot-stream 1))\n        _ (stream/append\"'! call-in :occupy)\n        before (until-inst (parity/register-machine (ffi-program)\n                                                    {:env {'\"'vector vector} :call-in call-in\n                                                     :call-out (tu/new-stream 8)}) :ffi-call)\n        blocked (vm/step before) entry (first (:wait-set blocked))\n        call-id (:call-id entry) request (:datom entry)]\n    (is (vm/blocked? blocked))\n    (is (= :put (:reason entry)))\n    (is (:request-sent entry))\n    (is (= call-id (apply2/request-id request)))\n    (is (= :op/echo (apply2/request-op request)))\n    (is (= [7] (apply2/request-args request)))\n    (is (= {1 vector 2 nil} (:window entry)))\n    (stream/next call-in 0)\n    (let [ready (engine/check-wait-set blocked)\n          reader-state (engine/resume-from-run-queue ready sr/register-restore)\n          wait (first (:wait-set reader-state))]\n      (is (vm/blocked? reader-state))\n      (is (false? (:halted? reader-state)))\n      (is (nil? (:control reader-state))) (is (nil? (:k reader-state)))\n      (is (= (:window blocked) (:window reader-state)))\n      (is (= :yin/blocked (:value reader-state)))\n      (is (= :next (:reason wait)))\n      (is (= call-id (:call-id wait)))\n      (is (= (select-keys entry [:segment :pc :env :window :k :deliver])\n             (select-keys wait [:segment :pc :env :window :k :deliver])))\n      (is (not-any? #(contains? wait %) [:datom :request-sent :op]))\n      (is (contains? (:parked reader-state) call-id))\n      (is (= request (:dao.stream/value (stream/next call-in 0))))\n      (stream/append\"'! (get (:resources reader-state) vm/call-out-stream-key) (apply2/ok call-id 7))\n      (let [done (vm/run reader-state)]\n        (is (= [nil 7 2] (vm/value done)))\n        (is (empty? (:parked done)))))))\n\n\n(deftest retained-response-route\n  (doseq [carried? [false true]]\n    (let [payload {:segment -1 :pc 3 :env {} :window {1 nil} :k [] :deliver {:deliver :rd :rd 2}}\n          entry (cond-> (assoc payload :request-sent true :call-id :p :reason :put :datom {:request true})\n                  carried? (assoc :response-cursor :custom-cursor :response-stream :custom-stream))\n          base (assoc (sr/create-vm) :parked {:p payload})\n          after (sr/register-restore base entry (:datom entry))\n          wait (first (:wait-set after))]\n      (is (vm/blocked? after))\n      (is (= payload (select-keys wait (keys payload))))\n      (is (= (if carried? :custom-cursor vm/call-out-cursor-key) (get-in wait [:cursor-ref :id])))\n      (is (= (if carried? :custom-stream vm/call-out-stream-key) (:stream-id wait)))\n      (is (= (:parked base) (:parked after)))\n      (is (nil? (:control after)))\n      (is (nil? (:k after))))))\n\n\n(deftest ffi-error-raises\n  (let [blocked (vm/run (parity/register-machine (ffi-node :op/fail (lit 7))))\n        call-id (:call-id (first (:wait-set blocked)))]\n    (stream/append! (get (:resources blocked) vm/call-out-stream-key)\n                    (apply2/error call-id {:dao.stream.apply/code :failed :dao.stream.apply/message \"broken\"}))\n    (is (re-find #\"FFI call failed\" (:message (error #(vm/run blocked)))))))\n\n\n(deftest ffi-response-validation\n  (let [entry {:segment -1 :pc 1 :env {} :window {} :k [] :deliver {:deliver :rd :rd 0} :call-id :p}\n        base (assoc (sr/create-vm) :parked {:p entry})]\n    (is (re-find #\"malformed\" (:message (error #(sr/register-restore base entry :bad)))))\n    (is (re-find #\"correlate\" (:message (error #(sr/register-restore base entry (apply2/ok :other 8)))))))\n    (let [done (sr/register-restore base entry (apply2/ok :p nil))]\n      (is (= {0 nil} (:window done)))\n      (is (empty? (:parked done))))))\n\n\n(deftest ffi-pair-required-before-parking\n  (let [machine (sr/load-ast (sr/create-vm) (vm/ast->datoms (ffi-node :op/echo)) vm/ast-contract)]\n    (is (re-find #\"without an FFI call pair\" (:message (error #(v