dency completeness\n    :obligations (constantly [])},\n   :stack\n''',1)\n p.write_text(s)\np=Path('test/yin/vm/semantic_register/vm_test.cljc');s=p.read_text();s=s[:s.index('\\\\n\\\\n(deftest stage2-deferred-arms')]+ '\\\\n';p.write_text(s)\np=Path('test/yin/vm/semantic_register/parity_test.cljc');s=p.read_text();a=s.index('(defn stage1-eligible?');b=s.index('(defn trace-normalize',a);s=s[:a]+s[b:];s=s.replace('(filter #(stage1-eligible? (second %)) b0/corpus)','b0/corpus').replace('(filter #(stage1-eligible? (second %)) corpus/programs)','corpus/programs').replace('(= 30 (count rows))','(= 32 (count rows))');p.write_text(s)\np=Path('test/yin/vm/semantic_register/walker_trace_test.cljc');s=p.read_text().replace(':current-continuation} op)',':current-continuation :ffi-call} op)').replace('(filter #(parity/stage1-eligible? (second %))\\\\n                     (concat b0/corpus corpus/programs parity/definition-programs))','(concat b0/corpus corpus/programs parity/definition-programs)').replace('(= 61 (count rows))','(= 63 (count rows))').replace('      (is (parity/stage1-eligible? ast))\\\\n','');p.write_text(s)\np=Path('test/yin/vm/semantic_register/effects_test.cljc');s=p.read_text().replace('[dao.stream :as stream]','[dao.stream :as stream]\\\\n            [dao.stream.apply :as apply2]\\\\n            [yin.vm.ffi :as ffi]').replace('      (vm/halted? machine) machine','      (vm/halted? machine) machine\\\\n      (vm/blocked? machine) (throw (ex-info \\\"Continuation value test blocked\\\" {:steps steps}))');p.write_text(s)\nPY\nsed -n '160,208p' test/yin/vm/effect_forgery_test.cljc; sed -n '885,920p' test/yin/vm/semantic_test.cljc; sed -n '195,256p' test/yin/vm/linker_require_test.cljc; sed -n '1088,1120p' test/yin/vm/linker_require_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
