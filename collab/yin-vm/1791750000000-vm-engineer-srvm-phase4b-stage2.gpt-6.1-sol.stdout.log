gister-run-scheduler\n  [machine]\n  (engine/run-loop machine engine/active-continuation? #(vm-hot % nil)\n                   #(engine/resume-from-run-queue % register-restore)))\n                                        module/link-response-resource),\n                    :origin origin,\n                    :ancestry ancestry,\n                    :capability-secret capability-secret,\n                    :secret-source (:secret-source vm),\n                    :attach-stream (:attach-stream vm),\n                    :gc-threshold (:base (:gc vm))})\n                 image\n                 code/contract))\n  (image-identity [_ image] (jing/segment-key image))\n  (image-holds? [_ image segment] (jing/segment-matches? segment image))\n  (attach-module [vm image] (attach-image vm image code/contract))\n  (lift-closure [vm closure encode]\n    (let [local (:segment closure)\n          address (some (fn [[a l]] (when (= l local) a)) (:code-aliases vm))\n          env (:env closure)\n          store-of (engine/env-store-of env)]\n      (when (nil? address)\n        (throw (ex-info \"Closure segment has no address\"\n                        {:yin.k/status :yin.k/non-portable,\n                         :yin.k/kind :unrooted-body,\n                         :segment local})))\n      (cond-> {:yin.k/tag :yin.k/closure,\n               :yin.k/binding :named,\n               :yin.k/format :yin.semantic-register/code,\n               :yin.k/segment address,\n               :yin.k/entry (:entry closure),\n               :yin.k/params (:params closure),\n               :yin.k/env (into {}\n                                (map (fn [[k x]] [k (encode x)]))\n                                (engine/without-store-of env))}\n        store-of (assoc :yin.k/store-of store-of))))\n  (lower-closure [vm marker decode]\n    (when-not (and (= :named (:yin.k/binding marker))\n                   (= :yin.semantic-register/code (:yin.k/format marker)))\n      (throw (ex-info \"Closure binding or format does not match this kernel\" {:reason :binding-mismatch :marker marker})))\n    (let [local (get (:code-aliases vm) (:yin.k/segment marker))\n          entry (:yin.k/entry marker)\n          store-of (:yin.k/store-of marker)]\n      ;; An entry outside the attached image names no code of it either.\n      (when-not (and (some? local)\n                     (nat-int? entry)\n                     (< entry (count (get-in vm [:code local :vector]))))\n        (throw (ex-info \"Closure origin image is not attached\"\n                        {:reason :origin-not-attached,\n                         :segment (:yin.k/segment marker)})))\n      ;; the binders are those of a `:closure` (4) of the attached image\n      ;; whose entry this is, never the wire's\n      (vm/check-params! (:yin.k/params marker))\n      (when-not (some (fn [inst]\n                        (and (= :closure (nth inst 0))\n                             (= entry (nth inst 3))\n                             (= (:yin.k/params marker) (nth inst 2))))\n                      (get-in vm [:code local :vector]))\n        (engine/marker-mismatch! marker))\n      (values/closure\n        (:owner vm)\n        {:type :closure,\n         :params (:yin.k/params marker),\n         :entry entry,\n         :segment local,\n         :env (cond-> (into {}\n                            (map (fn [[k x]] [k (decode x)]))\n                            (:yin.k/env marker))\n                store-of (assoc engine/store-of-key store-of))})))\n  (gc-roots [machine]\n    {:kernel [(:control machine) (:k machine)]\n     :values [(:env machine) (:window machine) (:value machine)]})\n  (gc-children [_ _x] nil))\n src/cljc/yin/vm/semantic_register.cljc             | 156 +++++++++++++++++----\n test/yin/vm/continuation_invoke_test.cljc          |   5 +-\n test/yin/vm/ffi_test.cljc                          |   5 +-\n test/yin/vm/linker_require_test.cljc               |  11 +-\n test/yin/vm/rule_r_test.cljc                       |   8 +-\n test/yin/vm/semantic_register/effects_test.cljc    | 134 ++++++++++++++++++\n test/yin/vm/semantic_register/parity_test.cljc     | 109 ++++++++++++--\n test/yin/vm/semantic_register/vm_test.cljc         |   7 -\n .../vm/semantic_register/walker_trace_test.cljc    |  15 +-\n 9 files changed, 396 insertions(+), 54 deletions(-)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"cat > /private/tmp/srvm-stage2-mutants.py <<'PY'\nfrom pathlib import Path\nimport subprocess,time,hashlib,json,re\np=Path('src/cljc/yin/vm/semantic_register.cljc'); original=p.read_bytes(); s=original.decode()\nmutants=[\n('wrong-rd','(assoc (:window entry) (get-in entry [:deliver :rd]) value)','(assoc (:window entry) 999 value)'),\n('save-too-much',':window (select-keys W (analysis/saved facts (inc pc) rd))',':window W'),\n('save-too-little',':window (select-keys W (analysis/saved facts (inc pc) rd))',':window {}'),\n('tail-restores-window','(if tail? (tail-builders seg pc K)','(if tail? (act-builders seg pc E W K rd (:analysis image))'),\n('deliver-twice','(assoc (:window entry) (get-in entry [:deliver :rd]) value)','(assoc (:window entry) (get-in entry [:deliver :rd]) value 999 value)'),\n('invoke-keeps-K','(:env restored) (or (:k restored) []) remaining))))','(:env restored) K remaining))))'),\n('window-not-root',':values [(:env machine) (:window machine) (:value machine)]',':values [(:env machine) (:value machine)]'),\n('retained-delivers','(if (:request-sent entry)','(if false'),\n('link-loses-delivery',':module/require (fn [_state _effect _result] payload)',':module/require (fn [_state _effect _result] (dissoc payload :deliver))'),\n('call-id-not-removed','base (if call-id (update base :parked dissoc call-id) base)','base base'),\n('decode-before-retained','(if (:request-sent entry)','(if (do (when (:call-id entry) (ffi/call-result value (:call-id entry))) (:request-sent entry))'),\n('decode-omitted','value (if call-id (ffi/call-result value call-id) value)','value value'),\n('carried-route-ignored','(and (:response-cursor entry) (:response-stream entry))','false'),\n('sent-reader-loses-window','(ffi/response-wait-entry payload call-id)','(ffi/response-wait-entry (dissoc payload :window) call-id)'),\n('install-loader-validation-bypassed','                 image\\\\n                 code/contract))','                 [[:const 0 nil] [:halt 0]]\\\\n                 code/contract))'),\n('marker-params-not-checked','(= (:yin.k/params marker) (nth inst 2))','true'),\n('marker-entry-not-checked','(= entry (nth inst 3))','true'),\n('marker-format-not-checked','(= :yin.semantic-register/code (:yin.k/format marker))','true'),\n('M-P','(engine/check-callee-effect\"'!'\"\\\\n                                                (put-registers machine seg pc W E K) f result)','(put-registers machine seg pc W E K)'),\n('decode-remove-order-swapped','base (if call-id (update base :parked dissoc call-id) base)\\\\n           value (if call-id (ffi/call-result value call-id) value)','value (if call-id (ffi/call-result value call-id) value)\\\\n           base (if call-id (update base :parked dissoc call-id) base)')]\nresults=[]\nfor name,old,new in mutants:\n assert s.count(old)==1,(name,s.count(old))\n try:\n  p.write_text(s.replace(old,new));start=time.monotonic()\n  r=subprocess.run(['clojure','-M:test','-n','yin.vm.semantic-register.effects-test','-n','yin.vm.semantic-register.link-test','-n','yin.vm.semantic-register.vm-test'],capture_output=True,text=True,timeout=90)\n  output=r.stdout+r.stderr;Path('/private/tmp/srvm-s2-'+name+'.log').write_text(output)\n  result={'name':name,'exit':r.returncode,'seconds':round(time.monotonic()-start,2),'tests':re.findall(r'Ran .*|\\\\d+ failures, \\\\d+ errors\\\\.',output),'failed':sorted(set(re.findall(r'(?:FAIL|ERROR) in \\\\(([\"'^)]+)'\"\\\\)',output)))}\n  results.append(result);print(json.dumps(result),flush=True)\n finally:\n  p.write_bytes(original);assert p.read_bytes()==original\nPath('/private/tmp/srvm-stage2-mutants.json').write_text(json.dumps(results,indent=2))\nprint('RESTORED',hashlib.sha256(original).hexdigest(),flush=True)\nPY\npython3 /private/tmp/srvm-stage2-mutants.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
