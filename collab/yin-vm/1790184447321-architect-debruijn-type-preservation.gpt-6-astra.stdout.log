{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/debruijn.cljc | sed -n '1130,1375p'; cat docs/agents/build-n-test.md; cat deps.edn; cat package.json\"","aggregated_output":"  1130\t                           (doseq [child v] (walk child))\n  1131\t                           (walk v)))))\n  1132\t                   (when (= h fingerprint)\n  1133\t                     (emit! e :yin.debruijn/root true)))))]\n  1134\t    (walk fingerprint)\n  1135\t    @out))\n  1136\t\n  1137\t\n  1138\t(def ^:private record-attributes\n  1139\t  \"Every attribute a projected record entity may carry: the declared\n  1140\t   dimension slots, markers included.\"\n  1141\t  (into #{} (map first) dimension-slots))\n  1142\t\n  1143\t\n  1144\t(defn- slot-shape-ok?\n  1145\t  \"Whether `v` fits the descriptor `type` on a projected record: the\n  1146\t   deterministic gate the storage reader hashes behind, so a wrongly\n  1147\t   typed slot — :yin.debruijn/bound 5, a numeric child ref — diagnoses\n  1148\t   :unsupported-value instead of reaching host arithmetic inside the\n  1149\t   hash recomputation.\"\n  1150\t  [type v]\n  1151\t  (cond\n  1152\t    (= :canonical type) (canonical-value? v)\n  1153\t    (= :keyword type) (keyword? v)\n  1154\t    (= :symbol type) (symbol? v)\n  1155\t    (= :string type) (string? v)\n  1156\t    (= :bool type) (or (true? v) (false? v))\n  1157\t    (= :int64 type) (and (number? v) (= :int64 (numeric-class v)))\n  1158\t    (or (= :ref type) (= :hash type)) (and (string? v)\n  1159\t                                           (re-matches #\"^[0-9a-f]{64}$\" v))\n  1160\t    (and (vector? type) (= :tuple (first type)))\n  1161\t    (and (vector? v)\n  1162\t         (= (count v) (count (rest type)))\n  1163\t         (every? true? (map slot-shape-ok? (rest type) v)))\n  1164\t    (vector? type) (and (vector? v) (every? #(slot-shape-ok? :ref %) v))\n  1165\t    :else false))\n  1166\t\n  1167\t\n  1168\t(defn- projected-slots-of\n  1169\t  \"The projected slots one §2 grammar attribute becomes (§4): the binder\n  1170\t   :yin/params becomes :arity, an occurrence's :yin/name becomes one of\n  1171\t   :bound or :free, and every other attribute keeps its name under\n  1172\t   :yin.debruijn.\"\n  1173\t  [attr]\n  1174\t  (case attr\n  1175\t    :yin/params [:yin.debruijn/arity]\n  1176\t    :yin/name [:yin.debruijn/bound :yin.debruijn/free]\n  1177\t    [(keyword \"yin.debruijn\" (name attr))]))\n  1178\t\n  1179\t\n  1180\t(def ^:private record-slots\n  1181\t  \"Per node type, every slot its projected record may carry besides\n  1182\t   :yin.debruijn/hash — derived from `node-grammar`, so the reader's\n  1183\t   grammar and the walk's are one table. The preimage frames slots by\n  1184\t   type tag, not name, so this check is what keeps a slot renamed within\n  1185\t   one type (:free to :key on a :variable, :arity to :buffer) from\n  1186\t   passing under a valid address.\"\n  1187\t  (into {}\n  1188\t        (map (fn [[tag {:keys [scalars children]}]]\n  1189\t               [tag (into #{:yin.debruijn/type}\n  1190\t                          (mapcat (comp projected-slots-of first))\n  1191\t                          (concat scalars children))]))\n  1192\t        node-grammar))\n  1193\t\n  1194\t\n  1195\t(def ^:private optional-record-slots\n  1196\t  \"The record slots a writer may leave absent: :macro? (only a true one\n  1197\t   is written) and :bound/:free, of which a :variable carries exactly\n  1198\t   one.\"\n  1199\t  #{:yin.debruijn/macro? :yin.debruijn/bound :yin.debruijn/free})\n  1200\t\n  1201\t\n  1202\t(defn- canonical-spelling?\n  1203\t  \"Whether `v` is already its own canonical spelling — the form\n  1204\t   `canonical-value` gives every stored scalar. Exact, never =: Dart's\n  1205\t   1 == 1.0 and Clojure's = across a set's members would pass a stored\n  1206\t   1.0 whose address is 1's, and the reader would hand back a record no\n  1207\t   writer produces. A JS number carries one spelling per value, so every\n  1208\t   in-domain number is canonical there.\"\n  1209\t  [v]\n  1210\t  (case (canonical-class v)\n  1211\t    (:nil :bool :bytes) true\n  1212\t    :int64 #?(:cljs true :default (int? v))\n  1213\t    ;; :cljd first: the ClojureDart host pass also reads :clj\n  1214\t    :double #?(:cljd true :clj (instance? Double v) :cljs true)\n  1215\t    :string (= v (normalize-nfc v))\n  1216\t    (:keyword :symbol) (and (or (nil? (namespace v))\n  1217\t                                (= (namespace v) (normalize-nfc (namespace v))))\n  1218\t                            (= (name v) (normalize-nfc (name v))))\n  1219\t    :map (every? (fn [[k x]] (and (canonical-spelling? k) (canonical-spelling? x))) v)\n  1220\t    (:set :vector :list) (every? canonical-spelling? v)\n  1221\t    false))\n  1222\t\n  1223\t\n  1224\t(defn- check-record\n  1225\t  \"The reader's record gate, after every slot fits its declared shape:\n  1226\t   the record's type is a grammar type, it carries exactly its type's\n  1227\t   slots (a :variable exactly one of :bound/:free, a :macro? only when\n  1228\t   true), and every scalar is its canonical spelling. Everything here is\n  1229\t   what the writer already guarantees, so no minted hash moves.\"\n  1230\t  [record e]\n  1231\t  (let [tag (get record :yin.debruijn/type)\n  1232\t        allowed (or (get record-slots tag)\n  1233\t                    (throw (ex-info \"Projected record has an unknown node type\"\n  1234\t                                    {:rule :unknown-node-type, :type tag, :entity e})))\n  1235\t        present (disj (set (keys record)) :yin.debruijn/hash)]\n  1236\t    (doseq [slot present]\n  1237\t      (when-not (contains? allowed slot)\n  1238\t        (throw (ex-info \"Projected slot is outside its node type's grammar row\"\n  1239\t                        {:rule :unknown-attribute,\n  1240\t                         :attribute slot,\n  1241\t                         :type tag,\n  1242\t                         :entity e}))))\n  1243\t    (doseq [slot allowed]\n  1244\t      (when-not (or (contains? present slot)\n  1245\t                    (contains? optional-record-slots slot))\n  1246\t        (throw (ex-info \"Projected record lacks a required slot\"\n  1247\t                        {:rule :missing-slot, :slot slot, :type tag, :entity e}))))\n  1248\t    (when (and (= :variable tag)\n  1249\t               (not= 1 (count (filter #(contains? present %)\n  1250\t                                      [:yin.debruijn/bound :yin.debruijn/free]))))\n  1251\t      (throw (ex-info \"A projected :variable carries exactly one of :bound and :free\"\n  1252\t                      {:rule :missing-slot,\n  1253\t                       :slot [:yin.debruijn/bound :yin.debruijn/free],\n  1254\t                       :type tag,\n  1255\t                       :entity e})))\n  1256\t    (doseq [[slot _type role] dimension-slots\n  1257\t            :when (and (= :scalar role) (contains? record slot))]\n  1258\t      (let [v (get record slot)]\n  1259\t        (when-not (and (canonical-spelling? v)\n  1260\t                       ;; the writer spells a false :macro? by its absence\n  1261\t                       (not (and (= :yin.debruijn/macro? slot) (false? v))))\n  1262\t          (throw (ex-info \"Projected scalar is not its canonical spelling\"\n  1263\t                          {:rule :noncanonical-value,\n  1264\t                           :slot slot,\n  1265\t                           :value v,\n  1266\t                           :entity e})))))))\n  1267\t\n  1268\t\n  1269\t(defn datoms->projected\n  1270\t  \"The d5 storage adapter's read half (§4): projected datoms back to\n  1271\t   {:fingerprint h, :records {h record}} — the inverse of\n  1272\t   `projected->datoms` over the record set (the resolved :root graph is\n  1273\t   the named side's, never rebuilt here). Every entity must carry its\n  1274\t   :yin.debruijn/hash; exactly one entity is the :yin.debruijn/root\n  1275\t   marker and its hash is the fingerprint; every slot must fit its\n  1276\t   declared shape BEFORE its hash is recomputed — a wrongly typed slot\n  1277\t   diagnoses :unsupported-value, never a host exception; each record must\n  1278\t   then be one its writer can produce — its type's grammar slots only\n  1279\t   (:unknown-node-type, :unknown-attribute, :missing-slot), every scalar\n  1280\t   in its canonical spelling (:noncanonical-value) — because the\n  1281\t   preimage frames slots by type tag, not name, and equal encodings do\n  1282\t   not mean equal spellings; child refs must resolve to records;\n  1283\t   :yin.debruijn/operands must be one vector of hashes. Each record is\n  1284\t   re-hashed and a disagreement is a\n  1285\t   :hash-mismatch diagnostic — content addressing is verified at this\n  1286\t   boundary, never trusted. t, m, and other namespaces are layout,\n  1287\t   ignored.\"\n  1288\t  [datoms]\n  1289\t  (let [datoms (vec datoms)\n  1290\t        index (index-frame \"yin.debruijn\" datoms)\n  1291\t        markers (into []\n  1292\t                      (comp (filter #(= :yin.debruijn/root (nth % 1)))\n  1293\t                            (filter #(true? (nth % 2)))\n  1294\t                            (map first))\n  1295\t                      datoms)\n  1296\t        _ (when-not (= 1 (count markers))\n  1297\t            (throw (ex-info \"Projected datoms have not exactly one root marker\"\n  1298\t                            (if (zero? (count markers))\n  1299\t                              {:rule :missing-root}\n  1300\t                              {:rule :multiple-roots, :roots markers}))))\n  1301\t        root-e (first markers)\n  1302\t        records (reduce-kv (fn [recs e facts]\n  1303\t                             (let [h (or (when (contains? facts :yin.debruijn/hash)\n  1304\t                                           (get facts :yin.debruijn/hash))\n  1305\t                                         (throw (ex-info\n  1306\t                                                  \"Projected entity carries no :yin.debruijn/hash\"\n  1307\t                                                  {:rule :missing-hash, :entity e})))\n  1308\t                                   record (dissoc facts :yin.debruijn/root)]\n  1309\t                               (doseq [a (keys record)]\n  1310\t                                 (when-not (contains? record-attributes a)\n  1311\t                                   (throw (ex-info\n  1312\t                                            \"Unknown :yin.debruijn/* attribute on a projected record\"\n  1313\t                                            {:rule :unknown-attribute,\n  1314\t                                             :attribute a,\n  1315\t                                             :entity e}))))\n  1316\t                               (when-not (and (string? h)\n  1317\t                                              (re-matches #\"^[0-9a-f]{64}$\" h))\n  1318\t                                 (throw (ex-info \"Projected hash is not 64 lowercase hex\"\n  1319\t                                                 {:rule :malformed-hash,\n  1320\t                                                  :hash h,\n  1321\t                                                  :entity e})))\n  1322\t                               (doseq [[slot type role] dimension-slots\n  1323\t                                       :when (and (not= :marker role)\n  1324\t                                                  (contains? record slot))]\n  1325\t                                 (when-not (slot-shape-ok? type (get record slot))\n  1326\t                                   (throw (ex-info\n  1327\t                                            \"Projected slot value does not fit its declared type\"\n  1328\t                                            {:rule :unsupported-value,\n  1329\t                                             :slot slot,\n  1330\t                                             :value (get record slot),\n  1331\t                                             :entity e}))))\n  1332\t                               (check-record record e)\n  1333\t                               (if (contains? recs h)\n  1334\t                                 (throw (ex-info\n  1335\t                                          \"Two entities claim one projected hash\"\n  1336\t                                          {:rule :duplicate-fact,\n  1337\t                                           :attribute :yin.debruijn/hash,\n  1338\t                                           :entity e}))\n  1339\t                                 (do (when-not (= h (node-hash (slot-encodings record)))\n  1340\t                                       (throw (ex-info\n  1341\t                                                \"Projected record does not hash to its address\"\n  1342\t                                                {:rule :hash-mismatch,\n  1343\t                                                 :hash h,\n  1344\t                                                 :entity e})))\n  1345\t                                     (assoc recs h record)))))\n  1346\t                           {}\n  1347\t                           index)\n  1348\t        fingerprint (get-in index [root-e :yin.debruijn/hash])]\n  1349\t    (doseq [[h record] records\n  1350\t            [slot type role] dimension-slots\n  1351\t            :when (and (= :child role) (contains? record slot))]\n  1352\t      (let [refs (if (and (vector? type) (= :ordered-vector (first type)))\n  1353\t                   (let [v (get record slot)]\n  1354\t                     (when-not (vector? v)\n  1355\t                       (throw (ex-info\n  1356\t                                \"Projected :yin.debruijn/operands is not an ordered vector\"\n  1357\t                                {:rule :unsupported-value,\n  1358\t                                 :slot slot,\n  1359\t                                 :value v,\n  1360\t                                 :hash h})))\n  1361\t                     v)\n  1362\t                   [(get record slot)])]\n  1363\t        (doseq [ref refs]\n  1364\t          (when-not (contains? records ref)\n  1365\t            (throw (ex-info \"Projected child hash resolves to no record\"\n  1366\t                            {:rule :dangling-ref, :hash ref, :via h, :slot slot}))))))\n  1367\t    {:fingerprint fingerprint, :records records}))\n  1368\t\n  1369\t\n  1370\t;; =============================================================================\n  1371\t;; D4: the dao.stream forward adapter (§6)\n  1372\t;; =============================================================================\n  1373\t\n  1374\t(def forward-default-options\n  1375\t  \"Defaults for `forward-step`: one read or one write per call, terminal\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # Run all tests (JVM, Node/CLJS, Dart/CLJD)\nbb test:clj          # JVM tests only (or: clj -M:test)\nbb test:cljs         # ClojureScript / Node tests (via shadow-cljs :cljs alias)\nbb test:cljd         # ClojureDart tests (requires flutter on PATH)\nnpm test             # Node.js tests\n\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\n\n# ClojureDart\nclj -M:cljd compile\n\n# Linting\nclj -M:kondo --lint <path>\n```\n\n`bb test:cljd`'s `dart test` globs everything under `test/cljd-out/`,\nwhich the cljd compile does not prune when a source file is deleted or\nrenamed. A stale compiled `.dart` test for an already-deleted namespace\ncan silently pass, giving a false-clean run. Run `rm -rf test/cljd-out`\nbefore any `bb test:cljd` you're relying on to prove a deletion (or\nsimilar rename/removal) actually took effect.\n\n## Testing Philosophy & TDD\n\nWrite tests before implementing features (TDD).\n\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\n\nWhen implementing a feature or fix:\n1. **Red phase**: Write the test first — define what should happen.\n2. **Green phase**: Implement the minimum code to pass the test.\n3. **Refactor phase**: Refactor if needed while keeping tests green.\n\nThis ensures code is testable by design and implementation matches actual requirements.\n\n## Debugging Malformed CLJ / EDN / CLJS\n\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\n\n1. **Run clj-kondo first**:\n   ```sh\n   clj -M:kondo --lint path/to/file.cljs\n   ```\n\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\n\n3. **Fix one bracket at a time, re-run checker after each fix**:\n   Common patterns:\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\n   - Both can coexist while total bracket count is zero-sum.\n\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\n{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}}\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           :cljd {:extra-paths [\"test\"]\n                  :extra-deps {tensegritics/clojuredart\n                               {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                                :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"shadow.cljs.devtools.cli\" \"run\" \"yin.repl/-main\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl\n           {:extra-deps {tensegritics/clojuredart\n                         {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                          :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n            :main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:extra-deps {tensegritics/clojuredart\n                         {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                          :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n            :main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.repl\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yang.python-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine\n{\n  \"name\": \"datomworld\",\n  \"version\": \"0.0.1\",\n  \"private\": true,\n  \"devDependencies\": {\n    \"shadow-cljs\": \"3.3.5\"\n  },\n  \"dependencies\": {\n    \"@codemirror/lang-php\": \"^6.0.2\",\n    \"@codemirror/lang-python\": \"^6.2.1\",\n    \"@codemirror/theme-one-dark\": \"^6.1.3\",\n    \"@nextjournal/lang-clojure\": \"^1.0.0\",\n    \"@noble/hashes\": \"2.4.0\",\n    \"codemirror\": \"^6.0.2\",\n    \"ol\": \"^6.6.1\",\n    \"punycode\": \"^2.3.1\",\n    \"react\": \"^17.0.2\",\n    \"react-dom\": \"^17.0.2\",\n    \"ws\": \"^8.18.0\"\n  },\n  \"description\": \"A world built on data\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\"\n}\n","exit_code":0,"status":"completed"}}
