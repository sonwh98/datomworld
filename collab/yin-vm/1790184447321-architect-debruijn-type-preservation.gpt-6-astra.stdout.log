{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/debruijn.cljc | sed -n '680,1120p'\"","aggregated_output":"   680\t                           :yin.debruijn/key (get scalar :yin/key)})\n   681\t      :vm/store-put (leaf {:yin.debruijn/type :vm/store-put,\n   682\t                           :yin.debruijn/value (get scalar :yin/value),\n   683\t                           :yin.debruijn/key (get scalar :yin/key)})\n   684\t      :vm/current-continuation (leaf {:yin.debruijn/type :vm/current-continuation})\n   685\t      :vm/park (leaf {:yin.debruijn/type :vm/park})\n   686\t      :vm/resume (child (leaf {:yin.debruijn/type :vm/resume,\n   687\t                               :yin.debruijn/parked-id (get scalar :yin/parked-id)})\n   688\t                        :yin.debruijn/val-node\n   689\t                        :yin/val-node\n   690\t                        stack)\n   691\t      :stream/make (leaf {:yin.debruijn/type :stream/make,\n   692\t                          :yin.debruijn/buffer (get scalar :yin/buffer)})\n   693\t      :stream/put (-> (leaf {:yin.debruijn/type :stream/put})\n   694\t                      (child :yin.debruijn/target :yin/target stack)\n   695\t                      (child :yin.debruijn/val-node :yin/val-node stack))\n   696\t      (:stream/cursor :stream/next :stream/close)\n   697\t      (child (leaf {:yin.debruijn/type tag})\n   698\t             :yin.debruijn/source\n   699\t             :yin/source\n   700\t             stack))))\n   701\t\n   702\t\n   703\t(defn- project-node\n   704\t  \"Project and hash-cons one source node under `stack`, memoized by\n   705\t   [source-eid stack] — §2's [source-eid lexical-context] key, where the\n   706\t   lexical context is the complete stack of frame parameter vectors.\n   707\t   Returns [node h acc']. The memo carries the resolved node AND its\n   708\t   hash, so a shared occurrence is resolved and hashed once: without the\n   709\t   hash in the memo, a doubling chain of shared subgraphs is minted once\n   710\t   per unfolded path, exponentially. The memo is an optimisation only:\n   711\t   it is threaded explicitly in `acc` and can never affect output\n   712\t   identity. Cycle detection runs before the memo, so an eid on the\n   713\t   active path is a diagnostic even if it was memoized at another\n   714\t   occurrence.\"\n   715\t  [index eid stack acc active path]\n   716\t  (if (contains? active eid)\n   717\t    (throw (ex-info \"Cyclic AST reference\"\n   718\t                    {:rule :cycle, :entity eid, :path path}))\n   719\t    (if-let [cached (find (:memo acc) [eid stack])]\n   720\t      (let [[node h] (val cached)]\n   721\t        [node h acc])\n   722\t      (let [facts (node-facts index eid path)\n   723\t            tag (get facts :yin/type)\n   724\t            grammar (or (get node-grammar tag)\n   725\t                        (throw (ex-info \"Unknown AST node type in projection\"\n   726\t                                        {:rule :unknown-node-type,\n   727\t                                         :type tag,\n   728\t                                         :entity eid,\n   729\t                                         :path path})))\n   730\t            _ (check-attributes tag facts eid path)\n   731\t            scalar (validated-scalars tag grammar facts eid path)\n   732\t            [node refs acc'] (build-node tag\n   733\t                                         index\n   734\t                                         facts\n   735\t                                         scalar\n   736\t                                         eid\n   737\t                                         stack\n   738\t                                         acc\n   739\t                                         (conj active eid)\n   740\t                                         path)\n   741\t            [h acc''] (mint-record node refs acc')]\n   742\t        [node h (assoc-in acc'' [:memo [eid stack]] [node h])]))))\n   743\t\n   744\t\n   745\t;; =============================================================================\n   746\t;; D2: the canonical encoder and node hashes (§5)\n   747\t;; =============================================================================\n   748\t\n   749\t(def ^:private hex-digit-chars \"0123456789abcdef\")\n   750\t\n   751\t\n   752\t(defn- to-hex\n   753\t  \"Width-padded lowercase hex of the non-negative integer n.\"\n   754\t  [n width]\n   755\t  (let [base (if (zero? n)\n   756\t               \"0\"\n   757\t               (loop [n n, acc \"\"]\n   758\t                 (if (zero? n)\n   759\t                   acc\n   760\t                   (recur (unsigned-bit-shift-right n 4)\n   761\t                          (str (nth hex-digit-chars (bit-and n 0xf)) acc)))))\n   762\t        padded (str (apply str (repeat width \"0\")) base)]\n   763\t    (subs padded (- (count padded) width))))\n   764\t\n   765\t\n   766\t(def ^:private slot-tag\n   767\t  \"The settled tag byte (hex) each canonical class and compound slot type\n   768\t   renders under. Class tags are the class's index in the value table's\n   769\t   declared :classes order — read through the descriptor — and the\n   770\t   compound types (child refs, the fixed pair, the ordered vector) take\n   771\t   bytes outside that range.\"\n   772\t  (into {:ref \"c0\", :hash \"c1\", :tuple \"c2\", :ordered-vector \"c3\"}\n   773\t        (map-indexed (fn [i class] [class (to-hex i 2)]))\n   774\t        (:classes canonical-value-table)))\n   775\t\n   776\t\n   777\t;; code-unit-at lives with the D0 classifier: well-formed-utf16? reads\n   778\t;; code units there, before any encoder definition.\n   779\t\n   780\t\n   781\t(defn- utf8-byte-length\n   782\t  \"The byte length of `s` under UTF-8, from its code units: a surrogate\n   783\t   pair is one 4-byte sequence, never two 3-byte ones, and an unpaired\n   784\t   surrogate — which the classifier has already refused — would be the\n   785\t   3-byte replacement character. Pure arithmetic over code units, so\n   786\t   every host agrees without encoding anything.\"\n   787\t  [s]\n   788\t  (let [unit-length (fn [c]\n   789\t                      (cond (< c 0x80) 1\n   790\t                            (< c 0x800) 2\n   791\t                            :else 3))\n   792\t        n (count s)]\n   793\t    (loop [i 0, total 0]\n   794\t      (if (>= i n)\n   795\t        total\n   796\t        (let [c (code-unit-at s i)]\n   797\t          (if (and (<= 0xD800 c 0xDBFF)\n   798\t                   (< (inc i) n)\n   799\t                   (<= 0xDC00 (code-unit-at s (inc i)) 0xDFFF))\n   800\t            (recur (+ i 2) (+ total 4))\n   801\t            (recur (inc i) (+ total (unit-length c)))))))))\n   802\t\n   803\t\n   804\t(defn- framed\n   805\t  \"One self-delimiting encoded part: the class's tag byte, the 8-hex byte\n   806\t   length of the content, and the content. §5's tagged, length-delimited\n   807\t   framing with the settled rule that lengths count UTF-8 bytes — the\n   808\t   preimage is carried as text whose UTF-8 bytes are the hashed stream,\n   809\t   so a byte-count prefix keeps the framing's extents on that stream.\"\n   810\t  [class content]\n   811\t  (str (get slot-tag class) (to-hex (utf8-byte-length content) 8) content))\n   812\t\n   813\t\n   814\t(defn- int64-le-hex\n   815\t  \"The settled int64 byte rule: 8 bytes, two's complement, little-endian\n   816\t   (datom.md). Exact host integers go through bit ops; a :cljs number —\n   817\t   which the classifier only lets here as a safe integer — decomposes\n   818\t   exactly through floor and mod by 2^32, whose low bytes survive the\n   819\t   host's 32-bit bit ops.\"\n   820\t  [v]\n   821\t  #?(:cljs (let [lo (mod v 4294967296)\n   822\t                 hi (js/Math.floor (/ v 4294967296))\n   823\t                 byte-at (fn [x i]\n   824\t                           (to-hex (bit-and (unsigned-bit-shift-right x (* i 8))\n   825\t                                            0xff)\n   826\t                                   2))]\n   827\t             (apply str (map #(byte-at (if (< % 4) lo hi) (mod % 4)) (range 8))))\n   828\t     :default (let [n (long v)]\n   829\t                (apply str (map #(to-hex (bit-and (unsigned-bit-shift-right n (* % 8)) 0xff) 2)\n   830\t                                (range 8))))))\n   831\t\n   832\t\n   833\t(defn- double-le-hex\n   834\t  \"The settled :double byte rule: the IEEE-754 bits, little-endian, with\n   835\t   every NaN the one quiet encoding 7ff8000000000000 regardless of the\n   836\t   payload a host happens to hold. :clj reads the bits through\n   837\t   doubleToLongBits, :cljs through a DataView store with littleEndian\n   838\t   explicitly true, :cljd through a big-endian ByteData store read in\n   839\t   reverse — the endianness is stated, never the platform's default.\"\n   840\t  [v]\n   841\t  (if (not= v v)\n   842\t    \"000000000000f87f\"\n   843\t    #?(:clj (int64-le-hex (Double/doubleToLongBits (double v)))\n   844\t       :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\n   845\t               (.setFloat64 view 0 v true)\n   846\t               (apply str (map #(to-hex (.getUint8 view %) 2) (range 8))))\n   847\t       :cljd (let [bd (ByteData. 8)]\n   848\t               (.setFloat64 bd 0 v)\n   849\t               (apply str (map #(to-hex (.getUint8 bd %) 2) (range 7 -1 -1)))))))\n   850\t\n   851\t\n   852\t(defn- ident-content\n   853\t  \"§5 keywords and symbols encode namespace and name separately, each\n   854\t   through the NFC seam — the value table declares :nfc-utf-8 for both\n   855\t   parts; an absent namespace has nil's own framing, never an empty\n   856\t   string's.\"\n   857\t  [x]\n   858\t  (str (if-let [ns (namespace x)]\n   859\t         (framed :string (normalize-nfc ns))\n   860\t         (framed :nil \"\"))\n   861\t       (framed :string (normalize-nfc (name x)))))\n   862\t\n   863\t\n   864\t(defn encode-value\n   865\t  \"Encode one canonical-domain value under its value-table class: the\n   866\t   full tagged, length-delimited part, under the settled D3 byte rules —\n   867\t   int64 little-endian two's complement for integers, IEEE-754 bits with\n   868\t   one quiet-NaN encoding for doubles (1 and 1.0 stay distinct), UTF-8 byte\n   869\t   lengths, NFC strings and ident parts. Maps and sets sort by their encoded\n   870\t   parts, the Section 5 order rule; vectors and lists are the distinct classes\n   871\t   the D0 ruling split. An out-of-domain value is a diagnostic.\"\n   872\t  [v]\n   873\t  (let [class (canonical-class v)]\n   874\t    (case class\n   875\t      :nil (framed :nil \"\")\n   876\t      :bool (framed :bool (if v \"01\" \"00\"))\n   877\t      :int64 (framed :int64 (int64-le-hex v))\n   878\t      :double (framed :double (double-le-hex v))\n   879\t      :string (framed :string (normalize-nfc v))\n   880\t      :bytes (framed :bytes (apply str (map #(to-hex (bit-and % 0xff) 2) v)))\n   881\t      :keyword (framed :keyword (ident-content v))\n   882\t      :symbol (framed :symbol (ident-content v))\n   883\t      :map (let [entries (sort (map (fn [[k x]]\n   884\t                                      [(encode-value k) (encode-value x)])\n   885\t                                    v))]\n   886\t             (when (some (fn [[a b]] (= (first a) (first b)))\n   887\t                         (partition 2 1 entries))\n   888\t               (throw (ex-info \"Map keys collide in canonical encoding\"\n   889\t                               {:rule :unsupported-value, :value v})))\n   890\t             (framed :map (apply str (mapcat identity entries))))\n   891\t      :set (let [elements (sort (map encode-value v))]\n   892\t             (when (some (fn [[a b]] (= a b)) (partition 2 1 elements))\n   893\t               (throw (ex-info \"Set elements collide in canonical encoding\"\n   894\t                               {:rule :unsupported-value, :value v})))\n   895\t             (framed :set (apply str elements)))\n   896\t      :vector (framed :vector (apply str (map encode-value v)))\n   897\t      :list (framed :list (apply str (map encode-value v)))\n   898\t      (throw (ex-info \"Unsupported value in Merkle encoding\"\n   899\t                      {:rule :unsupported-value, :value v})))))\n   900\t\n   901\t\n   902\t(defn- encode-typed\n   903\t  \"Encode one descriptor slot's value under its declared type:\n   904\t   :canonical is polymorphic, the compound types frame their parts, and\n   905\t   a declared scalar type encodes by its (already validated) value\n   906\t   class.\"\n   907\t  [type v]\n   908\t  (cond\n   909\t    (= :canonical type) (encode-value v)\n   910\t    (vector? type) (if (= :tuple (first type))\n   911\t                     (framed :tuple (apply str (map encode-typed (rest type) v)))\n   912\t                     (framed :ordered-vector\n   913\t                             (str (framed :int64 (int64-le-hex (count v)))\n   914\t                                  (apply str (map #(encode-typed :ref %) v)))))\n   915\t    (or (= :ref type) (= :hash type)) (framed :ref v)\n   916\t    :else (encode-value v)))\n   917\t\n   918\t\n   919\t(def dimension-hash\n   920\t  \"The published hash domain separator (§4): the descriptor data encoded\n   921\t   through the settled canonical encoder and hashed, per datom.md's 'the\n   922\t   content hash of this subgraph IS the dimension's identity'. D0-D2\n   923\t   minted a transitional dao.jing digest; D3 re-pins it here over the\n   924\t   settled byte rules. The descriptor content is unchanged — only the\n   925\t   digest's derivation moved to the canonical encoder, so the separator\n   926\t   now separates this dimension from every other by the same bytes every\n   927\t   node hash uses.\"\n   928\t  (jing/sha256 (encode-value descriptor)))\n   929\t\n   930\t\n   931\t(defn canonical-value\n   932\t  \"A record's stored scalar is its canonical spelling (the carried D3\n   933\t   obligation): the long form for integers and the double form for\n   934\t   doubles, so 1 and 1.0 hold distinct record contents on JVM/Dart; the\n   935\t   NFC form for strings and ident parts, and the same recursively inside\n   936\t   collections. One content address, one record content: equal fingerprints\n   937\t   imply equal :records maps.\n   938\t   Canonicalizing a map whose keys merge (for example, two string keys\n   939\t   with one NFC form) is a key collision, diagnosed rather than letting\n   940\t   iteration order decide which entry survives; a set whose elements\n   941\t   merge (such as two distinct spellings of one NFC string) is diagnosed\n   942\t   the same way, because the merge changes its count, not just a scalar's\n   943\t   spelling.\"\n   944\t  [v]\n   945\t  (let [class (canonical-class v)]\n   946\t    (case class\n   947\t      :nil v\n   948\t      :bool v\n   949\t      :int64 (long v)\n   950\t      :double (double v)\n   951\t      :string (normalize-nfc v)\n   952\t      :bytes v\n   953\t      :keyword (if-let [ns (namespace v)]\n   954\t                 (keyword (normalize-nfc ns) (normalize-nfc (name v)))\n   955\t                 (keyword (normalize-nfc (name v))))\n   956\t      :symbol (if-let [ns (namespace v)]\n   957\t                (symbol (normalize-nfc ns) (normalize-nfc (name v)))\n   958\t                (symbol (normalize-nfc (name v))))\n   959\t      :map (let [canonical (into {}\n   960\t                                 (map (fn [[k x]]\n   961\t                                        [(canonical-value k) (canonical-value x)]))\n   962\t                                 v)]\n   963\t             (if (< (count canonical) (count v))\n   964\t               (throw (ex-info \"Canonicalizing a map merges distinct keys\"\n   965\t                               {:rule :unsupported-value, :value v}))\n   966\t               canonical))\n   967\t      :set (let [canonical (into (empty v) (map canonical-value) v)]\n   968\t             (if (< (count canonical) (count v))\n   969\t               (throw (ex-info \"Canonicalizing a set merges distinct elements\"\n   970\t                               {:rule :unsupported-value, :value v}))\n   971\t               canonical))\n   972\t      :vector (mapv canonical-value v)\n   973\t      :list (apply list (map canonical-value v))\n   974\t      v)))\n   975\t\n   976\t\n   977\t(defn- node-hash\n   978\t  \"§5: hash(node) = SHA-256(dimension-hash || encode(tag-specific-slots-\n   979\t   in-descriptor-order)). The preimage is the dimension hash's hex\n   980\t   followed by the framed slots under the settled byte rules; the shape —\n   981\t   descriptor order, tags, byte-count length delimiters, ordered child\n   982\t   hashes — is what D2 fixed and D3 settled. Markers are never among the\n   983\t   encodings: only present, non-marker slots reach here.\"\n   984\t  [encodings]\n   985\t  (jing/sha256 (apply str dimension-hash encodings)))\n   986\t\n   987\t\n   988\t;; =============================================================================\n   989\t;; D2: hash-consing and the projected records (§4)\n   990\t;; =============================================================================\n   991\t\n   992\t(defn- slot-encodings\n   993\t  \"The descriptor-order encodings of one record's present, non-marker\n   994\t   slots — with the dimension hash, the only input to a node hash.\n   995\t   Children already carry child hashes, so this is total over a record\n   996\t   and serves both the mint and the storage reader's content check.\"\n   997\t  [record]\n   998\t  (for [[slot type role] dimension-slots\n   999\t        :when (and (not= :marker role) (contains? record slot))]\n  1000\t    (encode-typed type (get record slot))))\n  1001\t\n  1002\t\n  1003\t(defn- mint-record\n  1004\t  \"Hash-cons one resolved node (§4-§5) whose children are already\n  1005\t   minted, their hashes in `child-hashes` ({slot h}, an ordered vector\n  1006\t   under :yin.debruijn/operands): the node hash over the dimension hash\n  1007\t   and the node's tag-specific slots in descriptor order, then the record\n  1008\t   — the node with child slots carrying child hashes, scalars in their\n  1009\t   canonical spellings, and :yin.debruijn/hash added. Returns [h acc']\n  1010\t   over {:hashcons preimage->h, :records h->record, :mints n}; :mints\n  1011\t   counts every call, the walk's instrumentation seam. The consing memo\n  1012\t   is keyed on the node's preimage — the concatenated slot encodings —\n  1013\t   never on Clojure =, which merges a list literal with a vector literal\n  1014\t   and the signed zeros; a preimage hit implies the identical hash and,\n  1015\t   records carrying canonical spellings, the identical record. The memo\n  1016\t   stays an optimisation only: identity is the hash either way, so\n  1017\t   traversal order never enters it.\"\n  1018\t  [node child-hashes acc]\n  1019\t  (let [acc (update acc :mints inc)\n  1020\t        record (reduce (fn [r [slot _type role]]\n  1021\t                         (cond\n  1022\t                           (or (= :marker role) (not (contains? node slot))) r\n  1023\t                           (= :child role) (assoc r slot (get child-hashes slot))\n  1024\t                           ;; the carried D3 obligation: a record's stored\n  1025\t                           ;; scalar is its canonical spelling, so equal\n  1026\t                           ;; fingerprints imply equal records\n  1027\t                           :else (assoc r slot (canonical-value (get node slot)))))\n  1028\t                       node\n  1029\t                       dimension-slots)\n  1030\t        encodings (slot-encodings record)\n  1031\t        preimage (apply str encodings)]\n  1032\t    (if-let [cached (find (:hashcons acc) preimage)]\n  1033\t      [(val cached) acc]\n  1034\t      (let [h (node-hash encodings)]\n  1035\t        [h (-> acc\n  1036\t               (assoc-in [:hashcons preimage] h)\n  1037\t               (assoc-in [:records h] (assoc record :yin.debruijn/hash h)))]))))\n  1038\t\n  1039\t\n  1040\t(defn project-datoms-counted\n  1041\t  \"`project-datoms` plus :mints, the number of record mints the walk\n  1042\t   performed — the honest instrumentation seam for the shared-subgraph\n  1043\t   bound: one mint per distinct [source-eid lexical-context] occurrence,\n  1044\t   never one per unfolded path. Output-neutral: every other key is\n  1045\t   exactly `project-datoms`'s.\"\n  1046\t  [datoms]\n  1047\t  (let [datoms (vec datoms)\n  1048\t        index (index-frame \"yin\" datoms)\n  1049\t        root-eid (frame-root datoms)\n  1050\t        [root fingerprint {:keys [records mints]}]\n  1051\t        (project-node index\n  1052\t                      root-eid\n  1053\t                      []\n  1054\t                      {:memo {}, :hashcons {}, :records {}, :mints 0}\n  1055\t                      #{}\n  1056\t                      [])]\n  1057\t    {:root root, :fingerprint fingerprint, :records records, :mints mints}))\n  1058\t\n  1059\t\n  1060\t(defn project-datoms\n  1061\t  \"§6's pure projection of one complete rooted graph of :yin/* AST\n  1062\t   datoms, through §2 validation and §3 scope resolution to D2's Merkle\n  1063\t   records. Returns {:root node, :fingerprint h, :records {h record}}:\n  1064\t   the resolved semantic graph under :root (whose wrapper key is the\n  1065\t   graph's root marker — the node map carries none, so it equals the\n  1066\t   same term appearing as a subterm), the root node hash as\n  1067\t   :fingerprint, and the hash-consed projected records — each the\n  1068\t   resolved node with child slots carrying child hashes and\n  1069\t   :yin.debruijn/hash h added. A bound occurrence carries\n  1070\t   :yin.debruijn/bound [frame-depth position], a free one\n  1071\t   :yin.debruijn/free name, and a lambda's binder is its\n  1072\t   :yin.debruijn/arity.\n  1073\t\n  1074\t   Input order, source tempids, t, m, and non-:yin/* namespaces never\n  1075\t   enter the result, at graph level or hash level. Every defect is\n  1076\t   ex-info carrying :rule (and, where the walk has descended, :entity\n  1077\t   and :path). For a stream carrying several adjacent graphs, frame it\n  1078\t   first with `frame-datoms` and project each frame — the per-frame fact\n  1079\t   index resets there.\"\n  1080\t  [datoms]\n  1081\t  (dissoc (project-datoms-counted datoms) :mints))\n  1082\t\n  1083\t\n  1084\t;; =============================================================================\n  1085\t;; D2: the d5 storage adapter (§4)\n  1086\t;; =============================================================================\n  1087\t\n  1088\t(defn projected->datoms\n  1089\t  \"The d5 storage adapter's write half (§4): one projection's records as\n  1090\t   d5 datoms [e a v t m]. Entities are local handles minted from\n  1091\t   dao.datom's first-user-id in a deterministic root-down, descriptor\n  1092\t   slot order walk — handles, ordinals, and row count are storage layout\n  1093\t   only, never identity. Each entity carries :yin.debruijn/hash h; child\n  1094\t   slots carry child hashes; :yin.debruijn/operands is one ordered\n  1095\t   vector datom, never cardinality-many; and the root entity is\n  1096\t   explicitly marked :yin.debruijn/root true — the root-hash marker, its\n  1097\t   :yin.debruijn/hash being the fingerprint. t 0 and the assert op are\n  1098\t   the adapter's fixed provenance, mirroring the named emitter's\n  1099\t   defaults.\"\n  1100\t  [{:keys [fingerprint records]}]\n  1101\t  (let [t 0\n  1102\t        m datom/default-op\n  1103\t        out (atom [])\n  1104\t        emitted (atom #{})\n  1105\t        next-eid (atom (dec datom/first-user-id))\n  1106\t        emit! (fn [e a v] (swap! out conj [e a v t m]))\n  1107\t        walk (fn walk\n  1108\t               [h]\n  1109\t               ;; one entity per hash: a record reachable by several paths\n  1110\t               ;; is emitted once, and the slot datoms already pointing at\n  1111\t               ;; its hash are the sharing\n  1112\t               (when-not (contains? @emitted h)\n  1113\t                 (let [e (swap! next-eid inc)\n  1114\t                       ;; the records came from the projection itself, so a\n  1115\t                       ;; missing one is a projection defect, never input:\n  1116\t                       ;; its rule is one `exception-diagnostic` classifies\n  1117\t                       ;; :internal-error\n  1118\t                       record (or (get records h)\n  1119\t                                  (throw (ex-info\n  1120\t                                           \"Projected record set does not contain a child hash\"\n","exit_code":0,"status":"completed"}}
