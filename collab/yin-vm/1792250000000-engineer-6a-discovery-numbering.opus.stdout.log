ith emit-numbered:\" (error #(decode* (rows/emit-numbered parent {})))))\n1057\t    (println \"\\n== decoder order: discovery recomputation before frame validation (rows.cljc:570-578)\")\n1058\t    (let [kind (fn [wire] (:yin.k/kind (error #(decode* wire))))\n1059\t          defect (frame-defect (rt/fixture :s1 :s2 :x :y))]\n1060\t      (println \"  wrong numbering + reserved-name frame defect:\" (kind (rows/emit-numbered defect {:x :yin.k/cc-9 :y :yin.k/cc-8})) \"(expect :noncanonical-cursor-cells)\")\n1061\t      (println \"  right numbering + the same defect:\" (kind (emit* defect)) \"(expect :reserved-name)\")\n1062\t      (println \"  2-cycle + the same defect:\" (kind (rows/emit-numbered (frame-defect two-cycle) {:a :yin.k/cc-1 :b :yin.k/cc-2})) \"(expect :unresolved-cursor-cells)\")\n1063\t      (println \"  a valid carrier:\" (or (error #(decode* (emit* (rt/fixture :s1 :s2 :x :y)))) :ok)))\n1064\t    (println \"\\n== gates and budgets (resource refusals, never canonicality verdicts)\")\n1065\t    (binding [*numbering-opts* {:budget {:work 1}}]\n1066\t      (println \"  loop+2-cycle {:work 1}:\" (error-brief #(emit* loop-2cycle)))\n1067\t      (println \"  decode of a valid carrier under {:work 1}:\" (error-brief #(decode* (binding [*numbering-opts* {}] (emit* (rt/fixture :s1 :s2 :x :y)))))))\n1068\t    (binding [*numbering-opts* {:budget {:cursor-cells 1}}]\n1069\t      (println \"  two cells under {:cursor-cells 1}:\" (error-brief #(emit* (task [:x :y] (v [:x :y]))))))\n1070\t    (let [ids (mapv #(keyword \"src\" (str \"n\" %)) (range 65))]\n1071\t      (println \"  65 cells under the default budget:\" (error-brief #(emit* (rt/task-node (mapv (fn [id i] [id (rt/cursor-cell-body :s i)]) ids (range)) (v ids))))))\n1072\t    (println \"\\n== depth gate before any recursive scan (codex r4 HIGH)\")\n1073\t    (binding [*numbering-opts* {:budget {:depth 3}}]\n1074\t      (println \"  [[[[X]]]] under {:depth 3}:\" (error-brief #(emit* (deep 4))))\n1075\t      (println \"  one cell inside 3000 nested vectors under {:depth 3}:\" (error-brief #(emit* (deep 3000))))\n1076\t      (println \"  one cell inside 10000 nested vectors under {:depth 3}:\" (error-brief #(emit* (deep 10000))))\n1077\t      (println \"  a literal nested 3000 deep beside a cell under {:depth 3}:\"\n1078\t               (error-brief #(emit* (task [:x] [:row (rows/node :vec [(c :x) [:lit (reduce (fn [inner _] [inner]) 1 (range 3000))]])])))))\n1079\t    (println \"  3000 nested vectors under the default budget (depth 256):\" (error-brief #(emit* (deep 3000))))\n1080\t    (println \"  200 nested vectors under the default budget: root\" (do-root (deep 200)))\n1081\t    (println \"  a literal nested 3000 deep inside a set, default budget:\"\n1082\t             (error-brief #(emit* (task [:x :y] (s [[:row (rows/node :vec [(c :x) [:lit (reduce (fn [inner _] [inner]) 1 (range 3000))]])] (c :y)])))))\n1083\t    (println \"\\n== large literals: never spelled in an ordered position; charged before encoding in an unordered one\")\n1084\t    (let [large (vec (range 400000))\n1085\t          reachable (task [:x] [:row (rows/node :vec [(c :x) [:lit large]])])\n1086\t          in-set (task [:x :y] (s [[:row (rows/node :vec [(c :x) [:lit large]])] [:row (rows/node :vec [(c :y) [:lit large]])]]))\n1087\t          unreachable (rt/task-node [[:x body]] [:lit large])]\n1088\t      (println \"  ordered: root\" (do-root reachable) \"| work\" (:work (:used (discovery-numbering reachable))))\n1089\t      (println \"  unordered, default budget:\" (do-root in-set) \"|\" (used-at #(emit* in-set)))\n1090\t      (binding [*numbering-opts* {:budget {:work 2000}}]\n1091\t        (println \"  unordered under {:work 2000} (the depth scan refuses at position 2001, the estimator is never entered):\"\n1092\t                 (error-brief #(emit* in-set)) \"|\" (used-at #(emit* in-set))))\n1093\t      (binding [*numbering-opts* {:budget {:work 900000}}]\n1094\t        (println \"  unordered under {:work 900000} (the scan's 800k positions pass, the estimator aborts within remaining/128 steps):\"\n1095\t                 (error-brief #(emit* in-set)) \"|\" (used-at #(emit* in-set))))\n1096\t      (println \"  unreachable census cell (totality defect, not a refusal):\" (error #(discovery-numbering unreachable))))\n1097\t    (println \"\\n== key bytes versus stream descriptor size (rank spelling)\")\n1098\t    (doseq [n [128 65536]]\n1099\t      (let [big (fn [i] (rows/node :cursor-cell-body [(rows/node :stream [:s (apply str (repeat n \"d\"))]) i]))\n1100\t            t (rt/task-node [[:x (big 0)] [:y (big 0)] [:z (big 1)] [:w (big 1)]]\n1101\t                            (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)]) (s [(c :x) (c :z)])]))\n1102\t            d (discovery-numbering t)]\n1103\t        (println \"  descriptor\" n \"chars: work\" (:work (:used d)) \"| encoded bytes\" (:encoded-bytes (:used d))\n1104\t                 \"| local runs\" (:local-runs (:used d)) \"| root\" (do-root t))))\n1105\t    (println \"\\n== frame-bearing fixtures (act window, K frame window, environments, parked state)\")\n1106\t    (let [t (frame-task [[:x body] [:y body]] [(c :x) (c :y)] (c :y) (s [(c :x) (c :y)]))]\n1107\t      (report-fixture \"wait window x, K window y, env y, parked K window #{x y}\" t)\n1108\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n1109\t    (let [t (frame-task [[:x body] [:y body]] [(s [(c :x) (c :y)])] nil (c :y))]\n1110\t      (report-fixture \"wait window #{x y}, parked K window y\" t)\n1111\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n1112\t    (println \"\\n== install children numbered by discovery order\")\n1113\t    (let [child (rows/node :task (assoc (:slots (fixture-review-counterexample)) 3 :child))\n1114\t          parent (rows/node :task (assoc (:slots (rt/task-node [[:x (rt/cursor-cell-body :root/s 1)]] (c :x))) 12\n1115\t                                         [(rows/node :install ['a :running nil {} child])\n1116\t                                          (rows/node :install ['b :running nil {} child])]))\n1117\t          wire (emit* parent)]\n1118\t      (println \"  parent root:\" (:yin.k/root wire) \"| task rows:\" (count (filter #(= :task (second %)) (:yin.k/rows wire)))\n1119\t               \"| child numbering:\" (into (sorted-map) (:numbering (discovery-numbering child)))\n1120\t               \"| decode:\" (or (error #(decode* wire)) :ok)))\n1121\t    (println \"\\n== random search (refused states classified by exhaustive permissive entry when <= 720 orders, else 48 samples)\")\n1122\t    (search \"random values\" gen-task (range 2000))\n1123\t    (search \"frame-bearing\" gen-frame-task (range 200))\n1124\t    (search \"with children\" gen-child-task (range 100))\n1125\t    (search \"incidence families (reviewer's generator)\" gen-incidence-task (range 1000))))\n1126\t"}]},"parent_tool_use_id":null,"session_id":"aabb63dd-c047-4e34-a210-01b6c179a82e","uuid":"90589d4a-6e2e-48b3-bf25-1f19d88e6356","timestamp":"2026-10-12T12:09:39.983Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6a/collab/numbering-ref/probe/src/probe/discovery.clj","content":"      (let [r (java.util.Random. 7) sh (seeded-shuffle r)\n            roots (into #{} (map (fn [_] (permissive-root (reorder task (fn [_ ms] (sh ms)))))) (range samples))]\n        (if (= 1 (count roots)) :undecided :non-interchangeable)))))\n\n(defn invariant-roots\n  \"Distinct roots of a state over `n` renamings plus shuffles (1 = invariant\n   under the samples).\"\n  [task n]\n  (let [r (java.util.Random. 5) cells (all-census-cells task)]\n    (with-redefs [shuffle (seeded-shuffle r)]\n      (->> (repeatedly n #(rename-and-shuffle task (zipmap cells (map (fn [i] (keyword \"r\" (str \"z\" i))) (shuffle (range (count cells)))))))\n           ;; A refusal's :cursor-cells names local source ids; the verdict and\n           ;; the path are what must be invariant.\n           (map (fn [t] (let [r (do-root t)] (if (map? r) (update r :refused dissoc :yin.k/cursor-cells) r))))\n           distinct count))))\n\n(defn report-fixture [name task]\n  (let [d (discovery-numbering task)]\n    (println name)\n    (println \"  DO :\" (or (:refused d) (into (sorted-map) (:numbering d))) \"| work\" (:work (:used d)) \"| encoded bytes\" (:encoded-bytes (:used d)))\n    (println \"  DO root:\" (do-root task) \"| roots over 24 renamings+shuffles:\" (invariant-roots task 24))\n    (when (:refused d) (println \"  interchangeable? (exhaustive/sampled permissive):\" (classify-refused task 5040 48)))\n    (println \"  6a root:\" (safe-6a-root task))))\n\n(defn invariance-check\n  \"Root of the state and of the state renamed and shuffled; decode of the\n   carrier. Returns a map of outcomes.\"\n  [task ^java.util.Random r]\n  (let [cells (all-census-cells task)\n        fresh (zipmap cells (map #(keyword \"other\" (str \"z\" %)) (shuffle (range (count cells)))))\n        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\n        d1 (do-root task) d2 (do-root task2)]\n    (cond\n      (and (map? d1) (:refused d1))\n      {:refused (:refused d1) :invariant (= (dissoc (:refused d1) :yin.k/cursor-cells) (dissoc (:refused d2) :yin.k/cursor-cells))}\n      (map? d1) {:resource-limit (:resource-limit d1)}\n      :else\n      {:root d1 :invariant (= d1 d2)\n       :used (:used (discovery-numbering task))\n       :decode (let [e (error #(decode* (emit* task)))]\n                 (cond (nil? e) :ok\n                       (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\n                       :else e))})))\n\n(defn search [label gen seeds]\n  (let [r (java.util.Random. 11)\n        stats (atom {:numbered 0 :refused 0 :resource-limit 0 :invariance-fail 0\n                     :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\n                     :refused-interchangeable 0 :refused-non-interchangeable 0 :refused-undecided 0\n                     :refused-only-across-groups 0 :refused-reasons {}\n                     :count-spelling-gain 0 :count-spelling-loss 0\n                     :max-work 0 :max-encoded-bytes 0 :max-local-runs 0})]\n    (doseq [seed seeds]\n      (let [task (gen seed) o (invariance-check task r)\n            without (binding [*numbering-opts* (assoc *numbering-opts* :count-spelling false)] (do-root task))]\n        ;; The occurrence count in the key: states it numbers that the literal\n        ;; direction (body rank and local index only) refuses, and the reverse.\n        (when (and (:root o) (map? without) (:refused without)) (swap! stats update :count-spelling-gain inc))\n        (when (and (:refused o) (keyword? without)) (swap! stats update :count-spelling-loss inc))\n        (when-not (:invariant o true)\n          (swap! stats update :invariance-fail inc) (println \"INVARIANCE FAIL\" label seed))\n        (cond\n          (:refused o)\n          (let [why (:probe/why (:refused o))]\n            (swap! stats update :refused inc)\n            (doseq [w why] (swap! stats update-in [:refused-reasons w] (fnil inc 0)))\n            (when (every? #{:shared-across-groups} why) (swap! stats update :refused-only-across-groups inc))\n            (swap! stats update (case (classify-refused task 720 48)\n                                  :interchangeable :refused-interchangeable\n                                  :non-interchangeable :refused-non-interchangeable\n                                  :refused-undecided) inc))\n          (:resource-limit o)\n          (do (swap! stats update :resource-limit inc) (println \"RESOURCE LIMIT\" label seed (:resource-limit o)))\n          :else\n          (do (swap! stats update :numbered inc)\n              (swap! stats update :max-work max (:work (:used o) 0))\n              (swap! stats update :max-encoded-bytes max (:encoded-bytes (:used o) 0))\n              (swap! stats update :max-local-runs max (:local-runs (:used o) 0))\n              (case (:decode o)\n                :ok (swap! stats update :decode-ok inc)\n                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\n                (do (swap! stats update :decode-fail inc) (println \"DECODE FAIL\" label seed (:decode o))))))))\n    (println label (count seeds) \"states:\" @stats)\n    @stats))\n\n(defn -main []\n  (let [body (rt/cursor-cell-body :s 0)\n        body1 (rt/cursor-cell-body :s 1)\n        s (fn [es] [:row (rows/node :set es)])\n        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\n        c (fn [x] [:cursor-cell x])\n        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))\n        two-cycle (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))\n        three-cycle (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])]))\n        path-abc (task [:a :b :c] (s [(v [:a :b]) (v [:b :c])]))\n        loop-2cycle (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])]))\n        seven (rt/seven-cursor-cell-triangle-square)\n        witness (task [:a :b] [:row (rows/node :vec [(s [(s [(v [:a :b]) (v [:b :a])])]) (c :a)])])\n        mixed (rt/task-node [[:a body] [:b body1] [:c body1]] (s [(v [:a :b]) (v [:a :c])]))\n        anchored (task [:a :b :c :d :e] [:row (rows/node :vec [(s [(v [:a :b]) (v [:a :c]) (v [:b :d]) (v [:c :e]) (v [:d :b]) (v [:e :c])]) (c :a)])])\n        two-sets-shared (task [:x :y :z] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :y) (c :z)])])])\n        two-sets-equal (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])\n        two-2cycles (task [:a :b :c :d] (s [(s [(v [:a :b]) (v [:b :a])]) (s [(v [:c :d]) (v [:d :c])])]))\n        ;; equal-size, equal-degree, non-isomorphic: a directed 3-cycle beside\n        ;; a 3-edge orientation with a source and a sink; both inner sets key\n        ;; [:set [:tie K K K]] with the same K (three pairs of distinct\n        ;; count-2 cells), so the outer