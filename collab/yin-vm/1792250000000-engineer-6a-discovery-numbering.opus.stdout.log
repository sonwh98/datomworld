(bad! :extra-cursor-cell (conj path 9)))))]\n468\t    (when (= :task (:kind root)) (check-task root []))))\n469\t\n470\t\n471\t(defn- decode*\n472\t  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n473\t   form and cursor-cell numbering, then expand structural refs. No attachment.\n474\t   Frame checks are available separately through validate-frames.\"\n475\t  ([wire] (decode* wire default-budget))\n476\t  ([wire budget]\n477\t   (let [budget (merge default-budget budget) counter (atom {})\n478\t         rs (:yin.k/rows wire)]\n479\t     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n480\t                    (code/reg? (:yin.k/version wire)))\n481\t       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n482\t     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n483\t                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n484\t       (bad! :row-shape [:yin.k/rows]))\n485\t     (spend! counter budget :rows (count rs))\n486\t     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n487\t     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n488\t           root (:yin.k/root wire)]\n489\t       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n490\t       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n491\t       ;; Gate children before schema, with an active path (DAG sharing is legal).\n492\t       (letfn [(gate\n493\t                 [id active]\n494\t                 (when (contains? active id) (bad! :cyclic [id]))\n495\t                 (let [row (get index id) slots (when row (subvec row 2))]\n496\t                   (when-not (and (= :task (second row)) (= 17 (count slots))\n497\t                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12)))\n498\t                     (bad! :task-shape [id]))\n499\t                   (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n500\t                   (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n501\t                   (doseq [install (nth slots 12)]\n502\t                     (let [r (get index install)]\n503\t                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n504\t                       (gate (nth r 6) (conj active id))))))]\n505\t         (when (= :task (second (get index root))) (gate root #{})))\n506\t       (doseq [[id kind & slots] rs]\n507\t         (let [schema (get row-table kind) ds (descriptors kind slots)]\n508\t           (when-not (and schema\n509\t                          (cond\n510\t                            (= schema :pending) (contains? pending-table (first slots))\n511\t                            (= :pairs (first schema)) (even? (count slots))\n512\t                            :else true)\n513\t                          (= (count ds) (count slots))) (bad! :row-shape [id]))\n514\t           (doseq [[i d x] (map vector (range) ds slots)]\n515\t             (when-not (structural? kind d x) (bad! :slot-kind [id i])))))\n516\t       (let [seen (atom #{})]\n517\t         (letfn [(walk\n518\t                   [id active depth]\n519\t                   (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n520\t                   (when (contains? active id) (bad! :cyclic [id]))\n521\t                   (when-not (contains? @seen id)\n522\t                     (let [r (get index id)]\n523\t                       (when-not r (bad! :missing-row [id]))\n524\t                       (let [kind (second r) slots (subvec r 2)]\n525\t                         (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n526\t                           (let [targets (cond (ref? d) [x] (refs? d) x\n527\t                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n528\t                                               :else [])]\n529\t                             (doseq [target targets]\n530\t                               (when (and (contains? #{:V :optional-V} d)\n531\t                                          (not (contains? value-row-kinds (second (get index target)))))\n532\t                                 (bad! :value-reference-kind [id i]))\n533\t                               (when (and (or (ref? d) (refs? d))\n534\t                                          (not (contains? (set (rest d)) (second (get index target)))))\n535\t                                 (bad! :reference-kind [id i]))\n536\t                               (walk target (conj active id) (inc depth))))))\n537\t                       (swap! seen conj id))))]\n538\t           (walk root #{} 0)\n539\t           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n540\t       (doseq [[id & body] rs]\n541\t         (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n542\t                        (= id (jing/segment-key (vec body))))\n543\t           (refuse! :yin.k/hash-mismatch :row [id])))\n544\t       (doseq [[id kind & slots] rs :when (= :task kind)]\n545\t         (doseq [[address v] (nth slots 11)]\n546\t           (when-not (= address (jing/segment-key v))\n547\t             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n548\t           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n549\t       (doseq [[_ kind & slots] rs\n550\t               [d x] (map vector (descriptors kind slots) slots)]\n551\t         (when-not (or (ref? d) (refs? d) (= :C d))\n552\t           (check-literal-markers! (if (contains? #{:V :optional-V} d)\n553\t                                     (when (= :lit (first x)) (second x)) x))))\n554\t       (doseq [[id kind & slots] rs]\n555\t         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n556\t         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n557\t           (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n558\t             (when-not (and (= (count keys) (count (distinct keys)))\n559\t                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n560\t               (bad! :duplicate-key [id])))))\n561\t       (letfn [(expand-slot\n562\t                 [d x]\n563\t                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n564\t                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n565\t                       :else x))\n566\t               (expand\n567\t                 [id]\n568\t                 (let [[_ kind & slots] (get index id)]\n569\t                   (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n570\t         (let [task (expand root)\n571\t               _ (check-abstract! task)\n572\t               canonical (if (= :task (:kind task)) (emit task budget)\n573\t                             (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n574\t           (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n575\t             (bad! :noncanonical-cursor-cells [root]))\n576\t           (when (= :task (:kind task))\n577\t             (when-let [d (validate-frames task)]\n578\t               (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n579\t           task))))))\n580\t\n581\t\n582\t(defn decode\n583\t  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n584\t   For task roots, run X1 and frame validation after numbering.\"\n585\t  ([wire] (decode* wire default-budget))\n586\t  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n587\t\n588\t\n589\t(defn canonical-under\n590\t  \"Test-only