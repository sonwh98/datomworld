        (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n      (or\n        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n              (partition 2 (:slots (nth slots 8))))\n        (captures task [])))))\n","structuredPatch":[{"oldStart":582,"oldLines":7,"newStart":582,"newLines":7,"lines":["   (let [ctx (:ctx run) [tag k] (get @(:num run) c)]","     (case tag","       :n [:cursor-cell [:n k]]","-      :u [:cursor-cell [:u k (get (:ranks ctx) c)]]","+      :u [:cursor-cell [:u (get (:ranks ctx) c) (get (:counts ctx) c)]]","       (throw (ex-info \"Spelling an unnumbered cursor cell\" {:cursor-cell c})))))"," "," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01F7wKUbnvsb4brid9p8cpco","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
