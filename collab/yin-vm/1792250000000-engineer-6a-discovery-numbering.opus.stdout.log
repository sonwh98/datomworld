+;; Generated states (design note §5 item 18): a portable seeded generator of","+;; tasks over one to six cursor cells. Every numbered state's carrier decodes","+;; and re-emits to its root; renaming every cursor cell and shuffling every","+;; set, map and census gives the same root, or the same refusal and path.","+","+(defn- rng","+  [seed]","+  (atom (inc (mod seed 2147483646))))","+","+","+(defn- next-int!","+  ;; Park-Miller: every product stays below 2^53, exact on all three hosts.","+  [r n]","+  (mod (swap! r #(mod (* % 48271) 2147483647)) n))","+","+","+(defn- shuffler","+  [r]","+  (fn [xs]","+    (reduce (fn [out i]","+              (let [j (next-int! r (inc i)) x (nth out i)]","+                (-> out (assoc i (nth out j)) (assoc j x))))","+            (vec xs) (range (dec (count xs)) 0 -1))))","+","+","+(defn- decoded","+  \"Portable decoded equality of an abstract value, as decode checks it.\"","+  [x]","+  (case (first x)","+    :lit [:lit (second x)]","+    :cursor-cell [:identity (second x)]","+    :row (let [n (second x) ss (:slots n)]","+           (case (:kind n)","+             :vec [:seq (mapv decoded ss)]","+             :set [:set (set (map decoded ss))]","+             :map [:map (into {} (map (fn [[k y]] [(decoded k) (decoded y)])) (partition 2 ss))]","+             [:row n]))))","+","+","+(defn- distinct-by","+  [f xs]","+  (second (reduce (fn [[seen out] x]","+                    (let [k (f x)] (if (contains? seen k) [seen out] [(conj seen k) (conj out x)])))","+                  [#{} []] xs)))","+","+","+(defn- gen-value","+  \"A random V over cells: literals, cursor cells, vectors, sets, maps with","+   cursor-ref keys, sets of cursor-cell pairs (aliases included), sets of sets.\"","+  [r cells depth]","+  (let [pick (fn [xs] (nth xs (next-int! r (count xs))))","+        cc (fn [] (c (pick cells)))","+        some-ref? (fn [xs] (some #(not= :lit (first %)) xs))]","+    (case (next-int! r (if (pos? depth) 9 3))","+      0 [:lit (pick [1