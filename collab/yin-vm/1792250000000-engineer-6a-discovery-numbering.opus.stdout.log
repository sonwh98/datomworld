tor (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n      (or\n        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n              (partition 2 (:slots (nth slots 8))))\n        (captures task [])))))\n","structuredPatch":[{"oldStart":269,"oldLines":7,"newStart":269,"newLines":8,"lines":[" "," (defn- key-bytes!","   \"Every comparison encoding of the numbering: charged, then encoded.\"","-  [_ctx x]","+  [ctx x]","+  (charge-representation! ctx x)","   (bytes-key (cbor/encode x)))"," "," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01SZ8t4XAJ5Kzv2koNdKjndK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
