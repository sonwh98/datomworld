nterexample-search\" label (count seeds) \"states:\" (dissoc stats :failures)\n             \"failures:\" (count (:failures stats)))\n    stats))\n\n\n(deftest counterexample-search-quick\n  (doseq [[label gen seeds] [[\"random values\" gen-task (range 120)]\n                             [\"frame-bearing\" gen-frame-task (range 20)]\n                             [\"with children\" gen-child-task (range 10)]]]\n    (let [{:keys [numbered refused failures]} (counterexample-search label gen seeds)]\n      (is (= [] failures) label)\n      (is (= (count seeds) (+ numbered refused)) label))))\n\n\n(deftest ^:slow counterexample-search\n  (slow/guard\n    \"counterexample-search\"\n    (fn []\n      (doseq [[label gen seeds] [[\"random values\" gen-task (range 1000 3000)]\n                                 [\"frame-bearing\" gen-frame-task (range 1000 1200)]\n                                 [\"with children\" gen-child-task (range 1000 1100)]]]\n        (let [{:keys [numbered refused failures]} (counterexample-search label gen seeds)]\n          (is (= [] failures) label)\n          (is (= (count seeds) (+ numbered refused)) label))))))\n","structuredPatch":[{"oldStart":934,"oldLines":12,"newStart":934,"newLines":12,"lines":["                       (:error a) (update acc :failures conj [seed :error (:error a)])","                       (:refused a) (cond-> (update acc :refused inc)","                                      (not= (:refused a) (:refused b)) (update :failures conj [seed :refusal (:refused a) b]))","-                      :else (let [back (error #(rows/emit (rows/decode (:wire a))))","-                                  again (when-not back (:yin.k/root (rows/emit (rows/decode (:wire a)))))]","+                      :else (let [again (try (root-of (rows/decode (:wire a)))","+                                             (catch #?(:cljd Object :clj Throwable :cljs :default) e","+                                               {:decode (or (ex-data e) (str e))}))]",