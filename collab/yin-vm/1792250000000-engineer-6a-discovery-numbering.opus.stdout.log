 % (cursor-cell-body :s 0)) ids)\n               [:row (rows/node :set (mapv (fn [[a b]] [:row (rows/node :vec [[:cursor-cell a] [:cursor-cell b]])]) edges))])))\n\n\n(deftest intermediate-label-bytes-are-bounded\n  (let [d (error #(rows/canonical-numbering (seven-cursor-cell-triangle-square)))]\n    (is (= :resource-limit (:yin.k/kind d)))\n    (is (= [:label-bytes] (:yin.k/path d)))))\n\n\n(deftest input-row-bodies-do-not-spend-label-bytes\n  (let [large (vec (range 400000))\n        base (task-node [[:x (cursor-cell-body :s 0)]] [:lit large])\n        ;; Keep the census cursor cell reachable so decode also validates the carrier.\n        reachable (rows/node :task (assoc (:slots base) 5\n                                          (rows/node :bindings ['cursor [:cursor-cell :x]])))\n        custody (rows/node :task (assoc (:slots reachable) 15 [:lit nil]))\n        custody (rows/node :task (assoc (:slots custody) 16 large))]\n    (is (nil? (error #(rows/emit base))))\n    (doseq [task [reachable custody]]\n      (let [wire (rows/emit task)\n            expected (rows/node :task\n                                (-> (:slots task)\n                                    (assoc 5 (rows/node :bindings ['cursor [:cursor-cell :yin.k/cc-1]]))\n                                    (assoc 9 (rows/node :cursor-cells [:yin.k/cc-1 (cursor-cell-body :s 0)]))))]\n        (is (= expected (rows/decode wire)))))))\n","structuredPatch":[{"oldStart":169,"oldLines":14,"newStart":169,"newLines":15,"lines":["       (is (= 2 (count (rows/canonical-numbering a)))))))"," "," ","-(deftest refinement-search-on-symmetric-cursor-cells-is-bounded","+(deftest symmetric-cursor-cells-are-interchangeable","   (let [body (cursor-cell-body :s 0)","         make-task (fn [a b] (task-node [[a body] [b body]] [:row (rows/node :set [[:cursor-cell a] [:cursor-cell b]])]))","         a (rows/emit (make-task :x :y)) b (rows/emit (make-task :b :a))]","     (is (= (:yin.k/root a) (:yin.k/root b)))","     (is (= 2 