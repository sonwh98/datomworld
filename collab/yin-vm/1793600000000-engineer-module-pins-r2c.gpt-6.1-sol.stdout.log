{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1370,1418p' src/cljc/dao/jing/cbor.cljc; cat test/yin/vm/linker/layering_test.clj; cat test/yin/vm/ucf/rows_checkpoint_fixtures.cljc; rg -n 'fixture|\\\\.txt|mint' test/yin/vm/ucf/stage_e* test/yin/vm/ucf/*ledger*; sed -n '390,420p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '1350,1435p' test/yin/vm/ucf/rows_test.cljc\"","aggregated_output":"                    (item :simple arg pos))\n        :else (item :float ai pos)))))\n\n\n;; ==========================================================================\n;; Decode, part 2: the closed Jing profile over generic items\n;; ==========================================================================\n\n(declare item->value)\n\n\n(defn- int-item\n  \"The host big integer of an integer item (a bignum too when allowed),\n   or nil.\"\n  [bs x allow-bignum?]\n  (case (:kind x)\n    (:uint :nint) (:value x)\n    :tag (let [[tag _] (:value x)]\n           (when (and allow-bignum? (#{2 3} tag))\n             (big (item->value bs x))))\n    nil))\n\n\n(defn- check-members\n  \"Refuse duplicate raw encodings among items (dup-class), then\n   portable-equality collapses among their values.\"\n  [bs items values dup-class]\n  (let [raws (map #(span-key bs (:start %) (:end %)) items)]\n    (when (< (count (set raws)) (count items))\n      (refuse dup-class)))\n  (when (collapse? values)\n    (refuse :equality-collapse)))\n\n\n(defn- built\n  \"coll, unless building it merged members the portable equality keeps\n   apart (host identifier equality on ClojureScript compares the joined\n   name): losing an entry is never acceptable.\"\n  [coll expected]\n  (when (< (count coll) expected)\n    (refuse :host-collapse \"the host collection merged distinct members\"))\n  coll)\n\n\n(defn- pair-items\n  \"The two items of a definite-or-indefinite two-element array item, or\n   nil for any other shape.\"\n  [p]\n  (when (and (= :array (:kind p)) (= 2 (count (:value p))))\n(ns yin.vm.linker.layering-test\n  \"The linker's layering rule (collab design admission-in-linker r2,\n   section 1): linker semantics is what a plain Clojure consumer needs,\n   and the REPL is a consumer of it, never the reverse.  No namespace\n   under src/cljc/yin/vm, src/cljc/yang or src/clj/dao requires a\n   `yin.repl` namespace.  This gate reads the `ns` form of every source\n   file there (tools.reader, reader conditionals preserved, so every\n   branch is read, whether inside a clause or around whole clauses) and\n   fails on any `yin.repl` or `yin.repl.*` symbol in a `:require`,\n   `:require-macros` or `:use` clause, on any file it cannot read, on\n   any file whose first form is not `ns` (empty files included), and on\n   a root that is missing or holds no source file.  Docstrings and datum\n   vocabulary such as `:yin.repl/root` are not requires and do not\n   count.  JVM only: it reads source files.\"\n  (:require [clojure.java.io :as io]\n            [clojure.test :refer [deftest is testing]]\n            [clojure.tools.reader :as reader]\n            [clojure.tools.reader.reader-types :as rt]))\n\n\n(def ^:private roots\n  [\"src/cljc/yin/vm\" \"src/cljc/yang\" \"src/clj/dao\"])\n\n\n(def ^:private require-clauses\n  #{:require :require-macros :use})\n\n\n(defn- repl-ns?\n  [x]\n  (and (symbol? x)\n       (let [s (str x)]\n         (or (= \"yin.repl\" s) (.startsWith s \"yin.repl.\")))))\n\n\n(defn- symbols-in\n  [form]\n  (cond\n    (reader-conditional? form) (symbols-in (:form form))\n    (symbol? form) [form]\n    (coll? form) (mapcat symbols-in form)\n    :else nil))\n\n\n(defn- clauses\n  \"The `ns` body elements with every reader conditional opened: each\n   branch of a `#?` is one element, each branch of a `#?@` a sequence\n   of elements, recursively, whatever the host.\"\n  [body]\n  (mapcat (fn [x]\n            (if (reader-conditional? x)\n              (let [branches (take-nth 2 (rest (:form x)))]\n                (clauses (if (:splicing? x) (apply concat branches) branches)))\n              [x]))\n          body))\n\n\n(defn repl-requires\n  \"The `yin.repl` namespaces the `ns` form of `text` requires, as a\n   sorted vector; `[:unreadable message]` when its first form cannot be\n   read; `[:no-ns-form]` when its first form is not an `ns` form, which\n   includes an empty file (every source file under `roots` is a\n   namespace).\"\n  [text]\n  (try\n    (binding [reader/*default-data-reader-fn* (fn [_ v] v)\n              *ns* (create-ns 'yin.vm.linker.layering-reader)]\n      (let [eof (Object.)\n            form (reader/read {:read-cond :preserve, :eof eof}\n                              (rt/indexing-push-back-reader text))]\n        (if (and (seq? form) (= 'ns (first form)))\n          (->> (clauses (rest form))\n               (filter #(and (seq? %) (contains? require-clauses (first %))))\n               (mapcat symbols-in)\n               (filter repl-ns?)\n               distinct\n               sort\n               vec)\n          [:no-ns-form])))\n    (catch Exception e\n      [:unreadable (ex-message e)])))\n\n\n(defn- source-files\n  ([] (mapcat source-files roots))\n  ([root]\n   (->> (file-seq (io/file root))\n        (filter #(.isFile ^java.io.File %))\n        (map #(.getPath ^java.io.File %))\n        (filter #(re-find #\"\\.clj[csd]?$\" %))\n        sort)))\n\n\n(defn violations\n  \"file -> the `yin.repl` namespaces it requires, for every file under\n   `roots` that requires one.\"\n  []\n  (into (sorted-map)\n        (keep (fn [path]\n                (let [found (repl-requires (slurp path))]\n                  (when (seq found) [path found]))))\n        (source-files)))\n\n\n(deftest detector-sees-every-branch-test\n  (testing \"a require in any reader-conditional branch is found\"\n    (is (= '[yin.repl yin.repl.link]\n           (repl-requires\n             (str \"(ns a.b (:require [dao.stream :as s]\"\n                  \" #?(:cljd [yin.repl.link :as l] :clj [x.y :as y])\"\n                  \" #?@(:cljs [[yin.repl :as r]])))\")))))\n  (testing \"#? wrapping a whole clause is read\"\n    (is (= '[yin.repl.store]\n           (repl-requires\n             \"(ns a.b #?(:clj (:require [yin.repl.store :as store])))\"))))\n  (testing \"#?@ wrapping whole clauses is read\"\n    (is (= '[yin.repl yin.repl.link]\n           (repl-requires\n             (str \"(ns a.b #?@(:clj [(:require [dao.stream :as s])\"\n                  \" (:use [yin.repl.link])]\"\n                  \" :cljs [(:require-macros [yin.repl :as r])]))\")))))\n  (testing \"a violation only in an inactive host branch is found\"\n    (is (= '[yin.repl.store]\n           (repl-requires\n             (str \"(ns a.b #?(:clj (:require [dao.stream :as s])\"\n                  \" :cljd (:require [yin.repl.store :as store])))\"))))\n    (is (= '[yin.repl]\n           (repl-requires\n             (str \"(ns a.b #?(:cljs (:require [dao.stream :as s])\"\n                  \" :default #?@(:clj [] :cljd [(:require [yin.repl])])))\")))))\n  (testing \"a clean namespace with whole-clause conditionals stays clean\"\n    (is (= []\n           (repl-requires\n             (str \"(ns a.b #?(:clj (:require [dao.stream :as s])\"\n                  \" :cljd (:require [yin.vm.linker :as l]))\"\n                  \" #?@(:clj [(:import (java.io File))]\"\n                  \" :cljs [(:require [yin.repl-like :as x])]))\")))))\n  (testing \"a file whose first form is not ns is an inspection failure\"\n    (is (= :no-ns-form (first (repl-requires \"(def x 1) (ns a.b)\"))))\n    (is (= :no-ns-form (first (repl-requires \"\"))))\n    (is (= :no-ns-form (first (repl-requires \";; only a comment\\n\")))))\n  (testing \"datum vocabulary and docstrings are not requires\"\n    (is (= []\n           (repl-requires\n             (str \"(ns a.b \\\"yin.repl.link\\\" (:require [dao.stream :as s]))\"\n                  \" (def k :yin.repl/root)\"))))))\n\n\n(deftest every-root-is-inspected-test\n  (doseq [root roots]\n    (testing (str root \" exists and holds source files\")\n      (is (.isDirectory (io/file root)))\n      (is (seq (source-files root))))))\n\n\n(deftest linker-requires-no-repl-test\n  (testing (str \"no namespace under \" roots \" requires yin.repl\")\n    (is (= {} (violations)))))\n(ns yin.vm.ucf.rows-checkpoint-fixtures\n  \"The shared canonical fixtures of the rows inspector (phase 7a, plan\n   §3.3, §4 7a), pinned by their pack addresses, loaded on the JVM, Node\n   and Dart.\n\n   The five accepted bases are packs rows/lift-task itself emitted under\n   a custody header from real semantic machines\n   (yin.vm.ucf.rows-support), the old checkpoint fixtures' five bases\n   re-lifted. Nothing about a base is hand-built but its operation ids\n   (`rows-support/with-op-id`). Every other fixture is a mutation of a\n   named base: a task edit (decode, change the abstract task, `rows/emit`,\n   so every row it touches is rehashed and the pack stays canonical), or a\n   raw edit of the pack where the defect is the carrier's own (version,\n   tag, row order, a row changed without rehash, a frame root). A\n   mutation names the refusal it must draw, as a map the refusal must\n   contain, computed from its base where a path depends on it.\n\n   The pins live in test/resources/yin/vm/ucf/rows-checkpoint-v3.txt, one\n   block per fixture separated by a blank line: the name and the pack\n   address of its bytes. Three anchors (`anchors`) also keep their full\n   bytes as lowercase hex in lines of 64 digits, so the inspector reads\n   bytes this build did not produce; every other fixture's bytes are built\n   from its pack and checked against its pinned address. Regenerate the\n   file from a JVM REPL with the string `render` returns, saved to `path`;\n   the test proves on every host that the file equals `render`.\n\n   The test helpers below (`base`, `edit-task`, `edit-custody`, `enc`,\n   the wait and child accessors) are what the authority's tests use to\n   make their own packs from these bases.\"\n  (:require [clojure.string :as str]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-support :as s]))\n\n\n(def path\n  \"The fixture file, relative to the repository root.\"\n  \"test/resources/yin/vm/ucf/rows-checkpoint-v3.txt\")\n\n\n(def max-exact rows/max-exact)\n\n(def occurrence s/occurrence)\n(def predecessor s/predecessor)\n(def origin s/origin)\n(def arbitration s/arbitration)\n(def op-id s/op-id)\n\n\n;; =============================================================================\n;; Accepted bases: real lifts\n;; =============================================================================\n\n(defn- lifted\n  [machine header]\n  (let [w (s/lift machine header)]\n    (when (contains? w :yin.k/status)\n      (throw (ex-info \"A fixture base failed to lift\" w)))\n    w))\n\n\n(def ^:private base-packs\n  (delay\n    {\"first-park\" (lifted (s/parked-reader) (s/header 0 nil #{}))\n     \"successor\" (lifted (s/with-op-id (s/parked-writer) :put (op-id 0)) (s/header 3 origin #{\"s0\"}))\n     ;; a root waiting on an install whose child is blocked on a write\n     ;; drawing id 4 from the root's sequence\n     \"installs\" (lifted (assoc-in (s/parked-installer) [:installs 'host.mod :vm]\n                                  (s/with-op-id (s/parked-writer) :put (op-id 4)))\n                        (s/header 6 origin #{\"s0\"}))\n     \"parked\" (lifted (s/parked-explicit) (s/header 1))\n     \"halted-root\" (lifted (s/halted-machine) (s/header 0 origin #{}))}))\n\n\n(def base-names [\"first-park\" \"successor\" \"installs\" \"parked\" \"halted-root\"])\n\n\n(defn base\n  \"The pack of accepted base n.\"\n  [n]\n  (get @base-packs n))\n\n\n;; =============================================================================\n;; Editing packs\n;; =============================================================================\n\n(defn edit-task\n  \"wire's root task through f, re-emitted: every changed row rehashed.\"\n  [wire f]\n  (rows/emit (f (rows/decode wire))))\n\n\n(defn edit-custody\n  \"wire with its root's custody slot through f.\"\n  [wire f]\n  (edit-task wire #(update-in % [:slots 16] f)))\n\n\n(defn custody\n  \"The custody slot of wire's root.\"\n  [wire]\n  (nth (:slots (rows/decode wire)) 16))\n\n\n(defn waits\n  [task]\n  (nth (:slots task) 13))\n\n\n(defn with-waits\n  [task ws]\n  (assoc-in task [:slots 13] (vec ws)))\n\n\n(defn pending-of\n  [wait]\n  (second (:slots wait)))\n\n\n(defn reason-of\n  [wait]\n  (first (:slots (pending-of wait))))\n\n\n(defn wait-index\n  \"The index of task's first wait whose pending reason is reason.\"\n  [task reason]\n  (or (first (keep-indexed #(when (= reason (reason-of %2)) %1) (waits task)))\n      (throw (ex-info \"No wait of that reason\" {:reason reason}))))\n\n\n(defn set-pending-slot\n  \"wait with slot i of its pending row set to x.\"\n  [wait i x]\n  (assoc-in wait [:slots 1 :slots i] x))\n\n\n(defn set-op-id\n  [wait id]\n  (set-pending-slot wait 3 id))\n\n\n(defn update-put\n  \"task with its first :put wait through f.\"\n  [task f]\n  (update-in task [:slots 13 (wait-index task :put)] f))\n\n\n(defn install-index\n  [task mn]\n  (or (first (keep-indexed #(when (= mn (first (:slots %2))) %1) (nth (:slots task) 12)))\n      (throw (ex-info \"No install of that name\" {:name mn}))))\n\n\n(defn child\n  [task mn]\n  (nth (:slots (nth (nth (:slots task) 12) (install-index task mn))) 4))\n\n\n(defn update-child\n  [task mn f]\n  (update-in task [:slots 12 (install-index task mn) :slots 4] f))\n\n\n(defn segment-address\n  \"The BLAKE3 segment address of host bytes.\"\n  [bs]\n  (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bs))))\n\n\n(defn enc\n  \"A pack's canonical bytes and its pack address.\"\n  [wire]\n  (let [bs (cbor/encode wire)]\n    {:address (segment-address bs) :bytes bs}))\n\n\n;; =============================================================================\n;; Mutations: the fixture is (f base)\n;; =============================================================================\n;;\n;; :refusal is a function of the base to the map the inspector's refusal\n;; must contain; an accepted variant names none.\n\n(defn- m\n  ([n b f] {:name n :base b :f f})\n  ([n b f refusal] {:name n :base b :f f :refusal refusal}))\n\n\n(defn- custody-set\n  [k x]\n  #(edit-custody % (fn [c] (assoc c k x))))\n\n\n(defn- custody-drop\n  [k]\n  #(edit-custody % (fn [c] (dissoc c k))))\n\n\n(defn- undecodable\n  [kind p]\n  (constantly {:yin.k/status :yin.k/undecodable :yin.k/kind kind :yin.k/path p}))\n\n\n(defn- put-op\n  \"The path of base wire's first :put wait's id, with tail appended.\"\n  [wire & tail]\n  (into [:frames (wait-index (rows/decode wire) :put) :op-id] tail))\n\n\n(defn- child-put-op\n  [wire & tail]\n  (into [:installs 'host.mod :frames (wait-index (child (rows/decode wire) 'host.mod) :put) :op-id] tail))\n\n\n(defn- edit-op-id\n  [f]\n  #(edit-task % (fn [t] (update-put t (fn [w] (set-op-id w (f (nth (:slots (pending-of w)) 3))))))))\n\n\n(def ^:private origin-path [:custody :yin.k/origin])\n\n\n(def ^:private mutations\n  [;; accepted: variants of the successor\n   ;; the same rows in another order: one root, another pack address\n   (m \"variant-equal\" \"successor\" #(update % :yin.k/rows (comp vec reverse)))\n   ;; another id counter: another root, the same custody and ids\n   (m \"variant-other-root\" \"successor\" #(edit-task % (fn [t] (assoc-in t [:slots 4] 9))))\n   (m \"variant-different-intent\" \"successor\"\n      #(edit-task % (fn [t] (update-put t (fn [w] (set-pending-slot w 2 [:lit \"w\"]))))))\n   (m \"variant-counter\" \"successor\" (custody-set :yin.k/next-op-seq 4))\n   (m \"counter-at-bound\" \"successor\"\n      #(-> %\n           (edit-custody (fn [c] (assoc c :yin.k/next-op-seq max-exact)))\n           (edit-task (fn [t] (update-put t (fn [w] (set-op-id w (op-id (dec max-exact)))))))))\n   ;; bytes, gate and carrier\n   (m \"hash-mismatch\" \"successor\" identity)\n   (m \"non-canonical\" \"successor\" identity)\n   (m \"version-float\" \"successor\" #(assoc % :yin.k/version (cbor/float64 3))\n      (constantly {:yin.k/status :yin.k/profile-mismatch :yin.k/kind :version}))\n   (m \"version-2\" \"successor\" #(assoc % :yin.k/version 2)\n      (constantly {:yin.k/status :yin.k/profile-mismatch :yin.k/kind :version}))\n   (m \"version-absent\" \"successor\" #(dissoc % :yin.k/version)\n      (constantly {:yin.k/status :yin.k/profile-mismatch :yin.k/kind :version}))\n   (m \"no-tag\" \"successor\" #(dissoc % :yin.k/handoff)\n      (constantly {:yin.k/status :yin.k/profile-mismatch :yin.k/kind :version}))\n   ;; a pack rooted at the successor's wait, not at a task\n   (m \"frame-root\" \"successor\"\n      #(rows/emit-numbered (nth (waits (rows/decode %)) 0) {})\n      (undecodable :root [:yin.k/root]))\n   ;; the store row's value changed, its id kept\n   (m \"row-tampered\" \"successor\"\n      (fn [w]\n        (update w :yin.k/rows\n                (fn [rs] (mapv #(if (= :store (second %)) (conj % 'tampered [:lit 1]) %) rs))))\n      (constantly {:yin.k/status :yin.k/hash-mismatch :yin.k/kind :row}))\n   (m \"bad-kind\" \"successor\" #(edit-task % (fn [t] (assoc-in t [:slots 2] :running)))\n      (undecodable :kind [:kind]))\n   (m \"root-role\" \"successor\" #(edit-task % (fn [t] (assoc-in t [:slots 3] :child)))\n      (undecodable :role [:role]))\n   ;; root custody\n   (m \"missing-policy\" \"successor\" (custody-drop :yin.k/policy)\n      (undecodable :missing-header [:custody :yin.k/policy]))\n   (m \"missing-occurrence\" \"successor\" (custody-drop :yin.k/occurrence)\n      (undecodable :missing-header [:custody :yin.k/occurrence]))\n   (m \"missing-arbitration\" \"successor\" (custody-drop :yin.k/arbitration)\n      (undecodable :missing-header [:custody :yin.k/arbitration]))\n   (m \"missing-next-op-seq\" \"successor\" (custody-drop :yin.k/next-op-seq)\n      (undecodable :missing-header [:custody :yin.k/next-op-seq]))\n   ;; the draft's explicit fork spelling, not the ruled nil\n   (m \"fork-policy\" \"successor\" (custody-set :yin.k/policy :yin.k/fork)\n      (undecodable :policy [:custody :yin.k/policy]))\n   (m \"nil-occurrence\" \"successor\" (custody-set :yin.k/occurrence nil)\n      (undecodable :nil-occurrence [:custody :yin.k/occurrence]))\n   (m \"occurrence-not-uuid\" \"successor\" (custody-set :yin.k/occurrence \"O\")\n      (undecodable :malformed-occurrence [:custody :yin.k/occurrence]))\n   (m \"origin-occurrence-not-uuid\" \"successor\" (custody-set :yin.k/origin (assoc origin :yin.k/occurrence \"O\"))\n      (undecodable :malformed-origin origin-path))\n   (m \"malformed-arbitration\" \"successor\" (custody-set :yin.k/arbitration (dissoc arbitration :dao.stream/descriptor))\n      (undecodable :malformed-arbitration [:custody :yin.k/arbitration]))\n   (m \"origin-is-self\" \"successor\" (custody-set :yin.k/origin (assoc origin :yin.k/occurrence occurrence))\n      (undecodable :origin-is-self (conj origin-path :yin.k/occurrence)))\n   (m \"malformed-origin\" \"successor\" (custody-set :yin.k/origin (dissoc origin :dao.lease/lease))\n      (undecodable :malformed-origin origin-path))\n   (m \"origin-nil-emitter\" \"successor\" (custody-set :yin.k/origin (assoc origin :yin.k/emitter nil))\n      (undecodable :malformed-origin origin-path))\n   (m \"counter-float\" \"successor\" (custody-set :yin.k/next-op-seq (cbor/float64 3))\n      (undecodable :inexact [:custody :yin.k/next-op-seq]))\n   (m \"counter-over-bound\" \"successor\" (custody-set :yin.k/next-op-seq (inc max-exact))\n      (undecodable :inexact [:custody :yin.k/next-op-seq]))\n   (m \"counter-negative\" \"successor\" (custody-set :yin.k/next-op-seq -1)\n      (undecodable :inexact [:custody :yin.k/next-op-seq]))\n   (m \"first-export-counter\" \"first-park\" (custody-set :yin.k/next-op-seq 1)\n      (undecodable :first-export-counter [:custody :yin.k/next-op-seq]))\n   (m \"halted-root-header\" \"halted-root\" (custody-set :yin.k/occurrence occurrence)\n      (undecodable :halted-header [:custody :yin.k/occurrence]))\n   (m \"halted-root-without-origin\" \"halted-root\" (custody-drop :yin.k/origin)\n      (undecodable :missing-header origin-path))\n   ;; lease, epoch and holder never enter a body (UCF 7.2.1)\n   (m \"custody-epoch\" \"successor\" (custody-set :yin.k/epoch 0)\n      (undecodable :custody-key [:custody :yin.k/epoch]))\n   (m \"custody-lease\" \"successor\" (custody-set :dao.lease/lease \"lease-7\")\n      (undecodable :custody-key [:custody :dao.lease/lease]))\n   (m \"custody-not-map\" \"successor\" #(edit-custody % (constantly :yin.k/exclusive))\n      (undecodable :malformed-custody [:custody]))\n   ;; the child role and install completeness\n   (m \"child-header\" \"installs\"\n      #(edit-task % (fn [t] (update-child t 'host.mod (fn [c] (assoc-in c [:slots 16] {:yin.k/origin origin})))))\n      (undecodable :child-header [:installs 'host.mod :custody]))\n   (m \"install-without-entry\" \"installs\" #(edit-task % (fn [t] (assoc-in t [:slots 12] [])))\n      (fn [w]\n        {:yin.k/status :yin.k/undecodable :yin.k/kind :incomplete-install\n         :yin.k/path [:frames (wait-index (rows/decode w) :install)]}))\n   ;; operation ids\n   (m \"op-id-at-counter\" \"successor\" (edit-op-id #(assoc % :yin.k/seq 3))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :op-seq-range :yin.k/path (put-op w :yin.k/seq)}))\n   (m \"child-op-id-out-of-range\" \"installs\"\n      #(edit-task % (fn [t]\n                      (update-child t 'host.mod\n                                    (fn [c] (update-put c (fn [w] (set-op-id w (op-id 6))))))))\n      (fn [w]\n        {:yin.k/status :yin.k/undecodable :yin.k/kind :op-seq-range\n         :yin.k/path (child-put-op w :yin.k/seq)}))\n   ;; the successor's write carried twice: the same id twice\n   (m \"duplicate-op-id\" \"successor\"\n      #(edit-task % (fn [t] (with-waits t (into (waits t) (waits t)))))\n      (fn [w]\n        {:yin.k/status :yin.k/undecodable :yin.k/kind :duplicate-op-id\n         :yin.k/path [:frames (+ (count (waits (rows/decode w))) (wait-index (rows/decode w) :put)) :op-id]}))\n   (m \"op-id-without-origin\" \"successor\"\n      #(edit-custody % (fn [c] (-> c (dissoc :yin.k/origin) (assoc :yin.k/next-op-seq 0))))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :op-id-without-origin :yin.k/path (put-op w)}))\n   (m \"op-id-own-occurrence\" \"successor\" (edit-op-id #(assoc % :yin.k/occurrence occurrence))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :op-id-own-occurrence :yin.k/path (put-op w)}))\n   (m \"op-id-malformed\" \"successor\" (edit-op-id #(assoc % :yin.k/epoch 0))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :malformed-op-id :yin.k/path (put-op w)}))\n   (m \"op-id-occurrence-not-uuid\" \"successor\" (edit-op-id #(assoc % :yin.k/occurrence \"O\"))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :malformed-op-id :yin.k/path (put-op w)}))\n   (m \"op-id-seq-float\" \"successor\" (edit-op-id #(assoc % :yin.k/seq (cbor/float64 0)))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :inexact :yin.k/path (put-op w :yin.k/seq)}))\n   (m \"op-id-seq-negative\" \"successor\" (edit-op-id #(assoc % :yin.k/seq -1))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :inexact :yin.k/path (put-op w :yin.k/seq)}))\n   ;; a fork (nil slot) carrying an id\n   (m \"fork-op-id\" \"successor\" #(edit-custody % (constantly nil))\n      (fn [w] {:yin.k/status :yin.k/undecodable :yin.k/kind :fork-op-id :yin.k/path (put-op w)}))])\n\n\n(def ^:private fixtures*\n  (delay\n    (into @base-packs\n          (map (fn [{:keys [name base f]}] [name (f (get @base-packs base))]))\n          mutations)))\n\n\n(defn pack-of\n  \"Fixture n's pack (for hash-mismatch and non-canonical, the pack whose\n   bytes they change).\"\n  [n]\n  (get @fixtures* n))\n\n\n(def fixture-names\n  (into base-names (map :name) mutations))\n\n\n(def anchors\n  \"The fixtures whose full bytes the file keeps.\"\n  #{\"first-park\" \"successor\" \"installs\"})\n\n\n(def accepted\n  #{\"first-park\" \"successor\" \"installs\" \"parked\" \"halted-root\" \"variant-equal\" \"variant-other-root\"\n    \"variant-different-intent\" \"variant-counter\" \"counter-at-bound\"})\n\n\n(defn base-of\n  \"The base fixture n mutates, or nil for a base.\"\n  [n]\n  (:base (first (filter #(= n (:name %)) mutations))))\n\n\n(defn refusal\n  \"The map fixture n's refusal must contain, or nil.\"\n  [n]\n  (when-some [{b :base r :refusal} (first (filter #(= n (:name %)) mutations))]\n    (when r (r (base b)))))\n\n\n;; =============================================================================\n;; Bytes and pins\n;; =============================================================================\n\n(defn patch-non-canonical\n  \"bs with its pack version 3 written in the two-byte form 0x1803, a\n   well-formed CBOR item that does not re-encode to itself.\"\n  [bs]\n  (let [k (fx/bytes->hex (cbor/encode :yin.k/version))]\n    (fx/hex->bytes (str/replace-first (fx/bytes->hex bs) (str k \"03\") (str k \"1803\")))))\n\n\n(defn- built-bytes\n  [n]\n  (let [bs (cbor/encode (pack-of n))]\n    (if (= \"non-canonical\" n) (patch-non-canonical bs) bs)))\n\n\n(defn- built-address\n  \"The address pinned for n: its bytes' address, except hash-mismatch,\n   which pins first-park's.\"\n  [n]\n  (segment-address (built-bytes (if (= \"hash-mismatch\" n) \"first-park\" n))))\n\n\n(defn render\n  \"The fixture file's text, computed from the fixtures on this host.\"\n  []\n  (str/join \"\\n\"\n            (map (fn [n]\n                   (let [h (when (contains? anchors n) (fx/bytes->hex (built-bytes n)))]\n                     (str n \"\\n\" (subs (str (built-address n)) 1) \"\\n\"\n                          (apply str (map #(str (subs h % (min (count h) (+ % 64))) \"\\n\")\n                                          (range 0 (count h) 64))))))\n                 fixture-names)))\n\n\n(defn read-file\n  \"The fixture file as {name {:address a :hex h}}, h nil but for an anchor.\"\n  []\n  (let [blocks (remove #(every? str/blank? %)\n                       (partition-by str/blank? (str/split-lines (fx/read-path path))))]\n    (into {}\n          (map (fn [[n a & hex]]\n                 [n {:address (keyword \"segment\" (subs a (count \"segment/\")))\n                     :hex (when (seq hex) (apply str hex))}]))\n          blocks)))\n\n\n(def ^:private file* (delay (read-file)))\n\n\n(defn fixture\n  \"Fixture n's pinned address and its bytes: an anchor's from the file,\n   non-canonical's patched from the successor anchor's, every other built\n   from its pack.\"\n  [n]\n  (let [{:keys [address hex]} (get @file* n)\n        anchor (fn [a] (fx/hex->bytes (:hex (get @file* a))))]\n    {:address address\n     :bytes (cond\n              (some? hex) (fx/hex->bytes hex)\n              (= \"non-canonical\" n) (patch-non-canonical (anchor \"successor\"))\n              :else (cbor/encode (pack-of n)))}))\ntest/yin/vm/ucf/ledger_test.cljc:122:  (testing \"a target this ledger did not mint at that t\"\ntest/yin/vm/ucf/ledger_fixtures.cljc:1:(ns yin.vm.ucf.ledger-fixtures\ntest/yin/vm/ucf/ledger_fixtures.cljc:2:  \"The cross-host ledger fixture of M-next C slice C12: one arbitration\ntest/yin/vm/ucf/ledger_fixtures.cljc:6:   The pins live in test/resources/yin/vm/ucf/ledger-v2.txt: a first\ntest/yin/vm/ucf/ledger_fixtures.cljc:15:   version-3 row packs (yin.vm.ucf.rows-checkpoint-fixtures), each stored\ntest/yin/vm/ucf/ledger_fixtures.cljc:22:            [dao.jing.cbor-fixtures :as cfx]\ntest/yin/vm/ucf/ledger_fixtures.cljc:33:            [yin.vm.ucf.rows-checkpoint-fixtures :as fx]\ntest/yin/vm/ucf/ledger_fixtures.cljc:38:  \"The fixture file, relative to the repository root.\"\ntest/yin/vm/ucf/ledger_fixtures.cljc:39:  \"test/resources/yin/vm/ucf/ledger-v2.txt\")\ntest/yin/vm/ucf/ledger_fixtures.cljc:245:  \"The fixture file's text, computed from `build` on this host.\"\ntest/yin/vm/ucf/ledger_fixtures.cljc:254:  \"The fixture file as `{:digest d :frames [bytes ...]}`.\"\ntest/yin/vm/ucf/ledger_fixtures.cljc:259:      (throw (ex-info \"not a ledger-v2 fixture\" {:path path})))\ntest/yin/vm/ucf/ledger_fixtures.cljc:265:  \"The fixture file's text.\"\ntest/yin/vm/ucf/stage_e_world.cljc:324:   :export/after-minted\ntest/yin/vm/ucf/stage_e_world.cljc:325:   {:site [:progress \"h1\"] :when :after :match (record-is :yin.k/minted nil)}\ntest/yin/vm/ucf/stage_e_world.cljc:1032:                  :successor (let [mint (last (filter\ntest/yin/vm/ucf/stage_e_world.cljc:1034:                                                  (and (= :yin.k/minted (:yin.k/journal r))\ntest/yin/vm/ucf/stage_e_world.cljc:1037:                               (:yin.k/address (fence (:yin.k/occurrence mint))))\ntest/yin/vm/ucf/ledger_fixture_test.cljc:1:(ns yin.vm.ucf.ledger-fixture-test\ntest/yin/vm/ucf/ledger_fixture_test.cljc:2:  \"The cross-host ledger fixture of M-next C slice C12: frames written on\ntest/yin/vm/ucf/ledger_fixture_test.cljc:3:   the JVM and checked in (test/resources/yin/vm/ucf/ledger-v2.txt) fold\ntest/yin/vm/ucf/ledger_fixture_test.cljc:14:            [yin.vm.ucf.ledger-fixtures :as lf]))\ntest/yin/vm/ucf/ledger_fixture_test.cljc:23:  (str \"target/test-ucf-ledger-fixture-\" (random-uuid)))\ntest/yin/vm/ucf/stage_e_scenarios.cljc:217:           successor-mint (last (filter #(and (= :yin.k/minted (:yin.k/journal %))\ntest/yin/vm/ucf/stage_e_scenarios.cljc:220:           successor (:yin.k/occurrence successor-mint)]\ntest/yin/vm/ucf/stage_e_scenarios.cljc:549:  [:export/after-minted :export/after-serve-intent :export/after-serve-ack\ntest/yin/vm/ucf/stage_e_scenarios.cljc:580:           minted (records journal :yin.k/minted nil)\ntest/yin/vm/ucf/stage_e_scenarios.cljc:581:           o (:yin.k/occurrence (first minted))\ntest/yin/vm/ucf/stage_e_scenarios.cljc:586:       (is (<= (count minted) 1) \"one occurrence: never re-minted across the kill\")\ntest/yin/vm/ucf/stage_e_scenarios.cljc:651:           o (:yin.k/occurrence (first (records journal :yin.k/minted nil)))\ntest/yin/vm/ucf/stage_e_scenarios.cljc:685:      ;; the second encoding is minted on the receiver host\ntest/yin/vm/ucf/stage_e_scenarios.cljc:1079:         (is (<= (count (records journal :yin.k/minted nil)) 2) \"no occurrence re-minted\")\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n        m1 (vm/run m0)\n        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n        child (get-in m [:installs 'host.mod :vm])\n        child-stream (s/stream-of child)]\n    {:machine m :kind :blocked :reason :install :trace trace\n     :steps [#(stream/append! child-stream :fed)]\n     :finish #(swap! trace into (tu/drain request))\n     :receiver (link-receiver trace)}))\n\n\n(defn module-context\n  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n  [wrap]\n  (let [request (s/ring 64) response (s/ring 64)\n        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n        m (vm/run m0)\n        src (s/stream-of m)]\n    ;; The carrier holds module stores, not registry entries: the receiver's\n    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n     :receiver (constantly {:opts {:modules (:modules m)}})}))\n\n\n(defn run-beside\n(deftest collection-row-lower-refuses-host-collapse\n  #?(:cljs\n     (doseq [kind [:map :set]]\n       (let [keys [(keyword \"a/b\" \"c\") (keyword \"a\" \"b/c\")]\n             body (cursor-cell-body :s 0)\n             slots (if (= :set kind)\n                     (conj (mapv #(vector :lit %) keys) [:cursor-cell :x])\n                     (vec (mapcat #(vector [:lit %] [:cursor-cell :x]) keys)))\n             task (assoc-in (task-node [[:x body]] [:row (rows/node kind slots)])\n                            [:slots 5] (rows/node :bindings ['anchor [:cursor-cell :x]]))\n             wire (rows/emit task)\n             {:keys [attach!]} (support/attacher)]\n         (is (nil? (error #(rows/decode wire))))\n         (is (= {:yin.k/status :yin.k/undecodable :yin.k/kind :host-collapse\n                 :yin.k/path [(first (first (filter #(= kind (second %)) (:yin.k/rows wire))))]}\n                (verdict (error #(rows/lower-task (support/new-machine) wire attach!)))))))\n     :clj (println \"SKIP host-collapse: slash-crossed identifiers remain distinct on JVM\")\n     :cljd (println \"SKIP host-collapse: slash-crossed identifiers remain distinct on Dart\")))\n\n\n(deftest carried-install-requires-receiver-admission\n  (let [sender-record {:yin.admit/id \"sender-only\"\n                       :yin.admit/decision :allow\n                       :yin.admit/other :future-evidence\n                       :yin.admit/asserters #{'sender}\n                       :yin.admit/address :sender-only}\n        source (update-in (support/parked-installer)\n                          [:installs 'host.mod :response] merge sender-record)\n        wire (support/lift source nil)\n        address (jing/segment-key (:manifest (support/module-response)))\n        recv (support/new-machine)\n        task (rows/decode wire)\n        install (first (nth (:slots task) 12))]\n    (is (not-any? #(contains? (nth (:slots install) 3) %) (keys sender-record)))\n    (let [carried (update-in task [:slots 12 0 :slots 3] merge sender-record)\n          {:keys [attach! count]} (support/attacher)\n          refusal (error #(rows/lower-task recv (rows/emit carried) attach!\n                                           support/installer-lower-opts))]\n      (is (= [:yin.k/undecodable :install-response]\n             ((juxt :yin.k/status :yin.k/kind) refusal)))\n      (is (zero? @count)))\n    (doseq [opts [{} {:yin.k/admitted-modules {'other.mod address}}\n                  {:yin.k/admitted-modules {'host.mod :wrong-address}}\n                  {:yin.k/admitted-modules {'host.mod nil}}]]\n      (let [{:keys [attach! count]} (support/attacher)\n            refusal (error #(rows/lower-task recv wire attach! opts))]\n        (is (= :yin.k/unsatisfied (:yin.k/status refusal)))\n        (is (= {:yin.k/modules {'host.mod address}} (:yin.k/missing refusal)))\n        (is (zero? @count))))\n    (let [{:keys [attach! count]} (support/attacher)\n          restored (rows/lower-task (assoc recv :attach-stream attach!) wire attach! {:yin.k/admitted-modules {'host.mod address}})\n          response (get-in restored [:installs 'host.mod :response])\n          child (get-in restored [:installs 'host.mod :vm])\n          wait (first (:wait-set child))]\n      (is (pos? @count))\n      (is (= install (first (nth (:slots (rows/decode (support/lift restored nil))) 12)))\n          \"relift reproduces the carried install row\")\n      (is (not-any? #(contains? response %) (keys sender-record)))\n      (stream/append! (get (:resources child) (:stream-id wait)) :resume)\n      (let [done (vm/run restored)\n            installed (module/module-entry (:modules (:modules done)) 'host.mod)]\n        (is (= 42 (:value done)))\n        (is (= address (:address installed)))\n        (is (not (contains? installed :admission)))))))\n","exit_code":0,"status":"completed"}}
