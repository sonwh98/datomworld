 physical (nth x (inc i))) (physical (nth x (inc i))))\n                           (nth y (inc i))))))))))\n    (let [image {:instructions expected\n                 :bodies (mapv (fn [{:keys [start end owner]}]\n                                 {:start start :end (dec end)\n                                  :locals (if owner (count (nth (nth v owner) 2)) 0)\n                                  :registers (inc (apply max 0 (mapcat (fn [pc]\n                                                                      (concat (when-let [rd (r/rd (nth expected pc))] [rd])\n                                                                              (r/uses (nth expected pc)))) (range start end))))}) bodies)}]\n      (assert (nil? (r/register-image-defect image)))\n      (prn {:row row :register-validator :pass}))))\n'''\n# r rd/uses check public existence later\nPath('collab/1791850000000-5a-check-hand-numbers.clj').write_text(script)\nPY\nrg -n 'defn (rd|uses)|def operand-table' src/cljc/yin/vm/debruijn_register_code.cljc src/cljc/yin/vm/semantic_register/code.cljc\ncljstyle fix src/cljc/yin/vm/semantic_register/derive.cljc test/yin/vm/semantic_register/derive_test.cljc\nclojure -M:cljs collab/1791850000000-5a-check-hand-numbers.clj > collab/1791850000000-5a-hand-numbers.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
