c t (- (count t) 2)))\n                    :load-free [:free (peek t)]\n                    nil)))\n          v)))\n\n\n(defn resolved-addresses\n  \"Read lexical references from the old resolver'\"'s occurrence tuples.\n   Walk main then queued lambda bodies; definitions visit only their value.\n   This diagnostic reader never lowers or assigns an identity.\\\"\n  [{:keys [tuples]}]\n  (let [attrs (reduce (fn [m [e a v]] (assoc-in m [e a] v)) {} tuples)\n        root (first (keep (fn [[e m]] (when (:yin/root m) e)) attrs))\n        queue (volatile\"'! [])\n        out (volatile! [])]\n    (letfn [(walk [e]\n              (let [m (get attrs e)\n                    child (fn [k] (walk (get m k)))]\n                (case (:yin/type m)\n                  :variable (vswap! out conj\n                                   (if (contains? m :yin.resolved/free)\n                                     [:free (:yin.resolved/free m)]\n                                     [:bound (:yin.resolved/depth m)\n                                      (:yin.resolved/position m)]))\n                  :lambda (vswap! queue conj (:yin/body m))\n                  :application\n                  (let [op (get attrs (:yin/operator m))\n                        args (:yin/operands m)]\n                    (if (= '\"'yin/def (:yin.resolved/free op))\n                      (walk (nth args 1))\n                      (do (child :yin/operator) (doseq [a args] (walk a)))))\n                  :if (doseq [k [:yin/test :yin/consequent :yin/alternate]] (child k))\n                  :stream/put (do (child :yin/target) (child :yin/val))\n                  (:stream/cursor :stream/next :stream/close) (child :yin/source)\n                  :dao.stream.apply/call (doseq [a (:yin/operands m)] (walk a))\n                  :vm/resume (child :yin/val-node)\n                  nil)))]\n      (walk root)\n      (loop [i 0]\n        (when-let [e (get @queue i)] (walk e) (recur (inc i))))\n      @out)))\n\n\n(defn stack-image\n  \\\"Stackify A's parsed expressions, placing closure bodies in FIFO order.\n   Labels and diagnostics are derived solely from A.\\\"\n  [v]\n  (let [{rv :vector bodies :bodies} (resolve v)\n        by-start (into {} (map (juxt :start identity)) bodies)\n        image (volatile\"'! [])\n        side (volatile! {})\n        labels (volatile! {})\n        queue (volatile! [])\n        counter (volatile! 0)\n        label! (fn [] (vswap! counter inc))\n        mark! (fn [l] (vswap! labels assoc l (count @image)))\n        emit! (fn [t] (vswap! image conj t))]\n    (letfn [(walk [node]\n              (let [pc (:pc node)\n                    [op _ x y z] (nth rv pc)\n                    children (:children node)\n                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n                (case (:op node)\n                  :if (let [[c th el] children\n                            else (label!) end (label!)]\n                        (walk c) (emit! [:branch-false else])\n                        (walk th) (emit! [:jump end])\n                        (mark! else) (walk el) (mark! end))\n                  :closure (let [l (label!)]\n                             (vswap! queue conj [l (get by-start y)])\n                             (diagnostic! {:kind :closure :params (nth (nth v pc) 2) :source pc})\n                             (emit! [:closure x l]))\n                  :var (do (diagnostic! {:kind :var :source pc})\n                           (emit! (if (= op :load-bound) [:load-bound x y] [:load-free x])))\n                  :call (do (doseq [child children] (walk child) (emit! [:push]))\n                            (emit! [:call (count y) z]))\n                  :ffi-call (do (doseq [child children] (walk child) (emit! [:push]))\n                                (emit! [:ffi-call x (count y)]))\n                  :stream-put (do (walk (nth children 0)) (emit! [:push])\n                                  (walk (nth children 1)) (emit! [:stream-put]))\n                  (:define :stream-cursor :stream-next :stream-close :resume)\n                  (do (walk (first children))\n                      (emit! (case op\n                               :define [:define x]\n                               :resume [:resume (nth (nth rv pc) 1)]\n                               [op])))\n                  (:const :gensym :store-get :stream-make) (emit! [op x])\n                  :store-put (emit! [op x y])\n                  (:current-continuation :park) (emit! [op]))))\n            (body! [{:keys [expr owner]}]\n              (walk expr)\n              (emit! [(if (nil? owner) :halt :return)]))]\n      (body! (first bodies))\n      (loop [i 0]\n        (when-let [[l body] (get @queue i)]\n          (mark! l) (body! body) (recur (inc i))))\n      {:image (mapv (fn [t]\n                      (case (first t)\n                        (:jump :branch-false) (assoc t 1 (get @labels (nth t 1)))\n                        :closure (assoc t 2 (get @labels (nth t 2)))\n                        t)) @image)\n       :side-table @side})))\n\n\n(defn register-image\n  \"Reserved for slice 5b.\"\n  [_v]\n  (throw (ex-info \"Register derivation is not in slice 5a\" {:reason :not-in-slice-5a})))\nEOF\nsed -n '\"'45,82p' test/yin/vm/debruijn_linearize_test.cljc; sed -n '210,250p' test/yin/vm/debruijn_register_contract_test.cljc; sed -n '70,100p' test/yin/vm/debruijn_register_compile_test.cljc\"","aggregated_output":"  (assoc node :tail? true))\n\n\n(defn- if-node\n  [t c a]\n  {:type :if, :test t, :consequent c, :alternate a})\n\n\n(def ^:private worked-example\n  \"`((fn [x] (+ x 1)) 10)`, the same worked example `yin.vm.linearize-test`\n   uses -- a simple program with no duplicate parameters, no free-variable\n   surprises beyond the primitive `+`, and one level of closure nesting.\"\n  (app (lam '[x] (tail (app (v '+) (v 'x) (lit 1)))) (lit 10)))\n\n\n(def ^:private duplicate-param\n  \"`(fn [x x] x)`: `resolve-name`'s rightmost-wins duplicate-parameter\n   case, the design's own named example for the lift law.\"\n  (lam '[x x] (tail (v 'x))))\n\n\n(def ^:private free-variable\n  \"A body that references a name no enclosing closure binds: `y` lowers\n   to `:load-free`, never `:load-bound`.\"\n  (lam '[x] (tail (app (v '+) (v 'x) (v 'y)))))\n\n\n(def ^:private nested-closure\n  \"Two levels of nesting, an inner body reaching two frames outward, and a\n   duplicate binder at the outer level to exercise both features in one\n   corpus program.\"\n  (app (lam '[a a]\n            (tail (lam '[b]\n                       (tail (app (v '+) (v 'a) (v 'b))))))\n       (lit 1)))\n\n\n(def ^:private corpus\n                (walk (get-attr e :yin/source))\n\n                :vm/resume (walk (get-attr e :yin/val-node))\n\n                nil))]\n      (walk root)\n      (loop [i 0]\n        (when-let [body (get @bodies i)]\n          (walk body)\n          (recur (inc i))))\n      @addrs)))\n\n\n(defn- stack-image-var-addresses\n  \"The sequence of `:load-bound`/`:load-free` operands read off a\n   `:yin.debruijn.code/*` image in pc order, the same shape\n   `resolved-var-addresses` returns.\"\n  [image]\n  (into []\n        (keep (fn [t]\n                (case (nth t 0)\n                  :load-bound [:bound (nth t 1) (nth t 2)]\n                  :load-free [:free (nth t 1)]\n                  nil)))\n        image))\n\n\n(defn resolved-addresses-of\n  \"Public: R1's own three-way address-law test calls this directly\n   (never via var-quote reflection, which does not port to ClojureDart)\n   rather than duplicating this file's fixture-building code.\"\n  [ast]\n  (let [{:keys [tuples]} (dr/resolve (ast-datoms ast))\n        {:keys [get-attr root-id]} (vm/index-datoms tuples)]\n    (resolved-var-addresses get-attr root-id)))\n\n\n(defn stack-addresses-of\n  \"Public for the same reason as `resolved-addresses-of`.\"\n  [ast]\n  (stack-image-var-addresses (:image (dl/adapt (ast-datoms ast)))))\n\n\n(def ^:private nested-closure\n  \"Two levels of nesting, an inner body reaching two frames outward, and a\n   duplicate binder at the outer level -- B2's own lift-law fixture of the\n   same name, reconstructed here.\"\n  (app (lam '[a a]\n            (tail (lam '[b]\n                       (tail (app (v '+) (v 'a) (v 'b))))))\n       (lit 1)))\n\n\n(def ^:private if-program\n  (if-node (app (v '<) (lit 1) (lit 2)) (lit 100) (lit 200)))\n\n\n(def ^:private fixture-b-live-across-branch\n  (app (v '+) (v 'a) (if-node (v 'test) (app (v 'f) (lit 1)) (lit 0))))\n\n\n(def ^:private shared-variable-body\n  (assoc (v 'x) :eid -41))\n\n\n(def ^:private shared-variable-under-two-contexts\n  (app (v 'list) (lam '[x] shared-variable-body) (lam '[y] shared-variable-body)))\n\n\n(def ^:private shared-lambda-body\n  (assoc (lam '[z] (tail (app (v '+) (v 'z) (v 'q)))) :eid -70))\n\n","exit_code":0,"status":"completed"}}
