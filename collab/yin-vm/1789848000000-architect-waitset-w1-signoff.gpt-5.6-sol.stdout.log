        (is (= 1 (count (:woken result))))\n   506\t        (is (= entry (:entry wake)))\n   507\t        (is (= :dao.stream.waitset/unsupported-reason (:status wake)))\n   508\t        (is (= [] (get-in result [:waitset :waiting])))\n   509\t        (is (= store (:store result)))\n   510\t        (is (zero? @calls))\n   511\t        (is (zero? @advances))))))\n   512\t\n   513\t\n   514\t(deftest checking-an-empty-waitset-touches-nothing\n   515\t  (let [{:keys [handle calls]} (counting-reader)\n   516\t        store (alist-store [[:r [handle {:pos 0}]]])\n   517\t        result (waitset/check (waitset/empty-waitset)\n   518\t                              (alist-resolver)\n   519\t                              store)]\n   520\t    (is (= {:waitset {:waiting []} :woken [] :store store} result))\n   521\t    (is (zero? @calls))))\n   522\t\n   523\t\n   524\t(deftest woken-is-per-call-and-entries-come-back-as-given\n   525\t  (let [h (ring-handle)\n   526\t        _ (stream/append! h :a)\n   527\t        blocked-h (:handle (counting-reader))\n   528\t        parked {:reason :next :my/ref :r2 :my/tag :hold}\n   529\t        waking {:reason :next :my/ref :r1 :my/tag :wake}\n   530\t        store (alist-store [[:r1 [h (cursor h :dao.stream/oldest)]]\n   531\t                            [:r2 [blocked-h {:pos 0}]]])\n   532\t        first-check (waitset/check (-> (waitset/empty-waitset)\n   533\t                                       (waitset/park parked)\n   534\t                                       (waitset/park waking))\n   535\t                                   (alist-resolver)\n   536\t                                   store)]\n   537\t    (testing \"one call's woken is one call's results\"\n   538\t      (is (= [:wake] (mapv (comp :my/tag :entry) (:woken first-check))))\n   539\t      ;; `:waiting` holds the entries as stored, not woken-result maps.\n   540\t      (is (= [:hold]\n   541\t             (mapv :my/tag (get-in first-check [:waitset :waiting])))))\n   542\t    (testing \"a repeated check returns only what moved since\"\n   543\t      (let [second-check (waitset/check (:waitset first-check)\n   544\t                                        (alist-resolver)\n   545\t                                        (:store first-check))]\n   546\t        (is (= [] (:woken second-check)))\n   547\t        (is (= (get-in first-check [:waitset :waiting])\n   548\t               (get-in second-check [:waitset :waiting])))))\n   549\t    (testing \"no entry carries a key the host did not put there\"\n   550\t      (doseq [e (concat (map :entry (:woken first-check))\n   551\t                        (get-in first-check [:waitset :waiting]))]\n   552\t        (is (= #{:reason :my/ref :my/tag} (set (keys e))))\n   553\t        (is (not (contains? e :stream)) \"no resolved handle injected\")\n   554\t        (is (not (contains? e :cursor)) \"no polling cursor injected\")))\n   555\t    (testing \"plain-data fixtures round-trip through pr-str/read-string\"\n   556\t      (let [payload {:waitset (:waitset first-check)\n   557\t                     :woken (:woken first-check)}]\n   558\t        (is (= payload (edn/read-string (pr-str payload))))))))\n   559\t\n   560\t\n   561\t(deftest probe-observes-without-committing-and-reparks-to-the-next-value\n   562\t  (let [h (ring-handle)\n   563\t        _ (stream/append! h :a)\n   564\t        store {:my/committed :nothing}\n   565\t        advances (atom 0)\n   566\t        ;; The probe's cursor state is the consumer's own (`:my/cursor` on\n   567\t        ;; the entry), and its advance is identity: the waitset commits\n   568\t        ;; nothing the consumer's compound step does not.\n   569\t        resolver {:resolve (fn [_store entry]\n   570\t                             {:stream h :cursor (:my/cursor entry)})\n   571\t                  :advance (fn [store _entry _cursor]\n   572\t                             (swap! advances inc)\n   573\t                             store)}\n   574\t        probe (fn [c] {:reason :next :my/ref :probe :my/cursor c})\n   575\t        first-check (waitset/check\n   576\t                     (waitset/park (waitset/empty-waitset)\n   577\t                                   (probe (cursor h :dao.stream/oldest)))\n   578\t                     resolver\n   579\t                     store)]\n   580\t    ;; Wakes on readiness and leaves the store identical: the sweep\n   581\t    ;; attempted the write-back and the identity advance committed nothing.\n   582\t    (is (= [:a] (mapv :value (:woken first-check))))\n   583\t    (is (= store (:store first-check)))\n   584\t    (is (= 1 @advances))\n   585\t    ;; The consumer's own step advances its own cursor; re-parking the\n   586\t    ;; probe with it wakes on the NEXT value, not the same one.\n   587\t    (let [stepped (stream/next h\n   588\t                               (:my/cursor (:entry (first (:woken first-check)))))\n   589\t          _ (is (= :a (:dao.stream/value stepped)))\n   590\t          _ (stream/append! h :b)\n   591\t          second-check (waitset/check\n   592\t                        (waitset/park (waitset/empty-waitset)\n   593\t                                      (probe (:dao.stream/cursor stepped)))\n   594\t                        resolver\n   595\t                        store)]\n   596\t      (is (= [:b] (mapv :value (:woken second-check))))\n   597\t      (is (= store (:store second-check))))))\n","exit_code":0,"status":"completed"}}
