   :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :slice-peer {:target :node-script\n                       :main dao.stream.slice-peer/-main\n                       :output-to \"target/slice-peer.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl/-main\n                        :output-to \"target/yin-repl.js\"}}}\n{:tasks\n {test:clj {:doc \"Run JVM tests (via clj)\"\n            :task (shell \"clojure -M:test\")}\n\n  test:cljs {:doc \"Run Node tests (via shadow-cljs with :cljs alias)\"\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile slice-peer test\")}\n\n  build:slice-peer\n  {:doc \"Compile the DaoStream v2 Phase 5 peer as a Dart exe\"\n   ;; Process B of the Phase 5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:cljd compile dao.stream.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/dao/stream/slice-peer.dart -o build/slice-peer\"))}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; Same ahead-of-time constraint as build:slice-peer.  The R5 cross-host\n   ;; tests spawn this one exe from the JVM and Node lanes, so `bb test`\n   ;; builds it first; a bare `bb test:clj` or `bb test:cljs` without it\n   ;; skips those tests with a printed notice rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  test:cljd {:doc \"Run Dart tests (via clojure -M:cljd)\"\n             :depends [build:slice-peer build:yin-repl-peer]\n             :task (shell \"clojure -M:cljd test\")}\n\n  test {:doc \"Run all tests (cross-host R5 pairs need the Dart peer, so build it first)\"\n        :depends [build:yin-repl-peer test:clj test:cljs test:cljd]}}}\n","exit_code":0,"status":"completed"}}
