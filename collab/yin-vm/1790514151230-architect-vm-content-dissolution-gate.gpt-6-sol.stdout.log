e\n   421\t   vector form by construction (pc is the index); rules 5–6 and the UCF\n   422\t   §7.3.4 checks are the eight here. The address check — a vector hashing\n   423\t   to the address it claims — is not a structural rule and is not made\n   424\t   here: a correct hash is never structural validation.\"\n   425\t  [v]\n   426\t  (some #(% v) vector-rules))\n   427\t\n   428\t\n   429\t(defn materialize-vector!\n   430\t  \"Materialize one canonical instruction vector as the exact payload at its\n   431\t   own `(jing/segment-key v)` address (UCF §7.3.4: nothing else may hash\n   432\t   there). The vector is validated (§7.5) first, so a malformed vector is\n   433\t   refused before the write. Returns the address -- the segment's\n   434\t   `:yin.code/hash`.\"\n   435\t  [handle v]\n   436\t  (when-let [defect (well-formed-vector? v)]\n   437\t    (throw (ex-info \"Cannot materialize a vector that fails validation\"\n   438\t                    {:defect defect})))\n   439\t  (jing/materialize! handle v))\n   440\t\n   441\t\n   100\t\n   101\t\n   102\t(deftest materialize-get-validate-round-trips-every-tree-and-vector\n   103\t  (testing \"every corpus tree and its lowered vector, memory backend\"\n   104\t    (let [h (jing-mem/create-content-mem)]\n   105\t      (doseq [[name ast] corpus-trees]\n   106\t        (let [tree (vm/ast->semantic-bytecode ast)\n   107\t              root (vm/materialize-tree! h tree)\n   108\t              loaded (fetch-tree h root)]\n   109\t          (is (= root (:root tree)) (str \"the tree's address is its root row id: \" name))\n   110\t          (is (= tree loaded) (str \"materialize! -> get -> validate round-trips: \" name))\n   111\t          (is (= (vm/semantic-bytecode->ast loaded)\n   112\t                 (vm/semantic-bytecode->ast tree))\n   113\t              (str \"the fetched tree reconstructs to the same map AST: \" name)))\n   114\t        (let [vector (:vector (linearize/lower-rows (vm/ast->semantic-bytecode ast)))\n   115\t              address (code/materialize-vector! h vector)\n   116\t              fetched (fetch-vector h address)]\n   117\t          (is (= (jing/segment-key vector) address)\n   118\t              (str \"a vector materializes under its own segment-key: \" name))\n   119\t          (is (= vector fetched)\n   120\t              (str \"fetch by address returns the exact vector: \" name))))\n   121\t      (jing/close! h))))\n   122\t\n   123\t\n   124\t(deftest file-backend-round-trips-trees-and-vectors\n   125\t  (testing \"the durable backend round-trips the same content, across close and reopen\"\n   126\t    (let [path (temp-path \"u10-roundtrip\")\n   127\t          tree (vm/ast->semantic-bytecode\n   128\t                 {:type :lambda, :params '[x],\n   129\t                  :body {:type :application,\n   130\t                         :operator {:type :variable, :name 'x},\n   131\t                         :operands [{:type :literal, :value 1}] :tail? true}})\n   132\t          vector (:vector (linearize/lower-rows tree))\n   133\t          h (jing-file/create-content-file path)]\n   134\t      (try\n   135\t        (let [root (vm/materialize-tree! h tree)\n   136\t              address (code/materialize-vector! h vector)]\n   137\t          (jing/close! h)\n   138\t          (let [h2 (jing-file/create-content-file path)]\n   139\t            (try\n   140\t              (is (= tree (fetch-tree h2 root)) \"tree after reopen\")\n   141\t              (is (= vector (fetch-vector h2 address)) \"vector after reopen\")\n   142\t              (finally (jing/close! h2)))))\n   143\t        (finally (cleanup-file path))))))\n   250\t        (is (= :descriptor-defect (:reason res)))\n   251\t        (is (= :target-bounds (:rule (:defect res))))))\n   252\t    (jing/close! h))\n   253\t\n   254\t  (testing \"materialize-vector! refuses a malformed vector before the write\"\n   255\t    (let [h (jing-mem/create-content-mem)]\n   256\t      (is (thrown-with-msg? #?(:cljd Object :clj Exception :cljs :default) #\"fails validation\"\n   257\t            (code/materialize-vector! h [[:jump 9]])))\n   258\t      (is (not (contains? (jing-mem/entries h) (jing/segment-key [[:jump 9]]))))\n   259\t      (jing/close! h))))\n   260\t\n   261\t\n   262\t(deftest fetched-vectors-carry-their-address-into-the-vm\n   263\t  (testing \"the UCF section 7.3.4 lane: a fetched vector loads with its\n   264\t            :yin.code/hash recorded in the image and alias column\"\n   265\t    (let [h (jing-mem/create-content-mem)\n   266\t          tree (vm/ast->semantic-bytecode\n   267\t                 {:type :lambda, :params '[x],\n   268\t                  :body {:type :application,\n   269\t                         :operator {:type :variable, :name 'x},\n   270\t                         :operands [{:type :literal, :value 1}]}})\n   271\t          vector (:vector (linearize/lower-rows tree))\n   272\t          address (code/materialize-vector! h vector)\n   273\t          res (lt/fetch-local h {address address} linker/semantic-format\n   274\t                              address receiver\n   275\t                              (requested linker/semantic-format))\n   276\t          loaded (semantic/load-vector (semantic/create-vm) (:value res)\n   277\t                                       (:contract linker/semantic-format))\n   278\t          seg (get-in loaded [:code-aliases address])]\n   279\t      (is (= address (:address res)))\n   280\t      (is (number? seg) \"the address is aliased to a local segment id\")\n     1\t(ns dao.jing.content.driver\n     2\t  \"The JVM blocking driver over the stepped content client\n     3\t   (dao.jing.content.step): host policy that steps the client and\n     4\t   sleeps, returning a synchronous dao.jing content handle. It replaces\n     5\t   the deleted dao.jing.remote blocking constructor; its consumers are\n     6\t   the coordinate opener (dao.jing.coordinate/open!) and, through it,\n     7\t   dao.space and yin.repl.link on the JVM. yin.vm's materialize-tree!\n     8\t   and yin.vm.code's materialize-vector! have no remote path of their\n     9\t   own: they gain one only by being handed a coordinate-built handle.\n    10\t\n    11\t   The returned handle is the plain-data map dao.jing/materialize!,\n    12\t   dao.jing/get, and dao.jing/close! dispatch through:\n    13\t   {:client c :closed-atom a :put-bytes-fn f :get-bytes-fn g\n    14\t    :close-fn h}. A put sends the bytes as Base64 text and answers the\n    15\t   remote verdict; a get decodes the answer the server answers and\n","exit_code":0,"status":"completed"}}
