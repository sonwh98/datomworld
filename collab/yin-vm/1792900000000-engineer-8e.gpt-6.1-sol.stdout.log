it,\n   under their own identities, on one link -- the remote machinery's\n   one-link-per-channel rule.\"\n  {:dao.stream/type :dao.stream.test/channel\n   :dao.stream/identity \"linker-transfer-channel\"})\n\n\n(defn- publisher-leg\n  \"The publishing leg: a dao.jing store, its content pair on two ring\n   buffers, and the mirror that reaches the pair across the channel.\n   It holds the images; what crosses to the receiver is only what the\n   receiver's own requests draw out.\"\n  []\n  (let [requests (ring-handle 64)\n        responses (ring-handle 64)\n        in (ring-handle 64)\n        out (ring-handle 64)\n        oldest (fn [h]\n                 (:dao.stream/cursor\n                   (stream/cursor h :dao.stream/oldest)))]\n    {:store (mem/create-content-mem)\n     :requests requests\n     :responses responses\n     :in in\n     :out out\n     :table {\"content-requests\"\n             {:handle requests, :surface #{:reader :writer}}\n             \"content-answers\"\n             {:handle responses, :surface #{:reader :writer}}}\n     :mirror-cursor (atom (oldest in))\n     :serve-cursor (atom (oldest requests))}))\n\n\n(defn- pump!\n  \"One advance of the publishing leg: the mirror answers every channel\n   request pending against its table, then the content interpreter\n   answers every content request the mirror let through.  The leg owns\n   no thread; the receiver's drive calls it, exactly as the leg's own\n   ticker would on a host of its own.\"\n  [{:keys [in out table mirror-cursor serve-cursor store requests\n           responses]}]\n  (swap! mirror-cursor #(remote/mirror-step table in % out))\n  (swap! serve-cursor\n         (fn [cursor]\n           (loop [c cursor]\ntest/yin/vm/debruijn_register_effects_test.cljc:28:(defn- adapted\ntest/yin/vm/debruijn_register_effects_test.cljc:125:  (let [{:keys [image]} (adapted live-call-ast)\ntest/yin/vm/debruijn_register_effects_test.cljc:157:  (let [{:keys [image]} (adapted tail-call-ast)\ntest/yin/vm/debruijn_register_effects_test.cljc:201:        (let [{:keys [image]} (adapted ast)\ntest/yin/vm/debruijn_register_effects_test.cljc:232:  (let [{:keys [image]} (adapted live-call-ast)\ntest/yin/vm/debruijn/stack_parity_test.cljc:89:(defn- adapted\ntest/yin/vm/debruijn/stack_parity_test.cljc:233:(deftest binder-names-live-only-in-the-side-table\ntest/yin/vm/debruijn/stack_parity_test.cljc:237:                   (keep :params (vals (:side-table (adapted ast)))))]\n\n\n(def ^:private shared-lambda-under-two-contexts\n  (app (v 'list) (lam '[p q] shared-lambda-body) (lam '[r] shared-lambda-body)))\n\n\n(defn- ast-datoms\n  [ast]\n  (second (vm/ast->datoms-with-root ast)))\n\n\n(defn- adapted\n  [ast]\n  (rc/adapt (ast-datoms ast)))\n\n\n(defn- named-vector\n  [ast]\n  (:vector (dl/named-canonical-vector (linearize/lower (ast-datoms ast)))))\n\n\n;; =============================================================================\n;; 1. The contract-version chicken-and-egg with R0\n;; =============================================================================\n;; B1's own precedent (`yin.vm.debruijn-code/lowering-contract-version`)\n;; is that the version lives in src as the canonical source and B0's test\n;; (`debruijn_code_test.cljc`) imports and compares it. R0\n;; (`debruijn_register_contract_test.cljc`) predates this file and could\n;; not import a not-yet-built src namespace, so it froze its own copy of\n;; the integer instead; that file's own box forbids editing it after the\n;; fact. Before design section 4.5, this test applied B1's precedent\n;; one-sidedly, asserting the two integers equal.\n;;\n;; Section 4.5 bumps `rcode/contract-version` to 2 (the `:call` `live`\n;; operand) but its own text assigns re-pinning R0's frozen constant to a\n;; LATER phase, not this one -- so the two are now expected to differ by\n;; exactly the section 4.5 bump, and this test is updated to record that\n;; fact rather than to assert an equality section 4.5 itself breaks.\n\n(deftest contract-version-matches-r0-at-version-4\n  (is (= 4 r0/register-contract-version)\n      \"R0's frozen copy updated to version 4 by Rule R\")\n  (is (= 4 rcode/contract-version)\n      \"src's canonical version at version 4 (Rule R's :define)\")\n  (is (= r0/register-contract-version rcode/contract-version)))\n\n\n;; =============================================================================\n;; 2. Exact image lowerings for every Phase R2 node\n;; =============================================================================\n\n(deftest exact-image-lowering-for-r2-nodes-test\n  (testing \":vm/store-get\"\n    (let [{:keys [image]} (adapted {:type :vm/store-get, :key :my-k})]\n      (is (= [[:store-get 0 :my-k] [:halt 0]] (:instructions image)))))\n\n  (testing \":vm/store-put\"\n    (let [{:keys [image]} (adapted {:type :vm/store-put, :key :my-k, :val 42})]\n      (is (= [[:store-put 0 :my-k 42] [:halt 0]] (:instructions image)))))\n\n  (testing \":vm/gensym\"\n    (let [{:keys [image]} (adapted {:type :vm/gensym, :prefix \"my-prefix\"})]\n      (is (= [[:gensym 0 \"my-prefix\"] [:halt 0]] (:instructions image)))))\n\n  (testing \":stream/make\"\n    (let [{:keys [image]} (adapted {:type :stream/make, :buffer 32})]\n      (is (= [[:stream-make 0 32] [:halt 0]] (:instructions image)))))\n\n  (testing \":stream/put\"\n    (let [{:keys [image]} (adapted {:type :stream/put,\n                                    :target (lit :s),\n                                    :val (lit 99)})]\n      (is (= [[:const 1 :s]\n              [:const 2 99]\n              [:stream-put 0 1 2 []]\n              [:halt 0]]\n             (:instructions image)))))\n\n  (testing \":stream/cursor\"\n    (let [{:keys [image]} (adapted {:type :stream/cursor,\n                                    :source (lit :s)})]\n`:load-free`, are preserved exactly by the root slot.\n\n**Closure values.** A de Bruijn closure (positional marker: segment,\nentry, arity, frames `F`, store-of) reconstructs to the canonical\nclosure (`{:type :closure :params :entry :segment :env}`, evaluator\n§1.8): `params` from A's `:closure` tuple at the owner pc of the entry\nbody, `env` by the forward rule over the closure's captured `F` and the\ntask's `free-env`, `entry` the body pc. The inverse reads `F` back from\n`env` by the chain. Checked both ways (§5.6 item 7).\n\n### 4.5 What a layout never does\n\n**DECIDED.** A layout reads a kernel's state, A and the carried task\ncontext; it never runs code, never fills a binding from the receiver's\nstore or free environment (the free environment is the **carried** one,\n§6.3), never reads a native image's hash as an identity, and never\ninvents a safepoint: a kernel pc whose predecessor is not a parking\ninstruction is `:yin.k/not-at-safepoint` (UCF §7.4.2).\n\n### 4.6 The de Bruijn kernels are backends\n\n**DECIDED** (owner ruling, 2026-10-13; **Amended 2026-10-13\n(backends)**: section added because earlier revisions called these\nkernels, their lanes and their refusals short-lived).\n\n**The model.** `yin.vm.semantic-register` is the canonical semantic VM;\nit is register-shaped because a register-shaped canonical machine is\neasier to lower than the old stack-shaped one. `debruijn/stack.cljc`\nand `debruijn/register.cljc` are **backends** of it: they execute the\nlowerings `A → H` (the stack image) and `A → R` (the register image) of\nthe derivations design §8.2-8.3, and they are not peers of the\ncanonical kernel. Frozen §10 phase 8 deletes the old `yin.vm.semantic`,\n`yin.vm.debruijn-resolve`, `debruijn-linearize` and\n`debruijn-register-compile` (and their tests after replacement\ncoverage), removes `:dim/lift-to` from both de Bruijn descriptors,\nregenerates H and R, and switches the REPL, the linker and\n`publish-closure!` to the A-derived lowerings; **it does not delete the\ntwo kernels.** Every clause of this document that says otherwise is\ncorrected and marked.\n\n**The fragment.** A backend supports a **documented fragment** of what\nthe carrier and the canonical kernel admit, behaves identically to the\nreference on everything it accepts (laws 1, 4, 5 of §5.4 on the shared\nfragment), and refuses before any attach, with a named kind and path,\nwhat it cannot represent. The fragment is **not widened**: no seam is\nplanned for any of the five limits. The five documented limits are:\n\n1. **Ambiguous images** (§4.1): two A of one H or R. Receiver refuses\n   `:yin.k/unsupported :ambiguous-image` before attach; source refuses\n   `:yin.k/non-portable :ambiguous-image` before serving.\n2. **Closures and continuations in the free environment** (§6.3, R3):\n   no finite canonical form through a single task-wide `free-env`.\n   Receiver refuses `:yin.k/unsupported :free-env-value` with the path\n   before attach; source refuses at lift.\n3. **Primitives in the register kernel's payload** (§4.2, D4): the\n   register backend refuses `:yin.k/unsupported\n   :continuation-registers` with the path before attach; the stack\n   backend holds them.\n4. **Link and install rows** (§5.3, R2; matrix rows 7-12 and 17): a\n   backend links a native image while module responses carry A, and §4\n   defines no layout for install children. These rows are outside the\n   native-lane matrix; the reference lane runs them.\n5. **Retained FFI across a de Bruijn receiver** (§4.3, 6c Q2\n   rejected; matrix row 4): the backend's re-park names its own call\n   pair. Row 4 lifts from a de Bruijn source and is not lowered into a\n   de Bruijn receiver (`unlowerable`).\n\nEach limit is pinned by a refusal test (§8.3 items 12, 14, 15; §5.3)\nand is a limit of the backends, never of the carrier or of the\ncanonical kernel. The owner-accepted native-lane matrix (61 law-4 cases\nover three lanes, 350 law-5 transfers; 16 and 92 in the quick tier) is\nthe supported fragment measured, and its justification is this\nsection, not any shelf life (§11, 6c Q1).\n\n**Cross-references.** Frozen design §4.3 and §10 phases 5, 6 and 8;\nderivations design §8.2-8.3 (the lowerings and what phase 8 deletes);\nUCF §7.4.2 (layouts); `yin.vm.ucf-transport-tuples.md` §10 item 6 (the\nthree repository lanes); §0.1 ruling 8, §5.3, §8.5, §9 and §11 here.\n\n---\n\n29:   projection naming the node.\"\n147:           (throw (ex-info (str \"Cannot project node of type \" (tag id))\n188:(defn project-rows\n199:  ([bc] (project-rows bc nil))\n202:     (throw (ex-info \"Cannot project rows with a malformed occurrence origin\"\n205:     (throw (ex-info \"Cannot project rows that fail validation\"\n217:(defn project\n218:  \"`project-rows` ∘ `vm/ast->semantic-bytecode`: a map AST to the\n220:  ([ast] (project ast nil))\n221:  ([ast origin] (project-rows (vm/ast->semantic-bytecode ast) origin)))\n229:  \"The `:yin/*` attribute `vm/ast->datoms` writes for a grammar field.\"\n239:    (throw (ex-info (str \"Cannot project a host value in \" f)\n244:  \"A reader over `vm/index-datoms`' `get-attr`. Datoms are not validated\n257:           (throw (ex-info (str \"Cannot project unsupported node \" t)\n283:(defn project-datoms\n284:  \"Project one AST program, as `[e a v t m]` `:yin/*` datoms, to the\n292:  [datoms]\n293:  (let [{:keys [get-attr root-id error]} (vm/index-datoms (vec datoms))]\n295:      (throw (ex-info \"Cannot project a program with a dangling root\" error)))\n297:      (throw (ex-info \"Cannot project a program with no root\" {})))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p /tmp/8e; cp test/yin/vm/debruijn_*test.cljc /tmp/8e/; cat > /tmp/8e/migrate.py <<'PY'\nfrom pathlib import Path\nimport re\nroot=Path('.')\ndeleted=['debruijn_resolve','debruijn_linearize','debruijn_register_compile','debruijn_register_benchmark','debruijn_vm_contract','debruijn_register_contract']\n# Balanced form boundaries (strings and line comments ignored).\ndef end(s,i):\n    depth=0; instr=False; esc=False; comment=False\n    for j in range(i,len(s)):\n        c=s[j]\n        if comment:\n            if c=='\\\\n': comment=False\n            continue\n        if instr:\n            if esc: esc=False\n            elif c=='\\\\\\\\': esc=True\n            elif c=='\\\"': instr=False\n            continue\n        if c==';': comment=True\n        elif c=='\\\"': instr=True\n        elif c in '([{': depth+=1\n        elif c in ')]}':\n            depth-=1\n            if depth==0: return j+1\n    raise Exception(s[i:i+100])\ndef replace_forms(s,pattern,fn):\n    matches=list(re.finditer(pattern,s))\n    for m in reversed(matches):\n        e=end(s,m.start()); s=s[:m.start()]+fn(s[m.start():e])+s[e:]\n    return s\n# Move all B0 contract facts and public normalizer, preserving tests verbatim.\np=root/'test/yin/vm/debruijn_code_test.cljc'; s=p.read_text(); old=(root/'test/yin/vm/debruijn_vm_contract_test.cljc').read_text()\nreq=old[old.index('(:require '):end(old,old.index('(:require '))]\nfor line in req.splitlines()[1:]:\n    ns=re.search(r'\\\\[([\"'^'\"\\\\s]+)',line)\n    if ns and ns.group(1) not in s[:s.index('\\\\n\\\\n')]:\n        dep=line.strip().rstrip(')'); s=s.replace('[yin.vm.debruijn-code :as dc]',dep+'\\\\n            [yin.vm.debruijn-code :as dc]')\ns+='\\\\n\\\\n;; B0 contract facts and shared normalizer, retained after lowerer retirement.\\\\n'+old[end(old,0):].lstrip(); p.write_text(s)\n# Register contract retained as data checks and address law through A.\np=root/'test/yin/vm/debruijn_register_code_test.cljc'; s=p.read_text().replace('[deftest is]','[deftest is testing]'); old=(root/'test/yin/vm/debruijn_register_contract_test.cljc').read_text(); old=old[end(old,0):]\ns=s.replace('[yin.vm.debruijn-register-code :as rcode]', '[yin.vm :as vm]\\\\n            [yin.vm.parity-test :as parity]\\\\n            [yin.vm.semantic-register.linearize :as sr-linearize]\\\\n            [yin.vm.semantic-register.derive :as derive]\\\\n            [yin.vm.debruijn-register-code :as rcode]')\na=old.index('(defn- ast-datoms'); b=old.index(';; -----------------------------------------------------------------------------',a)\nold=old[:a]+'''(defn resolved-addresses-of [ast]\n  (derive/addresses (:vector (derive/resolve (:vector (sr-linearize/project ast))))))\n\n(defn stack-addresses-of [ast]\n  (derive/addresses (:image (derive/stack-image (:vector (sr-linearize/project ast))))))\n\n'''+old[b:]\nold=old.replace('register-contract-version (:contract-version register-descriptor-fields)', 'register-contract-version rcode/contract-version (:contract-version register-descriptor-fields)')\ns+='\\\\n\\\\n;; Register contract facts retained through projected semantic vectors.\\\\n'+old; p.write_text(s)\n# Migrate kernel builders. AST conversion wrappers are removed, no adapter compatibility layer.\nfor p in list((root/'test').rglob('*.clj'))+list((root/'test').rglob('*.cljc')):\n    if p.stem.removesuffix('_test') in deleted: continue\n    s=p.read_text(); orig=s\n    s=s.replace('yin.vm.debruijn-vm-contract-test','yin.vm.debruijn-code-test').replace('yin.vm.debruijn-register-contract-test','yin.vm.debruijn-register-code-test')\n    if p.as_posix().endswith('semantic_register/derive_test.cljc'):\n        p.write_text(s); continue\n    used=False\n    def convert(form):\n        global used\n        used=True\n        register=bool(re.search(r'rc/',form))\n        # extract argument of adapt/lower call\n        m=re.search(r'\\\\((?:dl|rc)/(?:adapt|lower-stack|lower-register)\\\\s+',form); start=m.end(); arg=form[start:end(form,m.start())-1].strip()\n        if arg.startswith('(tu/resolved-of'):\n            vector='(:vector '+arg+')'\n        else:\n            a=re.fullmatch(r'\\\\(vm/ast->datoms\\\\s+([\\\\s\\\\S]+)\\\\)',arg) or re.fullmatch(r'\\\\(second\\\\s+\\\\(vm/ast->datoms-with-root\\\\s+([\\\\s\\\\S]+)\\\\)\\\\)',arg) or re.fullmatch(r'\\\\((?:ast-datoms|named-datoms)\\\\s+([\\\\s\\\\S]+)\\\\)',arg)\n            vector='(:vector (sr-linearize/project '+a.group(1).strip()+'))' if a else '(:vector (sr-linearize/project-datoms '+arg+'))'\n        call='(derive/'+('register-image' if register else 'stack-image')+' '+vector+')'\n        if form.startswith('(:image '): return call if register else '(:image '+call+')'\n        return '{:image '+call+'}' if register else call\n    s=replace_forms(s,r'\\\\(:image\\\\s+\\\\((?:dl|rc)/(?:adapt|lower-stack|lower-register)\\\\b',convert)\n    s=replace_forms(s,r'\\\\((?:dl|rc)/(?:adapt|lower-stack|lower-register)\\\\b',convert)\n    if used:\n        for ns,alias in [('yin.vm.semantic-register.derive','derive'),('yin.vm.semantic-register.linearize','sr-linearize')]:\n            if '['+ns+' :as' not in s:\n                s=s.replace('(:require ', '(:require ['+ns+' :as '+alias+']\\\\n            ',1)\n    s=re.sub(r'\"'^'\"\\\\s*\\\\[yin.vm.debruijn-(?:linearize|register-compile) :as (?:dl|rc)\\\\]\\\\n','\\\\n',s,flags=re.M) if not re.search(r'\\\\b(?:dl|rc)/',s[s.index('(:require ')+10:]) else s\n    if s\"'!=orig: p.write_text(s)\nPY\npython3 /tmp/8e/migrate.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
