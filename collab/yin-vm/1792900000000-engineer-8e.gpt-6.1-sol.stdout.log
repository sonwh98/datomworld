=====================================================================\n\n(deftest malformed-rows-are-rejected\n  (testing \"an empty vector\"\n    (is (= {:rule :nonempty, :pc 0} (dc/image-defect []))))\n  (testing \"an unknown mnemonic\"\n    (is (= {:rule :mnemonic, :pc 0} (dc/image-defect [[:nope] [:return]]))))\n  (testing \"wrong arity (:const takes exactly one operand)\"\n    (is (= {:rule :arity, :pc 0} (dc/image-defect [[:const 1 2] [:return]]))))\n  (testing \"wrong operand kind (:gensym's prefix is :str)\"\n(ns yin.vm.test-utils\n  \"Composition helpers for the v2 VM suite.\n\n   Every v2 test supplies `:make-stream`: the VM has no default transport, so\n   a test that omits it gets a VM that cannot create streams. The ring buffer\n   is the composition's choice here, not the VM's.\n\n   Telemetry tests read their sink the way any consumer reads a medium —\n   cursor at `:dao.stream/oldest`, then `next` until it blocks — over the\n   unbounded memory log, so an assertion sees every datom a run emitted\n   rather than the tail a ring buffer happened to keep.\n\n   Stream-driven tests thread an observer session — a medium the test owns, a\n   unary attacher bound to it, an attached observer, and a consumer — which\n   is the composition the REPL uses, at test scale. The semantic VM's\n   composition has two such stages over two media\n   (`make-encoder-session`). The VM holds no program stream of its own.\"\n  (:require [dao.stream :as stream]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [dao.stream.observer :as observer]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as ast-walker]\n            [yin.vm.debruijn-resolve :as resolve]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.engine :as engine]\n            [yin.vm.linearize :as linearize]\n            [yin.vm.semantic :as semantic]))\n\n\ntest/yin/vm/linker_test.cljc:2006:      (is (= local (lifted-value (dl/lift (:value fh))))\ntest/yin/vm/linker_test.cljc:2008:      (is (= local (lifted-value (rc/lift (:value fr))))\ntest/yin/vm/linker_test.cljc:2054:                 (lifted-value (dl/lift (:value res)))\ntest/yin/vm/linker_test.cljc:2056:                 :else (lifted-value (rc/lift (:value res))))))\ntest/yin/vm/linker/remote_transfer_test.cljc:88:  [[:H linker/stack-format stack-image dl/lift]\ntest/yin/vm/linker/remote_transfer_test.cljc:89:   [:R linker/register-format register-image rc/lift]])\ntest/yin/vm/debruijn/stack_effects_test.cljc:231:            beneath it, both popped -- `lower-stack` emits target, push,\ntest/yin/vm/semantic_register/derive_test.cljc:156:                          (dl/adapt (vm/ast->datoms ast))\ntest/yin/vm/semantic_register/derive_test.cljc:443:    (let [image (if (= pipeline :old) (:image (rc/adapt (vm/ast->datoms ast)))\ntest/yin/vm/semantic_register/derive_test.cljc:620:                (dvm/create-vm (:image (dl/adapt (vm/ast->datoms ast)))\ntest/yin/vm/semantic_register/derive_test.cljc:626:                   (rvm/create-vm (:image (rc/adapt (vm/ast->datoms ast)))\ntest/yin/vm/linker/cross_host_transfer_test.clj:124:          [[:H linker/stack-format dl/adapt]\ntest/yin/vm/linker/cross_host_transfer_test.clj:125:           [:R linker/register-format rc/adapt]]]\ntest/yin/vm/linker/head_board_test.cljc:553:          (is (= [:refused ::rc/no-port] [(:status r) (:reason r)])))))\ntest/yin/vm/linker/head_board_test.cljc:564:  (is (= [:refused ::rc/no-transport]\ntest/yin/vm/linker/head_board_test.cljc:569:  (is (= [:refused ::rc/no-transport]\ntest/yin/vm/linker/head_board_test.cljc:580:        expected (rc/descriptor-of {:host \"127.0.0.1\" :port 7005\ntest/yin/vm/linker/head_board_test.cljc:588:      (let [sessions (rc/sessions @server)]\ntest/yin/vm/linker/head_board_test.cljc:602:    (is (= ::rc/bind-failed (:reason refused)))\ntest/yin/vm/linker/head_board_test.cljc:613:        (is (= [:refused ::rc/bind-failed {:code :in-