=old[m.start():end(old,m.start())]\n    f=replace_forms(f,r'\\\\(:image \\\\(adapted\\\\b',lambda f:'(derive/register-image (:vector (sr-linearize/project '+f[len('(:image (adapted '):-2]+')))')\n    f=replace_forms(f,r'\\\\(adapted\\\\b',lambda f:'{:image (derive/register-image (:vector (sr-linearize/project '+f[len('(adapted '):-1]+')))}')\n    if name=='validator-rejects-a-well-formed-but-wrong-live-set':\n        # terminal call has no live values; its destination allocation is not pinned.\n        f=f.replace('(and (= :call (nth t 0)) (= 0 (nth t 1)))','(and (= :call (nth t 0)) (= [] (nth t 5)))')\n    s+='\\\\n\\\\n'+f\np.write_text(s)\n# Clean stale docs within changed source/test files and mechanical whitespace only.\nfor p in Path('.').rglob('*.clj*'):\n    if str(p).startswith(('.git/','archive/','build/','.clj-kondo/')): continue\n    # only already changed tracked paths\n    import subprocess\n    changed=subprocess.run(['git','diff','--name-only','--',str(p)],capture_output=True,text=True).stdout\n    if not changed or not p.exists(): continue\n    s=p.read_text(); s=re.sub(r'\\\\n[ \\\\t]*\\\\n(?=\\\\s*\\\\[)', '\\\\n', s) if '(:require' in s else s\n    s=re.sub(r'\\\\n(?:[ \\\\t]*\\\\n){3,}','\\\\n\\\\n\\\\n',s)\n    s='\\\\n'.join(line.rstrip() for line in s.split('\\\\n'))\n    p.write_text(s)\nPY\npython3 /tmp/8e/coverage.py\nclj -M:kondo --lint \"'$(git diff --name-only --diff-filter=AM -- '\"'*.clj' '*.cljc') > /tmp/8e/kondo.log 2>&1\ncat /tmp/8e/kondo.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
