ion \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}}\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\"]\n       