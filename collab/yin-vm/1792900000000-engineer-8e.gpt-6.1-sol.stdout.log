{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/8e/coverage.py <<'PY'\nexec(open('/tmp/8e/migrate.py').read().split('# Move all B0')[0])\n# Remove the diagnostic reader for the retired resolved-tuple representation.\np=Path('src/cljc/yin/vm/semantic_register/derive.cljc'); s=p.read_text(); s=replace_forms(s,r'\\\\(defn resolved-addresses\\\\b',lambda f:''); p.write_text(s)\np=Path('test/yin/vm/semantic_register/derive_test.cljc'); s=p.read_text(); s=s.replace('\\\\n               (derive/addresses (:vector (derive/resolve (projected ast)))))',')') # strip duplicate comparison leg, retain parentheses count\n# above changes count check parser via kondo\n# add scalar/free-name and shared-context explicit expectations from old resolver\ns+='''\n\n(deftest resolution-preserves-scalars-and-contexts\n  (let [a (projected (lit 42))]\n    (is (= [:const 0 42] (first (:vector (derive/resolve a))))))\n  (is (= '#{[:free +] [:free y]}\n         (into #{} (filter #(= :free (first %)))\n               (derive/addresses (projected free-variable)))))\n  (doseq [[label expected]\n          [[:shared-variable-under-two-contexts '[[:free list] [:bound 0 0] [:free x]]]\n           [:shared-lambda-under-two-contexts '[[:free list] [:free +] [:bound 0 0] [:bound 1 1]\n                                              [:free +] [:bound 0 0] [:free q]]]]]\n    (is (= expected (derive/addresses (projected (get contract/address-law-extra-fixtures label)))))))\n'''\n# workload behavior from retired benchmark; keep values and stepped/run parity, retire timing collection.\nold=Path('/tmp/8e/debruijn_register_benchmark_test.cljc').read_text()\nfor name in ['tail-countdown-ast','fibonacci-ast','lexical-binding-ast']:\n    a=old.index('(defn '+name); s+='\\\\n\\\\n'+old[a:end(old,a)]\ns+='''\n\n(deftest native-workload-values-and-step-parity\n  (doseq [[label ast expected] [[:tail-countdown (tail-countdown-ast 500) 0]\n                     