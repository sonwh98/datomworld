{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljd/yin/repl/flutter.cljd | head -90; head -60 src/clj/yin/vm/telemetry_server/jvm.clj; head -60 src/cljs/yin/vm/telemetry_server/node.cljs; rg --files src test | rg '(telemetry|repl|demo_v2|continuation_handoff|await)'\"","aggregated_output":"     1\t(ns yin.repl.flutter\n     2\t  \"A reusable Flutter component to easily embed a Yin.VM REPL server inside any application.\"\n     3\t  (:require [\"dart:async\" :as async]\n     4\t            [\"dart:io\" :as io]\n     5\t            [\"package:flutter/material.dart\" :as m]\n     6\t            [clojure.string :as str]\n     7\t            [yin.repl :as repl]))\n     8\t\n     9\t\n    10\t(def device-ip (m/ValueNotifier \"...\"))\n    11\t(def interface-addresses (m/ValueNotifier []))\n    12\t(def server-status (m/ValueNotifier \"starting\"))\n    13\t(def active-clients (atom 0))\n    14\t(def repl-state (atom nil))\n    15\t(def repl-server (atom nil))\n    16\t\n    17\t\n    18\t(def default-port (if io/Platform.isIOS 7778 7777))\n    19\t\n    20\t\n    21\t(defn load-device-ip!\n    22\t  \"Asynchronously loads the local network interfaces and populates the device-ip and interface-addresses notifiers.\"\n    23\t  []\n    24\t  (.then\n    25\t    ^async/Future (io/NetworkInterface.list)\n    26\t    (fn [interfaces]\n    27\t      (let [found (atom nil)\n    28\t            rows (atom [])]\n    29\t        (doseq [iface (seq interfaces)]\n    30\t          (let [ips (keep (fn [addr]\n    31\t                            (let [a (.-address ^io/InternetAddress addr)]\n    32\t                              (when (str/includes? a \".\")\n    33\t                                (when (and (nil? @found)\n    34\t                                           (not (str/starts-with? a \"127.\")))\n    35\t                                  (reset! found a))\n    36\t                                a)))\n    37\t                          (seq (.-addresses ^io/NetworkInterface iface)))]\n    38\t            (when (seq ips)\n    39\t              (swap! rows conj [(.-name ^io/NetworkInterface iface) ips]))))\n    40\t        (set! (.-value ^m/ValueNotifier device-ip) (or @found \"localhost\"))\n    41\t        (set! (.-value ^m/ValueNotifier interface-addresses) @rows)))))\n    42\t\n    43\t\n    44\t(defn stop-server!\n    45\t  \"Stops the active REPL server and clears the server status.\"\n    46\t  []\n    47\t  (when-let [server @repl-server]\n    48\t    (when-let [stop! (:stop! server)] (stop!))\n    49\t    (reset! repl-server nil)\n    50\t    (set! (.-value ^m/ValueNotifier server-status) \"stopped\")\n    51\t    :stopped))\n    52\t\n    53\t\n    54\t(defn start-server!\n    55\t  \"Starts the REPL server on the specified port (default: 7778 on iOS, 7777 elsewhere) and populates the device-ip and server-status notifiers.\"\n    56\t  [{:keys [port extra-primitives], :or {port default-port}}]\n    57\t  (stop-server!)\n    58\t  (reset! active-clients 0)\n    59\t  (reset! repl-state\n    60\t          (-> (repl/create-state {:vm-type :semantic})\n    61\t              (update :vm update :primitives merge (or extra-primitives {}))))\n    62\t  (reset! repl-server\n    63\t          (repl/serve!\n    64\t            repl-state\n    65\t            port\n    66\t            {;; Unlike the CLI entrypoints, this server is meant to be reached\n    67\t             ;; from another device on the same LAN (see device-ip/\n    68\t             ;; interface-addresses above), so it opts back into binding all\n    69\t             ;; interfaces rather than yin.repl/serve!'s localhost-only default.\n    70\t             :host \"0.0.0.0\",\n    71\t             :on-connect (fn [_stream]\n    72\t                           (let [client-count (swap! active-clients inc)]\n    73\t                             (set! (.-value ^m/ValueNotifier server-status)\n    74\t                                   (repl/connection-status-text client-count)))),\n    75\t             :on-disconnect (fn [_stream]\n    76\t                              (let [client-count (swap! active-clients\n    77\t                                                        (fn [n] (max 0 (dec n))))]\n    78\t                                (set! (.-value ^m/ValueNotifier server-status)\n    79\t                                      (repl/connection-status-text client-count))))}))\n    80\t  (set! (.-value ^m/ValueNotifier server-status)\n    81\t        (repl/connection-status-text @active-clients))\n    82\t  (load-device-ip!))\n    83\t\n    84\t\n    85\t(defn eval-input!\n    86\t  \"Evaluates code in the active REPL state, updates the state, and returns a future with the result string.\"\n    87\t  [code]\n    88\t  (.then ^async/Future (repl/eval-input @repl-state code)\n    89\t         (fn [[state' result]] (reset! repl-state state') result)))\n    90\t\n(ns yin.vm.telemetry-server.jvm\n  (:require\n    [dao.stream :as ds]\n    [dao.stream.ws :as ws]\n    [yin.repl :as repl]))\n\n\n(defn -main\n  [& _args]\n  (let [telemetry-stream (ws/listen! 8091)\n        state-atom (atom (repl/create-state {:telemetry-stream\n                                             telemetry-stream}))\n        _repl-server (repl/serve! state-atom 8090)]\n    (println \"JVM Telemetry server on :8091, REPL on :8090\")\n    ;; Wait forever to keep the process alive\n    @(promise)))\n(ns yin.vm.telemetry-server.node\n  (:require\n    [dao.stream.ws :as ws]\n    [yin.repl :as repl]))\n\n\n(defn -main\n  [& _]\n  (let [telemetry-stream (ws/listen! 8091)\n        state-atom (atom (repl/create-state {:telemetry-stream\n                                             telemetry-stream}))\n        _ (repl/serve! state-atom 8090)]\n    (js/console.log \"Telemetry server on :8091, REPL on :8090\")))\nsrc/clj/yin/vm/telemetry_server/jvm.clj\nsrc/clj/yin/repl/runner.clj\nsrc/clj/yin/repl/host/jvm.clj\nsrc/clj