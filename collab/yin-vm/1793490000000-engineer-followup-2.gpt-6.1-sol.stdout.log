th no leading\n   zero, else :slot-kind.\n\n   Default value markers are plain maps {:yin.k/row abstract-row} and\n   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n   every literal of that shape is refused :yin.k/non-portable. Explicit\n   markers use the caller value encoder.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.stream.apply :as apply2]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.semantic.analysis :as analysis]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.semantic.frame :as frame]\n            [yin.vm.semantic.scan :as scan]\n            [yin.vm.ucf.custody :as custody]\n            [yin.vm.ucf.remote :as remote]))\n\n\n(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n\n\n(def pending-table\n  {:next [:C]\n   :put [[:ref :stream] :V :D]\n   :ffi [:C :D :D]\n   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D :D]\n   :link-response [:D :S [:ref :stream] [:ref :stream] :C :D]\n   :install [:S :D]})\n\n\n(def row-table\n  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n   :refs is an ordered vector of structural references. :pending is\n   discriminated by pending-table. Nothing in this table is executable.\"\n  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n   :env [[:ref :bindings] :optional-D]\n   :closure [:A :N :syms [:ref :bindings] :optional-D]\n   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n   :tail [:A :N [:ref :k]]\n   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n   :kframe [:A :N [:ref :env] [:ref :window] :N]\n   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n   :module-store [:D [:ref :store]]\n   :parked-table [:pairs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n\n\n(defn- bad!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n(ns yin.vm.ucf.rows-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yang.python.antlr.int-contract-fixtures :as ints]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]\n            [yin.vm.ucf.rows-support :as support]\n            [dao.test-slow :as slow]\n            [yin.vm.semantic.frame-test :as ft]\n            [yin.vm.values :as values]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.rows :as rows]))\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n(defn task-node\n  [cursor-cells result]\n  (rows/node :task [3 rows/profile :halted :root 0 (rows/node :bindings [])\n                    (rows/node :store []) [] (rows/node :parked-table [])\n                    (rows/node :cursor-cells (mapcat identity cursor-cells)) {} {} [] [] nil result nil]))\n\n\n(defn cursor-cell-body\n  [stream position]\n  (rows/node :cursor-cell-body [(rows/node :stream [stream {:peer stream}]) position]))\n\n\n(defn fixture\n  [a b x y]\n  (let [payload [:row (rows/node :map\n                                 [[:lit 'both] [:row (rows/node :set [[:cursor-cell x] [:cursor-cell y]])]\n                                  [:lit 'one] [:cursor-cell x]\n                                  [:lit 'streams] [:row (rows/node :set [[:row (rows/node :stream [a {:peer a}])]\n                                                                         [:row (rows/node :stream [b {:peer b}])]])]\n                                  [:lit 'cursors] [:row (rows/node :map [[:cursor-cell x] [:lit :x] [:cursor-cell y] [:lit :y]])]])]\n        task (task-node [[x (cursor-cell-body a 0)] [y (cursor-cell-body b 0)]] [:lit nil])]\n    (rows/node :task (assoc (:slots task) 6 (rows/node :store ['payload payload])))))\n\n\n(declare portable-frame)\n\n\n(defn- encoded\n  [x]\n  (cond (and (map? x) (contains? x :yin.k/row)) [:row (:yin.k/row x)]\n        (and (map? x) (contains? x :yin.k/cursor-cell)) [:cursor-cell (:yin.k/cursor-cell x)]\n        :else [:lit x]))\n\n\n(defn- portable-value\n  [m x]\n  ;; Classify native test values into the decoded codec domain. No seals\n  ;; travel. Captures retain their entire act and K; closures retain the\n  ;; code address, binders, lexical bindings and module context.\n  (cond\n    (values/continuation? x)\n    {:yin.k/row (rows/node :reified\n                           [(rows/decode (rows/frame->rows\n                                           (portable-frame m (ft/canonical m (values/payload x) false)) encoded))])}\n    (values/closure? x)\n    (let [p (values/payload x) e (:env p)]\n      {:yin.k/row (rows/node :closure [(get-in m [:code (:segment p) :address]) (:entry p) (:params p)\n                                       (rows/node :bindings\n                                                  (mapcat (fn [[k v]] [k (encoded (portable-value m v))])\n                                                          (sort #(cbor/encoded-compare (first %1) (first %2))\n                                                                (engine/without-store-of e))))\n                                       (engine/env-store-of e)])})\n    (fn? x) {:yin.k/row (rows/node :prim ['fixture/primitive])}\n    (and (map? x) (= :cursor-ref (:type x))) {:yin.k/cursor-cell (:id x)}\n    (and (map? x) (= :stream-ref (:type x))) {:yin.k/row (rows/node :stream [(:id x) :fixture/served])}\n    (coll? x)\n    (let [kind (cond (map? x) :map (vector? x) :vec (set? x) :set :else :list)\n          xs (if (map? x) (mapcat identity x) x)\n          vs (mapv #(encoded (portable-value m %)) xs)]\n      (if (some #(not= :lit (first %)) vs)\n        {:yin.k/row (rows/node kind vs)}\n        x))\n    :else x))\n\n\n(defn portable-frame\n  [m f]\n  (let [bindings (fn [mappings] (into {} (map (fn [[k v]] [k (portable-value m v)])) mappings))\n        env #(update % :yin.k/bindings bindings)]\n    (cond-> (update f :yin.k/k #(mapv (fn [k]\n                                        (-> k (update :yin.k/env env)\n                                            (update :yin.k/window bindings))) %))\n      (= :act (:yin.k/state f)) (update :yin.k/env env)\ndiff --git a/test/yin/vm/malformed_rows.cljc b/test/yin/vm/malformed_rows.cljc\nindex bbec809b..56b5fc66 100644\n--- a/test/yin/vm/malformed_rows.cljc\n+++ b/test/yin/vm/malformed_rows.cljc\n@@ -1,7 +1,6 @@\n (ns yin.vm.malformed-rows\n-  \"The §7.4/§7.5 published sets: malformed row sets and malformed canonical\n-   instruction vectors, one per rule, for §7.2 part 3's same-refusal\n-   conformance.\"\n+  \"The §7.4 published malformed row sets, one per rule, for\n+   §7.2 part 3's same-refusal conformance.\"\n   (:require [dao.jing :as jing]))\n \n \n@@ -49,25 +48,3 @@\n                        fake-address-b [fake-address-b :stream/cursor fake-address-a]}}]\n      :root-reachable [{:rule :root-reachable, :id lit2-id}\n                       {:root lit1-id, :rows {lit1-id lit1-row, lit2-id lit2-row}}]}))\n-\n-\n-(def malformed-vectors\n-  \"`{name [expected-defect vector]}`, one canonical instruction vector per\n-   §7.5 rule (a rule with several judged kinds or encodings has several\n-   entries). The `[[:jump 9]]` entry is correctly hashed — its address is\n-   `(jing/segment-key [[:jump 9]])`, exactly the content hash of what it\n-   is — and refused anyway: a correct hash is never structural\n-   validation. The list-encoding entries pin the canonical positional\n-   form (UCF §7.3.2): the outer sequence and every tuple are vectors.\"\n-  {:nonempty [{:rule :nonempty, :pc 0} []]\n-   :nonempty-outer-list [{:rule :nonempty, :pc 0} '([:halt])]\n-   :mnemonic [{:rule :mnemonic, :pc 0} [[:frobnicate]]]\n-   :mnemonic-inner-list [{:rule :mnemonic, :pc 0} '[(:halt)]]\n-   :arity [{:rule :arity, :pc 0} [[:const 1 2] [:halt]]]\n-   :operand-kind [{:rule :operand-kind, :pc 0} [[:var \"not-a-sym\"] [:halt]]]\n-   :operand-kind-bool [{:rule :operand-kind, :pc 0} [[:call 0 :truthy] [:halt]]]\n-   :operand-kind-buffer [{:rule :operand-kind, :pc 0} [[:stream-make :bad] [:halt]]]\n-   :saturation [{:rule :saturation, :pc 0} [[:gensym nil] [:halt]]]\n-   :target-bounds [{:rule :target-bounds, :pc 0} [[:jump 9]]]\n-   :terminator [{:rule :terminator, :pc 0} [[:const 1]]]\n-   :argc [{:rule :argc, :pc 0} [[:call -1 false] [:halt]]]})\n","exit_code":0,"status":"completed"}}
