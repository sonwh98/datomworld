kind slots) slots)]\n   472\t                           (let [targets (cond (ref? d) [x] (refs? d) x\n   473\t                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n   474\t                                               :else [])]\n   475\t                             (doseq [target targets]\n   476\t                               (when (and (contains? #{:V :optional-V} d)\n   477\t                                          (not (contains? value-row-kinds (second (get index target)))))\n   478\t                                 (bad! :value-reference-kind [id i]))\n   479\t                               (when (and (or (ref? d) (refs? d))\n   480\t                                          (not (contains? (set (rest d)) (second (get index target)))))\n   481\t                                 (bad! :reference-kind [id i]))\n   482\t                               (walk target (conj active id) (inc depth))))))\n   483\t                       (swap! seen conj id))))]\n   484\t           (walk root #{} 0)\n   485\t           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n   486\t       (doseq [[id & body] rs]\n   487\t         (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n   488\t                        (= id (jing/segment-key (vec body))))\n   489\t           (refuse! :yin.k/hash-mismatch :row [id])))\n   490\t       (doseq [[id kind & slots] rs :when (= :task kind)]\n   491\t         (doseq [[address v] (nth slots 11)]\n   492\t           (when-not (= address (jing/segment-key v))\n   493\t             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n   494\t           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n   495\t       (doseq [[id kind & slots] rs]\n   496\t         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n   497\t         (when (contains? #{:map :bindings :store :parked-table :