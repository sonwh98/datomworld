  613\t                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n   614\t                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n   615\t         pending (:yin.k/pending f)\n   616\t         reason (:yin.k/reason pending)\n   617\t         root (if (contains? f :yin.k/pending)\n   618\t                (node :wait [state (node :pending\n   619\t                                         (into [reason]\n   620\t                                               (map (fn [key d]\n   621\t                                                      (let [x (get pending key)]\n   622\t                                                        (if (= :V d) (encode x) x)))\n   623\t                                                    (get pending-keys reason) (get pending-table reason))))])\n   624\t                state)\n   625\t         [id rows] (emit-node root {} {})]\n   626\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n   627\t\n   628\t\n   629\t(defn- decode-keyed\n   630\t  [n decode-value]\n   631\t  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n   632\t\n   633\t\n   634\t(defn- decode-env\n   635\t  [n decode-value]\n   636\t  (let [[bindings store-of] (:slots n)]\n   637\t    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n   638\t      (some? store-of) (assoc :yin.k/store-of store-of))))\n   639\t\n   640\t\n   641\t(defn- decode-kframe\n   642\t  [n decode-value]\n   643\t  (let [[seg pc e w rd] (:slots n)]\n   644\t    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n   645\t     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n   646\t\n   647\t\n   648\t(defn- decode-frame\n   649\t  [n decode-value]\n   650\t  (if (= :wait (:kind n))\n   651\t    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n   652\t      (assoc (decode