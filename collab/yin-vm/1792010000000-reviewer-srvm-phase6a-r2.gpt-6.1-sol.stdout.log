t              (when (contains? #{:map :set} kind)\n   387\t                (let [vs (if (= :set kind) slots (map first (partition 2 slots)))\n   388\t                      decoded (map value vs)]\n   389\t                  (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n   390\t              (when (and (contains? #{:vec :list :set :map} kind)\n   391\t                         (not (some reference? slots))) (bad! :reference-free-row path))\n   392\t              (doseq [[i d x] (map vector (range) ds slots)]\n   393\t                (let [p (conj path i)]\n   394\t                  (cond\n   395\t                    (= :C d) (do (when-not (contains? cells x) (bad! :missing-cell p)) (swap! reached conj x))\n   396\t                    (and (ref? d) (= :task (:kind x))) (check-task x p)\n   397\t                    (and (ref? d) (not= :cells (:kind x))) (visit x p cells reached)\n   398\t                    (refs? d) (doseq [[j child] (map-indexed vector x)]\n   399\t                                (visit child (conj p j) cells reached))\n   400\t                    (contains? #{:V :optional-V} d)\n   401\t                    (when x\n   402\t                      (case (first x)\n   403\t                        :lit (when-not (literal? (second x)) (bad! :literal p))\n   404\t                        :cell (do (when-not (contains? cells (second x)) (bad! :missing-cell p))\n   405\t                                  (swap! reached conj (second x)))\n   406\t                        :row (visit (second x) p cells reached)))\n   407\t                    :else nil)))))\n   408\t          (check-task\n   409\t            [task path]\n   410\t            (let [slots (:slots task) census (nth slots 9)\n   411\t                  cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n   412\t              (visit task path cells reached)\n   413\t              (when-not (= (set (keys cells)) @reached) (bad! :extra-cell (conj path 9)))))]\n   414\t    (when (= :task (:kind root)) (check-task root []))))\n   415\t\n   416\t\n   417\t(defn- decode*\n   418\t  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n   419\t   form and cell numbering, then expand structural refs. No attachment.\n   420\t   Frame checks are available separately through validate-frames.\"\n   421\t  ([wire] (decode* wire default-budget))\n   422\t  ([wire budget]\n   423\t   (let [budget (merge default-budget budget) counter (atom {})\n   424\t         rs (:yin.k/rows wire)]\n   425\t     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n   426\t                    (code/reg? (:yin.k/version wire)))\n   427\t       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n   428\t     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n   429\t                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n   430\t       (bad! :row-shape [:yin.k/rows]))\n   431\t     (spend! counter budget :rows (count rs))\n   432\t     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n   433\t     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n   434\t           root (:yin.k/root wire)]\n   435\t       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n   436\t       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n   437\t       ;; Gate children before schema, with an active path (DAG sharing is legal).\n   438\t       (letfn [(gate\n   439\t                 [id active]\n   440\t                 (when (contains? active id) (bad! :cyclic [id]))\n   441\t                 (let [row (get index id) slots (when row (subvec row 2))]\n   442\t                   (when-not (and (= :task (second row)) (= 17 (count slots))\n   443\t                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12))