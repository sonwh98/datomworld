it stream correspondence.\n   532\t   Missing marker coverage fails; neither traversal order nor original\n   533\t   cell numbering chooses a logical identity. Accepts a carrier.\"\n   534\t  [wire correspondence]\n   535\t  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n   536\t    (letfn [(rewrite-slot\n   537\t              [d x]\n   538\t              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n   539\t                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n   540\t                    :else x))\n   541\t            (rewrite\n   542\t              [n]\n   543\t              (let [{:keys [kind slots]} n]\n   544\t                (if (= :stream kind)\n   545\t                  (let [id (first slots)]\n   546\t                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n   547\t                    (node :stream [(get correspondence id) (get correspondence id)]))\n   548\t                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n   549\t      (emit (rewrite task)))))\n   550\t\n   551\t\n   552\t(defn- marker-shaped?\n   553\t  [x]\n   554\t  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cell))))\n   555\t\n   556\t\n   557\t(defn- value-node\n   558\t  [x]\n   559\t  ;; Explicit codec values allow 6b to supply already classified guest\n   560\t  ;; markers, without introducing native seals or resource lookup here.\n   561\t  (let [r (:yin.k/row x)]\n   562\t    (cond\n   563\t      (not (marker-shaped? x)) [:lit x]\n   564\t      (and (map? r) (= #{:kind :slots} (set (keys r))) (keyword? (:kind r)) (vector? (:slots r))) [:row r]\n   565\t      (keyword? (:yin.k/cell x)) [:cell (:yin.k/cell x)]\n   566\t      :else (refuse! :yin.k/non-portable :marker []))))\n   567\t\n   568\t\n   569\t(defn- decoded-value\n   570\t  [v]\n   571\t  (case (first v)\n   572\t    :row {:yin.k/ro