numbering (into {} (map-indexed (fn [i [_ members]]\n   305\t                                                           [(first members) (keyword \"yin.k\" (str \"c-\" (inc i)))]) cs))\n   306\t                         [id rows] (emit-node task numbering {})]\n   307\t                     {:numbering numbering :key (bytes-key (cbor/encode (subvec (get rows id) 1)))}))))]\n   308\t       (if (empty? ids) {} (:numbering (search labels 0)))))))\n   309\t\n   310\t\n   311\t(defn emit-numbered\n   312\t  \"Emit under a supplied numbering. Useful for canonicality probes;\n   313\t   ordinary callers use emit, which computes the canonical numbering.\"\n   314\t  [task numbering]\n   315\t  (let [[id rows] (emit-node task numbering {})]\n   316\t    {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))}))\n   317\t\n   318\t\n   319\t(defn emit\n   320\t  \"Emit an abstract task as a self-contained carrier. This is a codec,\n   321\t   not lift-task: the caller supplies the complete abstract row tree.\"\n   322\t  ([task] (emit task default-budget))\n   323\t  ([task budget]\n   324\t   (let [[id rows] (emit-node task (canonical-numbering task budget) {})]\n   325\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n   326\t\n   327\t\n   328\t(defn- structural?\n   329\t  [kind d x]\n   330\t  (cond\n   331\t    (and (= :cells kind) (= :C d)) (and (keyword? x) (some? (re-matches census-key (name x))))\n   332\t    (or (ref? d) (= :C d)) (keyword? x)\n   333\t    (refs? d) (and (vector? x) (every? keyword? x))\n   334\t    (contains? #{:V :optional-V} d)\n   335\t    (or (and (= :optional-V d) (nil? x))\n   336\t        (and (vector? x) (= 2 (count x)) (contains? #{:lit :row :cell} (first x))\n   337\t             (or (= :lit (first x)) (keyword? (second x)))))\n   338\t    (= :N d) (and (code/reg? x) (<= x 4503599627370495))\n   339\t    (= :S d) (symbol? x)\n   340\t    (= :syms d) (and (vector? x) (ev