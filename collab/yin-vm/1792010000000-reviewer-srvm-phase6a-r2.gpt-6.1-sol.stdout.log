:yin.k/rows\n   202\t                         (fn [rs] (mapv #(if (= :install (second %)) (assoc % 6 root) %) rs)))]\n   203\t      (is (= :cyclic (:yin.k/kind (error #(rows/decode cyclic))))))))\n   204\t\n   205\t\n   206\t(deftest numbering-precedes-frame-defect\n   207\t  (let [abstract (fixture :s1 :s2 :x :y)\n   208\t        slots (:slots abstract)\n   209\t        abstract (rows/node :task (assoc slots 5 (rows/node :bindings ['yin/def [:lit 1]])))\n   210\t        wire (rows/emit abstract)\n   211\t        d (error #(rows/decode (rows/emit-numbered abstract {:x :yin.k/c-9 :y :yin.k/c-8})))]\n   212\t    (is (= :noncanonical-cells (:yin.k/kind d)))\n   213\t    (is (= :reserved-name (:yin.k/kind (error #(rows/decode wire)))))))\n   214\t\n   215\t\n   216\t(deftest schema-and-literal-canonicality\n   217\t  (let [body (cell-body :s 0)]\n   218\t    (is (= :missing-cell (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:cell :missing])))))))\n   219\t    (is (= :extra-cell (:yin.k/kind (error #(rows/decode (rows/emit (task-node [[:x body]] [:lit nil])))))))\n   220\t    (is (= :reference-free-row\n   221\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:row (rows/node :vec [[:lit 1]])])))))))\n   222\t    (is (= :value-reference-kind\n   223\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:row (rows/node :window [])])))))))\n   224\t    (let [wire (rows/emit (task-node [] [:lit nil]))]\n   225\t      (is (= :yin.k/unsupported (:yin.k/status (error #(rows/decode wire {:rows 1}))))))\n   226\t    (is (= :literal (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:lit (cbor/encode 1)])))))))\n   227\t    ;; Distinct rows whose decoded elements are equal ([x [1]] = [x (1)]).\n   228\t    (is (= :duplicate-key\n   229\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [[:x body]]\n   230\t                                                                   [:row (rows/node :set [[:row (