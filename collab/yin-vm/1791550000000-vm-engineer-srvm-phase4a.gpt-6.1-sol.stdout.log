{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'config-merge|ns-regexp' bb.edn src/dev/affected.clj; sed -n '135,220p' test/yin/vm/semantic_register/vm_test.cljc\"","aggregated_output":"bb.edn:69:                                 \"compile\" \"test\" \"--config-merge\"\nbb.edn:70:                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\nsrc/dev/affected.clj:473:(defn ns-regexp\nsrc/dev/affected.clj:475:   cljd_agg.clj --slow-regex prints it for shadow-cljs --config-merge.\"\nsrc/dev/affected.clj:683:            \"--config-merge\" (str \"{:ns-regexp \\\"\" (ns-regexp nses) \"\\\"}\")]\n        result (loop [m machine]\n                 (if (vm/halted? m) m\n                     (let [next-state (sr/vm-hot m 1000)]\n                       (when (> (count (:k next-state)) 1) (reset! bounded? false))\n                       (recur next-state))))]\n    (is @bounded?)\n    (is (= \"done\" (vm/value result)))\n    (is (vm/halted? result))\n    (is (nil? (:k result)))))\n\n\n(deftest return-writes-rd-once\n  (let [m (parity/register-machine (corpus/app (corpus/lam '[x] (corpus/v 'x)) (corpus/lit nil)))\n        before (loop [m m]\n                 (let [{:keys [segment pc]} (:control m)]\n                   (if (= :return (first (nth (get-in m [:code segment :vector]) pc))) m (recur (vm/step m)))))\n        frame (peek (:k before)) after (vm/step before)]\n    (is (= (:window frame) (dissoc (:window after) (:rd frame))))\n    (is (contains? (:window after) (:rd frame)))\n    (is (nil? (get (:window after) (:rd frame))))\n    (is (nil? (:k after)))))\n\n\n(deftest halt-shape\n  (doseq [vector [[[:const 0 nil] [:halt 0]] [[:const 0 false] [:halt 0]]]]\n    (let [m (sr/load-vector (sr/create-vm) vector code/contract)\n          m (assoc m :env {engine/store-of-key 'module 'x 1}) after (vm/run m)]\n      (is (nil? (:control after))) (is (nil? (:k after)))\n      (is (:halted? after)) (is (vm/halted? a