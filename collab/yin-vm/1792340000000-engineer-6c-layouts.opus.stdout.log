{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013L3PC9WJW14bvgZXUTMdEa","type":"tool_result","content":"950\t(defn decode\n951\t  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n952\t   For task roots, run X1 and frame validation after numbering.\"\n953\t  ([wire] (decode* wire default-budget))\n954\t  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n955\t\n956\t\n957\t(defn canonical-under\n958\t  \"Test-only §5.5 re-emission under an explicit stream correspondence.\n959\t   Missing marker coverage fails; neither traversal order nor original\n960\t   cursor-cell numbering chooses a logical identity. Accepts a carrier.\"\n961\t  [wire correspondence]\n962\t  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n963\t    (letfn [(rewrite-slot\n964\t              [d x]\n965\t              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n966\t                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n967\t                    :else x))\n968\t            (rewrite\n969\t              [n]\n970\t              (let [{:keys [kind slots]} n]\n971\t                (if (= :stream kind)\n972\t                  (let [id (first slots)]\n973\t                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n974\t                    (node :stream [(get correspondence id) (get correspondence id)]))\n975\t                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n976\t      (emit (rewrite task)))))\n977\t\n978\t\n979\t(defn- value-node\n980\t  [x]\n981\t  (check-literal-markers! x)\n982\t  [:lit x])\n983\t\n984\t\n985\t(defn- decoded-value\n986\t  [v]\n987\t  (case (first v)\n988\t    :row {:yin.k/row (second v)}\n989\t    :cursor-cell {:yin.k/cursor-cell (second v)}\n990\t    :lit (if (marker-shaped? (second v)) (refuse! :yin.k/non-portable :marker []) (second v))))\n991\t\n992\t\n993\t(defn- keyed-node\n994\t  [kind m encode]\n995\t  (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n996\t\n997\t\n998\t(defn- env-node\n999\t  [e encode]\n1000\t  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n1001\t\n1002\t\n1003\t(defn- kframe-node\n1004\t  [f encode]\n1005\t  (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n1006\t                 (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n1007\t\n1008\t\n1009\t(def pending-keys\n1010\t  {:next [:yin.k/cursor-cell]\n1011\t   :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n1012\t   :ffi [:yin.k/cursor-cell :yin.k/call-id :yin.k/op]\n1013\t   :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cursor-cell :yin.k/op-id]\n1014\t   :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell :yin.k/envelope :yin.k/op-id]\n1015\t   :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell]\n1016\t   :install [:yin.k/name]})\n1017\t\n1018\t\n1019\t(defn frame->rows\n1020\t  \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n1021\t   plain literals by default. An explicit value encoder classifies portable\n1022\t   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n1023\t   This reshapes; frame/defect owns semantic validity.\"\n1024\t  ([f] (frame->rows f value-node))\n1025\t  ([f encode]\n1026\t   (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n1027\t         state (if (= :act (:yin.k/state f))\n1028\t                 (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n1029\t                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n1030\t                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n1031\t         pending (:yin.k/pending f)\n1032\t         reason (:yin.k/reason pending)\n1033\t         root (if (contains? f :yin.k/pending)\n1034\t                (node :wait [state (node :pending\n1035\t                                         (into [reason]\n1036\t                                               (map (fn [key d]\n1037\t                                                      (let [x (get pending key)]\n1038\t                                                        (if (= :V d) (encode x) x)))\n1039\t                                                    (get pending-keys reason) (get pending-table reason))))])\n1040\t                state)\n1041\t         [id rows] (emit-node root {} {})]\n1042\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n1043\t\n1044\t\n1045\t(defn- decode-keyed\n1046\t  [n decode-value]\n1047\t  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n1048\t\n1049\t\n1050\t(defn- decode-env\n1051\t  [n decode-value]\n1052\t  (let [[bindings store-of] (:slots n)]\n1053\t    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n1054\t      (some? store-of) (assoc :yin.k/store-of store-of))))\n1055\t\n1056\t\n1057\t(defn- decode-kframe\n1058\t  [n decode-value]\n1059\t  (let [[seg pc e w rd] (:slots n)]\n1060\t    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n1061\t     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n1062\t\n1063\t\n1064\t(defn- decode-frame\n1065\t  [n decode-value]\n1066\t  (if (= :wait (:kind n))\n1067\t    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n1068\t      (assoc (decode-frame state decode-value) :yin.k/pending\n1069\t             (into {:yin.k/reason reason}\n1070\t                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n1071\t                        (get pending-keys reason) (get pending-table reason) slots))))\n1072\t    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n1073\t          k (if act? k e)]\n1074\t      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n1075\t               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n1076\t               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n1077\t        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n1078\t        (not act?) (assoc :yin.k/site pc)))))\n1079\t\n1080\t\n1081\t(defn rows->frame\n1082\t  \"Validate row syntax and hashes, then reshape to the keyed frame.\n1083\t   Semantic code/context rules remain frame/defect's responsibility.\n1084\t   The default decoder produces in-band row/cursor-cell markers that the default\n1085\t   encoder refuses. frame->rows after rows->frame is identity only when\n1086\t   both sides are given a classifier for those values.\"\n1087\t  ([wire] (rows->frame wire decoded-value))\n1088\t  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n1089\t\n1090\t\n1091\t(defn validate-frames\n1092\t  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n1093\t   X1 first, then waits, parked states, and all reified values. Return the\n1094\t   first defect with the abstract row path, or nil.\"\n1095\t  [task]\n1096\t  (let [slots (:slots task) code-map (nth slots 11)\n1097\t        free-env (decode-keyed (nth slots 5) decoded-value)\n1098\t        waits (nth slots 13)\n1099\t        ffi-ids (into #{} (keep (fn [w]\n1100\t                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n1101\t                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n1102\t        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n1103\t    (letfn [(judge\n1104\t              [n context context-map path]\n1105\t              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n1106\t                (-> d (assoc :yin.k/status :yin.k/undecodable)\n1107\t                    (update :yin.k/path #(into path %)))))\n1108\t            (captures\n1109\t              [n path]\n1110\t              (if (= :reified (:kind n))\n1111\t                (or (judge (first (:slots n)) :captured ctx path)\n1112\t                    (captures (first (:slots n)) (conj path 0)))\n1113\t                (some (fn [[i d x]]\n1114\t                        (cond\n1115\t                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n1116\t                          (ref? d) (captures x (conj path i))\n1117\t                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n1118\t                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n1119\t                          :else nil))\n1120\t                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n1121\t      (or\n1122\t        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n1123\t        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n1124\t        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n1125\t              (partition 2 (:slots (nth slots 8))))\n1126\t        (captures task [])))))\n1127\t\n1128\t\n1129\t;; =============================================================================\n1130\t;; Task transport (continuation design §7): lift-task and lower-task\n1131\t;; =============================================================================\n1132\t;;\n1133\t;; The lift walks a quiescent semantic-register machine into the abstract\n1134\t;; task the codec above emits: waits, parked records, the store, module\n1135\t;; stores, the free environment, the result and install children, every\n1136\t;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n1137\t;; cursor cell's source is the resource id of a cursor reference, or\n1138\t;; [response-resource position] for a link wait's kept response cursor,\n1139\t;; so one resource reached twice is one cursor cell. The lower decodes the\n1140\t;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n1141\t;; custody for every task of the tree, and only then attaches streams and\n1142\t;; restores state. Restoration delivers nothing, runs nothing.\n1143\t\n1144\t(defn- outcome!\n1145\t  [status kind data]\n1146\t  (throw (ex-info \"Task transport refused\"\n1147\t                  (merge data (cond-> {:yin.k/status status}\n1148\t                                (some? kind) (assoc :yin.k/kind kind))))))\n1149\t\n1150\t\n1151\t(defn- unliftable-hold\n1152\t  \"The first hold of m with no wire pending (UCF 7.4.1, 7.4.3), or nil.\"\n1153\t  [m]\n1154\t  (let [waits (:wait-set m)\n1155\t        cells (filter map? (vals (:resources m)))\n1156\t        held? #(and (map? %) (contains? % :yin.k/held))]\n1157\t    (cond\n1158\t      (some #(= :observe (:reason %)) waits) :observe\n1159\t      (or (some held? waits) (some held? cells)) :held\n1160\t      (some :yin.k/unminted cells) :unminted-cursor\n1161\t      (seq (:yin.k/closes m)) :pending-close\n1162\t      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor))) waits)\n1163\t      :link-cursor-not-installed\n1164\t      :else nil)))\n1165\t\n1166\t\n1167\t(defn- stream-row!\n1168\t  \"The :stream row of resource sid, served once per resource.\"\n1169\t  [ctx sid]\n1170\t  (or (get-in @(:acc ctx) [:streams sid])\n1171\t      (let [h (get (:resources (:m ctx)) sid)]\n1172\t        (when (nil? h)\n1173\t          (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint sid}))\n1174\t        (let [marker (remote/lift-marker (:serve! ctx) h)]\n1175\t          (when (nil? marker) (outcome! :yin.k/unsatisfied nil {}))\n1176\t          (let [n (node :stream [(:dao.stream/identity marker) (:dao.stream/descriptor marker)])]\n1177\t            (swap! (:acc ctx) assoc-in [:streams sid] n)\n1178\t            n)))))\n1179\t\n1180\t\n1181\t(defn- cell!\n1182\t  [ctx source sid position]\n1183\t  (when-not (contains? (:cells @(:acc ctx)) source)\n1184\t    (let [stream (stream-row! ctx sid)]\n1185\t      (swap! (:acc ctx) assoc-in [:cells source] (node :cursor-cell-body [stream position]))))\n1186\t  source)\n1187\t\n1188\t\n1189\t(defn- cell-for!\n1190\t  [ctx cid]\n1191\t  (let [cell (get (:resources (:m ctx)) cid)]\n1192\t    (when-not (and (map? cell) (contains? cell :stream-id))\n1193\t      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint cid}))\n1194\t    (cell! ctx cid (:stream-id cell) (:cursor cell))))\n1195\t\n1196\t\n1197\t(defn- address!\n1198\t  [ctx seg]\n1199\t  (if-some [a (get-in (:m ctx) [:code seg :address])]\n1200\t    (do (swap! (:acc ctx) update :segments conj a) a)\n1201\t    (outcome! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg})))\n1202\t\n1203\t\n1204\t(defn- scalar-literal?\n1205\t  [x]\n1206\t  (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (number? x)\n1207\t      (and (not (cbor/byte-payload? x)) (cbor/numeric? x))))\n1208\t\n1209\t\n1210\t(defn- primitive-name\n1211\t  [ctx f]\n1212\t  (let [m (:m ctx)\n1213\t        n (vm/name-of (:primitives m) (or (:primitive-canonical-names m) {}) f)\n1214\t        profile (when (symbol? n) (vm/profile-of (:primitives m) n))]\n1215\t    (cond\n1216\t      (nil? n) (outcome! :yin.k/non-portable :unnamed-function {})\n1217\t      (not (symbol? n)) (outcome! :yin.k/non-portable :ambiguous-primitive {})\n1218\t      (= :host (:yin.k/class profile)) (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name n})\n1219\t      :else n)))\n1220\t\n1221\t\n1222\t(declare lift-value state-node)\n1223\t\n1224\t\n1225\t(defn- collection-value\n1226\t  \"A guest collection: a literal when no member is a reference.\"\n1227\t  [ctx kind members original]\n1228\t  (let [vs (mapv #(lift-value ctx %) members)]\n1229\t    (if (every? #(= :lit (first %)) vs) [:lit original] [:row (node kind vs)])))\n1230\t\n1231\t\n1232\t(defn- bindings-node\n1233\t  [ctx e]\n1234\t  (node :bindings (mapcat (fn [[k v]] [k (lift-value ctx v)]) e)))\n1235\t\n1236\t\n1237\t(defn- context!\n1238\t  \"Record that segment a can run from pc at under environment e: a\n1239\t   closure's entry, an :act's or a return frame's pc (§7.1's discharge).\"\n1240\t  [ctx a at e]\n1241\t  (swap! (:acc ctx) update :contexts conj {:a a :at at :env (or e {})}))\n1242\t\n1243\t\n1244\t(defn- store-of!\n1245\t  [ctx e]\n1246\t  (let [store-of (engine/env-store-of e)]\n1247\t    (when (some? store-of) (swap! (:acc ctx) update :stores conj store-of))\n1248\t    store-of))\n1249\t\n1250\t\n1251\t(defn- lift-env-node\n1252\t  [ctx e]\n1253\t  (let [e (or e {})]\n1254\t    (node :env [(bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n1255\t\n1256\t\n1257\t(defn- closure-node\n1258\t  [ctx c]\n1259\t  (let [e (or (:env c) {})\n1260\t        a (address! ctx (:segment c))]\n1261\t    (context! ctx a (:entry c) e)\n1262\t    (node :closure [a (:entry c) (vec (:params c))\n1263\t                    (bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n1264\t\n1265\t\n1266\t(defn- lift-value\n1267\t  \"One machine value as a carrier value: [:lit x], [:row n] or\n1268\t   [:cursor-cell source]. A reference is authenticated before it is\n1269\t   encoded; a foreign value, a heap cell and a host object refuse.\"\n1270\t  [ctx x]\n1271\t  (let [m (:m ctx)]\n1272\t    (cond\n1273\t      (values/host-typed? x)\n1274\t      (cond\n1275\t        (not (values/owned-by? x (:owner m)))\n1276\t        (outcome! :yin.k/non-portable :foreign-value {:yin.k/hint (values/kind-of x)})\n1277\t        (values/closure? x) [:row (closure-node ctx (values/payload x))]\n1278\t        (values/continuation? x) [:row (node :reified [(state-node ctx (values/payload x))])]\n1279\t        :else (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint (values/kind-of x)}))\n1280\t      (fn? x) [:row (node :prim [(primitive-name ctx x)])]\n1281\t      (map? x)\n1282\t      (case (:type x)\n1283\t        :stream-ref (if (engine/authentic-ref? m :stream-ref x)\n1284\t                      [:row (stream-row! ctx (:id x))]\n1285\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n1286\t        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)\n1287\t                      [:cursor-cell (cell-for! ctx (:id x))]\n1288\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))\n1289\t        :parked-continuation (if (contains? (:parked m) (:id x))\n1290\t                               [:row (node :parked-ref [(:id x)])]\n1291\t                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))\n1292\t        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})\n1293\t        (collection-value ctx :map (mapcat identity x) x))\n1294\t      (vector? x) (collection-value ctx :vec x x)\n1295\t      (set? x) (collection-value ctx :set (vec x) x)\n1296\t      (seq? x) (collection-value ctx :list (vec x) x)\n1297\t      (scalar-literal? x) [:lit x]\n1298\t      :else (outcome! :yin.k/non-portable :host-object {}))))\n1299\t\n1300\t\n1301\t(defn- window-node\n1302\t  [ctx w]\n1303\t  (node :window (mapcat (fn [[r v]] [r (lift-value ctx v)]) w)))\n1304\t\n1305\t\n1306\t(defn- k-node\n1307\t  [ctx k]\n1308\t  (node :k (mapv (fn [f]\n1309\t                   (let [a (address! ctx (:segment f))]\n1310\t                     (context! ctx a (:pc f) (:env f))\n1311\t                     (node :kframe [a (:pc f) (lift-env-node ctx (:env f))\n1312\t                                    (window-node ctx (:window f)) (:rd f)])))\n1313\t                 (or k []))))\n1314\t\n1315\t\n1316\t(defn- state-node\n1317\t  \"An evaluator payload (wait entry, parked record, reified payload) as\n1318\t   its :act or :tail row; engine fields are the pending's.\"\n1319\t  [ctx p]\n1320\t  (if (contains? p :site)\n1321\t    ;; a tail state resumes through its K: its own segment never runs again\n1322\t    (node :tail [(address! ctx (:segment p)) (:site p) (k-node ctx (:k p))])\n1323\t    (let [a (address! ctx (:segment p))]\n1324\t      (context! ctx a (:pc p) (:env p))\n1325\t      (node :act [a (:pc p) (lift-env-node ctx (:env p))\n1326\t                  (window-node ctx (:window p)) (k-node ctx (:k p)) (get-in p [:deliver :rd])]))))\n1327\t\n1328\t\n1329\t(defn- pending-node\n1330\t  \"The observed wait's pending (draft §5.3): the reason is the entry's,\n1331\t   never the site's static kind.\"\n1332\t  [ctx e]\n1333\t  (let [m (:m ctx)]\n1334\t    (case (:reason e)\n1335\t      :next (if (contains? e :call-id)\n1336\t              (node :pending [:ffi (cell-for! ctx (get-in e [:cursor-ref :id])) (:call-id e) (:op e)])\n1337\t              (node :pending [:next (cell-for! ctx (get-in e [:cursor-ref :id]))]))\n1338\t      :put (if (:request-sent e)\n1339\t             (let [carried? (and (:response-cursor e) (:response-stream e))\n1340\t                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)\n1341\t                   response (if carried? (:response-stream e) vm/call-out-stream-key)]\n1342\t               (when-not (get (:resources m) cursor) (outcome! :yin.k/unsatisfied nil {}))\n1343\t               (node :pending [:ffi-request (:call-id e) (lift-value ctx (:datom e)) (stream-row! ctx (:stream-id e))\n1344\t                               (stream-row! ctx response) (cell-for! ctx cursor) (:op-id e)]))\n1345\t             (do (when-not (contains? e :datom) (outcome! :yin.k/non-portable :incomplete-write {}))\n1346\t                 (node :pending [:put (stream-row! ctx (:stream-id e)) (lift-value ctx (:datom e)) (:op-id e)])))\n1347\t      (:link-request :link-response)\n1348\t      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))\n1349\t            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]\n1350\t        (node :pending (if (= :link-request (:reason e)) (conj base (:envelope e) (:op-id e)) base)))\n1351\t      :install (do (when-not (contains? (:installs m) (:name e))\n1352\t                     (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name (:name e)}))\n1353\t                   (node :pending [:install (:name e)]))\n1354\t      (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/reason (:reason e)}))))\n1355\t\n1356\t\n1357\t(defn- store-node\n1358\t  [ctx s]\n1359\t  (node :store (mapcat (fn [[k v]]\n1360\t                         (when-not (= :lit (first (lift-value ctx k)))\n1361\t                           (outcome! :yin.k/non-portable :store-key {}))\n1362\t                         [k (lift-value ctx v)])\n1363\t                       s)))\n1364\t\n1365\t\n1366\t(defn- module-store-nodes\n1367\t  \"Every module store an environment or closure reaches, transitively.\"\n1368\t  [ctx]\n1369\t  (loop [done {}]\n1370\t    (if-let [mid (first (sort-by str (remove #(contains? done %) (:stores @(:acc ctx)))))]\n1371\t      (let [stores (:module-stores (:m ctx))]\n1372\t        (when-not (contains? stores mid)\n1373\t          (outcome! :yin.k/non-portable :missing-module-store {:yin.k/hint mid}))\n1374\t        (recur (assoc done mid (node :module-store [mid (store-node ctx (get stores mid))]))))\n1375\t      (mapv val (sort-by #(str (key %)) done)))))\n1376\t\n1377\t\n1378\t(defn- installing-names\n1379\t  [m]\n1380\t  (into #{} (mapcat (fn [[mn inst]]\n1381\t                      (map #(symbol (name mn) (name %))\n1382\t                           (get-in inst [:response :manifest :yin.module/exports]))))\n1383\t        (:installs m)))\n1384\t\n1385\t\n1386\t(defn live-pcs\n1387\t  \"The pcs of v control flow can still reach from at: the successor\n1388\t   relation (§8.1), so a backward jump makes earlier code live, and from\n1389\t   each reachable :closure its body from the entry, since reachable code\n1390\t   can still construct it.\"\n1391\t  [v at]\n1392\t  (loop [seen #{at}\n1393\t         todo [at]]\n1394\t    (if-let [p (peek todo)]\n1395\t      (let [t (nth v p)\n1396\t            fresh (remove seen (cond-> (analysis/successors v p)\n1397\t                                 (= :closure (nth t 0)) (conj (nth t 3))))]\n1398\t        (recur (into seen fresh) (into (pop todo) fresh)))\n1399\t      seen)))\n1400\t\n1401\t\n1402\t(defn- discharge!\n1403\t  \"The dependency closure over the v4 vectors (§7.1), after the walk that\n1404\t   found the contexts: every free occurrence control flow can still reach\n1405\t   from a carried context (live-pcs) is answered there, in resolve-var's\n1406\t   order: that context's\n1407\t   E, then the one store engine/active-store selects for it (the root\n1408\t   store, or the module store its store-of names; both travel), then a\n1409\t   primitive, an installing module's export, the module registry. Else\n1410\t   the lift is :yin.k/unsatisfied, discovery :incomplete.\"\n1411\t  [ctx code]\n1412\t  (let [m (:m ctx)\n1413\t        installing (installing-names m)\n1414\t        answered? (fn [sym e]\n1415\t                    (let [store-of (engine/env-store-of e)\n1416\t                          store (if (some? store-of) (get (:module-stores m) store-of {}) (:store m))]\n1417\t                      (or (vm/reserved-name? sym) (contains? e sym) (contains? store sym)\n1418\t                          (let [profile (vm/profile-of (:primitives m) sym)]\n1419\t                            (when (= :host (:yin.k/class profile))\n1420\t                              (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name sym}))\n1421\t                            (or (some? profile) (contains? installing sym)\n1422\t                                (and (some? (namespace sym))\n1423\t                                     (some? (module/resolve-module (:modules m)\n1424\t                                                                   (symbol (str (namespace sym) \".\" (name sym)))))))))))\n1425\t        scanned (into {} (map (fn [[a v]] [a (scan/free-occurrences v)])) code)\n1426\t        missing (into #{}\n1427\t                      (mapcat (fn [{:keys [a at env]}]\n1428\t                                (let [live (live-pcs (get code a) at)]\n1429\t                                  (keep (fn [o]\n1430\t                                          (when (and (contains? live (:at o))\n1431\t                                                     (not (answered? (:name o) env)))\n1432\t                                            (:name o)))\n1433\t                                        (get scanned a)))))\n1434\t                      (:contexts @(:acc ctx)))]\n1435\t    (when (seq missing)\n1436\t      (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:obligations missing}}))))\n1437\t\n1438\t\n1439\t(declare lift-task*)\n1440\t\n1441\t\n1442\t(defn- install-node\n1443\t  [ctx mn inst opts]\n1444\t  (let [{:keys [phase parent response]} inst]\n1445\t    (when-not (contains? #{:running :parked} phase)\n1446\t      (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name mn :yin.k/phase phase}))\n1447\t    (when-not (try (cbor/encode response) true\n1448\t                   (catch #?(:cljd Object :clj Throwable :cljs :default) _e false))\n1449\t      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n1450\t    (node :install [mn phase parent response\n1451\t                    (lift-task* (:vm inst) (:serve! ctx) (dissoc opts :free-env) :child)])))\n1452\t\n1453\t\n1454\t(defn- lift-task*\n1455\t  [m serve! opts role]\n1456\t  (when (seq (:ready-queue m))\n1457\t    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n1458\t  (when-some [h (unliftable-hold m)]\n1459\t    (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/hold h}))\n1460\t  (when (some? (:control m))\n1461\t    (outcome! :yin.k/not-at-safepoint nil {:yin.k/pc (get-in m [:control :pc])}))\n1462\t  (let [value (:value m)\n1463\t        active? (and (map? value) (= :parked-continuation (:type value)) (contains? (:parked m) (:id value)))\n1464\t        kind (cond active? :parked\n1465\t                   (seq (:wait-set m)) :blocked\n1466\t                   (engine/halted-with-empty-queue? m) :halted\n1467\t                   :else (outcome! :yin.k/not-at-safepoint nil {}))\n1468\t        ;; §6.3: the explicit argument overrides the kernel's retained field\n1469\t        free-env (cond (some? (:free-env opts)) (:free-env opts)\n1470\t                       (some? (:free-env m)) (:free-env m)\n1471\t                       :else (outcome! :yin.k/non-portable :missing-free-env {}))\n1472\t        ctx {:m m :serve! serve! :acc (atom {:streams {} :cells {} :stores #{} :segments #{} :contexts #{}})}\n1473\t        free-node (bindings-node ctx free-env)\n1474\t        waits (mapv (fn [e] (node :wait [(state-node ctx e) (pending-node ctx e)])) (:wait-set m))\n1475\t        parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n1476\t        store (store-node ctx (:store m))\n1477\t        result (when (= :halted kind) (lift-value ctx value))\n1478\t        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n1479\t        module-stores (module-store-nodes ctx)\n1480\t        acc @(:acc ctx)\n1481\t        segments (:segments acc)\n1482\t        code (into {} (map (fn [a]\n1483\t                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n1484\t                               [a v]\n1485\t                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n1486\t                   segments)\n1487\t        _ (discharge! ctx code)\n1488\t        index (or (:source-index opts) {})\n1489\t        missing-trees (into #{} (remove #(seq (get index %))) segments)\n1490\t        _ (when (seq missing-trees)\n1491\t            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n1492\t        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n1493\t                  :yin.k/segments segments\n1494\t                  :yin.k/trees (select-keys index segments)}\n1495\t        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n1496\t                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n1497\t                          (when (= :parked kind) (:id value)) result nil])]\n1498\t    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n1499\t    (when-let [d (validate-frames task)]\n1500\t      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n1501\t    task))\n1502\t\n1503\t\n1504\t(defn lift-task\n1505\t  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n1506\t   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n1507\t   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n1508\t   opts: :free-env, the task's initial free environment (default: the\n1509\t   kernel's retained :free-env field; the explicit value overrides it);\n1510\t   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n1511\t   must cover every carried segment; :budget, the numbering budget.\"\n1512\t  ([m serve!] (lift-task m serve! {}))\n1513\t  ([m serve! opts]\n1514\t   (let [opts (or opts {})]\n1515\t     (emit (lift-task* m serve! opts :root) (merge default-budget (:budget opts))))))\n1516\t\n1517\t\n1518\t(def ^:private fixed-resource-keys\n1519\t  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key\n1520\t    module/link-request-resource module/link-response-resource})\n1521\t\n1522\t\n1523\t(defn- fresh-key!\n1524\t  [used]\n1525\t  (loop [n (inc (count @used))]\n1526\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n1527\t      (if (contains? @used k) (recur (inc n)) (do (swap! used conj k) k)))))\n1528\t\n1529\t\n1530\t(defn- rows-of\n1531\t  \"Every row of kind under n; install children too unless own-only.\"\n1532\t  [n kind own-only?]\n1533\t  (let [out (atom [])]\n1534\t    (letfn [(visit\n1535\t              [n]\n1536\t              (when (= kind (:kind n)) (swap! out conj n))\n1537\t              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n1538\t                (cond\n1539\t                  (and (ref? d) (= :task (:kind x))) (when-not own-only? (visit x))\n1540\t                  (ref? d) (visit x)\n1541\t                  (refs? d) (run! visit x)\n1542\t                  (and (value-slot? d) (vector? x) (= :row (first x))) (visit (second x))\n1543\t                  :else nil)))]\n1544\t      (visit n)\n1545\t      @out)))\n1546\t\n1547\t\n1548\t(defn- task-tree\n1549\t  \"[task role] for the root and every install child, pre-order.\"\n1550\t  [task role]\n1551\t  (into [[task role]] (mapcat #(task-tree (nth (:slots %) 4) :child)) (nth (:slots task) 12)))\n1552\t\n1553\t\n1554\t(defn- check-stores!\n1555\t  \"Step 7's task context, beside X1: no root or module store key is a\n1556\t   reserved name (Rule R), refused here rather than by restore's store-put.\"\n1557\t  [_recv task _role]\n1558\t  (let [[_ _ _ _ _ _ store module-stores] (:slots task)]\n1559\t    (doseq [s (cons store (map #(second (:slots %)) module-stores))\n1560\t            k (take-nth 2 (:slots s))]\n1561\t      (when (vm/reserved-name? k)\n1562\t        (outcome! :yin.k/undecodable :reserved-name {:yin.k/role :store-key :yin.k/name k})))))\n1563\t\n1564\t\n1565\t(defn- attaches?\n1566\t  \"The receiving kernel admits vector v (its loader's validation), under\n1567\t   address a when a is given.\"\n1568\t  [recv v a]\n1569\t  (try (let [r (module/attach-module recv v)] (or (nil? a) (contains? (:code-aliases r) a)))\n1570\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))\n1571\t\n1572\t\n1573\t(defn- check-install!\n1574\t  \"One install record: a phase the engine holds a carried child in, the\n1575\t   retained response link-install reads (status, manifest naming this\n1576\t   module, exports) with the image spawn-child loads, and a child that\n1577\t   is blocked: the engine links a halted child in the sweep it halts in.\"\n1578\t  [recv inst]\n1579\t  (let [[mn phase _ response child] (:slots inst)\n1580\t        manifest (when (map? response) (:manifest response))\n1581\t        child-kind (nth (:slots child) 2)]\n1582\t    (when-not (contains? #{:running :parked} phase)\n1583\t      (outcome! :yin.k/undecodable :install-phase {:yin.k/name mn :yin.k/phase phase}))\n1584\t    (when-not (and (map? response) (= :ok (:status response)) (map? manifest)\n1585\t                   (= mn (:yin.module/name manifest))\n1586\t                   (coll? (:yin.module/exports manifest)) (every? symbol? (:yin.module/exports manifest))\n1587\t                   (map? (:image response)) (attaches? recv (:value (:image response)) nil))\n1588\t      (outcome! :yin.k/undecodable :install-response {:yin.k/name mn}))\n1589\t    (when-not (= :blocked child-kind)\n1590\t      (outcome! :yin.k/undecodable :install-child {:yin.k/name mn :yin.k/task-kind child-kind}))))\n1591\t\n1592\t\n1593\t(defn- check-pendings!\n1594\t  \"Step 8, pending and operations: role, kind, parked id, every :install\n1595\t   pending names a carried install, every install record.\"\n1596\t  [recv task role]\n1597\t  (let [[_ _ kind role' _ _ _ _ parked _ _ _ installs waits parked-id] (:slots task)]\n1598\t    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n1599\t    (let [names (into #{} (map #(first (:slots %))) installs)]\n1600\t      (doseq [w waits]\n1601\t        (let [[reason n] (:slots (second (:slots w)))]\n1602\t          (when (and (= :install reason) (not (contains? names n)))\n1603\t            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n1604\t    (case kind\n1605\t      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1606\t      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1607\t      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n1608\t                (outcome! :yin.k/undecodable :parked-id {}))\n1609\t      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1610\t    (run! #(check-install! recv %) installs)))\n1611\t\n1612\t\n1613\t(defn- check-closure!\n1614\t  \"A closure row names a :closure tuple of its carried vector: the entry\n1615\t   (:closure-origin) and that tuple's binders (:closure-binders), as\n1616\t   lower-closure will demand.\"\n1617\t  [code c]\n1618\t  (let [[a entry params] (:slots c)\n1619\t        v (get code a)\n1620\t        _ (when (nil? v) (outcome! :yin.k/undecodable :segment {:yin.k/segment a}))\n1621\t        tuple (first (filter #(and (= :closure (nth % 0)) (= entry (nth % 3))) v))]\n1622\t    (cond\n1623\t      (nil? tuple) (outcome! :yin.k/undecodable :closure-origin {:yin.k/segment a :yin.k/entry entry})\n1624\t      (not= params (nth tuple 2)) (outcome! :yin.k/undecodable :closure-binders {:yin.k/segment a :yin.k/entry entry})\n1625\t      :else nil)))\n1626\t\n1627\t\n1628\t(defn- check-dependencies!\n1629\t  \"Step 9, dependency closure: requires and code agree, every segment has\n1630\t   its trees (§6.1), every closure's and frame's store-of names a module\n1631\t   store of this task (not a parent's or sibling's of the same key), every\n1632\t   segment is a vector the receiver's kernel admits under its A, every\n1633\t   closure names a closure of its code, every :prim is the receiver's.\"\n1634\t  [recv task _role]\n1635\t  (let [[_ _ _ _ _ _ _ module-stores _ _ requires code] (:slots task)]\n1636\t    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n1637\t      (outcome! :yin.k/undecodable :requires {}))\n1638\t    (let [trees (:yin.k/trees requires)\n1639\t          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n1640\t      (when (seq missing)\n1641\t        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n1642\t    ;; §2.6: every store-of resolves to a module store this task carries\n1643\t    (let [census (into #{} (map #(first (:slots %))) module-stores)\n1644\t          missing (into #{} (comp (keep #(nth (:slots %) (if (= :closure (:kind %)) 4 1)))\n1645\t                                  (remove census))\n1646\t                        (concat (rows-of task :closure true) (rows-of task :env true)))]\n1647\t      (when (seq missing)\n1648\t        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/stores missing}})))\n1649\t    (doseq [[a v] (sort-by #(str (key %)) code)]\n1650\t      (when-not (attaches? recv v a)\n1651\t        (outcome! :yin.k/undecodable :segment {:yin.k/segment a})))\n1652\t    (run! #(check-closure! code %) (rows-of task :closure true))\n1653\t    (doseq [p (rows-of task :prim true)]\n1654\t      (when-not (contains? (:primitives recv) (first (:slots p)))\n1655\t        (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))\n1656\t\n1657\t\n1658\t(defn- check-custody!\n1659\t  \"Step 10: phase 6 carries fork custody only.\"\n1660\t  [_recv task _role]\n1661\t  (when (some? (nth (:slots task) 16))\n1662\t    (outcome! :yin.k/unsupported :custody {})))\n1663\t\n1664\t\n1665\t(defn- attach-streams!\n1666\t  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n1667\t  [attach! task]\n1668\t  (reduce (fn [acc s]\n1669\t            (let [[identity descriptor] (:slots s)]\n1670\t              (if (contains? acc identity)\n1671\t                acc\n1672\t                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n1673\t                  (assoc acc identity h)\n1674\t                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n1675\t          {} (rows-of task :stream false)))\n1676\t\n1677\t\n1678\t(defn- spawn-child\n1679\t  \"A fresh install child of recv's composition (the engine's spawn\n1680\t   discipline): answers [child recv'].\"\n1681\t  [recv response mn]\n1682\t  (let [n (or (:origins recv) 0)\n1683\t        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n1684\t        registry (reduce (fn [r [m e]] (module/assoc-module r m (dissoc e :bindings)))\n1685\t                         (:modules recv) (module/module-entries (:modules recv)))\n1686\t        source (:secret-source recv)]\n1687\t    [(module/spawn-module recv (:value (:image response))\n1688\t                          {:modules registry :origin origin\n1689\t                           :ancestry (conj (vec (:ancestry recv)) mn)\n1690\t                           :capability-secret (when (fn? source) (source origin))})\n1691\t     (assoc recv :origins (inc n))]))\n1692\t\n1693\t\n1694\t(defn- restore-task\n1695\t  \"Step 12 for one task: code by A, fresh resource keys, values re-sealed\n1696\t   under recv, waits as engine entries, parked records, installs.\"\n1697\t  [recv task handles]\n1698\t  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n1699\t        (:slots task)\n1700\t        base (reduce (fn [r [_ v]] (module/attach-module r v))\n1701\t                     (assoc recv :code {} :code-aliases {} :program nil)\n1702\t                     (sort-by #(str (key %)) code))\n1703\t        aliases (:code-aliases base)\n1704\t        used (atom (into fixed-resource-keys (keys (:resources base))))\n1705\t        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n1706\t        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n1707\t        pairs (mapv vec (partition 2 (:slots census)))\n1708\t        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n1709\t        bodies (into {} pairs)\n1710\t        stream-key #(get stream-keys (first (:slots %)))\n1711\t        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n1712\t        cache (atom {})\n1713\t        resolving (atom #{})]\n1714\t    (letfn [(value\n1715\t              [v]\n1716\t              (case (first v)\n1717\t                :lit (second v)\n1718\t                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n1719\t                :row (row (second v))))\n1720\t            (row\n1721\t              [n]\n1722\t              (let [ss (:slots n)]\n1723\t                (case (:kind n)\n1724\t                  :vec (mapv value ss)\n1725\t                  :list (apply list (map value ss))\n1726\t                  :set (into #{} (map value) ss)\n1727\t                  :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n1728\t                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n1729\t                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n1730\t                  :closure (let [[a entry params bindings store-of] ss]\n1731\t                             (module/lower-closure base\n1732\t                                                   (cond-> {:yin.k/binding :named\n1733\t                                                            :yin.k/format :yin.semantic-register/code\n1734\t                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n1735\t                                                            :yin.k/env (keyed bindings)}\n1736\t                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n1737\t                                                   identity))\n1738\t                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n1739\t                  :parked-ref (parked-record (first ss)))))\n1740\t            (keyed\n1741\t              [n]\n1742\t              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n1743\t            (env\n1744\t              [n]\n1745\t              (let [[b store-of] (:slots n)]\n1746\t                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n1747\t            (k-of\n1748\t              [n]\n1749\t              (mapv (fn [f]\n1750\t                      (let [[a pc e w rd] (:slots f)]\n1751\t                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n1752\t                    (:slots n)))\n1753\t            (payload\n1754\t              [n]\n1755\t              (if (= :tail (:kind n))\n1756\t                (let [[a site k] (:slots n)]\n1757\t                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n1758\t                (let [[a pc e w k rd] (:slots n)]\n1759\t                  {:segment (get aliases a) :pc pc :env (env e) :window (keyed w) :k (k-of k)\n1760\t                   :deliver {:deliver :rd :rd rd}})))\n1761\t            (parked-record\n1762\t              [p]\n1763\t              (or (get @cache p)\n1764\t                  (do (when (contains? @resolving p)\n1765\t                        (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint :parked-cycle}))\n1766\t                      (swap! resolving conj p)\n1767\t                      (let [r (assoc (payload (get parked-index p)) :type :parked-continuation :id p)]\n1768\t                        (swap! cache assoc p r)\n1769\t                        (swap! resolving disj p)\n1770\t                        r))))\n1771\t            (cell-stream\n1772\t              [c]\n1773\t              (stream-key (first (:slots (get bodies c)))))\n1774\t            (entry\n1775\t              [w]\n1776\t              (let [[state pending] (:slots w)\n1777\t                    [reason & xs] (:slots pending)\n1778\t                    p (payload state)]\n1779\t                (case reason\n1780\t                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n1781\t                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n1782\t                  :ffi (let [[c call-id op] xs]\n1783\t                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n1784\t                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n1785\t                           (some? op) (assoc :op op)))\n1786\t                  :put (let [[s v op-id] xs]\n1787\t                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n1788\t                           (some? op-id) (assoc :op-id op-id)))\n1789\t                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n1790\t                                     datom (value envelope)]\n1791\t                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n1792\t                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n1793\t                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n1794\t                                   (some? op-id) (assoc :op-id op-id)))\n1795\t                  (:link-request :link-response)\n1796\t                  (let [[link-id mn _ _ c envelope op-id] xs]\n1797\t                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n1798\t                                   :request module/link-request-resource :response module/link-response-resource\n1799\t                                   :cursor (second (:slots (get bodies c))))\n1800\t                      (= :link-request reason) (assoc :envelope envelope)\n1801\t                      (some? op-id) (assoc :op-id op-id)))\n1802\t                  :install (assoc p :reason :install :name (first xs)))))]\n1803\t      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n1804\t            stores (into {} (map (fn [ms]\n1805\t                                   (let [[mid s] (:slots ms)]\n1806\t                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n1807\t                         module-stores)\n1808\t            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n1809\t            entries (mapv entry waits)\n1810\t            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n1811\t                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n1812\t                       waits)\n1813\t            [base installs'] (reduce (fn [[r acc] inst]\n1814\t                                       (let [[mn phase parent response child] (:slots inst)\n1815\t                                             [spawned r'] (spawn-child r response mn)]\n1816\t                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n1817\t                                                            :vm (restore-task spawned child handles)})]))\n1818\t                                     [base {}] installs)\n1819\t            fe (keyed free-env)\n1820\t            resources (merge (:resources base)\n1821\t                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n1822\t                             (into {} (map (fn [[c body]]\n1823\t                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n1824\t                                                                 :cursor (second (:slots body))}]))\n1825\t                                   pairs)\n1826\t                             (when-let [[req resp] link]\n1827\t                               {module/link-request-resource (get handles (first (:slots req)))\n1828\t                                module/link-response-resource (get handles (first (:slots resp)))}))\n1829\t            machine (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n1830\t                           :resources resources :env fe :free-env fe :window {} :k nil :control nil\n1831\t                           :ready-queue [] :id-counter (max (or (:id-counter base) 0) id-counter))]\n1832\t        (case kind\n1833\t          :halted (assoc machine :halted? true :blocked? false :value (value result) :wait-set [])\n1834\t          :parked (assoc machine :halted? true :blocked? false :value (get parked' parked-id) :wait-set entries)\n1835\t          (assoc machine :halted? false :blocked? true :value :yin/blocked :wait-set entries))))))\n1836\t\n1837\t\n1838\t(defn lower-task\n1839\t  \"The lower of §7.2 into recv, a fresh semantic-register machine of the\n1840\t   receiver's composition: gate to frames (decode) and the store keys,\n1841\t   then pendings and install records, dependency closure (code, closures,\n1842\t   primitives) and custody, each step over the whole tree before the\n1843\t   next, all before the first attach! (step 11); then restore (step 12),\n1844\t   which therefore meets no carrier defect. Answers the restored machine,\n1845\t   or throws the first refusal as ex-data.\"\n1846\t  ([recv wire attach!] (lower-task recv wire attach! {}))\n1847\t  ([recv wire attach! opts]\n1848\t   (let [task (decode wire (merge default-budget (:budget opts)))]\n1849\t     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n1850\t     ;; each step over the whole tree before the next (§3.3)\n1851\t     (doseq [step [check-stores! check-pendings! check-dependencies! check-custody!]\n1852\t             [t role] (task-tree task :root)]\n1853\t       (step recv t role))\n1854\t     (restore-task recv task (attach-streams! attach! task)))))"}]},"parent_tool_use_id":null,"session_id":"b921a1a6-65e4-4bc4-853c-fc87c8b912fe","uuid":"46fedfd9-487d-4e43-979b-6f25bf574e33","timestamp":"2026-10-12T17:42:21.226Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/src/cljc/yin/vm/ucf/rows.cljc","content":"(defn decode\n  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n   For task roots, run X1 and frame validation after numbering.\"\n  ([wire] (decode* wire default-budget))\n  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n\n\n(defn canonical-under\n  \"Test-only §5.5 re-emission under an explicit stream correspondence.\n   Missing marker coverage fails; neither traversal order nor original\n   cursor-cell numbering chooses a logical identity. Accepts a carrier.\"\n  [wire correspondence]\n  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n    (letfn [(rewrite-slot\n              [d x]\n              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n                    :else x))\n            (rewrite\n              [n]\n              (let [{:keys [kind slots]} n]\n                (if (= :stream kind)\n                  (let [id (first slots)]\n                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n                    (node :stream [(get correspondence id) (get correspondence id)]))\n                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n      (emit (rewrite task)))))\n\n\n(defn- value-node\n  [x]\n  (check-literal-markers! x)\n  [:lit x])\n\n\n(defn- decoded-value\n  [v]\n  (case (first v)\n    :row {:yin.k/row (second v)}\n    :cursor-cell {:yin.k/cursor-cell (second v)}\n    :lit (if (marker-shaped? (second v)) (refuse! :yin.k/non-portable :marker []) (second v))))\n\n\n(defn- keyed-node\n  [kind m encode]\n  (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n\n\n(defn- env-node\n  [e encode]\n  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n\n\n(defn- kframe-node\n  [f encode]\n  (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n                 (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n\n\n(def pending-keys\n  {:next [:yin.k/cursor-cell]\n   :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n   :ffi [:yin.k/cursor-cell :yin.k/call-id :yin.k/op]\n   :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cursor-cell :yin.k/op-id]\n   :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell :yin.k/envelope :yin.k/op-id]\n   :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell]\n   :install [:yin.k/name]})\n\n\n(defn frame->rows\n  \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n   plain literals by default. An explicit value encoder classifies portable\n   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n   This reshapes; frame/defect owns semantic validity.\"\n  ([f] (frame->rows f value-node))\n  ([f encode]\n   (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n         state (if (= :act (:yin.k/state f))\n                 (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n         pending (:yin.k/pending f)\n         reason (:yin.k/reason pending)\n         root (if (contains? f :yin.k/pending)\n                (node :wait [state (node :pending\n                                         (into [reason]\n                                               (map (fn [key d]\n                                                      (let [x (get pending key)]\n                                                        (if (= :V d) (encode x) x)))\n                                                    (get pending-keys reason) (get pending-table reason))))])\n                state)\n         [id rows] (emit-node root {} {})]\n     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n\n(defn- decode-keyed\n  [n decode-value]\n  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n\n\n(defn- decode-env\n  [n decode-value]\n  (let [[bindings store-of] (:slots n)]\n    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n      (some? store-of) (assoc :yin.k/store-of store-of))))\n\n\n(defn- decode-kframe\n  [n decode-value]\n  (let [[seg pc e w rd] (:slots n)]\n    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n\n\n(defn- decode-frame\n  [n decode-value]\n  (if (= :wait (:kind n))\n    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n      (assoc (decode-frame state decode-value) :yin.k/pending\n             (into {:yin.k/reason reason}\n                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n                        (get pending-keys reason) (get pending-table reason) slots))))\n    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n          k (if act? k e)]\n      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n        (not act?) (assoc :yin.k/site pc)))))\n\n\n(defn rows->frame\n  \"Validate row syntax and hashes, then reshape to the keyed frame.\n   Semantic code/context rules remain frame/defect's responsibility.\n   The default decoder produces in-band row/cursor-cell markers that the default\n   encoder refuses. frame->rows after rows->frame is identity only when\n   both sides are given a classifier for those values.\"\n  ([wire] (rows->frame wire decoded-value))\n  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n\n\n(defn validate-frames\n  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n   X1 first, then waits, parked states, and all reified values. Return the\n   first defect with the abstract row path, or nil.\"\n  [task]\n  (let [slots (:slots task) code-map (nth slots 11)\n        free-env (decode-keyed (nth slots 5) decoded-value)\n        waits (nth slots 13)\n        ffi-ids (into #{} (keep (fn [w]\n                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n    (letfn [(judge\n              [n context context-map path]\n              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n                (-> d (assoc :yin.k/status :yin.k/undecodable)\n                    (update :yin.k/path #(into path %)))))\n            (captures\n              [n path]\n              (if (= :reified (:kind n))\n                (or (judge (first (:slots n)) :captured ctx path)\n                    (captures (first (:slots n)) (conj path 0)))\n                (some (fn [[i d x]]\n                        (cond\n                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n                          (ref? d) (captures x (conj path i))\n                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n                          :else nil))\n                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n      (or\n        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n              (partition 2 (:slots (nth slots 8))))\n        (captures task [])))))\n\n\n;; =============================================================================\n;; Task transport (continuation design §7): lift-task and lower-task\n;; =============================================================================\n;;\n;; The lift walks a quiescent semantic-register machine into the abstract\n;; task the codec above emits: waits, parked records, the store, module\n;; stores, the free environment, the result and install children, every\n;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n;; cursor cell's source is the resource id of a cursor reference, or\n;; [response-resource position] for a link wait's kept response cursor,\n;; so one resource reached twice is one cursor cell. The lower decodes the\n;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n;; custody for every task of the tree, and only then attaches streams and\n;; restores state. Restoration delivers nothing, runs nothing.\n\n(defn- outcome!\n  [status kind data]\n  (throw (ex-info \"Task transport refused\"\n                  (merge data (cond-> {:yin.k/status status}\n                                (some? kind) (assoc :yin.k/kind kind))))))\n\n\n(defn- unliftable-hold\n  \"The first hold of m with no wire pending (UCF 7.4.1, 7.4.3), or nil.\"\n  [m]\n  (let [waits (:wait-set m)\n        cells (filter map? (vals (:resources m)))\n        held? #(and (map? %) (contains? % :yin.k/held))]\n    (cond\n      (some #(= :observe (:reason %)) waits) :observe\n      (or (some held? waits) (some held? cells)) :held\n      (some :yin.k/unminted cells) :unminted-cursor\n      (seq (:yin.k/closes m)) :pending-close\n      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor))) waits)\n      :link-cursor-not-installed\n      :else nil)))\n\n\n(defn- stream-row!\n  \"The :stream row of resource sid, served once per resource.\"\n  [ctx sid]\n  (or (get-in @(:acc ctx) [:streams sid])\n      (let [h (get (:resources (:m ctx)) sid)]\n        (when (nil? h)\n          (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint sid}))\n        (let [marker (remote/lift-marker (:serve! ctx) h)]\n          (when (nil? marker) (outcome! :yin.k/unsatisfied nil {}))\n          (let [n (node :stream [(:dao.stream/identity marker) (:dao.stream/descriptor marker)])]\n            (swap! (:acc ctx) assoc-in [:streams sid] n)\n            n)))))\n\n\n(defn- cell!\n  [ctx source sid position]\n  (when-not (contains? (:cells @(:acc ctx)) source)\n    (let [stream (stream-row! ctx sid)]\n      (swap! (:acc ctx) assoc-in [:cells source] (node :cursor-cell-body [stream position]))))\n  source)\n\n\n(defn- cell-for!\n  [ctx cid]\n  (let [cell (get (:resources (:m ctx)) cid)]\n    (when-not (and (map? cell) (contains? cell :stream-id))\n      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint cid}))\n    (cell! ctx cid (:stream-id cell) (:cursor cell))))\n\n\n(defn- address!\n  [ctx seg]\n  (if-some [a (get-in (:m ctx) [:code seg :address])]\n    (do (swap! (:acc ctx) update :segments conj a) a)\n    (outcome! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg})))\n\n\n(defn- scalar-literal?\n  [x]\n  (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (number? x)\n      (and (not (cbor/byte-payload? x)) (cbor/numeric? x))))\n\n\n(defn- primitive-name\n  [ctx f]\n  (let [m (:m ctx)\n        n (vm/name-of (:primitives m) (or (:primitive-canonical-names m) {}) f)\n        profile (when (symbol? n) (vm/profile-of (:primitives m) n))]\n    (cond\n      (nil? n) (outcome! :yin.k/non-portable :unnamed-function {})\n      (not (symbol? n)) (outcome! :yin.k/non-portable :ambiguous-primitive {})\n      (= :host (:yin.k/class profile)) (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name n})\n      :else n)))\n\n\n(declare lift-value state-node)\n\n\n(defn- collection-value\n  \"A guest collection: a literal when no member is a reference.\"\n  [ctx kind members original]\n  (let [vs (mapv #(lift-value ctx %) members)]\n    (if (every? #(= :lit (first %)) vs) [:lit original] [:row (node kind vs)])))\n\n\n(defn- bindings-node\n  [ctx e]\n  (node :bindings (mapcat (fn [[k v]] [k (lift-value ctx v)]) e)))\n\n\n(defn- context!\n  \"Record that segment a can run from pc at under environment e: a\n   closure's entry, an :act's or a return frame's pc (§7.1's discharge).\"\n  [ctx a at e]\n  (swap! (:acc ctx) update :contexts conj {:a a :at at :env (or e {})}))\n\n\n(defn- store-of!\n  [ctx e]\n  (let [store-of (engine/env-store-of e)]\n    (when (some? store-of) (swap! (:acc ctx) update :stores conj store-of))\n    store-of))\n\n\n(defn- lift-env-node\n  [ctx e]\n  (let [e (or e {})]\n    (node :env [(bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n\n\n(defn- closure-node\n  [ctx c]\n  (let [e (or (:env c) {})\n        a (address! ctx (:segment c))]\n    (context! ctx a (:entry c) e)\n    (node :closure [a (:entry c) (vec (:params c))\n                    (bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n\n\n(defn- lift-value\n  \"One machine value as a carrier value: [:lit x], [:row n] or\n   [:cursor-cell source]. A reference is authenticated before it is\n   encoded; a foreign value, a heap cell and a host object refuse.\"\n  [ctx x]\n  (let [m (:m ctx)]\n    (cond\n      (values/host-typed? x)\n      (cond\n        (not (values/owned-by? x (:owner m)))\n        (outcome! :yin.k/non-portable :foreign-value {:yin.k/hint (values/kind-of x)})\n        (values/closure? x) [:row (closure-node ctx (values/payload x))]\n        (values/continuation? x) [:row (node :reified [(state-node ctx (values/payload x))])]\n        :else (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint (values/kind-of x)}))\n      (fn? x) [:row (node :prim [(primitive-name ctx x)])]\n      (map? x)\n      (case (:type x)\n        :stream-ref (if (engine/authentic-ref? m :stream-ref x)\n                      [:row (stream-row! ctx (:id x))]\n                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)\n                      [:cursor-cell (cell-for! ctx (:id x))]\n                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))\n        :parked-continuation (if (contains? (:parked m) (:id x))\n                               [:row (node :parked-ref [(:id x)])]\n                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))\n        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})\n        (collection-value ctx :map (mapcat identity x) x))\n      (vector? x) (collection-value ctx :vec x x)\n      (set? x) (collection-value ctx :set (vec x) x)\n      (seq? x) (collection-value ctx :list (vec x) x)\n      (scalar-literal? x) [:lit x]\n      :else (outcome! :yin.k/non-portable :host-object {}))))\n\n\n(defn- window-node\n  [ctx w]\n  (node :window (mapcat (fn [[r v]] [r (lift-value ctx v)]) w)))\n\n\n(defn- k-node\n  [ctx k]\n  (node :k (mapv (fn [f]\n                   (let [a (address! ctx (:segment f))]\n                     (context! ctx a (:pc f) (:env f))\n                     (node :kframe [a (:pc f) (lift-env-node ctx (:env f))\n                                    (window-node ctx (:window f)) (:rd f)])))\n                 (or k []))))\n\n\n(defn- state-node\n  \"An evaluator payload (wait entry, parked record, reified payload) as\n   its :act or :tail row; engine fields are the pending's.\"\n  [ctx p]\n  (if (contains? p :site)\n    ;; a tail state resumes through its K: its own segment never runs again\n    (node :tail [(address! ctx (:segment p)) (:site p) (k-node ctx (:k p))])\n    (let [a (address! ctx (:segment p))]\n      (context! ctx a (:pc p) (:env p))\n      (node :act [a (:pc p) (lift-env-node ctx (:env p))\n                  (window-node ctx (:window p)) (k-node ctx (:k p)) (get-in p [:deliver :rd])]))))\n\n\n(defn- pending-node\n  \"The observed wait's pending (draft §5.3): the reason is the entry's,\n   never the site's static kind.\"\n  [ctx e]\n  (let [m (:m ctx)]\n    (case (:reason e)\n      :next (if (contains? e :call-id)\n              (node :pending [:ffi (cell-for! ctx (get-in e [:cursor-ref :id])) (:call-id e) (:op e)])\n              (node :pending [:next (cell-for! ctx (get-in e [:cursor-ref :id]))]))\n      :put (if (:request-sent e)\n             (let [carried? (and (:response-cursor e) (:response-stream e))\n                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)\n                   response (if carried? (:response-stream e) vm/call-out-stream-key)]\n               (when-not (get (:resources m) cursor) (outcome! :yin.k/unsatisfied nil {}))\n               (node :pending [:ffi-request (:call-id e) (lift-value ctx (:datom e)) (stream-row! ctx (:stream-id e))\n                               (stream-row! ctx response) (cell-for! ctx cursor) (:op-id e)]))\n             (do (when-not (contains? e :datom) (outcome! :yin.k/non-portable :incomplete-write {}))\n                 (node :pending [:put (stream-row! ctx (:stream-id e)) (lift-value ctx (:datom e)) (:op-id e)])))\n      (:link-request :link-response)\n      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))\n            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]\n        (node :pending (if (= :link-request (:reason e)) (conj base (:envelope e) (:op-id e)) base)))\n      :install (do (when-not (contains? (:installs m) (:name e))\n                     (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name (:name e)}))\n                   (node :pending [:install (:name e)]))\n      (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/reason (:reason e)}))))\n\n\n(defn- store-node\n  [ctx s]\n  (node :store (mapcat (fn [[k v]]\n                         (when-not (= :lit (first (lift-value ctx k)))\n                           (outcome! :yin.k/non-portable :store-key {}))\n                         [k (lift-value ctx v)])\n                       s)))\n\n\n(defn- module-store-nodes\n  \"Every module store an environment or closure reaches, transitively.\"\n  [ctx]\n  (loop [done {}]\n    (if-let [mid (first (sort-by str (remove #(contains? done %) (:stores @(:acc ctx)))))]\n      (let [stores (:module-stores (:m ctx))]\n        (when-not (contains? stores mid)\n          (outcome! :yin.k/non-portable :missing-module-store {:yin.k/hint mid}))\n        (recur (assoc done mid (node :module-store [mid (store-node ctx (get stores mid))]))))\n      (mapv val (sort-by #(str (key %)) done)))))\n\n\n(defn- installing-names\n  [m]\n  (into #{} (mapcat (fn [[mn inst]]\n                      (map #(symbol (name mn) (name %))\n                           (get-in inst [:response :manifest :yin.module/exports]))))\n        (:installs m)))\n\n\n(defn live-pcs\n  \"The pcs of v control flow can still reach from at: the successor\n   relation (§8.1), so a backward jump makes earlier code live, and from\n   each reachable :closure its body from the entry, since reachable code\n   can still construct it.\"\n  [v at]\n  (loop [seen #{at}\n         todo [at]]\n    (if-let [p (peek todo)]\n      (let [t (nth v p)\n            fresh (remove seen (cond-> (analysis/successors v p)\n                                 (= :closure (nth t 0)) (conj (nth t 3))))]\n        (recur (into seen fresh) (into (pop todo) fresh)))\n      seen)))\n\n\n(defn- discharge!\n  \"The dependency closure over the v4 vectors (§7.1), after the walk that\n   found the contexts: every free occurrence control flow can still reach\n   from a carried context (live-pcs) is answered there, in resolve-var's\n   order: that context's\n   E, then the one store engine/active-store selects for it (the root\n   store, or the module store its store-of names; both travel), then a\n   primitive, an installing module's export, the module registry. Else\n   the lift is :yin.k/unsatisfied, discovery :incomplete.\"\n  [ctx code]\n  (let [m (:m ctx)\n        installing (installing-names m)\n        answered? (fn [sym e]\n                    (let [store-of (engine/env-store-of e)\n                          store (if (some? store-of) (get (:module-stores m) store-of {}) (:store m))]\n                      (or (vm/reserved-name? sym) (contains? e sym) (contains? store sym)\n                          (let [profile (vm/profile-of (:primitives m) sym)]\n                            (when (= :host (:yin.k/class profile))\n                              (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name sym}))\n                            (or (some? profile) (contains? installing sym)\n                                (and (some? (namespace sym))\n                                     (some? (module/resolve-module (:modules m)\n                                                                   (symbol (str (namespace sym) \".\" (name sym)))))))))))\n        scanned (into {} (map (fn [[a v]] [a (scan/free-occurrences v)])) code)\n        missing (into #{}\n                      (mapcat (fn [{:keys [a at env]}]\n                                (let [live (live-pcs (get code a) at)]\n                                  (keep (fn [o]\n                                          (when (and (contains? live (:at o))\n                                                     (not (answered? (:name o) env)))\n                                            (:name o)))\n                                        (get scanned a)))))\n                      (:contexts @(:acc ctx)))]\n    (when (seq missing)\n      (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:obligations missing}}))))\n\n\n(declare lift-task*)\n\n\n(defn- install-node\n  [ctx mn inst opts]\n  (let [{:keys [phase parent response]} inst]\n    (when-not (contains? #{:running :parked} phase)\n      (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name mn :yin.k/phase phase}))\n    (when-not (try (cbor/encode response) true\n                   (catch #?(:cljd Object :clj Throwable :cljs :default) _e false))\n      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n    (node :install [mn phase parent response\n                    (lift-task* (:vm inst) (:serve! ctx) (dissoc opts :free-env) :child)])))\n\n\n(defn- lift-task*\n  [m serve! opts role]\n  (when (seq (:ready-queue m))\n    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n  (when-some [h (unliftable-hold m)]\n    (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/hold h}))\n  (when (some? (:control m))\n    (outcome! :yin.k/not-at-safepoint nil {:yin.k/pc (get-in m [:control :pc])}))\n  (let [value (:value m)\n        active? (and (map? value) (= :parked-continuation (:type value)) (contains? (:parked m) (:id value)))\n        kind (cond active? :parked\n                   (seq (:wait-set m)) :blocked\n                   (engine/halted-with-empty-queue? m) :halted\n                   :else (outcome! :yin.k/not-at-safepoint nil {}))\n        ;; §6.3: the explicit argument overrides the kernel's retained field\n        free-env (cond (some? (:free-env opts)) (:free-env opts)\n                       (some? (:free-env m)) (:free-env m)\n                       :else (outcome! :yin.k/non-portable :missing-free-env {}))\n        ctx {:m m :serve! serve! :acc (atom {:streams {} :cells {} :stores #{} :segments #{} :contexts #{}})}\n        free-node (bindings-node ctx free-env)\n        waits (mapv (fn [e] (node :wait [(state-node ctx e) (pending-node ctx e)])) (:wait-set m))\n        parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n        store (store-node ctx (:store m))\n        result (when (= :halted kind) (lift-value ctx value))\n        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n        module-stores (module-store-nodes ctx)\n        acc @(:acc ctx)\n        segments (:segments acc)\n        code (into {} (map (fn [a]\n                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n                               [a v]\n                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n                   segments)\n        _ (discharge! ctx code)\n        index (or (:source-index opts) {})\n        missing-trees (into #{} (remove #(seq (get index %))) segments)\n        _ (when (seq missing-trees)\n            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n                  :yin.k/segments segments\n                  :yin.k/trees (select-keys index segments)}\n        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n                          (when (= :parked kind) (:id value)) result nil])]\n    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n    (when-let [d (validate-frames task)]\n      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n    task))\n\n\n(defn lift-task\n  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n   opts: :free-env, the task's initial free environment (default: the\n   kernel's retained :free-env field; the explicit value overrides it);\n   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n   must cover every carried segment; :budget, the numbering budget.\"\n  ([m serve!] (lift-task m serve! {}))\n  ([m serve! opts]\n   (let [opts (or opts {})]\n     (emit (lift-task* m serve! opts :root) (merge default-budget (:budget opts))))))\n\n\n(def ^:private fixed-resource-keys\n  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key\n    module/link-request-resource module/link-response-resource})\n\n\n(defn- fresh-key!\n  [used]\n  (loop [n (inc (count @used))]\n    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n      (if (contains? @used k) (recur (inc n)) (do (swap! used conj k) k)))))\n\n\n(defn- rows-of\n  \"Every row of kind under n; install children too unless own-only.\"\n  [n kind own-only?]\n  (let [out (atom [])]\n    (letfn [(visit\n              [n]\n              (when (= kind (:kind n)) (swap! out conj n))\n              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n                (cond\n                  (and (ref? d) (= :task (:kind x))) (when-not own-only? (visit x))\n                  (ref? d) (visit x)\n                  (refs? d) (run! visit x)\n                  (and (value-slot? d) (vector? x) (= :row (first x))) (visit (second x))\n                  :else nil)))]\n      (visit n)\n      @out)))\n\n\n(defn- task-tree\n  \"[task role] for the root and every install child, pre-order.\"\n  [task role]\n  (into [[task role]] (mapcat #(task-tree (nth (:slots %) 4) :child)) (nth (:slots task) 12)))\n\n\n(defn- check-stores!\n  \"Step 7's task context, beside X1: no root or module store key is a\n   reserved name (Rule R), refused here rather than by restore's store-put.\"\n  [_recv task _role]\n  (let [[_ _ _ _ _ _ store module-stores] (:slots task)]\n    (doseq [s (cons store (map #(second (:slots %)) module-stores))\n            k (take-nth 2 (:slots s))]\n      (when (vm/reserved-name? k)\n        (outcome! :yin.k/undecodable :reserved-name {:yin.k/role :store-key :yin.k/name k})))))\n\n\n(defn- attaches?\n  \"The receiving kernel admits vector v (its loader's validation), under\n   address a when a is given.\"\n  [recv v a]\n  (try (let [r (module/attach-module recv v)] (or (nil? a) (contains? (:code-aliases r) a)))\n       (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))\n\n\n(defn- check-install!\n  \"One install record: a phase the engine holds a carried child in, the\n   retained response link-install reads (status, manifest naming this\n   module, exports) with the image spawn-child loads, and a child that\n   is blocked: the engine links a halted child in the sweep it halts in.\"\n  [recv inst]\n  (let [[mn phase _ response child] (:slots inst)\n        manifest (when (map? response) (:manifest response))\n        child-kind (nth (:slots child) 2)]\n    (when-not (contains? #{:running :parked} phase)\n      (outcome! :yin.k/undecodable :install-phase {:yin.k/name mn :yin.k/phase phase}))\n    (when-not (and (map? response) (= :ok (:status response)) (map? manifest)\n                   (= mn (:yin.module/name manifest))\n                   (coll? (:yin.module/exports manifest)) (every? symbol? (:yin.module/exports manifest))\n                   (map? (:image response)) (attaches? recv (:value (:image response)) nil))\n      (outcome! :yin.k/undecodable :install-response {:yin.k/name mn}))\n    (when-not (= :blocked child-kind)\n      (outcome! :yin.k/undecodable :install-child {:yin.k/name mn :yin.k/task-kind child-kind}))))\n\n\n(defn- check-pendings!\n  \"Step 8, pending and operations: role, kind, parked id, every :install\n   pending names a carried install, every install record.\"\n  [recv task role]\n  (let [[_ _ kind role' _ _ _ _ parked _ _ _ installs waits parked-id] (:slots task)]\n    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n    (let [names (into #{} (map #(first (:slots %))) installs)]\n      (doseq [w waits]\n        (let [[reason n] (:slots (second (:slots w)))]\n          (when (and (= :install reason) (not (contains? names n)))\n            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n    (case kind\n      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n                (outcome! :yin.k/undecodable :parked-id {}))\n      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n    (run! #(check-install! recv %) installs)))\n\n\n(defn- check-closure!\n  \"A closure row names a :closure tuple of its carried vector: the entry\n   (:closure-origin) and that tuple's binders (:closure-binders), as\n   lower-closure will demand.\"\n  [code c]\n  (let [[a entry params] (:slots c)\n        v (get code a)\n        _ (when (nil? v) (outcome! :yin.k/undecodable :segment {:yin.k/segment a}))\n        tuple (first (filter #(and (= :closure (nth % 0)) (= entry (nth % 3))) v))]\n    (cond\n      (nil? tuple) (outcome! :yin.k/undecodable :closure-origin {:yin.k/segment a :yin.k/entry entry})\n      (not= params (nth tuple 2)) (outcome! :yin.k/undecodable :closure-binders {:yin.k/segment a :yin.k/entry entry})\n      :else nil)))\n\n\n(defn- check-dependencies!\n  \"Step 9, dependency closure: requires and code agree, every segment has\n   its trees (§6.1), every closure's and frame's store-of names a module\n   store of this task (not a parent's or sibling's of the same key), every\n   segment is a vector the receiver's kernel admits under its A, every\n   closure names a closure of its code, every :prim is the receiver's.\"\n  [recv task _role]\n  (let [[_ _ _ _ _ _ _ module-stores _ _ requires code] (:slots task)]\n    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n      (outcome! :yin.k/undecodable :requires {}))\n    (let [trees (:yin.k/trees requires)\n          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n      (when (seq missing)\n        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n    ;; §2.6: every store-of resolves to a module store this task carries\n    (let [census (into #{} (map #(first (:slots %))) module-stores)\n          missing (into #{} (comp (keep #(nth (:slots %) (if (= :closure (:kind %)) 4 1)))\n                                  (remove census))\n                        (concat (rows-of task :closure true) (rows-of task :env true)))]\n      (when (seq missing)\n        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/stores missing}})))\n    (doseq [[a v] (sort-by #(str (key %)) code)]\n      (when-not (attaches? recv v a)\n        (outcome! :yin.k/undecodable :segment {:yin.k/segment a})))\n    (run! #(check-closure! code %) (rows-of task :closure true))\n    (doseq [p (rows-of ta