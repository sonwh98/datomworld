, link pair). `opts` carries\n410-     `:modules` (the child's module view), `:origin`, and `:ancestry`.\")\n411-\n412-  (image-identity\n413-    [vm image]\n414-    \"The identity this kernel's code space names `image` by: H, R, the\n415-     vector's address, or the tree's root row id.\")","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AahLHfSY5UjWnuxGvuJmZY","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfxmaryD4fsndtD837udv","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1105,"cache_read_input_tokens":288825,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1105},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b921a1a6-65e4-4bc4-853c-fc87c8b912fe","uuid":"31648ab8-1822-4c1a-b354-5e4681b1a43d","timestamp":"2026-10-12T17:52:47.298Z","request_id":"req_011Cfxmarc8K6KwhUASrkXY5","thinking_duration_ms":974,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfxmaryD4fsndtD837udv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VLqcDDsvVTZcjBBsukhPPe","name":"Bash","input":{"command":"python3 - <<'EOF'\np='src/cljc/yin/vm/semantic_register/layout.cljc'\ns=open(p).read()\ns=s.replace(\"            [yin.vm.engine :as engine]\\n\",\"            [yin.vm.engine :as engine]\\n            [yin.vm.module :as module]\\n\",1)\ns+=r'''(defn kernel-kind\n  \"`:stack` or `:register`, by the kernel's link format.\"\n  [k]\n  (let [f (when (satisfies? module/IModuleKernel k) (:format (module/link-format k)))]\n    (cond\n      (= stack/format-tag f) :stack\n      (= register/format-tag f) :register\n      :else (refuse! :yin.k/unsupported :kernel {:yin.k/format f}))))\n\n\n(defn- image-pc\n  \"`[segment rel-pc]` of an absolute kernel pc.\"\n  [kind k space pc]\n  (let [[ident rel] (or (if (= :stack kind) (stack/image-pc k pc) (register/image-pc k pc))\n                        (refuse! :yin.k/non-portable :unknown-image {:yin.k/pc pc}))]\n    [(image-segment space kind ident) rel]))\n\n\n(defn- offset\n  \"The offset of segment `seg`'s image in kernel `k`'s code space.\"\n  [kind k seg]\n  (let [ident (if (= :stack kind) (:stack-id seg) (:register-id seg))]\n    (or (if (= :stack kind) (stack/absolute-pc k [ident 0]) (register/absolute-pc k [ident 0]))\n        (refuse! :yin.k/unsatisfied :image-not-attached {:yin.k/segment (:address seg)}))))\n\n\n(def ^:private parking-ops\n  \"A1: the instructions a resume pc may follow, besides a non-tail call.\"\n  #{:stream-next :stream-put :ffi-call :park :current-continuation})\n\n\n(defn- safepoint!\n  \"Refuse `:yin.k/not-at-safepoint` unless the A instruction before `pc`\n   parks: a layout never invents a safepoint (§4.5).\"\n  [seg pc tail?]\n  (let [t (when (and (integer? pc) (< 0 pc (inc (count (:vector seg))))) (inst seg (dec pc)))\n        op (when t (nth t 0))]\n    (when-not (and t (if tail?\n                       (code/tail-call? t)\n                       (or (contains? parking-ops op) (and (= :call op) (not (code/tail-call? t))))))\n      (refuse! :yin.k/not-at-safepoint nil {:yin.k/pc pc}))))\n\n\n(defn- h->a\n  \"The A pc of H pc `hpc`, or not-at-safepoint for a `:push`.\"\n  [seg hpc]\n  (or (get (:h->a seg) hpc) (refuse! :yin.k/not-at-safepoint nil {:yin.k/pc hpc})))\n\n\n(defn- a->h\n  [seg pc]\n  (nth (:a->h seg) pc))\n\n\n;; =============================================================================\n;; Values: positional closures and kernel continuations, both ways\n;; =============================================================================\n;;\n;; A lift context `cx` is {:kind :kernel :space :free-env :owner}; a lower\n;; context `lx` is {:kind :kernel :space :free-env :owner :address}, where\n;; :address names a canonical closure's or payload's :segment as A.\n\n(declare lift-state lower-state)\n\n\n(defn- walk-value\n  \"Rebuild guest collections of `x` around `f`, which converts closures\n   and continuations.\"\n  [f x]\n  (cond\n    (values/host-typed? x) (f x)\n    (map? x) (into {} (map (fn [[k v]] [(walk-value f k) (walk-value f v)])) x)\n    (vector? x) (mapv #(walk-value f %) x)\n    (set? x) (into #{} (map #(walk-value f %)) x)\n    (seq? x) (apply list (map #(walk-value f %) x))\n    :else x))\n\n\n(defn- canonical-closure\n  \"§4.4: a positional closure as the canonical `{:type :closure :params\n   :entry :segment :env}`, `params` from A's `:closure` at the owner of\n   the entry body, `env` by the forward rule over its frames.\"\n  [cx c]\n  (let [[seg rel] (image-pc (:kind cx) (:kernel cx) (:space cx) (:body-pc c))\n        entry (if (= :stack (:kind cx)) (h->a seg rel) rel)\n        owner (:owner (nth (:bodies seg) (body-of seg entry)))\n        _ (when-not (and owner (= entry (nth (inst seg owner) 3)))\n            (refuse! :yin.k/non-portable :closure-origin {:yin.k/entry entry}))\n        ps (params seg owner)]\n    (when-not (= (count ps) (:arity c))\n      (refuse! :yin.k/non-portable :closure-binders {:yin.k/entry entry}))\n    {:type :closure :params ps :entry entry :segment (:address seg)\n     :env (env-of seg owner (:free-env cx)\n                  (mapv (fn [f] (mapv #(walk-value (partial canonical-value* cx) %) f)) (:frames c))\n                  (:store-of c))}))\n\n\n(defn- canonical-value*\n  [cx x]\n  (cond\n    (values/closure? x) (values/closure (:owner cx) (canonical-closure cx (values/payload x)))\n    (values/continuation? x)\n    (values/continuation (:owner cx) (assoc (lift-state cx (values/payload x)) :type :reified-continuation))\n    :else x))\n\n\n(defn canonical-value\n  \"A kernel value with every positional closure and kernel continuation\n   reconstructed canonically (cx: a lift context).\"\n  [cx x]\n  (walk-value (partial canonical-value* cx) x))\n\n\n(defn- address-of\n  [lx seg-id]\n  (let [a ((:address lx) seg-id)]\n    (when (nil? a) (refuse! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg-id}))\n    a))\n\n\n(defn- positional-closure\n  \"The inverse of canonical-closure: the entry's absolute pc in the\n   receiving kernel and the frames read back from `env` by the chain.\"\n  [lx c]\n  (let [seg (segment-of (:space lx) (address-of lx (:segment c)))\n        entry (:entry c)\n        owner (:owner (nth (:bodies seg) (body-of seg entry)))\n        off (offset (:kind lx) (:kernel lx) seg)\n        store-of (engine/env-store-of (:env c))]\n    (when-not (and owner (= (vec (:params c)) (vec (params seg owner))))\n      (refuse! :yin.k/undecodable :closure-binders {:yin.k/entry entry}))\n    (cond-> {:type :closure :arity (count (:params c))\n             :body-pc (+ off (if (= :stack (:kind lx)) (a->h seg entry) entry))\n             :frames (mapv (fn [f] (mapv #(positional-value lx %) f)) (frames-of seg owner (:env c)))}\n      (some? store-of) (assoc :store-of store-of))))\n\n\n(defn- positional-value*\n  [lx x]\n  (cond\n    (values/closure? x) (values/closure (:owner lx) (positional-closure lx (values/payload x)))\n    (values/continuation? x)\n    (values/continuation (:owner lx) (merge {:type :reified-continuation} (lower-state lx (values/payload x))))\n    :else x))\n\n\n(defn positional-value\n  \"A canonical value with every closure and continuation lowered into the\n   receiving kernel (lx: a lower context).\"\n  [lx x]\n  (walk-value (partial positional-value* lx) x))\n\n\n;; =============================================================================\n;; Lift: a kernel payload as the canonical act or tail\n;; =============================================================================\n\n(def ^:private kernel-keys\n  \"The register payload keys of either kernel; every other key of an\n   entry is the engine's and travels as the pending.\"\n  #{:segment :site-pc :pc :frames :regs :live :continuation :dest :resume-mode\n    :format :hash :image :images :store-of :stack})\n\n\n(defn- engine-fields\n  [conv entry]\n  (let [fields (apply dissoc entry kernel-keys)]\n    (cond-> fields (contains? fields :datom) (update :datom conv))))\n\n\n(defn- canonical-env\n  [cx seg pc frames store-of]\n  (env-of seg pc (:free-env cx)\n          (mapv (fn [f] (mapv #(canonical-value cx %) f)) frames)\n          store-of))\n\n\n(defn- register-kframe\n  \"§4.2 step 6, one frame independently: its image row, A, `rd` from A.\"\n  [cx f]\n  (let [[seg pc] (image-pc :register (:kernel cx) (:space cx) (:return-pc f))\n        _ (safepoint! seg pc false)\n        site (dec pc)]\n    {:type :return :segment (:address seg) :pc pc\n     :env (canonical-env cx seg pc (:frames f) (:store-of f))\n     :window (into {} (map (fn [[s x]] [(virt seg site s) (canonical-value cx x)])) (:regs f))\n     :rd (code/rd (inst seg site))}))\n\n\n(defn- lift-register\n  [cx entry]\n  (let [[seg rel] (image-pc :register (:kernel cx) (:space cx) (:pc entry))\n        tail? (= :return-result (:resume-mode entry))\n        k (mapv #(register-kframe cx %) (:continuation entry))]\n    (safepoint! seg rel tail?)\n    (if tail?\n      {:segment (:address seg) :site (dec rel) :k k :deliver {:deliver :return}}\n      (let [site (dec rel)]\n        {:segment (:address seg) :pc rel\n         :env (canonical-env cx seg rel (:frames entry) (:store-of entry))\n         :window (into {} (map (fn [[s x]] [(virt seg site s) (canonical-value cx x)])) (:regs entry))\n         :k k\n         :deliver {:deliver :rd :rd (code/rd (inst seg site))}}))))\n\n\n(defn- slice-window\n  \"`(zipmap (stack-layout (dec pc)) slice)`, the two of equal length.\"\n  [cx seg pc slice]\n  (let [layout (stack-layout seg (dec pc))]\n    (when-not (= (count layout) (count slice))\n      (refuse! :yin.k/non-portable :stack-layout {:yin.k/pc pc :yin.k/layout layout :yin.k/slice (count slice)}))\n    (zipmap layout (map #(canonical-value cx %) slice))))\n\n\n(defn slices\n  \"§4.3 K slices of an operand stack `st` under return frames with bases\n   `bases` (outermost first): `St[b(i-1), b(i))` per frame, `b(-1) = 0`,\n   then the current activation's `St[b(m-1), n)`.\"\n  [st bases]\n  (let [bounds (into [0] bases)]\n    (conj (mapv (fn [lo hi] (subvec st lo hi)) bounds (rest bounds))\n          (subvec st (peek bounds) (count st)))))\n\n\n(defn- stack-pc\n  \"The canonical resume pc of an absolute stack resume pc.\"\n  [cx abs]\n  (let [[seg rel] (image-pc :stack (:kernel cx) (:space cx) abs)]\n    [seg (inc (h->a seg (dec rel)))]))\n\n\n(defn- lift-stack\n  [cx entry]\n  (let [st (vec (:stack entry))\n        frames (:continuation entry)\n        bases (mapv :stack-base frames)\n        _ (when-not (and (every? integer? bases) (apply <= 0 (conj bases (count st))))\n            (refuse! :yin.k/non-portable :stack-base {:yin.k/bases bases}))\n        parts (slices st bases)\n        k (mapv (fn [f slice]\n                  (let [[seg pc] (stack-pc cx (:return-pc f))]\n                    (safepoint! seg pc false)\n                    {:type :return :segment (:address seg) :pc pc\n                     :env (canonical-env cx seg pc (:frames f) (:store-of f))\n                     :window (slice-window cx seg pc slice)\n                     :rd (code/rd (inst seg (dec pc)))}))\n                frames parts)\n        [seg rel] (image-pc :stack (:kernel cx) (:space cx) (:pc entry))\n        site (h->a seg (dec rel))\n        tail? (code/tail-call? (inst seg site))]\n    (safepoint! seg (inc site) tail?)\n    (if tail?\n      {:segment (:address seg) :site site :k k :deliver {:deliver :return}}\n      (let [pc (inc site)]\n        {:segment (:address seg) :pc pc\n         :env (canonical-env cx seg pc (:frames entry) (:store-of entry))\n         :window (slice-window cx seg pc (peek parts))\n         :k k\n         :deliver {:deliver :rd :rd (code/rd (inst seg site))}}))))\n\n\n(defn lift-state\n  \"A kernel's wait entry, parked record or reified payload as the\n   canonical act or tail payload, engine fields carried (§4.2, §4.3).\"\n  [cx entry]\n  (merge (engine-fields #(canonical-value cx %) entry)\n         (if (= :stack (:kind cx)) (lift-stack cx entry) (lift-register cx entry))))\n\n\n(defn lift-context\n  \"The lift context of kernel `k` over `space`: positional closures and\n   continuations are reminted under `owner`.\"\n  [k space owner]\n  (assoc {} :kind (kernel-kind k) :kernel k :space space :free-env (or (:free-env k) {}) :owner owner))\n\n\n;; =============================================================================\n;; Lower: a canonical act or tail into a kernel\n;; =============================================================================\n\n(defn- lower-frames\n  [lx seg pc env]\n  (mapv (fn [f] (mapv #(positional-value lx %) f)) (frames-of seg pc env)))\n\n\n(defn- payload-segment\n  [lx p]\n  (segment-of (:space lx) (address-of lx (:segment p))))\n\n\n(defn- lower-regs\n  [lx seg pc w]\n  (vec (sort-by first (map (fn [[x v]] [(phys seg pc x) (positional-value lx v)]) w))))\n\n\n(defn- register-k\n  [lx k]\n  (mapv (fn [f]\n          (let [seg (payload-segment lx f)\n                off (offset :register (:kernel lx) seg)\n                pc (:pc f)\n                regs (lower-regs lx seg pc (:window f))\n                store-of (engine/env-store-of (:env f))]\n            (cond-> {:site-pc (+ off pc -1) :return-pc (+ off pc)\n                     :frames (lower-frames lx seg pc (:env f))\n                     :regs regs :live (mapv first regs)\n                     :dest (phys seg (dec pc) (:rd f))}\n              (some? store-of) (assoc :store-of store-of))))\n        k))\n\n\n(defn- register-common\n  [k ident]\n  (cond-> {:segment (:segment k) :format register/format-tag :hash (:hash k) :image ident}\n    (< 1 (count (:images k))) (assoc :images (:images k))))\n\n\n(defn- lower-register\n  [lx p fill]\n  (let [k (:kernel lx)\n        seg (payload-segment lx p)\n        off (offset :register k seg)\n        common (register-common k (:register-id seg))\n        kk (register-k lx (:k p))]\n    (if (contains? p :site)\n      (merge common\n             {:site-pc (+ off (:site p)) :pc (+ off (:site p) 1)\n              :frames (:frames fill []) :regs [] :live [] :continuation kk :dest nil\n              :resume-mode :return-result}\n             (when (some? (:store-of fill)) {:store-of (:store-of fill)}))\n      (let [pc (:pc p)\n            regs (lower-regs lx seg pc (:window p))\n            store-of (engine/env-store-of (:env p))]\n        (cond-> (merge common\n                       {:site-pc (+ off pc -1) :pc (+ off pc)\n                        :frames (lower-frames lx seg pc (:env p))\n                        :regs regs :live (mapv first regs) :continuation kk\n                        :dest (phys seg (dec pc) (get-in p [:deliver :rd]))\n                        :resume-mode :write-result})\n          (some? store-of) (assoc :store-of store-of))))))\n\n\n(defn- layout-slice\n  \"`(mapv W (stack-layout (dec pc)))`, every member present in W.\"\n  [lx seg pc w]\n  (mapv (fn [x]\n          (when-not (contains? w x)\n            (refuse! :yin.k/undecodable :window-missing {:yin.k/pc pc :yin.k/register x}))\n          (positional-value lx (get w x)))\n        (stack-layout seg (dec pc))))\n\n\n(defn- stack-k\n  \"The return frames and their slices, bases cumulative through each\n   slice (§4.3): `b(i) = b(i-1) + |slice(i)|`.\"\n  [lx k]\n  (reduce (fn [[frames st] f]\n            (let [seg (payload-segment lx f)\n                  pc (:pc f)\n                  slice (layout-slice lx seg pc (:window f))\n                  st (into st slice)\n                  store-of (engine/env-store-of (:env f))]\n              [(conj frames (cond-> {:return-pc (+ (offset :stack (:kernel lx) seg) (a->h seg (dec pc)) 1)\n                                     :frames (lower-frames lx seg pc (:env f))\n                                     :stack-base (count st)}\n                              (some? store-of) (assoc :store-of store-of)))\n               st]))\n          [[] []]\n          k))\n\n\n(defn- lower-stack\n  [lx p fill]\n  (let [k (:kernel lx)\n        seg (payload-segment lx p)\n        off (offset :stack k seg)\n        [frames st] (stack-k lx (:k p))\n        common {:segment (:segment k) :format stack/format-tag :hash (:hash k) :image (:stack-id seg)}]\n    (if (contains? p :site)\n      (merge common\n             {:pc (+ off (a->h seg (:site p)) 1) :resume-mode :return-result\n              :stack st :frames (:frames fill []) :continuation frames}\n             (when (some? (:store-of fill)) {:store-of (:store-of fill)}))\n      (let [pc (:pc p)\n            store-of (engine/env-store-of (:env p))]\n        (cond-> (merge common\n                       {:pc (+ off (a->h seg (dec pc)) 1)\n                        :frames (lower-frames lx seg pc (:env p))\n                        :stack (into st (layout-slice lx seg pc (:window p)))\n                        :continuation frames})\n          (some? store-of) (assoc :store-of store-of))))))\n\n\n(def ^:private canonical-keys\n  #{:segment :pc :site :env :window :k :deliver :type :id})\n\n\n(defn lower-state\n  \"A canonical act or tail payload as the receiving kernel's entry, engine\n   fields carried (§4.2, §4.3). `fill` gives a tail entry's unobservable\n   `:frames`/`:store-of` (default `[]`/nil; §5.6 item 8).\"\n  ([lx p] (lower-state lx p {}))\n  ([lx p fill]\n   (merge (let [fields (apply dissoc p canonical-keys)]\n            (cond-> fields (contains? fields :datom) (update :datom #(positional-value lx %))))\n          (if (= :stack (:kind lx)) (lower-stack lx p fill) (lower-register lx p fill)))))\n\n\n(defn lower-context\n  \"The lower context into kernel `k` over `space`; `address` maps a\n   payload's or closure's `:segment` to A (default: it is A).\"\n  ([k space] (lower-context k space identity))\n  ([k space address]\n   (assoc {} :kind (kernel-kind k) :kernel k :space space :free-env (or (:free-env k) {})\n          :owner (:owner k) :address address)))\n\n\n;; =============================================================================\n;; Tasks\n;; =============================================================================\n\n(defn- refuse-busy!\n  [k]\n  (when (engine/active-continuation? k)\n    (refuse! :yin.k/not-at-safepoint nil {:yin.k/pc (:pc k)}))\n  (when (seq (:installs k))\n    (refuse! :yin.k/unsupported :installs {:yin.k/names (vec (keys (:installs k)))})))\n\n\n(defn canonical-task\n  \"Quiescent kernel `k` presented as the semantic-register machine\n   `template` (a fresh machine of the same composition): code by A from\n   `space`, every wait, parked record and value reconstructed through the\n   layout, resources, stores and counters carried. `rows/lift-task` then\n   lifts it as it lifts its own kernel.\"\n  [k space template]\n  (refuse-busy! k)\n  (let [cx (lift-context k space (:owner template))\n        conv #(canonical-value cx %)\n        parked (into {} (map (fn [[id rec]]\n                               [id (assoc (lift-state cx rec) :type :parked-continuation :id id)]))\n                     (:parked k))\n        value (:value k)\n        parked-value? (and (map? value) (= :parked-continuation (:type value)) (contains? parked (:id value)))\n        code (into {} (map (fn [[a s]] [a (assoc {} :vector (:vector s) :address a :analysis (:analysis s))]))\n                   (:segments space))]\n    (assoc template\n           :code code\n           :code-aliases (into {} (map (fn [a] [a a])) (keys code))\n           :program nil :control nil :window {} :k nil\n           :resources (:resources k)\n           :capability-secret (:capability-secret k)\n           :free-env (:free-env k)\n           :env (or (:free-env k) {})\n           :store (conv (:store k))\n           :module-stores (conv (or (:module-stores k) {}))\n           :parked parked\n           :wait-set (mapv #(lift-state cx %) (:wait-set k))\n           :ready-queue (:ready-queue k)\n           :value (if parked-value? (get parked (:id value)) (conv value))\n           :id-counter (:id-counter k)\n           :installs {}\n           :halted? (:halted? k)\n           :blocked? (:blocked? k))))\n\n\n(defn- attach-all\n  \"`k` holding the image of every segment of `space`, in A order.\"\n  [k space]\n  (let [kind (kernel-kind k)]\n    (reduce (fn [k a]\n              (let [seg (segment-of space a)]\n                (if (= :stack kind)\n                  (stack/attach-image k (:stack seg) vm-stack-contract)\n                  (register/attach-image k (:register seg) vm-register-contract))))\n            k\n            (sort-by str (keys (:segments space))))))\n'''\nopen(p,'w').write(s)\nEOF","description":"Append dynamic half to layout"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1105,"cache_read_input_tokens":288825,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1105},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b921a1a6-65e4-4bc4-853c-fc87c8b912fe","uuid":"d5e217a6-e0b8-4c8d-b8c8-913fce32b8ea","timestamp":"2026-10-12T17:53:44.201Z","request_id":"req_011Cfxmarc8K6KwhUASrkXY5","wire_tool_inputs":{"toolu_01VLqcDDsvVTZcjBBsukhPPe":{"command":"cd /Users/sto/workspace/datomworld-srvm-p6c && python3 - <<'EOF'\np='src/cljc/yin/vm/semantic_register/layout.cljc'\ns=open(p).read()\ns=s.replace(\"            [yin.vm.engine :as engine]\\n\",\"            [yin.vm.engine :as engine]\\n            [yin.vm.module :as module]\\n\",1)\ns+=r'''(defn kernel-kind\n  \"`:stack` or `:register`, by the kernel's link format.\"\n  [k]\n  (let [f (when (satisfies? module/IModuleKernel k) (:format (module/link-format k)))]\n    (cond\n      (= stack/format-tag f) :stack\n      (= register/format-tag f) :register\n      :else (refuse! :yin.k/unsupported :kernel {:yin.k/format f}))))\n\n\n(defn- image-pc\n  \"`[segment rel-pc]` of an absolute kernel pc.\"\n  [kind k space pc]\n  (let [[ident rel] (or (if (= :stack kind) (stack/image-pc k pc) (register/image-pc k pc))\n                        (refuse! :yin.k/non-portable :unknown-image {:yin.k/pc pc}))]\n    [(image-segment space kind ident) rel]))\n\n\n(defn- offset\n  \"The offset of segment `seg`'s image in kernel `k`'s code space.\"\n  [kind k seg]\n  (let [ident (if (= :stack kind) (:stack-id seg) (:register-id seg))]\n    (or (if (= :stack kind) (stack/absolute-pc k [ident 0]) (register/absolute-pc k [ident 0]))\n        (refuse! :yin.k/unsatisfied :image-not-attached {:yin.k/segment (:address seg)}))))\n\n\n(def ^:private parking-ops\n  \"A1: the instructions a resume pc may follow, besides a non-tail call.\"\n  #{:stream-next :stream-put :ffi-call :park :current-continuation})\n\n\n(defn- safepoint!\n  \"Refuse `:yin.k/not-at-safepoint` unless the A instruction before `pc`\n   parks: a layout never invents a safepoint (§4.5).\"\n  [seg pc tail?]\n  (let [t (when (and (integer? pc) (< 0 pc (inc (count (:vector seg))))) (inst seg (dec pc)))\n        op (when t (nth t 0))]\n    (when-not (and t (if tail?\n                       (code/tail-call? t)\n                       (or (contains? parking-ops op) (and (= :call op) (not (code/tail-call? t))))))\n      (refuse! :yin.k/not-at-safepoint nil {:yin.k/pc pc}))))\n\n\n(defn- h->a\n  \"The A pc of H pc `hpc`, or not-at-safepoint for a `:push`.\"\n  [seg hpc]\n  (or (get (:h->a seg) hpc) (refuse! :yin.k/not-at-safepoint nil {:yin.k/pc hpc})))\n\n\n(defn- a->h\n  [seg pc]\n  (nth (:a->h seg) pc))\n\n\n;; =============================================================================\n;; Values: positional closures and kernel continuations, both ways\n;; =============================================================================\n;;\n;; A lift context `cx` is {:kind :kernel :space :free-env :owner}; a lower\n;; context `lx` is {:kind :kernel :space :free-env :owner :address}, where\n;; :address names a canonical closure's or payload's :segment as A.\n\n(declare lift-state lower-state)\n\n\n(defn- walk-value\n  \"Rebuild guest collections of `x` around `f`, which converts closures\n   and continuations.\"\n  [f x]\n  (cond\n    (values/host-typed? x) (f x)\n    (map? x) (into {} (map (fn [[k v]] [(walk-value f k) (walk-value f v)])) x)\n    (vector? x) (mapv #(walk-value f %) x)\n    (set? x) (into #{} (map #(walk-value f %)) x)\n    (seq? x) (apply list (map #(walk-value f %) x))\n    :else x))\n\n\n(defn- canonical-closure\n  \"§4.4: a positional closure as the canonical `{:type :closure :params\n   :entry :segment :env}`, `params` from A's `:closure` at the owner of\n   the entry body, `env` by the forward rule over its frames.\"\n  [cx c]\n  (let [[seg rel] (image-pc (:kind cx) (:kernel cx) (:space cx) (:body-pc c))\n        entry (if (= :stack (:kind cx)) (h->a seg rel) rel)\n        owner (:owner (nth (:bodies seg) (body-of seg entry)))\n        _ (when-not (and owner (= entry (nth (inst seg owner) 3)))\n            (refuse! :yin.k/non-portable :closure-origin {:yin.k/entry entry}))\n        ps (params seg owner)]\n    (when-not (= (count ps) (:arity c))\n      (refuse! :yin.k/non-portable :closure-binders {:yin.k/entry entry}))\n    {:type :closure :params ps :entry entry :segment (:address seg)\n     :env (env-of seg owner (:free-env cx)\n                  (mapv (fn [f] (mapv #(walk-value (partial canonical-value* cx) %) f)) (:frames c))\n                  (:store-of c))}))\n\n\n(defn- canonical-value*\n  [cx x]\n  (cond\n    (values/closure? x) (values/closure (:owner cx) (canonical-closure cx (values/payload x)))\n    (values/continuation? x)\n    (values/continuation (:owner cx) (assoc (lift-state cx (values/payload x)) :type :reified-continuation))\n    :else x))\n\n\n(defn canonical-value\n  \"A kernel value with every positional closure and kernel continuation\n   reconstructed canonically (cx: a lift context).\"\n  [cx x]\n  (walk-value (partial canonical-value* cx) x))\n\n\n(defn- address-of\n  [lx seg-id]\n  (let [a ((:address lx) seg-id)]\n    (when (nil? a) (refuse! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg-id}))\n    a))\n\n\n(defn- positional-closure\n  \"The inverse of canonical-closure: the entry's absolute pc in the\n   receiving kernel and the frames read back from `env` by the chain.\"\n  [lx c]\n  (let [seg (segment-of (:space lx) (address-of lx (:segment c)))\n        entry (:entry c)\n        owner (:owner (nth (:bodies seg) (body-of seg entry)))\n        off (offset (:kind lx) (:kernel lx) seg)\n        store-of (engine/env-store-of (:env c))]\n    (when-not (and owner (= (vec (:params c)) (vec (params seg owner))))\n      (refuse! :yin.k/undecodable :closure-binders {:yin.k/entry entry}))\n    (cond-> {:type :closure :arity (count (:params c))\n             :body-pc (+ off (if (= :stack (:kind lx)) (a->h seg entry) entry))\n             :frames (mapv (fn [f] (mapv #(positional-value lx %) f)) (frames-of seg owner (:env c)))}\n      (some? store-of) (assoc :store-of store-of))))\n\n\n(defn- positional-value*\n  [lx x]\n  (cond\n    (values/closure? x) (values/closure (:owner lx) (positional-closure lx (values/payload x)))\n    (values/continuation? x)\n    (values/continuation (:owner lx) (merge {:type :reified-continuation} (lower-state lx (values/payload x))))\n    :else x))\n\n\n(defn positional-value\n  \"A canonical value with every closure and continuation lowered into the\n   receiving kernel (lx: a lower context).\"\n  [lx x]\n  (walk-value (partial positional-value* lx) x))\n\n\n;; =============================================================================\n;; Lift: a kernel payload as the canonical act or tail\n;; =============================================================================\n\n(def ^:private kernel-keys\n  \"The register payload keys of either kernel; every other key of an\n   entry is the engine's and travels as the pending.\"\n  #{:segment :site-pc :pc :frames :regs :live :continuation :dest :resume-mode\n    :format :hash :image :images :store-of :stack})\n\n\n(defn- engine-fields\n  [conv entry]\n  (let [fields (apply dissoc entry kernel-keys)]\n    (cond-> fields (contains? fields :datom) (update :datom conv))))\n\n\n(defn- canonical-env\n  [cx seg pc frames store-of]\n  (env-of seg pc (:free-env cx)\n          (mapv (fn [f] (mapv #(canonical-value cx %) f)) frames)\n          store-of))\n\n\n(defn- register-kframe\n  \"§4.2 step 6, one frame independently: its image row, A, `rd` from A.\"\n  [cx f]\n  (let [[seg pc] (image-pc :register (:kernel cx) (:space cx) (:return-pc f))\n        _ (safepoint! seg pc false)\n        site (dec pc)]\n    {:type :return :segment (:address seg) :pc pc\n     :env (canonical-env cx seg pc (:frames f) (:store-of f))\n     :window (into {} (map (fn [[s x]] [(virt seg site s) (canonical-value cx x)])) (:regs f))\n     :rd (code/rd (inst seg site))}))\n\n\n(defn- lift-register\n  [cx entry]\n  (let [[seg rel] (image-pc :register (:kernel cx) (:space cx) (:pc entry))\n        tail? (= :return-result (:resume-mode entry))\n        k (mapv #(register-kframe cx %) (:continuation entry))]\n    (safepoint! seg rel tail?)\n    (if tail?\n      {:segment (:address seg) :site (dec rel) :k k :deliver {:deliver :return}}\n      (let [site (dec rel)]\n        {:segment (:address seg) :pc rel\n         :env (canonical-env cx seg rel (:frames entry) (:store-of entry))\n         :window (into {} (map (fn [[s x]] [(virt seg site s) (canonical-value cx x)])) (:regs entry))\n         :k k\n         :deliver {:deliver :rd :rd (code/rd (inst seg site))}}))))\n\n\n(defn- slice-window\n  \"`(zipmap (stack-layout (dec pc)) slice)`, the two of equal length.\"\n  [cx seg pc slice]\n  (let [layout (stack-layout seg (dec pc))]\n    (when-not (= (count layout) (count slice))\n      (refuse! :yin.k/non-portable :stack-layout {:yin.k/pc pc :yin.k/layout layout :yin.k/slice (count slice)}))\n    (zipmap layout (map #(canonical-value cx %) slice))))\n\n\n(defn slices\n  \"§4.3 K slices of an operand stack `st` under return frames with bases\n   `bases` (outermost first): `St[b(i-1), b(i))` per frame, `b(-1) = 0`,\n   then the current activation's `St[b(m-1), n)`.\"\n  [st bases]\n  (let [bounds (into [0] bases)]\n    (conj (mapv (fn [lo hi] (subvec st lo hi)) bounds (rest bounds))\n          (subvec st (peek bounds) (count st)))))\n\n\n(defn- stack-pc\n  \"The canonical resume pc of an absolute stack resume pc.\"\n  [cx abs]\n  (let [[seg rel] (image-pc :stack (:kernel cx) (:space cx) abs)]\n    [seg (inc (h->a seg (dec rel)))]))\n\n\n(defn- lift-stack\n  [cx entry]\n  (let [st (vec (:stack entry))\n        frames (:continuation entry)\n        bases (mapv :stack-base frames)\n        _ (when-not (and (every? integer? bases) (apply <= 0 (conj bases (count st))))\n            (refuse! :yin.k/non-portable :stack-base {:yin.k/bases bases}))\n        parts (slices st bases)\n        k (mapv (fn [f slice]\n                  (let [[seg pc] (stack-pc cx (:return-pc f))]\n                    (safepoint! seg pc false)\n                    {:type :return :segment (:address seg) :pc pc\n                     :env (canonical-env cx seg pc (:frames f) (:store-of f))\n                     :window (slice-window cx seg pc slice)\n                     :rd (code/rd (inst seg (dec pc)))}))\n                frames parts)\n        [seg rel] (image-pc :stack (:kernel cx) (:space cx) (:pc entry))\n        site (h->a seg (dec rel))\n        tail? (code/tail-call? (inst seg site))]\n    (safepoint! seg (inc site) tail?)\n    (if tail?\n      {:segment (:address seg) :site site :k k :deliver {:deliver :return}}\n      (let [pc (inc site)]\n        {:segment (:address seg) :pc pc\n         :env (canonical-env cx seg pc (:frames entry) (:store-of entry))\n         :window (slice-window cx seg pc (peek parts))\n         :k k\n         :deliver {:deliver :rd :rd (code/rd (inst seg site))}}))))\n\n\n(defn lift-state\n  \"A kernel's wait entry, parked record or reified payload as the\n   canonical act or tail payload, engine fields carried (§4.2, §4.3).\"\n  [cx entry]\n  (merge (engine-fields #(canonical-value cx %) entry)\n         (if (= :stack (:kind cx)) (lift-stack cx entry) (lift-register cx entry))))\n\n\n(defn lift-context\n  \"The lift context of kernel `k` over `space`: positional closures and\n   continuations are reminted under `owner`.\"\n  [k space owner]\n  (assoc {} :kind (kernel-kind k) :kernel k :space space :free-env (or (:free-env k) {}) :owner owner))\n\n\n;; =============================================================================\n;; Lower: a canonical act or tail into a kernel\n;; =============================================================================\n\n(defn- lower-frames\n  [lx seg pc env]\n  (mapv (fn [f] (mapv #(positional-value lx %) f)) (frames-of seg pc env)))\n\n\n(defn- payload-segment\n  [lx p]\n  (segment-of (:space lx) (address-of lx (:segment p))))\n\n\n(defn- lower-regs\n  [lx seg pc w]\n  (vec (sort-by first (map (fn [[x v]] [(phys seg pc x) (positional-value lx v)]) w))))\n\n\n(defn- register-k\n  [lx k]\n  (mapv (fn [f]\n          (let [seg (payload-segment lx f)\n                off (offset :register (:kernel lx) seg)\n                pc (:pc f)\n                regs (lower-regs lx seg pc (:window f))\n                store-of (engine/env-store-of (:env f))]\n            (cond-> {:site-pc (+ off pc -1) :return-pc (+ off pc)\n                     :frames (lower-frames lx seg pc (:env f))\n                     :regs regs :live (mapv first regs)\n                     :dest (phys seg (dec pc) (:rd f))}\n              (some? store-of) (assoc :store-of store-of))))\n        k))\n\n\n(defn- register-common\n  [k ident]\n  (cond-> {:segment (:segment k) :format register/format-tag :hash (:hash k) :image ident}\n    (< 1 (count (:images k))) (assoc :images (:images k))))\n\n\n(defn- lower-register\n  [lx p fill]\n  (let [k (:kernel lx)\n        seg (payload-segment lx p)\n        off (offset :register k seg)\n        common (register-common k (:register-id seg))\n        kk (register-k lx (:k p))]\n    (if (contains? p :site)\n      (merge common\n             {:site-pc (+ off (:site p)) :pc (+ off (:site p) 1)\n              :frames (:frames fill []) :regs [] :live [] :continuation kk :dest nil\n              :resume-mode :return-result}\n             (when (some? (:store-of fill)) {:store-of (:store-of fill)}))\n      (let [pc (:pc p)\n            regs (lower-regs lx seg pc (:window p))\n            store-of (engine/env-store-of (:env p))]\n        (cond-> (merge common\n                       {:site-pc (+ off pc -1) :pc (+ off pc)\n                        :frames (lower-frames lx seg pc (:env p))\n                        :regs regs :live (mapv first regs) :continuation kk\n                        :dest (phys seg (dec pc) (get-in p [:deliver :rd]))\n                        :resume-mode :write-result})\n          (some? store-of) (assoc :store-of store-of))))))\n\n\n(defn- layout-slice\n  \"`(mapv W (stack-layout (dec pc)))`, every member present in W.\"\n  [lx seg pc w]\n  (mapv (fn [x]\n          (when-not (contains? w x)\n            (refuse! :yin.k/undecodable :window-missing {:yin.k/pc pc :yin.k/register x}))\n          (positional-value lx (get w x)))\n        (stack-layout seg (dec pc))))\n\n\n(defn- stack-k\n  \"The return frames and their slices, bases cumulative through each\n   slice (§4.3): `b(i) = b(i-1) + |slice(i)|`.\"\n  [lx k]\n  (reduce (fn [[frames st] f]\n            (let [seg (payload-segment lx f)\n                  pc (:pc f)\n                  slice (layout-slice lx seg pc (:window f))\n                  st (into st slice)\n                  store-of (engine/env-store-of (:env f))]\n              [(conj frames (cond-> {:return-pc (+ (offset :stack (:kernel lx) seg) (a->h seg (dec pc)) 1)\n                                     :frames (lower-frames lx seg pc (:env f))\n                                     :stack-base (count st)}\n                              (some? store-of) (assoc :store-of store-of)))\n               st]))\n          [[] []]\n          k))\n\n\n(defn- lower-stack\n  [lx p fill]\n  (let [k (:kernel lx)\n        seg (payload-segment lx p)\n        off (offset :stack k seg)\n        [frames st] (stack-k lx (:k p))\n        common {:segment (:segment k) :format stack/format-tag :hash (:hash k) :image (:stack-id seg)}]\n    (if (contains? p :site)\n      (merge common\n             {:pc (+ off (a->h seg (:site p)) 1) :resume-mode :return-result\n              :stack st :frames (:frames fill []) :continuation frames}\n             (when (some? (:store-of fill)) {:store-of (:store-of fill)}))\n      (let [pc (:pc p)\n            store-of (engine/env-store-of (:env p))]\n        (cond-> (merge common\n                       {:pc (+ off (a->h seg (dec pc)) 1)\n                        :frames (lower-frames lx seg pc (:env p))\n                        :stack (into st (layout-slice lx seg pc (:window p)))\n                        :continuation frames})\n          (some? store-of) (assoc :store-of store-of))))))\n\n\n(def ^:private canonical-keys\n  #{:segment :pc :site :env :window :k :deliver :type :id})\n\n\n(defn lower-state\n  \"A canonical act or tail payload as the receiving kernel's entry, engine\n   fields carried (§4.2, §4.3). `fill` gives a tail entry's unobservable\n   `:frames`/`:store-of` (default `[]`/nil; §5.6 item 8).\"\n  ([lx p] (lower-state lx p {}))\n  ([lx p fill]\n   (merge (let [fields (apply dissoc p canonical-keys)]\n            (cond-> fields (contains? fields :datom) (update :datom #(positional-value lx %))))\n          (if (= :stack (:kind lx)) (lower-stack lx p fill) (lower-register lx p fill)))))\n\n\n(defn lower-context\n  \"The lower context into kernel `k` over `space`; `address` maps a\n   payload's or closure's `:segment` to A (default: it is A).\"\n  ([k space] (lower-context k space identity))\n  ([k space address]\n   (assoc {} :kind (kernel-kind k) :kernel k :space space :free-env (or (:free-env k) {})\n          :owner (:owner k) :address address)))\n\n\n;; =============================================================================\n;; Tasks\n;; =============================================================================\n\n(defn- refuse-busy!\n  [k]\n  (when (engine/active-continuation? k)\n    (refuse! :yin.k/not-at-safepoint nil {:yin.k/pc (:pc k)}))\n  (when (seq (:installs k))\n    (refuse! :yin.k/unsupported :installs {:yin.k/names (vec (keys (:installs k)))})))\n\n\n(defn canonical-task\n  \"Quiescent kernel `k` presented as the semantic-register machine\n   `template` (a fresh machine of the same composition): code by A from\n   `space`, every wait, parked record and value reconstructed through the\n   layout, resources, stores and counters carried. `rows/lift-task` then\n   lifts it as it lifts its own kernel.\"\n  [k space template]\n  (refuse-busy! k)\n  (let [cx (lift-context k space (:owner template))\n        conv #(canonical-value cx %)\n        parked (into {} (map (fn [[id rec]]\n                               [id (assoc (lift-state cx rec) :type :parked-continuation :id id)]))\n                     (:parked k))\n        value (:value k)\n        parked-value? (and (map? value) (= :parked-continuation (:type value)) (contains? parked (:id value)))\n        code (into {} (map (fn [[a s]] [a (assoc {} :vector (:vector s) :address a :analysis (:analysis s))]))\n                   (:segments space))]\n    (assoc template\n           :code code\n           :code-aliases (into {} (map (fn [a] [a a])) (keys code))\n           :program nil :control nil :window {} :k nil\n           :resources (:resources k)\n           :capability-secret (:capability-secret k)\n           :free-env (:free-env k)\n           :env (or (:free-env k) {})\n           :store (conv (:store k))\n           :module-stores (conv (or (:module-stores k) {}))\n           :parked parked\n           :wait-set (mapv #(lift-state cx %) (:wait-set k))\n           :ready-queue (:ready-queue k)\n           :value (if parked-value? (get parked (:id value)) (conv value))\n           :id-counter (:id-counter k)\n           :installs {}\n           :halted? (:halted? k)\n           :blocked? (:blocked? k))))\n\n\n(defn- attach-all\n  \"`k` holding the image of every segment of `space`, in A order.\"\n  [k space]\n  (let [kind (kernel-kind k)]\n    (reduce (fn [k a]\n              (let [seg (segment-of space a)]\n                (if (= :stack kind)\n                  (stack/attach-image k (:stack seg) vm-stack-contract)\n                  (register/attach-image k (:register seg) vm-register-contract))))\n            k\n            (sort-by str (keys (:segments space))))))\n'''\nopen(p,'w').write(s)\nEOF","description":"Append dynamic half to layout"}},"wire_ingest_context":{"toolu_01VLqcDDsvVTZcjBBsukhPPe":{"cwd":"/Users/sto/workspace/datomworld-srvm-p6c"}}}
