,"+      (assoc k :stack [])","+      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))","+","+"," (defn load-program","   [m ast]","-  (sr/load-vector m (project ast) code/contract))","+  (if (= :semantic-register (lane-of m))","+    (sr/load-vector m (project ast) code/contract)","+    (kernel-load m (project ast))))"," "," ","+(defn lane-closure","+  \"Canonical closure payload c, its :segment an A, as machine m's value.\"","+  [m c]","+  (if (= :semantic-register (lane-of m))","+    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))","+    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))","+","+"," (defn lift-opts","   []","   {:source-index @source-index})"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_019QdUFrB6DWxXTr1kSHg79U","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
