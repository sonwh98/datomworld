{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RzLCD5WZ7eKCg5zzXM8aCE","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.safepoint-harness-test\n2\t  \"Phase 6b: the safepoint harness on the :semantic-register lane\n3\t   (docs/design/yin.vm.semantic-register-vm.continuation.md §5, §8.2).\n4\t\n5\t   Each row of the §5.2 matrix is built twice under each of the four\n6\t   segment wrappers: the reference build is satisfied and run on its own\n7\t   machine; the handoff build is lifted with rows/lift-task, lowered with\n8\t   rows/lower-task into a fresh receiver over the toy channel, relifted at\n9\t   once, then satisfied through the source's streams. Result and effect\n10\t   trace equal the reference (law 1); the relift equals the lift by root\n11\t   id under rows/canonical-under (law 2); the pending's reason is the\n12\t   observed wait's (law 3); every lifted frame passes the validator\n13\t   (law 6). Row 20 runs once, outside the wrappers.\"\n14\t  (:require [clojure.test :refer [deftest is testing]]\n15\t            [dao.jing :as jing]\n16\t            [dao.stream :as stream]\n17\t            [dao.stream.apply :as apply2]\n18\t            [dao.test-slow :as slow]\n19\t            [yin.vm :as vm]\n20\t            [yin.vm.engine :as engine]\n21\t            [yin.vm.ffi :as ffi]\n22\t            [yin.vm.module :as module]\n23\t            [yin.vm.values :as values]\n24\t            [yin.vm.test-utils :as tu]\n25\t            [yin.vm.semantic-register :as sr]\n26\t            [yin.vm.semantic-register.code :as code]\n27\t            [yin.vm.semantic-register.frame :as frame]\n28\t            [yin.vm.semantic-register.frame-test :as ft]\n29\t            [yin.vm.semantic-register.linearize :as linearize]\n30\t            [yin.vm.ucf.lift-support :as support]\n31\t            [yin.vm.ucf.rows :as rows]\n32\t            [yin.vm.ucf.v2-support :as s]))\n33\t\n34\t\n35\t;; =============================================================================\n36\t;; The composition: code by A, the source index, one machine builder\n37\t;; =============================================================================\n38\t\n39\t(def source-index\n40\t  \"The composition's {A #{tree-address}} (§6.1): every vector this\n41\t   harness projects is recorded beside the address of its AST.\"\n42\t  (atom {}))\n43\t\n44\t\n45\t(defn project\n46\t  [ast]\n47\t  (let [v (:vector (linearize/project ast))]\n48\t    (swap! source-index update (jing/segment-key v) (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n49\t    v))\n50\t\n51\t\n52\t(def stream-modules (module/register-stream-module (module/default-registry)))\n53\t\n54\t\n55\t(defn machine\n56\t  ([] (machine {}))\n57\t  ([opts]\n58\t   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n59\t                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n60\t                         :modules stream-modules}\n61\t                        opts))))\n62\t\n63\t\n64\t(defn load-program\n65\t  [m ast]\n66\t  (sr/load-vector m (project ast) code/contract))\n67\t\n68\t\n69\t(defn lift-opts\n70\t  []\n71\t  {:source-index @source-index})\n72\t\n73\t\n74\t(defn error\n75\t  [f]\n76\t  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n77\t\n78\t\n79\t;; =============================================================================\n80\t;; The corpus: four segments around one parking expression\n81\t;; =============================================================================\n82\t\n83\t(defn cat-of\n84\t  [p q]\n85\t  (s/app (s/v 'cat) p q))\n86\t\n87\t\n88\t(defn with-cat\n89\t  [ast]\n90\t  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n91\t\n92\t\n93\t(defn nest\n94\t  [d op]\n95\t  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n96\t\n97\t\n98\t(def segments\n99\t  \"[label wrap expected-of-bare-result] (§5.2).\"\n100\t  [[:bare identity identity]\n101\t   [:operand #(cat-of (s/lit [:operand]) %) (fn [r] [:operand r])]\n102\t   [:depth-3 #(nest 3 %) (fn [r] [3 [2 [1 r]]])]\n103\t   [:captured #(s/let1 'k (s/lit :captured)\n104\t                       (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n105\t                               (s/app (s/v 'f) (s/lit :arg))))\n106\t    (fn [r] [:captured :arg r])]])\n107\t\n108\t\n109\t(defn with-stream\n110\t  [body]\n111\t  (s/let1 's {:type :stream/make :buffer 4} (s/let1 'c (s/cursor-of (s/v 's)) body)))\n112\t\n113\t\n114\t(defn tail\n115\t  [ast]\n116\t  (assoc ast :tail? true))\n117\t\n118\t\n119\t(defn normalize\n120\t  [x]\n121\t  (cond\n122\t    (values/continuation? x) :continuation\n123\t    (values/closure? x) :closure\n124\t    (vector? x) (mapv normalize x)\n125\t    (seq? x) (apply list (map normalize x))\n126\t    (set? x) (into #{} (map normalize) x)\n127\t    (map? x) (into {} (map (fn [[k v]] [(normalize k) (normalize v)])) x)\n128\t    :else x))\n129\t\n130\t\n131\t;; =============================================================================\n132\t;; The rows of §5.2: one builder each, answering the parked machine\n133\t;; =============================================================================\n134\t;;\n135\t;; A world: :machine, :kind, :reason (blocked rows), :steps (each followed by\n136\t;; a drive) or :resume, :finish (records the effect trace), :trace, and\n137\t;; :receiver (fresh opts and a finish for the receiver's own composition).\n138\t\n139\t(defn reader\n140\t  \"A reader parked on (next-of c); :pre values are appended and the\n141\t   machine re-run first.\"\n142\t  ([wrap op] (reader wrap op [] \"B\" {}))\n143\t  ([wrap op pre value opts]\n144\t   (let [m0 (vm/run (load-program (machine opts) (with-stream (with-cat (wrap op)))))\n145\t         src (s/stream-of m0)\n146\t         m (reduce (fn [m x] (stream/append! src x) (vm/run m)) m0 pre)]\n147\t     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src value)] :trace (atom [])})))\n148\t\n149\t\n150\t(defn writer\n151\t  [wrap]\n152\t  (let [trace (atom [])\n153\t        w (support/one-slot-stream \"w\")\n154\t        _ (stream/append! w :warmed)\n155\t        m0 (load-program (machine) (with-cat (wrap {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")})))\n156\t        [ref m1] (engine/attach-resource m0 w)\n157\t        take! #(swap! trace conj (:dao.stream/value (stream/next w 0)))]\n158\t    {:machine (vm/run (assoc m1 :store {'w ref})) :kind :blocked :reason :put :surfaces #{:reader :writer}\n159\t     :steps [take!] :finish take! :trace trace}))\n160\t\n161\t\n162\t(defn own-call-pair\n163\t  [trace]\n164\t  (let [own-in (s/ring 8) own-out (s/ring 8)]\n165\t    {:opts {:call-in own-in :call-out own-out :call-out-cursor (vm/mint-oldest own-out :test)}\n166\t     :finish #(swap! trace into (tu/drain own-in))}))\n167\t\n168\t\n169\t(defn caller\n170\t  [wrap call-in call-out]\n171\t  (vm/run (load-program (machine {:call-in call-in :call-out call-out\n172\t                                  :call-out-cursor (vm/mint-oldest call-out :test)})\n173\t                        (with-cat (wrap (s/call-node :op/echo \"hello\"))))))\n174\t\n175\t\n176\t(defn sent-ffi\n177\t  [wrap]\n178\t  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n179\t        m (caller wrap call-in call-out)\n180\t        id (ffi/response-call-id (first (:wait-set m)))]\n181\t    {:machine m :kind :blocked :reason :ffi :call-id id\n182\t     :steps [#(stream/append! call-out (apply2/success-response id \"echo!\"))]\n183\t     :finish #(swap! trace into (tu/drain call-in))\n184\t     :receiver #(own-call-pair trace) :trace trace}))\n185\t\n186\t\n187\t(defn retained-ffi\n188\t  [wrap]\n189\t  (let [trace (atom []) call-in (support/one-slot-stream \"call-in\") call-out (s/ring 8)\n190\t        _ (stream/append! call-in :warmed)\n191\t        m (caller wrap call-in call-out)\n192\t        id (ffi/request-call-id (first (:wait-set m)))]\n193\t    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n194\t     :steps [#(stream/next call-in 0)\n195\t             (fn []\n196\t               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n197\t               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n198\t     :receiver #(own-call-pair trace) :trace trace}))\n199\t\n200\t\n201\t(defn module-response\n202\t  [body exports]\n203\t  {:status :ok :image {:value (project body)}\n204\t   :manifest {:yin.module/name 'host.mod :yin.module/exports exports} :obligations []})\n205\t\n206\t\n207\t(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n208\t\n209\t\n210\t(def blocking-body\n211\t  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n212\t   binding holds the stream, so f's E does not capture it.\"\n213\t  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n214\t\n215\t\n216\t(defn require-op\n217\t  [tail?]\n218\t  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n219\t    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n220\t\n221\t\n222\t(defn link-receiver\n223\t  [trace]\n224\t  (fn []\n225\t    (let [rq (s/ring 64)]\n226\t      {:opts {:link-request rq :link-response (s/ring 64)} :finish #(swap! trace into (tu/drain rq))})))\n227\t\n228\t\n229\t(defn linking\n230\t  \"A require parked in :link-response (or :link-request behind a full,\n231\t   warmed request stream when retained?).\"\n232\t  [wrap tail? retained?]\n233\t  (let [trace (atom [])\n234\t        request (if retained? (support/one-slot-stream \"link-request\") (s/ring 64))\n235\t        response (s/ring 64)\n236\t        _ (when retained? (stream/append! request :warmed))\n237\t        m (vm/run (load-program (machine {:link-request request :link-response response})\n238\t                                (with-cat (wrap (require-op tail?)))))\n239\t        id (:link-id (first (:wait-set m)))\n240\t        answer! #(stream/append! response (assoc (module-response plain-body #{'f}) :yin.link/id id))]\n241\t    {:machine m :kind :blocked :reason (if retained? :link-request :link-response)\n242\t     :surfaces #{:reader :writer} :trace trace\n243\t     :steps (if retained? [#(stream/next request 0) answer!] [answer!])\n244\t     :finish (if retained?\n245\t               #(swap! trace conj (:dao.stream/value (stream/next request 0)))\n246\t               #(swap! trace into (tu/drain request)))\n247\t     :receiver (link-receiver trace)}))\n248\t\n249\t\n250\t(defn installing\n251\t  \"A require parked on :install beside its blocked child.\"\n252\t  [wrap tail? phase]\n253\t  (let [trace (atom [])\n254\t        request (s/ring 64) response (s/ring 64)\n255\t        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n256\t                                 (with-cat (wrap (require-op tail?)))))\n257\t        id (:link-id (first (:wait-set m0)))\n258\t        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n259\t        m1 (vm/run m0)\n260\t        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n261\t        child (get-in m [:installs 'host.mod :vm])\n262\t        child-stream (s/stream-of child)]\n263\t    {:machine m :kind :blocked :reason :install :trace trace\n264\t     :steps [#(stream/append! child-stream :fed)]\n265\t     :finish #(swap! trace into (tu/drain request))\n266\t     :receiver (link-receiver trace)}))\n267\t\n268\t\n269\t(defn module-context\n270\t  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n271\t  [wrap]\n272\t  (let [request (s/ring 64) response (s/ring 64)\n273\t        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n274\t        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n275\t                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n276\t                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n277\t        id (:link-id (first (:wait-set m0)))\n278\t        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n279\t        m (vm/run m0)\n280\t        src (s/stream-of m)]\n281\t    ;; The carrier holds module stores, not registry entries: the receiver's\n282\t    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n283\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n284\t     :receiver (constantly {:opts {:modules (:modules m)}})}))\n285\t\n286\t\n287\t(defn run-beside\n288\t  [m ast]\n289\t  (vm/run (load-program m ast)))\n290\t\n291\t\n292\t(defn parking\n293\t  [m]\n294\t  (let [pid (:id (vm/value m))]\n295\t    {:machine m :kind :parked :pid pid :trace (atom [])\n296\t     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n297\t\n298\t\n299\t(defn module-store-cursors\n300\t  \"An explicit park whose module store holds two cursor references nothing\n301\t   else reaches, named by a module closure in the task store.\"\n302\t  [wrap]\n303\t  (let [ring (s/ring 4)\n304\t        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n305\t        cursor (fn [m]\n306\t                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n307\t                   (engine/handle-cursor m {:stream ref} id)))\n308\t        [c1 m] (cursor m)\n309\t        [c2 m] (cursor m)\n310\t        [seg image] (first (:code m))\n311\t        closure (first (filter #(= :closure (first %)) (:vector image)))\n312\t        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n313\t                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n314\t    (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n315\t\n316\t\n317\t(defn free-env-world\n318\t  [wrap env]\n319\t  (reader wrap (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) (s/next-of (s/v 'c)))) (s/lit 1)))\n320\t          [] \"B\" {:env env}))\n321\t\n322\t\n323\t(def read-op (s/next-of (s/v 'c)))\n324\t\n325\t\n326\t(def capture {:type :vm/current-continuation})\n327\t\n328\t\n329\t(def rows\n330\t  \"[row bare-result build]: rows 1-19, 21, 22, 24 of §5.2. A nil result\n331\t   compares with the reference only.\"\n332\t  [[1 [\"A\" \"B\"] #(reader % (s/let1 'a read-op (cat-of (cat-of (s/lit []) (s/v 'a)) read-op)) [\"A\"] \"B\" {})]\n333\t   [2 nil writer]\n334\t   [3 \"echo!\" sent-ffi]\n335\t   [4 \"echo!\" retained-ffi]\n336\t   [5 [:ordinary \"B\"] #(reader % (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c))))]\n337\t   [6 \"B\" #(reader % (s/app (s/lam ['u] (tail (s/app (s/v 'stream/next!) (s/v 'c)))) (s/lit 0)))]\n338\t   [7 'host.mod #(linking % false true)]\n339\t   [8 'host.mod #(linking % false false)]\n340\t   [9 'host.mod #(linking % true false)]\n341\t   [10 'host.mod #(installing % false nil)]\n342\t   [11 'host.mod #(installing % false :running)]\n343\t   [12 'host.mod #(installing % true nil)]\n344\t   [13 \"back\" #(parking (vm/run (load-program (machine) (with-cat (% {:type :vm/park})))))]\n345\t   [14 [:continuation \"B\"] #(reader % (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read-op)))]\n346\t   [15 :done #(reader % (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n347\t                                            :consequent (s/lit :done)\n348\t                                            :alternate (s/let1 'r read-op (s/app (s/v 'k) (s/lit :second)))})\n349\t                      [] \"x\" {})]\n350\t   [16 [:continuation :continuation \"B\"]\n351\t    #(reader % (s/let1 'k1 capture (s/let1 'k2 capture (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read-op))))]\n352\t   [17 \"B\" module-context]\n353\t   [18 \"back\" module-store-cursors]\n354\t   [19 42 #(let [m (vm/run (load-program (machine) (with-cat (% (s/lit 42)))))]\n355\t             {:machine m :kind :halted :trace (atom [])})]\n356\t   [21 99 #(free-env-world % {'x 99})]\n357\t   [22 [nil \"B\"] #(reader % (s/let1 'pair (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n358\t                                    (s/app (s/v 'pair) (s/lit nil) read-op)))]\n359\t   [24 \"echo!\" sent-ffi]])\n360\t\n361\t\n362\t(defn tail-effect-halt\n363\t  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n364\t   call (stream/next! c) with an empty K.\"\n365\t  []\n366\t  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n367\t                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n368\t        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n369\t        src (s/stream-of m)]\n370\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n371\t\n372\t\n373\t;; =============================================================================\n374\t;; The two runs\n375\t;; =============================================================================\n376\t\n377\t(defn drive-local\n378\t  [m]\n379\t  (loop [m (vm/run m) n 12]\n380\t    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n381\t\n382\t\n383\t(defn drive-peers\n384\t  [m peers]\n385\t  (loop [m (vm/run m) n 12]\n386\t    (if (or (not (vm/blocked? m)) (zero? n))\n387\t      m\n388\t      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n389\t\n390\t\n391\t(defn satisfy\n392\t  [world m drive]\n393\t  (if-let [resume (:resume world)]\n394\t    (resume m)\n395\t    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n396\t\n397\t\n398\t(defn reference\n399\t  [world]\n400\t  (let [done (satisfy world (:machine world) drive-local)]\n401\t    (when-let [f (:finish world)] (f))\n402\t    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n403\t\n404\t\n405\t(defn served\n406\t  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n407\t  [surfaces]\n408\t  (let [t (s/toy) peer (s/served-peer t)]\n409\t    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n410\t\n411\t\n412\t(defn recording-attacher\n413\t  \"The receiver's attach!, counting attaches and recording each\n414\t   reflection's source identity.\"\n415\t  [t]\n416\t  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n417\t    {:attach! (fn [d]\n418\t                (swap! n inc)\n419\t                (let [r (base d)]\n420\t                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n421\t                  r))\n422\t     :origin origin :count n}))\n423\t\n424\t\n425\t(defn handed-off\n426\t  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n427\t   the source's streams.\"\n428\t  [world]\n429\t  (let [surfaces (or (:surfaces world) #{:reader})\n430\t        {:keys [toy peer serve!]} (served surfaces)\n431\t        wire (rows/lift-task (:machine world) serve! (lift-opts))\n432\t        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n433\t        receiver ((or (:receiver world) (constantly nil)))\n434\t        {:keys [attach! origin] n :count} (recording-attacher toy)\n435\t        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n436\t        attaches @n\n437\t        again (served surfaces)\n438\t        relift (rows/lift-task recv (:serve! again) (lift-opts))\n439\t        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n440\t        done (satisfy world recv #(drive-peers % [peer]))\n441\t        _ (s/serve-mirror! peer)]\n442\t    (when-let [f (:finish world)] (f))\n443\t    (when-let [f (:finish receiver)] (f))\n444\t    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n445\t     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n446\t\n447\t\n448\t(defn root-task\n449\t  [wire]\n450\t  (rows/decode wire))\n451\t\n452\t\n453\t(defn stream-identities\n454\t  \"The distinct stream identities of the whole carrier, install children\n455\t   included: one row table serves the tree.\"\n456\t  [wire]\n457\t  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n458\t\n459\t\n460\t(defn rows-in\n461\t  \"Every row node the decoded tree x reaches, once per path.\"\n462\t  [x]\n463\t  (cond\n464\t    (and (map? x) (contains? x :kind) (contains? x :slots)) (cons x (rows-in (:slots x)))\n465\t    (sequential? x) (mapcat rows-in x)\n466\t    :else nil))\n467\t\n468\t\n469\t(defn stream-occurrences\n470\t  \"How many times the decoded tree reaches a :stream row.\"\n471\t  [x]\n472\t  (count (filter #(= :stream (:kind %)) (rows-in x))))\n473\t\n474\t\n475\t(defn slot\n476\t  [task i]\n477\t  (nth (:slots task) i))\n478\t\n479\t\n480\t(defn first-pending\n481\t  [task]\n482\t  (second (:slots (first (slot task 13)))))\n483\t\n484\t\n485\t(defn laws\n486\t  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n487\t  [world expected]\n488\t  (let [{:keys [wire relift corr corr2 attaches] :as got} (handed-off world)\n489\t        task (root-task wire)]\n490\t    (is (= (:kind world) (slot task 2)))\n491\t    (is (= (count (stream-identities wire)) attaches) \"one attach per distinct stream identity\")\n492\t    (when (= :blocked (:kind world))\n493\t      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n494\t    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n495\t    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n496\t        \"law 2: lift(lower(S)) = S by root id\")\n497\t    (is (:halted expected) \"the reference run completes\")\n498\t    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n499\t        \"law 1: result and effect trace equal the reference\")\n500\t    got))\n501\t\n502\t\n503\t(defn matrix-cases\n504\t  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n505\t  []\n506\t  (conj (into [] (mapcat (fn [[n r build]]\n507\t                           (mapv (fn [[label wrap expected-of]]\n508\t                                   ;; nest's own parameter is x: under :depth-3,\n509\t                                   ;; row 21's (fn [] x) closes over the wrapper's\n510\t                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n511\t                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n512\t                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n513\t                                 segments)))\n514\t              rows)\n515\t        [20 :unwrapped \"B\" tail-effect-halt]))\n516\t\n517\t\n518\t(defn bare\n519\t  [n]\n520\t  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n521\t    (build identity)))\n522\t\n523\t\n524\t;; =============================================================================\n525\t;; Acceptance 1: 89 runs\n526\t;; =============================================================================\n527\t\n528\t(deftest ^:slow every-row-every-segment-matches-the-reference\n529\t  (slow/guard\n530\t    \"every-row-every-segment-matches-the-reference\"\n531\t    (fn []\n532\t      (let [cases (matrix-cases) runs (atom 0)]\n533\t        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n534\t        (doseq [[n label expected build] cases]\n535\t          (testing (str \"row \" n \" \" (name label))\n536\t            (let [ref (reference (build))]\n537\t              (when (some? expected)\n538\t                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n539\t              (laws (build) ref)\n540\t              (swap! runs inc))))\n541\t        (is (= 89 @runs))))))\n542\t\n543\t\n544\t(deftest bare-rows-match-the-reference\n545\t  ;; The quick-tier slice of acceptance 1: every row once, bare.\n546\t  (let [counted (atom [0 0])]\n547\t    (doseq [[n r build] rows]\n548\t      (testing (str \"row \" n)\n549\t        (let [ref (reference (build identity))\n550\t              {:keys [wire attaches]} (laws (build identity) ref)]\n551\t          (when (some? r) (is (= r (:value ref))))\n552\t          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n553\t    ;; outside laws, so deleting its count assertion leaves one standing\n554\t    (is (pos? (first @counted)) \"the corpus attaches streams\")\n555\t    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n556\t\n557\t\n558\t;; =============================================================================\n559\t;; Acceptance 2-6\n560\t;; =============================================================================\n561\t\n562\t(defn wait-state\n563\t  [wire]\n564\t  (first (:slots (first (slot (root-task wire) 13)))))\n565\t\n566\t\n567\t(deftest tail-states-carry-no-window\n568\t  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n569\t    (testing (str \"row \" label)\n570\t      (let [{:keys [serve!]} (served #{:reader :writer})\n571\t            wire (rows/lift-task (:machine world) serve! (lift-opts))\n572\t            state (wait-state wire)\n573\t            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n574\t        (is (= :tail (:kind state)))\n575\t        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n576\t        (is (= 5 (count row)) \"[id :tail A site k]\")\n577\t        (is (not-any? #(= :window (second %))\n578\t                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n579\t        (let [entry (first (:wait-set (:machine world)))]\n580\t          (is (= {:deliver :return} (:deliver entry)))\n581\t          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n582\t\n583\t\n584\t(deftest tail-states-lower-to-through-k-delivery\n585\t  (doseq [n [6 9 12]]\n586\t    (testing (str \"row \" n)\n587\t      (let [ref (reference (bare n))\n588\t            {:keys [recv] :as got} (laws (bare n) ref)\n589\t            entry (first (:wait-set recv))]\n590\t        (is (= {:deliver :return} (:deliver entry)))\n591\t        (is (contains? entry :site))\n592\t        (is (not-any? #(contains? entry %) [:window :env :pc]) \"the lowered tail carries no window\")\n593\t        (is (= (:value ref) (:value got))))))\n594\t  (let [ref (reference (tail-effect-halt))\n595\t        {:keys [recv] :as got} (laws (tail-effect-halt) ref)]\n596\t    (is (= [] (:k (first (:wait-set recv)))) \"row 20: an empty K\")\n597\t    (is (= \"B\" (:value got)) \"a tail effect with no frame to pop halts with the value\")))\n598\t\n599\t\n600\t(deftest install-rows-carry-the-child\n601\t  (doseq [[n phase] [[10 :parked] [11 :running] [12 :parked]]]\n602\t    (testing (str \"row \" n)\n603\t      (let [world (bare n)\n604\t            {:keys [serve! toy]} (served #{:reader})\n605\t            wire (rows/lift-task (:machine world) serve! (lift-opts))\n606\t            [install] (slot (root-task wire) 12)\n607\t            [mn carried-phase _ _ child] (:slots install)\n608\t            {:keys [attach!] n :count} (recording-attacher toy)\n609\t            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n610\t            inst (get-in recv [:installs 'host.mod])\n611\t            lowered (:vm inst)]\n612\t        (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity of the tree\")\n613\t        (is (= 'host.mod mn))\n614\t        (is (= phase carried-phase) \"the child's phase as the source held it\")\n615\t        (is (= :blocked (slot child 2)) \"the child's kind\")\n616\t        (is (= :child (slot child 3)))\n617\t        (is (= [:install 'host.mod] (:slots (first-pending (root-task wire)))))\n618\t        (is (= phase (:phase inst)))\n619\t        (is (nil? (:control lowered)) \"no initialization on lower: nothing runs\")\n620\t        (is (= [:next] (mapv :reason (:wait-set lowered))) \"the child waits where it was lifted\")\n621\t        (is (vm/blocked? lowered))\n622\t        (is (= (count (slot child 11)) (count (:code-aliases lowered))) \"the child's code by A\")))))\n623\t\n624\t\n625\t(deftest captures\n626\t  (doseq [n [14 15 16]]\n627\t    (testing (str \"row \" n)\n628\t      (let [ref (reference (bare n))]\n629\t        (laws (bare n) ref))))\n630\t  (let [world (bare 15)\n631\t        {:keys [recv] :as got} (laws world (reference (bare 15)))\n632\t        entry (first (:wait-set recv))\n633\t        k (get-in entry [:env 'k])\n634\t        p (values/payload k)]\n635\t    (is (values/continuation? k) \"the capture travels in the closure's E\")\n636\t    (is (not (contains? (:window p) (get-in p [:deliver :rd]))) \"nothing is delivered into the captured rd on lower\")\n637\t    (is (= :done (:value got)) \"the invocation after lower delivers once and re-enters\")))\n638\t\n639\t\n640\t(deftest free-env-shadowing\n641\t  (let [ref (reference (bare 21))\n642\t        got (laws (bare 21) ref)]\n643\t    (is (= 99 (:value got)) \"the lowered f resolves x through the carried free environment\"))\n644\t  (testing \"the explicit :free-env overrides the kernel's retained field\"\n645\t    (let [world (bare 21)\n646\t          m (assoc (:machine world) :free-env {'x 5})\n647\t          {:keys [serve! toy]} (served #{:reader})]\n648\t      (is (= :inconsistent-state (:yin.k/kind (error #(rows/lift-task m serve! (lift-opts)))))\n649\t          \"a free environment no E agrees with is refused\")\n650\t      (let [wire (rows/lift-task m serve! (assoc (lift-opts) :free-env {'x 99}))\n651\t            free (slot (root-task wire) 5)\n652\t            {:keys [attach!]} (recording-attacher toy)\n653\t            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)]\n654\t        (is (= ['x [:lit 99]] (:slots free)))\n655\t        (is (= {'x 99} (:free-env recv)))\n656\t        (is (= {'x 99} (:env recv))))))\n657\t  (testing \"neither the argument nor the kernel field: :missing-free-env\"\n658\t    (let [m (assoc (:machine (bare 21)) :free-env nil)\n659\t          d (error #(rows/lift-task m (:serve! (served #{:reader})) (lift-opts)))]\n660\t      (is (= [:yin.k/non-portable :missing-free-env] [(:yin.k/status d) (:yin.k/kind d)])))))\n661\t\n662\t\n663\t(deftest module-store-snapshot\n664\t  (let [{:keys [wire recv]} (laws (bare 18) (reference (bare 18)))\n665\t        task (root-task wire)\n666\t        {:strs [c d]} (into {} (map (fn [[k v]] [(name k) v])) (get-in recv [:module-stores 'host.mod]))]\n667\t    (is (= 1 (count (slot task 7))) \"one :module-store row\")\n668\t    (is (= 2 (quot (count (:slots (slot task 9))) 2)) \"two cursor cells\")\n669\t    (is (= :cursor-ref (:type c) (:type d)))\n670\t    (is (not= (:id c) (:id d)) \"the two cursor cells stay two\")\n671\t    (is (= :closure (normalize (get-in recv [:store 'mod]))))))\n672\t\n673\t\n674\t(deftest synthetic-tail-bookkeeping\n675\t  ;; Row 23: a hand-built parked tail; no primitive returns an FFI effect\n676\t  ;; through a tail :call today, so it is judged by frame/defect only.\n677\t  (let [m (:machine (bare 6))\n678\t        entry (first (:wait-set m))\n679\t        f (dissoc (ft/canonical m entry false) :yin.k/pending)\n680\t        code-map (ft/machine-code m)\n681\t        v (get code-map (:yin.k/segment f))\n682\t        non-tail (first (keep-indexed (fn [pc t] (when (and (= :call (first t)) (false? (nth t 4))) pc)) v))\n683\t        ctx {:free-env {} :ffi-call-ids #{:call-7} :parked-key :call-7}]\n684\t    (is (= :tail (:yin.k/state f)))\n685\t    (is (nil? (frame/defect f code-map :parked ctx)) \"a tail record under a live FFI call id\")\n686\t    (is (= :parked-site (:yin.k/kind (frame/defect f code-map :parked (assoc ctx :parked-key :call-8))))\n687\t        \"the same record under a key absent from :ffi-call-ids\")\n688\t    (is (some? non-tail))\n689\t    (is (= :site (:yin.k/kind (frame/defect (assoc f :yin.k/site non-tail) code-map :parked ctx)))\n690\t        \"T1 runs before P4\")))\n691\t\n692\t\n693\t;; =============================================================================\n694\t;; Acceptance 7: refusals, before any attachment\n695\t;; =============================================================================\n696\t\n697\t(defn update-at\n698\t  [x path f]\n699\t  (if (empty? path)\n700\t    (f x)\n701\t    (if (map? x)\n702\t      (update-in x [:slots (first path)] update-at (rest path) f)\n703\t      (update x (first path) update-at (rest path) f))))\n704\t\n705\t\n706\t(defn replace-nodes\n707\t  \"Every row node matching pred, anywhere under x, replaced by (f node).\"\n708\t  [x pred f]\n709\t  (cond\n710\t    (and (map? x) (contains? x :kind) (contains? x :slots))\n711\t    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n712\t    (vector? x) (mapv #(replace-nodes % pred f) x)\n713\t    :else x))\n714\t\n715\t\n716\t(defn replace-row\n717\t  \"The wire with row id's body replaced and every ancestor rehashed,\n718\t   without canonicalizing slots: a tamper below the abstract emitter.\"\n719\t  [wire id body]\n720\t  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n721\t        memo (atom {})]\n722\t    (letfn [(rewrite\n723\t              [x]\n724\t              (cond\n725\t                (contains? index x)\n726\t                (or (get @memo x)\n727\t                    (let [b (mapv rewrite (if (= x id) body (subvec (get index x) 1)))\n728\t                          nid (jing/segment-key b)]\n729\t                      (swap! memo assoc x nid)\n730\t                      nid))\n731\t                (vector? x) (mapv rewrite x)\n732\t                :else x))]\n733\t      (let [root (rewrite (:yin.k/root wire))\n734\t            rs (mapv (fn [[old nid]]\n735\t                       (into [nid] (mapv rewrite (if (= old id) body (subvec (get index old) 1)))))\n736\t                     @memo)]\n737\t        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n738\t\n739\t\n740\t(defn pairs-of\n741\t  [n]\n742\t  (mapv vec (partition 2 (:slots n))))\n743\t\n744\t\n745\t(defn rebuild\n746\t  [n f]\n747\t  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n748\t\n749\t\n750\t(defn lowered\n751\t  \"Lower wire into a fresh receiver: [outcome attaches].\"\n752\t  [toy wire]\n753\t  (let [{:keys [attach!] n :count} (recording-attacher toy)\n754\t        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n755\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n756\t    [r @n]))\n757\t\n758\t\n759\t(defn free-register\n760\t  \"A register of the act's body that is neither in its window nor its rd.\"\n761\t  [task act]\n762\t  (let [[a pc _ w _ rd] (:slots act)\n763\t        v (get (slot task 11) a)\n764\t        bodies (code/parse v)\n765\t        k (:registers (nth bodies (code/body-index bodies pc)))\n766\t        taken (into #{rd} (map first) (pairs-of w))]\n767\t    (first (remove taken (range k)))))\n768\t\n769\t\n770\t(def wait-act [13 0 0])\n771\t\n772\t\n773\t(defn tamper-cases\n774\t  []\n775\t  (let [act-of (fn [task] (get-in task [:slots 13 0 :slots 0]))]\n776\t    [[\"window with an extra live key\" 1 :window-extra\n777\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (conj ps [(free-register task (act-of task)) [:lit :x]])))))]\n778\t     [\"a live key removed\" 1 :window-missing\n779\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (rest ps))))))]\n780\t     [\"rd added\" 1 :window-self\n781\t      (fn [task]\n782\t        (update-at task (conj wait-act 3)\n783\t                   #(rebuild % (fn [ps] (conj ps [(nth (:slots (act-of task)) 5) [:lit :x]])))))]\n784\t     [\"rd replaced by another register\" 1 :destination\n785\t      (fn [task] (update-at task (conj wait-act 5) inc))]\n786\t     [\"a reason the site does not admit\" 1 :reason-mismatch\n787\t      (fn [task] (update-at task [13 0 1] (constantly (rows/node :pending [:install 'bogus]))))]\n788\t     [\"the [:lit nil] of row 22 dropped\" 22 :window-missing\n789\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (remove (fn [[_ v]] (= [:lit nil] v)) ps))))))]\n790\t     [\"a :reified act whose pc-1 is not a capture\" 14 :captured-site\n791\t      (fn [task]\n792\t        (let [act (act-of task)]\n793\t          (replace-nodes task #(= :reified (:kind %)) (constantly (rows/node :reified [act])))))]\n794\t     [\"a parked act whose pc-1 is not :park\" 1 :parked-site\n795\t      (fn [task] (update-at task [8] (constantly (rows/node :parked-table [:bogus (act-of task)]))))]\n796\t     [\"the root free-env row given a reserved key\" 1 :reserved-name\n797\t      (fn [task] (update-at task [5] #(rebuild % (fn [ps] (conj ps ['yin/def [:lit 1]])))))]]))\n798\t\n799\t\n800\t(defn return-site-case\n801\t  \"A return frame's pc moved after a tail call (K1); falls back to a pc\n802\t   after any non-call when no tail call has a successor in its body.\"\n803\t  [task]\n804\t  (let [kpath [13 0 0 2 0]\n805\t        kf (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0])\n806\t        [a] (:slots kf)\n807\t        v (get (slot task 11) a)\n808\t        bodies (code/parse v)\n809\t        same-body? (fn [p] (= (code/body-index bodies (dec p)) (code/body-index bodies p)))\n810\t        tail-call? (fn [t] (and (= :call (first t)) (true? (nth t 4))))\n811\t        after-tail (first (filter #(and (tail-call? (nth v (dec %))) (same-body? %)) (range 1 (count v))))\n812\t        after-other (first (filter #(and (not= :call (first (nth v (dec %)))) (same-body? %)) (range 1 (count v))))]\n813\t    [(if after-tail :after-tail-call :after-non-call)\n814\t     (update-at task (conj kpath 1) (constantly (or after-tail after-other)))]))\n815\t\n816\t\n817\t(defn lift-bare\n818\t  [n]\n819\t  (let [world (bare n)\n820\t        {:keys [serve! toy]} (served #{:reader :writer})]\n821\t    [toy (rows/lift-task (:machine world) serve! (lift-opts))]))\n822\t\n823\t\n824\t(deftest refusals\n825\t  (doseq [[label n kind tamper] (tamper-cases)]\n826\t    (testing label\n827\t      (let [[toy wire] (lift-bare n)\n828\t            [r attaches] (lowered toy (rows/emit-numbered (tamper (root-task wire)) {}))]\n829\t        (is (= [:yin.k/undecodable kind] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n830\t        (is (zero? attaches) \"refused before any attachment\"))))\n831\t  (testing \"a segment with no tree association (§6.1): unsatisfied, before any attachment\"\n832\t    (let [[toy wire] (lift-bare 1)\n833\t          task (update-at (root-task wire) [10] #(assoc % :yin.k/trees {}))\n834\t          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n835\t      (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n836\t      (is (= :incomplete (:yin.k/discovery r)))\n837\t      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))\n838\t      (is (zero? attaches)))\n839\t    (let [world (bare 1)\n840\t          d (error #(rows/lift-task (:machine world) (:serve! (served #{:reader})) {:source-index {}}))]\n841\t      (is (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)]) \"the lift refuses it too\")))\n842\t  (testing \"a return frame's pc moved after a tail call\"\n843\t    (let [[toy wire] (lift-bare 6)\n844\t          [how task] (return-site-case (root-task wire))\n845\t          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n846\t      (is (= :after-tail-call how))\n847\t      (is (= [:yin.k/undecodable :return-site] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n848\t      (is (zero? attaches))))\n849\t  (testing \"a :tail row given a fourth slot is refused at structure, before frames\"\n850\t    (let [[toy wire] (lift-bare 6)\n851\t          [id & body] (first (filter #(= :tail (second %)) (:yin.k/rows wire)))\n852\t          [r attaches] (lowered toy (replace-row wire id (conj (vec body) 0)))]\n853\t      (is (= :yin.k/undecodable (:yin.k/status r)))\n854\t      (is (= :row-shape (:yin.k/kind r)) \"the codec's structure step (2) runs before the frames step (7)\")\n855\t      (is (zero? attaches))))\n856\t  (testing \"E2 over row 21 with the free environment {x 99 y 7}\"\n857\t    (let [world (free-env-world identity {'x 99 'y 7})\n858\t          {:keys [serve! toy]} (served #{:reader})\n859\t          wire (rows/lift-task (:machine world) serve! (lift-opts))\n860\t          task (root-task wire)\n861\t          env-path (conj wait-act 2 0)\n862\t          edit (fn [f] (rows/emit-numbered (update-at task env-path #(rebuild % (fn [ps] (f (into {} ps))))) {}))]\n863\t      (is (= [:lit 1] (second (first (filter #(= 'x (first %)) (pairs-of (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0]))))))\n864\t          \"the lexical x is 1 at the read\")\n865\t      (doseq [[label f] [[\"the unshadowed y changed\" #(assoc % 'y [:lit 8])]\n866\t                         [\"the lexical x removed\" #(dissoc % 'x)]]]\n867\t        (testing label\n868\t          (let [[r attaches] (lowered toy (edit f))]\n869\t            (is (= [:yin.k/undecodable :free-env-mismatch] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n870\t            (is (zero? attaches)))))\n871\t      (testing \"the lexical x changed trips nothing\"\n872\t        (let [[r] (lowered toy (edit #(assoc % 'x [:lit 98])))]\n873\t          (is (vm/blocked? r) (pr-str r))))))\n874\t  (testing \"lift refusals, before any stream is served\"\n875\t    (let [counting (fn []\n876\t                     (let [n (atom 0) {:keys [serve!]} (served #{:reader})]\n877\t                       [(fn [h] (swap! n inc) (serve! h)) n]))\n878\t          stepped (vm/step (load-program (machine) (s/lit 42)))\n879\t          m0 (load-program (machine) (s/app (s/v 'stream/poll!) (s/v 'c)))\n880\t          [sref m1] (engine/attach-resource m0 (s/ring 8))\n881\t          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n882\t          held (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))]\n883\t      (is (= [:observe] (mapv :reason (:wait-set held))))\n884\t      (doseq [[label m status kind] [[\"not at a safepoint\" stepped :yin.k/not-at-safepoint nil]\n885\t                                     [\"a held :observe\" held :yin.k/non-portable :reason-mismatch]]]\n886\t        (testing label\n887\t          (let [[serve! n] (counting)\n888\t                d (error #(rows/lift-task m serve! (lift-opts)))]\n889\t            (is (= status (:yin.k/status d)) (pr-str d))\n890\t            (is (= kind (:yin.k/kind d)))\n891\t            (is (zero? @n))))))))\n892\t\n893\t\n894\t(deftest first-defect-order\n895\t  (let [[toy wire] (lift-bare 18)\n896\t        task (root-task wire)\n897\t        state-path [8 1]\n898\t        state (get-in task [:slots 8 :slots 1])\n899\t        ;; the park's window: rd added\n900\t        tampered (update-at task (conj state-path 3)\n901\t                            #(rebuild % (fn [ps] (conj ps [(nth (:slots state) 5) [:lit :x]]))))\n902\t        census (mapv first (pairs-of (slot task 9)))\n903\t        swapped (zipmap census (reverse census))]\n904\t    (is (= 2 (count census)))\n905\t    (is (= :window-self (:yin.k/kind (first (lowered toy (rows/emit-numbered tampered {}))))))\n906\t    (let [[r attaches] (lowered toy (rows/emit-numbered tampered swapped))]\n907\t      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n908\t      (is (zero? attaches)))))\n909\t\n910\t\n911\t;; =============================================================================\n912\t;; Acceptance 8: the two ported tests\n913\t;; =============================================================================\n914\t\n915\t(defn parked-reader\n916\t  []\n917\t  (let [m0 (vm/run (load-program (machine) (with-stream (s/then read-op read-op))))\n918\t        src (s/stream-of m0)]\n919\t    (stream/append! src \"A\")\n920\t    [(vm/run m0) src]))\n921\t\n922\t\n923\t(deftest a-nonempty-ready-queue-is-not-quiescent\n924\t  (let [[parked src] (parked-reader)\n925\t        _ (stream/append! src \"B\")\n926\t        woken (engine/check-wait-set parked)\n927\t        n (atom 0)\n928\t        {:keys [serve!]} (served #{:reader})\n929\t        d (error #(rows/lift-task woken (fn [h] (swap! n inc) (serve! h)) (lift-opts)))]\n930\t    (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n931\t    (is (= :yin.k/not-quiescent (:yin.k/status d)) (pr-str d))\n932\t    (is (zero? @n) \"no stream was served\")))\n933\t\n934\t\n935\t(defn two-callers\n936\t  []\n937\t  (let [call-in (s/ring 8) call-out (s/ring 8)\n938\t        m (vm/run (load-program (machine {:call-in call-in :call-out call-out\n939\t                                          :call-out-cursor (vm/mint-oldest call-out :test)})\n940\t                                (s/then (s/call-node :op/echo \"hello\") (s/call-node :op/echo \"world\"))))\n941\t        e1 (first (:wait-set m))]\n942\t    [(assoc m :wait-set [e1 (assoc e1 :call-id :parked-9)]) call-out (:call-id e1)]))\n943\t\n944\t\n945\t(defn answer-both!\n946\t  [call-out first-id]\n947\t  (stream/append! call-out (apply2/success-response :parked-9 \"second\"))\n948\t  (stream/append! call-out (apply2/success-response first-id \"first\")))\n949\t\n950\t\n951\t(defn sweep\n952\t  [m peers]\n953\t  (loop [m (engine/check-wait-set m) n 12]\n954\t    (if (or (zero? n) (empty? (:wait-set m)))\n955\t      m\n956\t      (do (run! s/serve-mirror! peers) (recur (engine/check-wait-set m) (dec n))))))\n957\t\n958\t\n959\t(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n960\t  (let [[ref-m ref-out id] (two-callers)\n961\t        _ (answer-both! ref-out id)\n962\t        expected (mapv :value (:ready-queue (sweep ref-m [])))\n963\t        [m call-out id] (two-callers)\n964\t        {:keys [serve! toy peer]} (served #{:reader})\n965\t        wire (rows/lift-task m serve! (lift-opts))\n966\t        task (root-task wire)\n967\t        pendings (mapv #(second (:slots %)) (slot task 13))\n968\t        own-out (s/ring 8)\n969\t        {:keys [attach!] n :count} (recording-attacher toy)\n970\t        recv (rows/lower-task (machine {:attach-stream attach! :call-in (s/ring 8) :call-out own-out\n971\t                                        :call-out-cursor (vm/mint-oldest own-out :test)})\n972\t                              wire attach!)\n973\t        [w1 w2] (:wait-set recv)\n974\t        _ (answer-both! call-out id)\n975\t        swept (sweep recv [peer])]\n976\t    (is (= [:ffi :ffi] (mapv #(first (:slots %)) pendings)))\n977\t    (is (= [id :parked-9] (mapv #(nth (:slots %) 2) pendings)))\n978\t    (is (= 1 (quot (count (:slots (slot task 9))) 2)) \"the two waiters name one cursor cell\")\n979\t    (is (= (nth (:slots (first pendings)) 1) (nth (:slots (second pendings)) 1)))\n980\t    (is (= (:cursor-ref w1) (:cursor-ref w2)) \"the lower gives both waiters one fresh cursor entry\")\n981\t    (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity\")\n982\t    (is (= [(apply2/success-response :parked-9 \"second\") (apply2/success-response id \"first\")] expected))\n983\t    (is (empty? (:wait-set swept)))\n984\t    (is (= expected (mapv :value (:ready-queue swept)))\n985\t        \"the receiver wakes the same waiters with the same responses\")))\n986\t\n987\t\n988\t(deftest act-ffi-bookkeeping\n989\t  ;; Row 24: row 3's bookkeeping record travels in the parked table under\n990\t  ;; its call id, and the validator accepts it in context :parked.\n991\t  (let [world (bare 24)\n992\t        {:keys [serve!]} (served #{:reader})\n993\t        task (root-task (rows/lift-task (:machine world) serve! (lift-opts)))\n994\t        [p state] (:slots (slot task 8))]\n995\t    (is (= (:call-id world) p))\n996\t    (is (= :act (:kind state)))\n997\t    (is (= [:ffi (:call-id world)] [(first (:slots (first-pending task))) (nth (:slots (first-pending task)) 2)]))\n998\t    (is (nil? (rows/validate-frames task)))))\n999\t\n1000\t\n1001\t(deftest a-stream-shared-across-the-tree-attaches-once\n1002\t  ;; Row 10 with the link-request stream named from the root's store and\n1003\t  ;; from the install child's: one identity, reached by two tasks.\n1004\t  (let [m (:machine (bare 10))\n1005\t        child (get-in m [:installs 'host.mod :vm])\n1006\t        ref-in (fn [x] (engine/issue-ref x :stream-ref module/link-request-resource))\n1007\t        m (-> m\n1008\t              (update :store assoc 'rq (ref-in m))\n1009\t              (assoc-in [:installs 'host.mod :vm] (update child :store assoc 'rq (ref-in child))))\n1010\t        {:keys [serve! toy]} (served #{:reader :writer})\n1011\t        wire (rows/lift-task m serve! (lift-opts))\n1012\t        task (root-task wire)\n1013\t        {:keys [attach!] n :count} (recording-attacher toy)\n1014\t        recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n1015\t        lowered-child (get-in recv [:installs 'host.mod :vm])\n1016\t        handle (fn [x] (get (:resources x) (:id (get-in x [:store 'rq]))))]\n1017\t    (is (< (count (stream-identities wire)) (stream-occurrences task)) \"the tree reaches one identity twice\")\n1018\t    (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity\")\n1019\t    (is (some? (handle recv)))\n1020\t    (is (identical? (handle recv) (handle lowered-child)) \"both tasks hold the one attached stream\")))\n1021\t\n1022\t\n1023\t;; =============================================================================\n1024\t;; Carrier defects the restore would meet: refused before any attachment\n1025\t;; =============================================================================\n1026\t\n1027\t(defn refused-before-attach\n1028\t  \"Lower row n's carrier after (edit task): [status kind data]; asserts\n1029\t   no stream was attached.\"\n1030\t  [n edit]\n1031\t  (let [[toy wire] (lift-bare n)\n1032\t        [r attaches] (lowered toy (rows/emit-numbered (edit (root-task wire)) {}))]\n1033\t    (is (zero? attaches) (str \"refused before any attachment: \"\n1034\t                              (pr-str (select-keys r [:yin.k/status :yin.k/kind :rule :reason :defect]))))\n1035\t    [(:yin.k/status r) (:yin.k/kind r) r]))\n1036\t\n1037\t\n1038\t(def install-path [12 0])\n1039\t\n1040\t\n1041\t(defn with-store-key\n1042\t  [k]\n1043\t  (fn [s] (rebuild s (fn [ps] (conj ps [k [:lit 42]])))))\n1044\t\n1045\t\n1046\t(defn closures\n1047\t  [f]\n1048\t  (fn [task] (replace-nodes task #(= :closure (:kind %)) f)))\n1049\t\n1050\t\n1051\t(deftest carrier-defects-refuse-before-attachment\n1052\t  (testing \"a reserved root store key\"\n1053\t    (let [[status kind r] (refused-before-attach 1 #(update-at % [6] (with-store-key 'yin/def)))]\n1054\t      (is (= [:yin.k/undecodable :reserved-name :store-key] [status kind (:yin.k/role r)]))))\n1055\t  (testing \"a reserved module store key\"\n1056\t    (let [[status kind r] (refused-before-attach 18 #(update-at % [7 0 1] (with-store-key 'yin/def)))]\n1057\t      (is (= [:yin.k/undecodable :reserved-name :store-key] [status kind (:yin.k/role r)]))))\n1058\t  (testing \"a closure whose entry names no closure of its code\"\n1059\t    (is (= [:yin.k/undecodable :closure-origin]\n1060\t           (take 2 (refused-before-attach 1 (closures #(assoc-in % [:slots 1] 999999999)))))))\n1061\t  (testing \"a closure whose binders are not its tuple's\"\n1062\t    (is (= [:yin.k/undecodable :closure-binders]\n1063\t           (take 2 (refused-before-attach 1 (closures #(update-in % [:slots 2] (fn [ps] (conj (vec (butlast ps)) 'zz)))))))))\n1064\t  (testing \"an install whose retained response is {}\"\n1065\t    (is (= [:yin.k/undecodable :install-response]\n1066\t           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 3) (constantly {})))))))\n1067\t  (testing \"an install whose response image does not load\"\n1068\t    (is (= [:yin.k/undecodable :install-response]\n1069\t           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 3) (fn [r] (assoc-in r [:image :value] []))))))))\n1070\t  (testing \"an install whose manifest names another module\"\n1071\t    (is (= [:yin.k/undecodable :install-response]\n1072\t           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 3)\n1073\t                                                         (fn [r] (assoc-in r [:manifest :yin.module/name] 'other.mod))))))))\n1074\t  (testing \"an install in a phase the engine never carries\"\n1075\t    (is (= [:yin.k/undecodable :install-phase]\n1076\t           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 1) (constantly :bogus)))))))\n1077\t  (testing \"an install whose child is not blocked\"\n1078\t    (is (= [:yin.k/undecodable :install-child]\n1079\t           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 4 2) (constantly :halted))))))))\n1080\t\n1081\t\n1082\t(defn exclusive\n1083\t  [task]\n1084\t  (update-at task [16] (constantly {:custody :exclusive})))\n1085\t\n1086\t\n1087\t(defn without-trees\n1088\t  [path]\n1089\t  (fn [task] (update-at task path #(assoc % :yin.k/trees {}))))\n1090\t\n1091\t\n1092\t(deftest carrier-steps-run-in-order-over-the-tree\n1093\t  (testing \"custody (10) alone\"\n1094\t    (is (= [:yin.k/unsupported :custody] (take 2 (refused-before-attach 1 exclusive)))))\n1095\t  (testing \"the dependency closure (9) before custody (10)\"\n1096\t    (let [[status _ r] (refused-before-attach 1 (comp exclusive (without-trees [10])))]\n1097\t      (is (= :yin.k/unsatisfied status) (pr-str r))\n1098\t      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))))\n1099\t  (testing \"the child's dependency closure before the root's custody\"\n1100\t    (let [[status _ r] (refused-before-attach 10 (comp exclusive (without-trees (conj install-path 4 10))))]\n1101\t      (is (= :yin.k/unsatisfied status) (pr-str r))\n1102\t      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))))\n1103\t  (testing \"an install record (8) before the root's dependency closure (9)\"\n1104\t    (is (= [:yin.k/undecodable :install-phase]\n1105\t           (take 2 (refused-before-attach 10 (comp #(update-at % (conj install-path 1) (constantly :bogus))\n1106\t                                                   (without-trees [10]))))))))\n1107\t\n1108\t\n1109\t;; =============================================================================\n1110\t;; The dependency closure: each free occurrence in its own context (§7.1)\n1111\t;; =============================================================================\n1112\t\n1113\t(defn halted-on\n1114\t  [ast]\n1115\t  (vm/run (load-program (machine) ast)))\n1116\t\n1117\t\n1118\t(def ghost-fn (s/lam [] (s/v 'ghost)))\n1119\t\n1120\t\n1121\t(defn lift-outcome\n1122\t  \"Lift m: [the wire or the refusal's ex-data, serves].\"\n1123\t  [m]\n1124\t  (let [n (atom 0)\n1125\t        {:keys [serve!]} (served #{:reader})\n1126\t        r (try (rows/lift-task m (fn [h] (swap! n inc) (serve! h)) (lift-opts))\n1127\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n1128\t    [r @n]))\n1129\t\n1130\t\n1131\t(defn missing-obligations\n1132\t  [m]\n1133\t  (let [[d] (lift-outcome m)]\n1134\t    (when (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)])\n1135\t      (get-in d [:yin.k/missing :obligations]))))\n1136\t\n1137\t\n1138\t(defn routed\n1139\t  \"closure c, its E naming module store mid.\"\n1140\t  [m c mid]\n1141\t  (values/closure (:owner m) (assoc-in (values/payload c) [:env engine/store-of-key] mid)))\n1142\t\n1143\t\n1144\t(deftest free-occurrences-are-answered-in-their-own-context\n1145\t  (let [m (halted-on ghost-fn)\n1146\t        g (vm/value m)]\n1147\t    (testing \"a carried closure whose only free obligation is missing\"\n1148\t      (is (= #{'ghost} (missing-obligations m))))\n1149\t    (testing \"a module store the closure does not route to answers nothing\"\n1150\t      (is (= #{'ghost} (missing-obligations (assoc m :module-stores {'unrelated {'ghost 42}})))))\n1151\t    (testing \"a routed closure reads its module store, never the root store\"\n1152\t      (is (= #{'ghost} (missing-obligations (assoc m :value (routed m g 'scoped) :store {'ghost 1}\n1153\t                                                   :module-stores {'scoped {}})))))\n1154\t    (testing \"the root store answers a top-level closure\"\n1155\t      (is (nil? (missing-obligations (assoc m :store {'ghost 1})))))\n1156\t    (testing \"reachable only through the store\"\n1157\t      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'k g})))))\n1158\t    (testing \"another closure's E answers nothing\"\n1159\t      (let [bound (values/closure (:owner m) (assoc-in (values/payload g) [:env 'ghost] 1))]\n1160\t        (is (nil? (missing-obligations (assoc m :value bound))) \"its own E answers\")\n1161\t        (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'a bound 'k g}))))))\n1162\t    (testing \"reachable only through a module store a routed closure reaches\"\n1163\t      ;; the holder runs in outer, where ghost is 2; k, found in outer,\n1164\t      ;; runs at top level, where nothing answers ghost\n1165\t      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'mod (routed m g 'outer)}\n1166\t                                                   :module-stores {'outer {'ghost 2 'k g}}))))))\n1167\t  (testing \"reachable only through another closure's E\"\n1168\t    (is (= #{'ghost} (missing-obligations (halted-on (s/let1 'h ghost-fn (s/lam [] (s/app (s/v 'h)))))))))\n1169\t  (testing \"a routed module store answers, travels alone, and the lowered closure reads it\"\n1170\t    (let [m0 (halted-on ghost-fn)\n1171\t          m (assoc m0 :value (routed m0 (vm/value m0) 'scoped) :module-stores {'scoped {'ghost 42} 'unrelated {'other 1}})\n1172\t          [wire serves] (lift-outcome m)\n1173\t          {:keys [toy]} (served #{:reader})\n1174\t          [recv attaches] (lowered toy wire)]\n1175\t      (is (contains? wire :yin.k/rows) (pr-str wire))\n1176\t      (is (zero? serves))\n1177\t      (is (zero? attaches))\n1178\t      (is (= ['scoped] (mapv #(first (:slots %)) (slot (root-task wire) 7))) \"only the routed module store travels\")\n1179\t      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f)))))))))\n1180\t\n1181\t\n1182\t(def fresh-read (s/next-of (s/cursor-of {:type :stream/make :buffer 4})))\n1183\t\n1184\t\n1185\t(defn fed-73\n1186\t  \"Lift m, lower it into a fresh receiver, then feed the source's stream\n1187\t   73 and run both.\"\n1188\t  [m]\n1189\t  (let [{:keys [serve! toy peer]} (served #{:reader})\n1190\t        wire (rows/lift-task m serve! (lift-opts))\n1191\t        [recv attaches] (lowered toy wire)]\n1192\t    (stream/append! (s/stream-of m) 73)\n1193\t    {:source (vm/value (vm/run m)) :receiver (vm/value (drive-peers recv [peer])) :attaches attaches}))\n1194\t\n1195\t\n1196\t(deftest discharge-follows-control-flow-from-the-resume-pc\n1197\t  (let [past (fn [consequent]\n1198\t               (halted-on {:type :if :test (s/lit false) :consequent consequent :alternate fresh-read}))]\n1199\t    (testing \"a free read behind the resume pc is no obligation\"\n1200\t      (doseq [m [(past (s/v 'ghost))\n1201\t                 (assoc (past (s/v 'ghost)) :module-stores {'unrelated {'ghost 42}})\n1202\t                 (past ghost-fn)]]\n1203\t        (is (= {:source 73 :receiver 73 :attaches 1} (fed-73 m))))))\n1204\t  (testing \"a free read after the resume pc is an obligation\"\n1205\t    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read (s/v 'ghost)))))))\n1206\t  (testing \"a closure reachable code can still construct is an obligation\"\n1207\t    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read ghost-fn))))))\n1208\t  (testing \"a backward jump makes earlier code live\"\n1209\t    ;; §3.1 admits no backward jump, so no carried vector has one; live-pcs\n1210\t    ;; follows the stated edges, never pc order\n1211\t    (let [v [[:const 1 false] [:branch-false 1 4] [:var 0 'ghost] [:jump 6] [:const 0 1] [:jump 2] [:halt 0]]]\n1212\t      (is (contains? (rows/live-pcs v 4) 2))\n1213\t      (is (not (contains? (rows/live-pcs v 3) 2))))))\n1214\t\n1215\t\n1216\t;; =============================================================================\n1217\t;; Every store-of names a module store of its own task (§2.6)\n1218\t;; =============================================================================\n1219\t\n1220\t(defn routed-beside-stream\n1221\t  \"ast's closure routed to module store scoped, with an authentic stream\n1222\t   in the root store so that an attachment is observable.\"\n1223\t  [ast stores]\n1224\t  (let [m0 (halted-on ast)\n1225\t        [ref m] (engine/attach-resource m0 (s/ring 4))]\n1226\t    (assoc m :value (routed m (vm/value m) 'scoped) :module-stores stores :store {'stream ref})))\n1227\t\n1228\t\n1229\t(defn without-module-stores\n1230\t  [path]\n1231\t  (fn [task] (update-at task path (constantly []))))\n1232\t\n1233\t\n1234\t(defn module-store-ids\n1235\t  [task]\n1236\t  (mapv #(first (:slots %)) (slot task 7)))\n1237\t\n1238\t\n1239\t(deftest every-store-of-names-a-module-store-of-its-own-task\n1240\t  (doseq [[label ast stores value] [[\"a scoped store\" ghost-fn {'scoped {'ghost 42}} 42]\n1241\t                                    [\"a present empty store\" (s/lam [] (s/lit 7)) {'scoped {}} 7]]]\n1242\t    (testing label\n1243\t      (let [{:keys [serve! toy]} (served #{:reader})\n1244\t            wire (rows/lift-task (routed-beside-stream ast stores) serve! (lift-opts))\n1245\t            [recv attaches] (lowered toy wire)\n1246\t            [r none] (lowered toy (rows/emit ((without-module-stores [7]) (root-task wire))))]\n1247\t        (is (= ['scoped] (module-store-ids (root-task wire))))\n1248\t        (is (= 1 attaches))\n1249\t        (is (= value (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f))))))\n1250\t        (testing \", its rows removed\"\n1251\t          (is (zero? none) \"refused before any attachment\")\n1252\t          (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))))\n1253\t  (testing \"a closure inside a module store's value naming another module store\"\n1254\t    ;; k lives only in outer's value and is routed to inner; stripping inner\n1255\t    ;; alone must refuse, else k attaches and fails reading ghost\n1256\t    (let [m0 (halted-on ghost-fn)\n1257\t          g (vm/value m0)\n1258\t          [ref m] (engine/attach-resource m0 (s/ring 4))\n1259\t          m (assoc m :value (routed m g 'outer) :store {'stream ref}\n1260\t                   :module-stores {'outer {'ghost 1 'k (routed m g 'inner)} 'inner {'ghost 42}})\n1261\t          {:keys [serve! toy]} (served #{:reader})\n1262\t          wire (rows/lift-task m serve! (lift-opts))\n1263\t          strip (fn [task] (update-at task [7] (fn [ns] (vec (remove #(= 'inner (first (:slots %))) ns)))))\n1264\t          [recv attaches] (lowered toy wire)\n1265\t          [r none] (lowered toy (rows/emit (strip (root-task wire))))]\n1266\t      (is (= #{'outer 'inner} (set (module-store-ids (root-task wire)))))\n1267\t      (is (= 1 attaches))\n1268\t      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (get-in recv [:module-stores 'outer 'k])}) (s/app (s/v 'f))))))\n1269\t      (is (zero? none) \"refused before any attachment\")\n1270\t      (is (= [:yin.k/unsatisfied #{'inner}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))\n1271\t  (testing \"a frame's E naming a store its task does not carry\"\n1272\t    (let [[status _ r] (refused-before-attach 17 (without-module-stores [7]))]\n1273\t      (is (= :yin.k/unsatisfied status))\n1274\t      (is (= 1 (count (get-in r [:yin.k/missing :yin.k/stores]))))))\n1275\t  (testing \"a child does not read its parent's store of the same key\"\n1276\t    (let [scope (fn [x]\n1277\t                  (-> x\n1278\t                      (update-in [:wait-set 0 :env] assoc engine/store-of-key 'scoped)\n1279\t                      (assoc :module-stores {'scoped {}})))\n1280\t          m (:machine (bare 10))\n1281\t          m (-> (scope m) (update-in [:installs 'host.mod :vm] scope))\n1282\t          {:keys [serve! toy]} (served #{:reader :writer})\n1283\t          wire (rows/lift-task m serve! (lift-opts))\n1284\t          child-path (conj install-path 4)\n1285\t          [ok n] (lowered toy wire)\n1286\t          [r none] (lowered toy (rows/emit ((without-module-stores (conj child-path 7)) (root-task wire))))]\n1287\t      (is (= ['scoped] (module-store-ids (root-task wire))) \"the parent carries scoped\")\n1288\t      (is (= ['scoped] (module-store-ids (slot (first (slot (root-task wire) 12)) 4))) \"and so does the child\")\n1289\t      (is (vm/blocked? ok) (pr-str (when (map? ok) (select-keys ok [:yin.k/status :yin.k/kind]))))\n1290\t      (is (= (count (stream-identities wire)) n))\n1291\t      (is (zero? none) \"refused before any attachment\")\n1292\t      (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n1293\t"}]},"parent_tool_use_id":null,"session_id":"b921a1a6-65e4-4bc4-853c-fc87c8b912fe","uuid":"f8256c1e-1e50-4da9-8611-96ddb24fe026","timestamp":"2026-10-12T17:42:16.887Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"(ns yin.vm.semantic-register.safepoint-harness-test\n  \"Phase 6b: the safepoint harness on the :semantic-register lane\n   (docs/design/yin.vm.semantic-register-vm.continuation.md §5, §8.2).\n\n   Each row of the §5.2 matrix is built twice under each of the four\n   segment wrappers: the reference build is satisfied and run on its own\n   machine; the handoff build is lifted with rows/lift-task, lowered with\n   rows/lower-task into a fresh receiver over the toy channel, relifted at\n   once, then satisfied through the source's streams. Result and effect\n   trace equal the reference (law 1); the relift equals the lift by root\n   id under rows/canonical-under (law 2); the pending's reason is the\n   observed wait's (law 3); every lifted frame passes the validator\n   (law 6). Row 20 runs once, outside the wrappers.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.apply :as apply2]\n            [dao.test-slow :as slow]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.semantic-register :as sr]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.frame-test :as ft]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.ucf.lift-support :as support]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n;; =============================================================================\n;; The composition: code by A, the source index, one machine builder\n;; =============================================================================\n\n(def source-index\n  \"The composition's {A #{tree-address}} (§6.1): every vector this\n   harness projects is recorded beside the address of its AST.\"\n  (atom {}))\n\n\n(defn project\n  [ast]\n  (let [v (:vector (linearize/project ast))]\n    (swap! source-index update (jing/segment-key v) (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n    v))\n\n\n(def stream-modules (module/register-stream-module (module/default-registry)))\n\n\n(defn machine\n  ([] (machine {}))\n  ([opts]\n   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n                         :modules stream-modules}\n                        opts))))\n\n\n(defn load-program\n  [m ast]\n  (sr/load-vector m (project ast) code/contract))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n;; =============================================================================\n;; The corpus: four segments around one parking expression\n;; =============================================================================\n\n(defn cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn nest\n  [d op]\n  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n\n\n(def segments\n  \"[label wrap expected-of-bare-result] (§5.2).\"\n  [[:bare identity identity]\n   [:operand #(cat-of (s/lit [:operand]) %) (fn [r] [:operand r])]\n   [:depth-3 #(nest 3 %) (fn [r] [3 [2 [1 r]]])]\n   [:captured #(s/let1 'k (s/lit :captured)\n                       (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n                               (s/app (s/v 'f) (s/lit :arg))))\n    (fn [r] [:captured :arg r])]])\n\n\n(defn with-stream\n  [body]\n  (s/let1 's {:type :stream/make :buffer 4} (s/let1 'c (s/cursor-of (s/v 's)) body)))\n\n\n(defn tail\n  [ast]\n  (assoc ast :tail? true))\n\n\n(defn normalize\n  [x]\n  (cond\n    (values/continuation? x) :continuation\n    (values/closure? x) :closure\n    (vector? x) (mapv normalize x)\n    (seq? x) (apply list (map normalize x))\n    (set? x) (into #{} (map normalize) x)\n    (map? x) (into {} (map (fn [[k v]] [(normalize k) (normalize v)])) x)\n    :else x))\n\n\n;; =============================================================================\n;; The rows of §5.2: one builder each, answering the parked machine\n;; =============================================================================\n;;\n;; A world: :machine, :kind, :reason (blocked rows), :steps (each followed by\n;; a drive) or :resume, :finish (records the effect trace), :trace, and\n;; :receiver (fresh opts and a finish for the receiver's own composition).\n\n(defn reader\n  \"A reader parked on (next-of c); :pre values are appended and the\n   machine re-run first.\"\n  ([wrap op] (reader wrap op [] \"B\" {}))\n  ([wrap op pre value opts]\n   (let [m0 (vm/run (load-program (machine opts) (with-stream (with-cat (wrap op)))))\n         src (s/stream-of m0)\n         m (reduce (fn [m x] (stream/append! src x) (vm/run m)) m0 pre)]\n     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src value)] :trace (atom [])})))\n\n\n(defn writer\n  [wrap]\n  (let [trace (atom [])\n        w (support/one-slot-stream \"w\")\n        _ (stream/append! w :warmed)\n        m0 (load-program (machine) (with-cat (wrap {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")})))\n        [ref m1] (engine/attach-resource m0 w)\n        take! #(swap! trace conj (:dao.stream/value (stream/next w 0)))]\n    {:machine (vm/run (assoc m1 :store {'w ref})) :kind :blocked :reason :put :surfaces #{:reader :writer}\n     :steps [take!] :finish take! :trace trace}))\n\n\n(defn own-call-pair\n  [trace]\n  (let [own-in (s/ring 8) own-out (s/ring 8)]\n    {:opts {:call-in own-in :call-out own-out :call-out-cursor (vm/mint-oldest own-out :test)}\n     :finish #(swap! trace into (tu/drain own-in))}))\n\n\n(defn caller\n  [wrap call-in call-out]\n  (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                  :call-out-cursor (vm/mint-oldest call-out :test)})\n                        (with-cat (wrap (s/call-node :op/echo \"hello\"))))))\n\n\n(defn sent-ffi\n  [wrap]\n  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n        m (caller wrap call-in call-out)\n        id (ffi/response-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi :call-id id\n     :steps [#(stream/append! call-out (apply2/success-response id \"echo!\"))]\n     :finish #(swap! trace into (tu/drain call-in))\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn retained-ffi\n  [wrap]\n  (let [trace (atom []) call-in (support/one-slot-stream \"call-in\") call-out (s/ring 8)\n        _ (stream/append! call-in :warmed)\n        m (caller wrap call-in call-out)\n        id (ffi/request-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n     :steps [#(stream/next call-in 0)\n             (fn []\n               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn module-response\n  [body exports]\n  {:status :ok :image {:value (project body)}\n   :manifest {:yin.module/name 'host.mod :yin.module/exports exports} :obligations []})\n\n\n(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n\n\n(def blocking-body\n  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n   binding holds the stream, so f's E does not capture it.\"\n  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n\n\n(defn require-op\n  [tail?]\n  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n\n\n(defn link-receiver\n  [trace]\n  (fn []\n    (let [rq (s/ring 64)]\n      {:opts {:link-request rq :link-response (s/ring 64)} :finish #(swap! trace into (tu/drain rq))})))\n\n\n(defn linking\n  \"A require parked in :link-response (or :link-request behind a full,\n   warmed request stream when retained?).\"\n  [wrap tail? retained?]\n  (let [trace (atom [])\n        request (if retained? (support/one-slot-stream \"link-request\") (s/ring 64))\n        response (s/ring 64)\n        _ (when retained? (stream/append! request :warmed))\n        m (vm/run (load-program (machine {:link-request request :link-response response})\n                                (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m)))\n        answer! #(stream/append! response (assoc (module-response plain-body #{'f}) :yin.link/id id))]\n    {:machine m :kind :blocked :reason (if retained? :link-request :link-response)\n     :surfaces #{:reader :writer} :trace trace\n     :steps (if retained? [#(stream/next request 0) answer!] [answer!])\n     :finish (if retained?\n               #(swap! trace conj (:dao.stream/value (stream/next request 0)))\n               #(swap! trace into (tu/drain request)))\n     :receiver (link-receiver trace)}))\n\n\n(defn installing\n  \"A require parked on :install beside its blocked child.\"\n  [wrap tail? phase]\n  (let [trace (atom [])\n        request (s/ring 64) response (s/ring 64)\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n        m1 (vm/run m0)\n        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n        child (get-in m [:installs 'host.mod :vm])\n        child-stream (s/stream-of child)]\n    {:machine m :kind :blocked :reason :install :trace trace\n     :steps [#(stream/append! child-stream :fed)]\n     :finish #(swap! trace into (tu/drain request))\n     :receiver (link-receiver trace)}))\n\n\n(defn module-context\n  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n  [wrap]\n  (let [request (s/ring 64) response (s/ring 64)\n        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n        m (vm/run m0)\n        src (s/stream-of m)]\n    ;; The carrier holds module stores, not registry entries: the receiver's\n    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n     :receiver (constantly {:opts {:modules (:modules m)}})}))\n\n\n(defn run-beside\n  [m ast]\n  (vm/run (load-program m ast)))\n\n\n(defn parking\n  [m]\n  (let [pid (:id (vm/value m))]\n    {:machine m :kind :parked :pid pid :trace (atom [])\n     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n\n\n(defn module-store-cursors\n  \"An explicit park whose module store holds two cursor references nothing\n   else reaches, named by a module closure in the task store.\"\n  [wrap]\n  (let [ring (s/ring 4)\n        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n        cursor (fn [m]\n                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n                   (engine/handle-cursor m {:stream ref} id)))\n        [c1 m] (cursor m)\n        [c2 m] (cursor m)\n        [seg image] (first (:code m))\n        closure (first (filter #(= :closure (first %)) (:vector image)))\n        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n    (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n\n\n(defn free-env-world\n  [wrap env]\n  (reader wrap (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) (s/next-of (s/v 'c)))) (s/lit 1)))\n          [] \"B\" {:env env}))\n\n\n(def read-op (s/next-of (s/v 'c)))\n\n\n(def capture {:type :vm/current-continuation})\n\n\n(def rows\n  \"[row bare-result build]: rows 1-19, 21, 22, 24 of §5.2. A nil result\n   compares with the reference only.\"\n  [[1 [\"A\" \"B\"] #(reader % (s/let1 'a read-op (cat-of (cat-of (s/lit []) (s/v 'a)) read-op)) [\"A\"] \"B\" {})]\n   [2 nil writer]\n   [3 \"echo!\" sent-ffi]\n   [4 \"echo!\" retained-ffi]\n   [5 [:ordinary \"B\"] #(reader % (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c))))]\n   [6 \"B\" #(reader % (s/app (s/lam ['u] (tail (s/app (s/v 'stream/next!) (s/v 'c)))) (s/lit 0)))]\n   [7 'host.mod #(linking % false true)]\n   [8 'host.mod #(linking % false false)]\n   [9 'host.mod #(linking % true false)]\n   [10 'host.mod #(installing % false nil)]\n   [11 'host.mod #(installing % false :running)]\n   [12 'host.mod #(installing % true nil)]\n   [13 \"back\" #(parking (vm/run (load-program (machine) (with-cat (% {:type :vm/park})))))]\n   [14 [:continuation \"B\"] #(reader % (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read-op)))]\n   [15 :done #(reader % (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n                                            :consequent (s/lit :done)\n                                            :alternate (s/let1 'r read-op (s/app (s/v 'k) (s/lit :second)))})\n                      [] \"x\" {})]\n   [16 [:continuation :continuation \"B\"]\n    #(reader % (s/let1 'k1 capture (s/let1 'k2 capture (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read-op))))]\n   [17 \"B\" module-context]\n   [18 \"back\" module-store-cursors]\n   [19 42 #(let [m (vm/run (load-program (machine) (with-cat (% (s/lit 42)))))]\n             {:machine m :kind :halted :trace (atom [])})]\n   [21 99 #(free-env-world % {'x 99})]\n   [22 [nil \"B\"] #(reader % (s/let1 'pair (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n                                    (s/app (s/v 'pair) (s/lit nil) read-op)))]\n   [24 \"echo!\" sent-ffi]])\n\n\n(defn tail-effect-halt\n  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n   call (stream/next! c) with an empty K.\"\n  []\n  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n        src (s/stream-of m)]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n;; =============================================================================\n;; The two runs\n;; =============================================================================\n\n(defn drive-local\n  [m]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n\n\n(defn drive-peers\n  [m peers]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n))\n      m\n      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n\n\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n        attaches @n\n        again (served surfaces)\n        relift (rows/lift-task recv (:serve! again) (lift-opts))\n        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn root-task\n  [wire]\n  (rows/decode wire))\n\n\n(defn stream-identities\n  \"The distinct stream identities of the whole carrier, install children\n   included: one row table serves the tree.\"\n  [wire]\n  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n\n\n(defn rows-in\n  \"Every row node the decoded tree x reaches, once per path.\"\n  [x]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots)) (cons x (rows-in (:slots x)))\n    (sequential? x) (mapcat rows-in x)\n    :else nil))\n\n\n(defn stream-occurrences\n  \"How many times the decoded tree reaches a :stream row.\"\n  [x]\n  (count (filter #(= :stream (:kind %)) (rows-in x))))\n\n\n(defn slot\n  [task i]\n  (nth (:slots task) i))\n\n\n(defn first-pending\n  [task]\n  (second (:slots (first (slot task 13)))))\n\n\n(defn laws\n  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n  [world expected]\n  (let [{:keys [wire relift corr corr2 attaches] :as got} (handed-off world)\n        task (root-task wire)]\n    (is (= (:kind world) (slot task 2)))\n    (is (= (count (stream-identities wire)) attaches) \"one attach per distinct stream identity\")\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n\n;; =============================================================================\n;; Acceptance 1: 89 runs\n;; =============================================================================\n\n(deftest ^:slow every-row-every-segment-matches-the-reference\n  (slow/guard\n    \"every-row-every-segment-matches-the-reference\"\n    (fn []\n      (let [cases (matrix-cases) runs (atom 0)]\n        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n        (doseq [[n label expected build] cases]\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (let [counted (atom [0 0])]\n    (doseq [[n r build] rows]\n      (testing (str \"row \" n)\n        (let [ref (reference (build identity))\n              {:keys [wire attaches]} (laws (build identity) ref)]\n          (when (some? r) (is (= r (:value ref))))\n          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n    ;; outside laws, so deleting its count assertion leaves one standing\n    (is (pos? (first @counted)) \"the corpus attaches streams\")\n    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n\n\n(deftest tail-states-carry-no-window\n  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n    (testing (str \"row \" label)\n      (let [{:keys [serve!]} (served #{:reader :writer})\n            wire (rows/lift-task (:machine world) serve! (lift-opts))\n            state (wait-state wire)\n            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n        (is (= :tail (:kind state)))\n        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n        (is (= 5 (count row)) \"[id :tail A site k]\")\n        (is (not-any? #(= :window (second %))\n                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n        (let [entry (first (:wait-set (:machine world)))]\n          (is (= {:deliver :return} (:deliver entry)))\n          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n\n\n(deftest tail-states-lower-to-through-k-delivery\n  (doseq [n [6 9 12]]\n    (testing (str \"row \" n)\n      (let [ref (reference (bare n))\n            {:keys [recv] :as got} (laws (bare n) ref)\n            entry (first (:wait-set recv))]\n        (is (= {:deliver :return} (:deliver entry)))\n        (is (contains? entry :site))\n        (is (not-any? #(contains? entry %) [:window :env :pc]) \"the lowered tail carries no window\")\n        (is (= (:value ref) (:value got))))))\n  (let [ref (reference (tail-effect-halt))\n        {:keys [recv] :as got} (laws (tail-effect-halt) ref)]\n    (is (= [] (:k (first (:wait-set recv)))) \"row 20: an empty K\")\n    (is (= \"B\" (:value got)) \"a tail effect with no frame to pop halts with the value\")))\n\n\n(deftest install-rows-carry-the-child\n  (doseq [[n phase] [[10 :parked] [11 :running] [12 :parked]]]\n    (testing (str \"row \" n)\n      (let [world (bare n)\n            {:keys [serve! toy]} (served #{:reader})\n            wire (rows/lift-task (:machine world) serve! (lift-opts))\n            [install] (slot (root-task wire) 12)\n            [mn carried-phase _ _ child] (:slots install)\n            {:keys [attach!] n :count} (recording-attacher toy)\n            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n            inst (get-in recv [:installs 'host.mod])\n            lowered (:vm inst)]\n        (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity of the tree\")\n        (is (= 'host.mod mn))\n        (is (= phase carried-phase) \"the child's phase as the source held it\")\n        (is (= :blocked (slot child 2)) \"the child's kind\")\n        (is (= :child (slot child 3)))\n        (is (= [:install 'host.mod] (:slots (first-pending (root-task wire)))))\n        (is (= phase (:phase inst)))\n        (is (nil? (:control lowered)) \"no initialization on lower: nothing runs\")\n        (is (= [:next] (mapv :reason (:wait-set lowered))) \"the child waits where it was lifted\")\n        (is (vm/blocked? lowered))\n        (is (= (count (slot child 11)) (count (:code-aliases lowered))) \"the child's code by A\")))))\n\n\n(deftest captures\n  (doseq [n [14 15 16]]\n    (testing (str \"row \" n)\n      (let [ref (reference (bare n))]\n        (laws (bare n) ref))))\n  (let [world (bare 15)\n        {:keys [recv] :as got} (laws world (reference (bare 15)))\n        entry (first (:wait-set recv))\n        k (get-in entry [:env 'k])\n        p (values/payload k)]\n    (is (values/continuation? k) \"the capture travels in the closure's E\")\n    (is (not (contains? (:window p) (get-in p [:deliver :rd]))) \"nothing is delivered into the captured rd on lower\")\n    (is (= :done (:value got)) \"the invocation after lower delivers once and re-enters\")))\n\n\n(deftest free-env-shadowing\n  (let [ref (reference (bare 21))\n        got (laws (bare 21) ref)]\n    (is (= 99 (:value got)) \"the lowered f resolves x through the carried free environment\"))\n  (testing \"the explicit :free-env overrides the kernel's retained field\"\n    (let [world (bare 21)\n          m (assoc (:machine world) :free-env {'x 5})\n          {:keys [serve! toy]} (served #{:reader})]\n      (is (= :inconsistent-state (:yin.k/kind (error #(rows/lift-task m serve! (lift-opts)))))\n          \"a free environment no E agrees with is refused\")\n      (let [wire (rows/lift-task m serve! (assoc (lift-opts) :free-env {'x 99}))\n            free (slot (root-task wire) 5)\n            {:keys [attach!]} (recording-attacher toy)\n            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)]\n        (is (= ['x [:lit 99]] (:slots free)))\n        (is (= {'x 99} (:free-env recv)))\n        (is (= {'x 99} (:env recv))))))\n  (testing \"neither the argument nor the kernel field: :missing-free-env\"\n    (let [m (assoc (:machine (bare 21)) :free-env nil)\n          d (error #(rows/lift-task m (:serve! (served #{:reader})) (lift-opts)))]\n      (is (= [:yin.k/non-portable :missing-free-env] [(:yin.k/status d) (:yin.k/kind d)])))))\n\n\n(deftest module-store-snapshot\n  (let [{:keys [wire recv]} (laws (bare 18) (reference (bare 18)))\n        task (root-task wire)\n        {:strs [c d]} (into {} (map (fn [[k v]] [(name k) v])) (get-in recv [:module-stores 'host.mod]))]\n    (is (= 1 (count (slot task 7))) \"one :module-store row\")\n    (is (= 2 (quot (count (:slots (slot task 9))) 2)) \"two cursor cells\")\n    (is (= :cursor-ref (:type c) (:type d)))\n    (is (not= (:id c) (:id d)) \"the two cursor cells stay two\")\n    (is (= :closure (normalize (get-in recv [:store 'mod]))))))\n\n\n(deftest synthetic-tail-bookkeeping\n  ;; Row 23: a hand-built parked tail; no primitive returns an FFI effect\n  ;; through a tail :call today, so it is judged by frame/defect only.\n  (let [m (:machine (bare 6))\n        entry (first (:wait-set m))\n        f (dissoc (ft/canonical m entry false) :yin.k/pending)\n        code-map (ft/machine-code m)\n        v (get code-map (:yin.k/segment f))\n        non-tail (first (keep-indexed (fn [pc t] (when (and (= :call (first t)) (false? (nth t 4))) pc)) v))\n        ctx {:free-env {} :ffi-call-ids #{:call-7} :parked-key :call-7}]\n    (is (= :tail (:yin.k/state f)))\n    (is (nil? (frame/defect f code-map :parked ctx)) \"a tail record under a live FFI call id\")\n    (is (= :parked-site (:yin.k/kind (frame/defect f code-map :parked (assoc ctx :parked-key :call-8))))\n        \"the same record under a key absent from :ffi-call-ids\")\n    (is (some? non-tail))\n    (is (= :site (:yin.k/kind (frame/defect (assoc f :yin.k/site non-tail) code-map :parked ctx)))\n        \"T1 runs before P4\")))\n\n\n;; =============================================================================\n;; Acceptance 7: refusals, before any attachment\n;; =============================================================================\n\n(defn update-at\n  [x path f]\n  (if (empty? path)\n    (f x)\n    (if (map? x)\n      (update-in x [:slots (first path)] update-at (rest path) f)\n      (update x (first path) update-at (rest path) f))))\n\n\n(defn replace-nodes\n  \"Every row node matching pred, anywhere under x, replaced by (f node).\"\n  [x pred f]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots))\n    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n    (vector? x) (mapv #(replace-nodes % pred f) x)\n    :else x))\n\n\n(defn replace-row\n  \"The wire with row id's body replaced and every ancestor rehashed,\n   without canonicalizing slots: a tamper below the abstract emitter.\"\n  [wire id body]\n  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n        memo (atom {})]\n    (letfn [(rewrite\n              [x]\n              (cond\n                (contains? index x)\n                (or (get @memo x)\n                    (let [b (mapv rewrite (if (= x id) body (subvec (get index x) 1)))\n                          nid (jing/segment-key b)]\n                      (swap! memo assoc x nid)\n                      nid))\n                (vector? x) (mapv rewrite x)\n                :else x))]\n      (let [root (rewrite (:yin.k/root wire))\n            rs (mapv (fn [[old nid]]\n                       (into [nid] (mapv rewrite (if (= old id) body (subvec (get index old) 1)))))\n                     @memo)]\n        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n\n\n(defn pairs-of\n  [n]\n  (mapv vec (partition 2 (:slots n))))\n\n\n(defn rebuild\n  [n f]\n  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n\n\n(defn lowered\n  \"Lower wire into a fresh receiver: [outcome attaches].\"\n  [toy wire]\n  (let [{:keys [attach!] n :count} (recording-attacher toy)\n        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n    [r @n]))\n\n\n(defn free-register\n  \"A register of the act's body that is neither in its window nor its rd.\"\n  [task act]\n  (let [[a pc _ w _ rd] (:slots act)\n        v (get (slot task 11) a)\n        bodies (code/parse v)\n        k (:registers (nth bodies (code/body-index bodies pc)))\n        taken (into #{rd} (map first) (pairs-of w))]\n    (first (remove taken (range k)))))\n\n\n(def wait-act [13 0 0])\n\n\n(defn tamper-cases\n  []\n  (let [act-of (fn [task] (get-in task [:slots 13 0 :slots 0]))]\n    [[\"window with an extra live key\" 1 :window-extra\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (conj ps [(free-register task (act-of task)) [:lit :x]])))))]\n     [\"a live key removed\" 1 :window-missing\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (rest ps))))))]\n     [\"rd added\" 1 :window-self\n      (fn [task]\n        (update-at task (conj wait-act 3)\n                   #(rebuild % (fn [ps] (conj ps [(nth (:slots (act-of task)) 5) [:lit :x]])))))]\n     [\"rd replaced by another register\" 1 :destination\n      (fn [task] (update-at task (conj wait-act 5) inc))]\n     [\"a reason the site does not admit\" 1 :reason-mismatch\n      (fn [task] (update-at task [13 0 1] (constantly (rows/node :pending [:install 'bogus]))))]\n     [\"the [:lit nil] of row 22 dropped\" 22 :window-missing\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (remove (fn [[_ v]] (= [:lit nil] v)) ps))))))]\n     [\"a :reified act whose pc-1 is not a capture\" 14 :captured-site\n      (fn [task]\n        (let [act (act-of task)]\n          (replace-nodes task #(= :reified (:kind %)) (constantly (rows/node :reified [act])))))]\n     [\"a parked act whose pc-1 is not :park\" 1 :parked-site\n      (fn [task] (update-at task [8] (constantly (rows/node :parked-table [:bogus (act-of task)]))))]\n     [\"the root free-env row given a reserved key\" 1 :reserved-name\n      (fn [task] (update-at task [5] #(rebuild % (fn [ps] (conj ps ['yin/def [:lit 1]])))))]]))\n\n\n(defn return-site-case\n  \"A return frame's pc moved after a tail call (K1); falls back to a pc\n   after any non-call when no tail call has a successor in its body.\"\n  [task]\n  (let [kpath [13 0 0 2 0]\n        kf (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0])\n        [a] (:slots kf)\n        v (get (slot task 11) a)\n        bodies (code/parse v)\n        same-body? (fn [p] (= (code/body-index bodies (dec p)) (code/body-index bodies p)))\n        tail-call? (fn [t] (and (= :call (first t)) (true? (nth t 4))))\n        after-tail (first (filter #(and (tail-call? (nth v (dec %))) (same-body? %)) (range 1 (count v))))\n        after-other (first (filter #(and (not= :call (first (nth v (dec %)))) (same-body? %)) (range 1 (count v))))]\n    [(if after-tail :after-tail-call :after-non-call)\n     (update-at task (conj kpath 1) (constantly (or after-tail after-other)))]))\n\n\n(defn lift-bare\n  [n]\n  (let [world (bare n)\n        {:keys [serve! toy]} (served #{:reader :writer})]\n    [toy (rows/lift-task (:machine world) serve! (lift-opts))]))\n\n\n(deftest refusals\n  (doseq [[label n kind tamper] (tamper-cases)]\n    (testing label\n      (let [[toy wire] (lift-bare n)\n            [r attaches] (lowered toy (rows/emit-numbered (tamper (root-task wire)) {}))]\n        (is (= [:yin.k/undecodable kind] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n        (is (zero? attaches) \"refused before any attachment\"))))\n  (testing \"a segment with no tree association (§6.1): unsatisfied, before any attachment\"\n    (let [[toy wire] (lift-bare 1)\n          task (update-at (root-task wire) [10] #(assoc % :yin.k/trees {}))\n          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n      (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n      (is (= :incomplete (:yin.k/discovery r)))\n      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))\n      (is (zero? attaches)))\n    (let [world (bare 1)\n          d (error #(rows/lift-task (:machine world) (:serve! (served #{:reader})) {:source-index {}}))]\n      (is (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)]) \"the lift refuses it too\")))\n  (testing \"a return frame's pc moved after a tail call\"\n    (let [[toy wire] (lift-bare 6)\n          [how task] (return-site-case (root-task wire))\n          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n      (is (= :after-tail-call how))\n      (is (= [:yin.k/undecodable :return-site] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches))))\n  (testing \"a :tail row given a fourth slot is refused at structure, before frames\"\n    (let [[toy wire] (lift-bare 6)\n          [id & body] (first (filter #(= :tail (second %)) (:yin.k/rows wire)))\n          [r attaches] (lowered toy (replace-row wire id (conj (vec body) 0)))]\n      (is (= :yin.k/undecodable (:yin.k/status r)))\n      (is (= :row-shape (:yin.k/kind r)) \"the codec's structure step (2) runs before the frames step (7)\")\n      (is (zero? attaches))))\n  (testing \"E2 over row 21 with the free environment {x 99 y 7}\"\n    (let [world (free-env-world identity {'x 99 'y 7})\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task (:machine world) serve! (lift-opts))\n          task (root-task wire)\n          env-path (conj wait-act 2 0)\n          edit (fn [f] (rows/emit-numbered (update-at task env-path #(rebuild % (fn [ps] (f (into {} ps))))) {}))]\n      (is (= [:lit 1] (second (first (filter #(= 'x (first %)) (pairs-of (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0]))))))\n          \"the lexical x is 1 at the read\")\n      (doseq [[label f] [[\"the unshadowed y changed\" #(assoc % 'y [:lit 8])]\n                         [\"the lexical x removed\" #(dissoc % 'x)]]]\n        (testing label\n          (let [[r attaches] (lowered toy (edit f))]\n            (is (= [:yin.k/undecodable :free-env-mismatch] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n            (is (zero? attaches)))))\n      (testing \"the lexical x changed trips nothing\"\n        (let [[r] (lowered toy (edit #(assoc % 'x [:lit 98])))]\n          (is (vm/blocked? r) (pr-str r))))))\n  (testing \"lift refusals, before any stream is served\"\n    (let [counting (fn []\n                     (let [n (atom 0) {:keys [serve!]} (served #{:reader})]\n                       [(fn [h] (swap! n inc) (serve! h)) n]))\n          stepped (vm/step (load-program (machine) (s/lit 42)))\n          m0 (load-program (machine) (s/app (s/v 'stream/poll!) (s/v 'c)))\n          [sref m1] (engine/attach-resource m0 (s/ring 8))\n          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n          held (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))]\n      (is (= [:observe] (mapv :reason (:wait-set held))))\n      (doseq [[label m status kind] [[\"not at a safepoint\" stepped :yin.k/not-at-safepoint nil]\n                                     [\"a held :observe\" held :yin.k/non-portable :reason-mismatch]]]\n        (testing label\n          (let [[serve! n] (counting)\n                d (error #(rows/lift-task m serve! (lift-opts)))]\n            (is (= status (:yin.k/status d)) (pr-str d))\n            (is (= kind (:yin.k/kind d)))\n            (is (zero? @n))))))))\n\n\n(deftest first-defect-order\n  (let [[toy wire] (lift-bare 18)\n        task (root-task wire)\n        state-path [8 1]\n        state (get-in task [:slots 8 :slots 1])\n        ;; the park's window: rd added\n        tampered (update-at task (conj state-path 3)\n                            #(rebuild % (fn [ps] (conj ps [(nth (:slots state) 5) [:lit :x]]))))\n        census (mapv first (pairs-of (slot task 9)))\n        swapped (zipmap census (reverse census))]\n    (is (= 2 (count census)))\n    (is (= :window-self (:yin.k/kind (first (lowered toy (rows/emit-numbered tampered {}))))))\n    (let [[r attaches] (lowered toy (rows/emit-numbered tampered swapped))]\n      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches)))))\n\n\n;; =============================================================================\n;; Acceptance 8: the two ported tests\n;; =============================================================================\n\n(defn parked-reader\n  []\n  (let [m0 (vm/run (load-program (machine) (with-stream (s/then read-op read-op))))\n        src (s/stream-of m0)]\n    (stream/append! src \"A\")\n    [(vm/run m0) src]))\n\n\n(deftest a-nonempty-ready-queue-is-not-quiescent\n  (let [[parked src] (parked-reader)\n        _ (stream/append! src \"B\")\n        woken (engine/check-wait-set parked)\n        n (atom 0)\n        {:keys [serve!]} (served #{:reader})\n        d (error #(rows/lift-task woken (fn [h] (swap! n inc) (serve! h)) (lift-opts)))]\n    (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n    (is (= :yin.k/not-quiescent (:yin.k/status d)) (pr-str d))\n    (is (zero? @n) \"no stream was served\")))\n\n\n(defn two-callers\n  []\n  (let [call-in (s/ring 8) call-out (s/ring 8)\n        m (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                          :call-out-cursor (vm/mint-oldest call-out :test)})\n                                (s/then (s/call-node :op/echo \"hello\") (s/call-node :op/echo \"world\"))))\n        e1 (first (:wait-set m))]\n    [(assoc m :wait-set [e1 (assoc e1 :call-id :parked-9)]) call-out (:call-id e1)]))\n\n\n(defn answer-both!\n  [call-out first-id]\n  (stream/append! call-out (apply2/success-response :parked-9 \"second\"))\n  (stream/append! call-out (apply2/success-response first-id \"first\")))\n\n\n(defn sweep\n  [m peers]\n  (loop [m (engine/check-wait-set m) n 12]\n    (if (or (zero? n) (empty? (:wait-set m)))\n      m\n      (do (run! s/serve-mirror! peers) (recur (engine/check-wait-set m) (dec n))))))\n\n\n(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n  (let [[ref-m ref-out id] (two-callers)\n        _ (answer-both! ref-out id)\n        expected (mapv :value (:ready-queue (sweep ref-m [])))\n        [m call-out id] (two-callers)\n        {:keys [serve! toy peer]} (served #{:reader})\n        wire (rows/lift-task m serve! (lift-opts))\n        task (root-task wire)\n        pendings (mapv #(second (:slots %)) (slot task 13))\n        own-out (s/ring 8)\n        {:keys [attach!] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine {:attach-stream attach! :call-in (s/ring 8) :call-out own-out\n                                        :call-out-cursor (vm/mint-oldest own-out :test)})\n                              wire attach!)\n        [w1 w2] (:wait-set recv)\n        _ (answer-both! call-out id)\n        swept (sweep recv [peer])]\n    (is (= [:ffi :ffi] (mapv #(first (:slots %)) pendings)))\n    (is (= [id :parked-9] (mapv #(nth (:slots %) 2) pendings)))\n    (is (= 1 (quot (count (:slots (slot task 9))) 2)) \"the two waiters name one cursor cell\")\n    (is (= (nth (:slots (first pendings)) 1) (nth (:slots (second pendings)) 1)))\n    (is (= (:cursor-ref w1) (:cursor-ref w2)) \"the lower gives both waiters one fresh cursor entry\")\n    (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity\")\n    (is (= [(apply2/success-response :parked-9 \"second\") (apply2/success-response id \"first\")] expected))\n    (is (empty? (:wait-set swept)))\n    (is (= expected (mapv :value (:ready-queue swept)))\n        \"the receiver wakes the same waiters with the same responses\")))\n\n\n(deftest act-ffi-bookkeeping\n  ;; Row 24: row 3's bookkeeping record travels in the parked table under\n  ;; its call id, and the validator accepts it in context :parked.\n  (let [world (bare 24)\n        {:keys [serve!]} (served #{:reader})\n        task (root-task (rows/lift-task (:machine world) serve! (lift-opts)))\n        [p state] (:slots (slot task 8))]\n    (is (= (:call-id world) p))\n    (is (= :act (:kind state)))\n    (is (= [:ffi (:call-id world)] [(first (:slots (first-pending task))) (nth (:slots (first-pending task)) 2)]))\n    (is (nil? (rows/validate-frames task)))))\n\n\n(deftest a-stream-shared-across-the-tree-attaches-once\n  ;; Row 10 with the link-request stream named from the root's store and\n  ;; from the install child's: one identity, reached by two tasks.\n  (let [m (:machine (bare 10))\n        child (get-in m [:installs 'host.mod :vm])\n        ref-in (fn [x] (engine/issue-ref x :stream-ref module/link-request-resource))\n        m (-> m\n              (update :store assoc 'rq (ref-in m))\n              (assoc-in [:installs 'host.mod :vm] (update child :store assoc 'rq (ref-in child))))\n        {:keys [serve! toy]} (served #{:reader :writer})\n        wire (rows/lift-task m serve! (lift-opts))\n        task (root-task wire)\n        {:keys [attach!] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n        lowered-child (get-in recv [:installs 'host.mod :vm])\n        handle (fn [x] (get (:resources x) (:id (get-in x [:store 'rq]))))]\n    (is (< (count (stream-identities wire)) (stream-occurrences task)) \"the tree reaches one identity twice\")\n    (is (= (count (stream-identities wire)) @n) \"one attach per distinct stream identity\")\n    (is (some? (handle recv)))\n    (is (identical? (handle recv) (handle lowered-child)) \"both tasks hold the one attached stream\")))\n\n\n;; =============================================================================\n;; Carrier defects the restore would meet: refused before any attachment\n;; =============================================================================\n\n(defn refused-before-attach\n  \"Lower row n's carrier after (edit task): [status kind data]; asserts\n   no stream was attached.\"\n  [n edit]\n  (let [[toy wire] (lift-bare n)\n        [r attaches] (lowered toy (rows/emit-numbered (edit (root-task wire)) {}))]\n    (is (zero? attaches) (str \"refused before any attachment: \"\n                              (pr-str (select-keys r [:yin.k/status :yin.k/kind :rule :reason :defect]))))\n    [(:yin.k/status r) (:yin.k/kind r) r]))\n\n\n(def install-path [12 0])\n\n\n(defn with-store-key\n  [k]\n  (fn [s] (rebuild s (fn [ps] (conj ps [k [:lit 42]])))))\n\n\n(defn closures\n  [f]\n  (fn [task] (replace-nodes task #(= :closure (:kind %)) f)))\n\n\n(deftest carrier-defects-refuse-before-attachment\n  (testing \"a reserved root store key\"\n    (let [[status kind r] (refused-before-attach 1 #(update-at % [6] (with-store-key 'yin/def)))]\n      (is (= [:yin.k/undecodable :reserved-name :store-key] [status kind (:yin.k/role r)]))))\n  (testing \"a reserved module store key\"\n    (let [[status kind r] (refused-before-attach 18 #(update-at % [7 0 1] (with-store-key 'yin/def)))]\n      (is (= [:yin.k/undecodable :reserved-name :store-key] [status kind (:yin.k/role r)]))))\n  (testing \"a closure whose entry names no closure of its code\"\n    (is (= [:yin.k/undecodable :closure-origin]\n           (take 2 (refused-before-attach 1 (closures #(assoc-in % [:slots 1] 999999999)))))))\n  (testing \"a closure whose binders are not its tuple's\"\n    (is (= [:yin.k/undecodable :closure-binders]\n           (take 2 (refused-before-attach 1 (closures #(update-in % [:slots 2] (fn [ps] (conj (vec (butlast ps)) 'zz)))))))))\n  (testing \"an install whose retained response is {}\"\n    (is (= [:yin.k/undecodable :install-response]\n           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 3) (constantly {})))))))\n  (testing \"an install whose response image does not load\"\n    (is (= [:yin.k/undecodable :install-response]\n           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 3) (fn [r] (assoc-in r [:image :value] []))))))))\n  (testing \"an install whose manifest names another module\"\n    (is (= [:yin.k/undecodable :install-response]\n           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 3)\n                                                         (fn [r] (assoc-in r [:manifest :yin.module/name] 'other.mod))))))))\n  (testing \"an install in a phase the engine never carries\"\n    (is (= [:yin.k/undecodable :install-phase]\n           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 1) (constantly :bogus)))))))\n  (testing \"an install whose child is not blocked\"\n    (is (= [:yin.k/undecodable :install-child]\n           (take 2 (refused-before-attach 10 #(update-at % (conj install-path 4 2) (constantly :halted))))))))\n\n\n(defn exclusive\n  [task]\n  (update-at task [16] (constantly {:custody :exclusive})))\n\n\n(defn without-trees\n  [path]\n  (fn [task] (update-at task path #(assoc % :yin.k/trees {}))))\n\n\n(deftest carrier-steps-run-in-order-over-the-tree\n  (testing \"custody (10) alone\"\n    (is (= [:yin.k/unsupported :custody] (take 2 (refused-before-attach 1 exclusive)))))\n  (testing \"the dependency closure (9) before custody (10)\"\n    (let [[status _ r] (refused-before-attach 1 (comp exclusive (without-trees [10])))]\n      (is (= :yin.k/unsatisfied status) (pr-str r))\n      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))))\n  (testing \"the child's dependency closure before the root's custody\"\n    (let [[status _ r] (refused-before-attach 10 (comp exclusive (without-trees (conj install-path 4 10))))]\n      (is (= :yin.k/unsatisfied status) (pr-str r))\n      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))))\n  (testing \"an install record (8) before the root's dependency closure (9)\"\n    (is (= [:yin.k/undecodable :install-phase]\n           (take 2 (refused-before-attach 10 (comp #(update-at % (conj install-path 1) (constantly :bogus))\n                                                   (without-trees [10]))))))))\n\n\n;; =============================================================================\n;; The dependency closure: each free occurrence in its own context (§7.1)\n;; =============================================================================\n\n(defn halted-on\n  [ast]\n  (vm/run (load-program (machine) ast)))\n\n\n(def ghost-fn (s/lam [] (s/v 'ghost)))\n\n\n(defn lift-outcome\n  \"Lift m: [the wire or the refusal's ex-data, serves].\"\n  [m]\n  (let [n (atom 0)\n        {:keys [serve!]} (served #{:reader})\n        r (try (rows/lift-task m (fn [h] (swap! n inc) (serve! h)) (lift-opts))\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n    [r @n]))\n\n\n(defn missing-obligations\n  [m]\n  (let [[d] (lift-outcome m)]\n    (when (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)])\n      (get-in d [:yin.k/missing :obligations]))))\n\n\n(defn routed\n  \"closure c, its E naming module store mid.\"\n  [m c mid]\n  (values/closure (:owner m) (assoc-in (values/payload c) [:env engine/store-of-key] mid)))\n\n\n(deftest free-occurrences-are-answered-in-their-own-context\n  (let [m (halted-on ghost-fn)\n        g (vm/value m)]\n    (testing \"a carried closure whose only free obligation is missing\"\n      (is (= #{'ghost} (missing-obligations m))))\n    (testing \"a module store the closure does not route to answers nothing\"\n      (is (= #{'ghost} (missing-obligations (assoc m :module-stores {'unrelated {'ghost 42}})))))\n    (testing \"a routed closure reads its module store, never the root store\"\n      (is (= #{'ghost} (missing-obligations (assoc m :value (routed m g 'scoped) :store {'ghost 1}\n                                                   :module-stores {'scoped {}})))))\n    (testing \"the root store answers a top-level closure\"\n      (is (nil? (missing-obligations (assoc m :store {'ghost 1})))))\n    (testing \"reachable only through the store\"\n      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'k g})))))\n    (testing \"another closure's E answers nothing\"\n      (let [bound (values/closure (:owner m) (assoc-in (values/payload g) [:env 'ghost] 1))]\n        (is (nil? (missing-obligations (assoc m :value bound))) \"its own E answers\")\n        (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'a bound 'k g}))))))\n    (testing \"reachable only through a module store a routed closure reaches\"\n      ;; the holder runs in outer, where ghost is 2; k, found in outer,\n      ;; runs at top level, where nothing answers ghost\n      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'mod (routed m g 'outer)}\n                                                   :module-stores {'outer {'ghost 2 'k g}}))))))\n  (testing \"reachable only through another closure's E\"\n    (is (= #{'ghost} (missing-obligations (halted-on (s/let1 'h ghost-fn (s/lam [] (s/app (s/v 'h)))))))))\n  (testing \"a routed module store answers, travels alone, and the lowered closure reads it\"\n    (let [m0 (halted-on ghost-fn)\n          m (assoc m0 :value (routed m0 (vm/value m0) 'scoped) :module-stores {'scoped {'ghost 42} 'unrelated {'other 1}})\n          [wire serves] (lift-outcome m)\n          {:keys [toy]} (served #{:reader})\n          [recv attaches] (lowered toy wire)]\n      (is (contains? wire :yin.k/rows) (pr-str wire))\n      (is (zero? serves))\n      (is (zero? attaches))\n      (is (= ['scoped] (mapv #(first (:slots %)) (slot (root-task wire) 7))) \"only the routed module store travels\")\n      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f)))))))))\n\n\n(def fresh-read (s/next-of (s/cursor-of {:type :stream/make :buffer 4})))\n\n\n(defn fed-73\n  \"Lift m, lower it into a fresh receiver, then feed the source's stream\n   73 and run both.\"\n  [m]\n  (let [{:keys [serve! toy peer]} (served #{:reader})\n        wire (rows/lift-task m serve! (lift-opts))\n        [recv attaches] (lowered toy wire)]\n    (stream/append! (s/stream-of m) 73)\n    {:source (vm/value (vm/run m)) :receiver (vm/value (drive-peers recv [peer])) :attaches attaches}))\n\n\n(deftest discharge-follows-control-flow-from-the-resume-pc\n  (let [past (fn [consequent]\n               (halted-on {:type :if :test (s/lit false) :consequent consequent :alternate fresh-read}))]\n    (testing \"a free read behind the resume pc is no obligation\"\n      (doseq [m [(past (s/v 'ghost))\n                 (assoc (past (s/v 'ghost)) :module-stores {'unrelated {'ghost 42}})\n                 (past ghost-fn)]]\n        (is (= {:source 73 :receiver 73 :attaches 1} (fed-73 m))))))\n  (testing \"a free read after the resume pc is an obligation\"\n    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read (s/v 'ghost)))))))\n  (testing \"a closure reachable code can still construct is an obligation\"\n    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read ghost-fn))))))\n  (testing \"a backward jump makes earlier code live\"\n    ;; §3.1 admits no backward jump, so no carried vector has one; live-pcs\n    ;; follows the stated edges, never pc order\n    (let [v [[:const 1 false] [:branch-false 1 4] [:var 0 'ghost] [:jump 6] [:const 0 1] [:jump 2] [:halt 0]]]\n      (is (contains? (rows/live-pcs v 4) 2))\n      (is (not (contains? (rows/live-pcs v 3) 2))))))\n\n\n;; =============================================================================\n;; Every store-of names a module store of its own task (§2.6)\n;; =============================================================================\n\n(defn routed-beside-stream\n  \"ast's closure routed to module store scoped, with an authentic stream\n   in the root store so that an attachment is observable.\"\n  [ast stores]\n  (let [m0 (halted-on ast)\n        [ref m] (engine/attach-resource m0 (s/ring 4))]\n    (assoc m :value (routed m (vm/value m) 'scoped) :module-stores stores :store {'stream ref})))\n\n\n(defn without-module-stores\n  [path]\n  (fn [task] (update-at task path (constantly []))))\n\n\n(defn module-store-ids\n  [task]\n  (mapv #(first (:slots %)) (slot task 7)))\n\n\n(deftest every-store-of-names-a-module-store-of-its-own-task\n  (doseq [[label ast stores value] [[\"a scoped store\" ghost-fn {'scoped {'ghost 42}} 42]\n                                    [\"a present empty store\" (s/lam [] (s/lit 7)) {'scoped {}} 7]]]\n    (testing label\n      (let [{:keys [serve! toy]} (served #{:reader})\n            wire (rows/lift-task (routed-beside-stream ast stores) serve! (lift-opts))\n            [recv attaches] (lowered toy wire)\n            [r none] (lowered toy (rows/emit ((without-module-stores [7]) (root-task wire))))]\n        (is (= ['scoped] (module-store-ids (root-task wire))))\n        (is (= 1 attaches))\n        (is (= value (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f))))))\n        (testing \", its rows removed\"\n          (is (zero? none) \"refused before any attachment\")\n          (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))))\n  (testing \"a closure inside a module store's value naming another module store\"\n    ;; k lives only in outer's value and is routed to inner; stripping inner\n    ;; alone must refuse, else k attaches and fails reading ghost\n    (let [m0 (halted-on ghost-fn)\n          g (vm/value m0)\n          [ref m] (engine/attach-resource m0 (s/ring 4))\n          m (assoc m :value (routed m g 'outer) :store {'stream ref}\n                   :module-stores {'outer {'ghost 1 'k (routed m g 'inner)} 'inner {'ghost 42}})\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task m serve! (lift-opts))\n          strip (fn [task] (update-at task [7] (fn [ns] (vec (remove #(= 'inner (first (:slots %))) ns)))))\n          [recv attaches] (lowered toy wire)\n          [r none] (lowered toy (rows/emit (strip (root-task wire))))]\n      (is (= #{'outer 'inner} (set (module-store-ids (root-task wire)))))\n      (is (= 1 attaches))\n      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (get-in recv [:module-stores 'outer 'k])}) (s/app (s/v 'f))))))\n      (is (zero? none) \"refused before any attachment\")\n      (is (= [:yin.k/unsatisfied #{'inner}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))\n  (testing \"a frame's E naming a store its task does not carry\"\n    (let [[status _ r] (refused-before-attach 17 (without-module-stores [7]))]\n      (is (= :yin.k/unsatisfied status))\n      (is (= 1 (count (get-in r [:yin.k/missing :yin.k/stores]))))))\n  (testing \"a child does not read its parent's store of the same key\"\n    (let [scope (fn [x]\n                  (-> x\n                      (update-in [:wait-set 0 :env] assoc engine/store-of-key 'scoped)\n                      (assoc :module-stores {'scoped {}})))\n          m (:machine (bare 10))\n          m (-> (scope m) (update-in [:installs 'host.mod :vm] scope))\n          {:keys [serve! toy]} (served #{:reader :writer})\n          wire (rows/lift-task m serve! (lift-opts))\n          child-path (conj install-path 4)\n          [ok n] (lowered toy wire)\n          [r none] (lowered toy (rows/emit ((without-module-stores (conj child-path 7)) (root-task wire))))]\n      (is (= ['scoped] (module-store-ids (root-task wire))) \"the parent carries scoped\")\n      (is (= ['scoped] (module-store-ids (slot (first (slot (root-task wire) 12)) 4))) \"and so does the child\")\n      (is (vm/blocked? ok) (pr-str (when (map? ok) (select-keys ok [:yin.k/status :yin.k/kind]))))\n      (is (= (count (stream-identities wire)) n))\n      (is (zero? none) \"refused before any attachment\")\n      (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n","numLines":1293,"startLine":1,"totalLines":1293}},"tool_result_meta":[{"id":"toolu_01RzLCD