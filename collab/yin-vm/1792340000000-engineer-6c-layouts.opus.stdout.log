:env (canonical-env cx fseg pc (:frames f) (:store-of f))","+                     :window (slice-window cx fseg pc slice)","+                     :rd (code/rd (inst fseg fsite))}))","+                frames parts)]","+    (if tail?","+      ;; frozen §2.4: the current frames, store-of and slice are dead","+      {:segment (:address seg) :site site :k k :deliver {:deliver :return}}","+      (let [pc (inc site)]","+        {:segment (:address seg) :pc pc","+         :env (canonical-env cx seg pc (:frames entry) (:store-of entry))","+         :window (slice-window cx seg pc (peek parts))","+         :k k","+         :deliver {:deliver :rd :rd (code/rd (inst seg site))}}))))","+","+","+(defn lift-state","+  \"A kernel's wait entry, parked record or reified payload as the","+   canonical act or tail payload (§4.2, §4.3), engine fields carried.\"","+  [cx entry]","+  (let [fields (apply dissoc entry kernel-keys)]","+    (merge (cond-> fields (contains? fields :datom) (update :datom #(canonical-value cx %)))","+           (if (= :stack (:kind cx)) (lift-stack cx entry) (lift-register cx entry)))))","+","+","+(defn lift-context","+  \"The lift context of kernel `k` over `space`; positional closures and","+   kernel continuations are reminted under `owner`.\"","+  [k space owner]","+  (assoc {} :kind (kernel-kind k) :kernel k :space space :free-env (or (:free-env k) {}) :owner owner))","+","+","+;; =============================================================================","+;; Lower: a canonical act or tail into a kernel","+;; =============================================================================","+","+(defn- lower-frames","+  [lx seg pc env]","+  (mapv (fn [f] (mapv #(positional-value lx %) f)) (frames-of seg pc env)))","+","+","+(defn- payload-segment","+  [lx p]","+  (segment-of (:space lx) (address-of lx (:segment p))))","+","+","+(defn- lower-regs","+  \"`(sort-by first [[phys(v) V] …])` over window `w`.\"","+  [lx seg site w]","+  (vec (sort-by first (map (fn [[x v]] [(phys seg site x) (positional-value lx v)]) w))))","+","+","+(defn- register-k","+  [lx k]","+  (mapv (fn [f]","+          (let [seg (payload-segment lx f)","+                off (offset :register (:kernel lx) seg)","+                pc (:pc f)","+                regs (lower-regs lx seg (dec pc) (:window f))","+                store-of (engine/env-store-of (:env f))]","+            (cond-> {:site-pc (+ off pc -1) :return-pc (+ off pc)","+                     :frames (lower-frames lx seg pc (:env f))","+                     :regs regs :live (mapv first regs)","+                     :dest (phys seg (dec pc) (:rd f))}","+              (some? store-of) (assoc :store-of store-of))))","+        k))","+","+","+(defn- lower-register","+  [lx p fill]","+  (let [k (:kernel lx)","+        seg (payload-segment lx p)","+        off (offset :register k seg)","+        common (cond-> {:segment (:segment k) :format register/format-tag :hash (:hash k)","+                        :image (:register-id seg) :continuation (register-k lx (:k p))}","+                 (< 1 (count (:images k))) (assoc :images (:images k)))]","+    (if (contains? p :site)","+      (cond-> (merge common {:site-pc (+ off (:site p)) :pc (+ off (:site p) 1)","+                             :frames (get fill :frames []) :regs [] :live [] :dest nil","+                             :resume-mode :return-result})","+        (some? (:store-of fill)) (assoc :store-of (:store-of fill)))","+      (let [pc (:pc p)","+            regs (lower-regs lx seg (dec pc) (:window p))","+            store-of (engine/env-store-of (:env p))]","+        (cond-> (merge common {:site-pc (+ off pc -1) :pc (+ off pc)","+                               :frames (lower-frames lx seg pc (:env p))","+                               :regs regs :live (mapv first regs)","+                               :dest (phys seg (dec pc) (get-in p [:deliver :rd]))","+                               :resume-mode :write-result})","+          (some? store