{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ELg2ZbnkKb4dxLnex82Mwn","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.safepoint-harness-test\n2\t  \"Phase 6b: the safepoint harness on the :semantic-register lane\n3\t   (docs/design/yin.vm.semantic-register-vm.continuation.md §5, §8.2).\n4\t\n5\t   Each row of the §5.2 matrix is built twice under each of the four\n6\t   segment wrappers: the reference build is satisfied and run on its own\n7\t   machine; the handoff build is lifted with rows/lift-task, lowered with\n8\t   rows/lower-task into a fresh receiver over the toy channel, relifted at\n9\t   once, then satisfied through the source's streams. Result and effect\n10\t   trace equal the reference (law 1); the relift equals the lift by root\n11\t   id under rows/canonical-under (law 2); the pending's reason is the\n12\t   observed wait's (law 3); every lifted frame passes the validator\n13\t   (law 6). Row 20 runs once, outside the wrappers.\"\n14\t  (:require [clojure.test :refer [deftest is testing]]\n15\t            [dao.jing :as jing]\n16\t            [dao.stream :as stream]\n17\t            [dao.stream.apply :as apply2]\n18\t            [dao.test-slow :as slow]\n19\t            [yin.vm :as vm]\n20\t            [yin.vm.engine :as engine]\n21\t            [yin.vm.ffi :as ffi]\n22\t            [yin.vm.module :as module]\n23\t            [yin.vm.values :as values]\n24\t            [yin.vm.test-utils :as tu]\n25\t            [yin.vm.semantic-register :as sr]\n26\t            [yin.vm.semantic-register.code :as code]\n27\t            [yin.vm.semantic-register.frame :as frame]\n28\t            [yin.vm.semantic-register.frame-test :as ft]\n29\t            [yin.vm.semantic-register.linearize :as linearize]\n30\t            [yin.vm.ucf.lift-support :as support]\n31\t            [yin.vm.ucf.rows :as rows]\n32\t            [yin.vm.ucf.v2-support :as s]))\n33\t\n34\t\n35\t;; =============================================================================\n36\t;; The composition: code by A, the source index, one machine builder\n37\t;; =============================================================================\n38\t\n39\t(def source-index\n40\t  \"The composition's {A #{tree-address}} (§6.1): every vector this\n41\t   harness projects is recorded beside the address of its AST.\"\n42\t  (atom {}))\n43\t\n44\t\n45\t(defn project\n46\t  [ast]\n47\t  (let [v (:vector (linearize/project ast))]\n48\t    (swap! source-index update (jing/segment-key v) (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n49\t    v))\n50\t\n51\t\n52\t(def stream-modules (module/register-stream-module (module/default-registry)))\n53\t\n54\t\n55\t(defn machine\n56\t  ([] (machine {}))\n57\t  ([opts]\n58\t   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n59\t                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n60\t                         :modules stream-modules}\n61\t                        opts))))\n62\t\n63\t\n64\t(defn load-program\n65\t  [m ast]\n66\t  (sr/load-vector m (project ast) code/contract))\n67\t\n68\t\n69\t(defn lift-opts\n70\t  []\n71\t  {:source-index @source-index})\n72\t\n73\t\n74\t(defn error\n75\t  [f]\n76\t  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n77\t\n78\t\n79\t;; =============================================================================\n80\t;; The corpus: four segments around one parking expression\n81\t;; =============================================================================\n82\t\n83\t(defn cat-of\n84\t  [p q]\n85\t  (s/app (s/v 'cat) p q))\n86\t\n87\t\n88\t(defn with-cat\n89\t  [ast]\n90\t  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n91\t\n92\t\n93\t(defn nest\n94\t  [d op]\n95\t  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n96\t\n97\t\n98\t(def segments\n99\t  \"[label wrap expected-of-bare-result] (§5.2).\"\n100\t  [[:bare identity identity]\n101\t   [:operand #(cat-of (s/lit [:operand]) %) (fn [r] [:operand r])]\n102\t   [:depth-3 #(nest 3 %) (fn [r] [3 [2 [1 r]]])]\n103\t   [:captured #(s/let1 'k (s/lit :captured)\n104\t                       (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n105\t                               (s/app (s/v 'f) (s/lit :arg))))\n106\t    (fn [r] [:captured :arg r])]])\n107\t\n108\t\n109\t(defn with-stream\n110\t  [body]\n111\t  (s/let1 's {:type :stream/make :buffer 4} (s/let1 'c (s/cursor-of (s/v 's)) body)))\n112\t\n113\t\n114\t(defn tail\n115\t  [ast]\n116\t  (assoc ast :tail? true))\n117\t\n118\t\n119\t(defn normalize\n120\t  [x]\n121\t  (cond\n122\t    (values/continuation? x) :continuation\n123\t    (values/closure? x) :closure\n124\t    (vector? x) (mapv normalize x)\n125\t    (seq? x) (apply list (map normalize x))\n126\t    (set? x) (into #{} (map normalize) x)\n127\t    (map? x) (into {} (map (fn [[k v]] [(normalize k) (normalize v)])) x)\n128\t    :else x))\n129\t\n130\t\n131\t;; =============================================================================\n132\t;; The rows of §5.2: one builder each, answering the parked machine\n133\t;; =============================================================================\n134\t;;\n135\t;; A world: :machine, :kind, :reason (blocked rows), :steps (each followed by\n136\t;; a drive) or :resume, :finish (records the effect trace), :trace, and\n137\t;; :receiver (fresh opts and a finish for the receiver's own composition).\n138\t\n139\t(defn reader\n140\t  \"A reader parked on (next-of c); :pre values are appended and the\n141\t   machine re-run first.\"\n142\t  ([wrap op] (reader wrap op [] \"B\" {}))\n143\t  ([wrap op pre value opts]\n144\t   (let [m0 (vm/run (load-program (machine opts) (with-stream (with-cat (wrap op)))))\n145\t         src (s/stream-of m0)\n146\t         m (reduce (fn [m x] (stream/append! src x) (vm/run m)) m0 pre)]\n147\t     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src value)] :trace (atom [])})))\n148\t\n149\t\n150\t(defn writer\n151\t  [wrap]\n152\t  (let [trace (atom [])\n153\t        w (support/one-slot-stream \"w\")\n154\t        _ (stream/append! w :warmed)\n155\t        m0 (load-program (machine) (with-cat (wrap {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")})))\n156\t        [ref m1] (engine/attach-resource m0 w)\n157\t        take! #(swap! trace conj (:dao.stream/value (stream/next w 0)))]\n158\t    {:machine (vm/run (assoc m1 :store {'w ref})) :kind :blocked :reason :put :surfaces #{:reader :writer}\n159\t     :steps [take!] :finish take! :trace trace}))\n160\t\n161\t\n162\t(defn own-call-pair\n163\t  [trace]\n164\t  (let [own-in (s/ring 8) own-out (s/ring 8)]\n165\t    {:opts {:call-in own-in :call-out own-out :call-out-cursor (vm/mint-oldest own-out :test)}\n166\t     :finish #(swap! trace into (tu/drain own-in))}))\n167\t\n168\t\n169\t(defn caller\n170\t  [wrap call-in call-out]\n171\t  (vm/run (load-program (machine {:call-in call-in :call-out call-out\n172\t                                  :call-out-cursor (vm/mint-oldest call-out :test)})\n173\t                        (with-cat (wrap (s/call-node :op/echo \"hello\"))))))\n174\t\n175\t\n176\t(defn sent-ffi\n177\t  [wrap]\n178\t  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n179\t        m (caller wrap call-in call-out)\n180\t        id (ffi/response-call-id (first (:wait-set m)))]\n181\t    {:machine m :kind :blocked :reason :ffi :call-id id\n182\t     :steps [#(stream/append! call-out (apply2/success-response id \"echo!\"))]\n183\t     :finish #(swap! trace into (tu/drain call-in))\n184\t     :receiver #(own-call-pair trace) :trace trace}))\n185\t\n186\t\n187\t(defn retained-ffi\n188\t  [wrap]\n189\t  (let [trace (atom []) call-in (support/one-slot-stream \"call-in\") call-out (s/ring 8)\n190\t        _ (stream/append! call-in :warmed)\n191\t        m (caller wrap call-in call-out)\n192\t        id (ffi/request-call-id (first (:wait-set m)))]\n193\t    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n194\t     :steps [#(stream/next call-in 0)\n195\t             (fn []\n196\t               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n197\t               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n198\t     :receiver #(own-call-pair trace) :trace trace}))\n199\t\n200\t\n201\t(defn module-response\n202\t  [body exports]\n203\t  {:status :ok :image {:value (project body)}\n204\t   :manifest {:yin.module/name 'host.mod :yin.module/exports exports} :obligations []})\n205\t\n206\t\n207\t(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n208\t\n209\t\n210\t(def blocking-body\n211\t  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n212\t   binding holds the stream, so f's E does not capture it.\"\n213\t  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n214\t\n215\t\n216\t(defn require-op\n217\t  [tail?]\n218\t  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n219\t    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n220\t\n221\t\n222\t(defn link-receiver\n223\t  [trace]\n224\t  (fn []\n225\t    (let [rq (s/ring 64)]\n226\t      {:opts {:link-request rq :link-response (s/ring 64)} :finish #(swap! trace into (tu/drain rq))})))\n227\t\n228\t\n229\t(defn linking\n230\t  \"A require parked in :link-response (or :link-request behind a full,\n231\t   warmed request stream when retained?).\"\n232\t  [wrap tail? retained?]\n233\t  (let [trace (atom [])\n234\t        request (if retained? (support/one-slot-stream \"link-request\") (s/ring 64))\n235\t        response (s/ring 64)\n236\t        _ (when retained? (stream/append! request :warmed))\n237\t        m (vm/run (load-program (machine {:link-request request :link-response response})\n238\t                                (with-cat (wrap (require-op tail?)))))\n239\t        id (:link-id (first (:wait-set m)))\n240\t        answer! #(stream/append! response (assoc (module-response plain-body #{'f}) :yin.link/id id))]\n241\t    {:machine m :kind :blocked :reason (if retained? :link-request :link-response)\n242\t     :surfaces #{:reader :writer} :trace trace\n243\t     :steps (if retained? [#(stream/next request 0) answer!] [answer!])\n244\t     :finish (if retained?\n245\t               #(swap! trace conj (:dao.stream/value (stream/next request 0)))\n246\t               #(swap! trace into (tu/drain request)))\n247\t     :receiver (link-receiver trace)}))\n248\t\n249\t\n250\t(defn installing\n251\t  \"A require parked on :install beside its blocked child.\"\n252\t  [wrap tail? phase]\n253\t  (let [trace (atom [])\n254\t        request (s/ring 64) response (s/ring 64)\n255\t        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n256\t                                 (with-cat (wrap (require-op tail?)))))\n257\t        id (:link-id (first (:wait-set m0)))\n258\t        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n259\t        m1 (vm/run m0)\n260\t        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n261\t        child (get-in m [:installs 'host.mod :vm])\n262\t        child-stream (s/stream-of child)]\n263\t    {:machine m :kind :blocked :reason :install :trace trace\n264\t     :steps [#(stream/append! child-stream :fed)]\n265\t     :finish #(swap! trace into (tu/drain request))\n266\t     :receiver (link-receiver trace)}))\n267\t\n268\t\n269\t(defn module-context\n270\t  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n271\t  [wrap]\n272\t  (let [request (s/ring 64) response (s/ring 64)\n273\t        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n274\t        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n275\t                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n276\t                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n277\t        id (:link-id (first (:wait-set m0)))\n278\t        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n279\t        m (vm/run m0)\n280\t        src (s/stream-of m)]\n281\t    ;; The carrier holds module stores, not registry entries: the receiver's\n282\t    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n283\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n284\t     :receiver (constantly {:opts {:modules (:modules m)}})}))\n285\t\n286\t\n287\t(defn run-beside\n288\t  [m ast]\n289\t  (vm/run (load-program m ast)))\n290\t\n291\t\n292\t(defn parking\n293\t  [m]\n294\t  (let [pid (:id (vm/value m))]\n295\t    {:machine m :kind :parked :pid pid :trace (atom [])\n296\t     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n297\t\n298\t\n299\t(defn module-store-cursors\n300\t  \"An explicit park whose module store holds two cursor references nothing\n301\t   else reaches, named by a module closure in the task store.\"\n302\t  [wrap]\n303\t  (let [ring (s/ring 4)\n304\t        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n305\t        cursor (fn [m]\n306\t                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n307\t                   (engine/handle-cursor m {:stream ref} id)))\n308\t        [c1 m] (cursor m)\n309\t        [c2 m] (cursor m)\n310\t        [seg image] (first (:code m))\n311\t        closure (first (filter #(= :closure (first %)) (:vector image)))\n312\t        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n313\t                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n314\t    (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n315\t\n316\t\n317\t(defn free-env-world\n318\t  [wrap env]\n319\t  (reader wrap (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) (s/next-of (s/v 'c)))) (s/lit 1)))\n320\t          [] \"B\" {:env env}))\n321\t\n322\t\n323\t(def read-op (s/next-of (s/v 'c)))\n324\t\n325\t\n326\t(def capture {:type :vm/current-continuation})\n327\t\n328\t\n329\t(def rows\n330\t  \"[row bare-result build]: rows 1-19, 21, 22, 24 of §5.2. A nil result\n331\t   compares with the reference only.\"\n332\t  [[1 [\"A\" \"B\"] #(reader % (s/let1 'a read-op (cat-of (cat-of (s/lit []) (s/v 'a)) read-op)) [\"A\"] \"B\" {})]\n333\t   [2 nil writer]\n334\t   [3 \"echo!\" sent-ffi]\n335\t   [4 \"echo!\" retained-ffi]\n336\t   [5 [:ordinary \"B\"] #(reader % (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c))))]\n337\t   [6 \"B\" #(reader % (s/app (s/lam ['u] (tail (s/app (s/v 'stream/next!) (s/v 'c)))) (s/lit 0)))]\n338\t   [7 'host.mod #(linking % false true)]\n339\t   [8 'host.mod #(linking % false false)]\n340\t   [9 'host.mod #(linking % true false)]\n341\t   [10 'host.mod #(installing % false nil)]\n342\t   [11 'host.mod #(installing % false :running)]\n343\t   [12 'host.mod #(installing % true nil)]\n344\t   [13 \"back\" #(parking (vm/run (load-program (machine) (with-cat (% {:type :vm/park})))))]\n345\t   [14 [:continuation \"B\"] #(reader % (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read-op)))]\n346\t   [15 :done #(reader % (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n347\t                                            :consequent (s/lit :done)\n348\t                                            :alternate (s/let1 'r read-op (s/app (s/v 'k) (s/lit :second)))})\n349\t                      [] \"x\" {})]\n350\t   [16 [:continuation :continuation \"B\"]\n351\t    #(reader % (s/let1 'k1 capture (s/let1 'k2 capture (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read-op))))]\n352\t   [17 \"B\" module-context]\n353\t   [18 \"back\" module-store-cursors]\n354\t   [19 42 #(let [m (vm/run (load-program (machine) (with-cat (% (s/lit 42)))))]\n355\t             {:machine m :kind :halted :trace (atom [])})]\n356\t   [21 99 #(free-env-world % {'x 99})]\n357\t   [22 [nil \"B\"] #(reader % (s/let1 'pair (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n358\t                                    (s/app (s/v 'pair) (s/lit nil) read-op)))]\n359\t   [24 \"echo!\" sent-ffi]])\n360\t\n361\t\n362\t(defn tail-effect-halt\n363\t  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n364\t   call (stream/next! c) with an empty K.\"\n365\t  []\n366\t  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n367\t                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n368\t        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n369\t        src (s/stream-of m)]\n370\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n371\t\n372\t\n373\t;; =============================================================================\n374\t;; The two runs\n375\t;; =============================================================================\n376\t\n377\t(defn drive-local\n378\t  [m]\n379\t  (loop [m (vm/run m) n 12]\n380\t    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n381\t\n382\t\n383\t(defn drive-peers\n384\t  [m peers]\n385\t  (loop [m (vm/run m) n 12]\n386\t    (if (or (not (vm/blocked? m)) (zero? n))\n387\t      m\n388\t      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n389\t\n390\t\n391\t(defn satisfy\n392\t  [world m drive]\n393\t  (if-let [resume (:resume world)]\n394\t    (resume m)\n395\t    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n396\t\n397\t\n398\t(defn reference\n399\t  [world]\n400\t  (let [done (satisfy world (:machine world) drive-local)]\n401\t    (when-let [f (:finish world)] (f))\n402\t    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n403\t\n404\t\n405\t(defn served\n406\t  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n407\t  [surfaces]\n408\t  (let [t (s/toy) peer (s/served-peer t)]\n409\t    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n410\t\n411\t\n412\t(defn recording-attacher\n413\t  \"The receiver's attach!, counting attaches and recording each\n414\t   reflection's source identity.\"\n415\t  [t]\n416\t  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n417\t    {:attach! (fn [d]\n418\t                (swap! n inc)\n419\t                (let [r (base d)]\n420\t                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n421\t                  r))\n422\t     :origin origin :count n}))\n423\t\n424\t\n425\t(defn handed-off\n426\t  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n427\t   the source's streams.\"\n428\t  [world]\n429\t  (let [surfaces (or (:surfaces world) #{:reader})\n430\t        {:keys [toy peer serve!]} (served surfaces)\n431\t        wire (rows/lift-task (:machine world) serve! (lift-opts))\n432\t        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n433\t        receiver ((or (:receiver world) (constantly nil)))\n434\t        {:keys [attach! origin]} (recording-attacher toy)\n435\t        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n436\t        again (served surfaces)\n437\t        relift (rows/lift-task recv (:serve! again) (lift-opts))\n438\t        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n439\t        done (satisfy world recv #(drive-peers % [peer]))\n440\t        _ (s/serve-mirror! peer)]\n441\t    (when-let [f (:finish world)] (f))\n442\t    (when-let [f (:finish receiver)] (f))\n443\t    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2\n444\t     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n445\t\n446\t\n447\t(defn root-task\n448\t  [wire]\n449\t  (rows/decode wire))\n450\t\n451\t\n452\t(defn slot\n453\t  [task i]\n454\t  (nth (:slots task) i))\n455\t\n456\t\n457\t(defn first-pending\n458\t  [task]\n459\t  (second (:slots (first (slot task 13)))))\n460\t\n461\t\n462\t(defn laws\n463\t  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n464\t  [world expected]\n465\t  (let [{:keys [wire relift corr corr2] :as got} (handed-off world)\n466\t        task (root-task wire)]\n467\t    (is (= (:kind world) (slot task 2)))\n468\t    (when (= :blocked (:kind world))\n469\t      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n470\t    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n471\t    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n472\t        \"law 2: lift(lower(S)) = S by root id\")\n473\t    (is (:halted expected) \"the reference run completes\")\n474\t    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n475\t        \"law 1: result and effect trace equal the reference\")\n476\t    got))\n477\t\n478\t\n479\t(defn matrix-cases\n480\t  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n481\t  []\n482\t  (conj (into [] (mapcat (fn [[n r build]]\n483\t                           (mapv (fn [[label wrap expected-of]]\n484\t                                   ;; nest's own parameter is x: under :depth-3,\n485\t                                   ;; row 21's (fn [] x) closes over the wrapper's\n486\t                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n487\t                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n488\t                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n489\t                                 segments)))\n490\t              rows)\n491\t        [20 :unwrapped \"B\" tail-effect-halt]))\n492\t\n493\t\n494\t(defn bare\n495\t  [n]\n496\t  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n497\t    (build identity)))\n498\t\n499\t\n500\t;; =============================================================================\n501\t;; Acceptance 1: 89 runs\n502\t;; =============================================================================\n503\t\n504\t(deftest ^:slow every-row-every-segment-matches-the-reference\n505\t  (slow/guard\n506\t    \"every-row-every-segment-matches-the-reference\"\n507\t    (fn []\n508\t      (let [cases (matrix-cases) runs (atom 0)]\n509\t        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n510\t        (doseq [[n label expected build] cases]\n511\t          (testing (str \"row \" n \" \" (name label))\n512\t            (let [ref (reference (build))]\n513\t              (when (some? expected)\n514\t                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n515\t              (laws (build) ref)\n516\t              (swap! runs inc))))\n517\t        (is (= 89 @runs))))))\n518\t\n519\t\n520\t(deftest bare-rows-match-the-reference\n521\t  ;; The quick-tier slice of acceptance 1: every row once, bare.\n522\t  (doseq [[n r build] rows]\n523\t    (testing (str \"row \" n)\n524\t      (let [ref (reference (build identity))]\n525\t        (when (some? r) (is (= r (:value ref))))\n526\t        (laws (build identity) ref)))))\n527\t\n528\t\n529\t;; =============================================================================\n530\t;; Acceptance 2-6\n531\t;; =============================================================================\n532\t\n533\t(defn wait-state\n534\t  [wire]\n535\t  (first (:slots (first (slot (root-task wire) 13)))))\n536\t\n537\t\n538\t(deftest tail-states-carry-no-window\n539\t  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n540\t    (testing (str \"row \" label)\n541\t      (let [{:keys [serve!]} (served #{:reader :writer})\n542\t            wire (rows/lift-task (:machine world) serve! (lift-opts))\n543\t            state (wait-state wire)\n544\t            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n545\t        (is (= :tail (:kind state)))\n546\t        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n547\t        (is (= 5 (count row)) \"[id :tail A site k]\")\n548\t        (is (not-any? #(= :window (second %))\n549\t                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n550\t        (let [entry (first (:wait-set (:machine world)))]\n551\t          (is (= {:deliver :return} (:deliver entry)))\n552\t          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n553\t\n554\t\n555\t(deftest tail-states-lower-to-through-k-delivery\n556\t  (doseq [n [6 9 12]]\n557\t    (testing (str \"row \" n)\n558\t      (let [ref (reference (bare n))\n559\t            {:keys [recv] :as got} (laws (bare n) ref)\n560\t            entry (first (:wait-set recv))]\n561\t        (is (= {:deliver :return} (:deliver entry)))\n562\t        (is (contains? entry :site))\n563\t        (is (not-any? #(contains? entry %) [:window :env :pc]) \"the lowered tail carries no window\")\n564\t        (is (= (:value ref) (:value got))))))\n565\t  (let [ref (reference (tail-effect-halt))\n566\t        {:keys [recv] :as got} (laws (tail-effect-halt) ref)]\n567\t    (is (= [] (:k (first (:wait-set recv)))) \"row 20: an empty K\")\n568\t    (is (= \"B\" (:value got)) \"a tail effect with no frame to pop halts with the value\")))\n569\t\n570\t\n571\t(deftest install-rows-carry-the-child\n572\t  (doseq [[n phase] [[10 :parked] [11 :running] [12 :parked]]]\n573\t    (testing (str \"row \" n)\n574\t      (let [world (bare n)\n575\t            {:keys [serve! toy]} (served #{:reader})\n576\t            wire (rows/lift-task (:machine world) serve! (lift-opts))\n577\t            [install] (slot (root-task wire) 12)\n578\t            [mn carried-phase _ _ child] (:slots install)\n579\t            recv (rows/lower-task (machine {:attach-stream (s/attacher toy)}) wire (s/attacher toy))\n580\t            inst (get-in recv [:installs 'host.mod])\n581\t            lowered (:vm inst)]\n582\t        (is (= 'host.mod mn))\n583\t        (is (= phase carried-phase) \"the child's phase as the source held it\")\n584\t        (is (= :blocked (slot child 2)) \"the child's kind\")\n585\t        (is (= :child (slot child 3)))\n586\t        (is (= [:install 'host.mod] (:slots (first-pending (root-task wire)))))\n587\t        (is (= phase (:phase inst)))\n588\t        (is (nil? (:control lowered)) \"no initialization on lower: nothing runs\")\n589\t        (is (= [:next] (mapv :reason (:wait-set lowered))) \"the child waits where it was lifted\")\n590\t        (is (vm/blocked? lowered))\n591\t        (is (= (count (slot child 11)) (count (:code-aliases lowered))) \"the child's code by A\")))))\n592\t\n593\t\n594\t(deftest captures\n595\t  (doseq [n [14 15 16]]\n596\t    (testing (str \"row \" n)\n597\t      (let [ref (reference (bare n))]\n598\t        (laws (bare n) ref))))\n599\t  (let [world (bare 15)\n600\t        {:keys [recv] :as got} (laws world (reference (bare 15)))\n601\t        entry (first (:wait-set recv))\n602\t        k (get-in entry [:env 'k])\n603\t        p (values/payload k)]\n604\t    (is (values/continuation? k) \"the capture travels in the closure's E\")\n605\t    (is (not (contains? (:window p) (get-in p [:deliver :rd]))) \"nothing is delivered into the captured rd on lower\")\n606\t    (is (= :done (:value got)) \"the invocation after lower delivers once and re-enters\")))\n607\t\n608\t\n609\t(deftest free-env-shadowing\n610\t  (let [ref (reference (bare 21))\n611\t        got (laws (bare 21) ref)]\n612\t    (is (= 99 (:value got)) \"the lowered f resolves x through the carried free environment\"))\n613\t  (testing \"the explicit :free-env overrides the kernel's retained field\"\n614\t    (let [world (bare 21)\n615\t          m (assoc (:machine world) :free-env {'x 5})\n616\t          {:keys [serve! toy]} (served #{:reader})]\n617\t      (is (= :inconsistent-state (:yin.k/kind (error #(rows/lift-task m serve! (lift-opts)))))\n618\t          \"a free environment no E agrees with is refused\")\n619\t      (let [wire (rows/lift-task m serve! (assoc (lift-opts) :free-env {'x 99}))\n620\t            free (slot (root-task wire) 5)\n621\t            {:keys [attach!]} (recording-attacher toy)\n622\t            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)]\n623\t        (is (= ['x [:lit 99]] (:slots free)))\n624\t        (is (= {'x 99} (:free-env recv)))\n625\t        (is (= {'x 99} (:env recv))))))\n626\t  (testing \"neither the argument nor the kernel field: :missing-free-env\"\n627\t    (let [m (assoc (:machine (bare 21)) :free-env nil)\n628\t          d (error #(rows/lift-task m (:serve! (served #{:reader})) (lift-opts)))]\n629\t      (is (= [:yin.k/non-portable :missing-free-env] [(:yin.k/status d) (:yin.k/kind d)])))))\n630\t\n631\t\n632\t(deftest module-store-snapshot\n633\t  (let [{:keys [wire recv]} (laws (bare 18) (reference (bare 18)))\n634\t        task (root-task wire)\n635\t        {:strs [c d]} (into {} (map (fn [[k v]] [(name k) v])) (get-in recv [:module-stores 'host.mod]))]\n636\t    (is (= 1 (count (slot task 7))) \"one :module-store row\")\n637\t    (is (= 2 (quot (count (:slots (slot task 9))) 2)) \"two cursor cells\")\n638\t    (is (= :cursor-ref (:type c) (:type d)))\n639\t    (is (not= (:id c) (:id d)) \"the two cursor cells stay two\")\n640\t    (is (= :closure (normalize (get-in recv [:store 'mod]))))))\n641\t\n642\t\n643\t(deftest synthetic-tail-bookkeeping\n644\t  ;; Row 23: a hand-built parked tail; no primitive returns an FFI effect\n645\t  ;; through a tail :call today, so it is judged by frame/defect only.\n646\t  (let [m (:machine (bare 6))\n647\t        entry (first (:wait-set m))\n648\t        f (dissoc (ft/canonical m entry false) :yin.k/pending)\n649\t        code-map (ft/machine-code m)\n650\t        v (get code-map (:yin.k/segment f))\n651\t        non-tail (first (keep-indexed (fn [pc t] (when (and (= :call (first t)) (false? (nth t 4))) pc)) v))\n652\t        ctx {:free-env {} :ffi-call-ids #{:call-7} :parked-key :call-7}]\n653\t    (is (= :tail (:yin.k/state f)))\n654\t    (is (nil? (frame/defect f code-map :parked ctx)) \"a tail record under a live FFI call id\")\n655\t    (is (= :parked-site (:yin.k/kind (frame/defect f code-map :parked (assoc ctx :parked-key :call-8))))\n656\t        \"the same record under a key absent from :ffi-call-ids\")\n657\t    (is (some? non-tail))\n658\t    (is (= :site (:yin.k/kind (frame/defect (assoc f :yin.k/site non-tail) code-map :parked ctx)))\n659\t        \"T1 runs before P4\")))\n660\t\n661\t\n662\t;; =============================================================================\n663\t;; Acceptance 7: refusals, before any attachment\n664\t;; =============================================================================\n665\t\n666\t(defn update-at\n667\t  [x path f]\n668\t  (if (empty? path)\n669\t    (f x)\n670\t    (if (map? x)\n671\t      (update-in x [:slots (first path)] update-at (rest path) f)\n672\t      (update x (first path) update-at (rest path) f))))\n673\t\n674\t\n675\t(defn replace-nodes\n676\t  \"Every row node matching pred, anywhere under x, replaced by (f node).\"\n677\t  [x pred f]\n678\t  (cond\n679\t    (and (map? x) (contains? x :kind) (contains? x :slots))\n680\t    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n681\t    (vector? x) (mapv #(replace-nodes % pred f) x)\n682\t    :else x))\n683\t\n684\t\n685\t(defn replace-row\n686\t  \"The wire with row id's body replaced and every ancestor rehashed,\n687\t   without canonicalizing slots: a tamper below the abstract emitter.\"\n688\t  [wire id body]\n689\t  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n690\t        memo (atom {})]\n691\t    (letfn [(rewrite\n692\t              [x]\n693\t              (cond\n694\t                (contains? index x)\n695\t                (or (get @memo x)\n696\t                    (let [b (mapv rewrite (if (= x id) body (subvec (get index x) 1)))\n697\t                          nid (jing/segment-key b)]\n698\t                      (swap! memo assoc x nid)\n699\t                      nid))\n700\t                (vector? x) (mapv rewrite x)\n701\t                :else x))]\n702\t      (let [root (rewrite (:yin.k/root wire))\n703\t            rs (mapv (fn [[old nid]]\n704\t                       (into [nid] (mapv rewrite (if (= old id) body (subvec (get index old) 1)))))\n705\t                     @memo)]\n706\t        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n707\t\n708\t\n709\t(defn pairs-of\n710\t  [n]\n711\t  (mapv vec (partition 2 (:slots n))))\n712\t\n713\t\n714\t(defn rebuild\n715\t  [n f]\n716\t  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n717\t\n718\t\n719\t(defn lowered\n720\t  \"Lower wire into a fresh receiver: [outcome attaches].\"\n721\t  [toy wire]\n722\t  (let [{:keys [attach!] n :count} (recording-attacher toy)\n723\t        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n724\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n725\t    [r @n]))\n726\t\n727\t\n728\t(defn free-register\n729\t  \"A register of the act's body that is neither in its window nor its rd.\"\n730\t  [task act]\n731\t  (let [[a pc _ w _ rd] (:slots act)\n732\t        v (get (slot task 11) a)\n733\t        bodies (code/parse v)\n734\t        k (:registers (nth bodies (code/body-index bodies pc)))\n735\t        taken (into #{rd} (map first) (pairs-of w))]\n736\t    (first (remove taken (range k)))))\n737\t\n738\t\n739\t(def wait-act [13 0 0])\n740\t\n741\t\n742\t(defn tamper-cases\n743\t  []\n744\t  (let [act-of (fn [task] (get-in task [:slots 13 0 :slots 0]))]\n745\t    [[\"window with an extra live key\" 1 :window-extra\n746\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (conj ps [(free-register task (act-of task)) [:lit :x]])))))]\n747\t     [\"a live key removed\" 1 :window-missing\n748\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (rest ps))))))]\n749\t     [\"rd added\" 1 :window-self\n750\t      (fn [task]\n751\t        (update-at task (conj wait-act 3)\n752\t                   #(rebuild % (fn [ps] (conj ps [(nth (:slots (act-of task)) 5) [:lit :x]])))))]\n753\t     [\"rd replaced by another register\" 1 :destination\n754\t      (fn [task] (update-at task (conj wait-act 5) inc))]\n755\t     [\"a reason the site does not admit\" 1 :reason-mismatch\n756\t      (fn [task] (update-at task [13 0 1] (constantly (rows/node :pending [:install 'bogus]))))]\n757\t     [\"the [:lit nil] of row 22 dropped\" 22 :window-missing\n758\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (remove (fn [[_ v]] (= [:lit nil] v)) ps))))))]\n759\t     [\"a :reified act whose pc-1 is not a capture\" 14 :captured-site\n760\t      (fn [task]\n761\t        (let [act (act-of task)]\n762\t          (replace-nodes task #(= :reified (:kind %)) (constantly (rows/node :reified [act])))))]\n763\t     [\"a parked act whose pc-1 is not :park\" 1 :parked-site\n764\t      (fn [task] (update-at task [8] (constantly (rows/node :parked-table [:bogus (act-of task)]))))]\n765\t     [\"the root free-env row given a reserved key\" 1 :reserved-name\n766\t      (fn [task] (update-at task [5] #(rebuild % (fn [ps] (conj ps ['yin/def [:lit 1]])))))]]))\n767\t\n768\t\n769\t(defn return-site-case\n770\t  \"A return frame's pc moved after a tail call (K1); falls back to a pc\n771\t   after any non-call when no tail call has a successor in its body.\"\n772\t  [task]\n773\t  (let [kpath [13 0 0 2 0]\n774\t        kf (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0])\n775\t        [a] (:slots kf)\n776\t        v (get (slot task 11) a)\n777\t        bodies (code/parse v)\n778\t        same-body? (fn [p] (= (code/body-index bodies (dec p)) (code/body-index bodies p)))\n779\t        tail-call? (fn [t] (and (= :call (first t)) (true? (nth t 4))))\n780\t        after-tail (first (filter #(and (tail-call? (nth v (dec %))) (same-body? %)) (range 1 (count v))))\n781\t        after-other (first (filter #(and (not= :call (first (nth v (dec %)))) (same-body? %)) (range 1 (count v))))]\n782\t    [(if after-tail :after-tail-call :after-non-call)\n783\t     (update-at task (conj kpath 1) (constantly (or after-tail after-other)))]))\n784\t\n785\t\n786\t(defn lift-bare\n787\t  [n]\n788\t  (let [world (bare n)\n789\t        {:keys [serve! toy]} (served #{:reader :writer})]\n790\t    [toy (rows/lift-task (:machine world) serve! (lift-opts))]))\n791\t\n792\t\n793\t(deftest refusals\n794\t  (doseq [[label n kind tamper] (tamper-cases)]\n795\t    (testing label\n796\t      (let [[toy wire] (lift-bare n)\n797\t            [r attaches] (lowered toy (rows/emit-numbered (tamper (root-task wire)) {}))]\n798\t        (is (= [:yin.k/undecodable kind] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n799\t        (is (zero? attaches) \"refused before any attachment\"))))\n800\t  (testing \"a segment with no tree association (§6.1): unsatisfied, before any attachment\"\n801\t    (let [[toy wire] (lift-bare 1)\n802\t          task (update-at (root-task wire) [10] #(assoc % :yin.k/trees {}))\n803\t          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n804\t      (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n805\t      (is (= :incomplete (:yin.k/discovery r)))\n806\t      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))\n807\t      (is (zero? attaches)))\n808\t    (let [world (bare 1)\n809\t          d (error #(rows/lift-task (:machine world) (:serve! (served #{:reader})) {:source-index {}}))]\n810\t      (is (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)]) \"the lift refuses it too\")))\n811\t  (testing \"a return frame's pc moved after a tail call\"\n812\t    (let [[toy wire] (lift-bare 6)\n813\t          [how task] (return-site-case (root-task wire))\n814\t          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n815\t      (is (= :after-tail-call how))\n816\t      (is (= [:yin.k/undecodable :return-site] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n817\t      (is (zero? attaches))))\n818\t  (testing \"a :tail row given a fourth slot is refused at structure, before frames\"\n819\t    (let [[toy wire] (lift-bare 6)\n820\t          [id & body] (first (filter #(= :tail (second %)) (:yin.k/rows wire)))\n821\t          [r attaches] (lowered toy (replace-row wire id (conj (vec body) 0)))]\n822\t      (is (= :yin.k/undecodable (:yin.k/status r)))\n823\t      (is (= :row-shape (:yin.k/kind r)) \"the codec's structure step (2) runs before the frames step (7)\")\n824\t      (is (zero? attaches))))\n825\t  (testing \"E2 over row 21 with the free environment {x 99 y 7}\"\n826\t    (let [world (free-env-world identity {'x 99 'y 7})\n827\t          {:keys [serve! toy]} (served #{:reader})\n828\t          wire (rows/lift-task (:machine world) serve! (lift-opts))\n829\t          task (root-task wire)\n830\t          env-path (conj wait-act 2 0)\n831\t          edit (fn [f] (rows/emit-numbered (update-at task env-path #(rebuild % (fn [ps] (f (into {} ps))))) {}))]\n832\t      (is (= [:lit 1] (second (first (filter #(= 'x (first %)) (pairs-of (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0]))))))\n833\t          \"the lexical x is 1 at the read\")\n834\t      (doseq [[label f] [[\"the unshadowed y changed\" #(assoc % 'y [:lit 8])]\n835\t                         [\"the lexical x removed\" #(dissoc % 'x)]]]\n836\t        (testing label\n837\t          (let [[r attaches] (lowered toy (edit f))]\n838\t            (is (= [:yin.k/undecodable :free-env-mismatch] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n839\t            (is (zero? attaches)))))\n840\t      (testing \"the lexical x changed trips nothing\"\n841\t        (let [[r] (lowered toy (edit #(assoc % 'x [:lit 98])))]\n842\t          (is (vm/blocked? r) (pr-str r))))))\n843\t  (testing \"lift refusals, before any stream is served\"\n844\t    (let [counting (fn []\n845\t                     (let [n (atom 0) {:keys [serve!]} (served #{:reader})]\n846\t                       [(fn [h] (swap! n inc) (serve! h)) n]))\n847\t          stepped (vm/step (load-program (machine) (s/lit 42)))\n848\t          m0 (load-program (machine) (s/app (s/v 'stream/poll!) (s/v 'c)))\n849\t          [sref m1] (engine/attach-resource m0 (s/ring 8))\n850\t          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n851\t          held (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))]\n852\t      (is (= [:observe] (mapv :reason (:wait-set held))))\n853\t      (doseq [[label m status kind] [[\"not at a safepoint\" stepped :yin.k/not-at-safepoint nil]\n854\t                                     [\"a held :observe\" held :yin.k/non-portable :reason-mismatch]]]\n855\t        (testing label\n856\t          (let [[serve! n] (counting)\n857\t                d (error #(rows/lift-task m serve! (lift-opts)))]\n858\t            (is (= status (:yin.k/status d)) (pr-str d))\n859\t            (is (= kind (:yin.k/kind d)))\n860\t            (is (zero? @n))))))))\n861\t\n862\t\n863\t(deftest first-defect-order\n864\t  (let [[toy wire] (lift-bare 18)\n865\t        task (root-task wire)\n866\t        state-path [8 1]\n867\t        state (get-in task [:slots 8 :slots 1])\n868\t        ;; the park's window: rd added\n869\t        tampered (update-at task (conj state-path 3)\n870\t                            #(rebuild % (fn [ps] (conj ps [(nth (:slots state) 5) [:lit :x]]))))\n871\t        census (mapv first (pairs-of (slot task 9)))\n872\t        swapped (zipmap census (reverse census))]\n873\t    (is (= 2 (count census)))\n874\t    (is (= :window-self (:yin.k/kind (first (lowered toy (rows/emit-numbered tampered {}))))))\n875\t    (let [[r attaches] (lowered toy (rows/emit-numbered tampered swapped))]\n876\t      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n877\t      (is (zero? attaches)))))\n878\t\n879\t\n880\t;; =============================================================================\n881\t;; Acceptance 8: the two ported tests\n882\t;; =============================================================================\n883\t\n884\t(defn parked-reader\n885\t  []\n886\t  (let [m0 (vm/run (load-program (machine) (with-stream (s/then read-op read-op))))\n887\t        src (s/stream-of m0)]\n888\t    (stream/append! src \"A\")\n889\t    [(vm/run m0) src]))\n890\t\n891\t\n892\t(deftest a-nonempty-ready-queue-is-not-quiescent\n893\t  (let [[parked src] (parked-reader)\n894\t        _ (stream/append! src \"B\")\n895\t        woken (engine/check-wait-set parked)\n896\t        n (atom 0)\n897\t        {:keys [serve!]} (served #{:reader})\n898\t        d (error #(rows/lift-task woken (fn [h] (swap! n inc) (serve! h)) (lift-opts)))]\n899\t    (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n900\t    (is (= :yin.k/not-quiescent (:yin.k/status d)) (pr-str d))\n901\t    (is (zero? @n) \"no stream was served\")))\n902\t\n903\t\n904\t(defn two-callers\n905\t  []\n906\t  (let [call-in (s/ring 8) call-out (s/ring 8)\n907\t        m (vm/run (load-program (machine {:call-in call-in :call-out call-out\n908\t                                          :call-out-cursor (vm/mint-oldest call-out :test)})\n909\t                                (s/then (s/call-node :op/echo \"hello\") (s/call-node :op/echo \"world\"))))\n910\t        e1 (first (:wait-set m))]\n911\t    [(assoc m :wait-set [e1 (assoc e1 :call-id :parked-9)]) call-out (:call-id e1)]))\n912\t\n913\t\n914\t(defn answer-both!\n915\t  [call-out first-id]\n916\t  (stream/append! call-out (apply2/success-response :parked-9 \"second\"))\n917\t  (stream/append! call-out (apply2/success-response first-id \"first\")))\n918\t\n919\t\n920\t(defn sweep\n921\t  [m peers]\n922\t  (loop [m (engine/check-wait-set m) n 12]\n923\t    (if (or (zero? n) (empty? (:wait-set m)))\n924\t      m\n925\t      (do (run! s/serve-mirror! peers) (recur (engine/check-wait-set m) (dec n))))))\n926\t\n927\t\n928\t(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n929\t  (let [[ref-m ref-out id] (two-callers)\n930\t        _ (answer-both! ref-out id)\n931\t        expected (mapv :value (:ready-queue (sweep ref-m [])))\n932\t        [m call-out id] (two-callers)\n933\t        {:keys [serve! toy peer]} (served #{:reader})\n934\t        wire (rows/lift-task m serve! (lift-opts))\n935\t        task (root-task wire)\n936\t        pendings (mapv #(second (:slots %)) (slot task 13))\n937\t        own-out (s/ring 8)\n938\t        recv (rows/lower-task (machine {:attach-stream (s/attacher toy) :call-in (s/ring 8) :call-out own-out\n939\t                                        :call-out-cursor (vm/mint-oldest own-out :test)})\n940\t                              wire (s/attacher toy))\n941\t        [w1 w2] (:wait-set recv)\n942\t        _ (answer-both! call-out id)\n943\t        swept (sweep recv [peer])]\n944\t    (is (= [:ffi :ffi] (mapv #(first (:slots %)) pendings)))\n945\t    (is (= [id :parked-9] (mapv #(nth (:slots %) 2) pendings)))\n946\t    (is (= 1 (quot (count (:slots (slot task 9))) 2)) \"the two waiters name one cursor cell\")\n947\t    (is (= (nth (:slots (first pendings)) 1) (nth (:slots (second pendings)) 1)))\n948\t    (is (= (:cursor-ref w1) (:cursor-ref w2)) \"the lower gives both waiters one fresh cursor entry\")\n949\t    (is (= [(apply2/success-response :parked-9 \"second\") (apply2/success-response id \"first\")] expected))\n950\t    (is (empty? (:wait-set swept)))\n951\t    (is (= expected (mapv :value (:ready-queue swept)))\n952\t        \"the receiver wakes the same waiters with the same responses\")))\n953\t\n954\t\n955\t(deftest act-ffi-bookkeeping\n956\t  ;; Row 24: row 3's bookkeeping record travels in the parked table under\n957\t  ;; its call id, and the validator accepts it in context :parked.\n958\t  (let [world (bare 24)\n959\t        {:keys [serve!]} (served #{:reader})\n960\t        task (root-task (rows/lift-task (:machine world) serve! (lift-opts)))\n961\t        [p state] (:slots (slot task 8))]\n962\t    (is (= (:call-id world) p))\n963\t    (is (= :act (:kind state)))\n964\t    (is (= [:ffi (:call-id world)] [(first (:slots (first-pending task))) (nth (:slots (first-pending task)) 2)]))\n965\t    (is (nil? (rows/validate-frames task)))))\n966\t"}]},"parent_tool_use_id":null,"session_id":"195d2023-8c95-40ce-b61e-3288e37d4c05","uuid":"d34e1a01-7c18-4989-a715-3a9b3afc0ab6","timestamp":"2026-10-12T16:37:58.016Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"(ns yin.vm.semantic-register.safepoint-harness-test\n  \"Phase 6b: the safepoint harness on the :semantic-register lane\n   (docs/design/yin.vm.semantic-register-vm.continuation.md §5, §8.2).\n\n   Each row of the §5.2 matrix is built twice under each of the four\n   segment wrappers: the reference build is satisfied and run on its own\n   machine; the handoff build is lifted with rows/lift-task, lowered with\n   rows/lower-task into a fresh receiver over the toy channel, relifted at\n   once, then satisfied through the source's streams. Result and effect\n   trace equal the reference (law 1); the relift equals the lift by root\n   id under rows/canonical-under (law 2); the pending's reason is the\n   observed wait's (law 3); every lifted frame passes the validator\n   (law 6). Row 20 runs once, outside the wrappers.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.apply :as apply2]\n            [dao.test-slow :as slow]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.semantic-register :as sr]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.frame-test :as ft]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.ucf.lift-support :as support]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n;; =============================================================================\n;; The composition: code by A, the source index, one machine builder\n;; =============================================================================\n\n(def source-index\n  \"The composition's {A #{tree-address}} (§6.1): every vector this\n   harness projects is recorded beside the address of its AST.\"\n  (atom {}))\n\n\n(defn project\n  [ast]\n  (let [v (:vector (linearize/project ast))]\n    (swap! source-index update (jing/segment-key v) (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n    v))\n\n\n(def stream-modules (module/register-stream-module (module/default-registry)))\n\n\n(defn machine\n  ([] (machine {}))\n  ([opts]\n   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n                         :modules stream-modules}\n                        opts))))\n\n\n(defn load-program\n  [m ast]\n  (sr/load-vector m (project ast) code/contract))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n;; =============================================================================\n;; The corpus: four segments around one parking expression\n;; =============================================================================\n\n(defn cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn nest\n  [d op]\n  (if (zero? d) op (cat-of (s/lit [d]) (s/app (s/lam ['x] (nest (dec d) op)) (s/lit d)))))\n\n\n(def segments\n  \"[label wrap expected-of-bare-result] (§5.2).\"\n  [[:bare identity identity]\n   [:operand #(cat-of (s/lit [:operand]) %) (fn [r] [:operand r])]\n   [:depth-3 #(nest 3 %) (fn [r] [3 [2 [1 r]]])]\n   [:captured #(s/let1 'k (s/lit :captured)\n                       (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n                               (s/app (s/v 'f) (s/lit :arg))))\n    (fn [r] [:captured :arg r])]])\n\n\n(defn with-stream\n  [body]\n  (s/let1 's {:type :stream/make :buffer 4} (s/let1 'c (s/cursor-of (s/v 's)) body)))\n\n\n(defn tail\n  [ast]\n  (assoc ast :tail? true))\n\n\n(defn normalize\n  [x]\n  (cond\n    (values/continuation? x) :continuation\n    (values/closure? x) :closure\n    (vector? x) (mapv normalize x)\n    (seq? x) (apply list (map normalize x))\n    (set? x) (into #{} (map normalize) x)\n    (map? x) (into {} (map (fn [[k v]] [(normalize k) (normalize v)])) x)\n    :else x))\n\n\n;; =============================================================================\n;; The rows of §5.2: one builder each, answering the parked machine\n;; =============================================================================\n;;\n;; A world: :machine, :kind, :reason (blocked rows), :steps (each followed by\n;; a drive) or :resume, :finish (records the effect trace), :trace, and\n;; :receiver (fresh opts and a finish for the receiver's own composition).\n\n(defn reader\n  \"A reader parked on (next-of c); :pre values are appended and the\n   machine re-run first.\"\n  ([wrap op] (reader wrap op [] \"B\" {}))\n  ([wrap op pre value opts]\n   (let [m0 (vm/run (load-program (machine opts) (with-stream (with-cat (wrap op)))))\n         src (s/stream-of m0)\n         m (reduce (fn [m x] (stream/append! src x) (vm/run m)) m0 pre)]\n     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src value)] :trace (atom [])})))\n\n\n(defn writer\n  [wrap]\n  (let [trace (atom [])\n        w (support/one-slot-stream \"w\")\n        _ (stream/append! w :warmed)\n        m0 (load-program (machine) (with-cat (wrap {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")})))\n        [ref m1] (engine/attach-resource m0 w)\n        take! #(swap! trace conj (:dao.stream/value (stream/next w 0)))]\n    {:machine (vm/run (assoc m1 :store {'w ref})) :kind :blocked :reason :put :surfaces #{:reader :writer}\n     :steps [take!] :finish take! :trace trace}))\n\n\n(defn own-call-pair\n  [trace]\n  (let [own-in (s/ring 8) own-out (s/ring 8)]\n    {:opts {:call-in own-in :call-out own-out :call-out-cursor (vm/mint-oldest own-out :test)}\n     :finish #(swap! trace into (tu/drain own-in))}))\n\n\n(defn caller\n  [wrap call-in call-out]\n  (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                  :call-out-cursor (vm/mint-oldest call-out :test)})\n                        (with-cat (wrap (s/call-node :op/echo \"hello\"))))))\n\n\n(defn sent-ffi\n  [wrap]\n  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n        m (caller wrap call-in call-out)\n        id (ffi/response-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi :call-id id\n     :steps [#(stream/append! call-out (apply2/success-response id \"echo!\"))]\n     :finish #(swap! trace into (tu/drain call-in))\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn retained-ffi\n  [wrap]\n  (let [trace (atom []) call-in (support/one-slot-stream \"call-in\") call-out (s/ring 8)\n        _ (stream/append! call-in :warmed)\n        m (caller wrap call-in call-out)\n        id (ffi/request-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n     :steps [#(stream/next call-in 0)\n             (fn []\n               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn module-response\n  [body exports]\n  {:status :ok :image {:value (project body)}\n   :manifest {:yin.module/name 'host.mod :yin.module/exports exports} :obligations []})\n\n\n(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n\n\n(def blocking-body\n  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n   binding holds the stream, so f's E does not capture it.\"\n  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n\n\n(defn require-op\n  [tail?]\n  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n\n\n(defn link-receiver\n  [trace]\n  (fn []\n    (let [rq (s/ring 64)]\n      {:opts {:link-request rq :link-response (s/ring 64)} :finish #(swap! trace into (tu/drain rq))})))\n\n\n(defn linking\n  \"A require parked in :link-response (or :link-request behind a full,\n   warmed request stream when retained?).\"\n  [wrap tail? retained?]\n  (let [trace (atom [])\n        request (if retained? (support/one-slot-stream \"link-request\") (s/ring 64))\n        response (s/ring 64)\n        _ (when retained? (stream/append! request :warmed))\n        m (vm/run (load-program (machine {:link-request request :link-response response})\n                                (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m)))\n        answer! #(stream/append! response (assoc (module-response plain-body #{'f}) :yin.link/id id))]\n    {:machine m :kind :blocked :reason (if retained? :link-request :link-response)\n     :surfaces #{:reader :writer} :trace trace\n     :steps (if retained? [#(stream/next request 0) answer!] [answer!])\n     :finish (if retained?\n               #(swap! trace conj (:dao.stream/value (stream/next request 0)))\n               #(swap! trace into (tu/drain request)))\n     :receiver (link-receiver trace)}))\n\n\n(defn installing\n  \"A require parked on :install beside its blocked child.\"\n  [wrap tail? phase]\n  (let [trace (atom [])\n        request (s/ring 64) response (s/ring 64)\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n        m1 (vm/run m0)\n        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n        child (get-in m [:installs 'host.mod :vm])\n        child-stream (s/stream-of child)]\n    {:machine m :kind :blocked :reason :install :trace trace\n     :steps [#(stream/append! child-stream :fed)]\n     :finish #(swap! trace into (tu/drain request))\n     :receiver (link-receiver trace)}))\n\n\n(defn module-context\n  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n  [wrap]\n  (let [request (s/ring 64) response (s/ring 64)\n        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n        m (vm/run m0)\n        src (s/stream-of m)]\n    ;; The carrier holds module stores, not registry entries: the receiver's\n    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n     :receiver (constantly {:opts {:modules (:modules m)}})}))\n\n\n(defn run-beside\n  [m ast]\n  (vm/run (load-program m ast)))\n\n\n(defn parking\n  [m]\n  (let [pid (:id (vm/value m))]\n    {:machine m :kind :parked :pid pid :trace (atom [])\n     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n\n\n(defn module-store-cursors\n  \"An explicit park whose module store holds two cursor references nothing\n   else reaches, named by a module closure in the task store.\"\n  [wrap]\n  (let [ring (s/ring 4)\n        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n        cursor (fn [m]\n                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n                   (engine/handle-cursor m {:stream ref} id)))\n        [c1 m] (cursor m)\n        [c2 m] (cursor m)\n        [seg image] (first (:code m))\n        closure (first (filter #(= :closure (first %)) (:vector image)))\n        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n    (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n\n\n(defn free-env-world\n  [wrap env]\n  (reader wrap (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) (s/next-of (s/v 'c)))) (s/lit 1)))\n          [] \"B\" {:env env}))\n\n\n(def read-op (s/next-of (s/v 'c)))\n\n\n(def capture {:type :vm/current-continuation})\n\n\n(def rows\n  \"[row bare-result build]: rows 1-19, 21, 22, 24 of §5.2. A nil result\n   compares with the reference only.\"\n  [[1 [\"A\" \"B\"] #(reader % (s/let1 'a read-op (cat-of (cat-of (s/lit []) (s/v 'a)) read-op)) [\"A\"] \"B\" {})]\n   [2 nil writer]\n   [3 \"echo!\" sent-ffi]\n   [4 \"echo!\" retained-ffi]\n   [5 [:ordinary \"B\"] #(reader % (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c))))]\n   [6 \"B\" #(reader % (s/app (s/lam ['u] (tail (s/app (s/v 'stream/next!) (s/v 'c)))) (s/lit 0)))]\n   [7 'host.mod #(linking % false true)]\n   [8 'host.mod #(linking % false false)]\n   [9 'host.mod #(linking % true false)]\n   [10 'host.mod #(installing % false nil)]\n   [11 'host.mod #(installing % false :running)]\n   [12 'host.mod #(installing % true nil)]\n   [13 \"back\" #(parking (vm/run (load-program (machine) (with-cat (% {:type :vm/park})))))]\n   [14 [:continuation \"B\"] #(reader % (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read-op)))]\n   [15 :done #(reader % (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n                                            :consequent (s/lit :done)\n                                            :alternate (s/let1 'r read-op (s/app (s/v 'k) (s/lit :second)))})\n                      [] \"x\" {})]\n   [16 [:continuation :continuation \"B\"]\n    #(reader % (s/let1 'k1 capture (s/let1 'k2 capture (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read-op))))]\n   [17 \"B\" module-context]\n   [18 \"back\" module-store-cursors]\n   [19 42 #(let [m (vm/run (load-program (machine) (with-cat (% (s/lit 42)))))]\n             {:machine m :kind :halted :trace (atom [])})]\n   [21 99 #(free-env-world % {'x 99})]\n   [22 [nil \"B\"] #(reader % (s/let1 'pair (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n                                    (s/app (s/v 'pair) (s/lit nil) read-op)))]\n   [24 \"echo!\" sent-ffi]])\n\n\n(defn tail-effect-halt\n  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n   call (stream/next! c) with an empty K.\"\n  []\n  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n        src (s/stream-of m)]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n;; =============================================================================\n;; The two runs\n;; =============================================================================\n\n(defn drive-local\n  [m]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n\n\n(defn drive-peers\n  [m peers]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n))\n      m\n      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n\n\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin]} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n        again (served surfaces)\n        relift (rows/lift-task recv (:serve! again) (lift-opts))\n        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn root-task\n  [wire]\n  (rows/decode wire))\n\n\n(defn slot\n  [task i]\n  (nth (:slots task) i))\n\n\n(defn first-pending\n  [task]\n  (second (:slots (first (slot task 13)))))\n\n\n(defn laws\n  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n  [world expected]\n  (let [{:keys [wire relift corr corr2] :as got} (handed-off world)\n        task (root-task wire)]\n    (is (= (:kind world) (slot task 2)))\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n\n;; =============================================================================\n;; Acceptance 1: 89 runs\n;; =============================================================================\n\n(deftest ^:slow every-row-every-segment-matches-the-reference\n  (slow/guard\n    \"every-row-every-segment-matches-the-reference\"\n    (fn []\n      (let [cases (matrix-cases) runs (atom 0)]\n        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n        (doseq [[n label expected build] cases]\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (doseq [[n r build] rows]\n    (testing (str \"row \" n)\n      (let [ref (reference (build identity))]\n        (when (some? r) (is (= r (:value ref))))\n        (laws (build identity) ref)))))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n\n\n(deftest tail-states-carry-no-window\n  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n    (testing (str \"row \" label)\n      (let [{:keys [serve!]} (served #{:reader :writer})\n            wire (rows/lift-task (:machine world) serve! (lift-opts))\n            state (wait-state wire)\n            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n        (is (= :tail (:kind state)))\n        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n        (is (= 5 (count row)) \"[id :tail A site k]\")\n        (is (not-any? #(= :window (second %))\n                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n        (let [entry (first (:wait-set (:machine world)))]\n          (is (= {:deliver :return} (:deliver entry)))\n          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n\n\n(deftest tail-states-lower-to-through-k-delivery\n  (doseq [n [6 9 12]]\n    (testing (str \"row \" n)\n      (let [ref (reference (bare n))\n            {:keys [recv] :as got} (laws (bare n) ref)\n            entry (first (:wait-set recv))]\n        (is (= {:deliver :return} (:deliver entry)))\n        (is (contains? entry :site))\n        (is (not-any? #(contains? entry %) [:window :env :pc]) \"the lowered tail carries no window\")\n        (is (= (:value ref) (:value got))))))\n  (let [ref (reference (tail-effect-halt))\n        {:keys [recv] :as got} (laws (tail-effect-halt) ref)]\n    (is (= [] (:k (first (:wait-set recv)))) \"row 20: an empty K\")\n    (is (= \"B\" (:value got)) \"a tail effect with no frame to pop halts with the value\")))\n\n\n(deftest install-rows-carry-the-child\n  (doseq [[n phase] [[10 :parked] [11 :running] [12 :parked]]]\n    (testing (str \"row \" n)\n      (let [world (bare n)\n            {:keys [serve! toy]} (served #{:reader})\n            wire (rows/lift-task (:machine world) serve! (lift-opts))\n            [install] (slot (root-task wire) 12)\n            [mn carried-phase _ _ child] (:slots install)\n            recv (rows/lower-task (machine {:attach-stream (s/attacher toy)}) wire (s/attacher toy))\n            inst (get-in recv [:installs 'host.mod])\n            lowered (:vm inst)]\n        (is (= 'host.mod mn))\n        (is (= phase carried-phase) \"the child's phase as the source held it\")\n        (is (= :blocked (slot child 2)) \"the child's kind\")\n        (is (= :child (slot child 3)))\n        (is (= [:install 'host.mod] (:slots (first-pending (root-task wire)))))\n        (is (= phase (:phase inst)))\n        (is (nil? (:control lowered)) \"no initialization on lower: nothing runs\")\n        (is (= [:next] (mapv :reason (:wait-set lowered))) \"the child waits where it was lifted\")\n        (is (vm/blocked? lowered))\n        (is (= (count (slot child 11)) (count (:code-aliases lowered))) \"the child's code by A\")))))\n\n\n(deftest captures\n  (doseq [n [14 15 16]]\n    (testing (str \"row \" n)\n      (let [ref (reference (bare n))]\n        (laws (bare n) ref))))\n  (let [world (bare 15)\n        {:keys [recv] :as got} (laws world (reference (bare 15)))\n        entry (first (:wait-set recv))\n        k (get-in entry [:env 'k])\n        p (values/payload k)]\n    (is (values/continuation? k) \"the capture travels in the closure's E\")\n    (is (not (contains? (:window p) (get-in p [:deliver :rd]))) \"nothing is delivered into the captured rd on lower\")\n    (is (= :done (:value got)) \"the invocation after lower delivers once and re-enters\")))\n\n\n(deftest free-env-shadowing\n  (let [ref (reference (bare 21))\n        got (laws (bare 21) ref)]\n    (is (= 99 (:value got)) \"the lowered f resolves x through the carried free environment\"))\n  (testing \"the explicit :free-env overrides the kernel's retained field\"\n    (let [world (bare 21)\n          m (assoc (:machine world) :free-env {'x 5})\n          {:keys [serve! toy]} (served #{:reader})]\n      (is (= :inconsistent-state (:yin.k/kind (error #(rows/lift-task m serve! (lift-opts)))))\n          \"a free environment no E agrees with is refused\")\n      (let [wire (rows/lift-task m serve! (assoc (lift-opts) :free-env {'x 99}))\n            free (slot (root-task wire) 5)\n            {:keys [attach!]} (recording-attacher toy)\n            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)]\n        (is (= ['x [:lit 99]] (:slots free)))\n        (is (= {'x 99} (:free-env recv)))\n        (is (= {'x 99} (:env recv))))))\n  (testing \"neither the argument nor the kernel field: :missing-free-env\"\n    (let [m (assoc (:machine (bare 21)) :free-env nil)\n          d (error #(rows/lift-task m (:serve! (served #{:reader})) (lift-opts)))]\n      (is (= [:yin.k/non-portable :missing-free-env] [(:yin.k/status d) (:yin.k/kind d)])))))\n\n\n(deftest module-store-snapshot\n  (let [{:keys [wire recv]} (laws (bare 18) (reference (bare 18)))\n        task (root-task wire)\n        {:strs [c d]} (into {} (map (fn [[k v]] [(name k) v])) (get-in recv [:module-stores 'host.mod]))]\n    (is (= 1 (count (slot task 7))) \"one :module-store row\")\n    (is (= 2 (quot (count (:slots (slot task 9))) 2)) \"two cursor cells\")\n    (is (= :cursor-ref (:type c) (:type d)))\n    (is (not= (:id c) (:id d)) \"the two cursor cells stay two\")\n    (is (= :closure (normalize (get-in recv [:store 'mod]))))))\n\n\n(deftest synthetic-tail-bookkeeping\n  ;; Row 23: a hand-built parked tail; no primitive returns an FFI effect\n  ;; through a tail :call today, so it is judged by frame/defect only.\n  (let [m (:machine (bare 6))\n        entry (first (:wait-set m))\n        f (dissoc (ft/canonical m entry false) :yin.k/pending)\n        code-map (ft/machine-code m)\n        v (get code-map (:yin.k/segment f))\n        non-tail (first (keep-indexed (fn [pc t] (when (and (= :call (first t)) (false? (nth t 4))) pc)) v))\n        ctx {:free-env {} :ffi-call-ids #{:call-7} :parked-key :call-7}]\n    (is (= :tail (:yin.k/state f)))\n    (is (nil? (frame/defect f code-map :parked ctx)) \"a tail record under a live FFI call id\")\n    (is (= :parked-site (:yin.k/kind (frame/defect f code-map :parked (assoc ctx :parked-key :call-8))))\n        \"the same record under a key absent from :ffi-call-ids\")\n    (is (some? non-tail))\n    (is (= :site (:yin.k/kind (frame/defect (assoc f :yin.k/site non-tail) code-map :parked ctx)))\n        \"T1 runs before P4\")))\n\n\n;; =============================================================================\n;; Acceptance 7: refusals, before any attachment\n;; =============================================================================\n\n(defn update-at\n  [x path f]\n  (if (empty? path)\n    (f x)\n    (if (map? x)\n      (update-in x [:slots (first path)] update-at (rest path) f)\n      (update x (first path) update-at (rest path) f))))\n\n\n(defn replace-nodes\n  \"Every row node matching pred, anywhere under x, replaced by (f node).\"\n  [x pred f]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots))\n    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n    (vector? x) (mapv #(replace-nodes % pred f) x)\n    :else x))\n\n\n(defn replace-row\n  \"The wire with row id's body replaced and every ancestor rehashed,\n   without canonicalizing slots: a tamper below the abstract emitter.\"\n  [wire id body]\n  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n        memo (atom {})]\n    (letfn [(rewrite\n              [x]\n              (cond\n                (contains? index x)\n                (or (get @memo x)\n                    (let [b (mapv rewrite (if (= x id) body (subvec (get index x) 1)))\n                          nid (jing/segment-key b)]\n                      (swap! memo assoc x nid)\n                      nid))\n                (vector? x) (mapv rewrite x)\n                :else x))]\n      (let [root (rewrite (:yin.k/root wire))\n            rs (mapv (fn [[old nid]]\n                       (into [nid] (mapv rewrite (if (= old id) body (subvec (get index old) 1)))))\n                     @memo)]\n        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n\n\n(defn pairs-of\n  [n]\n  (mapv vec (partition 2 (:slots n))))\n\n\n(defn rebuild\n  [n f]\n  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n\n\n(defn lowered\n  \"Lower wire into a fresh receiver: [outcome attaches].\"\n  [toy wire]\n  (let [{:keys [attach!] n :count} (recording-attacher toy)\n        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n    [r @n]))\n\n\n(defn free-register\n  \"A register of the act's body that is neither in its window nor its rd.\"\n  [task act]\n  (let [[a pc _ w _ rd] (:slots act)\n        v (get (slot task 11) a)\n        bodies (code/parse v)\n        k (:registers (nth bodies (code/body-index bodies pc)))\n        taken (into #{rd} (map first) (pairs-of w))]\n    (first (remove taken (range k)))))\n\n\n(def wait-act [13 0 0])\n\n\n(defn tamper-cases\n  []\n  (let [act-of (fn [task] (get-in task [:slots 13 0 :slots 0]))]\n    [[\"window with an extra live key\" 1 :window-extra\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (conj ps [(free-register task (act-of task)) [:lit :x]])))))]\n     [\"a live key removed\" 1 :window-missing\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (rest ps))))))]\n     [\"rd added\" 1 :window-self\n      (fn [task]\n        (update-at task (conj wait-act 3)\n                   #(rebuild % (fn [ps] (conj ps [(nth (:slots (act-of task)) 5) [:lit :x]])))))]\n     [\"rd replaced by another register\" 1 :destination\n      (fn [task] (update-at task (conj wait-act 5) inc))]\n     [\"a reason the site does not admit\" 1 :reason-mismatch\n      (fn [task] (update-at task [13 0 1] (constantly (rows/node :pending [:install 'bogus]))))]\n     [\"the [:lit nil] of row 22 dropped\" 22 :window-missing\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (remove (fn [[_ v]] (= [:lit nil] v)) ps))))))]\n     [\"a :reified act whose pc-1 is not a capture\" 14 :captured-site\n      (fn [task]\n        (let [act (act-of task)]\n          (replace-nodes task #(= :reified (:kind %)) (constantly (rows/node :reified [act])))))]\n     [\"a parked act whose pc-1 is not :park\" 1 :parked-site\n      (fn [task] (update-at task [8] (constantly (rows/node :parked-table [:bogus (act-of task)]))))]\n     [\"the root free-env row given a reserved key\" 1 :reserved-name\n      (fn [task] (update-at task [5] #(rebuild % (fn [ps] (conj ps ['yin/def [:lit 1]])))))]]))\n\n\n(defn return-site-case\n  \"A return frame's pc moved after a tail call (K1); falls back to a pc\n   after any non-call when no tail call has a successor in its body.\"\n  [task]\n  (let [kpath [13 0 0 2 0]\n        kf (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0])\n        [a] (:slots kf)\n        v (get (slot task 11) a)\n        bodies (code/parse v)\n        same-body? (fn [p] (= (code/body-index bodies (dec p)) (code/body-index bodies p)))\n        tail-call? (fn [t] (and (= :call (first t)) (true? (nth t 4))))\n        after-tail (first (filter #(and (tail-call? (nth v (dec %))) (same-body? %)) (range 1 (count v))))\n        after-other (first (filter #(and (not= :call (first (nth v (dec %)))) (same-body? %)) (range 1 (count v))))]\n    [(if after-tail :after-tail-call :after-non-call)\n     (update-at task (conj kpath 1) (constantly (or after-tail after-other)))]))\n\n\n(defn lift-bare\n  [n]\n  (let [world (bare n)\n        {:keys [serve! toy]} (served #{:reader :writer})]\n    [toy (rows/lift-task (:machine world) serve! (lift-opts))]))\n\n\n(deftest refusals\n  (doseq [[label n kind tamper] (tamper-cases)]\n    (testing label\n      (let [[toy wire] (lift-bare n)\n            [r attaches] (lowered toy (rows/emit-numbered (tamper (root-task wire)) {}))]\n        (is (= [:yin.k/undecodable kind] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n        (is (zero? attaches) \"refused before any attachment\"))))\n  (testing \"a segment with no tree association (§6.1): unsatisfied, before any attachment\"\n    (let [[toy wire] (lift-bare 1)\n          task (update-at (root-task wire) [10] #(assoc % :yin.k/trees {}))\n          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n      (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n      (is (= :incomplete (:yin.k/discovery r)))\n      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))\n      (is (zero? attaches)))\n    (let [world (bare 1)\n          d (error #(rows/lift-task (:machine world) (:serve! (served #{:reader})) {:source-index {}}))]\n      (is (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)]) \"the lift refuses it too\")))\n  (testing \"a return frame's pc moved after a tail call\"\n    (let [[toy wire] (lift-bare 6)\n          [how task] (return-site-case (root-task wire))\n          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n      (is (= :after-tail-call how))\n      (is (= [:yin.k/undecodable :return-site] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches))))\n  (testing \"a :tail row given a fourth slot is refused at structure, before frames\"\n    (let [[toy wire] (lift-bare 6)\n          [id & body] (first (filter #(= :tail (second %)) (:yin.k/rows wire)))\n          [r attaches] (lowered toy (replace-row wire id (conj (vec body) 0)))]\n      (is (= :yin.k/undecodable (:yin.k/status r)))\n      (is (= :row-shape (:yin.k/kind r)) \"the codec's structure step (2) runs before the frames step (7)\")\n      (is (zero? attaches))))\n  (testing \"E2 over row 21 with the free environment {x 99 y 7}\"\n    (let [world (free-env-world identity {'x 99 'y 7})\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task (:machine world) serve! (lift-opts))\n          task (root-task wire)\n          env-path (conj wait-act 2 0)\n          edit (fn [f] (rows/emit-numbered (update-at task env-path #(rebuild % (fn [ps] (f (into {} ps))))) {}))]\n      (is (= [:lit 1] (second (first (filter #(= 'x (first %)) (pairs-of (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0]))))))\n          \"the lexical x is 1 at the read\")\n      (doseq [[label f] [[\"the unshadowed y changed\" #(assoc % 'y [:lit 8])]\n                         [\"the lexical x removed\" #(dissoc % 'x)]]]\n        (testing label\n          (let [[r attaches] (lowered toy (edit f))]\n            (is (= [:yin.k/undecodable :free-env-mismatch] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n            (is (zero? attaches)))))\n      (testing \"the lexical x changed trips nothing\"\n        (let [[r] (lowered toy (edit #(assoc % 'x [:lit 98])))]\n          (is (vm/blocked? r) (pr-str r))))))\n  (testing \"lift refusals, before any stream is served\"\n    (let [counting (fn []\n                     (let [n (atom 0) {:keys [serve!]} (served #{:reader})]\n                       [(fn [h] (swap! n inc) (serve! h)) n]))\n          stepped (vm/step (load-program (machine) (s/lit 42)))\n          m0 (load-program (machine) (s/app (s/v 'stream/poll!) (s/v 'c)))\n          [sref m1] (engine/attach-resource m0 (s/ring 8))\n          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n          held (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))]\n      (is (= [:observe] (mapv :reason (:wait-set held))))\n      (doseq [[label m status kind] [[\"not at a safepoint\" stepped :yin.k/not-at-safepoint nil]\n                                     [\"a held :observe\" held :yin.k/non-portable :reason-mismatch]]]\n        (testing label\n          (let [[serve! n] (counting)\n                d (error #(rows/lift-task m serve! (lift-opts)))]\n            (is (= status (:yin.k/status d)) (pr-str d))\n            (is (= kind (:yin.k/kind d)))\n            (is (zero? @n))))))))\n\n\n(deftest first-defect-order\n  (let [[toy wire] (lift-bare 18)\n        task (root-task wire)\n        state-path [8 1]\n        state (get-in task [:slots 8 :slots 1])\n        ;; the park's window: rd added\n        tampered (update-at task (conj state-path 3)\n                            #(rebuild % (fn [ps] (conj ps [(nth (:slots state) 5) [:lit :x]]))))\n        census (mapv first (pairs-of (slot task 9)))\n        swapped (zipmap census (reverse census))]\n    (is (= 2 (count census)))\n    (is (= :window-self (:yin.k/kind (first (lowered toy (rows/emit-numbered tampered {}))))))\n    (let [[r attaches] (lowered toy (rows/emit-numbered tampered swapped))]\n      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches)))))\n\n\n;; =============================================================================\n;; Acceptance 8: the two ported tests\n;; =============================================================================\n\n(defn parked-reader\n  []\n  (let [m0 (vm/run (load-program (machine) (with-stream (s/then read-op read-op))))\n        src (s/stream-of m0)]\n    (stream/append! src \"A\")\n    [(vm/run m0) src]))\n\n\n(deftest a-nonempty-ready-queue-is-not-quiescent\n  (let [[parked src] (parked-reader)\n        _ (stream/append! src \"B\")\n        woken (engine/check-wait-set parked)\n        n (atom 0)\n        {:keys [serve!]} (served #{:reader})\n        d (error #(rows/lift-task woken (fn [h] (swap! n inc) (serve! h)) (lift-opts)))]\n    (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n    (is (= :yin.k/not-quiescent (:yin.k/status d)) (pr-str d))\n    (is (zero? @n) \"no stream was served\")))\n\n\n(defn two-callers\n  []\n  (let [call-in (s/ring 8) call-out (s/ring 8)\n        m (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                          :call-out-cursor (vm/mint-oldest call-out :test)})\n                                (s/then (s/call-node :op/echo \"hello\") (s/call-node :op/echo \"world\"))))\n        e1 (first (:wait-set m))]\n    [(assoc m :wait-set [e1 (assoc e1 :call-id :parked-9)]) call-out (:call-id e1)]))\n\n\n(defn answer-both!\n  [call-out first-id]\n  (stream/append! call-out (apply2/success-response :parked-9 \"second\"))\n  (stream/append! call-out (apply2/success-response first-id \"first\")))\n\n\n(defn sweep\n  [m peers]\n  (loop [m (engine/check-wait-set m) n 12]\n    (if (or (zero? n) (empty? (:wait-set m)))\n      m\n      (do (run! s/serve-mirror! peers) (recur (engine/check-wait-set m) (dec n))))))\n\n\n(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n  (let [[ref-m ref-out id] (two-callers)\n        _ (answer-both! ref-out id)\n        expected (mapv :value (:ready-queue (sweep ref-m [])))\n        [m call-out id] (two-callers)\n        {:keys [serve! toy peer]} (served #{:reader})\n        wire (rows/lift-task m serve! (lift-opts))\n        task (root-task wire)\n        pendings (mapv #(second (:slots %)) (slot task 13))\n        own-out (s/ring 8)\n        recv (rows/lower-task (machine {:attach-stream (s/attacher toy) :call-in (s/ring 8) :call-out own-out\n                                        :call-out-cursor (vm/mint-oldest own-out :test)})\n                              wire (s/attacher toy))\n        [w1 w2] (:wait-set recv)\n        _ (answer-both! call-out id)\n        swept (sweep recv [peer])]\n    (is (= [:ffi :ffi] (mapv #(first (:slots %)) pendings)))\n    (is (= [id :parked-9] (mapv #(nth (:slots %) 2) pendings)))\n    (is (= 1 (quot (count (:slots (slot task 9))) 2)) \"the two waiters name one cursor cell\")\n    (is (= (nth (:slots (first pendings)) 1) (nth (:slots (second pendings)) 1)))\n    (is (= (:cursor-ref w1) (:cursor-ref w2)) \"the lower gives both waiters one fresh cursor entry\")\n    (is (= [(apply2/success-response :parked-9 \"second\") (apply2/success-response id \"first\")] expected))\n    (is (empty? (:wait-set swept)))\n    (is (= expected (mapv :value (:ready-queue swept)))\n        \"the receiver wakes the same waiters with the same responses\")))\n\n\n(deftest act-ffi-bookkeeping\n  ;; Row 24: row 3's bookkeeping record travels in the parked table under\n  ;; its call id, and the validator accepts it in context :parked.\n  (let [world (bare 24)\n        {:keys [serve!]} (served #{:reader})\n        task (root-task (rows/lift-task (:machine world) serve! (lift-opts)))\n        [p state] (:slots (slot task 8))]\n    (is (= (:call-id world) p))\n    (is (= :act (:kind state)))\n    (is (= [:ffi (:call-id world)] [(first (:slots (first-pending task))) (nth (:slots (first-pending task)) 2)]))\n    (is (nil? (rows/validate-frames task)))))\n","numLines":966,"startLine":1,"totalLines":966}},"tool_result_meta":[{"id":"toolu_01ELg2ZbnkKb4dxLnex82Mwn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
