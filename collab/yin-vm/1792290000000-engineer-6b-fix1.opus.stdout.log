{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JNjV16RjqCwGAga7eNMmH5","type":"tool_result","content":"1130\t;; =============================================================================\n1131\t;;\n1132\t;; The lift walks a quiescent semantic-register machine into the abstract\n1133\t;; task the codec above emits: waits, parked records, the store, module\n1134\t;; stores, the free environment, the result and install children, every\n1135\t;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n1136\t;; cursor cell's source is the resource id of a cursor reference, or\n1137\t;; [response-resource position] for a link wait's kept response cursor,\n1138\t;; so one resource reached twice is one cursor cell. The lower decodes the\n1139\t;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n1140\t;; custody for every task of the tree, and only then attaches streams and\n1141\t;; restores state. Restoration delivers nothing, runs nothing.\n1142\t\n1143\t(defn- outcome!\n1144\t  [status kind data]\n1145\t  (throw (ex-info \"Task transport refused\"\n1146\t                  (merge data (cond-> {:yin.k/status status}\n1147\t                                (some? kind) (assoc :yin.k/kind kind))))))\n1148\t\n1149\t\n1150\t(defn- unliftable-hold\n1151\t  \"The first hold of m with no wire pending (UCF 7.4.1, 7.4.3), or nil.\"\n1152\t  [m]\n1153\t  (let [waits (:wait-set m)\n1154\t        cells (filter map? (vals (:resources m)))\n1155\t        held? #(and (map? %) (contains? % :yin.k/held))]\n1156\t    (cond\n1157\t      (some #(= :observe (:reason %)) waits) :observe\n1158\t      (or (some held? waits) (some held? cells)) :held\n1159\t      (some :yin.k/unminted cells) :unminted-cursor\n1160\t      (seq (:yin.k/closes m)) :pending-close\n1161\t      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor))) waits)\n1162\t      :link-cursor-not-installed\n1163\t      :else nil)))\n1164\t\n1165\t\n1166\t(defn- stream-row!\n1167\t  \"The :stream row of resource sid, served once per resource.\"\n1168\t  [ctx sid]\n1169\t  (or (get-in @(:acc ctx) [:streams sid])\n1170\t      (let [h (get (:resources (:m ctx)) sid)]\n1171\t        (when (nil? h)\n1172\t          (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint sid}))\n1173\t        (let [marker (remote/lift-marker (:serve! ctx) h)]\n1174\t          (when (nil? marker) (outcome! :yin.k/unsatisfied nil {}))\n1175\t          (let [n (node :stream [(:dao.stream/identity marker) (:dao.stream/descriptor marker)])]\n1176\t            (swap! (:acc ctx) assoc-in [:streams sid] n)\n1177\t            n)))))\n1178\t\n1179\t\n1180\t(defn- cell!\n1181\t  [ctx source sid position]\n1182\t  (when-not (contains? (:cells @(:acc ctx)) source)\n1183\t    (let [stream (stream-row! ctx sid)]\n1184\t      (swap! (:acc ctx) assoc-in [:cells source] (node :cursor-cell-body [stream position]))))\n1185\t  source)\n1186\t\n1187\t\n1188\t(defn- cell-for!\n1189\t  [ctx cid]\n1190\t  (let [cell (get (:resources (:m ctx)) cid)]\n1191\t    (when-not (and (map? cell) (contains? cell :stream-id))\n1192\t      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint cid}))\n1193\t    (cell! ctx cid (:stream-id cell) (:cursor cell))))\n1194\t\n1195\t\n1196\t(defn- address!\n1197\t  [ctx seg]\n1198\t  (if-some [a (get-in (:m ctx) [:code seg :address])]\n1199\t    (do (swap! (:acc ctx) update :segments conj a) a)\n1200\t    (outcome! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg})))\n1201\t\n1202\t\n1203\t(defn- scalar-literal?\n1204\t  [x]\n1205\t  (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (number? x)\n1206\t      (and (not (cbor/byte-payload? x)) (cbor/numeric? x))))\n1207\t\n1208\t\n1209\t(defn- primitive-name\n1210\t  [ctx f]\n1211\t  (let [m (:m ctx)\n1212\t        n (vm/name-of (:primitives m) (or (:primitive-canonical-names m) {}) f)\n1213\t        profile (when (symbol? n) (vm/profile-of (:primitives m) n))]\n1214\t    (cond\n1215\t      (nil? n) (outcome! :yin.k/non-portable :unnamed-function {})\n1216\t      (not (symbol? n)) (outcome! :yin.k/non-portable :ambiguous-primitive {})\n1217\t      (= :host (:yin.k/class profile)) (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name n})\n1218\t      :else n)))\n1219\t\n1220\t\n1221\t(declare lift-value state-node)\n1222\t\n1223\t\n1224\t(defn- collection-value\n1225\t  \"A guest collection: a literal when no member is a reference.\"\n1226\t  [ctx kind members original]\n1227\t  (let [vs (mapv #(lift-value ctx %) members)]\n1228\t    (if (every? #(= :lit (first %)) vs) [:lit original] [:row (node kind vs)])))\n1229\t\n1230\t\n1231\t(defn- bindings-node\n1232\t  [ctx e]\n1233\t  (swap! (:acc ctx) update :bound into (keys e))\n1234\t  (node :bindings (mapcat (fn [[k v]] [k (lift-value ctx v)]) e)))\n1235\t\n1236\t\n1237\t(defn- store-of!\n1238\t  [ctx e]\n1239\t  (let [store-of (engine/env-store-of e)]\n1240\t    (when (some? store-of) (swap! (:acc ctx) update :stores conj store-of))\n1241\t    store-of))\n1242\t\n1243\t\n1244\t(defn- lift-env-node\n1245\t  [ctx e]\n1246\t  (let [e (or e {})]\n1247\t    (node :env [(bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n1248\t\n1249\t\n1250\t(defn- closure-node\n1251\t  [ctx c]\n1252\t  (let [e (or (:env c) {})]\n1253\t    (node :closure [(address! ctx (:segment c)) (:entry c) (vec (:params c))\n1254\t                    (bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n1255\t\n1256\t\n1257\t(defn- lift-value\n1258\t  \"One machine value as a carrier value: [:lit x], [:row n] or\n1259\t   [:cursor-cell source]. A reference is authenticated before it is\n1260\t   encoded; a foreign value, a heap cell and a host object refuse.\"\n1261\t  [ctx x]\n1262\t  (let [m (:m ctx)]\n1263\t    (cond\n1264\t      (values/host-typed? x)\n1265\t      (cond\n1266\t        (not (values/owned-by? x (:owner m)))\n1267\t        (outcome! :yin.k/non-portable :foreign-value {:yin.k/hint (values/kind-of x)})\n1268\t        (values/closure? x) [:row (closure-node ctx (values/payload x))]\n1269\t        (values/continuation? x) [:row (node :reified [(state-node ctx (values/payload x))])]\n1270\t        :else (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint (values/kind-of x)}))\n1271\t      (fn? x) [:row (node :prim [(primitive-name ctx x)])]\n1272\t      (map? x)\n1273\t      (case (:type x)\n1274\t        :stream-ref (if (engine/authentic-ref? m :stream-ref x)\n1275\t                      [:row (stream-row! ctx (:id x))]\n1276\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n1277\t        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)\n1278\t                      [:cursor-cell (cell-for! ctx (:id x))]\n1279\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))\n1280\t        :parked-continuation (if (contains? (:parked m) (:id x))\n1281\t                               [:row (node :parked-ref [(:id x)])]\n1282\t                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))\n1283\t        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})\n1284\t        (collection-value ctx :map (mapcat identity x) x))\n1285\t      (vector? x) (collection-value ctx :vec x x)\n1286\t      (set? x) (collection-value ctx :set (vec x) x)\n1287\t      (seq? x) (collection-value ctx :list (vec x) x)\n1288\t      (scalar-literal? x) [:lit x]\n1289\t      :else (outcome! :yin.k/non-portable :host-object {}))))\n1290\t\n1291\t\n1292\t(defn- window-node\n1293\t  [ctx w]\n1294\t  (node :window (mapcat (fn [[r v]] [r (lift-value ctx v)]) w)))\n1295\t\n1296\t\n1297\t(defn- k-node\n1298\t  [ctx k]\n1299\t  (node :k (mapv (fn [f]\n1300\t                   (node :kframe [(address! ctx (:segment f)) (:pc f) (lift-env-node ctx (:env f))\n1301\t                                  (window-node ctx (:window f)) (:rd f)]))\n1302\t                 (or k []))))\n1303\t\n1304\t\n1305\t(defn- state-node\n1306\t  \"An evaluator payload (wait entry, parked record, reified payload) as\n1307\t   its :act or :tail row; engine fields are the pending's.\"\n1308\t  [ctx p]\n1309\t  (if (contains? p :site)\n1310\t    (node :tail [(address! ctx (:segment p)) (:site p) (k-node ctx (:k p))])\n1311\t    (node :act [(address! ctx (:segment p)) (:pc p) (lift-env-node ctx (:env p))\n1312\t                (window-node ctx (:window p)) (k-node ctx (:k p)) (get-in p [:deliver :rd])])))\n1313\t\n1314\t\n1315\t(defn- pending-node\n1316\t  \"The observed wait's pending (draft §5.3): the reason is the entry's,\n1317\t   never the site's static kind.\"\n1318\t  [ctx e]\n1319\t  (let [m (:m ctx)]\n1320\t    (case (:reason e)\n1321\t      :next (if (contains? e :call-id)\n1322\t              (node :pending [:ffi (cell-for! ctx (get-in e [:cursor-ref :id])) (:call-id e) (:op e)])\n1323\t              (node :pending [:next (cell-for! ctx (get-in e [:cursor-ref :id]))]))\n1324\t      :put (if (:request-sent e)\n1325\t             (let [carried? (and (:response-cursor e) (:response-stream e))\n1326\t                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)\n1327\t                   response (if carried? (:response-stream e) vm/call-out-stream-key)]\n1328\t               (when-not (get (:resources m) cursor) (outcome! :yin.k/unsatisfied nil {}))\n1329\t               (node :pending [:ffi-request (:call-id e) (lift-value ctx (:datom e)) (stream-row! ctx (:stream-id e))\n1330\t                               (stream-row! ctx response) (cell-for! ctx cursor) (:op-id e)]))\n1331\t             (do (when-not (contains? e :datom) (outcome! :yin.k/non-portable :incomplete-write {}))\n1332\t                 (node :pending [:put (stream-row! ctx (:stream-id e)) (lift-value ctx (:datom e)) (:op-id e)])))\n1333\t      (:link-request :link-response)\n1334\t      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))\n1335\t            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]\n1336\t        (node :pending (if (= :link-request (:reason e)) (conj base (:envelope e) (:op-id e)) base)))\n1337\t      :install (do (when-not (contains? (:installs m) (:name e))\n1338\t                     (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name (:name e)}))\n1339\t                   (node :pending [:install (:name e)]))\n1340\t      (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/reason (:reason e)}))))\n1341\t\n1342\t\n1343\t(defn- store-node\n1344\t  [ctx s]\n1345\t  (node :store (mapcat (fn [[k v]]\n1346\t                         (when-not (= :lit (first (lift-value ctx k)))\n1347\t                           (outcome! :yin.k/non-portable :store-key {}))\n1348\t                         [k (lift-value ctx v)])\n1349\t                       s)))\n1350\t\n1351\t\n1352\t(defn- module-store-nodes\n1353\t  \"Every module store an environment or closure reaches, transitively.\"\n1354\t  [ctx]\n1355\t  (loop [done {}]\n1356\t    (if-let [mid (first (sort-by str (remove #(contains? done %) (:stores @(:acc ctx)))))]\n1357\t      (let [stores (:module-stores (:m ctx))]\n1358\t        (when-not (contains? stores mid)\n1359\t          (outcome! :yin.k/non-portable :missing-module-store {:yin.k/hint mid}))\n1360\t        (recur (assoc done mid (node :module-store [mid (store-node ctx (get stores mid))]))))\n1361\t      (mapv val (sort-by #(str (key %)) done)))))\n1362\t\n1363\t\n1364\t(defn- installing-names\n1365\t  [m]\n1366\t  (into #{} (mapcat (fn [[mn inst]]\n1367\t                      (map #(symbol (name mn) (name %))\n1368\t                           (get-in inst [:response :manifest :yin.module/exports]))))\n1369\t        (:installs m)))\n1370\t\n1371\t\n1372\t(defn- discharge!\n1373\t  \"The dependency closure over the v4 vectors (§7.1): every free name the\n1374\t   carried code reads is answered in resolve-var's order, or the lift is\n1375\t   :yin.k/unsatisfied, discovery :incomplete.\"\n1376\t  [ctx names free-env]\n1377\t  (let [m (:m ctx)\n1378\t        bound (:bound @(:acc ctx))\n1379\t        module-keys (into #{} (mapcat keys) (vals (:module-stores m)))\n1380\t        installing (installing-names m)\n1381\t        answered? (fn [sym]\n1382\t                    (let [profile (vm/profile-of (:primitives m) sym)]\n1383\t                      (when (= :host (:yin.k/class profile))\n1384\t                        (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name sym}))\n1385\t                      (or (vm/reserved-name? sym) (contains? free-env sym) (contains? bound sym)\n1386\t                          (contains? (:store m) sym) (contains? module-keys sym)\n1387\t                          (contains? installing sym) (some? profile)\n1388\t                          (and (some? (namespace sym))\n1389\t                               (some? (module/resolve-module (:modules m)\n1390\t                                                             (symbol (str (namespace sym) \".\" (name sym)))))))))\n1391\t        missing (into #{} (remove answered?) names)]\n1392\t    (when (seq missing)\n1393\t      (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:obligations missing}}))))\n1394\t\n1395\t\n1396\t(declare lift-task*)\n1397\t\n1398\t\n1399\t(defn- install-node\n1400\t  [ctx mn inst opts]\n1401\t  (let [{:keys [phase parent response]} inst]\n1402\t    (when-not (contains? #{:running :parked} phase)\n1403\t      (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name mn :yin.k/phase phase}))\n1404\t    (when-not (try (cbor/encode response) true\n1405\t                   (catch #?(:cljd Object :clj Throwable :cljs :default) _e false))\n1406\t      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n1407\t    (node :install [mn phase parent response\n1408\t                    (lift-task* (:vm inst) (:serve! ctx) (dissoc opts :free-env) :child)])))\n1409\t\n1410\t\n1411\t(defn- lift-task*\n1412\t  [m serve! opts role]\n1413\t  (when (seq (:ready-queue m))\n1414\t    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n1415\t  (when-some [h (unliftable-hold m)]\n1416\t    (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/hold h}))\n1417\t  (when (some? (:control m))\n1418\t    (outcome! :yin.k/not-at-safepoint nil {:yin.k/pc (get-in m [:control :pc])}))\n1419\t  (let [value (:value m)\n1420\t        active? (and (map? value) (= :parked-continuation (:type value)) (contains? (:parked m) (:id value)))\n1421\t        kind (cond active? :parked\n1422\t                   (seq (:wait-set m)) :blocked\n1423\t                   (engine/halted-with-empty-queue? m) :halted\n1424\t                   :else (outcome! :yin.k/not-at-safepoint nil {}))\n1425\t        ;; §6.3: the explicit argument overrides the kernel's retained field\n1426\t        free-env (cond (some? (:free-env opts)) (:free-env opts)\n1427\t                       (some? (:free-env m)) (:free-env m)\n1428\t                       :else (outcome! :yin.k/non-portable :missing-free-env {}))\n1429\t        ctx {:m m :serve! serve! :acc (atom {:streams {} :cells {} :stores #{} :segments #{} :bound #{}})}\n1430\t        free-node (bindings-node ctx free-env)\n1431\t        waits (mapv (fn [e] (node :wait [(state-node ctx e) (pending-node ctx e)])) (:wait-set m))\n1432\t        parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n1433\t        store (store-node ctx (:store m))\n1434\t        result (when (= :halted kind) (lift-value ctx value))\n1435\t        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n1436\t        module-stores (module-store-nodes ctx)\n1437\t        acc @(:acc ctx)\n1438\t        segments (:segments acc)\n1439\t        code (into {} (map (fn [a]\n1440\t                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n1441\t                               [a v]\n1442\t                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n1443\t                   segments)\n1444\t        _ (discharge! ctx (into #{} (mapcat scan/free-names) (vals code)) free-env)\n1445\t        index (or (:source-index opts) {})\n1446\t        missing-trees (into #{} (remove #(seq (get index %))) segments)\n1447\t        _ (when (seq missing-trees)\n1448\t            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n1449\t        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n1450\t                  :yin.k/segments segments\n1451\t                  :yin.k/trees (select-keys index segments)}\n1452\t        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n1453\t                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n1454\t                          (when (= :parked kind) (:id value)) result nil])]\n1455\t    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n1456\t    (when-let [d (validate-frames task)]\n1457\t      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n1458\t    task))\n1459\t\n1460\t\n1461\t(defn lift-task\n1462\t  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n1463\t   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n1464\t   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n1465\t   opts: :free-env, the task's initial free environment (default: the\n1466\t   kernel's retained :free-env field; the explicit value overrides it);\n1467\t   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n1468\t   must cover every carried segment; :budget, the numbering budget.\"\n1469\t  ([m serve!] (lift-task m serve! {}))\n1470\t  ([m serve! opts]\n1471\t   (let [opts (or opts {})]\n1472\t     (emit (lift-task* m serve! opts :root) (merge default-budget (:budget opts))))))\n1473\t\n1474\t\n1475\t(def ^:private fixed-resource-keys\n1476\t  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key\n1477\t    module/link-request-resource module/link-response-resource})\n1478\t\n1479\t\n1480\t(defn- fresh-key!\n1481\t  [used]\n1482\t  (loop [n (inc (count @used))]\n1483\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n1484\t      (if (contains? @used k) (recur (inc n)) (do (swap! used conj k) k)))))\n1485\t\n1486\t\n1487\t(defn- rows-of\n1488\t  \"Every row of kind under n; install children too unless own-only.\"\n1489\t  [n kind own-only?]\n1490\t  (let [out (atom [])]\n1491\t    (letfn [(visit\n1492\t              [n]\n1493\t              (when (= kind (:kind n)) (swap! out conj n))\n1494\t              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n1495\t                (cond\n1496\t                  (and (ref? d) (= :task (:kind x))) (when-not own-only? (visit x))\n1497\t                  (ref? d) (visit x)\n1498\t                  (refs? d) (run! visit x)\n1499\t                  (and (value-slot? d) (vector? x) (= :row (first x))) (visit (second x))\n1500\t                  :else nil)))]\n1501\t      (visit n)\n1502\t      @out)))\n1503\t\n1504\t\n1505\t(defn- task-tree\n1506\t  \"[task role] for the root and every install child, pre-order.\"\n1507\t  [task role]\n1508\t  (into [[task role]] (mapcat #(task-tree (nth (:slots %) 4) :child)) (nth (:slots task) 12)))\n1509\t\n1510\t\n1511\t(defn- check-task!\n1512\t  \"Carrier steps 8 to 10 for one task, before any attachment: pending and\n1513\t   operations, dependency closure, custody.\"\n1514\t  [recv task role]\n1515\t  (let [[_ _ kind role' _ _ _ _ parked _ requires code installs waits parked-id _ custody] (:slots task)]\n1516\t    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n1517\t    (when (some? custody) (outcome! :yin.k/unsupported :custody {}))\n1518\t    (let [names (into #{} (map #(first (:slots %))) installs)]\n1519\t      (doseq [w waits]\n1520\t        (let [[reason n] (:slots (second (:slots w)))]\n1521\t          (when (and (= :install reason) (not (contains? names n)))\n1522\t            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n1523\t    (case kind\n1524\t      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1525\t      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1526\t      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n1527\t                (outcome! :yin.k/undecodable :parked-id {}))\n1528\t      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1529\t    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n1530\t      (outcome! :yin.k/undecodable :requires {}))\n1531\t    (let [trees (:yin.k/trees requires)\n1532\t          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n1533\t      (when (seq missing)\n1534\t        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n1535\t    (doseq [c (rows-of task :closure true)]\n1536\t      (when-not (contains? code (first (:slots c)))\n1537\t        (outcome! :yin.k/undecodable :segment {:yin.k/segment (first (:slots c))})))\n1538\t    (doseq [p (rows-of task :prim true)]\n1539\t      (when-not (contains? (:primitives recv) (first (:slots p)))\n1540\t        (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))\n1541\t\n1542\t\n1543\t(defn- attach-streams!\n1544\t  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n1545\t  [attach! task]\n1546\t  (reduce (fn [acc s]\n1547\t            (let [[identity descriptor] (:slots s)]\n1548\t              (if (contains? acc identity)\n1549\t                acc\n1550\t                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n1551\t                  (assoc acc identity h)\n1552\t                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n1553\t          {} (rows-of task :stream false)))\n1554\t\n1555\t\n1556\t(defn- spawn-child\n1557\t  \"A fresh install child of recv's composition (the engine's spawn\n1558\t   discipline): answers [child recv'].\"\n1559\t  [recv response mn]\n1560\t  (let [n (or (:origins recv) 0)\n1561\t        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n1562\t        registry (reduce (fn [r [m e]] (module/assoc-module r m (dissoc e :bindings)))\n1563\t                         (:modules recv) (module/module-entries (:modules recv)))\n1564\t        source (:secret-source recv)]\n1565\t    [(module/spawn-module recv (:value (:image response))\n1566\t                          {:modules registry :origin origin\n1567\t                           :ancestry (conj (vec (:ancestry recv)) mn)\n1568\t                           :capability-secret (when (fn? source) (source origin))})\n1569\t     (assoc recv :origins (inc n))]))\n1570\t\n1571\t\n1572\t(defn- restore-task\n1573\t  \"Step 12 for one task: code by A, fresh resource keys, values re-sealed\n1574\t   under recv, waits as engine entries, parked records, installs.\"\n1575\t  [recv task handles]\n1576\t  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n1577\t        (:slots task)\n1578\t        base (reduce (fn [r [_ v]] (module/attach-module r v))\n1579\t                     (assoc recv :code {} :code-aliases {} :program nil)\n1580\t                     (sort-by #(str (key %)) code))\n1581\t        aliases (:code-aliases base)\n1582\t        used (atom (into fixed-resource-keys (keys (:resources base))))\n1583\t        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n1584\t        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n1585\t        pairs (mapv vec (partition 2 (:slots census)))\n1586\t        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n1587\t        bodies (into {} pairs)\n1588\t        stream-key #(get stream-keys (first (:slots %)))\n1589\t        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n1590\t        cache (atom {})\n1591\t        resolving (atom #{})]\n1592\t    (letfn [(value\n1593\t              [v]\n1594\t              (case (first v)\n1595\t                :lit (second v)\n1596\t                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n1597\t                :row (row (second v))))\n1598\t            (row\n1599\t              [n]\n1600\t              (let [ss (:slots n)]\n1601\t                (case (:kind n)\n1602\t                  :vec (mapv value ss)\n1603\t                  :list (apply list (map value ss))\n1604\t                  :set (into #{} (map value) ss)\n1605\t                  :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n1606\t                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n1607\t                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n1608\t                  :closure (let [[a entry params bindings store-of] ss]\n1609\t                             (module/lower-closure base\n1610\t                                                   (cond-> {:yin.k/binding :named\n1611\t                                                            :yin.k/format :yin.semantic-register/code\n1612\t                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n1613\t                                                            :yin.k/env (keyed bindings)}\n1614\t                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n1615\t                                                   identity))\n1616\t                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n1617\t                  :parked-ref (parked-record (first ss)))))\n1618\t            (keyed\n1619\t              [n]\n1620\t              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n1621\t            (env\n1622\t              [n]\n1623\t              (let [[b store-of] (:slots n)]\n1624\t                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n1625\t            (k-of\n1626\t              [n]\n1627\t              (mapv (fn [f]\n1628\t                      (let [[a pc e w rd] (:slots f)]\n1629\t                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n1630\t                    (:slots n)))\n1631\t            (payload\n1632\t              [n]\n1633\t              (if (= :tail (:kind n))\n1634\t                (let [[a site k] (:slots n)]\n1635\t                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n1636\t                (let [[a pc e w k rd] (:slots n)]\n1637\t                  {:segment (get aliases a) :pc pc :env (env e) :window (keyed w) :k (k-of k)\n1638\t                   :deliver {:deliver :rd :rd rd}})))\n1639\t            (parked-record\n1640\t              [p]\n1641\t              (or (get @cache p)\n1642\t                  (do (when (contains? @resolving p)\n1643\t                        (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint :parked-cycle}))\n1644\t                      (swap! resolving conj p)\n1645\t                      (let [r (assoc (payload (get parked-index p)) :type :parked-continuation :id p)]\n1646\t                        (swap! cache assoc p r)\n1647\t                        (swap! resolving disj p)\n1648\t                        r))))\n1649\t            (cell-stream\n1650\t              [c]\n1651\t              (stream-key (first (:slots (get bodies c)))))\n1652\t            (entry\n1653\t              [w]\n1654\t              (let [[state pending] (:slots w)\n1655\t                    [reason & xs] (:slots pending)\n1656\t                    p (payload state)]\n1657\t                (case reason\n1658\t                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n1659\t                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n1660\t                  :ffi (let [[c call-id op] xs]\n1661\t                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n1662\t                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n1663\t                           (some? op) (assoc :op op)))\n1664\t                  :put (let [[s v op-id] xs]\n1665\t                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n1666\t                           (some? op-id) (assoc :op-id op-id)))\n1667\t                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n1668\t                                     datom (value envelope)]\n1669\t                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n1670\t                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n1671\t                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n1672\t                                   (some? op-id) (assoc :op-id op-id)))\n1673\t                  (:link-request :link-response)\n1674\t                  (let [[link-id mn _ _ c envelope op-id] xs]\n1675\t                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n1676\t                                   :request module/link-request-resource :response module/link-response-resource\n1677\t                                   :cursor (second (:slots (get bodies c))))\n1678\t                      (= :link-request reason) (assoc :envelope envelope)\n1679\t                      (some? op-id) (assoc :op-id op-id)))\n1680\t                  :install (assoc p :reason :install :name (first xs)))))]\n1681\t      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n1682\t            stores (into {} (map (fn [ms]\n1683\t                                   (let [[mid s] (:slots ms)]\n1684\t                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n1685\t                         module-stores)\n1686\t            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n1687\t            entries (mapv entry waits)\n1688\t            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n1689\t                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n1690\t                       waits)\n1691\t            [base installs'] (reduce (fn [[r acc] inst]\n1692\t                                       (let [[mn phase parent response child] (:slots inst)\n1693\t                                             [spawned r'] (spawn-child r response mn)]\n1694\t                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n1695\t                                                            :vm (restore-task spawned child handles)})]))\n1696\t                                     [base {}] installs)\n1697\t            fe (keyed free-env)\n1698\t            resources (merge (:resources base)\n1699\t                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n1700\t                             (into {} (map (fn [[c body]]\n1701\t                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n1702\t                                                                 :cursor (second (:slots body))}]))\n1703\t                                   pairs)\n1704\t                             (when-let [[req resp] link]\n1705\t                               {module/link-request-resource (get handles (first (:slots req)))\n1706\t                                module/link-response-resource (get handles (first (:slots resp)))}))\n1707\t            machine (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n1708\t                           :resources resources :env fe :free-env fe :window {} :k nil :control nil\n1709\t                           :ready-queue [] :id-counter (max (or (:id-counter base) 0) id-counter))]\n1710\t        (case kind\n1711\t          :halted (assoc machine :halted? true :blocked? false :value (value result) :wait-set [])\n1712\t          :parked (assoc machine :halted? true :blocked? false :value (get parked' parked-id) :wait-set entries)\n1713\t          (assoc machine :halted? false :blocked? true :value :yin/blocked :wait-set entries))))))\n1714\t\n1715\t\n1716\t(defn lower-task\n1717\t  \"The lower of §7.2 into recv, a fresh semantic-register machine of the\n1718\t   receiver's composition: gate to frames (decode), then pendings,\n1719\t   dependency closure and custody for every task of the tree, all before\n1720\t   the first attach! (step 11); then restore (step 12). Answers the\n1721\t   restored machine, or throws the first refusal as ex-data.\"\n1722\t  ([recv wire attach!] (lower-task recv wire attach! {}))\n1723\t  ([recv wire attach! opts]\n1724\t   (let [task (decode wire (merge default-budget (:budget opts)))]\n1725\t     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n1726\t     (doseq [[t role] (task-tree task :root)] (check-task! recv t role))\n1727\t     (restore-task recv task (attach-streams! attach! task)))))\n1728\t"}]},"parent_tool_use_id":null,"session_id":"195d2023-8c95-40ce-b61e-3288e37d4c05","uuid":"49e00d1e-bda6-44d3-8147-d5715134958c","timestamp":"2026-10-12T16:35:46.228Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/src/cljc/yin/vm/ucf/rows.cljc","content":";; =============================================================================\n;;\n;; The lift walks a quiescent semantic-register machine into the abstract\n;; task the codec above emits: waits, parked records, the store, module\n;; stores, the free environment, the result and install children, every\n;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n;; cursor cell's source is the resource id of a cursor reference, or\n;; [response-resource position] for a link wait's kept response cursor,\n;; so one resource reached twice is one cursor cell. The lower decodes the\n;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n;; custody for every task of the tree, and only then attaches streams and\n;; restores state. Restoration delivers nothing, runs nothing.\n\n(defn- outcome!\n  [status kind data]\n  (throw (ex-info \"Task transport refused\"\n                  (merge data (cond-> {:yin.k/status status}\n                                (some? kind) (assoc :yin.k/kind kind))))))\n\n\n(defn- unliftable-hold\n  \"The first hold of m with no wire pending (UCF 7.4.1, 7.4.3), or nil.\"\n  [m]\n  (let [waits (:wait-set m)\n        cells (filter map? (vals (:resources m)))\n        held? #(and (map? %) (contains? % :yin.k/held))]\n    (cond\n      (some #(= :observe (:reason %)) waits) :observe\n      (or (some held? waits) (some held? cells)) :held\n      (some :yin.k/unminted cells) :unminted-cursor\n      (seq (:yin.k/closes m)) :pending-close\n      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor))) waits)\n      :link-cursor-not-installed\n      :else nil)))\n\n\n(defn- stream-row!\n  \"The :stream row of resource sid, served once per resource.\"\n  [ctx sid]\n  (or (get-in @(:acc ctx) [:streams sid])\n      (let [h (get (:resources (:m ctx)) sid)]\n        (when (nil? h)\n          (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint sid}))\n        (let [marker (remote/lift-marker (:serve! ctx) h)]\n          (when (nil? marker) (outcome! :yin.k/unsatisfied nil {}))\n          (let [n (node :stream [(:dao.stream/identity marker) (:dao.stream/descriptor marker)])]\n            (swap! (:acc ctx) assoc-in [:streams sid] n)\n            n)))))\n\n\n(defn- cell!\n  [ctx source sid position]\n  (when-not (contains? (:cells @(:acc ctx)) source)\n    (let [stream (stream-row! ctx sid)]\n      (swap! (:acc ctx) assoc-in [:cells source] (node :cursor-cell-body [stream position]))))\n  source)\n\n\n(defn- cell-for!\n  [ctx cid]\n  (let [cell (get (:resources (:m ctx)) cid)]\n    (when-not (and (map? cell) (contains? cell :stream-id))\n      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint cid}))\n    (cell! ctx cid (:stream-id cell) (:cursor cell))))\n\n\n(defn- address!\n  [ctx seg]\n  (if-some [a (get-in (:m ctx) [:code seg :address])]\n    (do (swap! (:acc ctx) update :segments conj a) a)\n    (outcome! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg})))\n\n\n(defn- scalar-literal?\n  [x]\n  (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (number? x)\n      (and (not (cbor/byte-payload? x)) (cbor/numeric? x))))\n\n\n(defn- primitive-name\n  [ctx f]\n  (let [m (:m ctx)\n        n (vm/name-of (:primitives m) (or (:primitive-canonical-names m) {}) f)\n        profile (when (symbol? n) (vm/profile-of (:primitives m) n))]\n    (cond\n      (nil? n) (outcome! :yin.k/non-portable :unnamed-function {})\n      (not (symbol? n)) (outcome! :yin.k/non-portable :ambiguous-primitive {})\n      (= :host (:yin.k/class profile)) (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name n})\n      :else n)))\n\n\n(declare lift-value state-node)\n\n\n(defn- collection-value\n  \"A guest collection: a literal when no member is a reference.\"\n  [ctx kind members original]\n  (let [vs (mapv #(lift-value ctx %) members)]\n    (if (every? #(= :lit (first %)) vs) [:lit original] [:row (node kind vs)])))\n\n\n(defn- bindings-node\n  [ctx e]\n  (swap! (:acc ctx) update :bound into (keys e))\n  (node :bindings (mapcat (fn [[k v]] [k (lift-value ctx v)]) e)))\n\n\n(defn- store-of!\n  [ctx e]\n  (let [store-of (engine/env-store-of e)]\n    (when (some? store-of) (swap! (:acc ctx) update :stores conj store-of))\n    store-of))\n\n\n(defn- lift-env-node\n  [ctx e]\n  (let [e (or e {})]\n    (node :env [(bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n\n\n(defn- closure-node\n  [ctx c]\n  (let [e (or (:env c) {})]\n    (node :closure [(address! ctx (:segment c)) (:entry c) (vec (:params c))\n                    (bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n\n\n(defn- lift-value\n  \"One machine value as a carrier value: [:lit x], [:row n] or\n   [:cursor-cell source]. A reference is authenticated before it is\n   encoded; a foreign value, a heap cell and a host object refuse.\"\n  [ctx x]\n  (let [m (:m ctx)]\n    (cond\n      (values/host-typed? x)\n      (cond\n        (not (values/owned-by? x (:owner m)))\n        (outcome! :yin.k/non-portable :foreign-value {:yin.k/hint (values/kind-of x)})\n        (values/closure? x) [:row (closure-node ctx (values/payload x))]\n        (values/continuation? x) [:row (node :reified [(state-node ctx (values/payload x))])]\n        :else (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint (values/kind-of x)}))\n      (fn? x) [:row (node :prim [(primitive-name ctx x)])]\n      (map? x)\n      (case (:type x)\n        :stream-ref (if (engine/authentic-ref? m :stream-ref x)\n                      [:row (stream-row! ctx (:id x))]\n                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)\n                      [:cursor-cell (cell-for! ctx (:id x))]\n                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))\n        :parked-continuation (if (contains? (:parked m) (:id x))\n                               [:row (node :parked-ref [(:id x)])]\n                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))\n        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})\n        (collection-value ctx :map (mapcat identity x) x))\n      (vector? x) (collection-value ctx :vec x x)\n      (set? x) (collection-value ctx :set (vec x) x)\n      (seq? x) (collection-value ctx :list (vec x) x)\n      (scalar-literal? x) [:lit x]\n      :else (outcome! :yin.k/non-portable :host-object {}))))\n\n\n(defn- window-node\n  [ctx w]\n  (node :window (mapcat (fn [[r v]] [r (lift-value ctx v)]) w)))\n\n\n(defn- k-node\n  [ctx k]\n  (node :k (mapv (fn [f]\n                   (node :kframe [(address! ctx (:segment f)) (:pc f) (lift-env-node ctx (:env f))\n                                  (window-node ctx (:window f)) (:rd f)]))\n                 (or k []))))\n\n\n(defn- state-node\n  \"An evaluator payload (wait entry, parked record, reified payload) as\n   its :act or :tail row; engine fields are the pending's.\"\n  [ctx p]\n  (if (contains? p :site)\n    (node :tail [(address! ctx (:segment p)) (:site p) (k-node ctx (:k p))])\n    (node :act [(address! ctx (:segment p)) (:pc p) (lift-env-node ctx (:env p))\n                (window-node ctx (:window p)) (k-node ctx (:k p)) (get-in p [:deliver :rd])])))\n\n\n(defn- pending-node\n  \"The observed wait's pending (draft §5.3): the reason is the entry's,\n   never the site's static kind.\"\n  [ctx e]\n  (let [m (:m ctx)]\n    (case (:reason e)\n      :next (if (contains? e :call-id)\n              (node :pending [:ffi (cell-for! ctx (get-in e [:cursor-ref :id])) (:call-id e) (:op e)])\n              (node :pending [:next (cell-for! ctx (get-in e [:cursor-ref :id]))]))\n      :put (if (:request-sent e)\n             (let [carried? (and (:response-cursor e) (:response-stream e))\n                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)\n                   response (if carried? (:response-stream e) vm/call-out-stream-key)]\n               (when-not (get (:resources m) cursor) (outcome! :yin.k/unsatisfied nil {}))\n               (node :pending [:ffi-request (:call-id e) (lift-value ctx (:datom e)) (stream-row! ctx (:stream-id e))\n                               (stream-row! ctx response) (cell-for! ctx cursor) (:op-id e)]))\n             (do (when-not (contains? e :datom) (outcome! :yin.k/non-portable :incomplete-write {}))\n                 (node :pending [:put (stream-row! ctx (:stream-id e)) (lift-value ctx (:datom e)) (:op-id e)])))\n      (:link-request :link-response)\n      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))\n            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]\n        (node :pending (if (= :link-request (:reason e)) (conj base (:envelope e) (:op-id e)) base)))\n      :install (do (when-not (contains? (:installs m) (:name e))\n                     (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name (:name e)}))\n                   (node :pending [:install (:name e)]))\n      (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/reason (:reason e)}))))\n\n\n(defn- store-node\n  [ctx s]\n  (node :store (mapcat (fn [[k v]]\n                         (when-not (= :lit (first (lift-value ctx k)))\n                           (outcome! :yin.k/non-portable :store-key {}))\n                         [k (lift-value ctx v)])\n                       s)))\n\n\n(defn- module-store-nodes\n  \"Every module store an environment or closure reaches, transitively.\"\n  [ctx]\n  (loop [done {}]\n    (if-let [mid (first (sort-by str (remove #(contains? done %) (:stores @(:acc ctx)))))]\n      (let [stores (:module-stores (:m ctx))]\n        (when-not (contains? stores mid)\n          (outcome! :yin.k/non-portable :missing-module-store {:yin.k/hint mid}))\n        (recur (assoc done mid (node :module-store [mid (store-node ctx (get stores mid))]))))\n      (mapv val (sort-by #(str (key %)) done)))))\n\n\n(defn- installing-names\n  [m]\n  (into #{} (mapcat (fn [[mn inst]]\n                      (map #(symbol (name mn) (name %))\n                           (get-in inst [:response :manifest :yin.module/exports]))))\n        (:installs m)))\n\n\n(defn- discharge!\n  \"The dependency closure over the v4 vectors (§7.1): every free name the\n   carried code reads is answered in resolve-var's order, or the lift is\n   :yin.k/unsatisfied, discovery :incomplete.\"\n  [ctx names free-env]\n  (let [m (:m ctx)\n        bound (:bound @(:acc ctx))\n        module-keys (into #{} (mapcat keys) (vals (:module-stores m)))\n        installing (installing-names m)\n        answered? (fn [sym]\n                    (let [profile (vm/profile-of (:primitives m) sym)]\n                      (when (= :host (:yin.k/class profile))\n                        (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name sym}))\n                      (or (vm/reserved-name? sym) (contains? free-env sym) (contains? bound sym)\n                          (contains? (:store m) sym) (contains? module-keys sym)\n                          (contains? installing sym) (some? profile)\n                          (and (some? (namespace sym))\n                               (some? (module/resolve-module (:modules m)\n                                                             (symbol (str (namespace sym) \".\" (name sym)))))))))\n        missing (into #{} (remove answered?) names)]\n    (when (seq missing)\n      (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:obligations missing}}))))\n\n\n(declare lift-task*)\n\n\n(defn- install-node\n  [ctx mn inst opts]\n  (let [{:keys [phase parent response]} inst]\n    (when-not (contains? #{:running :parked} phase)\n      (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name mn :yin.k/phase phase}))\n    (when-not (try (cbor/encode response) true\n                   (catch #?(:cljd Object :clj Throwable :cljs :default) _e false))\n      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n    (node :install [mn phase parent response\n                    (lift-task* (:vm inst) (:serve! ctx) (dissoc opts :free-env) :child)])))\n\n\n(defn- lift-task*\n  [m serve! opts role]\n  (when (seq (:ready-queue m))\n    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n  (when-some [h (unliftable-hold m)]\n    (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/hold h}))\n  (when (some? (:control m))\n    (outcome! :yin.k/not-at-safepoint nil {:yin.k/pc (get-in m [:control :pc])}))\n  (let [value (:value m)\n        active? (and (map? value) (= :parked-continuation (:type value)) (contains? (:parked m) (:id value)))\n        kind (cond active? :parked\n                   (seq (:wait-set m)) :blocked\n                   (engine/halted-with-empty-queue? m) :halted\n                   :else (outcome! :yin.k/not-at-safepoint nil {}))\n        ;; §6.3: the explicit argument overrides the kernel's retained field\n        free-env (cond (some? (:free-env opts)) (:free-env opts)\n                       (some? (:free-env m)) (:free-env m)\n                       :else (outcome! :yin.k/non-portable :missing-free-env {}))\n        ctx {:m m :serve! serve! :acc (atom {:streams {} :cells {} :stores #{} :segments #{} :bound #{}})}\n        free-node (bindings-node ctx free-env)\n        waits (mapv (fn [e] (node :wait [(state-node ctx e) (pending-node ctx e)])) (:wait-set m))\n        parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n        store (store-node ctx (:store m))\n        result (when (= :halted kind) (lift-value ctx value))\n        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n        module-stores (module-store-nodes ctx)\n        acc @(:acc ctx)\n        segments (:segments acc)\n        code (into {} (map (fn [a]\n                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n                               [a v]\n                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n                   segments)\n        _ (discharge! ctx (into #{} (mapcat scan/free-names) (vals code)) free-env)\n        index (or (:source-index opts) {})\n        missing-trees (into #{} (remove #(seq (get index %))) segments)\n        _ (when (seq missing-trees)\n            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n                  :yin.k/segments segments\n                  :yin.k/trees (select-keys index segments)}\n        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n                          (when (= :parked kind) (:id value)) result nil])]\n    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n    (when-let [d (validate-frames task)]\n      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n    task))\n\n\n(defn lift-task\n  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n   opts: :free-env, the task's initial free environment (default: the\n   kernel's retained :free-env field; the explicit value overrides it);\n   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n   must cover every carried segment; :budget, the numbering budget.\"\n  ([m serve!] (lift-task m serve! {}))\n  ([m serve! opts]\n   (let [opts (or opts {})]\n     (emit (lift-task* m serve! opts :root) (merge default-budget (:budget opts))))))\n\n\n(def ^:private fixed-resource-keys\n  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key\n    module/link-request-resource module/link-response-resource})\n\n\n(defn- fresh-key!\n  [used]\n  (loop [n (inc (count @used))]\n    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n      (if (contains? @used k) (recur (inc n)) (do (swap! used conj k) k)))))\n\n\n(defn- rows-of\n  \"Every row of kind under n; install children too unless own-only.\"\n  [n kind own-only?]\n  (let [out (atom [])]\n    (letfn [(visit\n              [n]\n              (when (= kind (:kind n)) (swap! out conj n))\n              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n                (cond\n                  (and (ref? d) (= :task (:kind x))) (when-not own-only? (visit x))\n                  (ref? d) (visit x)\n                  (refs? d) (run! visit x)\n                  (and (value-slot? d) (vector? x) (= :row (first x))) (visit (second x))\n                  :else nil)))]\n      (visit n)\n      @out)))\n\n\n(defn- task-tree\n  \"[task role] for the root and every install child, pre-order.\"\n  [task role]\n  (into [[task role]] (mapcat #(task-tree (nth (:slots %) 4) :child)) (nth (:slots task) 12)))\n\n\n(defn- check-task!\n  \"Carrier steps 8 to 10 for one task, before any attachment: pending and\n   operations, dependency closure, custody.\"\n  [recv task role]\n  (let [[_ _ kind role' _ _ _ _ parked _ requires code installs waits parked-id _ custody] (:slots task)]\n    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n    (when (some? custody) (outcome! :yin.k/unsupported :custody {}))\n    (let [names (into #{} (map #(first (:slots %))) installs)]\n      (doseq [w waits]\n        (let [[reason n] (:slots (second (:slots w)))]\n          (when (and (= :install reason) (not (contains? names n)))\n            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n    (case kind\n      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n                (outcome! :yin.k/undecodable :parked-id {}))\n      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n      (outcome! :yin.k/undecodable :requires {}))\n    (let [trees (:yin.k/trees requires)\n          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n      (when (seq missing)\n        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n    (doseq [c (rows-of task :closure true)]\n      (when-not (contains? code (first (:slots c)))\n        (outcome! :yin.k/undecodable :segment {:yin.k/segment (first (:slots c))})))\n    (doseq [p (rows-of task :prim true)]\n      (when-not (contains? (:primitives recv) (first (:slots p)))\n        (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))\n\n\n(defn- attach-streams!\n  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n  [attach! task]\n  (reduce (fn [acc s]\n            (let [[identity descriptor] (:slots s)]\n              (if (contains? acc identity)\n                acc\n                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n                  (assoc acc identity h)\n                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n          {} (rows-of task :stream false)))\n\n\n(defn- spawn-child\n  \"A fresh install child of recv's composition (the engine's spawn\n   discipline): answers [child recv'].\"\n  [recv response mn]\n  (let [n (or (:origins recv) 0)\n        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n        registry (reduce (fn [r [m e]] (module/assoc-module r m (dissoc e :bindings)))\n                         (:modules recv) (module/module-entries (:modules recv)))\n        source (:secret-source recv)]\n    [(module/spawn-module recv (:value (:image response))\n                          {:modules registry :origin origin\n                           :ancestry (conj (vec (:ancestry recv)) mn)\n                           :capability-secret (when (fn? source) (source origin))})\n     (assoc recv :origins (inc n))]))\n\n\n(defn- restore-task\n  \"Step 12 for one task: code by A, fresh resource keys, values re-sealed\n   under recv, waits as engine entries, parked records, installs.\"\n  [recv task handles]\n  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n        (:slots task)\n        base (reduce (fn [r [_ v]] (module/attach-module r v))\n                     (assoc recv :code {} :code-aliases {} :program nil)\n                     (sort-by #(str (key %)) code))\n        aliases (:code-aliases base)\n        used (atom (into fixed-resource-keys (keys (:resources base))))\n        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n        pairs (mapv vec (partition 2 (:slots census)))\n        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n        bodies (into {} pairs)\n        stream-key #(get stream-keys (first (:slots %)))\n        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n        cache (atom {})\n        resolving (atom #{})]\n    (letfn [(value\n              [v]\n              (case (first v)\n                :lit (second v)\n                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n                :row (row (second v))))\n            (row\n              [n]\n              (let [ss (:slots n)]\n                (case (:kind n)\n                  :vec (mapv value ss)\n                  :list (apply list (map value ss))\n                  :set (into #{} (map value) ss)\n                  :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n                  :closure (let [[a entry params bindings store-of] ss]\n                             (module/lower-closure base\n                                                   (cond-> {:yin.k/binding :named\n                                                            :yin.k/format :yin.semantic-register/code\n                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n                                                            :yin.k/env (keyed bindings)}\n                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n                                                   identity))\n                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n                  :parked-ref (parked-record (first ss)))))\n            (keyed\n              [n]\n              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n            (env\n              [n]\n              (let [[b store-of] (:slots n)]\n                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n            (k-of\n              [n]\n              (mapv (fn [f]\n                      (let [[a pc e w rd] (:slots f)]\n                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n                    (:slots n)))\n            (payload\n              [n]\n              (if (= :tail (:kind n))\n                (let [[a site k] (:slots n)]\n                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n                (let [[a pc e w k rd] (:slots n)]\n                  {:segment (get aliases a) :pc pc :env (env e) :window (keyed w) :k (k-of k)\n                   :deliver {:deliver :rd :rd rd}})))\n            (parked-record\n              [p]\n              (or (get @cache p)\n                  (do (when (contains? @resolving p)\n                        (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint :parked-cycle}))\n                      (swap! resolving conj p)\n                      (let [r (assoc (payload (get parked-index p)) :type :parked-continuation :id p)]\n                        (swap! cache assoc p r)\n                        (swap! resolving disj p)\n                        r))))\n            (cell-stream\n              [c]\n              (stream-key (first (:slots (get bodies c)))))\n            (entry\n              [w]\n              (let [[state pending] (:slots w)\n                    [reason & xs] (:slots pending)\n                    p (payload state)]\n                (case reason\n                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n                  :ffi (let [[c call-id op] xs]\n                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n                           (some? op) (assoc :op op)))\n                  :put (let [[s v op-id] xs]\n                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n                           (some? op-id) (assoc :op-id op-id)))\n                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n                                     datom (value envelope)]\n                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n                                   (some? op-id) (assoc :op-id op-id)))\n                  (:link-request :link-response)\n                  (let [[link-id mn _ _ c envelope op-id] xs]\n                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n                                   :request module/link-request-resource :response module/link-response-resource\n                                   :cursor (second (:slots (get bodies c))))\n                      (= :link-request reason) (assoc :envelope envelope)\n                      (some? op-id) (assoc :op-id op-id)))\n                  :install (assoc p :reason :install :name (first xs)))))]\n      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n            stores (into {} (map (fn [ms]\n                                   (let [[mid s] (:slots ms)]\n                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n                         module-stores)\n            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n            entries (mapv entry waits)\n            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n                       waits)\n            [base installs'] (reduce (fn [[r acc] inst]\n                                       (let [[mn phase parent response child] (:slots inst)\n                                             [spawned r'] (spawn-child r response mn)]\n                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n                                                            :vm (restore-task spawned child handles)})]))\n                                     [base {}] installs)\n            fe (keyed free-env)\n            resources (merge (:resources base)\n                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n                             (into {} (map (fn [[c body]]\n                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n                                                                 :cursor (second (:slots body))}]))\n                                   pairs)\n                             (when-let [[req resp] link]\n                               {module/link-request-resource (get handles (first (:slots req)))\n                                module/link-response-resource (get handles (first (:slots resp)))}))\n            machine (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n                           :resources resources :env fe :free-env fe :window {} :k nil :control nil\n                           :ready-queue [] :id-counter (max (or (:id-counter base) 0) id-counter))]\n        (case kind\n          :halted (assoc machine :halted? true :blocked? false :value (value result) :wait-set [])\n          :parked (assoc machine :halted? true :blocked? false :value (get parked' parked-id) :wait-set entries)\n          (assoc machine :halted? false :blocked? true :value :yin/blocked :wait-set entries))))))\n\n\n(defn lower-task\n  \"The lower of §7.2 into recv, a fresh semantic-register machine of the\n   receiver's composition: gate to frames (decode), then pendings,\n   dependency closure and custody for every task of the tree, all before\n   the first attach! (step 11); then restore (step 12). Answers the\n   restored machine, or throws the first refusal as ex-data.\"\n  ([recv wire attach!] (lower-task recv wire attach! {}))\n  ([recv wire attach! opts]\n   (let [task (decode wire (merge default-budget (:budget opts)))]\n     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n     (doseq [[t role] (task-tree task :root)] (check-task! recv t role))\n     (restore-task recv task (attach-streams! attach! task)))))\n","numLines":599,"startLine":1130,"totalLines":1728}},"tool_result_meta":[{"id":"toolu_01JNjV16RjqCwGAga7eNMmH5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
