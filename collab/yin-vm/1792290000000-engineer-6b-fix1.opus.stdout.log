er #(and (= :closure (nth % 0)) (= entry (nth % 3))) v))]","+    (cond","+      (nil? tuple) (outcome! :yin.k/undecodable :closure-origin {:yin.k/segment a :yin.k/entry entry})","+      (not= params (nth tuple 2)) (outcome! :yin.k/undecodable :closure-binders {:yin.k/segment a :yin.k/entry entry})","+      :else nil)))","+","+","+(defn- check-dependencies!","+  \"Step 9, dependency closure: requires and code agree, every segment has","+   its trees (§6.1) and is a vector the receiver's kernel admits under its","+   A, every closure names a closure of its code, every :prim is the","+   receiver's.\"","+  [recv task _role]","+  (let [[_ _ _ _ _ _ _ _ _ _ requires code] (:slots task)]","     (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))","       (outcome! :yin.k/undecodable :requires {}))","     (let [trees (:yin.k/trees requires)","           missing (into #{} (remove #(seq (get trees %))) (keys code))]","       (when (seq missing)","         (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))","-    (doseq [c (rows-of task :closure true)]","-      (when-not (contains? code (first (:slots c)))","-        (outcome! :yin.k/undecodable :segment {:yin.k/segment (first (:slots c))})))","+    (doseq [[a v] (sort-by #(str (key %)) code)]","+      (when-not (attaches? recv v a)","+        (outcome! :yin.k/undecodable :segment {:yin.k/segment a})))","+    (run! #(check-closure! code %) (rows-of task :closure true))","     (doseq [p (rows-of task :prim true)]","       (when-not (contains? (:primitives recv) (first (:slots p)))","         (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))"," "," ","+(defn- check-custody!","+  \"Step 10: phase 6 carries fork custody only.\"","+  [_recv task _role]","+  (when (some? (nth (:slots task) 16))","+    (outcome! :yin.k/unsupported :custody {})))","+","+"," (defn- attach-streams!","   \"Step 11: one attach per distinct stream