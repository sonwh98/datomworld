e first refusal as ex-data.\"\n  ([recv wire attach!] (lower-task recv wire attach! {}))\n  ([recv wire attach! opts]\n   (let [task (decode wire (merge default-budget (:budget opts)))]\n     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n     ;; each step over the whole tree before the next (§3.3)\n     (doseq [step [check-stores! check-pendings! check-dependencies! check-custody!]\n             [t role] (task-tree task :root)]\n       (step recv t role))\n     (restore-task recv task (attach-streams! attach! task)))))\n","structuredPatch":[{"oldStart":1600,"oldLines":7,"newStart":1600,"newLines":7,"lines":["       :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))","                 (outcome! :yin.k/undecodable :parked-id {}))","       (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))","-    (run! #(check-install! recv %) installs)))","+    (run! #(do recv %) installs)))"," "," "," (defn- check-closure!"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_019byZBijm853KEdz8GtRtur","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
