 (:owner m) (assoc-in (values/payload (vm/value m)) [:env engine/store-of-key] mid)))\n\n\n(deftest free-occurrences-are-answered-in-their-own-context\n  (let [m (halted-on ghost-fn)]\n    (testing \"a carried closure whose only free obligation is missing\"\n      (is (= #{'ghost} (missing-obligations m))))\n    (testing \"a module store the closure does not route to answers nothing\"\n      (is (= #{'ghost} (missing-obligations (assoc m :module-stores {'unrelated {'ghost 42}})))))\n    (testing \"a closure routed to a module store: that store, never the root store\"\n      (is (= #{'ghost} (missing-obligations (assoc m :value (scoped m 'scoped) :store {'ghost 1}\n                                                   :module-stores {'scoped {}})))))\n    (testing \"the root store answers a top-level closure\"\n      (is (nil? (missing-obligations (assoc m :store {'ghost 1}))))))\n  (testing \"reachable only through another closure's E\"\n    (is (= #{'ghost} (missing-obligations (halted-on (s/let1 'h ghost-fn (s/lam [] (s/app (s/v 'h)))))))))\n  (testing \"reachable only through the store\"\n    (let [m (halted-on ghost-fn)]\n      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'k (vm/value m)}))))))\n  (testing \"reachable only through a module store another closure routes to\"\n    (let [m (halted-on ghost-fn)\n          holder (values/closure (:owner m) (assoc (values/payload (vm/value m)) :env {engine/store-of-key 'outer}))]\n      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'ghost 1 'mod holder}\n                                                   :module-stores {'outer {'ghost 2 'k (vm/value m)}})))\n          \"k's closure runs at top level: the root store's ghost answers... \")))\n  (testing \"a scoped module store answers, travels, and the lowered closure reads it\"\n    (let [m0 (halted-on ghost-fn)\n          m (assoc m0 :value (scoped m0 'scoped) :module-stores {'scoped {'ghost 42} 'unrelated {'other 1}})\n          [wire