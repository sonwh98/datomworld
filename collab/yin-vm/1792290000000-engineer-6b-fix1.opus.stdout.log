lift-outcome m)]","+    (when (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)])","+      (get-in d [:yin.k/missing :obligations]))))","+","+","+(defn routed","+  \"closure c, its E naming module store mid.\"","+  [m c mid]","+  (values/closure (:owner m) (assoc-in (values/payload c) [:env engine/store-of-key] mid)))","+","+","+(deftest free-occurrences-are-answered-in-their-own-context","+  (let [m (halted-on ghost-fn)","+        g (vm/value m)]","+    (testing \"a carried closure whose only free obligation is missing\"","+      (is (= #{'ghost} (missing-obligations m))))","+    (testing \"a module store the closure does not route to answers nothing\"","+      (is (= #{'ghost} (missing-obligations (assoc m :module-stores {'unrelated {'ghost 42}})))))","+    (testing \"a routed closure reads its module store, never the root store\"","+      (is (= #{'ghost} (missing-obligations (assoc m :value (routed m g 'scoped) :store {'ghost 1}","+                                                   :module-stores {'scoped {}})))))","+    (testing \"the root store answers a top-level closure\"","+      (is (nil? (missing-obligations (assoc m :store {'ghost 1})))))","+    (testing \"reachable only through the store\"","+      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'k g})))))","+    (testing \"reachable only through a module store a routed closure reaches\"","+      ;; the holder runs in outer, where ghost is 2; k, found in outer,","+      ;; runs at top level, where nothing answers ghost","+      (is (= #{'ghost} (missing-obligations (assoc m :value 1 :store {'mod (routed m g 'outer)}","+                                                   :module-stores {'outer {'ghost 2 'k g}}))))))","+  (testing \"reachable only through another closure's E\"","+    (is (= #{'ghost} (missing-obligations (halted-on (s/let1 'h ghost-fn (s/lam [] (s/app (s/v 'h)))))))))","+  (testing \"a routed module store answers, travels alone, and the lowered closure reads it\"","+    (let [m0 (halted-on ghost-fn)","+          m (assoc m0 :value (routed m0 (vm/value m0) 'scoped) :module-stores {'scoped {'ghost 42} 'unrelated {'other 1}})","+          [wire serves] (lift-outcome m)","+          {:keys [toy]} (served #{:reader})","+          [recv attaches] (lowered toy wire)]","+      (is (contains? wire :yin.k/rows) (pr-str wire))","+      (is (zero? serves))","+      (is (zero? attaches))","+      (is (= ['scoped] (mapv #(first (:slots %)) (slot (root-task wire) 7))) \"only the routed module store travels\")","+      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f)))))))))"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01YHCXBNVEbDZmxqpKDb478C","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
