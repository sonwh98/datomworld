       :yin.admit/decision\n1405\t                                                 :yin.admit/asserters\n1406\t                                                 :yin.admit/address])))\n1407\t                    received (receive-module state module-name entry)\n1408\t                    received (reduce\n1409\t                               (fn [s [m dep]]\n1410\t                                 (if (some? (module/module-entry\n1411\t                                              (:modules (:modules s)) m))\n1412\t                                   s\n1413\t                                   (receive-module s m (dissoc dep :bindings))))\n1414\t                               received\n1415\t                               (linked-entries (:modules vm)))]\n1416\t                (-> received\n1417\t                    (update :installs dissoc module-name)\n1418\t                    (wake-installed module-name module-name nil))))))))))\n1419\t\n1420\t\n1421\t(defn- advance-install\n1422\t  \"Step the install child of `module-name` in this round, beside every\n1423\t   other task (section 7.3): `running` runs it until it halts or parks.\n1424\t   A parked child stays `parked`; a halted one goes on to `validated`; an\n1425\t   error refuses the install. An error while publishing -- attaching an\n1426\t   origin image, lowering the slice or a store snapshot, or receiving a\n1427\t   dependency -- refuses it too, at phase `:linked`, from the state the\n1428\t   round started with: nothing half-published survives, every waiter is\n1429\t   restored with the refusal, and no throw leaves the round.\n1430\t\n1431\t   Under a custody gate the child is stamped with the root's mode before\n1432\t   it runs; in `:exporting` and `:ended` it does not run.\"\n1433\t  [state module-name]\n1434\t  (let [inst (get-in state [:installs module-name])\n1435\t        mode (vm/gate-mode state)\n1436\t        [child refusal]\n1437\t        (when-not (contains? #{:exporting :ended} mode)\n1438\t          (try [(vm/run (stamp-gate (:vm inst) mode)) nil]\n1439\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1440\t                 [nil (error-refusal module-name e)])))]\n1441\t    (cond\n1442\t      (and (nil? child) (nil? refusal)) state\n1443\t      refusal (refuse-install state module-name refusal)\n1444\t      (:blocked? child)\n1445\t      (assoc-in state [:installs module-name]\n1446\t                (assoc inst :vm child :phase :parked))\n1447\t      (:halted? child)\n1448\t      (try (link-install state module-name (assoc inst :vm child))\n1449\t           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1450\t             (refuse-install state module-name\n1451\t                             (assoc (error-refusal module-name e)\n1452\t                                    :phase :linked))))\n1453\t      :else (assoc-in state [:installs module-name]\n1454\t                      (assoc inst :vm child :phase :running)))))\n1455\t\n1456\t\n1457\t(defn- advance-installs\n1458\t  [state]\n1459\t  (reduce advance-install state (sort-by str (keys (:installs state)))))\n1460\t\n1461\t\n1462\t(defn- start-install\n1463\t  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n1464\t   `[state refusal]`.\"\n1465\t  [state module-name response link-id]\n1466\t  (try\n1467\t    (let [[child state] (spawn-child state module-name response)]\n1468\t      [(assoc-in state [:installs module-name]\n1469\t                 {:phase :running, :vm child, :parent link-id,\n1470\t                  :response response})\n1471\t       nil])\n1472\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1473\t      [state (assoc (error-refusal module-name e) :phase :loading)])))\n1474\t\n1475\t\n1476\t(defn- settle\n1477\t  \"Act on the response correlated with `entry`: a refusal (or loss) is\n1478\t   raised as the effect's error; `:ok` runs step 5b against the live\n1479\t   state and, discharged, starts the install child, the entry becoming\n1480\t   an `:install` waiter. A module linked or installing meanwhile answers\n1481\t   or joins instead, and a manifest naming another module than the one\n1482\t   required is `:module-name-mismatch`, never installed. Returns `[state\n1483\t   waiting woken]`.\"\n1484\t  [state entry response]\n1485\t  (let [state (retire state (:link-id entry) :restored)\n1486\t        module-name (:name entry)\n1487\t        waiter (-> entry\n1488\t                   (dissoc :envelope :request :response :cursor :link-id)\n1489\t                   (assoc :reason :install))]\n1490\t    (cond\n1491\t      (not= :ok (:status response))\n1492\t      [state nil (refused-entry entry response)]\n1493\t\n1494\t      (some? (module/resolve-module (:modules state) module-name))\n1495\t      [state nil (ready entry module-name)]\n1496\t\n1497\t      (contains? (:installs state) module-name) [state waiter nil]\n1498\t\n1499\t      ;; the linker checks the name (section 8.1); a response that names\n1500\t      ;; another module is never installed under this one\n1501\t      (not= module-name (get-in response [:manifest :yin.module/name]))\n1502\t      [state nil\n1503\t       (refused-entry entry\n1504\t                      (linker/refused :module-name-mismatch\n1505\t                                      {:requested module-name,\n1506\t                                       :manifest (get-in\n1507\t                                                   response\n1508\t                                                   [:manifest\n1509\t                                                    :yin.module/name])}))]"}]},"parent_tool_use_id":null,"session_id":"195d2023-8c95-40ce-b61e-3288e37d4c05","uuid":"2ca9e2ac-cb75-489b-9303-abb592c50fff","timestamp":"2026-10-12T16:36:24.670Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/src/cljc/yin/vm/engine.cljc","content":"  [state child response]\n  (into [(:value (:image response))]\n        (mapcat (fn [[_ entry]] (vals (:images entry))))\n        (concat (linked-entries (:modules child))\n                (linked-entries (:modules state)))))\n\n\n(defn- link-install\n  \"`validated` then `linked` (section 7.3): the child reached halt; every\n   export must be a key of its store (`:export-missing`); the slice is\n   lifted (act 1) and its origins checked against the images this\n   scheduler verified (act 2, `:foreign-image`); the receiving task then\n   receives, first, the entry -- its store snapshots win over the plain\n   registry snapshot of a dependency, since the child's mutations are\n   what the slice carries -- and then every module the child linked that\n   it lacks (acts 3 and 4), and every waiter is restored with the name.\n   A response that rode on an admission allow records it on the entry\n   under `:admission`.\"\n  [state module-name {:keys [vm response]}]\n  (let [manifest (:manifest response)\n        address (manifest-address response)\n        exports (sort-by str (:yin.module/exports manifest))\n        missing (vec (remove #(contains? (:store vm) %) exports))]\n    (if (seq missing)\n      (refuse-install state module-name\n                      {:status :refused,\n                       :reason :export-missing,\n                       :module module-name,\n                       :names missing})\n      (let [lifted (try (lift-slice vm address exports)\n                        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                          {:refusal (error-refusal module-name e)}))]\n        (if-let [refusal (:refusal lifted)]\n          (refuse-install state module-name refusal)\n          (let [verified (verified-images state vm response)\n                origin-of (fn [seg]\n                            (some #(when (module/image-holds? vm % seg) %)\n                                  verified))\n                foreign (first (remove origin-of\n                                       (sort-by str (:origins lifted))))]\n            (if (some? foreign)\n              (refuse-install state module-name\n                              {:status :refused,\n                               :reason :foreign-image,\n                               :module module-name,\n                               :segment foreign})\n              (let [images (into {}\n                                 (map (fn [seg]\n                                        (let [img (origin-of seg)]\n                                          [(module/image-identity vm img)\n                                           img])))\n                                 (:origins lifted))\n                    entry (module/module-entry\n                            (:modules (module/link-module\n                                        nil manifest (:derivation response)\n                                        (assoc lifted :images images)))\n                            module-name)\n                    ;; the admission the link rode on (yin.vm.linker.dht.md\n                    ;; 7.5): inherited and transferred with the entry\n                    entry (cond-> entry\n                            (= :allow (:yin.admit/decision response))\n                            (assoc :admission\n                                   (select-keys response\n                                                [:yin.admit/id\n                                                 :yin.admit/decision\n                                                 :yin.admit/asserters\n                                                 :yin.admit/address])))\n                    received (receive-module state module-name entry)\n                    received (reduce\n                               (fn [s [m dep]]\n                                 (if (some? (module/module-entry\n                                              (:modules (:modules s)) m))\n                                   s\n                                   (receive-module s m (dissoc dep :bindings))))\n                               received\n                               (linked-entries (:modules vm)))]\n                (-> received\n                    (update :installs dissoc module-name)\n                    (wake-installed module-name module-name nil))))))))))\n\n\n(defn- advance-install\n  \"Step the install child of `module-name` in this round, beside every\n   other task (section 7.3): `running` runs it until it halts or parks.\n   A parked child stays `parked`; a halted one goes on to `validated`; an\n   error refuses the install. An error while publishing -- attaching an\n   origin image, lowering the slice or a store snapshot, or receiving a\n   dependency -- refuses it too, at phase `:linked`, from the state the\n   round started with: nothing half-published survives, every waiter is\n   restored with the refusal, and no throw leaves the round.\n\n   Under a custody gate the child is stamped with the root's mode before\n   it runs; in `:exporting` and `:ended` it does not run.\"\n  [state module-name]\n  (let [inst (get-in state [:installs module-name])\n        mode (vm/gate-mode state)\n        [child refusal]\n        (when-not (contains? #{:exporting :ended} mode)\n          (try [(vm/run (stamp-gate (:vm inst) mode)) nil]\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                 [nil (error-refusal module-name e)])))]\n    (cond\n      (and (nil? child) (nil? refusal)) state\n      refusal (refuse-install state module-name refusal)\n      (:blocked? child)\n      (assoc-in state [:installs module-name]\n                (assoc inst :vm child :phase :parked))\n      (:halted? child)\n      (try (link-install state module-name (assoc inst :vm child))\n           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n             (refuse-install state module-name\n                             (assoc (error-refusal module-name e)\n                                    :phase :linked))))\n      :else (assoc-in state [:installs module-name]\n                      (assoc inst :vm child :phase :running)))))\n\n\n(defn- advance-installs\n  [state]\n  (reduce advance-install state (sort-by str (keys (:installs state)))))\n\n\n(defn- start-install\n  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n   `[state refusal]`.\"\n  [state module-name response link-id]\n  (try\n    (let [[child state] (spawn-child state module-name response)]\n      [(assoc-in state [:installs module-name]\n                 {:phase :running, :vm child, :parent link-id,\n                  :response response})\n       nil])\n    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n      [state (assoc (error-refusal module-name e) :phase :loading)])))\n\n\n(defn- settle\n  \"Act on the response correlated with `entry`: a refusal (or loss) is\n   raised as the effect's error; `:ok` runs step 5b against the live\n   state and, discharged, starts the install child, the entry becoming\n   an `:install` waiter. A module linked or installing meanwhile answers\n   or joins instead, and a manifest naming another module than the one\n   required is `:module-name-mismatch`, never installed. Returns `[state\n   waiting woken]`.\"\n  [state entry response]\n  (let [state (retire state (:link-id entry) :restored)\n        module-name (:name entry)\n        waiter (-> entry\n                   (dissoc :envelope :request :response :cursor :link-id)\n                   (assoc :reason :install))]\n    (cond\n      (not= :ok (:status response))\n      [state nil (refused-entry entry response)]\n\n      (some? (module/resolve-module (:modules state) module-name))\n      [state nil (ready entry module-name)]\n\n      (contains? (:installs state) module-name) [state waiter nil]\n\n      ;; the linker checks the name (section 8.1); a response that names\n      ;; another module is never installed under this one\n      (not= module-name (get-in response [:manifest :yin.module/name]))\n      [state nil\n       (refused-entry entry\n                      (linker/refused :module-name-mismatch\n                                      {:requested module-name,\n                                       :manifest (get-in\n                                                   response\n                                                   [:manifest\n                                                    :yin.module/name])}))]","numLines":170,"startLine":1340,"totalLines":2789}},"tool_result_meta":[{"id":"toolu_01S8EW6y2fYyQ23E3xgLATyE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
