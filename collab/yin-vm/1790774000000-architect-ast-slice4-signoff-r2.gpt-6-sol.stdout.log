at i))) i (recur (inc i))))]\n   867\t       (loop [i 0, start 0, parts [], tokens {}, frames ()]\n   868\t         (if (>= i n)\n   869\t           [(apply str (conj parts (subs input start)))\n   870\t            (mapv key (sort-by val tokens))]\n   871\t           (let [c (at i)\n   872\t                 d (when (< (inc i) n) (at (inc i)))\n   873\t                 [i' frames' token]\n   874\t                 (cond\n   875\t                   (#{\" \" \"\\t\" \"\\n\" \"\\r\" \"\\f\" \",\"} c) [(inc i) frames]\n   876\t                   (= \"\\\"\" c) [(string-end (inc i)) frames]\n   877\t                   (= \";\" c) [(line-end i) frames]\n   878\t                   (= \"\\\\\" c) [(token-end (min n (+ i 2))) frames]\n   879\t                   (#{\"'\" \"@\" \"^\" \"`\" \"~\"} c) [(inc i) frames]\n   880\t                   (#{\"(\" \"[\" \"{\"} c) [(inc i) (conj frames :coll)]\n   881\t                   (#{\")\" \"]\" \"}\"} c) [(inc i) (rest frames)]\n   882\t                   (= \"#\" c)\n   883\t                   (case d\n   884\t                     \"(\" [(+ i 2) (conj frames :anon)]\n   885\t                     \"{\" [(+ i 2) (conj frames :coll)]\n   886\t                     \"\\\"\" [(string-end (+ i 2)) frames]\n   887\t                     (\"_\" \"'\" \"=\" \"^\") [(+ i 2) frames]\n   888\t                     \"?\" [(if (and (< (+ i 2) n) (= \"@\" (at (+ i 2)))) (+ i 3) (+ i 2))\n   889\t                          frames]\n   890\t                     \"!\" [(line-end i) frames]\n   891\t                     (\"#\" \":\") [(token-end (+ i 2)) frames]\n   892\t                     [(token-end (inc i)) frames])\n   893\t                   (and (= \"%\" c) (not-any? #{:anon} frames))\n   894\t                   (let [end (token-end (inc i))] [end frames (subs input i end)])\n   895\t                   :else [(token-end i) frames])]\n   896\t             (if token\n   897\t               (let [index (get tokens token (count tokens))]\n   898\t                 (recur i' i'\n   899\t                        (conj parts (subs input start i) (str prefix index))\n   900\t                        (assoc tokens token index)\n   901\t                        frames'))\n   902\t               (recur i' start parts tokens frames'))))))))\n   903\t\n   904\t\n   905\t#?(:cljd\n   906\t   (defn- restore-percent-tokens\n   907\t     \"`form` with each placeholder symbol of `smap` (`{placeholder token}`)\n   908\t      replaced by its token, a namespace-qualified placeholder (syntax\n   909\t      quote) keeping its namespace. Only a branch that holds a placeholder\n   910\t      is rebuilt; everything else is returned identical. A rebuilt branch\n   911\t      keeps its collection type, order and exactly `form`'s own metadata,\n   912\t      nil included: on ClojureDart a list built by `(apply list ...)`\n   913\t      carries `{:line ... :tag <Type>}` metadata that dao.jing.cbor refuses.\"\n   914\t     [smap form]\n   915\t     (let [again #(restore-percent-tokens smap %)\n   916\t           same? #(every? true? (map identical? %1 %2))\n   917\t           keep-meta #(with-meta % (meta form))]\n   918\t       (cond\n   919\t         (symbol? form) (if-let [token (get smap (symbol (name form)))]\n   920\t                          (symbol (namespace form) (name token))\n   921\t                          form)\n   922\t         (seq? form) (let [xs (map again form)]\n   923\t                       (if (same? xs form) form (keep-meta (apply list xs))))\n   924\t         (vector? form) (let [xs (mapv again form)]\n   925\t                          (if (same? xs form) form (keep-meta xs)))\n   926\t         (map? form) (let [kvs (mapv (fn [[k v]] [(again k) (again v)]) form)]\n   927\t                       (if (same? (mapcat identity kvs) (mapcat identity form))\n   928\t                         form\n   929\t                         (keep-meta (into (empty form) kvs))))\n   930\t         (set? form) (let [xs (mapv again form)]\n   931\t                       (if (same? xs form) form (keep-meta (into (empty form) xs))))\n   932\t         :else form))))\n   933\t\n   934\t\n   935\t#?(:cljd\n   936\t   (defn- read-percent-forms\n   937\t     \"`input`'s forms read as the JVM and JavaScript readers read a bare `%`\n   938\t      token (see `escape-percent-tokens`). A reader refusal that names a\n   939\t      placeholder is rethrown naming the token instead.\"\n   940\t     [input]\n   941\t     (let [read #(edn/read-string (str \"[\" % \"]\"))\n   942\t           prefix (loop [p \"yin_repl_percent_\"]\n   943\t                    (if (str/includes? input p) (recur (str p \"_\")) p))\n   944\t           [text tokens] (escape-percent-tokens input prefix)]\n   945\t       (if (empty? tokens)\n   946\t         (read input)\n   947\t         (let [forms (try (read text)\n   948\t                          (catch Object error\n   949\t                            (let [message (or (ex-message error) (str error))]\n   950\t                              (if (str/includes? message prefix)\n   951\t                                (throw (ex-info\n   952\t                                         (reduce (fn [m i]\n   953\t                                                   (str/replace m (str prefix i)\n   954\t                                                                (nth tokens i)))\n   955\t                                                 message\n   956\t                                                 (reverse (range (count tokens))))\n   957\t                                         {}))\n   958\t                                (throw error)))))]\n   959\t           (restore-percent-tokens\n   960\t             (zipmap (map #(symbol (str prefix %)) (range (count tokens)))\n   961\t                     (map symbol tokens))\n   962\t             forms))))))\n   963\t\n   964\t\n   965\t(defn- read-forms\n   966\t  [input]\n   967\t  #?(:cljd (if (str/includes? input \"%\")\n   968\t             (read-percent-forms input)\n   969\t             (edn/read-string (str \"[\" input \"]\")))\n   970\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n   971\t     :clj (clojure.core/read-string (str \"[\" input \"]\"))))\n   972\t\n   973\t\n   974\t(defn- command-form?\n   975\t  [form]\n   976\t  (and (seq? form)\n   977\t       (symbol? (first form))\n   978\t       (contains? command-heads (first form))))\n   979\t\n   980\t\n   295\t(deftest unknown-commands-and-reader-failures-are-reported-not-thrown\n   296\t  (testing \"an unknown command\"\n   297\t    (let [[state result] (repl/eval-input (repl/create-state) \"(nope)\")]\n   298\t      (is (str/starts-with? result \"Error: \"))\n   299\t      (is (true? (:running? state)))))\n   300\t  (testing \"unreadable input\"\n   301\t    (let [[_ result] (repl/eval-input (repl/create-state) \"\\\"unterminated\")]\n   302\t      (is (str/starts-with? result \"Error: \")))))\n   303\t\n   304\t\n   305\t(deftest the-reader-keeps-datalog-symbols-on-every-host\n   306\t  ;; A Datalog query or rule set typed at the prompt names its rules input\n   307\t  ;; `%`, a collection binding `...` and a blank `_`: the input reader must\n   308\t  ;; read each as the plain symbol on every host.\n   309\t  (doseq [[line expected]\n   310\t          [[\"(quote [:in $ast $occ % ?root])\" \"[:in '$ast '$occ '% '?root]\"]\n   311\t           [\"(quote [% ?root])\" \"['% '?root]\"]\n   312\t           [\"(quote [?root %])\" \"['?root '%]\"]\n   313\t           [\"(quote [?name ...])\" \"['?name '...]\"]\n   314\t           [\"(quote [:in % :where (r ?x)])\" \"[:in '% :where ('r '?x)]\"]\n   315\t           [\"(quote [$ast ?lam :lambda ?params _])\"\n   316\t            \"['$ast '?lam :lambda '?params '_]\"]]]\n   317\t    (is (= expected (second (repl/eval-input (repl/create-state) line)))\n   318\t        line)))\n   319\t\n   320\t\n   321\t(defn- answer\n   322\t  [line]\n   323\t  (second (repl/eval-input (repl/create-state) line)))\n   324\t\n   325\t\n   326\t(deftest the-reader-reads-percent-forms-alike-on-every-host\n   327\t  ;; Cross-host parity: each line reads to the same form, printed as the\n   328\t  ;; same text, on the JVM, Node and Dart readers, including a `%` right\n   329\t  ;; after a discard, a string and a discarded character literal.\n   330\t  (doseq [[line expected]\n   331\t          [[\"(quote [#_% %])\" \"['%]\"]\n   332\t           [\"(quote [#_#_% % %1])\" \"['%1]\"]\n   333\t           [\"(quote [#_ % %&])\" \"['%&]\"]\n   334\t           [\"(quote [\\\"%\\\" #_\\\\% %])\" \"[\\\"%\\\" '%]\"]\n   335\t           [\"(quote {% [%]})\" \"{'% ['%]}\"]]]\n   336\t    (is (= expected (answer line)) line)))\n   337\t\n   338\t\n   339\t(deftest a-percent-reads-as-any-other-symbol-does\n   340\t  ;; On each host, a line with `%` answers exactly what the same line with\n   341\t  ;; an ordinary symbol answers: the Dart workaround changes nothing but\n   342\t  ;; the `%` itself (map type and order, metadata, duplicate handling and\n   343\t  ;; tag refusals stay the host reader's own).\n   344\t  (doseq [[line plain]\n   345\t          [[\"(quote [% {:z %, :y 2, :x 3}])\" \"(quote [zz9 {:z zz9, :y 2, :x 3}])\"]\n   346\t           [\"(quote [% {:c 1, :b 2, :a 3} #{%}])\"\n   347\t            \"(quote [zz9 {:c 1, :b 2, :a 3} #{zz9}])\"]\n   348\t           [\"(quote [% ^{:m 1} [1 {:b 2, :a 1}] (f (g %))])\"\n   349\t            \"(quote [zz9 ^{:m 1} [1 {:b 2, :a 1}] (f (g zz9))])\"]\n   350\t           [\"(quote #{% %})\" \"(quote #{zz9 zz9})\"]\n   351\t           [\"(quote {% 1 % 2})\" \"(quote {zz9 1 zz9 2})\"]\n   352\t           [\"(quote [#foo %])\" \"(quote [#foo zz9])\"]]]\n   353\t    (is (= (str/replace (answer plain) \"zz9\" \"%\") (answer line)) line)))\n   354\t\n   355\t\n   356\t(deftest regex-and-anonymous-fn-forms-read-as-on-the-jvm\n   357\t  ;; A `%` after a regex or an anonymous fn literal. Node reads input as\n   358\t  ;; EDN, which has neither form and refuses both; Dart must read them as\n   359\t  ;; the JVM does. (ClojureDart reads only `%1`, `%2`, ... inside `#(...)`.)\n   360\t  (doseq [line [\"(quote [#_#\\\"%\\\" %])\" \"(quote [#_#(+ %1 1) %])\"]]\n   361\t    (let [result (answer line)]\n   362\t      #?(:cljd (is (= \"['%]\" result) line)\n   363\t         :cljs (is (str/starts-with? result \"Error: \") line)\n   364\t         :clj (is (= \"['%]\" result) line)))))\n   365\t\n   366\t\n   367\t(deftest duplicate-percent-keys-are-refused-where-the-reader-refuses-them\n   368\t  ;; The JVM and Node readers refuse duplicate set elements and map keys,\n   369\t  ;; `%` included. ClojureDart's reader refuses no duplicates at all; there\n   370\t  ;; `a-percent-reads-as-any-other-symbol-does` pins that `%` collapses as\n   371\t  ;; any symbol does.\n   372\t  (doseq [[line fragment] [[\"(quote #{% %})\" \"uplicate key: %\"]\n   373\t                           [\"(quote {% 1 % 2})\" \"uplicate key: %\"]]]\n   374\t    (let [[state result] (repl/eval-input (repl/create-state) line)]\n   375\t      #?@(:cljd [(is (not (str/starts-with? result \"Error: \")) (str line \" => \" result))]\n   376\t          :default [(is (str/starts-with? result \"Error: \") (str line \" => \" result))\n   377\t                    (is (str/includes? result fragment) (str line \" => \" result))])\n   378\t      (is (true? (:running? state)) line))))\n   379\t\n   380\t\n   381\t(deftest the-output-drain-is-total-over-next\n   382\t  (testing \"a gap prints a loss notice and resumes at the recovery cursor\"\n   383\t    (let [output (handle 2)\n   384\t          state (repl/create-state {:output-stream output})]\n   385\t      (doseq [n (range 5)]\n   386\t        (stream/append! output {:type :repl/output :op :print :text (str n)}))\n   387\t      (let [[state' text] (repl/drain-output state)]\n   388\t        (is (str/includes? text \"output lost\"))\n   389\t        (is (str/includes? text \"34\"))\n   390\t        (is (= :dao.stream/blocked (get-in state' [:ledger :output])))\n","exit_code":0,"status":"completed"}}
