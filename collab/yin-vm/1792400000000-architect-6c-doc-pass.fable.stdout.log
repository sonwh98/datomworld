{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VVGeutfMYQmNJ9to9gvWcS","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.layout-test\n2\t  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic-register-vm.continuation.md\n3\t   §8.3): the register pairing and live sets, the register destination from\n4\t   A, the stack correspondence, operand layout and K slices, E\n5\t   reconstruction, closures both ways, and the unobservable fill of a\n6\t   lowered tail. The static items run over C, the B0 corpus and the\n7\t   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n8\t   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n9\t  (:require [clojure.test :refer [deftest is testing]]\n10\t            [clojure.walk :as walk]\n11\t            [dao.stream :as stream]\n12\t            [yin.vm :as vm]\n13\t            [yin.vm.debruijn-code :as dcode]\n14\t            [yin.vm.debruijn-register-code :as rcode]\n15\t            [yin.vm.debruijn.stack :as dvm]\n16\t            [yin.vm.engine :as engine]\n17\t            [yin.vm.values :as values]\n18\t            [yin.vm.semantic-register.analysis :as analysis]\n19\t            [yin.vm.semantic-register.code :as code]\n20\t            [yin.vm.semantic-register.corpus :as corpus]\n21\t            [yin.vm.semantic-register.derive :as derive]\n22\t            [yin.vm.semantic-register.layout :as layout]\n23\t            [yin.vm.semantic-register.linearize :as linearize]\n24\t            [yin.vm.semantic-register.safepoint-harness-test :as h]\n25\t            [yin.vm.ucf.v2-support :as s]))\n26\t\n27\t\n28\t(def C\n29\t  \"[label ast]: the harness's layout corpus.\"\n30\t  h/layout-corpus)\n31\t\n32\t\n33\t(defn projected\n34\t  [ast]\n35\t  (:vector (linearize/project ast)))\n36\t\n37\t\n38\t(defn reachable-pcs\n39\t  \"Every pc reachable from its body's start.\"\n40\t  [v]\n41\t  (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v)))\n42\t\n43\t\n44\t(defn boundary?\n45\t  [t]\n46\t  (contains? rcode/boundary-opcodes (nth t 0)))\n47\t\n48\t\n49\t(defn parking?\n50\t  \"A non-tail parking instruction (rule A1).\"\n51\t  [t]\n52\t  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n53\t      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n54\t\n55\t\n56\t;; =============================================================================\n57\t;; 1-2: the register kernel's static layout\n58\t;; =============================================================================\n59\t\n60\t(deftest register-pairing\n61\t  (let [checked (atom [0 0])]\n62\t    (doseq [[label ast] C]\n63\t      (testing (str label)\n64\t        (let [v (projected ast)\n65\t              sg (layout/segment v)\n66\t              bodies (:bodies sg)]\n67\t          ;; phys is total on every body's named virtuals and single-valued\n68\t          (doseq [[pc x s] (:pairs sg)]\n69\t            (is (= s (layout/phys sg pc x)) (str \"pc \" pc \" virtual \" x)))\n70\t          (doseq [b (range (count bodies))]\n71\t            (let [named (into #{} (keep (fn [[pc x]] (when (= b (code/body-index bodies pc)) x))) (:pairs sg))]\n72\t              (is (= named (set (keys (nth (:phys sg) b)))))))\n73\t          ;; virt is single-valued on live-out's physical image\n74\t          (doseq [p (sort (reachable-pcs v))\n75\t                  :when (boundary? (nth v p))]\n76\t            (let [lo (layout/live-out sg p)]\n77\t              (is (= (count lo) (count (set (map #(layout/phys sg p %) lo))))\n78\t                  (str \"distinct live virtuals hold distinct slots at pc \" p))\n79\t              (doseq [x lo]\n80\t                (is (= x (layout/virt sg p (layout/phys sg p x))))))\n81\t            (swap! checked update 1 inc))\n82\t          (swap! checked update 0 inc))))\n83\t    (is (= (count C) (first @checked)))\n84\t    (is (< 50 (second @checked)) \"reachable boundaries checked\")))\n85\t\n86\t\n87\t(deftest register-live-is-live-out\n88\t  (let [tails (atom 0)]\n89\t    (doseq [[label ast] C]\n90\t      (testing (str label)\n91\t        (let [v (projected ast)\n92\t              sg (layout/segment v)]\n93\t          (doseq [p (sort (reachable-pcs v))\n94\t                  :let [t (nth v p)]\n95\t                  :when (boundary? t)]\n96\t            (let [live (nth (nth (:instructions (:register sg)) p) (rcode/live-slot-index (nth t 0)))]\n97\t              (is (= (layout/register-live sg p) live) (str \"pc \" p))\n98\t              (when (code/tail-call? t)\n99\t                (swap! tails inc)\n100\t                (is (= [] live (layout/register-live sg p)) \"a tail boundary's live is []\")))))))\n101\t    (is (pos? @tails))))\n102\t\n103\t\n104\t;; =============================================================================\n105\t;; 3: rd from A, never the physical destination\n106\t;; =============================================================================\n107\t\n108\t(def worked-ast (second (first (filter #(= :worked-example (first %)) corpus/programs))))\n109\t\n110\t\n111\t(defn in-world\n112\t  \"(f machine) of the world build makes on lane, its construction and its\n113\t   layout lookups in one h/scoped: no other fixture's vector is in its\n114\t   space.\"\n115\t  [lane build f]\n116\t  (h/scoped #(f (:machine (h/on-lane lane build)))))\n117\t\n118\t\n119\t(defn lifted-waits\n120\t  \"The canonical wait entries of world machine m: the evaluator's own, or a\n121\t   de Bruijn kernel's through the layout. m's kernel-space is its scope's.\"\n122\t  [m]\n123\t  (if (= :semantic-register (h/lane-of m))\n124\t    (:wait-set m)\n125\t    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n126\t\n127\t\n128\t(deftest register-rd-from-a\n129\t  (testing \"the worked example parked at its inner call\"\n130\t    (h/scoped\n131\t      (fn []\n132\t        (let [m0 (h/on-lane :register h/machine)\n133\t              [sref m1] (engine/attach-resource m0 (s/ring 4))\n134\t              [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n135\t              next! (engine/resolve-var {} {} vm/primitives h/stream-modules 'stream/next!)\n136\t              m (vm/run (h/load-program (assoc m2 :free-env {'f (get vm/primitives 'conj) 'g next! 'x cref 'y 2})\n137\t                                        worked-ast))\n138\t              entry (first (:wait-set m))\n139\t              [p] (lifted-waits m)\n140\t              v (projected worked-ast)]\n141\t          (is (vm/blocked? m))\n142\t          (is (= [:call 2 3 [4] false] (nth v 3)) \"the inner call\")\n143\t          (is (= 4 (:pc p)))\n144\t          (is (= {:deliver :rd :rd 2} (:deliver p)) \"the canonical rd is A's 2\")\n145\t          (is (= 3 (:dest entry)) \"the kernel's dest is the physical 3\")\n146\t          (is (= #{1} (set (keys (:window p)))) \"saved(4, 2)\")))))\n147\t  (testing \"the K frames of :depth-3 take rd from A\"\n148\t    (let [[_ wrap] (nth h/segments 2)\n149\t          build #(h/reader wrap h/read-op)\n150\t          reference (first (:wait-set (:machine (h/on-lane :semantic-register build))))\n151\t          [m [p]] (in-world :register build (juxt identity lifted-waits))\n152\t          entry (first (:wait-set m))]\n153\t      (is (= :depth-3 (first (nth h/segments 2))))\n154\t      (is (= 6 (count (:k p))) \"three bindings, three nest applications\")\n155\t      (is (= (mapv :rd (:k reference)) (mapv :rd (:k p))) \"the evaluator's return destinations\")\n156\t      (is (some (fn [[f kf]] (not= (:rd f) (:dest kf))) (map vector (:k p) (:continuation entry)))\n157\t          \"some physical dest differs from its virtual rd\"))))\n158\t\n159\t\n160\t;; =============================================================================\n161\t;; 4-5: the stack correspondence and operand layout\n162\t;; =============================================================================\n163\t\n164\t(defn family\n165\t  [op]\n166\t  (case op (:load-bound :load-free) :var op))\n167\t\n168\t\n169\t(deftest stack-correspondence\n170\t  (doseq [[label ast] C]\n171\t    (testing (str label)\n172\t      (let [v (projected ast)\n173\t            sg (layout/segment v)\n174\t            h (:stack sg)]\n175\t        (is (= (count v) (count (:a->h sg))) \"one non-push H instruction per A pc\")\n176\t        (is (= (count h) (+ (count v) (count (filter #(= :push (first %)) h)))))\n177\t        (doseq [k (range (count v))]\n178\t          (is (= (nth (nth v k) 0) (family (nth (nth h (nth (:a->h sg) k)) 0)))\n179\t              (str \"the k-th non-push instruction, k = \" k))\n180\t          (is (= k (get (:h->a sg) (nth (:a->h sg) k)))))))))\n181\t\n182\t\n183\t(deftest stack-layout-is-the-saved-set\n184\t  (let [checked (atom 0)]\n185\t    (doseq [[label ast] C]\n186\t      (testing (str label)\n187\t        (let [v (projected ast)\n188\t              sg (layout/segment v)\n189\t              a (:analysis sg)]\n190\t          (doseq [p (sort (reachable-pcs v))\n191\t                  :let [t (nth v p)]\n192\t                  :when (parking? t)]\n193\t            (is (= (analysis/saved a (inc p) (code/rd t)) (set (layout/stack-layout sg p))) (str \"pc \" p))\n194\t            (is (apply distinct? (cons ::bottom (layout/stack-layout sg p))))\n195\t            (swap! checked inc)))))\n196\t    (is (< 20 @checked)))\n197\t  (testing \"the worked cases\"\n198\t    (let [first-call (fn [v] (first (keep-indexed (fn [pc t] (when (= :call (first t)) pc)) v)))]\n199\t      (doseq [ast [worked-ast\n200\t                   (corpus/app (corpus/v 'f) (corpus/if-node (corpus/v 'c) (corpus/app (corpus/v 'g)) (corpus/lit 2))\n201\t                               (corpus/v 'y))]]\n202\t        (let [v (projected ast)\n203\t              sg (layout/segment v)]\n204\t          (is (= [1] (layout/stack-layout sg (first-call v))) \"[f], f in register 1\"))))))\n205\t\n206\t\n207\t;; =============================================================================\n208\t;; 6: K slices partition the operand stack\n209\t;; =============================================================================\n210\t\n211\t(defn stack-frames\n212\t  \"[[A-pc slice] …] for return frames then the current activation of\n213\t   stack entry e of kernel k, reading the kernel's own offset table.\"\n214\t  [k e]\n215\t  (let [sp (h/kernel-space k)\n216\t        a-pc (fn [abs]\n217\t               (let [[ident rel] (dvm/image-pc k abs)\n218\t                     sg (some #(when (= ident (:stack-id %)) %) (vals (:segments sp)))]\n219\t                 [sg (inc (get (:h->a sg) (dec rel)))]))\n220\t        parts (layout/slices (vec (:stack e)) (mapv :stack-base (:continuation e)))]\n221\t    (mapv (fn [abs slice] (conj (a-pc abs) slice))\n222\t          (conj (mapv :return-pc (:continuation e)) (:pc e))\n223\t          parts)))\n224\t\n225\t\n226\t(defn non-tail?\n227\t  \"6c-pre marks a tail call's park :return-result.\"\n228\t  [e]\n229\t  (not= :return-result (:resume-mode e)))\n230\t\n231\t\n232\t(deftest stack-slices-partition\n233\t  (let [checked (atom 0)]\n234\t    (doseq [[row label _ build] (h/lane-cases)\n235\t            :when (contains? #{:bare :depth-3 :unwrapped} label)]\n236\t      (testing (str \"row \" row \" \" (name label))\n237\t        (in-world :stack build\n238\t                  (fn [k]\n239\t                    (doseq [e (concat (:wait-set k) (vals (:parked k)))\n240\t                            :when (non-tail? e)]\n241\t                      (let [frames (stack-frames k e)]\n242\t                        (is (= (vec (:stack e)) (into [] (mapcat #(nth % 2)) frames)) \"the slices partition the stack\")\n243\t                        (doseq [[sg pc slice] frames]\n244\t                          (is (= (count (layout/stack-layout sg (dec pc))) (count slice))))\n245\t                        (swap! checked inc)))))))\n246\t    (is (< 20 @checked)))\n247\t  (testing \"the multi-frame fixture\"\n248\t    (h/scoped\n249\t      (fn []\n250\t        (let [expr (h/cat-of (s/lit [1])\n251\t                             (s/app (s/lam ['x] (h/cat-of (s/lit [2])\n252\t                                                          (s/app (s/lam ['y] (h/cat-of (s/lit [3]) h/read-op))\n253\t                                                                 (s/lit 2))))\n254\t                                    (s/lit 1)))\n255\t              world (h/on-lane :stack #(h/reader identity expr))\n256\t              k (:machine world)\n257\t              e (first (:wait-set k))\n258\t              st (:stack e)]\n259\t          (is (= [0 0 0 2 4] (mapv :stack-base (:continuation e))) \"the bases, pinned from the kernel\")\n260\t          (is (= 6 (count st)))\n261\t          (is (= [[] [] [] 2 2 2] (mapv #(if (empty? %) [] (count %)) (layout/slices (vec st) [0 0 0 2 4]))))\n262\t          (is (= [[1] [2] [3]] (mapv #(nth st %) [1 3 5])) \"each slice holds its activation's cat and literal\")\n263\t          (is (every? values/closure? (map #(nth st %) [0 2 4])))\n264\t          (is (= (vec st) (into [] cat (layout/slices (vec st) [0 0 0 2 4]))))\n265\t          (let [sp (h/kernel-space k)\n266\t                p (layout/lift-state (layout/lift-context k sp (:owner k)) e)\n267\t                fresh (layout/attach-space (h/on-lane :stack h/machine) sp)\n268\t                lowered (layout/lower-state (layout/lower-context fresh sp) p)]\n269\t            (is (= 5 (count (:k p))))\n270\t            (is (= [0 0 0 2 4] (mapv :stack-base (:continuation lowered))) \"the lowering emits the same bases\")\n271\t            (is (= 6 (count (:stack lowered))))\n272\t            (is (= (h/normalize (:stack e)) (h/normalize (:stack lowered))))\n273\t            (stream/append! (s/stream-of k) \"B\")\n274\t            (is (= [1 [2 [3 \"B\"]]] (h/normalize (vm/value (h/drive-local (assoc fresh :wait-set [lowered] :blocked? true\n275\t                                                                                :halted? false :value :yin/blocked\n276\t                                                                                :resources (:resources k))))))\n277\t                \"and it continues\")))))))\n278\t\n279\t\n280\t;; =============================================================================\n281\t;; 7: E reconstruction\n282\t;; =============================================================================\n283\t\n284\t(def env-programs\n285\t  \"The B2 duplicate-parameter, nested-closure and nested-lambdas shapes,\n286\t   each blocked on a read inside its innermost body.\"\n287\t  (let [read-into (fn [& xs] (reduce (fn [acc x] (h/cat-of acc x)) (s/lit []) (concat xs [h/read-op])))]\n288\t    [[:duplicate-param (s/app (s/lam ['x 'x] (read-into (s/v 'x))) (s/lit 1) (s/lit 2)) [2 \"B\"]]\n289\t     [:nested-closure (s/app (s/app (s/lam ['a 'a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n290\t      [nil 2 \"B\"]]\n291\t     [:nested-lambdas (s/app (s/app (s/lam ['a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n292\t      [1 2 \"B\"]]]))\n293\t\n294\t\n295\t(defn envs\n296\t  \"Every E of a machine's canonical waits and parked records, outermost\n297\t   K frame first, values normalised.\"\n298\t  [m]\n299\t  (let [waits (lifted-waits m)\n300\t        parked (if (= :semantic-register (h/lane-of m))\n301\t                 (vals (:parked m))\n302\t                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n303\t    (h/normalize (mapv (fn [p] (conj (mapv :env (:k p)) (:env p))) (concat waits (sort-by :id parked))))))\n304\t\n305\t\n306\t(deftest env-reconstruction\n307\t  (let [checked (atom 0)\n308\t        cases (into (mapv (fn [[row label _ build]] [(str \"row \" row \" \" (name label)) build]) (h/lane-cases))\n309\t                    (map (fn [[label ast]] [(name label) #(h/reader identity ast)]))\n310\t                    env-programs)]\n311\t    (doseq [[label build] cases]\n312\t      (testing label\n313\t        (let [expected (envs (:machine (h/on-lane :semantic-register build)))]\n314\t          (doseq [lane [:stack :register]]\n315\t            (is (= expected (in-world lane build envs)) (str (name lane) \"'s E is the evaluator's\"))\n316\t            (swap! checked inc)))))\n317\t    (is (= (* 2 (+ 61 3)) @checked)))\n318\t  (testing \"row 21: the read's E binds x to 1, the free environment keeps 99\"\n319\t    (let [build #(h/free-env-world identity {'x 99})]\n320\t      (doseq [lane h/lanes]\n321\t        (let [[m [p]] (in-world lane build (juxt identity lifted-waits))]\n322\t          (is (= 1 (get-in p [:env 'x])))\n323\t          (is (= {'x 99} (:free-env m)))))))\n324\t  (testing \"the env programs answer\"\n325\t    (doseq [[label ast expected] env-programs\n326\t            lane h/lanes]\n327\t      (is (= expected (:value (h/reference (h/on-lane lane #(h/reader identity ast))))) (str label \" \" lane)))))\n328\t\n329\t\n330\t;; =============================================================================\n331\t;; 8: closures, canonical and positional, both ways\n332\t;; =============================================================================\n333\t\n334\t(def closure-programs\n335\t  \"\\\"closure value\\\", \\\"higher order\\\" (its closure held across a read)\n336\t   and :duplicate-param, as halted values or lexical bindings.\"\n337\t  [[:closure-value (s/lam ['x] (s/v 'x))]\n338\t   [:higher-order (s/app (s/lam ['f] (h/cat-of (s/app (s/v 'f) (s/lit 5)) h/read-op)) (s/lam ['x] (s/v 'x)))]\n339\t   [:duplicate-param (s/app (s/lam ['x 'x] (s/lam ['y] (s/v 'x))) (s/lit 1) (s/lit 2))]])\n340\t\n341\t\n342\t(defn closures-in\n343\t  [x]\n344\t  (cond\n345\t    (values/closure? x) [x]\n346\t    (map? x) (mapcat closures-in (concat (keys x) (vals x)))\n347\t    (coll? x) (mapcat closures-in x)\n348\t    :else nil))\n349\t\n350\t\n351\t(defn kernel-closures\n352\t  \"Every positional closure of de Bruijn kernel k's value and its waits'\n353\t   frames.\"\n354\t  [k]\n355\t  (closures-in [(:value k) (mapv :frames (:wait-set k))]))\n356\t\n357\t\n358\t(defn canonical-shape\n359\t  \"A canonical closure payload with its segment named by A.\"\n360\t  [address c]\n361\t  (h/normalize (assoc (select-keys c [:params :entry :env]) :segment (address (:segment c)))))\n362\t\n363\t\n364\t(def alpha-renames\n365\t  \"Every binder of closure-programs renamed: an alpha-equivalent A of each,\n366\t   one native image with it.\"\n367\t  '{x other-x y other-y f other-f})\n368\t\n369\t\n370\t(deftest closures-round-trip\n371\t  ;; an unrelated alpha-equivalent of every fixture, projected file-wide\n372\t  ;; first: each world's own scope must not see it\n373\t  (doseq [[_ ast] closure-programs]\n374\t    (h/project (h/with-stream (h/with-cat (walk/postwalk-replace alpha-renames ast)))))\n375\t  (let [checked (atom 0)]\n376\t    (doseq [[label ast] closure-programs\n377\t            lane [:stack :register]]\n378\t      (testing (str (name label) \" \" (name lane))\n379\t        (h/scoped\n380\t          (fn []\n381\t            (let [sr (:machine (h/on-lane :semantic-register #(h/reader identity ast)))\n382\t                  k (:machine (h/on-lane lane #(h/reader identity ast)))\n383\t                  sp (h/kernel-space k)\n384\t                  cx (layout/lift-context k sp (:owner k))\n385\t                  lx (layout/lower-context k sp)\n386\t                  expected (mapv #(canonical-shape (fn [seg] (get-in sr [:code seg :address])) (values/payload %))\n387\t                                 (closures-in [(:value sr) (mapv :env (:wait-set sr))]))\n388\t                  positional (kernel-closures k)\n389\t                  canonical (mapv #(layout/canonical-value cx %) positional)]\n390\t              (is (seq positional))\n391\t              (is (= (set expected) (set (map #(canonical-shape identity (values/payload %)) canonical)))\n392\t                  \"positional -> canonical is the evaluator's closure\")\n393\t              (doseq [[p c] (map vector positional canonical)]\n394\t                (let [back (values/payload (layout/positional-value lx c))]\n395\t                  (is (= (select-keys (values/payload p) [:arity :body-pc :store-of]) (select-keys back [:arity :body-pc :store-of])))\n396\t                  (is (= (h/normalize (values/payload c))\n397\t                         (h/normalize (values/payload (layout/canonical-value cx (layout/positional-value lx c)))))\n398\t                      \"canonical -> positional -> canonical is the identity\")\n399\t                  (if (and (= :duplicate-param label) (= [1 2] (peek (:frames (values/payload p)))))\n400\t                    (is (= [2 2] (peek (:frames back))) \"the shadowed position reads as the visible x\")\n401\t                    (is (= (h/normalize (:frames (values/payload p))) (h/normalize (:frames back)))\n402\t                        \"positional -> canonical -> positional keeps every frame\"))\n403\t                  (swap! checked inc))))))))\n404\t    (is (<= 6 @checked)))\n405\t  (testing \"the duplicate binder's visible value survives\"\n406\t    (let [k (:machine (h/on-lane :stack #(h/reader identity (s/app (second (nth closure-programs 2)) (s/lit 7)))))]\n407\t      (is (= 2 (vm/value k))))))\n408\t\n409\t\n410\t;; =============================================================================\n411\t;; 9: a lowered tail's frames and store-of are unobservable\n412\t;; =============================================================================\n413\t\n414\t(defn tail-lowered\n415\t  \"Row n lifted on the reference lane and lowered into lane, its tail\n416\t   entries' :frames and :store-of replaced by fill when given: the run's\n417\t   observables and the entries as lowered.\"\n418\t  [build lane fill]\n419\t  (let [world (h/on-lane :semantic-register build)\n420\t        {:keys [toy peer serve!]} (h/served #{:reader})\n421\t        wire (h/lane-lift (:machine world) serve!)\n422\t        {:keys [attach!]} (h/recording-attacher toy)\n423\t        recv (h/lane-lower lane {:attach-stream attach!} wire attach!)\n424\t        entries (:wait-set recv)\n425\t        recv (if fill\n426\t               (assoc recv :wait-set (mapv #(if (= :return-result (:resume-mode %)) (merge % fill) %) entries))\n427\t               recv)\n428\t        done (h/satisfy world recv #(h/drive-peers % [peer]))]\n429\t    {:entries entries :observed [(vm/halted? done) (h/normalize (vm/value done)) (h/normalize (vm/store done))]}))\n430\t\n431\t\n432\t(deftest tail-lowering-is-unobservable\n433\t  (let [checked (atom 0)]\n434\t    (doseq [[n build] [[6 #(h/bare 6)] [20 h/tail-effect-halt]]\n435\t            lane [:stack :register]]\n436\t      (testing (str \"row \" n \" \" (name lane))\n437\t        (let [plain (tail-lowered build lane nil)\n438\t              junk (tail-lowered build lane {:frames [[:junk 1] [:junk 2]] :store-of 'junk.mod})\n439\t              [entry] (:entries plain)]\n440\t          (is (= :return-result (:resume-mode entry)))\n441\t          (is (= [] (:frames entry)) \"lowered with []\")\n442\t          (is (nil? (:store-of entry)) \"and no store-of\")\n443\t          (is (= (:observed plain) (:observed junk)) \"arbitrary values change nothing\")\n444\t          (is (= \"B\" (second (:observed plain))))\n445\t          (swap! checked inc))))\n446\t    (is (= 4 @checked) \"rows 6 and 20 on both de Bruijn lanes; 9 and 12 are link rows\")))\n447\t\n448\t\n449\t;; =============================================================================\n450\t;; §4.1: alpha-equivalent segments, one native image, two A\n451\t;; =============================================================================\n452\t;;\n453\t;; Every world's layout lookups run in its own h/scoped; only the\n454\t;; contamination case below reads the file-wide index, explicitly.\n455\t\n456\t(defn binder-program\n457\t  \"A reader parked inside ((fn [sym] (then :alpha (next-of c))) 0).\"\n458\t  [sym]\n459\t  (h/with-stream (h/with-cat (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0)))))\n460\t\n461\t\n462\t(defn binder-world\n463\t  [sym]\n464\t  (h/reader (fn [_] (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0))) h/read-op))\n465\t\n466\t\n467\t(defn alpha-closure\n468\t  [sym]\n469\t  (s/lam [sym] (s/then (s/lit :alpha) (s/v sym))))\n470\t\n471\t\n472\t(defn alpha-world\n473\t  \"Two alpha-equivalent closures in the store, then (b (a \\\"B\\\")) after a\n474\t   read; with :one, both names hold the first and the second is only\n475\t   projected.\"\n476\t  ([] (alpha-world :both))\n477\t  ([carried]\n478\t   (let [m1 (vm/run (h/load-program (h/machine) (alpha-closure 'x)))\n479\t         m2 (vm/run (h/load-program m1 (alpha-closure 'y)))\n480\t         m3 (assoc m2 :store {'a (vm/value m1) 'b (vm/value (if (= :one carried) m1 m2))})\n481\t         m (vm/run (h/load-program m3 (h/with-stream (s/then h/read-op (s/app (s/v 'b) (s/app (s/v 'a) (s/lit \"B\")))))))\n482\t         src (s/stream-of m)]\n483\t     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])})))\n484\t\n485\t\n486\t(defn receiver-image\n487\t  \"The image identity a de Bruijn receiver of kind derives for v (§4.1).\"\n488\t  [kind v]\n489\t  (if (= :stack kind)\n490\t    (dcode/image-hash (:image (derive/stack-image v)))\n491\t    (rcode/register-hash (derive/register-image v))))\n492\t\n493\t\n494\t(deftest alpha-equivalent-segments\n495\t  (testing \"distinct A, one register image, one stack image\"\n496\t    (let [sx (layout/segment (projected (s/lam ['x] (s/v 'x))))\n497\t          sy (layout/segment (projected (s/lam ['y] (s/v 'y))))]\n498\t      (is (not= (:address sx) (:address sy)))\n499\t      (is (= (:register-id sx) (:register-id sy)))\n500\t      (is (= (:stack-id sx) (:stack-id sy)))))\n501\t  (testing \"a de Bruijn source whose space resolves one image to two A refuses the lift before serving\"\n502\t    (let [ax (layout/segment (h/project (binder-program 'x)))\n503\t          ay (layout/segment (h/project (binder-program 'y)))]\n504\t      (is (not= (:address ax) (:address ay)))\n505\t      (is (= [(:register-id ax) (:stack-id ax)] [(:register-id ay) (:stack-id ay)]))\n506\t      (doseq [lane [:stack :register]]\n507\t        (testing (name lane)\n508\t          (let [m (:machine (h/on-lane lane #(binder-world 'x)))\n509\t                n (atom 0)\n510\t                {:keys [serve!]} (h/served #{:reader})\n511\t                counting #(do (swap! n inc) (serve! %))\n512\t                template (h/on-lane :semantic-register h/machine)\n513\t                d (h/error #(layout/lift-task m (layout/space [ax ay]) template counting (h/lift-opts)))]\n514\t            (is (vm/blocked? m))\n515\t            (is (contains? (set (map first (:images m))) (if (= :stack lane) (:stack-id ax) (:register-id ax)))\n516\t                \"the kernel holds the one image\")\n517\t            (is (= [:yin.k/non-portable :ambiguous-image] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n518\t            (is (zero? @n) \"no stream was served\")\n519\t            (testing \", the file-wide code-index widens the space; the world's own does not\"\n520\t              (is (= :ambiguous-image (:yin.k/kind (h/file-wide (fn [] (h/error #(h/lane-lift m counting)))))))\n521\t              (is (zero? @n))\n522\t              (h/scoped (fn []\n523\t                          (let [m (:machine (h/on-lane lane #(binder-world 'x)))]\n524\t                            (is (= #{(:address ax)} (set (keys (:segments (h/kernel-space m))))))\n525\t                            (is (map? (h/lane-lift m serve!)) \"the world's own space lifts\"))))))))))\n526\t  (testing \"a de Bruijn receiver of two A of one image refuses before any attach\"\n527\t    (let [world (alpha-world)\n528\t          addresses (into #{} (map #(:address (layout/segment (projected (alpha-closure %))))) '[x y])]\n529\t      (is (= 2 (count addresses)))\n530\t      (doseq [lane [:stack :register]]\n531\t        (testing (name lane)\n532\t          (let [{:keys [serve! toy]} (h/served #{:reader})\n533\t                wire (h/lane-lift (:machine world) serve!)\n534\t                {:keys [attach!] n :count} (h/recording-attacher toy)\n535\t                d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n536\t            (is (= [:yin.k/unsupported :ambiguous-image] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n537\t            (is (= addresses (:yin.k/segments d)))\n538\t            (is (= (receiver-image lane (projected (alpha-closure 'x))) (:yin.k/image d))\n539\t                \"the receiver's own image identity\")\n540\t            (is (= (receiver-image lane (projected (alpha-closure 'y))) (:yin.k/image d)))\n541\t            (is (zero? @n) \"refused before any attachment\"))))))\n542\t  (testing \"one of the pair carried, the other only projected: no collision\"\n543\t    (doseq [lane [:stack :register]]\n544\t      (testing (name lane)\n545\t        (let [ref (h/reference (alpha-world :one))\n546\t              got (h/crossed :semantic-register lane #(alpha-world :one))]\n547\t          (is (= \"B\" (:value ref)))\n548\t          (is (= 1 (count (h/stream-identities (:wire got)))))\n549\t          (is (= 1 (:attaches got)) \"lowered, one attach\")\n550\t          (is (= (select-keys ref [:halted :value]) (select-keys got [:halted :value])))))))\n551\t  (testing \"the reference lane holds both: laws 1 and 2\"\n552\t    (let [expected (h/reference (alpha-world))]\n553\t      (is (= \"B\" (:value expected)))\n554\t      (is (= \"B\" (:value (h/laws (alpha-world) expected)))))))\n555\t\n556\t\n557\t;; =============================================================================\n558\t;; §6.3: a closure in the free environment, refused on the de Bruijn lanes\n559\t;; =============================================================================\n560\t\n561\t(defn free-closure-world\n562\t  \"An identity closure f the machine's own lane made, held in the free\n563\t   environment, then (then (next-of c) (f \\\"B\\\")) parked on the read.\"\n564\t  []\n565\t  (let [m0 (vm/run (h/load-program (h/machine) (s/lam ['arg] (s/v 'arg))))\n566\t        f (vm/value m0)\n567\t        m1 (cond-> (update m0 :free-env assoc 'f f)\n568\t             (= :semantic-register (h/lane-of m0)) (update :env assoc 'f f))\n569\t        m (vm/run (h/load-program m1 (h/with-stream (s/then h/read-op (s/app (s/v 'f) (s/lit \"B\"))))))\n570\t        src (s/stream-of m)]\n571\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n572\t\n573\t\n574\t(deftest free-env-values\n575\t  (testing \"the reference lane and the carrier admit it\"\n576\t    (let [world (h/on-lane :semantic-register free-closure-world)]\n577\t      (is (values/closure? (get-in world [:machine :free-env 'f])))\n578\t      (is (= \"B\" (:value (h/reference (h/on-lane :semantic-register free-closure-world)))))\n579\t      (is (= \"B\" (:value (h/handed-off world))))))\n580\t  (testing \"a de Bruijn receiver refuses it before any attach\"\n581\t    (doseq [lane [:stack :register]]\n582\t      (testing (name lane)\n583\t        (let [world (h/on-lane :semantic-register free-closure-world)\n584\t              {:keys [serve! toy]} (h/served #{:reader})\n585\t              wire (h/lane-lift (:machine world) serve!)\n586\t              {:keys [attach!] n :count} (h/recording-attacher toy)\n587\t              d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n588\t          (is (= [:yin.k/unsupported :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n589\t          (is (= '[:free-env f] (:yin.k/path d)))\n590\t          (is (zero? @n) \"refused before any attachment\")))))\n591\t  (testing \"a de Bruijn source refuses it before anything is served\"\n592\t    (doseq [lane [:stack :register]]\n593\t      (testing (name lane)\n594\t        (h/scoped\n595\t          (fn []\n596\t            (let [world (h/on-lane lane free-closure-world)\n597\t                  m (:machine world)\n598\t                  n (atom 0)\n599\t                  {:keys [serve!]} (h/served #{:reader})\n600\t                  d (h/error #(h/lane-lift m (fn [x] (swap! n inc) (serve! x))))]\n601\t              (is (= lane (h/lane-of m)))\n602\t              (is (vm/blocked? m))\n603\t              (is (values/closure? (get-in m [:free-env 'f])))\n604\t              (is (= [:yin.k/non-portable :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n605\t              (is (= 'f (:yin.k/key d)))\n606\t              (is (zero? @n) \"no stream was served\"))))))))\n607\t\n608\t\n609\t(def nestings\n610\t  \"[label wrap extract path]: a value one guest collection deep under box,\n611\t   the AST that reads it back, and the refusal's path to it.\"\n612\t  [[:vector (fn [x] [1 [x]]) (s/app (s/v 'first) (s/app (s/v 'first) (s/app (s/v 'rest) (s/v 'box))))\n613\t    '[:free-env box 1 0]]\n614\t   [:map (fn [x] {:nested x}) (s/app (s/v 'get) (s/v 'box) (s/lit :nested)) '[:free-env box 1]]])\n615\t\n616\t\n617\t(def held\n618\t  \"[label made program expected]: (made m) is [value m feed], a value made\n619\t   on m's own lane (feed, a ring the read is answered on, else the\n620\t   program's own stream); program uses the value through extract.\"\n621\t  [[:closure (fn [m] (let [m (vm/run (h/load-program m (s/lam ['arg] (s/v 'arg))))] [(vm/value m) m nil]))\n622\t    (fn [extract] (h/with-stream (s/app extract h/read-op))) \"B\"]\n623\t   ;; captured where box is lexical: its E agrees with any free environment\n624\t   ;; on every other name, so the carrier lifts it beside box (§5.5 frames)\n625\t   [:continuation (fn [m]\n626\t                    (let [m (vm/run (h/load-program m (h/tail (s/app (s/lam ['box] h/capture) (s/lit 0)))))]\n627\t                      [(vm/value m) m nil]))\n628\t    (fn [_] (h/with-stream h/read-op)) \"B\"]\n629\t   [:primitive (fn [m] [(get vm/primitives 'conj) m nil])\n630\t    (fn [extract] (h/with-stream (s/then h/read-op extract))) (get vm/primitives 'conj)]\n631\t   [:cursor (fn [m]\n632\t              (let [ring (s/ring 4)\n633\t                    [sref m] (engine/attach-resource m ring)\n634\t                    [cref m] (engine/handle-cursor m {:stream sref} :held)]\n635\t                [cref m ring]))\n636\t    (fn [extract] (s/next-of extract)) \"B\"]])\n637\t\n638\t\n639\t(defn boxed-world\n640\t  \"A world on the machine's own lane: made's value wrapped under box in\n641\t   the free environment, program parked on its read.\"\n642\t  [made wrap program extract]\n643\t  (let [[x m0 feed] (made (h/machine))\n644\t        box (wrap x)\n645\t        m1 (cond-> (update m0 :free-env assoc 'box box)\n646\t             (= :semantic-register (h/lane-of m0)) (update :env assoc 'box box))\n647\t        m (vm/run (h/load-program m1 (program extract)))\n648\t        src (or feed (s/stream-of m))]\n649\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n650\t\n651\t\n652\t(deftest free-env-nested-values\n653\t  ;; §6.3 through guest collections: a closure or continuation refuses both\n654\t  ;; ways; a primitive and an authentic cursor reference cross and are used\n655\t  (doseq [[nest wrap extract path] nestings\n656\t          [label made program expected] held]\n657\t    (testing (str (name label) \" in a \" (name nest))\n658\t      (let [build #(boxed-world made wrap program extract)\n659\t            procedure? (contains? #{:closure :continuation} label)]\n660\t        (is (= (h/normalize expected) (:value (h/reference (h/on-lane :semantic-register build)))) \"the reference lane\")\n661\t        (doseq [lane [:stack :register]]\n662\t          (testing (str \", lowered into \" (name lane))\n663\t            (if procedure?\n664\t              (let [world (h/on-lane :semantic-register build)\n665\t                    {:keys [serve! toy]} (h/served #{:reader})\n666\t                    wire (h/lane-lift (:machine world) serve!)\n667\t                    {:keys [attach!] n :count} (h/recording-attacher toy)\n668\t                    d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n669\t                (is (= [:yin.k/unsupported :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n670\t                (is (= path (:yin.k/path d)))\n671\t                (is (zero? @n) \"refused before any attachment\"))\n672\t              (let [got (h/crossed :semantic-register lane build)]\n673\t                (is (pos? (:attaches got)))\n674\t                (is (= (count (h/stream-identities (:wire got))) (:attaches got)))\n675\t                (is (= (h/normalize expected) (:value got)) \"admitted, and used through the collection\"))))\n676\t          (testing (str \", lifted from \" (name lane))\n677\t            (if procedure?\n678\t              (h/scoped\n679\t                (fn []\n680\t                  (let [m (:machine (h/on-lane lane build))\n681\t                        n (atom 0)\n682\t                        {:keys [serve!]} (h/served #{:reader})\n683\t                        d (h/error #(h/lane-lift m (fn [x] (swap! n inc) (serve! x))))]\n684\t                    (is (= lane (h/lane-of m)))\n685\t                    (is (vm/blocked? m))\n686\t                    (is (= [:yin.k/non-portable :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n687\t                    (is (= 'box (:yin.k/key d)))\n688\t                    (is (zero? @n) \"no stream was served\"))))\n689\t              (is (= (h/normalize expected) (:value (h/crossed lane :semantic-register build)))\n690\t                  \"admitted, and used through the collection\"))))))))\n691\t"}]},"parent_tool_use_id":null,"session_id":"fc5fbdae-afe7-4b77-8da9-cb26d4729e39","uuid":"b36560bb-0f11-4625-841a-d583c879fe0e","timestamp":"2026-10-12T20:19:39.214Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/.claude/projects/-Users-sto-workspace-datomworld-docs-6c/fc5fbdae-afe7-4b77-8da9-cb26d4729e39/tool-results/b9fvm85tx.txt","content":"(ns yin.vm.semantic-register.layout-test\n  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic-register-vm.continuation.md\n   §8.3): the register pairing and live sets, the register destination from\n   A, the stack correspondence, operand layout and K slices, E\n   reconstruction, closures both ways, and the unobservable fill of a\n   lowered tail. The static items run over C, the B0 corpus and the\n   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.engine :as engine]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.corpus :as corpus]\n            [yin.vm.semantic-register.derive :as derive]\n            [yin.vm.semantic-register.layout :as layout]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.safepoint-harness-test :as h]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(def C\n  \"[label ast]: the harness's layout corpus.\"\n  h/layout-corpus)\n\n\n(defn projected\n  [ast]\n  (:vector (linearize/project ast)))\n\n\n(defn reachable-pcs\n  \"Every pc reachable from its body's start.\"\n  [v]\n  (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v)))\n\n\n(defn boundary?\n  [t]\n  (contains? rcode/boundary-opcodes (nth t 0)))\n\n\n(defn parking?\n  \"A non-tail parking instruction (rule A1).\"\n  [t]\n  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n\n\n;; =============================================================================\n;; 1-2: the register kernel's static layout\n;; =============================================================================\n\n(deftest register-pairing\n  (let [checked (atom [0 0])]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)\n              bodies (:bodies sg)]\n          ;; phys is total on every body's named virtuals and single-valued\n          (doseq [[pc x s] (:pairs sg)]\n            (is (= s (layout/phys sg pc x)) (str \"pc \" pc \" virtual \" x)))\n          (doseq [b (range (count bodies))]\n            (let [named (into #{} (keep (fn [[pc x]] (when (= b (code/body-index bodies pc)) x))) (:pairs sg))]\n              (is (= named (set (keys (nth (:phys sg) b)))))))\n          ;; virt is single-valued on live-out's physical image\n          (doseq [p (sort (reachable-pcs v))\n                  :when (boundary? (nth v p))]\n            (let [lo (layout/live-out sg p)]\n              (is (= (count lo) (count (set (map #(layout/phys sg p %) lo))))\n                  (str \"distinct live virtuals hold distinct slots at pc \" p))\n              (doseq [x lo]\n                (is (= x (layout/virt sg p (layout/phys sg p x))))))\n            (swap! checked update 1 inc))\n          (swap! checked update 0 inc))))\n    (is (= (count C) (first @checked)))\n    (is (< 50 (second @checked)) \"reachable boundaries checked\")))\n\n\n(deftest register-live-is-live-out\n  (let [tails (atom 0)]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)]\n          (doseq [p (sort (reachable-pcs v))\n                  :let [t (nth v p)]\n                  :when (boundary? t)]\n            (let [live (nth (nth (:instructions (:register sg)) p) (rcode/live-slot-index (nth t 0)))]\n              (is (= (layout/register-live sg p) live) (str \"pc \" p))\n              (when (code/tail-call? t)\n                (swap! tails inc)\n                (is (= [] live (layout/register-live sg p)) \"a tail boundary's live is []\")))))))\n    (is (pos? @tails))))\n\n\n;; =============================================================================\n;; 3: rd from A, never the physical destination\n;; =============================================================================\n\n(def worked-ast (second (first (filter #(= :worked-example (first %)) corpus/programs))))\n\n\n(defn in-world\n  \"(f machine) of the world build makes on lane, its construction and its\n   layout lookups in one h/scoped: no other fixture's vector is in its\n   space.\"\n  [lane build f]\n  (h/scoped #(f (:machine (h/on-lane lane build)))))\n\n\n(defn lifted-waits\n  \"The canonical wait entries of world machine m: the evaluator's own, or a\n   de Bruijn kernel's through the layout. m's kernel-space is its scope's.\"\n  [m]\n  (if (= :semantic-register (h/lane-of m))\n    (:wait-set m)\n    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n\n\n(deftest register-rd-from-a\n  (testing \"the worked example parked at its inner call\"\n    (h/scoped\n      (fn []\n        (let [m0 (h/on-lane :register h/machine)\n              [sref m1] (engine/attach-resource m0 (s/ring 4))\n              [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n              next! (engine/resolve-var {} {} vm/primitives h/stream-modules 'stream/next!)\n              m (vm/run (h/load-program (assoc m2 :free-env {'f (get vm/primitives 'conj) 'g next! 'x cref 'y 2})\n                                        worked-ast))\n              entry (first (:wait-set m))\n              [p] (lifted-waits m)\n              v (projected worked-ast)]\n          (is (vm/blocked? m))\n          (is (= [:call 2 3 [4] false] (nth v 3)) \"the inner call\")\n          (is (= 4 (:pc p)))\n          (is (= {:deliver :rd :rd 2} (:deliver p)) \"the canonical rd is A's 2\")\n          (is (= 3 (:dest entry)) \"the kernel's dest is the physical 3\")\n          (is (= #{1} (set (keys (:window p)))) \"saved(4, 2)\")))))\n  (testing \"the K frames of :depth-3 take rd from A\"\n    (let [[_ wrap] (nth h/segments 2)\n          build #(h/reader wrap h/read-op)\n          reference (first (:wait-set (:machine (h/on-lane :semantic-register build))))\n          [m [p]] (in-world :register build (juxt identity lifted-waits))\n          entry (first (:wait-set m))]\n      (is (= :depth-3 (first (nth h/segments 2))))\n      (is (= 6 (count (:k p))) \"three bindings, three nest applications\")\n      (is (= (mapv :rd (:k reference)) (mapv :rd (:k p))) \"the evaluator's return destinations\")\n      (is (some (fn [[f kf]] (not= (:rd f) (:dest kf))) (map vector (:k p) (:continuation entry)))\n          \"some physical dest differs from its virtual rd\"))))\n\n\n;; =============================================================================\n;; 4-5: the stack correspondence and operand layout\n;; =============================================================================\n\n(defn family\n  [op]\n  (case op (:load-bound :load-free) :var op))\n\n\n(deftest stack-correspondence\n  (doseq [[label ast] C]\n    (testing (str label)\n      (let [v (projected ast)\n            sg (layout/segment v)\n            h (:stack sg)]\n        (is (= (count v) (count (:a->h sg))) \"one non-push H instruction per A pc\")\n        (is (= (count h) (+ (count v) (count (filter #(= :push (first %)) h)))))\n        (doseq [k (range (count v))]\n          (is (= (nth (nth v k) 0) (family (nth (nth h (nth (:a->h sg) k)) 0)))\n              (str \"the k-th non-push instruction, k = \" k))\n          (is (= k (get (:h->a sg) (nth (:a->h sg) k)))))))))\n\n\n(deftest stack-layout-is-the-saved-set\n  (let [checked (atom 0)]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)\n              a (:analysis sg)]\n          (doseq [p (sort (reachable-pcs v))\n                  :let [t (nth v p)]\n                  :when (parking? t)]\n            (is (= (analysis/saved a (inc p) (code/rd t)) (set (layout/stack-layout sg p))) (str \"pc \" p))\n            (is (apply distinct? (cons ::bottom (layout/stack-layout sg p))))\n            (swap! checked inc)))))\n    (is (< 20 @checked)))\n  (testing \"the worked cases\"\n    (let [first-call (fn [v] (first (keep-indexed (fn [pc t] (when (= :call (first t)) pc)) v)))]\n      (doseq [ast [worked-ast\n                   (corpus/app (corpus/v 'f) (corpus/if-node (corpus/v 'c) (corpus/app (corpus/v 'g)) (corpus/lit 2))\n                               (corpus/v 'y))]]\n        (let [v (projected ast)\n              sg (layout/segment v)]\n          (is (= [1] (layout/stack-layout sg (first-call v))) \"[f], f in register 1\"))))))\n\n\n;; =============================================================================\n;; 6: K slices partition the operand stack\n;; =============================================================================\n\n(defn stack-frames\n  \"[[A-pc slice] …] for return frames then the current activation of\n   stack entry e of kernel k, reading the kernel's own offset table.\"\n  [k e]\n  (let [sp (h/kernel-space k)\n        a-pc (fn [abs]\n               (let [[ident rel] (dvm/image-pc k abs)\n                     sg (some #(when (= ident (:stack-id %)) %) (vals (:segments sp)))]\n                 [sg (inc (get (:h->a sg) (dec rel)))]))\n        parts (layout/slices (vec (:stack e)) (mapv :stack-base (:continuation e)))]\n    (mapv (fn [abs slice] (conj (a-pc abs) slice))\n          (conj (mapv :return-pc (:continuation e)) (:pc e))\n          parts)))\n\n\n(defn non-tail?\n  \"6c-pre marks a tail call's park :return-result.\"\n  [e]\n  (not= :return-result (:resume-mode e)))\n\n\n(deftest stack-slices-partition\n  (let [checked (atom 0)]\n    (doseq [[row label _ build] (h/lane-cases)\n            :when (contains? #{:bare :depth-3 :unwrapped} label)]\n      (testing (str \"row \" row \" \" (name label))\n        (in-world :stack build\n                  (fn [k]\n                    (doseq [e (concat (:wait-set k) (vals (:parked k)))\n                            :when (non-tail? e)]\n                      (let [frames (stack-frames k e)]\n                        (is (= (vec (:stack e)) (into [] (mapcat #(nth % 2)) frames)) \"the slices partition the stack\")\n                        (doseq [[sg pc slice] frames]\n                          (is (= (count (layout/stack-layout sg (dec pc))) (count slice))))\n                        (swap! checked inc)))))))\n    (is (< 20 @checked)))\n  (testing \"the multi-frame fixture\"\n    (h/scoped\n      (fn []\n        (let [expr (h/cat-of (s/lit [1])\n                             (s/app (s/lam ['x] (h/cat-of (s/lit [2])\n                                                          (s/app (s/lam ['y] (h/cat-of (s/lit [3]) h/read-op))\n                                                                 (s/lit 2))))\n                                    (s/lit 1)))\n              world (h/on-lane :stack #(h/reader identity expr))\n              k (:machine world)\n              e (first (:wait-set k))\n              st (:stack e)]\n          (is (= [0 0 0 2 4] (mapv :stack-base (:continuation e))) \"the bases, pinned from the kernel\")\n          (is (= 6 (count st)))\n          (is (= [[] [] [] 2 2 2] (mapv #(if (empty? %) [] (count %)) (layout/slices (vec st) [0 0 0 2 4]))))\n          (is (= [[1] [2] [3]] (mapv #(nth st %) [1 3 5])) \"each slice holds its activation's cat and literal\")\n          (is (every? values/closure? (map #(nth st %) [0 2 4])))\n          (is (= (vec st) (into [] cat (layout/slices (vec st) [0 0 0 2 4]))))\n          (let [sp (h/kernel-space k)\n                p (layout/lift-state (layout/lift-context k sp (:owner k)) e)\n                fresh (layout/attach-space (h/on-lane :stack h/machine) sp)\n                lowered (layout/lower-state (layout/lower-context fresh sp) p)]\n            (is (= 5 (count (:k p))))\n            (is (= [0 0 0 2 4] (mapv :stack-base (:continuation lowered))) \"the lowering emits the same bases\")\n            (is (= 6 (count (:stack lowered))))\n            (is (= (h/normalize (:stack e)) (h/normalize (:stack lowered))))\n            (stream/append! (s/stream-of k) \"B\")\n            (is (= [1 [2 [3 \"B\"]]] (h/normalize (vm/value (h/drive-local (assoc fresh :wait-set [lowered] :blocked? true\n                                                                                :halted? false :value :yin/blocked\n                                                                                :resources (:resources k))))))\n                \"and it continues\")))))))\n\n\n;; =============================================================================\n;; 7: E reconstruction\n;; =============================================================================\n\n(def env-programs\n  \"The B2 duplicate-parameter, nested-closure and nested-lambdas shapes,\n   each blocked on a read inside its innermost body.\"\n  (let [read-into (fn [& xs] (reduce (fn [acc x] (h/cat-of acc x)) (s/lit []) (concat xs [h/read-op])))]\n    [[:duplicate-param (s/app (s/lam ['x 'x] (read-into (s/v 'x))) (s/lit 1) (s/lit 2)) [2 \"B\"]]\n     [:nested-closure (s/app (s/app (s/lam ['a 'a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n      [nil 2 \"B\"]]\n     [:nested-lambdas (s/app (s/app (s/lam ['a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n      [1 2 \"B\"]]]))\n\n\n(defn envs\n  \"Every E of a machine's canonical waits and parked records, outermost\n   K frame first, values normalised.\"\n  [m]\n  (let [waits (lifted-waits m)\n        parked (if (= :semantic-register (h/lane-of m))\n                 (vals (:parked m))\n                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n    (h/normalize (mapv (fn [p] (conj (mapv :env (:k p)) (:env p))) (concat waits (sort-by :id parked))))))\n\n\n(deftest env-reconstruction\n  (let [checked (atom 0)\n        cases (into (mapv (fn [[row label _ build]] [(str \"row \" row \" \" (name label)) build]) (h/lane-cases))\n                    (map (fn [[label ast]] [(name label) #(h/reader identity ast)]))\n                    env-programs)]\n    (doseq [[label build] cases]\n      (testing label\n        (let [expected (envs (:machine (h/on-lane :semantic-register build)))]\n          (doseq [lane [:stack :register]]\n            (is (= expected (in-world lane build envs)) (str (name lane) \"'s E is the evaluator's\"))\n            (swap! checked inc)))))\n    (is (= (* 2 (+ 61 3)) @checked)))\n  (testing \"row 21: the read's E binds x to 1, the free environment keeps 99\"\n    (let [build #(h/free-env-world identity {'x 99})]\n      (doseq [lane h/lanes]\n        (let [[m [p]] (in-world lane build (juxt identity lifted-waits))]\n          (is (= 1 (get-in p [:env 'x])))\n          (is (= {'x 99} (:free-env m)))))))\n  (testing \"the env programs answer\"\n    (doseq [[label ast expected] env-programs\n            lane h/lanes]\n      (is (= expected (:value (h/reference (h/on-lane lane #(h/reader identity ast))))) (str label \" \" lane)))))\n\n\n;; =============================================================================\n;; 8: closures, canonical and positional, both ways\n;; =============================================================================\n\n(def closure-programs\n  \"\\\"closure value\\\", \\\"higher order\\\" (its closure held across a read)\n   and :duplicate-param, as halted values or lexical bindings.\"\n  [[:closure-value (s/lam ['x] (s/v 'x))]\n   [:higher-order (s/app (s/lam ['f] (h/cat-of (s/app (s/v 'f) (s/lit 5)) h/read-op)) (s/lam ['x] (s/v 'x)))]\n   [:duplicate-param (s/app (s/lam ['x 'x] (s/lam ['y] (s/v 'x))) (s/lit 1) (s/lit 2))]])\n\n\n(defn closures-in\n  [x]\n  (cond\n    (values/closure? x) [x]\n    (map? x) (mapcat closures-in (concat (keys x) (vals x)))\n    (coll? x) (mapcat closures-in x)\n    :else nil))\n\n\n(defn kernel-closures\n  \"Every positional closure of de Bruijn kernel k's value and its waits'\n   frames.\"\n  [k]\n  (closures-in [(:value k) (mapv :frames (:wait-set k))]))\n\n\n(defn canonical-shape\n  \"A canonical closure payload with its segment named by A.\"\n  [address c]\n  (h/normalize (assoc (select-keys c [:params :entry :env]) :segment (address (:segment c)))))\n\n\n(def alpha-renames\n  \"Every binder of closure-programs renamed: an alpha-equivalent A of each,\n   one native image with it.\"\n  '{x other-x y other-y f other-f})\n\n\n(deftest closures-round-trip\n  ;; an unrelated alpha-equivalent of every fixture, projected file-wide\n  ;; first: each world's own scope must not see it\n  (doseq [[_ ast] closure-programs]\n    (h/project (h/with-stream (h/with-cat (walk/postwalk-replace alpha-renames ast)))))\n  (let [checked (atom 0)]\n    (doseq [[label ast] closure-programs\n            lane [:stack :register]]\n      (testing (str (name label) \" \" (name lane))\n        (h/scoped\n          (fn []\n            (let [sr (:machine (h/on-lane :semantic-register #(h/reader identity ast)))\n                  k (:machine (h/on-lane lane #(h/reader identity ast)))\n                  sp (h/kernel-space k)\n                  cx (layout/lift-context k sp (:owner k))\n                  lx (layout/lower-context k sp)\n                  expected (mapv #(canonical-shape (fn [seg] (get-in sr [:code seg :address])) (values/payload %))\n                                 (closures-in [(:value sr) (mapv :env (:wait-set sr))]))\n                  positional (kernel-closures k)\n                  canonical (mapv #(layout/canonical-value cx %) positional)]\n              (is (seq positional))\n              (is (= (set expected) (set (map #(canonical-shape identity (values/payload %)) canonical)))\n                  \"positional -> canonical is the evaluator's closure\")\n              (doseq [[p c] (map vector positional canonical)]\n                (let [back (values/payload (layout/positional-value lx c))]\n                  (is (= (select-keys (values/payload p) [:arity :body-pc :store-of]) (select-keys back [:arity :body-pc :store-of])))\n                  (is (= (h/normalize (values/payload c))\n                         (h/normalize (values/payload (layout/canonical-value cx (layout/positional-value lx c)))))\n                      \"canonical -> positional -> canonical is the identity\")\n                  (if (and (= :duplicate-param label) (= [1 2] (peek (:frames (values/payload p)))))\n                    (is (= [2 2] (peek (:frames back))) \"the shadowed position reads as the visible x\")\n                    (is (= (h/normalize (:frames (values/payload p))) (h/normalize (:frames back)))\n                        \"positional -> canonical -> positional keeps every frame\"))\n                  (swap! checked inc))))))))\n    (is (<= 6 @checked)))\n  (testing \"the duplicate binder's visible value survives\"\n    (let [k (:machine (h/on-lane :stack #(h/reader identity (s/app (second (nth closure-programs 2)) (s/lit 7)))))]\n      (is (= 2 (vm/value k))))))\n\n\n;; =============================================================================\n;; 9: a lowered tail's frames and store-of are unobservable\n;; =============================================================================\n\n(defn tail-lowered\n  \"Row n lifted on the reference lane and lowered into lane, its tail\n   entries' :frames and :store-of replaced by fill when given: the run's\n   observables and the entries as lowered.\"\n  [build lane fill]\n  (let [world (h/on-lane :semantic-register build)\n        {:keys [toy peer serve!]} (h/served #{:reader})\n        wire (h/lane-lift (:machine world) serve!)\n        {:keys [attach!]} (h/recording-attacher toy)\n        recv (h/lane-lower lane {:attach-stream attach!} wire attach!)\n        entries (:wait-set recv)\n        recv (if fill\n               (assoc recv :wait-set (mapv #(if (= :return-result (:resume-mode %)) (merge % fill) %) entries))\n               recv)\n        done (h/satisfy world recv #(h/drive-peers % [peer]))]\n    {:entries entries :observed [(vm/halted? done) (h/normalize (vm/value done)) (h/normalize (vm/store done))]}))\n\n\n(deftest tail-lowering-is-unobservable\n  (let [checked (atom 0)]\n    (doseq [[n build] [[6 #(h/bare 6)] [20 h/tail-effect-halt]]\n            lane [:stack :register]]\n      (testing (str \"row \" n \" \" (name lane))\n        (let [plain (tail-lowered build lane nil)\n              junk (tail-lowered build lane {:frames [[:junk 1] [:junk 2]] :store-of 'junk.mod})\n              [entry] (:entries plain)]\n          (is (= :return-result (:resume-mode entry)))\n          (is (= [] (:frames entry)) \"lowered with []\")\n          (is (nil? (:store-of entry)) \"and no store-of\")\n          (is (= (:observed plain) (:observed junk)) \"arbitrary values change nothing\")\n          (is (= \"B\" (second (:observed plain))))\n          (swap! checked inc))))\n    (is (= 4 @checked) \"rows 6 and 20 on both de Bruijn lanes; 9 and 12 are link rows\")))\n\n\n;; =============================================================================\n;; §4.1: alpha-equivalent segments, one native image, two A\n;; =============================================================================\n;;\n;; Every world's layout lookups run in its own h/scoped; only the\n;; contamination case below reads the file-wide index, explicitly.\n\n(defn binder-program\n  \"A reader parked inside ((fn [sym] (then :alpha (next-of c))) 0).\"\n  [sym]\n  (h/with-stream (h/with-cat (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0)))))\n\n\n(defn binder-world\n  [sym]\n  (h/reader (fn [_] (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0))) h/read-op))\n\n\n(defn alpha-closure\n  [sym]\n  (s/lam [sym] (s/then (s/lit :alpha) (s/v sym))))\n\n\n(defn alpha-world\n  \"Two alpha-equivalent closures in the store, then (b (a \\\"B\\\")) after a\n   read; with :one, both names hold the first and the second is only\n   projected.\"\n  ([] (alpha-world :both))\n  ([carried]\n   (let [m1 (vm/run (h/load-program (h/machine) (alpha-closure 'x)))\n         m2 (vm/run (h/load-program m1 (alpha-closure 'y)))\n         m3 (assoc m2 :store {'a (vm/value m1) 'b (vm/value (if (= :one carried) m1 m2))})\n         m (vm/run (h/load-program m3 (h/with-stream (s/then h/read-op (s/app (s/v 'b) (s/app (s/v 'a) (s/lit \"B\")))))))\n         src (s/stream-of m)]\n     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])})))\n\n\n(defn receiver-image\n  \"The image identity a de Bruijn receiver of kind derives for v (§4.1).\"\n  [kind v]\n  (if (= :stack kind)\n    (dcode/image-hash (:image (derive/stack-image v)))\n    (rcode/register-hash (derive/register-image v))))\n\n\n(deftest alpha-equivalent-segments\n  (testing \"distinct A, one register image, one stack image\"\n    (let [sx (layout/segment (projected (s/lam ['x] (s/v 'x))))\n          sy (layout/segment (projected (s/lam ['y] (s/v 'y))))]\n      (is (not= (:address sx) (:address sy)))\n      (is (= (:register-id sx) (:register-id sy)))\n      (is (= (:stack-id sx) (:stack-id sy)))))\n  (testing \"a de Bruijn source whose space resolves one image to two A refuses the lift before serving\"\n    (let [ax (layout/segment (h/project (binder-program 'x)))\n          ay (layout/segment (h/project (binder-program 'y)))]\n      (is (not= (:address ax) (:address ay)))\n      (is (= [(:register-id ax) (:stack-id ax)] [(:register-id ay) (:stack-id ay)]))\n      (doseq [lane [:stack :register]]\n        (testing (name lane)\n          (let [m (:machine (h/on-lane lane #(binder-world 'x)))\n                n (atom 0)\n                {:keys [serve!]} (h/served #{:reader})\n                counting #(do (swap! n inc) (serve! %))\n                template (h/on-lane :semantic-register h/machine)\n                d (h/error #(layout/lift-task m (layout/space [ax ay]) template counting (h/lift-opts)))]\n            (is (vm/blocked? m))\n            (is (contains? (set (map first (:images m))) (if (= :stack lane) (:stack-id ax) (:register-id ax)))\n                \"the kernel holds the one image\")\n            (is (= [:yin.k/non-portable :ambiguous-image] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n            (is (zero? @n) \"no stream was served\")\n            (testing \", the file-wide code-index widens the space; the world's own does not\"\n              (is (= :ambiguous-image (:yin.k/kind (h/file-wide (fn [] (h/error #(h/lane-lift m counting)))))))\n              (is (zero? @n))\n              (h/scoped (fn []\n                          (let [m (:machine (h/on-lane lane #(binder-world 'x)))]\n                            (is (= #{(:address ax)} (set (keys (:segments (h/kernel-space m))))))\n                            (is (map? (h/lane-lift m serve!)) \"the world's own space lifts\"))))))))))\n  (testing \"a de Bruijn receiver of two A of one image refuses before any attach\"\n    (let [world (alpha-world)\n          addresses (into #{} (map #(:address (layout/segment (projected (alpha-closure %))))) '[x y])]\n      (is (= 2 (count addresses)))\n      (doseq [lane [:stack :register]]\n        (testing (name lane)\n          (let [{:keys [serve! toy]} (h/served #{:reader})\n                wire (h/lane-lift (:machine world) serve!)\n                {:keys [attach!] n :count} (h/recording-attacher toy)\n                d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n            (is (= [:yin.k/unsupported :ambiguous-image] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n            (is (= addresses (:yin.k/segments d)))\n            (is (= (receiver-image lane (projected (alpha-closure 'x))) (:yin.k/image d))\n                \"the receiver's own image identity\")\n            (is (= (receiver-image lane (projected (alpha-closure 'y))) (:yin.k/image d)))\n            (is (zero? @n) \"refused before any attachment\"))))))\n  (testing \"one of the pair carried, the other only projected: no collision\"\n    (doseq [lane [:stack :register]]\n      (testing (name lane)\n        (let [ref (h/reference (alpha-world :one))\n              got (h/crossed :semantic-register lane #(alpha-world :one))]\n          (is (= \"B\" (:value ref)))\n          (is (= 1 (count (h/stream-identities (:wire got)))))\n          (is (= 1 (:attaches got)) \"lowered, one attach\")\n          (is (= (select-keys ref [:halted :value]) (select-keys got [:halted :value])))))))\n  (testing \"the reference lane holds both: laws 1 and 2\"\n    (let [expected (h/reference (alpha-world))]\n      (is (= \"B\" (:value expected)))\n      (is (= \"B\" (:value (h/laws (alpha-world) expected)))))))\n\n\n;; =============================================================================\n;; §6.3: a closure in the free environment, refused on the de Bruijn lanes\n;; =============================================================================\n\n(defn free-closure-world\n  \"An identity closure f the machine's own lane made, held in the free\n   environment, then (then (next-of c) (f \\\"B\\\")) parked on the read.\"\n  []\n  (let [m0 (vm/run (h/load-program (h/machine) (s/lam ['arg] (s/v 'arg))))\n        f (vm/value m0)\n        m1 (cond-> (update m0 :free-env assoc 'f f)\n             (= :semantic-register (h/lane-of m0)) (update :env assoc 'f f))\n        m (vm/run (h/load-program m1 (h/with-stream (s/then h/read-op (s/app (s/v 'f) (s/lit \"B\"))))))\n        src (s/stream-of m)]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n(deftest free-env-values\n  (testing \"the reference lane and the carrier admit it\"\n    (let [world (h/on-lane :semantic-register free-closure-world)]\n      (is (values/closure? (get-in world [:machine :free-env 'f])))\n      (is (= \"B\" (:value (h/reference (h/on-lane :semantic-register free-closure-world)))))\n      (is (= \"B\" (:value (h/handed-off world))))))\n  (testing \"a de Bruijn receiver refuses it before any attach\"\n    (doseq [lane [:stack :register]]\n      (testing (name lane)\n        (let [world (h/on-lane :semantic-register free-closure-world)\n              {:keys [serve! toy]} (h/served #{:reader})\n              wire (h/lane-lift (:machine world) serve!)\n              {:keys [attach!] n :count} (h/recording-attacher toy)\n              d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n          (is (= [:yin.k/unsupported :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n          (is (= '[:free-env f] (:yin.k/path d)))\n          (is (zero? @n) \"refused before any attachment\")))))\n  (testing \"a de Bruijn source refuses it before anything is served\"\n    (doseq [lane [:stack :register]]\n      (testing (name lane)\n        (h/scoped\n          (fn []\n            (let [world (h/on-lane lane free-closure-world)\n                  m (:machine world)\n                  n (atom 0)\n                  {:keys [serve!]} (h/served #{:reader})\n                  d (h/error #(h/lane-lift m (fn [x] (swap! n inc) (serve! x))))]\n              (is (= lane (h/lane-of m)))\n              (is (vm/blocked? m))\n              (is (values/closure? (get-in m [:free-env 'f])))\n              (is (= [:yin.k/non-portable :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n              (is (= 'f (:yin.k/key d)))\n              (is (zero? @n) \"no stream was served\"))))))))\n\n\n(def nestings\n  \"[label wrap extract path]: a value one guest collection deep under box,\n   the AST that reads it back, and the refusal's path to it.\"\n  [[:vector (fn [x] [1 [x]]) (s/app (s/v 'first) (s/app (s/v 'first) (s/app (s/v 'rest) (s/v 'box))))\n    '[:free-env box 1 0]]\n   [:map (fn [x] {:nested x}) (s/app (s/v 'get) (s/v 'box) (s/lit :nested)) '[:free-env box 1]]])\n\n\n(def held\n  \"[label made program expected]: (made m) is [value m feed], a value made\n   on m's own lane (feed, a ring the read is answered on, else the\n   program's own stream); program uses the value through extract.\"\n  [[:closure (fn [m] (let [m (vm/run (h/load-program m (s/lam ['arg] (s/v 'arg))))] [(vm/value m) m nil]))\n    (fn [extract] (h/with-stream (s/app extract h/read-op))) \"B\"]\n   ;; captured where box is lexical: its E agrees with any free environment\n   ;; on every other name, so the carrier lifts it beside box (§5.5 frames)\n   [:continuation (fn [m]\n                    (let [m (vm/run (h/load-program m (h/tail (s/app (s/lam ['box] h/capture) (s/lit 0)))))]\n                      [(vm/value m) m nil]))\n    (fn [_] (h/with-stream h/read-op)) \"B\"]\n   [:primitive (fn [m] [(get vm/primitives 'conj) m nil])\n    (fn [extract] (h/with-stream (s/then h/read-op extract))) (get vm/primitives 'conj)]\n   [:cursor (fn [m]\n              (let [ring (s/ring 4)\n                    [sref m] (engine/attach-resource m ring)\n                    [cref m] (engine/handle-cursor m {:stream sref} :held)]\n                [cref m ring]))\n    (fn [extract] (s/next-of extract)) \"B\"]])\n\n\n(defn boxed-world\n  \"A world on the machine's own lane: made's value wrapped under box in\n   the free environment, program parked on its read.\"\n  [made wrap program extract]\n  (let [[x m0 feed] (made (h/machine))\n        box (wrap x)\n        m1 (cond-> (update m0 :free-env assoc 'box box)\n             (= :semantic-register (h/lane-of m0)) (update :env assoc 'box box))\n        m (vm/run (h/load-program m1 (program extract)))\n        src (or feed (s/stream-of m))]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n(deftest free-env-nested-values\n  ;; §6.3 through guest collections: a closure or continuation refuses both\n  ;; ways; a primitive and an authentic cursor reference cross and are used\n  (doseq [[nest wrap extract path] nestings\n          [label made program expected] held]\n    (testing (str (name label) \" in a \" (name nest))\n      (let [build #(boxed-world made wrap program extract)\n            procedure? (contains? #{:closure :continuation} label)]\n        (is (= (h/normalize expected) (:value (h/reference (h/on-lane :semantic-register build)))) \"the reference lane\")\n        (doseq [lane [:stack :register]]\n          (testing (str \", lowered into \" (name lane))\n            (if procedure?\n              (let [world (h/on-lane :semantic-register build)\n                    {:keys [serve! toy]} (h/served #{:reader})\n                    wire (h/lane-lift (:machine world) serve!)\n                    {:keys [attach!] n :count} (h/recording-attacher toy)\n                    d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n                (is (= [:yin.k/unsupported :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n                (is (= path (:yin.k/path d)))\n                (is (zero? @n) \"refused before any attachment\"))\n              (let [got (h/crossed :semantic-register lane build)]\n                (is (pos? (:attaches got)))\n                (is (= (count (h/stream-identities (:wire got))) (:attaches got)))\n                (is (= (h/normalize expected) (:value got)) \"admitted, and used through the collection\"))))\n          (testing (str \", lifted from \" (name lane))\n            (if procedure?\n              (h/scoped\n                (fn []\n                  (let [m (:machine (h/on-lane lane build))\n                        n (atom 0)\n                        {:keys [serve!]} (h/served #{:reader})\n                        d (h/error #(h/lane-lift m (fn [x] (swap! n inc) (serve! x))))]\n                    (is (= lane (h/lane-of m)))\n                    (is (vm/blocked? m))\n                    (is (= [:yin.k/non-portable :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n                    (is (= 'box (:yin.k/key d)))\n                    (is (zero? @n) \"no stream was served\"))))\n              (is (= (h/normalize expected) (:value (h/crossed lane :semantic-register build)))\n                  \"admitted, and used through the collection\"))))))))\n","numLines":691,"startLine":1,"totalLines":691}},"tool_result_meta":[{"id":"toolu_01VVGeutfMYQmNJ9to9gvWcS","permission_decision":{"decision":"accept","source":"config","reason_type":"other"}}]}
