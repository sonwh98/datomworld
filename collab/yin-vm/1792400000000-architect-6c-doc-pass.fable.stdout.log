\n86\t+\n87\t+\n88\t+(def lanes [:semantic-register :stack :register])\n89\t+\n90\t+\n91\t+(defn- composition\n92\t+  [opts]\n93\t+  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n94\t+          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n95\t+          :modules stream-modules}\n96\t+         opts))\n97\t+\n98\t+\n99\t+(defn- kernel-opts\n100\t+  \"A de Bruijn kernel's options for the same composition: the full\n101\t+   primitive table, and the initial environment as :free-env.\"\n102\t+  [opts]\n103\t+  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n104\t+    (contains? opts :env) (assoc :free-env (:env opts))))\n105\t+\n106\t+\n107\t (defn machine\n108\t   ([] (machine {}))\n109\t   ([opts]\n110\t-   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n111\t-                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n112\t-                         :modules stream-modules}\n113\t-                        opts))))\n114\t+   (case *lane*\n115\t+     :semantic-register (sr/create-vm (composition opts))\n116\t+     :stack (dvm/create-vm [] (kernel-opts opts))\n117\t+     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n118\t+\n119\t+\n120\t+(defn lane-of\n121\t+  [m]\n122\t+  (let [f (:format (module/link-format m))]\n123\t+    (cond (= dvm/format-tag f) :stack\n124\t+          (= rvm/format-tag f) :register\n125\t+          :else :semantic-register)))\n126\t+\n127\t+\n128\t+(def segment-of\n129\t+  \"layout/segment, once per A.\"\n130\t+  (memoize layout/segment))\n131\t+\n132\t+\n133\t+(defn kernel-space\n134\t+  \"The layout space of the A vectors whose images de Bruijn kernel k\n135\t+   holds, among those this world projected (`scoped`), or the file ever\n136\t+   projected (`file-wide`). Unbound, it throws: an independent world's\n137\t+   lookups never read another fixture's vectors.\"\n138\t+  [k]\n139\t+  (when-not *projected*\n140\t+    (throw (ex-info \"kernel-space outside scoped or file-wide\" {})))\n141\t+  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n142\t+        held (into #{} (map first) (:images k))]\n143\t+    (layout/space (filter #(contains? held (id %)) (map segment-of (vals @*projected*))))))\n144\t+\n145\t+\n146\t+(defn- kernel-load\n147\t+  \"Attach v's derived image and start it at its row, beside whatever the\n148\t+   kernel already holds: parked records keep naming their own rows.\"\n149\t+  [k v]\n150\t+  (let [kind (lane-of k)\n151\t+        sg (segment-of v)\n152\t+        k (if (= :stack kind)\n153\t+            (dvm/attach-image k (:stack sg) vm/stack-contract)\n154\t+            (rvm/attach-image k (:register sg) vm/register-contract))\n155\t+        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n156\t+                 :halted? false :blocked? false :value nil)]\n157\t+    (if (= :stack kind)\n158\t+      (assoc k :stack [])\n159\t+      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n160\t \n161\t \n162\t (defn load-program\n163\t   [m ast]\n164\t-  (sr/load-vector m (project ast) code/contract))\n165\t+  (if (= :semantic-register (lane-of m))\n166\t+    (sr/load-vector m (project ast) code/contract)\n167\t+    (kernel-load m (project ast))))\n168\t+\n169\t+\n170\t+(defn lane-closure\n171\t+  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n172\t+  [m c]\n173\t+  (if (= :semantic-register (lane-of m))\n174\t+    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n175\t+    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n176\t \n177\t \n178\t (defn lift-opts\n179\t@@ -301,16 +420,17 @@\n180\t    else reaches, named by a module closure in the task store.\"\n181\t   [wrap]\n182\t   (let [ring (s/ring 4)\n183\t-        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n184\t+        ast (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))\n185\t+        v (project ast)\n186\t+        m (vm/run (load-program (machine) ast))\n187\t         cursor (fn [m]\n188\t                  (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n189\t                    (engine/handle-cursor m {:stream ref} id)))\n190\t         [c1 m] (cursor m)\n191\t         [c2 m] (cursor m)\n192\t-        [seg image] (first (:code m))\n193\t-        closure (first (filter #(= :closure (first %)) (:vector image)))\n194\t-        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n195\t-                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n196\t+        closure (first (filter #(= :closure (first %)) v))\n197\t+        clo (lane-closure m {:type :closure :params (nth closure 2) :entry (nth closure 3)\n198\t+                             :segment (jing/segment-key v) :env {engine/store-of-key 'host.mod}})]\n199\t     (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n200\t \n201\t \n202\t@@ -1290,3 +1410,521 @@\n203\t       (is (= (count (stream-identities wire)) n))\n204\t       (is (zero? none) \"refused before any attachment\")\n205\t       (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n206\t+\n207\t+\n208\t+;; =============================================================================\n209\t+;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n210\t+;; =============================================================================\n211\t+\n212\t+(def link-rows\n213\t+  \"Rows the de Bruijn lanes do not carry (§5.3, the shared fragment): a\n214\t+   de Bruijn kernel links a native image while module responses carry A,\n215\t+   and §4 defines no layout for install children (canonical-task refuses\n216\t+   :installs). The reference lane runs the whole matrix; these lanes are\n217\t+   removed with their kernels at phase 8.\"\n218\t+  #{7 8 9 10 11 12 17})\n219\t+\n220\t+\n221\t+(def lane-rows\n222\t+  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n223\t+  (filterv #(not (contains? link-rows (first %))) rows))\n224\t+\n225\t+\n226\t+(defn lane-cases\n227\t+  \"§5.3's shared fragment: 15 lane rows x 4 segments, plus row 20 once:\n228\t+   [row segment expected build].\"\n229\t+  []\n230\t+  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n231\t+\n232\t+\n233\t+(defn on-lane\n234\t+  [lane build]\n235\t+  (binding [*lane* lane] (build)))\n236\t+\n237\t+\n238\t+(defn lane-lift\n239\t+  \"The lift of §7.1 on m's own lane.\"\n240\t+  [m serve!]\n241\t+  (if (= :semantic-register (lane-of m))\n242\t+    (rows/lift-task m serve! (lift-opts))\n243\t+    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n244\t+\n245\t+\n246\t+(defn lane-lower\n247\t+  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n248\t+  [lane opts wire attach!]\n249\t+  (let [scratch (on-lane :semantic-register #(machine opts))]\n250\t+    (if (= :semantic-register lane)\n251\t+      (rows/lower-task scratch wire attach!)\n252\t+      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n253\t+\n254\t+\n255\t+(defn injective\n256\t+  \"names, refusing when two identities share a logical name (§5.5).\"\n257\t+  [names]\n258\t+  (when-not (= (count names) (count (distinct (vals names))))\n259\t+    (throw (ex-info \"The correspondence is not injective\" {:law-4 :injective :names names})))\n260\t+  names)\n261\t+\n262\t+\n263\t+(defn logical-names\n264\t+  \"§5.5's explicit correspondence: each served identity to the resource\n265\t+   key the lifted machine holds that handle under. The fixture builds the\n266\t+   same program on every lane, so one key names one logical stream.\"\n267\t+  [m peer]\n268\t+  (injective\n269\t+    (into {} (map (fn [[id e]]\n270\t+                    [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n271\t+                            (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n272\t+          @(:table peer))))\n273\t+\n274\t+\n275\t+(defn ring-names\n276\t+  \"{stream identity -> resource key} over every stream m holds.\"\n277\t+  [m]\n278\t+  (injective\n279\t+    (into {} (keep (fn [[k h]]\n280\t+                     (when (satisfies? stream/IDaoStreamDescriptor h)\n281\t+                       [(:dao.stream/identity (stream/descriptor h)) k])))\n282\t+          (:resources m))))\n283\t+\n284\t+\n285\t+(defn logical-positions\n286\t+  \"The task with each cursor position's embedded stream identity renamed\n287\t+   to its logical name. A ring buffer cursor carries its stream's\n288\t+   identity, which §5.5's marker substitution does not reach, so the\n289\t+   cross-lane comparison renames only that field, under the same fixture\n290\t+   correspondence; every other field, the offset included, is kept.\"\n291\t+  [task m]\n292\t+  (let [names (ring-names m)\n293\t+        k :dao.stream.ringbuffer/identity]\n294\t+    (replace-nodes task #(= :cursor-cell-body (:kind %))\n295\t+                   (fn [n]\n296\t+                     (update-in n [:slots 1]\n297\t+                                (fn [p]\n298\t+                                  (if (and (map? p) (contains? names (get p k)))\n299\t+                                    (assoc p k (get names (get p k)))\n300\t+                                    p)))))))\n301\t+\n302\t+\n303\t+(defn rename-identities\n304\t+  \"x with every :dao.stream/identity value that names maps renamed.\"\n305\t+  [x names]\n306\t+  (cond\n307\t+    (map? x) (into {} (map (fn [[k v]]\n308\t+                             [k (if (and (= :dao.stream/identity k) (contains? names v))\n309\t+                                  (get names v)\n310\t+                                  (rename-identities v names))]))\n311\t+                   x)\n312\t+    (vector? x) (mapv #(rename-identities % names) x)\n313\t+    :else x))\n314\t+\n315\t+\n316\t+(defn logical-descriptors\n317\t+  \"§5.5: {logical name -> stream descriptor, identities renamed} over every\n318\t+   stream m holds. canonical-under erases a marker's descriptor, so the\n319\t+   lanes' descriptors are shown equivalent on these, separately.\"\n320\t+  [m]\n321\t+  (let [names (ring-names m)]\n322\t+    (into {} (keep (fn [[k h]]\n323\t+                     (when (satisfies? stream/IDaoStreamDescriptor h)\n324\t+                       [k (rename-identities (stream/descriptor h) names)])))\n325\t+          (:resources m))))\n326\t+\n327\t+\n328\t+(defn descriptors-equivalent?\n329\t+  \"Each lane's logical-descriptors, one per lane: equal maps.\"\n330\t+  [ds]\n331\t+  (apply = ds))\n332\t+\n333\t+\n334\t+(defn identities-in\n335\t+  \"The members of ids anywhere in x.\"\n336\t+  [x ids]\n337\t+  (cond\n338\t+    (contains? ids x) #{x}\n339\t+    (map? x) (into #{} (mapcat #(identities-in % ids)) (concat (keys x) (vals x)))\n340\t+    (coll? x) (into #{} (mapcat #(identities-in % ids)) x)\n341\t+    :else #{}))\n342\t+\n343\t+\n344\t+(defn task-root\n345\t+  \"§5.5 over decoded task: positions renamed, re-emitted, then\n346\t+   canonical-under the served correspondence; no lane identity survives.\"\n347\t+  [task m peer]\n348\t+  (let [names (logical-names m peer)\n349\t+        canonical (rows/canonical-under (rows/emit (logical-positions task m)) names)]\n350\t+    (is (empty? (identities-in (:yin.k/rows canonical) (into (set (keys names)) (keys (ring-names m)))))\n351\t+        \"every lane identity was renamed\")\n352\t+    (:yin.k/root canonical)))\n353\t+\n354\t+\n355\t+(defn logical-root\n356\t+  \"§5.5: the lift's root id with every lane identity replaced by the\n357\t+   fixture's logical name.\"\n358\t+  [wire m peer]\n359\t+  (task-root (rows/decode wire) m peer))\n360\t+\n361\t+\n362\t+(defn lane-root\n363\t+  \"Build on lane, lift: {:root under the logical names, :reference the\n364\t+   lane's own run, :lane the kernel the world ran on, :descriptors, and\n365\t+   :task :machine :peer for the controls}. A world's :served replaces\n366\t+   `served`.\"\n367\t+  [lane build]\n368\t+  (scoped\n369\t+    (fn []\n370\t+      (let [world (on-lane lane build)\n371\t+            m (:machine world)\n372\t+            {:keys [serve! peer]} ((or (:served world) served) (or (:surfaces world) #{:reader}))\n373\t+            task (rows/decode (lane-lift m serve!))]\n374\t+        (is (nil? (rows/validate-frames task)) \"law 6 on every lane\")\n375\t+        {:root (task-root task m peer)\n376\t+         :reference (reference (on-lane lane build))\n377\t+         :lane (lane-of m) :descriptors (logical-descriptors m)\n378\t+         :task task :machine m :peer peer}))))\n379\t+\n380\t+\n381\t+(defn canonical-equality\n382\t+  \"Law 4 for one case: exactly the three distinct kernel lanes lift to one\n383\t+   root, their streams' descriptors are equivalent under the\n384\t+   correspondence (else it throws, :law-4 :descriptors), and each lane's\n385\t+   own run answers the reference.\"\n386\t+  [build expected]\n387\t+  (let [roots (mapv #(lane-root % build) lanes)]\n388\t+    (is (= 3 (count roots)))\n389\t+    (is (= [:semantic-register :stack :register] (mapv :lane roots)) \"three distinct kernel lanes\")\n390\t+    (is (apply = (map :root roots)) \"law 4: one root id on every lane\")\n391\t+    (when-not (descriptors-equivalent? (mapv :descriptors roots))\n392\t+      (throw (ex-info \"The descriptors differ under the correspondence\"\n393\t+                      {:law-4 :descriptors :descriptors (mapv :descriptors roots)})))\n394\t+    (doseq [{:keys [lane reference]} roots]\n395\t+      (is (:halted reference) (str lane \" completes\"))\n396\t+      (when (some? expected) (is (= expected (:value reference)) (str lane \" answers the reference\"))))\n397\t+    roots))\n398\t+\n399\t+\n400\t+(defn control-root\n401\t+  \"A lane's root with its decoded task changed by f first.\"\n402\t+  [{:keys [task machine peer]} f]\n403\t+  (let [task' (f task)]\n404\t+    (is (not= task task') \"the control changed the task\")\n405\t+    (task-root task' machine peer)))\n406\t+\n407\t+\n408\t+(defn first-binding\n409\t+  \"Pairs node n with the value of its first pair whose key satisfies pred\n410\t+   replaced by v.\"\n411\t+  [n pred v]\n412\t+  (let [ps (pairs-of n)\n413\t+        i (first (keep-indexed (fn [i [k _]] (when (pred k) i)) ps))]\n414\t+    (if i (rows/node (:kind n) (mapcat identity (assoc-in ps [i 1] v))) n)))\n415\t+\n416\t+\n417\t+(deftest law-4-controls\n418\t+  ;; §5.5 (D1): a changed position offset, descriptor field, saved value or\n419\t+  ;; lexical value changes what law 4 compares\n420\t+  (let [roots (canonical-equality #(bare 1) [\"A\" \"B\"])\n421\t+        [sr stack-lane register-lane] roots\n422\t+        base (:root sr)]\n423\t+    (testing \"the three lanes agree\"\n424\t+      (is (= base (:root stack-lane) (:root register-lane))))\n425\t+    (testing \"a cursor position's offset\"\n426\t+      (is (not= base (control-root stack-lane\n427\t+                                   (fn [t]\n428\t+                                     (replace-nodes t #(= :cursor-cell-body (:kind %))\n429\t+                                                    (fn [n] (update-in n [:slots 1 :dao.stream.ringbuffer/position] inc))))))))\n430\t+    (testing \"a stream only the register lane holds: one root, the descriptors differ\"\n431\t+      (let [build #(cond-> (bare 1)\n432\t+                     (= :register *lane*) (update-in [:machine :resources] assoc :control/extra (s/ring 4)))\n433\t+            d (error #(canonical-equality build [\"A\" \"B\"]))]\n434\t+        (is (= :descriptors (:law-4 d)) (pr-str d))\n435\t+        (is (= [false false true] (mapv (fn [ds] (contains? ds :control/extra)) (:descriptors d))))))\n436\t+    (testing \"two served identities under one logical name\"\n437\t+      (let [twin (fn [surfaces]\n438\t+                   (let [{:keys [peer] :as sv} (served surfaces)]\n439\t+                     (update sv :serve!\n440\t+                             (fn [serve!]\n441\t+                               (fn [h]\n442\t+                                 (let [r (serve! h)\n443\t+                                       id (:dao.stream/identity r)]\n444\t+                                   (swap! (:table peer) assoc (str id \"-twin\") (get @(:table peer) id))\n445\t+                                   r))))))\n446\t+            build #(cond-> (bare 1) (= :stack *lane*) (assoc :served twin))\n447\t+            d (error #(canonical-equality build [\"A\" \"B\"]))]\n448\t+        (is (= :injective (:law-4 d)) (pr-str d))\n449\t+        (is (< (count (distinct (vals (:names d)))) (count (:names d))))))\n450\t+    (testing \"a saved window value\"\n451\t+      (is (not= base (control-root register-lane\n452\t+                                   (fn [t]\n453\t+                                     (replace-nodes t #(= :window (:kind %))\n454\t+                                                    (fn [n] (first-binding n some? [:lit :control]))))))))\n455\t+    (testing \"a lexical value\"\n456\t+      (is (not= base (control-root sr\n457\t+                                   (fn [t]\n458\t+                                     (replace-nodes t #(= :env (:kind %))\n459\t+                                                    (fn [n] (update-in n [:slots 0] first-binding #{'a} [:lit :control]))))))))))\n460\t+\n461\t+\n462\t+(deftest cross-engine-canonical-equality-bare\n463\t+  ;; the quick-tier slice of acceptance 10: every lane row once, bare;\n464\t+  ;; §5.3's shared fragment, 16 cases over three distinct kernel lanes\n465\t+  (let [n (atom 0)]\n466\t+    (doseq [[row r build] lane-rows]\n467\t+      (testing (str \"row \" row)\n468\t+        (canonical-equality #(build identity) r)\n469\t+        (swap! n inc)))\n470\t+    (testing \"row 20\"\n471\t+      (canonical-equality tail-effect-halt \"B\")\n472\t+      (swap! n inc))\n473\t+    (is (= 16 @n))))\n474\t+\n475\t+\n476\t+(deftest ^:slow cross-engine-canonical-equality\n477\t+  ;; acceptance 10: law 4 over §5.3's shared fragment, 61 cases, each over\n478\t+  ;; exactly three distinct kernel lanes\n479\t+  (slow/guard\n480\t+    \"cross-engine-canonical-equality\"\n481\t+    (fn []\n482\t+      (let [cases (lane-cases) n (atom 0)]\n483\t+        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n484\t+        (doseq [[row label expected build] cases]\n485\t+          (testing (str \"row \" row \" \" (name label))\n486\t+            (canonical-equality build expected)\n487\t+            (swap! n inc)))\n488\t+        (is (= 61 @n))))))\n489\t+\n490\t+\n491\t+(def ordered-pairs\n492\t+  \"Law 5's six ordered pairs of distinct lanes.\"\n493\t+  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n494\t+\n495\t+\n496\t+(def unlowerable\n497\t+  \"[row receiver] pairs a de Bruijn receiver cannot continue (§5.3): row\n498\t+   4 is lifted from a de Bruijn source but not lowered into a de Bruijn\n499\t+   receiver, whose re-park names its own call pair\n500\t+   (ffi/response-wait-entry), not the carried response cursor cell the\n501\t+   semantic-register kernel restores. Emptied when the retained-FFI seam\n502\t+   (§4, 6c-post-D2) lands, raising law 5 to 366 and 96.\"\n503\t+  #{[4 :stack] [4 :register]})\n504\t+\n505\t+\n506\t+(defn crossed\n507\t+  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n508\t+   source's streams: the run's observables and attaches.\"\n509\t+  [from to build]\n510\t+  (scoped\n511\t+    (fn []\n512\t+      (let [world (on-lane from build)\n513\t+            {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n514\t+            wire (lane-lift (:machine world) serve!)\n515\t+            receiver ((or (:receiver world) (constantly nil)))\n516\t+            {:keys [attach!] n :count} (recording-attacher toy)\n517\t+            recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n518\t+            _ (is (= to (lane-of recv)))\n519\t+            attaches @n\n520\t+            done (satisfy world recv #(drive-peers % [peer]))\n521\t+            _ (s/serve-mirror! peer)]\n522\t+        (when-let [f (:finish world)] (f))\n523\t+        (when-let [f (:finish receiver)] (f))\n524\t+        {:attaches attaches :wire wire\n525\t+         :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))))\n526\t+\n527\t+\n528\t+(defn cross-lowering\n529\t+  \"Law 5 for one case: every admitted ordered pair continues to the\n530\t+   reference. Answers the pairs that ran.\"\n531\t+  [row build]\n532\t+  (let [ref (reference (on-lane :semantic-register build))]\n533\t+    (is (:halted ref))\n534\t+    (reduce (fn [ran [from to]]\n535\t+              (if (contains? unlowerable [row to])\n536\t+                ran\n537\t+                (testing (str (name from) \" -> \" (name to))\n538\t+                  (let [got (crossed from to build)]\n539\t+                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n540\t+                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n541\t+                        \"law 5: the lowered run continues to the reference\")\n542\t+                    (conj ran [from to])))))\n543\t+            []\n544\t+            ordered-pairs)))\n545\t+\n546\t+\n547\t+(deftest cross-engine-lowering-bare\n548\t+  ;; the quick-tier slice of acceptance 11: every lane row once, bare;\n549\t+  ;; §5.3's shared fragment, 92 transfers (96 once unlowerable is emptied)\n550\t+  (is (= 6 (count ordered-pairs)))\n551\t+  (let [ran (atom 0)]\n552\t+    (doseq [[row _ build] lane-rows]\n553\t+      (testing (str \"row \" row)\n554\t+        (let [pairs (cross-lowering row #(build identity))]\n555\t+          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n556\t+          (swap! ran + (count pairs)))))\n557\t+    (testing \"row 20\"\n558\t+      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n559\t+      (swap! ran + 6))\n560\t+    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n561\t+\n562\t+\n563\t+(deftest ^:slow cross-engine-lowering\n564\t+  ;; acceptance 11: law 5, six ordered pairs over §5.3's shared fragment,\n565\t+  ;; 350 transfers (366 once unlowerable is emptied)\n566\t+  (slow/guard\n567\t+    \"cross-engine-lowering\"\n568\t+    (fn []\n569\t+      (let [ran (atom 0) cases (lane-cases)]\n570\t+        (is (= 61 (count cases)))\n571\t+        (doseq [[row label _ build] cases]\n572\t+          (testing (str \"row \" row \" \" (name label))\n573\t+            (swap! ran + (count (cross-lowering row build)))))\n574\t+        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n575\t+\n576\t+\n577\t+(defn register-judge\n578\t+  \"The frame validator's verdict on register entry `entry` of m,\n579\t+   reconstructed through the layout.\"\n580\t+  [m entry]\n581\t+  (let [sp (kernel-space m)\n582\t+        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n583\t+        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n584\t+        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n585\t+    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n586\t+\n587\t+\n588\t+(defn spare-register\n589\t+  \"A physical register of the entry's body outside its live set and its\n590\t+   destination that R gives exactly one virtual.\"\n591\t+  [m entry]\n592\t+  (let [sg (val (first (:segments (kernel-space m))))\n593\t+        site (- (:site-pc entry) (layout/offset :register m sg))\n594\t+        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n595\t+        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n596\t+    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n597\t+\n598\t+\n599\t+(def layout-corpus\n600\t+  \"C, [label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n601\t+   operand position, whose dead layout syntax reads registers other than\n602\t+   the call's own (phase-5 §6.3's last golden).\"\n603\t+  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n604\t+        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n605\t+\n606\t+\n607\t+(defn- parking-site?\n608\t+  \"Rule A1: a non-tail parking instruction.\"\n609\t+  [t]\n610\t+  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n611\t+      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n612\t+\n613\t+\n614\t+(defn ambiguous-dead-slots\n615\t+  \"[v p s] over C: a reachable parking pc p and a physical slot s of its\n616\t+   body that R gives two or more virtuals, outside live-out*(p)'s image\n617\t+   and p's destination.\"\n618\t+  []\n619\t+  (into []\n620\t+        (mapcat (fn [[_ ast]]\n621\t+                  (let [v (:vector (linearize/project ast))\n622\t+                        sg (segment-of v)\n623\t+                        reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n624\t+                    (mapcat (fn [p]\n625\t+                              (let [rd (code/rd (nth v p))\n626\t+                                    body (nth (:phys sg) (code/body-index (:bodies sg) p))\n627\t+                                    used (into #{} (map #(layout/phys sg p %))\n628\t+                                               (cond-> (layout/live-out sg p) (some? rd) (conj rd)))]\n629\t+                                (keep (fn [[s xs]] (when (and (< 1 (count xs)) (not (contains? used s))) [v p s]))\n630\t+                                      (sort-by key (group-by body (keys body))))))\n631\t+                            (filter #(parking-site? (nth v %)) (sort reach))))))\n632\t+        layout-corpus))\n633\t+\n634\t+\n635\t+(defn register-entry\n636\t+  \"A register kernel k's wait entry parked after pc p of v, its window the\n637\t+   live registers holding :v, plus slot extra holding :x when given.\"\n638\t+  [k v p extra]\n639\t+  (let [sg (segment-of v)\n640\t+        off (layout/offset :register k sg)\n641\t+        rd (code/rd (nth v p))\n642\t+        regs (vec (sort-by first (cond-> (mapv (fn [r] [r :v]) (layout/register-live sg p))\n643\t+                                   (some? extra) (conj [extra :x]))))]\n644\t+    {:site-pc (+ off p) :pc (+ off p 1) :regs regs :live (mapv first regs)\n645\t+     :dest (when (some? rd) (layout/phys sg p rd)) :continuation [] :resume-mode :write-result\n646\t+     :frames (mapv (fn [c] (vec (repeat (count (nth (nth v c) 2)) nil))) (layout/chain sg (inc p)))}))\n647\t+\n648\t+\n649\t+(deftest layout-refusals\n650\t+  (testing \"a kernel stepped to a non-safepoint pc\"\n651\t+    (doseq [lane [:stack :register]]\n652\t+      (testing (name lane)\n653\t+        (scoped\n654\t+          (fn []\n655\t+            (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n656\t+                  n (atom 0)\n657\t+                  {:keys [serve!]} (served #{:reader})\n658\t+                  d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n659\t+              (is (not (vm/halted? m)))\n660\t+              (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n661\t+              (is (zero? @n) \"no stream was served\")\n662\t+              (testing \", its registers read as a payload\"\n663\t+                (let [entry (if (= :stack lane)\n664\t+                              (select-keys m [:pc :frames :stack :continuation])\n665\t+                              (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n666\t+                      cx (layout/lift-context m (kernel-space m) (:owner m))]\n667\t+                  (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))))\n668\t+  (testing \"a register entry whose live was tampered\"\n669\t+    (scoped\n670\t+      (fn []\n671\t+        (let [m (:machine (on-lane :register #(bare 1)))\n672\t+              entry (first (:wait-set m))\n673\t+              live (:live entry)\n674\t+              spare (spare-register m entry)]\n675\t+          (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n676\t+          (is (seq live))\n677\t+          (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n678\t+              \"a live register dropped\")\n679\t+          (is (some? spare))\n680\t+          (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n681\t+                                                        :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n682\t+              \"a dead register added\")))))\n683\t+  (testing \"a register entry tampered with an ambiguous dead preimage: the layout refuses\"\n684\t+    (let [fixtures (ambiguous-dead-slots)]\n685\t+      (is (seq fixtures) \"C holds one: the allocator reuses slots\")\n686\t+      (doseq [[v p s] fixtures]\n687\t+        (let [sp (layout/space [v])\n688\t+              k (layout/attach-space (on-lane :register machine) sp)\n689\t+              cx (layout/lift-context k sp (:owner k))\n690\t+              d (error #(layout/lift-state cx (register-entry k v p s)))]\n691\t+          (is (map? (layout/lift-state cx (register-entry k v p nil))) \"untampered, the entry lifts\")\n692\t+          (is (= [:yin.k/non-portable :register-layout] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n693\t+          (is (= {:yin.k/pc p :yin.k/register s} (select-keys d [:yin.k/pc :yin.k/register])))))))\n694\t+  (testing \"a primitive in a window, a lexical binding, a closure's capture or a window's guest collection: the register kernel cannot hold it, refused before any attach\"\n695\t+    (doseq [[label op expected path?]\n696\t+            [[:window (s/app (s/v 'conj) (s/lit []) read-op) [\"B\"]\n697\t+              #(= [:frames 0 :window] (subvec % 0 3))]\n698\t+             ;; the read under cat, whose closure captures no primitive: s/then\n699\t+             ;; would save its own closure, which captures the binding too\n700\t+             [:lexical (s/app (s/lam ['q] (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'q) (s/lit []) (s/lit 1))))\n701\t+                              (s/v 'conj))\n702\t+              [\"B\" [1]] #(= '[:frames 0 :env q] %)]\n703\t+             [:captured (s/let1 'g (s/lam ['h] (s/lam ['x] (s/app (s/v 'h) (s/lit []) (s/v 'x))))\n704\t+                                (s/let1 'k (s/app (s/v 'g) (s/v 'conj))\n705\t+                                        (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'k) (s/lit 2)))))\n706\t+              [\"B\" [2]] #(= '[:frames 0 :env k h] %)]\n707\t+             [:nested (s/app (s/lam ['w 'r] (s/v 'r)) (cat-of (s/lit []) (s/v 'conj)) read-op) \"B\"\n708\t+              #(and (= 5 (count %)) (= [:frames 0 :window] (subvec % 0 3)) (= 0 (peek %)))]]]\n709\t+      (testing (str \" \" (name label))\n710\t+        (let [build #(reader % op)\n711\t+              world (build identity)\n712\t+              {:keys [serve! toy]} (served #{:reader})\n713\t+              wire (rows/lift-task (:machine world) serve! (lift-opts))\n714\t+              {:keys [attach!] n :count} (recording-attacher toy)\n715\t+              d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n716\t+          (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n717\t+          (is (path? (:yin.k/path d)) (pr-str (:yin.k/path d)))\n718\t+          (is (zero? @n) \"refused before any attachment\")\n719\t+          (testing \", the stack kernel holds it\"\n720\t+            (let [ref (reference (build identity))\n721\t+                  got (crossed :semantic-register :stack #(build identity))]\n722\t+              (is (= expected (:value ref)))\n723\t+              (is (= (:value ref) (:value got))))))))))\n724\t"}]},"parent_tool_use_id":null,"session_id":"fc5fbdae-afe7-4b77-8da9-cb26d4729e39","uuid":"a86b905d-8033-41d4-a01d-2ea3f932aebc","timestamp":"2026-10-12T20:19:40.523Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/.claude/projects/-Users-sto-workspace-datomworld-docs-6c/fc5fbdae-afe7-4b77-8da9-cb26d4729e39/tool-results/bmk4szgpk.txt","content":"diff --git a/test/yin/vm/semantic_register/safepoint_harness_test.cljc b/test/yin/vm/semantic_register/safepoint_harness_test.cljc\nindex 735e6c85..4c393075 100644\n--- a/test/yin/vm/semantic_register/safepoint_harness_test.cljc\n+++ b/test/yin/vm/semantic_register/safepoint_harness_test.cljc\n@@ -10,7 +10,14 @@\n    trace equal the reference (law 1); the relift equals the lift by root\n    id under rows/canonical-under (law 2); the pending's reason is the\n    observed wait's (law 3); every lifted frame passes the validator\n-   (law 6). Row 20 runs once, outside the wrappers.\"\n+   (law 6). Row 20 runs once, outside the wrappers.\n+\n+   Phase 6c adds the two de Bruijn lanes (§5.3): a world built under\n+   *lane* :stack or :register runs A's derived image on that kernel and\n+   lifts and lowers through yin.vm.semantic-register.layout. Law 4 (one\n+   root id on all three lanes under canonical-under), law 5 (six ordered\n+   lowering pairs, each continuing to the reference result) and the\n+   layout refusals close the file.\"\n   (:require [clojure.test :refer [deftest is testing]]\n             [dao.jing :as jing]\n             [dao.stream :as stream]\n@@ -23,9 +30,15 @@\n             [yin.vm.values :as values]\n             [yin.vm.test-utils :as tu]\n             [yin.vm.semantic-register :as sr]\n+            [yin.vm.debruijn.register :as rvm]\n+            [yin.vm.debruijn.stack :as dvm]\n+            [yin.vm.parity-test :as b0]\n+            [yin.vm.semantic-register.analysis :as analysis]\n             [yin.vm.semantic-register.code :as code]\n+            [yin.vm.semantic-register.corpus :as corpus]\n             [yin.vm.semantic-register.frame :as frame]\n             [yin.vm.semantic-register.frame-test :as ft]\n+            [yin.vm.semantic-register.layout :as layout]\n             [yin.vm.semantic-register.linearize :as linearize]\n             [yin.vm.ucf.lift-support :as support]\n             [yin.vm.ucf.rows :as rows]\n@@ -42,28 +55,134 @@\n   (atom {}))\n \n \n+(def code-index\n+  \"{A v}: every vector this harness projects, for the layouts' spaces.\"\n+  (atom {}))\n+\n+\n+(def ^:dynamic *projected*\n+  \"When bound, an atom {A v} of the vectors one world projected: the\n+   layouts' spaces read it instead of the whole file's code-index, so an\n+   alpha-equivalent A an unrelated fixture projected widens no lookup.\"\n+  nil)\n+\n+\n (defn project\n   [ast]\n-  (let [v (:vector (linearize/project ast))]\n-    (swap! source-index update (jing/segment-key v) (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n+  (let [v (:vector (linearize/project ast))\n+        a (jing/segment-key v)]\n+    (swap! source-index update a (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n+    (swap! code-index assoc a v)\n+    (when *projected* (swap! *projected* assoc a v))\n     v))\n \n \n+(defn scoped\n+  \"f's result, every vector it projects recorded in a fresh *projected*.\"\n+  [f]\n+  (binding [*projected* (atom {})] (f)))\n+\n+\n+(defn file-wide\n+  \"f's result, the layouts' spaces reading every vector the file ever\n+   projected: only the fixtures that show that contamination.\"\n+  [f]\n+  (binding [*projected* code-index] (f)))\n+\n+\n (def stream-modules (module/register-stream-module (module/default-registry)))\n \n \n+(def ^:dynamic *lane*\n+  \"The kernel a world is built on: :semantic-register (the reference\n+   lane), or :stack or :register, which run A's derived image and lift\n+   and lower through the layouts (§5.3).\"\n+  :semantic-register)\n+\n+\n+(def lanes [:semantic-register :stack :register])\n+\n+\n+(defn- composition\n+  [opts]\n+  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n+          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n+          :modules stream-modules}\n+         opts))\n+\n+\n+(defn- kernel-opts\n+  \"A de Bruijn kernel's options for the same composition: the full\n+   primitive table, and the initial environment as :free-env.\"\n+  [opts]\n+  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n+    (contains? opts :env) (assoc :free-env (:env opts))))\n+\n+\n (defn machine\n   ([] (machine {}))\n   ([opts]\n-   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n-                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n-                         :modules stream-modules}\n-                        opts))))\n+   (case *lane*\n+     :semantic-register (sr/create-vm (composition opts))\n+     :stack (dvm/create-vm [] (kernel-opts opts))\n+     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n+\n+\n+(defn lane-of\n+  [m]\n+  (let [f (:format (module/link-format m))]\n+    (cond (= dvm/format-tag f) :stack\n+          (= rvm/format-tag f) :register\n+          :else :semantic-register)))\n+\n+\n+(def segment-of\n+  \"layout/segment, once per A.\"\n+  (memoize layout/segment))\n+\n+\n+(defn kernel-space\n+  \"The layout space of the A vectors whose images de Bruijn kernel k\n+   holds, among those this world projected (`scoped`), or the file ever\n+   projected (`file-wide`). Unbound, it throws: an independent world's\n+   lookups never read another fixture's vectors.\"\n+  [k]\n+  (when-not *projected*\n+    (throw (ex-info \"kernel-space outside scoped or file-wide\" {})))\n+  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n+        held (into #{} (map first) (:images k))]\n+    (layout/space (filter #(contains? held (id %)) (map segment-of (vals @*projected*))))))\n+\n+\n+(defn- kernel-load\n+  \"Attach v's derived image and start it at its row, beside whatever the\n+   kernel already holds: parked records keep naming their own rows.\"\n+  [k v]\n+  (let [kind (lane-of k)\n+        sg (segment-of v)\n+        k (if (= :stack kind)\n+            (dvm/attach-image k (:stack sg) vm/stack-contract)\n+            (rvm/attach-image k (:register sg) vm/register-contract))\n+        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n+                 :halted? false :blocked? false :value nil)]\n+    (if (= :stack kind)\n+      (assoc k :stack [])\n+      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n \n \n (defn load-program\n   [m ast]\n-  (sr/load-vector m (project ast) code/contract))\n+  (if (= :semantic-register (lane-of m))\n+    (sr/load-vector m (project ast) code/contract)\n+    (kernel-load m (project ast))))\n+\n+\n+(defn lane-closure\n+  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n+  [m c]\n+  (if (= :semantic-register (lane-of m))\n+    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n+    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n \n \n (defn lift-opts\n@@ -301,16 +420,17 @@\n    else reaches, named by a module closure in the task store.\"\n   [wrap]\n   (let [ring (s/ring 4)\n-        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n+        ast (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))\n+        v (project ast)\n+        m (vm/run (load-program (machine) ast))\n         cursor (fn [m]\n                  (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n                    (engine/handle-cursor m {:stream ref} id)))\n         [c1 m] (cursor m)\n         [c2 m] (cursor m)\n-        [seg image] (first (:code m))\n-        closure (first (filter #(= :closure (first %)) (:vector image)))\n-        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n-                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n+        closure (first (filter #(= :closure (first %)) v))\n+        clo (lane-closure m {:type :closure :params (nth closure 2) :entry (nth closure 3)\n+                             :segment (jing/segment-key v) :env {engine/store-of-key 'host.mod}})]\n     (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n \n \n@@ -1290,3 +1410,521 @@\n       (is (= (count (stream-identities wire)) n))\n       (is (zero? none) \"refused before any attachment\")\n       (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n+\n+\n+;; =============================================================================\n+;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n+;; =============================================================================\n+\n+(def link-rows\n+  \"Rows the de Bruijn lanes do not carry (§5.3, the shared fragment): a\n+   de Bruijn kernel links a native image while module responses carry A,\n+   and §4 defines no layout for install children (canonical-task refuses\n+   :installs). The reference lane runs the whole matrix; these lanes are\n+   removed with their kernels at phase 8.\"\n+  #{7 8 9 10 11 12 17})\n+\n+\n+(def lane-rows\n+  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n+  (filterv #(not (contains? link-rows (first %))) rows))\n+\n+\n+(defn lane-cases\n+  \"§5.3's shared fragment: 15 lane rows x 4 segments, plus row 20 once:\n+   [row segment expected build].\"\n+  []\n+  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n+\n+\n+(defn on-lane\n+  [lane build]\n+  (binding [*lane* lane] (build)))\n+\n+\n+(defn lane-lift\n+  \"The lift of §7.1 on m's own lane.\"\n+  [m serve!]\n+  (if (= :semantic-register (lane-of m))\n+    (rows/lift-task m serve! (lift-opts))\n+    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n+\n+\n+(defn lane-lower\n+  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n+  [lane opts wire attach!]\n+  (let [scratch (on-lane :semantic-register #(machine opts))]\n+    (if (= :semantic-register lane)\n+      (rows/lower-task scratch wire attach!)\n+      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n+\n+\n+(defn injective\n+  \"names, refusing when two identities share a logical name (§5.5).\"\n+  [names]\n+  (when-not (= (count names) (count (distinct (vals names))))\n+    (throw (ex-info \"The correspondence is not injective\" {:law-4 :injective :names names})))\n+  names)\n+\n+\n+(defn logical-names\n+  \"§5.5's explicit correspondence: each served identity to the resource\n+   key the lifted machine holds that handle under. The fixture builds the\n+   same program on every lane, so one key names one logical stream.\"\n+  [m peer]\n+  (injective\n+    (into {} (map (fn [[id e]]\n+                    [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n+                            (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n+          @(:table peer))))\n+\n+\n+(defn ring-names\n+  \"{stream identity -> resource key} over every stream m holds.\"\n+  [m]\n+  (injective\n+    (into {} (keep (fn [[k h]]\n+                     (when (satisfies? stream/IDaoStreamDescriptor h)\n+                       [(:dao.stream/identity (stream/descriptor h)) k])))\n+          (:resources m))))\n+\n+\n+(defn logical-positions\n+  \"The task with each cursor position's embedded stream identity renamed\n+   to its logical name. A ring buffer cursor carries its stream's\n+   identity, which §5.5's marker substitution does not reach, so the\n+   cross-lane comparison renames only that field, under the same fixture\n+   correspondence; every other field, the offset included, is kept.\"\n+  [task m]\n+  (let [names (ring-names m)\n+        k :dao.stream.ringbuffer/identity]\n+    (replace-nodes task #(= :cursor-cell-body (:kind %))\n+                   (fn [n]\n+                     (update-in n [:slots 1]\n+                                (fn [p]\n+                                  (if (and (map? p) (contains? names (get p k)))\n+                                    (assoc p k (get names (get p k)))\n+                                    p)))))))\n+\n+\n+(defn rename-identities\n+  \"x with every :dao.stream/identity value that names maps renamed.\"\n+  [x names]\n+  (cond\n+    (map? x) (into {} (map (fn [[k v]]\n+                             [k (if (and (= :dao.stream/identity k) (contains? names v))\n+                                  (get names v)\n+                                  (rename-identities v names))]))\n+                   x)\n+    (vector? x) (mapv #(rename-identities % names) x)\n+    :else x))\n+\n+\n+(defn logical-descriptors\n+  \"§5.5: {logical name -> stream descriptor, identities renamed} over every\n+   stream m holds. canonical-under erases a marker's descriptor, so the\n+   lanes' descriptors are shown equivalent on these, separately.\"\n+  [m]\n+  (let [names (ring-names m)]\n+    (into {} (keep (fn [[k h]]\n+                     (when (satisfies? stream/IDaoStreamDescriptor h)\n+                       [k (rename-identities (stream/descriptor h) names)])))\n+          (:resources m))))\n+\n+\n+(defn descriptors-equivalent?\n+  \"Each lane's logical-descriptors, one per lane: equal maps.\"\n+  [ds]\n+  (apply = ds))\n+\n+\n+(defn identities-in\n+  \"The members of ids anywhere in x.\"\n+  [x ids]\n+  (cond\n+    (contains? ids x) #{x}\n+    (map? x) (into #{} (mapcat #(identities-in % ids)) (concat (keys x) (vals x)))\n+    (coll? x) (into #{} (mapcat #(identities-in % ids)) x)\n+    :else #{}))\n+\n+\n+(defn task-root\n+  \"§5.5 over decoded task: positions renamed, re-emitted, then\n+   canonical-under the served correspondence; no lane identity survives.\"\n+  [task m peer]\n+  (let [names (logical-names m peer)\n+        canonical (rows/canonical-under (rows/emit (logical-positions task m)) names)]\n+    (is (empty? (identities-in (:yin.k/rows canonical) (into (set (keys names)) (keys (ring-names m)))))\n+        \"every lane identity was renamed\")\n+    (:yin.k/root canonical)))\n+\n+\n+(defn logical-root\n+  \"§5.5: the lift's root id with every lane identity replaced by the\n+   fixture's logical name.\"\n+  [wire m peer]\n+  (task-root (rows/decode wire) m peer))\n+\n+\n+(defn lane-root\n+  \"Build on lane, lift: {:root under the logical names, :reference the\n+   lane's own run, :lane the kernel the world ran on, :descriptors, and\n+   :task :machine :peer for the controls}. A world's :served replaces\n+   `served`.\"\n+  [lane build]\n+  (scoped\n+    (fn []\n+      (let [world (on-lane lane build)\n+            m (:machine world)\n+            {:keys [serve! peer]} ((or (:served world) served) (or (:surfaces world) #{:reader}))\n+            task (rows/decode (lane-lift m serve!))]\n+        (is (nil? (rows/validate-frames task)) \"law 6 on every lane\")\n+        {:root (task-root task m peer)\n+         :reference (reference (on-lane lane build))\n+         :lane (lane-of m) :descriptors (logical-descriptors m)\n+         :task task :machine m :peer peer}))))\n+\n+\n+(defn canonical-equality\n+  \"Law 4 for one case: exactly the three distinct kernel lanes lift to one\n+   root, their streams' descriptors are equivalent under the\n+   correspondence (else it throws, :law-4 :descriptors), and each lane's\n+   own run answers the reference.\"\n+  [build expected]\n+  (let [roots (mapv #(lane-root % build) lanes)]\n+    (is (= 3 (count roots)))\n+    (is (= [:semantic-register :stack :register] (mapv :lane roots)) \"three distinct kernel lanes\")\n+    (is (apply = (map :root roots)) \"law 4: one root id on every lane\")\n+    (when-not (descriptors-equivalent? (mapv :descriptors roots))\n+      (throw (ex-info \"The descriptors differ under the correspondence\"\n+                      {:law-4 :descriptors :descriptors (mapv :descriptors roots)})))\n+    (doseq [{:keys [lane reference]} roots]\n+      (is (:halted reference) (str lane \" completes\"))\n+      (when (some? expected) (is (= expected (:value reference)) (str lane \" answers the reference\"))))\n+    roots))\n+\n+\n+(defn control-root\n+  \"A lane's root with its decoded task changed by f first.\"\n+  [{:keys [task machine peer]} f]\n+  (let [task' (f task)]\n+    (is (not= task task') \"the control changed the task\")\n+    (task-root task' machine peer)))\n+\n+\n+(defn first-binding\n+  \"Pairs node n with the value of its first pair whose key satisfies pred\n+   replaced by v.\"\n+  [n pred v]\n+  (let [ps (pairs-of n)\n+        i (first (keep-indexed (fn [i [k _]] (when (pred k) i)) ps))]\n+    (if i (rows/node (:kind n) (mapcat identity (assoc-in ps [i 1] v))) n)))\n+\n+\n+(deftest law-4-controls\n+  ;; §5.5 (D1): a changed position offset, descriptor field, saved value or\n+  ;; lexical value changes what law 4 compares\n+  (let [roots (canonical-equality #(bare 1) [\"A\" \"B\"])\n+        [sr stack-lane register-lane] roots\n+        base (:root sr)]\n+    (testing \"the three lanes agree\"\n+      (is (= base (:root stack-lane) (:root register-lane))))\n+    (testing \"a cursor position's offset\"\n+      (is (not= base (control-root stack-lane\n+                                   (fn [t]\n+                                     (replace-nodes t #(= :cursor-cell-body (:kind %))\n+                                                    (fn [n] (update-in n [:slots 1 :dao.stream.ringbuffer/position] inc))))))))\n+    (testing \"a stream only the register lane holds: one root, the descriptors differ\"\n+      (let [build #(cond-> (bare 1)\n+                     (= :register *lane*) (update-in [:machine :resources] assoc :control/extra (s/ring 4)))\n+            d (error #(canonical-equality build [\"A\" \"B\"]))]\n+        (is (= :descriptors (:law-4 d)) (pr-str d))\n+        (is (= [false false true] (mapv (fn [ds] (contains? ds :control/extra)) (:descriptors d))))))\n+    (testing \"two served identities under one logical name\"\n+      (let [twin (fn [surfaces]\n+                   (let [{:keys [peer] :as sv} (served surfaces)]\n+                     (update sv :serve!\n+                             (fn [serve!]\n+                               (fn [h]\n+                                 (let [r (serve! h)\n+                                       id (:dao.stream/identity r)]\n+                                   (swap! (:table peer) assoc (str id \"-twin\") (get @(:table peer) id))\n+                                   r))))))\n+            build #(cond-> (bare 1) (= :stack *lane*) (assoc :served twin))\n+            d (error #(canonical-equality build [\"A\" \"B\"]))]\n+        (is (= :injective (:law-4 d)) (pr-str d))\n+        (is (< (count (distinct (vals (:names d)))) (count (:names d))))))\n+    (testing \"a saved window value\"\n+      (is (not= base (control-root register-lane\n+                                   (fn [t]\n+                                     (replace-nodes t #(= :window (:kind %))\n+                                                    (fn [n] (first-binding n some? [:lit :control]))))))))\n+    (testing \"a lexical value\"\n+      (is (not= base (control-root sr\n+                                   (fn [t]\n+                                     (replace-nodes t #(= :env (:kind %))\n+                                                    (fn [n] (update-in n [:slots 0] first-binding #{'a} [:lit :control]))))))))))\n+\n+\n+(deftest cross-engine-canonical-equality-bare\n+  ;; the quick-tier slice of acceptance 10: every lane row once, bare;\n+  ;; §5.3's shared fragment, 16 cases over three distinct kernel lanes\n+  (let [n (atom 0)]\n+    (doseq [[row r build] lane-rows]\n+      (testing (str \"row \" row)\n+        (canonical-equality #(build identity) r)\n+        (swap! n inc)))\n+    (testing \"row 20\"\n+      (canonical-equality tail-effect-halt \"B\")\n+      (swap! n inc))\n+    (is (= 16 @n))))\n+\n+\n+(deftest ^:slow cross-engine-canonical-equality\n+  ;; acceptance 10: law 4 over §5.3's shared fragment, 61 cases, each over\n+  ;; exactly three distinct kernel lanes\n+  (slow/guard\n+    \"cross-engine-canonical-equality\"\n+    (fn []\n+      (let [cases (lane-cases) n (atom 0)]\n+        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n+        (doseq [[row label expected build] cases]\n+          (testing (str \"row \" row \" \" (name label))\n+            (canonical-equality build expected)\n+            (swap! n inc)))\n+        (is (= 61 @n))))))\n+\n+\n+(def ordered-pairs\n+  \"Law 5's six ordered pairs of distinct lanes.\"\n+  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n+\n+\n+(def unlowerable\n+  \"[row receiver] pairs a de Bruijn receiver cannot continue (§5.3): row\n+   4 is lifted from a de Bruijn source but not lowered into a de Bruijn\n+   receiver, whose re-park names its own call pair\n+   (ffi/response-wait-entry), not the carried response cursor cell the\n+   semantic-register kernel restores. Emptied when the retained-FFI seam\n+   (§4, 6c-post-D2) lands, raising law 5 to 366 and 96.\"\n+  #{[4 :stack] [4 :register]})\n+\n+\n+(defn crossed\n+  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n+   source's streams: the run's observables and attaches.\"\n+  [from to build]\n+  (scoped\n+    (fn []\n+      (let [world (on-lane from build)\n+            {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n+            wire (lane-lift (:machine world) serve!)\n+            receiver ((or (:receiver world) (constantly nil)))\n+            {:keys [attach!] n :count} (recording-attacher toy)\n+            recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n+            _ (is (= to (lane-of recv)))\n+            attaches @n\n+            done (satisfy world recv #(drive-peers % [peer]))\n+            _ (s/serve-mirror! peer)]\n+        (when-let [f (:finish world)] (f))\n+        (when-let [f (:finish receiver)] (f))\n+        {:attaches attaches :wire wire\n+         :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))))\n+\n+\n+(defn cross-lowering\n+  \"Law 5 for one case: every admitted ordered pair continues to the\n+   reference. Answers the pairs that ran.\"\n+  [row build]\n+  (let [ref (reference (on-lane :semantic-register build))]\n+    (is (:halted ref))\n+    (reduce (fn [ran [from to]]\n+              (if (contains? unlowerable [row to])\n+                ran\n+                (testing (str (name from) \" -> \" (name to))\n+                  (let [got (crossed from to build)]\n+                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n+                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n+                        \"law 5: the lowered run continues to the reference\")\n+                    (conj ran [from to])))))\n+            []\n+            ordered-pairs)))\n+\n+\n+(deftest cross-engine-lowering-bare\n+  ;; the quick-tier slice of acceptance 11: every lane row once, bare;\n+  ;; §5.3's shared fragment, 92 transfers (96 once unlowerable is emptied)\n+  (is (= 6 (count ordered-pairs)))\n+  (let [ran (atom 0)]\n+    (doseq [[row _ build] lane-rows]\n+      (testing (str \"row \" row)\n+        (let [pairs (cross-lowering row #(build identity))]\n+          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n+          (swap! ran + (count pairs)))))\n+    (testing \"row 20\"\n+      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n+      (swap! ran + 6))\n+    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n+\n+\n+(deftest ^:slow cross-engine-lowering\n+  ;; acceptance 11: law 5, six ordered pairs over §5.3's shared fragment,\n+  ;; 350 transfers (366 once unlowerable is emptied)\n+  (slow/guard\n+    \"cross-engine-lowering\"\n+    (fn []\n+      (let [ran (atom 0) cases (lane-cases)]\n+        (is (= 61 (count cases)))\n+        (doseq [[row label _ build] cases]\n+          (testing (str \"row \" row \" \" (name label))\n+            (swap! ran + (count (cross-lowering row build)))))\n+        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n+\n+\n+(defn register-judge\n+  \"The frame validator's verdict on register entry `entry` of m,\n+   reconstructed through the layout.\"\n+  [m entry]\n+  (let [sp (kernel-space m)\n+        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n+        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n+        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n+    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n+\n+\n+(defn spare-register\n+  \"A physical register of the entry's body outside its live set and its\n+   destination that R gives exactly one virtual.\"\n+  [m entry]\n+  (let [sg (val (first (:segments (kernel-space m))))\n+        site (- (:site-pc entry) (layout/offset :register m sg))\n+        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n+        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n+    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n+\n+\n+(def layout-corpus\n+  \"C, [label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n+   operand position, whose dead layout syntax reads registers other than\n+   the call's own (phase-5 §6.3's last golden).\"\n+  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n+        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n+\n+\n+(defn- parking-site?\n+  \"Rule A1: a non-tail parking instruction.\"\n+  [t]\n+  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n+      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n+\n+\n+(defn ambiguous-dead-slots\n+  \"[v p s] over C: a reachable parking pc p and a physical slot s of its\n+   body that R gives two or more virtuals, outside live-out*(p)'s image\n+   and p's destination.\"\n+  []\n+  (into []\n+        (mapcat (fn [[_ ast]]\n+                  (let [v (:vector (linearize/project ast))\n+                        sg (segment-of v)\n+                        reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n+                    (mapcat (fn [p]\n+                              (let [rd (code/rd (nth v p))\n+                                    body (nth (:phys sg) (code/body-index (:bodies sg) p))\n+                                    used (into #{} (map #(layout/phys sg p %))\n+                                               (cond-> (layout/live-out sg p) (some? rd) (conj rd)))]\n+                                (keep (fn [[s xs]] (when (and (< 1 (count xs)) (not (contains? used s))) [v p s]))\n+                                      (sort-by key (group-by body (keys body))))))\n+                            (filter #(parking-site? (nth v %)) (sort reach))))))\n+        layout-corpus))\n+\n+\n+(defn register-entry\n+  \"A register kernel k's wait entry parked after pc p of v, its window the\n+   live registers holding :v, plus slot extra holding :x when given.\"\n+  [k v p extra]\n+  (let [sg (segment-of v)\n+        off (layout/offset :register k sg)\n+        rd (code/rd (nth v p))\n+        regs (vec (sort-by first (cond-> (mapv (fn [r] [r :v]) (layout/register-live sg p))\n+                                   (some? extra) (conj [extra :x]))))]\n+    {:site-pc (+ off p) :pc (+ off p 1) :regs regs :live (mapv first regs)\n+     :dest (when (some? rd) (layout/phys sg p rd)) :continuation [] :resume-mode :write-result\n+     :frames (mapv (fn [c] (vec (repeat (count (nth (nth v c) 2)) nil))) (layout/chain sg (inc p)))}))\n+\n+\n+(deftest layout-refusals\n+  (testing \"a kernel stepped to a non-safepoint pc\"\n+    (doseq [lane [:stack :register]]\n+      (testing (name lane)\n+        (scoped\n+          (fn []\n+            (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n+                  n (atom 0)\n+                  {:keys [serve!]} (served #{:reader})\n+                  d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n+              (is (not (vm/halted? m)))\n+              (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n+              (is (zero? @n) \"no stream was served\")\n+              (testing \", its registers read as a payload\"\n+                (let [entry (if (= :stack lane)\n+                              (select-keys m [:pc :frames :stack :continuation])\n+                              (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n+                      cx (layout/lift-context m (kernel-space m) (:owner m))]\n+                  (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))))\n+  (testing \"a register entry whose live was tampered\"\n+    (scoped\n+      (fn []\n+        (let [m (:machine (on-lane :register #(bare 1)))\n+              entry (first (:wait-set m))\n+              live (:live entry)\n+              spare (spare-register m entry)]\n+          (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n+          (is (seq live))\n+          (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n+              \"a live register dropped\")\n+          (is (some? spare))\n+          (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n+                                                        :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n+              \"a dead register added\")))))\n+  (testing \"a register entry tampered with an ambiguous dead preimage: the layout refuses\"\n+    (let [fixtures (ambiguous-dead-slots)]\n+      (is (seq fixtures) \"C holds one: the allocator reuses slots\")\n+      (doseq [[v p s] fixtures]\n+        (let [sp (layout/space [v])\n+              k (layout/attach-space (on-lane :register machine) sp)\n+              cx (layout/lift-context k sp (:owner k))\n+              d (error #(layout/lift-state cx (register-entry k v p s)))]\n+          (is (map? (layout/lift-state cx (register-entry k v p nil))) \"untampered, the entry lifts\")\n+          (is (= [:yin.k/non-portable :register-layout] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n+          (is (= {:yin.k/pc p :yin.k/register s} (select-keys d [:yin.k/pc :yin.k/register])))))))\n+  (testing \"a primitive in a window, a lexical binding, a closure's capture or a window's guest collection: the register kernel cannot hold it, refused before any attach\"\n+    (doseq [[label op expected path?]\n+            [[:window (s/app (s/v 'conj) (s/lit []) read-op) [\"B\"]\n+              #(= [:frames 0 :window] (subvec % 0 3))]\n+             ;; the read under cat, whose closure captures no primitive: s/then\n+             ;; would save its own closure, which captures the binding too\n+             [:lexical (s/app (s/lam ['q] (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'q) (s/lit []) (s/lit 1))))\n+                              (s/v 'conj))\n+              [\"B\" [1]] #(= '[:frames 0 :env q] %)]\n+             [:captured (s/let1 'g (s/lam ['h] (s/lam ['x] (s/app (s/v 'h) (s/lit []) (s/v 'x))))\n+                                (s/let1 'k (s/app (s/v 'g) (s/v 'conj))\n+                                        (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'k) (s/lit 2)))))\n+              [\"B\" [2]] #(= '[:frames 0 :env k h] %)]\n+             [:nested (s/app (s/lam ['w 'r] (s/v 'r)) (cat-of (s/lit []) (s/v 'conj)) read-op) \"B\"\n+              #(and (= 5 (count %)) (= [:frames 0 :window] (subvec % 0 3)) (= 0 (peek %)))]]]\n+      (testing (str \" \" (name label))\n+        (let [build #(reader % op)\n+              world (build identity)\n+              {:keys [serve! toy]} (served #{:reader})\n+              wire (rows/lift-task (:machine world) serve! (lift-opts))\n+              {:keys [attach!] n :count} (recording-attacher toy)\n+              d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n+          (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n+          (is (path? (:yin.k/path d)) (pr-str (:yin.k/path d)))\n+          (is (zero? @n) \"refused before any attachment\")\n+          (testing \", the stack kernel holds it\"\n+            (let [ref (reference (build identity))\n+                  got (crossed :semantic-register :stack #(build identity))]\n+              (is (= expected (:value ref)))\n+              (is (= (:value ref) (:value got))))))))))\n","numLines":724,"startLine":1,"totalLines":724}},"tool_result_meta":[{"id":"toolu_01AbX8Chv4Ww2KCZV48BTjfy","permission_decision":{"decision":"accept","source":"config","reason_type":"other"}}]}
