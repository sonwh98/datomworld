const 0 2] [:halt 0]]}))))))))))\n+\n+\n (defn- replace-row\n   \"Rehash the edited row and all ancestors, without canonicalizing slots.\"\n   [wire id body]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0145D53FmiWkdJKXdWWNfvUL","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
