 coll with random probability of prob (0.0 -\n47ddb1d9\n144:(deftest canonical-under-is-renaming-invariant\n147:        ca (rows/canonical-under a {:lane-a/s1 :s1 :lane-a/s2 :s2})\n148:        cb (rows/canonical-under b {:lane-b/s2 :s1 :lane-b/s1 :s2})]\n151:           (:yin.k/root (rows/canonical-under\n156:    (is (= :missing-stream-correspondence\n157:           (:yin.k/kind (error #(rows/canonical-under a {:lane-a/s1 :s1})))))))\n266:    (is (= (:yin.k/root (rows/canonical-under wire {:child/s :child :root/s :root}))\n267:           (:yin.k/root (rows/emit (rows/decode (rows/canonical-under wire {:child/s :child :root/s :root}))))))))\n271:  (let [stream (rows/node :stream [:s :descriptor])\n316:  ;; Identity correspondence: only the listed order of :set elements\n321:    (is (= (:yin.k/root (rows/canonical-under (rows/emit a) ident))\n322:           (:yin.k/root (rows/canonical-under (rows/emit b) ident))))))\n328:(defn- descriptors\n366:                                      (descriptors kind slots) slots)))))]\n377:              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n789:    ;; Large descriptors are charged once, in the rank labels, not per key.\n229:(defn reader\n277:(defn retained-ffi\n420:(def rows\n482:(defn satisfy\n489:(defn reference\n1006:(defn parked-reader\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"sed -n '225,245p' /tmp/review6c-safepoint_harness_test.cljc.bak; sed -n '277,303p' /tmp/review6c-safepoint_harness_test.cljc.bak; sed -n '482,503p' /tmp/review6c-safepoint_harness_test.cljc.bak; sed -n '7623,7653p' /Users/sto/.gitlibs/libs/sonwh98/clojuredart/7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31/clj/src/cljd/core.cljd; sed -n '140,160p' test/yin/vm/ucf/rows_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"sed -n '225,245p' /tmp/review6c-safepoint_harness_test.cljc.bak; sed -n '277,303p' /tmp/review6c-safepoint_harness_test.cljc.bak; sed -n '482,503p' /tmp/review6c-safepoint_harness_test.cljc.bak; sed -n '7623,7653p' /Users/sto/.gitlibs/libs/sonwh98/clojuredart/7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31/clj/src/cljd/core.cljd; sed -n '140,160p' test/yin/vm/ucf/rows_test.cljc\"","aggregated_output":";; A world: :machine, :kind, :reason (blocked rows), :steps (each followed by\n;; a drive) or :resume, :finish (records the effect trace), :trace, and\n;; :receiver (fresh opts and a finish for the receiver's own composition).\n\n(defn reader\n  \"A reader parked on (next-of c); :pre values are appended and the\n   machine re-run first.\"\n  ([wrap op] (reader wrap op [] \"B\" {}))\n  ([wrap op pre value opts]\n   (let [m0 (vm/run (load-program (machine opts) (with-stream (with-cat (wrap op)))))\n         src (s/stream-of m0)\n         m (reduce (fn [m x] (stream/append! src x) (vm/run m)) m0 pre)]\n     {:machine m :kind :blocked :reason :next :steps [#(stream/append! src value)] :trace (atom [])})))\n\n\n(defn writer\n  [wrap]\n  (let [trace (atom [])\n        w (support/one-slot-stream \"w\")\n        _ (stream/append! w :warmed)\n        m0 (load-program (machine) (with-cat (wrap {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")})))\n(defn retained-ffi\n  [wrap]\n  (let [trace (atom []) call-in (support/one-slot-stream \"call-in\") call-out (s/ring 8)\n        _ (stream/append! call-in :warmed)\n        m (caller wrap call-in call-out)\n        id (ffi/request-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n     :steps [#(stream/next call-in 0)\n             (fn []\n               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn module-response\n  [body exports]\n  {:status :ok :image {:value (project body)}\n   :manifest {:yin.module/name 'host.mod :yin.module/exports exports} :obligations []})\n\n\n(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n\n\n(def blocking-body\n  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n   binding holds the stream, so f's E does not capture it.\"\n  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n(defmacro binding\n  \"binding => var-symbol init-expr\n\n  Creates new bindings for the (already-existing) vars, with the\n  supplied initial values, executes the exprs in an implicit do, then\n  re-establishes the bindings that existed before.  The new bindings\n  are made in parallel (unlike let); all init-exprs are evaluated\n  before the vars are bound to their new values.\"\n  [bindings & body]\n  `(dart/run-zoned\n     :values ~(into {}\n               (map (fn [[sym v]] [(list `-var-key (list 'var sym)) (list `volatile! v)]))\n               (partition 2 bindings))\n     :spec -async-error-handler-zone-spec\n     ~@body))\n\n(defmacro await [expr]\n  `(dart/await ~expr))\n\n(defn ^StringSink print-sink [print]\n  (let [sb (StringBuffer)]\n    (reify\n      StringSink\n      (write [_ x]\n        (let [s (.toString x)]\n          (if (.contains s \"\\n\")\n            (let [chunks (.split s \"\\n\")\n                  last (.removeLast chunks)]\n              (if (.-isEmpty sb)\n                (do\n                  (.forEach chunks print))\n        (is (= :yin.k/undecodable (:yin.k/status d)))\n        (is (contains? #{:row-order :duplicate-key} (:yin.k/kind d)))))))\n\n\n(deftest canonical-under-is-renaming-invariant\n  (let [a (rows/emit (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y))\n        b (rows/emit (fixture :lane-b/s2 :lane-b/s1 :other/y :other/x))\n        ca (rows/canonical-under a {:lane-a/s1 :s1 :lane-a/s2 :s2})\n        cb (rows/canonical-under b {:lane-b/s2 :s1 :lane-b/s1 :s2})]\n    (is (= (:yin.k/root ca) (:yin.k/root cb)))\n    (is (= (:yin.k/root ca)\n           (:yin.k/root (rows/canonical-under\n                          (rows/emit-numbered (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y)\n                                              {:source/x :yin.k/cc-2 :source/y :yin.k/cc-1})\n                          {:lane-a/s1 :s1 :lane-a/s2 :s2}))))\n    (is (= (set (:yin.k/rows ca)) (set (:yin.k/rows cb))))\n    (is (= :missing-stream-correspondence\n           (:yin.k/kind (error #(rows/canonical-under a {:lane-a/s1 :s1})))))))\n\n\n(deftest alias-topology-and-census\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/review6c-probes.clj <<'CLJ'\n(require '[yin.vm.semantic-register.safepoint-harness-test :as h]\n         '[yin.vm.semantic-register.layout :as l]\n         '[yin.vm.semantic-register.code :as code]\n         '[yin.vm.ucf.rows :as rows]\n         '[yin.vm.ucf.v2-support :as s]\n         '[yin.vm.values :as values]\n         '[yin.vm.engine :as engine]\n         '[yin.vm :as vm])\n(defn outcome [f] (try (f) (catch Throwable e {:message (.getMessage e) :data (ex-data e)})))\n;; Two alpha-distinct closures share a native image, in a legitimate store.\n(let [ast (s/then (s/def\"'! '\"'f (s/lam ['x] (s/v 'x))) (s/def\"'! '\"'g (s/lam ['y] (s/v 'y))))\n      a (h/project (s/lam ['x] (s/v 'x))) b (h/project (s/lam ['y] (s/v 'y)))\n      sp (l/space [a b])\n      m0 (h/on-lane :stack h/machine)\n      m (h/load-program (h/load-program m0 (s/lam ['x] (s/v 'x))) (s/lam ['y] (s/v 'y)))\n      m (vm/run m)]\n  (println :ambiguity {:different-A (not= (:address (l/segment a)) (:address (l/segment b)))\n                      :same-H (= (:stack-id (l/segment a)) (:stack-id (l/segment b)))\n                      :same-R (= (:register-id (l/segment a)) (:register-id (l/segment b)))\n                      :halted (vm/halted? m)\n                      :lift (outcome #(l/canonical-task m sp (h/on-lane :semantic-register h/machine)))}))\n;; A canonical free-env closure must be lowered before a kernel executes it.\n(doseq [lane [:stack :register]]\n  (let [world (h/on-lane :semantic-register #(h/reader identity (s/app (s/v 'f) h/read-op)))\n        m0 (:machine world)\n        m1 (h/load-program m0 (s/lam ['arg] (s/v 'arg)))\n        m1 (vm/run m1)\n        c (vm/value m1)\n        m (-> m0 (assoc :code (:code m1) :code-aliases (:code-aliases m1) :free-env {'f c})\n              (update :wait-set (fn [es] (mapv #(assoc-in % [:env 'f] c) es))))\n        {:keys [serve\"'! toy peer]} (h/served #{:reader})\n        wire (rows/lift-task m serve! (h/lift-opts))\n        {:keys [attach!] n :count} (h/recording-attacher toy)\n        r (outcome #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n    (println :free-env lane :attaches @n :payload (when (map? r) (values/payload (get-in r [:free-env '\"'f])))\n             :run (outcome #(select-keys (h/satisfy world r (fn [x] (h/drive-peers x [peer]))) [:halted? :value])))))\n;; Independent law-4 negative controls: changing position, versus descriptor.\n(let [world (h/on-lane :semantic-register #(h/bare 1)) m (:machine world)\n      {:keys [serve\"'! peer]} (h/served #{:reader}) wire (h/lane-lift m serve!) task (rows/decode wire)\n      pos (h/replace-nodes task #(= :cursor-cell-body (:kind %)) #(update-in % [:slots 1 :position] inc))\n      desc (h/replace-nodes task #(= :stream (:kind %)) #(assoc-in % [:slots 1 :review/extra] :different))]\n (println :negative-controls\n          {:position-erased (= (h/logical-root wire m peer) (h/logical-root (rows/emit pos) m peer))\n           :descriptor-erased (= (h/logical-root wire m peer) (h/logical-root (rows/emit desc) m peer))}))\n;; D2 without the exclusions, all four destination/source pairs.\n(doseq [from h/lanes to [:stack :register] :when (not= from to)]\n  (println :row4 from to (outcome #(select-keys (h/crossed from to (fn [] (h/bare 4))) [:halted :value :trace]))))\nCLJ'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
