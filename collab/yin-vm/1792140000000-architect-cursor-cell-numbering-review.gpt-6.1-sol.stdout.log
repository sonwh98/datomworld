ssoc :yin.k/site (:site f))\n    40\t      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n    41\t\n    42\t\n    43\t(defn machine-code\n    44\t  [m]\n    45\t  (into {} (map (fn [[_ image]] [(:address image) (:vector image)])) (:code m)))\n    46\t\n    47\t\n    48\t(defn- cat-of\n    49\t  [p q]\n    50\t  (s/app (s/v 'cat) p q))\n    51\t\n    52\t\n    53\t(defn- with-cat\n    54\t  [ast]\n    55\t  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n    56\t\n    57\t\n    58\t(defn- nest\n    59\t  [depth op]\n    60\t  (if (zero? depth) op\n    61\t      (cat-of (s/lit [depth]) (s/app (s/lam ['x] (nest (dec depth) op)) (s/lit depth)))))\n    62\t\n    63\t\n    64\t(def wrappers\n    65\t  (mapv (fn [[label wrap]] [label (comp with-cat wrap)])\n    66\t        [[:bare identity]\n    67\t         [:operand #(cat-of (s/lit [:operand]) %)]\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-39CS6n1w' (errno=Operation not permitted)\n2026-10-12 02:41:24.219 xcodebuild[75797:57374248]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-12 02:41:24.459 xcodebuild[75797:57374247] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-CeJ8f6wl' (errno=Operation not permitted)\n2026-10-12 02:41:25.050 xcodebuild[75801:57374273]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-12 02:41:25.245 xcodebuild[75801:57374272] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory ins