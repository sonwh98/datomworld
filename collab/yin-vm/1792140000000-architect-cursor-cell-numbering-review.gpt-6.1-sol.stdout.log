sor-cell a] [:cursor-cell b]])]))\n   174\t        a (rows/emit (make-task :x :y)) b (rows/emit (make-task :b :a))]\n   175\t    (is (= (:yin.k/root a) (:yin.k/root b)))\n   176\t    (is (= 2 (count (rows/canonical-numbering (make-task :x :y)))))\n   177\t    (is (= :resource-limit (:yin.k/kind (error #(rows/emit (make-task :x :y) {:search 1})))))\n   178\t    (is (= :yin.k/unsupported (:yin.k/status (error #(rows/emit (make-task :x :y) {:search 1})))))))\n   179\t\n   180\t\n   181\t(deftest gates-and-graph-before-hashes\n   182\t  (let [wire (rows/emit (task-node [] [:lit nil]))]\n   183\t    (doseq [version [0 1 2 4 3.5]]\n   184\t      (is (= :yin.k/profile-mismatch (:yin.k/status (error #(rows/decode (assoc wire :yin.k/version version)))))))\n   185\t    (is (= :duplicate-row (:yin.k/kind (error #(rows/decode (update wire :yin.k/rows conj (first (:yin.k/rows wire))))))))\n   186\t    (is (= :unreachable-row (:yin.k/kind (error #(rows/decode (update wire :yin.k/rows conj [:fake :prim 'f]))))))\n   187\t    (is (= :row-shape (:yin.k/kind (error #(rows/decode (assoc wire :extra 1))))))\n   188\t    (let [root (:yin.k/root wire)\n   189\t          root-row (first (filter #(= root (first %)) (:yin.k/rows wire)))\n   190\t          store (first (first (filter #(= :store (second %)) (:yin.k/rows wire))))\n   191\t          forge (fn [i x] (update wire :yin.k/rows (fn [rs] (mapv #(if (= root (first %)) (assoc % i x) %) rs))))]\n   192\t      ;; Slot n of the task row is at index n + 2.\n   193\t      (is (= :task-shape (:yin.k/kind (error #(rows/decode (forge 14 5))))))\n   194\t      (is (= :reference-kind (:yin.k/kind (error #(rows/decode (forge 7 store))))))\n   195\t      (is (= :yin.k/hash-mismatch (:yin.k/status (error #(rows/decode (forge 17 [:lit 1]))))))\n   196\t      (is (= :task (second root-row))))\n   197\t    (let [child (task-node [] [:lit nil])\n   198\t          parent (rows/emit (rows/node :task (assoc (:slots (task-node [] [:lit nil])) 12\n   199\t                                                    [(rows/node :install ['a :running nil {} child])])))\n   200\t          root (:yin.k/root parent)\n   201\t          cyclic (update parent :yin.k/rows\n   202\t                         (fn [rs] (mapv #(if (= :install (second %)) (assoc % 6 root) %) rs)))]\n   203\t      (is (= :cyclic (:yin.k/kind (error #(rows/decode cyclic))))))))\n   204\t\n   205\t\n   206\t(deftest numbering-precedes-frame-defect\n   207\t  (let [abstract (fixture :s1 :s2 :x :y)\n   208\t        slots (:slots abstract)\n   209\t        abstract (rows/node :task (assoc slots 5 (rows/node :bindings ['yin/def [:lit 1]])))\n   210\t        wire (rows/emit abstract)\n   211\t        d (error #(rows/decode (rows/emit-numbered abstract {:x :yin.k/cc-9 :y :yin.k/cc-8})))]\n   212\t    (is (= :noncanonical-cursor-cells (:yin.k/kind d)))\n   213\t    (is (= :reserved-name (:yin.k/kind (error #(rows/decode wire)))))))\n   214\t\n   215\t\n   216\t(deftest schema-and-literal-canonicality\n   217\t  (let [body (cursor-cell-body :s 0)]\n   218\t    (is (= :missing-cursor-cell (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:cursor-cell :missing])))))))\n   219\t    (is (= :extra-cursor-cell (:yin.k/kind (error #(rows/decode (rows/emit (task-node [[:x body]] [:lit nil])))))))\n   220\t    (is (= :reference-free-row\n   221\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:row (rows/node :vec [[:lit 1]])])))))))\n   222\t    (is (= :value-reference-kind\n   223\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:row (rows/node :window [])])))))))\n   224\t    (let [wire (rows/emit (task-node [] [:lit nil]))]\n   225\t      (is (= :yin.k/unsupported (:yin.k/status (error #(rows/decode wire {:rows 1}))))))\n   300\t  (let [a (fixture :s1 :s2 :x :y) b (reversed a) ident {:s1 :s1 :s2 :s2}]\n   301\t    (is (not= a b))\n   302\t    (is (= (:yin.k/root (rows/emit a)) (:yin.k/root (rows/emit b))))\n   303\t    (is (= (:yin.k/root (rows/canonical-under (rows/emit a) ident))\n   304\t           (:yin.k/root (rows/canonical-under (rows/emit b) ident))))))\n   305\t\n   306\t\n   307\t(deftest canonical-roots-are-pinned\n   308\t  (is (= :segment/blake3-fab223d9b3540fdce0ccf2132f8a4041917a158a32295470a4936754742d3ac4\n   309\t         (:yin.k/root (rows/emit (fixture :s1 :s2 :x :y)))))\n   310\t  (is (= :segment/blake3-c4a7c7e6de3b44400efec5930bc3d85d86b29153b4b2d548acba630bfbc3da7d\n   311\t         (:yin.k/root (rows/frame->rows ft/worked-frame))))\n   312\t  ;; The draft §6 case at its smallest: a directed loop and a directed\n   313\t  ;; 2-cycle over equal-body cursor cells leave all three cursor cells in one class, and\n   314\t  ;; no automorphism exchanges the loop with a 2-cycle vertex.\n   315\t  (let [shape (fn [[l a b]]\n   316\t                [[:row (rows/node :vec [[:cursor-cell l] [:cursor-cell l]])]\n   317\t                 [:row (rows/node :vec [[:cursor-cell a] [:cursor-cell b]])]\n   318\t                 [:row (rows/node :vec [[:cursor-cell b] [:cursor-cell a]])]])\n   319\t        graph (fn [ids edges] (task-node (mapv #(vector % (cursor-cell-body :s 0)) ids) [:row (rows/node :set edges)]))\n   320\t        task (graph [:l :a :b] (shape [:l :a :b]))\n   321\t        renamed (graph [:z/b :z/a :z/l] (vec (reverse (shape [:z/l :z/a :z/b]))))\n   322\t        numbering (rows/canonical-numbering task)\n   323\t        root (:yin.k/root (rows/emit task))]\n   324\t    (is (= :resource-limit (:yin.k/kind (error #(rows/emit task {:search 2})))))\n   325\t    (is (= :segment/blake3-55ff168e6b5a37028fb5ecd99ab21dc58f6a4e2b9c95dbe570ccec65b15a63c0 root))\n   326\t    (is (= root (:yin.k/root (rows/emit renamed))))\n   327\t    (is (= :yin.k/cc-3 (numbering :l)))\n   328\t    (is (= (:z/l (rows/canonical-numbering renamed)) (numbering :l)))))\n   329\t\n   330\t\n   331\t(deftest census-is-numeric-from-ten-cursor-cells\n   332\t  (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))\n   333\t        task (task-node (mapv (fn [id i] [id (cursor-cell-body :s i)]) ids (range))\n   334\t                        [:row (rows/node :vec (mapv #(vector :cursor-cell %) ids))])\n   335\t        wire (rows/emit task)\n   336\t        census (first (filter #(= :cursor-cells (second %)) (:yin.k/rows wire)))]\n   337\t    (is (= (mapv #(keyword \"yin.k\" (str \"cc-\" %)) (range 1 11)) (vec (take-nth 2 (drop 2 census)))))\n   338\t    (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))))\n   339\t\n   340\t\n   341\t(deftest marker-shaped-guest-maps-are-not-portable\n   342\t  (doseq [v [{:yin.k/row 1} {:yin.k/cursor-cell \"c\"}]]\n   343\t    (is (= :yin.k/non-portable\n   344\t           (:yin.k/status (error #(rows/frame->rows (assoc ft/worked-frame :yin.k/window {1 v})))))))\n   345\t  (let [f (assoc ft/worked-frame :yin.k/window {1 {:yin.k/row 1 :other 2}})]\n   346\t    (is (= f (rows/rows->frame (rows/frame->rows f)))))\n   347\t  (let [wire (rows/frame->rows ft/worked-frame)\n   348\t        window (first (first (filter #(= :window (second %)) (:yin.k/rows wire))))]\n   349\t    (doseq [v [{:yin.k/row 1} {:yin.k/cursor-cell :c}]]\n   350\t      (is (= :yin.k/non-portable\n   351\t             (:yin.k/status (error #(rows/rows->frame (replace-row wire window [:window 1 [:lit v]])))))))))\n   352\t\n   353\t\n   354\t(deftest well-formed-guest-markers-are-refused\n   355\t  (doseq [v [{:yin.k/row (rows/node :prim ['guest/f])} {:yin.k/cursor-cell :c}]]\n   390\t\n   391\t\n   392\t(defn seven-cursor-cell-triangle-square\n   393\t  []\n   394\t  (let [ids [:a :b :c :d :e :f :g]\n   395\t        edges [[:a :b] [:b :c] [:c :a] [:d :e] [:e :f] [:f :g] [:g :d]]]\n   396\t    (task-node (mapv #(vector % (cursor-cell-body :s 0)) ids)\n   397\t               [:row (rows/node :set (mapv (fn [[a b]] [:row (rows/node :vec [[:cursor-cell a] [:cursor-cell b]])]) edges))])))\n   398\t\n   399\t\n   400\t(deftest intermediate-label-bytes-are-bounded\n   401\t  (let [d (error #(rows/canonical-numbering (seven-cursor-cell-triangle-square)))]\n   402\t    (is (= :resource-limit (:yin.k/kind d)))\n   403\t    (is (= [:label-bytes] (:yin.k/path d)))))\n   404\t\n   405\t\n   406\t(deftest input-row-bodies-do-not-spend-label-bytes\n   407\t  (let [large (vec (range 400000))\n   408\t        base (task-node [[:x (cursor-cell-body :s 0)]] [:lit large])\n   409\t        ;; Keep the census cursor cell reachable so decode also validates the carrier.\n   410\t        reachable (rows/node :task (assoc (:slots base) 5\n   411\t                                          (rows/node :bindings ['cursor [:cursor-cell :x]])))\n   412\t        custody (rows/node :task (assoc (:slots reachable) 15 [:lit nil]))\n   413\t        custody (rows/node :task (assoc (:slots custody) 16 large))]\n   414\t    (is (nil? (error #(rows/emit base))))\n   415\t    (doseq [task [reachable custody]]\n   416\t      (let [wire (rows/emit task)\n   417\t            expected (rows/node :task\n   418\t                                (-> (:slots task)\n   419\t                                    (assoc 5 (rows/node :bindings ['cursor [:cursor-cell :yin.k/cc-1]]))\n   420\t                                    (assoc 9 (rows/node :cursor-cells [:yin.k/cc-1 (cursor-cell-body :s 0)]))))]\n   421\t        (is (= expected (rows/decode wire)))))))\n    80\t   shape; the stack and register kernels reconstruct it through their\n    81\t   layouts (frozen §4.3, §10 phase 6).\n    82\t7. **No file of phase 4b or phase 5 is touched**, so this phase runs\n    83\t   concurrently with them (§8.5 names the dependencies that remain, and\n    84\t   the one old-kernel file 6c must change).\n    85\t\n    86\t### 0.2 The answer\n    87\t\n    88\tA continuation is a value: one **canonical frame** of the register\n    89\tmachine, `act` or `tail`, with its saved window, its `K` of `:return`\n    90\tframes, its environment, its delivery record and its pending wait\n    91\t(frozen §2.4, §4.2), plus the task context it needs: the task's **free\n    92\tenvironment**, store slice, module stores, parked table, cursor cells, code by\n    93\tA and the tree association. **§1** restates the frame as the 4b\n    94\tevaluator mints it. **§2** gives the row carrier: body version 3, one\n    95\tprofile (`\"v4\"`), Merkle content rows under Jing's default digest, the\n    96\twindow as a sorted keyed row in which a nil value is a present\n    97\t`[:lit nil]`, `:act`, `:tail`, `:window`, `:kframe`, `:reified` and\n    98\t`:parked-table` rows replacing the stale stack-shaped rows, a root\n    99\t`free-env` slot, the pending rows and census unchanged. **§3** gives the\n   100\tvalidator as an ordered set of rules over the decoded frame, the carried\n   101\tcode and decoded task context, engine-independent, run after canonical\n   102\tnumbering as the carrier orders it. **§4** defines the two layouts with\n   103\tseparate `act` and `tail` algorithms: the register kernel's physical\n   104\tregisters are paired with A's virtual ones pc by pc and its return\n   105\tdestinations recovered from A's call; the stack kernel's operand stack\n   106\tis sliced `[previous-base, base_i)` per frame, and its tail completion is\n   107\ta kernel seam this phase must add and gate. **§5** is the harness over\n   108\tthree lanes with an expanded, concrete matrix and a specified\n   109\tre-emission procedure for cross-lane equality. **§6** fixes what travels\n   110\tfor code and task context. **§8** cuts the slices: 6a the independent\n   111\tframe and row codec, 6b full task transport (needs phase 5's scanners\n   112\tand 4b stage 2), 6c the layouts and the stack tail-completion seam\n   113\t(needs 5a/5b).\n   114\t\n   115\t---\n   116\t\n   117\t## 1. The canonical frame\n   118\t\n   119\t### 1.1 Shapes, as the evaluator mints them\n   120\t\n   121\t**DECIDED** (frozen §2.4 \"Delivery\", §4.2; evaluator design §1.3-1.6;\n   122\t`srvm-phase4b:semantic_register.cljc:61-84` for `act-payload`,\n   123\t`entry-builders`, `tail-builders`; `:229-234` for the reified payload\n   124\tand the park). Two closed state shapes and one closed delivery record:\n   125\t\n   126\t```clojure\n   127\tact  = {:segment seg :pc n :env E :window W :k K :deliver {:deliver :rd :rd r}}\n   128\ttail = {:segment seg :site n :k K :deliver {:deliver :return}}\n   129\tret  = {:type :return :segment seg :pc n :env E :window W :rd r}     ; one frame kind of K\n   130\t```\n   390\t| C1 | `:yin.k/segment` of the frame and of every return frame names a key of `code` | `:segment` |\n   391\t| C2 | an `act`'s `pc`, every return frame's `pc` and a `tail`'s `site` are **exact non-negative integers** (`cbor/numeric-kind` `:integer` for a wire value; never a float carrier), checked **before** any indexing; then `0 < pc < (count v)` and `0 ≤ site < (count v)` | `:pc-kind` / `:pc-bounds` |\n   392\t| C3 | `body(pc−1) = body(pc)` for the act and every return frame (no body ends in a parking instruction, frozen §3.4 rule 6) | `:pc-body` |\n   393\t\n   394\t**The current activation (`act` only; a `tail` skips A1-A6).**\n   395\t\n   396\t| # | Rule | Kind |\n   397\t|---|---|---|\n   398\t| A1 | `inst(pc−1)` is one of `:stream-next :stream-put :ffi-call :park :current-continuation`, or a `:call` with `tail?` false | `:site` |\n   399\t| A2 | `(:yin.k/rd deliver) = (code/rd inst(pc−1))` and `deliver = {:yin.k/deliver :rd :yin.k/rd r}` exactly | `:destination` / `:deliver` |\n   400\t| A3 | every window key `< k(body(pc))` | `:window-scope` |\n   401\t| A4 | `rd ∉ (keys window)` | `:window-self` |\n   402\t| A5 | `(set (keys window)) ⊆ (analysis/saved a pc rd)` | `:window-extra` |\n   403\t| A6 | `(analysis/saved a pc rd) ⊆ (set (keys window))` | `:window-missing` |\n   404\t\n   405\t**The tail site (`tail` only).**\n   406\t\n   407\t| # | Rule | Kind |\n   408\t|---|---|---|\n   409\t| T1 | `inst(site)` is a `:call` with `tail?` true; `deliver = {:yin.k/deliver :return}` exactly | `:site` / `:deliver` |\n   410\t\n   411\t**Return frames (every frame, each `K[i]`).**\n   412\t\n   413\t| # | Rule | Kind |\n   414\t|---|---|---|\n   415\t| K1 | `inst(frame.pc−1)` in `frame.segment` is a `:call` with `tail?` false | `:return-site` |\n   416\t| K2 | `frame.rd = (code/rd inst(frame.pc−1))` | `:return-destination` |\n   417\t| K3 | every key of `frame.window` `< k(body(frame.pc))`; `frame.rd ∉ keys`; `(set (keys frame.window)) = (analysis/saved aₛ frame.pc frame.rd)` in that segment's analysis, reported as `:return-window-scope` / `:return-window-self` / `:return-window-extra` / `:return-window-missing` | as named |\n   418\t\n   419\t**Environments (every `E`: the act's and each return frame's).**\n   420\t\n   421\t| # | Rule | Kind |\n   422\t|---|---|---|\n   423\t| E1 | no binding key is reserved (`vm/reserved-name?`) | `:reserved-name` |\n   424\t| E2 | **`E` is the free environment under the lexical chain.** With `C = (set (mapcat params (chain (body pc))))` the lexically bound names at that pc (a return frame's chain is that of its own `pc`): (a) **every name of `C` is a key of `bindings`**, a nil binding being a present key (`bind-params` nil-fills, so a lexical name is never absent; an absent one would be nil-filled on lower and break the canonical round trip); (b) `(apply dissoc bindings C) = (apply dissoc (:free-env task) C)` as maps of `V`: a key outside `C` the free environment lacks, a free key `E` lacks, or a differing value, is a defect | `:free-env-mismatch` |\n   425\t\n   426\t**Task (once per body, before any frame; `frame/task-defect`).**\n   427\t\n   428\t| # | Rule | Kind |\n   429\t|---|---|---|\n   430\t| X1 | the root's `free-env` decodes to a map `{S V …}` with symbol keys, sorted and unique on the wire, none reserved (`vm/reserved-name?`, the same check `create-vm` runs on its `:env`, `vm/check-bindings!`, `vm.cljc:161-168`); it is the `:free-env` every E2 compares against | `:free-env-shape` / `:reserved-name` (path `[:free-env]`) |\n   595\t   each `:ffi-call` operand (phase-5 §3.2). So H **with every `:push`\n   596\t   removed** corresponds one-to-one, in order, with A: the k-th non-push\n   597\t   H instruction ↔ A pc `k`; `h->a`, `a->h` are the two directions. The\n   598\t   harness checks mnemonic families agree at every k (§5.6 item 4).\n   599\t2. **operand layout.** For an A pc `p` and the parse node at `p`,\n   600\t   `stack-layout(p)` is the vector, bottom to top, of the virtual\n   601\t   registers whose values are pushed and not yet consumed while control\n   602\t   is inside `p`'s expression: for each ancestor `n` and the child `c` on\n   603\t   the path to `p`, the children of `n` before `c` that `n` pushes (a\n   604\t   `:call`: the operator and the operands before `c`; a `:stream-put`:\n   605\t   the target when `c` is the value; an `:ffi-call`: the operands before\n   606\t   `c`; `:if`, `:define`, `:stream-cursor/next/close`, `:resume`: none).\n   607\t   **Checked** (§5.6 item 5): for a **non-tail** parking instruction,\n   608\t   `(set (stack-layout p)) = (analysis/saved a (inc p) (code/rd v[p]))`.\n   609\t   For a **tail** `:call` the canonical state has no window and\n   610\t   `stack-layout(p)` is not consulted (it may be non-empty for a tail\n   611\t   call in operand position, whose pushed siblings are dead layout\n   612\t   syntax).\n   613\t\n   614\t**K slices (corrected).** Let the kernel's continuation be\n   615\t`[f₀ … f_{m−1}]` outermost first with bases `b₀ … b_{m−1}` and the\n   616\toperand stack `St` of length `n`. Because `bᵢ = (count stack')` is the\n   617\tcaller's residual height **after** popping the callee's operands, the\n   618\tslice of operands belonging to activation `i` is\n   619\t\n   620\t```\n   621\tslice(f₀)      = St[0, b₀)\n   622\tslice(fᵢ)      = St[b_{i−1}, bᵢ)        for 0 < i < m\n   623\tslice(current) = St[b_{m−1}, n)         ; or St[0, n) when K is empty\n   624\t```\n   625\t\n   626\t(the review's correction: `[previous-base, base_i)` with previous-base\n   627\t0, and the current activation `[last-base, count)`).\n   628\t\n   629\t**Lift, `act`.** From a wait entry `{:image :pc :frames :stack\n   630\t:continuation :store-of}` (v2 amendment §5.2) whose `pc−1` in H is **not**\n   631\ta tail `:call`:\n   632\t\n   633\t1. `A` from the image row; relative H pc `pcₕ = pc − off`; canonical\n   634\t   `pc = h->a(pcₕ − 1) + 1`; `rd = (code/rd v[pc−1])`.\n   635\t2. `W = (zipmap (stack-layout (dec pc)) slice(current))`; the two have\n   636\t   equal length (checked) and `(keys W) = saved(pc, rd)` (rule A5/A6).\n   637\t3. `E` = §4.4 from `frames` and `store-of` at `body(pc)`.\n   638\t4. `K`: for `fᵢ` **independently**: its `return-pc` is absolute; row and\n   639\t   relative `pcₕᵢ` through the stack kernel's own offset table\n   640\t   (`debruijn/stack.cljc:355`, `absolute-pc`'s inverse); `Aᵢ` of that row;\n   641\t   `pcᵢ = h->a_{Aᵢ}(pcₕᵢ − 1) + 1`; `rdᵢ = (code/rd vᵢ[pcᵢ−1])`;\n   642\t   `Wᵢ = (zipmap (stack-layout_{Aᵢ} (dec pcᵢ)) slice(fᵢ))`; `Eᵢ` = §4.4\n   643\t   from `fᵢ.frames` and `fᵢ.store-of`.\n   644\t5. pending from the engine fields.\n   645\t\n   646\t**Lift, `tail`.** From a wait entry whose `pc−1` in H is a tail `:call`:\n   647\t`A` and `site = h->a(pcₕ − 1)`; `K` as in 4; pending; the entry's\n   648\t`frames`, `store-of` and `slice(current)` are **discarded** (dead\n   649\tlayout syntax; frozen §2.4).\n   650\t\n   651\t**Lower, `act`.** `:image` the row of `A`; `:pc = off + a->h(pc−1) + 1`;\n   652\t`:frames` by §4.4 from `E`; `:store-of` from `E`; `:stack` = the\n   653\tconcatenation over `K` outermost first of each `slice(fᵢ)` =\n   654\t`(mapv Wᵢ (stack-layout_{Aᵢ} (dec pcᵢ)))`, then `slice(current) =\n   655\t(mapv W (stack-layout (dec pc)))`; `:continuation` = for each `fᵢ`\n","exit_code":0,"status":"completed"}}
