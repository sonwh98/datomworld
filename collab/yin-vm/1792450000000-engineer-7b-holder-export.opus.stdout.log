eq (:yin.k/closes m)) {:yin.k/hold :pending-close}\n      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor))) waits)\n      {:yin.k/hold :link-cursor-not-installed}\n      :else nil)))\n\n\n(defn enter\n  \"holder.export/enter before 7b: the gate, the wait set and the\n   reachable parked records (handoff/reachable-parked) into a record.\"\n  ([machine] (enter machine nil))\n  ([machine opts]\n   (cond\n     (contains? #{:exporting :ended} (vm/gate-mode machine))\n     {:yin.k/status :yin.k/refused :yin.k/reason :not-running}\n\n     :else\n     (or (some (fn [[path m]]\n                 (when (seq (:ready-queue m))\n                   {:yin.k/status :yin.k/not-quiescent :yin.k/path path\n                    :yin.k/ready (count (:ready-queue m))}))\n               (task-machines [] machine))\n         (some (fn [[path m]]\n                 (when-some [h (hold-of m)]\n                   (assoc h :yin.k/path path :yin.k/status :yin.k/non-portable\n                          :yin.k/kind :reason-mismatch)))\n               (task-machines [] machine))\n         (let [r (handoff/reachable-parked machine)]\n           (or (:refusal r)\n               (let [ids (:ids r)\n                     parked (:parked machine)]\n                 {:status :ok\n                  :machine (-> machine\n                               (assoc :yin.k/gate :exporting :wait-set [])\n                               (assoc :parked (apply dissoc parked ids)))\n                  :record (cond-> {:wait-set (vec (:wait-set machine))\n                                   :parked (select-keys parked ids)\n                                   :gate (vm/gate-mode machine)\n                                   :served {}}\n                            (some? (:version opts)) (assoc :version (:version opts)))})))))))\n\n\n(defn- reinstated\n  [machine record]\n  (-> machine\n      (assoc :wait-set (:wait-set record))\n      (update :parked merge (:parked record))))\n\n\n(defn prepare\n  \"holder.export/prepare before 7b: serve once per stream through the\n   version-0/1/2 lift (its recovery census), retaining every answer\n   under [path resource-id].\"\n  [machine record serve! header]\n  (when (some? header)\n    (when-not (and (map? header) (contains? header :yin.k/arbitration)\n                   (contains? header :yin.k/next-op-seq) (set? (:yin.k/enrolled header)))\n      (throw (ex-info \"Prepare of a malformed header\" {:yin.k/hint :malformed-header}))))\n  (let [table (atom (:served record))\n        at (into {} (task-machines [] machine))\n        by-handle (atom (into {} (keep (fn [[[path id] d]]\n                                         (when-some [h (get-in (get at path) [:resources id])] [h d])))\n                              (:served record)))\n        once (fn [k h]\n               (let [t @table]\n                 (cond\n                   (contains? t k) (let [served (get t k)] (swap! by-handle assoc h served) served)\n                   (contains? @by-handle h) (let [served (get @by-handle h)] (swap! table assoc k served) served)\n                   :else (let [served (serve! h)]\n                           (when (some? served)\n                             (swap! table assoc k served)\n                             (swap! by-handle assoc h served))\n                           served))))\n        record (assoc record :header header)\n        r (handoff/export-task (reinstated machine record) nil\n                               (cond-> {:header header :serve-keyed once\n                                        :yin.vm.ucf.handoff/recovery true}\n                                 (:version record) (assoc :version (:version record))))]\n    (if (= :ok (:status r))\n      {:status :ok :record (assoc record :served @table)}\n      (assoc r :record (assoc record :served @table)))))\n\n\n(defn encode\n  \"holder.export/encode before 7b: handoff/export-task from the record's\n   retained answers, under its header.\"\n  [machine record]\n  (let [serv