{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KbWCk9KkX9PZeioRg5Dt4w","type":"tool_result","content":"1\t(ns yin.vm.ucf.holder.export-test\n2\t  \"D8: the exporting state, the prepare/encode split and the abort rule\n3\t   (UCF 7.7.4; r3 1.8 and 1.9).  Every machine is parked by the real\n4\t   engine; counting handles show what the gate and the encode touch.\"\n5\t  (:require [clojure.test :refer [deftest is testing]]\n6\t            [dao.jing :as jing]\n7\t            [dao.jing.cbor :as cbor]\n8\t            [dao.stream :as stream]\n9\t            [dao.stream.cbor :as legacy-cbor]\n10\t            [dao.stream.ringbuffer :as ringbuffer]\n11\t            [yin.vm :as vm]\n12\t            [yin.vm.engine :as engine]\n13\t            [yin.vm.linearize :as linearize]\n14\t            [yin.vm.module :as module]\n15\t            [yin.vm.semantic :as semantic]\n16\t            [yin.vm.values :as values]\n17\t            [yin.vm.test-utils :as tu]\n18\t            [yin.vm.ucf.holder.export :as export]))\n19\t\n20\t\n21\t(declare parked-machine parked-explicit parked-installer served-table new-machine)\n22\t\n23\t\n24\t(defn- content-address\n25\t  [bytes]\n26\t  (keyword \"segment\"\n27\t           (str (get-in jing/registry [jing/default-hash-algorithm :address-id])\n28\t                \"-\" (jing/digest-bytes jing/default-hash-algorithm bytes))))\n29\t\n30\t\n31\t(deftest recovery-validation-precedes-attachment-test\n32\t  (let [{:keys [machine record]} (export/enter (parked-machine))\n33\t        {:keys [serve!]} (served-table)\n34\t        prepared (export/prepare machine record serve! nil)\n35\t        frozen (export/freeze machine (:record prepared))\n36\t        recovery (cbor/decode (:bytes frozen))\n37\t        changed-snapshot (legacy-cbor/encode\n38\t                           (update (legacy-cbor/decode (jing/base64->bytes (:yin.k/snapshot-bytes recovery)))\n39\t                                   :yin.k/id-counter inc))\n40\t        other-entered (export/enter (parked-explicit))\n41\t        other-prepared (export/prepare (:machine other-entered) (:record other-entered) serve! nil)\n42\t        other-recovery (cbor/decode (:bytes (export/freeze (:machine other-entered) (:record other-prepared))))\n43\t        attachments (atom 0)]\n44\t    (doseq [invalid [(assoc recovery :yin.k/version 2)\n45\t                     (assoc recovery :yin.k/header {:yin.k/enrolled #{}})\n46\t                     (assoc recovery :yin.k/descriptors #{})\n47\t                     (assoc-in recovery [:yin.k/state :issues] [])\n48\t                     (assoc recovery :yin.k/snapshot-bytes (jing/bytes->base64 changed-snapshot)\n49\t                            :yin.k/snapshot-address (content-address changed-snapshot))\n50\t                     (merge recovery (select-keys other-recovery [:yin.k/snapshot-bytes :yin.k/snapshot-address]))]]\n51\t      (let [bytes (cbor/encode invalid)\n52\t            restored (export/rehydrate-fenced (new-machine) bytes\n53\t                                              {:address (content-address bytes)\n54\t                                               :attach (fn [_] (swap! attachments inc) nil)})]\n55\t        (is (not= :ok (:status restored)))\n56\t        (is (nil? (:machine restored)))\n57\t        (is (zero? @attachments))))))\n58\t\n59\t\n60\t(deftest complete-export-recovery-is-fenced-and-reproducible-test\n61\t  (doseq [source [(parked-machine) (parked-explicit) (parked-installer)]]\n62\t    (let [{machine :machine record :record} (export/enter source)\n63\t          {:keys [serve! table]} (served-table)\n64\t          prepared (export/prepare machine record serve! nil)\n65\t          frozen (export/freeze machine (:record prepared))\n66\t          by-identity (into {} (map (fn [[handle descriptor]]\n67\t                                      [(:dao.stream/identity descriptor) handle])) @table)\n68\t          restored (export/rehydrate-fenced (new-machine) (:bytes frozen)\n69\t                                            {:address (:address frozen)\n70\t                                             :attach (fn [descriptor]\n71\t                                                       {:dao.stream/outcome :dao.stream/ok\n72\t                                                        :dao.stream/handle\n73\t                                                        (by-identity (:dao.stream/identity descriptor))})})\n74\t          encoded (when (= :ok (:status restored))\n75\t                    (export/encode (:machine restored) (:record restored)))]\n76\t      (is (= :ok (:status frozen)) (pr-str frozen))\n77\t      (is (= :ok (:status restored)) (pr-str restored))\n78\t      (is (= :exporting (vm/gate-mode (:machine restored))))\n79\t      (is (empty? (:wait-set (:machine restored))))\n80\t      (is (= (count (:wait-set record)) (count (get-in restored [:record :wait-set]))))\n81\t      (is (= :yin.k/refused\n82\t             (:yin.k/status (export/abort (:machine restored) (:record restored) [] nil))))\n83\t      (is (= (vec (:body-bytes frozen)) (vec (:bytes encoded)))))))\n84\t\n85\t\n86\t(deftest recovery-restores-fresh-name-state-without-receiver-contamination-test\n87\t  (let [source (assoc (parked-machine) :origins 42 :id-counter 88 :yin.k/issued 77)\n88\t        {:keys [machine record]} (export/enter source)\n89\t        {:keys [serve! table]} (served-table)\n90\t        prepared (export/prepare machine record serve! nil)\n91\t        frozen (export/freeze machine (:record prepared))\n92\t        by-identity (into {} (map (fn [[handle descriptor]]\n93\t                                    [(:dao.stream/identity descriptor) handle])) @table)\n94\t        restored (export/rehydrate-fenced\n95\t                   (assoc (new-machine) :origins 99 :id-counter 100\n96\t                          :store {'receiver-local :wrong} :yin.k/issued 33\n97\t                          :yin.k/closes [{:receiver-local true}])\n98\t                   (:bytes frozen)\n99\t                   {:address (:address frozen)\n100\t                    :attach (fn [descriptor]\n101\t                              {:dao.stream/outcome :dao.stream/ok\n102\t                               :dao.stream/handle (by-identity (:dao.stream/identity descriptor))})})]\n103\t    (is (= :ok (:status restored)) (pr-str restored))\n104\t    (is (= 42 (:origins (:machine restored))))\n105\t    (is (= 88 (:id-counter (:machine restored))))\n106\t    (is (= 77 (:yin.k/issued (:machine restored))))\n107\t    (is (not (contains? (:store (:machine restored)) 'receiver-local)))\n108\t    (is (empty? (:yin.k/closes (:machine restored))))))\n109\t\n110\t\n111\t;; =============================================================================\n112\t;; Machines\n113\t;; =============================================================================\n114\t\n115\t(defn- throws?\n116\t  [thunk]\n117\t  (try (thunk) false\n118\t       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n119\t\n120\t\n121\t(defn- ring\n122\t  [capacity]\n123\t  (:dao.stream/handle\n124\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n125\t                         ringbuffer/capacity-key capacity})))\n126\t\n127\t\n128\t(defn- make-ring-stream\n129\t  [capacity]\n130\t  (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n131\t                       ringbuffer/capacity-key capacity}))\n132\t\n133\t\n134\t(def ^:private semantic-vector\n135\t  (comp :vector linearize/lower-rows vm/ast->semantic-bytecode))\n136\t\n137\t\n138\t(defn- load-ast\n139\t  [machine ast]\n140\t  (semantic/load-vector machine (semantic-vector ast)\n141\t                        vm/semantic-contract))\n142\t\n143\t\n144\t(defn- new-machine\n145\t  ([] (new-machine {}))\n146\t  ([opts]\n147\t   (semantic/create-vm\n148\t     (merge {:make-stream make-ring-stream\n149\t             :capability-secret tu/secret\n150\t             :modules (module/default-registry)\n151\t             :secret-source (fn [origin]\n152\t                              (str tu/secret \"/\" (name origin)))}\n153\t            opts))))\n154\t\n155\t\n156\t(defn- lit\n157\t  [x]\n158\t  {:type :literal, :value x})\n159\t\n160\t\n161\t(defn- v\n162\t  [n]\n163\t  {:type :variable, :name n})\n164\t\n165\t\n166\t(defn- lam\n167\t  [params body]\n168\t  {:type :lambda, :params params, :body body})\n169\t\n170\t\n171\t(defn- app\n172\t  [f & args]\n173\t  {:type :application, :operator f, :operands (vec args)})\n174\t\n175\t\n176\t(defn- then\n177\t  [a b]\n178\t  (app (lam ['_] b) a))\n179\t\n180\t\n181\t(defn- let1\n182\t  [param init body]\n183\t  (app (lam [param] body) init))\n184\t\n185\t\n186\t(defn- def!\n187\t  [k val]\n188\t  (app (v 'yin/def) (lit k) val))\n189\t\n190\t\n191\t(defn- make-stream-ast\n192\t  []\n193\t  {:type :stream/make, :buffer 4})\n194\t\n195\t\n196\t(defn- cursor-of\n197\t  [source]\n198\t  {:type :stream/cursor, :source source})\n199\t\n200\t\n201\t(defn- next-of\n202\t  [source]\n203\t  {:type :stream/next, :source source})\n204\t\n205\t\n206\t(defn- two-streams\n207\t  \"Parks on a read of the first stream; the store also holds the second\n208\t   stream and a cursor on each, so the lift reaches two streams.\"\n209\t  []\n210\t  (let1 'a (make-stream-ast)\n211\t        (let1 'b (make-stream-ast)\n212\t              (then (def! 'held-a (cursor-of (v 'a)))\n213\t                    (then (def! 'held-b (cursor-of (v 'b)))\n214\t                          (next-of (v 'held-a)))))))\n215\t\n216\t\n217\t(defn- parked-machine\n218\t  []\n219\t  (vm/run (load-ast (new-machine) (two-streams))))\n220\t\n221\t\n222\t(defn- module-response\n223\t  []\n224\t  {:status :ok,\n225\t   :image {:value (semantic-vector\n226\t                    (let1 's (make-stream-ast)\n227\t                          (then (next-of (cursor-of (v 's)))\n228\t                                (def! 'f (lam [] (lit 42))))))},\n229\t   :manifest {:yin.module/name 'host.mod,\n230\t              :yin.module/exports #{'f}},\n231\t   :obligations []})\n232\t\n233\t\n234\t(defn- parked-installer\n235\t  \"A real machine parked at :install with a live child blocked on its\n236\t   own read.\"\n237\t  []\n238\t  (let [request (ring 64)\n239\t        response (ring 64)\n240\t        m0 (vm/run (load-ast (new-machine {:link-request request\n241\t                                           :link-response response})\n242\t                             (then (app (v 'require) (lit 'host.mod))\n243\t                                   (app (v 'host.mod/f)))))\n244\t        entry (first (:wait-set m0))\n245\t        _ (stream/append! response\n246\t                          (assoc (module-response)\n247\t                                 :yin.link/id (:link-id entry)))]\n248\t    (vm/run m0)))\n249\t\n250\t\n251\t(defn- served-table\n252\t  \"A `serve!` that counts its calls and answers one stable identity per\n253\t   handle.\"\n254\t  []\n255\t  (let [calls (atom 0)\n256\t        table (atom {})]\n257\t    {:calls calls\n258\t     :table table\n259\t     :serve! (fn [h]\n260\t               (swap! calls inc)\n261\t               (or (get @table h)\n262\t                   (let [served {:dao.stream/identity (str \"s\" (count @table))\n263\t                                 :dao.stream/channel {:dao.stream/type\n264\t                                                      :test/channel}}]\n265\t                     (swap! table assoc h served)\n266\t                     served)))}))\n267\t\n268\t\n269\t;; =============================================================================\n270\t;; Gated machines over counting handles\n271\t;; =============================================================================\n272\t\n273\t(defn- counting-handle\n274\t  [calls]\n275\t  (reify\n276\t    stream/IDaoStreamReader\n277\t\n278\t    (cursor\n279\t      [_ _]\n280\t      (swap! calls inc)\n281\t      {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor ::at})\n282\t\n283\t    (next\n284\t      [_ _]\n285\t      (swap! calls inc)\n286\t      {:dao.stream/outcome :dao.stream/blocked})\n287\t\n288\t\n289\t    stream/IDaoStreamWriter\n290\t\n291\t    (append!\n292\t      [_ _]\n293\t      (swap! calls inc)\n294\t      {:dao.stream/outcome :dao.stream/ok})\n295\t\n296\t\n297\t    stream/IDaoStreamClosable\n298\t\n299\t    (close!\n300\t      [_]\n301\t      (swap! calls inc)\n302\t      {:dao.stream/outcome :dao.stream/ok})))\n303\t\n304\t\n305\t(def ^:private park-entry-fns\n306\t  {:stream/put (fn [_s _e r] {:reason :put, :stream-id (:stream-id r)}),\n307\t   :stream/next (fn [_s _e r]\n308\t                  {:reason :next,\n309\t                   :cursor-ref (:cursor-ref r),\n310\t                   :stream-id (:stream-id r)})})\n311\t\n312\t\n313\t(def ^:private opts {:park-entry-fns park-entry-fns})\n314\t\n315\t\n316\t(defn- gated\n317\t  \"[state stream-ref cursor-ref calls] under the :running gate.\"\n318\t  []\n319\t  (let [calls (atom 0)\n320\t        [sref s0] (engine/attach-resource\n321\t                    (vm/empty-state {:make-stream tu/make-stream,\n322\t                                     :capability-secret tu/secret})\n323\t                    (counting-handle calls))\n324\t        [cref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)]\n325\t    (reset! calls 0)\n326\t    [(assoc s1 :yin.k/gate :running) sref cref calls]))\n327\t\n328\t\n329\t(defn- run-effect\n330\t  [state kind m]\n331\t  (:state (engine/handle-effect state (module/make-effect kind m) opts)))\n332\t\n333\t\n334\t(defn- hold\n335\t  \"The one-slot reason string for the kind of hold `m` has.\"\n336\t  [outcome]\n337\t  (:yin.k/hold outcome))\n338\t\n339\t\n340\t;; =============================================================================\n341\t;; Entering exporting\n342\t;; =============================================================================\n343\t\n344\t(deftest enter-moves-waits-and-fences-the-machine-test\n345\t  (let [[s sref _ _] (gated)\n346\t        s (run-effect s :stream/put {:stream sref, :val 1})\n347\t        waits (:wait-set s)\n348\t        r (export/enter s)]\n349\t    (is (= :ok (:status r)) (pr-str r))\n350\t    (is (= :exporting (vm/gate-mode (:machine r))))\n351\t    (is (empty? (:wait-set (:machine r))) \"nothing left to poll\")\n352\t    (is (= waits (get-in r [:record :wait-set])) \"waits kept in order\")\n353\t    (is (= :running (get-in r [:record :gate])))\n354\t    (testing \"an exporting machine cannot enter again\"\n355\t      (is (= :yin.k/refused (:yin.k/status (export/enter (:machine r))))))))\n356\t\n357\t\n358\t(deftest exporting-appends-nothing-test\n359\t  (let [[s sref _ calls] (gated)\n360\t        s (run-effect s :stream/put {:stream sref, :val 1})\n361\t        child-calls (atom 0)\n362\t        child (vm/run (load-ast (new-machine\n363\t                                  {:make-stream\n364\t                                   (fn [capacity]\n365\t                                     (let [r (make-ring-stream capacity)]\n366\t                                       (assoc r\n367\t                                              :dao.stream/handle\n368\t                                              (counting-handle child-calls))))})\n369\t                                (next-of (cursor-of (make-stream-ast)))))\n370\t        s (assoc s :installs {'foo {:phase :running\n371\t                                    :vm child\n372\t                                    :parent [:t0 0]\n373\t                                    :response {}}})\n374\t        _ (reset! child-calls 0)\n375\t        {m :machine} (export/enter s)\n376\t        stamped (assoc s :parked {:parked-0 {:type :parked-continuation\n377\t                                             :id :parked-0}})]\n378\t    (testing \"polling the source\"\n379\t      (engine/check-wait-set m)\n380\t      (is (zero? @calls)))\n381\t    (testing \"ticking its install child\"\n382\t      (let [swept (engine/check-wait-set m)]\n383\t        (is (zero? @child-calls))\n384\t        (is (= child (get-in swept [:installs 'foo :vm])))))\n385\t    (testing \"a direct resume\"\n386\t      (let [restored (atom 0)]\n387\t        (is (throws? #(engine/resume-continuation\n388\t                        (assoc m :parked (:parked stamped))\n389\t                        :parked-0 1\n390\t                        (fn [st _ _] (swap! restored inc) st))))\n391\t        (is (zero? @restored))\n392\t        (is (zero? @calls))))))\n393\t\n394\t\n395\t(deftest a-non-empty-ready-queue-is-not-quiescent-test\n396\t  (let [[s _ _ _] (gated)\n397\t        r (export/enter (assoc s :ready-queue [{:id 1}]))]\n398\t    (is (= :yin.k/not-quiescent (:yin.k/status r)))\n399\t    (testing \"a child's queue too\"\n400\t      (let [r (export/enter\n401\t                (assoc s :installs {'foo {:vm (assoc (vm/empty-state {})\n402\t                                                     :ready-queue [{:id 1}])}}))]\n403\t        (is (= :yin.k/not-quiescent (:yin.k/status r)))))))\n404\t\n405\t\n406\t(defn- refused-as\n407\t  [kind r]\n408\t  (and (= :yin.k/non-portable (:yin.k/status r))\n409\t       (= :reason-mismatch (:yin.k/kind r))\n410\t       (= kind (hold r))))\n411\t\n412\t\n413\t(deftest each-export-refusal-fires-on-a-real-parked-machine-test\n414\t  (let [[s sref cref calls] (gated)]\n415\t    (testing \"an :observe entry\"\n416\t      (let [m (run-effect s :stream/poll {:cursor cref})]\n417\t        (is (= :observe (:reason (first (:wait-set m)))))\n418\t        (is (refused-as :observe (export/enter m)))))\n419\t    (testing \"an entry carrying :yin.k/held\"\n420\t      (let [m (run-effect s :stream/next {:cursor cref})\n421\t            m (assoc-in m [:wait-set 0 :yin.k/held] {:state :observed})]\n422\t        (is (refused-as :held (export/enter m)))))\n423\t    (testing \"an unminted cursor cell\"\n424\t      (let [m (run-effect s :stream/cursor {:stream sref})]\n425\t        (is (refused-as :unminted-cursor (export/enter m)))))\n426\t    (testing \"a pending close\"\n427\t      (let [m (run-effect s :stream/close {:stream sref})]\n428\t        (is (seq (:yin.k/closes m)))\n429\t        (is (refused-as :pending-close (export/enter m)))))\n430\t    (testing \"a link request with no response cursor\"\n431\t      (let [m (vm/run (assoc (load-ast (new-machine {:link-request (ring 8)\n432\t                                                     :link-response (ring 8)})\n433\t                                       (app (v 'require) (lit 'foo)))\n434\t                             :yin.k/gate :running))\n435\t            entry (first (:wait-set m))]\n436\t        (is (= :link-request (:reason entry)))\n437\t        (is (not (contains? entry :cursor)))\n438\t        (is (refused-as :link-cursor-not-installed (export/enter m)))))\n439\t    (testing \"a refusal in an install child names its path\"\n440\t      (let [child (run-effect s :stream/close {:stream sref})\n441\t            m (assoc (vm/empty-state {})\n442\t                     :installs {'foo {:vm child}})\n443\t            r (export/enter m)]\n444\t        (is (refused-as :pending-close r))\n445\t        (is (= ['foo] (:yin.k/path r)))))\n446\t    (testing \"a refusal leaves the machine as it was\"\n447\t      (is (zero? @calls)))))\n448\t\n449\t\n450\t;; =============================================================================\n451\t;; Prepare, then encode\n452\t;; =============================================================================\n453\t\n454\t(deftest prepare-serves-once-per-stream-and-encode-serves-nothing-test\n455\t  (let [m (parked-machine)\n456\t        {:keys [calls table serve!]} (served-table)\n457\t        {m' :machine record :record} (export/enter m)\n458\t        prepared (export/prepare m' record serve! nil)\n459\t        record' (:record prepared)\n460\t        after-prepare @calls\n461\t        e1 (export/encode m' record')\n462\t        e2 (export/encode m' record')]\n463\t    (is (= :ok (:status prepared)) (pr-str prepared))\n464\t    (is (= 2 (count @table)) \"two streams reached\")\n465\t    (is (= (count @table) after-prepare) \"serve! once per stream\")\n466\t    (is (= (count @table) (count (:served record'))))\n467\t    (is (= after-prepare @calls) \"encode calls nothing\")\n468\t    (is (= :ok (:status e1)) (pr-str e1))\n469\t    (is (= (vec (:bytes e1)) (vec (:bytes e2))) \"deterministic bytes\")\n470\t    (is (= (:address e1) (:address e2)))\n471\t    (testing \"preparing a prepared record again serves nothing new\"\n472\t      (export/prepare m' record' serve! nil)\n473\t      (is (= after-prepare @calls)))\n474\t    (testing \"an unprepared record is a defect, not a refusal\"\n475\t      (is (throws? #(export/encode m' record))))))\n476\t\n477\t\n478\t(deftest prepare-reaches-install-children-once-test\n479\t  (let [m (parked-installer)\n480\t        {:keys [calls table serve!]} (served-table)\n481\t        {m' :machine record :record} (export/enter m)\n482\t        prepared (export/prepare m' record serve! nil)]\n483\t    (is (= :ok (:status prepared)) (pr-str prepared))\n484\t    (is (pos? @calls))\n485\t    (is (= @calls (count @table)) \"each stream, child's included, once\")\n486\t    (let [n @calls]\n487\t      (is (= :ok (:status (export/encode m' (:record prepared)))))\n488\t      (is (= n @calls)))))\n489\t\n490\t\n491\t;; =============================================================================\n492\t;; Abort\n493\t;; =============================================================================\n494\t\n495\t(defn- exporting\n496\t  [machine]\n497\t  (let [r (export/enter machine)]\n498\t    [(:machine r) (:record r) machine]))\n499\t\n500\t\n501\t(deftest abort-with-no-persisted-intent-restores-the-machine-test\n502\t  (let [[m record original] (exporting (parked-machine))\n503\t        r (export/abort m record [] nil)]\n504\t    (is (= :ok (:status r)))\n505\t    (is (= original (:machine r)) \"the old local machine, as it was\")))\n506\t\n507\t\n508\t(deftest abort-restores-the-prior-gate-test\n509\t  (let [[s sref _ _] (gated)\n510\t        s (run-effect s :stream/put {:stream sref, :val 1})\n511\t        [m record _] (exporting s)]\n512\t    (is (= s (:machine (export/abort m record [] nil))))))\n513\t\n514\t\n515\t(deftest abort-after-provably-not-appended-attempts-test\n516\t  (let [[m record original] (exporting (parked-machine))]\n517\t    (doseq [outcome [:dao.stream/full :dao.stream/invalid-value\n518\t                     :dao.stream/closed :dao.stream/refused]]\n519\t      (is (= original\n520\t             (:machine (export/abort m record\n521\t                                     [{:append outcome} {:append outcome}]\n522\t                                     nil)))\n523\t          (str outcome \" proves nothing was appended\")))))\n524\t\n525\t\n526\t(deftest abort-is-refused-when-the-offer-may-have-been-accepted-test\n527\t  (let [[m record _] (exporting (parked-machine))\n528\t        refused? (fn [attempts]\n529\t                   (let [r (export/abort m record attempts nil)]\n530\t                     (and (= :yin.k/refused (:yin.k/status r))\n531\t                          (= :offer-possibly-accepted (:yin.k/reason r)))))]\n532\t    (testing \"an unknown append (intent persisted, no outcome)\"\n533\t      (is (refused? [{}])))\n534\t    (testing \"an unknown append among provable ones\"\n535\t      (is (refused? [{:append :dao.stream/full} {}])))\n536\t    (testing \"an accepted append\"\n537\t      (is (refused? [{:append :dao.stream/ok}])))\n538\t    (testing \"a transport error is unknown delivery\"\n539\t      (is (refused? [{:append :dao.stream/transport-error}])))\n540\t    (testing \"a refusal that followed an unknown append is no evidence\"\n541\t      (is (refused? [{} {:append :dao.stream/full\n542\t                         :reply :yin.k/refused}])))\n543\t    (testing \"a refusal of one request is no evidence of the others\"\n544\t      (is (refused? [{:append :dao.stream/ok :reply :yin.k/refused}])))\n545\t    (testing \"the machine stays fenced\"\n546\t      (is (= :exporting (vm/gate-mode m))))))\n547\t\n548\t\n549\t(deftest a-holder-past-its-lease-bound-cannot-abort-test\n550\t  (let [[s sref _ _] (gated)\n551\t        s (-> (run-effect s :stream/put {:stream sref, :val 1})\n552\t              (assoc :yin.k/custody {:yin.k/occurrence \"o\"}))\n553\t        [m record original] (exporting s)\n554\t        abort (fn [tenure] (export/abort m record [] tenure))\n555\t        reason (fn [r] [(:yin.k/status r) (:yin.k/reason r)])]\n556\t    (testing \"current, ledger-confirmed tenure may abort\"\n557\t      (is (= original (:machine (abort {:now 10 :bound 20 :live true})))))\n558\t    (testing \"at the bound and past it, never\"\n559\t      (doseq [t [{:now 20 :bound 20 :live true}\n560\t                 {:now 21 :bound 20 :live true}\n561\t                 {:now 21 :bound 20}]]\n562\t        (is (= [:yin.k/refused :tenure-ended] (reason (abort t))))))\n563\t    (testing \"inside the bound with no ledger evidence is unconfirmed\"\n564\t      (doseq [t [{:now 10 :bound 20} {:now 10 :bound 20 :live false} nil]]\n565\t        (is (= [:yin.k/refused :tenure-unconfirmed] (reason (abort t))))))\n566\t    (testing \"tenure alone does not license an uncertain offer\"\n567\t      (is (= :offer-possibly-accepted\n568\t             (:yin.k/reason (export/abort m record [{}]\n569\t                                          {:now 10 :bound 20 :live true})))))))\n570\t\n571\t\n572\t(def ^:private served-answer\n573\t  {:dao.stream/identity \"s0\"\n574\t   :dao.stream/channel {:dao.stream/type :test/channel}})\n575\t\n576\t\n577\t(deftest a-refused-prepare-keeps-what-it-served-test\n578\t  (let [m (parked-machine)\n579\t        {m' :machine record :record} (export/enter m)\n580\t        first-handle (atom nil)\n581\t        ;; serves the first stream it is asked about, refuses the rest\n582\t        stingy (fn [h]\n583\t                 (compare-and-set! first-handle nil h)\n584\t                 (when (= h @first-handle) served-answer))\n585\t        refused (export/prepare m' record stingy nil)]\n586\t    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n587\t    (is (= 1 (count (get-in refused [:record :served]))))\n588\t    (testing \"a retry with the returned record never re-serves that stream\"\n589\t      (let [asked (atom [])\n590\t            {:keys [serve!]} (served-table)\n591\t            retry (export/prepare m' (:record refused)\n592\t                                  (fn [h]\n593\t                                    (swap! asked conj h)\n594\t                                    (serve! h))\n595\t                                  nil)]\n596\t        (is (= :ok (:status retry)) (pr-str retry))\n597\t        (is (not-any? #(= @first-handle %) @asked))\n598\t        (is (= 1 (count @asked)) \"only the other stream\")))))\n599\t\n600\t\n601\t(defn- parked-explicit\n602\t  \"A real machine at an explicit park, its record's environment holding\n603\t   a cursor on a stream.\"\n604\t  []\n605\t  (vm/run (load-ast (new-machine)\n606\t                    (let1 's (make-stream-ast)\n607\t                          (app (lam ['c] {:type :vm/park})\n608\t                               (cursor-of (v 's)))))))\n609\t\n610\t\n611\t(deftest an-explicit-park-travels-in-the-record-test\n612\t  (let [m (parked-explicit)\n613\t        {m' :machine record :record} (export/enter m)\n614\t        {:keys [serve!]} (served-table)\n615\t        prepared (export/prepare m' record serve! nil)]\n616\t    (is (seq (:parked m)) \"the source holds a parked record\")\n617\t    (is (seq (:parked record)) \"the record holds it\")\n618\t    (is (every? #(not (contains? (:parked m') %)) (keys (:parked record)))\n619\t        \"the machine's :parked lacks it\")\n620\t    (is (empty? (:wait-set m')))\n621\t    (is (= :ok (:status prepared)) (pr-str prepared))\n622\t    (let [e (export/encode m' (:record prepared))]\n623\t      (is (= :ok (:status e)) (pr-str e))\n624\t      (is (= :parked (:kind e))))\n625\t    (is (= m (:machine (export/abort m' record [] nil)))\n626\t        \"abort restores machine equality\")))\n627\t\n628\t\n629\t(deftest an-install-childs-parked-records-stay-in-the-child-test\n630\t  (let [m (parked-installer)\n631\t        parked {:p0 {:type :parked-continuation :id :p0}}\n632\t        m (assoc-in m [:installs 'host.mod :vm :parked] parked)\n633\t        {m' :machine record :record :as r} (export/enter m)]\n634\t    (is (= :ok (:status r)) (pr-str r))\n635\t    (is (= parked (get-in m' [:installs 'host.mod :vm :parked]))\n636\t        \"the child's parked records are not moved\")\n637\t    (is (not-any? #(contains? (:parked record) %) (keys parked)))))\n638\t\n639\t\n640\t(deftest abort-needs-an-exporting-machine-test\n641\t  (let [[m record _] (exporting (parked-machine))\n642\t        restored (:machine (export/abort m record [] nil))]\n643\t    (is (= :yin.k/refused\n644\t           (:yin.k/status (export/abort restored record [] nil))))))\n645\t\n646\t\n647\t(deftest recovery-preserves-aliases-distinct-cells-and-authentic-closures-test\n648\t  (let [source (vm/run\n649\t                 (load-ast (new-machine)\n650\t                           (let1 's (make-stream-ast)\n651\t                                 (let1 'c (cursor-of (v 's))\n652\t                                       (let1 'd (cursor-of (v 's))\n653\t                                             (then (def! 'first-c (v 'c))\n654\t                                                   (then (def! 'alias-c (v 'c))\n655\t                                                         (then (def! 'distinct-c (v 'd))\n656\t                                                               (then (def! 'closure (lam [] (next-of (v 'c))))\n657\t                                                                     (next-of (v 'c)))))))))))\n658\t        {:keys [machine record]} (export/enter source)\n659\t        {:keys [serve!]} (served-table)\n660\t        prepared (export/prepare machine record serve! nil)\n661\t        frozen (export/freeze machine (:record prepared))\n662\t        calls (atom 0)\n663\t        attachments (atom 0)\n664\t        restored (export/rehydrate-fenced\n665\t                   (new-machine {:origin :fresh :capability-secret \"recovery-secret\"})\n666\t                   (:bytes frozen)\n667\t                   {:address (:address frozen)\n668\t                    :attach (fn [_]\n669\t                              (swap! attachments inc)\n670\t                              {:dao.stream/outcome :dao.stream/ok\n671\t                               :dao.stream/handle (counting-handle calls)})})\n672\t        machine' (:machine restored)\n673\t        store (:store machine')\n674\t        closure (get store 'closure)]\n675\t    (is (= :ok (:status frozen)))\n676\t    (is (= :ok (:status restored)) (pr-str restored))\n677\t    (is (= 1 @attachments))\n678\t    (is (zero? @calls) \"no read, mint, append or close during reconstruction\")\n679\t    (is (= (get store 'first-c) (get store 'alias-c)))\n680\t    (is (not= (get store 'first-c) (get store 'distinct-c)))\n681\t    (is (engine/authentic-ref? machine' :cursor-ref (get store 'first-c)))\n682\t    (is (values/closure? closure))\n683\t    (is (values/owned-by? closure (:owner machine')))\n684\t    (is (not (values/owned-by? closure (:owner source))))\n685\t    (is (= (vec (:body-bytes frozen))\n686\t           (vec (:bytes (export/encode machine' (:record restored))))))))\n687\t\n688\t\n689\t(deftest halted-module-closure-is-a-recovery-root-test\n690\t  (let [request (ring 32)\n691\t        response (ring 32)\n692\t        blocked (vm/run (load-ast (new-machine {:link-request request :link-response response})\n693\t                                  (then (app (v 'require) (lit 'host.mod)) (v 'host.mod/f))))\n694\t        _ (stream/append! response\n695\t                          (assoc (module-response)\n696\t                                 :image {:value (semantic-vector (def! 'f (lam [] (lit 42))))}\n697\t                                 :yin.link/id (:link-id (first (:wait-set blocked)))))\n698\t        source (vm/run blocked)\n699\t        {:keys [machine record]} (export/enter source)\n700\t        {:keys [serve!]} (served-table)\n701\t        prepared (export/prepare machine record serve! nil)\n702\t        frozen (export/freeze machine (:record prepared))\n703\t        calls (atom 0)\n704\t        restored (export/rehydrate-fenced\n705\t                   (new-machine {:origin :fresh :capability-secret \"fresh-secret\"})\n706\t                   (:bytes frozen)\n707\t                   {:address (:address frozen)\n708\t                    :attach (fn [_]\n709\t                              {:dao.stream/outcome :dao.stream/ok\n710\t                               :dao.stream/handle (counting-handle calls)})})]\n711\t    (is (values/closure? (:value source)))\n712\t    (is (= :ok (:status frozen)) (pr-str frozen))\n713\t    (is (= :ok (:status restored)) (pr-str restored))\n714\t    (is (values/closure? (:value (:machine restored))))\n715\t    (is (= :exporting (vm/gate-mode (:machine restored))))\n716\t    (is (zero? @calls))\n717\t    (is (= (vec (:body-bytes frozen))\n718\t           (vec (:bytes (export/encode (:machine restored) (:record restored))))))))\n719\t\n720\t\n721\t(deftest module-store-dependencies-are-censused-to-a-fixed-point-test\n722\t  (let [request (ring 32)\n723\t        response (ring 32)\n724\t        root (new-machine {:link-request request :link-response response})\n725\t        first-wait (vm/run (load-ast root\n726\t                                     (then (app (v 'require) (lit 'host.mod))\n727\t                                           (then (app (v 'require) (lit 'other.mod))\n728\t                                                 (v 'host.mod/f)))))\n729\t        _ (stream/append! response\n730\t                          (assoc (module-response)\n731\t                                 :image {:value (semantic-vector (def! 'f (lam [] (lit 42))))}\n732\t                                 :yin.link/id (:link-id (first (:wait-set first-wait)))))\n733\t        second-wait (vm/run first-wait)\n734\t        _ (stream/append! response\n735\t                          (assoc (module-response)\n736\t                                 :manifest {:yin.module/name 'other.mod :yin.module/exports #{'g}}\n737\t                                 :image {:value (semantic-vector (def! 'g (lam [] (lit 7))))}\n738\t                                 :yin.link/id (:link-id (first (:wait-set second-wait)))))\n739\t        halted (vm/run second-wait)\n740\t        other-id (first (keep (fn [[identity store]] (when (contains? store 'g) identity))\n741\t                              (:module-stores halted)))\n742\t        host-id (first (keep (fn [[identity store]] (when (contains? store 'f) identity))\n743\t                             (:module-stores halted)))\n744\t        other (get-in halted [:module-stores other-id 'g])\n745\t        source (assoc-in halted [:module-stores host-id 'dependency] other)\n746\t        {:keys [machine record]} (export/enter source)\n747\t        {:keys [serve!]} (served-table)\n748\t        prepared (export/prepare machine record serve!\n749\t                                 {:yin.k/arbitration {} :yin.k/next-op-seq 0 :yin.k/enrolled #{}\n750\t                                  :yin.k/origin {:yin.k/occurrence \"00000000-0000-0000-0000-000000000001\"\n751\t                                                 :dao.lease/lease \"lease\" :yin.k/emitter \"holder\"}})\n752\t        encoded (export/encode machine (:record prepared))]\n753\t    (is (values/closure? other) (pr-str (:module-stores halted)))\n754\t    (is (= :ok (:status prepared)) (pr-str prepared))\n755\t    (is (= #{host-id other-id} (set (keys (get-in encoded [:body :yin.k/module-stores])))))\n756\t    (let [old-body (update (:body encoded) :yin.k/module-stores dissoc other-id)\n757\t          old-address (content-address (cbor/encode old-body))]\n758\t      (is (= :segment/blake3-2500853acb568f9a6b944c3bdefe4fdcd59a9799b0ce5c75b77ad5ccf2a00188 old-address))\n759\t      (is (= :segment/blake3-382606673b257f528b9cf233cf05e00af66cdbb073940f7c14bb98a97e945590 (:address encoded)))\n760\t      (is (not= old-address (:address encoded))))\n761\t    (let [legacy (export/prepare machine record serve! nil)\n762\t          published (export/encode machine (:record legacy))\n763\t          frozen (export/freeze machine (:record legacy))\n764\t          restored (when (= :ok (:status frozen))\n765\t                     (export/rehydrate-fenced (new-machine) (:bytes frozen)\n766\t                                              {:address (:address frozen)\n767\t                                               :attach (constantly nil)}))\n768\t          reproduced (when (= :ok (:status restored))\n769\t                       (export/encode (:machine restored) (:record restored)))]\n770\t      (is (= :ok (:status frozen)) (pr-str frozen))\n771\t      (is (= :ok (:status restored)) (pr-str restored))\n772\t      (is (= #{host-id other-id} (set (keys (:module-stores (:machine restored))))))\n773\t      (is (= (vec (:bytes published)) (vec (:bytes reproduced)))\n774\t          \"complete recovery must not alter the published version-0 bytes\"))))\n775\t\n776\t\n777\t(deftest closure-in-blocked-environment-survives-fenced-recovery-test\n778\t  (let [source (vm/run (load-ast (new-machine)\n779\t                                 (let1 'f (lam [] (lit 42))\n780\t                                       (let1 'input (make-stream-ast)\n781\t                                             (then (next-of (cursor-of (v 'input)))\n782\t                                                   (app (v 'f)))))))\n783\t        source-closure (get-in source [:wait-set 0 :env 'f])\n784\t        {:keys [machine record]} (export/enter source)\n785\t        {:keys [serve!]} (served-table)\n786\t        prepared (export/prepare machine record serve! nil)\n787\t        frozen (export/freeze machine (:record prepared))\n788\t        calls (atom 0)\n789\t        restored (export/rehydrate-fenced\n790\t                   (new-machine {:origin :fresh :capability-secret \"fresh-secret\"}) (:bytes frozen)\n791\t                   {:address (:address frozen)\n792\t                    :attach (fn [_descriptor]\n793\t                              {:dao.stream/outcome :dao.stream/ok\n794\t                               :dao.stream/handle (counting-handle calls)})})\n795\t        closure (get-in restored [:record :wait-set 0 :env 'f])]\n796\t    (is (values/closure? source-closure) (pr-str (:wait-set source)))\n797\t    (is (= :ok (:status restored)) (pr-str restored))\n798\t    (is (values/closure? closure))\n799\t    (is (values/owned-by? closure (:owner (:machine restored))))\n800\t    (is (not (values/owned-by? closure (:owner source))))\n801\t    (is (zero? @calls))\n802\t    (is (= :exporting (vm/gate-mode (:machine restored))))\n803\t    (is (empty? (:wait-set (:machine restored))))\n804\t    (is (= (vec (:body-bytes frozen))\n805\t           (vec (:bytes (export/encode (:machine restored) (:record restored))))))))\n806\t\n807\t\n808\t(deftest version-one-recovery-retains-operation-ids-issues-and-local-enrollment-test\n809\t  (let [sink (ring 1)\n810\t        [reference base] (engine/attach-resource (new-machine) sink)\n811\t        source (vm/run (load-ast (assoc base :store {'sink reference} :yin.k/gate :running)\n812\t                                 {:type :stream/put :target (v 'sink) :val (lit 42)}))\n813\t        occurrence \"00000000-0000-0000-0000-000000000001\"\n814\t        op-id {:yin.k/occurrence \"00000000-0000-0000-0000-000000000002\" :yin.k/seq 0}\n815\t        source (-> source\n816\t                   (assoc :yin.k/issued 10)\n817\t                   (assoc-in [:wait-set 0 :yin.k/issue] 9)\n818\t                   (assoc-in [:wait-set 0 :op-id] op-id))\n819\t        {:keys [machine record]} (export/enter source)\n820\t        {:keys [serve!]} (served-table)\n821\t        header {:yin.k/occurrence occurrence :yin.k/arbitration\n822\t                {:dao.stream/identity \"arb\" :dao.stream/descriptor {}}\n823\t                :yin.k/next-op-seq 1 :yin.k/enrolled #{\"s0\"}\n824\t                :yin.k/origin {:yin.k/occurrence \"00000000-0000-0000-0000-000000000002\"\n825\t                               :dao.lease/lease \"lease\" :yin.k/emitter \"holder\"}}\n826\t        prepared (export/prepare machine record serve! header)\n827\t        frozen (export/freeze machine (:record prepared))\n828\t        calls (atom 0)\n829\t        restored (export/rehydrate-fenced\n830\t                   (new-machine) (:bytes frozen)\n831\t                   {:address (:address frozen)\n832\t                    :attach (fn [_]\n833\t                              {:dao.stream/outcome :dao.stream/ok\n834\t                               :dao.stream/handle (counting-handle calls)})})\n835\t        encoded (when (= :ok (:status restored))\n836\t                  (export/encode (:machine restored) (:record restored)))]\n837\t    (is (= :ok (:status prepared)) (pr-str prepared))\n838\t    (is (= :ok (:status restored)) (pr-str restored))\n839\t    (is (= op-id (get-in restored [:record :wait-set 0 :op-id])))\n840\t    (is (= 9 (get-in restored [:record :wait-set 0 :yin.k/issue])))\n841\t    (is (= 10 (get-in restored [:machine :yin.k/issued])))\n842\t    (is (= #{\"s0\"} (get-in restored [:record :header :yin.k/enrolled])))\n843\t    (is (not (contains? (:body encoded) :yin.k/enrolled)))\n844\t    (is (nil? (get-in restored [:machine :yin.k/custody])))\n845\t    (is (zero? @calls))\n846\t    (is (= (vec (:body-bytes frozen)) (vec (:bytes encoded))))))\n847\t\n848\t\n849\t(deftest rehydrating-an-install-child-does-not-repeat-initialization-or-io-test\n850\t  (let [initializations (atom 0)\n851\t        request (ring 64)\n852\t        response (ring 64)\n853\t        make-stream (fn [capacity]\n854\t                      (swap! initializations inc)\n855\t                      (make-ring-stream capacity))\n856\t        blocked (vm/run (load-ast (new-machine {:make-stream make-stream\n857\t                                                :link-request request :link-response response})\n858\t                                  (then (app (v 'require) (lit 'host.mod)) (app (v 'host.mod/f)))))\n859\t        _ (stream/append! response (assoc (module-response)\n860\t                                          :yin.link/id (:link-id (first (:wait-set blocked)))))\n861\t        source (vm/run blocked)\n862\t        receiver (new-machine {:make-stream make-stream})\n863\t        carried @initializations\n864\t        {:keys [machine record]} (export/enter source)\n865\t        {:keys [serve!]} (served-table)\n866\t        prepared (export/prepare machine record serve! nil)\n867\t        frozen (export/freeze machine (:record prepared))\n868\t        calls (atom 0)\n869\t        restored (export/rehydrate-fenced\n870\t                   receiver (:bytes frozen)\n871\t                   {:address (:address frozen)\n872\t                    :attach (fn [_]\n873\t                              {:dao.stream/outcome :dao.stream/ok\n874\t                               :dao.stream/handle (counting-handle calls)})})]\n875\t    (is (pos? carried))\n876\t    (is (= :ok (:status restored)) (pr-str restored))\n877\t    (is (= carried @initializations))\n878\t    (is (zero? @calls))\n879\t    (is (= :exporting (vm/gate-mode (get-in restored [:machine :installs 'host.mod :vm]))))\n880\t    (is (empty? (get-in restored [:machine :installs 'host.mod :vm :wait-set])))\n881\t    (is (= 1 (count (get-in restored [:record :children 'host.mod :wait-set]))))))\n882\t\n883\t\n884\t(deftest recovery-retains-a-blocked-ffi-request-and-its-response-route-test\n885\t  (let [inbound (reify stream/IDaoStreamWriter\n886\t                  (append! [_ _] {:dao.stream/outcome :dao.stream/full}))\n887\t        outbound (ring 8)\n888\t        source (vm/run (load-ast\n889\t                         (new-machine {:call-in inbound :call-out outbound\n890\t                                       :call-out-cursor (vm/mint-oldest outbound :test)})\n891\t                         {:type :dao.stream.apply/call :op :op/echo :operands [(lit \"hello\")]}))\n892\t        _ (is (true? (:request-sent (first (:wait-set source)))) (pr-str (:wait-set source)))\n893\t        {:keys [machine record]} (export/enter source)\n894\t        {:keys [serve!]} (served-table)\n895\t        prepared (export/prepare machine record serve! nil)\n896\t        frozen (export/freeze machine (:record prepared))\n897\t        calls (atom 0)\n898\t        restored (export/rehydrate-fenced\n899\t                   (new-machine) (:bytes frozen)\n900\t                   {:address (:address frozen)\n901\t                    :attach (fn [_]\n902\t                              {:dao.stream/outcome :dao.stream/ok\n903\t                               :dao.stream/handle (counting-handle calls)})})]\n904\t    (is (= :ok (:status prepared)) (pr-str prepared))\n905\t    (is (= :ffi-request (get-in (export/encode machine (:record prepared))\n906\t                                [:body :yin.k/frames 0 :yin.k/pending :yin.k/reason])))\n907\t    (is (= :ok (:status restored)) (pr-str restored))\n908\t    (is (= (get-in record [:wait-set 0 :call-id])\n909\t           (get-in restored [:record :wait-set 0 :call-id])))\n910\t    (is (= (get-in record [:wait-set 0 :datom])\n911\t           (get-in restored [:record :wait-set 0 :datom])))\n912\t    (is (zero? @calls))))\n913\t"}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"3ae7ab30-e404-4cb5-8bd7-1a56ea27e26e","timestamp":"2026-10-13T10:08:43.086Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/export_test.cljc","content":"(ns yin.vm.ucf.holder.export-test\n  \"D8: the exporting state, the prepare/encode split and the abort rule\n   (UCF 7.7.4; r3 1.8 and 1.9).  Every machine is parked by the real\n   engine; counting handles show what the gate and the encode touch.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.stream :as stream]\n            [dao.stream.cbor :as legacy-cbor]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.linearize :as linearize]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.ucf.holder.export :as export]))\n\n\n(declare parked-machine parked-explicit parked-installer served-table new-machine)\n\n\n(defn- content-address\n  [bytes]\n  (keyword \"segment\"\n           (str (get-in jing/registry [jing/default-hash-algorithm :address-id])\n                \"-\" (jing/digest-bytes jing/default-hash-algorithm bytes))))\n\n\n(deftest recovery-validation-precedes-attachment-test\n  (let [{:keys [machine record]} (export/enter (parked-machine))\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare machine record serve! nil)\n        frozen (export/freeze machine (:record prepared))\n        recovery (cbor/decode (:bytes frozen))\n        changed-snapshot (legacy-cbor/encode\n                           (update (legacy-cbor/decode (jing/base64->bytes (:yin.k/snapshot-bytes recovery)))\n                                   :yin.k/id-counter inc))\n        other-entered (export/enter (parked-explicit))\n        other-prepared (export/prepare (:machine other-entered) (:record other-entered) serve! nil)\n        other-recovery (cbor/decode (:bytes (export/freeze (:machine other-entered) (:record other-prepared))))\n        attachments (atom 0)]\n    (doseq [invalid [(assoc recovery :yin.k/version 2)\n                     (assoc recovery :yin.k/header {:yin.k/enrolled #{}})\n                     (assoc recovery :yin.k/descriptors #{})\n                     (assoc-in recovery [:yin.k/state :issues] [])\n                     (assoc recovery :yin.k/snapshot-bytes (jing/bytes->base64 changed-snapshot)\n                            :yin.k/snapshot-address (content-address changed-snapshot))\n                     (merge recovery (select-keys other-recovery [:yin.k/snapshot-bytes :yin.k/snapshot-address]))]]\n      (let [bytes (cbor/encode invalid)\n            restored (export/rehydrate-fenced (new-machine) bytes\n                                              {:address (content-address bytes)\n                                               :attach (fn [_] (swap! attachments inc) nil)})]\n        (is (not= :ok (:status restored)))\n        (is (nil? (:machine restored)))\n        (is (zero? @attachments))))))\n\n\n(deftest complete-export-recovery-is-fenced-and-reproducible-test\n  (doseq [source [(parked-machine) (parked-explicit) (parked-installer)]]\n    (let [{machine :machine record :record} (export/enter source)\n          {:keys [serve! table]} (served-table)\n          prepared (export/prepare machine record serve! nil)\n          frozen (export/freeze machine (:record prepared))\n          by-identity (into {} (map (fn [[handle descriptor]]\n                                      [(:dao.stream/identity descriptor) handle])) @table)\n          restored (export/rehydrate-fenced (new-machine) (:bytes frozen)\n                                            {:address (:address frozen)\n                                             :attach (fn [descriptor]\n                                                       {:dao.stream/outcome :dao.stream/ok\n                                                        :dao.stream/handle\n                                                        (by-identity (:dao.stream/identity descriptor))})})\n          encoded (when (= :ok (:status restored))\n                    (export/encode (:machine restored) (:record restored)))]\n      (is (= :ok (:status frozen)) (pr-str frozen))\n      (is (= :ok (:status restored)) (pr-str restored))\n      (is (= :exporting (vm/gate-mode (:machine restored))))\n      (is (empty? (:wait-set (:machine restored))))\n      (is (= (count (:wait-set record)) (count (get-in restored [:record :wait-set]))))\n      (is (= :yin.k/refused\n             (:yin.k/status (export/abort (:machine restored) (:record restored) [] nil))))\n      (is (= (vec (:body-bytes frozen)) (vec (:bytes encoded)))))))\n\n\n(deftest recovery-restores-fresh-name-state-without-receiver-contamination-test\n  (let [source (assoc (parked-machine) :origins 42 :id-counter 88 :yin.k/issued 77)\n        {:keys [machine record]} (export/enter source)\n        {:keys [serve! table]} (served-table)\n        prepared (export/prepare machine record serve! nil)\n        frozen (export/freeze machine (:record prepared))\n        by-identity (into {} (map (fn [[handle descriptor]]\n                                    [(:dao.stream/identity descriptor) handle])) @table)\n        restored (export/rehydrate-fenced\n                   (assoc (new-machine) :origins 99 :id-counter 100\n                          :store {'receiver-local :wrong} :yin.k/issued 33\n                          :yin.k/closes [{:receiver-local true}])\n                   (:bytes frozen)\n                   {:address (:address frozen)\n                    :attach (fn [descriptor]\n                              {:dao.stream/outcome :dao.stream/ok\n                               :dao.stream/handle (by-identity (:dao.stream/identity descriptor))})})]\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= 42 (:origins (:machine restored))))\n    (is (= 88 (:id-counter (:machine restored))))\n    (is (= 77 (:yin.k/issued (:machine restored))))\n    (is (not (contains? (:store (:machine restored)) 'receiver-local)))\n    (is (empty? (:yin.k/closes (:machine restored))))))\n\n\n;; =============================================================================\n;; Machines\n;; =============================================================================\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n\n\n(defn- ring\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn- make-ring-stream\n  [capacity]\n  (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                       ringbuffer/capacity-key capacity}))\n\n\n(def ^:private semantic-vector\n  (comp :vector linearize/lower-rows vm/ast->semantic-bytecode))\n\n\n(defn- load-ast\n  [machine ast]\n  (semantic/load-vector machine (semantic-vector ast)\n                        vm/semantic-contract))\n\n\n(defn- new-machine\n  ([] (new-machine {}))\n  ([opts]\n   (semantic/create-vm\n     (merge {:make-stream make-ring-stream\n             :capability-secret tu/secret\n             :modules (module/default-registry)\n             :secret-source (fn [origin]\n                              (str tu/secret \"/\" (name origin)))}\n            opts))))\n\n\n(defn- lit\n  [x]\n  {:type :literal, :value x})\n\n\n(defn- v\n  [n]\n  {:type :variable, :name n})\n\n\n(defn- lam\n  [params body]\n  {:type :lambda, :params params, :body body})\n\n\n(defn- app\n  [f & args]\n  {:type :application, :operator f, :operands (vec args)})\n\n\n(defn- then\n  [a b]\n  (app (lam ['_] b) a))\n\n\n(defn- let1\n  [param init body]\n  (app (lam [param] body) init))\n\n\n(defn- def!\n  [k val]\n  (app (v 'yin/def) (lit k) val))\n\n\n(defn- make-stream-ast\n  []\n  {:type :stream/make, :buffer 4})\n\n\n(defn- cursor-of\n  [source]\n  {:type :stream/cursor, :source source})\n\n\n(defn- next-of\n  [source]\n  {:type :stream/next, :source source})\n\n\n(defn- two-streams\n  \"Parks on a read of the first stream; the store also holds the second\n   stream and a cursor on each, so the lift reaches two streams.\"\n  []\n  (let1 'a (make-stream-ast)\n        (let1 'b (make-stream-ast)\n              (then (def! 'held-a (cursor-of (v 'a)))\n                    (then (def! 'held-b (cursor-of (v 'b)))\n                          (next-of (v 'held-a)))))))\n\n\n(defn- parked-machine\n  []\n  (vm/run (load-ast (new-machine) (two-streams))))\n\n\n(defn- module-response\n  []\n  {:status :ok,\n   :image {:value (semantic-vector\n                    (let1 's (make-stream-ast)\n                          (then (next-of (cursor-of (v 's)))\n                                (def! 'f (lam [] (lit 42))))))},\n   :manifest {:yin.module/name 'host.mod,\n              :yin.module/exports #{'f}},\n   :obligations []})\n\n\n(defn- parked-installer\n  \"A real machine parked at :install with a live child blocked on its\n   own read.\"\n  []\n  (let [request (ring 64)\n        response (ring 64)\n        m0 (vm/run (load-ast (new-machine {:link-request request\n                                           :link-response response})\n                             (then (app (v 'require) (lit 'host.mod))\n                                   (app (v 'host.mod/f)))))\n        entry (first (:wait-set m0))\n        _ (stream/append! response\n                          (assoc (module-response)\n                                 :yin.link/id (:link-id entry)))]\n    (vm/run m0)))\n\n\n(defn- served-table\n  \"A `serve!` that counts its calls and answers one stable identity per\n   handle.\"\n  []\n  (let [calls (atom 0)\n        table (atom {})]\n    {:calls calls\n     :table table\n     :serve! (fn [h]\n               (swap! calls inc)\n               (or (get @table h)\n                   (let [served {:dao.stream/identity (str \"s\" (count @table))\n                                 :dao.stream/channel {:dao.stream/type\n                                                      :test/channel}}]\n                     (swap! table assoc h served)\n                     served)))}))\n\n\n;; =============================================================================\n;; Gated machines over counting handles\n;; =============================================================================\n\n(defn- counting-handle\n  [calls]\n  (reify\n    stream/IDaoStreamReader\n\n    (cursor\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor ::at})\n\n    (next\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/blocked})\n\n\n    stream/IDaoStreamWriter\n\n    (append!\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok})\n\n\n    stream/IDaoStreamClosable\n\n    (close!\n      [_]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok})))\n\n\n(def ^:private park-entry-fns\n  {:stream/put (fn [_s _e r] {:reason :put, :stream-id (:stream-id r)}),\n   :stream/next (fn [_s _e r]\n                  {:reason :next,\n                   :cursor-ref (:cursor-ref r),\n                   :stream-id (:stream-id r)})})\n\n\n(def ^:private opts {:park-entry-fns park-entry-fns})\n\n\n(defn- gated\n  \"[state stream-ref cursor-ref calls] under the :running gate.\"\n  []\n  (let [calls (atom 0)\n        [sref s0] (engine/attach-resource\n                    (vm/empty-state {:make-stream tu/make-stream,\n                                     :capability-secret tu/secret})\n                    (counting-handle calls))\n        [cref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)]\n    (reset! calls 0)\n    [(assoc s1 :yin.k/gate :running) sref cref calls]))\n\n\n(defn- run-effect\n  [state kind m]\n  (:state (engine/handle-effect state (module/make-effect kind m) opts)))\n\n\n(defn- hold\n  \"The one-slot reason string for the kind of hold `m` has.\"\n  [outcome]\n  (:yin.k/hold outcome))\n\n\n;; =============================================================================\n;; Entering exporting\n;; =============================================================================\n\n(deftest enter-moves-waits-and-fences-the-machine-test\n  (let [[s sref _ _] (gated)\n        s (run-effect s :stream/put {:stream sref, :val 1})\n        waits (:wait-set s)\n        r (export/enter s)]\n    (is (= :ok (:status r)) (pr-str r))\n    (is (= :exporting (vm/gate-mode (:machine r))))\n    (is (empty? (:wait-set (:machine r))) \"nothing left to poll\")\n    (is (= waits (get-in r [:record :wait-set])) \"waits kept in order\")\n    (is (= :running (get-in r [:record :gate])))\n    (testing \"an exporting machine cannot enter again\"\n      (is (= :yin.k/refused (:yin.k/status (export/enter (:machine r))))))))\n\n\n(deftest exporting-appends-nothing-test\n  (let [[s sref _ calls] (gated)\n        s (run-effect s :stream/put {:stream sref, :val 1})\n        child-calls (atom 0)\n        child (vm/run (load-ast (new-machine\n                                  {:make-stream\n                                   (fn [capacity]\n                                     (let [r (make-ring-stream capacity)]\n                                       (assoc r\n                                              :dao.stream/handle\n                                              (counting-handle child-calls))))})\n                                (next-of (cursor-of (make-stream-ast)))))\n        s (assoc s :installs {'foo {:phase :running\n                                    :vm child\n                                    :parent [:t0 0]\n                                    :response {}}})\n        _ (reset! child-calls 0)\n        {m :machine} (export/enter s)\n        stamped (assoc s :parked {:parked-0 {:type :parked-continuation\n                                             :id :parked-0}})]\n    (testing \"polling the source\"\n      (engine/check-wait-set m)\n      (is (zero? @calls)))\n    (testing \"ticking its install child\"\n      (let [swept (engine/check-wait-set m)]\n        (is (zero? @child-calls))\n        (is (= child (get-in swept [:installs 'foo :vm])))))\n    (testing \"a direct resume\"\n      (let [restored (atom 0)]\n        (is (throws? #(engine/resume-continuation\n                        (assoc m :parked (:parked stamped))\n                        :parked-0 1\n                        (fn [st _ _] (swap! restored inc) st))))\n        (is (zero? @restored))\n        (is (zero? @calls))))))\n\n\n(deftest a-non-empty-ready-queue-is-not-quiescent-test\n  (let [[s _ _ _] (gated)\n        r (export/enter (assoc s :ready-queue [{:id 1}]))]\n    (is (= :yin.k/not-quiescent (:yin.k/status r)))\n    (testing \"a child's queue too\"\n      (let [r (export/enter\n                (assoc s :installs {'foo {:vm (assoc (vm/empty-state {})\n                                                     :ready-queue [{:id 1}])}}))]\n        (is (= :yin.k/not-quiescent (:yin.k/status r)))))))\n\n\n(defn- refused-as\n  [kind r]\n  (and (= :yin.k/non-portable (:yin.k/status r))\n       (= :reason-mismatch (:yin.k/kind r))\n       (= kind (hold r))))\n\n\n(deftest each-export-refusal-fires-on-a-real-parked-machine-test\n  (let [[s sref cref calls] (gated)]\n    (testing \"an :observe entry\"\n      (let [m (run-effect s :stream/poll {:cursor cref})]\n        (is (= :observe (:reason (first (:wait-set m)))))\n        (is (refused-as :observe (export/enter m)))))\n    (testing \"an entry carrying :yin.k/held\"\n      (let [m (run-effect s :stream/next {:cursor cref})\n            m (assoc-in m [:wait-set 0 :yin.k/held] {:state :observed})]\n        (is (refused-as :held (export/enter m)))))\n    (testing \"an unminted cursor cell\"\n      (let [m (run-effect s :stream/cursor {:stream sref})]\n        (is (refused-as :unminted-cursor (export/enter m)))))\n    (testing \"a pending close\"\n      (let [m (run-effect s :stream/close {:stream sref})]\n        (is (seq (:yin.k/closes m)))\n        (is (refused-as :pending-close (export/enter m)))))\n    (testing \"a link request with no response cursor\"\n      (let [m (vm/run (assoc (load-ast (new-machine {:link-request (ring 8)\n                                                     :link-response (ring 8)})\n                                       (app (v 'require) (lit 'foo)))\n                             :yin.k/gate :running))\n            entry (first (:wait-set m))]\n        (is (= :link-request (:reason entry)))\n        (is (not (contains? entry :cursor)))\n        (is (refused-as :link-cursor-not-installed (export/enter m)))))\n    (testing \"a refusal in an install child names its path\"\n      (let [child (run-effect s :stream/close {:stream sref})\n            m (assoc (vm/empty-state {})\n                     :installs {'foo {:vm child}})\n            r (export/enter m)]\n        (is (refused-as :pending-close r))\n        (is (= ['foo] (:yin.k/path r)))))\n    (testing \"a refusal leaves the machine as it was\"\n      (is (zero? @calls)))))\n\n\n;; =============================================================================\n;; Prepare, then encode\n;; =============================================================================\n\n(deftest prepare-serves-once-per-stream-and-encode-serves-nothing-test\n  (let [m (parked-machine)\n        {:keys [calls table serve!]} (served-table)\n        {m' :machine record :record} (export/enter m)\n        prepared (export/prepare m' record serve! nil)\n        record' (:record prepared)\n        after-prepare @calls\n        e1 (export/encode m' record')\n        e2 (export/encode m' record')]\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (= 2 (count @table)) \"two streams reached\")\n    (is (= (count @table) after-prepare) \"serve! once per stream\")\n    (is (= (count @table) (count (:served record'))))\n    (is (= after-prepare @calls) \"encode calls nothing\")\n    (is (= :ok (:status e1)) (pr-str e1))\n    (is (= (vec (:bytes e1)) (vec (:bytes e2))) \"deterministic bytes\")\n    (is (= (:address e1) (:address e2)))\n    (testing \"preparing a prepared record again serves nothing new\"\n      (export/prepare m' record' serve! nil)\n      (is (= after-prepare @calls)))\n    (testing \"an unprepared record is a defect, not a refusal\"\n      (is (throws? #(export/encode m' record))))))\n\n\n(deftest prepare-reaches-install-children-once-test\n  (let [m (parked-installer)\n        {:keys [calls table serve!]} (served-table)\n        {m' :machine record :record} (export/enter m)\n        prepared (export/prepare m' record serve! nil)]\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (pos? @calls))\n    (is (= @calls (count @table)) \"each stream, child's included, once\")\n    (let [n @calls]\n      (is (= :ok (:status (export/encode m' (:record prepared)))))\n      (is (= n @calls)))))\n\n\n;; =============================================================================\n;; Abort\n;; =============================================================================\n\n(defn- exporting\n  [machine]\n  (let [r (export/enter machine)]\n    [(:machine r) (:record r) machine]))\n\n\n(deftest abort-with-no-persisted-intent-restores-the-machine-test\n  (let [[m record original] (exporting (parked-machine))\n        r (export/abort m record [] nil)]\n    (is (= :ok (:status r)))\n    (is (= original (:machine r)) \"the old local machine, as it was\")))\n\n\n(deftest abort-restores-the-prior-gate-test\n  (let [[s sref _ _] (gated)\n        s (run-effect s :stream/put {:stream sref, :val 1})\n        [m record _] (exporting s)]\n    (is (= s (:machine (export/abort m record [] nil))))))\n\n\n(deftest abort-after-provably-not-appended-attempts-test\n  (let [[m record original] (exporting (parked-machine))]\n    (doseq [outcome [:dao.stream/full :dao.stream/invalid-value\n                     :dao.stream/closed :dao.stream/refused]]\n      (is (= original\n             (:machine (export/abort m record\n                                     [{:append outcome} {:append outcome}]\n                                     nil)))\n          (str outcome \" proves nothing was appended\")))))\n\n\n(deftest abort-is-refused-when-the-offer-may-have-been-accepted-test\n  (let [[m record _] (exporting (parked-machine))\n        refused? (fn [attempts]\n                   (let [r (export/abort m record attempts nil)]\n                     (and (= :yin.k/refused (:yin.k/status r))\n                          (= :offer-possibly-accepted (:yin.k/reason r)))))]\n    (testing \"an unknown append (intent persisted, no outcome)\"\n      (is (refused? [{}])))\n    (testing \"an unknown append among provable ones\"\n      (is (refused? [{:append :dao.stream/full} {}])))\n    (testing \"an accepted append\"\n      (is (refused? [{:append :dao.stream/ok}])))\n    (testing \"a transport error is unknown delivery\"\n      (is (refused? [{:append :dao.stream/transport-error}])))\n    (testing \"a refusal that followed an unknown append is no evidence\"\n      (is (refused? [{} {:append :dao.stream/full\n                         :reply :yin.k/refused}])))\n    (testing \"a refusal of one request is no evidence of the others\"\n      (is (refused? [{:append :dao.stream/ok :reply :yin.k/refused}])))\n    (testing \"the machine stays fenced\"\n      (is (= :exporting (vm/gate-mode m))))))\n\n\n(deftest a-holder-past-its-lease-bound-cannot-abort-test\n  (let [[s sref _ _] (gated)\n        s (-> (run-effect s :stream/put {:stream sref, :val 1})\n              (assoc :yin.k/custody {:yin.k/occurrence \"o\"}))\n        [m record original] (exporting s)\n        abort (fn [tenure] (export/abort m record [] tenure))\n        reason (fn [r] [(:yin.k/status r) (:yin.k/reason r)])]\n    (testing \"current, ledger-confirmed tenure may abort\"\n      (is (= original (:machine (abort {:now 10 :bound 20 :live true})))))\n    (testing \"at the bound and past it, never\"\n      (doseq [t [{:now 20 :bound 20 :live true}\n                 {:now 21 :bound 20 :live true}\n                 {:now 21 :bound 20}]]\n        (is (= [:yin.k/refused :tenure-ended] (reason (abort t))))))\n    (testing \"inside the bound with no ledger evidence is unconfirmed\"\n      (doseq [t [{:now 10 :bound 20} {:now 10 :bound 20 :live false} nil]]\n        (is (= [:yin.k/refused :tenure-unconfirmed] (reason (abort t))))))\n    (testing \"tenure alone does not license an uncertain offer\"\n      (is (= :offer-possibly-accepted\n             (:yin.k/reason (export/abort m record [{}]\n                                          {:now 10 :bound 20 :live true})))))))\n\n\n(def ^:private served-answer\n  {:dao.stream/identity \"s0\"\n   :dao.stream/channel {:dao.stream/type :test/channel}})\n\n\n(deftest a-refused-prepare-keeps-what-it-served-test\n  (let [m (parked-machine)\n        {m' :machine record :record} (export/enter m)\n        first-handle (atom nil)\n        ;; serves the first stream it is asked about, refuses the rest\n        stingy (fn [h]\n                 (compare-and-set! first-handle nil h)\n                 (when (= h @first-handle) served-answer))\n        refused (export/prepare m' record stingy nil)]\n    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n    (is (= 1 (count (get-in refused [:record :served]))))\n    (testing \"a retry with the returned record never re-serves that stream\"\n      (let [asked (atom [])\n            {:keys [serve!]} (served-table)\n            retry (export/prepare m' (:record refused)\n                                  (fn [h]\n                                    (swap! asked conj h)\n                                    (serve! h))\n                                  nil)]\n        (is (= :ok (:status retry)) (pr-str retry))\n        (is (not-any? #(= @first-handle %) @asked))\n        (is (= 1 (count @asked)) \"only the other stream\")))))\n\n\n(defn- parked-explicit\n  \"A real machine at an explicit park, its record's environment holding\n   a cursor on a stream.\"\n  []\n  (vm/run (load-ast (new-machine)\n                    (let1 's (make-stream-ast)\n                          (app (lam ['c] {:type :vm/park})\n                               (cursor-of (v 's)))))))\n\n\n(deftest an-explicit-park-travels-in-the-record-test\n  (let [m (parked-explicit)\n        {m' :machine record :record} (export/enter m)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare m' record serve! nil)]\n    (is (seq (:parked m)) \"the source holds a parked record\")\n    (is (seq (:parked record)) \"the record holds it\")\n    (is (every? #(not (contains? (:parked m') %)) (keys (:parked record)))\n        \"the machine's :parked lacks it\")\n    (is (empty? (:wait-set m')))\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (let [e (export/encode m' (:record prepared))]\n      (is (= :ok (:status e)) (pr-str e))\n      (is (= :parked (:kind e))))\n    (is (= m (:machine (export/abort m' record [] nil)))\n        \"abort restores machine equality\")))\n\n\n(deftest an-install-childs-parked-records-stay-in-the-child-test\n  (let [m (parked-installer)\n        parked {:p0 {:type :parked-continuation :id :p0}}\n        m (assoc-in m [:installs 'host.mod :vm :parked] parked)\n        {m' :machine record :record :as r} (export/enter m)]\n    (is (= :ok (:status r)) (pr-str r))\n    (is (= parked (get-in m' [:installs 'host.mod :vm :parked]))\n        \"the child's parked records are not moved\")\n    (is (not-any? #(contains? (:parked record) %) (keys parked)))))\n\n\n(deftest abort-needs-an-exporting-machine-test\n  (let [[m record _] (exporting (parked-machine))\n        restored (:machine (export/abort m record [] nil))]\n    (is (= :yin.k/refused\n           (:yin.k/status (export/abort restored record [] nil))))))\n\n\n(deftest recovery-preserves-aliases-distinct-cells-and-authentic-closures-test\n  (let [source (vm/run\n                 (load-ast (new-machine)\n                           (let1 's (make-stream-ast)\n                                 (let1 'c (cursor-of (v 's))\n                                       (let1 'd (cursor-of (v 's))\n                                             (then (def! 'first-c (v 'c))\n                                                   (then (def! 'alias-c (v 'c))\n                                                         (then (def! 'distinct-c (v 'd))\n                                                               (then (def! 'closure (lam [] (next-of (v 'c))))\n                                                                     (next-of (v 'c)))))))))))\n        {:keys [machine record]} (export/enter source)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare machine record serve! nil)\n        frozen (export/freeze machine (:record prepared))\n        calls (atom 0)\n        attachments (atom 0)\n        restored (export/rehydrate-fenced\n                   (new-machine {:origin :fresh :capability-secret \"recovery-secret\"})\n                   (:bytes frozen)\n                   {:address (:address frozen)\n                    :attach (fn [_]\n                              (swap! attachments inc)\n                              {:dao.stream/outcome :dao.stream/ok\n                               :dao.stream/handle (counting-handle calls)})})\n        machine' (:machine restored)\n        store (:store machine')\n        closure (get store 'closure)]\n    (is (= :ok (:status frozen)))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= 1 @attachments))\n    (is (zero? @calls) \"no read, mint, append or close during reconstruction\")\n    (is (= (get store 'first-c) (get store 'alias-c)))\n    (is (not= (get store 'first-c) (get store 'distinct-c)))\n    (is (engine/authentic-ref? machine' :cursor-ref (get store 'first-c)))\n    (is (values/closure? closure))\n    (is (values/owned-by? closure (:owner machine')))\n    (is (not (values/owned-by? closure (:owner source))))\n    (is (= (vec (:body-bytes frozen))\n           (vec (:bytes (export/encode machine' (:record restored))))))))\n\n\n(deftest halted-module-closure-is-a-recovery-root-test\n  (let [request (ring 32)\n        response (ring 32)\n        blocked (vm/run (load-ast (new-machine {:link-request request :link-response response})\n                                  (then (app (v 'require) (lit 'host.mod)) (v 'host.mod/f))))\n        _ (stream/append! response\n                          (assoc (module-response)\n                                 :image {:value (semantic-vector (def! 'f (lam [] (lit 42))))}\n                                 :yin.link/id (:link-id (first (:wait-set blocked)))))\n        source (vm/run blocked)\n        {:keys [machine record]} (export/enter source)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare machine record serve! nil)\n        frozen (export/freeze machine (:record prepared))\n        calls (atom 0)\n        restored (export/rehydrate-fenced\n                   (new-machine {:origin :fresh :capability-secret \"fresh-secret\"})\n                   (:bytes frozen)\n                   {:address (:address frozen)\n                    :attach (fn [_]\n                              {:dao.stream/outcome :dao.stream/ok\n                               :dao.stream/handle (counting-handle calls)})})]\n    (is (values/closure? (:value source)))\n    (is (= :ok (:status frozen)) (pr-str frozen))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (values/closure? (:value (:machine restored))))\n    (is (= :exporting (vm/gate-mode (:machine restored))))\n    (is (zero? @calls))\n    (is (= (vec (:body-bytes frozen))\n           (vec (:bytes (export/encode (:machine restored) (:record restored))))))))\n\n\n(deftest module-store-dependencies-are-censused-to-a-fixed-point-test\n  (let [request (ring 32)\n        response (ring 32)\n        root (new-machine {:link-request request :link-response response})\n        first-wait (vm/run (load-ast root\n                                     (then (app (v 'require) (lit 'host.mod))\n                                           (then (app (v 'require) (lit 'other.mod))\n                                                 (v 'host.mod/f)))))\n        _ (stream/append! response\n                          (assoc (module-response)\n                                 :image {:value (semantic-vector (def! 'f (lam [] (lit 42))))}\n                                 :yin.link/id (:link-id (first (:wait-set first-wait)))))\n        second-wait (vm/run first-wait)\n        _ (stream/append! response\n                          (assoc (module-response)\n                                 :manifest {:yin.module/name 'other.mod :yin.module/exports #{'g}}\n                                 :image {:value (semantic-vector (def! 'g (lam [] (lit 7))))}\n                                 :yin.link/id (:link-id (first (:wait-set second-wait)))))\n        halted (vm/run second-wait)\n        other-id (first (keep (fn [[identity store]] (when (contains? store 'g) identity))\n                              (:module-stores halted)))\n        host-id (first (keep (fn [[identity store]] (when (contains? store 'f) identity))\n                             (:module-stores halted)))\n        other (get-in halted [:module-stores other-id 'g])\n        source (assoc-in halted [:module-stores host-id 'dependency] other)\n        {:keys [machine record]} (export/enter source)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare machine record serve!\n                                 {:yin.k/arbitration {} :yin.k/next-op-seq 0 :yin.k/enrolled #{}\n                                  :yin.k/origin {:yin.k/occurrence \"00000000-0000-0000-0000-000000000001\"\n                                                 :dao.lease/lease \"lease\" :yin.k/emitter \"holder\"}})\n        encoded (export/encode machine (:record prepared))]\n    (is (values/closure? other) (pr-str (:module-stores halted)))\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (= #{host-id other-id} (set (keys (get-in encoded [:body :yin.k/module-stores])))))\n    (let [old-body (update (:body encoded) :yin.k/module-stores dissoc other-id)\n          old-address (content-address (cbor/encode old-body))]\n      (is (= :segment/blake3-2500853acb568f9a6b944c3bdefe4fdcd59a9799b0ce5c75b77ad5ccf2a00188 old-address))\n      (is (= :segment/blake3-382606673b257f528b9cf233cf05e00af66cdbb073940f7c14bb98a97e945590 (:address encoded)))\n      (is (not= old-address (:address encoded))))\n    (let [legacy (export/prepare machine record serve! nil)\n          published (export/encode machine (:record legacy))\n          frozen (export/freeze machine (:record legacy))\n          restored (when (= :ok (:status frozen))\n                     (export/rehydrate-fenced (new-machine) (:bytes frozen)\n                                              {:address (:address frozen)\n                                               :attach (constantly nil)}))\n          reproduced (when (= :ok (:status restored))\n                       (export/encode (:machine restored) (:record restored)))]\n      (is (= :ok (:status frozen)) (pr-str frozen))\n      (is (= :ok (:status restored)) (pr-str restored))\n      (is (= #{host-id other-id} (set (keys (:module-stores (:machine restored))))))\n      (is (= (vec (:bytes published)) (vec (:bytes reproduced)))\n          \"complete recovery must not alter the published version-0 bytes\"))))\n\n\n(deftest closure-in-blocked-environment-survives-fenced-recovery-test\n  (let [source (vm/run (load-ast (new-machine)\n                                 (let1 'f (lam [] (lit 42))\n                                       (let1 'input (make-stream-ast)\n                                             (then (next-of (cursor-of (v 'input)))\n                                                   (app (v 'f)))))))\n        source-closure (get-in source [:wait-set 0 :env 'f])\n        {:keys [machine record]} (export/enter source)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare machine record serve! nil)\n        frozen (export/freeze machine (:record prepared))\n        calls (atom 0)\n        restored (export/rehydrate-fenced\n                   (new-machine {:origin :fresh :capability-secret \"fresh-secret\"}) (:bytes frozen)\n                   {:address (:address frozen)\n                    :attach (fn [_descriptor]\n                              {:dao.stream/outcome :dao.stream/ok\n                               :dao.stream/handle (counting-handle calls)})})\n        closure (get-in restored [:record :wait-set 0 :env 'f])]\n    (is (values/closure? source-closure) (pr-str (:wait-set source)))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (values/closure? closure))\n    (is (values/owned-by? closure (:owner (:machine restored))))\n    (is (not (values/owned-by? closure (:owner source))))\n    (is (zero? @calls))\n    (is (= :exporting (vm/gate-mode (:machine restored))))\n    (is (empty? (:wait-set (:machine restored))))\n    (is (= (vec (:body-bytes frozen))\n           (vec (:bytes (export/encode (:machine restored) (:record restored))))))))\n\n\n(deftest version-one-recovery-retains-operation-ids-issues-and-local-enrollment-test\n  (let [sink (ring 1)\n        [reference base] (engine/attach-resource (new-machine) sink)\n        source (vm/run (load-ast (assoc base :store {'sink reference} :yin.k/gate :running)\n                                 {:type :stream/put :target (v 'sink) :val (lit 42)}))\n        occurrence \"00000000-0000-0000-0000-000000000001\"\n        op-id {:yin.k/occurrence \"00000000-0000-0000-0000-000000000002\" :yin.k/seq 0}\n        source (-> source\n                   (assoc :yin.k/issued 10)\n                   (assoc-in [:wait-set 0 :yin.k/issue] 9)\n                   (assoc-in [:wait-set 0 :op-id] op-id))\n        {:keys [machine record]} (export/enter source)\n        {:keys [serve!]} (served-table)\n        header {:yin.k/occurrence occurrence :yin.k/arbitration\n                {:dao.stream/identity \"arb\" :dao.stream/descriptor {}}\n                :yin.k/next-op-seq 1 :yin.k/enrolled #{\"s0\"}\n                :yin.k/origin {:yin.k/occurrence \"00000000-0000-0000-0000-000000000002\"\n                               :dao.lease/lease \"lease\" :yin.k/emitter \"holder\"}}\n        prepared (export/prepare machine record serve! header)\n        frozen (export/freeze machine (:record prepared))\n        calls (atom 0)\n        restored (export/rehydrate-fenced\n                   (new-machine) (:bytes frozen)\n                   {:address (:address frozen)\n                    :attach (fn [_]\n                              {:dao.stream/outcome :dao.stream/ok\n                               :dao.stream/handle (counting-handle calls)})})\n        encoded (when (= :ok (:status restored))\n                  (export/encode (:machine restored) (:record restored)))]\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= op-id (get-in restored [:record :wait-set 0 :op-id])))\n    (is (= 9 (get-in restored [:record :wait-set 0 :yin.k/issue])))\n    (is (= 10 (get-in restored [:machine :yin.k/issued])))\n    (is (= #{\"s0\"} (get-in restored [:record :header :yin.k/enrolled])))\n    (is (not (contains? (:body encoded) :yin.k/enrolled)))\n    (is (nil? (get-in restored [:machine :yin.k/custody])))\n    (is (zero? @calls))\n    (is (= (vec (:body-bytes frozen)) (vec (:bytes encoded))))))\n\n\n(deftest rehydrating-an-install-child-does-not-repeat-initialization-or-io-test\n  (let [initializations (atom 0)\n        request (ring 64)\n        response (ring 64)\n        make-stream (fn [capacity]\n                      (swap! ini