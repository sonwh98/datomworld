{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UuKapjv4wMhKLZjtVqrQc7","type":"tool_result","content":"100\t        (is (= :ok (:status ea)) (pr-str ea))\n101\t        (is (= (vec (:bytes ea)) (vec (:bytes eb)))\n102\t            \"map insertion order never reaches the bytes\")\n103\t        (is (= (:address ea) (:address eb)))\n104\t        (is (= (set (keys (:yin.k/code (:body ea))))\n105\t               (set (keys (:yin.k/code (:body eb))))))\n106\t        (is (= (:yin.k/cells (:body ea)) (:yin.k/cells (:body eb))))))))\n107\t\n108\t\n109\t(defn- observed\n110\t  \"Everything a program could see of stream `h`: the outcome and value\n111\t   at its first positions.  Equal before and after means no program IO\n112\t   appended to it.\"\n113\t  [h]\n114\t  (mapv #(select-keys (stream/next h %) [:dao.stream/outcome\n115\t                                         :dao.stream/value])\n116\t        (range 3)))\n117\t\n118\t\n119\t(defn- cells-of\n120\t  \"Each wait of `waits`, resolved through `machine`'s own resources: its\n121\t   reason, the stream handle it polls and the cell's position, plus the\n122\t   entry's keys but for the recovery's issue mark.\"\n123\t  [machine waits]\n124\t  (mapv (fn [e]\n125\t          [(:reason e)\n126\t           (get-in machine [:resources (:stream-id e)])\n127\t           (get-in machine [:resources (get-in e [:cursor-ref :id]) :cursor])\n128\t           (disj (set (keys e)) :yin.k/issue)])\n129\t        waits))\n130\t\n131\t\n132\t(defn- resolved\n133\t  \"`x` with every stream and cursor reference replaced by what it names\n134\t   in `machine`'s own resources -- the stream handle, the handle and the\n135\t   cell's position -- so records held under receiver-owned ids and seals\n136\t   compare by content.\"\n137\t  [machine x]\n138\t  (walk/postwalk\n139\t    (fn [n]\n140\t      (if (and (map? n) (contains? #{:stream-ref :cursor-ref} (:type n)))\n141\t        (let [r (get-in machine [:resources (:id n)])]\n142\t          (if (= :stream-ref (:type n))\n143\t            [:stream r]\n144\t            [:cursor (get-in machine [:resources (:stream-id r)]) (:cursor r)]))\n145\t        n))\n146\t    x))\n147\t\n148\t\n149\t(defn- sources\n150\t  \"The machines the recovery row freezes, by label: a reader parked on a\n151\t   wait (cells), and an explicit park whose record holds a cursor (a\n152\t   parked record).  Each answers [machine stream].\"\n153\t  [engine]\n154\t  [[\"reader\" (s/parked-reader engine)]\n155\t   [\"explicit park\" (let [m (s/parked-explicit engine)]\n156\t                      [m (get-in m [:resources (some (fn [[_ r]]\n157\t                                                       (:stream-id r))\n158\t                                                     (:resources m))])])]])\n159\t\n160\t\n161\t(def ^:private code-keys\n162\t  \"Where each profile holds its code: the semantic segment table, the\n163\t   walker's rows, the stack and register segment, layout and hash.\"\n164\t  [:code :code-aliases :rows :row-index :row-nodes :segment :images :hash])\n165\t\n166\t\n167\t(deftest a-poisoned-receiver-behaves-as-a-clean-one\n168\t  (doseq [engine s/engines]\n169\t    (testing (name engine)"}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"71d7e272-ed16-4f04-a9c8-536f1c54a79f","timestamp":"2026-10-13T10:24:50.178Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/handoff_v2_holder_test.cljc","content":"        (is (= :ok (:status ea)) (pr-str ea))\n        (is (= (vec (:bytes ea)) (vec (:bytes eb)))\n            \"map insertion order never reaches the bytes\")\n        (is (= (:address ea) (:address eb)))\n        (is (= (set (keys (:yin.k/code (:body ea))))\n               (set (keys (:yin.k/code (:body eb))))))\n        (is (= (:yin.k/cells (:body ea)) (:yin.k/cells (:body eb))))))))\n\n\n(defn- observed\n  \"Everything a program could see of stream `h`: the outcome and value\n   at its first positions.  Equal before and after means no program IO\n   appended to it.\"\n  [h]\n  (mapv #(select-keys (stream/next h %) [:dao.stream/outcome\n                                         :dao.stream/value])\n        (range 3)))\n\n\n(defn- cells-of\n  \"Each wait of `waits`, resolved through `machine`'s own resources: its\n   reason, the stream handle it polls and the cell's position, plus the\n   entry's keys but for the recovery's issue mark.\"\n  [machine waits]\n  (mapv (fn [e]\n          [(:reason e)\n           (get-in machine [:resources (:stream-id e)])\n           (get-in machine [:resources (get-in e [:cursor-ref :id]) :cursor])\n           (disj (set (keys e)) :yin.k/issue)])\n        waits))\n\n\n(defn- resolved\n  \"`x` with every stream and cursor reference replaced by what it names\n   in `machine`'s own resources -- the stream handle, the handle and the\n   cell's position -- so records held under receiver-owned ids and seals\n   compare by content.\"\n  [machine x]\n  (walk/postwalk\n    (fn [n]\n      (if (and (map? n) (contains? #{:stream-ref :cursor-ref} (:type n)))\n        (let [r (get-in machine [:resources (:id n)])]\n          (if (= :stream-ref (:type n))\n            [:stream r]\n            [:cursor (get-in machine [:resources (:stream-id r)]) (:cursor r)]))\n        n))\n    x))\n\n\n(defn- sources\n  \"The machines the recovery row freezes, by label: a reader parked on a\n   wait (cells), and an explicit park whose record holds a cursor (a\n   parked record).  Each answers [machine stream].\"\n  [engine]\n  [[\"reader\" (s/parked-reader engine)]\n   [\"explicit park\" (let [m (s/parked-explicit engine)]\n                      [m (get-in m [:resources (some (fn [[_ r]]\n                                                       (:stream-id r))\n                                                     (:resources m))])])]])\n\n\n(def ^:private code-keys\n  \"Where each profile holds its code: the semantic segment table, the\n   walker's rows, the stack and register segment, layout and hash.\"\n  [:code :code-aliases :rows :row-index :row-nodes :segment :images :hash])\n\n\n(deftest a-poisoned-receiver-behaves-as-a-clean-one\n  (doseq [engine s/engines]\n    (testing (name engine)","numLines":70,"startLine":100,"totalLines":271}},"tool_result_meta":[{"id":"toolu_01UuKapjv4wMhKLZjtVqrQc7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
