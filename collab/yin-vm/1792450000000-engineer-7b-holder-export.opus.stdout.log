{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019yRKZR52F7SYo4YPzMFX6Q","type":"tool_result","content":"1\t(ns yin.vm.ucf.rows-custody-test\n2\t  \"Phase 7a: custody on rows (phase-7 plan §3.1). The lift under a header\n3\t   writes the root's custody slot by kind and refuses :op-seq-exhausted,\n4\t   :unprotected-pending and an id on an unenrolled stream; the lower's\n5\t   custody stage runs the custody grammar, refuses a fork under\n6\t   :exclusive, runs the version-1 grant checks on a blocked or parked\n7\t   exclusive root, protection in both directions and op-id presence equal\n8\t   to enrollment, restores the counter exactly, lowers a halted exclusive\n9\t   root with no grant gated :ended, and every refusal comes before the\n10\t   first attach (zero attachments). The version-1 rules these re-pin are\n11\t   lift_v1_test's and handoff_v2_custody_test's, kept until phase 8.\"\n12\t  (:require [clojure.test :refer [deftest is testing]]\n13\t            [yin.vm :as vm]\n14\t            [yin.vm.ucf.rows :as rows]\n15\t            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n16\t            [yin.vm.ucf.rows-support :as s]))\n17\t\n18\t\n19\t(defn- custody-of\n20\t  [wire]\n21\t  (nth (:slots (rows/decode wire)) 16))\n22\t\n23\t\n24\t(defn- identities\n25\t  \"Every stream identity of the pack's tree.\"\n26\t  [wire]\n27\t  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n28\t\n29\t\n30\t;; =============================================================================\n31\t;; The lift under a header\n32\t;; =============================================================================\n33\t\n34\t(deftest the-lift-writes-the-custody-slot-by-kind\n35\t  (testing \"a first park: the exclusive policy, no origin\"\n36\t    (is (= {:yin.k/policy :yin.k/exclusive :yin.k/occurrence s/occurrence\n37\t            :yin.k/arbitration s/arbitration :yin.k/next-op-seq 0}\n38\t           (custody-of (s/lift (s/parked-reader) (s/header 0 nil #{}))))))\n39\t  (testing \"a successor carries its origin\"\n40\t    (is (= {:yin.k/policy :yin.k/exclusive :yin.k/occurrence s/occurrence :yin.k/origin s/origin\n41\t            :yin.k/arbitration s/arbitration :yin.k/next-op-seq 1}\n42\t           (custody-of (s/lift (s/parked-explicit) (s/header 1))))))\n43\t  (testing \"a halted root carries the origin alone\"\n44\t    (is (= {:yin.k/origin s/origin} (custody-of (s/lift (s/halted-machine) (s/header 0 s/origin #{}))))))\n45\t  (testing \"the enrolled set is a lift input that never travels\"\n46\t    (let [wire (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) (s/header 3 s/origin #{\"s0\"}))]\n47\t      (is (not (contains? (custody-of wire) :yin.k/enrolled)))))\n48\t  (testing \"no header is the fork: nil, on every kind\"\n49\t    (doseq [m [(s/parked-reader) (s/parked-explicit) (s/halted-machine)]]\n50\t      (is (nil? (custody-of (s/lift m nil))))))\n51\t  (testing \"an install child's slot is nil\"\n52\t    (let [task (rows/decode (f/base \"installs\"))]\n53\t      (is (some? (nth (:slots task) 16)))\n54\t      (is (nil? (nth (:slots (f/child task 'host.mod)) 16))))))\n55\t\n56\t\n57\t(deftest the-lift-refuses-what-custody-forbids\n58\t  (testing \"a counter at 2^52-1 on a blocked root\"\n59\t    (is (= {:yin.k/status :yin.k/non-portable :yin.k/kind :op-seq-exhausted :yin.k/next-op-seq rows/max-exact}\n60\t           (s/lift (s/parked-reader) (s/header rows/max-exact s/origin #{})))))\n61\t  (testing \"a halted root ignores the counter\"\n62\t    (is (nil? (:yin.k/status (s/lift (s/halted-machine) (s/header rows/max-exact s/origin #{}))))))\n63\t  (testing \"a retained write on an enrolled stream without an id\"\n64\t    (is (= {:yin.k/status :yin.k/non-portable :yin.k/kind :unprotected-pending :dao.stream/identity \"s0\"}\n65\t           (s/lift (s/parked-writer) (s/header 3 s/origin #{\"s0\"})))))\n66\t  (testing \"an id on a stream that is not enrolled\"\n67\t    (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n68\t           (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) (s/header 3 s/origin #{})))))\n69\t  (testing \"the same rules in an install child\"\n70\t    (let [m (assoc-in (s/parked-installer) [:installs 'host.mod :vm] (s/parked-writer))]\n71\t      (is (= :unprotected-pending (:yin.k/kind (s/lift m (s/header 6 s/origin #{\"s0\"}))))))\n72\t    (let [m (assoc-in (s/parked-installer) [:installs 'host.mod :vm]\n73\t                      (s/with-op-id (s/parked-writer) :put (s/op-id 4)))]\n74\t      (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n75\t             (s/lift m (s/header 6 s/origin #{}))))))\n76\t  (testing \"a halted root with a header but no origin is refused, not downgraded\"\n77\t    (is (= {:yin.k/status :yin.k/undecodable :yin.k/kind :missing-header :yin.k/path [:custody :yin.k/origin]}\n78\t           (select-keys (s/lift (s/halted-machine) (s/header 0 nil #{})) [:yin.k/status :yin.k/kind :yin.k/path]))))\n79\t  (testing \"the lift runs the inspector's grammar before emitting\"\n80\t    (is (= :op-seq-range (:yin.k/kind (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 3))"}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"c451cc9b-9ffa-42e4-b3ee-c3b01e23c3b3","timestamp":"2026-10-13T10:20:04.920Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/rows_custody_test.cljc","content":"(ns yin.vm.ucf.rows-custody-test\n  \"Phase 7a: custody on rows (phase-7 plan §3.1). The lift under a header\n   writes the root's custody slot by kind and refuses :op-seq-exhausted,\n   :unprotected-pending and an id on an unenrolled stream; the lower's\n   custody stage runs the custody grammar, refuses a fork under\n   :exclusive, runs the version-1 grant checks on a blocked or parked\n   exclusive root, protection in both directions and op-id presence equal\n   to enrollment, restores the counter exactly, lowers a halted exclusive\n   root with no grant gated :ended, and every refusal comes before the\n   first attach (zero attachments). The version-1 rules these re-pin are\n   lift_v1_test's and handoff_v2_custody_test's, kept until phase 8.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yin.vm :as vm]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n            [yin.vm.ucf.rows-support :as s]))\n\n\n(defn- custody-of\n  [wire]\n  (nth (:slots (rows/decode wire)) 16))\n\n\n(defn- identities\n  \"Every stream identity of the pack's tree.\"\n  [wire]\n  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n\n\n;; =============================================================================\n;; The lift under a header\n;; =============================================================================\n\n(deftest the-lift-writes-the-custody-slot-by-kind\n  (testing \"a first park: the exclusive policy, no origin\"\n    (is (= {:yin.k/policy :yin.k/exclusive :yin.k/occurrence s/occurrence\n            :yin.k/arbitration s/arbitration :yin.k/next-op-seq 0}\n           (custody-of (s/lift (s/parked-reader) (s/header 0 nil #{}))))))\n  (testing \"a successor carries its origin\"\n    (is (= {:yin.k/policy :yin.k/exclusive :yin.k/occurrence s/occurrence :yin.k/origin s/origin\n            :yin.k/arbitration s/arbitration :yin.k/next-op-seq 1}\n           (custody-of (s/lift (s/parked-explicit) (s/header 1))))))\n  (testing \"a halted root carries the origin alone\"\n    (is (= {:yin.k/origin s/origin} (custody-of (s/lift (s/halted-machine) (s/header 0 s/origin #{}))))))\n  (testing \"the enrolled set is a lift input that never travels\"\n    (let [wire (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) (s/header 3 s/origin #{\"s0\"}))]\n      (is (not (contains? (custody-of wire) :yin.k/enrolled)))))\n  (testing \"no header is the fork: nil, on every kind\"\n    (doseq [m [(s/parked-reader) (s/parked-explicit) (s/halted-machine)]]\n      (is (nil? (custody-of (s/lift m nil))))))\n  (testing \"an install child's slot is nil\"\n    (let [task (rows/decode (f/base \"installs\"))]\n      (is (some? (nth (:slots task) 16)))\n      (is (nil? (nth (:slots (f/child task 'host.mod)) 16))))))\n\n\n(deftest the-lift-refuses-what-custody-forbids\n  (testing \"a counter at 2^52-1 on a blocked root\"\n    (is (= {:yin.k/status :yin.k/non-portable :yin.k/kind :op-seq-exhausted :yin.k/next-op-seq rows/max-exact}\n           (s/lift (s/parked-reader) (s/header rows/max-exact s/origin #{})))))\n  (testing \"a halted root ignores the counter\"\n    (is (nil? (:yin.k/status (s/lift (s/halted-machine) (s/header rows/max-exact s/origin #{}))))))\n  (testing \"a retained write on an enrolled stream without an id\"\n    (is (= {:yin.k/status :yin.k/non-portable :yin.k/kind :unprotected-pending :dao.stream/identity \"s0\"}\n           (s/lift (s/parked-writer) (s/header 3 s/origin #{\"s0\"})))))\n  (testing \"an id on a stream that is not enrolled\"\n    (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n           (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) (s/header 3 s/origin #{})))))\n  (testing \"the same rules in an install child\"\n    (let [m (assoc-in (s/parked-installer) [:installs 'host.mod :vm] (s/parked-writer))]\n      (is (= :unprotected-pending (:yin.k/kind (s/lift m (s/header 6 s/origin #{\"s0\"}))))))\n    (let [m (assoc-in (s/parked-installer) [:installs 'host.mod :vm]\n                      (s/with-op-id (s/parked-writer) :put (s/op-id 4)))]\n      (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n             (s/lift m (s/header 6 s/origin #{}))))))\n  (testing \"a halted root with a header but no origin is refused, not downgraded\"\n    (is (= {:yin.k/status :yin.k/undecodable :yin.k/kind :missing-header :yin.k/path [:custody :yin.k/origin]}\n           (select-keys (s/lift (s/halted-machine) (s/header 0 nil #{})) [:yin.k/status :yin.k/kind :yin.k/path]))))\n  (testing \"the lift runs the inspector's grammar before emitting\"\n    (is (= :op-seq-range (:yin.k/kind (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 3))","numLines":80,"startLine":1,"totalLines":276}},"tool_result_meta":[{"id":"toolu_019yRKZR52F7SYo4YPzMFX6Q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
