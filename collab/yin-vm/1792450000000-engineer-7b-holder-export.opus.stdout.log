{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cfz4wR2pXuqoyBoh2PNg3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012AtPxDUnLaWq5hBoupPxyf","name":"Edit","input":{"replace_all":false,"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","old_string":"            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.lift-support :as s]))","new_string":"            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.rows-support :as s]))"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1792,"cache_read_input_tokens":380849,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1792},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"cd18e65a-0445-49b9-bc12-2d64273bab47","timestamp":"2026-10-13T10:21:02.571Z","request_id":"req_011Cfz4wQSqs9qi1yWxo8zdE","wire_tool_inputs":{"toolu_012AtPxDUnLaWq5hBoupPxyf":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","old_string":"            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.lift-support :as s]))","new_string":"            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.rows-support :as s]))"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012AtPxDUnLaWq5hBoupPxyf","type":"tool_result","content":"The file /Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"dd0ccbdd-3500-4254-9d7b-fa61e4aacbb5","timestamp":"2026-10-13T10:21:02.602Z","tool_use_result":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","oldString":"            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.lift-support :as s]))","newString":"            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.rows-support :as s]))","originalFile":"(ns yin.vm.ucf.holder.driver-test\n  \"D13 and D14: the custody driver (UCF 7.7.2 to 7.7.8, 7.8, 7.9; r3\n   1.5 to 1.10; the D9 header and D10 lower-inputs rulings; linker-dht\n   14.2.4 rows 2 and 7).  Every checkpoint is a real lift of a real\n   machine the engine parked; every offer, grant, binding, input and\n   admission is the real authority's, reached through the real front\n   over the memory substrate; every lease the driver accepts was\n   granted by the real judge or recorded by the real ledger writer.\n   The composition the driver owes -- the front streams, the ledger\n   reader, the lease clock and, since D14, the progress journal, the\n   content store and the exporter's server -- is supplied as functions\n   and handles over that world.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.test-slow :as slow]\n            [dao.datom :as datom]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.admission :as admission]\n            [yin.vm.ucf.authority.completion :as completion]\n            [yin.vm.ucf.authority.front :as front]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.custody :as custody]\n            [yin.vm.ucf.holder.driver :as driver]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.lift-support :as s]))\n\n\n(deftest split-public-entries-test\n  (let [state {:phase :stalled :status :yin.k/unsatisfied}\n        stopped (driver/stop state)]\n    (is (= state (driver/control-step state)))\n    (is (= state (driver/program-step state)))\n    (is (= stopped (driver/stop stopped)))\n    (is (= stopped (driver/program-step stopped)))\n    (is (false? (driver/owed-control-write? state)))\n    (is (false? (driver/owed-control-write? nil)))))\n\n\n(deftest stalled-public-entries-do-not-progress-test\n  (let [state {:phase :stalled :status :yin.k/unsatisfied}]\n    (is (= state (driver/abort state)))\n    (is (= state (driver/enroll state)))\n    (is (= state (driver/hand-off state)))))\n\n\n(deftest journal-fold-keeps-unmatched-retry-intents-test\n  (let [intent {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/offer\n                :yin.k/occurrence \"source\"\n                :yin.k/request {:yin.k/request-id \"offer\"}}\n        attempt {:yin.k/journal :yin.k/attempt :yin.k/action :yin.k/offer\n                 :yin.k/occurrence \"source\" :yin.k/append :dao.stream/full}\n        folded (driver/fold-journal [intent attempt intent])]\n    (is (= [{:append :dao.stream/full} {}] (get-in folded [:attempts \"source\"])))\n    (is (= [intent intent] (:ordered-intents folded)))))\n\n\n(deftest journal-transport-failure-is-not-end-of-history-test\n  (let [handle (reify stream/IDaoStreamReader\n                 (cursor [_ _] {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n                 (next [_ _] {:dao.stream/outcome :dao.stream/transport-error}))\n        failure (try (driver/journal-records handle) nil\n                     (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n    (is (some? failure))))\n\n\n(deftest journal-gap-and-malformed-records-refuse-test\n  (doseq [value [{:yin.k/journal :unknown} :not-a-record]]\n    (let [reads (atom 0)\n          handle (reify stream/IDaoStreamReader\n                   (cursor\n                     [_ _]\n                     {:dao.stream/outcome :dao.stream/ok\n                      :dao.stream/cursor {:dao.stream.memory-log/identity \"journal\"\n                                          :dao.stream.memory-log/position 0}})\n\n                   (next\n                     [_ _]\n                     (swap! reads inc)\n                     {:dao.stream/outcome :dao.stream/ok\n                      :dao.stream/cursor {:dao.stream.memory-log/identity \"journal\"\n                                          :dao.stream.memory-log/position 2}\n                      :dao.stream/value value}))\n          failure (try (driver/journal-records handle) nil\n                       (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n      (is (some? failure))\n      (is (= 1 @reads)))))\n\n\n(deftest a-known-journal-tag-with-missing-fields-is-not-a-valid-frame-test\n  (let [reads (atom 0)\n        handle (reify stream/IDaoStreamReader\n                 (cursor [_ _] {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n                 (next\n                   [_ _]\n                   (if (= 1 (swap! reads inc))\n                     {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 1\n                      :dao.stream/value {:yin.k/journal :yin.k/intent}}\n                     {:dao.stream/outcome :dao.stream/blocked})))\n        failure (try (driver/journal-records handle) nil\n                     (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n    (is (some? failure))\n    (is (= 1 @reads))))\n\n\n(def ^:private arb \"arb-d13\")\n\n(def ^:private duration {:s 30})\n\n(def ^:private interval {:s 10})\n\n\n;; =============================================================================\n;; The substrate: rings, logs, and integer-position streams\n;; =============================================================================\n\n(defn- ring\n  [n]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key n})))\n\n\n(defn- log\n  []\n  (:dao.stream/handle\n    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n\n\n(defn- stream-id\n  [h]\n  (:dao.stream/identity (stream/descriptor h)))\n\n\n(defn- oldest\n  [h]\n  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n\n\n(defn- read-all\n  [h]\n  (loop [c (oldest h) vs []]\n    (let [r (stream/next h c)]\n      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count vs) 1000))\n        (recur (:dao.stream/cursor r) (conj vs (:dao.stream/value r)))\n        vs))))\n\n\n(defn- int-stream\n  \"A stream whose values sit in an atom and whose cursors are plain\n  integer positions, so a position lifted from the source's instance is\n  a valid cursor on the receiving composition's own instance.\"\n  [identity]\n  (let [values (atom [])]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (let [vs @values]\n          (cond\n            (not (and (integer? cursor) (<= 0 cursor (count vs))))\n            {:dao.stream/outcome :dao.stream/invalid-cursor}\n            (< cursor (count vs))\n            {:dao.stream/outcome :dao.stream/ok\n             :dao.stream/value (nth vs cursor)\n             :dao.stream/cursor (inc cursor)}\n            :else {:dao.stream/outcome :dao.stream/blocked})))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (swap! values conj x)\n        {:dao.stream/outcome :dao.stream/ok}))))\n\n\n(defn- bounded-stream\n  \"A stream that answers `full` while `n` or more of its values remain\n  unread, freeing capacity as the reader consumes them: the backpressure\n  a holder's inbound stream gives its front.\"\n  [identity n]\n  (let [st (atom {:values [] :served 0})]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (let [{:keys [values]} @st]\n          (cond\n            (not (and (integer? cursor) (<= 0 cursor (count values))))\n            {:dao.stream/outcome :dao.stream/invalid-cursor}\n            (< cursor (count values))\n            (do (swap! st update :served max (inc cursor))\n                {:dao.stream/outcome :dao.stream/ok\n                 :dao.stream/value (nth values cursor)\n                 :dao.stream/cursor (inc cursor)})\n            :else {:dao.stream/outcome :dao.stream/blocked})))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (let [{:keys [values served]} @st]\n          (if (>= (- (count values) served) n)\n            {:dao.stream/outcome :dao.stream/full}\n            (do (swap! st update :values conj x)\n                {:dao.stream/outcome :dao.stream/ok})))))))\n\n\n(defn- inbox-over\n  \"Complete-retention positional reads over the test log. Reconstructing\n   this descriptor over the same backing data simulates process recovery.\"\n  [handle author]\n  {:version 1\n   :identity (stream-id handle)\n   :read-at! (fn [position]\n               (loop [cursor (oldest handle) remaining position]\n                 (let [answer (stream/next handle cursor)]\n                   (case (:dao.stream/outcome answer)\n                     :dao.stream/ok\n                     (if (zero? remaining)\n                       {:status :record :position position :author author\n                        :record (:dao.stream/value answer)}\n                       (recur (:dao.stream/cursor answer) (dec remaining)))\n                     :dao.stream/blocked {:status :empty}\n                     {:status :unavailable}))))})\n\n\n(defn- attach-over\n  \"A receiving composition's attach dispatch over a fixed table of\n  identity to handle.\"\n  [table]\n  (fn [descriptor]\n    (if-some [h (get table (:dao.stream/identity descriptor))]\n      {:dao.stream/outcome :dao.stream/ok :dao.stream/handle h}\n      {:dao.stream/outcome :dao.stream/not-found})))\n\n\n;; =============================================================================\n;; The source: a real machine, really lifted, and its second encoding\n;; =============================================================================\n\n(def ^:private occurrence \"3d000000-0000-4000-8000-0000000000d1\")\n\n(def ^:private predecessor \"3d000000-0000-4000-8000-0000000000d0\")\n\n\n(defn- arbitration-map\n  []\n  {:dao.stream/identity arb\n   :dao.stream/descriptor {:dao.stream/type :dao.stream/journal}})\n\n\n(defn- header-of\n  ([n] {:yin.k/occurrence occurrence\n        :yin.k/arbitration (arbitration-map)\n        :yin.k/next-op-seq n\n        :yin.k/enrolled #{}})\n  ([n enrolled origin?]\n   (cond-> (assoc (header-of n) :yin.k/enrolled enrolled)\n     origin? (assoc :yin.k/origin {:yin.k/occurrence predecessor\n                                   :dao.lease/lease \"lease-0\"\n                                   :yin.k/emitter \"peer-0\"}))))\n\n\n(defn- parked-reader-over\n  \"A real gated machine over `source`, parked on its first read: one\n  more delivered value and it halts with :done.\"\n  [source]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/then {:type :stream/next, :source (s/v 'c)}\n                               (s/lit :done)))\n        [sref m1] (engine/attach-resource m0 source)\n        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)]\n    (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))))\n\n\n(defn- parked-writer-over\n  \"A real gated machine over `target`, parked on one put of `value` to it.\"\n  [target value]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/then {:type :stream/put, :target (s/v 'w),\n                                :val (s/lit value)}\n                               (s/lit :done)))\n        [wref m1] (engine/attach-resource m0 target)]\n    (vm/run (assoc m1 :store {'w wref} :yin.k/gate :running))))\n\n\n(defn- serve-as\n  \"The exporter's `serve!`, answering one fixed identity for every\n  handle it is asked about.\"\n  [identity]\n  (fn [_h]\n    {:dao.stream/identity identity\n     :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n                          :dao.stream/identity identity}}))\n\n\n(defn- lift-under\n  \"Enter exporting from `machine`, prepare under `header` with `serve!`,\n  and encode: the bytes, address and body of one real snapshot\n  variant.\"\n  [machine header serve!]\n  (let [e (export/enter machine)]\n    (when-not (= :ok (:status e))\n      (throw (ex-info \"The source did not enter exporting\" e)))\n    (let [p (export/prepare (:machine e) (:record e) serve! header)]\n      (when-not (= :ok (:status p))\n        (throw (ex-info \"The source did not prepare\" (dissoc p :record))))\n      (let [r (export/encode (:machine e) (:record p))]\n        (when-not (= :ok (:status r))\n          (throw (ex-info \"The source did not encode\" (dissoc r :record))))\n        (select-keys r [:bytes :address :body])))))\n\n\n(defn- variant-of\n  \"A second encoding of the occurrence `lifted` names: the same baseline\n  (occurrence, arbitration, counter, carried ids) in different bytes,\n  the way the C4 variant fixtures mutate a base.\"\n  [lifted]\n  (let [bytes (cbor/encode (assoc (:body lifted) :yin.k/id-counter 9))]\n    {:bytes bytes\n     :address (keyword \"segment\"\n                       (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))}))\n\n\n(defn- reader-source\n  \"The reader source of every test: the parked machine (kept, for the\n  source-fence test), its real lift, and a second encoding of the same\n  occurrence.\"\n  []\n  (let [machine (parked-reader-over (int-stream \"prog-r\"))\n        lifted (lift-under machine (header-of 0) (serve-as \"prog-r\"))]\n    {:machine machine\n     :sources {\"v1\" lifted\n               \"v2\" (variant-of lifted)}}))\n\n\n;; =============================================================================\n;; The world: an authority, a judge, and one front per holder\n;; =============================================================================\n\n(defn- records\n  [frames]\n  (mapv #(:dao.stream.journal/value (cbor/decode %)) (rest @frames)))\n\n\n(defn- attributed\n  ([frames] (attributed frames arb))\n  ([frames author] (mapv (fn [r] [author r]) (records frames))))\n\n\n(declare fresh-journal)\n\n\n(defn- world\n  \"A real authority over fresh frames, one front per named holder (its\n  inbound from `:inbound`, a fresh ring by default), a lease-fact\n  medium per holder, a tick log, and a judge wired over every medium.\n  Every source in `sources` (a map of variant name to {:bytes\n  :address}) is offered before one more target is enrolled.\n  `:epoch-bound` lowers the authority's epoch bound for tests.\"\n  [& {:keys [holders sources inbound lease-media epoch-bound]}]\n  (let [frames (atom [(cbor/encode {:dao.stream.journal/header\n                                    {:version 1 :identity arb}})])\n        a (::authority/authority (authority/open!\n                                   (journal/memory-backend frames nil)\n                                   (when (some? epoch-bound)\n                                     {::authority/max-epoch epoch-bound})))\n        store (mem/create-content-mem)\n        ;; the enrolled target comes first, so a source may serve its\n        ;; write target under the target's own identity\n        target (:yin.k/target (authority/enroll! a))\n        _ (doseq [{:keys [bytes address]} (vals sources)]\n            (let [r (grant/offer! a store address bytes \"carrier\")]\n              (when (contains? #{:refused :suspended} (:yin.k/status r))\n                (throw (ex-info \"The world's offer was refused\" r)))))\n        ticks (log)\n        _ (stream/append! ticks (lease/tick {:s 1}))\n        media (merge (into {} (map (fn [h] [h (log)])) holders) lease-media)\n        inbounds (into {} (map (fn [h] [h (ring 16)])) holders)\n        inbounds (merge inbounds (select-keys inbound holders))\n        identities (into {} (map (fn [[h r]] [h (stream-id r)])) inbounds)\n        resolver (fn [identity _]\n                   (some (fn [[h i]] (when (= identity i) h)) identities))\n        reply-journals (into {} (map (fn [holder] [holder (fresh-journal)])) holders)\n        replies (into {} (map (fn [[holder entry]] [holder (:journal entry)])) reply-journals)\n        fronts (into {}\n                     (map (fn [h]\n                            [h (atom (front/front\n                                       {:authority a\n                                        :inbound (get inbounds h)\n                                        :reply (get replies h)\n                                        :diagnostics (log)\n                                        :resolver resolver\n                                        :store store\n                                        :lease-media media}))]))\n                     holders)\n        judge (atom (reduce (fn [j h]\n                              (lease/wire-facts j (get media h)\n                                                (oldest (get media h)) h))\n                            (-> (lease/initial-judge\n                                  (merge (grant/judge-config a duration)\n                                         {:resolver (fn [source _] source)\n                                          :self arb}))\n                                (lease/wire-tick ticks (oldest ticks) :ticks))\n                            holders))]\n    {:frames frames\n     :a a\n     :store store\n     :target target\n     :media media\n     :inbounds inbounds\n     :replies replies\n     :reply-frames (into {} (map (fn [[holder entry]] [holder (:frames entry)])) reply-journals)\n     :fronts fronts\n     :judge judge\n     :ticks ticks\n     :outcomes (admission/outcome-reader a)}))\n\n\n(defn- inbound\n  [w holder]\n  (read-all (get (:inbounds w) holder)))\n\n\n(defn- requests-of\n  [w holder kind]\n  (filter #(= kind (:yin.k/request %)) (inbound w holder)))\n\n\n(defn- carry!\n  \"Step every front past up to 16 requests.\"\n  [w]\n  (doseq [f (vals (:fronts w))]\n    (swap! f front/step 16))\n  w)\n\n\n(defn- judge!\n  \"Advance the tick log one reading and run one judge step.\"\n  [w reading]\n  (stream/append! (:ticks w) (lease/tick reading))\n  (swap! (:judge w) #(grant/step! (:a w) %))\n  w)\n\n\n(defn- grant-direct!\n  \"Record a grant of `l` to `holder` answering `pid`, through the\n  authority's own ledger writer (the judge's writer path).\"\n  [w l holder pid]\n  (stream/append! (grant/writer (:a w))\n                  (lease/grant l (custody/subject occurrence) holder duration\n                               {:dao.lease/proposal pid})))\n\n\n(defn- lapse-direct!\n  [w l cause]\n  (stream/append! (grant/writer (:a w)) (lease/lapsed l cause)))\n\n\n;; =============================================================================\n;; The driver over the world\n;; =============================================================================\n\n(defn- counting\n  \"[calls answers] over one counting fn.\"\n  [f]\n  (let [n (atom 0)]\n    [(fn [& args] (swap! n inc) (apply f args)) n]))\n\n\n(defn- fresh-journal\n  \"A composition-supplied progress journal over fresh frames; the atom\n   is kept, so the same frames reopen.\"\n  []\n  (let [frames (atom [])]\n    {:frames frames\n     :journal (:dao.stream/handle\n                (journal/open! (journal/memory-backend frames nil)))}))\n\n\n(defn- reopened-journal\n  \"A fresh handle over `frames` -- the reopen after a crash.\"\n  [frames]\n  (:dao.stream/handle (journal/open! (journal/memory-backend frames nil))))\n\n\n(defn- cut-backend\n  \"A memory journal backend whose one write at `position` (a frame\n   count) suffers `cut` -- :before-frame or :after-frame-before-visible\n   -- exactly once, the crash windows of an uncertain append.\"\n  [frames position cut]\n  (let [inner (journal/memory-backend frames nil)\n        armed (atom true)]\n    (assoc inner\n           :dao.stream.journal/write-frame!\n           (fn [bs]\n             (if (and @armed (= position (count @frames)))\n               (do (reset! armed false)\n                   (case cut\n                     :before-frame\n                     (throw (ex-info \"cut before the frame\" {}))\n                     :after-frame-before-visible\n                     (do (swap! frames conj bs)\n                         (throw (ex-info \"cut after the frame\" {})))))\n               ((:dao.stream.journal/write-frame! inner) bs))))))\n\n\n(defn- cut-record-backend\n  [frames predicate cut]\n  (let [inner (journal/memory-backend frames nil)\n        armed (atom true)]\n    (assoc inner :dao.stream.journal/write-frame!\n           (fn [bytes]\n             (if (and @armed (predicate (:dao.stream.journal/value (cbor/decode bytes))))\n               (do (reset! armed false)\n                   (when (= :after-frame-before-visible cut) (swap! frames conj bytes))\n                   (throw (ex-info \"simulated journal cut\" {})))\n               ((:dao.stream.journal/write-frame! inner) bytes))))))\n\n\n(defn- driver-for\n  \"The candidate's step state for `holder` over variant `v` of\n  `sources` (or the raw {:keys bytes address]} of `:raw`).  `:ledger`\n  overrides the ledger read, `:protection-as` the protection\n  declaration.  D14's seams -- the journal (fresh frames, kept for a\n  reopen), the world's content store, the exporter's server and the\n  carrier medium -- ride along.\"\n  [w holder sources v & {:keys [ledger protection-as raw attach-table\n                                journal-as]}]\n  (let [{:keys [bytes address]} (or raw (get sources v))\n        _ (assert (some? bytes) \"the variant's bytes\")\n        prog (int-stream \"prog-r\")\n        clock (atom {:s 1})\n        [attach! attaches] (counting\n                             (attach-over (merge {\"prog-r\" prog} attach-table)))\n        [observe! observations] (counting\n                                  (fn [h op arg]\n                                    (case op\n                                      :next (stream/next h arg)\n                                      :cursor (stream/cursor h arg))))\n        diagnostics (log)\n        j (or journal-as (fresh-journal))]\n    {:state (driver/initial\n              {:me holder\n               :bytes bytes\n               :address address\n               :protection (or protection-as {\"prog-r\" :at-least-once})\n               :renewal-interval interval\n               :receiver (s/new-machine)\n               :attach! attach!\n               :append-request! (fn [request]\n                                  (stream/append!\n                                    (get (:inbounds w) holder) request))\n               :reply-inbox (inbox-over (get (:replies w) holder) arb)\n               :outcome-inbox (inbox-over (:outcomes w) arb)\n               :read-ledger! (fn []\n                               (let [rs (attributed (:frames w))]\n                                 (if ledger (ledger rs) rs)))\n               :clock (fn [] @clock)\n               :observe! observe!\n               :append-diagnostic! (fn [d] (stream/append! diagnostics d))\n               :serve! (serve-as \"prog-r\")\n               :journal (:journal j)\n               :store (:store w)\n               :medium \"carrier\"})\n     :clock clock\n     :prog prog\n     :attaches attaches\n     :observations observations\n     :diagnostics diagnostics\n     :journal-frames (:frames j)}))\n\n\n(defn- drive\n  \"Step `d` once, then carry the fronts; with `:judge reading` also run\n  one judge step at that reading.\"\n  [w d & {:keys [judge]}]\n  (let [state (driver/step (:state d))]\n    (carry! w)\n    (when judge (judge! w judge))\n    (assoc d :state state)))\n\n\n(defn- drive-to\n  \"Drive until `pred` holds of the state or `n` steps are spent; asserts\n  the predicate held.\"\n  [w d pred n & {:keys [judge]}]\n  (loop [d d k 0]\n    (let [d' (drive w d :judge judge)]\n      (if (or (pred (:state d')) (>= (inc k) n))\n        (do (is (pred (:state d')) (pr-str (select-keys (:state d') [:phase :status :detail])))\n            d')\n        (recur d' (inc k))))))\n\n\n(defn- phase-of\n  [phase]\n  (fn [state] (= phase (:phase state))))\n\n\n(defn- to-running\n  \"Drive `d` to :running through the judge's own grant.\"\n  [w d]\n  (drive-to w d (phase-of :running) 8 :judge {:s 2}))\n\n\n(defn- own-grant-driver\n  [w sources variant]\n  (let [driver (drive w (drive w (driver-for w \"holder-a\" sources variant)))]\n    (grant-direct! w \"lease-1\" \"holder-a\" (get-in driver [:state :proposal :id]))\n    driver))\n\n\n(defn- split-grant\n  [world' sources]\n  (let [record (driver-for world' \"holder-a\" sources \"v1\")\n        validated (driver/program-step (:state record))\n        proposed (driver/control-step validated)]\n    (carry! world')\n    (judge! world' {:s 2})\n    (assoc record :state (driver/control-step proposed))))\n\n\n(defn- reopen-config\n  [state]\n  (merge (select-keys state [:me :bytes :address :protection :renewal-interval :units :receiver])\n         (:seams state)\n         {:store (get-in state [:seams :content-store])}))\n\n\n(defn- retained-record\n  [lane identity position author record binding]\n  (cond-> {:yin.k/journal :yin.k/inbox :yin.k/lane lane\n           :yin.k/identity identity :yin.k/position position\n           :yin.k/author author :yin.k/record record}\n    binding (assoc :yin.k/binding binding)))\n\n\n(deftest paused-grant-and-delayed-activation-test\n  (doseq [expired? [false true]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          accepted (split-grant world' sources)\n          state (:state accepted)]\n      (is (= :activating (:phase state)))\n      (is (nil? (:machine state)))\n      (is (zero? @(:attaches accepted)))\n      (reset! (:clock accepted) (if expired? {:s 31} {:s 2}))\n      (let [resumed (driver/program-step state)]\n        (if expired?\n          (do (is (= :releasing (:phase resumed)))\n              (is (zero? @(:attaches accepted)))\n              (is (nil? (:machine resumed))))\n          (do (is (= :running (:phase resumed)))\n              (is (pos? @(:attaches accepted)))\n              (is (= {:s 1} (get-in resumed [:holder :granted-at])))))))))\n\n\n(defn- inbox-obstructed-tick\n  [state split?]\n  (if split?\n    (driver/program-step (driver/control-step state))\n    (driver/step state)))\n\n\n(deftest unavailable-outcomes-preserve-renewal-and-suspend-program-test\n  (doseq [split? [false true]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (split-grant world' sources)\n          running (driver/program-step (:state record))\n          machine (:machine running)\n          attachments @(:attaches record)\n          _ (stream/append! (get (:replies world') \"holder-a\")\n                            {:yin.k/reply :yin.k/input :yin.k/request-id :deferred})\n          original (get-in running [:seams :outcome-inbox :read-at!])\n          blocked (assoc-in running [:seams :outcome-inbox :read-at!]\n                            (constantly {:status :unavailable}))\n          _ (reset! (:clock record) {:s 11})\n          sent (inbox-obstructed-tick blocked split?)\n          _ (carry! world')\n          renewed (inbox-obstructed-tick sent split?)]\n      (is (some? (:renewal sent)))\n      (is (true? (driver/owed-control-write? sent)))\n      (is (= 1 (:renewals renewed)))\n      (is (= {:s 11} (get-in renewed [:holder :last-renewal-at])))\n      (is (nil? (:renewal renewed)))\n      (is (= machine (:machine renewed)))\n      (is (= attachments @(:attaches record)))\n      (is (zero? @(:observations record)))\n      (is (= 0 (get-in renewed [:inbox :positions :outcome])))\n      (is (= 1 (count (get-in renewed [:inbox :program]))))\n      (is (= :inbox-unavailable (:yin.k/reason (:detail renewed))))\n      (is (false? (driver/owed-control-write? renewed)))\n      (let [available (driver/control-step\n                        (assoc-in renewed [:seams :outcome-inbox :read-at!] original))]\n        (is (not (:inbox-unavailable? available)))\n        (is (= :yin.k/ok (:status available)))))))\n\n\n(deftest unavailable-replies-retry-renewal-without-credit-test\n  (doseq [split? [false true]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (split-grant world' sources)\n          running (driver/program-step (:state record))\n          outcome-reads (atom 0)\n          blocked (-> running\n                      (assoc-in [:seams :reply-inbox :read-at!]\n                                (constantly {:status :unavailable}))\n                      (assoc-in [:seams :outcome-inbox :read-at!]\n                                (fn [_] (swap! outcome-reads inc) {:status :empty})))\n          _ (reset! (:clock record) {:s 11})\n          sent (inbox-obstructed-tick blocked split?)\n          _ (carry! world')\n          _ (reset! (:clock record) {:s 12})\n          retried (inbox-obstructed-tick sent split?)\n          _ (carry! world')\n          requests (requests-of world' \"holder-a\" :yin.k/renewal)]\n      (is (= 2 (count requests)))\n      (is (= 1 (count (distinct requests))))\n      (is (= (:renewal sent) (:renewal retried)))\n      (is (= {:s 11} (get-in retried [:renewal :reading])))\n      (is (= (:holder running) (:holder retried)))\n      (is (zero? (:renewals retried)))\n      (is (= (:machine running) (:machine retried)))\n      (is (zero? @outcome-reads))\n      (is (= (get-in running [:inbox :positions]) (get-in retried [:inbox :positions])))\n      (is (true? (driver/owed-control-write? retried)))\n      (is (= :inbox-unavailable (:yin.k/reason (:detail retried))))\n      (let [records (driver/journal-records (get-in retried [:seams :journal]))]\n        (is (= 2 (count (filter #(and (= :yin.k/renewal (:yin.k/action %))\n                                      (= :yin.k/attempt (:yin.k/journal %))) records))))\n        (is (empty? (filter #(and (= :yin.k/renewal (:yin.k/action %))\n                                  (= :yin.k/ack (:yin.k/journal %))) records)))))))\n\n\n(deftest unavailable-reply-recovery-cannot-revive-expired-tenure-test\n  (doseq [split? [false true] late? [false true]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (split-grant world' sources)\n          running (driver/program-step (:state record))\n          reply (get-in running [:seams :reply-inbox :read-at!])\n          blocked (assoc-in running [:seams :reply-inbox :read-at!]\n                            (constantly {:status :unavailable}))\n          _ (reset! (:clock record) {:s 11})\n          sent (inbox-obstructed-tick blocked split?)\n          _ (carry! world')\n          _ (reset! (:clock record) {:s (if late? 31 12)})\n          recovered (inbox-obstructed-tick\n                      (assoc-in sent [:seams :reply-inbox :read-at!] reply) split?)]\n      (if late?\n        (do (is (= :releasing (:phase recovered)))\n            (is (= :ended (vm/gate-mode (:machine recovered))))\n            (is (zero? (:renewals recovered)))\n            (is (nil? (get-in recovered [:holder :last-renewal-at])))\n            (is (= :lease-bound (:cause (:detail recovered)))))\n        (do (is (= 1 (:renewals recovered)))\n            (is (= {:s 11} (get-in recovered [:holder :last-renewal-at])))\n            (is (nil? (:renewal recovered))))))))\n\n\n(deftest unavailable-inboxes-expire-and-recover-durable-cleanup-test\n  (doseq [split? [false true] lane [:reply :outcome]]\n    (let [{:keys [sources]} (reader-source)\n          medium (bounded-stream \"lease-a\" 1)\n          world' (world :holders [\"holder-a\"] :sources sources\n                        :lease-media {\"holder-a\" medium})\n          record (split-grant world' sources)\n          running (driver/program-step (:state record))\n          key (if (= :reply lane) :reply-inbox :outcome-inbox)\n          descriptor (get-in running [:seams key])\n          blocked (assoc-in running [:seams key :read-at!]\n                            (constantly {:status :unavailable}))\n          _ (stream/append! medium :full)\n          _ (reset! (:clock record) {:s 31})\n          ended (inbox-obstructed-tick blocked split?)\n          _ (carry! world')\n          retried (inbox-obstructed-tick ended split?)\n          _ (carry! world')\n          records (driver/journal-records (get-in retried [:seams :journal]))\n          recovered (driver/stop\n                      (driver/reopen (assoc (reopen-config retried)\n                                            :journal (reopened-journal (:journal-frames record)))))\n          resent (inbox-obstructed-tick recovered split?)\n          _ (carry! world')]\n      (is (= :releasing (:phase ended)))\n      (is (= :ended (vm/gate-mode (:machine ended))))\n      (is (= 1 (count (read-all (:diagnostics record)))))\n      (is (= (get-in ended [:release :request]) (get-in retried [:release :request])))\n      (is (= (get-in ended [:release :request]) (get-in resent [:release :request])))\n      (is (true? (driver/owed-control-write? resent)))\n      (is (nil? (:machine resent)))\n      (is (nil? (:holder resent)))\n      (is (= 1 (count (distinct (requests-of world' \"holder-a\" :yin.k/release)))))\n      (is (not (true? (get-in resent [:release :carried]))))\n      (let [actions (filter #(= :yin.k/release (:yin.k/action %)) records)]\n        (is (= [:yin.k/intent :yin.k/attempt :yin.k/intent :yin.k/attempt]\n               (mapv :yin.k/journal actions))))\n      (judge! world' {:s 32})\n      (let [pending (inbox-obstructed-tick resent split?)\n            _ (carry! world')\n            acknowledged (inbox-obstructed-tick pending split?)\n            available (assoc-in acknowledged [:seams key] descriptor)\n            finished (inbox-obstructed-tick available split?)]\n        (when (= :reply lane)\n          (is (= :releasing (:phase acknowledged)))\n          (is (true? (driver/owed-control-write? acknowledged))))\n        (is (= :failed (:phase finished)))\n        (is (true? (get-in finished [:release :carried])))\n        (is (= 1 (count (read-all (:diagnostics record)))))\n        (is (zero? @(:observations record)))))))\n\n\n(deftest unavailable-inboxes-block-activation-but-not-custody-test\n  (doseq [split? [false true] lane [:reply :outcome]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (split-grant world' sources)\n          key (if (= :reply lane) :reply-inbox :outcome-inbox)\n          descriptor (get-in record [:state :seams key])\n          blocked (assoc-in (:state record) [:seams key :read-at!]\n                            (constantly {:status :unavailable}))\n          _ (reset! (:clock record) {:s 11})\n          sent (inbox-obstructed-tick blocked split?)\n          _ (carry! world')\n          waiting (inbox-obstructed-tick sent split?)\n          attachments @(:attaches record)\n          available (inbox-obstructed-tick (assoc-in waiting [:seams key] descriptor) split?)]\n      (is (= :activating (:phase waiting)))\n      (is (zero? attachments))\n      (is (nil? (:machine waiting)))\n      (is (= :inbox-unavailable (:yin.k/reason (:detail waiting))))\n      (is (= (if (= :outcome lane) 1 0) (:renewals waiting)))\n      (is (= :running (:phase available)))\n      (is (some? (:machine available)))\n      (is (= 1 (:renewals available)))\n      (is (= {:s 11} (get-in available [:holder :last-renewal-at]))))))\n\n\n(deftest unavailable-inbox-does-not-waive-control-evidence-test\n  (doseq [split? [false true] obstruction [:ledger :malformed]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (split-grant world' sources)\n          running (driver/program-step (:state record))\n          blocked (case obstruction\n                    :ledger (-> running\n                                (assoc-in [:seams :outcome-inbox :read-at!]\n                                          (constantly {:status :unavailable}))\n                                (assoc-in [:seams :read-ledger!] (constantly nil)))\n                    :malformed (assoc-in running [:seams :reply-inbox :read-at!]\n                                         (constantly {:status :unavailable :extra true})))\n          _ (reset! (:clock record) {:s 11})\n          checked (inbox-obstructed-tick blocked split?)]\n      (is (nil? (:renewal checked)))\n      (is (empty? (requests-of world' \"holder-a\" :yin.k/renewal)))\n      (is (= (:machine running) (:machine checked)))\n      (is (zero? @(:observations record)))\n      (is (false? (driver/owed-control-write? checked))))))\n\n\n(deftest unavailable-cleanup-reconciliation-refuses-conflicting-history-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        record (split-grant world' sources)\n        state (assoc-in (:state record) [:seams :reply-inbox :read-at!]\n                        (constantly {:status :unavailable}))\n        recovered (driver/reopen (assoc (reopen-config state)\n                                        :journal (reopened-journal (:journal-frames record))))\n        attempts (atom [])\n        damaged (-> recovered\n                    (assoc-in [:seams :append-request!]\n                              (fn [request]\n                                (swap! attempts conj request)\n                                {:dao.stream/outcome :dao.stream/ok}))\n                    (assoc-in [:seams :reply-inbox :read-at!]\n                              (fn [position]\n                                {:status :record :position position\n                                 :author arb :record {:changed true}})))\n        refused (driver/control-step damaged)]\n    (is (= :releasing (:phase recovered)))\n    (is (true? (:inbox-unavailable? recovered)))\n    (is (= :inbox-conflict (:yin.k/reason (:detail refused))))\n    (is (true? (:inbox-refused? refused)))\n    (is (empty? @attempts))\n    (is (false? (driver/owed-control-write? refused)))\n    (is (nil? (:machine refused)))\n    (is (zero? @(:attaches record)))))\n\n\n(deftest unavailable-inbox-release-journal-uncertainty-is-a-hard-stall-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        record (split-grant world' sources)\n        attempts (atom [])\n        original (get-in record [:state :seams :append-request!])\n        progress (cut-record-backend (:journal-frames record)\n                                     #(and (= :yin.k/intent (:yin.k/journal %))\n                                           (= :yin.k/release (:yin.k/action %)))\n                                     :after-frame-before-visible)\n        state (-> (:state record)\n                  (assoc-in [:seams :reply-inbox :read-at!]\n                            (constantly {:status :unavailable}))\n                  (assoc-in [:seams :journal] (:dao.stream/handle (journal/open! progress)))\n                  (assoc-in [:seams :append-request!]\n                            (fn [request] (swap! attempts conj request) (original request))))\n        _ (reset! (:clock record) {:s 31})\n        stalled (driver/step state)\n        recovered (driver/stop\n                    (driver/reopen (assoc (reopen-config state)\n                                          :journal (reopened-journal (:journal-frames record)))))\n        resent (driver/control-step recovered)]\n    (is (= :stalled (:phase stalled)))\n    (is (= stalled (driver/control-step stalled)))\n    (is (= stalled (driver/program-step stalled)))\n    (is (false? (driver/owed-control-write? stalled)))\n    (is (= 1 (count @attempts)))\n    (is (= (get-in recovered [:release :request]) (first @attempts)))\n    (is (= :releasing (:phase resent)))\n    (is (nil? (:machine resent)))\n    (is (zero? @(:attaches record)))))\n\n\n(deftest control-isolation-and-renewal-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        accepted (split-grant world' sources)\n        activated (driver/program-step (:state accepted))\n        sink (int-stream \"isolated-write\")\n        original (:machine activated)\n        pending (-> (first (:wait-set original))\n                    (dissoc :cursor-ref)\n                    (assoc :reason :put :stream-id :isolated-write\n                           :datom :must-not-emit :yin.k/issue 0))\n        activated (assoc activated :machine\n                         (-> (s/load-ast original (s/lit :must-not-execute))\n                             (update :wait-set conj pending)\n                             (assoc-in [:resources :isolated-write] sink)\n                             (assoc-in [:yin.k/custody :protection \"isolated-write\"] :at-least-once)))\n        machine (:machine activated)\n        attached @(:attaches accepted)\n        _ (stream/append! (:prog accepted) :ready-input)\n        _ (reset! (:clock accepted) {:s 11})\n        renewed (driver/control-step activated)\n        _ (carry! world')\n        carried (driver/control-step renewed)]\n    (is (= machine (:machine carried)))\n    (is (empty? (read-all sink)))\n    (is (nil? (:value (:machine carried))))\n    (is (= attached @(:attaches accepted)))\n    (is (zero? @(:observations accepted)))\n    (is (= 1 (:renewals carried)))\n    (is (nil? (:renewal carried)))\n    (is (false? (driver/owed-control-write? carried)))\n    (let [stopped (driver/stop carried)\n          cleaned (driver/control-step stopped)]\n      (is (= stopped (driver/program-step stopped)))\n      (is (= :releasing (:phase cleaned)))\n      (is (= attached @(:attaches accepted)))\n      (is (empty? (read-all sink)))\n      (is (zero? @(:observations accepted))))))\n\n\n(deftest paused-grant-renewal-keeps-the-original-observation-basis-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        record (split-grant world' sources)\n        _ (reset! (:clock record) {:s 11})\n        renewed (driver/control-step (:state record))\n        _ (carry! world')\n        acknowledged (driver/control-step renewed)\n        _ (reset! (:clock record) {:s 35})\n        activated (driver/program-step acknowledged)]\n    (is (= {:s 1} (get-in activated [:holder :granted-at])))\n    (is (= {:s 11} (get-in activated [:holder :last-renewal-at])))\n    (is (= :running (:phase activated)))\n    (is (pos? @(:attaches record)))))\n\n\n(deftest independent-program-tenure-test\n  (doseq [change [:expired :unavailable :replaced]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          accepted (split-grant world' sources)\n          activated (driver/program-step (:state accepted))\n          machine (:machine activated)\n          state (case change\n                  :expired (do (reset! (:clock accepted) {:s 31}) activated)\n                  :unavailable (assoc-in activated [:seams :read-ledger!] (constantly nil))\n                  :replaced (do (lapse-direct! world' (:lease activated) :release) activated))\n          next-state (driver/program-step state)]\n      (is (zero? @(:observations accepted)))\n      (if (= :unavailable change)\n        (do (is (= machine (:machine next-state)))\n            (is (= :yin.k/unsatisfied (:status next-state))))\n        (is (= :releasing (:phase next-state)))))))\n\n\n(deftest shutdown-before-grant-never-lowers-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        record (driver-for world' \"holder-a\" sources \"v1\")\n        proposed (driver/control-step (driver/program-step (:state record)))\n        stopped (driver/stop proposed)\n        _ (carry! world')\n        _ (judge! world' {:s 2})\n        cleanup (driver/control-step stopped)\n        _ (carry! world')\n        finished (driver/control-step cleanup)]\n    (is (zero? @(:attaches record)))\n    (is (nil? (:machine finished)))\n    (is (= :failed (:phase finished)))\n    (is (= 1 (:proposals finished)))\n    (is (= finished (driver/program-step finished)))\n    (is (false? (driver/owed-control-write? finished)))))\n\n\n(deftest unavailable-inbox-candidate-waits-to-propose-test\n  (doseq [split? [false true] lane [:reply :outcome]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (driver-for world' \"holder-a\" sources \"v1\")\n          key (if (= :reply lane) :reply-inbox :outcome-inbox)\n          validated (driver/program-step (:state record))\n          descriptor (get-in validated [:seams key])\n          unavailable #(assoc-in % [:seams key :read-at!] (constantly {:status :unavailable}))\n          fresh (inbox-obstructed-tick (unavailable validated) split?)\n          proposed (driver/control-step validated)\n          pending (inbox-obstructed-tick (unavailable proposed) split?)\n          waiting (inbox-obstructed-tick pending split?)\n          sent (count (requests-of world' \"holder-a\" :yin.k/proposal))\n          resumed (inbox-obstructed-tick (assoc-in waiting [:seams key] descriptor) split?)\n          requests (requests-of world' \"holder-a\" :yin.k/proposal)]\n      (is (nil? (:proposal fresh)))\n      (is (false? (driver/owed-control-write? fresh)))\n      (is (= :proposing (:phase waiting)))\n      (is (= :inbox-unavailable (:yin.k/reason (:detail waiting))))\n      (is (= (:proposal proposed) (:proposal waiting)))\n      (is (false? (driver/owed-control-write? pending)))\n      (is (false? (driver/owed-control-write? waiting)))\n      (is (= 1 sent))\n      (is (= 2 (count requests)))\n      (is (= 1 (count (distinct requests))))\n      (is (= 1 (:proposals resumed)))\n      (is (true? (driver/owed-control-write? resumed)))\n      (is (zero? @(:attaches record))))))\n\n\n(deftest stopped-candidate-releases-a-late-grant-test\n  (doseq [lane [nil :reply :outcome]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (driver-for world' \"holder-a\" sources \"v1\")\n          key (case lane :reply :reply-inbox :outcome :outcome-inbox nil)\n          proposed (driver/control-step (driver/program-step (:state record)))\n          descriptor (when key (get-in proposed [:seams key]))\n          stopped (cond-> (driver/stop proposed)\n                    key (assoc-in [:seams key :read-at!] (constantly {:status :unavailable})))\n          quiet (driver/control-step stopped)\n          _ (carry! world')\n          _ (judge! world' {:s 2})\n          released (driver/control-step quiet)\n          _ (carry! world')\n          finished (driver/control-step (cond-> released key (assoc-in [:seams key] descriptor)))]\n      (is (false? (driver/owed-control-write? stopped)))\n      (is (false? (driver/owed-control-write? quiet)))\n      (is (= :releasing (:phase released)))\n      (is (= {:cause :stopped} (:detail released)))\n      (is (true? (driver/owed-control-write? released)))\n      (is (= 1 (count (requests-of world' \"holder-a\" :yin.k/release))))\n      (is (= 1 (count (requests-of world' \"holder-a\" :yin.k/proposal))))\n      (is (= 1 (:proposals finished)))\n      (is (= :failed (:phase finished)))\n      (is (true? (get-in finished [:detail :dao.lease/released])))\n      (is (false? (driver/owed-control-write? finished)))\n      (is (nil? (:machine finished)))\n      (is (zero? @(:attaches record)))\n      (is (zero? @(:observations record))))))\n\n\n(deftest mixed-inbox-defers-program-results-in-journal-order-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        accepted (split-grant world' sources)\n        activated (driver/program-step (:state accepted))\n        _ (stream/append! (:prog accepted) :input)\n        requested (driver/program-step activated)\n        _ (carry! world')\n        controlled (driver/control-step requested)\n        machine (:machine requested)\n        deferred (get-in controlled [:inbox :program])]\n    (is (seq defer