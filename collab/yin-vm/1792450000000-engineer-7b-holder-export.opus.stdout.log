6\t  [state]\n2357\t  (advance state :program))\n2358\t\n2359\t\n2360\t(defn step\n2361\t  \"Normal-operation convenience over the shared split machinery, preserving\n2362\t   one renewal and one program cycle per tick. No destructive inbox fallback.\"\n2363\t  [state]\n2364\t  (if (:stopped? state) (control-step state) (advance state :combined)))\n2365\t\n2366\t\n2367\t(defn owed-control-write?\n2368\t  \"Pure total cadence query. Inbound acceptance does not discharge a bracket;\n2369\t   passive ledger waits and uncertain-journal stalls owe no executable write.\"\n2370\t  [state]\n2371\t  (boolean\n2372\t    (and (map? state) (not (:inbox-refused? state))\n2373\t         (not (contains? #{:stalled :failed :exited :aborted :lifted} (:phase state)))\n2374\t         (or (and (= :proposing (:phase state))\n2375\t                  (not (:stopped? state))\n2376\t                  (not (:inbox-unavailable? state))\n2377\t                  (if (:proposal state)\n2378\t                    (not (true? (get-in state [:proposal :carried])))\n2379\t                    (and (not= :yin.k/not-holder (:status state))\n2380\t                         (not= :no-arbitration (get-in state [:detail :yin.k/reason])))))\n2381\t             (some? (:renewal state))\n2382\t             (and (:release state) (not (true? (get-in state [:release :carried]))))\n2383\t             (and (:stopped? state) (:lease state) (nil? (:exit state)) (nil? (:release state)))\n2384\t             (let [cell (or (:exit state) (:export state))\n2385\t                   report-answer (get-in cell [:report :answer])]\n2386\t               (and (:address cell)\n2387\t                    (if (:exit state)\n2388\t                      (or (and (= :yin.k/successor (:role cell))\n2389\t                               (nil? (:offer cell)))\n2390\t                          (nil? report-answer)\n2391\t                          (= :suspended (:yin.k/status report-answer))\n2392\t                          (and report-answer