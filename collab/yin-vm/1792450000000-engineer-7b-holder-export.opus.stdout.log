{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cfz3pwcmQyKkpjEMeF5Ye","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BoBdPkiVFkVjqKDfcoXw6D","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","offset":1,"limit":420},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":625,"cache_read_input_tokens":217487,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":625},"output_tokens":16,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"cd6d7b5e-f7df-4ee0-8ca2-f502da735e26","timestamp":"2026-10-13T10:06:23.476Z","request_id":"req_011Cfz3pwMPxzkWmYMQng3Sz","wire_tool_inputs":{"toolu_01BoBdPkiVFkVjqKDfcoXw6D":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","offset":1,"limit":420}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BoBdPkiVFkVjqKDfcoXw6D","type":"tool_result","content":"1\t(ns yin.vm.ucf.holder.driver-test\n2\t  \"D13 and D14: the custody driver (UCF 7.7.2 to 7.7.8, 7.8, 7.9; r3\n3\t   1.5 to 1.10; the D9 header and D10 lower-inputs rulings; linker-dht\n4\t   14.2.4 rows 2 and 7).  Every checkpoint is a real lift of a real\n5\t   machine the engine parked; every offer, grant, binding, input and\n6\t   admission is the real authority's, reached through the real front\n7\t   over the memory substrate; every lease the driver accepts was\n8\t   granted by the real judge or recorded by the real ledger writer.\n9\t   The composition the driver owes -- the front streams, the ledger\n10\t   reader, the lease clock and, since D14, the progress journal, the\n11\t   content store and the exporter's server -- is supplied as functions\n12\t   and handles over that world.\"\n13\t  (:require [clojure.test :refer [deftest is testing]]\n14\t            [dao.test-slow :as slow]\n15\t            [dao.datom :as datom]\n16\t            [dao.jing :as jing]\n17\t            [dao.jing.cbor :as cbor]\n18\t            [dao.jing.mem :as mem]\n19\t            [dao.lease :as lease]\n20\t            [dao.stream :as stream]\n21\t            [dao.stream.journal :as journal]\n22\t            [dao.stream.memory-log :as memory-log]\n23\t            [dao.stream.ringbuffer :as ringbuffer]\n24\t            [yin.vm :as vm]\n25\t            [yin.vm.engine :as engine]\n26\t            [yin.vm.module :as module]\n27\t            [yin.vm.ucf.authority :as authority]\n28\t            [yin.vm.ucf.authority.admission :as admission]\n29\t            [yin.vm.ucf.authority.completion :as completion]\n30\t            [yin.vm.ucf.authority.front :as front]\n31\t            [yin.vm.ucf.authority.grant :as grant]\n32\t            [yin.vm.ucf.custody :as custody]\n33\t            [yin.vm.ucf.holder.driver :as driver]\n34\t            [yin.vm.ucf.holder.export :as export]\n35\t            [yin.vm.ucf.ledger :as ledger]\n36\t            [yin.vm.ucf.lift-support :as s]))\n37\t\n38\t\n39\t(deftest split-public-entries-test\n40\t  (let [state {:phase :stalled :status :yin.k/unsatisfied}\n41\t        stopped (driver/stop state)]\n42\t    (is (= state (driver/control-step state)))\n43\t    (is (= state (driver/program-step state)))\n44\t    (is (= stopped (driver/stop stopped)))\n45\t    (is (= stopped (driver/program-step stopped)))\n46\t    (is (false? (driver/owed-control-write? state)))\n47\t    (is (false? (driver/owed-control-write? nil)))))\n48\t\n49\t\n50\t(deftest stalled-public-entries-do-not-progress-test\n51\t  (let [state {:phase :stalled :status :yin.k/unsatisfied}]\n52\t    (is (= state (driver/abort state)))\n53\t    (is (= state (driver/enroll state)))\n54\t    (is (= state (driver/hand-off state)))))\n55\t\n56\t\n57\t(deftest journal-fold-keeps-unmatched-retry-intents-test\n58\t  (let [intent {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/offer\n59\t                :yin.k/occurrence \"source\"\n60\t                :yin.k/request {:yin.k/request-id \"offer\"}}\n61\t        attempt {:yin.k/journal :yin.k/attempt :yin.k/action :yin.k/offer\n62\t                 :yin.k/occurrence \"source\" :yin.k/append :dao.stream/full}\n63\t        folded (driver/fold-journal [intent attempt intent])]\n64\t    (is (= [{:append :dao.stream/full} {}] (get-in folded [:attempts \"source\"])))\n65\t    (is (= [intent intent] (:ordered-intents folded)))))\n66\t\n67\t\n68\t(deftest journal-transport-failure-is-not-end-of-history-test\n69\t  (let [handle (reify stream/IDaoStreamReader\n70\t                 (cursor [_ _] {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n71\t\n72\t                 (next [_ _] {:dao.stream/outcome :dao.stream/transport-error}))\n73\t        failure (try (driver/journal-records handle) nil\n74\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n75\t    (is (some? failure))))\n76\t\n77\t\n78\t(deftest journal-gap-and-malformed-records-refuse-test\n79\t  (doseq [value [{:yin.k/journal :unknown} :not-a-record]]\n80\t    (let [reads (atom 0)\n81\t          handle (reify stream/IDaoStreamReader\n82\t                   (cursor\n83\t                     [_ _]\n84\t                     {:dao.stream/outcome :dao.stream/ok\n85\t                      :dao.stream/cursor {:dao.stream.memory-log/identity \"journal\"\n86\t                                          :dao.stream.memory-log/position 0}})\n87\t\n88\t                   (next\n89\t                     [_ _]\n90\t                     (swap! reads inc)\n91\t                     {:dao.stream/outcome :dao.stream/ok\n92\t                      :dao.stream/cursor {:dao.stream.memory-log/identity \"journal\"\n93\t                                          :dao.stream.memory-log/position 2}\n94\t                      :dao.stream/value value}))\n95\t          failure (try (driver/journal-records handle) nil\n96\t                       (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n97\t      (is (some? failure))\n98\t      (is (= 1 @reads)))))\n99\t\n100\t\n101\t(deftest a-known-journal-tag-with-missing-fields-is-not-a-valid-frame-test\n102\t  (let [reads (atom 0)\n103\t        handle (reify stream/IDaoStreamReader\n104\t                 (cursor [_ _] {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n105\t\n106\t                 (next\n107\t                   [_ _]\n108\t                   (if (= 1 (swap! reads inc))\n109\t                     {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 1\n110\t                      :dao.stream/value {:yin.k/journal :yin.k/intent}}\n111\t                     {:dao.stream/outcome :dao.stream/blocked})))\n112\t        failure (try (driver/journal-records handle) nil\n113\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n114\t    (is (some? failure))\n115\t    (is (= 1 @reads))))\n116\t\n117\t\n118\t(def ^:private arb \"arb-d13\")\n119\t\n120\t(def ^:private duration {:s 30})\n121\t\n122\t(def ^:private interval {:s 10})\n123\t\n124\t\n125\t;; =============================================================================\n126\t;; The substrate: rings, logs, and integer-position streams\n127\t;; =============================================================================\n128\t\n129\t(defn- ring\n130\t  [n]\n131\t  (:dao.stream/handle\n132\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n133\t                         ringbuffer/capacity-key n})))\n134\t\n135\t\n136\t(defn- log\n137\t  []\n138\t  (:dao.stream/handle\n139\t    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n140\t\n141\t\n142\t(defn- stream-id\n143\t  [h]\n144\t  (:dao.stream/identity (stream/descriptor h)))\n145\t\n146\t\n147\t(defn- oldest\n148\t  [h]\n149\t  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n150\t\n151\t\n152\t(defn- read-all\n153\t  [h]\n154\t  (loop [c (oldest h) vs []]\n155\t    (let [r (stream/next h c)]\n156\t      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count vs) 1000))\n157\t        (recur (:dao.stream/cursor r) (conj vs (:dao.stream/value r)))\n158\t        vs))))\n159\t\n160\t\n161\t(defn- int-stream\n162\t  \"A stream whose values sit in an atom and whose cursors are plain\n163\t  integer positions, so a position lifted from the source's instance is\n164\t  a valid cursor on the receiving composition's own instance.\"\n165\t  [identity]\n166\t  (let [values (atom [])]\n167\t    (reify\n168\t      stream/IDaoStreamDescriptor\n169\t      (descriptor\n170\t        [_]\n171\t        {:dao.stream/outcome :dao.stream/ok\n172\t         :dao.stream/identity identity\n173\t         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n174\t                                 :dao.stream/identity identity}})\n175\t\n176\t\n177\t      stream/IDaoStreamReader\n178\t\n179\t      (cursor\n180\t        [_ _anchor]\n181\t        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n182\t\n183\t      (next\n184\t        [_ cursor]\n185\t        (let [vs @values]\n186\t          (cond\n187\t            (not (and (integer? cursor) (<= 0 cursor (count vs))))\n188\t            {:dao.stream/outcome :dao.stream/invalid-cursor}\n189\t            (< cursor (count vs))\n190\t            {:dao.stream/outcome :dao.stream/ok\n191\t             :dao.stream/value (nth vs cursor)\n192\t             :dao.stream/cursor (inc cursor)}\n193\t            :else {:dao.stream/outcome :dao.stream/blocked})))\n194\t\n195\t\n196\t      stream/IDaoStreamWriter\n197\t\n198\t      (append!\n199\t        [_ x]\n200\t        (swap! values conj x)\n201\t        {:dao.stream/outcome :dao.stream/ok}))))\n202\t\n203\t\n204\t(defn- bounded-stream\n205\t  \"A stream that answers `full` while `n` or more of its values remain\n206\t  unread, freeing capacity as the reader consumes them: the backpressure\n207\t  a holder's inbound stream gives its front.\"\n208\t  [identity n]\n209\t  (let [st (atom {:values [] :served 0})]\n210\t    (reify\n211\t      stream/IDaoStreamDescriptor\n212\t      (descriptor\n213\t        [_]\n214\t        {:dao.stream/outcome :dao.stream/ok\n215\t         :dao.stream/identity identity\n216\t         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n217\t                                 :dao.stream/identity identity}})\n218\t\n219\t\n220\t      stream/IDaoStreamReader\n221\t\n222\t      (cursor\n223\t        [_ _anchor]\n224\t        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n225\t\n226\t      (next\n227\t        [_ cursor]\n228\t        (let [{:keys [values]} @st]\n229\t          (cond\n230\t            (not (and (integer? cursor) (<= 0 cursor (count values))))\n231\t            {:dao.stream/outcome :dao.stream/invalid-cursor}\n232\t            (< cursor (count values))\n233\t            (do (swap! st update :served max (inc cursor))\n234\t                {:dao.stream/outcome :dao.stream/ok\n235\t                 :dao.stream/value (nth values cursor)\n236\t                 :dao.stream/cursor (inc cursor)})\n237\t            :else {:dao.stream/outcome :dao.stream/blocked})))\n238\t\n239\t\n240\t      stream/IDaoStreamWriter\n241\t\n242\t      (append!\n243\t        [_ x]\n244\t        (let [{:keys [values served]} @st]\n245\t          (if (>= (- (count values) served) n)\n246\t            {:dao.stream/outcome :dao.stream/full}\n247\t            (do (swap! st update :values conj x)\n248\t                {:dao.stream/outcome :dao.stream/ok})))))))\n249\t\n250\t\n251\t(defn- inbox-over\n252\t  \"Complete-retention positional reads over the test log. Reconstructing\n253\t   this descriptor over the same backing data simulates process recovery.\"\n254\t  [handle author]\n255\t  {:version 1\n256\t   :identity (stream-id handle)\n257\t   :read-at! (fn [position]\n258\t               (loop [cursor (oldest handle) remaining position]\n259\t                 (let [answer (stream/next handle cursor)]\n260\t                   (case (:dao.stream/outcome answer)\n261\t                     :dao.stream/ok\n262\t                     (if (zero? remaining)\n263\t                       {:status :record :position position :author author\n264\t                        :record (:dao.stream/value answer)}\n265\t                       (recur (:dao.stream/cursor answer) (dec remaining)))\n266\t                     :dao.stream/blocked {:status :empty}\n267\t                     {:status :unavailable}))))})\n268\t\n269\t\n270\t(defn- attach-over\n271\t  \"A receiving composition's attach dispatch over a fixed table of\n272\t  identity to handle.\"\n273\t  [table]\n274\t  (fn [descriptor]\n275\t    (if-some [h (get table (:dao.stream/identity descriptor))]\n276\t      {:dao.stream/outcome :dao.stream/ok :dao.stream/handle h}\n277\t      {:dao.stream/outcome :dao.stream/not-found})))\n278\t\n279\t\n280\t;; =============================================================================\n281\t;; The source: a real machine, really lifted, and its second encoding\n282\t;; =============================================================================\n283\t\n284\t(def ^:private occurrence \"3d000000-0000-4000-8000-0000000000d1\")\n285\t\n286\t(def ^:private predecessor \"3d000000-0000-4000-8000-0000000000d0\")\n287\t\n288\t\n289\t(defn- arbitration-map\n290\t  []\n291\t  {:dao.stream/identity arb\n292\t   :dao.stream/descriptor {:dao.stream/type :dao.stream/journal}})\n293\t\n294\t\n295\t(defn- header-of\n296\t  ([n] {:yin.k/occurrence occurrence\n297\t        :yin.k/arbitration (arbitration-map)\n298\t        :yin.k/next-op-seq n\n299\t        :yin.k/enrolled #{}})\n300\t  ([n enrolled origin?]\n301\t   (cond-> (assoc (header-of n) :yin.k/enrolled enrolled)\n302\t     origin? (assoc :yin.k/origin {:yin.k/occurrence predecessor\n303\t                                   :dao.lease/lease \"lease-0\"\n304\t                                   :yin.k/emitter \"peer-0\"}))))\n305\t\n306\t\n307\t(defn- parked-reader-over\n308\t  \"A real gated machine over `source`, parked on its first read: one\n309\t  more delivered value and it halts with :done.\"\n310\t  [source]\n311\t  (let [m0 (s/load-ast (s/new-machine)\n312\t                       (s/then {:type :stream/next, :source (s/v 'c)}\n313\t                               (s/lit :done)))\n314\t        [sref m1] (engine/attach-resource m0 source)\n315\t        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)]\n316\t    (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))))\n317\t\n318\t\n319\t(defn- parked-writer-over\n320\t  \"A real gated machine over `target`, parked on one put of `value` to it.\"\n321\t  [target value]\n322\t  (let [m0 (s/load-ast (s/new-machine)\n323\t                       (s/then {:type :stream/put, :target (s/v 'w),\n324\t                                :val (s/lit value)}\n325\t                               (s/lit :done)))\n326\t        [wref m1] (engine/attach-resource m0 target)]\n327\t    (vm/run (assoc m1 :store {'w wref} :yin.k/gate :running))))\n328\t\n329\t\n330\t(defn- serve-as\n331\t  \"The exporter's `serve!`, answering one fixed identity for every\n332\t  handle it is asked about.\"\n333\t  [identity]\n334\t  (fn [_h]\n335\t    {:dao.stream/identity identity\n336\t     :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n337\t                          :dao.stream/identity identity}}))\n338\t\n339\t\n340\t(defn- lift-under\n341\t  \"Enter exporting from `machine`, prepare under `header` with `serve!`,\n342\t  and encode: the bytes, address and body of one real snapshot\n343\t  variant.\"\n344\t  [machine header serve!]\n345\t  (let [e (export/enter machine)]\n346\t    (when-not (= :ok (:status e))\n347\t      (throw (ex-info \"The source did not enter exporting\" e)))\n348\t    (let [p (export/prepare (:machine e) (:record e) serve! header)]\n349\t      (when-not (= :ok (:status p))\n350\t        (throw (ex-info \"The source did not prepare\" (dissoc p :record))))\n351\t      (let [r (export/encode (:machine e) (:record p))]\n352\t        (when-not (= :ok (:status r))\n353\t          (throw (ex-info \"The source did not encode\" (dissoc r :record))))\n354\t        (select-keys r [:bytes :address :body])))))\n355\t\n356\t\n357\t(defn- variant-of\n358\t  \"A second encoding of the occurrence `lifted` names: the same baseline\n359\t  (occurrence, arbitration, counter, carried ids) in different bytes,\n360\t  the way the C4 variant fixtures mutate a base.\"\n361\t  [lifted]\n362\t  (let [bytes (cbor/encode (assoc (:body lifted) :yin.k/id-counter 9))]\n363\t    {:bytes bytes\n364\t     :address (keyword \"segment\"\n365\t                       (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))}))\n366\t\n367\t\n368\t(defn- reader-source\n369\t  \"The reader source of every test: the parked machine (kept, for the\n370\t  source-fence test), its real lift, and a second encoding of the same\n371\t  occurrence.\"\n372\t  []\n373\t  (let [machine (parked-reader-over (int-stream \"prog-r\"))\n374\t        lifted (lift-under machine (header-of 0) (serve-as \"prog-r\"))]\n375\t    {:machine machine\n376\t     :sources {\"v1\" lifted\n377\t               \"v2\" (variant-of lifted)}}))\n378\t\n379\t\n380\t;; =============================================================================\n381\t;; The world: an authority, a judge, and one front per holder\n382\t;; =============================================================================\n383\t\n384\t(defn- records\n385\t  [frames]\n386\t  (mapv #(:dao.stream.journal/value (cbor/decode %)) (rest @frames)))\n387\t\n388\t\n389\t(defn- attributed\n390\t  ([frames] (attributed frames arb))\n391\t  ([frames author] (mapv (fn [r] [author r]) (records frames))))\n392\t\n393\t\n394\t(declare fresh-journal)\n395\t\n396\t\n397\t(defn- world\n398\t  \"A real authority over fresh frames, one front per named holder (its\n399\t  inbound from `:inbound`, a fresh ring by default), a lease-fact\n400\t  medium per holder, a tick log, and a judge wired over every medium.\n401\t  Every source in `sources` (a map of variant name to {:bytes\n402\t  :address}) is offered before one more target is enrolled.\n403\t  `:epoch-bound` lowers the authority's epoch bound for tests.\"\n404\t  [& {:keys [holders sources inbound lease-media epoch-bound]}]\n405\t  (let [frames (atom [(cbor/encode {:dao.stream.journal/header\n406\t                                    {:version 1 :identity arb}})])\n407\t        a (::authority/authority (authority/open!\n408\t                                   (journal/memory-backend frames nil)\n409\t                                   (when (some? epoch-bound)\n410\t                                     {::authority/max-epoch epoch-bound})))\n411\t        store (mem/create-content-mem)\n412\t        ;; the enrolled target comes first, so a source may serve its\n413\t        ;; write target under the target's own identity\n414\t        target (:yin.k/target (authority/enroll! a))\n415\t        _ (doseq [{:keys [bytes address]} (vals sources)]\n416\t            (let [r (grant/offer! a store address bytes \"carrier\")]\n417\t              (when (contains? #{:refused :suspended} (:yin.k/status r))\n418\t                (throw (ex-info \"The world's offer was refused\" r)))))\n419\t        ticks (log)\n420\t        _ (stream/append! ticks (lease/tick {:s 1}))"}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"9b39b25a-fc24-4bb2-8864-3d2d4ee82c8f","timestamp":"2026-10-13T10:06:23.489Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","content":"(ns yin.vm.ucf.holder.driver-test\n  \"D13 and D14: the custody driver (UCF 7.7.2 to 7.7.8, 7.8, 7.9; r3\n   1.5 to 1.10; the D9 header and D10 lower-inputs rulings; linker-dht\n   14.2.4 rows 2 and 7).  Every checkpoint is a real lift of a real\n   machine the engine parked; every offer, grant, binding, input and\n   admission is the real authority's, reached through the real front\n   over the memory substrate; every lease the driver accepts was\n   granted by the real judge or recorded by the real ledger writer.\n   The composition the driver owes -- the front streams, the ledger\n   reader, the lease clock and, since D14, the progress journal, the\n   content store and the exporter's server -- is supplied as functions\n   and handles over that world.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.test-slow :as slow]\n            [dao.datom :as datom]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.admission :as admission]\n            [yin.vm.ucf.authority.completion :as completion]\n            [yin.vm.ucf.authority.front :as front]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.custody :as custody]\n            [yin.vm.ucf.holder.driver :as driver]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.lift-support :as s]))\n\n\n(deftest split-public-entries-test\n  (let [state {:phase :stalled :status :yin.k/unsatisfied}\n        stopped (driver/stop state)]\n    (is (= state (driver/control-step state)))\n    (is (= state (driver/program-step state)))\n    (is (= stopped (driver/stop stopped)))\n    (is (= stopped (driver/program-step stopped)))\n    (is (false? (driver/owed-control-write? state)))\n    (is (false? (driver/owed-control-write? nil)))))\n\n\n(deftest stalled-public-entries-do-not-progress-test\n  (let [state {:phase :stalled :status :yin.k/unsatisfied}]\n    (is (= state (driver/abort state)))\n    (is (= state (driver/enroll state)))\n    (is (= state (driver/hand-off state)))))\n\n\n(deftest journal-fold-keeps-unmatched-retry-intents-test\n  (let [intent {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/offer\n                :yin.k/occurrence \"source\"\n                :yin.k/request {:yin.k/request-id \"offer\"}}\n        attempt {:yin.k/journal :yin.k/attempt :yin.k/action :yin.k/offer\n                 :yin.k/occurrence \"source\" :yin.k/append :dao.stream/full}\n        folded (driver/fold-journal [intent attempt intent])]\n    (is (= [{:append :dao.stream/full} {}] (get-in folded [:attempts \"source\"])))\n    (is (= [intent intent] (:ordered-intents folded)))))\n\n\n(deftest journal-transport-failure-is-not-end-of-history-test\n  (let [handle (reify stream/IDaoStreamReader\n                 (cursor [_ _] {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n                 (next [_ _] {:dao.stream/outcome :dao.stream/transport-error}))\n        failure (try (driver/journal-records handle) nil\n                     (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n    (is (some? failure))))\n\n\n(deftest journal-gap-and-malformed-records-refuse-test\n  (doseq [value [{:yin.k/journal :unknown} :not-a-record]]\n    (let [reads (atom 0)\n          handle (reify stream/IDaoStreamReader\n                   (cursor\n                     [_ _]\n                     {:dao.stream/outcome :dao.stream/ok\n                      :dao.stream/cursor {:dao.stream.memory-log/identity \"journal\"\n                                          :dao.stream.memory-log/position 0}})\n\n                   (next\n                     [_ _]\n                     (swap! reads inc)\n                     {:dao.stream/outcome :dao.stream/ok\n                      :dao.stream/cursor {:dao.stream.memory-log/identity \"journal\"\n                                          :dao.stream.memory-log/position 2}\n                      :dao.stream/value value}))\n          failure (try (driver/journal-records handle) nil\n                       (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n      (is (some? failure))\n      (is (= 1 @reads)))))\n\n\n(deftest a-known-journal-tag-with-missing-fields-is-not-a-valid-frame-test\n  (let [reads (atom 0)\n        handle (reify stream/IDaoStreamReader\n                 (cursor [_ _] {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n                 (next\n                   [_ _]\n                   (if (= 1 (swap! reads inc))\n                     {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 1\n                      :dao.stream/value {:yin.k/journal :yin.k/intent}}\n                     {:dao.stream/outcome :dao.stream/blocked})))\n        failure (try (driver/journal-records handle) nil\n                     (catch #?(:cljd Object :clj Throwable :cljs :default) failure failure))]\n    (is (some? failure))\n    (is (= 1 @reads))))\n\n\n(def ^:private arb \"arb-d13\")\n\n(def ^:private duration {:s 30})\n\n(def ^:private interval {:s 10})\n\n\n;; =============================================================================\n;; The substrate: rings, logs, and integer-position streams\n;; =============================================================================\n\n(defn- ring\n  [n]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key n})))\n\n\n(defn- log\n  []\n  (:dao.stream/handle\n    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n\n\n(defn- stream-id\n  [h]\n  (:dao.stream/identity (stream/descriptor h)))\n\n\n(defn- oldest\n  [h]\n  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n\n\n(defn- read-all\n  [h]\n  (loop [c (oldest h) vs []]\n    (let [r (stream/next h c)]\n      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count vs) 1000))\n        (recur (:dao.stream/cursor r) (conj vs (:dao.stream/value r)))\n        vs))))\n\n\n(defn- int-stream\n  \"A stream whose values sit in an atom and whose cursors are plain\n  integer positions, so a position lifted from the source's instance is\n  a valid cursor on the receiving composition's own instance.\"\n  [identity]\n  (let [values (atom [])]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (let [vs @values]\n          (cond\n            (not (and (integer? cursor) (<= 0 cursor (count vs))))\n            {:dao.stream/outcome :dao.stream/invalid-cursor}\n            (< cursor (count vs))\n            {:dao.stream/outcome :dao.stream/ok\n             :dao.stream/value (nth vs cursor)\n             :dao.stream/cursor (inc cursor)}\n            :else {:dao.stream/outcome :dao.stream/blocked})))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (swap! values conj x)\n        {:dao.stream/outcome :dao.stream/ok}))))\n\n\n(defn- bounded-stream\n  \"A stream that answers `full` while `n` or more of its values remain\n  unread, freeing capacity as the reader consumes them: the backpressure\n  a holder's inbound stream gives its front.\"\n  [identity n]\n  (let [st (atom {:values [] :served 0})]\n    (reify\n      stream/IDaoStreamDescriptor\n      (descriptor\n        [_]\n        {:dao.stream/outcome :dao.stream/ok\n         :dao.stream/identity identity\n         :dao.stream/descriptor {:dao.stream/type :dao.stream.test/channel\n                                 :dao.stream/identity identity}})\n\n\n      stream/IDaoStreamReader\n\n      (cursor\n        [_ _anchor]\n        {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n\n      (next\n        [_ cursor]\n        (let [{:keys [values]} @st]\n          (cond\n            (not (and (integer? cursor) (<= 0 cursor (count values))))\n            {:dao.stream/outcome :dao.stream/invalid-cursor}\n            (< cursor (count values))\n            (do (swap! st update :served max (inc cursor))\n                {:dao.stream/outcome :dao.stream/ok\n                 :dao.stream/value (nth values cursor)\n                 :dao.stream/cursor (inc cursor)})\n            :else {:dao.stream/outcome :dao.stream/blocked})))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (let [{:keys [values served]} @st]\n          (if (>= (- (count values) served) n)\n            {:dao.stream/outcome :dao.stream/full}\n            (do (swap! st update :values conj x)\n                {:dao.stream/outcome :dao.stream/ok})))))))\n\n\n(defn- inbox-over\n  \"Complete-retention positional reads over the test log. Reconstructing\n   this descriptor over the same backing data simulates process recovery.\"\n  [handle author]\n  {:version 1\n   :identity (stream-id handle)\n   :read-at! (fn [position]\n               (loop [cursor (oldest handle) remaining position]\n                 (let [answer (stream/next handle cursor)]\n                   (case (:dao.stream/outcome answer)\n                     :dao.stream/ok\n                     (if (zero? remaining)\n                       {:status :record :position position :author author\n                        :record (:dao.stream/value answer)}\n                       (recur (:dao.stream/cursor answer) (dec remaining)))\n                     :dao.stream/blocked {:status :empty}\n                     {:status :unavailable}))))})\n\n\n(defn- attach-over\n  \"A receiving composition's attach dispatch over a fixed table of\n  identity to handle.\"\n  [table]\n  (fn [descriptor]\n    (if-some [h (get table (:dao.stream/identity descriptor))]\n      {:dao.stream/outcome :dao.stream/ok :dao.stream/handle h}\n      {:dao.stream/outcome :dao.stream/not-found})))\n\n\n;; =============================================================================\n;; The source: a real machine, really lifted, and its second encoding\n;; =============================================================================\n\n(def ^:private occurrence \"3d000000-0000-4000-8000-0000000000d1\")\n\n(def ^:private predecessor \"3d000000-0000-4000-8000-0000000000d0\")\n\n\n(defn- arbitration-map\n  []\n  {:dao.stream/identity arb\n   :dao.stream/descriptor {:dao.stream/type :dao.stream/journal}})\n\n\n(defn- header-of\n  ([n] {:yin.k/occurrence occurrence\n        :yin.k/arbitration (arbitration-map)\n        :yin.k/next-op-seq n\n        :yin.k/enrolled #{}})\n  ([n enrolled origin?]\n   (cond-> (assoc (header-of n) :yin.k/enrolled enrolled)\n     origin? (assoc :yin.k/origin {:yin.k/occurrence predecessor\n                                   :dao.lease/lease \"lease-0\"\n                                   :yin.k/emitter \"peer-0\"}))))\n\n\n(defn- parked-reader-over\n  \"A real gated machine over `source`, parked on its first read: one\n  more delivered value and it halts with :done.\"\n  [source]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/then {:type :stream/next, :source (s/v 'c)}\n                               (s/lit :done)))\n        [sref m1] (engine/attach-resource m0 source)\n        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)]\n    (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))))\n\n\n(defn- parked-writer-over\n  \"A real gated machine over `target`, parked on one put of `value` to it.\"\n  [target value]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/then {:type :stream/put, :target (s/v 'w),\n                                :val (s/lit value)}\n                               (s/lit :done)))\n        [wref m1] (engine/attach-resource m0 target)]\n    (vm/run (assoc m1 :store {'w wref} :yin.k/gate :running))))\n\n\n(defn- serve-as\n  \"The exporter's `serve!`, answering one fixed identity for every\n  handle it is asked about.\"\n  [identity]\n  (fn [_h]\n    {:dao.stream/identity identity\n     :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n                          :dao.stream/identity identity}}))\n\n\n(defn- lift-under\n  \"Enter exporting from `machine`, prepare under `header` with `serve!`,\n  and encode: the bytes, address and body of one real snapshot\n  variant.\"\n  [machine header serve!]\n  (let [e (export/enter machine)]\n    (when-not (= :ok (:status e))\n      (throw (ex-info \"The source did not enter exporting\" e)))\n    (let [p (export/prepare (:machine e) (:record e) serve! header)]\n      (when-not (= :ok (:status p))\n        (throw (ex-info \"The source did not prepare\" (dissoc p :record))))\n      (let [r (export/encode (:machine e) (:record p))]\n        (when-not (= :ok (:status r))\n          (throw (ex-info \"The source did not encode\" (dissoc r :record))))\n        (select-keys r [:bytes :address :body])))))\n\n\n(defn- variant-of\n  \"A second encoding of the occurrence `lifted` names: the same baseline\n  (occurrence, arbitration, counter, carried ids) in different bytes,\n  the way the C4 variant fixtures mutate a base.\"\n  [lifted]\n  (let [bytes (cbor/encode (assoc (:body lifted) :yin.k/id-counter 9))]\n    {:bytes bytes\n     :address (keyword \"segment\"\n                       (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))}))\n\n\n(defn- reader-source\n  \"The reader source of every test: the parked machine (kept, for the\n  source-fence test), its real lift, and a second encoding of the same\n  occurrence.\"\n  []\n  (let [machine (parked-reader-over (int-stream \"prog-r\"))\n        lifted (lift-under machine (header-of 0) (serve-as \"prog-r\"))]\n    {:machine machine\n     :sources {\"v1\" lifted\n               \"v2\" (variant-of lifted)}}))\n\n\n;; =============================================================================\n;; The world: an authority, a judge, and one front per holder\n;; =============================================================================\n\n(defn- records\n  [frames]\n  (mapv #(:dao.stream.journal/value (cbor/decode %)) (rest @frames)))\n\n\n(defn- attributed\n  ([frames] (attributed frames arb))\n  ([frames author] (mapv (fn [r] [author r]) (records frames))))\n\n\n(declare fresh-journal)\n\n\n(defn- world\n  \"A real authority over fresh frames, one front per named holder (its\n  inbound from `:inbound`, a fresh ring by default), a lease-fact\n  medium per holder, a tick log, and a judge wired over every medium.\n  Every source in `sources` (a map of variant name to {:bytes\n  :address}) is offered before one more target is enrolled.\n  `:epoch-bound` lowers the authority's epoch bound for tests.\"\n  [& {:keys [holders sources inbound lease-media epoch-bound]}]\n  (let [frames (atom [(cbor/encode {:dao.stream.journal/header\n                                    {:version 1 :identity arb}})])\n        a (::authority/authority (authority/open!\n                                   (journal/memory-backend frames nil)\n                                   (when (some? epoch-bound)\n                                     {::authority/max-epoch epoch-bound})))\n        store (mem/create-content-mem)\n        ;; the enrolled target comes first, so a source may serve its\n        ;; write target under the target's own identity\n        target (:yin.k/target (authority/enroll! a))\n        _ (doseq [{:keys [bytes address]} (vals sources)]\n            (let [r (grant/offer! a store address bytes \"carrier\")]\n              (when (contains? #{:refused :suspended} (:yin.k/status r))\n                (throw (ex-info \"The world's offer was refused\" r)))))\n        ticks (log)\n        _ (stream/append! ticks (lease/tick {:s 1}))","numLines":420,"startLine":1,"totalLines":4256}},"tool_result_meta":[{"id":"toolu_01BoBdPkiVFkVjqKDfcoXw6D","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
