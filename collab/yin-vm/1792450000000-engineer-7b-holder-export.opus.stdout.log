inc) (apply f args)) n]))\n512\t\n513\t\n514\t(defn- fresh-journal\n515\t  \"A composition-supplied progress journal over fresh frames; the atom\n516\t   is kept, so the same frames reopen.\"\n517\t  []\n518\t  (let [frames (atom [])]\n519\t    {:frames frames\n520\t     :journal (:dao.stream/handle\n521\t                (journal/open! (journal/memory-backend frames nil)))}))\n522\t\n523\t\n524\t(defn- reopened-journal\n525\t  \"A fresh handle over `frames` -- the reopen after a crash.\"\n526\t  [frames]\n527\t  (:dao.stream/handle (journal/open! (journal/memory-backend frames nil))))\n528\t\n529\t\n530\t(defn- cut-backend\n531\t  \"A memory journal backend whose one write at `position` (a frame\n532\t   count) suffers `cut` -- :before-frame or :after-frame-before-visible\n533\t   -- exactly once, the crash windows of an uncertain append.\"\n534\t  [frames position cut]\n535\t  (let [inner (journal/memory-backend frames nil)\n536\t        armed (atom true)]\n537\t    (assoc inner\n538\t           :dao.stream.journal/write-frame!\n539\t           (fn [bs]\n540\t             (if (and @armed (= position (count @frames)))\n541\t               (do (reset! armed false)\n542\t                   (case cut\n543\t                     :before-frame\n544\t                     (throw (ex-info \"cut before the frame\" {}))\n545\t                     :after-frame-before-visible\n546\t                     (do (swap! frames conj bs)\n547\t                         (throw (ex-info \"cut after the frame\" {})))))\n548\t               ((:dao.stream.journal/write-frame! inner) bs))))))\n549\t\n550\t\n551\t(defn- cut-record-backend\n552\t  [frames predicate cut]\n553\t  (let [inner (journal/memory-backend frames nil)\n554\t        armed (atom true)]\n555\t    (assoc inner :dao.stream.journal/write-frame!\n556\t           (fn [bytes]\n557\t             (if (and @armed (predicate (:dao.stream.journal/value (cbor/decode bytes))))\n558\t               (do (reset! armed false)\n559\t                   (when (= :after-frame-before-visible cut) (swap! frames conj bytes))\n560\t                   (throw (ex-info \"simulated journal cut\" {})))\n561\t               ((:dao.stream.journal/write-frame! inner) bytes))))))\n562\t\n563\t\n564\t(defn- driver-for\n565\t  \"The candidate's step state for `holder` over variant `v` of\n566\t  `sources` (or the raw {:keys bytes address]} of `:raw`).  `:ledger`\n567\t  overrides the ledger read, `:protection-as` the protection\n568\t  declaration.  D14's seams -- the journal (fresh frames, kept for a\n569\t  reopen), the world's content store, the exporter's server and the\n570\t  carrier medium -- ride along.\"\n571\t  [w holder sources v & {:keys [ledger protection-as raw attach-table\n572\t                                journal-as]}]\n573\t  (let [{:keys [bytes address]} (or raw (get sources v))\n574\t        _ (assert (some? bytes) \"the variant's bytes\")\n575\t        prog (int-stream \"prog-r\")\n576\t        clock (atom {:s 1})\n577\t        [attach! attaches] (counting\n578\t                             (attach-over (merge {\"prog-r\" prog} attach-table)))\n579\t        [observe! observations] (counting\n580\t                                  (fn [h op arg]\n581\t                                    (case op\n582\t                                      :next (stream/next h arg)\n583\t                                      :cursor (stream/cursor h arg))))\n584\t        diagnostics (log)\n585\t        j (or journal-as (fresh-journal))]\n586\t    {:state (driver/initial\n587\t              {:me holder\n588\t               :bytes bytes\n589\t               :address address\n590\t               :protection (or protection-as {\"prog-r\" :at-least-once})\n591\t               :renewal-interval interval\n592\t               :receiver (s/new-machine)\n593\t               :attach! attach!\n594\t               :append-request! (fn [request]\n595\t                                  (stream/append!\n596\t                                    (get (:inbounds w) holder) request))\n597\t               :reply-inbox (inbox-over (get (:replies w) holder) arb)\n598\t               :outcome-inbox (inbox-over (:outcomes w) arb)\n599\t               :read-ledger! (fn []\n600\t                               (let [rs (attributed (:frames w))]\n601\t                                 (if ledger (ledger rs) rs)))\n602\t               :clock (fn [] @clock)\n603\t               :observe! observe!\n604\t               :append-diagnostic! (fn [d] (stream/append! diagnostics d))\n605\t               :serve! (serve-as \"prog-r\")\n606\t               :journal (:journal j)\n607\t               :store (:store w)\n608\t               :medium \"carrier\"})\n609\t     :clock clock\n610\t     :prog prog\n611\t     :attaches attaches\n612\t     :observations observations\n613\t     :diagnostics diagnostics\n614\t     :journal-frames (:frames j)}))\n615\t\n616\t\n617\t(defn- drive\n618\t  \"Step `d` once, then carry the fronts; with `:judge reading` also run\n619\t  one judge step at that reading.\"\n620\t  [w d & {:keys [judge]}]\n621\t  (let [state (driver/step (:state d))]\n622\t    (carry! w)\n623\t    (when judge (judge! w judge))\n624\t    (assoc d :state state)))\n625\t\n626\t\n627\t(defn- drive-to\n628\t  \"Drive until `pred` holds of the state or `n` steps are spent; asserts\n629\t  the predicate held.\"\n630\t  [w d pred n & {:keys [judge]}]\n631\t  (loop [d d k 0]\n632\t    (let [d' (drive w d :judge judge)]\n633\t      (if (or (pred (:state d')) (>= (inc k) n))\n634\t        (do (is (pred (:state d')) (pr-str (select-keys (:state d') [:phase :status :detail])))\n635\t            d')\n636\t        (recur d' (inc k))))))\n637\t\n638\t\n639\t(defn- phase-of\n640\t  [phase]\n641\t  (fn [state] (= phase (:phase state))))\n642\t\n643\t\n644\t(defn- to-running\n645\t  \"Drive `d` to :running through the judge's own grant.\"\n646\t  [w d]\n647\t  (drive-to w d (phase-of :running) 8 :judge {:s 2}))\n648\t\n649\t\n650\t(defn- own-grant-driver\n651\t  [w sources variant]\n652\t  (let [driver (drive w (drive w (driver-for w \"holder-a\" sources variant)))]\n653\t    (grant-direct! w \"lease-1\" \"holder-a\" (get-in driver [:state :proposal :id]))\n654\t    driver))\n655\t\n656\t\n657\t(defn- split-grant\n658\t  [world' sources]\n659\t  (let [record (driver-for world' \"holder-a\" sources \"v1\")"}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"d62a52fc-65c5-4835-b5f7-4fa5ea0e7be0","timestamp":"2026-10-13T10:20:43.054Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","content":"        _ (stream/append! ticks (lease/tick {:s 1}))\n        media (merge (into {} (map (fn [h] [h (log)])) holders) lease-media)\n        inbounds (into {} (map (fn [h] [h (ring 16)])) holders)\n        inbounds (merge inbounds (select-keys inbound holders))\n        identities (into {} (map (fn [[h r]] [h (stream-id r)])) inbounds)\n        resolver (fn [identity _]\n                   (some (fn [[h i]] (when (= identity i) h)) identities))\n        reply-journals (into {} (map (fn [holder] [holder (fresh-journal)])) holders)\n        replies (into {} (map (fn [[holder entry]] [holder (:journal entry)])) reply-journals)\n        fronts (into {}\n                     (map (fn [h]\n                            [h (atom (front/front\n                                       {:authority a\n                                        :inbound (get inbounds h)\n                                        :reply (get replies h)\n                                        :diagnostics (log)\n                                        :resolver resolver\n                                        :store store\n                                        :lease-media media}))]))\n                     holders)\n        judge (atom (reduce (fn [j h]\n                              (lease/wire-facts j (get media h)\n                                                (oldest (get media h)) h))\n                            (-> (lease/initial-judge\n                                  (merge (grant/judge-config a duration)\n                                         {:resolver (fn [source _] source)\n                                          :self arb}))\n                                (lease/wire-tick ticks (oldest ticks) :ticks))\n                            holders))]\n    {:frames frames\n     :a a\n     :store store\n     :target target\n     :media media\n     :inbounds inbounds\n     :replies replies\n     :reply-frames (into {} (map (fn [[holder entry]] [holder (:frames entry)])) reply-journals)\n     :fronts fronts\n     :judge judge\n     :ticks ticks\n     :outcomes (admission/outcome-reader a)}))\n\n\n(defn- inbound\n  [w holder]\n  (read-all (get (:inbounds w) holder)))\n\n\n(defn- requests-of\n  [w holder kind]\n  (filter #(= kind (:yin.k/request %)) (inbound w holder)))\n\n\n(defn- carry!\n  \"Step every front past up to 16 requests.\"\n  [w]\n  (doseq [f (vals (:fronts w))]\n    (swap! f front/step 16))\n  w)\n\n\n(defn- judge!\n  \"Advance the tick log one reading and run one judge step.\"\n  [w reading]\n  (stream/append! (:ticks w) (lease/tick reading))\n  (swap! (:judge w) #(grant/step! (:a w) %))\n  w)\n\n\n(defn- grant-direct!\n  \"Record a grant of `l` to `holder` answering `pid`, through the\n  authority's own ledger writer (the judge's writer path).\"\n  [w l holder pid]\n  (stream/append! (grant/writer (:a w))\n                  (lease/grant l (custody/subject occurrence) holder duration\n                               {:dao.lease/proposal pid})))\n\n\n(defn- lapse-direct!\n  [w l cause]\n  (stream/append! (grant/writer (:a w)) (lease/lapsed l cause)))\n\n\n;; =============================================================================\n;; The driver over the world\n;; =============================================================================\n\n(defn- counting\n  \"[calls answers] over one counting fn.\"\n  [f]\n  (let [n (atom 0)]\n    [(fn [& args] (swap! n inc) (apply f args)) n]))\n\n\n(defn- fresh-journal\n  \"A composition-supplied progress journal over fresh frames; the atom\n   is kept, so the same frames reopen.\"\n  []\n  (let [frames (atom [])]\n    {:frames frames\n     :journal (:dao.stream/handle\n                (journal/open! (journal/memory-backend frames nil)))}))\n\n\n(defn- reopened-journal\n  \"A fresh handle over `frames` -- the reopen after a crash.\"\n  [frames]\n  (:dao.stream/handle (journal/open! (journal/memory-backend frames nil))))\n\n\n(defn- cut-backend\n  \"A memory journal backend whose one write at `position` (a frame\n   count) suffers `cut` -- :before-frame or :after-frame-before-visible\n   -- exactly once, the crash windows of an uncertain append.\"\n  [frames position cut]\n  (let [inner (journal/memory-backend frames nil)\n        armed (atom true)]\n    (assoc inner\n           :dao.stream.journal/write-frame!\n           (fn [bs]\n             (if (and @armed (= position (count @frames)))\n               (do (reset! armed false)\n                   (case cut\n                     :before-frame\n                     (throw (ex-info \"cut before the frame\" {}))\n                     :after-frame-before-visible\n                     (do (swap! frames conj bs)\n                         (throw (ex-info \"cut after the frame\" {})))))\n               ((:dao.stream.journal/write-frame! inner) bs))))))\n\n\n(defn- cut-record-backend\n  [frames predicate cut]\n  (let [inner (journal/memory-backend frames nil)\n        armed (atom true)]\n    (assoc inner :dao.stream.journal/write-frame!\n           (fn [bytes]\n             (if (and @armed (predicate (:dao.stream.journal/value (cbor/decode bytes))))\n               (do (reset! armed false)\n                   (when (= :after-frame-before-visible cut) (swap! frames conj bytes))\n                   (throw (ex-info \"simulated journal cut\" {})))\n               ((:dao.stream.journal/write-frame! inner) bytes))))))\n\n\n(defn- driver-for\n  \"The candidate's step state for `holder` over variant `v` of\n  `sources` (or the raw {:keys bytes address]} of `:raw`).  `:ledger`\n  overrides the ledger read, `:protection-as` the protection\n  declaration.  D14's seams -- the journal (fresh frames, kept for a\n  reopen), the world's content store, the exporter's server and the\n  carrier medium -- ride along.\"\n  [w holder sources v & {:keys [ledger protection-as raw attach-table\n                                journal-as]}]\n  (let [{:keys [bytes address]} (or raw (get sources v))\n        _ (assert (some? bytes) \"the variant's bytes\")\n        prog (int-stream \"prog-r\")\n        clock (atom {:s 1})\n        [attach! attaches] (counting\n                             (attach-over (merge {\"prog-r\" prog} attach-table)))\n        [observe! observations] (counting\n                                  (fn [h op arg]\n                                    (case op\n                                      :next (stream/next h arg)\n                                      :cursor (stream/cursor h arg))))\n        diagnostics (log)\n        j (or journal-as (fresh-journal))]\n    {:state (driver/initial\n              {:me holder\n               :bytes bytes\n               :address address\n               :protection (or protection-as {\"prog-r\" :at-least-once})\n               :renewal-interval interval\n               :receiver (s/new-machine)\n               :attach! attach!\n               :append-request! (fn [request]\n                                  (stream/append!\n                                    (get (:inbounds w) holder) request))\n               :reply-inbox (inbox-over (get (:replies w) holder) arb)\n               :outcome-inbox (inbox-over (:outcomes w) arb)\n               :read-ledger! (fn []\n                               (let [rs (attributed (:frames w))]\n                                 (if ledger (ledger rs) rs)))\n               :clock (fn [] @clock)\n               :observe! observe!\n               :append-diagnostic! (fn [d] (stream/append! diagnostics d))\n               :serve! (serve-as \"prog-r\")\n               :journal (:journal j)\n               :store (:store w)\n               :medium \"carrier\"})\n     :clock clock\n     :prog prog\n     :attaches attaches\n     :observations observations\n     :diagnostics diagnostics\n     :journal-frames (:frames j)}))\n\n\n(defn- drive\n  \"Step `d` once, then carry the fronts; with `:judge reading` also run\n  one judge step at that reading.\"\n  [w d & {:keys [judge]}]\n  (let [state (driver/step (:state d))]\n    (carry! w)\n    (when judge (judge! w judge))\n    (assoc d :state state)))\n\n\n(defn- drive-to\n  \"Drive until `pred` holds of the state or `n` steps are spent; asserts\n  the predicate held.\"\n  [w d pred n & {:keys [judge]}]\n  (loop [d d k 0]\n    (let [d' (drive w d :judge judge)]\n      (if (or (pred (:state d')) (>= (inc k) n))\n        (do (is (pred (:state d')) (pr-str (select-keys (:state d') [:phase :status :detail])))\n            d')\n        (recur d' (inc k))))))\n\n\n(defn- phase-of\n  [phase]\n  (fn [state] (= phase (:phase state))))\n\n\n(defn- to-running\n  \"Drive `d` to :running through the judge's own grant.\"\n  [w d]\n  (drive-to w d (phase-of :running) 8 :judge {:s 2}))\n\n\n(defn- own-grant-driver\n  [w sources variant]\n  (let [driver (drive w (drive w (driver-for w \"holder-a\" sources variant)))]\n    (grant-direct! w \"lease-1\" \"holder-a\" (get-in driver [:state :proposal :id]))\n    driver))\n\n\n(defn- split-grant\n  [world' sources]\n  (let [record (driver-for world' \"holder-a\" sources \"v1\")","numLines":240,"startLine":420,"totalLines":4256}},"tool_result_meta":[{"id":"toolu_01VruSFeGoHuMiaTMPjpp3hJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
