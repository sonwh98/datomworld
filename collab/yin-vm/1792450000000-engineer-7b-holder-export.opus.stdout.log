\"The source did not enter exporting\" e)))\n    (let [p (export/prepare (:machine e) (:record e) serve! header (index))]\n      (when-not (= :ok (:status p))\n        (throw (ex-info \"The source did not prepare\" (dissoc p :record))))\n      (let [r (export/encode (:machine e) (:record p))]\n        (when-not (= :ok (:status r))\n          (throw (ex-info \"The source did not encode\" (dissoc r :record))))\n        (select-keys r [:bytes :address :root])))))\n\n\n(defn- address-of\n  [bytes]\n  (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bytes))))\n\n\n(defn- variant-of\n  \"A second encoding of the occurrence `lifted` names: the same root and\n  baseline in other bytes -- its rows in another order, which the reader\n  accepts and `emit` never makes (phase-7a D2: a different root is a\n  conflicting variant, not an equal one).\"\n  [lifted]\n  (let [bytes (cbor/encode (update (cbor/decode (:bytes lifted)) :yin.k/rows (comp vec reverse)))]\n    {:bytes bytes\n     :address (address-of bytes)}))"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1792,"cache_read_input_tokens":380849,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1792},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"39202a6c-14e1-4483-9653-0ce2a737b2eb","timestamp":"2026-10-13T10:21:10.473Z","request_id":"req_011Cfz4wQSqs9qi1yWxo8zdE","wire_tool_inputs":{"toolu_01XvjjNBmTi9QmdePkrxJXGr":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/driver_test.cljc","old_string":"(defn- lift-under\n  \"Enter exporting from `machine`, prepare under `header` with `serve!`,\n  and encode: the bytes, address and body of one real snapshot\n  variant.\"\