{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cfz3cECYKbykFdbV9sxn2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MEXH53WyESMLkd3UCJ1Txo","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/src/cljc/yin/vm/ucf/holder/driver.cljc","offset":330,"limit":820},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4357,"cache_read_input_tokens":128583,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4357},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"7ee3c1a1-1a21-4bcd-a0ac-0284bb042837","timestamp":"2026-10-13T10:03:31.368Z","request_id":"req_011Cfz3cDwB2BU4po6N2AXYE","wire_tool_inputs":{"toolu_01MEXH53WyESMLkd3UCJ1Txo":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7b/src/cljc/yin/vm/ucf/holder/driver.cljc","offset":330,"limit":820}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MEXH53WyESMLkd3UCJ1Txo","type":"tool_result","content":"330\t    (check! (map? machine) \"the machine to export\" {})\n331\t    (check! (not (contains? machine :yin.k/custody))\n332\t            \"a machine that holds no custody: a holder exports through hand-off\"\n333\t            {})\n334\t    (check! (or (nil? (:arbitration config))\n335\t                (and (map? (:arbitration config))\n336\t                     (some? (get-in config\n337\t                                    [:arbitration :dao.stream/identity]))))\n338\t            \"an arbitration medium: a map naming the identity, or nil for the fork\"\n339\t            {:arbitration (:arbitration config)})\n340\t    (check-common! config units)\n341\t    (restore-inbox (assoc (bare-state config units)\n342\t                          :phase :exporting\n343\t                          :bytes nil\n344\t                          :address nil\n345\t                          :arbitration (get-in config [:arbitration :dao.stream/identity])\n346\t                          :export {:role (if (some? (:arbitration config))\n347\t                                           :yin.k/first nil)\n348\t                                   :machine machine\n349\t                                   :arbitration (:arbitration config)})\n350\t                   (:inbox (fold-journal (journal-records (:journal config)))))))\n351\t\n352\t\n353\t(defn- append-request!\n354\t  [state request]\n355\t  ((get-in state [:seams :append-request!]) request))\n356\t\n357\t\n358\t(defn- read-ledger!\n359\t  [state]\n360\t  ((get-in state [:seams :read-ledger!])))\n361\t\n362\t\n363\t(defn- clock\n364\t  [state]\n365\t  ((get-in state [:seams :clock])))\n366\t\n367\t\n368\t(defn- observe!\n369\t  [state handle op arg]\n370\t  ((get-in state [:seams :observe!]) handle op arg))\n371\t\n372\t\n373\t(defn- append-diagnostic!\n374\t  [state diagnostic]\n375\t  ((get-in state [:seams :append-diagnostic!]) diagnostic))\n376\t\n377\t\n378\t(defn- serve!\n379\t  [state handle]\n380\t  ((get-in state [:seams :serve!]) handle))\n381\t\n382\t\n383\t(defn- enroll!\n384\t  [state]\n385\t  ((get-in state [:seams :enroll!])))\n386\t\n387\t\n388\t(defn- journal-of\n389\t  [state]\n390\t  (get-in state [:seams :journal]))\n391\t\n392\t\n393\t;; =============================================================================\n394\t;; The progress journal (r3 1.10): write-ahead, plain-data records\n395\t;; =============================================================================\n396\t\n397\t(defn journal!\n398\t  \"Append one `record` to the composition's progress journal.  A\n399\t   transport-error is the journal's own uncertain answer -- a failure\n400\t   between write and visibility poisons its appends -- and unwinds as\n401\t   ::journal-uncertain, which `step` answers by stalling everything\n402\t   until the composition reopens the journal and reconciles.  Any other\n403\t   non-ok answer is a defect of the record's shape and throws.\"\n404\t  [state record]\n405\t  (let [o (stream/append! (journal-of state) record)]\n406\t    (when-not (= :dao.stream/ok (:dao.stream/outcome o))\n407\t      (if (= :dao.stream/transport-error (:dao.stream/outcome o))\n408\t        (throw (ex-info \"The progress journal append is uncertain\"\n409\t                        {::journal-uncertain true}))\n410\t        (throw (ex-info \"The progress journal refused a record\"\n411\t                        {::journal-defect (:dao.stream/outcome o)\n412\t                         :record record}))))))\n413\t\n414\t\n415\t(defn- stalled\n416\t  [state]\n417\t  (assoc state :phase :stalled\n418\t         :status :yin.k/unsatisfied\n419\t         :detail {:yin.k/reason :journal-uncertain}))\n420\t\n421\t\n422\t(defn- progress-record?\n423\t  [record]\n424\t  (let [action (:yin.k/action record)\n425\t        actions #{:yin.k/offer :yin.k/proposal :yin.k/resumed :yin.k/release\n426\t                  :yin.k/enroll :yin.k/serve :yin.k/store :yin.k/renewal}]\n427\t    (and (map? record)\n428\t         (case (:yin.k/journal record)\n429\t           :yin.k/minted (and (some? (:yin.k/occurrence record))\n430\t                              (map? (:yin.k/header record))\n431\t                              (contains? #{:yin.k/first :yin.k/successor :yin.k/result}\n432\t                                         (:yin.k/role record)))\n433\t           :yin.k/fenced (and (some? (:yin.k/occurrence record))\n434\t                              (keyword? (:yin.k/address record)) (keyword? (:yin.k/record record)))\n435\t           :yin.k/aborted (some? (:yin.k/occurrence record))\n436\t           :yin.k/inbox (inbox/retention? record)\n437\t           :yin.k/intent (and (contains? actions action)\n438\t                              (if (= :yin.k/enroll action)\n439\t                                (some? (:yin.k/derived record))\n440\t                                (and (map? (:yin.k/request record))\n441\t                                     (some? (get-in record [:yin.k/request :yin.k/request-id])))))\n442\t           :yin.k/attempt (and (contains? actions action) (contains? record :yin.k/append))\n443\t           :yin.k/ack (case action\n444\t                        :yin.k/grant (and (some? (:yin.k/occurrence record))\n445\t                                          (some? (:dao.lease/lease record)))\n446\t                        :yin.k/enroll (some? (:yin.k/target record))\n447\t                        (and (contains? actions action) (some? (:yin.k/request-id record))\n448\t                             (map? (:yin.k/answer record))))\n449\t           false))))\n450\t\n451\t\n452\t(defn journal-records\n453\t  \"Every record of journal handle `j`, from the origin: the whole\n454\t   durable history a reopen folds.\"\n455\t  [j]\n456\t  (let [origin (stream/cursor j :dao.stream/oldest)]\n457\t    (check! (= :dao.stream/ok (:dao.stream/outcome origin)) \"journal origin\" origin)\n458\t    (loop [cursor (:dao.stream/cursor origin) records []]\n459\t      (let [answer (stream/next j cursor)]\n460\t        (case (:dao.stream/outcome answer)\n461\t          :dao.stream/ok\n462\t          (do\n463\t            (check! (and (contains? answer :dao.stream/cursor)\n464\t                         (not= cursor (:dao.stream/cursor answer))\n465\t                         (or (not (map? cursor))\n466\t                             (and (= (:dao.stream.memory-log/identity cursor)\n467\t                                     (get-in answer [:dao.stream/cursor :dao.stream.memory-log/identity]))\n468\t                                  (integer? (:dao.stream.memory-log/position cursor))\n469\t                                  (= (inc (:dao.stream.memory-log/position cursor))\n470\t                                     (get-in answer [:dao.stream/cursor :dao.stream.memory-log/position]))))\n471\t                         (progress-record? (:dao.stream/value answer)))\n472\t                    \"journal frame\" answer)\n473\t            (recur (:dao.stream/cursor answer) (conj records (:dao.stream/value answer))))\n474\t          :dao.stream/blocked records\n475\t          (throw (ex-info \"Journal history unavailable\" {:yin.k/reason :journal-unavailable\n476\t                                                         :answer answer})))))))\n477\t\n478\t\n479\t(defn fold-journal\n480\t  \"The driver's projection of its progress journal: what was minted and\n481\t   fenced, which external actions were intended, attempted and\n482\t   acknowledged, and which grant was accepted.  The records are the\n483\t   driver's own grammar, plain data under `:yin.k/journal`:\n484\t\n485\t     {:yin.k/journal :yin.k/minted :yin.k/role r :yin.k/occurrence O\n486\t      :yin.k/header h}\n487\t     {:yin.k/journal :yin.k/fenced :yin.k/occurrence O\n488\t      :yin.k/address A :yin.k/record RA}\n489\t     {:yin.k/journal :yin.k/intent :yin.k/action a :yin.k/occurrence O\n490\t      :yin.k/request req :yin.k/bytes-at A}   ; offer, proposal, resumed,\n491\t                                              ; release, enroll (no\n492\t                                              ; request identity)\n493\t     {:yin.k/journal :yin.k/attempt :yin.k/action :yin.k/offer\n494\t      :yin.k/occurrence O :yin.k/append outcome}\n495\t     {:yin.k/journal :yin.k/ack :yin.k/action a :yin.k/occurrence O\n496\t      :yin.k/request-id rid :yin.k/answer ans}  ; or :yin.k/grant, which\n497\t                                                ; carries the lease\n498\t\n499\t   The fold answers\n500\t\n501\t     {:mint        the last minted occurrence's data, or nil\n502\t      :fences      occurrence to {:address A :record RA}\n503\t      :intents     request-id to the last intent record of that id\n504\t      :acked       the request-ids whose acknowledgment stands\n505\t      :answers     request-id to the authenticated answer\n506\t      :attempts    occurrence to the offer attempts, {:append o} each\n507\t      :offered     the occurrences whose offer intent stands\n508\t      :grant       {:yin.k/occurrence O :dao.lease/lease l}, or nil}\"\n509\t  [records]\n510\t  (reduce\n511\t    (fn [f [index record]]\n512\t      (case (get record :yin.k/journal)\n513\t        :yin.k/inbox\n514\t        (update f :inbox inbox/retain record)\n515\t        :yin.k/minted\n516\t        (assoc f :mint {:role (get record :yin.k/role)\n517\t                        :index index\n518\t                        :occurrence (get record :yin.k/occurrence)\n519\t                        :header (get record :yin.k/header)})\n520\t        :yin.k/fenced\n521\t        (assoc-in f [:fences (get record :yin.k/occurrence)]\n522\t                  {:address (get record :yin.k/address)\n523\t                   :record (get record :yin.k/record)})\n524\t        :yin.k/aborted\n525\t        (assoc-in f [:aborted (:yin.k/occurrence record)] {:index index})\n526\t        :yin.k/intent\n527\t        (let [rid (get-in record [:yin.k/request :yin.k/request-id])]\n528\t          (-> f\n529\t              (update :intents assoc rid record)\n530\t              (update :ordered-intents conj record)\n531\t              (cond-> (= :yin.k/enroll (get record :yin.k/action))\n532\t                (assoc :enroll {:derived (:yin.k/derived record)}))\n533\t              (cond-> (= :yin.k/offer (get record :yin.k/action))\n534\t                (update :offered conj (get record :yin.k/occurrence))\n535\t                (= :yin.k/offer (get record :yin.k/action))\n536\t                (update-in [:attempts (get record :yin.k/occurrence)] (fnil conj []) {}))))\n537\t        :yin.k/ack\n538\t        (cond\n539\t          (= :yin.k/enroll (get record :yin.k/action))\n540\t          (assoc f :enroll {:target (:yin.k/target record)})\n541\t\n542\t          (= :yin.k/grant (get record :yin.k/action))\n543\t          (assoc f :grant {:occurrence (get record :yin.k/occurrence)\n544\t                           :index index\n545\t                           :lease (get record :dao.lease/lease)})\n546\t          :else\n547\t          (let [rid (get record :yin.k/request-id)]\n548\t            (-> f\n549\t                (update :acked (fnil conj #{}) rid)\n550\t                (update :answers assoc rid record))))\n551\t        :yin.k/attempt\n552\t        (if (= :yin.k/offer (:yin.k/action record))\n553\t          (update-in f [:attempts (get record :yin.k/occurrence)]\n554\t                     (fn [attempts]\n555\t                       (check! (seq attempts) \"attempt with durable intent\" record)\n556\t                       (assoc attempts (dec (count attempts))\n557\t                              {:append (get record :yin.k/append)})))\n558\t          (update f :action-attempts (fnil conj []) record))\n559\t        f))\n560\t    {:mint nil :fences {} :intents {} :ordered-intents [] :acked #{} :answers {}\n561\t     :attempts {} :offered #{} :grant nil :inbox []}\n562\t    (map-indexed vector records)))\n563\t\n564\t\n565\t(defn- offered-attempts\n566\t  \"The journaled offer attempts of `occurrence` (r3 1.9): one per\n567\t   attempt whose intent was durable before the send, `:append` the\n568\t   outcome its append answered -- absent when none did.  An intent with\n569\t   no attempt record is one send of unknown outcome.\"\n570\t  [folded occurrence]\n571\t  (let [sent (get-in folded [:attempts occurrence])]\n572\t    (if (and (contains? (:offered folded) occurrence)\n573\t             (empty? sent))\n574\t      [{}]\n575\t      (or sent []))))\n576\t\n577\t\n578\t(defn- intent-of\n579\t  \"The last intent record of `action` for `occurrence`, or nil.\"\n580\t  [folded action occurrence]\n581\t  (some (fn [record]\n582\t          (when (and (= action (get record :yin.k/action))\n583\t                     (or (nil? occurrence)\n584\t                         (= occurrence (get record :yin.k/occurrence))))\n585\t            record))\n586\t        (reverse (:ordered-intents folded))))\n587\t\n588\t\n589\t;; =============================================================================\n590\t;; The content store: the prepared record and the body bytes (r3 1.10)\n591\t;; =============================================================================\n592\t\n593\t(defn- store-put!\n594\t  \"Put `bytes` at `address` in the composition's content store: true\n595\t   once it holds them, false when the store refused or threw.\"\n596\t  [state address bytes]\n597\t  (try\n598\t    (contains? #{:inserted :present}\n599\t               ((:put-bytes-fn (get-in state [:seams :content-store])) address bytes))\n600\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n601\t      false)))\n602\t\n603\t\n604\t(defn- store-get\n605\t  \"The bytes the composition's content store holds at `address`, or nil.\"\n606\t  [state address]\n607\t  (try\n608\t    (let [v ((:get-bytes-fn (get-in state [:seams :content-store]))\n609\t             address ::absent)]\n610\t      (when-not (= ::absent v) v))\n611\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n612\t      nil)))\n613\t\n614\t\n615\t;; =============================================================================\n616\t;; The task tree and the gate\n617\t;; =============================================================================\n618\t\n619\t(defn- machines\n620\t  \"`[path machine]` of the root and, recursively, each install child,\n621\t   children in install-name order.\"\n622\t  [root]\n623\t  (letfn [(walk\n624\t            [prefix m]\n625\t            (concat [[prefix m]]\n626\t                    (mapcat (fn [name]\n627\t                              (when-some [child (:vm (get (:installs m) name))]\n628\t                                (walk (into prefix [:installs name :vm])\n629\t                                      child)))\n630\t                            (sort-by str (keys (:installs m))))))]\n631\t    (walk [] root)))\n632\t\n633\t\n634\t(defn- ended\n635\t  \"`machine` gated `:ended` at the root and at every install child: the\n636\t   root owns the mode, and nothing applies a late result after it.\"\n637\t  [machine]\n638\t  (reduce (fn [m [prefix _]]\n639\t            (assoc-in m (conj prefix :yin.k/gate) :ended))\n640\t          (assoc machine :yin.k/gate :ended)\n641\t          (machines machine)))\n642\t\n643\t\n644\t;; =============================================================================\n645\t;; The ledger read: whole history, fold, and the raw grant\n646\t;; =============================================================================\n647\t\n648\t(defn- mine\n649\t  \"The records `records` attributes to the arbitration identity.\"\n650\t  [arbitration records]\n651\t  (filter #(= arbitration (first %)) records))\n652\t\n653\t\n654\t(defn- transport-error?\n655\t  [record]\n656\t  (and (map? record) (contains? record :dao.stream/outcome)))\n657\t\n658\t\n659\t(defn- history-defect\n660\t  \"Why `records` is not a whole history read from the origin -- a\n661\t   transport error, a start past the origin, a gap, or a fold defect --\n662\t   or nil when they are dense from zero.  The same rule D3's reader\n663\t   applies before any evidence is derived.\"\n664\t  [records]\n665\t  (loop [rs (seq records) n 0]\n666\t    (if-not rs\n667\t      nil\n668\t      (let [record (second (first rs))]\n669\t        (cond\n670\t          (transport-error? record) :transport-error\n671\t          :else\n672\t          (let [t (get-in record [:dao.space/transaction :t])]\n673\t            (cond\n674\t              (not (custody/exact? t)) :fold-defect\n675\t              (= t n) (recur (next rs) (inc n))\n676\t              (> t n) (if (zero? n) :start-past-origin :gap)\n677\t              :else :fold-defect)))))))\n678\t\n679\t\n680\t(defn- fold\n681\t  \"The projection of the arbitration's `records`, or nil when they do\n682\t   not fold whole -- the same fold D3's reader runs.\"\n683\t  [arbitration records]\n684\t  (loop [p (ledger/empty-projection arbitration)\n685\t         rs (seq records)]\n686\t    (if-not rs\n687\t      p\n688\t      (let [p' (ledger/fold-record p (second (first rs)))]\n689\t        (if (::ledger/defect p')\n690\t          nil\n691\t          (recur p' (next rs)))))))\n692\t\n693\t\n694\t(defn- record-facts\n695\t  \"The fact maps of one transaction record, entities in first-appearance\n696\t   order -- the raw datoms grouped, with no fold run over them.\"\n697\t  [record]\n698\t  (let [datoms (get-in record [:dao.space/transaction :datoms])]\n699\t    (when (vector? datoms)\n700\t      (mapv (fn [entity]\n701\t              (into {} (keep (fn [[other attribute value]]\n702\t                               (when (= entity other) [attribute value])) datoms)))\n703\t            (distinct (map first datoms))))))\n704\t\n705\t\n706\t(defn- grants-to\n707\t  \"The accepted facts, in record order, granted to `me` on `occurrence`\n708\t   among the arbitration's records -- read raw, before any fold: the\n709\t   grant this driver observes is its own, and a history too corrupt to\n710\t   fold cannot hide it (the binding check that follows is what\n711\t   authenticates it).\"\n712\t  [arbitration me occurrence records]\n713\t  (into []\n714\t        (comp (filter #(= arbitration (first %)))\n715\t              (mapcat (fn [[_ record]] (record-facts record)))\n716\t              (filter #(and (= :dao.lease/accepted (:dao.lease/status %))\n717\t                            (= me (:dao.lease/holder %))\n718\t                            (= (custody/subject occurrence)\n719\t                               (:dao.lease/subject %)))))\n720\t        records))\n721\t\n722\t\n723\t(defn- occurrence-state\n724\t  \"The lease state observed for `occurrence` in `projection`: what a\n725\t   `:yin.k/not-holder` answer carries (7.9).\"\n726\t  [projection occurrence]\n727\t  (let [entry (get-in projection [:occurrences occurrence])\n728\t        l (:dao.lease/lease entry)]\n729\t    (cond-> {:yin.k/occurrence occurrence\n730\t             :dao.lease/lease l\n731\t             :yin.k/epoch (:yin.k/epoch entry)\n732\t             :yin.k/admitted (:yin.k/variants entry)}\n733\t      (some? l) (assoc :dao.lease/holder\n734\t                       (get-in projection [:leases l :dao.lease/holder]))\n735\t      (:yin.k/quarantined entry) (assoc :yin.k/quarantined true)\n736\t      (:yin.k/closed entry) (assoc :yin.k/closed true)\n737\t      (:yin.k/exhausted entry) (assoc :yin.k/exhausted true))))\n738\t\n739\t\n740\t(defn- never-granted-again?\n741\t  \"True when the occurrence can never be granted again: closed,\n742\t   exhausted or quarantined.\"\n743\t  [entry]\n744\t  (boolean (or (:yin.k/closed entry)\n745\t               (:yin.k/exhausted entry)\n746\t               (:yin.k/quarantined entry))))\n747\t\n748\t\n749\t;; =============================================================================\n750\t;; The answers the step state carries\n751\t;; =============================================================================\n752\t\n753\t(defn- with-status\n754\t  [state status detail]\n755\t  (assoc state :status status :detail detail))\n756\t\n757\t\n758\t(defn- unsatisfied\n759\t  ([state reason] (unsatisfied state reason nil))\n760\t  ([state reason data]\n761\t   (with-status state :yin.k/unsatisfied\n762\t     (cond-> {:yin.k/reason reason}\n763\t       (map? data) (merge data)))))\n764\t\n765\t\n766\t(defn- failed\n767\t  \"A terminal refusal no cleanup is owed for: before custody, none.\"\n768\t  [state refusal]\n769\t  (assoc state :phase :failed\n770\t         :status (:yin.k/status refusal)\n771\t         :detail (dissoc refusal :yin.k/status)))\n772\t\n773\t\n774\t(def ^:private invalid-binding\n775\t  \"custody/binding-evidence's no-evidence reasons that make the binding\n776\t   of a grant to this driver invalid -- as against a history that is\n777\t   merely unavailable.\"\n778\t  #{:no-binding :duplicate-binding :inexact-epoch\n779\t    :not-in-grant-transaction :grant-mismatch})\n780\t\n781\t\n782\t;; =============================================================================\n783\t;; The export half (r3 1.8 and 1.9; the D9 ruling): mint, prepare,\n784\t;; fence, offer\n785\t;; =============================================================================\n786\t\n787\t;; The candidate loop's reply drain and the release request live below,\n788\t;; with the halves that own them; the export and exit halves step\n789\t;; through both.\n790\t(declare drain-control release-request require-tenure! releasing end-run)\n791\t\n792\t\n793\t(defn- folded-projection\n794\t  \"The arbitration's own fold of the ledger read, or nil when the\n795\t   history is not whole (r3 1.5: complete history or nothing).\"\n796\t  [state]\n797\t  (let [records (read-ledger! state)]\n798\t    (when (some? records)\n799\t      (let [mine-records (vec (mine (:arbitration state) records))\n800\t            defect (history-defect mine-records)]\n801\t        (when (nil? defect)\n802\t          (fold (:arbitration state) mine-records))))))\n803\t\n804\t\n805\t(defn- enrolled-of\n806\t  \"The enrolled target identities of the arbitration's own fold, or nil\n807\t   with the reason the fold could not run.  Unavailable is never an\n808\t   empty enrolled set.\"\n809\t  [state]\n810\t  (let [records (read-ledger! state)]\n811\t    (if (nil? records)\n812\t      [nil :no-arbitration]\n813\t      (let [mine-records (vec (mine (:arbitration state) records))\n814\t            defect (history-defect mine-records)]\n815\t        (cond\n816\t          (some? defect) [nil defect]\n817\t          :else\n818\t          (let [p (fold (:arbitration state) mine-records)]\n819\t            (if (nil? p)\n820\t              [nil :fold-defect]\n821\t              [(set (keys (:targets p))) nil])))))))\n822\t\n823\t\n824\t(defn- export-prepare-step\n825\t  \"Prepare the export of `k`'s cell: serve each stream once, retaining\n826\t   what was served, so a refusal's retry never serves a stream twice.\n827\t   The minted occurrence is already durable in the journal.\"\n828\t  [state k]\n829\t  (when (= :exit k) (require-tenure! state))\n830\t  (let [cell (get state k)\n831\t        r (export/prepare\n832\t            (:m cell) (:record cell)\n833\t            (fn [handle]\n834\t              (let [resource (first (for [[path machine] (machines (:m cell))\n835\t                                          resource-id (sort-by str (keys (:resources machine)))\n836\t                                          :when (= handle (get (:resources machine) resource-id))]\n837\t                                      [path resource-id]))\n838\t                    request-id [:yin.k/serve (:occurrence cell) resource]\n839\t                    journaled? (some? (:occurrence cell))]\n840\t                (when journaled?\n841\t                  (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/serve\n842\t                                   :yin.k/occurrence (:occurrence cell)\n843\t                                   :yin.k/request {:yin.k/request-id request-id\n844\t                                                   :yin.k/resource resource}}))\n845\t                (when (= :exit k) (require-tenure! state))\n846\t                (let [descriptor (serve! state handle)]\n847\t                  (when (and journaled? descriptor)\n848\t                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/serve\n849\t                                     :yin.k/occurrence (:occurrence cell)\n850\t                                     :yin.k/request-id request-id :yin.k/answer descriptor}))\n851\t                  descriptor)))\n852\t            (:header cell))]\n853\t    (if (= :ok (:status r))\n854\t      (-> state\n855\t          (assoc-in [k :record] (:record r))\n856\t          (assoc-in [k :prepared?] true)\n857\t          (with-status :yin.k/ok\n858\t            {:export (:role cell) :step :prepared}))\n859\t      (-> state\n860\t          (assoc-in [k :record] (:record r))\n861\t          (unsatisfied :export-refused\n862\t                       (select-keys r [:yin.k/status :yin.k/reason\n863\t                                       :yin.k/kind :yin.k/path]))))))\n864\t\n865\t\n866\t(defn- export-fence-step\n867\t  \"Freeze the complete record and persist both addressed objects before\n868\t   journaling the fence: the recovery object first, then the body, and a\n869\t   store that refuses stops the step before the next object is\n870\t   attempted. The journal contains canonical progress only; the runtime\n871\t   environment retains composition functions and handles.\"\n872\t  [state k]\n873\t  (when (= :exit k) (require-tenure! state))\n874\t  (let [cell (get state k)\n875\t        e (export/freeze (:m cell) (:record cell))]\n876\t    (if (not= :ok (:status e))\n877\t      (unsatisfied state :export-refused\n878\t                   (select-keys e [:yin.k/status :yin.k/reason\n879\t                                   :yin.k/kind :yin.k/path]))\n880\t      (let [bytes (:body-bytes e)\n881\t            address (:body-address e)\n882\t            record-bytes (:bytes e)\n883\t            record-address (:address e)\n884\t            store-object\n885\t            (fn [[object-address object-bytes]]\n886\t              (let [request-id [:yin.k/store (:occurrence cell) object-address]]\n887\t                (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/store\n888\t                                 :yin.k/occurrence (:occurrence cell)\n889\t                                 :yin.k/request {:yin.k/request-id request-id\n890\t                                                 :yin.k/address object-address}})\n891\t                (when (= :exit k) (require-tenure! state))\n892\t                (let [stored? (store-put! state object-address object-bytes)]\n893\t                  (when stored?\n894\t                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/store\n895\t                                     :yin.k/occurrence (:occurrence cell)\n896\t                                     :yin.k/request-id request-id\n897\t                                     :yin.k/answer {:yin.k/status :stored}}))\n898\t                  stored?)))]\n899\t        (if-not (and (store-object [record-address record-bytes])\n900\t                     (store-object [address bytes]))\n901\t          (unsatisfied state :content-unavailable {:yin.k/address address})\n902\t          (do\n903\t            (journal! state\n904\t                      {:yin.k/journal :yin.k/fenced\n905\t                       :yin.k/occurrence (:occurrence cell)\n906\t                       :yin.k/address address\n907\t                       :yin.k/record record-address})\n908\t            (-> state\n909\t                (assoc-in [k :address] address)\n910\t                (assoc-in [k :record-address] record-address)\n911\t                (assoc-in [k :bytes] bytes)\n912\t                (assoc-in [k :kind] (:kind e))\n913\t                (with-status :yin.k/ok\n914\t                  {:export (:role cell) :step :fenced}))))))))\n915\t\n916\t\n917\t(defn- offer-request\n918\t  [o address medium bytes]\n919\t  {:yin.k/request :yin.k/offer\n920\t   :yin.k/request-id [:yin.k/offer o]\n921\t   :yin.k/id address\n922\t   :yin.k/bytes bytes\n923\t   :yin.k/medium medium})\n924\t\n925\t\n926\t(defn- admitted?\n927\t  [answer]\n928\t  (contains? #{:committed :replayed} (get answer :yin.k/status)))\n929\t\n930\t\n931\t(defn- export-offer-step\n932\t  \"The offer bracket of `k`'s cell: one intent record durable before\n933\t   the bracket's first send, one attempt record after each send\n934\t   carrying the append's outcome, and the acknowledgment once the\n935\t   front's authenticated reply admits the offer.  The request is\n936\t   rebuilt from the cell (the bytes from the store when the cell holds\n937\t   none), so a resend is the identical request.\"\n938\t  [state k]\n939\t  (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n940\t    (require-tenure! state))\n941\t  (let [cell (get state k)\n942\t        o (:occurrence cell)\n943\t        medium (get-in state [:seams :medium])\n944\t        offer (or (:offer cell)\n945\t                  {:request (offer-request o (:address cell) medium\n946\t                                           (or (:bytes cell)\n947\t                                               (store-get state\n948\t                                                          (:address cell))))})]\n949\t    (journal! state\n950\t              {:yin.k/journal :yin.k/intent\n951\t               :yin.k/action :yin.k/offer\n952\t               :yin.k/occurrence o\n953\t               :yin.k/request (dissoc (:request offer) :yin.k/bytes)\n954\t               :yin.k/bytes-at (:address cell)})\n955\t    (let [_ (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n956\t              (require-tenure! state))\n957\t          outcome (append-request! state (:request offer))\n958\t          offer' (assoc offer\n959\t                        :intended? true\n960\t                        :sent (or (:sent offer)\n961\t                                  (= :dao.stream/ok\n962\t                                     (:dao.stream/outcome outcome))))]\n963\t      (journal! state\n964\t                {:yin.k/journal :yin.k/attempt\n965\t                 :yin.k/action :yin.k/offer\n966\t                 :yin.k/occurrence o\n967\t                 :yin.k/append (:dao.stream/outcome outcome)})\n968\t      (-> state\n969\t          (assoc-in [k :offer] offer')\n970\t          (with-status :yin.k/ok\n971\t            {:export (:role cell) :step :offered})))))\n972\t\n973\t\n974\t(defn- offer-done?\n975\t  [cell]\n976\t  (admitted? (get-in cell [:offer :answer])))\n977\t\n978\t\n979\t(defn- source-mint\n980\t  \"The first step of a first exclusive export: enter exporting, mint\n981\t   the occurrence once, and journal it before prepare is ever called\n982\t   (the D9 ruling).  The header is the driver's: the composition's\n983\t   arbitration, next-op-seq 0, no origin, the enrolled set of the\n984\t   ledger fold.\"\n985\t  [state]\n986\t  (let [cell (:export state)\n987\t        e (export/enter (:machine cell) {:version (:export-version state)})]\n988\t    (if (not= :ok (:status e))\n989\t      (failed state e)\n990\t      (let [[enrolled reason] (enrolled-of state)]\n991\t        (if (nil? enrolled)\n992\t          (unsatisfied state reason\n993\t                       {:dao.stream/identity (:arbitration state)})\n994\t          (let [o (custody/mint-occurrence)\n995\t                header {:yin.k/occurrence o\n996\t                        :yin.k/arbitration (:arbitration cell)\n997\t                        :yin.k/next-op-seq 0\n998\t                        :yin.k/enrolled enrolled}]\n999\t            (journal! state\n1000\t                      {:yin.k/journal :yin.k/minted\n1001\t                       :yin.k/role (:role cell)\n1002\t                       :yin.k/occurrence o\n1003\t                       :yin.k/header header})\n1004\t            (-> state\n1005\t                (assoc :export (assoc cell\n1006\t                                      :occurrence o\n1007\t                                      :header header\n1008\t                                      :m (:machine e)\n1009\t                                      :record (:record e)))\n1010\t                (with-status :yin.k/ok\n1011\t                  {:export :yin.k/first :step :minted}))))))))\n1012\t\n1013\t\n1014\t(defn- fork-step\n1015\t  \"The composition's fork decision (a nil arbitration): the version-0\n1016\t   lift over the machine -- enter, prepare under a nil header, encode --\n1017\t   with no occurrence, no offer and no journal bracket.  The answer is\n1018\t   the bytes.\"\n1019\t  [state]\n1020\t  (let [cell (:export state)]\n1021\t    (cond\n1022\t      (nil? (:m cell))\n1023\t      (let [e (export/enter (:machine cell) {:version (:export-version state)})]\n1024\t        (if (= :ok (:status e))\n1025\t          (assoc state :export (assoc cell\n1026\t                                      :m (:machine e)\n1027\t                                      :record (:record e)))\n1028\t          (failed state e)))\n1029\t\n1030\t      (not (:prepared? cell))\n1031\t      (export-prepare-step state :export)\n1032\t\n1033\t      :else\n1034\t      (let [e (export/encode (:m cell) (:record cell))]\n1035\t        (if (= :ok (:status e))\n1036\t          (assoc state\n1037\t                 :phase :lifted\n1038\t                 :status :yin.k/ok\n1039\t                 :detail {:yin.k/kind (:kind e)\n1040\t                          :yin.k/address (:address e)\n1041\t                          :bytes (:bytes e)})\n1042\t          (unsatisfied state :export-refused\n1043\t                       (select-keys e [:yin.k/status :yin.k/reason\n1044\t                                       :yin.k/kind :yin.k/path])))))))\n1045\t\n1046\t\n1047\t(defn- to-candidacy\n1048\t  \"The source becomes a candidate like any other, over its own bytes.\"\n1049\t  [state]\n1050\t  (let [cell (:export state)]\n1051\t    (-> state\n1052\t        (dissoc :export)\n1053\t        (assoc :phase :proposing\n1054\t               :occurrence (:occurrence cell)\n1055\t               :arbitration (get-in cell\n1056\t                                    [:header :yin.k/arbitration\n1057\t                                     :dao.stream/identity])\n1058\t               :kind (:kind cell)\n1059\t               :bytes (:bytes cell)\n1060\t               :address (:address cell))\n1061\t        (with-status :yin.k/awaiting-grant\n1062\t          {:yin.k/occurrence (:occurrence cell)}))))\n1063\t\n1064\t\n1065\t(defn- step-exporting\n1066\t  [state]\n1067\t  (let [state (if (nil? (get-in state [:export :role])) state (drain-control state))\n1068\t        cell (:export state)]\n1069\t    (cond\n1070\t      (:inbox-unavailable? state) state\n1071\t      (nil? (:role cell)) (fork-step state)\n1072\t      (nil? (:occurrence cell)) (source-mint state)\n1073\t      (not (:prepared? cell)) (export-prepare-step state :export)\n1074\t      (nil? (:address cell)) (export-fence-step state :export)\n1075\t      (offer-done? cell) (to-candidacy state)\n1076\t      :else (export-offer-step state :export))))\n1077\t\n1078\t\n1079\t;; =============================================================================\n1080\t;; The exit half (r3 1.6's residual and the landed completion contract):\n1081\t;; the successor append, the resumed report, the release, the closure\n1082\t;; =============================================================================\n1083\t\n1084\t(defn- arm-exit\n1085\t  \"Arm the exit over the state's machine: enter exporting now (the\n1086\t   refusal answers and arms nothing).  The fenced machine stays as\n1087\t   :machine and travels in the cell; the answer is the armed state or\n1088\t   the refusal, never both.\"\n1089\t  [state role]\n1090\t  (let [e (export/enter (:machine state) {:version (:export-version state)})]\n1091\t    (if (= :ok (:status e))\n1092\t      {:state (-> state\n1093\t                  (assoc :machine (:machine e))\n1094\t                  (assoc :exit {:role role\n1095\t                                :m (:machine e)\n1096\t                                :record (:record e)}))\n1097\t       :refusal nil}\n1098\t      {:state (with-status state :yin.k/unsatisfied\n1099\t                {:yin.k/reason :not-liftable\n1100\t                 :refusal (select-keys e [:yin.k/status :yin.k/kind\n1101\t                                          :yin.k/path :yin.k/hold])})\n1102\t       :refusal e})))\n1103\t\n1104\t\n1105\t(defn hand-off\n1106\t  \"Arm the exit half over a holder whose machine is parked or blocked\n1107\t   at a liftable safepoint: the composition's explicit export of a\n1108\t   parked continuation (UCF 7.8's lift is composition-driven, never\n1109\t   automatic on a park).  The phase becomes :safepoint and the next\n1110\t   step mints the successor; a machine that cannot enter exporting\n1111\t   answers the refusal, arms nothing and keeps running.\"\n1112\t  [state]\n1113\t  (if (= :stalled (:phase state))\n1114\t    state\n1115\t    (let [{:keys [state refusal]} (arm-exit state :yin.k/successor)]\n1116\t      (if (nil? refusal)\n1117\t        (assoc state :phase :safepoint\n1118\t               :status :yin.k/ok\n1119\t               :detail {:yin.k/occurrence (:occurrence state)\n1120\t                        :dao.lease/lease (:lease state)})\n1121\t        state))))\n1122\t\n1123\t\n1124\t(defn- exit-mint\n1125\t  \"The first step of the exit: mint the successor occurrence once and\n1126\t   journal it before prepare.  The header is built from the custody\n1127\t   map: a fresh occurrence, the same arbitration, an origin naming the\n1128\t   predecessor occurrence and lease and this driver as the emitter, the\n1129\t   current counter, and the enrolled set of the ledger fold.\"\n1130\t  [state]\n1131\t  (when (:holder state) (require-tenure! state))\n1132\t  (let [cell (:exit state)\n1133\t        cust (get-in (:machine state) [:yin.k/custody])\n1134\t        [enrolled reason] (enrolled-of state)]\n1135\t    (if (nil? enrolled)\n1136\t      (unsatisfied state reason {:dao.stream/identity (:arbitration state)})\n1137\t      (let [o (custody/mint-occurrence)\n1138\t            header {:yin.k/occurrence o\n1139\t                    :yin.k/arbitration (:yin.k/arbitration cust)\n1140\t                    :yin.k/next-op-seq (:yin.k/next-op-seq cust)\n1141\t                    :yin.k/enrolled enrolled\n1142\t                    :yin.k/origin {:yin.k/occurrence (:yin.k/occurrence cust)\n1143\t                                   :dao.lease/lease (:dao.lease/lease cust)\n1144\t                                   :yin.k/emitter (:me state)}}]\n1145\t        (journal! state\n1146\t                  {:yin.k/journal :yin.k/minted\n1147\t                   :yin.k/role (:role cell)\n1148\t                   :yin.k/occurrence o\n1149\t                   :yin.k/header header})"}]},"parent_tool_use_id":null,"session_id":"108e1cb8-f707-457b-be14-6feb1e135c49","uuid":"7dfb746e-87ba-4f79-92e4-48ad75d9b127","timestamp":"2026-10-13T10:03:31.810Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/src/cljc/yin/vm/ucf/holder/driver.cljc","content":"    (check! (map? machine) \"the machine to export\" {})\n    (check! (not (contains? machine :yin.k/custody))\n            \"a machine that holds no custody: a holder exports through hand-off\"\n            {})\n    (check! (or (nil? (:arbitration config))\n                (and (map? (:arbitration config))\n                     (some? (get-in config\n                                    [:arbitration :dao.stream/identity]))))\n            \"an arbitration medium: a map naming the identity, or nil for the fork\"\n            {:arbitration (:arbitration config)})\n    (check-common! config units)\n    (restore-inbox (assoc (bare-state config units)\n                          :phase :exporting\n                          :bytes nil\n                          :address nil\n                          :arbitration (get-in config [:arbitration :dao.stream/identity])\n                          :export {:role (if (some? (:arbitration config))\n                                           :yin.k/first nil)\n                                   :machine machine\n                                   :arbitration (:arbitration config)})\n                   (:inbox (fold-journal (journal-records (:journal config)))))))\n\n\n(defn- append-request!\n  [state request]\n  ((get-in state [:seams :append-request!]) request))\n\n\n(defn- read-ledger!\n  [state]\n  ((get-in state [:seams :read-ledger!])))\n\n\n(defn- clock\n  [state]\n  ((get-in state [:seams :clock])))\n\n\n(defn- observe!\n  [state handle op arg]\n  ((get-in state [:seams :observe!]) handle op arg))\n\n\n(defn- append-diagnostic!\n  [state diagnostic]\n  ((get-in state [:seams :append-diagnostic!]) diagnostic))\n\n\n(defn- serve!\n  [state handle]\n  ((get-in state [:seams :serve!]) handle))\n\n\n(defn- enroll!\n  [state]\n  ((get-in state [:seams :enroll!])))\n\n\n(defn- journal-of\n  [state]\n  (get-in state [:seams :journal]))\n\n\n;; =============================================================================\n;; The progress journal (r3 1.10): write-ahead, plain-data records\n;; =============================================================================\n\n(defn journal!\n  \"Append one `record` to the composition's progress journal.  A\n   transport-error is the journal's own uncertain answer -- a failure\n   between write and visibility poisons its appends -- and unwinds as\n   ::journal-uncertain, which `step` answers by stalling everything\n   until the composition reopens the journal and reconciles.  Any other\n   non-ok answer is a defect of the record's shape and throws.\"\n  [state record]\n  (let [o (stream/append! (journal-of state) record)]\n    (when-not (= :dao.stream/ok (:dao.stream/outcome o))\n      (if (= :dao.stream/transport-error (:dao.stream/outcome o))\n        (throw (ex-info \"The progress journal append is uncertain\"\n                        {::journal-uncertain true}))\n        (throw (ex-info \"The progress journal refused a record\"\n                        {::journal-defect (:dao.stream/outcome o)\n                         :record record}))))))\n\n\n(defn- stalled\n  [state]\n  (assoc state :phase :stalled\n         :status :yin.k/unsatisfied\n         :detail {:yin.k/reason :journal-uncertain}))\n\n\n(defn- progress-record?\n  [record]\n  (let [action (:yin.k/action record)\n        actions #{:yin.k/offer :yin.k/proposal :yin.k/resumed :yin.k/release\n                  :yin.k/enroll :yin.k/serve :yin.k/store :yin.k/renewal}]\n    (and (map? record)\n         (case (:yin.k/journal record)\n           :yin.k/minted (and (some? (:yin.k/occurrence record))\n                              (map? (:yin.k/header record))\n                              (contains? #{:yin.k/first :yin.k/successor :yin.k/result}\n                                         (:yin.k/role record)))\n           :yin.k/fenced (and (some? (:yin.k/occurrence record))\n                              (keyword? (:yin.k/address record)) (keyword? (:yin.k/record record)))\n           :yin.k/aborted (some? (:yin.k/occurrence record))\n           :yin.k/inbox (inbox/retention? record)\n           :yin.k/intent (and (contains? actions action)\n                              (if (= :yin.k/enroll action)\n                                (some? (:yin.k/derived record))\n                                (and (map? (:yin.k/request record))\n                                     (some? (get-in record [:yin.k/request :yin.k/request-id])))))\n           :yin.k/attempt (and (contains? actions action) (contains? record :yin.k/append))\n           :yin.k/ack (case action\n                        :yin.k/grant (and (some? (:yin.k/occurrence record))\n                                          (some? (:dao.lease/lease record)))\n                        :yin.k/enroll (some? (:yin.k/target record))\n                        (and (contains? actions action) (some? (:yin.k/request-id record))\n                             (map? (:yin.k/answer record))))\n           false))))\n\n\n(defn journal-records\n  \"Every record of journal handle `j`, from the origin: the whole\n   durable history a reopen folds.\"\n  [j]\n  (let [origin (stream/cursor j :dao.stream/oldest)]\n    (check! (= :dao.stream/ok (:dao.stream/outcome origin)) \"journal origin\" origin)\n    (loop [cursor (:dao.stream/cursor origin) records []]\n      (let [answer (stream/next j cursor)]\n        (case (:dao.stream/outcome answer)\n          :dao.stream/ok\n          (do\n            (check! (and (contains? answer :dao.stream/cursor)\n                         (not= cursor (:dao.stream/cursor answer))\n                         (or (not (map? cursor))\n                             (and (= (:dao.stream.memory-log/identity cursor)\n                                     (get-in answer [:dao.stream/cursor :dao.stream.memory-log/identity]))\n                                  (integer? (:dao.stream.memory-log/position cursor))\n                                  (= (inc (:dao.stream.memory-log/position cursor))\n                                     (get-in answer [:dao.stream/cursor :dao.stream.memory-log/position]))))\n                         (progress-record? (:dao.stream/value answer)))\n                    \"journal frame\" answer)\n            (recur (:dao.stream/cursor answer) (conj records (:dao.stream/value answer))))\n          :dao.stream/blocked records\n          (throw (ex-info \"Journal history unavailable\" {:yin.k/reason :journal-unavailable\n                                                         :answer answer})))))))\n\n\n(defn fold-journal\n  \"The driver's projection of its progress journal: what was minted and\n   fenced, which external actions were intended, attempted and\n   acknowledged, and which grant was accepted.  The records are the\n   driver's own grammar, plain data under `:yin.k/journal`:\n\n     {:yin.k/journal :yin.k/minted :yin.k/role r :yin.k/occurrence O\n      :yin.k/header h}\n     {:yin.k/journal :yin.k/fenced :yin.k/occurrence O\n      :yin.k/address A :yin.k/record RA}\n     {:yin.k/journal :yin.k/intent :yin.k/action a :yin.k/occurrence O\n      :yin.k/request req :yin.k/bytes-at A}   ; offer, proposal, resumed,\n                                              ; release, enroll (no\n                                              ; request identity)\n     {:yin.k/journal :yin.k/attempt :yin.k/action :yin.k/offer\n      :yin.k/occurrence O :yin.k/append outcome}\n     {:yin.k/journal :yin.k/ack :yin.k/action a :yin.k/occurrence O\n      :yin.k/request-id rid :yin.k/answer ans}  ; or :yin.k/grant, which\n                                                ; carries the lease\n\n   The fold answers\n\n     {:mint        the last minted occurrence's data, or nil\n      :fences      occurrence to {:address A :record RA}\n      :intents     request-id to the last intent record of that id\n      :acked       the request-ids whose acknowledgment stands\n      :answers     request-id to the authenticated answer\n      :attempts    occurrence to the offer attempts, {:append o} each\n      :offered     the occurrences whose offer intent stands\n      :grant       {:yin.k/occurrence O :dao.lease/lease l}, or nil}\"\n  [records]\n  (reduce\n    (fn [f [index record]]\n      (case (get record :yin.k/journal)\n        :yin.k/inbox\n        (update f :inbox inbox/retain record)\n        :yin.k/minted\n        (assoc f :mint {:role (get record :yin.k/role)\n                        :index index\n                        :occurrence (get record :yin.k/occurrence)\n                        :header (get record :yin.k/header)})\n        :yin.k/fenced\n        (assoc-in f [:fences (get record :yin.k/occurrence)]\n                  {:address (get record :yin.k/address)\n                   :record (get record :yin.k/record)})\n        :yin.k/aborted\n        (assoc-in f [:aborted (:yin.k/occurrence record)] {:index index})\n        :yin.k/intent\n        (let [rid (get-in record [:yin.k/request :yin.k/request-id])]\n          (-> f\n              (update :intents assoc rid record)\n              (update :ordered-intents conj record)\n              (cond-> (= :yin.k/enroll (get record :yin.k/action))\n                (assoc :enroll {:derived (:yin.k/derived record)}))\n              (cond-> (= :yin.k/offer (get record :yin.k/action))\n                (update :offered conj (get record :yin.k/occurrence))\n                (= :yin.k/offer (get record :yin.k/action))\n                (update-in [:attempts (get record :yin.k/occurrence)] (fnil conj []) {}))))\n        :yin.k/ack\n        (cond\n          (= :yin.k/enroll (get record :yin.k/action))\n          (assoc f :enroll {:target (:yin.k/target record)})\n\n          (= :yin.k/grant (get record :yin.k/action))\n          (assoc f :grant {:occurrence (get record :yin.k/occurrence)\n                           :index index\n                           :lease (get record :dao.lease/lease)})\n          :else\n          (let [rid (get record :yin.k/request-id)]\n            (-> f\n                (update :acked (fnil conj #{}) rid)\n                (update :answers assoc rid record))))\n        :yin.k/attempt\n        (if (= :yin.k/offer (:yin.k/action record))\n          (update-in f [:attempts (get record :yin.k/occurrence)]\n                     (fn [attempts]\n                       (check! (seq attempts) \"attempt with durable intent\" record)\n                       (assoc attempts (dec (count attempts))\n                              {:append (get record :yin.k/append)})))\n          (update f :action-attempts (fnil conj []) record))\n        f))\n    {:mint nil :fences {} :intents {} :ordered-intents [] :acked #{} :answers {}\n     :attempts {} :offered #{} :grant nil :inbox []}\n    (map-indexed vector records)))\n\n\n(defn- offered-attempts\n  \"The journaled offer attempts of `occurrence` (r3 1.9): one per\n   attempt whose intent was durable before the send, `:append` the\n   outcome its append answered -- absent when none did.  An intent with\n   no attempt record is one send of unknown outcome.\"\n  [folded occurrence]\n  (let [sent (get-in folded [:attempts occurrence])]\n    (if (and (contains? (:offered folded) occurrence)\n             (empty? sent))\n      [{}]\n      (or sent []))))\n\n\n(defn- intent-of\n  \"The last intent record of `action` for `occurrence`, or nil.\"\n  [folded action occurrence]\n  (some (fn [record]\n          (when (and (= action (get record :yin.k/action))\n                     (or (nil? occurrence)\n                         (= occurrence (get record :yin.k/occurrence))))\n            record))\n        (reverse (:ordered-intents folded))))\n\n\n;; =============================================================================\n;; The content store: the prepared record and the body bytes (r3 1.10)\n;; =============================================================================\n\n(defn- store-put!\n  \"Put `bytes` at `address` in the composition's content store: true\n   once it holds them, false when the store refused or threw.\"\n  [state address bytes]\n  (try\n    (contains? #{:inserted :present}\n               ((:put-bytes-fn (get-in state [:seams :content-store])) address bytes))\n    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n      false)))\n\n\n(defn- store-get\n  \"The bytes the composition's content store holds at `address`, or nil.\"\n  [state address]\n  (try\n    (let [v ((:get-bytes-fn (get-in state [:seams :content-store]))\n             address ::absent)]\n      (when-not (= ::absent v) v))\n    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n      nil)))\n\n\n;; =============================================================================\n;; The task tree and the gate\n;; =============================================================================\n\n(defn- machines\n  \"`[path machine]` of the root and, recursively, each install child,\n   children in install-name order.\"\n  [root]\n  (letfn [(walk\n            [prefix m]\n            (concat [[prefix m]]\n                    (mapcat (fn [name]\n                              (when-some [child (:vm (get (:installs m) name))]\n                                (walk (into prefix [:installs name :vm])\n                                      child)))\n                            (sort-by str (keys (:installs m))))))]\n    (walk [] root)))\n\n\n(defn- ended\n  \"`machine` gated `:ended` at the root and at every install child: the\n   root owns the mode, and nothing applies a late result after it.\"\n  [machine]\n  (reduce (fn [m [prefix _]]\n            (assoc-in m (conj prefix :yin.k/gate) :ended))\n          (assoc machine :yin.k/gate :ended)\n          (machines machine)))\n\n\n;; =============================================================================\n;; The ledger read: whole history, fold, and the raw grant\n;; =============================================================================\n\n(defn- mine\n  \"The records `records` attributes to the arbitration identity.\"\n  [arbitration records]\n  (filter #(= arbitration (first %)) records))\n\n\n(defn- transport-error?\n  [record]\n  (and (map? record) (contains? record :dao.stream/outcome)))\n\n\n(defn- history-defect\n  \"Why `records` is not a whole history read from the origin -- a\n   transport error, a start past the origin, a gap, or a fold defect --\n   or nil when they are dense from zero.  The same rule D3's reader\n   applies before any evidence is derived.\"\n  [records]\n  (loop [rs (seq records) n 0]\n    (if-not rs\n      nil\n      (let [record (second (first rs))]\n        (cond\n          (transport-error? record) :transport-error\n          :else\n          (let [t (get-in record [:dao.space/transaction :t])]\n            (cond\n              (not (custody/exact? t)) :fold-defect\n              (= t n) (recur (next rs) (inc n))\n              (> t n) (if (zero? n) :start-past-origin :gap)\n              :else :fold-defect)))))))\n\n\n(defn- fold\n  \"The projection of the arbitration's `records`, or nil when they do\n   not fold whole -- the same fold D3's reader runs.\"\n  [arbitration records]\n  (loop [p (ledger/empty-projection arbitration)\n         rs (seq records)]\n    (if-not rs\n      p\n      (let [p' (ledger/fold-record p (second (first rs)))]\n        (if (::ledger/defect p')\n          nil\n          (recur p' (next rs)))))))\n\n\n(defn- record-facts\n  \"The fact maps of one transaction record, entities in first-appearance\n   order -- the raw datoms grouped, with no fold run over them.\"\n  [record]\n  (let [datoms (get-in record [:dao.space/transaction :datoms])]\n    (when (vector? datoms)\n      (mapv (fn [entity]\n              (into {} (keep (fn [[other attribute value]]\n                               (when (= entity other) [attribute value])) datoms)))\n            (distinct (map first datoms))))))\n\n\n(defn- grants-to\n  \"The accepted facts, in record order, granted to `me` on `occurrence`\n   among the arbitration's records -- read raw, before any fold: the\n   grant this driver observes is its own, and a history too corrupt to\n   fold cannot hide it (the binding check that follows is what\n   authenticates it).\"\n  [arbitration me occurrence records]\n  (into []\n        (comp (filter #(= arbitration (first %)))\n              (mapcat (fn [[_ record]] (record-facts record)))\n              (filter #(and (= :dao.lease/accepted (:dao.lease/status %))\n                            (= me (:dao.lease/holder %))\n                            (= (custody/subject occurrence)\n                               (:dao.lease/subject %)))))\n        records))\n\n\n(defn- occurrence-state\n  \"The lease state observed for `occurrence` in `projection`: what a\n   `:yin.k/not-holder` answer carries (7.9).\"\n  [projection occurrence]\n  (let [entry (get-in projection [:occurrences occurrence])\n        l (:dao.lease/lease entry)]\n    (cond-> {:yin.k/occurrence occurrence\n             :dao.lease/lease l\n             :yin.k/epoch (:yin.k/epoch entry)\n             :yin.k/admitted (:yin.k/variants entry)}\n      (some? l) (assoc :dao.lease/holder\n                       (get-in projection [:leases l :dao.lease/holder]))\n      (:yin.k/quarantined entry) (assoc :yin.k/quarantined true)\n      (:yin.k/closed entry) (assoc :yin.k/closed true)\n      (:yin.k/exhausted entry) (assoc :yin.k/exhausted true))))\n\n\n(defn- never-granted-again?\n  \"True when the occurrence can never be granted again: closed,\n   exhausted or quarantined.\"\n  [entry]\n  (boolean (or (:yin.k/closed entry)\n               (:yin.k/exhausted entry)\n               (:yin.k/quarantined entry))))\n\n\n;; =============================================================================\n;; The answers the step state carries\n;; =============================================================================\n\n(defn- with-status\n  [state status detail]\n  (assoc state :status status :detail detail))\n\n\n(defn- unsatisfied\n  ([state reason] (unsatisfied state reason nil))\n  ([state reason data]\n   (with-status state :yin.k/unsatisfied\n     (cond-> {:yin.k/reason reason}\n       (map? data) (merge data)))))\n\n\n(defn- failed\n  \"A terminal refusal no cleanup is owed for: before custody, none.\"\n  [state refusal]\n  (assoc state :phase :failed\n         :status (:yin.k/status refusal)\n         :detail (dissoc refusal :yin.k/status)))\n\n\n(def ^:private invalid-binding\n  \"custody/binding-evidence's no-evidence reasons that make the binding\n   of a grant to this driver invalid -- as against a history that is\n   merely unavailable.\"\n  #{:no-binding :duplicate-binding :inexact-epoch\n    :not-in-grant-transaction :grant-mismatch})\n\n\n;; =============================================================================\n;; The export half (r3 1.8 and 1.9; the D9 ruling): mint, prepare,\n;; fence, offer\n;; =============================================================================\n\n;; The candidate loop's reply drain and the release request live below,\n;; with the halves that own them; the export and exit halves step\n;; through both.\n(declare drain-control release-request require-tenure! releasing end-run)\n\n\n(defn- folded-projection\n  \"The arbitration's own fold of the ledger read, or nil when the\n   history is not whole (r3 1.5: complete history or nothing).\"\n  [state]\n  (let [records (read-ledger! state)]\n    (when (some? records)\n      (let [mine-records (vec (mine (:arbitration state) records))\n            defect (history-defect mine-records)]\n        (when (nil? defect)\n          (fold (:arbitration state) mine-records))))))\n\n\n(defn- enrolled-of\n  \"The enrolled target identities of the arbitration's own fold, or nil\n   with the reason the fold could not run.  Unavailable is never an\n   empty enrolled set.\"\n  [state]\n  (let [records (read-ledger! state)]\n    (if (nil? records)\n      [nil :no-arbitration]\n      (let [mine-records (vec (mine (:arbitration state) records))\n            defect (history-defect mine-records)]\n        (cond\n          (some? defect) [nil defect]\n          :else\n          (let [p (fold (:arbitration state) mine-records)]\n            (if (nil? p)\n              [nil :fold-defect]\n              [(set (keys (:targets p))) nil])))))))\n\n\n(defn- export-prepare-step\n  \"Prepare the export of `k`'s cell: serve each stream once, retaining\n   what was served, so a refusal's retry never serves a stream twice.\n   The minted occurrence is already durable in the journal.\"\n  [state k]\n  (when (= :exit k) (require-tenure! state))\n  (let [cell (get state k)\n        r (export/prepare\n            (:m cell) (:record cell)\n            (fn [handle]\n              (let [resource (first (for [[path machine] (machines (:m cell))\n                                          resource-id (sort-by str (keys (:resources machine)))\n                                          :when (= handle (get (:resources machine) resource-id))]\n                                      [path resource-id]))\n                    request-id [:yin.k/serve (:occurrence cell) resource]\n                    journaled? (some? (:occurrence cell))]\n                (when journaled?\n                  (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/serve\n                                   :yin.k/occurrence (:occurrence cell)\n                                   :yin.k/request {:yin.k/request-id request-id\n                                                   :yin.k/resource resource}}))\n                (when (= :exit k) (require-tenure! state))\n                (let [descriptor (serve! state handle)]\n                  (when (and journaled? descriptor)\n                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/serve\n                                     :yin.k/occurrence (:occurrence cell)\n                                     :yin.k/request-id request-id :yin.k/answer descriptor}))\n                  descriptor)))\n            (:header cell))]\n    (if (= :ok (:status r))\n      (-> state\n          (assoc-in [k :record] (:record r))\n          (assoc-in [k :prepared?] true)\n          (with-status :yin.k/ok\n            {:export (:role cell) :step :prepared}))\n      (-> state\n          (assoc-in [k :record] (:record r))\n          (unsatisfied :export-refused\n                       (select-keys r [:yin.k/status :yin.k/reason\n                                       :yin.k/kind :yin.k/path]))))))\n\n\n(defn- export-fence-step\n  \"Freeze the complete record and persist both addressed objects before\n   journaling the fence: the recovery object first, then the body, and a\n   store that refuses stops the step before the next object is\n   attempted. The journal contains canonical progress only; the runtime\n   environment retains composition functions and handles.\"\n  [state k]\n  (when (= :exit k) (require-tenure! state))\n  (let [cell (get state k)\n        e (export/freeze (:m cell) (:record cell))]\n    (if (not= :ok (:status e))\n      (unsatisfied state :export-refused\n                   (select-keys e [:yin.k/status :yin.k/reason\n                                   :yin.k/kind :yin.k/path]))\n      (let [bytes (:body-bytes e)\n            address (:body-address e)\n            record-bytes (:bytes e)\n            record-address (:address e)\n            store-object\n            (fn [[object-address object-bytes]]\n              (let [request-id [:yin.k/store (:occurrence cell) object-address]]\n                (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/store\n                                 :yin.k/occurrence (:occurrence cell)\n                                 :yin.k/request {:yin.k/request-id request-id\n                                                 :yin.k/address object-address}})\n                (when (= :exit k) (require-tenure! state))\n                (let [stored? (store-put! state object-address object-bytes)]\n                  (when stored?\n                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/store\n                                     :yin.k/occurrence (:occurrence cell)\n                                     :yin.k/request-id request-id\n                                     :yin.k/answer {:yin.k/status :stored}}))\n                  stored?)))]\n        (if-not (and (store-object [record-address record-bytes])\n                     (store-object [address bytes]))\n          (unsatisfied state :content-unavailable {:yin.k/address address})\n          (do\n            (journal! state\n                      {:yin.k/journal :yin.k/fenced\n                       :yin.k/occurrence (:occurrence cell)\n                       :yin.k/address address\n                       :yin.k/record record-address})\n            (-> state\n                (assoc-in [k :address] address)\n                (assoc-in [k :record-address] record-address)\n                (assoc-in [k :bytes] bytes)\n                (assoc-in [k :kind] (:kind e))\n                (with-status :yin.k/ok\n                  {:export (:role cell) :step :fenced}))))))))\n\n\n(defn- offer-request\n  [o address medium bytes]\n  {:yin.k/request :yin.k/offer\n   :yin.k/request-id [:yin.k/offer o]\n   :yin.k/id address\n   :yin.k/bytes bytes\n   :yin.k/medium medium})\n\n\n(defn- admitted?\n  [answer]\n  (contains? #{:committed :replayed} (get answer :yin.k/status)))\n\n\n(defn- export-offer-step\n  \"The offer bracket of `k`'s cell: one intent record durable before\n   the bracket's first send, one attempt record after each send\n   carrying the append's outcome, and the acknowledgment once the\n   front's authenticated reply admits the offer.  The request is\n   rebuilt from the cell (the bytes from the store when the cell holds\n   none), so a resend is the identical request.\"\n  [state k]\n  (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n    (require-tenure! state))\n  (let [cell (get state k)\n        o (:occurrence cell)\n        medium (get-in state [:seams :medium])\n        offer (or (:offer cell)\n                  {:request (offer-request o (:address cell) medium\n                                           (or (:bytes cell)\n                                               (store-get state\n                                                          (:address cell))))})]\n    (journal! state\n              {:yin.k/journal :yin.k/intent\n               :yin.k/action :yin.k/offer\n               :yin.k/occurrence o\n               :yin.k/request (dissoc (:request offer) :yin.k/bytes)\n               :yin.k/bytes-at (:address cell)})\n    (let [_ (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n              (require-tenure! state))\n          outcome (append-request! state (:request offer))\n          offer' (assoc offer\n                        :intended? true\n                        :sent (or (:sent offer)\n                                  (= :dao.stream/ok\n                                     (:dao.stream/outcome outcome))))]\n      (journal! state\n                {:yin.k/journal :yin.k/attempt\n                 :yin.k/action :yin.k/offer\n                 :yin.k/occurrence o\n                 :yin.k/append (:dao.stream/outcome outcome)})\n      (-> state\n          (assoc-in [k :offer] offer')\n          (with-status :yin.k/ok\n            {:export (:role cell) :step :offered})))))\n\n\n(defn- offer-done?\n  [cell]\n  (admitted? (get-in cell [:offer :answer])))\n\n\n(defn- source-mint\n  \"The first step of a first exclusive export: enter exporting, mint\n   the occurrence once, and journal it before prepare is ever called\n   (the D9 ruling).  The header is the driver's: the composition's\n   arbitration, next-op-seq 0, no origin, the enrolled set of the\n   ledger fold.\"\n  [state]\n  (let [cell (:export state)\n        e (export/enter (:machine cell) {:version (:export-version state)})]\n    (if (not= :ok (:status e))\n      (failed state e)\n      (let [[enrolled reason] (enrolled-of state)]\n        (if (nil? enrolled)\n          (unsatisfied state reason\n                       {:dao.stream/identity (:arbitration state)})\n          (let [o (custody/mint-occurrence)\n                header {:yin.k/occurrence o\n                        :yin.k/arbitration (:arbitration cell)\n                        :yin.k/next-op-seq 0\n                        :yin.k/enrolled enrolled}]\n            (journal! state\n                      {:yin.k/journal :yin.k/minted\n                       :yin.k/role (:role cell)\n                       :yin.k/occurrence o\n                       :yin.k/header header})\n            (-> state\n                (assoc :export (assoc cell\n                                      :occurrence o\n                                      :header header\n                                      :m (:machine e)\n                                      :record (:record e)))\n                (with-status :yin.k/ok\n                  {:export :yin.k/first :step :minted}))))))))\n\n\n(defn- fork-step\n  \"The composition's fork decision (a nil arbitration): the version-0\n   lift over the machine -- enter, prepare under a nil header, encode --\n   with no occurrence, no offer and no journal bracket.  The answer is\n   the bytes.\"\n  [state]\n  (let [cell (:export state)]\n    (cond\n      (nil? (:m cell))\n      (let [e (export/enter (:machine cell) {:version (:export-version state)})]\n        (if (= :ok (:status e))\n          (assoc state :export (assoc cell\n                                      :m (:machine e)\n                                      :record (:record e)))\n          (failed state e)))\n\n      (not (:prepared? cell))\n      (export-prepare-step state :export)\n\n      :else\n      (let [e (export/encode (:m cell) (:record cell))]\n        (if (= :ok (:status e))\n          (assoc state\n                 :phase :lifted\n                 :status :yin.k/ok\n                 :detail {:yin.k/kind (:kind e)\n                          :yin.k/address (:address e)\n                          :bytes (:bytes e)})\n          (unsatisfied state :export-refused\n                       (select-keys e [:yin.k/status :yin.k/reason\n                                       :yin.k/kind :yin.k/path])))))))\n\n\n(defn- to-candidacy\n  \"The source becomes a candidate like any other, over its own bytes.\"\n  [state]\n  (let [cell (:export state)]\n    (-> state\n        (dissoc :export)\n        (assoc :phase :proposing\n               :occurrence (:occurrence cell)\n               :arbitration (get-in cell\n                                    [:header :yin.k/arbitration\n                                     :dao.stream/identity])\n               :kind (:kind cell)\n               :bytes (:bytes cell)\n               :address (:address cell))\n        (with-status :yin.k/awaiting-grant\n          {:yin.k/occurrence (:occurrence cell)}))))\n\n\n(defn- step-exporting\n  [state]\n  (let [state (if (nil? (get-in state [:export :role])) state (drain-control state))\n        cell (:export state)]\n    (cond\n      (:inbox-unavailable? state) state\n      (nil? (:role cell)) (fork-step state)\n      (nil? (:occurrence cell)) (source-mint state)\n      (not (:prepared? cell)) (export-prepare-step state :export)\n      (nil? (:address cell)) (export-fence-step state :export)\n      (offer-done? cell) (to-candidacy state)\n      :else (export-offer-step state :export))))\n\n\n;; =============================================================================\n;; The exit half (r3 1.6's residual and the landed completion contract):\n;; the successor append, the resumed report, the release, the closure\n;; =============================================================================\n\n(defn- arm-exit\n  \"Arm the exit over the state's machine: enter exporting now (the\n   refusal answers and arms nothing).  The fenced machine stays as\n   :machine and travels in the cell; the answer is the armed state or\n   the refusal, never both.\"\n  [state role]\n  (let [e (export/enter (:machine state) {:version (:export-version state)})]\n    (if (= :ok (:status e))\n      {:state (-> state\n                  (assoc :machine (:machine e))\n                  (assoc :exit {:role role\n                                :m (:machine e)\n                                :record (:record e)}))\n       :refusal nil}\n      {:state (with-status state :yin.k/unsatisfied\n                {:yin.k/reason :not-liftable\n                 :refusal (select-keys e [:yin.k/status :yin.k/kind\n                                          :yin.k/path :yin.k/hold])})\n       :refusal e})))\n\n\n(defn hand-off\n  \"Arm the exit half over a holder whose machine is parked or blocked\n   at a liftable safepoint: the composition's explicit export of a\n   parked continuation (UCF 7.8's lift is composition-driven, never\n   automatic on a park).  The phase becomes :safepoint and the next\n   step mints the successor; a machine that cannot enter exporting\n   answers the refusal, arms nothing and keeps running.\"\n  [state]\n  (if (= :stalled (:phase state))\n    state\n    (let [{:keys [state refusal]} (arm-exit state :yin.k/successor)]\n      (if (nil? refusal)\n        (assoc state :phase :safepoint\n               :status :yin.k/ok\n               :detail {:yin.k/occurrence (:occurrence state)\n                        :dao.lease/lease (:lease state)})\n        state))))\n\n\n(defn- exit-mint\n  \"The first step of the exit: mint the successor occurrence once and\n   journal it before prepare.  The header is built from the custody\n   map: a fresh occurrence, the same arbitration, an origin naming the\n   predecessor occurrence and lease and this driver as the emitter, the\n   current counter, and the enrolled set of the ledger fold.\"\n  [state]\n  (when (:holder state) (require-tenure! state))\n  (let [cell (:exit state)\n        cust (get-in (:machine state) [:yin.k/custody])\n        [enrolled reason] (enrolled-of state)]\n    (if (nil? enrolled)\n      (unsatisfied state reason {:dao.stream/identity (:arbitration state)})\n      (let [o (custody/mint-occurrence)\n            header {:yin.k/occurrence o\n                    :yin.k/arbitration (:yin.k/arbitration cust)\n                    :yin.k/next-op-seq (:yin.k/next-op-seq cust)\n                    :yin.k/enrolled enrolled\n                    :yin.k/origin {:yin.k/occurrence (:yin.k/occurrence cust)\n                                   :dao.lease/lease (:dao.lease/lease cust)\n                                   :yin.k/emitter (:me state)}}]\n        (journal! state\n                  {:yin.k/journal :yin.k/minted\n                   :yin.k/role (:role cell)\n                   :yin.k/occurrence o\n                   :yin.k/header header})","numLines":820,"startLine":330,"totalLines":2918}},"tool_result_meta":[{"id":"toolu_01MEXH53WyESMLkd3UCJ1Txo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
