er-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           :cljd {:extra-paths [\"test\"]\n                  :extra-deps {tensegritics/clojuredart\n                               {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                                :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"shadow.cljs.devtools.cli\" \"run\" \"yin.repl/-main\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl\n           {:extra-deps {tensegritics/clojuredart\n                         {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                          :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n            :main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:extra-deps {tensegritics/clojuredart\n                         {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                          :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n            :main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.repl\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yang.python-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n{:tasks\n {test:clj {:doc \"Run JVM tests (via clj)\"\n            :task (shell \"clojure -M:test\")}\n\n  test:cljs {:doc \"Run Node tests (via shadow-cljs with :cljs alias)\"\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile slice-peer test\")}\n\n  build:slice-peer\n  {:doc \"Compile the DaoStream v2 Phase 5 peer as a Dart exe\"\n   ;; Process B of the Phase 5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:cljd compile dao.stream.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/dao/stream/slice-peer.dart -o build/slice-peer\"))}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; Same ahead-of-time constraint as build:slice-peer.  The R5 cross-host\n   ;; tests spawn this one exe from the JVM and Node lanes, so `bb test`\n   ;; builds it first; a bare `bb test:clj` or `bb test:cljs` without it\n   ;; skips those tests with a printed notice rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  test:cljd {:doc \"Run Dart tests (via clojure -M:cljd)\"\n             :depends [build:slice-peer build:yin-repl-peer]\n             :task (shell \"clojure -M:cljd test\")}\n\n  test {:doc \"Run all tests (cross-host R5 pairs need the Dart peer, so build it first)\"\n        :depends [build:yin-repl-peer test:clj test:cljs test:cljd]}}}\n;; shadow-cljs configuration\n;; Source paths come from deps.edn (:paths plus the :cljs alias's\n;; :extra-paths); shadow ignores any :source-paths set here when :deps\n;; is used.\n{:deps {:aliases [:cljs]}\n\n :dev-http {9000 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :slice-peer {:target :node-script\n                       :main dao.stream.slice-peer/-main\n                       :output-to \"target/slice-peer.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl/-main\n                        :output-to \"target/yin-repl.js\"}}}\n## ClojureDart Test Suite\n\nClojureDart tests are cross-compiled to Dart and executed using the Dart VM.\n\n### Running ClojureDart Tests\n```bash\nclj -M:cljd test            # all namespaces (sweeps the classpath)\nclj -M:cljd test some.ns    # a subset\n```\nThe native `cljd.build` test command compiles every `.cljc`/`.cljd` namespace on the classpath, generates a `*_test.dart` entrypoint under `test/cljd-out/` for each namespace containing deftests, and runs them via `flutter test`. There is no allowlist: JVM-only namespaces are excluded at the reader level with `#?(:cljd nil :clj ...)` guards (a plain `#?(:clj ...)` does NOT exclude code from the ClojureDart build, because the host pass also matches `:clj`).\n\n---\n\n## ClojureScript Test Suite\n\nClojureScript tests are cross-compiled to JavaScript and executed using Node.js.\n\n### Running ClojureScript Tests\n```bash\n./bin/run-cljs-tests.sh\n```\nThis script uses `shadow-cljs` to compile the `:test` build and runs the resulting script with `node`.\n\n### Supported Test Build\nThe configuration for the test build is defined in `shadow-cljs.edn` under the `:test` key.\n\n---\n\n## Yin VM Formal Test Suite\n\n## Overview\n\nFormal test suite using `clojure.test` for the Yin Virtual Machine implementation.\n\n## Test Files\n\n### [yin/vm_basic_test.clj](yin/vm_basic_test.clj)\nCore functionality tests covering:\n- ✅ **Literal evaluation** - Numbers and strings\n- ✅ **Variable lookup** - Environment binding\n- ✅ **Lambda/Closure creation** - Captures environment\n- ✅ **Primitive addition** - Direct function application\n- ✅ **Lambda addition** - User-defined functions\n- ✅ **Increment with continuations** - Step-by-step execution\n- ✅ **All arithmetic primitives** - `+`, `-`, `*`, `/`\n","exit_code":0,"status":"completed"}}
