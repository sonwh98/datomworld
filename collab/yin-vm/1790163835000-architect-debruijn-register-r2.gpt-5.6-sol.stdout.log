in/vm/linearize.cljc:131:             :vm/store-put (emit! e :store-put\nsrc/cljc/yin/vm/linearize.cljc:134:             :vm/park (emit! e :park)\nsrc/cljc/yin/vm/linearize.cljc:135:             :vm/current-continuation (emit! e :current-continuation)\nsrc/cljc/yin/vm/linearize.cljc:136:             :vm/resume (do (lower-node (get-attr e :yin/val-node))\nsrc/cljc/yin/vm/linearize.cljc:284:             :dao.stream.apply/call (let [operands (nth slots 1)]\nsrc/cljc/yin/vm/linearize.cljc:291:             :stream/make (emit! path [:stream-make (nth slots 0)])\nsrc/cljc/yin/vm/linearize.cljc:292:             :stream/put (do (lower-node (nth slots 0) (conj path 2))\nsrc/cljc/yin/vm/linearize.cljc:296:             :stream/cursor (do (lower-node (nth slots 0) (conj path 2))\nsrc/cljc/yin/vm/linearize.cljc:298:             :stream/next (do (lower-node (nth slots 0) (conj path 2))\nsrc/cljc/yin/vm/linearize.cljc:300:             :stream/close (do (lower-node (nth slots 0) (conj path 2))\nsrc/cljc/yin/vm/linearize.cljc:302:             :vm/gensym (emit! path [:gensym (nth slots 0)])\nsrc/cljc/yin/vm/linearize.cljc:303:             :vm/store-get (emit! path [:store-get (nth slots 0)])\nsrc/cljc/yin/vm/linearize.cljc:304:             :vm/store-put (emit! path [:store-put (nth slots 0) (nth slots 1)])\nsrc/cljc/yin/vm/linearize.cljc:305:             :vm/park (emit! path [:park])\nsrc/cljc/yin/vm/linearize.cljc:306:             :vm/current-continuation (emit! path [:current-continuation])\nsrc/cljc/yin/vm/linearize.cljc:307:             :vm/resume (do (lower-node (nth slots 1) (conj path 3))\nsrc/cljc/yin/vm/linearize.cljc:394:    :dao.stream.apply/call (:operands node)\nsrc/cljc/yin/vm/linearize.cljc:396:    :stream/put [(:target node) (:val node)]\nsrc/cljc/yin/vm/linearize.cljc:397:    (:stream/cursor :stream/next :stream/close) [(:source node)]\nsrc/cljc/yin/vm/linearize.cljc:398:    :vm/resume [(:val node)]\n     1\t(ns yin.vm.debruijn-resolve\n     2\t  \"B2 (docs/design/yin.vm.debruijn.stack.md S3.1): the de Bruijn resolver.\n     3\t   `resolve` walks named `:yin/*` datoms once, in the named linearizer's\n     4\t   own evaluation order (operator then operands left to right, `if` test\n     5\t   then arms, a lambda's body under its own parameter vector pushed\n     6\t   innermost-first), and produces resolved tuples: one resolved record per\n     7\t   OCCURRENCE of a source node, keyed by `[source-eid lexical-context]`\n     8\t   (`lexical-context` the complete innermost-first stack of enclosing\n     9\t   parameter vectors at that occurrence). Two references to a shared source\n    10\t   entity under equal contexts hit the same record; under unequal contexts\n    11\t   they mint two distinct records, each independently resolved -- a shared\n    12\t   entity's occurrences never overwrite one another's resolution the way a\n    13\t   bare-entity-keyed memo would.\n    14\t\n    15\t   A resolved record's id is always fresh and deterministic (first-visit\n    16\t   order) and never equals its source entity's id. A `:variable` record\n    17\t   carries `:yin.resolved/depth`+`:yin.resolved/position` (bound, from\n    18\t   `resolve-name`'s `{:bound [depth position]}`) or `:yin.resolved/free`\n    19\t   (free, from `{:free name}`) in place of `:yin/name`. A `:lambda` record\n    20\t   carries `:yin.resolved/arity` in place of `:yin/params`. Every other\n    21\t   attribute is carried unchanged, including structural child refs, which\n    22\t   are rewritten to point at the child's own resolved record id. `resolve`\n    23\t   returns `{:tuples resolved-tuples, :source {resolved-id source-eid},\n    24\t   :params {resolved-lambda-id [param-symbol ...]}}`: `:source` names every\n    25\t   record's source entity (total over the records), `:params` names every\n    26\t   resolved lambda's exact parameter vector. No per-occurrence name is\n    27\t   stored; a bound occurrence's original spelling is recoverable from the\n    28\t   owning resolved lambda's parameter at the resolved position.\n    29\t\n    30\t   `resolve-name` (`yin.vm.debruijn`, line ~606) is the one helper reused\n    31\t   from the merged dormant projection namespace, exactly as section 3\n    32\t   requires; no other helper there is reached, and this namespace does\n    33\t   not touch `yin.vm.linearize` or named lowering semantics at all -- it\n    34\t   reads only named `:yin/*` datoms and the public `yin.vm/index-datoms`\n    35\t   reader `yin.vm.linearize` itself uses for the same purpose.\"\n    36\t  (:refer-clojure :exclude [resolve])\n    37\t  (:require [yin.vm :as vm]\n    38\t            [yin.vm.debruijn :as debruijn]))\n    39\t\n    40\t\n    41\t;; =============================================================================\n    42\t;; Tree shape: every supported node type's child slots, in evaluation order\n    43\t;; =============================================================================\n    44\t;; Shared by `resolve`'s build walk and `validate-resolved`'s independent\n    45\t;; check walk, so the two can never silently disagree about which entities\n    46\t;; are children of which. `:literal`, `:variable`, `:stream/make`,\n    47\t;; `:vm/gensym`, `:vm/store-get`, `:vm/store-put`, `:vm/park`, and\n    48\t;; `:vm/current-continuation` have no child slots and are leaves; `:lambda`\n    49\t;; is handled specially by every walk below because it also carries scope\n    50\t;; (a parameter vector, or its resolved arity), not only a child.\n    51\t\n    52\t(def ^:private child-slots\n    53\t  \"Node type -> ordered `[attr kind]` child slots, `kind` one of `:child`\n    54\t   (one entity ref) or `:children` (an ordered vector of entity refs).\n    55\t   Mirrors `yin.vm.linearize/flatten-program`'s own case dispatch, read\n    56\t   from the same `:yin/*` attributes, but as data instead of code.\"\n    57\t  {:application [[:yin/operator :child] [:yin/operands :children]]\n    58\t   :dao.stream.apply/call [[:yin/operands :children]]\n    59\t   :if [[:yin/test :child] [:yin/consequent :child] [:yin/alternate :child]]\n    60\t   :stream/put [[:yin/target :child] [:yin/val-node :child]]\n    61\t   :stream/cursor [[:yin/source :child]]\n    62\t   :stream/next [[:yin/source :child]]\n    63\t   :stream/close [[:yin/source :child]]\n    64\t   :vm/resume [[:yin/val-node :child]]})\n    65\t\n    66\t\n    67\t(def ^:private unsupported-types\n    68\t  \"Node types outside both evaluators' supported corpus, matching\n    69\t   `yin.vm.linearize/unsupported` exactly -- read here, not required\n    70\t   from there, since that namespace stays untouched.\"\n    71\t  #{:yin/macro-expand :vm/store-update})\n    72\t\n    73\t\n    74\t;; =============================================================================\n    75\t;; resolve: named datoms -> resolved tuples + provenance side table\n    76\t;; =============================================================================\n    77\t\n    78\t(defn- reject-host-value!\n    79\t  [source attr v]\n    80\t  (when-not (vm/plain-data? v)\n    81\t    (throw (ex-info (str \"Cannot resolve a host value into \" attr)\n    82\t                    {:node source, :attr attr, :value v}))))\n    83\t\n    84\t\n    85\t(defn- source-tm\n    86\t  \"`{source-eid [t m]}`, one entry per entity, from its first datom --\n    87\t   every datom `ast->datoms-with-root` emits for one entity shares one\n    88\t   `t`/`m` pair, so the first is exact for every attribute.\"\n    89\t  [datoms]\n    90\t  (reduce (fn [acc [e _a _v t m]]\n    91\t            (if (contains? acc e) acc (assoc acc e [t m])))\n    92\t          {}\n    93\t          datoms))\n    94\t\n    95\t\n    96\t(declare visit! validate-resolved)\n    97\t\n    98\t\n    99\t(defn- put!\n   100\t  [ctx rid source-e a v]\n   101\t  (let [[t m] (get (:tm ctx) source-e [0 :db/add])]\n   102\t    (swap! (:rows ctx) conj [rid a v t m])))\n   103\t\n   104\t\n   105\t(declare visit!)\n   106\t\n   107\t\n   108\t(defn- emit-node!\n   109\t  \"Builds one resolved record's rows (into `(:rows ctx)`) for source\n   110\t   entity `e` under `stack`, recursing into every child slot through\n   111\t   `visit!` so a child gets its own occurrence identity under this node's\n   112\t   extended `stack`/`active`/`path`. `rid` is `e`'s already-minted resolved\n   113\t   id for this occurrence.\"\n   114\t  [ctx e stack rid active path]\n   115\t  (let [get-attr (:get-attr ctx)\n   116\t        type (get-attr e :yin/type)\n   117\t        emit! (fn [a v] (put! ctx rid e a v))\n   118\t        child! (fn [child-e s] (visit! ctx child-e s active path))]\n   119\t    (when (nil? type)\n   120\t      (throw (ex-info \"Cannot resolve a node with no :yin/type\" {:entity e})))\n   121\t    (when (contains? unsupported-types type)\n   122\t      (throw (ex-info (str \"Cannot resolve unsupported node \" type)\n   123\t                      {:type type, :entity e})))\n   124\t    (when-let [tail? (get-attr e :yin/tail?)]\n   125\t      (emit! :yin/tail? tail?))\n   126\t    (case type\n   127\t      :literal\n   128\t      (let [val (get-attr e :yin/value)]\n   129\t        (reject-host-value! e :yin/value val)\n   130\t        (emit! :yin/type :literal)\n   131\t        (emit! :yin/value val))\n   132\t\n   133\t      :variable\n   134\t      (let [name (get-attr e :yin/name)]\n   135\t        (reject-host-value! e :yin/name name)\n   136\t        (emit! :yin/type :variable)\n   137\t        (let [resolution (debruijn/resolve-name stack name)]\n   138\t          (if-let [bound (:bound resolution)]\n   139\t            (do (emit! :yin.resolved/depth (nth bound 0))\n   140\t                (emit! :yin.resolved/position (nth bound 1)))\n   141\t            (emit! :yin.resolved/free (:free resolution)))))\n   142\t\n   143\t      :lambda\n   144\t      (let [params (get-attr e :yin/params)\n   145\t            macro? (get-attr e :yin/macro?)]\n   146\t        (reject-host-value! e :yin/params params)\n   147\t        (emit! :yin/type :lambda)\n   148\t        (when macro? (emit! :yin/macro? macro?))\n   149\t        (emit! :yin.resolved/arity (count params))\n   150\t        (swap! (:params ctx) assoc rid params)\n   151\t        (let [body-rid (child! (get-attr e :yin/body) (into [params] stack))]\n   152\t          (emit! :yin/body body-rid)))\n   153\t\n   154\t      :application\n   155\t      (do (emit! :yin/type :application)\n   156\t          (let [op-rid (child! (get-attr e :yin/operator) stack)\n   157\t                operand-rids (mapv #(child! % stack) (get-attr e :yin/operands))]\n   158\t            (emit! :yin/operator op-rid)\n   159\t            (emit! :yin/operands operand-rids)))\n   160\t\n   161\t      :dao.stream.apply/call\n   162\t      (let [op (get-attr e :yin/op)]\n   163\t        (reject-host-value! e :yin/op op)\n   164\t        (emit! :yin/type :dao.stream.apply/call)\n   165\t        (emit! :yin/op op)\n   166\t        (emit! :yin/operands (mapv #(child! % stack) (get-attr e :yin/operands))))\n   167\t\n   168\t      :if\n   169\t      (do (emit! :yin/type :if)\n   170\t          (let [test-rid (child! (get-attr e :yin/test) stack)\n   171\t                cons-rid (child! (get-attr e :yin/consequent) stack)\n   172\t                alt-rid (child! (get-attr e :yin/alternate) stack)]\n   173\t            (emit! :yin/test test-rid)\n   174\t            (emit! :yin/consequent cons-rid)\n   175\t            (emit! :yin/alternate alt-rid)))\n   176\t\n   177\t      :vm/gensym\n   178\t      (let [prefix (get-attr e :yin/prefix)]\n   179\t        (reject-host-value! e :yin/prefix prefix)\n   180\t        (emit! :yin/type :vm/gensym)\n   181\t        (emit! :yin/prefix prefix))\n   182\t\n   183\t      :vm/store-get\n   184\t      (let [key (get-attr e :yin/key)]\n   185\t        (reject-host-value! e :yin/key key)\n   186\t        (emit! :yin/type :vm/store-get)\n   187\t        (emit! :yin/key key))\n   188\t\n   189\t      :vm/store-put\n   190\t      (let [key (get-attr e :yin/key)\n   191\t            val (get-attr e :yin/value)]\n   192\t        (reject-host-value! e :yin/key key)\n   193\t        (reject-host-value! e :yin/value val)\n   194\t        (emit! :yin/type :vm/store-put)\n   195\t        (emit! :yin/key key)\n   196\t        (emit! :yin/value val))\n   197\t\n   198\t      :stream/make\n   199\t      (let [buffer (get-attr e :yin/buffer)]\n   200\t        (reject-host-value! e :yin/buffer buffer)\n   201\t        (emit! :yin/type :stream/make)\n   202\t        (emit! :yin/buffer buffer))\n   203\t\n   204\t      :stream/put\n   205\t      (do (emit! :yin/type :stream/put)\n   206\t          (let [target-rid (child! (get-attr e :yin/target) stack)\n   207\t                val-rid (child! (get-attr e :yin/val-node) stack)]\n   208\t            (emit! :yin/target target-rid)\n   209\t            (emit! :yin/val-node val-rid)))\n   210\t\n   211\t      (:stream/cursor :stream/next :stream/close)\n   212\t      (do (emit! :yin/type type)\n   213\t          (emit! :yin/source (child! (get-attr e :yin/source) stack)))\n   214\t\n   215\t      :vm/park\n   216\t      (emit! :yin/type :vm/park)\n   217\t\n   218\t      :vm/current-continuation\n   219\t      (emit! :yin/type :vm/current-continuation)\n   220\t\n   221\t      :vm/resume\n   222\t      (let [parked-id (get-attr e :yin/parked-id)]\n   223\t        (reject-host-value! e :yin/parked-id parked-id)\n   224\t        (emit! :yin/type :vm/resume)\n   225\t        (emit! :yin/parked-id parked-id)\n   226\t        (emit! :yin/val-node (child! (get-attr e :yin/val-node) stack)))\n   227\t\n   228\t      (throw (ex-info (str \"Cannot resolve node of unknown type \" type)\n   229\t                      {:type type, :entity e})))))\n   230\t\n   231\t\n   232\t(defn- visit!\n   233\t  \"Returns the resolved id for source entity `e`'s occurrence under\n   234\t   `stack`, minting a fresh one and emitting its rows on first visit,\n   235\t   reusing the memoized id for a repeat of the same `[e stack]` occurrence.\n   236\t   `active` (source entities on the current DFS path) is checked before\n   237\t   the memo, matching the dormant projection's own `project-node`: an\n   238\t   entity revisited before its own resolution has completed is a cycle\n   239\t   even if some other occurrence of it was already memoized.\"\n   240\t  [ctx e stack active path]\n   241\t  (when (contains? active e)\n   242\t    (throw (ex-info \"Cyclic AST reference\"\n   243\t                    {:rule :cycle, :entity e, :path path})))\n   244\t  (let [occ [e stack]]\n   245\t    (if-let [existing (find @(:memo ctx) occ)]\n   246\t      (val existing)\n   247\t      (let [rid ((:next-id! ctx))]\n   248\t        (swap! (:memo ctx) assoc occ rid)\n   249\t        (swap! (:source ctx) assoc rid e)\n   250\t        (emit-node! ctx e stack rid (conj active e) (conj path e))\n   251\t        rid))))\n   252\t\n   253\t\n   254\t(defn resolve\n   255\t  \"Named `:yin/*` datoms (or an `:yin/root`-marked batch of them) ->\n   256\t   `{:tuples resolved-tuples, :source side-table, :params side-table}`\n   257\t   (section 3.1). Every occurrence of a source node gets its own resolved\n   258\t   record and id (never equal to the source id); `:source` maps every\n   259\t   record id to its source entity, `:params` maps every resolved lambda's\n   260\t   id to its exact parameter vector. A `:variable` record carries\n   261\t   `:yin.resolved/depth`+`:yin.resolved/position` or `:yin.resolved/free`\n   262\t   in place of `:yin/name`; a `:lambda` record carries\n   263\t   `:yin.resolved/arity` in place of `:yin/params`. Every other attribute,\n   264\t   including `:yin/tail?` and every structural child ref (rewritten to the\n   265\t   child's own record id), is carried unchanged.\n   266\t\n   267\t   Throws naming the node on an unsupported or unknown node type, a host\n   268\t   value in a data operand (exactly as `yin.vm.linearize/lower` throws for\n   269\t   the same conditions on the same input), or a cyclic reference. Also\n   270\t   runs `validate-resolved` on the tuples and side table it just built,\n   271\t   before returning them, so a program whose bound reference would fall\n   272\t   outside its enclosing arity chain -- impossible from this function's own\n   273\t   walk, but not from a hand-built resolved-tuple set -- is refused here\n   274\t   rather than reaching a lowerer.\"\n   275\t  [named-datoms]\n   276\t  (let [datoms (vec named-datoms)\n   277\t        {:keys [get-attr root-id error]} (vm/index-datoms datoms)]\n   278\t    (when error\n   279\t      (throw (ex-info \"Cannot resolve a program with a dangling root\" error)))\n   280\t    (when (nil? root-id)\n   281\t      (throw (ex-info \"Cannot resolve a program with no root\" {})))\n   282\t    (let [ctx {:get-attr get-attr\n   283\t               :memo (atom {})\n   284\t               :source (atom {})\n   285\t               :params (atom {})\n   286\t               :rows (atom [])\n   287\t               :next-id! (let [counter (atom -1)]\n   288\t                           #(let [id @counter] (swap! counter dec) id))\n   289\t               :tm (source-tm datoms)}\n   290\t          root-rid (visit! ctx root-id [] #{} [])\n   291\t          [t m] (get (:tm ctx) root-id [0 :db/add])\n   292\t          _ (swap! (:rows ctx) conj [root-rid :yin/root true t m])\n   293\t          tuples (vec @(:rows ctx))\n   294\t          source @(:source ctx)\n   295\t          params @(:params ctx)\n   296\t          defect (validate-resolved tuples source)]\n   297\t      (when defect\n   298\t        (throw (ex-info \"Cannot resolve to an invalid resolved-tuple set\"\n   299\t                        {:defect defect})))\n   300\t      {:tuples tuples, :source source, :params params})))\n   100\t        mark! (fn [l] (swap! labels assoc l (count @code)))\n   101\t        emit! (fn [e tuple] (swap! code conj [e tuple]))]\n   102\t    (letfn\n   103\t      [(lower-node\n   104\t         [e]\n   105\t         (let [type (get-attr e :yin/type)]\n   106\t           (case type\n   107\t             :literal (emit! e [:const (get-attr e :yin/value)])\n   108\t             :variable (let [free (get-attr e :yin.resolved/free)]\n   109\t                         (emit! e (if (some? free)\n   110\t                                    [:load-free free]\n   111\t                                    [:load-bound (get-attr e :yin.resolved/depth)\n   112\t                                     (get-attr e :yin.resolved/position)])))\n   113\t             :lambda (let [l (fresh!)]\n   114\t                       (swap! bodies conj [l e (get-attr e :yin/body)])\n   115\t                       (emit! e [:closure (get-attr e :yin.resolved/arity) l]))\n   116\t             :application (let [operands (get-attr e :yin/operands)]\n   117\t                            (lower-node (get-attr e :yin/operator))\n   118\t                            (emit! e [:push])\n   119\t                            (doseq [o operands]\n   120\t                              (lower-node o)\n   121\t                              (emit! e [:push]))\n   122\t                            (emit! e [:call (count operands)\n   123\t                                      (boolean (get-attr e :yin/tail?))]))\n   124\t             :if (let [else (fresh!), end (fresh!)]\n   125\t                   (lower-node (get-attr e :yin/test))\n   126\t                   (emit! e [:branch-false else])\n   127\t                   (lower-node (get-attr e :yin/consequent))\n   128\t                   (emit! e [:jump end])\n   129\t                   (mark! else)\n   130\t                   (lower-node (get-attr e :yin/alternate))\n   131\t                   (mark! end))\n   132\t             :dao.stream.apply/call (let [operands (get-attr e :yin/operands)]\n   133\t                                      (doseq [o operands]\n   134\t                                        (lower-node o)\n   135\t                                        (emit! e [:push]))\n   136\t                                      (emit! e [:ffi-call (get-attr e :yin/op)\n   137\t                                                (count operands)]))\n   138\t             :stream/make (emit! e [:stream-make (get-attr e :yin/buffer)])\n   139\t             :stream/put (do (lower-node (get-attr e :yin/target))\n   140\t                             (emit! e [:push])\n   141\t                             (lower-node (get-attr e :yin/val-node))\n   142\t                             (emit! e [:stream-put]))\n   143\t             :stream/cursor (do (lower-node (get-attr e :yin/source))\n   144\t                                (emit! e [:stream-cursor]))\n   145\t             :stream/next (do (lower-node (get-attr e :yin/source))\n   146\t                              (emit! e [:stream-next]))\n   147\t             :stream/close (do (lower-node (get-attr e :yin/source))\n   148\t                               (emit! e [:stream-close]))\n   149\t             :vm/gensym (emit! e [:gensym (get-attr e :yin/prefix)])\n   150\t             :vm/store-get (emit! e [:store-get (get-attr e :yin/key)])\n   151\t             :vm/store-put (emit! e [:store-put (get-attr e :yin/key)\n   152\t                                     (get-attr e :yin/value)])\n   153\t             :vm/park (emit! e [:park])\n   154\t             :vm/current-continuation (emit! e [:current-continuation])\n   155\t             :vm/resume (do (lower-node (get-attr e :yin/val-node))\n   156\t                            (emit! e [:resume (get-attr e :yin/parked-id)]))\n   157\t             (throw (ex-info (str \"Cannot lower-stack resolved node of type \" type)\n   158\t                             {:type type, :entity e})))))]\n   159\t      (lower-node root)\n   160\t      (emit! root [:halt])\n   161\t      ;; A body may hold lambdas of its own, which append to `bodies` while\n   162\t      ;; this loop runs.\n   163\t      (loop [i 0]\n   164\t        (when-let [[l lambda body] (get @bodies i)]\n   165\t          (mark! l)\n   166\t          (lower-node body)\n   167\t          (emit! lambda [:return])\n   168\t          (recur (inc i))))\n   169\t      [@code @labels])))\n   170\t\n   171\t\n   172\t(defn- resolve-labels\n   173\t  [pairs labels]\n   174\t  (mapv (fn [[e t]]\n   175\t          [e (case (nth t 0)\n   176\t               (:jump :branch-false) (assoc t 1 (get labels (nth t 1)))\n   177\t               :closure (assoc t 2 (get labels (nth t 2)))\n   178\t               t)])\n   179\t        pairs))\n   180\t\n   181\t\n   182\t(defn- pc-side-table\n   183\t  \"`{pc {:kind :closure, :params [sym ...], :source e}}` for every\n   184\t   `:closure` pc, read from the params side table by resolved lambda id,\n   185\t   and `{pc {:kind :var, :source e}}` for every load pc (section 3.2).\n   186\t   `e` is always the NAMED source entity, read through the provenance\n   187\t   `:source` map -- `sources` carries resolved record ids, which never\n   188\t   equal the source ids `lower`'s own `:yin.code/source` names.\"\n   189\t  [image sources source-of params]\n   190\t  (into {}\n   191\t        (keep (fn [pc]\n   192\t                (let [t (nth image pc), rid (nth sources pc)]\n   193\t                  (case (nth t 0)\n   194\t                    :closure [pc {:kind :closure,\n   195\t                                  :params (get params rid),\n   196\t                                  :source (get source-of rid)}]\n   197\t                    (:load-bound :load-free) [pc {:kind :var, :source (get source-of rid)}]\n   198\t                    nil))))\n   199\t        (range (count image))))\n   200\t\n   201\t\n   202\t(defn lower-stack\n   203\t  \"`{:keys [tuples source params]}` (`yin.vm.debruijn-resolve/resolve`'s\n   204\t   own return shape) -> `{:image v, :side-table st}`: `v` a\n   205\t   `:yin.debruijn.code/*`-shaped canonical instruction vector, `st` the\n   206\t   pc-keyed diagnostic side table section 3.2 specifies.\n   207\t\n   208\t   Calls `yin.vm.debruijn-resolve/validate-resolved` first and refuses on\n   209\t   its diagnostic, before doing anything else -- a shape-valid resolved\n   210\t   set with an out-of-range bound reference is rejected here even when it\n   211\t   never came from `resolve` itself.\"\n   212\t  [{:keys [tuples source params]}]\n   213\t  (when-let [defect (resolve/validate-resolved tuples source)]\n   214\t    (throw (ex-info \"Cannot lower-stack an invalid resolved-tuple set\"\n   215\t                    {:defect defect})))\n   216\t  (let [{:keys [get-attr root-id error]} (vm/index-datoms tuples)]\n   217\t    (when error\n   218\t      (throw (ex-info \"Cannot lower-stack a program with a dangling root\" error)))\n   219\t    (when (nil? root-id)\n   220\t      (throw (ex-info \"Cannot lower-stack a program with no root\" {})))\n   221\t    (let [[pairs labels] (flatten-resolved get-attr root-id)\n   222\t          resolved-pairs (resolve-labels pairs labels)\n   223\t          image (mapv second resolved-pairs)\n   224\t          sources (mapv first resolved-pairs)]\n   225\t      {:image image, :side-table (pc-side-table image sources source params)})))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; adapt: named datoms -> de Bruijn image + side table\n   230\t;; =============================================================================\n   231\t\n   232\t(defn adapt\n   233\t  \"The composition `lower-stack` after `resolve` (section 3.2): the one\n   234\t   public entry that takes named `:yin/*` datoms straight to a\n   235\t   `:yin.debruijn.code/*` image and its pc-keyed diagnostic side table.\"\n   236\t  [named-datoms]\n   237\t  (lower-stack (resolve/resolve named-datoms)))\n   238\t\n   239\t\n   240\t;; =============================================================================\n   241\t;; lift: de Bruijn image + side table -> named canonical vector\n   242\t;; =============================================================================\n   243\t;; This is genuinely different machinery from the resolver's tree walk\n   244\t;; above: `lift` starts from a flat `:yin.debruijn.code/*` image, which\n   245\t;; has no tree to walk, so it still needs to know, for a given pc, its\n   246\t;; enclosing `:closure` chain -- the same information the removed fused\n   247\t;; implementation's `body-owner`/`chain-of` computed, but only ever over\n   248\t;; a de Bruijn image (never a named vector: resolution itself no longer\n   249\t;; runs at this level) and only ever over an image B1's own validator has\n   250\t;; already accepted. `lift`/`lift-once` therefore have this as a\n   251\t;; documented precondition: they raise (an unchecked `ex-info` or an\n   252\t;; index-out-of-bounds, not a named diagnostic) on a scope-invalid image\n   253\t;; rather than repeating B1's `image-defect`, since B1's validator is the\n   254\t;; sole admitter of an executable image on this path.\n   255\t\n   256\t(defn- closure-ranges\n   257\t  \"`[[c body r] ...]` for every `:closure` of a B1-valid de Bruijn image\n   258\t   `v`: the closure at pc `c` has body `[body, r]`, `r` the first\n   259\t   `:return` at or after `body`. Trusts `v` is already scope valid (the\n   260\t   precondition above); does not repeat B1's `image-defect`.\"\n   261\t  [v]\n   262\t  (let [n (count v)]\n   263\t    (keep (fn [c]\n   264\t            (let [t (nth v c)]\n   265\t              (when (= :closure (nth t 0))\n   266\t                (let [body (nth t 2)]\n   267\t                  [c body (first (filter #(= :return (nth (nth v %) 0))\n   268\t                                         (range body n)))]))))\n   269\t          (range n))))\n   270\t\n   271\t\n   272\t(defn- owner-of\n   273\t  \"pc -> the pc of the innermost `:closure` whose body range covers it,\n   274\t   absent for a pc in the main sequence.\"\n   275\t  [v]\n   276\t  (into {}\n   277\t        (mapcat (fn [[c body r]] (map (fn [pc] [pc c]) (range body (inc r)))))\n   278\t        (closure-ranges v)))\n   279\t\n   280\t\n   281\t(defn- chain-of\n   282\t  \"The enclosing-closure-pc chain of `pc`, innermost first.\"\n   283\t  [owner pc]\n   284\t  (loop [p pc, chain []]\n   285\t    (if-let [c (get owner p)]\n   286\t      (recur c (conj chain c))\n   287\t      chain)))\n   288\t\n   289\t\n   290\t(defn- free-names-of\n   291\t  [v]\n   292\t  (into #{} (keep (fn [t] (when (= :load-free (nth t 0)) (nth t 1)))) v))\n   293\t\n   294\t\n   295\t(defn- synthesize-name\n   296\t  \"A symbol not in `used`, distinct for `[c i]` (`c` the owning `:closure`\n   297\t   pc, `i` the parameter position) so two different binders never\n   298\t   accidentally synthesize the same spelling.\"\n   299\t  [used c i]\n   300\t  (loop [n 0]\n   301\t    (let [candidate (symbol (str \"g__\" c \"_\" i (when (pos? n) (str \"_\" n))))]\n   302\t      (if (contains? used candidate)\n   303\t        (recur (inc n))\n   304\t        candidate))))\n   305\t\n   306\t\n   307\t(defn- lift-params\n   308\t  \"pc -> parameter vector for every `:closure` of de Bruijn image `v`:\n   309\t   `side-table`'s recorded parameters when present and of matching arity,\n   310\t   else fresh names synthesized against `v`'s own free-name set and every\n   311\t   parameter already assigned -- so a synthesized name never shadows a\n   312\t   free name or collides with another synthesized binder anywhere in the\n   313\t   image. `side-table` may be nil (full synthesis).\"\n   314\t  [v side-table]\n   315\t  (let [free (free-names-of v)\n   316\t        closure-pcs (keep-indexed (fn [pc t] (when (= :closure (nth t 0)) pc)) v)]\n   317\t    (reduce\n   318\t      (fn [acc c]\n   319\t        (let [arity (nth (nth v c) 1)\n   320\t              given (get-in side-table [c :params])\n   321\t              used (into free (mapcat identity) (vals acc))\n   322\t              params (if (and given (= (count given) arity))\n   323\t                       given\n   324\t                       (mapv #(synthesize-name used c %) (range arity)))]\n   325\t          (assoc acc c params)))\n   326\t      {}\n   327\t      closure-pcs)))\n   328\t\n   329\t\n   330\t(defn- lift-once\n   331\t  \"De Bruijn image `v` -> a named canonical vector, using `lift-params`'s\n   332\t   pc -> parameter-vector map. `:load-bound [depth position]` becomes\n   333\t   `[:var name]`, `name` read from the enclosing `:closure`'s parameter\n   334\t   vector at `position`. `:load-free [name]` becomes `[:var name]`\n   335\t   directly. `:closure`'s arity becomes its parameter vector. Every other\n   336\t   tuple is copied unchanged.\"\n   337\t  [v side-table]\n   338\t  (let [owner (owner-of v)\n   339\t        params (lift-params v side-table)]\n   340\t    (mapv (fn [pc]\n   341\t            (let [t (nth v pc), op (nth t 0)]\n   342\t              (case op\n   343\t                :load-bound\n   344\t                (let [depth (nth t 1), position (nth t 2)\n   345\t                      chain (chain-of owner pc)\n   346\t                      c (nth chain depth)]\n   347\t                  [:var (nth (get params c) position)])\n   348\t\n   349\t                :load-free [:var (nth t 1)]\n   350\t\n   351\t                :closure [:closure (get params pc) (nth t 2)]\n   352\t\n   353\t                t)))\n   354\t          (range (count v)))))\n   355\t\n   356\t\n   357\t(defn- round-trips?\n   358\t  \"Whether `params` (a candidate pc -> parameter-vector map, from\n   359\t   `lift-params`) would resolve every load in `v` back to the exact\n   360\t   depth/position (`:load-bound`) or exact freeness (`:load-free`) it\n","exit_code":0,"status":"completed"}}
