ce/index.cljc:104:           ;; referencing the JVM-only ClassCastException, which doesn't\nsrc/cljc/dao/space/index.cljc:107:                     :clj ClassCastException\nsrc/cljc/dao/space/index.cljc:323:                                                      :clj Throwable\nsrc/cljc/dao/space/index.cljc:1333:              :clj Throwable\nsrc/cljc/dao/stream/waitset.cljc:129:    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n(ns dao.data\n  \"Bounded, plain-data descriptions of arbitrary values\n   (docs/design/dao.data.md).\n\n   `tag` classifies a value without entering it; `summarize` turns a value\n   into a `{:depth :items :chars}`-bounded tree of tagged plain data — safe\n   to append, print, or ship. No functions, stream handles, or host objects\n   survive into the result. This is the parent namespace's own file, sitting\n   alongside the `dao.data.*` sub-namespaces; neither depends on the other.\"\n  (:require [dao.stream :as stream]\n            [dao.stream.transit :as transit]))\n\n\n(defn tag\n  \"Classify x without entering it.\n\n   The descriptor check precedes `map?`/`sequential?` because a handle may\n   be a record. `stream/descriptor?` alone is enough: every handle\n   implements it, regardless of declared surfaces.\"\n  [x]\n  (cond (nil? x) :nil\n        (boolean? x) :boolean\n        (number? x) :number\n        (string? x) :string\n        (keyword? x) :keyword\n        (symbol? x) :symbol\n        (fn? x) :fn\n        (stream/descriptor? x) :stream\n        (vector? x) :vector\n        (set? x) :set\n        (map? x) :map\n        (sequential? x) :sequence\n        :else :opaque))\n\n\n(declare summarize)\n\n\n(defn- char-node\n  \"The one leaf-bound rule, shared by strings and printed keywords/symbols.\n   Over `chars`, the cut printed form stands in for the value — a partial\n   name isn't a valid keyword or symbol to begin with. A stream's identity\n   gets no bespoke rule; it reuses this one by being summarized like any\n   other value.\"\n  [type x printed chars]\n  (let [truncated? (> (count printed) chars)]\n    {:dao.data/type type\n     :dao.data/value (if truncated? (subs printed 0 chars) x)\n     :dao.data/truncated? truncated?}))\n\n\n(defn- number-node\n  \"A number outside the live wire codec's portable domain — non-finite, a\n   ratio, a BigInt/BigDecimal, or outside ±9007199254740991 — is stringified\n   rather than preserved. `portable-value?` is the actual check the v2 wire\n   boundary applies, so this can't drift from the real contract.\"\n  [x]\n  (if (transit/portable-value? x)\n    {:dao.data/type :number :dao.data/value x :dao.data/truncated? false}\n    {:dao.data/type :number :dao.data/value (str x) :dao.data/truncated? true}))\n\n\n(defn- stream-node\n  \"The identity projection of the descriptor outcome — not the whole\n   `:dao.stream/descriptor` envelope — summarized with the same bounds,\n   since it isn't a child of a container being walked. A conforming\n   descriptor never fails on a value satisfying `descriptor?`; the\n   `:opaque` fallback covers only a non-conforming implementation.\"\n  [x bounds]\n  (let [result (stream/descriptor x)]\n    (if (= :dao.stream/ok (:dao.stream/outcome result))\n      {:dao.data/type :stream\n       :dao.data/identity (summarize (:dao.stream/identity result) bounds)}\n      {:dao.data/type :opaque})))\n\n\n(defn- container-node\n  \"The shared `:depth`/`:items` rule for `:vector`, `:set`, `:sequence`, and\n   `:map` (entries, not items). `:count` is decided by `counted?` alone,\n   before any probing — never inferred from what a probe happened to find.\n   A non-`counted?` sequence is asked for at most `:items` + 1 elements:\n   enough to fill `:items` and check that a next one exists, no more. At\n   depth 0 a non-`counted?` sequence isn't probed at all — nothing in the\n   result would depend on the answer.\"\n  [type x bounds]\n  (let [{:keys [depth items]} bounds\n        counted (counted? x)]\n    (if (zero? depth)\n      (cond-> {:dao.data/type type :dao.data/truncated? true}\n        counted (assoc :dao.data/count (count x)))\n      (let [child-bounds (assoc bounds :depth (dec depth))\n            probe (take (if counted items (inc items)) x)\n            truncated? (if counted\n                         (< items (count x))\n                         (< items (count probe)))\n            shown (take items probe)\n            pairs (if (= :map type)\n                    (mapv (fn [[k v]]\n                            [(summarize k child-bounds)\n                             (summarize v child-bounds)])\n                          shown)\n                    (mapv #(summarize % child-bounds) shown))]\n        (cond-> {:dao.data/type type :dao.data/truncated? truncated?}\n          counted (assoc :dao.data/count (count x))\n          true (assoc (if (= :map type) :dao.data/entries :dao.data/items)\n                      pairs))))))\n\n\n(defn summarize\n  \"Bounded plain-data description of x under {:depth n :items n :chars n}.\n\n   Every node is a map tagged `:dao.data/type` — scalars too, so a result is\n   never ambiguous with an ordinary value. `:items`/`:entries` is absent at\n   depth 0 and is always a plain vector, never the input's own collection\n   type. Leaf truncation (string, number, keyword, symbol) is governed by\n   `:chars` and unaffected by `:depth`.\"\n  [x bounds]\n  (case (tag x)\n    :nil {:dao.data/type :nil}\n    :boolean {:dao.data/type :boolean :dao.data/value x}\n    :number (number-node x)\n    :string (char-node :string x x (:chars bounds))\n    :keyword (char-node :keyword x (str x) (:chars bounds))\n    :symbol (char-node :symbol x (str x) (:chars bounds))\n    :fn {:dao.data/type :fn}\n    :opaque {:dao.data/type :opaque}\n    :stream (stream-node x bounds)\n    (container-node (tag x) x bounds)))\n5:   descriptor, its derived opcode table, its own exact scalar encoder, the\n24:   This dimension's own executable scalar encoder is deliberately\n32:   `host-supported-scalar-classes`).\n35:   and `encode-scalar` all go from an already-constructed Clojure value\n36:   (a hand-built canonical instruction vector, or a scalar inside one) to\n95:(def scalar-classes\n96:  \"This dimension's own executable scalar domain (S2), in the fixed order\n107:  \"Bumped whenever this dimension's opcode table, scalar table, or byte\n124:   `encode-scalar`), so an editorial change to a hashed sentence would\n135:     :scalar-classes scalar-classes,\n200:  (into {} (map-indexed (fn [i c] [c (to-hex i 2)])) scalar-classes))\n247:;; Host scalar classification (S2 item 4)\n281:   one-codepoint string (verified: `(dc/scalar-class \\\"a\\\")` returned\n339:   Float distinction from a plain number to lose, so the complement rule\n346:(defn scalar-class\n347:  \"Classify `v` under this dimension's own S2 scalar domain: the class\n352:   rule (`encode-scalar` owns the bytes).\"\n365:    (vector? v) (when (every? #(some? (scalar-class %)) v) :vector)\n368:                                  (and (some? (scalar-class k))\n369:                                       (some? (scalar-class x))))\n372:    (set? v) (when (every? #(some? (scalar-class %)) v) :set)\n373:    (sequential? v) (when (every? #(some? (scalar-class %)) v) :list)\n377:(defn scalar-value?\n379:  (some? (scalar-class v)))\n382:(def host-supported-scalar-classes\n383:  \"The scalar classes this host's encoder can represent (S2 item 4/5):\n390:        scalar-classes))\n394:;; The exact executable scalar encoder (S2 item 3)\n406:(defn encode-scalar\n407:  \"This dimension's own scalar encoder (S2 item 3), deliberately distinct\n411:   encoded bytes. A value outside `scalar-class`'s domain -- including an\n416:  (case (scalar-class v)\n439:                           (throw (ex-info \"Ratio component outside int64 range in executable scalar encoding\"\n448:    :vector (framed :vector (apply str (map encode-scalar v)))\n449:    :list (framed :list (apply str (map encode-scalar v)))\n450:    :map (let [entries (sort (map (fn [[k x]] [(encode-scalar k) (encode-scalar x)]) v))]\n455:    :set (let [elements (sort (map encode-scalar v))]\n460:    (throw (ex-info \"Unsupported value in executable scalar encoding\"\n490:   :kw operand is a scalar under `encode-scalar` (a bare symbol or\n498:    (:data :sym :kw) (encode-scalar x)\n499:    ;; a non-nil :str operand is a string, i.e. exactly `encode-scalar`'s\n503:    :str (if (nil? x) (framed :string \"\") (encode-scalar x))\n530:  (jing/sha256 (encode-scalar descriptor)))\n538:   exact scalar bytes. `jing/sha256`, not `jing/sha256-bytes`: this\n550:;; Host-boundary scalar-class support (S2 item 5)\n553:(defn image-scalar-classes\n554:  \"Every scalar class this image uses, scanned from every :data-kind\n557:   bytes too and a scalar class hiding only there would let S2's host-\n565:                                  (when (= :data kind) (scalar-class (nth t (inc i)))))\n572:  (set/difference (image-scalar-classes v) host-supported-scalar-classes))\n576:  \"S2 item 5's host-boundary refusal: nil when every scalar class `v`\n639:(def ^:private operand-kind-checks\n643:  {:data vm/plain-data?,\n647:   ;; guard `encode-scalar` applies to a :string value), so a malformed\n661:                    (let [check (get operand-kind-checks (nth kinds (dec i)))]\n846:(defn image-defect\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '700,740p' && nl -ba src/cljc/yin/vm/debruijn_code.cljc | sed -n '470,690p' && nl -ba src/cljc/yin/vm/debruijn_code.cljc | sed -n '820,875p' && nl -ba src/cljc/yin/vm/code.cljc | sed -n '180,250p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '700,740p' && nl -ba src/cljc/yin/vm/debruijn_code.cljc | sed -n '470,690p' && nl -ba src/cljc/yin/vm/debruijn_code.cljc | sed -n '820,875p' && nl -ba src/cljc/yin/vm/code.cljc | sed -n '180,250p'\"","aggregated_output":"   700\t                     (assoc base\n   701\t                            :target (recur-ast target-eid)\n   702\t                            :val (recur-ast val-eid)))\n   703\t       :stream/cursor (assoc base\n   704\t                             :source (recur-ast (get-attr root-id :yin/source)))\n   705\t       :stream/next (assoc base\n   706\t                           :source (recur-ast (get-attr root-id :yin/source)))\n   707\t       :stream/close (assoc base\n   708\t                            :source (recur-ast (get-attr root-id :yin/source)))\n   709\t       :vm/park base\n   710\t       :vm/resume (let [val-eid (get-attr root-id :yin/val-node)]\n   711\t                    (assoc base\n   712\t                           :parked-id (get-attr root-id :yin/parked-id)\n   713\t                           :val (recur-ast val-eid)))\n   714\t       :vm/current-continuation base\n   715\t       ;; fallback\n   716\t       (throw (ex-info \"Unknown AST node type in datoms\"\n   717\t                       {:type node-type, :root-id root-id}))))))\n   718\t\n   719\t\n   720\t(defn plain-data?\n   721\t  \"True when `x` is data a row or code datom may carry (§2.2, §2.5): scalars\n   722\t   and collections of them, never a host function or object. Metadata\n   723\t   travels with the value, so it must be plain data too.\"\n   724\t  [x]\n   725\t  (or (nil? x)\n   726\t      (and (cond (or (boolean? x) (number? x) (string? x) (keyword? x)\n   727\t                     (symbol? x))\n   728\t                 true\n   729\t                 (map? x) (and (every? plain-data? (keys x))\n   730\t                               (every? plain-data? (vals x)))\n   731\t                 (coll? x) (every? plain-data? x)\n   732\t                 :else false)\n   733\t           (plain-data? (meta x)))))\n   734\t\n   735\t\n   736\t(defn occurrence-origin?\n   737\t  \"True when `origin` has one of §2.5's portable ruled shapes. `nil` is not\n   738\t   an occurrence; it is accepted separately by the legacy bare-row lane.\n   739\t\n   740\t   A source origin is `[:source medium batch-token member-index]`. Medium and\n   470\t   iteration order on any host: the mnemonic keywords sorted.\"\n   471\t  (vec (sort mnemonics)))\n   472\t\n   473\t\n   474\t(def ^:private mnemonic-tag\n   475\t  (into {} (map-indexed (fn [i m] [m (to-hex i 2)])) canonical-mnemonic-order))\n   476\t\n   477\t\n   478\t(defn- mnemonic-of\n   479\t  [t]\n   480\t  (when (and (vector? t) (seq t)) (nth t 0)))\n   481\t\n   482\t\n   483\t(defn- tuple-kinds\n   484\t  [t]\n   485\t  (mapv second (get opcode-table (mnemonic-of t))))\n   486\t\n   487\t\n   488\t(defn- encode-operand\n   489\t  \"One operand's bytes under its declared kind (S2 item 6): a :data/:sym/\n   490\t   :kw operand is a scalar under `encode-scalar` (a bare symbol or\n   491\t   keyword is already inside that domain); :str and :bool are framed\n   492\t   directly; :uint, :pc, and :buffer are fixed-width 8-byte little-endian\n   493\t   integers with no tag or length prefix at all -- self-delimiting by\n   494\t   construction, since every tuple's arity is fixed by its mnemonic, so a\n   495\t   framing tag would only be redundant weight.\"\n   496\t  [kind x]\n   497\t  (case kind\n   498\t    (:data :sym :kw) (encode-scalar x)\n   499\t    ;; a non-nil :str operand is a string, i.e. exactly `encode-scalar`'s\n   500\t    ;; :string class -- routed through it rather than framed directly, so\n   501\t    ;; it gets the same well-formed-utf16? guard a :const string value\n   502\t    ;; already gets, instead of hashing an unpaired surrogate unrefused\n   503\t    :str (if (nil? x) (framed :string \"\") (encode-scalar x))\n   504\t    :bool (framed :bool (if x \"01\" \"00\"))\n   505\t    (:uint :pc :buffer) (int64-le-hex (or x 0))))\n   506\t\n   507\t\n   508\t(defn- encode-tuple\n   509\t  [t]\n   510\t  (let [kinds (tuple-kinds t)]\n   511\t    (apply str (get mnemonic-tag (mnemonic-of t))\n   512\t           (map-indexed (fn [i kind] (encode-operand kind (nth t (inc i)))) kinds))))\n   513\t\n   514\t\n   515\t(defn encode-image\n   516\t  \"The canonical positional instruction vector's own bytes (S2 item 6):\n   517\t   every pc-indexed tuple's bytes, in pc order, concatenated with no\n   518\t   outer header -- pc order and each tuple's fixed arity are the only\n   519\t   framing the whole vector needs.\"\n   520\t  [v]\n   521\t  (apply str (map encode-tuple v)))\n   522\t\n   523\t\n   524\t(def descriptor-hash\n   525\t  \"The descriptor's own content hash, under this dimension's own\n   526\t   encoder -- the same 'hash the descriptor through its own canonical\n   527\t   encoder' shape `yin.vm.debruijn/dimension-hash` uses for its\n   528\t   descriptor, computed here with this dimension's distinct encoder\n   529\t   rather than that one.\"\n   530\t  (jing/sha256 (encode-scalar descriptor)))\n   531\t\n   532\t\n   533\t(defn image-hash\n   534\t  \"The ONE function that computes H (S2 item 6): `jing/sha256` over the\n   535\t   descriptor hash (which already folds in the lowering-contract\n   536\t   version) concatenated with the canonical instruction vector's own\n   537\t   bytes -- pc-indexed tuples, refs already resolved to pcs, no header,\n   538\t   exact scalar bytes. `jing/sha256`, not `jing/sha256-bytes`: this\n   539\t   dimension's canonical encoding is hex text (`encode-image` returns a\n   540\t   string, via `framed`/`to-hex`), the same shape `jing/sha256` hashes\n   541\t   for `yin.vm.debruijn/dimension-hash`, so hashing the string directly\n   542\t   is the fit; `sha256-bytes` would apply to a raw byte buffer this\n   543\t   encoder never produces. H is the ONLY executable and sharing identity\n   544\t   this file computes: no projection fingerprint, no second identity.\"\n   545\t  [v]\n   546\t  (jing/sha256 (str descriptor-hash (encode-image v))))\n   547\t\n   548\t\n   549\t;; =============================================================================\n   550\t;; Host-boundary scalar-class support (S2 item 5)\n   551\t;; =============================================================================\n   552\t\n   553\t(defn image-scalar-classes\n   554\t  \"Every scalar class this image uses, scanned from every :data-kind\n   555\t   operand across every mnemonic -- not only :const's value, but also\n   556\t   :store-get's and :store-put's :data operands, since those are hashed\n   557\t   bytes too and a scalar class hiding only there would let S2's host-\n   558\t   support scan (below) miss it. S2's own wording names :const alone;\n   559\t   scanning every :data operand is strictly more conservative than that\n   560\t   floor, never less, so it does not weaken the design's own rule.\"\n   561\t  [v]\n   562\t  (into #{}\n   563\t        (mapcat (fn [t]\n   564\t                  (keep-indexed (fn [i kind]\n   565\t                                  (when (= :data kind) (scalar-class (nth t (inc i)))))\n   566\t                                (tuple-kinds t))))\n   567\t        v))\n   568\t\n   569\t\n   570\t(defn host-unsupported-classes\n   571\t  [v]\n   572\t  (set/difference (image-scalar-classes v) host-supported-scalar-classes))\n   573\t\n   574\t\n   575\t(defn validate-host-support\n   576\t  \"S2 item 5's host-boundary refusal: nil when every scalar class `v`\n   577\t   uses is representable on this host, else a qualified :unsupported-\n   578\t   value diagnostic naming the missing classes. A host-boundary outcome,\n   579\t   worded distinctly from a :dao.stream/gap, per the design.\"\n   580\t  [v]\n   581\t  (let [missing (host-unsupported-classes v)]\n   582\t    (when (seq missing)\n   583\t      {:rule :unsupported-value, :boundary :host, :missing-classes missing})))\n   584\t\n   585\t\n   586\t;; =============================================================================\n   587\t;; The validator (S2 item 7, S3)\n   588\t;; =============================================================================\n   589\t;; Two passes: generic structural well-formedness over this dimension's\n   590\t;; own opcode table (mirroring `yin.vm.code/well-formed-vector?`'s rules,\n   591\t;; not its code -- that private rule vector operates over the named\n   592\t;; table and is not reused), then the scope rule S3 adds: a :load-bound\n   593\t;; operand must address a real enclosing frame and a real parameter\n   594\t;; inside it, not merely carry two nonnegative integers.\n   595\t\n   596\t(defn- tuple-defect\n   597\t  [rule pc]\n   598\t  {:rule rule, :pc pc})\n   599\t\n   600\t\n   601\t(defn- nonempty\n   602\t  [v]\n   603\t  (when-not (and (vector? v) (pos? (count v))) (tuple-defect :nonempty 0)))\n   604\t\n   605\t\n   606\t(defn- mnemonic-rule\n   607\t  [v]\n   608\t  (some (fn [pc]\n   609\t          (when-not (contains? mnemonics (mnemonic-of (nth v pc)))\n   610\t            (tuple-defect :mnemonic pc)))\n   611\t        (range (count v))))\n   612\t\n   613\t\n   614\t(defn- arity-rule\n   615\t  [v]\n   616\t  (some (fn [pc]\n   617\t          (let [t (nth v pc)]\n   618\t            (when-not (= (inc (count (get opcode-table (mnemonic-of t)))) (count t))\n   619\t              (tuple-defect :arity pc))))\n   620\t        (range (count v))))\n   621\t\n   622\t\n   623\t(defn- nonneg-int?\n   624\t  \"A nonnegative integer, bounded to the safe-integer range on CLJS: JVM\n   625\t   `integer?` already excludes an unsafe-magnitude double, but CLJS's\n   626\t   `integer?` is true for any integral-valued JS number, including one\n   627\t   past 2^53 that is not exactly representable. Left unbounded there, an\n   628\t   image like `[:call 1e30 true]` would pass this validator on CLJS while\n   629\t   the same image is correctly rejected on JVM (`integer?` false for a\n   630\t   Double), and `int64-le-hex`'s own floor/mod decomposition would then\n   631\t   produce silently inexact bytes for it -- one image, valid on one host\n   632\t   and not another, is exactly what the sole-admitter validator exists to\n   633\t   prevent.\"\n   634\t  [x]\n   635\t  (and (integer? x) (not (neg? x))\n   636\t       #?(:cljs (js/Number.isSafeInteger x) :default true)))\n   637\t\n   638\t\n   639\t(def ^:private operand-kind-checks\n   640\t  \"Every operand kind this dimension's table uses except :pc, which\n   641\t   `target-bounds-rule` owns because judging it needs the vector's own\n   642\t   length.\"\n   643\t  {:data vm/plain-data?,\n   644\t   :sym symbol?,\n   645\t   :kw keyword?,\n   646\t   ;; a non-nil :str operand must also be well-formed UTF-16 (the same\n   647\t   ;; guard `encode-scalar` applies to a :string value), so a malformed\n   648\t   ;; :str operand is rejected here, before hashing -- not only inside\n   649\t   ;; `encode-operand`\n   650\t   :str (fn [x] (or (nil? x) (and (string? x) (well-formed-utf16? x)))),\n   651\t   :bool (fn [x] (or (nil? x) (boolean? x))),\n   652\t   :buffer (fn [x] (or (nil? x) (nonneg-int? x))),\n   653\t   :uint nonneg-int?})\n   654\t\n   655\t\n   656\t(defn- operand-kind-rule\n   657\t  [v]\n   658\t  (some (fn [pc]\n   659\t          (let [t (nth v pc), kinds (tuple-kinds t)]\n   660\t            (some (fn [i]\n   661\t                    (let [check (get operand-kind-checks (nth kinds (dec i)))]\n   662\t                      (when (and check (not (check (nth t i))))\n   663\t                        (tuple-defect :operand-kind pc))))\n   664\t                  (range 1 (count t)))))\n   665\t        (range (count v))))\n   666\t\n   667\t\n   668\t(def ^:private saturated-operands\n   669\t  \"The `[mnemonic index]` operands a canonical tuple must materialize\n   670\t   even though their :operand-kind check alone would tolerate nil -- the\n   671\t   same set `yin.vm.code`'s own :saturation rule judges\n   672\t   (`code/vector-operand-table`'s saturated pairs), over this\n   673\t   dimension's carried :gensym, :stream-make, :call, and :ffi-call.\n   674\t   :ffi-call's argc (index 2) is also already rejected as nil by the\n   675\t   stricter `:uint nonneg-int?` kind check above, so this entry is\n   676\t   redundant today; it is kept anyway so this set matches the source\n   677\t   table's own saturated pairs exactly, rather than silently drifting if\n   678\t   the :uint kind check is ever relaxed.\"\n   679\t  #{[:gensym 1] [:stream-make 1] [:call 2] [:ffi-call 2]})\n   680\t\n   681\t\n   682\t(defn- saturation-rule\n   683\t  [v]\n   684\t  (some (fn [pc]\n   685\t          (let [t (nth v pc)]\n   686\t            (when (some #(and (contains? saturated-operands [(mnemonic-of t) %])\n   687\t                              (nil? (nth t %)))\n   688\t                        (range 1 (count t)))\n   689\t              (tuple-defect :saturation pc))))\n   690\t        (range (count v))))\n   820\t   Two :closure instructions declaring different arities for the same\n   821\t   body pc -- in either declaration order, and whether reached through\n   822\t   ordinary body scheduling or a cross-body :jump -- are `all-body-\n   823\t   chains`'s own `:scope-conflict` defect, checked first: which chain\n   824\t   would otherwise 'win' depends on walk order, so this is rejected\n   825\t   before any :load-bound is even examined.\n   826\t\n   827\t   Returns the first defect as `{:rule :scope :pc p}` or\n   828\t   `{:rule :scope-conflict :pc p}`, or nil.\"\n   829\t  [v]\n   830\t  (let [{:keys [owner conflict]} (all-body-chains v)]\n   831\t    (if conflict\n   832\t      (tuple-defect :scope-conflict conflict)\n   833\t      (some (fn [pc]\n   834\t              (let [t (nth v pc)]\n   835\t                (when (= :load-bound (mnemonic-of t))\n   836\t                  (let [depth (nth t 1), position (nth t 2), chain (get owner pc)]\n   837\t                    (when (or (nil? chain)\n   838\t                              (not (nonneg-int? depth))\n   839\t                              (not (nonneg-int? position))\n   840\t                              (>= depth (count chain))\n   841\t                              (>= position (nth chain depth)))\n   842\t                      (tuple-defect :scope pc))))))\n   843\t            (range (count v))))))\n   844\t\n   845\t\n   846\t(defn image-defect\n   847\t  \"The B1 image validator (S2, S3): the first defect in `v`, checking\n   848\t   generic shape first, then the scope rule S3 adds. nil when `v` is a\n   849\t   valid executable image on this path -- the only admitter of one; no\n   850\t   projected reader participates.\"\n   851\t  [v]\n   852\t  (or (well-formed-image? v) (scope-defect v)))\n   180\t                                     (some #(contains? (get attrs e) %)\n   181\t                                           structural-attrs)))\n   182\t                              order)\n   183\t        batch {:attrs attrs,\n   184\t               :segments segments,\n   185\t               :seg (first segments),\n   186\t               :instructions instructions}]\n   187\t    (some #(% batch) rules)))\n   188\t\n   189\t\n   190\t;; =============================================================================\n   191\t;; The canonical instruction vector (UCF §7.3.2, §7.5)\n   192\t;; =============================================================================\n   193\t\n   194\t(def vector-operand-table\n   195\t  \"§2.4's operand table in UCF §7.3.2's positional form: mnemonic → ordered\n   196\t   `[attribute kind]` operands. Position `i` of a canonical tuple (from 1)\n   197\t   holds the operand entry `i-1` names; this one table drives the §7.5\n   198\t   validator's rules. Each kind names the\n   199\t   rule that judges it: `:data`, `:sym`, `:syms`, `:kw`, `:str`, `:bool`,\n   200\t   and `:buffer` belong to `:operand-kind` (a nil passes it and is\n   201\t   `:saturation`'s defect); `:pc` to `:target-bounds`; `:uint` to `:argc`.\"\n   202\t  {:const [[:yin.code/value :data]],\n   203\t   :var [[:yin.code/name :sym]],\n   204\t   :closure [[:yin.code/params :syms] [:yin.code/body :pc]],\n   205\t   :push [],\n   206\t   :call [[:yin.code/argc :uint] [:yin.code/tail? :bool]],\n   207\t   :return [],\n   208\t   :jump [[:yin.code/target :pc]],\n   209\t   :branch-false [[:yin.code/target :pc]],\n   210\t   :halt [],\n   211\t   :gensym [[:yin.code/prefix :str]],\n   212\t   :store-get [[:yin.code/key :data]],\n   213\t   :store-put [[:yin.code/key :data] [:yin.code/value :data]],\n   214\t   :stream-make [[:yin.code/buffer :buffer]],\n   215\t   :stream-put [],\n   216\t   :stream-cursor [],\n   217\t   :stream-next [],\n   218\t   :stream-close [],\n   219\t   :park [],\n   220\t   :resume [[:yin.code/parked-id :kw]],\n   221\t   :current-continuation [],\n   222\t   :ffi-call [[:yin.code/ffi-op :kw] [:yin.code/argc :uint]]})\n   223\t\n   224\t\n   225\t(def ^:private operand-kind-checks\n   226\t  \"§7.5 :operand-kind — kind → predicate. Absent kinds (`:pc`, `:uint`) are\n   227\t   not judged by the rule: `:target-bounds` and `:argc` own them. A nil in\n   228\t   a saturated slot passes here; `:saturation` owns it, the §7.4 `:slot-kind`\n   229\t   precedent.\"\n   230\t  {:data vm/plain-data?,\n   231\t   :sym symbol?,\n   232\t   :syms (fn [x] (and (vector? x) (every? symbol? x))),\n   233\t   :kw keyword?,\n   234\t   :str (fn [x] (or (nil? x) (string? x))),\n   235\t   :bool (fn [x] (or (nil? x) (boolean? x))),\n   236\t   :buffer (fn [x] (or (nil? x) (count? x)))})\n   237\t\n   238\t\n   239\t(def ^:private saturated-operands\n   240\t  \"§7.5 :saturation — the `[mnemonic index]` operands a canonical tuple\n   241\t   materializes (UCF §7.3.2); a nil in one of them is that rule's defect.\"\n   242\t  #{[:gensym 1] [:stream-make 1] [:call 2] [:ffi-call 2]})\n   243\t\n   244\t\n   245\t(defn- tuple-defect\n   246\t  [rule pc]\n   247\t  {:rule rule, :pc pc})\n   248\t\n   249\t\n   250\t(defn- mnemonic-of\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"Two contract mismatches surfaced that the implementation blueprint must resolve explicitly:\n\n- The normative §5.2.2 wire payload is `:regs`/`:dest` (plus `:live` and `:continuation`), while the task shorthand says `:registers`/`:destination`. I’ll preserve the normative wire keys and distinguish them from the runtime input keys.\n- The current `ffi/response-wait-entry` removes only three writer keys, but §5.2.3 requires ten stale wake keys to be removed. That needs a small `yin.vm.ffi` prerequisite patch even though the nominal R2 file box omitted it; otherwise the new validator must reject the engine helper’s own output.\n\nI’m checking the cross-host test commands and existing golden/contract conventions now, then I’ll deliver the full implementation handoff."}}
