g discipline of `yin.register-bench-cljd`.\"\ntest/bench/yin_vm_bench.cljc:99:#?(:cljd nil\ntest/bench/yin_vm_bench.cljc:101:   :cljs\ntest/bench/yin_vm_bench.cljc:104:      per run — the sampling discipline of `yin.register-bench-cljd`.\"\ntest/bench/yin_vm_bench.cljc:135:#?(:cljd nil\ntest/bench/yin_vm_bench.cljc:143:#?(:cljd nil\ntest/bench/yin_vm_bench.cljc:145:   :cljs\ntest/dao/postgraphics/flutter_cljd_test.cljd:1:(ns dao.postgraphics.flutter-cljd-test\nbin/yin_repl_main.dart:2:import '../lib/cljd-out/yin/repl.dart' as repl;\ntest/datomworld/demo/voxel_input_test.cljc:11:   test continuation; cljd.test instead splits a fixture into a setUp that\ntest/datomworld/demo/voxel_input_test.cljc:13:   result (see cljd.test/fixture-callbacks), so the zero-arity half is the\nsrc/clj/dao/stream/ws/jvm.clj:163:            ;; completion observer is registered after leaving it. An\nbin/register_bench_cljd.dart:1:import '../lib/cljd-out/yin/register-bench-cljd.dart' as bench;\ntest/datomworld/demo/continuation_handoff_test.cljc:77:    (testing \"The batch is the segment plus EDN registers, nothing off-stream\"\ntest/datomworld/demo/continuation_handoff_test.cljc:82:                           (when (= handoff/registers-attr a) v))\ntest/datomworld/demo/continuation_handoff_test.cljc:84:    (testing \"The receiver resumes the same registers and finishes\"\ntest/datomworld/demo/continuation_handoff_test.cljc:95:    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\ntest/datomworld/demo/continuation_handoff_test.cljc:101:  ;; handle lives in the sender's store and the registers only name it.\ntest/datomworld/demo/continuation_handoff_test.cljc:116:      (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\ntest/datomworld/demo/continuation_handoff_test.cljc:125:(deftest register-encoding-keeps-data-and-primitives-apart-test\ntest/datomworld/demo/responsive_test.cljs:3:    [cljs.test :refer-macros [deftest is testing]]\nbin/clean.sh:19:(let [paths [\".cpcache\" 