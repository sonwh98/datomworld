{"type":"item.completed","item":{"id":"item_89","type":"command_execution","command":"/bin/zsh -lc \"tail -8 target/6db/mutants.log; sed -n '1475,1505p' src/cljc/yin/vm/ucf/holder/driver.cljc; sed -n '2120,2199p' src/cljc/yin/vm/ucf/holder/driver.cljc; sed -n '4305,4332p' test/yin/vm/ucf/holder/driver_test.cljc; sed -n '7,12p' .cljstyle\"","aggregated_output":":fuel-unbounded {:test 10, :pass 278, :fail 8, :error 1} :killed true\n:tenure-guard-removed {:test 10, :pass 259, :fail 28, :error 0} :killed true\n:failure-reverts-to-cycle-input {:test 10, :pass 269, :fail 18, :error 0} :killed true\n:completed-stage-discards-machine {:test 10, :pass 282, :fail 5, :error 0} :killed true\n:fuel-config-unchecked {:test 10, :pass 282, :fail 5, :error 0} :killed true\n:running-kind-missing {:test 10, :pass 285, :fail 2, :error 0} :killed true\n:ready-reinstatement-dropped {:test 10, :pass 274, :fail 13, :error 0} :killed true\n:ready-count-not-validated {:test 10, :pass 283, :fail 4, :error 0} :killed true\n        boundary {:yin.k/pc (get-in m [:control :pc])\n                  :yin.k/segment (get-in m [:control :segment])\n                  :yin.k/steps-since-checkpoint (or (:completed-slices state) 0)\n                  :yin.k/checkpoint (:address state)}\n        state (assoc state :yin.k/retained-boundary boundary)\n        also (some-> (:run-end state) :cause)\n        detail (if (some? also) (assoc detail :also-ended also) detail)\n        diagnostic {:yin.k/diagnostic :yin.k/run-ended\n                    :yin.k/occurrence (:occurrence state)\n                    :dao.lease/lease (:lease state)\n                    :yin.k/end (merge {:cause cause} detail)}]\n    (append-diagnostic! state diagnostic)\n    (releasing (-> state (dissoc :run-end) (update :diagnostics conj diagnostic))\n               :yin.k/ended (merge {:cause cause} detail) (:lease state))))\n\n\n;; =============================================================================\n;; The candidate loop: propose, observe the grant, accept it whole\n;; =============================================================================\n\n(defn- proposal-request\n  [occurrence pid]\n  {:yin.k/request :yin.k/proposal\n   :yin.k/request-id [:yin.k/proposal occurrence pid]\n   :dao.lease/proposal pid\n   :yin.k/occurrence occurrence})\n\n\n(defn- fresh-pid\n  [_state]\n  (str (random-uuid)))\n            (reduce (fn [root [resource handle]]\n                      (if (satisfies? stream/IDaoStreamDescriptor handle)\n                        (assoc-in root (into path [:resources resource]) handle)\n                        root)) root (:resources task)))\n          machine (machines original)))\n\n\n(defn- stage-result\n  \"Run one stage under tenure. Failure carries this stage's input, the\n   latest completed state; uncertain journal and inbox failures propagate.\"\n  [state operation]\n  (try\n    (require-tenure! state)\n    {:status :ok :state (operation state)}\n    (catch #?(:cljd Object :clj Throwable :cljs :default) failure\n      (if (or (::journal-uncertain (ex-data failure)) (::inbox/refusal (ex-data failure)))\n        (throw failure)\n        {:status :failed :state state :failure failure}))))\n\n\n(defn- completed-stage\n  [state result]\n  (assoc state :machine (:machine result)\n         :run-end (or (:run-end state) (:run-end result))\n         :step-unsatisfied (or (:step-unsatisfied state) (:unsatisfied result))))\n\n\n(defn- run-cycle\n  \"One execution slice, replay, emit and live read, with a state-bearing\n   outcome before each next tenure check. No unreturned partial state is adopted.\"\n  [state]\n  (reduce\n    (fn [outcome operation]\n      (if (= :failed (:status outcome)) (reduced outcome)\n          (stage-result (:state outcome) operation)))\n    {:status :ok :state state}\n    [(fn [state]\n       (let [m0 (:machine state)\n             fuel (:fuel state)\n             m1 (if (and (= :running (vm/gate-mode m0)) (not (:halted? m0)))\n                  (if fuel (sr/run-fuel m0 fuel) (vm/run m0)) m0)]\n         (-> state (assoc :machine m1) (update :completed-slices (fnil inc 0)))))\n     (fn [state]\n       (completed-stage state (reader/replay (:machine state)\n                                             {:control-outstanding? (control-outstanding? state)})))\n     (fn [state]\n       (let [m (:machine state)\n             result (writer/emit\n                      (guard-writes state m)\n                      (fn [request] (require-tenure! state) (append-request! state request))\n                      (fn [diagnostic] (require-tenure! state) (append-diagnostic! state diagnostic)))]\n         (completed-stage state (update result :machine restore-handles m))))\n     (fn [state]\n       (completed-stage state\n                        (reader/step (:machine state)\n                                     (fn [request] (require-tenure! state) (append-request! state request))\n                                     (fn [h op arg] (require-tenure! state) (observe! state h op arg)))))]))\n\n\n(defn- failed-stage\n  [{:keys [state failure]}]\n  (if (= :lease-bound (::cause (ex-data failure)))\n    (end-run state :lease-bound {:dao.lease/lease (:lease state)})\n    (end-run state :program-failure\n             {:failure {:message (ex-message failure) :data (ex-data failure)}})))\n\n\n(defn- at-safepoint?\n  \"True when the machine has nothing left the candidate half owes it:\n   halted with no wait entry and no queued work anywhere in the tree.\"\n  [machine]\n  (and (:halted? machine)\n       (every? (fn [[_ m]]\n                 (and (empty? (:wait-set m)) (empty? (:ready-queue m))))\n               (machines machine))))\n\n\n(defn- exit-settled?\n  \"True when the exit's release bracket is closed: the report stands\n   and the release has been carried, so the closure is the grantor's\n\n(deftest fuel-configuration-and-repeated-boundaries-test\n  (let [{:keys [sources]} (reader-source)\n        w (world :holders [\"holder-a\"] :sources sources)\n        record (driver-for w \"holder-a\" sources \"v1\")\n        config (reopen-config (:state record))]\n    (doseq [fuel [0 -1 1.5 \"1\" false]]\n      (is (try (driver/initial (assoc config :fuel fuel)) false\n               (catch #?(:cljd Object :clj Throwable :cljs :default) _ true))))\n    (doseq [fuel [nil 1 10]]\n      (is (= fuel (:fuel (driver/initial (assoc config :fuel fuel))))))\n    (let [{:keys [sources]} (reader-source)\n          w (world :holders [\"holder-a\"] :sources sources)\n          record (running-pure (to-running w (driver-for w \"holder-a\" sources \"v1\")))\n          m0 (get-in record [:state :machine])\n          one (driver/program-step (:state record))\n          two (driver/program-step one)]\n      (is (= :running (:phase one) (:phase two)))\n      (is (true? (get-in one [:detail :yin.k/at-boundary])))\n      (is (= (sr/run-fuel m0 1) (:machine one)))\n      (is (= (sr/run-fuel (:machine one) 1) (:machine two)))\n      (is (not= (:machine one) (:machine two))))))\n\n\n(deftest clock-cuts-retain-the-exact-completed-stage-test\n  #?(:cljd nil\n     :default\n     (doseq [cut [:before :after-slice :replay :after-replay :emit :after-emit :read :after-read :between]]\n;;    #?(:cljd nil :clj ...) rely on :cljd appearing FIRST (the cljd\n;;    host-eval pass also matches :clj, so first-match-wins order is\n;;    load-bearing — see the reader-conditional trap in project memory).\n;;    The rule reorders reader-conditional branches alphabetically\n;;    (:clj before :cljd), silently re-breaking the guard on every\n;;    `cljstyle fix` — this bit dao.jing.dht.node.cljc and cost a lost\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/zsh -lc \"cat > target/6db/mutants.clj <<'CLJ'\n(require '[clojure.test :as t]\n         '[clojure.java.io :as io]\n         '[yin.vm.ucf.holder.driver-test :as dt]\n         '[yin.vm.ucf.holder.export-test :as et]\n         '[yin.vm.ucf.ledger-test :as lt]\n         '[yin.vm.ucf.authority.grant-test :as gt]\n         '[yin.vm :as vm])\n(defn v [n s] (ns-resolve n s))\n(def tests\n  (mapv #(apply v %)\n        '[[yin.vm.ucf.holder.driver-test fuel-configuration-and-repeated-boundaries-test]\n          [yin.vm.ucf.holder.driver-test clock-cuts-retain-the-exact-completed-stage-test]\n          [yin.vm.ucf.holder.driver-test running-export-tenure-cuts-keep-the-exact-fence-test]\n          [yin.vm.ucf.holder.driver-test running-grant-expiry-refuses-before-attachment-test]\n          [yin.vm.ucf.holder.export-test completed-queues-are-retained-without-execution-test]\n          [yin.vm.ucf.holder.export-test running-products-rehydrate-byte-for-byte-and-refuse-execution-test]\n          [yin.vm.ucf.holder.export-test recovery-validation-precedes-attachment-test]\n          [yin.vm.ucf.holder.export-test abort-is-refused-when-the-offer-may-have-been-accepted-test]\n          [yin.vm.ucf.ledger-test running-baselines-are-offerable-test]\n          [yin.vm.ucf.authority.grant-test running-root-is-offerable-test]]))\n(defn run-tests []\n  (binding [t/*report-counters* (ref t/*initial-report-counters*)\n            t/*test-out* (java.io.StringWriter.)]\n    (t/test-vars tests)\n    @t/*report-counters*))\n(defn captured [n s transform]\n  (let [var (v n s)] [var (transform @var)]))\n(def cases\n  [[:fuel-unbounded\n    (captured 'yin.vm.semantic 'run-fuel (fn [_] (fn [m _] (vm/run m))))]\n   [:tenure-guard-removed\n    (captured 'yin.vm.ucf.holder.driver 'require-tenure\"'! (fn [_] (fn [_] nil)))]\n   [:failure-reverts-to-cycle-input\n    (captured '\"'yin.vm.ucf.holder.driver 'run-cycle