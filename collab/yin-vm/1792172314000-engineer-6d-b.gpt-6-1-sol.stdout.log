[:seams :source-index])))\n400:  ((get-in state [:seams :enroll!])))\n405:  (get-in state [:seams :journal]))\n614:               ((:put-bytes-fn (get-in state [:seams :content-store])) address bytes))\n623:    (let [v ((:get-bytes-fn (get-in state [:seams :content-store]))\n959:        medium (get-in state [:seams :medium])\n1563:  (let [attach! (get-in state [:seams :attach!])\n1571:                                        (:yin.k/admitted-modules (:config state))))]\n1839:  (let [receipts (inbox/reconcile! (:seams state) receipts)]\n1858:      (inbox/reconcile! (:seams state) (:inbox-reconciliation state))\n1879:          (let [descriptor (get-in state [:seams (get inbox/lanes lane)])\n2463:                                            :yin.k/admitted-modules (:yin.k/admitted-modules (:config state))\n2464:                                            :attach (get-in state [:seams :attach!])})\n2499:  (let [state (assoc (bare-state config units)\n2529:  (let [state (bare-state config units)\n2580:  (let [state (bare-state config units)\n2648:                (assoc (bare-state config (or (:units config) lease/default-units))\n2698:                           {:receipts (inbox/reconcile! (:seams (bare-state config units)) (:inbox folded))}\n2708:                       (assoc (bare-state config units) :phase :aborted :status :yin.k/ok\n2713:                       (assoc (bare-state config units) :phase :stalled :status :yin.k/unsatisfied\n(ns yin.vm.ucf.authority.grant-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.remote :as remote]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.completion :as completion]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as fx]\n            [yin.vm.ucf.rows.checkpoint :as checkpoint]\n            [yin.vm.ucf.custody :as custody]))\n\n\n(def ^:private arb \"arb-c5\")\n\n(def ^:private occ fx/occurrence)\n\n(def ^:private duration {:s 30})\n\n\n(defn- fresh-frames\n  \"A journal whose header names `arb`, so bodies can name the authority\n   before it opens.\"\n  []\n  (atom [(cbor/encode {:dao.stream.journal/header\n                       {:version 1 :identity arb}})]))\n\n\n(defn- auth\n  ([frames] (auth frames nil))\n  ([frames cut]\n   (::authority/authority\n     (authority/open! (journal/memory-backend frames cut)))))\n\n\n(defn- body\n  \"Fixture `n`'s pack naming this test's authority, its custody slot then\n   through `f`.\"\n  ([n] (body n identity))\n  ([n f]\n   (fx/edit-custody (fx/pack-of n)\n                    #(f (assoc % :yin.k/arbitration {:dao.stream/identity arb\n                                                     :dao.stream/descriptor\n                                                     {:dao.stream/type :dao.stream/journal}})))))\n\n\n(defn- variant-equal\n  \"The successor's rows in another order: one root, another pack address.\"\n  []\n  (update (body \"successor\") :yin.k/rows (comp vec reverse)))\n\n\n(defn- bytes-of\n  [b]\n  (let [bs (cbor/encode b)]\n    {:address (fx/segment-address bs) :bytes bs}))\n\n\n(defn- offer!\n  ([a store b] (offer! a store b \"carrier\"))\n  ([a store b medium]\n   (let [{:keys [address bytes]} (bytes-of b)]\n     (grant/offer! a store address bytes medium))))\n\n\n(defn- status\n  [r]\n  (:yin.k/status r))\n\n\n(defn- outcome\n  [r]\n  (:dao.stream/outcome r))\n\n\n(defn- records\n  \"Every transaction record of the journal's frames.\"\n  [frames]\n  (mapv #(:dao.stream.journal/value (cbor/decode %)) (rest @frames)))\n\n\n(defn- facts\n  \"The facts of kind `k` (custody or lease status) across the records.\"\n  [frames k]\n  (for [r (records frames)\n        :let [ds (get-in r [:dao.space/transaction :datoms])\n              es (set (keep (fn [[e a v]]\n                              (when (and (#{:yin.k/custody :dao.lease/status}\n                                          a)\n                                         (= k v))\n                                e))\n                            ds))]\n        e (sort es)]\n    (into {} (keep (fn [[e' a v]] (when (= e e') [a v]))) ds)))\n\n\n(defn- attributed\n  \"The journal's records, each attributed to the authority.\"\n  [frames]\n  (mapv (fn [r] [arb r]) (records frames)))\n\n\n(defn- a-grant\n  ([] (a-grant \"lease-1\" \"holder-a\"))\n  ([l h]\n   (lease/grant l (custody/subject occ) h duration\n                {:dao.lease/proposal \"p-1\"})))\n\n\n(defn- offered\n  \"A fresh authority with the first-park fixture offered: the frames,\n   the authority and the store.\"\n  []\n  (let [frames (fresh-frames)\n        a (auth frames)\n        store (mem/create-content-mem)]\n    (offer! a store (body \"first-park\"))\n    [frames a store]))\n\n\n(defn- succeeded\n  \"A fresh authority where the successor fixture's predecessor completed\n   into it under lease-7 (slice C8), and the successor is offered: the\n   frames, the authority and the store.\"\n  []\n  (let [frames (fresh-frames)\n        a (auth frames)\n        store (mem/create-content-mem)\n        w (grant/writer a)\n        {:keys [address bytes]} (bytes-of (body \"successor\"))]\n    (offer! a store (body \"first-park\"\n                          #(assoc % :yin.k/occurrence fx/predecessor)))\n    (stream/append! w (lease/grant \"lease-7\" (custody/subject fx/predecessor)\n                                   \"holder-p\" duration\n                                   {:dao.lease/proposal \"p-7\"}))\n    (completion/report! a \"holder-p\"\n                        (completion/resumed fx/predecessor \"lease-7\" address)\n                        bytes