{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/zsh -lc \"cat > target/6db/mutants.clj <<'CLJ'\n(require '[clojure.test :as t]\n         '[clojure.java.io :as io]\n         '[yin.vm.ucf.holder.driver-test :as dt]\n         '[yin.vm.ucf.holder.export-test :as et]\n         '[yin.vm.ucf.ledger-test :as lt]\n         '[yin.vm.ucf.authority.grant-test :as gt]\n         '[yin.vm :as vm])\n(defn v [n s] (ns-resolve n s))\n(def tests\n  (mapv #(apply v %)\n        '[[yin.vm.ucf.holder.driver-test fuel-configuration-and-repeated-boundaries-test]\n          [yin.vm.ucf.holder.driver-test clock-cuts-retain-the-exact-completed-stage-test]\n          [yin.vm.ucf.holder.driver-test running-export-tenure-cuts-keep-the-exact-fence-test]\n          [yin.vm.ucf.holder.driver-test running-grant-expiry-refuses-before-attachment-test]\n          [yin.vm.ucf.holder.export-test completed-queues-are-retained-without-execution-test]\n          [yin.vm.ucf.holder.export-test running-products-rehydrate-byte-for-byte-and-refuse-execution-test]\n          [yin.vm.ucf.holder.export-test recovery-validation-precedes-attachment-test]\n          [yin.vm.ucf.holder.export-test abort-is-refused-when-the-offer-may-have-been-accepted-test]\n          [yin.vm.ucf.ledger-test running-baselines-are-offerable-test]\n          [yin.vm.ucf.authority.grant-test running-root-is-offerable-test]]))\n(defn run-tests []\n  (binding [t/*report-counters* (ref t/*initial-report-counters*)\n            t/*test-out* (java.io.StringWriter.)]\n    (t/test-vars tests)\n    @t/*report-counters*))\n(defn captured [n s transform]\n  (let [var (v n s)] [var (transform @var)]))\n(def cases\n  [[:fuel-unbounded\n    (captured 'yin.vm.semantic 'run-fuel (fn [_] (fn [m _] (vm/run m))))]\n   [:tenure-guard-removed\n    (captured 'yin.vm.ucf.holder.driver 'require-tenure\"'! (fn [_] (fn [_] nil)))]\n   [:failure-reverts-to-cycle-input\n    (captured '\"'yin.vm.ucf.holder.driver 'run-cycle\n              (fn [original] (fn [state] (let [r (original state)]\n                                          (if (= :failed (:status r)) (assoc r :state state) r)))))]\n   [:completed-stage-discards-machine\n    (captured 'yin.vm.ucf.holder.driver 'completed-stage (fn [_] (fn [state _] state)))]\n   [:fuel-config-unchecked\n    (captured 'yin.vm.ucf.holder.driver 'check-common\"'! (fn [_] (fn [& _] nil)))]\n   [:running-kind-missing\n    (captured '\"'yin.vm.ucf.holder.export 'kind-of\n              (fn [original] (fn [m] (if (:control m) :halted (original m)))))]\n   [:ready-reinstatement-dropped\n    (captured 'yin.vm.ucf.holder.export 'reinstated\n              (fn [original] (fn [m r] (assoc (original m r) :ready-queue []))))]\n   [:ready-count-not-validated\n    (captured 'yin.vm.ucf.holder.export 'valid-state?\n              (fn [original] (fn [task state]\n                               (original task (assoc state :ready-count (count (nth (:slots task) 18)))))))]\n   [:closed-gate-unchecked\n    (captured 'yin.vm.semantic 'check-gate\"'! (fn [_] (fn [_] nil)))]\n   [:expired-tenure-admitted\n    (captured '\"'dao.lease 'holding? (fn [_] (fn [& _] true)))]\n   [:uncertain-offer-abort-allowed\n    (captured 'yin.vm.ucf.holder.export 'abort\n              (fn [original] (fn [m r _tenants tenure] (original m r [] tenure))))]\n   [:ledger-running-not-offerable\n    (captured 'yin.vm.ucf.ledger 'offer-defect\n              (fn [original] (fn [p fact]\n                               (if (= :running (get-in fact [:yin.k/baseline :yin.k/kind]))\n                                 :malformed-fact (original p fact)))))]\n   [:grant-running-not-offerable\n    (captured 'yin.vm.ucf.authority.grant 'offer-decision\n              (fn [original] (fn [a medium b]\n                               (original a medium (if (= :running (:yin.k/kind b))\n                                                    (assoc b :yin.k/kind :halted) b)))))]])\n(def baseline (run-tests))\n(println :baseline baseline)\n(flush)\n(when-not (zero? (+ (:fail baseline) (:error baseline))) (throw (ex-info \\\"Baseline is not green\\\" baseline)))\n(def results\n  (mapv (fn [[id [var replacement]]]\n          (let [result (with-redefs-fn {var replacement} run-tests)\n                killed? (pos? (+ (:fail result) (:error result)))]\n            (println id result :killed killed?) (flush)\n            {:mutant id :counts result :killed killed?})) cases))\n(spit \\\"target/6db/mutation-results.edn\\\" (pr-str {:baseline baseline :mutants results}))\n(when-not (every? :killed results) (System/exit 1))\nCLJ\nmise exec -- clojure -Sdeps '{:aliases {:sixdb {:extra-paths [\\\"test\\\"]}}}' -M:sixdb target/6db/mutants.clj > target/6db/mutants.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
