))}',':wait-set (:wait-set (:vm install))\\\\n                                  :ready-queue (:ready-queue (:vm install))}');s=s.replace('(= (count (:issues state)) (count waits))','(= (count (:issues state)) (count waits))\\\\n         (= (:ready-count state) (count (nth ss 18)))');s=s.replace('record {:wait-set waits','record {:wait-set waits\\\\n                :ready-queue (vec (:yin.k/recovery-ready machine))');s=s.replace('(dissoc :yin.k/recovery-waits :yin.k/recovery-parked','(dissoc :yin.k/recovery-waits :yin.k/recovery-ready :yin.k/recovery-parked');s=s.replace('(assoc :wait-set [] :parked {} :yin.k/gate :exporting)', '(assoc :wait-set [] :ready-queue [] :parked {} :yin.k/gate :exporting)');p.write_text(s)\nfor f in ['src/cljc/yin/vm/ucf/ledger.cljc','src/cljc/yin/vm/ucf/authority/grant.cljc']:\n p=Path(f);p.write_text(p.read_text().replace('#{:blocked :parked}', '#{:running :blocked :parked}'))\np=Path('src/cljc/yin/vm/ucf/holder/driver.cljc');s=p.read_text().replace('[yin.vm.engine :as engine]', '[yin.vm.engine :as engine]\\\\n            [yin.vm.semantic :as sr]');s=s.replace('(check-interval\"'! units (:renewal-interval config))'\"','(check-interval\"'! units (:renewal-interval config))'\"\\\\n  (check\"'! (or (nil? (:fuel config))'\"\\\\n              (and (integer? (:fuel config)) (pos? (:fuel config))))\\\\n          \\\"positive integer fuel or nil\\\" {:fuel (:fuel config)})');s=s.replace(':renewal-interval (:renewal-interval config)', ':renewal-interval (:renewal-interval config)\\\\n   :fuel (:fuel config)');a=s.index('(defn- run-cycle');b=s.index('\\\\n\\\\n(defn- at-safepoint?',a)\ns=s[:a]+'''(defn- stage-result\n  \\\"Run one stage under tenure. Failure carries this stage's input, the\n   latest completed state; uncertain journal and inbox failures propagate.\\\"\n  [state operation]\n  (try\n    (require-tenure\"'! state)\n    {:status :ok :state (operation state)}\n    (catch #?(:cljd Object :clj Throwable :cljs :default) failure\n      (if (or (::journal-uncertain (ex-data failure)) (::inbox/refusal (ex-data failure)))\n        (throw failure)\n        {:status :failed :state state :failure failure}))))\n\n\n(defn- completed-stage\n  [state result]\n  (assoc state :machine (:machine result)\n         :run-end (or (:run-end state) (:run-end result))\n         :step-unsatisfied (or (:step-unsatisfied state) (:unsatisfied result))))\n\n\n(defn- run-cycle\n  \"One execution slice, replay, emit and live read, with a state-bearing\n   outcome before each next tenure check. No unreturned partial state is adopted.\"\n  [state]\n  (reduce\n    (fn [outcome operation]\n      (if (= :failed (:status outcome)) (reduced outcome)\n          (stage-result (:state outcome) operation)))\n    {:status :ok :state state}\n    [(fn [state]\n       (let [m0 (:machine state)\n             fuel (:fuel state)\n             m1 (if (and (= :running (vm/gate-mode m0)) (not (:halted? m0)))\n                  (if fuel (sr/run-fuel m0 fuel) (vm/run m0)) m0)]\n         (-> state (assoc :machine m1) (update :completed-slices (fnil inc 0)))))\n     (fn [state]\n       (completed-stage state (reader/replay (:machine state)\n                               {:control-outstanding? (control-outstanding? state)})))\n     (fn [state]\n       (let [m (:machine state)\n             result (writer/emit\n                      (guard-writes state m)\n                      (fn [request] (require-tenure! state) (append-request! state request))\n                      (fn [diagnostic] (require-tenure! state) (append-diagnostic! state diagnostic)))]\n         (completed-stage state (update result :machine restore-handles m))))\n     (fn [state]\n       (completed-stage state\n         (reader/step (:machine state)\n           (fn [request] (require-tenure! state) (append-request! state request))\n           (fn [h op arg] (require-tenure! state) (observe! state h op arg)))))]))\n\n\n(defn- failed-stage\n  [{:keys [state failure]}]\n  (if (= :lease-bound (::cause (ex-data failure)))\n    (end-run state :lease-bound {:dao.lease/lease (:lease state)})\n    (end-run state :program-failure\n             {:failure {:message (ex-message failure) :data (ex-data failure)}})))\n'\"'''+s[b:]\ns=s.replace(':else (cycle-result (drain (run-cycle state) mode))', ''':else (let [outcome (run-cycle state)\n                              drained (if (= :failed (:status outcome)) outcome\n                                          (stage-result (:state outcome) #(drain % mode)))]\n                          (if (= :failed (:status drained))\n                            (failed-stage drained)\n                            (cycle-result (:state drained))))''')\ns=s.replace('''           (if (= :lease-bound (::cause (ex-data failure)))\n             (end-run state :lease-bound {:dao.lease/lease (:lease state)})\n             (end-run state :program-failure\n                      {:failure {:message (ex-message failure)\n                                 :data (ex-data failure)}}))''', '''           (failed-stage {:state state :failure failure})''')\ns=s.replace('''{:yin.k/occurrence (:occurrence base) :dao.lease/lease (:lease base)}))))''','''(cond-> {:yin.k/occurrence (:occurrence base) :dao.lease/lease (:lease base)}\n                (some? (:control (:machine base))) (assoc :yin.k/at-boundary true))))))''')\ns=s.replace('''  (let [also (some-> (:run-end state) :cause)''','''  (let [m (:machine state)\n        boundary {:yin.k/pc (get-in m [:control :pc])\n                  :yin.k/segment (get-in m [:control :segment])\n                  :yin.k/completed-slices (or (:completed-slices state) 0)\n                  :yin.k/checkpoint (:address state)}\n        state (assoc state :yin.k/retained-boundary boundary)\n        also (some-> (:run-end state) :cause)''');\ns=s.replace('blocked or parked root', 'running, blocked or parked root').replace('the machine at its liftable safepoint (parked,\\\\n                        blocked or halted)', 't