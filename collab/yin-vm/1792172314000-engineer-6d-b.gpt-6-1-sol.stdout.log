  {:yin.k/journal :yin.k/fenced\n                       :yin.k/occurrence (:occurrence cell)\n                       :yin.k/address address\n                       :yin.k/record record-address})\n            (-> state\n                (assoc-in [k :address] address)\n                (assoc-in [k :record-address] record-address)\n                (assoc-in [k :bytes] bytes)\n                (assoc-in [k :kind] (:kind e))\n                (with-status :yin.k/ok\n                  {:export (:role cell) :step :fenced}))))))))\n\n\n(defn- offer-request\n  [o address medium bytes]\n  {:yin.k/request :yin.k/offer\n   :yin.k/request-id [:yin.k/offer o]\n   :yin.k/id address\n   :yin.k/bytes bytes\n   :yin.k/medium medium})\n\n\n(defn- admitted?\n   composition reopens the journal and reconciles through `reopen`.\n\n   The source is a candidate like any other: the driver holds bytes,\n   never the source's local machine, so the source itself resumes only\n   through a grant to itself, never on data.  No transport is known\n   here; the machine's own resource handles are the only ones touched,\n   by the writer and the reader.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n   the image, the manifest naming its tree and its :yin.semantic/code\n   derivation record, and that record, from the tree to the image's A.\"\n  [body exports]\n  (let [v (project body)\n        tree (jing/segment-key [:yin/tree body])\n        record (ledger/derive-record tree (jing/segment-key v))]\n    {:status :ok :image {:value v}\n     :manifest {:yin.module/name 'host.mod :yin.module/exports exports\n                :yin.module/tree tree :yin.module/derivations {:yin.semantic/code (jing/segment-key record)}}\n     :derivation record :obligations []}))\n\n\n(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n\n\n(def blocking-body\n  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n   binding holds the stream, so f's E does not capture it.\"\n  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n\n\n(defn require-op\n  [tail?]\n  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n\n\n(def install-lower-opts\n  \"Receiver admission of this composition's fixed blocking-body module.\"\n  {:yin.k/admitted-modules {'host.mod (jing/segment-key\n","exit_code":0,"status":"completed"}}
