830-            (is (empty? (:wait-set woken))))))))\n831-  (testing \"A blocked writer entry round-trips and retries its value\"\n832-    (let [blocked (run-blocked-writer)\n833-          entry (first (:wait-set blocked))]\n834-      (is (vm/blocked? blocked))\n835-      (is (= :put (:reason entry)))\n836-      (is (= :b (:datom entry)) \"the writer keeps the value it retries\")\n837-      (is (pure-entry? entry))\n838-      (is (= entry (edn/read-string (pr-str entry))))\n839-      (testing \"freeing capacity wakes the round-tripped entry\"\n840-        (let [handle (get (:resources blocked) (:stream-id entry))\n841-              cursor (:dao.stream/cursor\n842-                       (stream/cursor handle stream/anchor-oldest))]\n843-          (is (= :a (:dao.stream/value (stream/next handle cursor))))\n844-          (let [woken (vm/run\n845-                        (assoc blocked\n846-                               :wait-set [(edn/read-string (pr-str entry))]))]\n847-            (is (= :b (vm/value woken)))\n848-            (is (vm/halted? woken)))))))\n849-  (testing \"A terminal outcome on wake fails exactly as the immediate one did\"\n850-    (let [blocked (run-blocked-writer)\n851-          entry (first (:wait-set blocked))\n852-          handle (get (:resources blocked) (:stream-id entry))]\n853-      (stream/close! handle)\n854-      (is (thrown-with-msg?\n855-            #?(:clj Exception :cljs js/Error :cljd Object)\n856-            #\"Stream append failed\"\n857-            (vm/run blocked))\n858-          \"a parked append on a now-closed stream errors, not resumes\"))))\n859-\n860-\n861-;; =============================================================================\n862-;; FFI through the bridge\n863-;; =============================================================================\n864-\n865-(deftest ffi-call-test\n866-  (testing \"An ffi-call parks, the bridge answers, the call resumes\"\n867-    (let [vm (make-vm {:make-stream tu/make-stream, :capability-secret tu/secret\n868-                       :bridge {:op/echo identity}})\n869-          program (assemble (segment 4)\n870-                            (instruction 0 :const :yin.code/value 21)\n871-                            (instruction 1 :push)\n872-                            (instruction 2 :ffi-call :yin.code/ffi-op :op/echo\n873-                                         :yin.code/argc 1)\n874-                            (instruction 3 :halt))\n875-          result (run-segment vm program)]\n876-      (is (= 21 (vm/value result)))\n877-      (is (vm/halted? result))\n878-      (is (empty? (:parked result)) \"the completed call leaves :parked\"))))\n879-\n880-\n881-;; =============================================================================\n882-;; semantic-restore: a retained writer's response route\n883-;; =============================================================================\n884-\n885-(deftest semantic-restore-retained-response-route-test\n886-  (let [base {:parked {:parked-0 {:continuation true}}}\n887-        entry (fn [extra]\n888-                (merge {:segment 0, :pc 3, :env {}, :stack [], :k [],\n889-                        :request-sent true, :call-id :parked-0,\n890-                        :reason :put, :stream-id :yin/call-in,\n891-                        :datom {:request true}}\n892-                       extra))]\n893-    (testing \"an ordinary retained writer waits on the fixed call-out keys\"\n894-      (let [restored (semantic/semantic-restore base (entry nil))\n   :closure :lambda,\n   :call :application,\n   :ffi-call :dao.stream.apply/call,\n   :gensym :vm/gensym,\n   :store-get :vm/store-get,\n   :store-put :vm/store-put,\n   :park :vm/park,\n   :resume :vm/resume,\n   :current-continuation :vm/current-continuation,\n   :stream-make :stream/make,\n   :stream-put :stream/put,\n   :stream-cursor :stream/cursor,\n   :stream-next :stream/next,\n   :stream-close :stream/close})\n\n\n(deftest lower-rows-provenance-paths-resolve-to-the-emitting-node\n  (doseq [[label ast] (into projection-corpus (map (fn [[n a _]] [n a]) parity/corpus))]\n    (testing label\n      (let [bc (vm/ast->semantic-bytecode ast)\n            {:keys [vector provenance]} (linearize/project-rows bc)\n            occ (vm/occurrences bc)]\n        (is (= (count vector) (count provenance)))\n        (doseq [[pc _origin root path] provenance\n                :let [mnem (nth (nth vector pc) 0)\n                      id (path-row bc path)]]\n          (is (contains? (:rows bc) id)\n              (str \"path resolves at pc \" pc))\n          (is (contains? occ [root path id])\n              \"the §5.3 join key [root path node] is an occurrence\")\n          (when-let [tag (get emitting-tag mnem)]\n","exit_code":0,"status":"completed"}}
