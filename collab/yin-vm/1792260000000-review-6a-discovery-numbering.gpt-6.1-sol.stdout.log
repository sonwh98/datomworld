{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn (reached|all-census-cells|with-child|do-root)' collab/numbering-ref/probe/src/probe/discovery.clj; sed -n '535,615p' collab/numbering-ref/probe/src/probe/discovery.clj; sed -n '760,805p' test/yin/vm/ucf/rows_test.cljc; sed -n '1,90p' src/cljc/yin/vm/ucf/rows.cljc\"","aggregated_output":"628:(defn do-root\n690:(defn all-census-cells\n750:(defn reached [v]\n866:(defn with-child\n                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)\n                   ;; probe-only diagnostic, not part of the refusal's contract\n                   :probe/why (:why r)})))\n\n(defn- emit-slot* [d x numbering rows path]\n  (when-not (or (ref? d) (refs? d) (= :C d))\n    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n  (cond\n    (ref? d) (emit-node* x numbering rows path)\n    (refs? d) (reduce (fn [[out rs] [j n]]\n                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n                              [id rs'] (emit-node* n numbering rs p)]\n                          [(conj out id) rs']))\n                      [[] rows] (map-indexed vector x))\n    (= d :C) [(get numbering x x) rows]\n    (v? d) (case (first x)\n             :row (let [[id rs] (emit-node* (second x) numbering rows path)] [[:row id] rs])\n             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n             [x rows])\n    :else [x rows]))\n\n(defn- emit-node* [n numbering rows path]\n  (let [{:keys [kind slots]} n\n        [slots rows] (reduce (fn [[out rs] [i d x]]\n                               (if (and (ref? d) (= :task (:kind x)))\n                                 (let [r (discovery-numbering x)\n                                       _ (when (:refused r) (refuse-unresolved! (:refused r) path))\n                                       [id child-rows] (emit-node* x (:numbering r) {} [])]\n                                   [(conj out id) (merge rs child-rows)])\n                                 (let [[x' rs'] (emit-slot* d x numbering rs (conj path i))] [(conj out x') rs'])))\n                             [[] rows] (map vector (range) (descriptors kind slots) slots))\n        slots (if (= kind :task)\n                (-> slots\n                    (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n                    (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n                (ordered-slots kind slots))\n        body (into [kind] slots) id (jing/segment-key body)]\n    [id (assoc rows id (into [id] body))]))\n\n(defn emit*\n  \"Lift side: number by discovery order, emit; refuses :yin.k/non-portable\n   :unresolved-cursor-cells for the root or for any install child (path\n   [12 <name> ...]); a budget refusal propagates as itself.\"\n  [task]\n  (let [r (discovery-numbering task)]\n    (when (:refused r) (refuse-unresolved! (:refused r) []))\n    (let [[id rows] (emit-node* task (:numbering r) {} [])]\n      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n(defn decode*\n  \"Receiver side, in the production order (rows.cljc:570-578): 6a's decode*\n   steps 1-5 with its own numbering check off and its frame validation\n   suppressed (it still runs 6a's recompute under 6a's budget: a probe\n   limitation), then the whole discovery recomputation (root and install\n   children) under one translation: only a lift-side :yin.k/non-portable of\n   kind :unresolved-cursor-cells becomes :yin.k/undecodable\n   :unresolved-cursor-cells with the path prefixed by the carried root id;\n   anything else (a resource refusal) propagates as itself; then the root\n   comparison; then 6a's validate-frames, exactly as rows.cljc:576-578. So a\n   numbering defect is reported before a frame defect, as in production.\"\n  [wire]\n  (let [task (with-redefs [rows/validate-frames (constantly nil)]\n               (@#'rows/decode* wire (assoc rows/default-budget :check-numbering false)))\n        root (:yin.k/root wire)\n        id (try (:yin.k/root (emit* task))\n                (catch clojure.lang.ExceptionInfo e\n                  (let [d (ex-data e)]\n                    (if (and (= :yin.k/non-portable (:yin.k/status d)) (= :unresolved-cursor-cells (:yin.k/kind d)))\n                      (throw (ex-info \"unresolved cursor cells\"\n                                      (assoc d :yin.k/status :yin.k/undecodable :yin.k/path (into [root] (:yin.k/path d)))))\n                      (throw e)))))]\n    (when (not= id root)\n      (throw (ex-info \"noncanonical\" {:yin.k/status :yin.k/undecodable :yin.k/kind :noncanonical-cursor-cells\n                                      :yin.k/path [root]})))\n    (when (= :task (:kind task))\n      (when-let [d (rows/validate-frames task)]\n        (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n    task))\n\n(defn error [f]\n  (try (f) nil (catch Throwable e (or (ex-data e) {:throwable (str e)}))))\n\n\n(deftest numbering-is-total\n  (let [body (cursor-cell-body :s 0)]\n    (doseq [[task defect] [[(task-node [[:x body] [:y body]] [:cursor-cell :x]) {:missing [:y] :extra []}]\n                           [(task-node [[:x body]] (v [:x :y])) {:missing [] :extra [:y]}]]]\n      (let [d (error #(rows/emit task))]\n        (is (= defect d))\n        (is (nil? (:yin.k/status d)))))))\n\n\n(deftest gates-and-work\n  (let [limit (fn [k] {:yin.k/status :yin.k/unsupported :yin.k/kind :resource-limit :yin.k/path [k]})\n        cells (fn [k]\n                (let [ids (mapv #(keyword \"src\" (str \"n\" %)) (range k))]\n                  (task-node (mapv (fn [id i] [id (cursor-cell-body :s i)]) ids (range)) (v ids))))\n        deep (fn [k] (equal-bodies [:x] (reduce (fn [inner _] [:row (rows/node :vec [inner])]) (c :x) (range k))))\n        deep-literal (reduce (fn [inner _] [inner]) 1 (range 3000))]\n    (is (= (limit :cursor-cells) (verdict (error #(rows/emit (cells 65))))))\n    (is (= (limit :cursor-cells) (verdict (error #(rows/emit (cells 2) {:cursor-cells 1})))))\n    ;; The depth gate runs before any recursive scan of the task.\n    (is (= (limit :depth) (verdict (error #(rows/emit (deep 4) {:depth 3})))))\n    (is (= (limit :depth) (verdict (error #(rows/emit (deep 3000) {:depth 3})))))\n    (is (= (limit :depth) (verdict (error #(rows/emit (deep 3000))))))\n    (is (= (limit :depth) (verdict (error #(rows/emit (equal-bodies [:x] [:row (rows/node :vec [(c :x) [:lit deep-literal]])])\n                                                      {:depth 3})))))\n    (is (= (limit :depth) (verdict (error #(rows/emit (equal-bodies [:x :y] (s [[:row (rows/node :vec [(c :x) [:lit deep-literal]])]\n                                                                                (c :y)])))))))\n    (is (nil? (error #(rows/decode (rows/emit (deep 200))))))\n    ;; Large descriptors are charged once, in the rank labels, not per key.\n    (let [big (fn [i] (rows/node :cursor-cell-body [(rows/node :stream [:s (apply str (repeat 65536 \"d\"))]) i]))\n          task (task-node [[:x (big 0)] [:y (big 0)] [:z (big 1)] [:w (big 1)]]\n                          (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)]) (s [(c :x) (c :z)])]))]\n      (is (= 4 (count (rows/canonical-numbering task)))))\n    (let [task (fixture :s1 :s2 :x :y)]\n      (is (= (limit :work) (verdict (error #(rows/emit task {:work 1})))))\n      (is (= (limit :work) (verdict (error #(rows/decode (rows/emit task) {:work 1}))))))))\n\n\n;; Generated states (design note §5 item 18): a portable seeded generator of\n;; tasks over one to six cursor cells. Every numbered state's carrier decodes\n;; and re-emits to its root; renaming every cursor cell and shuffling every\n;; set, map and census gives the same root, or the same refusal and path.\n\n(defn- rng\n  [seed]\n(ns yin.vm.ucf.rows\n  \"Version-3 row codec. Pure row construction, graph decoding and\n   discovery-order cursor-cell numbering (design note §1); no machine\n   attachment, dependency scanner or transport.\n   An abstract row is {:kind keyword :slots vector}. Structural references\n   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n   rows. Install children are separate tasks with separate cursor-cell scopes.\n\n   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n   zero, else :slot-kind.\n\n   Default value markers are plain maps {:yin.k/row abstract-row} and\n   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n   every literal of that shape is refused :yin.k/non-portable. Explicit\n   markers use the caller value encoder.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]))\n\n\n(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n\n\n(def pending-table\n  {:next [:C]\n   :put [[:ref :stream] :V :D]\n   :ffi [:C :D :D]\n   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n   :install [:S]})\n\n\n(def row-table\n  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n   :refs is an ordered vector of structural references. :pending is\n   discriminated by pending-table. Nothing in this table is executable.\"\n  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n   :env [[:ref :bindings] :optional-D]\n   :closure [:A :N :syms [:ref :bindings] :optional-D]\n   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n   :tail [:A :N [:ref :k]]\n   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n   :kframe [:A :N [:ref :env] [:ref :window] :N]\n   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n   :module-store [:D [:ref :store]]\n   :parked-table [:pairs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n\n\n(defn- bad!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n  (when (meta x) (check-literal-markers! (meta x))))\n\n","exit_code":0,"status":"completed"}}
