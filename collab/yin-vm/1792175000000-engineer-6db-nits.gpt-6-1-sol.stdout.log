 (vm/run m0)) m0)]\n         (-> state (assoc :machine m1) (update :completed-slices (fnil inc 0)))))\n     (fn [state]\n       (completed-stage state (reader/replay (:machine state)\n                                             {:control-outstanding? (control-outstanding? state)})))\n     (fn [state]\n       (let [m (:machine state)\n             result (writer/emit\n                      (guard-writes state m)\n                      (fn [request] (require-tenure! state) (append-request! state request))\n                      (fn [diagnostic] (require-tenure! state) (append-diagnostic! state diagnostic)))]\n         (completed-stage state (update result :machine restore-handles m))))\n     (fn [state]\n       (completed-stage state\n             w (world :holders [\"holder-a\" \"holder-b\"] :sources sources)\n             record (running-pure (to-running w (driver-for w \"holder-a\" sources \"v1\")))\n             state (:state record)\n             m0 (:machine state)\n             expected (atom m0)\n             serves (atom 0)\n             expire! #(reset! (:clock record) {:s 31})\n             run sr/run-fuel\n             replay reader/replay\n             emit writer/emit\n             read-step reader/step\n             mark (fn [result stage]\n                    (let [m (assoc (:machine result) ::completed-stage stage)]\n                      (reset! expected (assoc m :resources (:resources m0)))\n                      (assoc result :machine m)))\n             _ (reset! (:attaches record) 0)\n             state (assoc-in state [:seams :serve!] (fn [_] (swap! serves inc) nil))\n             _ (when (= :before cut) (expire!))\n             result\n             (with-redefs [sr/run-fuel (fn [m n]\n                                         (let [m (run m n)]\n                                           (reset! expected m)\n                                           (when (= :after-slice cut) (expire!)) m))\n                           reader/replay (fn [& args]\n                                           (when (= :replay cut) (expire!))\n                                           ;; A failure within a stage retains its input.\n                                           (if (= :replay cut)\n                                             (throw (ex-info \"cut\" {::driver/cause :lease-bound}))\n                                             (let [r (mark (apply replay args) :replay)]\n                                               (when (= :after-replay cut) (expire!)) r)))\n                           writer/emit (fn [& args]\n                                         (when (= :emit cut) (expire!))\n                                         (if (= :emit cut)\n                                           (throw (ex-info \"cut\" {::driver/cause :lease-bound}))\n                                           (let [r (mark (apply emit args) :emit)]\n                                             (when (= :after-emit cut) (expire!)) r)))\n                           reader/step (fn [& args]\n                                         (when (= :read cut) (expire!))\n                                         (if (= :read cut)\n                                           (throw (ex-info \"cut\" {::driver/cause :lease-bound}))\n                                           (let [r (mark (apply read-step args) :read)]\n                                             (when (= :after-read cut) (expire!)) r)))]\n               (let [first (driver/program-step state)]\n                 (if (= :between cut)\n                   (do (reset! expected (:machine first)) (expire!) (driver/program-step first)) first)))\n             ended (assoc @expected :yin.k/gate :ended)]\n         (testing (str cut)\n           (is (= ended (:machine result)))\n           (is (= :lease-bound (get-in result [:detail :cause])))\n           (is (= (:address state) (get-in result [:yin.k/retained-boundary :yin.k/checkpoint])))\n           (is (= (get-in ended [:control :pc]) (get-in result [:yin.k/retained-boundary :yin.k/pc])))\n           (is (= (:bytes state) (:bytes result)) \"retained state never replaces the checkpoint\")\n(defn- require-tenure!\n  [state]\n  (when-not (lease/holding? (:holder state) (clock state))\n    (throw (ex-info \"Program IO past lease bound\" {::cause :lease-bound}))))\n\n\n(defn- guarded-handle\n  [state handle]\n  (reify\n    stream/IDaoStreamDescriptor\n    (descriptor [_] (stream/descriptor handle))\n\n\n    stream/IDaoStreamWriter\n\n    (append!\n      [_ value]\n      (require-tenure! state)\n      (stream/append! handle value))\n\n\n    stream/IDaoStreamClosable\n\n    (close!\n      [_]\n      (require-tenure! state)\n      (stream/close! handle))))\n\n\n(defn- guard-writes\n  [state machine]\n  (reduce (fn [root [path task]]\n            (assoc-in root (conj path :resources)\n                      (into {} (map (fn [[resource handle]]\n                                      [resource\n                                       (if (satisfies? stream/IDaoStreamDescriptor handle)\n                                         (guarded-handle state handle) handle)]))\n                            (:resources task))))\n          machine (machines machine)))\n\n\n(defn- restore-handles\n  [machine original]\n  (reduce (fn [root [path task]]\n            (reduce (fn [root [resource handle]]\n                      (if (satisfies? stream/IDaoStreamDescriptor handle)\n                        (assoc-in root (into path [:resources resource]) handle)\n                        root)) root (:resources task)))\n          machine (machines original)))\n\n\n","exit_code":0,"status":"completed"}}
