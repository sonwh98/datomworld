                                          (when (= FREE v)\n  1732\t                                                   (throw\n  1733\t                                                     (ex-info\n  1734\t                                                       \"Rule head var not bound by rule body\"\n  1735\t                                                       {:rule rule-name, :var hv})))\n  1736\t                                                 (and-then b #(unify % arg v))))\n  1737\t                                             binding\n  1738\t                                             (map vector call-args head-vars))]\n  1739\t                                    (if b'\n  1740\t                                      (dk st sa b')\n  1741\t                                      [st sa])))))))))))))))))))\n  1742\t\n  1743\t\n  1744\t(defn- emit-clause\n  1745\t  [st ctx clause binding acc k]\n  1746\t  (cond (and (seq? clause) (= 'or (first clause))) (emit-or st ctx clause binding acc k)\n  1747\t        (and (seq? clause) (= 'or-join (first clause)))\n  1748\t        (emit-or-join st ctx clause binding acc k)\n  1749\t        (and (seq? clause) (= 'and (first clause)))\n  1750\t        (eval-where* st ctx (rest clause) [binding] acc k)\n  1751\t        (and (seq? clause) (= 'not (first clause)))\n  1752\t        (emit-not st ctx clause binding acc k)\n  1753\t        (and (seq? clause) (= 'not-join (first clause)))\n  1754\t        (emit-not-join st ctx clause binding acc k)\n  1755\t        (seq? clause) (emit-rule st ctx clause binding acc k)\n  1756\t        (and (vector? clause) (seq? (first clause)))\n  1757\t        (emit-fn st ctx clause binding acc k)\n  1758\t        :else (emit-pattern st ctx clause binding acc k)))\n  1759\t\n  1760\t\n  1761\t(defn- estimate-clause-cost\n  1762\t  [clause binding]\n  1763\t  (let [[db-sym pattern] (clause-db-and-pattern clause)\n  1764\t        ;; Truthiness only, never forced: planning must not drain a\n  1765\t        ;; deferred (lazy published) relation. A delay is always truthy;\n  1766\t        ;; forcing here would fully materialize the source for every\n  1767\t        ;; multi-clause query before the first clause runs.\n  1768\t        relation (::relation (resolve-db binding db-sym))]\n  1769\t    (if-not relation\n  1770\t      1000000\n  1771\t      (let [{:keys [fixed]} (parse-tuple-pattern pattern)\n  1772\t            bound-count (count (remove #(= FREE (resolve-binding binding %))\n  1773\t                                       fixed))]\n  1774\t        (- 1024 bound-count)))))\n  1775\t\n  1776\t\n  1777\t(defn- plan-where\n  1778\t  [clauses init-bindings]\n  1779\t  (if (or (<= (count clauses) 1) (empty? init-bindings))\n  1780\t    clauses\n  1781\t    (let [binding (first init-bindings)]\n  1782\t      (mapcat (fn [chunk]\n  1783\t                (if (pattern-clause? (first chunk))\n  1784\t                  (mapv second\n  1785\t                        (sort-by (fn [[idx clause]]\n  1786\t                                   [(estimate-clause-cost clause\n  1787\t                                                          binding)\n  1788\t                                    idx])\n  1789\t                                 (map-indexed vector chunk)))\n  1790\t                  chunk))\n  1791\t              (partition-by pattern-clause? clauses)))))\n  1792\t\n  1793\t\n  1794\t(defn- validate-clauses!\n  1795\t  \"The static checks a clause list always paid at evaluation, whether or not\n  1796\t   an earlier clause produced a binding: disjunction branches bind the same\n  1797\t   variables, and or-join branches bind their join variables.\"\n  1798\t  [clauses]\n  1799\t  (doseq [clause clauses]\n  1800\t    (when (seq? clause)\n  1801\t      (let [h (first clause)]\n  1802\t        (cond\n  1803\t          (= 'or h) (let [branches (rest clause)]\n  1804\t                      (check-same-var-rule branches)\n  1805\t                      (doseq [b branches] (validate-clauses! (branch-clauses b))))\n  1806\t          (= 'or-join h)\n  1807\t          (let [join-vars (nth clause 1)\n  1808\t                branches (drop 2 clause)]\n  1809\t            (doseq [branch branches]\n  1810\t              (let [branch-vars (set (branch-free-vars (branch-clauses branch)))\n  1811\t                    missing (seq (remove branch-vars join-vars))]\n  1812\t                (when missing\n  1813\t                  (throw (ex-info (str \"or-join branch did not bind join var(s): \"\n  1814\t                                       (vec missing))\n  1815\t                                  {:unbound (vec missing),\n  1816\t                                   :join-vars join-vars,\n  1817\t                                   :branch branch})))))\n  1818\t            (doseq [b branches] (validate-clauses! (branch-clauses b))))\n  1819\t          (= 'and h) (validate-clauses! (rest clause))\n  1820\t          (= 'not h) (validate-clauses! (rest clause))\n  1821\t          (= 'not-join h) (validate-clauses! (drop 2 clause)))))))\n  1822\t\n  1823\t\n  1824\t(defn- walk\n  1825\t  \"Evaluate the (already planned) clause list against one binding, handing\n  1826\t   each complete binding to k. A computation: nothing here calls a clause\n  1827\t   evaluator or k directly.\"\n  1828\t  [st ctx clauses binding acc k]\n  1829\t  (if-let [cs (seq clauses)]\n  1830\t    (bounce (fn []\n  1831\t              (emit-clause st ctx (first cs) binding acc\n  1832\t                           (fn [st acc b] (walk st ctx (rest cs) b acc k)))))\n  1833\t    (bounce (fn [] (k st acc binding)))))\n  1834\t\n  1835\t\n  1836\t(defn- eval-where*\n  1837\t  \"Evaluate a clause list over a vector of initial bindings, folding every\n  1838\t   resulting binding through k: (k st acc b) -> computation of [st acc]. A\n  1839\t   `reduced` accumulator stops evaluation and is passed on to the caller.\n  1840\t   Returns a computation; `run-comp` drives it.\"\n  1841\t  [st ctx clauses init-bindings acc k]\n  1842\t  (validate-clauses! clauses)\n  1843\t  (let [planned (vec (plan-where clauses init-bindings))]\n  1844\t    (each-st st acc init-bindings\n  1845\t             (fn [st acc b] (walk st ctx planned b acc k)))))\n  1846\t\n  1847\t\n  1848\t(defn- build-init-bindings-st\n  1849\t  \"The initial bindings of :in, a checked cross product: each produced\n  1850\t   binding is one candidate.\"\n  1851\t  [st ctx in-patterns inputs dbs]\n  1852\t  (reduce\n  1853\t    (fn [[st acc] [pat val]]\n  1854\t      (if (exec/terminal? st)\n  1855\t        (reduced [st nil])\n  1856\t        (let [kind (classify-in-pattern pat)\n  1857\t              st (spend-n st ctx :candidate\n  1858\t                          (if (contains? #{:coll :relation} kind) (count val) 0))]\n  1859\t          (if (exec/terminal? st)\n  1860\t            (reduced [st nil])\n  1861\t            (let [expansion (expand-in-binding pat val dbs)]\n  1862\t              (fold-st st []\n  1863\t                       (for [b1 acc b2 expansion] [b1 b2])\n  1864\t                       (fn [st out [b1 b2]]\n  1865\t                         (let [st (spend st ctx :candidate)]\n  1866\t                           (if (exec/terminal? st)\n  1867\t                             [st out]\n  1868\t                             [st (conj out (merge-bindings b1 b2))])))))))))\n  1869\t    [st [{}]]\n  1870\t    (map vector in-patterns inputs)))\n  1871\t\n  1872\t\n   550\t\n   551\t\n   552\t(defn- check-bounded-sources!\n   553\t  \"Fail closed, before any realization: every declared source of a bounded\n   554\t   call must be admissible, including a source the plan would not use.\"\n   555\t  [in bound]\n   556\t  (doseq [[pattern arg] (map vector in bound)\n   557\t          :when (db-sym? pattern)]\n   558\t    (when-not (source-admissible? arg)\n   559\t      (fail :unsupported\n   560\t            \"bounded execution requires an explicit materialized relation source\"\n   561\t            {:reason :bounded-source-unqualified\n   562\t             :variable (fragment pattern)}))))\n   563\t\n   564\t\n   565\t(defn- run\n   566\t  \"[state result] of the common kernel for one translated query.\"\n   567\t  [st driver m args bounded?]\n   568\t  (let [in (vec (or (seq (:in m)) ['$]))\n   569\t        _ (check-find (:find m))\n   570\t        where (translate-clauses (:where m))\n   571\t        bound (check-inputs in args)\n   572\t        core-query (assoc m :in in :where where)\n   573\t        _ (when bounded? (check-bounded-sources! in bound))]\n   574\t    (try\n   575\t      (apply query/q-with-state st driver core-query bound)\n   576\t      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   577\t        (classify-core-failure e)))))\n   578\t\n   579\t\n   580\t(defn- parse-cost\n   581\t  [form]\n   582\t  (if (string? form)\n   583\t    (inc (quot (count form) 128))\n   584\t    1))\n   585\t\n   586\t\n   587\t(defn- execute\n   588\t  \"The whole invocation under one execution state: parse, translate,\n   589\t   evaluate, output. `bounded?` selects the admission rule.\"\n   590\t  [form args {:keys [offset limit st driver bounded?]}]\n   591\t  (let [st (advance st driver :parse (parse-cost form))\n   592\t        m (query-map form)\n   593\t        st (advance st driver :parse (count (tree-seq coll? seq m)))\n   594\t        [st res] (run st driver m args bounded?)\n   595\t        _ (when (exec/terminal? st) (exhausted! st))\n   596\t        rows (:dao.space.query/result res)\n   597\t        st (advance st driver :output (if (coll? rows) (count rows) 1))\n   598\t        result (query/collect res)\n   599\t        paged (paginate result (if (or (:keys m) (:syms m) (:strs m))\n   600\t                                 :relation\n   601\t                                 (spec-of (:find m)))\n   602\t                        offset limit)\n   603\t        st (exec/finish st driver)]\n   604\t    (when (exec/terminal? st) (exhausted! st))\n   605\t    paged))\n   606\t\n   607\t\n   608\t(defn- invocation\n   609\t  \"The execution inputs of an arg-map call; the clock is read FIRST (before\n   610\t   any parsing) when a timeout was supplied, and the absolute deadline is\n   611\t   that reading plus the timeout.\"\n   612\t  [arg-map]\n   613\t  (let [now-fn (let [f (::now-fn arg-map)] (if (fn? f) f default-now-ms))\n   614\t        t0 (when (contains? arg-map :timeout) (now-fn))\n   615\t        [offset limit timeout max-steps] (check-options arg-map)]\n   616\t    {:offset offset\n   617\t     :limit limit\n   618\t     :driver (exec/fn-driver now-fn)\n   619\t     :bounded? (or (some? timeout) (some? max-steps))\n   620\t     :st (exec/start {:deadline (when timeout (+ t0 timeout))\n   621\t                      :max-steps max-steps})}))\n   622\t\n   623\t\n   624\t(def ^:private unbounded-invocation\n   625\t  {:offset 0 :limit -1 :driver nil :bounded? false :st exec/unbounded})\n   626\t\n   627\t\n   628\t(defn- db-first?\n   629\t  [x]\n   630\t  (or (query/value? x)\n  1374\t(defn- bind-fn-result\n  1375\t  \"The bindings a fn clause's result ret yields under its binding form out:\n  1376\t   the forms :in accepts (classify-in-pattern), with Datomic semantics.\n  1377\t   Scalar ?x binds ret; tuple [?a ?b] binds positionally; collection\n  1378\t   [?x ...] yields one binding per element; relation [[?a ?b]] one per\n  1379\t   tuple. Terms unify as in patterns, so _ is blank and a bare symbol is a\n  1380\t   constant. A collection or relation form takes a sequential or a set ret\n  1381\t   (order is irrelevant: the result is a set); nil or an empty one yields\n  1382\t   no binding, and anything else, a map included, is a query error.\"\n  1383\t  [binding out ret clause]\n  1384\t  (if-not (vector? out)\n  1385\t    (if-let [b (unify binding out ret)] [b] [])\n  1386\t    (let [kind (classify-in-pattern out)\n  1387\t          terms (case kind\n  1388\t                  :coll (butlast out)\n  1389\t                  :relation (first out)\n  1390\t                  :tuple out)]\n  1391\t      (when (or (and (= :coll kind) (not= 2 (count out)))\n  1392\t                (and (= :relation kind) (not= 1 (count out)))\n  1393\t                (some #(or (= '... %) (vector? %)) terms))\n  1394\t        (throw (ex-info\n  1395\t                 \"Unsupported binding form — use ?x, [?a ?b], [?x ...] or [[?a ?b]]\"\n  1396\t                 {:binding-form out, :clause clause})))\n  1397\t      (when (and (#{:coll :relation} kind)\n  1398\t                 (not (or (nil? ret) (sequential? ret) (set? ret))))\n  1399\t        (throw (ex-info (str \"Function return for a \"\n  1400\t                             (if (= :coll kind) \"collection\" \"relation\")\n  1401\t                             \" binding must be nil, sequential or a set\")\n  1402\t                        {:binding-form out, :returned ret, :clause clause})))\n  1403\t      (case kind\n  1404\t        :tuple (if-let [b (unify-tuple binding out ret clause)] [b] [])\n  1405\t        :coll (let [term (first out)]\n  1406\t                (into [] (keep #(unify binding term %)) ret))\n  1407\t        :relation (into [] (keep #(unify-tuple binding terms % clause)) ret)))))\n  1408\t\n  1409\t\n  1410\t;; =============================================================================\n  1411\t;; The evaluation kernel (continuation-passing, depth-first, state-passing)\n  1412\t;; =============================================================================\n  1413\t;; `emit-*` evaluates one clause against ONE binding and hands every output\n  1414\t;; binding to the continuation k: (k st acc b') -> [st acc]. The rest of the\n  1415\t;; conjunction is the continuation, so evaluation is depth first and the\n  1416\t;; consumer decides the demand: collecting everything, or answering\n  1417\t;; `reduced` at the first witness (not, not-join). Nothing is materialized\n  1418\t;; beyond what a clause itself enumerates; deduplication of a nested rule or\n  1419\t;; disjunction is a seen-set carried in the accumulator, not a lazy chain.\n  1420\t\n46de095b\n","exit_code":0,"status":"completed"}}
