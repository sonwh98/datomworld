fn- range-scannable?\n652:(defn- slot-pred\n661:(defn- index-candidates\n694:(defn- select-by-index\n703:(defn- datoms-st\n722:        :else (let [st (spend st ctx op)]\n729:(defn datoms\n745:(defn rows\n770:(defn match\n799:(defn- wildcard-symbol?\n804:(defn- parse-attr-options\n817:(defn parse-pattern\n838:(defn- reverse-attr?\n843:(defn- forward-attr-name\n848:(defn- apply-options\n855:(defn- reverse-to-forward\n860:(defn- project-reverse-attr\n877:(defn- project-flat-attr\n894:(defn- project-wildcard\n906:(defn- pull-flat\n916:                       (let [st (spend st ctx :pull-advance)]\n929:(defn- project-nested-attr\n953:(defn- pull-full-impl\n966:(defn- pull-idx\n979:(defn pull\n994:(defn pull-many\n1019:(defn- type-label\n1025:(defn- content-eq\n1034:(defn- content-not-eq\n1039:(defn- require-numeric!\n1047:(defn- numeric-chain\n1065:(defn- preferred-tie\n1084:(defn- portable-min\n1094:(defn- portable-max\n1102:(defn- variadic\n1109:(defn- host-arithmetic\n1125:(defn- portable-subvec\n1177:(defn- resolve-binding\n1187:(defn- binding-key\n1201:(defn- content-distinct\n1222:(defn- unify\n1236:(defn- unify-slots\n1249:(defn- and-then\n1254:(defn- db-sym?\n1259:(defn- classify-in-pattern\n1269:(defn- expand-in-binding\n1280:(defn- merge-bindings\n1286:(defn- pattern-clause?\n1291:(defn- clause-db-and-pattern\n1298:(defn- resolve-db\n1303:(defn- resolve-relation\n1308:(defn- resolve-fact-index\n1313:(defn- query-var?\n1318:(defn- not-required-vars\n1330:(defn- branch-clauses\n1335:(defn- branch-free-vars\n1344:(defn- check-same-var-rule\n1353:(defn- resolve-special-arg\n1361:(defn- unify-tuple\n1374:(defn- bind-fn-result\n1424:(defn- select-probe-st\n1440:(defn- eval-special-fn\n1475:(defn- fn-clause-outputs\n1530:(defn- emit-fn\n1532:  (let [st (spend st ctx :candidate)]\n1541:(defn- emit-pattern\n1553:                     (let [st (spend st ctx :candidate)]\n1563:                 (let [st (spend st ctx :scan-advance)\n1564:                       st (if (exec/terminal? st) st (spend st ctx :candidate))]\n1572:(defn- dedup-k\n1580:        (bind (bounce (fn [] (k st acc b)))\n1588:(defn- run-dedup\n1592:  (bind (bounce (fn [] (body st [#{} acc] (dedup-k k))))\n1599:(defn- exists-st\n1608:(defn- emit-not\n1621:                  :else (bounce (fn [] (k st acc binding))))))))\n1624:(defn- emit-not-join\n1638:                    :else (bounce (fn [] (k st acc binding)))))))))\n1641:(defn- emit-or\n1650:(defn- emit-or-join\n1674:(defn- emit-rule\n1686:      (let [st (spend st ctx :rule-entry)]\n1744:(defn- emit-clause\n1761:(defn- estimate-clause-cost\n1777:(defn- plan-where\n1794:(defn- validate-clauses!\n1824:(defn- walk\n1830:    (bounce (fn []\n1833:    (bounce (fn [] (k st acc binding)))))\n1836:(defn- eval-where*\n1840:   Returns a computation; `run-comp` drives it.\"\n1848:(defn- build-init-bindings-st\n1857:              st (spend-n st ctx :candidate\n1865:                         (let [st (spend st ctx :candidate)]\n1873:(defn- normalize-query\n1902:(defn- parse-find-element\n1926:(defn- parse-find\n1943:(defn- check-return-map-arity\n1954:(defn- apply-spec\n1967:(defn- key-fn-for\n1976:(defn- apply-return-map\n1985:(defn- check-declared-symbols\n2011:(defn- project-element-st\n2023:(defn- project-row-st\n2031:(defn- add-distinct\n2040:(defn- relation-result-st\n2051:      (let [[st acc] (run-comp\n2055:                         (let [st (spend st ctx :output-row)]\n2070:            [st acc] (run-comp\n2074:                           (let [st (spend st ctx :aggregate-input)]\n2087:                             (let [st (spend st ctx :output-row)]\n2106:(defn q-with-state\n2137:        st (spend-n st ctx :parse-step\n2187:(defn q\n2199:(defn collect\n2218:(defn entity-attrs\n\n(defn ^:no-doc default-now-ms\n  \"The default clock: a monotonic source expressed in milliseconds where the\n   host offers one (JVM `System/nanoTime`; JavaScript `performance.now`).\n   Dart has no portable monotonic reading here, so it falls back to\n   WALL-CLOCK milliseconds: a clock adjustment can then shorten or lengthen\n   a timeout, and that is not monotonic behavior. Callers needing a\n   different clock pass `:dao.space.query.datomic/now-fn`.\"\n  []\n  #?(:cljd (.-millisecondsSinceEpoch (dart-core/DateTime.now))\n     :clj (quot (System/nanoTime) 1000000)\n     :cljs (if (and (exists? js/performance) (fn? (.-now js/performance)))\n             (.now js/performance)\n             (.getTime (js/Date.)))))\n\n\n(defn- paginate\n  [result spec offset limit]\n  (let [paged? (or (pos? offset) (not= -1 limit))]\n    (cond\n      (contains? #{:scalar :tuple} spec)\n      (do (when paged?\n            (fail :unsupported \"offset/limit require a relation or collection find\"\n                  {:option (if (pos? offset) :offset :limit)}))\n          result)\n      :else\n      (let [rows (cond->> (seq result)\n                   (pos? offset) (drop offset)\n                   (not= -1 limit) (take limit))]\n        (vec rows)))))\n\n\n;; ==========================================================================\n;; Execution\n;; ==========================================================================\n\n(defn- spec-of\n  [find]\n  (let [f (first find)]\n    (cond (and (vector? f) (some #(= '... %) f)) :coll\n          (vector? f) :tuple\n          (some #(= (symbol \".\") %) find) :scalar\n          :else :relation)))\n\n\n(defn- classify-core-failure\n  \"Rethrow a core failure under the adapter taxonomy. Core ex-data can embed\n   bindings, so ordinary core refusals keep only their message; a genuine\n   fault or source failure keeps its cause.\"\n  [e]\n  (let [data (ex-data e)\n        category (:cognitect.anomalies/category data)]\n    (cond\n      (::error data) (throw e)\n      category (fail :source-failed \"source read failed\"\n                     {:cognitect.anomalies/category category} e)\n      (some? data)\n      (let [msg (or (ex-message e) \"query refused\")]\n        (if (str/includes? msg \"not implemented\")\n          (fail :unsupported msg {})\n          (fail :invalid-request msg {})))\n      :else (fail :evaluation-failed \"query evaluation failed\" {} e))))\n\n\n(defn- exhausted!\n  \"Translate a terminal execution outcome into the structured exception. A\n   partial relation is never returned.\"\n  [st]\n  (let [{:keys [kind phase steps]} (exec/outcome st)]\n    (if (= :timeout kind)\n      (fail :timeout \"query deadline expired\"\n            {:option :timeout, :phase phase, :steps steps})\n      (fail :step-budget-exhausted \"query work allowance exhausted\"\n            {:option ::max-steps, :phase phase, :steps steps}))))\n\n\n(defn- advance\n  \"Adapter-side accounting: enter `phase`, then charge n units before the\n   adapter performs the corresponding (indivisible) work. n = 0 only\n   observes. Throws the structured exhaustion error on a terminal state.\"\n  [st driver phase n]\n  (let [st (exec/enter st phase)\n        st (if (pos? n) (exec/step st driver n) (exec/checkpoint st driver phase))]\n    (if (exec/terminal? st) (exhausted! st) st)))\n\n\n(defn- source-admissible?\n  \"Phase 4a admission: a source qualifies for bounded execution only when\n   its descriptor chain is an explicit materialized relation/fact-relation,\n   or a view over one. Descriptors are inspected, never forced: a deferred\n   (delay) relation, an opened published index and anything unrecognized are\n   not admissible, and cache residency does not change that.\"\n  [v]\n  (and (map? v)\n       (cond\n         (contains? v :dao.space.query/relation)\n         (vector? (:dao.space.query/relation v))\n         (contains? v :dao.space.query/view)\n         (source-admissible? (:source v))\n         :else false)))\n\n\n(defn- check-bounded-sources!\n  \"Fail closed, before any realization: every declared source of a bounded\n   call must be admissible, including a source the plan would not use.\"\n  [in bound]\n  (doseq [[pattern arg] (map vector in bound)\n          :when (db-sym? pattern)]\n    (when-not (source-admissible? arg)\n      (fail :unsupported\n            \"bounded execution requires an explicit materialized relation source\"\n            {:reason :bounded-source-unqualified\n             :variable (fragment pattern)}))))\n\n\n(defn- run\n  \"[state result] of the common kernel for one translated query.\"\n  [st driver m args bounded?]\n  (let [in (vec (or (seq (:in m)) ['$]))\n        _ (check-find (:find m))\n        where (translate-clauses (:where m))\n        bound (check-inputs in args)\n        core-query (assoc m :in in :where where)\n        _ (when bounded? (check-bounded-sources! in bound))]\n    (try\n      (apply query/q-with-state st driver core-query bound)\n      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n        (classify-core-failure e)))))\n\n\n(defn- parse-cost\n  [form]\n  (if (string? form)\n    (inc (quot (count form) 128))\n    1))\n\n\n(defn- execute\n  \"The whole invocation under one execution state: parse, translate,\n   evaluate, output. `bounded?` selects the admission rule.\"\n  [form args {:keys [offset limit st driver bounded?]}]\n  (let [st (advance st driver :parse (parse-cost form))\n        m (query-map form)\n        st (advance st driver :parse (count (tree-seq coll? seq m)))\n        [st res] (run st driver m args bounded?)\n        _ (when (exec/terminal? st) (exhausted! st))\n        rows (:dao.space.query/result res)\n        st (advance st driver :output (if (coll? rows) (count rows) 1))\n        result (query/collect res)\n        paged (paginate result (if (or (:keys m) (:syms m) (:strs m))\n                                 :relation\n                                 (spec-of (:find m)))\n                        offset limit)\n        st (exec/finish st driver)]\n    (when (exec/terminal? st) (exhausted! st))\n    paged))\n\n\n(defn- invocation\n  \"The execution inputs of an arg-map call; the clock is read FIRST (before\n   any parsing) when a timeout was supplied, and the absolute deadline is\n   that reading plus the timeout.\"\n  [arg-map]\n  (let [now-fn (let [f (::now-fn arg-map)] (if (fn? f) f default-now-ms))\n        t0 (when (contains? arg-map :timeout) (now-fn))\n        [offset limit timeout max-steps] (check-options arg-map)]\n    {:offset offset\n     :limit limit\n     :driver (exec/fn-driver now-fn)\n     :bounded? (or (some? timeout) (some? max-steps))\n     :st (exec/start {:deadline (when timeout (+ t0 timeout))\n                      :max-steps max-steps})}))\n\n\n(def ^:private unbounded-invocation\n  {:offset 0 :limit -1 :driver nil :bounded? false :st exec/unbounded})\n\n\n(defn- db-first?\n  [x]\n  (or (query/value? x)\n      (and (map? x) (contains? x :relation) (contains? x :status))))\n\n\n(defn q\n  \"Datomic Client `q`: `(q arg-map)` with `:query`, `:args`, `:offset`,\n   `:limit`, or `(q query & args)`. `query` is a map, a vector/list or an\n   EDN string. Returns realized data; see the namespace docstring for the\n   refusals and the error taxonomy.\"\n  ([arg-map]\n   (cond\n     (db-first? arg-map)\n     (fail :unsupported \"db-first q is not the public Client call shape\" {})\n\n     (and (map? arg-map) (contains? arg-map :query))\n     (execute (:query arg-map) (get arg-map :args []) (invocation arg-map))\n\n     (or (string? arg-map) (sequential? arg-map)\n         (and (map? arg-map) (some #(contains? arg-map %) [:find :where :in])))\n     (execute arg-map [] unbounded-invocation)\n\n     :else (fail :invalid-request \"q requires an arg-map or a query\" {})))\n  ([query-or-db & args]\n   (if (db-first? query-or-db)\n     (fail :unsupported \"db-first q is not the public Client call shape\" {})\n     (execute query-or-db (vec args) unbounded-invocation))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'python3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target working; cat .agents/skills/code-review-pr/references/review_checklist.md'","aggregated_output":"# Code Review Summary for `working`\n\n## Executive Overview\n- **Total Files Changed:** 10\n- **Lines Added:** +1319 | **Lines Deleted:** -548\n- **Test-to-Source Additions Ratio:** 0.05 (52 test lines vs 1092 source lines)\n- **Overall Change Risk:** `MEDIUM`\n\n### Included Commits\n- 46de095b docs(orchestrator-log): the collateral-kill correction — agy owns the I7 arc; this seat is hands-off\n- 57207b36 docs(orchestrator-log): the seat hands off to agy — the in-flight rounds preserved, the handoff brief in collab\n- 1d29cdcf feat(dao.space.query): add the datomic client-api q adapter boundary (phase 1)\n- b670cd4b merge: J2b(a) closed at zero pins — JS/Dart lexer helpers match the Java canonical (formfeed, lastToken, dedent line, MakeCommonToken position)\n- 3d77ed52 feat(dao.space.query): freeze the datomic client-api q compatibility contract and datomic-q-v1 corpus\n\n## Automated Scan Findings\n✅ No critical security or code quality smells detected by automated scan.\n\n## File Churn & Risk Breakdown\n| File Path | Category | +Add | -Del | Risk |\n| :--- | :--- | :--- | :--- | :--- |\n| `src/cljc/dao/space/query.cljc` | Source Code | +927 | -489 | `Medium` |\n| `src/cljc/dao/space/query/datomic.cljc` | Source Code | +165 | -21 | `Medium` |\n| `docs/design/dao.space.query.datomic-compat.md` | Documentation | +152 | -22 | `Low` |\n| `test/resources/dao/space/datomic-q-v1.errata.md` | Tests | +32 | -0 | `Low` |\n| `docs/orchestrator-log.md` | Documentation | +23 | -0 | `Low` |\n| `test/dao/space/query/datomic_test.cljc` | Tests | +7 | -6 | `Low` |\n| `test/resources/dao/space/datomic-q-v1.provenance.edn` | Tests | +6 | -4 | `Low` |\n| `test/resources/dao/space/datomic-q-v1.json` | Tests | +3 | -2 | `Low` |\n| `test/dao/space/datomic_query_conformance_test.cljc` | Tests | +2 | -2 | `Low` |\n| `test/resources/dao/space/datomic-q-v1.README.md` | Tests | +2 | -2 | `Low` |\n\n## Reviewer Focus & Recommendations\n- 🧪 **Testing:** Test coverage appears low relative to source code additions. Request unit/integration test additions.\n# Code Review PR Checklist & Taxonomy\n\nWhen performing code reviews, evaluate changes using this structured checklist and severity taxonomy.\n\n---\n\n## 1. Finding Severity Taxonomy\n\n| Severity | Label | Definition | Examples |\n| :--- | :--- | :--- | :--- |\n| **P0** | **Critical (Blocker)** | Security vulnerabilities, data loss risks, production crashes, secret leakage. Must be fixed before merging. | Hardcoded tokens, unhandled NullPointer on critical path, SQL injection, broken auth check. |\n| **P1** | **High (Must Address)** | Logic bugs, breaking API changes, missing error handling on external calls, race conditions, lack of tests for complex logic. | Swallowed exceptions, broken retry loop, missing backward compatibility in API schema. |\n| **P2** | **Medium (Recommended)** | Performance inefficiencies, code duplication, sub-optimal data structures, non-idiomatic style. | Unnecessary DB query inside loop, missing index, missing parameter validation. |\n| **P3** | **Low (Nit / Suggestion)** | Minor formatting, naming improvements, leftover comments/TODOs, minor doc polish. | Variable naming clarity, typos in docstrings, cleaning leftover TODO comments. |\n\n---\n\n## 2. Comprehensive Review Checklist\n\n### A. Logic & Correctness\n- [ ] **Edge Cases**: Does the code handle null/nil/undefined, empty collections, zero values, boundary numbers, and unexpected inputs?\n- [ ] **State & Concurrency**: Are shared state mutations thread-safe? Are locks acquired/released properly without deadlock risks?\n- [ ] **Control Flow**: Are all conditional branches covered? Do loops have guaranteed termination conditions?\n- [ ] **Error Propagation**: Are errors caught and logged/surfaced appropriately, rather than swallowed silently (`catch (Exception e) {}`)?\n\n### B. Security & Credentials\n- [ ] **No Hardcoded Secrets**: Are API keys, passwords, bearer tokens, or private keys excluded from code and config?\n- [ ] **Input Validation & Sanitization**: Are external inputs validated before processing or passing to system shells, DB queries, or HTML rendering?\n- [ ] **Authentication & Authorization**: Do endpoints verify user identity and check permissions before executing state changes?\n- [ ] **Safe Dependencies**: Are newly added packages pinned to trusted versions without known vulnerabilities?\n\n### C. Architecture & API Design\n- [ ] **Preserve API Contracts**: Are public method signatures, REST endpoints, and schema definitions backward compatible?\n- [ ] **Single Responsibility**: Are modules, classes, and functions focused on a clear, single responsibility?\n- [ ] **Coupling & Cohesion**: Is the new code properly modularized without introducing circular dependencies or leaky abstractions?\n- [ ] **Idempotence**: Are retry loops or state-changing operations safe to re-execute on transient failures?\n\n### D. Performance & Resource Efficiency\n- [ ] **N+1 Queries**: Are database or remote API calls executed in batches rather than inside loops?\n- [ ] **Resource Cleanup**: Are file handles, database connections, streams, and web sockets closed explicitly (or managed via try-with-resources / context managers)?\n- [ ] **Memory & Allocation**: Are large datasets streamed or paginated rather than loaded fully into memory at once?\n\n### E. Test Coverage & Quality\n- [ ] **Test Coverage**: Do new features or bug fixes include corresponding unit or integration tests?\n- [ ] **Test Quality**: Do tests verify actual assertions rather than just checking that code runs without throwing?\n- [ ] **Edge Case Tests**: Are failure modes, invalid inputs, and error handlers covered by unit tests?\n\n---\n\n## 3. Review Feedback Guidelines\n\n1. **Be Specific**: Always reference the exact file line number, function name, and context.\n2. **Explain the \"Why\"**: Don't just say \"change this\". Explain the risk or benefit (e.g., \"This could lead to a race condition if two threads call `transact!` simultaneously...\").\n3. **Provide Concrete Fixes**: Offer concrete, copy-pasteable diff snippets where appropriate.\n4. **Acknowledge Good Work**: Highlight well-crafted solutions, thorough tests, or clean refactorings.\n","exit_code":0,"status":"completed"}}
