{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn.*(bind-fn|emit-fn|source-admissible|realize|syntax|build-init|each-st)|max-syntax|extent' src/cljc/dao/space/query.cljc src/cljc/dao/space/query/datomic.cljc; sed -n '480,600p' src/cljc/dao/space/query.cljc; sed -n '1380,1455p' src/cljc/dao/space/query.cljc; sed -n '1540,1600p' src/cljc/dao/space/query.cljc; cat test/resources/dao/space/datomic-q-v1.errata.md | tail -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn.*(bind-fn|emit-fn|source-admissible|realize|syntax|build-init|each-st)|max-syntax|extent' src/cljc/dao/space/query.cljc src/cljc/dao/space/query/datomic.cljc; sed -n '480,600p' src/cljc/dao/space/query.cljc; sed -n '1380,1455p' src/cljc/dao/space/query.cljc; sed -n '1540,1600p' src/cljc/dao/space/query.cljc; cat test/resources/dao/space/datomic-q-v1.errata.md | tail -65\"","aggregated_output":"src/cljc/dao/space/query/datomic.cljc:94:(def max-syntax-depth\nsrc/cljc/dao/space/query/datomic.cljc:97:   checked by the scanner, native map/vector queries by `syntax-extent`.\nsrc/cljc/dao/space/query/datomic.cljc:106:;; Syntax extent (iterative, bounded)\nsrc/cljc/dao/space/query/datomic.cljc:109:(defn- syntax-extent\nsrc/cljc/dao/space/query/datomic.cljc:112:   `max-syntax-depth`.\"\nsrc/cljc/dao/space/query/datomic.cljc:121:          (if (> d max-syntax-depth)\nsrc/cljc/dao/space/query/datomic.cljc:130:(defn- check-syntax-extent!\nsrc/cljc/dao/space/query/datomic.cljc:134:  (let [[nodes exceeded?] (syntax-extent form)]\nsrc/cljc/dao/space/query/datomic.cljc:169:            (if (>= depth max-syntax-depth)\nsrc/cljc/dao/space/query/datomic.cljc:443:              (= '% pattern) (do (check-syntax-extent! arg) (translate-rules arg))\nsrc/cljc/dao/space/query/datomic.cljc:580:(defn- source-admissible?\nsrc/cljc/dao/space/query/datomic.cljc:648:        st (advance st driver :parse (check-syntax-extent! m))\nsrc/cljc/dao/space/query.cljc:453:(defn- each-st\nsrc/cljc/dao/space/query.cljc:497:(defn ^:no-doc realize-db-value!\nsrc/cljc/dao/space/query.cljc:547:(defn- realize-base-st\nsrc/cljc/dao/space/query.cljc:577:(defn- realize-st\nsrc/cljc/dao/space/query.cljc:1407:(defn- bind-fn-result\nsrc/cljc/dao/space/query.cljc:1567:(defn- emit-fn\nsrc/cljc/dao/space/query.cljc:1896:(defn- build-init-bindings-st\n                              [(nth tuple 0) (nth tuple 1)\n                               (nth tuple 2) 0 datom/default-op])\n                            relation)))\n\n\n(defn- force-relation\n  \"Force a relation if it is delayed (e.g. from a lazy covered-index\n   realization) or return it directly. Memoization belongs to the delay:\n   forcing is therefore at most one walk, but this function itself neither\n   creates nor guarantees non-nilness.\"\n  [relation]\n  (if (delay? relation) @relation relation))\n\n\n(declare realize-st)\n\n\n(defn ^:no-doc realize-db-value!\n  \"Turn one db-value into an immutable tuple relation plus, for current\n   fact views, an in-memory fact index. Opens nothing, closes nothing.\n   Runs the checked realization with the explicit unbounded policy.\"\n  [db-value]\n  (second (realize-st exec/unbounded unbounded-ctx db-value)))\n\n\n(def ^:private raw-source-message\n  \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\")\n\n\n(defn- relation-size\n  \"The tuple count of a relation without forcing a deferred one.\"\n  [relation]\n  (if (delay? relation) 0 (count relation)))\n\n\n(defn- apply-view-st\n  \"Interpret ONE current/history view over its already realized source. A\n   current view with no as-of over an opened published index routes through\n   the restored covered sets; every other combination resolves the source's\n   rows. The tuples interpreted and indexed are charged before the\n   indivisible host operation runs.\"\n  [st ctx d src]\n  (let [kind (:dao.space.query/view d)\n        as-of (:as-of d)\n        {src-relation ::relation, src-indexes ::indexes} src]\n    (if (and (= :current kind) (nil? as-of) src-indexes)\n      [st {::relation (delay (d5->current-facts (force-relation src-relation) nil)),\n           ::fact-index src-indexes}]\n      (let [forced-rel (force-relation src-relation)\n            st (spend-n st ctx :scan-advance (relation-size forced-rel))]\n        (if (exec/terminal? st)\n          [st nil]\n          (let [rows (case kind\n                       :current (d5->current-facts forced-rel as-of)\n                       :history (d5->history-rows forced-rel as-of))\n                st (spend-n st ctx :scan-advance\n                            (if (= :current kind) (count rows) 0))]\n            (if (exec/terminal? st)\n              [st nil]\n              (let [fact-index (when (= :current kind)\n                                 (relation->fact-index rows))\n                    st (observe-st st ctx)]\n                (if (exec/terminal? st)\n                  [st nil]\n                  [st {::relation rows, ::fact-index fact-index}])))))))))\n\n\n(defn- realize-base-st\n  \"Realize a non-view db-value: a relation (and, for a fact relation, its\n   index) or an opened published index.\"\n  [st ctx db-value]\n  (cond\n    (contains? db-value :dao.space.query/relation)\n    (let [tuples (:dao.space.query/relation db-value)\n          fact? (:fact? db-value)\n          st (spend-n st ctx :scan-advance (if fact? (relation-size tuples) 0))]\n      (if (exec/terminal? st)\n        [st nil]\n        (let [fact-index (when fact? (relation->fact-index tuples))\n              st (observe-st st ctx)]\n          (if (exec/terminal? st)\n            [st nil]\n            [st {::relation tuples, ::fact-index fact-index}]))))\n\n    (contains? db-value :dao.space.query/published)\n    (do (when (exec/bounded? st)\n          (throw (ex-info \"bounded execution does not support opened published indexes\"\n                          {:reason :bounded-source-unqualified})))\n        (let [indexes (index/covered-indexes db-value)]\n          [st {::relation (:rows db-value),\n               ::indexes indexes,\n               ::fact-index nil}]))\n\n    :else\n    (throw (ex-info raw-source-message {:input db-value}))))\n\n\n(defn- realize-st\n  \"The checked realization of one db-value: [state realized]. Iterative: the\n   view chain is walked down to its base source in a loop (one accounted\n   unit per descriptor hop) and the views are applied back up in a second\n   loop, so a source chain of any depth uses constant host stack. Tuples and\n   index entries are charged before the (indivisible) host construction and\n   the state is observed when it returns. A bounded state refuses an opened\n   published index: its traversal is not checkpointed.\"\n  [st ctx db-value]\n  (loop [st st\n         v db-value\n         views ()]\n    (when-not (map? v)\n      (throw (ex-info raw-source-message {:input v})))\n    (cond\n      (exec/terminal? st) [st nil]\n\n      (and (contains? v :dao.space.query/view)\n           (not (contains? v :dao.space.query/relation))\n           (not (contains? v :dao.space.query/published)))\n      (recur (spend st ctx :scan-advance) (:source v) (conj views v))\n\n      :else\n      (let [[st base] (realize-base-st st ctx v)]\n    (when-not (apply = var-sets)\n      (throw (ex-info \"All branches of or must bind the same set of variables\"\n                      {:branches (vec branches),\n                       :branch-vars (vec var-sets)})))))\n\n\n(defn- resolve-special-arg\n  [binding a]\n  (let [v (resolve-binding binding a)]\n    (when (= v FREE)\n      (throw (ex-info \"Unbound variable in special-form clause\" {:var a})))\n    v))\n\n\n(defn- unify-tuple\n  \"Unify each term of a tuple binding form with the matching position of\n   ret, or nil on a mismatch. A ret that is not sequential or not of the\n   form's arity is a query error.\"\n  [binding terms ret clause]\n  (when (or (not (sequential? ret)) (not= (count terms) (count ret)))\n    (throw (ex-info \"Function return does not match tuple binding arity\"\n                    {:binding-form terms, :returned ret, :clause clause})))\n  (reduce (fn [b [term val]] (or (unify b term val) (reduced nil)))\n          binding\n          (map vector terms ret)))\n\n\n(defn- bind-fn-result\n  \"The bindings a fn clause's result ret yields under its binding form out:\n   the forms :in accepts (classify-in-pattern), with Datomic semantics.\n   Scalar ?x binds ret; tuple [?a ?b] binds positionally; collection\n   [?x ...] yields one binding per element; relation [[?a ?b]] one per\n   tuple. Terms unify as in patterns, so _ is blank and a bare symbol is a\n   constant. A collection or relation form takes a sequential or a set ret\n   (order is irrelevant: the result is a set); nil or an empty one yields\n   no binding, and anything else, a map included, is a query error.\"\n  [binding out ret clause]\n  (if-not (vector? out)\n    (if-let [b (unify binding out ret)] [b] [])\n    (let [kind (classify-in-pattern out)\n          terms (case kind\n                  :coll (butlast out)\n                  :relation (first out)\n                  :tuple out)]\n      (when (or (and (= :coll kind) (not= 2 (count out)))\n                (and (= :relation kind) (not= 1 (count out)))\n                (some #(or (= '... %) (vector? %)) terms))\n        (throw (ex-info\n                 \"Unsupported binding form — use ?x, [?a ?b], [?x ...] or [[?a ?b]]\"\n                 {:binding-form out, :clause clause})))\n      (when (and (#{:coll :relation} kind)\n                 (not (or (nil? ret) (sequential? ret) (set? ret))))\n        (throw (ex-info (str \"Function return for a \"\n                             (if (= :coll kind) \"collection\" \"relation\")\n                             \" binding must be nil, sequential or a set\")\n                        {:binding-form out, :returned ret, :clause clause})))\n      (case kind\n        :tuple (if-let [b (unify-tuple binding out ret clause)] [b] [])\n        ;; collection / relation results are NOT enumerated here: the plan\n        ;; hands the kernel the items and the per-item attempt, and the\n        ;; kernel charges every attempt (rejected ones too)\n        :coll (let [term (first out)]\n                {::items ret, ::attempt (fn [x] (unify binding term x))})\n        :relation {::items ret,\n                   ::attempt (fn [t] (unify-tuple binding terms t clause))}))))\n\n\n;; =============================================================================\n;; The evaluation kernel (continuation-passing, depth-first, state-passing)\n;; =============================================================================\n;; `emit-*` evaluates one clause against ONE binding and hands every output\n;; binding to the continuation k: (k st acc b') -> [st acc]. The rest of the\n;; conjunction is the continuation, so evaluation is depth first and the\n;; consumer decides the demand: collecting everything, or answering\n;; `reduced` at the first witness (not, not-join). Nothing is materialized\n;; beyond what a clause itself enumerates; deduplication of a nested rule or\n      :else\n      (let [f (get-in ctx [:fns fsym])]\n        (when-not f\n          (throw (ex-info \"Unknown query fn — pass it via the :fns option\"\n                          {:fn fsym, :clause clause})))\n        (let [arg-vals (mapv (fn [a]\n                               (let [v (resolve-binding binding a)]\n                                 (when (= v FREE)\n                                   (throw (ex-info \"Unbound variable in fn clause\"\n                                                   {:var a, :clause clause})))\n                                 v))\n                             args)\n              ret (apply f arg-vals)\n              st (observe-st st ctx)]\n          (if (exec/terminal? st)\n            [st nil]\n            [st (if (empty? result-vars)\n                  (if ret [binding] [])\n                  (let [out (first result-vars)]\n                    (when (> (count result-vars) 1)\n                      (throw\n                        (ex-info\n                          \"Function clause takes one binding form; use a tuple [?a ?b] for multi-return\"\n                          {:clause clause})))\n                    (bind-fn-result binding out ret clause)))]))))))\n\n\n(defn- emit-fn\n  [st ctx clause binding acc k]\n  (let [st (spend st ctx :candidate)]\n    (if (exec/terminal? st)\n      [st acc]\n      (let [[st outs] (fn-clause-outputs st ctx clause binding)]\n        (cond\n          (exec/terminal? st) [st acc]\n          ;; incremental producer: charge each ATTEMPTED binding, honor\n          ;; terminal / reduced outcomes before the next element\n          (map? outs)\n          (each-st st acc (::items outs)\n                   (fn [st acc item]\n                     (let [st (spend st ctx :candidate)]\n                       (if (exec/terminal? st)\n                         [st acc]\n                         (if-let [b ((::attempt outs) item)]\n                           (k st acc b)\n                           [st acc])))))\n          :else (each-st st acc outs k))))))\n\n\n(defn- emit-pattern\n  [st ctx clause binding acc k]\n  (let [[db-sym pattern] (clause-db-and-pattern clause)\n        fact-index (resolve-fact-index binding db-sym)\n        parsed (parse-tuple-pattern pattern)]\n    (if (and fact-index (nil? (:rest parsed)) (= 3 (count (:fixed parsed))))\n      (let [[e a v] (mapv #(resolve-binding binding %) (:fixed parsed))\n            [st ds] (datoms-st st ctx fact-index e a v :scan-advance)]\n        (if (exec/terminal? st)\n          [st acc]\n          (each-st st acc ds\n                   (fn [st acc d]\n`pending` and `unverified`: whether the Client accepts the list form, the\nvector form, or both is for the oracle to adjudicate. The corpus has no\nadapter-executed status; this note is the minimal encoding.\n\n## E12 — Phase 4a bounded-execution surface (`:timeout`, `max-steps`) is DaoSpace-specific\n\nPhase 4a implements `:timeout` and the extension\n`:dao.space.query.datomic/max-steps` in the adapter, so the earlier \"refused\nuntil the execution-bounds machinery lands\" reasons are superseded. The\nsurface is a documented difference, not Client parity:\n\n- `:timeout` is a cooperative deadline in milliseconds (a positive integer),\n  minted at entry; expiry is observed time >= deadline; exhaustion raises\n  `:timeout` or `:step-budget-exhausted` (`:cognitect.anomalies/interrupted`)\n  and never returns a partial relation. Client timeout behavior is\n  unmeasured.\n- A call supplying either bound is admitted only over explicit materialized\n  relation/fact-relation sources and views over them. Opened published\n  indexes, deferred rows and unrecognized sources are refused\n  `:unsupported` / `:bounded-source-unqualified` before any read. Checked\n  published-index traversal is Phase 4b.\n- Pinned in `dao.space.query.datomic-execution-test` and\n  `dao.space.query.execution-test`, not executed by this harness. Case\n  `bounds.published-source-refused` records the admission rule as `pending`\n  (there is no Client counterpart to measure). Full timeout oracle cases\n  remain Phase 5.\n\n## E13 — Core accepts a relation slot that is neither tuples nor a delay of tuples\n\n`realize-st` (and the earlier `realize-db-value!`) checks only that a source\nis a map carrying one of the three source keys. A value such as\n`{:dao.space.query/relation <delay of a non-sequence>}` yields an empty\nresult instead of a refusal. The condition predates Phase 4a and bounded\ncalls are unaffected (admission requires a vector). It is routed to the\nPhase 2 core slice; no code changed here and no corpus case pins it.\n\n## E14 — Syntax depth is bounded by a documented constant\n\nRecursive validation, translation and pull parsing walk query syntax by host\nrecursion. The adapter therefore refuses native query syntax (the query map or\nvector, its pull patterns, and rules passed at `%`) that nests collections\ndeeper than `dao.space.query.datomic/max-syntax-depth` (64), `:unsupported` /\n`:syntax-depth-limit`, measured iteratively before anything recurses. String\nqueries are bounded by the same constant in the scanner. Source descriptor\nchains are not syntax: they are walked iteratively with one accounted unit per\nhop (admission and realization), so any depth is a structured exhaustion or\nrefusal. Not covered, and why that is acceptable here: (a) data inside `:args`\nis opaque and not measured (content hashing of user data recurses with the\ndata and is the caller's input); (b) callers of core `dao.space.query/q` that\nbuild deeply nested syntax natively are not depth-checked (the host stack\napplies; the core makes no claim); (c) public `dao.space.query/rows` still\nrecurses over view chains, outside the query kernel.\n\n## Not represented by the corpus\n\n- JVM `Float` (32-bit), instants, UUIDs, byte arrays, URIs: no tag exists in\n  the corpus DSL; add one only with a matching oracle loader.\n- Non-ASCII text: the corpus file is pure ASCII so its text is its bytes.\n- Transaction ids and history patterns (four/five positions): outside the\n  initial accepted domain (`pattern.five-position-history-refused`).\n- Datomic schema: DaoSpace is schema-free and the corpus records none. The\n  oracle runner derives value type and cardinality from the fixture's\n  attribute usage and takes reference attributes from its `:ref-attrs`\n  configuration. That configuration, and the heuristic mapping of allocated\n  entity ids back to logical ids, are unreviewed until a backend is selected.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '90,142p' src/cljc/dao/space/query/datomic.cljc; sed -n '580,654p' src/cljc/dao/space/query/datomic.cljc; sed -n '397,474p' src/cljc/dao/space/query.cljc; sed -n '592,625p' src/cljc/dao/space/query.cljc; sed -n '1896,1924p' src/cljc/dao/space/query.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '90,142p' src/cljc/dao/space/query/datomic.cljc; sed -n '580,654p' src/cljc/dao/space/query/datomic.cljc; sed -n '397,474p' src/cljc/dao/space/query.cljc; sed -n '592,625p' src/cljc/dao/space/query.cljc; sed -n '1896,1924p' src/cljc/dao/space/query.cljc\"","aggregated_output":"                          {::error kind})\n                   cause))))\n\n\n(def max-syntax-depth\n  \"The documented bound on collection nesting in a query's SYNTAX (the\n   query, its pull patterns, and rules passed at `%`): string queries are\n   checked by the scanner, native map/vector queries by `syntax-extent`.\n   Recursive validation, translation and pull parsing walk syntax by host\n   recursion, so the profile declares this limit instead of relying on the\n   host stack. Source descriptor chains are NOT syntax: they are traversed\n   iteratively and accounted. Data in `:args` is opaque and not measured.\"\n  64)\n\n\n;; ==========================================================================\n;; Syntax extent (iterative, bounded)\n;; ==========================================================================\n\n(defn- syntax-extent\n  \"[nodes depth-exceeded?] of a native syntax form, measured with an explicit\n   stack (no host recursion). Stops as soon as the nesting exceeds\n   `max-syntax-depth`.\"\n  [form]\n  (loop [stack [[form 1]]\n         nodes 0]\n    (if (empty? stack)\n      [nodes false]\n      (let [[x d] (peek stack)\n            stack (pop stack)]\n        (if (coll? x)\n          (if (> d max-syntax-depth)\n            [nodes true]\n            (recur (into stack\n                         (map (fn [c] [c (inc d)]))\n                         (if (map? x) (mapcat identity x) x))\n                   (inc nodes)))\n          (recur stack (inc nodes)))))))\n\n\n(defn- check-syntax-extent!\n  \"Refuse over-deep native syntax before anything recurses over it; returns\n   the node count.\"\n  [form]\n  (let [[nodes exceeded?] (syntax-extent form)]\n    (when exceeded?\n      (fail :unsupported \"query syntax nests deeper than the supported profile\"\n            {:reason :syntax-depth-limit}))\n    nodes))\n\n\n;; ==========================================================================\n;; Safe EDN string reading\n(defn- source-admissible?\n  \"Phase 4a admission: a source qualifies for bounded execution only when\n   its descriptor chain is an explicit materialized relation/fact-relation,\n   or a view over one. Descriptors are inspected, never forced: a deferred\n   (delay) relation, an opened published index and anything unrecognized are\n   not admissible, and cache residency does not change that. The chain is\n   walked iteratively and each hop is one accounted unit, so a descriptor\n   chain of any depth is a structured exhaustion or refusal, never a host\n   stack overflow. Returns [state admissible?].\"\n  [st driver v]\n  (loop [st st\n         v v]\n    (cond\n      (not (map? v)) [st false]\n      (contains? v :dao.space.query/relation)\n      [st (vector? (:dao.space.query/relation v))]\n      (contains? v :dao.space.query/view)\n      (recur (advance st driver :parse 1) (:source v))\n      :else [st false])))\n\n\n(defn- check-bounded-sources!\n  \"Fail closed, before any realization: every declared source of a bounded\n   call must be admissible, including a source the plan would not use.\n   Returns the state.\"\n  [st driver in bound]\n  (reduce (fn [st [pattern arg]]\n            (if-not (db-sym? pattern)\n              st\n              (let [[st ok?] (source-admissible? st driver arg)]\n                (when-not ok?\n                  (fail :unsupported\n                        \"bounded execution requires an explicit materialized relation source\"\n                        {:reason :bounded-source-unqualified\n                         :variable (fragment pattern)}))\n                st)))\n          st\n          (map vector in bound)))\n\n\n(defn- run\n  \"[state result] of the common kernel for one translated query.\"\n  [st driver m args bounded?]\n  (let [in (vec (or (seq (:in m)) ['$]))\n        _ (check-find (:find m))\n        where (translate-clauses (:where m))\n        bound (check-inputs in args)\n        core-query (assoc m :in in :where where)\n        st (if bounded? (check-bounded-sources! st driver in bound) st)]\n    (try\n      (apply query/q-with-state st driver core-query bound)\n      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n        (classify-core-failure e)))))\n\n\n(defn- parse-cost\n  [form]\n  (if (string? form)\n    (inc (quot (count form) 128))\n    1))\n\n\n(defn- execute\n  \"The whole invocation under one execution state: parse, translate,\n   evaluate, output. `bounded?` selects the admission rule.\"\n  [form args {:keys [offset limit st driver bounded?]}]\n  (let [st (advance st driver :parse (parse-cost form))\n        m (query-map form)\n        st (advance st driver :parse (check-syntax-extent! m))\n        [st res] (run st driver m args bounded?)\n        _ (when (exec/terminal? st) (exhausted! st))\n        rows (:dao.space.query/result res)\n        st (advance st driver :output (if (coll? rows) (count rows) 1))\n        result (query/collect res)\n        paged (paginate result (if (or (:keys m) (:syms m) (:strs m))\n(defn- fold-st\n  \"Direct-style fold of f over xs, threading the execution state and an\n   accumulator: (f st acc x) -> [st acc]. Stops at a terminal state or a\n   reduced accumulator. A loop, so stack depth does not grow with the number\n   of items. Used where f is shallow (projection, pull, input expansion).\"\n  [st acc xs f]\n  (loop [st st\n         acc acc\n         xs (seq xs)]\n    (if (or (nil? xs) (halted? st acc))\n      [st acc]\n      (let [[st acc] (f st acc (first xs))]\n        ;; never advance the source after a halt: `next` may realize an\n        ;; element the consumer has already decided it does not need\n        (if (halted? st acc) [st acc] (recur st acc (next xs)))))))\n\n\n;; ---------------------------------------------------------------------------\n;; The trampoline: explicit execution frames\n;; ---------------------------------------------------------------------------\n;; Evaluation is continuation-passing, and a continuation chain can grow with\n;; recursive rule expansion, nested evaluation and the bindings processed.\n;; Evaluator steps therefore never call each other (or their continuations)\n;; directly: a step returns a COMPUTATION, and `run-comp` is the only\n;; driver. A computation is a plain result [state acc], a bounce\n;; ({::bounce thunk}: call the thunk later) or a bind ({::m comp ::f f}: run\n;; comp, then hand its result to f). The pending fs are an explicit\n;; heap-allocated frame list, so host stack depth is constant however deep\n;; the evaluation nests, and a generous work allowance ends in structured\n;; exhaustion instead of a host stack overflow.\n\n(defn- bounce\n  \"Suspend thunk: it runs from the driver, after the stack has unwound.\"\n  [thunk]\n  {::bounce thunk})\n\n\n(defn- bind\n  \"The computation that runs m, then (f result).\"\n  [m f]\n  {::m m, ::f f})\n\n\n(defn- run-comp\n  \"The only driver: run a computation to its plain [state acc] result with a\n   constant host stack.\"\n  [c]\n  (loop [c c\n         frames ()]\n    (cond\n      (and (map? c) (contains? c ::f)) (recur (::m c) (conj frames (::f c)))\n      (and (map? c) (contains? c ::bounce)) (recur ((::bounce c)) frames)\n      (empty? frames) c\n      :else (recur ((first frames) c) (rest frames)))))\n\n\n(defn- each-st\n  \"Monadic fold of f over xs, threading the execution state and an\n   accumulator: (f st acc x) -> computation of [st acc]. Stops at a terminal\n   state or a reduced accumulator. Each item runs from the driver and the\n   rest of the fold is a frame, so the stack never grows with the number of\n   items or the nesting of what f evaluates.\"\n  [st acc xs f]\n  (let [xs (seq xs)]\n    (if (or (nil? xs) (halted? st acc))\n      [st acc]\n      (bind (bounce (fn [] (f st acc (first xs))))\n            (fn [[st acc]]\n              (if (halted? st acc)\n                [st acc]\n                (each-st st acc (next xs) f)))))))\n\n\n(def ^:private unbounded-ctx {::driver nil})\n\n\n;; =============================================================================\n;; Realize a db-value: value tag -> {::relation ::fact-index ::indexes}\n      (exec/terminal? st) [st nil]\n\n      (and (contains? v :dao.space.query/view)\n           (not (contains? v :dao.space.query/relation))\n           (not (contains? v :dao.space.query/published)))\n      (recur (spend st ctx :scan-advance) (:source v) (conj views v))\n\n      :else\n      (let [[st base] (realize-base-st st ctx v)]\n        ;; views holds the innermost first: apply back up\n        (loop [st st\n               realized base\n               views views]\n          (cond\n            (exec/terminal? st) [st nil]\n            (empty? views) [st realized]\n            :else (let [[st r] (apply-view-st st ctx (first views) realized)]\n                    (recur st r (rest views)))))))))\n\n\n;; =============================================================================\n;; match: Linda-style positional template (an ergonomic materializer)\n;; =============================================================================\n\n(def ^:private FREE ::free)\n\n\n(defn- wildcard?\n  [x]\n  (or (= x '_) (nil? x) (= x FREE)))\n\n\n(defn- query-var-symbol?\n  [x]\n(defn- build-init-bindings-st\n  \"The initial bindings of :in, a checked cross product: each produced\n   binding is one candidate.\"\n  [st ctx in-patterns inputs dbs]\n  (reduce\n    (fn [[st acc] [pat val]]\n      (if (exec/terminal? st)\n        (reduced [st nil])\n        (let [expansion (expand-in-binding pat val dbs)\n              [st out] (fold-st st []\n                                (for [b1 acc b2 expansion] [b1 b2])\n                                (fn [st out [b1 b2]]\n                                  (let [st (spend st ctx :candidate)]\n                                    (if (exec/terminal? st)\n                                      [st out]\n                                      [st (conj out (merge-bindings b1 b2))]))))]\n          (if (exec/terminal? st) (reduced [st nil]) [st out]))))\n    [st [{}]]\n    (map vector in-patterns inputs)))\n\n\n(defn- normalize-query\n  [query]\n  (if (map? query)\n    query\n    (let [v (vec query)]\n      (loop [i 0\n             result {}\n             cur-key nil\n","exit_code":0,"status":"completed"}}
