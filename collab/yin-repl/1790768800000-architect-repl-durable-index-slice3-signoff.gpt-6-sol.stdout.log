{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/index.cljc | sed -n '110,340p'; nl -ba src/cljc/dao/space/transactor.cljc | sed -n '1,190p'; rg -n \\\"defn.*memory-log|defn.*read-datoms|defn.*walk-index-datoms|:view :history|retract|metadata\\\" src/cljc/dao/space src/cljc/yin/repl/index.cljc test/yin/repl/index_test.cljc | head -110\"","aggregated_output":"   110\t        untimed (fn [e a v m] [e a v nil m])]\n   111\t    (when-let [stray (some (fn [[e]] (when (neg? e) e)) facts)]\n   112\t      (throw (ex-info \"projected node escaped local id assignment\"\n   113\t                      {:e stray, :root root})))\n   114\t    {:tx-data (-> [(untimed meta-e :db/op :db/assert datom/default-op)\n   115\t                   (untimed meta-e :yin.repl/session session-token\n   116\t                            datom/default-op)\n   117\t                   (untimed meta-e :yin.repl/root root datom/default-op)\n   118\t                   (untimed meta-e :yin.repl/round round datom/default-op)]\n   119\t                  (into (map (fn [[e a v _t m]] (untimed e a v m))) facts)\n   120\t                  (into (map (fn [[e addr]]\n   121\t                               (untimed e :yin/address addr meta-e)))\n   122\t                        (sort-by key addresses))),\n   123\t     :next-e next-e',\n   124\t     :meta-e meta-e,\n   125\t     :root root}))\n   126\t\n   127\t\n   128\t;; =============================================================================\n   129\t;; The indexer value\n   130\t;; =============================================================================\n   131\t\n   132\t(defn- memory-log\n   133\t  []\n   134\t  (:dao.stream/handle\n   135\t    (memory-log/create! {:dao.stream/type memory-log/transport-type})))\n   136\t\n   137\t\n   138\t(defn make-indexer\n   139\t  \"The indexer for one session: `observer`, attached to `program-out`\n   140\t   beside the evaluator's; `:local`, the complete-retention log its\n   141\t   transactions are committed to (dao.space.transactor requires memory-log\n   142\t   retention); and `content-store`, the `dao.jing` byte store publications\n   143\t   materialize into.  `session-token` is the shell's stable token, recorded\n   144\t   as provenance; `publish-opts` reach `transactor/publish!` as-is.\n   145\t\n   146\t   `after-publish` is `(fn [manifest-address])`, called after a round's\n   147\t   manifest is read back from the store and before the round is reported\n   148\t   published: the durable store's HEAD write, which is what makes the\n   149\t   round durably published (docs/design/yin.repl.dao.space-index.md).\n   150\t   Nil — the memory store — publishes exactly as before.\n   151\t\n   152\t   Between rounds that is all it holds.  A round that has code to commit\n   153\t   opens its `:publication` — a transactor over `:local` whose intake pool\n   154\t   is one fresh complete-retention intake — and drops it when the round\n   155\t   ends, so no earlier publication's payloads stay reachable from the\n   156\t   indexer (see `step`).\"\n   157\t  [{:keys [observer session-token content-store publish-opts after-publish]}]\n   158\t  {:observer observer\n   159\t   :local (memory-log)\n   160\t   :content-store content-store\n   161\t   :session-token session-token\n   162\t   :publish-opts publish-opts\n   163\t   :after-publish after-publish\n   164\t   :next-e datom/first-user-id\n   165\t   :transactions 0\n   166\t   :published 0\n   167\t   :published-payloads 0\n   168\t   :manifest-address nil\n   169\t   :lost? false\n   170\t   :failure nil})\n   171\t\n   172\t\n   173\t(defn- next-entity-id\n   174\t  \"One greater than the greatest entity or metadata-entity id `datoms`\n   175\t   use, never below `datom/first-user-id`.\"\n   176\t  [datoms]\n   177\t  (reduce (fn [next-e [e _a _v _t m]]\n   178\t            (cond-> next-e\n   179\t              (integer? e) (max (inc e))\n   180\t              (integer? m) (max (inc m))))\n   181\t          datom/first-user-id\n   182\t          datoms))\n   183\t\n   184\t\n   185\t(defn rehydrate\n   186\t  \"Seed a fresh indexer from a recovered durable snapshot, `{:manifest\n   187\t   address :datoms [...]}` (yin.repl.store's `:recovery`), before any\n   188\t   evaluation is admitted.  Its log becomes a fresh complete-retention\n   189\t   memory log holding the recovered datoms as transaction records, one\n   190\t   per original `t` in ascending order, each datom and its `t` preserved,\n   191\t   so the round's transactor keeps deriving the next `t` from it.  Entity\n   192\t   allocation resumes one past the greatest restored entity or metadata\n   193\t   id.  The manifest is the published one, covering every restored\n   194\t   transaction, so `q` answers from it before anything new is evaluated.\n   195\t   Restored facts keep their original session tokens and round metadata:\n   196\t   they are the datoms as committed.  A recovery without a manifest is an\n   197\t   empty index and leaves the indexer as it is.\"\n   198\t  [indexer {:keys [manifest datoms]}]\n   199\t  (if (nil? manifest)\n   200\t    indexer\n   201\t    (let [log (memory-log)\n   202\t          by-t (group-by index/datom-t datoms)\n   203\t          ts (sort (keys by-t))]\n   204\t      (doseq [t ts]\n   205\t        (let [answer (stream/append! log {:dao.space/transaction\n   206\t                                          {:t t, :datoms (vec (get by-t t))}})]\n   207\t          (when-not (= :dao.stream/ok (:dao.stream/outcome answer))\n   208\t            (throw (ex-info \"the recovered snapshot could not be rehydrated\"\n   209\t                            {:t t, :outcome answer})))))\n   210\t      (assoc indexer\n   211\t             :local log\n   212\t             :next-e (next-entity-id datoms)\n   213\t             :transactions (count ts)\n   214\t             :published (count ts)\n   215\t             :manifest-address manifest))))\n   216\t\n   217\t\n   218\t(defn carry-over\n   219\t  \"A rebuilt session's fresh `indexer`, continuing `previous`'s index: its\n   220\t   transaction log, entity allocation, counts, and published manifest.\n   221\t   `(reset)` and VM selection over a durable store use it, so a rebuild\n   222\t   never resets `t` or entity allocation and `q` keeps answering the\n   223\t   published index; the observer is the new session's, and a lost or\n   224\t   failed indexer is recovered by the rebuild as it is today.\"\n   225\t  [indexer previous]\n   226\t  (merge indexer\n   227\t         (select-keys previous [:local :next-e :transactions :published\n   228\t                                :published-payloads :manifest-address])))\n   229\t\n   230\t\n   231\t(defn- open-publication\n   232\t  \"The round's transactor and the `dao.jing` pool observer over its intake.\n   233\t   `transactor/create!` derives the next `t` from `:local`'s retained\n   234\t   history, so transaction time continues across rounds.  The intake is\n   235\t   complete-retention: `publish-index!` appends every node blob before the\n   236\t   manifest and the round drains only after it returns, so an evicting\n   237\t   intake would lose the head of any publication larger than its capacity\n   238\t   and that publication could never complete.\"\n   239\t  [ix]\n   240\t  (if (:publication ix)\n   241\t    ix\n   242\t    (let [intake (memory-log)]\n   243\t      (assoc ix\n   244\t             :publication\n   245\t             {:transactor (transactor/create! {:local-stream (:local ix)\n   246\t                                               :intake-pool [intake]\n   247\t                                               :name \"yin.repl.index\"})\n   248\t              :pool (jing/observer-state\n   249\t                      [{:stream intake\n   250\t                        :cursor (:dao.stream/cursor\n   251\t                                  (stream/cursor intake\n   252\t                                                 :dao.stream/oldest))}])}))))\n   253\t\n   254\t\n   255\t(defn- commit\n   256\t  \"Commit one packet as one transaction.  A packet that could not be\n   257\t   projected or committed is consumed and recorded as the failure, never\n   258\t   counted.\"\n   259\t  [ix packet round]\n   260\t  (try\n   261\t    (let [{:keys [tx-data next-e root]}\n   262\t          (packet->tx-data packet\n   263\t                           (:next-e ix)\n   264\t                           {:session-token (:session-token ix), :round round})\n   265\t          answer (transactor/transact! (get-in ix [:publication :transactor])\n   266\t                                       tx-data)]\n   267\t      (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   268\t        [(-> ix\n   269\t             (assoc :next-e next-e)\n   270\t             (update :transactions inc))\n   271\t         true]\n   272\t        [(assoc ix\n   273\t                :failure {:round round\n   274\t                          :root root\n   275\t                          :stage :transact\n   276\t                          :outcome (:dao.stream/outcome answer)})\n   277\t         false]))\n   278\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   279\t      [(assoc ix\n   280\t              :failure {:round round\n   281\t                        :stage :project\n   282\t                        :message (ex-message e)})\n   283\t       false])))\n   284\t\n   285\t\n   286\t(defn- materialize\n   287\t  \"Drain the intake into the store until it blocks.  Answers how many\n   288\t   payloads it materialized and, when the drain met a gap or a defect, what\n   289\t   it met.  The pool is not kept: its intake is dropped with the round.\"\n   290\t  [content-store pool]\n   291\t  (loop [pool pool\n   292\t         n 0]\n   293\t    (let [{:keys [signal], :as r} (jing/observe-step! content-store pool)]\n   294\t      (case signal\n   295\t        :dao.stream/ok (recur (:state r) (inc n))\n   296\t        :dao.stream/blocked [n nil]\n   297\t        [n signal]))))\n   298\t\n   299\t\n   300\t(defn- publish\n   301\t  \"Publish the covered indexes over every committed transaction through\n   302\t   the round's transactor, drain its intake into the store, and read the\n   303\t   manifest back from it.  Only a publication whose manifest the store\n   304\t   answers becomes the reported one, covering `:published` transactions;\n   305\t   in durable mode the HEAD pointer moves — `after-publish` — only after\n   306\t   that read-back, so a HEAD never names a manifest the store cannot\n   307\t   answer, and a HEAD that cannot be written leaves the round reported\n   308\t   unpublished.\"\n   309\t  [ix round]\n   310\t  (try\n   311\t    (let [{:keys [transactor pool]} (:publication ix)\n   312\t          {:keys [manifest-address]} (transactor/publish! transactor\n   313\t                                                          (:publish-opts ix))\n   314\t          [n defect] (materialize (:content-store ix) pool)]\n   315\t      (if defect\n   316\t        (assoc ix :failure {:round round :stage :materialize :outcome defect})\n   317\t        (do (index/read-manifest (:content-store ix) manifest-address)\n   318\t            (when-some [write-head! (:after-publish ix)]\n   319\t              (write-head! manifest-address))\n   320\t            (assoc ix\n   321\t                   :manifest-address manifest-address\n   322\t                   :published (:transactions ix)\n   323\t                   :published-payloads n))))\n   324\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   325\t      (assoc ix\n   326\t             :failure {:round round :stage :publish :message (ex-message e)}))))\n   327\t\n   328\t\n   329\t(defn- consume\n   330\t  \"Advance the observer past every packet still on the medium, handing each\n   331\t   to `f` with the indexer; a gap marks the indexer lost, after which no\n   332\t   packet reaches `f`.\"\n   333\t  [indexer f]\n   334\t  (loop [ix indexer]\n   335\t    (let [{:keys [status batch] observer' :observer}\n   336\t          (observer/observe-next (:observer ix))\n   337\t          ix (assoc ix :observer observer')]\n   338\t      (case status\n   339\t        :ok (recur (if (:lost? ix) ix (f ix batch)))\n   340\t        :gap (recur (assoc ix :lost? true))\n     1\t(ns dao.space.transactor\n     2\t  \"The agent-side transactor: a plain value with explicit named operations\n     3\t   over an explicit local dao.stream handle plus an explicit intake pool\n     4\t   of dao.stream writers (docs/design/dao.jing.md, Publication from an\n     5\t   agent; docs/design/dao.space.transactor.md).\n     6\t\n     7\t   A transactor is not a stream in v2 — it is an interpreter over one\n     8\t   (dao.stream.md, Composition): append!/transact! allocate transaction time\n     9\t   and write transaction records through the local stream's writer surface,\n    10\t   and reads go through the caller's own local handle, which the transactor\n    11\t   never owns.\n    12\t\n    13\t   Spec (create!):\n    14\t\n    15\t     {:local-stream s   ; must satisfy stream/reader? and stream/writer?;\n    16\t                        ; supplied, never created, registered, or closed\n    17\t      :intake-pool [p]  ; non-empty; every member satisfies stream/writer?;\n    18\t                        ; supplied, never created, registered, or closed\n    19\t      :name n}          ; optional, diagnostic only\n    20\t\n    21\t   create! validates surfaces, never retention: stream/reader? and\n    22\t   stream/writer? do not establish the complete retention the history scan\n    23\t   requires. The host composition supplies a handle created by\n    24\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n    25\t   host-assembly defect (detectable, deliberately not checked — T18,\n    26\t   docs/design/dao.space.transactor.md).\n    27\t\n    28\t   The transactor owns transaction time. Every append! or transact! writes\n    29\t   exactly ONE atomic transaction record to the local stream\n    30\t\n    31\t     {:dao.space/transaction {:t <nonnegative-integer> :datoms [...]}}\n    32\t\n    33\t   through exactly one local append, so no reader can ever observe a torn\n    34\t   transaction. t is allocated from a per-value watermark: on create! the\n    35\t   retained history is read from its origin (index/snapshot-datoms) and the\n    36\t   next t is derived as 0 for an empty history or 1 + the maximum integer\n    37\t   datom t otherwise. A malformed history throws. The scan is the causality\n    38\t   boundary; a caller-supplied next-t is never accepted.\n    39\t\n    40\t   Operational outcomes are data; argument defects keep throwing. The\n    41\t   watermark advances if and only if the local append answered\n    42\t   :dao.stream/ok, so retrying the identical call re-attempts the identical\n    43\t   t. publish! builds the covered indexes over the local stream and\n    44\t   enqueues them into the intake pool (dao.space.index/publish-index!).\n    45\t   Publication is explicit and acknowledges enqueuing only, never observer\n    46\t   materialization.\n    47\t\n    48\t   Closing is per value: it rejects further appends/transacts with\n    49\t   {:dao.stream/outcome :dao.stream/closed} but neither closes nor erases\n    50\t   the local stream or the intake pool.\"\n    51\t  (:require [dao.datom :as datom]\n    52\t            [dao.space.index :as index]\n    53\t            [dao.stream :as stream]))\n    54\t\n    55\t\n    56\t(defn- entity->datoms\n    57\t  \"One datom per k/v pair, all sharing transaction time `t`. `:db/id` is\n    58\t   required: a durable log cannot mint per-batch tempids without colliding\n    59\t   across appends. Attribute order within one entity's own datoms is\n    60\t   whatever the host's map iteration yields — unspecified across platforms.\"\n    61\t  [m t]\n    62\t  (when-not (contains? m :db/id)\n    63\t    (throw (ex-info \"entity map requires :db/id\" {:entity m})))\n    64\t  (let [e (:db/id m)]\n    65\t    (mapv (fn [[a v]]\n    66\t            (let [d [e a v t datom/default-op]]\n    67\t              (when-not (datom/local-datom? d)\n    68\t                (throw (ex-info \"invalid persistent local datom\"\n    69\t                                {:datom d, :entity m})))\n    70\t              d))\n    71\t          (remove (fn [[a _v]] (= a :db/id)) m))))\n    72\t\n    73\t\n    74\t(defn- pad-datom\n    75\t  \"Pad [e a v] / [e a v t m] to the canonical 5-tuple. The transactor owns\n    76\t   transaction time: a non-nil explicit t is rejected, a nil t is stamped\n    77\t   with the allocated `t`. A nil m takes the default assertion op; an\n    78\t   explicit m (0, a retraction) is preserved.\"\n    79\t  [d t]\n    80\t  (let [[e a v dt dm] d]\n    81\t    (when-not (nil? dt)\n    82\t      (throw\n    83\t        (ex-info\n    84\t          \"the transactor owns transaction time: explicit datom t is rejected\"\n    85\t          {:datom d})))\n    86\t    (let [padded [e a v t (if (nil? dm) datom/default-op dm)]]\n    87\t      (when-not (datom/local-datom? padded)\n    88\t        (throw (ex-info \"invalid persistent local datom\"\n    89\t                        {:datom padded, :input d})))\n    90\t      padded)))\n    91\t\n    92\t\n    93\t(defn- val->datoms\n    94\t  [val t]\n    95\t  (cond\n    96\t    (map? val) (entity->datoms val t)\n    97\t    (and (vector? val) (<= 3 (count val) 5)) [(pad-datom val t)]\n    98\t    :else\n    99\t    (throw\n   100\t      (ex-info\n   101\t        \"a value must be an entity map or datom vector [e a v] / [e a v nil m]\"\n   102\t        {:val val}))))\n   103\t\n   104\t\n   105\t#_{:clj-kondo/ignore [:unused-binding]}\n   106\t\n   107\t\n   108\t(defn- with-write-lock\n   109\t  \"Serialize timestamp allocation and append on hosts with shared-memory\n   110\t   threads. ClojureScript and ClojureDart calls are synchronous within one\n   111\t   isolate, so the direct call has the same single-writer semantics.\"\n   112\t  [lock f]\n   113\t  #?(:clj (locking lock (f))\n   114\t     :default (f)))\n   115\t\n   116\t\n   117\t(defn- derive-next-t\n   118\t  \"Derive the next transaction time from a flattened retained history: 0 for\n   119\t   an empty history, else 1 + the maximum datom t. A datom t that is not a\n   120\t   non-negative integer is a malformed history and throws — this scan is the\n   121\t   causality boundary of the value.\"\n   122\t  [datoms]\n   123\t  (if (empty? datoms)\n   124\t    0\n   125\t    (let [ts (mapv index/datom-t datoms)]\n   126\t      (when-not (every? #(and (integer? %) (<= 0 %)) ts)\n   127\t        (throw\n   128\t          (ex-info\n   129\t            \"malformed retained history: datom t must be a non-negative integer\"\n   130\t            {:history datoms})))\n   131\t      (inc (reduce max ts)))))\n   132\t\n   133\t\n   134\t(defn- append-packet!\n   135\t  \"Append one atomic transaction record to the local stream. The answer is\n   136\t   validated with the contract's own validator before it is interpreted:\n   137\t   :dao.stream/ok advances the watermark and returns the v2 receipt; any\n   138\t   other conforming outcome is returned as data with the watermark\n   139\t   unchanged, so the same t is still pending and retrying the identical\n   140\t   call re-attempts it; a non-outcome answer is folded to\n   141\t   :dao.stream/transport-error with the raw answer retained under\n   142\t   :dao.stream/answer.\"\n   143\t  [local-stream next-t t datoms]\n   144\t  (let [record {:dao.space/transaction {:t t, :datoms datoms}}\n   145\t        answer (stream/append! local-stream record)]\n   146\t    (if-not (stream/valid-outcome? :append! answer)\n   147\t      {:dao.stream/outcome :dao.stream/transport-error\n   148\t       :dao.stream/answer answer}\n   149\t      (do (when (= :dao.stream/ok (:dao.stream/outcome answer))\n   150\t            (swap! next-t inc))\n   151\t          (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   152\t            {:dao.stream/outcome :dao.stream/ok\n   153\t             :dao.space/t t\n   154\t             :dao.space/datoms datoms}\n   155\t            answer)))))\n   156\t\n   157\t\n   158\t(defn create!\n   159\t  \"Create a transactor value from a spec — the value, or a throw: the\n   160\t   failure modes are a malformed spec and a malformed retained history,\n   161\t   both of which a caller can only abort on.\n   162\t\n   163\t   Validates surfaces, never retention (D2/T18): stream/reader? and\n   164\t   stream/writer? check the dao.stream reader and writer surfaces, and\n   165\t   neither establishes the complete-retention transport the history scan\n   166\t   requires. The host composition supplies a handle created by\n   167\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n   168\t   host-assembly defect — detectable, deliberately not checked, because a\n   169\t   type check would couple dao.space to memory-log by name and reject a\n   170\t   future correct complete-retention transport.\"\n   171\t  [spec]\n   172\t  (when-not (map? spec)\n   173\t    (throw\n   174\t      (ex-info\n   175\t        \"transactor spec must be a map\"\n   176\t        {:spec spec})))\n   177\t  (let [{:keys [local-stream intake-pool name]} spec]\n   178\t    (when (contains? spec :next-t)\n   179\t      (throw\n   180\t        (ex-info\n   181\t          \"the transactor derives transaction time from retained history; :next-t is not accepted\"\n   182\t          {:spec spec})))\n   183\t    (when-not (and (stream/reader? local-stream)\n   184\t                   (stream/writer? local-stream))\n   185\t      (throw\n   186\t        (ex-info\n   187\t          \"transactor spec requires a :local-stream satisfying the dao.stream reader and writer surfaces\"\n   188\t          {:spec spec})))\n   189\t    (when-not (and (coll? intake-pool) (seq intake-pool))\n   190\t      (throw\nsrc/cljc/yin/repl/index.cljc:30:   to its row address.  `m` is a local metadata entity, one per program,\nsrc/cljc/yin/repl/index.cljc:97:   Answers `{:tx-data [...] :next-e n :meta-e m :root root}`: the metadata\nsrc/cljc/yin/repl/index.cljc:132:(defn- memory-log\nsrc/cljc/yin/repl/index.cljc:174:  \"One greater than the greatest entity or metadata-entity id `datoms`\nsrc/cljc/yin/repl/index.cljc:192:   allocation resumes one past the greatest restored entity or metadata\nsrc/cljc/yin/repl/index.cljc:195:   Restored facts keep their original session tokens and round metadata:\ntest/yin/repl/index_test.cljc:100:    (testing \"m is a local metadata entity carrying the session provenance\"\nsrc/cljc/dao/space/schema.cljc:134:        ;; retractions removed.\nsrc/cljc/dao/space/schema.cljc:136:        ;; current-state-seq has already removed the reserved retraction\nsrc/cljc/dao/space/schema.cljc:138:        ;; reified metadata entity rather than the reserved assert marker.\nsrc/cljc/dao/space/schema.cljc:166:        ;; m is a metadata entity reference, never an ordering coordinate.\nsrc/cljc/dao/space/schema.cljc:383:(defn- emit-retract\nsrc/cljc/dao/space/schema.cljc:384:  \"Emit a retraction datom [e a v nil 0] and update state.\"\nsrc/cljc/dao/space/schema.cljc:403:                          [e a v nil (:db/retract datom/reserved)])\nsrc/cljc/dao/space/schema.cljc:521:              ;; Desired-state repair: retract every other live value before\nsrc/cljc/dao/space/schema.cljc:527:                        (let [after (emit-retract e attr v-old ds s)]\nsrc/cljc/dao/space/schema.cljc:578:   property names or the map/op syntax :db/id, :db/add, :db/retract).\"\nsrc/cljc/dao/space/schema.cljc:583:       (not (#{:db/id :db/add :db/retract} a))))\nsrc/cljc/dao/space/schema.cljc:703:      (when (and (not= a :db/ident) (not (#{:db/id :db/add :db/retract} a)))\nsrc/cljc/dao/space/schema.cljc:731:                                 \" differs. Use retract first or map form.\")\nsrc/cljc/dao/space/schema.cljc:739:         (= :db/retract (first item))\nsrc/cljc/dao/space/schema.cljc:748:      ;; Both-modes: axiom protection for retractions\nsrc/cljc/dao/space/schema.cljc:752:            (throw (ex-info (str \"axiom protection: cannot retract property \"\nsrc/cljc/dao/space/schema.cljc:757:      (let [after (emit-retract e a v (transient []) state)]\nsrc/cljc/dao/space/schema.cljc:762:         (= :db/retract (first item))\nsrc/cljc/dao/space/schema.cljc:771:      ;; Both-modes: axiom protection for retractions\nsrc/cljc/dao/space/schema.cljc:775:            (throw (ex-info (str \"axiom protection: cannot retract property \"\nsrc/cljc/dao/space/schema.cljc:784:                (let [after (emit-retract e a v ds s)]\nsrc/cljc/dao/space/schema.cljc:925:  \"Reject item-order ambiguity between assertion and retraction for one EAV.\nsrc/cljc/dao/space/transactor.cljc:78:   explicit m (0, a retraction) is preserved.\"\nsrc/cljc/dao/space/query.cljc:81:   1.0M is never superseded or retracted by one about 1.00M, nor 0.0 by\nsrc/cljc/dao/space/query.cljc:84:   conflicting transaction history and are rejected (metadata is not an\nsrc/cljc/dao/space/query.cljc:107:       (remove datom/retracted?)\nsrc/cljc/dao/space/query.cljc:211:   the greatest t per [e a v], removes retractions, and rejects conflicting\nsrc/cljc/dao/space/transact.cljc:4:   generating cardinality-one retractions using dao.space.query.\"\nsrc/cljc/dao/space/transact.cljc:27:    (let [op-kw (if (= m (:db/retract datom/reserved)) :db/retract :db/add)\nsrc/cljc/dao/space/transact.cljc:99:                             (when (and (= op :db/retract)\nsrc/cljc/dao/space/transact.cljc:117:  \"Expand inline metadata maps into additional datoms.\"\nsrc/cljc/dao/space/transact.cljc:269:        ;; Cardinality-one retractions and unique constraints\nsrc/cljc/dao/space/transact.cljc:294:                                       (when (and (= op :db/retract)\nsrc/cljc/dao/space/transact.cljc:314:                                    (when (and (= op :db/retract)\nsrc/cljc/dao/space/transact.cljc:321:        ;; Group added eavs to find implicit retractions\nsrc/cljc/dao/space/transact.cljc:341:                    ;; explicitly retracts the existing one, we should\nsrc/cljc/dao/space/transact.cljc:343:                    ;; version, or we can check retracts.\nsrc/cljc/dao/space/transact.cljc:345:                      (let [retracting? (some (fn [op]\nsrc/cljc/dao/space/transact.cljc:346:                                                (and (= (:op op) :db/retract)\nsrc/cljc/dao/space/transact.cljc:351:                        (when-not retracting?\nsrc/cljc/dao/space/transact.cljc:356:        ;; Implicit card-one retractions\nsrc/cljc/dao/space/transact.cljc:357:        retractions\nsrc/cljc/dao/space/transact.cljc:360:            (fn [[seen retractions] {:keys [op e a]}]\nsrc/cljc/dao/space/transact.cljc:364:                    [seen retractions]\nsrc/cljc/dao/space/transact.cljc:368:                          new-retractions (map (fn [d]\nsrc/cljc/dao/space/transact.cljc:370:                                                  (:db/retract\nsrc/cljc/dao/space/transact.cljc:373:                      [(conj seen key) (into retractions new-retractions)])))\nsrc/cljc/dao/space/transact.cljc:374:                [seen retractions]))\nsrc/cljc/dao/space/transact.cljc:378:        all-datoms (vec (concat retractions ops-datoms extra-datoms))]\nsrc/cljc/dao/space/index.cljc:268:(defn walk-index-datoms\nsrc/cljc/dao/space/index.cljc:332:(defn read-datoms\n","exit_code":0,"status":"completed"}}
