ly drop\n   when two hosts split the registry between them.\"\n  (or (some->> (str/split (or (System/getenv \"NIGHTLY_SUBSYSTEMS\") \"\") #\",\")\n               (map str/trim)\n               (remove str/blank?)\n               seq)\n      all-subs))\n\n\n(def run-uncovered?\n  \"The uncovered residual shard runs only on the designated host\n   (NIGHTLY_UNCOVERED=1), so the residual is executed exactly once across a\n   two-host split.\"\n  (not= \"1\" (System/getenv \"NIGHTLY_SKIP_UNCOVERED\")))\n\n\n(def ^:private child-path\n  \"PATH for every child process: mise shims first (npm/node/flutter/bb/clj all\n   resolve through mise regardless of the caller's ambient PATH), then the\n   inherited PATH, then the system dirs for env/bash.\"\n  (str (System/getProperty \"user.home\") \"/.local/share/mise/shims\"\n       \":/usr/local/bin:/usr/bin:/bin:\"\n       (System/getenv \"PATH\")))\n\n\n(defn- psh\n  \"p/shell with the mise-shims PATH forced into the child environment,\n   merged over any caller-supplied :env.\"\n  [opts & cmd]\n  (apply p/shell (update opts :extra-env #(merge {\"PATH\" child-path} %)) cmd))\n\n\n(defn ns->test-ns\n  \"test/yin/vm/foo_test.cljc -> yin.vm.foo-test (the namespace name).\"\n  [path]\n  (-> path\n      (str/replace #\"^test/\" \"\")\n      (str/replace #\"\\.clj[cs]$\" \"\")\n      (str/replace \"/\" \".\")\n      (str/replace \"_\" \"-\")))\n\n\n(defn cljs-namespaces\n  \"The cljs test namespaces `bb test:sub:list <s>` reports for subsystem s.\"\n  [clone s]\n  (let [{:keys [out]} (psh {:dir clone :out :string :continue true}\n                           \"bb\" \"test:sub:list\" s)\n        section (->> (str/split-lines out)\n                     (drop-while #(not (str/starts-with? % \"cljs:\")))\n                     (rest)\n                     (take-while #(re-matches #\"^\\s+\\S.*$\" %))\n                     (map str/trim)\n                     (remove str/blank?))]\n    (vec section)))\n\n\n(defn -main\n  [& args]\n  (let [clone (or (first args) (System/getProperty \"user.dir\"))\n        par   (or (some->> (second args) parse-long) 8)\n        stamp (.format (java.time.format.DateTimeFormatter/ofPattern \"yyyyMMdd-HHmm\")\n                       (java.time.LocalDateTime/now))\n        out   (str clone \"/target-ci/node-shards-\" stamp)\n        rc    (atom 0)\n        summary (str out \"/summary.txt\")\n        fail! (fn [msg]\n                (reset! rc 1)\n                (println \"FAIL:\" msg)\n                (spit summary (str \"FAIL: \" msg \"\\n\") :append true))\n        log   (fn [msg] (println msg) (spit summary (str msg \"\\n\") :append true))\n        sh    (fn [out-file cmd]\n                ;; Each command owns a fresh log. File redirects need no\n                ;; caller-owned buffer; :err :out avoids two file offsets\n                ;; overwriting the same path.\n                (let [{:keys [exit]} (apply psh {:dir clone, :out (io/file out-file), :err :out,\n                                                 :continue true}\n                                            cmd)]\n                  exit))]\n    (fs/create-dirs out)\n    (fs/delete-if-exists (str clone \"/target-ci/node-shards-latest\"))\n    (fs/create-sym-link (str clone \"/target-ci/node-shards-latest\")\n                        (str \"node-shards-\" stamp))\n    (log (str \"start \" stamp \" par=\" par))\n    ;; prerequisites — fatal on failure\n    ;; npm always through mise exec: mise's npm wrapper execs `node` by bare\n    ;; name, which fails under any caller PATH that lacks the mise node bin\n    ;; (mise exec supplies it). The repo's mise.toml pins the node version.\n    (let [cmd (if (fs/which \"mise\")\n                [\"mise\" \"exec\" \"--\" \"npm\" \"ci\" \"--silent\"]\n                [\"npm\" \"ci\" \"--silent\"])\n          exit (apply sh (str out \"/npm-ci.log\") [cmd])]\n      (log (str \"npm-ci rc=\" exit))\n      (when-not (zero? exit) (fail! \"npm ci failed\")))\n    (doseq [[nm cmd] [[\"build-yin-repl-node\" [\"bb\" \"build:yin-repl-node\"]]\n                      [\"build-yin-repl-peer\" [\"bb\" \"build:yin-repl-peer\"]]\n                      [\"gen-antlr\" [\"bb\" \"gen:antlr\"]]]]\n      (let [exit (sh (str out \"/\" nm \".log\") cmd)]\n        (log (str nm \" rc=\" exit))\n        (when-not (zero? exit) (fail! (str nm \" failed\")))))\n    ;; per-subsystem cljs namespaces; the per-run files are the evidence\n    (let [lists (into {} (map (fn [s] [s (cljs-namespaces clone s)]) subs))\n          test-root (str (fs/canonicalize (str clone \"/test\")))\n          all (->> (file-seq (fs/file test-root))\n                   (filter #(re-find #\"_test\\.clj[cs]$\" (str %)))\n                   (map (fn [path]\n                          (-> (str path)\n                              (str/replace (str test-root \"/\") \"\")\n                              ns->test-ns)))\n                   set)\n          covered (apply set/union (map set (vals lists)))\n          uncovered (set/difference all covered)\n          lists (cond-> lists (and run-uncovered? (seq uncovered))\n                        (assoc \"uncovered\" (vec uncovered)))]\n      (log (str \"all=\" (count all) \" covered=\" (count covered)\n                \" uncovered=\" (count uncovered)))\n      (doseq [[s nss] lists]\n        (spit (str out \"/ns-\" s \".txt\") (str/join \"\\n\" nss))))\n    ;; one full compile, no autorun\n    (let [t0 (System/currentTimeMillis)\n          exit (sh (str out \"/compile.log\")\n                   [\"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                    \"compile\" \"test\" \"--config-merge\" \"{:autorun false}\"])]\n      (log (str \"compile-all rc=\" exit\n                \" secs=\" (quot (- (System/currentTimeMillis) t0) 1000)))\n      (when-not (zero? exit) (fail! \"compile failed\")))\n    ;; R1: the bundle's own inventory is the authority on what can run\n    (let [{listing :out} (psh {:dir clone :out :string :continue true}\n                              \"node\" \"target/node-tests.js\" \"--list\")\n          bundle (->> (str/split-lines listing)\n                      (keep #(re-find #\"^Namespace: (\\S+)\" %))\n                      (map second)\n                      set)\n          lists (into {}\n                      (map (fn [s]\n                             [s (some->> (str out \"/ns-\" s \".txt\")\n                                         slurp\n                                         str/split-lines\n                                         (remove str/blank?)\n                                         vec)])\n                           subs))\n          lists (cond-> lists\n                  (.exists (fs/file (str out \"/ns-uncovered.txt\")))\n                  (assoc \"uncovered\"\n                         (->> (slurp (str out \"/ns-uncovered.txt\"))\n                              str/split-lines\n                              (remove str/blank?)\n                              vec)))\n          sel (into {} (map (fn [[s nss]] [s (filterv bundle nss)])) lists)\n          ;; Absence from the bundle's --list means the lane has no tests in\n          ;; that namespace (a JVM-only namespace behind a clj reader\n          ;; conditional compiles to a library with no cljs test vars). That\n          ;; is a lane exclusion, recorded for the summary — not a failure.\n          ;; A failure is a namespace the bundle KNOWS that then fails to\n          ;; run, which the expected-vs-completed check below catches.\n          exclusions (into {}\n                           (remove (fn [[_ nss]] (empty? nss)))\n                           (into {}\n                                 (map (fn [[s nss]]\n                                        [s (set/difference (set nss) bundle)]))\n                                 lists))]\n      (doseq [[s ex] exclusions]\n        (log (str \"lane-excluded \" s \": \" (str/join \",\" (sort ex)))))\n      ;; run up to PAR shards at a time (waves)\n      (let [t0 (System/currentTimeMillis)\n            shards (vec (filter (comp seq sel) (keys sel)))\n    (doseq [[path {:keys [why] :as r}] reasons]\n      (println (format \"  %s: %s -> %d tests\" path why (count (:tests r)))))\n    (doseq [lane (keys selected)]\n      (let [nses (selected lane)]\n        (println (format \"%s: %d namespaces\" (name lane) (count nses)))\n        (doseq [n nses] (println \"  \" n))))\n    (println (format \"Selected %d of %d test namespaces.\" (count tests)\n                     total))\n    (when (seq wide)\n      (println \"wide change: run bb test\"))))\n\n\n(defn- lane-command\n  ([lane nses] (lane-command lane nses false))\n  ([lane nses slow?]\n   (case lane\n     :clj (into [\"clojure\" \"-M:test\" (if slow? \"-i\" \"-e\") \":slow\"]\n                (mapcat #(vector \"-n\" (str %)) nses))\n     :cljs [\"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\" \"compile\" \"test\"\n            \"--config-merge\" (str \"{:ns-regexp \\\"\" (ns-regexp nses) \"\\\"}\")]\n     :cljd [\"bb\" \"src/dev/cljd_agg.clj\" \"--only\" (str/join \",\" nses)])))\n\n\n(defn- log-file\n  ([lane] (log-file lane \"changed-\"))\n  ([lane prefix]\n   (str log-dir \"/\" prefix (name lane) \".log\")))\n\n\n(defn- run-lane!\n  ([lane nses] (run-lane! lane nses \"changed-\" false))\n  ([lane nses prefix slow?]\n   (let [log (log-file lane prefix)\n.shadow-cljs/builds/test/dev/out/cljs-runtime/shadow.test.node.js:20:if(clojure.string.starts_with_QMARK_(arg,\"--test=\")){\n.shadow-cljs/builds/test/dev/out/cljs-runtime/shadow.test.node.js:58:return cljs.core.println.cljs$core$IFn$_invoke$arity$variadic(cljs.core.prim_seq.cljs$core$IFn$_invoke$arity$2([\"  --test=<ns-to-test>,<fqn-symbol-to-test> (run test for namespace or single var, separated by comma)\"], 0));\n-rw-r--r--@ 1 sto  staff  59879 Nov 22 23:13 target/node-tests.js\n","exit_code":0,"status":"completed"}}
