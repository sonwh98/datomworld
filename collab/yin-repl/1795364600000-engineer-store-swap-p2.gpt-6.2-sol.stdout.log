{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn (seam|mesh|join\"'!|tick!)|close!'\"' test/dao/jing/dht/mesh.cljc; rg -n 'net-fixture|head.board|step-all|pump\"'!|join-token|'\"\\\\(require \\\\(quote.*' test/yin/repl/dht_head_test.cljc | head -65; sed -n '1,109p' test/yin/repl/net_fixture.cljc; sed -n '246,322p' test/yin/repl/dht_test.cljc; rg -n 'defn parse-int|defn parse-trust' src/cljc/yin/repl/{main,state}.cljc; rg -n 'request-complete|released|defn closed-conns' test/yin/repl/net_fixture.cljc\"","aggregated_output":"45:(defn mesh\n99:(defn seam\n122:      :close! (fn [] (swap! net update :traffic dissoc [bind-host port]))})))\n159:(defn join!\n180:(defn tick!\n12:   `connect!` seams (as in yin.vm.linker.head-board-test), pumped by the\n145:  (net/pump! (:ws w))\n149:                 (let [[s _ lines] (main/step-all s nil now)]\n150:                   (net/pump! (:ws w))\n222:      (type! :a \"(require (quote yin.link))\")\n300:    (driver/submit-line! (:input state) \"(require (quote my.lib))\")\n301:    (let [[state _ lines] (main/step-all state nil 0)]\n315:            w (type! w :b \"(require (quote alib))\")]\n338:                w (type! w :b \"(require (quote yin.head))\")\n355:                    w (type! w :b \"(require (quote alib))\")\n363:                      w (type! w :b \"(require (quote alib))\")\n384:                                 (type! :b \"(require (quote alib))\")\n395:        w (type! w :b \"(require (quote alib))\")\n691:              (type! :b \"(require (quote yin.head))\")\n758:    (net/pump! (:ws w))\n787:                 (+ (count (lines-with w :b (str \"lost the head board of \" principal)))\n793:    (is (= [\"dht: the head board stopped\"]\n794:           (lines-with w :a \"dht: the head board stopped\"))\n808:      (net/pump! (:ws w))\n1059:                      (type! k \"(require (quote yin.link))\")\n1069:              (type! :b \"(require (quote alib))\")\n1070:              (type! :b (str \"(require (quote \" c-name \"))\"))\n1130:                  (type! :a \"(require (quote yin.link))\")\n1137:                  (type! :b \"(require (quote alib))\")\n1138:                  (type! :b \"(require (quote blib))\")\n1180:                         \"serves no head board for this principal\"))\n(ns yin.repl.net-fixture\n  \"An in-process host for the REPL's serve, embed and main tests: the\n   loopback net's `:bind!`, `:unbind!` and `:connect!` seams, recorded,\n   so a real `yin.repl.connect` client attaches to a real endpoint on\n   every host and nothing binds a port.  The test pumps the net.\"\n  (:require [dao.stream.loopback-net :as net]\n            [dao.stream.rpc :as rpc]\n            [yin.repl.connect :as connect]))\n\n\n(defn host\n  \"A loopback host: `:adapter` is the host assembly, `:bound` every bind\n   configuration, `:released` every unbind call, `:deposit` the bound\n   listener's lifecycle deposit!.\"\n  ([] (host (net/loopback-net)))\n  ([lnet]\n   (let [bound (atom [])\n         released (atom [])\n         deposit (atom nil)\n         listen (net/listen-on lnet)\n         unbind (net/unbind-on lnet)]\n     {:net lnet\n      :bound bound\n      :released released\n      :deposit deposit\n      :adapter {:connect! (net/connect-on lnet)\n                :bind! (fn [config]\n                         (swap! bound conj config)\n                         (reset! deposit (:deposit! config))\n                         (listen config))\n                :unbind! (fn [listener deposit!]\n                           (swap! released conj listener)\n                           (unbind listener deposit!))}})))\n\n\n(defn pump!\n  \"Run everything in flight on the host's net.\"\n  [h]\n  (net/pump! (:net h)))\n\n\n(defn open\n  \"`connect/open` to `url` over the host at `now`: `{:connection atom\n   :client atom}`, or nil with the failure printed by the assertion that\n   uses it.\"\n  [h url now]\n  (let [result (connect/open {:url url :host (:adapter h) :now now})]\n    (when (= :yin.repl.connect/attached (get result connect/outcome-key))\n      {:connection (atom (get result connect/connection-key))\n       :client (atom (get result connect/client-key))})))\n\n\n(defn client-step!\n  \"Step the client's connection at `now`, then poll its RPC client once.\"\n  [c now]\n  (swap! (:connection c) connect/step! now)\n  (swap! (:client c) #(:dao.stream.rpc/state (rpc/poll! %))))\n\n\n(defn closed-conns\n  \"How many of the net's connections have closed.\"\n  [h]\n  (count (filter (comp deref :closed?) (:conns @(:net h)))))\n  (is (= {:type :dht :dir \"idx\"} (shell.store/parse-arg \"dht:idx\")))\n  (testing \"a bare dht: names no directory and is refused\"\n    (is (str/includes? (ex-message (refusal-of #(shell.store/parse-arg \"dht:\")))\n                       \"needs a directory\")))\n  (testing \"the unknown-scheme refusal names every supported form\"\n    (is (str/includes? (ex-message (refusal-of #(shell.store/parse-arg \"bogus\")))\n                       \"dht:<dir>\"))))\n\n\n(deftest peers-publication-and-binding-are-separate-explicit-flags\n  (let [spec #(:index-store-spec (shell.main/parse-args (into [\"--index-store\"\n                                                         \"dht:d\"] %)))]\n    (testing \"peers declare nothing: publication stays off\"\n      (is (= {:peers [{:host \"127.0.0.1\" :port 7001}\n                      {:host \"::1\" :port 7002}]\n              :publish? false}\n             (select-keys (spec [\"--dht-peer\" \"127.0.0.1:7001\"\n                                 \"--dht-peer\" \"[::1]:7002\"])\n                          [:peers :publish?]))))\n    (testing \"--dht-publish is its own declaration\"\n      (is (true? (:publish? (spec [\"--dht-peer\" \"127.0.0.1:7001\"\n                                   \"--dht-publish\"]))))\n      (is (true? (:publish? (spec [\"--dht-publish\"])))\n          \"publishing in solo is legal: nothing leaves the process\"))\n    (testing \"the bind host defaults to loopback; any other is explicit\"\n      (is (= \"127.0.0.1\" (:bind-host (spec [\"--dht-peer\" \"127.0.0.1:7001\"]))))\n      (is (= \"0.0.0.0\" (:bind-host (spec [\"--dht-peer\" \"127.0.0.1:7001\"\n                                          \"--dht-bind\" \"0.0.0.0\"])))))\n    (testing \"the inbound storage bound has a CLI default and a flag\"\n      (is (= repl.dht/default-max-inbound-bytes\n             (:max-inbound-bytes (spec []))))\n      (is (= 1024 (:max-inbound-bytes (spec [\"--dht-max-inbound-bytes\"\n                                             \"1024\"]))))))\n  (testing \"every malformed or meaningless combination is refused, not ignored\"\n    (doseq [[args text] [[[\"--dht-peer\" \"127.0.0.1:1\"] \"dht:<dir>\"]\n                         [[\"--dht-publish\"] \"dht:<dir>\"]\n                         [[\"--index-store\" \"file:d\" \"--dht-peer\" \"127.0.0.1:1\"]\n                          \"dht:<dir>\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-peer\" \"localhost:1\"]\n                          \"IP literal\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-peer\" \"127.0.0.1\"]\n                          \"host:port\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-peer\" \"127.0.0.1:0\"]\n                          \"host:port\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-port\" \"7000\"]\n                          \"solo\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-bind\" \"0.0.0.0\"]\n                          \"solo\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-bind\" \"localhost\"\n                           \"--dht-peer\" \"127.0.0.1:1\"]\n                          \"IP literal\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-manifest\"\n                           \"segment/blake3-00\"]\n                          \"solo\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-peer\" \"127.0.0.1:1\"\n                           \"--dht-manifest\" \"not-an-address\"]\n                          \"manifest\"]\n                         [[\"--index-store\" \"dht:d\" \"--dht-max-inbound-bytes\"\n                           \"-1\"]\n                          \"max-inbound-bytes\"]]]\n      (let [e (refusal-of #(shell.main/parse-args args))]\n        (is (some? e) (pr-str args))\n        (is (str/includes? (str (ex-message e)) text) (pr-str args))))))\n\n\n(deftest startup-refuses-a-bad-dht-flag-before-composing\n  (let [started (shell.main/startup [\"--dht-publish\"])]\n    (is (string? (:refusal started)))\n    (is (nil? (:state started)))))\n\n\n;; =============================================================================\n;; Bullet 1: solo opens no socket; the secret is minted, in memory only\n;; =============================================================================\n\n(deftest a-dht-store-with-no-peers-is-solo-and-opens-no-socket\n  (let [dir (temp-dir)\nsrc/cljc/yin/repl/state.cljc:31:(defn parse-trust\nsrc/cljc/yin/repl/main.cljc:70:(defn parse-int\n13:   configuration, `:released` every unbind call, `:deposit` the bound\n18:         released (atom [])\n24:      :released released\n32:                           (swap! released conj listener)\n60:(defn closed-conns\n","exit_code":0,"status":"completed"}}
