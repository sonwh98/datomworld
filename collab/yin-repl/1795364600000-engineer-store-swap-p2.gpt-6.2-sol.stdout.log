hell/dht.cljc:1160:(defn moved\nsrc/cljc/yin/shell/dht.cljc:1168:(defn- movers\nsrc/cljc/yin/shell/dht.cljc:1205:(defn moved-lines\nsrc/cljc/yin/shell/dht.cljc:1232:(defn- step-follow\nsrc/cljc/yin/shell/dht.cljc:1282:(defn step\nsrc/cljc/yin/shell/dht.cljc:1337:(defn refusal\nsrc/cljc/yin/shell/dht.cljc:1351:(defn admitting?\nsrc/cljc/yin/shell/dht.cljc:1363:(defn busy?\nsrc/cljc/yin/shell/dht.cljc:1371:(defn follow-lines\nsrc/cljc/yin/shell/dht.cljc:1387:(defn banner\nsrc/cljc/yin/shell/cli.cljc:32:(defn parse-peer\nsrc/cljc/yin/shell/cli.cljc:55:(defn- parse-manifest\nsrc/cljc/yin/shell/cli.cljc:63:(def dht-flags\nsrc/cljc/yin/shell/cli.cljc:71:(def max-follow\nsrc/cljc/yin/shell/cli.cljc:76:(defn parse-follow\nsrc/cljc/yin/shell/cli.cljc:107:(defn parse-principal\nsrc/cljc/yin/shell/cli.cljc:118:(defn parse-trust\nsrc/cljc/yin/shell/cli.cljc:128:(defn split-path\nsrc/cljc/yin/shell/cli.cljc:136:(defn load-key\nsrc/cljc/yin/shell/cli.cljc:160:(defn- ensure-parent!\nsrc/cljc/yin/shell/cli.cljc:169:(defn- write-new-file!\nsrc/cljc/yin/shell/cli.cljc:215:(defn keygen!\nsrc/cljc/yin/shell/cli.cljc:238:(defn- dht-spec\nsrc/cljc/yin/shell/cli.cljc:297:(defn- dht-number\nsrc/cljc/yin/shell/cli.cljc:309:(defn home-dir*\nsrc/cljc/yin/shell/cli.cljc:317:(defn home-dir\nsrc/cljc/yin/shell/cli.cljc:325:(defn state-path\nsrc/cljc/yin/shell/cli.cljc:331:(defn- peer-text\nsrc/cljc/yin/shell/cli.cljc:337:(defn parse-token\nsrc/cljc/yin/shell/cli.cljc:361:(defn- keygen-args\nsrc/cljc/yin/shell/cli.cljc:374:(defn- global-flag-kind\nsrc/cljc/yin/shell/cli.cljc:382:(defn- dht-args\nsrc/cljc/yin/shell/cli.cljc:442:(defn expand-args\nsrc/cljc/yin/shell/cli.cljc:470:(defn parse-flag\nsrc/cljc/yin/shell/cli.cljc:527:(defn finalize-opts\nsrc/cljc/yin/shell/cli.cljc:537:(defn parse-store-arg\nsrc/cljc/yin/shell/cli.cljc:544:(def state-table\nsrc/cljc/yin/shell/cli.cljc:560:(def flag-table\nsrc/cljc/yin/shell/cli.cljc:568:(def help-lines\nsrc/cljc/yin/shell/cli.cljc:635:(defn ensure-key!\n