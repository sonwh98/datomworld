{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/query.cljc | sed -n '145,180p;1400,1455p'; rg -n 'defn q|source|:in' src/cljc/dao/space/query.cljc | tail -30\"","aggregated_output":"   145\t;; =============================================================================\n   146\t\n   147\t(defn value?\n   148\t  \"True for the query values q/match/pull take as database inputs: a\n   149\t   relation value, a datom view, or an opened published index. Raw vectors\n   150\t   and raw maps answer false.\"\n   151\t  [x]\n   152\t  (and (map? x)\n   153\t       (or (contains? x :dao.space.query/relation)\n   154\t           (contains? x :dao.space.query/view)\n   155\t           (contains? x :dao.space.query/published))))\n   156\t\n   157\t\n   158\t(defn relation\n   159\t  \"An in-memory relation value. Its retained contents are an arbitrary,\n   160\t   mixed-dimensional tuple collection; arity never selects an\n   161\t   interpretation. This is the replacement for the direct raw-vector input.\"\n   162\t  [tuples]\n   163\t  {:dao.space.query/relation (vec tuples)})\n   164\t\n   165\t\n   166\t(defn entity-map-relation\n   167\t  \"An entity-map relation value: a bounded relation of entity maps,\n   168\t   projected explicitly to [e a v] facts on the read side. The read side is\n   169\t   pure and never mints an entity id, so every map must carry :db/id.\"\n   170\t  [maps]\n   171\t  ;; Normalize at the explicit constructor boundary. The resulting value is\n   172\t  ;; the same generic relation value q consumes; no second transport type\n   173\t  ;; or opening path is needed merely because the input syntax was maps.\n   174\t  (relation (entity-maps->d3 maps)))\n   175\t\n   176\t\n   177\t(defn fact-relation\n   178\t  \"The explicit current-fact relation: d3 rows that are already\n   179\t   current-state facts, so the fact index is built for them without a d5\n   180\t   pass. dao.space.schema builds these directly.\"\n  1400\t        (and (seq? clause) (= 'not-join (first clause)))\n  1401\t        (mapcat #(eval-not-join clause % ctx) bindings)\n  1402\t        (seq? clause) (mapcat #(eval-rule clause % ctx) bindings)\n  1403\t        (and (vector? clause) (seq? (first clause)))\n  1404\t        (mapcat #(eval-fn-clause clause % ctx) bindings)\n  1405\t        :else (mapcat #(eval-pattern-clause clause % ctx) bindings)))\n  1406\t\n  1407\t\n  1408\t(defn- estimate-clause-cost\n  1409\t  [clause binding]\n  1410\t  (let [[db-sym pattern] (clause-db-and-pattern clause)\n  1411\t        ;; Truthiness only, never forced: planning must not drain a\n  1412\t        ;; deferred (lazy published) relation. A delay is always truthy;\n  1413\t        ;; forcing here would fully materialize the source for every\n  1414\t        ;; multi-clause query before the first clause runs.\n  1415\t        relation (::relation (resolve-db binding db-sym))]\n  1416\t    (if-not relation\n  1417\t      1000000\n  1418\t      (let [{:keys [fixed]} (parse-tuple-pattern pattern)\n  1419\t            bound-count (count (remove #(= FREE (resolve-binding binding %))\n  1420\t                                       fixed))]\n  1421\t        (- 1024 bound-count)))))\n  1422\t\n  1423\t\n  1424\t(defn- plan-where\n  1425\t  [clauses init-bindings]\n  1426\t  (if (or (<= (count clauses) 1) (empty? init-bindings))\n  1427\t    clauses\n  1428\t    (let [binding (first init-bindings)]\n  1429\t      (mapcat (fn [chunk]\n  1430\t                (if (pattern-clause? (first chunk))\n  1431\t                  (mapv second\n  1432\t                        (sort-by (fn [[idx clause]]\n  1433\t                                   [(estimate-clause-cost clause\n  1434\t                                                          binding)\n  1435\t                                    idx])\n  1436\t                                 (map-indexed vector chunk)))\n  1437\t                  chunk))\n  1438\t              (partition-by pattern-clause? clauses)))))\n  1439\t\n  1440\t\n  1441\t(defn- eval-where\n  1442\t  [clauses init-bindings ctx]\n  1443\t  (reduce (fn [bindings clause] (eval-clause clause bindings ctx))\n  1444\t          init-bindings\n  1445\t          (plan-where clauses init-bindings)))\n  1446\t\n  1447\t\n  1448\t(defn- normalize-query\n  1449\t  [query]\n  1450\t  (if (map? query)\n  1451\t    query\n  1452\t    (let [v (vec query)]\n  1453\t      (loop [i 0\n  1454\t             result {}\n  1455\t             cur-key nil\n764:     (pull (current source) 123 [:name :age {:friend [:name]}])\"\n765:  [source eid pattern]\n766:  (let [{::keys [fact-index]} (realize-db-value! source)]\n768:      (throw (ex-info \"pull requires a current fact-shaped source view\"\n769:                      {:source source})))\n775:  [source eids pattern]\n776:  (let [{::keys [fact-index]} (realize-db-value! source)]\n779:               \"pull-many requires a current fact-shaped source view\"\n780:               {:source source})))\n790:;; q: Datalog (:find / :in / :where over bounded db streams)\n1029:        :else (throw (ex-info \"Unknown :in pattern\" {:pattern pattern}))))\n1251:                           \"get-else requires a current fact-shaped source view\"\n1252:                           {:source _src})))\n1264:                           \"missing? requires a current fact-shaped source view\"\n1265:                           {:source _src})))\n1338:      (throw (ex-info \"No rules bound; pass a rule set via :in $ %\"\n1413:        ;; forcing here would fully materialize the source for every\n1460:            (if (#{:find :in :with :where :keys :syms :strs} x)\n1535:        (throw (ex-info \"pull find element requires a bound $ source\"\n1611:  \"Refuse a bare symbol where `:in` or `:find` declares a term. Under the\n1613:   no variable or project nil. `:in` also admits the blank `_`, a\n1614:   `$`-source, the `%` rule set and the `...` col