'? '\\\\n')?;\"]\n     [\"SeaWhitespace  : [ \\\\t\\\\r\\\\n]+ -> channel(HIDDEN);\"\n      \"SeaWhitespace  : [ \\\\t\\\\r\\\\n]+ -> type(HtmlText);\"]\n     [\"HtmlComment    : '<!' '--' .*? '-->'  -> channel(HIDDEN);\"\n      \"HtmlComment    : '<!' '--' .*? '-->'  -> type(HtmlText);\"]\n     [\"HtmlSpace                  : [ \\\\t\\\\r\\\\n]+ -> channel(HIDDEN);\"\n      \"HtmlSpace                  : [ \\\\t\\\\r\\\\n]+ -> type(HtmlText);\"]\n     [\"StartHereDoc : '<<<' [ \\\\t]* NameString {\"\n      \"StartHereDoc : '<<<' [ \\\\t]* ('\\\"' NameString '\\\"' | NameString) {\"]\n     [\"HereDocText: ~[\\\\r\\\\n]*? ('\\\\r'? '\\\\n' | '\\\\r');\"\n      \"HereDocText: ~[\\\\r\\\\n]*? ('\\\\r'? '\\\\n' | '\\\\r');\\n// Never matches: HeredocEndToken in PhpLexerBase builds this token.\\nHereDocEnd: [ \\\\t]* NameString { false }?;\"]],\n    \"PhpParser.g4\"\n    [[\"    : StartHereDoc HereDocText+\\n\" \"    : StartHereDoc HereDocText+ HereDocEnd\\n\"]\n     [\"    | StartNowDoc HereDocText+\\n\" \"    | StartNowDoc HereDocText+ HereDocEnd\\n\"]\n     ;; `static` initializers are expressions evaluated at run time, not the\n     ;; constant initializers of properties and parameter defaults\n     [\"    : Static variableInitializer (',' variableInitializer)* SemiColon\\n    ;\\n\"\n      \"    : Static staticInitializer (',' staticInitializer)* SemiColon\\n    ;\\n\\nstaticInitializer\\n    : VarName (Eq expression)?\\n    ;\\n\"]\n     ;; PHP 7.4 spread in array literals: `[...$a]`\n     [\"    | (expression '=>')? '&' chain\\n    ;\\n\" \"    | (expression '=>')? '&' chain\\n    | Ellipsis expression\\n    ;\\n\"]\nlib/antlr/php\n(ns cljd-agg\n  \"Dart test runner that aggregates the generated test files.\n\n   `flutter test` loads every generated *_test.dart separately (about 7.5 s\n   each). This runner compiles the test namespaces through the cljd tool,\n   groups the generated files into a few shard files that import them and call\n   each `main`, and runs `flutter test` on the shards only. Shards live under\n   build/, never under test/, so a plain `cljd test` never runs them twice.\n\n   Run with babashka:\n     bb src/dev/cljd_agg.clj [--slow-only | --slow-regex | --only NS,NS...]\n   --slow-only restricts the run to the namespaces that use dao.test-slow/guard.\n   A namespace in that set with no generated Dart file is fatal.\n   --only compiles and runs only the given test namespaces (bb test:changed,\n   bb test:sub); one with no generated Dart file is fatal too, EXCEPT a\n   JVM-only namespace: one whose every deftest sits behind a reader\n   conditional that excludes ClojureDart (for example\n   dao.data.sorted-user-type-test). The cljd tool compiles such a namespace as\n   a plain library (lib/cljd-out/<ns>.dart exists) and emits no test file;\n   that is reported and skipped, never fatal. A namespace that produced\n   neither file is still fatal.\n   --slow-regex prints, for bb.edn, an anchored alternation of those\n   namespaces with its dots already escaped for embedding in an EDN string\n   (shadow-cljs --config-merge); it is not a ready-to-use regex. It exits 1\n   when no namespace uses the guard, so a slow lane cannot be vacuous.\n   DATOM_SLOW_TESTS is inherited from the environment.\"\n                (spit path (shard-source group shard-dir))\n                path))\n            (shard files n))))))\n\n\n(defn -main\n  [& args]\n  (when (some #{\"--slow-regex\"} args)\n    (when (empty? (slow-namespaces))\n      (println \"No namespace uses dao.test-slow/guard.\")\n      (System/exit 1))\n    (println (str \"^(\" (str/join \"|\" (map #(str/replace % \".\" \"\\\\\\\\.\")\n                                          (slow-namespaces)))\n                  \")$\"))\n    (System/exit 0))\n  (let [slow-only? (some #{\"--slow-only\"} args)\n        shard-dir  (or (when (some #{\"--shard-dir\"} args)\n                         (second (drop-while #(not= \"--shard-dir\" %) args)))\n                       shard-dir)\n        no-compile? (some #{\"--no-compile\"} args)\n        no-run?    (some #{\"--no-run\"} args)\n        ;; individual-test selection (owner ruling 2026-11-07: the focus rule\n        ;; runs the failing TEST, not the namespace): --only accepts NS or\n        ;; NS/test-name; entries with a test name become flutter --plain-name\n        ;; filters so only the named deftests execute.\n        {only :namespaces, test-names :tests}\n        (when (some #{\"--only\"} args)\n          (let [v (second (drop-while #(not= \"--only\" %) args))\n                entries (vec (remove str/blank? (str/split (str v) #\",\")))]\n            {:namespaces (vec (distinct (map #(first (str/split % #\"/\")) entries)))\n             :tests (vec (keep #(when (str/includes? % \"/\")\n                                  (last (str/split % #\"/\")))\n                               entries))}))\n        wanted     (cond only only\n                         slow-only? (slow-namespaces)\n                         :else (test-namespaces))]\n    (when (empty? wanted)\n      (println \"No test namespaces selected.\")\n      (System/exit 1))\n    (when-not no-compile?\n      (compile-tests (or only (test-namespaces))))\n    (let [files (filter fs/exists? (map dart-file wanted))\n          missing (remove (comp fs/exists? dart-file) wanted)]\n      (when (seq missing)\n        (let [jvm-only (if (and only (not slow-only?))\n                         (filter jvm-only? missing)\n                         [])\n              fatal (remove (set jvm-only) missing)]\n          (when (seq jvm-only)\n            (println \"JVM-only namespaces (compiled, no Dart tests; skipped):\"\n                     (str/join \", \" jvm-only)))\n          (when (seq fatal)\n            (println \"No generated Dart test for:\" (str/join \", \" fatal))\n            (when (or slow-only? only)\n              (System/exit 1)))))\n      (when (empty? files)\n        (println \"No generated test files found.\")\n        (System/exit 1))\n      (let [shards (write-shards! files shard-dir)]\n        (if no-run?\n          (do (println (format \"Emitted %d test files in %d shards under %s\"\n                               (count files) (count shards) shard-dir))\n              (System/exit 0))\n          (do (println (format \"Running %d test files in %d shards\"\n                               (count files) (count shards)))\n              ;; --reporter expanded streams every failure name and position\n              ;; as it happens, so even an interrupted run retains them (the\n              ;; nightly's compact reporter lost 7 dart failure names to its\n              ;; wall clock, 2026-11-06). DATOM_FAIL_FAST=1 opts a G0\n              ;; bug-chase into stopping at the first failure (owner ruling\n              ;; 2026-11-07): the report arrives in minutes, not after the\n              ;; whole scoped set. Gate runs never set it — the merge bar\n              ;; needs the complete pass/fail picture.\n","exit_code":0,"status":"completed"}}
