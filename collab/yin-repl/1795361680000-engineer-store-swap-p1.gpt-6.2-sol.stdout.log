either\n# POSIX nor present on older macOS.\ntarget=\"$0\"\nwhile [ -L \"$target\" ]; do\n  link=\"$(readlink \"$target\")\"\n  case \"$link\" in\n    /*) target=\"$link\" ;;\n    *)  target=\"$(CDPATH= cd -- \"$(dirname -- \"$target\")\" && pwd)/$link\" ;;\n  esac\ndone\nroot=\"$(CDPATH= cd -- \"$(dirname -- \"$target\")/..\" && pwd)\"\nexport JOLT_PWD=\"${JOLT_PWD:-$PWD}\"\n# How jolt re-invokes itself (babashka.tasks/clojure in a task). An installed\n# jolt is on PATH and needs no help; this checkout is not.\nexport JOLT_EXE=\"${JOLT_EXE:-$root/bin/jolt}\"\n\n# Identify the Chez Scheme executable. $JOLT_CHEZ is authoritative and is how the\n# Makefile hands down the one it selected — the same interpreter that mints the\n# seed and compiles target/dev/flat.so. A direct bin/jolt invocation does not\n# inherit that export, so it takes the Chez make recorded next to the dev boot\n# cache (any other pick makes that cache unusable), then the one make\nbuild\ntarget\n","exit_code":0,"status":"completed"}}
