a reattachment decision to wait for only while the\n   binding is `connect/reattachable?`.  A reachability failure may succeed\n   through a *fresh* connection, but that connection cannot inherit this\n   binding's queued lines, so promising to deliver them would be false.\"\n  [state]\n  (and (:adapter state)\n       (not (connect/operator-detached? (:connection state)))\n       (or (nil? (remote-terminal state))\n           (connect/reattachable? (:connection state) (rpc-client state)))))\n          datoms))\n\n\n(defn rehydrate\n  \"Seed a fresh indexer from a recovered durable snapshot, `{:manifest\n   address :datoms [...]}` (yin.repl.store's `:recovery`), before any\n   evaluation is admitted.  Its log becomes a fresh complete-retention\n   memory log holding the recovered datoms as transaction records, one\n   per original `t` in ascending order, each datom and its `t` preserved,\n   so a new transactor derives the next `t` from it. Entity\n   allocation resumes one past the greatest restored entity or metadata\n   id.  The manifest is the published one, covering every restored\n   transaction, so `q` answers from it before anything new is evaluated.\n   Restored facts keep their original session tokens and round metadata:\n   they are the datoms as committed.  A recovery without a manifest is an\n   empty index. Live allocation and publication successors are always\n   discarded, including any stale or foreign cursor: the first subsequent\n   publication takes the full reconstruction path and derives a new cursor\n   from this log, never from a saved process checkpoint.\"\n  [indexer {:keys [manifest datoms]}]\n  (if (nil? manifest)\n    (assoc indexer :allocator nil :materialization nil)\n    (let [log (memory-log)\n          by-t (group-by index/datom-t datoms)\n          ts (sort (keys by-t))]\n      (doseq [t ts]\n        (let [answer (stream/append! log {:dao.space/transaction\n                                          {:t t, :datoms (vec (get by-t t))}})]\n          (when-not (= :dao.stream/ok (:dao.stream/outcome answer))\n            (throw (ex-info \"the recovered snapshot could not be rehydrated\"\n                            {:t t, :outcome answer})))))\n      (assoc indexer\n             :local log\n             :next-e (next-entity-id datoms)\n             :transactions (count ts)\n             :published (count ts)\n             :allocator nil\n             :materialization nil\n             :manifest-address manifest))))\n\n\n(defn carry-over\n  \"A rebuilt session's fresh `indexer`, continuing `previous`'s index: its\n   transaction log, entity allocation, counts, published manifest, and\n   live allocator/verified materialization successors.\n   `(reset)` and VM selection over a durable store use it, so a rebuild\n   never resets `t` or entity allocation and `q` keeps answering the\n   published index; the observer is the new session's, and a lost or\n   failed indexer is recovered by the rebuild as it is today.\"\n                      :publication-media (publication/advance media cursor))\n               result))\n      indexer)\n    indexer))\n\n\n(defn pending-publication\n  \"The oldest publication request this indexer emitted and no matching\n   result has settled, or nil.  A composition reads it to know what it\n   still owes the engine before it may report the round settled\n   (docs/design/yin.repl.dht-composition.md section 4).\"\n  [indexer]\n  (:request (first (:pending-publications indexer))))\n\n\n(defn pending-publications\n  \"Every publication request this indexer emitted that no matching result\n   has settled, oldest first.  A composition owes the engine each of them:\n   one that services locally, in the round that emitted; one with\n   transport of its own, before it reports the round settled.  An\n   outstanding request of an earlier round is why a later round's own\n   promotion has not been reported yet\n   (docs/design/yin.repl.dht-composition.md sections 3-4).\"\n  [indexer]\n  (mapv :request (:pending-publications indexer)))\n\n\n(defn- emit-publication\n  \"Emit `round`'s publication request for the frontier `promotes` and hold\n   that frontier on the outstanding queue until a matching result settles\n   it.  Results already on the medium are consumed first, so a success the\n   composition delivered promotes before a newer request is emitted over\n(defn- ingress-gaps\n  \"Gaps the evaluation path's observers counted.  The code indexer's are\n   its own: an index loss is reported without refusing evaluation.\"\n  [state]\n  (+ (:ingress-gaps (:observer state) 0)\n     (:ingress-gaps (:row-observer state) 0)))\n\n\n(defn- consume-failed-round\n  \"Answer a round that threw with a recoverable shell state.\n\n   The failed input is consumed exactly once: each of the session's\n   observers resumes from the session the throw carried — the failing\n   stage's, matched by the medium it holds — or from where the round began\n   when it carried none, and reads past every batch still on its medium.\n   The shell is the only appender and appends one batch per round, so what\n   remains is the failed batch alone.  The VM is the one the round began\n   with, so a half-run continuation cannot be resumed — and its error\n   replayed — by the next input.  Output the round already emitted is\n   drained here, once.\"\n  [state error]\n  (let [carried (get-in (ex-data error) [:session :observer])\n        resume (fn [observer]\n                 (if (and observer\n                          carried\n                          (= (:stream carried) (:stream observer)))\n                   carried\n                   observer))\n        drained (assoc state\n                       :observer (drain-observer (resume (:observer state)))\n                       :row-observer (drain-observer\n                                       (resume (:row-observer state)))\n                       :indexer (index/skip (:indexer state))\n                       :ast-indexer (ast-index/skip (:ast-indexer state)))\n226:              :repl (or repl (repl.frontends/create-state))\n429:              (let [[repl' answer] (evaluate (:repl endpoint) request)]\n432:                              :repl repl'\n514:(defn step\nsrc/cljc/dao/space/store.cljc:137:(defn file-refusal\nsrc/cljc/dao/space/store.cljc:144:  ([dir] (file-refusal (host-file-support) dir))\nsrc/cljc/dao/space/store.cljc:298:  (if-some [refusal (file-refusal dir)]\nsrc/cljc/dao/space/store/fs.cljc:48:   nothing but the canonical paths of the directories this process\nsrc/cljc/dao/space/store/fs.cljc:176:  ;; (see the namespace docstring): the canonical paths of the durable\nsrc/cljc/dao/space/store/fs.cljc:181:(defn- canonical-dir\nsrc/cljc/dao/space/store/fs.cljc:182:  \"The directory's one canonical path: the key of this process's own\nsrc/cljc/dao/space/store/fs.cljc:257:   (let [key (canonical-dir dir)]\ntest/yin/repl/ast_index_test.cljc:144:                                [\"(defmacro unless [c a b] (yin/if c b a))\"])\ntest/yin/repl/ast_index_test.cljc:235:(deftest a-malformed-packet-leaves-the-relations-unavailable\ntest/yin/repl/ast_index_test.cljc:302:(deftest a-malformed-packet-in-the-session-is-reported-and-evaluation-continues\ntest/yin/repl/main_test.cljc:462:                    malformed (temp-file)\ntest/yin/repl/main_test.cljc:467:                  (write-text! malformed \"{:version 1 :algorithm :ed25519\")\ntest/yin/repl/main_test.cljc:478:                                         [malformed \"malformed-key\"]\ntest/yin/repl/main_test.cljc:492:                    (run! cleanup-file! [good malformed mismatched absent]))))))\ntest/yin/repl/main_test.cljc:498:  ;; an absent, malformed or mismatched file refuses naming the path,\ntest/yin/repl/main_test.cljc:502:        malformed (temp-file)\ntest/yin/repl/main_test.cljc:510:      (write-text! malformed \"{:version 1 :algorithm :ed25519\")\ntest/yin/repl/main_test.cljc:515:                             [malformed \"ma