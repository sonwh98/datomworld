ss uses the directory.\"\n   113\t     [dir fs path]\n   114\t     (let [marker (str path \".takeover\")]\n   115\t       (try (let [fd (.openSync ^js fs marker \"wx\")]\n   116\t              (.writeSync ^js fs fd (str (.-pid js/process)))\n   117\t              (.closeSync ^js fs fd))\n   118\t            (catch :default e\n   119\t              (when-not (= \"EEXIST\" (.-code e))\n   120\t                (throw e))\n   121\t              (when-some [taker (named-pid fs marker)]\n   122\t                (when-not (live-pid? taker)\n   123\t                  (throw (ex-info (str dir \" is locked: a takeover of its\"\n   124\t                                       \" dead owner's lock died midway;\"\n   125\t                                       \" remove \" marker \" once no process\"\n   126\t                                       \" uses \" dir)\n   127\t                                  {:dir dir :marker marker}))))\n   128\t              (refuse-locked dir)))\n   129\t       (try\n   130\t         (cond\n   131\t           (not (.existsSync ^js fs path)) true\n   132\t           (dead-owner? fs path) (do (.unlinkSync ^js fs path) true)\n   133\t           :else false)\n   134\t         (finally\n   135\t           (try (.unlinkSync ^js fs marker) (catch :default _ nil)))))))\n   136\t\n   137\t\n   138\t(defonce ^:private held\n   139\t  ;; The host-ownership exception to the no-hidden-global-state invariant\n   140\t  ;; (see the namespace docstring): the canonical paths of the durable\n   141\t  ;; directories this process holds locked.\n   142\t  (atom #{}))\n   143\t\n   144\t\n   145\t(defn- canonical-dir\n   146\t  \"The directory's one canonical path: the key of this process's own\n   147\t   holdings, so two spellings of one directory are one owner.\"\n   148\t  [dir]\n   149\t  #?(:cljd (.resolveSymbolicLinksSync (dart-io/Directory. dir))\n   150\t     :clj (.getCanonicalPath (java.io.File. ^String dir))\n   151\t     :cljs (.realpathSync ^js (js/require \"fs\") dir)))\n   152\t\n   153\t\n   154\t(defn- claim!\n   155\t  \"Record `key` as held by this process, answering false when it already\n   156\t   was — a second owner inside the one process, refused before it opens\n   157\t   any handle on the lock file (closing such a handle would drop this\n   158\t   process's `fcntl` lock).\"\n   159\t  [key]\n   160\t  (let [claimed? (volatile! false)]\n   161\t    (swap! held (fn [keys]\n   162\t                  (vreset! claimed? (not (contains? keys key)))\n   163\t                  (conj keys key)))\n   164\t    @claimed?))\n   165\t\n   166\t\n   167\t(defn- host-lock!\n   168\t  \"Take the host's exclusive lock on `path`, answering its release\n   169\t   function, or refuse naming the directory.\"\n   170\t  #_{:clj-kondo/ignore [:unused-binding]}\n   171\t  [dir path dead-owner-seen]\n   172\t  #?(:cljd (let [raf (.openSync (dart-io/File. path)\n   173\t                                .mode dart-io/FileMode.append)]\n   174\t             (try\n   175\t               (.lockSync raf)\n   176\t               (fn []\n   177\t                 (try (.unlockSync raf) (catch Object _ nil))\n   178\t                 (try (.closeSync raf) (catch Object _ nil)))\n   179\t               (catch Object _\n   180\t                 (try (.closeSync raf) (catch Object _ nil))\n   181\t                 (refuse-locked dir))))\n   182\t     :clj (let [f (java.io.RandomAccessFile. ^String path \"rw\")]\n   183\t            (try\n   184\t              (let [fl (try (.tryLock (.getChannel f))\n   185\t                            (catch java.nio.channels.OverlappingFileLockException _\n   186\t                              nil))]\n   187\t                (if (nil? fl)\n   188\t                  (do (.close f)\n   189\t                      (refuse-locked dir))\n   190\t                  (fn []\n   191\t                    (try (.release ^java.nio.channels.FileLock fl)\n   192\t                         (catch Exception _ nil))\n   193\t                    (try (.close f)\n   194\t                         (catch Exception _ nil)))))\n   195\t              (catch Throwable t\n   196\t                (try (.close f) (catch Exception _ nil))\n   197\t                (throw t))))\n   198\t     :cljs (let [fs (js/require \"fs\")]\n   199\t             (letfn [(acquire!\n   200\t                       [stole?]\n   201\t                       (try\n   202\t                         (let [fd (.openSync ^js fs path \"wx\")]\n   203\t                           (.writeSync ^js fs fd (str (.-pid js/process)))\n   204\t                           (.closeSync ^js fs fd)\n   205\t                           (fn []\n   206\t                             (try (.unlinkSync ^js fs path)\n   207\t                                  (catch :default _ nil))))\n   208\t                         (catch :default e\n   209\t                           (cond\n   210\t                             (and (not stole?)\n   211\t                                  (= \"EEXIST\" (.-code e))\n   212\t                                  (dead-owner? fs path)\n   213\t                                  (do (when dead-owner-seen (dead-owner-seen))\n   214\t                                      (take-over-dead-owner! dir fs path)))\n   215\t                             (acquire! true)\n   216\t\n   217\t                             (= \"EEXIST\" (.-code e))\n   218\t                             (refuse-locked dir)\n   219\t\n   220\t                             :else (throw e)))))]\n   221\t               (acquire! false)))))\n   222\t\n   223\t\n   224\t(defn lock!\n   225\t  \"Acquire the exclusive lock of the durable store directory, or refuse\n   226\t   naming the directory — whether the other owner is another process or\n   227\t   this one. The answer is a plain release; closing whatever the host\n   228\t   needs closed is all releasing takes.\n   229\t\n   230\t   `dead-owner-seen`, `(fn [])`, runs on Node the moment a dead owner's\n   231\t   lock file has been inspected and before it is taken over — the window\n   232\t   a concurrent contender can race — so the tests can interleave one\n   233\t   there.\"\n   234\t  ([dir] (lock! dir {}))\n   235\t  ([dir {:keys [dead-owner-seen]}]\n   236\t   (let [key (canonical-dir dir)]\n   237\t     (when-not (claim! key)\n   238\t       (refuse-locked dir))\n   239\t     (let [release! (try (host-lock! dir (str dir \"/\" lock-name)\n   240\t                                     dead-owner-seen)\n   241\t                         (catch #?(:cljd Object\n   242\t                                   :clj Throwable\n   243\t                                   :cljs :default)\n   244\t                                e\n   245\t                           (swap! held disj key)\n   246\t                           (throw e)))\n   247\t           released? (volatile! false)]\n   248\t       {:release! (fn []\n   249\t                    (when-not @released?\n   250\t                      (vreset! released? true)\n   251\t                      (release!)\n   252\t                      (swap! held disj key)))}))))\n   253\t\n   254\t\n   255\t(defn unlock!\n   256\t  \"Release a lock `lock!` answered. Idempotent: a released lock releases\n   257\t   again as a no-op, never a later owner's lock of the same directory.\"\n   258\t  [lock]\n   259\t  (when-let [release! (:release! lock)]\n   260\t    (release!)))\n   261\t\n   262\t\n   263\t(defn directory-sync-supported?\n   264\t  \"True when this host can open a directory and fsync it, so a HEAD\n   265\t   replacement's rename can be made durable, not merely visible: Node\n   266\t   and the JVM on POSIX systems can; Windows cannot open a directory for\n   267\t   sync, and Dart's core has no directory sync at all.\"\n   268\t  []\n   269\t  #?(:cljd false\n   270\t     :clj (not (str/starts-with? (str (System/getProperty \"os.name\"))\n   271\t                                 \"Windows\"))\n   272\t     :cljs (not= \"win32\" (.-platform js/process))))\n   273\t\n   274\t\n   275\t(defn- sync-failure\n   276\t  [dir e]\n   277\t  (ex-info (str \"cannot sync the directory \" dir \" after the rename: \" e)\n   278\t           {:dir dir}\n   279\t           e))\n   280\t\n   281\t\n   282\t#?(:cljs\n   283\t   (defn- sync-directory!\n   284\t     \"Sync the directory entry itself where the host supports it — the\n   285\t      rename is durable, not merely visible.  There, a failure throws: a\n   286\t      replacement whose directory entry is not known durable is not\n   287\t      reported done.\"\n   288\t     [fs dir]\n   289\t     (when (directory-sync-supported?)\n   290\t       (try (let [fd (.openSync ^js fs dir \"r\")]\n   291\t              (try (.fsyncSync ^js fs fd)\n   292\t                   (finally\n   293\t                     (.closeSync ^js fs fd))))\n   294\t            (catch :default e\n   295\t              (throw (sync-failure dir e)))))))\n   296\t\n   297\t\n   298\t#?(:cljd nil\n   299\t   :clj\n   300\t   (defn- sync-directory!\n   301\t     \"Sync the directory entry itself where the host supports it — the\n   302\t      rename is durable, not merely visible.  There, a failure throws: a\n   303\t      replacement whose directory entry is not known durable is not\n   304\t      reported done.\"\n   305\t     [dir]\n   306\t     (when (directory-sync-supported?)\n   307\t       (try (with-open [ch (java.nio.channels.FileChannel/open\n   308\t                             (java.nio.file.Paths/get ^String dir\n   309\t                                                      (make-array String 0))\n   310\t                             ^\"[Ljava.nio.file.OpenOption;\"\n   311\t                             (into-array java.nio.file.OpenOption\n   312\t                                         [java.nio.file.StandardOpenOption/READ]))]\n   313\t              (.force ch true))\n   314\t            (catch Exception e\n   315\t              (throw (sync-failure dir e)))))))\n   316\t\n   317\t\n   318\t(defn atomic-replace!\n   319\t  \"Replace `<dir>/<name>` with `text` atomically: write the whole record\n   320\t   to a temp file beside it, sync the temp, rename it over the target,\n   321\t   and sync the directory where the host supports it — a failed\n   322\t   directory sync fails the replacement. A reader observes either the\n   323\t   whole previous record or the whole new one, never a partial write.\n   324\t\n   325\t   `before-rename`, `(fn [temp-path])`, runs in the one window a crash\n   326\t   can interrupt — after the temp is synced, before the rename — so a\n   327\t   test can interrupt the replacement there; a throw leaves the target\n   328\t   exactly as it was.\"\n   329\t  ([dir name text] (atomic-replace! dir name text {}))\n   330\t  ([dir name text {:keys [before-rename]}]\n   331\t   (let [target (str dir \"/\" name)\n   332\t         temp (str dir \"/\" name \".tmp-\" (random-uuid))]\n   333\t     #?(:cljd (try (.writeAsStringSync (dart-io/File. temp) text .flush true)\n   334\t                   (when before-rename (before-rename temp))\n   335\t                   (.renameSync (dart-io/File. temp) target)\n   336\t                   (catch Object e\n   337\t                     (throw (ex-info (str \"cannot replace \" target \": \" e)\n   338\t                                     {:dir dir :target target}\n   339\t                                     e))))\n   340\t        :clj (try (with-open [out (java.io.FileOutputStream. ^String temp)]\n   341\t                    (.write out (.getBytes ^String text \"UTF-8\"))\n   342\t                    (.flush out)\n   343\t                    (.sync (.getFD out)))\n   344\t                  (when before-rename (before-rename temp))\n   345\t                  (java.nio.file.Files/move\n   346\t                    (java.nio.file.Paths/get temp (make-array String 0))\n   347\t                    (java.nio.file.Paths/get target (make-array String 0))\n   348\t                    (into-array java.nio.file.StandardCopyOption\n   349\t                                [java.nio.file.StandardCopyOption/ATOMIC_MOVE\n   350\t                                 java.nio.file.StandardCopyOption/REPLACE_EXISTING]))\n   351\t                  (sync-directory! dir)\n   352\t                  (catch Throwable e\n   353\t                    (throw (ex-info (str \"cannot replace \" target \": \" e)\n   354\t                                    {:dir dir :target target}\n   355\t                                    e))))\n   356\t        :cljs (let [fs (js/require \"fs\")]\n   357\t                (try (let [fd (.openSync ^js fs temp \"w\")]\n   358\t                       (.writeSync ^js fs fd text)\n   359\t                       (.fsyncSync ^js fs fd)\n   360\t                       (.closeSync ^js fs fd))\n   361\t                     (when before-rename (before-rename temp))\n   362\t                     (.renameSync ^js fs temp target)\n   363\t                     (sync-directory! fs dir)\n   364\t                     (catch :default e\n   365\t                       (throw (ex-info (str \"cannot replace \" target \": \" e)\n   366\t                                       {:dir dir :target target}\n   367\t                                       e)))))))))\n   368\t\n   369\t\n   370\t(defn read-file-text\n   371\t  \"The file `<dir>/<name>` as text, or nil when absent — the public read\n   372\t   the store's HEAD parsing uses.\"\n   373\t  [dir name]\n   374\t  (read-text! (str dir \"/\" name)))\n   210\t  ([dir] (file-refusal (host-file-support) dir))\n   211\t  ([capable? dir]\n   212\t   (or (when-not capable? unsupported-host-text)\n   213\t       (dir-refusal dir))))\n   214\t\n   215\t\n   216\t;; =============================================================================\n   217\t;; HEAD — the durable root pointer, and the snapshot it names\n   218\t;; =============================================================================\n   219\t\n   220\t(defn- head-record\n   221\t  \"The text of one HEAD record: the version and the manifest address,\n   222\t   written whole and replaced whole.\"\n   223\t  [manifest-address]\n   224\t  (str (pr-str {:version head-version :manifest manifest-address}) \"\\n\"))\n   225\t\n   226\t\n   227\t(defn- read-edn\n   228\t  [text]\n   229\t  #?(:cljd (edn/read-string text)\n   230\t     :clj (edn/read-string text)\n   231\t     :cljs (reader/read-string text)))\n   232\t\n   233\t\n   234\t(defn- recovered-head\n   235\t  \"The manifest address HEAD names, or nil for an empty index.  A missing\n   236\t   file is an empty index; a file that is not exactly the versioned\n   237\t   record naming a content address is a corrupt pointer, and a corrupt\n   238\t   pointer refuses startup rather than pretending there was no index.\"\n   239\t  [dir]\n   240\t  (if-some [text (fs/read-file-text dir head-name)]\n   241\t    (let [head (try (read-edn text)\n   242\t                    (catch #?(:cljd Object\n   243\t                              :clj Exception\n   244\t                              :cljs :default)\n   245\t                           e\n   246\t                      (throw (ex-info (str \"the HEAD at \" dir\n   247\t                                           \" is not a readable record: \"\n   248\t                                           (error-text e))\n   249\t                                      {:dir dir :head text}\n   250\t                                      e))))]\n   251\t      (when-not (and (map? head)\n   252\t                     (= head-version (:version head))\n   253\t                     (jing/segment-address? (:manifest head)))\n   254\t        (throw (ex-info (str \"the HEAD at \" dir \" is not a version-\"\n   255\t                             head-version\n   256\t                             \" record naming a manifest address\")\n   257\t                        {:dir dir :head head})))\n   258\t      (:manifest head))\n   259\t    nil))\n   260\t\n   261\t\n   262\t(defn- validated-snapshot\n   263\t  \"The datoms of the snapshot HEAD names, walked eagerly through the\n   264\t   opened store — the design's full read-manifest and read-datoms\n   265\t   traversal, over every index root the manifest names, not only EAVT:\n   266\t   each of the four trees must read back whole and cover exactly the\n   267\t   manifest's `:count` datoms.  A missing or invalid manifest, or any\n   268\t   unreadable index node, refuses startup here; never a silent empty\n   269\t   index.\"\n   270\t  [store dir manifest-address]\n   271\t  (try\n   272\t    (let [manifest (dao.index/read-manifest store manifest-address)\n   273\t          walked (into {}\n   274\t                       (map (fn [[index root]]\n   275\t                              [index (vec (dao.index/walk-index-datoms\n   276\t                                            store root))]))\n   277\t                       (:indexes manifest))]\n   278\t      (doseq [[index datoms] walked]\n   279\t        (when-not (= (:count manifest) (count datoms))\n   280\t          (throw (ex-info (str \"the \" (name index) \" index covers \"\n   281\t                               (count datoms) \" datoms, not the manifest's \"\n   282\t                               (:count manifest))\n   283\t                          {:index index}))))\n   284\t      (:eavt walked))\n   285\t    (catch #?(:cljd Object\n   286\t              :clj Throwable\n   287\t              :cljs :default)\n   288\t           e\n   289\t      (throw (ex-info (str \"the durable index at \" dir \" is corrupt: \"\n   290\t                           (error-text e))\n   291\t                      {:dir dir :manifest manifest-address}\n   292\t                      e)))))\n   293\t\n   294\t\n   295\t(defn- open-locked-dir\n   296\t  \"Open the durable directory as its one owner: take the lock before\n   297\t   anything else in the directory is touched, then open the content log,\n   298\t   read HEAD, and walk the snapshot it names.  Every failure after the\n   299\t   lock closes the content log it opened and releases the lock again, so\n   300\t   a refused startup never leaves this process holding a directory it\n   301\t   did not open.\"\n   302\t  [dir]\n   303\t  (let [lock (fs/lock! dir)\n   304\t        opened (volatile! nil)]\n   305\t    (try\n   306\t      (let [handle (try (jing.file/create-content-file (content-path dir))\n   307\t                        (catch #?(:cljd Object\n   308\t                                  :clj Exception\n   309\t                                  :cljs :default)\n   310\t                               e\n   311\t                          (throw (ex-info (str \"cannot open the index store at \"\n   312\t                                               (content-path dir) \": \"\n   313\t                                               (error-text e))\n   314\t                                          {:dir dir}\n   315\t                                          e))))\n   316\t            _ (vreset! opened handle)\n   317\t            manifest (recovered-head dir)\n   318\t            datoms (when manifest\n   319\t                     (validated-snapshot handle dir manifest))]\n   320\t        {:handle handle\n   321\t         :lock lock\n   322\t         :recovery {:manifest manifest\n   323\t                    :datoms datoms}})\n   324\t      (catch #?(:cljd Object\n   325\t                :clj Throwable\n   326\t                :cljs :default)\n   327\t             e\n   328\t        (when-some [close-content! (:close-fn @opened)]\n   329\t          (try (close-content!)\n   330\t               (catch #?(:cljd Object\n   331\t                         :clj Throwable\n   332\t                         :cljs :default)\n   333\t                      _\n   334\t                 nil)))\n   335\t        (fs/unlock! lock)\n   336\t        (throw e)))))\n   337\t\n   338\t\n   339\t(defn lock-releasing-close\n   340\t  \"The durable handle's `:close-fn`: close the content log, then release\n   341\t   the directory lock `lock` — released even when the close throws, so a\n   342\t   failed close never keeps a live process holding the directory.\"\n   343\t  [close-content! lock]\n   344\t  (fn []\n   345\t    (try\n   346\t      (close-content!)\n   347\t      (finally\n   348\t        (fs/unlock! lock)))))\n   349\t\n   350\t\n   351\t(defn open\n   352\t  \"Open the store `spec` names and keep it plain: `:mem` (or nil) is a\n   353\t   fresh in-memory `dao.jing` store; `{:type :file :dir dir}` is the\n   354\t   durable content log at `<dir>/content.jing`, opened once here and\n   355\t   carried by the shell for its lifetime.  A spec this build cannot open\n   356\t   is refused with its reason.\n   357\t\n   358\t   The durable open is exclusive and validating.  The directory lock is\n   359\t   acquired before the content log or HEAD is touched — a second owner\n   360\t   is refused naming the directory — and every failure after it releases\n   361\t   the lock again.  HEAD is read and the snapshot it names walked in\n   362\t   full: an absent HEAD is an empty index; a malformed HEAD or a corrupt\n   363\t   snapshot refuses startup rather than starting empty.\n   364\t\n   365\t   Beside the plain byte-store fns, the durable handle carries what its\n   366\t   lifecycle owns: `:close-fn`, wrapped to release the lock with the\n   367\t   content log; `:head-fn`, `(fn [manifest-address])`, the atomic HEAD\n   368\t   write a round performs after its manifest is read back; `:recovery`,\n   369\t   `{:manifest <address or nil> :datoms <the walked snapshot or nil>}`,\n   370\t   exposed for the rehydration slice; and `:durable-dir`, the directory\n   371\t   an operator's refusal can name.\"\n   372\t  [spec]\n   373\t  (let [checked (checked-spec spec)]\n   374\t    (if (= :mem checked)\n   375\t      (jing.mem/create-content-mem)\n   376\t      (let [dir (:dir checked)]\n   377\t        (if-some [refusal (file-refusal dir)]\n   378\t          (throw (ex-info refusal {:dir dir}))\n   379\t          (let [{:keys [handle lock recovery]} (open-locked-dir dir)]\n   380\t            (assoc handle\n   381\t                   :close-fn (lock-releasing-close (:close-fn handle) lock)\n   382\t                   :head-fn (fn publish-head!\n   383\t                              [manifest-address]\n   384\t                              (fs/atomic-replace!\n   385\t                                dir head-name\n   386\t                                (head-record manifest-address)))\n   387\t                   :recovery recovery\n   388\t                   :durable-dir dir)))))))\n   389\t\n   390\t\n   285\t\n   286\t(defn- valid-manifest?\n   287\t  \"A conforming manifest is exactly {:indexes {:eavt ... :aevt ... :avet\n   288\t   ... :vaet ...} :count n :branching-factor n}, each index address either\n   289\t   nil when count is zero or a registered :segment/<algorithm>-... content\n   290\t   address when count is positive. The B-tree branching factor is at least\n   291\t   two.\"\n   292\t  [manifest]\n   293\t  (and (map? manifest)\n   294\t       (= #{:indexes :count :branching-factor} (set (keys manifest)))\n   295\t       (map? (:indexes manifest))\n   296\t       (= #{:eavt :aevt :avet :vaet} (set (keys (:indexes manifest))))\n   297\t       (integer? (:count manifest))\n   298\t       (not (neg? (:count manifest)))\n   299\t       (integer? (:branching-factor manifest))\n   300\t       (<= 2 (:branching-factor manifest))\n   301\t       (if (zero? (:count manifest))\n   302\t         (every? nil? (vals (:indexes manifest)))\n   303\t         (every? jing/segment-address? (vals (:indexes manifest))))))\n   304\t\n   305\t\n   306\t(defn read-manifest\n   307\t  \"Retrieve the manifest stored at a content address. Throws on a missing\n   308\t   address and on a stored value that is not a conforming manifest.\"\n   309\t  [content-store manifest-address]\n   310\t  (let [manifest (jing/get content-store manifest-address content-missing)]\n   311\t    (when (identical? manifest content-missing)\n   312\t      (throw (ex-info \"missing index manifest\" {:address manifest-address})))\n   313\t    (when-not (valid-manifest? manifest)\n   314\t      (throw (ex-info \"invalid index manifest\"\n   315\t                      {:address manifest-address, :manifest manifest})))\n   316\t    (when-not (jing/segment-matches? manifest-address manifest)\n   317\t      (throw (ex-info \"index manifest content address mismatch\"\n   318\t                      {:expected manifest-address,\n   319\t                       :actual (let [algo (try\n   320\t                                            (jing/segment-algorithm\n   321\t                                              manifest-address)\n   322\t                                            (catch #?(:cljd Object\n   323\t                                                      :clj Throwable\n   324\t                                                      :cljs :default)\n   325\t                                                   _\n   326\t                                              jing/default-hash-algorithm))]\n   327\t                                 (jing/segment-key manifest {:algorithm algo})),\n   328\t                       :manifest manifest})))\n   329\t    manifest))\n   330\t\n   331\t\n   332\t(defn read-datoms\n   333\t  \"Eagerly read every datom in the EAVT index of a published manifest, in\n   334\t   index order, by walking the node graph with plain `jing/get`. Takes the\n   335\t   manifest's content address; an empty index reads as ().\"\n   336\t  [content-store manifest-address]\n   337\t  (let [manifest (read-manifest content-store manifest-address)]\n   338\t    (vec (walk-index-datoms content-store (:eavt (:indexes manifest))))))\n   339\t\n   340\t\n   341\t(defn restored-indexes\n   342\t  \"Lazily-loaded {:eavt :aevt :avet :vaet} dao.data.btree sets over a\n   343\t   published manifest (`{:indexes {...} :count n :branching-factor n}`).\n   344\t   Nothing is fetched until a query traverses; slice (subseq-from) then\n   345\t   loads only the seek path plus the matching range. Works on every\n","exit_code":0,"status":"completed"}}
