{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/rpc.cljc | sed -n '1,380p'\"","aggregated_output":"     1\t(ns dao.stream.rpc\n     2\t  \"Transport-neutral, polling RPC state machines for DaoStream v2.\n     3\t\n     4\t   This layer deliberately owns no socket, scheduler, atom, promise, callback,\n     5\t   retry policy, or transport registry.  A composition supplies two explicit\n     6\t   handles (a request writer and a response reader), owns the returned state,\n     7\t   and chooses when to step `request!` and `poll!`.\n     8\t\n     9\t   The request/answer vocabulary below is owned by this namespace, not by\n    10\t   `dao.stream.apply`: a request is `{:dao.stream.rpc/id\n    11\t   :dao.stream.rpc/op :dao.stream.rpc/args}` and an answer is `{:dao.stream.rpc/id\n    12\t   :dao.stream.rpc/ok <value>}` or `{:dao.stream.rpc/id\n    13\t   :dao.stream.rpc/error {:dao.stream.rpc/code :dao.stream.rpc/message}}`.\n    14\t   Ids are self-minted random safe integers, not a sequential counter: callers\n    15\t   sharing one answers stream must not collide on a caller-chosen id\n    16\t   (docs/design/dao.stream.remote.md, section 5).\"\n    17\t  (:require [dao.stream :as stream]))\n    18\t\n    19\t\n    20\t;; =============================================================================\n    21\t;; Public data vocabulary\n    22\t;; =============================================================================\n    23\t\n    24\t(def max-safe-id\n    25\t  \"Largest integer that remains exactly representable by every supported host.\"\n    26\t  9007199254740991)\n    27\t\n    28\t\n    29\t(def event-key :dao.stream.rpc/event)\n    30\t(def response-key :dao.stream.rpc/response)\n    31\t(def diagnostic-key :dao.stream.rpc/diagnostic)\n    32\t(def code-key :dao.stream.rpc/code)\n    33\t\n    34\t\n    35\t(def max-id-retries\n    36\t  \"Bound on re-rolling a self-minted id after a collision, before allocation\n    37\t   fails through the existing terminal path.\"\n    38\t  8)\n    39\t\n    40\t\n    41\t(defn response-event\n    42\t  [response]\n    43\t  {event-key :dao.stream.rpc/response response-key response})\n    44\t\n    45\t\n    46\t(defn diagnostic-event\n    47\t  ([code]\n    48\t   (diagnostic-event code nil))\n    49\t  ([code value]\n    50\t   {event-key :dao.stream.rpc/diagnostic\n    51\t    diagnostic-key {code-key code\n    52\t                    :dao.stream.rpc/value value}}))\n    53\t\n    54\t\n    55\t(defn ignore-event\n    56\t  []\n    57\t  {event-key :dao.stream.rpc/ignore})\n    58\t\n    59\t\n    60\t(defn safe-id?\n    61\t  \"True for an integer which round-trips without precision loss across CLJ,\n    62\t   CLJS, and CLJD.  IDs are routing tokens, not application values.\"\n    63\t  [id]\n    64\t  (and (integer? id) (<= 0 id max-safe-id)))\n    65\t\n    66\t\n    67\t;; =============================================================================\n    68\t;; Request/answer value vocabulary owned by this namespace\n    69\t;; =============================================================================\n    70\t\n    71\t(defn request-value\n    72\t  [id op args]\n    73\t  {:dao.stream.rpc/id id :dao.stream.rpc/op op :dao.stream.rpc/args args})\n    74\t\n    75\t\n    76\t(defn request-value?\n    77\t  [v]\n    78\t  (and (map? v)\n    79\t       (safe-id? (:dao.stream.rpc/id v))\n    80\t       (keyword? (:dao.stream.rpc/op v))\n    81\t       (vector? (:dao.stream.rpc/args v))))\n    82\t\n    83\t\n    84\t(defn request-id [v] (:dao.stream.rpc/id v))\n    85\t(defn request-op [v] (:dao.stream.rpc/op v))\n    86\t(defn request-args [v] (:dao.stream.rpc/args v))\n    87\t\n    88\t\n    89\t(defn success-answer\n    90\t  [id value]\n    91\t  {:dao.stream.rpc/id id :dao.stream.rpc/ok value})\n    92\t\n    93\t\n    94\t(defn error-answer\n    95\t  [id code message]\n    96\t  {:dao.stream.rpc/id id\n    97\t   :dao.stream.rpc/error {:dao.stream.rpc/code code\n    98\t                          :dao.stream.rpc/message message}})\n    99\t\n   100\t\n   101\t(defn answer?\n   102\t  [v]\n   103\t  (and (map? v)\n   104\t       (safe-id? (:dao.stream.rpc/id v))\n   105\t       (let [ok? (contains? v :dao.stream.rpc/ok)\n   106\t             err? (contains? v :dao.stream.rpc/error)]\n   107\t         (and (or ok? err?) (not (and ok? err?))))))\n   108\t\n   109\t\n   110\t(defn answer-id [answer] (:dao.stream.rpc/id answer))\n   111\t(defn answer-ok [answer] (:dao.stream.rpc/ok answer))\n   112\t(defn answer-error [answer] (:dao.stream.rpc/error answer))\n   113\t\n   114\t\n   115\t(defn answer-ok?\n   116\t  [answer]\n   117\t  (contains? answer :dao.stream.rpc/ok))\n   118\t\n   119\t\n   120\t;; =============================================================================\n   121\t;; Explicit client state\n   122\t;; =============================================================================\n   123\t\n   124\t(defn- random-safe-id\n   125\t  []\n   126\t  #?(:clj (long (* max-safe-id (rand)))\n   127\t     :cljs (Math/floor (* max-safe-id (rand)))\n   128\t     :cljd (.floor ^double (* max-safe-id (rand)))))\n   129\t\n   130\t\n   131\t(defn client-state\n   132\t  \"Create caller-owned RPC client state.\n   133\t\n   134\t   `writer` is the request path. `reader` and `response-cursor` are the\n   135\t   independent response path.  No cursor is fabricated here; a caller\n   136\t   over a dao.stream.remote reflection passes `stream/anchor-newest`\n   137\t   (the request/response service's own mint, docs/design/\n   138\t   dao.stream.remote.md section 5) and `poll!` resolves it, retrying\n   139\t   while the reflection answers a retryable mint -- the same pattern\n   140\t   `dao.jing.content.step/mint-cursor` uses for the content client.\"\n   141\t  ([writer reader response-cursor]\n   142\t   (client-state writer reader response-cursor {}))\n   143\t  ([writer reader response-cursor _opts]\n   144\t   {:writer writer\n   145\t    :reader reader\n   146\t    :cursor response-cursor\n   147\t    :outstanding {}\n   148\t    :unsent nil\n   149\t    :completed []\n   150\t    :diagnostics []\n   151\t    :terminal nil}))\n   152\t\n   153\t\n   154\t(def init-client client-state)\n   155\t\n   156\t\n   157\t(defn- rpc-result\n   158\t  [outcome state & {:as extra}]\n   159\t  (merge {:dao.stream.rpc/outcome outcome\n   160\t          :dao.stream.rpc/state state}\n   161\t         extra))\n   162\t\n   163\t\n   164\t(defn- valid-operation-result\n   165\t  [op result]\n   166\t  (if (stream/valid-outcome? op result)\n   167\t    result\n   168\t    {:dao.stream/outcome :dao.stream/transport-error\n   169\t     :dao.stream/error :dao.stream/invalid-operation-result}))\n   170\t\n   171\t\n   172\t(defn- completion\n   173\t  [request & {:keys [response reason]}]\n   174\t  (cond-> {:dao.stream.rpc/id (:id request)\n   175\t           :dao.stream.rpc/op (:op request)\n   176\t           :dao.stream.rpc/args (:args request)}\n   177\t    response (assoc :dao.stream.rpc/response response)\n   178\t    reason (assoc :dao.stream.rpc/reason reason)))\n   179\t\n   180\t\n   181\t(defn- append-completion\n   182\t  [state request & {:as fields}]\n   183\t  (update state :completed conj (apply completion request (mapcat identity fields))))\n   184\t\n   185\t\n   186\t(defn- append-diagnostic\n   187\t  [state code value]\n   188\t  (update state :diagnostics conj {code-key code\n   189\t                                   :dao.stream.rpc/value value}))\n   190\t\n   191\t\n   192\t(defn- ids-in-use?\n   193\t  [state id]\n   194\t  (or (= id (get-in state [:unsent :id]))\n   195\t      (contains? (:outstanding state) id)\n   196\t      (boolean (some #(= id (:dao.stream.rpc/id %)) (:completed state)))))\n   197\t\n   198\t\n   199\t;; Defined below with the other completion bookkeeping; allocation failure is\n   200\t;; a terminal transition and owes the same conservative loss as every other.\n   201\t(declare lose-outstanding)\n   202\t\n   203\t\n   204\t(defn- allocation-failure\n   205\t  [state code]\n   206\t  (let [state (-> state\n   207\t                  (lose-outstanding :dao.stream.rpc/allocator-error true)\n   208\t                  (append-diagnostic code nil))]\n   209\t    (rpc-result :dao.stream.rpc/allocator-error state\n   210\t                :dao.stream.rpc/diagnostic (last (:diagnostics state)))))\n   211\t\n   212\t\n   213\t(defn- allocate-request\n   214\t  \"Self-mint a random safe id in [0, max-safe-id], re-rolling on a collision\n   215\t   with an id already in use by this state, up to `max-id-retries` times.\n   216\t   This is the request/answer service's own id space (docs/design/\n   217\t   dao.stream.remote.md section 5): callers sharing one answers stream must\n   218\t   not collide on a caller-chosen id, so the id is not a sequential counter.\"\n   219\t  [state op args]\n   220\t  (loop [attempt 0]\n   221\t    (if (>= attempt max-id-retries)\n   222\t      (allocation-failure state :dao.stream.rpc/id-collision)\n   223\t      (let [id (random-safe-id)]\n   224\t        (if (ids-in-use? state id)\n   225\t          (recur (inc attempt))\n   226\t          (let [request {:id id\n   227\t                         :op op\n   228\t                         :args args\n   229\t                         :encoded (request-value id op args)}]\n   230\t            (rpc-result :dao.stream.rpc/allocated\n   231\t                        (assoc state :unsent request))))))))\n   232\t\n   233\t\n   234\t(defn- accept-unsent\n   235\t  [state request]\n   236\t  (-> state\n   237\t      (assoc :unsent nil)\n   238\t      (assoc-in [:outstanding (:id request)]\n   239\t                {:op (:op request) :args (:args request)})))\n   240\t\n   241\t\n   242\t(defn- attempt-unsent\n   243\t  [state]\n   244\t  (let [request (:unsent state)\n   245\t        append-result (valid-operation-result\n   246\t                        :append!\n   247\t                        (stream/append! (:writer state) (:encoded request)))\n   248\t        outcome (:dao.stream/outcome append-result)]\n   249\t    (case outcome\n   250\t      :dao.stream/ok\n   251\t      (rpc-result :dao.stream.rpc/requested\n   252\t                  (accept-unsent state request)\n   253\t                  :dao.stream.rpc/id (:id request)\n   254\t                  :dao.stream.rpc/append append-result)\n   255\t\n   256\t      :dao.stream/full\n   257\t      (rpc-result :dao.stream.rpc/pending-request state\n   258\t                  :dao.stream.rpc/id (:id request)\n   259\t                  :dao.stream.rpc/append append-result)\n   260\t\n   261\t      (:dao.stream/closed :dao.stream/invalid-value :dao.stream/transport-error)\n   262\t      (let [state (-> state\n   263\t                      (assoc :unsent nil)\n   264\t                      (append-completion request :reason outcome))]\n   265\t        (rpc-result :dao.stream.rpc/request-undeliverable state\n   266\t                    :dao.stream.rpc/id (:id request)\n   267\t                    :dao.stream.rpc/reason outcome\n   268\t                    :dao.stream.rpc/append append-result))\n   269\t\n   270\t      ;; A malformed writer answer becomes transport-error in\n   271\t      ;; valid-operation-result, so this branch is defensive only.\n   272\t      (let [state (-> state\n   273\t                      (assoc :unsent nil)\n   274\t                      (append-completion request :reason :dao.stream/transport-error))]\n   275\t        (rpc-result :dao.stream.rpc/request-undeliverable state\n   276\t                    :dao.stream.rpc/id (:id request)\n   277\t                    :dao.stream.rpc/reason :dao.stream/transport-error\n   278\t                    :dao.stream.rpc/append append-result)))))\n   279\t\n   280\t\n   281\t(defn request!\n   282\t  \"Attempt one request append, returning an explicit next state.\n   283\t\n   284\t   If a previous append was full, this retries the exact already-allocated\n   285\t   envelope and ignores `op`/`args`; it never allocates a replacement id.  The\n   286\t   function makes one append attempt at most and never spins on `:full`.\"\n   287\t  [state op args]\n   288\t  (cond\n   289\t    (:terminal state)\n   290\t    (rpc-result :dao.stream.rpc/terminal state)\n   291\t\n   292\t    (:unsent state)\n   293\t    (attempt-unsent state)\n   294\t\n   295\t    (not (and (keyword? op) (vector? args)))\n   296\t    (let [state (append-diagnostic state :dao.stream.rpc/invalid-request\n   297\t                                   {:op op :args args})]\n   298\t      (rpc-result :dao.stream.rpc/invalid-request state\n   299\t                  :dao.stream.rpc/diagnostic (last (:diagnostics state))))\n   300\t\n   301\t    :else\n   302\t    (let [allocated (allocate-request state op args)]\n   303\t      (if (= :dao.stream.rpc/allocated (:dao.stream.rpc/outcome allocated))\n   304\t        (attempt-unsent (:dao.stream.rpc/state allocated))\n   305\t        allocated))))\n   306\t\n   307\t\n   308\t(defn unsent?\n   309\t  \"True while an allocated request is still owed one accepted append.  A caller\n   310\t   that allocates ids from this state must not submit new work while it holds:\n   311\t   `request!` retries the unsent envelope and ignores the operation it is given.\"\n   312\t  [state]\n   313\t  (some? (:unsent state)))\n   314\t\n   315\t\n   316\t(defn abandon-unsent\n   317\t  \"Give up on an allocated-but-unsent request, appending its completion with\n   318\t   `reason`.\n   319\t\n   320\t   A composition that changes what the writer *is* — an operator disconnect, a\n   321\t   rebind onto a fresh attachment — owns the decision that the retained\n   322\t   envelope no longer belongs to the new binding.  Abandoning it here reports\n   323\t   the loss on the ordinary completion path, so it is neither silently dropped\n   324\t   nor resent in place of the caller's next request.\"\n   325\t  ([state] (abandon-unsent state :dao.stream.rpc/abandoned))\n   326\t  ([state reason]\n   327\t   (if-let [request (:unsent state)]\n   328\t     (-> state\n   329\t         (assoc :unsent nil)\n   330\t         (append-completion request :reason reason))\n   331\t     state)))\n   332\t\n   333\t\n   334\t;; =============================================================================\n   335\t;; Response decoding and correlation\n   336\t;; =============================================================================\n   337\t\n   338\t(defn- normalize-event\n   339\t  [value]\n   340\t  (cond\n   341\t    (nil? value) (ignore-event)\n   342\t    (answer? value) (response-event value)\n   343\t    (and (map? value) (keyword? (get value event-key))) value\n   344\t    :else (diagnostic-event :dao.stream.rpc/malformed-response value)))\n   345\t\n   346\t\n   347\t(defn- decode-value\n   348\t  [_state value]\n   349\t  (try\n   350\t    (normalize-event value)\n   351\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   352\t      (diagnostic-event :dao.stream.rpc/decode-error value))))\n   353\t\n   354\t\n   355\t(defn- lose-outstanding\n   356\t  [state reason terminal?]\n   357\t  (let [state (reduce (fn [s [id request]]\n   358\t                        (append-completion s (assoc request :id id) :reason reason))\n   359\t                      state\n   360\t                      (:outstanding state))]\n   361\t    (cond-> (assoc state :outstanding {})\n   362\t      terminal? (assoc :terminal reason))))\n   363\t\n   364\t\n   365\t(defn handle-event\n   366\t  \"Apply one decoded RPC event to explicit client state.\n   367\t\n   368\t   `response-event`, `diagnostic-event`, and `ignore-event` are the events a\n   369\t   composition constructs; a bare answer value is also accepted.  This\n   370\t   function has no cursor operation and is useful for testing adapters\n   371\t   independently from a response medium.\"\n   372\t  [state event]\n   373\t  (let [event (normalize-event event)\n   374\t        kind (get event event-key)]\n   375\t    (cond\n   376\t      ;; A terminal binding cannot complete an old request later.  Keep the\n   377\t      ;; event as diagnostic data rather than silently treating it as a reply.\n   378\t      (:terminal state)\n   379\t      (let [state (append-diagnostic state :dao.stream.rpc/event-after-terminal event)]\n   380\t        (rpc-result :dao.stream.rpc/diagnostic state\n","exit_code":0,"status":"completed"}}
