{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/connect.cljc | sed -n '270,560p'\"","aggregated_output":"   270\t             raw-path (subs rest-url end)\n   271\t             colon (str/last-index-of authority \":\")\n   272\t             host (if colon (subs authority 0 colon) authority)\n   273\t             port (if colon (parse-port (subs authority (inc colon))) default-port)]\n   274\t         (cond\n   275\t           (str/starts-with? authority \"[\")\n   276\t           (failure :yin.repl.connect/invalid-url\n   277\t                    \"bracketed IPv6 authorities are not part of this slice\")\n   278\t\n   279\t           (str/blank? host)\n   280\t           (failure :yin.repl.connect/invalid-url\n   281\t                    (str \"connect URL has no host: \"\n   282\t                         (pr-str (data/summarize url diagnostic-bounds))))\n   283\t\n   284\t           (nil? port)\n   285\t           (failure :yin.repl.connect/invalid-url\n   286\t                    (str \"connect URL port must be a positive integer: \"\n   287\t                         (pr-str (data/summarize url diagnostic-bounds))))\n   288\t\n   289\t           :else\n   290\t           (let [descriptor {:dao.stream/type ws/transport-type\n   291\t                             :dao.stream/identity (or identity service-identity)\n   292\t                             :ws/host host\n   293\t                             :ws/port port\n   294\t                             :ws/path (repl-target raw-path)}]\n   295\t             (if (ws/descriptor? descriptor)\n   296\t               {outcome-key :yin.repl.connect/parsed descriptor-key descriptor}\n   297\t               (failure :yin.repl.connect/invalid-url\n   298\t                        (str \"connect URL does not name a servable stream: \"\n   299\t                             (pr-str (data/summarize url diagnostic-bounds))))))))))))\n   300\t\n   301\t\n   302\t;; =============================================================================\n   303\t;; The two-reflection boundary\n   304\t;; =============================================================================\n   305\t\n   306\t(defn- mint\n   307\t  [handle anchor]\n   308\t  (let [result (stream/cursor handle anchor)]\n   309\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   310\t      (:dao.stream/cursor result))))\n   311\t\n   312\t\n   313\t(defn- remote-descriptor\n   314\t  [channel identity]\n   315\t  {:dao.stream/type :dao.stream/remote\n   316\t   :dao.stream/identity identity\n   317\t   :dao.stream/channel channel})\n   318\t\n   319\t\n   320\t(defn- attacher\n   321\t  [traffic connect!]\n   322\t  (ws/make-attacher {:traffic {:dao.stream/handle traffic\n   323\t                               :dao.stream/surface #{:writer}}\n   324\t                     :admission traffic-admission\n   325\t                     :connect! connect!}))\n   326\t\n   327\t\n   328\t(defn- attach-outcome-message\n   329\t  [url result]\n   330\t  (case (:dao.stream/outcome result)\n   331\t    :dao.stream/invalid-descriptor\n   332\t    (str \"The boundary refused the descriptor for \" url)\n   333\t\n   334\t    :dao.stream/transport-error\n   335\t    (str \"Could not start connecting to \" url\n   336\t         \"; this is a local reachability failure and may succeed on retry\")\n   337\t\n   338\t    (str \"Attaching to \" url \" answered \" (pr-str (:dao.stream/outcome result)))))\n   339\t\n   340\t\n   341\t(defn- fresh-dial\n   342\t  \"Compose one dial over a fresh traffic medium, its own fresh `attach!`\n   343\t   bound to that medium, and a fresh channel ring, before any attach.  A\n   344\t   reattachment composes a fresh dial with a fresh cursor, per\n   345\t   `dao.stream.ws-project/dial`'s own contract, and `attach!` is scoped to\n   346\t   the traffic medium it deposits into, so it must be rebuilt alongside\n   347\t   it -- reusing an old `attach!` over a new traffic medium would deposit\n   348\t   into the wrong buffer.\"\n   349\t  [host]\n   350\t  (let [traffic (:dao.stream/handle\n   351\t                  (ring/create! {:dao.stream/type ring/transport-type\n   352\t                                 ring/capacity-key traffic-capacity}))\n   353\t        attach! (try (attacher traffic (:connect! host))\n   354\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))\n   355\t        cursor (mint traffic stream/anchor-newest)\n   356\t        ring (:dao.stream/handle\n   357\t               (ring/create! {:dao.stream/type ring/transport-type\n   358\t                              ring/capacity-key traffic-capacity}))]\n   359\t    (when (and (some? attach!) (some? cursor))\n   360\t      (ws-project/dial {:attach! attach!\n   361\t                        :traffic {:dao.stream/handle traffic}\n   362\t                        :cursor cursor\n   363\t                        :ring ring\n   364\t                        :table {}}))))\n   365\t\n   366\t\n   367\t(defn- attach-pair\n   368\t  \"Attach both `requests`/`answers` reflections through `dial`'s one link,\n   369\t   sharing it exactly as `dao.stream.remote.cljc`'s attacher requires.\n   370\t   Returns `[requests-result answers-result]`, the second nil once the\n   371\t   first fails.\"\n   372\t  [dial channel]\n   373\t  (let [requests-result\n   374\t        (ws-project/dial-attach! dial (remote-descriptor channel\n   375\t                                                          requests-identity))]\n   376\t    (if-not (= :dao.stream/ok (:dao.stream/outcome requests-result))\n   377\t      [requests-result nil]\n   378\t      [requests-result\n   379\t       (ws-project/dial-reflect! dial (remote-descriptor channel\n   380\t                                                          answers-identity))])))\n   381\t\n   382\t\n   383\t(defn open\n   384\t  \"Dial one WebSocket channel and attach both reflections, returning\n   385\t   immediately.  `attach!` over `dao.stream.remote` answers ok at once --\n   386\t   the contract's deferred remote confirmation -- so a successful result\n   387\t   is reported `:established` without waiting on any further transport\n   388\t   event.  The RPC client's response cursor is the `:dao.stream/newest`\n   389\t   anchor; `rpc/poll!` resolves it, retrying while the answers reflection\n   390\t   answers a retryable mint.\"\n   391\t  [{:keys [url identity host]}]\n   392\t  (let [parsed (parse-url url {:identity identity})]\n   393\t    (if-not (= :yin.repl.connect/parsed (get parsed outcome-key))\n   394\t      parsed\n   395\t      (let [channel (get parsed descriptor-key)]\n   396\t        (if-not (host-common/adapter? host)\n   397\t          (failure :yin.repl.connect/no-host-adapter\n   398\t                   (host-common/missing-message \"(connect …) is not wired\"))\n   399\t          (let [dial (fresh-dial host)]\n   400\t            (if-not dial\n   401\t              (failure :yin.repl.connect/invalid-composition\n   402\t                       \"The client boundary composition was refused\")\n   403\t              (let [[requests-result answers-result]\n   404\t                    (attach-pair dial channel)]\n   405\t                (cond\n   406\t                  (not= :dao.stream/ok (:dao.stream/outcome requests-result))\n   407\t                  (failure :yin.repl.connect/attach-failed\n   408\t                           (attach-outcome-message url requests-result))\n   409\t\n   410\t                  (not= :dao.stream/ok (:dao.stream/outcome answers-result))\n   411\t                  (failure :yin.repl.connect/attach-failed\n   412\t                           (attach-outcome-message url answers-result))\n   413\t\n   414\t                  :else\n   415\t                  {outcome-key :yin.repl.connect/attached\n   416\t                   connection-key {:url url\n   417\t                                   :channel channel\n   418\t                                   :host host\n   419\t                                   :dial dial\n   420\t                                   :status :established\n   421\t                                   :detached-by nil}\n   422\t                   client-key (rpc/client-state\n   423\t                                (:dao.stream/handle requests-result)\n   424\t                                (:dao.stream/handle answers-result)\n   425\t                                stream/anchor-newest)})))))))))\n   426\t\n   427\t\n   428\t(defn step!\n   429\t  \"Drive this connection's dial one tick: its projection, so wire bytes the\n   430\t   host deposited onto the traffic medium reach the reflections' local\n   431\t   channel ring, then this end's own mirror step (a REPL client serves\n   432\t   nothing through it, but the composition is symmetric).  A caller's own\n   433\t   cadence must call this every tick it also polls the RPC client, or the\n   434\t   channel ring never receives anything the server sent -- reading a\n   435\t   reflection drains only the ring, never the traffic medium directly.\"\n   436\t  [connection]\n   437\t  (when-let [dial (:dial connection)]\n   438\t    (ws-project/dial-step! dial))\n   439\t  connection)\n   440\t\n   441\t\n   442\t(def terminal-statuses\n   443\t  \"Statuses observed from the RPC client's own `:terminal`.  They are\n   444\t   conclusions, so a later local action cannot overwrite them with an\n   445\t   intention.\"\n   446\t  #{:detached :ended :not-found :transport-error})\n   447\t\n   448\t\n   449\t(defn close!\n   450\t  \"Disconnect.  `close!` on the dialed channel's handle ends the connection;\n   451\t   the RPC client observes the loss on its next poll as `/detached`, which\n   452\t   is what keeps the connection reattachable.\n   453\t\n   454\t   Who asked is recorded, because the two detachments mean different things to\n   455\t   the shell: an operator `(disconnect)` returns ordinary input to local\n   456\t   evaluation, while an uninvited drop queues it until a reattachment decision\n   457\t   is made.  The terminal fact alone cannot tell them apart.\n   458\t\n   459\t   A status already observed is kept: `:closing` describes an intention, and\n   460\t   replacing an observed ending with it would lose the only record of how the\n   461\t   connection actually ended.\"\n   462\t  ([connection] (close! connection :operator))\n   463\t  ([connection by]\n   464\t   (when-let [ch (some-> (:dial connection) ws-project/channel)]\n   465\t     (stream/close! (:handle ch)))\n   466\t   (cond-> (assoc connection :detached-by by)\n   467\t     (not (contains? terminal-statuses (:status connection)))\n   468\t     (assoc :status :closing))))\n   469\t\n   470\t\n   471\t(defn operator-detached?\n   472\t  \"True while this connection is detached, or detaching, at the operator's own\n   473\t   request.\"\n   474\t  [connection]\n   475\t  (= :operator (:detached-by connection)))\n   476\t\n   477\t\n   478\t(defn reattachable?\n   479\t  \"True when the RPC client's terminal reason is the one reconnectable one.\"\n   480\t  [client]\n   481\t  (= :dao.stream.apply/detached (:terminal client)))\n   482\t\n   483\t\n   484\t(defn reattach\n   485\t  \"Reattach an existing connection: a fresh dial through the same host\n   486\t   adapter, both reflections attached again, then `rpc/rebind`.\n   487\t\n   488\t   The RPC client's response cursor and its collision-checked random id\n   489\t   allocator survive; only the writer and reader reflections change.\"\n   490\t  [connection client]\n   491\t  (if-not (reattachable? client)\n   492\t    (failure :yin.repl.connect/not-reattachable\n   493\t             (str \"Only a dropped connection reattaches; this one ended as \"\n   494\t                  (pr-str (:terminal client))))\n   495\t    (let [{:keys [url channel host]} connection\n   496\t          dial (fresh-dial host)]\n   497\t      (if-not dial\n   498\t        (failure :yin.repl.connect/invalid-composition\n   499\t                 \"The traffic medium minted no cursor\")\n   500\t        (let [[requests-result answers-result] (attach-pair dial channel)]\n   501\t          (cond\n   502\t            (not= :dao.stream/ok (:dao.stream/outcome requests-result))\n   503\t            (failure :yin.repl.connect/attach-failed\n   504\t                     (attach-outcome-message url requests-result))\n   505\t\n   506\t            (not= :dao.stream/ok (:dao.stream/outcome answers-result))\n   507\t            (failure :yin.repl.connect/attach-failed\n   508\t                     (attach-outcome-message url answers-result))\n   509\t\n   510\t            :else\n   511\t            {outcome-key :yin.repl.connect/reattached\n   512\t             connection-key (assoc connection\n   513\t                                   :dial dial\n   514\t                                   :status :established\n   515\t                                   :detached-by nil)\n   516\t             client-key (rpc/rebind client\n   517\t                                    (:dao.stream/handle requests-result)\n   518\t                                    (:dao.stream/handle answers-result))}))))))\n   519\t\n   520\t\n   521\t;; =============================================================================\n   522\t;; Terminal status, observed from the RPC client\n   523\t;; =============================================================================\n   524\t\n   525\t(defn- event\n   526\t  [kind text]\n   527\t  {event-key kind text-key text})\n   528\t\n   529\t\n   530\t(defn- terminal-transition\n   531\t  [connection terminal]\n   532\t  (case terminal\n   533\t    :dao.stream.apply/detached\n   534\t    [:detached (event :yin.repl.connect/detached\n   535\t                      (str \"Disconnected from \" (:url connection)\n   536\t                           \"; the served stream is untouched, so (connect \"\n   537\t                           (pr-str (:url connection)) \") reattaches\"))]\n   538\t\n   539\t    :dao.stream.apply/ended\n   540\t    [:ended (event :yin.repl.connect/ended\n   541\t                   (str \"The stream served at \" (:url connection)\n   542\t                        \" ended; there is nothing to reattach to\"))]\n   543\t\n   544\t    :dao.stream.apply/not-found\n   545\t    [:not-found (event :yin.repl.connect/not-found\n   546\t                       (str \"No stream is served at \"\n   547\t                            (:ws/path (:channel connection))\n   548\t                            \": the endpoint disclaimed it, so this is not \"\n   549\t                            \"retried\"))]\n   550\t\n   551\t    :dao.stream.apply/transport-error\n   552\t    [:transport-error\n   553\t     (event :yin.repl.connect/transport-error\n   554\t           (str \"Could not reach \" (:url connection)\n   555\t                \"; this is a reachability failure and may succeed on retry\"))]\n   556\t\n   557\t    nil))\n   558\t\n   559\t\n   560\t(defn observe-terminal\n","exit_code":0,"status":"completed"}}
