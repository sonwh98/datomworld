ped value.\"\n   332\t       [a]\n   333\t       (reset! (:running a) false)\n   334\t       (.join ^Thread (:ticker a) 2000)\n   335\t       (let [deadline (+ (System/currentTimeMillis) 5000)\n   336\t             final (loop [endpoint (serve/stop! @(:endpoint a))]\n   337\t                     (let [endpoint' (serve/step endpoint\n   338\t                                                 (System/currentTimeMillis))]\n   339\t                       (cond\n   340\t                         (serve/stopped? endpoint') endpoint'\n   341\t                         (< deadline (System/currentTimeMillis))\n   342\t                         (throw (ex-info\n   343\t                                  \"the endpoint never reached :stopped; its port may still be bound\"\n   344\t                                  {:status (:status endpoint')\n   345\t                                   :port (:port a)\n   346\t                                   :notices @(:notices a)}))\n   347\t                         :else (do (Thread/sleep 5) (recur endpoint')))))]\n   348\t         (reset! (:endpoint a) final)\n   349\t         final))\n   350\t\n   351\t\n   352\t     (clojure.test/use-fixtures :once\n   353\t       (fn [run]\n   354\t         (reset! process-a (start-process-a!))\n   355\t         (try (run)\n     1\t(ns yin.repl.embed-test\n     2\t  \"The embedding composition behind the Flutter REPL widget, with the host\n     3\t   listener injected as in `yin.repl.serve-test`.  Nothing here binds a port.\"\n     4\t  (:require [clojure.string :as str]\n     5\t            [clojure.test :refer [deftest is testing]]\n     6\t            [dao.stream :as stream]\n     7\t            [dao.stream.rpc :as rpc]\n     8\t            [dao.stream.ws :as ws]\n     9\t            [yin.repl.embed :as embed]))\n    10\t\n    11\t\n    12\t(defn- host\n    13\t  []\n    14\t  {:bind! (fn [config]\n    15\t            ((:deposit! config) :bind-succeeded\n    16\t                                {:host (:bind-host config) :port (:bind-port config)})\n    17\t            {:listener :injected})\n    18\t   :unbind! (fn [_resources deposit!]\n    19\t              (deposit! :stopped {:reason :requested})\n    20\t              nil)})\n    21\t\n    22\t\n    23\t(defn- socket\n    24\t  []\n    25\t  (let [sent (atom [])]\n    26\t    {:sent sent\n    27\t     :socket {:send! (fn [text] (swap! sent conj text) nil)\n    28\t              :close! (fn [_code _reason] nil)}}))\n    29\t\n    30\t\n    31\t(defn- last-answer\n    32\t  \"The last answer appended to the endpoint's shared answers medium.\"\n    33\t  [endpoint]\n    34\t  (loop [cursor (:dao.stream/cursor (stream/cursor (:answers endpoint)\n    35\t                                                   stream/anchor-oldest))\n    36\t         last-value nil]\n    37\t    (let [r (stream/next (:answers endpoint) cursor)]\n    38\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    39\t        (recur (:dao.stream/cursor r) (:dao.stream/value r))\n    40\t        last-value))))\n    41\t\n    42\t\n    43\t(defn- request!\n    44\t  \"Append one eval request directly onto the endpoint's requests medium,\n    45\t   as the mirror's own `:dao.stream/append!` answer would once a\n    46\t   reflection's write reaches it.\"\n    47\t  [endpoint id source]\n    48\t  (stream/append! (:requests endpoint) (rpc/request-value id :op/eval [source])))\n    49\t\n    50\t\n    51\t(defn- start\n    52\t  []\n    53\t  (embed/start {:port 7777\n    54\t                :advertised-host \"192.168.1.20\"\n    55\t                :primitives {'answer (fn [] 42)}\n    56\t                :host (host)}))\n    57\t\n    58\t\n    59\t(deftest a-wildcard-bind-with-an-advertised-host-binds\n    60\t  (let [endpoint (start)\n    61\t        [endpoint lines] (embed/step endpoint 1)\n    62\t        status (embed/status endpoint)]\n    63\t    (is (= :running (:status status)) \"the first step observed :bind-succeeded\")\n    64\t    (is (some #(str/starts-with? % \"Serving daostream:ws://192.168.1.20:7777/repl\") lines))\n    65\t    (is (= \"daostream:ws://192.168.1.20:7777/repl\" (:url status)))\n    66\t    (is (zero? (:clients status)))\n    67\t    (is (= \"listening\" (embed/status-text status)))))\n    68\t\n    69\t\n    70\t(deftest a-host-primitive-is-served-and-survives-reset\n    71\t  (let [[endpoint _] (embed/step (start) 1)\n    72\t        s (socket)\n    73\t        _accepted (ws/accept-connection! (:ws-endpoint endpoint) (:path endpoint)\n    74\t                                         (:socket s) 2)\n    75\t        [endpoint _] (embed/step endpoint 2)\n    76\t        [endpoint _] (embed/step endpoint 3)]\n    77\t    (is (= 1 (:clients (embed/status endpoint))) \"the session was adopted\")\n    78\t    (is (= \"client connected\" (embed/status-text (embed/status endpoint))))\n    79\t    (request! endpoint 0 \"(answer)\")\n    80\t    (let [[endpoint _] (embed/step endpoint 4)]\n    81\t      (is (= \"42\" (rpc/answer-ok (last-answer endpoint))))\n    82\t      (testing \"(reset) through the same session keeps the host primitive\"\n    83\t        (request! endpoint 1 \"(reset)\")\n    84\t        (let [[endpoint _] (embed/step endpoint 5)]\n    85\t          (request! endpoint 2 \"(answer)\")\n    86\t          (let [[endpoint _] (embed/step endpoint 6)]\n    87\t            (is (= 2 (rpc/answer-id (last-answer endpoint))))\n    88\t            (is (= \"42\" (rpc/answer-ok (last-answer endpoint))))))))))\n    89\t\n    90\t\n    91\t(deftest stop-then-stepping-reaches-stopped\n    92\t  (let [[endpoint _] (embed/step (start) 1)\n    93\t        endpoint (embed/stop endpoint)]\n    94\t    (is (= \"stopping\" (embed/status-text (embed/status endpoint))))\n    95\t    (is (false? (embed/stopped? endpoint)))\n    96\t    (let [endpoint (loop [endpoint endpoint\n    97\t                          now 2]\n    98\t                     (if (or (embed/stopped? endpoint) (< 10 now))\n    99\t                       endpoint\n   100\t                       (recur (first (embed/step endpoint now)) (inc now))))]\n   101\t      (is (true? (embed/stopped? endpoint)))\n   102\t      (is (= \"stopped\" (embed/status-text (embed/status endpoint)))))))\n   500\t                (append-ok! holder-facts grant)\n   501\t                (append-ok! holder-ticks (lease/tick {:ms 1})))\n   502\t          holder (lease/observe-grant (:holder composed-holder)\n   503\t                                      :grantor grant {:ms 1})]\n   504\t      (is (= grant (:grant holder))\n   505\t          \"H1: the holder observed the grantor-authored grant\")\n   506\t      (is (true? (lease/holding? holder {:ms 2})))\n   507\t      (is (false? (lease/due-to-renew? holder {:ms 4})))\n   508\t      (append-ok! holder-ticks (lease/tick {:ms 5}))\n   509\t      ;; the holder's control flow DRAINS its own tick medium for the\n   510\t      ;; reading (r4-r3/F3: the wiring is exercised as a medium, not\n   511\t      ;; only appended to)\n   512\t      (let [newest (get (last (drain-values holder-ticks))\n   513\t                        :dao.lease/reading)]\n   514\t        (is (= {:ms 5} newest)\n   515\t            \"the drained reading is the tick the driver deposited\")\n   516\t        (is (true? (lease/due-to-renew? holder newest))\n   517\t            \"due at the interval on its own tick stream\"))\n   518\t      (let [;; the renewal is appended to the holder's outbound writer --\n   519\t            ;; the judge's medium -- and recorded at the reading drained\n   520\t            ;; BEFORE the append\n   521\t            append (ds/append! (get-in composed-holder [:writer :handle])\n   522\t                               (lease/renewal :l1))\n   523\t            holder (lease/observe-renewal holder {:ms 5} append)]\n   524\t        (is (= :dao.stream/ok (:dao.stream/outcome append)))\n   525\t        (is (= {:ms 5} (:last-renewal-at holder)))\n   526\t        (judge-tick! 7)\n   527\t        (step-judge!)\n   528\t        (is (= {:ms 7} (get-in @judge [:ledger :l1 :last-observation]))\n   529\t            \"the judge's pass counted the composed holder's renewal\")\n   530\t        ;; done: stop, carry the release, and the judge reclaims :release\n   531\t        (let [{:keys [holder release]} (lease/stop holder)]\n   532\t          (is (false? (lease/holding? holder {:ms 8})))\n   533\t          (is (= :dao.lease/released\n   534\t                 (get release :dao.lease/status)))\n   535\t          (append-ok! facts release)\n   536\t          (judge-tick! 8)\n   537\t          (step-judge!)\n   538\t          (is (= [:db] @log) \"the grantor performed the reclaim\")\n   539\t          (is (= [(lease/lapsed :l1 :release)]\n   540\t                 (rest (drain-values writer)))\n   541\t              \"and recorded it: a :release lapse, authored by the holder's\n   542\t               :released, never a :lapsed from the holder\")\n   543\t          (is (empty? (get-in @judge [:ledger]))\n   544\t              \"the :release lapse left the ledger\"))))))\n   545\t\n   546\t\n   547\t;; =============================================================================\n   548\t;; 4.4: the three use-case sketches -- commented compositions,\n   549\t;; lightly exercised, not products\n   550\t;; =============================================================================\n   551\t\n   552\t(deftest forwarder-pause-sketch-test\n   553\t  (testing \"sketch: the forwarder pause -- reclaim = cease driving the\n   554\t            forward step, then close-session!\"\n   555\t    ;; A forwarder holds a lease while it advances a serving session's\n   556\t    ;; forward step (the driving shape of dao/jing/remote.cljc:981-988 and\n   557\t    ;; serving/step!). The driver loop below stands in for that daemon\n   558\t    ;; thread: it keeps stepping the session while :stepping? holds, and\n   559\t    ;; the lease's reclaim procedure is exactly the release discipline --\n   560\t    ;; cease stepping, then close-session! (serving.cljc:179-183's shape).\n   561\t    (let [session (atom {:stepping? true :closed? false})\n   562\t          system (composed {:reclaim (fn [_subject]\n   563\t                                       (swap! session assoc\n   564\t                                              :stepping? false\n   565\t                                              :closed? true)\n   566\t                                       true)})\n   567\t          system (-> system\n   568\t                     (update :judge lease/author-grant\n   569\t                             (lease/grant :l1 :forwarder :holder-a {:ms 10}))\n   570\t                     (tick! 1)\n   571\t                     step!)\n   572\t          system (-> system (tick! 12) step!)]\n   573\t      (is (true? (:closed? @session))\n   574\t          \"the reclaim closed the session\")\n   575\t      (is (false? (:stepping? @session))\n   576\t          \"and ceased the driving: the driver loop's condition is gone\")\n   577\t      (is (= [(lease/lapsed :l1 :silence)] (records system))))))\n   578\t\n   579\t\n   580\t(defn- carriage\n   581\t  \"A composition's carry step from a grantor's stream to a recipient's\n   582\t  inbound medium: copies every fact EXCEPT :lapsed -- :lapsed does not\n   583\t  cross a boundary (C8); the remote holder observes the reclaim as the\n   584\t  resource event, not as the grantor's record. Cursor-threaded, so each\n   585\t  step carries only what is new.\"\n   586\t  [source destination]\n   587\t  (let [cursor (atom (oldest-cursor source))]\n   588\t    (fn []\n   589\t      (loop []\n   590\t        (let [read (ds/next source @cursor)]\n   591\t          (when (= :dao.stream/ok (:dao.stream/outcome read))\n   592\t            (reset! cursor (:dao.stream/cursor read))\n   593\t            (when (not= :dao.lease/lapsed\n   594\t                        (get (:dao.stream/value read) :dao.lease/status))\n   595\t              (append-ok! destination (:dao.stream/value read)))\n   596\t            (recur)))))))\n   597\t\n   598\t\n   599\t(deftest served-connection-lifetime-sketch-test\n   600\t  (testing \"sketch: the served connection lifetime -- envelope-key\n   601\t            attribution and :lapsed carriage (C8)\"\n   602\t    ;; Attribution by ENVELOPE KEY (D4; the :ws/attachment envelope key of\n   603\t    ;; ws.cljc:167-174): each fact carries its attachment id in the\n   604\t    ;; envelope, and the resolver reads it FROM THE FACT -- the wired\n   605\t    ;; source is never consulted, which is exactly what declaring\n   606\t    ;; :attribution :envelope-key means (r4-P2: the earlier sketch\n   607\t    ;; declared :attachment-identity while resolving like per-author\n   608\t    ;; media, and nothing noticed).\n   609\t    ;;\n   610\t    ;; OWED (r4-r3/F2, recorded by the orchestrator in the plan's §6):\n   611\t    ;; the flattened shape modelled here -- :ws/attachment sitting\n   612\t    ;; directly on the lease fact -- is NOT the transport's. ws.cljc\n   613\t    ;; deposits {:ws/attachment <id> :ws/event ... :ws/value <payload>};\n   614\t    ;; a real composition unwraps :ws/value before the judge sees a\n   615\t    ;; lease fact, and the envelope key, as modelled here, is\n   616\t    ;; SELF-ASSERTED: whoever appends to the medium chooses it. The\n   617\t    ;; transport's authoritativeness comes from the connection, not the\n   618\t    ;; key -- an unwrap seam and a trusted binding are owed work.\n   619\t    (let [connection (atom {:open? true})\n   620\t          traffic (new-buffer 16)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/ws.cljc | sed -n '285,350p;460,535p;545,612p'; nl -ba src/cljc/yin/repl/driver.cljc | sed -n '1,260p'\"","aggregated_output":"   285\t  \"Decode one inbound frame payload with the handle's codec and dispatch its\n   286\t   envelope.  Wire validation only; application values are never judged.\n   287\t\n   288\t   There is no admission handshake any more, so a value frame can outrun\n   289\t   the server's own accept-slot! (the client's socket opens and its\n   290\t   append! gate is live from that moment, ahead of this endpoint's own\n   291\t   acceptor tick).  A frame arriving while still `:pending` is that race,\n   292\t   not a protocol violation: it is queued and replayed once `accept-slot!`\n   293\t   installs the real deposit target and opens the handle.\"\n   294\t  [handle payload]\n   295\t  (let [state (.-state ^WsHandle handle)\n   296\t        attachment (.-attachment ^WsHandle handle)\n   297\t        codec (.-codec ^WsHandle handle)]\n   298\t    (try\n   299\t      (let [frame ((:ws/decode codec) payload)]\n   300\t        (if-not (and (= :ws/value (:ws/frame frame))\n   301\t                     (contains? frame :ws/value)\n   302\t                     ((:ws/portable-value? codec) (:ws/value frame)))\n   303\t          (protocol-failure! state attachment)\n   304\t          (let [value (:ws/value frame)]\n   305\t            (case (:phase @state)\n   306\t              :open (emit! state attachment :ws/payload value)\n   307\t              :pending (swap! state update :pending-frames\n   308\t                              (fnil conj []) value)\n   309\t              (protocol-failure! state attachment)))))\n   310\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   311\t        (protocol-failure! state attachment)))))\n   312\t\n   313\t\n   314\t(defn receive!\n   315\t  \"Adapter entry for one text WebSocket message.  A text frame on a binary\n   316\t   profile is a protocol failure — the transport reads the frame's declared\n   317\t   kind, never its content.\"\n   318\t  [handle text]\n   319\t  (if (= :text (:ws/frame-kind (.-codec ^WsHandle handle)))\n   320\t    (deliver! handle text)\n   321\t    (protocol-failure! (.-state ^WsHandle handle)\n   322\t                       (.-attachment ^WsHandle handle))))\n   323\t\n   324\t\n   325\t(defn receive-binary!\n   326\t  \"Adapter entry for one binary WebSocket message (a host byte payload):\n   327\t   byte[] on the JVM, Uint8Array on ClojureScript, Uint8List on Dart.  A\n   328\t   binary frame on a text profile is a protocol failure.\"\n   329\t  [handle bytes]\n   330\t  (if (= :binary (:ws/frame-kind (.-codec ^WsHandle handle)))\n   331\t    (deliver! handle bytes)\n   332\t    (protocol-failure! (.-state ^WsHandle handle)\n   333\t                       (.-attachment ^WsHandle handle))))\n   334\t\n   335\t\n   336\t(defn closed!\n   337\t  \"Adapter entry for host close completion.  The terminal event is guarded so\n   338\t   close/error races cannot duplicate it.\"\n   339\t  [handle code _reason]\n   340\t  (let [state (.-state ^WsHandle handle)\n   341\t        attachment (.-attachment ^WsHandle handle)]\n   342\t    (when-not (:resolution? @state)\n   343\t      (swap! state assoc :resolution? true)\n   344\t      (emit! state attachment :ws/transport-error))\n   345\t    (terminal! state attachment (if (= ended-close-code code) :ws/ended :ws/closed))))\n   346\t\n   347\t\n   348\t(defn adapter\n   349\t  \"The only callback-shaped value, for a host socket adapter while wiring its\n   350\t   private listener.  It is not a DaoStream API and never reaches consumers.\n   460\t           (-> s\n   461\t               (update-in [:slots index] dissoc\n   462\t                          :attachment :handle :handle-state :codec :opened-at)\n   463\t               (assoc-in [:slots index :status] :free)\n   464\t               (update :connections dissoc attachment)))))\n   465\t\n   466\t\n   467\t(defn accept-connection!\n   468\t  \"Bounded upgrade callback entry.  An exhausted slot pool is closed\n   469\t   immediately; otherwise this deposits precisely one host-local offer and\n   470\t   waits for `endpoint-step` to consume a matching acknowledgement.  There\n   471\t   is no served-path lookup here any more: every upgrade this endpoint's\n   472\t   own codec negotiation accepts is accepted, and what a client can reach\n   473\t   through it is entirely the mirror's own table, answered per identity\n   474\t   after the connection opens.  `path` is the caller's own routing concern\n   475\t   (a host bound to more than one endpoint still dispatches an upgrade to\n   476\t   the right one by it); this transport no longer inspects it.\n   477\t\n   478\t   The socket seam may carry `:ws/subprotocol`, the subprotocol the host\n   479\t   negotiated for this upgrade.  An endpoint serves every profile it was\n   480\t   composed with, concurrently; a named subprotocol it does not speak is a\n   481\t   refused handshake, never a downgrade, and an absent name is the Transit\n   482\t   default for sockets that negotiated nothing (direct composition and\n   483\t   tests).\"\n   484\t  ([endpoint path socket] (accept-connection! endpoint path socket nil))\n   485\t  ([endpoint _path socket now]\n   486\t   (let [descriptor (:descriptor (:config endpoint))\n   487\t         offered (:ws/subprotocol socket)\n   488\t         codec (if (nil? offered)\n   489\t                 transit/profile\n   490\t                 (get (:codec-index endpoint) offered))]\n   491\t     (cond\n   492\t       (nil? codec)\n   493\t       (do (invoke-close! socket protocol-close-code \"dao.stream/subprotocol-unsupported\")\n   494\t           {:ws/status :ws/unsupported-subprotocol})\n   495\t\n   496\t       :else\n   497\t       (let [state (:state endpoint)\n   498\t             chosen (volatile! nil)]\n   499\t         ;; Claim before depositing.  The offer append may synchronously invoke\n   500\t         ;; host code, so leaving the slot `:free` until after it returns would\n   501\t         ;; permit a second upgrade callback to overwrite the sole offer.\n   502\t         (swap! state (fn [s]\n   503\t                        (if-let [[index slot] (first (keep-indexed (fn [i x]\n   504\t                                                                     (when (= :free (:status x)) [i x]))\n   505\t                                                                   (:slots s)))]\n   506\t                          (do (vreset! chosen [index slot])\n   507\t                              (assoc-in s [:slots index :status] :reserving))\n   508\t                          s)))\n   509\t         (if-not @chosen\n   510\t           (do (invoke-close! socket 1013 \"dao.stream/acceptance-full\")\n   511\t               {:ws/status :ws/full})\n   512\t           (let [[index slot] @chosen\n   513\t                 id (attachment-id)\n   514\t                 [handle hstate] (new-handle descriptor id (endpoint-target endpoint) :pending socket codec)\n   515\t                 offer {:ws/attachment id :ws/event :ws/accepted\n   516\t                        :ws/handle {:dao.stream/handle handle\n   517\t                                    :dao.stream/surface #{:writer :closable}}}\n   518\t                 result (stream/append! (:dao.stream/handle (:offer slot)) offer)]\n   519\t             (if (= :dao.stream/ok (:dao.stream/outcome result))\n   520\t               (do (swap! state (fn [s]\n   521\t                                  (-> s\n   522\t                                      (assoc-in [:slots index :status] :pending)\n   523\t                                      (assoc-in [:slots index :attachment] id)\n   524\t                                      (assoc-in [:slots index :handle] handle)\n   525\t                                      (assoc-in [:slots index :handle-state] hstate)\n   526\t                                      (assoc-in [:slots index :codec] codec)\n   527\t                                      (assoc-in [:slots index :opened-at] now)\n   528\t                                      (assoc-in [:connections id] handle))))\n   529\t                   {:ws/status :ws/pending :ws/attachment id :ws/handle handle})\n   530\t               (do (swap! hstate assoc :phase :closed)\n   531\t                   (invoke-close! socket 1011 \"dao.stream/offer-failed\")\n   532\t                   (release-slot! endpoint index id)\n   533\t                   {:ws/status :ws/offer-failed})))))))))\n   534\t\n   535\t\n   545\t(defn- accept-slot!\n   546\t  \"The client is never told over the wire: there is no admission frame any\n   547\t   more, and nothing needs one -- `opened!` already ran when its own\n   548\t   socket opened, ahead of any acknowledgement.  This installs the\n   549\t   deposit target the acknowledgement carries, replays any value frames\n   550\t   `deliver!` queued while still pending (the client's own socket can\n   551\t   outrun this endpoint's acceptor tick), and releases the slot.\n   552\t\n   553\t   The queue grab and the phase flip are one `swap!`: reading the queue\n   554\t   separately from clearing it and opening the phase would let a frame\n   555\t   land in the gap between those steps, either erased by the clear or\n   556\t   deposited by `deliver!`'s own `:open` path ahead of the older queued\n   557\t   frames this replays.  One atomic step leaves no such gap.\"\n   558\t  [endpoint index slot ack]\n   559\t  (let [hstate (:handle-state slot)\n   560\t        target (:ws/deposit ack)\n   561\t        queued (volatile! nil)]\n   562\t    (swap! hstate (fn [s]\n   563\t                    (vreset! queued (:pending-frames s))\n   564\t                    (assoc s :deposit target :phase :open :resolution? true\n   565\t                             :pending-frames [])))\n   566\t    (doseq [value @queued]\n   567\t      (emit! hstate (:attachment slot) :ws/payload value))\n   568\t    (release-slot! endpoint index (:attachment slot))))\n   569\t\n   570\t\n   571\t(defn endpoint-step\n   572\t  \"Poll each configured acknowledgement slot once, without waiting or\n   573\t   self-scheduling.  Returns the endpoint after retaining its next cursors.\"\n   574\t  [endpoint now]\n   575\t  ;; A pending connection can be lost before any acknowledgement: the peer\n   576\t  ;; closes, the wire protocol fails, or its own handle is closed.  Each of\n   577\t  ;; those paths closes the handle's state and deposits its terminal event;\n   578\t  ;; this is where the endpoint observes that and returns the slot, so bounded\n   579\t  ;; admission is a live bound rather than a monotonically shrinking one.\n   580\t  (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   581\t          :when (and (= :pending (:status slot))\n   582\t                     (= :closed (:phase @(:handle-state slot))))]\n   583\t    (release-slot! endpoint index (:attachment slot)))\n   584\t  (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   585\t          :when (= :pending (:status slot))]\n   586\t    (let [next (stream/next (:dao.stream/handle (:ack slot)) (:ack-cursor slot))]\n   587\t      (when (= :dao.stream/ok (:dao.stream/outcome next))\n   588\t        (swap! (:state endpoint) assoc-in [:slots index :ack-cursor] (:dao.stream/cursor next))\n   589\t        (let [ack (:dao.stream/value next)]\n   590\t          (cond\n   591\t            (not= (:attachment slot) (:ws/attachment ack)) nil\n   592\t            (valid-ack? ack (:attachment slot)) (accept-slot! endpoint index slot ack)\n   593\t            :else (let [hstate (:handle-state slot)]\n   594\t                    (swap! hstate assoc :phase :closed)\n   595\t                    (invoke-close! (:socket @hstate) protocol-close-code \"dao.stream/invalid-ack\")\n   596\t                    (terminal! hstate (:attachment slot) :ws/closed)\n   597\t                    (release-slot! endpoint index (:attachment slot))))))))\n   598\t  ;; Expiry is deliberately clock-domain explicit.  An endpoint composition\n   599\t  ;; may set `:opened-at` when it accepts an offer; this transport does not\n   600\t  ;; invent wall-clock time or a scheduler.\n   601\t  (when-let [expiry (:expiry-ms (:config endpoint))]\n   602\t    (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   603\t            :when (and (= :pending (:status slot)) (:opened-at slot)\n   604\t                       (<= (+ (:opened-at slot) expiry) now))]\n   605\t      (let [hstate (:handle-state slot)]\n   606\t        (swap! hstate assoc :phase :closed)\n   607\t        (invoke-close! (:socket @hstate) 1000 \"dao.stream/acceptance-expired\")\n   608\t        (terminal! hstate (:attachment slot) :ws/closed)\n   609\t        (release-slot! endpoint index (:attachment slot)))))\n   610\t  endpoint)\n     1\t(ns yin.repl.driver\n     2\t  \"The one owner of Yin REPL state.\n     3\t\n     4\t   A line producer appends `{:yin.repl.input/line \\\"…\\\"}` to the\n     5\t   composition-owned input medium and returns.  It does not evaluate, request,\n     6\t   poll, print, prompt, or touch the state held here.  `repl-step` is called\n     7\t   once per externally driven tick by exactly one ticker per host: it drains\n     8\t   the input medium, evaluates local input, forwards ordinary source through\n     9\t   the RPC client, publishes completions exactly once, and returns the next\n    10\t   state.\n    11\t\n    12\t   It never loops on `blocked`, and it owns no promise, future, callback, atom,\n    13\t   or clock.\"\n    14\t  (:require [clojure.string :as str]\n    15\t            [dao.data :as data]\n    16\t            [dao.stream :as stream]\n    17\t            [dao.stream.ringbuffer :as ring]\n    18\t            [dao.stream.rpc :as rpc]\n    19\t            [yin.repl.adapter :as adapter]\n    20\t            [yin.repl.connect :as connect]\n    21\t            [yin.repl :as repl]\n    22\t            [yin.repl.host :as host]))\n    23\t\n    24\t\n    25\t(def line-key :yin.repl.input/line)\n    26\t\n    27\t\n    28\t(def input-capacity\n    29\t  \"Declared capacity of the composition-owned input medium, in elements.\"\n    30\t  1024)\n    31\t\n    32\t\n    33\t(def input-budget\n    34\t  \"Maximum input elements one step reads, so a flooded medium cannot make a\n    35\t   single step unbounded.\"\n    36\t  64)\n    37\t\n    38\t\n    39\t(def response-budget\n    40\t  \"Maximum response-medium elements one step reads.\"\n    41\t  32)\n    42\t\n    43\t\n    44\t(def event-key :yin.repl.driver/event)\n    45\t(def text-key :yin.repl.driver/text)\n    46\t\n    47\t\n    48\t(def ^:private diagnostic-bounds\n    49\t  \"Bound on operator-facing diagnostic text built from unbounded internal\n    50\t   state (raw input, event/result maps).\"\n    51\t  {:depth 3 :items 8 :chars 200})\n    52\t\n    53\t\n    54\t(def connect-usage\n    55\t  \"(connect \\\"daostream:ws://host:port/repl\\\") — an absent path means /repl\")\n    56\t\n    57\t\n    58\t(defn create-input-medium!\n    59\t  \"Create the composition-owned input ring buffer.  The handoff between a line\n    60\t   producer and the step owner is a stream, which is what makes it explicit and\n    61\t   thread-safe.\"\n    62\t  []\n    63\t  (:dao.stream/handle\n    64\t    (ring/create! {:dao.stream/type ring/transport-type\n    65\t                   ring/capacity-key input-capacity})))\n    66\t\n    67\t\n    68\t(defn- mint-cursor\n    69\t  [handle]\n    70\t  (let [result (stream/cursor handle :dao.stream/oldest)]\n    71\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n    72\t      (:dao.stream/cursor result))))\n    73\t\n    74\t\n    75\t(defn create-state\n    76\t  ([] (create-state {}))\n    77\t  ([{:keys [input input-cursor repl host]}]\n    78\t   (let [input (or input (create-input-medium!))]\n    79\t     {:repl (or repl (repl/create-state))\n    80\t      :input input\n    81\t      :input-cursor (or input-cursor (mint-cursor input))\n    82\t      :input-ledger :untried\n    83\t      ;; The host WebSocket adapter is composition data, injected once.  Nil is\n    84\t      ;; the honest answer in a build with no host socket package.\n    85\t      :host (or host (host/websocket))\n    86\t      :connection nil\n    87\t      :adapter nil\n    88\t      :queued []\n    89\t      :outstanding nil\n    90\t      :retrying nil\n    91\t      :outbox []\n    92\t      :last-tick nil\n    93\t      :running? true})))\n    94\t\n    95\t\n    96\t(defn submit-line!\n    97\t  \"Append one typed line to the input medium and return the append outcome.\n    98\t   This is the whole of a line producer's work.\"\n    99\t  [input line]\n   100\t  (stream/append! input {line-key line}))\n   101\t\n   102\t\n   103\t(defn take-outbox\n   104\t  \"Return `[entries next-state]`, clearing the publication outbox exactly once.\"\n   105\t  [state]\n   106\t  [(:outbox state) (assoc state :outbox [])])\n   107\t\n   108\t\n   109\t(defn attach-remote\n   110\t  [state adapter-state]\n   111\t  (assoc state :adapter adapter-state :queued [] :outstanding nil :retrying nil))\n   112\t\n   113\t\n   114\t(defn detach-remote\n   115\t  [state]\n   116\t  (assoc state :adapter nil :queued [] :outstanding nil :retrying nil))\n   117\t\n   118\t\n   119\t(defn- publish\n   120\t  [state event text]\n   121\t  (if (str/blank? (str text))\n   122\t    state\n   123\t    (update state :outbox conj {event-key event text-key text})))\n   124\t\n   125\t\n   126\t;; =============================================================================\n   127\t;; Input\n   128\t;; =============================================================================\n   129\t\n   130\t(defn- drain-input\n   131\t  \"Read up to `input-budget` input elements, total over every `next` outcome.\n   132\t   A gap means typed lines were evicted: the loss is published, the recovery\n   133\t   cursor is taken, and none of the missing input is evaluated.\"\n   134\t  [state]\n   135\t  (loop [remaining input-budget\n   136\t         state state\n   137\t         lines []]\n   138\t    (if (or (zero? remaining) (nil? (:input-cursor state)))\n   139\t      [state lines]\n   140\t      (let [result (stream/next (:input state) (:input-cursor state))\n   141\t            outcome (:dao.stream/outcome result)]\n   142\t        (case outcome\n   143\t          :dao.stream/ok\n   144\t          (recur (dec remaining)\n   145\t                 (assoc state :input-cursor (:dao.stream/cursor result))\n   146\t                 (conj lines (get (:dao.stream/value result) line-key)))\n   147\t\n   148\t          :dao.stream/gap\n   149\t          (recur (dec remaining)\n   150\t                 (-> state\n   151\t                     (assoc :input-cursor (:dao.stream/cursor result))\n   152\t                     (publish :yin.repl.driver/notice\n   153\t                              \";; input lost: typed lines were evicted before this step\"))\n   154\t                 lines)\n   155\t\n   156\t          :dao.stream/blocked\n   157\t          [(assoc state :input-ledger outcome) lines]\n   158\t\n   159\t          [(-> state\n   160\t               (assoc :input-ledger outcome)\n   161\t               (publish :yin.repl.driver/notice\n   162\t                        (str \";; input \" (name outcome))))\n   163\t           lines])))))\n   164\t\n   165\t\n   166\t;; =============================================================================\n   167\t;; Local and remote input\n   168\t;; =============================================================================\n   169\t\n   170\t(defn- evaluate-locally\n   171\t  [state line]\n   172\t  (let [[repl text] (repl/eval-input (:repl state) line)]\n   173\t    (-> state\n   174\t        (assoc :repl repl)\n   175\t        (assoc :running? (boolean (:running? repl)))\n   176\t        (publish :yin.repl.driver/result text))))\n   177\t\n   178\t\n   179\t(defn- rpc-client\n   180\t  [state]\n   181\t  (get-in state [:adapter :yin.repl.adapter/rpc]))\n   182\t\n   183\t\n   184\t(defn- remote-terminal\n   185\t  [state]\n   186\t  (:terminal (rpc-client state)))\n   187\t\n   188\t\n   189\t(defn- remote-unsent?\n   190\t  \"True while the RPC client holds an allocated request it has not managed to\n   191\t   append.  That request, not the driver's own record of the line, is what owns\n   192\t   the request path: `rpc/request!` retries it and ignores any new operation.\"\n   193\t  [state]\n   194\t  (rpc/unsent? (rpc-client state)))\n   195\t\n   196\t\n   197\t(defn pending-write?\n   198\t  \"True while a remote write the operator is owed remains in flight: a\n   199\t   request awaiting its response, a line held for a full writer, or an\n   200\t   envelope the RPC client still retains. This is one half of the tick\n   201\t   owner's `moved?` — a pending write must never wait out a backoff ceiling,\n   202\t   so cadence stays at the base interval until it clears.\"\n   203\t  [state]\n   204\t  (boolean (or (:outstanding state)\n   205\t               (:retrying state)\n   206\t               (remote-unsent? state))))\n   207\t\n   208\t\n   209\t(def queueable-terminals\n   210\t  \"Terminal reasons after which an ordinary line still has a reattachment\n   211\t   decision to wait for.  Only `/detached` reattaches.  A reachability failure\n   212\t   may succeed through a *fresh* connection, but that connection cannot inherit\n   213\t   this binding's queued lines, so promising to deliver them would be false.\n   214\t   Every other terminal returns input to the local shell.\"\n   215\t  #{:dao.stream.apply/detached})\n   216\t\n   217\t\n   218\t(defn- remote-routed?\n   219\t  \"True while ordinary input belongs to the remote shell.  An operator\n   220\t   `(disconnect)` ends that immediately — the shell is local again from the next\n   221\t   line, without waiting for the terminal event the boundary will deposit — while\n   222\t   an uninvited drop keeps routing so the input can queue for a reattachment.  A\n   223\t   terminal with no reattachment behind it ends it too.\"\n   224\t  [state]\n   225\t  (and (:adapter state)\n   226\t       (not (connect/operator-detached? (:connection state)))\n   227\t       (let [terminal (remote-terminal state)]\n   228\t         (or (nil? terminal) (contains? queueable-terminals terminal)))))\n   229\t\n   230\t\n   231\t(defn- abandon-unsent\n   232\t  \"Give up any allocated-but-unsent request, with the reason the driver owns.\n   233\t\n   234\t   The RPC client would otherwise retry that exact envelope on the next binding,\n   235\t   in place of the line the operator types after reattaching.  Abandoning it\n   236\t   publishes the loss as an ordinary completion, so the line is reported rather\n   237\t   than silently replayed or dropped.\"\n   238\t  [state reason]\n   239\t  (if (rpc-client state)\n   240\t    (update-in state [:adapter :yin.repl.adapter/rpc] rpc/abandon-unsent reason)\n   241\t    state))\n   242\t\n   243\t\n   244\t(declare publish-adapter-events)\n   245\t\n   246\t\n   247\t(defn- abandon-unsent-now\n   248\t  \"Finish and publish the old request path before replacing an adapter wholesale.\n   249\t\n   250\t   The ordinary disconnect/reattach paths retain their adapter until the next\n   251\t   poll can publish its completion.  A fresh connection does not: it installs a\n   252\t   new adapter immediately, so every already-unpublished completion must cross\n   253\t   into the driver's outbox first or it is discarded with the old adapter.  An\n   254\t   unsent envelope is abandoned before that unconditional publication step.\"\n   255\t  [state reason]\n   256\t  (if-not (:adapter state)\n   257\t    state\n   258\t    (let [state (cond-> state\n   259\t                  (remote-unsent? state) (abandon-unsent reason))\n   260\t          published (adapter/publish-completions (:adapter state))]\n","exit_code":0,"status":"completed"}}
