                 (py/import-refused name r)
                 (if (= (get r 1) :py/None)
                   (py/no-module name)
                   (let [m (py/module-run
                             name
                             (if (get (get r 0) :package?)
                               name
                               (py/str (get (cell/get parent) :name)))
                             (get r 1))]
                     (do (py/setattr parent (get attr :py/str) m)
                         m)))))))))]
