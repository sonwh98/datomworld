                                  (data/str-concat (get name :py/str) "'")))))]
    [py/import-refused
     ;; Keep linker diagnostics intact on the exception. Only unresolved
     ;; names are ModuleNotFoundError; content and admission misses are
     ;; ImportError.
     (fn [name r]
