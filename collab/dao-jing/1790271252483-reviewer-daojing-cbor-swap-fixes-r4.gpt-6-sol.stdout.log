{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/jing/remote.cljc | sed -n '109,165p'; nl -ba src/cljc/dao/jing.cljc | sed -n '450,474p'; nl -ba src/cljc/dao/jing/cbor.cljc | sed -n '1521,1552p'; nl -ba src/cljc/dao/jing/remote/step.cljc | sed -n '250,281p;305,335p'; nl -ba test/dao/jing/remote/step_test.cljc | sed -n '270,303p'\"","aggregated_output":"   109\t(defn content-client\n   110\t  \"Wrap an RPC client as a dao.jing byte-store handle: puts send the\n   111\t   canonical bytes as Base64 text, gets decode the Base64 the server\n   112\t   answers (the caller, dao.jing/get, hash-verifies the bytes).\n   113\t\n   114\t   call-fn is invoked as (call-fn client op args) and close-fn as\n   115\t   (close-fn client). Close is guarded so concurrent JVM closes call the\n   116\t   underlying close-fn exactly once; if close-fn throws, the client stays\n   117\t   open for retry.\"\n   118\t  [client call-fn close-fn]\n   119\t  (when-not (ifn? call-fn)\n   120\t    (throw (ex-info \"call-fn must be a function\" {:call-fn call-fn})))\n   121\t  (when-not (ifn? close-fn)\n   122\t    (throw (ex-info \"close-fn must be a function\" {:close-fn close-fn})))\n   123\t  (let [closed-atom (atom false)\n   124\t        close-lock #?(:clj (Object.)\n   125\t                      :default nil)\n   126\t        ensure-open (fn []\n   127\t                      (when @closed-atom\n   128\t                        (throw (ex-info \"content client is closed\"\n   129\t                                        {:client client}))))]\n   130\t    {:client client,\n   131\t     :closed-atom closed-atom,\n   132\t     :put-bytes-fn (fn [address bs]\n   133\t                     (ensure-open)\n   134\t                     (call-fn client :jing/put-content\n   135\t                              [address (jing/bytes->base64 bs)])),\n   136\t     :get-bytes-fn\n   137\t     (fn [address not-found]\n   138\t       (ensure-open)\n   139\t       (let [resp (call-fn client :jing/get-content [address])\n   140\t             bs (when (and (valid-presence-envelope? resp) (:found? resp))\n   141\t                  (try (jing/base64->bytes (:value resp))\n   142\t                       (catch #?(:cljd Object :clj Throwable :cljs :default)\n   143\t                              _\n   144\t                         nil)))]\n   145\t         (cond\n   146\t           (some? bs) bs\n   147\t           (and (valid-presence-envelope? resp) (not (:found? resp)))\n   148\t           not-found\n   149\t           :else\n   150\t           (throw\n   151\t             (ex-info\n   152\t               (str \"malformed RPC response: presence envelope must \"\n   153\t                    \"contain exactly :found? (boolean) and :value \"\n   154\t                    \"(padded Base64 or nil) keys\")\n   155\t               {:operation :jing/get-content,\n   156\t                :address address,\n   157\t                :response resp}))))),\n   158\t     :close-fn (fn []\n   159\t                 (with-lock close-lock\n   160\t                   (fn []\n   161\t                     (when-not @closed-atom\n   162\t                       (close-fn client)\n   163\t                       (compare-and-set! closed-atom false true)))))}))\n   164\t\n   165\t\n   450\t        bs (canonical-bytes payload)]\n   451\t    (when-not (= digest (digest-bytes algorithm bs))\n   452\t      (throw (ex-info \"content address does not match the payload\"\n   453\t                      {:address address, :payload payload})))\n   454\t    bs))\n   455\t\n   456\t\n   457\t(defn segment-value\n   458\t  \"The value of payload bytes stored at address: verifies the bytes hash to\n   459\t   the address under its carried algorithm, then decodes exactly one\n   460\t   accepted payload without re-encoding it (the canonicality check ran\n   461\t   once, at the ingress that accepted the bytes). Throws on a malformed\n   462\t   address, a digest mismatch, or bytes that do not decode.\"\n   463\t  [address bs]\n   464\t  (let [{:keys [algorithm digest]}\n   465\t        (or (parse-segment-address address)\n   466\t            (throw (ex-info \"not a segment content address\"\n   467\t                            {:address address})))]\n   468\t    (when-not (= digest (digest-bytes algorithm bs))\n   469\t      (throw (ex-info \"stored bytes do not hash to their content address\"\n   470\t                      {:address address})))\n   471\t    (cbor/decode-snapshot bs)))\n   472\t\n   473\t\n   474\t(defn materialize!\n  1521\t          (refuse :unknown-tag (str \"tag \" raw)))))))\n  1522\t\n  1523\t\n  1524\t(defn decode-snapshot\n  1525\t  \"The value of one accepted Jing payload (byte[], Uint8Array or\n  1526\t   Uint8List) that already passed ingress: bytes a backend stored after\n  1527\t   `decode` accepted them, or bytes this codec encoded itself. Refuses\n  1528\t   malformed CBOR, trailing data and anything outside the closed profile,\n  1529\t   but does not re-encode the value to prove canonicality -- that check\n  1530\t   ran once at ingress (docs/design/dao.jing.cbor.md, Layering and\n  1531\t   interfaces). Returned byte strings are fresh copies.\"\n  1532\t  [bs]\n  1533\t  (when (zero? (blen bs))\n  1534\t    (refuse :malformed-cbor \"empty input\"))\n  1535\t  (let [[item pos] (read-item bs 0 1)]\n  1536\t    (when (not= pos (blen bs))\n  1537\t      (refuse :trailing-data (str (- (blen bs) pos) \" bytes after the item\")))\n  1538\t    (item->value bs item)))\n  1539\t\n  1540\t\n  1541\t(defn decode\n  1542\t  \"The value of one canonical Jing payload (byte[], Uint8Array or\n  1543\t   Uint8List): the ingress check. Refuses everything `decode-snapshot`\n  1544\t   refuses and also any payload whose value does not re-encode to exactly\n  1545\t   these bytes. Returned byte strings are fresh copies.\"\n  1546\t  [bs]\n  1547\t  (let [value (decode-snapshot bs)]\n  1548\t    (when-not (bytes= bs (encode value))\n  1549\t      (refuse :non-canonical))\n  1550\t    value))\n   250\t     (submit state put-content-op [addr (jing/bytes->base64 bs)] true))))\n   251\t\n   252\t\n   253\t(defn- accepted-bytes\n   254\t  \"The canonical bytes a `:jing/get-content` envelope carries for address\n   255\t   as Base64 text, or nil when the text is not strict Base64 or the bytes\n   256\t   do not hash to the address.\"\n   257\t  [address b64]\n   258\t  (try (let [bs (jing/base64->bytes b64)]\n   259\t         (when (jing/segment-bytes-match? address bs) bs))\n   260\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   261\t         nil)))\n   262\t\n   263\t\n   264\t;; =============================================================================\n   265\t;; Completion decode\n   266\t;; =============================================================================\n   267\t\n   268\t\n   269\t(def ^:private refused\n   270\t  \"The decode-refusal sentinel for the strict receipt decode below: one\n   271\t   opaque host object held by this single var, so every reference to it\n   272\t   is the same instance on every host. A keyword literal cannot serve:\n   273\t   on cljs each literal site compiles to a fresh Keyword object, so\n   274\t   `identical?` across two sites misses (the hazard\n   275\t   `dao.data.btree.storage`'s `absent` sentinel already records), and a\n   276\t   refused decode escaped into the value arm. The closed CBOR profile\n   277\t   never decodes a host object, so no decoded value can be this.\"\n   278\t  #?(:cljd (Object.)\n   279\t     :clj (Object.)\n   280\t     :cljs (js-obj)))\n   281\t\n   305\t            (if (#{:inserted :present} value)\n   306\t              {:id id :op op :address (first (:dao.stream.rpc/args completion))\n   307\t               :result value}\n   308\t              {:id id :op op :error (malformed-response op)})\n   309\t\n   310\t            ;; a found value arrives as Base64 of its canonical bytes; the\n   311\t            ;; bytes must hash to the requested address and decode as one\n   312\t            ;; canonical payload before a value is published\n   313\t            (= get-content-op op)\n   314\t            (if (presence-envelope? value)\n   315\t              (if (:found? value)\n   316\t                (let [address (first (:dao.stream.rpc/args completion))\n   317\t                      bs (accepted-bytes address (:value value))\n   318\t                      decoded (when bs\n   319\t                                (try (cbor/decode bs)\n   320\t                                     (catch #?(:cljd Object\n   321\t                                               :clj Throwable\n   322\t                                               :cljs :default)\n   323\t                                            _\n   324\t                                       refused)))]\n   325\t                  (if (or (nil? bs) (identical? refused decoded))\n   326\t                    {:id id :op op\n   327\t                     :error {:dao.stream.apply/code integrity-failure-code\n   328\t                             :dao.stream.apply/message\n   329\t                             (str \"the remote content does not hash to \"\n   330\t                                  \"its content address\")}}\n   331\t                    {:id id :op op :found? true :value decoded}))\n   332\t                {:id id :op op :found? false :value nil})\n   333\t              {:id id :op op :error (malformed-response op)})\n   334\t\n   335\t            :else\n   270\t                          (mapcat :completions\n   271\t                                  [first-step second-step third-step])))))))\n   272\t      (finally (jing/close! store)))))\n   273\t\n   274\t\n   275\t(deftest a-hash-valid-noncanonical-payload-is-an-integrity-failure\n   276\t  ;; The hostile pair: an address minted over bytes that decode as one\n   277\t  ;; payload but are not its canonical encoding, served by a server\n   278\t  ;; holding exactly those bytes. The digest matches the minted address,\n   279\t  ;; so only the ingress canonicality check can refuse the reply.\n   280\t  (let [bs (host-bytes [0x18 0x01])\n   281\t        algo jing/default-hash-algorithm\n   282\t        reg (get jing/registry algo)\n   283\t        address (keyword \"segment\"\n   284\t                         (str (:address-id reg)\n   285\t                              \"-\" (jing/digest-bytes algo bs)))\n   286\t        server (make-server\n   287\t                 (remote/default-handlers\n   288\t                   {:put-bytes-fn (fn [_address _bytes] :present)\n   289\t                    :get-bytes-fn (fn [_address _not-found] bs)}))]\n   290\t    (let [r (step/request-get (stepped-over server) address)]\n   291\t      (is (= :dao.stream.rpc/requested (:outcome r)))\n   292\t      ((:serve! server))\n   293\t      (let [stepped (step/step (:state r) 4)]\n   294\t        (is (= [{:id 0 :op :jing/get-content\n   295\t                 :error {:dao.stream.apply/code step/integrity-failure-code\n   296\t                         :dao.stream.apply/message\n   297\t                         (str \"the remote content does not hash to \"\n   298\t                              \"its content address\")}}]\n   299\t               (:completions stepped)))))))\n   300\t\n   301\t\n   302\t(deftest a-verify-mismatch-is-an-integrity-failure\n   303\t  ;; The hostile server: :present, then different content at the address.\n","exit_code":0,"status":"completed"}}
