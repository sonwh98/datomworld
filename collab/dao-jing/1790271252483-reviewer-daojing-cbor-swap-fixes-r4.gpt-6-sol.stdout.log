  334\t\n   335\t            :else\n   245\t              \"the :present put published nothing\")\n   246\t          (is (= {0 {:phase :verify-unissued\n   247\t                     :address address\n   248\t                     :put-id 0}}\n   249\t                 (get-in first-step [:state :materializations]))\n   250\t              \"the record holds the address and ids, never the payload\")\n   251\t          (is (= {} (get-in first-step [:state :routes]))\n   252\t              \"the put id's route died with its completion\")\n   253\t          (let [second-step (step/step (:state first-step) 4)]\n   254\t            (is (= [] (:completions second-step))\n   255\t                \"the verify read was issued but not yet answered\")\n   256\t            (is (= :verify-issued\n   257\t                   (get-in second-step [:state :materializations 0 :phase])))\n   258\t            (is (= {1 0} (get-in second-step [:state :routes]))\n   259\t                \"the get id routes to the record's put id\")\n   260\t            ((:serve! server))\n   261\t            (let [third-step (step/step (:state second-step) 4)]\n   262\t              (is (= [{:id 0 :materialized? true :address address\n   263\t                       :result :present}]\n   264\t                     (:completions third-step))\n   265\t                  \"an equal read-back completes :present, carrying the put id\")\n   266\t              (is (= {} (get-in third-step [:state :materializations])))\n   267\t              (is (= {} (get-in third-step [:state :routes])))\n   268\t              ;; And no published entry anywhere carried the payload.\n   269\t              (is (every? #(not (contains? % :args))\n   270\t                          (mapcat :completions\n   271\t                                  [first-step second-step third-step])))))))\n   272\t      (finally (jing/close! store)))))\n   273\t\n   274\t\n   275\t(deftest a-hash-valid-noncanonical-payload-is-an-integrity-failure\n   276\t  ;; The hostile pair: an address minted over bytes that decode as one\n   277\t  ;; payload but are not its canonical encoding, served by a server\n   278\t  ;; holding exactly those bytes. The digest matches the minted address,\n   279\t  ;; so only the ingress canonicality check can refuse the reply.\n   280\t  (let [bs (host-bytes [0x18 0x01])\n   281\t        algo jing/default-hash-algorithm\n   282\t        reg (get jing/registry algo)\n   283\t        address (keyword \"segment\"\n   284\t                         (str (:address-id reg)\n   285\t                              \"-\" (jing/digest-bytes algo bs)))\n   286\t        server (make-server\n   287\t                 (remote/default-handlers\n   288\t                   {:put-bytes-fn (fn [_address _bytes] :present)\n   289\t                    :get-bytes-fn (fn [_address _not-found] bs)}))]\n   290\t    (let [r (step/request-get (stepped-over server) address)]\n   291\t      (is (= :dao.stream.rpc/requested (:outcome r)))\n   292\t      ((:serve! server))\n   293\t      (let [stepped (step/step (:state r) 4)]\n   294\t        (is (= [{:id 0 :op :jing/get-content\n   295\t                 :error {:dao.stream.apply/code step/integrity-failure-code\n   296\t                         :dao.stream.apply/message\n   297\t                         (str \"the remote content does not hash to \"\n   298\t                              \"its content address\")}}]\n   299\t               (:completions stepped)))))))\n   300\t\n   301\t\n   302\t(deftest a-verify-mismatch-is-an-integrity-failure\n   303\t  ;; The hostile server: :present, then different content at the address.\n   304\t  (let [server (make-server (remote/default-handlers\n   305\t                              (lying-store {:tampered \"content\"})))\n   306\t        payload {:real \"payload\"}\n   307\t        address (jing/segment-key payload)]\n   308\t    (let [r (step/request-materialize (stepped-over server) payload)]\n   309\t      ((:serve! server))\n   310\t      (let [stepped-1 (step/step (:state r) 4)]\n   311\t        (is (= [] (:completions stepped-1)))\n   312\t        (let [stepped-2 (step/step (:state stepped-1) 4)]\n   313\t          ((:serve! server))\n   314\t          (let [stepped-3 (step/step (:state stepped-2) 4)]\n   315\t            (is (= [{:id 0\n   316\t                     :materialized? true\n   317\t                     :address address\n   318\t                     :error {:dao.stream.apply/code step/integrity-failure-code\n   319\t                             :dao.stream.apply/message\n   320\t                             \"the remote content does not hash to its content address\"}}]\n   321\t                   (:completions stepped-3)))\n   322\t            (is (= {} (get-in stepped-3 [:state :materializations])))))))))\n   323\t\n   324\t\n   325\t(deftest a-present-but-absent-verify-is-present-but-absent\n   326\t  (let [server (make-server (remote/default-handlers (lying-store ::absent)))\n   327\t        payload {:ghost \"payload\"}\n   328\t        address (jing/segment-key payload)]\n   329\t    (let [r (step/request-materialize (stepped-over server) payload)]\n   330\t      ((:serve! server))\n   331\t      (let [stepped-1 (step/step (:state r) 4)]\n   332\t        (let [stepped-2 (step/step (:state stepped-1) 4)]\n   333\t          ((:serve! server))\n   334\t          (is (= [{:id 0\n   335\t                   :materialized? true\n  1518\t                 (refuse :malformed-frame\n  1519\t                         \"tag 27 payload is not [name-string payload]\"))\n  1520\t               (frame->value bs (:value n) payload))\n  1521\t          (refuse :unknown-tag (str \"tag \" raw)))))))\n  1522\t\n  1523\t\n  1524\t(defn decode-snapshot\n  1525\t  \"The value of one accepted Jing payload (byte[], Uint8Array or\n  1526\t   Uint8List) that already passed ingress: bytes a backend stored after\n  1527\t   `decode` accepted them, or bytes this codec encoded itself. Refuses\n  1528\t   malformed CBOR, trailing data and anything outside the closed profile,\n  1529\t   but does not re-encode the value to prove canonicality -- that check\n  1530\t   ran once at ingress (docs/design/dao.jing.cbor.md, Layering and\n  1531\t   interfaces). Returned byte strings are fresh copies.\"\n  1532\t  [bs]\n  1533\t  (when (zero? (blen bs))\n  1534\t    (refuse :malformed-cbor \"empty input\"))\n  1535\t  (let [[item pos] (read-item bs 0 1)]\n  1536\t    (when (not= pos (blen bs))\n  1537\t      (refuse :trailing-data (str (- (blen bs) pos) \" bytes after the item\")))\n  1538\t    (item->value bs item)))\n  1539\t\n  1540\t\n  1541\t(defn decode\n  1542\t  \"The value of one canonical Jing payload (byte[], Uint8Array or\n  1543\t   Uint8List): the ingress check. Refuses everything `decode-snapshot`\n  1544\t   refuses and also any payload whose value does not re-encode to exactly\n  1545\t   these bytes. Returned byte strings are fresh copies.\"\n  1546\t  [bs]\n  1547\t  (let [value (decode-snapshot bs)]\n  1548\t    (when-not (bytes= bs (encode value))\n  1549\t      (refuse :non-canonical))\n  1550\t    value))\n   455\t\n   456\t\n   457\t(defn segment-value\n   458\t  \"The value of payload bytes stored at address: verifies the bytes hash to\n   459\t   the address under its carried algorithm, then decodes exactly one\n   460\t   accepted payload without re-encoding it (the canonicality check ran\n   461\t   once, at the ingress that accepted the bytes). Throws on a malformed\n   462\t   address, a digest mismatch, or bytes that do not decode.\"\n   463\t  [address bs]\n   464\t  (let [{:keys [algorithm digest]}\n   465\t        (or (parse-segment-address address)\n   466\t            (throw (ex-info \"not a segment content address\"\n   467\t                            {:address address})))]\n   468\t    (when-not (= digest (digest-bytes algorithm bs))\n   469\t      (throw (ex-info \"stored bytes do not hash to their content address\"\n   470\t                      {:address address})))\n   471\t    (cbor/decode-snapshot bs)))\n   472\t\n   473\t\n   474\t(defn materialize!\n   475\t  \"Content-address payload and store it through the handle's byte store.\n   352\t        (throw (ex-info \"Segment address does not match the bytes\"\n   353\t                        {:address address})))\n   354\t      (let [frame (frame-bytes address snapshot)]\n   355\t        (with-lock\n   356\t          lock\n   357\t          (fn []\n   358\t            (let [{:keys [closed? content]} @state]\n   359\t              (when closed?\n   360\t                (throw (ex-info \"Content file is closed\" {:address address})))\n   361\t              (if (contains? content address)\n   362\t                (if (cbor/bytes= (clojure.core/get content address) snapshot)\n   363\t                  :present\n   364\t                  (throw\n   365\t                    (ex-info\n   366\t                      (str \"Collision: address already holds a \"\n   367\t                           \"different payload\")\n   368\t                      {:address address})))\n   369\t                (do\n   370\t                  (append-frame! f frame)\n   371\t                  (sync-file! f)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/jing/remote/step_test.cljc | sed -n '1,110p'; nl -ba src/cljc/dao/jing/remote.cljc | sed -n '35,52p;95,108p'; nl -ba src/cljc/dao/jing/dht.cljc | sed -n '166,182p;233,252p'; nl -ba src/cljc/dao/jing/dht/node.cljc | sed -n '112,126p'; nl -ba src/cljc/dao/jing/file.cljc | sed -n '118,150p;280,305p'; nl -ba src/cljc/yin/vm/debruijn.cljc | sed -n '958,1018p;1025,1069p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/jing/remote/step_test.cljc | sed -n '1,110p'; nl -ba src/cljc/dao/jing/remote.cljc | sed -n '35,52p;95,108p'; nl -ba src/cljc/dao/jing/dht.cljc | sed -n '166,182p;233,252p'; nl -ba src/cljc/dao/jing/dht/node.cljc | sed -n '112,126p'; nl -ba src/cljc/dao/jing/file.cljc | sed -n '118,150p;280,305p'; nl -ba src/cljc/yin/vm/debruijn.cljc | sed -n '958,1018p;1025,1069p'\"","aggregated_output":"     1\t(ns dao.jing.remote.step-test\n     2\t  \"Tests for dao.jing.remote.step, the stepped (non-blocking) remote\n     3\t   content client.\n     4\t\n     5\t   The state-machine tests run on every host over two ring buffers and a\n     6\t   hand-turned server step (`dao.stream.apply/dispatch-request` over\n     7\t   `dao.jing.remote/default-handlers`, or a scripted lying backend where\n     8\t   the test is about a hostile answer); the one wire test runs its body on\n     9\t   the JVM only, against a real `serve-content!` endpoint, exactly as the\n    10\t   blocking client's `network-*` tests do.\"\n    11\t  (:require [clojure.test :refer [deftest is]]\n    12\t            [dao.jing :as jing]\n    13\t            [dao.jing.mem :as mem]\n    14\t            [dao.stream :as stream]\n    15\t            [dao.stream.apply :as apply]\n    16\t            [dao.stream.ringbuffer :as ring]\n    17\t            [dao.stream.rpc :as rpc]\n    18\t            [dao.jing.remote :as remote]\n    19\t            [dao.jing.remote.step :as step]\n    20\t            ;; :cljd first, as in remote_test: dao.stream.ws.jvm has no Dart\n    21\t            ;; twin, so a :clj-first spelling would become a Dart import.\n    22\t            ;; Used only inside the :clj wire-test branch.\n    23\t            #?@(:cljd [[\"dart:typed_data\" :as typed]]\n    24\t                :clj [[dao.stream.rpc.ws :as rpc.ws]\n    25\t                      [dao.stream.ws :as ws]\n    26\t                      [dao.stream.ws.jvm :as jvm]])))\n    27\t\n    28\t\n    29\t(defn- ring-handle\n    30\t  \"A fresh ring-buffer stream handle for the in-process media below.\"\n    31\t  [capacity]\n    32\t  (:dao.stream/handle\n    33\t    (ring/create! {:dao.stream/type ring/transport-type\n    34\t                   ring/capacity-key capacity})))\n    35\t\n    36\t\n    37\t(defn- ring-cursor\n    38\t  [handle]\n    39\t  (:dao.stream/cursor (stream/cursor handle :dao.stream/oldest)))\n    40\t\n    41\t\n    42\t(defn- make-server\n    43\t  \"A hand-turned server over one request/response ring pair: each `serve!`\n    44\t   call dispatches `handlers` over every request carried and not yet\n    45\t   served, appending one response per request.  The cursor atom is the\n    46\t   server's read position.\"\n    47\t  [handlers]\n    48\t  (let [request-handle (ring-handle 16)\n    49\t        response-handle (ring-handle 16)\n    50\t        cursor-atom (atom (ring-cursor request-handle))]\n    51\t    {:request request-handle\n    52\t     :response response-handle\n    53\t     :serve! (fn []\n    54\t               (loop [served 0]\n    55\t                 (let [read (stream/next request-handle @cursor-atom)]\n    56\t                   (if (= :dao.stream/ok (:dao.stream/outcome read))\n    57\t                     (do (reset! cursor-atom (:dao.stream/cursor read))\n    58\t                         (stream/append!\n    59\t                           response-handle\n    60\t                           (apply/dispatch-request handlers\n    61\t                                                   (:dao.stream/value read)))\n    62\t                         (recur (inc served)))\n    63\t                     served))))}))\n    64\t\n    65\t\n    66\t(defn- stepped-over\n    67\t  \"Stepped-client state over a hand-turned server's two ring buffers, with\n    68\t   no decoder: bare apply responses and bare lifecycle values are\n    69\t   accepted as-is.\"\n    70\t  [server]\n    71\t  (step/client-state\n    72\t    (rpc/client-state (:request server) (:response server)\n    73\t                      (ring-cursor (:response server)))))\n    74\t\n    75\t\n    76\t(defn- store-and-server\n    77\t  \"default-handlers over a fresh memory store, with a hand-turned server.\"\n    78\t  []\n    79\t  (let [store (mem/create-content-mem)]\n    80\t    {:store store\n    81\t     :server (make-server (remote/default-handlers store))}))\n    82\t\n    83\t\n    84\t(defn- b64\n    85\t  \"The wire form of a value: Base64 of its canonical bytes.\"\n    86\t  [v]\n    87\t  (jing/bytes->base64 (jing/canonical-bytes v)))\n    88\t\n    89\t\n    90\t(defn- host-bytes\n    91\t  \"A host byte object from a seq of ints 0-255.\"\n    92\t  [ints]\n    93\t  #?(:clj (byte-array (mapv unchecked-byte ints))\n    94\t     :cljs (js/Buffer.from (clj->js (vec ints)))\n    95\t     :cljd (typed/Uint8List.fromList ints)))\n    96\t\n    97\t\n    98\t(defn- lying-store\n    99\t  \"A backend handle that answers every put :present and every get with\n   100\t   `answer` (::absent reports absence) — the hostile server the verify\n   101\t   hop exists for.\"\n   102\t  [answer]\n   103\t  {:put-bytes-fn (fn [_address _bytes] :present)\n   104\t   :get-bytes-fn (fn [_address not-found]\n   105\t                   (if (= ::absent answer)\n   106\t                     not-found\n   107\t                     (jing/canonical-bytes answer)))})\n   108\t\n   109\t\n   110\t(deftest request-get-round-trips-and-decodes-totally\n    35\t(defn- accept-bytes!\n    36\t  \"The canonical payload bytes carried by the Base64 text b64 at address,\n    37\t   or a throw: this is the one ingress canonicality check for bytes Jing\n    38\t   did not encode itself (docs/design/dao.jing.cbor.md, Layering and\n    39\t   interfaces). The text must be strict Base64, the bytes must hash to the\n    40\t   address under its carried algorithm, and they must decode as exactly\n    41\t   one canonical payload.\"\n    42\t  [address b64]\n    43\t  (when-not (jing/segment-address? address)\n    44\t    (throw (ex-info \"content address must be a segment address\"\n    45\t                    {:address address})))\n    46\t  (let [bs (jing/base64->bytes b64)]\n    47\t    (when-not (jing/segment-bytes-match? address bs)\n    48\t      (throw (ex-info \"content address does not match payload hash\"\n    49\t                      {:address address})))\n    50\t    (cbor/decode bs)\n    51\t    bs))\n    52\t\n    95\t                    \"backend returned an invalid put result\"\n    96\t                    {:address address, :result result}))))),\n    97\t     :jing/get-content (fn [address]\n    98\t                         (when-not (jing/segment-address? address)\n    99\t                           (throw (ex-info\n   100\t                                    \"content address must be a segment address\"\n   101\t                                    {:address address})))\n   102\t                         (let [result (get-fn address local-missing)]\n   103\t                           (if (identical? result local-missing)\n   104\t                             {:found? false, :value nil}\n   105\t                             {:found? true,\n   106\t                              :value (jing/bytes->base64 result)})))}))\n   107\t\n   108\t\n   166\t\n   167\t(defn- accept-bytes\n   168\t  \"The canonical bytes of the Base64 text a peer answered for address, or\n   169\t   nil when the text, the digest, or the payload's canonicality fails: a\n   170\t   peer is untrusted, so this is the one ingress check before caching.\"\n   171\t  [address b64]\n   172\t  (try (let [bs (jing/base64->bytes b64)]\n   173\t         (when (jing/segment-bytes-match? address bs)\n   174\t           (cbor/decode bs)\n   175\t           bs))\n   176\t       (catch #?(:clj Throwable\n   177\t                 :cljs :default\n   178\t                 :cljd Object)\n   179\t              _\n   180\t         nil)))\n   181\t\n   182\t\n   233\t        v\n   234\t        (let [self-id (:id (self-peer net))\n   235\t              fetched\n   236\t              (some (fn [peer]\n   237\t                      (when (not= self-id (:id peer))\n   238\t                        (when-let [res (safe-fetch-content net peer address)]\n   239\t                          (when (:found? res)\n   240\t                            (when-let [bs (accept-bytes address (:value res))]\n   241\t                              [bs])))))\n   242\t                    (lookup net (content-target address)))]\n   243\t          (if fetched\n   244\t            (let [bs (first fetched)\n   245\t                  result ((:put-bytes-fn local) address bs)]\n   246\t              (when-not (#{:inserted :present} result)\n   247\t                (throw\n   248\t                  (ex-info\n   249\t                    \"dao.jing.dht: fetched content could not be cached\"\n   250\t                    {:address address, :result result})))\n   251\t              bs)\n   252\t            not-found))))))\n   112\t       ;; the bytes must decode as one canonical payload (the ingress\n   113\t       ;; check) before the local byte store sees them\n   114\t       :store-content\n   115\t       (let [{:keys [address v]} msg]\n   116\t         (try\n   117\t           (if (jing/segment-address? address)\n   118\t             (let [bs (jing/base64->bytes v)]\n   119\t               (if (jing/segment-bytes-match? address bs)\n   120\t                 (do (cbor/decode bs)\n   121\t                     (let [result ((:put-bytes-fn local) address bs)]\n   122\t                       (if (#{:inserted :present} result)\n   123\t                         {:ok true}\n   124\t                         {:ok false})))\n   125\t                 {:ok false}))\n   126\t             {:ok false})\n   118\t(defn- decode-frame\n   119\t  \"[address payload-bytes] of one frame: the frame must be exactly one\n   120\t   canonical two-element CBOR array of byte strings, the digest must be\n   121\t   the payload's under some registered algorithm (which then names the\n   122\t   address), and the payload must itself be a canonical Jing payload.\"\n   123\t  [frame]\n   124\t  (let [v (try (cbor/decode frame)\n   125\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   126\t                 (throw (ex-info \"Frame is not a canonical CBOR record\"\n   127\t                                 {:frame frame} e))))]\n   128\t    (when-not (and (vector? v) (= 2 (count v))\n   129\t                   (every? cbor/byte-payload? v))\n   130\t      (throw (ex-info \"Frame is not a [digest payload] array of byte strings\"\n   131\t                      {:record v})))\n   132\t    (let [[digest payload] v\n   133\t          hex (bytes->hex digest)\n   134\t          address-id\n   135\t          (some (fn [[algorithm {:keys [address-id digest-bytes]}]]\n   136\t                  (when (and (= digest-bytes (byte-count digest))\n   137\t                             (= hex (jing/digest-bytes algorithm payload)))\n   138\t                    address-id))\n   139\t                (sort-by key jing/registry))]\n   140\t      (when-not address-id\n   141\t        (throw (ex-info\n   142\t                 (str \"Frame digest is not the payload's under any \"\n   143\t                      \"registered algorithm\")\n   144\t                 {:digest hex})))\n   145\t      (try (cbor/decode payload)\n   146\t           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   147\t             (throw (ex-info \"Frame payload is not a canonical Jing payload\"\n   148\t                             {:digest hex} e))))\n   149\t      [(keyword \"segment\" (str address-id \"-\" hex)) payload])))\n   150\t\n   280\t\n   281\t(defn- recover!\n   282\t  \"Every complete frame of the file, decoded and validated in order as\n   283\t   [address payload-bytes], with the incomplete tail truncated afterwards.\n   284\t   Validation precedes mutation: a corrupt complete frame, or a nonempty\n   285\t   file with no valid first frame, throws with the file untouched.\"\n   286\t  [f]\n   287\t  (let [end (file-length! f)\n   288\t        cut (torn-tail-offset f end)\n   289\t        records (loop [offset 0, acc []]\n   290\t                  (if (>= offset cut)\n   291\t                    acc\n   292\t                    (let [len (read-int! f offset)]\n   293\t                      (recur (+ offset prefix-size len)\n   294\t                             (conj acc\n   295\t                                   (decode-frame\n   296\t                                     (read-bytes! f (+ offset prefix-size)\n   297\t                                                  len)))))))]\n   298\t    (when (and (pos? end) (empty? records))\n   299\t      (throw (ex-info \"Not a content log: no valid first frame\"\n   300\t                      {:length end})))\n   301\t    (when (< cut end) (truncate-file! f cut))\n   302\t    records))\n   303\t\n   304\t\n   305\t(defn- replay-records\n   958\t   digest's derivation moved to the canonical encoder, so the separator\n   959\t   now separates this dimension from every other by the same bytes every\n   960\t   node hash uses.\"\n   961\t  (jing/sha256 (encode-value descriptor)))\n   962\t\n   963\t\n   964\t(defn canonical-value\n   965\t  \"A record's stored scalar is its canonical spelling (the carried D3\n   966\t   obligation): the long form for integers and the double form for\n   967\t   doubles, so 1 and 1.0 hold distinct record contents on JVM/Dart; the\n   968\t   NFC form for strings and ident parts, and the same recursively inside\n   969\t   collections. One content address, one record content: equal fingerprints\n   970\t   imply equal :records maps.\n   971\t   Canonicalizing a map whose keys merge (for example, two string keys\n   972\t   with one NFC form) is a key collision, diagnosed rather than letting\n   973\t   iteration order decide which entry survives; a set whose elements\n   974\t   merge (such as two distinct spellings of one NFC string) is diagnosed\n   975\t   the same way, because the merge changes its count, not just a scalar's\n   976\t   spelling.\"\n   977\t  [v]\n   978\t  (let [class (canonical-class v)]\n   979\t    (case class\n   980\t      :nil v\n   981\t      :bool v\n   982\t      :int64 (long v)\n   983\t      :double (double v)\n   984\t      :string (normalize-nfc v)\n   985\t      :bytes v\n   986\t      :keyword (if-let [ns (namespace v)]\n   987\t                 (keyword (normalize-nfc ns) (normalize-nfc (name v)))\n   988\t                 (keyword (normalize-nfc (name v))))\n   989\t      :symbol (if-let [ns (namespace v)]\n   990\t                (symbol (normalize-nfc ns) (normalize-nfc (name v)))\n   991\t                (symbol (normalize-nfc (name v))))\n   992\t      :map (let [canonical (into {}\n   993\t                                 (map (fn [[k x]]\n   994\t                                        [(canonical-value k) (canonical-value x)]))\n   995\t                                 v)]\n   996\t             (if (< (count canonical) (count v))\n   997\t               (throw (ex-info \"Canonicalizing a map merges distinct keys\"\n   998\t                               {:rule :unsupported-value, :value v}))\n   999\t               canonical))\n  1000\t      :set (let [canonical (into (empty v) (map canonical-value) v)]\n  1001\t             (if (< (count canonical) (count v))\n  1002\t               (throw (ex-info \"Canonicalizing a set merges distinct elements\"\n  1003\t                               {:rule :unsupported-value, :value v}))\n  1004\t               canonical))\n  1005\t      :vector (mapv canonical-value v)\n  1006\t      ;; with-meta nil: ClojureDart's list constructor stamps its own\n  1007\t      ;; {:tag PersistentList} metadata (a Dart Type) on every list it\n  1008\t      ;; builds, and -conj preserves it. A stored scalar is content, not\n  1009\t      ;; provenance: the strict cbor encoder refuses the Type, so the\n  1010\t      ;; record value must carry no constructor metadata, on any host.\n  1011\t      :list (with-meta (apply list (map canonical-value v)) nil)\n  1012\t      v)))\n  1013\t\n  1014\t\n  1015\t(defn- node-hash\n  1016\t  \"§5: hash(node) = SHA-256(dimension-hash || encode(tag-specific-slots-\n  1017\t   in-descriptor-order)). The preimage is the dimension hash's hex\n  1018\t   followed by the framed slots under the settled byte rules; the shape —\n  1025\t\n  1026\t;; =============================================================================\n  1027\t;; D2: hash-consing and the projected records (§4)\n  1028\t;; =============================================================================\n  1029\t\n  1030\t(defn- slot-encodings\n  1031\t  \"The descriptor-order encodings of one record's present, non-marker\n  1032\t   slots — with the dimension hash, the only input to a node hash.\n  1033\t   Children already carry child hashes, so this is total over a record\n  1034\t   and serves both the mint and the storage reader's content check.\"\n  1035\t  [record]\n  1036\t  (for [[slot type role] dimension-slots\n  1037\t        :when (and (not= :marker role) (contains? record slot))]\n  1038\t    (encode-typed type (get record slot))))\n  1039\t\n  1040\t\n  1041\t(defn- mint-record\n  1042\t  \"Hash-cons one resolved node (§4-§5) whose children are already\n  1043\t   minted, their hashes in `child-hashes` ({slot h}, an ordered vector\n  1044\t   under :yin.debruijn/operands): the node hash over the dimension hash\n  1045\t   and the node's tag-specific slots in descriptor order, then the record\n  1046\t   — the node with child slots carrying child hashes, scalars in their\n  1047\t   canonical spellings, and :yin.debruijn/hash added. Returns [h acc']\n  1048\t   over {:hashcons preimage->h, :records h->record, :mints n}; :mints\n  1049\t   counts every call, the walk's instrumentation seam. The consing memo\n  1050\t   is keyed on the node's preimage — the concatenated slot encodings —\n  1051\t   never on Clojure =, which merges a list literal with a vector literal\n  1052\t   and the signed zeros; a preimage hit implies the identical hash and,\n  1053\t   records carrying canonical spellings, the identical record. The memo\n  1054\t   stays an optimisation only: identity is the hash either way, so\n  1055\t   traversal order never enters it.\"\n  1056\t  [node child-hashes acc]\n  1057\t  (let [acc (update acc :mints inc)\n  1058\t        record (reduce (fn [r [slot _type role]]\n  1059\t                         (cond\n  1060\t                           (or (= :marker role) (not (contains? node slot))) r\n  1061\t                           (= :child role) (assoc r slot (get child-hashes slot))\n  1062\t                           ;; the carried D3 obligation: a record's stored\n  1063\t                           ;; scalar is its canonical spelling, so equal\n  1064\t                           ;; fingerprints imply equal records\n  1065\t                           :else (assoc r slot (canonical-value (get node slot)))))\n  1066\t                       node\n  1067\t                       dimension-slots)\n  1068\t        encodings (slot-encodings record)\n  1069\t        preimage (apply str encodings)]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The repaired stepped receipt now hashes the Base64-decoded bytes and then calls strict `cbor/decode`; any refusal returns through the integrity-failure completion. The sentinel is a single private host object, so it avoids the Node keyword-identity problem and cannot be produced by the closed CBOR decoder. I’m checking the remaining ingress call sites and whether the new test really distinguishes strict decode from snapshot decode."}}
