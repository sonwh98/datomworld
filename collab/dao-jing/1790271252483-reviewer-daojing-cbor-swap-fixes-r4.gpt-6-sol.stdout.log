ny host (not IObj / IWithMeta;\n  1111\t    ;; pinned by a test), so there is none to wrap.\n  1112\t    (keyword? x) (identifier-wire 'dao.jing/keyword x d)\n  1113\t    (symbol? x) (meta-wire x d #(identifier-wire 'dao.jing/symbol x %))\n  1114\t    (wire/byte-payload? x) (do (deep! d :unsupported-value)\n  1115\t                               (wire/byte-string (copy-range x 0 (blen x))))\n  1116\t    (numeric? x) (number-wire x d)\n  1117\t    (record? x) (refuse :unsupported-value \"record\")\n  1118\t    (map? x) (meta-wire x d #(map-wire x %))\n  1119\t    (vector? x) (meta-wire x d (fn [d]\n  1120\t                                 (deep! d :unsupported-value)\n  1121\t                                 (wire/array-node\n  1122\t                                   (mapv #(wire-of % (inc d)) x))))\n  1123\t    (set? x) (meta-wire x d #(set-wire x %))\n  1124\t    (or (list? x) (seq? x)) (meta-wire x d #(list-wire x %))\n  1125\t    :else (refuse :unsupported-value (type-name x))))\n  1126\t\n  1127\t\n  1128\t(defn encode\n  1129\t  \"The canonical CBOR payload bytes of one supported value (byte[] on the\n   175\t  pre-validation is unverified; Jing owns this rule regardless.\n   176\t- Lists and sequences share a representation distinct from vectors. Use\n   177\t  CBOR tag 27 with the name `dao.jing/list` and an array argument; plain\n   178\t  CBOR arrays represent vectors.\n   179\t- Preserve collection and symbol metadata using Boring's `clojure/with-meta`\n   180\t  mapping. Strip `:line`, `:column`, `:end-line`, and `:end-column`; omit empty\n   181\t  metadata. Clear metadata on internally constructed Dart collections\n   182\t  before attaching supplied metadata. Do not strip arbitrary user `:tag`\n   183\t  metadata as a workaround for Dart constructor metadata. This clearing\n   184\t  covers only collections Jing constructs at decode: a Dart producer\n   185\t  building a payload with `list` must still clear ClojureDart's constructor\n   186\t  metadat