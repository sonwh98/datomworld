         2))))\n   621\t    (testing \"semantic metadata beside the position is retained\"\n   622\t      (is (= {:meaning 1}\n   623\t             (meta (first (slot (lit [(with-meta 'x (assoc pos :meaning 1))])\n   624\t                                2))))))\n   625\t    (testing \"collection types and values are unchanged\"\n   626\t      ;; quoted list, not (list ...): a runtime list on ClojureDart\n   627\t      ;; carries the constructor's own {:tag PersistentList} metadata,\n   628\t      ;; which the projection keeps (it strips reader positions only)\n   629\t      ;; and the strict encoder then refuses; a quote carries positions\n   630\t      ;; only, which the projection strips\n   631\t      (let [v (slot (lit ['(1 2) #{3} {:a [4]}]) 2)]\n   632\t        (is (= ['(1 2) #{3} {:a [4]}] v))\n   633\t        (is (list? (first v)))\n   634\t        (is (set? (second v)))))\n   635\t    (testing \"a map entry payload stays the vector [k v]\"\n   636\t      (let [v (slot (lit (first {:a 1})) 2)\n   637\t            bc (vm/ast->semantic-bytecode (lit (first {:a 1})))]\n   638\t        (is (vector? v))\n   639\t        (is (= [:a 1] v))\n24:   * metadata on collections and symbols: tag 27 `clojure/with-meta` over\n27:     metadata.\n34:   stringref and date tags, with-meta, a dropped trailing index frame, and\n785:   metadata ignored. This is the equality whose collapses encode and\n875:   element by element, maps and sets by members, metadata ignored, any other\n899:   metadata ignored. Unlike equiv, (content= 1 1.0) is false.\"\n1063:   content starting at that depth. If x carries metadata that survives\n1064:   stripping, a with-meta frame sits at d and x's content moves two\n1066:   first (ruling A9); a metadata map carrying its own metadata is\n1073:            (refuse :malformed-frame \"metadata map carries metadata\"))\n1080:              (wire/frame 'clojure/with-meta\n1110:    ;; Keywords cannot carry metadata on any host (not IObj / IWithMeta;\n1270:  