\"deletions\": 11,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/data/btree_async_test.cljc\",\n      \"additions\": 3,\n      \"deletions\": 3,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/data/btree_durability_test.cljc\",\n      \"additions\": 25,\n      \"deletions\": 16,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/data/psset_fixtures.cljc\",\n      \"additions\": 2528,\n      \"deletions\": 2549,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/dht/node_test.cljc\",\n      \"additions\": 7,\n      \"deletions\": 6,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/dht_test.cljc\",\n      \"additions\": 52,\n      \"deletions\": 36,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/file_test.cljc\",\n      \"additions\": 215,\n      \"deletions\": 38,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/hash_registry_contract_test.cljc\",\n      \"additions\": 98,\n      \"deletions\": 52,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/mem_test.cljc\",\n      \"additions\": 134,\n      \"deletions\": 56,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/remote/step_test.cljc\",\n      \"additions\": 55,\n      \"deletions\": 9,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing/remote_test.cljc\",\n      \"additions\": 60,\n      \"deletions\": 13,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/jing_test.cljc\",\n      \"additions\": 80,\n      \"deletions\": 52,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/space/index_test.cljc\",\n      \"additions\": 17,\n      \"deletions\": 16,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/space/query_test.cljc\",\n      \"additions\": 6,\n      \"deletions\": 6,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/space/transactor_test.cljc\",\n      \"additions\": 6,\n      \"deletions\": 6,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/dao/stream/transit_test.cljc\",\n      \"additions\": 4,\n      \"deletions\": 3,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/resources/dao/jing/digest-table.edn\",\n      \"additions\": 56,\n      \"deletions\": 37,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm/content_test.cljc\",\n      \"additions\": 17,\n      \"deletions\": 14,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm/debruijn_linker_test.cljc\",\n      \"additions\": 22,\n      \"deletions\": 7,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm/macro_build_test.clj\",\n      \"additions\": 11,\n      \"deletions\": 5,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm/macro_test.cljc\",\n      \"additions\": 25,\n      \"deletions\": 9,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm/malformed_rows.cljc\",\n      \"additions\": 7,\n      \"deletions\": 1,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm/pipeline_test.cljc\",\n      \"additions\": 39,\n      \"deletions\": 26,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    },\n    {\n      \"path\": \"test/yin/vm_test.cljc\",\n      \"additions\": 34,\n      \"deletions\": 25,\n      \"category\": \"Tests\",\n      \"risk_level\": \"Low\"\n    }\n  ],\n  \"findings\": [],\n  \"commits\": [\n    \"b4ff6e0d docs(repl): remove stale v2 references from docstrings and usage guide\",\n    \"c12e3ca5 refactor(repl): rename yin.repl.core to yin.repl and split host entry to yin.repl.main\",\n    \"743cd681 Merge branch 'yin-repl-vm-stream': wire 4 VMs to yin.repl via dao.stream\",\n    \"e53654ae docs(design): deprecate v1 streams doc and update orchestrator log\",\n    \"c82139db feat(yin.repl): wire 4 VMs and establish dao.stream universal boundary\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
