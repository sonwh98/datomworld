al bytes; the\n   311\t            ;; bytes must hash to the requested address and decode as one\n   312\t            ;; canonical payload before a value is published\n   313\t            (= get-content-op op)\n   314\t            (if (presence-envelope? value)\n   315\t              (if (:found? value)\n   316\t                (let [address (first (:dao.stream.rpc/args completion))\n   317\t                      bs (accepted-bytes address (:value value))\n   318\t                      decoded (when bs\n   319\t                                (try (cbor/decode bs)\n   320\t                                     (catch #?(:cljd Object\n   321\t                                               :clj Throwable\n   322\t                                               :cljs :default)\n   323\t                                            _\n   324\t                                       refused)))]\n   325\t                  (if (or (nil? bs) (identical? refused decoded))\n   326\t                    {:id id :op op\n   327\t                     :error {:dao.stream.apply/code integrity-failure-code\n   328\t                             :dao.stream.apply/message\n   329\t                             (str \"the remote content does not hash to \"\n   330\t                                  \"its content address\")}}\n   331\t                    {:id id :op op :found? true :value decoded}))\n   332\t                {:id id :op op :found? false :value nil})\n   333\t              {:id id :op op :error (malformed-response op)})\n   334\t\n   335\t            :else\n   390\t              :else\n   391\t              (finish {:error (malformed-response put-content-op)}))\n   392\t            ;; :verify-issued — the verify read answered.\n   393\t            (cond\n   394\t              (not (presence-envelope? value))\n   395\t              (finish {:error (malformed-response get-content-op)})\n   396\t\n   397\t              (not (:found? value))\n   398\t              (finish {:error {:dao.stream.apply/code present-but-absent-code\n   399\t                               :dao.stream.apply/message\n   400\t                               \"the remote reported :present but the content address is absent\"}})\n   401\t\n   402\t              (some? (accepted-bytes (:address record) (:value value)))\n   403\t              (finish {:result :present})\n   404\t\n   405\t              :else\n   406\t              (finish {:error {:dao.stream.apply/code integrity-failure-code\n   407\t                               :dao.stream.apply/message\n   408\t                               \"the remote content does not hash to its content address\"}}))))))))\n   160\t    (throw (ex-info \"dao.jing.dht: not a segment content address\"\n   161\t                    {:address address})))\n   162\t  (when-not (jing/segment-bytes-match? address bs)\n   163\t    (throw (ex-info \"dao.jing.dht: content address does not match the bytes\"\n   164\t                    {:address address}))))\n   165\t\n   166\t\n   167\t(defn- accept-bytes\n   168\t  \"The canonical bytes of the Base64 text a peer answered for address, or\n   169\t   nil when the text, the digest, or the payload's canonicality fails: a\n   170\t   peer is untrusted, so this is the one ingress check before caching.\"\n   171\t  [address b64]\n   172\t  (try (let [bs (jing/base64->bytes b64)]\n   173\t         (when (jing/segment-bytes-match? address bs)\n   174\t           (cbor/decode bs)\n   175\t           bs))\n   176\t       (catch #?(:clj Throwable\n   177\t                 :cljs :default\n   178\t                 :cljd Object)\n   179\t              _\n   180\t         nil)))\n   237\t                      (when (not= self-id (:id peer))\n   238\t                        (when-let [res (safe-fetch-content net peer address)]\n   239\t                          (when (:found? res)\n   240\t                            (when-let [bs (accept-bytes address (:value res))]\n   241\t                              [bs])))))\n   242\t                    (lookup net (content-target address)))]\n   243\t          (if fetched\n   244\t            (let [bs (first fetched)\n   245\t                  result ((:put-bytes-fn local) address bs)]\n   246\t              (when-not (#{:inserted :present} result)\n   247\t                (throw\n   248\t                  (ex-info\n   249\t                    \"dao.jing.dht: fetched content could not be cached\"\n   250\t                    {:address address, :result result})))\n   251\t              bs)\n   252\t            not-found))))))\n   253\t\n   108\t       ;; segment address for the payload, never a bare hash, a\n   109\t       ;; foreign namespace, or a mismatched value, and the local\n   110\t       ;; backend's verdict must be an explicit :inserted/:present\n   111\t       ;; :v is the canonical payload bytes as padded standard Base64;\n   112\t       ;; the bytes must decode as one canonical payload (the ingress\n   113\t       ;; check) before the local byte store sees them\n   114\t       :store-content\n   115\t       (let [{:keys [address v]} msg]\n   116\t         (try\n   117\t           (if (jing/segment-address? address)\n   118\t             (let [bs (jing/base64->bytes v)]\n   119\t               (if (jing/segment-bytes-match? address bs)\n   120\t                 (do (cbor/decode bs)\n   121\t                     (let [result ((:put-bytes-fn local) address bs)]\n   122\t                       (if (#{:inserted :present} result)\n   123\t                         {:ok true}\n   124\t                         {:ok false})))\n   125\t                 {:ok false}))\n","exit_code":0,"status":"completed"}}
