2\t                                        {:client client}))))]\n   133\t    {:client client,\n   134\t     :closed-atom closed-atom,\n   135\t     :put-bytes-fn (fn [address bs]\n   136\t                     (ensure-open)\n   137\t                     (call-fn client :jing/put-content\n   138\t                              [address (jing/bytes->base64 bs)])),\n   139\t     :get-bytes-fn\n   140\t     (fn [address not-found]\n   141\t       (ensure-open)\n   142\t       (let [resp (call-fn client :jing/get-content [address])\n   143\t             bs (when (and (valid-presence-envelope? resp) (:found? resp))\n   144\t                  (try (jing/base64->bytes (:value resp))\n   145\t                       (catch #?(:cljd Object :clj Throwable :cljs :default)\n   146\t                              _\n   147\t                         nil)))]\n   148\t         (cond\n   149\t           ;; A found reply is remote ingress: before its bytes leave\n   150\t           ;; this handle they must hash to the requested address and\n   151\t           ;; decode as exactly one canonical payload, mirroring\n   152\t           ;; accept-bytes! above -- jing/get's snapshot decode does\n   153\t           ;; not re-check canonicality, so a hash-valid, noncanonical\n   154\t           ;; reply served under its own address would otherwise be\n   155\t           ;; exposed (docs/design/dao.jing.cbor.md, the remote-ingress\n   156\t           ;; contract).\n   157\t           (some? bs)\n   158\t           (do (when-not (jing/segment-bytes-match? address bs)\n   159\t                 (throw (ex-info\n   160\t                          \"content address does not match payload hash\"\n   161\t                          {:address address})))\n   162\t               (cbor/decode bs)\n   163\t               bs)\n   164\t           (and (valid-presence-envelope? resp) (not (:found? resp)))\n   165\t           not-found\n   166\t           :else\n   167\t           (throw\n   168\t             (ex