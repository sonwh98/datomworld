31\t                    (cbor/bytes= stored bs))\n   532\t               address\n   533\t               :else\n   534\t               (throw\n   535\t                 (ex-info\n   536\t                   (str \"content collision: the stored bytes do not match \"\n   537\t                        \"their content address\")\n   538\t                   {:address address, :payload payload}))))\n   539\t           (throw (ex-info\n   540\t                    \"invalid backend put result\"\n   541\t                    {:result result, :address address, :payload payload}))))))))\n   143\t(defn- presence-envelope?\n   144\t  \"True only for the exact wire envelope `{:found? boolean :value v}` (H4),\n   145\t   the shape `:jing/get-content` answers.  Mirrors `dao.jing.remote`'s\n   146\t   private validator; this namespace depends on the rpc core, not on the\n   147\t   blocking driver's namespace.\"\n   148\t  [x]\n   149\t  (and (map? x)\n   150\t       (= #{:found? :value} (set (keys x)))\n   151\t       (let [f (:found? x)] (or (true? f) (false? f)))))\n   152\t\n   153\t\n   154\t(defn- segment-address!\n   155\t  \"Throw unless `address` is a segment address (C1: arbitrary keys and\n   156\t   mutable roots are refused before the backend — here, before the wire).\"\n   157\t  [address]\n   158\t  (when-not (jing/segment-address? address)\n   159\t    (throw (ex-info \"a stepped content request names a non-segment address\"\n   160\t                    {:address address}))))\n   161\t\n   234\t\n   235\t(defn request-materialize\n   236\t  \"Request one remote materialization of `payload`: the address is derived\n   237\t   here, the put is submitted, and the returned `:id` is the put id the one\n   238\t   completion will carry. Supports explicit algorithm via opts:\n   239\t   `{:algorithm :sha256}`.\"\n   240\t  ([state payload]\n   241\t   (request-materialize state payload {}))\n   242\t  ([state payload opts]\n   243\t   (let [bs (jing/canonical-bytes payload)\n  