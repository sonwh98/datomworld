/jing/file.cljc:421:           {:put-bytes-fn (make-put state f lock),\nsrc/cljc/dao/jing/file.cljc:422:            :get-bytes-fn (make-get state),\nsrc/cljc/dao/jing/dht.cljc:9:      :put-bytes-fn f, :get-bytes-fn g, :close-fn c}\nsrc/cljc/dao/jing/dht.cljc:174:           (cbor/decode bs)\nsrc/cljc/dao/jing/dht.cljc:208:    (let [result ((:put-bytes-fn local) address bs)]\nsrc/cljc/dao/jing/dht.cljc:231:    (let [v ((:get-bytes-fn local) address content-missing)]\nsrc/cljc/dao/jing/dht.cljc:245:                  result ((:put-bytes-fn local) address bs)]\nsrc/cljc/dao/jing/dht.cljc:291:      :put-bytes-fn f, :get-bytes-fn g, :close-fn c}\nsrc/cljc/dao/jing/dht.cljc:295:   :put-bytes-fn and :get-bytes-fn (dao.jing.mem/create-content-mem or\nsrc/cljc/dao/jing/dht.cljc:306:  (when-not (fn? (:put-bytes-fn local))\nsrc/cljc/dao/jing/dht.cljc:307:    (throw (ex-info \"dao.jing.dht local requires :put-bytes-fn\"\nsrc/cljc/dao/jing/dht.cljc:309:  (when-not (fn? (:get-bytes-fn local))\nsrc/cljc/dao/jing/dht.cljc:310:    (throw (ex-info \"dao.jing.dht local requires :get-bytes-fn\"\nsrc/cljc/dao/jing/dht.cljc:315:           :put-bytes-fn (make-put handle)\nsrc/cljc/dao/jing/dht.cljc:316:           :get-bytes-fn (make-get handle)\nsrc/cljc/dao/jing/cbor.cljc:1524:(defn decode-snapshot\nsrc/cljc/dao/jing/cbor.cljc:1543:   Uint8List): the ingress check. Refuses everything `decode-snapshot`\nsrc/cljc/dao/jing/cbor.cljc:1547:  (let [value (decode-snapshot bs)]\nsrc/cljc/dao/jing/remote.cljc:8:   :put-bytes-fn f :get-bytes-fn g :close-fn h} that jing/materialize!,\nsrc/cljc/dao/jing/remote.cljc:50:    (cbor/decode bs)\nsrc/cljc/dao/jing/remote.cljc:79:  (let [put (:put-bytes-fn handle)\nsrc/cljc/dao/jing/remote.cljc:80:        get-fn (:get-bytes-fn handle)\nsrc/cljc/dao/jing/remote.cljc:85:      (throw (ex-info \"handle must expose a :put-bytes-fn\" {:handle handle})))\nsrc/cljc/dao/jing/remote.cljc:87:      (throw (ex-info \"handle must expose a :get-bytes-fn\" {:handle handle})))\nsrc/cljc/dao/jing/remote.cljc:135:     :put-bytes-fn (fn [address bs]\nsrc/cljc/dao/jing/remote.cljc:139:     :get-bytes-fn\nsrc/cljc/dao/jing/remote.cljc:162:               (cbor/decode bs)\nsrc/cljc/dao/jing.cljc:5:   {:put-bytes-fn f, :get-bytes-fn g, :close-fn c}\nsrc/cljc/dao/jing.cljc:207:(def default-hash-algorithm\nsrc/cljc/dao/jing.cljc:213:(def registry\nsrc/cljc/dao/jing.cljc:471:    (cbor/decode-snapshot bs)))\nsrc/cljc/dao/jing.cljc:482:   :put-bytes-fn as (put-bytes-fn address bytes). The backend must answer\nsrc/cljc/dao/jing.cljc:492:   On :present the stored bytes are read back through :get-bytes-fn and\nsrc/cljc/dao/jing.cljc:500:   (let [put (:put-bytes-fn handle)\nsrc/cljc/dao/jing.cljc:501:         get-fn (:get-bytes-fn handle)]\nsrc/cljc/dao/jing.cljc:503:       (throw (ex-info \"dao.jing handle requires :put-bytes-fn\"\nsrc/cljc/dao/jing.cljc:506:       (throw (ex-info \"dao.jing handle requires :get-bytes-fn\"\nsrc/cljc/dao/jing.cljc:556:  (let [get-fn (:get-bytes-fn handle)]\nsrc/cljc/dao/jing.cljc:558:      (throw (ex-info \"dao.jing handle requires :get-bytes-fn\"\n    41\t\n    42\t\n    43\t(defn- put-bytes-fn\n    44\t  \"Backend effect for one byte store: atomic insert-if-absent of a copy of\n    45\t   the bytes. The winner of the CAS returns :inserted; an existing equal\n    46\t   snapshot returns :present; an existing unequal snapshot is a collision\n    47\t   and throws. The closed check happens inside the loop so the operation is\n    48\t   linearizable against close.\"\n    49\t  [state]\n    50\t  (fn [address bs]\n    51\t    ;; copy first: the caller owns bs and may change it at any moment, so\n    52\t    ;; validation and every later comparison see only the snapshot\n    53\t    (let [snapshot (cbor/copy-bytes bs)]\n    54\t      (validate-address-bytes! address snapshot)\n    55\t      (loop []\n    56\t        (let [s @state\n    57\t              content (:content s)]\n    58\t          (when (:closed? s)\n    59\t            (throw (ex-info \"dao.jing.mem: content store is closed\"\n    60\t                            {:address address})))\n    61\t          (if (contains? content address)\n    62\t            (if (cbor/bytes= (get content address) snapshot)\n    63\t              :present\n    64\t              (throw\n    65\t                (ex-info\n    66\t                  (str \"dao.jing.mem: content collision: unequal bytes \"\n    67\t                       \"at the same content address\")\n    68\t                  {:address address})))\n    69\t            (if (compare-and-set! state\n    70\t                                  s\n    71\t                                  (assoc s :content\n    72\t                                         (assoc content address snapshot)))\n    73\t              :inserted\n    74\t              (recur))))))))\n    75\t\n    76\t\n    77\t(defn- get-bytes-fn\n    78\t  \"Backend effect for one byte store: lookup with a caller-supplied\n    79\t   not-found, answering a fresh copy of the stored bytes so the snapshot\n    80\t   stays immutable.\"\n    81\t  [state]\n    82\t  (fn [address not-found]\n    83\t    (let [{:keys [closed? content]} @state]\n    94\t  [state]\n    95\t  (fn [] (swap! state assoc :closed? true) nil))\n    96\t\n    97\t\n    98\t(defn- entries-fn\n    99\t  \"The test-facing snapshot: a map of content address to a fresh copy of\n   100\t   the stored bytes, readable after close.\"\n   101\t  [state]\n   102\t  (fn []\n   103\t    (into {}\n   104\t          (map (fn [[address bs]] [address (cbor/copy-bytes bs)]))\n   105\t          (:content @state))))\n   106\t\n   107\t\n   108\t(defn create-content-mem\n   109\t  \"Create an ephemeral, thread-safe, content-addressed in-memory DaoJing\n   110\t   byte store.\n   111\t\n   112\t   Returns plain data:\n   113\t\n   114\t     {:put-bytes-fn f\n   115\t      :get-bytes-fn g\n   116\t      :close-fn c\n   117\t      :entries-fn e}\n   118\t\n   119\t   The priva