do not decode.\"\n   198\t  [bs]\n   199\t  (try (cbor/decode bs)\n   200\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   201\t         nil)))\n   202\t\n   203\t\n   204\t(defn- identity-of\n   205\t  \"Step 3's hash, or nil when `value` cannot be hashed under the format\n   206\t   at all (a malformed payload hashes to no identity).\"\n   207\t  [format value]\n   208\t  (try ((:hash-fn format) value)\n   209\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   210\t         nil)))\n   211\t\n   212\t\n   213\t(defn- validation-defect\n   214\t  [format value]\n   215\t  (try ((:validate-fn format) value)\n   216\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   217\t         {:rule :validator-refused})))\n   218\t\n   219\t\n   220\t(defn fetch\n   221\t  \"Fetches and verifies an image by its identity using handle, index, and\n   222\t   format record. Used by stack and register VMs alike. Returns the\n   223\t   verified image `{:status :ok ...}` or a qualified refusal.\n   224\t\n   225\t   `handle` is any DaoJing content handle; `index` is a map or function\n   205\t;; Step 1 and 2: :absent (S11.4)\n   206\t;; =============================================================================\n   207\t\n   208\t(deftest absent-identity-or-payload-is-refused\n   209\t  (doseq [[label format mint] formats]\n   210\t    (testing label\n   211\t      (let [store (mem/create-content-mem)\n   212\t            image (mint worked-example)\n   213\t            identity ((:hash-fn format) image)\n   214\t            unstored (jing/segment-key image)]\n   215\t        (is (= {:status :refused, :reason :absent, :identity identity}\n   216\t               (linker/fetch store {} format identity receiver))\n   217\t            \"step 1: the index has no entry\")\n   218\t        (is (= {:status :refused, :reason :absent, :address unstored}\n   219\t               (linker/fetch store {identity unstored} format identity\n   220\t                             receiver))\n   221\t            \"step 2: the address has no payload in the store\")\n   222\t        (is (= :absent\n   223\t               (:reason (linker/fetch store {identity :segment/garbage}\n   224\t                                      format identity receiver)))\n   225\t            \"an index entry that is no Jing address has no payload\")\n   226\t        (jing/close! store)))))\n   227\t\n   228\t\n   229\t;; =============================================================================\n   230\t;; Step 2: :address-mismatch (S11.5)\n   231\t;; =============================================================================\n   232\t\n   233\t(deftest local-storage-corruption-is-an-address-mismatch\n   234\t  (doseq [[label format mint] formats]\n   235\t    (testing label\n   236\t      (let [store (mem/create-content-mem)\n   237\t            image (mint worked-example)\n   238\t            {:keys [identity index]} (publish store format image)\n   239\t            res (linker/fetch (corrupt-store store) index format identity\n   240\t                              receiver)]\n   241\t        (is (= :address-mismatch (:reason res)))\n   242\t        (is (= (tamper image) (:value res)))\n   243\t        (is (= (index identity) (:address res)))\n   244\t        (jing/close! store)))))\n   245\t\n   246\t\n   247\t;; RPC-reply corruption is now refused at the client ingress boundary\n   248\t;; (remote.cljc hash-verify + strict decode on every found reply), so\n   249\t;; read-address's documented fail-closed catch classifies the handle\n   250\t;; failure :absent; store-level corruption (above) still reaches the\n   251\t;; linker's own step-2 check and remains :address-mismatch.\n   252\t(deftest corrupt-rpc-response-is-an-address-mismatch\n   253\t  (doseq [[label format mint] formats]\n   254\t    (testing label\n   255\t      (let [store (mem/create-content-mem)\n   256\t            image (mint worked-example)\n   257\t        