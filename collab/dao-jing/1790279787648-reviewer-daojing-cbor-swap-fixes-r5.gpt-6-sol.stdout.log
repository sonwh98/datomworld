{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/jing/remote.cljc | sed -n '1,180p'; nl -ba src/cljc/dao/jing.cljc | sed -n '435,575p'; nl -ba test/dao/jing/remote_test.cljc | sed -n '320,455p'\"","aggregated_output":"     1\t(ns dao.jing.remote\n     2\t  \"Remote content adapter over DaoStream v2.\n     3\t   Server side: dao.jing.remote/default-handlers exposes a local dao.jing\n     4\t   content handle as the :jing/put-content and :jing/get-content operations,\n     5\t   and serve-content! serves any {op fn} handler map over a v2 WebSocket\n     6\t   endpoint. Client side: dao.jing.remote/content-client wraps an injected\n     7\t   call function as a dao.jing content handle map {:client c :closed-atom a\n     8\t   :put-bytes-fn f :get-bytes-fn g :close-fn h} that jing/materialize!,\n     9\t   jing/get, and jing/close! dispatch through automatically; the synchronous\n    10\t   WebSocket constructor connect-content! and its server twin serve-content!\n    11\t   are JVM-only.\"\n    12\t  (:require [clojure.string :as str]\n    13\t            [dao.jing :as jing]\n    14\t            [dao.jing.cbor :as cbor]\n    15\t            [dao.stream.apply :as apply]\n    16\t            [dao.stream.rpc :as rpc]\n    17\t            [dao.stream.ws :as ws]\n    18\t            ;; The :cljd branch must come first: ClojureDart's emit pass also\n    19\t            ;; matches :clj, and dao.stream.ws.jvm has no Dart twin, so a\n    20\t            ;; :clj-first spelling would put the JVM glue into the Dart\n    21\t            ;; imports.  The :cljd [] splice keeps every namespace the host\n    22\t            ;; composition uses — its media, its decoder, its codec check,\n    23\t            ;; and the JVM glue itself — out of the emitted Dart.\n    24\t            #?@(:cljd []\n    25\t                :clj [[dao.stream :as stream]\n    26\t                      [dao.stream.rpc.ws :as rpc.ws]\n    27\t                      [dao.stream.transit :as transit]\n    28\t                      [dao.stream.ringbuffer :as ring]\n    29\t                      [dao.stream.serving :as serving]\n    30\t                      [dao.stream.waitset.driver :as wait-driver]\n    31\t                      [dao.stream.ws.jvm :as jvm]]))\n    32\t  #?(:cljs (:require-macros [dao.jing])))\n    33\t\n    34\t\n    35\t(defn- accept-bytes!\n    36\t  \"The canonical payload bytes carried by the Base64 text b64 at address,\n    37\t   or a throw: this is the one ingress canonicality check for bytes Jing\n    38\t   did not encode itself (docs/design/dao.jing.cbor.md, Layering and\n    39\t   interfaces). The text must be strict Base64, the bytes must hash to the\n    40\t   address under its carried algorithm, and they must decode as exactly\n    41\t   one canonical payload.\"\n    42\t  [address b64]\n    43\t  (when-not (jing/segment-address? address)\n    44\t    (throw (ex-info \"content address must be a segment address\"\n    45\t                    {:address address})))\n    46\t  (let [bs (jing/base64->bytes b64)]\n    47\t    (when-not (jing/segment-bytes-match? address bs)\n    48\t      (throw (ex-info \"content address does not match payload hash\"\n    49\t                      {:address address})))\n    50\t    (cbor/decode bs)\n    51\t    bs))\n    52\t\n    53\t\n    54\t#_{:clj-kondo/ignore [:unused-binding]}\n    55\t\n    56\t\n    57\t(defn- with-lock\n    58\t  [lock f]\n    59\t  #?(:clj (locking lock (f))\n    60\t     :default (f)))\n    61\t\n    62\t\n    63\t(defn- valid-presence-envelope?\n    64\t  \"True only for the exact wire envelope {:found? boolean, :value value}.\"\n    65\t  [x]\n    66\t  (and (map? x)\n    67\t       (= #{:found? :value} (set (keys x)))\n    68\t       (let [f (:found? x)] (or (true? f) (false? f)))))\n    69\t\n    70\t\n    71\t(defn default-handlers\n    72\t  \"Build the RPC handler map from a local dao.jing byte-store handle.\n    73\t   Canonical payload bytes cross the wire as padded standard-alphabet\n    74\t   Base64 text inside the existing Transit envelopes: :jing/put-content\n    75\t   takes [address base64] and answers the backend's verdict after the\n    76\t   ingress check; :jing/get-content answers {:found? boolean, :value\n    77\t   base64-or-nil}.\"\n    78\t  [handle]\n    79\t  (let [put (:put-bytes-fn handle)\n    80\t        get-fn (:get-bytes-fn handle)\n    81\t        local-missing #?(:clj (Object.)\n    82\t                         :cljs (js-obj)\n    83\t                         :cljd (Object.))]\n    84\t    (when-not (ifn? put)\n    85\t      (throw (ex-info \"handle must expose a :put-bytes-fn\" {:handle handle})))\n    86\t    (when-not (ifn? get-fn)\n    87\t      (throw (ex-info \"handle must expose a :get-bytes-fn\" {:handle handle})))\n    88\t    {:jing/put-content\n    89\t     (fn [address b64]\n    90\t       (let [bs (accept-bytes! address b64)\n    91\t             result (put address bs)]\n    92\t         (if (#{:inserted :present} result)\n    93\t           result\n    94\t           (throw (ex-info\n    95\t                    \"backend returned an invalid put result\"\n    96\t                    {:address address, :result result}))))),\n    97\t     :jing/get-content (fn [address]\n    98\t                         (when-not (jing/segment-address? address)\n    99\t                           (throw (ex-info\n   100\t                                    \"content address must be a segment address\"\n   101\t                                    {:address address})))\n   102\t                         (let [result (get-fn address local-missing)]\n   103\t                           (if (identical? result local-missing)\n   104\t                             {:found? false, :value nil}\n   105\t                             {:found? true,\n   106\t                              :value (jing/bytes->base64 result)})))}))\n   107\t\n   108\t\n   109\t(defn content-client\n   110\t  \"Wrap an RPC client as a dao.jing byte-store handle: puts send the\n   111\t   canonical bytes as Base64 text, gets decode the Base64 the server\n   112\t   answers and admit each found reply as ingress before returning it\n   113\t   (the accept-bytes! check: hash-verify, then one strict canonical\n   114\t   decode; a found reply that fails either refuses); dao.jing/get\n   115\t   hash-verifies and decodes the snapshot it receives.\n   116\t\n   117\t   call-fn is invoked as (call-fn client op args) and close-fn as\n   118\t   (close-fn client). Close is guarded so concurrent JVM closes call the\n   119\t   underlying close-fn exactly once; if close-fn throws, the client stays\n   120\t   open for retry.\"\n   121\t  [client call-fn close-fn]\n   122\t  (when-not (ifn? call-fn)\n   123\t    (throw (ex-info \"call-fn must be a function\" {:call-fn call-fn})))\n   124\t  (when-not (ifn? close-fn)\n   125\t    (throw (ex-info \"close-fn must be a function\" {:close-fn close-fn})))\n   126\t  (let [closed-atom (atom false)\n   127\t        close-lock #?(:clj (Object.)\n   128\t                      :default nil)\n   129\t        ensure-open (fn []\n   130\t                      (when @closed-atom\n   131\t                        (throw (ex-info \"content client is closed\"\n   132\t                                        {:client client}))))]\n   133\t    {:client client,\n   134\t     :closed-atom closed-atom,\n   135\t     :put-bytes-fn (fn [address bs]\n   136\t                     (ensure-open)\n   137\t                     (call-fn client :jing/put-content\n   138\t                              [address (jing/bytes->base64 bs)])),\n   139\t     :get-bytes-fn\n   140\t     (fn [address not-found]\n   141\t       (ensure-open)\n   142\t       (let [resp (call-fn client :jing/get-content [address])\n   143\t             bs (when (and (valid-presence-envelope? resp) (:found? resp))\n   144\t                  (try (jing/base64->bytes (:value resp))\n   145\t                       (catch #?(:cljd Object :clj Throwable :cljs :default)\n   146\t                              _\n   147\t                         nil)))]\n   148\t         (cond\n   149\t           ;; A found reply is remote ingress: before its bytes leave\n   150\t           ;; this handle they must hash to the requested address and\n   151\t           ;; decode as exactly one canonical payload, mirroring\n   152\t           ;; accept-bytes! above -- jing/get's snapshot decode does\n   153\t           ;; not re-check canonicality, so a hash-valid, noncanonical\n   154\t           ;; reply served under its own address would otherwise be\n   155\t           ;; exposed (docs/design/dao.jing.cbor.md, the remote-ingress\n   156\t           ;; contract).\n   157\t           (some? bs)\n   158\t           (do (when-not (jing/segment-bytes-match? address bs)\n   159\t                 (throw (ex-info\n   160\t                          \"content address does not match payload hash\"\n   161\t                          {:address address})))\n   162\t               (cbor/decode bs)\n   163\t               bs)\n   164\t           (and (valid-presence-envelope? resp) (not (:found? resp)))\n   165\t           not-found\n   166\t           :else\n   167\t           (throw\n   168\t             (ex-info\n   169\t               (str \"malformed RPC response: presence envelope must \"\n   170\t                    \"contain exactly :found? (boolean) and :value \"\n   171\t                    \"(padded Base64 or nil) keys\")\n   172\t               {:operation :jing/get-content,\n   173\t                :address address,\n   174\t                :response resp}))))),\n   175\t     :close-fn (fn []\n   176\t                 (with-lock close-lock\n   177\t                   (fn []\n   178\t                     (when-not @closed-atom\n   179\t                       (close-fn client)\n   180\t                       (compare-and-set! closed-atom false true)))))}))\n   435\t     :cljs (base64/decodeStringToUint8Array s)\n   436\t     :cljd (convert/base64Decode s)))\n   437\t\n   438\t\n   439\t(defn segment-bytes\n   440\t  \"The canonical payload bytes of payload, which must hash to address\n   441\t   under the address-carried algorithm; the byte-level twin of\n   442\t   segment-matches? for a backend that stores bytes and needs them.\n   443\t   Throws on a malformed address, an unencodable payload, or a digest\n   444\t   mismatch.\"\n   445\t  [address payload]\n   446\t  (let [{:keys [algorithm digest]}\n   447\t        (or (parse-segment-address address)\n   448\t            (throw (ex-info \"not a segment content address\"\n   449\t                            {:address address})))\n   450\t        bs (canonical-bytes payload)]\n   451\t    (when-not (= digest (digest-bytes algorithm bs))\n   452\t      (throw (ex-info \"content address does not match the payload\"\n   453\t                      {:address address, :payload payload})))\n   454\t    bs))\n   455\t\n   456\t\n   457\t(defn segment-value\n   458\t  \"The value of payload bytes stored at address: verifies the bytes hash to\n   459\t   the address under its carried algorithm, then decodes exactly one\n   460\t   accepted payload without re-encoding it (the canonicality check ran\n   461\t   once, at the ingress that accepted the bytes). Throws on a malformed\n   462\t   address, a digest mismatch, or bytes that do not decode.\"\n   463\t  [address bs]\n   464\t  (let [{:keys [algorithm digest]}\n   465\t        (or (parse-segment-address address)\n   466\t            (throw (ex-info \"not a segment content address\"\n   467\t                            {:address address})))]\n   468\t    (when-not (= digest (digest-bytes algorithm bs))\n   469\t      (throw (ex-info \"stored bytes do not hash to their content address\"\n   470\t                      {:address address})))\n   471\t    (cbor/decode-snapshot bs)))\n   472\t\n   473\t\n   474\t(defn materialize!\n   475\t  \"Content-address payload and store it through the handle's byte store.\n   476\t\n   477\t   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\n   478\t   and [handle payload {:keys [algorithm]}].\n   479\t\n   480\t   The payload is encoded exactly once. The address is derived solely from\n   481\t   those canonical bytes, and the same bytes go to the backend effect\n   482\t   :put-bytes-fn as (put-bytes-fn address bytes). The backend must answer\n   483\t   with one of:\n   484\t\n   485\t     :inserted -- the bytes are durably stored now;\n   486\t     :present  -- bytes are already stored under that address.\n   487\t\n   488\t   Any other answer is an invalid backend result and throws: DaoJing does\n   489\t   not accept ambiguous truthiness. The address is returned only after the\n   490\t   backend reports success.\n   491\t\n   492\t   On :present the stored bytes are read back through :get-bytes-fn and\n   493\t   verified both by hash against the address and byte for byte against the\n   494\t   proposed bytes. Equal content is idempotent and returns the same\n   495\t   address. Content that does not hash to its own address is an integrity\n   496\t   failure and throws loudly. Nothing is ever overwritten.\"\n   497\t  ([handle payload]\n   498\t   (materialize! handle payload {:algorithm default-hash-algorithm}))\n   499\t  ([handle payload opts]\n   500\t   (let [put (:put-bytes-fn handle)\n   501\t         get-fn (:get-bytes-fn handle)]\n   502\t     (when-not (fn? put)\n   503\t       (throw (ex-info \"dao.jing handle requires :put-bytes-fn\"\n   504\t                       {:handle handle})))\n   505\t     (when-not (fn? get-fn)\n   506\t       (throw (ex-info \"dao.jing handle requires :get-bytes-fn\"\n   507\t                       {:handle handle})))\n   508\t     (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n   509\t           reg (clojure.core/get registry algo)]\n   510\t       (when-not reg\n   511\t         (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n   512\t                         {:algorithm algo})))\n   513\t       (let [bs (canonical-bytes payload)\n   514\t             address (keyword \"segment\"\n   515\t                              (str (:address-id reg) \"-\"\n   516\t                                   (digest-bytes algo bs)))\n   517\t             result (put address bs)]\n   518\t         (case result\n   519\t           :inserted address\n   520\t           :present\n   521\t           (let [stored (get-fn address content-missing)]\n   522\t             (cond\n   523\t               (identical? stored content-missing)\n   524\t               (throw\n   525\t                 (ex-info\n   526\t                   \"backend reported :present but the content address is absent\"\n   527\t                   {:address address, :payload payload}))\n   528\t               ;; the read-back must hash to the address it sits at and be\n   529\t               ;; the very bytes proposed\n   530\t               (and (segment-bytes-match? address stored)\n   531\t                    (cbor/bytes= stored bs))\n   532\t               address\n   533\t               :else\n   534\t               (throw\n   535\t                 (ex-info\n   536\t                   (str \"content collision: the stored bytes do not match \"\n   537\t                        \"their content address\")\n   538\t                   {:address address, :payload payload}))))\n   539\t           (throw (ex-info\n   540\t                    \"invalid backend put result\"\n   541\t                    {:result result, :address address, :payload payload}))))))))\n   542\t\n   543\t\n   544\t(defn get\n   545\t  \"Retrieve the value stored at a content address.\n   546\t\n   547\t   Only valid registered content addresses are valid DaoJing reads;\n   548\t   arbitrary keys and mutable roots are outside DaoJing and throw before the\n   549\t   backend is consulted. The backend's bytes are hash-verified against the\n   550\t   address and decoded; bytes that do not hash to the address throw.\n   551\t   Returns not-found when the address is absent.\"\n   552\t  [handle address not-found]\n   553\t  (when-not (segment-address? address)\n   554\t    (throw (ex-info \"dao.jing reads only valid segment content addresses\"\n   555\t                    {:address address})))\n   556\t  (let [get-fn (:get-bytes-fn handle)]\n   557\t    (when-not (fn? get-fn)\n   558\t      (throw (ex-info \"dao.jing handle requires :get-bytes-fn\"\n   559\t                      {:handle handle})))\n   560\t    (let [stored (get-fn address not-found)]\n   561\t      (if (identical? stored not-found)\n   562\t        not-found\n   563\t        (segment-value address stored)))))\n   564\t\n   565\t\n   566\t(defn close!\n   567\t  \"Close the backend through its optional :close-fn. Idempotency is the\n   568\t   backend's contract: close! simply delegates, so a backend that tolerates\n   569\t   repeated closes may be closed repeatedly. Returns nil. Handles without\n   570\t   :close-fn have nothing to release.\"\n   571\t  [handle]\n   572\t  (when-let [close-fn (:close-fn handle)] (close-fn))\n   573\t  nil)\n   574\t\n   575\t\n   320\t                  (is (= payload (jing/get client address ::miss))\n   321\t                      \"content must survive a server restart\")\n   322\t                  (jing/close! client))\n   323\t                (finally ((:stop! server)) (jing/close! backing))))\n   324\t         (finally (try (java.nio.file.Files/deleteIfExists\n   325\t                         (java.nio.file.Path/of path (make-array String 0)))\n   326\t                       (catch Exception _)))))\n   327\t     :cljd (is true \"network tests are JVM-only\")\n   328\t     :cljs (is true \"network tests are JVM-only\")))\n   329\t\n   330\t\n   331\t(deftest local-malformed-envelope-test\n   332\t  (let [malformed-response (atom nil)\n   333\t        mock-handlers {:jing/get-content (fn [_address & _]\n   334\t                                           @malformed-response)}\n   335\t        client (remote/content-client ::mock\n   336\t                                      (fn [_ op args]\n   337\t                                        (apply (get mock-handlers op) args))\n   338\t                                      (fn [_] nil))\n   339\t        addr (jing/segment-key {:x 1})]\n   340\t    (try (doseq [val [\"bogus\" {:found? \"yes\", :value nil} {:found? true}\n   341\t                      {:value 123} {:found? true, :value 123, :extra 4}\n   342\t                      {:found? true, :value 123}\n   343\t                      {:found? true, :value \"not base64!\"}]]\n   344\t           (reset! malformed-response val)\n   345\t           (try (jing/get client addr ::miss)\n   346\t                (is false\n   347\t                    (str \"should have thrown for malformed response: \"\n   348\t                         (pr-str val)))\n   349\t                (catch #?(:clj Exception\n   350\t                          :cljs js/Error\n   351\t                          :cljd Object)\n   352\t                       e\n   353\t                  (let [data (ex-data e)\n   354\t                        msg #?(:clj (.getMessage e)\n   355\t                               :cljs (.-message e)\n   356\t                               :cljd (ex-message e))]\n   357\t                    (is (= :jing/get-content (:operation data)))\n   358\t                    (is (= addr (:address data)))\n   359\t                    (is (= val (:response data)))\n   360\t                    (is (re-find #\"malformed RPC response\" msg))))))\n   361\t         (finally (jing/close! client)))))\n   362\t\n   363\t\n   364\t(deftest local-present-then-absent-test\n   365\t  (let [mock-handlers {:jing/put-content (fn [_address _payload & _] :present),\n   366\t                       :jing/get-content (fn [_address & _]\n   367\t                                           {:found? false, :value nil})}\n   368\t        client (remote/content-client ::mock\n   369\t                                      (fn [_ op args]\n   370\t                                        (apply (get mock-handlers op) args))\n   371\t                                      (fn [_] nil))]\n   372\t    (try\n   373\t      ;; nil case\n   374\t      (is (thrown-with-msg?\n   375\t            #?(:clj Exception\n   376\t               :cljs js/Error\n   377\t               :cljd Object)\n   378\t            #\"backend reported :present but the content address is absent\"\n   379\t            (jing/materialize! client nil)))\n   380\t      ;; non-nil case\n   381\t      (is (thrown-with-msg?\n   382\t            #?(:clj Exception\n   383\t               :cljs js/Error\n   384\t               :cljd Object)\n   385\t            #\"backend reported :present but the content address is absent\"\n   386\t            (jing/materialize! client {:some \"payload\"})))\n   387\t      (finally (jing/close! client)))))\n   388\t\n   389\t\n   390\t(deftest network-presence-envelope-test\n   391\t  #?(:clj (with-server\n   392\t            (fn [_url client]\n   393\t              (let [nil-addr (jing/materialize! client nil)\n   394\t                    envelope-like {:found? true, :value \"hello\"}\n   395\t                    env-addr (jing/materialize! client envelope-like)\n   396\t                    local-sentinel (Object.)\n   397\t                    absent-addr (jing/segment-key {:absent \"indeed\"})]\n   398\t                (is (nil? (jing/get client nil-addr ::miss)))\n   399\t                (is (= envelope-like (jing/get client env-addr ::miss)))\n   400\t                (is (identical?\n   401\t                      local-sentinel\n   402\t                      (jing/get client absent-addr local-sentinel))))))\n   403\t     :cljd (is true \"network tests are JVM-only\")\n   404\t     :cljs (is true \"network tests are JVM-only\")))\n   405\t\n   406\t\n   407\t(deftest a-hash-valid-noncanonical-payload-is-an-integrity-failure\n   408\t  ;; The hostile pair, the blocking client's twin of the stepped\n   409\t  ;; client's test of the same name (test/dao/jing/remote/step_test.cljc):\n   410\t  ;; an address minted over bytes that decode as one payload but are\n   411\t  ;; not its canonical encoding, served by a server holding exactly\n   412\t  ;; those bytes. The digest matches the minted address, so only the\n   413\t  ;; blocking client's own ingress check can refuse the reply.\n   414\t  #?(:clj\n   415\t     (let [bs (byte-array (mapv unchecked-byte [0x18 0x01]))\n   416\t           algo jing/default-hash-algorithm\n   417\t           reg (get jing/registry algo)\n   418\t           address (keyword \"segment\"\n   419\t                            (str (:address-id reg)\n   420\t                                 \"-\" (jing/digest-bytes algo bs)))\n   421\t           port (+ 20000 (rand-int 30000))\n   422\t           url (str \"ws://127.0.0.1:\" port)\n   423\t           server (remote/serve-content!\n   424\t                    (remote/default-handlers\n   425\t                      {:put-bytes-fn (fn [_address _bytes] :present)\n   426\t                       :get-bytes-fn (fn [_address _not-found] bs)})\n   427\t                    port)]\n   428\t       (try (let [client (remote/connect-content! url)]\n   429\t              (try (is (thrown-with-msg?\n   430\t                         Exception\n   431\t                         #\"non-canonical\"\n   432\t                         (jing/get client address ::miss))\n   433\t                       \"a hash-valid, noncanonical found reply must refuse\")\n   434\t                   (finally (jing/close! client))))\n   435\t            (finally ((:stop! server)))))\n   436\t     :cljd (is true \"network tests are JVM-only\")\n   437\t     :cljs (is true \"network tests are JVM-only\")))\n   438\t\n   439\t\n   440\t;; =============================================================================\n   441\t;; The DaoStream v2 JVM host composition (migration Phase 2)\n   442\t;; =============================================================================\n   443\t\n   444\t(deftest request-timeout-retires-the-call-and-the-client-recovers-once-released\n   445\t  #?(:clj\n   446\t     (let [latch (java.util.concurrent.CountDownLatch. 1)\n   447\t           port (+ 20000 (rand-int 30000))\n   448\t           server (remote/serve-content!\n   449\t                    {:gated/op (fn [] (.await latch) :late)\n   450\t                     :fast/op (fn [] :now)}\n   451\t                    port)]\n   452\t       (try\n   453\t         (let [handle (remote/connect-content!\n   454\t                        (str \"ws://127.0.0.1:\" port)\n   455\t                        {:request-timeout-ms 50})]\n","exit_code":0,"status":"completed"}}
