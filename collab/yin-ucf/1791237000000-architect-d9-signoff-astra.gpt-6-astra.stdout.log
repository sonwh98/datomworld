b2f17330be4ff309b6302cfe6d3']\nline counts 22 22\n   300\t              (if (:v1 @found)\n   301\t                x\n   302\t                (non-portable! :host-object\n   303\t                               {:yin.k/hint\n   304\t                                #?(:cljd (str (.-runtimeType x))\n   305\t                                   :default (str (type x)))}))\n   306\t              (values/host-typed? x)\n   307\t              (cond\n   308\t                (not (values/owned-by? x (:owner vm)))\n   309\t                (non-portable! :foreign-value {:yin.k/hint (values/kind-of x)})\n   310\t                (values/closure? x)\n   311\t                (let [marker (module/lift-closure vm (values/payload x)\n   312\t                                                  encode)]\n   313\t                  (swap! found\n   314\t                         (fn [acc]\n   315\t                           (let [acc (update acc :segments\n   316\t                                             conj (:yin.k/segment marker))]\n   317\t                             (if-some [m (:yin.k/store-of marker)]\n   318\t                               (update acc :stores conj m)\n   319\t                               acc))))\n   320\t                  marker)\n   321\t                :else\n   322\t                (non-portable! :non-canonicalizable\n   323\t                               {:yin.k/hint :reified-continuation}))\n   324\t              (map? x)\n   325\t              (case (:type x)\n   326\t                :stream-ref\n   327\t                (if (engine/authentic-ref? vm :stream-ref x)\n   328\t                  (marker-for! vm serve! found (:id x))\n   329\t                  (non-portable! :forged-resource-reference\n   330\t                                 {:yin.k/hint :stream-ref}))\n   331\t                :cursor-ref\n   332\t                (if (engine/authentic-ref? vm :cursor-ref x)\n   333\t                  {:yin.k/tag :yin.k/cursor-ref\n   334\t                   :yin.k/cell (cell-for! vm serve! found (:id x))}\n   335\t                  (non-portable! :forged-resource-reference\n   336\t                                 {:yin.k/hint :cursor-ref}))\n   337\t                :parked-continuation\n   338\t                (non-portable! :non-canonicalizable\n   339\t                               {:yin.k/hint (:type x)})\n   340\t                :cell-ref\n   341\t                (non-portable! :cell {:yin.k/hint (:id x)})\n   342\t                {:yin.k/tag :yin.k/literal\n   343\t                 :yin.k/entries\n   344\t                 (into []\n   345\t                       (mapcat (fn [[k v]] [(encode k) (encode v)]))\n   346\t                       (ordered found key x))})\n   347\t              (vector? x) (mapv encode x)\n   348\t              (set? x) (into #{} (map encode) (ordered found identity x))\n   349\t              (seq? x) (apply list (map encode x))\n   350\t              (fn? x) (encode-primitive vm x)\n   :zero (jing.cbor/float64 0.0)\n   :neg-zero (jing.cbor/float64 (* -1.0 0.0))\n   :nan (jing.cbor/float64 ##NaN)\n   :nested {:b {:d [1 2 {:e 3}] :a #{3 1 2}} :a 1 :c {:z 1 :y 2}}})\n\n\n(defn- literal-entries\n  \"The `[k v]` pairs of a wrapped literal map.\"\n  [lit]\n  (is (= :yin.k/literal (:yin.k/tag lit)) \"wrapped, never a bare map\")\n  (into {} (map vec) (partition 2 (:yin.k/entries lit))))\n\n\n(deftest floats-signed-zero-nan-and-nested-maps-lift-canonically-test\n  (let [h (s/header 0 s/origin #{})\n        r (ok! (s/lift (s/halted-with odd-values) h))\n        again (s/lift (s/halted-with odd-values) h)\n        result (get-in r [:body :yin.k/result])\n        entries (literal-entries result)]\n    (accepted-by-both! r)\n    (is (same-bytes? (:bytes r) (:bytes again)) \"a fresh machine, same bytes\")\n    (is (= 5 (count entries)))\n    (is (jing.cbor/float64? (get entries :neg-zero)))\n    (is (jing.cbor/float64? (get entries :nan)))\n    (testing \"signed zero is kept: the two zeros are different bytes\"\n      (is (not (same-bytes? (jing.cbor/encode (get entries :zero))\n                            (jing.cbor/encode (get entries :neg-zero))))))\n    (testing \"literal entries are ordered by their canonical key bytes\"\n      (let [ks (take-nth 2 (:yin.k/entries result))]\n        (is (= ks (sort jing.cbor/encoded-compare ks)))))))\n\n\n(deftest an-envelope-shaped-program-value-survives-as-payload-test\n  (let [envelope {:dao.stream.apply/id :call-1\n                  :dao.stream.apply/op :op/add\n                  :dao.stream.apply/args [1 2]}\n        r (ok! (s/lift (s/halted-with envelope) (s/header 0 s/origin #{})))\n        entries (literal-entries (get-in r [:body :yin.k/result]))]\n    (accepted-by-both! r)\n    (is (= envelope entries) \"the value is in the body, as data\")))\n\n\n(deftest cells-are-shared-and-numbered-in-walk-order-test\n  (let [r (ok! (s/lift (s/parked-explicit) (s/header 1)))\n        cells (get-in r [:body :yin.k/cells])]\n    (is (= #{:yin.k/c-0} (set (keys cells))))\n    (is (= 1 (count (vals cells))))))\n\n\n(deftest the-version-0-wire-is-still-emitted-for-a-halted-first-export-test\n  (let [r (ok! (s/lift (s/halted-machine) nil))]\n    (is (= 0 (:yin.k/version (:body r))))\n    (is (vm/halted? (s/halted-machine)))))\n\n\n(deftest cell-numbering-never-depends-on-map-iteration-test\n  (let [m (s/parked-two-cursors)\n        ;; a small map rebuilt from its reversed entries keeps that order\n        ;; on the JVM and JavaScript; ClojureDart's maps iterate\n        ;; canonically, so no store order can be flipped there and the\n        ;; row degrades to the same-bytes proof over one order\n        reversed #?(:cljd m :default (update m :store #(into {} (reverse %))))\n        h (s/header 0 nil #{})\n        a (ok! (s/lift m h))\n        b (ok! (s/lift reversed h))]\n    (is (= 2 (count (get-in a [:body :yin.k/cells]))) \"one cell shared, one not\")\n    #?(:cljd nil\n       :default (is (not= (seq (:store m)) (seq (:store reversed)))\n                    \"the order really differs\"))\n    (is (same-bytes? (:bytes a) (:bytes b)))\n    (is (= (:address a) (:address b)))\n7:   line `ledger-v1`, a second `projection <digest>`, the BLAKE3 hex of\n8:   the canonical bytes of the projection the frames fold to, then one\n10:   the file from a one-off JVM script with the string `render` returns,\n12:   `render`, so every host's rebuild has the pinned bytes.\n29:            [yin.vm.ucf.checkpoint-fixtures :as fx]\n55:(defn header-frame\n62:(defn origin\n67:(defn park\n81:(defn halted\n87:(defn world\n98:(defn offer!\n104:(defn grant!\n111:(defn lapse!\n116:(defn refuse!\n123:(defn report!\n132:(defn envelope\n141:(defn admit!\n146:(defn record!\n154:(defn read-ok\n165:(defn answer\n194:(defn build\n228:(defn digest\n229:  \"The BLAKE3 hex of the canonical bytes of projection `p`.\"\n234:(defn hex\n239:(defn render\n244:         \"projection \" (digest (authority/projection a)) \"\\n\"\n248:(defn read-file\n255:    {:digest (subs pin (count \"projection \"))\n259:(defn read-text\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"Completed-GMT: 2026-10-05 19:30:12 GMT\nCompleted-Local: 2026-10-06 02:30:12 +0700\n\nCHANGES\n\n1. **Complete deterministic cell numbering before landing.** [handoff.cljc:240](/Users/sto/workspace/datomworld-d9/src/cljc/yin/vm/ucf/handoff.cljc:240) sorts using a shared, stateful scratch encoder. Encoding cursor-reference keys assigns scratch cell numbers in comparison-evaluation order; those numbers then determine the sorting order. Reversing traversal can therefore change which distinct cursor receives `c-0`, changing the emitted cells and address. The report’s acknowledged reference-key limitation cannot be deferred to D14: these values are admitted now. Additionally, [snapshot-module-stores:750](/Users/sto/workspace/datomworld-d9/src/cljc/yin/vm/ucf/handoff.cljc:750) still encodes store entries in native map order, allowing cursor numbering to depend on that order. Make version-1 ordering independent of comparison side effects and map iteration throughout the reachable graph, preserving distinct cell identity and aliasing. Pin reversed-order cases for cursor-reference keys and module-store cursor values across hosts; preserve version-0 traversal.\n\n2. **Preserve serve-once behavior across partial-prepare retries and aliases.** In [export.cljc:208](/Users/sto/workspace/datomworld-d9/src/cljc/yin/vm/ucf/holder/export.cljc:208), `by-handle` starts empty each call, and an existing served-table entry returns without populating it. If resource A was served before a refusal, and an alias B is first reached on retry, B can invoke `serve!` again for A’s handle. The added fix covers aliases within one successful call, not this retry case. Reconstruct alias reuse from the retained plain-data table and machine resource bindings before serving new keys; do not persist handles. Add a partial-failure/retry test proving one successful serve for the shared handle, both resource keys retained, and subsequent encode requiring no serving.\n\nThe header channel, kind/header agreement, three data refusals, checkpoint inspection followed by D7 body validation, and early held-state refusals follow the ruling. The four host adaptations are appropriate and version-scoped; they do not, however, establish the missing traversal guarantee above. I explicitly approve the widened `authority/inherited_test.cljc` and `authority/front_test.cljc` adaptations as fixture-regeneration consequences preserving their authority assertions. I also approve re-rendering `ledger-v1.txt`: static comparison confirms its six changed frame lines differ only in checkpoint-address strings, with the projection digest changing alongside them; the renderer and byte-comparison contract remain unchanged. That is a derived-pin update, not permission to weaken C12 determinism. The served-table re-keying and alias fix are warranted additions but need item 2 completed. No files were edited and no suites were run."}}
