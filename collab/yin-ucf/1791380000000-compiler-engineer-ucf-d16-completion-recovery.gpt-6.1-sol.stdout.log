with the declaration beside it, never downgraded to fork\n      (not (authority/exclusive-capable? a (:failure-model config)))\n      (do (authority/close! a)\n          {:yin.k/status :yin.k/unsatisfied\n           :yin.k/reason :exclusive-uncapable\n           :yin.k/policy :yin.k/exclusive\n           :yin.k/failure-model (:failure-model config)\n           :dao.stream.journal/durability (authority/durability a)})\n\n      :else\n      (let [arb (:dao.stream/identity r)\n            ticks (log-handle)\n            outcome-reader (admission/outcome-reader a)\n            c (assoc (bare-composition config)\n                     :authority a\n                     :identity arb\n                     :ticks ticks\n                     :outcome-reader outcome-reader\n                     :outcome-inbox (inbox-over-outcomes outcome-reader arb)\n                     :judge (lease/wire-tick\n                              (grant/rebuild-judge\n                                a\n                                (lease/initial-judge\ndocs/agents/build-n-test.md:11:bb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\ndocs/agents/build-n-test.md:12:bb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\ndocs/agents/build-n-test.md:13:bb test:slow         # Only the slow tests, on every lane\ndocs/agents/build-n-test.md:14:# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\ndocs/agents/build-n-test.md:15:bb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\ndocs/agents/build-n-test.md:16:bb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\ndocs/agents/build-n-test.md:17:bb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\ndocs/agents/build-n-test.md:21:bb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\ndocs/agents/build-n-test.md:22:bb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\ndocs/agents/build-n-test.md:23:bb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\ndocs/agents/build-n-test.md:24:# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\ndocs/agents/build-n-test.md:25:# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\ndocs/agents/build-n-test.md:26:# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\ndocs/agents/build-n-test.md:27:# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\ndocs/agents/build-n-test.md:28:# under test/), so the non-slow tests inside those namespaces also run there.\ndocs/agents/build-n-test.md:31:# Run test:slow / test:all before a big merge or a commit that touches many parts.\ndocs/agents/build-n-test.md:32:# Run one Dart lane at a time repo-wide.\ndocs/agents/build-n-test.md:34:# When to tag a test slow: when it takes more than about 5 s on any lane (the\ndocs/agents/build-n-test.md:36:# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\ndocs/agents/build-n-test.md:37:# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n","exit_code":0,"status":"completed"}}
