{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'lease-id|defn judge-config' src/cljc/yin/vm/ucf/authority/grant.cljc src/cljc/dao/lease.cljc; sed -n '331,364p' src/cljc/yin/vm/ucf/authority/front.cljc; sed -n '1,32p' test/yin/vm/ucf/holder/driver_test.cljc; sed -n '240,261p' src/cljc/yin/vm/ucf/holder/driver.cljc; sed -n '24,32p' bb.edn\"","aggregated_output":"src/cljc/yin/vm/ucf/authority/grant.cljc:324:                            (lease/grant (lease/mint-lease-id) s author\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:332:(defn judge-config\nsrc/cljc/dao/lease.cljc:318:          (vconj (when (some? (get fact :dao.lease/lease)) :lease-id-on-proposal))))\nsrc/cljc/dao/lease.cljc:323:          (vconj (missing-key fact :dao.lease/lease :missing-lease-id))\nsrc/cljc/dao/lease.cljc:336:          (vconj (missing-key fact :dao.lease/lease :missing-lease-id))))\nsrc/cljc/dao/lease.cljc:341:          (vconj (missing-key fact :dao.lease/lease :missing-lease-id))\nsrc/cljc/dao/lease.cljc:356:          (vconj (missing-key fact :dao.lease/lease :missing-lease-id))))\nsrc/cljc/dao/lease.cljc:497:  ([lease-id subject holder duration] (grant lease-id subject holder duration nil))\nsrc/cljc/dao/lease.cljc:498:  ([lease-id subject holder duration opts]\nsrc/cljc/dao/lease.cljc:499:   (check-assembly! (some? lease-id)\nsrc/cljc/dao/lease.cljc:520:            :dao.lease/lease lease-id\nsrc/cljc/dao/lease.cljc:543:  [lease-id]\nsrc/cljc/dao/lease.cljc:544:  (check-assembly! (some? lease-id)\nsrc/cljc/dao/lease.cljc:548:   :dao.lease/lease lease-id})\nsrc/cljc/dao/lease.cljc:554:  [lease-id cause]\nsrc/cljc/dao/lease.cljc:555:  (check-assembly! (some? lease-id)\nsrc/cljc/dao/lease.cljc:562:   :dao.lease/lease lease-id\nsrc/cljc/dao/lease.cljc:569:  [lease-id]\nsrc/cljc/dao/lease.cljc:570:  (check-assembly! (some? lease-id)\nsrc/cljc/dao/lease.cljc:574:   :dao.lease/lease lease-id})\nsrc/cljc/dao/lease.cljc:589:(defn mint-lease-id\nsrc/cljc/dao/lease.cljc:931:  [judge lease-id status]\nsrc/cljc/dao/lease.cljc:932:  (let [prior (get (:seen judge) lease-id)]\nsrc/cljc/dao/lease.cljc:933:    (assoc-in judge [:seen lease-id]\nsrc/cljc/dao/lease.cljc:965:  cursor, stamped with this pass's now. Returns [judge counted-lease-id]:\nsrc/cljc/dao/lease.cljc:966:  `counted-lease-id` is the lease this fact was AUTHORITATIVE for -- an\nsrc/cljc/dao/lease.cljc:1036:  [judge lease-id]\nsrc/cljc/dao/lease.cljc:1037:  (boolean (some (fn [entry] (contains? (:leases entry) lease-id))\nsrc/cljc/dao/lease.cljc:1312:    (let [on-truncated-medium (fn [lease-id]\nsrc/cljc/dao/lease.cljc:1316:                                                                 lease-id)))\nsrc/cljc/dao/lease.cljc:1318:      (set (filter (fn [lease-id]\nsrc/cljc/dao/lease.cljc:1319:                     (or (on-truncated-medium lease-id)\nsrc/cljc/dao/lease.cljc:1320:                         (not (on-any-medium judge lease-id))))\nsrc/cljc/dao/lease.cljc:1393:  [judge lease-id cause]\nsrc/cljc/dao/lease.cljc:1395:        entry (get-in judge [:ledger lease-id])]\nsrc/cljc/dao/lease.cljc:1398:                      {:lease lease-id :subject (:subject entry)})))\nsrc/cljc/dao/lease.cljc:1399:    (let [judge (assoc-in judge [:ledger lease-id :reclaim]\nsrc/cljc/dao/lease.cljc:1405:          judge (assoc-in judge [:ledger lease-id :reclaim :success] success?)]\nsrc/cljc/dao/lease.cljc:1408:        (let [fact (lapsed lease-id cause)\nsrc/cljc/dao/lease.cljc:1411:            (mark-seen (update judge :ledger dissoc lease-id)\nsrc/cljc/dao/lease.cljc:1412:                       lease-id :dao.lease/lapsed)\nsrc/cljc/dao/lease.cljc:1423:        (let [lease-id (first remaining)\nsrc/cljc/dao/lease.cljc:1426:                                    (get-in judge [:ledger lease-id])\nsrc/cljc/dao/lease.cljc:1427:                                    (contains? suppressed lease-id))]\nsrc/cljc/dao/lease.cljc:1430:            (recur (reclaim-one judge lease-id cause) (rest remaining))))))))\nsrc/cljc/dao/lease.cljc:1530:                                        (grant (mint-lease-id)\n(defn reply-evidence\n  \"Whether `record`, read from a stream the composition attributes to\n   `author`, is an outcome authored by the authority whose identity is\n   `arbitration`: a reply of this front, or a `:yin.k/admission` outcome\n   of the outcome projection.  Answers the record when `author` equals\n   `arbitration` and the record is an outcome, else `{::no-evidence\n   reason}`, reason :other-author or :not-an-outcome.  Identity\n   equality only: a descriptor is never compared, and a record from any\n   other author discharges nothing, whatever it claims.\"\n  [arbitration author record]\n  (cond\n    (not (and (some? author) (= arbitration author)))\n    {::no-evidence :other-author}\n    (not (outcome? record)) {::no-evidence :not-an-outcome}\n    :else record))\n(ns yin.vm.ucf.holder.driver-test\n  \"D13: the candidate half of the custody driver (UCF 7.7.2 to 7.7.8,\n   7.8, 7.9; r3 1.5, 1.6 and 1.7's D13 row; the D10 lower-inputs\n   ruling).  Every checkpoint is a real lift of a real machine the\n   engine parked; every offer, grant, binding, input and admission is\n   the real authority's, reached through the real front over the memory\n   substrate; every lease the driver accepts was granted by the real\n   judge or recorded by the real ledger writer.  The composition the\n   driver owes -- the front streams, the ledger reader, the lease clock\n   -- is supplied as functions over that world.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.datom :as datom]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.admission :as admission]\n            [yin.vm.ucf.authority.front :as front]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.custody :as custody]\n            [yin.vm.ucf.holder.driver :as driver]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.lift-support :as s]))\n\n\n(defn- machines\n  \"`[path machine]` of the root and, recursively, each install child,\n   children in install-name order.\"\n  [root]\n  (letfn [(walk\n            [prefix m]\n            (concat [[prefix m]]\n                    (mapcat (fn [name]\n                              (when-some [child (:vm (get (:installs m) name))]\n                                (walk (into prefix [:installs name :vm])\n                                      child)))\n                            (sort-by str (keys (:installs m))))))]\n    (walk [] root)))\n\n\n(defn- ended\n  \"`machine` gated `:ended` at the root and at every install child: the\n   root owns the mode, and nothing applies a late result after it.\"\n  [machine]\n  (reduce (fn [m [prefix _]]\n            (assoc-in m (conj prefix :yin.k/gate) :ended))\n          (assoc machine :yin.k/gate :ended)\n             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:python-antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n","exit_code":0,"status":"completed"}}
