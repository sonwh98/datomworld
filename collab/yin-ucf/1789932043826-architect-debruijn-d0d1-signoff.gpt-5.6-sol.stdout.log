nds a) (= [-60 -60] v)))\n467:                (datoms-of graph))\n469:           is a [eid stack] memo hit\")\n471:                    (datoms-of tree))\n472:          \"the tree's operands are distinct entities: every memo key misses\")\n477:;; Root framing (§2)\n480:(deftest adjacent-rooted-graphs-reset-the-fact-index\n481:  (let [[_root-one ds-one] (vm/ast->datoms-with-root (lam '[x] (v 'x)))\n482:        [_root-two ds-two] (vm/ast->datoms-with-root (lam '[y] (v 'y)))\n483:        frames (d/frame-datoms (vec (concat ds-one ds-two)))]\n484:    (is (= 2 (count frames)))\n485:    (is (= (set (map first ds-one)) (set (map first ds-two)))\n486:        \"both graphs mint -16-based tempids, so a merged index would collide\")\n487:    (is (= (:root (d/project-datoms ds-one))\n488:           (:root (d/project-datoms (first frames)))))\n489:    (is (= (:root (d/project-datoms ds-two))\n490:           (:root (d/project-datoms (second frames)))))\n491:    (is (= (:root (d/project-datoms (first frames)))\n492:           (:root (d/project-datoms (second frames))))\n493:        \"renamed binders: the two graphs are one projection\")))\n496:(deftest a-partial-frame-at-end-of-stream-diagnoses\n497:  (let [[_root-one ds-one] (vm/ast->datoms-with-root (lam '[x] (v 'x)))\n498:        [_root-two ds-two] (vm/ast->datoms-with-root (lam '[y] (v 'y)))]\n499:    (is (= :partial-frame\n500:           (:rule (throws-data #(d/frame-datoms (vec (concat ds-one\n502:    (is (= 1 (count (d/frame-datoms ds-one)))\n503:        \"a stream ending exactly at its marker frames cleanly\")))\n506:(deftest trailing-other-namespace-datoms-do-not-open-a-frame\n507:  (let [[_root ds] (vm/ast->datoms-with-root worked-example)\n511:                         [-999 :yin.macro/event :done 0 1]])]\n512:    (is (= [ds] (d/frame-datoms decorated))\n513:        \"ignored-namespace datoms after the last marker are not a partial frame,\n514:         and the frames carry :yin/* datoms only\")\n515:    (is (= (d/project-