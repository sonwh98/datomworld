ume (do (emit! e :yin/type :vm/resume)\n                                 (emit! e :yin/parked-id (:parked-id node))\n                                 (let [val-id (convert (:val node))]\n                                   (emit! e :yin/val-node val-id)))\n                  :vm/current-continuation\n                  (emit! e :yin/type :vm/current-continuation)\n                  ;; Default\n                  (throw (ex-info \"Unknown AST node type\"\n                                  {:type type, :node node})))\n                e))))]\n       (let [root-id (convert ast)]\n         (emit! root-id :yin/root true)\n         [root-id @datoms])))))\n\n\n(defn ast->datoms\n  \"Convert AST map into a vector of datoms. A datom is [e a v t m].\"\n  ([ast] (ast->datoms ast {}))\n  ([ast opts] (second (ast->datoms-with-root ast opts))))\n\n\n(declare index-datoms)\n\n\n(defn datoms->ast\n  \"Convert a vector of datoms [e a v t m] back into an AST map.\"\n  ([datoms]\n   (let [indexed (index-datoms datoms)\n         root-id (:root-id indexed)]\nsrc/cljc/dao/jing.cljc:8:   after the backend reports durability. get reads only :segment/sha256-...\nsrc/cljc/dao/jing.cljc:95:   Transitional: this exists only to make the print-based content hash\nsrc/cljc/dao/jing.cljc:273:   the same bytes: handing goog.crypt.Sha256 the string itself hashes\nsrc/cljc/dao/jing.cljc:280:     :cljs (let [hasher (new goog.crypt.Sha256)]\nsrc/cljc/dao/jing.cljc:281:             (.update hasher (crypt/stringToUtf8ByteArray s))\nsrc/cljc/dao/jing.cljc:282:             (crypt/byteArrayToHex (.digest hasher)))\nsrc/cljc/dao/jing.cljc:292:   is `(content-hash v)` — the two are one digest over one byte stream.\"\nsrc/cljc/dao/jing.cljc:297:     :cljs (let [hasher (new goog.crypt.Sha256)]\nsrc/cljc/dao/jing.cljc:298:             (.update hasher bs)\nsrc/cljc/dao/jing.cljc:299:             (crypt/byteArrayToHex (.digest hasher)))\nsrc/cljc/dao/jing.cljc:306:(defn content-hash\nsrc/cljc/dao/jing.cljc:314:   encod