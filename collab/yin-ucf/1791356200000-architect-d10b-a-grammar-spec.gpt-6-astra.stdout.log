{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='docs/design/yin.vm.universal-continuation-format.v2-amendment.md'\ns=open(p).read()\ns=s.replace('Validate each image with its own published validator.', 'Code data slots use their existing raw code-scalar grammar, not V. A\\\\nmap literal in an instruction or AST row is code data; never dispatch it\\\\nas a continuation/resource marker. Conversely, authentic runtime values\\\\ninside saved frames use V and cannot be hidden in a code constant to\\\\nescape ownership or dependency checks.\\\\n\\\\nValidate each image with its own published validator.')\ns=s.replace('| semantic | binding named,', '| semantic | binding \"'`:named`,'\"').replace('| walker | binding named,', '| walker | binding \"'`:named`,'\"').replace('| stack | binding positional,', '| stack | binding \"'`:positional`,'\"').replace('| register | binding positional,', '| register | binding \"'`:positional`,'\"')\nopen(p,'w').write(s)\nPY\nsed -n '145,166p' docs/design/yin.vm.universal-continuation-format.v2-amendment.md\npython3 - <<'PY'\nfrom pathlib import Path\nimport re\np=Path('docs/design/yin.vm.universal-continuation-format.v2-amendment.md')\ns=p.read_text()\nprint('lines:', len(s.splitlines()), 'words:', len(s.split()), 'fences:', s.count('\"'```'\"'))\nassert s.count('\"'```'\"') % 2 == 0\nfor target in re.findall(r'\\\\]\\\\(([\"'^)]+)'\"\\\\)', s):\n    assert (p.parent / target.split('#')[0]).exists(), target\nassert not any(x.rstrip()\"'!=x for x in s.splitlines())\nprint('\"'local links, fence parity, trailing whitespace: pass')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
