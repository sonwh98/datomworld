{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/clj/dao/star_cart/edge.clj && nl -ba src/clj/dao/star_cart/store.clj'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/clj/dao/star_cart/edge.clj && nl -ba src/clj/dao/star_cart/store.clj'","aggregated_output":"     1\t(ns dao.star-cart.edge\n     2\t  \"The host edge: one http-kit handler for the whole site.  Static assets\n     3\t   (`/images/`, `/css/`, `/js/`) are served from disk and never enter a\n     4\t   boundary; `/grid` and `/grid/...` go to the grid boundary with the prefix\n     5\t   stripped from `:uri`; everything else goes to the shop boundary.\"\n     6\t  (:require [clojure.string :as str])\n     7\t  (:import [java.net URLDecoder]\n     8\t           [java.nio.file Files LinkOption Path Paths]))\n     9\t\n    10\t\n    11\t(def content-types\n    12\t  {\"png\" \"image/png\" \"jpg\" \"image/jpeg\" \"jpeg\" \"image/jpeg\" \"gif\" \"image/gif\"\n    13\t   \"webp\" \"image/webp\" \"svg\" \"image/svg+xml\" \"css\" \"text/css\" \"js\" \"text/javascript\"\n    14\t   \"woff2\" \"font/woff2\" \"ico\" \"image/x-icon\"})\n    15\t\n    16\t\n    17\t(def static-prefixes [\"/images/\" \"/css/\" \"/js/\"])\n    18\t\n    19\t\n    20\t(defn decode-path\n    21\t  \"Percent-decode a request path (a `+` is a plus here, not a space); nil when\n    22\t   malformed.\"\n    23\t  [uri]\n    24\t  (try (URLDecoder/decode (str/replace (str uri) \"+\" \"%2B\") \"UTF-8\")\n    25\t       (catch Exception _ nil)))\n    26\t\n    27\t\n    28\t(defn- text-response\n    29\t  [status body]\n    30\t  {:status status :headers {\"content-type\" \"text/plain\"} :body body})\n    31\t\n    32\t\n    33\t(defn static-file\n    34\t  \"The regular file `decoded-path` names under `root`, or nil.  The path is\n    35\t   resolved against the root and normalized; anything that leaves the root, a\n    36\t   NUL, a backslash or a missing or non-regular file answers nil.\"\n    37\t  [^Path root decoded-path]\n    38\t  (when (and decoded-path\n    39\t             (not (str/includes? decoded-path \"\\u0000\"))\n    40\t             (not (str/includes? decoded-path \"\\\\\"))\n    41\t             (not (some #{\"..\"} (str/split decoded-path #\"/\"))))\n    42\t    (let [rel (str/replace-first decoded-path #\"^/+\" \"\")\n    43\t          target (.normalize (.resolve root rel))]\n    44\t      (when (.startsWith target root)\n    45\t        ;; The lexical check above is not enough: any component of the path\n    46\t        ;; may be a symlink.  Resolve both real paths and require containment.\n    47\t        (try\n    48\t          (let [real-root (.toRealPath root (make-array LinkOption 0))\n    49\t                real (.toRealPath target (make-array LinkOption 0))]\n    50\t            (when (and (.startsWith real real-root)\n    51\t                       (Files/isRegularFile real (make-array LinkOption 0)))\n    52\t              (.toFile real)))\n    53\t          (catch java.io.IOException _ nil))))))\n    54\t\n    55\t\n    56\t(defn serve-static\n    57\t  [root path]\n    58\t  (if-let [f (static-file root path)]\n    59\t    (let [ext (str/lower-case (last (str/split (.getName f) #\"\\.\")))]\n    60\t      {:status 200\n    61\t       :headers {\"content-type\" (get content-types ext \"application/octet-stream\")\n    62\t                 \"cache-control\" \"public, max-age=3600\"}\n    63\t       :body f})\n    64\t    (text-response 404 \"not found\")))\n    65\t\n    66\t\n    67\t(defn strip-grid\n    68\t  \"`/grid` -> `/`, `/grid/s/x` -> `/s/x`; nil when `uri` is not under /grid.\"\n    69\t  [uri]\n    70\t  (cond (= uri \"/grid\") \"/\"\n    71\t        (str/starts-with? uri \"/grid/\") (subs uri 5)\n    72\t        :else nil))\n    73\t\n    74\t\n    75\t(defn static-path?\n    76\t  [path]\n    77\t  (some #(str/starts-with? path %) static-prefixes))\n    78\t\n    79\t\n    80\t(defn make-edge\n    81\t  \"`{:asset-root path :shop handler :grid handler}`.\"\n    82\t  [{:keys [asset-root shop grid]}]\n    83\t  (let [root (.toAbsolutePath (.normalize (Paths/get (str asset-root) (make-array String 0))))]\n    84\t    (fn [req]\n    85\t      (let [raw (:uri req)\n    86\t            decoded (decode-path raw)\n    87\t            under-grid (strip-grid (or raw \"/\"))\n    88\t            static-raw (or under-grid raw)\n    89\t            ;; any raw path whose first segment is a static prefix, with or\n    90\t            ;; without the /grid prefix, is static; the decode happens after\n    91\t            ;; the prefix test so encoded separators cannot dodge it\n    92\t            static? (static-path? (str static-raw))\n    93\t            decoded-static (when static? (decode-path static-raw))]\n    94\t        (cond\n    95\t          (nil? decoded) (text-response 400 \"bad request\")\n    96\t          static? (serve-static root decoded-static)\n    97\t          under-grid (grid (assoc req :uri under-grid))\n    98\t          :else (shop req))))))\n     1\t(ns dao.star-cart.store\n     2\t  \"The mutable catalog db: an atom holding the accumulated datom vector.  Boot\n     3\t   loads `catalog.edn` through `transact/prepare-tx` (schema block first); an\n     4\t   edit runs `prepare-tx` inside a `swap!`, so concurrent editors cannot lose\n     5\t   each other's updates.  Every save snapshots the catalog back to its file as\n     6\t   plain item maps (temp file + atomic rename).  A path that cannot be written\n     7\t   logs and the store carries on in memory.\"\n     8\t  (:require [clojure.edn :as edn]\n     9\t            [clojure.java.io :as io]\n    10\t            [dao.space.transact :as transact]\n    11\t            [dao.star-cart.catalog :as catalog])\n    12\t  (:import [java.nio.file Files StandardCopyOption Paths]))\n    13\t\n    14\t\n    15\t(defn- log\n    16\t  [& xs]\n    17\t  (binding [*out* *err*] (println (apply str \"star-cart: \" xs))))\n    18\t\n    19\t\n    20\t(defn read-catalog\n    21\t  \"The catalog file: `{:store/name .. :items [item-map ...]}`.\"\n    22\t  [path]\n    23\t  (edn/read-string (slurp path)))\n    24\t\n    25\t\n    26\t(defn- boot-datoms\n    27\t  [item-maps]\n    28\t  (:datoms (transact/prepare-tx\n    29\t             {:base-datoms []\n    30\t              :tx-data (into catalog/schema-tx (catalog/items->tx item-maps))})))\n    31\t\n    32\t\n    33\t(defn write-atomically!\n    34\t  \"Write `content` to `path` through a sibling temp file and an atomic rename.\n    35\t   The old file is untouched if the write fails before the rename.\"\n    36\t  [path content]\n    37\t  (io/make-parents (io/file path))\n    38\t  (let [target (Paths/get path (make-array String 0))\n    39\t        dir (or (.getParent target) (Paths/get \".\" (make-array String 0)))\n    40\t        tmp (Files/createTempFile dir \"catalog\" \".tmp\" (make-array java.nio.file.attribute.FileAttribute 0))]\n    41\t    (try\n    42\t      (spit (.toFile tmp) content)\n    43\t      (Files/move tmp target (into-array java.nio.file.CopyOption\n    44\t                                         [StandardCopyOption/ATOMIC_MOVE StandardCopyOption/REPLACE_EXISTING]))\n    45\t      (catch Throwable t\n    46\t        (Files/deleteIfExists tmp)\n    47\t        (throw t)))))\n    48\t\n    49\t\n    50\t(defn open\n    51\t  \"Open the store.  `path` is where saves go (the seed is copied there on first\n    52\t   boot when the path is empty and writable), `seed` the baked catalog file.\n    53\t   `:write-fn` (default `write-atomically!`) is injectable for tests.\"\n    54\t  [{:keys [path seed write-fn] :or {write-fn write-atomically!}}]\n    55\t  (let [source (cond (and path (.exists (io/file path))) path\n    56\t                     :else seed)\n    57\t        data (read-catalog source)\n    58\t        store {:path path :write-fn write-fn :store-name (:store/name data)\n    59\t               :lock (Object.)\n    60\t               :datoms (atom (boot-datoms (:items data)))\n    61\t               :cache (atom nil)}]\n    62\t    (when-not path\n    63\t      (log \"no catalog path: edits are held in MEMORY ONLY and are lost on exit\"))\n    64\t    (when (and path (not= source path))\n    65\t      (try (write-fn path (slurp seed))\n    66\t           (catch Throwable t (log \"cannot seed \" path \": \" (.getMessage t) \"; continuing in memory\"))))\n    67\t    store))\n    68\t\n    69\t\n    70\t(defn db\n    71\t  [store]\n    72\t  (catalog/db @(:datoms store)))\n    73\t\n    74\t\n    75\t(defn items\n    76\t  \"All items, cached per datom value: a read after an edit recomputes once.\"\n    77\t  [store]\n    78\t  (let [ds @(:datoms store)\n    79\t        [cached-ds cached] @(:cache store)]\n    80\t    (if (identical? ds cached-ds)\n    81\t      cached\n    82\t      (let [result (catalog/items (catalog/db ds))]\n    83\t        (reset! (:cache store) [ds result])\n    84\t        result))))\n    85\t\n    86\t\n    87\t(defn item\n    88\t  [store slug]\n    89\t  (first (filter #(= slug (:key %)) (items store))))\n    90\t\n    91\t\n    92\t(defn catalog-fns\n    93\t  \"The pure view's catalog: `:items` and `:item`, each reading the store fresh.\"\n    94\t  [store]\n    95\t  {:items (fn [] (items store))\n    96\t   :item (fn [slug] (item store slug))})\n    97\t\n    98\t\n    99\t(defn snapshot!\n   100\t  \"Rewrite the catalog file from a fresh query.  Failure logs and is swallowed:\n   101\t   the edit stands in memory.\"\n   102\t  [store]\n   103\t  (when-let [path (:path store)]\n   104\t    (try\n   105\t      ((:write-fn store) path\n   106\t       (pr-str {:store/name (:store-name store)\n   107\t                :items (catalog/item-maps (db store))}))\n   108\t      true\n   109\t      (catch Throwable t\n   110\t        (log \"cannot save \" path \": \" (.getMessage t) \"; continuing in memory\")\n   111\t        false))))\n   112\t\n   113\t\n   114\t#_{:clj-kondo/ignore [:locking-suspicious-lock]}\n   115\t(defn transact-edit!\n   116\t  \"Apply an edit.  `tx-fn` receives the current db value and answers tx-data (or\n   117\t   throws, aborting the swap).  `prepare-tx` runs inside the `swap!`.  On\n   118\t   success the snapshot is saved and the new datom vector answered.\"\n   119\t  [store tx-fn]\n   120\t  ;; The update and its snapshot are one critical section: snapshots are then\n   121\t  ;; written in the order the updates were applied, so a later rename can\n   122\t  ;; never carry an older state.\n   123\t  (locking (:lock store)\n   124\t    (let [new-ds (swap! (:datoms store)\n   125\t                        (fn [ds]\n   126\t                          (let [tx-data (tx-fn (catalog/db ds))]\n   127\t                            (if (empty? tx-data)\n   128\t                              ds\n   129\t                              (into ds (:datoms (transact/prepare-tx\n   130\t                                                  {:base-datoms ds :tx-data tx-data})))))))]\n   131\t      (snapshot! store)\n   132\t      new-ds)))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/star_cart/view.cljc | head -115 && nl -ba src/cljc/dao/star_cart/grid_program.cljc && nl -ba test/dao/star_cart/edge_test.clj'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/star_cart/view.cljc | head -115 && nl -ba src/cljc/dao/star_cart/grid_program.cljc && nl -ba test/dao/star_cart/edge_test.clj'","aggregated_output":"     1\t(ns dao.star-cart.view\n     2\t  \"Pure projections for the dao.star cart's shop face, and the helpers the grid\n     3\t   face shares: HTML escaping, money, the Datastar SSE framing, and the begin\n     4\t   page.\n     5\t\n     6\t   Datastar is pinned at `datastar-version`.  Its SSE vocabulary at that\n     7\t   version: an event named `datastar-patch-elements` whose data lines are\n     8\t   prefixed `elements ` (the HTML to morph, matched by element id), and\n     9\t   `datastar-patch-signals` whose data lines are prefixed `signals `.  An event\n    10\t   ends with a blank line.  Actions are `data-on:<event>` attributes calling\n    11\t   `@get`/`@post`; the request's signals ride the query (GET) or JSON body.\"\n    12\t  (:require [clojure.string :as str]))\n    13\t\n    14\t\n    15\t(def datastar-version \"1.0.0-RC.7\")\n    16\t\n    17\t\n    18\t(defn esc\n    19\t  \"HTML-escape text for element content and double-quoted attributes.\"\n    20\t  [s]\n    21\t  (-> (str s)\n    22\t      (str/replace \"&\" \"&amp;\")\n    23\t      (str/replace \"<\" \"&lt;\")\n    24\t      (str/replace \">\" \"&gt;\")\n    25\t      (str/replace \"\\\"\" \"&quot;\")\n    26\t      (str/replace \"'\" \"&#39;\")\n    27\t      ;; CR and LF are SSE line terminators: never emit them raw\n    28\t      (str/replace \"\\r\" \"&#13;\")\n    29\t      (str/replace \"\\n\" \"&#10;\")))\n    30\t\n    31\t\n    32\t(defn js-lit\n    33\t  \"A single-quoted JavaScript string literal for use inside an attribute.\"\n    34\t  [s]\n    35\t  (esc (str \"'\" (-> (str s)\n    36\t                    (str/replace \"\\\\\" \"\\\\\\\\\")\n    37\t                    (str/replace \"'\" \"\\\\'\")\n    38\t                    (str/replace \"\\r\" \"\\\\r\")\n    39\t                    (str/replace \"\\n\" \"\\\\n\")\n    40\t                    (str/replace \"\\u2028\" \"\\\\u2028\")\n    41\t                    (str/replace \"\\u2029\" \"\\\\u2029\"))\n    42\t            \"'\")))\n    43\t\n    44\t\n    45\t(defn enc-path\n    46\t  \"Make an asset path safe inside an attribute and a URL: the characters that\n    47\t   would end an attribute, a path or start a query are percent-encoded.  Other\n    48\t   characters (spaces aside) are left for the browser.\"\n    49\t  [p]\n    50\t  (reduce (fn [s [from to]] (str/replace s from to))\n    51\t          (str p)\n    52\t          [[\"%\" \"%25\"] [\" \" \"%20\"] [\"#\" \"%23\"] [\"?\" \"%3F\"] [\"\\\"\" \"%22\"]\n    53\t           [\"'\" \"%27\"] [\"<\" \"%3C\"] [\">\" \"%3E\"]]))\n    54\t\n    55\t\n    56\t(defn money\n    57\t  \"Prices are minor units (cents): 2400 renders $24.00.\"\n    58\t  [cents]\n    59\t  (let [c (or cents 0)\n    60\t        r (rem c 100)]\n    61\t    (str \"$\" (quot c 100) \".\" (if (< r 10) (str \"0\" r) r))))\n    62\t\n    63\t\n    64\t(defn sse-elements\n    65\t  \"One `datastar-patch-elements` event carrying `html`, newlines folded.\"\n    66\t  [html]\n    67\t  (str \"event: datastar-patch-elements\\ndata: elements \"\n    68\t       (str/replace html #\"\\r\\n|\\r|\\n\" \" \") \"\\n\\n\"))\n    69\t\n    70\t\n    71\t(defn sse-signals\n    72\t  \"One `datastar-patch-signals` event carrying the JSON text `json`.\"\n    73\t  [json]\n    74\t  (str \"event: datastar-patch-signals\\ndata: signals \" json \"\\n\\n\"))\n    75\t\n    76\t\n    77\t(defn act\n    78\t  \"A click action: set the `act`/`arg` signals and post to the occurrence token.\n    79\t   `prefix` is \\\"\\\" for the shop and \\\"/grid\\\" for the grid.\"\n    80\t  ([prefix token a] (act prefix token a nil))\n    81\t  ([prefix token a arg]\n    82\t   (str \"$act=\" (js-lit a) \"; $arg=\" (js-lit (or arg \"\")) \"; @post('\"\n    83\t        prefix \"/k/\" (esc token) \"')\")))\n    84\t\n    85\t\n    86\t(defn button\n    87\t  [prefix token label a arg]\n    88\t  (str \"<button type=\\\"button\\\" data-on:click=\\\"\" (act prefix token a arg) \"\\\">\"\n    89\t       (esc label) \"</button>\"))\n    90\t\n    91\t\n    92\t(defn begin-page\n    93\t  \"The complete HTML document at the root: the vendored script, the\n    94\t   stylesheet, base signals, and a subscription to the lineage's token.\"\n    95\t  [{:keys [prefix title signals root]}]\n    96\t  (str \"<!doctype html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\">\"\n    97\t       \"<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\"\n    98\t       \"<title>\" (esc title) \"</title>\"\n    99\t       \"<link rel=\\\"stylesheet\\\" href=\\\"/css/cart.css\\\">\"\n   100\t       \"<script type=\\\"module\\\" src=\\\"/js/datastar.js\\\"></script></head>\"\n   101\t       \"<body data-signals=\\\"\" (esc signals) \"\\\" data-init=\\\"@get('\" prefix \"/s/\" (esc root) \"',{retry:'always'})\\\">\"\n   102\t       \"<div id=\\\"app\\\"><p class=\\\"loading\\\">Loading…</p></div></body></html>\"))\n   103\t\n   104\t\n   105\t;; -----------------------------------------------------------------------------\n   106\t;; Shop\n   107\t;; -----------------------------------------------------------------------------\n   108\t\n   109\t(defn- first-image\n   110\t  [item]\n   111\t  (first (:images item)))\n   112\t\n   113\t\n   114\t(defn- cart-lines\n   115\t  \"The cart model (slug -> qty, zero entries dropped) joined with the catalog.\"\n     1\t(ns dao.star-cart.grid-program\n     2\t  \"The grid (catalog editor) session program.  Its continuation holds only UI\n     3\t   state: the selected item and the last outcome.  Every mutation is emitted as\n     4\t   data, `{:edit {:item slug :changes {...}}}`, for the host's effects\n     5\t   interpreter to validate and transact; the program never claims success.  It\n     6\t   renders `saving` until a `{:saved slug}` or `{:rejected reason}` input\n     7\t   arrives, which the effects interpreter appends after the transact.\n     8\t\n     9\t   Inputs are `{:signals {...}}` maps: `:act` names the action, `:arg` carries\n    10\t   an item key, image URL or tagory name, and the typed fields arrive as the\n    11\t   `name`, `price`, `desc`, `img` and `tag` signals.\"\n    12\t  (:require [dao.await :as await]))\n    13\t\n    14\t\n    15\t(def grid-forms\n    16\t  '[(let [ic (await/cursor in)]\n    17\t      (do\n    18\t        (def emit (fn [sel status msg edit]\n    19\t                    (await/>! out (assoc (assoc (assoc (assoc {} :sel sel) :status status) :msg msg) :edit edit))))\n    20\t        (def change (fn [sel ch]\n    21\t                      (assoc (assoc {} :item sel) :changes ch)))\n    22\t        (def lp (fn [sel]\n    23\t                  (let [x (await/<! ic)\n    24\t                        s (get x :signals)\n    25\t                        a (get s :act)\n    26\t                        arg (get s :arg)]\n    27\t                    (if (get s :saved)\n    28\t                      (do (emit sel \"saved\" \"\" nil) (lp sel))\n    29\t                      (if (get s :rejected)\n    30\t                        (do (emit sel \"rejected\" (get s :rejected) nil) (lp sel))\n    31\t                        (if (= a \"select\")\n    32\t                          (do (emit arg \"\" \"\" nil) (lp arg))\n    33\t                          (if (= a \"cancel\")\n    34\t                            (do (emit nil \"\" \"\" nil) (lp nil))\n    35\t                            (if (= a \"save\")\n    36\t                              (do (emit sel \"saving\" \"\"\n    37\t                                        (change sel (assoc (assoc (assoc {} :name (get s :name))\n    38\t                                                                  :price (get s :price))\n    39\t                                                           :description (get s :desc))))\n    40\t                                  (lp sel))\n    41\t                              (if (= a \"addimg\")\n    42\t                                (do (emit sel \"saving\" \"\" (change sel (assoc {} :add-image (get s :img))))\n    43\t                                    (lp sel))\n    44\t                                (if (= a \"rmimg\")\n    45\t                                  (do (emit sel \"saving\" \"\" (change sel (assoc {} :remove-image arg)))\n    46\t                                      (lp sel))\n    47\t                                  (if (= a \"addtag\")\n    48\t                                    (do (emit sel \"saving\" \"\" (change sel (assoc {} :add-tagory (get s :tag))))\n    49\t                                        (lp sel))\n    50\t                                    (if (= a \"rmtag\")\n    51\t                                      (do (emit sel \"saving\" \"\" (change sel (assoc {} :remove-tagory arg)))\n    52\t                                          (lp sel))\n    53\t                                      (do (emit sel \"\" \"\" nil) (lp sel))))))))))))))\n    54\t        (emit nil \"\" \"\" nil)\n    55\t        (lp nil)))])\n    56\t\n    57\t\n    58\t(def grid-program\n    59\t  (await/go* grid-forms {}))\n     1\t(ns dao.star-cart.edge-test\n     2\t  (:require [clojure.string :as str]\n     3\t            [clojure.test :refer [deftest is]]\n     4\t            [dao.star-cart.edge :as edge]))\n     5\t\n     6\t\n     7\t(def root \"resources/dao_star_cart/public\")\n     8\t\n     9\t\n    10\t(defn- site\n    11\t  []\n    12\t  (edge/make-edge {:asset-root root\n    13\t                   :shop (fn [req] {:status 200 :body (str \"shop:\" (:uri req))})\n    14\t                   :grid (fn [req] {:status 200 :body (str \"grid:\" (:uri req))})}))\n    15\t\n    16\t\n    17\t(defn- get-uri [uri] ((site) {:uri uri :request-method :get}))\n    18\t\n    19\t\n    20\t(deftest the-grid-prefix-is-stripped-and_does-not-reach-the-shop\n    21\t  (is (= \"grid:/\" (:body (get-uri \"/grid\"))))\n    22\t  (is (= \"grid:/s/x\" (:body (get-uri \"/grid/s/x\"))))\n    23\t  (is (= \"grid:/k/y\" (:body (get-uri \"/grid/k/y\"))))\n    24\t  (is (= \"shop:/s/x\" (:body (get-uri \"/s/x\"))))\n    25\t  (is (= \"shop:/\" (:body (get-uri \"/\"))))\n    26\t  (is (= \"shop:/gridlock\" (:body (get-uri \"/gridlock\"))) \"only /grid and /grid/... are the grid\"))\n    27\t\n    28\t\n    29\t(deftest static-assets-are-served-from-disk-and-never-enter-a-boundary\n    30\t  (let [css (get-uri \"/css/cart.css\")\n    31\t        img (get-uri \"/images/7..png\")\n    32\t        grid-img (get-uri \"/grid/images/7..png\")]\n    33\t    (is (= 200 (:status css)))\n    34\t    (is (= \"text/css\" (get-in css [:headers \"content-type\"])))\n    35\t    (is (= 200 (:status img)))\n    36\t    (is (= \"image/png\" (get-in img [:headers \"content-type\"])))\n    37\t    (is (pos? (.length ^java.io.File (:body img))))\n    38\t    (is (= 200 (:status grid-img)) \"the grid page's own asset urls work\")))\n    39\t\n    40\t\n    41\t(deftest static-path-traversal-is-refused\n    42\t  (doseq [uri [\"/images/../deps.edn\"\n    43\t               \"/images/%2e%2e/deps.edn\"\n    44\t               \"/images/%2e%2e/%2e%2e/deps.edn\"\n    45\t               \"/images/..%2fdeps.edn\"\n    46\t               \"/images/..%5cdeps.edn\"\n    47\t               \"/images//etc/passwd\"\n    48\t               \"/images/%2fetc/passwd\"\n    49\t               \"/images/..%2f..%2f..%2f..%2fetc%2fpasswd\"\n    50\t               \"/css/../images/7..png\"\n    51\t               \"/grid/images/../deps.edn\"\n    52\t               \"/grid/images/%2e%2e/deps.edn\"\n    53\t               \"/images/\"\n    54\t               \"/images/nope.png\"\n    55\t               \"/images/%00.png\"\n    56\t               \"/js/../../deps.edn\"]]\n