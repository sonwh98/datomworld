   13\t                   :shop (fn [req] {:status 200 :body (str \"shop:\" (:uri req))})\n    14\t                   :grid (fn [req] {:status 200 :body (str \"grid:\" (:uri req))})}))\n    15\t\n    16\t\n    17\t(defn- get-uri [uri] ((site) {:uri uri :request-method :get}))\n    18\t\n    19\t\n    20\t(deftest the-grid-prefix-is-stripped-and_does-not-reach-the-shop\n    21\t  (is (= \"grid:/\" (:body (get-uri \"/grid\"))))\n    22\t  (is (= \"grid:/s/x\" (:body (get-uri \"/grid/s/x\"))))\n    23\t  (is (= \"grid:/k/y\" (:body (get-uri \"/grid/k/y\"))))\n    24\t  (is (= \"shop:/s/x\" (:body (get-uri \"/s/x\"))))\n    25\t  (is (= \"shop:/\" (:body (get-uri \"/\"))))\n    26\t  (is (= \"shop:/gridlock\" (:body (get-uri \"/gridlock\"))) \"only /grid and /grid/... are the grid\"))\n    27\t\n    28\t\n    29\t(deftest static-assets-are-served-from-disk-and-never-enter-a-boundary\n    30\t  (let [css (get-uri \"/css/cart.css\")\n    31\t        img (get-uri \"/images/7..png\")\n    32\t        grid-img (get-uri \"/grid/images/7..png\")]\n    33\t    (is (= 200 (:status css)))\n    34\t    (is (= \"text/css\" (get-in css [:headers \"content-type\"])))\n    35\t    (is (= 200 (:status img)))\n    36\t    (is (= \"image/png\" (get-in img [:headers \"content-type\"])))\n    37\t    (is (pos? (.length ^java.io.File (:body img))))\n    38\t    (is (= 200 (:status grid-img)) \"the grid page's own asset urls work\")))\n    39\t\n    40\t\n    41\t(deftest static-path-traversal-is-refused\n    42\t  (doseq [uri [\"/images/../deps.edn\"\n    43\t               \"/images/%2e%2e/deps.edn\"\n    44\t               \"/images/%2e%2e/%2e%2e/deps.edn\"\n    45\t               \"/images/..%2fdeps.edn\"\n    46\t               \"/images/..%5cdeps.edn\"\n    47\t               \"/images//etc/passwd\"\n    48\t               \"/images/%2fetc/passwd\"\n    49\t               \"/images/..%2f..%2f..%2f..%2fetc%2fpasswd\"\n    50\t               \"/css/../images/7..png\"\n    51\t               \"/grid/images/../deps.edn\"\n    52\t               \"/grid/images/%2e%2e/deps.edn\"\n    53\t               \"/images/\"\n    54\t               \"/images/nope.png\"\n    55\t               \"/images/%00.png\"\n    56\t               \"/js/../../deps.edn\"]]\n    57\t    (let [r (get-uri uri)]\n    58\t      (is (= 404 (:status r)) uri)\n    59\t      (is (string? (:body r)))\n    60\t      (is (not (str/includes? (:body r) \"paths\")) \"no file content\"))))\n    61\t\n    62\t\n    63\t(deftest a-directory-is-not-a-regular-file\n    64\t  (is (= 404 (:status (get-uri \"/images/.\")))))\n     1\t(ns dao.star-cart.assemble\n     2\t  \"The one composition function.  `assemble` wires an HTTP boundary, the\n     3\t   exchange and lineage judges, the router, the driver, every medium and the\n     4\t   tick streams for one app; the shop and the grid are two calls with different\n     5\t   programs, projections and begin pages.  Session facts are a complete-history\n     6\t   memory log; subscription exchanges carry the required `:dao.lease/max`; the\n     7\t   renewal intervals come from `lease/renewal-interval`, never by hand.\"\n     8\t  (:require [dao.lease :as dl]\n     9\t            [dao.star.driver :as driver]\n    10\t            [dao.star.lease :as lease]\n    11\t            [dao.star.router :as router]\n    12\t            [dao.stream :as stream]\n    13\t            [dao.stream.http :as http]\n    14\t            [dao.stream.http.jvm :as jvm]\n    15\t            [dao.stream.memory-log :as memory-log]\n    16\t            [dao.stream.ringbuffer :as ring]))\n    17\t\n    18\t\n    19\t(def units {:ms 1})\n    20\t\n    21\t\n    22\t(def default-timing\n    23\t  \"Durations and the tick period, in milliseconds.  Each renewal interval is\n    24\t   sized against its duration and the tick period by `lease/renewal-interval`.\"\n    25\t  {:tick-ms 50\n    26\t   :exchange-duration 60000\n    27\t   :exchange-renew 20000\n    28\t   :lineage-duration 1800000\n    29\t   :lineage-renew 600000\n    30\t   :subscription-max 3600000})\n    31\t\n    32\t\n    33\t(defn- ring!\n    34\t  [capacity]\n    35\t  (:dao.stream/handle (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n    36\t                                     :dao.stream.ringbuffer/capacity capacity})))\n    37\t\n    38\t\n    39\t(defn- log!\n    40\t  []\n    41\t  (:dao.stream/handle (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n    42\t\n    43\t\n    44\t(defn assemble\n    45\t  \"Wire one app.  Config: `:program`, `:project-fn` `(fn [occurrence model])`,\n    46\t   `:begin-fn` `(fn [root])`, and optional `:timing` merged over\n    47\t   `default-timing`.  Answers\n    48\t     {:handler   the ring handler for this app's boundary\n    49\t      :boundary  the boundary\n    50\t      :driver :router\n    51\t      :step!     (fn [now-ms]) one pass of every stepped part, ticks included\n    52\t      :stop!     (fn [])}\"\n    53\t  [{:keys [program project-fn begin-fn timing]}]\n    54\t  (let [{:keys [tick-ms exchange-duration exchange-renew lineage-duration\n    55\t                lineage-renew subscription-max]} (merge default-timing timing)\n    56\t        period {:ms tick-ms}\n    57\t        ex-dur {:ms exchange-duration}\n    58\t        lin-dur {:ms lineage-duration}\n    59\t        ex-interval (dl/renewal-interval units ex-dur {:ms exchange-renew} period)\n    60\t        lin-interval (dl/renewal-interval units lin-dur {:ms lineage-renew} period)\n    61\t        ingress (ring! 1024)\n    62\t        egress (ring! 4096)\n    63\t        facts (log!)\n    64\t        lineage-lease (ring! 1024)\n    65\t        exchange-lease (ring! 1024)\n    66\t        begin (ring! 256)\n    67\t        ticks {:driver (ring! 1024) :exchange (ring! 1024) :lineage (ring! 1024)}\n    68\t        boundary (http/make-boundary\n    69\t                   {:ingress {:dao.stream/handle ingress :dao.stream/surface #{:writer}}\n    70\t                    :ingress-admission {:retention :evict-oldest :capacity 1024\n    71\t                                        :value-domain :portable-values\n    72\t                                        :lifetime :outlives-boundary}\n    73\t                    :egress {:dao.stream/handle egress :dao.stream/surface #{:reader}}\n    74\t                    :http/max-open 256 :http/max-body-bytes 65536})\n    75\t        decl (lease/facts-declaration)\n    76\t        drv (driver/make-driver\n    77\t              {:facts facts :egress egress :begin begin :tick (:driver ticks)\n    78\t               :lineage-lease lineage-lease :exchange-lease exchange-lease\n    79\t               :program program :project-fn project-fn :begin-fn begin-fn\n    80\t               :units units :lineage-renewal-interval lin-interval\n    81\t               :exchange-renewal-interval ex-interval\n    82\t               :session-capacity 256 :lease-capacity 1024 :facts-declaration decl})\n    83\t        xl (lease/make-exchange-lease\n    84\t             {:ingress ingress :egress egress :lease-medium exchange-lease\n    85\t              :tick (:exchange ticks)\n    86\t              :open-exchanges #(http/open-exchanges boundary)\n    87\t              :close-exchange #(http/close-exchange boundary %)\n    88\t              :units units :duration ex-dur :cadence period :tolerance {:ms 0}\n    89\t              :capacity 4096 :subscription-max {:ms subscription-max}})\n    90\t        ll (lease/make-lineage-lease\n    91\t             {:facts facts :lease-medium lineage-lease :tick (:lineage ticks)\n    92\t              :retire! #(driver/retire! drv %) :units units :duration lin-dur\n    93\t              :cadence period :tolerance {:ms 0} :facts-declaration decl})\n    94\t        rt (router/make-router\n    95\t             {:ingress ingress :facts facts :lease lineage-lease :begin begin\n    96\t              :co-located? true :facts-declaration decl\n    97\t              :session-medium #(driver/session-medium drv %)})]\n    98\t    {:handler (jvm/handler boundary)\n    99\t     :boundary boundary\n   100\t     :driver drv\n   101\t     :router rt\n   102\t     :ticks ticks\n   103\t     :step! (fn [now-ms]\n   104\t              (doseq [t (vals ticks)]\n   105\t                (stream/append! t (dl/tick {:ms (max 1 now-ms)})))\n   106\t              (lease/exchange-lease-step! xl)\n   107\t              (lease/lineage-lease-step! ll)\n   108\t              (router/router-step! rt)\n   109\t              (driver/driver-step! drv)\n   110\t              (http/egress-step boundary))\n   111\t     :stop! (fn [] (http/stop! boundary))}))\n","exit_code":0,"status":"completed"}}
