{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/star_cart/app_test.clj | head -220 && nl -ba test/dao/star_cart/catalog_test.clj'","aggregated_output":"     1\t(ns dao.star-cart.app-test\n     2\t  \"The demo end to end on loopback sockets: the shop and the grid on one port,\n     3\t   over the real boundary, leases, router and driver, with the catalog served\n     4\t   from dao.space.\"\n     5\t  (:require [clojure.string :as str]\n     6\t            [clojure.test :refer [deftest is testing use-fixtures]]\n     7\t            [dao.star-cart.edge :as edge]\n     8\t            [dao.star-cart.store :as store]\n     9\t            [dao.star-cart.support :as sup]))\n    10\t\n    11\t\n    12\t(def ^:dynamic *site* nil)\n    13\t\n    14\t\n    15\t(use-fixtures :each\n    16\t  (fn [t]\n    17\t    (let [site (sup/start-site!)]\n    18\t      (try (binding [*site* site] (t))\n    19\t           (finally ((:stop! site)))))))\n    20\t\n    21\t\n    22\t(defn- port [] (:port *site*))\n    23\t(defn- named [] (remove #(sup/blank? (:name %)) (store/items (:store *site*))))\n    24\t\n    25\t\n    26\t(defn- subscribed\n    27\t  \"Begin a lineage, subscribe, and wait for the first projection.  Answers\n    28\t   `{:sse :root :token}`.\"\n    29\t  [prefix]\n    30\t  (let [{:keys [root]} (sup/begin! (port) prefix)\n    31\t        sse (sup/open-sse (port) (str prefix \"/s/\" root))]\n    32\t    (is (sup/wait-for 8000 #(str/includes? @(:text sse) \"datastar-patch-elements\")) \"first projection\")\n    33\t    {:sse sse :root root :token (sup/token-of @(:text sse))}))\n    34\t\n    35\t\n    36\t(defn- sse-text [{:keys [sse]}] @(:text sse))\n    37\t\n    38\t\n    39\t(deftest the-full-page-renders-the-real-catalog-with-real-image-urls\n    40\t  (let [{:keys [page root]} (sup/begin! (port) \"\")\n    41\t        urls (set (map #(:image/url %) (map (fn [i] {:image/url (first (:images i))}) (named))))]\n    42\t    (is (str/starts-with? page \"HTTP/1.1 200\"))\n    43\t    (is (str/includes? page \"<!doctype html>\"))\n    44\t    (is (some? root))\n    45\t    (let [sse (sup/open-sse (port) (str \"/s/\" root))]\n    46\t      (is (sup/wait-for 8000 #(str/includes? @(:text sse) \"Catalog as of last page load.\")))\n    47\t      (let [text @(:text sse)\n    48\t            srcs (map (comp #(java.net.URLDecoder/decode (str/replace % \"+\" \"%2B\") \"UTF-8\") second)\n    49\t                      (re-seq #\"<img src=\\\"(/images/[^\\\"]+)\\\"\" text))]\n    50\t        (is (= 247 (count (named))))\n    51\t        (is (= (count (named)) (count srcs)) \"one image per real item\")\n    52\t        (is (every? urls srcs) \"each src is a catalog :image/url\"))\n    53\t      (sup/close-sse sse))))\n    54\t\n    55\t\n    56\t(deftest the-image-urls-on-the-first-page-resolve\n    57\t  (let [{:keys [sse]} (subscribed \"\")\n    58\t        srcs (distinct (map (comp #(java.net.URLDecoder/decode (str/replace % \"+\" \"%2B\") \"UTF-8\") second)\n    59\t                            (re-seq #\"<img src=\\\"(/images/[^\\\"]+)\\\"\" (sse-text {:sse sse}))))]\n    60\t    (is (seq srcs))\n    61\t    (doseq [u (take 12 srcs)\n    62\t            :let [enc (str/replace u \" \" \"%20\")\n    63\t                  r (sup/http (port) \"GET\" enc)]]\n    64\t      (is (= 200 (:status r)) u)\n    65\t      (is (re-find #\"(?i)content-type: image/\" (:text r)) u)\n    66\t      (is (> (count (:bytes r)) 500) u))\n    67\t    (sup/close-sse sse)))\n    68\t\n    69\t\n    70\t(deftest ^:slow every-image-url-resolves\n    71\t  (let [urls (distinct (mapcat :images (named)))]\n    72\t    (doseq [u urls\n    73\t            :let [r (sup/http (port) \"GET\" (str/replace u \" \" \"%20\"))]]\n    74\t      (is (= 200 (:status r)) u))))\n    75\t\n    76\t\n    77\t(deftest add-to-cart-parks-and-resumes-with-state-intact\n    78\t  (let [[a b] (take 2 (vals (into (sorted-map) (map (juxt (comp str/trim :name) identity)\n    79\t                                                        (filter #(pos? (:price %)) (named))))))\n    80\t        {:keys [sse token]} (subscribed \"\")\n    81\t        add (fn [tok slug] (sup/token-of (sup/input! (port) \"\" tok {:act \"add\" :arg slug})))\n    82\t        t1 (add token (:key a))\n    83\t        t2 (add t1 (:key b))\n    84\t        t3 (add t2 (:key a))]\n    85\t    (is (every? some? [t1 t2 t3]))\n    86\t    (is (= 4 (count (set [token t1 t2 t3]))) \"one successor per consumed input\")\n    87\t    (let [cart (sup/input! (port) \"\" t3 {:act \"nav\" :arg \"cart\"})\n    88\t          qty (fn [name] (second (re-find (re-pattern (str \"<td>\" (java.util.regex.Pattern/quote (str/escape name {\\< \"&lt;\" \\> \"&gt;\" \\& \"&amp;\"})) \"</td>.*?<span class=\\\"qty\\\">(\\\\d+)</span>\")) cart)))]\n    89\t      (is (str/includes? cart \"Cart (3)\"))\n    90\t      (is (str/includes? cart (str/escape (:name a) {\\< \"&lt;\" \\> \"&gt;\" \\& \"&amp;\"})))\n    91\t      (is (= \"2\" (qty (:name a))) \"a third add shows qty 2: the state lives in the continuation\")\n    92\t      (is (str/includes? cart \"Total: <strong>\"))\n    93\t      (let [expected (+ (* 2 (:price a)) (:price b))]\n    94\t        (is (str/includes? cart (str \"Total: <strong>$\" (quot expected 100) \".\" (format \"%02d\" (rem expected 100)) \"</strong>\")))))\n    95\t    (testing \"the open subscription was patched with each state\"\n    96\t      (is (sup/wait-for 5000 #(str/includes? (sse-text {:sse sse}) \"Cart (3)\"))))\n    97\t    (sup/close-sse sse)))\n    98\t\n    99\t\n   100\t(deftest a-stale-token-is-harmless\n   101\t  (let [[a] (named)\n   102\t        {:keys [sse token]} (subscribed \"\")\n   103\t        t1 (sup/token-of (sup/input! (port) \"\" token {:act \"add\" :arg (:key a)}))\n   104\t        stale (sup/input! (port) \"\" token {:act \"add\" :arg (:key a)})]\n   105\t    (is (some? t1))\n   106\t    (is (str/includes? stale \"Cart (1)\") \"the cart did not change\")\n   107\t    (is (not (str/includes? stale \"Cart (2)\")))\n   108\t    (is (= t1 (sup/token-of stale)) \"re-projected at the current occurrence\")\n   109\t    (sup/close-sse sse)))\n   110\t\n   111\t\n   112\t(deftest a-reconnect-re-projects-the-current-cart\n   113\t  (let [[a] (named)\n   114\t        {:keys [sse root token]} (subscribed \"\")\n   115\t        _ (sup/input! (port) \"\" token {:act \"add\" :arg (:key a)})\n   116\t        _ (sup/close-sse sse)\n   117\t        again (sup/open-sse (port) (str \"/s/\" root))]\n   118\t    (is (sup/wait-for 8000 #(str/includes? @(:text again) \"Cart (1)\")) \"subscribe consumes nothing and shows the cart\")\n   119\t    (sup/close-sse again)))\n   120\t\n   121\t\n   122\t(deftest the-grid-lists-the-catalog-and-saves-edits-the-shop-sees-on-navigation\n   123\t  (let [[a] (named)\n   124\t        shop (subscribed \"\")\n   125\t        old-price (str \"$\" (quot (:price a) 100) \".\" (format \"%02d\" (rem (:price a) 100)))\n   126\t        grid (subscribed \"/grid\")]\n   127\t    (testing \"the grid lists every item\"\n   128\t      (is (= 249 (sup/count-matches #\"<li class=\\\"[^\\\"]*\\\"><span class=\\\"nm\\\">\" (sse-text grid)))))\n   129\t    (testing \"select, then save a new price\"\n   130\t      (let [t1 (sup/token-of (sup/input! (port) \"/grid\" (:token grid) {:act \"select\" :arg (:key a)}))\n   131\t            reply (sup/input! (port) \"/grid\" t1 {:act \"save\" :name (:name a) :price \"4242\" :desc \"edited\"})]\n   132\t        (is (some? t1))\n   133\t        (is (str/includes? reply \"saving\") \"the program renders saving first\")\n   134\t        (is (sup/wait-for 8000 #(str/includes? (sse-text grid) \"class=\\\"status saved\\\"\")) \"then saved, after the transact\")\n   135\t        (is (= 4242 (:price (store/item (:store *site*) (:key a)))))\n   136\t        (is (= \"edited\" (:description (store/item (:store *site*) (:key a)))))))\n   137\t    (testing \"the shop's open view is stale until navigation\"\n   138\t      (is (not (str/includes? (sse-text shop) \"$42.42\")))\n   139\t      (is (str/includes? (sse-text shop) old-price))\n   140\t      (let [r (sup/input! (port) \"\" (:token shop) {:act \"nav\" :arg \"catalog\"})]\n   141\t        (is (str/includes? r \"$42.42\") \"the next navigation runs a fresh query\")))\n   142\t    (testing \"a rejected edit reports why and changes nothing\"\n   143\t      (let [t (sup/token-of (sse-text grid))\n   144\t            _ (sup/input! (port) \"/grid\" t {:act \"save\" :name (:name a) :price \"-5\" :desc \"x\"})]\n   145\t        (is (sup/wait-for 8000 #(str/includes? (sse-text grid) \"rejected: price must be a whole number\")))\n   146\t        (is (= 4242 (:price (store/item (:store *site*) (:key a)))))))\n   147\t    (testing \"the edit was written to the catalog file\"\n   148\t      (is (= 4242 (:item/price (first (filter #(= (:key a) (:item/slug %))\n   149\t                                              (:items (store/read-catalog (:catalog-path *site*)))))))))\n   150\t    (sup/close-sse (:sse shop))\n   151\t    (sup/close-sse (:sse grid))))\n   152\t\n   153\t\n   154\t(deftest static-traversal-is-refused-over-the-wire\n   155\t  (doseq [path [\"/images/../deps.edn\" \"/images/%2e%2e/deps.edn\" \"/grid/images/../deps.edn\"\n   156\t                \"/images//etc/passwd\"]]\n   157\t    (let [r (sup/http (port) \"GET\" path)]\n   158\t      (is (= 404 (:status r)) path)\n   159\t      (is (not (str/includes? (:text r) \":paths\")) path)))\n   160\t  (is (= \"image/png\"\n   161\t         (second (re-find #\"(?i)content-type: (image/png)\" (:text (sup/http (port) \"GET\" \"/images/7..png\")))))))\n   162\t\n   163\t\n   164\t(deftest the-edge-helper-agrees-with-the-wire\n   165\t  (is (= \"/s/x\" (edge/strip-grid \"/grid/s/x\"))))\n     1\t(ns dao.star-cart.catalog-test\n     2\t  \"The catalog through dao.space: reads by q + collect, the checked-in seed,\n     3\t   edits with validation, tagory and image add/remove, persistence, atomic\n     4\t   write, concurrent saves.\"\n     5\t  (:require [clojure.java.io :as io]\n     6\t            [clojure.test :refer [deftest is testing]]\n     7\t            [dao.space.query :as query]\n     8\t            [dao.space.transact :as transact]\n     9\t            [dao.star-cart.catalog :as catalog]\n    10\t            [dao.star-cart.grid-effects :as fx]\n    11\t            [dao.star-cart.store :as store]\n    12\t            [dao.star-cart.support :as sup]))\n    13\t\n    14\t\n    15\t(def seed \"resources/dao_star_cart/catalog.edn\")\n    16\t(def asset-root \"resources/dao_star_cart/public\")\n    17\t\n    18\t\n    19\t(def three\n    20\t  [{:item/slug \"a\" :item/name \"Alpha\" :item/price 100 :item/description \"first\"\n    21\t    :item/images [{:image/url \"/images/7..png\"} {:image/url \"/images/8..png\"}]\n    22\t    :item/tagories [{:tagory/name \"one\"} {:tagory/name \"two\"}]}\n    23\t   {:item/slug \"b\" :item/name \"Bravo\" :item/price 250\n    24\t    :item/images [{:image/url \"/images/36.png\"}] :item/tagories [{:tagory/name \"two\"}]}\n    25\t   {:item/slug \"c\" :item/name \"Charlie\" :item/price 300\n    26\t    :item/images [{:image/url \"/images/37.png\"}] :item/tagories []}])\n    27\t\n    28\t\n    29\t(defn- fixture-store\n    30\t  ([] (fixture-store {}))\n    31\t  ([opts]\n    32\t   (let [dir (sup/temp-dir)\n    33\t         path (str (io/file dir \"catalog.edn\"))]\n    34\t     (spit path (pr-str {:store/name \"T\" :items three}))\n    35\t     (assoc (store/open (merge {:path path :seed path} opts)) :test-path path))))\n    36\t\n    37\t\n    38\t(deftest catalog-reads-go-through-q-and-collect\n    39\t  (let [ds (:datoms (transact/prepare-tx {:base-datoms []\n    40\t                                          :tx-data (into catalog/schema-tx (catalog/items->tx three))}))\n    41\t        calls (atom 0)\n    42\t        real-q query/q\n    43\t        real-collect query/collect\n    44\t        collects (atom 0)]\n    45\t    (with-redefs [query/q (fn [& a] (swap! calls inc) (apply real-q a))\n    46\t                  query/collect (fn [r] (swap! collects inc) (real-collect r))]\n    47\t      (let [items (catalog/items (catalog/db ds))]\n    48\t        (is (= [\"Alpha\" \"Bravo\" \"Charlie\"] (map :name items)))\n    49\t        (is (= [\"/images/7..png\" \"/images/8..png\"] (:images (first items))))\n    50\t        (is (= [\"one\" \"two\"] (:tagories (first items))))\n    51\t        (is (pos? @calls))\n    52\t        (is (= @calls @collects) \"every q result is collected\")))))\n    53\t\n    54\t\n    55\t(deftest the-checked-in-seed-boots\n    56\t  (let [data (store/read-catalog seed)\n    57\t        st (store/open {:seed seed})\n    58\t        items (store/items st)\n    59\t        named (remove #(sup/blank? (:name %)) items)]\n    60\t    (is (= 249 (count (:items data))))\n    61\t    (is (= 249 (count items)))\n    62\t    (is (= 2 (- (count items) (count named))) \"two empty placeholders sit in the source data\")\n    63\t    (is (= 247 (count named)))\n    64\t    (is (every? #(and (integer? (:price %)) (seq (:images %))) named))\n    65\t    (is (every? #(.isFile (io/file asset-root (subs (first (:images %)) 1))) (take 20 named))\n    66\t        \"image urls name files on disk\")))\n    67\t\n    68\t\n    69\t(defn- apply! [st slug changes] (fx/apply-edit! st asset-root {:item slug :changes changes}))\n    70\t\n    71\t\n    72\t(deftest edits-transact-and-queries-see-them\n    73\t  (let [st (fixture-store)]\n    74\t    (is (= {:saved \"a\"} (apply! st \"a\" {:name \" Alpha 2 \" :price \"199\" :description \"new\"})))\n    75\t    (let [a (store/item st \"a\")]\n    76\t      (is (= \"Alpha 2\" (:name a)))\n    77\t      (is (= 199 (:price a)))\n    78\t      (is (= \"new\" (:description a))))))\n    79\t\n    80\t\n    81\t(deftest tagory-add-and-remove\n    82\t  (let [st (fixture-store)\n    83\t        with (fn [n] (catalog/items-with-tagory (store/db st) n))]\n    84\t    (is (= #{\"a\" \"b\"} (with \"two\")) \"a multi-tagory item and a shared tagory\")\n    85\t    (is (= {:saved \"c\"} (apply! st \"c\" {:add-tagory \"fresh\"})))\n    86\t    (is (= #{\"c\"} (with \"fresh\")))\n    87\t    (is (= {:saved \"c\"} (apply! st \"c\" {:add-tagory \"two\"})))\n    88\t    (is (= #{\"a\" \"b\" \"c\"} (with \"two\")))\n    89\t    (is (= {:saved \"a\"} (apply! st \"a\" {:remove-tagory \"two\"})))\n    90\t    (is (= #{\"b\" \"c\"} (with \"two\")))\n    91\t    (is (= [\"one\"] (:tagories (store/item st \"a\"))))\n    92\t    (is (= {:rejected \"tagory is not on the item\"} (apply! st \"a\" {:remove-tagory \"two\"})))))\n    93\t\n    94\t\n    95\t(deftest image-add-and-remove\n    96\t  (let [st (fixture-store)]\n    97\t    (is (= {:saved \"b\"} (apply! st \"b\" {:add-image \"/images/7..png\"})))\n    98\t    (is (= [\"/images/36.png\" \"/images/7..png\"] (:images (store/item st \"b\"))))\n    99\t    (is (= {:saved \"b\"} (apply! st \"b\" {:remove-image \"/images/36.png\"})))\n   100\t    (is (= [\"/images/7..png\"] (:images (store/item st \"b\"))))\n   101\t    (testing \"the other item sharing no entity is untouched\"\n   102\t      (is (= [\"/images/7..png\" \"/images/8..png\"] (:images (store/item st \"a\")))))))\n   103\t\n   104\t\n   105\t(deftest validation-rejects-and-leaves-the-db-unchanged\n   106\t  (let [st (fixture-store)\n   107\t        before @(:datoms st)]\n   108\t    (doseq [[label changes]\n   109\t            {\"negative price\" {:price -5}\n   110\t             \"fractional price\" {:price \"1.5\"}\n   111\t             \"huge price\" {:price 1000000000000}\n   112\t             \"empty name\" {:name \"   \"}\n   113\t             \"oversized name\" {:name (apply str (repeat 201 \"x\"))}\n   114\t             \"oversized description\" {:description (apply str (repeat 2001 \"x\"))}\n   115\t             \"image outside /images/\" {:add-image \"/etc/passwd\"}\n   116\t             \"image traversal\" {:add-image \"/images/../catalog.edn\"}\n   117\t             \"image not on disk\" {:add-image \"/images/nope.png\"}\n   118\t             \"image not an image path\" {:add-image \"http://example.com/x.png\"}\n   119\t             \"empty tagory\" {:add-tagory \"\"}\n   120\t             \"oversized tagory\" {:add-tagory (apply str (repeat 81 \"t\"))}}]\n   121\t      (let [r (apply! st \"a\" changes)]\n   122\t        (is (contains? r :rejected) label)))\n   123\t    (is (contains? (fx/apply-edit! st asset-root {:item \"zzz\" :changes {:price 1}}) :rejected))\n   124\t    (is (identical? before @(:datoms st)) \"nothing was transacted\")))\n   125\t\n   126\t\n   127\t(deftest persistence-round-trips-through-the-written-file\n   128\t  (let [st (fixture-store)]\n   129\t    (apply! st \"a\" {:price 777})\n   130\t    (apply! st \"a\" {:add-tagory \"persisted\"})\n   131\t    (let [written (store/read-catalog (:test-path st))\n   132\t          fresh (store/open {:seed (:test-path st)})]\n   133\t      (is (= 3 (count (:items written))))\n   134\t      (is (= 777 (:item/price (first (filter #(= \"a\" (:item/slug %)) (:items written))))))\n   135\t      (is (= (store/items st) (store/items fresh)) \"a fresh store sees the edit\")\n   136\t      (is (= (catalog/item-maps (store/db st)) (:items written)) \"the file is the item maps\"))))\n   137\t\n   138\t\n   139\t(deftest a-failed-write-leaves-the-old-file-intact\n   140\t  (let [st (fixture-store)\n   141\t        old (slurp (:test-path st))\n   142\t        failing (assoc st :write-fn (fn [_ _] (throw (ex-info \"disk full\" {}))))]\n   143\t    (is (map? (apply! failing \"a\" {:price 5})) \"the edit itself stands in memory\")\n   144\t    (is (= 5 (:price (store/item failing \"a\"))))\n   145\t    (testing \"the real writer never exposes a partial file\"\n   146\t      (let [target (str (:test-path st) \".x\")]\n   147\t        (spit target \"OLD\")\n   148\t        (is (thrown? Exception (with-redefs [spit (fn [& _] (throw (java.io.IOException. \"boom\")))]\n   149\t                                 (store/write-atomically! target \"NEW\"))))\n   150\t        (is (= \"OLD\" (slurp target)))))\n   151\t    (is (= old (slurp (:test-path st))) \"the failing writer was injected, the file untouched\")))\n   152\t\n   153\t\n   154\t(deftest an-unwritable-path-logs-and-the-store-keeps-working\n   155\t  (let [st (store/open {:path \"/nonexistent-dir/catalog.edn\" :seed seed\n   156\t                        :write-fn store/write-atomically!})]\n   157\t    (is (= 249 (count (store/items st))))\n   158\t    (is (= {:saved \"p4-pro-game-console\"}\n   159\t           (fx/apply-edit! st asset-root {:item \"p4-pro-game-console\" :changes {:price 1}})))\n   160\t    (is (= 1 (:price (store/item st \"p4-pro-game-console\"))))))\n   161\t\n   162\t\n   163\t(deftest concurrent-saves-both-survive\n   164\t  (dotimes [_ 20]\n   165\t    (let [st (fixture-store)\n   166\t          go (java.util.concurrent.CountDownLatch. 1)\n   167\t          t (fn [slug price]\n   168\t              (doto (Thread. (fn [] (.await go) (apply! st slug {:price price}))) (.start)))\n   169\t          ts [(t \"a\" 11) (t \"b\" 22) (t \"c\" 33)]]\n   170\t      (.countDown go)\n   171\t      (doseq [^Thread x ts] (.join x 5000))\n   172\t      (is (= [11 22 33] (mapv #(:price (store/item st %)) [\"a\" \"b\" \"c\"]))))))\n","exit_code":0,"status":"completed"}}
