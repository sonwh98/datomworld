{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/star_cart/fixes_test.clj && nl -ba resources/dao_star_cart/README.md && nl -ba docker/dao-star-cart/README.md'","aggregated_output":"     1\t(ns dao.star-cart.fixes-test\n     2\t  \"Review round: symlink containment, collision-free tagory tempids, snapshot\n     3\t   ordering, single image-url encoding, line terminators, and the default\n     4\t   catalog path.\"\n     5\t  (:require [clojure.data.json :as json]\n     6\t            [clojure.java.io :as io]\n     7\t            [clojure.string :as str]\n     8\t            [clojure.test :refer [deftest is testing]]\n     9\t            [dao.star-cart.catalog :as catalog]\n    10\t            [dao.star-cart.edge :as edge]\n    11\t            [dao.star-cart.grid-effects :as fx]\n    12\t            [dao.star-cart.grid-view :as grid-view]\n    13\t            [dao.star-cart.main :as main]\n    14\t            [dao.star-cart.store :as store]\n    15\t            [dao.star-cart.support :as sup]\n    16\t            [dao.star-cart.view :as v]\n    17\t            [dao.star.signals :as signals])\n    18\t  (:import [java.nio.file Files]))\n    19\t\n    20\t\n    21\t(def asset-root \"resources/dao_star_cart/public\")\n    22\t\n    23\t\n    24\t(defn- fixture\n    25\t  [item-maps & [opts]]\n    26\t  (let [dir (sup/temp-dir)\n    27\t        path (str (io/file dir \"catalog.edn\"))]\n    28\t    (spit path (pr-str {:store/name \"T\" :items item-maps}))\n    29\t    (assoc (store/open (merge {:path path :seed path} opts)) :test-path path)))\n    30\t\n    31\t\n    32\t(defn- item\n    33\t  [slug & {:as more}]\n    34\t  (merge {:item/slug slug :item/name slug :item/price 100\n    35\t          :item/images [{:image/url \"/images/7..png\"}] :item/tagories []}\n    36\t         more))\n    37\t\n    38\t\n    39\t;; 1. symlinks\n    40\t\n    41\t(deftest an-intermediate-symlink-cannot-escape-the-asset-root\n    42\t  (let [dir (sup/temp-dir)\n    43\t        root (.toPath (io/file dir \"public\"))\n    44\t        outside (.toPath (io/file dir \"outside\"))]\n    45\t    (Files/createDirectories (.resolve root \"images\") (make-array java.nio.file.attribute.FileAttribute 0))\n    46\t    (Files/createDirectories outside (make-array java.nio.file.attribute.FileAttribute 0))\n    47\t    (spit (.toFile (.resolve outside \"secret.txt\")) \"SECRET\")\n    48\t    (spit (.toFile (.resolve root \"images/ok.png\")) \"PNG\")\n    49\t    (Files/createSymbolicLink (.resolve root \"images/link\") outside (make-array java.nio.file.attribute.FileAttribute 0))\n    50\t    (Files/createSymbolicLink (.resolve root \"images/file-link\") (.resolve outside \"secret.txt\")\n    51\t                              (make-array java.nio.file.attribute.FileAttribute 0))\n    52\t    (let [root (.toAbsolutePath (.normalize root))]\n    53\t      (is (some? (edge/static-file root \"/images/ok.png\")) \"a plain file is served\")\n    54\t      (is (nil? (edge/static-file root \"/images/link/secret.txt\")) \"an intermediate directory symlink\")\n    55\t      (is (nil? (edge/static-file root \"/images/file-link\")) \"a symlinked file\")\n    56\t      (is (nil? (edge/static-file root \"/images/link\"))))))\n    57\t\n    58\t\n    59\t;; 2. tempids\n    60\t\n    61\t(deftest tagories-that-hash-alike-stay-distinct\n    62\t  (is (= (hash \"Aa\") (hash \"BB\")) \"the premise: these collide under hash\")\n    63\t  (let [st (fixture [(item \"a\" :item/tagories [{:tagory/name \"Aa\"}])\n    64\t                     (item \"b\" :item/tagories [{:tagory/name \"BB\"}])])\n    65\t        with (fn [s n] (catalog/items-with-tagory (store/db s) n))]\n    66\t    (is (= #{\"a\"} (with st \"Aa\")))\n    67\t    (is (= #{\"b\"} (with st \"BB\")))\n    68\t    (fx/apply-edit! st asset-root {:item \"b\" :changes {:price 5}})\n    69\t    (let [fresh (store/open {:seed (:test-path st)})]\n    70\t      (is (= #{\"a\"} (with fresh \"Aa\")))\n    71\t      (is (= #{\"b\"} (with fresh \"BB\")))\n    72\t      (fx/apply-edit! fresh asset-root {:item \"a\" :changes {:remove-tagory \"Aa\"}})\n    73\t      (is (= #{} (with fresh \"Aa\")))\n    74\t      (is (= #{\"b\"} (with fresh \"BB\")) \"removing one leaves the other\"))))\n    75\t\n    76\t\n    77\t;; 3. reconnect attribute is asserted in view-test\n    78\t\n    79\t(deftest the-subscription-asks-for-unconditional-retry\n    80\t  (is (str/includes? (v/shop-begin \"R\") \"{retry:'always'}\"))\n    81\t  (is (str/includes? (grid-view/grid-begin \"R\") \"{retry:'always'}\")))\n    82\t\n    83\t\n    84\t;; 4. snapshot order\n    85\t\n    86\t(deftest snapshots-are-written-in-update-order\n    87\t  (let [calls (atom 0)\n    88\t        slow-first (fn [path content]\n    89\t                     (when (= 1 (swap! calls inc)) (Thread/sleep 300))\n    90\t                     (store/write-atomically! path content))\n    91\t        st (fixture [(item \"a\") (item \"b\")] {:write-fn slow-first})\n    92\t        t1 (Thread. (fn [] (fx/apply-edit! st asset-root {:item \"a\" :changes {:price 11}})))\n    93\t        t2 (Thread. (fn [] (Thread/sleep 60) (fx/apply-edit! st asset-root {:item \"b\" :changes {:price 22}})))]\n    94\t    (.start t1) (.start t2) (.join t1 5000) (.join t2 5000)\n    95\t    (is (= 2 @calls))\n    96\t    (let [fresh (store/open {:seed (:test-path st)})]\n    97\t      (is (= [11 22] (mapv #(:price (store/item fresh %)) [\"a\" \"b\"]))\n    98\t          \"the file carries both edits, not an older snapshot\"))))\n    99\t\n   100\t\n   101\t;; 5. image urls\n   102\t\n   103\t(deftest an-encoded-image-spelling-is-stored_decoded_and-served\n   104\t  (let [st (fixture [(item \"a\")])\n   105\t        real \"/images/P-141  Green Camouflage.png\"\n   106\t        encoded \"/images/P-141%20%20Green%20Camouflage.png\"]\n   107\t    (is (.isFile (io/file asset-root (subs real 1))) \"the premise: this file exists\")\n   108\t    (is (= {:saved \"a\"} (fx/apply-edit! st asset-root {:item \"a\" :changes {:add-image encoded}})))\n   109\t    (is (some #{real} (:images (store/item st \"a\"))) \"stored as the canonical decoded path\")\n   110\t    (is (= encoded (v/enc-path real)) \"encoded exactly once for the page\")\n   111\t    (let [site (edge/make-edge {:asset-root asset-root :shop identity :grid identity})]\n   112\t      (is (= 200 (:status (site {:uri encoded :request-method :get})))))\n   113\t    (testing \"the other spellings of it are the same image\"\n   114\t      (is (= {:rejected \"image already on the item\"}\n   115\t             (fx/apply-edit! st asset-root {:item \"a\" :changes {:add-image real}})))\n   116\t      (is (= {:rejected \"image already on the item\"}\n   117\t             (fx/apply-edit! st asset-root {:item \"a\" :changes {:add-image encoded}}))))\n   118\t    (is (= {:saved \"a\"} (fx/apply-edit! st asset-root {:item \"a\" :changes {:remove-image real}})))\n   119\t    (is (contains? (fx/apply-edit! st asset-root {:item \"a\" :changes {:add-image \"/images/%zz.png\"}}) :rejected))))\n   120\t\n   121\t\n   122\t;; 6. line terminators\n   123\t\n   124\t(def nasty \"a\\r\\nb\\rc\\nd e f'g\\\\h\")\n   125\t\n   126\t\n   127\t(deftest line-terminators-never-reach-the-sse-stream-raw\n   128\t  (is (not (re-find #\"[\\r\\n  ]\" (v/js-lit nasty))))\n   129\t  (let [catalog {:items (fn [] [{:key \"k\" :name nasty :price 5 :description nasty :images [] :tagories [nasty]}])\n   130\t                 :item (fn [_] {:key \"k\" :name nasty :price 5 :description nasty :images [] :tagories [nasty]})}]\n   131\t    (doseq [sse [(grid-view/grid-project catalog \"T\" {:sel \"k\" :status \"\" :msg \"\"})\n   132\t                 (grid-view/grid-project catalog \"T\" {:sel \"k\" :status \"rejected\" :msg nasty})\n   133\t                 (v/shop-project catalog \"T\" {:page \"item\" :item \"k\" :cart {}})\n   134\t                 (v/shop-project catalog \"T\" {:page \"cart\" :cart {\"k\" 1}})]]\n   135\t      (is (not (str/includes? sse \"\\r\")) \"no raw CR\")\n   136\t      (is (= 3 (count (re-seq #\"\\n\" sse))) \"only the framing newlines\")\n   137\t      (is (str/ends-with? sse \"\\n\\n\")))))\n   138\t\n   139\t\n   140\t(deftest line-terminators-round-trip-through-select-and-save\n   141\t  (let [st (fixture [(item \"a\")])]\n   142\t    (testing \"through the signals JSON the client sends\"\n   143\t      (let [s (signals/decode {:http/method :post\n   144\t                               :http/body (json/write-str {:act \"save\" :desc nasty :name \"n\"})})]\n   145\t        (is (= nasty (:desc s)))))\n   146\t    (testing \"through the transact and back\"\n   147\t      (is (= {:saved \"a\"} (fx/apply-edit! st asset-root {:item \"a\" :changes {:description nasty}})))\n   148\t      (is (= nasty (:description (store/item st \"a\"))))\n   149\t      (let [fresh (store/open {:seed (:test-path st)})]\n   150\t        (is (= nasty (:description (store/item fresh \"a\"))) \"and through the written file\")))\n   151\t    (testing \"and the page that selects it carries entities, not raw terminators\"\n   152\t      (let [sse (grid-view/grid-project (store/catalog-fns st) \"T\" {:sel \"a\" :status \"\" :msg \"\"})]\n   153\t        (is (str/includes? sse \"&#13;&#10;\"))\n   154\t        (is (not (str/includes? sse \"\\r\")))))))\n   155\t\n   156\t\n   157\t;; 7. default catalog path\n   158\t\n   159\t(deftest the-catalog-path-default-is-writable-and-loud-when-absent\n   160\t  (is (= \"target/cart-catalog.edn\" main/default-catalog-path))\n   161\t  (let [dir (sup/temp-dir)\n   162\t        path (str (io/file dir \"nested\" \"deeper\" \"c.edn\"))]\n   163\t    (store/write-atomically! path \"{}\")\n   164\t    (is (= \"{}\" (slurp path)) \"missing parent directories are created\"))\n   165\t  (let [err (java.io.StringWriter.)]\n   166\t    (binding [*err* err]\n   167\t      (store/open {:seed \"resources/dao_star_cart/catalog.edn\"}))\n   168\t    (is (str/includes? (str err) \"MEMORY ONLY\"))))\n     1\t# dao.star cart\n     2\t\n     3\tA reproduction of the functionality of the lambdacart shop on dao.star Mode 1,\n     4\twith dao.space as the database and `dao.space.query/q` for every query. The UI\n     5\tis its own minimal dark theme; no lambdacart code is reused.\n     6\t\n     7\t**Shop** (`/`): catalog grid, item detail, add/remove, cart with total, checkout\n     8\tstub (no payment). The cart is a local of the session's yin.vm continuation and\n     9\tlives as long as the lineage lease.\n    10\t\n    11\t**Grid** (`/grid`): catalog editor. Edit name, price (minor units), description;\n    12\tadd/remove images (existing `/images/` files only) and tagories. Every mutation\n    13\tgoes through a host effects interpreter that validates it, transacts it, and\n    14\tappends `{:saved ..}` / `{:rejected ..}` back to the session; the UI shows\n    15\t`saving` until then. Each save rewrites `catalog.edn` (atomic rename).\n    16\t\n    17\t## Read this\n    18\t\n    19\t- **No authentication on the grid. Do not expose it.** The session token\n    20\t  identifies a session; it is not authorization.\n    21\t- **Coherence is stale-until-navigation.** A storefront view shows the catalog as\n    22\t  of its last projection; a grid save is visible after the shopper navigates or\n    23\t  reloads. There is no broadcast; the shop footer says so.\n    24\t- **A subscription ends once per hour** (the exchange lease's `:dao.lease/max`)\n    25\t  and the browser reconnects (the pages subscribe with `retry: 'always'`), which re-projects the current cart.\n    26\t- **Saves go to `CATALOG_PATH`** (default `target/cart-catalog.edn`, created on first boot from the\n    27\t  seed, parent directories included). If a path cannot be written the demo logs it and\n    28\t  holds edits in memory only; with no path at all it says so at boot.\n    29\t- **`public/js/datastar.js` must be vendored** at the pinned version\n    30\t  (`dao.star-cart.view/datastar-version`, 1.0.0-RC.7) before the pages work in a\n    31\t  browser: `sh resources/dao_star_cart/vendor-datastar.sh`.\n    32\t\n    33\t## Provenance\n    34\t\n    35\t`catalog.edn` was extracted from the live lambdacart Datomic on 2026-10-26 (see\n    36\tthe header comment in that file for the form): 249 items including two empty\n    37\tplaceholder records present in the source. Prices are minor units. Product images\n    38\t(`public/images/`, 228 files, 68 MB) belong to the shop and are gitignored;\n    39\tnothing here is to be published without the owner's say-so.\n     1\t# dao.star cart: run note\n     2\t\n     3\t- Port **3004** in the container; map `3004:3004` (a separate compose file or\n     4\t  `docker run`; do not touch the lambdacart compose project).\n     5\t- `CATALOG_PATH` (default `/data/catalog.edn`) must be on a **volume**. On first\n     6\t  boot with an empty volume the baked seed `catalog.edn` is copied there; every\n     7\t  grid save rewrites it atomically. If the path is unwritable the demo logs it\n     8\t  and keeps editing in memory. Edits in a running container never touch the repo\n     9\t  copy of `catalog.edn`.\n    10\t- Images are baked from the build context (`resources/dao_star_cart/public/images/`,\n    11\t  68 MB, gitignored). Alternatively mount that directory read-only over\n    12\t  `/app/resources/dao_star_cart/public/images` and set `ASSET_ROOT` if the layout differs.\n    13\t- `deps.edn` here is trimmed (no datomic, postgres, antlr, jsoup, stigmergy/chp):\n    14\t  the demo's namespace closure was checked to load none of them.\n    15\t- Run limits on shiva: `docker run --memory 1g --cpus 1`; build with BuildKit and\n    16\t  `docker build` only. Do not run `bb` lanes or the repo test suites there.\n    17\t- **No authentication on `/grid`: do not expose this port beyond the private\n    18\t  interface.**\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/clj/dao/star_cart/catalog.clj && nl -ba src/clj/dao/star_cart/grid_effects.clj && nl -ba src/clj/dao/star_cart/main.clj'","aggregated_output":"     1\t(ns dao.star-cart.catalog\n     2\t  \"Catalog reads and the catalog's datom shape.  Every read is\n     3\t   `dao.space.query/q` + `collect` over a db value (a `current` view over a\n     4\t   `relation`); nothing here touches a store or an atom.\"\n     5\t  (:require [clojure.string :as str]\n     6\t            [dao.space.query :as query]))\n     7\t\n     8\t\n     9\t(def schema-tx\n    10\t  \"Schema first: images and tagories are many-valued refs.\"\n    11\t  [{:db/ident :item/images :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}\n    12\t   {:db/ident :item/tagories :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])\n    13\t\n    14\t\n    15\t(defn db\n    16\t  \"The db value over accumulated datoms.\"\n    17\t  [datoms]\n    18\t  (query/current (query/relation datoms)))\n    19\t\n    20\t\n    21\t(defn items->tx\n    22\t  \"tx-data for plain item maps (the on-disk shape): one entity per item, one\n    23\t   per image, one per distinct tagory name, refs by tempid.\"\n    24\t  [item-maps]\n    25\t  (let [indexed (map-indexed vector item-maps)\n    26\t        tagories (distinct (for [[_ m] indexed t (:item/tagories m)] (:tagory/name t)))\n    27\t        ;; one tempid per distinct name, allocated by position: collision-free\n    28\t        ;; where a hash of the name is not (\"Aa\" and \"BB\" hash alike)\n    29\t        tagory-tid (zipmap tagories (map #(str \"tid_tag_\" %) (range)))]\n    30\t    (vec\n    31\t      (concat\n    32\t        (for [n tagories] {:db/id (tagory-tid n) :tagory/name n})\n    33\t        (mapcat\n    34\t          (fn [[i m]]\n    35\t            (let [img-tids (map-indexed (fn [j _] (str \"tid_img_\" i \"_\" j)) (:item/images m))]\n    36\t              (concat\n    37\t                (map (fn [tid img] {:db/id tid :image/url (:image/url img)}) img-tids (:item/images m))\n    38\t                [(cond-> {:db/id (str \"tid_item_\" i)\n    39\t                          :item/slug (:item/slug m)\n    40\t                          :item/name (:item/name m)\n    41\t                          :item/price (:item/price m)\n    42\t                          :item/images (vec img-tids)\n    43\t                          :item/tagories (mapv (comp tagory-tid :tagory/name) (:item/tagories m))}\n    44\t                   (:item/description m) (assoc :item/description (:item/description m)))])))\n    45\t          indexed)))))\n    46\t\n    47\t\n    48\t(defn- rows\n    49\t  [db' q-form]\n    50\t  (query/collect (query/q q-form db')))\n    51\t\n    52\t\n    53\t(defn- by-slug\n    54\t  [db' q-form]\n    55\t  (into {} (rows db' q-form)))\n    56\t\n    57\t\n    58\t(defn items\n    59\t  \"Every item as `{:key :name :price :description :images [url] :tagories [name]}`,\n    60\t   sorted by trimmed lower-case name.  Image order is the order they were added.\"\n    61\t  [db']\n    62\t  (let [names (by-slug db' '[:find ?s ?n :where [?e :item/slug ?s] [?e :item/name ?n]])\n    63\t        prices (by-slug db' '[:find ?s ?p :where [?e :item/slug ?s] [?e :item/price ?p]])\n    64\t        descs (by-slug db' '[:find ?s ?d :where [?e :item/slug ?s] [?e :item/description ?d]])\n    65\t        imgs (group-by first\n    66\t                       (sort-by second\n    67\t                                (rows db' '[:find ?s ?i ?u :where [?e :item/slug ?s]\n    68\t                                            [?e :item/images ?i] [?i :image/url ?u]])\n    69\t                                ))\n    70\t        tags (group-by first\n    71\t                       (rows db' '[:find ?s ?n :where [?e :item/slug ?s]\n    72\t                                   [?e :item/tagories ?t] [?t :tagory/name ?n]]))]\n    73\t    (->> names\n    74\t         (map (fn [[slug n]]\n    75\t                {:key slug :name n :price (get prices slug) :description (get descs slug \"\")\n    76\t                 :images (mapv #(nth % 2) (get imgs slug))\n    77\t                 :tagories (vec (sort (map second (get tags slug))))}))\n    78\t         (sort-by #(str/lower-case (str/trim (:name %))))\n    79\t         vec)))\n    80\t\n    81\t\n    82\t(defn item\n    83\t  [db' slug]\n    84\t  (first (filter #(= slug (:key %)) (items db'))))\n    85\t\n    86\t\n    87\t(defn item-eid\n    88\t  \"The entity id of the item with `slug`, or nil.\"\n    89\t  [db' slug]\n    90\t  (ffirst (query/collect (query/q '[:find ?e :in $ ?s :where [?e :item/slug ?s]] db' slug))))\n    91\t\n    92\t\n    93\t(defn image-eid\n    94\t  \"The image entity of `url` on item `slug`, or nil.\"\n    95\t  [db' slug url]\n    96\t  (ffirst (query/collect\n    97\t            (query/q '[:find ?i :in $ ?s ?u :where [?e :item/slug ?s]\n    98\t                       [?e :item/images ?i] [?i :image/url ?u]]\n    99\t                     db' slug url))))\n   100\t\n   101\t\n   102\t(defn tagory-eid\n   103\t  \"The tagory entity named `name`, or nil.\"\n   104\t  [db' name]\n   105\t  (ffirst (query/collect (query/q '[:find ?t :in $ ?n :where [?t :tagory/name ?n]] db' name))))\n   106\t\n   107\t\n   108\t(defn tagory-linked?\n   109\t  [db' slug name]\n   110\t  (boolean (seq (query/collect\n   111\t                  (query/q '[:find ?t :in $ ?s ?n :where [?e :item/slug ?s]\n   112\t                             [?e :item/tagories ?t] [?t :tagory/name ?n]]\n   113\t                           db' slug name)))))\n   114\t\n   115\t\n   116\t(defn items-with-tagory\n   117\t  \"Slugs of the items carrying tagory `name`.\"\n   118\t  [db' name]\n   119\t  (set (map first (query/collect\n   120\t                    (query/q '[:find ?s :in $ ?n :where [?t :tagory/name ?n]\n   121\t                               [?e :item/tagories ?t] [?e :item/slug ?s]]\n   122\t                             db' name)))))\n   123\t\n   124\t\n   125\t(defn item-maps\n   126\t  \"The on-disk shape: plain item maps with nested image and tagory maps.\"\n   127\t  [db']\n   128\t  (mapv (fn [i]\n   129\t          (cond-> {:item/slug (:key i) :item/name (:name i) :item/price (:price i)\n   130\t                   :item/images (mapv (fn [u] {:image/url u}) (:images i))\n   131\t                   :item/tagories (mapv (fn [n] {:tagory/name n}) (:tagories i))}\n   132\t            (seq (:description i)) (assoc :item/description (:description i))))\n   133\t        (items db')))\n     1\t(ns dao.star-cart.grid-effects\n     2\t  \"The grid's stepped effects interpreter.  A peer observer of each grid\n     3\t   session's view medium (its own cursor, beside the driver's): when a model\n     4\t   carries `{:edit {:item slug :changes {...}}}` it validates the change, runs\n     5\t   the transact through the store, and appends a `{:saved slug}` or\n     6\t   `{:rejected reason}` confirmation to that session's routed input medium.  The\n     7\t   program therefore renders `saving` until the transact has completed.\n     8\t\n     9\t   Validation is here because signals are the client's unverified claim:\n    10\t   name 1-200 characters; price an integer 0..100000000 (minor units);\n    11\t   description at most 2000; an image URL an existing file under `/images/`;\n    12\t   a tagory 1-80 characters.\"\n    13\t  (:require [clojure.data.json :as json]\n    14\t            [clojure.string :as str]\n    15\t            [dao.star-cart.catalog :as catalog]\n    16\t            [dao.star-cart.edge :as edge]\n    17\t            [dao.star-cart.store :as store]\n    18\t            [dao.star.driver :as driver]\n    19\t            [dao.star.lease :as lease]\n    20\t            [dao.stream :as stream])\n    21\t  (:import [java.nio.file Paths]))\n    22\t\n    23\t\n    24\t(def max-name 200)\n    25\t(def max-description 2000)\n    26\t(def max-tagory 80)\n    27\t(def max-price 100000000)\n    28\t\n    29\t\n    30\t(def ^:private retract-meta {:db/op :db/retract})\n    31\t\n    32\t\n    33\t(defn- reject!\n    34\t  [reason]\n    35\t  (throw (ex-info \"rejected\" {::rejected reason})))\n    36\t\n    37\t\n    38\t(defn- parse-price\n    39\t  [p]\n    40\t  (cond (integer? p) p\n    41\t        (and (string? p) (re-matches #\"\\d{1,12}\" (str/trim p))) (Long/parseLong (str/trim p))\n    42\t        :else (reject! \"price must be a whole number of cents\")))\n    43\t\n    44\t\n    45\t(defn- check-name\n    46\t  [n]\n    47\t  (when-not (and (string? n) (<= 1 (count (str/trim n)) max-name))\n    48\t    (reject! (str \"name must be 1-\" max-name \" characters\")))\n    49\t  (str/trim n))\n    50\t\n    51\t\n    52\t(defn- check-image\n    53\t  \"The canonical DECODED image path.  An encoded spelling (`%20`) is decoded\n    54\t   once here, so the catalog stores the file's real path and the view encodes it\n    55\t   exactly once.\"\n    56\t  [root url]\n    57\t  (when-not (and (string? url) (<= (count url) 300) (str/starts-with? url \"/images/\"))\n    58\t    (reject! \"image must be an /images/ path\"))\n    59\t  (let [decoded (or (edge/decode-path url) (reject! \"image path is malformed\"))]\n    60\t    (when-not (edge/static-file root decoded)\n    61\t      (reject! \"image file does not exist\"))\n    62\t    decoded))\n    63\t\n    64\t\n    65\t(defn- check-tagory\n    66\t  [n]\n    67\t  (when-not (and (string? n) (<= 1 (count (str/trim n)) max-tagory))\n    68\t    (reject! (str \"tagory must be 1-\" max-tagory \" characters\")))\n    69\t  (str/trim n))\n    70\t\n    71\t\n    72\t(defn- edit-tx\n    73\t  \"tx-data for `changes` on item `slug` under `db`, or a rejection.\"\n    74\t  [root db slug changes]\n    75\t  (let [eid (or (catalog/item-eid db slug) (reject! \"no such item\"))\n    76\t        current (catalog/item db slug)\n    77\t        ;; an unchanged value is not transacted: re-asserting a card-one\n    78\t        ;; value would retract and assert the same datom in one tx\n    79\t        changed (fn [k v] (when (not= v (get current k)) v))]\n    80\t    (vec\n    81\t      (concat\n    82\t        (when (some? (:name changes))\n    83\t          (when-some [n (changed :name (check-name (:name changes)))]\n    84\t            [[:db/add eid :item/name n]]))\n    85\t        (when (some? (:price changes))\n    86\t          (let [p (parse-price (:price changes))]\n    87\t            (when-not (<= 0 p max-price) (reject! \"price out of range\"))\n    88\t            (when-some [p' (changed :price p)]\n    89\t              [[:db/add eid :item/price p']])))\n    90\t        (when (some? (:description changes))\n    91\t          (let [d (:description changes)]\n    92\t            (when-not (and (string? d) (<= (count d) max-description))\n    93\t              (reject! (str \"description must be at most \" max-description \" characters\")))\n    94\t            (when-some [d' (changed :description d)]\n    95\t              [[:db/add eid :item/description d']])))\n    96\t        (when (contains? changes :add-image)\n    97\t          (let [u (check-image root (:add-image changes))]\n    98\t            (when (catalog/image-eid db slug u) (reject! \"image already on the item\"))\n    99\t            [{:db/id \"tid_new_image\" :image/url u}\n   100\t             [:db/add eid :item/images \"tid_new_image\"]]))\n   101\t        (when (contains? changes :remove-image)\n   102\t          (let [i (or (catalog/image-eid db slug (:remove-image changes))\n   103\t                      (reject! \"image is not on the item\"))]\n   104\t            [[:db/retract eid :item/images i retract-meta]]))\n   105\t        (when (contains? changes :add-tagory)\n   106\t          (let [n (check-tagory (:add-tagory changes))]\n   107\t            (when (catalog/tagory-linked? db slug n) (reject! \"tagory already on the item\"))\n   108\t            (if-let [t (catalog/tagory-eid db n)]\n   109\t              [[:db/add eid :item/tagories t]]\n   110\t              [{:db/id \"tid_new_tagory\" :tagory/name n}\n   111\t               [:db/add eid :item/tagories \"tid_new_tagory\"]])))\n   112\t        (when (contains? changes :remove-tagory)\n   113\t          (let [n (:remove-tagory changes)\n   114\t                t (when (catalog/tagory-linked? db slug n) (catalog/tagory-eid db n))]\n   115\t            (when-not t (reject! \"tagory is not on the item\"))\n   116\t            [[:db/retract eid :item/tagories t retract-meta]]))))))\n   117\t\n   118\t\n   119\t(defn apply-edit!\n   120\t  \"Validate and transact `edit` (`{:item slug :changes {...}}`).  Answers\n   121\t   `{:saved slug}` or `{:rejected reason}`; a rejection leaves the db unchanged.\"\n   122\t  [store' asset-root {:keys [item changes]}]\n   123\t  (let [root (.toAbsolutePath (.normalize (Paths/get (str asset-root) (make-array String 0))))]\n   124\t    (try\n   125\t      (when-not (and (string? item) (map? changes))\n   126\t        (reject! \"malformed edit\"))\n   127\t      (store/transact-edit! store' (fn [db] (edit-tx root db item changes)))\n   128\t      {:saved item}\n   129\t      (catch clojure.lang.ExceptionInfo e\n   130\t        (if-let [r (::rejected (ex-data e))]\n   131\t          {:rejected r}\n   132\t          {:rejected (str \"edit failed: \" (.getMessage e))}))\n   133\t      (catch Exception e\n   134\t        {:rejected (str \"edit failed: \" (.getMessage e))}))))\n   135\t\n   136\t\n   137\t(defn make-effects\n   138\t  \"`{:driver grid-driver :store store :asset-root path}`.\"\n   139\t  [config]\n   140\t  (atom (assoc config :cursors {})))\n   141\t\n   142\t\n   143\t(defn- confirm!\n   144\t  [drv s result]\n   145\t  (when-let [medium (driver/session-medium drv s)]\n   146\t    (stream/append! medium\n   147\t                    {:exchange nil :kind :input :lineage s\n   148\t                     :token (:occurrence (driver/latest drv s))\n   149\t                     :event {:http/method :post\n   150\t                             :http/body (json/write-str\n   151\t                                          (if-let [slug (:saved result)]\n   152\t                                            {:saved slug}\n   153\t                                            {:rejected (:rejected result)}))}})))\n   154\t\n   155\t\n   156\t(defn effects-step!\n   157\t  \"One pass: read every grid session's view medium with this interpreter's own\n   158\t   cursor, perform each `:edit`, confirm.  Answers the effects atom.\"\n   159\t  [fx]\n   160\t  (let [{:keys [driver store asset-root]} @fx]\n   161\t    (doseq [s (driver/sessions driver)\n   162\t            :let [out (get-in @driver [:sessions s :vm-out])]\n   163\t            :when out]\n   164\t      (let [cursor (or (get-in @fx [:cursors s]) (lease/oldest-cursor out))\n   165\t            r (lease/drain out cursor)]\n   166\t        (swap! fx assoc-in [:cursors s] (:cursor r))\n   167\t        (doseq [model (:values r)\n   168\t                :let [edit (:edit model)]\n   169\t                :when (map? edit)]\n   170\t          (confirm! driver s (apply-edit! store asset-root edit)))))\n   171\t    fx))\n     1\t(ns dao.star-cart.main\n     2\t  \"Boot the dao.star cart: the catalog store, the shop and grid compositions\n     3\t   (one `assemble` function, called twice), the host edge, one tick loop and\n     4\t   one listener.  Environment: PORT (default 3004), CATALOG_PATH (where saves go;\n     5\t   the baked seed is copied there on first boot), ASSET_ROOT.\"\n     6\t  (:require [dao.star-cart.assemble :as assemble]\n     7\t            [dao.star-cart.edge :as edge]\n     8\t            [dao.star-cart.grid-effects :as grid-effects]\n     9\t            [dao.star-cart.grid-program :as grid-program]\n    10\t            [dao.star-cart.grid-view :as grid-view]\n    11\t            [dao.star-cart.program :as program]\n    12\t            [dao.star-cart.store :as store]\n    13\t            [dao.star-cart.view :as view]\n    14\t            [org.httpkit.server :as kit]))\n    15\t\n    16\t\n    17\t(def seed-path \"resources/dao_star_cart/catalog.edn\")\n    18\t(def default-asset-root \"resources/dao_star_cart/public\")\n    19\t(def default-catalog-path\n    20\t  \"Where saves go when CATALOG_PATH is unset: a writable local file, so edits\n    21\t   survive a restart.  The baked seed is copied there on first boot.\"\n    22\t  \"target/cart-catalog.edn\")\n    23\t\n    24\t\n    25\t(defn start!\n    26\t  \"Start the site.  Options: `:port` (0 for ephemeral), `:catalog-path`,\n    27\t   `:asset-root`, `:timing`.  Answers `{:port :store :shop :grid :stop!}`.\"\n    28\t  [{:keys [port catalog-path asset-root timing] :or {asset-root default-asset-root}}]\n    29\t  (let [st (store/open {:path catalog-path :seed seed-path})\n    30\t        catalog (store/catalog-fns st)\n    31\t        shop (assemble/assemble\n    32\t               {:program program/shop-program\n    33\t                :project-fn (fn [occ model] (view/shop-project catalog occ model))\n    34\t                :begin-fn view/shop-begin :timing timing})\n    35\t        grid (assemble/assemble\n    36\t               {:program grid-program/grid-program\n    37\t                :project-fn (fn [occ model] (grid-view/grid-project catalog occ model))\n    38\t                :begin-fn grid-view/grid-begin :timing timing})\n    39\t        fx (grid-effects/make-effects {:driver (:driver grid) :store st :asset-root asset-root})\n    40\t        tick-ms (get (merge assemble/default-timing timing) :tick-ms)\n    41\t        edge-handler (edge/make-edge {:asset-root asset-root\n    42\t                                      :shop (:handler shop) :grid (:handler grid)})\n    43\t        server (kit/run-server edge-handler {:ip \"0.0.0.0\" :port (or port 3004)\n    44\t                                             :max-body 65536 :legacy-return-value? false})\n    45\t        running (atom true)\n    46\t        started (System/currentTimeMillis)\n    47\t        loop-thread (doto (Thread.\n    48\t                            (fn []\n    49\t                              (while @running\n    50\t                                (try\n    51\t                                  (let [now (- (System/currentTimeMillis) started)]\n    52\t                                    ((:step! shop) now)\n    53\t                                    ((:step! grid) now)\n    54\t                                    (grid-effects/effects-step! fx))\n    55\t                                  (catch Throwable t\n    56\t                                    (binding [*out* *err*] (println \"star-cart tick:\" t))))\n    57\t                                (Thread/sleep (long tick-ms)))))\n    58\t                      (.setDaemon true)\n    59\t                      (.start))]\n    60\t    {:port (kit/server-port server)\n    61\t     :store st :shop shop :grid grid :effects fx\n    62\t     :stop! (fn []\n    63\t              (reset! running false)\n    64\t              (.join ^Thread loop-thread 2000)\n    65\t              ((:stop! shop))\n    66\t              ((:stop! grid))\n    67\t              (kit/server-stop! server {:timeout 100}))}))\n    68\t\n    69\t\n    70\t(defn -main\n    71\t  [& _]\n    72\t  (let [port (Long/parseLong (or (System/getenv \"PORT\") \"3004\"))\n    73\t        site (start! {:port port\n    74\t                      :catalog-path (or (System/getenv \"CATALOG_PATH\") default-catalog-path)\n    75\t                      :asset-root (or (System/getenv \"ASSET_ROOT\") default-asset-root)})]\n    76\t    (println \"dao.star cart on port\" (:port site))\n    77\t    (.join (Thread/currentThread))))\n","exit_code":0,"status":"completed"}}
