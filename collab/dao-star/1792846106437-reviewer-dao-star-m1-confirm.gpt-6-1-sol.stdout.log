{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/star/lease.cljc | sed -n '75,420p'\"","aggregated_output":"    75\t  [a]\n    76\t  (get-in a [:holder :grant :dao.lease/lease]))\n    77\t\n    78\t\n    79\t(defn step!\n    80\t  \"One control-flow pass of the holder: drain its own tick cursor for the\n    81\t   newest reading, then observe its grant (before anything else) and any\n    82\t   `:lapsed` record for its lease.  The fact cursor is read only once a reading\n    83\t   exists: a grant published before the holder's first tick stays unread on the\n    84\t   medium until a reading can observe it.  A `gap` on either cursor marks the\n    85\t   agent `:gapped?`: it renews nothing from then on.  Answers the new state.\"\n    86\t  [agent]\n    87\t  (swap!\n    88\t    agent\n    89\t    (fn [a]\n    90\t      (let [t (drain (get-in a [:tick :handle]) (get-in a [:tick :cursor]))\n    91\t            reading (or (some-> (filter #(= :dao.lease/tick (:dao.lease/event %))\n    92\t                                        (:values t))\n    93\t                                last\n    94\t                                :dao.lease/reading)\n    95\t                        (:reading a))\n    96\t            a (-> a\n    97\t                  (assoc :reading reading)\n    98\t                  (assoc-in [:tick :cursor] (:cursor t))\n    99\t                  (update :gapped? #(or % (:gap? t))))]\n   100\t        (if (nil? reading)\n   101\t          a\n   102\t          (let [f (drain (get-in a [:fact :handle]) (get-in a [:fact :cursor]))\n   103\t                a (-> a\n   104\t                      (assoc-in [:fact :cursor] (:cursor f))\n   105\t                      (update :gapped? #(or % (:gap? f))))]\n   106\t            (reduce\n   107\t              (fn [a v]\n   108\t                (cond\n   109\t                  (nil? (get-in a [:holder :grant]))\n   110\t                  (update a :holder lease/observe-grant (get-in a [:fact :source]) v reading)\n   111\t\n   112\t                  (and (= :dao.lease/lapsed (:dao.lease/status v))\n   113\t                       (some? (lease-id a))\n   114\t                       (= (lease-id a) (:dao.lease/lease v)))\n   115\t                  (assoc a :lapsed? true)\n   116\t\n   117\t                  :else a))\n   118\t              a\n   119\t              (:values f))))))))\n   120\t\n   121\t\n   122\t(defn gapped?\n   123\t  \"True once any cursor the agent reads answered `gap`.\"\n   124\t  [agent]\n   125\t  (boolean (:gapped? @agent)))\n   126\t\n   127\t\n   128\t(defn release-pending?\n   129\t  \"True while a release fact is staged and not yet appended with `ok`.\"\n   130\t  [agent]\n   131\t  (some? (:release @agent)))\n   132\t\n   133\t\n   134\t(defn holding?\n   135\t  \"May the control flow act: a grant observed, not stopped, not at its bound,\n   136\t   not lapsed, and no gap seen.\"\n   137\t  [agent]\n   138\t  (let [a @agent]\n   139\t    (boolean (and (not (:lapsed? a))\n   140\t                  (not (:gapped? a))\n   141\t                  (some? (:reading a))\n   142\t                  (lease/holding? (:holder a) (:reading a))))))\n   143\t\n   144\t\n   145\t(defn granted?\n   146\t  [agent]\n   147\t  (some? (get-in @agent [:holder :grant])))\n   148\t\n   149\t\n   150\t(defn past-bound?\n   151\t  \"True once the agent has left the lease for good: it lapsed, was released,\n   152\t   or reached its bound.  A gap is not that: the agent renews nothing after one\n   153\t   but the lease is not known to be over.\"\n   154\t  [agent]\n   155\t  (let [a @agent]\n   156\t    (boolean (or (:lapsed? a)\n   157\t                 (get-in a [:holder :released?])\n   158\t                 (get-in a [:holder :bound-reached?])\n   159\t                 (and (some? (:reading a)) (some? (get-in a [:holder :grant]))\n   160\t                      (lease/at-bound? (:holder a) (:reading a)))))))\n   161\t\n   162\t\n   163\t(defn- append-renewal!\n   164\t  [agent]\n   165\t  (let [a @agent\n   166\t        fact (merge (lease/renewal (lease-id a)) (:envelope a))\n   167\t        outcome (stream/append! (get-in a [:writer :handle]) fact)]\n   168\t    (swap! agent update :holder lease/observe-renewal (:reading a) outcome)\n   169\t    outcome))\n   170\t\n   171\t\n   172\t(defn renew-if-due!\n   173\t  \"Renew when the holder's interval has been reached.  Answers true when a\n   174\t   renewal was appended.\"\n   175\t  [agent]\n   176\t  (let [a @agent]\n   177\t    (boolean\n   178\t      (when (and (holding? agent) (lease/due-to-renew? (:holder a) (:reading a)))\n   179\t        (append-renewal! agent)\n   180\t        true))))\n   181\t\n   182\t\n   183\t(defn renew!\n   184\t  \"Renew now, on a consumed input.  A holder that is not holding renews\n   185\t   nothing.\"\n   186\t  [agent]\n   187\t  (boolean (when (holding? agent) (append-renewal! agent) true)))\n   188\t\n   189\t\n   190\t(defn release!\n   191\t  \"Release on halt.  The release fact is kept until its append answers ok, so a\n   192\t   failed append retries the same fact.\"\n   193\t  [agent]\n   194\t  (let [a @agent]\n   195\t    (when (and (granted? agent) (not (get-in a [:holder :released?])))\n   196\t      (let [{:keys [holder release]} (lease/stop (:holder a))]\n   197\t        (swap! agent assoc :holder holder :release (merge release (:envelope a)))))\n   198\t    (when-let [fact (:release @agent)]\n   199\t      (when (ok? (stream/append! (get-in @agent [:writer :handle]) fact))\n   200\t        (swap! agent assoc :release nil :released-sent? true)))\n   201\t    agent))\n   202\t\n   203\t\n   204\t;; -----------------------------------------------------------------------------\n   205\t;; Grantor side: exchange lease\n   206\t;; -----------------------------------------------------------------------------\n   207\t\n   208\t(def resolver-bindings #{:per-author-media :envelope-key})\n   209\t\n   210\t(def exchange-source :egress)\n   211\t(def lineage-source :session-facts)\n   212\t(def exchange-lease-source :exchange-lease)\n   213\t(def lineage-lease-source :lineage-lease)\n   214\t(def exchange-grantor :boundary-judge)\n   215\t(def lineage-grantor :lineage-judge)\n   216\t\n   217\t\n   218\t(defn resolver\n   219\t  \"The one attribution the star compositions share.  Per-author media: the\n   220\t   source names the author.  Envelope key: the session-facts medium is written\n   221\t   only by session drivers, each stamping `:dao.star/lineage`, and that stamp\n   222\t   names the author.  A fact's own claim of authorship is never consulted.\"\n   223\t  [source fact]\n   224\t  (if (= lineage-source source)\n   225\t    (when-let [s (:dao.star/lineage fact)] {:dao.star/lineage s})\n   226\t    (case source\n   227\t      :egress :egress\n   228\t      :exchange-lease exchange-grantor\n   229\t      :lineage-lease lineage-grantor\n   230\t      nil)))\n   231\t\n   232\t\n   233\t(defn medium-declaration\n   234\t  [capacity attribution]\n   235\t  {:retention :evict-oldest :capacity capacity\n   236\t   :value-domain :portable-values :attribution attribution})\n   237\t\n   238\t\n   239\t(defn facts-declaration\n   240\t  \"The declaration of the session-facts medium: complete history, no capacity.\"\n   241\t  []\n   242\t  {:retention :complete :value-domain :portable-values})\n   243\t\n   244\t\n   245\t(defn check-facts-declaration!\n   246\t  \"Assembly check, on the declaration and not the handle: the session-facts\n   247\t   medium must be declared `:retention :complete`.  Answers the declaration.\"\n   248\t  [decl]\n   249\t  (when-not (and (map? decl) (= :complete (:retention decl)) (not (contains? decl :capacity)))\n   250\t    (throw (ex-info \"the session-facts medium must be declared :retention :complete\"\n   251\t                    {:refused :session-facts :declaration decl})))\n   252\t  decl)\n   253\t\n   254\t\n   255\t(defn make-exchange-lease\n   256\t  \"The grantor half of the exchange lease, composed inside the peer holding the\n   257\t   HTTP boundary.  Config:\n   258\t     :ingress :egress :lease-medium  the three media (handles)\n   259\t     :tick                           the judge's tick stream (handle)\n   260\t     :open-exchanges :close-exchange the boundary's inventory and reclaim\n   261\t     :units :duration :cadence :tolerance\n   262\t     :subscription-max               required duration: the `:dao.lease/max` every\n   263\t                                     subscription exchange's grant carries, the\n   264\t                                     dead-peer bound on a host that reports\n   265\t                                     neither close nor failed write\n   266\t     :capacity                       declared capacity of the egress medium\n   267\t   The judge reads the egress medium for the responders' renewals and writes\n   268\t   grants and `:lapsed` to the lease medium.  Policy ends the lease of an\n   269\t   exchange the inventory no longer holds (peer close, gap reconciliation), and\n   270\t   reclaim is the boundary's idempotent `close-exchange`, reporting success when\n   271\t   the exchange is not open afterwards.\"\n   272\t  [{:keys [ingress egress lease-medium tick open-exchanges close-exchange\n   273\t           units duration cadence tolerance capacity subscription-max]}]\n   274\t  (when-not (lease/duration? subscription-max)\n   275\t    (throw (ex-info \"a subscription exchange needs a :dao.lease/max (:subscription-max, a duration)\"\n   276\t                    {:refused :subscription-cap :subscription-max subscription-max})))\n   277\t  (let [reclaim (fn [subject]\n   278\t                  (let [id (:http/exchange subject)]\n   279\t                    (close-exchange id)\n   280\t                    (not (contains? (open-exchanges) id))))\n   281\t        policy (fn [entry _now]\n   282\t                 (not (contains? (open-exchanges)\n   283\t                                 (:http/exchange (:subject entry)))))\n   284\t        made (lease/make-judge\n   285\t               {:units units :cadence cadence :tolerance tolerance\n   286\t                :resolver resolver :resolver-bindings resolver-bindings\n   287\t                :reclaim reclaim :policy policy\n   288\t                :writer lease-medium :self exchange-grantor\n   289\t                :ticks [{:handle tick :cursor (oldest-cursor tick)}]\n   290\t                :media [{:handle egress :cursor (oldest-cursor egress)\n   291\t                         :source exchange-source\n   292\t                         :medium (medium-declaration capacity :per-author-media)}]})]\n   293\t    (atom {:judge (:judge made) :step (:step made)\n   294\t           :ingress ingress :ingress-cursor (oldest-cursor ingress)\n   295\t           :open-exchanges open-exchanges\n   296\t           :duration duration :subscription-max subscription-max :leased #{}})))\n   297\t\n   298\t\n   299\t(defn- grant-exchange\n   300\t  \"Grant exchange `id` unsolicited.  A subscription (`/s/…`), and any exchange\n   301\t   whose kind is unknown (gap reconciliation), carries the tenure cap.\"\n   302\t  [x id subscription?]\n   303\t  (swap! x (fn [s]\n   304\t             (-> s\n   305\t                 (update :judge lease/author-grant\n   306\t                         (lease/grant (lease/mint-lease-id) {:http/exchange id}\n   307\t                                      :egress (:duration s)\n   308\t                                      (when subscription?\n   309\t                                        {:dao.lease/max (:subscription-max s)})))\n   310\t                 (update :leased conj id))))\n   311\t  x)\n   312\t\n   313\t\n   314\t(defn exchange-lease-step!\n   315\t  \"One pass: observe the ingress for each `:http/request` and grant its\n   316\t   exchange unsolicited; on an ingress gap reconcile against the inventory (an\n   317\t   open exchange without a lease is granted afresh; a leased exchange absent\n   318\t   from the inventory is ended by the judge's policy with cause `:policy`);\n   319\t   then one judge pass.  Answers the atom.\"\n   320\t  [x]\n   321\t  (let [s @x\n   322\t        r (drain (:ingress s) (:ingress-cursor s))\n   323\t        open ((:open-exchanges s))]\n   324\t    (swap! x assoc :ingress-cursor (:cursor r))\n   325\t    (doseq [v (:values r)\n   326\t            :when (= :http/request (:http/event v))\n   327\t            :let [id (:http/exchange v)]\n   328\t            :when (and (contains? open id) (not (contains? (:leased @x) id)))]\n   329\t      (grant-exchange x id (str/starts-with? (str (:http/path v)) \"/s/\")))\n   330\t    (when (:gap? r)\n   331\t      (doseq [id open :when (not (contains? (:leased @x) id))]\n   332\t        (grant-exchange x id true)))\n   333\t    ;; Forget what is closed: its lease is the judge's to end.\n   334\t    (swap! x update :leased #(into #{} (filter open) %))\n   335\t    (swap! x (fn [s] (update s :judge (:step s))))\n   336\t    x))\n   337\t\n   338\t\n   339\t;; -----------------------------------------------------------------------------\n   340\t;; Grantor side: lineage lease\n   341\t;; -----------------------------------------------------------------------------\n   342\t\n   343\t(defn make-lineage-lease\n   344\t  \"The grantor half of the lineage lease.  Config:\n   345\t     :facts          the session-facts medium (handle)\n   346\t     :lease-medium   where grants and `:lapsed` are written (handle)\n   347\t     :tick           the judge's tick stream (handle)\n   348\t     :retire!        (fn [lineage]) retiring the parked record\n   349\t     :units :duration :max :cadence :tolerance\n   350\t     :facts-declaration  the facts medium's declaration, `:retention :complete`\n   351\t   Each root fact read grants unsolicited, subject and holder\n   352\t   `{:dao.star/lineage S}`.  The judge reads the same medium for the drivers'\n   353\t   renewals and releases, attributed by the `:dao.star/lineage` envelope key.\"\n   354\t  [{:keys [lease-medium tick retire! units duration cadence tolerance]\n   355\t    cap :max session-facts :facts declaration :facts-declaration}]\n   356\t  (check-facts-declaration! declaration)\n   357\t  (let [made (lease/make-judge\n   358\t               {:units units :cadence cadence :tolerance tolerance\n   359\t                :resolver resolver :resolver-bindings resolver-bindings\n   360\t                :reclaim (fn [subject]\n   361\t                           (retire! (:dao.star/lineage subject))\n   362\t                           true)\n   363\t                :writer lease-medium :self lineage-grantor\n   364\t                :ticks [{:handle tick :cursor (oldest-cursor tick)}]\n   365\t                :media [{:handle session-facts :cursor (oldest-cursor session-facts)\n   366\t                         :source lineage-source\n   367\t                         :medium (assoc declaration :attribution :envelope-key)}]})]\n   368\t    (atom {:judge (:judge made) :step (:step made)\n   369\t           :facts session-facts :facts-cursor (oldest-cursor session-facts)\n   370\t           :duration duration :max cap})))\n   371\t\n   372\t\n   373\t(defn lineage-lease-step!\n   374\t  \"One pass: grant each newly read root, then one judge pass.\"\n   375\t  [x]\n   376\t  (let [s @x\n   377\t        r (drain (:facts s) (:facts-cursor s))]\n   378\t    (swap! x assoc :facts-cursor (:cursor r))\n   379\t    (doseq [v (:values r)\n   380\t            :when (and (map? v) (= :root (facts/fact-kind v)))\n   381\t            :let [subject {:dao.star/lineage (:dao.star/lineage v)}]]\n   382\t      (swap! x update :judge lease/author-grant\n   383\t             (lease/grant (lease/mint-lease-id) subject subject (:duration s)\n   384\t                          (when (:max s) {:dao.lease/max (:max s)}))))\n   385\t    (swap! x (fn [s] (update s :judge (:step s))))\n   386\t    x))\n","exit_code":0,"status":"completed"}}
