inding bound is per-unit and tighter (see\n  `defective?`).\"\n  [x]\n  (and (map? x)\n       (= 1 (count x))\n       (let [k (first (keys x))]\n         (and (keyword? k)\n              (let [v (get x k)]\n                (and (integer? v)\n                     (pos? v)\n                     (<= v magnitude-limit)))))))\n\n\n(defn tolerance?\n\n\n(defn- reading-ok?\n  \"A reading the holder will act on: a well-shaped duration in a unit the\n  composition's table knows, within the per-unit bound -- the same gate\n  the judge's tick drain applies before letting a reading near any\n  arithmetic. An invalid reading is never an error the holder throws\n  (chosen to mirror the judge's first-tick rule, where no now means the\n  pass performs nothing): every function receiving one observes nothing\n  and answers nothing, so a control flow with no usable tick yet holds\n  nothing, renews nothing and is at no bound, rather than crashing\n  mid-flow.\"\n  [holder reading]\n  (and (duration? reading)\n       (let [k (first (keys reading))\n             v (get reading k)\n             m (get (:units holder) k)]\n         (and (some? m)\n              (<= v (quot magnitude-limit m))))))\n\n\n   268\t(defn- observe-subscriptions!\n   269\t  \"Observe every subscription holder's state against this pass's ticks before\n   270\t   anything is projected to it.  A gap on an exchange holder's cursor is a gap\n   271\t   the session reads: every subscription is forgotten and nothing renews.  A\n   272\t   lapsed holder, or one past its bound, drops its subscription.\"\n   273\t  [driver s]\n   274\t  (doseq [[x a] (get-in @driver [:sessions s :subs])]\n   275\t    (lease/step! a)\n   276\t    (cond\n   277\t      (lease/gapped? a) (forget! driver s)\n   278\t      (or (:lapsed? @a) (lease/past-bound? a))\n   279\t      (update-session! driver s (fn [y] (-> y (update :subs dissoc x) (update :sub-staged disj x)))))))\n   280\t\n   281\t\n   282\t(defn- publish!\n   283\t  \"Append the pending transition's fact; only when it answers `ok` does the new\n   284\t   occurrence become the latest and any UI carrying its id get projected.  The\n   285\t   holder's tenure is rechecked first, fail closed: a holder past its bound or\n   286\t   lapsed drops the staged transition (its exchange is left to lapse and the\n   287\t   requester sees silence); a holder not holding for any other reason (a gap)\n   288\t   keeps it staged and publishes nothing.\"\n   289\t  [driver s]\n   290\t  (let [{:keys [config]} @driver\n   291\t        sess (get-in @driver [:sessions s])\n   292\t        {:keys [successor predecessor model exchange halted?]} (:unpublished sess)\n   293\t        agent (:agent sess)]\n   294\t    (when (and sess (:unpublished sess))\n   295\t      (cond\n   296\t        (lease/past-bound? agent)\n   297\t        (update-session! driver s dissoc :unpublished)\n   298\t\n   299\t        (not (lease/holding? agent)) nil\n   300\t\n   301\t        :else\n   302\t        (let [fact (if halted?\n   303\t                     (facts/ended s :halted)\n   304\t                     (facts/consumption s successor predecessor))]\n   305\t          (when (ok? (stream/append! (:facts config) fact))\n   306\t            (update-session! driver s\n   307\t                             (fn [x] (-> x\n   308\t                                         (dissoc :unpublished)\n   309\t                                         (cond-> (not halted?)\n   310\t                                           (assoc :latest {:occurrence successor :model model})))))\n   311\t            (let [occ (if halted? predecessor successor)]\n   312\t              (answer! config exchange occ model)\n   313\t              (when-not halted?\n   314\t                (observe-subscriptions! driver s)\n   315\t                (patch! config (get-in @driver [:sessions s])))\n   316\t              (if halted?\n   317\t                (lease/release! agent)\n   318\t                (lease/renew! agent