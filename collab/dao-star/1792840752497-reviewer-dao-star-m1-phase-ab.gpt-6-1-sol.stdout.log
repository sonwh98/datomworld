162 docs/design/dao.stream.http.md\n     165 docs/design/dao.star.md\n    1014 docs/design/dao.stream.md\n     318 docs/design/dao.lease.md\n     383 src/cljc/dao/stream/http.cljc\n      85 src/clj/dao/stream/http/jvm.clj\n     368 src/cljc/dao/star/driver.cljc\n     142 src/cljc/dao/star/facts.cljc\n     339 src/cljc/dao/star/lease.cljc\n     133 src/cljc/dao/star/router.cljc\n      55 src/cljc/dao/star/signals.cljc\n     536 test/dao/star/driver_test.clj\n      54 test/dao/star/facts_test.clj\n     199 test/dao/star/loopback_test.clj\n      21 test/dao/star/peer_close_test.clj\n     123 test/dao/star/router_test.clj\n      39 test/dao/star/signals_test.clj\n     373 test/dao/stream/http_test.clj\n    4509 total\n","exit_code":0,"status":"completed"}}
