{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'cat test/dao/star/driver_test.clj'","aggregated_output":"(ns dao.star.driver-test\n  \"dao.star Mode 1 Completion Criteria item 1, in memory: ring buffers for\n   every medium, a fake boundary implementing the inventory, the reclaim and\n   the egress interpretation, and ticks appended by hand -- no clock.  The\n   harness is public so the loopback test composes the same pieces.\"\n  (:require [clojure.string :as str]\n            [clojure.test :refer [deftest is testing]]\n            [dao.await :as await]\n            [dao.lease :as dl]\n            [dao.star.driver :as driver]\n            [dao.star.facts :as facts]\n            [dao.star.lease :as lease]\n            [dao.star.router :as router]\n            [dao.stream :as stream]\n            [dao.stream.ringbuffer :as ring]))\n\n\n(defn medium\n  [capacity]\n  (:dao.stream/handle (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n                                     :dao.stream.ringbuffer/capacity capacity})))\n\n\n(defn values\n  [handle]\n  (:values (lease/drain handle (lease/oldest-cursor handle))))\n\n\n(def counter-program\n  \"A sequential agent: emits {:count 0}, then per input adds the signal `inc`\n   (default 1) and emits the new count.  Pure logic over `in` and `out`.\"\n  (await/go*\n    '[(let [ic (await/cursor in)]\n        (await/>! out (assoc {} :count 0))\n        (do (def lp (fn [n]\n                      (let [x (await/<! ic)\n                            n2 (+ n (get (get x :signals) :inc 1))]\n                        (await/>! out (assoc {} :count n2))\n                        (lp n2))))\n            (lp 0)))]\n    {}))\n\n\n(def one-shot-program\n  (await/go*\n    '[(let [ic (await/cursor in)]\n        (await/>! out (assoc {} :count 0))\n        (let [x (await/<! ic)]\n          (await/>! out (assoc {} :count 99))))]\n    {}))\n\n\n(defn project\n  \"The reference SSE projection: a Datastar-shaped patch carrying the id of\n   the occurrence that rendered it.\"\n  [occurrence model]\n  (str \"event: datastar-patch-elements\\ndata: <div id=\\\"app\\\" data-occ=\\\"\"\n       occurrence \"\\\">\" (:count model) \"</div>\\n\\n\"))\n\n\n(defn begin-page\n  [lineage]\n  (str \"<!doctype html><html><body data-root=\\\"\" lineage \"\\\"></body></html>\"))\n\n\n(defn gated\n  \"A medium whose appends answer `full` while `failing?` holds.\"\n  [handle failing?]\n  (reify\n    stream/IDaoStreamDescriptor\n    (descriptor [_] (stream/descriptor handle))\n    stream/IDaoStreamReader\n    (cursor [_ anchor] (stream/cursor handle anchor))\n    (next [_ cursor] (stream/next handle cursor))\n    stream/IDaoStreamWriter\n    (append! [_ v] (if @failing?\n                     {:dao.stream/outcome :dao.stream/full}\n                     (stream/append! handle v)))\n    stream/IDaoStreamClosable\n    (close! [_] (stream/close! handle))))\n\n\n(def units {:ms 1})\n(def duration {:ms 100})\n\n\n(defn world\n  \"Compose the whole of Mode 1 over in-memory media.  Options: `:program`,\n   `:ingress-capacity`, `:session-capacity`, `:retire?` (default true),\n   `:duration`.  Answers a map of every part.\"\n  ([] (world {}))\n  ([{:keys [program ingress-capacity session-capacity retire? duration-ms facts-capacity]\n     :or {program counter-program ingress-capacity 64 session-capacity 64\n          retire? true duration-ms 100 facts-capacity 256}}]\n   (let [dur {:ms duration-ms}\n         interval (dl/renewal-interval units dur {:ms (quot (* 3 duration-ms) 10)}\n                                       {:ms (quot duration-ms 10)})\n         failing? (atom false)\n         ingress (medium ingress-capacity)\n         egress (medium 256)\n         raw-facts (medium facts-capacity)\n         facts-medium (gated raw-facts failing?)\n         lineage-lease (medium 64)\n         exchange-lease (medium 64)\n         begin (medium 32)\n         ticks {:driver (medium 64) :exchange (medium 64) :lineage (medium 64)}\n         open (atom #{})\n         clock (atom 0)\n         drv (driver/make-driver\n               {:facts facts-medium :egress egress :begin begin\n                :tick (:driver ticks) :lineage-lease lineage-lease\n                :exchange-lease exchange-lease :program program\n                :project-fn project :begin-fn begin-page :units units\n                :lineage-renewal-interval interval\n                :exchange-renewal-interval interval\n                :session-capacity session-capacity :facts-capacity 256})\n         close-exchange (fn [id]\n                          (when (contains? @open id)\n                            (swap! open disj id)\n                            (stream/append! ingress {:http/exchange id\n                                                     :http/event :http/closed})))\n         xl (lease/make-exchange-lease\n              {:ingress ingress :egress egress :lease-medium exchange-lease\n               :tick (:exchange ticks) :open-exchanges (fn [] @open)\n               :close-exchange close-exchange :units units :duration dur\n               :cadence {:ms 10} :tolerance {:ms 0} :capacity 256})\n         ll (lease/make-lineage-lease\n              {:facts raw-facts :lease-medium lineage-lease :tick (:lineage ticks)\n               :retire! (fn [s] (when retire? (driver/retire! drv s)))\n               :units units :duration dur :cadence {:ms 10} :tolerance {:ms 0}\n               :capacity 256})\n         rt (router/make-router\n              {:ingress ingress :facts raw-facts :lease lineage-lease :begin begin\n               :co-located? true\n               :session-medium (fn [s] (driver/session-medium drv s))})\n         w {:ingress ingress :egress egress :facts raw-facts :failing? failing?\n            :lineage-lease lineage-lease :exchange-lease exchange-lease\n            :begin begin :ticks ticks :open open :clock clock :driver drv\n            :xl xl :ll ll :router rt :next-exchange (atom 0)\n            :egress-cursor (atom (lease/oldest-cursor egress))\n            :interval interval}]\n     (assoc w :close-exchange close-exchange))))\n\n\n(defn boundary-step!\n  \"The fake boundary's egress interpretation: an `:http/end` for an open\n   exchange completes it and deposits `:http/ended`.\"\n  [{:keys [egress egress-cursor open ingress]}]\n  (let [r (lease/drain egress @egress-cursor)]\n    (reset! egress-cursor (:cursor r))\n    (doseq [v (:values r)\n            :when (and (= :http/end (:http/effect v)) (contains? @open (:http/exchange v)))]\n      (swap! open disj (:http/exchange v))\n      (stream/append! ingress {:http/exchange (:http/exchange v) :http/event :http/ended}))))\n\n\n(defn pump!\n  \"Every stepped part once, three rounds so each hand-off lands.\"\n  [w]\n  (dotimes [_ 3]\n    (lease/exchange-lease-step! (:xl w))\n    (lease/lineage-lease-step! (:ll w))\n    (router/router-step! (:router w))\n    (driver/driver-step! (:driver w))\n    (boundary-step! w)))\n\n\n(defn advance!\n  \"Move every tick stream forward by `ms` and pump.\"\n  [w ms]\n  (let [now (swap! (:clock w) + ms)]\n    (doseq [t (vals (:ticks w))]\n      (stream/append! t (dl/tick {:ms now})))\n    (pump! w)))\n\n\n(defn start!\n  \"The first tick, so the judges have a *now*.\"\n  [w]\n  (advance! w 10)\n  w)\n\n\n(defn call!\n  \"Deposit one request the way the boundary would; answers the exchange id.\"\n  ([w method path] (call! w method path nil))\n  ([w method path body]\n   (let [id [0 (swap! (:next-exchange w) inc)]]\n     (swap! (:open w) conj id)\n     (stream/append! (:ingress w)\n                     (cond-> {:http/exchange id :http/event :http/request\n                              :http/method method :http/path path :http/headers {}}\n                       body (assoc :http/body (.getBytes ^String body \"UTF-8\"))))\n     id)))\n\n\n(defn effects\n  [w x]\n  (filterv #(= x (:http/exchange %)) (values (:egress w))))\n\n\n(defn sse-text\n  [w x]\n  (apply str (keep :http/body (effects w x))))\n\n\n(defn occ-of\n  [text]\n  (second (re-find #\"data-occ=\\\"([^\\\"]+)\\\"\" text)))\n\n\n(defn begin-lineage!\n  \"GET / and answer the new lineage's id.\"\n  [w]\n  (let [x (call! w :get \"/\")]\n    (pump! w)\n    (let [s (second (re-find #\"data-root=\\\"([^\\\"]+)\\\"\" (sse-text w x)))]\n      (pump! w)\n      s)))\n\n\n(defn input!\n  \"POST /k/<token>; answers the exchange id after pumping.\"\n  ([w token] (input! w token nil))\n  ([w token body]\n   (let [x (call! w :post (str \"/k/\" token) body)]\n     (pump! w)\n     x)))\n\n\n(defn consumption-facts\n  [w]\n  (filterv #(= :consumption (facts/fact-kind %)) (values (:facts w))))\n\n\n;; -----------------------------------------------------------------------------\n;; Clause: a request with no token begins a lineage\n;; -----------------------------------------------------------------------------\n\n(deftest request-with-no-token-begins-a-lineage\n  (let [w (start! (world))\n        x (call! w :get \"/\")]\n    (pump! w)\n    (let [s (second (re-find #\"data-root=\\\"([^\\\"]+)\\\"\" (sse-text w x)))\n          fx (effects w x)]\n      (is (some? s))\n      (is (= [:http/head :http/chunk :http/end] (mapv :http/effect fx)))\n      (is (= \"text/html\" (get-in (first fx) [:http/headers \"content-type\"])))\n      (is (str/starts-with? (sse-text w x) \"<!doctype html>\") \"a complete document\")\n      (is (= [(facts/root s)] (filterv #(= :root (facts/fact-kind %)) (values (:facts w)))))\n      (is (= #{s} (driver/sessions (:driver w))))\n      (is (= {:occurrence s :model {:count 0}} (driver/latest (:driver w) s))))))\n\n\n;; -----------------------------------------------------------------------------\n;; Clause: agent receives input, answers head/chunks/end, parks, resumes\n;; -----------------------------------------------------------------------------\n\n(deftest agent-answers-parks-and-resumes-on-the-next-input\n  (let [w (start! (world))\n        s (begin-lineage! w)\n        x1 (input! w s \"{\\\"inc\\\":5}\")\n        fx1 (effects w x1)\n        o1 (occ-of (sse-text w x1))\n        x2 (input! w o1 \"{\\\"inc\\\":2}\")\n        o2 (occ-of (sse-text w x2))]\n    (is (= [:http/head :http/chunk :http/end] (mapv :http/effect fx1)))\n    (is (= \"text/event-stream\" (get-in (first fx1) [:http/headers \"content-type\"])))\n    (is (str/includes? (sse-text w x1) \">5<\"))\n    (is (str/includes? (sse-text w x2) \">7<\") \"the second answer reflects the first input\")\n    (is (not= s o1))\n    (is (not= o1 o2))\n    (is (= [(facts/consumption s o1 s) (facts/consumption s o2 o1)] (consumption-facts w)))\n    (testing \"the completed exchanges were ended by the boundary\"\n      (is (empty? @(:open w))))))\n\n\n;; -----------------------------------------------------------------------------\n;; Clause: subscribe consumes nothing; re-subscribe after inputs is current\n;; -----------------------------------------------------------------------------\n\n(deftest subscribe-consumes-nothing-and-resubscribe-gets-the-current-projection\n  (let [w (start! (world))\n        s (begin-lineage! w)\n        subscribe! (fn [token]\n                     (let [x (call! w :get (str \"/s/\" token))] (pump! w) x))\n        sub0 (subscribe! s)\n        o1 (occ-of (sse-text w (input! w s)))\n        o2 (occ-of (sse-text w (input! w o1)))\n        o3 (occ-of (sse-text w (input! w o2)))\n        facts-before (count (consumption-facts w))\n        sub1 (subscribe! s)]\n    (is (= 3 facts-before))\n    (is (= facts-before (count (consumption-facts w))) \"a subscribe appends no fact\")\n    (is (= o3 (occ-of (sse-text w sub1))) \"resolved to the current occurrence by the original URL\")\n    (is (str/includes? (sse-text w sub1) \">3<\"))\n    (is (= [:http/head :http/chunk] (mapv :http/effect (effects w sub1)))\n        \"a subscription exchange does not end\")\n    (testing \"the first subscription was patched by every later input\"\n      (is (= [s o1 o2 o3] (mapv occ-of (keep :http/body (filter :http/body (effects w sub0)))))))\n    (is (= #{sub0 sub1} (driver/subscriptions (:driver w) s)))))\n\n\n;; -----------------------------------------------------------------------------\n;; Clause: stale token is re-projected\n;; -----------------------------------------------------------------------------\n\n(deftest stale-token-is-reprojected-and_runs-nothing\n  (let [w (start! (world))\n        s (begin-lineage! w)\n        o1 (occ-of (sse-text w (input! w s \"{\\\"inc\\\":4}\")))\n        facts-before (count (consumption-facts w))\n        stale (input! w s \"{\\\"inc\\\":4}\")]\n    (is (= facts-before (count (consumption-facts w))))\n    (is (= [:http/head :http/chunk :http/end] (mapv :http/effect (effects w stale))))\n    (is (= o1 (occ-of (sse-text w stale))) \"the projection of the current occurrence\")\n    (is (str/includes? (sse-text w stale) \">4<\") \"the continuation did not run again\")))\n\n\n;; -----------------------------------------------------------------------------\n;; Fact before UI\n;; -----------------------------------------------------------------------------\n\n(deftest no-ui-with-the-successor-id-before-its-fact-is-accepted\n  (let [w (start! (world))\n        s (begin-lineage! w)\n        _ (reset! (:failing? w) true)\n        x (input! w s \"{\\\"inc\\\":1}\")]\n    (testing \"the fact append answered non-ok: nothing is projected\"\n      (is (empty? (effects w x)))\n      (is (empty? (consumption-facts w)))\n      (is (= {:occurrence s :model {:count 0}} (driver/latest (:driver w) s))))\n    (reset! (:failing? w) false)\n    (pump! w)\n    (let [[fact] (consumption-facts w)\n          successor (:dao.star/occurrence fact)]\n      (is (some? fact))\n      (is (= successor (occ-of (sse-text w x))))\n      (testing \"the projection came after the accepted fact, not before\"\n        (is (= successor (:occurrence (driver/latest (:driver w) s))))))))\n\n\n;; -----------------------------------------------------------------------------\n;; Liveness: silent exchange, unreturned lineage\n;; -----------------------------------------------------------------------------\n\n(deftest silent-exchange-lapses-and-closes\n  (let [w (start! (world))\n        x (call! w :get \"/unrouted\")]\n    (pump! w)\n    (is (contains? @(:open w) x))\n    (testing \"within the duration nothing happens\"\n      (advance! w 50)\n      (is (contains? @(:open w) x)))\n    (dotimes [_ 8] (advance! w 10))\n    (is (not (contains? @(:open w) x)) \"reclaim closed it\")\n    (is (some #(= {:http/exchange x :http/event :http/closed} %) (values (:ingress w))))\n    (is (some #(and (= :dao.lease/lapsed (:dao.lease/status %))\n                    (= :silence (:dao.lease/cause %)))\n              (values (:exchange-lease w))))))\n\n\n(deftest unreturned-lineage-lapses-record-retired-facts-remain\n  (let [w (start! (world))\n        s (begin-lineage! w)]\n    (is (= #{s} (driver/sessions (:driver w))))\n    (dotimes [_ 14] (advance! w 10))\n    (is (empty? (driver/sessions (:driver w))) \"the parked record is retired\")\n    (is (= [(facts/root s)] (filterv #(= :root (facts/fact-kind %)) (values (:facts w))))\n        \"the facts remain\")\n    (is (some #(= :dao.lease/lapsed (:dao.lease/status %)) (values (:lineage-lease w))))\n    (testing \"a token of the lapsed lineage is answered as begin\"\n      (let [x (input! w s)]\n        (is (= \"text/html\" (get-in (first (effects w x)) [:http/headers \"content-type\"])))))))\n\n\n(deftest a-driver-at-its-bound-consumes-nothing-and-begins-instead\n  (let [w (start! (world))\n        s (begin-lineage! w)]\n    ;; Only the driver's clock moves: its holder reaches the bound while the\n    ;; lineage judge has not yet lapsed the lease, so the router still says input.\n    (stream/append! (get-in w [:ticks :driver]) (dl/tick {:ms 150}))\n    (let [x (input! w s \"{\\\"inc\\\":3}\")]\n      (is (empty? (consumption-facts w)) \"nothing consumed past the bound\")\n      (is (= \"text/html\" (get-in (first (effects w x)) [:http/headers \"content-type\"]))\n          \"handed to the root program as begin\")\n      (is (= 2 (count (driver/sessions (:driver w))))))))\n\n\n(deftest the-program-halting-ends-the-lineage-and-releases\n  (let [w (start! (world {:program one-shot-program}))\n        s (begin-lineage! w)\n        x (input! w s)]\n    (is (str/includes? (sse-text w x) \">99<\"))\n    (is (some #(= (facts/ended s :halted) %) (values (:facts w))))\n    (is (some #(= :dao.lease/released (:dao.lease/status %)) (values (:facts w))))\n    (is (= {:kind :ended :lineage s}\n           (facts/resolve-token (router/index (:router w)) s)))))\n\n\n;; -----------------------------------------------------------------------------\n;; A just-published token is never answered as begin\n;; -----------------------------------------------------------------------------\n\n(defn- chase!\n  \"Post immediately to the token each answer publishes, `n` times.\"\n  [w n]\n  (let [s (begin-lineage! w)]\n    (loop [token s i 1]\n      (if (> i n)\n        token\n        (let [x (input! w token \"{\\\"inc\\\":1}\")\n              text (sse-text w x)]\n          (is (str/includes? text (str \">\" i \"<\")) (str \"input \" i \" was consumed, not begun\"))\n          (recur (occ-of text) (inc i)))))))\n\n\n(deftest just-published-token-is-never-begin\n  (let [w (start! (world))]\n    (chase! w 25)\n    (is (= 25 (count (consumption-facts w))))\n    (is (= 1 (count (driver/sessions (:driver w)))))))\n\n\n(deftest ^:slow just-published-token-is-never-begin-stress\n  (let [w (start! (world {:duration-ms 1000000 :facts-capacity 2048 :session-capacity 1024}))]\n    (chase! w 400)\n    (is (= 400 (count (consumption-facts w))))\n    (is (= 1 (count (driver/sessions (:driver w)))))))\n\n\n;; -----------------------------------------------------------------------------\n;; Ingress gap: reconciliation both ways\n;; -----------------------------------------------------------------------------\n\n(deftest after-an-ingress-gap-no-exchange-unleased-and-no-closed-exchange-leased\n  (let [w (start! (world {:ingress-capacity 3}))\n        ids (vec (for [_ (range 6)] (call! w :get \"/unrouted\")))\n        x (:xl w)]\n    (lease/exchange-lease-step! x)\n    (is (= (set ids) @(:open w)))\n    (is (= (set ids) (:leased @x)) \"every open exchange is leased, the evicted ones afresh\")\n    (let [granted (filter #(= :dao.lease/accepted (:dao.lease/status %)) (values (:exchange-lease w)))]\n      (is (= 6 (count granted))))\n    (testing \"a closed exchange is not leased and its lease is ended by policy\"\n      (swap! (:open w) disj (first ids))\n      (advance! w 10)\n      (is (not (contains? (:leased @x) (first ids))))\n      (is (= [:policy]\n             (mapv :dao.lease/cause\n                   (filter #(= :dao.lease/lapsed (:dao.lease/status %))\n                           (values (:exchange-lease w)))))))))\n\n\n;; -----------------------------------------------------------------------------\n;; The driver stops renewing\n;; -----------------------------------------------------------------------------\n\n(defn- renewals\n  [w]\n  (count (filter #(= :dao.lease/renewal (:dao.lease/event %)) (values (:egress w)))))\n\n\n(defn- subscribed-world\n  [opts]\n  (let [w (start! (world opts))\n        s (begin-lineage! w)\n        sub (call! w :get (str \"/s/\" s))]\n    (pump! w)\n    [w s sub]))\n\n\n(deftest driver-renews-a-subscription-under-half-the-duration\n  (let [[w _ _] (subscribed-world {})]\n    (dotimes [_ 6] (advance! w 10))\n    (is (pos? (renewals w)))))\n\n\n(deftest driver-stops-renewing-after-observing-the-lapse\n  (let [[w s sub] (subscribed-world {:duration-ms 1000})\n        lease-id (some #(when (= {:http/exchange sub} (:dao.lease/subject %))\n                          (:dao.lease/lease %))\n                       (values (:exchange-lease w)))]\n    (dotimes [_ 30] (advance! w 10))\n    (is (pos? (renewals w)) \"renewing while the lease is live\")\n    (stream/append! (:exchange-lease w) (dl/lapsed lease-id :policy))\n    (pump! w)\n    (is (not (contains? (driver/subscriptions (:driver w) s) sub)) \"the exchange is dropped\")\n    (let [before (renewals w)]\n      (dotimes [_ 10] (advance! w 10))\n      (is (= before (renewals w)) \"no renewal appended after the lapse\"))))\n\n\n(deftest driver-stops-renewing-after-its-own-gap\n  (let [[w s _] (subscribed-world {:duration-ms 1000 :session-capacity 2})]\n    (dotimes [_ 30] (advance! w 10))\n    (is (pos? (renewals w)))\n    (dotimes [_ 6]\n      (stream/append! (driver/session-medium (:driver w) s)\n                      {:exchange [9 9] :kind :terminal}))\n    (driver/driver-step! (:driver w))\n    (is (empty? (driver/subscriptions (:driver w) s)) \"subscriptions forgotten\")\n    (let [before (renewals w)]\n      (dotimes [_ 10] (advance! w 10))\n      (is (= before (renewals w)) \"no renewal appended after the gap\"))))\n\n\n;; -----------------------------------------------------------------------------\n;; Renewal in flight counts while live; one after retirement does not revive\n;; -----------------------------------------------------------------------------\n\n(deftest renewal-in-flight-counts-while-live-and-does-not-revive-a-retired-lease\n  (let [w (start! (world))\n        x (call! w :get \"/unrouted\")\n        _ (pump! w)\n        lease-id (some #(when (= {:http/exchange x} (:dao.lease/subject %))\n                          (:dao.lease/lease %))\n                       (values (:exchange-lease w)))\n        ledger #(get-in @(:xl w) [:judge :ledger])\n        lapsed #(count (filter (fn [f] (= :dao.lease/lapsed (:dao.lease/status f)))\n                               (values (:exchange-lease w))))]\n    (is (some? lease-id))\n    (dotimes [_ 9] (advance! w 10))\n    (testing \"a renewal in flight at 90ms of 100 counts\"\n      (stream/append! (:egress w) (dl/renewal lease-id))\n      (dotimes [_ 3] (advance! w 10))\n      (is (contains? (ledger) lease-id) \"still live past the original duration\")\n      (is (zero? (lapsed))))\n    (dotimes [_ 14] (advance! w 10))\n    (is (zero? (count (filter #{lease-id} (keys (ledger))))) \"retired\")\n    (is (= 1 (lapsed)))\n    (testing \"a renewal observed after retirement does not revive it\"\n      (stream/append! (:egress w) (dl/renewal lease-id))\n      (dotimes [_ 3] (advance! w 10))\n      (is (not (contains? (ledger) lease-id)))\n      (is (= 1 (lapsed))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'cat /Users/sto/workspace/datomworld/collab/1792832568086-stream-engineer-dao-star-m1-phase-a.claude-opus-5-5.findings.md /Users/sto/workspace/datomworld/collab/1792833214850-stream-engineer-dao-star-m1-phase-b.claude-opus-5-5.findings.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'cat /Users/sto/workspace/datomworld/collab/1792832568086-stream-engineer-dao-star-m1-phase-a.claude-opus-5-5.findings.md /Users/sto/workspace/datomworld/collab/1792833214850-stream-engineer-dao-star-m1-phase-b.claude-opus-5-5.findings.md'","aggregated_output":"Completed-GMT: 2026-10-24 (clock not read; no precise timestamp available)\nCompleted-Local: 2026-10-24, +07 (clock not read)\n\nPhase A is implemented and its tests pass. I couldn't write the findings report or run `bb test:sub:clj dao.stream`, because both were denied by permissions.\n\n**Files** (all in the `dao-star-m1` worktree, nothing staged or committed):\n- `src/cljc/dao/stream/http.cljc`: the boundary core.\n- `src/clj/dao/stream/http/jvm.clj`: the http-kit listener.\n- `test/dao/stream/http_test.clj`: 11 tests.\n\n**Checks:**\n- `clojure -M:test -n dao.stream.http-test`: 11 tests, 86 assertions, 0 failures, 0 errors.\n- `clojure -M:test -n dao.stream.http-test -r 'dao\\.stream\\..*-test'` ran 504 tests with 3874 assertions and 0 failures. I used it as a stand-in for the `dao.stream` lane. Two ws-project tests were skipped because the Dart peer binary isn't built.\n- `clj -M:kondo --lint` on the three files: 0 errors, 0 warnings.\n- `bb test:sub:clj dao.stream` was not run: `bb` isn't on PATH, and calling the mise shim was refused.\n- The findings report was not written to the main tree's `collab/`, because the write was denied. The contents are summarised below.\n- I wrote the tests and the code in one pass and ran the tests afterwards, so this wasn't strict test-first.\n\n**Decisions to confirm:**\n- **Lifetime key:** The spec's \"lifetime longer than the boundary\" has no key in the ws admission check. I invented `:lifetime :outlives-boundary` and require it.\n- **Incarnation:** `:http/incarnation` comes from config, or defaults to a fresh uuid string.\n- **Stricter than the spec:** I treat a head with a non-integer status, a chunk body that isn't a string or bytes, and an `:http/end` before the head as out of order and close the exchange. The spec names only chunk-before-head and a second head.\n- **Step behaviour:** `egress-step` drains until the egress medium is empty. A writer that keeps appending could keep it running.\n\n**Not covered:**\n- The 400 path (an exception inside `accept!`) is untested.\n- Egress `transport-error` shares the branch with `end`, but only `end` is tested.\n- A peer disconnecting mid-response is covered only with scripted sockets. I rely on http-kit's `send!` returning false on a closed channel.\n- The race where an exchange closes while its request event is still being deposited has no test.\n- I did not run the host-boundary gate (`gate_test`). The cljs and cljd listeners are out of scope.\n- The spec's Deferred list is left unimplemented, as intended.\n\nI can write the report once you grant write access to that `collab/` path.\nCompleted-GMT: 2026-10-24 (clock not read; no precise timestamp available)\nCompleted-Local: 2026-10-24, +07 (clock not read)\n\nPhase B is implemented and its tests pass. The findings write to `collab/` was denied, so the full report is below for you to promote.\n\n## Changed files\nAll in the `dao-star-m1` worktree, nothing staged or committed.\n- `src/cljc/dao/star/`:\n  - `facts.cljc`: fact constructors, `valid-fact?`, `index-step`, `resolve-token`.\n  - `signals.cljc`: `decode`, using `clojure.data.json` on the JVM.\n  - `lease.cljc`: the optional fifth namespace, holding the stream `drain` helper, the holder agent, and the exchange-lease and lineage-lease grantor wrappers.\n  - `router.cljc`: pure `classify` and a stepped router.\n  - `driver.cljc`: per-session `dao.await` VM, begin handler, and the lease logic.\n- `test/dao/star/`: `facts`, `signals`, `router`, `driver` (also the public harness), `loopback` and `peer_close` tests.\n\n## Outcomes\n- **Phase B tests:** `clojure -M:test -n dao.star.facts-test -n dao.star.signals-test -n dao.star.router-test -n dao.star.driver-test -n dao.star.loopback-test -n dao.star.peer-close-test`: 34 tests, 590 assertions, 0 failures, 0 errors. The `^:slow` stress test is included in that count.\n- **Stream lane stand-in:** the same run plus `dao.stream.http-test` and `-r 'dao\\.stream\\..*-test'`: 538 tests, 4464 assertions, 0 failures.\n- **`bb test:sub:clj dao.stream`:** not run, since `bb` was not permitted this session.\n- **kondo:** clean (0 errors, 0 warnings) on all `src/cljc/dao/star`, `test/dao/star` and the Phase A files.\n- **Process:** I wrote the code before the driver tests, not strictly test-first. `facts` and `signals` were verified first, then `router`, then the code and tests for `driver` and `loopback` together.\n\n## Completion Criteria item 1 coverage\n- **Begin without a token:** `request-with-no-token-begins-a-lineage`.\n- **Agent answers, parks, resumes:** `agent-answers-parks-and-resumes-on-the-next-input` in memory, and `agent-receives-answers-and-resumes-over-the-real-boundary` on loopback. The VM is a real `dao.await` continuation, and the driver does all the I/O.\n- **Subscribe consumes nothing:** `subscribe-consumes-nothing-and-resubscribe-gets-the-current-projection`.\n- **Stale token re-projected:** `stale-token-is-reprojected-and_runs-nothing`.\n- **Fact before UI:** `no-ui-with-the-successor-id-before-its-fact-is-accepted`. It uses a gated facts medium, and the driver retries the pending fact until it answers `ok`.\n- **Closed socket:** `a-closed-socket-is-observed-as-http-closed` on loopback, plus `a-peer-close-is-read-as-data-and-drops-the-subscription` in memory. See concern 1 below.\n- **Silent exchange lapses:** `silent-exchange-lapses-and-closes`, driven by hand-appended ticks.\n- **Unreturned lineage lapses:** `unreturned-lineage-lapses-record-retired-facts-remain`.\n- **Bound handling:** `a-driver-at-its-bound-consumes-nothing-and-begins-instead`.\n- **Halt:** `the-program-halting-ends-the-lineage-and-releases`.\n- **Just-published token:** `just-published-token-is-never-begin` (25 chained posts) and a `^:slow` stress variant (400 chained posts).\n- **Ingress gap:** `after-an-ingress-gap-no-exchange-unleased-and-no-closed-exchange-leased`.\n- **Driver stops renewing:** `driver-stops-renewing-after-observing-the-lapse` and `driver-stops-renewing-after-its-own-gap`.\n- **Renewal in flight:** `renewal-in-flight-counts-while-live-and-does-not-revive-a-retired-lease`.\n- **Router:** its order, co-location refusal (`:refused :co-located`), gap and failed-forward behaviour are in `router_test.clj`.\n\n## Concerns and deviations\n1. **http-kit never reports a client-initiated close** of an idle streaming exchange. A minimal repro with no dao code showed no `on-close` after FIN or RST, and 40 further writes all returned true. So Phase A's `peer-closed!` is unreachable by a real client disconnect through the current `jvm.clj`.\n   - The loopback closed-socket test closes from the boundary side with `close-exchange` instead, and asserts that `:http/closed` lands on ingress and the driver drops the subscription.\n   - The in-memory test covers a peer close deposited by a fake boundary.\n   - `close-exchange` ends the chunked response and http-kit keeps the connection alive, so the client sees the chunk terminator, not TCP EOF.\n   - Fixing the real client-close detection needs an owner or Architect decision, since `jvm.clj` is a Phase A file I may not edit.\n2. **Datastar wording:** no `src/` code mentions Datastar or UCF. The `datastar` query-parameter name appears as a literal in `signals.cljc`, because the spec dictates it.\n3. **Programs avoid `loop`/`recur`:** yang.clojure has neither, so the test programs recurse through `(def lp (fn ...))`. A literal map containing a variable is also treated as a constant, so programs build models with `assoc`.\n4. **Reclaim success:** for the exchange lease it reports success when the exchange is no longer open afterwards, not the raw boolean from `close-exchange`. Otherwise an exchange the peer already closed would stall the judge.\n5. **Policy:** the exchange lease's policy ends a lease with cause `:policy` whenever its exchange is absent from the inventory. That covers both peer close and gap reconciliation.\n6. **Noise handling:** routed messages are not validated beyond their `:kind`. Facts and lease records on the facts medium are judged by `valid-fact?` and `index-step`.\n7. **Not covered:**\n   - Roots lost in a session-facts gap get no lineage grant; the spec is silent on this.\n   - Requests to paths other than `/`, `/s/…` and `/k/…` are unrouted and lapse by silence.\n   - cljs and cljd were not run, and the host-boundary gate test was not run.\n   - Mode 2 and Datastar-specific behaviour are out of scope.\n8. **Router co-location check:** it uses a `ReflectionHandle` instance check on the JVM and otherwise relies on the declared `:co-located? true`.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'cat test/dao/stream/http_test.clj test/dao/star/router_test.clj test/dao/star/loopback_test.clj test/dao/star/peer_close_test.clj'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'cat test/dao/stream/http_test.clj test/dao/star/router_test.clj test/dao/star/loopback_test.clj test/dao/star/peer_close_test.clj'","aggregated_output":"(ns dao.stream.http-test\n  \"The DaoStream HTTP boundary: core state machine against scripted sockets,\n   plus one real loopback round trip through the http-kit listener.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.stream.http :as http]\n            [dao.stream.http.jvm :as jvm]\n            [dao.stream.ringbuffer :as ring])\n  (:import [java.net URI]\n           [java.net.http HttpClient HttpRequest HttpRequest$BodyPublishers\n            HttpResponse$BodyHandlers]))\n\n\n(defn- medium\n  [capacity]\n  (:dao.stream/handle\n    (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n                   :dao.stream.ringbuffer/capacity capacity})))\n\n\n(def ^:private admission\n  {:retention :evict-oldest :capacity 8 :value-domain :portable-values\n   :lifetime :outlives-boundary})\n\n\n(defn- boundary\n  ([] (boundary {}))\n  ([{:keys [ingress egress open body inc] :or {open 4 body 16}}]\n   (let [ingress (or ingress (medium 16))\n         egress (or egress (medium 16))]\n     {:ingress ingress\n      :egress egress\n      :b (http/make-boundary\n           (cond-> {:ingress {:dao.stream/handle ingress :dao.stream/surface #{:writer}}\n                    :ingress-admission admission\n                    :egress {:dao.stream/handle egress :dao.stream/surface #{:reader}}\n                    :http/max-open open\n                    :http/max-body-bytes body}\n             inc (assoc :http/incarnation inc)))})))\n\n\n(defn- scripted\n  \"A socket seam recording its calls into `trace`; `fail` names the call that\n   fails.\"\n  ([trace] (scripted trace nil))\n  ([trace fail]\n   (letfn [(rec [k] (fn [& args]\n                      (swap! trace conj (into [k] args))\n                      (not= k fail)))]\n     {:head! (rec :head) :write! (rec :write) :end! (rec :end) :close! (rec :close)})))\n\n\n(defn- drain\n  \"Every value currently readable from `handle`.\"\n  [handle]\n  (loop [c (:dao.stream/cursor (stream/cursor handle :dao.stream/oldest)) out []]\n    (let [r (stream/next handle c)]\n      (if (= :dao.stream/ok (:dao.stream/outcome r))\n        (recur (:dao.stream/cursor r) (conj out (:dao.stream/value r)))\n        out))))\n\n\n(defn- req\n  ([] (req {}))\n  ([m] (merge {:method :POST :path \"/action\" :query \"a=1\"\n               :headers {\"Accept\" \"text/event-stream\"} :body (.getBytes \"{}\")}\n              m)))\n\n\n(defn- open!\n  \"Accept a request on a scripted socket; [id trace].\"\n  ([b] (open! b (req)))\n  ([b r]\n   (let [trace (atom [])\n         res (http/accept! b r (scripted trace))]\n     [(:http/exchange res) trace res])))\n\n\n(defn- third [[_ _ x]] x)\n\n\n(defn- effect!\n  [{:keys [b egress]} e]\n  (stream/append! egress e)\n  (http/egress-step b))\n\n\n(defn- events\n  [ingress id]\n  (filterv #(= id (:http/exchange %)) (drain ingress)))\n\n\n(defn- terminal-events\n  [ingress id]\n  (filterv #(#{:http/ended :http/closed} (:http/event %)) (events ingress id)))\n\n\n(deftest assembly\n  (testing \"a reject-mode or malformed composition is refused at assembly\"\n    (let [i (medium 4) e (medium 4)\n          good {:ingress {:dao.stream/handle i :dao.stream/surface #{:writer}}\n                :ingress-admission admission\n                :egress {:dao.stream/handle e :dao.stream/surface #{:reader}}\n                :http/max-open 1 :http/max-body-bytes 1}]\n      (is (some? (http/make-boundary good)))\n      (is (thrown? Exception (http/make-boundary\n                               (assoc good :ingress-admission (assoc admission :retention :reject)))))\n      (is (thrown? Exception (http/make-boundary\n                               (assoc good :ingress-admission (assoc admission :value-domain :host-values)))))\n      (is (thrown? Exception (http/make-boundary\n                               (assoc good :ingress-admission (dissoc admission :lifetime)))))\n      (is (thrown? Exception (http/make-boundary (dissoc good :http/max-open))))\n      (is (thrown? Exception (http/make-boundary (assoc good :http/max-body-bytes 0)))))))\n\n\n(deftest request-event-shape\n  (let [{:keys [b ingress]} (boundary)\n        [id _ res] (open! b)]\n    (is (= :http/accepted (:http/status res)))\n    (let [[ev] (events ingress id)]\n      (is (= :http/request (:http/event ev)))\n      (is (= :post (:http/method ev)))\n      (is (= \"/action\" (:http/path ev)))\n      (is (= \"a=1\" (:http/query ev)))\n      (is (= {\"accept\" \"text/event-stream\"} (:http/headers ev)))\n      (is (bytes? (:http/body ev)))\n      (is (vector? (:http/exchange ev))))\n    (testing \"query and body absent when none\"\n      (let [[id2] (open! b (req {:query nil :body nil}))\n            [ev2] (events ingress id2)]\n        (is (not (contains? ev2 :http/query)))\n        (is (not (contains? ev2 :http/body)))))\n    (testing \"an empty query and body are none\"\n      (let [[id3] (open! b (req {:query \"\" :body (byte-array 0)}))\n            [ev3] (events ingress id3)]\n        (is (not (contains? ev3 :http/query)))\n        (is (not (contains? ev3 :http/body)))))))\n\n\n(deftest admission-limits\n  (testing \"over :http/max-open answered below the transform, never deposited\"\n    (let [{:keys [b ingress]} (boundary {:open 1})\n          [id] (open! b)\n          [id2 _ res] (open! b)]\n      (is (some? id))\n      (is (nil? id2))\n      (is (= :http/full (:http/status res)))\n      (is (= 1 (count (filter #(= :http/request (:http/event %)) (drain ingress)))))\n      (testing \"a slot returns when the exchange ends\"\n        (http/close-exchange b id)\n        (is (= :http/accepted (:http/status (third (open! b))))))))\n  (testing \"over :http/max-body-bytes answered below the transform\"\n    (let [{:keys [b ingress]} (boundary {:body 4})\n          [id _ res] (open! b (req {:body (byte-array 5)}))]\n      (is (nil? id))\n      (is (= :http/too-large (:http/status res)))\n      (is (empty? (drain ingress)))\n      (is (= :http/accepted (:http/status (third (open! b (req {:body (byte-array 4)})))))))))\n\n\n(deftest evict-oldest-capacity\n  (let [{:keys [b ingress]} (boundary {:ingress (medium 2) :open 10})]\n    (dotimes [_ 3] (open! b))\n    (is (= 2 (count (drain ingress))) \"oldest evicted, deposit still admitted\")\n    (is (= 3 (count (http/open-exchanges b))))))\n\n\n(deftest exchange-ids\n  (let [{:keys [b]} (boundary {:inc 7 :open 10})\n        [a] (open! b) [c] (open! b)]\n    (is (= [7 1] a))\n    (is (= [7 2] c))\n    (http/close-exchange b a)\n    (let [[d] (open! b)]\n      (is (= [7 3] d) \"never reused after close\")))\n  (testing \"incarnation distinguishes a restarted boundary\"\n    (let [egress (medium 16)\n          {b1 :b} (boundary {:egress egress})\n          {b2 :b} (boundary {:egress egress})\n          [id1] (open! b1)\n          [id2] (open! b2)]\n      (is (not= id1 id2))\n      (stream/append! egress {:http/exchange id1 :http/effect :http/head :http/status 200})\n      (http/egress-step b2)\n      (is (= #{id2} (http/open-exchanges b2)))\n      (is (= :new (get-in @(:state b2) [:open id2 :phase])) \"stale effect never matches\"))))\n\n\n(deftest terminal-rule\n  (testing \"peer close\"\n    (let [{:keys [b ingress]} (boundary)\n          [id] (open! b)]\n      (http/peer-closed! b id)\n      (http/peer-closed! b id)\n      (is (= [:http/request :http/closed] (mapv :http/event (events ingress id))))))\n  (testing \"write failure\"\n    (let [{:keys [b ingress egress] :as bd} (boundary)\n          trace (atom [])\n          id (:http/exchange (http/accept! b (req) (scripted trace :head)))]\n      (effect! bd {:http/exchange id :http/effect :http/head :http/status 200})\n      (is (= [:http/request :http/closed] (mapv :http/event (events ingress id))))\n      (is (empty? (http/open-exchanges b)))\n      (is (some #{[:close]} @trace))\n      (is egress)))\n  (testing \"out-of-order effect\"\n    (let [{:keys [b ingress] :as bd} (boundary)\n          [id trace] (open! b)]\n      (effect! bd {:http/exchange id :http/effect :http/chunk :http/body \"x\"})\n      (is (= [:http/request :http/closed] (mapv :http/event (events ingress id))))\n      (is (some #{[:close]} @trace))))\n  (testing \"close-exchange is idempotent\"\n    (let [{:keys [b ingress]} (boundary)\n          [id] (open! b)]\n      (is (true? (http/close-exchange b id)))\n      (is (false? (http/close-exchange b id)))\n      (is (false? (http/close-exchange b [:nope 1])))\n      (is (= 1 (count (terminal-events ingress id))))))\n  (testing \"boundary stop\"\n    (let [{:keys [b ingress]} (boundary)\n          [a] (open! b) [c] (open! b)\n          stopped (atom 0)]\n      (http/on-stop! b #(swap! stopped inc))\n      (http/stop! b)\n      (http/stop! b)\n      (is (= [:http/closed] (mapv :http/event (terminal-events ingress a))))\n      (is (= [:http/closed] (mapv :http/event (terminal-events ingress c))))\n      (is (= :http/stopped (:http/status (third (open! b)))))\n      (is (pos? @stopped)))))\n\n\n(deftest effects\n  (let [{:keys [b ingress] :as bd} (boundary)\n        [id trace] (open! b)]\n    (effect! bd {:http/exchange id :http/effect :http/head :http/status 200\n                 :http/headers {\"content-type\" \"text/plain\"}})\n    (effect! bd {:http/exchange id :http/effect :http/chunk :http/body \"héllo\"})\n    (effect! bd {:http/exchange id :http/effect :http/chunk :http/body (.getBytes \"b\")})\n    (is (= #{id} (http/open-exchanges b)))\n    (effect! bd {:http/exchange id :http/effect :http/end})\n    (is (= [:head 200 {\"content-type\" \"text/plain\"}] (first @trace)))\n    (is (= \"héllo\" (second (second @trace))))\n    (is (= [:end] (last @trace)))\n    (is (= [:http/request :http/ended] (mapv :http/event (events ingress id))))\n    (is (empty? (http/open-exchanges b)))\n    (testing \"values after the end, or for unknown exchanges, are ignored\"\n      (let [n (count @trace)]\n        (effect! bd {:http/exchange id :http/effect :http/chunk :http/body \"late\"})\n        (effect! bd {:http/exchange [9 9] :http/effect :http/end})\n        (effect! bd {:something :else})\n        (effect! bd 42)\n        (is (= n (count @trace)))\n        (is (= 1 (count (terminal-events ingress id))))))))\n\n\n(deftest head-order\n  (testing \"a second head closes the exchange\"\n    (let [{:keys [b ingress] :as bd} (boundary)\n          [id] (open! b)]\n      (effect! bd {:http/exchange id :http/effect :http/head :http/status 200})\n      (effect! bd {:http/exchange id :http/effect :http/head :http/status 200})\n      (is (= :http/closed (:http/event (last (events ingress id)))))))\n  (testing \"end before head closes the exchange\"\n    (let [{:keys [b ingress] :as bd} (boundary)\n          [id] (open! b)]\n      (effect! bd {:http/exchange id :http/effect :http/end})\n      (is (= :http/closed (:http/event (last (events ingress id))))))))\n\n\n(deftest egress-lifecycle\n  (testing \"effects retained before the cursor are not performed\"\n    (let [egress (medium 16)\n          _ (stream/append! egress {:http/exchange [1 1] :http/effect :http/end})\n          {:keys [b]} (boundary {:egress egress})]\n      (http/egress-step b)\n      (is (empty? (http/open-exchanges b)))))\n  (testing \"an egress gap closes every open exchange and adopts the recovery cursor\"\n    (let [{:keys [b ingress egress] :as bd} (boundary {:egress (medium 2)})\n          [a] (open! b) [c] (open! b)]\n      (dotimes [_ 5] (stream/append! egress {:other true}))\n      (http/egress-step b)\n      (is (empty? (http/open-exchanges b)))\n      (is (= :http/closed (:http/event (last (events ingress a)))))\n      (is (= :http/closed (:http/event (last (events ingress c)))))\n      (let [[d] (open! b)]\n        (effect! bd {:http/exchange d :http/effect :http/head :http/status 200})\n        (is (= :streaming (get-in @(:state b) [:open d :phase]))))))\n  (testing \"egress end closes every open exchange and the listener\"\n    (let [{:keys [b ingress egress]} (boundary)\n          [a] (open! b)\n          stopped (atom 0)]\n      (http/on-stop! b #(swap! stopped inc))\n      (stream/close! egress)\n      (http/egress-step b)\n      (is (= :http/closed (:http/event (last (events ingress a)))))\n      (is (= 1 @stopped)))))\n\n\n(deftest observably-gone\n  (testing \"a non-ok ingress deposit closes the socket with no response\"\n    (let [full (medium 1)\n          closed (do (stream/close! full) full)\n          {:keys [b]} (boundary {:ingress closed})\n          [id trace res] (open! b)]\n      (is (= :http/gone (:http/status res)))\n      (is (some? id))\n      (is (= [[:close]] @trace))\n      (is (empty? (http/open-exchanges b)))))\n  (testing \"the reclaim procedure deposits the terminal event\"\n    (let [{:keys [b ingress]} (boundary)\n          [id trace] (open! b)]\n      (is (= #{id} (http/open-exchanges b)))\n      (http/close-exchange b id)\n      (is (= [[:close]] @trace))\n      (is (= :http/closed (:http/event (last (events ingress id))))))))\n\n\n;; -----------------------------------------------------------------------------\n;; Loopback\n;; -----------------------------------------------------------------------------\n\n(defn- wait-for\n  \"Poll `f` up to `ms` milliseconds for a truthy value.\"\n  [ms f]\n  (let [deadline (+ (System/currentTimeMillis) ms)]\n    (loop []\n      (or (f)\n          (when (< (System/currentTimeMillis) deadline)\n            (Thread/sleep 10)\n            (recur))))))\n\n\n(deftest loopback-round-trip\n  (let [{:keys [b ingress egress]} (boundary {:body 1024})\n        {:http.jvm/keys [port] :as listener} (jvm/listen! b {:bind-host \"127.0.0.1\" :bind-port 0})\n        client (HttpClient/newHttpClient)\n        uri (URI/create (str \"http://127.0.0.1:\" port \"/action?a=1\"))\n        request (-> (HttpRequest/newBuilder uri)\n                    (.header \"Accept\" \"text/event-stream\")\n                    (.POST (HttpRequest$BodyPublishers/ofString \"{\\\"count\\\":1}\"))\n                    (.build))\n        response (.sendAsync client request (HttpResponse$BodyHandlers/ofString))]\n    (try\n      (let [ev (wait-for 3000 #(first (drain ingress)))]\n        (is (= :http/request (:http/event ev)))\n        (is (= :post (:http/method ev)))\n        (is (= \"/action\" (:http/path ev)))\n        (is (= \"a=1\" (:http/query ev)))\n        (is (= \"text/event-stream\" (get-in ev [:http/headers \"accept\"])))\n        (is (= \"{\\\"count\\\":1}\" (String. ^bytes (:http/body ev) \"UTF-8\")))\n        (let [id (:http/exchange ev)]\n          (stream/append! egress {:http/exchange id :http/effect :http/head\n                                  :http/status 201 :http/headers {\"content-type\" \"text/plain\"}})\n          (stream/append! egress {:http/exchange id :http/effect :http/chunk :http/body \"héllo \"})\n          (stream/append! egress {:http/exchange id :http/effect :http/chunk\n                                  :http/body (.getBytes \"world\" \"UTF-8\")})\n          (stream/append! egress {:http/exchange id :http/effect :http/end})\n          (http/egress-step b)\n          (let [resp (.get response 3 java.util.concurrent.TimeUnit/SECONDS)]\n            (is (= 201 (.statusCode resp)))\n            (is (= \"héllo world\" (.body resp))))\n          (is (wait-for 3000 #(= :http/ended (:http/event (last (events ingress id))))))\n          (is (= 1 (count (terminal-events ingress id))))))\n      (testing \"an over-limit body is answered 413 and not deposited\"\n        (let [before (count (drain ingress))\n              big (-> (HttpRequest/newBuilder uri)\n                      (.POST (HttpRequest$BodyPublishers/ofByteArray (byte-array 4096)))\n                      (.build))\n              resp (.send client big (HttpResponse$BodyHandlers/ofString))]\n          (is (= 413 (.statusCode resp)))\n          (is (= before (count (drain ingress))))))\n      (finally\n        (http/stop! b)\n        (jvm/stop-listening! listener)))))\n(ns dao.star.router-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.star.facts :as facts]\n            [dao.star.lease :as lease]\n            [dao.star.router :as router]\n            [dao.stream :as stream]\n            [dao.stream.ringbuffer :as ring]))\n\n\n(defn- medium\n  [capacity]\n  (:dao.stream/handle (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n                                     :dao.stream.ringbuffer/capacity capacity})))\n\n\n(defn- values\n  [handle]\n  (:values (lease/drain handle (lease/oldest-cursor handle))))\n\n\n(defn- request\n  [x path]\n  {:http/exchange x :http/event :http/request :http/method :post :http/path path})\n\n\n(defn- setup\n  ([] (setup {}))\n  ([{:keys [ingress-capacity] :or {ingress-capacity 16}}]\n   (let [m {:ingress (medium ingress-capacity) :facts (medium 16) :lease (medium 16)\n            :begin (medium 16) :session (medium 16)}]\n     (assoc m :router (router/make-router\n                        {:ingress (:ingress m) :facts (:facts m) :lease (:lease m)\n                         :begin (:begin m) :co-located? true\n                         :session-medium (fn [s] (when (= s \"s\") (:session m)))})))))\n\n\n(deftest classification-table\n  (let [index (reduce facts/index-step facts/empty-index\n                      [(facts/root \"s\") (facts/consumption \"s\" \"o2\" \"s\")\n                       (facts/root \"h\") (facts/ended \"h\" :halted)])]\n    (doseq [[path kind] [[\"/\" :begin] [\"/s/o2\" :subscribe] [\"/s/s\" :subscribe]\n                         [\"/k/o2\" :input] [\"/k/s\" :stale] [\"/k/h\" :begin]\n                         [\"/s/h\" :begin] [\"/k/zzz\" :begin] [\"/s/zzz\" :begin]\n                         [\"/other\" :unrouted] [\"/k/\" :unrouted]]]\n      (is (= kind (:kind (router/classify index path))) path))))\n\n\n(deftest co-location-is-asserted-at-assembly\n  (let [{:keys [ingress facts lease begin]} (setup)\n        refused (fn [config]\n                  (try (router/make-router config) :assembled\n                       (catch clojure.lang.ExceptionInfo e (:refused (ex-data e)))))\n        base {:ingress ingress :facts facts :lease lease :begin begin\n              :session-medium (constantly nil)}]\n    (is (= :co-located (refused base)))\n    (is (= :co-located (refused (assoc base :co-located? false))))\n    (is (= :assembled (refused (assoc base :co-located? true))))))\n\n\n(deftest facts-and-leases-drain-before-classification\n  (testing \"a request naming a token whose fact is on the medium is an input, not a begin\"\n    (let [{:keys [ingress facts begin session router]} (setup)]\n      (stream/append! facts (facts/root \"s\"))\n      (stream/append! ingress (request [1 1] \"/k/s\"))\n      (router/router-step! router)\n      (is (empty? (values begin)))\n      (is (= :input (:kind (first (values session))))))))\n\n\n(deftest unknown-is-judged-after-both-drains\n  (let [{:keys [ingress facts lease begin session router]} (setup)]\n    (testing \"an unknown token is begin\"\n      (stream/append! ingress (request [1 1] \"/k/zzz\"))\n      (router/router-step! router)\n      (is (= 1 (count (values begin)))))\n    (testing \"a lineage lapsed on the lease medium is begin\"\n      (stream/append! facts (facts/root \"s\"))\n      (stream/append! lease {:dao.lease/status :dao.lease/accepted :dao.lease/lease \"L\"\n                             :dao.lease/subject {:dao.star/lineage \"s\"}\n                             :dao.lease/holder {:dao.star/lineage \"s\"}\n                             :dao.lease/duration {:ms 1}})\n      (stream/append! lease {:dao.lease/status :dao.lease/lapsed :dao.lease/lease \"L\"\n                             :dao.lease/cause :silence})\n      (stream/append! ingress (request [1 2] \"/k/s\"))\n      (router/router-step! router)\n      (is (= 2 (count (values begin))))\n      (is (empty? (values session))))))\n\n\n(deftest terminal-events-follow-their-exchange\n  (let [{:keys [ingress facts session router]} (setup)]\n    (stream/append! facts (facts/root \"s\"))\n    (stream/append! ingress (request [1 1] \"/s/s\"))\n    (stream/append! ingress {:http/exchange [1 1] :http/event :http/closed})\n    (stream/append! ingress {:http/exchange [9 9] :http/event :http/closed})\n    (router/router-step! router)\n    (is (= [:subscribe :terminal] (mapv :kind (values session))))\n    (testing \"a terminal event for an unrouted exchange is ignored\"\n      (is (= 2 (count (values session)))))))\n\n\n(deftest a-gap-forwards-nothing-about-itself\n  (let [{:keys [ingress facts session router]} (setup {:ingress-capacity 2})]\n    (stream/append! facts (facts/root \"s\"))\n    (dotimes [i 5] (stream/append! ingress (request [1 i] \"/k/s\")))\n    (router/router-step! router)\n    (is (= 1 (:gaps @router)))\n    (is (= 2 (count (values session))) \"only the retained window is routed\")))\n\n\n(deftest a-failed-forward-is-dropped-silently\n  (let [full (reify\n               stream/IDaoStreamWriter\n               (append! [_ _] {:dao.stream/outcome :dao.stream/full}))\n        ingress (medium 8) facts (medium 8)\n        r (router/make-router {:ingress ingress :facts facts :lease (medium 8)\n                               :begin (medium 8) :co-located? true\n                               :session-medium (constantly full)})]\n    (stream/append! facts (facts/root \"s\"))\n    (stream/append! ingress (request [1 1] \"/k/s\"))\n    (stream/append! ingress {:http/exchange [1 1] :http/event :http/closed})\n    (router/router-step! r)\n    (is (empty? (:routes @r)) \"an unrouted request leaves no route\")))\n(ns dao.star.loopback-test\n  \"Mode 1 over the real Phase A boundary on loopback sockets: an agent\n   receives, answers and resumes end to end, and a closed socket is observed\n   as `:http/closed`.  A raw socket client stands in for Datastar.  One pump\n   thread drives every stepped part, with the tick stream fed by a counter, so\n   no real clock reaches a lease.\"\n  (:require [clojure.string :as str]\n            [clojure.test :refer [deftest is]]\n            [dao.lease :as dl]\n            [dao.star.driver :as driver]\n            [dao.star.driver-test :as h]\n            [dao.star.lease :as lease]\n            [dao.star.router :as router]\n            [dao.stream :as stream]\n            [dao.stream.http :as http]\n            [dao.stream.http.jvm :as jvm])\n  (:import [java.io ByteArrayOutputStream]\n           [java.net Socket]))\n\n\n(def ^:private duration-ms 100000)\n\n\n(defn- compose\n  \"Boundary, listener, leases, router and driver over real media; answers the\n   parts plus a `:stop!`.\"\n  []\n  (let [ingress (h/medium 256)\n        egress (h/medium 1024)\n        facts (h/medium 1024)\n        lineage-lease (h/medium 64)\n        exchange-lease (h/medium 64)\n        begin (h/medium 32)\n        ticks {:driver (h/medium 1024) :exchange (h/medium 1024) :lineage (h/medium 1024)}\n        boundary (http/make-boundary\n                   {:ingress {:dao.stream/handle ingress :dao.stream/surface #{:writer}}\n                    :ingress-admission {:retention :evict-oldest :capacity 256\n                                        :value-domain :portable-values\n                                        :lifetime :outlives-boundary}\n                    :egress {:dao.stream/handle egress :dao.stream/surface #{:reader}}\n                    :http/max-open 16 :http/max-body-bytes 4096})\n        listener (jvm/listen! boundary {:bind-host \"127.0.0.1\" :bind-port 0})\n        interval (dl/renewal-interval h/units {:ms duration-ms} {:ms 30000} {:ms 1})\n        drv (driver/make-driver\n              {:facts facts :egress egress :begin begin :tick (:driver ticks)\n               :lineage-lease lineage-lease :exchange-lease exchange-lease\n               :program h/counter-program :project-fn h/project :begin-fn h/begin-page\n               :units h/units :lineage-renewal-interval interval\n               :exchange-renewal-interval interval\n               :session-capacity 64 :facts-capacity 1024})\n        xl (lease/make-exchange-lease\n             {:ingress ingress :egress egress :lease-medium exchange-lease\n              :tick (:exchange ticks)\n              :open-exchanges #(http/open-exchanges boundary)\n              :close-exchange #(http/close-exchange boundary %)\n              :units h/units :duration {:ms duration-ms} :cadence {:ms 10}\n              :tolerance {:ms 0} :capacity 1024})\n        ll (lease/make-lineage-lease\n             {:facts facts :lease-medium lineage-lease :tick (:lineage ticks)\n              :retire! #(driver/retire! drv %) :units h/units\n              :duration {:ms duration-ms} :cadence {:ms 10} :tolerance {:ms 0}\n              :capacity 1024})\n        rt (router/make-router\n             {:ingress ingress :facts facts :lease lineage-lease :begin begin\n              :co-located? true :session-medium #(driver/session-medium drv %)})\n        running (atom true)\n        clock (atom 0)\n        pump (doto (Thread.\n                     (fn []\n                       (while @running\n                         (let [now (swap! clock inc)]\n                           (doseq [t (vals ticks)]\n                             (stream/append! t (dl/tick {:ms now}))))\n                         (try\n                           (lease/exchange-lease-step! xl)\n                           (lease/lineage-lease-step! ll)\n                           (router/router-step! rt)\n                           (driver/driver-step! drv)\n                           (http/egress-step boundary)\n                           (catch Throwable t (println \"PUMP\" t)))\n                         (Thread/sleep 2))))\n               (.setDaemon true)\n               (.start))]\n    {:ingress ingress :egress egress :drv drv :port (:http.jvm/port listener) :boundary boundary\n     :stop! (fn []\n              (reset! running false)\n              (.join ^Thread pump 2000)\n              (http/stop! boundary)\n              (jvm/stop-listening! listener))}))\n\n\n(defn- read-all\n  [^Socket s]\n  (let [out (ByteArrayOutputStream.)\n        buf (byte-array 4096)]\n    (try\n      (loop []\n        (let [n (.read (.getInputStream s) buf)]\n          (when (pos? n)\n            (.write out buf 0 n)\n            (recur))))\n      (catch java.net.SocketTimeoutException _ nil))\n    (String. (.toByteArray out) \"UTF-8\")))\n\n\n(defn- send-request\n  [^Socket s method path body keep-alive?]\n  (let [bs (.getBytes ^String (or body \"\") \"UTF-8\")\n        head (str method \" \" path \" HTTP/1.1\\r\\nHost: localhost\\r\\n\"\n                  (when body (str \"Content-Length: \" (count bs) \"\\r\\n\"))\n                  (if keep-alive? \"\\r\\n\" \"Connection: close\\r\\n\\r\\n\"))]\n    (doto (.getOutputStream s)\n      (.write (.getBytes head \"UTF-8\"))\n      (.write bs)\n      (.flush))))\n\n\n(defn- roundtrip\n  \"One request on its own connection; the whole response up to the close.\"\n  [port method path body]\n  (with-open [s (doto (Socket. \"127.0.0.1\" (int port)) (.setSoTimeout 5000))]\n    (send-request s method path body false)\n    (read-all s)))\n\n\n(defn- wait-for\n  [ms f]\n  (let [deadline (+ (System/currentTimeMillis) ms)]\n    (loop []\n      (or (f)\n          (when (< (System/currentTimeMillis) deadline)\n            (Thread/sleep 10)\n            (recur))))))\n\n\n(deftest a-closed-socket-is-observed-as-http-closed\n  ;; http-kit never reports a client-initiated close of an idle streaming\n  ;; exchange (reproduced without any dao code: no on-close after FIN or RST\n  ;; and further writes), so the socket here is closed from the boundary's side\n  ;; by the reclaim procedure, and the test asserts what the composition then\n  ;; observes: the client sees EOF, the ingress carries :http/closed for that\n  ;; exchange, and the driver reads it as data and drops the exchange.\n  (let [{:keys [port ingress boundary drv stop!]} (compose)]\n    (try\n      (let [page (roundtrip port \"GET\" \"/\" nil)\n            s (second (re-find #\"data-root=\\\"([^\\\"]+)\\\"\" page))]\n        (with-open [sock (doto (Socket. \"127.0.0.1\" (int port)) (.setSoTimeout 5000))]\n          (send-request sock \"GET\" (str \"/s/\" s) nil true)\n          (let [in (.getInputStream sock)\n                buf (byte-array 4096)\n                seen (StringBuilder.)]\n            (is (wait-for 5000\n                          #(do (when (pos? (.available in))\n                                 (let [n (.read in buf)]\n                                   (.append seen (String. buf 0 n \"UTF-8\"))))\n                               (str/includes? (str seen) \"data-occ\"))))\n            (let [id (:http/exchange\n                       (wait-for 3000\n                                 #(first (filter (fn [e] (and (= :http/request (:http/event e))\n                                                              (= (str \"/s/\" s) (:http/path e))))\n                                                 (h/values ingress)))))]\n              (is (some? id))\n              (is (contains? (driver/subscriptions drv s) id))\n              (is (true? (http/close-exchange boundary id)))\n              (is (wait-for 3000\n                            #(some (fn [e] (and (= id (:http/exchange e))\n                                                (= :http/closed (:http/event e))))\n                                   (h/values ingress)))\n                  \"the closed socket is deposited as :http/closed\")\n              (is (not (contains? (http/open-exchanges boundary) id)))\n              (is (wait-for 3000\n                            #(do (when (pos? (.available in))\n                                   (let [n (.read in buf)]\n                                     (.append seen (String. buf 0 n \"UTF-8\"))))\n                                 (str/ends-with? (str seen) \"0\\r\\n\\r\\n\")))\n                  \"the client reads the response to its end\")\n              (is (wait-for 3000 #(not (contains? (driver/subscriptions drv s) id)))\n                  \"the driver drops the exchange\")))))\n      (finally (stop!)))))\n\n\n(deftest agent-receives-answers-and-resumes-over-the-real-boundary\n  (let [{:keys [port stop!]} (compose)]\n    (try\n      (let [page (roundtrip port \"GET\" \"/\" nil)\n            s (second (re-find #\"data-root=\\\"([^\\\"]+)\\\"\" page))\n            r1 (roundtrip port \"POST\" (str \"/k/\" s) \"{\\\"inc\\\":5}\")\n            o1 (h/occ-of r1)\n            r2 (roundtrip port \"POST\" (str \"/k/\" o1) \"{\\\"inc\\\":2}\")]\n        (is (some? s))\n        (is (str/includes? page \"200\"))\n        (is (str/includes? r1 \"text/event-stream\"))\n        (is (str/includes? r1 \">5<\"))\n        (is (some? o1))\n        (is (str/includes? r2 \">7<\") \"the second answer reflects the first\")\n        (is (not= o1 (h/occ-of r2))))\n      (finally (stop!)))))\n\n\n(ns dao.star.peer-close-test\n  \"A peer's close, deposited as `:http/closed`, is read by the driver as data.\"\n  (:require [clojure.test :refer [deftest is]]\n            [dao.star.driver :as driver]\n            [dao.star.driver-test :as h]\n            [dao.stream :as stream]))\n\n\n(deftest a-peer-close-is-read-as-data-and-drops-the-subscription\n  (let [w (h/start! (h/world))\n        s (h/begin-lineage! w)\n        sub (h/call! w :get (str \"/s/\" s))]\n    (h/pump! w)\n    (is (contains? (driver/subscriptions (:driver w) s) sub))\n    (swap! (:open w) disj sub)\n    (stream/append! (:ingress w) {:http/exchange sub :http/event :http/closed})\n    (h/pump! w)\n    (is (not (contains? (driver/subscriptions (:driver w) s) sub)))\n    (let [before (count (h/effects w sub))]\n      (h/input! w s)\n      (is (= before (count (h/effects w sub))) \"no patch is written to a dropped exchange\"))))\n","exit_code":0,"status":"completed"}}
