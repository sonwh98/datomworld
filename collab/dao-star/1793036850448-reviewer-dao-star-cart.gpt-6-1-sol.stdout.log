{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/space/transact.cljc'","aggregated_output":"     1\t(ns dao.space.transact\n     2\t  \"Stateless transaction processing library. Extracts tx-data into raw datoms\n     3\t   by parsing entity maps, resolving tempids, enforcing uniqueness, and\n     4\t   generating cardinality-one retractions using dao.space.query.\"\n     5\t  (:require [clojure.string :as str]\n     6\t            [dao.datom :as datom]\n     7\t            [dao.space.query :as query]))\n     8\t\n     9\t\n    10\t(defn- tempid?\n    11\t  [x]\n    12\t  (or (and (string? x) (str/starts-with? x \"tid_\")) (and (number? x) (neg? x))))\n    13\t\n    14\t\n    15\t(defn- parse-op\n    16\t  [m e a v default-op]\n    17\t  (if (map? m)\n    18\t    (let [{:keys [db/op], :as without-op} (dissoc m :db/op)\n    19\t          op-kw (or op default-op)\n    20\t          datom-m-val (get datom/reserved op-kw op-kw)]\n    21\t      {:op op-kw,\n    22\t       :e e,\n    23\t       :a a,\n    24\t       :v v,\n    25\t       :m-raw datom-m-val,\n    26\t       :m-map (when (seq without-op) without-op)})\n    27\t    (let [op-kw (if (= m (:db/retract datom/reserved)) :db/retract :db/add)\n    28\t          m-raw (or m (:db/assert datom/reserved))]\n    29\t      {:op op-kw, :e e, :a a, :v v, :m-raw m-raw, :m-map nil})))\n    30\t\n    31\t\n    32\t(defn- map->datoms\n    33\t  \"Convert an entity map into a seq of [e a v] or parsed ops.\"\n    34\t  [m]\n    35\t  (let [e (or (:db/id m) (str \"tid_\" (gensym)))]\n    36\t    (mapcat (fn [[a v]]\n    37\t              (if (and (or (sequential? v) (set? v))\n    38\t                       (not (map? v))\n    39\t                       (not= a :db/valueType)\n    40\t                       (not= a :db/cardinality))\n    41\t                (map #(parse-op nil e a % :db/add) v)\n    42\t                [(parse-op nil e a v :db/add)]))\n    43\t            (dissoc m :db/id))))\n    44\t\n    45\t\n    46\t(defn- parse-tx-data\n    47\t  \"Normalize tx-data into a flat sequence of parsed ops.\"\n    48\t  [tx-data]\n    49\t  (mapcat (fn [item]\n    50\t            (if (map? item)\n    51\t              (map->datoms item)\n    52\t              (let [[op e a v m] item] [(parse-op m e a v op)])))\n    53\t          tx-data))\n    54\t\n    55\t\n    56\t(defn- lookup-ident-eid\n    57\t  \"Resolve an ident keyword to its entity id.\"\n    58\t  [base-datoms same-tx-ident->eid ident]\n    59\t  (or (get same-tx-ident->eid ident)\n    60\t      (let [res (query/match (query/current (query/relation base-datoms))\n    61\t                  ['_ :db/ident ident])]\n    62\t        (when (seq res) (nth (first res) 0)))))\n    63\t\n    64\t\n    65\t(defn- effective-ref-attrs-for-tx\n    66\t  \"Compute the set of :db.type/ref attributes, incorporating same-tx schema changes.\"\n    67\t  [base-datoms parsed-ops same-tx-ident->eid]\n    68\t  (let [eid->ident (into {}\n    69\t                         (keep (fn [d]\n    70\t                                 (when (= (nth d 1) :db/ident)\n    71\t                                   [(nth d 0) (nth d 2)])))\n    72\t                         base-datoms)\n    73\t        eid->ident (into eid->ident\n    74\t                         (keep (fn [{:keys [op e a v]}]\n    75\t                                 (when (and (= op :db/add) (= a :db/ident))\n    76\t                                   [e v])))\n    77\t                         parsed-ops)\n    78\t        existing-refs (into #{}\n    79\t                            (keep (fn [d] (get eid->ident (nth d 0))))\n    80\t                            (query/match (query/current (query/relation\n    81\t                                                          base-datoms))\n    82\t                              ['_ :db/valueType :db.type/ref]))\n    83\t        gaining (into #{}\n    84\t                      (keep (fn [{:keys [op e a v]}]\n    85\t                              (when (and (= op :db/add)\n    86\t                                         (= a :db/valueType)\n    87\t                                         (= v :db.type/ref))\n    88\t                                (let [resolved-e (if (keyword? e)\n    89\t                                                   (lookup-ident-eid\n    90\t                                                     base-datoms\n    91\t                                                     same-tx-ident->eid\n    92\t                                                     e)\n    93\t                                                   e)]\n    94\t                                  (or (when (keyword? e) e)\n    95\t                                      (get eid->ident resolved-e))))))\n    96\t                      parsed-ops)\n    97\t        losing (into #{}\n    98\t                     (keep (fn [{:keys [op e a v]}]\n    99\t                             (when (and (= op :db/retract)\n   100\t                                        (= a :db/valueType)\n   101\t                                        (= v :db.type/ref))\n   102\t                               (let [resolved-e (if (keyword? e)\n   103\t                                                  (lookup-ident-eid\n   104\t                                                    base-datoms\n   105\t                                                    same-tx-ident->eid\n   106\t                                                    e)\n   107\t                                                  e)]\n   108\t                                 (or (when (keyword? e) e)\n   109\t                                     (get eid->ident resolved-e))))))\n   110\t                     parsed-ops)]\n   111\t    (-> existing-refs\n   112\t        (into gaining)\n   113\t        (#(apply disj % losing)))))\n   114\t\n   115\t\n   116\t(defn- expand-m-map\n   117\t  \"Expand inline metadata maps into additional datoms.\"\n   118\t  [op eid t]\n   119\t  (let [m-map (:m-map op)]\n   120\t    (if m-map\n   121\t      (let [m-datoms (mapcat\n   122\t                       (fn [[a v]]\n   123\t                         (if (and (or (sequential? v) (set? v)) (not (map? v)))\n   124\t                           (map #(vector eid a % t (:db/assert datom/reserved))\n   125\t                                v)\n   126\t                           [[eid a v t (:db/assert datom/reserved)]]))\n   127\t                       m-map)\n   128\t            op' (assoc op :m-raw eid)]\n   129\t        [op' m-datoms (inc eid)])\n   130\t      [op [] eid])))\n   131\t\n   132\t\n   133\t(defn- collect-tempids\n   134\t  \"Collect all tempids from parsed ops and extra datoms.\"\n   135\t  [ops effective-ref-attrs extra-datoms]\n   136\t  (let [op-tempids (mapcat (fn [{:keys [e a v m-raw]}]\n   137\t                             (cond-> []\n   138\t                               (tempid? e) (conj e)\n   139\t                               (and (contains? effective-ref-attrs a)\n   140\t                                    (tempid? v))\n   141\t                               (conj v)\n   142\t                               (tempid? m-raw) (conj m-raw)))\n   143\t                           ops)\n   144\t        extra-tempids (mapcat (fn [d]\n   145\t                                (cond-> []\n   146\t                                  (tempid? (nth d 0)) (conj (nth d 0))\n   147\t                                  (and (contains? effective-ref-attrs (nth d 1))\n   148\t                                       (tempid? (nth d 2)))\n   149\t                                  (conj (nth d 2))\n   150\t                                  (tempid? (nth d 4)) (conj (nth d 4))))\n   151\t                              extra-datoms)]\n   152\t    (into #{} (concat op-tempids extra-tempids))))\n   153\t\n   154\t\n   155\t(defn- resolve-tempids\n   156\t  \"Assign sequential permanent entity IDs to tempids.\"\n   157\t  [tempids start-eid]\n   158\t  (let [sorted-tempids (sort (fn [a b]\n   159\t                               (cond (and (number? a) (number? b)) (compare a b)\n   160\t                                     (and (string? a) (string? b)) (compare a b)\n   161\t                                     (number? a) -1\n   162\t                                     :else 1))\n   163\t                             tempids)]\n   164\t    (zipmap sorted-tempids\n   165\t            (range start-eid (+ start-eid (count sorted-tempids))))))\n   166\t\n   167\t\n   168\t(defn- apply-tempid-map\n   169\t  \"Replace tempids with permanent entity IDs in parsed ops.\"\n   170\t  [ops tempid-map effective-ref-attrs]\n   171\t  (mapv (fn [op]\n   172\t          (let [e' (if (tempid? (:e op))\n   173\t                     (get tempid-map (:e op) (:e op))\n   174\t                     (:e op))\n   175\t                v' (if (and (contains? effective-ref-attrs (:a op))\n   176\t                            (tempid? (:v op)))\n   177\t                     (get tempid-map (:v op) (:v op))\n   178\t                     (:v op))\n   179\t                m-raw' (if (tempid? (:m-raw op))\n   180\t                         (get tempid-map (:m-raw op) (:m-raw op))\n   181\t                         (:m-raw op))]\n   182\t            (assoc op\n   183\t                   :e e'\n   184\t                   :v v'\n   185\t                   :m-raw m-raw')))\n   186\t        ops))\n   187\t\n   188\t\n   189\t(defn prepare-tx\n   190\t  \"Takes base-datoms and tx-data.\n   191\t   Returns {:datoms [...] :tempids {...} :next-eid new-eid :next-t new-t}.\n   192\t   Can optionally pass next-eid and next-t to avoid scanning.\"\n   193\t  [{:keys [base-datoms tx-data next-t next-eid]}]\n   194\t  (let [t (or next-t\n   195\t              (inc (reduce (fn [mx d] (max mx (nth d 3))) 0 base-datoms)))\n   196\t        base-eid (or next-eid\n   197\t                     (reduce (fn [mx d]\n   198\t                               (let [e (nth d 0)\n   199\t                                     v (nth d 2)]\n   200\t                                 (-> mx\n   201\t                                     (max (if (number? e) (inc e) 0))\n   202\t                                     (max (if (and (number? v)\n   203\t                                                   (not= (nth d 1) :db/ident))\n   204\t                                            (inc v)\n   205\t                                            0)))))\n   206\t                             datom/first-user-id\n   207\t                             base-datoms))\n   208\t        parsed-ops (parse-tx-data tx-data)\n   209\t        same-tx-ident->eid\n   210\t        (into {}\n   211\t              (keep (fn [{:keys [op e a v]}]\n   212\t                      (when (and (= op :db/add) (= a :db/ident)) [v e])))\n   213\t              parsed-ops)\n   214\t        effective-ref-attrs\n   215\t        (effective-ref-attrs-for-tx base-datoms parsed-ops same-tx-ident->eid)\n   216\t        alloc-base-eid (reduce\n   217\t                         (fn [eid {:keys [op e a v m-raw]}]\n   218\t                           (let [mx (if (and (= op :db/add)\n   219\t                                             (number? e)\n   220\t                                             (>= e datom/first-user-id))\n   221\t                                      (max eid (inc e))\n   222\t                                      eid)\n   223\t                                 mx (if (and (= op :db/add)\n   224\t                                             (contains? effective-ref-attrs a)\n   225\t                                             (number? v)\n   226\t                                             (>= v datom/first-user-id))\n   227\t                                      (max mx (inc v))\n   228\t                                      mx)\n   229\t                                 mx (if (and (= op :db/add)\n   230\t                                             (number?