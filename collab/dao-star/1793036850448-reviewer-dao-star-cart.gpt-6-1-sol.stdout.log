{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/star_cart/grid_view.cljc && nl -ba src/cljc/dao/star_cart/view.cljc'","aggregated_output":"     1\t(ns dao.star-cart.grid-view\n     2\t  \"Pure projection for the grid face.  Every action URL carries the `/grid`\n     3\t   prefix, because the host edge strips it before the grid's own boundary.\"\n     4\t  (:require [dao.star-cart.view :as v]))\n     5\t\n     6\t\n     7\t(def prefix \"/grid\")\n     8\t\n     9\t\n    10\t(defn- btn\n    11\t  [token label a arg]\n    12\t  (v/button prefix token label a arg))\n    13\t\n    14\t\n    15\t(defn- row\n    16\t  [token sel item]\n    17\t  (str \"<li class=\\\"\" (if (= sel (:key item)) \"sel\" \"\") \"\\\"><span class=\\\"nm\\\">\" (v/esc (:name item))\n    18\t       \"</span><span class=\\\"pr\\\">\" (v/money (:price item)) \"</span>\"\n    19\t       \"<button type=\\\"button\\\" data-on:click=\\\"$name=\" (v/js-lit (:name item)) \"; $price=\" (v/js-lit (:price item))\n    20\t       \"; $desc=\" (v/js-lit (:description item)) \"; \" (v/act prefix token \"select\" (:key item)) \"\\\">Edit</button></li>\"))\n    21\t\n    22\t\n    23\t(defn- editor\n    24\t  [token item]\n    25\t  (str \"<section class=\\\"editor\\\"><h2>\" (v/esc (:name item)) \"</h2>\"\n    26\t       \"<label>Name <input data-bind:name placeholder=\\\"name\\\" value=\\\"\" (v/esc (:name item)) \"\\\"></label>\"\n    27\t       \"<label>Price (cents) <input data-bind:price inputmode=\\\"numeric\\\" value=\\\"\" (:price item) \"\\\"></label>\"\n    28\t       \"<label>Description <textarea data-bind:desc>\" (v/esc (:description item)) \"</textarea></label>\"\n    29\t       \"<div class=\\\"row\\\">\"\n    30\t       \"<button type=\\\"button\\\" data-on:click=\\\"$name=\" (v/js-lit (:name item)) \"; $price=\" (v/js-lit (:price item))\n    31\t       \"; $desc=\" (v/js-lit (:description item)) \"\\\">Reset fields</button>\"\n    32\t       (btn token \"Save\" \"save\" nil) (btn token \"Close\" \"cancel\" nil) \"</div>\"\n    33\t       \"<h3>Images</h3><ul class=\\\"imgs\\\">\"\n    34\t       (apply str (for [u (:images item)]\n    35\t                    (str \"<li><img src=\\\"\" (v/enc-path u) \"\\\" alt=\\\"\\\"><span>\" (v/esc u) \"</span>\"\n    36\t                         (btn token \"Remove\" \"rmimg\" u) \"</li>\")))\n    37\t       \"</ul><div class=\\\"row\\\"><input data-bind:img placeholder=\\\"/images/…\\\">\"\n    38\t       (btn token \"Add image\" \"addimg\" nil) \"</div>\"\n    39\t       \"<h3>Tagories</h3><ul class=\\\"tags\\\">\"\n    40\t       (apply str (for [t (:tagories item)]\n    41\t                    (str \"<li><span>\" (v/esc t) \"</span>\" (btn token \"Remove\" \"rmtag\" t) \"</li>\")))\n    42\t       \"</ul><div class=\\\"row\\\"><input data-bind:tag placeholder=\\\"tagory\\\">\"\n    43\t       (btn token \"Add tagory\" \"addtag\" nil) \"</div></section>\"))\n    44\t\n    45\t\n    46\t(defn- status\n    47\t  [model]\n    48\t  (case (:status model)\n    49\t    \"saving\" \"<p class=\\\"status saving\\\">saving</p>\"\n    50\t    \"saved\" \"<p class=\\\"status saved\\\">saved</p>\"\n    51\t    \"rejected\" (str \"<p class=\\\"status rejected\\\">rejected: \" (v/esc (:msg model)) \"</p>\")\n    52\t    \"\"))\n    53\t\n    54\t\n    55\t(defn grid-project\n    56\t  \"`(project-fn occurrence-id model)` for the grid, over `catalog` (`:items`,\n    57\t   `:item`): the item list, and the editor for the selected item, read fresh.\"\n    58\t  [catalog token model]\n    59\t  (let [sel (:sel model)\n    60\t        item (when sel ((:item catalog) sel))]\n    61\t    (v/sse-elements\n    62\t      (str \"<div id=\\\"app\\\"><header><h1>Catalog grid</h1><a href=\\\"/\\\">Shop</a></header>\"\n    63\t           \"<p class=\\\"warn\\\">No authentication: anyone who can reach this port can edit.</p>\"\n    64\t           (status model)\n    65\t           \"<div class=\\\"cols\\\"><ul class=\\\"items\\\">\"\n    66\t           (apply str (map #(row token sel %) ((:items catalog))))\n    67\t           \"</ul>\" (if item (editor token item) \"<section class=\\\"editor\\\"><p>Select an item.</p></section>\")\n    68\t           \"</div></div>\"))))\n    69\t\n    70\t\n    71\t(defn grid-begin\n    72\t  [root]\n    73\t  (v/begin-page {:prefix prefix :title \"dao.star cart grid\" :root root\n    74\t                 :signals \"{act: '', arg: '', name: '', price: '', desc: '', img: '', tag: ''}\"}))\n     1\t(ns dao.star-cart.view\n     2\t  \"Pure projections for the dao.star cart's shop face, and the helpers the grid\n     3\t   face shares: HTML escaping, money, the Datastar SSE framing, and the begin\n     4\t   page.\n     5\t\n     6\t   Datastar is pinned at `datastar-version`.  Its SSE vocabulary at that\n     7\t   version: an event named `datastar-patch-elements` whose data lines are\n     8\t   prefixed `elements ` (the HTML to morph, matched by element id), and\n     9\t   `datastar-patch-signals` whose data lines are prefixed `signals `.  An event\n    10\t   ends with a blank line.  Actions are `data-on:<event>` attributes calling\n    11\t   `@get`/`@post`; the request's signals ride the query (GET) or JSON body.\"\n    12\t  (:require [clojure.string :as str]))\n    13\t\n    14\t\n    15\t(def datastar-version \"1.0.0-RC.7\")\n    16\t\n    17\t\n    18\t(defn esc\n    19\t  \"HTML-escape text for element content and double-quoted attributes.\"\n    20\t  [s]\n    21\t  (-> (str s)\n    22\t      (str/replace \"&\" \"&amp;\")\n    23\t      (str/replace \"<\" \"&lt;\")\n    24\t      (str/replace \">\" \"&gt;\")\n    25\t      (str/replace \"\\\"\" \"&quot;\")\n    26\t      (str/replace \"'\" \"&#39;\")))\n    27\t\n    28\t\n    29\t(defn js-lit\n    30\t  \"A single-quoted JavaScript string literal for use inside an attribute.\"\n    31\t  [s]\n    32\t  (esc (str \"'\" (-> (str s) (str/replace \"\\\\\" \"\\\\\\\\\") (str/replace \"'\" \"\\\\'\")) \"'\")))\n    33\t\n    34\t\n    35\t(defn enc-path\n    36\t  \"Make an asset path safe inside an attribute and a URL: the characters that\n    37\t   would end an attribute, a path or start a query are percent-encoded.  Other\n    38\t   characters (spaces aside) are left for the browser.\"\n    39\t  [p]\n    40\t  (reduce (fn [s [from to]] (str/replace s from to))\n    41\t          (str p)\n    42\t          [[\"%\" \"%25\"] [\" \" \"%20\"] [\"#\" \"%23\"] [\"?\" \"%3F\"] [\"\\\"\" \"%22\"]\n    43\t           [\"'\" \"%27\"] [\"<\" \"%3C\"] [\">\" \"%3E\"]]))\n    44\t\n    45\t\n    46\t(defn money\n    47\t  \"Prices are minor units (cents): 2400 renders $24.00.\"\n    48\t  [cents]\n    49\t  (let [c (or cents 0)\n    50\t        r (rem c 100)]\n    51\t    (str \"$\" (quot c 100) \".\" (if (< r 10) (str \"0\" r) r))))\n    52\t\n    53\t\n    54\t(defn sse-elements\n    55\t  \"One `datastar-patch-elements` event carrying `html`, newlines folded.\"\n    56\t  [html]\n    57\t  (str \"event: datastar-patch-elements\\ndata: elements \"\n    58\t       (str/replace html \"\\n\" \" \") \"\\n\\n\"))\n    59\t\n    60\t\n    61\t(defn sse-signals\n    62\t  \"One `datastar-patch-signals` event carrying the JSON text `json`.\"\n    63\t  [json]\n    64\t  (str \"event: datastar-patch-signals\\ndata: signals \" json \"\\n\\n\"))\n    65\t\n    66\t\n    67\t(defn act\n    68\t  \"A click action: set the `act`/`arg` signals and post to the occurrence token.\n    69\t   `prefix` is \\\"\\\" for the shop and \\\"/grid\\\" for the grid.\"\n    70\t  ([prefix token a] (act prefix token a nil))\n    71\t  ([prefix token a arg]\n    72\t   (str \"$act=\" (js-lit a) \"; $arg=\" (js-lit (or arg \"\")) \"; @post('\"\n    73\t        prefix \"/k/\" (esc token) \"')\")))\n    74\t\n    75\t\n    76\t(defn button\n    77\t  [prefix token label a arg]\n    78\t  (str \"<button type=\\\"button\\\" data-on:click=\\\"\" (act prefix token a arg) \"\\\">\"\n    79\t       (esc label) \"</button>\"))\n    80\t\n    81\t\n    82\t(defn begin-page\n    83\t  \"The complete HTML document at the root: the vendored script, the\n    84\t   stylesheet, base signals, and a subscription to the lineage's token.\"\n    85\t  [{:keys [prefix title signals root]}]\n    86\t  (str \"<!doctype html><html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\">\"\n    87\t       \"<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\"\n    88\t       \"<title>\" (esc title) \"</title>\"\n    89\t       \"<link rel=\\\"stylesheet\\\" href=\\\"/css/cart.css\\\">\"\n    90\t       \"<script type=\\\"module\\\" src=\\\"/js/datastar.js\\\"></script></head>\"\n    91\t       \"<body data-signals=\\\"\" (esc signals) \"\\\" data-init=\\\"@get('\" prefix \"/s/\" (esc root) \"')\\\">\"\n    92\t       \"<div id=\\\"app\\\"><p class=\\\"loading\\\">Loading…</p></div></body></html>\"))\n    93\t\n    94\t\n    95\t;; -----------------------------------------------------------------------------\n    96\t;; Shop\n    97\t;; -----------------------------------------------------------------------------\n    98\t\n    99\t(defn- first-image\n   100\t  [item]\n   101\t  (first (:images item)))\n   102\t\n   103\t\n   104\t(defn- cart-lines\n   105\t  \"The cart model (slug -> qty, zero entries dropped) joined with the catalog.\"\n   106\t  [catalog cart]\n   107\t  (vec (for [[slug qty] (sort-by key cart)\n   108\t             :when (and (number? qty) (pos? qty))\n   109\t             :let [item ((:item catalog) slug)]\n   110\t             :when item]\n   111\t         (assoc item :qty qty))))\n   112\t\n   113\t\n   114\t(defn cart-total\n   115\t  [lines]\n   116\t  (reduce + 0 (map #(* (:qty %) (or (:price %) 0)) lines)))\n   117\t\n   118\t\n   119\t(defn- header\n   120\t  [token cart-count]\n   121\t  (str \"<header><h1>\" (button \"\" token \"Shop\" \"nav\" \"catalog\") \"</h1>\"\n   122\t       \"<nav>\" (button \"\" token (str \"Cart (\" cart-count \")\") \"nav\" \"cart\") \"</nav></header>\"))\n   123\t\n   124\t\n   125\t(defn- card\n   126\t  [token item]\n   127\t  (str \"<article class=\\\"card\\\">\"\n   128\t       (if-let [img (first-image item)]\n   129\t         (str \"<img src=\\\"\" (enc-path img) \"\\\" alt=\\\"\" (esc (:name item)) \"\\\" loading=\\\"lazy\\\">\")\n   130\t         \"<div class=\\\"noimg\\\"></div>\")\n   131\t       \"<h3>\" (esc (:name item)) \"</h3>\"\n   132\t       \"<p class=\\\"price\\\">\" (money (:price item)) \"</p>\"\n   133\t       \"<div class=\\\"row\\\">\" (button \"\" token \"View\" \"item\" (:key item))\n   134\t       (button \"\" token \"Add\" \"add\" (:key item)) \"</div></article>\"))\n   135\t\n   136\t\n   137\t(defn- catalog-page\n   138\t  [catalog token]\n   139\t  (str \"<section class=\\\"grid\\\">\" (apply str (map #(card token %) (remove #(empty? (str/trim (str (:name %)))) ((:items catalog))))) \"</section>\"))\n   140\t\n   141\t\n   142\t(defn- item-page\n   143\t  [catalog token slug]\n   144\t  (if-let [item ((:item catalog) slug)]\n   145\t    (str \"<section class=\\\"detail\\\"><div class=\\\"gallery\\\">\"\n   146\t         (apply str (for [img (:images item)]\n   147\t                      (str \"<img src=\\\"\" (enc-path img) \"\\\" alt=\\\"\" (esc (:name item)) \"\\\">\")))\n   148\t         \"</div><div><h2>\" (esc (:name item)) \"</h2><p class=\\\"price\\\">\" (money (:price item)) \"</p>\"\n   149\t         \"<p>\" (esc (:description item)) \"</p>\"\n   150\t         \"<p class=\\\"tags\\\">\" (apply str (for [t (:tagories item)] (str \"<span>\" (esc t) \"</span>\"))) \"</p>\"\n   151\t         \"<div class=\\\"row\\\">\" (button \"\" token \"Add to cart\" \"add\" slug)\n   152\t         (button \"\" token \"Back\" \"nav\" \"catalog\") \"</div></div></section>\")\n   153\t    (str \"<p>That item is gone.</p>\" (button \"\" token \"Back\" \"nav\" \"catalog\"))))\n   154\t\n   155\t\n   156\t(defn- cart-page\n   157\t  [catalog token cart]\n   158\t  (let [lines (cart-lines catalog cart)]\n   159\t    (if (empty? lines)\n   160\t      \"<section class=\\\"cart\\\"><h2>Your cart</h2><p>The cart is empty.</p></section>\"\n   161\t      (str \"<section class=\\\"cart\\\"><h2>Your cart</h2><table>\"\n   162\t           (apply str\n   163\t                  (for [l lines]\n   164\t                    (str \"<tr><td>\" (esc (:name l)) \"</td><td>\" (money (:price l)) \"</td><td>\"\n   165\t                         (button \"\" token \"−\" \"remove\" (:key l))\n   166\t                         \" <span class=\\\"qty\\\">\" (:qty l) \"</span> \"\n   167\t                         (button \"\" token \"+\" \"add\" (:key l))\n   168\t                         \"</td><td>\" (money (* (:qty l) (:price l))) \"</td></tr>\")))\n   169\t           \"</table><p class=\\\"total\\\">Total: <strong>\" (money (cart-total lines)) \"</strong></p>\"\n   170\t           (button \"\" token \"Checkout\" \"checkout\" nil) \"</section>\"))))\n   171\t\n   172\t\n   173\t(defn shop-project\n   174\t  \"`(project-fn occurrence-id model)` for the shop, over `catalog`, a map of\n   175\t   `:items (fn [])` and `:item (fn [slug])`.  Pure: re-projecting a stored\n   176\t   model re-reads the catalog, so a stale view is a view of the catalog as of\n   177\t   its last projection.\"\n   178\t  [catalog token model]\n   179\t  (let [cart (:cart model)\n   180\t        n (reduce + 0 (filter pos? (vals cart)))]\n   181\t    (sse-elements\n   182\t      (str \"<div id=\\\"app\\\">\" (header token n)\n   183\t           \"<main>\"\n   184\t           (case (:page model)\n   185\t             \"item\" (item-page catalog token (:item model))\n   186\t             \"cart\" (cart-page catalog token cart)\n   187\t             \"checkout\" \"<section class=\\\"cart\\\"><h2>Order received</h2><p>This is a demo: no payment was taken.</p></section>\"\n   188\t             (catalog-page catalog token))\n   189\t           \"</main><footer>Catalog as of last page load.</footer></div>\"))))\n   190\t\n   191\t\n   192\t(defn shop-begin\n   193\t  [root]\n   194\t  (begin-page {:prefix \"\" :title \"dao.star cart\" :root root\n   195\t               :signals \"{act: '', arg: ''}\"}))\n","exit_code":0,"status":"completed"}}
