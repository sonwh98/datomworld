{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat src/clj/dao/star_cart/*.clj'","aggregated_output":"(ns dao.star-cart.assemble\n  \"The one composition function.  `assemble` wires an HTTP boundary, the\n   exchange and lineage judges, the router, the driver, every medium and the\n   tick streams for one app; the shop and the grid are two calls with different\n   programs, projections and begin pages.  Session facts are a complete-history\n   memory log; subscription exchanges carry the required `:dao.lease/max`; the\n   renewal intervals come from `lease/renewal-interval`, never by hand.\"\n  (:require [dao.lease :as dl]\n            [dao.star.driver :as driver]\n            [dao.star.lease :as lease]\n            [dao.star.router :as router]\n            [dao.stream :as stream]\n            [dao.stream.http :as http]\n            [dao.stream.http.jvm :as jvm]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.ringbuffer :as ring]))\n\n\n(def units {:ms 1})\n\n\n(def default-timing\n  \"Durations and the tick period, in milliseconds.  Each renewal interval is\n   sized against its duration and the tick period by `lease/renewal-interval`.\"\n  {:tick-ms 50\n   :exchange-duration 60000\n   :exchange-renew 20000\n   :lineage-duration 1800000\n   :lineage-renew 600000\n   :subscription-max 3600000})\n\n\n(defn- ring!\n  [capacity]\n  (:dao.stream/handle (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n                                     :dao.stream.ringbuffer/capacity capacity})))\n\n\n(defn- log!\n  []\n  (:dao.stream/handle (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n\n\n(defn assemble\n  \"Wire one app.  Config: `:program`, `:project-fn` `(fn [occurrence model])`,\n   `:begin-fn` `(fn [root])`, and optional `:timing` merged over\n   `default-timing`.  Answers\n     {:handler   the ring handler for this app's boundary\n      :boundary  the boundary\n      :driver :router\n      :step!     (fn [now-ms]) one pass of every stepped part, ticks included\n      :stop!     (fn [])}\"\n  [{:keys [program project-fn begin-fn timing]}]\n  (let [{:keys [tick-ms exchange-duration exchange-renew lineage-duration\n                lineage-renew subscription-max]} (merge default-timing timing)\n        period {:ms tick-ms}\n        ex-dur {:ms exchange-duration}\n        lin-dur {:ms lineage-duration}\n        ex-interval (dl/renewal-interval units ex-dur {:ms exchange-renew} period)\n        lin-interval (dl/renewal-interval units lin-dur {:ms lineage-renew} period)\n        ingress (ring! 1024)\n        egress (ring! 4096)\n        facts (log!)\n        lineage-lease (ring! 1024)\n        exchange-lease (ring! 1024)\n        begin (ring! 256)\n        ticks {:driver (ring! 1024) :exchange (ring! 1024) :lineage (ring! 1024)}\n        boundary (http/make-boundary\n                   {:ingress {:dao.stream/handle ingress :dao.stream/surface #{:writer}}\n                    :ingress-admission {:retention :evict-oldest :capacity 1024\n                                        :value-domain :portable-values\n                                        :lifetime :outlives-boundary}\n                    :egress {:dao.stream/handle egress :dao.stream/surface #{:reader}}\n                    :http/max-open 256 :http/max-body-bytes 65536})\n        decl (lease/facts-declaration)\n        drv (driver/make-driver\n              {:facts facts :egress egress :begin begin :tick (:driver ticks)\n               :lineage-lease lineage-lease :exchange-lease exchange-lease\n               :program program :project-fn project-fn :begin-fn begin-fn\n               :units units :lineage-renewal-interval lin-interval\n               :exchange-renewal-interval ex-interval\n               :session-capacity 256 :lease-capacity 1024 :facts-declaration decl})\n        xl (lease/make-exchange-lease\n             {:ingress ingress :egress egress :lease-medium exchange-lease\n              :tick (:exchange ticks)\n              :open-exchanges #(http/open-exchanges boundary)\n              :close-exchange #(http/close-exchange boundary %)\n              :units units :duration ex-dur :cadence period :tolerance {:ms 0}\n              :capacity 4096 :subscription-max {:ms subscription-max}})\n        ll (lease/make-lineage-lease\n             {:facts facts :lease-medium lineage-lease :tick (:lineage ticks)\n              :retire! #(driver/retire! drv %) :units units :duration lin-dur\n              :cadence period :tolerance {:ms 0} :facts-declaration decl})\n        rt (router/make-router\n             {:ingress ingress :facts facts :lease lineage-lease :begin begin\n              :co-located? true :facts-declaration decl\n              :session-medium #(driver/session-medium drv %)})]\n    {:handler (jvm/handler boundary)\n     :boundary boundary\n     :driver drv\n     :router rt\n     :ticks ticks\n     :step! (fn [now-ms]\n              (doseq [t (vals ticks)]\n                (stream/append! t (dl/tick {:ms (max 1 now-ms)})))\n              (lease/exchange-lease-step! xl)\n              (lease/lineage-lease-step! ll)\n              (router/router-step! rt)\n              (driver/driver-step! drv)\n              (http/egress-step boundary))\n     :stop! (fn [] (http/stop! boundary))}))\n(ns dao.star-cart.catalog\n  \"Catalog reads and the catalog's datom shape.  Every read is\n   `dao.space.query/q` + `collect` over a db value (a `current` view over a\n   `relation`); nothing here touches a store or an atom.\"\n  (:require [clojure.string :as str]\n            [dao.space.query :as query]))\n\n\n(def schema-tx\n  \"Schema first: images and tagories are many-valued refs.\"\n  [{:db/ident :item/images :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}\n   {:db/ident :item/tagories :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])\n\n\n(defn db\n  \"The db value over accumulated datoms.\"\n  [datoms]\n  (query/current (query/relation datoms)))\n\n\n(defn- tagory-tid\n  [name]\n  (str \"tid_tag_\" (hash name)))\n\n\n(defn items->tx\n  \"tx-data for plain item maps (the on-disk shape): one entity per item, one\n   per image, one per distinct tagory name, refs by tempid.\"\n  [item-maps]\n  (let [indexed (map-indexed vector item-maps)\n        tagories (distinct (for [[_ m] indexed t (:item/tagories m)] (:tagory/name t)))]\n    (vec\n      (concat\n        (for [n tagories] {:db/id (tagory-tid n) :tagory/name n})\n        (mapcat\n          (fn [[i m]]\n            (let [img-tids (map-indexed (fn [j _] (str \"tid_img_\" i \"_\" j)) (:item/images m))]\n              (concat\n                (map (fn [tid img] {:db/id tid :image/url (:image/url img)}) img-tids (:item/images m))\n                [(cond-> {:db/id (str \"tid_item_\" i)\n                          :item/slug (:item/slug m)\n                          :item/name (:item/name m)\n                          :item/price (:item/price m)\n                          :item/images (vec img-tids)\n                          :item/tagories (mapv (comp tagory-tid :tagory/name) (:item/tagories m))}\n                   (:item/description m) (assoc :item/description (:item/description m)))])))\n          indexed)))))\n\n\n(defn- rows\n  [db' q-form]\n  (query/collect (query/q q-form db')))\n\n\n(defn- by-slug\n  [db' q-form]\n  (into {} (rows db' q-form)))\n\n\n(defn items\n  \"Every item as `{:key :name :price :description :images [url] :tagories [name]}`,\n   sorted by trimmed lower-case name.  Image order is the order they were added.\"\n  [db']\n  (let [names (by-slug db' '[:find ?s ?n :where [?e :item/slug ?s] [?e :item/name ?n]])\n        prices (by-slug db' '[:find ?s ?p :where [?e :item/slug ?s] [?e :item/price ?p]])\n        descs (by-slug db' '[:find ?s ?d :where [?e :item/slug ?s] [?e :item/description ?d]])\n        imgs (group-by first\n                       (sort-by second\n                                (rows db' '[:find ?s ?i ?u :where [?e :item/slug ?s]\n                                            [?e :item/images ?i] [?i :image/url ?u]])\n                                ))\n        tags (group-by first\n                       (rows db' '[:find ?s ?n :where [?e :item/slug ?s]\n                                   [?e :item/tagories ?t] [?t :tagory/name ?n]]))]\n    (->> names\n         (map (fn [[slug n]]\n                {:key slug :name n :price (get prices slug) :description (get descs slug \"\")\n                 :images (mapv #(nth % 2) (get imgs slug))\n                 :tagories (vec (sort (map second (get tags slug))))}))\n         (sort-by #(str/lower-case (str/trim (:name %))))\n         vec)))\n\n\n(defn item\n  [db' slug]\n  (first (filter #(= slug (:key %)) (items db'))))\n\n\n(defn item-eid\n  \"The entity id of the item with `slug`, or nil.\"\n  [db' slug]\n  (ffirst (query/collect (query/q '[:find ?e :in $ ?s :where [?e :item/slug ?s]] db' slug))))\n\n\n(defn image-eid\n  \"The image entity of `url` on item `slug`, or nil.\"\n  [db' slug url]\n  (ffirst (query/collect\n            (query/q '[:find ?i :in $ ?s ?u :where [?e :item/slug ?s]\n                       [?e :item/images ?i] [?i :image/url ?u]]\n                     db' slug url))))\n\n\n(defn tagory-eid\n  \"The tagory entity named `name`, or nil.\"\n  [db' name]\n  (ffirst (query/collect (query/q '[:find ?t :in $ ?n :where [?t :tagory/name ?n]] db' name))))\n\n\n(defn tagory-linked?\n  [db' slug name]\n  (boolean (seq (query/collect\n                  (query/q '[:find ?t :in $ ?s ?n :where [?e :item/slug ?s]\n                             [?e :item/tagories ?t] [?t :tagory/name ?n]]\n                           db' slug name)))))\n\n\n(defn items-with-tagory\n  \"Slugs of the items carrying tagory `name`.\"\n  [db' name]\n  (set (map first (query/collect\n                    (query/q '[:find ?s :in $ ?n :where [?t :tagory/name ?n]\n                               [?e :item/tagories ?t] [?e :item/slug ?s]]\n                             db' name)))))\n\n\n(defn item-maps\n  \"The on-disk shape: plain item maps with nested image and tagory maps.\"\n  [db']\n  (mapv (fn [i]\n          (cond-> {:item/slug (:key i) :item/name (:name i) :item/price (:price i)\n                   :item/images (mapv (fn [u] {:image/url u}) (:images i))\n                   :item/tagories (mapv (fn [n] {:tagory/name n}) (:tagories i))}\n            (seq (:description i)) (assoc :item/description (:description i))))\n        (items db')))\n(ns dao.star-cart.edge\n  \"The host edge: one http-kit handler for the whole site.  Static assets\n   (`/images/`, `/css/`, `/js/`) are served from disk and never enter a\n   boundary; `/grid` and `/grid/...` go to the grid boundary with the prefix\n   stripped from `:uri`; everything else goes to the shop boundary.\"\n  (:require [clojure.string :as str])\n  (:import [java.net URLDecoder]\n           [java.nio.file Files LinkOption Path Paths]))\n\n\n(def content-types\n  {\"png\" \"image/png\" \"jpg\" \"image/jpeg\" \"jpeg\" \"image/jpeg\" \"gif\" \"image/gif\"\n   \"webp\" \"image/webp\" \"svg\" \"image/svg+xml\" \"css\" \"text/css\" \"js\" \"text/javascript\"\n   \"woff2\" \"font/woff2\" \"ico\" \"image/x-icon\"})\n\n\n(def static-prefixes [\"/images/\" \"/css/\" \"/js/\"])\n\n\n(defn decode-path\n  \"Percent-decode a request path (a `+` is a plus here, not a space); nil when\n   malformed.\"\n  [uri]\n  (try (URLDecoder/decode (str/replace (str uri) \"+\" \"%2B\") \"UTF-8\")\n       (catch Exception _ nil)))\n\n\n(defn- text-response\n  [status body]\n  {:status status :headers {\"content-type\" \"text/plain\"} :body body})\n\n\n(defn static-file\n  \"The regular file `decoded-path` names under `root`, or nil.  The path is\n   resolved against the root and normalized; anything that leaves the root, a\n   NUL, a backslash or a missing or non-regular file answers nil.\"\n  [^Path root decoded-path]\n  (when (and decoded-path\n             (not (str/includes? decoded-path \"\\u0000\"))\n             (not (str/includes? decoded-path \"\\\\\"))\n             (not (some #{\"..\"} (str/split decoded-path #\"/\"))))\n    (let [rel (str/replace-first decoded-path #\"^/+\" \"\")\n          target (.normalize (.resolve root rel))]\n      (when (and (.startsWith target root)\n                 (Files/isRegularFile target (into-array LinkOption [LinkOption/NOFOLLOW_LINKS])))\n        (.toFile target)))))\n\n\n(defn serve-static\n  [root path]\n  (if-let [f (static-file root path)]\n    (let [ext (str/lower-case (last (str/split (.getName f) #\"\\.\")))]\n      {:status 200\n       :headers {\"content-type\" (get content-types ext \"application/octet-stream\")\n                 \"cache-control\" \"public, max-age=3600\"}\n       :body f})\n    (text-response 404 \"not found\")))\n\n\n(defn strip-grid\n  \"`/grid` -> `/`, `/grid/s/x` -> `/s/x`; nil when `uri` is not under /grid.\"\n  [uri]\n  (cond (= uri \"/grid\") \"/\"\n        (str/starts-with? uri \"/grid/\") (subs uri 5)\n        :else nil))\n\n\n(defn static-path?\n  [path]\n  (some #(str/starts-with? path %) static-prefixes))\n\n\n(defn make-edge\n  \"`{:asset-root path :shop handler :grid handler}`.\"\n  [{:keys [asset-root shop grid]}]\n  (let [root (.toAbsolutePath (.normalize (Paths/get (str asset-root) (make-array String 0))))]\n    (fn [req]\n      (let [raw (:uri req)\n            decoded (decode-path raw)\n            under-grid (strip-grid (or raw \"/\"))\n            static-raw (or under-grid raw)\n            ;; any raw path whose first segment is a static prefix, with or\n            ;; without the /grid prefix, is static; the decode happens after\n            ;; the prefix test so encoded separators cannot dodge it\n            static? (static-path? (str static-raw))\n            decoded-static (when static? (decode-path static-raw))]\n        (cond\n          (nil? decoded) (text-response 400 \"bad request\")\n          static? (serve-static root decoded-static)\n          under-grid (grid (assoc req :uri under-grid))\n          :else (shop req))))))\n(ns dao.star-cart.grid-effects\n  \"The grid's stepped effects interpreter.  A peer observer of each grid\n   session's view medium (its own cursor, beside the driver's): when a model\n   carries `{:edit {:item slug :changes {...}}}` it validates the change, runs\n   the transact through the store, and appends a `{:saved slug}` or\n   `{:rejected reason}` confirmation to that session's routed input medium.  The\n   program therefore renders `saving` until the transact has completed.\n\n   Validation is here because signals are the client's unverified claim:\n   name 1-200 characters; price an integer 0..100000000 (minor units);\n   description at most 2000; an image URL an existing file under `/images/`;\n   a tagory 1-80 characters.\"\n  (:require [clojure.data.json :as json]\n            [clojure.string :as str]\n            [dao.star-cart.catalog :as catalog]\n            [dao.star-cart.edge :as edge]\n            [dao.star-cart.store :as store]\n            [dao.star.driver :as driver]\n            [dao.star.lease :as lease]\n            [dao.stream :as stream])\n  (:import [java.nio.file Paths]))\n\n\n(def max-name 200)\n(def max-description 2000)\n(def max-tagory 80)\n(def max-price 100000000)\n\n\n(def ^:private retract-meta {:db/op :db/retract})\n\n\n(defn- reject!\n  [reason]\n  (throw (ex-info \"rejected\" {::rejected reason})))\n\n\n(defn- parse-price\n  [p]\n  (cond (integer? p) p\n        (and (string? p) (re-matches #\"\\d{1,12}\" (str/trim p))) (Long/parseLong (str/trim p))\n        :else (reject! \"price must be a whole number of cents\")))\n\n\n(defn- check-name\n  [n]\n  (when-not (and (string? n) (<= 1 (count (str/trim n)) max-name))\n    (reject! (str \"name must be 1-\" max-name \" characters\")))\n  (str/trim n))\n\n\n(defn- check-image\n  [root url]\n  (when-not (and (string? url) (<= (count url) 300) (str/starts-with? url \"/images/\"))\n    (reject! \"image must be an /images/ path\"))\n  (when-not (edge/static-file root (edge/decode-path url))\n    (reject! \"image file does not exist\"))\n  url)\n\n\n(defn- check-tagory\n  [n]\n  (when-not (and (string? n) (<= 1 (count (str/trim n)) max-tagory))\n    (reject! (str \"tagory must be 1-\" max-tagory \" characters\")))\n  (str/trim n))\n\n\n(defn- edit-tx\n  \"tx-data for `changes` on item `slug` under `db`, or a rejection.\"\n  [root db slug changes]\n  (let [eid (or (catalog/item-eid db slug) (reject! \"no such item\"))\n        current (catalog/item db slug)\n        ;; an unchanged value is not transacted: re-asserting a card-one\n        ;; value would retract and assert the same datom in one tx\n        changed (fn [k v] (when (not= v (get current k)) v))]\n    (vec\n      (concat\n        (when (some? (:name changes))\n          (when-some [n (changed :name (check-name (:name changes)))]\n            [[:db/add eid :item/name n]]))\n        (when (some? (:price changes))\n          (let [p (parse-price (:price changes))]\n            (when-not (<= 0 p max-price) (reject! \"price out of range\"))\n            (when-some [p' (changed :price p)]\n              [[:db/add eid :item/price p']])))\n        (when (some? (:description changes))\n          (let [d (:description changes)]\n            (when-not (and (string? d) (<= (count d) max-description))\n              (reject! (str \"description must be at most \" max-description \" characters\")))\n            (when-some [d' (changed :description d)]\n              [[:db/add eid :item/description d']])))\n        (when (contains? changes :add-image)\n          (let [u (check-image root (:add-image changes))]\n            (when (catalog/image-eid db slug u) (reject! \"image already on the item\"))\n            [{:db/id \"tid_new_image\" :image/url u}\n             [:db/add eid :item/images \"tid_new_image\"]]))\n        (when (contains? changes :remove-image)\n          (let [i (or (catalog/image-eid db slug (:remove-image changes))\n                      (reject! \"image is not on the item\"))]\n            [[:db/retract eid :item/images i retract-meta]]))\n        (when (contains? changes :add-tagory)\n          (let [n (check-tagory (:add-tagory changes))]\n            (when (catalog/tagory-linked? db slug n) (reject! \"tagory already on the item\"))\n            (if-let [t (catalog/tagory-eid db n)]\n              [[:db/add eid :item/tagories t]]\n              [{:db/id \"tid_new_tagory\" :tagory/name n}\n               [:db/add eid :item/tagories \"tid_new_tagory\"]])))\n        (when (contains? changes :remove-tagory)\n          (let [n (:remove-tagory changes)\n                t (when (catalog/tagory-linked? db slug n) (catalog/tagory-eid db n))]\n            (when-not t (reject! \"tagory is not on the item\"))\n            [[:db/retract eid :item/tagories t retract-meta]]))))))\n\n\n(defn apply-edit!\n  \"Validate and transact `edit` (`{:item slug :changes {...}}`).  Answers\n   `{:saved slug}` or `{:rejected reason}`; a rejection leaves the db unchanged.\"\n  [store' asset-root {:keys [item changes]}]\n  (let [root (.toAbsolutePath (.normalize (Paths/get (str asset-root) (make-array String 0))))]\n    (try\n      (when-not (and (string? item) (map? changes))\n        (reject! \"malformed edit\"))\n      (store/transact-edit! store' (fn [db] (edit-tx root db item changes)))\n      {:saved item}\n      (catch clojure.lang.ExceptionInfo e\n        (if-let [r (::rejected (ex-data e))]\n          {:rejected r}\n          {:rejected (str \"edit failed: \" (.getMessage e))}))\n      (catch Exception e\n        {:rejected (str \"edit failed: \" (.getMessage e))}))))\n\n\n(defn make-effects\n  \"`{:driver grid-driver :store store :asset-root path}`.\"\n  [config]\n  (atom (assoc config :cursors {})))\n\n\n(defn- confirm!\n  [drv s result]\n  (when-let [medium (driver/session-medium drv s)]\n    (stream/append! medium\n                    {:exchange nil :kind :input :lineage s\n                     :token (:occurrence (driver/latest drv s))\n                     :event {:http/method :post\n                             :http/body (json/write-str\n                                          (if-let [slug (:saved result)]\n                                            {:saved slug}\n                                            {:rejected (:rejected result)}))}})))\n\n\n(defn effects-step!\n  \"One pass: read every grid session's view medium with this interpreter's own\n   cursor, perform each `:edit`, confirm.  Answers the effects atom.\"\n  [fx]\n  (let [{:keys [driver store asset-root]} @fx]\n    (doseq [s (driver/sessions driver)\n            :let [out (get-in @driver [:sessions s :vm-out])]\n            :when out]\n      (let [cursor (or (get-in @fx [:cursors s]) (lease/oldest-cursor out))\n            r (lease/drain out cursor)]\n        (swap! fx assoc-in [:cursors s] (:cursor r))\n        (doseq [model (:values r)\n                :let [edit (:edit model)]\n                :when (map? edit)]\n          (confirm! driver s (apply-edit! store asset-root edit)))))\n    fx))\n(ns dao.star-cart.main\n  \"Boot the dao.star cart: the catalog store, the shop and grid compositions\n   (one `assemble` function, called twice), the host edge, one tick loop and\n   one listener.  Environment: PORT (default 3004), CATALOG_PATH (where saves go;\n   the baked seed is copied there on first boot), ASSET_ROOT.\"\n  (:require [dao.star-cart.assemble :as assemble]\n            [dao.star-cart.edge :as edge]\n            [dao.star-cart.grid-effects :as grid-effects]\n            [dao.star-cart.grid-program :as grid-program]\n            [dao.star-cart.grid-view :as grid-view]\n            [dao.star-cart.program :as program]\n            [dao.star-cart.store :as store]\n            [dao.star-cart.view :as view]\n            [org.httpkit.server :as kit]))\n\n\n(def seed-path \"resources/dao_star_cart/catalog.edn\")\n(def default-asset-root \"resources/dao_star_cart/public\")\n\n\n(defn start!\n  \"Start the site.  Options: `:port` (0 for ephemeral), `:catalog-path`,\n   `:asset-root`, `:timing`.  Answers `{:port :store :shop :grid :stop!}`.\"\n  [{:keys [port catalog-path asset-root timing] :or {asset-root default-asset-root}}]\n  (let [st (store/open {:path catalog-path :seed seed-path})\n        catalog (store/catalog-fns st)\n        shop (assemble/assemble\n               {:program program/shop-program\n                :project-fn (fn [occ model] (view/shop-project catalog occ model))\n                :begin-fn view/shop-begin :timing timing})\n        grid (assemble/assemble\n               {:program grid-program/grid-program\n                :project-fn (fn [occ model] (grid-view/grid-project catalog occ model))\n                :begin-fn grid-view/grid-begin :timing timing})\n        fx (grid-effects/make-effects {:driver (:driver grid) :store st :asset-root asset-root})\n        tick-ms (get (merge assemble/default-timing timing) :tick-ms)\n        edge-handler (edge/make-edge {:asset-root asset-root\n                                      :shop (:handler shop) :grid (:handler grid)})\n        server (kit/run-server edge-handler {:ip \"0.0.0.0\" :port (or port 3004)\n                                             :max-body 65536 :legacy-return-value? false})\n        running (atom true)\n        started (System/currentTimeMillis)\n        loop-thread (doto (Thread.\n                            (fn []\n                              (while @running\n                                (try\n                                  (let [now (- (System/currentTimeMillis) started)]\n                                    ((:step! shop) now)\n                                    ((:step! grid) now)\n                                    (grid-effects/effects-step! fx))\n                                  (catch Throwable t\n                                    (binding [*out* *err*] (println \"star-cart tick:\" t))))\n                                (Thread/sleep (long tick-ms)))))\n                      (.setDaemon true)\n                      (.start))]\n    {:port (kit/server-port server)\n     :store st :shop shop :grid grid :effects fx\n     :stop! (fn []\n              (reset! running false)\n              (.join ^Thread loop-thread 2000)\n              ((:stop! shop))\n              ((:stop! grid))\n              (kit/server-stop! server {:timeout 100}))}))\n\n\n(defn -main\n  [& _]\n  (let [port (Long/parseLong (or (System/getenv \"PORT\") \"3004\"))\n        site (start! {:port port\n                      :catalog-path (System/getenv \"CATALOG_PATH\")\n                      :asset-root (or (System/getenv \"ASSET_ROOT\") default-asset-root)})]\n    (println \"dao.star cart on port\" (:port site))\n    (.join (Thread/currentThread))))\n(ns dao.star-cart.store\n  \"The mutable catalog db: an atom holding the accumulated datom vector.  Boot\n   loads `catalog.edn` through `transact/prepare-tx` (schema block first); an\n   edit runs `prepare-tx` inside a `swap!`, so concurrent editors cannot lose\n   each other's updates.  Every save snapshots the catalog back to its file as\n   plain item maps (temp file + atomic rename).  A path that cannot be written\n   logs and the store carries on in memory.\"\n  (:require [clojure.edn :as edn]\n            [clojure.java.io :as io]\n            [dao.space.transact :as transact]\n            [dao.star-cart.catalog :as catalog])\n  (:import [java.nio.file Files StandardCopyOption Paths]))\n\n\n(defn- log\n  [& xs]\n  (binding [*out* *err*] (println (apply str \"star-cart: \" xs))))\n\n\n(defn read-catalog\n  \"The catalog file: `{:store/name .. :items [item-map ...]}`.\"\n  [path]\n  (edn/read-string (slurp path)))\n\n\n(defn- boot-datoms\n  [item-maps]\n  (:datoms (transact/prepare-tx\n             {:base-datoms []\n              :tx-data (into catalog/schema-tx (catalog/items->tx item-maps))})))\n\n\n(defn write-atomically!\n  \"Write `content` to `path` through a sibling temp file and an atomic rename.\n   The old file is untouched if the write fails before the rename.\"\n  [path content]\n  (let [target (Paths/get path (make-array String 0))\n        dir (or (.getParent target) (Paths/get \".\" (make-array String 0)))\n        tmp (Files/createTempFile dir \"catalog\" \".tmp\" (make-array java.nio.file.attribute.FileAttribute 0))]\n    (try\n      (spit (.toFile tmp) content)\n      (Files/move tmp target (into-array java.nio.file.CopyOption\n                                         [StandardCopyOption/ATOMIC_MOVE StandardCopyOption/REPLACE_EXISTING]))\n      (catch Throwable t\n        (Files/deleteIfExists tmp)\n        (throw t)))))\n\n\n(defn open\n  \"Open the store.  `path` is where saves go (the seed is copied there on first\n   boot when the path is empty and writable), `seed` the baked catalog file.\n   `:write-fn` (default `write-atomically!`) is injectable for tests.\"\n  [{:keys [path seed write-fn] :or {write-fn write-atomically!}}]\n  (let [source (cond (and path (.exists (io/file path))) path\n                     :else seed)\n        data (read-catalog source)\n        store {:path path :write-fn write-fn :store-name (:store/name data)\n               :datoms (atom (boot-datoms (:items data)))\n               :cache (atom nil)}]\n    (when (and path (not= source path))\n      (try (write-fn path (slurp seed))\n           (catch Throwable t (log \"cannot seed \" path \": \" (.getMessage t) \"; continuing in memory\"))))\n    store))\n\n\n(defn db\n  [store]\n  (catalog/db @(:datoms store)))\n\n\n(defn items\n  \"All items, cached per datom value: a read after an edit recomputes once.\"\n  [store]\n  (let [ds @(:datoms store)\n        [cached-ds cached] @(:cache store)]\n    (if (identical? ds cached-ds)\n      cached\n      (let [result (catalog/items (catalog/db ds))]\n        (reset! (:cache store) [ds result])\n        result))))\n\n\n(defn item\n  [store slug]\n  (first (filter #(= slug (:key %)) (items store))))\n\n\n(defn catalog-fns\n  \"The pure view's catalog: `:items` and `:item`, each reading the store fresh.\"\n  [store]\n  {:items (fn [] (items store))\n   :item (fn [slug] (item store slug))})\n\n\n(defn snapshot!\n  \"Rewrite the catalog file from a fresh query.  Failure logs and is swallowed:\n   the edit stands in memory.\"\n  [store]\n  (when-let [path (:path store)]\n    (try\n      ((:write-fn store) path\n       (pr-str {:store/name (:store-name store)\n                :items (catalog/item-maps (db store))}))\n      true\n      (catch Throwable t\n        (log \"cannot save \" path \": \" (.getMessage t) \"; continuing in memory\")\n        false))))\n\n\n(defn transact-edit!\n  \"Apply an edit.  `tx-fn` receives the current db value and answers tx-data (or\n   throws, aborting the swap).  `prepare-tx` runs inside the `swap!`.  On\n   success the snapshot is saved and the new datom vector answered.\"\n  [store tx-fn]\n  (let [new-ds (swap! (:datoms store)\n                      (fn [ds]\n                        (let [tx-data (tx-fn (catalog/db ds))]\n                          (if (empty? tx-data)\n                            ds\n                            (into ds (:datoms (transact/prepare-tx\n                                                {:base-datoms ds :tx-data tx-data})))))))]\n    (snapshot! store)\n    new-ds))\n","exit_code":0,"status":"completed"}}
