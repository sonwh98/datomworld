{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/star_cart/catalog_test.clj && nl -ba test/dao/star_cart/view_test.clj'","aggregated_output":"     1\t(ns dao.star-cart.catalog-test\n     2\t  \"The catalog through dao.space: reads by q + collect, the checked-in seed,\n     3\t   edits with validation, tagory and image add/remove, persistence, atomic\n     4\t   write, concurrent saves.\"\n     5\t  (:require [clojure.java.io :as io]\n     6\t            [clojure.test :refer [deftest is testing]]\n     7\t            [dao.space.query :as query]\n     8\t            [dao.space.transact :as transact]\n     9\t            [dao.star-cart.catalog :as catalog]\n    10\t            [dao.star-cart.grid-effects :as fx]\n    11\t            [dao.star-cart.store :as store]\n    12\t            [dao.star-cart.support :as sup]))\n    13\t\n    14\t\n    15\t(def seed \"resources/dao_star_cart/catalog.edn\")\n    16\t(def asset-root \"resources/dao_star_cart/public\")\n    17\t\n    18\t\n    19\t(def three\n    20\t  [{:item/slug \"a\" :item/name \"Alpha\" :item/price 100 :item/description \"first\"\n    21\t    :item/images [{:image/url \"/images/7..png\"} {:image/url \"/images/8..png\"}]\n    22\t    :item/tagories [{:tagory/name \"one\"} {:tagory/name \"two\"}]}\n    23\t   {:item/slug \"b\" :item/name \"Bravo\" :item/price 250\n    24\t    :item/images [{:image/url \"/images/36.png\"}] :item/tagories [{:tagory/name \"two\"}]}\n    25\t   {:item/slug \"c\" :item/name \"Charlie\" :item/price 300\n    26\t    :item/images [{:image/url \"/images/37.png\"}] :item/tagories []}])\n    27\t\n    28\t\n    29\t(defn- fixture-store\n    30\t  ([] (fixture-store {}))\n    31\t  ([opts]\n    32\t   (let [dir (sup/temp-dir)\n    33\t         path (str (io/file dir \"catalog.edn\"))]\n    34\t     (spit path (pr-str {:store/name \"T\" :items three}))\n    35\t     (assoc (store/open (merge {:path path :seed path} opts)) :test-path path))))\n    36\t\n    37\t\n    38\t(deftest catalog-reads-go-through-q-and-collect\n    39\t  (let [ds (:datoms (transact/prepare-tx {:base-datoms []\n    40\t                                          :tx-data (into catalog/schema-tx (catalog/items->tx three))}))\n    41\t        calls (atom 0)\n    42\t        real-q query/q\n    43\t        real-collect query/collect\n    44\t        collects (atom 0)]\n    45\t    (with-redefs [query/q (fn [& a] (swap! calls inc) (apply real-q a))\n    46\t                  query/collect (fn [r] (swap! collects inc) (real-collect r))]\n    47\t      (let [items (catalog/items (catalog/db ds))]\n    48\t        (is (= [\"Alpha\" \"Bravo\" \"Charlie\"] (map :name items)))\n    49\t        (is (= [\"/images/7..png\" \"/images/8..png\"] (:images (first items))))\n    50\t        (is (= [\"one\" \"two\"] (:tagories (first items))))\n    51\t        (is (pos? @calls))\n    52\t        (is (= @calls @collects) \"every q result is collected\")))))\n    53\t\n    54\t\n    55\t(deftest the-checked-in-seed-boots\n    56\t  (let [data (store/read-catalog seed)\n    57\t        st (store/open {:seed seed})\n    58\t        items (store/items st)\n    59\t        named (remove #(sup/blank? (:name %)) items)]\n    60\t    (is (= 249 (count (:items data))))\n    61\t    (is (= 249 (count items)))\n    62\t    (is (= 2 (- (count items) (count named))) \"two empty placeholders sit in the source data\")\n    63\t    (is (= 247 (count named)))\n    64\t    (is (every? #(and (integer? (:price %)) (seq (:images %))) named))\n    65\t    (is (every? #(.isFile (io/file asset-root (subs (first (:images %)) 1))) (take 20 named))\n    66\t        \"image urls name files on disk\")))\n    67\t\n    68\t\n    69\t(defn- apply! [st slug changes] (fx/apply-edit! st asset-root {:item slug :changes changes}))\n    70\t\n    71\t\n    72\t(deftest edits-transact-and-queries-see-them\n    73\t  (let [st (fixture-store)]\n    74\t    (is (= {:saved \"a\"} (apply! st \"a\" {:name \" Alpha 2 \" :price \"199\" :description \"new\"})))\n    75\t    (let [a (store/item st \"a\")]\n    76\t      (is (= \"Alpha 2\" (:name a)))\n    77\t      (is (= 199 (:price a)))\n    78\t      (is (= \"new\" (:description a))))))\n    79\t\n    80\t\n    81\t(deftest tagory-add-and-remove\n    82\t  (let [st (fixture-store)\n    83\t        with (fn [n] (catalog/items-with-tagory (store/db st) n))]\n    84\t    (is (= #{\"a\" \"b\"} (with \"two\")) \"a multi-tagory item and a shared tagory\")\n    85\t    (is (= {:saved \"c\"} (apply! st \"c\" {:add-tagory \"fresh\"})))\n    86\t    (is (= #{\"c\"} (with \"fresh\")))\n    87\t    (is (= {:saved \"c\"} (apply! st \"c\" {:add-tagory \"two\"})))\n    88\t    (is (= #{\"a\" \"b\" \"c\"} (with \"two\")))\n    89\t    (is (= {:saved \"a\"} (apply! st \"a\" {:remove-tagory \"two\"})))\n    90\t    (is (= #{\"b\" \"c\"} (with \"two\")))\n    91\t    (is (= [\"one\"] (:tagories (store/item st \"a\"))))\n    92\t    (is (= {:rejected \"tagory is not on the item\"} (apply! st \"a\" {:remove-tagory \"two\"})))))\n    93\t\n    94\t\n    95\t(deftest image-add-and-remove\n    96\t  (let [st (fixture-store)]\n    97\t    (is (= {:saved \"b\"} (apply! st \"b\" {:add-image \"/images/7..png\"})))\n    98\t    (is (= [\"/images/36.png\" \"/images/7..png\"] (:images (store/item st \"b\"))))\n    99\t    (is (= {:saved \"b\"} (apply! st \"b\" {:remove-image \"/images/36.png\"})))\n   100\t    (is (= [\"/images/7..png\"] (:images (store/item st \"b\"))))\n   101\t    (testing \"the other item sharing no entity is untouched\"\n   102\t      (is (= [\"/images/7..png\" \"/images/8..png\"] (:images (store/item st \"a\")))))))\n   103\t\n   104\t\n   105\t(deftest validation-rejects-and-leaves-the-db-unchanged\n   106\t  (let [st (fixture-store)\n   107\t        before @(:datoms st)]\n   108\t    (doseq [[label changes]\n   109\t            {\"negative price\" {:price -5}\n   110\t             \"fractional price\" {:price \"1.5\"}\n   111\t             \"huge price\" {:price 1000000000000}\n   112\t             \"empty name\" {:name \"   \"}\n   113\t             \"oversized name\" {:name (apply str (repeat 201 \"x\"))}\n   114\t             \"oversized description\" {:description (apply str (repeat 2001 \"x\"))}\n   115\t             \"image outside /images/\" {:add-image \"/etc/passwd\"}\n   116\t             \"image traversal\" {:add-image \"/images/../catalog.edn\"}\n   117\t             \"image not on disk\" {:add-image \"/images/nope.png\"}\n   118\t             \"image not an image path\" {:add-image \"http://example.com/x.png\"}\n   119\t             \"empty tagory\" {:add-tagory \"\"}\n   120\t             \"oversized tagory\" {:add-tagory (apply str (repeat 81 \"t\"))}}]\n   121\t      (let [r (apply! st \"a\" changes)]\n   122\t        (is (contains? r :rejected) label)))\n   123\t    (is (contains? (fx/apply-edit! st asset-root {:item \"zzz\" :changes {:price 1}}) :rejected))\n   124\t    (is (identical? before @(:datoms st)) \"nothing was transacted\")))\n   125\t\n   126\t\n   127\t(deftest persistence-round-trips-through-the-written-file\n   128\t  (let [st (fixture-store)]\n   129\t    (apply! st \"a\" {:price 777})\n   130\t    (apply! st \"a\" {:add-tagory \"persisted\"})\n   131\t    (let [written (store/read-catalog (:test-path st))\n   132\t          fresh (store/open {:seed (:test-path st)})]\n   133\t      (is (= 3 (count (:items written))))\n   134\t      (is (= 777 (:item/price (first (filter #(= \"a\" (:item/slug %)) (:items written))))))\n   135\t      (is (= (store/items st) (store/items fresh)) \"a fresh store sees the edit\")\n   136\t      (is (= (catalog/item-maps (store/db st)) (:items written)) \"the file is the item maps\"))))\n   137\t\n   138\t\n   139\t(deftest a-failed-write-leaves-the-old-file-intact\n   140\t  (let [st (fixture-store)\n   141\t        old (slurp (:test-path st))\n   142\t        failing (assoc st :write-fn (fn [_ _] (throw (ex-info \"disk full\" {}))))]\n   143\t    (is (map? (apply! failing \"a\" {:price 5})) \"the edit itself stands in memory\")\n   144\t    (is (= 5 (:price (store/item failing \"a\"))))\n   145\t    (testing \"the real writer never exposes a partial file\"\n   146\t      (let [target (str (:test-path st) \".x\")]\n   147\t        (spit target \"OLD\")\n   148\t        (is (thrown? Exception (with-redefs [spit (fn [& _] (throw (java.io.IOException. \"boom\")))]\n   149\t                                 (store/write-atomically! target \"NEW\"))))\n   150\t        (is (= \"OLD\" (slurp target)))))\n   151\t    (is (= old (slurp (:test-path st))) \"the failing writer was injected, the file untouched\")))\n   152\t\n   153\t\n   154\t(deftest an-unwritable-path-logs-and-the-store-keeps-working\n   155\t  (let [st (store/open {:path \"/nonexistent-dir/catalog.edn\" :seed seed\n   156\t                        :write-fn store/write-atomically!})]\n   157\t    (is (= 249 (count (store/items st))))\n   158\t    (is (= {:saved \"p4-pro-game-console\"}\n   159\t           (fx/apply-edit! st asset-root {:item \"p4-pro-game-console\" :changes {:price 1}})))\n   160\t    (is (= 1 (:price (store/item st \"p4-pro-game-console\"))))))\n   161\t\n   162\t\n   163\t(deftest concurrent-saves-both-survive\n   164\t  (dotimes [_ 20]\n   165\t    (let [st (fixture-store)\n   166\t          go (java.util.concurrent.CountDownLatch. 1)\n   167\t          t (fn [slug price]\n   168\t              (doto (Thread. (fn [] (.await go) (apply! st slug {:price price}))) (.start)))\n   169\t          ts [(t \"a\" 11) (t \"b\" 22) (t \"c\" 33)]]\n   170\t      (.countDown go)\n   171\t      (doseq [^Thread x ts] (.join x 5000))\n   172\t      (is (= [11 22 33] (mapv #(:price (store/item st %)) [\"a\" \"b\" \"c\"]))))))\n     1\t(ns dao.star-cart.view-test\n     2\t  (:require [clojure.string :as str]\n     3\t            [clojure.test :refer [deftest is testing]]\n     4\t            [dao.star-cart.grid-view :as grid-view]\n     5\t            [dao.star-cart.view :as v]))\n     6\t\n     7\t\n     8\t(def items\n     9\t  [{:key \"a\" :name \"Alpha <b>\" :price 2400 :description \"d\" :images [\"/images/a b.png\"] :tagories [\"t\"]}\n    10\t   {:key \"b\" :name \"Bravo\" :price 5 :description \"\" :images [] :tagories []}])\n    11\t\n    12\t\n    13\t(def catalog\n    14\t  {:items (fn [] items)\n    15\t   :item (fn [slug] (first (filter #(= slug (:key %)) items)))})\n    16\t\n    17\t\n    18\t(deftest datastar-sse-bytes-match-the-pinned-vocabulary\n    19\t  (is (= \"1.0.0-RC.7\" v/datastar-version))\n    20\t  (is (= \"event: datastar-patch-elements\\ndata: elements <div id=\\\"app\\\">x</div>\\n\\n\"\n    21\t         (v/sse-elements \"<div id=\\\"app\\\">x</div>\")))\n    22\t  (is (= \"event: datastar-patch-elements\\ndata: elements <p>a</p> <p>b</p>\\n\\n\"\n    23\t         (v/sse-elements \"<p>a</p>\\n<p>b</p>\"))\n    24\t      \"a newline never ends a data line\")\n    25\t  (is (= \"event: datastar-patch-signals\\ndata: signals {\\\"act\\\":\\\"\\\"}\\n\\n\"\n    26\t         (v/sse-signals \"{\\\"act\\\":\\\"\\\"}\"))))\n    27\t\n    28\t\n    29\t(deftest money-is-minor-units\n    30\t  (is (= \"$24.00\" (v/money 2400)))\n    31\t  (is (= \"$0.05\" (v/money 5)))\n    32\t  (is (= \"$0.00\" (v/money nil))))\n    33\t\n    34\t\n    35\t(deftest the-begin-page-is-a-complete-document\n    36\t  (let [page (v/shop-begin \"ROOT\")]\n    37\t    (is (str/starts-with? page \"<!doctype html>\"))\n    38\t    (is (str/includes? page \"src=\\\"/js/datastar.js\\\"\"))\n    39\t    (is (str/includes? page \"href=\\\"/css/cart.css\\\"\"))\n    40\t    (is (str/includes? page \"data-init=\\\"@get('/s/ROOT')\\\"\"))\n    41\t    (is (str/includes? (grid-view/grid-begin \"ROOT\") \"data-init=\\\"@get('/grid/s/ROOT')\\\"\"))))\n    42\t\n    43\t\n    44\t(deftest the-shop-projects-catalog-detail-and-cart\n    45\t  (testing \"catalog: escaped names, encoded image urls, blank-name items hidden\"\n    46\t    (let [sse (v/shop-project catalog \"TOK\" {:page \"catalog\" :cart {}})]\n    47\t      (is (str/starts-with? sse \"event: datastar-patch-elements\\ndata: elements <div id=\\\"app\\\">\"))\n    48\t      (is (str/ends-with? sse \"\\n\\n\"))\n    49\t      (is (str/includes? sse \"Alpha &lt;b&gt;\"))\n    50\t      (is (str/includes? sse \"<img src=\\\"/images/a%20b.png\\\"\"))\n    51\t      (is (str/includes? sse \"@post('/k/TOK')\"))\n    52\t      (is (str/includes? sse \"Catalog as of last page load.\"))))\n    53\t  (testing \"cart: names, unit prices, quantities and a computed total; zero lines dropped\"\n    54\t    (let [sse (v/shop-project catalog \"TOK\" {:page \"cart\" :cart {\"a\" 2 \"b\" 3 \"gone\" 4 \"x\" 0}})]\n    55\t      (is (str/includes? sse \"Alpha &lt;b&gt;\"))\n    56\t      (is (str/includes? sse \"$24.00\"))\n    57\t      (is (str/includes? sse \"<span class=\\\"qty\\\">2</span>\"))\n    58\t      (is (str/includes? sse \"Total: <strong>$48.15</strong>\") \"2*2400 + 3*5\")\n    59\t      (is (str/includes? sse \"Cart (9)\")))))\n    60\t\n    61\t\n    62\t(deftest every-grid-action-carries-the-grid-prefix\n    63\t  (doseq [model [{:sel nil :status \"\" :msg \"\"}\n    64\t                 {:sel \"a\" :status \"saving\" :msg \"\"}\n    65\t                 {:sel \"a\" :status \"rejected\" :msg \"bad <price>\"}]]\n    66\t    (let [sse (grid-view/grid-project catalog \"TOK\" model)\n    67\t          urls (map second (re-seq #\"@(?:get|post)\\('([^']+)'\\)\" sse))]\n    68\t      (is (seq urls))\n    69\t      (is (every? #(str/starts-with? % \"/grid/\") urls) (pr-str urls))\n    70\t      (is (not (str/includes? sse \"bad <price>\")) \"escaped\"))))\n","exit_code":0,"status":"completed"}}
