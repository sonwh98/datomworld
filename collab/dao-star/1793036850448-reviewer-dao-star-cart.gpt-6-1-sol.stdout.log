{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/clj/dao/star_cart/assemble.clj && nl -ba src/clj/dao/star_cart/catalog.clj && nl -ba src/cljc/dao/star_cart/grid_program.cljc && nl -ba src/cljc/dao/star_cart/program.cljc'","aggregated_output":"     1\t(ns dao.star-cart.assemble\n     2\t  \"The one composition function.  `assemble` wires an HTTP boundary, the\n     3\t   exchange and lineage judges, the router, the driver, every medium and the\n     4\t   tick streams for one app; the shop and the grid are two calls with different\n     5\t   programs, projections and begin pages.  Session facts are a complete-history\n     6\t   memory log; subscription exchanges carry the required `:dao.lease/max`; the\n     7\t   renewal intervals come from `lease/renewal-interval`, never by hand.\"\n     8\t  (:require [dao.lease :as dl]\n     9\t            [dao.star.driver :as driver]\n    10\t            [dao.star.lease :as lease]\n    11\t            [dao.star.router :as router]\n    12\t            [dao.stream :as stream]\n    13\t            [dao.stream.http :as http]\n    14\t            [dao.stream.http.jvm :as jvm]\n    15\t            [dao.stream.memory-log :as memory-log]\n    16\t            [dao.stream.ringbuffer :as ring]))\n    17\t\n    18\t\n    19\t(def units {:ms 1})\n    20\t\n    21\t\n    22\t(def default-timing\n    23\t  \"Durations and the tick period, in milliseconds.  Each renewal interval is\n    24\t   sized against its duration and the tick period by `lease/renewal-interval`.\"\n    25\t  {:tick-ms 50\n    26\t   :exchange-duration 60000\n    27\t   :exchange-renew 20000\n    28\t   :lineage-duration 1800000\n    29\t   :lineage-renew 600000\n    30\t   :subscription-max 3600000})\n    31\t\n    32\t\n    33\t(defn- ring!\n    34\t  [capacity]\n    35\t  (:dao.stream/handle (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n    36\t                                     :dao.stream.ringbuffer/capacity capacity})))\n    37\t\n    38\t\n    39\t(defn- log!\n    40\t  []\n    41\t  (:dao.stream/handle (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n    42\t\n    43\t\n    44\t(defn assemble\n    45\t  \"Wire one app.  Config: `:program`, `:project-fn` `(fn [occurrence model])`,\n    46\t   `:begin-fn` `(fn [root])`, and optional `:timing` merged over\n    47\t   `default-timing`.  Answers\n    48\t     {:handler   the ring handler for this app's boundary\n    49\t      :boundary  the boundary\n    50\t      :driver :router\n    51\t      :step!     (fn [now-ms]) one pass of every stepped part, ticks included\n    52\t      :stop!     (fn [])}\"\n    53\t  [{:keys [program project-fn begin-fn timing]}]\n    54\t  (let [{:keys [tick-ms exchange-duration exchange-renew lineage-duration\n    55\t                lineage-renew subscription-max]} (merge default-timing timing)\n    56\t        period {:ms tick-ms}\n    57\t        ex-dur {:ms exchange-duration}\n    58\t        lin-dur {:ms lineage-duration}\n    59\t        ex-interval (dl/renewal-interval units ex-dur {:ms exchange-renew} period)\n    60\t        lin-interval (dl/renewal-interval units lin-dur {:ms lineage-renew} period)\n    61\t        ingress (ring! 1024)\n    62\t        egress (ring! 4096)\n    63\t        facts (log!)\n    64\t        lineage-lease (ring! 1024)\n    65\t        exchange-lease (ring! 1024)\n    66\t        begin (ring! 256)\n    67\t        ticks {:driver (ring! 1024) :exchange (ring! 1024) :lineage (ring! 1024)}\n    68\t        boundary (http/make-boundary\n    69\t                   {:ingress {:dao.stream/handle ingress :dao.stream/surface #{:writer}}\n    70\t                    :ingress-admission {:retention :evict-oldest :capacity 1024\n    71\t                                        :value-domain :portable-values\n    72\t                                        :lifetime :outlives-boundary}\n    73\t                    :egress {:dao.stream/handle egress :dao.stream/surface #{:reader}}\n    74\t                    :http/max-open 256 :http/max-body-bytes 65536})\n    75\t        decl (lease/facts-declaration)\n    76\t        drv (driver/make-driver\n    77\t              {:facts facts :egress egress :begin begin :tick (:driver ticks)\n    78\t               :lineage-lease lineage-lease :exchange-lease exchange-lease\n    79\t               :program program :project-fn project-fn :begin-fn begin-fn\n    80\t               :units units :lineage-renewal-interval lin-interval\n    81\t               :exchange-renewal-interval ex-interval\n    82\t               :session-capacity 256 :lease-capacity 1024 :facts-declaration decl})\n    83\t        xl (lease/make-exchange-lease\n    84\t             {:ingress ingress :egress egress :lease-medium exchange-lease\n    85\t              :tick (:exchange ticks)\n    86\t              :open-exchanges #(http/open-exchanges boundary)\n    87\t              :close-exchange #(http/close-exchange boundary %)\n    88\t              :units units :duration ex-dur :cadence period :tolerance {:ms 0}\n    89\t              :capacity 4096 :subscription-max {:ms subscription-max}})\n    90\t        ll (lease/make-lineage-lease\n    91\t             {:facts facts :lease-medium lineage-lease :tick (:lineage ticks)\n    92\t              :retire! #(driver/retire! drv %) :units units :duration lin-dur\n    93\t              :cadence period :tolerance {:ms 0} :facts-declaration decl})\n    94\t        rt (router/make-router\n    95\t             {:ingress ingress :facts facts :lease lineage-lease :begin begin\n    96\t              :co-located? true :facts-declaration decl\n    97\t              :session-medium #(driver/session-medium drv %)})]\n    98\t    {:handler (jvm/handler boundary)\n    99\t     :boundary boundary\n   100\t     :driver drv\n   101\t     :router rt\n   102\t     :ticks ticks\n   103\t     :step! (fn [now-ms]\n   104\t              (doseq [t (vals ticks)]\n   105\t                (stream/append! t (dl/tick {:ms (max 1 now-ms)})))\n   106\t              (lease/exchange-lease-step! xl)\n   107\t              (lease/lineage-lease-step! ll)\n   108\t              (router/router-step! rt)\n   109\t              (driver/driver-step! drv)\n   110\t              (http/egress-step boundary))\n   111\t     :stop! (fn [] (http/stop! boundary))}))\n     1\t(ns dao.star-cart.catalog\n     2\t  \"Catalog reads and the catalog's datom shape.  Every read is\n     3\t   `dao.space.query/q` + `collect` over a db value (a `current` view over a\n     4\t   `relation`); nothing here touches a store or an atom.\"\n     5\t  (:require [clojure.string :as str]\n     6\t            [dao.space.query :as query]))\n     7\t\n     8\t\n     9\t(def schema-tx\n    10\t  \"Schema first: images and tagories are many-valued refs.\"\n    11\t  [{:db/ident :item/images :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}\n    12\t   {:db/ident :item/tagories :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}])\n    13\t\n    14\t\n    15\t(defn db\n    16\t  \"The db value over accumulated datoms.\"\n    17\t  [datoms]\n    18\t  (query/current (query/relation datoms)))\n    19\t\n    20\t\n    21\t(defn- tagory-tid\n    22\t  [name]\n    23\t  (str \"tid_tag_\" (hash name)))\n    24\t\n    25\t\n    26\t(defn items->tx\n    27\t  \"tx-data for plain item maps (the on-disk shape): one entity per item, one\n    28\t   per image, one per distinct tagory name, refs by tempid.\"\n    29\t  [item-maps]\n    30\t  (let [indexed (map-indexed vector item-maps)\n    31\t        tagories (distinct (for [[_ m] indexed t (:item/tagories m)] (:tagory/name t)))]\n    32\t    (vec\n    33\t      (concat\n    34\t        (for [n tagories] {:db/id (tagory-tid n) :tagory/name n})\n    35\t        (mapcat\n    36\t          (fn [[i m]]\n    37\t            (let [img-tids (map-indexed (fn [j _] (str \"tid_img_\" i \"_\" j)) (:item/images m))]\n    38\t              (concat\n    39\t                (map (fn [tid img] {:db/id tid :image/url (:image/url img)}) img-tids (:item/images m))\n    40\t                [(cond-> {:db/id (str \"tid_item_\" i)\n    41\t                          :item/slug (:item/slug m)\n    42\t                          :item/name (:item/name m)\n    43\t                          :item/price (:item/price m)\n    44\t                          :item/images (vec img-tids)\n    45\t                          :item/tagories (mapv (comp tagory-tid :tagory/name) (:item/tagories m))}\n    46\t                   (:item/description m) (assoc :item/description (:item/description m)))])))\n    47\t          indexed)))))\n    48\t\n    49\t\n    50\t(defn- rows\n    51\t  [db' q-form]\n    52\t  (query/collect (query/q q-form db')))\n    53\t\n    54\t\n    55\t(defn- by-slug\n    56\t  [db' q-form]\n    57\t  (into {} (rows db' q-form)))\n    58\t\n    59\t\n    60\t(defn items\n    61\t  \"Every item as `{:key :name :price :description :images [url] :tagories [name]}`,\n    62\t   sorted by trimmed lower-case name.  Image order is the order they were added.\"\n    63\t  [db']\n    64\t  (let [names (by-slug db' '[:find ?s ?n :where [?e :item/slug ?s] [?e :item/name ?n]])\n    65\t        prices (by-slug db' '[:find ?s ?p :where [?e :item/slug ?s] [?e :item/price ?p]])\n    66\t        descs (by-slug db' '[:find ?s ?d :where [?e :item/slug ?s] [?e :item/description ?d]])\n    67\t        imgs (group-by first\n    68\t                       (sort-by second\n    69\t                                (rows db' '[:find ?s ?i ?u :where [?e :item/slug ?s]\n    70\t                                            [?e :item/images ?i] [?i :image/url ?u]])\n    71\t                                ))\n    72\t        tags (group-by first\n    73\t                       (rows db' '[:find ?s ?n :where [?e :item/slug ?s]\n    74\t                                   [?e :item/tagories ?t] [?t :tagory/name ?n]]))]\n    75\t    (->> names\n    76\t         (map (fn [[slug n]]\n    77\t                {:key slug :name n :price (get prices slug) :description (get descs slug \"\")\n    78\t                 :images (mapv #(nth % 2) (get imgs slug))\n    79\t                 :tagories (vec (sort (map second (get tags slug))))}))\n    80\t         (sort-by #(str/lower-case (str/trim (:name %))))\n    81\t         vec)))\n    82\t\n    83\t\n    84\t(defn item\n    85\t  [db' slug]\n    86\t  (first (filter #(= slug (:key %)) (items db'))))\n    87\t\n    88\t\n    89\t(defn item-eid\n    90\t  \"The entity id of the item with `slug`, or nil.\"\n    91\t  [db' slug]\n    92\t  (ffirst (query/collect (query/q '[:find ?e :in $ ?s :where [?e :item/slug ?s]] db' slug))))\n    93\t\n    94\t\n    95\t(defn image-eid\n    96\t  \"The image entity of `url` on item `slug`, or nil.\"\n    97\t  [db' slug url]\n    98\t  (ffirst (query/collect\n    99\t            (query/q '[:find ?i :in $ ?s ?u :where [?e :item/slug ?s]\n   100\t                       [?e :item/images ?i] [?i :image/url ?u]]\n   101\t                     db' slug url))))\n   102\t\n   103\t\n   104\t(defn tagory-eid\n   105\t  \"The tagory entity named `name`, or nil.\"\n   106\t  [db' name]\n   107\t  (ffirst (query/collect (query/q '[:find ?t :in $ ?n :where [?t :tagory/name ?n]] db' name))))\n   108\t\n   109\t\n   110\t(defn tagory-linked?\n   111\t  [db' slug name]\n   112\t  (boolean (seq (query/collect\n   113\t                  (query/q '[:find ?t :in $ ?s ?n :where [?e :item/slug ?s]\n   114\t                             [?e :item/tagories ?t] [?t :tagory/name ?n]]\n   115\t                           db' slug name)))))\n   116\t\n   117\t\n   118\t(defn items-with-tagory\n   119\t  \"Slugs of the items carrying tagory `name`.\"\n   120\t  [db' name]\n   121\t  (set (map first (query/collect\n   122\t                    (query/q '[:find ?s :in $ ?n :where [?t :tagory/name ?n]\n   123\t                               [?e :item/tagories ?t] [?e :item/slug ?s]]\n   124\t                             db' name)))))\n   125\t\n   126\t\n   127\t(defn item-maps\n   128\t  \"The on-disk shape: plain item maps with nested image and tagory maps.\"\n   129\t  [db']\n   130\t  (mapv (fn [i]\n   131\t          (cond-> {:item/slug (:key i) :item/name (:name i) :item/price (:price i)\n   132\t                   :item/images (mapv (fn [u] {:image/url u}) (:images i))\n   133\t                   :item/tagories (mapv (fn [n] {:tagory/name n}) (:tagories i))}\n   134\t            (seq (:description i)) (assoc :item/description (:description i))))\n   135\t        (items db')))\n     1\t(ns dao.star-cart.grid-program\n     2\t  \"The grid (catalog editor) session program.  Its continuation holds only UI\n     3\t   state: the selected item and the last outcome.  Every mutation is emitted as\n     4\t   data, `{:edit {:item slug :changes {...}}}`, for the host's effects\n     5\t   interpreter to validate and transact; the program never claims success.  It\n     6\t   renders `saving` until a `{:saved slug}` or `{:rejected reason}` input\n     7\t   arrives, which the effects interpreter appends after the transact.\n     8\t\n     9\t   Inputs are `{:signals {...}}` maps: `:act` names the action, `:arg` carries\n    10\t   an item key, image URL or tagory name, and the typed fields arrive as the\n    11\t   `name`, `price`, `desc`, `img` and `tag` signals.\"\n    12\t  (:require [dao.await :as await]))\n    13\t\n    14\t\n    15\t(def grid-forms\n    16\t  '[(let [ic (await/cursor in)]\n    17\t      (do\n    18\t        (def emit (fn [sel status msg edit]\n    19\t                    (await/>! out (assoc (assoc (assoc (assoc {} :sel sel) :status status) :msg msg) :edit edit))))\n    20\t        (def change (fn [sel ch]\n    21\t                      (assoc (assoc {} :item sel) :changes ch)))\n    22\t        (def lp (fn [sel]\n    23\t                  (let [x (await/<! ic)\n    24\t                        s (get x :signals)\n    25\t                        a (get s :act)\n    26\t                        arg (get s :arg)]\n    27\t                    (if (get s :saved)\n    28\t                      (do (emit sel \"saved\" \"\" nil) (lp sel))\n    29\t                      (if (get s :rejected)\n    30\t                        (do (emit sel \"rejected\" (get s :rejected) nil) (lp sel))\n    31\t                        (if (= a \"select\")\n    32\t                          (do (emit arg \"\" \"\" nil) (lp arg))\n    33\t                          (if (= a \"cancel\")\n    34\t                            (do (emit nil \"\" \"\" nil) (lp nil))\n    35\t                            (if (= a \"save\")\n    36\t                              (do (emit sel \"saving\" \"\"\n    37\t                                        (change sel (assoc (assoc (assoc {} :name (get s :name))\n    38\t                                                                  :price (get s :price))\n    39\t                                                           :description (get s :desc))))\n    40\t                                  (lp sel))\n    41\t                              (if (= a \"addimg\")\n    42\t                                (do (emit sel \"saving\" \"\" (change sel (assoc {} :add-image (get s :img))))\n    43\t                                    (lp sel))\n    44\t                                (if (= a \"rmimg\")\n    45\t                                  (do (emit sel \"saving\" \"\" (change sel (assoc {} :remove-image arg)))\n    46\t                                      (lp sel))\n    47\t                                  (if (= a \"addtag\")\n    48\t                                    (do (emit sel \"saving\" \"\" (change sel (assoc {} :add-tagory (get s :tag))))\n    49\t                                        (lp sel))\n    50\t                                    (if (= a \"rmtag\")\n    51\t                                      (do (emit sel \"saving\" \"\" (change sel (assoc {} :remove-tagory arg)))\n    52\t                                          (lp sel))\n    53\t                                      (do (emit sel \"\" \"\" nil) (lp sel))))))))))))))\n    54\t        (emit nil \"\" \"\" nil)\n    55\t        (lp nil)))])\n    56\t\n    57\t\n    58\t(def grid-program\n    59\t  (await/go* grid-forms {}))\n     1\t(ns dao.star-cart.program\n     2\t  \"The shop's session program: pure sequential logic on yin.vm.  It reads\n     3\t   inputs from `in` with `<!` (each `{:signals {:act .. :arg ..}}`), holds the\n     4\t   page, item and cart as locals of its loop, and emits a model on `out` with\n     5\t   `>!`.  It never queries the catalog and never touches egress: the driver\n     6\t   projects, so the cart lives exactly as long as the lineage.\n     7\t\n     8\t   The cart is a map slug -> quantity.  The VM's vocabulary has no `dissoc`,\n     9\t   so a removal decrements and the projection ignores quantities <= 0.\"\n    10\t  (:require [dao.await :as await]))\n    11\t\n    12\t\n    13\t(def shop-forms\n    14\t  '[(let [ic (await/cursor in)]\n    15\t      (do\n    16\t        (def emit (fn [page item cart]\n    17\t                    (await/>! out (assoc (assoc (assoc {} :page page) :item item) :cart cart))))\n    18\t        (def lp (fn [page item cart]\n    19\t                  (let [x (await/<! ic)\n    20\t                        s (get x :signals)\n    21\t                        a (get s :act)\n    22\t                        arg (get s :arg)]\n    23\t                    (if (= a \"nav\")\n    24\t                      (do (emit arg nil cart) (lp arg nil cart))\n    25\t                      (if (= a \"item\")\n    26\t                        (do (emit \"item\" arg cart) (lp \"item\" arg cart))\n    27\t                        (if (= a \"add\")\n    28\t                          (let [c (assoc cart arg (+ 1 (get cart arg 0)))]\n    29\t                            (do (emit page item c) (lp page item c)))\n    30\t                          (if (= a \"remove\")\n    31\t                            (let [c (assoc cart arg (- (get cart arg 0) 1))]\n    32\t                              (do (emit page item c) (lp page item c)))\n    33\t                            (if (= a \"checkout\")\n    34\t                              (do (emit \"checkout\" nil {}) (lp \"checkout\" nil {}))\n    35\t                              (do (emit page item cart) (lp page item cart))))))))))\n    36\t        (emit \"catalog\" nil {})\n    37\t        (lp \"catalog\" nil {})))])\n    38\t\n    39\t\n    40\t(def shop-program\n    41\t  (await/go* shop-forms {}))\n","exit_code":0,"status":"completed"}}
