{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/star/router.cljc && nl -ba src/cljc/dao/star/signals.cljc'","aggregated_output":"     1\t(ns dao.star.router\n     2\t  \"The dao.star Mode 1 router (docs/design/dao.star.md, Routing and Sessions\n     3\t   and request kinds).\n     4\t\n     5\t   A stepped interpreter: each pass reads the ingress with its own cursor to\n     6\t   `blocked`, then drains the session-facts and lineage-lease cursors to\n     7\t   `blocked` folding them into the index, and only then classifies what the\n     8\t   ingress gave it.  Unknown is judged after both drains, never before, which\n     9\t   is what makes a just-published token impossible to answer as begin.\n    10\t\n    11\t   The router holds no token table of its own: the index is derived from the\n    12\t   two media it reads, and it forwards a request to the medium of the session\n    13\t   its token names, with every later terminal event of that exchange.  The\n    14\t   boundary never routes, and a gap forwards nothing.\"\n    15\t  (:require [dao.star.facts :as facts]\n    16\t            [dao.star.lease :as lease]\n    17\t            [dao.stream :as stream]\n    18\t            #?(:clj [dao.stream.remote]))\n    19\t  #?(:clj (:import [dao.stream.remote ReflectionHandle])))\n    20\t\n    21\t\n    22\t(defn- reflection?\n    23\t  [handle]\n    24\t  #?(:clj (instance? ReflectionHandle handle)\n    25\t     :default (and false handle)))\n    26\t\n    27\t\n    28\t(defn classify\n    29\t  \"Pure: the kind of request `(method, path)` under `index`.\n    30\t     {:kind :begin}                         `/`, or a token of an ended or\n    31\t                                            unknown lineage\n    32\t     {:kind :subscribe :lineage S}          `/s/<token>`, token live\n    33\t     {:kind :input :lineage S :token t}     `/k/<token>`, token current\n    34\t     {:kind :stale :lineage S :token t}     `/k/<token>`, token consumed\n    35\t     {:kind :unrouted}                      any other path\"\n    36\t  [index path]\n    37\t  (let [[_ head token] (re-matches #\"/(s|k)/([^/]+)\" (str path))\n    38\t        tok (when head (facts/resolve-token index token))]\n    39\t    (cond\n    40\t      (= \"/\" path) {:kind :begin}\n    41\t      (nil? head) {:kind :unrouted}\n    42\t      (contains? #{:ended :unknown} (:kind tok)) {:kind :begin}\n    43\t      (= \"s\" head) {:kind :subscribe :lineage (:lineage tok) :token token}\n    44\t      (= :current (:kind tok)) {:kind :input :lineage (:lineage tok) :token token}\n    45\t      :else {:kind :stale :lineage (:lineage tok) :token token})))\n    46\t\n    47\t\n    48\t(defn make-router\n    49\t  \"Assemble the router.  Config:\n    50\t     :ingress        the boundary's ingress medium (may be a reflection)\n    51\t     :facts          the session-facts medium, a direct handle\n    52\t     :lease          the lineage-lease medium, a direct handle\n    53\t     :begin          the begin handler's medium (handle)\n    54\t     :session-medium (fn [lineage] -> handle or nil)\n    55\t     :facts-declaration  the facts medium's declaration, `:retention :complete`\n    56\t   The facts and lease handles are classification media: a reflection answers\n    57\t   `blocked` while its request is pending, which says nothing about the source,\n    58\t   so the router refuses at assembly (ex-info `:refused :co-located`) unless\n    59\t   both are direct handles declared `:co-located? true`.\"\n    60\t  [{:keys [ingress facts lease begin session-medium co-located?] :as config}]\n    61\t  (lease/check-facts-declaration! (:facts-declaration config))\n    62\t  (when-not (and co-located?\n    63\t                 (not (reflection? facts))\n    64\t                 (not (reflection? lease)))\n    65\t    (throw (ex-info \"the router reads its classification media directly: declare :co-located? true with direct (non-reflection) handles\"\n    66\t                    {:refused :co-located})))\n    67\t  (when-not (and ingress facts lease begin (fn? session-medium))\n    68\t    (throw (ex-info \"the router needs :ingress :facts :lease :begin :session-medium\"\n    69\t                    {:refused :config :config (dissoc config :ingress :facts :lease :begin)})))\n    70\t  (atom {:config config\n    71\t         :ingress-cursor (lease/oldest-cursor ingress)\n    72\t         :facts-cursor (lease/oldest-cursor facts)\n    73\t         :lease-cursor (lease/oldest-cursor lease)\n    74\t         :index facts/empty-index\n    75\t         :routes {}\n    76\t         :gaps 0}))\n    77\t\n    78\t\n    79\t(defn index\n    80\t  [router]\n    81\t  (:index @router))\n    82\t\n    83\t\n    84\t(defn- forward!\n    85\t  \"Append `message` to `handle`; a non-ok answer is loss, dropped silently.\"\n    86\t  [handle message]\n    87\t  (when handle\n    88\t    (= :dao.stream/ok (:dao.stream/outcome (stream/append! handle message)))))\n    89\t\n    90\t\n    91\t(defn- route!\n    92\t  [router event]\n    93\t  (let [{:keys [config index]} @router\n    94\t        x (:http/exchange event)]\n    95\t    (case (:http/event event)\n    96\t      :http/request\n    97\t      (let [c (classify index (:http/path event))\n    98\t            target (case (:kind c)\n    99\t                     :begin (:begin config)\n   100\t                     :unrouted nil\n   101\t                     ((:session-medium config) (:lineage c)))]\n   102\t        (when (and target\n   103\t                   (forward! target {:exchange x :kind (:kind c) :token (:token c)\n   104\t                                     :lineage (:lineage c) :event event}))\n   105\t          (swap! router assoc-in [:routes x] target)))\n   106\t\n   107\t      (:http/ended :http/closed)\n   108\t      (when-let [target (get-in @router [:routes x])]\n   109\t        (swap! router update :routes dissoc x)\n   110\t        (forward! target {:exchange x :kind :terminal :event event}))\n   111\t\n   112\t      nil)))\n   113\t\n   114\t\n   115\t(defn router-step!\n   116\t  \"One pass, in the spec's order.  Answers the router.\"\n   117\t  [router]\n   118\t  (let [s @router\n   119\t        {:keys [ingress facts lease]} (:config s)\n   120\t        in (lease/drain ingress (:ingress-cursor s))\n   121\t        fs (lease/drain facts (:facts-cursor s))\n   122\t        ls (lease/drain lease (:lease-cursor s))]\n   123\t    (swap! router\n   124\t           (fn [s]\n   125\t             (-> s\n   126\t                 (assoc :ingress-cursor (:cursor in)\n   127\t                        :facts-cursor (:cursor fs)\n   128\t                        :lease-cursor (:cursor ls))\n   129\t                 (update :gaps + (if (:gap? in) 1 0))\n   130\t                 (update :index #(reduce facts/index-step % (:values fs)))\n   131\t                 (update :index #(reduce facts/index-step % (:values ls))))))\n   132\t    (doseq [event (:values in)\n   133\t            :when (map? event)]\n   134\t      (route! router event))\n   135\t    router))\n     1\t(ns dao.star.signals\n     2\t  \"Decode a request's client signals from an `:http/request` event\n     3\t   (docs/design/dao.star.md, Signals).\n     4\t\n     5\t   Signals are the client's unverified claim, so on the JVM and ClojureScript\n     6\t   `decode` is total: a missing, malformed or non-map input answers `{}` and\n     7\t   nothing throws.  (The one exception is the ClojureDart seam, below.)  GET and DELETE\n     8\t   carry them in the query parameter the spec names, every other method in the\n     9\t   JSON body.  The JSON parse is the host's; a host without one decodes\n    10\t   nothing.\n    11\t\n    12\t   Scope: the JSON and URL-decoding seams are implemented for the JVM and\n    13\t   ClojureScript only.  On ClojureDart they are unimplemented, and `decode`\n    14\t   throws `ex-info` naming the seam (`:dao.star.signals/seam`) rather than\n    15\t   answer `{}`, which would be indistinguishable from absent signals.\"\n    16\t  (:require [clojure.string :as str]\n    17\t            [dao.host.bytes :as bytes]\n    18\t            [dao.host.text :as text]\n    19\t            #?(:clj [clojure.data.json :as json])))\n    20\t\n    21\t\n    22\t#_{:clj-kondo/ignore [:unused-private-var]}\n    23\t\n    24\t\n    25\t(defn- unimplemented\n    26\t  [seam]\n    27\t  (throw (ex-info (str \"dao.star.signals: no \" (name seam) \" seam on this host\")\n    28\t                  {:dao.star.signals/seam seam})))\n    29\t\n    30\t\n    31\t(defn- parse-json\n    32\t  [s]\n    33\t  #?(:cljd (unimplemented :json)\n    34\t     :clj (json/read-str s :key-fn keyword)\n    35\t     :cljs (js->clj (js/JSON.parse s) :keywordize-keys true)))\n    36\t\n    37\t\n    38\t(defn- url-decode\n    39\t  [s]\n    40\t  #?(:cljd (unimplemented :url-decode)\n    41\t     :clj (java.net.URLDecoder/decode ^String s \"UTF-8\")\n    42\t     :cljs (js/decodeURIComponent (str/replace s \"+\" \" \"))))\n    43\t\n    44\t\n    45\t(defn- body-text\n    46\t  [body]\n    47\t  (cond (string? body) body\n    48\t        (bytes/bytes? body) (text/utf8-decode body)\n    49\t        :else nil))\n    50\t\n    51\t\n    52\t(defn- query-param\n    53\t  [query k]\n    54\t  (when (string? query)\n    55\t    (some (fn [pair]\n    56\t            (let [[name value] (str/split pair #\"=\" 2)]\n    57\t              (when (= k name) (or value \"\"))))\n    58\t          (str/split query #\"&\"))))\n    59\t\n    60\t\n    61\t(defn decode\n    62\t  \"The signals map of request `event`, or `{}`.\"\n    63\t  [event]\n    64\t  (try\n    65\t    (let [raw (if (contains? #{:get :delete} (:http/method event))\n    66\t                (some-> (query-param (:http/query event) \"datastar\") url-decode)\n    67\t                (body-text (:http/body event)))\n    68\t          parsed (when (and (string? raw) (not (empty? raw))) (parse-json raw))]\n    69\t      (if (map? parsed) parsed {}))\n    70\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n    71\t      (if (:dao.star.signals/seam (ex-data e))\n    72\t        (throw e)\n    73\t        {}))))\n","exit_code":0,"status":"completed"}}
