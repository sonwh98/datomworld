{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/star_cart/app_test.clj && nl -ba test/dao/star_cart/edge_test.clj && cat docker/dao-star-cart/Dockerfile docker/dao-star-cart/deps.edn docker/dao-star-cart/README.md resources/dao_star_cart/README.md && git diff -- .gitignore bb.edn src/clj/dao/stream/http/jvm.clj'","aggregated_output":"     1\t(ns dao.star-cart.app-test\n     2\t  \"The demo end to end on loopback sockets: the shop and the grid on one port,\n     3\t   over the real boundary, leases, router and driver, with the catalog served\n     4\t   from dao.space.\"\n     5\t  (:require [clojure.string :as str]\n     6\t            [clojure.test :refer [deftest is testing use-fixtures]]\n     7\t            [dao.star-cart.edge :as edge]\n     8\t            [dao.star-cart.store :as store]\n     9\t            [dao.star-cart.support :as sup]))\n    10\t\n    11\t\n    12\t(def ^:dynamic *site* nil)\n    13\t\n    14\t\n    15\t(use-fixtures :each\n    16\t  (fn [t]\n    17\t    (let [site (sup/start-site!)]\n    18\t      (try (binding [*site* site] (t))\n    19\t           (finally ((:stop! site)))))))\n    20\t\n    21\t\n    22\t(defn- port [] (:port *site*))\n    23\t(defn- named [] (remove #(sup/blank? (:name %)) (store/items (:store *site*))))\n    24\t\n    25\t\n    26\t(defn- subscribed\n    27\t  \"Begin a lineage, subscribe, and wait for the first projection.  Answers\n    28\t   `{:sse :root :token}`.\"\n    29\t  [prefix]\n    30\t  (let [{:keys [root]} (sup/begin! (port) prefix)\n    31\t        sse (sup/open-sse (port) (str prefix \"/s/\" root))]\n    32\t    (is (sup/wait-for 8000 #(str/includes? @(:text sse) \"datastar-patch-elements\")) \"first projection\")\n    33\t    {:sse sse :root root :token (sup/token-of @(:text sse))}))\n    34\t\n    35\t\n    36\t(defn- sse-text [{:keys [sse]}] @(:text sse))\n    37\t\n    38\t\n    39\t(deftest the-full-page-renders-the-real-catalog-with-real-image-urls\n    40\t  (let [{:keys [page root]} (sup/begin! (port) \"\")\n    41\t        urls (set (map #(:image/url %) (map (fn [i] {:image/url (first (:images i))}) (named))))]\n    42\t    (is (str/starts-with? page \"HTTP/1.1 200\"))\n    43\t    (is (str/includes? page \"<!doctype html>\"))\n    44\t    (is (some? root))\n    45\t    (let [sse (sup/open-sse (port) (str \"/s/\" root))]\n    46\t      (is (sup/wait-for 8000 #(str/includes? @(:text sse) \"Catalog as of last page load.\")))\n    47\t      (let [text @(:text sse)\n    48\t            srcs (map (comp #(java.net.URLDecoder/decode (str/replace % \"+\" \"%2B\") \"UTF-8\") second)\n    49\t                      (re-seq #\"<img src=\\\"(/images/[^\\\"]+)\\\"\" text))]\n    50\t        (is (= 247 (count (named))))\n    51\t        (is (= (count (named)) (count srcs)) \"one image per real item\")\n    52\t        (is (every? urls srcs) \"each src is a catalog :image/url\"))\n    53\t      (sup/close-sse sse))))\n    54\t\n    55\t\n    56\t(deftest the-image-urls-on-the-first-page-resolve\n    57\t  (let [{:keys [sse]} (subscribed \"\")\n    58\t        srcs (distinct (map (comp #(java.net.URLDecoder/decode (str/replace % \"+\" \"%2B\") \"UTF-8\") second)\n    59\t                            (re-seq #\"<img src=\\\"(/images/[^\\\"]+)\\\"\" (sse-text {:sse sse}))))]\n    60\t    (is (seq srcs))\n    61\t    (doseq [u (take 12 srcs)\n    62\t            :let [enc (str/replace u \" \" \"%20\")\n    63\t                  r (sup/http (port) \"GET\" enc)]]\n    64\t      (is (= 200 (:status r)) u)\n    65\t      (is (re-find #\"(?i)content-type: image/\" (:text r)) u)\n    66\t      (is (> (count (:bytes r)) 500) u))\n    67\t    (sup/close-sse sse)))\n    68\t\n    69\t\n    70\t(deftest ^:slow every-image-url-resolves\n    71\t  (let [urls (distinct (mapcat :images (named)))]\n    72\t    (doseq [u urls\n    73\t            :let [r (sup/http (port) \"GET\" (str/replace u \" \" \"%20\"))]]\n    74\t      (is (= 200 (:status r)) u))))\n    75\t\n    76\t\n    77\t(deftest add-to-cart-parks-and-resumes-with-state-intact\n    78\t  (let [[a b] (take 2 (vals (into (sorted-map) (map (juxt (comp str/trim :name) identity)\n    79\t                                                        (filter #(pos? (:price %)) (named))))))\n    80\t        {:keys [sse token]} (subscribed \"\")\n    81\t        add (fn [tok slug] (sup/token-of (sup/input! (port) \"\" tok {:act \"add\" :arg slug})))\n    82\t        t1 (add token (:key a))\n    83\t        t2 (add t1 (:key b))\n    84\t        t3 (add t2 (:key a))]\n    85\t    (is (every? some? [t1 t2 t3]))\n    86\t    (is (= 4 (count (set [token t1 t2 t3]))) \"one successor per consumed input\")\n    87\t    (let [cart (sup/input! (port) \"\" t3 {:act \"nav\" :arg \"cart\"})\n    88\t          qty (fn [name] (second (re-find (re-pattern (str \"<td>\" (java.util.regex.Pattern/quote (str/escape name {\\< \"&lt;\" \\> \"&gt;\" \\& \"&amp;\"})) \"</td>.*?<span class=\\\"qty\\\">(\\\\d+)</span>\")) cart)))]\n    89\t      (is (str/includes? cart \"Cart (3)\"))\n    90\t      (is (str/includes? cart (str/escape (:name a) {\\< \"&lt;\" \\> \"&gt;\" \\& \"&amp;\"})))\n    91\t      (is (= \"2\" (qty (:name a))) \"a third add shows qty 2: the state lives in the continuation\")\n    92\t      (is (str/includes? cart \"Total: <strong>\"))\n    93\t      (let [expected (+ (* 2 (:price a)) (:price b))]\n    94\t        (is (str/includes? cart (str \"Total: <strong>$\" (quot expected 100) \".\" (format \"%02d\" (rem expected 100)) \"</strong>\")))))\n    95\t    (testing \"the open subscription was patched with each state\"\n    96\t      (is (sup/wait-for 5000 #(str/includes? (sse-text {:sse sse}) \"Cart (3)\"))))\n    97\t    (sup/close-sse sse)))\n    98\t\n    99\t\n   100\t(deftest a-stale-token-is-harmless\n   101\t  (let [[a] (named)\n   102\t        {:keys [sse token]} (subscribed \"\")\n   103\t        t1 (sup/token-of (sup/input! (port) \"\" token {:act \"add\" :arg (:key a)}))\n   104\t        stale (sup/input! (port) \"\" token {:act \"add\" :arg (:key a)})]\n   105\t    (is (some? t1))\n   106\t    (is (str/includes? stale \"Cart (1)\") \"the cart did not change\")\n   107\t    (is (not (str/includes? stale \"Cart (2)\")))\n   108\t    (is (= t1 (sup/token-of stale)) \"re-projected at the current occurrence\")\n   109\t    (sup/close-sse sse)))\n   110\t\n   111\t\n   112\t(deftest a-reconnect-re-projects-the-current-cart\n   113\t  (let [[a] (named)\n   114\t        {:keys [sse root token]} (subscribed \"\")\n   115\t        _ (sup/input! (port) \"\" token {:act \"add\" :arg (:key a)})\n   116\t        _ (sup/close-sse sse)\n   117\t        again (sup/open-sse (port) (str \"/s/\" root))]\n   118\t    (is (sup/wait-for 8000 #(str/includes? @(:text again) \"Cart (1)\")) \"subscribe consumes nothing and shows the cart\")\n   119\t    (sup/close-sse again)))\n   120\t\n   121\t\n   122\t(deftest the-grid-lists-the-catalog-and-saves-edits-the-shop-sees-on-navigation\n   123\t  (let [[a] (named)\n   124\t        shop (subscribed \"\")\n   125\t        old-price (str \"$\" (quot (:price a) 100) \".\" (format \"%02d\" (rem (:price a) 100)))\n   126\t        grid (subscribed \"/grid\")]\n   127\t    (testing \"the grid lists every item\"\n   128\t      (is (= 249 (sup/count-matches #\"<li class=\\\"[^\\\"]*\\\"><span class=\\\"nm\\\">\" (sse-text grid)))))\n   129\t    (testing \"select, then save a new price\"\n   130\t      (let [t1 (sup/token-of (sup/input! (port) \"/grid\" (:token grid) {:act \"select\" :arg (:key a)}))\n   131\t            reply (sup/input! (port) \"/grid\" t1 {:act \"save\" :name (:name a) :price \"4242\" :desc \"edited\"})]\n   132\t        (is (some? t1))\n   133\t        (is (str/includes? reply \"saving\") \"the program renders saving first\")\n   134\t        (is (sup/wait-for 8000 #(str/includes? (sse-text grid) \"class=\\\"status saved\\\"\")) \"then saved, after the transact\")\n   135\t        (is (= 4242 (:price (store/item (:store *site*) (:key a)))))\n   136\t        (is (= \"edited\" (:description (store/item (:store *site*) (:key a)))))))\n   137\t    (testing \"the shop's open view is stale until navigation\"\n   138\t      (is (not (str/includes? (sse-text shop) \"$42.42\")))\n   139\t      (is (str/includes? (sse-text shop) old-price))\n   140\t      (let [r (sup/input! (port) \"\" (:token shop) {:act \"nav\" :arg \"catalog\"})]\n   141\t        (is (str/includes? r \"$42.42\") \"the next navigation runs a fresh query\")))\n   142\t    (testing \"a rejected edit reports why and changes nothing\"\n   143\t      (let [t (sup/token-of (sse-text grid))\n   144\t            _ (sup/input! (port) \"/grid\" t {:act \"save\" :name (:name a) :price \"-5\" :desc \"x\"})]\n   145\t        (is (sup/wait-for 8000 #(str/includes? (sse-text grid) \"rejected: price must be a whole number\")))\n   146\t        (is (= 4242 (:price (store/item (:store *site*) (:key a)))))))\n   147\t    (testing \"the edit was written to the catalog file\"\n   148\t      (is (= 4242 (:item/price (first (filter #(= (:key a) (:item/slug %))\n   149\t                                              (:items (store/read-catalog (:catalog-path *site*)))))))))\n   150\t    (sup/close-sse (:sse shop))\n   151\t    (sup/close-sse (:sse grid))))\n   152\t\n   153\t\n   154\t(deftest static-traversal-is-refused-over-the-wire\n   155\t  (doseq [path [\"/images/../deps.edn\" \"/images/%2e%2e/deps.edn\" \"/grid/images/../deps.edn\"\n   156\t                \"/images//etc/passwd\"]]\n   157\t    (let [r (sup/http (port) \"GET\" path)]\n   158\t      (is (= 404 (:status r)) path)\n   159\t      (is (not (str/includes? (:text r) \":paths\")) path)))\n   160\t  (is (= \"image/png\"\n   161\t         (second (re-find #\"(?i)content-type: (image/png)\" (:text (sup/http (port) \"GET\" \"/images/7..png\")))))))\n   162\t\n   163\t\n   164\t(deftest the-edge-helper-agrees-with-the-wire\n   165\t  (is (= \"/s/x\" (edge/strip-grid \"/grid/s/x\"))))\n     1\t(ns dao.star-cart.edge-test\n     2\t  (:require [clojure.string :as str]\n     3\t            [clojure.test :refer [deftest is]]\n     4\t            [dao.star-cart.edge :as edge]))\n     5\t\n     6\t\n     7\t(def root \"resources/dao_star_cart/public\")\n     8\t\n     9\t\n    10\t(defn- site\n    11\t  []\n    12\t  (edge/make-edge {:asset-root root\n    13\t                   :shop (fn [req] {:status 200 :body (str \"shop:\" (:uri req))})\n    14\t                   :grid (fn [req] {:status 200 :body (str \"grid:\" (:uri req))})}))\n    15\t\n    16\t\n    17\t(defn- get-uri [uri] ((site) {:uri uri :request-method :get}))\n    18\t\n    19\t\n    20\t(deftest the-grid-prefix-is-stripped-and_does-not-reach-the-shop\n    21\t  (is (= \"grid:/\" (:body (get-uri \"/grid\"))))\n    22\t  (is (= \"grid:/s/x\" (:body (get-uri \"/grid/s/x\"))))\n    23\t  (is (= \"grid:/k/y\" (:body (get-uri \"/grid/k/y\"))))\n    24\t  (is (= \"shop:/s/x\" (:body (get-uri \"/s/x\"))))\n    25\t  (is (= \"shop:/\" (:body (get-uri \"/\"))))\n    26\t  (is (= \"shop:/gridlock\" (:body (get-uri \"/gridlock\"))) \"only /grid and /grid/... are the grid\"))\n    27\t\n    28\t\n    29\t(deftest static-assets-are-served-from-disk-and-never-enter-a-boundary\n    30\t  (let [css (get-uri \"/css/cart.css\")\n    31\t        img (get-uri \"/images/7..png\")\n    32\t        grid-img (get-uri \"/grid/images/7..png\")]\n    33\t    (is (= 200 (:status css)))\n    34\t    (is (= \"text/css\" (get-in css [:headers \"content-type\"])))\n    35\t    (is (= 200 (:status img)))\n    36\t    (is (= \"image/png\" (get-in img [:headers \"content-type\"])))\n    37\t    (is (pos? (.length ^java.io.File (:body img))))\n    38\t    (is (= 200 (:status grid-img)) \"the grid page's own asset urls work\")))\n    39\t\n    40\t\n    41\t(deftest static-path-traversal-is-refused\n    42\t  (doseq [uri [\"/images/../deps.edn\"\n    43\t               \"/images/%2e%2e/deps.edn\"\n    44\t               \"/images/%2e%2e/%2e%2e/deps.edn\"\n    45\t               \"/images/..%2fdeps.edn\"\n    46\t               \"/images/..%5cdeps.edn\"\n    47\t               \"/images//etc/passwd\"\n    48\t               \"/images/%2fetc/passwd\"\n    49\t               \"/images/..%2f..%2f..%2f..%2fetc%2fpasswd\"\n    50\t               \"/css/../images/7..png\"\n    51\t               \"/grid/images/../deps.edn\"\n    52\t               \"/grid/images/%2e%2e/deps.edn\"\n    53\t               \"/images/\"\n    54\t               \"/images/nope.png\"\n    55\t               \"/images/%00.png\"\n    56\t               \"/js/../../deps.edn\"]]\n    57\t    (let [r (get-uri uri)]\n    58\t      (is (= 404 (:status r)) uri)\n    59\t      (is (string? (:body r)))\n    60\t      (is (not (str/includes? (:body r) \"paths\")) \"no file content\"))))\n    61\t\n    62\t\n    63\t(deftest a-directory-is-not-a-regular-file\n    64\t  (is (= 404 (:status (get-uri \"/images/.\")))))\n# dao.star cart demo.  Build context: the repository root, with the product\n# images present at resources/dao_star_cart/public/images/ (gitignored; the\n# orchestrator copies them to the build host out of band).\n#\n#   docker build -f docker/dao-star-cart/Dockerfile -t dao-star-cart .\n#   docker run -p 3004:3004 -v star-cart-data:/data -e CATALOG_PATH=/data/catalog.edn dao-star-cart\n\nFROM clojure:temurin-21-tools-deps AS build\nWORKDIR /app\n# deps first, so the dependency layer caches\nCOPY docker/dao-star-cart/deps.edn deps.edn\nRUN clj -P\nCOPY src/clj src/clj\nCOPY src/cljc src/cljc\nCOPY resources/dao_star_cart resources/dao_star_cart\n\nFROM clojure:temurin-21-tools-deps\nWORKDIR /app\nCOPY --from=build /root/.m2 /root/.m2\nCOPY --from=build /root/.clojure /root/.clojure\nCOPY --from=build /app /app\nENV PORT=3004 \\\n    CATALOG_PATH=/data/catalog.edn \\\n    ASSET_ROOT=/app/resources/dao_star_cart/public\nVOLUME /data\nEXPOSE 3004\nCMD [\"clj\", \"-M\", \"-m\", \"dao.star-cart.main\"]\n{:deps {org.clojure/clojure {:mvn/version \"1.12.0\"}\n        org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        ;; http-kit's websocket support requires ring.websocket.protocols\n        org.ring-clojure/ring-websocket-protocols {:mvn/version \"1.14.1\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}}\n ;; The demo needs none of datomic, postgres, antlr, jsoup or stigmergy/chp.\n ;; Paths are relative to the Docker build context root (the repo root).\n :paths [\"src/clj\" \"src/cljc\" \"resources\"]}\n# dao.star cart: run note\n\n- Port **3004** in the container; map `3004:3004` (a separate compose file or\n  `docker run`; do not touch the lambdacart compose project).\n- `CATALOG_PATH` (default `/data/catalog.edn`) must be on a **volume**. On first\n  boot with an empty volume the baked seed `catalog.edn` is copied there; every\n  grid save rewrites it atomically. If the path is unwritable the demo logs it\n  and keeps editing in memory. Edits in a running container never touch the repo\n  copy of `catalog.edn`.\n- Images are baked from the build context (`resources/dao_star_cart/public/images/`,\n  68 MB, gitignored). Alternatively mount that directory read-only over\n  `/app/resources/dao_star_cart/public/images` and set `ASSET_ROOT` if the layout differs.\n- `deps.edn` here is trimmed (no datomic, postgres, antlr, jsoup, stigmergy/chp):\n  the demo's namespace closure was checked to load none of them.\n- Run limits on shiva: `docker run --memory 1g --cpus 1`; build with BuildKit and\n  `docker build` only. Do not run `bb` lanes or the repo test suites there.\n- **No authentication on `/grid`: do not expose this port beyond the private\n  interface.**\n# dao.star cart\n\nA reproduction of the functionality of the lambdacart shop on dao.star Mode 1,\nwith dao.space as the database and `dao.space.query/q` for every query. The UI\nis its own minimal dark theme; no lambdacart code is reused.\n\n**Shop** (`/`): catalog grid, item detail, add/remove, cart with total, checkout\nstub (no payment). The cart is a local of the session's yin.vm continuation and\nlives as long as the lineage lease.\n\n**Grid** (`/grid`): catalog editor. Edit name, price (minor units), description;\nadd/remove images (existing `/images/` files only) and tagories. Every mutation\ngoes through a host effects interpreter that validates it, transacts it, and\nappends `{:saved ..}` / `{:rejected ..}` back to the session; the UI shows\n`saving` until then. Each save rewrites `catalog.edn` (atomic rename).\n\n## Read this\n\n- **No authentication on the grid. Do not expose it.** The session token\n  identifies a session; it is not authorization.\n- **Coherence is stale-until-navigation.** A storefront view shows the catalog as\n  of its last projection; a grid save is visible after the shopper navigates or\n  reloads. There is no broadcast; the shop footer says so.\n- **A subscription ends once per hour** (the exchange lease's `:dao.lease/max`)\n  and the browser reconnects, which re-projects the current cart.\n- **`public/js/datastar.js` must be vendored** at the pinned version\n  (`dao.star-cart.view/datastar-version`, 1.0.0-RC.7) before the pages work in a\n  browser: `sh resources/dao_star_cart/vendor-datastar.sh`.\n\n## Provenance\n\n`catalog.edn` was extracted from the live lambdacart Datomic on 2026-10-26 (see\nthe header comment in that file for the form): 249 items including two empty\nplaceholder records present in the source. Prices are minor units. Product images\n(`public/images/`, 228 files, 68 MB) belong to the shop and are gitignored;\nnothing here is to be published without the owner's say-so.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-CADfmo88' (errno=Operation not permitted)\n2026-10-27 00:50:38.825 xcodebuild[97569:93168595]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-27 00:50:39.060 xcodebuild[97569:93168594] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-PnfBO8du' (errno=Operation not permitted)\n2026-10-27 00:50:39.620 xcodebuild[97572:93168610]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-27 00:50:39.799 xcodebuild[97572:93168609] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ndiff --git a/.gitignore b/.gitignore\nindex c9e9ac77f..7f93366ab 100644\n--- a/.gitignore\n+++ b/.gitignore\n@@ -53,3 +53,6 @@ env.sh\n .antigravitycli/\n .commandcode/\n docs/agents/routing-status.md\n+\n+# dao.star demo: product images from the live shop; too large for git\n+resources/dao_star_cart/public/images/\ndiff --git a/bb.edn b/bb.edn\nindex 04153a889..f03834d61 100644\n--- a/bb.edn\n+++ b/bb.edn\n@@ -62,6 +62,10 @@\n    :task (System/exit\n            (:exit (apply shell {:continue true} \"bb\" \"src/dev/jolt_j2_lane.clj\" \"probe\" *command-line-args*)))}\n \n+  cart\n+  {:doc \"dao.star cart demo (shop + grid) on port 3004: clj -M -m dao.star-cart.main\"\n+   :task (shell {:shutdown nil} \"clj\" \"-M\" \"-m\" \"dao.star-cart.main\")}\n+\n   demo\n   {:doc \"JVM: cooperative sum across two execution sites of one logical task\"\n    :task (shell {:shutdown nil} \"clj\" \"-M\" \"-m\" \"yin.demo\")}\ndiff --git a/src/clj/dao/stream/http/jvm.clj b/src/clj/dao/stream/http/jvm.clj\nindex 06a11b251..ea721a5f7 100644\n--- a/src/clj/dao/stream/http/jvm.clj\n+++ b/src/clj/dao/stream/http/jvm.clj\n@@ -36,7 +36,10 @@\n   (kit/send! ch {:status status :headers {\"content-type\" \"text/plain\"}} true))\n \n \n-(defn- handler\n+(defn handler\n+  \"The listener's ring handler for `boundary`. Public by architect ruling\n+   2026-10-26 (collab/1793033722326) so a composition's host edge can\n+   dispatch to multiple boundaries on one port.\"\n   [boundary]\n   (fn [req]\n     (let [exchange (atom nil)]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '350,410p' src/cljc/dao/space/transact.cljc && sed -n '1,310p' src/cljc/dao/space/query.cljc && rg -n 'conflict|retract|current' src/cljc/dao/space/query.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '350,410p' src/cljc/dao/space/transact.cljc && sed -n '1,310p' src/cljc/dao/space/query.cljc && rg -n 'conflict|retract|current' src/cljc/dao/space/query.cljc\"","aggregated_output":"                                              ops)]\n                        (when-not retracting?\n                          (throw (ex-info \"Unique constraint violated\"\n                                          {:attr a,\n                                           :val v,\n                                           :existing-eid existing-eid}))))))))))\n        ;; Implicit card-one retractions\n        retractions\n        (second\n          (reduce\n            (fn [[seen retractions] {:keys [op e a]}]\n              (if (and (= op :db/add) (not (contains? effective-card-many a)))\n                (let [key [e a]]\n                  (if (contains? seen key)\n                    [seen retractions]\n                    (let [existing (query/match (query/current (query/relation\n                                                                 base-datoms))\n                                     [e a '_])\n                          new-retractions (map (fn [d]\n                                                 [e a (nth d 2) t\n                                                  (:db/retract\n                                                    datom/reserved)])\n                                               existing)]\n                      [(conj seen key) (into retractions new-retractions)])))\n                [seen retractions]))\n            [#{} []]\n            added-ops))\n        ops-datoms (mapv (fn [{:keys [e a v m-raw]}] [e a v t m-raw]) ops)\n        all-datoms (vec (concat retractions ops-datoms extra-datoms))]\n    {:datoms all-datoms,\n     :tempids tempid-map,\n     :next-t (inc t),\n     :next-eid new-next-eid}))\n(ns dao.space.query\n  \"The reader-side index consumer (docs/design/dao.space.query.md).\n\n   An embeddable Peer over finite relations of tuples: positional `match`,\n   Datalog `q` and `pull` above them, with `current` and `history` as the\n   two explicit interpreters of canonical d5 datoms. The library is pure and\n   stateless: it owns no durable state, never writes, and enforces no\n   schema. It never opens and never closes an input — every database input\n   is a value the caller constructed:\n\n   - a relation value (`relation`, `entity-map-relation`, `fact-relation`);\n   - a datom view over a value (`current`, `history`);\n   - an opened published index (`open-published!`, released by the caller\n     through `close-published!`).\n\n   Raw vectors and raw maps are not database inputs and throw. A live\n   dao.stream handle becomes an input only through `snapshot`, the one\n   place this namespace touches v2. Source scope is interpreter context,\n   never a tuple slot.\"\n  (:require [dao.data.btree.cursor :as cursor]\n            [dao.data.btree.storage :as bts]\n            [dao.datom :as datom]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.coordinate :as jing-coordinate]\n            [dao.space.index :as index]\n            [dao.stream :as stream]\n            [dao.space.query.execution :as exec]\n            [dao.stream.observe :as observe]\n            #?@(:cljd [[\"dart:math\" :as dart-math]])))\n\n\n;; =============================================================================\n;; Canonical d5 interpretation (current / history)\n;; =============================================================================\n\n(defn- flatten-datoms\n  \"Flatten one source's row elements into canonical d5 rows. An element is\n   either a canonical d5 vector `[e a v t m]` or an atomic transaction record\n   `{:dao.space/transaction {:t n :datoms [...]}}`; the record is flattened\n   into its datoms.\"\n  [elements]\n  (into\n    []\n    (mapcat\n      (fn [x]\n        (cond\n          (and (map? x) (contains? x :dao.space/transaction))\n          (let [tx (:dao.space/transaction x)\n                _ (when-not (and (map? tx)\n                                 (= #{:t :datoms} (set (keys tx)))\n                                 (integer? (:t tx))\n                                 (not (neg? (:t tx)))\n                                 (vector? (:datoms tx))\n                                 (seq (:datoms tx)))\n                    (throw (ex-info \"malformed dao.space transaction record\"\n                                    {:payload x})))\n                _ (when-not (every? #(= (:t tx) (index/datom-t %))\n                                    (:datoms tx))\n                    (throw (ex-info\n                             \"transaction record datoms carry mismatched t\"\n                             {:payload x})))]\n            (:datoms tx))\n          (and (vector? x) (= 5 (count x))) [x]\n          :else\n          (throw\n            (ex-info\n              \"canonical d5 source element must be a 5-datom vector or a transaction record\"\n              {:element x})))))\n    elements))\n\n\n(defn- bound-datoms\n  \"Bound a d5 sequence to t <= as-of when an as-of is given.\"\n  [datoms as-of]\n  (if as-of\n    (filterv #(<= (index/compare-vals (index/datom-t %) as-of) 0) datoms)\n    datoms))\n\n\n(defn current-state-seq\n  \"Takes a sequence of canonical d5 datoms and returns the sequence of\n   currently-asserted datoms. Facts are keyed by local [e a v] under\n   kind-strict content identity (dao.jing.cbor/content-key), so a fact about\n   1.0M is never superseded or retracted by one about 1.00M, nor 0.0 by\n   -0.0, though host = merges both on the JVM: the greatest t wins within\n   each key, and two rows sharing [e a v t] but differing in m are\n   conflicting transaction history and are rejected (metadata is not an\n   implicit tie-break). Retractions are removed; the result is EAVT-ordered.\"\n  [s]\n  (->> (reduce\n         (fn [acc d]\n           (let [key (cbor/content-key\n                       [(index/datom-e d) (index/datom-a d) (index/datom-v d)])]\n             (update\n               acc\n               key\n               (fn [winner]\n                 (cond (nil? winner) d\n                       (< (index/datom-t winner) (index/datom-t d)) d\n                       (> (index/datom-t winner) (index/datom-t d)) winner\n                       (not= (index/datom-m winner) (index/datom-m d))\n                       (throw\n                         (ex-info\n                           \"conflicting d5 rows: same [e a v t], different m\"\n                           {:a winner, :b d}))\n                       :else winner)))))\n         {}\n         s)\n       (vals)\n       (remove datom/retracted?)\n       (sort index/eavt-cmp)))\n\n\n(defn- d5->current-facts\n  [elements as-of]\n  (->> (bound-datoms (flatten-datoms elements) as-of)\n       current-state-seq\n       (mapv #(subvec (vec %) 0 3))))\n\n\n(defn- d5->history-rows\n  [elements as-of]\n  (mapv vec (bound-datoms (flatten-datoms elements) as-of)))\n\n\n;; =============================================================================\n;; Entity-map relation normalization (explicit d3 projection)\n;; =============================================================================\n\n(defn- entity-map->d3\n  [m]\n  (when-not (map? m)\n    (throw (ex-info \"entity-map-relation requires entity maps\" {:entity m})))\n  (when-not (contains? m :db/id)\n    (throw (ex-info \"raw entity-map source requires an explicit :db/id\"\n                    {:entity m})))\n  (let [e (:db/id m)]\n    (into [] (keep (fn [[a v]] (when (not= a :db/id) [e a v]))) m)))\n\n\n(defn- entity-maps->d3\n  [maps]\n  (into [] (mapcat entity-map->d3) maps))\n\n\n;; =============================================================================\n;; Query values: relation, view, opened published index (Decision 2)\n;; =============================================================================\n\n(defn value?\n  \"True for the query values q/match/pull take as database inputs: a\n   relation value, a datom view, or an opened published index. Raw vectors\n   and raw maps answer false.\"\n  [x]\n  (and (map? x)\n       (or (contains? x :dao.space.query/relation)\n           (contains? x :dao.space.query/view)\n           (contains? x :dao.space.query/published))))\n\n\n(defn relation\n  \"An in-memory relation value. Its retained contents are an arbitrary,\n   mixed-dimensional tuple collection; arity never selects an\n   interpretation. This is the replacement for the direct raw-vector input.\"\n  [tuples]\n  {:dao.space.query/relation (vec tuples)})\n\n\n(defn entity-map-relation\n  \"An entity-map relation value: a bounded relation of entity maps,\n   projected explicitly to [e a v] facts on the read side. The read side is\n   pure and never mints an entity id, so every map must carry :db/id.\"\n  [maps]\n  ;; Normalize at the explicit constructor boundary. The resulting value is\n  ;; the same generic relation value q consumes; no second transport type\n  ;; or opening path is needed merely because the input syntax was maps.\n  (relation (entity-maps->d3 maps)))\n\n\n(defn fact-relation\n  \"The explicit current-fact relation: d3 rows that are already\n   current-state facts, so the fact index is built for them without a d5\n   pass. dao.space.schema builds these directly.\"\n  [tuples]\n  (assoc (relation tuples) :fact? true))\n\n\n(defn- snapshot-value?\n  [x]\n  (and (map? x) (contains? x :relation) (contains? x :status)))\n\n\n(defn- db-source\n  \"Normalize a current/history source. Query values and snapshots pass\n   through (a snapshot contributes its relation); everything else — raw\n   maps and vectors included — throws.\"\n  [source]\n  (cond\n    (value? source) source\n    (snapshot-value? source) (:relation source)\n    :else\n    (throw (ex-info \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n                    {:input source}))))\n\n\n(defn- view-value\n  [kind source as-of]\n  (cond-> {:dao.space.query/view kind, :source source}\n    (some? as-of) (assoc :as-of as-of)))\n\n\n(defn current\n  \"The explicit current d5 interpreter: a view value over source. Resolves\n   the greatest t per [e a v], removes retractions, and rejects conflicting\n   [e a v t] rows with differing m. An optional as-of bounds visible datoms\n   to t <= as-of.\"\n  ([source] (current source nil))\n  ([source as-of]\n   (view-value :current (db-source source) as-of)))\n\n\n(defn history\n  \"The explicit history d5 interpreter: a view value over source exposing\n   the exact logical d5 rows. An optional as-of bounds visible datoms to\n   t <= as-of.\"\n  ([source] (history source nil))\n  ([source as-of]\n   (view-value :history (db-source source) as-of)))\n\n\n;; =============================================================================\n;; Published indexes: open-published! / close-published! (Decision 1)\n;; =============================================================================\n\n(defn published-db\n  \"A query value over the manifest at `manifest-address` in `store`, a\n   live `dao.jing` handle the caller owns: the covered sets restored\n   lazily (`index/restored-indexes`), the EAVT rows deferred.  The value\n   owns nothing, so `close-published!` closes nothing; `open-published!`\n   is this over a store it opens from a coordinate.\"\n  [store manifest-address]\n  (let [manifest (index/read-manifest store manifest-address)]\n    {:dao.space.query/published {:manifest-address manifest-address}\n     :indexes (index/restored-indexes store manifest)\n     :rows (delay (index/read-datoms store manifest-address))\n     ;; The local, nonpersistent checked-read descriptor (Phase 4b): the\n     ;; manifest this constructor already read, plus the borrowed store\n     ;; capability. It is source implementation data, never a result or\n     ;; error context, and it changes neither the serializable coordinate\n     ;; nor the persisted manifest.\n     :dao.space.query/published-read {:version 1\n                                      :store store\n                                      :manifest-address manifest-address\n                                      :manifest manifest}}))\n\n\n(defn open-published!\n  \"Open a published covered-index coordinate — the serializable map\n   `index/published-index` builds — as a query value the caller owns: the\n   content-store handle it opens is closed by `close-published!`, never by\n   a query. `opts` reaches `dao.jing.coordinate/open!` as-is: a remote\n   content-store coordinate opens through the composition's\n   :dao.jing/attach entry, which a coordinate never carries, being data.\n   Nothing is fetched beyond the manifest; the row vector stays\n   deferred behind :rows and the covered sets behind restored B-trees, so a\n   `current` view with no as-of can answer selective clauses without a\n   full drain.\"\n  ([coordinate] (open-published! coordinate nil))\n  ([coordinate opts]\n   (when-not (and (map? coordinate)\n                  (= :dao.space.index/published\n                     (:dao.stream/type coordinate)))\n     (throw (ex-info \"open-published! takes a published-index coordinate\"\n                     {:coordinate coordinate})))\n   (let [{:keys [content-store manifest-address]} coordinate\n         expected (index/published-index content-store manifest-address)]\n     (when-not (= expected coordinate)\n       (throw (ex-info \"invalid published-index coordinate\"\n                       {:coordinate coordinate, :expected expected})))\n     (let [store (jing-coordinate/open! content-store opts)]\n       (try\n         (let [{:keys [indexes rows]\n                read-descriptor :dao.space.query/published-read}\n               (published-db store manifest-address)]\n           {:dao.space.query/published coordinate\n            :indexes indexes\n            :rows rows\n            ;; preserved through this reconstruction (same descriptor,\n            ;; same manifest: no second manifest read)\n            :dao.space.query/published-read read-descriptor\n            :store store\n            :close-guard (atom false)})\n         (catch #?(:cljd Object\n                   :clj Throwable\n                   :cljs :default)\n                error\n           (jing/close! store)\n           (throw error)))))))\n\n\n(defn close-published!\n  \"Close the content-store handle an opened published index owns. A second\n   close is a no-op here, before the backend is even asked.\"\n  [opened]\n  (when-let [guard (:close-guard opened)]\n    (when (compare-and-set! guard false true)\n      (jing/close! (:store opened))))\n  nil)\n\n5:   Datalog `q` and `pull` above them, with `current` and `history` as the\n12:   - a datom view over a value (`current`, `history`);\n34:;; Canonical d5 interpretation (current / history)\n81:(defn current-state-seq\n83:   currently-asserted datoms. Facts are keyed by local [e a v] under\n85:   1.0M is never superseded or retracted by one about 1.00M, nor 0.0 by\n88:   conflicting transaction history and are rejected (metadata is not an\n105:                           \"conflicting d5 rows: same [e a v t], different m\"\n111:       (remove datom/retracted?)\n115:(defn- d5->current-facts\n118:       current-state-seq\n182:  \"The explicit current-fact relation: d3 rows that are already\n183:   current-state facts, so the fact index is built for them without a d5\n195:  \"Normalize a current/history source. Query values and snapshots pass\n213:(defn current\n214:  \"The explicit current d5 interpreter: a view value over source. Resolves\n215:   the greatest t per [e a v], removes retractions, and rejects conflicting\n218:  ([source] (current source nil))\n220:   (view-value :current (db-source source) as-of)))\n267:   `current` view with no as-of can answer selective clauses without a\n530:  \"Turn one db-value into an immutable tuple relation plus, for current\n548:  \"Interpret ONE current/history view over its already realized source. A\n549:   current view with no as-of over an opened published index routes through\n557:    (if (and (= :current kind) (nil? as-of) src-indexes)\n558:      [st {::relation (delay (d5->current-facts (force-relation src-relation) nil)),\n565:                       :current (d5->current-facts forced-rel as-of)\n568:                            (if (= :current kind) (count rows) 0))]\n571:              (let [fact-index (when (= :current kind)\n600:     {:class :checked}       exactly `current`, no as-of, DIRECTLY over a\n619:               (= :current (:dao.space.query/view v))\n851:  \"The current-state datoms whose bound slots are content= the pattern's.\n856:  (current-state-seq (filter (slot-pred e a v) (index-candidates idx e a v))))\n866:   candidates are interpreted. The current-state resolution over the\n888:                      [st (vec (current-state-seq kept))]))\n949:                     [st (vec (current-state-seq kept))])))]\n990:  \"Index-routed datom selector: returns current-state datoms matching\n1019:        :current (d5->current-facts src-rows as-of)\n1242:   current fact view over a query value.\n1245:     (pull (current source) 123 [:name :age {:friend [:name]}])\"\n1249:      (throw (ex-info \"pull requires a current fact-shaped source view\"\n1260:               \"pull-many requires a current fact-shaped source view\"\n1718:                           \"get-else requires a current fact-shaped source view\"\n1732:                           \"missing? requires a current fact-shaped source view\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/clj/dao/stream/http/jvm.clj && rg -n 'defn|http/exchange|http/path|no-such|nil|close' src/cljc/dao/stream/http.cljc && nl -ba src/clj/dao/star_cart/grid_effects.clj && nl -ba src/clj/dao/star_cart/store.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/clj/dao/stream/http/jvm.clj && rg -n 'defn|http/exchange|http/path|no-such|nil|close' src/cljc/dao/stream/http.cljc && nl -ba src/clj/dao/star_cart/grid_effects.clj && nl -ba src/clj/dao/star_cart/store.clj\"","aggregated_output":"     1\t(ns dao.stream.http.jvm\n     2\t  \"The JVM host edge for the DaoStream HTTP boundary (http-kit).\n     3\t\n     4\t   Wire framing, header parsing and size limits live here, below the\n     5\t   transform: an over-limit or malformed request is answered 400, 413 or 503\n     6\t   and never deposited.  The listener holds each socket open, performs the\n     7\t   effects the core asks of it by writing to the socket, and records no role\n     8\t   and reads no path, token, query or body content.\"\n     9\t  (:require [dao.stream.http :as http]\n    10\t            [org.httpkit.server :as kit])\n    11\t  (:import [java.io InputStream]))\n    12\t\n    13\t\n    14\t(defn- read-body\n    15\t  \"The request body bytes http-kit already bounded by `:max-body`, or nil.\"\n    16\t  [body]\n    17\t  (when (instance? InputStream body)\n    18\t    (let [bs (.readAllBytes ^InputStream body)]\n    19\t      (when (pos? (alength bs)) bs))))\n    20\t\n    21\t\n    22\t(defn- socket\n    23\t  \"The core's socket seam over one http-kit async channel.  `kit/send!`\n    24\t   answers false once the channel is closed, which the core reads as a failed\n    25\t   write.\"\n    26\t  [ch]\n    27\t  {:head! (fn [status headers]\n    28\t            (kit/send! ch {:status status :headers headers} false))\n    29\t   :write! (fn [chunk] (kit/send! ch chunk false))\n    30\t   :end! (fn [] (kit/close ch) true)\n    31\t   :close! (fn [] (kit/close ch) true)})\n    32\t\n    33\t\n    34\t(defn- answer!\n    35\t  [ch status]\n    36\t  (kit/send! ch {:status status :headers {\"content-type\" \"text/plain\"}} true))\n    37\t\n    38\t\n    39\t(defn handler\n    40\t  \"The listener's ring handler for `boundary`. Public by architect ruling\n    41\t   2026-10-26 (collab/1793033722326) so a composition's host edge can\n    42\t   dispatch to multiple boundaries on one port.\"\n    43\t  [boundary]\n    44\t  (fn [req]\n    45\t    (let [exchange (atom nil)]\n    46\t      (kit/as-channel\n    47\t        req\n    48\t        {:on-open (fn [ch]\n    49\t                    (try\n    50\t                      (let [result (http/accept!\n    51\t                                     boundary\n    52\t                                     {:method (:request-method req)\n    53\t                                      :path (:uri req)\n    54\t                                      :query (:query-string req)\n    55\t                                      :headers (:headers req)\n    56\t                                      :body (read-body (:body req))}\n    57\t                                     (socket ch))]\n    58\t                        (case (:http/status result)\n    59\t                          :http/accepted (reset! exchange (:http/exchange result))\n    60\t                          :http/too-large (answer! ch 413)\n    61\t                          (:http/full :http/stopped) (answer! ch 503)\n    62\t                          :http/gone nil))\n    63\t                      (catch Throwable _ (answer! ch 400))))\n    64\t         :on-close (fn [_ch _status]\n    65\t                     (when-let [id @exchange]\n    66\t                       (http/peer-closed! boundary id)))}))))\n    67\t\n    68\t\n    69\t(defn listen!\n    70\t  \"Bind an http-kit listener for `boundary`.  Options: `:bind-host`,\n    71\t   `:bind-port` (0 for ephemeral).  The boundary's `:max-body-bytes` bounds\n    72\t   http-kit's own body read, so an oversize request is answered 413 before it\n    73\t   is assembled.  Registers the listener's stop with the boundary and answers\n    74\t   `{:http.jvm/server server :http.jvm/port port}`.\"\n    75\t  [boundary {:keys [bind-host bind-port]}]\n    76\t  (let [server (kit/run-server (handler boundary)\n    77\t                               {:ip bind-host\n    78\t                                :port bind-port\n    79\t                                :max-body (:max-body-bytes boundary)\n    80\t                                :legacy-return-value? false})]\n    81\t    (http/on-stop! boundary #(kit/server-stop! server {:timeout 100}))\n    82\t    {:http.jvm/server server\n    83\t     :http.jvm/port (kit/server-port server)}))\n    84\t\n    85\t\n    86\t(defn stop-listening!\n    87\t  [{:http.jvm/keys [server]}]\n    88\t  (kit/server-stop! server {:timeout 100}))\n15:     :close! (fn [])                drop the connection, no response\n18:   callbacks enter only through `accept!` and `peer-closed!`; the step takes no\n26:(defn admission?\n40:(defn- target-with?\n47:(defn- positive-int?\n52:(defn make-boundary\n90:                   :on-stop nil})}))\n97:(defn- deposit!\n104:(defn- seam-ok?\n112:(defn- drop-socket!\n114:  (when-let [close! (:close! (:socket entry))]\n115:    (seam-ok? close!)))\n118:(defn- terminal-event\n120:  {:http/exchange id :http/event event})\n123:(defn- finish!\n142:(defn- claim!\n143:  \"Atomically remove exchange `id` from the open set; its entry, or nil when\n146:   number of competing claims exactly one answers non-nil.\"\n152:(defn- close-claimed!\n154:   terminal `:http/closed`.\"\n157:  (finish! boundary id entry :http/closed))\n160:(defn close-exchange\n162:   this boundary: close the socket of exchange `id` and deposit its terminal\n163:   `:http/closed`.  Answers true when it closed an open exchange, false when\n167:    (do (close-claimed! boundary id entry) true)\n171:(defn open-exchanges\n178:(defn- close-all!\n181:    (close-exchange boundary id)))\n188:(defn- none?\n190:  (or (nil? x)\n195:(defn- request-event\n197:  (cond-> {:http/exchange id\n200:           :http/path path\n206:(defn- body-size\n208:  (cond (nil? body) 0\n213:(defn accept!\n216:   Answers `{:http/status :http/accepted :http/exchange id}`, or\n220:   is closed with no synthesized response and `{:http/status :http/gone}` is\n228:    (let [outcome (volatile! nil)\n229:          id (volatile! nil)]\n245:                       (assoc-in [:awaiting xid] nil))))))\n255:              {:http/status :http/gone :http/exchange xid})\n263:              {:http/status :http/accepted :http/exchange xid})))))))\n266:(defn peer-closed!\n268:   terminal `:http/closed` once; a no-op for an exchange no longer open.\"\n270:  (close-exchange boundary id))\n277:(defn- effect?\n279:  (and (map? v) (contains? v :http/exchange) (keyword? (:http/effect v))))\n282:(defn- chunk-payload?\n287:(defn- perform!\n292:        fail! (fn [] (when-let [e (claim! boundary id)] (close-claimed! boundary id e)))\n318:            (close-claimed! boundary id e)))\n322:      nil)))\n325:(defn- stop-listener!\n328:    (try (f) (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))))\n331:(defn stop!\n332:  \"Boundary stop: close every open exchange (each deposits `:http/closed`),\n336:  (close-all! boundary)\n341:(defn on-stop!\n349:(defn egress-step\n363:                    (let [id (:http/exchange v)]\n368:            :dao.stream/blocked nil\n372:            (do (close-all! boundary)\n     1\t(ns dao.star-cart.grid-effects\n     2\t  \"The grid's stepped effects interpreter.  A peer observer of each grid\n     3\t   session's view medium (its own cursor, beside the driver's): when a model\n     4\t   carries `{:edit {:item slug :changes {...}}}` it validates the change, runs\n     5\t   the transact through the store, and appends a `{:saved slug}` or\n     6\t   `{:rejected reason}` confirmation to that session's routed input medium.  The\n     7\t   program therefore renders `saving` until the transact has completed.\n     8\t\n     9\t   Validation is here because signals are the client's unverified claim:\n    10\t   name 1-200 characters; price an integer 0..100000000 (minor units);\n    11\t   description at most 2000; an image URL an existing file under `/images/`;\n    12\t   a tagory 1-80 characters.\"\n    13\t  (:require [clojure.data.json :as json]\n    14\t            [clojure.string :as str]\n    15\t            [dao.star-cart.catalog :as catalog]\n    16\t            [dao.star-cart.edge :as edge]\n    17\t            [dao.star-cart.store :as store]\n    18\t            [dao.star.driver :as driver]\n    19\t            [dao.star.lease :as lease]\n    20\t            [dao.stream :as stream])\n    21\t  (:import [java.nio.file Paths]))\n    22\t\n    23\t\n    24\t(def max-name 200)\n    25\t(def max-description 2000)\n    26\t(def max-tagory 80)\n    27\t(def max-price 100000000)\n    28\t\n    29\t\n    30\t(def ^:private retract-meta {:db/op :db/retract})\n    31\t\n    32\t\n    33\t(defn- reject!\n    34\t  [reason]\n    35\t  (throw (ex-info \"rejected\" {::rejected reason})))\n    36\t\n    37\t\n    38\t(defn- parse-price\n    39\t  [p]\n    40\t  (cond (integer? p) p\n    41\t        (and (string? p) (re-matches #\"\\d{1,12}\" (str/trim p))) (Long/parseLong (str/trim p))\n    42\t        :else (reject! \"price must be a whole number of cents\")))\n    43\t\n    44\t\n    45\t(defn- check-name\n    46\t  [n]\n    47\t  (when-not (and (string? n) (<= 1 (count (str/trim n)) max-name))\n    48\t    (reject! (str \"name must be 1-\" max-name \" characters\")))\n    49\t  (str/trim n))\n    50\t\n    51\t\n    52\t(defn- check-image\n    53\t  [root url]\n    54\t  (when-not (and (string? url) (<= (count url) 300) (str/starts-with? url \"/images/\"))\n    55\t    (reject! \"image must be an /images/ path\"))\n    56\t  (when-not (edge/static-file root (edge/decode-path url))\n    57\t    (reject! \"image file does not exist\"))\n    58\t  url)\n    59\t\n    60\t\n    61\t(defn- check-tagory\n    62\t  [n]\n    63\t  (when-not (and (string? n) (<= 1 (count (str/trim n)) max-tagory))\n    64\t    (reject! (str \"tagory must be 1-\" max-tagory \" characters\")))\n    65\t  (str/trim n))\n    66\t\n    67\t\n    68\t(defn- edit-tx\n    69\t  \"tx-data for `changes` on item `slug` under `db`, or a rejection.\"\n    70\t  [root db slug changes]\n    71\t  (let [eid (or (catalog/item-eid db slug) (reject! \"no such item\"))\n    72\t        current (catalog/item db slug)\n    73\t        ;; an unchanged value is not transacted: re-asserting a card-one\n    74\t        ;; value would retract and assert the same datom in one tx\n    75\t        changed (fn [k v] (when (not= v (get current k)) v))]\n    76\t    (vec\n    77\t      (concat\n    78\t        (when (some? (:name changes))\n    79\t          (when-some [n (changed :name (check-name (:name changes)))]\n    80\t            [[:db/add eid :item/name n]]))\n    81\t        (when (some? (:price changes))\n    82\t          (let [p (parse-price (:price changes))]\n    83\t            (when-not (<= 0 p max-price) (reject! \"price out of range\"))\n    84\t            (when-some [p' (changed :price p)]\n    85\t              [[:db/add eid :item/price p']])))\n    86\t        (when (some? (:description changes))\n    87\t          (let [d (:description changes)]\n    88\t            (when-not (and (string? d) (<= (count d) max-description))\n    89\t              (reject! (str \"description must be at most \" max-description \" characters\")))\n    90\t            (when-some [d' (changed :description d)]\n    91\t              [[:db/add eid :item/description d']])))\n    92\t        (when (contains? changes :add-image)\n    93\t          (let [u (check-image root (:add-image changes))]\n    94\t            (when (catalog/image-eid db slug u) (reject! \"image already on the item\"))\n    95\t            [{:db/id \"tid_new_image\" :image/url u}\n    96\t             [:db/add eid :item/images \"tid_new_image\"]]))\n    97\t        (when (contains? changes :remove-image)\n    98\t          (let [i (or (catalog/image-eid db slug (:remove-image changes))\n    99\t                      (reject! \"image is not on the item\"))]\n   100\t            [[:db/retract eid :item/images i retract-meta]]))\n   101\t        (when (contains? changes :add-tagory)\n   102\t          (let [n (check-tagory (:add-tagory changes))]\n   103\t            (when (catalog/tagory-linked? db slug n) (reject! \"tagory already on the item\"))\n   104\t            (if-let [t (catalog/tagory-eid db n)]\n   105\t              [[:db/add eid :item/tagories t]]\n   106\t              [{:db/id \"tid_new_tagory\" :tagory/name n}\n   107\t               [:db/add eid :item/tagories \"tid_new_tagory\"]])))\n   108\t        (when (contains? changes :remove-tagory)\n   109\t          (let [n (:remove-tagory changes)\n   110\t                t (when (catalog/tagory-linked? db slug n) (catalog/tagory-eid db n))]\n   111\t            (when-not t (reject! \"tagory is not on the item\"))\n   112\t            [[:db/retract eid :item/tagories t retract-meta]]))))))\n   113\t\n   114\t\n   115\t(defn apply-edit!\n   116\t  \"Validate and transact `edit` (`{:item slug :changes {...}}`).  Answers\n   117\t   `{:saved slug}` or `{:rejected reason}`; a rejection leaves the db unchanged.\"\n   118\t  [store' asset-root {:keys [item changes]}]\n   119\t  (let [root (.toAbsolutePath (.normalize (Paths/get (str asset-root) (make-array String 0))))]\n   120\t    (try\n   121\t      (when-not (and (string? item) (map? changes))\n   122\t        (reject! \"malformed edit\"))\n   123\t      (store/transact-edit! store' (fn [db] (edit-tx root db item changes)))\n   124\t      {:saved item}\n   125\t      (catch clojure.lang.ExceptionInfo e\n   126\t        (if-let [r (::rejected (ex-data e))]\n   127\t          {:rejected r}\n   128\t          {:rejected (str \"edit failed: \" (.getMessage e))}))\n   129\t      (catch Exception e\n   130\t        {:rejected (str \"edit failed: \" (.getMessage e))}))))\n   131\t\n   132\t\n   133\t(defn make-effects\n   134\t  \"`{:driver grid-driver :store store :asset-root path}`.\"\n   135\t  [config]\n   136\t  (atom (assoc config :cursors {})))\n   137\t\n   138\t\n   139\t(defn- confirm!\n   140\t  [drv s result]\n   141\t  (when-let [medium (driver/session-medium drv s)]\n   142\t    (stream/append! medium\n   143\t                    {:exchange nil :kind :input :lineage s\n   144\t                     :token (:occurrence (driver/latest drv s))\n   145\t                     :event {:http/method :post\n   146\t                             :http/body (json/write-str\n   147\t                                          (if-let [slug (:saved result)]\n   148\t                                            {:saved slug}\n   149\t                                            {:rejected (:rejected result)}))}})))\n   150\t\n   151\t\n   152\t(defn effects-step!\n   153\t  \"One pass: read every grid session's view medium with this interpreter's own\n   154\t   cursor, perform each `:edit`, confirm.  Answers the effects atom.\"\n   155\t  [fx]\n   156\t  (let [{:keys [driver store asset-root]} @fx]\n   157\t    (doseq [s (driver/sessions driver)\n   158\t            :let [out (get-in @driver [:sessions s :vm-out])]\n   159\t            :when out]\n   160\t      (let [cursor (or (get-in @fx [:cursors s]) (lease/oldest-cursor out))\n   161\t            r (lease/drain out cursor)]\n   162\t        (swap! fx assoc-in [:cursors s] (:cursor r))\n   163\t        (doseq [model (:values r)\n   164\t                :let [edit (:edit model)]\n   165\t                :when (map? edit)]\n   166\t          (confirm! driver s (apply-edit! store asset-root edit)))))\n   167\t    fx))\n     1\t(ns dao.star-cart.store\n     2\t  \"The mutable catalog db: an atom holding the accumulated datom vector.  Boot\n     3\t   loads `catalog.edn` through `transact/prepare-tx` (schema block first); an\n     4\t   edit runs `prepare-tx` inside a `swap!`, so concurrent editors cannot lose\n     5\t   each other's updates.  Every save snapshots the catalog back to its file as\n     6\t   plain item maps (temp file + atomic rename).  A path that cannot be written\n     7\t   logs and the store carries on in memory.\"\n     8\t  (:require [clojure.edn :as edn]\n     9\t            [clojure.java.io :as io]\n    10\t            [dao.space.transact :as transact]\n    11\t            [dao.star-cart.catalog :as catalog])\n    12\t  (:import [java.nio.file Files StandardCopyOption Paths]))\n    13\t\n    14\t\n    15\t(defn- log\n    16\t  [& xs]\n    17\t  (binding [*out* *err*] (println (apply str \"star-cart: \" xs))))\n    18\t\n    19\t\n    20\t(defn read-catalog\n    21\t  \"The catalog file: `{:store/name .. :items [item-map ...]}`.\"\n    22\t  [path]\n    23\t  (edn/read-string (slurp path)))\n    24\t\n    25\t\n    26\t(defn- boot-datoms\n    27\t  [item-maps]\n    28\t  (:datoms (transact/prepare-tx\n    29\t             {:base-datoms []\n    30\t              :tx-data (into catalog/schema-tx (catalog/items->tx item-maps))})))\n    31\t\n    32\t\n    33\t(defn write-atomically!\n    34\t  \"Write `content` to `path` through a sibling temp file and an atomic rename.\n    35\t   The old file is untouched if the write fails before the rename.\"\n    36\t  [path content]\n    37\t  (let [target (Paths/get path (make-array String 0))\n    38\t        dir (or (.getParent target) (Paths/get \".\" (make-array String 0)))\n    39\t        tmp (Files/createTempFile dir \"catalog\" \".tmp\" (make-array java.nio.file.attribute.FileAttribute 0))]\n    40\t    (try\n    41\t      (spit (.toFile tmp) content)\n    42\t      (Files/move tmp target (into-array java.nio.file.CopyOption\n    43\t                                         [StandardCopyOption/ATOMIC_MOVE StandardCopyOption/REPLACE_EXISTING]))\n    44\t      (catch Throwable t\n    45\t        (Files/deleteIfExists tmp)\n    46\t        (throw t)))))\n    47\t\n    48\t\n    49\t(defn open\n    50\t  \"Open the store.  `path` is where saves go (the seed is copied there on first\n    51\t   boot when the path is empty and writable), `seed` the baked catalog file.\n    52\t   `:write-fn` (default `write-atomically!`) is injectable for tests.\"\n    53\t  [{:keys [path seed write-fn] :or {write-fn write-atomically!}}]\n    54\t  (let [source (cond (and path (.exists (io/file path))) path\n    55\t                     :else seed)\n    56\t        data (read-catalog source)\n    57\t        store {:path path :write-fn write-fn :store-name (:store/name data)\n    58\t               :datoms (atom (boot-datoms (:items data)))\n    59\t               :cache (atom nil)}]\n    60\t    (when (and path (not= source path))\n    61\t      (try (write-fn path (slurp seed))\n    62\t           (catch Throwable t (log \"cannot seed \" path \": \" (.getMessage t) \"; continuing in memory\"))))\n    63\t    store))\n    64\t\n    65\t\n    66\t(defn db\n    67\t  [store]\n    68\t  (catalog/db @(:datoms store)))\n    69\t\n    70\t\n    71\t(defn items\n    72\t  \"All items, cached per datom value: a read after an edit recomputes once.\"\n    73\t  [store]\n    74\t  (let [ds @(:datoms store)\n    75\t        [cached-ds cached] @(:cache store)]\n    76\t    (if (identical? ds cached-ds)\n    77\t      cached\n    78\t      (let [result (catalog/items (catalog/db ds))]\n    79\t        (reset! (:cache store) [ds result])\n    80\t        result))))\n    81\t\n    82\t\n    83\t(defn item\n    84\t  [store slug]\n    85\t  (first (filter #(= slug (:key %)) (items store))))\n    86\t\n    87\t\n    88\t(defn catalog-fns\n    89\t  \"The pure view's catalog: `:items` and `:item`, each reading the store fresh.\"\n    90\t  [store]\n    91\t  {:items (fn [] (items store))\n    92\t   :item (fn [slug] (item store slug))})\n    93\t\n    94\t\n    95\t(defn snapshot!\n    96\t  \"Rewrite the catalog file from a fresh query.  Failure logs and is swallowed:\n    97\t   the edit stands in memory.\"\n    98\t  [store]\n    99\t  (when-let [path (:path store)]\n   100\t    (try\n   101\t      ((:write-fn store) path\n   102\t       (pr-str {:store/name (:store-name store)\n   103\t                :items (catalog/item-maps (db store))}))\n   104\t      true\n   105\t      (catch Throwable t\n   106\t        (log \"cannot save \" path \": \" (.getMessage t) \"; continuing in memory\")\n   107\t        false))))\n   108\t\n   109\t\n   110\t(defn transact-edit!\n   111\t  \"Apply an edit.  `tx-fn` receives the current db value and answers tx-data (or\n   112\t   throws, aborting the swap).  `prepare-tx` runs inside the `swap!`.  On\n   113\t   success the snapshot is saved and the new datom vector answered.\"\n   114\t  [store tx-fn]\n   115\t  (let [new-ds (swap! (:datoms store)\n   116\t                      (fn [ds]\n   117\t                        (let [tx-data (tx-fn (catalog/db ds))]\n   118\t                          (if (empty? tx-data)\n   119\t                            ds\n   120\t                            (into ds (:datoms (transact/prepare-tx\n   121\t                                                {:base-datoms ds :tx-data tx-data})))))))]\n   122\t    (snapshot! store)\n   123\t    new-ds))\n","exit_code":0,"status":"completed"}}
