nstall in\n  1660\t    ;; init-form) and installs the two closures below over it. The store\n  1661\t    ;; holds [wrapper condition] pairs, keyed by the genuine wrapper\n  1662\t    ;; reference itself: cell identity is `=` on sealed cell refs (same\n  1663\t    ;; heap id and seal), so a copied or newly minted cell never matches\n  1664\t    ;; a stored key. Membership is established ONLY by the installed\n  1665\t    ;; js.rt/raise-protocol when it creates the wrapper; the installed\n  1666\t    ;; js.rt/retained-condition answers the stored condition for a member\n  1667\t    ;; wrapper and nil for everything else. No wrapper-supplied or\n  1668\t    ;; wrapper-reachable metadata is consulted: the wrapper cell carries\n  1669\t    ;; no provenance, condition or seal slot, so mutating its contents,\n  1670\t    ;; minting a look-alike, copying its contents, or stamping a new\n  1671\t    ;; cell with any seal a holder can read cannot create or replace a\n  1672\t    ;; membership (R5). The store root is a lexical capture of the two\n  1673\t    ;; installed closures only: it is not a runtime key, not reachable\n  1674\t    ;; through the wrapper cell or its :props, and the two installed\n  1675\t    ;; names are not module exports: they live under `js.rt/*`, whose\n  1676\t    ;; namespace `core/exports` never takes, so the linked path's frozen\n  1677\t    ;; export slice can never carry a pre-init binding for them. No\n  1678\t    ;; exported operation exists whose contract is to register or\n  1679\t    ;; replace an association; `js.rt/raise-protocol` registers only as\n  1680\t    ;; a side effect of raising, and only its post-init installed\n  1681\t    ;; closure does so. What admitted\n  1682\t    ;; source CAN reach is the wrapper cell itself (and may mutate its\n  1683\t    ;; JS-visible contents); that grants retaining and rethrowing that\n  1684\t    ;; wrapper, never altering what it forwards.\n  1685\t    ;; Retention/reclamation policy: associations are preserved across\n  1686\t    ;; completed calls and catches for the life of the task and are\n  1687\t    ;; reclaimed only at task teardown, when the task's heap (store\n  1688\t    ;; cell included) dies; there is no process-global or cross-task\n  1689\t    ;; registry. An unchanged rethrow of a member wrapper forwards the\n  1690\t    ;; original condition through the entry bridge with no new wrapper.\n  1691\t    ;; Otherwise-foreign :yang.call/thrown payloads are delivered raw\n  1692\t    ;; (the ruling's js allowance). A returned condition-shaped map stays\n  1693\t    ;; ordinary data. The two definitions below are pre-init stubs (no\n  1694\t    ;; store exists yet) under the internal `js.rt/*` names: js/init!\n  1695\t    ;; replaces both before any guest code runs, under the same names\n  1696\t    ;; the intra-module readers below and in the entry bridge use.\n  1697\t    ;; Because the namespace is `js.rt`, not `js`, `core/exports` never\n  1698\t    ;; sees them: no module export and no frozen linked slice can carry\n  1699\t    ;; a pre-init binding that silently answers nil.\n  1700\t    [js.rt/retained-condition (fn [e] nil)]\n  1701\t    [js.rt/raise-protocol\n  1702\t     (fn [condition]\n  1703\t       (let [reason (get condition :yang.call/reason)]\n  1704\t         (js/throw\n  1705\t           (js/make-error\n  1706\t             js.rt/type-error-proto\n  1707\t             (if (= reason :yang.call/not-callable)\n  1708\t               {:js/str \"value is not a function\"}\n  1709\t               (if (= reason :yang.call/unsupported-binding)\n  1710\t                 {:js/str \"unsupported binding profile\"}\n  1711\t                 {:js/str \"invalid function invocation\"}))))))]\n  1712\t    [js/call\n  1713\t     (fn [f this args]\n  1714\t       (yang.call/invoke-with\n  1715\t         f args []\n  1716\t         (fn [condition]\n  1717\t           (if (= (get condition :yang.call/reason) :yang.call/thrown)\n  1718\t             (js/throw (get condition :yang.call/value))\n  1719\t             (js.rt/raise-protocol condition)))\n  1720\t         (assoc {} :yang.call/receiver this)))]\n  1721\t    [js/is-constructor?\n  1722\t     ;; [[Construct]] exists on :normal functions, class constructors and the\n  1723\t     ;; builtins flagged :ctor?; arrows, methods, accessors and the rest have\n  1724\t     ;; none\n  1725\t     (fn [v]\n  4110\t   ['js.rt/symbol-proto\n  4111\t    [[\"toString\" 0 'js/symbol-to-string] [\"valueOf\" 0 'js/symbol-value-of]]]])\n  4112\t\n  4113\t\n  4114\t(def ^:private retained-store-install\n  4115\t  \"The guest form `js/init!` runs to create the private retained-condition\n  4116\t   identity store and install the real `js.rt/retained-condition` /\n  4117\t   `js.rt/raise-protocol` closures over it. The install keys are the\n  4118\t   `js.rt/*` names the stub definitions and the intra-module readers\n  4119\t   (the entry bridge and `js/call`) use: variable lookup is exact-symbol\n  4120\t   in the live store, and the linked emitter's `strip` leaves `js.rt/*`\n  4121\t   qualified in definition keys, quoted install keys and reads alike,\n  4122\t   so all three coincide in both the bundled and the linked store.\n  4123\t   Because their namespace is `js.rt`, not `js`, they are never module\n  4124\t   exports and no frozen export slice can carry a pre-init binding for\n  4125\t   them. The store cell itself is bound only by this `let`, so its root\n  4126\t   lives solely in the two installed closures' lexical captures: it is\n  4127\t   allocated once per task (inside the uninit guard), is never written\n  4128\t   to a runtime key, a wrapper cell, or a `:props` map, and no other\n  4129\t   form returns it. The lookup walks [wrapper condition] pairs\n  4130\t   comparing keys with `=` — sealed cell-ref identity (heap id plus\n  4131\t   seal) — so membership is wrapper identity, never wrapper-supplied\n  4132\t   metadata.\"\n  4133\t  '(let [retained-store (cell/new [])\n  4134\t         retained-lookup\n  4135\t         (fn [self pairs e]\n  4136\t           (if (= (data/count pairs) 0)\n  4137\t             nil\n  4138\t             (if (= (get (get pairs 0) 0) e)\n  4139\t               (get (get pairs 0) 1)\n  4140\t               (self self (data/subvec pairs 1 (data/count pairs)) e))))]\n  4141\t     (do (yin/def (quote js.rt/retained-condition)\n  4142\t           (fn [e]\n  4143\t             (if (js/cell? e)\n  4144\t               ;; `cell/authentic?` is load-bearing here: an alias map `=` to a held wrapper passes it and returns the genuine condition, which is harmless (holding the wrapper already grants rethrow).\n  4145\t               (if (cell/authentic? e)\n  4146\t                 (retained-lookup retained-lookup\n  4147\t                                   (cell/get retained-store) e)\n  4148\t                 nil)\n  4149\t               nil)))\n  4150\t         (yin/def (quote js.rt/raise-protocol)\n  4151\t           (fn [condition]\n  4152\t             (let [reason (get condition :yang.call/reason)\n  4153\t                   e (js/make-error\n  4154\t                       js.rt/type-error-proto\n  4155\t                       (if (= reason :yang.call/not-callable)\n  4156\t                         {:js/str \"value is not a function\"}\n  4157\t                         (if (= reason :yang.call/unsupported-binding)\n  4158\t                           {:js/str \"unsupported binding profile\"}\n  4159\t                           {:js/str \"invalid function invocation\"})))]\n  4160\t               (do (cell/set! retained-store\n  4161\t                              (conj (cell/get retained-store)\n  4162\t                                    (js/pair e condition)))\n  4163\t                   (js/throw e)))))\n  4164\t         :js/undefined)))\n  4165\t\n  4166\t\n  4167\t(defn- init-form\n  4168\t  \"`js/init!`'s body: the context and out cells, the private\n  4169\t   retained-condition identity store (retained-store-install, a closure\n  4170\t   capture, never a runtime key), the prototypes in\n  4171\t   dependency order (`%Object.prototype%`, `%Function.prototype%`, then the\n  4172\t   rest), the intrinsic methods, the Error family, the global object and\n  4173\t   its bindings, then the ready flag, under the uninit guard.\"\n  4174\t  []\n  4175\t  (list\n  4176\t    'fn\n  4177\t    []\n  4178\t    (list\n  4179\t      'if\n  4180\t      (list '= 'js.rt/state :js/uninit)\n  4181\t      (concat\n  4182\t        ['do\n  4183\t         (define 'js.rt/ctx '(cell/new (js/ctx nil)))\n  4184\t         (define 'js.rt/out '(cell/new []))\n  4185\t         retained-store-install\n  4186\t         (define 'js.rt/obj-proto '(js/make-object :js/null))\n  4187\t         (define 'js.rt/fn-proto '(js/make-object js.rt/obj-proto))\n  4188\t         (define 'js.rt/global '(js/make-object js.rt/obj-proto))]\n  4189\t        [(define 'js.rt/error-proto '(js/make-object js.rt/obj-proto))]\n  4190\t        (mapv (fn [[_ key base]] (define key (list 'js/make-object base)))\n  4191\t              (rest error-classes))\n  4192\t        (mapv (fn [[key _ _]] (define key '(js/make-object js.rt/obj-proto)))\n  4193\t              primitive-protos)\n  4194\t        [(define 'js.rt/symbol-proto '(js/make-object js.rt/obj-proto))\n  4195\t         (define 'js.rt/array-proto '(js/make-object js.rt/obj-proto))]\n  4196\t        (mapcat (fn [[proto ms]]\n  4197\t                  (mapv (fn [[nm n code]]\n  4198\t                          (list 'js/def-method! proto nm n code))\n  4199\t                        ms))\n  4200\t                methods-of)\n  4201\t        (mapcat (fn [[nm key _]]\n  4202\t                  [(list 'js/define-own!\n  4203\t                         key\n  4204\t                         {:js/str \"name\"}\n  4205\t                         (list 'js/slot {:js/str nm} true false true))\n  4206\t                   (list 'js/define-own!\n  4207\t                         key\n  4208\t                         {:js/str \"message\"}\n  4209\t                         (list 'js/slot {:js/str \"\"} true false true))\n  4210\t                   (list 'js/install-ctor-nt!\n  4285\t                    (js/spread-array-items (get (cell/get value) :items) 0 []))\n  4286\t         (js/throw-type-error {:js/str \"Spread value is not iterable\"})))]])\n  4287\t\n  4288\t\n  4289\t(def definitions\n  4290\t  \"The single definition list, `[store-key form]` in definition order:\n  4291\t   every prelude function, the literal state slot, then `js/init!`.\n  4292\t   Defining them runs nothing.\"\n  4293\t  (into (into (into (into (into (into core-definitions object-definitions)\n  4294\t                                t4-definitions)\n  4295\t                          array-definitions)\n  4296\t                    json-definitions)\n  4297\t              class-definitions)\n  4298\t        [['js.rt/state :js/uninit] ['js/init! (init-form)]]))\n  4299\t\n  4300\t\n  4301\t(def ^:private linked-definitions\n  4302\t  \"The `js` module body; the common call runtime is pinned as a requirement.\"\n  4303\t  definitions)\n  4304\t\n  4305\t\n  4306\t(defn- definitions->uast\n  4307\t  [defs]\n  4308\t  ;; A linear `then` chain adds two tree levels per definition and can\n  4309\t  ;; overflow the host printer's stack. Balance the sequence, preserving\n  4310\t  ;; left-to-right effects and the last definition's value.\n  4311\t  (letfn [(sequence-tree\n  4312\t            [nodes]\n  4313\t            (if (<= (count nodes) 1)\n  4314\t              (first nodes)\n  4315\t              (let [middle (quot (count nodes) 2)]\n  4316\t                (u/then (sequence-tree (subvec nodes 0 middle))\n  4317\t                        (sequence-tree (subvec nodes middle))))))]\n  4318\t    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n  4319\t\n  4320\t\n  4321\t(def functions-uast\n  4322\t  \"The shared calling runtime followed by every js definition. Defining\n  4323\t   them runs nothing, so this loads on any composition, with or without cells.\"\n  4324\t  (definitions->uast (into call/definitions definitions)))\n  4325\t\n  4326\t\n  4327\t(def uast\n  4328\t  \"The bundled prelude: every definition, then the task's runtime state\n  4329\t   allocated by `js/init!`.\"\n  4330\t  (u/then functions-uast (u/sexp->uast '(js/init!))))\n  4331\t\n  4332\t\n  4333\t;; =============================================================================\n  4334\t;; The linked js module requires the separately published `yang.call` module\n  4335\t;; =============================================================================\n  4336\t\n  4337\t(def module-name\n  4338\t  \"The linker module the JavaScript runtime profile is published as.\"\n  4339\t  'js)\n  4340\t\n  4341\t\n  4342\t(def runtime-keys\n  4343\t  \"Every key `js/init!` allocates, the ready flag aside, sorted.\"\n  4344\t  (vec (sort-by str\n  4345\t                (concat '[js.rt/ctx js.rt/out js.rt/global js.rt/obj-proto\n  4346\t                          js.rt/fn-proto js.rt/symbol-proto js.rt/array-proto]\n  4347\t                        (map second error-classes)\n  4348\t                        (map first primitive-protos)))))\n  4349\t\n  4350\t\n  4351\t(defn strip\n  4352\t  \"`sym` without the module's own namespace `js`; any other value as it\n  4353\t   is. `js.rt/*` stays qualified: an internal store key.\"\n  4354\t  [sym]\n  4355\t  (core/strip \"js\" sym))\n  4356\t\n  4357\t\n  4358\t(def ^:private module-definitions\n  4359\t  \"The module's definition list: a `:js/uninit` placeholder for every\n  4360\t   runtime key, then every definition, stripped.\"\n  4361\t  (core/module-definitions \"js\" :js/uninit runtime-keys linked-definitions))\n  4362\t\n  4363\t\n  4364\t(def module-uast\n  4365\t  \"The module tree: one application whose operands are the definitions, in\n  4366\t   order, applied to a lambda that returns nil.\"\n  4367\t  (core/module-tree module-definitions []))\n  4368\t\n  4369\t\n  4370\t(def module-exports\n  4371\t  \"The module's exports: every `js/` key of the definition list, stripped.\"\n  4372\t  (core/exports \"js\" definitions))\n  4373\t\n  4374\t\n  4375\t(def free-names\n  4376\t  \"Every variable name some occurrence of the map AST reads unbound by an\n  4377\t   enclosing lambda.\"\n  4378\t  core/free-names)\n","exit_code":0,"status":"completed"}}
