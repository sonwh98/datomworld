-exports 'retained-condition))\n+      \"retained-condition is not a module export: no frozen pre-init binding\")\n+  (is (not (contains? js-prelude/module-exports 'raise-protocol))\n+      \"raise-protocol is not a module export: no frozen pre-init binding\"))\n+\n+\n+(deftest ^{:slow true :gates #{::contract/r5} :frontends #{:typescript}}\n+  typescript-copied-wrapper-forgery-test\n+  ;; A fresh cell carrying a copy of a genuine protocol wrapper's complete\n+  ;; contents, thrown from another activation, must NOT forward the\n+  ;; original condition: provenance is bound to the genuine wrapper's\n+  ;; identity, not to its copyable contents.\n+  (doseq [[backend actual] (probes/run-typescript-forgery :copied)]\n+    (if (instance? Throwable actual)\n+      (do-report {:type :error :message (str \"copied wrapper \" backend \" operational failure\")\n+                  :expected {:retained true :copy-refused true} :actual actual})\n+      (is (= {:retained true :copy-refused true} actual)\n+          (str \"copied wrapper \" backend)))))\nsrc/cljc/yin/vm/engine.cljc:127:    (vm/refuse-reserved! :variable name))\nsrc/cljc/yin/vm/engine.cljc:207:  \"The store free reads and `:store-get` resolve against: while a module\nsrc/cljc/yin/vm/engine.cljc:1717:                           (into (subvec ws 0 i) (subvec ws (inc i)))))\nsrc/cljc/yin/vm/engine.cljc:1808:                      (subvec ds (- (count ds) ffi-diagnostics-cap))\nsrc/cljc/yin/vm/engine.cljc:1965:        (assoc :wait-set (into (subvec ws 0 i) (subvec ws (inc i))))\nsrc/cljc/yin/vm/engine.cljc:2301:            rest-queue (subvec run-queue 1)\nsrc/cljc/yin/vm/data.cljc:156:            (= needle (subvec hay i (+ i m))) i\nsrc/cljc/yin/vm/data.cljc:226:(defn- data-subvec\nsrc/cljc/yin/vm/data.cljc:227:  ([v start] (data-subvec v start (if (vector? v) (count v) 0)))\nsrc/cljc/yin/vm/data.cljc:229:   (vector! 'subvec 0 v)\nsrc/cljc/yin/vm/data.cljc:230:   (let [start (index! 'subvec 1 start)\nsrc/cljc/yin/vm/data.