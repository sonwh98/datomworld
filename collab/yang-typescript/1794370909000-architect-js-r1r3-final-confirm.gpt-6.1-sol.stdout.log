ations]\n  1104\t  (let [sites (vec applications)\n  1105\t        usable-sites? (and (sequential? applications)\n  1106\t                           (every? (fn [s] (some? (:at s))) sites))\n  1107\t        by-name (group-by :name definitions)\n  1108\t        unconditional (fn [defs]\n  1109\t                        (filter (fn [d]\n  1110\t                                  (and (some? (:at d))\n  1111\t                                       (false? (:conditional? d))))\n  1112\t                                defs))\n  1113\t        verdict\n  1114\t        (fn [occ]\n  1115\t          (let [at (:at occ)]\n  1116\t            (if (nil? at)\n  1117\t              :retained\n  1118\t              (let [defs (get by-name (:name occ))]\n  1119\t                (if-not (:in-body? occ)\n  1120\t                  (let [dominating (filter (fn [d]\n    37\t            [yin.vm :as vm]\n    38\t            [yin.vm.ffi :as ffi]\n    39\t            [dao.host.integer :as integer-host]\n    40\t            [yin.vm.linker :as linker]\n    41\t            [yin.vm.module :as module]\n    42\t            [yin.vm.telemetry :as telemetry]\n    43\t            [yin.vm.values :as values]))\n    44\t\n    45\t\n    46\t(defn- outcome\n    47\t  [result]\n    48\t  (:dao.stream/outcome result))\n    49\t\n    50\t\n    51\t(defn- fail\n    52\t  [message data]\n    53\t  (throw (ex-info message data)))\n    54\t\n    55\t\n    56\t(defn bind-params\n    57\t  \"Zips params with args, nil-filling any params beyond args' length.\n    58\t   Extra args beyond params' length are dropped. §7.7.2: an under-arity\n    59\t   call leaves missing parameter names bound to nil, not absent.\"\n    60\t  [params args]\n    61\t  (into {} (map vector params (concat args (repeat nil)))))\n    62\t\n    63\t\n    64\t;; =============================================================================\n    65\t;; Application refusals (D6)\n   290\t;; Stream handles, cursor cells, the FFI pair, and the link pair live in the\n   291\t;; private `:resources` table of VM state. The engine's own machinery reads\n   292\t;; and writes only that table; no store instruction and no `resolve-var`\n   293\t;; step consults it. A program holds only references, and every reference\n   294\t;; the engine issues carries a seal over its kind and id under the task's\n   295\t;; capability secret, which the composition minted and which lives in VM\n   296\t;; state alone. Every effect that resolves a program-supplied reference\n   297\t;; verifies the seal first: a literal with a wrong or missing seal fails\n   298\t;; closed with `:forged-resource-reference`.\n   299\t\n   300\t(defn- seal-of\n   301\t  \"The seal of a `kind` reference to resource `id` under `secret`.\"\n   302\t  [secret kind id]\n   303\t  (jing/content-hash [:yin.k/seal secret kind id] {:algorithm :blake3}))\n   304\t\n   305\t\n   306\t(defn- cursor-cell?\n   307\t  \"True when a resource is a cursor cell, `{:stream-id id :cursor c}`.\n   308\t   A cursor cell is the VM's mutable box (with identity) holding one\n   309\t   immutable `dao.stream` cursor; `:stream/next` overwrites its `:cursor`\n   310\t   with the successor. A guest program holds a sealed `:cursor-ref` naming\n   311\t   it, never the cell itself. Not to be confused with `yin.vm.cell`, the\n   312\t   general heap box. Vocabulary: UCF §7.5.3, \\\"Terminology\\\".\"\n   313\t  [resource]\n   314\t  (and (map? resource) (contains? resource :stream-id)))\n   315\t\n   316\t\n   317\t(defn issue-ref\n   318\t  \"A reference of `kind` (`:stream-ref`, `:cursor-ref`, or `:cell-ref`) to\n   319\t   resource or heap cell `id`, sealed under the task's capability secret.\n   320\t   A task composed\n   321\t   without a secret cannot issue one: it fails closed rather than issue a\n   322\t   reference anyone could forge.\"\n   323\t  [state kind id]\n   324\t  (let [secret (:capability-secret state)]\n   325\t    (when (nil? secret)\n   326\t      (fail (str \"This task has no capability secret, so it cannot issue\"\n   327\t                 \" a resource reference\")\n   328\t            {:reason :no-capability-secret, :kind kind, :id id}))\n   329\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\n   330\t\n   331\t\n   332\t(defn authentic-ref?\n   333\t  \"True when `ref` is a `kind` reference this task issued: its seal\n   334\t   verifies under the task's secret, and it names a live resource of that\n   335\t   kind. A `:cell-ref` is checked against `:heap` instead: its id is live\n   336\t   by `contains?` (a cell may hold nil) and its seal equals the one the\n   337\t   heap entry recorded at allocation, so no hash is computed per access.\"\n   338\t  [state kind ref]\n   339\t  (let [secret (:capability-secret state)\n   340\t        id (when (map? ref) (:id ref))]\n   341\t    (if (= :cell-ref kind)\n   342\t      (let [heap (:heap state)]\n   343\t        (boolean (and (some? secret)\n   344\t                      (= kind (:type ref))\n   345\t                      (contains? heap id)\n   346\t                      (= (:seal ref) (:seal (get heap id))))))\n   347\t      (let [resource (get (:resources state) id)]\n   348\t        (boolean (and (some? secret)\n   349\t                      (= kind (:type ref))\n   350\t                      (some? resource)\n   351\t                      (= (:seal ref) (seal-of secret kind id))\n   352\t                      (= (= :cursor-ref kind) (cursor-cell? resource))))))))\n   353\t\n   354\t\n   355\t(defn check-ref!\n   356\t  \"The resource id a program-supplied `kind` reference names, once its\n   357\t   seal verifies (r10). Anything else fails closed with\n   358\t   `:forged-resource-reference`, naming the effect and the id it named;\n   359\t   a cell ref whose id the heap does not hold is\n   360\t   `:dead-or-forged-reference` instead: its cell was swept, or never was.\n   361\t   Ids are never reused, so such a ref is never silently reallocated.\"\n   362\t  [state effect-kind kind ref]\n   363\t  (if (authentic-ref? state kind ref)\n   364\t    (:id ref)\n   365\t    (let [id (when (map? ref) (:id ref))\n   366\t          dead? (and (= :cell-ref kind) (not (contains? (:heap state) id)))]\n   367\t      (fail (if dead? \"Dead or forged cell reference\" \"Forged resource reference\")\n   368\t            {:reason (if dead?\n   369\t                       :dead-or-forged-reference\n   370\t                       :forged-resource-reference),\n   371\t             :effect effect-kind,\n   372\t             :kind kind,\n   373\t             :id id}))))\n   374\t\n   375\t\n  1030\t        [state cell-ids]\n  1031\t        (reduce (fn [[s acc] [cid cell]]\n  1032\t                  (let [[id s] (gensym s \"cursor\")\n  1033\t                        stream-id (get streams\n  1034\t                                       (get-in cell [:yin.k/stream\n  1035\t                                                     :dao.stream/identity]))]\n  1036\t                    [(assoc-in s [:resources id]\n  1037\t                               (vm/cursor-entry stream-id\n  1038\t                                                (:yin.k/position cell)))\n  1039\t                     (assoc acc cid id)]))\n  1040\t                [state {}]\n  1041\t                (map vector used lifted))]\n  1042\t    [state streams cell-ids]))\n  1043\t\n  1044\t\n  1045\t(defn- encode-store\n  1046\t  [encode store]\n  1047\t  (into {} (map (fn [[k v]] [(encode k) (encode v)])) store))\n  1048\t\n  1049\t\n  1050\t(defn- decode-store\n  1051\t  [decode snapshot]\n  1052\t  (into {} (map (fn [[k v]] [(decode k) (decode v)])) snapshot))\n  1053\t\n  1054\t\n  1055\t(defn lift-slice\n  1056\t  \"Act 1 of `linked` (yin.vm.linker.md section 7.3): the halted child's\n  1057\t   exports and module stores in the portable encoding. `own` is the\n  1058\t   module's manifest address. Returns `{:slice {sym encoded} :stores\n  1059\t   {address snapshot} :cells {cell-id cell} :origins #{segment}}`: one\n  1060\t   snapshot per module -- the child's own store under `own`, and every\n  1061\t   dependency store the encoding reaches as it stands in the child at\n  1062\t   halt, mutations included -- and the logical cursor cells the encoded\n  1063\t   references name. A `:store-of` with no snapshot is\n  1064\t   `:yin.k/non-portable` of kind `:missing-module-store`; any refused leaf\n  1065\t   refuses the lift.\"\n  1066\t  [child own exports]\n  1067\t  (let [found (atom {:origins #{}, :stores #{}, :cells {}, :cell-of {}})\n  1068\t        encode (encoder child own found)\n  1069\t        store (:store child)\n  1070\t        slice (into {} (map (fn [k] [k (encode (get store k))])) exports)\n  1071\t        stores (loop [stores {own (encode-store encode store)}]\n  1072\t                 (let [pending (remove #(contains? stores %)\n  1073\t                                       (sort-by str (:stores @found)))]\n  1074\t                   (if (empty? pending)\n  1075\t                     stores\n  1076\t                     (recur\n  1077\t                       (reduce\n  1078\t                         (fn [acc m]\n  1079\t                           (if-let [s (get-in child [:module-stores m])]\n  1080\t                             (assoc acc m (encode-store encode s))\n  1081\t                             (non-portable! :missing-module-store\n  1082\t                                            {store-of-key m})))\n  1083\t                         stores\n  1084\t                         pending)))))]\n  1085\t    {:slice slice,\n  1086\t     :stores stores,\n  1087\t     :cells (:cells @found),\n  1088\t     :origins (:origins @found)}))\n  1089\t\n  1090\t\n  1091\t(defn receive-module\n  1092\t  \"Acts 3 and 4 of `linked` for one receiving task (yin.vm.linker.md\n  1093\t   section 7.3): attach every origin image of `entry` the kernel does not\n  1094\t   yet hold, non-destructively; lower the resources the slice and the\n  1095\t   snapshots it instantiates reference into the task's private\n  1096\t   `:resources` (r9); lower the slice against this task's own\n  1097\t   coordinates into the entry's `:bindings`, every reference re-sealed\n  1098\t   under this task's secret (r10); and instantiate each store snapshot\n  1099\t   into `:module-stores` unless the task already holds that module's\n  1100\t   store -- first link wins, a live instance is never overwritten.\n  1101\t   Nothing is written into the task's own `:store`. A registry pin\n  1102\t   conflict throws its refusal data before any attachment or lowering.\"\n  1103\t  [state module-name entry]\n  1104\t  (when-let [refusal (module/pin-conflict (:modules state) module-name entry)]\n  1105\t    (throw (ex-info \"Module dependency pin mismatch\" refusal)))\n  1106\t  (let [attached (reduce module/attach-module state\n  1107\t                         (map val (sort-by key (:images entry))))\n  1108\t        held (or (:module-stores attached) {})\n  1109\t        fresh (into {} (remove #(contains? held (key %))) (:stores entry))\n  1110\t        [attached streams cells]\n  1111\t        (lower-resources attached\n  1112\t                         (concat (vals (:slice entry)) (vals fresh))\n  1113\t                         (:cells entry))\n  1114\t        decode (decoder attached streams cells)\n  1115\t        bindings (into {}\n  1116\t                       (map (fn [[k v]] [k (decode v)]))\n  1117\t                       (:slice entry))\n  1118\t        stores (into held\n  1119\t                     (map (fn [[m snapshot]]\n  1120\t                            [m (decode-store decode snapshot)]))\n  1121\t                     fresh)]\n  1122\t    (-> attached\n  1123\t        (assoc :module-stores stores)\n  1124\t        (update :modules module/assoc-module module-name\n  1125\t                (assoc entry :bindings bindings)))))\n  1126\t\n  1127\t\n  1128\t;; =============================================================================\n  1129\t;; Link waits and the install child (yin.vm.linker.md sections 7.2 to 7.4)\n  1130\t;; =============================================================================\n  1131\t\n  1132\t(def ^:private link-reasons\n  1133\t  \"The wait reasons `require` adds: the two link states and the install.\"\n  1134\t  #{:link-request :link-response :install})\n  1135\t\n","exit_code":0,"status":"completed"}}
