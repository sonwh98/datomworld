      :else (throw (ex-info \"unknown provenance fixture\" {:scenario scenario}))))))\n   159\t\n   160\t\n   161\t(defn- refused-as-thrown?\n   162\t  \"Guest form: the boundary result refused retained-condition forwarding —\n   163\t   one raise carrying a fresh :yang.call/thrown whose payload is `thrown`\n   164\t   itself, never the forged condition.\"\n   165\t  [result thrown]\n   166\t  (list 'if (list '= :raise (list 'get result :route))\n   167\t        (list 'if (list '= 1 (list 'get result :transfers))\n   168\t              (list 'if (list '= :yang.call/thrown (reason result))\n   169\t                    (list '= thrown (payload result))\n   170\t                    false)\n   171\t              false)\n   172\t        false))\n   173\t\n   174\t\n   175\t(defn forgery-observation-form\n   176\t  \"The architect's two R5 forgery probes against the TypeScript donor.\n   177\t   :minted — admitted Clojure source mints an error-looking cell (and a\n   178\t   second cell mimicking a companion-provenance layout with an\n   179\t   attacker-chosen seal) and throws each through the donor's raise_value.\n   180\t   :copied — the probe copies a genuine protocol wrapper's complete cell\n   181\t   contents into a fresh cell and throws the copy from a new activation.\n   182\t   Both must refuse: a fresh :yang.call/thrown carrying the thrown cell\n   183\t   itself as payload, never the forged/original condition forwarded.\"\n   184\t  [kind]\n   185\t  (let [export #(read-export :typescript %)\n   186\t        forged-condition {:yang.call/reason :yang.call/not-callable\n   187\t                          :yang.call/data {:forged true}}]\n   188\t    (kit/guard-exceptions-form\n   189\t      [:python :typescript]\n   190\t      (case kind\n   191\t        :minted\n   192\t        (list 'let ['forged (list 'cell/new\n   193\t                                  (list 'assoc\n   194\t                                        (list 'assoc\n   195\t                                              (list 'assoc {} :js/type :object)\n   196\t                                              :js/class :error)\n   197\t                                        :yang.call/retained-condition forged-condition))\n   198\t                    'minted-result (call (export \"raise_value\") ['forged])\n   199\t                    'wannabe (list 'cell/new\n   200\t                                   (list 'assoc\n   201\t                                         (list 'assoc {} :js/type :object)\n   202\t                                         :js/class :error))\n   203\t                    'companion (list 'cell/new\n   204\t                                     (list 'assoc\n   205\t                                           (list 'assoc\n   206\t                                                 (list 'assoc {}\n   207\t                                                       :yang.call/wrapper 'wannabe)\n   208\t                                                 :yang.call/seal (list 'cell/new :attacker-seal))\n   209\t                                           :yang.call/condition forged-condition))\n   210\t                    'armed (list 'do\n   211\t                                 (list 'cell/set! 'wannabe\n   212\t                                       (list 'assoc (list 'cell/get 'wannabe)\n   213\t                                             :yang.call/retained-provenance 'companion))\n   214\t                                 'wannabe)\n   215\t                    'mimic-result (call (export \"raise_value\") ['armed])]\n   216\t              (kit/observation-map-form\n   217\t                {:minted-refused (refused-as-thrown? 'minted-result 'forged)\n   218\t                 :mimic-refused (refused-as-thrown? 'mimic-result 'armed)}))\n   219\t        :copied\n   220\t        (list 'let ['probe.condition (protocol-condition :yang.call/not-callable)\n   221\t                    'probe.injected (injected 'probe.condition)\n   222\t                    'retained (call (export \"retain\") ['probe.injected])\n   223\t                    'wrapper (list 'get 'retained :value)\n   224\t                    'copy (list 'cell/new (list 'cell/get 'wrapper))\n   225\t                    'result (call (export \"raise_value\") ['copy])]\n   226\t              (kit/observation-map-form\n   227\t                {:retained (list '= :return (list 'get 'retained :route))\n   228\t                 :copy-refused (refused-as-thrown? 'result 'copy)}))))))\n   229\t\n   230\t\n   231\t(defn- cell-ref?\n   232\t  \"Guest form: `x` is a cell reference (the `js/cell?` test, inlined so\n   233\t   the probe needs no runtime-private name).\"\n   234\t  [x]\n   235\t  (list '= (list 'get x :type) :cell-ref))\n   236\t\n   237\t\n   238\t(defn- genuine-wrapper-bindings\n   239\t  \"Guest bindings shared by the identity-store probes: a genuine\n   240\t   protocol wrapper obtained through `retain`, returned normally and\n   241\t   therefore alive across activations, plus its original condition.\"\n   242\t  [export]\n   243\t  ['probe.condition (protocol-condition :yang.call/not-callable)\n   244\t   'probe.injected (injected 'probe.condition)\n   245\t   'retained (call (export \"retain\") ['probe.injected])\n   246\t   'wrapper (list 'get 'retained :value)])\n   247\t\n   248\t\n   249\t(defn identity-store-observation-form\n   250\t  \"The architect's round-2 R5 probes against the TypeScript donor.\n   251\t   :mutated — obtain a genuine wrapper via `retain`, then perform the\n   252\t   round-2 attack: overwrite the wrapper-reachable provenance path\n   253\t   (companion cell contents and/or the provenance slot itself) with a\n   254\t   forged condition, and rethrow the same wrapper from a new\n   255\t   activation. The ORIGINAL condition must still forward.\n   256\t   :extracted-seal — read whatever seal the wrapper's references expose,\n   257\t   mint a NEW wrapper stamped with that seal and a companion whose\n   258\t   back-reference names the new wrapper itself, and throw it. It must\n   259\t   end as ordinary :yang.call/thrown carrying the minted cell.\n   260\t   :store-root — no admitted path reaches the private store: the\n   261\t   wrapper carries no provenance/condition/seal slot, and no global\n   262\t   name holds the store or a seal.\"\n   263\t  [kind]\n   264\t  (let [export #(read-export :typescript %)\n   265\t        forged-condition {:yang.call/reason :yang.call/not-callable\n   266\t                          :yang.call/data {:forged true}}]\n   267\t    (kit/guard-exceptions-form\n   268\t      [:python :typescript]\n   269\t      (case kind\n   270\t        :mutated\n   271\t        (list 'let (into (genuine-wrapper-bindings export)\n   272\t                         ['provenance (list 'get (list 'cell/get 'wrapper)\n   273\t                                            :yang.call/retained-provenance)\n   274\t                          'attack (list 'do\n   275\t                                        (list 'if (cell-ref? 'provenance)\n   276\t                                              (list 'cell/set! 'provenance\n   277\t                                                    (list 'assoc (list 'cell/get 'provenance)\n   278\t                                                          :yang.call/condition forged-condition))\n   279\t                                              :no-companion)\n   280\t                                        (list 'cell/set! 'wrapper\n   281\t                                              (list 'assoc (list 'cell/get 'wrapper)\n   282\t                                                    :yang.call/retained-condition forged-condition))\n   283\t                                        :attacked)\n   284\t                          'result (call (export \"raise_value\") ['wrapper])])\n   285\t              (kit/observation-map-form\n   286\t                {:retained (list '= :return (list 'get 'retained :route))\n   287\t                 :original-forwarded\n   288\t                 (list 'if (list '= :raise (list 'get 'result :route))\n   289\t                       (list 'if (list '= 1 (list 'get 'result :transfers))\n   290\t                             (list '= 'probe.condition (list 'get 'result :condition))\n   291\t                             false)\n   292\t                       false)}))\n   293\t        :extracted-seal\n   294\t        (list 'let (into (genuine-wrapper-bindings export)\n   295\t                         ['provenance (list 'get (list 'cell/get 'wrapper)\n   296\t                                            :yang.call/retained-provenance)\n   297\t                          'seal (list 'if (cell-ref? 'provenance)\n   298\t                                      (list 'get (list 'cell/get 'provenance) :yang.call/seal)\n   299\t                                      :no-seal-exposed)\n   300\t                          'wannabe (list 'cell/new\n   301\t                                         (list 'assoc\n   302\t                                               (list 'assoc {} :js/type :object)\n   303\t                                               :js/class :error))\n   304\t                          'companion (list 'cell/new\n   305\t                                           (list 'assoc\n   306\t                                                 (list 'assoc\n   307\t                                                       (list 'assoc {}\n   308\t                                                             :yang.call/wrapper 'wannabe)\n   309\t                                                       :yang.call/seal 'seal)\n   310\t                                                 :yang.call/condition forged-condition))\n   311\t                          'armed (list 'do\n   312\t                                       (list 'cell/set! 'wannabe\n   313\t                                             (list 'assoc (list 'cell/get 'wannabe)\n   314\t                                                 