{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/core/prelude.cljc | sed -n '1,135p'; nl -ba src/cljc/yin/vm/linker.cljc | sed -n '1040,1120p'; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '37,65p;290,375p;1030,1135p'\"","aggregated_output":"     1\t(ns yang.core.prelude\n     2\t  \"Emitter machinery shared by every language's runtime-profile prelude\n     3\t   (docs/design/yang.typescript.md §17, lift L1). A language supplies its\n     4\t   module's own namespace string, its uninit sentinel, its definition list\n     5\t   and its refusal namespace; everything here is a pure function of those.\"\n     6\t  (:require\n     7\t    [clojure.walk :as walk]\n     8\t    [yang.core.uast :as u]\n     9\t    [yin.vm :as vm]\n    10\t    [yin.vm.module :as module]))\n    11\t\n    12\t\n    13\t(defn define\n    14\t  \"`(yin/def (quote key) form)` in prelude notation: the key quoted, so\n    15\t   `sexp->uast` reads it as the literal symbol Rule R requires.\"\n    16\t  [key form]\n    17\t  (list 'yin/def (list 'quote key) form))\n    18\t\n    19\t\n    20\t(defn strip\n    21\t  \"`sym` without the module's own namespace `ns-str`; any other value as it\n    22\t   is. Qualified internal store keys stay qualified.\"\n    23\t  [ns-str sym]\n    24\t  (if (and (symbol? sym) (= ns-str (namespace sym)))\n    25\t    (symbol (name sym))\n    26\t    sym))\n    27\t\n    28\t\n    29\t(defn strip-form\n    30\t  \"A prelude-notation form with every symbol `strip`ped: references,\n    31\t   definition keys and quoted keys alike. Keywords, strings and the\n    32\t   keys of literal maps are untouched.\"\n    33\t  [ns-str form]\n    34\t  (walk/postwalk (partial strip ns-str) form))\n    35\t\n    36\t\n    37\t(defn placeholder\n    38\t  \"The `[k uninit]` definition for runtime key `k`, so each read of it is\n    39\t   discharged by an unconditional module-level definition.\"\n    40\t  [k uninit]\n    41\t  [k uninit])\n    42\t\n    43\t\n    44\t(defn module-definitions\n    45\t  \"The module's definition list: a `uninit` placeholder for every runtime\n    46\t   key (stripped of `ns-str`), then every definition, stripped.\"\n    47\t  [ns-str uninit runtime-keys definitions]\n    48\t  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n    49\t        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n    50\t        definitions))\n    51\t\n    52\t\n    53\t(defn wide-app\n    54\t  \"One application whose operands are `nodes` (in order), applied to a lambda\n    55\t   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n    56\t   linker's scanners discharge every body read of a sibling or runtime key;\n    57\t   a `then` chain would nest definitions in closure bodies.\"\n    58\t  [nodes]\n    59\t  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    60\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n    61\t\n    62\t\n    63\t(defn module-tree\n    64\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    65\t   the `trailing` UAST nodes.\"\n    66\t  [defs trailing]\n    67\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    68\t                  trailing)))\n    69\t\n    70\t\n    71\t(defn exports\n    72\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    73\t   stripped.\"\n    74\t  [ns-str definitions]\n    75\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    76\t             definitions)))\n    77\t\n    78\t\n    79\t(defn free-names\n    80\t  \"Every variable name some occurrence of the map AST `ast` reads\n    81\t   unbound by an enclosing lambda.\"\n    82\t  [ast]\n    83\t  (letfn [(walk-node\n    84\t            [acc node bound]\n    85\t            (cond\n    86