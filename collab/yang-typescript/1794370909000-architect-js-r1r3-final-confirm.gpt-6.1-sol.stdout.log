{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '115,155p;200,263p;1090,1135p'; nl -ba src/cljc/yang/typescript/antlr/safepoint.cljc | sed -n '85,150p'; nl -ba src/cljc/yang/typescript/antlr/lower.cljc | sed -n '2235,2350p'; nl -ba test/yang/call/conformance.clj | sed -n '234,253p'\"","aggregated_output":"   115\t\n   116\t(defn resolve-var\n   117\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n   118\t\n   119\t   A reserved name (Rule R: `yin/def` is syntax, never a name) is refused\n   120\t   before env or store is consulted, so no binding, store entry, or\n   121\t   registry can give it a meaning. Every executing variable lookup of\n   122\t   every engine goes through here.\n   123\t\n   124\t   The registry is a value supplied by the composition, not a global.\"\n   125\t  [env store primitives registry name]\n   126\t  (when (vm/reserved-name? name)\n   127\t    (vm/refuse-reserved! :variable name))\n   128\t  (if-let [pair (find env name)]\n   129\t    (val pair)\n   130\t    (if-let [pair (find store name)]\n   131\t      (val pair)\n   132\t      (if-let [pair (find primitives name)]\n   133\t        (vm/primitive-function (val pair))\n   134\t        (if-let [resolved (when (namespace name)\n   135\t                            (module/resolve-module\n   136\t                              registry\n   137\t                              (symbol (str (namespace name)\n   138\t                                           \".\"\n   139\t                                           (clojure.core/name name)))))]\n   140\t          resolved\n   141\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n   142\t                {:symbol name}))))))\n   143\t\n   144\t\n   145\t(defn check-store-key!\n   146\t  \"Refuse a program store access whose key is a reserved name (Rule R):\n   147\t   the definition operator is never a store key.\"\n   148\t  [key]\n   149\t  (when (vm/reserved-name? key)\n   150\t    (vm/refuse-reserved! :store-key key)))\n   151\t\n   152\t\n   153\t(defn store-put\n   154\t  \"The one program store write: every definition transition, the\n   155\t   `:vm/store-put` effect, and the four direct store instructions write\n   200\t   positional kernels' `:store-of` register, else the named kernels'\n   201\t   environment.\"\n   202\t  [state]\n   203\t  (or (:store-of state) (env-store-of (:env state))))\n   204\t\n   205\t\n   206\t(defn active-store\n   207\t  \"The store free reads and `:store-get` resolve against: while a module\n   208\t   closure runs (`store-of` non-nil), its module store, with no ambient\n   209\t   fallback -- a key the module store lacks is absent; otherwise the\n   210\t   task's own store.\"\n   211\t  [state store-of]\n   212\t  (if (some? store-of)\n   213\t    (get (:module-stores state) store-of {})\n   214\t    (:store state)))\n   215\t\n   216\t\n   217\t(defn put-active\n   218\t  \"Write `key` in the active store of `state`: the module store\n   219\t   `store-of` names, or the task's own store at top level. Both go\n   220\t   through `store-put`, so a reserved key is refused either way.\"\n   221\t  [state store-of key val]\n   222\t  (if (some? store-of)\n   223\t    (update-in state [:module-stores store-of]\n   224\t               (fn [module-store] (store-put (or module-store {}) key val)))\n   225\t    (assoc state :store (store-put (:store state) key val))))\n   226\t\n   227\t\n   228\t(defn- gen-id\n   229\t  \"Generate a unique keyword ID from a prefix and counter value.\"\n   230\t  [prefix id-counter]\n   231\t  (keyword (str prefix \"-\" id-counter)))\n   232\t\n   233\t\n   234\t(defn vm-blocked?\n   235\t  \"Returns true if the VM is blocked.\"\n   236\t  [vm]\n   237\t  (boolean (:blocked? vm)))\n   238\t\n   239\t\n   240\t(defn vm-value\n   241\t  \"Returns the current value of the VM.\"\n   242\t  [vm]\n   243\t  (:value vm))\n   244\t\n   245\t\n   246\t(defn halted-with-empty-queue?\n   247\t  \"Returns true if the VM has halted and its ready-queue is empty.\"\n   248\t  [vm]\n   249\t  (and (boolean (:halted? vm)) (empty? (or (:ready-queue vm) []))))\n   250\t\n   251\t\n   252\t(defn restore-initial-env\n   253\t  \"After eval, restore :env to initial-env when the computation halted.\n   254\t   Blocked and parked states keep the active lexical env for resumption.\"\n   255\t  [initial-env result]\n   256\t  (if (halted-with-empty-queue? result) (assoc result :env initial-env) result))\n   257\t\n   258\t\n   259\t(defn active-continuation?\n   260\t  \"Returns true when the currently active continuation should keep stepping.\"\n   261\t  [vm]\n   262\t  (and (not (:blocked? vm)) (not (:halted? vm))))\n   263\t\n  1090\t\n  1091\t(defn receive-module\n  1092\t  \"Acts 3 and 4 of `linked` for one receiving task (yin.vm.linker.md\n  1093\t   section 7.3): attach every origin image of `entry` the kernel does not\n  1094\t   yet hold, non-destructively; lower the resources the slice and the\n  1095\t   snapshots it instantiates reference into the task's private\n  1096\t   `:resources` (r9); lower the slice against this task's own\n  1097\t   coordinates into the entry's `:bindings`, every reference re-sealed\n  1098\t   under this task's secret (r10); and instantiate each store snapshot\n  1099\t   into `:module-stores` unless the task already holds that module's\n  1100\t   store -- first link wins, a live instance is never overwritten.\n  1101\t   Nothing is written into the task's own `:store`. A registry pin\n  1102\t   conflict throws its refusal data before any attachment or lowering.\"\n  1103\t  [state module-name entry]\n  1104\t  (when-let [refusal (module/pin-conflict (:modules state) module-name entry)]\n  1105\t    (throw (ex-info \"Module dependency pin mismatch\" refusal)))\n  1106\t  (let [attached (reduce module/attach-module state\n  1107\t                         (map val (sort-by key (:images entry))))\n  1108\t        held (or (:module-stores attached) {})\n  1109\t        fresh (into {} (remove #(contains? held (key %))) (:stores entry))\n  1110\t        [attached streams cells]\n  1111\t        (lower-resources attached\n  1112\t                         (concat (vals (:slice entry)) (vals fresh))\n  1113\t                         (:cells entry))\n  1114\t        decode (decoder attached streams cells)\n  1115\t        bindings (into {}\n  1116\t                       (map (fn [[k v]] [k (decode v)]))\n  1117\t                       (:slice entry))\n  1118\t        stores (into held\n  1119\t                     (map (fn [[m snapshot]]\n  1120\t                            [m (decode-store decode snapshot)]))\n  1121\t                     fresh)]\n  1122\t    (-> attached\n  1123\t        (assoc :module-stores stores)\n  1124\t        (update :modules module/assoc-module module-name\n  1125\t                (assoc entry :bindings bindings)))))\n  1126\t\n  1127\t\n  1128\t;; =============================================================================\n  1129\t;; Link waits and the install child (yin.vm.linker.md sections 7.2 to 7.4)\n  1130\t;; =============================================================================\n  1131\t\n  1132\t(def ^:private link-reasons\n  1133\t  \"The wait reasons `require` adds: the two link states and the install.\"\n  1134\t  #{:link-request :link-response :install})\n  1135\t\n    85\t         (do (js/define-own! e\n    86\t                             {:js/str \"name\"}\n    87\t                             (js/slot {:js/str \"Interrupt\"} true false true))\n    88\t             e)))]\n    89\t    [js.sp/deliver\n    90\t     ;; down to the outermost handler frame (the run's own), then throw:\n    91\t     ;; the guest handlers above it never see the interrupt\n    92\t     (fn [sig] (do (js/unwind-to 1) (js/throw (js.sp/interrupt))))]\n    93\t    [js.sp/poll\n    94\t     (fn []\n    95\t       (let [s (stream/poll! js.sp/cursor)]\n    96\t         (if (= s :dao.stream/blocked)\n    97\t           :js/undefined\n    98\t           (if (nil? s) :js/undefined (js.sp/deliver s)))))]\n    99\t    [js.sp/loop (fn [] (js.sp/poll))]\n   100\t    [js.sp/call (fn [] (js.sp/poll))]\n   101\t    [js.sp/attach!\n   102\t     ;; the linked wrapper's call: a module closure cannot read the task's\n   103\t     ;; ambient signal stream, so the wrapper passes its reference, and the\n   104\t     ;; cursor it mints is runtime state, never install-time state.\n   105\t     ;; Idempotent, like `js/init!`\n   106\t     (fn [signals]\n   107\t       (if (= js.sp/cursor :js/uninit)\n   108\t         (do (yin/def (quote js.sp/cursor) (stream/cursor signals))\n   109\t             :js/undefined)\n   110\t         :js/undefined))]])\n   111\t\n   112\t\n   113\t(def ^:private state-definitions\n   114\t  \"The bundled profile's runtime state, allocated while loading: the signal\n   115\t   cursor, nothing else.\"\n   116\t  '[[js.sp/cursor (stream/cursor js.sp/signals)]])\n   117\t\n   118\t\n   119\t(defn- definitions->uast\n   120\t  [defs]\n   121\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n   122\t\n   123\t\n   124\t(def uast\n   125\t  \"The bundled hook prelude: functions, then the signal cursor.\"\n   126\t  (u/mark-tails (u/then (definitions->uast function-definitions)\n   127\t                        (definitions->uast state-definitions))))\n   128\t\n   129\t\n   130\t(def noop-uast\n   131\t  \"Hooks that do nothing: the derived program under them is the naive one.\"\n   132\t  (u/mark-tails (definitions->uast '[[js.sp/loop (fn [] :js/undefined)]\n   133\t                                     [js.sp/call (fn [] :js/undefined)]])))\n   134\t\n   135\t\n   136\t(defn program\n   137\t  \"The bundled derived run's tree: `hooks` (a hook prelude), then the derived\n   138\t   program `ast`.\"\n   139\t  [hooks ast]\n   140\t  (u/then hooks ast))\n   141\t\n   142\t\n   143\t(defn linked-program\n   144\t  \"The linked safepointed run's tree: `js` required and initialized, `jssp`\n   145\t   required, the signal stream the composition bound under `signals-key`\n   146\t   attached, then the derived linked program `a'`, whose own require and\n   147\t   init are idempotent re-entries. The load order is the linked one, the\n   148\t   inverse of the bundled hook-prelude-first order.\"\n   149\t  [a']\n   150\t  (u/mark-tails\n  2235\t     :scope (:module analysis),\n  2236\t     :this (gen \"this\" (p/root pk)),\n  2237\t     :ret nil,\n  2238\t     :loop nil,\n  2239\t     :labels {},\n  2240\t     :pending-labels nil,\n  2241\t     :gen nil,\n  2242\t     :async nil,\n  2243\t     :class nil,\n  2244\t     :this-cell nil,\n  2245\t     :nt :undefined,\n  2246\t     :home nil,\n  2247\t     :class-cell nil,\n  2248\t     :privates {}}))\n  2249\t\n  2250\t\n  2251\t(defn- module-body\n  2252\t  [ctx]\n  2253\t  (let [root (p/root (:pk ctx))\n  2254\t        s (scope-of ctx root)\n  2255\t        stmts (statements-of ctx root)]\n  2256\t    (bind-cells (let [{:keys [vars tdz-names]} (binding-names s)]\n  2257\t                  (vec (concat (map (fn [nm] [nm undefined]) vars)\n  2258\t                               (map (fn [nm] [nm tdz]) tdz-names))))\n  2259\t                (seq-of (lower-stmts ctx stmts)))))\n  2260\t\n  2261\t\n  2262\t(defn lower-module-body\n  2263\t  \"The module's statements as one node, before the runtime wrapper: what\n  2264\t   lowering goldens compare.\"\n  2265\t  [packet]\n  2266\t  (module-body (context packet)))\n  2267\t\n  2268\t\n  2269\t(defn lower-unit\n  2270\t  \"One separately scoped module body as a function of its shared global\n  2271\t   receiver. Keeping this seam lets a host compose independently parsed\n  2272\t   units without concatenating source or reinitializing the runtime.\"\n  2273\t  [packet]\n  2274\t  (let [ctx (context packet)]\n  2275\t    (u/lam [(:this ctx)] (module-body ctx))))\n  2276\t\n  2277\t\n  2278\t(defn- with-runtime\n  2279\t  \"Both source entry points install the shared convention before JS.\"\n  2280\t  [prelude main]\n  2281\t  (u/mark-tails\n  2282\t    (case prelude\n  2283\t      :bundled (u/then prelude/uast main)\n  2284\t      :linked (u/seq-nodes [(app* 'require (u/lit 'yang.call))\n  2285\t                            (app* 'require (u/lit prelude/module-name))\n  2286\t                            (app* 'js/init!)\n  2287\t                            main]))))\n  2288\t\n  2289\t\n  2290\t(defn lower-units\n  2291\t  \"A complete program for multiple separately parsed units. The runtime is\n  2292\t   installed and initialized once; each unit receives its own lexical body\n  2293\t   while sharing the same global object and output stream.\"\n  2294\t  ([packets] (lower-units packets {}))\n  2295\t  ([packets {:keys [prelude], :or {prelude :bundled}}]\n  2296\t   (let [units (mapv lower-unit packets)\n  2297\t         main (names/canonicalize\n  2298\t                (app* 'js/run-main\n  2299\t                      (u/lam ['this]\n  2300\t                             (if (seq units)\n  2301\t                               (u/seq-nodes\n  2302\t                                 (mapv (fn [unit] (u/app unit (u/v 'this))) units))\n  2303\t                               (u/lit :js/undefined)))))]\n  2304\t     (with-runtime prelude main))))\n  2305\t\n  2306\t\n  2307\t(defn lower-packet\n  2308\t  \"The complete program for one ok packet: the module body run by\n  2309\t   `js/run-main`, generated names canonicalized, tail calls marked. Its\n  2310\t   value is `{:js/out [...] :js/uncaught nil-or-snapshot}`.\n  2311\t\n  2312\t   `:prelude` selects how the runtime profile arrives: `:bundled` (the\n  2313\t   default) carries the prelude tree ahead of the body; `:linked` requires\n  2314\t   the modules `yang.call` and `js` from the task's link pair,