.cljc\nnew file mode 100644\nindex 00000000..b5c07627\n--- /dev/null\n+++ b/test/yang/php/antlr/programs_p7b.cljc\n@@ -0,0 +1,70 @@\n+(ns yang.php.antlr.programs-p7b\n+  \"Tick observations recorded from the pinned PHP oracle pass.\")\n+\n+\n+(def prologue\n+  \"function tick_handler() { echo 'T'; } register_tick_function('tick_handler'); \")\n+\n+\n+(def fixtures\n+  [{:id :sequence, :source \"declare(ticks=1) { echo 'A'; $x = 1; echo 'B'; }\",\n+    :out \"ATTBT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :loop-body, :source \"for ($i=0; $i<2; $i++) { declare(ticks=1) { echo 'A'; } }\",\n+    :out \"ATAT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :function-call, :source \"function f() { echo 'F'; } declare(ticks=1) { f(); }\",\n+    :out \"FT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :generator-resume,\n+    :source \"function g() { declare(ticks=1) { yield 1; echo 'B'; } } $g=g(); $g->current(); echo 'A'; $g->next();\",\n+    :out \"ATBT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :sequence-n2, :source \"declare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\",\n+    :out \"ATB\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :nested-threshold,\n+    :source \"declare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\",\n+    :out \"ABCTD\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :cross-function,\n+    :source \"function f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\",\n+    :out \"AFT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :semicolon-directive, :source \"declare(ticks=2); echo 'A'; echo 'B';\",\n+    :out \"ATB\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :nested-zero-completion,\n+    :source \"declare(ticks=1) { declare(ticks=0) { echo 'A'; } echo 'B'; }\",\n+    :out \"ATBT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :hoisted-threshold,\n+    :source \"declare(ticks=1); function f() { echo 'F'; } f();\",\n+    :out \"TFTT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :unregister-executing,\n+    :source \"unregister_tick_function('tick_handler'); function self_remove() { echo 'S'; unregister_tick_function('self_remove'); } register_tick_function('self_remove'); declare(ticks=1) { echo 'A'; echo 'B'; }\",\n+    :out \"AS\", :diag [], :uncaught {:class \"Error\", :message \"Registered tick function cannot be unregistered while it is being executed\"}, :status 255, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :per-entry-reentry,\n+    :source \"unregister_tick_function('tick_handler'); function helper() { declare(ticks=1) { echo 'X'; } } function first_handler() { echo 'H'; helper(); } function second_handler() { echo 'Y'; } register_tick_function('first_handler'); register_tick_function('second_handler'); declare(ticks=1) { echo 'A'; echo 'B'; }\",\n+    :out \"AHXYYBHXYY\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :do-while-selection,\n+    :source \"declare(ticks=1) { echo 'A'; do { echo 'B'; } while (false); echo 'C'; }\",\n+    :out \"ATBTTCT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :for-selection,\n+    :source \"declare(ticks=1) { echo 'A'; for ($i=0; $i<2; $i++) { echo 'B'; } echo 'C'; }\",\n+    :out \"ATBTBTTCT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :foreach-selection,\n+    :source \"declare(ticks=1) { echo 'A'; foreach ([1,2] as $v) { echo 'B'; } echo 'C'; }\",\n+    :out \"ATBTBTTCT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :switch-selection,\n+    :source \"declare(ticks=1) { echo 'A'; switch (1) { case 1: echo 'B'; break; default: echo 'X'; } echo 'C'; }\",\n+    :out \"ATBTCT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :adjacent-marked,\n+    :source \"declare(ticks=1) { echo 'A'; $x=1; echo 'B'; }\",\n+    :out \"ATTBT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :nested-zero-n2,\n+    :source \"declare(ticks=2) { echo 'A'; declare(ticks=0) { echo 'B'; } echo 'C'; }\",\n+    :out \"ABTC\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :dispatch-add,\n+    :source \"unregister_tick_function('tick_handler'); function added() { echo 'N'; } function add_handler() { echo 'H'; register_tick_function('added'); } register_tick_function('add_handler'); declare(ticks=1) { echo 'A'; echo 'B'; }\",\n+    :out \"AHNBHNN\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :dispatch-remove,\n+    :source \"unregister_tick_function('tick_handler'); function remove_handler() { echo 'H'; unregister_tick_function('victim'); } function victim() { echo 'V'; } register_tick_function('remove_handler'); register_tick_function('victim'); declare(ticks=1) { echo 'A'; echo 'B'; }\",\n+    :out \"AHBH\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :generator-foreach,\n+    :source \"function g() { declare(ticks=1) { yield 1; echo 'G'; } } declare(ticks=1) { echo 'A'; foreach (g() as $v) { echo 'B'; } echo 'C'; }\",\n+    :out \"ATBTTGTTCT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}\n+   {:id :include-handoff, :source \"include 'lib.php';\",\n+    :units {\"lib.php\" \"<?php declare(ticks=1) { echo 'L'; }\"},\n+    :out \"LT\", :diag [], :uncaught nil, :status 0, :oracle \"php-8.3.35 shiva 2026-11-13\"}])\ndiff --git a/test/yang/php/antlr/siteset_test.clj b/test/yang/php/antlr/siteset_test.clj\nnew file mode 100644\nindex 00000000..c089af0b\n--- /dev/null\n+++ b/test/yang/php/antlr/siteset_test.clj\n@@ -0,0 +1,141 @@\n+(ns yang.php.antlr.siteset-test\n+  (:require\n+    [clojure.test :refer [deftest is]]\n+    [dao.jing :as jing]\n+    [dao.jing.mem :as mem]\n+    [yang.core.publication :as publication]\n+    [yang.core.module :as module]\n+    [yang.core.uast :as u]\n+    [yang.php.antlr.siteset :as siteset]\n+    [yin.vm.linker.sign :as sign]\n+    [yin.vm.linker.publish :as publish]\n+    [yin.vm.module :as vm-module]\n+    [yin.vm :as vm]))\n+\n+\n+(deftest publication-binds-occurrences-to-root\n+  (let [mark [:line 42 {:unit \"lib.php\", :ticks 2}]\n+        ast (vary-meta (u/lit 1) assoc :yang/site mark)\n+        store (mem/create-content-mem)\n+        pub (siteset/publish! store :manifest ast)\n+        empty-pub (siteset/publish! store :other (u/lit 1))]\n+    (is (= [[[] mark]] (:set pub)))\n+    (is (= [] (:set empty-pub)))\n+    (is (= (:yang.site/root (:record pub)) (:yang.site/root (:record empty-pub))))\n+    (is (= :manifest (:yang.site/manifest (:record pub))))))\n+\n+\n+(deftest verification-requires-the-bound-module-and-set\n+  (let [store (mem/create-content-mem)\n+        ast (u/lit 1)\n+        root (:root (siteset/site-set-of ast))\n+        manifest (jing/materialize! store {:yin.module/tree root})\n+        other (jing/materialize! store {:yin.module/tree :wrong})\n+        pub (siteset/publish! store manifest ast)]\n+    (is (= [] (:set (siteset/verify store manifest (:record-address pub)))))\n+    (is (nil? (siteset/verify store other (:record-address pub))))\n+    (is (nil? (siteset/verify store manifest :missing)))))\n+\n+\n+(deftest cyclic-aliases-publish-empty-sets\n+  (let [store (mem/create-content-mem)\n+        ast (u/lit 1)\n+        bundle {:name 'bundle, :ast ast}\n+        cfg {:imported-names :imports,\n+             :module-spec (fn [& _] (throw (ex-info \"expected cycle\" {}))),\n+             :scc-module-specs (fn [& _]\n+                                 [bundle {:name 'a, :ast ast}\n+                                  {:name 'b, :ast ast}]),\n+             :site-set siteset/publish!, :alias-site-set true,\n+             :refusal-ns \"test\",\n+             :publish-fn (fn [h spec]\n+                           {:status :ok, :address (jing/materialize!\n+                                                    h {:yin.module/tree (:root (siteset/site-set-of (:ast spec))),\n+                                                       :name (:name spec)})})}\n+        result (publication/publish-units! cfg store {} nil\n+                                           [{:name \"a\", :imports [\"b\"]}\n+                                            {:name \"b\", :imports [\"a\"]}] {})]\n+    (is (= :ok (:status result)))\n+    (is (= #{'bundle \"a\" \"b\"} (set (keys (:sites result)))))\n+    (doseq [[name address] (:addresses result)]\n+      (is (= [] (:set (siteset/verify store address\n+                                      (get-in result [:sites name :record-address]))))))))\n+\n+\n+(deftest signed-discovery-requires-an-authorized-untampered-entry\n+  (let [key (sign/generate)\n+        other (sign/generate)\n+        entry (siteset/signed-entry key :manifest :record)\n+        datoms (siteset/entry-datoms [entry])\n+        tampered (siteset/entry-datoms [(assoc-in entry [:envelope :yang.site/record] :other)])]\n+    (is (= [:record] (siteset/discover datoms [(:public key)] :manifest)))\n+    (is (empty? (siteset/discover datoms [(:public other)] :manifest)))\n+    (is (empty? (siteset/discover datoms [(:public key)] :other)))\n+    (is (empty? (siteset/discover tampered [(:public key)] :manifest)))))\n+\n+\n+(deftest derivation-requires-the-verified-publication\n+  (let [store (mem/create-content-mem)\n+        ast (vary-meta (u/lit 1) assoc :yang/site [:line 1 {:ticks 1}])\n+        env (siteset/site-set-of ast)\n+        tree (vm/ast->semantic-bytecode ast)\n+        manifest (jing/materialize! store {:yin.module/tree (:root env)})\n+        pub (siteset/publish! store manifest ast)\n+        profile {:line {:hook 'php.sp/line, :operands true, :after true}}\n+        derived (siteset/derive-verified store manifest (:record-address pub) tree profile)\n+        unselected (siteset/derive-verified store manifest (:record-address pub) tree {})]\n+    (is (some? derived))\n+    (is (= (:root tree) (get-in derived [:record :yin.ledger/input])))\n+    (is (= (:root (:tree derived)) (get-in derived [:record :yin.ledger/output])))\n+    (is (= (:set-address pub) (:site-set-address derived)))\n+    (is (= (:set-address pub)\n+           (get-in derived [:record :yin.ledger/profile :yang.site/published-set])))\n+    (is (= (:set-address pub)\n+           (get-in unselected [:record :yin.ledger/profile :yang.site/published-set])))\n+    (is (not= (:set-address pub)\n+              (get-in unselected [:record :yin.ledger/profile :yang.safepoint/sites])))\n+    (is (nil? (siteset/derive-verified store manifest :missing tree profile)))\n+    (is (nil? (siteset/derive-verified store manifest (:record-address pub)\n+                                       (assoc tree :root :wrong) profile)))))\n+\n+\n+(deftest stage-reports-missing-manifest\n+  (let [store (mem/create-content-mem)\n+        address (jing/segment-key {:missing true})\n+        stage (siteset/stage {} {:hooks true, :hooks-profile {}, :php-sp address} {})]\n+    (is (= {:status :missing, :address address}\n+           (stage {:store store} 'guest address)))))\n+\n+\n+(deftest stage-publishes-derived-closure-and-record\n+  (let [store (mem/create-content-mem)\n+        registry (vm-module/default-registry)\n+        spec (fn [name ast requires]\n+               {:name name, :ast ast, :exports #{}, :requires requires,\n+                :primitives (module/free-primitives :test/error :test/undeclared\n+                                                    registry (set (keys requires)) ast)})\n+        hook (publish/publish-module! store (spec 'php.sp (u/lit nil) {}))\n+        child-ast (u/lit 1)\n+        child (publish/publish-module! store (spec 'bundle child-ast {}))\n+        alias-ast (module/module-tree [(module/require-node 'bundle)])\n+        alias (publish/publish-module! store\n+                                       (spec 'alias alias-ast {'bundle (:address child)}))\n+        child-sites (siteset/publish! store (:address child) child-ast)\n+        alias-sites (siteset/publish! store (:address alias) alias-ast)\n+        key (sign/generate)\n+        datoms (siteset/entry-datoms\n+                 [(siteset/signed-entry key (:address child) (:record-address child-sites))\n+                  (siteset/signed-entry key (:address alias) (:record-address alias-sites))])\n+        stage (siteset/stage registry {:hooks true, :hooks-profile {},\n+                                       :php-sp (:address hook)} {})\n+        result (stage {:store store, :datoms datoms, :principals [(:public key)]}\n+                      'alias (:address alias))\n+        derived (jing/get store (:address result) nil)\n+        child-address (get-in derived [:yin.module/requires 'bundle])\n+        record (jing/get store (:derivation result) nil)]\n+    (is (= :ok (:status result)))\n+    (is (not= (:address child) child-address))\n+    (is (= (:address hook) (get-in derived [:yin.module/requires 'php.sp])))\n+    (is (= (:yin.module/tree derived) (:yin.ledger/output record)))\n+    (is (= (:set-address alias-sites)\n+           (get-in record [:yin.ledger/profile :yang.site/published-set])))))\ndiff --git a/test/yang/php/antlr/ticks_test.clj b/test/yang/php/antlr/ticks_test.clj\nnew file mode 100644\nindex 00000000..a18ec3ee\n--- /dev/null\n+++ b/test/yang/php/antlr/ticks_test.clj\n@@ -0,0 +1,27 @@\n+(ns yang.php.antlr.ticks-test\n+  (:require\n+    [clojure.test :refer [deftest is testing]]\n+    [yang.php.antlr.cst :as cst]\n+    [yang.php.antlr.e2e-harness :as h]\n+    [yang.php.antlr.linked-harness :as lh]\n+    [yang.php.antlr.programs-p7b :as p7b]))\n+\n+\n+(deftest tick-fixtures-test\n+  (doseq [{:keys [id source out units uncaught status diag]} p7b/fixtures\n+          :when (nil? units)]\n+    (testing (name id)\n+      (let [result (h/run-raw (str \"<?php \" p7b/prologue source))]\n+        (is (= out (:php/out result)))\n+        (is (= uncaught (:php/uncaught result)))\n+        (is (= status (get result :php/status 0)))\n+        (is (= diag (:php/diag result)))))))\n+\n+\n+(deftest include-handoff-test\n+  (let [{:keys [source units out]} (last p7b/fixtures)\n+        packets (update-vals (assoc units \"main.php\" (str \"<?php \" p7b/prologue source))\n+                             cst/parse-source)\n+        result (lh/run-fixture packets \"main.php\" {})]\n+    (doseq [[vm value] (:values result)]\n+      (is (= out (h/latin1->text (:php/out value))) (name vm)))))\ndiff --git a/test/yang/python/antlr/exception_call_test.clj b/test/yang/python/antlr/exception_call_test.clj\nindex 16bdd294..81254b33 100644\n--- a/test/yang/python/antlr/exception_call_test.clj\n+++ b/test/yang/python/antlr/exception_call_test.clj\n@@ -1,6 +1,6 @@\n (ns yang.python.antlr.exception-call-test\n-  \"Round 0: six directed Python-containing pairs, compliant assertions.\n-   JS/PHP/Clojure-only pairs remain explicitly pending in the shared matrix.\n+  \"Round 0's six Python-containing pairs, plus the RETIRE Clojure-caller pairs.\n+   Other JS/PHP/Clojure-only pairs remain pending in the shared matrix.\n    A red result is a runtime divergence, never the expected test value.\"\n   (:require [clojure.test :refer [deftest is testing do-report]]\n             [yang.call.exception-contract :as contract]\n@@ -57,3 +57,11 @@\n \n (deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :clojure}}\n   clojure-to-python-test (check-pair :clojure :python))\n+\n+\n+(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:php :clojure}}\n+  php-to-clojure-test (check-pair :php :clojure))\n+\n+\n+(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:typescript :clojure}}\n+  typescript-to-clojure-test (check-pair :typescript :clojure))\ndiff --git a/test/yang/python/antlr/float_address_test.cljc b/test/yang/python/antlr/float_address_test.cljc\nindex 1c0cb2ef..3f395406 100644\n--- a/test/yang/python/antlr/float_address_test.cljc\n+++ b/test/yang/python/antlr/float_address_test.cljc\n@@ -224,12 +224,12 @@\n             __all__, once with I4-a's delivery and builtin changes,\n             on I6 over landed I5, with value-display (06065e42:\n             py/result!, py.rt/value), and with the s3 tracing slice,\n-            which moved only the hook prelude; all re-minted from\n-            source)\"\n+            which moved only the hook prelude, and with the Python exception-track\n+            and provenance series (merged 8018005d); re-minted from source)\"\n     (is (= (keyword\n              (str \"segment/blake3-\"\n-                  \"d93650264ab02e44817cb81b0fe3be35\"\n-                  \"432b8951bc7d3c2fa198ebba8870de37\"))\n+                  \"2af56b0e17cc8e1a94fcde9fb260b013\"\n+                  \"0822f25781af09e79db35736005d9553\"))\n            (:root (vm/ast->semantic-bytecode prelude/uast))))\n     (is (= :segment/blake3-fda451811f1d578884c70ec1a6992e508dd301f7fc49cccbe547eb128683a62e\n            (:root (vm/ast->semantic-bytecode hooks/uast))))))\n@@ -252,28 +252,30 @@\n               all three moved once with I1's prelude changes, once with\n               I2's, once with I3's, once with I4-a's, on I6 over landed\n               I5, and with value-display (06065e42; re-minted from the\n-              source packet); the s3 slice did not move them)\"\n+              source packet); the s3 slice did not move them. The Python\n+              exception-track and provenance series (merged 8018005d)\n+  