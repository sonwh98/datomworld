 :steps 105083, :completion :complete, :pending? false, :budget-exhausted? false}, :stack {:depth 28, :steps 184141, :completion :complete, :pending? false, :budget-exhausted? false}}, 32 {:register {:depth 76, :steps 138995, :completion :complete, :pending? false, :budget-exhausted? false}, :semantic {:depth 76, :steps 138995, :completion :complete, :pending? false, :budget-exhausted? false}, :stack {:depth 76, :steps 241093, :completion :complete, :pending? false, :budget-exhausted? false}}, 128 {:register {:depth 268, :steps 274643, :completion :complete, :pending? false, :budget-exhausted? false}, :semantic {:depth 268, :steps 274643, :completion :complete, :pending? false, :budget-exhausted? false}, :stack {:depth 268, :steps 468901, :completion :complete, :pending? false, :budget-exhausted? false}}}}}, :linked-warm-follow-up {:status :pending, :scope \"real published compositions, blocking-aware sampling including\\n              scheduler-held continuations, recursive characterization, and\\n              constant-fixture reruns\"}}\ndiff --git a/test/yang/call/depth_probe_test.clj b/test/yang/call/depth_probe_test.clj\nnew file mode 100644\nindex 00000000..a896f7c2\n--- /dev/null\n+++ b/test/yang/call/depth_probe_test.clj\n@@ -0,0 +1,650 @@\n+(ns yang.call.depth-probe-test\n+  \"The UNLINKED DEPTH PROBE (mob ruling (a'), 2/2). Measures the maximum\n+   continuation depth D(n) of pure iteration and exception fixtures on the\n+   three vector VMs (:semantic :stack :register), unlinked, for all four\n+   admitted frontends (Clojure, Python, TypeScript, PHP).\n+\n+   Contract (sol's (C) + astra's two corrections):\n+   - CONSTANT matrix: 4 frontends x 4 variants x 3 backends x 3 sizes = 144\n+     completed measurements; assert results, iteration/catch/finalizer\n+     counts, caller-handler restoration, positive step counts, and\n+     D(16)=D(64)=D(256) within each frontend/backend/variant.\n+   - RECURSIVE characterization (recorded, NEVER asserted for growth):\n+     named self/mutual calls under an outer catch at 8/32/128, success and\n+     deepest failure, all four frontends, three backends.\n+   - Correction (a): empty K is not completion. Use the engine's halt/block\n+     predicates, require the expected result, reject pending scheduler work.\n+   - Correction (b): pure means no parking, not no effects. Synchronous cell\n+     effects complete inside the engine's effect handling and are preserved.\n+\n+   The evidence artifact is `test/yang/call/depth_probe.edn`, written by\n+   `write-evidence!`; results are labelled `:unlinked` and the linked-warm\n+   follow-up stays a named obligation.\"\n+  (:require [clojure.java.shell :as shell]\n+            [clojure.string :as str]\n+            [clojure.test :refer [deftest is testing]]\n+            [clojure.walk :as walk]\n+            [dao.stream :as stream]\n+            [yang.call.conformance :as kit]\n+            [yang.clojure :as clj-comp]\n+            [yang.php.antlr.cst :as php-cst]\n+            [yang.php.antlr.lower :as php-lower]\n+            [yang.php.antlr.portable-harness :as php-portable]\n+            [yang.php.antlr.prelude :as php-prelude]\n+            [yang.python.antlr.lower :as py-lower]\n+            [yang.python.antlr.parser :as py-parser]\n+            [yang.python.antlr.prelude :as py-prelude]\n+            [yang.typescript.antlr.cst :as ts-cst]\n+            [yang.typescript.antlr.lower :as ts-lower]\n+            [yang.typescript.antlr.prelude :as ts-prelude]\n+            [yin.vm :as vm]\n+            [yin.vm.data :as data]\n+            [yin.vm.debruijn.register :as rvm]\n+            [yin.vm.debruijn.stack :as dvm]\n+            [yin.vm.integer :as integer]\n+            [yin.vm.module :as module]\n+            [yin.vm.semantic :as semantic]\n+            [yin.vm.semantic.derive :as derive]\n+            [yin.vm.semantic.linearize :as sr-linearize]\n+            [yin.vm.test-utils :as tu]))\n+\n+\n+;; =============================================================================\n+;; Composition: host modules and per-frontend bundled registries\n+;; =============================================================================\n+\n+(def frontends [:clojure :python :typescript :php])\n+(def backends [:semantic :stack :register])\n+(def variants [:plain :try-finally :caught-failure :outer-catch])\n+(def sizes [16 64 256])\n+\n+\n+(def ^:private step-budget\n+  \"The per-measurement instruction budget. Low enough that a non-terminating\n+   fixture (a prelude `%capture` or recursion-unwind bug) is detected rather\n+   than spinning forever, high enough for the heaviest admitted fixture to\n+   complete: the exception-heavy PHP `caught-failure`/`try-finally` fixtures\n+   do one throw/catch/finally round per source iteration, and the de Bruijn\n+   `stack` backend runs ~1.7x more instructions per source iteration than\n+   `semantic`/`register`. The measured ceiling is ~6.8M steps (php\n+   `caught-failure` n=256 on `stack`), so 10M completes every fixture at\n+   n=256 with headroom while a genuine non-termination is still recorded as\n+   `:budget-exhausted`, never silently masked.\"\n+  10000000)\n+\n+\n+(def ^:private base-opts\n+  {:make-stream tu/make-stream,\n+   :capability-secret tu/secret,\n+   :primitives vm/primitives})\n+\n+\n+(defn- clj-registry\n+  \"The clojure host surface: default registry + stream + cell + data, exactly\n+   the `av-modules` composition the clojure fixtures run over.\"\n+  []\n+  (data/register-data-module\n+    (module/register-cell-module\n+      (module/register-stream-module (module/default-registry)))))\n+\n+\n+(defn- ts-registry\n+  \"The TypeScript bundled composition (prelude-parity's `opts` modules).\"\n+  []\n+  (ts-prelude/admit\n+    (ts-prelude/register-integer-module\n+      (data/register-data-module\n+        (module/register-cell-module (module/empty-registry))\n+        {::data/max-items 1048576})\n+      {::integer/max-bits 100000, ::integer/max-digits 4300})))\n+\n+\n+(defn- py-registry\n+  \"The Python bundled composition (e2e-test's `host-registry`).\"\n+  []\n+  (py-prelude/admit\n+    (py-prelude/register-integer-module\n+      (data/register-data-module\n+        (module/register-cell-module (module/empty-registry))\n+        {::data/max-items 1048576})\n+      {::integer/max-bits 100000, ::integer/max-digits 4300})))\n+\n+\n+(defn- php-registry\n+  \"The PHP bundled composition (portable-harness's `host-registry`).\"\n+  []\n+  (php-portable/host-registry))\n+\n+\n+(defn- registry-for\n+  [frontend]\n+  (case frontend\n+    :clojure (clj-registry)\n+    :python (py-registry)\n+    :typescript (ts-registry)\n+    :php (php-registry)))\n+\n+\n+;; =============================================================================\n+;; Lowering: bundled (unlinked) production lowerings\n+;; =============================================================================\n+\n+(def ^:private clj-library-opts\n+  {:convention :arg-vector, :outcomes true\n+   :adapters clj-comp/library-adapters\n+   :native vm/primitive-profiles})\n+\n+\n+(defn- source-events\n+  [unit text]\n+  [{:yang.source/event :yang.source/chunk,\n+    :yang.source/unit unit,\n+    :yang.source/ordinal 0,\n+    :yang.source/text text}\n+   {:yang.source/event :yang.source/seal,\n+    :yang.source/unit unit,\n+    :yang.source/chunk-count 1}])\n+\n+\n+(defn- run-member\n+  \"The run member of a source envelope: the map AST the lowering emitted.\"\n+  [{:yin/keys [batch root]}]\n+  (nth batch root))\n+\n+\n+(defn- lower-ts\n+  \"Bundled TypeScript lowering of `source`: source events -> CST -> program.\"\n+  [source]\n+  (let [program (tu/new-memory-log)\n+        src (tu/new-memory-log)\n+        cst-log (tu/new-memory-log)\n+        diagnostics (tu/new-memory-log)]\n+    (doseq [e (source-events [:depth 0] source)] (stream/append! src e))\n+    (ts-cst/step-stage (ts-cst/open-stage src cst-log))\n+    (ts-lower/step-stage (ts-lower/open-stage cst-log program diagnostics\n+                                              {:medium ts-lower/program-medium,\n+                                               :prelude :bundled}))\n+    (if (seq (tu/drain diagnostics))\n+      {:diagnostics (tu/drain diagnostics)}\n+      {:ast (run-member (first (tu/drain program)))})))\n+\n+\n+(defn- lower-py\n+  \"Bundled Python lowering of `source`.\"\n+  [source]\n+  (let [program (tu/new-memory-log)\n+        src (tu/new-memory-log)\n+        cst (tu/new-memory-log)\n+        diagnostics (tu/new-memory-log)]\n+    (doseq [e (source-events [:depth 0] source)] (stream/append! src e))\n+    (py-parser/step-stage (py-parser/open-stage src cst))\n+    (py-lower/step-stage (py-lower/open-stage cst program diagnostics\n+                                              {:medium py-lower/program-medium,\n+                                               :prelude :bundled}))\n+    (if (seq (tu/drain diagnostics))\n+      {:diagnostics (tu/drain diagnostics)}\n+      {:ast (run-member (first (tu/drain program)))})))\n+\n+\n+(defn- lower-php\n+  \"Bundled PHP lowering of `source`.\"\n+  [source]\n+  (let [cst-log (tu/new-memory-log)\n+        program (tu/new-memory-log)\n+        diagnostics (tu/new-memory-log)]\n+    (stream/append! cst-log (php-cst/parse-source source))\n+    (php-lower/step-stage (php-lower/open-stage cst-log program diagnostics\n+                                                {:medium php-lower/program-medium}))\n+    (if (seq (tu/drain diagnostics))\n+      {:diagnostics (tu/drain diagnostics)}\n+      {:ast (run-member (first (tu/drain program)))})))\n+\n+\n+(defn- lower-clj\n+  \"Bundled clojure lowering of `forms` (a vector of top-level forms): the\n+   self-contained compiled program (the exception machinery — `clj/try`/\n+   `clj/throw` — is inlined by `compile-program`).\"\n+  [forms]\n+  {:ast (clj-comp/compile-program (into (clj-comp/library-for forms) (vec forms))\n+                                  true clj-library-opts)})\n+\n+\n+(defn- lower-source\n+  \"Bundled production lowering of a fixture `source` (a string for py/ts/php,\n+   a vector of forms for clojure) to `{:ast ...}` or `{:diagnostics ...}`.\"\n+  [frontend source]\n+  (case frontend\n+    :clojure (lower-clj source)\n+    :python (lower-py source)\n+    :typescript (lower-ts source)\n+    :php (lower-php source)))\n+\n+\n+;; =============================================================================\n+;; The depth driver: step to completion, sample the continuation, never run\n+;; =============================================================================\n+\n+(def ^:private load-semantic\n+  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n+\n+\n+(defn- pending-scheduler-work?\n+  \"True when the VM still holds scheduler work that must be serviced before\n+   the run is a genuine completion (astra correction (a): empty K is not\n+   completion; parking can clear active K).\"\n+  [machine]\n+  (boolean\n+    (or (seq (or (:ready-queue machine) []))\n+        (seq (or (:wait-set machine) []))\n+        (seq (or (:parked machine) [])))))\n+\n+\n+(defn- step-depth\n+  \"Step `machine` one instruction at a time to completion, recording the\n+   maximum continuation depth (semantic `:k`, stack/register `:continuation`)\n+   and the executed step count. Returns\n+   `{:value :depth :steps :completed? :blocked? :pending?}`. Never calls\n+   `vm/run`; a blocked machine or budget exhaustion is an explicit failure.\"\n+  [machine budget]\n+  (loop [v machine n 0 mx (count (vm/continuation v))]\n+    (cond\n+      (vm/halted? v)\n+      {:value (vm/value v) :depth mx :steps n\n+       :completed? true :blocked? false :pending? (pending-scheduler-work? v)}\n+\n+      (vm/blocked? v)\n+      {:value nil :depth mx :steps n\n+       :completed? false :blocked? true :pending? (pending-scheduler-work? v)}\n+\n+      (>= n budget)\n+      {:value nil :depth mx :steps n :completed? false :blocked? false\n+       :pending? (pending-scheduler-work? v) :budget-exhausted true}\n+\n+      :else\n+      (let [v' (vm/step v)]\n+        (recur v' (inc n) (max mx (count (vm/continuation v'))))))))\n+\n+\n+(defn- run-depth\n+  \"Run `ast` on the three vector VMs, stepping to completion and sampling\n+   depth. Returns `{backend {:value :depth :steps :completed? :blocked?\n+   :pending?}}`.\"\n+  [registry ast budget]\n+  (let [opts (assoc base-opts :modules registry)\n+        datoms (vec (vm/ast->datoms ast))\n+        projected #(:vector (sr-linearize/project ast))]\n+    {:semantic (step-depth (load-semantic (semantic/create-vm opts) datoms)\n+                           budget)\n+     :stack (step-depth (dvm/create-vm\n+                          (:image (derive/stack-image (projected)))\n+                          (assoc opts :contract vm/stack-contract))\n+                        budget)\n+     :register (step-depth (rvm/create-vm\n+                             (derive/register-image (projected))\n+                             (assoc opts :contract vm/register-contract))\n+                           budget)}))\n+\n+\n+;; =============================================================================\n+;; Fixtures\n+;; =============================================================================\n+\n+(defn- sum\n+  [n]\n+  (quot (* n (dec n)) 2))\n+\n+\n+(defn- sub-n\n+  \"Substitute the size into a string template (`__N__`) or a clojure form\n+   template (the symbol `N`).\"\n+  [template n]\n+  (if (string? template)\n+    (str/replace template \"__N__\" (str n))\n+    (walk/postwalk-replace {'N n} template)))\n+\n+\n+(def fixture-templates\n+  \"`{variant {frontend template}}` where a template is a string (py/ts/php)\n+   or a quoted form (clojure), with `__N__`/`N` as the size placeholder.\n+   Every fixture is pure: loops, try/finally, caught failures, an outer\n+   catch — no FFI, no parking. Each returns/prints a single integer that\n+   proves `n` correct iterations/finalizations/catches.\"\n+  {:plain\n+   {:clojure\n+    '[(loop [i 0 s 0] (if (< i N) (recur (inc i) (+ s i)) s))]\n+    :python \"s = 0\\nfor i in range(__N__):\\n    s += i\\nprint(s)\\n\"\n+    :typescript \"let s = 0;\\nfor (let i = 0; i < __N__; i++) { s += i; }\\nconsole.log(s);\\n\"\n+    :php \"<?php $s = 0; for ($i = 0; $i < __N__; $i++) { $s += $i; } echo $s;\\n\"}\n+\n+   :try-finally\n+   {:clojure\n+    '[(let [finals (cell/new 0)]\n+        (loop [i 0]\n+          (if (< i N)\n+            (do (try :body (finally (cell/set! finals (+ 1 (cell/get finals)))))\n+                (recur (inc i)))\n+            (cell/get finals))))]\n+    :python \"finals = 0\\nfor i in range(__N__):\\n    try:\\n        pass\\n    finally:\\n        finals += 1\\nprint(finals)\\n\"\n+    :typescript \"let finals = 0;\\nfor (let i = 0; i < __N__; i++) { try { } finally { finals++; } }\\nconsole.log(finals);\\n\"\n+    :php \"<?php $finals = 0; for ($i = 0; $i < __N__; $i++) { try { } finally { $finals++; } } echo $finals;\\n\"}\n+\n+   :caught-failure\n+   {:clojure\n+    '[(let [catches (cell/new 0) finals (cell/new 0)]\n+        (loop [i 0]\n+          (if (< i N)\n+            (do (try (throw :boom)\n+                     (catch Exception e (cell/set! catches (+ 1 (cell/get catches))))\n+                     (finally (cell/set! finals (+ 1 (cell/get finals)))))\n+                (recur (inc i)))\n+            ;; caller-handler restoration probe: a fresh throw/catch after the\n+            ;; loop returns the counts only if the handler context was restored.\n+            (try (throw :restore)\n+                 (catch Exception e (+ (cell/get catches) (cell/get finals)))))))]\n+    :python \"catches = 0\\nfinals = 0\\ni = 0\\nwhile i < __N__:\\n    try:\\n        raise ValueError\\n    except ValueError:\\n        catches += 1\\n    finals += 1\\n    i += 1\\ntry:\\n    raise ValueError\\nexcept ValueError:\\n    print(catches + finals)\\n\"\n+    :typescript \"let catches = 0, finals = 0;\\nfor (let i = 0; i < __N__; i++) { try { throw new Error('x'); } catch (e) { catches++; } finally { finals++; } }\\ntry { throw new Error('restore'); } catch (e) { console.log(catches + finals); }\\n\"\n+    :php \"<?php $catches = 0; $finals = 0; for ($i = 0; $i < __N__; $i++) { try { throw new Exception('x'); } catch (Throwable $e) { $catches++; } finally { $finals++; } } try { throw new Exception('restore'); } catch (Throwable $e) { echo ($catches + $finals); }\\n\"}\n+\n+   :outer-catch\n+   {:clojure\n+    '[(try (loop [i 0 s 0] (if (< i N) (recur (inc i) (+ s i)) s))\n+           (catch Exception e -1))]\n+    :python \"s = 0\\ntry:\\n    for i in range(__N__):\\n        s += i\\nexcept ValueError:\\n    s = -1\\nprint(s)\\n\"\n+    :typescript \"let s = 0;\\ntry { for (let i = 0; i < __N__; i++) { s += i; } } catch (e) { s = -1; }\\nconsole.log(s);\\n\"\n+    :php \"<?php $s = 0; try { for ($i = 0; $i < __N__; $i++) { $s += $i; } } catch (Throwable $e) { $s = -1; } echo $s;\\n\"}})\n+\n+\n+(defn- expected-result\n+  \"The integer each fixture returns/prints when correct.\"\n+  [variant n]\n+  (case variant\n+    :plain (sum n)\n+    :try-finally n\n+    :caught-failure (* 2 n)\n+    :outer-catch (sum n)))\n+\n+\n+(defn- canon-str\n+  \"A canonical string for a result value: a number's trailing `.0` is\n+   stripped (Python's `range`/`+=` arithmetic can answer a float).\"\n+  [x]\n+  (if (number? x)\n+    (let [s (str x)]\n+      (if (str/ends-with? s \".0\") (subs s 0 (- (count s) 2)) s))\n+    (str x)))\n+\n+\n+(defn- observe\n+  \"Normalize a VM value to a comparable (string) result for `frontend`.\"\n+  [frontend value]\n+  (case frontend\n+    :clojure (canon-str (if (and (vector? value) (= :yin.k/ok (first value)))\n+                          (second value)\n+                          value))\n+    :python (canon-str (ffirst (:py/out value)))\n+    :typescript (canon-str (ffirst (:js/out value)))\n+    :php (php-portable/render value)))\n+\n+\n+(defn- expected-observed\n+  \"The comparable (string) form of `result` for `frontend`.\"\n+  [frontend result]\n+  (if (= frontend :php) (str result) (canon-str result)))\n+\n+\n+;; =============================================================================\n+;; The constant matrix (144 completed measurements)\n+;; =============================================================================\n+\n+(defn- measure-one\n+  \"Lower and run one (frontend, variant, n) fixture on all three backends.\n+   Returns `{:diagnostics d}` or `{backend {:value :depth :steps ...}}`.\"\n+  [frontend variant n]\n+  (try\n+    (let [src (sub-n (get-in fixture-templates [variant frontend]) n)\n+          lowered (lower-source frontend src)]\n+      (if (:diagnostics lowered)\n+        {:diagnostics (:diagnostics lowered)}\n+        (run-depth (registry-for frontend) (:ast lowered) step-budget)))\n+    (catch clojure.lang.ExceptionInfo e\n+      (throw (ex-info (str (name frontend) \" \" (name variant) \" n=\" n \": \"\n+                           (ex-message e))\n+                      (assoc (ex-data e) :frontend frontend :variant variant :n n)\n+                      e)))))\n+\n+\n+(defn- measure-matrix\n+  \"Every (frontend, variant, size) -> backend results, keyed for the evidence\n+   artifact. Returns a nested map; each leaf is one backend's measurement.\"\n+  []\n+  (into (sorted-map)\n+        (for [f frontends]\n+          [f (into (sorted-map)\n+                   (for [v variants]\n+                     [v (into (sorted-map)\n+                              (for [n sizes]\n+                                [n (measure-one f v n)]))]))])))\n+\n+\n+(defn- assert-constant-case\n+  \"Assert the constant contract for one (frontend, variant) across sizes.\"\n+  [frontend variant]\n+  (let [by-size (into {} (for [n sizes] [n (measure-one frontend variant n)]))]\n+    (testing (str (name frontend) \" \" (name variant))\n+      (doseq [n sizes]\n+        (let [r (get by-size n)]\n+          (is (not (:diagnostics r))\n+              (str \"no lowering diagnostics at n=\" n \": \" (pr-str (:diagnostics r))))\n+          (doseq [b backends]\n+            (let [m (get r b)]\n+              (is m (str \"backend \" b \" produced a measurement at n=\" n))\n+              (is (:completed? m) (str b \" completed at n=\" n))\n+              (is (not (:blocked? m)) (str b \" did not block at n=\" n))\n+              (is (not (:pending? m)) (str b \" has no pending scheduler work at n=\" n))\n+              (is (pos? (:steps m)) (str b \" executed instructions at n=\" n))\n+              (is (= (expected-observed frontend (expected-result variant n))\n+                     (observe frontend (:value m)))\n+                  (str b \" result correct at n=\" n))))))\n+      ;; D(16)=D(64)=D(256) within this frontend/backend/variant.\n+      (doseq [b backends]\n+        (let [ds (map (fn [n] (get-in by-size [n b :depth])) sizes)]\n+          (is (apply = ds)\n+              (str b \" D(16)=D(64)=D(256): \" (pr-str (vec ds)))))))))\n+\n+\n+;; =============================================================================\n+;; Recursive characterization (recorded, never asserted for growth)\n+;; =============================================================================\n+\n+(def recursive-templates\n+  \"Named self/mutual recursion under an outer catch. Templates carry `__N__`/\n+   `N`; results are recorded, never asserted for growth or a minimum slope.\"\n+  {:self\n+   {:clojure\n+    '[(defn f\n+        [i acc]\n+        (if (= i 0) acc (f (dec i) (+ acc i))))\n+      (try (f N 0) (catch Exception e -1))]\n+    :python \"def f(i, acc):\\n    return acc if i == 0 else f(i - 1, acc + i)\\ntry:\\n    print(f(__N__, 0))\\nexcept RecursionError:\\n    print(-1)\\n\"\n+    :typescript \"function f(i, acc) { return i === 0 ? acc : f(i - 1, acc + i); }\\ntry { console.log(f(__N__, 0)); } catch (e) { console.log(-1); }\\n\"\n+    :php \"<?php function f($i, $acc) { return $i <= 0 ? $acc : f($i - 1, $acc + $i); } try { echo f(__N__, 0); } catch (Throwable $e) { echo -1; }\\n\"}\n+\n+   :mutual\n+   {:clojure\n+    '[(defn dpeven\n+        [i]\n+        (if (= i 0) true (dpodd (dec i))))\n+      (defn dpodd\n+        [i]\n+        (if (= i 0) false (dpeven (dec i))))\n+      (try (dpeven N) (catch Exception e false))]\n+    :python \"def even(i):\\n    return True if i == 0 else odd(i - 1)\\ndef odd(i):\\n    return False if i == 0 else even(i - 1)\\ntry:\\n    print('true' if even(__N__) else 'false')\\nexcept RecursionError:\\n    print('false')\\n\"\n+    :typescript \"function even(i) { return i === 0 ? true : odd(i - 1); }\\nfunction odd(i) { return i === 0 ? false : even(i - 1); }\\ntry { console.log(even(__N__) ? 'true' : 'false'); } catch (e) { console.log('false'); }\\n\"\n+    :php \"<?php function even($i) { return $i <= 0 ? true : odd($i - 1); } function odd($i) { return $i <= 0 ? false : even($i - 1); } try { echo (even(__N__) ? 'true' : 'false'); } catch (Throwable $e) { echo 'false'; }\\n\"}})\n+\n+\n+(def recursive-sizes [8 32 128])\n+\n+\n+(defn- measure-recursive\n+  \"Lower and run one recursive (shape, frontend, n) fixture on all backends.\n+   Returns `{:diagnostics d}` or `{backend measurement}`.\"\n+  [shape frontend n]\n+  (try\n+    (let [src (sub-n (get-in recursive-templates [shape frontend]) n)\n+          lowered (lower-source frontend src)]\n+      (if (:diagnostics lowered)\n+        {:diagnostics (:diagnostics lowered)}\n+        (run-depth (registry-for frontend) (:ast lowered) step-budget)))\n+    (catch clojure.lang.ExceptionInfo e\n+      (throw (ex-info (str \"recursive \" (name shape) \" \" (name frontend) \" n=\" n \": \"\n+                           (ex-message e))\n+                      (assoc (ex-data e) :shape shape :frontend frontend :n n)\n+                      e)))))\n+\n+\n+;; =============================================================================\n+;; The evidence artifact\n+;; =============================================================================\n+\n+(defn- revision\n+  \"The short git revision, or :unknown.\"\n+  []\n+  (try\n+    (let [sha (str/trim (:out (shell/sh \"git\" \"rev-parse\" \"--short\" \"HEAD\")))]\n+      (if (empty? sha) :unknown sha))\n+    (catch Exception _ :unknown)))\n+\n+\n+(defn- dirty?\n+  \"True when the worktree has uncommitted changes.\"\n+  []\n+  (try\n+    (not (empty? (str/trim (:out (shell/sh \"git\" \"status\" \"--porcelain\")))))\n+    (catch Exception _ false)))\n+\n+\n+(defn- evidence\n+  \"The complete evidence map: revision, dirty-state, the constant matrix with\n+   depths/steps/completion/budgets, and the recursive characterization.\"\n+  []\n+  (let [matrix (measure-matrix)\n+        recursive (into (sorted-map)\n+                        (for [shape [:self :mutual]]\n+                          [shape (into (sorted-map)\n+                                       (for [f frontends]\n+                                         [f (into (sorted-map)\n+                                                  (for [n recursive-sizes]\n+                                                    [n (measure-recursive shape f n)]))]))]))]\n+    {:revision (revision),\n+     :dirty-state (dirty?),\n+     :composition :unlinked,\n+     :label :unlinked,\n+     :budget step-budget,\n+     :constant-matrix matrix,\n+     :recursive recursive,\n+     :linked-warm-follow-up\n+     {:status :pending,\n+      :scope \"real published compositions, blocking-aware sampling including\n+              scheduler-held continuations, recursive characterization, and\n+              constant-fixture reruns\"}}))\n+\n+\n+(defn- measurement-summary\n+  \"A compact evidence row for one backend measurement.\"\n+  [m]\n+  (cond\n+    (:diagnostics m) {:diagnostics true}\n+    (nil? m) {:missing true}\n+    :else {:depth (:depth m),\n+           :steps (:steps m),\n+           :completion (if (:completed? m) :complete\n+                           (if (:blocked? m) :blocked :incomplete)),\n+           :pending? (:pending? m),\n+           :budget-exhausted? (boolean (:budget-exhausted m))}))\n+\n+\n+(defn- matrix-evidence\n+  \"The constant matrix reduced to its evidence fields, ready for EDN.\"\n+  [matrix]\n+  (into (sorted-map)\n+        (for [[f vs] matrix]\n+          [f (into (sorted-map)\n+                   (for [[v ns] vs]\n+                     [v (into (sorted-map)\n+                              (for [[n bs] ns]\n+                                [n (into (sorted-map)\n+                                         (for [[b m] bs]\n+                                           [b (measurement-summary m)]))]))]))])))\n+\n+\n+(defn- recursive-evidence\n+  [recursive]\n+  (into (sorted-map)\n+        (for [[shape fs] recursive]\n+          [shape (into (sorted-map)\n+                       (for [[f ns] fs]\n+                         [f (into (sorted-map)\n+                                  (for [[n bs] ns]\n+                                    [n (into (sorted-map)\n+                                             (for [[b m] bs]\n+                                               [b (measurement-summary m)]))]))]))])))\n+\n+\n+(defn write-evidence!\n+  \"Write the reproducible evidence artifact `test/yang/call/depth_probe.edn`.\"\n+  ([] (write-evidence! \"test/yang/call/depth_probe.edn\"))\n+  ([path]\n+   (let [ev (evidence)]\n+     (spit path\n+           (str \";; GENERATED unlinked depth-probe evidence, revision \"\n+                (:revision ev) \".\\n\"\n+                (pr-str {:revision (:revision ev),\n+                         :dirty-state (:dirty-state ev),\n+                         :composition (:composition ev),\n+                         :label (:label ev),\n+                         :budget (:budget ev),\n+                         :constant-matrix (matrix-evidence (:constant-matrix ev)),\n+                         :recursive (recursive-evidence (:recursive ev)),\n+                         :linked-warm-follow-up (:linked-warm-follow-up ev)})\n+                \"\\n\"))\n+     ev)))\n+\n+\n+;; =============================================================================\n+;; Tests\n+;; =============================================================================\n+\n+(deftest constant-matrix-test\n+  \"4 frontends x 4 variants x 3 backends x 3 sizes = 144 completed\n+   measurements, with D(16)=D(64)=D(256) within each frontend/backend/variant.\"\n+  (doseq [f frontends, v variants]\n+    (assert-constant-case f v)))\n+\n+\n+(deftest recursive-characterization-test\n+  \"Record named self/mutual recursion depths at 8/32/128; assert completion\n+   and correct outcome, never growth or a minimum slope.\"\n+  (doseq [shape [:self :mutual], f frontends]\n+    (testing (str (name shape) \" \" (name f))\n+      (doseq [n recursive-sizes]\n+        (let [r (measure-recursive shape f n)]\n+          (is (not (:diagnostics r)) (str \"no diagnostics at n=\" n))\n+          (doseq [b backends]\n+            (let [m (get r b)]\n+              (is m (str b \" measured at n=\" n))\n+              (is (:completed? m) (str b \" completed at n=\" n))\n+              (is (not (:blocked? m)) (str b \" did not block at n=\" n))\n+              (is (pos? (:steps m)) (str b \" executed steps at n=\" n))\n+              ;; outcome is correct: the recursion terminates to a real value\n+              (is (some? (observe f (:value m))) (str b \" produced an outcome\")))))))))\n+\n+\n+(deftest evidence-artifact-test\n+  \"Write the reproducible evidence artifact `test/yang/call/depth_probe.edn`\n+   (revision, dirty-state, the constant matrix, and the recursive\n+   characterization), then verify it was written.\"\n+  (let [ev (write-evidence!)]\n+    (is (:revision ev) \"the evidence records a revision\")\n+    (is (map? (:constant-matrix ev)) \"the constant matrix is present\")\n+    (is (map? (:recursive ev)) \"the recursive characterization is present\")))\ndiff --git a/test/yang/call/exception_contract.clj b/test/yang/call/exception_contract.clj\nindex 9da5dc2e..f3adebe8 100644\n--- a/test/yang/call/exception_contract.clj\n+++ b/test/yang/call/exception_contract.clj\n@@ -17,7 +17,8 @@\n \n (def sources\n   \"Every export below is source-produced. `original` is an identity-bearing\n-   value, including Clojure's explicit cell. `receive` catches then rethrows unchanged;\n+   value, including Clojure's explicit cell. PHP's `seed` creates it after\n+   run-main shutdown has released module globals. `receive` catches then rethrows unchanged;\n    `retain` returns normally before `later` raises from a new activation.\n    Protocol catch forms are intentionally local catch-all forms. No guessed\n    donor class name participates in reception.\"\n@@ -57,7 +58,8 @@\n         \"globalThis.raise_value = function(e) { throw e; };\"\n         \"globalThis.echo = function(e) { return e; };\")\n    :php\n-   (str \"<?php $original = new Exception('original'); $saved = null;\"\n+   (str \"<?php $original = null; $saved = null;\"\n+        \"function seed() { global $original; $original = new Exception('original'); return $original; }\"\n         \"function payload() { global $original; return $original; }\"\n         \"function donor_raise() { global $original; throw $original; }\"\n         \"function make_exploder() { return function() { global $original; throw $original; }; }\"\n@@ -158,8 +160,7 @@\n (def pair-matrix\n   (vec (for [donor (sort frontends), caller (sort frontends)\n              :when (not= donor caller), [scenario gates] (sort pair-scenarios)\n-             :when (not (and (= scenario :binding) (= donor :typescript)))\n-             :when (not (and (= scenario :finally-replacement) (= caller :clojure)))]\n+             :when (not (and (= scenario :binding) (= donor :typescript)))]\n          {:id [donor caller scenario] :donor donor :caller caller\n           :scenario scenario :gates gates :frontends #{donor caller}\n           :callable-kind :named-export\n@@ -172,11 +173,14 @@\n (def pending-obligations\n   \"Round 0 does not claim the wider acceptance gate. These remain explicit\n    ledger rows, including facilities the JVM linked kit cannot prove.\"\n+  ;; `:clojure-finally-refusal` is retired, not flipped: owner ruling\n+  ;; 1794556000000 derives the dialect surface from the source language, and\n+  ;; the now-live `:finally-replacement` clojure-caller legs carry the\n+  ;; obligation. A `:supports` row here would stay open forever, since\n+  ;; `open-gates` closes only on a reported `:green`.\n   [{:id :clojure-private-public-equivalence :gates #{::r4}\n     :frontends #{:clojure} :execution :pending-round-4\n     :cases #{:caught :uncaught :protocol-rethrow :binding :higher-order}}\n-   {:id :clojure-finally-refusal :gates #{::r4}\n-    :frontends #{:clojure} :execution :preserve-source-refusal}\n    {:id :suspension-and-recursion :gates #{::r1 ::r2}\n     :frontends frontends :execution :pending-frontend-rounds}\n    {:id :host-vm-publication-parity :gates #{::r1 ::r2 ::r3 ::r5}\ndiff --git a/test/yang/call/exception_legs.clj b/test/yang/call/exception_legs.clj\nindex a096bfba..d26e78dd 100644\n--- a/test/yang/call/exception_legs.clj\n+++ b/test/yang/call/exception_legs.clj\n@@ -56,8 +56,9 @@\n   (let [header (case frontend :php \"<?php \" \"\")\n         probe #(define frontend \"probe\" [] %)\n         ;; `done` checks exactly-once cleanup, before the home runtime\n-        ;; recognizes its original exception again. Clojure uses its\n-        ;; admitted catch surface, and does not acquire finally syntax.\n+        ;; recognizes its original exception again. `:round-trip`'s clojure\n+        ;; arm still cleans up through the admitted catch surface rather than\n+        ;; `finally`; converting it belongs to the dialect-definition round.\n         counter (case frontend\n                   :python \"cleaned = 0\\n\"\n                   :typescript \"globalThis.cleaned = 0;\\n\"\n@@ -104,23 +105,22 @@\n                     :php \"if (!success()) return false; try { donor_raise(); } catch(Throwable $e) { return success(); } return false;\"\n                     :clojure \"(and (success) (try (donor_raise) false (catch Exception e (success))))\"))\n            :finally-replacement\n-           (do\n-             (when (= frontend :clojure)\n-               (throw (ex-info \"Clojure finally remains an explicit source refusal\"\n-                               {:frontend frontend :scenario scenario})))\n-             (str\n-               (case frontend\n-                 :python \"replacement = ValueError('replacement')\\n\"\n-                 :typescript \"globalThis.replacement = {marker: 'replacement'};\\n\"\n-                 :php \"$replacement = new Exception('replacement');\\n\")\n-               (define frontend \"replacement_payload\" []\n-                 (case frontend :python \"return replacement\"\n-                       :typescript \"return replacement;\"\n-                       :php \"global $replacement; return $replacement;\"))\n-               (probe (case frontend\n-                        :python \"try:\\n    donor_raise()\\nfinally:\\n    raise replacement\"\n-                        :typescript \"try { donor_raise(); } finally { throw replacement; }\"\n-                        :php \"global $replacement; try { donor_raise(); } finally { throw $replacement; }\"))))\n+           (str\n+             (case frontend\n+               :python \"replacement = ValueError('replacement')\\n\"\n+               :typescript \"globalThis.replacement = {marker: 'replacement'};\\n\"\n+               :php \"$replacement = new Exception('replacement');\\n\"\n+               :clojure \"(def replacement (cell/new :replacement))\\n\")\n+             (define frontend \"replacement_payload\" []\n+               (case frontend :python \"return replacement\"\n+                     :typescript \"return replacement;\"\n+                     :php \"global $replacement; return $replacement;\"\n+                     :clojure \"replacement\"))\n+             (probe (case frontend\n+                      :python \"try:\\n    donor_raise()\\nfinally:\\n    raise replacement\"\n+                      :typescript \"try { donor_raise(); } finally { throw replacement; }\"\n+                      :php \"global $replacement; try { donor_raise(); } finally { throw $replacement; }\"\n+                      :clojure \"(try (donor_raise) (finally (throw replacement)))\")))\n            :retained-lifetime\n            (str\n              (case frontend :python \"saved = None\\n\" :typescript \"globalThis.saved = null;\\n\"\n@@ -168,29 +168,33 @@\n                 :value (list 'get result :value)}]\n     (kit/guard-exceptions-form\n       [donor caller]\n-      (case scenario\n-        (:catch-all :typed-catch :binding :success-raise-success)\n-        (list 'let [result (call caller probe-export [])] (kit/observation-map-form simple))\n-        :round-trip\n-        (list 'let [result (call donor \"home\" [(kit/export-form caller probe-export)\n-                                               (kit/export-form caller \"done\")])]\n-              (kit/observation-map-form simple))\n-        :retained-lifetime\n-        (list 'let [original (list 'get (call donor \"payload\" []) :value)\n-                    'leg.saved (call caller \"save_foreign\" [])\n-                    'leg.local (call caller \"saved_local\" [])\n-                    result (call caller probe-export [])]\n-              (kit/observation-map-form\n-                (assoc transfer :retained (list '= :return (list 'get 'leg.saved :route))\n-                       :local (list 'get 'leg.local :value))))\n-        (:unchanged-rethrow :finally-replacement)\n-        (list 'let [original (list 'get (if (= scenario :finally-replacement)\n-                                          (call caller \"replacement_payload\" [])\n-                                          (call donor \"payload\" [])) :value)\n-                    result (call caller probe-export [])]\n-              (kit/observation-map-form (cond-> transfer\n-                                          (= scenario :unchanged-rethrow)\n-                                          (assoc :caught (list 'get (call caller \"caught_once\" []) :value)))))))))\n+      ;; The donor's unit has finished, including PHP's global release.\n+      ;; Seed once per observation so home/payload/raise share one object.\n+      (cond->>\n+        (case scenario\n+          (:catch-all :typed-catch :binding :success-raise-success)\n+          (list 'let [result (call caller probe-export [])] (kit/observation-map-form simple))\n+          :round-trip\n+          (list 'let [result (call donor \"home\" [(kit/export-form caller probe-export)\n+                                                 (kit/export-form caller \"done\")])]\n+                (kit/observation-map-form simple))\n+          :retained-lifetime\n+          (list 'let [original (list 'get (call donor \"payload\" []) :value)\n+                      'leg.saved (call caller \"save_foreign\" [])\n+                      'leg.local (call caller \"saved_local\" [])\n+                      result (call caller probe-export [])]\n+                (kit/observation-map-form\n+                  (assoc transfer :retained (list '= :return (list 'get 'leg.saved :route))\n+                         :local (list 'get 'leg.local :value))))\n+          (:unchanged-rethrow :finally-replacement)\n+          (list 'let [original (list 'get (if (= scenario :finally-replacement)\n+                                            (call caller \"replacement_payload\" [])\n+                                            (call donor \"payload\" [])) :value)\n+                      result (call caller probe-export [])]\n+                (kit/observation-map-form (cond-> transfer\n+                                            (= scenario :unchanged-rethrow)\n+                                            (assoc :caught (list 'get (call caller \"caught_once\" []) :value))))))\n+        (= donor :php) (list 'let ['leg.seeded (call donor \"seed\" [])])))))\n \n \n (defn expected\ndiff --git a/test/yang/call/exception_probes.clj b/test/yang/call/exception_probes.clj\nindex 76ddd3af..3c0669a5 100644\n--- a/test/yang/call/exception_probes.clj\n+++ b/test/yang/call/exception_probes.clj\n@@ -66,6 +66,9 @@\n    Neither live payloads nor wrappers are rendered or ferried between tasks.\"\n   [{:keys [scenario frontend protocol-reason]}]\n   (let [export #(read-export frontend %)\n+        ;; PHP releases module globals at run-main shutdown. Mint the real\n+        ;; local exception through source, in the observation's activation.\n+        payload-export (if (= frontend :php) \"seed\" \"payload\")\n         result 'probe.result\n         original 'probe.original\n         condition 'probe.condition\n@@ -83,7 +86,7 @@\n       (cond\n         (#{:fresh-named :fresh-closure :forged-retention} scenario)\n         (list 'let [original (list 'get (call (export (if (= scenario :forged-retention)\n-                                                        \"forged\" \"payload\"))\n+                                                        \"forged\" payload-export))\n                                               (if (= scenario :forged-retention)\n                                                 [(protocol-condition :yang.call/not-callable)] [])) :value)\n                     result (case scenario\n@@ -121,7 +124,7 @@\n                       (kit/observation-map-form protocol-summary))))\n \n         (= scenario :local-reception)\n-        (list 'let [original (list 'get (call (export \"payload\") []) :value)\n+        (list 'let [original (list 'get (call (export payload-export) []) :value)\n                     condition (kit/observation-map-form\n                                 {:yang.call/reason :yang.call/thrown\n                                  :yang.call/value original})\ndiff --git a/test/yang/call/exception_source_test.clj b/test/yang/call/exception_source_test.clj\nindex 06263f24..184c624a 100644\n--- a/test/yang/call/exception_source_test.clj\n+++ b/test/yang/call/exception_source_test.clj\n@@ -1,9 +1,10 @@\n (ns yang.call.exception-source-test\n-  \"Generator checks: refusals here are fixture defects, never runtime reds.\"\n+  \"Source admission checks and focused execution pins for Clojure finally.\"\n   (:require [clojure.test :refer [deftest is testing]]\n             [yang.call.conformance :as kit]\n             [yang.call.exception-contract :as contract]\n-            [yang.call.exception-legs :as legs]))\n+            [yang.call.exception-legs :as legs]\n+            [yang.call.exception-probes :as probes]))\n \n \n (defn- lower\n@@ -35,7 +36,64 @@\n \n \n (deftest clojure-restricted-catch-surface-preserved-test\n-  (is (thrown? clojure.lang.ExceptionInfo\n-        (lower :clojure \"(try 1 (finally 2))\" [])))\n+  ;; Still refused: the admitted catch surface is one Exception/ExceptionInfo\n+  ;; catch. Retiring the `finally` refusal does not widen the catch classes.\n   (is (thrown? clojure.lang.ExceptionInfo\n         (lower :clojure \"(try 1 (catch Throwable e 2))\" []))))\n+\n+\n+(deftest clojure-finally-admitted-test\n+  ;; Owner ruling 1794556000000 retired the refusal: a dialect's surface\n+  ;; derives from its source language. Execution is pinned separately below.\n+  (is (map? (lower :clojure \"(try 1 (finally 2))\" []))))\n+\n+\n+(deftest ^:slow runtime-payload-identity-test\n+  ;; PHP seeds after unit shutdown; the other frontends retain their\n+  ;; module-created payloads. Check the complete original expectations in\n+  ;; the shared batch, including all nine repaired PHP identity observations.\n+  (doseq [frontend (sort contract/frontends)]\n+    (let [observations (probes/run-frontend frontend)]\n+      (doseq [{:keys [id expected]}\n+              (filter #(= frontend (:frontend %)) contract/fixtures)]\n+        (testing (str id)\n+          (let [results (get observations id)]\n+            (is (= #{:register :semantic :stack} (set (keys results))))\n+            (doseq [[backend actual] results]\n+              (is (= expected actual) (str backend)))))))))\n+\n+\n+(deftest ^:slow clojure-finally-normal-exit-test\n+  ;; Clojure discards the finally value: preserve body value 1 and execute\n+  ;; cleanup exactly once. Observe through the established public-entry kit.\n+  (let [donor (kit/publish-donor! :clojure \"\")\n+        source (str \"(def cleaned (cell/new 0))\\n\"\n+                    \"(def result (try 1 (finally (cell/set! cleaned (+ (cell/get cleaned) 1)) 2)))\\n\"\n+                    \"(defn body_value [] result)\\n\"\n+                    \"(defn cleanup_count [] (cell/get cleaned))\\n\")\n+        call #(kit/boundary-call-form (kit/export-form :clojure %) [] [])\n+        observation\n+        (kit/guard-exceptions-form\n+          [:clojure]\n+          (list 'let ['body (call \"body_value\") 'cleanup (call \"cleanup_count\")]\n+                (kit/observation-map-form\n+                  {:body-route (list 'get 'body :route)\n+                   :value (list 'get 'body :value)\n+                   :cleanup-route (list 'get 'cleanup :route)\n+                   :cleanup-count (list 'get 'cleanup :value)})))\n+        results (kit/run-exception-program\n+                  donor (kit/compose-exception donor [] :clojure source observation))]\n+    (is (= #{:register :semantic :stack} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (is (= {:body-route :return :value 1 :cleanup-route :return :cleanup-count 1}\n+             actual) (str backend)))))\n+\n+\n+(deftest ^:slow clojure-finally-replacement-leg-test\n+  ;; Live for the first time now that the pair-matrix exclusion is gone.\n+  ;; Pair deftests are pair-scale; this pin also exposes a single leg to -v.\n+  (let [leg (first (filter #(= [:python :clojure :finally-replacement] (:id %))\n+                           contract/pair-matrix))]\n+    (is (some? leg))\n+    (doseq [[backend actual] (legs/run-leg leg)]\n+      (is (= (legs/expected leg) actual) (str backend)))))\ndiff --git a/test/yang/call/php_exception_test.clj b/test/yang/call/php_exception_test.clj\nnew file mode 100644\nindex 00000000..24f88382\n--- /dev/null\n+++ b/test/yang/call/php_exception_test.clj\n@@ -0,0 +1,803 @@\n+(ns yang.call.php-exception-test\n+  \"PHP boundary pins for ruling v2 R1+R2+R3 (one coherent round). Receivers\n+   and rethrows are parsed source; malformed protocol delivery uses the\n+   shared boundary kit. The focused local gate for the exception-php-r1r2r3\n+   round: the php subset of the shiva acceptance instrument, never a\n+   substitute for the full ledger.\"\n+  (:require [clojure.string :as str]\n+            [clojure.test :refer [deftest is testing]]\n+            [yang.call.conformance :as kit]\n+            [yang.call.exception-contract :as contract]\n+            [yang.call.exception-legs :as legs]\n+            [yang.call.exception-probes :as probes]\n+            [yang.php.antlr.prelude :as php-prelude]))\n+\n+\n+(defn- check-fixture\n+  \"Run one php fixture isolated on all three vector VMs and assert its\n+   compliant `:expected` value on each backend.\"\n+  [id]\n+  (let [fixture (first (filter #(= id (:id %)) contract/fixtures))]\n+    (testing (str id)\n+      (doseq [[backend actual] (probes/run-fixture fixture)]\n+        (is (= (:expected fixture) actual) (str backend))))))\n+\n+\n+(defn- check-leg\n+  \"Run one directed source pair/scenario and assert `legs/expected` per VM.\"\n+  [id]\n+  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\n+    (testing (str id)\n+      (doseq [[backend actual] (legs/run-leg leg)]\n+        (is (= (legs/expected leg) actual) (str id \" \" backend))))))\n+\n+\n+(deftest ^:slow php-fresh-egress-test\n+  ;; R1: the function entry and the Closure entry read the supplied\n+  ;; :yang.call/raise and deliver every escaping exception (and binding\n+  ;; failure) exactly once as the thrown condition; nothing runs after.\n+  (check-fixture :php/fresh-named)\n+  (check-fixture :php/fresh-closure)\n+  (check-fixture :php/binding))\n+\n+\n+(deftest ^:slow php-foreign-reception-test\n+  ;; R2: an already-local Throwable is delivered unchanged (identity kept);\n+  ;; an otherwise-foreign payload becomes the generated local\n+  ;; ForeignException retaining the complete condition.\n+  (check-fixture :php/local-reception)\n+  (check-fixture :php/foreign-reception)\n+  (check-fixture :php/retained-foreign-lifetime)\n+  ;; Directed legs with php as the RECEIVER: typed catch matches the local\n+  ;; hierarchy, unchanged rethrow forwards, stored wrappers rethrow from a\n+  ;; new activation.\n+  (check-leg [:python :php :typed-catch])\n+  (check-leg [:python :php :unchanged-rethrow])\n+  (check-leg [:python :php :retained-lifetime])\n+  (check-leg [:clojure :php :catch-all])\n+  ;; The bridge as DONOR: a php escape crossing into a landed frontend.\n+  (check-leg [:php :typescript :catch-all]))\n+\n+\n+(deftest ^:slow php-protocol-reception-test\n+  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n+  ;; complete condition instead of a fresh Error with selected text; the\n+  ;; saved-wrapper rethrow forwards the original condition, no wrapper\n+  ;; stacking.\n+  (check-fixture :php/protocol-not-callable)\n+  (check-fixture :php/protocol-invalid-invocation)\n+  (check-fixture :php/protocol-unsupported-binding)\n+  (check-fixture :php/saved-protocol-not-callable)\n+  (check-fixture :php/saved-protocol-invalid-invocation)\n+  (check-fixture :php/saved-protocol-unsupported-binding))\n+\n+\n+(deftest ^:slow php-forged-retention-test\n+  ;; R5: source-writable attributes never authenticate a retained\n+  ;; condition — a forged Exception carrying condition-looking props crosses\n+  ;; as a fresh :yang.call/thrown with the forged object as payload.\n+  (check-fixture :php/forged-retention))\n+\n+\n+(defn- injected\n+  \"The kit's synthetic entry delivering `condition` to the raise exit.\"\n+  [condition]\n+  (list 'cell/new\n+        (list 'assoc {} :yang.call/entry\n+              (list 'fn ['invocation]\n+                    (list (list 'get 'invocation :yang.call/raise) condition)))))\n+\n+\n+(defn- boundary-call\n+  [callee args]\n+  (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n+\n+\n+(defn- genuine-wrapper-bindings\n+  \"Guest bindings that mint a genuine ForeignException wrapper through php\n+   reception: the contract `retain` catches it and returns it normally.\"\n+  []\n+  ['probe.condition (kit/observation-map-form\n+                      {:yang.call/reason :yang.call/thrown\n+                       :yang.call/value (list 'cell/new {:foreign/payload :identity})\n+                       :yang.call/data {:complete [:extra :evidence]}})\n+   'probe.injected (injected 'probe.condition)\n+   'probe.retained (boundary-call (kit/export-form :php \"retain\") ['probe.injected])\n+   'probe.wrapper (list 'get 'probe.retained :value)])\n+\n+\n+(def ^:private egress-source\n+  \"The contract's php exception shapes with the module-level `$original`\n+   replaced by a function-seeded global. php's run-main shutdown releases\n+   the caller unit's globals when the unit returns (PHP script-end\n+   semantics), and the kit's boundary observations run AFTER the caller\n+   unit — so a module-level `$original = new Exception(...)` reads back\n+   null through `payload()` in this lane (a pre-existing instrument/lane\n+   conflict recorded in the round's findings; the base commit behaves the\n+   same). A global WRITTEN by a called function after the unit's run\n+   persists for the later observation calls, so `seed` mints the\n+   identity-bearing original the directed legs below throw, rethrow and\n+   retain — the same assertions the three lane-blocked fixtures\n+   (:php/fresh-named, :php/fresh-closure, :php/local-reception) make on\n+   module-level state. `retain` keeps its wrapper in `$caught`, never\n+   touching the original's `$saved`.\"\n+  (str \"<?php $saved = null; $caught = null;\"\n+       \"function seed() { global $saved; $saved = new Exception('original'); return $saved; }\"\n+       \"function payload() { global $saved; return $saved; }\"\n+       \"function donor_raise() { global $saved; throw $saved; }\"\n+       \"function make_exploder() { return function() { global $saved; throw $saved; }; }\"\n+       \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\"\n+       \"function retain($f) { global $caught; try { return $f(); }\"\n+       \" catch (Throwable $e) { $caught = $e; return $e; } }\"))\n+\n+\n+(defn- run-egress-observation\n+  \"The egress source as caller, the python boundary donor beside it, and\n+   `observation` appended: all three linked vector VMs.\"\n+  [observation]\n+  (let [donor (kit/publish-donor! :python contract/boundary-source)]\n+    (kit/run-exception-program\n+      donor (kit/compose-exception donor [\"boundary_target\"] :php\n+                                   egress-source observation))))\n+\n+\n+(deftest ^:slow php-fresh-egress-directed-test\n+  ;; R1, directed (the in-lane form of :php/fresh-named and\n+  ;; :php/fresh-closure): the function entry and the Closure entry deliver\n+  ;; the escaping source Exception to the supplied raise exit exactly once\n+  ;; as {:yang.call/thrown, original} — the payload IS the thrown object.\n+  (let [observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let ['probe.seeded (boundary-call (kit/export-form :php \"seed\") [])\n+                      'original (list 'get 'probe.seeded :value)\n+                      'probe.named (boundary-call (kit/export-form :php \"donor_raise\") [])\n+                      'probe.closure (boundary-call\n+                                       (list 'get (boundary-call\n+                                                    (kit/export-form :php \"make_exploder\") [])\n+                                             :value) [])]\n+                (kit/observation-map-form\n+                  {:seeded (list '= :return (list 'get 'probe.seeded :route))\n+                   :named-transferred (list '= :raise (list 'get 'probe.named :route))\n+                   :named-once (list '= 1 (list 'get 'probe.named :transfers))\n+                   :named-after (list 'get 'probe.named :after)\n+                   :named-reason (list 'get (list 'get 'probe.named :condition)\n+                                       :yang.call/reason)\n+                   :named-payload-identical\n+                   (list '= 'original (list 'get (list 'get 'probe.named :condition)\n+                                            :yang.call/value))\n+                   :closure-transferred (list '= :raise (list 'get 'probe.closure :route))\n+                   :closure-once (list '= 1 (list 'get 'probe.closure :transfers))\n+                   :closure-after (list 'get 'probe.closure :after)\n+                   :closure-reason (list 'get (list 'get 'probe.closure :condition)\n+                                         :yang.call/reason)\n+                   :closure-payload-identical\n+                   (list '= 'original (list 'get (list 'get 'probe.closure :condition)\n+                                            :yang.call/value))})))\n+        expected {:seeded true\n+                  :named-transferred true :named-once true :named-after false\n+                  :named-reason :yang.call/thrown :named-payload-identical true\n+                  :closure-transferred true :closure-once true :closure-after false\n+                  :closure-reason :yang.call/thrown :closure-payload-identical true}]\n+    (doseq [[backend actual] (run-egress-observation observation)]\n+      (is (= expected actual) (str backend)))))\n+\n+\n+(deftest ^:slow php-local-reception-directed-test\n+  ;; R2, directed (the in-lane form of :php/local-reception): a thrown\n+  ;; condition whose payload is already a php Throwable keeps its ordinary\n+  ;; catching and identity — re-raised UNCHANGED (typed catch, unchanged\n+  ;; rethrow, returned identity), never wrapped.\n+  (let [observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let ['probe.seeded (boundary-call (kit/export-form :php \"seed\") [])\n+                      'original (list 'get 'probe.seeded :value)\n+                      'probe.condition (kit/observation-map-form\n+                                         {:yang.call/reason :yang.call/thrown\n+                                          :yang.call/value 'original})\n+                      'probe.injected (injected 'probe.condition)\n+                      'probe.reres (boundary-call (kit/export-form :php \"receive\")\n+                                                  ['probe.injected])\n+                      'probe.rtres (boundary-call (kit/export-form :php \"retain\")\n+                                                  ['probe.injected])]\n+                (kit/observation-map-form\n+                  {:seeded (list '= :return (list 'get 'probe.seeded :route))\n+                   :rethrow-transferred (list '= :raise (list 'get 'probe.reres :route))\n+                   :rethrow-once (list '= 1 (list 'get 'probe.reres :transfers))\n+                   :rethrow-reason (list 'get (list 'get 'probe.reres :condition)\n+                                         :yang.call/reason)\n+                   :rethrow-payload-identical\n+                   (list '= 'original (list 'get (list 'get 'probe.reres :condition)\n+                                            :yang.call/value))\n+                   :retain-returned (list '= :return (list 'get 'probe.rtres :route))\n+                   :retain-payload-identical\n+                   (list '= 'original (list 'get 'probe.rtres :value))})))\n+        expected {:seeded true\n+                  :rethrow-transferred true :rethrow-once true\n+                  :rethrow-reason :yang.call/thrown\n+                  :rethrow-payload-identical true\n+                  :retain-returned true :retain-payload-identical true}]\n+    (doseq [[backend actual] (run-egress-observation observation)]\n+      (is (= expected actual) (str backend)))))\n+\n+\n+(defn- run-provenance-observation\n+  \"The contract php source as caller, the python boundary donor beside it,\n+   and `observation` appended: all three linked vector VMs.\"\n+  [observation]\n+  (let [donor (kit/publish-donor! :python contract/boundary-source)]\n+    (kit/run-exception-program\n+      donor (kit/compose-exception donor [\"boundary_target\"] :php\n+                                   (contract/sources :php) observation))))\n+\n+\n+(deftest ^:slow php-copied-wrapper-forgery-test\n+  ;; A fresh state cell carrying a genuine wrapper's complete contents is a\n+  ;; DIFFERENT object: provenance is bound to the wrapper's identity (its\n+  ;; sealed state-cell reference), never to its copyable contents. Throwing\n+  ;; the copy from a new activation must NOT forward the original condition.\n+  (let [observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let (into (genuine-wrapper-bindings)\n+                           ['probe.copy (list 'assoc {} :php/obj\n+                                              (list 'cell/new\n+                                                    (list 'cell/get\n+                                                          (list 'get 'probe.wrapper :php/obj))))\n+                            'probe.result (boundary-call (kit/export-form :php \"raise_value\")\n+                                                         ['probe.copy])])\n+                (kit/observation-map-form\n+                  {:retained (list '= :return (list 'get 'probe.retained :route))\n+                   :copy-refused\n+                   (list 'if (list '= :raise (list 'get 'probe.result :route))\n+                         (list 'if (list '= 1 (list 'get 'probe.result :transfers))\n+                               (list 'if (list '= :yang.call/thrown\n+                                               (list 'get (list 'get 'probe.result :condition)\n+                                                     :yang.call/reason))\n+                                     (list '= 'probe.copy\n+                                           (list 'get (list 'get 'probe.result :condition)\n+                                                 :yang.call/value))\n+                                     false)\n+                               false)\n+                         false)})))]\n+    (doseq [[backend actual] (run-provenance-observation observation)]\n+      (is (= {:retained true :copy-refused true} actual) (str backend)))))\n+\n+\n+(deftest ^:slow php-mutated-wrapper-forwarding-test\n+  ;; Mutating the genuine wrapper's own state (its copied-visible contents)\n+  ;; neither breaks nor replaces the association: rethrowing the SAME\n+  ;; wrapper still forwards the ORIGINAL condition (sol's round-2 attack,\n+  ;; adapted to the php handle layout).\n+  (let [observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let (into (genuine-wrapper-bindings)\n+                           ['probe.attack\n+                            (list 'do (list 'cell/set!\n+                                            (list 'get 'probe.wrapper :php/obj)\n+                                            (list 'assoc\n+                                                  (list 'cell/get\n+                                                        (list 'get 'probe.wrapper :php/obj))\n+                                                  :ord 9999)))\n+                            'probe.result (boundary-call (kit/export-form :php \"raise_value\")\n+                                                         ['probe.wrapper])])\n+                (kit/observation-map-form\n+                  {:retained (list '= :return (list 'get 'probe.retained :route))\n+                   :original-forwarded\n+                   (list 'if (list '= :raise (list 'get 'probe.result :route))\n+                         (list 'if (list '= 1 (list 'get 'probe.result :transfers))\n+                               (list '= 'probe.condition (list 'get 'probe.result :condition))\n+                               false)\n+                         false)})))]\n+    (doseq [[backend actual] (run-provenance-observation observation)]\n+      (is (= {:retained true :original-forwarded true} actual) (str backend)))))\n+\n+\n+(deftest ^:slow php-kit-parity-test\n+  ;; The hard-rule pin: exercise :reason classification AND\n+  ;; :condition-identical payload identity at the ADMITTED guest-call\n+  ;; boundary the way yang.call.exception-contract-test does — the refusal\n+  ;; is produced by public validation (not-callable on an empty map),\n+  ;; delivered by a callable cell's raise exit through parsed PHP `receive`\n+  ;; and its bare `throw $e` rethrow.\n+  (let [source (str \"<?php \"\n+                    \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\")\n+        observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let ['condition (list 'get (boundary-call {} []) :condition)\n+                      'injected (injected 'condition)\n+                      'result (boundary-call (kit/export-form :php \"receive\") ['injected])]\n+                (kit/observation-map-form\n+                  {:reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n+                   :condition-identical (list '= 'condition (list 'get 'result :condition))})))\n+        donor (kit/publish-donor! :python contract/boundary-source)\n+        results (kit/run-exception-program\n+                  donor (kit/compose-exception donor [\"boundary_target\"]\n+                                               :php source observation))]\n+    (is (= #{:semantic :stack :register} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (println \"PHP-KIT-PARITY\" backend actual)\n+      (is (= {:reason :yang.call/not-callable :condition-identical true} actual)\n+          (str backend)))))\n+\n+\n+(deftest ^:slow php-kit-batch-parity-test\n+  ;; Acceptance uses run-frontend, which shares a task across observations.\n+  ;; Isolated run-fixture pins alone cannot establish that batch path.\n+  (let [fixtures (filter #(= :php (:frontend %)) contract/fixtures)\n+        observations (probes/run-frontend :php)]\n+    (is (= (set (map :id fixtures)) (set (keys observations))))\n+    (doseq [{:keys [id expected]} fixtures\n+            :let [results (get observations id)]]\n+      (is (= #{:semantic :stack :register} (set (keys results))) (str id))\n+      (doseq [[backend actual] results]\n+        (println \"PHP-KIT-BATCH\" id backend actual)\n+        (is (= expected actual) (str id \" \" backend))))))\n+\n+\n+(deftest php-retention-store-surface-test\n+  ;; Host side (the php analog of the ts store-root pin's host half): the\n+  ;; private retained-condition store is not a runtime key and none of the\n+  ;; installed retention names is a module export, so admitted source cannot\n+  ;; reach the store by enumerating either, and no frozen pre-init export\n+  ;; binding can silently answer for it. The r7 steward addendum's F2\n+  ;; mirror: the GENERAL surface half — no reserved-door (dsg__) name and\n+  ;; no mint/retention name appears in EITHER surface, not just the\n+  ;; individually named ones (the definition-graph half lives in\n+  ;; php-mint-reachability-test).\n+  (is (not-any? #(str/includes? (str %) \"retained\") php-prelude/runtime-keys)\n+      \"no retained store/seal runtime key for admitted source to name\")\n+  (is (not-any? #(str/includes? (str %) \"dsg__\") php-prelude/runtime-keys)\n+      \"no reserved-door runtime key for admitted source to name\")\n+  (is (not-any? #(str/includes? (str %) \"dsg__\") php-prelude/module-exports)\n+      \"no reserved-door name is a module export\")\n+  (is (not-any? #(re-find #\"mint|retained|raise-foreign|raise-protocol\"\n+                          (str %))\n+                php-prelude/module-exports)\n+      \"no mint/retention name is a module export\")\n+  (is (not (contains? php-prelude/module-exports 'retained-condition))\n+      \"retained-condition is not a module export: no frozen pre-init binding\")\n+  (is (not (contains? php-prelude/module-exports 'raise-protocol))\n+      \"raise-protocol is not a module export: no frozen pre-init binding\")\n+  (is (not (contains? php-prelude/module-exports 'raise-foreign))\n+      \"raise-foreign is not a module export: no frozen pre-init binding\"))\n+\n+\n+(deftest php-provenance-adoption-test\n+  ;; The r3 adoption pins (host side, the php twin of the py adoption audit\n+  ;; the step-7 review asked for): wrapper retention goes through the VM\n+  ;; provenance primitive's reserved doors — cell/dsg__new-provenance mints,\n+  ;; cell/dsg__provenance reads — declared as host dependencies of the php\n+  ;; module, never reimplemented in prelude code; and no minting or retention\n+  ;; helper is a module export (the exported-helper bypass class the ruling\n+  ;; names: a guest able to call the mint could forge provenance of its own\n+  ;; choosing).\n+  (is (contains? php-prelude/host-names 'cell/dsg__new-provenance)\n+      \"the reserved mint door is a declared host dependency\")\n+  (is (contains? php-prelude/host-names 'cell/dsg__provenance)\n+      \"the reserved read door is a declared host dependency\")\n+  (is (not (contains? php-prelude/module-exports 'mint-retained))\n+      \"the mint helper is not a module export\")\n+  ;; r4 (sol P1): the php.rt/-prefix assertion above cannot catch a\n+  ;; dangerous helper under a stripped php/ name — module-exports holds\n+  ;; STRIPPED names, so the condition-accepting receiver must be named\n+  ;; explicitly too.\n+  (is (not (contains? php-prelude/module-exports 'receive-condition))\n+      \"the condition-accepting receiver is not a module export\")\n+  (is (not-any? #(str/starts-with? (str %) \"php.rt/\") php-prelude/module-exports)\n+      \"no php.rt name is a module export: no guest-reachable retention surface\"))\n+\n+\n+(deftest php-mint-reachability-test\n+  ;; r4 (sol P1): no module export — no php/-prefixed definition, the only\n+  ;; ones core/exports takes — DIRECTLY reaches the provenance mint or the\n+  ;; condition-accepting receiver. One hop is the discriminating depth: a\n+  ;; direct mention is a guest-reachable name whose own parameter can flow\n+  ;; to the mint as a condition (the php/receive-condition bypass), while\n+  ;; deeper reachability runs through the call helpers' callback wiring,\n+  ;; where every condition is bridge- or validation-built, never a guest\n+  ;; argument. The three call helpers are whitelisted for exactly that\n+  ;; wiring: they mention the receiver only as the raise exit they hand to\n+  ;; yang.call/invoke. RED while php/receive-condition is exported (its\n+  ;; body references php.rt/raise-foreign and php.rt/raise-protocol).\n+  (let [defs (into {} @#'yang.php.antlr.prelude/core-definitions)\n+        exports php-prelude/module-exports\n+        minters '#{php.rt/mint-retained php.rt/raise-foreign\n+                   php.rt/raise-protocol php.rt/receive-condition}\n+        whitelist '#{php/call php/call-with-binding-profile php/call-named}\n+        exported-keys (filter #(contains? exports (php-prelude/strip %)) (keys defs))\n+        mentions (fn [form] (some minters (tree-seq coll? seq form)))\n+        offenders (remove whitelist (filter (fn [k] (mentions (get defs k))) exported-keys))]\n+    (is (pos? (count exported-keys)) \"the audit saw the export surface\")\n+    (is (empty? offenders)\n+        (str \"exported definitions reach the mint surface: \" (pr-str offenders)))))\n+\n+\n+(defn- resolution-refusal?\n+  \"True when `x` is exactly the expected outcome of calling the retired\n+   receiver name: the engine's variable-resolution refusal naming\n+   php/receive-condition — never an unrelated failure.\"\n+  [x]\n+  (and (instance? Throwable x)\n+       (map? (ex-data x))\n+       (= 'php/receive-condition (get (ex-data x) :symbol))))\n+\n+\n+(deftest ^:slow php-exported-mint-forgery-test\n+  ;; r4 (sol P1), the executed bypass: while the receiver is exported, a\n+  ;; composed unit's boundary form can call it directly with a forged\n+  ;; condition — the receiver mints a GENUINE provenance-carrying\n+  ;; ForeignException whose retained condition is the attacker's map, and\n+  ;; the unchanged rethrow forwards it as if it were a real retained\n+  ;; condition. After the repair the receiver is php.rt/receive-condition\n+  ;; (compiler-private, never exported), so the forged call cannot even\n+  ;; link: no green run ever delivers the forged condition. The assertion\n+  ;; (tightened per sol's r5 P3 follow-up) accepts ONLY the expected\n+  ;; resolution refusal of the retired name, or an explicitly successful\n+  ;; observation answering :forged-forwarded false — an unrelated host\n+  ;; exception, nil or a malformed observation fails the pin.\n+  (let [observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let ['probe.forged (kit/observation-map-form\n+                                      {:yang.call/reason :yang.call/not-callable\n+                                       :yang.call/data {:forged true}})\n+                      'probe.box (list 'cell/new nil)\n+                      'probe.caught (list 'php/try\n+                                          (list 'fn []\n+                                                (list 'php/receive-condition 'probe.forged))\n+                                          (list 'fn ['e]\n+                                                (list 'do (list 'cell/set! 'probe.box 'e) nil))\n+                                          (list 'fn [] nil))\n+                      'probe.wrapper (list 'cell/get 'probe.box)\n+                      'probe.result (boundary-call (kit/export-form :php \"raise_value\")\n+                                                   ['probe.wrapper])]\n+                (kit/observation-map-form\n+                  {:caught-a-wrapper (list 'not (list 'nil? 'probe.wrapper))\n+                   :forged-forwarded\n+                   (list 'if (list '= :raise (list 'get 'probe.result :route))\n+                         (list '= 'probe.forged (list 'get 'probe.result :condition))\n+                         false)})))\n+        results (run-provenance-observation observation)]\n+    (is (= #{:semantic :stack :register} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (println \"PHP-MINT-FORGERY\" backend (type actual))\n+      (is (or (resolution-refusal? actual)\n+              (and (map? actual) (false? (:forged-forwarded actual))))\n+          (str backend \": only the resolution refusal of the retired name, or an \"\n+               \"explicit no-forgery observation, is acceptable (got \"\n+               (pr-str actual) \")\")))))\n+\n+\n+(deftest ^:slow php-handle-shaped-foreign-payload-test\n+  ;; r4 (sol P2) + r5 (sol's re-check counterexamples): ordinary foreign\n+  ;; data shaped like a php object is FOREIGN — reception retains the\n+  ;; complete original condition (reason, evidence, payload identity) in\n+  ;; the ForeignException instead of refusing at the unauthenticated cell\n+  ;; read, the class lookup, or the ownership acquisition. The r5 shapes\n+  ;; pin the representation mismatches (MIXED TAGS — instance-of selects\n+  ;; by the non-nil :php/obj key; AUTHENTIC CELL WITH INVALID STATE —\n+  ;; authenticity proves liveness, not object state); the r6 shapes pin\n+  ;; the ownership consumer (addref's slot-kind selects :php/ref FIRST,\n+  ;; so COMPETING MARKERS on an otherwise-valid map or real handle are\n+  ;; consumed unchecked; and a string class alone is insufficient when\n+  ;; :rc is absent — addref's count acquisition consumes it); the count\n+  ;; shapes pin the domain admission itself — a count the ownership\n+  ;; arithmetic cannot operate on (non-number, float content, a computed\n+  ;; ratio) is invalid counted-object state and is retained whole rather\n+  ;; than consumed. The native int ENDPOINTS are not here: sol's endpoint\n+  ;; ruling (re-check 5) is that a count the repaired exact arithmetic\n+  ;; itself produces — at the long maximum, past it, or at the minimum —\n+  ;; is ordinary LOCAL state whose class and identity §8.10.7 rule 1\n+  ;; preserves, so those shapes assert local identity in\n+  ;; php-count-acquisition-test below. All eleven shapes run in ONE\n+  ;; composed program (the batch-parity task-sharing shape), not one kit\n+  ;; run per shape: the laptop lane's dao.jing stall reliably catches the\n+  ;; 8th consecutive per-shape run in one JVM.\n+  (let [shapes [[\"non-reference\" {:php/obj 42}]\n+                [\"forged-ref\" {:php/obj {:type :cell-ref, :id 99999, :seal \"forged\"}}]\n+                [\"forged-class\" {:php/type :obj, :class 42, :props {}}]\n+                [\"mixed-tags\" {:php/type :obj, :class \"Exception\", :php/obj 42}]\n+                [\"authentic-cell-bad-class\"\n+                 ;; :rc 1 keeps the class check independently discriminating\n+                 ;; (the re-check3 coverage note): without a valid count the\n+                 ;; count rejection could mask a class-validation regression\n+                 (kit/observation-map-form {:php/obj (list 'cell/new {:class 42, :rc 1})})]\n+                [\"map-mixed-ref\" {:php/type :obj, :class \"Exception\", :php/ref 42}]\n+                [\"real-handle-competing-ref\"\n+                 (list 'assoc (list 'php/make-error \"Exception\" \"real\") :php/ref 42)]\n+                [\"string-class-no-rc\"\n+                 (kit/observation-map-form {:php/obj (list 'cell/new {:class \"Exception\"})})]\n+                ;; non-number counts stay rejected (the r6 rule; pinned so\n+                ;; the incrementability refinement cannot silently drop it)\n+                [\"non-number-count\"\n+                 (kit/observation-map-form\n+                   {:php/obj (list 'cell/new (list 'assoc {:class \"Exception\"}\n+                                                   :rc \"bad\"))})]\n+                ;; FLOAT64 CONTENT is not an exact-integer carrier on any\n+                ;; host (a JVM/Dart double, the JS Float64 carrier), so it\n+                ;; is not a count. This is sol's own re-check5 control.\n+                ;; His other one, (data/float-value 1), is deliberately NOT\n+                ;; pinned: on JS it yields a bare integral Number, which\n+                ;; exact-integer? admits, so its disposition is genuinely\n+                ;; host-divergent and a JVM-only pin would freeze the\n+                ;; wrong half of it.\n+                [\"float-count\"\n+                 (kit/observation-map-form\n+                   {:php/obj (list 'cell/new (list 'assoc {:class \"Exception\"}\n+                                                   :rc (list 'data/float64 1)))})]\n+                ;; r10 residual 2: a computed RATIO count — data/number? and\n+                ;; php/int? both pass it (kind's float64 content test), but\n+                ;; it is not an exact-integer carrier and the integer\n+                ;; primitives refuse it; the count test must use the EXACT\n+                ;; domain predicate (integer/integer?), not a php\n+                ;; representation classifier.\n+                [\"ratio-count\"\n+                 (kit/observation-map-form\n+                   {:php/obj (list 'cell/new (list 'assoc {:class \"Exception\"}\n+                                                   :rc (list '/ 1 2)))})]]\n+        leg (fn [label payload]\n+              (let [n (fn [k] (symbol (str \"probe.\" (name label) \".\" (name k))))\n+                    p (n :payload) c (n :condition) i (n :injected)\n+                    r (n :retained) w (n :wrapper) loc (n :local) l (n :later)]\n+                {:bindings [p payload\n+                            c (kit/observation-map-form\n+                                {:yang.call/reason :yang.call/thrown\n+                                 :yang.call/value p\n+                                 :yang.call/data {:complete [:evidence]}})\n+                            i (injected c)\n+                            r (boundary-call (kit/export-form :php \"retain\") [i])\n+                            w (list 'get r :value)\n+                            loc (list 'if (list '= :return (list 'get r :route))\n+                                      (boundary-call (kit/export-form :php \"is_foreign\") [w])\n+                                      {:value false})\n+                            ;; immediately after this shape's retain: later\n+                            ;; reads the $saved this retain stored, before\n+                            ;; the next shape's retain overwrites it\n+                            l (boundary-call (kit/export-form :php \"later\") [])]\n+                 :entries {(keyword (str label \"-retained\"))\n+                           (list '= :return (list 'get r :route))\n+                           (keyword (str label \"-local\"))\n+                           (list '= true (list 'get loc :value))\n+                           (keyword (str label \"-condition\"))\n+                           (list '= c (list 'get l :condition))\n+                           (keyword (str label \"-payload\"))\n+                           (list '= p (list 'get (list 'get l :condition)\n+                                            :yang.call/value))}}))\n+        legs (map (partial apply leg) shapes)\n+        observation (kit/guard-exceptions-form\n+                      [:php]\n+                      (list 'let (into [] (mapcat :bindings) legs)\n+                            (kit/observation-map-form (into {} (mapcat :entries) legs))))\n+        expected (into {} (mapcat (fn [[label _]]\n+                                    (map (fn [k] [(keyword (str label \"-\" k)) true])\n+                                         [\"retained\" \"local\" \"condition\" \"payload\"])))\n+                       shapes)\n+        results (run-provenance-observation observation)]\n+    (is (= #{:semantic :stack :register} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (println \"PHP-HANDLE-SHAPED\" backend actual)\n+      (is (= expected actual)\n+          (str backend \": every handle-shaped foreign payload retains the \"\n+               \"complete condition\")))))\n+\n+\n+(def ^:private count-source\n+  \"The r11 count-domain receiver: an ORDINARY php catch/return — no numeric\n+   operation anywhere in the source — whose `return $e` runs the lowerer's\n+   routine php/addref acquisition on the caught value, so a count that\n+   survives reception must survive the next acquisition too.\n+   `is_local_exception` reads the caught value's own class through the\n+   contract's proven `get_class` idiom, which is what distinguishes an\n+   unchanged local Exception from the ForeignException a wrapping reception\n+   delivers. Every count below is admitted LOCAL state under sol's endpoint\n+   ruling: MAX-1, which reception's acquisition moves ONTO the native long\n+   maximum and the return then moves past it, into the host big carrier,\n+   where the raw host + threw; MAX and MIN themselves, which the repaired\n+   exact arithmetic produces and consumes like any other count; and 2^53,\n+   the JS safe-Number boundary — a plain Long on the JVM, which is what this\n+   lane verifies, and a BigInt carrier on JS, where the same decimal parses\n+   past the safe range and a raw (+ rc 1) mixes a BigInt with a Number and\n+   throws a TypeError (the re-check's Node primitive diagnostic, both signs;\n+   the tri-host acceptance lane covers Node). The fifth count, T-1 =\n+   2^99999 - 1, is sol's re-check6 counterexample: a legal guest count one\n+   ordinary acquisition below the endpoint r11's doubling probe had itself\n+   created, which must therefore stay local across BOTH receptions.\"\n+  (str \"<?php function catch_return($f) {\"\n+       \" try { return $f(); } catch (Throwable $e) { return $e; } }\"\n+       \" function is_local_exception($e) { return get_class($e) === 'Exception'; }\"))\n+\n+\n+(deftest ^:slow php-count-acquisition-test\n+  ;; r11, sol's re-check5 residual: reception must preserve local type and\n+  ;; identity across ordinary acquisitions AND across a LATER reception.\n+  ;; Each shape calls the same receiver TWICE on the same callable and the\n+  ;; same condition, keeping the first result live in a guest binding while\n+  ;; the second call runs — no count edits, no numeric operations and no\n+  ;; malformed-condition tricks in between. At the previous tip the\n+  ;; near-max row failed exactly here: the first call returned the original\n+  ;; Exception, its acquisitions left the count AT the native maximum, and\n+  ;; the second reception excluded that endpoint and came back a\n+  ;; ForeignException. An ordinary catch retaining one more reference\n+  ;; cannot make an unchanged local exception foreign (§8.10.7 rule 1,\n+  ;; owner ruling v2 R2), so BOTH results are asserted identical to the\n+  ;; original payload and of the original Exception class. The endpoint\n+  ;; cases live here rather than in the foreign set above because this\n+  ;; ruling makes them local; their foreign-disposition payload forms are\n+  ;; unchanged, only the asserted disposition moved.\n+  ;; r12 adds the fifth shape, sol's re-check6 counterexample: the\n+  ;; doubling probe r11 layered on top of the increment probe was itself an\n+  ;; admission endpoint, one ordinary acquisition away from a legally\n+  ;; constructed count. Five shapes x six observations = 30 expected keys\n+  ;; per backend.\n+  (let [shapes [[\"near-max\" (list 'integer/parse \"9223372036854775806\")]\n+                [\"max\" (list 'integer/parse \"9223372036854775807\")]\n+                [\"min\" (list 'integer/parse \"-9223372036854775808\")]\n+                [\"js-number-boundary\" (list 'integer/parse \"9007199254740992\")]\n+                ;; r12, sol's re-check6 counterexample: T-1, one below\n+                ;; T = 2^(max-bits - 1) = 2^99999 in these lanes, built\n+                ;; entirely from admitted integer-module operations, so it\n+                ;; is a legal guest count and no raw host arithmetic is\n+                ;; involved. r11's doubling probe admitted it, ONE ordinary\n+                ;; acquisition moved it to T, and the next reception's\n+                ;; doubling (T+T = 2^max-bits) answered ::bit-limit — so a\n+                ;; purely local Throwable the runtime itself had just\n+                ;; produced came back as a ForeignException, the identity\n+                ;; failure re-check5 condemned, recreated by the\n+                ;; classifier's own extra computation. Red at the previous\n+                ;; tip on the two second-* keys; green with the doubling\n+                ;; removed, because addref's rc+1 and delref's rc-1 both\n+                ;; still yield integers at T.\n+                [\"t-minus-one\"\n+                 (list 'integer/sub (list 'integer/shift-left 1 99999) 1)]]\n+        leg (fn [[label count-form]]\n+              (let [n (fn [k] (symbol (str \"probe.\" (name label) \".\" (name k))))\n+                    p (n :payload) c (n :condition) i (n :injected)\n+                    r1 (n :first) v1 (n :first-value) g1 (n :first-class)\n+                    r2 (n :second) v2 (n :second-value) g2 (n :second-class)]\n+                {:bindings [p (kit/observation-map-form\n+                                {:php/obj (list 'cell/new\n+                                                (list 'assoc {:class \"Exception\"}\n+                                                      :rc count-form))})\n+                            c (kit/observation-map-form\n+                                {:yang.call/reason :yang.call/thrown\n+                                 :yang.call/value p})\n+                            i (injected c)\n+                            ;; the first reception; v1 stays bound, so the\n+                            ;; first result is still live across the second\n+                            r1 (boundary-call (kit/export-form :php \"catch_return\") [i])\n+                            v1 (list 'get r1 :value)\n+                            g1 (boundary-call (kit/export-form :php \"is_local_exception\") [v1])\n+                            ;; the second reception of the SAME condition\n+                            r2 (boundary-call (kit/export-form :php \"catch_return\") [i])\n+                            v2 (list 'get r2 :value)\n+                            g2 (boundary-call (kit/export-form :php \"is_local_exception\") [v2])]\n+                 :entries {(keyword (str label \"-first-returned\"))\n+                           (list '= :return (list 'get r1 :route))\n+                           (keyword (str label \"-first-class\"))\n+                           (list '= true (list 'get g1 :value))\n+                           (keyword (str label \"-first-identical\"))\n+                           (list '= p v1)\n+                           (keyword (str label \"-second-returned\"))\n+                           (list '= :return (list 'get r2 :route))\n+                           (keyword (str label \"-second-class\"))\n+                           (list '= true (list 'get g2 :value))\n+                           (keyword (str label \"-second-identical\"))\n+                           (list '= p v2)}}))\n+        legs (map leg shapes)\n+        observation (kit/guard-exceptions-form\n+                      [:php]\n+                      (list 'let (into [] (mapcat :bindings) legs)\n+                            (kit/observation-map-form (into {} (mapcat :entries) legs))))\n+        expected (into {} (mapcat (fn [[label _]]\n+                                    (map (fn [k] [(keyword (str label \"-\" k)) true])\n+                                         [\"first-returned\" \"first-class\" \"first-identical\"\n+                                          \"second-returned\" \"second-class\" \"second-identical\"]))\n+                                  shapes))\n+        donor (kit/publish-donor! :python contract/boundary-source)\n+        results (kit/run-exception-program\n+                  donor (kit/compose-exception donor [\"boundary_target\"] :php\n+                                               count-source observation))]\n+    (is (= #{:semantic :stack :register} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (println \"PHP-COUNT-ACQUISITION\" backend actual)\n+      (is (= expected actual)\n+          (str backend \": every boundary count keeps its Exception class and \"\n+               \"its identity through two receptions, the first result live\")))))\n+\n+\n+(deftest ^:slow php-count-limit-test\n+  ;; r11: the limit-aware half of the admission predicate, and the reason\n+  ;; removing the signed-64-bit bounds is not a bare revert. The integer\n+  ;; module bounds every result IT produces by ::integer/max-bits, but the\n+  ;; VM's raw host `+` (yin.vm/primitives registers clojure.core's) does\n+  ;; not, so a guest can hold an exact integer the module will not operate\n+  ;; on: 2^99999 + 2^99999 = 2^100000, one bit wider than the 100000-bit\n+  ;; limit these lanes install (yang.typescript.antlr.linked-harness's\n+  ;; integer-limits, the registry yang.call.conformance admits). For such a\n+  ;; count integer/add answers the ::bit-limit KEYWORD instead of an\n+  ;; integer; installing that as :rc would make the next ownership\n+  ;; operation refuse with a host :wrong-type failure escaping the\n+  ;; boundary. php/obj-val? therefore probes the arithmetic itself —\n+  ;; addref's own rc+1 and delref's own rc-1, and nothing else — instead of\n+  ;; bounding the carrier, so this count is FOREIGN and retained whole:\n+  ;; genuinely unsupported state, told apart from the endpoint counts the\n+  ;; repaired arithmetic produces all by itself. This is the half of the\n+  ;; limit policy that must NOT be deleted along with r11's doubling probe;\n+  ;; the other half — a count one acquisition below the doubling's own\n+  ;; endpoint, T-1, which must stay LOCAL through two receptions — is the\n+  ;; `t-minus-one` shape of php-count-acquisition-test above, where the\n+  ;; two-reception harness already lives. Kept in its own deftest so its\n+  ;; lane-specific width cannot contaminate the shape matrix; under a\n+  ;; composition limit other than 100000 bits the shift would need\n+  ;; re-deriving.\n+  (let [n (fn [k] (symbol (str \"probe.over-limit.\" (name k))))\n+        p (n :payload) c (n :condition) i (n :injected)\n+        r (n :retained) w (n :wrapper) loc (n :local) l (n :later)\n+        wide (list '+ (list 'integer/shift-left 1 99999) (list 'integer/shift-left 1 99999))\n+        observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let [p (kit/observation-map-form\n+                          {:php/obj (list 'cell/new\n+                                          (list 'assoc {:class \"Exception\"} :rc wide))})\n+                      c (kit/observation-map-form\n+                          {:yang.call/reason :yang.call/thrown\n+                           :yang.call/value p\n+                           :yang.call/data {:complete [:evidence]}})\n+                      i (injected c)\n+                      r (boundary-call (kit/export-form :php \"retain\") [i])\n+                      w (list 'get r :value)\n+                      loc (list 'if (list '= :return (list 'get r :route))\n+                                (boundary-call (kit/export-form :php \"is_foreign\") [w])\n+                                {:value false})\n+                      l (boundary-call (kit/export-form :php \"later\") [])]\n+                (kit/observation-map-form\n+                  {:retained (list '= :return (list 'get r :route))\n+                   :local (list '= true (list 'get loc :value))\n+                   :condition (list '= c (list 'get l :condition))\n+                   :payload (list '= p (list 'get (list 'get l :condition)\n+                                             :yang.call/value))})))\n+        results (run-provenance-observation observation)]\n+    (is (= #{:semantic :stack :register} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (println \"PHP-COUNT-LIMIT\" backend actual)\n+      (is (= {:retained true :local true :condition true :payload true} actual)\n+          (str backend \": a count wider than the composition's integer limit \"\n+               \"is foreign and retained whole (got \" (pr-str actual) \")\")))))\n+\n+\n+(deftest ^:slow php-nil-condition-reception-test\n+  ;; The steward addendum's F1 nil-guard choice, taken DELIBERATELY as\n+  ;; option (a): a non-map or nil condition delivered to reception is NOT\n+  ;; provenance-minted (nil provenance is refused by the reserved door —\n+  ;; an operational failure that would escape the boundary behavior); it\n+  ;; raises the documented plain local Error — no ForeignException, no\n+  ;; wrapper, nothing retained. The kit never builds such a condition;\n+  ;; this pins the boundary behavior for the instrument-level anomaly.\n+  (let [observation\n+        (kit/guard-exceptions-form\n+          [:php]\n+          (list 'let ['probe.injected (injected nil)\n+                      'probe.retained (boundary-call (kit/export-form :php \"retain\")\n+                                                     ['probe.injected])\n+                      'probe.wrapper (list 'get 'probe.retained :value)\n+                      'probe.local (list 'if\n+                                         (list '= :return\n+                                               (list 'get 'probe.retained :route))\n+                                         (boundary-call (kit/export-form :php \"is_foreign\")\n+                                                        ['probe.wrapper])\n+                                         {:value false})]\n+                (kit/observation-map-form\n+                  {:retained (list '= :return (list 'get 'probe.retained :route))\n+                   :plain-local-error (list '= false (list 'get 'probe.local :value))})))\n+        results (run-provenance-observation observation)]\n+    (is (= #{:semantic :stack :register} (set (keys results))))\n+    (doseq [[backend actual] results]\n+      (println \"PHP-NIL-CONDITION\" backend actual)\n+      (is (= {:retained true :plain-local-error true} actual)\n+          (str backend \": a nil condition raises the plain local Error, \"\n+               \"never a provenance mint (got \" (pr-str actual) \")\")))))\ndiff --git a/test/yang/clojure/donor_link_test.clj b/test/yang/clojure/donor_link_test.clj\nnew file mode 100644\nindex 00000000..22b06c13\n--- /dev/null\n+++ b/test/yang/clojure/donor_link_test.clj\n@@ -0,0 +1,48 @@\n+(ns yang.clojure.donor-link-test\n+  (:require [clojure.test :refer [deftest is]]\n+            [yang.clojure :as clj]\n+            [yang.clojure.prelude :as prelude]\n+            [yang.core.module :as module]\n+            [yang.core.prelude :as core]\n+            [yang.core.uast :as u]\n+            [yang.typescript.antlr.linked-harness :as h]\n+            [yin.vm :as vm]\n+            [yin.vm.linker.interpreter :as link]))\n+\n+\n+(deftest linked-donor-uses-runtime-context\n+  (let [{:keys [store call-address]} @h/published\n+        registry (prelude/admit (h/regis