{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' test/yang/typescript/antlr/e2e_test.clj && sed -n '1,220p' test/yang/typescript/antlr/corpus_test.cljc && sed -n '130,260p' test/yang/typescript/antlr/linked_harness.cljc && sed -n '1,140p' test/yang/typescript/antlr/class_prelude_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' test/yang/typescript/antlr/e2e_test.clj && sed -n '1,220p' test/yang/typescript/antlr/corpus_test.cljc && sed -n '130,260p' test/yang/typescript/antlr/linked_harness.cljc && sed -n '1,140p' test/yang/typescript/antlr/class_prelude_test.cljc\"","aggregated_output":"(ns yang.typescript.antlr.e2e-test\n  \"End to end on the JVM (T1 step S6), as a stream topology: source events ->\n   parser stage -> CST stream -> lowering stage -> program stream (source\n   envelopes) -> an evaluator on each of the four VMs (the AST walker\n   observes a program medium carrying the envelope's run member; the\n   semantic, stack and register VMs are built from the same member).\n\n   Every program runs three ways (`every-vm=`): naive on the four VMs,\n   safepointed under no-op hooks on the four VMs (transparency: the derived\n   program prints what the naive one prints), and linked on the three vector\n   VMs (`js` served from `yang.typescript.antlr.linked-harness`; the AST\n   walker's link is refused until L-b). The composition installs the real\n   `cell`, `data` and `integer` modules; nothing is stubbed. Printed output\n   is compared as JavaScript text rendered at the boundary\n   (`yang.typescript.antlr.render`).\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.test-slow :as slow]\n            [yang.safepoint :as safepoint]\n            [yang.typescript.antlr.cst :as cst]\n            [yang.typescript.antlr.linked-harness :as linked]\n            [yang.typescript.antlr.lower :as lower]\n            [yang.typescript.antlr.prelude-parity-test :as parity]\n            [yang.typescript.antlr.render :as render]\n            [yang.typescript.antlr.safepoint :as hooks]\n            [yin.vm :as vm]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.test-utils :as tu]))\n\n\n;; =============================================================================\n;; The topology\n;; =============================================================================\n\n(defn- source-events\n  [unit text]\n  [{:yang.source/event :yang.source/chunk,\n    :yang.source/unit unit,\n    :yang.source/ordinal 0,\n    :yang.source/text text}\n   {:yang.source/event :yang.source/seal,\n    :yang.source/unit unit,\n    :yang.source/chunk-count 1}])\n\n\n(defn- run-member\n  \"The run member of a source envelope: the map AST the lowering emitted.\"\n  [{:yin/keys [batch root]}]\n  (nth batch root))\n\n\n(defn lower-source\n  \"Source text through the parser and lowering stages: `{:program envelope}`\n   or `{:diagnostics [...]}`. `prelude` is `:bundled` or `:linked`.\"\n  [source prelude]\n  (let [program (tu/new-memory-log)\n        src (tu/new-memory-log)\n        cst-log (tu/new-memory-log)\n        diagnostics (tu/new-memory-log)]\n    (doseq [e (source-events [:e2e 0] source)] (stream/append! src e))\n    (cst/step-stage (cst/open-stage src cst-log))\n    (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                        {:medium lower/program-medium,\n                                         :prelude prelude}))\n    (let [problems (tu/drain diagnostics)]\n      (if (seq problems)\n        {:diagnostics problems}\n        {:program (first (tu/drain program))}))))\n\n\n(defn derive-program\n  \"The safepointed composition's stages after lowering: the envelope is\n   projected by the encoder onto a row stream, the `yang.safepoint` stage\n   rewrites it under `profile` onto a derived stream and writes its record\n   to a ledger stream. Returns the derived envelope.\"\n  [envelope profile]\n  (let [rows (tu/new-memory-log)\n        derived (tu/new-memory-log)\n        ledger (tu/new-memory-log)]\n    (encoder/load rows envelope)\n    (safepoint/step-stage\n      (safepoint/open-stage rows derived ledger profile :e2e/derived))\n    (first (tu/drain derived))))\n\n\n(defn- attempt\n  [f]\n  (try (render/output (f))\n       (catch Exception e [:thrown (ex-message e)])))\n\n\n(defn run-ts\n  \"Every VM's rendered output for `source`, as `{vm-key output}`; a throw\n   becomes `[:thrown message]`. Options: `:hooks`, a hook prelude: the\n   program is safepointed under `hooks/profile` and the VMs run the hook\n   prelude, then the derived program. `:prelude :linked` lowers the linked\n   program and runs it on the three vector VMs.\"\n  ([source] (run-ts source {}))\n  ([source {:keys [hooks prelude], :or {prelude :bundled}}]\n   (let [lowered (lower-source source prelude)]\n     (if (:diagnostics lowered)\n       lowered\n       (let [envelope (:program lowered)]\n         (if (= :linked prelude)\n           (let [ast (run-member envelope)]\n             (into {}\n                   (map (fn [k]\n                          [k (attempt #(vm/value (linked/run-linked k ast)))]))\n                   (keys linked/backends)))\n           (let [ast (if hooks\n                       (hooks/program\n                         hooks\n                         (vm/semantic-bytecode->ast\n                           (run-member (derive-program envelope\n                                                       hooks/profile))))\n                       (run-member envelope))]\n             (into {}\n                   (map (fn [[k run]]\n                          [k (attempt #(vm/value (run ast)))]))\n                   parity/vm-runners))))))))\n\n\n(defn prints\n  \"The rendered value of a run that printed `lines` and raised nothing.\"\n  [& lines]\n  {:js/out (vec lines), :js/uncaught nil})\n\n\n(defn uncaught\n  \"The rendered value of a run that printed `lines`, then died on `text`.\"\n  [text & lines]\n  {:js/out (vec lines), :js/uncaught text})\n\n\n(defn every-vm=\n  \"`expected` from `source` on every VM: naive, safepointed under no-op\n   hooks, and linked. The linked leg runs the three vector VMs: the walker's\n   link of `js` is refused until L-b.\"\n  [expected source]\n  (doseq [[label opts vms] [[\"naive\" {}\n                             [:ast-walker :semantic :stack :register]]\n                            [\"no-op hooks\" {:hooks hooks/noop-uast}\n                             [:ast-walker :semantic :stack :register]]\n                            [\"linked\" {:prelude :linked}\n                             [:semantic :stack :register]]]]\n    (let [results (run-ts source opts)]\n      (is (not (contains? results :diagnostics)) (pr-str results))\n      (doseq [k vms]\n        (is (= expected (get results k)) (str label \" \" k \" \" (pr-str source)))))))\n\n\n;; =============================================================================\n;; Programs\n;; =============================================================================\n\n(defn- program-test\n  \"A slow test running `cases`, `[[expected source] ...]`, through\n   `every-vm=` under the slow guard named `nm`.\"\n  [nm cases]\n  (slow/guard nm\n              (fn []\n                (doseq [[expected source] cases]\n                  (testing source (every-vm= expected source))))))\n\n\n(deftest ^:slow console-and-literals-test\n  (program-test\n    \"console-and-literals\"\n    [[(prints \"1\") \"console.log(1);\"]\n     [(prints \"0.30000000000000004\") \"console.log(0.1 + 0.2);\"]\n     [(prints \"a b 3 true null undefined\")\n      \"console.log('a', \\\"b\\\", 3, true, null, undefined);\"]\n     [(prints \"5 3\") \"console.log(2 + 3, 7 - 4);\"]\n     [(prints \"-0 0\") \"console.log(-0, String(-0));\"]\n     [(prints \"9007199254740992\") \"console.log(2 ** 53 + 1);\"]\n     [(prints \"x7y\") \"const n = 7; console.log(`x${n}y`);\"]]))\n\n\n(deftest ^:slow operators-and-coercion-test\n  (program-test\n(ns yang.typescript.antlr.corpus-test\n  \"T1 step S7: the committed corpus against the Node oracle, on every host.\n   `t1_packets.edn` holds the JVM parser's CST packet for each corpus entry\n   (there is no TypeScript parser off the JVM), `t1_oracle.edn` what Node\n   prints for the source (an uncaught throw as one `Uncaught <name>:\n   <message>` line, in order). Each host lowers the pinned packet itself,\n   runs it bundled on the four VMs and linked on the three vector VMs, and\n   compares the rendered output line for line with Node's. A disagreement is\n   a frontend defect, not a fixture to edit.\n\n   On the JVM the same test also parses every corpus source and asserts the\n   packet equals the pinned one, so the pins cannot rot. Both fixtures are\n   written by `clojure -M:dev -m yang-ts-oracle` on the JVM with the mise\n   Node recorded in their header, and never regenerated on another host or\n   another Node.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [dao.test-slow :as slow]\n    [yang.typescript.antlr.linked-harness :as linked]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]\n    #?@(:cljd [[\"dart:io\" :as dart-io]]\n        :clj [[yang.typescript.antlr.cst :as cst]])))\n\n\n(def ^:private pinned-node\n  \"The Node the oracle was generated under (owner decision A12.2 open: the\n   mise Node, not an LTS). Moving it is a regeneration plus a diff review.\"\n  \"v25.6.1\")\n\n\n(defn- read-text\n  [path]\n  #?(:cljd (.readAsStringSync (dart-io/File. path))\n     :clj (slurp path)\n     :cljs (.readFileSync (js/require \"fs\") path \"utf8\")))\n\n\n(defn- read-fixture\n  [nm]\n  (edn/read-string (read-text (str \"test/resources/yang/typescript/\" nm))))\n\n\n(def ^:private corpus-names\n  \"The committed corpora, each `<name>_corpus.edn`, `<name>_oracle.edn` and\n   `<name>_packets.edn`.\"\n  [\"t1\" \"t2\" \"t3\"])\n\n\n(def ^:private enabled-steps\n  \"The steps whose corpus entries run (R14): an entry with a `:step` outside\n   this set is pending its step; an entry without one always runs.\"\n  #{:S6 :S5b :S6b :S8 :G-new :G-is :t3/lower})\n\n\n(def ^:private fixtures*\n  (delay (into {}\n               (map (fn [nm]\n                      [nm {:corpus (read-fixture (str nm \"_corpus.edn\")),\n                           :oracle (read-fixture (str nm \"_oracle.edn\")),\n                           :packets (read-fixture (str nm \"_packets.edn\"))}]))\n               corpus-names)))\n\n\n(defn- enabled?\n  [{:keys [step]}]\n  (or (nil? step) (contains? enabled-steps step)))\n\n\n(defn- by-id\n  [fixture]\n  (into {} (map (juxt :id identity)) (:entries fixture)))\n\n\n(defn- actual-lines\n  \"Node's view of a rendered run: the logged lines, then the uncaught line.\"\n  [{:js/keys [out uncaught]}]\n  (cond-> (vec (mapcat #(str/split % #\"\\n\" -1) out))\n    uncaught (conj (str \"Uncaught \" uncaught))))\n\n\n(defn- attempt\n  [f]\n  (try (actual-lines (render/output (f)))\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         [:thrown (ex-message e)])))\n\n\n(deftest fixtures-agree-test\n  (doseq [nm corpus-names\n          :let [{:keys [corpus oracle packets]} (get @fixtures* nm)]]\n    (testing nm\n      (testing \"the corpus is 80 to 130 entries with unique ids\"\n        (is (<= 80 (count corpus) 130))\n        (is (= (count corpus) (count (set (map :id corpus))))))\n      (testing \"the oracle and the packets cover exactly the corpus\"\n        (is (= (map :id corpus) (map :id (:entries oracle))))\n        (is (= (map :id corpus) (map :id (:entries packets)))))\n      (testing \"the oracle header names the pinned Node, and every run exited 0\"\n        (is (= pinned-node (get-in oracle [:header :node])))\n        (is (= pinned-node (get-in packets [:header :node])))\n        (is (every? #(zero? (:exit %)) (:entries oracle))))\n      (testing \"a departure entry names its reason and a pinned output\"\n        (is (every? (fn [e]\n                      (or (nil? (:departure e))\n                          (and (vector? (get-in e [:departure :out]))\n                               (string? (get-in e [:departure :reason])))))\n                    corpus))))))\n\n\n(defn- run-bundled\n  [ast]\n  (into {}\n        (map (fn [[k run]] [k (attempt #(vm/value (run ast)))]))\n        parity/vm-runners))\n\n\n(defn- run-linked\n  [ast]\n  (into {}\n        (map (fn [k]\n               [k (attempt #(vm/value (linked/run-linked k ast)))]))\n        (keys linked/backends)))\n\n\n(defn- expected-lines\n  \"Node's lines, or the pinned deviation of a departure entry.\"\n  [entry oracle-entry]\n  (or (get-in entry [:departure :out]) (:out oracle-entry)))\n\n\n(defn- progress!\n  \"One flushed line per entry, so a long leg shows how far it got.\"\n  [label nm id]\n  (println label nm id)\n  #?(:clj (do (flush)\n              (spit \"target/corpus-progress.log\"\n                    (str label \" \" nm \" \" id \"\\n\")\n                    :append true))))\n\n\n(defn- disagreements\n  \"Every `[corpus id profile vm expected actual]` where a VM's output differs\n   from Node's (or from a departure's pinned output), over the enabled\n   entries of the corpora `names`.\"\n  [names profile lower-opts run]\n  (vec (for [nm names\n             :let [{:keys [corpus oracle packets]} (get @fixtures* nm)\n                   oracle (by-id oracle)\n                   packets (by-id packets)]\n             {:keys [id] :as entry} corpus\n             :when (enabled? entry)\n             :let [_ (progress! \"run\" nm id)\n                   expected (expected-lines entry (get oracle id))\n                   ast (try (lower/lower-packet (:packet (get packets id))\n                                                lower-opts)\n                            (catch #?(:cljd Object :clj Exception :cljs :default) e\n                              e))]\n             [k actual] (if (map? ast)\n                          (run ast)\n                          {:lowering [:thrown (ex-message ast)]})\n             :when (not= expected actual)\n             :let [_ (progress! \"MISMATCH\" nm id)]]\n         [nm id profile k expected actual])))\n\n\n(defn- leg\n  [names profile lower-opts run]\n  (is (= [] (disagreements names profile lower-opts run))))\n\n\n;; One leg per corpus and profile: each runs the enabled entries on every\n;; VM of the profile and is slow on its own (t2 is about 120 entries).\n(deftest ^:slow t2-bundled-matches-node-test\n  (slow/guard \"t2-bundled-matches-node-test\"\n              #(leg [\"t2\"] :bundled {} run-bundled)))\n\n\n(deftest ^:slow t2-linked-matches-node-test\n  (slow/guard \"t2-linked-matches-node-test\"\n              #(leg [\"t2\"] :linked {:prelude :linked} run-linked)))\n\n\n(deftest ^:slow t3-bundled-matches-node-test\n  (slow/guard \"t3-bundled-matches-node-test\"\n              #(leg [\"t3\"] :bundled {} run-bundled)))\n\n\n(deftest ^:slow t3-linked-matches-node-test\n  (slow/guard \"t3-linked-matches-node-test\"\n              #(leg [\"t3\"] :linked {:prelude :linked} run-linked)))\n\n\n(deftest ^:slow t1-bundled-matches-node-test\n  (slow/guard \"t1-bundled-matches-node-test\"\n              #(leg [\"t1\"] :bundled {} run-bundled)))\n\n\n(deftest ^:slow t1-linked-matches-node-test\n  (slow/guard \"t1-linked-matches-node-test\"\n              #(leg [\"t1\"] :linked {:prelude :linked} run-linked)))\n\n\n(deftest t3-packets-parse-test\n  (let [{:keys [corpus packets]} (get @fixtures* \"t3\")\n        entries (:entries packets)]\n    (testing \"the packets cover the corpus, and none is empty\"\n      (is (pos? (count entries)))\n      (is (= (count corpus) (count entries))))\n    (testing \"every T3 corpus source parsed to an ok packet\"\n      (is (= []\n             (mapv :id\n                   (remove #(= :yang.cst/ok (:yang.cst/outcome (:packet %)))\n                           entries)))))))\n\n\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n                 (assoc attached\n                        :pc pc :frames [] :continuation []\n                        :registers (vec (repeat (:registers body) nil))\n                        :halted? false :blocked? false :value nil)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task\n   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`. Options:\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `js`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `jssp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\n(ns yang.typescript.antlr.class-prelude-test\n  \"T3 step S2: constructor kinds and `new.target` dispatch in the `js`\n   prelude. `make-function-nt`'s `nt?` flag, `call` refusing class kinds,\n   `construct-with-nt` allocating from `new.target.prototype`, derived\n   constructors, bound functions and `is-constructor?`. Tiny UAST programs\n   run on every VM through the parity harness.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [clojure.walk :as walk]\n    [dao.jing.cbor :as cbor]\n    [dao.test-slow :as slow]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]))\n\n\n(defn- result-vector?\n  [x]\n  (and (vector? x) (seq x) (not (symbol? (first x))) (some seq? x)))\n\n\n(defn- unqualify\n  [form]\n  (walk/postwalk\n    (fn [x]\n      (cond (and (symbol? x)\n                 (contains? #{\"clojure.core\" \"cljs.core\" \"cljd.core\"}\n                            (namespace x)))\n            (symbol (name x))\n            (result-vector? x) (reduce (fn [acc a] (list 'js/vconj acc a)) [] x)\n            :else x))\n    form))\n\n\n(def ^:private nt-recorder\n  \"A constructor body that records its new.target on `this`.\"\n  '(fn [this args nt]\n     (do (js/define-own! this {:js/str \"nt\"} (js/slot nt true true true))\n         :js/undefined)))\n\n\n(defn- check\n  \"Run `cases` ([form expected]) as one vector program on every VM.\"\n  [cases]\n  (let [form (parity/program-form\n               (reduce (fn [acc [f _]]\n                         (list 'js/vconj\n                               acc\n                               (unqualify (walk/postwalk-replace\n                                            {'NT-REC nt-recorder}\n                                            f))))\n                       []\n                       cases))\n        expected (mapv (fn [[_ e]] (parity/expected-value e)) cases)]\n    (doseq [[k result] (parity/run-with-prelude prelude/uast form)]\n      (testing (str k)\n        (is (= (count expected) (count result)) (pr-str result))\n        (when (and (vector? result) (= (count expected) (count result)))\n          (doseq [[[f _] exp act] (map vector cases expected result)]\n            (is (cbor/content= exp act)\n                (str (pr-str f) \" => \" (pr-str act) \", expected \"\n                     (pr-str exp)))))))))\n\n\n(defn- k\n  [x]\n  {:js/str x})\n\n\n(defn- throws\n  [expr]\n  (list 'js/try (list 'fn [] expr) '(fn [e] (js/get-prop e {:js/str \"name\"}))))\n\n\n(def ^:private kind-cases\n  [;; class kinds refuse an ordinary call; construct reaches the code\n   [(throws '(js/call (js/make-function-nt {:js/str \"A\"} 0 :strict :class\n                                           (fn [this args nt] this)\n                                           true)\n                      :js/undefined\n                      []))\n    (k \"TypeError\")]\n   [(throws '(js/call (js/make-function-nt {:js/str \"B\"} 0 :strict :derived\n                                           (fn [this args nt] this)\n                                           true)\n                      :js/undefined\n                      []))\n    (k \"TypeError\")]\n   ;; constructibility by :kind\n   ['(let [mk (fn [kind]\n                (js/is-constructor?\n                  (js/make-function-nt {:js/str \"f\"} 0 :strict kind\n                                       (fn [this args] this)\n                                       false)))]\n       [(mk :normal) (mk :class) (mk :derived) (mk :method) (mk :arrow)\n        (mk :getter) (mk :accessor) (mk :builtin)])\n    [true true true false false false false false]]\n   ;; the five-argument make-function is the nt?-false shape\n   ['(js/call (js/make-function {:js/str \"f\"} 1 :strict :normal\n                                (fn [this args] (js/arg args 0)))\n              :js/undefined\n              (js/vconj [] {:n 5}))\n    {:n 5}]])\n\n\n(def ^:private new-target-cases\n  [;; a plain call passes undefined as new.target\n   ['(js/call (js/make-function-nt {:js/str \"f\"} 0 :strict :normal\n                                   (fn [this args nt] nt)\n                                   true)\n              :js/undefined\n              [])\n    :js/undefined]\n   ;; construct passes the constructor itself\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  (fn [this args nt] nt)\n                                  true)]\n       (= (js/construct f []) f))\n    true]\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  NT-REC\n                                  true)\n           o (js/construct f [])]\n       (= (js/get-prop o {:js/str \"nt\"}) f))\n    true]\n   ;; construct-with-nt allocates from nt.prototype\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  NT-REC\n                                  true)\n           g (js/make-function-nt {:js/str \"G\"} 0 :strict :class\n                                  (fn [this args nt] this)\n                                  true)\n           proto (js/make-object :js/null)]\n       (do (js/define-own! g {:js/str \"prototype\"} (js/slot proto false false false))\n           (let [o (js/construct-with-nt f [] g)]\n             [(= (get (cell/get o) :proto) proto)\n              (= (js/get-prop o {:js/str \"nt\"}) g)])))\n    [true true]]\n   ;; a non-object nt.prototype falls back to Object.prototype\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  (fn [this args nt] this)\n","exit_code":0,"status":"completed"}}
