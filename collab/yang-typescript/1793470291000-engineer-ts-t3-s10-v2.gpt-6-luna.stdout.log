test.cljc:601:       [(js/instanceof e (js/global-get {:js/str \"TypeError\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:602:        (js/instanceof e (js/global-get {:js/str \"Error\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:606:   ['(nil? (js/get-own (js/construct (js/global-get {:js/str \"Error\"}) []) {:js/str \"message\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:612:           (let [e (js/construct (js/global-get {:js/str \"Error\"})\ntest/yang/typescript/antlr/class_prelude_test.cljc:617:   ;; the new classes exist and chain to Error\ntest/yang/typescript/antlr/class_prelude_test.cljc:618:   ['(let [e (js/construct (js/global-get {:js/str \"URIError\"}) [])\ntest/yang/typescript/antlr/class_prelude_test.cljc:619:           v (js/construct (js/global-get {:js/str \"EvalError\"}) [])]\ntest/yang/typescript/antlr/class_prelude_test.cljc:620:       [(js/instanceof e (js/global-get {:js/str \"Error\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:621:        (js/instanceof v (js/global-get {:js/str \"Error\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:622:        (js/instanceof e (js/global-get {:js/str \"EvalError\"}))])\ntest/yang/typescript/antlr/class_prelude_test.cljc:625:   [(with-d (global \"Error\")\ntest/yang/typescript/antlr/class_prelude_test.cljc:627:         [(js/instanceof e d) (js/instanceof e (js/global-get {:js/str \"Error\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:628:          (js/instanceof e (js/global-get {:js/str \"TypeError\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:632:    [true true false (k \"sub\") true (k \"[object Error]\")]]\ntest/yang/typescript/antlr/class_prelude_test.cljc:633:   [(with-d (global \"RangeError\")\ntest/yang/typescript/antlr/class_prelude_test.cljc:635:         [(js/instanceof e (js/global-get {:js/str \"RangeError\"}))\ntest/yang/typescript/antlr/class_prelude_test.cljc:636:          (js/instanceof e (js/global-get {:js/str \"Error\"}))]))\ntest/yang/typescript/antlr/class_prelude_test.cljc:639:   ['(js/has-property (js/construct (js/global-get {:js/str \"Error\"}) []) {:js/str \"stack\"})\ntest/yang/typescript/antlr/prelude_test.cljc:349:    (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:353:    (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:354:   [(throws '(js/to-property-descriptor 1)) (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:436:   ;; a non-writable inherited slot blocks the write: false, then TypeError\ntest/yang/typescript/antlr/prelude_test.cljc:445:    (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:459:    [false (k \"TypeError\")]]\ntest/yang/typescript/antlr/prelude_test.cljc:468:    (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:469:   [(throws '(js/put-value :js/null {:js/str \"a\"} 1)) (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:471:   [(throws '(js/put-value {:js/str \"s\"} {:js/str \"a\"} 1)) (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:487:    [false true true true false (k \"TypeError\") true]]\ntest/yang/typescript/antlr/prelude_test.cljc:488:   [(throws '(js/delete-value :js/undefined {:js/str \"a\"})) (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:489:   [(throws '(js/in-op {:js/str \"a\"} {:js/str \"str\"})) (k \"TypeError\")]])\ntest/yang/typescript/antlr/prelude_test.cljc:517:   ;; a sparse gap past 2^20 is a RangeError and nothing changes\ntest/yang/typescript/antlr/prelude_test.cljc:520:    [(k \"RangeError\") {:n 3}]]\ntest/yang/typescript/antlr/prelude_test.cljc:532:   [(throws `(js/put-value ~arr ~(k \"length\") (js/mknum -1))) (k \"RangeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:533:   [(throws `(js/put-value ~arr ~(k \"length\") (js/mknum 1.5))) (k \"RangeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:588:    (k \"TypeError\")]\ntest/yang/typescript/antlr/prelude_test.cljc:599:     (k \"TypeError\")]]\ntest/yang/typescript/antlr/prelude_test.cljc:601:    (k \"TypeError\")]\n","exit_code":0,"status":"completed"}}
