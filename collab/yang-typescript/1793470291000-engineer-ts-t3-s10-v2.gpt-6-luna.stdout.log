\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                            sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                        (System/exit\n                          (:exit (apply shell {:continue true}\n                                        \"bb\" \"src/dev/affected.clj\"\n                                        \"--lane\" \"clj\"\n                                        (concat sub-args flags)))))}\n\n  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\n                 :depends [check:node-discovery]\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljs\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljd\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:list {:doc \"What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>...\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--list\"\n(ns yang.typescript.antlr.class-units-test\n  \"Cross-unit Error identity using separately parsed and lowered packets.\n   The committed Node fixture is the oracle; the implementation composes\n   packet bodies with one runtime initialization on bundled and linked VMs.\"\n  (:require [clojure.edn :as edn]\n            [clojure.test :refer [deftest is testing]]\n            [dao.test-slow :as slow]\n            [yang.typescript.antlr.linked-harness :as linked]\n            [yang.typescript.antlr.lower :as lower]\n            [yang.typescript.antlr.prelude-parity-test :as parity]\n            [yang.typescript.antlr.render :as render]\n            [yin.vm :as vm]\n            #?@(:cljd [[dart:io :as dart-io]]\n            )))\n\n\n(defn- fixture-text\n  []\n  #?(:clj (slurp \"test/resources/yang/typescript/t3_units.edn\")\n     :cljs (.readFileSync (js/require \"fs\")\n                          \"test/resources/yang/typescript/t3_units.edn\"\n                          \"utf8\")\n     :cljd (.readAsStringSync\n             (dart-io/File.\n               \"test/resources/yang/typescript/t3_units.edn\"))))\n\n\n(defn- output\n  [f]\n  (render/output (f)))\n\n\n(defn- bundled-runs\n  [packets]\n  (let [ast (lower/lower-units packets)]\n    (into {}\n          (map (fn [[k run]]\n                 [k (output #(vm/value (run ast)))])\n               parity/vm-runners))))\n\n\n(defn- linked-runs\n  [packets]\n  (let [ast (lower/lower-units packets {:prelude :linked})]\n    (into {}\n          (map (fn [k]\n                 [k (output #(vm/value (linked/run-linked k ast)))])\n               (keys linked/backends))))\n\n\n(defn- run-fixtures\n  []\n  (let [{:keys [entries]} (edn/read-string (fixture-text))]\n    (doseq [{:keys [id out packets]} entries]\n      (testing (name id)\n        (doseq [[backend actual] (bundled-runs packets)]\n          (is (= {:js/out out :js/uncaught nil} actual)\n              (str \"bundled \" backend)))\n        (doseq [[backend actual] (linked-runs packets)]\n          (is (= {:js/out out :js/uncaught nil} actual)\n              (str \"linked \" backend)))))))\n\n\n(deftest ^:slow separately-lowered-units-share-runtime-and-global-test\n  (slow/guard \"separately-lowered-units-share-runtime-and-global\"\n              run-fixtures))\ndiff --git a/src/cljc/yang/typescript/antlr/lower.cljc b/src/cljc/yang/typescript/antlr/lower.cljc\nindex c4d98b00..9e5c8fa3 100644\n--- a/src/cljc/yang/typescript/antlr/lower.cljc\n+++ b/src/cljc/yang/typescript/antlr/lower.cljc\n@@ -2266,6 +2266,38 @@\n   (module-body (context packet)))\n \n \n+(defn lower-unit\n+  \"One separately scoped module body as a function of its shared global\n+   receiver. Keeping this seam lets a host compose independently parsed\n+   units without concatenating source or reinitializing the runtime.\"\n+  [packet]\n+  (let [ctx (context packet)]\n+    (u/lam [(:this ctx)] (module-body ctx))))\n+\n+\n+(defn lower-units\n+  \"A complete program for multiple separately parsed units. The runtime is\n+   installed and initialized once; each unit receives its own lexical body\n+   while sharing the same global object and output stream.\"\n+  ([packets] (lower-units packets {}))\n+  ([packets {:keys [prelude], :or {prelude :bundled}}]\n+   (let [units (mapv lower-unit packets)\n+         main (names/canonicalize\n+                (app* 'js/run-main\n+                      (u/lam ['this]\n+                        (u/seq-nodes\n+                          (mapv (fn [unit] (u/app unit (u/v 'this))) units)))))]\n+     (u/mark-tails\n+       (case prelude\n+         :bundled (u/then prelude/uast main)\n+         :linked (u/seq-nodes [(u/sexp->uast (list 'require\n+                                                   (list 'quote 'yang.call)))\n+                               (u/sexp->uast (list 'require\n+                                                   (list 'quote prelude/module-name)))\n+                               (app* 'js/init!)\n+                               main])))))\n+\n+\n (defn lower-packet\n   \"The complete program for one ok packet: the module body run by\n    `js/run-main`, generated names canonicalized, tail calls marked. Its\n@@ -2277,9 +2309,7 @@\n    the task's runtime state with `(js/init!)`.\"\n   ([packet] (lower-packet packet {}))\n   ([packet {:keys [prelude], :or {prelude :bundled}}]\n-   (let [ctx (context packet)\n-         main (names/canonicalize\n-                (app* 'js/run-main (u/lam [(:this ctx)] (module-body ctx))))]\n+   (let [main (names/canonicalize (app* 'js/run-main (lower-unit packet)))]\n      (u/mark-tails\n        (case prelude\n          :bundled (u/then prelude/uast main)\n","exit_code":0,"status":"completed"}}
