{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2240,2345p' src/cljc/yang/typescript/antlr/lower.cljc && sed -n '235,275p' test/yang/typescript/antlr/corpus_test.cljc && sed -n '250,360p' test/yang/typescript/antlr/lower_portable_test.cljc && rg -n \\\"yang-ts|typescript.*test|sub:cljs|sub:cljd|test:clj|kondo\\\" bb.edn\"","aggregated_output":"     :pending-labels nil,\n     :gen nil,\n     :async nil,\n     :class nil,\n     :this-cell nil,\n     :nt :undefined,\n     :home nil,\n     :class-cell nil,\n     :privates {}}))\n\n\n(defn- module-body\n  [ctx]\n  (let [root (p/root (:pk ctx))\n        s (scope-of ctx root)\n        stmts (statements-of ctx root)]\n    (bind-cells (let [{:keys [vars tdz-names]} (binding-names s)]\n                  (vec (concat (map (fn [nm] [nm undefined]) vars)\n                               (map (fn [nm] [nm tdz]) tdz-names))))\n                (seq-of (lower-stmts ctx stmts)))))\n\n\n(defn lower-module-body\n  \"The module's statements as one node, before the runtime wrapper: what\n   lowering goldens compare.\"\n  [packet]\n  (module-body (context packet)))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet: the module body run by\n   `js/run-main`, generated names canonicalized, tail calls marked. Its\n   value is `{:js/out [...] :js/uncaught nil-or-snapshot}`.\n\n   `:prelude` selects how the runtime profile arrives: `:bundled` (the\n   default) carries the prelude tree ahead of the body; `:linked` requires\n   the modules `yang.call` and `js` from the task's link pair, then allocates\n   the task's runtime state with `(js/init!)`.\"\n  ([packet] (lower-packet packet {}))\n  ([packet {:keys [prelude], :or {prelude :bundled}}]\n   (let [ctx (context packet)\n         main (names/canonicalize\n                (app* 'js/run-main (u/lam [(:this ctx)] (module-body ctx))))]\n     (u/mark-tails\n       (case prelude\n         :bundled (u/then prelude/uast main)\n         :linked (u/seq-nodes [(u/sexp->uast (list 'require\n                                                   (list 'quote\n                                                         'yang.call)))\n                               (u/sexp->uast (list 'require\n                                                   (list 'quote\n                                                         prelude/module-name)))\n                               (app* 'js/init!)\n                               main]))))))\n\n\n(def program-medium\n  \"The program medium's logical identity when the composition names none.\"\n  :yang.ts/program)\n\n\n(def ^:private stage-config\n  {:diagnostic-ns diagnostic-ns,\n   :program-medium program-medium,\n   :ok? #(= :yang.cst/ok (:yang.cst/outcome %)),\n   :lower (fn [state packet]\n            (lower-packet packet {:prelude (get state :prelude :bundled)})),\n   :option-keys [:prelude :dialect]})\n\n\n(defn lower-transform\n  \"The lowering stage's transform (`yang.core.stage/lower-transform`).\"\n  [state packet]\n  (core-stage/lower-transform stage-config state packet))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. The fourth argument may instead be\n   an options map `{:medium :prelude :dialect}`.\"\n  ([cst-stream program-stream diagnostics-stream]\n   (core-stage/open-stage stage-config\n                          cst-stream\n                          program-stream\n                          diagnostics-stream))\n  ([cst-stream program-stream diagnostics-stream medium-or-opts]\n   (core-stage/open-stage stage-config\n                          cst-stream\n                          program-stream\n                          diagnostics-stream\n                          medium-or-opts)))\n\n\n(defn step-stage\n  [s]\n  (core-stage/step-stage stage-config s))\n    (testing \"the corpora are loaded\"\n      (is (pos? (count entries)))\n      (is (= (reduce + (map (comp count :corpus val) @fixtures*))\n             (count entries))))\n    (testing \"every entry is enabled, or on an explicitly allowed pending step\"\n      (is (= []\n             (mapv (fn [[nm id step _]] [nm id step])\n                   (remove (fn [[_ _ step on?]]\n                             (or on? (contains? pending-steps step)))\n                           entries)))))\n    (testing \"T3 enables all its entries\"\n      (let [t3 (filter (fn [[nm _ _ _]] (= \"t3\" nm)) entries)]\n        (is (pos? (count t3)))\n        (is (every? (fn [[_ _ _ on?]] on?) t3))))))\n\n\n(deftest t3-units-fixture-test\n  (let [units (read-fixture \"t3_units.edn\")]\n    (testing \"the cross-unit programs are recorded under the pinned Node\"\n      (is (= pinned-node (get-in units [:header :node])))\n      (is (= [:units-error-identity :units-sibling-class]\n             (mapv :id (:entries units))))\n      (is (every? #(zero? (:exit %)) (:entries units)))\n      (is (= [[\"true true false MyErr x\"] [\"false true true\"]]\n             (mapv :out (:entries units)))))\n    (testing \"every unit parsed to an ok packet\"\n      (is (every? #(= :yang.cst/ok (:yang.cst/outcome %))\n                  (mapcat :packets (:entries units)))))\n    (testing \"each program has two separately parsed units\"\n      (is (every? #(= 2 (count (:packets %))) (:entries units))))))\n\n\n#?(:cljd nil\n   :clj\n   (deftest packets-are-current-test\n     (let [worker (cst/make-worker :ts)]\n       (is (= []\n              (vec (for [nm corpus-names\n                         :let [{:keys [corpus packets]} (get @fixtures* nm)\n                               packets (by-id packets)]\n                         {:keys [id source]} corpus\n  (doseq [pk [while-loop function-f var-x]]\n    (let [p (lower/lower-packet pk)]\n      (is (= p (names/canonicalize p)) \"idempotent on a lowered program\")\n      (is (every? (fn [s]\n                    (or (= '%_ s) (re-matches #\"%\\d+\" (name s))))\n                  (filter #(and (symbol? %) (= \\% (first (name %))))\n                          (nodes p)))\n          \"every generated name is canonical\")))\n  (testing \"the names are numbered by first occurrence\"\n    (let [p (lower/lower-packet while-loop)]\n      (is (some #{'%0} (nodes p)))))\n  (testing \"the same packet lowers to the same program\"\n    (is (= (lower/lower-packet while-loop) (lower/lower-packet while-loop)))))\n\n\n(deftest site-marks-survive-test\n  (let [marks (fn [pk]\n                (keep #(:yang/site (meta %)) (nodes (lower/lower-packet pk))))]\n    (is (= [:loop] (vec (marks while-loop))))\n    (is (= [[:call \"f\" 0]] (vec (marks function-f))))))\n\n\n(deftest class-fixtures-test\n  (testing \"the two class programs lower; the renaming law and site marks hold\"\n    (let [p (lower/lower-packet classes)\n          marks (set (keep #(:yang/site (meta %)) (nodes p)))]\n      (is (= p (names/canonicalize p)) \"idempotent on a lowered program\")\n      (is (every? (fn [s]\n                    (or (= '%_ s) (re-matches #\"%\\d+\" (name s))))\n                  (filter #(and (symbol? %) (= \\% (first (name %))))\n                          (nodes p)))\n          \"every generated name is canonical\")\n      (is (contains? marks [:call \"m\" 0]) \"the method is a call site\")\n      (is (contains? marks [:call \"B\" 0]) \"the constructor is a call site\")\n      (is (contains? marks [:call \"A\" 0]) \"so is the default constructor\")\n      (is (some #(and (map? %) (= (u/v 'js/super-call) (:operator %)))\n                (nodes p)))\n      (is (some #(and (map? %) (= (u/v 'js/make-class) (:operator %)))\n                (nodes p)))))\n  (testing \"the same packet lowers to the same program\"\n    (is (= (lower/lower-packet classes) (lower/lower-packet classes)))))\n\n\n(deftest linked-and-bundled-profiles-test\n  (let [bundled (lower/lower-packet var-x)\n        linked (lower/lower-packet var-x {:prelude :linked})]\n    (is (not= bundled linked))\n    (is (< (count (pr-str linked)) (count (pr-str bundled)))\n        \"the linked program carries no prelude tree\")\n    (is (some #(= (u/lit 'js) %) (nodes linked)) \"it requires the module js\")\n    (is (some #(and (map? %) (= (u/v 'js/init!) (:operator %))) (nodes linked))\n        \"and allocates the task's state\")\n    (is (some #(and (map? %) (= (u/v 'js/run-main) (:operator %)))\n              (nodes bundled)))))\n\n\n(deftest bundled-program-depth-test\n  ;; A linear prelude sequence reached 976 levels with 481 definitions:\n  ;; `pr-str` could overflow even though the tree contained no cycle.\n  ;; Leave room for the runtime bodies, but catch that sequencing growth\n  ;; independently of the JVM printer's stack size and JIT warmup.\n  (is (< (tree-depth (lower/lower-packet var-x)) 512)))\n\n\n(deftest transform-routes-programs-and-diagnostics-test\n  (let [[_ [[port envelope]]] (lower/lower-transform {} var-x)]\n    (is (= :program port))\n    (is (= {:yin/source-medium lower/program-medium,\n            :yin/batch-token [:hand 0],\n            :yin/batch [(lower/lower-packet var-x)],\n            :yin/root 0}\n           envelope)\n        \"a source envelope whose one member is the map AST\"))\n  (let [[_ out] (lower/lower-transform\n                  {}\n                  {:yang.cst/unit [:hand 1],\n                   :yang.cst/outcome :yang.cst/syntax-error,\n                   :yang.cst/errors [{:kind :syntax-error, :message \"m\"}]})]\n    (is (= [[:diagnostics {:yang.cst/unit [:hand 1],\n                           :yang.ts/diagnostic :yang.ts/syntax-error,\n                           :errors [{:kind :syntax-error, :message \"m\"}]}]]\n           out)))\n  (let [[_ [[port d]]] (lower/lower-transform\n                         {}\n                         (program [:namespaceDeclaration]))]\n    (is (= :diagnostics port))\n    (is (= :yang.ts/unsupported (:yang.ts/diagnostic d)))\n    (is (= \"namespace\" (:construct d))))\n  (let [[_ [[port d]]] (lower/lower-transform\n                         {}\n                         (program [:breakStatement [\"Break\" \"break\"]]))]\n    (is (= :diagnostics port))\n    (is (= :yang.ts/early-error (:yang.ts/diagnostic d)))))\n233:   ;; The Node lanes (test:cljs and its variants) depend on this task, so the\n251:   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n252:   ;; `bb test:cljs` without it skips those tests with a printed notice\n267:  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n275:  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n279:  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n327:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n402:  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\n413:  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n","exit_code":0,"status":"completed"}}
