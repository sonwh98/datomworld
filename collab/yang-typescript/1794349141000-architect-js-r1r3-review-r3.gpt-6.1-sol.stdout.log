\\\t                 (= :yang.call/not-callable (:yang.call/reason payload)))\\\\n  2129\\\\t            (str lane \\\\\\\" genuine dead: \\\\\\\" (pr-str result))))))\\\\n  2130\\\\t  (testing \\\\\\\"the residual, pinned: a forged id inside the heap language fails closed in the VM\\\\\\\"\\\\n  2131\\\\t    ;; A map whose :id is a :cell-N keyword and whose seal has the issued\\\\n  2132\\\\t    ;; format but not the issued content: it is a dereference candidate the\\\\n  2133\\\\t    ;; VM's heap+seal check rejects — a host-level refusal, the same fate\\\\n  2134\\\\t    ;; any forged reference meets anywhere in the system. No in-language\\\\n  2135\\\\t    ;; authenticity probe exists (check-ref! throws past every guest catch),\\\\n  2136\\\\t    ;; so this class stays fail-closed until yin.vm publishes one.\\\\n  2137\\\\t    (doseq [lane [:walker :semantic]]\\\\n  2138\\\\t      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\\\\n  2139\\\\t             (run-cell-probe (u/lit {:type :cell-ref :id :cell-7\\\\n  2140\\\\t                                     :seal \\\\\\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\\\\\"})\\\\n  2141\\\\t                             lane))\\\\n  2142\\\\t          (str lane \\\\\\\" forged in-language id\\\\\\\")))))\\\\n  2143\\\\t\\\\n  2144\\\\t\\\\n  2145\\\\t(deftest test-library-closes-over-its-own-names\\\\n  2565\\\\t                      (sum-calls (- n 1) (inc1 acc))))\\\\n  2566\\\\t                  (sum-calls 500 0)]\\\\n  2567\\\\t          ast (yang/compile-program forms true outcome-opts)]\\\\n  2568\\\\t      (doseq [lane [:walker :semantic]]\\\\n  2569\\\\t        (is (= [:yin.k/ok 500]\\\\n  2570\\\\t               (run-guest-ast ast outcome-modules lane 185000))\\\\n  2571\\\\t            (str lane \\\\\\\": 1000 intra-unit calls fit comfortably inside 185k steps.\\\\n  2572\\\\t                      The unary-entry token-packet lane (D2) with the final arity guard