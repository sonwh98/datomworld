odule-spec {:module-name module-name\\\\n   181\\\\t                     :ast module-uast\\\\n   182\\\\t                     :exports module-exports\\\\n   183\\\\t                     :requires {}\\\\n   184\\\\t                     :free-names module-free-names\\\\n   185\\\\t                     :registry registry\\\\n   186\\\\t                     :message \\\\\\\"the yang.call module reads an undeclared name\\\\\\\"\\\\n   187\\\\t                     :refusal-ns \\\\\\\"yang.call\\\\\\\"}))\\\\n  2150\\\\t  [env macro-env forms form]\\\\n  2151\\\\t  (when (and (next forms)\\\\n  2152\\\\t             (not (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form))))\\\\n  2153\\\\t             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\\\\n  2154\\\\t    (reject! \\\\\\\"A non-final top-level form that may fail would discard its error outcome\\\\\\\"\\\\n  2155\\\\t             {:form form}))\\\\n  2156\\\\t  form)\\\\n  2157\\\\t\\\\n  2158\\\\t\\\\n  2159\\\\t(defn- lower-top-form\\\\n  2160\\\\t  \\\\\\\"Under the outcome model a top-level expression returns an outcome like a\\\\n  2161\\\\t   function body; definitions keep their own lowering.\\\\\\\"\\\\n  2162\\\\t  [env macro-env form]\\\\n  2163\\\\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\\\\n  2164\\\\t    form\\\\n  2165\\\\t    (lower-function-body env macro-env [] [form])))\\\\n  2166\\\\t\\\\n  2167\\\\t\\\\n  2168\\\\t(defn compile-program\\\\n  2169\\\\t  \\\\\\\"Compile a sequence of Clojure forms into a single Universal AST.\\\\n  2170\\\\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\\\\n  2171\\\\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\\\\n  2172\\\\t   with :macro? true on the lambda; the encoder turns that flag into a\\\\n  2173\\\\t   declaration row and the expander, not this compiler, recognizes calls.\\\\n  2174\\\\t   The three-argument form takes `opts` opting into the argument-vector\\\\n  2175\\\\t   convention (see `program-env`); without it the output is the native one.\\\\\\\"\\\\n  2176\\\\t  ([forms] (compile-program forms true))\\\\n  2177\\\\t  ([forms tail?] (compile-program forms tail? nil))\\\\n  2178\\\\t  ([forms tail? opts]\\\\n  2179\\\\t   (run! check-program-symbols! forms)\\\\n  2180\\\\t   (let [env (program-env forms opts)]\\\\n  2181\\\\t     ;; A discarded definition must not become a lexical binding in the\\\\n  2182\\\\t     ;; following definitions. Descriptor entry and body closures both capture\\\\n  2183\\\\t     ;; their environment: retaining the previous descriptor here doubles its\\\\n  2184\\\\t     ;; paths at each definition during machine-data validation and UCF lift.\\\\n  2185\\\\t     (letfn [(discard-result\\\\n  2186\\\\t               [ast]\\\\n  2187\\\\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\\\\n  2188\\\\t             (go\\\\n  2189\\\\t               [forms macro-env]\\\\n  2190\\\\t               (if (empty? forms)\\\\n  2191\\\\t                 (compile-literal nil tail?)\\\\n  2192\\\\t                 (let [head       (cond->> (first forms)\\\\n  2193\\\\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\\\\n  2194\\\\t                                    (outcomes? env) (lower-top-form env macro-env))\\\\n  2195\\\\t                       rest-forms (rest forms)]\\\\n  2196\\\\t                   (cond\\\\n  2197\\\\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\\\\n  2198\\\\t                     ;; lambda the encoder declares; later forms see the name\\\\n  2199\\\\t                     ;; only so the native defn lowering can yield to it.\\\\n  2200\\\\t                     (and (seq? head) (= 'defmacro (first head)))\\\\n  2201\\\\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\\\\n  2202\\\\t                       (cond-> {:type     :application\\\\n  2203\\\\t                                :operator {:type :lambda, :params ['_]\\\\n  2204\\\\t                                           :body (go rest-forms\\\\n  2205\\\\t                                                     (assoc macro-env\\\\n  2206\\\\t                                                            (strip-symbol-meta (second head))\\\\n  2207\\\\t                                                            {:type :user}))}\\\\n  2208\\\\t                                :operands [(discard-result defined)]}\\\\n  2209\\\\t                         tail? (assoc :tail? true)))\\\\n  2210\\\\t                     ;; def: sequence with current macro-env\\\\n  2211\\\\t                     (and (seq? head) (= 'def (first head)))\\\\n  2212\\\\t                     (let [[_ name value] head\\\\n  2213\\\\t                           value (cond-> value (outcomes? env) rewrite-ex-info)]\\\\n  2214\\\\t                       (when (and (outcomes? env)\\\\n  2215\\\\t                                  (failing? (assoc env ::macro-env macro-env) value))\\\\n  2216\\\\t                         (reject! \\\\\\\"A def value cannot call guest functions under the outcome model\\\\\\\"\\\\n  2217\\\\t                                  {:name name}))\\\\n  2218\\\\t                       (cond-> {:type     :application\\\\n  2219\\\\t                                :operator {:type :lambda, :params ['_]\\\\n  2220\\\\t                                           :body (go rest-forms macro-env)}\\\\n  2221\\\\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\\\\n  2222\\\\t                         tail? (assoc :tail? true)))\\\\n  2223\\\\t                     ;; single form\\\\n  2224\\\\t                     (= 1 (count forms))\\\\n  2225\\\\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\\\\n  2226\\\\t        