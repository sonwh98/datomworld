  (if (= (get (cell/get x) :js/type) :function)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:153:    [js/ty (fn [k] (if (= k :function) :object k))]\nsrc/cljc/yang/typescript/antlr/prelude.cljc:306:         (if (= k :function)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1548:         (if (if (= k :object) true (= k :function))\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1566:    ;; A function cell holds {:js/type :function :code (fn [this args] ..)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1567:    ;; :yang.call/entry (fn [invocation] ..)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1621:                                                                                                :function)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1623:                                                                                  :yang.call/entry entry)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1879:         (if (= k :function)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1880:           (assoc (assoc {} :js/snap :function)\nsrc/cljc/yang/typescript/antlr/prelude.cljc:2346:           (if (= k :function)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/call/conformance.clj | sed -n '1,175p;230,275p'; rg -n 'host|cell|native|compile|convention' test/yang/harness.cljc test/yang/harness.clj src/cljc/yang/clojure.cljc | head -80\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/call/conformance.clj | sed -n '1,175p;230,275p'; rg -n 'host|cell|native|compile|convention' test/yang/harness.cljc test/yang/harness.clj src/cljc/yang/clojure.cljc | head -80\"","aggregated_output":"     1\t(ns yang.call.conformance\n     2\t  \"The cross-language calling gates' shared composition (docs/design/\n     3\t   yang.antlr.md section 8.10.11): a donor program's named export reaches a\n     4\t   caller program by explicit published-export composition only.\n     5\t\n     6\t   A donor is real source of any admitted frontend, lowered unmodified and\n     7\t   published as an ordinary linker module whose one export, `body`, is the\n     8\t   lowered unit. A caller task requires that module, runs its body under the\n     9\t   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\n    10\t   `clj/run-main`), reads each named export from the donor runtime's global\n    11\t   namespace, and projects it into the caller runtime's namespace under the\n    12\t   same name; then the caller source, lowered unmodified, runs under its own\n    13\t   entry. The composition is a sequence of top-level nodes: no call node is\n    14\t   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\n    15\t   inserted, and the projected value is the donor's own callable value\n    16\t   (identity survives).\n    17\t\n    18\t   A callable value is task-local (a function is a cell, and cells are\n    19\t   task-local, section 8.11), so the export is answered as a node evaluated\n    20\t   in the caller's task, never as a host value carried between tasks.\n    21\t   `export-program` answers the donor's export alone as the program's value.\n    22\t\n    23\t   Every program runs linked on the three vector VMs (`semantic`, `stack`,\n    24\t   `register`) over the TypeScript linked harness's content store, where\n    25\t   `yang.call` and `js` already live and `php`, `py` and `clj` are\n    26\t   published beside them. The AST walker is not a backend: its links are\n    27\t   refused until L-b.\"\n    28\t  (:require\n    29\t    [clojure.string :as str]\n    30\t    [yang.clojure :as clj-comp]\n    31\t    [yang.clojure.prelude :as clj-prelude]\n    32\t    [yang.core.module :as core-module]\n    33\t    [yang.core.names :as names]\n    34\t    [yang.core.uast :as u]\n    35\t    [yang.php.antlr.cst :as php-cst]\n    36\t    [yang.php.antlr.lower :as php-lower]\n    37\t    [yang.php.antlr.portable-harness :as php-h]\n    38\t    [yang.php.antlr.prelude :as php-prelude]\n    39\t    [yang.python.antlr.lower :as py-lower]\n    40\t    [yang.python.antlr.parser :as py-parser]\n    41\t    [yang.python.antlr.prelude :as py-prelude]\n    42\t    [yang.python.antlr.render :as py-render]\n    43\t    [yang.typescript.antlr.cst :as ts-cst]\n    44\t    [yang.typescript.antlr.linked-harness :as h]\n    45\t    [yang.typescript.antlr.lower :as ts-lower]\n    46\t    [yang.typescript.antlr.render :as render]\n    47\t    [yin.vm :as vm]))\n    48\t\n    49\t\n    50\t(defn- publish-guest!\n    51\t  \"Publish guest module `spec` into the harness store, throwing immediately\n    52\t   with `result` in ex-data if publication is refused.\"\n    53\t  [spec]\n    54\t  (let [result (h/publish-guest-module! spec)]\n    55\t    (when (= :refused (:status result))\n    56\t      (throw (ex-info (str \"Guest module publication refused: \" (or (:reason result) (:status result)))\n    57\t                      result)))\n    58\t    result))\n    59\t\n    60\t\n    61\t(def ^:private published-php\n    62\t  \"`php` published once into `js`'s content store, pinning the same\n    63\t   `yang.call` revision (as `source-call-test` publishes it).\"\n    64\t  (delay (publish-guest!\n    65\t           (php-prelude/module-spec (h/registry)\n    66\t                                    (:call-address @h/published)))))\n    67\t\n    68\t\n    69\t(def ^:private published-py\n    70\t  \"`py` published beside `js` and `php`, over the same host registry and\n    71\t   `yang.call` revision.\"\n    72\t  (delay (publish-guest!\n    73\t           (py-prelude/module-spec (h/registry)\n    74\t                                   (:call-address @h/published)))))\n    75\t\n    76\t\n    77\t(def ^:private published-clj\n    78\t  \"`clj` published beside `js`, `php` and `py`, over the same host registry\n    79\t   and `yang.call` revision.\"\n    80\t  (delay (publish-guest!\n    81\t           (clj-prelude/module-spec (h/registry)\n    82\t                                    (:call-address @h/published)))))\n    83\t\n    84\t\n    85\t(defn- parse-ok\n    86\t  \"The CST packet of `source` under `parse`, refused unless the parse is ok.\"\n    87\t  [parse source]\n    88\t  (let [pk (parse source)]\n    89\t    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\n    90\t      (throw (ex-info \"donor or caller source does not parse\"\n    91\t                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\n    92\t    pk))\n    93\t\n    94\t\n    95\t(defn- python-export-symbol\n    96\t  [export]\n    97\t  (symbol (str \"xlang.python.export.\" export)))\n    98\t\n    99\t\n   100\t(defn- python-unit\n   101\t  [packet exports]\n   102\t  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\n   103\t         (u/seq-nodes\n   104\t           (concat (map (fn [export]\n   105\t                          (u/sexp->uast\n   106\t                            (list 'py/global-set py-lower/globals-sym\n   107\t                                  {:py/str export} (python-export-symbol export))))\n   108\t                        exports)\n   109\t                   [(py-lower/lower-module-body packet)]))))\n   110\t\n   111\t\n   112\t(def frontends\n   113\t  \"Each admitted frontend's profile, as data:\n   114\t\n   115\t   - `:runtime`, `:address`: the runtime module and its published address;\n   116\t   - `:refusal`: the publication refusal key and reason of its modules;\n   117\t   - `:deps` (optional): pinned requirements beyond the runtime its\n   118\t     lowered units read directly (the clojure unit's `yang.call` reads);\n   119\t   - `:parse`: source text to CST packet;\n   120\t   - `:unit`: packet and projected exports to the lowered unit its\n   121\t     `:run-main` entry takes;\n   122\t   - `:read-export`: export name to the form reading the runtime's global\n   123\t     namespace (JS `globalThis`, PHP's named-function table, Python's main\n   124\t     module dictionary, the clojure runtime's task-local namespace cell);\n   125\t   - `:project`: name and a value form to the form binding the value where\n   126\t     the runtime's source resolves a called name;\n   127\t   - `:render`: the `:run-main` value as test data.\"\n   128\t  {:typescript\n   129\t   {:runtime 'js,\n   130\t    :address #(:address @h/published),\n   131\t    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\n   132\t    :parse #(parse-ok ts-cst/parse-source %),\n   133\t    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\n   134\t    :run-main 'js/run-main,\n   135\t    :read-export (fn [export] (list 'js/global-get {:js/str export})),\n   136\t    :project (fn [name value] (list 'js/define-global! name value)),\n   137\t    :render render/output},\n   138\t   :php\n   139\t   {:runtime 'php,\n   140\t    :address #(:address @published-php),\n   141\t    :refusal [:yang.php/refusal :yang.php/undeclared-free],\n   142\t    :parse #(parse-ok php-cst/parse-source %),\n   143\t    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\n   144\t    :run-main 'php/run-main,\n   145\t    :read-export (fn [export]\n   146\t                   (list 'php/resolve-fn (str/lower-case export) export)),\n   147\t    :project (fn [name value]\n   148\t               (list 'php/declare-function! (str/lower-case name) value)),\n   149\t    :render php-h/render},\n   150\t   :python\n   151\t   {:runtime 'py,\n   152\t    :address #(:address @published-py),\n   153\t    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\n   154\t    :parse #(parse-ok py-parser/parse-source %),\n   155\t    :unit python-unit,\n   156\t    :run-main 'py/run-main,\n   157\t    :read-export (fn [export]\n   158\t                   (list 'py/global-get\n   159\t                         (list 'py/module-dict\n   160\t                               (list 'py/modules-ref {:py/str \"__main__\"}))\n   161\t                         {:py/str export})),\n   162\t    :project (fn [name value]\n   163\t               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\n   164\t    :render py-render/output},\n   165\t   :clojure\n   166\t   {:runtime 'clj,\n   167\t    :address #(:address @published-clj),\n   168\t    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\n   169\t    :deps (fn [] {'yang.call (:call-address @h/published)}),\n   170\t    :parse clj-comp/read-forms,\n   171\t    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\n   172\t    :run-main 'clj/run-main,\n   173\t    :read-export (fn [export] (list 'clj/global-get export)),\n   174\t    :project (fn [name value]\n   175\t               ;; The runtime global namespace is the one binding (as\n   230\t     {:frontend frontend,\n   231\t      :module module,\n   232\t      :address (:address result),\n   233\t      :links (:links result)})))\n   234\t\n   235\t\n   236\t(defn- runtime-entry\n   237\t  \"Require and initialize each distinct runtime of `frontend-keys`, once.\"\n   238\t  [frontend-keys]\n   239\t  (into [(core-module/require-node 'yang.call)]\n   240\t        (mapcat (fn [runtime]\n   241\t                  [(core-module/require-node runtime)\n   242\t                   (u/sexp->uast (list (symbol (str runtime) \"init!\")))]))\n   243\t        (distinct (map (comp :runtime profile) frontend-keys))))\n   244\t\n   245\t\n   246\t(defn- donor-run\n   247\t  \"The donor module required and its body run under its runtime's entry.\"\n   248\t  [{:keys [frontend module]}]\n   249\t  [(core-module/require-node module)\n   250\t   (u/app (u/v (:run-main (profile frontend)))\n   251\t          (u/v (symbol (str module) \"body\")))])\n   252\t\n   253\t\n   254\t(defn export-program\n   255\t  \"The program whose value is the donor's `export`, read from its runtime's\n   256\t   global namespace after its body ran.\"\n   257\t  [donor export]\n   258\t  (let [{:keys [read-export]} (profile (:frontend donor))]\n   259\t    (u/mark-tails\n   260\t      (u/seq-nodes (concat (runtime-entry [(:frontend donor)])\n   261\t                           (donor-run donor)\n   262\t                           [(u/sexp->uast (read-export export))])))))\n   263\t\n   264\t\n   265\t(defn compose\n   266\t  \"The caller program: the donor's body run, each name of `exports` read\n   267\t   from the donor runtime and projected into `caller-frontend`'s namespace\n   268\t   under the same name, then `caller-source`, lowered unmodified, run under\n   269\t   its runtime's entry. Its value is the caller entry's value.\"\n   270\t  [donor exports caller-frontend caller-source]\n   271\t  (let [{:keys [read-export]} (profile (:frontend donor))\n   272\t        {:keys [project parse unit run-main]} (profile caller-frontend)]\n   273\t    (u/mark-tails\n   274\t      (u/seq-nodes\n   275\t        (concat (runtime-entry [(:frontend donor) caller-frontend])\nrg: test/yang/harness.cljc: No such file or directory (os error 2)\nrg: test/yang/harness.clj: No such file or directory (os error 2)\nsrc/cljc/yang/clojure.cljc:2:  \"Yang Clojure compiler - Compiles Clojure code into Yin VM Universal AST.\nsrc/cljc/yang/clojure.cljc:4:  This is the Clojure-specific compiler in the Yang compiler collection.\nsrc/cljc/yang/clojure.c