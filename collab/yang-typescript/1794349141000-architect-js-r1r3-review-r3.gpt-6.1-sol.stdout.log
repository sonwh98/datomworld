{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/typescript/antlr/prelude.cljc | sed -n '4210,4325p'; nl -ba src/cljc/yang/clojure.cljc | sed -n '800,840p;2645,2725p'; nl -ba test/yang/clojure_test.clj | sed -n '2160,2188p'\"","aggregated_output":"  4210\t                    json-definitions)\n  4211\t              class-definitions)\n  4212\t        [['js.rt/state :js/uninit] ['js/init! (init-form)]]))\n  4213\t\n  4214\t\n  4215\t(def ^:private linked-definitions\n  4216\t  \"The `js` module body; the common call runtime is pinned as a requirement.\"\n  4217\t  definitions)\n  4218\t\n  4219\t\n  4220\t(defn- definitions->uast\n  4221\t  [defs]\n  4222\t  ;; A linear `then` chain adds two tree levels per definition and can\n  4223\t  ;; overflow the host printer's stack. Balance the sequence, preserving\n  4224\t  ;; left-to-right effects and the last definition's value.\n  4225\t  (letfn [(sequence-tree\n  4226\t            [nodes]\n  4227\t            (if (<= (count nodes) 1)\n  4228\t              (first nodes)\n  4229\t              (let [middle (quot (count nodes) 2)]\n  4230\t                (u/then (sequence-tree (subvec nodes 0 middle))\n  4231\t                        (sequence-tree (subvec nodes middle))))))]\n  4232\t    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n  4233\t\n  4234\t\n  4235\t(def functions-uast\n  4236\t  \"The shared calling runtime followed by every js definition. Defining\n  4237\t   them runs nothing, so this loads on any composition, with or without cells.\"\n  4238\t  (definitions->uast (into call/definitions definitions)))\n  4239\t\n  4240\t\n  4241\t(def uast\n  4242\t  \"The bundled prelude: every definition, then the task's runtime state\n  4243\t   allocated by `js/init!`.\"\n  4244\t  (u/then functions-uast (u/sexp->uast '(js/init!))))\n  4245\t\n  4246\t\n  4247\t;; =============================================================================\n  4248\t;; The linked js module requires the separately published `yang.call` module\n  4249\t;; =============================================================================\n  4250\t\n  4251\t(def module-name\n  4252\t  \"The linker module the JavaScript runtime profile is published as.\"\n  4253\t  'js)\n  4254\t\n  4255\t\n  4256\t(def runtime-keys\n  4257\t  \"Every key `js/init!` allocates, the ready flag aside, sorted.\"\n  4258\t  (vec (sort-by str\n  4259\t                (concat '[js.rt/ctx js.rt/out js.rt/global js.rt/obj-proto\n  4260\t                          js.rt/fn-proto js.rt/symbol-proto js.rt/array-proto]\n  4261\t                        (map second error-classes)\n  4262\t                        (map first primitive-protos)))))\n  4263\t\n  4264\t\n  4265\t(defn strip\n  4266\t  \"`sym` without the module's own namespace `js`; any other value as it\n  4267\t   is. `js.rt/*` stays qualified: an internal store key.\"\n  4268\t  [sym]\n  4269\t  (core/strip \"js\" sym))\n  4270\t\n  4271\t\n  4272\t(def ^:private module-definitions\n  4273\t  \"The module's definition list: a `:js/uninit` placeholder for every\n  4274\t   runtime key, then every definition, stripped.\"\n  4275\t  (core/module-definitions \"js\" :js/uninit runtime-keys linked-definitions))\n  4276\t\n  4277\t\n  4278\t(def module-uast\n  4279\t  \"The module tree: one application whose operands are the definitions, in\n  4280\t   order, applied to a lambda that returns nil.\"\n  4281\t  (core/module-tree module-definitions []))\n  4282\t\n  4283\t\n  4284\t(def module-exports\n  4285\t  \"The module's exports: every `js/` key of the definition list, stripped.\"\n  4286\t  (core/exports \"js\" definitions))\n  4287\t\n  4288\t\n  4289\t(def free-names\n  4290\t  \"Every variable name some occurrence of the map AST reads unbound by an\n  4291\t   enclosing lambda.\"\n  4292\t  core/free-names)\n  4293\t\n  4294\t\n  4295\t(def defined-keys\n  4296\t  \"Every literal key the map AST defines with `yin/def`, at any depth.\"\n  4297\t  core/defined-keys)\n  4298\t\n  4299\t\n  4300\t(def ^:private module-free-names\n  4301\t  \"The names the module tree reads and does not define, sorted: the\n  4302\t   primitives and the host exports its manifest must declare.\"\n  4303\t  (core/free-name-vec module-uast))\n  4304\t\n  4305\t\n  4306\t(defn module-spec\n  4307\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `js` over\n  4308\t   the host registry `registry`, pinned to the published `yang.call` module\n  4309\t   at `call-address`. A free name nothing supplies is refused before\n  4310\t   anything is published. This namespace emits; it never publishes.\"\n  4311\t  [registry call-address]\n  4312\t  (core/module-spec {:module-name module-name,\n  4313\t                     :ast module-uast,\n  4314\t                     :exports module-exports,\n  4315\t                     :requires {'yang.call call-address},\n  4316\t                     :free-names module-free-names,\n  4317\t                     :skip? #(= \"yang.call\" (namespace %)),\n  4318\t                     :registry registry,\n  4319\t                     :message \"the js module reads an undeclared name\",\n  4320\t                     :refusal-ns \"yang.typescript.antlr\"}))\n  4321\t\n  4322\t\n  4323\t(def min-integer-bits\n  4324\t  \"The smallest `::integer/max-bits` this profile admits: every inline\n  4325\t   literal (up to 2^53 - 1) must fit.\"\n   800\t;; program's own macro names stay ordinary applications: the expander\n   801\t;; recognizes those calls, so their operands must stay ordinary.\n   802\t\n   803\t(def ^:private av-sym (symbol (str reserved-prefix \"av\")))\n   804\t\n   805\t\n   806\t(def ^:private default-adapter-arity\n   807\t  \"The largest count an adapter admits for a native name with no declared\n   808\t   profile (`:native` given as a plain set).\"\n   809\t  4)\n   810\t\n   811\t\n   812\t(def ^:private adapter-variadic-cap\n   813\t  \"How far an adapter extends a `:variadic` profile arity: an adapter is a\n   814\t   finite dispatch, so an open-ended arity needs a stated bound.\"\n   815\t  8)\n   816\t\n   817\t\n   818\t(defn- native-name?\n   819\t  \"True when `sym` statically names a primitive or host-module export.\"\n   820\t  [env sym]\n   821\t  (when-let [conv (::convention env)]\n   822\t    (and (symbol? sym)\n   823\t         (not (contains? (locals env) sym))\n   824\t         (not (contains? (::defined env) sym))\n   825\t         (or (some? (namespace sym))\n   826\t             (contains? (:native conv) sym)))))\n   827\t\n   828\t\n   829\t(defn- macro-call?\n   830\t  [env macro-env sym]\n   831\t  (and (symbol? sym)\n   832\t       (not (contains? (locals env) sym))\n   833\t       (or (contains? macro-env sym)\n   834\t           (contains? (:macros (::convention env)) sym))))\n   835\t\n   836\t\n   837\t;; =============================================================================\n   838\t;; Outcome model (slice 5)\n   839\t;; =============================================================================\n   840\t;;\n  2645\t;; keys/vals/disj and set union/difference,\n  2646\t;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\n  2647\t;; compiler intrinsic over the convention's argument vector.\n  2648\t;;\n  2649\t;; What stays a host primitive, named by the `kind` module: a symbol, a\n  2650\t;; keyword and a host string are distinguished or built only by the host\n  2651\t;; (symbol?, keyword?, name, symbol, keyword, str, int?), as is metadata access\n  2652\t;; (meta and with-meta). The current data ABI has no metadata-write export,\n  2653\t;; so with-meta is an explicit pure representation seam, not an ambient store.\n  2654\t;; No VM primitive tells a symbol from a keyword. Clojure Var identity is an\n  2655\t;; explicitly admitted kind/var? seam on the JVM; namespace lookup (resolve)\n  2656\t;; still requires a separately installed host capability.\n  2657\t;;\n  2658\t;; Known compromises: `reduced` is an untyped tagged map, so reduced? matches\n  2659\t;; any map holding :yin.k/reduced true; seq refuses a non-collection (a string\n  2660\t;; is the data module's str-* ops, not a seq); eager sequences are lists;\n  2661\t;; rem rejects non-integers and a zero divisor before arithmetic; the compiler\n  2662\t;; emits bare conj and vec, so a program may not define or bind either.\n  2663\t;; When collection calls are needed, invoke-value is a library helper whose\n  2664\t;; local capture is refused explicitly.\n  2665\t;;\n  2666\t;; Variadic Clojure functions are fixed-arity here (the convention has no\n  2667\t;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\n  2668\t;; merge 0 to 4, union 0 to 6, difference 2, comp 0 to 3, partial binds 1 to 3.\n  2669\t;; A larger count is the\n  2670\t;; function's own arity error.\n  2671\t\n  2672\t(def library-adapters\n  2673\t  \"The `:adapters` a program using `library` is compiled with: the data\n  2674\t   exports whose refusal the predicates read as data. The harness registers\n  2675\t   `portable/<name>` as `outcome-adapter` over the same `data/<name>`.\"\n  2676\t  {'data/count 'portable/count\n  2677\t   'data/peek 'portable/peek\n  2678\t   'data/dissoc 'portable/dissoc\n  2679\t   'data/disj 'portable/disj\n  2680\t   'data/str-length 'portable/str-length})\n  2681\t\n  2682\t\n  2683\t(def kind-module\n  2684\t  \"The `kind` host module's exports, symbol to host function: the irreducible\n  2685\t   kind and name primitives (see the library notes). Every export is pure.\"\n  2686\t  (merge\n  2687\t    {'symbol? symbol?\n  2688\t     'keyword? keyword?\n  2689\t     'name name\n  2690\t     'symbol symbol\n  2691\t     'keyword keyword\n  2692\t     'str str\n  2693\t     'int? int?\n  2694\t     'with-meta with-meta\n  2695\t     'meta meta}\n  2696\t    #?(:clj {'var? var?} :default {})))\n  2697\t\n  2698\t\n  2699\t(def kind-arities\n  2700\t  \"The published arities of each `kind` export.\"\n  2701\t  {'symbol? [1], 'keyword? [1], 'name [1], 'symbol [1 2], 'keyword [1 2]\n  2702\t   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'var? [1], 'with-meta [2], 'meta [1]})\n  2703\t\n  2704\t\n  2705\t(def library\n  2706\t  \"The library's definitions, in order, as quoted source.\"\n  2707\t  '[(defn identity\n  2708\t      [x]\n  2709\t      x)\n  2710\t    (defn inc\n  2711\t      [x]\n  2712\t      (+ x 1))\n  2713\t    (defn dec\n  2714\t      [x]\n  2715\t      (- x 1))\n  2716\t    (defn second\n  2717\t      [x]\n  2718\t      (first (rest x)))\n  2719\t    (defn not=\n  2720\t      [a b]\n  2721\t      (not (= a b)))\n  2722\t    (defn boolean?\n  2723\t      [x]\n  2724\t      (or (= x true) (= x false)))\n  2725\t    (defn fn?\n  2160\t    (doseq [lane [:walker :semantic]]\n  2161\t      (is (= [:yin.k/ok :called]\n  2162\t             (run-cell-program\n  2163\t               '[(defn probe\n  2164\t                   [m]\n  2165\t                   (let [copy {:type (get m :type), :id (get m :id), :seal (get m :seal)}]\n  2166\t                     (copy nil)))\n  2167\t                 (probe marker-operand)]\n  2168\t               (u/app (u/v 'cell/new)\n  2169\t                      (u/app (u/v 'assoc) (u/lit {})\n  2170\t                             (u/lit :yang.call/entry)\n  2171\t                             (u/lam ['invocation] (u/lit :called))))\n  2172\t               lane))\n  2173\t          (str lane \" bearer copy resolves\"))))\n  2174\t  (testing \"explicit dereference of a forged reference stays strict\"\n  2175\t    ;; Astra rule 1: cell/get at a reference position keeps the existing\n  2176\t    ;; validation boundary — the data fallback lives in call routing, not in\n  2177\t    ;; the dereference itself.\n  2178\t    (doseq [lane [:walker :semantic]]\n  2179\t      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\n  2180\t             (run-cell-program\n  2181\t               '[(defn probe\n  2182\t                   [m]\n  2183\t                   (cell/get m))\n  2184\t                 (probe marker-operand)]\n  2185\t               (u/lit {:type :cell-ref :id :cell-7\n  2186\t                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n  2187\t               lane))\n  2188\t          (str lane \" explicit deref refuses\")))))\n","exit_code":0,"status":"completed"}}
