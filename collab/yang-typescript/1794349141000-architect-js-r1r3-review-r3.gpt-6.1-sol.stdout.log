{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/call/conformance_test.clj test/yang/call/exception_contract_test.clj test/yang/call/exception_source_test.clj test/yang/call/exception_probes.clj'","aggregated_output":"(ns yang.call.conformance-test\n  (:require [clojure.test :refer [deftest is]]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]\n            [yang.core.call :as call]\n            [yang.core.uast :as u]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.module :as module]\n            [yin.vm.test-utils :as tu]))\n\n\n(deftest evaluated-boundary-observation-test\n  (let [registry (-> (module/empty-registry) module/register-cell-module\n                     data/register-data-module)\n        run (fn [form]\n              (vm/value\n                (vm/eval (tu/create-vm {:primitives vm/primitives :modules registry})\n                         (u/mark-tails (u/then call/uast (u/sexp->uast form))))))]\n    (is (= {:x 7 :computed 8}\n           (run (list 'let ['x 7]\n                      (kit/observation-map-form {:x 'x :computed '(+ x 1)})))))\n    (doseq [[entry expected]\n            [['(fn [invocation] ((get invocation :yang.call/raise) (yang.call/thrown 7)))\n              {:route :raise :condition {:yang.call/reason :yang.call/thrown :yang.call/value 7}\n               :transfers 1 :after false}]\n             ['(fn [invocation] 7)\n              {:route :return :value 7 :transfers 0 :after true}]]]\n      (is (= expected\n             (run (list 'let ['callee (list 'cell/new (list 'assoc {} :yang.call/entry entry))]\n                        (kit/boundary-call-form 'callee [] []))))))\n    (is (true?\n          (run\n            (list 'let ['payload '(cell/new :identity)\n                        'callee '(cell/new (assoc {} :yang.call/entry\n                                                  (fn [invocation]\n                                                    (get (get invocation :yang.call/positional) 0))))\n                        'result (kit/boundary-call-form\n                                  'callee (kit/observation-vector-form ['payload]) [])]\n                  '(= payload (get result :value))))))))\n\n\n(deftest uniform-root-exception-observation-test\n  (doseq [[frontend raw expected]\n          [[:python {:py/out [] :py/exception {:type \"ValueError\"}}\n            {:type \"ValueError\"}]\n           [:typescript {:js/out [] :js/uncaught {:value {:js/str \"arbitrary\"}}}\n            {:value {:js/str \"arbitrary\"}}]\n           [:php {:php/out \"\" :php/uncaught {:class \"Exception\" :message \"x\"}}\n            {:class \"Exception\" :message \"x\"}]\n           [:clojure [:yin.k/error {:marker :original}] {:marker :original}]]]\n    (let [observation (kit/exception-outcome frontend raw)]\n      (is (= frontend (:frontend observation)))\n      (is (= expected (:exception observation)))))\n  (is (= {:yang.call/reason :yang.call/thrown :yang.call/value :data}\n         (:value (kit/exception-outcome\n                   :clojure {:yang.call/reason :yang.call/thrown\n                             :yang.call/value :data}))))\n  (is (nil? (:exception (kit/exception-outcome :clojure [:yin.k/ok :data])))))\n\n\n(deftest mechanically-derived-obligations-test\n  (is (= 12 (count (set (map (juxt :donor :caller) contract/pair-matrix)))))\n  (is (= 6 (count (set (map (juxt :donor :caller)\n                            (filter #(= :jvm-linked (:execution %))\n                                    contract/pair-matrix))))))\n  (is (every? #(and (seq (:gates %)) (seq (:frontends %)))\n              (concat contract/fixtures contract/pair-matrix\n                      contract/pending-obligations)))\n  (is (= #{::contract/r1 ::contract/r2 ::contract/r3 ::contract/r4 ::contract/r5}\n         (get (contract/ledger-seed) :clojure))))\n(ns yang.call.exception-contract-test\n  \"Intentionally red until exception rounds 1–4 repair the runtimes. Never\n   invert assertions or encode today's divergences as expected behavior.\"\n  (:require [clojure.test :refer [deftest is testing do-report]]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-probes :as probes]))\n\n\n(defn- check-frontend\n  [frontend]\n  (let [observations (probes/run-frontend frontend)]\n    (doseq [{:keys [id expected] :as fixture}\n            (filter #(= frontend (:frontend %)) contract/fixtures)]\n      (testing (str id \" gates=\" (:gates fixture))\n        (try\n          (let [results (get observations id)]\n            (println \"PROVENANCE\"\n                     (pr-str {:id id :gates (:gates fixture) :frontends (:frontends fixture)\n                              :expected expected\n                              :results (update-vals results #(if (instance? Throwable %)\n                                                               {:host/error (.getMessage ^Throwable %)\n                                                                :host/data (ex-data %)} %))\n                              :status (update-vals results #(cond (instance? Throwable %) :error\n                                                                  (= expected %) :green :else :red))}))\n            (doseq [[backend actual] results]\n              (if (instance? Throwable actual)\n                (do-report {:type :error :message (str id \" \" backend \" operational failure\")\n                            :expected expected :actual actual})\n                (is (= expected actual) (str id \" \" backend)))))\n          (catch Exception e\n            (do-report {:type :error :message (str id \" boundary fixture failed to execute\")\n                        :expected expected :actual e})))))))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2 ::contract/r3 ::contract/r5}\n           :frontends #{:python}}\n  python-provenance-test\n  (check-frontend :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2 ::contract/r3 ::contract/r5}\n           :frontends #{:php}}\n  php-provenance-test\n  (check-frontend :php))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r3 ::contract/r5}\n           :frontends #{:typescript}}\n  typescript-provenance-test\n  (check-frontend :typescript))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r3 ::contract/r5}\n           :frontends #{:clojure}}\n  clojure-provenance-test\n  (check-frontend :clojure))\n(ns yang.call.exception-source-test\n  \"Generator checks: refusals here are fixture defects, never runtime reds.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]))\n\n\n(defn- lower\n  [frontend source exports]\n  (let [{:keys [parse unit]} (get kit/frontends frontend)]\n    (unit (parse source) exports)))\n\n\n(deftest provenance-source-compilation-test\n  (doseq [[frontend source] contract/sources]\n    (testing (name frontend)\n      (is (map? (lower frontend source [])))))\n  (is (map? (lower :python contract/boundary-source []))))\n\n\n(deftest all-directed-pair-sources-compile-test\n  (doseq [frontend (sort contract/frontends)]\n    (testing (str \"donor \" frontend)\n      (is (map? (lower frontend (legs/donor-source frontend) [])))))\n  (doseq [{:keys [id donor caller scenario]} contract/pair-matrix]\n    (testing (str id)\n      (is (map? (lower caller (legs/caller-source caller scenario)\n                       (legs/donor-exports donor))))))\n  (doseq [[[donor caller :as direction] pair-legs]\n          (group-by (juxt :donor :caller) contract/pair-matrix)]\n    (testing (str \"batch \" direction)\n      (is (map? (lower caller (legs/batch-caller-source caller pair-legs)\n                       (legs/donor-exports donor)))))))\n\n\n(deftest clojure-restricted-catch-surface-preserved-test\n  (is (thrown? clojure.lang.ExceptionInfo\n        (lower :clojure \"(try 1 (finally 2))\" [])))\n  (is (thrown? clojure.lang.ExceptionInfo\n        (lower :clojure \"(try 1 (catch Throwable e 2))\" []))))\n(ns yang.call.exception-probes\n  \"Boundary materialization of exception-contract/fixtures. Synthetic entries\n   occur ONLY for delivery of boundary-generated conditions; source pairs\n   live in exception-legs. Every receiver/rethrow body is parsed source.\"\n  (:require [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]))\n\n\n(defn- read-export\n  [frontend name]\n  (kit/export-form frontend name))\n\n\n(defn- call\n  [callee args]\n  (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n\n\n(def ^:private boundary-donor\n  (delay (kit/publish-donor! :python contract/boundary-source)))\n\n\n(defn- transfer-summary\n  [result]\n  {:transferred (list '= (list 'get result :route) :raise)\n   :once (list '= 1 (list 'get result :transfers))\n   :after (list 'get result :after)})\n\n\n(defn- reason\n  [result]\n  (list 'get (list 'get result :condition) :yang.call/reason))\n\n\n(defn- payload\n  [result]\n  (list 'get (list 'get result :condition) :yang.call/value))\n\n\n(defn- protocol-condition\n  [reason]\n  (let [target (read-export :python \"boundary_target\")]\n    (list 'get\n          (case reason\n            :yang.call/not-callable (call {} [])\n            :yang.call/invalid-invocation\n            (kit/boundary-call-form target :malformed-positional [])\n            :yang.call/unsupported-binding\n            (kit/boundary-call-form target [] []\n                                    {:yang.call/binding-profile :contract/unsupported}))\n          :condition)))\n\n\n(defn- injected\n  [condition]\n  ;; This is a boundary delivery fixture, never counted as a real-source\n  ;; directed pair. The source receiver still uses its ordinary call helper.\n  (list 'cell/new\n        (list 'assoc {} :yang.call/entry\n              (list 'fn ['invocation]\n                    (list (list 'get 'invocation :yang.call/raise) condition)))))\n\n\n(defn observation-form\n  \"A fixture's guest-side assertions as plain booleans and qualified reasons.\n   Neither live payloads nor wrappers are rendered or ferried between tasks.\"\n  [{:keys [scenario frontend protocol-reason]}]\n  (let [export #(read-export frontend %)\n        result 'probe.result\n        original 'probe.original\n        condition 'probe.condition\n        retained 'probe.retained\n        wrapper 'probe.wrapper\n        fresh-summary (assoc (transfer-summary result)\n                             :reason (reason result)\n                             :payload-identical (list '= original (payload result)))\n        protocol-summary (assoc (transfer-summary result)\n                                :reason (reason result)\n                                :condition-identical\n                                (list '= condition (list 'get result :condition)))]\n    (kit/guard-exceptions-form\n      [:python frontend]\n      (cond\n        (#{:fresh-named :fresh-closure :forged-retention} scenario)\n        (list 'let [original (list 'get (call (export (if (= scenario :forged-retention)\n                                                        \"forged\" \"payload\"))\n                                              (if (= scenario :forged-retention)\n                                                [(protocol-condition :yang.call/not-callable)] [])) :value)\n                    result (case scenario\n                             :fresh-named (call (export \"donor_raise\") [])\n                             :fresh-closure\n                             (call (list 'get (call (export \"make_exploder\") []) :value) [])\n                             :forged-retention (call (export \"raise_value\") [original]))]\n              (kit/observation-map-form fresh-summary))\n\n        (= scenario :binding)\n        (list 'let [result (call (export \"needs_argument\") [])]\n              (kit/observation-map-form\n                (assoc (transfer-summary result) :reason (reason result))))\n\n        (#{:shape-return :shape-throw} scenario)\n        (list 'let [original {:yang.call/reason :yang.call/not-callable\n                              :yang.call/data {:nested [:ordinary :data]}}\n                    result (call (export (if (= scenario :shape-return) \"echo\" \"raise_value\"))\n                                 [original])]\n              (kit/observation-map-form (if (= scenario :shape-return)\n                                          {:returned (list '= (list 'get result :route) :return)\n                                           :payload-identical (list '= original (list 'get result :value))}\n                                          fresh-summary)))\n\n        protocol-reason\n        (list 'let [condition (protocol-condition protocol-reason)\n                    'probe.injected (injected condition)]\n              (if (.startsWith (name scenario) \"saved-protocol-\")\n                (list 'let [retained (call (export \"retain\") ['probe.injected])\n                            result (call (export \"later\") [])]\n                      (kit/observation-map-form\n                        (assoc protocol-summary\n                               :retained (list '= (list 'get retained :route) :return))))\n                (list 'let [result (call (export \"receive\") ['probe.injected])]\n                      (kit/observation-map-form protocol-summary))))\n\n        (= scenario :local-reception)\n        (list 'let [original (list 'get (call (export \"payload\") []) :value)\n                    condition (kit/observation-map-form\n                                {:yang.call/reason :yang.call/thrown\n                                 :yang.call/value original})\n                    'probe.injected (injected condition)\n                    result (call (export \"retain\") ['probe.injected])]\n              (kit/observation-map-form\n                {:returned (list '= :return (list 'get result :route))\n                 :payload-identical (list '= original (list 'get result :value))}))\n\n        (#{:foreign-reception :retained-foreign-lifetime} scenario)\n        (list 'let [original (list 'cell/new {:foreign/payload :identity})\n                    condition (kit/observation-map-form\n                                {:yang.call/reason :yang.call/thrown\n                                 :yang.call/value original\n                                 :yang.call/data {:complete [:extra :evidence]}})\n                    'probe.injected (injected condition)\n                    retained (call (export \"retain\") ['probe.injected])\n                    wrapper (list 'get retained :value)\n                    'probe.local (list 'if (list '= :return (list 'get retained :route))\n                                       (call (export \"is_foreign\") [wrapper])\n                                       {:value false})]\n              (let [local (list '= true (list 'get 'probe.local :value))\n                    returned (list '= (list 'get retained :route) :return)]\n                (if (= scenario :foreign-reception)\n                  (kit/observation-map-form\n                    {:returned returned :local-foreign-exception local})\n                  (list 'let [result (call (export \"later\") [])]\n                        (kit/observation-map-form\n                          (assoc (transfer-summary result)\n                                 :retained returned :local-foreign-exception local\n                                 :condition-identical (list '= condition (list 'get result :condition))\n                                 :payload-identical (list '= original (payload result))))))))\n\n        :else (throw (ex-info \"unknown provenance fixture\" {:scenario scenario}))))))\n\n\n(defn run-fixture\n  \"One source-created receiver per task. All three linked vector VMs run.\n   A fresh task prevents a deliberately broken bridge from poisoning the\n   next fixture's handler context.\"\n  [{:keys [frontend source] :as fixture}]\n  (try\n    (let [donor @boundary-donor]\n      (kit/run-exception-program\n        donor\n        (kit/compose-exception donor [\"boundary_target\"] frontend source\n                               (observation-form fixture))))\n    (catch Throwable e\n      (kit/error-results e))))\n\n\n(defn run-frontend\n  \"Run one source unit per frontend and observe each fixture's separate\n   public activations. Full context snapshot proof remains a frontend gate.\n   `saved` is intentionally task-owned: lifetime probes\n   must finish retain before entering later. `run-fixture` remains available\n   for an isolated diagnostic when a frontend's broken state poisons a batch.\"\n  [frontend]\n  (let [fixtures (filter #(= frontend (:frontend %)) contract/fixtures)]\n    (try\n      (let [donor @boundary-donor\n            observations (reduce (fn [acc fixture]\n                                   (list 'assoc acc (:id fixture) (observation-form fixture)))\n                                 {} fixtures)\n            results (kit/run-exception-program\n                      donor\n                      (kit/compose-exception donor [\"boundary_target\"] frontend\n                                             (contract/sources frontend) observations))]\n        (if (some #(instance? Throwable %) (vals results))\n          ;; An operational defect is not a source exception. Isolate fixtures\n          ;; so one host refusal neither erases nor invents the other outcomes.\n          (into {} (for [{:keys [id] :as fixture} fixtures]\n                     [id (run-fixture fixture)]))\n          (into {} (for [{:keys [id]} fixtures]\n                     [id (update-vals results #(get % id))]))))\n      (catch Throwable e\n        (let [err (kit/error-results e)]\n          (into {} (for [{:keys [id]} fixtures]\n                     [id err])))))))\n","exit_code":0,"status":"completed"}}
