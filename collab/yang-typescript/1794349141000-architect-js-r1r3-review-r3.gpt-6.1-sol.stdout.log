et py.rt/ctx) :depth)))]\\\\n   288\\\\t    [py/pop-frame\\\\n  3370\\\\t  \\\\\\\"Builtin class name -> [store key, base store key or nil].\\\\\\\"\\\\n  3371\\\\t  [[\\\\\\\"object\\\\\\\" 'py.b/object nil]\\\\n  3372\\\\t   [\\\\\\\"BaseException\\\\\\\" 'py.b/BaseException 'py.b/object]\\\\n  3373\\\\t   ;; raised by the safepoint hook prelude's signal delivery; the class is a\\\\n  3374\\\\t   ;; builtin like any other, so naive programs read and shadow it normally\\\\n  3375\\\\t   [\\\\\\\"KeyboardInterrupt\\\\\\\" 'py.b/KeyboardInterrupt 'py.b/BaseException]\\\\n  3376\\\\t   ;; thrown into a generator by close()\\\\n  3377\\\\t   [\\\\\\\"GeneratorExit\\\\\\\" 'py.b/GeneratorExit 'py.b/BaseException]\\\\n  3378\\\\t   [\\\\\\\"Exception\\\\\\\" 'py.b/Exception 'py.b/BaseException]\\\\n  3379\\\\t   [\\\\\\\"ArithmeticError\\\\\\\" 'py.b/ArithmeticError 'py.b/Exception]\\\\n  3380\\\\t   [\\\\\\\"ZeroDivisionError\\\\\\\" 'py.b/ZeroDivisionError 'py.b/ArithmeticError]\\\\n  3381\\\\t   [\\\\\\\"LookupError\\\\\\\" 'py.b/LookupError 'py.b/Exception]\\\\n  3382\\\\t   [\\\\\\\"IndexError\\\\\\\" 'py.b/IndexError 'py.b/LookupError]\\\\n  3383\\\\t   [\\\\\\\"KeyError\\\\\\\" 'py.b/KeyError 'py.b/LookupError]\\\\n  3384\\\\t   [\\\\\\\"TypeError\\\\\\\" 'py.b/TypeError 'py.b/Exception]\\\\n  3385\\\\t   [\\\\\\\"ValueError\\\\\\\" 'py.b/ValueError 'py.b/Exception]\\\\n  3386\\\\t   [\\\\\\\"AttributeError\\\\\\\" 'py.b/AttributeError 'py.b/Exception]\\\\n  3387\\\\t   [\\\\\\\"ImportError\\\\\\\" 'py.b/ImportError 'py.b/Exception]\\\\n  3388\\\\t   [\\\\\\\"ModuleNotFoundError\\\\\\\" 'py.b/ModuleNotFoundError 'py.b/ImportError]\\\\n  3389\\\\t   [\\\\\\\"NameError\\\\\\\" 'py.b/NameError 'py.b/Exception]\\\\n  3390\\\\t   [\\\\\\\"UnboundLocalError\\\\\\\" 'py.b/UnboundLocalError 'py.b/NameError]\\\\n  3391\\\\t   [\\\\\\\"RuntimeError\\\\\\\" 'py.b/RuntimeError 'py.b/Exception]\\\\n  3392\\\\t   ;; raised at a generator start or resume the limit refuses (here, in\\\\n  3393\\\\t   ;; every mode) and by the safepoint hook prelude's depth accounting; a\\\\n  3394\\\\t   ;; builtin like KeyboardInterrupt, under RuntimeError as in CPython\\\\n  3395\\\\t   [\\\\\\\"RecursionError\\\\\\\" 'py.b/RecursionError 'py.b/RuntimeError]\\\\n  3396\\\\t   [\\\\\\\"NotImplementedError\\\\\\\" 'py.b/NotImplementedError 'py.b/RuntimeError]\\\\n  3397\\\\t   [\\\\\\\"OverflowError\\\\\\\" 'py.b/OverflowError 'py.b/ArithmeticError]\\\\n  3398\\\\t   ;; an integer past the composition's bit limit (`py/int-result`)\\\\n  3399\\\\t   [\\\\\\\"MemoryError\\\\\\\" 'py.b/MemoryError 'py.b/Exception]\\\\n  3400\\\\t   [\\\\\\\"StopIteration\\\\\\\" 'py.b/StopIteration 'py.b/Exception]])\\\\n  3401\\\\t\\\\n  3402\\\\t\\\\n  3403\\\\t(defquoted builtin-functions\\\\n  3404\\\\t  \\\\\\\"The Python-visible builtin functions, `[name store-key form]`. Builtin\\\\n  3405\\\\t   functions are function objects like any guest function, so they can be\\\\n  3406\\\\t   passed, stored, called with keywords and checked for arity through\\\\n  3407\\\\t   `py/call-kw`.\\\\\\\"\\\\n  3408\\\\t  '[[\\\\\\\"len\\\\\\\" py.b/len\\\\n  3409\\\\t     (py/make-builtin-function \\\\\\\"len\\\\\\\" {:params [\\\\\\\"obj\\\\\\\"], :no-kw true} [] []\\\\n  3410\\\\t                               (fn [args] (py/len (py/arg args 0))))]\\\\n  3411\\\\t    [\\\\\\\"isinstance\\\\\\\" py.b/isinstance\\\\n  3412\\\\t     (py/make-builtin-function \\\\\\\"isinstance\\\\\\\" {:params [\\\\\\\"obj\\\\\\\" \\\\\\\"cls\\\\\\\"], :no-kw true} [] []\\\\n  3413\\\\t                               (fn [args] (py/isinstance (py/arg args 0) (py/arg args 1))))]\\\\n  3414\\\\t    [\\\\\\\"divmod\\\\\\\" py.b/divmod\\\\n  3415\\\\t     (py/make-builtin-function \\\\\\\"divmod\\\\\\\" {:params [\\\\\\\"x\\\\\\\" \\\\\\\"y\\\\\\\"], :no-kw true} [] []\\\\n   395\\\\t                      \\\\\\\"9007199254740992 18014398509481984 -9007199254740993\\\\\\\")\\\\n   396\\\\t                 (str \\\\\\\"27021597764222973 -9007199254740993 0 -1 \\\\\\\"\\\\n   397\\\\t                      \\\\\\\"-9007199254740993 9007199254740992\\\\\\\"))\\\\n   398\\\\t               (lines \\\\\\\"def ov(f):\\\\\\\"\\\\n   399\\\\t                      \\\\\\\"    try:\\\\\\\"\\\\n   400\\\\t                      \\\\\\\"        return f()\\\\\\\"\\\\n   401\\\\t                      \\\\\\\"    except OverflowError:\\\\\\\"\\\\n   402\\\\t                      \\\\\\\"        return 'overflow'\\\\\\\"\\\\n   403\\\\t                      (str \\\\\\\"print(2 ** 53, ov(lambda: 2 ** 53 + 1), \\\\\\\"\\\\n   404\\\\t                           \\\\\\\"ov(lambda: 3 ** 40), 1 << 52, \\\\\\\"\\\\n   405\\\\t                           \\\\\\\"1 << 53, ov(lambda: 1 << 54), \\\\\\\"\\\\n   406\\\\t                           \\\\\\\"ov(lambda: -(2 ** 53) - 1))\\\\\\\")\\\\n   407\\\\t                      (str \\\\\\\"print(ov(lambda: 9007199254740991 * 3), \\\\\\\"\\\\n   408\\\\t                           \\\\\\\"ov(lambda: -9007199254740992 - 1), \\\\\\\"\\\\n   409\\\\t                           \\\\\\\"0 << 100, -1 >> 100, \\\\\\\"\\\\n   410\\\\t                           \\\\\\\"ov(lambda: ~(2 ** 53)), 1 << 53)\\\\\\\")))))\\\\n   411\\\\t\\\\n   412\\\\t\\\\n   413\\\\t(deftest ^:slow gate-p3-round2-test\\\\n   414\\\\t  (testing \\\\\\\"break and continue in finally swallow the exception in flight\\\\n   415\\\\t            (legal since 3.8); raising a non-exception is a TypeError;\\\\n   416\\\\t            `except E as e` unbinds e; range len and membership in closed\\\\n   417\\\\t            form; dict/set size change during iteration is a RuntimeError;\\\\n   418\\\\t            float % and // as CPython's fmod-corrected divmod; builtins take\\\\n   419\\\\t            no keywords; a class without __init__ takes no arguments; with\\\\n   420\\\\t            looks its dunders up on the type\\\\\\\"\\\\n   421\\\\t    (every-vm= (prints \\\\\\\"after break\\\\\\\"\\\\n   422\\\\t                       \\\\\\\"3\\\\\\\"\\\\n   423\\\\t                       \\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\"\\\\n   424\\\\t                       \\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\"\\\\n   425\\\\t                       \\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\"\\\\n   426\\\\t                       \\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\"\\\\n   427\\\\t                       \\\\\\\"err unbound\\\\\\\"\\\\n   428\\\\t                       \\\\\\\"e2 unbound\\\\\\\"\\\\n   429\\\\t                       \\\\\\\"1501199875790166 True True False 0 4\\\\\\\"\\\\n   430\\\\t                       \\\\\\\"dictionary changed size during iteration\\\\\\\"\\\\n   431\\\\t                       \\\\\\\"Set changed size during iteration\\\\\\\"\\\\n   432\\\\t                       (str \\\\\\\"0.3999999999999999 5.0 0.7000000000000002 -4.0 0.5 \\\\\\\"\\\\n   433\\\\t                            \\\\\\\"0.09999999999999998 1.0000005382899513\\\\\\\")\\\\n   434\\\\t                       \\\\\\\"TypeError\\\\\\\"\\\\n   435\\\\t                       \\\\\\\"TypeError\\\\\\\"\\\\n   436\\\\t                       \\\\\\\"not a context manager\\\\\\\")\\\\n   437\\\\t               (lines \\\\\\\"for i in range(2):\\\\\\\"\\\\n   438\\\\t                      \\\\\\\"    try:\\\\\\\"\\\\n   439\\\\t                      \\\\\\\"        raise ValueError('x')\\\\\\\"\\\\n   440\\\\t                      \\\\\\\"    finally:\\\\\\\"\\\\n   441\\\\t                      \\\\\\\"        break\\\\\\\"\\\\n   442\\\\t                      \\\\\\\"print('after break')\\\\\\\"\\\\n   443\\\\t                      \\\\\\\"n = 0\\\\\\\"\\\\n   444\\\\t                      \\\\\\\"for i in range(3):\\\\\\\"\\\\n   445\\\\t                      \\\\\\\"    try:\\\\\\\"\\\\n   446\\\\t                      \\\\\\\"        raise KeyError('k')\\\\\\\"\\\\n   447\\\\t                      \\\\\\\"    finally:\\\\\\\"\\\\n   448\\\\t                      \\\\\\\"        n += 1\\\\\\\"\\\\n   449\\\\t                      \\\\\\\"        continue\\\\\\\"\\\\n   450\\\\t                      \\\\\\\"print(n)\\\\\\\"\\\\n   451\\\\t                      \\\\\\\"class NotExc:\\\\\\\"\\\\n   452\\\\t                      \\\\\\\"    pass\\\\\\\"\\\\n   453\\\\t                      \\\\\\\"for v in [1, 'x', NotExc, NotExc()]:\\\\\\\"\\\\n   454\\\\t                      \\\\\\\"    try:\\\\\\\"\\\\n   455\\\\t                      \\\\\\\"        raise v\\\\\\\"\\\\n   456\\\\t                      \\\\\\\"    except TypeError as e:\\\\\\\"\\\\n   457\\\\t                      \\\\\\\"        print('TypeError', e.args[0])\\\\\\\"\\\\n   458\\\\t                      \\\\\\\"try:\\\\\\\"\\\\n   459\\\\t                      \\\\\\\"    raise KeyError('k')\\\\\\\"\\\\n   460\\\\t                      \\\\\\\"except KeyError as err:\\\\\\\"\\\\n   461\\\\t                      \\\\\\\"    pass\\\\\\\"\\\\n   462\\\\t                      \\\\\\\"try:\\\\\\\"\\\\n   463\\\\t                      \\\\\\\"    print(err)\\\\\\\"\\\\n   464\\\\t                      \\\\\\\"except NameError:\\\\\\\"\\\\n   465\\\\t                      \\\\\\\"    print('err unbound')\\\\\\\"\\\\n   466\\\\t                      \\\\\\\"def f():\\\\\\\"\\\\n   467\\\\t                      \\\\\\\"    try:\\\\\\\"\\\\n   468\\\\t                      \\\\\\\"        raise KeyError('k')\\\\\\\"\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_28\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"All four frontends have a concrete divergence from the full contract. Clojure and Python produce the required condition for fresh escaping exceptions at their public entries; JavaScript and PHP lack that hookup. Foreign reception and unchanged protocol-error rethrow also differ. The local tests pin substantial exception behavior, but I found no real-source language pair exercising §8.10.7 propagation.\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_29\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The “same continuation” claim is **false in this snapshot**. Clojure and Python connect fresh escaping exceptions to the supplied raise exit; JavaScript and PHP do not. Foreign reception and protocol-error rethrow also diverge.\\\\n\\\\nRead-only audit of `/Users/sto/workspace/datomworld-f12`, HEAD `e9a0b430`. No files edited; no tests run. Behavioral consequences below are static deductions from the code.\\\\n\\\\n**yang.clojure — DIVERGENT.**\\\\n\\\\n- **Lowering:** `throw` becomes `[:yin.k/error payload]`. `try` examines that outcome and binds its payload to the handler. It accepts exactly one `Exception`/`ExceptionInfo` catch, performs no runtime class discrimination, and rejects `finally`. See [clojure.cljc:904](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:904).\\\\n- **Raise-exit hookup:** the public entry reads `:yang.call/raise` at line 1070 and invokes it with `(yang.call/thrown payload)` at [clojure.cljc:1088](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1088). Fresh public escapes therefore have the specified condition shape.\\\\n- **Private path:** intra-unit calls pass `[compiler-token args]` and receive outcomes directly; authenticated outcome-token calls also bypass public value/raise conversion. See [clojure.cljc:1110](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1110), [clojure.cljc:1486](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1486). Thus its internal exception lowering is an ordinary result channel, unlike the other frontends’ handler continuations.\\\\n- **Foreign reception:** `compile-guest-call` supplies a capture-backed raise closure. A delivered `:yang.call/thrown` becomes an error outcome containing the **raw payload**; another reason becomes an error outcome containing the **whole condition as data**. See [clojure.cljc:1297](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1297). Source catches receive that data. Rethrowing a protocol condition subsequently reaches the public entry’s unconditional `yang.call/thrown`, changing its reason rather than forwarding the original condition.\\\\n- **Root:** `clj/run-main` unwraps successful outcomes and leaves error outcomes as reporting values; it supplies no invocation raise exit. See [clojure/prelude.cljc:87](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure/prelude.cljc:87).\\\\n\\\\n**yang.typescript / JavaScript — DIVERGENT.**\\\\n\\\\n- **Lowering:** `throw` calls `js/throw`; `try/catch` calls `js/try`; an enclosing `finally` calls `js/try-finally`. See [lower.cljc:2165](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/lower.cljc:2165), line 2214.\\\\n- **Local continuation:** `js/try` captures a guest continuation and installs it in `js.rt/ctx`; `js/throw` walks that runtime’s handler/finally stack. These are guest continuations, not host-native `try/catch`. See [prelude.cljc:1704](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1704).\\\\n- **Raise-exit hookup: absent for escaping source exceptions.** The published function entry directly applies `:code`; it neither reads `:yang.call/raise` nor installs a per-activation exception bridge. See [prelude.cljc:1581](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1581). An escaping throw therefore follows existing JS handlers rather than the foreign caller’s supplied exit. With no JS handler, it reaches the `:js/no-handler` expression.\\\\n- **Foreign reception:** `js/call` really does deliver `:yang.call/value` raw through `js/throw`. However, protocol failures become newly constructed `TypeError`s containing only selected text; the original condition is discarded. See [prelude.cljc:1627](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1627). Unchanged protocol-error rethrow cannot recover it.\\\\n- **Root:** `js/run-main` installs a JS root handler and snapshots uncaught values; it does not repair the missing callee bridge. See [prelude.cljc:1850](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1850).\\\\n\\\\n**yang.php — DIVERGENT.**\\\\n\\\\n- **Lowering:** source throws call `php/throw-value`; catches dispatch through local `php/instance-of`; unmatched catches call `php/raise`; `finally` becomes `php/try-finally`. See [lower.cljc:1889](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/lower.cljc:1889), line 3600. `throw-value` requires a local Throwable and then raises it. See [prelude.cljc:4084](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:4084).\\\\n- **Local continuation:** `php/try` captures a guest handler continuation; `php/raise` walks PHP’s handler/finally stack. With an empty stack, `php/raise` **returns the error normally**. See [prelude.cljc:190](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:190).\\\\n- **Raise-exit hookup: absent for source/binding exceptions.** The function entry performs named-argument placement and applies `:code` without an exception bridge. Its supplied raise exit is used only for unsupported binding profiles. See [prelude.cljc:2264](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2264), line 2281. The Closure entry likewise ignores the supplied exit and delegates through `php/call`: [prelude.cljc:4217](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:4217).\\\\n- **Foreign reception:** `php/call`, `call-with-binding-profile`, and `call-named` convert not-callable to a fresh local `Error`; otherwise they call **`php/raise condition`**, without extracting `:yang.call/value`. See [prelude.cljc:2384](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2384), line 4314. Even an original PHP Throwable arriving inside a valid thrown condition is therefore delivered as its envelope, not restored.\\\\n- **`ForeignException`: nowhere.** No wrapper, local hierarchy, or identity-owned retained-condition association exists. `catch (Throwable)` receives no valid local wrapper; explicitly throwing the envelope cannot preserve the original condition.\\\\n- **Root:** `php/run-main` catches through PHP’s local stack and snapshots the result. See [prelude.cljc:5070](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:5070).\\\\n\\\\n**yang.python — DIVERGENT.**\\\\n\\\\n- **Lowering:** `raise X` calls `py/as-exception` then `py/raise`; bare rethrow uses the captured exception directly. Typed clauses use `py/exc-matches`, bare `except` selects its handler unconditionally, and `finally` becomes `py/try-finally`. See [lower.cljc:1664](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/lower.cljc:1664), lines 1699 and 1759.\\\\n- **Local continuation:** `py/try` captures and installs a guest handler, restoring saved context before calling its handler; `py/raise` runs intervening finally frames. See [prelude.cljc:294](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:294).\\\\n- **Raise-exit hookup: present.** `py/function-entry` reads the supplied exit at line 893 and places **both argument binding and body execution** inside `py/try`. Its handler invokes that exit with the required `:yang.call/thrown`/`:yang.call/value` condition. See [prelude.cljc:886](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:886), line 912. Fresh escaping Python exceptions and binding failures follow the intended boundary path.\\\\n- **Foreign reception:** `py/call-kw` delivers every thrown payload directly through `py/raise`, without validating whether it is a local exception or wrapping foreign data. Protocol failures become a generic `TypeError`, losing the condition. See [prelude.cljc:1034](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:1034).\\\\n- **`ForeignException`: nowhere.** Bare `except` can receive raw foreign data, but typed catches use `py/type-of` and the local hierarchy; foreign data has no generated local exception class. Explicit `raise e` applies `py/as-exception` and can replace that foreign payload with a `TypeError`. See [prelude.cljc:352](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:352), lines 754 and 802. There is no wrapper-lifetime condition association to recover in another activation.\\\\n- **Root:** `py/run-main` catches and snapshots through Python’s local stack. See [prelude.cljc:3322](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:3322).\\\\n\\\\n**Local coverage inventory — assertions present, not rerun.**\\\\n\\\\n| Frontend | What its own tests pin |\\\\n|---|---|\\\\n| Clojure | Throw/error outcomes: [clojure_test.clj:1162](/Users/sto/workspace/datomworld-f12/test/yang/clojure_test.clj:1162). Broad admitted catch, nested replacement throw, operand escape, and rejection of `finally`/`Throwable`: [line 2452](/Users/sto/workspace/datomworld-f12/test/yang/clojure_test.clj:2452). Named binding failure emits `:yang.call/thrown`: line 1429. No unchanged-rethrow identity assertion found in these cases. |\\\\n| JavaScript | Object and primitive throws, catch-all, finally on normal/return exits, string rethrow, uncaught exceptions: [e2e_test.clj:254](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/e2e_test.clj:254). Finally ordering/escape cleanup: [prelude_parity_test.cljc:677](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/prelude_parity_test.cljc:677), line 785. Typed catch syntax is inapplicable. |\\\\n| PHP | Throwable hierarchy, typed/multi-type catches, `Throwable` catch-all, unmatched propagation, rethrow, finally/return override and exception replacement: [exceptions_test.clj:19](/Users/sto/workspace/datomworld-f12/test/yang/php/antlr/exceptions_test.clj:19), lines 33, 48 and 63. The test labelled “rethrow keeps the same object” checks its message, **not object identity**. |\\\\n| Python | Typed catches across a local callee, bare rethrow, uncaught errors: [e2e_test.clj:534](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/e2e_test.clj:534), lines 554 and 609. Bare catch-all lowering: [lower_test.clj:197](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/lower_test.clj:197). Finally on every exit, nested cleanup, return override and replacement exception: [e2e_c1_test.clj:30](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/e2e_c1_test.clj:30), lines 62 and 91. Binder condition shape: [call_entry_test.cljc:76](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/call_entry_test.cljc:76). |\\\\n\\\\n**Cross-language evidence: the “zero exception legs” report is confirmed for the checked-in conformance tests.**\\\\n\\\\nThe shared kit composes donor exports and runs caller source; it contains no exception scenario itself: [conformance.clj:245](/Users/sto/workspace/datomworld-f12/test/yang/call/conformance.clj:245). Its real-source consumers in [cross_lang_test.clj:26](/Users/sto/workspace/datomworld-f12/test/yang/cross_lang_test.clj:26), Python’s [source_call_test.clj:9](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/source_call_test.clj:9), and TS/PHP’s [source_call_test.cljc:98](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/source_call_test.cljc:98) exercise successful calls, callbacks, identity and opaque values—not escaping exceptions.\\\\n\\\\nThere **is** a JavaScript reception fixture asserting payload identity after a hand-built entry invokes the supplied raise exit: [prelude_parity_test.cljc:768](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/prelude_parity_test.cljc:768). That is useful helper evidence, but no second frontend compiles the throw. Likewise, shared helper tests construct conditions directly: [call_test.cljc:157](/Users/sto/workspace/datomworld-f12/test/yang/core/call_test.cljc:157).\\\\n\\\\nConsequently, no real-source language pair currently establishes the §8.10.7 propagation contract, including binding-failure propagation, foreign typed/catch-all reception, unchanged/protocol rethrow, finally replacement, A→B→A cleanup and identity, or saved `ForeignException` rethrow from another activation.\\\\n\\\\n**Ranked divergences:**\\\\n\\\\n1. **Missing callee exception bridges in JavaScript and PHP.** Their entries bypass the supplied raise exit for source exceptions; PHP binding failures also occur outside such a bridge. Evidence: JS prelude line 1581; PHP prelude lines 2264 and 4217.\\\\n2. **Missing foreign-exception reception in Python and PHP.** Python raises raw foreign payloads; PHP raises the entire condition envelope. Neither implements `ForeignException` or its lifetime-owned condition association. Evidence: Python prelude line 1034; PHP prelude line 2384.\\\\n3. **Original protocol conditions do not survive unchanged rethrow.** JS/Python discard them while constructing local errors; Clojure retains them as catch data but wraps a rethrow in a new thrown condition; PHP supplies an envelope without a valid local wrapper. Evidence: JS line 1634; Python line 1046; Clojure lines 1306 and 1088; PHP lines 2391 and 4085.\\\\n4. **Clojure has a distinct internal failure channel and restricted catch/finally lowering.** Error vectors and authenticated private calls carry failures as ordinary results before public conversion. Evidence: compiler lines 904, 1110 and 1486.\\\\n\\\\nI found no synthesized engine-effect exception value, guessed foreign class-name matching, or source-map detector that forwards data merely because it looks like a condition. Dispatch on the reason of an actually delivered boundary condition is distinct from that forbidden shape inference.\\\\n\\\\n**Overall verdict: DIVERGENT.**\\\"}}\\n{\\\"type\\\":\\\"turn.completed\\\",\\\"usage\\\":{\\\"input_tokens\\\":1190399,\\\"cached_input_tokens\\\":1069312,\\\"cache_write_input_tokens\\\":0,\\\"output_tokens\\\":10086,\\\"reasoning_output_tokens\\\":2837}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-engineer-exception-ruling-review.gpt-6.1-sol.stdout.log:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba docs/design/yang.antlr.md | sed -n '3560,3770p;3838,3927p;3950,4078p;4105,4150p'\\\"\",\"aggregated_output\":\"  3560\\t```clojure\\n  3561\\t;; Illustrative contents of one task-owned Python function cell.\\n  3562\\t;; `entry` and `body-code` are live Yin closures, not literal AST maps.\\n  3563\\t{:yang.call/entry entry\\n  3564\\t :py/type :function\\n  3565\\t :spec parameter-spec\\n  3566\\t :defaults defaults\\n  3567\\t :code body-code}\\n  3568\\t```\\n  3569\\t\\n  3570\\tThe existing `:code` field is not the shared entry: its signature differs\\n  3571\\tbetween preludes. It may remain private. Cross-language callers must not\\n  3572\\tinspect it or extract it to bypass the entry.\\n  3573\\t\\n  3574\\tA cell-backed callable stores the entry in its cell contents. An\\n  3575\\timmutable callable descriptor, such as a bound method, may carry it\\n  3576\\tdirectly in its map. The common prelude projects the entry structurally:\\n  3577\\tread an existing sealed cell reference through `cell/get`, or inspect\\n  3578\\tthe immutable descriptor, then obtain `:yang.call/entry`. A\\n  3579\\tcell-ref-shaped map is dereferenced only when the heap authenticates it\\n  3580\\t(`cell/authentic?`, section 8.10.12); an unauthenticated shape projects\\n  3581\\tto itself and follows the ordinary descriptor rules, so data imitating\\n  3582\\tthe reference language stays data. The projection must not\\n  3583\\tdispatch on `:py/type`, `:js/type`, `:php/type`, language names, or a\\n  3584\\tregistry of languages.\\n  3585\\t\\n  3586\\tAn admitted callable is a runtime cell/descriptor constructed or exposed\\n  3587\\tby the callable constructors or import/export projections of a pinned,\\n  3588\\tconforming profile. The entry slot is a runtime descriptor field, not a\\n  3589\\tsource property that promotes arbitrary data to a function. A Python\\n  3590\\tdictionary, JavaScript object, or PHP array containing a source key\\n  3591\\tspelled `:yang.call/entry` remains ordinary source data unless an explicit\\n  3592\\tprofile-defined projection makes it a callable descriptor. Source\\n  3593\\tproperty access must not overwrite or masquerade as this runtime slot.\\n  3594\\tThis is an obligation of construction and source resolution, not a new\\n  3595\\tVM type, descriptor seal, or runtime provenance/language registry. Once\\n  3596\\tthe resolved descriptor is admitted, the shared projection is structural;\\n  3597\\tUAST deliberately constructing a conforming descriptor opts into the\\n  3598\\tconvention rather than changing a source language's data-map semantics.\\n  3599\\t\\n  3600\\tMissing entry means not callable. Constructors must install a genuine\\n  3601\\tunary Yin closure, and supported source mutations must preserve that\\n  3602\\tinvariant. Unary arity is a constructor/profile conformance obligation,\\n  3603\\tnot a signature introspection operation: Yin closures are opaque and the\\n  3604\\tVM's existing argument binding does not enforce this convention's arity.\\n  3605\\tA key in a map grants no VM privilege; application, ownership, and\\n  3606\\teffect checks still apply. A non-applicable entry remains an operational\\n  3607\\tVM application defect, not a source exception caught by the shared helper.\\n  3608\\t\\n  3609\\tFor callable kinds whose eligibility can change, the same cell or\\n  3610\\tdescriptor may also contain `:yang.call/eligible?`, a unary Yin predicate\\n  3611\\ton the original callable. Without it, an entry is eligible by default.\\n  3612\\tWith it, the common callable test uses its boolean result. The predicate\\n  3613\\treads explicit runtime metadata/heap only; it must not mutate state,\\n  3614\\tevaluate arguments, execute the target body, or invoke getters/user hooks.\\n  3615\\tIt has the same constructor/arity obligations as the entry. For example,\\n  3616\\tan instance can keep one dispatch entry while eligibility follows whether\\n  3617\\tits class currently supplies a supported call method; changing the class\\n  3618\\tdoes not require rewriting every instance.\\n  3619\\t\\n  3620\\tCall eligibility is tested at the callability-check point required by\\n  3621\\tthe caller's source, not universally before argument evaluation. The\\n  3622\\tentry resolves/rechecks a dynamic target at its source-required dispatch\\n  3623\\tpoint so argument side effects that change eligibility remain visible.\\n  3624\\tStatic callable kinds need no predicate.\\n  3625\\t\\n  3626\\tSource callable designators, such as PHP function-name strings and\\n  3627\\tcallable arrays where supported, are resolved under their source's rules\\n  3628\\tbefore common invocation. They do not gain entry slots merely by being\\n  3629\\tstrings or arrays. Exporting a designator as a first-class callable needs\\n  3630\\tan explicit frontend projection to an admitted descriptor, retaining any\\n  3631\\tsource-required late lookup and receiver semantics. Passing the raw\\n  3632\\tstring or array as data leaves it unchanged; a foreign caller must not\\n  3633\\tguess its language or search an ambient namespace to invoke it. This is\\n  3634\\tsource resolution/projection, not a language-pair wrapper around an\\n  3635\\talready admitted function.\\n  3636\\t\\n  3637\\tCross-language passage must not allocate a replacement function cell.\\n  3638\\tReturned functions retain their original identity, captures, defaults,\\n  3639\\tbound receiver, properties, and static state. A receiving frontend's\\n  3640\\tcallable test follows this common eligibility rule rather than rejecting\\n  3641\\tforeign native tags. Foreign attribute access and type reflection remain\\n  3642\\tprofile-owned; callability grants no general right to interpret another\\n  3643\\truntime's cell layout.\\n  3644\\t\\n  3645\\tCompiler-internal lambdas and host functions do not acquire this\\n  3646\\tconvention merely by being applicable in Yin. A source import exposing\\n  3647\\tone must emit an entry from its declared signature and effect profile.\\n  3648\\tIt must not guess an opaque closure's signature or bypass host-effect\\n  3649\\tand custody rules. Internal helper calls need not construct records.\\n  3650\\t\\n  3651\\t#### 8.10.3 Invocation record\\n  3652\\t\\n  3653\\tThe invocation is an ephemeral in-machine value. These keys are proposed\\n  3654\\tvocabulary, not existing repository APIs:\\n  3655\\t\\n  3656\\t```clojure\\n  3657\\t{:yang.call/callee     f\\n  3658\\t :yang.call/positional [v0 v1 ...]\\n  3659\\t :yang.call/named      [[\\\"name\\\" value] ...]\\n  3660\\t :yang.call/raise      raise-exit\\n  3661\\t ;; Optional: presence means a receiver was supplied, even when nil.\\n  3662\\t :yang.call/receiver   receiver\\n  3663\\t ;; Optional: pinned argument-binding extension, for example locations.\\n  3664\\t :yang.call/binding-profile \\\"<content-address>\\\"}\\n  3665\\t```\\n  3666\\t\\n  3667\\tThe four required fields mean:\\n  3668\\t\\n  3669\\t- `:yang.call/callee`: the original resolved callable, including its\\n  3670\\t  identity. The invocation helper supplies it; an extracted entry must\\n  3671\\t  not be applied to another object's substituted state.\\n  3672\\t- `:yang.call/positional`: a dense ordered vector of evaluated values.\\n  3673\\t  Its length records presence; no missing-argument sentinel is inserted.\\n  3674\\t- `:yang.call/named`: ordered name/value pairs, not a map. Names are\\n  3675\\t  plain text without caller-side case folding or normalization.\\n  3676\\t  Duplicate names remain visible until the callee's binder decides them.\\n  3677\\t- `:yang.call/raise`: this activation's caller-supplied, non-returning\\n  3678\\t  guest exit, accepting the condition in section 8.10.7. It closes over\\n  3679\\t  the caller's continuation and exception machinery, never a host\\n  3680\\t  callback or hidden global handler slot.\\n  3681\\t\\n  3682\\tAn absent receiver differs from one whose value is `nil`, `:py/None`,\\n  3683\\t`:php/null`, `:js/null`, or `:js/undefined`. Empty argument vectors are\\n  3684\\trequired rather than represented by absent keys. Presence must not be\\n  3685\\tinferred from truthiness.\\n  3686\\t\\n  3687\\tThe optional binding profile pins additional argument semantics. It\\n  3688\\tdoes not name the caller's language or select a language-pair bridge.\\n  3689\\tAbsent that extension, arguments are by-value runtime values as in\\n  3690\\tsection 8.10.6. The callee entry compares the supplied profile address\\n  3691\\twith its declared accepted/required binding profiles before acquiring\\n  3692\\treferences or entering the body. An unsupported required profile or a\\n  3693\\tmissing required extension fails there. The pinned profile defines the\\n  3694\\tshape and validation of any extra invocation fields it requires; values\\n  3695\\tin the base vectors alone do not establish a location protocol.\\n  3696\\t\\n  3697\\tThe PHP reference-argument profile is pinned as\\n  3698\\t`sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb`.\\n  3699\\tPHP call sites include it when their declared target has reference\\n  3700\\tparameters; corresponding positional values may then be PHP reference\\n  3701\\tmarkers for caller locations. The PHP entry rejects unknown profile\\n  3702\\taddresses before parameter binding, and only this profile authorizes its\\n  3703\\tbinder to attach a parameter to a caller marker. The markers alone carry\\n  3704\\tno binding authority.\\n  3705\\t\\n  3706\\tConvention revision is pinned by the existing lowering/runtime profiles.\\n  3707\\tIt is not a new canonical AST slot, a per-function language tag, or a\\n  3708\\trepeated version field in every invocation. Incompatible revisions need\\n  3709\\tnew profiles and explicit admission, never entry-shape guessing.\\n  3710\\t\\n  3711\\tThe shared helper validates the record's map shape, required presence,\\n  3712\\tpositional vector, and ordered pairs with text names. The callee entry\\n  3713\\tvalidates extension fields under its admitted binding profile; the shared\\n  3714\\thelper knows no extension-specific representation. A valid caller-owned\\n  3715\\traise exit is established before constructing the record, so structural\\n  3716\\tfailures can be transferred through it. If no valid raise exit exists,\\n  3717\\tthat is an operational wiring failure; do not invent a source exception\\n  3718\\tpath, default missing fields to `nil`, or broadly catch VM application\\n  3719\\terrors. Checking live entry/exit/predicate closure arity is not part of\\n  3720\\tthis validation; constructor fixtures and admission under pinned\\n  3721\\tprofiles establish those obligations.\\n  3722\\t\\n  3723\\t#### 8.10.4 Source semantics at caller and callee\\n  3724\\t\\n  3725\\tThe caller's lowering preserves its source rules for callable resolution,\\n  3726\\targument/receiver evaluation, and spread or unpacking. Evaluate each\\n  3727\\texpression exactly once, in the source-defined order. Errors required\\n  3728\\tbefore argument evaluation must still occur before it. The record holds\\n  3729\\tevaluated values; the callee must not reevaluate source expressions.\\n  3730\\t\\n  3731\\tAfter source resolution, calls use the common projection and application.\\n  3732\\tFor a cell-backed callable, the successful path is schematically:\\n  3733\\t\\n  3734\\t```clojure\\n  3735\\t;; UAST notation after source evaluation/resolution and validation.\\n  3736\\t;; The caller has already established `raise-exit`.\\n  3737\\t(let [entry (get (cell/get f) :yang.call/entry)\\n  3738\\t      invocation (assoc evaluated-arguments\\n  3739\\t                        :yang.call/callee f\\n  3740\\t                        :yang.call/raise raise-exit)]\\n  3741\\t  (entry invocation))\\n  3742\\t```\\n  3743\\t\\n  3744\\tThe shared prelude handles projection and validation for cell-backed and\\n  3745\\timmutable callables. Existing `py/call`, `js/call`, or `php/call` names\\n  3746\\tmay remain as source call-site helpers, but must not reject an admitted\\n  3747\\tforeign callable because its native type tag differs.\\n  3748\\t\\n  3749\\tThe callee entry installs its exception boundary **before parameter\\n  3750\\tbinding**. It owns defaults, arity checks, positional/named/variadic\\n  3751\\tbinding, receiver interpretation, and supported source constraints and\\n  3752\\tcoercions. It then invokes its body using its private lowered signature\\n  3753\\tand captured environment.\\n  3754\\t\\n  3755\\tEntry boilerplate is not an additional source function activation.\\n  3756\\tSource recursion limits, tracing, and safepoint call marks must count the\\n  3757\\toriginal source activation once, not both the entry and its private body\\n  3758\\tas two source calls. Genuine nested source calls remain observable.\\n  3759\\t\\n  3760\\t| Callee example | Interpretation of the same invocation |\\n  3761\\t|---|---|\\n  3762\\t| Python function | Python binding/default/keyword rules and captured module globals. A missing required argument raises the Python binding error. |\\n  3763\\t| JavaScript function | Its receiver mode and argument/default/rest rules. An absent argument yields `undefined` where specified. Nonempty named arguments raise a guest `TypeError`; they are not discarded or converted to a positional object. |\\n  3764\\t| PHP function | Named-parameter, static-state, reference and declared type rules. Function self comes from `:yang.call/callee`, not the JavaScript receiver. |\\n  3765\\t| Further frontend | Its declared binding rules, with no new case in the shared prelude or evaluator. |\\n  3766\\t\\n  3767\\tA Python unbound function does not gain a first positional argument\\n  3768\\tbecause a JavaScript member call supplied a receiver. A bound-method entry\\n  3769\\tsupplies its already-bound self once. An arrow entry retains lexical\\n  3770\\t`this`. Callables that do not use a receiver ignore its presence.\\n  3838\\t#### 8.10.7 Normal return and escaping conditions\\n  3839\\t\\n  3840\\tNormal return is the value of ordinary Yin application. There is no\\n  3841\\textra return continuation, completion packet around each result, or new\\n  3842\\tlanguage-specific return instruction.\\n  3843\\t\\n  3844\\tAn escaping source exception invokes the supplied raise exit with:\\n  3845\\t\\n  3846\\t```clojure\\n  3847\\t{:yang.call/reason :yang.call/thrown\\n  3848\\t :yang.call/value  original-thrown-value}\\n  3849\\t```\\n  3850\\t\\n  3851\\tThis is the argument to an exceptional continuation transfer, not an\\n  3852\\tordinary return. Returning an identical-looking map returns normal data.\\n  3853\\tLikewise, a source program throwing a map with these keys throws that\\n  3854\\tmap as the **payload of a new condition**; its shape is never evidence\\n  3855\\tthat it is already a condition to forward. No engine-effect value is\\n  3856\\tsynthesized.\\n  3857\\t\\n  3858\\tProtocol failures use qualified reasons such as\\n  3859\\t`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\\n  3860\\t`:yang.call/unsupported-binding`, with plain evidence. The caller maps\\n  3861\\tthem to a documented local exception form retaining the complete\\n  3862\\toriginal condition. Callee argument-binding failures retain the actual\\n  3863\\tcallee exception under `:yang.call/thrown`. These reasons do not extend\\n  3864\\t`dao.stream`'s outcome algebra.\\n  3865\\t\\n  3866\\tThe receiving caller interprets an escaping exception as follows:\\n  3867\\t\\n  3868\\t1. A payload valid as an exception in its own runtime retains that\\n  3869\\t   runtime's ordinary catching and identity behavior.\\n  3870\\t2. A runtime permitting arbitrary thrown values, such as JavaScript,\\n  3871\\t   may deliver the original payload directly.\\n  3872\\t3. A runtime requiring exception objects, such as Python or PHP,\\n  3873\\t   represents an otherwise foreign payload with its own\\n  3874\\t   `ForeignException`, retaining the complete condition and original\\n  3875\\t   payload. Catch-all catches this local object. Typed source catches\\n  3876\\t   match its local hierarchy, never guessed foreign class names.\\n  3877\\t\\n  3878\\t`ForeignException` is a proposed prelude-owned type, not a VM type.\\n  3879\\tUnchanged rethrow propagates the original condition without adding\\n  3880\\twrappers. Raising a new exception creates a new condition. Crossing back\\n  3881\\tinto a runtime recognizing the original exception restores its original\\n  3882\\ttype and identity. Formatting a foreign payload must not implicitly\\n  3883\\tinvoke a foreign method.\\n  3884\\t\\n  3885\\tThe runtime associates its generated wrapper's identity with the retained\\n  3886\\tcondition for the wrapper's entire lifetime, separate from source-writable\\n  3887\\tattributes. The association normally lives in private wrapper-cell\\n  3888\\tcontents, or an equivalent task-owned identity structure with the same\\n  3889\\tlifetime. It survives storing or returning the wrapper after the creating\\n  3890\\tcall/catch activation has ended, and remains recoverable when that same\\n  3891\\twrapper is rethrown in another activation. Temporary catch state alone is\\n  3892\\tinsufficient. Reachability/reclamation must retain the condition and its\\n  3893\\tpayload while the wrapper is live, without an ambient registry.\\n  3894\\t\\n  3895\\tThe runtime must not detect wrappers or unwrap arbitrary maps by their\\n  3896\\tkey names. JavaScript may expose raw payloads for\\n  3897\\t`:yang.call/thrown`; its local exception for a protocol failure must still\\n  3898\\tretain that failure's qualified condition. Rethrowing the same generated\\n  3899\\texception forwards that complete condition, including protocol reasons;\\n  3900\\tthrowing an unrelated value creates a new `:yang.call/thrown` condition.\\n  3901\\tSaved activation state refers to this identity-owned association; exiting\\n  3902\\tor restoring a catch does not destroy it.\\n  3903\\t\\n  3904\\tVM application/custody defects and host implementation failures remain\\n  3905\\toperational failures. Do not catch them broadly and relabel them as\\n  3906\\tsource exceptions. Existing explicit stream/module refusals keep their\\n  3907\\tsource mappings under the relevant profiles.\\n  3908\\t\\n  3909\\t#### 8.10.8 Cleanup, re-entry, and suspension\\n  3910\\t\\n  3911\\tEach activation establishes its own exception bridge and saves its\\n  3912\\tcallee runtime's dynamic context. Binding, body, and exit run under that\\n  3913\\tbridge. Before invoking the caller's raise exit, let source catches and\\n  3914\\tcleanup complete and restore saved handler/depth/frame state. Normal\\n  3915\\treturn restores it too. A source `finally` replacing a pending return\\n  3916\\tor exception does so before common propagation under its own rules.\\n  3917\\t\\n  3918\\tIn A-to-B-to-A calls, the innermost activation must not jump to an older\\n  3919\\tA handler past B. Its entry bridge is the boundary: inner A cleanup\\n  3920\\tprecedes B cleanup, which precedes outer A handling. Every activation\\n  3921\\towns its saved state and raise exit, without a single current-foreign-\\n  3922\\thandler cell or ambient dispatcher. Unchanged rethrow preserves the\\n  3923\\tinner exception as specified in section 8.10.7.\\n  3924\\t\\n  3925\\tCleanup runs once per actual exit. Resuming a suspended VM transition\\n  3926\\tmust not repeat parameter binding, argument evaluation, defaults,\\n  3927\\treference acquisition, or completed cleanup. The record, continuations,\\n  3950\\t\\n  3951\\tLinked modules publish code and immutable specifications. Their bodies\\n  3952\\tinstantiate function objects and common entries in the importing task,\\n  3953\\tas section 8.5.6 requires. Install children must not export live function\\n  3954\\tcells. A higher-order result is an ordinary runtime value, not a new\\n  3955\\tlinker publication on each call.\\n  3956\\t\\n  3957\\tLowering/runtime profiles pin the implementation and binding/value\\n  3958\\textensions. Existing dependency/effect/custody checks remain. Type facts\\n  3959\\tstay beside code under `yin.vm.typecheck`, not in lambda language tags.\\n  3960\\tDo not duplicate existing lambda parameters in another persisted\\n  3961\\tauthority over the private body signature.\\n  3962\\t\\n  3963\\tBefore admitting a compiled composition, its profile/dependency\\n  3964\\tdeclarations must establish one compatible convention revision for the\\n  3965\\tentries it exposes. An incompatible revision needs an explicitly pinned\\n  3966\\tprojection or is refused before execution. Neither a common slot name nor\\n  3967\\tan opaque runtime closure proves revision compatibility. No runtime\\n  3968\\tlanguage registry or inspection of captured environments supplies it.\\n  3969\\t\\n  3970\\tChanged entry code changes code identities through the normal encoder.\\n  3971\\tRetain source, lowered UAST, pinned profiles, and projections under\\n  3972\\texisting provenance/unitarity rules. A fast path may omit the record\\n  3973\\tonly after proving equivalent evaluation, binding, foreign callability,\\n  3974\\texceptions, effects, suspension, and identity. Correctness must not\\n  3975\\tdepend on that optimization.\\n  3976\\t\\n  3977\\t#### 8.10.10 Current code and migration\\n  3978\\t\\n  3979\\tThe current code records the gap, not a second normative convention:\\n  3980\\t\\n  3981\\t| Current implementation | Private call path |\\n  3982\\t|---|---|\\n  3983\\t| `yang.python.antlr.prelude` | `py/call-kw` binds arguments and applies the function cell's `:code` to one vector. |\\n  3984\\t| `yang.typescript.antlr.prelude` | `js/call` checks `:js/type :function` and applies `:code` to receiver and argument vector. |\\n  3985\\t| `yang.php.antlr.prelude` | `php/call` applies `:code` to the function cell and argument vector; named/reference handling is separate. |\\n  3986\\t| `test/yang/cross_lang_test.clj` | Demonstrates PHP/TypeScript substrate composition using lookup rewriting and a test-local `js-shaped` wrapper; not proof of this convention. |\\n  3987\\t\\n  3988\\tImplementation proceeds as separately verified changes:\\n  3989\\t\\n  3990\\t1. Supply the shared guest prelude and fixtures for entry discovery,\\n  3991\\t   record validation, and condition transfer, using existing bundled/\\n  3992\\t   linked prelude emitter machinery.\\n  3993\\t2. Add entries to each supported callable constructor and builtin;\\n  3994\\t   preserve source metadata/private code while putting binding and\\n  3995\\t   exception boundaries under the entry. Keep existing source `:call`\\n  3996\\t   safepoint marks on their original source activation, normally the\\n  3997\\t   private body; generated entry/binding boilerplate remains unmarked.\\n  3998\\t   Do not copy a body's source mark onto its entry and count both. A\\n  3999\\t   separately proved instrumentation transformation may relocate a mark\\n  4000\\t   only while preserving its source timing and exactly one activation.\\n  4001\\t3. Route source-resolved calls and callable tests through the convention,\\n  4002\\t   including supported bound methods, callable objects, recursion, and\\n  4003\\t   nested runtime re-entry.\\n  4004\\t4. Integrate explicit export/name projections with module publication\\n  4005\\t   and task-local instantiation; remove test-only language-pair wrappers\\n  4006\\t   from the new conformance paths.\\n  4007\\t5. Pass the acceptance gates before advertising a conforming frontend\\n  4008\\t   revision. Old body signatures must not be mistaken for new entries.\\n  4009\\t\\n  4010\\tA frontend is not conformant while its advertised supported callable\\n  4011\\tkinds need pairwise wrappers. Legacy non-ANTLR frontends gain no claim\\n  4012\\tfrom this proposal; joining later requires the same entry obligations.\\n  4013\\tThere is no implication that current Python, PHP, TypeScript, or a host\\n  4014\\ttarget has completed this migration.\\n  4015\\t\\n  4016\\t#### 8.10.11 Acceptance gates\\n  4017\\t\\n  4018\\tExecute real lowered source bodies, not only synthetic functions with\\n  4019\\tthe expected slot. A harness may compose published exports and namespace\\n  4020\\tprojections explicitly. It must not rewrite call nodes, extract foreign\\n  4021\\t`:code`, or insert test-local language-pair wrappers to make calls work.\\n  4022\\t\\n  4023\\tRequired evidence:\\n  4024\\t\\n  4025\\t- **Local semantics:** existing suites preserve argument order, defaults,\\n  4026\\t  required/extra arguments, keyword errors, receivers, exceptions, and\\n  4027\\t  supported reference/static behavior.\\n  4028\\t- **Direct calls:** each implemented frontend calls every other\\n  4029\\t  conforming frontend through the same mechanism in both directions\\n  4030\\t  with compatible values. Derive the test matrix from admitted\\n  4031\\t  frontends; do not hard-code it into runtime dispatch.\\n  4032\\t- **Higher-order calls:** pass, return, store, recurse, and call back\\n  4033\\t  through received functions. Assert identity and captures without\\n  4034\\t  replacement cells.\\n  4035\\t- **Callable admission:** source data with an entry-spelled property\\n  4036\\t  remains data; profile-constructed descriptors are admitted. Exercise\\n  4037\\t  supported PHP string/array designators both under local resolution and\\n  4038\\t  explicit callable export, preserving required late lookup without\\n  4039\\t  foreign namespace guessing.\\n  4040\\t- **Presence and binding:** distinguish missing from explicit\\n  4041\\t  null/None/undefined; retain duplicate keywords until binding; supply\\n  4042\\t  bound self once; evaluate receiver/spreads/defaults at source-defined\\n  4043\\t  times and counts.\\n  4044\\t- **Dynamic callability:** where supported, an existing instance becomes\\n  4045\\t  eligible after its class gains a call method and ineligible after\\n  4046\\t  deletion. Calls whose arguments change this metadata observe the\\n  4047\\t  correct source-required lookup time without instance rewrapping.\\n  4048\\t- **Opaque values:** round-trip foreign objects, functions, strings,\\n  4049\\t  float64 content, and exact integers unchanged. Assert aliasing and no\\n  4050\\t  silent rounding/null conversion. Unsupported operations yield\\n  4051\\t  documented guest errors.\\n  4052\\t- **References:** absent/incompatible writable-location profiles fail\\n  4053\\t  before reference acquisition and the body, with no reference-induced\\n  4054\\t  writeback. Source-required side effects from evaluating arguments still\\n  4055\\t  occur; rejection must not erase them. Compatible profiles prove\\n  4056\\t  mutation, aliasing, cleanup, and suspension behavior.\\n  4057\\t- **Exceptions:** cover binding failures, arbitrary foreign thrown data,\\n  4058\\t  catch-all/typed catches, unchanged rethrow, replacement in `finally`,\\n  4059\\t  protocol-error rethrow, condition-shaped thrown maps, and A-to-B-to-A\\n  4060\\t  propagation. Assert original exception identity and cleanup order,\\n  4061\\t  not only rendered text. Store/return a generated `ForeignException`,\\n  4062\\t  finish its creating activation, then rethrow it from another activation\\n  4063\\t  and assert recovery of the original condition and payload identity.\\n  4064\\t- **Context lifetime:** repeated success/raise/success, cross-runtime\\n  4065\\t  recursion, and stream suspension/resume restore handler/depth/frame\\n  4066\\t  state and perform arguments/cleanup exactly once. Entry boilerplate\\n  4067\\t  must not double-count source recursion or tracing activations.\\n  4068\\t- **Publication/custody:** bundled/linked forms agree; two importing\\n  4069\\t  tasks have independent state. Existing gates still refuse foreign-task\\n  4070\\t  cells, forged refs, host functions, and inadmissible continuations.\\n  4071\\t- **Portability:** execute portable packet-to-UAST fixtures on JVM,\\n  4072\\t  Node, and Dart over the four VMs wherever existing contracts admit\\n  4073\\t  the program. JVM-only parsers may supply checked-in CST fixtures;\\n  4074\\t  parser availability is distinct from calling conformance.\\n  4075\\t\\n  4076\\tReport callable kinds, binding/value extensions, actual host/VM\\n  4077\\tcoverage as an explicit host-by-VM matrix, refusals, and remaining gaps\\n  4078\\tper frontend revision. A scalar example or common UAST grammar alone\\n  4105\\t  admission/apply machinery); not authentic → ordinary data semantics\\n  4106\\t  (map lookup). The shape remains a cheap pre-filter for WHEN to ask;\\n  4107\\t  it never decides meaning. The shared descriptor projection\\n  4108\\t  (`yang.call/_descriptor`) consults the same way.\\n  4109\\t- **Interim asymmetry (agreed across the four seats).** The frontend\\n  4110\\t  kind predicates that route on a `:type :cell-ref` tag before\\n  4111\\t  dereferencing — TypeScript's `js/cell?` and Python's `py/cell?` —\\n  4112\\t  still test SHAPE alone at this landing; their owning seats sweep\\n  4113\\t  them onto `cell/authentic?` in-lane after this merge (TypeScript:\\n  4114\\t  the `typeof` path and member-call lowering; Python: the three deref\\n  4115\\t  sites — `py/content-type`, type resolution, `py/eq-objects`). Until\\n  4116\\t  those sweeps land, a map imitating the reference language is data\\n  4117\\t  at Clojure positions and at the shared descriptor projection, but\\n  4118\\t  can still abort at the unswept frontend predicates. Nothing\\n  4119\\t  currently-correct changes behavior (the widening property holds);\\n  4120\\t  all-frontends consistency completes at the owning seats' landings.\\n  4121\\t- **Authentication is not authorization.** An authentic reference\\n  4122\\t  whose cell lacks an admitted callable entry is not callable; the\\n  4123\\t  existing not-callable refusal stands. Explicit dereference at a\\n  4124\\t  reference position (`cell/get`) likewise keeps the strict\\n  4125\\t  validation boundary — the data fallback lives in call routing.\\n  4126\\t- **Bearer policy.** An exact copy of a valid reference retains\\n  4127\\t  bearer behavior: it authenticates, therefore it resolves. No\\n  4128\\t  construction-history promises are made for identical values. A\\n  4129\\t  program wanting such a map's fields as data uses explicit lookup at\\n  4130\\t  a data position.\\n  4131\\t- **Bag clarification.** A reference stored in data remains a\\n  4132\\t  reference: storage changes nothing about the value, and what\\n  4133\\t  decides is the authentication query at the eventual call, not where\\n  4134\\t  the callee travelled. Equality survives while callability follows\\n  4135\\t  the heap's answer.\\n  4136\\t- **Entry-key exception.** \\\"Ordinary map application always remains\\n  4137\\t  data\\\" is true for the cell-ref language, not universally: a map\\n  4138\\t  carrying `:yang.call/entry` is convention territory whether it\\n  4139\\t  admits or forges one, and the D2 admission policy (the unadmitted\\n  4140\\t  entry-shaped map refuses) governs it. That policy is the one\\n  4141\\t  declared shape-routed exception and is unchanged by this ruling.\\n  4142\\t- **Static specialization** (a projected-name fast path, say)\\n  4143\\t  remains an optimization requiring proof of equivalence under\\n  4144\\t  shadowing and higher-order use, never the routing default: the\\n  4145\\t  calling contract's pass/return/store/recurse/callback obligations\\n  4146\\t  (8.10.11) bind every specialization.\\n  4147\\t\\n  4148\\t### 8.11 Mutable objects and collections over cells\\n  4149\\t\\n  4150\\tThis section records the mutable-objects ruling. A mutable guest object\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-engineer-exception-ruling-review.gpt-6.1-sol.stdout.log:23:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yang/typescript/antlr/prelude.cljc | sed -n '1550,1765p'; nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '865,920p;1005,1065p'\\\"\",\"aggregated_output\":\"  1550\\t           (if (= k :string)\\n  1551\\t             (js/string-get v key)\\n  1552\\t             (if (if (= k :number) true (if (= k :boolean) true (if (= k :bigint) true (= k :symbol))))\\n  1553\\t               (js/get-prop-r (js/proto-of-primitive v) key v)\\n  1554\\t               (js/throw-type-error\\n  1555\\t                 (js/str-concat\\n  1556\\t                   {:js/str \\\"Cannot read properties of \\\"}\\n  1557\\t                   (js/str-concat\\n  1558\\t                     (js/to-string v)\\n  1559\\t                     (js/str-concat\\n  1560\\t                       {:js/str \\\" (reading '\\\"}\\n  1561\\t                       (js/str-concat (js/to-string key)\\n  1562\\t                                      {:js/str \\\"')\\\"}))))))))))]\\n  1563\\t\\n  1564\\t\\n  1565\\t    ;; ------------------------------------------------------------ functions\\n  1566\\t    ;; A function cell holds {:js/type :function :code 