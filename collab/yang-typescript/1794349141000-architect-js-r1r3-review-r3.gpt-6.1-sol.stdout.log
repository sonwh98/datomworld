\\\\n  1899\\\\t                     types)\\\\n  1900\\\\t        body (lower ctx (first (core/rules ctx clause \\\\\\\"blockStatement\\\\\\\")))]\\\\n  1901\\\\t    (u/if-node test\\\\n  1902\\\\t               (if var\\\\n  1903\\\\t                 (u/then (write-var ctx var e) body)\\\\n  1904\\\\t                 (u/then (app* 'php/delref e) body))\\\\n  1905\\\\t               rest)))\\\\n  1906\\\\t\\\\n  1907\\\\t\\\\n  1908\\\\t(defn- lower-try\\\\n  1909\\\\t  \\\\\\\"`try { } catch (T $e) { } finally { }`: `php/try` delivers the error to the\\\\n  1910\\\\t   catch clauses in order, an unmatched one is raised again; `php/try-finally`\\\\n  1911\\\\t   runs the finally block on every exit, escapes and errors included.\\\\\\\"\\\\n  1912\\\\t  [ctx n]\\\\n  1913\\\\t  (let [block (first (core/rules ctx n \\\\\\\"blockStatement\\\\\\\"))\\\\n  1914\\\\t        clauses (core/rules ctx n \\\\\\\"catchClause\\\\\\\")\\\\n  1915\\\\t        fin (first (core/rules ctx n \\\\\\\"finallyStatement\\\\\\\"))\\\\n  1916\\\\t        e (core/gen \\\\\\\"e\\\\\\\" n)\\\\n  1917\\\\t        mark (core/gen \\\\\\\"mk\\\\\\\" n)\\\\n  1918\\\\t        body (lower ctx block)\\\\n  1919\\\\t        guarded (if (seq clauses)\\\\n  1920\\\\t                  (u/let1 mark\\\\n  1921\\\\t                          (app* 'php/tmp-mark)\\\\n  1922\\\\t                          (app* 'php/try\\\\n  1923\\\\t                                (u/lam [] body)\\\\n  1924\\\\t                                (u/lam [e]\\\\n  1925\\\\t                                       (u/then (app* 'php/release-tmps (u/v mark))\\\\n  1926\\\\t                                               (reduce (fn [rest clause]\\\\n  1927\\\\t                                                         (catch-clause-node ctx (u/v e) clause rest))\\\\n  1928\\\\t                                                       (app* 'php/raise (u/v e))\\\\n  1929\\\\t                                                       (reverse clauses))))\\\\n  1930\\\\t                                (u/lam [] (u/lit :php/null))))\\\\n  1931\\\\t                  body)]\\\\n  1932\\\\t    (u/then (if fin\\\\n  1933\\\\t              (app* 'php/try-finally\\\\n  1934\\\\t                    (u/lam [] guarded)\\\\n  1935\\\\t                    (u/lam [(core/gen \\\\\\\"x\\\\\\\" n)]\\\\n  1936\\\\t                           (lower ctx (first (core/rules ctx fin \\\\\\\"blockStatement\\\\\\\")))))\\\\n  1937\\\\t              guarded)\\\\n  1938\\\\t            (u/lit :php/null))))\\\\n  1939\\\\t\\\\n  1940\\\\t\\\\n  1941\\\\t(defn- lower-match\\\\n  1942\\\\t  \\\\\\\"`match (e) { a, b => r, default => d }`: strict comparison in order, the\\\\n  1943\\\\t   default last, else `UnhandledMatchError`.\\\\\\\"\\\\n  1944\\\\t  [ctx n]\\\\n  1945\\\\t  (let [subject (first (core/rules ctx n \\\\\\\"expression\\\\\\\"))\\\\n  1946\\\\t        m (core/gen \\\\\\\"m\\\\\\\" n)\\\\n  1947\\\\t        items (core/rules ctx n \\\\\\\"matchItem\\\\\\\")\\\\n  1948\\\\t        default? (fn [item]\\\\n616:    :else (app* 'php/throw-error (u/lit \\\\\\\"Error\\\\\\\") (u/lit \\\\\\\"Using $this when not in object context\\\\\\\"))))\\\\n1302:      \\\\\\\"Throw\\\\\\\" (app* 'php/throw-value (lower ctx operand))\\\\n1909:  \\\\\\\"`try { } catch (T $e) { } finally { }`: `php/try` delivers the error to the\\\\n1910:   catch clauses in order, an unmatched one is raised again; `php/try-finally`\\\\n1922:                          (app* 'php/try\\\\n1928:                                                       (app* 'php/raise (u/v e))\\\\n1933:              (app* 'php/try-finally\\\\n1987:                   (app* 'php/throw-error\\\\n3204:                           (app* 'php/try-finally\\\\n3210:                   (app* 'php/try-finally\\\\n3600:    \\\\\\\"throwStatement\\\\\\\" (app* 'php/throw-value (lower ctx (first (core/rules ctx n \\\\\\\"expression\\\\\\\"))))\\\\n  1660\\\\t\\\\n  1661\\\\t(declare lower-try-except)\\\\n  1662\\\\t\\\\n  1663\\\\t\\\\n  1664\\\\t(defn- lower-try\\\\n  1665\\\\t  \\\\\\\"`try` with `except` clauses (`py/try`), with `finally` (`py/try-finally`\\\\n  1666\\\\t   around the rest), or both. The finally thunk takes the exception being\\\\n  1667\\\\t   raised through it, or None, and ignores it.\\\\\\\"\\\\n  1668\\\\t  [ctx n]\\\\n  1669\\\\t  (let [ks (kids ctx n)\\\\n  1670\\\\t        blocks (rules ctx n \\\\\\\"block\\\\\\\")]\\\\n  1671\\\\t    (if (some #(p/token? % \\\\\\\"finally\\\\\\\") ks)\\\\n  1672\\\\t      (app* 'py/try-finally\\\\n  1673\\\\t            (u/lam [] (if (seq (rules ctx n \\\\\\\"except_clause\\\\\\\"))\\\\n  1674\\\\t                        (lower-try-except ctx n (pop blocks))\\\\n  1675\\\\t                        (u/seq-nodes (lower-block ctx (first blocks)))))\\\\n  1676\\\\t            (u/lam [(gen \\\\\\\"fx\\\\\\\" n)] (u/seq-nodes (lower-block ctx (peek blocks)))))\\\\n  1677\\\\t      (lower-try-except ctx n blocks))))\\\\n  1678\\\\t\\\\n  1679\\\\t\\\\n  1680\\\\t(defn- lower-with\\\\n  1681\\\\t  \\\\\\\"`with a as x, b:` nests as `with a as x: with b:`; each item is\\\\n  1682\\\\t   `(py/with manager (fn [value] (assign target value) ...))`.\\\\\\\"\\\\n  1683\\\\t  [ctx n]\\\\n  1684\\\\t  (let [items (rules ctx n \\\\\\\"with_item\\\\\\\")\\\\n  1685\\\\t        body (u/seq-nodes (lower-block ctx (first (rules ctx n \\\\\\\"block\\\\\\\"))))]\\\\n  1686\\\\t    (reduce (fn [inner item]\\\\n  1687\\\\t              (let [ik (kids ctx item)\\\\n  1688\\\\t                    v (gen \\\\\\\"wv\\\\\\\" item)]\\\\n  1689\\\\t                (app* 'py/with\\\\n  1690\\\\t                      ((:lower ctx) ctx (first ik))\\\\n  1691\\\\t                      (u/lam [v]\\\\n  1692\\\\t                             (if (p/has-token? (:pk ctx) item \\\\\\\"as\\\\\\\")\\\\n  1693\\\\t                               (u/then (assign-target ctx (last ik) (u/v v)) inner)\\\\n  1694\\\\t                               inner)))))\\\\n  1695\\\\t            body\\\\n  1696\\\\t            (reverse items))))\\\\n  1697\\\\t\\\\n  1698\\\\t\\\\n  1699\\\\t(defn- lower-try-except\\\\n  1700\\\\t  \\\\\\\"`try` with `except` clauses and an optional `else`: `blocks` are the try\\\\n  1701\\\\t   body, one block per clause, then the else block if any.\\\\\\\"\\\\n  1702\\\\t  [ctx n blocks]\\\\n  1703\\\\t  (let [exc (gen \\\\\\\"exc\\\\\\\" n)\\\\n  1704\\\\t        clauses (rules ctx n \\\\\\\"except_clause\\\\\\\")\\\\n  1705\\\\t        body (u/seq-nodes (lower-block ctx (first blocks)))\\\\n  1706\\\\t        handler-blocks (subvec blocks 1 (inc (count clauses)))\\\\n  1707\\\\t        else-block (get blocks (inc (count clauses)))\\\\n  1708\\\\t        hctx (assoc ctx :exc exc)\\\\n  1709\\\\t        dispatch\\\\n  1710\\\\t        (reduce\\\\n  1711\\\\t          (fn [fallthrough [clause block]]\\\\n  1712\\\\t            (let [ck (kids ctx clause)\\\\n  1713\\\\t                  cls-node (first (rules ctx clause \\\\\\\"test\\\\\\\"))\\\\n  1714\\\\t                  as-name (first (rules ctx clause \\\\\\\"name\\\\\\\"))\\\\n  1715\\\\t                  handler (if as-name\\\\n  1716\\\\t                            ;; `except E as e:` binds e for the handler and\\\\n  1717\\\\t                            ;; unbinds it on every exit, as `del e` in a\\\\n  1718\\\\t                            ;; finally would\\\\n  1719\\\\t                            (let [nm (name-of ctx as-name)]\\\\n  1720\\\\t                              (app* 'py/try-finally\\\\n  1721\\\\t                                    (u/lam [] (u/seq-nodes\\\\n  1722\\\\t                                                (cons (assign-name ctx nm (u/v exc))\\\\n  1723\\\\t                                                      (lower-block hctx block))))\\\\n  1724\\\\t                                    (u/lam [(gen \\\\\\\"ux\\\\\\\" clause)] (unbind-name ctx nm))))\\\\n  1725\\\\t                            (u/seq-nodes (lower-block hctx block)))]\\\\n  1726\\\\t              (when (and (nil? cls-node) (> (count ck) 1))\\\\n  1727\\\\t                (unsupported! clause \\\\\\\"except clause\\\\\\\"))\\\\n  1728\\\\t              (if cls-node\\\\n  1729\\\\t                (u/if-node (app* 'py/exc-matches (u/v exc)\\\\n  1730\\\\t                                 ((:lower ctx) ctx cls-node))\\\\n  1731\\\\t                           handler\\\\n  1732\\\\t                           fallthrough)\\\\n  1733\\\\t                handler)))\\\\n  1734\\\\t          (app* 'py/raise (u/v exc))\\\\n  1735\\\\t          (reverse (map vector clauses handler-blocks)))]\\\\n  1736\\\\t    (app* 'py/try\\\\n  1737\\\\t          (u/lam [] body)\\\\n  1738\\\\t          (u/lam [exc] dispatch)\\\\n  1739\\\\t          (u/lam [] (if else-block\\\\n  1740\\\\t                      (u/seq-nodes (lower-block ctx else-block))\\\\n  1741\\\\t                      none)))))\\\\n  1742\\\\t\\\\n  1743\\\\t\\\\n  1744\\\\t(defn- lower-flow\\\\n  1745\\\\t  [ctx n]\\\\n  1746\\\\t  (case (:rule n)\\\\n  1747\\\\t    \\\\\\\"break_stmt\\\\\\\" (if-let [brk (get-in ctx [:loop :brk])]\\\\n  1748\\\\t                   (u/app (u/v brk) none)\\\\n  1749\\\\t                   (syntax! n \\\\\\\"'break' outside loop\\\\\\\"))\\\\n  1750\\\\t    \\\\\\\"continue_stmt\\\\\\\" (if (:loop ctx)\\\\n  1751\\\\t                      (u/app (u/v (get-in ctx [:loop :cont])) none)\\\\n  1752\\\\t                      (syntax! n \\\\\\\"'continue' not properly in loop\\\\\\\"))\\\\n  1753\\\\t    \\\\\\\"return_stmt\\\\\\\" (if-let [ret (:ret ctx)]\\\\n  1754\\\\t                    (u/app (u/v ret)\\\\n  1755\\\\t                           (if-let [value (first (rules ctx n \\\\\\\"testlist\\\\\\\"))]\\\\n  1756\\\\t                             (display ctx value)\\\\n  1757\\\\t                             none))\\\\n  1758\\\\t                    (syntax! n \\\\\\\"'return' outside function\\\\\\\"))\\\\n  1759\\\\t    \\\\\\\"raise_stmt\\\\\\\"\\\\n  1760\\\\t    (let [tests (rules ctx n \\\\\\\"test\\\\\\\")]\\\\n  1761\\\\t      (cond\\\\n  1762\\\\t        (p/has-token? (:pk ctx) n \\\\\\\"from\\\\\\\") (unsupported! n \\\\\\\"raise from\\\\\\\")\\\\n  1763\\\\t        (empty? tests) (if-let [exc (:exc ctx)]\\\\n  1764\\\\t                         (app* 'py/raise (u/v exc))\\\\n  1765\\\\t                         (unsupported! n \\\\\\\"bare raise outside except\\\\\\\"))\\\\n  1766\\\\t        :else (app* 'py/raise (app* 'py/as-exception\\\\n  1767\\\\t                                    ((:lower ctx) ctx (first tests))))))))\\\\n  1768\\\\t\\\\n  1769\\\\t\\\\n  1770\\\\t(def ^:private comprehension-names\\\\n  1771\\\\t  {:list \\\\\\\"list comprehension\\\\\\\", :set \\\\\\\"set comprehension\\\\\\\", :dict \\\\\\\"dict comprehension\\\\\\\",\\\\n  1772\\\\t   :genexp \\\\\\\"generator expression\\\\\\\"})\\\\n     1\\\\t(ns yang.clojure.prelude\\\\n     2\\\\t  \\\\\\\"The `clj` runtime module (docs/design/yang.antlr.md section 8.10):\\\\n     3\\\\t   the published linker module every linked clojure program requires, as\\\\n     4\\\\t   `js`, `php` and `py` are for their frontends. It is written in prelude\\\\n     5\\\\t   notation and emitted with the same core machinery those preludes use;\\\\n     6\\\\t   it never runs on the host.\\\\n     7\\\\t\\\\n     8\\\\t   Three surfaces, mirroring the other runtimes:\\\\n     9\\\\t\\\\n    10\\\\t   - the entry, `clj/run-main`: initialize the runtime state, run the\\\\n    11\\\\t     unit — the thunk `yang.clojure/lower-unit` lowered — and answer the\\\\n    12\\\\t     program's value with the outcome model's `[:yin.k/ok value]`\\\\n    13\\\\t     wrapper removed, since that wrapper is frontend-internal. The\\\\n    14\\\\t     entry does not reset the global namespace: the namespace lives for\\\\n    15\\\\t     the task, so a projection the composition bound between two\\\\n    16\\\\t     entries and a definition an earlier unit published both survive\\\\n    17\\\\t     into the next unit's run (as `js/run-main` leaves `globalThis`\\\\n    18\\\\t     standing);\\\\n    19\\\\t   - the runtime global namespace, `clj/define-global!` and\\\\n    20\\\\t     `clj/global-get`: a task-local map in a cell (`clj.rt/globals`,\\\\n    21\\\\t     allocated once per task by `clj/init!`), keyed by export name. A\\\\n    22\\\\t     program's top-level definitions land here through its unit's own\\\\n    23\\\\t     publishing, and the conformance helper's export projection reads\\\\n    24\\\\t     and writes it — the one binding a linked unit reads a projected or\\\\n    25\\\\t     defined name through. A definition a unit runs publishes after\\\\n    26\\\\t     any projection of the same name and shadows it. The JS\\\\n    27\\\\t     `globalThis` table, the PHP named-function table and the Python\\\\n    28\\\\t     module dictionary are the same seam;\\\\n    29\\\\t   - admission, `admit`: the registry surface a linked clojure composition\\\\n    30\\\\t     needs beside the others — the `kind` module and the `portable`\\\\n    31\\\\t     adapters of the data exports the guest library's collection\\\\n    32\\\\t     predicates read.\\\\n    33\\\\t\\\\n    34\\\\t   The module pins the shared calling runtime (`yang.call`) at the\\\\n    35\\\\t   convention's call-address, as the other runtimes do, and refuses before\\\\n    36\\\\t   anything is published when a free name nothing supplies is read.\\\\\\\"\\\\n    37\\\\t  (:require [yang.core.prelude :as core]\\\\n    38\\\\t            [yang.clojure :as yang]\\\\n    39\\\\t            [yin.vm :as vm]\\\\n    40\\\\t            [yin.vm.data :as data]\\\\n    41\\\\t            [yin.vm.module :as module]))\\\\n    42\\\\t\\\\n    43\\\\t\\\\n    44\\\\t(def module-name\\\\n    45\\\\t  \\\\\\\"The linker module name of the clojure runtime.\\\\\\\"\\\\n    46\\\\t  'clj)\\\\n    47\\\\t\\\\n    48\\\\t\\\\n    49\\\\t(def runtime-keys\\\\n    50\\\\t  \\\\\\\"Every runtime key, each with an `:clj/uninit` placeholder at module\\\\n    51\\\\t   level so every read is discharged before `clj/init!` allocates the\\\\n    52\\\\t   real cell. They stay qualified: internal store keys, never guest\\\\n    53\\\\t   names.\\\\\\\"\\\\n    54\\\\t  '[clj.rt/state clj.rt/globals])\\\\n    55\\\\t\\\\n    56\\\\t\\\\n    57\\\\t(def definitions\\\\n    58\\\\t  \\\\\\\"The module's definition list, in prelude notation (the module's own\\\\n    59\\\\t   `clj/` prefix is stripped on emit).\\\\\\\"\\\\n    60\\\\t  '[;; ------------------------------------------------- state and namespace\\\\n    61\\\\t    [clj/init!\\\\n    62\\\\t     (fn []\\\\n    63\\\\t       (if (= clj.rt/state :clj/uninit)\\\\n    64\\\\t         (do (yin/def (quote clj.rt/globals) (cell/new {}))\\\\n    65\\\\t             (yin/def (quote clj.rt/state) :clj/ready))\\\\n    66\\\\t         :clj/ready))]\\\\n    67\\\\t    ;; the runtime global namespace: one task-local map in a cell, keyed by\\\\n    68\\\\t    ;; export name. `clj/define-global!` answers the value, so a publish\\\\n    69\\\\t    ;; sequence can chain through it.\\\\n    70\\\\t    [clj/define-global!\\\\n    71\\\\t     (fn [name value]\\\\n    72\\\\t       (do (cell/set! clj.rt/globals\\\\n    73\\\\t                      (assoc (cell/get clj.rt/globals) name value))\\\\n    74\\\\t           value))]\\\\n    75\\\\t    [clj/global-get\\\\n    76\\\\t     (fn [name]\\\\n    77\\\\t       (if (data/contains? (cell/get clj.rt/globals) name)\\\\n    78\\\\t         (get (cell/get clj.rt/globals) name)\\\\n    79\\\\t         :clj/unbound))]\\\\n    80\\\\t\\\\n    81\\\\t    ;; ------------------------------------------------------------- entry\\\\n    82\\\\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\\\\n    83\\\\t    ;; internal, so the entry removes one wrapper level from the\\\\n    84\\\\t    ;; program's value (a program returning that vector as data was\\\\n    85\\\\t    ;; wrapped again, so one level is exact). An error outcome passes\\\\n    86\\\\t    ;; through as the failure value for the caller to render.\\\\n    87\\\\t    [clj/unwrap-outcome\\\\n    88\\\\t     (fn [value]\\\\n    89\\\\t       (if (if (data/vector? value) (= (data/count value) 2) false)\\\\n    90\\\\t         (if (= (data/nth value 0) :yin.k/ok)\\\\n    91\\\\t           (data/nth value 1)\\\\n    92\\\\t           value)\\\\n    93\\\\t         value))]\\\\n    94\\\\t    ;; The global namespace is the task's, not the entry's: no reset\\\\n    95\\\\t    ;; here, so projections and earlier units' definitions survive.\\\\n    96\\\\t    [clj/run-main\\\\n    97\\\\t     (fn [body]\\\\n    98\\\\t       (do (clj/init!)\\\\n    99\\\\t           (clj/unwrap-outcome (body))))]])\\\\n   100\\\\t\\\\n   101\\\\t\\\\n   102\\\\t(def module-definitions\\\\n   103\\\\t  \\\\\\\"The module's definition list: an `:clj/uninit` placeholder for every\\\\n   104\\\\t   runtime key, then every definition, stripped.\\\\\\\"\\\\n   105\\\\t  (core/module-definitions \\\\\\\"clj\\\\\\\" :clj/uninit runtime-keys definitions))\\\\n   106\\\\t\\\\n   107\\\\t\\\\n   108\\\\t(def module-uast\\\\n   109\\\\t  \\\\\\\"The module tree: one wide application over the definitions, so every\\\\n   110\\\\t   sibling and runtime key read is discharged at module level.\\\\\\\"\\\\n   111\\\\t  (core/module-tree module-definitions []))\\\\n   112\\\\t\\\\n   113\\\\t\\\\n   114\\\\t(def module-exports\\\\n   115\\\\t  \\\\\\\"The module's exports: every `clj/` key of the definition list, stripped.\\\\\\\"\\\\n   116\\\\t  (core/exports \\\\\\\"clj\\\\\\\" definitions))\\\\n   117\\\\t\\\\n   118\\\\t\\\\n   119\\\\t(def ^:private module-free-names\\\\n   120\\\\t  \\\\\\\"The names the module tree reads and does not define, sorted: the host\\\\n   121\\\\t   exports its manifest must declare.\\\\\\\"\\\\n   122\\\\t  (core/free-name-vec module-uast))\\\\n   123\\\\t\\\\n   124\\\\t\\\\n   125\\\\t(defn module-spec\\\\n   126\\\\t  \\\\\\\"`yin.vm.linker.publish/publish-module!`'s spec for the module `clj` over\\\\n   127\\\\t   the host registry `registry`, pinned to the published `yang.call`\\\\n   128\\\\t   module at `call-address` — the convention's call-address, as every\\\\n   129\\\\t   runtime's publication carries. A free name nothing supplies is refused\\\\n   130\\\\t   before anything is published. This namespace emits; it never publishes.\\\\\\\"\\\\n   131\\\\t  [registry call-address]\\\\n   132\\\\t  (core/module-spec {:module-name module-name,\\\\n   133\\\\t                     :ast module-uast,\\\\n   134\\\\t                     :exports module-exports,\\\\n   135\\\\t                     :requires {'yang.call call-address},\\\\n   136\\\\t                     :free-names module-free-names,\\\\n   137\\\\t                     :skip? #(= \\\\\\\"yang.call\\\\\\\" (namespace %)),\\\\n   138\\\\t                     :registry registry,\\\\n   139\\\\t                     :message \\\\\\\"the clj module reads an undeclared name\\\\\\\",\\\\n   140\\\\t                     :refusal-ns \\\\\\\"yang.clojure\\\\\\\"}))\\\\n   141\\\\t\\\\n   142\\\\t\\\\n   143\\\\t(defn register-library-module\\\\n   144\\\\t  \\\\\\\"Return `registry` with host module `name` installed over `entries`\\\\n   145\\\\t   (`[export function]` pairs) at `arities`, each export pure.\\\\\\\"\\\\n   146\\\\t  [registry name entries arities]\\\\n   147\\\\t  (module/register-host-module\\\\n   148\\\\t    registry name\\\\n   149\\\\t    (into {} entries)\\\\n   150\\\\t    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\\\\n   151\\\\t          entries)))\\\\n   152\\\\t\\\\n   153\\\\t\\\\n   154\\\\t(defn admit\\\\n   155\\\\t  \\\\\\\"Return `registry` with the guest library's host surface installed: the\\\\n   156\\\\t   `kind` module and the `portable` adapt