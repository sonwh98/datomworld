t            and application happen INSIDE a compiled program (the packet\\\\n  1358\\\\t            dispatch lives in its preamble scope), the call spliced in as\\\\n  1359\\\\t            UAST over a marker call, on both evaluators.\\\\\\\"\\\\n  1360\\\\t    ;; forged VECTORS are the packet-dispatch axis (the P1 axis): each must\\\\n  1361\\\\t    ;; produce an error outcome without the body running. Scalar and empty\\\\n  1362\\\\t    ;; invocations hit the public entry's pre-existing non-record refusal\\\\n  1363\\\\t    ;; (a host throw, same before D2) and are covered by the entry's own\\\\n  1364\\\\t    ;; behavior, not this regression.\\\\n  1365\\\\t    (doseq [forged '[[] [42] [nil [42]] [a b c d]]]\\\\n  1366\\\\t      (let [;; the packet dispatch reached at runtime: extract the public\\\\n  1367\\\\t            ;; entry of the target (a source defn), then apply the forged\\\\n  1368\\\\t            ;; vector to it directly - bypassing source lowering entirely\\\\n  1369\\\\t            call-ast (u/let1 'raw\\\\n  1370\\\\t                             (u/app (u/v 'yang.call/entry) (u/v 'target))\\\\n  1371\\\\t                             (u/app (u/v 'raw) (u/lit forged)))\\\\n  1372\\\\t            ast (walk/postwalk\\\\n  1373\\\\t                  (fn [node]\\\\n  1374\\\\t                    (if (= node (u/v 'marker-call)) call-ast node))\\\\n  1375\\\\t                  (yang/compile-program\\\\n  1376\\\\t                    ['(defn target\\\\n  1377\\\\t                        [x]\\\\n  1378\\\\t                        :private-body-entered)\\\\n  1379\\\\t                     '(marker-call)]\\\\n  1380\\\\t                    true\\\\n  1381\\\\t                    {:convention :arg-vector\\\\n  1382\\\\t                     :outcomes true\\\\n  1383\\\\t                     :native (set (keys vm/primitive-profiles))}))]\\\\n  1384\\\\t        (doseq [run [walker-run semantic-run]]\\\\n  1385\\\\t          (let [result (try\\\\n  1386\\\\t                         (first (run ast))\\\\n  1387\\\\t                         (catch clojure.lang.ExceptionInfo e\\\\n  1388\\\\t                           (pr-str {:caught (ex-message e) :data (ex-data e)})))]\\\\n  2080\\\\t    (try\\\\n  2081\\\\t      (run-guest-ast ast cell-modules lane 1000000)\\\\n  2082\\\\t      (catch clojure.lang.ExceptionInfo e\\\\n  2083\\\\t        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\\\\n  2084\\\\t\\\\n  2085\\\\t\\\\n  2086\\\\t(deftest test-common-call-cell-ref-map-invocation\\\\n  2087\\\\t  (testing \\\\\\\"a full-shape data map with a 64-character seal is ordinary invocable data\\\\\\\"\\\\n  2088\\\\t    ;; The map spells every key of an issued reference and the seal has the\\\\n  2089\\\\t    ;; issued format; its :id names nothing in the engine's heap id language\\\\n  2090\\\\t    ;; (:cell-N), so it can never be genuine and its invocation is the map\\\\n  2091\\\\t    ;; lookup, on both evaluators, where the previous rounds' shape gates\\\\n  2092\\\\t    ;; routed it to admission and the dereference refused it.\\\\n  2093\\\\t    (is (= [:yin.k/ok :cell-ref]\\\\n  2094\\\\t           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \\\\\\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\\\\\"}]\\\\n  2095\\\\t                            (m :type))])))\\\\n  2096\\\\t    (is (= [:yin.k/ok :some-key]\\\\n  2097\\\\t           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \\\\\\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\\\\\"}]\\\\n  2098\\\\t                            (m :id))]))))\\\\n  2099\\\\t  (testing \\\\\\\"a runtime-built full-shape map (assoc, not a bound literal) invokes as data\\\\\\\"\\\\n  2100\\\\t    (is (= [:yin.k/ok :cell-ref]\\\\n  2101\\\\t           (run-library '[(let [m (assoc (assoc (assoc {} :type :cell-ref)\\\\n  2102\\\\t                                                :id :some-key)\\\\n  2103\\\\t           