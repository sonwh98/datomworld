t-test\\\\n   217\\\\t  (testing \\\\\\\"js/kind-of over a cell-backed foreign callable is :function\\\\\\\"\\\\n   218\\\\t    (is (= {:js/out [\\\\\\\"function\\\\\\\"], :js/uncaught nil}\\\\n   219\\\\t           (xl/call [:python \\\\\\\"def py_fn(x):\\\\\\\\n    return x + 1\\\\\\\\n\\\\\\\"]\\\\n   220\\\\t                    [\\\\\\\"py_fn\\\\\\\"]\\\\n   221\\\\t                    [:typescript \\\\\\\"console.log(typeof py_fn);\\\\\\\"])))))\\\\n   222\\\\t\\\\n   223\\\\t\\\\n   224\\\\t(deftest limits-test\\\\n   225\\\\t  (testing \\\\\\\"a PHP array returned to TS is an opaque handle, usable in PHP\\\\\\\"\\\\n   226\\\\t    (let [src \\\\\\\"<?php function phpfn($a = 7) { return $a === 7 ? [1, 2, 3] : count($a); }\\\\\\\"]\\\\n   227\\\\t      ;; the PHP int `count` returns reaches TS as an integer (`3n`), not a\\\\n   228\\\\t      ;; JS number: the two preludes keep their own number kinds\\\\n   229\\\\t      (is (= {:js/out [\\\\\\\"3n\\\\\\\"], :js/uncaught nil}\\\\n   230\\\\t             (xl/call [:php src]\\\\n   231\\\\t                      [\\\\\\\"phpfn\\\\\\\"]\\\\n   232\\\\t                      [:typescript \\\\\\\"const h = phpfn(); console.log(phpfn(h));\\\\\\\"])))))\\\\n   233\\\\t  (testing \\\\\\\"PHP null is neither JS null nor undefined\\\\\\\"\\\\n   234\\\\t    (let [src \\\\\\\"<?php function phpfn() { return null; }\\\\\\\"]\\\\n   235\\\\t      (is (= {:js/out [\\\\\\\"false false\\\\\\\"], :js/uncaught nil}\\\\n   236\\\\t             (xl/call [:php src]\\\\n   237\\\\t                      [\\\\\\\"phpfn\\\\\\\"]\\\\n   238\\\\t                      [:typescript\\\\n   239\\\\t                       \\\\\\\"const n = phpfn(); console.log(n === null, n === undefined);\\\\\\\"]))))))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_13\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba src/cljc/yang/ph