          (if (or (and (map? v) (contains? v :type)) (vector? v))\n  3219\t                  (assoc n k (globals-child v names bound))\n  3220\t                  n)))\n  3221\t            node (keys node))))\n  3222\t\n  3223\t\n  3224\t(defn lower-unit\n  3225\t  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n  3226\t   thunk whose call runs the program — `forms` plus the definitions of\n  3227\t   the guest library they need, compiled unmodified under `unit-opts`\n  3228\t   and published to the runtime global namespace by\n  3229\t   `publish-to-globals` — so the helper's export projection can read\n  3230\t   each top-level definition. The two-argument form also takes the\n  3231\t   projected `exports` (names the composition already bound in the\n  3232\t   runtime global namespace): their free reads publish the same way, so\n  3233\t   the projection is the caller's binding for them. The program's own\n  3234\t   `yang.call` call sites need no free-name declaration: the convention\n  3235\t   preamble `compile-program` emits defines those names locally, and\n  3236\t   the donor publication pins the `yang.call` module for the qualified\n  3237\t   reads that remain.\"\n  3238\t  ([forms] (lower-unit forms []))\n  3239\t  ([forms exports]\n  3240\t   (let [source (vec forms)\n  3241\t         library (library-for source)\n  3242\t         program (compile-program (concat source library) true unit-opts)\n  3243\t         macros (into #{}\n  3244\t                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n  3245\t                            (map (comp strip-symbol-meta second)))\n  3246\t                      (concat source library))\n  3247\t         names (reduce disj\n  3248\t                       (into (set (top-level-names source))\n  3249\t                             (concat (map (comp strip-symbol-meta second) library)\n  3250\t                                     (map symbol exports)))\n  3251\t              