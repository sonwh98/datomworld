aration: the convention\\\\n  3002\\\\t   preamble `compile-program` emits defines those names locally, and\\\\n  3003\\\\t   the donor publication pins the `yang.call` module for the qualified\\\\n  3004\\\\t   reads that remain.\\\\\\\"\\\\n  3005\\\\t  ([forms] (lower-unit forms []))\\\\n  3006\\\\t  ([forms exports]\\\\n  3007\\\\t   (let [source (vec forms)\\\\n  3008\\\\t         library (library-for source)\\\\n  3009\\\\t         program (compile-program (concat source library) true unit-opts)\\\\n  3010\\\\t         macros (into #{}\\\\n  3011\\\\t                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\\\\n  3012\\\\t                            (map (comp strip-symbol-meta second)))\\\\n  3013\\\\t                      (concat source library))\\\\n  3014\\\\t         names (reduce disj\\\\n  3015\\\\t                       (into (set (top-level-names source))\\\\n  3016\\\\t                             (concat (map (comp strip-symbol-meta second) library)\\\\n  3017\\\\t                                     (map symbol exports)))\\\\n  3018\\\\t                       macros)]\\\\n  3019\\\\t     (u/lam [] (publish-to-globals program names #{})))))\\\\n  3020\\\\t\\\\n  3021\\\\t\\\\n  3022\\\\t(defn output\\\\n  3023\\\\t  \\\\\\\"The `clj/run-main` value as test data.\\\\\\\"\\\\n  3024\\\\t  [value]\\\\n  3025\\\\t  (pr-str value))\\\\n  1319\\\\t(deftest test-common-call-source-admission\\\\n  1320\\\\t  (doseq [form '[(let [x 5] (x 1))\\\\n  1321\\\\t                 (let [x {:ordinary :map}] (x 1))\\\\n  1322\\\\t                 (let [x {:yang.call/entry 5}] (x 1))\\\\n  1323\\\\t                 (let [x {:py/type :function :code :legacy}] (x 1))\\\\n  1324\\\\t                 (let [x {:yang.call/entry 5}] ((if true x x) 1))\\\\n  1325\\\\t                 (let [x {:yang.call/entry (yang.call/entry f)}] (x 1))\\\\n  1326\\\\t                 (let [x (assoc {} :yang.call/entry (get f :yang.call/entry))] (x 1))\\\\n  1327\\\\t      