6\t\n    37\t(defn declare-free-name\n    38\t  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n    39\t   when `covered` (the requirement-pinned module names) covers it. A name\n    40\t   no `vm/primitives` profile or host export supplies throws, with\n    41\t   `refusal` under `refusal-key` in its data.\"\n    42\t  [refusal-key refusal registry covered n]\n    43\t  (if (and (symbol? n) (some? (namespace n))\n    44\t           (contains? covered (symbol (namespace n))))\n    45\t    nil\n    46\t    (if-let [profile (vm/profile-of vm/primitives n)]\n    47\t      [n profile]\n    48\t      (if-let [address (module/host-export-profile registry n)]\n    49\t        (let [entry (module/module-entry (:modules registry)\n    50\t                                         (symbol (namespace n)))\n    51\t              f (get-in entry [:slice (symbol (name n))])]\n    52\t          [n {:yin.k/profile address,\n    53\t              :yin.k/effects\n    54\t              (get (:callable-effects registry) f #{})}])\n    55\t        (throw (ex-info \"the module reads an undeclared name\"\n    56\t                        {refusal-key refusal, :name n}))))))\n    57\t\n    58\t\n    59\t(defn free-primitives\n    60\t  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n    61\t  [refusal-key refusal registry covered ast]\n    62\t  (let [free (remove (conj (prelude/defined-keys ast) 'yin/def)\n    63\t                     (prelude/free-names ast))]\n    64\t    (into {}\n    65\t          (keep (partial declare-free-name refusal-key refusal registry covered))\n    66\t          (sort-by str free))))\n    67\t\n    68\t\n    69\t(defn module-spec\n    70\t  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n    71\t   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n    72\t   ({module-symbol address}). A free name under a required module is covered\n    73\t   by it; any other is declared as `declare-free-name` does.\"\n    74\t  [refusal-key refusal registry\n    75\t   {:keys [name ast exports runtime-name runtime-address deps]}]\n    76\t  (let [requires (into {runtime-name runtime-address} deps)]\n    77\t    {:name name,\n    78\t     :ast ast,\n    79\t     :exports exports,\n    80\t     :requires requires,\n    81\t     :primitives (free-primitives refusal-key refusal registry\n    82\t                                  (set (keys requires)) ast)}))\n    83\t\n    84\t\n    85\t(defn alias-spec\n    86\t  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n    87\t   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n    88\t   `body-key` exports.\"\n    89\t  [name exports require-profile bundle-name spec-key body-key]\n    90\t  {:name name,\n    91\t   :exports exports,\n    92\t   :primitives {'require require-profile},\n    93\t   :ast (module-tree\n    94\t          [(require-node bundle-name)\n    95\t           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n    96\t           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n    97\t\n    98\t\n    99\t(defn scc-module-specs\n   100\t  \"The SCC publication shape: the `bundle` spec first, then the member alias\n   101\t   specs (each `alias-spec`'s output) in member order.\"\n   102\t  [bundle aliases]\n   103\t  (into [bundle] aliases))\n41:(defn registry\n49:       module/register-cell-module\n","exit_code":0,"status":"completed"}}
