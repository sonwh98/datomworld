'(yang.call/valid-invocation?\n    83\t                           {:yang.call/callee :f\n    84\t                            :yang.call/positional nil\n    85\t                            :yang.call/named []\n    86\t                            :yang.call/raise :exit}))))))\n    87\t  (testing \"invocation-with retains optional fields and cannot replace core fields\"\n    88\t    (is (every? true?\n    89\t                (vals (run-everywhere\n    90\t                        call/uast\n    91\t                        '(let [record\n    92\t                               (yang.call/invocation-with\n    93\t                                 :callee [] [] :exit\n    94\t                                 {:yang.call/receiver nil\n    95\t                                  :yang.call/callee :substitute})]\n    96\t                           (if (= :callee (get record :yang.call/callee))\n    97\t                             (if (data/contains? record :yang.call/receiver)\n    98\t                               (nil? (get record :yang.call/receiver))\n    99\t                               false)\n   100\t                             false))))))))\n   101\t\n   102\t\n   103\t(deftest entry-and-invocation-test\n   104\t  (testing \"descriptor entry, eligibility, original identity and unchanged result\"\n   105\t    (is (every? true?\n   106\t                (vals (run-everywhere\n   107\t                        call/uast\n   108\t                        '(let [callee {:opaque [1 2]}\n   109\t                               descriptor\n   110\t                               (assoc {}\n   111\t                                      :yang.call/entry\n   112\t                                      (fn [inv]\n   113\t                                        (get inv :yang.call/callee)))]\n   114\t                           (yang.call/eligible? descriptor))))))\n   115\t    (let [payload [1 2]]\n   116\t      (is (every? #(= payload %)\n   117\t                  (vals (run-everywhere