 '[(defn f\\\\n  2602\\\\t                                [x]\\\\n  2603\\\\t                                (+ x 100))\\\\n  2604\\\\t                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]\\\\n  2605\\\\t                                (f 1))]\\\\n  2606\\\\t                            library-opts lane 200000)]\\\\n  2607\\\\t        (is (= :yin.k/error tag))\\\\n  2608\\\\t        (is (= :yang.call/not-callable (:yang.call/reason payload))\\\\n  2609\\\\t            \\\\\\\"entry-present forged local map routes to admission and refuses\\\\\\\"))\\\\n  2610\\\\t      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\\\\n  2611\\\\t                            :yang.call/data {:yang.call/callee 5}}]\\\\n  2612\\\\t             (run-library '[(defn f\\\\n  2613\\\\t                              [[f]]\\\\n  2614\\\\t                              (f 1))\\\\n  2615\\\\t                            (f [5])]\\\\n  2616\\\\t                          library-opts lane 200000))\\\\n  2617\\\\t          \\\\\\\"destructured parameter shadows enclosing defn\\\\\\\")\\\\n  2618\\\\t      (is (= [:yin.k/ok 7]\\\\n  2619\\\\t             (run-library '[(defn f\\\\n  2620\\\\t                              [x]\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:24:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_11\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/yang/cross_lang_test.clj | sed -n '1,290p'; rg -n 'cell-ref|yang.call/(eligible\\\\\\\\\\\\\\\\?|invoke|entry)|defn.*call|\\\\\\\\\\\\\\\\[js/call|\\\\\\\\\\\\\\\\[php/call|\\\\\\\\\\\\\\\\[py/call' src/cljc/yang/typescript/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude_p9.cljc src/cljc/yang/python/antlr/prelude.cljc | head -160; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '350,385p'; rg -n 'cell/get|cell/set|cell/new' src/cljc/yin/vm/cell.cljc\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\t(ns yang.cross-lang-test\\\\n     2\\\\t  \\\\\\\"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\\\\n     3\\\\t   bottom out in `:application`, and the engine neither knows nor cares which\\\\n     4\\\\t   frontend minted a closure. A TypeScript function value is called from\\\\n     5\\\\t   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\\\\n     6\\\\t   task, one run.\\\\n     7\\\\t\\\\n     8\\\\t   The seam is explicit published-export composition (8.10.11), owned by\\\\n     9\\\\t   `yang.call.conformance`: the donor source is published as a module and\\\\n    10\\\\t   run unmodified, its named export is read from the donor runtime's global\\\\n    11\\\\t   namespace (`globalThis.ts_fn`, PHP's `phpfn` function) and projected into the caller\\\\n    12\\\\t   runtime's namespace under the same name, and the caller source runs\\\\n    13\\\\t   unmodified. No call node is rewritten and no foreign `:code` extracted:\\\\n    14\\\\t   the caller holds the donor's own function cell, as the identity check\\\\n    15\\\\t   (`stored === phpfn`) shows.\\\\n    16\\\\t\\\\n    17\\\\t   What is pinned as LIMITS (documented expectations, not failures):\\\\n    18\\\\t   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\\\\n    19\\\\t   PHP null (`:php/null`) is neither JS null nor undefined. Each case runs\\\\n    20\\\\t   linked on the three vector VMs, which must agree.\\\\\\\"\\\\n    21\\\\t  (:require\\\\n    22\\\\t    [clojure.test :refer [deftest is testing]]\\\\n    23\\\\t    [yang.call.conformance :as xl]))\\\\n    24\\\\t\\\\n    25\\\\t\\\\n    26\\\\t(deftest ts-closure-called-from-php-test\\\\n    27\\\\t  (testing \\\\\\\"a number crosses as a number: float in, float out\\\\\\\"\\\\n    28\\\\t    (is (= \\\\\\\"4\\\\\\\"\\\\n    29\\\\t           (xl/call [:typescript \\\\\\\"globalThis.ts_fn = (x, y) => x + y;\\\\\\\"]\\\\n    30\\\\t                    [\\\\\\\"ts_fn\\\\\\\"]\\\\n    31\\\\t                    [:php \\\\\\\"<?php echo ts_fn(1.5, 2.5);\\\\\\\"]))))\\\\n    32\\\\t  (testing \\\\\\\"the PHP caller sees the result as an ordinary value\\\\\\\"\\\\n    33\\\\t    (is (= \\\\\\\"yes\\\\\\\"\\\\n    34\\\\t           (xl/call [:typescript \\\\\\\"globalThis.ts_fn = (x, y) => x + y;\\\\\\\"]\\\\n    35\\\\t                    [\\\\\\\"ts_fn\\\\\\\"]\\\\n    36\\\\t                    [:php \\\\\\\"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\\\\\\\"])))))\\\\n    37\\\\t\\\\n    38\\\\t\\\\n    39\\\\t(deftest php-closure-called-from-ts-test\\\\n    40\\\\t  (testing \\\\\\\"TS stores and calls the same PHP function cell it received\\\\\\\"\\\\n    41\\\\t    (is (= {:js/out [\\\\\\\"true 5\\\\\\\"], :js/uncaught nil}\\\\n    42\\\\t           (xl/call [:php \\\\\\\"<?php function phpfn($a, $b) { return $a + $b; }\\\\\\\"]\\\\n    43\\\\t                    [\\\\\\\"phpfn\\\\\\\"]\\\\n    44\\\\t                    [:typescript\\\\n    45\\\\t                     \\\\\\\"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\\\\\\\"])))))\\\\n    46\\\\t\\\\n    47\\\\t\\\\n    48\\\\t(deftest python-calls-typescript-closure-test\\\\n    49\\\\t  (testing \\\\\\\"TS stores and calls the same Python function cell it received\\\\\\\"\\\\n    50\\\\t    (is (= {:py/out [\\\\\\\"22\\\\\\\"], :py/exception nil}\\\\n    51\\\\t           (xl/call [:typescript\\\\n    52\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n    53\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n    54\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n    55\\\\t                    [:python \\\\\\\"print(ts_apply(lambda x: x + 1))\\\\\\\\n\\\\\\\"])))))\\\\n    56\\\\t\\\\n    57\\\\t\\\\n    58\\\\t(deftest typescript-calls-python-closure-test\\\\n    59\\\\t  (testing \\\\\\\"Python stores and calls the same TS function cell it received\\\\\\\"\\\\n    60\\\\t    (is (= {:js/out [\\\\\\\"22n\\\\\\\"], :js/uncaught nil}\\\\n    61\\\\t           (xl/call [:python\\\\n    62\\\\t                     (str \\\\\\\"def py_apply(f):\\\\\\\\n\\\\\\\"\\\\n    63\\\\t                          \\\\\\\"    global stored\\\\\\\\n\\\\\\\"\\\\n    64\\\\t                          \\\\\\\"    stored = f\\\\\\\\n\\\\\\\"\\\\n    65\\\\t                          \\\\\\\"    return f(20) + 1 if stored is f else -1\\\\\\\")]\\\\n    66\\\\t                    [\\\\\\\"py_apply\\\\\\\"]\\\\n    67\\\\t                    [:typescript\\\\n    68\\\\t                     \\\\\\\"console.log(py_apply(x => x + 1n));\\\\\\\"])))))\\\\n    69\\\\t\\\\n    70\\\\t\\\\n    71\\\\t(deftest python-calls-php-closure-test\\\\n    72\\\\t  (testing \\\\\\\"PHP stores and calls the same Python function cell it received\\\\\\\"\\\\n    73\\\\t    (is (= {:py/out [\\\\\\\"22\\\\\\\"], :py/exception nil}\\\\n    74\\\\t           (xl/call [:php\\\\n    75\\\\t                     (str \\\\\\\"<?php function php_apply($f) { global $stored; \\\\\\\"\\\\n    76\\\\t                          \\\\\\\"$stored = $f; return $stored === $f ? $f(20) + 1 : -1; }\\\\\\\")]\\\\n    77\\\\t                    [\\\\\\\"php_apply\\\\\\\"]\\\\n    78\\\\t                    [:python \\\\\\\"print(php_apply(lambda x: x + 1))\\\\\\\\n\\\\\\\"])))))\\\\n    79\\\\t\\\\n    80\\\\t\\\\n    81\\\\t(deftest php-calls-python-closure-test\\\\n    82\\\\t  (testing \\\\\\\"Python stores and calls the same PHP function cell it received\\\\\\\"\\\\n    83\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n    84\\\\t           (xl/call [:python\\\\n    85\\\\t                     (str \\\\\\\"def py_apply(f):\\\\\\\\n\\\\\\\"\\\\n    86\\\\t                          \\\\\\\"    global stored\\\\\\\\n\\\\\\\"\\\\n    87\\\\t                          \\\\\\\"    stored = f\\\\\\\\n\\\\\\\"\\\\n    88\\\\t                          \\\\\\\"    return f(20) + 1 if stored is f else -1\\\\\\\")]\\\\n    89\\\\t                    [\\\\\\\"py_apply\\\\\\\"]\\\\n    90\\\\t                    [:php \\\\\\\"<?php echo py_apply(function($x) { return $x + 1; });\\\\\\\"])))))\\\\n    91\\\\t\\\\n    92\\\\t\\\\n    93\\\\t;; yang.clojure <-> TypeScript, both directions. yang.clojure now publishes\\\\n    94\\\\t;; its runtime module (`clj`: the run-main entry, the task-local global\\\\n    95\\\\t;; namespace and the admission surface, yang.clojure.prelude), so the named\\\\n    96\\\\t;; skip is closed: the helper drives a clojure donor or caller like any\\\\n    97\\\\t;; other admitted frontend, and the same-cell identity check runs here too.\\\\n    98\\\\t\\\\n    99\\\\t\\\\n   100\\\\t(deftest clojure-closure-called-from-typescript-test\\\\n   101\\\\t  (testing \\\\\\\"TS stores and calls the same clojure function cell it received\\\\\\\"\\\\n   102\\\\t    ;; Clojure integers are bare exact integers, the value JS spells as a\\\\n   103\\\\t    ;; BigInt, so the TS callback adds with `1n` and logs `22n`.\\\\n   104\\\\t    (is (= {:js/out [\\\\\\\"true 22n\\\\\\\"], :js/uncaught nil}\\\\n   105\\\\t           (xl/call [:clojure \\\\\\\"(defn clj_apply [f] (+ (f 20) 1))\\\\\\\"]\\\\n   106\\\\t                    [\\\\\\\"clj_apply\\\\\\\"]\\\\n   107\\\\t                    [:typescript\\\\n   108\\\\t                     (str \\\\\\\"const stored = clj_apply; \\\\\\\"\\\\n   109\\\\t                          \\\\\\\"console.log(stored === clj_apply, stored(x => x + 1n));\\\\\\\")])))))\\\\n   110\\\\t\\\\n   111\\\\t\\\\n   112\\\\t(deftest typescript-closure-called-from-clojure-test\\\\n   113\\\\t  (testing \\\\\\\"TS stores and calls the same clojure function cell it received\\\\\\\"\\\\n   114\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n   115\\\\t           (xl/call [:typescript\\\\n   116\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n   117\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n   118\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n   119\\\\t                    [:clojure \\\\\\\"(ts_apply (fn [x] (+ x 1)))\\\\\\\"])))))\\\\n   120\\\\t\\\\n   121\\\\t\\\\n   122\\\\t(deftest clojure-projection-through-runtime-globals-test\\\\n   123\\\\t  (testing \\\\\\\"the projected value is read via clj/global-get inside the caller's run\\\\\\\"\\\\n   124\\\\t    ;; `ts_apply` is no top-level definition of the caller, so its read\\\\n   125\\\\t    ;; inside `apply-it` reaches the runtime global namespace the helper\\\\n   126\\\\t    ;; projected into, not a task-store binding.\\\\n   127\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n   128\\\\t           (xl/call [:typescript\\\\n   129\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n   130\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n   131\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n   132\\\\t                    [:clojure\\\\n   133\\\\t                     \\\\\\\"(defn apply-it [] (ts_apply (fn [x] (+ x 1)))) (apply-it)\\\\\\\"]))))\\\\n   134\\\\t  (testing \\\\\\\"a second clj/run-main entry still sees the earlier unit's globals\\\\\\\"\\\\n   135\\\\t    (is (= \\\\\\\"42\\\\\\\"\\\\n   136\\\\t           (xl/call [:clojure \\\\\\\"(def answer 42)\\\\\\\"]\\\\n   137\\\\t                    [\\\\\\\"answer\\\\\\\"]\\\\n   138\\\\t                    [:clojure \\\\\\\"(defn get-answer [] answer) (get-answer)\\\\\\\"])))))\\\\n   139\\\\t\\\\n   140\\\\t\\\\n   141\\\\t(deftest clojure-caller-shadows-projected-global-test\\\\n   142\\\\t  (testing \\\\\\\"a caller-defined name shadows the projected one\\\\\\\"\\\\n   143\\\\t    ;; The caller's own `shared` runs: its definition publishes after the\\\\n   144\\\\t    ;; projection, so the runtime global holds the caller's function.\\\\n   145\\\\t    (is (= \\\\\\\"21\\\\\\\"\\\\n   146\\\\t           (xl/call [:clojure \\\\\\\"(defn shared [x] (+ x 100))\\\\\\\"]\\\\n   147\\\\t                    [\\\\\\\"shared\\\\\\\"]\\\\n   148\\\\t                    [:clojure \\\\\\\"(defn shared [x] (+ x 1)) (shared 20)\\\\\\\"])))))\\\\n   149\\\\t\\\\n   150\\\\t\\\\n   151\\\\t(deftest clojure-source-cell-ref-map-invocation-test\\\\n   152\\\\t  (testing \\\\\\\"a source map {:type :cell-ref} is ordinary invocable data\\\\\\\"\\\\n   153\\\\t    ;; The donor's exported function invokes its own source map literal:\\\\n   154\\\\t    ;; the map lookup answers 42, where the structural cell test used to\\\\n   155\\\\t    ;; dereference the map as a cell and fail the VM.\\\\n   156\\\\t    (is (= {:js/out [\\\\\\\"42n\\\\\\\"], :js/uncaught nil}\\\\n   157\\\\t           (xl/call [:clojure\\\\n   158\\\\t                     \\\\\\\"(defn probe [] ({:type :cell-ref :marker 42} :marker))\\\\\\\"]\\\\n   159\\\\t                    [\\\\\\\"probe\\\\\\\"]\\\\n   160\\\\t                    [:typescript \\\\\\\"console.log(probe());\\\\\\\"]))))\\\\n   161\\\\t  (testing \\\\\\\"a source map with the full forged cell-ref shape is ordinary invocable data\\\\\\\"\\\\n   162\\\\t    ;; The map spells every key of an issued reference among its own\\\\n   163\\\\t    ;; entries; it is still data, so the lookup answers 42 where key\\\\n   164\\\\t    ;; presence alone used to dereference it and fail the VM.\\\\n   165\\\\t    (is (= {:js/out [\\\\\\\"42n\\\\\\\"], :js/uncaught nil}\\\\n   166\\\\t           (xl/call [:clojure\\\\n   167\\\\t                     \\\\\\\"(defn probe [] ({:type :cell-ref :id :customer :seal \\\\\\\\\\\\\\\"wax\\\\\\\\\\\\\\\" :marker 42} :marker))\\\\\\\"]\\\\n   168\\\\t                    [\\\\\\\"probe\\\\\\\"]\\\\n   169\\\\t                    [:typescript \\\\\\\"console.log(probe());\\\\\\\"]))))\\\\n   170\\\\t  (testing \\\\\\\"a full-shape three-entry map with a valid-format 64-char seal is ordinary invocable data\\\\\\\"\\\\n   171\\\\t    ;; The exact issued format — three entries, a seal string of the issued\\\\n   172\\\\t    ;; length — with an :id the engine's heap could never have minted (heap\\\\n   173\\\\t    ;; ids are :cell-N keywords): the map can never be a reference, so the\\\\n   174\\\\t    ;; invocation is the map lookup and answers the stored seal string,\\\\n   175\\\\t    ;; where the shape gates of the previous rounds routed it to admission\\\\n   176\\\\t    ;; and the dereference refused the VM.\\\\n   177\\\\t    (is (= {:js/out [(str \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\" (apply str (repeat 64 \\\\\\\"a\\\\\\\")) \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\")], :js/uncaught nil}\\\\n   178\\\\t           (xl/call [:clojure\\\\n   179\\\\t                     (str \\\\\\\"(defn probe [] ({:type :cell-ref :id :some-key \\\\\\\"\\\\n   180\\\\t                          \\\\\\\":seal \\\\\\\\\\\\\\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\\\\\\\\\\\\\"} :seal))\\\\\\\")]\\\\n   181\\\\t                    [\\\\\\\"probe\\\\\\\"]\\\\n   182\\\\t                    [:typescript \\\\\\\"console.log(probe());\\\\\\\"]))))\\\\n   183\\\\t  (testing \\\\\\\"a runtime-built full-shape map (assoc-constructed, not a bound literal) invokes as data\\\\\\\"\\\\n   184\\\\t    ;; The map is assembled by assoc at runtime, so no literal ever holds\\\\n   185\\\\t    ;; it; the shape test runs on the constructed value and the lookup\\\\n   186\\\\t    ;; still answers the stored seal string.\\\\n   187\\\\t    (is (= {:js/out [(str \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\" (apply str (repeat 64 \\\\\\\"a\\\\\\\")) \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\")], :js/uncaught nil}\\\\n   188\\\\t           (xl/call [:clojure\\\\n   189\\\\t                     (str \\\\\\\"(defn probe [] (let [m (assoc (assoc (assoc {} :type :cell-ref) \\\\\\\"\\\\