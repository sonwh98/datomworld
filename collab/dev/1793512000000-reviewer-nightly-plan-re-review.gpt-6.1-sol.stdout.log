{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/dev/node_shard.clj'","aggregated_output":"     1\t(ns node-shard\n     2\t  \"Node lane sharded by subsystem (the bb mirror of shard-jvm.sh).\n     3\t\n     4\t   One full shadow-cljs compile (:autorun false), then one\n     5\t   `node target/node-tests.js --test=ns1,ns2,...` process per subsystem, up\n     6\t   to PAR at a time. Selection is RUNTIME: shadow's :ns-regexp compile filter\n     7\t   does not remove previously cached test namespaces from the bundle.\n     8\t\n     9\t   Review fixes (gpt-6.1-sol, 2026-10-31) implemented here:\n    10\t   - R1: every requested namespace is validated against the compiled\n    11\t     bundle's own --list inventory before running (the --test selector\n    12\t     silently ignores unknown namespaces).\n    13\t   - R6: per-run immutable out dir (node-shards-$STAMP, -latest symlink);\n    14\t     expected-vs-completed shard check; nonzero exit on red, missing, or\n    15\t     unexplained shards; prerequisite and compile failures are fatal.\n    16\t   - The Dart peer is built (its absence makes peer tests skip).\n    17\t\n    18\t   Usage: bb src/dev/node_shard.clj <clone-dir> [parallel]\n    19\t   Exit: 0 all green; 1 any failure (infra, missing, or red).\"\n    20\t  (:require [babashka.fs :as fs]\n    21\t            [babashka.process :as p]\n    22\t            [clojure.java.io :as io]\n    23\t            [clojure.set :as set]\n    24\t            [clojure.string :as str]))\n    25\t\n    26\t\n    27\t(def subs\n    28\t  [\"yang.python\" \"yin.repl\" \"yin.vm\" \"yin.vm.ucf\" \"dao.stream\"\n    29\t   \"dao.jing\" \"dao.gui\" \"dao.space\" \"demo\" \"dao.data\"\n    30\t   \"dao.postgraphics\" \"yang.base\" \"dao.base\"])\n    31\t\n    32\t\n    33\t(def ^:private child-path\n    34\t  \"PATH for every child process: mise shims first (npm/node/flutter/bb/clj all\n    35\t   resolve through mise regardless of the caller's ambient PATH), then the\n    36\t   inherited PATH, then the system dirs for env/bash.\"\n    37\t  (str (System/getProperty \"user.home\") \"/.local/share/mise/shims\"\n    38\t       \":/usr/local/bin:/usr/bin:/bin:\"\n    39\t       (System/getenv \"PATH\")))\n    40\t\n    41\t\n    42\t(defn- psh\n    43\t  \"p/shell with the mise-shims PATH forced into the child environment,\n    44\t   merged over any caller-supplied :env.\"\n    45\t  [opts & cmd]\n    46\t  (apply p/shell (update opts :extra-env #(merge {\"PATH\" child-path} %)) cmd))\n    47\t\n    48\t\n    49\t(defn ns->test-ns\n    50\t  \"test/yin/vm/foo_test.cljc -> yin.vm.foo-test (the namespace name).\"\n    51\t  [path]\n    52\t  (-> path\n    53\t      (str/replace #\"^test/\" \"\")\n    54\t      (str/replace #\"\\.clj[cs]$\" \"\")\n    55\t      (str/replace \"/\" \".\")\n    56\t      (str/replace \"_\" \"-\")))\n    57\t\n    58\t\n    59\t(defn cljs-namespaces\n    60\t  \"The cljs test namespaces `bb test:sub:list <s>` reports for subsystem s.\"\n    61\t  [clone s]\n    62\t  (let [{:keys [out]} (psh {:dir clone :out :string :continue true}\n    63\t                           \"bb\" \"test:sub:list\" s)\n    64\t        section (->> (str/split-lines out)\n    65\t                     (rest) ; header \"cljs: N namespaces\" — skip it and keep the indented block\n    66\t                     (take-while #(re-matches #\"^\\s+\\S.*$\" %))\n    67\t                     (map str/trim)\n    68\t                     (remove str/blank?))]\n    69\t    (vec section)))\n    70\t\n    71\t\n    72\t(defn -main\n    73\t  [& args]\n    74\t  (let [clone (or (first args) (System/getProperty \"user.dir\"))\n    75\t        par   (or (some->> (second args) parse-long) 6)\n    76\t        stamp (.format (java.time.format.DateTimeFormatter/ofPattern \"yyyyMMdd-HHmm\")\n    77\t                       (java.time.LocalDateTime/now))\n    78\t        out   (str clone \"/target-ci/node-shards-\" stamp)\n    79\t        rc    (atom 0)\n    80\t        summary (str out \"/summary.txt\")\n    81\t        fail! (fn [msg]\n    82\t                (reset! rc 1)\n    83\t                (println \"FAIL:\" msg)\n    84\t                (spit summary (str \"FAIL: \" msg \"\\n\") :append true))\n    85\t        log   (fn [msg] (println msg) (spit summary (str msg \"\\n\") :append true))\n    86\t        sh    (fn [out-file cmd]\n    87\t                (let [{:keys [exit]} (apply psh {:dir clone, :out (io/writer out-file :append true), :err (io/writer out-file :append true),\n    88\t                                                 :continue true}\n    89\t                                            cmd)]\n    90\t                  exit))]\n    91\t    (fs/create-dirs out)\n    92\t    (fs/delete-if-exists (str clone \"/target-ci/node-shards-latest\"))\n    93\t    (fs/create-sym-link (str clone \"/target-ci/node-shards-latest\")\n    94\t                        (str \"node-shards-\" stamp))\n    95\t    (log (str \"start \" stamp \" par=\" par))\n    96\t    ;; prerequisites — fatal on failure\n    97\t    ;; npm always through mise exec: mise's npm wrapper execs `node` by bare\n    98\t    ;; name, which fails under any caller PATH that lacks the mise node bin\n    99\t    ;; (mise exec supplies it). The repo's mise.toml pins the node version.\n   100\t    (let [exit (sh (str out \"/npm-ci.log\")\n   101\t                   [\"mise\" \"exec\" \"--\" \"npm\" \"ci\" \"--silent\"])]\n   102\t      (log (str \"npm-ci rc=\" exit))\n   103\t      (when-not (zero? exit) (fail! \"npm ci failed\")))\n   104\t    (doseq [[nm cmd] [[\"build-yin-repl-node\" [\"bb\" \"build:yin-repl-node\"]]\n   105\t                      [\"build-yin-repl-peer\" [\"bb\" \"build:yin-repl-peer\"]]\n   106\t                      [\"gen-antlr\" [\"bb\" \"gen:antlr\"]]]]\n   107\t      (let [exit (sh (str out \"/\" nm \".log\") cmd)]\n   108\t        (log (str nm \" rc=\" exit))\n   109\t        (when-not (zero? exit) (fail! (str nm \" failed\")))))\n   110\t    ;; per-subsystem cljs namespaces; the per-run files are the evidence\n   111\t    (let [lists (into {} (map (fn [s] [s (cljs-namespaces clone s)]) subs))\n   112\t          all (->> (file-seq (fs/file (str clone \"/test\")))\n   113\t                   (filter #(re-find #\"_test\\.clj[cs]$\" (str %)))\n   114\t                   (map (comp ns->test-ns str))\n   115\t                   set)\n   116\t          covered (apply set/union (map set (vals lists)))\n   117\t          uncovered (set/difference all covered)\n   118\t          lists (cond-> lists (seq uncovered)\n   119\t                        (assoc \"uncovered\" (vec uncovered)))]\n   120\t      (log (str \"all=\" (count all) \" covered=\" (count covered)\n   121\t                \" uncovered=\" (count uncovered)))\n   122\t      (doseq [[s nss] lists]\n   123\t        (spit (str out \"/ns-\" s \".txt\") (str/join \"\\n\" nss))))\n   124\t    ;; one full compile, no autorun\n   125\t    (let [t0 (System/currentTimeMillis)\n   126\t          exit (sh (str out \"/compile.log\")\n   127\t                   [\"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n   128\t                    \"compile\" \"test\" \"--config-merge\" \"{:autorun false}\"])]\n   129\t      (log (str \"compile-all rc=\" exit\n   130\t                \" secs=\" (quot (- (System/currentTimeMillis) t0) 1000)))\n   131\t      (when-not (zero? exit) (fail! \"compile failed\")))\n   132\t    ;; R1: the bundle's own inventory is the authority on what can run\n   133\t    (let [{:keys [out]} (psh {:dir clone :out :string :continue true}\n   134\t                             \"node\" \"target/node-tests.js\" \"--list\")\n   135\t          bundle (->> (str/split-lines out)\n   136\t                      (keep #(re-find #\"^Namespace: (\\S+)\" %))\n   137\t                      (map second)\n   138\t                      set)\n   139\t          lists (into {}\n   140\t                      (map (fn [s]\n   141\t                             [s (some->> (str out \"/ns-\" s \".txt\")\n   142\t                                         slurp\n   143\t                                         str/split-lines\n   144\t                                         (remove str/blank?)\n   145\t                                         vec)])\n   146\t                           subs))\n   147\t          lists (cond-> lists\n   148\t                  (.exists (fs/file (str out \"/ns-uncovered.txt\")))\n   149\t                  (assoc \"uncovered\"\n   150\t                         (->> (slurp (str out \"/ns-uncovered.txt\"))\n   151\t                              str/split-lines\n   152\t                              (remove str/blank?)\n   153\t                              vec)))\n   154\t          sel (into {} (map (fn [[s nss]] [s (filterv bundle nss)])) lists)\n   155\t          missing (into {}\n   156\t                        (remove (fn [[_ nss]] (empty? nss)))\n   157\t                        (into {}\n   158\t                              (map (fn [[s nss]]\n   159\t                                     [s (set/difference (set nss) bundle)]))\n   160\t                              lists))]\n   161\t      (doseq [[s miss] missing]\n   162\t        (fail! (str \"shard \" s \" requests namespaces absent from the compiled bundle: \"\n   163\t                    (str/join \",\" miss))))\n   164\t      ;; run up to PAR shards at a time (waves)\n   165\t      (let [t0 (System/currentTimeMillis)\n   166\t            shards (vec (filter (comp seq sel) (keys sel)))\n   167\t            runs (atom {})\n   168\t            run-one (fn [s]\n   169\t                      (let [t0 (System/currentTimeMillis)\n   170\t                            {:keys [exit]}\n   171\t                            (psh {:dir clone\n   172\t                                  :out (str out \"/\" s \".log\")\n   173\t                                  :err :append\n   174\t                                  :extra-env {\"DATOM_SLOW_TESTS\" \"1\"}\n   175\t                                  :continue true}\n   176\t                                 \"node\" \"target/node-tests.js\"\n   177\t                                 \"--test\" (str/join \",\" (sel s)))\n   178\t                            secs (quot (- (System/currentTimeMillis) t0) 1000)]\n   179\t                        (swap! runs assoc s {:rc exit :secs secs})\n   180\t                        (spit (str out \"/runs.txt\")\n   181\t                              (str s \" rc=\" exit \" secs=\" secs \"\\n\")\n   182\t                              :append true)))]\n   183\t        (doseq [batch (partition-all par shards)]\n   184\t          (->> batch\n   185\t               (mapv (fn [s] (future (run-one s))))\n   186\t               (mapv deref)))\n   187\t        (let [expected (count shards)\n   188\t              done (count @runs)\n   189\t              red (count (filter #(not= 0 (:rc %)) (vals @runs)))\n   190\t              wall (quot (- (System/currentTimeMillis) t0) 1000)]\n   191\t          (doseq [[s r] (sort @runs)]\n   192\t            (log (str s \" rc=\" (:rc r) \" secs=\" (:secs r))))\n   193\t          (log (str \"node-sharded lanes=\" done \" red-lanes=\" red\n   194\t                    \" wall=\" wall \"s\"))\n   195\t          (when-not (= expected done)\n   196\t            (fail! (str \"expected \" expected \" shards, completed \" done)))\n   197\t          (when (pos? red)\n   198\t            (fail! (str red \" red shards\"))))))\n   199\t    (log (str \"done rc=\" @rc))\n   200\t    (System/exit @rc)))\n   201\t\n   202\t\n   203\t(when (= *file* (System/getProperty \"babashka.file\"))\n   204\t  (apply -main *command-line-args*))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/dev/dart_shard.clj'","aggregated_output":"     1\t(ns dart-shard\n     2\t  \"Dart lane sharded by subsystem (the bb mirror of shard-jvm.sh).\n     3\t\n     4\t   One full cljd compile (per-namespace incremental in lib/cljd-out; cannot\n     5\t   be parallelized in one clone), then per subsystem a shard directory\n     6\t   emitted by cljd_agg.clj (--only / --shard-dir / --no-compile / --no-run),\n     7\t   and ONE `flutter test` invocation over all emitted directories — Flutter's\n     8\t   test compiler writes a project-wide build/test_cache kernel, so parallel\n     9\t   flutter processes in one clone race (gpt-6.1-sol review R3, 2026-10-31).\n    10\t   Per-subsystem attribution survives via the emitted directory paths in the\n    11\t   output.\n    12\t\n    13\t   Review fixes implemented here (R1, R3, R6): the uncovered residual shard\n    14\t   is emitted and run; emission failures are fatal; per-run immutable out\n    15\t   dir (dart-shards-$STAMP, -latest symlink); prerequisite and compile\n    16\t   failures are fatal; nonzero exit on any failure.\n    17\t\n    18\t   Usage: bb src/dev/dart_shard.clj <clone-dir> [concurrency]\n    19\t   Exit: 0 all green; 1 any failure.\"\n    20\t  (:require [babashka.fs :as fs]\n    21\t            [babashka.process :as p]\n    22\t            [clojure.set :as set]\n    23\t            [clojure.string :as str]))\n    24\t\n    25\t\n    26\t(def subs\n    27\t  [\"yang.python\" \"yin.repl\" \"yin.vm\" \"yin.vm.ucf\" \"dao.stream\"\n    28\t   \"dao.jing\" \"dao.gui\" \"dao.space\" \"demo\" \"dao.data\"\n    29\t   \"dao.postgraphics\" \"yang.base\" \"dao.base\"])\n    30\t\n    31\t\n    32\t(def ^:private child-path\n    33\t  \"PATH for every child process: mise shims first (npm/node/flutter/bb/clj all\n    34\t   resolve through mise regardless of the caller's ambient PATH), then the\n    35\t   inherited PATH, then the system dirs for env/bash.\"\n    36\t  (str (System/getProperty \"user.home\") \"/.local/share/mise/shims\"\n    37\t       \":/usr/local/bin:/usr/bin:/bin:\"\n    38\t       (System/getenv \"PATH\")))\n    39\t\n    40\t\n    41\t(defn- psh\n    42\t  \"p/shell with the mise-shims PATH forced into the child environment.\"\n    43\t  [opts & cmd]\n    44\t  (apply p/shell (assoc opts :extra-env {\"PATH\" child-path}) cmd))\n    45\t\n    46\t\n    47\t(defn cljd-namespaces\n    48\t  \"The cljd test namespaces `bb test:sub:list <s>` reports for subsystem s.\"\n    49\t  [clone s]\n    50\t  (let [{:keys [out]} (psh {:dir clone :out :string :continue true}\n    51\t                           \"bb\" \"test:sub:list\" s)\n    52\t        section (->> (str/split-lines out)\n    53\t                     (rest)\n    54\t                     (take-while #(re-matches #\"^\\s+\\S.*$\" %))\n    55\t                     (map str/trim)\n    56\t                     (remove str/blank?))]\n    57\t    (vec section)))\n    58\t\n    59\t\n    60\t(defn -main\n    61\t  [& args]\n    62\t  (let [clone (or (first args) (System/getProperty \"user.dir\"))\n    63\t        conc  (or (some->> (second args) parse-long) 8)\n    64\t        stamp (.format (java.time.format.DateTimeFormatter/ofPattern \"yyyyMMdd-HHmm\")\n    65\t                       (java.time.LocalDateTime/now))\n    66\t        out   (str clone \"/target-ci/dart-shards-\" stamp)\n    67\t        rc    (atom 0)\n    68\t        summary (str out \"/summary.txt\")\n    69\t        fail! (fn [msg]\n    70\t                (reset! rc 1)\n    71\t                (println \"FAIL:\" msg)\n    72\t                (spit summary (str \"FAIL: \" msg \"\\n\") :append true))\n    73\t        log   (fn [msg] (println msg) (spit summary (str msg \"\\n\") :append true))]\n    74\t    (fs/create-dirs out)\n    75\t    (fs/delete-if-exists (str clone \"/target-ci/dart-shards-latest\"))\n    76\t    (fs/create-sym-link (str clone \"/target-ci/dart-shards-latest\")\n    77\t                        (str \"dart-shards-\" stamp))\n    78\t    (log (str \"start \" stamp \" conc=\" conc))\n    79\t    ;; the Dart peer; its absence makes peer tests skip\n    80\t    (let [{:keys [exit]} (psh {:dir clone\n    81\t                               :out (io/writer (str out \"/build-peer.log\") :append true)\n    82\t                               :err (io/writer (str out \"/build-peer.log\") :append true)\n    83\t                               :continue true}\n    84\t                              \"bb\" \"build:yin-repl-peer\")]\n    85\t      (log (str \"build-yin-repl-peer rc=\" exit))\n    86\t      (when-not (zero? exit) (fail! \"build:yin-repl-peer failed\")))\n    87\t    ;; per-subsystem cljd namespaces; the per-run files are the evidence\n    88\t    (let [lists (into {} (map (fn [s] [s (cljd-namespaces clone s)]) subs))\n    89\t          all (->> (file-seq (fs/file (str clone \"/test\")))\n    90\t                   (filter #(re-find #\"_test\\.clj[cd]$\" (str %)))\n    91\t                   (map (fn [path]\n    92\t                          (-> (str path)\n    93\t                              (str/replace #\"^test/\" \"\")\n    94\t                              (str/replace #\"\\.clj[cd]$\" \"\")\n    95\t                              (str/replace \"/\" \".\")\n    96\t                              (str/replace \"_\" \"-\"))))\n    97\t                   set)\n    98\t          covered (apply set/union (map set (vals lists)))\n    99\t          uncovered (set/difference all covered)\n   100\t          lists (cond-> lists (seq uncovered)\n   101\t                        (assoc \"uncovered\" (vec uncovered)))]\n   102\t      (log (str \"all=\" (count all) \" covered=\" (count covered)\n   103\t                \" uncovered=\" (count uncovered)))\n   104\t      (doseq [[s nss] lists]\n   105\t        (spit (str out \"/ns-\" s \".txt\") (str/join \"\\n\" nss))))\n   106\t    ;; one full cljd compile\n   107\t    (let [t0 (System/currentTimeMillis)\n   108\t          allns (->> (mapcat (fn [s]\n   109\t                               (some->> (str out \"/ns-\" s \".txt\")\n   110\t                                        slurp\n   111\t                                        str/split-lines\n   112\t                                        (remove str/blank?)))\n   113\t                             subs)\n   114\t                     (apply concat (some->> (str out \"/ns-uncovered.txt\")\n   115\t                                            slurp\n   116\t                                            str/split-lines\n   117\t                                            (remove str/blank?)))\n   118\t                     distinct\n   119\t                     vec)\n   120\t          {:keys [exit]}\n   121\t          (apply psh {:dir clone\n   122\t                      :out (io/writer (str out \"/compile.log\") :append true)\n   123\t                      :err (io/writer (str out \"/compile.log\") :append true)\n   124\t                      :continue true}\n   125\t                 \"clojure\" \"-M:clojuredart:cljd\" \"compile\" allns)]\n   126\t      (log (str \"compile-all rc=\" exit\n   127\t                \" secs=\" (quot (- (System/currentTimeMillis) t0) 1000)))\n   128\t      (when-not (zero? exit) (fail! \"cljd compile failed\")))\n   129\t    ;; emit one shard dir per subsystem (residual included; failures fatal)\n   130\t    (let [dirs (atom [])\n   131\t          {:keys [continue]} nil]\n   132\t      (doseq [s (conj (vec subs) \"uncovered\")]\n   133\t        (let [f (str out \"/ns-\" s \".txt\")]\n   134\t          (when (.exists (fs/file f))\n   135\t            (let [nss (str/join \",\" (remove str/blank? (str/split-lines (slurp f))))\n   136\t                  d (str clone \"/build/cljd-agg-\" stamp \"-\" s)\n   137\t                  {:keys [exit]}\n   138\t                  (psh {:dir clone\n   139\t                        :out (str out \"/\" s \".emit.log\")\n   140\t                        :err :append\n   141\t                        :continue true}\n   142\t                       \"bb\" \"src/dev/cljd_agg.clj\" \"--only\" nss\n   143\t                       \"--shard-dir\" d \"--no-compile\" \"--no-run\")]\n   144\t              (if (zero? exit)\n   145\t                (swap! dirs conj d)\n   146\t                (fail! (str \"shard \" s \" emission failed (rc=\" exit \")\")))))))\n   147\t      (if (empty? @dirs)\n   148\t        (fail! \"no shards emitted\")\n   149\t        ;; R3: ONE flutter invocation over every emitted directory — the\n   150\t        ;; project-wide build/test_cache kernel is touched by one process.\n   151\t        (let [t0 (System/currentTimeMillis)\n   152\t              {:keys [exit]}\n   153\t              (apply psh {:dir clone\n   154\t                          :out (str out \"/all.log\")\n   155\t                          :err :append\n   156\t                          :extra-env {\"DATOM_SLOW_TESTS\" \"1\"}\n   157\t                          :continue true}\n   158\t                     \"flutter\" \"test\" \"--concurrency\" (str conc) @dirs)\n   159\t              wall (quot (- (System/currentTimeMillis) t0) 1000)\n   160\t              verdict (some->> (slurp (str out \"/all.log\"))\n   161\t                               str/split-lines\n   162\t                               (filter #(re-find #\"All tests passed|Some tests failed\" %))\n   163\t                               last)]\n   164\t          (log (str \"flutter rc=\" exit \" wall=\" wall \"s \" (or verdict \"\")))\n   165\t          (when-not (zero? exit) (fail! (str \"flutter test rc=\" exit))))))\n   166\t    (log (str \"done rc=\" @rc))\n   167\t    (System/exit @rc)))\n   168\t\n   169\t\n   170\t(when (= *file* (System/getProperty \"babashka.file\"))\n   171\t  (apply -main *command-line-args*))\n","exit_code":0,"status":"completed"}}
