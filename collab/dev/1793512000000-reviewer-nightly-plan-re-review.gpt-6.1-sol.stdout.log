      (println \"Dependent subsystems (tests in other subsystems that reach this source):\")\n   768\t      (if (empty? (:dependents seams))\n   769\t        (println \"  none\")\n   770\t        (doseq [s (:dependents seams)]\n   771\t          (println \"  \" s))))))\n   772\t\n   773\t\n   774\t(defn -main\n   775\t  [& args]\n   776\t  (let [{:keys [list? base changed subsystems slow?] :as opts}\n   777\t        (try (parse-args args)\n   778\t             (catch clojure.lang.ExceptionInfo ex\n   779\t               (println (ex-message ex))\n   780\t               (System/exit 1)))\n   781\t        index (scan-index)]\n   782\t    (if (seq subsystems)\n   783\t      (let [sub-cfg (load-subsystems-config)\n   784\t            _ (when-not sub-cfg\n   785\t                (println \"could not read\" subsystems-config-path)\n   786\t                (System/exit 1))\n   787\t            tests (try (select-subsystems index sub-cfg subsystems)\n   788\t                       (catch clojure.lang.ExceptionInfo ex\n   789\t                         (println (ex-message ex))\n   790\t                         (System/exit 1)))\n   791\t            selected (into (array-map)\n   792\t                           (map (juxt identity #(lane-tests index tests %)))\n   793\t                           (:lanes opts))\n   794\t            seams (when list? (subsystem-seams index sub-cfg subsystems))]\n   795\t        (print-subsystem-selection index subsystems tests selected seams)\n   796\t        (when-not list?\n   797\t          (let [run (into (array-map) (filter (comp seq val)) selected)\n   798\t                skipped (for [[lane nses] selected :when (empty? nses)]\n   799\t                          {:lane lane :namespaces 0 :status \"skipped\"})\n   800\t                prereqs (prerequisites index run)\n     1\t(ns affected\n     2\t  \"The test namespaces a change can affect, and a runner for them.\n     3\t\n     4\t   The changed files are `git diff --name-only <base>` plus the staged and\n     5\t   untracked files; base defaults to `git merge-base HEAD master`. Each\n     6\t   .clj .cljc .cljs .cljd file under src/ and test/ (not test/cljd-out) is\n     7\t   read for its first ns form, once per host feature (:clj :cljs :cljd),\n     8\t   so every reader-conditional branch counts. The affected tests are the\n     9\t   test namespaces (under test/, named *-test or holding a deftest) in the\n    10\t   reverse transitive closure of the changed namespaces, plus:\n    11\t   - a changed src file's conventional test (src/cljc/a/b.cljc selects\n    12\t     test/a/b_test.*), required or not;\n    13\t   - for a non-code file (a fixture under test/resources, a src resource),\n    14\t     the closure of every namespace whose text mentions its path or\n    15\t     basename: fixtures are read by path, not required;\n    16\t   - for any changed file, the closure of every namespace that walks its\n    17\t     tree with (file-seq (io/file \\\"<root>\\\")).\n    18\t   Ignored: docs/ collab/ build/ target/ node_modules/ cljd-out and *.md\n    19\t   (but a .md under test/resources is a fixture). Wide: deps.edn bb.edn\n    20\t   shadow-cljs.edn tests.edn package*.json pubspec.* .clj-kondo/ antlr/\n    21\t   src/dev/; a wide change selects every test and runs nothing.\n    22\t\n    23\t   Run with babashka:\n    24\t     bb src/dev/affected.clj [--list] [--base REF] [--lane clj|cljs|cljd]\n    25\t                             [--changed FILE...]\n    26\t   --list prints the selection and each changed file's reason; no run.\n    27\t   --lane restricts to one lane (repeatable; default all three).\n    28\t   --changed replaces the git query with the given files.\n    29\t   Without --list the selected lanes run in parallel, each logging to\n    30\t   target/profile/changed-<lane>.log, and a summary table follows.\n    31\t   Exit: 0 pass (or nothing selected), 1 a lane failed or bad input,\n    32\t   2 wide change: run bb test.\"\n    33\t  (:require\n    34\t    [babashka.fs :as fs]\n    35\t    [babashka.process :as p]\n    36\t    [clojure.edn :as edn]\n    37\t    [clojure.string :as str]\n    38\t    [edamame.core :as e]))\n    39\t\n    40\t\n    41\t(def code-exts #{\"clj\" \"cljc\" \"cljs\" \"cljd\"})\n    42\t(def lanes [:clj :cljs :cljd])\n    43\t(def log-dir \"target/profile\")\n    44\t(def wide-exit 2)\n    45\t\n    46\t\n    47\t(def ignored-prefixes\n    48\t  [\"docs/\" \"collab/\" \"build/\" \"target/\" \"node_modules/\" \"test/cljd-out/\"\n    49\t   \"lib/cljd-out/\"])\n    50\t\n    51\t\n    52\t(def wide-files\n    53\t  #{\"deps.edn\" \"bb.edn\" \"shadow-cljs.edn\" \"tests.edn\" \"package.json\"\n    54\t    \"package-lock.json\" \"pubspec.yaml\" \"pubspec.lock\" \"mise.toml\"\n    55\t    \".cljstyle\"})\n    56\t\n    57\t\n    58\t(def wide-prefixes [\".clj-kondo/\" \"antlr/\" \"src/dev/\"])\n    59\t\n    60\t\n    61\t(defn- starts-with-any?\n    62\t  [path prefixes]\n    63\t  (some #(str/starts-with? path %) prefixes))\n    64\t\n    65\t\n    66\t(defn classify\n    67\t  \"One of :ignored :wide :code :resource for the repo-relative `path`.\"\n    68\t  [path]\n    69\t  (cond (starts-with-any? path ignored-prefixes) :ignored\n    70\t        (str/starts-with? path \"test/resources/\") :resource\n    71\t        (str/ends-with? path \".md\") :ignored\n    72\t        (or (wide-files path) (starts-with-any? path wide-prefixes)) :wide\n    73\t        (and (starts-with-any? path [\"src/\" \"test/\"])\n    74\t             (code-exts (fs/extension path))) :code\n    75\t        :else :resource))\n    76\t\n    77\t\n    78\t;; ---------------------------------------------------------------------------\n    79\t;; ns forms\n    80\t;; ---------------------------------------------------------------------------\n    81\t\n    82\t(def ^:private dep-clauses #{:require :use :require-macros :use-macros})\n    83\t\n    84\t\n    85\t(defn ns-name-of\ntest/dao/test_slow.