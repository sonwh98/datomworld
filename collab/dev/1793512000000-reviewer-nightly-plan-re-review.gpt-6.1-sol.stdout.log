241\t  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   242\t   ;; The Dart lanes depend on this task, so the generated Dart parser\n   243\t   ;; reaches them through it.\n   244\t   :depends [gen:antlr]\n   245\t   ;; Process B of the R5 slice is a whole program rather than a test\n   246\t   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   247\t   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   248\t   ;; It is compiled alone and first: the test build rewrites the same\n   249\t   ;; cljd-out tree, so a peer built after it would import a tree it does\n   250\t   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM\n   251\t   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n   252\t   ;; `bb test:cljs` without it skips those tests with a printed notice\n   253\t   ;; rather than failing.\n   254\t   :task (do (shell \"mkdir -p build\")\n   255\t             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n   256\t             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n   257\t\n   258\t  build:demo\n   259\t  {:doc \"Release-compile the browser demo (shadow-cljs build :demo) to public/js/main.js\"\n   260\t   ;; The demo pulls in yang.python.antlr.parser, whose JavaScript\n   261\t   ;; recognizers live in build/antlr/python3/js (a :cljs classpath root),\n   262\t   ;; so a clean checkout generates them before compiling.\n   263\t   :depends [deps:npm gen:antlr]\n   264\t   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli release demo\")}\n   265\t\n   266\t  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n   267\t  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n   268\t            :depends [build:yin-repl-node gen:antlr]\n   269\t            :task (shell \"clojure -M:test -e :slow\")}\n   270\t\n   271\t  check:node-discovery\n   272\t  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\n   273\t   :task (shell {:shutdown nil} \"bb src/dev/check_node_discovery.clj\")}\n   274\t\n   275\t  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n/usr/bin/unzip\n","exit_code":0,"status":"completed"}}
