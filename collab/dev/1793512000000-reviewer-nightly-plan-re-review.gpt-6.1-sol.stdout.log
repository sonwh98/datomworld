 }\\n    24\\techo \\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\" | tee \\\"$OUT/summary.txt\\\"\\n    25\\tnpm ci --silent >\\\"$OUT/npm.log\\\" 2>&1                   && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    26\\tbb build:yin-repl-node >\\\"$OUT/build-node.log\\\" 2>&1     && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    27\\tbb gen:antlr >\\\"$OUT/antlr.log\\\" 2>&1                    && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    28\\tSUBS=\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\"\\n    29\\t: > \\\"$OUT/covered.txt\\\"\\n    30\\tfor s in $SUBS; do\\n    31\\t  bb test:sub:list \\\"$s\\\" 2>/dev/null | awk \\\"/^cljs:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\"\\\\\\\");print}\\\" > \\\"$OUT/ns-$s.txt\\\"\\n    32\\t  cat \\\"$OUT/ns-$s.txt\\\" >> \\\"$OUT/covered.txt\\\"\\n    33\\t  echo \\\"$s $(wc -l < \\\"$OUT/ns-$s.txt\\\")\\\" >> \\\"$OUT/plan.txt\\\"\\n    34\\tdone\\n    35\\t# coverage: every cljs test namespace under test/ vs the union of the shards\\n    36\\tfind test -type f \\\\( -name \\\"*_test.cljc\\\" -o -name \\\"*_test.cljs\\\" \\\\) | sed -e \\\"s#^test/##\\\" -e \\\"s#\\\\.clj[cs]\\\\?\\\\$##\\\" -e \\\"s#/#.#g\\\" -e \\\"s#_#-#g\\\" | sort -u > \\\"$OUT/all.txt\\\"\\n    37\\tsort -u \\\"$OUT/covered.txt\\\" > \\\"$OUT/covered.sorted\\\"\\n    38\\tcomm -23 \\\"$OUT/all.txt\\\" \\\"$OUT/covered.sorted\\\" > \\\"$OUT/ns-uncovered.txt\\\"\\n    39\\techo \\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    40\\t\\n    41\\tt0=$(date +%s)\\n    42\\tclj -M:cljs -m shadow.cljs.devtools.cli compile test --config-merge \\\"{:autorun false}\\\" >\\\"$OUT/compile.log\\\" 2>&1\\n    43\\trc=$?\\n    44\\techo \\\"compile-all rc=$rc secs=$(( $(date +%s)-t0 )) $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    45\\t[ \\\"$rc\\\" = \\\"0\\\" ] || { echo \\\"done (compile failed) $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"; exit 1; }\\n    46\\t\\n    47\\t# one --test list per shard: the subsystem's namespaces, plus the uncovered residual\\n    48\\tfor s in $SUBS uncovered; do\\n    49\\t  f=\\\"$OUT/ns-$s.txt\\\"; [ -s \\\"$f\\\" ] || continue\\n    50\\t  paste -sd, \\\"$f\\\" > \\\"$OUT/sel-$s.txt\\\"\\n    51\\tdone\\n    52\\t\\n    53\\trun_shard() {\\n    54\\t  s=$1; sel=\\\"$OUT/sel-$s.txt\\\"; [ -s \\\"$sel\\\" ] || return 0\\n    55\\t  t0=$(date +%s)\\n    56\\t  DATOM_SLOW_TESTS=1 node target/node-tests.js --test=\\\"$(cat \\\"$sel\\\")\\\" >\\\"$OUT/$s.log\\\" 2>&1\\n    57\\t  rc=$?\\n    58\\t  echo \\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\"^Ran \\\" \\\"$OUT/$s.log\\\" | tail -1)\\\" >> \\\"$OUT/runs.txt\\\"\\n    59\\t}\\n    60\\texport -f run_shard; export OUT\\n    61\\tt0=$(date +%s)\\n    62\\t: > \\\"$OUT/runs.txt\\\"\\n    63\\t{ for s in $SUBS uncovered; do [ -s \\\"$OUT/sel-$s.txt\\\" ] && echo \\\"$s\\\"; done; } | \\\\\\n    64\\t  xargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_shard {}\\\"\\n    65\\tsort -o \\\"$OUT/runs.txt\\\" \\\"$OUT/runs.txt\\\"\\n    66\\tcat \\\"$OUT/runs.txt\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    67\\tRED=$(grep -oE \\\"rc=[0-9]+\\\" \\\"$OUT/runs.txt\\\" | grep -vc \\\"rc=0\\\")\\n    68\\tWALL=$(( $(date +%s)-t0 ))\\n    69\\techo \\\"node-sharded lanes=$(grep -c \\\"rc=\\\" \\\"$OUT/runs.txt\\\") red-lanes=$RED wall=${WALL}s $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    70\\techo \\\"done $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nFILE:/home/sto/ci/dart-shard.sh\\n     1\\t#!/usr/bin/env bash\\n     2\\t# Usage: dart-shard.sh <clone> [parallel]  -- Dart lane sharded by subsystem.\\n     3\\t#\\n     4\\t# The Dart mirror of shard-jvm.sh. One full cljd compile (the compile is\\n     5\\t# per-namespace incremental in lib/cljd-out and cannot be parallelized in one\\n     6\\t# clone), then one `flutter test build/cljd-agg-<s>` process per subsystem,\\n     7\\t# all running in parallel. Shard emission is cljd_agg.clj's own greedy-by-size\\n     8\\t# grouping (up to 8 shard files per subsystem), isolated per subsystem via\\n     9\\t# --shard-dir so parallel flutter processes never share build/cljd-agg.\\n    10\\t#\\n    11\\t# Requires the --shard-dir/--no-compile/--no-run flags in src/dev/cljd_agg.clj\\n    12\\t# (added 2026-10-31). Namespace lists come from `bb test:sub:list`'s cljd\\n    13\\t# section, driven by src/dev/subsystems.edn; DATOM_SLOW_TESTS=1 enables the\\n    14\\t# guarded slow bodies, as test:all:cljd does. A flutter process is heavy\\n    15\\t# (~1-2 GB), so the default parallelism is 4.\\n    16\\tset -u\\n    17\\texport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\n    18\\tcd \\\"$1\\\" || exit 2\\n    19\\tPAR=\\\"${2:-4}\\\"\\n    20\\tmise trust >/dev/null 2>&1\\n    21\\teval \\\"$(mise env -s bash)\\\"\\n    22\\tOUT=\\\"$1/target-ci/dart-shards\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\n    23\\tts() { date +%H:%M:%S; }\\n    24\\techo \\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\" | tee \\\"$OUT/summary.txt\\\"\\n    25\\tbb build:yin-repl-peer >\\\"$OUT/build-peer.log\\\" 2>&1     && echo \\\"dart peer built $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    26\\tSUBS=\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\"\\n    27\\t: > \\\"$OUT/covered.txt\\\"\\n    28\\tfor s in $SUBS; do\\n    29\\t  bb test:sub:list \\\"$s\\\" 2>/dev/null | awk \\\"/^cljd:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\"\\\\\\\");print}\\\" > \\\"$OUT/ns-$s.txt\\\"\\n    30\\t  cat \\\"$OUT/ns-$s.txt\\\" >> \\\"$OUT/covered.txt\\\"\\n    31\\t  echo \\\"$s $(wc -l < \\\"$OUT/ns-$s.txt\\\")\\\" >> \\\"$OUT/plan.txt\\\"\\n    32\\tdone\\n    33\\t# coverage: every test namespace under test/ vs the union of the shards\\n    34\\t# (the cljd tool compiles every *_test.clj[cd]; the same all-set the\\n    35\\t#  node-shard and JVM shards check against)\\n    36\\tfind test -type f \\\\( -name \\\"*_test.cljc\\\" -o -name \\\"*_test.cljd\\\" \\\\) | sed -e \\\"s#^test/##\\\" -e \\\"s#\\\\.clj[cd]\\\\?\\\\$##\\\" -e \\\"s#/#.#g\\\" -e \\\"s#_#-#g\\\" | sort -u > \\\"$OUT/all.txt\\\"\\n    37\\tsort -u \\\"$OUT/covered.txt\\\" > \\\"$OUT/covered.sorted\\\"\\n    38\\tcomm -23 \\\"$OUT/all.txt\\\" \\\"$OUT/covered.sorted\\\" > \\\"$OUT/ns-uncovered.txt\\\"\\n    39\\techo \\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    40\\t\\n    41\\tt0=$(date +%s)\\n    42\\tALLNS=$(cat \\\"$OUT\\\"/ns-*.txt | sort -u | paste -sd\\\" \\\" -)\\n    43\\tclojure -M:clojuredart:cljd compile $ALLNS >\\\"$OUT/compile.log\\\" 2>&1\\n    44\\trc=$?\\n    45\\techo \\\"compile-all rc=$rc secs=$(( $(date +%s)-t0 )) $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    46\\t[ \\\"$rc\\\" = \\\"0\\\" ] || { echo \\\"done (compile failed) $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"; exit 1; }\\n    47\\t\\n    48\\t# emit one shard dir per subsystem (sequential; with --no-compile each is fast)\\n    49\\tfor s in $SUBS; do\\n    50\\t  f=\\\"$OUT/ns-$s.txt\\\"; [ -s \\\"$f\\\" ] || continue\\n    51\\t  nss=$(paste -sd, \\\"$f\\\")\\n    52\\t  bb src/dev/cljd_agg.clj --only \\\"$nss\\\" --shard-dir \\\"build/cljd-agg-$s\\\" --no-compile --no-run \\\\\\n    53\\t    > \\\"$OUT/$s.emit.log\\\" 2>&1\\n    54\\t  rc=$?\\n    55\\t  echo \\\"$s emit rc=$rc $(ts)\\\" >> \\\"$OUT/emits.txt\\\"\\n    56\\tdone\\n    57\\techo \\\"shards emitted $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    58\\t\\n    59\\trun_shard() {\\n    60\\t  s=$1; d=\\\"build/cljd-agg-$s\\\"\\n    61\\t  [ -d \\\"$d\\\" ] || return 0\\n    62\\t  t0=$(date +%s)\\n    63\\t  DATOM_SLOW_TESTS=1 flutter test --concurrency 4 \\\"$d\\\" >\\\"$OUT/$s.log\\\" 2>&1\\n    64\\t  rc=$?\\n    65\\t  echo \\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -oE \\\"[0-9]+ -[0-9]+:\\\" \\\"$OUT/$s.log\\\" | tail -1)\\\" >> \\\"$OUT/runs.txt\\\"\\n    66\\t}\\n    67\\texport -f run_shard; export OUT\\n    68\\tt0=$(date +%s)\\n    69\\t: > \\\"$OUT/runs.txt\\\"\\n    70\\t{ for s in $SUBS; do [ -d \\\"build/cljd-agg-$s\\\" ] && echo \\\"$s\\\"; done; } | \\\\\\n    71\\t  xargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_shard {}\\\"\\n    72\\tsort -o \\\"$OUT/runs.txt\\\" \\\"$OUT/runs.txt\\\"\\n    73\\tcat \\\"$OUT/runs.txt\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    74\\tRED=$(grep -oE \\\"rc=[0-9]+\\\" \\\"$OUT/runs.txt\\\" | grep -vc \\\"rc=0\\\")\\n    75\\tWALL=$(( $(date +%s)-t0 ))\\n    76\\techo \\\"dart-sharded lanes=$(grep -c \\\"rc=\\\" \\\"$OUT/runs.txt\\\") red-lanes=$RED wall=${WALL}s $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n    77\\techo \\\"done $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nFILE:/home/sto/ci/nightly-full.sh\\n     1\\t#!/usr/bin/env bash\\n     2\\t# Nightly split (owner ruling 2026-10-31): shiva runs the Node and Dart lanes.\\n     3\\t# The JVM sharded lane runs on jupiter (~/ci/nightly-jvm.sh there) — jupiter is\\n     4\\t# the faster JVM/sharding box; shiva keeps the lanes that need normal Node\\n     5\\t# speed. Guard: the owner-scheduled 03:00 Vietnam window; the crontab fires\\n     6\\t# hourly and the suite runs only in the Vietnam 3am hour, so the US DST shift\\n     7\\t# never moves the run. NOW=1 forces an immediate run.\\n     8\\t#\\n     9\\t# Commit pinning: THIS host resolves origin/master first and pins the SHA in\\n    10\\t# ~/ci/nightly-pin.txt; jupiter's nightly-jvm.sh reads that pin over SSH so\\n    11\\t# both hosts test the SAME commit even if a push lands mid-window. If a push\\n    12\\t# lands between shiva's fetch and its checkout, the checkout uses the pinned\\n    13\\t# SHA regardless.\\n    14\\t#\\n    15\\t# Summary sync: when this host's lanes finish, its summary is pushed to\\n    16\\t# jupiter (and jupiter's is pulled here), so each host's nightly-results\\n    17\\t# holds the full tri-host picture.\\n    18\\tif [ \\\"${NOW:-}\\\" != \\\"1\\\" ] && [ \\\"$(TZ=Asia/Ho_Chi_Minh date +%H)\\\" != \\\"03\\\" ]; then\\n    19\\t  exit 0\\n    20\\tfi\\n    21\\t\\n    22\\t# The nightly full suite, this host's share: Node and Dart lanes, against the\\n    23\\t# pinned commit, in this clone. The JVM leg lives on jupiter.\\n    24\\tset -u\\n    25\\texport PATH=\\\"$HOME/.local/bin:$PATH\\\"\\n    26\\tcd ~/ci/datomworld-python-s3 || exit 2\\n    27\\tmise trust >/dev/null 2>&1\\n    28\\teval \\\"$(mise env -s bash)\\\"\\n    29\\tOUT=~/ci/nightly-results; mkdir -p \\\"$OUT\\\"\\n    30\\tSTAMP=$(date +%Y%m%d-%H%M)\\n    31\\tgit fetch -q origin\\n    32\\tSHA=$(git rev-parse origin/master)\\n    33\\techo \\\"$SHA\\\" > ~/ci/nightly-pin.txt\\n    34\\tgit checkout -q --detach \\\"$SHA\\\"\\n    35\\techo \\\"nightly $STAMP at $(git log --oneline -1) (pinned $(date +%H:%M:%S))\\\" > \\\"$OUT/$STAMP-summary.txt\\\"\\n    36\\tbb gen:antlr > \\\"$OUT/$STAMP-gen.log\\\" 2>&1 || { echo \\\"gen failed\\\" >> \\\"$OUT/$STAMP-summary.txt\\\"; exit 1; }\\n    37\\ts=$(date +%s)\\n    38\\tbb test:all:cljs > \\\"$OUT/$STAMP-cljs-full.log\\\" 2>&1\\n    39\\techo \\\"cljs-full rc=$? secs=$(($(date +%s)-s)) $(grep -E \\\"^Ran \\\" \\\"$OUT/$STAMP-cljs-full.log\\\" | tail -1) $(grep -oE \\\"[0-9]+ failures, [0-9]+ errors\\\" \\\"$OUT/$STAMP-cljs-full.log\\\" | tail -1)\\\" >> \\\"$OUT/$STAMP-summary.txt\\\"\\n    40\\ts=$(date +%s)\\n    41\\tbb test:all:cljd > \\\"$OUT/$STAMP-cljd-full.log\\\" 2>&1\\n    42\\techo \\\"cljd-full rc=$? secs=$(($(date +%s)-s)) $(tail -1 \\\"$OUT/$STAMP-cljd-full.log\\\" | head -c 80)\\\" >> \\\"$OUT/$STAMP-summary.txt\\\"\\n    43\\techo done >> \\\"$OUT/$STAMP-summary.txt\\\"\\n    44\\t# Summary sync (best effort; the nightly result must