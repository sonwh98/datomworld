{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,255p' src/dev/cljd_agg.clj && rg -n 'cljd|lane-tests|list-subsystems' src/dev/affected.clj | head -70 && git log -1 --oneline\"","aggregated_output":"(ns cljd-agg\n  \"Dart test runner that aggregates the generated test files.\n\n   `flutter test` loads every generated *_test.dart separately (about 7.5 s\n   each). This runner compiles the test namespaces through the cljd tool,\n   groups the generated files into a few shard files that import them and call\n   each `main`, and runs `flutter test` on the shards only. Shards live under\n   build/, never under test/, so a plain `cljd test` never runs them twice.\n\n   Run with babashka:\n     bb src/dev/cljd_agg.clj [--slow-only | --slow-regex | --only NS,NS...]\n   --slow-only restricts the run to the namespaces that use dao.test-slow/guard.\n   A namespace in that set with no generated Dart file is fatal.\n   --only compiles and runs only the given test namespaces (bb test:changed,\n   bb test:sub); one with no generated Dart file is fatal too, EXCEPT a\n   JVM-only namespace: one whose every deftest sits behind a reader\n   conditional that excludes ClojureDart (for example\n   dao.data.sorted-user-type-test). The cljd tool compiles such a namespace as\n   a plain library (lib/cljd-out/<ns>.dart exists) and emits no test file;\n   that is reported and skipped, never fatal. A namespace that produced\n   neither file is still fatal.\n   --slow-regex prints, for bb.edn, an anchored alternation of those\n   namespaces with its dots already escaped for embedding in an EDN string\n   (shadow-cljs --config-merge); it is not a ready-to-use regex. It exits 1\n   when no namespace uses the guard, so a slow lane cannot be vacuous.\n   DATOM_SLOW_TESTS is inherited from the environment.\"\n  (:require\n    [babashka.fs :as fs]\n    [babashka.process :as p]\n    [clojure.string :as str]))\n\n\n(def test-root \"test\")\n(def out-root \"test/cljd-out\")\n(def shard-dir \"build/cljd-agg\")\n(def max-shards 8)\n\n\n(defn- ns-of\n  \"The namespace declared by the first ns form of `file`.\"\n  [file]\n  (second (re-find #\"\\(ns\\s+\\^?(?:\\{[^}]*\\}\\s+)?([^\\s\\)]+)\" (slurp file))))\n\n\n(defn- source-files\n  []\n  (->> (file-seq (fs/file test-root))\n       (filter #(re-find #\"_test\\.clj[cd]$\" (str %)))\n       (remove #(str/includes? (str %) \"cljd-out\"))\n       (map str)\n       sort))\n\n\n(defn- test-namespaces\n  \"Distinct: a namespace with both a .cljc and a .cljd source (for example\n   dao.stream.cbor-test) has one generated Dart file, which must run once.\"\n  []\n  (distinct (keep ns-of (source-files))))\n\n\n(defn- slow-namespaces\n  \"Namespaces whose source uses dao.test-slow/guard, derived from the tree.\"\n  []\n  (->> (source-files)\n       (filter #(re-find #\"slow/guard\" (slurp %)))\n       (keep ns-of)\n       distinct\n       sort))\n\n\n(defn- dart-file\n  \"Generated file path for namespace `ns-name`.\"\n  [ns-name]\n  (str out-root \"/\" (str/replace ns-name \".\" \"/\") \"_test.dart\"))\n\n\n(defn- lib-file\n  \"Library file the cljd tool writes for a namespace with no Dart tests.\"\n  [ns-name]\n  (str \"lib/cljd-out/\" (str/replace ns-name \".\" \"/\") \".dart\"))\n\n\n(defn jvm-only?\n  \"True when `ns-name` compiled to a library but produced no Dart test file:\n   it has no ClojureDart tests (a JVM-only namespace), as opposed to not\n   having compiled at all.\"\n  [ns-name]\n  (and (not (fs/exists? (dart-file ns-name)))\n       (fs/exists? (lib-file ns-name))))\n\n\n(defn- run!*\n  [& args]\n  (let [{:keys [exit]} (apply p/shell {:continue true} args)]\n    exit))\n\n\n(defn compile-tests\n  \"Compile every test namespace through the cljd tool.\"\n  [namespaces]\n  (let [exit (apply run!* \"clojure\" \"-M:clojuredart:cljd\" \"compile\"\n                    namespaces)]\n    (when-not (zero? exit)\n      (println \"cljd compile failed, exit\" exit)\n      (System/exit exit))))\n\n\n(defn shard\n  \"Greedy balanced partition of `files` into `n` groups by file size.\n   Deterministic: ties are broken by path.\"\n  [files n]\n  (let [sized (sort-by (juxt (comp - fs/size) identity) files)\n        init  (vec (repeat n {:size 0 :files []}))]\n    (->> sized\n         (reduce (fn [shards f]\n                   (let [i (first (first (sort-by\n                                           (juxt (comp :size second) first)\n                                           (map-indexed vector shards))))]\n                     (-> shards\n                         (update-in [i :size] + (fs/size f))\n                         (update-in [i :files] conj f))))\n                 init)\n         (map (comp sort :files))\n         (remove empty?))))\n\n\n(defn- shard-source\n  \"Dart source of an aggregator importing `files` and calling each main.\n   Imports are relative to `shard-dir`.\"\n  [files shard-dir]\n  (let [rel (fn [f]\n              (str (fs/relativize (fs/absolutize shard-dir)\n                                  (fs/absolutize f))))]\n    (str \"// Generated by src/dev/cljd_agg.clj; do not edit.\\n\"\n         (apply str\n                (map-indexed (fn [i f]\n                               (str \"import '\" (rel f) \"' as m\" i \";\\n\"))\n                             files))\n         \"\\nvoid main() {\\n\"\n         (apply str\n                (map-indexed (fn [i _] (str \"  m\" i \".main();\\n\")) files))\n         \"}\\n\")))\n\n\n(defn write-shards!\n  \"Emit the aggregator files under `shard-dir` (build/cljd-agg by default;\n   --shard-dir overrides, which lets dart-shard.sh run one directory per\n   subsystem as parallel flutter processes). Returns the shard paths.\"\n  ([files] (write-shards! files shard-dir))\n  ([files shard-dir]\n   (fs/delete-tree shard-dir)\n   (fs/create-dirs shard-dir)\n   (let [n (min max-shards\n                (.availableProcessors (Runtime/getRuntime))\n                (count files))]\n     (vec (map-indexed\n            (fn [i group]\n              (let [path (format \"%s/shard_%d_test.dart\" shard-dir i)]\n                (spit path (shard-source group shard-dir))\n                path))\n            (shard files n))))))\n\n\n(defn -main\n  [& args]\n  (when (some #{\"--slow-regex\"} args)\n    (when (empty? (slow-namespaces))\n      (println \"No namespace uses dao.test-slow/guard.\")\n      (System/exit 1))\n    (println (str \"^(\" (str/join \"|\" (map #(str/replace % \".\" \"\\\\\\\\.\")\n                                          (slow-namespaces)))\n                  \")$\"))\n    (System/exit 0))\n  (let [slow-only? (some #{\"--slow-only\"} args)\n        only       (when (some #{\"--only\"} args)\n                     (let [v (second (drop-while #(not= \"--only\" %) args))]\n                       (vec (remove str/blank? (str/split (str v) #\",\")))))\n        shard-dir  (or (when (some #{\"--shard-dir\"} args)\n                         (second (drop-while #(not= \"--shard-dir\" %) args)))\n                       shard-dir)\n        no-compile? (some #{\"--no-compile\"} args)\n        no-run?    (some #{\"--no-run\"} args)\n        wanted     (cond only only\n                         slow-only? (slow-namespaces)\n                         :else (test-namespaces))]\n    (when (empty? wanted)\n      (println \"No test namespaces selected.\")\n      (System/exit 1))\n    (when-not no-compile?\n      (compile-tests (or only (test-namespaces))))\n    (let [files (filter fs/exists? (map dart-file wanted))\n          missing (remove (comp fs/exists? dart-file) wanted)]\n      (when (seq missing)\n        (let [jvm-only (if (and only (not slow-only?))\n                         (filter jvm-only? missing)\n                         [])\n              fatal (remove (set jvm-only) missing)]\n          (when (seq jvm-only)\n            (println \"JVM-only namespaces (compiled, no Dart tests; skipped):\"\n                     (str/join \", \" jvm-only)