          allns (->> (mapcat (fn [s]\n                               (some->> (str out \"/ns-\" s \".txt\")\n                                        slurp\n                                        str/split-lines\n                                        (remove str/blank?)))\n                             subs)\n                     (apply concat (some->> (str out \"/ns-uncovered.txt\")\n                                            slurp\n                                            str/split-lines\n                                            (remove str/blank?)))\n                     distinct\n                     vec)\n          {:keys [exit]}\n          (apply psh {:dir clone\n                      :out (io/file (str out \"/compile.log\"))\n                      :err :out\n                      :continue true}\n                 \"clojure\" \"-M:clojuredart:cljd\" \"compile\" allns)]\n      (log (str \"compile-all rc=\" exit\n                \" secs=\" (quot (- (System/currentTimeMillis) t0) 1000)))\n      (when-not (zero? exit) (fail! \"cljd compile failed\")))\n    ;; emit one shard dir per subsystem (residual included; failures fatal)\n    (let [dirs (atom [])\n          {:keys [continue]} nil]\n      (doseq [s (conj (vec subs) \"uncovered\")]\n        (let [f (str out \"/ns-\" s \".txt\")]\n          (when (.exists (fs/file f))\n            (let [nss (str/join \",\" (remove str/blank? (str/split-lines (slurp f))))\n                  d (str clone \"/build/cljd-agg-\" stamp \"-\" s)\n                  {:keys [exit]}\n                  (psh {:dir clone\n                        :out (io/file (str out \"/\" s \".emit.log\"))\n                        :err :out\n                        :continue true}\n                       \"bb\" \"src/dev/cljd_agg.clj\" \"--only\" nss\n                       \"--shard-dir\" d \"--no-compile\" \"--no-run\")]\n              (if (zero? exit)\n                (swap! dirs conj d)\n                (fail! (str \"shard \" s \" emission failed (rc=\" exit \")\")))))))\n      (if (empty? @dirs)\n        (fail! \"no shards emitted\")\n        ;; R3: ONE flutter invocation over every emitted directory — the\nyang.typescript.antlr.prelude-parity-test\nyang.typescript.antlr.lower-portable-test\nyang.php.antlr.lower-portable-test\nyang.php-literal-test\nyang.typescript.antlr.string-forms-test\nyang.typescript.antlr.prelude-test\ndao.host.text-test\nyang.typescript.antlr.corpus-test\nyang.typescript.antlr.linked-prelude-test\ndao.host.hash-test\ndao.host.conformance-test\nyang.typescript.antlr.object-parity-test\nyang.php.antlr.prelude-test\ndao.host.float-test\nyang.typescript.antlr.prelude-module-test\ndao.host.bytes-test\nyang.typescript.antlr.float-address-test","exit_code":0,"status":"completed"}}
