{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"ssh jupiter.stigmergy.systems 'set -e\ncd ~/ci/datomworld-nightly\nexport PATH=\\\"\"'$HOME/.local/bin:/snap/bin:$PATH\"\neval \"$(mise env -s bash)\"\ncat > /tmp/dart-shard-diagnose.clj <<'\"'\\\\''CLJ'\\\\''\n(load-file \\\"src/dev/dart_shard.clj\\\")\n(require '\\\\''[clojure.string :as str])\n(let [out \\\"target-ci/dart-shards-20261031-2316\\\"\n      a (mapcat (fn [s] (->> (slurp (str out \\\"/ns-\\\" s \\\".txt\\\")) str/split-lines (remove str/blank?))) dart-shard/subs)\n      b (->> (slurp (str out \\\"/ns-uncovered.txt\\\")) str/split-lines (remove str/blank?))\n      allns (->> a (apply concat b) distinct vec)]\n  (prn {:artifact out :covered-count (count a) :uncovered-count (count b)\n        :allns-count (count allns) :allns allns\n        :types (frequencies (map #(str (type %)) allns))}))\n(let [original @#'\\\\''dart-shard/psh]\n  (alter-var-root #'\\\\''dart-shard/psh\n    (constantly\n      (fn [opts & cmd]\n        (when (= \\\"compile\\\" (nth cmd 2 nil))\n          (prn {:compile-argv (vec cmd)})\n          (spit (str (.getParent (:out opts)) \\\"/compile-argv.edn\\\") (pr-str (vec cmd))))\n        (let [result (apply original opts cmd)]\n          (when (= \\\"compile\\\" (nth cmd 2 nil))\n            (println \\\"diagnostic: stopping after compile, rc=\\\" (:exit result))\n            (System/exit (:exit result)))\n          result)))))\n(dart-shard/-main (System/getProperty \\\"user.dir\\\") \\\"8\\\")\nCLJ\nbb /tmp/dart-shard-diagnose.clj\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
