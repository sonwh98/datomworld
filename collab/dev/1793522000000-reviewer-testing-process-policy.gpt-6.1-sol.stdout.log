   fail! (fn [msg]\\n    70\\t                (reset! rc 1)\\n    71\\t                (println \\\"FAIL:\\\" msg)\\n    72\\t                (spit summary (str \\\"FAIL: \\\" msg \\\"\\\\n\\\") :append true))\\n    73\\t        log   (fn [msg] (println msg) (spit summary (str msg \\\"\\\\n\\\") :append true))]\\n    74\\t    (fs/create-dirs out)\\n    75\\t    (fs/delete-if-exists (str clone \\\"/target-ci/dart-shards-latest\\\"))\\n    76\\t    (fs/create-sym-link (str clone \\\"/target-ci/dart-shards-latest\\\")\\n    77\\t                        (str \\\"dart-shards-\\\" stamp))\\n    78\\t    (log (str \\\"start \\\" stamp \\\" conc=\\\" conc))\\n    79\\t    ;; the Dart peer; its absence makes peer tests skip\\n    80\\t    (let [{:keys [exit]} (psh {:dir clone\\n    81\\t                               :out (io/writer (str out \\\"/build-peer.log\\\") :append true)\\n    82\\t                               :err (io/writer (str out \\\"/build-peer.log\\\") :append true)\\n    83\\t                               :continue true}\\n    84\\t                              \\\"bb\\\" \\\"build:yin-repl-peer\\\")]\\n    85\\t      (log (str \\\"build-yin-repl-peer rc=\\\" exit))\\n    86\\t      (when-not (zero? exit) (fail! \\\"build:yin-repl-peer failed\\\")))\\n    87\\t    ;; per-subsystem cljd namespaces; the per-run files are the evidence\\n    88\\t    (let [lists (into {} (map (fn [s] [s (cljd-namespaces clone s)]) subs))\\n    89\\t          all (->> (file-seq (fs/file (str clone \\\"/test\\\")))\\n    90\\t                   (filter #(re-find #\\\"_test\\\\.clj[cd]$\\\" (str %)))\\n    91\\t                   (map (fn [path]\\n    92\\t                          (-> (str path)\\n    93\\t                              (str/replace #\\\"^test/\\\" \\\"\\\")\\n    94\\t                              (str/replace #\\\"\\\\.clj[cd]$\\\" \\\"\\\")\\n    95\\t                              (str/replace \\\"/\\\" \\\".\\\")\\n    96\\t                              (str/replace \\\"_\\\" \\\"-\\\"))))\\n    97\\t                   set)\\n    98\\t          covered (apply set/union (map set (vals lists)))\\n    99\\t          uncovered (set/difference all covered)\\n   100\\t          lists (cond-> lists (seq uncovered)\\n   101\\t                        (assoc \\\"uncovered\\\" (vec uncovered)))]\\n   102\\t      (log (str \\\"all=\\\" (count all) \\\" covered=\\\" (count covered)\\n   103\\t                \\\" uncovered=\\\" (count uncovered)))\\n   104\\t      (doseq [[s nss] lists]\\n   105\\t        (spit (str out \\\"/ns-\\\" s \\\".txt\\\") (str/join \\\"\\\\n\\\" nss))))\\n   106\\t    ;; one full cljd compile\\n   107\\t    (let [t0 (System/currentTimeMillis)\\n   108\\t          allns (->> (mapcat (fn [s]\\n   109\\t                               (some->> (str out \\\"/ns-\\\" s \\\".txt\\\")\\n   110\\t                                        slurp\\n   111\\t                                        str/split-lines\\n   112\\t                                        (remove str/blank?)))\\n   113\\t                             subs)\\n   114\\t                     (apply concat (some->> (str out \\\"/ns-uncovered.txt\\\")\\n   115\\t                                            slurp\\n   116\\t                                            str/split-lines\\n   117\\t                                            (remove str/blank?)))\\n   118\\t                     distinct\\n   119\\t                     vec)\\n   120\\t          {:keys [exit]}\\n   121\\t          (apply psh {:dir clone\\n   122\\t                      :out (io/writer (str out \\\"/compile.log\\\") :append true)\\n   123\\t                      :err (io/writer (str out \\\"/compile.log\\\") :append true)\\n   124\\t                      :continue true}\\n   125\\t                 \\\"clojure\\\" \\\"-M:clojuredart:cljd\\\" \\\"compile\\\" allns)]\\n   126\\t      (log (str \\\"compile-all rc=\\\" exit\\n   127\\t                \\\" secs=\\\" (quot (- (System/currentTimeMillis) t0) 1000)))\\n   128\\t      (when-not (zero? exit) (fail! \\\"cljd compile failed\\\")))\\n   129\\t    ;; emit one shard dir per subsystem (residual included; failures fatal)\\n   130\\t    (let [dirs (atom [])\\n   131\\t          {:keys [continue]} nil]\\n   132\\t      (doseq [s (conj (vec subs) \\\"uncovered\\\")]\\n   133\\t        (let [f (str out \\\"/ns-\\\" s \\\".txt\\\")]\\n   134\\t          (when (.exists (fs/file f))\\n   135\\t            (let [nss (str/join \\\",\\\" (remove str/blank? (str/split-lines (slurp f))))\\n   136\\t                  d (str clone \\\"/build/cljd-agg-\\\" stamp \\\"-\\\" s)\\n   137\\t                  {:keys [exit]}\\n   138\\t                  (psh {:dir clone\\n   139\\t                        :out (str out \\\"/\\\" s \\\".emit.log\\\")\\n   140\\t                        :err :append\\n   141\\t                        :continue true}\\n   142\\t                       \\\"bb\\\" \\\"src/dev/cljd_agg.clj\\\" \\\"--only\\\" nss\\n   143\\t                       \\\"--shard-dir\\\" d \\\"--no-compile\\\" \\\"--no-run\\\")]\\n   144\\t              (if (zero? exit)\\n   145\\t                (swap! dirs conj d)\\n   146\\t                (fail! (str \\\"shard \\\" s \\\" emission failed (rc=\\\" exit \\\")\\\")))))))\\n   147\\t      (if (empty? @dirs)\\n   148\\t        (fail! \\\"no shards emitted\\\")\\n   149\\t        ;; R3: ONE flutter invocation over every emitted directory — the\\n   150\\t        ;; project-wide build/test_cache kernel is touched by one process.\\n   151\\t        (let [t0 (System/currentTimeMillis)\\n   152\\t              {:keys [exit]}\\n   153\\t              (apply psh {:dir clone\\n   154\\t                          :out (str out \\\"/all.log\\\")\\n   155\\t                          :err :append\\n   156\\t                          :extra-env {\\\"DATOM_SLOW_TESTS\\\" \\\"1\\\"}\\n   157\\t                          :continue true}\\n   158\\t                     \\\"flutter\\\" \\\"test\\\" \\\"--concurrency\\\" (str conc) @dirs)\\n   159\\t              wall (quot (- (System/currentTimeMillis) t0) 1000)\\n   160\\t              verdict (some->> (slurp (str out \\\"/all.log\\\"))\\n   161\\t                               str/split-lines\\n   162\\t                               (filter #(re-find #\\\"All tests passed|Some tests failed\\\" %))\\n   163\\t                               last)]\\n   164\\t          (log (str \\\"flutter rc=\\\" exit \\\" wall=\\\" wall \\\"s \\\" (or verdict \\\"\\\")))\\n   165\\t          (when-not (zero? exit) (fail! (str \\\"flutter test rc=\\\" exit))))))\\n   166\\t    (log (str \\\"done rc=\\\" @rc))\\n   167\\t    (System/exit @rc)))\\n   168\\t\\n   169\\t\\n   170\\t(when (= *file* (System/getProperty \\\"babashka.file\\\"))\\n   171\\t  (apply -main *command-line-args*))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n21:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat docs/agents/build-n-test.md; cat docs/agents/roles/orchestrator.md'\",\"aggregated_output\":\"---\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\n---\\n\\n# BUILD & TEST\\n\\n## Commands\\n\\n```sh\\n# Tests (Babashka runner)\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\nbb test:slow         # Only the slow tests, on every lane\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\n# (dao.test-slow/guard \\\"name\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\n# under test/), so the non-slow tests inside those namespaces also run there.\\n# On Node, shadow also runs the test namespaces those nine require (about\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\n# not subsystems). On the many-core remote hosts see \\\"Remote test servers\\\" below for\\n# which lanes may overlap.\\n#\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\n# (or `clojure -M:test -i :slow -n <ns>`).\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\n# Full repo-wide `bb test` (G3) is the mandatory landing gate on master after merge.\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\n# overlap lanes, see \\\"Remote test servers\\\" below).\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\nnpm test             # Node.js tests\\n\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\n                         # and the linker L5 Node reader that requires a module\\n                         # by name): `clojure -M:test` without it fails that test\\n```\\n\\n### Changed-only tests: `bb test:changed`\\n\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\nreach: the reverse require closure of the files changed since the\\nmerge-base with master, plus fixtures that mention a changed resource path,\\ntests that walk a changed tree, and each src file's `_test` by convention.\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\n(let-bound roots count), and a change under a root selects it. The three\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\nas for a change to the core everything requires (yin.vm engine,\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\\nand spawned programs that changed (target/yin-repl.js, Dart peers).\\n\\n### Sharded quick JVM feedback and change routing\\n\\n```sh\\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\\nbb test:routed                                 # Git change set, same base as test:changed\\nbb deps:npm                                    # Content-checked local npm ci\\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\\n```\\n\\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\\nthe JVM portion of G3. Without selection flags it selects every JVM test;\\n`--changed FILE...` or `--base REF` uses `affected/select` and\\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\\nsemantics. `--workers N` must be positive (default 4 on the laptop).\\n\\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\\n`affected/select-subsystems` and the same longest-prefix ownership rule as\\n`test:sub`. As in the shiva script below, currently unowned namespaces run\\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\\nPrerequisites are derived from the entire selected JVM reach and finish\\nserially before workers start; the Node REPL build prerequisite\\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\\n\\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\\nand `summary.edn`. Before execution it checks **set equality** between selected\\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\\nThe final summary totals tests, assertions, failures and errors and separates\\nJVM wall time from total time including selection/builds. A nonzero child exit,\\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\\nDry plans write namespace evidence but execute no builds or tests. An empty\\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\\n\\n`test:routed <changed-files...>` applies this priority table to the whole change\\nset, prints the exact dispatch, executes it and propagates its result:\\n\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Change class (first match wins)                                                              | Dispatch                                                              |\\n+==============================================================================================+=======================================================================+\\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\\n|                                                                                              | lint only                                                             |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\\n|                                                                                              | selection                                                             |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n\\nMixed changes take the widest matching route. Missing paths, an empty git change\\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\\nits zero exit is **not** a verification result. Documentation checks inspect\\nstaged and unstaged changes together against HEAD. Paths absent from\\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\\nexecutable examples or validate documentation links.\\n\\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\\nmeans the dispatched gate completed successfully, not that every landing gate\\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\\nand failed dispatches. Successful checked docs, selected tri-host, and full\\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\\nresults, so automation must inspect the scope as well as the exit code.\\n\\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\\ntri-host success: for foundation/compiler changes also run\\n`bb test:changed:cljs --changed <paths>` and\\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\\ndemo smoke checks and review/landing gates all remain required. Node and Dart\\nlanes retain their current commands. The original unsharded tasks remain\\navailable. Do not run another lane set concurrently on the laptop.\\n\\n#### Worktree-local prerequisite caches\\n\\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\\nrecorded helper/generated digests and runtime pins), the generator/cache source,\\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\\nremoved or corrupted outputs trigger a full generation, retaining the generator's\\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\\ninvalidate the complete-build stamp.\\n\\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\\nenvironment and worktree identity; it verifies the installed file tree before\\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\\nensure this dependency too. Direct `npm ci` is still available.\\n\\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\\nlock only after confirming its owning process died. Symlinked output parents\\nthat escape the worktree are refused. This is reuse **within one worktree**,\\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\\nstill require the existing worktree isolation/serialization rules; the cache\\ndoes not make overlapping builds and tests safe. Peer executables and shadow\\nbuilds themselves are not cached by this mechanism.\\n\\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\\nouter command **258.27 s**). The original `test:changed:clj` command completed\\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\\nrounds to whole seconds). The investigation's earlier unsharded command had\\ntimed out at 300 s without a summary. These are single-run observations, not\\na median/p95 claim or a replacement for tri-host landing verification.\\n\\n### Subsystem-first tests: `bb test:sub`\\n\\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\\nis by longest namespace prefix matching.\\n\\n```sh\\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\\nbb test:sub:clj <subsystem>...    # JVM lane alone\\nbb test:sub:cljs <subsystem>...   # Node lane alone\\nbb test:sub:cljd <subsystem>...   # Dart lane alone\\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\\n```\\n\\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\\n\\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\\n- **Infrastructure**: `dev`, `bench`\\n\\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:antlr`)\\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\\nselected namespaces and run automatically when needed.\\n\\n#### Gate Ladder (docs/design/test.subsystems.md)\\n\\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\\n4. **G3 Master**: The mandatory landing gate on master after merge, and for any wide change (`bb test`).\\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge (`bb test:slow` or `bb test:all`), and at each phase boundary of a multi-phase track (owner decision 2026-10-12; see \\\"Test tiers: quick and slow\\\" below). G0 to G3 run the quick tier; G4 runs the slow tier.\\n\\n\\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\\nslice L5) is two tests:\\n\\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\\n  processes over real loopback UDP. A JVM publisher with a key file\\n  publishes modules by name, and JVM and Node readers require them by\\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\\n  and checks each section 9 failure as data. Ports are ephemeral, and\\n  every wait is bounded. A run takes a few minutes. Run it alone with\\n  `clojure -M:test -n yin.repl.dht-process-test`, after\\n  `bb build:yin-repl-node`.\\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\\n  signed-name leg runs here, because no Dart `yin.repl.main` process\\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\\n  REPL.\\n\\n```sh\\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\\n\\n# ClojureDart\\nclj -M:clojuredart:cljd compile\\n\\n# Linting\\nclj -M:kondo --lint <path>\\n```\\n\\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\\n(greedy by file size; each imports its files and calls their `main`), runs\\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\\ndifferent namespaces share an isolate per shard. Failures stay attributable:\\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\\n\\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\\ncompile does not prune it when a source file is deleted or renamed. The\\naggregated lanes only run namespaces that still exist under `test/`, but a\\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\\nbefore relying on that to prove a deletion or rename took effect.\\n\\n## Test tiers: quick and slow\\n\\nThe suite has two tiers so that slow tests run less often than quick ones\\n(owner decision, 2026-10-12).\\n\\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\\n- **Slow tier:** the tagged deftests. `bb test:slow` or\\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\\n- **The tagging rule** is the one above (\\\"When to tag a test slow\\\"): a deftest that\\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\\n  in all (some were already tagged). Per-test times are not in the repo: measure again\\n  with the method below before changing the cut.\\n- **Cadence:** the quick tier at every checkpoint (G1) and landing (G2, G3); the slow\\n  tier before merging a big change and at each phase boundary of a multi-phase track\\n  (the existing G4). There is no nightly run.\\n\\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \\\"Remote test\\nservers\\\" for how to run them):\\n\\n| Run | Time |\\n|---|---|\\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\\n\\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\\n\\n**How the per-test times were measured.** To time every deftest of a namespace alone,\\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\\notherwise swallows `-e`, and every JVM runs the whole suite):\\n\\n```sh\\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\\\"test\\\"]}}}' -M:t timing.clj\\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\\n# load) is paid by the first test in file order; check before tagging that test alone.\\n```\\n\\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\\nJVM test namespace under `test/`:\\n\\n```sh\\n#!/usr/bin/env bash\\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\ncd \\\"$1\\\" || exit 2\\nPAR=\\\"${2:-8}\\\"\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nOUT=\\\"$1/target-ci/shards\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\nts() { date +%H:%M:%S; }\\necho \\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\" | tee \\\"$OUT/summary.txt\\\"\\nnpm ci --silent >\\\"$OUT/npm.log\\\" 2>&1                   && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nbb build:yin-repl-node >\\\"$OUT/build-node.log\\\" 2>&1     && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nbb gen:antlr >\\\"$OUT/antlr.log\\\" 2>&1             && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nSUBS=\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\"\\n: > \\\"$OUT/covered.txt\\\"\\nfor s in $SUBS; do\\n  bb test:sub:list \\\"$s\\\" 2>/dev/null | awk \\\"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\"\\\\\\\");print}\\\" > \\\"$OUT/ns-$s.txt\\\"\\n  cat \\\"$OUT/ns-$s.txt\\\" >> \\\"$OUT/covered.txt\\\"\\n  echo \\\"$s $(wc -l < \\\"$OUT/ns-$s.txt\\\")\\\" >> \\\"$OUT/plan.txt\\\"\\ndone\\n# coverage: every JVM test namespace under test/ vs the union of the shards\\nfind test -type f \\\\( -name \\\"*_test.clj\\\" -o -name \\\"*_test.cljc\\\" \\\\) | sed -e \\\"s#^test/##\\\" -e \\\"s#\\\\.cljc\\\\?\\\\$##\\\" -e \\\"s#/#.#g\\\" -e \\\"s#_#-#g\\\" | sort -u > \\\"$OUT/all.txt\\\"\\nsort -u \\\"$OUT/covered.txt\\\" > \\\"$OUT/covered.sorted\\\"\\ncomm -23 \\\"$OUT/all.txt\\\" \\\"$OUT/covered.sorted\\\" > \\\"$OUT/ns-uncovered.txt\\\"\\necho \\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nrun_shard() {\\n  s=$1; f=\\\"$OUT/ns-$s.txt\\\"; [ -s \\\"$f\\\" ] || return 0\\n  args=(); while read -r n; do args+=(-n \\\"$n\\\"); done < \\\"$f\\\"\\n  t0=$(date +%s); clojure -M:test -e :slow \\\"${args[@]}\\\" >\\\"$OUT/$s.log\\\" 2>&1; rc=$?\\n  echo \\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\"^Ran \\\" \\\"$OUT/$s.log\\\" | tail -1)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n}\\nexport -f run_shard; export OUT; export -f ts\\nprintf \\\"%s\\\\n\\\" $SUBS uncovered | xargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_shard {}\\\"\\necho \\\"done $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n```\\n\\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\\n\\n```sh\\n#!/usr/bin/env bash\\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\ncd \\\"$1\\\" || exit 2\\nPAR=\\\"${2:-6}\\\"\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nOUT=\\\"$1/target-ci/slowtier\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\nrun_ns() {\\n  n=$1; t0=$(date +%s)\\n  clojure -M:test -i :slow -n \\\"$n\\\" > \\\"$OUT/$n.log\\\" 2>&1; rc=$?\\n  echo \\\"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \\\"^Ran \\\" \\\"$OUT/$n.log\\\" | tail -1)\\\" >> \\\"$OUT/summary.txt\\\"\\n}\\nexport -f run_ns; export OUT\\necho \\\"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\\\" > \\\"$OUT/summary.txt\\\"\\nxargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_ns {}\\\" < \\\"$HOME/ci/pertest-ns.txt\\\"\\necho \\\"done $(date +%H:%M:%S)\\\" >> \\\"$OUT/summary.txt\\\"\\n```\\n\\n## Remote test servers: shiva and jupiter\\n\\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\\nand `git`.\\n\\n| Host | Cores / RAM | Toolchain state (server snapshot checked 2026-10-11; repo selection comes from `mise.toml`) |\\n|---|---|---|\\n| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\\n| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\\n\\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\\n\\n### Get the code there: push to origin, never rsync\\n\\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\\nwould take about an hour), and an unanchored `--exclude build` also dropped source\\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\\nbranch from the laptop (a feature branch, never master), make one scratch clone on\\nthe host from its existing checkout (a local clone takes seconds), and fetch:\\n\\n```sh\\n# once per host: a separate scratch clone, not the working copy\\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\\n  URL=$(git remote get-url origin);\\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\\n  cd ~/ci/datomworld-<name>; git remote set-url origin \\\"$URL\\\";\\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\\n```\\n\\nTo test another branch later, fetch and check it out in the scratch clone with\\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\\nwas never pushed cannot be tested remotely.\\n\\n### Activate the toolchain in the right order\\n\\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\\ninto the clone:\\n\\n```sh\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\\ncd ~/ci/datomworld-<name>\\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\\nmise install                                    # install versions selected by this checkout's mise.toml\\neval \\\"$(mise env -s bash)\\\"                       # puts the repo-selected tools on PATH\\nmise current flutter                            # verify the selected Flutter version\\n```\\n\\nActivating mise before the `cd` and `mise trust` leaves the repo-selected tools\\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \\\"Can't\\nfind flutter on PATH\\\", and so does `bb build:yin-repl-peer`.\\n\\n### Which lanes may overlap (reconciling the one-lane-set rule)\\n\\n\\\"One lane set at a time\\\" and \\\"one Dart lane at a time\\\" are per-machine rules about\\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\\n`test.subsystems.md` section 5 item 6 says the same (\\\"on one machine where\\navoidable\\\"). On shiva (24 cores) and jupiter (48) the cores are not the limit, so\\nlanes may overlap, with these limits:\\n\\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\\n  by the design's own reasoning (\\\"each worktree owns its own `cljd-out`\\\"), not yet\\n  verified by a measured run.\\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\\n  JVM lane only reads `target/yin-repl.js`.\\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\\n- **Different branches in different clones** are independent, so two branches may\\n  run on one host if its cores and RAM allow (62 GB each).\\n- Do not treat this as permission to overlap lanes on the laptop.\\n\\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\\nthis rule was written down; its results are advisory until repeated with a\\nseparate Dart clone.\\n\\n### The jolt J2 lane: run it with `--jobs` on the servers\\n\\nThe jolt lane's core mode (`bb src/dev/jolt_j2_lane.clj core [--jobs N]\\n[--only re] [--timeout-ms M]`) runs each test namespace as its own child jolt\\nprocess (own Chez VM, own native parser library load, own log under\\n`build/j2-logs/core/`), so the namespaces cannot corrupt one another — the\\nonly thing `--jobs N` overlaps is the waiting. The default is `jobs 1`\\n(strictly serial), which on jupiter makes the full ~179-namespace lane a\\n5-6-hour run.\\n\\nOn the servers, run it with `--jobs 16`:\\n\\n- jolt children are essentially single-threaded (the 16 MiB parse thread\\n  only burns during parses) and cost 1-2 GB each, so 16 concurrent children\\n  sit far inside jupiter's 48 cores / 62 GB and shiva's 24 / 62;\\n- the lane's wall time is dominated by a few long namespaces\\n  (`yin.repl.python-antlr-test` has an explicit 3-hour step,\\n  `yin.vm.semantic.safepoint-harness-test` needs one — see\\n  `step-timeout-ms` in `src/dev/jolt_j2_lane.clj`), so beyond ~16 workers\\n  the critical path is the longest child, not the count;\\n- **parallel is unproven until checked once**: the recorded lane evidence\\n  (J2 closure, the safepoint 60/265,225/0 pass) was all produced `jobs 1`.\\n  The first parallel run must be compared per-namespace against a serial\\n  baseline; any namespace that flips red gets one serial re-run to\\n  attribute before its evidence is trusted. Until that first comparison\\n  passes, keep `jobs 1` for anything whose verdict is timing-sensitive —\\n  timeout and wall-time measurements, native-memory/leak gates, and the\\n  merge-decision qualification runs.\\n\\nSuites that exceed the lane's default step budget are pinned in the lane's\\n`step-timeout-ms` map with their measured wall time; a namespace timing out\\nunder the default budget is a reason to measure it serially and add an\\nentry, not to re-run under the same bound.\\n\\n### The full run\\n\\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\\ntasks use (the `bb test` task runs them one after another), and records each\\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\\n\\n```sh\\n#!/usr/bin/env bash\\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (both hosts run all three lanes; a second clone for Dart is recommended)\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\nDART=\\\"${2:-}\\\"\\ncd \\\"$1\\\" || exit 2\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nLOG=\\\"$1/target-ci\\\"; mkdir -p \\\"$LOG\\\"\\nts() { date +%H:%M:%S; }\\necho \\\"start $(ts) $(git rev-parse --short HEAD)\\\" | tee \\\"$LOG/summary.txt\\\"\\nnpm ci --silent >\\\"$LOG/npm.log\\\" 2>&1               && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb build:yin-repl-node >\\\"$LOG/build-node.log\\\" 2>&1 && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb gen:antlr >\\\"$LOG/antlr.log\\\" 2>&1         && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb build:yin-repl-peer >\\\"$LOG/build-peer.log\\\" 2>&1 && echo \\\"dart peer built $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nlane() { name=$1; shift; s=$(date +%s); \\\"$@\\\" >\\\"$LOG/$name.log\\\" 2>&1; rc=$?\\n         echo \\\"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"; }\\nlane jvm  clojure -M:test -e :slow &\\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\\nif [ -n \\\"$DART\\\" ]; then                            # its own clone (own lib/cljd-out, build/)\\n  ( cd \\\"$DART\\\" && mise trust >/dev/null 2>&1 && eval \\\"$(mise env -s bash)\\\"\\n    bb build:yin-repl-peer >\\\"$LOG/build-peer-dart.log\\\" 2>&1\\n    lane dart bb src/dev/cljd_agg.clj ) &\\nfi\\nwait\\necho \\\"done $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\n```\\n\\n```sh\\nssh <host> 'tmux new-session -d -s ci-full \\\"bash -lc \\\\\\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\\\\\"\\\"'\\n```\\n\\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\\n`bb test:clj`. For the slow set use `-i :slow` (or `bb test:slow`); the slow C4\\nscanner row took about 11-19 minutes on the JVM and about 79 minutes on Node\\n(measured 2026-10-11).\\n\\n### Known differences from the laptop\\n\\n- **`dao.stream.datagram.dart-test/refusals-and-lifecycle-events` fails on Linux.**\\n  The assertion \\\"a bind on a taken port deposits bind-failed\\\" gets no `bind-failed`\\n  event. A second UDP bind on a taken port evidently behaves differently on Linux\\n  than on macOS (inferred, not confirmed). The test is in `dao.stream`, which the\\n  semantic-register slices do not touch: treat it as a known Linux-only failure,\\n  not a regression, until it is fixed or guarded.\\n- A JVM lane started before the Dart peer is built skips the Dart-peer tests with a\\n  printed notice. The script builds the peer first so they run.\\n- Both hosts run other work (a QEMU guest and rustdesk on shiva); idle load is\\n  under 1, but timings are not a clean benchmark.\\n\\n### The nightly full suite and the branch-testing rule (2026-10-30 owner ruling)\\n\\nOwner, verbatim: \\\"since the complete test can take a good 7-8hrs to run\\ncompletely, it should be schedule to run once a day at 3am. while\\nbranch/worktree test should only run test that are targeting code\\nchanges\\\" — and, clarifying the nightly's target: \\\"it should not be for\\nonly a worktree/branch. the nightly complete test should be for master.\\\"\\n\\nTwo tiers, by target and purpose:\\n\\n- **The nightly full suite runs MASTER ONLY** (`~/ci/nightly-full.sh` on\\n  shiva, tmux session `nightly`, scheduled 03:00 daily through the\\n  orchestrator's automation; it fetches and checks out origin/master\\n  before anything runs). Every lane, every host target: the JVM full\\n  suite, the full Node suite, the full Dart suite. Its results are a\\n  post-hoc integrity net for master, NOT a landing gate. Failures it\\n  finds route to fix rounds the next morning.\\n- **Branch/worktree testing runs only the namespaces that target the\\n  changed code** (the diff's own tests plus the surfaces the diff\\n  touches), one JVM per namespace, plus one cheap portable lane (Node)\\n  when cljc goldens or fixtures moved. Never the full tier on a branch:\\n  a branch gate needs the changed code proven, not the whole tree\\n  re-proven. A branch is never promoted by its own testing — the merge\\n  to master is what puts it under the nightly.\\n\\nAn orchestrator landing a slice cites the subset runs plus the gate\\nsign-off; the nightly catches what the subset could not see, and a red\\nnightly owns the follow-up.\\n\\n### Measured times (first runs, 2026-10-11, commit 84c7c9b7, all lanes concurrent)\\n\\nShiva, Dart lane: 1054 s (17.5 min) cold, with the JVM and Node lanes running beside\\nit, against about 9 minutes on the 8-core laptop run alone. Prerequisites (`npm ci`,\\nNode REPL, ANTLR) took about 30 s; the Dart peer 91 s. JVM and Node lane times are\\nnot recorded yet: fill them in from `summary.txt` after a completed run. Running the\\nlanes concurrently on one host did not make the Dart lane faster, so count on the\\nextra cores and a free laptop, and measure before relying on a speedup.\\n\\n### Jupiter verification run (2026-10-29, commit 7c0a078f, scratch clone, sequential lanes)\\n\\nFirst full tri-host verification of jupiter. Prerequisites (npm ci, Node REPL,\\nANTLR via `gen:antlr`, Dart peer) all succeeded; the stale 3.41.9 Flutter was\\nreplaced with 3.47.8 before the Dart lane. Results: **JVM quick tier\\n(`test:quick-sharded`, 12 workers) rc=0 in 702 s** (cold, every shard green);\\n**Node quick tier rc=0 in 4583 s** (all tests pass, but roughly 15x the\\nlaptop — route Node lanes to the laptop or shiva); **Dart quick tier\\nrc=1 in 1495 s with the ONLY failure the documented known Linux-only red**\\n(`dao.stream.datagram.dart-test/refusals-and-lifecycle-events`, same\\ntaken-port/bind-failed signature recorded above). Routing summary: jupiter\\nis the preferred JVM/sharding box (48 cores); Node stays off it when wall\\ntime matters; Dart works on either host. Timings are single cold runs, not\\nmedians, and two foreign QEMU guests idle on the host.\\n\\nOne exception to the concurrency above: never run two lanes that both trigger\\n`gen:antlr` (the quick `test:cljs`/`test:cljd` tasks) in the SAME worktree at the\\nsame time — they race on `build/antlr` and `lib/antlr` and fail with\\n\\\"Patch does not apply\\\" or \\\"Generated sources differ from the recorded digests\\\".\\nRun them sequentially, or in separate clones (as the slow-tier harness does).\\nThe fix after a collision is `rm -rf build/antlr lib/antlr` and a rerun; the\\ngenerator is not idempotent over an already-patched tree. Corroborated twice in\\none week (the M3 round and the C3 completion round, 2026-10-18).\\n\\n### Remote agent execution (delegate CLIs on shiva and jupiter)\\n\\nOwner relay, 2026-10-24: the delegate agent CLIs — `claude`, `codex`, `glm` —\\nare installed and usable **on the remote hosts themselves**, not only from the\\norchestrator's laptop. This generalizes this section from \\\"run tests remotely\\nover SSH\\\" to \\\"delegate whole work agents remotely\\\": a heavy implementation or\\nverification leg (test lanes, native builds, fault-injection runs, multi-hour\\nsuites) can be executed by a delegate agent running on the server, keeping the\\norchestrator's laptop unloaded.\\n\\nThe pattern (composed from the rules above plus the delegate-invocation\\nreference):\\n\\n1. **Land the branch on origin first** (push from the laptop; never rsync) and\\n   prepare the scratch clone per \\\"Get the code there\\\".\\n2. **Start a named tmux session** for the task; run the agent inside it with\\n   the toolchain activated *inside* the tmux command (`eval \\\"$(mise env -s\\n   bash)\\\"` after the `cd` — the non-interactive SSH shell does not have it).\\n   A fresh clone hits mise's interactive trust prompt, which blocks the whole\\n   session until answered via `tmux send-keys`; pre-empt it with `mise trust`\\n   inside the same command.\\n3. **The remote agent works in the clone**: implement, build, run lanes,\\n   write its findings artifact — the same brief form as any delegate dispatch\\n   (role template, bounded file ownership, deliverable path), just executing\\n   on the host. Long jobs survive SSH drops because of tmux.\\n4. **The orchestrator polls detached files, never the pane** (pane captures\\n   carry control characters that make output look empty): rc files, summary\\n   logs and `ls *.flag` sentinels written by the run.\\n5. **Division of labor**: bookkeeping and polling are orchestrator SSH\\n   one-liners; execution belongs to the remote agent. Do not run heavy lanes\\n   from the orchestrator's laptop while a remote agent owns the same gate.\\n6. **Same trust rules as any delegate**: remote execution does not waive\\n   Workflow steps 6–7 of the orchestrator role — artifacts are verified, and\\n   review before commit applies to remote-produced work identically.\\n   Session-ID capture and resume rules from the delegate-invocation reference\\n   apply per host (each host's `~/.claude`, `~/.codex` store is its own).\\n\\nKnown state: `claude` and `codex` verified working on shiva (2026-10-24, the\\njolt canonical-fixes verification ran there); `glm` reported available by the\\nowner on both hosts, not yet exercised. Both hosts are toolchain-verified for\\nthe full tri-host suite (jupiter verified 2026-10-29 — see Measured times;\\nits 3.41.9 Flutter was replaced with 3.47.8, and model availability per\\nhost is governed by `routing-status.md`, not this file).\\n\\n## Testing Philosophy & TDD\\n\\nWrite tests before implementing features (TDD).\\n\\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\\n\\nWhen implementing a feature or fix:\\n1. **Red phase**: Write the test first — define what should happen.\\n2. **Green phase**: Implement the minimum code to pass the test.\\n3. **Refactor phase**: Refactor if needed while keeping tests green.\\n\\nThis ensures code is testable by design and implementation matches actual requirements.\\n\\n## Debugging Malformed CLJ / EDN / CLJS\\n\\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\\n\\n1. **Run clj-kondo first**:\\n   ```sh\\n   clj -M:kondo --lint path/to/file.cljs\\n   ```\\n\\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\\n\\n3. **Fix one bracket at a time, re-run checker after each fix**:\\n   Common patterns:\\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\\n   - Both can coexist while total bracket count is zero-sum.\\n\\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\\n\\n**The merge precondition (2026-10-30 owner ruling, restored 2026-10-31 —\\na dedup pass dropped this section along with a stale duplicate of the\\ntwo-tier policy above; both stand):** before any merge into master, the\\n`dao.stream` tests must run and pass — dao.stream is what everything is\\nbuilt on. Concretely: `bb test:sub dao.stream` (the subsystem's tests,\\n`--slow` when the slice touches slow-guarded surfaces) is part of every\\nbranch gate regardless of which subsystems the diff's own changes\\nselect, because a change can break the foundation without touching it.\\nA red dao.stream blocks the merge until fixed or diagnosed as\\npre-existing by the owning seat.\\n---\\ndescription: Lead Engineering Orchestrator role definition for datom.world\\n---\\n\\n# ROLE: Lead Engineering Orchestrator\\n\\n## Domain Scope\\n\\n- Task scope, authorization boundaries, and phase completion criteria\\n- Complete ownership of task routing and role assignments as defined in [`team.md`](../team.md)\\n- Timestamped file-based handoffs, the append-only work log, session reuse,\\n  and delegated-agent patience\\n- Independent verification, finding reconciliation, and consensus\\n- Verification and commit-readiness reporting\\n\\nThis role owns no permanent file list. Each task defines the artifacts under\\ncoordination and the authority granted to every participant.\\n\\n## Scope of judgment\\n\\nThis role is a secretary, not a decision-maker: it tracks status, routes\\nwork, runs mechanical verification, and makes simple, reversible decisions —\\nnever complex judgment calls, which are always escalated to an Architect\\ndelegate (design/architectural questions) or the user (authorization, scope,\\npriority questions). This scoping is what makes the role viable on a small\\nor fast model: a flash-tier model can reliably do the secretarial half of\\nthis job, but cannot reliably weigh architectural tradeoffs or judge how far\\nan ambiguous instruction reaches.\\n\\nConcretely:\\n\\n- **Simple, orchestrator-owned decisions:** which delegate to route a task to\\n  (per `team.md`'s routing rules), whether local verification passed, whether\\n  a reviewer's finding is already reconciled, file/artifact bookkeeping,\\n  whether to retry a quiet-but-healthy delegate, and implementing small,\\n  low-risk changes directly per Workflow step 4 (e.g. a typo fix, a\\n  mechanical rename, a doc cross-reference update) rather than delegating\\n  them — \\\"simple\\\" here means no choice between competing approaches and no\\n  effect on behavior beyond the literal request.\\n- **Complex, always escalated decisions:** any architectural or design\\n  tradeoff, or any implementation choice that involves picking between\\n  competing approaches rather than a single obvious mechanical change (route\\n  to an Architect delegate, don't reason it out yourself); whether an\\n  ambiguous instruction authorizes a specific consequential action it didn't\\n  state explicitly — e.g. does \\\"make the edit\\\" also authorize committing it,\\n  does \\\"review this\\\" also authorize implementing the fix (ask the user,\\n  don't infer); weighing a reviewer's finding against the design's own\\n  intent when they conflict (route back to the Architect or the user, don't\\n  adjudicate it); any call that would change scope, authorization\\n  boundaries, or what \\\"done\\\" means for the current task (ask the user).\\n- When genuinely unsure which bucket a decision falls in, treat it as\\n  complex and escalate — the cost of an unnecessary question is far lower\\n  than the cost of an orchestrator-level model making an architectural or\\n  authorization call it wasn't equipped to make.\\n\\n## Coordination contract\\n\\nThe orchestrator owns scope, authorization, verification, consensus, and\\nreadiness; the Workflow section owns the sequence.\\n\\n**Commit authority** (2026-10-26 owner ruling). Staging, committing, merging\\nto master, and pushing are authorized by exactly one of:\\n\\n- **An Architect sign-off** ([`architect.md`](architect.md)) on completed\\n  work whose step 7 review has finished and whose findings are reconciled.\\n  The sign-off covers exactly the signed-off work, never unrelated changes\\n  that happen to be in the tree.\\n- **An explicit user instruction.** Only the user can waive step 7 review\\n  (2026-09-23 owner ruling).\\n- **The trivial-edit exemption.** A trivial direct edit as defined in Scope\\n  of judgment (a typo fix, a mechanical rename, a doc cross-reference\\n  update: no choice between approaches, no behavior change) needs neither\\n  review nor sign-off.\\n\\nLocal verification (step 6) is never a substitute for any of these. History\\nrewrites (amend, revert, reset) are outside all three, with one exception: an\\nunauthorized pre-review commit that is local, unpushed, and unmerged is\\nsoft-reset and the work goes through review, never reviewed after the fact.\\nAny other rewrite needs the user.\\n\\nFor cost constraints and CLI routing caveats, see [`team.md`](../team.md)'s\\n**Available Subscriptions & Cost Constraints** table. For current, session-\\nindependent owner-relayed availability and budget status (an outage, a\\nnarrowed authorization, a near-empty quota), see\\n[`routing-status.md`](../routing-status.md) — check it before routing to a\\nmetered destination, and add an entry when the owner relays a new status.\\n\\n## Artifact protocol\\n\\nCoordination is through repository artifacts, not hidden context. Keep all\\nartifacts flat under `collab/`:\\n`<timestamp>-<role>-<task>.prompt.md`, `<timestamp>-<role>-<task>.<sanitized-model>.findings.md`, and `<timestamp>-<role>-<task>.<sanitized-model>.stdout.log`.\\nThe `<timestamp>` prefix is a UNIX millisecond timestamp (e.g. `1725791234567`) so files sort\\nchronologically in Git's untracked view; `<sanitized-model>` prevents parallel reviewers from colliding.\\n\\nEvery prompt starts with:\\n\\n```text\\nCreated-GMT: <actual timestamp>\\nCreated-Local: <actual timestamp and named timezone>\\nCoding-Agent: <claude|claude-cloud (claude-api lane)|codex|agy|glm|cmd|muse|deepseek|kimi|interactive>\\nSession-ID: <exact caller UUID | pending (provider-generated) | not-applicable (interactive seat)>\\n# Task: <name>\\nRole: <constant role>\\nImplementers:\\n- Model: <model> | Assigned: <timestamp> | Status: active | Rationale: <why>\\n```\\n\\nEvery report starts with the same header fields. Use actual timestamps; never fabricate them.\\n\\n`collab/` is append-only and never staged or committed while its artifacts\\nare in flight, and must never be added to `.gitignore` or\\n`.git/info/exclude` so its files stay visible and chronologically sorted in the user's Magit untracked\\nview. In-flight artifacts stay untracked; they leave the flat in-flight\\nspace only through the archive step (Workflow step 11), which files them\\ninto `collab/`'s git-tracked topic subfolders. The two states live in\\ndifferent worlds: the committed topic subfolders are on the master\\nbranch (pushed to origin — master's collab/ subfolders are the durable,\\ndurable-per-seat-readable record), while an in-flight artifact exists\\nonly as an untracked file in the checkout that created it — invisible\\nfrom other checkouts and from every branch until it is committed. This\\nvisibility split is why a merged worktree's collab files must be\\ncommitted before that worktree is deleted (the worktree-deletion rule\\nabove). Promote final responses to\\n`.findings.md`; `.stdout.log` is only\\nan intermediate capture.\\n\\nOn reassignment, append history inside `Implementers:`; never rewrite an earlier `Status:` line:\\n\\n```text\\n- Status-Event: <timestamp> | Model: <prior-model> | Status: <failed|timed-out|reassigned|superseded> | Rationale: <why>\\n- Model: <new-model> | Assigned: <timestamp> | Status: active | Rationale: <why>\\n```\\n\\nUse `superseded` when a dispatch is killed or abandoned mid-flight because a new\\ninstruction changed what should be done, not because the delegate failed — this is a\\ndistinct case from `failed`/`timed-out` and should read that way in the artifact trail,\\nnot be inferred from a missing final report.\\n\\nRead-only reviewers may share the main tree. Concurrent editors use separate\\nworktrees from a committed base; uncommitted bases require serialization or\\nexplicit disjoint ownership. Only one process owns the CLJD lane because\\n`bb test:cljd` writes shared generated output. Auxiliary worktrees lack\\n`collab/`, so briefs use absolute paths, and delegates there often stage\\ntheir own reference copies of prompts/findings in a local `collab/`. Before\\nremoving a worktree, diff its `collab/` against the main tree's and copy\\nover anything unique — a worktree merge moves only committed content.\\nUnder the one-record `collab/` regime this is not a copy-out burden:\\ncollab files generated in a worktree are added to git there (step 11's\\n`docs(collab):` commit) and reach master through the merge. A worktree\\nis deleted only after its work has been successfully merged to master\\nunder that authority — or on user instruction, which is a deliberate\\ndiscard. Because deletion follows the merge, the merged content is\\nalready canonical; confirm only that no other uncommitted file in the\\nworktree is being lost (a closed round has none: its artifacts were\\ncommitted at round-close). Never run `git checkout --` or `git clean`\\non a worktree just to make it removable: that destroys in-flight work\\n(observed 2026-10-26, when P3 oracle fixtures were lost this way).\\n\\nBatch complete briefs, reuse sessions for related follow-ups, start new sessions for unrelated work, and never rely on CLI `--last` flags. Session-ID generation, capture, and resume rules for\\nevery delegate CLI live in\\n[`delegate-invocation-reference.md`](../delegate-invocation-reference.md#session-continuity),\\nnot here.\\n\\n## Work log\\n\\nEvery orchestrator session starts its own log at session start. Create it at\\nthe repository root as\\n`orchestrator-logs/<unix-time-stamp>-<coding-agent>-<model>-<brief-description>.md`,\\nusing the actual Unix timestamp (`date +%s`) and a short lowercase,\\nhyphen-separated description. Each orchestration is independent: never append\\nto `docs/orchestrator-log.md` or to another session's file, even when the new\\nsession continues an earlier task. When continuing a task, reference the prior\\nsession's log path in the new log's first entry and final handoff instead of\\nsharing or copying the file.\\n\\nThe current session's log is the seat's durable memory. Three entry kinds\\nonly: one per coherent unit (a delegated round, a fix, a review reconciliation,\\na readiness report), an unfinished-work entry when work stops before the next\\nunit finishes, and a final handoff entry when the seat is passed on. It records\\ncompleted and stopped units only; in-flight state lives in `collab/`,\\nreferenced by filename and session ID rather than duplicated.\\n\\nStart every entry with actual timestamps and identity fields (never fabricate\\nthem), then state what `git log` alone cannot re-derive:\\n\\n```text\\n## <YYYY-MM-DD HH:MM:SS local-timezone-name> — <task name>\\nCompleted-GMT: <YYYY-MM-DD HH:MM:SS GMT>\\nCoding-Agent: <one of the values in the prompt header above>\\nSession-ID: <exact Session-ID | not-applicable (interactive seat)>\\nTree: <branch>@<short-sha>, <committed | uncommitted changes: <files>>\\nDone: <what changed and why, with paths>\\nDecisions: <choices made, alternatives rejected, and their reasons>\\nVerification: <exact commands with outcomes and assertion counts; name unrun checks>\\nDelegates: <role/model, prompt and findings filenames, session IDs> | none\\nNext: <the next coherent unit, open risks, blockers>\\n```\\n\\nWithin its owning session, the log is append-only: never edit, reorder, or\\ndelete an earlier entry — a correction is a new entry naming what it corrects.\\nWhen an entry names a `collab/` artifact, repeat its session ID so a successor\\ncan resume that session under the continuity rules above. The log may describe\\nwork that was never committed or has since been superseded: the tree is\\ncanonical, so a successor creates its own log and still re-derives state from\\n`git log`, `git status`, and the real diff, treating every prior log entry as a\\nclaim to verify rather than authority.\\n\\n## Authorization and security\\n\\nPrivate repository content may be sent externally only with explicit user\\nauthorization for the exact payload and destination. Invoke from the authorized\\nagent; consent does not carry over. Pass prompt paths or stdin, never private\\ndiffs or credentials in arguments. Use read-only/plan review and minimum write\\nscope; never bypass permission checks. Preserve unrelated changes and never\\nexpose or commit tokens or configuration.\\n\\n## Workflow\\n\\nThis section owns the execution sequence. Roster, role routing, and reviewer\\nindependence are defined in [`team.md`](../team.md); CLI flags and recipes are\\ndefined in [`delegate-invocation-reference.md`](../delegate-invocation-reference.md);\\ncommit message format is defined in [`format.md`](../format.md#git-commit-messages).\\n\\n1. **Establish the seat.** The harness must be able to read and write the working\\n   tree, run every affected host's checks, and invoke delegate CLIs. Establish\\n   those capabilities before accepting work. At session start, create this\\n   session's own `orchestrator-logs/<unix-time-stamp>-<coding-agent>-<model>-<brief-description>.md`\\n   file under the repository root as specified in Work log. If a required\\n   capability is missing, report it and do not issue a blind sign-off.\\n2. **Re-derive state and authority.** Read `git log`, `git status`, and the real\\n   diff; snapshots and phase summaries may be stale. Read\\n   [`docs/agents/routing-status.md`](../routing-status.md) for current\\n   owner-relayed delegate availability and budget constraints. When explicitly\\n   continuing an earlier orchestration, read its referenced prior log as\\n   historical claims, never as a file to append to. Bound the user's authorized\\n   files, tools, payloads, and external destinations.\\n3. **Define the contract.** Express the task as tests or equally precise\\n   acceptance criteria, invariants, phase-completion criteria, and bounded file\\n   ownership.\\n4. **Choose execution and review routes.** Follow the role selection and reviewer independence rules in\\n   [`team.md`](../team.md). Implement simple, low-risk work directly when delegation would cost more in\\n   coordination, tokens, or review. Otherwise, assign a specialized implementation role to the optimal\\n   model per `team.md`'s model tables; its cost-constraint table takes precedence over model fit. Add\\n   Architect or Security review when the role or risk requires it.\\n5. **Brief and execute.** When delegating, use the selected role's delegation\\n   prompt template — [`team.md`](../team.md)'s Roster table links each role\\n   name to its template file under `docs/agents/roles/`; do not improvise a\\n   brief from the roster's one-line description alone. Keep the brief\\n   concise and unambiguous. When it relays an owner\\n   instruction that is being reinterpreted, corrected, or applied to a design\\n   (not simply passed through verbatim), quote the owner's exact words and\\n   label them as a quote, kept visibly separate from your own paraphrase of\\n   what they mean — a paraphrase fused into one voice hides the gap where a\\n   misreading survives to execution instead of being caught first (this\\n   happened in this project's own history: an ambiguous \\\"no legacy support\\\"\\n   instruction was paraphrased as \\\"drop the old algorithm entirely,\\\" the\\n   opposite of what was meant, and nearly reached a delegate before the owner\\n   caught it). If a plausible alternate reading of the owner's words exists,\\n   ask before dispatching rather than letting a delegate execute an\\n   unconfirmed interpretation. A delegate's exit code or promise is not a\\n   deliverable: inspect the artifact and resume an unfinished turn. Quiet\\n   output is not failure; wait for completion or an explicit error. Do not\\n   terminate a healthy agent merely because it is quiet for several minutes\\n   (especially true for DeepSeek).\\n6. **Verify locally.** Inspect the actual artifact and diff and run the focused\\n   checks in the orchestrator's environment. Delegated test claims are untrusted.\\n   User-run results count as evidence only when the exact command, output, and\\n   tested revision are available; otherwise run the checks. Tell later reviewers\\n   which checks already passed so they spend their budget on static analysis\\n   instead of redundant suites, except when security review requires a rerun.\\n   Heavy verification and implementation legs need not run on the\\n   orchestrator's own machine: delegate agents (`claude`, `codex`, `glm`) can\\n   execute on the remote test hosts directly — see\\n   [`build-n-test.md`](../build-n-test.md), section \\\"Remote agent execution\\\"\\n   (the laptop-unload rule: bookkeeping locally, execution remotely).\\n7. **Review and reconcile.** Give the verified diff to an independent reviewer\\n   before committing (exceptions: the coordination contract's user waiver and\\n   trivial-edit exemption). Weigh findings on their merits, fix accepted\\n   defects, and resume the same reviewer to confirm the correction. Preserve\\n   every round.\\n8. **Report readiness.** Report exact commands, assertion counts, reviewer\\n   sign-off, unrun checks, unreviewed changes, unresolved risks, and any tool or\\n   hook noise. Do not let the summary outrun the evidence. Append the unit's\\n   entry to this session's own file under `orchestrator-logs/` in the same terms.\\n9. **Stage, commit, and merge only when authorized** under the coordination\\n   contract's commit authority. Stage only the authorized work, inspect the\\n   staged diff immediately before committing, and commit only that diff.\\n   Use the commit message format in\\n   [`format.md`](../format.md#git-commit-messages).\\n10. **Verify what landed.** Compare the commit's diff with the authorized\\n    staged diff. If hooks or formatters changed what landed, review that delta and\\n    rerun its affected checks — the pre-commit formatter hook can stage files\\n    you never added (observed 2026-10-26: an untracked in-flight file of\\n    another track was swept into a ledger commit; caught only by reading the\\n    post-commit `--stat` against intent). A failure means the work is not\\n    ready; rewrite history only as the coordination contract allows.\\n    **Shared append-only ledgers (`docs/agents/known-gaps.md`) have a merge\\n    rule** (2026-10-26, after merge 4d6fd818 silently dropped ~66 rows by\\n    replacing the file with a rewritten 16-row variant): never resolve a\\n    ledger conflict by taking one side's file, and never land a rewritten or\\n    reformatted ledger inside a feature merge. The ledger is append-only\\n    ROW-WISE: the only correct resolution is the union of both sides' rows\\n    under the existing column schema; a schema change is a proposal to the\\n    work log, agreed by seats, executed as a row-wise migration. Before\\n    pushing any commit or merge that touches the ledger, count rows on both\\n    parents and on the result — the result must be at least max(parents):\\n    `git show <rev>:docs/agents/known-gaps.md | grep -c '^|'`. A smaller\\n    number means you just dropped another seat's rows; restore per the union\\n    rule before pushing.\\n11. **Archive completed-task artifacts.** When collaboration artifacts are no\\n    longer needed for active collaboration (their task is committed or its\\n    track is otherwise closed), move prompts, findings, and logs from the\\n    flat in-flight space of `collab/` into git-tracked, subsystem-organized\\n    subfolders of the same directory (e.g. `collab/yang-python/`,\\n    `collab/dao-stream/`, `collab/yin-ucf/`, `collab/yin-linker/`) under\\n    their exact filenames. There is no separate archive root: `collab/` IS\\n    the collaboration record, flat untracked files at its root are the\\n    in-flight workspace, and its topic subfolders are the archive\\n    (2026-10-31 owner ruling, superseding the 2026-10-17 separate-top-level-\\n    archive ruling: the archive and the collaboration directory are one\\n    version-controlled location). The archived subfolders are under version\\n    control deliberately — the git history is the historical record of the\\n    collaboration — so every archive batch is committed (and pushed) as\\n    `docs(archive):` or `docs(collab):`; an archive that is not committed is\\n    not an archive. Do not leave archived files untracked, and do not invent\\n    intermediate locations. Do not dump them flat into the `collab/` root\\n    (that space is for in-flight artifacts, kept untracked and chronologically\\n    sorted in the user's Magit untracked view). Organize archived files by\\n    design subsystem, not by generic slice codes or temporary folder names:\\n\\n    - **The subsystem is defined by the code, not by the seat.** When the work\\n      belongs to a subsystem in [`src/dev/subsystems.edn`](../../../src/dev/subsystems.edn)\\n      (the same registry `bb test:sub` uses), the destination folder is that\\n      subsystem's name with dots replaced by dashes (`yang.python` ->\\n      `collab/yang-python/`, `yin.vm` -> `collab/yin-vm/`). Do not invent a\\n      variant spelling of a subsystem that exists.\\n    - **Check before creating.** Before creating any new destination folder,\\n      list `collab/`'s existing subfolders and reuse one when the work belongs\\n      there — including cross-cutting categories that predate the subsystem\\n      registry (`collab/orchestration/`, `collab/general/`, and track\\n      categories like `collab/dao-star/`, `collab/jolt/`). A new folder is\\n      created only when no existing subfolder fits; name it after the\\n      subsystem when there is one, otherwise after the durable track or topic\\n      (never a date, a slice code, or a seat name).\\n    - **One artifact, one destination.** Same-named collisions resolve by\\n      content comparison, never by size or ending heuristics: identical bytes\\n      drop the duplicate; differing same-name artifacts are kept as suffixed\\n      variants (the `-b`, `-r2` convention) — neither copy dies.\\n\\n    Never delete, truncate, rename, or overwrite an artifact;\\n    use `mv -n` and leave collisions in the flat in-flight space until the\\n    reused task name is resolved. Archive only committed work and only when\\n    no uncommitted tracked changes could make task ownership ambiguous.\\n\\nIf the remaining budget cannot finish the next coherent unit, leave the tree\\nreadable and record incomplete work in the findings rather than leaving a\\nhalf-applied edit, and append the unfinished-work entry naming what remains\\nso a successor can continue it.\\n\\n## Orchestrator Seat Handoff Template\\n\\nUse this template only when handing the entire orchestrator seat to another\\nagent. Implementation and review delegates use their own role templates; they\\nmust not select or invoke further agents unless the user's authorization and\\ntheir brief explicitly grant that coordination role.\\n\\n```text\\nCreated-GMT: <YYYY-MM-DD HH:MM:SS GMT>\\nCreated-Local: <YYYY-MM-DD HH:MM:SS local-timezone-name>\\nCoding-Agent: <coding-agent-or-cli>\\nSession-ID: <caller-generated UUID | pending (provider-generated) | not-applicable (interactive seat)>\\n\\n# Task: <Task Name>\\n\\nRole: Lead Engineering Orchestrator\\n\\nImplementers:\\n- Model: <model-name> | Assigned: <YYYY-MM-DD HH:MM:SS local-timezone> | Status: active | Rationale: Initial assignment\\n\\nCoordinate <phase-or-task> in <repository-root>.\\n\\nRead first:\\n- <governing-design-file>\\n- <current-phase-status>\\n- <relevant-source-and-test-files>\\n- <prior-orchestrator-log-path-if-explicit-continuation> (historical claims only; do not append)\\n- `docs/agents/routing-status.md` (current owner-relayed delegate availability and budget status)\\n- `docs/agents/delegate-invocation-reference.md` (session-ID mechanics, CLI flags, and recipes)\\n\\nEvery claim in this brief, in any prior orchestrator log, and in\\nrouting-status.md is something the outgoing seat believed at handoff time, not\\nverified fact — re-derive tree state yourself from `git log`, `git status`, and\\nthe real diff before acting on any of it, the same posture this role's own Work\\nLog section requires of any successor.\\n\\nRequired workflow:\\n- Follow `docs/agents/roles/orchestrator.md#workflow` in order.\\n- Create a new session log at `orchestrator-logs/<unix-time-stamp>-<coding-agent>-<model>-<brief-description>.md`; never append to the prior session's log.\\n- Run <focused-test-command> and <lint-command> locally.\\n\\nDo not broaden scope; do not stage, commit, or merge without an Architect\\nsign-off or explicit user instruction; do not trust\\ndelegated test claims without local evidence, or terminate a healthy agent\\nmerely because it is slow or temporarily quiet.\\n\\nBegin the final response exactly with:\\nCompleted-GMT: <YYYY-MM-DD HH:MM:SS GMT>\\nCompleted-Local: <YYYY-MM-DD HH:MM:SS local-timezone-name>\\nCoding-Agent: <same coding agent used for the run>\\nSession-ID: <exact initial Session-ID value, with provider-generated value promoted after capture>\\n\\nThen report delegated roles/models, prompts and session IDs, verified findings,\\ntest outcomes, unresolved risks, and whether the phase is ready to commit.\\nAppend the final handoff entry to this session's new log before responding,\\nreferencing the prior session's log path when continuing earlier work.\\n```\\n\\n## Delegate Invocation Reference\\n\\nCLI flags, canonical recipes, and known quirks for every delegate CLI\\n(claude, claude-cloud [the claude-api lane wrapper], glm, deepseek, muse, codex, cmd, agy, kimi) live in\\n[`delegate-invocation-reference.md`](../delegate-invocation-reference.md),\\nnot here — read it before shelling out to any delegate CLI. It is reference\\nmaterial needed at the moment of dispatch, not on every orchestrator turn,\\nwhich is why it is kept separate from this role's core identity and workflow.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n23:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'nightly-full|nightly-jvm|run-id|unpinned|node-shards|dart-shards' src/dev collab -g '*.sh' -g '*.clj' -g '*nightly*'\\\"\",\"aggregated_output\":\"collab/1793512000000-reviewer-nightly-plan-re-review.prompt.md:13:  dir node-shards-$STAMP with -latest symlink; expected-vs-completed shard\\ncollab/1793512000000-reviewer-nightly-plan-re-review.prompt.md:26:- Host wrappers (~/ci/nightly-full.sh on shiva, ~/ci/nightly-jvm.sh on\\ncollab/1793512000000-reviewer-nightly-plan-re-review.prompt.md:27:  jupiter, deployed from this change): shiva publishes {run-id, sha,\\ncollab/1793512000000-reviewer-nightly-plan-re-review.prompt.md:28:  timestamp} atomically (tmp+mv) with a Vietnam-date run-id; jupiter accepts\\ncollab/1793512000000-reviewer-nightly-plan-re-review.prompt.md:29:  ONLY a same-Vietnam-date run-id (refuses stale pins — your R4 race), verifies\\ncollab/1793512000000-reviewer-nightly-plan-re-review.prompt.md:30:  the object locally with one refetch retry, falls back to \\\"unpinned\\ncollab/1793512000000-reviewer-nightly-plan-re-review.gpt-6.1-sol.stdout.log:11:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/1793466815000-reviewer-nightly-testing-plan.gpt-6.1-sol.findings.md'\\\",\\\"aggregated_output\\\":\\\"I’ll use the code-review-pr skill to compare the plan with the scripts and repository rules, then give an explicit verdict for each question. I’ll keep the review read-only and return findings here.\\\\n\\\\n===\\\\n\\\\nThe Dart runner can create up to eight inner shards per subsystem, so four concurrent Flutter commands may launch up to 32 test workers. I’m checking the fixture hazards and coverage checks next. The host-only scripts aren’t in this checkout, and sandboxed SSH couldn’t resolve shiva; I’ll try a read-only SSH inspection.\\\\n\\\\n===\\\\n\\\\nThe deployed scripts have two coverage blockers: Dart computes the `uncovered` list but never emits or runs it, and the nightly JVM command still excludes `^:slow` tests. Both new shard scripts also finish with exit 0 after recording red shards. I’ll check the pin freshness and log retention before finishing the review.\\\\n\\\\n===\\\\n\\\\n**Overall: REVISE before wiring either shard script into the nightly.** The approach is reasonable, but the deployed implementation can omit tests, accept yesterday’s pin, report success after failures, and overwrite diagnostic evidence.\\\\n\\\\nI inspected the scripts on both hosts, local checkout `2bd42461`, shadow-cljs 3.3.5’s runner source, and shiva’s installed Flutter test compiler. No files were written and no test suites were launched.\\\\n\\\\n1. **R1 — FAIL: the coverage diff proves planned membership, not execution.**\\\\n\\\\n   Two concrete omissions already exist:\\\\n\\\\n   - **Dart’s residual never runs.** `shiva:~/ci/dart-shard.sh:36–43` computes `ns-uncovered.txt` and includes it in compilation, but the emission and execution loops at lines 49 and 70 iterate only `$SUBS`. Compilation does not execute those tests.\\\\n   - **The nightly JVM lane excludes slow tests.** `jupiter:~/ci/shard-jvm.sh:30` invokes `clojure -M:test -e :slow`. `nightly-jvm.sh:55` calls this script and never calls `slow-tier.sh`. Consequently, the deployed nightly is not the stated full JVM suite.\\\\n\\\\n   Further gaps:\\\\n\\\\n   - Node’s runtime selector silently ignores unknown namespaces: shadow-cljs’s `shadow/test/node.cljs`, `find-matching-test-vars` and `execute-cli`, filter registered vars without validating every requested namespace. A partial or empty selection can therefore exit successfully.\\\\n   - Cross-host peer prerequisites are incomplete. Node’s shard script builds the Node REPL but not `build:yin-repl-peer`; neither does the JVM shard script. [bb.edn:248](/Users/sto/workspace/datomworld/bb.edn:248) documents that missing peers cause tests to skip. An existing peer can also belong to an older commit.\\\\n   - Disk enumeration covers conventional `test/**/*_test.<lane-extension>` files. It does not inherently cover generated namespaces, dynamically registered namespaces, additional discovery roots, or future naming conventions.\\\\n\\\\n   Reader-conditional namespaces with no tests on a particular lane are legitimate exclusions. Parameterized tests generated inside a selected namespace should execute normally; separate generated namespaces require explicit discovery. I found no namespace/path mismatch among the current 335 conventional test source files, so path conversion is not a demonstrated current omission.\\\\n\\\\n   **Required:** run Dart’s residual; include JVM slow tests; rebuild required peers at the selected SHA; reconcile planned namespaces against fresh runtime/generated test inventories, recording explicit lane exclusions. Fail on unexplained missing execution.\\\\n\\\\n2. **R2 — CONCERN: concurrent Node execution is plausible, with remaining conditions.**\\\\n\\\\n   One completed compile followed by six Node processes avoids concurrent shadow compiler writes, provided the clone remains exclusive until all workers finish. Runtime selection is supported by the inspected shadow runner and avoids relying on the warm-cache compile filter.\\\\n\\\\n   Fixture samples are encouraging:\\\\n\\\\n   - `test/dao/stream/ws/node_test.cljs:379` and `test/yin/repl/host/node_test.cljs:43` request ephemeral ports.\\\\n   - [serve_test.cljc:5](/Users/sto/workspace/datomworld/test/yin/repl/serve_test.cljc:5) explicitly uses an in-process loopback fixture; its apparent port 8080 does not bind a socket.\\\\n   - [main_test.cljc:34](/Users/sto/workspace/datomworld/test/yin/repl/main_test.cljc:34) and `dht_head_test.cljc:53` use UUID scratch paths.\\\\n\\\\n   Remaining hazards are other real socket fixtures, shared filesystem paths, leaked child processes, and module initialization: `--test` selects test vars after loading the program; it does not isolate namespace-loading side effects.\\\\n\\\\n   There is also no clone lock preventing another compile, watcher, checkout, or `npm ci` during execution. An existing shadow server/watch process must not mutate the bundle or cache while workers use it.\\\\n\\\\n   **Before authoritative use:** finish the complete parallel validation, compare per-namespace execution with a serial baseline, and rerun concurrency-only failures serially while retaining both results. Enforce exclusive ownership of the clone during the run.\\\\n\\\\n3. **R3 — FAIL: distinct aggregator directories do not isolate Flutter’s writable state.**\\\\n\\\\n   **Concurrent reads of stable `lib/cljd-out` are safe** if every compiler and generator has finished and no other job can rewrite it. The problem lies beyond that directory.\\\\n\\\\n   On shiva’s installed Flutter 3.47.1, `packages/flutter_tools/lib/src/test/test_compiler.dart:112–128` selects a project-wide `build/test_cache/...` kernel cache; lines 281–291 copy compiler output into that shared file. Four Flutter commands in one project can therefore write the same cache despite different aggregator directories. Flutter also has project asset and generated registrant outputs.\\\\n\\\\n   The deployed resource cap is **four outer commands × `--concurrency 4` = up to sixteen test workers**, plus compiler processes (`dart-shard.sh:63,71`). Distinct directories can each contain eight aggregator files, but only four execute concurrently per command.\\\\n\\\\n   Emission failures are also unsafe: lines 52–55 merely record their exit codes; execution later checks directory existence. Old aggregator directories survive outside `target-ci`, so a failed emission can leave a stale directory eligible to run.\\\\n\\\\n   **Required:** use isolated project copies for concurrent Flutter commands, or one Flutter invocation over all emitted aggregator files with a single concurrency budget. Treat emission failures as fatal and use fresh, run-specific output directories.\\\\n\\\\n4. **R4 — FAIL: the pin protocol does not establish a common nightly run.**\\\\n\\\\n   `shiva:~/ci/nightly-full.sh:33` writes a persistent SHA-only file. `jupiter:~/ci/nightly-jvm.sh:35–45` accepts the first readable value whose object exists locally. There is no run date, generation identifier, or freshness check.\\\\n\\\\n   **Concrete race:** jupiter starts before shiva updates the file, reads yesterday’s valid SHA, and immediately labels its run “pinned.” Retries never occur. The stale pin remains readable between nights.\\\\n\\\\n   Other failure modes:\\\\n\\\\n   - Publication uses truncation rather than atomic replacement.\\\\n   - Both scripts ignore fetch and checkout failures; a summary can claim a pin while tests execute the previous checkout.\\\\n   - Jupiter fetches before reading the pin. A newly published commit might not exist in that earlier fetch, causing fallback instead of fetching/retrying that commit.\\\\n   - The claimed three-minute bound excludes SSH connection time and does not bound total remote-command duration.\\\\n\\\\n   **Yes: an unpinned run should be advisory for the combined matrix.** Its individual lane remains useful evidence for its actual SHA, but it cannot complete another SHA’s matrix.\\\\n\\\\n   **Required:** atomically publish `{run-id, full-SHA, timestamp}`; require the expected Vietnam nightly date; validate the commit; check every Git command and actual `HEAD`; join results only by matching run-id and SHA. Record fallback reasons explicitly.\\\\n\\\\n5. **R5 — CONCERN: retain the owner-approved split until comparable measurements exist.**\\\\n\\\\n   The current measurements support jupiter for JVM and justify investigating its Node anomaly. They do not establish the best placement after sharding. The JVM comparison is quick-tier timing, and the deployed JVM nightly currently omits slow tests.\\\\n\\\\n   Measure, at one pinned commit:\\\\n\\\\n   - Complete full-tier walls, including prerequisites and compilation.\\\\n   - Per-subsystem duration and the longest shard.\\\\n   - CPU utilization, peak aggregate RSS, swap, I/O, and guest activity.\\\\n   - Worker-count scaling on both hosts, with repeated comparable warm/cold runs.\\\\n   - Failure and timeout differences under concurrency.\\\\n\\\\n   **The first alternative worth measuring is Node on shiva, JVM plus Dart on jupiter**, with separate clones and a shared host resource budget. If Node remains dominated by one heavy subsystem, distributing selected shards across hosts may help more than moving an entire lane. Do not assume more workers shorten the longest shard.\\\\n\\\\n6. **R6 — FAIL: failures and diagnostic evidence can be lost or misattributed.**\\\\n\\\\n   - **Failures return success:** `node-shard.sh:67–70` and `dart-shard.sh:74–77` calculate red counts, then finish with a successful `echo`. Worker functions likewise finish by writing summaries. `xargs` failures are unchecked. Both nightly wrappers explicitly end with `exit 0`.\\\\n   - **Missing workers can look green:** red counts inspect only rows that exist; expected-versus-completed shard sets are never compared.\\\\n   - **Prerequisite failures can be hidden:** both shard scripts continue after unsuccessful prerequisite commands. Dart emission failures are also ignored.\\\\n   - **Logs are overwritten:** all shard scripts delete their fixed `target-ci/*shards` directory at startup. Jupiter’s timestamped nightly log captures summary output, while individual test stdout remains in the directory deleted next run (`nightly-jvm.sh:55`, `shard-jvm.sh:9,30`).\\\\n   - **Attribution is incomplete:** the summaries lack a consistent full-SHA/run-id/host/toolchain manifest. Pulling `nightly-jvm-latest-summary.txt` can attach a previous run’s result (`nightly-full.sh:48`).\\\\n   - Node and Dart workers call `ts` without exporting it, unlike the JVM runner, so their timestamps are missing.\\\\n   - Summary synchronization has no connection timeout; “best effort” can still hang after testing finishes.\\\\n\\\\n   **Required:** preserve immutable per-run plans, prerequisite logs, emission logs, shard stdout/stderr, and result records. Aggregate against the expected shard set; return nonzero for failed, missing, or incomplete work; distinguish incomplete infrastructure from test failures. Sync matching manifests with bounded timeouts, keeping local evidence authoritative.\\\\n\\\\nThese findings concern evidence integrity and completeness. They remain blockers even though the repository defines the nightly as a post-hoc master integrity check rather than a landing gate.\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/1793512000000-reviewer-nightly-plan-re-review.gpt-6.1-sol.stdout.log:13:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'git status --short; git rev-parse HEAD; git log -12 --oneline'\\\",\\\"aggregated_output\\\":\\\"git: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-vP1s97Ow' (errno=Operation not permitted)\\\\n2026-11-01 02:33:08.487 xcodebuild[78554:102934490]  DVTFilePathFSEvents: Failed to start fs event stream.\\\\n2026-11-01 02:33:08.889 xcodebuild[78554:102934488] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\\\\\"Input/output error\\\\\\\". Using NSCachesDirectory instead.\\\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-rnMC4dDP' (errno=Operation not permitted)\\\\n2026-11-01 02:33:09.651 xcodebuild[78559:102934517]  DVTFilePathFSE