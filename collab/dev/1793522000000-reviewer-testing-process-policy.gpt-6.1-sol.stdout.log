\n248:   uint8_t failure_kind = 0;  // 0 none, 1 lexical, 2 token\\\\\\\\n249:   uint8_t no_viable = 0;\\\\\\\\n250:   int32_t failure_index = -1;\\\\\\\\n251:   uint32_t buffered = 0;\\\\\\\\n252: \\\\\\\\n253:   void syntaxError(antlr4::Recognizer* recognizer, antlr4::Token* offending,\\\\\\\\n254:                    size_t line, size_t column, const std::string& msg,\\\\\\\\n255:                    std::exception_ptr e) override {\\\\\\\\n256:     ExportError err{idx(line), idx(column), msg, 0, -1, -1, -2};\\\\\\\\n257:     auto* lexer = dynamic_cast<antlr4::Lexer*>(recognizer);\\\\\\\\n258:     if (offending) {\\\\\\\\n259:       err.span_kind = 1;\\\\\\\\n260:       err.a = sidx(offending->getStartIndex());\\\\\\\\n261:       err.b = sidx(offending->getStopIndex());\\\\\\\\n262:       err.type = static_cast<int32_t>(offending->getType());\\\\\\\\n263:     } else if (lexer) {\\\\\\\\n264:       err.span_kind = 2;\\\\\\\\n265:       err.a = sidx(lexer->tokenStartCharIndex);\\\\\\\\n266:       err.b = sidx(lexer->getInputStream()->index());\\\\\\\\n267:     }\\\\\\\\n268:     if (failure_kind == 0) {\\\\\\\\n269:       if (!offending) {\\\\\\\\n270:         failure_kind = 1;\\\\\\\\n271:       } else {\\\\\\\\n272:         failure_kind = 2;\\\\\\\\n273:         failure_index = sidx(offending->getTokenIndex());\\\\\\\\n274:         if (e) {\\\\\\\\n275:           try {\\\\\\\\n276:             std::rethrow_exception(e);\\\\\\\\n277:           } catch (const antlr4::NoViableAltException&) {\\\\\\\\n278:             no_viable = 1;\\\\\\\\n279:           } catch (...) {\\\\\\\\n280:           }\\\\\\\\n281:         }\\\\\\\\n282:       }\\\\\\\\n283:       buffered = idx(tokens_->getTokens().size());\\\\\\\\n284:     }\\\\\\\\n285:     errors.push_back(std::move(err));\\\\\\\\n286:   }\\\\\\\\n287: \\\\\\\\n288:  private:\\\\\\\\n289:   antlr4::CommonTokenStream* tokens_;\\\\\\\\n290: };\\\\\\\\n291: \\\\\\\\n292: void walk_export(antlr4::tree::ParseTree* t, Out& out, uint32_t& count) {\\\\\\\\n293:   ++count;\\\\\\\\n294:   if (auto* term = dynamic_cast<antlr4::tree::TerminalNode*>(t)) {\\\\\\\\n295:     antlr4::Token* tok = term->getSymbol();\\\\\\\\n296:     out.u8(1);\\\\\\\\n297:     out.u32(static_cast<uint32_t>(static_cast<int32_t>(tok->getType())));\\\\\\\\n298:     out.u32(static_cast<uint32_t>(sidx(tok->getStartIndex())));\\\\\\\\n299:     out.u32(static_cast<uint32_t>(sidx(tok->getStopIndex())));\\\\\\\\n300:     out.u32(static_cast<uint32_t>(sidx(tok->getTokenIndex())));\\\\\\\\n301:     out.str(tok->getText());\\\\\\\\n302:     return;\\\\\\\\n303:   }\\\\\\\\n304:   auto* ctx = dynamic_cast<antlr4::ParserRuleContext*>(t);\\\\\\\\n305:   out.u8(0);\\\\\\\\n306:   out.u32(idx(ctx->getRuleIndex()));\\\\\\\\n307:   out.u32(idx(ctx->children.size()));\\\\\\\\n308:   out.u8(ctx->start ? 1 : 0);\\\\\\\\n309:   out.u32(static_cast<uint32_t>(ctx->start ? sidx(ctx->start->getStartIndex()) : -1));\\\\\\\\n310:   for (auto* c : ctx->children) walk_export(c, out, count);\\\\\\\\n311: }\\\\\\\\n312: \\\\\\\\n313: // The source as code points, exactly: a strict UTF-8 decode that throws on an\\\\\\\\n314: // illegal sequence (as ANTLRInputStream's own does) but keeps a leading\\\\\\\\n315: // U+FEFF. ANTLRInputStream::load strips a UTF-8 BOM\\\\\\\\n316: // (runtime/src/ANTLRInputStream.cpp:43-48); the JVM's CharStreams.fromString\\\\\\\\n317: // does not, and a stripped BOM shifts every index against the source the\\\\\\\\n318: // exporter maps spans onto (J0c round 4 input policy).\\\\\\\\n319: class SourceStream : public antlr4::ANTLRInputStream {\\\\\\\\n320:  public:\\\\\\\\n321:   explicit SourceStream(std::string_view utf8) {\\\\\\\\n322:     auto cps = antlrcpp::Utf8::strictDecode(utf8);\\\\\\\\n323:     if (!cps.has_value())\\\\\\\\n324:       throw antlr4::IllegalArgumentException(\\\\\\\\n325:           \\\\\\\\\\\\\\\"UTF-8 string contains an illegal byte sequence\\\\\\\\\\\\\\\");\\\\\\\\n326:     _data = std::move(cps).value();\\\\\\\\n327:     p = 0;\\\\\\\\n328:   }\\\\\\\\n329: };\\\\\\\\n330: \\\\\\\\n331: // --- workers (§7.4) -----------------------------------------------------------\\\\\\\\n332: \\\\\\\\n333: constexpr uint64_t kWorkerTag = 0x4a504152534552ull;  // \\\\\\\\\\\\\\\"JPARSER\\\\\\\\\\\\\\\"\\\\\\\\n334: \\\\\\\\n335: std::vector<antlr4::dfa::DFA> fresh_dfa(const antlr4::atn::ATN& atn) {\\\\\\\\n336:   std::vector<antlr4::dfa::DFA> dfa;\\\\\\\\n337:   const size_t n = atn.getNumberOfDecisions();\\\\\\\\n338:   dfa.reserve(n);\\\\\\\\n339:   for (size_t i = 0; i < n; ++i) dfa.emplace_back(atn.getDecisionState(i), i);\\\\\\\\n340:   return dfa;\\\\\\\\n341: }\\\\\\\\n342: \\\\\\\\n343: // The generated, immutable ATNs (static data initialized once by the\\\\\\\\n344: // generated constructors).\\\\\\\\n345: struct Atns {\\\\\\\\n346:   const antlr4::atn::ATN* lexer;\\\\\\\\n347:   const antlr4::atn::ATN* parser;\\\\\\\\n348: };\\\\\\\\n349: \\\\\\\\n350: Atns generated_atns() {\\\\\\\\n351:   antlr4::ANTLRInputStream input(\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n352:   Python3Lexer lexer(&input);\\\\\\\\n353:   antlr4::CommonTokenStream tokens(&lexer);\\\\\\\\n354:   Python3Parser parser(&tokens);\\\\\\\\n355:   return {&lexer.getATN(), &parser.getATN()};\\\\\\\\n356: }\\\\\\\\n357: \\\\\\\\n358: struct Worker {\\\\\\\\n359:   uint64_t tag = kWorkerTag;\\\\\\\\n360:   const antlr4::atn::ATN* lexer_atn;\\\\\\\\n361:   const antlr4::atn::ATN* parser_atn;\\\\\\\\n362:   std::vector<antlr4::dfa::DFA> lexer_dfa;\\\\\\\\n363:   std::vector<antlr4::dfa::DFA> parser_dfa;\\\\\\\\n364:   antlr4::atn::PredictionContextCache lexer_ctx;\\\\\\\\n365:   antlr4::atn::PredictionContextCache parser_ctx;\\\\\\\\n366:   std::atomic<bool> busy{false};\\\\\\\\n367: \\\\\\\\n368:   explicit Worker(Atns atns)\\\\\\\\n369:       : lexer_atn(atns.lexer),\\\\\\\\n370:         parser_atn(atns.parser),\\\\\\\\n371:         lexer_dfa(fresh_dfa(*atns.lexer)),\\\\\\\\n372:         parser_dfa(fresh_dfa(*atns.parser)) {}\\\\\\\\n373: };\\\\\\\\n374: \\\\\\\\n375: Worker* as_worker(void* w) {\\\\\\\\n376:   auto* worker = static_cast<Worker*>(w);\\\\\\\\n377:   return worker && worker->tag == kWorkerTag ? worker : nullptr;\\\\\\\\n378: }\\\\\\\\n379: \\\\\\\\n380: // Holds a worker for one call; a second concurrent call is refused.\\\\\\\\n381: struct Hold {\\\\\\\\n382:   Worker* w;\\\\\\\\n383:   bool held;\\\\\\\\n384:   explicit Hold(Worker* worker) : w(worker) {\\\\\\\\n385:     bool expected = false;\\\\\\\\n386:     held = w->busy.compare_exchange_strong(expected, true);\\\\\\\\n387:   }\\\\\\\\n388:   ~Hold() {\\\\\\\\n389:     if (held) w->busy.store(false);\\\\\\\\n390:   }\\\\\\\\n391: };\\\\\\\\n392: \\\\\\\\n393: }  // namespace\\\\\\\\n394: \\\\\\\\n395: // A new worker owning fresh DFA vectors and PredictionContextCaches. NULL when\\\\\\\\n396: // it cannot be made (nothing throws across the boundary).\\\\\\\\n397: JOLT_EXPORT void* jolt_parser_worker_new(void) {\\\\\\\\n398:   try {\\\\\\\\n399:     return new Worker(generated_atns());\\\\\\\\n400:   } catch (...) {\\\\\\\\n401:     return nullptr;\\\\\\\\n402:   }\\\\\\\\n403: }\\\\\\\\n404: \\\\\\\\n405: // Dispose a worker and its caches. NULL is accepted. The caller must not use\\\\\\\\n406: // the handle again, nor free it while a call on it runs.\\\\\\\\n407: JOLT_EXPORT void jolt_parser_worker_free(void* w) {\\\\\\\\n408:   if (Worker* worker = as_worker(w)) {\\\\\\\\n409:     worker->tag = 0;\\\\\\\\n410:     delete worker;\\\\\\\\n411:   }\\\\\\\\n412: }\\\\\\\\n413: \\\\\\\\n414: // Parse UTF-8 `src[0, len)` from `file_input` with `worker`'s caches and\\\\\\\\n415: // answer the exporter's records (layout \\\\\\\\\\\\\\\"JPX1\\\\\\\\\\\\\\\" above). Statuses as\\\\\\\\n416: // jolt_parser_parse, plus -5; -1 also for a NULL or unrecognized worker.\\\\\\\\n417: JOLT_EXPORT int32_t jolt_parser_export(void* worker, const uint8_t* src,\\\\\\\\n418:                                        size_t len, uint8_t** out,\\\\\\\\n419:                                        size_t* out_len) {\\\\\\\\n420:   if (!out || !out_len || (!src && len != 0)) return -1;\\\\\\\\n421:   *out = nullptr;\\\\\\\\n422:   *out_len = 0;\\\\\\\\n423:   Worker* w = as_worker(worker);\\\\\\\\n424:   if (!w) return -1;\\\\\\\\n425:   Hold hold(w);\\\\\\\\n426:   if (!hold.held) return -5;\\\\\\\\n427:   try {\\\\\\\\n428:     maybe_fault();\\\\\\\\n429:     SourceStream input(\\\\\\\\n430:         std::string_view(reinterpret_cast<const char*>(src), len));\\\\\\\\n431:     Python3Lexer lexer(&input);\\\\\\\\n432:     // setInterpreter deletes the generated default simulator, the one over\\\\\\\\n433:     // the static caches; the generated destructors delete these at scope exit\\\\\\\\n434:     lexer.setInterpreter(new antlr4::atn::LexerATNSimulator(\\\\\\\\n435:         &lexer, *w->lexer_atn, w->lexer_dfa, w->lexer_ctx));\\\\\\\\n436:     antlr4::CommonTokenStream tokens(&lexer);\\\\\\\\n437:     Python3Parser parser(&tokens);\\\\\\\\n438:     parser.setInterpreter(new antlr4::atn::ParserATNSimulator(\\\\\\\\n439:         &parser, *w->parser_atn, w->parser_dfa, w->parser_ctx));\\\\\\\\n440:     ExportCollect errors(&tokens);\\\\\\\\n441:     lexer.removeErrorListeners();\\\\\\\\n442:     parser.removeErrorListeners();\\\\\\\\n443:     lexer.addErrorListener(&errors);\\\\\\\\n444:     parser.addErrorListener(&errors);\\\\\\\\n445: \\\\\\\\n446:     antlr4::tree::ParseTree* tree = parser.file_input();\\\\\\\\n447: \\\\\\\\n448:     Out o;\\\\\\\\n449:     o.buf.insert(o.buf.end(), {'J', 'P', 'X', '1'});\\\\\\\\n450:     o.u32(2);\\\\\\\\n451:     o.u32(errors.errors.empty() ? 0 : 1);\\\\\\\\n452:     const auto& rules = parser.getRuleNames();\\\\\\\\n453:     o.u32(idx(rules.size()));\\\\\\\\n454:     for (const auto& r : rules) o.str(r);\\\\\\\\n455:     const auto& vocab = parser.getVocabulary();\\\\\\\\n456:     size_t max_type = vocab.getMaxTokenType();\\\\\\\\n457:     o.u32(idx(max_type + 1));\\\\\\\\n458:     for (size_t i = 0; i <= max_type; ++i) o.str(vocab.getSymbolicName(i));\\\\\\\\n459:     o.u32(idx(max_type + 1));\\\\\\\\n460:     for (size_t i = 0; i <= max_type; ++i) o.str(vocab.getLiteralName(i));\\\\\\\\n461:     size_t count_at = o.buf.size();\\\\\\\\n462:     o.u32(0);\\\\\\\\n463:     uint32_t count = 0;\\\\\\\\n464:     walk_export(tree, o, count);\\\\\\\\n465:     for (int i = 0; i < 4; ++i)\\\\\\\\n466:       o.buf[count_at + i] = static_cast<uint8_t>(count >> (8 * i));\\\\\\\\n467:     o.u32(idx(errors.errors.size()));\\\\\\\\n468:     for (const auto& e : errors.errors) {\\\\\\\\n469:       o.u32(e.line);\\\\\\\\n470:       o.u32(e.column);\\\\\\\\n471:       o.str(e.msg);\\\\\\\\n472:       o.u8(e.span_kind);\\\\\\\\n473:       o.u32(static_cast<uint32_t>(e.a));\\\\\\\\n474:       o.u32(static_cast<uint32_t>(e.b));\\\\\\\\n475:       o.u32(static_cast<uint32_t>(e.type));\\\\\\\\n476:     }\\\\\\\\n477:     o.u8(errors.failure_kind);\\\\\\\\n478:     o.u8(errors.no_viable);\\\\\\\\n479:     o.u32(static_cast<uint32_t>(errors.failure_index));\\\\\\\\n480:     o.u32(errors.buffered);\\\\\\\\n481:     const auto buffered = tokens.getTokens();\\\\\\\\n482:     o.u32(idx(buffered.size()));\\\\\\\\n483:     for (auto* t : buffered) {\\\\\\\\n484:       o.u32(static_cast<uint32_t>(static_cast<int32_t>(t->getType())));\\\\\\\\n485:       o.u32(static_cast<uint32_t>(sidx(t->getTokenIndex())));\\\\\\\\n486:       o.u32(static_cast<uint32_t>(sidx(t->getStartIndex())));\\\\\\\\n487:       o.u32(static_cast<uint32_t>(sidx(t->getStopIndex())));\\\\\\\\n488:     }\\\\\\\\n489:     return hand_off(o.buf, out, out_len);\\\\\\\\n490:   } catch (const Oversize&) {\\\\\\\\n491:     return -4;\\\\\\\\n492:   } catch (const std::exception& e) {\\\\\\\\n493:     return message(e.what(), -2, out, out_len);\\\\\\\\n494:   } catch (...) {\\\\\\\\n495:     return message(\\\\\\\\\\\\\\\"unknown exception\\\\\\\\\\\\\\\", -3, out, out_len);\\\\\\\\n496:   }\\\\\\\\n497: }\\\\\\\\n498: \\\\\\\\n499: // Parse UTF-8 `src[0, len)` from the `file_input` rule, with the generated\\\\\\\\n500: // static caches (the round-1 probe surface).\\\\\\\\n501: JOLT_EXPORT int32_t jolt_parser_parse(const uint8_t* src, size_t len,\\\\\\\\n502:                                       uint8_t** out, size_t* out_len) {\\\\\\\\n503:   if (!out || !out_len || (!src && len != 0)) return -1;\\\\\\\\n504:   *out = nullptr;\\\\\\\\n505:   *out_len = 0;\\\\\\\\n506:   try {\\\\\\\\n507:     maybe_fault();\\\\\\\\n508:     SourceStream input(\\\\\\\\n509:         std::string_view(reinterpret_cast<const char*>(src), len));\\\\\\\\n510:     Python3Lexer lexer(&input);\\\\\\\\n511:     antlr4::CommonTokenStream tokens(&lexer);\\\\\\\\n512:     Python3Parser parser(&tokens);\\\\\\\\n513:     Collect errors;\\\\\\\\n514:     lexer.removeErrorListeners();\\\\\\\\n515:     parser.removeErrorListeners();\\\\\\\\n516:     lexer.addErrorListener(&errors);\\\\\\\\n517:     parser.addErrorListener(&errors);\\\\\\\\n518: \\\\\\\\n519:     antlr4::tree::ParseTree* tree = parser.file_input();\\\\\\\\n520: \\\\\\\\n521:     Out o;\\\\\\\\n522:     o.buf.insert(o.buf.end(), {'J', 'P', 'T', '1'});\\\\\\\\n523:     o.u32(1);\\\\\\\\n524:     o.u32(errors.errors.empty() ? 0 : 1);\\\\\\\\n525:     const auto& rules = parser.getRuleNames();\\\\\\\\n526:     o.u32(idx(rules.size()));\\\\\\\\n527:     for (const auto& r : rules) o.str(r);\\\\\\\\n528:     const auto& vocab = parser.getVocabulary();\\\\\\\\n529:     size_t max_type = vocab.getMaxTokenType();\\\\\\\\n530:     o.u32(idx(max_type + 1));\\\\\\\\n531:     for (size_t i = 0; i <= max_type; ++i) o.str(vocab.getSymbolicName(i));\\\\\\\\n532:     size_t count_at = o.buf.size();\\\\\\\\n533:     o.u32(0);\\\\\\\\n534:     uint32_t count = 0;\\\\\\\\n535:     walk(tree, o, count);\\\\\\\\n536:     for (int i = 0; i < 4; ++i)\\\\\\\\n537:       o.buf[count_at + i] = static_cast<uint8_t>(count >> (8 * i));\\\\\\\\n538:     o.u32(idx(errors.errors.size()));\\\\\\\\n539:     for (const auto& e : errors.errors) {\\\\\\\\n540:       o.u32(e.line);\\\\\\\\n541:       o.u32(e.column);\\\\\\\\n542:       o.str(e.msg);\\\\\\\\n543:     }\\\\\\\\n544:     return hand_off(o.buf, out, out_len);\\\\\\\\n545:   } catch (const Oversize&) {\\\\\\\\n546:     return -4;\\\\\\\\n547:   } catch (const std::exception& e) {\\\\\\\\n548:     return message(e.what(), -2, out, out_len);\\\\\\\\n549:   } catch (...) {\\\\\\\\n550:     return message(\\\\\\\\\\\\\\\"unknown exception\\\\\\\\\\\\\\\", -3, out, out_len);\\\\\\\\n551:   }\\\\\\\\n552: }\\\\\\\\n553: \\\\\\\\n554: // Release a buffer jolt_parser_parse handed out. NULL is accepted.\\\\\\\\n555: JOLT_EXPORT void jolt_parser_free(uint8_t* p) { std::free(p); }\\\\\\\\n556: \\\\\\\\n557: // The JPT1 layout version jolt_parser_parse writes.\\\\\\\\n558: JOLT_EXPORT int32_t jolt_parser_layout_version(void) { return 1; }\\\\\\\\n559: \\\\\\\\n560: // The JPX1 layout version jolt_parser_export writes.\\\\\\\\n561: JOLT_EXPORT int32_t jolt_parser_export_layout_version(void) { return 2; }\\\\\\\\n562: \\\\\\\\n563: #ifdef JOLT_PARSER_TEST_SEAMS\\\\\\\\n564: \\\\\\\\n565: // TEST SEAM: set the fault mode (0 off, 1-3 as g_fault above) for later\\\\\\\\n566: // parses. Answers the previous mode.\\\\\\\\n567: JOLT_EXPORT int32_t jolt_parser_inject_fault(int32_t mode) {\\\\\\\\n568:   return g_fault.exchange(mode);\\\\\\\\n569: }\\\\\\\\n570: \\\\\\\\n571: namespace {\\\\\\\\n572: \\\\\\\\n573: // Reading two private counters for the stats below, through the standard\\\\\\\\n574: // explicit-instantiation access idiom (test seam only; reads, never writes).\\\\\\\\n575: template <auto M, typename Tag>\\\\\\\\n576: struct Peek {\\\\\\\\n577:   friend auto peek(Tag) { return M; }\\\\\\\\n578: };\\\\\\\\n579: struct CtxData {};\\\\\\\\n580: struct NextUpdated {};\\\\\\\\n581: auto peek(CtxData);\\\\\\\\n582: auto peek(NextUpdated);\\\\\\\\n583: template struct Peek<&antlr4::atn::PredictionContextCache::_data, CtxData>;\\\\\\\\n584: template struct Peek<&antlr4::atn::ATNState::_nextTokenUpdated, NextUpdated>;\\\\\\\\n585: \\\\\\\\n586: void dfa_counts(const std::vector<antlr4::dfa::DFA>& dfas, uint64_t& states,\\\\\\\\n587:                 uint64_t& edges) {\\\\\\\\n588:   for (const auto& d : dfas) {\\\\\\\\n589:     states += d.states.size() + (d.s0 ? 1 : 0);\\\\\\\\n590:     if (d.s0) edges += d.s0->edges.size();\\\\\\\\n591:     for (const auto* st : d.states) edges += st->edges.size();\\\\\\\\n592:   }\\\\\\\\n593: }\\\\\\\\n594: \\\\\\\\n595: uint64_t ctx_size(const antlr4::atn::PredictionContextCache& c) {\\\\\\\\n596:   return (c.*peek(CtxData{})).size();\\\\\\\\n597: }\\\\\\\\n598: \\\\\\\\n599: uint64_t memo_count(const antlr4::atn::ATN& atn) {\\\\\\\\n600:   uint64_t n = 0;\\\\\\\\n601:   for (auto* st : atn.states)\\\\\\\\n602:     if (st && (st->*peek(NextUpdated{})).load()) ++n;\\\\\\\\n603:   return n;\\\\\\\\n604: }\\\\\\\\n605: \\\\\\\\n606: }  // namespace\\\\\\\\n607: \\\\\\\\n608: // TEST SEAM: the generated static caches and the shared ATNs' lazily filled\\\\\\\\n609: // next-token memo. out[0..7] = lexer DFA states, lexer DFA edges, lexer\\\\\\\\n610: // context-cache entries, parser DFA states, parser DFA edges, parser\\\\\\\\n611: // context-cache entries, lexer ATN states with a filled next-token memo,\\\\\\\\n612: // parser ATN states with one. Call with no parse running.\\\\\\\\n613: JOLT_EXPORT int32_t jolt_parser_static_cache_stats(uint64_t* out) {\\\\\\\\n614:   if (!out) return -1;\\\\\\\\n615:   try {\\\\\\\\n616:     antlr4::ANTLRInputStream input(\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n617:     Python3Lexer lexer(&input);\\\\\\\\n618:     antlr4::CommonTokenStream tokens(&lexer);\\\\\\\\n619:     Python3Parser parser(&tokens);\\\\\\\\n620:     auto* ls = lexer.getInterpreter<antlr4::atn::LexerATNSimulator>();\\\\\\\\n621:     auto* ps = parser.getInterpreter<antlr4::atn::ParserATNSimulator>();\\\\\\\\n622:     for (int i = 0; i < 8; ++i) out[i] = 0;\\\\\\\\n623:     dfa_counts(ls->_decisionToDFA, out[0], out[1]);\\\\\\\\n624:     out[2] = ctx_size(ls->getSharedContextCache());\\\\\\\\n625:     dfa_counts(ps->decisionToDFA, out[3], out[4]);\\\\\\\\n626:     out[5] = ctx_size(ps->getSharedContextCache());\\\\\\\\n627:     out[6] = memo_count(lexer.getATN());\\\\\\\\n628:     out[7] = memo_count(parser.getATN());\\\\\\\\n629:     return 0;\\\\\\\\n630:   } catch (...) {\\\\\\\\n631:     return -3;\\\\\\\\n632:   }\\\\\\\\n633: }\\\\\\\\n634: \\\\\\\\n635: // TEST SEAM: a worker's own caches, out[0..5] as out[0..5] above.\\\\\\\\n636: JOLT_EXPORT int32_t jolt_parser_worker_cache_stats(void* worker, uint64_t* out) {\\\\\\\\n637:   Worker* w = as_worker(worker);\\\\\\\\n638:   if (!w || !out) return -1;\\\\\\\\n639:   for (int i = 0; i < 6; ++i) out[i] = 0;\\\\\\\\n640:   dfa_counts(w->lexer_dfa, out[0], out[1]);\\\\\\\\n641:   out[2] = ctx_size(w->lexer_ctx);\\\\\\\\n642:   dfa_counts(w->parser_dfa, out[3], out[4]);\\\\\\\\n643:   out[5] = ctx_size(w->parser_ctx);\\\\\\\\n644:   return 0;\\\\\\\\n645: }\\\\\\\\n646: \\\\\\\\n647: // TEST SEAM: the calling thread's stack. out[0..4] = stack size in bytes,\\\\\\\\n648: // lowest and highest stack address, the current stack position, 1 when it is\\\\\\\\n649: // the process's main thread.\\\\\\\\n650: JOLT_EXPORT int32_t jolt_parser_thread_info(uint64_t* out) {\\\\\\\\n651:   if (!out) return -1;\\\\\\\\n652:   volatile char here = 0;\\\\\\\\n653:   out[3] = reinterpret_cast<uint64_t>(&here);\\\\\\\\n654: #if defined(__APPLE__)\\\\\\\\n655:   pthread_t self = pthread_self();\\\\\\\\n656:   uint64_t size = pthread_get_stacksize_np(self);\\\\\\\\n657:   uint64_t high = reinterpret_cast<uint64_t>(pthread_get_stackaddr_np(self));\\\\\\\\n658:   out[0] = size;\\\\\\\\n659:   out[1] = high - size;\\\\\\\\n660:   out[2] = high;\\\\\\\\n661:   out[4] = pthread_main_np() == 1 ? 1 : 0;\\\\\\\\n662:   return 0;\\\\\\\\n663: #elif defined(__GLIBC__)\\\\\\\\n664:   pthread_attr_t attr;\\\\\\\\n665:   if (pthread_getattr_np(pthread_self(), &attr) != 0) return -3;\\\\\\\\n666:   void* low = nullptr;\\\\\\\\n667:   size_t size = 0;\\\\\\\\n668:   pthread_attr_getstack(&attr, &low, &size);\\\\\\\\n669:   pthread_attr_destroy(&attr);\\\\\\\\n670:   out[0] = size;\\\\\\\\n671:   out[1] = reinterpret_cast<uint64_t>(low);\\\\\\\\n672:   out[2] = reinterpret_cast<uint64_t>(low) + size;\\\\\\\\n673:   out[4] = getpid() == static_cast<pid_t>(syscall(SYS_gettid)) ? 1 : 0;\\\\\\\\n674:   return 0;\\\\\\\\n675: #else\\\\\\\\n676:   return -3;\\\\\\\\n677: #endif\\\\\\\\n678: }\\\\\\\\n679: \\\\\\\\n680: // TEST SEAM: bytes malloc reports in use (all zones on macOS, glibc's\\\\\\\\n681: // mallinfo2 on Linux; 0 elsewhere).\\\\\\\\n682: JOLT_EXPORT uint64_t jolt_parser_heap_in_use(void) {\\\\\\\\n683: #if defined(__APPLE__)\\\\\\\\n684:   malloc_statistics_t st;\\\\\\\\n685:   malloc_zone_statistics(nullptr, &st);\\\\\\\\n686:   return st.size_in_use;\\\\\\\\n687: #elif defined(__GLIBC__) && (__GLIBC__ > 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ >= 33))\\\\\\\\n688:   return mallinfo2().uordblks;\\\\\\\\n689: #else\\\\\\\\n690:   return 0;\\\\\\\\n691: #endif\\\\\\\\n692: }\\\\\\\\n693: \\\\\\\\n694: #endif  // JOLT_PARSER_TEST_SEAMS\\\\\\\"}]}],\\\\\\\"meta\\\\\\\":{\\\\\\\"source\\\\\\\":\\\\\\\"tool\\\\\\\",\\\\\\\"messageId\\\\\\\":\\\\\\\"5cf0051a-6316-4d3a-9af1-cfe7402afbac\\\\\\\"}},{\\\\\\\"role\\\\\\\":\\\\\\\"assistant\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"type\\\\\\\":\\\\\\\"thinking\\\\\\\",\\\\\\\"thinking\\\\\\\":\\\\\\\"C++ looks robust. Adversarial observations:\\\\\\\\n\\\\\\\\n1. Worker ownership: Worker owns DFA vector + PredictionContextCache; per-call a new simulator is installed via setInterpreter. Need to verify that LexerATNSimulator/ParserATNSimulator constructors take a DFA vector reference + ctx cache — yes, standard ANTLR C++ signatures. setInterpreter deletes the previous one (Recognizer.cpp claim). At scope exit the generated destructor deletes the interpreter — in the ANTLR C++ generated lexer/parser destructors, is it `delete _interpreter;`? Lexer's destructor: generated Python3Lexer::~Python3Lexer() { delete _interpreter; }? In the actual ANTLR C++ runtime, the Lexer base class destructor doesn't delete the interpreter; does the generated code have `~Python3Lexer() override { delete getInterpreter(); }`? Hmm. Actually, generated ANTLR C++ lexer: `Python3Lexer::~Python3Lexer() { delete _interpreter; }`? As I recall, generated lexers/parsers in C++ have destructors that delete the interpreter they created in the constructor. Right — generated code pattern:\\\\\\\\n\\\\\\\\n```cpp\\\\\\\\nPython3Lexer::Python3Lexer(CharStream *input) : Lexer(input) {\\\\\\\\n  _interpreter = new atn::LexerATNSimulator(this, _atn, _decisionToDFA, _sharedContextCache);\\\\\\\\n}\\\\\\\\nPython3Lexer::~Python3Lexer() { delete _interpreter; }\\\\\\\\n```\\\\\\\\nSo the destructor deletes whatever interpreter is installed. And setInterpreter deletes the old one. Therefore no leak/double-delete. The ASan+leaks run (50 cycles including worker new/free) backs this up empirically. Good.\\\\\\\\n\\\\\\\\n2. generated_atns(): creates a throwaway lexer/parser on each worker_new call to obtain ATN pointers — a bit heavy but fine; the ATN comes from static data initialized via call_once. Note: Python3Parser's constructor creates the default interpreter (deleted? no — the throwaway parser is destructed at return and deletes its own interpreter). OK.\\\\\\\\n\\\\\\\\n3. Hold busy guard: compare_exchange_strong; released in the destructor. Exception safety: Hold is declared before try → on return/exception the destructor runs ✓. Caveat: -5 is returned when busy; but worker_free while busy is not guarded (documented: \\\\\\\\\\\\\\\"the caller must not free while a call is running\\\\\\\\\\\\\\\"). cst.jolt's close-worker uses CAS once; but close during a running parse on another thread = UB; the single-threaded guest usage assumption is disclosed in a comment. The design states a worker is used by one thread at a time. Acceptable, documented.\\\\\\\\n\\\\\\\\n4. Worker tag check: the tag field is read after static_cast — a garbage non-null pointer would be dereferenced (UB), and if that memory happens to match the tag it would be accepted. The tag reduces risk but cannot fully prevent arbitrary-pointer dereference; inherent to opaque-handle C APIs. Zeroed memory is tested (rejected). Info-level at best.\\\\\\\\n\\\\\\\\n5. worker_free: sets tag=0 then deletes — a double free would be use-after-free anyway; tag=0 does not protect against freed memory being reused. cst.jolt's idempotent close (CAS) is the real guard. Documented. OK.\\\\\\\\n\\\\\\\\n6. SourceStream BOM fix: strictDecode throws → wrapped in IllegalArgumentException (std::exception → -2 with message). Preserves U+FEFF. Used at both entry points ✓ (export :429, parse :508). Fix is correct: decode to code points itself, completely bypassing ANTLRInputStream::load. Complete? ANTLRInputStream's _data is UTF-32? In the C++ runtime ANTLRInputStream stores std::vector<uint32_t>? Actually it stores UTF-32 code points as a UTF32Array (u32 string?). strictDecode returns vector<uint32_t> — assigned to _data, p=0. size() etc. work. Reasonable. Also invalid UTF-8 → -2 \\\\\\\\\\\\\\\"illegal byte sequence\\\\\\\\\\\\\\\" — matches report (6/6 fail-closed). The oversize-limit enforcement during growth is done via room() inside Out ✓; hand_off still rechecks. room() computes kMaxOutput - buf.size() — can buf.size() exceed kMaxOutput? No: room throws before the excess; buf.size() ≤ kMaxOutput is preserved. `n > kMaxOutput - buf.size()` is unsigned and safe since buf.size() ≤ kMaxOutput. ✓.\\\\\\\\n\\\\\\\\n7. Seams gated by #ifdef; release exports are 7 (orchestrator-verified via nm). maybe_fault/fail_handler_malloc are no-ops in release ✓. Non-allocating message() is retained ✓. Oversize catch allocates nothing ✓. Busy -5 allocates nothing ✓.\\\\\\\\n\\\\\\\\n8. export_layout_version entry = 2; cst.jolt checks it at load time (to be verified in cst.jolt).\\\\\\\\n\\\\\\\\n9. Peek idiom reading private members — test seam only, reads only; no UB concern beyond the standard explicit-instantiation trick; gated.\\\\\\\\n\\\\\\\\nNext, verification: cst.jolt changes (worker handle, close-worker, layout check), stack harness child-process approach, gc log numbers, cycles log, sanitize log, workers log, input oracle/corpus, and that the round-2 oracle is unchanged + manifest is unchanged. Additionally parity 132 PASS in the log. Spot-check via grep rather than full reads to save budget.\\\\\\\\n\\\\\\\\nMain grep:\\\\\\\\n- cst.jolt: worker_new/close-worker/layout-version check.\\\\\\\\n- r4-workers-final.log: PASS count, static-growth RECORD, busy -5.\\\\\\\\n- r4-stack.log or stack-budget.edn: verify the report's numbers (main parens 10752/11264, thread 544/576, unary 93.5s@1024).\\\\\\\\n- r4-gc.log: 200ms → 271ms, 35826ms call, tick 5237.\\\\\\\\n- r4-parity-final.log: SUMMARY + 132 PASS count + input section.\\\\\\\\n- r4-sanitize.log tail: HARNESS ok exit 0.\\\\\\\\n- r4-cycles-20000.log: numbers 1,304,240 → 1,416,912.\\\\\\\\n- manifest unchanged: digest still 2483e344, etc. (should be unchanged; grep quickly).\\\\\\\\n- input oracle header is JVM-generated; corpus is 13 sources.\\\\\\\\n\\\\\\\\nLet's run these in batched greps.\\\\\\\\n\\\\\\\",\\\\\\\"signature\\\\\\\":\\\\\\\"\\\\\\\"},{\\\\\\\"type\\\\\\\":\\\\\\\"text\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"Now spot-verify cst.jolt's worker handling and the key log numbers.\\\\\\\\n\\\\\\\\n\\\\\\\"},{\\\\\\\"type\\\\\\\":\\\\\\\"tool_use\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"call_a6444ace79fe48b185d0187d\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"grep\\\\\\\",\\\\\\\"input\\\\\\\":{\\\\\\\"pattern\\\\\\\":\\\\\\\"worker|layout_version|close-worker|closed\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt\\\\\\\",\\\\\\\"output_mode\\\\\\\":\\\\\\\"content\\\\\\\",\\\\\\\"-n\\\\\\\":true}},{\\\\\\\"type\\\\\\\":\\\\\\\"tool_use\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"call_e6054373c30c4fc69cd4fdbf\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"grep\\\\\\\",\\\\\\\"input\\\\\\\":{\\\\\\\"pattern\\\\\\\":\\\\\\\"10752|11264|93\\\\\\\\\\\\\\\\.5|544|576|SIGILL|SIGSEGV|unary\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/build/j0c/logs/r4-stack.log\\\\\\\",\\\\\\\"output_mode\\\\\\\":\\\\\\\"content\\\\\\\",\\\\\\\"-n\\\\\\\":true,\\\\\\\"head_limit\\\\\\\":40}}],\\\\\\\"meta\\\\\\\":{\\\\\\\"source\\\\\\\":\\\\\\\"model\\\\\\\",\\\\\\\"createdAt\\\\\\\":1792508170744,\\\\\\\"messageId\\\\\\\":\\\\\\\"7052a16d-7e43-4e92-b02b-07911f8e3b5d\\\\\\\"}},{\\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"type\\\\\\\":\\\\\\\"tool_result\\\\\\\",\\\\\\\"tool_use_id\\\\\\\":\\\\\\\"call_a6444ace79fe48b185d0187d\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"type\\\\\\\":\\\\\\\"text\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\".claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt:4:   (`make-worker`, `parse-unit`, `parse-transform`, `utf8-bytes`,\\\\\\\\n.claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt:17:   A worker (§7.4) holds an opaque native handle that owns the lexer and\\\\\\\\n.claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt:20:   `close-worker` (a jolt-only addition: the other hosts' workers are\\\\\\\\n.claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt:21:   collected). A worker serves one thread at a time; a concurrent call on the\\\\\\\\n.claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt:22:   same worker is refused by the wrapper (status -5) and throws here.\\\\\\\\n.claude/worktrees/jolt-j0c/src/jolt/yang/antlr/cst.jolt:24:   Disclosed limits: the native library is the one Python3 g