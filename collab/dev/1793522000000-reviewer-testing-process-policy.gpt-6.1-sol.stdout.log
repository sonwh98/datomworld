{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"ssh -o BatchMode=yes -o ConnectTimeout=10 shiva.stigmergy.systems 'hostname; date -Is; crontab -l; ls -lt ~/ci; ls -lt ~/ci/nightly-results | head -15; cat ~/ci/nightly-pin.txt'\"","aggregated_output":"shiva\n2026-11-01T03:05:36-05:00\n# Edit this file to introduce tasks to be run by cron.\n# \n# Each task to run has to be defined through a single line\n# indicating with different fields when the task will be run\n# and what command to run for the task\n# \n# To define the time you can provide concrete values for\n# minute (m), hour (h), day of month (dom), month (mon),\n# and day of week (dow) or use '*' in these fields (for 'any').\n# \n# Notice that tasks will be started based on the cron's system\n# daemon's notion of time and timezones.\n# \n# Output of the crontab jobs (including errors) is sent through\n# email to the user the crontab file belongs to (unless redirected).\n# \n# For example, you can run a backup of all your user accounts\n# at 5 a.m every week with:\n# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/\n# \n# For more information see the manual pages of crontab(5) and cron(8)\n# \n# m h  dom mon dow   command\n*/5 * * * * /home/sto/dns.sh >> /home/sto/dns.log 2>&1\n\n0 2 * * * /home/sto/backup/scripts/cron-dump.sh >> /home/sto/backup/ttgames/dump.log 2>&1\n0 12 * * * /home/sto/backup/scripts/cron-rsync-backup.sh >> /home/sto/backup/rsync.log 2>&1\n\n0 3 * * * /home/sto/backup/scripts/cron-sync-images.sh >> /home/sto/backup/sync-images.log 2>&1\n0 * * * * H=$(TZ=Asia/Ho_Chi_Minh date +%H); { [ \"$H\" = \"03\" ] || [ \"$H\" = \"17\" ]; } && cd /home/sto/ci/datomworld-python-s3 && git fetch -q origin && git checkout -q origin/master && PATH=$HOME/.local/share/mise/shims:$HOME/.local/bin:/usr/bin:/bin bb src/dev/nightly.clj /home/sto/ci/datomworld-python-s3 node,dart 12 --pin-publish >> $HOME/ci/nightly-cron.log 2>&1\nlrwxrwxrwx 1 sto sto 13 Oct 28 04