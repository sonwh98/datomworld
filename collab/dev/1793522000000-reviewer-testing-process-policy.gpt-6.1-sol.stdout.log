{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '114,230p' src/dev/node_shard.clj && sed -n '1,65p' src/dev/dart_shard.clj && rg -n 'DATOM_SLOW_TESTS|test:all|test:slow|:ns-regexp|:node-test' bb.edn shadow-cljs.edn src/dev/cljd_agg.clj && sed -n '290,465p' src/dev/affected.clj\"","aggregated_output":"    ;; per-subsystem cljs namespaces; the per-run files are the evidence\n    (let [lists (into {} (map (fn [s] [s (cljs-namespaces clone s)]) subs))\n          test-root (str (fs/canonicalize (str clone \"/test\")))\n          all (->> (file-seq (fs/file test-root))\n                   (filter #(re-find #\"_test\\.clj[cs]$\" (str %)))\n                   (map (fn [path]\n                          (-> (str path)\n                              (str/replace (str test-root \"/\") \"\")\n                              ns->test-ns)))\n                   set)\n          covered (apply set/union (map set (vals lists)))\n          uncovered (set/difference all covered)\n          lists (cond-> lists (seq uncovered)\n                        (assoc \"uncovered\" (vec uncovered)))]\n      (log (str \"all=\" (count all) \" covered=\" (count covered)\n                \" uncovered=\" (count uncovered)))\n      (doseq [[s nss] lists]\n        (spit (str out \"/ns-\" s \".txt\") (str/join \"\\n\" nss))))\n    ;; one full compile, no autorun\n    (let [t0 (System/currentTimeMillis)\n          exit (sh (str out \"/compile.log\")\n                   [\"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                    \"compile\" \"test\" \"--config-merge\" \"{:autorun false}\"])]\n      (log (str \"compile-all rc=\" exit\n                \" secs=\" (quot (- (System/currentTimeMillis) t0) 1000)))\n      (when-not (zero? exit) (fail! \"compile failed\")))\n    ;; R1: the bundle's own inventory is the authority on what can run\n    (let [{listing :out} (psh {:dir clone :out :string :continue true}\n                              \"node\" \"target/node-tests.js\" \"--list\")\n          bundle (->> (str/split-lines listing)\n                      (keep #(re-find #\"^Namespace: (\\S+)\" %))\n                      (map second)\n                      set)\n          lists (into {}\n                      (map (fn [s]\n                             [s (some->> (str out \"/ns-\" s \".txt\")\n                                         slurp\n                                         str/split-lines\n                                         (remove str/blank?)\n                                         vec)])\n                           subs))\n          lists (cond-> lists\n                  (.exists (fs/file (str out \"/ns-uncovered.txt\")))\n                  (assoc \"uncovered\"\n                         (->> (slurp (str out \"/ns-uncovered.txt\"))\n                              str/split-lines\n                              (remove str/blank?)\n                              vec)))\n          sel (into {} (map (fn [[s nss]] [s (filterv bundle nss)])) lists)\n          ;; Absence from the bundle's --list means the lane has no tests in\n          ;; that namespace (a JVM-only namespace behind a clj reader\n          ;; conditional compiles to a library with no cljs test vars). That\n          ;; is a lane exclusion, recorded for the summary — not a failure.\n          ;; A failure is a namespace the bundle KNOWS that then fails to\n          ;; run, which the expected-vs-completed check below catches.\n          exclusions (into {}\n                           (remove (fn [[_ nss]] (empty? nss)))\n                           (into {}\n                                 (map (fn [[s nss]]\n                                        [s (set/difference (set nss) bundle)]))\n                                 lists))]\n      (doseq [[s ex] exclusions]\n        (log (str \"lane-excluded \" s \": \" (str/join \",\" (sort ex)))))\n      ;; run up to PAR shards at a time (waves)\n      (let [t0 (System/currentTimeMillis)\n            shards (vec (filter (comp seq sel) (keys sel)))\n            runs (atom {})\n            run-one (fn [s]\n                      (let [t0 (System/currentTimeMillis)\n                            {:keys [exit]}\n                            (psh {:dir clone\n                                  :out (io/file (str out \"/\" s \".log\"))\n                                  :err (io/file (str out \"/\" s \".err.log\"))\n                                  :extra-env {\"DATOM_SLOW_TESTS\" \"1\"}\n                                  :continue true}\n                                 \"node\" \"target/node-tests.js\"\n                                 ;; ONE argument: shadow 3.3.5's runner accepts\n                                 ;; only --test=<list>; a separate \"--test\" arg\n                                 ;; is ignored (\"Unknown arg\") and the worker\n                                 ;; silently runs the FULL suite (2026-11-01).\n                                 (str \"--test=\" (str/join \",\" (sel s))))\n                            secs (quot (- (System/currentTimeMillis) t0) 1000)]\n                        (let [logtxt (try (slurp (str out \"/\" s \".log\"))\n                                          (catch Exception _ \"\"))\n                              suspicious (or (str/includes? logtxt \"Unknown arg\")\n                                             (str/includes? logtxt \"Ran 0 tests\"))]\n                          (when suspicious\n                            (fail! (str \"shard \" s \" ran nothing (selection not applied)\")))\n                          (swap! runs assoc s {:rc exit :secs secs}))\n                        (spit (str out \"/runs.txt\")\n                              (str s \" rc=\" exit \" secs=\" secs \"\\n\")\n                              :append true)))]\n        ;; WORK-STEALING pool, not waves: a wave scheduler parks the next\n        ;; shard until every shard in the current batch finishes, so four\n        ;; 20-second shards leave four slots idle while one heavy shard runs\n        ;; (observed 2026-11-01: load 3.6 on a 24-thread host). Each worker\n        ;; pulls the next shard as soon as it finishes, so all PAR slots stay\n        ;; busy until the queue drains and the wall is the heaviest shard.\n        (let [queue (atom shards)\n              take-one (fn []\n                         (locking queue\n                           (let [cur @queue]\n                             (when (seq cur)\n                               (reset! queue (subvec cur 1))\n                               (first cur)))))]\n          (->> (range (min par (count shards)))\n               (mapv (fn [i]\n                       (future\n                         (loop []\n                           (if-let [s (take-one)]\n                             (do (run-one s) (recur))\n                             i)))))\n               (mapv deref)))\n        (let [expected (count shards)\n              done (count @runs)\n              red (count (filter #(not= 0 (:rc %)) (vals @runs)))\n              wall (quot (- (System/currentTimeMillis) t0) 1000)]\n(ns dart-shard\n  \"Dart lane sharded by subsystem (the bb mirror of shard-jvm.sh).\n\n   One full cljd compile (per-namespace incremental in lib/cljd-out; cannot\n   be parallelized in one clone), then per subsystem a shard directory\n   emitted by cljd_agg.clj (--only / --shard-dir / --no-compile / --no-run),\n   and ONE `flutter test` invocation over all emitted directories — Flutter's\n   test compiler writes a project-wide build/test_cache kernel, so parallel\n   flutter processes in one clone race (gpt-6.1-sol review R3, 2026-10-31).\n   Per-subsystem attribution survives via the emitted directory paths in the\n   output.\n\n   Review fixes implemented here (R1, R3, R6): the uncovered residual shard\n   is emitted and run; emission failures are fatal; per-run immutable out\n   dir (dart-shards-$STAMP, -latest symlink); prerequisite and compile\n   failures are fatal; nonzero exit on any failure.\n\n   Usage: bb src/dev/dart_shard.clj <clone-dir> [concurrency]\n   Exit: 0 all green; 1 any failure.\"\n  (:require [babashka.fs :as fs]\n            [babashka.process :as p]\n            [clojure.java.io :as io]\n            [clojure.set :as set]\n            [clojure.string :as str]))\n\n\n(def subs\n  [\"yang.python\" \"yin.repl\" \"yin.vm\" \"yin.vm.ucf\" \"dao.stream\"\n   \"dao.jing\" \"dao.gui\" \"dao.space\" \"demo\" \"dao.data\"\n   \"dao.postgraphics\" \"yang.base\" \"dao.base\"])\n\n\n(def ^:private child-path\n  \"PATH for every child process: mise shims first (npm/node/flutter/bb/clj all\n   resolve through mise regardless of the caller's ambient PATH), then the\n   inherited PATH, then the system dirs for env/bash.\"\n  (str (System/getProperty \"user.home\") \"/.local/share/mise/shims\"\n       \":/usr/local/bin:/usr/bin:/bin:\"\n       (System/getenv \"PATH\")))\n\n\n(defn- psh\n  \"p/shell with the mise-shims PATH forced into the child environment.\"\n  [opts & cmd]\n  (apply p/shell (assoc opts :extra-env {\"PATH\" child-path}) cmd))\n\n\n(defn cljd-namespaces\n  \"The cljd test namespaces `bb test:sub:list <s>` reports for subsystem s.\"\n  [clone s]\n  (let [{:keys [out]} (psh {:dir clone :out :string :continue true}\n                           \"bb\" \"test:sub:list\" s)\n        section (->> (str/split-lines out)\n                     (drop-while #(not (str/starts-with? % \"cljd:\")))\n                     (rest)\n                     (take-while #(re-matches #\"^\\s+\\S.*$\" %))\n                     (map str/trim)\n                     (remove str/blank?))]\n    (vec section)))\n\n\n(defn -main\n  [& args]\n  (let [clone (or (first args) (System/getProperty \"user.dir\"))\n        conc  (or (some->> (second args) parse-long) 8)\nshadow-cljs.edn:18:          :test {:target :node-test\nbb.edn:272:  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\nbb.edn:284:  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\nbb.edn:288:  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\nbb.edn:290:                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\nbb.edn:293:  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\nbb.edn:295:                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\nbb.edn:300:  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\nbb.edn:304:  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\nbb.edn:310:                          (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\nbb.edn:313:                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\nbb.edn:315:  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\nbb.edn:317:                  :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\nbb.edn:320:  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\nbb.edn:321:             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\nbb.edn:323:  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\nbb.edn:324:            :depends [test:all:clj test:all:cljs test:all:cljd]}\nsrc/dev/cljd_agg.clj:26:   DATOM_SLOW_TESTS is inherited from the environment.\"\n\n(defn- forward-closure\n  [graph roots]\n  (loop [seen (set roots)\n         todo (vec roots)]\n    (if-let [n (peek todo)]\n      (let [new (remove seen (graph n))]\n        (recur (into seen new) (into (pop todo) new)))\n      seen)))\n\n\n(defn- ns-graph\n  [index]\n  (reduce (fn [g {:keys [ns deps]}] (update g ns (fnil into #{}) deps))\n          {}\n          (filter :ns index)))\n\n\n(defn- show\n  [syms]\n  (let [names (sort (map str syms))]\n    (if (> (count names) 4)\n      (str (str/join \", \" (take 4 names)) \", ... (\" (count names) \")\")\n      (str/join \", \" names))))\n\n\n(defn select\n  \"{:wide [path] :reasons {path {:why s :tests #{}}} :tests #{}} for the\n   `changed` paths over `index` (seq of index-entry).\"\n  [index changed]\n  (let [by-path (into {} (map (juxt :path identity)) index)\n        graph (ns-graph index)\n        test-nses (into #{} (comp (filter :test?) (map :ns)) index)\n        tests-of #(into #{} (filter test-nses) (reverse-closure graph %))\n        scanners (fn [path]\n                   (into #{}\n                         (comp (filter (fn [{:keys [roots]}]\n                                         (some #(under-root? % path)\n                                               roots)))\n                               (map :ns))\n                         index))\n        reason (fn [path]\n                 (let [kind (classify path)\n                       scan (scanners path)\n                       scan-why (when (seq scan)\n                                  (str \"; tree walked by \" (show scan)))]\n                   (case kind\n                     :ignored {:why \"ignored\" :tests #{}}\n                     :wide {:why \"wide change\" :tests #{}}\n                     :code\n                     (let [entry (by-path path)\n                           ns (or (:ns entry) (path->ns path))\n                           conv (into #{}\n                                      (comp (keep by-path)\n                                            (filter :test?)\n                                            (map :ns))\n                                      (convention-test-paths path))]\n                       {:why (str \"ns \" ns (when-not entry \" (deleted)\")\n                                  (when (seq conv)\n                                    (str \"; convention test \" (show conv)))\n                                  scan-why)\n                        :tests (into (tests-of (cond-> scan ns (conj ns)))\n                                     conv)})\n                     :resource\n                     (let [readers (into #{}\n                                         (comp (filter #(mentions? (:text %)\n                                                                   path))\n                                               (map :ns))\n                                         index)]\n                       {:why (str (if (seq readers)\n                                    (str \"mentioned by \" (show readers))\n                                    \"no source mentions it\")\n                                  scan-why)\n                        :tests (tests-of (into readers scan))}))))\n        reasons (into (sorted-map) (map (juxt identity reason)) changed)\n        wide (filterv #(= :wide (classify %)) changed)]\n    {:wide wide\n     :reasons reasons\n     :tests (if (seq wide)\n              test-nses\n              (into #{} (mapcat :tests) (vals reasons)))}))\n\n\n(def subsystems-config-path \"src/dev/subsystems.edn\")\n\n\n(defn load-subsystems-config\n  ([] (load-subsystems-config subsystems-config-path))\n  ([path]\n   (when (fs/exists? path)\n     (edn/read-string (slurp path)))))\n\n\n(defn match-subsystem\n  \"Maps a namespace symbol to its canonical subsystem map via longest prefix match.\"\n  [sub-cfg ns-sym]\n  (let [ns-str (str ns-sym)\n        matches (for [s (:subsystems sub-cfg)\n                      p (:prefixes s)\n                      :when (or (= ns-str p)\n                                (str/starts-with? ns-str (str p \".\"))\n                                (str/starts-with? ns-str (str p \"-\")))]\n                  {:sub s :prefix p :len (count p)})]\n    (:sub (first (sort-by (comp - :len) matches)))))\n\n\n(defn select-subsystems\n  \"Returns set of test namespaces belonging to `sub-names`.\"\n  [index sub-cfg sub-names]\n  (let [valid-names (into #{} (map :name) (:subsystems sub-cfg))\n        unknown (remove valid-names sub-names)]\n    (when (seq unknown)\n      (throw (ex-info (str \"unknown subsystem: \" (str/join \", \" unknown))\n                      {:unknown unknown})))\n    (let [target-subs (set sub-names)\n          test-nses (into #{} (comp (filter :test?) (map :ns)) index)]\n      (into #{}\n            (filter (fn [ns-sym]\n                      (when-let [s (match-subsystem sub-cfg ns-sym)]\n                        (target-subs (:name s)))))\n            test-nses))))\n\n\n(defn subsystem-seams\n  \"Computes Class B seams and dependent subsystems for `sub-names`.\"\n  [index sub-cfg sub-names]\n  (let [graph (ns-graph index)\n        sub-by-name (into {} (map (juxt :name identity)) (:subsystems sub-cfg))\n        target-subs (into #{} (keep sub-by-name) sub-names)\n        source-nses (into #{} (comp (remove :test?) (keep :ns)) index)\n        test-nses (into #{} (comp (filter :test?) (keep :ns)) index)\n        target-tests (filter (fn [t]\n                               (when-let [s (match-subsystem sub-cfg t)]\n                                 (some #(= (:name s) (:name %)) target-subs)))\n                             test-nses)\n        class-b (for [t target-tests\n                      dep (forward-closure graph #{t})\n                      :when (source-nses dep)\n                      :let [dep-sub (match-subsystem sub-cfg dep)\n                            t-sub (match-subsystem sub-cfg t)]\n                      :when (and dep-sub t-sub\n                                 (number? (:layer dep-sub))\n                                 (number? (:layer t-sub))\n                                 (> (:layer dep-sub) (:layer t-sub)))]\n                  [t dep (:name dep-sub)])\n        target-sources (into #{}\n                             (filter (fn [s-ns]\n                                       (when-let [s (match-subsystem sub-cfg s-ns)]\n                                         (some #(= (:name s) (:name %)) target-subs))))\n                             source-nses)\n        other-tests (remove (fn [t]\n                              (when-let [s (match-subsystem sub-cfg t)]\n                                (some #(= (:name s) (:name %)) target-subs)))\n                            test-nses)\n        dependent-tests (for [t other-tests\n                              :let [reaches (forward-closure graph #{t})]\n                              :when (some target-sources reaches)\n                              :let [s (match-subsystem sub-cfg t)]\n                              :when s]\n                          (:name s))]\n    {:class-b (distinct class-b)\n     :dependents (into (sorted-set) dependent-tests)}))\n\n\n(defn- lane-file?\n  [lane {:keys [ext path]}]\n  (case lane\n    :clj (#{\"clj\" \"cljc\"} ext)\n    :cljs (#{\"cljs\" \"cljc\"} ext)\n    ;; cljd_agg.clj compiles only *_test.cljc and *_test.cljd files.\n    :cljd (re-find #\"_test\\.clj[cd]$\" path)))\n\n\n(defn lane-tests\n  \"The `tests` namespaces with a source file `lane` runs, sorted.\"\n  [index tests lane]\n","exit_code":0,"status":"completed"}}
