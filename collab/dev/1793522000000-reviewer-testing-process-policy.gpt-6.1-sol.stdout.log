      (shell {:extra-env {\\\\\\\"DATOM_SLOW_TESTS\\\\\\\" \\\\\\\"1\\\\\\\"}}\\\\n   311\\\\t                                 \\\\\\\"clj\\\\\\\" \\\\\\\"-M:cljs\\\\\\\" \\\\\\\"-m\\\\\\\" \\\\\\\"shadow.cljs.devtools.cli\\\\\\\"\\\\n   312\\\\t                                 \\\\\\\"compile\\\\\\\" \\\\\\\"test\\\\\\\" \\\\\\\"--config-merge\\\\\\\"\\\\n   313\\\\t                                 (str \\\\\\\"{:ns-regexp \\\\\\\\\\\\\\\"\\\\\\\" re \\\\\\\"\\\\\\\\\\\\\\\"}\\\\\\\")))}\\\\n   314\\\\t\\\\n   315\\\\t  test:slow:cljd {:doc \\\\\\\"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\\\\\\\"\\\\n   316\\\\t                  :depends [build:yin-repl-peer]\\\\n   317\\\\t                  :task (shell {:extra-env {\\\\\\\"DATOM_SLOW_TESTS\\\\\\\" \\\\\\\"1\\\\\\\"}}\\\\n   318\\\\t                               \\\\\\\"bb src/dev/cljd_agg.clj --slow-only\\\\\\\")}\\\\n   319\\\\t\\\\n   320\\\\t  test:slow {:doc \\\\\\\"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\\\\\\\"\\\\n   321\\\\t             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\\\\n   322\\\\t\\\\n   323\\\\t  test:all {:doc \\\\\\\"Every test on every lane, slow ones included (JVM, Node, Dart)\\\\\\\"\\\\n   324\\\\t            :depends [test:all:clj test:all:cljs test:all:cljd]}\\\\n   325\\\\t\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/1793466815000-reviewer-nightly-testing-plan.gpt-6.1-sol.stdout.log:28:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_13\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg -n 'nightly-pin|node-shard|dart-shard|shard-jvm|nightly-results|unpinned' docs orchestrator-logs src bb.edn --glob '\\\\\\\"'!#*'\\\\\\\"' --max-count 10; rg -n 'shiva|jupiter|HostName|ssh ' mise.toml .agents docs/agents/team.md | head -60\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null