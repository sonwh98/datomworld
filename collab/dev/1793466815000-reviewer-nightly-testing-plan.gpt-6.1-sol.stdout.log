{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes shiva.stigmergy.systems 'for f in ~/ci/node-shard.sh ~/ci/dart-shard.sh ~/ci/nightly-full.sh ~/ci/shard-jvm.sh; do echo FILE:\"'$f; nl -ba \"$f\"; done'\"'\"","aggregated_output":"FILE:/home/sto/ci/node-shard.sh\n     1\t#!/usr/bin/env bash\n     2\t# Usage: node-shard.sh <clone> [parallel]  -- Node lane sharded by subsystem.\n     3\t#\n     4\t# The Node mirror of shard-jvm.sh. ONE full shadow-cljs `:test` compile\n     5\t# (serialized by nature; :autorun false via config-merge), then one `node\n     6\t# target/node-tests.js --test=ns1,ns2,...` process per subsystem, all running\n     7\t# in parallel. Selection is RUNTIME (`--test`), because shadow-cljs's\n     8\t# `:ns-regexp` compile filter does not remove previously cached test\n     9\t# namespaces from the bundle — verified empirically 2026-10-31; `--test` is\n    10\t# verified to run exactly the requested namespaces.\n    11\t#\n    12\t# Namespace lists come from `bb test:sub:list`'s cljs section, driven by\n    13\t# src/dev/subsystems.edn. DATOM_SLOW_TESTS=1 enables the guarded slow bodies,\n    14\t# as test:all:cljs does. A single node process peaked ~3.2 GB RSS, so the\n    15\t# default parallelism is 6 (a 62 GB host fits ~14; leave headroom for tenants).\n    16\tset -u\n    17\texport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"\n    18\tcd \"$1\" || exit 2\n    19\tPAR=\"${2:-6}\"\n    20\tmise trust >/dev/null 2>&1\n    21\teval \"$(mise env -s bash)\"\n    22\tOUT=\"$1/target-ci/node-shards\"; rm -rf \"$OUT\"; mkdir -p \"$OUT\"\n    23\tts() { date +%H:%M:%S; }\n    24\techo \"start $(ts) $(git rev-parse --short HEAD) par=$PAR\" | tee \"$OUT/summary.txt\"\n    25\tnpm ci --silent >\"$OUT/npm.log\" 2>&1                   && echo \"npm ok $(ts)\" | tee -a \"$OUT/summary.txt\"\n    26\tbb build:yin-repl-node >\"$OUT/build-node.log\" 2>&1     && echo \"node repl built $(ts)\" | tee -a \"$OUT/summary.txt\"\n    27\tbb gen:antlr >\"$OUT/antlr.log\" 2>&1                    && echo \"antlr ok $(ts)\" | tee -a \"$OUT/summary.txt\"\n    28\tSUBS=\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\"\n    29\t: > \"$OUT/covered.txt\"\n    30\tfor s in $SUBS; do\n    31\t  bb test:sub:list \"$s\" 2>/dev/null | awk \"/^cljs:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\"\\\");print}\" > \"$OUT/ns-$s.txt\"\n    32\t  cat \"$OUT/ns-$s.txt\" >> \"$OUT/covered.txt\"\n    33\t  echo \"$s $(wc -l < \"$OUT/ns-$s.txt\")\" >> \"$OUT/plan.txt\"\n    34\tdone\n    35\t# coverage: every cljs test namespace under test/ vs the union of the shards\n    36\tfind test -type f \\( -name \"*_test.cljc\" -o -name \"*_test.cljs\" \\) | sed -e \"s#^test/##\" -e \"s#\\.clj[cs]\\?\\$##\" -e \"s#/#.#g\" -e \"s#_#-#g\" | sort -u > \"$OUT/all.txt\"\n    37\tsort -u \"$OUT/covered.txt\" > \"$OUT/covered.sorted\"\n    38\tcomm -23 \"$OUT/all.txt\" \"$OUT/covered.sorted\" > \"$OUT/ns-uncovered.txt\"\n    39\techo \"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\" | tee -a \"$OUT/summary.txt\"\n    40\t\n    41\tt0=$(date +%s)\n    42\tclj -M:cljs -m shadow.cljs.devtools.cli compile test --config-merge \"{:autorun false}\" >\"$OUT/compile.log\" 2>&1\n    43\trc=$?\n    44\techo \"compile-all rc=$rc secs=$(( $(date +%s)-t0 )) $(ts)\" | tee -a \"$OUT/summary.txt\"\n    45\t[ \"$rc\" = \"0\" ] || { echo \"done (compile failed) $(ts)\" | tee -a \"$OUT/summary.txt\"; exit 1; }\n    46\t\n    47\t# one --test list per shard: the subsystem's namespaces, plus the uncovered residual\n    48\tfor s in $SUBS uncovered; do\n    49\t  f=\"$OUT/ns-$s.txt\"; [ -s \"$f\" ] || continue\n    50\t  paste -sd, \"$f\" > \"$OUT/sel-$s.txt\"\n    51\tdone\n    52\t\n    53\trun_shard() {\n    54\t  s=$1; sel=\"$OUT/sel-$s.txt\"; [ -s \"$sel\" ] || return 0\n    55\t  t0=$(date +%s)\n    56\t  DATOM_SLOW_TESTS=1 node target/node-tests.js --test=\"$(cat \"$sel\")\" >\"$OUT/$s.log\" 2>&1\n    57\t  rc=$?\n    58\t  echo \"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \"^Ran \" \"$OUT/$s.log\" | tail -1)\" >> \"$OUT/runs.txt\"\n    59\t}\n    60\texport -f run_shard; export OUT\n    61\tt0=$(date +%s)\n    62\t: > \"$OUT/runs.txt\"\n    63\t{ for s in $SUBS uncovered; do [ -s \"$OUT/sel-$s.txt\" ] && echo \"$s\"; done; } | \\\n    64\t  xargs -P \"$PAR\" -I{} bash -c \"run_shard {}\"\n    65\tsort -o \"$OUT/runs.txt\" \"$OUT/runs.txt\"\n    66\tcat \"$OUT/runs.txt\" | tee -a \"$OUT/summary.txt\"\n    67\tRED=$(grep -oE \"rc=[0-9]+\" \"$OUT/runs.txt\" | grep -vc \"rc=0\")\n    68\tWALL=$(( $(date +%s)-t0 ))\n    69\techo \"node-sharded lanes=$(grep -c \"rc=\" \"$OUT/runs.txt\") red-lanes=$RED wall=${WALL}s $(ts)\" | tee -a \"$OUT/summary.txt\"\n    70\techo \"done $(ts)\" | tee -a \"$OUT/summary.txt\"\nFILE:/home/sto/ci/dart-shard.sh\n     1\t#!/usr/bin/env bash\n     2\t# Usage: dart-shard.sh <clone> [parallel]  -- Dart lane sharded by subsystem.\n     3\t#\n     4\t# The Dart mirror of shard-jvm.sh. One full cljd compile (the compile is\n     5\t# per-namespace incremental in lib/cljd-out and cannot be parallelized in one\n     6\t# clone), then one `flutter test build/cljd-agg-<s>` process per subsystem,\n     7\t# all running in parallel. Shard emission is cljd_agg.clj's own greedy-by-size\n     8\t# grouping (up to 8 shard files per subsystem), isolated per subsystem via\n     9\t# --shard-dir so parallel flutter processes never share build/cljd-agg.\n    10\t#\n    11\t# Requires the --shard-dir/--no-compile/--no-run flags in src/dev/cljd_agg.clj\n    12\t# (added 2026-10-31). Namespace lists come from `bb test:sub:list`'s cljd\n    13\t# section, driven by src/dev/subsystems.edn; DATOM_SLOW_TESTS=1 enables the\n    14\t# guarded slow bodies, as test:all:cljd does. A flutter process is heavy\n    15\t# (~1-2 GB), so the default parallelism is 4.\n    16\tset -u\n    17\texport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"\n    18\tcd \"$1\" || exit 2\n    19\tPAR=\"${2:-4}\"\n    20\tmise trust >/dev/null 2>&1\n    21\teval \"$(mise env -s bash)\"\n    22\tOUT=\"$1/target-ci/dart-shards\"; rm -rf \"$OUT\"; mkdir -p \"$OUT\"\n    23\tts() { date +%H:%M:%S; }\n    24\techo \"start $(ts) $(git rev-parse --short HEAD) par=$PAR\" | tee \"$OUT/summary.txt\"\n    25\tbb build:yin-repl-peer >\"$OUT/build-peer.log\" 2>&1     && echo \"dart peer built $(ts)\" | tee -a \"$OUT/summary.txt\"\n    26\tSUBS=\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\"\n    27\t: > \"$OUT/covered.txt\"\n    28\tfor s in $SUBS; do\n    29\t  bb test:sub:list \"$s\" 2>/dev/null | awk \"/^cljd:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\"\\\");print}\" > \"$OUT/ns-$s.txt\"\n    30\t  cat \"$OUT/ns-$s.txt\" >> \"$OUT/covered.txt\"\n    31\t  echo \"$s $(wc -l < \"$OUT/ns-$s.txt\")\" >> \"$OUT/plan.txt\"\n    32\tdone\n    33\t# coverage: every test namespace under test/ vs the union of the shards\n    34\t# (the cljd tool compiles every *_test.clj[cd]; the same all-set the\n    35\t#  node-shard and JVM shards check against)\n    36\tfind test -type f \\( -name \"*_test.cljc\" -o -name \"*_test.cljd\" \\) | sed -e \"s#^test/##\" -e \"s#\\.clj[cd]\\?\\$##\" -e \"s#/#.#g\" -e \"s#_#-#g\" | sort -u > \"$OUT/all.txt\"\n    37\tsort -u \"$OUT/covered.txt\" > \"$OUT/covered.sorted\"\n    38\tcomm -23 \"$OUT/all.txt\" \"$OUT/covered.sorted\" > \"$OUT/ns-uncovered.txt\"\n    39\techo \"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\" | tee -a \"$OUT/summary.txt\"\n    40\t\n    41\tt0=$(date +%s)\n    42\tALLNS=$(cat \"$OUT\"/ns-*.txt | sort -u | paste -sd\" \" -)\n    43\tclojure -M:clojuredart:cljd compile $ALLNS >\"$OUT/compile.log\" 2>&1\n    44\trc=$?\n    45\techo \"compile-all rc=$rc secs=$(( $(date +%s)-t0 )) $(ts)\" | tee -a \"$OUT/summary.txt\"\n    46\t[ \"$rc\" = \"0\" ] || { echo \"done (compile failed) $(ts)\" | tee -a \"$OUT/summary.txt\"; exit 1; }\n    47\t\n    48\t# emit one shard dir per subsystem (sequential; with --no-compile each is fast)\n    49\tfor s in $SUBS; do\n    50\t  f=\"$OUT/ns-$s.txt\"; [ -s \"$f\" ] || continue\n    51\t  nss=$(paste -sd, \"$f\")\n    52\t  bb src/dev/cljd_agg.clj --only \"$nss\" --shard-dir \"build/cljd-agg-$s\" --no-compile --no-run \\\n    53\t    > \"$OUT/$s.emit.log\" 2>&1\n    54\t  rc=$?\n    55\t  echo \"$s emit rc=$rc $(ts)\" >> \"$OUT/emits.txt\"\n    56\tdone\n    57\techo \"shards emitted $(ts)\" | tee -a \"$OUT/summary.txt\"\n    58\t\n    59\trun_shard() {\n    60\t  s=$1; d=\"build/cljd-agg-$s\"\n    61\t  [ -d \"$d\" ] || return 0\n    62\t  t0=$(date +%s)\n    63\t  DATOM_SLOW_TESTS=1 flutter test --concurrency 4 \"$d\" >\"$OUT/$s.log\" 2>&1\n    64\t  rc=$?\n    65\t  echo \"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -oE \"[0-9]+ -[0-9]+:\" \"$OUT/$s.log\" | tail -1)\" >> \"$OUT/runs.txt\"\n    66\t}\n    67\texport -f run_shard; export OUT\n    68\tt0=$(date +%s)\n    69\t: > \"$OUT/runs.txt\"\n    70\t{ for s in $SUBS; do [ -d \"build/cljd-agg-$s\" ] && echo \"$s\"; done; } | \\\n    71\t  xargs -P \"$PAR\" -I{} bash -c \"run_shard {}\"\n    72\tsort -o \"$OUT/runs.txt\" \"$OUT/runs.txt\"\n    73\tcat \"$OUT/runs.txt\" | tee -a \"$OUT/summary.txt\"\n    74\tRED=$(grep -oE \"rc=[0-9]+\" \"$OUT/runs.txt\" | grep -vc \"rc=0\")\n    75\tWALL=$(( $(date +%s)-t0 ))\n    76\techo \"dart-sharded lanes=$(grep -c \"rc=\" \"$OUT/runs.txt\") red-lanes=$RED wall=${WALL}s $(ts)\" | tee -a \"$OUT/summary.txt\"\n    77\techo \"done $(ts)\" | tee -a \"$OUT/summary.txt\"\nFILE:/home/sto/ci/nightly-full.sh\n     1\t#!/usr/bin/env bash\n     2\t# Nightly split (owner ruling 2026-10-31): shiva runs the Node and Dart lanes.\n     3\t# The JVM sharded lane runs on jupiter (~/ci/nightly-jvm.sh there) — jupiter is\n     4\t# the faster JVM/sharding box; shiva keeps the lanes that need normal Node\n     5\t# speed. Guard: the owner-scheduled 03:00 Vietnam window; the crontab fires\n     6\t# hourly and the suite runs only in the Vietnam 3am hour, so the US DST shift\n     7\t# never moves the run. NOW=1 forces an immediate run.\n     8\t#\n     9\t# Commit pinning: THIS host resolves origin/master first and pins the SHA in\n    10\t# ~/ci/nightly-pin.txt; jupiter's nightly-jvm.sh reads that pin over SSH so\n    11\t# both hosts test the SAME commit even if a push lands mid-window. If a push\n    12\t# lands between shiva's fetch and its checkout, the checkout uses the pinned\n    13\t# SHA regardless.\n    14\t#\n    15\t# Summary sync: when this host's lanes finish, its summary is pushed to\n    16\t# jupiter (and jupiter's is pulled here), so each host's nightly-results\n    17\t# holds the full tri-host picture.\n    18\tif [ \"${NOW:-}\" != \"1\" ] && [ \"$(TZ=Asia/Ho_Chi_Minh date +%H)\" != \"03\" ]; then\n    19\t  exit 0\n    20\tfi\n    21\t\n    22\t# The nightly full suite, this host's share: Node and Dart lanes, against the\n    23\t# pinned commit, in this clone. The JVM leg lives on jupiter.\n    24\tset -u\n    25\texport PATH=\"$HOME/.local/bin:$PATH\"\n    26\tcd ~/ci/datomworld-python-s3 || exit 2\n    27\tmise trust >/dev/null 2>&1\n    28\teval \"$(mise env -s bash)\"\n    29\tOUT=~/ci/nightly-results; mkdir -p \"$OUT\"\n    30\tSTAMP=$(date +%Y%m%d-%H%M)\n    31\tgit fetch -q origin\n    32\tSHA=$(git rev-parse origin/master)\n    33\techo \"$SHA\" > ~/ci/nightly-pin.txt\n    34\tgit checkout -q --detach \"$SHA\"\n    35\techo \"nightly $STAMP at $(git log --oneline -1) (pinned $(date +%H:%M:%S))\" > \"$OUT/$STAMP-summary.txt\"\n    36\tbb gen:antlr > \"$OUT/$STAMP-gen.log\" 2>&1 || { echo \"gen failed\" >> \"$OUT/$STAMP-summary.txt\"; exit 1; }\n    37\ts=$(date +%s)\n    38\tbb test:all:cljs > \"$OUT/$STAMP-cljs-full.log\" 2>&1\n    39\techo \"cljs-full rc=$? secs=$(($(date +%s)-s)) $(grep -E \"^Ran \" \"$OUT/$STAMP-cljs-full.log\" | tail -1) $(grep -oE \"[0-9]+ failures, [0-9]+ errors\" \"$OUT/$STAMP-cljs-full.log\" | tail -1)\" >> \"$OUT/$STAMP-summary.txt\"\n    40\ts=$(date +%s)\n    41\tbb test:all:cljd > \"$OUT/$STAMP-cljd-full.log\" 2>&1\n    42\techo \"cljd-full rc=$? secs=$(($(date +%s)-s)) $(tail -1 \"$OUT/$STAMP-cljd-full.log\" | head -c 80)\" >> \"$OUT/$STAMP-summary.txt\"\n    43\techo done >> \"$OUT/$STAMP-summary.txt\"\n    44\t# Summary sync (best effort; the nightly result must not fail over a sync hiccup)\n    45\tssh -o BatchMode=yes jupiter.stigmergy.systems \"mkdir -p ~/ci/nightly-results\" 2>/dev/null\n    46\tscp -q \"$OUT/$STAMP-summary.txt\" \"jupiter.stigmergy.systems:~/ci/nightly-results/$STAMP-summary-from-shiva.txt\" 2>/dev/null \\\n    47\t  || echo \"summary push to jupiter failed\" >> \"$OUT/$STAMP-summary.txt\"\n    48\tscp -q \"jupiter.stigmergy.systems:~/ci/nightly-results/nightly-jvm-latest-summary.txt\" \"$OUT/latest-summary-from-jupiter.txt\" 2>/dev/null || true\n    49\texit 0\nFILE:/home/sto/ci/shard-jvm.sh\n     1\t#!/usr/bin/env bash\n     2\t# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\n     3\tset -u\n     4\texport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"\n     5\tcd \"$1\" || exit 2\n     6\tPAR=\"${2:-8}\"\n     7\tmise trust >/dev/null 2>&1\n     8\teval \"$(mise env -s bash)\"\n     9\tOUT=\"$1/target-ci/shards\"; rm -rf \"$OUT\"; mkdir -p \"$OUT\"\n    10\tts() { date +%H:%M:%S; }\n    11\techo \"start $(ts) $(git rev-parse --short HEAD) par=$PAR\" | tee \"$OUT/summary.txt\"\n    12\tnpm ci --silent >\"$OUT/npm.log\" 2>&1                   && echo \"npm ok $(ts)\" | tee -a \"$OUT/summary.txt\"\n    13\tbb build:yin-repl-node >\"$OUT/build-node.log\" 2>&1     && echo \"node repl built $(ts)\" | tee -a \"$OUT/summary.txt\"\n    14\tbb gen:antlr >\"$OUT/antlr.log\" 2>&1             && echo \"antlr ok $(ts)\" | tee -a \"$OUT/summary.txt\"\n    15\tSUBS=\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\"\n    16\t: > \"$OUT/covered.txt\"\n    17\tfor s in $SUBS; do\n    18\t  bb test:sub:list \"$s\" 2>/dev/null | awk \"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\"\\\");print}\" > \"$OUT/ns-$s.txt\"\n    19\t  cat \"$OUT/ns-$s.txt\" >> \"$OUT/covered.txt\"\n    20\t  echo \"$s $(wc -l < \"$OUT/ns-$s.txt\")\" >> \"$OUT/plan.txt\"\n    21\tdone\n    22\t# coverage: every JVM test namespace under test/ vs the union of the shards\n    23\tfind test -type f \\( -name \"*_test.clj\" -o -name \"*_test.cljc\" \\) | sed -e \"s#^test/##\" -e \"s#\\.cljc\\?\\$##\" -e \"s#/#.#g\" -e \"s#_#-#g\" | sort -u > \"$OUT/all.txt\"\n    24\tsort -u \"$OUT/covered.txt\" > \"$OUT/covered.sorted\"\n    25\tcomm -23 \"$OUT/all.txt\" \"$OUT/covered.sorted\" > \"$OUT/ns-uncovered.txt\"\n    26\techo \"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\" | tee -a \"$OUT/summary.txt\"\n    27\trun_shard() {\n    28\t  s=$1; f=\"$OUT/ns-$s.txt\"; [ -s \"$f\" ] || return 0\n    29\t  args=(); while read -r n; do args+=(-n \"$n\"); done < \"$f\"\n    30\t  t0=$(date +%s); clojure -M:test -e :slow \"${args[@]}\" >\"$OUT/$s.log\" 2>&1; rc=$?\n    31\t  echo \"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \"^Ran \" \"$OUT/$s.log\" | tail -1)\" | tee -a \"$OUT/summary.txt\"\n    32\t}\n    33\texport -f run_shard; export OUT; export -f ts\n    34\tprintf \"%s\\n\" $SUBS uncovered | xargs -P \"$PAR\" -I{} bash -c \"run_shard {}\"\n    35\techo \"done $(ts)\" | tee -a \"$OUT/summary.txt\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"unzip -p /Users/sto/.m2/repository/thheller/shadow-cljs/3.3.5/shadow-cljs-3.3.5.jar shadow/test/node.cljs; unzip -p /Users/sto/.m2/repository/thheller/shadow-cljs/3.3.5/shadow-cljs-3.3.5.jar shadow/build/targets/node_test.clj; rg -n 'compile|delete|spit|test.*dart|\\\\.dart' /Users/sto/.gitlibs/libs/sonwh98/clojuredart/7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31/src/cljd/build.clj --max-count 25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"unzip -p /Users/sto/.m2/repository/thheller/shadow-cljs/3.3.5/shadow-cljs-3.3.5.jar shadow/test/node.cljs; unzip -p /Users/sto/.m2/repository/thheller/shadow-cljs/3.3.5/shadow-cljs-3.3.5.jar shadow/build/targets/node_test.clj; rg -n 'compile|delete|spit|test.*dart|\\\\.dart' /Users/sto/.gitlibs/libs/sonwh98/clojuredart/7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31/src/cljd/build.clj --max-count 25\"","aggregated_output":"(ns shadow.test.node\n  {:dev/always true}\n  (:require\n    [shadow.test.env :as env]\n    [cljs.test :as ct]\n    [shadow.test :as st]\n    [clojure.string :as str]))\n\n;; FIXME: add option to not exit the node process?\n(defmethod ct/report [::ct/default :end-run-tests] [m]\n  (if (ct/successful? m)\n    (js/process.exit 0)\n    (js/process.exit 1)))\n\n;; get-test-data is a macro so this namespace REQUIRES :dev/always hint ns so that it is always recompiled\n(defn ^:dev/after-load reset-test-data! []\n  (-> (env/get-test-data)\n      (env/reset-test-data!)))\n\n(defn parse-args [args]\n  (reduce\n    (fn [opts arg]\n      (cond\n        (= \"--help\" arg)\n        (assoc opts :help true)\n\n        (= \"--list\" arg)\n        (assoc opts :list true)\n\n        (str/starts-with? arg \"--test=\")\n        (let [test-arg (subs arg 7)\n              test-syms\n              (->> (str/split test-arg \",\")\n                   (map symbol))]\n          (update opts :test-syms into test-syms))\n\n        :else\n        (do (println (str \"Unknown arg: \" arg))\n            opts)\n        ))\n    {:test-syms []}\n    args))\n\n(defn find-matching-test-vars [test-syms]\n  ;; FIXME: should have some kind of wildcard support\n  (let [test-namespaces\n        (->> test-syms (filter simple-symbol?) (set))\n        test-var-syms\n        (->> test-syms (filter qualified-symbol?) (set))]\n\n    (->> (env/get-test-vars)\n         (filter (fn [the-var]\n                   (let [{:keys [name ns]} (meta the-var)]\n                     (or (contains? test-namespaces ns)\n                         (contains? test-var-syms (symbol ns name))))))\n         )))\n\n(defn execute-cli [{:keys [test-syms help list] :as opts}]\n  (let [test-env\n        (-> (ct/empty-env)\n            ;; can't think of a proper way to let CLI specify custom reporter?\n            ;; :report-fn is mostly for UI purposes, CLI should be fine with default report\n            #_(assoc :report-fn\n                (fn [m]\n                  (tap> [:test m (ct/get-current-env)])\n                  (prn m))))]\n\n    (cond\n      help\n      (do (println \"Usage:\")\n          (println \"  --list (list known test names)\")\n          (println \"  --test=<ns-to-test>,<fqn-symbol-to-test> (run test for namespace or single var, separated by comma)\"))\n\n      list\n      (doseq [[ns ns-info]\n              (->> (env/get-tests)\n                   (sort-by first))]\n        (println \"Namespace:\" ns)\n        (doseq [var (:vars ns-info)\n                :let [m (meta var)]]\n          (println (str \"  \" (:ns m) \"/\" (:name m))))\n        (println \"---------------------------------\"))\n\n      (seq test-syms)\n      (let [test-vars (find-matching-test-vars test-syms)]\n        (st/run-test-vars test-env test-vars))\n\n      :else\n      (st/run-all-tests test-env nil)\n      )))\n\n(defn main [& args]\n  (reset-test-data!)\n\n  (if env/UI-DRIVEN\n    (js/console.log \"Waiting for UI ...\")\n    (let [opts (parse-args args)]\n      (execute-cli opts))))\n(ns shadow.build.targets.node-test\n  (:refer-clojure :exclude (compile flush resolve))\n  (:require\n    [shadow.build :as build]\n    [shadow.build.modules :as modules]\n    [shadow.build.classpath :as cp]\n    [shadow.build.targets.node-script :as node-script]\n    [shadow.cljs.util :as util]\n    [shadow.cljs.devtools.server.util :refer (pipe)]\n    [shadow.build.async :as async]\n    [shadow.build.test-util :as tu]\n    [shadow.build.targets.shared :as shared]\n    [shadow.jvm-log :as log]))\n\n(defn configure [{::build/keys [config mode] :as state}]\n  (let [runner-ns (or (when-let [main (:main config)]\n                        (-> main namespace symbol))\n                      'shadow.test.node)]\n    (-> state\n        (tu/configure-common)\n        (assoc ::tu/runner-ns runner-ns)\n        (assoc-in [:compiler-options :closure-defines 'cljs.core/*target*] \"nodejs\")\n        (update :build-options merge {:greedy true\n                                      :dynamic-resolve true})\n        (update ::build/config merge {:main (get config :main 'shadow.test.node/main)})\n        ;; (update-in [::build/config :devtools] assoc :enabled false)\n\n        (cond->\n          (and (:ui-driven config) (:worker-info state))\n          ;; just the defines, preloads are added in resolve\n          (-> (shared/inject-node-repl config)\n              (assoc-in [:compiler-options :closure-defines 'shadow.test.env/UI-DRIVEN] true))\n          ))))\n\n;; since :configure is only called once in :dev\n;; we delay setting the :entries until compile-prepare which is called every cycle\n;; need to come up with a cleaner API for this\n(defn test-resolve\n  [{::build/keys [mode config] :as state}]\n  (let [test-namespaces\n        (tu/find-test-namespaces state config)\n\n        entries\n        (-> '[shadow.test.env] ;; must be included before any deftest because of the cljs.test mod\n            (cond->\n              (and (:ui-driven config) (:worker-info state))\n              (conj 'shadow.cljs.devtools.client.node 'shadow.remote.runtime.cljs.node 'shadow.test.remote-inject)\n\n              (= :dev mode)\n              (into (get-in config [:devtools :preloads])))\n            (into test-namespaces)\n            (conj (::tu/runner-ns state)))]\n\n    (log/debug ::test-resolve {:config config\n                               :test-namespaces test-namespaces})\n\n    (-> state\n        (a