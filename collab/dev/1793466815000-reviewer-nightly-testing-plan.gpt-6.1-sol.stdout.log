 \".\" \"\\\\\\\\.\") nses))\n   479\t       \")$\"))\n   480\t\n   481\t\n   482\t(defn- sum-of\n   483\t  [re text]\n   484\t  (let [ms (re-seq re text)]\n   485\t    (when (seq ms)\n   486\t      (reduce + (map #(reduce + (map parse-long (rest %))) ms)))))\n   487\t\n   488\t\n   489\t(defn parse-summary\n   490\t  \"{:tests n :failures n} from a lane log; nil values when unreadable.\n   491\t   Dart counts the last flutter progress line: tests are passed plus\n   492\t   failed, failures the failed.\"\n   493\t  [lane text]\n   494\t  (if (= :cljd lane)\n   495\t    (if-let [[_ ok _skip bad] (last (re-seq #\"\\+(\\d+)(?: ~(\\d+))?(?: -(\\d+))?:\"\n   496\t                                            text))]\n   497\t      (let [bad (if bad (parse-long bad) 0)]\n   498\t        {:tests (+ (parse-long ok) bad) :failures bad})\n   499\t      {:tests nil :failures nil})\n   500\t    {:tests (sum-of #\"Ran (\\d+) tests\" text)\n   501\t     :failures (sum-of #\"(\\d+) failures, (\\d+) errors\" text)}))\n   502\t\n   503\t\n   504\t(defn- reached-text\n   505\t  \"The source texts of `tests` and everything they require.\"\n   506\t  [index tests]\n   507\t  (let [nses (forward-closure (ns-graph index) tests)]\n   508\t    (keep #(when (nses (:ns %)) (:text %)) index)))\n   509\t\n   510\t\n   511\t(defn prerequisites\n   512\t  \"The bb build tasks the per-lane selection `selected` {lane [ns]} needs:\n   513\t   a task is needed when a selected test, or a namespace it requires,\n   514\t   names the artifact the task builds. ANTLR classes are JVM only.\"\n   515\t  [index selected]\n   516\t  (let [all (into #{} (mapcat val) selected)\n   517\t        texts (reached-text index all)\n   518\t        clj-texts (reached-text index (set (:clj selected)))\n   519\t        any? (fn [texts re] (some #(re-find re %) texts))]\n   520\t    (cond-> #{}\n   521\t      (any? texts #\"yin-repl\\.js\") (conj :build:yin-repl-node)\n   522\t      (any? texts #\"yin-repl-peer\") (conj :