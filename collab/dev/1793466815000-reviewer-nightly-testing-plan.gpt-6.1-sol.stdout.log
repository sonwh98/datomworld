s (:code-aliases machine) image))))\\n\\n\\n(defn load-ast\\n  \\\"Project AST datoms through the phase-3 loader.\\\"\\n  [machine datoms stamp]\\n  (vm/check-contract! vm/ast-contract stamp)\\n  (load-vector machine (:vector (linearize/project-datoms datoms)) code/contract))\\n\\n\\n(extend-type RegisterVM\\n  vm/IVM\\n  (step [machine] (telemetry/emit-snapshot\\n                    (if (engine/ready-for-ingress? machine) machine (vm-hot machine 1)) :step))\\n  (run [machine] (ffi/maybe-run machine register-run-scheduler))\\n  (eval [machine ast]\\n    (when ast (throw (ex-info \\\"The register VM executes loaded vectors; use load-ast\\\" {:ast ast})))\\n    (engine/restore-initial-env (:env machine) (vm/run machine)))\\n  (reset [machine]\\n    (assoc machine :control (when-let [seg (:program machine)] {:segment seg :pc 0})\\n           :window {} :k nil :value nil :halted? (nil? (:program machine)) :blocked? false))\\n  (halted? [machine] (engine/halted-with-empty-queue? machine))\\n  (blocked? [machine] (engine/vm-blocked? machine))\\n  (value [machine] (engine/vm-value machine))\\n  vm/IVMState\\n  (control [machine] (:control machine))\\n  (environment [machine] (:env machine))\\n  (store [machine] (:store machine))\\n  (continuation [machine] (:k machine)))\\n\\n\\n(defn create-vm\\n  \\\"Create a new RegisterVM.\\n\\n   Options:\\n     :env           initial lexical environment\\n     :primitives    primitive operations map\\n     :primitive-profiles published primitive profile registry\\n     :primitive-canonical-names name -> canonical name for intentional aliases\\n     :modules       module registry value (see `yin.vm.module`)\\n     :make-stream   (fn [capacity] -> create outcome); no default\\n     :call-in       explicit inbound request handle\\n     :call-out      explicit outbound response handle\\n     :call-out-cursor, :ffi-caller-id  `yin.vm/empty-state`'s\\n     :call-capacity capacity for a constructed FFI pair\\n     :bridge        host FFI handlers\\n\\n   As for the walker: there is no `:in-stream` (program observation belongs\\n   to `dao.stream.observer`), and construction is all-or-nothing — the FFI\\n   pair and its call-out cursor are stream operations whose failure fails\\n   here.\\\"\\n  ([] (create-vm {}))\\n  ([opts]\\n   (when (contains? opts :in-stream)\\n     (throw (ex-info\\n              \\\"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\\\"\\n              {:in-stream (:in-stream opts)})))\\n   (let [env (vm/check-bindings! :env (or (:env opts) {}))\\n         base (vm/empty-state\\n                (assoc (select-keys opts\\n                                    [:primitives :primitive-profiles\\n                                     :primitive-canonical-names :modules\\n                                     :make-stream :call-in :call-out\\n                                     :call-out-cursor :ffi-caller-id\\n                                     :call-capacity :link-request\\n                                     :link-response :origin :ancestry\\n                                     :capability-secret :secret-source\\n                                     :attach-stream :gc-threshold])\\n                       :telemetry (:telemetry opts)\\n                       :vm-model :semantic-register))]\\n     (-> (map->RegisterVM (merge base\\n                                 {:bridge nil,\\n                                  :program nil,\\n                                  :control nil,\\n                                  :env env,\\n                                  :free-env env,\\n                                  :window {},\\n                                  :k nil,\\n                                  :value nil,\\n                                  :code {},\\n                                  :code-aliases {},\\n                                  :halted? true,\\n                                  :blocked? false}))\\n         (telemetry/install :semantic-register)\\n         (ffi/attach (:bridge opts))\\n         (telemetry/emit-snapshot :init)))))\\n\\n               :yin.k/env (into {}\\n                                (map (fn [[k x]] [k (encode x)]))\\n                                (engine/without-store-of env))}\\n        store-of (assoc :yin.k/store-of store-of))))\\n  (lower-closure [vm marker decode]\\n    (when-not (and (= :named (:yin.k/binding marker))\\n                   (= :yin.semantic-register/code (:yin.k/format marker)))\\n      (throw (ex-info \\\"Closure binding or format does not match this kernel\\\" {:reason :binding-mismatch :marker marker})))\\n    (let [local (get (:code-aliases vm) (:yin.k/segment marker))\\n          entry (:yin.k/entry marker)\\n          store-of (:yin.k/store-of marker)]\\n      ;; An entry outside the attached image names no code of it either.\\n      (when-not (and (some? local)\\n                     (nat-int? entry)\\n                     (< entry (count (get-in vm [:code local :vector]))))\\n        (throw (ex-info \\\"Closure origin image is not attached\\\"\\n                        {:reason :origin-not-attached,\\n                         :segment (:yin.k/segment marker)})))\\n      ;; the binders are those of a `:closure` tuple of the attached image\\n      ;; whose entry this is, never the wire's\\n      (vm/check-params! (:yin.k/params marker))\\n      (when-not (some (fn [inst]\\n                        (and (= :closure (nth inst 0))\\n                             (= entry (nth inst 3))\\n                             (= (:yin.k/params marker) (nth inst 2))))\\n                      (get-in vm [:code local :vector]))\\n        (engine/marker-mismatch! marker))\\n      (values/closure\\n        (:owner vm)\\n        {:type :closure,\\n         :params (:yin.k/params marker),\\n         :entry entry,\\n         :segment local,\\n         :env (cond-> (into {}\\n                            (map (fn [[k x]] [k (decode x)]))\\n                            (:yin.k/env marker))\\n                store-of (assoc engine/store-of-key store-of))})))\\n  (gc-roots [machine]\\n    {:kernel [(:control machine) (:k machine)]\\n     :values [(:free-env machine) (:env machine) (:window machine) (:value machine)]})\\n  (gc-children [_ _x] nil))\\n1020:  constructed the task with. **Coordinated retention seam, recommended**:\\n1021-  4b (stage 3, its track's file) adds an immutable `free-env` field set\\n1022-  once in `create-vm` from the checked `:env` and never written by any\\n1023-  transition, with `gc-roots` listing it; once it lands the lift reads\\n1024-  it when `:free-env` is not supplied and the explicit argument stays as\\n1025-  the override for compositions that constructed the task elsewhere.\\n1026-  Phase 6 does **not** edit `semantic_register.cljc`; 6b depends on the\\n1027-  explicit argument and names the seam as a follow-up (§8.2).\\n1028-\\n1029-Merkle sharing means every `E` whose bindings equal another's shares one\\n1030-`:bindings` row; the root slot is one more reference to a row that\\n1031-usually already exists.\\n1032-\\n1033----\\n1034-\\n1035-## 7. Lift and lower\\n1036-\\n1037-### 7.1 Lift\\n1038-\\n1039-**DECIDED** (draft §9, UCF §7.8): refuse unless quiescent; refuse the\\n1040-holds (`unliftable-hold`, `handoff.cljc:588`) as `:yin.k/non-portable\\n1041-:reason-mismatch`; classify kind; run the **dependency closure over the\\n1042-`\\\"v4\\\"` vectors**, which needs the phase-5 scanners\\n1043-(`scan/requirements`, `scan/free-names`, `scan/free-occurrences` over the\\n1044-§2.3 table: the current `completion/code-facts` reads stack-table\\n1045-positions and cannot be used), and refuse `:yin.k/unsatisfied` unless\\n1046-`:complete`, `:yin.k/trees` included; number cursor cells (draft §6); walk\\n1047-waits, parked records, the store slice, module stores, the free\\n1048-environment (from the kernel's `:free-env` field or the lift's explicit\\n1049-`:free-env` argument, §6.3, never from a current `E`), the result,\\n1050-install children; run `frame/defect` over every\\n1051-frame; emit rows and the census. A de Bruijn source walks the frames\\n1052-`layout/lift-act`/`lift-tail` reconstruct.\\nReading additional input from stdin...\\n{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"01a12ed2-eb3c-7ee2-a350-a65e0f083bb0\\\"}\\n{\\\"type\\\":\\\"turn.started\\\"}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_0\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I’ll read the resume prompt and the project’s development rules, then carry out the requested work.\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/1792195000000-engineer-free-env-seam.resume.prompt.md; cat docs/design/datom.world.md'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/1792195000000-engineer-free-env-seam.resume.prompt.md; cat docs/design/datom.world.md'\\\",\\\"aggregated_output\\\":\\\"Your previous run died on a service capacity error during step 5(e), after the mutant was reverted. The diff in the worktree is yours; do not redo it. Do now, in the foreground: (1) confirm no transition writes `free-env` (grep `:free-env` in src/cljc/yin/vm/semantic_register.cljc: only create-vm and gc-roots); (2) do the mutation check once more: make a transition write `:free-env` (e.g. add `:free-env E` to the state map near `:window W :env E`), run `clojure -M:test -e :slow -n yin.vm.semantic-register.vm-test`, confirm failures, then revert it and confirm `git diff` shows only your intended change and the namespace passes (expected 18 tests, 165 assertions); (3) write `collab/1792195000000-engineer-free-env-seam.report.md` per the original brief (files changed, what restore paths do with the field, test counts, mutation result, uncertainties). Use `clojure -M:test -e :slow -n <ns>` (the `-r` regex form selects zero tests). Do not commit.\\\\n---\\\\ndescription: Core philosophy, foundational axioms, invariants, primitives (tuples, streams, host boundaries), architectural commitments, design principles, code style, and development workflow for datom.world\\\\n---\\\\n\\\\n# DATOM.WORLD ARCHITECTURAL FOUNDATIONS & DEVELOPMENT RULES\\\\n\\\\n## Core Philosophy\\\\n\\\\nEverything is data.\\\\nInterpretation > abstraction.\\\\nExplicit causality > implicit assumptions.\\\\nRestrictions are a feature.\\\\n\\\\n### Foundational Axioms\\\\n\\\\n1. **Everything is a Stream**: All IO and data flow through append-only streams.\\\\n2. **Interpretation Creates Semantics**: Data is syntax; semantics only emerge through interpretation (one truth, many perspectives).\\\\n   At system scale, a \\\\\\\"system\\\\\\\" is an emergent property of interpreters of\\\\n   pure data, not an object, service, or stored artifact. Find the\\\\n   interpreters and the data they share to find the system.\\\\n3. **Code and State are Datoms**: Code (Universal AST) and runtime execution state are structured datoms, enabling syntax independence and structural reflection.\\\\n4. **Everything is a Continuation**: Computation is modeled as serializable, portable continuations that can pause, travel across streams, and resume anywhere.\\\\n\\\\n## Non-Negotiable Invariants\\\\n\\\\n- Do not introduce hidden global state.\\\\n- Do not introduce implicit control flow.\\\\n- Do not introduce callbacks; every callback is an event on a stream.\\\\n- Do not introduce shared mutable state.\\\\n- Do not collapse interpretation and execution into the same layer.\\\\n- Do not assume graphs: graphs must be constructed explicitly from tuples.\\\\n- Do not lose information (unitarity): streams are append-only and no datom is destroyed, only reinterpreted. The Universal AST is never lost: it is always retrievable wherever code is lowered, by address or by a query over its datoms. Every derived form (semantic vector, native images, indexes) is an interpretation of it and may drop facts only because the AST remains.\\\\n\\\\n## Tuples and Datoms\\\\n\\\\nTuples are elements in an open moduli space, graded by dimension $n$. A tuple can be any dimension/size.\\\\nA datom is the canonical persistent tuple `[e a v t m]` (entity, attribute, value, transaction, metadata). Persistent facts are immutable datoms.\\\\nSource scope belongs to the interpreter, never to an appended tuple slot. Queries keep physical sources as separate db-values and express union or joins explicitly.\\\\n\\\\nSee [`docs/design/datom.md`](./datom.md) for full specification.\\\\n\\\\n## Streams\\\\n\\\\nAll IO is modeled as a stream. Functions consume streams and produce streams.\\\\nNo direct function-to-function coupling without a stream boundary.\\\\nSide effects must appear as stream emissions.\\\\nStreams are values that can be sent through streams.\\\\nStreams carry whatever values the consumer needs: no datom requirement, no privileged payload shape.\\\\n\\\\nA stream has no privileged reader, and its meaning is not in it. Any number\\\\nof interpreters may observe the same medium, and each constructs its own\\\\nsemantics from the same batches: a `yin.vm` evaluator observing a program\\\\nstream constructs CESK state and executes it; `dao.space.index` observing\\\\nthe very same stream materializes covered indexes, so `dao.space.query/q`\\\\nanswers Datalog over the program as it grows. Neither knows the other\\\\nexists. The medium is their only coupling, and each observer's ignorance of\\\\nthe other is load-bearing: the evaluator never consults an index to run,\\\\nand the index never evaluates a form to index it. This is how axiom 2\\\\nbecomes architecture: one stream, many interpretations, none of them\\\\nthe stream's own.\\\\n\\\\nFunctions can take anything and return anything.\\\\nAgents are functions, closures, or continuations in `yin.vm` that communicate with the outside world through `dao.stream`. Agent behavior is specified entirely through stream effects.\\\\n\\\\nSee [`docs/design/dao.stream.md`](./dao.stream.md) for full stream specification.\\\\nSee [`docs/design/yin.vm.streams-all-the-way-down.md`](./yin.vm.streams-all-the-way-down.md) for VM architecture.\\\\n\\\\n### Host Boundaries\\\\n\\\\nA host boundary is a stream boundary, never a function call. The one\\\\nsanctioned function-shaped contact is a `dao.stream` handle operation, whose\\\\nexhaustive outcome map is stream protocol, not an application callback.\\\\n\\\\n**Effects out.** Portable code appends an effect value describing what must\\\\nhappen. A host interpreter consumes that stream, performs the operation, and\\\\nappends the outcome. Portable code reads the outcome. Correlation is by\\\\nidentity in the data; neither side holds a reference to the other. A host with\\\\nno implementation for an effect emits a qualified unsupported result. That is a\\\\ncorrect outcome, not a gap to be filled.\\\\n\\\\n**Events in.** When the host initiates (a socket receives, a connection drops,\\\\na timer fires) the adapter appends one plain-data event and returns. It invokes\\\\nnothing. An interpreter reads that stream and decides what the event means.\\\\nConstructively: **a callback is replaced by a function that transforms an event\\\\nto data on a stream.** The host's demand for a callback stops at that function.\\\\n\\\\n**Adapters.** An adapter is a map of those transform functions. That is all an\\\\nadapter is. It is a value, not a namespace, and it is general: sockets, files,\\\\ntimers and windows all deliver events by calling something, and an adapter is\\\\nwhat they call. Each entry takes the host's arguments and returns one value;\\\\nthe append is the adapter's, not the entry's, so an entry cannot return a value\\\\nto the host and cannot invoke application code. The adapter is handed only the\\\\ndeposit operation and its own host resource. If its deposit channel fails, it\\\\nmay close that resource to make the boundary observably gone; this is teardown,\\\\nnot an upward callback.\\\\n\\\\nHost types are classified into plain data in the transform: it is the last\\\\nplace holding a host error object, and no host type crosses onto the stream. A\\\\ntransport may use a qualified envelope to preserve correlation, lifecycle, and\\\\nadditive evolution; that envelope remains plain data and creates no separate\\\\nevent mechanism. A composition may likewise define its own qualified vocabulary\\\\nfor facts it owns.\\\\n\\\\nWhich stream an adapter writes to is the caller's composition, never the\\\\nadapter's knowledge. An adapter cannot tell whether it deposits into one\\\\ntransport's private stream or into a medium many interpreters read. This keeps\\\\nthe layering one-way: a boundary depends on nothing above it, because whoever\\\\nconstructs the adapter supplies the stream.\\\\n\\\\nA transform deposits every event admitted by the boundary protocol and judges\\\\nnone of them semantically. Wire framing, decoding, and protocol validation\\\\nhappen below the transform: malformed wire input is transport machinery, not an\\\\nevent. Once the transport has produced a valid host event, data is syntax\\\\n(axiom 2): an event that is noise to one interpreter is signal to another that\\\\ndoes not exist yet, and filtering at the depositing layer destroys perspectives\\\\nnot yet taken. Retention is the medium's operational policy; meaning is\\\\ninterpretation. Neither is the depositor's decision.\\\\n\\\\nTwo things are not adapters. One that exposes a function for portable code to\\\\ncall isolates the host library but keeps the coupling, and the effect never\\\\nappears as an emission. One that takes a function to invoke has relocated the\\\\ncallback, not removed it, even when every value it passes is plain data; if\\\\nthat callback has a meaningful return value, it is a synchronous call in both\\\\ndirections wearing the shape of an event.\\\\n\\\\n## Architectural Commitments\\\\n\\\\n- **`dao.jing` is syntax, agents are semantics**: the content-addressed encoding stays passive and payload-agnostic.\\\\n- **Macros are stream topology**: an evaluator knows nothing about macro expansion; expansion happens on the syntax side of a medium boundary, upstream of any evaluator.\\\\n- **Peer observers, one stream**: a generic evaluator and `dao.space` independently observe the same stream topic, as described under Streams. This is not a claim about any two consumers regardless of what they consume.\\\\n- **Observers are independent and optional**: nothing requires a medium to have any particular set of consumers. Which observers exist for a stream is a per-composition choice, not a design-time commitment.\\\\n\\\\n## Design Principles\\\\n\\\\nCode quality is measured by malleability: how cheaply can changes adapt without breaking promises?\\\\nStigmergic coordination emerges from sharing data across streams.\\\\n\\\\n**Systems emerge from interpreters of pure data.** Streams are the\\\\ncomposition medium; each interpreter gives the same data a perspective\\\\nwithout collapsing interpretation into execution or owning the truth.\\\\n\\\\n- `dao.space` emerges from `dao.space.index` and `dao.space.query` over\\\\n  ordinary streams.\\\\n- ShiBi capability, metering, and budget emerge from different\\\\n  interpreters over the same tuples; no token object is stored.\\\\n- The four VMs interpret one Universal AST; many syntaxes feed that AST.\\\\n- The semantic AST in `dao.space` is queryable facts projected by the\\\\n  auto-index observer.\\\\n- Client and server are roles in one stigmergic behavior implemented by\\\\n  interpreters, not distinct kinds of nodes.\\\\n\\\\n**Derive, don't persist.** Before adding a tag, slot, or field to any\\\\ncanonical content-hashed structure (an AST grammar, a datom schema, a row\\\\nshape), check whether a correctly scoped Datalog query over\\\\n`dao.space.query/q` can already compute the fact. If it can, it belongs as a\\\\nquery or projection: new persisted structure migrates every downstream\\\\nconsumer and duplicates authority over a fact a query derives fresh. The\\\\nretired `:global` tag in\\\\n[`docs/design/yin.vm.code-as-tuples.md`](./yin.vm.code-as-tuples.md) is the\\\\ncase study, including the scoping bug that a naive query introduced.\\\\n\\\\nSee [`docs/agents/malleability.md`](../agents/malleability.md) for complete design guidance (cohesion, coupling, bounded complexity, evolution, testing strategy).\\\\nSee [`docs/agents/vocabulary.md`](../agents/vocabulary.md) for domain vocabulary reference (biology, economics, physics, philosophy).\\\\n\\\\n## Code Style\\\\n\\\\n- Prefer simple data over rich types.\\\\n- Prefer total functions over partial ones.\\\\n- Prefer declarative pipelines over imperative logic.\\\\n- Avoid cleverness.\\\\n- Name things after what they do to streams.\\\\n\\\\n## Development Workflow\\\\n\\\\n- Do not invent abstractions that hide streams.\\\\n- Do not suggest mainstream frameworks unless explicitly asked.\\\\n- Do not optimize prematurely.\\\\n- When uncertain, ask at the architectural level, not the implementation level.\\\\n- Explanations should align with Plan 9 / Datomic / Lisp lineage.\\\\n- Program store writes go through `engine/store-put`; any other store write\\\\n  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\\\\n  detects must be on its allowlist; its docstring states the residual it\\\\n  leaves to review.\\\\n\\\\n### Problem Decomposition\\\\n\\\\nIf a problem appears complex:\\\\n1. Decompose it into streams.\\\\n2. Identify invariants.\\\\n3. Restrict degrees of freedom.\\\\n4. Make causality explicit.\\\\n5. Let structure emerge from constraints.\\\\n\\\\n## Operational & Specialized Guides\\\\n\\\\n- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\\\\n- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\\\\n- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\\\\n- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; the orchestrator's append-only work log is [`docs/orchestrator-log.md`](../orchestrator-log.md).\\\\n- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_2\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"git status --short; git diff --stat; rg -n ':free-env|:window W :env E' src/cljc/yin/vm/semantic_register.cljc; rg --files collab | rg '1792195000000|free-env-seam'; cat docs/agents/build-n-test.md\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_2\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"git status --short; git diff --stat; rg -n ':free-env|:window W :env E' src/cljc/yin/vm/semantic_register.cljc; rg --files collab | rg '1792195000000|free-env-seam'; cat docs/agents/build-n-test.md\\\\\\\"\\\",\\\"aggregated_output\\\":\\\" M src/cljc/yin/vm/semantic_register.cljc\\\\n M test/yin/vm/semantic_register/vm_test.cljc\\\\n?? collab/1792195000000-engineer-free-env-seam.gpt-6.1-sol.stdout.log\\\\n?? collab/1792195000000-engineer-free-env-seam.gpt-6.1-sol.stdout2.log\\\\n?? collab/1792195000000-engineer-free-env-seam.prompt.md\\\\n?? collab/1792195000000-engineer-free-env-seam.resume.prompt.md\\\\n src/cljc/yin/vm/semantic_register.cljc     |  4 +++-\\\\n test/yin/vm/semantic_register/vm_test.cljc | 27 +++++++++++++++++++++++++++\\\\n 2 files changed, 30 insertions(+), 1 deletion(-)\\\\n54:         :window W :env E :k (when (seq K) K)\\\\n394:                                  :free-env env,\\\\n489:     :values [(:free-env machine) (:env machine) (:window machine) (:value machine)]})\\\\ncollab/1792195000000-engineer-free-env-seam.gpt-6.1-sol.stdout2.log\\\\ncollab/1792195000000-engineer-free-env-seam.gpt-6.1-sol.stdout.log\\\\ncollab/1792195000000-engineer-free-env-seam.resume.prompt.md\\\\ncollab/1792195000000-engineer-free-env-seam.prompt.md\\\\n---\\\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\\\n---\\\\n\\\\n# BUILD & TEST\\\\n\\\\n## Commands\\\\n\\\\n```sh\\\\n# Tests (Babashka runner)\\\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\\\nbb test:slow         # Only the slow tests, on every lane\\\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\\\n# (dao.test-slow/guard \\\\\\\"name\\\\\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\\\n# under test/), so the non-slow tests inside those namespaces also run there.\\\\n# On Node, shadow also runs the test namespaces those nine require (about\\\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\\\n# not subsystems). On the many-core remote hosts see \\\\\\\"Remote test servers\\\\\\\" below for\\\\n# which lanes may overlap.\\\\n#\\\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\\\n# (or `clojure -M:test -i :slow -n <ns>`).\\\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\\\n# Full repo-wide `bb test` (G3) is the mandatory landing gate on master after merge.\\\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\\\n# overlap lanes, see \\\\\\\"Remote test servers\\\\\\\" below).\\\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\\\nnpm test             # Node.js tests\\\\n\\\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\\\n                         # and the linker L5 Node reader that requires a module\\\\n                         # by name): `clojure -M:test` without it fails that test\\\\n```\\\\n\\\\n### Changed-only tests: `bb test:changed`\\\\n\\\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\\\nreach: the reverse require closure of the files changed since the\\\\nmerge-base with master, plus fixtures that mention a changed resource path,\\\\ntests that walk a changed tree, and each src file's `_test` by convention.\\\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\\\n(let-bound roots count), and a change under a root selects it. The three\\\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\\\nas for a change to the core everything requires (yin.vm engine,\\\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\\\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\\\\nand spawned programs that changed (target/yin-repl.js, Dart peers).\\\\n\\\\n### Subsystem-first tests: `bb test:sub`\\\\n\\\\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\\\\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\\\\nis by longest namespace prefix matching.\\\\n\\\\n```sh\\\\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\\\\nbb test:sub:clj <subsystem>...    # JVM lane alone\\\\nbb test:sub:cljs <subsystem>...   # Node lane alone\\\\nbb test:sub:cljd <subsystem>...   # Dart lane alone\\\\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\\\\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\\\\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\\\\n```\\\\n\\\\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\\\\n\\\\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\\\\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\\\\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\\\\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\\\\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\\\\n- **Infrastructure**: `dev`, `bench`\\\\n\\\\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:python-antlr`)\\\\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\\\\nselected namespaces and run automatically when needed.\\\\n\\\\n#### Gate Ladder (docs/design/test.subsystems.md)\\\\n\\\\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\\\\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\\\\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\\\\n4. **G3 Master**: The mandatory landing gate on master after merge, and for any wide change (`bb test`).\\\\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge (`bb test:slow` or `bb test:all`), and at each phase boundary of a multi-phase track (owner decision 2026-10-12; see \\\\\\\"Test tiers: quick and slow\\\\\\\" below). G0 to G3 run the quick tier; G4 runs the slow tier.\\\\n\\\\n\\\\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\\\\nslice L5) is two tests:\\\\n\\\\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\\\\n  processes over real loopback UDP. A JVM publisher with a key file\\\\n  publishes modules by name, and JVM and Node readers require them by\\\\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\\\\n  and checks each section 9 failure as data. Ports are ephemeral, and\\\\n  every wait is bounded. A run takes a few minutes. Run it alone with\\\\n  `clojure -M:test -n yin.repl.dht-process-test`, after\\\\n  `bb build:yin-repl-node`.\\\\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\\\\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\\\\n  signed-name leg runs here, because no Dart `yin.repl.main` process\\\\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\\\\n  REPL.\\\\n\\\\n```sh\\\\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\\\\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\\\\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\\\\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\\\\n\\\\n# ClojureDart\\\\nclj -M:clojuredart:cljd compile\\\\n\\\\n# Linting\\\\nclj -M:kondo --lint <path>\\\\n```\\\\n\\\\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\\\\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\\\\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\\\\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\\\\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\\\\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\\\\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\\\\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\\\\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\\\\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\\\\n(greedy by file size; each imports its files and calls their `main`), runs\\\\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\\\\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\\\\ndifferent namespaces share an isolate per shard. Failures stay attributable:\\\\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\\\\n\\\\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\\\\ncompile does not prune it when a source file is deleted or renamed. The\\\\naggregated lanes only run namespaces that still exist under `test/`, but a\\\\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\\\\nbefore relying on that to prove a deletion or rename took effect.\\\\n\\\\n## Test tiers: quick and slow\\\\n\\\\nThe suite has two tiers so that slow tests run less often than quick ones\\\\n(owner decision, 2026-10-12).\\\\n\\\\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\\\\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\\\\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\\\\n- **Slow tier:** the tagged deftests. `bb test:slow` or\\\\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\\\\n- **The tagging rule** is the one above (\\\\\\\"When to tag a test slow\\\\\\\"): a deftest that\\\\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\\\\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\\\\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\\\\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\\\\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\\\\n  in all (some were already tagged). Per-test times are not in the repo: measure again\\\\n  with the method below before changing the cut.\\\\n- **Cadence:** the quick tier at every checkpoint (G1) and landing (G2, G3); the slow\\\\n  tier before merging a big change and at each phase boundary of a multi-phase track\\\\n  (the existing G4). There is no nightly run.\\\\n\\\\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \\\\\\\"Remote test\\\\nservers\\\\\\\" for how to run them):\\\\n\\\\n| Run | Time |\\\\n|---|---|\\\\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\\\\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\\\\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\\\\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\\\\n\\\\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\\\\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\\\\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\\\\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\\\\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\\\\n\\\\n**How the per-test times were measured.** To time every deftest of a namespace alone,\\\\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\\\\notherwise swallows `-e`, and every JVM runs the whole suite):\\\\n\\\\n```sh\\\\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\\\\\\\"test\\\\\\\"]}}}' -M:t timing.clj\\\\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\\\\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\\\\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\\\\n# load) is paid by the first test in file order; check before tagging that test alone.\\\\n```\\\\n\\\\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\\\\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\\\\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\\\\nJVM test namespace under `test/`:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nPAR=\\\\\\\"${2:-8}\\\\\\\"\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nOUT=\\\\\\\"$1/target-ci/shards\\\\\\\"; rm -rf \\\\\\\"$OUT\\\\\\\"; mkdir -p \\\\\\\"$OUT\\\\\\\"\\\\nts() { date +%H:%M:%S; }\\\\necho \\\\\\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\\\\\" | tee \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nnpm ci --silent >\\\\\\\"$OUT/npm.log\\\\\\\" 2>&1                   && echo \\\\\\\"npm ok $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nbb build:yin-repl-node >\\\\\\\"$OUT/build-node.log\\\\\\\" 2>&1     && echo \\\\\\\"node repl built $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nbb gen:python-antlr >\\\\\\\"$OUT/antlr.log\\\\\\\" 2>&1             && echo \\\\\\\"antlr ok $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nSUBS=\\\\\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\\\\\"\\\\n: > \\\\\\\"$OUT/covered.txt\\\\\\\"\\\\nfor s in $SUBS; do\\\\n  bb test:sub:list \\\\\\\"$s\\\\\\\" 2>/dev/null | awk \\\\\\\"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");print}\\\\\\\" > \\\\\\\"$OUT/ns-$s.txt\\\\\\\"\\\\n  cat \\\\\\\"$OUT/ns-$s.txt\\\\\\\" >> \\\\\\\"$OUT/covered.txt\\\\\\\"\\\\n  echo \\\\\\\"$s $(wc -l < \\\\\\\"$OUT/ns-$s.txt\\\\\\\")\\\\\\\" >> \\\\\\\"$OUT/plan.txt\\\\\\\"\\\\ndone\\\\n# coverage: every JVM test namespace under test/ vs the union of the shards\\\\nfind test -type f \\\\\\\\( -name \\\\\\\"*_test.clj\\\\\\\" -o -name \\\\\\\"*_test.cljc\\\\\\\" \\\\\\\\) | sed -e \\\\\\\"s#^test/##\\\\\\\" -e \\\\\\\"s#\\\\\\\\.cljc\\\\\\\\?\\\\\\\\$##\\\\\\\" -e \\\\\\\"s#/#.#g\\\\\\\" -e \\\\\\\"s#_#-#g\\\\\\\" | sort -u > \\\\\\\"$OUT/all.txt\\\\\\\"\\\\nsort -u \\\\\\\"$OUT/covered.txt\\\\\\\" > \\\\\\\"$OUT/covered.sorted\\\\\\\"\\\\ncomm -23 \\\\\\\"$OUT/all.txt\\\\\\\" \\\\\\\"$OUT/covered.sorted\\\\\\\" > \\\\\\\"$OUT/ns-uncovered.txt\\\\\\\"\\\\necho \\\\\\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nrun_shard() {\\\\n  s=$1; f=\\\\\\\"$OUT/ns-$s.txt\\\\\\\"; [ -s \\\\\\\"$f\\\\\\\" ] || return 0\\\\n  args=(); while read -r n; do args+=(-n \\\\\\\"$n\\\\\\\"); done < \\\\\\\"$f\\\\\\\"\\\\n  t0=$(date +%s); clojure -M:test -e :slow \\\\\\\"${args[@]}\\\\\\\" >\\\\\\\"$OUT/$s.log\\\\\\\" 2>&1; rc=$?\\\\n  echo \\\\\\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\\\\\"^Ran \\\\\\\" \\\\\\\"$OUT/$s.log\\\\\\\" | tail -1)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n}\\\\nexport -f run_shard; export OUT; export -f ts\\\\nprintf \\\\\\\"%s\\\\\\\\n\\\\\\\" $SUBS uncovered | xargs -P \\\\\\\"$PAR\\\\\\\" -I{} bash -c \\\\\\\"run_shard {}\\\\\\\"\\\\necho \\\\\\\"done $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nPAR=\\\\\\\"${2:-6}\\\\\\\"\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nOUT=\\\\\\\"$1/target-ci/slowtier\\\\\\\"; rm -rf \\\\\\\"$OUT\\\\\\\"; mkdir -p \\\\\\\"$OUT\\\\\\\"\\\\nrun_ns() {\\\\n  n=$1; t0=$(date +%s)\\\\n  clojure -M:test -i :slow -n \\\\\\\"$n\\\\\\\" > \\\\\\\"$OUT/$n.log\\\\\\\" 2>&1; rc=$?\\\\n  echo \\\\\\\"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \\\\\\\"^Ran \\\\\\\" \\\\\\\"$OUT/$n.log\\\\\\\" | tail -1)\\\\\\\" >> \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n}\\\\nexport -f run_ns; export OUT\\\\necho \\\\\\\"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\\\\\\\" > \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nxargs -P \\\\\\\"$PAR\\\\\\\" -I{} bash -c \\\\\\\"run_ns {}\\\\\\\" < \\\\\\\"$HOME/ci/pertest-ns.txt\\\\\\\"\\\\necho \\\\\\\"done $(date +%H:%M:%S)\\\\\\\" >> \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n## Remote test servers: shiva and jupiter\\\\n\\\\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\\\\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\\\\nand `git`.\\\\n\\\\n| Host | Cores / RAM | Toolchain state (checked 2026-10-11) |\\\\n|---|---|---|\\\\n| `shiva.stigmergy.systems` | 24 / 62 GB | Complete: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1-stable. All three lanes run. |\\\\n| `jupiter.stigmergy.systems` | 48 / 62 GB | java 21, clojure, node, zprint; babashka installed with `mise install babashka@latest`; flutter 3.41.9 is NOT the pinned version. Run the JVM and Node lanes here, not Dart. |\\\\n\\\\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\\\\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\\\\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\\\\n\\\\n### Get the code there: push to origin, never rsync\\\\n\\\\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\\\\nwould take about an hour), and an unanchored `--exclude build` also dropped source\\\\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\\\\nbranch from the laptop (a feature branch, never master), make one scratch clone on\\\\nthe host from its existing checkout (a local clone takes seconds), and fetch:\\\\n\\\\n```sh\\\\n# once per host: a separate scratch clone, not the working copy\\\\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\\\\n  URL=$(git remote get-url origin);\\\\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\\\\n  cd ~/ci/datomworld-<name>; git remote set-url origin \\\\\\\"$URL\\\\\\\";\\\\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\\\\n```\\\\n\\\\nTo test another branch later, fetch and check it out in the scratch clone with\\\\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\\\\nwas never pushed cannot be tested remotely.\\\\n\\\\n### Activate the toolchain in the right order\\\\n\\\\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\\\\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\\\\ninto the clone:\\\\n\\\\n```sh\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\\\\ncd ~/ci/datomworld-<name>\\\\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"                       # puts the repo-pinned tools on PATH\\\\n```\\\\n\\\\nActivating mise before the `cd` and `mise trust` leaves the repo-pinned tools\\\\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \\\\\\\"Can't\\\\nfind flutter on PATH\\\\\\\", and so does `bb build:yin-repl-peer`.\\\\n\\\\n### Which lanes may overlap (reconciling the one-lane-set rule)\\\\n\\\\n\\\\\\\"One lane set at a time\\\\\\\" and \\\\\\\"one Dart lane at a time\\\\\\\" are per-machine rules about\\\\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\\\\n`test.subsystems.md` section 5 item 6 says the same (\\\\\\\"on one machine where\\\\navoidable\\\\\\\"). On shiva (24 cores) and jupiter (48) the cores are not the limit, so\\\\nlanes may overlap, with these limits:\\\\n\\\\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\\\\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\\\\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\\\\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\\\\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\\\\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\\\\n  by the design's own reasoning (\\\\\\\"each worktree owns its own `cljd-out`\\\\\\\"), not yet\\\\n  verified by a measured run.\\\\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\\\\n  JVM lane only reads `target/yin-repl.js`.\\\\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\\\\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\\\\n- **Different branches in different clones** are independent, so two branches may\\\\n  run on one host if its cores and RAM allow (62 GB each).\\\\n- Do not treat this as permission to overlap lanes on the laptop.\\\\n\\\\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\\\\nthis rule was written down; its results are advisory until repeated with a\\\\nseparate Dart clone.\\\\n\\\\n### The full run\\\\n\\\\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\\\\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\\\\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\\\\ntasks use (the `bb test` task runs them one after another), and records each\\\\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\\\\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (omit the second on jupiter: no Dart)\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\nDART=\\\\\\\"${2:-}\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nLOG=\\\\\\\"$1/target-ci\\\\\\\"; mkdir -p \\\\\\\"$LOG\\\\\\\"\\\\nts() { date +%H:%M:%S; }\\\\necho \\\\\\\"start $(ts) $(git rev-parse --short HEAD)\\\\\\\" | tee \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nnpm ci --silent >\\\\\\\"$LOG/npm.log\\\\\\\" 2>&1               && echo \\\\\\\"npm ok $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb build:yin-repl-node >\\\\\\\"$LOG/build-node.log\\\\\\\" 2>&1 && echo \\\\\\\"node repl built $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb gen:python-antlr >\\\\\\\"$LOG/antlr.log\\\\\\\" 2>&1         && echo \\\\\\\"antlr ok $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb build:yin-repl-peer >\\\\\\\"$LOG/build-peer.log\\\\\\\" 2>&1 && echo \\\\\\\"dart peer built $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"  # shiva only\\\\nlane() { name=$1; shift; s=$(date +%s); \\\\\\\"$@\\\\\\\" >\\\\\\\"$LOG/$name.log\\\\\\\" 2>&1; rc=$?\\\\n         echo \\\\\\\"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"; }\\\\nlane jvm  clojure -M:test -e :slow &\\\\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\\\\nif [ -n \\\\\\\"$DART\\\\\\\" ]; then                            # shiva only: its own clone (own lib/cljd-out, build/)\\\\n  ( cd \\\\\\\"$DART\\\\\\\" && mise trust >/dev/null 2>&1 && eval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\n    bb build:yin-repl-peer >\\\\\\\"$LOG/build-peer-dart.log\\\\\\\" 2>&1\\\\n    lane dart bb src/dev/cljd_agg.clj ) &\\\\nfi\\\\nwait\\\\necho \\\\\\\"done $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n```sh\\\\nssh <host> 'tmux new-session -d -s ci-full \\\\\\\"bash -lc \\\\\\\\\\\\\\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\\\\\\\\\\\\\"\\\\\\\"'\\\\n```\\\\n\\\\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\\\\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\\\\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\\\\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\\\n... 10066508 bytes omitted ...\nnted text)\\n        symbolic (counted text)\\n        literal (counted text)\\n        nodes (counted\\n                (fn []\\n                  (case (u8)\\n                    0 (let [rule (u32) kids (u32) has-start (u8) start (i32)]\\n                        {:kind :rule, :rule rule, :child-count kids,\\n                         :start (when (= 1 has-start) start)})\\n                    1 {:kind :token, :type (i32), :start (i32), :stop (i32),\\n                       :index (i32), :text (text)}\\n                    (refuse \\\"bad record kind\\\" {:at @pos}))))\\n        errors (counted\\n                 (fn []\\n                   {:line (u32), :column (u32), :message (text),\\n                    :span-kind (u8), :a (i32), :b (i32)}))\\n        failure {:kind (u8), :no-viable (u8), :index (i32), :buffered (u32)}\\n        tokens (counted (fn [] {:type (i32), :index (i32), :start (i32),\\n                                :stop (i32)}))]\\n    (when-not (= @pos length)\\n      (refuse \\\"trailing bytes\\\" {:consumed @pos, :length length}))\\n    (when-not (= status (if (seq errors) 1 0))\\n      (refuse \\\"status disagrees with the errors\\\" {:status status}))\\n    {:rules rules, :symbolic symbolic, :literal literal, :nodes nodes,\\n     :errors errors, :failure failure, :tokens tokens}))\\n\\n\\n(defn- children-of\\n  \\\"Each preorder record's child ids, checked: one root whose subtree is every\\n   record, rule indexes inside the table.\\\"\\n  [{:keys [nodes rules]}]\\n  (let [n (count nodes)\\n        out (transient (vec (repeat n [])))\\n        next-id (volatile! 0)]\\n    (letfn [(walk\\n              []\\n              (let [id @next-id]\\n                (when (>= id n) (refuse \\\"child count overruns the records\\\" {}))\\n                (vswap! next-id inc)\\n                (let [{:keys [kind rule child-count]} (nth nodes id)]\\n                  (when (= :rule kind)\\n                    (when-not (< -1 rule (count rules))\\n                      (refuse \\\"rule index outside the table\\\" {:rule rule}))\\n                    (assoc! out id (vec (repeatedly child-count walk)))))\\n                id))]\\n      (when (pos? n) (walk))\\n      (when-not (= @next-id n)\\n        (refuse \\\"records outside the root's subtree\\\" {:walked @next-id, :n n}))\\n      (persistent! out))))\\n\\n\\n(defn- type-name\\n  [{:keys [symbolic literal]} t]\\n  (let [pick (fn [names] (let [s (when (< -1 t (count names)) (names t))]\\n                           (when (seq s) s)))]\\n    (if (= -1 t) \\\"EOF\\\" (or (pick symbolic) (pick literal) (str t)))))\\n\\n\\n(defn export-records\\n  \\\"Parse UTF-8 `source` natively and answer the checked records. Host-only\\n   (the probe harness reads the raw first-failure evidence through it); a\\n   wrapper failure status throws, so a failed parse never yields a packet.\\\"\\n  [source]\\n  (let [[status bs] (call-export (.getBytes ^String source \\\"UTF-8\\\"))]\\n    (when-not (zero? status)\\n      (throw (ex-info \\\"jolt parser failed\\\"\\n                      {:status status,\\n                       :message (when (pos? (alength ^bytes bs))\\n                                  (String. ^bytes bs \\\"UTF-8\\\"))})))\\n    (let [records (decode bs)]\\n      (assoc records :children (children-of records)))))\\n\\n\\n(defn- ops\\n  [{:keys [nodes rules children], :as records}]\\n  {:token? (fn [i] (= :token (:kind (nth nodes i)))),\\n   :token (fn [i]\\n            (let [{:keys [type start stop text]} (nth nodes i)]\\n              {:type-name (type-name records type),\\n               :start start,\\n               :stop stop,\\n               :text text})),\\n   :rule-name (fn [i] (rules (:rule (nth nodes i)))),\\n   :children (fn [i] (children i)),\\n   :start (fn [i] (:start (nth nodes i)))})\\n\\n\\n;; =============================================================================\\n;; The host surface\\n;; =============================================================================\\n\\n(defn make-worker\\n  \\\"A host worker for `profile`. Round 2: the profile only; the worker-owned\\n   native caches of §7.4 are later J0c work.\\\"\\n  [profile]\\n  {:profile profile})\\n\\n\\n(defn- error-record\\n  [offsets {:keys [line column message span-kind a b]}]\\n  (export/syntax-error message line column\\n                       (case span-kind\\n                         1 (export/token-span offsets a b)\\n                         2 [(export/offset-at offsets a)\\n                            (export/offset-at offsets b)]\\n                         nil)))\\n\\n\\n(defn parse-unit\\n  \\\"Parse one sealed unit's `source` with `worker`; return its CST packet.\\\"\\n  [worker unit source]\\n  (let [cps (packet/code-points source)\\n        offsets (export/byte-offsets cps)\\n        records (export-records source)]\\n    (export/result (:profile worker) unit\\n                   (mapv #(error-record offsets %) (:errors records))\\n                   #(export/export-nodes (ops records) cps offsets 0))))\\n\\n\\n(defn parse-transform\\n  \\\"The parser stage's transform over source events (`packet/transform`).\\\"\\n  [worker]\\n  (packet/transform parse-unit worker))\\n\\n\\n(defn utf8-bytes\\n  \\\"The UTF-8 byte count of a string: span ends are checked against it.\\\"\\n  [s]\\n  (packet/utf8-bytes s))\\n\\n\\n(defn first-failure\\n  \\\"Where the grammar first refuses `source`: nil when it parses, `:end` when\\n   the first error failed on an end-of-input token, else `:early`\\n   (`export/failure-kind` decides).\\n\\n   The failing token follows the JVM rule: the offending token of a\\n   mismatch, and for a no-viable-alternative error the last token buffered\\n   when it was reported, since the C++ runtime's BufferedTokenStream fills\\n   lazily as the Java one does (observed against the JVM oracle in J0c round\\n   2, not assumed). A lexer error has no token.\\\"\\n  [_worker source]\\n  (let [{:keys [failure tokens]} (export-records source)\\n        {:keys [kind no-viable index buffered]} failure]\\n    (export/failure-kind\\n      (case kind\\n        0 nil\\n        1 :lexical\\n        2 (if (= 1 no-viable) (dec buffered) index))\\n      (keep (fn [{:keys [type index start stop]}]\\n              (when (not= -1 type)\\n                {:index index, :start start, :stop stop}))\\n            tokens))))\\n\\n\"}]}],\"meta\":{\"source\":\"tool\",\"messageId\":\"65c519c5-a51c-48d0-acca-bc5a06620edd\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"Next up: parity scripts, native cpp diffs, corpus, manifest digest verification. Also a light check on src/jolt/README.md. Things to read: jolt_j0c_parity.clj, jolt_parser.cpp (the new export portion), the top of the corpus fixture, grep for the cpp digest in the manifest.\",\"signature\":\"\"},{\"type\":\"text\",\"text\":\"Now the parity harness, the new native export entry, the corpus, and the manifest digests.\\n\\n\"},{\"type\":\"tool_use\",\"id\":\"call_77ab950368a244fa98dd0e1b\",\"name\":\"read_file\",\"input\":{\"file_path\":\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/src/dev/jolt_j0c_parity.clj\"}},{\"type\":\"tool_use\",\"id\":\"call_fe921e406a46481b9b19e3f5\",\"name\":\"grep\",\"input\":{\"pattern\":\"a8be1b51|a1cb6339|65027edf|8548fd2c|d30cc4df|5e62a9c3|38a2790b|59afaba9\",\"path\":\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn\",\"output_mode\":\"content\",\"-n\":true}}],\"meta\":{\"source\":\"model\",\"createdAt\":1792491188072,\"messageId\":\"495f3eac-847a-4b4e-b576-46c6c627ba2a\"}},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"call_77ab950368a244fa98dd0e1b\",\"content\":[{\"type\":\"text\",\"text\":\"Read 1/1 file, 218 lines\\n1: ;; J0c round 2, step C: the jolt yang.antlr.cst adapter against the JVM oracle\\n2: ;; (docs/design/yin.repl-jolt-implementation.md §7.8).\\n3: ;;\\n4: ;;   . build/tools/jolt-env.sh\\n5: ;;   \\\"$JOLT_HOME\\\"/bin/jolt -Srepro \\\\\\n6: ;;     -Sdeps '{:aliases {:j0c-probe-stub {:extra-paths [\\\"src/dev/jolt-j0c-probe-stub\\\"]}}}' \\\\\\n7: ;;     -M:jolt:j0c-probe-stub src/dev/jolt_j0c_parity.clj\\n8: ;;\\n9: ;; For every jolt_j0c_corpus.edn entry: the packet from the jolt adapter\\n10: ;; (src/jolt/yang/antlr/cst.jolt, the ANTLR4 C++ parser marshalled into the\\n11: ;; shared yang.antlr.export) must equal the JVM oracle's packet, and its\\n12: ;; cst/first-failure the oracle's. For every probe text,\\n13: ;; yang.python.antlr.repl-probe/probe runs under jolt and must answer as on the\\n14: ;; JVM, making the same cst/first-failure calls with the same results.\\n15: ;;\\n16: ;; repl-probe requires yang.python.antlr.parser, whose :clj branch imports the\\n17: ;; generated Java recognizers; the command above therefore puts a stand-in\\n18: ;; yang.python.antlr.parser (src/dev/jolt-j0c-probe-stub, holding only\\n19: ;; `make-worker`, the probe's one use of it, and the grammar id) on a root\\n20: ;; before the :jolt roots. The probe's own code is the tracked source.\\n21: ;;\\n22: ;; Prints PASS/DIVERGES per entry with a minimal diff, RECORD lines for the\\n23: ;; observations, and exits nonzero on any divergence or failure.\\n24: (ns jolt-j0c-parity\\n25:   (:require\\n26:     [clojure.edn :as edn]\\n27:     [jolt.ffi :as ffi]))\\n28: \\n29: \\n30: (def ^:private before (set (loaded-libs)))\\n31: (require '[yang.antlr.cst :as cst] '[yang.antlr.export :as export])\\n32: (def ^:private added (sort (remove before (loaded-libs))))\\n33: \\n34: (def corpus-path \\\"test/yang/python/antlr/fixtures/jolt_j0c_corpus.edn\\\")\\n35: (def oracle-path \\\"test/yang/python/antlr/fixtures/jolt_j0c_oracle.edn\\\")\\n36: \\n37: (def diverged (atom []))\\n38: (def failed (atom 0))\\n39: \\n40: \\n41: (defn- check\\n42:   [label ok? detail]\\n43:   (when-not ok? (swap! failed inc))\\n44:   (println (if ok? \\\"PASS\\\" \\\"FAIL\\\") label (pr-str detail)))\\n45: \\n46: \\n47: (check \\\"yang.antlr.cst resolves to the jolt adapter (export-records exists) and loads only export/packet beside it\\\"\\n48:        (and (some? (resolve 'yang.antlr.cst/export-records))\\n49:             (= '(yang.antlr.cst yang.antlr.export yang.antlr.packet) added))\\n50:        added)\\n51: \\n52: \\n53: ;; The grammar id the JVM profile carries, read from its one definition.\\n54: (def grammar-id\\n55:   (let [src (slurp \\\"src/cljc/yang/python/antlr/parser.cljc\\\")\\n56:         [_ s] (re-find #\\\"\\\\(def grammar-id\\\\s+\\\\\\\"[^\\\\\\\"]*\\\\\\\"\\\\s+(\\\\\\\"[^\\\\\\\"]*\\\\\\\")\\\\)\\\" src)]\\n57:     (edn/read-string s)))\\n58: \\n59: \\n60: (def profile {:grammar-id grammar-id})\\n61: (def corpus (edn/read-string (slurp corpus-path)))\\n62: (def oracle (edn/read-string (slurp oracle-path)))\\n63: \\n64: \\n65: (check \\\"oracle is the JVM's, for this grammar id, and covers the corpus in order\\\"\\n66:        (and (= :jvm (:host oracle))\\n67:             (= grammar-id (:grammar-id oracle))\\n68:             (= (mapv (juxt :id :source) (:entries corpus))\\n69:                (mapv (juxt :id :source) (:entries oracle)))\\n70:             (= (:probe corpus) (mapv :text (:probe oracle))))\\n71:        {:host (:host oracle), :grammar-id grammar-id})\\n72: \\n73: \\n74: ;; -- minimal diffs -------------------------------------------------------------\\n75: \\n76: (defn- map-diff\\n77:   [a b]\\n78:   (into {}\\n79:         (keep (fn [k]\\n80:                 (when (not= (get a k) (get b k))\\n81:                   [k {:jvm (get a k), :jolt (get b k)}])))\\n82:         (distinct (concat (keys a) (keys b)))))\\n83: \\n84: \\n85: (defn- seq-diff\\n86:   \\\"Index-wise differences of two record vectors, at most `limit` of them.\\\"\\n87:   [xs ys limit]\\n88:   (let [n (max (count xs) (count ys))]\\n89:     (->> (range n)\\n90:          (keep (fn [i]\\n91:                  (let [x (get xs i) y (get ys i)]\\n92:                    (when (not= x y)\\n93:                      [i (if (and (map? x) (map? y)) (map-diff x y) {:jvm x, :jolt y})]))))\\n94:          (take limit)\\n95:          vec)))\\n96: \\n97: \\n98: (defn- packet-diff\\n99:   [jvm jolt]\\n100:   (let [top (dissoc (map-diff (dissoc jvm :yang.cst/nodes :yang.cst/errors)\\n101:                               (dissoc jolt :yang.cst/nodes :yang.cst/errors)))]\\n102:     (cond-> {}\\n103:       (seq top) (assoc :fields top)\\n104:       (not= (:yang.cst/nodes jvm) (:yang.cst/nodes jolt))\\n105:       (assoc :nodes {:count [(count (:yang.cst/nodes jvm)) (count (:yang.cst/nodes jolt))],\\n106:                      :first (seq-diff (vec (:yang.cst/nodes jvm))\\n107:                                       (vec (:yang.cst/nodes jolt)) 4)})\\n108:       (not= (:yang.cst/errors jvm) (:yang.cst/errors jolt))\\n109:       (assoc :errors (seq-diff (vec (:yang.cst/errors jvm))\\n110:                                (vec (:yang.cst/errors jolt)) 8)))))\\n111: \\n112: \\n113: ;; -- the corpus ----------------------------------------------------------------\\n114: \\n115: (defn- alternative-failure\\n116:   \\\"The JS/Dart rule (the listener's offending token even for no-viable-alt),\\n117:    as an observation of the C++ token buffer.\\\"\\n118:   [source]\\n119:   (let [{:keys [failure tokens]} (cst/export-records source)\\n120:         {:keys [kind index]} failure]\\n121:     (export/failure-kind\\n122:       (case kind 0 nil 1 :lexical 2 index)\\n123:       (keep (fn [{:keys [type index start stop]}]\\n124:               (when (not= -1 type) {:index index, :start start, :stop stop}))\\n125:             tokens))))\\n126: \\n127: \\n128: (def results (atom []))\\n129: \\n130: \\n131: (doseq [{:keys [id source packet first-failure]} (:entries oracle)]\\n132:   (let [worker (cst/make-worker profile)\\n133:         jolt-packet (try (cst/parse-unit worker [:unit 0] source)\\n134:                          (catch Throwable e {:thrown (ex-message e), :data (ex-data e)}))\\n135:         jolt-ff (try (cst/first-failure worker source)\\n136:                      (catch Throwable e {:thrown (ex-message e)}))\\n137:         records (cst/export-records source)\\n138:         packet-ok (= packet jolt-packet)\\n139:         ff-ok (= first-failure jolt-ff)\\n140:         alt (alternative-failure source)]\\n141:     (swap! results conj {:id id, :packet packet-ok, :first-failure ff-ok})\\n142:     (when-not (and packet-ok ff-ok) (swap! diverged conj id))\\n143:     (println (if (and packet-ok ff-ok) \\\"PASS\\\" \\\"DIVERGES\\\") id\\n144:              (pr-str (cond-> {:outcome (:yang.cst/outcome packet),\\n145:                               :nodes (count (:yang.cst/nodes packet)),\\n146:                               :first-failure first-failure}\\n147:                        (not packet-ok) (assoc :packet-diff (if (:thrown jolt-packet)\\n148:                                                              jolt-packet\\n149:                                                              (packet-diff packet jolt-packet)))\\n150:                        (not ff-ok) (assoc :jolt-first-failure jolt-ff))))\\n151:     (println \\\"RECORD token-buffer\\\" id\\n152:              (pr-str {:first-error (:failure records),\\n153:                       :buffered-after (count (:tokens records)),\\n154:                       :offending-token-rule alt,\\n155:                       :rules-agree (= alt jolt-ff)}))))\\n156: \\n157: \\n158: ;; -- a failed native parse never yields a packet --------------------------------\\n159: \\n160: (ffi/defcfn c-inject-fault \\\"jolt_parser_inject_fault\\\" [:int] :int)\\n161: \\n162: \\n163: (doseq [mode [1 2 3]]\\n164:   (c-inject-fault mode)\\n165:   (let [r (try (cst/parse-unit (cst/make-worker profile) [:unit 0] \\\"1 + 2\\\\n\\\")\\n166:                (catch Throwable e {:thrown (ex-data e)})\\n167:                (finally (c-inject-fault 0)))]\\n168:     (check (str \\\"[injected mode \\\" mode \\\"] parse-unit throws the wrapper status, no packet\\\")\\n169:            (and (contains? r :thrown) (#{-2 -3} (get-in r [:thrown :status])))\\n170:            r)))\\n171: \\n172: \\n173: (check \\\"after the injected failures parse-unit answers the oracle packet again\\\"\\n174:        (= (:packet (first (:entries oracle)))\\n175:           (cst/parse-unit (cst/make-worker profile) [:unit 0]\\n176:                           (:source (first (:entries oracle)))))\\n177:        (:id (first (:entries oracle))))\\n178: \\n179: \\n180: ;; -- the completeness probe ----------------------------------------------------\\n181: \\n182: (require '[yang.python.antlr.repl-probe :as probe])\\n183: \\n184: \\n185: (check \\\"repl-probe's parser is the stand-in (no rule-names: the tracked parser.cljc did not load) with the same grammar id\\\"\\n186:        (and (nil? (resolve 'yang.python.antlr.parser/rule-names))\\n187:             (= grammar-id @(resolve 'yang.python.antlr.parser/grammar-id)))\\n188:        @(resolve 'yang.python.antlr.parser/grammar-id))\\n189: \\n190: \\n191: (doseq [{:keys [text first-failure-calls], answer :probe} (:probe oracle)]\\n192:   (let [calls (volatile! [])\\n193:         ff cst/first-failure\\n194:         jolt-answer (with-redefs [cst/first-failure\\n195:                                   (fn [w s] (let [r (ff w s)] (vswap! calls conj [s r]) r))]\\n196:                       (probe/probe text))\\n197:         ok (and (= answer jolt-answer) (= first-failure-calls @calls))]\\n198:     (when-not ok (swap! diverged conj [:probe text]))\\n199:     (println (if ok \\\"PASS\\\" \\\"DIVERGES\\\") \\\"probe\\\" (pr-str text)\\n200:              (pr-str (cond-> {:probe answer, :calls first-failure-calls}\\n201:                        (not ok) (assoc :jolt-probe jolt-answer, :jolt-calls @calls))))))\\n202: \\n203: \\n204: (let [rs @results]\\n205:   (println \\\"RECORD totals\\\"\\n206:            (pr-str {:entries (count rs),\\n207:                     :packets-equal (count (filter :packet rs)),\\n208:                     :first-failure-equal (count (filter :first-failure rs)),\\n209:                     :probe-texts (count (:probe oracle)),\\n210:                     :diverged @diverged})))\\n211: \\n212: \\n213: (println \\\"SUMMARY\\\" (if (and (empty? @diverged) (zero? @failed))\\n214:                      \\\"ok\\\"\\n215:                      (str (count @diverged) \\\" diverged, \\\" @failed \\\" failed\\\")))\\n216: \\n217: \\n218: (System/exit (if (and (empty? @diverged) (zero? @failed)) 0 1))\"}]},{\"type\":\"tool_result\",\"tool_use_id\":\"call_fe921e406a46481b9b19e3f5\",\"content\":[{\"type\":\"text\",\"text\":\".claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:27:                   \\\"Cpp/Python3ParserBase.h\\\" {:blake3 \\\"59afaba901ed2d546e2e7f9cc90f9e1b6f7512d53bd5b44567d7154909c83349\\\"},\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:28:                   \\\"Cpp/Python3ParserBase.cpp\\\" {:blake3 \\\"38a2790b2ad40d3a8c2e19f1c84a157b60f100c565f5e294fcdc8fc16c46b28b\\\"}},\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:147:               \\\"a8be1b511222602ef3e2728cacc7201a6b567347bc336dec886b38ae8263cdde\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:149:               \\\"a1cb6339cead5dd6f20cb85825b309dc7a576c77a1b17113fba447b92d307dc3\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:151:               \\\"65027edf9cf43a5d09c745b4936576d3bd5da466b733f337420f73ae368a4bed\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:153:               \\\"8548fd2cd8b7176c70b3761b8de779c6471d238f1ea675587d9c7936538a56e8\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:155:               \\\"d30cc4df41981ed4ae6ced58727fe758004d49a1626cb966844c700b9ece48e4\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:157:               \\\"5e62a9c37bf2e582fc11ccce60f863a2705d79d491b4be0f029bc7e81fe6d816\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:159:               \\\"38a2790b2ad40d3a8c2e19f1c84a157b60f100c565f5e294fcdc8fc16c46b28b\\\",\\n.claude/worktrees/jolt-j0c/antlr/python3/manifest.edn:161:               \\\"59afaba901ed2d546e2e7f9cc90f9e1b6f7512d53bd5b44567d7154909c83349\\\"},\"}]}],\"meta\":{\"source\":\"tool\",\"messageId\":\"76f4bb7c-b692-405f-8c85-79a00bb06856\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"The manifest digest is identical to round 1 (a8be1b51, a1cb6339, 65027edf, 8548fd2c, d30cc4df, 5e62a9c3, 38a2790b, 59afaba9) ✓ — the experimental helper patch was not retained in the manifest. But were the generated files under build/ actually restored? Those are untracked. The author claims regeneration + cmp + dylib returning to 1e465456. Can't verify the bytes without a shell, but the digest-check on regeneration provides strong assurance (exit 0 = digest matches the manifest). Also, could read the generated helper files under build/antlr and compare… build/antlr/python3/cpp/Python3LexerBase.cpp — I could read this and verify whether it contains the experiment's edits (`getLine(), getCharPositionInLine()` inside commonToken / `dedent->setLine`). Let me check the generated files under build and the dylib… reading the dylib won't help. Verify that the generated Python3LexerBase.cpp lacks the experiment's 2 lines, and that positionedToken from the manifest patch is present.\\n\\nAdditional things needed:\\n- Diff of jolt_parser.cpp (new export entries) — adversarial reading.\\n- Verify corpus fixtures (7.8 coverage, no floats, no integers exceeding 64 bits).\\n- Quick check of src/jolt/README.md (1 inventory entry).\\n\\nThe word budget is 600 for output. Reading budget is fine. Let me read jolt_parser.cpp (the new parts) and the corpus header. The cpp is currently around 400 lines. Read the whole file? Last time it was 212 lines; +187 = about 399. Read that.\",\"signature\":\"\"},{\"type\":\"text\",\"text\":\"Manifest digests match round 1. Now the modified wrapper and the corpus fixture.\\n\\n\"},{\"type\":\"tool_use\",\"id\":\"call_34fe8eba8b0047bb9923ffd9\",\"name\":\"read_file\",\"input\":{\"file_path\":\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/native/jolt-parser/jolt_parser.cpp\"}}],\"meta\":{\"source\":\"model\",\"createdAt\":1792491209310,\"messageId\":\"55e2ce40-e2b0-44ad-a13a-db5c77bdc01e\"}},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"call_34fe8eba8b0047bb9923ffd9\",\"content\":[{\"type\":\"text\",\"text\":\"Read 1/1 file, 399 lines\\n1: // jolt-parser: the extern \\\"C\\\" boundary between jolt and the ANTLR4 C++\\n2: // Python3 parser (docs/design/yin.repl-jolt-implementation.md §7.3).\\n3: //\\n4: // J0c round 1 probe surface. Bytes in, bytes out: the caller passes UTF-8\\n5: // source by pointer and length and receives one private marshalling buffer,\\n6: // which it copies and returns through jolt_parser_free. No C++ class, layout\\n7: // or exception crosses this boundary; every entry catches std::exception and\\n8: // (...) and answers an explicit status. This is process-local marshalling (like\\n9: // a sockaddr), not a value codec: it never enters a stream. Packets are built\\n10: // by the shared jolt/Clojure exporter from these records, never here.\\n11: //\\n12: // Buffer layout, all integers little-endian:\\n13: //\\n14: //   magic   \\\"JPT1\\\"\\n15: //   u32     layout version (1)\\n16: //   u32     status (0 ok, 1 syntax errors)\\n17: //   u32     rule-name count R,     then R  x (u32 len, UTF-8 bytes)\\n18: //   u32     symbolic-name count S, then S  x (u32 len, UTF-8 bytes)\\n19: //   u32     node count N, then N preorder records:\\n20: //             u8  kind (0 rule, 1 token)\\n21: //             rule:  u32 rule index, u32 child count\\n22: //             token: i32 token type, u32 start, u32 stop (code-point indexes,\\n23: //                    0xFFFFFFFF = none), u32 text len, UTF-8 text\\n24: //   u32     error count E, then E x (u32 line, u32 column, u32 len, UTF-8 msg)\\n25: //\\n26: // Status codes returned by jolt_parser_parse:\\n27: //    0  parsed, buffer written (status field says whether errors occurred)\\n28: //   -1  invalid arguments\\n29: //   -2  C++ exception (std::exception); *out holds its message, UTF-8\\n30: //   -3  unknown exception\\n31: //   -4  output would exceed the bound\\n32: // On -2/-3 the message buffer is built without anything that can throw\\n33: // (strlen/malloc/memcpy only); if even that malloc fails, *out stays NULL and\\n34: // only the status reports the failure. No handler can throw.\\n35: //\\n36: // jolt_parser_inject_fault is a TEST SEAM (off unless called): it makes the\\n37: // next parses fail deterministically so the containment paths can be shown\\n38: // from jolt without exhausting memory.\\n39: //\\n40: // jolt_parser_export (J0c round 2) answers the same statuses and failure\\n41: // paths with the records the jolt yang.antlr.cst adapter hands to the shared\\n42: // exporter (§7.3). Indexes are i32, -1 for ANTLR's \\\"none\\\" (INVALID_INDEX, a\\n43: // stop before a zero-width start), as the JVM reports them. Its layout:\\n44: //\\n45: //   magic   \\\"JPX1\\\"\\n46: //   u32     layout version (1)\\n47: //   u32     status (0 ok, 1 syntax errors)\\n48: //   u32     rule-name count R,     then R x (u32 len, UTF-8 bytes)\\n49: //   u32     symbolic-name count S, then S x (u32 len, UTF-8 bytes; \\\"\\\" none)\\n50: //   u32     literal-name count S,  then S x (u32 len, UTF-8 bytes; \\\"\\\" none)\\n51: //   u32     node count N, then N preorder records:\\n52: //             u8  kind (0 rule, 1 token)\\n53: //             rule:  u32 rule index, u32 child count,\\n54: //                    u8 has-start, i32 context start (start token's start)\\n55: //             token: i32 type, i32 start, i32 stop, i32 token index,\\n56: //                    u32 text len, UTF-8 text\\n57: //   u32     error count E, then E x\\n58: //             u32 line, u32 column, u32 len, UTF-8 message,\\n59: //             u8 span kind (0 none, 1 offending token, 2 lexer),\\n60: //             i32 a, i32 b (token start/stop, or lexer token-start char\\n61: //             index / input index when the error was reported)\\n62: //   first-failure evidence (the first error reported, lexer or parser):\\n63: //             u8 kind (0 none, 1 lexical, 2 token), u8 no-viable-alt,\\n64: //             i32 offending token index, u32 tokens buffered at the report\\n65: //   u32     buffered token count T after the parse, then T x\\n66: //             (i32 type, i32 token index, i32 start, i32 stop)\\n67: \\n68: #include <atomic>\\n69: #include <cstdint>\\n70: #include <cstdlib>\\n71: #include <cstring>\\n72: #include <limits>\\n73: #include <string>\\n74: #include <string_view>\\n75: #include <vector>\\n76: \\n77: #include \\\"antlr4-runtime.h\\\"\\n78: #include \\\"Python3Lexer.h\\\"\\n79: #include \\\"Python3Parser.h\\\"\\n80: \\n81: #define JOLT_EXPORT extern \\\"C\\\" __attribute__((visibility(\\\"default\\\")))\\n82: \\n83: namespace {\\n84: \\n85: constexpr size_t kMaxOutput = 64u * 1024u * 1024u;\\n86: \\n87: // 0 off; 1 throw std::bad_alloc inside the parse; 2 throw a non-std\\n88: // exception; 3 as 1, and the failure handler's malloc fails too.\\n89: std::atomic<int32_t> g_fault{0};\\n90: \\n91: struct Out {\\n92:   std::vector<uint8_t> buf;\\n93:   void u8(uint8_t v) { buf.push_back(v); }\\n94:   void u32(uint32_t v) {\\n95:     for (int i = 0; i < 4; ++i) buf.push_back(static_cast<uint8_t>(v >> (8 * i)));\\n96:   }\\n97:   void str(std::string_view s) {\\n98:     u32(static_cast<uint32_t>(s.size()));\\n99:     buf.insert(buf.end(), s.begin(), s.end());\\n100:   }\\n101: };\\n102: \\n103: uint32_t idx(size_t i) {\\n104:   return i > std::numeric_limits<uint32_t>::max()\\n105:              ? std::numeric_limits<uint32_t>::max()\\n106:              : static_cast<uint32_t>(i);\\n107: }\\n108: \\n109: struct Error {\\n110:   uint32_t line, column;\\n111:   std::string msg;\\n112: };\\n113: \\n114: class Collect : public antlr4::BaseErrorListener {\\n115:  public:\\n116:   std::vector<Error> errors;\\n117:   void syntaxError(antlr4::Recognizer*, antlr4::Token*, size_t line,\\n118:                    size_t column, const std::string& msg,\\n119:                    std::exception_ptr) override {\\n120:     errors.push_back({idx(line), idx(column), msg});\\n121:   }\\n122: };\\n123: \\n124: void walk(antlr4::tree::ParseTree* t, Out& out, uint32_t& count) {\\n125:   ++count;\\n126:   if (auto* term = dynamic_cast<antlr4::tree::TerminalNode*>(t)) {\\n127:     antlr4::Token* tok = term->getSymbol();\\n128:     out.u8(1);\\n129:     out.u32(static_cast<uint32_t>(static_cast<int32_t>(tok->getType())));\\n130:     out.u32(idx(tok->getStartIndex()));\\n131:     out.u32(idx(tok->getStopIndex()));\\n132:     out.str(tok->getText());\\n133:     return;\\n134:   }\\n135:   auto* ctx = dynamic_cast<antlr4::ParserRuleContext*>(t);\\n136:   out.u8(0);\\n137:   out.u32(idx(ctx->getRuleIndex()));\\n138:   out.u32(idx(ctx->children.size()));\\n139:   for (auto* c : ctx->children) walk(c, out, count);\\n140: }\\n141: \\n142: int32_t hand_off(const std::vector<uint8_t>& bytes, uint8_t** out,\\n143:                  size_t* out_len) {\\n144:   if (bytes.size() > kMaxOutput) return -4;\\n145:   auto* p = static_cast<uint8_t*>(std::malloc(bytes.empty() ? 1 : bytes.size()));\\n146:   if (!p) return -3;\\n147:   if (!bytes.empty()) std::memcpy(p, bytes.data(), bytes.size());\\n148:   *out = p;\\n149:   *out_len = bytes.size();\\n150:   return 0;\\n151: }\\n152: \\n153: // The failure answer: `status`, plus the message copied into a malloc'd\\n154: // buffer when that is possible. Nonallocating apart from that one malloc,\\n155: // whose failure leaves *out NULL. Never throws.\\n156: int32_t message(const char* what, int32_t status, uint8_t** out,\\n157:                 size_t* out_len) noexcept {\\n158:   *out = nullptr;\\n159:   *out_len = 0;\\n160:   const char* m = what ? what : \\\"\\\";\\n161:   size_t n = std::strlen(m);\\n162:   void* p = g_fault.load() == 3 ? nullptr : std::malloc(n == 0 ? 1 : n);\\n163:   if (p) {\\n164:     std::memcpy(p, m, n);\\n165:     *out = static_cast<uint8_t*>(p);\\n166:     *out_len = n;\\n167:   }\\n168:   return status;\\n169: }\\n170: \\n171: // --- jolt_parser_export ------------------------------------------------------\\n172: \\n173: int32_t sidx(size_t i) {\\n174:   if (i == std::numeric_limits<size_t>::max()) return -1;  // INVALID_INDEX\\n175:   return i > static_cast<size_t>(std::numeric_limits<int32_t>::max())\\n176:              ? std::numeric_limits<int32_t>::max()\\n177:              : static_cast<int32_t>(i);\\n178: }\\n179: \\n180: struct ExportError {\\n181:   uint32_t line, column;\\n182:   std::string msg;\\n183:   uint8_t span_kind;\\n184:   int32_t a, b;\\n185: };\\n186: \\n187: class ExportCollect : public antlr4::BaseErrorListener {\\n188:  public:\\n189:   explicit ExportCollect(antlr4::CommonTokenStream* tokens) : tokens_(tokens) {}\\n190:   std::vector<ExportError> errors;\\n191:   uint8_t failure_kind = 0;  // 0 none, 1 lexical, 2 token\\n192:   uint8_t no_viable = 0;\\n193:   int32_t failure_index = -1;\\n194:   uint32_t buffered = 0;\\n195: \\n196:   void syntaxError(antlr4::Recognizer* recognizer, antlr4::Token* offending,\\n197:                    size_t line, size_t column, const std::string& msg,\\n198:                    std::exception_ptr e) override {\\n199:     ExportError err{idx(line), idx(column), msg, 0, -1, -1};\\n200:     auto* lexer = dynamic_cast<antlr4::Lexer*>(recognizer);\\n201:     if (offending) {\\n202:       err.span_kind = 1;\\n203:       err.a = sidx(offending->getStartIndex());\\n204:       err.b = sidx(offending->getStopIndex());\\n205:     } else if (lexer) {\\n206:       err.span_kind = 2;\\n207:       err.a = sidx(lexer->tokenStartCharIndex);\\n208:       err.b = sidx(lexer->getInputStream()->index());\\n209:     }\\n210:     if (failure_kind == 0) {\\n211:       if (!offending) {\\n212:         failure_kind = 1;\\n213:       } else {\\n214:         failure_kind = 2;\\n215:         failure_index = sidx(offending->getTokenIndex());\\n216:         if (e) {\\n217:           try {\\n218:             std::rethrow_exception(e);\\n219:           } catch (const antlr4::NoViableAltException&) {\\n220:             no_viable = 1;\\n221:           } catch (...) {\\n222:           }\\n223:         }\\n224:       }\\n225:       buffered = idx(tokens_->getTokens().size());\\n226:     }\\n227:     errors.push_back(std::move(err));\\n228:   }\\n229: \\n230:  private:\\n231:   antlr4::CommonTokenStream* tokens_;\\n232: };\\n233: \\n234: void walk_export(antlr4::tree::ParseTree* t, Out& out, uint32_t& count) {\\n235:   ++count;\\n236:   if (auto* term = dynamic_cast<antlr4::tree::TerminalNode*>(t)) {\\n237:     antlr4::Token* tok = term->getSymbol();\\n238:     out.u8(1);\\n239:     out.u32(static_cast<uint32_t>(static_cast<int32_t>(tok->getType())));\\n240:     out.u32(static_cast<uint32_t>(sidx(tok->getStartIndex())));\\n241:     out.u32(static_cast<uint32_t>(sidx(tok->getStopIndex())));\\n242:     out.u32(static_cast<uint32_t>(sidx(tok->getTokenIndex())));\\n243:     out.str(tok->getText());\\n244:     return;\\n245:   }\\n246:   auto* ctx = dynamic_cast<antlr4::ParserRuleContext*>(t);\\n247:   out.u8(0);\\n248:   out.u32(idx(ctx->getRuleIndex()));\\n249:   out.u32(idx(ctx->children.size()));\\n250:   out.u8(ctx->start ? 1 : 0);\\n251:   out.u32(static_cast<uint32_t>(ctx->start ? sidx(ctx->start->getStartIndex()) : -1));\\n252:   for (auto* c : ctx->children) walk_export(c, out, count);\\n253: }\\n254: \\n255: }  // namespace\\n256: \\n257: // Parse UTF-8 `src[0, len)` from `file_input` and answer the exporter's\\n258: // records (layout \\\"JPX1\\\" above). Statuses as jolt_parser_parse.\\n259: JOLT_EXPORT int32_t jolt_parser_export(const uint8_t* src, size_t len,\\n260:                                        uint8_t** out, size_t* out_len) {\\n261:   if (!out || !out_len || (!src && len != 0)) return -1;\\n262:   *out = nullptr;\\n263:   *out_len = 0;\\n264:   try {\\n265:     switch (g_fault.load()) {\\n266:       case 1:\\n267:       case 3: throw std::bad_alloc();\\n268:       case 2: throw 42;\\n269:       default: break;\\n270:     }\\n271:     std::string text(reinterpret_cast<const char*>(src), len);\\n272:     antlr4::ANTLRInputStream input(text);\\n273:     Python3Lexer lexer(&input);\\n274:     antlr4::CommonTokenStream tokens(&lexer);\\n275:     Python3Parser parser(&tokens);\\n276:     ExportCollect errors(&tokens);\\n277:     lexer.removeErrorListeners();\\n278:     parser.removeErrorListeners();\\n279:     lexer.addErrorListener(&errors);\\n280:     parser.addErrorListener(&errors);\\n281: \\n282:     antlr4::tree::ParseTree* tree = parser.file_input();\\n283: \\n284:     Out o;\\n285:     o.buf.insert(o.buf.end(), {'J', 'P', 'X', '1'});\\n286:     o.u32(1);\\n287:     o.u32(errors.errors.empty() ? 0 : 1);\\n288:     const auto& rules = parser.getRuleNames();\\n289:     o.u32(idx(rules.size()));\\n290:     for (const auto& r : rules) o.str(r);\\n291:     const auto& vocab = parser.getVocabulary();\\n292:     size_t max_type = vocab.getMaxTokenType();\\n293:     o.u32(idx(max_type + 1));\\n294:     for (size_t i = 0; i <= max_type; ++i) o.str(vocab.getSymbolicName(i));\\n295:     o.u32(idx(max_type + 1));\\n296:     for (size_t i = 0; i <= max_type; ++i) o.str(vocab.getLiteralName(i));\\n297:     size_t count_at = o.buf.size();\\n298:     o.u32(0);\\n299:     uint32_t count = 0;\\n300:     walk_export(tree, o, count);\\n301:     for (int i = 0; i < 4; ++i)\\n302:       o.buf[count_at + i] = static_cast<uint8_t>(count >> (8 * i));\\n303:     o.u32(idx(errors.errors.size()));\\n304:     for (const auto& e : errors.errors) {\\n305:       o.u32(e.line);\\n306:       o.u32(e.column);\\n307:       o.str(e.msg);\\n308:       o.u8(e.span_kind);\\n309:       o.u32(static_cast<uint32_t>(e.a));\\n310:       o.u32(static_cast<uint32_t>(e.b));\\n311:     }\\n312:     o.u8(errors.failure_kind);\\n313:     o.u8(errors.no_viable);\\n314:     o.u32(static_cast<uint32_t>(errors.failure_index));\\n315:     o.u32(errors.buffered);\\n316:     const auto buffered = tokens.getTokens();\\n317:     o.u32(idx(buffered.size()));\\n318:     for (auto* t : buffered) {\\n319:       o.u32(static_cast<uint32_t>(static_cast<int32_t>(t->getType())));\\n320:       o.u32(static_cast<uint32_t>(sidx(t->getTokenIndex())));\\n321:       o.u32(static_cast<uint32_t>(sidx(t->getStartIndex())));\\n322:       o.u32(static_cast<uint32_t>(sidx(t->getStopIndex())));\\n323:     }\\n324:     return hand_off(o.buf, out, out_len);\\n325:   } catch (const std::exception& e) {\\n326:     return message(e.what(), -2, out, out_len);\\n327:   } catch (...) {\\n328:     return message(\\\"unknown exception\\\", -3, out, out_len);\\n329:   }\\n330: }\\n331: \\n332: // Parse UTF-8 `src[0, len)` from the `file_input` rule.\\n333: JOLT_EXPORT int32_t jolt_parser_parse(const uint8_t* src, size_t len,\\n334:                                       uint8_t** out, size_t* out_len) {\\n335:   if (!out || !out_len || (!src && len != 0)) return -1;\\n336:   *out = nullptr;\\n337:   *out_len = 0;\\n338:   try {\\n339:     switch (g_fault.load()) {\\n340:       case 1:\\n341:       case 3: throw std::bad_alloc();\\n342:       case 2: throw 42;\\n343:       default: break;\\n344:     }\\n345:     std::string text(reinterpret_cast<const char*>(src), len);\\n346:     antlr4::ANTLRInputStream input(text);\\n347:     Python3Lexer lexer(&input);\\n348:     antlr4::CommonTokenStream tokens(&lexer);\\n349:     Python3Parser parser(&tokens);\\n350:     Collect errors;\\n351:     lexer.removeErrorListeners();\\n352:     parser.removeErrorListeners();\\n353:     lexer.addErrorListener(&errors);\\n354:     parser.addErrorListener(&errors);\\n355: \\n356:     antlr4::tree::ParseTree* tree = parser.file_input();\\n357: \\n358:     Out o;\\n359:     o.buf.insert(o.buf.end(), {'J', 'P', 'T', '1'});\\n360:     o.u32(1);\\n361:     o.u32(errors.errors.empty() ? 0 : 1);\\n362:     const auto& rules = parser.getRuleNames();\\n363:     o.u32(idx(rules.size()));\\n364:     for (const auto& r : rules) o.str(r);\\n365:     const auto& vocab = parser.getVocabulary();\\n366:     size_t max_type = vocab.getMaxTokenType();\\n367:     o.u32(idx(max_type + 1));\\n368:     for (size_t i = 0; i <= max_type; ++i) o.str(vocab.getSymbolicName(i));\\n369:     size_t count_at = o.buf.size();\\n370:     o.u32(0);\\n371:     uint32_t count = 0;\\n372:     walk(tree, o, count);\\n373:     for (int i = 0; i < 4; ++i)\\n374:       o.buf[count_at + i] = static_cast<uint8_t>(count >> (8 * i));\\n375:     o.u32(idx(errors.errors.size()));\\n376:     for (const auto& e : errors.errors) {\\n377:       o.u32(e.line);\\n378:       o.u32(e.column);\\n379:       o.str(e.msg);\\n380:     }\\n381:     return hand_off(o.buf, out, out_len);\\n382:   } catch (const std::exception& e) {\\n383:     return message(e.what(), -2, out, out_len);\\n384:   } catch (...) {\\n385:     return message(\\\"unknown exception\\\", -3, out, out_len);\\n386:   }\\n387: }\\n388: \\n389: // Release a buffer jolt_parser_parse handed out. NULL is accepted.\\n390: JOLT_EXPORT void jolt_parser_free(uint8_t* p) { std::free(p); }\\n391: \\n392: // TEST SEAM: set the fault mode (0 off, 1-3 as g_fault above) for later\\n393: // parses. Answers the previous mode.\\n394: JOLT_EXPORT int32_t jolt_parser_inject_fault(int32_t mode) {\\n395:   return g_fault.exchange(mode);\\n396: }\\n397: \\n398: // The marshalling layout version this library writes.\\n399: JOLT_EXPORT int32_t jolt_parser_layout_version(void) { return 1; }\"}]}],\"meta\":{\"source\":\"tool\",\"messageId\":\"b575b61e-5f4f-40a5-8d12-ff33a07e93a6\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"jolt_parser_export: same containment structure — try/catch std::exception/(...), messages are noexcept and non-allocating, seam is shared. ExportCollect::syntaxError: inside the listener, rethrow of std::exception_ptr and catch — safe (inside catch(...) {}), and it's within an outer try anyway. tokens_ pointer: ExportCollect holds a pointer to CommonTokenStream, but that stream outlives the parse (declared beforehand). Note: ExportCollect is constructed with &tokens before parser.file_input() — no problem.\\n\\nOne subtle point: inside syntaxError, `buffered = idx(tokens_->getTokens().size())` — only on the first error. `getTokens()` fills the buffer completely, doesn't it? In ANTLR C++, BufferedTokenStream::getTokens() returns the vector of tokens buffered up to that point (does not force fill). OK — matches the claim of \\\"number of tokens buffered at the time of the report\\\".\\n\\nwalk_export: writes start/stop as u32(sidx(...)) — sidx returns int32, cast to u32; -1 → 0xFFFFFFFF, decoded as i32 -1. Consistent.\\n\\nLayout version entry: jolt_parser_layout_version still returns 1 (JPT1). JPX1 has its own version field inside the buffer; no problem.\\n\\nNext the corpus, and checking the restored generated helper. Read the corpus fixture (check W8: no floating point numbers, no integers exceeding 64 bits) — probably medium size. Also grep for the experiment lines (getLine(), getCharPositionInLine() inside commonToken, dedent->setLine) against the generated Python3LexerBase.cpp, and confirm that it has been restored (they must not be present) and that positionedToken is present.\\n\\nAlso quickly check src/jolt/README.md. Also check the DIVERGES/PASS counts in r2-parity-final.log — grep the SUMMARY.\",\"signature\":\"\"},{\"type\":\"text\",\"text\":\"Now the corpus, the restored generated helper, and the final parity log summary.\\n\\n\"},{\"type\":\"tool_use\",\"id\":\"call_730b38105a014dab91311cbd\",\"name\":\"read_file\",\"input\":{\"file_path\":\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/test/yang/python/antlr/fixtures/jolt_j0c_corpus.edn\"}},{\"type\":\"tool_use\",\"id\":\"call_daba9a5369534dab87ff4059\",\"name\":\"grep\",\"input\":{\"pattern\":\"getLine\\\\(\\\\), getCharPositionInLine\\\\(\\\\)|dedent->setLine|positionedToken\",\"path\":\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/build/antlr/python3/cpp/Python3LexerBase.cpp\",\"output_mode\":\"content\",\"-n\":true}},{\"type\":\"tool_use\",\"id\":\"call_096db81331e1488490f92e67\",\"name\":\"grep\",\"input\":{\"pattern\":\"SUMMARY|RECORD totals\",\"path\":\"/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j0c/build/j0c/logs/r2-parity-final.log\",\"output_mode\":\"content\",\"-n\":true}}],\"meta\":{\"source\":\"model\",\"createdAt\":1792491255903,\"messageId\":\"74808c29-bd99-4129-b3ac-388ecd71ba80\"}},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"call_730b38105a014dab91311cbd\",\"content\":[{\"type\":\"t