e browser demo (shadow-cljs build :demo) to public/js/main.js\"\n261:   ;; recognizers live in build/antlr/python3/js (a :cljs classpath root),\n264:   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli release demo\")}\n268:            :depends [build:yin-repl-node gen:antlr]\n272:  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\n275:  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n276:             :depends [check:node-discovery build:yin-repl-node]\n277:             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n279:  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n280:             :depends [build:yin-repl-peer]\n281:             :task (shell \"bb src/dev/cljd_agg.clj\")}\n284:  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n285:                :depends [build:yin-repl-node gen:antlr]\n288:  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n289:                 :depends [check:node-discovery build:yin-repl-node]\n291:                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n293:  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n294:                 :depends [build:yin-repl-peer]\n296:                              \"bb src/dev/cljd_agg.clj\")}\n300:  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\n301:                 :depends [build:yin-repl-node gen:antlr]\n304:  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n305:                  :depends [check:node-discovery build:yin-repl-node]\n307:                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\n311:                                 \"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n315:  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n316:                  :depends [build:yin-repl-peer]\n318:                               \"bb src/dev/cljd_agg.clj --slow-only\")}\n320:  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\n321:             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\n323:  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\n324:            :depends [test:all:clj test:all:cljs test:all:cljd]}\n327:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n358:  test:changed:cljs {:doc \"Node lane of test:changed\"\n363:                                           \"--lane\" \"cljs\"\n382:  test:sub {:doc \"Subsystem tests, three lanes in parallel: bb test:sub <subsystem>... [--slow]\"\n392:  test:sub:clj {:doc \"JVM lane of test:sub: bb test:sub:clj <subsystem>... [--slow]\"\n402:  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\n410:                                         \"--lane\" \"cljs\"\n413:  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n423:  test:sub:list {:doc \"What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>...\"\n     1\t;; Canonical Subsystems Definition for datom.world\n     2\t;; Longest-prefix match over Clojure/ClojureScript/ClojureDart namespaces.\n     3\t;; See docs/design/test.subsystems.md for architectural invariants and gate ladder.\n     4\t\n     5\t{:subsystems\n     6\t [;; Layer 0: Storage, Stream & Core Data Foundations\n     7\t  {:name \"dao.stream\"\n     8\t   :prefixes [\"dao.stream\"]\n     9\t   :layer 0}\n    10\t\n    11\t  {:name \"dao.jing\"\n    12\t   :prefixes [\"dao.jing\"]\n    13\t   :layer 0}\n    14\t\n    15\t  {:name \"dao.data\"\n    16\t   :prefixes [\"dao.data\"]\n    17\t   :layer 0}\n    18\t\n    19\t  {:name \"dao.host\"\n    20\t   :prefixes [\"dao.host\"]\n    21\t   :layer 0}\n    22\t\n    23\t  {:name \"dao.base\"\n    24\t   :prefixes [\"dao.await\" \"dao.lease\" \"dao.pretty\" \"dao.datom\" \"dao.test-slow\"]\n    25\t   :layer 0}\n    26\t\n    27\t  ;; Layer 1: Space, GUI & Graphics\n    28\t  {:name \"dao.space\"\n    29\t   :prefixes [\"dao.space\"]\n    30\t   :layer 1}\n    31\t\n    32\t  {:name \"dao.gui\"\n    33\t   :prefixes [\"dao.gui\"]\n    34\t   :layer 1}\n    35\t\n    36\t  {:name \"dao.postgraphics\"\n    37\t   :prefixes [\"dao.postgraphics\"]\n    38\t   :layer 1}\n    39\t\n    40\t  ;; Layer 2: Virtual Machines & Execution\n    41\t  {:name \"yin.vm.ucf\"\n    42\t   :prefixes [\"yin.vm.ucf\"]\n    43\t   :layer 2}\n    44\t\n    45\t  {:name \"yin.vm\"\n    46\t   :prefixes [\"yin.vm\"]\n    47\t   :layer 2}\n    48\t\n    49\t  ;; Layer 3: Languages & Repl\n    50\t  {:name \"yin.repl\"\n    51\t   :prefixes [\"yin.repl\"]\n    52\t   :layer 3}\n    53\t\n    54\t  {:name \"yang.python\"\n    55\t   :prefixes [\"yang.python\" \"yang.antlr\"]\n    56\t   :layer 3}\n    57\t\n    58\t  {:name \"yang.typescript\"\n    59\t   :prefixes [\"yang.typescript\"]\n    60\t   :layer 3}\n    61\t\n    62\t  {:name \"yang.php\"\n    63\t   :prefixes [\"yang.php\"]\n    64\t   :layer 3}\n    65\t\n    66\t  {:name \"yang.base\"\n    67\t   :prefixes [\"yang.clojure\" \"yang.frontend\" \"yang.safepoint\"\n    68\t              \"yang.stage\" \"yang.tails\" \"yang.io\" \"yang.core\"]\n    69\t   :layer 3}\n    70\t\n    71\t  ;; Layer 4: Demos & World Applications\n    72\t  {:name \"demo\"\n    73\t   :prefixes [\"datomworld\" \"yin.demo\"]\n    74\t   :layer 4}\n    75\t\n    76\t  {:name \"world\"\n    77\t   :prefixes [\"world\"]\n    78\t   :layer 4}\n    79\t\n    80\t  ;; Development & Benchmarking Tooling\n    81\t  {:name \"dev\"\n    82\t   :prefixes [\"affected\" \"affected-test\" \"cljd-agg\"]\n    83\t   :layer :dev}\n    84\t\n    85\t  {:name \"bench\"\n    86\t   :prefixes [\"bench\"]\n    87\t   :layer :bench}]}\n","exit_code":0,"status":"completed"}}
