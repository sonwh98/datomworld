k]))\n    26\t\n    27\t\n    28\t;; =============================================================================\n    29\t;; An injected host listener\n    30\t;; =============================================================================\n    31\t\n    32\t(defn- endpoint!\n    33\t  ([] (endpoint! {}))\n    34\t  ([extra]\n    35\t   (let [h (fixture/host)]\n    36\t     {:host h\n    37\t      :endpoint (serve/serve! (merge {:bind-port 8080\n    38\t                                      :host (:adapter h)}\n    39\t                                     extra))})))\n    40\t\n    41\t\n    42\t(defn- texts\n    43\t  [endpoint]\n    44\t  (mapv :yin.repl.serve/text (first (serve/take-outbox endpoint))))\n    45\t\n    46\t\n    47\t(defn- tick\n    48\t  \"One server turn at `now` with the net pumped around it.\"\n    49\t  [h endpoint now]\n    50\t  (fixture/pump! h)\n    51\t  (let [endpoint (serve/step endpoint now)]\n    52\t    (fixture/pump! h)\n    53\t    endpoint))\n    54\t\n    55\t\n    56\t(defn- connect!\n    57\t  \"Open one client to the endpoint and drive both until its answers cursor\n    58\t   is minted.  Returns [endpoint client now].\"\n    59\t  [h endpoint now]\n    60\t  (let [c (fixture/open h (serve/url endpoint) now)]\n    61\t    (is (some? c) \"the client attached\")\n    62\t    (loop [endpoint endpoint now now left 50]\n    63\t      (let [endpoint (tick h endpoint now)]\n    64\t        (fixture/client-step! c now)\n    65\t        (if (and (pos? left) (rpc/cursor-pending? @(:client c)))\n    66\t          (recur endpoint (inc now) (dec left))\n    67\t          [endpoint c (inc now)])))))\n    68\t\n    69\t\n    70\t;; =============================================================================\n    71\t;; Composition data ownership\n    72\t;; =============================================================================\n    73\t\n    74\t(deftest serve-returns-immediately-with-its-media-and-channel-server\n    75\t  (let [{:keys [endpoint host]} (endpoint!)]\n    76\t    (is (some? (:server endpoint)))\n    77\t    (is (some? (:requests endpoint)))\n    78\t    (is (some? (:answers endpoint)))\n    79\t    (is (= \"/repl\" (:path endpoint)))\n    80\t    (is (= :starting (:status endpoint))\n    81\t        \"serve! claims nothing about a bind it has not observed\")\n    82\t    (is (= 1 (count @(:bound host))))\n    83\t    (is (nil? (:ws-endpoint endpoint)) \"no transport internals above the boundary\")\n    84\t    (is (nil? (:acceptor endpoint)) \"no transport internals above the boundary\")\n    85\t    (let [endpoint (serve/step endpoint 1)]\n    86\t      (is (= :running (:status endpoint)))\n    87\t      (is (str/includes? (str/join \" \" (texts endpoint))\n    88\t                         \"Serving daostream:ws://127.0.0.1:8080/repl\")))))\n    89\t\n    90\t\n    91\t(deftest a-wildcard-bind-needs-an-explicit-advertised-host\n    92\t  (let [{:keys [endpoint host]} (endpoint! {:bind-host \"0.0.0.0\"})]\n    93\t    (is (= :failed (:status endpoint)))\n    94\t    (is (empty? @(:bound host)) \"nothing was bound\")\n    95\t    (let [endpoint (serve/step endpoint 1)]\n    96\t      (is (str/includes? (str/join \" \" (texts endpoint)) \"advertised-host-required\")))))\n    97\t\n    98\t\n    99\t(deftest a-wildcard-bind-with-an-advertised-host-binds-the-wildcard\n   100\t  (let [{:keys [endpoint host]} (endpoint! {:bind-host \"0.0.0.0\"\n   101\t                                            :advertised-host \"10.0.0.5\"})]\n   102\t    (is (= :starting (:status endpoint)))\n   103\t    (is (= \"0.0.0.0\" (:bind-host (first @(:bound host)))))\n   104\t    (is (= \"daostream:ws://10.0.0.5:8080/repl\" (serve/url endpoint)))))\n   105\t\n   106\t\n   107\t(deftest the-listener-binds-the-bind-port-while-the-url-names-the-advertised-port\n   108\t  (let [{:keys [endpoint host]} (endpoint! {:bind-port 8080 :advertised-port 9090})]\n   109\t    (is (= :starting (:status endpoint)))\n 