ted directory — the\n        ;; project-wide build/test_cache kernel is touched by one process.\n        (let [t0 (System/currentTimeMillis)\n              {:keys [exit]}\n              (apply psh {:dir clone\n                          :out (str out \"/all.log\")\n                          :err :append\n                          :extra-env {\"DATOM_SLOW_TESTS\" \"1\"}\n                          :continue true}\n                     \"flutter\" \"test\" \"--concurrency\" (str conc) @dirs)\n              wall (quot (- (System/currentTimeMillis) t0) 1000)\n              verdict (some->> (slurp (str out \"/all.log\"))\n                               str/split-lines\n                               (filter #(re-find #\"All tests passed|Some tests failed\" %))\n                               last)]\n          (log (str \"flutter rc=\" exit \" wall=\" wall \"s \" (or verdict \"\")))\n          (when-not (zero? exit) (fail! (str \"flutter test rc=\" exit))))))\n    (log (str \"done rc=\" @rc))\n    (System/exit @rc)))\n\n\n(when (= *file* (System/getProperty \"babashka.file\"))\n  (apply -main *command-line-args*))\n54:               :out (io/writer out-file :append true)\n55:               :err (io/writer out-file :append true)\n62:  (str/trim (:out (psh {:out :string :extra-env {\"TZ\" \"Asia/Ho_Chi_Minh\"}}\n68:  (str/trim (:out (psh {:out :string :extra-env {\"TZ\" \"Asia/Ho_Chi_Minh\"}}\n74:  (str/trim (:out (apply psh {:dir dir :out :string :err :string :continue true} \"git\" args))))\n80:  (->> (apply psh {:dir clone :out :string :continue true}\n82:       :out\n130:          :append true)\n139:    (spit summary (str \"node-shard rc=\" rc \"\\n\") :append true)\n147:    (spit summary (str \"dart-shard rc=\" rc \"\\n\") :append true)\n169:        log (fn [s] (println s) (spit summary (str s \"\\n\") :append true))]\n186:                        (str/trim (:out (psh {:out :string} \"date\" \"-u\" \"+%Y-%m-%dT%H:%M:%SZ\"))))]\nException in thread \"Thread-0\" java.lang.R