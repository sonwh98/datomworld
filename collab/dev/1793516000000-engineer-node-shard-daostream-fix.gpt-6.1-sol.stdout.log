{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"sed -n '460,625p' test/dao/stream/ws_project_cross_node_test.cljs; cat mise.toml | head -65; sed -n '1,120p' deps.edn\"","aggregated_output":"                      :dao.stream/ok (step (conj received (:value reply)))\n                      :dao.stream/end received\n                      nil)))))]\n    (-> (settled-read! peer :begin settle-ms)\n        (.then (fn [_] (step [])))\n        (.then (fn [received]\n                 (check-corpus! received what)\n                 acc)))))\n\n\n(defn- p2-corpus-forward\n  \"The JVM dials, Node serves: the Node-encoded corpus decodes in the JVM.\"\n  [acc]\n  (jvm-reads-corpus acc \"Node serves, JVM decodes\"))\n\n\n(defn- p1-corpus-back\n  \"The JVM serves, Node dials: the JVM attaches its own reflection of the\n   corpus Node serves over the same accepted session, and decodes it.\"\n  [{:keys [peer] :as acc}]\n  (-> (ask! peer {:cmd :attach :identity corpus/identity-name} :attach)\n      (.then\n        (fn [attached]\n          (when (is (= :dao.stream/ok (:outcome attached))\n                    \"the JVM reverse attach was refused\")\n            (jvm-reads-corpus acc \"Node dials, JVM server decodes\"))))))\n\n\n(defn- p2-corpus-back\n  \"The JVM's dial-side mirror serves its encoded corpus to this end over\n   the same accepted session.\"\n  [{:keys [acceptor descriptor] :as acc}]\n  (-> (poll-until #(seq (project/sessions acceptor)) settle-ms)\n      (.then\n        (fn [_]\n          (-> (read-reflection-corpus\n                (reflection-over-session acceptor descriptor\n                                         corpus/identity-name))\n              (.then (fn [received]\n                       (check-corpus! received \"JVM mirror serves, Node decodes\")\n                       acc)))))))\n\n\n(defn- p1-descriptor\n  \"The serving reply becomes the reachable descriptor; nil when the JVM\n   listener never reported one.\"\n  [peer]\n  (-> (take-reply! peer :serving boot-ms)\n      (.then\n        (fn [serving]\n          (when (is (map? serving)\n                    (str \"the JVM listener never reported a bound port; \"\n                         \"its other output was \"\n                         (pr-str (take 5 @(:errors peer)))))\n            (is (int? (:port serving)))\n            {:peer peer\n             :descriptor (descriptor-at (:port serving))})))))\n\n\n(defn- p1-dialer\n  \"This end's dialing composition, joined into the chain's state.  The\n   stop function rides along for the terminal step's cleanup.\"\n  [acc]\n  (let [dialer (node-dialer)]\n    (.then (js/Promise.resolve acc)\n           (fn [acc'] (merge acc' {:dialer dialer})))))\n\n\n(defn- p1-attach\n  \"Attach the reflection of \\\"str-1\\\" over the dialed channel.\"\n  [{:keys [descriptor dialer] :as acc}]\n  (let [attached (project/dial-attach!\n                   (:dial dialer)\n                   (remote-descriptor descriptor \"str-1\"))]\n    (when (is (= :dao.stream/ok (:dao.stream/outcome attached))\n              \"the Node dial over a real JVM listener was refused\")\n      (is (string? (:dao.stream/attachment attached)))\n      (assoc acc :reflection (:dao.stream/handle attached)))))\n\n\n(defn- p1-cursor\n  \"Settle the cursor ask and prove the probe's confirmation crossed the\n   wire: the event writer recorded the served stream's declared\n   surface.\"\n  [{:keys [dialer reflection] :as acc}]\n  (-> (settle #(stream/cursor reflection stream/anchor-oldest) settle-ms)\n      (.then\n        (fn [c0]\n          (when (is (some? c0) \"the cursor ask never settled\")\n            (is (= :dao.stream/ok (:dao.stream/outcome c0)))\n            (is (= #{:reader} (confirmation-surface (:events dialer)))\n                \"the confirmation carries the served surface\")\n            (assoc acc :c0 (:dao.stream/cursor c0)))))))\n\n\n(defn- p1-value\n  \"The first next: \\\"hello\\\", and nothing knew it was a string.\"\n  [{:keys [reflection c0] :as acc}]\n  (-> (settle #(stream/next reflection c0) settle-ms)\n      (.then\n        (fn [n]\n          (when (is (some? n) \"the first next never settled\")\n            (is (= :dao.stream/ok (:dao.stream/outcome n)))\n            (is (= \"hello\" (:dao.stream/value n))\n                \"nothing knew it was a string\")\n            (assoc acc :c1 (:dao.stream/cursor n)))))))\n\n\n(defn- p1-end\n  \"The second next: the source's own end.\"\n  [{:keys [reflection c1] :as acc}]\n  (-> (settle #(stream/next reflection c1) settle-ms)\n      (.then\n        (fn [e]\n          (when (is (some? e) \"the second next never settled\")\n            (is (= :dao.stream/end (:dao.stream/outcome e))\n                \"the source's own end\")\n            acc)))))\n\n\n(defn- p1-sessions\n  \"The JVM acceptor adopted exactly one connection for the one dial.\"\n  [{:keys [peer] :as acc}]\n  (-> (ask! peer {:cmd :sessions} :sessions)\n      (.then\n        (fn [sessions]\n          (when (is (map? sessions) \"the sessions ask never answered\")\n            (is (= 1 (:count sessions))\n                \"the JVM acceptor adopted one connection for one dial\")\n            (is (nil? (:ticker-error sessions)))\n            acc)))))\n\n\n(defn- a-node-dialer-reads-a-jvm-server\n  [flag done & [steps]]\n  (reset! under-test {:profile (get profiles flag) :flag flag})\n  (.then (jvm-classpath)\n         (fn [classpath]\n           (if (nil? classpath)\n             (do (println \";; SKIPPED a-node-dialer-reads-a-jvm-server:\"\n                          \"no Clojure CLI, so no JVM peer can serve\")\n                 (done))\n             (let [peer (start-jvm-peer! classpath [\"--serve\"])\n                   finish! (fn []\n                             (stop-peer! peer)\n                             (done))]\n               (-> (chain peer (or steps\n                                   [p1-descriptor\n                                    p1-dialer\n                                    p1-attach\n                                    p1-cursor\n                                    p1-value\n                                    p1-end\n                                    p1-sessions]))\n                   (.then\n                     (fn [acc]\n                       (when (nil? acc)\n                         (is false \"the clj->Node proof stopped early\"))\n                       (when-some [dialer (:dialer acc)]\n                         ((:stop! dialer)))\n                       (finish!)))\n                   (.catch\n                     (fn [error]\n                       (is false (str \"clj->Node proof failure: \"\n                                      (pr-str error)))\n                       (finish!)))))))))\n[tools]\njava = [\"21\", \"17\"]\ncljstyle = \"0.17.642\"\nzprint = \"1.3.0\"\nbabashka = \"1.13.225\"\nclojure = \"1.12.4.1602\"\nnode = \"25.6.1\"\n# jolt host lane (jolt-toolchain.edn): exact pins, never \"latest\"; a change of\n# either goes through the jolt upgrade gate\nchezscheme = \"10.4.1\"\ncmake = \"4.4.4\"\nandroid-sdk = \"latest\"\nflutter = { version = \"3.47.8\", platforms = \"\"\"\n[linux-x64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/linux/flutter_linux_{{ version }}-beta.tar.xz\"\n\n[macos-arm64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/macos/flutter_macos_arm64_{{ version }}-beta.zip\"\n\n[macos-x64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/macos/flutter_macos_{{ version }}-beta.zip\"\n\n[windows-x64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/windows/flutter_windows_{{ version }}-beta.zip\"\n\"\"\", version_json_path = \".releases[?channel=beta].version\", version_list_url = \"https://storage.googleapis.com/flutter_infra_release/releases/releases_macos.json\" }\n\n[env._]\npath = [\n  \"{{env.HOME}}/.local/share/mise/installs/android-sdk/1.0/pla