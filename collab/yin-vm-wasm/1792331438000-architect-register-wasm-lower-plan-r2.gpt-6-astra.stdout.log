  `:link-request` and the poll retries it. Under a custody gate the mint\n   570\t   and the append are the driver's: the entry is built without `:cursor`\n   571\t   and parks in `:link-request` with nothing sent. The entry is the kernel's\n   572\t   registers plus the link fields: resource ids and plain data, never a\n   573\t   handle.\n   574\t\n   575\t   A module already on this task's install ancestry is `:require-cycle`\n   576\t   naming the chain (section 7.4): the child that asked is refused. A VM\n   577\t   composed without a link pair cannot link, so its miss fails as v1's\n   578\t   did, naming the modules it has.\"\n   579\t  [state effect {:keys [park-entry-fns]} try?]\n   580\t  (let [module-name (:module effect)\n   581\t        build (or (when try? (get park-entry-fns :module/try-require))\n   582\t                  (get park-entry-fns :module/require))\n   583\t        registers #(cond-> (if build (build state effect nil) {})\n   584\t                     try? (assoc :try? true))\n   585\t        resources (:resources state)\n   586\t        response (get resources link-response-resource)]\n   587\t    (cond\n   588\t      (some? (resolve-module (:modules state) module-name))\n   589\t      {:value (if try? {:status :ok, :module module-name} module-name),\n   590\t       :state state, :blocked? false}\n   591\t\n   592\t      (some #{module-name} (:ancestry state))\n   593\t      (let [refusal {:reason :require-cycle,\n   594\t                     :module module-name,\n   595\t                     :chain (conj (vec (:ancestry state)) module-name)}]\n   596\t        (if try?\n   597\t          {:value (assoc refusal :status :refused),\n   598\t           :state state, :blocked? false}\n   599\t          (throw (ex-info \"Require cycle\" refusal))))\n   600\t\n   601\t      (installing? state module-name)\n   602\t      (block-on state (cond-> (assoc (registers)\n   603\t                                     :reason :install :name module-name)\n   604\t                        try? (assoc :link-id (get-in state\n   605\t                                                     [:installs module-name\n   606\t                                                      :parent]))))\n   607\t\n   608\t      (not (and response (get resources link-request-resource)))\n   609\t      (throw (ex-info \"Module is not in this VM's registry\"\n   610\t                      {:module module-name,\n   611\t                       :available (vec (list-modules (:modules state)))}))\n   612\t\n   613\t      :else\n   614\t      (let [gate (vm/gate-mode state)\n   615\t            minted (when (nil? gate)\n   616\t                     (stream/cursor response stream/anchor-newest))\n   617\t            _ (when (and (nil? gate)\n   618\t                         (not= :dao.stream/ok (:dao.stream/outcome minted)))\n   619\t                (throw (ex-info \"Link response cursor mint failed\"\n   620\t                                {:outcome (:dao.stream/outcome minted),\n   621\t                                 :module module-name})))\n   622\t            [link-id state] (mint-link-id state)\n   623\t            {:keys [format contract]} (link-format state)\n   624\t            entry (assoc (registers)\n   625\t                         :reason :link-request\n   626\t                         :name module-name\n   627\t                         :link-id link-id\n   628\t                         :envelope {:yin.link/id link-id,\n   629\t                                    :yin.link/name module-name,\n   630\t                                    :yin.link/format format,\n   631\t                                    :yin.link/contract contract}\n   632\t                         :request link-request-resource\n   633\t                         :response link-response-resource)\n   634\t            entry (cond-> entry\n   635\t                    minted (assoc :cursor (:dao.stream/cursor minted)))]\n   636\t        (block-on state (append-link-request resources entry gate))))))\n   637\t\n   638\t\n   639\t(defn require-handler\n   640\t  \"Resolve `:module/require`, raising a refusal at resume.\"\n   641\t  [state effect opts]\n   642\t  (handle-require state effect opts false))\n   128\t\n   129\t(defn- install-image\n   130\t  \"Install `segment` as the one image. A non-empty image must pass the\n   131\t   register validator. The offset table restarts at the base row\n   132\t   `[R 0 n]`.\"\n   133\t  [vm segment]\n   134\t  (let [empty-seg? (empty-segment? segment)]\n   135\t    (if empty-seg?\n   136\t      (assoc vm\n   137\t             :segment empty-image\n   138\t             :hash nil\n   139\t             :images [[(rcode/register-hash empty-image) 0 0]]\n   140\t             :pc 0\n   141\t             :frames []\n   142\t             :registers []\n   143\t             :continuation []\n   144\t             :halted? true\n   145\t             :blocked? false\n   146\t             :value nil)\n   147\t      (if-let [defect (rcode/register-image-defect segment)]\n   148\t        (throw (ex-info (str \"Invalid register image: \" (:rule defect))\n   149\t                        defect))\n   150\t        (let [body0 (first (:bodies segment))\n   151\t              reg-count (or (:registers body0) 0)\n   152\t              r (rcode/register-hash segment)]\n   153\t          (assoc vm\n   154\t                 :segment segment\n   155\t                 :hash r\n   156\t                 :images [[r 0 (count (:instructions segment))]]\n   157\t                 :pc 0\n   158\t                 :frames []\n   159\t                 :registers (vec (repeat reg-count nil))\n   160\t                 :continuation []\n   161\t                 :halted? false\n   162\t                 :blocked? false\n   163\t                 :value nil))))))\n   164\t\n   165\t\n   166\t(defn load-image\n   167\t  \"Load `segment` (a register image `{:bodies [...], :instructions [...]}`)\n   168\t   into `vm` as its one image: R is computed, the registers are reset to\n   169\t   pc 0 with empty frames and continuation, and the machine is running\n   170\t   unless the segment is empty. The offset table restarts at `[R 0 n]`, so\n   171\t   a continuation parked under an earlier image names no row of it and\n   172\t   `register-restore` refuses it.\n   173\t\n   174\t   `contract` is required and compared with `vm/register-contract` first\n   175\t   (`:contract-missing`, `:contract-mismatch`); a non-empty image must then\n   176\t   pass the register validator, Rule R included. An empty segment admits\n   177\t   no code and needs neither.\"\n   178\t  [vm segment contract]\n   179\t  (when-not (empty-segment? segment)\n   180\t    (vm/check-contract! vm/register-contract contract))\n   181\t  (install-image vm segment))\n   182\t\n   183\t\n   184\t(defn relocate\n   185\t  \"Shift every `:pc`-kind operand of `inst` by `offset`.\"\n   186\t  [offset inst]\n   187\t  (reduce (fn [inst [i [_ kind]]]\n   188\t            (if (= :pc kind) (update inst (inc i) + offset) inst))\n   189\t          inst\n   190\t          (map-indexed vector (get rcode/opcode-table (nth inst 0)))))\n   191\t\n   192\t\n   193\t(defn attach-image\n   194\t  \"Extend the code space of `vm` with `image`, non-destructively\n   195\t   (yin.vm.linker.md section 7.3, act 3): `image` is admitted alone as\n   196\t   `load-image` admits it, relocated by the held instruction count, and\n   197\t   appended, `:bodies` shifted likewise; one `[identity offset length]`\n   198\t   row, identity R of `image`, is appended to the offset table; `:hash`\n   199\t   becomes R of the concatenation. `:pc`, `:registers`, `:frames`,\n   200\t   `:continuation`, and every other register are unchanged: appending\n   201\t   moves no instruction already held. An image whose identity is already\n   202\t   a row is not attached twice, and an empty image, which adds no code,\n   203\t   is not attached at all.\"\n   204\t  [vm image contract]\n   205\t  (when-not (empty-segment? image)\n   206\t    (vm/check-contract! vm/register-contract contract)\n   207\t    (when-let [defect (rcode/register-image-defect image)]\n   208\t      (throw (ex-info (str \"Invalid register image: \" (:rule defect))\n   209\t                      defect))))\n   210\t  (let [ident (when-not (empty-segment? image) (rcode/register-hash image))]\n   211\t    (if (or (nil? ident) (some #(= ident (nth % 0)) (:images vm)))\n   212\t      vm\n   213\t      (let [held (:segment vm)\n   214\t            offset (count (:instructions held))\n   215\t            shift-body #(-> % (update :start + offset) (update :end + offset))\n   216\t            combined {:bodies (into (:bodies held)\n   217\t                                    (map shift-body)\n   218\t                                    (:bodies image)),\n   219\t                      :instructions (into (:instructions held)\n   220\t                                          (map #(relocate offset %))\n   221\t                                          (:instructions image))}]\n   222\t        (assoc vm\n   223\t               :segment combined\n   224\t               :hash (rcode/register-hash combined)\n   225\t               :images (conj (:images vm)\n   226\t                             [ident offset\n   227\t                              (count (:instructions image))]))))))\n   228\t\n    84\t(defn continuation-payload\n    85\t  \"Construct a canonical sparse register continuation payload for a\n    86\t   suspending or boundary instruction. Extracts only live registers in\n    87\t   strictly ascending index order.\n    88\t   `runtime` must contain: `:segment`, `:hash`, `:pc`, `:frames`,\n    89\t   `:registers`, and `:continuation`; its offset table `:images` gives\n    90\t   `:image`, the identity of the row the resume pc falls in, which is\n    91\t   what `register-restore` checks (r6).\"\n    92\t  [runtime instruction]\n    93\t  (let [op (first instruction)]\n    94\t    (when-not (boundary-opcodes op)\n    95\t      (throw (ex-info \"Instruction is not a continuation boundary\"\n    96\t                      {:rule :continuation-site, :pc (:pc runtime)})))\n    97\t    (let [site-pc (:pc runtime)\n    98\t          live-idx (rcode/live-slot-index op)\n    99\t          live (nth instruction live-idx)\n   100\t          tail? (and (= :call op) (true? (nth instruction 4)))\n   101\t          dest (if tail? nil (nth instruction 1))\n   102\t          resume-mode (if tail? :return-result :write-result)\n   103\t          regs (mapv (fn [r] [r (nth (:registers runtime) r)]) live)\n   104\t          images (:images runtime)]\n   105\t      (cond-> {:segment (:segment runtime),\n   106\t               :site-pc site-pc,\n   107\t               :pc (inc site-pc),\n   108\t               :frames (:frames runtime),\n   109\t               :regs regs,\n   110\t               :live live,\n   111\t               :continuation (:continuation runtime),\n   112\t               :dest dest,\n   113\t               :resume-mode resume-mode,\n   114\t               :format format-tag,\n   115\t               :hash (:hash runtime),\n   116\t               :image (nth (image-row images (inc site-pc)) 0 nil)}\n   117\t        ;; a code space grown by `attach-image` is a concatenation of\n   118\t        ;; images, each admitted alone: the table travels so each can be\n   119\t        ;; checked alone (`continuation-defect`)\n   120\t        (< 1 (count images)) (assoc :images images)))))\n   121\t\n   122\t\n   360\t(def ^:private stale-keys\n   361\t  [:value :status :cursor :resource-updates :stream\n   362\t   :datom :type :id :request-sent :op])\n   363\t\n   364\t\n   365\t(defn wait-entry-defect\n   366\t  \"Return nil when `entry` is a valid newly parked engine wait-set entry,\n   367\t   or the first deterministic defect map.\n   368\t   Validates the embedded continuation payload and shape-specific transport\n   369\t   fields, and rejects