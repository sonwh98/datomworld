st entry)\n   473\t          restored-regs\n   474\t          (reduce (fn [acc [r v]] (assoc acc r v))\n   475\t                  (vec (repeat reg-count nil))\n   476\t                  (:regs entry))\n   477\t          final-regs (if (some? dest)\n   478\t                       (assoc restored-regs dest val)\n   479\t                       restored-regs)]\n   480\t      (assoc base\n   481\t             :pc pc\n   482\t             :frames (:frames entry)\n   483\t             :registers final-regs\n   484\t             :continuation (:continuation entry)\n   485\t             :store-of (:store-of entry)\n   486\t             :value val\n   487\t             :halted? false))))\n   488\t\n   489\t\n   490\t(defn register-restore\n   491\t  \"The register VM's restore function, `base entry val -> state`\n   492\t   (design section 5.2.3). Validates format identity and that the entry's\n   493\t   `:image` is a row of the offset table (yin.vm.linker.md section 7.3,\n   494\t   r6; `:hash` is never a restore key, since it changes at every\n   495\t   `attach-image`), checks that the payload is defect-free via\n   496\t   effects/continuation-defect, checks that `val` is plain data, handles\n   497\t   the FFI two-step, and delivers `val` via `:write-result` or\n   498\t   `:return-result`. The entry restores registers only and never assigns\n   499\t   `:segment`: the code space is kernel state.\"\n   500\t  [base entry val]\n   501\t  (check-format! base entry)\n   502\t  (when-let [defect (effects/continuation-defect entry)]\n   503\t    (throw (ex-info \"Corrupt or tampered continuation payload\"\n   504\t                    defect)))\n   505\t  (when-not (vm/machine-data? val)\n   506\t    (throw (ex-info \"Resume value must be plain data\"\n   507\t                    {:rule :resume-value, :val val})))\n   508\t  (if (:request-sent entry)\n   509\t    (-> base\n   510\t        (update :wait-set (fnil conj [])\n   511\t                (ffi/response-wait-entry entry (:call-id entry)))\n   512\t        (assoc :value :yin/blocked\n   513\t               :blocked? true\n   514\t               :halted? false))\n   515\t    (let [call-id (:call-id entry)\n   516\t          base (if call-id (update base :parked dissoc call-id) base)\n   517\t          val (if call-id (ffi/call-result val call-id) val)]\n   518\t      (write-back base entry val))))\n   519\t\n   520\t\n   521\t;; =============================================================================\n   522\t;; Effects & FFI dispatch\n   523\t;; =============================================================================\n   524\t\n   525\t(defn- payload-of\n   526\t  \"The continuation payload of `inst` (`effects/continuation-payload`),\n   527\t   carrying the running body's module store when there is one.\"\n   528\t  [vm inst]\n   529\t  (cond-> (effects/continuation-payload vm inst)\n   530\t    (:store-of vm) (assoc :store-of (:store-of vm))))\n   531\t\n   532\t\n   533\t(defn- park-entry-fns\n   534\t  [payload]\n   535\t  {:stream/put (fn [_state effect result]\n   536\t                 (assoc payload\n   537\t                        :reason :put\n   538\t                        :stream-id (:stream-id result)\n   539\t                        :datom (:val effect))),\n   540\t   :stream/next (fn [_state _effect result]\n   541\t                  (assoc payload\n   542\t                         :reason :next\n   543\t                         :cursor-ref (:cursor-ref result)\n   544\t                         :stream-id (:stream-id result))),\n   545\t   :module/require (fn [_state _effect _result] payload)})\n   546\t\n   547\t\n   548\t(defn- run-effect\n   549\t  [vm effect inst]\n   550\t  (let [opts (when (rcode/boundary-opcodes (first inst))\n   551\t               {:park-entry-fns\n   552\t                (park-entry-fns (payload-of vm inst))})\n   553\t        pc' (inc (:pc vm))\n   554\t        {:keys [state value blocked?]}\n   555\t        (engine/handle-effect vm effect opts)]\n   556\t    (if blocked?\n   557\t      (assoc state :pc pc')\n   558\t      (let [rd (nth inst 1)]\n   559\t        (assoc state\n   560\t               :pc pc'\n   561\t               :registers (assoc (:registers state) rd value))))))\n   562\t\n   563\t\n   564\t(defn- run-call-effect\n   565\t  [vm effect inst]\n   566\t  (let [payload (payload-of vm inst)\n   567\t        tail? (true? (nth inst 4))\n   568\t        pc' (inc (:pc vm))\n   569\t        {:keys [state value blocked?]}\n   570\t        (engine/handle-effect vm\n   571\t                              effect\n   572\t                              {:park-entry-fns (park-entry-fns payload)})]\n   573\t    (if blocked?\n   574\t      (assoc state :pc pc')\n   575\t      (if tail?\n   576\t        (return-transition state value)\n   577\t        (let [rd (nth inst 1)]\n   578\t          (assoc state\n   579\t                 :pc pc'\n   580\t                 :registers (assoc (:registers state) rd value)))))))\n   581\t\n   582\t\n    77\t(defn operator-kind\n    78\t  \"Classify the operator `f` a kernel of `state` is about to apply:\n    79\t   `:host-fn`, `:closure` or `:continuation`. A closure or continuation\n    80\t   must be owned by this task (`:owner`); anything else is refused. The\n    81\t   one classifier every kernel's application calls.\"\n    82\t  [state f]\n    83\t  (cond (fn? f) :host-fn\n    84\t        (values/host-typed? f)\n    85\t        (if (values/owned-by? f (:owner state))\n    86\t          (if (values/closure? f) :closure :continuation)\n    87\t          (fail \"Cannot apply a value of another task\"\n    88\t                {:reason :foreign-value, :kind (values/kind-of f)}))\n    89\t        :else (fail \"Cannot apply non-function\"\n    90\t                    {:reason :not-applicable, :kind (values/kind-of f)})))\n    91\t\n    92\t\n    93\t(defn marker-mismatch!\n    94\t  \"Refuse to lower closure `marker` whose binders (a named kernel's\n    95\t   `:yin.k/params`, a positional kernel's `:yin.k/arity`) are not those of\n    96\t   the attached lambda it names: a lower mints an applicable closure, so\n    97\t   the wire never chooses what a closure binds.\"\n    98\t  [marker]\n    99\t  (fail \"Closure marker disagrees with its attached lambda\"\n   100\t        {:reason :marker-mismatch, :segment (:yin.k/segment marker)}))\n   101\t\n   102\t\n   103\t(defn continuation-argument\n   104\t  \"The one value a captured continuation is applied to. Applying a\n   105\t   continuation is abortive: the current continuation is discarded and\n   106\t   the argument becomes the value of the capture point. Every VM refuses\n   107\t   any other arity with this same message.\"\n   108\t  [args]\n   109\t  (when-not (= 1 (count args))\n   110\t    (throw (ex-info \"Continuation expects exactly one argument\"\n   111\t                    {:reason :continuation-arity, :argc (count args)})))\n   112\t  (first args))\n   113\t\n   114\t\n  2530\t                             (moded :data (:values children)))\n  2531\t                         (and (nil? children) (map? x))\n  2532\t                         (-> (moded :data (keys x))\n  2533\t                             (moded :data (vals x)))\n  2534\t                         (and (nil? children) (not (map? x)) (coll? x))\n  2535\t                         (moded :data x))]\n  2536\t              (recur work\n  2537\t                     (conj seen entry)\n  2538\t                     (if new-id? (conj found id) found)))))))))\n  2539\t\n  2540\t\n  2541\t(defn- gc-roots\n  2542\t  \"Every root of `vm` (design Q1), by mode: the kernel's registers as it\n  2543\t   classifies them (`module/gc-roots`), each entry of `:parked`,\n  2544\t   `:wait-set` and `:ready-queue` as a kernel position, the store and\n  2545\t   every module store as values, then `extra` as values. Code, images,\n  2546\t   the registry, primitives, `:callable-effects`, telemetry and\n  2547\t   `:resources` are not roots: a literal can never be an authentic ref,\n  2548\t   and a value inside a stream is the medium's (hence pinning).\"\n  2549\t  [vm extra]\n  2550\t  (let [kernel (when (satisfies? module/IModuleKernel vm)\n  2551\t                 (module/gc-roots vm))]\n  2552\t    {:kernel (-> (vec (:kernel kernel))\n  2553\t                 (into (vals (:parked vm)))\n  2554\t                 (into (:wait-set vm))\n  2555\t                 (into (:ready-queue vm))),\n  2556\t     :data (-> [(:store vm) (:module-stores vm)]\n  2557\t               (into (:values kernel))\n  2558\t               (into extra))}))\n  2559\t\n  2560\t\n  2561\t(defn- mark\n  2562\t  \"The ids of `heap` live from `roots` and from the `pinned` ids: a pinned\n  2563\t   cell is a root, so its content is traced too, as data.\"\n  2564\t  [vm heap roots pinned]\n  2565\t  (let [pins (filterv #(contains? heap %) pinned)]\n  2566\t    (trace vm\n  2567\t           heap\n  2568\t           (update roots :data into (map #(:value (get heap %))) pins)\n  2569\t           (set pins)\n  2570\t           true)))\n  2571\t\n  2572\t\n  2573\t(defn- sweep\n  2574\t  \"`heap` without each id of the cycle's `snapshot` that `marked` lacks.\n  2575\t   An id allocated after the snapshot is not in it, so it is spared.\"\n  2576\t  [heap snapshot marked]\n  2577\t  (reduce-kv (fn [h id _] (if (contains? marked id) h (dissoc h id)))\n  2578\t             heap\n  2579\t             snapshot))\n  2580\t\n  2581\t\n  2582\t(defn- gc-of\n  2583\t  [state]\n  2584\t  (or (:gc state) (vm/fresh-gc nil)))\n  2585\t\n  2586\t\n  2587\t(defn collect\n  2588\t  \"`vm` after one stop-the-world collection of its `:heap`, with `extra`\n  2589\t   traced as additional roots. The allocation count restarts and the\n  2590\t   threshold becomes `max(base, 2 x live)`, so the total work stays linear\n  2591\t   in allocations. Pure: the same state always collects to the same heap.\"\n  2592\t  ([vm] (collect vm nil))\n  2593\t  ([vm extra]\n  2594\t   (let [gc (gc-of vm)\n  2595\t         snapshot (:heap vm)\n  2596\t         marked (mark vm snapshot (gc-roots vm extra) (:pinned gc))\n  2597\t         heap (sweep (:heap vm) snapshot marked)]\n  2598\t     (assoc vm\n  2599\t            :heap heap\n  2600\t            :gc (assoc gc\n  2601\t                       :since 0\n  2602\t                       :threshold (max (:base gc) (* 2 (count heap))))))))\n  2603\t\n  2604\t\n  2605\t(defn- count-allocation\n  2606\t  \"`state` with one allocation counted, collected first when the count\n  2607\t   reaches the threshold. `v`, the value being boxed, is held by no\n  2608\t   register yet, so it is traced as an extra root.\"\n  2609\t  [state v]\n  2610\t  (let [gc (gc-of state)\n  2611\t        since (inc (:since gc))]\n  2612\t    (if (>= since (:threshold gc))\n  2613\t      (collect state [v])\n  2614\t      (assoc state :gc (assoc gc :since since)))))\n  2615\t\n  2616\t\n  2617\t(defn pin-refs\n  2618\t  \"`state` with every cell `v` holds a ref to pinned for the task's life\n  2619\t   (owner decision 1). A value appended to a stream or carried by an FFI\n  2620\t   request leaves the VM's view, so no trace could find a ref inside it\n  2621\t   when it comes back.\"\n  2622\t  [state v]\n  2623\t  (if (or (scalar? v) (empty? (:heap state)))\n  2624\t    state\n  2625\t    (let [ids (trace state (:heap state) {:data [v]} #{} false)]\n  2626\t      (if (seq ids)\n  2627\t        (assoc state :gc (update (gc-of state) :pinned into ids))\n  2628\t        state))))\n  2629\t\n  2630\t\n  2631\t(defn handle-effect\n  2632\t  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n  2633\t   park-entry-fns maps :stream/put and :stream/next to functions that build\n  2634\t   wait entries.\n  2635\t\n  2636\t   `effect` must be a `yin.vm.effect` value minted by `module/make-effect`\n  2637\t   (D4); a map, whatever its keys, is data and is refused here.\n  2638\t\n  2639\t   A parked entry is stored as the builder left it plus, for a writer, the\n  2640\t   `:datom` it retries: registers and resource ids only. Neither the live\n  2641\t   stream handle nor a restore closure is attached — `check-wait-set`\n  2642\t   resolves handles from `:resources` at every poll, and the scheduler that pops\n  2643\t   a woken entry dispatches restoration itself — so a blocked entry is pure\n  2644\t   data and survives serialization.\"\n  2645\t  [state effect {:keys [park-entry-fns], :as opts}]\n  2646\t  (when-not (module/effect? effect)\n  2647\t    (fail \"Not an effect\" {:reason :not-an-effect}))\n  2648\t  (let [park-entry (get park-entry-fns (:effect effect))\n  2649\t        result\n  2650\t        (case (:effect effect)\n  2651\t          :vm/store-put {:state (put-active state\n  2652\t                                            (store-context state)\n  2653\t                                            (:key effect)\n  2654\t                                            (:val effect)),\n  2655\t                         :value (:val effect),\n  2656\t                         :blocked? false}\n  2657\t          :stream/make\n  2658\t          (let [[id s'] (gensym state \"stream\")\n  2659\t                [stream-ref new-state] (handle-make s' effect id)]\n  2660\t            {:state new-state, :value stream-ref, :blocked? false})\n  2661\t          :stream/cursor\n  2662\t          (let [[id s'] (gensym state \"cursor\")\n  2663\t                [cursor-ref new-state]\n  2664\t                (case (gate-refuse! state effect)\n  2665\t                  :running\n  2666\t                  (handle-cursor-unminted s' effect id (or (:id-counter state) 0))\n  2667\t                  (handle-cursor s' effect id))]\n  2668\t            {:state new-state, :value cursor-ref, :blocked? false})\n  2669\t          :stream/put\n  2670\t          (let [state (pin-refs state (:val effect))\n  2671\t                result (handle-put state effect)]\n  2672\t            (if (:park result)\n  2673\t              (let [built-entry (when park-entry\n  2674\t                                  (park-entry state effect result))\n  2675\t                    built-entry (if (and built-entry (not (:datom built-entry)))\n  2676\t                                  (assoc built-entry :datom (:val effect))\n  2677\t                                  built-entry)]\n  2678\t                (if (and built-entry (= :running (vm/gate-mode state)))\n  2679\t                  (let [[n s'] (issue-number (:state result))]\n  2680\t                    (handle-stream-block\n  2681\t                      (assoc result :state s')\n  2682\t                      (assoc built-entry :yin.k/issue n)))\n  2683\t                  (handle-stream-block result built-entry)))\n  2684\t              {:state (:state result),\n  2685\t               :value (:value result),\n  2686\t               :blocked? false}))\n  2687\t          :stream/next\n  2688\t          (let [result (handle-next state effect)]\n  2689\t            (if (:park result)\n  2690\t              (let [built-entry (when park-entry\n  2691\t                                  (park-entry state effect result))]\n  2692\t                (handle-stream-block result built-entry))\n  2693\t              {:state (:state result),\n  2694\t               :value (:value result),\n  2695\t               :blocked? false}))\n  2696\t          :stream/poll\n  2697\t          (let [result (handle-poll state effect)]\n  2698\t            (if (and (:park result) (= :running (vm/gate-mode state)))\n  2699\t              (let [builder (or (get park-entry-fns :stream/poll)\n  2700\t                                (get park-entry-fns :stream/next))\n  2701\t                    built (when builder (builder state effect result))]\n  2702\t                (handle-stream-block\n  2703\t                  result\n  2704\t                  (when built\n  2705\t                    (assoc built\n  2706\t                           :reason :observe\n  2707\t                           :op :poll\n  2708\t                           :cursor-ref (:cursor-ref result)\n  2709\t                           :stream-id (:stream-id result)))))\n  2710\t              {:state (:state result),\n  2711\t               :value (:value result),\n  2712\t               :blocked? false}))\n  2713\t          :stream/close\n  2714\t          (let [_ (gate-refuse! state effect)\n  2715\t                close-result (handle-close state effect)]\n  2716\t            {:state (:state close-result), :value nil, :blocked? false})\n  2717\t          ;; `:heap` is VM state, not continuation state: a write is seen\n  2718\t          ;; by every holder of the ref and survives continuation invocation\n  2719\t          :cell/new\n  2720\t          (let [[id s'] (gensym (count-allocation state (:val effect)) \"cell\")\n  2721\t                ref (issue-ref s' :cell-ref id)]\n  2722\t            {:state (heap-write s' id (:seal ref) (:val effect)),\n  2723\t             :value ref,\n  2724\t             :blocked? false})\n  2725\t          :cell/get\n  2726\t          (let [id (check-ref! state :cell/get :cell-ref (:cell effect))]\n  2727\t            ;; the content is answered as data, never re-interpreted\n  2728\t            {:state state,\n  2729\t             :value (get-in state [:heap id :value]),\n  2730\t             :blocked? false})\n  2731\t          :cell/set!\n  2732\t          (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n  2733\t            {:state (heap-write state id (get-in state [:heap id :seal])\n  2734\t                                (:val effect)),\n  2735\t             :value (:val effect),\n  2736\t             :blocked? false})\n  2737\t          (let [[id s'] (gensym state \"effect\")\n  2738\t                handler (module/get-effect-handler (:modules state)\n  2739\t                                                   (:effect effect))]\n  2740\t            (if handler\n  2741\t              (handler s' effect (assoc opts :id id))\n  2742\t              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n  2743\t    (update result\n  2744\t            :state\n  2745\t            (fn [result-state]\n  2746\t              (telemetry/emit-snapshot (assoc result-state\n  2747\t                                              :value (:value result))\n  2748\t                                       :effect\n  2749\t                                       {:effect-type (:effect effect)})))))\n  2750\t\n  2751\t\n  2752\t;; =============================================================================\n  2753\t;; Program Cache Machinery\n  2754\t;; =============================================================================\n  2755\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '2138,2200p'; rg -n 'defn.*gate-refuse|defn.*issue-number' src/cljc/yin/vm/engine.cljc; nl -ba src/cljc/yin/vm/ffi.cljc | sed -n '197,224p'; nl -ba src/cljc/yin/vm/module.cljc | sed -n '530,642p'; nl -ba src/cljc/yin/vm/debruijn/register.cljc | sed -n '128,228p'; nl -ba src/cljc/yin/vm/debruijn_register_effects.cljc | sed -n '84,122p;360,386p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '2138,2200p'; rg -n 'defn.*gate-refuse|defn.*issue-number' src/cljc/yin/vm/engine.cljc; nl -ba src/cljc/yin/vm/ffi.cljc | sed -n '197,224p'; nl -ba src/cljc/yin/vm/module.cljc | sed -n '530,642p'; nl -ba src/cljc/yin/vm/debruijn/register.cljc | sed -n '128,228p'; nl -ba src/cljc/yin/vm/debruijn_register_effects.cljc | sed -n '84,122p;360,386p'\"","aggregated_output":"  2138\t   resolved. Waiters sharing a cursor-ref therefore read distinct values —\n  2139\t   the value at the cursor wakes the first, its successor wakes the next —\n  2140\t   instead of every waiter reading the value at the shared pre-poll\n  2141\t   cursor. An entry that stays waiting is retained in its stored,\n  2142\t   resource-id form.\n  2143\t\n  2144\t   Each woken result's `:status` is stamped onto its ready entry, where\n  2145\t   `terminal-resume-outcome` reads it: an outcome the immediate operation\n  2146\t   raises as an error fails the same way when the resume pops it — and a\n  2147\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n  2148\t   there too, before any continuation is restored.\n  2149\t\n  2150\t   The link wait entries `require` adds (yin.vm.linker.md section 7.2) are\n  2151\t   polled first, by the engine rather than the stream sweep: a\n  2152\t   `:link-request` retries its envelope, a `:link-response` advances its\n  2153\t   own kept cursor to the response carrying its id, and an `:install`\n  2154\t   waits on its install child. The install children are then stepped in\n  2155\t   this same round (section 7.3), so a child that halts restores its\n  2156\t   waiters here; nothing about a child runs inside a restore.\n  2157\t\n  2158\t   The FFI response readers are routed next, also outside the stream\n  2159\t   sweep (`poll-ffi-responses`): a response wakes the reader whose call\n  2160\t   id it names, never whichever reader its cell reached first.\n  2161\t\n  2162\t   A gated machine (any `:yin.k/gate`) observes nothing here: no link\n  2163\t   retry or scan, no FFI response read, no put or next retry. Its install\n  2164\t   children are stamped and stepped in `:running` only.\"\n  2165\t  ([state] (check-wait-set state vm/run))\n  2166\t  ([state run-child]\n  2167\t   (let [wait-set (:wait-set state)]\n  2168\t     (if (and (empty? wait-set) (empty? (:installs state)))\n  2169\t       state\n  2170\t       (let [state (poll-links state\n  2171\t                               (filterv link-entry? wait-set)\n  2172\t                               (remove link-entry? wait-set) run-child)\n  2173\t             wait-set (:wait-set state)\n  2174\t             gated? (some? (vm/gate-mode state))\n  2175\t             state (if gated?\n  2176\t                     state\n  2177\t                     (poll-ffi-responses state\n  2178\t                                         (filterv ffi-response-entry? wait-set)\n  2179\t                                         (remove ffi-response-entry?\n  2180\t                                                 wait-set)))\n  2181\t             wait-set (:wait-set state)\n  2182\t             engine-polled? (some-fn link-entry?\n  2183\t                                     ffi-response-entry?\n  2184\t                                     observe-entry?\n  2185\t                                     (fn [e]\n  2186\t                                       (and gated?\n  2187\t                                            (contains? #{:put :next}\n  2188\t                                                       (:reason e)))))\n  2189\t             streams (filterv (complement engine-polled?) wait-set)\n  2190\t             {:keys [woken store], :as result}\n  2191\t             (waitset/check {:waiting streams}\n  2192\t                            waitset-resolver\n  2193\t                            (:resources state))\n  219