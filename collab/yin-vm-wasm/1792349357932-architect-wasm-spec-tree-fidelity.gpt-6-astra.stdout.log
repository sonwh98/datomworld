in.vm.universal-continuation-format.md', [1143])]\n| Control offset [('yin.vm.engine.md', [656])]\nyin.register.host.v1 [('yang.wasm.md', [26, 236, 407]), ('yin.vm.engine.md', [17, 379, 624]), ('yin.vm.debruijn.register.md', [1231])]\n","exit_code":0,"status":"completed"}}
