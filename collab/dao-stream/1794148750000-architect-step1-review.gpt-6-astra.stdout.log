ao.stream/cursor (stream/cursor (:local pending) :dao.stream/newest))\n   448\t                         :foreign (:dao.stream/cursor (stream/cursor foreign :dao.stream/oldest)))\n   449\t                bad (-> pending\n   450\t                        (assoc :after-publish nil)\n   451\t                        (assoc-in [:materialization :cursor] cursor))\n   452\t                _ (reset! reads [])\n   453\t                fixed (repl.index/step bad 4)\n   454\t                f (fixture/frontier fixed)]\n   455\t            (is (some #(= [:cursor :dao.stream/oldest] %) @reads)\n   456\t                (str cursor-kind \" cursor triggers full reconstruction\"))\n   457\t            (is (true? (:published? (repl.index/status fixed))))\n   458\t            (is (= (:manifest (full-publication fixed))\n   459\t                   (index/read-manifest (:content-store fixed) (:manifest-address fixed))))\n   460\t            (testing \"the reconstructed frontier agrees on every gate field\"\n   461\t              (is (= (:manifest-address f) (:manifest-identity f)))\n   462\t              (is (= (:published f) (:transactions f) (:materialized-transactions f)))\n   463\t              (is (= 4 (:branching-factor f)) \"the declared count cap, not a default\")\n   464\t              (is (= (:cursor f) (:newest-cursor f))))))))))\n   465\t\n   466\t\n   467\t(deftest unreadable-dirty-content-and-head-failure-never-promote-the-cursor\n   468\t  ;; Frontier gate: missing content or a failed HEAD write must not\n   469\t  ;; advance the frontier, on either backend (spec section 8).\n   470\t  (doseq [kind fixture/backend-kinds\n   471\t          stage [:content :head]]\n   472\t    (testing (str kind \" \" stage)\n   473\t      (fixture/call-with-backend\n   474\t        kind\n   475\t        (fn [backend]\n   476\t          (let [{:keys [writer observer]} (small-medium 16)\n   477\t                inner (:handle backend)\n   478\t                armed? (atom false)\n   479\t                hidden (atom nil)\n   480\t                heads (atom [])\n   481\t                content-store (assoc inner\n   482\t                                     :put-bytes-fn\n   483\t                                     (fn [address bs]\n   484\t                                       (let [result ((:put-bytes-fn inner) address bs)\n   485\t                                             blob (jing/get inner address nil)]\n   486\t                                         (when (and @armed? (= stage :content)\n   487\t                                                    (map? blob) (contains? blob :keys))\n   488\t                                           (reset! hidden address))\n   489\t                                         result))\n   490\t                                     :get-bytes-fn\n   491\t                                     (fn [address missing]\n   492\t                                       (if (= address @hidden)\n   493\t                                         missing\n   494\t                                         ((:get-bytes-fn inner) address missing))))\n   495\t                write-head! (fn [address]\n   496\t                              (when (and @armed? (= stage :head))\n   497\t                                (throw (ex-info \"HEAD refused\" {})))\n   498\t                              (swap! heads conj address))\n   499\t                initial (repl.index/make-indexer\n   500\t                          {:observer observer :session-token \"failure\"\n   501\t                           :content-store content-store :after-publish write-head!\n   502\t                           :publish-opts {:branching-factor 4}})\n   503\t                _ (stream/append! writer (literal-packet 1))\n   504\t                before (repl.index/step initial 1)\n   505\t                _ (reset! armed? true)\n   506\t                _ (stream/append! writer (literal-packet 2))\n   507\t                failed (repl.index/step before 2)]\n   508\t            (is (false? (:published? (repl.index/status failed))))\n   509\t            (is (= :publish (get-in failed [:failure :stage])))\n   510\t            (is (= (:materialization before) (:materialization failed))\n   511\t                \"failed HEAD persistence must not advance the frontier\")\n   512\t            (is (= (:manifest-address before) (:manifest-address failed)))\n   513\t            (is (= [(:manifest-address before)] @heads))\n   514\t            (reset! armed? false)\n   515\t            (reset! hidden nil)\n   516\t            (stream/append! writer (literal-packet 3))\n   517\t            (let [retried (repl.index/step failed 3)]\n   518\t              (is (true? (:published? (repl.index/status retried))))\n   519\t              (is (nil? (:failure retried)))\n   520\t              (is (= 3 (:published retried)))\n   521\t              (is (= #{1 2 3} (committed-values retried)))\n   522\t              (is (= 2 (count @heads))))))))))\n   523\t\n   524\t\n   525\t(deftest recovery-discards-live-cursors-and-derives-authority-from-history\n   526\t  (doseq [kind fixture/backend-kinds]\n   527\t    (testing (str kind)\n   528\t      (fixture/call-with-backend\n   529\t        kind\n   530\t        (fn [backend]\n   531\t          (let [{:keys [writer observer]} (small-medium 16)\n   532\t                initial (repl.index/make-indexer\n   533\t                          {:observer observer :session-token \"recovery\"\n   534\t                           :content-store (:handle backend)})\n   535\t                _ (stream/append! writer (literal-packet 10))\n   536\t                first-ix (repl.index/step initial 1)\n   537\t                _ (stream/append! writer (literal-packet 20))\n   538\t                second-ix (repl.index/step first-ix 2)\n   539\t                recovery {:manifest (:manifest-address second-ix)\n   540\t                          :datoms (index/snapshot-datoms (:local second-ix))\n   541\t                          ;; No stale process cursor or allocator is recovery authority.\n   542\t                          :materialization (:materialization first-ix)\n   543\t                          :allocator (:allocator first-ix)}\n   544\t                reads (atom [])\n   545\t                recovered (update (repl.index/rehydrate second-ix recovery)\n   546\t                                  :local #(->CountingLocal % reads))\n   547\t                _ (stream/append! writer (literal-packet 30))\n   548\t                resumed (repl.index/step recovered 3)]\n   549\t            (is (nil? (:allocator recovered)))\n   550\t            (is (nil? (:materialization recovered)))\n   551\t            (is (some #(= [:cursor :dao.stream/oldest] %) @reads)\n   552\t                \"restart takes the authoritative full reconstruction path\")\n   553\t            (is (= [0 1 2]\n   554\t                   (mapv (comp :t :dao.space/transaction) (stream-values (:local resumed)))))\n   555\t            (is (= #{10 20 30} (committed-values resumed)))\n   556\t            (is (= (:manifest (full-publication resumed))\n   557\t                   (index/read-manifest (:content-store resumed) (:manifest-address resumed)))\n   558\t                \"the first recovered publication is exactly today's full reconstruction\")))))))\n   559\t\n   560\t\n   561\t(deftest recovery-derives-the-allocator-from-transaction-times-not-record-count\n   562\t  (doseq [kind fixture/backend-kinds]\n   563\t    (testing (str kind)\n   564\t      (fixture/call-with-backend\n   565\t        kind\n   566\t        (fn [backend]\n   567\t          (let [{:keys [writer observer]} (small-medium 16)\n   568\t                initial (repl.index/make-indexer\n   569\t                          {:observer observer :session-token \"watermark\"\n   570\t                           :content-store (:handle backend)})\n   571\t                datoms [[100 :test/value :earlier 7 1] [101 :test/value :later 43 1]]\n   572\t                _ (doseq [d datoms]\n   573\t                    (stream/append! (:local initial)\n   574\t                                    {:dao.space/transaction {:t (nth d 3) :datoms [d]}}))\n   575\t                published (full-publication initial)\n   576\t                recovered (repl.index/rehydrate initial {:manifest (:manifest-address published)\n   577\t                                                         :datoms datoms})\n   578\t                _ (stream/append! writer (literal-packet 99))\n   579\t                resumed (repl.index/step recovered 1)\n   580\t                txs (mapv :dao.space/transaction (stream-values (:local resumed)))]\n   581\t            (is (= [7 43 44] (mapv :t txs)))\n   582\t            (is (= 45 (transactor/watermark (:allocator resumed))))\n   583\t            (is (every? #(<= 102 (first %)) (:datoms (last txs))))\n   584\t            (is (true? (:published? (repl.index/status resumed))))))))))\n   585\t\n   586\t\n   587\t(deftest a-publication-beyond-the-old-intake-bound-completes\n   588\t  (doseq [kind fixture/backend-kinds]\n   589\t    (testing (str kind)\n   590\t      (fixture/call-with-backend\n   591\t        kind\n   592\t        (fn [backend]\n   593\t          (let [{:keys [writer observer]} (small-medium 16)\n   594\t                store (:handle backend)\n   595\t                indexer (repl.index/make-indexer\n   596\t                          {:observer observer\n   597\t                           :session-token \"token\"\n   598\t                           :content-store store\n   599\t                           ;; a small branching factor makes many node blobs\n   600\t                           :publish-opts {:branching-factor 4}})\n   601\t                program (fn [base]\n   602\t                          (macro/ast->packet\n   603\t                            {:type :application\n   604\t                             :operator {:type :variable, :name '+}\n   605\t                             :operands (mapv (fn [i] {:type :literal, :value (+ base i)})\n   606\t                                             (range 300))}))\n   607\t                _ (doseq [base [0 1000 2000 3000]]\n   608\t                    (stream/append! writer (program base)))\n   609\t                ix (repl.index/step indexer 1)\n   610\t                committed (into #{}\n   611\t                                (mapcat (comp :datoms :dao.space/transaction))\n   612\t                                (stream-values (:local ix)))\n   613\t                address (:manifest-address ix)]\n   614\t            (is (< 4096 (:published-payloads ix))\n   615\t                \"one publication exceeds the old 4096-payload ring intake\")\n   616\t            (is (= {:transactions 4 :published? true :lost? false :gaps 0 :failure nil}\n   617\t                   (repl.index/status ix)))\n   618\t            (is (= (count committed) (:count (index/read-manifest store address))))\n   619\t            (is (= committed (set (index/read-datoms store address)))\n   620\t                \"the manifest and every node blob are read back from the store\")))))))\n   621\t\n   622\t\n   623\t(deftest a-publication-failure-is-reported-in-the-round-and-repl-state\n   624\t  (let [broken {:put-bytes-fn (fn [_address _bytes]\n   625\t                                (throw (ex-info \"store refused the write\" {})))\n   626\t                :get-bytes-fn (fn [_address not-found] not-found)}\n   627\t        [state [text again]] (evaluate (repl.frontends/create-state {:index-store broken})\n   628\t                                       [\"(+ 1 2)\" \"(+ 2 3)\"])\n   629\t        status (get-in (repl/repl-state state) [:index])]\n   630\t    (is (str/starts-with? text \"3\\nWarning: \"))\n   631\t    (is (str/includes? text \"materialize failed: store refused the write\")\n   632\t        \"the program's rows are the round's first write (yin.vm.linker.dht.md 5.1)\")\n   633\t    (is (str/starts-with? again \"5\\nWarning: \")\n   634\t        \"each round whose code is not published says so\")\n   635\t    (is (= 2 (:transactions status)) \"the transactions were committed\")\n   636\t    (is (false? (:published? status)))\n   637\t    (is (= :materialize (get-in status [:failure :stage])))\n   638\t    (is (false? (:lost? status)))))\n   639\t\n   640\t\n   641\t;; =============================================================================\n   642\t;; L4: rows every round, and the name transaction\n   643\t;; (docs/design/yin.vm.linker.dht.md 5.1, 6.1)\n   644\t;; =============================================================================\n   645\t\n   646\t(deftest every-row-of-each-evaluated-program-is-in-the-index-store\n   647\t  (doseq [kind fixture/backend-kinds]\n   648\t    (testing (str kind)\n   649\t      (fixture/call-with-state\n   650\t        kind\n   651\t        (fn [shell _backend]\n   652\t          (let [[state _] (evaluate shell\n   653\t                                    [\"(def inc2 (fn [x] (+ x 2)))\" \"(inc2 40)\"])\n   654\t                store (get-in state [:indexer :content-store])\n   655\t                packets (stream-values (:row-stream state))\n   656\t                roots (set (keep (fn [[_ a v]] (when (= :yin.repl/root a) v))\n   657\t                                 (mapcat :datoms (transactions state))))]\n   658\t            (is (= 2 (count packets)))\n   659\t            (is (= roots (set (map first packets)))\n   660\t                \"each program's root address is its :yin.repl/root fact\")\n   661\t            (doseq [packet packets\n   662\t                    [id row] (:rows (macro/packet->row-set packet))]\n   663\t              (is (= (subvec row 1) (jing/get store id nil))\n   664\t                  (str \"row \" id \" is stored under its own address\")))))))))\n   665\t\n   666\t\n   667\t(deftest rows-a-round-could-not-write-are-written-before-any-later-head-moves\n   668\t  (let [broken? (atom true)\n   669\t        heads (atom [])\n   670\t        inner (mem/create-content-mem)\n   671\t        store (assoc inner\n   672\t                     :put-bytes-fn (fn [address bs]\n   673\t                                     (when @broken?\n   674\t                                       (throw (ex-info \"store refused\" {})))\n   675\t                                     ((:put-bytes-fn inner) address bs))\n   676\t                     :head-fn (fn [m] (swap! heads conj m)))\n   677\t        [state [first-text second-text]]\n   678\t        (evaluate (repl.frontends/create-state {:index-store store})\n   679\t                  [\"(def a 4101)\" \"(def b 4102)\"])\n   680\t        packets (stream-values (:row-stream state))]\n   681\t    (testing \"while rows cannot be written, no round publishes and HEAD stays\"\n   682\t      (is (str/includes? first-text \"materialize failed\"))\n   683\t      (is (str/includes? second-text \"materialize failed\"))\n   684\t      (is (= [] @heads))\n   685\t      (is (= 2 (:transactions (repl.index/status (:indexer state))))))\n   686\t    (reset! broken? false)\n   687\t    (let [[state [text]] (evaluate state [\"(def c 4103)\"])\n   688\t          status (repl.index/status (:indexer state))\n   689\t          rows (mapcat (comp vals :rows macro/packet->row-set)\n   690\t                       (stream-values (:row-stream state)))]\n   691\t      (testing \"the next round writes the earlier rows first, then publishes\"\n   692\t        (is (= 3 (count (stream-values (:row-stream state)))))\n   693\t        (is (every? (fn [[id & body]] (= (vec body) (jing/get store id nil))) rows)\n   694\t            \"every committed program's rows are held\")\n   695\t        (is (= 1 (count @heads)) \"one HEAD move, covering all three\")\n   696\t        (is (= 3 (count (filter #(= :yin.repl/root (second %))\n   697\t                                (index/read-datoms store (first @heads))))))\n   698\t        (is (true? (:published? status)))\n   699\t        (is (nil? (:failure status)) \"the materialize failure is recovered\")\n   700\t        (is (str/starts-with? text \"4103\"))\n   701\t        (is (str/includes? text \"rows of earlier rounds are now written\"))))\n   702\t    (is (= 2 (count packets)))))\n   703\t\n   704\t\n   705\t(deftest the-name-envelopes-are-one-transaction-under-the-session-s-metadata\n   706\t  (let [[state _] (evaluate (repl.frontends/create-state) [\"(def f (fn [] 1))\"])\n   707\t        key (sign/generate)\n   708\t        signed [(publish/assertion key {:name 'lib :seq 1\n   709\t                                        :manifest (jing/segment-key \"m\")})]\n   710\t        indexer (repl.index/commit-names (:indexer state) signed 7)\n","exit_code":0,"status":"completed"}}
