 checkout, the checkout uses the pinned\\\\\\\\n    13\\\\\\\\t# SHA regardless.\\\\\\\\n    14\\\\\\\\t#\\\\\\\\n    15\\\\\\\\t# Summary sync: when this host's lanes finish, its summary is pushed to\\\\\\\\n    16\\\\\\\\t# jupiter (and jupiter's is pulled here), so each host's nightly-results\\\\\\\\n    17\\\\\\\\t# holds the full tri-host picture.\\\\\\\\n    18\\\\\\\\tif [ \\\\\\\\\\\\\\\"${NOW:-}\\\\\\\\\\\\\\\" != \\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\" ] && [ \\\\\\\\\\\\\\\"$(TZ=Asia/Ho_Chi_Minh date +%H)\\\\\\\\\\\\\\\" != \\\\\\\\\\\\\\\"03\\\\\\\\\\\\\\\" ]; then\\\\\\\\n    19\\\\\\\\t  exit 0\\\\\\\\n    20\\\\\\\\tfi\\\\\\\\n    21\\\\\\\\t\\\\\\\\n    22\\\\\\\\t# The nightly full suite, this host's share: Node and Dart lanes, against the\\\\\\\\n    23\\\\\\\\t# pinned commit, in this clone. The JVM leg lives on jupiter.\\\\\\\\n    24\\\\\\\\tset -u\\\\\\\\n    25\\\\\\\\texport PATH=\\\\\\\\\\\\\\\"$HOME/.local/bin:$PATH\\\\\\\\\\\\\\\"\\\\\\\\n    26\\\\\\\\tcd ~/ci/datomworld-python-s3 || exit 2\\\\\\\\n    27\\\\\\\\tmise trust >/dev/null 2>&1\\\\\\\\n    28\\\\\\\\teval \\\\\\\\\\\\\\\"$(mise env -s bash)\\\\\\\\\\\\\\\"\\\\\\\\n    29\\\\\\\\tOUT=~/ci/nightly-results; mkdir -p \\\\\\\\\\\\\\\"$OUT\\\\\\\\\\\\\\\"\\\\\\\\n    30\\\\\\\\tSTAMP=$(date +%Y%m%d-%H%M)\\\\\\\\n    31\\\\\\\\tgit fetch -q origin\\\\\\\\n    32\\\\\\\\tSHA=$(git rev-parse origin/master)\\\\\\\\n    33\\\\\\\\techo \\\\\\\\\\\\\\\"$SHA\\\\\\\\\\\\\\\" > ~/ci/nightly-pin.txt\\\\\\\\n    34\\\\\\\\tgit checkout -q --detach \\\\\\\\\\\\\\\"$SHA\\\\\\\\\\\\\\\"\\\\\\\\n    35\\\\\\\\techo \\\\\\\\\\\\\\\"nightly $STAMP at $(git log --oneline -1) (pinned $(date +%H:%M:%S))\\\\\\\\\\\\\\\" > \\\\\\\\\\\\\\\"$OUT/$STAMP-summary.txt\\\\\\\\\\\\\\\"\\\\\\\\n    36\\\\\\\\tbb gen:antlr > \\\\\\\\\\\\\\\"$OUT/$STAMP-gen.log\\\\\\\\\\\\\\\" 2>&1 || { echo \\\\\\\\\\\\\\\"gen failed\\\\\\\\\\\\\\\" >> \\\\\\\\\\\\\\\"$OUT/$STAMP-summary.txt\\\\\\\\\\\\\\\"; exit 1; }\\\\\\\\n    37\\\\