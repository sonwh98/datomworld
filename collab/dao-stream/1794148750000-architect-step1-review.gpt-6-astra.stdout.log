{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/repl/index_test.cljc | sed -n '810,1160p'\"","aggregated_output":"   810\t  (testing \"a healthy round: blobs, read-back, then HEAD names the manifest\"\n   811\t    (let [dir (temp-store-dir)\n   812\t          opened (store/open {:type :file :dir dir})]\n   813\t      (try\n   814\t        (let [[state text] (repl/eval-input\n   815\t                             (repl.frontends/create-state {:index-store opened})\n   816\t                             \"(+ 1 2)\")\n   817\t              manifest (get-in state [:indexer :manifest-address])]\n   818\t          (is (= \"3\" text))\n   819\t          (is (true? (get-in (repl/repl-state state) [:index :published?])))\n   820\t          (is (str/includes? (str (head-text dir)) (str manifest))\n   821\t              \"HEAD names the manifest the round published\"))\n   822\t        (finally\n   823\t          (store/close! opened)\n   824\t          (cleanup-store-dir! dir)))))\n   825\t  (testing \"a round whose manifest cannot be read back writes no HEAD\"\n   826\t    (let [dir (temp-store-dir)\n   827\t          opened (store/open {:type :file :dir dir})]\n   828\t      (try\n   829\t        (let [broken (assoc opened\n   830\t                            :get-bytes-fn (fn [_address _not-found]\n   831\t                                            (throw (ex-info\n   832\t                                                     \"store refused the read\"\n   833\t                                                     {}))))\n   834\t              [state text] (repl/eval-input\n   835\t                             (repl.frontends/create-state {:index-store broken})\n   836\t                             \"(+ 1 2)\")]\n   837\t          (is (str/starts-with? text \"3\\nWarning: \")\n   838\t              \"the round evaluates and says what its publication lost\")\n   839\t          (is (= :publish (get-in (repl/repl-state state)\n   840\t                                  [:index :failure :stage])))\n   841\t          (is (nil? (head-text dir))\n   842\t              \"no manifest read-back, no HEAD — never a HEAD naming an\n   843\t               unreadable snapshot\")\n   844\t          (is (pos? (count (jing.file/records (durable/content-path dir))))\n   845\t              \"the blobs themselves did land\"))\n   846\t        (finally\n   847\t          (store/close! opened)\n   848\t          (cleanup-store-dir! dir)))))\n   849\t  (testing \"a round whose HEAD write fails reports the round unpublished\"\n   850\t    (let [dir (temp-store-dir)\n   851\t          opened (store/open {:type :file :dir dir})]\n   852\t      (try\n   853\t        (let [[first-state _] (repl/eval-input\n   854\t                                (repl.frontends/create-state {:index-store opened})\n   855\t                                \"(+ 1 2)\")\n   856\t              first-manifest (get-in first-state [:indexer :manifest-address])\n   857\t              failing (assoc opened\n   858\t                             :head-fn (fn [_manifest]\n   859\t                                        (throw (ex-info \"disk gone\" {}))))\n   860\t              [second-state text] (repl/eval-input\n   861\t                                    (repl.frontends/create-state {:index-store failing})\n   862\t                                    \"(+ 2 3)\")]\n   863\t          (is (str/starts-with? text \"5\\nWarning: \"))\n   864\t          (is (false? (get-in (repl/repl-state second-state)\n   865\t                              [:index :published?])))\n   866\t          (is (nil? (get-in second-state [:indexer :manifest-address]))\n   867\t              \"the round whose HEAD did not move reports no manifest\")\n   868\t          (is (str/includes? (str (head-text dir)) (str first-manifest))\n   869\t              \"the previous published snapshot keeps the HEAD\"))\n   870\t        (finally\n   871\t          (store/close! opened)\n   872\t          (cleanup-store-dir! dir))))))\n   873\t\n   874\t\n   875\t;; =============================================================================\n   876\t;; Step 1 pins: explicit publication-result expectations (spec sections\n   877\t;; 3, 4 and 8).  Today the engine publishes synchronously through the\n   878\t;; handle's `:head-fn` (`yin.repl.index`'s `:after-publish`, after\n   879\t;; materialize/read-back); Step 2 re-expresses that call as the section 4\n   880\t;; request/result records.  These tests pin the correlation that move\n   881\t;; must preserve: a round's frontier -- manifest identity, published\n   882\t;; transaction count, count-cap compatibility, cursor ownership, and\n   883\t;; expected suffix length -- is promoted exactly once, only for the\n   884\t;; round whose local durable publication succeeded, and never by a\n   885\t;; failed HEAD write, a mismatched policy, or a repeated settlement.\n   886\t;; =============================================================================\n   887\t\n   888\t(deftest frontier-gate-agrees-after-every-round-on-every-backend\n   889\t  (doseq [kind fixture/backend-kinds]\n   890\t    (testing (str kind)\n   891\t      (fixture/call-with-state\n   892\t        kind\n   893\t        (fn [shell _backend]\n   894\t          (let [rounds (reductions\n   895\t                         (fn [[state _] line] (repl/eval-input state line))\n   896\t                         [shell nil]\n   897\t                         [\"(def a 4101)\" \"(def b 4102)\" \"(+ a b)\"])]\n   898\t            (doseq [[i [state _]] (map-indexed vector (rest rounds))]\n   899\t              (testing (str \"after round \" (inc i))\n   900\t                (let [ix (:indexer state)\n   901\t                      f (fixture/frontier ix)\n   902\t                      committed (into #{} (mapcat :datoms) (transactions state))]\n   903\t                  (is (= (:manifest-address f) (:manifest-identity f))\n   904\t                      \"manifest identity: the address is the manifest's content address\")\n   905\t                  (is (= #{:indexes :count :branching-factor}\n   906\t                         (set (keys (:manifest f))))\n   907\t                      \"the manifest schema is exactly {:indexes :count :branching-factor}\")\n   908\t                  (is (= #{:eavt :aevt :avet :vaet}\n   909\t                         (set (keys (:indexes (:manifest f))))))\n   910\t                  (is (= (inc i) (:transactions f) (:published f)\n   911\t                         (:materialized-transactions f))\n   912\t                      \"published transaction count: the frontier covers every committed transaction\")\n   913\t                  (is (= (:count f) (count committed))\n   914\t                      \"the manifest's count is the covered datom count\")\n   915\t                  (is (= (:branching-factor f) (:expected-branching-factor f) 512)\n   916\t                      \"count-cap compatibility: the manifest carries the declared policy's cap\")\n   917\t                  (is (= (:cursor f) (:newest-cursor f))\n   918\t                      \"cursor ownership: the retained cursor is this log's newest cursor\")\n   919\t                  (is (= committed\n   920\t                         (set (index/read-datoms (:content-store ix)\n   921\t                                                 (:manifest-address f))))\n   922\t                      \"the promoted manifest reads back the committed history\")\n   923\t                  (is (true? (:published? (:status f)))))))))))))\n   924\t\n   925\t\n   926\t(deftest publication-requests-are-correlated-settle-once-and-in-order\n   927\t  ;; The composition-side publication interpreter (fixture/observed-backend)\n   928\t  ;; records each durable-publication request the engine emits.  In the\n   929\t  ;; section 4 protocol each record is the request's manifest, correlated\n   930\t  ;; with its round by emission order; a successful local result promotes\n   931\t  ;; exactly that manifest, once.\n   932\t  (doseq [kind fixture/backend-kinds]\n   933\t    (testing (str kind)\n   934\t      (fixture/call-with-backend\n   935\t        kind\n   936\t        (fn [backend]\n   937\t          (let [log (atom [])\n   938\t                backend (fixture/observed-backend backend log)\n   939\t                state (fixture/create-state backend)\n   940\t                [s1 _] (repl/eval-input state \"(def a 4101)\")\n   941\t                m1 (get-in s1 [:indexer :manifest-address])\n   942\t                [s2 _] (repl/eval-input s1 \"(def b 4102)\")\n   943\t                m2 (get-in s2 [:indexer :manifest-address])\n   944\t                [s3 _] (repl/eval-input s2 \"(def c 4103)\")\n   945\t                m3 (get-in s3 [:indexer :manifest-address])]\n   946\t            (is (= [m1 m2 m3] (mapv :manifest @log))\n   947\t                \"one publication request per round, in round order, each naming the manifest its round promoted\")\n   948\t            (is (apply distinct? [m1 m2 m3])\n   949\t                \"each round's publication is a distinct manifest\")\n   950\t            (is (every? #(= (fixture/backend-durability kind) (:durability %)) @log)\n   951\t                \"each result claims only its backend's local durability; network acknowledgement is never claimed\")\n   952\t            (testing \"a step with nothing new settles nothing twice\"\n   953\t              (let [before (fixture/frontier (:indexer s3))\n   954\t                    again (repl.index/step (:indexer s3) 99)\n   955\t                    after (fixture/frontier again)]\n   956\t                (is (= (:manifest-address before) (:manifest-address after)))\n   957\t                (is (= (:materialization before) (:materialization after)))\n   958\t                (is (= 3 (count @log)) \"no second request for a settled frontier\")))))))))\n   959\t\n   960\t\n   961\t(deftest failed-head-persistence-never-advances-the-frontier\n   962\t  ;; Frontier gate (spec section 8): a failed HEAD write is a refused\n   963\t  ;; local publication result.  The prepared manifest may exist in the\n   964\t  ;; store, but the frontier -- manifest, published count, cursor --\n   965\t  ;; stays at the last successful result until a later round succeeds.\n   966\t  ;;\n   967\t  ;; Known pre-existing defect this pin deliberately does not encode:\n   968\t  ;; continuing the *shell* past a refused publication (a successful\n   969\t  ;; round after the failed one) currently throws inside\n   970\t  ;; `yin.repl.index/notice` -- it renders `(name stage)` of the cleared\n   971\t  ;; failure -- and the round rolls back.  That is engine behaviour for\n   972\t  ;; Step 2 to fix, not a contract to pin, so the successful retry below\n   973\t  ;; is pinned at the indexer level, where the existing\n   974\t  ;; unreadable-content pin already proves the same continuation.\n   975\t  (testing \"at the shell: the refused round keeps the previous frontier\"\n   976\t    (doseq [kind fixture/backend-kinds]\n   977\t      (testing (str kind)\n   978\t        (fixture/call-with-backend\n   979\t          kind\n   980\t          (fn [backend]\n   981\t            (let [log (atom [])\n   982\t                  fail? (atom false)\n   983\t                  backend (fixture/failable-backend backend log fail?)\n   984\t                  state (fixture/create-state backend)\n   985\t                  [s1 _] (repl/eval-input state \"(+ 1 2)\")\n   986\t                  f1 (fixture/frontier (:indexer s1))\n   987\t                  _ (reset! fail? true)\n   988\t                  [s2 text2] (repl/eval-input s1 \"(+ 2 3)\")\n   989\t                  f2 (fixture/frontier (:indexer s2))\n   990\t                  head-after-refusal (when (= :file kind)\n   991\t                                       (head-text (:dir backend)))]\n   992\t              (is (true? (:published? (:status f1))))\n   993\t              (is (str/includes? text2 \"Warning: \"))\n   994\t              (is (false? (:published? (:status f2))))\n   995\t              (is (= :publish (get-in s2 [:indexer :failure :stage])))\n   996\t              (is (= (:manifest-address f1) (:manifest-address f2)))\n   997\t              (is (= (:published f1) (:published f2)))\n   998\t              (is (= (:materialization f1) (:materialization f2))\n   999\t                  \"failed HEAD persistence must not advance the frontier\")\n  1000\t              (is (= 2 (count @log)) \"the refused round requested publication once\")\n  1001\t              (is (= (:manifest-address f1) (:manifest (first @log))))\n  1002\t              (when (= :file kind)\n  1003\t                (is (str/includes? (str head-after-refusal)\n  1004\t                                   (str (:manifest-address f1)))\n  1005\t                    \"the durable HEAD still names the last successful manifest\"))))))))\n  1006\t  (testing \"at the indexer: the next successful result promotes the whole suffix\"\n  1007\t    (doseq [kind fixture/backend-kinds]\n  1008\t      (testing (str kind)\n  1009\t        (fixture/call-with-backend\n  1010\t          kind\n  1011\t          (fn [backend]\n  1012\t            (let [{:keys [writer observer]} (small-medium 16)\n  1013\t                  log (atom [])\n  1014\t                  fail? (atom false)\n  1015\t                  write-head! (fn [address]\n  1016\t                                (swap! log conj address)\n  1017\t                                (when @fail?\n  1018\t                                  (throw (ex-info \"HEAD refused\" {}))))\n  1019\t                  initial (repl.index/make-indexer\n  1020\t                            {:observer observer :session-token \"head-failure\"\n  1021\t                             :content-store (:handle backend)\n  1022\t                             :after-publish write-head!\n  1023\t                             :publish-opts {:branching-factor 4}})\n  1024\t                  _ (stream/append! writer (literal-packet 1))\n  1025\t                  ix1 (repl.index/step initial 1)\n  1026\t                  f1 (fixture/frontier ix1)\n  1027\t                  _ (reset! fail? true)\n  1028\t                  _ (stream/append! writer (literal-packet 2))\n  1029\t                  failed (repl.index/step ix1 2)\n  1030\t                  ff (fixture/frontier failed)\n  1031\t                  _ (reset! fail? false)\n  1032\t                  _ (stream/append! writer (literal-packet 3))\n  1033\t                  retried (repl.index/step failed 3)\n  1034\t                  f3 (fixture/frontier retried)]\n  1035\t              (is (false? (:published? (:status ff))))\n  1036\t              (is (= (:manifest-address f1) (:manifest-address ff)))\n  1037\t              (is (= (:materialization f1) (:materialization ff))\n  1038\t                  \"the refused result left the frontier exactly as it was\")\n  1039\t              (is (true? (:published? (:status f3))))\n  1040\t              (is (= 3 (:published f3) (:transactions f3)\n  1041\t                     (:materialized-transactions f3))\n  1042\t                  \"the retry promotes the refused round's suffix with its own\")\n  1043\t              (is (= 3 (count @log)) \"each round requested publication exactly once\")\n  1044\t              (is (= (:manifest-address f1) (first @log)))\n  1045\t              (is (= (:manifest-address f3) (last @log)))\n  1046\t              (is (not= (second @log) (:manifest-address f3))\n  1047\t                  \"the refused round's prepared manifest was never promoted\"))))))))\n  1048\t\n  1049\t\n  1050\t(deftest count-cap-mismatch-rebuilds-instead-of-folding-the-suffix\n  1051\t  ;; Count-cap compatibility (spec sections 5 and 8): suffix reuse is\n  1052\t  ;; permitted only under the same publication policy.  A changed\n  1053\t  ;; `:branching-factor` invalidates the retained frontier, so the next\n  1054\t  ;; publication reconstructs in full and the new manifest carries the\n  1055\t  ;; new cap; the manifest schema itself never changes.\n  1056\t  (doseq [kind fixture/backend-kinds]\n  1057\t    (testing (str kind)\n  1058\t      (fixture/call-with-backend\n  1059\t        kind\n  1060\t        (fn [backend]\n  1061\t          (let [{:keys [writer observer]} (small-medium 16)\n  1062\t                reads (atom [])\n  1063\t                initial (update (repl.index/make-indexer\n  1064\t                                  {:observer observer :session-token \"cap\"\n  1065\t                                   :content-store (:handle backend)\n  1066\t                                   :publish-opts {:branching-factor 4}})\n  1067\t                                :local #(->CountingLocal % reads))\n  1068\t                _ (stream/append! writer (literal-packet 1))\n  1069\t                ix1 (repl.index/step initial 1)\n  1070\t                _ (stream/append! writer (literal-packet 2))\n  1071\t                ix2 (repl.index/step ix1 2)\n  1072\t                _ (reset! reads [])\n  1073\t                _ (stream/append! writer (literal-packet 3))\n  1074\t                ix3 (repl.index/step ix2 3)\n  1075\t                same-policy-reads (vec @reads)\n  1076\t                changed (assoc ix3 :publish-opts {:branching-factor 8})\n  1077\t                _ (reset! reads [])\n  1078\t                _ (stream/append! writer (literal-packet 4))\n  1079\t                ix4 (repl.index/step changed 4)\n  1080\t                f4 (fixture/frontier ix4)]\n  1081\t            (testing \"under the same policy the suffix folds without reopening\"\n  1082\t              (is (not-any? #(= [:cursor :dao.stream/oldest] %) same-policy-reads)\n  1083\t                  \"the same-cap round folded only its suffix\")\n  1084\t              (is (= 4 (:branching-factor (fixture/frontier ix3)))))\n  1085\t            (testing \"under a changed cap the frontier is rebuilt, not folded\"\n  1086\t              (is (some #(= [:cursor :dao.stream/oldest] %) @reads)\n  1087\t                  \"a count-cap mismatch forces full reconstruction\")\n  1088\t              (is (= 8 (:branching-factor f4))\n  1089\t                  \"the new manifest carries the new declared cap\")\n  1090\t              (is (= #{:indexes :count :branching-factor}\n  1091\t                     (set (keys (:manifest f4))))\n  1092\t                  \"the manifest schema is unchanged by the policy change\")\n  1093\t              (is (= 4 (:published f4) (:transactions f4)\n  1094\t                     (:materialized-transactions f4)))\n  1095\t              (is (= (:count f4)\n  1096\t                     (count (index/read-datoms (:content-store ix4)\n  1097\t                                               (:manifest-address f4))))))))))))\n  1098\t\n  1099\t\n  1100\t(deftest the-suffix-folded-is-exactly-the-unpublished-suffix\n  1101\t  ;; Expected suffix length (spec section 8): with a valid frontier, a\n  1102\t  ;; round folds exactly the records past the retained cursor -- here\n  1103\t  ;; two new transactions, read as two hits and one blocked read, with\n  1104\t  ;; no reopening of the covered prefix.\n  1105\t  (doseq [kind fixture/backend-kinds]\n  1106\t    (testing (str kind)\n  1107\t      (fixture/call-with-backend\n  1108\t        kind\n  1109\t        (fn [backend]\n  1110\t          (let [{:keys [writer observer]} (small-medium 16)\n  1111\t                reads (atom [])\n  1112\t                initial (update (repl.index/make-indexer\n  1113\t                                  {:observer observer :session-token \"suffix\"\n  1114\t                                   :content-store (:handle backend)\n  1115\t                                   :publish-opts {:branching-factor 4}})\n  1116\t                                :local #(->CountingLocal % reads))\n  1117\t                _ (stream/append! writer (literal-packet 1))\n  1118\t                ix1 (repl.index/step initial 1)\n  1119\t                _ (stream/append! writer (literal-packet 2))\n  1120\t                ix2 (repl.index/step ix1 2)\n  1121\t                before (fixture/frontier ix2)\n  1122\t                _ (reset! reads [])\n  1123\t                _ (stream/append! writer (literal-packet 3))\n  1124\t                _ (stream/append! writer (literal-packet 4))\n  1125\t                ix3 (repl.index/step ix2 3)\n  1126\t                after (fixture/frontier ix3)]\n  1127\t            (is (= 2 (:materialized-transactions before)))\n  1128\t            (is (= 4 (:materialized-transactions after) (:published after)))\n  1129\t            (is (not-any? #(= [:cursor :dao.stream/oldest] %) @reads)\n  1130\t                \"the covered prefix is never reopened\")\n  1131\t            (is (= 3 (count (filter #(= :next (first %)) @reads)))\n  1132\t                \"exactly the two-record suffix and one blocked read\")))))))\n  1133\t\n  1134\t\n  1135\t(deftest a-settled-frontier-is-not-settled-twice\n  1136\t  ;; Duplicate or stale settlement (spec section 4): only the round that\n  1137\t  ;; materialized and read back its manifest promotes the frontier, and\n  1138\t  ;; only once.  Re-stepping with nothing new requests no second\n  1139\t  ;; publication; a refused name publication commits its transaction\n  1140\t  ;; without promoting the frontier past it.\n  1141\t  (doseq [kind fixture/backend-kinds]\n  1142\t    (testing (str kind)\n  1143\t      (fixture/call-with-backend\n  1144\t        kind\n  1145\t        (fn [backend]\n  1146\t          (let [{:keys [writer observer]} (small-medium 16)\n  1147\t                heads (atom [])\n  1148\t                initial (repl.index/make-indexer\n  1149\t                          {:observer observer :session-token \"settle-once\"\n  1150\t                           :content-store (:handle backend)\n  1151\t                           :after-publish (fn [m] (swap! heads conj m))\n  1152\t                           :publish-opts {:branching-factor 4}})\n  1153\t                _ (stream/append! writer (literal-packet 1))\n  1154\t                ix1 (repl.index/step initial 1)\n  1155\t                f1 (fixture/frontier ix1)\n  1156\t                again (repl.index/step ix1 2)]\n  1157\t            (is (= [(:manifest-address f1)] @heads)\n  1158\t                \"the successful round requested durable publication once\")\n  1159\t            (testing \"re-stepping a settled frontier settles nothing again\"\n  1160\t              (is (= (:materialization f1)\n","exit_code":0,"status":"completed"}}
