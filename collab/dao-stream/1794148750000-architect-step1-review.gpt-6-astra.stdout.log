ending text] (repl/eval-input state \"(require (quote mod))\")]\n     (testing \"a map with no :abandon is out of contract, not an abandon\"\n       (is (str/includes? text \"outside its contract\"))\n       (is (some? (:pending-run pending)))))\n-  (let [state (repl.frontends/create-state\n+  (let [state (prompt-state\n                 {:vm-type :stack\n                  :link-policy (fn [_] {:abandon :reason :extra true})})\n         [pending text] (repl/eval-input state \"(require (quote mod))\")]\n@@ -642,7 +679,7 @@\n \n (deftest reset-and-vm-preserve-the-link-policy-test\n   (let [policy (constantly :keep)\n-        state (repl.frontends/create-state {:vm-type :stack :link-policy policy})\n+        state (prompt-state {:vm-type :stack :link-policy policy})\n         [pending _] (repl/eval-input state \"(require (quote mod))\")\n         [held _] (repl/eval-input pending \"(+ 1 2)\")\n         [held2 _] (repl/eval-input held \"(+ 3 4)\")\n@@ -660,12 +697,12 @@\n \n \n (deftest a-policy-abandon-matches-abandon-s-retained-line-semantics-test\n-  (let [by-command (let [state (repl.frontends/create-state {:vm-type :stack})\n+  (let [by-command (let [state (prompt-state {:vm-type :stack})\n                          [parked _] (repl/eval-input\n                                       state \"(require (quote mod))\")\n                          [held _] (repl/eval-input parked \"(+ 1 2)\")]\n                      (repl/eval-input held \"(abandon)\"))\n-        by-policy (let [state (repl.frontends/create-state\n+        by-policy (let [state (prompt-state\n                                 {:vm-type :stack\n                                  :link-policy (fn [v]\n                                                 (if (= 1 (:checks v))\n@@ -704,7 +741,7 @@\n                                           closed-exports)\n         as-other (:address (publish-module store closed-module 'other\n                                            closed-exports))\n-        state (repl.frontends/create-state\n+        state (prompt-state\n                 {:vm-type :stack\n                  :content-client (silent-client)\n                  :name-env {'other as-other 'mod address}\n@@ -742,7 +779,7 @@\n         store (mem/create-content-mem)\n         {:keys [address]} (publish-module store closed-module 'mod\n                                           closed-exports)\n-        state (repl.frontends/create-state\n+        state (prompt-state\n                 {:vm-type :stack\n                  :content-client (silent-client)\n                  :name-env {'mod address}\n@@ -768,7 +805,7 @@\n    line -- `driver/repl-step` evaluates drained input and nothing else\n    -- so the shell carries the public step an unattended host drives at\n    its own cadence.\"\n-  (let [state (repl.frontends/create-state {:vm-type :stack\n+  (let [state (prompt-state {:vm-type :stack\n                                             :link-policy (constantly :keep)})\n         [pending _] (repl/eval-input state \"(require (quote mod))\")\n         [step1 _] (repl/recheck-pending pending)\n@@ -777,12 +814,12 @@\n       (is (some? (:pending-run step2)))\n       (is (= 2 (:checks (:pending-run step2))))\n       (is (str/includes? text \"pending\")))\n-    (let [empty (repl.frontends/create-state {:vm-type :stack})\n+    (let [empty (prompt-state {:vm-type :stack})\n           [st text] (repl/recheck-pending empty)]\n       (testing \"nothing pending: nothing printed, nothing changed\"\n         (is (nil? text))\n         (is (nil? (:pending-run st))))))\n-  (let [state (repl.frontends/create-state\n+  (let [state (prompt-state\n                 {:vm-type :stack\n                  :link-policy (fn [v]\n                                 (if (= 2 (:checks v))\n@@ -800,6 +837,13 @@\n ;; =============================================================================\n ;; The DHT link source beside the two content sources\n ;; (docs/design/yin.vm.linker.dht.md 4.1, slice L3)\n+;;\n+;; Step 1 isolation (spec section 10, Gate B): this is the one explicitly\n+;; DHT-specific construction test in the retained engine suite.  It is\n+;; composition-side, not part of the non-DHT proof above, and moves with\n+;; the composition tests when Step 2 extracts `yin.repl.dht`; nothing in\n+;; the parameterized tests depends on it.  It stays here, green, until\n+;; that move so the refusal behaviour is never unpinned.\n ;; =============================================================================\n \n (deftest a-dht-source-composes-alone-and-the-content-budget-is-unchanged-test\n@@ -814,7 +858,7 @@\n                         e))))))\n   (testing \"the :content-store and :content-client attempt budget is unchanged\"\n     (is (= 64 link/attempt-budget))\n-    (let [state (repl.frontends/create-state {:vm-type :stack\n+    (let [state (prompt-state {:vm-type :stack\n                                               :content-client (silent-client)\n                                               :name-env {'mod (:address\n                                                                 (publish-module\ndiff --git a/test/yin/repl/store_test.cljc b/test/yin/repl/store_test.cljc\nindex 1f106646..6e5b3935 100644\n--- a/test/yin/repl/store_test.cljc\n+++ b/test/yin/repl/store_test.cljc\n@@ -28,6 +28,7 @@\n             [dao.stream.memory-log :as memory-log]\n             [dao.space.store :as durable]\n             [yin.repl :as repl]\n+            [yin.repl.fixture :as fixture]\n             [yin.repl.frontends :as repl.frontends]\n             [yin.repl.store :as store]\n             [dao.space.store.fs :as fs]))\n@@ -1439,3 +1440,67 @@\n         (store/close! (:index-store durable)))\n       (finally\n         (cleanup-dir! dir)))))\n+\n+\n+;; =============================================================================\n+;; Step 1: the engine over either non-DHT backend (spec section 10,\n+;; Gate B).  The lifecycle tests above pin each backend's own contract;\n+;; this pins the swap itself: the same programs, evaluated through the\n+;; fixture's explicitly injected handles, publish frontiers that agree\n+;; on every Frontier-gate field and cover the same history (modulo the\n+;; per-shell session token each shell mints), with no DHT composition\n+;; anywhere in the shell.\n+;; =============================================================================\n+\n+(defn- modulo-token\n+  \"Datoms with the shell's session token replaced by a placeholder, so\n+   two shells' histories compare equal whatever tokens they minted.\"\n+  [state datoms]\n+  (let [token (:shell-token state)]\n+    (mapv (fn [[e a v t m]] [e a (if (= v token) :session-token v) t m]) datoms)))\n+\n+\n+(deftest the-same-programs-publish-the-same-frontier-on-either-backend\n+  (let [programs [\"(def alpha 1001)\" \"(def beta 2002)\" \"(+ alpha beta)\"]\n+        run (fn [kind]\n+              (fixture/call-with-state\n+                kind\n+                (fn [state backend]\n+                  (let [[state texts] (evaluate state programs)\n+                        f (fixture/frontier (:indexer state))\n+                        committed (into #{}\n+                                        (mapcat :datoms)\n+                                        (transactions state))]\n+                    {:texts texts\n+                     :spec (:index-store-spec state)\n+                     :dht (:dht state)\n+                     :durability-claim (fixture/backend-durability kind)\n+                     :head (when (= :file kind)\n+                             (:manifest (head-record-of (:dir backend))))\n+                     :manifest (:manifest-address f)\n+                     :count (:count f)\n+                     :branching-factor (:branching-factor f)\n+                     :published (:published f)\n+                     :transactions (:transactions f)\n+                     :datoms (set (modulo-token state committed))}))))\n+        memory-run (run :memory)\n+        file-run (run :file)]\n+    (testing \"neither shell composed any DHT state\"\n+      (doseq [r [memory-run file-run]]\n+        (is (nil? (:spec r)) \"no store spec: the handle was injected directly\")\n+        (is (nil? (:dht r)) \"no DHT node, follower, or repair scheduler\")))\n+    (testing \"evaluation and the published frontier agree across the swap\"\n+      (is (= (:texts memory-run) (:texts file-run)))\n+      (is (= \"3003\" (peek (:texts memory-run))))\n+      (is (= (:count memory-run) (:count file-run)))\n+      (is (= 512 (:branching-factor memory-run) (:branching-factor file-run))\n+          \"both publish under the same generic count cap\")\n+      (is (= 3 (:published memory-run) (:transactions memory-run)\n+               (:published file-run) (:transactions file-run)))\n+      (is (= (:datoms memory-run) (:datoms file-run))\n+          \"the covered history is the same history on either backend\")\n+      (is (= (:manifest file-run) (:head file-run))\n+          \"the file backend's durable HEAD names its promoted manifest\")\n+      (is (= :memory (:durability-claim memory-run)))\n+      (is (= :persistent (:durability-claim file-run))\n+          \"only the file composition claims persistence (spec section 4)\"))))\n     1\t(ns yin.repl.fixture\n     2\t  \"Step 1 non-DHT composition fixture (docs/design/yin.repl.dht-composition.md\n     3\t   sections 8-10, Gate B): the common test constructor the retained engine\n     4\t   suite is parameterized over.  It injects an explicit `dao.jing` byte\n     5\t   handle into `yin.repl.frontends/create-state` -- never a store spec that\n     6\t   could resolve to DHT -- in two backend selections:\n     7\t\n     8\t   - `:memory` -- `dao.jing.mem/create-content-mem`, ephemeral.  Local\n     9\t     publication completion is acknowledged without claiming persistence\n    10\t     (spec section 4: `:durability :memory`).\n    11\t   - `:file` -- `dao.space.store/open` over a scratch directory, which\n    12\t     wraps `dao.jing.file/create-content-file` and supplies locking, the\n    13\t     atomic HEAD write (`:head-fn`), and validated recovery.  Local\n    14\t     publication is durable only when that HEAD write succeeds\n    15\t     (`:durability :persistent`).\n    16\t\n    17\t   The fixture owns the publication interpreter the spec assigns to\n    18\t   composition: `observed-backend` / `failable-backend` wrap the handle's\n    19\t   `:head-fn` -- the durable-publication request the engine emits today\n    20\t   through `yin.repl.index`'s `:after-publish`, after content materialized\n    21\t   and read back -- and record each request's manifest with its local\n    22\t   result (returned = published, thrown = refused).  Step 2 re-expresses\n    23\t   the same correlation as the section 4 request/result stream records\n    24\t   (`{:op :publish ...}` / `{:op :publication-result ...}`); the frontier\n    25\t   expectations pinned through this fixture are stated so they survive\n    26\t   that move unchanged.\n    27\t\n    28\t   This namespace requires no DHT namespace (`dao.jing.dht`,\n    29\t   `dao.space.dht`, `yin.repl.dht`, `yin.vm.linker.dht`): engine tests\n    30\t   built on it construct no DHT node, socket, follower, or repair\n    31\t   scheduler.  (`yin.repl` itself still loads the DHT composition today;\n    32\t   removing that load is Step 2, gated by Gate A.)\"\n    33\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n    34\t            [dao.jing :as jing]\n    35\t            [dao.jing.mem :as mem]\n    36\t            [dao.space.index :as index]\n    37\t            [dao.space.store :as durable]\n    38\t            [dao.stream :as stream]\n    39\t            [yin.repl.frontends :as repl.frontends]\n    40\t            [yin.repl.index :as repl.index]))\n    41\t\n    42\t\n    43\t(def backend-kinds\n    44\t  \"The non-DHT backend selections every parameterized engine test runs.\"\n    45\t  [:memory :file])\n    46\t\n    47\t\n    48\t(defn backend-durability\n    49\t  \"The local durability a successful publication claims on `kind`\n    50\t   (spec section 4): the memory composition never claims persistence.\"\n    51\t  [kind]\n    52\t  (case kind\n    53\t    :memory :memory\n    54\t    :file :persistent))\n    55\t\n    56\t\n    57\t;; =============================================================================\n    58\t;; Scratch directories (host-portable, as in yin.repl.store-test)\n    59\t;; =============================================================================\n    60\t\n    61\t(defn temp-dir\n    62\t  \"A fresh scratch directory path for a `:file` backend.\"\n    63\t  []\n    64\t  (str \"target/test-fixture-\" (random-uuid)))\n    65\t\n    66\t\n    67\t(defn cleanup-dir!\n    68\t  \"Best-effort recursive removal of a scratch directory.\"\n    69\t  [dir]\n    70\t  (when dir\n    71\t    #?(:cljd (try (.deleteSync (dart-io/Directory. dir) .recursive true)\n    72\t                  (catch Object _ nil))\n    73\t       :clj (let [f (java.io.File. ^String dir)]\n    74\t              (when (.isDirectory f)\n    75\t                (doseq [child (.listFiles f)]\n    76\t                  (.delete ^java.io.File child))\n    77\t                (.delete f)))\n    78\t       :cljs (try (.rmSync (js/require \"fs\") dir #js {:recursive true :force true})\n    79\t                  (catch :default _ nil)))))\n    80\t\n    81\t\n    82\t;; =============================================================================\n    83\t;; Backends: open / close / call-with\n    84\t;; =============================================================================\n    85\t\n    86\t(defn open-backend\n    87\t  \"Open the non-DHT backend `kind` (`:memory` or `:file`) as a backend\n    88\t   value `{:kind :handle :dir :durability}`.  `opts` may carry\n    89\t   `:publish-opts` (the immutable generic publication policy, spec\n    90\t   section 5 -- threaded onto the handle where `yin.repl/make-session`\n    91\t   reads it) and, for `:file`, an explicit `:dir`.\n    92\t\n    93\t   The handle is a plain `dao.jing` byte handle in both selections; the\n    94\t   file selection additionally carries `:head-fn` and `:recovery` from\n    95\t   `dao.space.store/open`.  No selection constructs DHT state.\"\n    96\t  ([kind] (open-backend kind {}))\n    97\t  ([kind {:keys [publish-opts dir]}]\n    98\t   (case kind\n    99\t     :memory (let [handle (cond-> (mem/create-content-mem)\n   100\t                            publish-opts (assoc :publish-opts publish-opts))]\n   101\t               {:kind :memory :handle handle :dir nil\n   102\t                :durability :memory})\n   103\t     :file (let [dir (or dir (temp-dir))\n   104\t                 opened (durable/open dir)\n   105\t                 handle (cond-> opened\n   106\t                          publish-opts (assoc :publish-opts publish-opts))]\n   107\t             {:kind :file :handle handle :dir dir\n   108\t              :durability :persistent}))))\n   109\t\n   110\t\n   111\t(defn close-backend!\n   112\t  \"Close a backend's handle (releasing a file backend's directory lock)\n   113\t   and remove its scratch directory.  Idempotent in effect: a second\n   114\t   close of a content handle is refused by nothing here.\"\n   115\t  [{:keys [handle dir]}]\n   116\t  (when-let [close! (:close-fn handle)]\n   117\t    (try (close!) (catch #?(:cljd Object :clj Exception :cljs :default) _ nil)))\n   118\t  (cleanup-dir! dir)\n   119\t  nil)\n   120\t\n   121\t\n   122\t(defn call-with-backend\n   123\t  \"Open backend `kind`, call `(f backend)`, and close the backend even\n   124\t   when `f` throws.  Answers `f`'s value; anything a test needs from the\n   125\t   store must be read inside `f`, before the close.\"\n   126\t  ([kind f] (call-with-backend kind {} f))\n   127\t  ([kind opts f]\n   128\t   (let [backend (open-backend kind opts)]\n   129\t     (try (f backend)\n   130\t          (finally (close-backend! backend))))))\n   131\t\n   132\t\n   133\t;; =============================================================================\n   134\t;; The common test constructor (Gate B's injection point)\n   135\t;; =============================================================================\n   136\t\n   137\t(defn create-state\n   138\t  \"A shell over `backend`'s explicitly injected `dao.jing` handle, plus\n   139\t   `opts` for `yin.repl.frontends/create-state` (`:vm-type`,\n   140\t   `:content-store`, `:name-env`, ...).  This is Gate B's constructor:\n   141\t   the proof never relies on the default memory construction, and no\n   142\t   `:index-store-spec` -- the only path that can name DHT -- is used.\"\n   143\t  ([backend] (create-state backend {}))\n   144\t  ([backend opts]\n   145\t   (repl.frontends/create-state (merge {:index-store (:handle backend)} opts))))\n   146\t\n   147\t\n   148\t(defn call-with-state\n   149\t  \"Open backend `kind`, build a shell over it with `opts`, call\n   150\t   `(f state backend)`, and close the backend afterwards.\"\n   151\t  ([kind f] (call-with-state kind {} f))\n   152\t  ([kind opts f]\n   153\t   (call-with-backend kind (fn [backend] (f (create-state backend opts) backend)))))\n   154\t\n   155\t\n   156\t;; =============================================================================\n   157\t;; Publication observation: the composition-side interpreter (Step 1 form)\n   158\t;; =============================================================================\n   159\t\n   160\t(defn observed-backend\n   161\t  \"Backend whose durable-publication requests are recorded in `log` (an\n   162\t   atom of vectors): each `:head-fn` call appends\n   163\t   `{:manifest address :durability d}` *before* delegating, so a request\n   164\t   is visible even when its result is a refusal.  A memory backend has\n   165\t   no `:head-fn` today; observing one installs a recording writer that\n   166\t   acknowledges local completion in memory only -- it never makes the\n   167\t   ephemeral store claim persistence.\"\n   168\t  [backend log]\n   169\t  (let [handle (:handle backend)\n   170\t        inner (:head-fn handle)\n   171\t        durability (:durability backend)]\n   172\t    (assoc backend :handle\n   173\t           (assoc handle :head-fn\n   174\t                  (fn [manifest-address]\n   175\t                    (swap! log conj {:manifest manifest-address\n   176\t                                     :durability durability})\n   177\t                    (when inner (inner manifest-address)))))))\n   178\t\n   179\t\n   180\t(defn failable-backend\n   181\t  \"Like `observed-backend`, but while `fail?` (an atom) holds true the\n   182\t   HEAD write throws instead of delegating: a failed durable-publication\n   183\t   result.  Requests are still recorded (as attempts the composition\n   184\t   refused to complete); tests distinguish attempts from successes by\n   185\t   comparing the log against the indexer's promoted frontier.\"\n   186\t  [backend log fail?]\n   187\t  (let [handle (:handle backend)\n   188\t        inner (:head-fn handle)\n   189\t        durability (:durability backend)]\n   190\t    (assoc backend :handle\n   191\t           (assoc handle :head-fn\n   192\t                  (fn [manifest-address]\n   193\t                    (swap! log conj {:manifest manifest-address\n   194\t                                     :durability durability})\n   195\t                    (when @fail?\n   196\t                      (throw (ex-info \"HEAD refused\" {})))\n   197\t                    (when inner (inner manifest-address)))))))\n   198\t\n   199\t\n   200\t;; =============================================================================\n   201\t;; Frontier reading (spec section 8, Frontier gate)\n   202\t;; =============================================================================\n   203\t\n   204\t(defn stream-values\n   205\t  \"Every value currently on stream `s`, read from its oldest cursor.\"\n   206\t  [s]\n   207\t  (loop [cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   208\t         acc []]\n   209\t    (let [r (stream/next s cursor)]\n   210\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n   211\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n   212\t        acc))))\n   213\t\n   214\t\n   215\t(defn transactions\n   216\t  \"The transaction records an indexer committed, oldest first.\"\n   217\t  [indexer]\n   218\t  (mapv :dao.space/transaction (stream-values (:local indexer))))\n   219\t\n   220\t\n   221\t(defn expected-branching-factor\n   222\t  \"The count cap `indexer` publishes under: its declared publication\n   223\t   policy's `:branching-factor`, defaulting to 512 as the engine does.\n   224\t   A manifest is count-cap compatible only when its own\n   225\t   `:branching-factor` equals this (spec sections 5 and 8).\"\n   226\t  [indexer]\n   227\t  (:branching-factor (:publish-opts indexer) 512))\n   228\t\n   229\t\n   230\t(defn frontier\n   231\t  \"The indexer's verified published frontier as plain data, with the\n   232\t   manifest read back from its content store: everything the Frontier\n   233\t   gate (spec section 8) requires to agree -- manifest identity,\n   234\t   published transaction count, count-cap compatibility, cursor\n   235\t   ownership, and coverage.  `:manifest` is nil before any publication.\"\n   236\t  [indexer]\n   237\t  (let [address (:manifest-address indexer)\n   238\t        manifest (when address\n   239\t                   (index/read-manifest (:content-store indexer) address))]\n   240\t    {:manifest-address address\n   241\t     :manifest manifest\n   242\t     :manifest-identity (when manifest (jing/segment-key manifest))\n   243\t     :count (:count manifest)\n   244\t     :branching-factor (:branching-factor manifest)\n   245\t     :expected-branching-factor (expected-branching-factor indexer)\n   246\t     :published (:published indexer)\n   247\t     :transactions (:transactions indexer)\n   248\t     :materialization (:materialization indexer)\n   249\t     :materialized-transactions (get-in indexer [:materialization :transactions])\n   250\t     :cursor (get-in indexer [:materialization :cursor])\n   251\t     :newest-cursor (:dao.stream/cursor\n   252\t                      (stream/cursor (:local indexer) :dao.stream/newest))\n   253\t     :status (repl.index/status indexer)}))\n","exit_code":0,"status":"completed"}}
