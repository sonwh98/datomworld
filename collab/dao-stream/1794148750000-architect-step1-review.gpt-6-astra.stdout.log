re-written-before-any-later-head-moves\n@@ -795,3 +870,305 @@\n         (finally\n           (store/close! opened)\n           (cleanup-store-dir! dir))))))\n+\n+\n+;; =============================================================================\n+;; Step 1 pins: explicit publication-result expectations (spec sections\n+;; 3, 4 and 8).  Today the engine publishes synchronously through the\n+;; handle's `:head-fn` (`yin.repl.index`'s `:after-publish`, after\n+;; materialize/read-back); Step 2 re-expresses that call as the section 4\n+;; request/result records.  These tests pin the correlation that move\n+;; must preserve: a round's frontier -- manifest identity, published\n+;; transaction count, count-cap compatibility, cursor ownership, and\n+;; expected suffix length -- is promoted exactly once, only for the\n+;; round whose local durable publication succeeded, and never by a\n+;; failed HEAD write, a mismatched policy, or a repeated settlement.\n+;; =============================================================================\n+\n+(deftest frontier-gate-agrees-after-every-round-on-every-backend\n+  (doseq [kind fixture/backend-kinds]\n+    (testing (str kind)\n+      (fixture/call-with-state\n+        kind\n+        (fn [shell _backend]\n+          (let [rounds (reductions\n+                         (fn [[state _] line] (repl/eval-input state line))\n+                         [shell nil]\n+                         [\"(def a 4101)\" \"(def b 4102)\" \"(+ a b)\"])]\n+            (doseq [[i [state _]] (map-indexed vector (rest rounds))]\n+              (testing (str \"after round \" (inc i))\n+                (let [ix (:indexer state)\n+                      f (fixture/frontier ix)\n+                      committed (into #{} (mapcat :datoms) (transactions state))]\n+                  (is (= (:manifest-address f) (:manifest-identity f))\n+                      \"manifest identity: the address is the manifest's content address\")\n+                  (is (= #{:indexes :count :branching-factor}\n+                         (set (keys (:manifest f))))\n+                      \"the manifest schema is exactly {:indexes :count :branching-factor}\")\n+                  (is (= #{:eavt :aevt :avet :vaet}\n+                         (set (keys (:indexes (:manifest f))))))\n+                  (is (= (inc i) (:transactions f) (:published f)\n+                         (:materialized-transactions f))\n+                      \"published transaction count: the frontier covers every committed transaction\")\n+                  (is (= (:count f) (count committed))\n+                      \"the manifest's count is the covered datom count\")\n+                  (is (= (:branching-factor f) (:expected-branching-factor f) 512)\n+                      \"count-cap compatibility: the manifest carries the declared policy's cap\")\n+                  (is (= (:cursor f) (:newest-cursor f))\n+                      \"cursor ownership: the retained cursor is this log's newest cursor\")\n+                  (is (= committed\n+                         (set (index/read-datoms (:content-store ix)\n+                                                 (:manifest-address f))))\n+                      \"the promoted manifest reads back the committed history\")\n+                  (is (true? (:published? (:status f)))))))))))))\n+\n+\n+(deftest publication-requests-are-correlated-settle-once-and-in-order\n+  ;; The composition-side publication interpreter (fixture/observed-backend)\n+  ;; records each durable-publication request the engine emits.  In the\n+  ;; section 4 protocol each record is the request's manifest, correlated\n+  ;; with its round by emission order; a successful local result promotes\n+  ;; exactly that manifest, once.\n+  (doseq [kind fixture/backend-kinds]\n+    (testing (str kind)\n+      (fixture/call-with-backend\n+        kind\n+        (fn [backend]\n+          (let [log (atom [])\n+                backend (fixture/observed-backend backend log)\n+                state (fixture/create-state backend)\n+                [s1 _] (repl/eval-input state \"(def a 4101)\")\n     1\t# Step 1 Findings: Invariant Pins & Non-DHT Fixture Parameterization\n     2\t\n     3\tCreated-GMT: 2026-11-08 14:38:30 GMT\n     4\tCreated-Local: 2026-11-08 21:38:30 +07\n     5\tCoding-Agent: muse\n     6\tModel: muse-wonder-1.0\n     7\tSession-ID: e8c6e6a5-b58b-45ac-914b-a696f4512f9e\n     8\t\n     9\t## Summary of Deliverable\n    10\tStep 1 of the refactor sequence (docs/design/yin.repl.dht-composition.md §9) is complete. Existing invariants are green and publication-result expectations are explicit. All changes are strictly isolated to `test/yin/repl/` without touching `src/`.\n    11\t\n    12\t## Changes Made\n    13\t- `test/yin/repl/fixture.cljc` (new, 212 lines): Common test constructor providing explicitly injected non-DHT storage backends (`:memory` via `dao.jing.mem`, `:file` via `dao.space.store/open`), publication interpreter wrappers (`observed-backend`, `failable-backend`), and `frontier` extraction.\n    14\t- `test/yin/repl/index_test.cljc`: Decisive publication/frontier/recovery tests parameterized over both backends, plus 6 new pins: frontier-gate agreement after every round, correlated settle-once publication requests, failed-HEAD never advancing the frontier, count-cap mismatch forcing full reconstruction, exact suffix length, and no double settlement.\n    15\t- `test/yin/repl/require_test.cljc`: `shell` and `require-and-apply` parameterized over injected backend; causality/policy tests use explicit memory injection via `prompt-state`.\n    16\t- `test/yin/repl/query_test.cljc`: All shells built through fixture; settlement tests and basic answer tests run across VMs and backends.\n    17\t- `test/yin/repl/store_test.cljc`: Cross-backend proof verifying agreeing frontiers and identical history with `:dht` and `:index-store-spec` both nil.\n    18\t\n    19\t## Verified Test Assertions (JVM Focused)\n    20\t- `yin.repl.index-test`: 27 tests, 569 assertions, 0 failures (baseline: 21 tests, 242 assertions).\n    21\t- `yin.repl.require-test`: 20 tests, 209 assertions, 0 failures (baseline: 20 tests, 172 assertions).\n    22\t- `yin.repl.query-test`: 18 tests, 279 assertions, 0 failures (baseline: 18 tests, 246 assertions).\n    23\t- `yin.repl.store-test`: 28 tests, 145 assertions, 0 failures (baseline: 27 tests, 132 assertions).\n","exit_code":0,"status":"completed"}}
