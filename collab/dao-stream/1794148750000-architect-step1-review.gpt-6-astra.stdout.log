    (unsatisfied (cell-identity cells cid))))\\\\n   498\\\\t\\\\n   499\\\\t    :put\\\\n   500\\\\t    (if-let [sid (streams (get-in pending [:yin.k/stream\\\\n   501\\\\t                                           :dao.stream/identity]))]\\\\n   502\\\\t      {:entry (merge ctx\\\\n   503\\\\t                     {:reason :put,\\\\n   504\\\\t                      :stream-id sid,\\\\n   505\\\\t                      :datom (:yin.k/value pending)})}\\\\n   506\\\\t      (unsatisfied (get-in pending [:yin.k/stream :dao.stream/identity])))\\\\n   507\\\\t\\\\n   508\\\\t    :ffi\\\\n   509\\\\t    (let [cid (:yin.k/cell pending)]\\\\n   510\\\\t      (if-let [sid (streams (cell-identity cells cid))]\\\\n   511\\\\t        {:entry (merge ctx\\\\n   512\\\\t                       (cond-> {:reason :next,\\\\n   513\\\\t                                :call-id (:yin.k/call-id pending),\\\\n   514\\\\t                                :stream-id sid,\\\\n   515\\\\t                                :cursor-ref {:type :cursor-ref, :id cid}}\\\\n   516\\\\t                         (contains? pending :yin.k/op)\\\\n   517\\\\t                         (assoc :op (:yin.k/op pending))))}\\\\n   518\\\\t        (unsatisfied (cell-identity cells cid))))\\\\n   519\\\\t\\\\n   520\\\\t    :ffi-request\\\\n   521\\\\t    (if-let [sid (streams (get-in pending [:yin.k/request\\\\n   522\\\\t                                           :dao.stream/identity]))]\\\\n   523\\\\t      {:entry (merge ctx\\\\n   524\\\\t                     {:reason :put,\\\\n   525\\\\t                      :request-sent true,\\\\n   526\\\\t                      :call-id (:yin.k/call-id pending),\\\\n   527\\\\t                      :op (:yin.k/request-op pending),\\\\n   528\\\\t                      :stream-id sid,\\\\n   529\\\\t                      :datom (apply2/request (:yin.k/call-id pending)\\\\n   530\\\\t                                             (:yin.k/request-op pending)\\\\n   531\\\\t                                             (:yin.k/request-args\\\\n   532\\\\t                                               pending))})}\\\\n   533\\\\t      (unsatisfied (get-in pending [:yin.k/request :dao.stream/identity])))\\\\n   534\\\\t\\\\n   535\\\\t    (:link-request :link-response)\\\\n   536\\\\t    (let [reason (:yin.k/reason pending)\\\\n   537\\\\t          cid (:yin.k/cell pending)\\\\n   538\\\\t          sid (streams (cell-identity cells cid))\\\\n   539\\\\t          req (streams (get-in pending [:yin.k/request\\\\n   540\\\\t                                        :dao.stream/identity]))]\\\\n   541\\\\t      (if (and sid req)\\\\n   542\\\\t        {:entry (merge ctx\\\\n   543\\\\t                       (cond-> {:reason reason,\\\\n   544\\\\t                                :link-id (:yin.k/link-id pending),\\\\n   545\\\\t                                :name (:yin.k/name pending),\\\\n   546\\\\t                                :request req,\\\\n   547\\\\t                                :response sid,\\\\n   548\\\\t                                :cursor (:yin.k/position (get cells cid))}\\\\n   549\\\\t                         (= :link-request reason)\\\\n   550\\\\t                         (assoc :envelope (:yin.k/envelope pending))))}\\\\n   551\\\\t        (unsatisfied (cell-identity cells cid))))\\\\n   552\\\\t\\\\n   553\\\\t    :install\\\\n   554\\\\t    {:entry (merge ctx\\\\n   555\\\\t                   {:reason :install, :name (:yin.k/name pending)})}\\\\n   556\\\\t\\\\n   557\\\\t    {:yin.k/status :yin.k/undecodable,\\\\n   558\\\\t     :yin.k/reason (:yin.k/reason pending)}))\\\\n   559\\\\t\\\\n   560\\\\t\\\\n   561\\\\t(defn lower-frame\\\\n   562\\\\t  \\\\\\\"A whole frame set of S7.4.3 pendings, lowered together:\\\\n   563\\\\t   `{:entries [e ...], :resources table}` -- one fresh stream entry\\\\n   564\\\\t   per distinct served identity and one fresh cursor entry per\\\\n   565\\\\t   distinct UCF cell, two waiters on o