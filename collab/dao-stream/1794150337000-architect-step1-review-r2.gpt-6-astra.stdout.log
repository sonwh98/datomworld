efore (fixture/frontier (:indexer s3))\n   979\t                    again (repl.index/step (:indexer s3) 99)\n   980\t                    after (fixture/frontier again)]\n   981\t                (is (= (:manifest-address before) (:manifest-address after)))\n   982\t                (is (= (:materialization before) (:materialization after)))\n   983\t                (is (= 3 (count @log)) \"no second request for a settled frontier\")))))))))\n   984\t\n   985\t\n   986\t(deftest failed-head-persistence-never-advances-the-frontier\n   987\t  ;; Synchronous pin, refusal case (spec sections 4 and 8): a failed\n   988\t  ;; HEAD write is a refused local publication result.  The prepared\n   989\t  ;; manifest may exist in the store, but the frontier -- manifest,\n   990\t  ;; published count, cursor -- stays at the last successful result\n   991\t  ;; until a later round succeeds.  The shell continuation past that\n   992\t  ;; refusal is the known defect retained as a failing acceptance pin\n   993\t  ;; in `shell-retry-after-refused-publication-promotes-the-whole-suffix`\n   994\t  ;; below; the indexer continuation here stays the narrower green\n   995\t  ;; oracle, as the unreadable-content pin already proves it.\n   996\t  (testing \"at the shell: the refused round keeps the previous frontier\"\n   997\t    (doseq [kind fixture/backend-kinds]\n   998\t      (testing (str kind)\n   999\t        (fixture/call-with-backend\n  1000\t          kind\n  1001\t          (fn [backend]\n  1002\t            (let [log (atom [])\n  1003\t                  fail? (atom false)\n  1004\t                  backend (fixture/failable-backend backend log fail?)\n  1005\t                  state (fixture/create-state backend)\n  1006\t                  [s1 _] (repl/eval-input state \"(+ 1 2)\")\n  1007\t                  f1 (fixture/frontier (:indexer s1))\n  1008\t                  _ (reset! fail? true)\n  1009\t                  [s2 text2] (repl/eval-input s1 \"(+ 2 3)\")\n  1010\t       