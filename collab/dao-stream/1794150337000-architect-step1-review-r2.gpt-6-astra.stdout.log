\n   782\t\n   783\t\n   784\t(defn- cleanup-store-dir!\n   785\t  [dir]\n   786\t  #?(:cljd (try (.deleteSync (dart-io/Directory. dir) .recursive true)\n   787\t                (catch Object _ nil))\n   788\t     :clj (let [f (java.io.File. ^String dir)]\n   789\t            (when (.isDirectory f)\n   790\t              (doseq [child (.listFiles f)]\n   791\t                (.delete ^java.io.File child))\n   792\t              (.delete f)))\n   793\t     :cljs (try (.rmSync (js/require \"fs\") dir #js {:recursive true :force true})\n   794\t                (catch :default _ nil))))\n   795\t\n   796\t\n   797\t(defn- head-text\n   798\t  [dir]\n   799\t  #?(:cljd (let [f (dart-io/File. (str dir \"/HEAD\"))]\n   800\t             (when (.existsSync f) (.readAsStringSync f)))\n   801\t     :clj (let [f (java.io.File. (str dir \"/HEAD\"))]\n   802\t            (when (.exists f) (slurp f)))\n   803\t     :cljs (let [fs (js/require \"fs\")\n   804\t                 path (str dir \"/HEAD\")]\n   805\t             (when (.existsSync fs path)\n   806\t               (.readFileSync fs path \"utf8\")))))\n   807\t\n   808\t\n   809\t(deftest a-durable-round-writes-head-only-after-the-manifest-read-back\n   810\t  (testing \"a healthy round: blobs, read-back, then HEAD names the manifest\"\n   811\t    (let [dir (temp-store-dir)\n   812\t          opened (store/open {:type :file :dir dir})]\n   813\t      (try\n   814\t        (let [[state text] (repl/eval-input\n   815\t                             (repl.frontends/create-state {:index-store opened})\n   816\t                             \"(+ 1 2)\")\n   817\t              manifest (get-in state [:indexer :manifest-address])]\n   818\t          (is (= \"3\" text))\n   819\t          (is (true? (get-in (repl/repl-state state) [:index :published?])))\n   820\t          (is (str/includes? (str (head-text dir)) (str manifest))\n   821\t              \"HEAD names the manifest the round published\"))\n   822\t        (finally\n   823\t          (store/close! opened)\n   824\t          (cleanup-store-dir! dir)))))\n   825\t  (testing \"a round whose manifest cannot be read back writes no HEAD\"\n   826\t    (let [dir (temp-store-dir)\n   827\t          opened (store/open {:type :file :dir dir})]\n   828\t      (try\n   829\t        (let [broken (assoc opened\n   830\t                            :get-bytes-fn (fn [_address _not-found]\n   831\t                                            (throw (ex-info\n   832\t                                                     \"store refused the read\"\n   833\t                                                     {}))))\n   834\t              [state text] (repl/eval-input\n   835\t                             (repl.frontends/create-state {:index-store broken})\n   836\t                             \"(+ 1 2)\")]\n   837\t          (is (str/starts-with? text \"3\\nWarning: \")\n   838\t              \"the round evaluates and says what its publication lost\")\n   839\t          (is (= :publish (get-in (repl/repl-state state)\n   840\t                                  [:index :failure :stage])))\n   841\t          (is (nil? (head-text dir))\n   842\t              \"no manifest read-back, no HEAD — never a HEAD naming an\n   843\t               unreadable snapshot\")\n   844\t          (is (pos? (count (jing.file/records (durable/content-path dir))))\n   845\t              \"the blobs themselves did land\"))\n   846\t        (finally\n   847\t          (store/close! opened)\n   848\t          (cleanup-store-dir! dir)))))\n   849\t  (testing \"a round whose HEAD write fails reports the round unpublished\"\n   850\t    (let [dir (temp-store-dir)\n   851\t          opened (store/open {:type :file :dir dir})]\n   852\t      (try\n   853\t        (let [[first-state _] (repl/eval-input\n   854\t                                (repl.frontends/create-state {:index-store opened})\n   855\t                                \"(+ 1 2)\")\n   856\t              first-manifest (get-in first-state [:indexer :manifest-address])\n   857\t              failing (assoc opened\n   858\t                             :head-fn (fn [_manifest]\n   859\t                                        (throw (ex-info \"disk gone\" {}))))\n   860\t              [second-state text] (repl/eval-input\n   861\t                                    (repl.frontends/create-state {:index-store failing})\n   862\t                                    \"(+ 2 3)\")]\n   863\t          (is (str/starts-with? text \"5\\nWarning: \"))\n   864\t          (is (false? (get-in (repl/repl-state second-state)\n   865\t                              [:index :published?])))\n   866\t          (is (nil? (get-in second-state [:indexer :manifest-address]))\n   867\t              \"the round whose HEAD did not move reports no manifest\")\n   868\t          (is (str/includes? (str (head-text dir)) (str first-manifest))\n   869\t              \"the previous published snapshot keeps the HEAD\"))\n   870\t        (finally\n   871\t          (store/close! opened)\n   872\t          (cleanup-store-dir! dir))))))\n   873\t\n   874\t\n   875\t;; =============================================================================\n   876\t;; Step 1 pins: explicit publication-result expectations (spec sections\n   877\t;; 3, 4 and 8).  Today the engine publishes synchronously through the\n   878\t;; handle's `:head-fn` (`yin.repl.index`'s `:after-publish`, after\n   879\t;; materialize/read-back); Step 2 re-expresses that call as the section 4\n   880\t;; request/result records on `dao.stream` media, settled through\n   881\t;; `yin.repl/accept-publication-result`.  Two kinds of pin follow and\n   882\t;; must not be confused.  The synchronous pins (this section, through\n   883\t;; `:head-fn`) exercise only the cases that seam can deliver -- matching\n   884\t;; success and refusal -- and pin the correlation that move must\n   885\t;; preserve: a round's frontier -- manifest identity, published\n   886\t;; transaction count, count-cap compatibility, cursor ownership, and\n   887\t;; expected suffix length -- is promoted exactly once, only for the\n   888\t;; round whose local durable publication succeeded, and never by a\n   889\t;; failed HEAD write, a mismatched policy, or a repeated settlement.\n   890\t;; The protocol oracle (`publication-result-protocol-oracle-for-step-2`)\n   891\t;; specifies the remaining cases -- delayed completion, wrong\n   892\t;; id/round/manifest, duplicate and stale delivery -- against the\n   893\t;; fixture's test-local model; Step 2 connects those same records to\n   894\t;; the real seam without changing their expected outcomes.\n   895\t;; =============================================================================\n   896\t\n   897\t(deftest frontier-gate-agrees-after-every-round-on-every-backend\n   898\t  (doseq [kind fixture/backend-kinds]\n   899\t    (testing (str kind)\n   900\t      (fixture/call-with-state\n   901\t        kind\n   902\t        (fn [shell _backend]\n   903\t          (let [rounds (reductions\n   904\t                         (fn [[state _] line] (repl/eval-input state line))\n   905\t                         [shell nil]\n   906\t                         [\"(def a 4101)\" \"(def b 4102)\" \"(+ a b)\"])]\n   907\t            (doseq [[i [state _]] (map-indexed vector (rest rounds))]\n   908\t              (testing (str \"after round \" (inc i))\n   909\t                (let [ix (:indexer state)\n   910\t                      f (fixture/frontier ix)\n   911\t                      committed (into #{} (mapcat :datoms) (transactions state))]\n   912\t                  (is (= (:manifest-address f) (:manifest-identity f))\n   913\t                      \"manifest identity: the address is the manifest's content address\")\n   914\t                  (is (= #{:indexes :count :branching-factor}\n   915\t                         (set (keys (:manifest f))))\n   916\t                      \"the manifest schema is exactly {:indexes :count :branching-factor}\")\n   917\t                  (is (= #{:eavt :aevt :avet :vaet}\n   918\t                         (set (keys (:indexes (:manifest f))))))\n   919\t                  (is (= (inc i) (:transactions f) (:published f)\n   920\t                         (:materialized-transactions f))\n   921\t                      \"published transaction count: the frontier covers every committed transaction\")\n   922\t                  (is (= (:count f) (count committed))\n   923\t                      \"the manifest's count is the covered datom count\")\n   924\t                  (is (= (:branching-factor f) (:expected-branching-factor f) 512)\n   925\t                      \"count-cap compatibility: the manifest carries the declared policy's cap\")\n","exit_code":0,"status":"completed"}}
