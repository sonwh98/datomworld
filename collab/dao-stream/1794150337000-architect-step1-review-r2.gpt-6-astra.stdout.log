hannel-gone)))))\\\\\\\\\\\\\\\\n   577\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   578\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   579\\\\\\\\\\\\\\\\t(defn- refl-next\\\\\\\\\\\\\\\\n   580\\\\\\\\\\\\\\\\t  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"The next operation: a filed answer for the cursor is returned and\\\\\\\\\\\\\\\\n   581\\\\\\\\\\\\\\\\t   forgotten; otherwise a next request is sent if none is outstanding,\\\\\\\\\\\\\\\\n   582\\\\\\\\\\\\\\\\t   and the answer is blocked -- nothing is observable at this position\\\\\\\\\\\\\\\\n   583\\\\\\\\\\\\\\\\t   through this handle yet. After close, filed outcomes then end. The\\\\\\\\\\\\\\\\n   584\\\\\\\\\\\\\\\\t   reflection never judges a cursor: cursor-mismatch and\\\\\\\\\\\\\\\\n   585\\\\\\\\\\\\\\\\t   invalid-cursor are only ever relayed from the source.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n   586\\\\\\\\\\\\\\\\t  [refl c]\\\\\\\\\\\\\\\\n   587\\\\\\\\\\\\\\\\t  (let [link (:link @refl)]\\\\\\\\\\\\\\\\n   588\\\\\\\\\\\\\\\\t    (drain! link)\\\\\\\\\\\\\\\\n   589\\\\\\\\\\\\\\\\t    (cond\\\\\\\\\\\\\\\\n   590\\\\\\\\\\\\\\\\t      (:closed? @refl)\\\\\\\\\\\\\\\\n   591\\\\\\\\\\\\\\\\t      (or (filed-next! link refl c) (result :dao.stream/end))\\\\\\\\\\\\\\\\n   592\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   593\\\\\\\\\\\\\\\\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\\\\\\\\\\\\\\\\n   594\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   595\\\\\\\\\\\\\\\\t      (surface-lacks? refl :dao.stream/next)\\\\\\\\\\\\\\\\n   596\\\\\\\\\\\\\\\\t      (translated :dao.stream.remote/no-surface)\\\\\\\\\\\\\\\\n   597\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   598\\\\\\\\\\\\\\\\t      :else\\\\\\\\\\\\\\\\n   599\\\\\\\\\\\\\\\\t      (or (filed-next! link refl c)\\\\\\\\\\\\\\\\n   600\\\\\\\\\\\\\\\\t          (when-not (:channel-gone? @link)\\\\\\\\\\\\\\\\n   601\\\\\\\\\\\\\\\\t            (send-or-count! link refl :dao.stream/next c)\\\\\\\\\\\\\\\\n   602\\\\\\\\\\\\\\\\t            (result :dao.stream/blocked))\\\\\\\\\\\\\\\\n   603\\\\\\\\\\\\\\\\t          (translated :dao.stream.remote/channel-gone)))))\\\\\\\\\\\\\\\\n   604\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   605\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n   606\\\\\\\\\\\\\\\\t(defn- refl-append\\\\\\\\\\\\\\\\n   607\\\\\\\\\\\\\\\\t  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"The append! operation: send the request and return the channel\\\\\\\\\\\\\\\\n   608\\\\\\\\\\\\\\\\t   writer's outcome -- ok is acceptance on the outbound path, exactly\\\\\\\\\\\\\\\\n   609\\\\\\\\\\\\\\\\t   the contract's Writing rule for a transport that carries values\\\\\\\\\\\\\\\\n   610\\\\\\\\\\\\\\\\t   toward a stream elsewhere. The source's outcome is emitted on the\\\\\\\\\\\\\\\\n   611\\\\\\\\\\\\\\\\t   event writer when it is filed, correlated by id; append! never\\\\\\\\\\\\\\\\n   612\\\\\\\\\\\\\\\\t   answers the source's full. Only an accepted send is in flight: a\\\\\\\\\\\\\\\\n   613\\\\\\\\\\\\\\\\t   refused append! never crossed, so its effect is not unknown.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n   614\\\\\\\\\\\\\\\\t  [refl v]\\\\\\\\\\\\\\\\n   615\\\\\\\\\\\\\\\\t  (let [link (:link @refl)]\\\\\\\\\\\\\\\\n   616\\\\\\\\\\\\\\\\t    (drain! link)\\\\\\\\\\\\\\\\n   617\\\\\\\\\\\\\\\\t    (cond\\\\\\\\\\\\\\\\n   618\\\\\\\\\\\\\\\\t      (:closed? @refl) (result :dao.stream/closed)\\\\\\\\\\\\\\\\n   619\\\\\\\\\\\\\\\\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\\\\\\\\\\\\\\\\n   620\\\\\\\\\\\\\\\\t      (surface-lacks? refl :dao.stream/append!)\\\\\\\\\\\\\\\\n   621\\\\\\\\\\\\\\\\t      (translated :dao.stream.remote/no-surface)\\\\\\\\\\\\\\\\n   622\\\\\\\\\\\\\\\\t      :else\\\\\\\\\\\\\\\\n   623\\\\\\\\\\\\\\\\t      (let [req (wire-request link refl :dao.stream/append! [v])\\\\\\\\\\\\\\\\n   624\\\\\\\\\\\\\\\\t            r (stream/append! (:writer @link) req)]\\\\\\\\\\\\\\\\n   625\\\\\\\\\\\\\\\\t        (when (= :dao.stream/ok (:dao.stream/outcome r))\\\\\\\\\\\\\\\\