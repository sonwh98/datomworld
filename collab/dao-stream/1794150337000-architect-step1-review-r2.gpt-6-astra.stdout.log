5\\\\\\\\t    (register! link refl req)\\\\\\\\n   286\\\\\\\\t    r))\\\\\\\\n   287\\\\\\\\t\\\\\\\\n   288\\\\\\\\t\\\\\\\\n   289\\\\\\\\t(defn- count-ask!\\\\\\\\n   290\\\\\\\\t  \\\\\\\\\\\\\\\"Count one further ask of the outstanding request `id`; on reaching\\\\\\\\n   291\\\\\\\\t   the link's resend-after k, re-send it once -- the same id, a\\\\\\\\n   292\\\\\\\\t   duplicate of an idempotent operation, which recomputes the same or a\\\\\\\\n   293\\\\\\\\t   later, equally true answer -- and start counting afresh. append! is\\\\\\\\n   294\\\\\\\\t   never re-sent: it never stays outstanding beyond its send.\\\\\\\\\\\\\\\"\\\\\\\\n   295\\\\\\\\t  [link id]\\\\\\\\n   296\\\\\\\\t  (when-some [entry (get (:outstanding @link) id)]\\\\\\\\n   297\\\\\\\\t    (let [k (:resend-after @link)\\\\\\\\n   298\\\\\\\\t          asks (inc (:asks entry))]\\\\\\\\n   299\\\\\\\\t      (swap! link assoc-in [:outstanding id :asks] asks)\\\\\\\\n   300\\\\\\\\t      (when (and (integer? k) (pos? k) (<= k asks))\\\\\\\\n   301\\\\\\\\t        (stream/append! (:writer @link) (:req entry))\\\\\\\\n   302\\\\\\\\t        (swap! link assoc-in [:outstanding id :asks] 0)))))\\\\\\\\n   303\\\\\\\\t\\\\\\\\n   304\\\\\\\\t\\\\\\\\n   305\\\\\\\\t(defn- outstanding-for\\\\\\\\n   306\\\\\\\\t  \\\\\\\\\\\\\\\"The id of the link's outstanding request for `op` with `arg` sent by\\\\\\\\n   307\\\\\\\\t   `refl`, if any; the request each outstanding id was sent for makes\\\\\\\\n   308\\\\\\\\t   the correlation.\\\\\\\\\\\\\\\"\\\\\\\\n   309\\\\\\\\t  [link refl op arg]\\\\\\\\n   310\\\\\\\\t  (when-some [[id _]\\\\\\\\n   311\\\\\\\\t              (first\\\\\\\\n   312\\\\\\\\t                (filter (fn [[_ e]]\\\\\\\\n   313\\\\\\\\t                          (let [r (:req e)]\\\\\\\\n   314\\\\\\\\t                            (and (= refl (:reflection e))\\\\\\\\n   315\\\\\\\\t                                 (= op (:dao.stream.remote/op r))\\\\\\\\n   316\\\\\\\\t        