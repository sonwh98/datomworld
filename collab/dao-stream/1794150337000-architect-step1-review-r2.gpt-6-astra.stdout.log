1\t            (is (= [7 43 44] (mapv :t txs)))\n   582\t            (is (= 45 (transactor/watermark (:allocator resumed))))\n   583\t            (is (every? #(<= 102 (first %)) (:datoms (last txs))))\n   584\t            (is (true? (:published? (repl.index/status resumed))))))))))\n   585\t\n   586\t\n   587\t(deftest a-publication-beyond-the-old-intake-bound-completes\n   588\t  (doseq [kind fixture/backend-kinds]\n   589\t    (testing (str kind)\n   590\t      (fixture/call-with-backend\n   591\t        kind\n   592\t        (fn [backend]\n   593\t          (let [{:keys [writer observer]} (small-medium 16)\n   594\t                store (:handle backend)\n   595\t                indexer (repl.index/make-indexer\n   596\t                          {:observer observer\n   597\t                           :session-token \"token\"\n   598\t                           :content-store store\n   599\t                           ;; a small branching factor makes many node blobs\n   600\t                           :publish-opts {:branching-factor 4}})\n   601\t                program (fn [base]\n   602\t                          (macro/ast->packet\n   603\t                            {:type :application\n   604\t                             :operator {:type :variable, :name '+}\n   605\t                             :operands (mapv (fn [i] {:type :literal, :value (+ base i)})\n   606\t                                             (range 300))}))\n   607\t                _ (doseq [base [0 1000 2000 3000]]\n   608\t                    (stream/append! writer (program base)))\n   609\t                ix (repl.index/step indexer 1)\n   610\t                committed (into #{}\n   611\t                                (mapcat (comp :datoms :dao.space/transaction))\n   612\t                                (stream-values (:local ix)))\n   613\t                address (:manifest-address ix)]\n   614\t            (is (< 4096 (:published-payloads ix))\n   615\t                \"one publicat