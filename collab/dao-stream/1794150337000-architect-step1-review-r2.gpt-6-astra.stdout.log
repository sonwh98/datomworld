lished f3) (:transactions f3)\n  1070\t                     (:materialized-transactions f3))\n  1071\t                  \"the retry promotes the refused round's suffix with its own\")\n  1072\t              (is (= 3 (count @log)) \"each round requested publication exactly once\")\n  1073\t              (is (= (:manifest-address f1) (first @log)))\n  1074\t              (is (= (:manifest-address f3) (last @log)))\n  1075\t              (is (not= (second @log) (:manifest-address f3))\n  1076\t                  \"the refused round's prepared manifest was never promoted\"))))))))\n  1077\t\n  1078\t\n  1079\t(deftest publication-result-protocol-oracle-for-step-2\n  1080\t  ;; Step 2 oracle, not a synchronous pin: the full section 4 result\n  1081\t  ;; protocol, specified against the fixture's test-local model\n  1082\t  ;; (`fixture/accept-result`) because today's `:head-fn` seam cannot\n  1083\t  ;; delay, mismatch, duplicate, or stale a delivery.  Step 2 must make\n  1084\t  ;; `yin.repl/accept-publication-result` over the publication streams\n  1085\t  ;; produce exactly these frontier effects for these same records;\n  1086\t  ;; only then do these cases become engine pins.  The synchronous\n  1087\t  ;; cases above already prove matching success and refusal through the\n  1088\t  ;; real seam; nothing here claims they do.\n  1089\t  (let [f0 {:manifest :m0 :published 1 :round 1}\n  1090\t        request (fixture/publication-request 7 2 :m2)\n  1091\t        promoted {:manifest :m2 :published 2 :round 2}\n  1092\t        pending {:request request :promotes promoted}\n  1093\t        success (fixture/publication-result request :published :persistent)\n  1094\t        refusal (fixture/publication-result request :refused :persistent\n  1095\t                                            \"HEAD refused\")\n  1096\t        deliver (fn [result] (fixture/accept-result f0 pending result))]\n  1097\t    (testing \"the specification covers the full protocol exactly once\"\n  1098\t      (is (= #{:matching-success :refusal :delayed-completion :wrong-id\n  1099\t               :wrong-round :wrong-manifest :duplicate :stale}\n  1100\t             (set (map :case fixture/publication-result-expectations))))\n  1101\t      (is (= #{:matching-success :refusal}\n  1102\t             (set (map :case (filter #(= :synchronous (:pinned %))\n  1103\t                                     fixture/publication-result-expectations))))\n  1104\t          \"only matching success and refusal are synchronous pins\")\n  1105\t      (is (= #{:delayed-completion :wrong-id :wrong-round :wrong-manifest\n  1106\t               :duplicate :stale}\n  1107\t             (set (map :case (filter #(= :step-2-oracle (:pinned %))\n  1108\t                                     fixture/publication-result-expectations))))\n  1109\t          \"the rest are Step 2 oracle cases, distinguished from the pins\"))\n  1110\t    (testing \"matching success promotes exactly the pending frontier\"\n  1111\t      (let [out (deliver success)]\n  1112\t        (is (= :promoted (:effect out)))\n  1113\t        (is (= promoted (:frontier out))\n  1114\t            \"manifest, published count, and round together, exactly once\")\n  1115\t        (is (nil? (:pending out)) \"the settled request leaves no pending\")))\n  1116\t    (testing \"refusal preserves the prior frontier and supersedes pending\"\n  1117\t      (let [out (deliver refusal)]\n  1118\t        (is (= :preserved (:effect out)))\n  1119\t        (is (= f0 (:frontier out)) \"no field of the frontier moves\")\n  1120\t        (is (nil? (:pending out))\n  1121\t            \"the refused frontier is superseded; retry is a new request\")))\n  1122\t    (testing \"delayed completion promotes on arrival, never before\"\n  1123\t      (is (= f0 (:frontier {:frontier f0 :pending pending}))\n  1124\t          \"while the result is outstanding the frontier stays at F\")\n  1125\t      (let [out (deliver success)]\n  1126\t        (is (= :promoted (:effect out)))\n  1127\t        (is (= promoted (:frontier out))\n  1128\t            \"the late matching result still promotes exactly its round\")))\n  1129\t    (testing \"wrong id, round, or manifest settles nothing\"\n  1130\t      (doseq [[label result]\n  1131\t              {\"wrong id\" (assoc success :id 8)\n  1132\t               \"wrong round\" (assoc success :round 3)\n  1133\t               \"wrong manifest\" (assoc success :manifest :m-other)}]\n  1134\t        (testing label\n  1135\t          (let [out (deliver result)]\n  1136\t            (is (= :ignored (:effect out)))\n  1137\t            (is (= f0 (:frontier out))\n  1138\t                \"neither the result's manifest nor the pending frontier promotes\")\n  1139\t            (is (= pending (:pending out))\n  1140\t                \"the pending request stays pending for its own result\")))))\n  1141\t    (testing \"duplicate and stale results cannot promote or regress\"\n  1142\t      (let [settled (deliver success)\n  1143\t            duplicate (fixture/accept-result (:frontier settled) nil success)\n  1144\t            newer-request (fixture/publication-request 9 4 :m4)\n  1145\t            newer-pending {:request newer-request\n  1146\t                           :promotes {:manifest :m4 :published 4 :round 4}}\n  1147\t            stale (fixture/accept-result promoted newer-pending success)]\n  1148\t        (is (= :ignored (:effect duplicate)))\n  1149\t        (is (= promoted (:frontier duplicate))\n  1150\t            \"a second delivery leaves counts and cursor identical\")\n  1151\t        (is (= :ignored (:effect stale)))\n  1152\t        (is (= promoted (:frontier stale))\n  1153\t            \"a superseded round's result cannot promote another round\")\n  1154\t        (is (= newer-pending (:pending stale)))))\n  1155\t    (testing \"durability claims local completion only\"\n  1156\t      (is (= :memory (:durability\n  1157\t                       (fixture/publication-result request :published :memory))))\n  1158\t      (is (= :persistent (:durability success)))\n  1159\t      (is (= :publication-result (:op success) (:op refusal))))))\n  1160\t\n  1161\t\n  1162\t(deftest shell-retry-after-refused-publication-promotes-the-whole-suffix\n  1163\t  ;; KNOWN FAILING shell-level acceptance reproduction (spec sections\n  1164\t  ;; 8 and 11): do not weaken, skip, or delete this pin to green the\n  1165\t  ;; suite.  The narrower indexer oracle for the same continuation\n","exit_code":0,"status":"completed"}}
