ial message.\n    28\t\n    29\t   The deposit adapter shape: every reassembled datagram value is\n    30\t   deposited as one event, `{:dao.stream.udp/attachment id\n    31\t   :dao.stream.udp/source {:dao.stream.udp/host h\n    32\t   :dao.stream.udp/port p} :dao.stream.udp/value v}`, onto the shared\n    33\t   traffic medium the composition wires -- one socket may serve several\n    34\t   attachments, one per remote address, so this medium is shared the\n    35\t   way a WebSocket connection's own traffic medium is not. `projection`\n    36\t   and `step!` are this channel's `ws-project`: driven per attachment\n    37\t   at the composition's cadence, they keep the events naming their own\n    38\t   attachment and append each value onto the channel ring that\n    39\t   attachment's reflections read.\n    40\t\n    41\t   `make-attacher` binds or reuses `:port` and answers a writer handle\n    42\t   whose `append!` sends toward the descriptor's address, fragmenting\n    43\t   and refusing oversize per the above; `send-to!` is the same write\n    44\t   path to an explicit destination from an already-bound port, for hole\n    45\t   punching (section 4), outside any attach!'d descriptor. Replies\n    46\t   always go to a datagram's own source address, never a payload's\n    47\t   claim, because `receive!` is the only place a source address is\n    48\t   read, and every deposited event carries the address the socket\n    49\t   itself saw it arrive from.\"\n    50\t  (:require [dao.stream :as stream]\n    51\t            [dao.stream.cbor :as cbor])\n    52\t  #?(:cljd (:import [\"dart:typed_data\" Uint8List])))\n    53\t\n    54\t\n    55\t(def transport-type :dao.stream/udp)\n    56\t\n    57\t\n    58\t(def max-datagram\n    59\t  \"The whole encoded datagram's budget, fragment envelope included: the\n    60\t   1200-byte figure dao.jing.dht.node already uses to clear common path\n    61\t   MTUs (docs/design/dao.stream.remote.md 3.2).\"\n    62\t  1200)\n    63\t\n    64\t\n    65\t(def default-max-message-bytes\n    66\t  \"64 KiB, the default reassembly maximum (3.2).\"\n    67\t  (* 64 1024))\n    68\t\n    69\t\n    70\t(def default-max-partial-messages\n    71\t  \"No default is named in 3.2; this is this implementation's own bound\n    72\t   on outstanding partial messages, chosen only to keep reassembly\n    73\t   memory finite without a clock.\"\n    74\t  64)\n    75\t\n    76\t\n    77\t(defn descriptor?\n    78\t  \"{:dao.stream/type :dao.stream/udp :dao.stream/identity id\n    79\t     :dao.stream.udp/host h :dao.stream.udp/port p} (3.2).\"\n    80\t  [x]\n    81\t  (and (map? x)\n    82\t       (= transport-type (:dao.stream/type x))\n    83\t       (string? (:dao.stream/identity x))\n    84\t       (string? (:dao.stream.udp/host x))\n    85\t       (integer? (:dao.stream.udp/port x))\n    86\t       (pos? (:dao.stream.udp/port x))))\n    87\t\n    88\t\n    89\t(defn address-key\n    90\t  \"The attachment identity a socket serves for one remote address: the\n    91\t   host:port it saw, as a string, so it can key a map.\"\n    92\t  [host port]\n    93\t  (str host \":\" port))\n    94\t\n    95\t\n    96\t;; =============================================================================\n    97\t;; Portable host byte arrays\n    98\t;; =============================================================================\n    99\t\n   100\t(defn- blen\n   101\t  [bs]\n   102\t  #?(:cljd (.-length ^Uint8List bs)\n   103\t     :default (alength bs)))\n   104\t\n   105\t\n   106\t(defn- balloc\n   107\t  [n]\n   108\t  #?(:cljd (Uint8List. n)\n   109\t     :clj (byte-array n)\n   110\t     :cljs (js/Uint8Array. n)))\n   111\t\n   112\t\n   113\t(defn- bslice\n   114\t  [bs start end]\n   115\t  #?(:cljd (Uint8List.fromList (.sublist ^Uint8List bs start end))\n   116\t     :clj (java.util.Arrays/copyOfRange ^bytes bs (int start) (int end))\n   117\t     :cljs (.slice bs start end)))\n   118\t\n   119\t\n   120\t(defn- bconcat\n   121\t  [chunks]\n   122\t  (let [total (reduce + (map blen chunks))\n   123\t        out (balloc total)]\n   124\t    (reduce (fn [off c]\n   125\t              (let [n (blen c)]\n   126\t                #?(:cljd (.setRange ^Uint8List out off (+ off n) c)\n   127\t                   :clj (System/arraycopy c 0 out off n)\n   128\t                   :cljs (.set out c off))\n   129\t                (+ off n)))\n   130\t            0 chunks)\n   131\t    out))\n   132\t\n   133\t\n   134\t(defn- ceil-div\n   135\t  [a b]\n   136\t  (quot (+ a (dec b)) b))\n   137\t\n   138\t\n   139\t;; =============================================================================\n   140\t;; Fragmentation (write side)\n   141\t;; =============================================================================\n   142\t\n   143\t(defn- direction-of\n   144\t  \"A request carries :dao.stream.remote/op; an answer never does.\"\n   145\t  [v]\n   146\t  (if (contains? v :dao.stream.remote/op)\n   147\t    :dao.stream.udp/request\n   148\t    :dao.stream.udp/answer))\n   149\t\n   150\t\n   151\t(defn- fragment-envelope\n   152\t  [id part parts direction chunk]\n   153\t  {:dao.stream.remote/id id\n   154\t   :dao.stream.udp/part part\n   155\t   :dao.stream.udp/parts parts\n   156\t   :dao.stream.udp/direction direction\n   157\t   :dao.stream.udp/bytes chunk})\n   158\t\n   159\t\n   160\t(defn- fits?\n   161\t  [id part parts direction chunk-len]\n   162\t  (<= (blen (cbor/encode\n   163\t              (fragment-envelope id part parts direction\n   164\t                                 (balloc chunk-len))))\n   165\t      max-datagram))\n   166\t\n   167\t\n   168\t(defn- chunk-size\n   169\t  \"The largest chunk length whose fragment envelope, at the highest\n   170\t   part index (the widest of the small integers), still fits the\n   171\t   datagram budget; backs off from an optimistic start.\"\n   172\t  [id parts direction]\n   173\t  (loop [size (- max-datagram 16)]\n   174\t    (when (pos? size)\n   175\t      (if (fits? id (dec parts) parts direction size)\n   176\t        size\n   177\t        (recur (dec size))))))\n   178\t\n   179\t\n   180\t(defn- fragments\n   260\t  [port host dest-port v]\n   261\t  (send-value! port host dest-port v))\n   262\t\n   263\t\n   264\t;; =============================================================================\n   265\t;; Reassembly (read side)\n   266\t;; =============================================================================\n   267\t\n   268\t(defn- fragment-envelope?\n   269\t  \"Any reserved fragment key present makes a datagram a fragment\n   270\t   attempt: it must then validate fully or be dropped -- a shape\n   271\t   carrying :parts/:direction/:bytes but missing :part does not fall\n   272\t   through to the deposit path.\"\n   273\t  [v]\n   274\t  (and (map? v)\n   275\t       (some #(contains? v %)\n   276\t             [:dao.stream.udp/part :dao.stream.udp/parts\n   277\t              :dao.stream.udp/direction :dao.stream.udp/bytes])))\n   278\t\n   279\t\n   280\t(defn- well-formed-fragment?\n   281\t  \"A fragment envelope's own wire fields, checked before any reassembly\n   282\t   state can change: :part and :parts are integers with 0 <= :part <\n   283\t   :parts, 1 <= :parts, :direction one of the two the write side\n   284\t   mints, and :bytes a host byte payload. A datagram failing this is\n   285\t   best-effort wire input, dropped below the mirror and the link like\n   286\t   any other malformed one -- nothing here may throw during\n   287\t   reassembly, whatever a peer put on the wire.\"\n   288\t  [v]\n   289\t  (let [{:dao.stream.udp/keys [part parts direction bytes]} v]\n   290\t    (and (integer? part)\n   291\t         (integer? parts)\n   292\t         (pos? parts)\n   293\t         (<= 0 part)\n   294\t         (< part parts)\n   295\t         (#{:dao.stream.udp/request :dao.stream.udp/answer} direction)\n   296\t         (cbor/byte-payload? bytes))))\n   297\t\n   298\t\n   299\t(defn- forget-partial!\n   300\t  \"Drop the partial message keyed `k` from the port's reassembly\n   301\t   state, its order entry with it.\"\n   302\t  [port k]\n   303\t  (swap! port (fn [s]\n   304\t                (-> s\n   305\t                    (update :partial dissoc k)\n   306\t                    (update :partial-order\n   307\t                            (fn [order] (vec (remove #{k} order))))))))\n   308\t\n   309\t\n   310\t(defn- evict-oldest!\n   311\t  [port]\n   312\t  (when-some [k (first (:partial-order @port))]\n   313\t    (forget-partial! port k)))\n   314\t\n   315\t\n   316\t(defn- absorb-fragment!\n   317\t  \"Fold one well-formed fragment envelope into the port's reassembly\n   318\t   state, keyed by [attachment direction id]; returns the complete\n   319\t   encoded payload once every part has arrived, else nil. The\n   320\t   max-message-bytes bound is the accumulated chunk bytes themselves,\n   321\t   as they arrive: a message whose parts add up past the bound is\n   322\t   dropped the moment they say so, and a completed payload is\n   323\t   delivered only if its own actual length is within the bound -- no\n   324\t   declared-parts arithmetic stands in for the real bytes, so a valid\n   325\t   message near the limit delivers. A duplicate part is ignored, and\n   326\t   a fragment disagreeing with the parts count a partial already\n   327\t   holds is dropped, so the state held is never torn.\"\n   328\t  [port attachment frag]\n   329\t  (let [{:dao.stream.remote/keys [id]\n   330\t         :dao.stream.udp/keys [part parts direction bytes]} frag\n   331\t        k [attachment direction id]\n   332\t        bound (:max-message-bytes @port)]\n   333\t    (when-not (contains? (:partial @port) k)\n   334\t      (swap! port (fn [s]\n   335\t                    (-> s\n   336\t                        (assoc-in [:partial k]\n   337\t                                  {:parts {} :parts-count parts\n   338\t                                   :bytes-total 0})\n   339\t                        (update :partial-order conj k))))\n   340\t      (when (> (count (:partial @port))\n   341\t               (:max-partial-messages @port))\n   342\t        (evict-oldest! port)))\n   343\t    (when-some [held (get (:partial @port) k)]\n   344\t      (when (and (= parts (:parts-count held))\n   345\t                 (not (contains? (:parts held) part)))\n   346\t        (let [total (+ (:bytes-total held) (blen bytes))]\n   347\t          (if (> total bound)\n   348\t            ;; even completed, this message is over the bound: its\n   349\t            ;; partial state goes now, it can never deliver\n   350\t            (forget-partial! port k)\n   351\t            (do (swap! port (fn [s]\n   352\t                              (-> s\n   353\t                                  (assoc-in [:partial k :parts part] bytes)\n   354\t                                  (assoc-in [:partial k :bytes-total] total))))\n   355\t                (let [held (get (:partial @port) k)]\n   356\t                  (when (= (count (:parts held)) (:parts-count held))\n   357\t                    (forget-partial! port k)\n   358\t                    (let [payload (bconcat (mapv (:parts held)\n   359\t                                                 (range (:parts-count held))))]\n   360\t                      (when (<= (blen payload) bound)\n   361\t                        payload)))))))))))\n   362\t\n   363\t\n   364\t(defn- deposit!\n   365\t  [port attachment host src-port v]\n   366\t  (stream/append! (:traffic @port)\n   367\t                  {:dao.stream.udp/attachment attachment\n   368\t                   :dao.stream.udp/source {:dao.stream.udp/host host\n   369\t                                           :dao.stream.udp/port src-port}\n   370\t                   :dao.stream.udp/value v}))\n   371\t\n   372\t\n   373\t(defn receive!\n   374\t  \"Adapter entry: one raw datagram arrived from `host`:`src-port` on\n   375\t   `port`'s socket, as `bytes`. Malformed CBOR is dropped as a\n   376\t   diagnostic below the mirror and the link, per dao.stream.remote.md\n   377\t   2.1, and so is a fragment envelope whose own fields are malformed\n   378\t   -- checked before any partial state can change. A plain value\n   379\t   deposits at once; a fragment envelope folds into reassembly and\n   380\t   deposits only once complete -- loss of any part is loss of the\n   381\t   whole message, recovered by the link's resend rule, not by this\n   382\t   port. Replies to what this call learns go to `host`:`src-port`,\n   383\t   this datagram's own source, never an address a payload might\n   384\t   claim.\"\n   385\t  [port host src-port bytes]\n   386\t  (when-some [v (try (cbor/decode bytes) (catch #?(:cljd Object\n   387\t                                                   :clj Throwable\n   388\t                                                   :cljs :default) _\n   389\t                                           nil))]\n   390\t    (let [attachment (address-key host src-port)]\n   391\t      (if (fragment-envelope? v)\n   392\t        (when (well-formed-fragment? v)\n   393\t          (when-some [payload (absorb-fragment! port attachment v)]\n   394\t            (when-some [whole (try (cbor/decode payload)\n   395\t                                   (catch #?(:cljd Object :clj Throwable\n   396\t                                             :cljs :default) _\n   397\t                                     nil))]\n   398\t              (deposit! port attachment host src-port whole))))\n   399\t        (deposit! port attachment host src-port v)))))\n   400\t\n   401\t\n   402\t;; =============================================================================\n   403\t;; The projection: one channel ring per attachment (this channel's\n   404\t;; ws-project)\n   405\t;; =============================================================================\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/udp_test.cljc | sed -n '1,225p'; rg -n 'fragment|reserved|ordinary|VALUE|udp/part|udp/parts' docs src test | head -100\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/udp_test.cljc | sed -n '1,225p'; rg -n 'fragment|reserved|ordinary|VALUE|udp/part|udp/parts' docs src test | head -100\"","aggregated_output":"     1\t(ns dao.stream.udp-test\n     2\t  \"Portable, host-free protocol tests for dao.stream.udp\n     3\t   (docs/design/dao.stream.remote.md 3.2): fragmentation and\n     4\t   reassembly round trip; loss of any part loses the message,\n     5\t   recovered by resend; oversize refuses transport-error naming\n     6\t   oversize, unsent; reassembly eviction, oldest partial message\n     7\t   first; the 48 KiB toy inside the default 64 KiB maximum, and a\n     8\t   near-limit message delivered on its actual accumulated length;\n     9\t   malformed fragment envelopes dropped before any partial state\n    10\t   changes; the deposited event carries the datagram's own source\n    11\t   address; and keying by [attachment, direction, id] -- two\n    12\t   attachments, equal ids, no cross-delivery -- including the\n    13\t   projection that routes the shared traffic medium onto each\n    14\t   attachment's own channel ring.\"\n    15\t  (:require [clojure.test :refer [deftest is testing]]\n    16\t            [dao.stream :as stream]\n    17\t            [dao.stream.cbor :as cbor]\n    18\t            [dao.stream.ringbuffer :as ringbuffer]\n    19\t            [dao.stream.udp :as udp]))\n    20\t\n    21\t\n    22\t(defn- ring\n    23\t  [capacity]\n    24\t  (:dao.stream/handle\n    25\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    26\t                         ringbuffer/capacity-key capacity})))\n    27\t\n    28\t\n    29\t(defn- spy\n    30\t  \"A :send! seam recording every send as [host port bytes], touching\n    31\t   no real socket.\"\n    32\t  []\n    33\t  (let [log (atom [])]\n    34\t    {:log log\n    35\t     :send! (fn [host port bytes] (swap! log conj [host port bytes]))}))\n    36\t\n    37\t\n    38\t(defn- values\n    39\t  \"Every retained value of `h`, oldest first.\"\n    40\t  [h]\n    41\t  (loop [c (:dao.stream/cursor (stream/cursor h stream/anchor-oldest))\n    42\t         acc []]\n    43\t    (let [r (stream/next h c)]\n    44\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    45\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    46\t        acc))))\n    47\t\n    48\t\n    49\t(defn- deposited\n    50\t  \"Every deposit event's own carried :dao.stream.udp/value, oldest\n    51\t   first -- what a projection would forward onto a channel ring.\"\n    52\t  [traffic]\n    53\t  (mapv :dao.stream.udp/value (values traffic)))\n    54\t\n    55\t\n    56\t(defn- big-string\n    57\t  [n]\n    58\t  (apply str (repeat n \\a)))\n    59\t\n    60\t\n    61\t(defn- request\n    62\t  [identity id v]\n    63\t  {:dao.stream/identity identity\n    64\t   :dao.stream.remote/op :dao.stream/append!\n    65\t   :dao.stream.remote/args [v]\n    66\t   :dao.stream.remote/id id})\n    67\t\n    68\t\n    69\t;; =============================================================================\n    70\t;; descriptor? and address-key\n    71\t;; =============================================================================\n    72\t\n    73\t(deftest descriptor-gate\n    74\t  (is (udp/descriptor? {:dao.stream/type :dao.stream/udp\n    75\t                        :dao.stream/identity \"peer-a\"\n    76\t                        :dao.stream.udp/host \"127.0.0.1\"\n    77\t                        :dao.stream.udp/port 9000}))\n    78\t  (is (not (udp/descriptor? {:dao.stream/type :dao.stream/udp\n    79\t                             :dao.stream/identity \"peer-a\"\n    80\t                             :dao.stream.udp/host \"127.0.0.1\"\n    81\t                             :dao.stream.udp/port 0})))\n    82\t  (is (not (udp/descriptor? {:dao.stream/type :dao.stream/ws\n    83\t                             :dao.stream/identity \"peer-a\"\n    84\t                             :dao.stream.udp/host \"h\"\n    85\t                             :dao.stream.udp/port 1}))))\n    86\t\n    87\t\n    88\t(deftest address-key-format\n    89\t  (is (= \"127.0.0.1:9000\" (udp/address-key \"127.0.0.1\" 9000))))\n    90\t\n    91\t\n    92\t;; =============================================================================\n    93\t;; Fragmentation and reassembly round trip\n    94\t;; =============================================================================\n    95\t\n    96\t(deftest fragmentation-round-trip\n    97\t  (testing \"a value over the datagram budget arrives whole\"\n    98\t    (let [traffic (ring 64)\n    99\t          {:keys [send! log]} (spy)\n   100\t          port (udp/make-port {:send! send! :traffic traffic})\n   101\t          v (request \"s\" 1 (big-string 4000))\n   102\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   103\t                   @log)\n   104\t          receiver (udp/make-port\n   105\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   106\t      (is (> (count sent) 1) \"the value did not fit one datagram\")\n   107\t      (doseq [[_ _ bytes] sent]\n   108\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   109\t      (is (= [v] (deposited traffic))))))\n   110\t\n   111\t\n   112\t(deftest fragmentation-round-trip-48kib\n   113\t  (testing \"the 48 KiB toy, inside the default 64 KiB maximum\"\n   114\t    (let [traffic (ring 64)\n   115\t          {:keys [send! log]} (spy)\n   116\t          port (udp/make-port {:send! send! :traffic traffic})\n   117\t          v (request \"s\" 2 (big-string (* 48 1024)))\n   118\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   119\t                   @log)\n   120\t          receiver (udp/make-port\n   121\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   122\t      (doseq [[_ _ bytes] sent]\n   123\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   124\t      (is (= [v] (deposited traffic))))))\n   125\t\n   126\t\n   127\t(deftest fragmentation-round-trip-near-limit\n   128\t  (testing \"a message near the default maximum delivers on its actual\n   129\t            accumulated length\"\n   130\t    (let [traffic (ring 64)\n   131\t          {:keys [send! log]} (spy)\n   132\t          port (udp/make-port {:send! send! :traffic traffic})\n   133\t          v (request \"s\" 22 (big-string 64500))\n   134\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   135\t                   @log)\n   136\t          receiver (udp/make-port\n   137\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   138\t      (is (> (count sent) 54)\n   139\t          \"declared parts times the datagram budget crosses 64 KiB, so\n   140\t           a bound on the claim, not the bytes, would have dropped it\")\n   141\t      (doseq [[_ _ bytes] sent]\n   142\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   143\t      (is (= [v] (deposited traffic))))))\n   144\t\n   145\t\n   146\t;; =============================================================================\n   147\t;; Malformed fragment envelopes drop, before any partial state changes\n   148\t;; =============================================================================\n   149\t\n   150\t(defn- raw-fragment\n   151\t  \"One raw fragment envelope, `overrides` merged over a well-formed\n   152\t   two-part shape -- whatever a peer might put on the wire.\"\n   153\t  [overrides]\n   154\t  (merge {:dao.stream.remote/id 7\n   155\t          :dao.stream.udp/part 0\n   156\t          :dao.stream.udp/parts 2\n   157\t          :dao.stream.udp/direction :dao.stream.udp/request\n   158\t          :dao.stream.udp/bytes (cbor/encode \"x\")}\n   159\t         overrides))\n   160\t\n   161\t\n   162\t(deftest malformed-fragments-drop-before-partial-state\n   163\t  (testing \"a fragment failing its own field checks is dropped: no\n   164\t            throw, no deposit, no partial state\"\n   165\t    (let [traffic (ring 64)\n   166\t          {:keys [send! log]} (spy)\n   167\t          sender (udp/make-port {:send! send! :traffic traffic})\n   168\t          receiver (udp/make-port\n   169\t                     {:send! (fn [& _] nil) :traffic traffic})\n   170\t          malformed [(raw-fragment {:dao.stream.udp/parts 0})\n   171\t                     (raw-fragment {:dao.stream.udp/part -1})\n   172\t                     (raw-fragment {:dao.stream.udp/part 2})\n   173\t                     (raw-fragment {:dao.stream.udp/part \"0\"})\n   174\t                     (raw-fragment {:dao.stream.udp/parts nil})\n   175\t                     (raw-fragment {:dao.stream.udp/direction\n   176\t                                    :dao.stream.udp/sideways})\n   177\t                     (raw-fragment {:dao.stream.udp/bytes \"not bytes\"})\n   178\t                     (dissoc (raw-fragment {})\n   179\t                              :dao.stream.udp/part)]\n   180\t          v (request \"s\" 7 (big-string 4000))\n   181\t          sent (do (udp/send-value! sender \"peer\" 9000 v)\n   182\t                   @log)]\n   183\t      (doseq [frag malformed]\n   184\t        (is (nil? (udp/receive! receiver \"peer\" 9000 (cbor/encode frag)))\n   185\t            \"the malformed datagram is dropped, not thrown\"))\n   186\t      (is (= {} (:partial @receiver))\n   187\t          \"not one malformed fragment grew partial state\")\n   188\t      (is (= [] (deposited traffic)) \"and none deposited\")\n   189\t      (testing \"a real message interleaved with the malformed set\n   190\t                completes untouched by its neighbors\"\n   191\t        (doseq [[_ _ bytes] (butlast sent)]\n   192\t          (udp/receive! receiver \"peer\" 9000 bytes))\n   193\t        (doseq [frag malformed]\n   194\t          (udp/receive! receiver \"peer\" 9000 (cbor/encode frag)))\n   195\t        (udp/receive! receiver \"peer\" 9000 (last (last sent)))\n   196\t        (is (= [v] (deposited traffic)))))))\n   197\t\n   198\t\n   199\t;; =============================================================================\n   200\t;; Loss of any part loses the message, recovered by resend\n   201\t;; =============================================================================\n   202\t\n   203\t(deftest loss-of-any-part-loses-the-message\n   204\t  (testing \"dropping one datagram loses the whole message\"\n   205\t    (let [traffic (ring 64)\n   206\t          {:keys [send! log]} (spy)\n   207\t          port (udp/make-port {:send! send! :traffic traffic})\n   208\t          v (request \"s\" 3 (big-string 4000))\n   209\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   210\t                   @log)\n   211\t          receiver (udp/make-port\n   212\t                     {:send! (fn [& _] nil) :traffic traffic})\n   213\t          dropped (rest sent)]\n   214\t      (is (> (count sent) 1))\n   215\t      (doseq [[_ _ bytes] dropped]\n   216\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   217\t      (is (= [] (deposited traffic))\n   218\t          \"the message never completes without every part\")\n   219\t      (testing \"the link's resend rule recovers it: re-send every part\"\n   220\t        (doseq [[_ _ bytes] sent]\n   221\t          (udp/receive! receiver \"peer\" 9000 bytes))\n   222\t        (is (= [v] (deposited traffic)))))))\n   223\t\n   224\t\n   225\t;; =============================================================================\ndocs/dao.space.stigmergy.md:148:into the prompt. This is ordinary datom data — no new mechanism, just a convention to pin\ndocs/dao.space.stigmergy.md:216:Two stigmergy-compatible remedies, both read-side rules over ordinary datoms — no locks, no\ntest/resources/dao/jing/cbor-v1.json:17:  {\"id\": \"coll/sorted-map-kw-a-b\", \"kind\": \"canonical\", \"categories\": [\"collections\"], \"input\": {\"t\": \"sorted-map\", \"entries\": [[{\"t\"