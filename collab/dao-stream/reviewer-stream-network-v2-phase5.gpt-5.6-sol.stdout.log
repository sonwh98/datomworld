te (:state endpoint)\n   405\t             chosen (volatile! nil)]\n   406\t         ;; Claim before depositing.  The offer append may synchronously invoke\n   407\t         ;; host code, so leaving the slot `:free` until after it returns would\n   408\t         ;; permit a second upgrade callback to overwrite the sole offer.\n   409\t         (swap! state (fn [s]\n   410\t                        (if-let [[index slot] (first (keep-indexed (fn [i x]\n   411\t                                                                     (when (= :free (:status x)) [i x]))\n   412\t                                                                   (:slots s)))]\n   413\t                          (do (vreset! chosen [index slot])\n   414\t                              (assoc-in s [:slots index :status] :reserving))\n   415\t                          s)))\n   416\t         (if-not @chosen\n   417\t           (do (invoke-close! socket 1013 \"dao.stream/acceptance-full\")\n   418\t               {:ws/status :ws/full})\n   419\t           (let [[index slot] @chosen\n   420\t                 id (attachment-id)\n   421\t                 [handle hstate] (new-handle descriptor id (endpoint-target endpoint) :pending socket)\n   422\t                 offer {:ws/attachment id :ws/event :ws/accepted\n   423\t                        :ws/handle {:dao.stream/handle handle\n   424\t                                    :dao.stream/surface #{:writer :closable}}}\n   425\t                 result (stream/append! (:dao.stream/handle (:offer slot)) offer)]\n   426\t             (if (= :dao.stream/ok (:dao.stream/outcome result))\n   427\t               (do (swap! state (fn [s]\n   428\t                                  (-> s\n   429\t                                      (assoc-in [:slots index :status] :pending)\n   430\t                                      (assoc-in [:slots index :attachment] id)\n   431\t                                      (assoc-in [:slots index :handle] handle)\n   432\t       