       (contains? (:dao.stream/surface x) :writer)))\n    69\t\n    70\t\n    71\t(defn- checked-target\n    72\t  [target declaration]\n    73\t  (when-not (and (writer-target? target) (admission? declaration))\n    74\t    (throw (ex-info \"invalid DaoStream WebSocket deposit composition\"\n    75\t                    {:target target :admission declaration})))\n    76\t  target)\n    77\t\n    78\t\n    79\t(defn- attachment-id\n    80\t  []\n    81\t  (str (random-uuid)))\n    82\t\n    83\t\n    84\t(defn- invoke-close!\n    85\t  [socket code reason]\n    86\t  (when-let [f (:close! socket)]\n    87\t    (try\n    88\t      (f code reason)\n    89\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n    90\t        ;; The connection has already transitioned locally.  The caller adds a\n    91\t        ;; diagnostic where it still has a functioning composed medium.\n    92\t        :failed))))\n    93\t\n    94\t\n    95\t(defn- send-result\n    96\t  [socket text]\n    97\t  (try\n    98\t    (let [x ((:send! socket) text)]\n    99\t      (cond\n   100\t        (or (nil? x) (= true x) (= :ok x)) (outcome :dao.stream/ok)\n   101\t        (= false x) (outcome :dao.stream/full)\n   102\t        (and (map? x) (:dao.stream/outcome x)) x\n   103\t        :else (outcome :dao.stream/transport-error)))\n   104\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   105\t      (outcome :dao.stream/transport-error))))\n   106\t\n   107\t\n   108\t(declare receive! closed! opened! disclaimed!)\n   109\t\n   110\t\n   111\t(defn- deposit!\n   112\t  [state event]\n   113\t  (let [target (:deposit @state)\n   114\t        result (stream/append! (:dao.stream/handle target) event)]\n   115\t    ;; A host promised this medium admits all boundary events.  A failed\n   116\t    ;; deposit is therefore terminal, rather than a reason to retain a hidden\n   117\t    ;; inbox or silently discard the event.\n   118\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n   119\t      (let [socket (:socket @state)]\n   120\t        (swap! state assoc :phase :closed)\n   121\t        (invoke-close! socket 1000 \"dao.stream/deposit-failed\")))\n   122\t    result))\n   123\t\n   124\t\n   125\t(defn- emit!\n   126\t  \"Deposit one boundary event.  The four-argument form carries a payload and\n   127\t   always keys it, because nil is an ordinary portable value: a consumer must be\n   128\t   able to tell `value nil` from `no value` with `contains?`.\"\n   129\t  ([state attachment event]\n   130\t   (deposit! state {:ws/attachment attachment :ws/event event}))\n   131\t  ([state attachment event value]\n   132\t   (deposit! state {:ws/attachment attachment :ws/event event :ws/value value})))\n   133\t\n   134\t\n   135\t(defn- emit-reason!\n   136\t  [state attachment event reason]\n   137\t  (deposit! state {:ws/attachment attachment :ws/event event :ws/reason reason}))\n   138\t\n   139\t\n   140\t(defn- terminal!\n   141\t  [state attachment event]\n   142\t  (let [emit? (volatile! false)]\n   143\t    (swap! state\n   144\t           (fn [s]\n   145\t             (if (:terminal? s)\n   146\t               s\n   147\t               (do (vreset! emit? true)\n   148\t                   (assoc s :terminal? true :phase :closed)))))\n   149\t    (when @emit? (emit! state attachment event))))\n   150\t\n   151\t\n   152\t(deftype WsHandle\n   153\t  [state descriptor attachment]\n   154\t\n   155\t  stream/IDaoStreamDescriptor\n   156\t\n   157\t  (descriptor\n   158\t    [_]\n   159\t    {:dao.stream/outcome :dao.stream/ok\n   160\t     :dao.stream/descriptor descriptor\n   161\t     :dao.stream/identity (:dao.stream/identity descriptor)})\n   162\t\n   163\t\n   164\t  stream/IDaoStreamWriter\n   165\t\n   166\t  (append!\n   167\t    [_ value]\n   168\t    (let [{:keys [phase socket]} @state]\n   169\t      (cond\n   170\t        (= :closed phase) (outcome :dao.stream/closed)\n   171\t        (not= :open phase) (outcome :dao.stream/full)\n   172\t        (not (transit/portable-value? value)) (outcome :dao.stream/invalid-value)\n   173\t        :else (try\n   174\t                (send-result socket (transit/encode {:ws/frame :ws/value\n   175\t                                                     :ws/value value}))\n   176\t                (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   177\t                  (outcome :dao.stream/invalid-value))))))\n   178\t\n   179\t\n   180\t  stream/IDaoStreamClosable\n   181\t\n   182\t  (close!\n   183\t    [_]\n   184\t    (let [socket (volatile! nil)]\n   185\t      (swap! state\n   186\t             (fn [s]\n   187\t               (if (= :closed (:phase s))\n   188\t                 s\n   189\t                 (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   190\t      (when (= :failed (invoke-close! @socket 1000 \"dao.stream/detached\"))\n   191\t        (emit-reason! state attachment :ws/error :ws/close-failure))\n   192\t      (outcome :dao.stream/ok))))\n   193\t\n   194\t\n   195\t(defn close-ended!\n   196\t  \"Transport-specific close for a serving composition whose source ended.\n   197\t\n   198\t   Generic `stream/close!` is a reattachable detachment.  This helper sends the\n   199\t   WebSocket ended signal (4000 / `dao.stream/ended`) so the peer can deposit\n   200\t   `:ws/ended`.  The host close callback still owns exactly-once terminal event\n   201\t   delivery, just as it does for generic close.\"\n   202\t  [handle]\n   203\t  (let [state (.-state ^WsHandle handle)\n   204\t        attachment (.-attachment ^WsHandle handle)\n   205\t        socket (volatile! nil)]\n   206\t    (swap! state\n   207\t           (fn [s]\n   208\t             (if (= :closed (:phase s))\n   209\t               s\n   210\t               (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   211\t    (when (= :failed (invoke-close! @socket ended-close-code \"dao.stream/ended\"))\n   212\t      (emit-reason! state attachment :ws/error :ws/close-failure))\n   213\t    (outcome :dao.stream/ok)))\n   214\t\n   215\t\n   216\t(defn- new-handle\n   217\t  [descriptor attachment target phase socket]\n   218\t  (let [state (atom {:phase phase :socket socket :deposit target\n   219\t                     :resolution? false :terminal? false})]\n   220\t    [(WsHandle. state descriptor attachment) state]))\n   221\t\n   222\t\n   223\t(defn- protocol-failure!\n   224\t  [state attachment]\n   225\t  (emit-reason! state attachment :ws/error :ws/decode-failure)\n   226\t  (swap! state assoc :phase :closed)\n   227\t  (invoke-close! (:socket @state) protocol-close-code \"dao.stream/protocol-error\"))\n   228\t\n   229\t\n   230\t(defn opened!\n   231\t  \"Adapter entry: the peer's accept control was received (client), or the\n   232\t   endpoint accepted a matching handoff acknowledgement (server).\"\n   233\t  [handle]\n   234\t  (let [state (.-state ^WsHandle handle)\n   235\t        attachment (.-attachment ^WsHandle handle)\n   236\t        emit? (volatile! false)]\n   237\t    (swap! state (fn [s]\n   238\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   239\t                     (do (vreset! emit? true) (assoc s :phase :open :resolution? true))\n   240\t                     s)))\n   241\t    (when @emit? (emit! state attachment :ws/opened))))\n   242\t\n   243\t\n   244\t(defn disclaimed!\n   245\t  \"Adapter entry for the authoritative first `:ws/disclaim` control frame.\"\n   246\t  [handle]\n   247\t  (let [state (.-state ^WsHandle handle)\n   248\t        attachment (.-attachment ^WsHandle handle)\n   249\t        emit? (volatile! false)]\n   250\t    (swap! state (fn [s]\n   251\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   252\t                     (do (vreset! emit? true) (assoc s :resolution? true :phase :closed))\n   253\t                     s)))\n   254\t    (when @emit?\n   255\t      (emit! state attachment :ws/not-found)\n   256\t      (invoke-close! (:socket @state) disclaim-close-code \"dao.stream/not-found\"))))\n   257\t\n   258\t\n   259\t(defn receive!\n   260\t  \"Adapter entry for one text WebSocket message.  It performs only wire\n   261\t   validation and envelope translation; application values are never judged.\"\n   262\t  [handle text]\n   263\t  (let [state (.-state ^WsHandle handle)\n   264\t        attachment (.-attachment ^WsHandle handle)]\n   265\t    (try\n   266\t      (let [frame (transit/decode text)]\n   267\t        (cond\n   268\t          (and (= :ws/accept (:ws/frame frame)) (= :connecting (:phase @state)))\n   269\t          (opened! handle)\n   270\t\n   271\t          (and (= :ws/disclaim (:ws/frame frame)) (= :connecting (:phase @state)))\n   272\t          (disclaimed! handle)\n   273\t\n   274\t          (and (= :ws/value (:ws/frame frame))\n   275\t               (contains? frame :ws/value)\n   276\t               (= :open (:phase @state))\n   277\t               (transit/portable-value? (:ws/value frame)))\n   278\t          (emit! state attachment :ws/payload (:ws/value frame))\n   279\t\n   280\t          :else (protocol-failure! state attachment)))\n   281\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   282\t        (protocol-failure! state attachment)))))\n   283\t\n   284\t\n   285\t(defn closed!\n   286\t  \"Adapter entry for host close completion.  The terminal event is guarded so\n   287\t   close/error races cannot duplicate it.\"\n   288\t  [handle code _reason]\n   289\t  (let [state (.-state ^WsHandle handle)\n   290\t        attachment (.-attachment ^WsHandle handle)]\n   291\t    (when-not (:resolution? @state)\n   292\t      (swap! state assoc :resolution? true)\n   293\t      (emit! state attachment :ws/transport-error))\n   294\t    (terminal! state attachment (if (= ended-close-code code) :ws/ended :ws/closed))))\n   295\t\n   296\t\n   297\t(defn adapter\n   298\t  \"The only callback-shaped value, for a host socket adapter while wiring its\n   299\t   private listener.  It is not a DaoStream API and never reaches consumers.\"\n   300\t  [handle]\n   301\t  {:opened! #(opened! handle)\n   302\t   :disclaimed! #(disclaimed! handle)\n   303\t   :message! #(receive! handle %)\n   304\t   :closed! #(closed! handle %1 %2)\n   305\t   :error! #(emit-reason! (.-state ^WsHandle handle) (.-attachment ^WsHandle handle)\n   306\t                          :ws/error :ws/socket-error)})\n   307\t\n   308\t\n   309\t(defn make-attacher\n   310\t  \"Construct the host-composed unary `attach!` entry point.\n   311\t\n   312\t   `:connect!` receives the descriptor and the private adapter map, starts\n   313\t   connection establishment, and synchronously returns a raw-socket adapter\n   314\t   containing `:send!` and `:close!`.  It must not wait for the peer.\"\n   315\t  [{:keys [traffic admission connect!] :as config}]\n   316\t  (let [target (checked-target traffic admission)]\n   317\t    (when-not (fn? connect!)\n   318\t      (throw (ex-info \"WebSocket host composition requires :connect!\" {:config config})))\n   319\t    (fn attach!\n   320\t      [descriptor]\n   321\t      (if-not (descriptor? descriptor)\n   322\t        (outcome :dao.stream/invalid-descriptor)\n   323\t        (let [id (attachment-id)\n   324\t              [handle state] (new-handle descriptor id target :connecting nil)]\n   325\t          (try\n   326\t            (let [socket (connect! descriptor (adapter handle))]\n   327\t              (if (and (map? socket) (fn? (:send! socket)) (fn? (:close! socket)))\n   328\t                (do (swap! state assoc :socket socket)\n   329\t                    {:dao.stream/outcome :dao.stream/ok\n   330\t                     :dao.stream/handle handle\n   331\t                     :dao.stream/attachment id})\n   332\t                (outcome :dao.stream/transport-error)))\n   333\t            (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   334\t              (outcome :dao.stream/transport-error))))))))\n   335\t\n   336\t\n   337\t;; Server acceptance is intentionally an endpoint composition object, not a\n   338\t;; global transport directory.  Its slots are supplied and owned by the host.\n   339\t(defn make-endpoint\n   340\t  [{:keys [served control control-admission slots] :as config}]\n   341\t  (let [control-target (checked-target control control-admission)]\n   342\t    (when-not (and (map? served) (seq slots))\n   343\t      (throw (ex-info \"WebSocket endpoint needs served paths and handoff slots\" {:config config})))\n   344\t    (when-not (= :portable-values (:value-domain control-admission))\n   345\t      (throw (ex-info \"endpoint control medium must carry portable values\" {:admission control-admission})))\n   346\t    (doseq [[path descriptor] served]\n   347\t      (when-not (and (= path (:ws/path descriptor)) (descriptor? descriptor))\n   348\t        (throw (ex-info \"invalid served descriptor\" {:path path :descriptor descriptor}))))\n   349\t    (doseq [slot slots]\n   350\t      (checked-target (:offer slot) (:offer-admission slot))\n   200\t        (doseq [attachment (keys (:sessions (state serving)))]\n   201\t          (close-session! serving attachment))\n   202\t        (let [result (try\n   203\t                       ((:stop-endpoint! (:config serving)) (:endpoint (state serving)))\n   204\t                       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   205\t                         {:dao.stream/outcome :dao.stream/transport-error}))]\n   206\t          (swap! (:state serving) assoc :lifecycle :stopped :stop-result result)\n   207\t          result)))))\n   208\t\n   209\t\n   210\t(defn- offer-descriptor\n   211\t  [offer]\n   212\t  (let [handle (get-in offer [:ws/handle :dao.stream/handle])]\n   213\t    (when (stream/descriptor? handle)\n   214\t      (let [result (stream/descriptor handle)]\n   215\t        (when (= :dao.stream/ok (:dao.stream/outcome result))\n   216\t          (:dao.stream/descriptor result))))))\n   217\t\n   218\t\n   219\t(defn- acknowledge-offer!\n   220\t  [serving slot-index offer]\n   221\t  (let [{:keys [served make-traffic close-attachment!]} (:config serving)\n   222\t        attachment (:ws/attachment offer)\n   223\t        socket-handle (get-in offer [:ws/handle :dao.stream/handle])\n   224\t        descriptor (offer-descriptor offer)\n   225\t        entry (get served (:ws/path descriptor))\n   226\t        source (:stream entry)]\n   227\t    (if-not (and (= :ws/accepted (:ws/event offer))\n   228\t                 (string? attachment)\n   229\t                 (stream/writer? socket-handle)\n   230\t                 (stream/closable? socket-handle)\n   231\t                 (= (:dao.stream/identity descriptor)\n   232\t                    (:dao.stream/identity (:descriptor entry))))\n   233\t      (call-close! close-attachment! socket-handle)\n   234\t      (let [source-cursor (when source\n   235\t                            (stream/cursor source\n   236\t                                           (or (:forward-anchor (:config serving))\n   237\t                                               stream/anchor-oldest)))\n   238\t            session (when (= :dao.stream/ok (:dao.stream/outcome source-cursor))\n   239\t                      (traffic-session offer (make-traffic offer)))]\n   240\t        (if-not session\n   241\t          (call-close! close-attachment! socket-handle)\n   242\t          (let [ack {:ws/attachment attachment\n   243\t                     :ws/command :ws/accept\n   244\t                     :ws/deposit (:traffic session)\n   245\t                     :ws/admission (:admission session)}\n   246\t                ack-writer (get-in (:config serving) [:slots slot-index :ack-writer])\n   247\t                appended (stream/append! (:dao.stream/handle ack-writer) ack)]\n   248\t            (if (= :dao.stream/ok (:dao.stream/outcome appended))\n   249\t              (swap! (:state serving) assoc-in\n   250\t                     [:sessions attachment]\n   251\t                     (assoc session\n   252\t                            :path (:ws/path descriptor)\n   253\t                            :identity (:dao.stream/identity descriptor)\n   254\t                            :source source\n   255\t                            :forward-state (forward/initial-state\n   256\t                                             (:dao.stream/cursor source-cursor))))\n   257\t              (call-close! close-attachment! socket-handle))))))))\n   258\t\n   259\t\n   260\t(defn- poll-offers!\n   261\t  [serving]\n   262\t  (doseq [[index slot] (map-indexed vector (:slots (:config serving)))]\n   263\t    (let [cursor (get-in (state serving) [:offer-cursors index])\n   264\t          reader (target-handle (:offer-reader slot))\n   265\t          result (stream/next reader cursor)]\n   266\t      (when (= :dao.stream/ok (:dao.stream/outcome result))\n   267\t        (swap! (:state serving) assoc-in [:offer-cursors index]\n   268\t               (:dao.stream/cursor result))\n   269\t        (acknowledge-offer! serving index (:dao.stream/value result))))))\n   270\t\n   271\t\n   272\t(defn- poll-control!\n   273\t  [serving]\n   274\t  (let [{:keys [control-reader]} (:config serving)\n   275\t        result (stream/next (target-handle control-reader)\n   276\t                            (:control-cursor (state serving)))]\n   277\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   278\t      (swap! (:state serving) assoc :control-cursor (:dao.stream/cursor result))\n   279\t      (let [event (:dao.stream/value result)]\n   280\t        ;; Only pre-accept lifecycle belongs in control.  An established\n   281\t        ;; attachment's lifecycle is observed through its own traffic medium.\n   282\t        (when (terminal-event? event)\n   283\t          (remove-session! serving (:ws/attachment event)))))))\n   284\t\n   285\t\n   286\t(defn- poll-traffic!\n   287\t  [serving attachment session]\n   288\t  (let [result (stream/next (:traffic-reader session) (:traffic-cursor session))]\n   289\t    (case (:dao.stream/outcome result)\n   290\t      :dao.stream/ok\n   291\t      (let [event (:dao.stream/value result)]\n   292\t        (if (terminal-event? event)\n   293\t          (remove-session! serving attachment)\n   294\t          (do\n   295\t            (swap! (:state serving) assoc-in [:sessions attachment :traffic-cursor]\n   296\t                   (:dao.stream/cursor result))\n   297\t            ;; This is an interpreter call made by the driver, never a host\n   298\t            ;; callback.  With no interpreter, requests stay ordinary traffic\n   299\t            ;; data and are intentionally not appended to the served stream.\n   300\t            (when-let [interpret (:inbound-step (:config serving))]\n   301\t              (interpret session event)))))\n   302\t\n   303\t      :dao.stream/blocked nil\n   304\t\n   305\t      ;; A traffic gap or terminal reader failure means this composition can no\n   306\t      ;; longer faithfully associate inbound events with the attachment.\n   307\t      (close-session! serving attachment))))\n   308\t\n   309\t\n   310\t(defn- advance-forwarder!\n   311\t  [serving attachment session]\n   312\t  (let [result (forward/forward-step (:source session)\n   313\t                                     (:socket-handle session)\n   314\t                                     (:forward-state session)\n   315\t                                     (:forward-options (:config serving)))]\n   316\t    (case (:status result)\n   317\t      (:continue :retry)\n   318\t      (swap! (:state serving) assoc-in [:sessions attachment :forward-state] result)\n   319\t\n   320\t      :source-ended\n   321\t      (do\n   322\t        ;; Generic close! is only detachment.  This injected policy is the\n   323\t        ;; transport-specific 4000 ended-stream close required by ws protocol.\n   324\t        (call-close! (:close-ended! (:config serving)) (:socket-handle session))\n   325\t        (remove-session! serving attachment))\n   326\t\n   327\t      (close-session! serving attachment))))\n   328\t\n   329\t\n   330\t(defn step!\n   331\t  \"Advance exactly one host-owned driver tick at `now`.\n   332\t\n   333\t   Ordering is intentional: transport acceptance/expiry first, then offer and\n   334\t   control observation, then each established attachment's traffic interpreter\n   335\t   and forwarder.  This function never waits, schedules itself, or installs a\n   336\t   callback; cadence is entirely the caller's policy.\"\n   337\t  [serving now]\n   338\t  (when (= :running (:lifecycle (state serving)))\n   339\t    (let [endpoint (:endpoint (state serving))\n   340\t          next-endpoint ((:endpoint-step (:config serving)) endpoint now)]\n   341\t      (when next-endpoint\n   342\t        (swap! (:state serving) assoc :endpoint next-endpoint)))\n   343\t    (poll-offers! serving)\n   344\t    (poll-control! serving)\n   345\t    ;; Snapshot keys: traffic/lifecycle handling can remove a session during\n   346\t    ;; this tick without changing which already-admitted sessions are advanced.\n   347\t    (doseq [attachment (keys (:sessions (state serving)))]\n   348\t      (when-let [session (get-in (state serving) [:sessions attachment])]\n   349\t        (poll-traffic! serving attachment session))\n   350\t      (when-let [session (get-in (state serving) [:sessions attachment])]\n   351\t        (advance-forwarder! serving attachment session))))\n   352\t  serving)\n","exit_code":0,"status":"completed"}}
