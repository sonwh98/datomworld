{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '100,150p'; nl -ba src/cljc/yin/vm/ffi.cljc | sed -n '25,95p'; nl -ba src/cljc/yin/vm.cljc | sed -n '2035,2055p'\"","aggregated_output":"   100\t         :stack (or St [])\n   101\t         :env E\n   102\t         :k (if (seq K) K nil)\n   103\t         :halted? (and (not (:blocked? vm)) (nil? seg))))\n   104\t\n   105\t\n   106\t(defn- response-wait-entry\n   107\t  \"The polling wait entry for a sent call awaiting its correlated response:\n   108\t   the machine registers {segment pc env stack k} plus the call-out reader\n   109\t   fields, in the shape `ffi/call-response-wait-entry` gives the walker.\"\n   110\t  [seg pc env stack k call-id]\n   111\t  {:segment seg, :pc pc, :env env, :stack stack, :k k,\n   112\t   :call-id call-id,\n   113\t   :reason :next,\n   114\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   115\t   :stream-id vm/call-out-stream-key})\n   116\t\n   117\t\n   118\t(defn semantic-restore\n   119\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   120\t\n   121\t   Two entry shapes carry more than registers:\n   122\t\n   123\t   - A `:request-sent` entry is a writer whose retained FFI request has now\n   124\t     been appended. The call starts waiting for its correlated response,\n   125\t     exactly as an immediately-sent one does, so the entry is replaced by its\n   126\t     response reader and the machine stays blocked.\n   127\t   - A `:call-id` entry is a response reader. The woken value is a response\n   128\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\n   129\t     parked call leaves `:parked` rather than accumulating.\"\n   130\t  ([base entry] (semantic-restore base entry (:value entry)))\n   131\t  ([base entry val]\n   132\t   (if (:request-sent entry)\n   133\t     (assoc base\n   134\t            :wait-set (conj (vec (or (:wait-set base) []))\n   135\t                            (response-wait-entry (:segment entry)\n   136\t                                                 (:pc entry)\n   137\t                                                 (:env entry)\n   138\t                                                 (:stack entry)\n   139\t                                                 (:k entry)\n   140\t                                                 (:call-id entry)))\n   141\t            :control nil\n   142\t            :k nil\n   143\t            :value :yin/blocked\n   144\t            :blocked? true\n   145\t            :halted? false)\n   146\t     (let [call-id (:call-id entry)\n   147\t           base (if call-id (update base :parked dissoc call-id) base)\n   148\t           val (if call-id (ffi/call-result val call-id) val)]\n   149\t       (put-registers base\n   150\t                      (:segment entry)\n    25\t   wait set and the ordinary scheduler wakes it when the response lands.\"\n    26\t  (:require [dao.data :as data]\n    27\t            [dao.stream :as stream]\n    28\t            [dao.stream.apply :as apply2]\n    29\t            [yin.vm :as vm]\n    30\t            [yin.vm.telemetry :as telemetry]))\n    31\t\n    32\t\n    33\t(defn call-pair\n    34\t  \"Return {:call-in h :call-out h} from a VM's private `:resources` table,\n    35\t   or nil when the VM was built without a pair. The pair never lives in the\n    36\t   store (yin.vm.linker.md section 7.3, r8).\"\n    37\t  [resources]\n    38\t  (let [in (get resources vm/call-in-stream-key)\n    39\t        out (get resources vm/call-out-stream-key)]\n    40\t    (when (and in out) {:call-in in, :call-out out})))\n    41\t\n    42\t\n    43\t(defn require-call-pair!\n    44\t  \"Fail when the VM holds no FFI pair. Callers must run this before parking:\n    45\t   an error raised after `park-continuation` strands a continuation in\n    46\t   `:parked` and consumes an id counter.\"\n    47\t  [resources what]\n    48\t  (or (call-pair resources)\n    49\t      (throw (ex-info \"This VM was constructed without an FFI call pair, so it cannot make a dao.stream.apply call\"\n    50\t                      {:what what}))))\n    51\t\n    52\t\n    53\t(defn call-response-wait-entry\n    54\t  \"The polling wait entry for a sent call awaiting its correlated response.\"\n    55\t  [call-id next-k env]\n    56\t  {:k {:type :dao.stream.apply/eval-call,\n    57\t       :next next-k,\n    58\t       :env env,\n    59\t       :call-id call-id},\n    60\t   :env env,\n    61\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n    62\t   :reason :next,\n    63\t   :stream-id vm/call-out-stream-key})\n    64\t\n    65\t\n    66\t(defn response-wait-entry\n    67\t  \"The polling wait entry for a sent call awaiting its correlated response,\n    68\t   for an arbitrary register payload (`yin.vm.engine.md` section 7, edit 3).\n    69\t\n    70\t   `entry` is a wait, ready, or parked record as the VM built it: the\n    71\t   writer entry that retried the request, or the registers of a call whose\n    72\t   request was sent at once. The FFI keys of the writer step\n    73\t   (`:request-sent`, `:op`) and its retried `:datom` are removed; the\n    74\t   call-out reader keys are added. Every other key -- the VM's register\n    75\t   payload, whatever its shape -- is preserved verbatim, so no VM has to\n    76\t   know this layout. `call-response-wait-entry` (the walker's frame-typed\n    77\t   shape) is unchanged.\"\n    78\t  [entry call-id]\n    79\t  (-> entry\n    80\t      (dissoc :value :status :cursor :resource-updates :stream\n    81\t              :datom :type :id :request-sent :op)\n    82\t      (assoc :call-id call-id\n    83\t             :reason :next\n    84\t             :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key}\n    85\t             :stream-id vm/call-out-stream-key)))\n    86\t\n    87\t\n    88\t(defn call-result\n    89\t  \"Unwrap a response envelope for the continuation that made the call.\n    90\t\n    91\t   v1 read `:dao.stream.apply/value` off a response that could only succeed.\n    92\t   A v2 response carries exactly one of `ok` or `error`, and correlation is\n    93\t   checked here rather than assumed from stream order.\"\n    94\t  [response call-id]\n    95\t  (when-not (apply2/response? response)\n  2035\t                                     (swap! created conj h)\n  2036\t                                     h))\n  2037\t                       call-out (or supplied-out\n  2038\t                                    (let [h (create-stream! make-stream\n  2039\t                                                            capacity\n  2040\t                                                            :call-out)]\n  2041\t                                      (swap! created conj h)\n  2042\t                                      h))]\n  2043\t                   {call-in-stream-key call-in,\n  2044\t                    call-out-stream-key call-out,\n  2045\t                    call-out-cursor-key (cursor-entry call-out-stream-key\n  2046\t                                                      (mint-oldest call-out\n  2047\t                                                                   :call-out))})\n  2048\t                 (catch #?(:cljd Object :clj Throwable :cljs :default) e\n  2049\t                   (doseq [h @created] (close-quietly h))\n  2050\t                   (throw e)))))]\n  2051\t       {:store {},\n  2052\t        :resources (cond-> (or pair-store {})\n  2053\t                     (:link-request opts)\n  2054\t                     (assoc :yin.link/request (:link-request opts))\n  2055\t                     (:link-response opts)\n","exit_code":0,"status":"completed"}}
