ey])\n   533\t        receiver (-> (quiesced-receiver datoms lowered own)\n   534\t                     (update :resources #(merge own-pair %)))\n   535\t        oldest (fn [h]\n   536\t                 (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n   537\t        ;; the emitter's bridge answered the migrated call before the\n   538\t        ;; migration: the response sits on the emitter's call-out, past\n   539\t        ;; the kept cursor\n   540\t        r1 (do (stream/append! call-out-src\n   541\t                               (apply2/success-response\n   542\t                                 (:call-id entry) \"echo!\"))\n   543\t               ;; phase 1: the engine's sweep retries the request\n   544\t               ;; through the route and parks the restored response\n   545\t               ;; wait\n   546\t               (vm/run receiver))\n   547\t        warm-up (stream/next call-in-src (oldest call-in-src))\n   548\t        _ (serve-mirror! peer)\n   549\t        landed (stream/next call-in-src (oldest call-in-src))\n   550\t        ;; phase 2: the migrated call resumes and the program's own\n   551\t        ;; next call parks on the receiver's own pair\n   552\t        r2 (vm/run r1)\n   553\t        b-request (stream/next own-call-in (oldest own-call-in))\n   554\t        _ (serve-mirror! peer)\n   555\t        crossed (stream/next call-in-src (oldest call-in-src))\n   556\t        b-response (apply2/success-response\n   557\t                     (apply2/request-id (:dao.stream/value b-request))\n   558\t                     \"world!\")\n   559\t        ;; the receiver's own bridge serves the new call on its own\n   560\t        ;; pair; the outstanding call has discharged, and pending-call\n   561\t        ;; routing and future-call routing are separate stores of\n   562\t        ;; state, so the composition re-points its spent route at its\n   563\t        ;; own pair\n   564\t        _ (stream/append! own-call-out b-response)\n   565\t        r3 (vm/run (assoc-in r2\n   566\t                             [:resources vm/call-out-cursor-key]\n   567\t                             (get own-pair vm/call-out-cursor-key)))]\n   568\t    (testing \"the machine parked through the engine, request retained\"\n   569\t      (is (vm/blocked? parked))\n   570\t      (is (true? (:request-sent entry)))\n   571\t      (is (= vm/call-in-stream-key (:stream-id entry)))\n   572\t      (is (apply2/request? (:datom entry))))\n   573\t    (testing \"the lift carries the response route as a cell\"\n   574\t      (is (= :yin.k/c-0 (:yin.k/response-cell pending)))\n   575\t      (is (= kept\n   576\t             (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   577\t          \"the emitter's call-out cursor at its kept position\"))\n   578\t    (testing \"the lower routes the outstanding call, not the pair\"\n   579\t      (is (not= vm/call-in-stream-key (:stream-id e))\n   580\t          \"the retry does not take the receiver's own call-in key\")\n   581\t      (is (contains? rs (:stream-id e))\n   582\t          \"it appends on the emitter's own call-in reflection\")\n   583\t      (is (not (contains? rs vm/call-in-stream-key)))\n   584\t      (is (not (contains? rs vm/call-out-stream-key))\n   585\t          \"the resumer's own pair is not replaced\")\n   586\t      (let [route (get rs vm/call-out-cursor-key)]\n   587\t        (is (= kept (:cursor route))\n   588\t            \"the route cell lowers as the restored wait's cursor entry\")\n   589\t        (is (not= vm/call-out-stream-key (:stream-id route))\n   590\t            \"naming the emitter's call-out, not the receiver's key\")\n   591\t        (is (contains? rs (:stream-id route))\n   592\t            \"which is attached, so the wait resolves it\")))\n   593\t    (testing \"the retried response reaches its waiter, emitter's pair\"\n   594\t      (is (vm/blocked? r1)\n   595\t          \"first round: the request is retried, the response not yet\n   596\t           read\")\n   597\t      (is (= :warmed (:dao.stream/value warm-up))\n   598\t          \"reading the warm-up freed the slot the retry needed\")\n   599\t      (is (= :dao.stream/ok (:dao.stream/outcome landed)))\n   600\t      (is (= (:datom entry) (:dao.stream/value landed))\n   601\t          \"the retained request verbatim, on the emitter's call-in\")\n   602\t      (is (vm/blocked? r2)\n   603\t          \"the migrated call resumes and the program calls again\")\n   604\t      (is (= :next (:reason (first (:wait-set r2))))\n   605\t          \"the program's own new call is the one waiting now\"))\n   606\t    (testing \"the new call flows on the receiver's own pair\"\n   607\t      (is (= :dao.stream/ok (:dao.stream/outcome b-request)))\n   608\t      (is (= [\"world\"] (apply2/request-args (:dao.stream/value b-request)))\n   609\t          \"the future call's request is on the receiver's own call-in\")\n   610\t      (is (= :dao.stream/blocked (:dao.stream/outcome crossed))\n   611\t          \"and nothing crossed to the emitter's call-in\"))\n   612\t    (testing \"the receiver's own bridge answers and the program halts\"\n   613\t      (is (= \"world!\" (apply2/response-ok b-response)))\n   614\t      (is (vm/halted? r3))\n   615\t      (is (= \"world!\" (vm/value r3)))\n   616\t      (is (empty? (:wait-set r3))))))\n   617\t\n   618\t\n   619\t;; =============================================================================\n   620\t;; Unsatisfied: an unpublishable cursor, a source that cannot be\n   621\t;; served, a gone reflection\n   622\t;; =============================================================================\n   623\t\n   624\t(defn- host-cursor-stream\n   625\t  \"A handle whose cursors hold a host object -- the case\n   890\t                   {:stream-id :yin/call-out, :cursor 5}}\n   891\t        entry {:reason :next, :call-id :call-7, :op :op/add,\n   892\t               :cursor-ref {:type :cursor-ref, :id :yin/call-out-cursor},\n   893\t               :stream-id :yin/call-out}\n   894\t        lifted (ucf.remote/lift-pending serve! resources entry)\n   895\t        pending (:yin.k/pending lifted)]\n   896\t    (is (= :ffi (:yin.k/reason pending)))\n   897\t    (is (= :call-7 (:yin.k/call-id pending)))\n   898\t    (is (= :op/add (:yin.k/op pending)))\n   899\t    (is (= :yin.k/c-0 (:yin.k/cell pending)))\n   900\t    (is (= 5 (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   901\t        \"the response cell at its KEPT position\")\n   902\t    (let [ctx {:segment 0, :pc 9, :env {}, :stack [], :k []}\n   903\t          lowered (ucf.remote/lower-pending attach! pending\n   904\t                                            (:yin.k/cells lifted) ctx)\n   905\t          e (:entry lowered)]\n   906\t      (is (= :next (:reason e)) \"the response wait is a :next waiter\")\n   907\t      (is (= :call-7 (:call-id e)))\n   908\t      (is (= :op/add (:op e)))\n   909\t      (is (= :yin.k/c-0 (get-in e [:cursor-ref :id])))\n   910\t      (is (= 5 (get-in lowered [:resources (:yin.k/cell pending)\n   911\t                                :cursor]))))))\n   912\t\n   913\t\n   914\t(deftest ffi-retained-round-trips\n   915\t  (let [serve! (stub-serve! chan)\n   916\t        attach! (stub-attach!)\n   917\t        envelope (apply2/request :call-7 :op/add [1 2])\n   918\t        resources {vm/call-in-stream-key [:handle :call-in],\n   919\t                   vm/call-out-stream-key [:handle :call-out],\n   920\t                   vm/call-out-cursor-key\n   921\t                   {:stream-id vm/call-out-stream-key, :cursor 2}}\n   922\t        entry {:reason :put, :request-sent true, :call-id :call-7,\n   923\t               :op :op/add, :stream-id vm/call-in-stream-key,\n   924\t               :datom envelope}\n   925\t        lifted (ucf.remote/lift-pending serve! resources entry)\n   926\t        pending (:yin.k/pending lifted)]\n   927\t    (is (= :ffi-request (:yin.k/reason pending)))\n   928\t    (is (= :call-7 (:yin.k/call-id pending)))\n   929\t    (is (= :op/add (:yin.k/request-op pending)))\n   930\t    (is (= [1 2] (:yin.k/request-args pending)))\n   931\t    (is (= :yin.k/c-0 (:yin.k/response-cell pending))\n   932\t        \"the response route rides as a cell\")\n   933\t    (is (= 2 (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   934\t        \"the route cell at the emitter's kept call-out position\")\n   935\t    (is (= #{:dao.stream.remote/v1}\n   936\t           (get-in lifted [:yin.k/requires :yin.k/cursor-profiles]))\n   937\t        \"the frame carries a cursor profile: the route is a cell\")\n   938\t    (let [ctx {:segment 0, :pc 5, :env {}, :stack [], :k []}\n   939\t          lowered (ucf.remote/lower-pending attach! pending\n   940\t                                            (:yin.k/cells lifted) ctx)\n   941\t          e (:entry lowered)\n   942\t          rs (:resources lowered)]\n   943\t      (is (= :put (:reason e)))\n   944\t      (is (true? (:request-sent e)))\n   945\t      (is (= :call-7 (:call-id e)))\n   946\t      (is (= envelope (:datom e))\n   947\t          \"the envelope rebuilt verbatim under its call id\")\n   948\t      (is (not= vm/call-in-stream-key (:stream-id e))\n   949\t          \"the retry does not take the receiver's own call-in key\")\n   950\t      (is (= [:reflection-of\n   951\t              (get-in pending [:yin.k/request :dao.stream/identity])]\n   952\t             (get rs (:stream-id e)))\n   953\t          \"it appends on the emitter's own call-in reflection\")\n   954\t      (is (not (contains? rs vm/call-in-stream-key)))\n   955\t      (is (not (contains? rs vm/call-out-stream-key))\n   956\t          \"the resumer's own pair is not replaced\")\n   957\t      (let [route (get rs vm/call-out-cursor-key)\n   958\t            route-id (get-in lifted [:yin.k/cells :yin.k/c-0\n   959\t                                     :yin.k/stream\n   960\t                                     