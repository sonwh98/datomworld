ngine.cljc:1434:           :cursor-id (:id (:cursor-ref entry))})\nsrc/cljc/yin/vm/engine.cljc:1436:                {:outcome o, :stream-id (:stream-id entry)})))\n","exit_code":0,"status":"completed"}}
