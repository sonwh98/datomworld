)\n   746\t\n   747\t\n   748\t(deftest live-renewal-keeps-the-export-served\n   749\t  (let [t (toy)\n   750\t        b (rs/open! (opts t))\n   751\t        h (ring 4)\n   752\t        _ (stream/append! h :v)\n   753\t        id (:dao.stream/identity (rs/serve! b h))\n   754\t        l (:dao.lease/lease (rs/lease-of b id))\n   755\t        _ (tick-step! t b 1)\n   756\t        p (peer (:a-end t))\n   757\t        hd (holder p b id)]\n   758\t    (doseq [ms (range 2 61)]\n   759\t      (holder-pass! hd ms)\n   760\t      (tick-step! t b ms))\n   761\t    (is (= (grant-of t id) (h/grant @hd))\n   762\t        \"the grant it holds is the one on the grantor's stream, read\n   763\t         through the served lease-grants entry\")\n   764\t    (is (< 10 (::h/renewals @hd)) \"the holder renewed throughout\")\n   765\t    (is (h/holding? @hd)\n   766\t        \"its bound advanced only on the source's ok\")\n   767\t    (is (empty? (lapses t)) \"no reclaim over 60 lease ticks: 5 durations\")\n   768\t    (is (= l (:dao.lease/lease (rs/lease-of b id))))\n   769\t    (is (contains? (get-in (rs/judge b) [:ledger]) l))\n   770\t    (is (<= 58 (get-in (rs/judge b) [:ledger l :last-observation :ms]))\n   771\t        \"the judge counted the latest renewal\")\n   772\t    (let [refl (reflect p id)\n   773\t          c (poll! b #(stream/cursor refl :dao.stream/oldest))]\n   774\t      (is (= :v (:dao.stream/value\n   775\t                  (poll! b #(stream/next refl (:dao.stream/cursor c)))))\n   776\t          \"the export still answers under its one identity\"))))\n   777\t\n   778\t\n   779\t(defn- recording-writer\n   780\t  \"The grantor's writer, noting at each :lapsed append whether the\n   781\t   reclaimed subject was still in the published table.\"\n   782\t  [inner b-ref seen]\n   783\t  (reify\n   784\t    stream/IDaoStreamWriter\n   785\t\n   786\t    (append!\n   787\t      [_ v]\n   788\t      (when (= :dao.lease/lapsed (:dao.lease/status v))\n   789\t        (let [b @b-ref\n   790\t              subject (some #(when (= (:dao.lease/lease v) (:lease %))\n   791\t                               (:identity %))\n   792\t                            @(:entries-at-grant b))]\n   793\t          (swap! seen conj {:cause (:dao.lease/cause v)\n   794\t                            :subject-published?\n   795\t                            (contains? (rs/table (:binding b)) subject)})))\n   796\t      (stream/append! inner v))))\n   797\t\n   798\t\n   799\t(defn- recorded-binding\n   800\t  \"A binding whose grantor writer records the table at each :lapsed.\"\n   801\t  [t o]\n   802\t  (let [b-ref (atom nil)\n   803\t        seen (atom [])\n   804\t        b (rs/open! (assoc o ::rs/lease-writer\n   805\t                           (recording-writer (:grants t) b-ref seen)))]\n   806\t    (reset! b-ref {:binding b :entries-at-grant (atom [])})\n   807\t    {:binding b\n   808\t     :seen seen\n   809\t     :remember! #(swap! (:entries-at-grant @b-ref) into (rs/entries b))}))\n   810\t\n   811\t\n   812\t(deftest expiry-reclaims-through-retire\n   813\t  (let [t (toy)\n   814\t        {b :binding seen :seen remember! :remember!} (recorded-binding t (opts t))\n   815\t        h (ring 4)\n   816\t        id (:dao.stream/identity (rs/serve! b h))\n   817\t        {l :dao.lease/lease renewal ::rs/renewal} (rs/lease-of b id)\n   818\t        rid (:dao.stream/identity renewal)]\n   819\t    (remember!)\n   820\t    (tick-step! t b 1)\n17:   lease-grants entry and renews and releases through a real\n86:           :grants (ring 256))))\n99:   ::rs/lease-writer (:grants t)\n100:   ::rs/lease-grants (:grants t)\n150:  \"The published table without the grantor's standing `lease-grants`\n153:  (dissoc (rs/table b) (:dao.stream/identity (rs/lease-grants b))))\n171:  (filter #(= :dao.lease/lapsed (:dao.lease/status %)) (values (:grants t))))\n180:        (values (:grants t))))\n284:   reflection of the binding's served `lease-grants` entry -- nothing\n291:                    ::h/lease-grants (rs/lease-grants b)\n300:                    ::h/grants-medium (assoc per-author-medium :capacity 256)\n365:               ::rs/lease-grants ::rs/lease-renewal-capacity]]\n394:             [::rs/lease-grants nil \"no grants reader\"]\n395:             [::rs/lease-grants (reify\n398:              \"a grants stream that cannot be read remotely\"]\n423:      (is (empty? (values (:grants t))))\n663:    (testing \"the lease-grants stream too: refused at open!, nothing served\"\n664:      (is (= [{::rs/option ::rs/lease-grants, ::rs/reason ::rs/malformed}]\n667:                                ::rs/codec (refusing-codec (:grants t))))))))))\n725:(deftest serving-grants-a-lease-to-a-served-renewal-medium\n740:    (is (empty? (values (:grants t))) \"no pass yet: the grant is queued\")\n763:         through the served lease-grants entry\")\n805:                           (recording-writer (:grants t) b-ref seen)))]\n869:    (is (= (grant-of t id) (h/grant @hd)) \"observed through lease-grants\")\n892:(deftest an-evicted-grant-is-terminal-loss-for-the-holder\n893:  (let [t (assoc (toy) :grants (ring 2))\n900:    ;; first pass: the grants cursor is asked for, not yet answered\n904:    (stream/append! (:grants t) (lease/renewal \"other-1\"))\n905:    (stream/append! (:grants t) (lease/renewal \"other-2\"))\n910:    (is (= :dao.stream/gap (h/lost @hd))\n1070:                             (flaky-writer (:grants t) refuse?)))\n","exit_code":0,"status":"completed"}}
