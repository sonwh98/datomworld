he RESPONSE endpoint's identity\")))\n  1265\t    (is (contains? pending :yin.k/request)\n  1266\t        \"both route markers and the cell survive in the UCF entry\")\n  1267\t    (is (contains? pending :yin.k/response))\n  1268\t    (is (contains? pending :yin.k/response-cell))))\n  1269\t\n  1270\t\n  1271\t(deftest retained-lower-refuses-a-pend-without-its-envelope\n  1272\t  (let [serve! (stub-serve! chan)\n  1273\t        resources (retained-resources (one-slot-stream \"call-in\")\n  1274\t                                      (one-slot-stream \"call-out\") 2)\n  1275\t        lifted (ucf.remote/lift-pending serve! resources retained-entry)\n  1276\t        ;; lift always sets the envelope, so a pend without one is\n  1277\t        ;; malformed -- it must refuse, not rebuild from the views\n  1278\t        pending (dissoc (:yin.k/pending lifted) :yin.k/request-envelope)\n  1279\t        req-id (get-in pending [:yin.k/request :dao.stream/identity])\n  1280\t        lowered (ucf.remote/lower-pending (stub-attach!) pending\n  1281\t                                          (:yin.k/cells lifted)\n  1282\t                                          {:segment 0, :pc 5} {})]\n  1283\t    (is (= :yin.k/unsatisfied (:yin.k/status lowered))\n  1284\t        \"no silent rebuild from the op/args views: the carried\n  1285\t         envelope is the only `:datom` a retry appends\")\n  1286\t    (is (= req-id (:dao.stream/identity lowered))\n  1287\t        \"naming the request identity\")))\n  1288\t\n  1289\t\n  1290\t(deftest two-separately-lowered-frames-get-distinct-fresh-keys\n  1291\t  (let [serve! (stub-serve! chan)\n  1292\t        attach! (stub-attach!)\n  1293\t        s (ring 8)\n  1294\t        _ (stream/append! s \"v\")\n  1295\t        c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n  1296\t        resources {:yin/s s, :yin/c {:stream-id :yin/s, :cursor c0}}\n  1297\t        entry {:reason :next,\n  1298\t               :cursor-ref {:type :cursor-r