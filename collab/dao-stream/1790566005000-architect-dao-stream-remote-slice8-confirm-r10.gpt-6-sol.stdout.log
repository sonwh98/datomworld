{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '310,380p;480,670p'; nl -ba test/yin/vm/ucf/remote_test.cljc | sed -n '510,590p;970,1030p;1180,1300p'\"","aggregated_output":"   310\t\n   311\t\n   312\t(defn- call-out-cell\n   313\t  \"The emitter's call-out cursor cell -- the response route the\n   314\t   retained call had on the emitter: the cursor entry under\n   315\t   `vm/call-out-cursor-key`, reading the call-out stream under\n   316\t   `vm/call-out-stream-key` at its kept position. nil when the\n   317\t   composition holds no call pair, which no real retained request\n   318\t   does -- the pair is checked before the call parked.\"\n   319\t  [resources]\n   320\t  (let [cursor (get resources vm/call-out-cursor-key)\n   321\t        handle (get resources vm/call-out-stream-key)]\n   322\t    (when (and (map? cursor) (contains? cursor :stream-id) handle)\n   323\t      {:id vm/call-out-cursor-key,\n   324\t       :stream-id vm/call-out-stream-key,\n   325\t       :cursor (:cursor cursor)})))\n   326\t\n   327\t\n   328\t(defn- lift-retained-request\n   329\t  \"S7.4.3's retained call: a `:put` entry carrying `:request-sent`,\n   330\t   the request the engine holds unsent. Both endpoints are served --\n   331\t   the request stream's marker and the response stream's marker,\n   332\t   `call-out-cell`'s -- and the retained envelope rides VERBATIM\n   333\t   (`:yin.k/request-envelope`) beside the kept response cell\n   334\t   (`:yin.k/response-cell`), its op and args carried only as\n   335\t   derived views (`:request-op`, `:request-args`; the op is the\n   336\t   source of the lowered entry's `:op`), so a resumer re-establishes\n   337\t   the carried pair exactly as the sender held it: retry through the\n   338\t   request reflection, wait for the response through the response\n   339\t   reflection at the kept position. The envelope is the whole truth:\n   340\t   the request protocol is open to keys beyond op and args\n   341\t   (`dao.stream.apply`'s `request?`), so the lower must never\n   342\t   rebuild it from the views. Either endpoint unservable refuses as\n   343\t   `:yin.k/unsatisfied` naming that endpoint's identity, before any\n   344\t   value is minted.\"\n   345\t  [serve! resources mint codec entry]\n   346\t  (let [h (get resources (:stream-id entry))\n   347\t        envelope (:datom entry)\n   348\t        route (call-out-cell resources)\n   349\t        resp-h (and route (get resources (:stream-id route)))]\n   350\t    (if-let [marker (lift-marker serve! h)]\n   351\t      (if-let [resp-marker (and resp-h (lift-marker serve! resp-h))]\n   352\t        (if-let [cid (mint codec (:id route) resp-h (:cursor route))]\n   353\t          {:pending {:yin.k/reason :ffi-request,\n   354\t                     :yin.k/call-id (:call-id entry),\n   355\t                     :yin.k/request-envelope envelope,\n   356\t                     :yin.k/request-op (or (apply2/request-op envelope)\n   357\t                                           (:op entry)),\n   358\t                     :yin.k/request-args (apply2/request-args envelope),\n   359\t                     :yin.k/request marker,\n   360\t                     :yin.k/response resp-marker,\n   361\t                     :yin.k/response-cell cid},\n   362\t           :cell? true}\n   363\t          (unsatisfied (local-identity resp-h)))\n   364\t        (unsatisfied (local-identity resp-h)))\n   365\t      (unsatisfied (local-identity h)))))\n   366\t\n   367\t\n   368\t(defn- lift-link\n   369\t  \"S7.4.3's link variants: the link pair name the engine's own fixed\n   370\t   link keys on a real entry (`module/link-request-resource` and\n   371\t   `module/link-response-resource`), resolved into `:resources`, and\n   372\t   the kept `:cursor` on the response stream\n   373\t   (`module/require-handler` mints it before the envelope is appended)\n   374\t   is the response cell -- a cell like any other, at its kept\n   375\t   position. Both pair markers travel, the engine's `:link-response`\n   376\t   entry retaining its `:request` beside the response side; the\n   377\t   envelope rides verbatim on the request-in-hand variant.\"\n   378\t  [serve! resources mint codec entry]\n   379\t  (let [reason (:reason entry)\n   380\t        resp-h (get resources (:response entry))\n   480\t(def ^:private fixed-resource-keys\n   481\t  \"The VM's fixed private resource keys -- the FFI call pair and the\n   482\t   link pair. Batch-allocated keys never collide with them, and the\n   483\t   lower installs nothing at them but what the engine's own dispatch\n   484\t   reads there: the link pair, and a retained request's fixed local\n   485\t   call-in key.\"\n   486\t  #{vm/call-in-stream-key vm/call-out-stream-key\n   487\t    vm/call-out-cursor-key module/link-request-resource\n   488\t    module/link-response-resource})\n   489\t\n   490\t\n   491\t(defn- fresh-key\n   492\t  \"The next private resource key `used` does not hold, claiming it:\n   493\t   `:yin.k/k-1`, `:yin.k/k-2`, ... regenerating on any collision\n   494\t   with the receiver's existing resources, the VM's fixed keys, or\n   495\t   keys this batch already allocated.\"\n   496\t  [used]\n   497\t  (loop [n (inc (count @used))]\n   498\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n   499\t      (if (contains? @used k)\n   500\t        (recur (inc n))\n   501\t        (do (swap! used conj k) k)))))\n   502\t\n   503\t\n   504\t(defn- pending-markers\n   505\t  \"Every stream marker `pending` names beside its cells' -- the\n   506\t   target of a put, both endpoints of a retained call, the pair of\n   507\t   a link request.\"\n   508\t  [pending]\n   509\t  (case (:yin.k/reason pending)\n   510\t    :put [(:yin.k/stream pending)]\n   511\t    :ffi-request [(:yin.k/request pending)\n   512\t                  (:yin.k/response pending)]\n   513\t    (:link-request :link-response)\n   514\t    [(:yin.k/request pending)\n   515\t     (:yin.k/response pending)]\n   516\t    []))\n   517\t\n   518\t\n   519\t(defn- attach-all\n   520\t  \"One attach per distinct stream identity. The first attach that\n   521\t   does not answer ok -- a reflection marked gone included -- refuses\n   522\t   the lower as `:yin.k/unsatisfied` naming that identity. Returns\n   523\t   {:handles {identity handle}}; `lower-frame` allocates each\n   524\t   reflection its own collision-free resource key.\"\n   525\t  [attach! markers]\n   526\t  (let [by-id (reduce (fn [m mkr]\n   527\t                        (update m (:dao.stream/identity mkr) #(or % mkr)))\n   528\t                      {} markers)]\n   529\t    (reduce-kv (fn [acc identity mkr]\n   530\t                 (if-let [h (lower-marker attach! mkr)]\n   531\t                   (assoc-in acc [:handles identity] h)\n   532\t                   (reduced (unsatisfied identity))))\n   533\t               {:handles {}}\n   534\t               by-id)))\n   535\t\n   536\t\n   537\t(defn- cell-resources\n   538\t  \"The fresh cursor entry each UCF cell lowers to, under the key\n   539\t   `cell-keys` allocated for it: its carried position, on the\n   540\t   reflection of the stream the cell names. Two references to one\n   541\t   cell share the one entry, and one ref per cell keeps its own\n   542\t   (S7.5.3); equal cell ids across separately lowered frames got\n   543\t   different keys, so no two frames ever share an entry. A response\n   544\t   route is no exception: it lowers under its own fresh key, never\n   545\t   at a fixed key, so distinct routes stay distinct and no migrated\n   546\t   route can ever misroute a new call.\"\n   547\t  [streams cells cell-keys]\n   548\t  (into {}\n   549\t        (map (fn [[cid cell]]\n   550\t               [(cell-keys cid)\n   551\t                {:stream-id (streams (cell-identity cells cid)),\n   552\t                 :cursor (:yin.k/position cell)}]))\n   553\t        cells))\n   554\t\n   555\t\n   556\t(defn- link-pair-resources\n   557\t  \"The engine's fixed link keys (`module/link-request-resource`,\n   558\t   `module/link-response-resource`) mapped onto the reflections a\n   559\t   lowered link wait uses: the engine's sweep retries a\n   560\t   `:link-request` by appending at the fixed request key\n   561\t   (`module/append-link-request`) and polls a `:link-response` at the\n   562\t   fixed response key (`poll-link-response`), so a lowered link wait\n   563\t   parks where the engine looks. One pair per task: the identity of\n   564\t   each side rides the pending's own markers.\"\n   565\t  [streams resources pendings]\n   566\t  (reduce (fn [acc pending]\n   567\t            (if (contains? #{:link-request :link-response}\n   568\t                           (:yin.k/reason pending))\n   569\t              (let [req-id (get-in pending [:yin.k/request\n   570\t                                            :dao.stream/identity])\n   571\t                    resp-id (get-in pending [:yin.k/response\n   572\t                                             :dao.stream/identity])\n   573\t                    req (get resources (streams req-id))\n   574\t                    resp (get resources (streams resp-id))]\n   575\t                (if (and req resp)\n   576\t                  (assoc acc\n   577\t                         module/link-request-resource req,\n   578\t                         module/link-response-resource resp)\n   579\t                  acc))\n   580\t              acc))\n   581\t          {}\n   582\t          pendings))\n   583\t\n   584\t\n   585\t(defn- lower-one\n   586\t  \"One pending of S7.4.3, lowered: `{:entry e}` -- the wait-set\n   587\t   entry the receiver parks, the caller's register context `ctx`\n   588\t   merged verbatim under the stream and cell fields the data\n   589\t   rebuilds -- or an outcome carrying `:yin.k/status`, naming the\n   590\t   stream identity where one is known. Every wait polls the key\n   591\t   `cell-keys` allocated for its cell, reading the stream key\n   592\t   `streams` allocated for the cell's reflection: migrated waits\n   593\t   poll routes no new call shares. A retained request's retry\n   594\t   writes through the request reflection's allocated key and stamps\n   595\t   the carried response route (`:response-cursor`,\n   596\t   `:response-stream`) for its restore; its `:datom` is the carried\n   597\t   envelope itself, never a rebuild from the op/args views (the\n   598\t   request protocol is open to further keys) -- a `:ffi-request`\n   599\t   pend without `:yin.k/request-envelope` is malformed and refuses\n   600\t   as `:yin.k/unsatisfied` naming the request identity.\"\n   601\t  [pending ctx streams cells cell-keys]\n   602\t  (case (:yin.k/reason pending)\n   603\t    :next\n   604\t    (let [cid (:yin.k/cell pending)]\n   605\t      (if-let [sid (streams (cell-identity cells cid))]\n   606\t        {:entry (merge ctx\n   607\t                       {:reason :next,\n   608\t                        :stream-id sid,\n   609\t                        :cursor-ref {:type :cursor-ref,\n   610\t                                     :id (cell-keys cid)}})}\n   611\t        (unsatisfied (cell-identity cells cid))))\n   612\t\n   613\t    :put\n   614\t    (if-let [sid (streams (get-in pending [:yin.k/stream\n   615\t                                           :dao.stream/identity]))]\n   616\t      {:entry (merge ctx\n   617\t                     {:reason :put,\n   618\t                      :stream-id sid,\n   619\t                      :datom (:yin.k/value pending)})}\n   620\t      (unsatisfied (get-in pending [:yin.k/stream :dao.stream/identity])))\n   621\t\n   622\t    :ffi\n   623\t    (let [cid (:yin.k/cell pending)]\n   624\t      (if-let [sid (streams (cell-identity cells cid))]\n   625\t        {:entry (merge ctx\n   626\t                       (cond-> {:reason :next,\n   627\t                                :call-id (:yin.k/call-id pending),\n   628\t                                :stream-id sid,\n   629\t                                :cursor-ref {:type :cursor-ref,\n   630\t                                             :id (cell-keys cid)}}\n   631\t                         (contains? pending :yin.k/op)\n   632\t                         (assoc :op (:yin.k/op pending))))}\n   633\t        (unsatisfied (cell-identity cells cid))))\n   634\t\n   635\t    :ffi-request\n   636\t    (let [req-id (get-in pending [:yin.k/request\n   637\t                                  :dao.stream/identity])\n   638\t          resp-id (get-in pending [:yin.k/response\n   639\t                                   :dao.stream/identity])\n   640\t          envelope (:yin.k/request-envelope pending)]\n   641\t      (if (some? envelope)\n   642\t        (if-let [req (streams req-id)]\n   643\t          (if-let [resp (streams resp-id)]\n   644\t            {:entry (merge ctx\n   645\t                           {:reason :put,\n   646\t                            :request-sent true,\n   647\t                            :call-id (:yin.k/call-id pending),\n   648\t                            :op (:yin.k/request-op pending),\n   649\t                            :stream-id req,\n   650\t                            :datom envelope,\n   651\t                            :response-cursor\n   652\t                            (cell-keys (:yin.k/response-cell pending)),\n   653\t                            :response-stream resp})}\n   654\t            (unsatisfied resp-id))\n   655\t          (unsatisfied req-id))\n   656\t        (unsatisfied req-id)))\n   657\t\n   658\t    (:link-request :link-response)\n   659\t    (let [reason (:yin.k/reason pending)\n   660\t          cid (:yin.k/cell pending)\n   661\t          sid (streams (cell-identity cells cid))\n   662\t          req (streams (get-in pending [:yin.k/request\n   663\t                                        :dao.stream/identity]))]\n   664\t      (if (and sid req)\n   665\t        {:entry (merge ctx\n   666\t                       (cond-> {:reason reason,\n   667\t                                :link-id (:yin.k/link-id pending),\n   668\t                                :name (:yin.k/name pending),\n   669\t                                :request module/link-request-resource,\n   670\t                                :response module/link-response-resource,\n   510\t        (is (empty? (:wait-set done)))))))\n   511\t\n   512\t\n   513\t(deftest a-retained-ffi-request-migrates-and-the-retry-resumes\n   514\t  (let [t (toy)\n   515\t        peer (served-peer t)\n   516\t        serve! (server peer (:channel t) #{:reader :writer})\n   517\t        attach! (attacher t)\n   518\t        program (then (call-node :op/echo \"hello\")\n   519\t                      (call-node :op/echo \"world\"))\n   520\t        [datoms parked entry call-in-src call-out-src]\n   521\t        (parked-caller program)\n   522\t        ;; a producer's own extra envelope key -- legal, the open\n   523\t        ;; request protocol ignores unknown keys\n   524\t        ;; (`dao.stream.apply`'s `request?`) -- must survive the\n   525\t        ;; migration verbatim, which no op/args rebuild could give\n   526\t        entry (assoc-in entry [:datom :producer/nonce] \"n-1\")\n   527\t        kept (get-in parked [:resources vm/call-out-cursor-key :cursor])\n   528\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   529\t        pending (:yin.k/pending lifted)\n   530\t        ;; the resumer's own pair and its own handler, under the fixed\n   531\t        ;; keys: they serve the program's subsequent calls and can\n   532\t        ;; never answer the migrated one\n   533\t        own-call-in (ring 8)\n   534\t        own-call-out (ring 8)\n   535\t        own (calling-machine own-call-in own-call-out\n   536\t                             {:op/echo (constantly \"local!\")})\n   537\t        own-pair (select-keys (:resources own)\n   538\t                              [vm/call-in-stream-key\n   539\t                               vm/call-out-stream-key\n   540\t                               vm/call-out-cursor-key])\n   541\t        lowered (ucf.remote/lower-pending attach! pending\n   542\t                                          (:yin.k/cells lifted)\n   543\t                                          (registers-of entry)\n   544\t                                          (keys own-pair))\n   545\t        e (:entry lowered)\n   546\t        rs (:resources lowered)\n   547\t        receiver (-> (quiesced-receiver datoms lowered own)\n   548\t                     (update :resources #(merge own-pair %)))\n   549\t        oldest (fn [h]\n   550\t                 (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n   551\t        ;; the emitter's bridge answered the migrated call before the\n   552\t        ;; migration: the response sits on the emitter's call-out,\n   553\t        ;; past the kept cursor\n   554\t        _ (stream/append! call-out-src\n   555\t                          (apply2/success-response\n   556\t                            (:call-id entry) \"echo!\"))\n   557\t        ;; phase 1: the sweep retries the retained request through the\n   558\t        ;; carried request reflection, and the restored response wait\n   559\t        ;; polls the carried response route\n   560\t        r1 (vm/run receiver)\n   561\t        wait-a (first (:wait-set r1))\n   562\t        warm-up (stream/next call-in-src (oldest call-in-src))\n   563\t        _ (serve-mirror! peer)\n   564\t        landed (stream/next call-in-src (oldest call-in-src))\n   565\t        ;; phase 2: the carried route delivers the response; the\n   566\t        ;; program's own next call parks on the receiver's local pair\n   567\t        ;; and its own handler answers it there\n   568\t        r2 (vm/run r1)]\n   569\t    (testing \"the machine parked through the engine, request retained\"\n   570\t      (is (vm/blocked? parked))\n   571\t      (is (true? (:request-sent entry)))\n   572\t      (is (= vm/call-in-stream-key (:stream-id entry)))\n   573\t      (is (apply2/request? (:datom entry))))\n   574\t    (testing \"the lift carries both endpoints and the kept response cell\"\n   575\t      (is (= (:datom entry) (:yin.k/request-envelope pending))\n   576\t          \"the envelope rides VERBATIM -- the producer's extra key\n   577\t           included, beside the op/args views\")\n   578\t      (is (contains? pending :yin.k/request))\n   579\t      (is (contains? pending :yin.k/response)\n   580\t          \"both endpoint markers ride beside the retained envelope\")\n   581\t      (is (= :yin.k/c-0 (:yin.k/response-cell pending)))\n   582\t      (is (= (get-in pending [:yin.k/response :dao.stream/identity])\n   583\t             (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/stream\n   584\t                             :dao.stream/identity]))\n   585\t          \"the response endpoint's marker is the route cell's stream\")\n   586\t      (is (= kept\n   587\t             (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   588\t          \"the kept response position\"))\n   589\t    (testing \"the lower allocates fresh keys and carries the route\"\n   590\t      (is (contains? rs (:stream-id e))\n   970\t               :stream-id :yin/call-out}\n   971\t        lifted (ucf.remote/lift-pending serve! resources entry)\n   972\t        pending (:yin.k/pending lifted)]\n   973\t    (is (= :ffi (:yin.k/reason pending)))\n   974\t    (is (= :call-7 (:yin.k/call-id pending)))\n   975\t    (is (= :op/add (:yin.k/op pending)))\n   976\t    (is (= :yin.k/c-0 (:yin.k/cell pending)))\n   977\t    (is (= 5 (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   978\t        \"the response cell at its KEPT position\")\n   979\t    (let [ctx {:segment 0, :pc 9, :env {}, :stack [], :k []}\n   980\t          lowered (ucf.remote/lower-pending attach! pending\n   981\t                                            (:yin.k/cells lifted) ctx {})\n   982\t          e (:entry lowered)]\n   983\t      (is (= :next (:reason e)) \"the response wait is a :next waiter\")\n   984\t      (is (= :call-7 (:call-id e)))\n   985\t      (is (= :op/add (:op e)))\n   986\t      (is (contains? (:resources lowered) (get-in e [:cursor-ref :id]))\n   987\t          \"the response wait polls its own fresh cursor entry\")\n   988\t      (is (= 5 (get-in lowered [:resources (get-in e [:cursor-ref :id])\n   989\t                                :cursor]))))))\n   990\t\n   991\t\n   992\t(deftest ffi-retained-round-trips\n   993\t  (let [serve! (stub-serve! chan)\n   994\t        attach! (stub-attach!)\n   995\t        ;; a producer's own extra envelope key -- legal, the open\n   996\t        ;; request protocol ignores unknown keys\n   997\t        ;; (`dao.stream.apply`'s `request?`) -- must survive the\n   998\t        ;; round trip, which no rebuild from the op/args views gives\n   999\t        envelope (assoc (apply2/request :call-7 :op/add [1 2])\n  1000\t                        :producer/nonce \"n-1\")\n  1001\t        resources {vm/call-in-stream-key [:handle :call-in],\n  1002\t                   vm/call-out-stream-key [:handle :call-out],\n  1003\t                   vm/call-out-cursor-key\n  1004\t                   {:stream-id vm/call-out-stream-key, :cursor 2}}\n  1005\t        entry {:reason :put, :request-sent true, :call-id :call-7,\n  1006\t               :op :op/add, :stream-id vm/call-in-stream-key,\n  1007\t               :datom envelope}\n  1008\t        lifted (ucf.remote/lift-pending serve! resources entry)\n  1009\t        pending (:yin.k/pending lifted)]\n  1010\t    (is (= :ffi-request (:yin.k/reason pending)))\n  1011\t    (is (= :call-7 (:yin.k/call-id pending)))\n  1012\t    (is (= :op/add (:yin.k/request-op pending)))\n  1013\t    (is (= [1 2] (:yin.k/request-args pending)))\n  1014\t    (is (= envelope (:yin.k/request-envelope pending))\n  1015\t        \"the envelope rides VERBATIM -- op/args are derived views\n  1016\t         beside it, and the producer's extra key survives\")\n  1017\t    (is (= \"n-1\" (:producer/nonce (:yin.k/request-envelope pending)))\n  1018\t        \"a key a constructor-made op/args envelope would not have\")\n  1019\t    (is (contains? pending :yin.k/request))\n  1020\t    (is (contains? pending :yin.k/response)\n  1021\t        \"both endpoint markers ride beside the retained envelope\")\n  1022\t    (is (= :yin.k/c-0 (:yin.k/response-cell pending))\n  1023\t        \"the response route rides as a cell\")\n  1024\t    (is (= (get-in pending [:yin.k/response :dao.stream/identity])\n  1025\t           (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/stream\n  1026\t                           :dao.stream/identity]))\n  1027\t        \"the response endpoint's marker is the route cell's stream\")\n  1028\t    (is (= 2 (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n  1029\t        \"the route cell at the emitter's kept call-out position\")\n  1030\t    (is (= #{:dao.stream.remote/v1}\n  1180\t  [refused]\n  1181\t  (let [ids (atom {})]\n  1182\t    (fn [h]\n  1183\t      (when (not= h refused)\n  1184\t        (let [id (or (get @ids h)\n  1185\t                     (let [n (str (gensym \"seg\"))]\n  1186\t                       (swap! ids assoc h n)\n  1187\t                       n))]\n  1188\t          {:dao.stream/identity id, :dao.stream/channel chan})))))\n  1189\t\n  1190\t\n  1191\t(defn- retained-resources\n  1192\t  \"The emitter-side table of a retained call over `call-in` and\n  1193\t   `call-out`, the call-out cursor kept at `position`.\"\n  1194\t  [call-in call-out position]\n  1195\t  {vm/call-in-stream-key call-in,\n  1196\t   vm/call-out-stream-key call-out,\n  1197\t   vm/call-out-cursor-key {:stream-id vm/call-out-stream-key,\n  1198\t                           :cursor position}})\n  1199\t\n  1200\t\n  1201\t;; the retained envelope carries a producer key the op/args views do\n  1202\t;; not name -- legal per the open request protocol -- so the pins\n  1203\t;; below see one an op/args rebuild would drop\n  1204\t(def ^:private retained-entry\n  1205\t  {:reason :put, :request-sent true, :call-id :call-7,\n  1206\t   :op :op/add, :stream-id vm/call-in-stream-key,\n  1207\t   :datom (assoc (apply2/request :call-7 :op/add [1 2])\n  1208\t                 :producer/nonce \"n-1\")})\n  1209\t\n  1210\t\n  1211\t(deftest retained-lift-refuses-when-an-endpoint-cannot-be-served\n  1212\t  (let [call-in (one-slot-stream \"call-in\")\n  1213\t        call-out (one-slot-stream \"call-out\")\n  1214\t        resources (retained-resources call-in call-out 2)]\n  1215\t    (testing \"an unservable request endpoint names it\"\n  1216\t      (let [refusal (ucf.remote/lift-pending\n  1217\t                      (refusing-serve! call-in) resources retained-entry)]\n  1218\t        (is (= :yin.k/unsatisfied (:yin.k/status refusal)))\n  1219\t        (is (= \"call-in\" (:dao.stream/identity refusal))\n  1220\t            \"naming that endpoint's identity\")\n  1221\t        (is (empty? (:yin.k/cells refusal))\n  1222\t            \"no cell is published\")))\n  1223\t    (testing \"an unservable response endpoint names it\"\n  1224\t      (let [refusal (ucf.remote/lift-pending\n  1225\t                      (refusing-serve! call-out) resources retained-entry)]\n  1226\t        (is (= :yin.k/unsatisfied (:yin.k/status refusal)))\n  1227\t        (is (= \"call-out\" (:dao.stream/identity refusal))\n  1228\t            \"naming that endpoint's identity\")\n  1229\t        (is (empty? (:yin.k/cells refusal))\n  1230\t            \"no cell is published\")))))\n  1231\t\n  1232\t\n  1233\t(deftest retained-lower-refuses-when-an-endpoint-cannot-attach\n  1234\t  (let [serve! (stub-serve! chan)\n  1235\t        resources (retained-resources (one-slot-stream \"call-in\")\n  1236\t         