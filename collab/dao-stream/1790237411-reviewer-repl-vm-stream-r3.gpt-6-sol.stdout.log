 is the\n   124\t   canonical R of that concatenation (yin.vm.debruijn.register.md).\"\n   125\t  [vm {:keys [bodies instructions] :as image}]\n   126\t  (let [held (:segment vm)\n   127\t        offset (count (:instructions held))\n   128\t        shift-body #(-> % (update :start + offset) (update :end + offset))\n   129\t        shift #(relocate rcode/opcode-table offset %)\n   130\t        combined {:bodies (into (:bodies held) (map shift-body) bodies)\n   131\t                  :instructions (into (:instructions held)\n   132\t                                      (map shift)\n   133\t                                      instructions)}]\n   134\t    (assoc (register/load-image vm image)\n   135\t           :segment combined\n   136\t           :hash (rcode/register-hash combined)\n   137\t           :pc offset)))\n   138\t\n   139\t\n   140\t(def program-loaders\n   141\t  \"The loader the evaluator observer hands each `program-out` value, per\n   142\t   evaluator.  Every value there is one expanded canonical tree packet\n   143\t   `[root rows]` (yin.vm.macro.md §2.4); each loader takes its row set — the\n   144\t   ast-walker through `vm-load-rows`, the semantic VM through\n   145\t   `linearize/rows-loader` over `semantic/load-vector`, and the de Bruijn\n   146\t   kernels through their lowerings to a stack image (H) or a register\n   147\t   image (R).  No evaluator learns that an expander ran.\"\n   148\t  {:ast-walker (fn [vm packet]\n   149\t                 (ast-walker/vm-load-rows vm (macro/packet->row-set packet)))\n   150\t   :semantic (let [load-rows (linearize/rows-loader semantic/load-vector)]\n   151\t               (fn [vm packet]\n   152\t                 (load-rows vm (macro/packet->row-set packet))))\n   153\t   :stack (fn [vm packet]\n   154\t            (append-stack-image\n   155\t              vm\n   156\t              (:image (debruijn-linearize/adapt\n   157\t                        (packet->named-datoms packet)))))\n   158\t   :register (fn [vm packet]\n   159\t               (append-register-image\n   160\t                 vm\n   161\t                 (:image (register-compile/adapt\n   162\t                           (packet->named-datoms packet)))))})\n   163\t\n   164\t\n   165\t(def lang-labels {:clojure \"Clojure\" :python \"Python\" :php \"PHP\"})\n   335\t               (assoc :output-cursor cursor)\n   336\t               (ledger :output :dao.stream/blocked))\n   337\t           (apply str chunks)\n   338\t           results]\n   339\t          (let [result (stream/next output cursor)\n   340\t                outcome (:dao.stream/outcome result)\n   341\t                value (:dao.stream/value result)]\n   342\t            (case outcome\n   343\t              :dao.stream/ok\n   344\t              (if (result-chunk? value)\n   345\t                (recur (dec remaining)\n   346\t                       gaps\n   347\t                       (:dao.stream/cursor result)\n   348\t                       chunks\n   349\t                       (conj results value))\n   350\t                (recur (dec remaining)\n   351\t                       gaps\n   352\t                       (:dao.stream/cursor result)\n   353\t                       (conj chunks (chunk-text value))\n   354\t                       results))\n   355\t\n   356\t              :dao.stream/gap\n   357\t              (recur remaining\n   358\t                     (dec gaps)\n   359\t                     (:dao.stream/cursor result)\n   360\t                     (conj chunks\n   361\t                           (str \";; output lost: resumed at the recovery\"\n   362\t                                \" cursor\\n\"))\n   363\t                     results)\n   364\t\n   365\t              :dao.stream/blocked\n   366\t              [(-> state\n   367\t                   (assoc :output-cursor cursor)\n   368\t                   (ledger :output outcome))\n   369\t               (apply str chunks)\n   370\t               results]\n   371\t\n   372\t              [(-> state\n   373\t                   (assoc :output-cursor cursor)\n   374\t                   (ledger :output outcome))\n   375\t               (apply str (conj chunks (str \";; output \" (name outcome) \"\\n\")))\n   376\t               results])))))))\n   377\t\n   378\t\n   379\t(defn- make-output-medium!\n   380\t  []\n   381\t  (:dao.stream/handle\n   382\t    (ring/create! {:dao.stream/type ring/transport-type\n   383\t                   ring/capacity-key output-capacity})))\n   384\t\n   385\t\n   386\t(defn- mint-cursor\n   387\t  [handle]\n   388\t  (let [result (stream/cursor handle :dao.stream/oldest)]\n   389\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   390\t      (:dao.stream/cursor result))))\n   391\t\n   392\t\n   393\t;; =============================================================================\n   394\t;; The VM and its program medium\n   395\t;; =============================================================================\n   640\t        [(record-last-value state state'' value)\n   641\t         (str output-text (format-value value))])\n   642\t      [state''\n   643\t       (str output-text \"Error: \" result-loss-text\n   644\t            (when (and append (not= :dao.stream/ok append))\n   645\t              (str \" (append: \" (name append) \")\")))])))\n   646\t\n   647\t\n   648\t(defn- drain-observer\n   649\t  \"Advance one observer past every batch still on its medium, keeping any\n   650\t   gap it recovers across.  A nil observer — a session without that medium —\n   651\t   stays nil.\"\n   652\t  [observer]\n   653\t  (when observer\n   654\t    (loop [observer observer]\n   655\t      (let [{:keys [status] observer' :observer}\n   656\t            (observer/observe-next observer)]\n   657\t        (if (#{:ok :gap} status) (recur observer') observer')))))\n   658\t\n   659\t\n   660\t(defn- consume-failed-round\n   661\t  \"Answer a round that threw with a recoverable shell state.\n   662\t\n   663\t   The failed input is consumed exactly once: each of the session's\n   664\t   observers resumes from the session the throw carried — the failing\n   665\t   stage's, matched by the medium it holds — or from where the round began\n   666\t   when it carried none, and reads past every batch still on its medium.\n   667\t   The shell is the only appender and appends one batch per round, so what\n   668\t   remains is the failed batch alone.  The VM is the one the round began\n   669\t   with, so a half-run continuation cannot be resumed — and its error\n   670\t   replayed — by the next input.  Output the round already emitted is\n","exit_code":0,"status":"completed"}}
