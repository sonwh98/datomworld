{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/ws_project_test.cljc | sed -n '235,425p'\"","aggregated_output":"   235\t                      :ws/handle {:dao.stream/handle (ring 1)\n   236\t                                  :dao.stream/surface #{:writer}}})\n   237\t    (deposit! medium {:ws/attachment me :ws/event :ws/payload})\n   238\t    (project/step! project)\n   239\t    (is (= [] (values channel))\n   240\t        \"openings, offers and a payload without :ws/value append\n   241\t         nothing\")\n   242\t    (is (not (project/closed? project))\n   243\t        \"none of them is terminal\")))\n   244\t\n   245\t\n   246\t(deftest a-gap-adopts-the-mediums-recovery-cursor\n   247\t  (let [{:keys [medium channel project]} (composed 1)]\n   248\t    (deposit! medium (payload me :lost))\n   249\t    (deposit! medium (payload me :kept))\n   250\t    (project/step! project)\n   251\t    (is (= [:kept] (values channel))\n   252\t        \"the evicted event is lost, the retained one forwards\")\n   253\t    (is (not (project/closed? project))\n   254\t        \"a medium gap is not channel loss\")))\n   255\t\n   256\t\n   257\t(deftest the-mediums-own-end-closes-the-projection-and-the-ring\n   258\t  (let [{:keys [medium channel project]} (composed)]\n   259\t    (deposit! medium (payload me :only))\n   260\t    (stream/close! medium)\n   261\t    (project/step! project)\n   262\t    (is (= [:only] (values channel))\n   263\t        \"what the medium retained before it ended still forwards\")\n   264\t    (is (project/closed? project)\n   265\t        \"a dead medium gives the projection nothing further to read\")\n   266\t    (is (= :dao.stream/end\n   267\t           (:dao.stream/outcome (stream/next channel (newest-cursor channel))))\n   268\t        \"the ring is closed with the projection: a link waiting on it\n   269\t         observes channel loss instead of blocking forever\")))\n   270\t\n   271\t\n   272\t(deftest the-mediums-end-is-channel-loss-for-the-link\n   273\t  (let [{:keys [medium channel]} (composed)\n   274\t        dial (dialed medium channel)\n   275\t        refl (:dao.stream/handle\n   276\t               (project/dial-attach! dial (remote-descriptor \"str-1\")))]\n   277\t    (is (some? refl) \"the link attached over the dialed channel\")\n   278\t    (stream/close! medium)\n   279\t    (project/dial-step! dial)\n   280\t    (is (project/closed? (:project (project/channel dial)))\n   281\t        \"the medium's end stopped the projection\")\n   282\t    (is (= :dao.stream/end\n   283\t           (:dao.stream/outcome (stream/next channel (newest-cursor channel))))\n   284\t        \"the ring reads end at its tail, never a blocked wait\")\n   285\t    (let [r (stream/cursor refl stream/anchor-oldest)]\n   286\t      (is (= :dao.stream/transport-error (:dao.stream/outcome r)))\n   287\t      (is (= :dao.stream.remote/channel-gone (:dao.stream.remote/reason r))\n   288\t          \"the link observed the channel's loss (2.4): with the medium\n   289\t           ended, nothing further could ever arrive\"))))\n   290\t\n   291\t\n   292\t(deftest a-second-attach-on-one-dial-is-a-composition-error\n   293\t  (let [{:keys [medium channel]} (composed)\n   294\t        dial (dialed medium channel)\n   295\t        d (remote-descriptor \"str-1\")]\n   296\t    (is (= :dao.stream/ok\n   297\t           (:dao.stream/outcome (project/dial-attach! dial d)))\n   298\t        \"the first attach carries the dial's one active attachment\")\n   299\t    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n   300\t          (project/dial-attach! dial d))\n   301\t        \"a further attach! on the same dial is rejected: its ring and\n   302\t         traffic cursor already belong to the first attachment, and a\n   303\t         reattachment composes a fresh dial with a fresh cursor\")))\n   304\t\n   305\t\n   306\t(def ^:private handoff-admission\n   307\t  {:retention :evict-oldest :capacity 1 :value-domain :host-values})\n   308\t\n   309\t\n   310\t(defn- acceptor-over\n   311\t  \"An acceptor over a real one-slot endpoint, with `table` as the\n   312\t   mirror's table. Offers and acknowledgements ride fresh capacity-one\n   313\t   ring buffers; the offers medium is returned so a test can deposit\n   314\t   accepted offers as the transport's upgrade callback would.\n   315\t   :make-media hands out one fresh traffic medium, channel ring and\n   316\t   cursor per accepted offer, each recorded in `media` for the test to\n   317\t   drive and observe.\"\n   318\t  [media table]\n   319\t  (let [offers (ring 1)\n   320\t        acks (ring 1)\n   321\t        endpoint (ws/make-endpoint\n   322\t                   {:served {\"/toy\"\n   323\t                             {:dao.stream/type :dao.stream/ws\n   324\t                              :dao.stream/identity \"toy\"\n   325\t                              :ws/host \"127.0.0.1\"\n   326\t                              :ws/port 1\n   327\t                              :ws/path \"/toy\"}}\n   328\t                    :control {:dao.stream/handle (ring 16)\n   329\t                              :dao.stream/surface #{:writer}}\n   330\t                    :control-admission\n   331\t                    {:retention :evict-oldest :capacity 16\n   332\t                     :value-domain :portable-values}\n   333\t                    :slots [{:offer {:dao.stream/handle offers\n   334\t                                     :dao.stream/surface #{:writer}}\n   335\t                             :offer-admission handoff-admission\n   336\t                             :ack {:dao.stream/handle acks\n   337\t                                   :dao.stream/surface #{:writer}}\n   338\t                             :ack-admission handoff-admission\n   339\t                             :ack-cursor (newest-cursor acks)}]\n   340\t                    :expiry-ms nil})]\n   341\t    {:offers offers\n   342\t     :acceptor\n   343\t     (project/make-acceptor\n   344\t       {:endpoint endpoint\n   345\t        :slots [{:offer-reader offers\n   346\t                 :offer-cursor (newest-cursor offers)\n   347\t                 :ack-writer {:dao.stream/handle acks\n   348\t                              :dao.stream/surface #{:writer}}}]\n   349\t        :table table\n   350\t        :make-media\n   351\t        (fn [_]\n   352\t          (let [traffic (ring 64)\n   353\t                channel-ring (ring 64)\n   354\t                m {:traffic traffic :ring channel-ring}]\n   355\t            (swap! media conj m)\n   356\t            {:traffic {:dao.stream/handle traffic\n   357\t                       :dao.stream/surface #{:writer}}\n   358\t             :admission {:retention :evict-oldest :capacity 64\n   359\t                         :value-domain :portable-values}\n   360\t             :reader traffic\n   361\t             :cursor (newest-cursor traffic)\n   362\t             :ring channel-ring}))})}))\n   363\t\n   364\t\n   365\t(defn- offer!\n   366\t  \"Deposit one accepted offer for attachment `id` whose socket handle\n   367\t   is `handle`, as the transport's upgrade callback would.\"\n   368\t  [offers id handle]\n   369\t  (stream/append! offers\n   370\t                  {:ws/attachment id\n   371\t                   :ws/event :ws/accepted\n   372\t                   :ws/handle {:dao.stream/handle handle\n   373\t                               :dao.stream/surface\n   374\t                               #{:writer :closable}}}))\n   375\t\n   376\t\n   377\t(deftest a-closed-session-is-reaped-and-its-slot-is-reused\n   378\t  (let [media (atom [])\n   379\t        served (ring 16)\n   380\t        {:keys [acceptor offers]}\n   381\t        (acceptor-over media {\"str-1\" {:handle served\n   382\t                                       :surface #{:reader}}})\n   383\t        sock-1 (ring 8)]\n   384\t    (offer! offers \"att-1\" sock-1)\n   385\t    (project/accept-step! acceptor 1)\n   386\t    (is (= #{\"att-1\"} (set (keys (project/sessions acceptor))))\n   387\t        \"the first connection was adopted\")\n   388\t    (let [{:keys [traffic]} (last @media)\n   389\t          req {:dao.stream/identity \"str-1\"\n   390\t               :dao.stream.remote/op :dao.stream/descriptor\n   391\t               :dao.stream.remote/args []\n   392\t               :dao.stream.remote/id 7}]\n   393\t      (deposit! traffic (payload \"att-1\" req))\n   394\t      (deposit! traffic (event \"att-1\" :ws/closed))\n   395\t      (project/accept-step! acceptor 2)\n   396\t      (is (empty? (project/sessions acceptor))\n   397\t          \"the closed session was reaped, not stepped on forever\")\n   398\t      (is (= #{7} (set (map :dao.stream.remote/id (values sock-1))))\n   399\t          \"the retained request was answered in the reap tick's last\n   400\t           mirror pass\")\n   401\t      (let [sock-2 (ring 8)]\n   402\t        (offer! offers \"att-2\" sock-2)\n   403\t        (project/accept-step! acceptor 3)\n   404\t        (is (= #{\"att-2\"} (set (keys (project/sessions acceptor))))\n   405\t            \"a second connection was adopted; the first's state is\n   406\t             gone\")\n   407\t        (let [{:keys [traffic ring]} (last @media)]\n   408\t          (deposit! traffic (payload \"att-2\" :works))\n   409\t          (project/accept-step! acceptor 4)\n   410\t          (is (= [:works] (values ring))\n   411\t              \"the second session projects onto its own fresh ring\"))))))\n","exit_code":0,"status":"completed"}}
