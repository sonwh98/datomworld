{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'cat test/dao/stream/ble/mesh_test.cljc; cat test/dao/stream/ble/sim.cljc'","aggregated_output":"(ns dao.stream.ble.mesh-test\n  \"The flooding mesh over the deterministic radio (docs/design/\n   dao.stream.ble.md 7): exchange over links formed by the machines'\n   own connect policy, the dedup that eats both-directions redundancy\n   and flood loops, the ttl that bounds hops, multi-hop relay through a\n   middle node, the seq discipline, foreign frames skipped, oversize\n   values refused, and the raw gap adopted. Every fact is pumped; no\n   test waits on anything.\"\n\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.stream.ble :as ble]\n            [dao.stream.ble.mesh :as mesh]\n            [dao.stream.ble.sim :as sim]\n            [dao.stream.cbor :as cbor]\n            [dao.stream.ringbuffer :as ringbuffer])\n  #?(:cljd (:import [\"dart:typed_data\" Uint8List])))\n\n\n(defn- ring\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn- octets->bytes\n  [octets]\n  #?(:cljd (Uint8List.fromList (vec octets))\n     :clj (byte-array (mapv unchecked-byte octets))\n     :cljs (js/Uint8Array.from (to-array (vec octets)))))\n\n\n(defn- writer\n  \"A raw writer handle over a scripted seam: `:sends` records every\n   [peer bytes] it was handed, `:fail` refuses the next n sends.\"\n  [& {:keys [fail]}]\n  (let [sends (atom [])\n        fail (atom (or fail 0))]\n    {:handle (ble/writer\n              {:send! (fn [p bs]\n                        (if (pos? @fail)\n                          (do (swap! fail dec)\n                              {:dao.stream/outcome :dao.stream/transport-error\n                               :dao.stream.ble/reason \"scripted refusal\"})\n                          (do (swap! sends conj [p bs])\n                              {:dao.stream/outcome :dao.stream/ok})))\n               :close! (fn [])}\n              {:dao.stream/type ble/transport-type\n               :dao.stream/identity \"w\"\n               :dao.stream.ble/self \"w\"})\n     :sends sends :fail fail}))\n\n\n(defn- make-mesh\n  \"A mesh over `node`, replaying the traffic ring from its origin.\"\n  [net node-id & {:keys [identity ttl max-remembered]}]\n  (let [n (sim/node net node-id)]\n    (mesh/make-mesh\n     {:identity (or identity node-id)\n      :raw-writer (:writer n)\n      :raw-traffic (:traffic n)\n      :raw-cursor stream/anchor-oldest\n      :deposit (:deposit n)\n      :ttl ttl\n      :max-remembered max-remembered})))\n\n\n(defn- delivered\n  [net node-id]\n  (mapv (fn [ev]\n          {:origin (:dao.stream.ble.mesh/origin ev)\n           :seq (:dao.stream.ble.mesh/seq ev)\n           :value (:dao.stream.ble.mesh/value ev)})\n        (sim/deliveries net node-id)))\n\n\n(defn- link-all!\n  \"Join every node id and run one advertisement round: the machines'\n   connect policy forms what reachability allows.\"\n  [net & ids]\n  (doseq [id ids] (sim/join! net id))\n  (sim/advertise! net))\n\n\n;; =============================================================================\n;; Exchange\n;; =============================================================================\n\n\n(deftest two-nodes-exchange-one-value-once\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\")\n    (is (sim/linked? net \"a\" \"b\"))\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mb (make-mesh net \"b\" :identity \"origin-b\")]\n      (testing \"both meshes learn their neighbors from the traffic rings\"\n        (is (= :drained (:status (mesh/mesh-step! ma))))\n        (is (= :drained (:status (mesh/mesh-step! mb)))))\n      (testing \"a send answers ok and spends the seq once\"\n        (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:n 1}))))\n        (sim/pump! net)\n        (is (= 1 (:next-seq @ma))))\n      (testing \"b delivers the value once, however many links carried it\"\n        (mesh/mesh-step! mb)\n        (is (= [{:origin \"origin-a\" :seq 0 :value {:n 1}}]\n               (delivered net \"b\"))))\n      (testing \"the second send rides the next seq\"\n        (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:n 2}))))\n        (sim/pump! net)\n        (mesh/mesh-step! mb)\n        (is (= [{:origin \"origin-a\" :seq 0 :value {:n 1}}\n                {:origin \"origin-a\" :seq 1 :value {:n 2}}]\n               (delivered net \"b\")))))))\n\n\n(deftest a-send-before-any-link-is-ok-and-unspent\n  (let [net (sim/radio-net)\n        _a (sim/join! net \"a\")\n        ma (make-mesh net \"a\" :identity \"origin-a\")]\n    (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:n 1}))))\n    (sim/pump! net)\n    (is (= 0 (:next-seq @ma)))\n    (testing \"nobody received any frame\"\n      (is (empty? (sim/frames net \"a\"))))))\n\n\n(deftest both-directions-redundancy-is-eaten-by-the-dedup\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mb (make-mesh net \"b\" :identity \"origin-b\")]\n      (mesh/mesh-step! ma)\n      (mesh/mesh-step! mb)\n      (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:n 1}))))\n      (sim/pump! net)\n      ;; Each side connected out to the other: two GATT links, two peer\n      ;; addresses per observer, so b's radio received the frame twice.\n      (is (= 2 (count (sim/frames net \"b\"))))\n      (mesh/mesh-step! mb)\n      (is (= 1 (count (delivered net \"b\")))))))\n\n\n;; =============================================================================\n;; Flooding, hops and ttl\n;; =============================================================================\n\n\n(deftest a-middle-node-relays-and-the-loop-dies-at-the-dedup\n  (let [net (sim/radio-net)]\n    (sim/unreachable! net \"a\" \"c\")\n    (link-all! net \"a\" \"b\" \"c\")\n    (testing \"the partition holds: a and c never linked\"\n      (is (not (sim/linked? net \"a\" \"c\")))\n      (is (sim/linked? net \"a\" \"b\"))\n      (is (sim/linked? net \"b\" \"c\")))\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mb (make-mesh net \"b\" :identity \"origin-b\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")]\n      (doseq [m [ma mb mc]] (mesh/mesh-step! m))\n      (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:hop 1}))))\n      (sim/pump! net)\n      (mesh/mesh-step! mb)\n      (sim/pump! net)\n      (mesh/mesh-step! mc)\n      (testing \"b delivered, c delivered through b\"\n        (is (= [{:origin \"origin-a\" :seq 0 :value {:hop 1}}]\n               (delivered net \"b\")))\n        (is (= [{:origin \"origin-a\" :seq 0 :value {:hop 1}}]\n               (delivered net \"c\"))))\n      (testing \"b relayed back toward a over the redundant link, a deduped\n                -- its own send occupies the cache\"\n        (sim/pump! net)\n        (mesh/mesh-step! ma)\n        (is (= [] (delivered net \"a\")))))))\n\n\n(deftest ttl-zero-delivers-locally-and-relays-nothing\n  (let [net (sim/radio-net)]\n    (sim/unreachable! net \"a\" \"c\")\n    (link-all! net \"a\" \"b\" \"c\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\" :ttl 0)\n          mb (make-mesh net \"b\" :identity \"origin-b\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")]\n      (doseq [m [ma mb mc]] (mesh/mesh-step! m))\n      (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:hop 1}))))\n      (sim/pump! net)\n      (mesh/mesh-step! mb)\n      (sim/pump! net)\n      (mesh/mesh-step! mc)\n      (testing \"b heard it, c never did\"\n        (is (= 1 (count (delivered net \"b\"))))\n        (is (= [] (delivered net \"c\")))))))\n\n\n(deftest ttl-one-reaches-exactly-two-hops\n  (let [net (sim/radio-net)]\n    (sim/unreachable! net \"a\" \"c\")\n    (sim/unreachable! net \"a\" \"d\")\n    (sim/unreachable! net \"b\" \"d\")\n    (link-all! net \"a\" \"b\" \"c\" \"d\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\" :ttl 1)\n          mb (make-mesh net \"b\" :identity \"origin-b\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")\n          md (make-mesh net \"d\" :identity \"origin-d\")]\n      (doseq [m [ma mb mc md]] (mesh/mesh-step! m))\n      (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:hop 1}))))\n      (sim/pump! net)\n      (mesh/mesh-step! mb)\n      (sim/pump! net)\n      (mesh/mesh-step! mc)\n      (mesh/mesh-step! md)\n      (is (= 1 (count (delivered net \"c\"))))\n      (is (= [] (delivered net \"d\"))))))\n\n\n;; =============================================================================\n;; The seq discipline\n;; =============================================================================\n\n\n(deftest the-seq-is-spent-when-the-raw-writer-accepted-the-frame\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          w (:writer (sim/node net \"a\"))]\n      (mesh/mesh-step! ma)\n      (testing \"a live send spends exactly one seq, whatever the air did\"\n        (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:n 1}))))\n        (sim/pump! net)\n        (is (= 1 (:next-seq @ma)))\n        (is (= :dao.stream/ok (:dao.stream/outcome (mesh/send! ma {:n 2}))))\n        (sim/pump! net)\n        (is (= 2 (:next-seq @ma))))\n      (testing \"a closed raw writer refuses every append: the seq stays\"\n        (stream/close! w)\n        (is (= :dao.stream/closed (:dao.stream/outcome (mesh/send! ma {:n 3}))))\n        (is (= 2 (:next-seq @ma)))))))\n\n\n(deftest different-origins-never-share-a-dedup-key\n  (let [net (sim/radio-net)\n        a (sim/join! net \"a\")\n        traffic (:traffic a)\n        m (mesh/make-mesh {:identity \"me\" :raw-writer (:writer a) :raw-traffic traffic\n                           :raw-cursor stream/anchor-newest :deposit (:deposit a)})]\n    (doseq [origin [\"x\" \"y\"]]\n      (stream/append! traffic\n                      (ble/frame-event \"me\" \"peer-x\"\n                                       (octets->bytes\n                                        (vec (cbor/encode\n                                              (mesh/frame origin 0 5 {:o origin})))))))\n    (mesh/mesh-step! m)\n    (is (= [{:origin \"x\" :seq 0 :value {:o \"x\"}}\n            {:origin \"y\" :seq 0 :value {:o \"y\"}}]\n           (delivered net \"a\")))))\n\n\n(deftest the-dedup-cache-is-bounded-oldest-evicted\n  (let [net (sim/radio-net)\n        a (sim/join! net \"a\")\n        traffic (:traffic a)\n        m (mesh/make-mesh {:identity \"me\" :raw-writer (:writer a) :raw-traffic traffic\n                           :raw-cursor stream/anchor-newest :deposit (:deposit a)\n                           :max-remembered 2})]\n    (doseq [i (range 4)]\n      (stream/append! traffic\n                      (ble/frame-event \"me\" \"peer-x\"\n                                       (octets->bytes\n                                        (vec (cbor/encode\n                                              (mesh/frame \"x\" i 5 {:i i})))))))\n    (mesh/mesh-step! m)\n    (is (= 4 (count (delivered net \"a\"))))\n    (testing \"seq 0 is forgotten: the same frame again delivers again\"\n      (stream/append! traffic\n                      (ble/frame-event \"me\" \"peer-x\"\n                                       (octets->bytes\n                                        (vec (cbor/encode\n                                              (mesh/frame \"x\" 0 5 {:i 0}))))))\n      (mesh/mesh-step! m)\n      (is (= 5 (count (delivered net \"a\")))))))\n\n\n;; =============================================================================\n;; Foreign frames and oversize values\n;; =============================================================================\n\n\n(deftest foreign-frames-are-skipped-silently\n  (let [net (sim/radio-net)\n        a (sim/join! net \"a\")\n        traffic (:traffic a)\n        m (mesh/make-mesh {:identity \"me\" :raw-writer (:writer a) :raw-traffic traffic\n                           :raw-cursor stream/anchor-newest :deposit (:deposit a)})\n        inject-value! (fn [v]\n                        (stream/append! traffic\n                                        (ble/frame-event\n                                         \"me\" \"peer-x\"\n                                         (octets->bytes (vec (cbor/encode v))))))\n        inject-bytes! (fn [octets]\n                        (stream/append! traffic\n                                        (ble/frame-event\n                                         \"me\" \"peer-x\" (octets->bytes octets))))]\n    (testing \"a decodable value that is not a frame\"\n      (inject-value! {:dao.jing.dht/v 1 :other \"data\"})\n      (is (= {:processed 1 :delivered 0 :relayed 0 :status :drained}\n             (mesh/mesh-step! m))))\n    (testing \"a frame key with malformed fields\"\n      (inject-value! {:dao.stream.ble.mesh/v 1 :dao.stream.ble.mesh/origin \"\"\n                      :dao.stream.ble.mesh/seq 0 :dao.stream.ble.mesh/ttl 5\n                      :dao.stream.ble.mesh/value {:x 1}})\n      (is (= {:processed 1 :delivered 0 :relayed 0 :status :drained}\n             (mesh/mesh-step! m))))\n    (testing \"bytes that are not CBOR at all -- a truncated array header\"\n      (inject-bytes! [130 1])\n      (is (= {:processed 1 :delivered 0 :relayed 0 :status :drained}\n             (mesh/mesh-step! m))))\n    (is (= [] (delivered net \"a\")))))\n\n\n(deftest an-oversize-value-is-refused-by-the-raw-writer\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")]\n      (mesh/mesh-step! ma)\n      (testing \"the raw layer owns the budget, both ways\"\n        (is (= :dao.stream/invalid-value\n               (:dao.stream/outcome\n                (mesh/send! ma {:a-very-large-value (range 100)}))))))))\n\n\n;; =============================================================================\n;; Gaps on the raw ring\n;; =============================================================================\n\n\n(deftest a-raw-gap-is-adopted-and-loses-what-the-ring-lost\n  (let [traffic (ring 3)\n        w (writer)\n        m (mesh/make-mesh {:identity \"me\" :raw-writer (:handle w)\n                           :raw-traffic traffic\n                           :raw-cursor stream/anchor-oldest\n                           :deposit (ring 64)})\n        inject! (fn [i]\n                  (stream/append! traffic\n                                  (ble/frame-event \"me\" \"peer-x\"\n                                                   (octets->bytes\n                                                    (vec (cbor/encode\n                                                          (mesh/frame \"x\" i 5 {:i i})))))))]\n    (doseq [i (range 6)] (inject! i))\n    (let [r (mesh/mesh-step! m)]\n      (is (= :drained (:status r)))\n      (testing \"fewer than six delivered: the ring evicted the rest, honestly\"\n        (is (< (:delivered r) 6)))\n      (testing \"the cursor adopted the recovery position: the next step is clean\"\n        (is (= {:processed 0 :delivered 0 :relayed 0 :status :drained}\n               (mesh/mesh-step! m)))))))\n\n\n;; =============================================================================\n;; Redundancy and loss (review round 1)\n;; =============================================================================\n\n\n(deftest one-dead-neighbor-starves-nothing\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\" \"c\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mb (make-mesh net \"b\" :identity \"origin-b\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")]\n      (doseq [m [ma mb mc]] (mesh/mesh-step! m))\n      ;; a's neighbor table still holds b; the link is gone, but a has\n      ;; not stepped through the link-down yet. The fan-out must hand\n      ;; the frame to c anyway.\n      (sim/unlink! net \"a\" \"b\")\n      (let [r (mesh/send! ma {:n 1})]\n        (is (= :dao.stream/transport-error (:dao.stream/outcome r)))\n        (sim/pump! net)\n        (mesh/mesh-step! mb)\n        (mesh/mesh-step! mc)\n        (testing \"the live neighbor received the frame\"\n          (is (= [{:origin \"origin-a\" :seq 0 :value {:n 1}}]\n                 (delivered net \"c\"))))\n        (testing \"the seq was spent: at least one link accepted\"\n          (is (= 1 (:next-seq @ma))))))))\n\n\n(deftest a-gap-leaves-the-neighbor-set-stale-and-usable\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\" \"c\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")]\n      (mesh/mesh-step! ma)\n      (mesh/mesh-step! mc)\n      (is (seq (:neighbors @ma)))\n      (sim/unlink! net \"a\" \"b\")\n      (testing \"the link facts arrive, then a gap swallows them\"\n        (doseq [_ (range 300)]\n          (stream/append! (:traffic (sim/node net \"a\"))\n                          (ble/frame-event \"a\" \"peer-x\"\n                                           (octets->bytes\n                                            (vec (cbor/encode\n                                                  (mesh/frame \"x\" 0 5 {}))))))))\n      (let [r (loop [r (mesh/mesh-step! ma)]\n                (if (= :drained (:status r))\n                  r\n                  (recur (mesh/mesh-step! ma))))]\n        (is (= :drained (:status r)))\n        (testing \"stale is the honest choice: the swallowed link-down\n                  leaves b in the set, because a cleared set would cost\n                  the mesh every relay it has and a stable link emits\n                  no link-up to refill it\"\n          (is (seq (:neighbors @ma))))\n        (testing \"and the mesh still works: the filler frame the gap\n                  did not swallow was relayed to c, and origin-a's send\n                  reached c through the stale relay's send-failed and\n                  the live one's ok\"\n          (is (= :dao.stream/transport-error\n                 (:dao.stream/outcome (mesh/send! ma {:n 1}))))\n          (sim/pump! net)\n          (mesh/mesh-step! mc)\n          (is (= [{:origin \"x\" :seq 0 :value {}}\n                  {:origin \"origin-a\" :seq 0 :value {:n 1}}]\n                 (delivered net \"c\"))))))))\n\n\n(deftest a-closed-raw-layer-clears-the-neighbor-set\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")]\n      (mesh/mesh-step! ma)\n      (is (seq (:neighbors @ma)))\n      (stream/append! (:traffic (sim/node net \"a\"))\n                      (ble/closed-event \"a\"))\n      (mesh/mesh-step! ma)\n      (is (empty? (:neighbors @ma))))))\n\n\n(deftest a-wire-ttl-above-the-budget-is-clamped\n  (let [net (sim/radio-net)]\n    (sim/unreachable! net \"a\" \"c\")\n    (sim/unreachable! net \"a\" \"d\")\n    (sim/unreachable! net \"b\" \"d\")\n    (link-all! net \"a\" \"b\" \"c\" \"d\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mb (make-mesh net \"b\" :identity \"origin-b\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")\n          md (make-mesh net \"d\" :identity \"origin-d\")]\n      (doseq [m [ma mb mc md]] (mesh/mesh-step! m))\n      (testing \"a foreign frame claiming ttl 100 relays only as far as\n                the receiving mesh's own budget allows\"\n        (stream/append! (:traffic (sim/node net \"b\"))\n                        (ble/frame-event \"b\" \"peer-x\"\n                                         (octets->bytes\n                                          (vec (cbor/encode\n                                                (mesh/frame \"x\" 0 100 {:big-ttl true}))))))\n        (mesh/mesh-step! mb)\n        (sim/pump! net)\n        (mesh/mesh-step! mc)\n        (mesh/mesh-step! md)\n        (testing \"c heard it (one hop from b), d never did (the clamp\n                  spent the budget at c's relay)\"\n          (is (= 1 (count (delivered net \"c\"))))\n          (is (= [] (delivered net \"d\"))))))))\n(ns dao.stream.ble.sim\n  \"A deterministic in-process BLE radio for the dao.stream.ble tests: the\n   virtual air, not the seam. The seam under test is always\n   dao.stream.ble.links/seam -- the same host-free adapter the dart seam\n   composes -- so what the simulation adds is only the medium: nodes\n   that advertise on every `advertise!` round, GATT connections formed\n   by the machines' own [:connect ...] actions, frames delivered along\n   connections, and controls a real radio offers no test: `unlink!`\n   tears connections down, `die!` kills a radio outright, `set-loss!`\n   drops frames in flight, `set-write-fail!` fails the host write.\n\n   Peer addresses are opaque strings of no structure, minted per\n   observer and per connection -- the same physical node may present\n   different addresses to the two ends of one pairing, which is the\n   BLE fact the design's opacity rule protects. The sim never lets a\n   test read a peer address as a node id, because nothing above the raw\n   layer may.\n\n   There are no threads and no clocks here: time is `:now`, advanced by\n   `advance!`, and every radio fact is pumped by `pump!` in FIFO order,\n   including everything pumping puts in flight. A test that drives the\n   pump drives the world.\"\n  (:require [dao.stream :as stream]\n            [dao.stream.ble :as ble]\n            [dao.stream.ble.links :as links]\n            [dao.stream.ble.mesh :as mesh]\n            [dao.stream.ringbuffer :as ringbuffer]))\n\n\n(def default-ring-capacity\n  \"The traffic and deposit ring capacity of a sim node, in events.\"\n  256)\n\n\n(defn radio-net\n  \"The net: nodes, physical GATT connections keyed by id (each with the\n   two endpoints and the peer address each end reports the other by),\n   the advertisement addresses per observer pair, unreachable pairs,\n   dead radios, a frame-loss predicate, and the queue pump! runs.\n   `:now` starts at zero; `:rssi` is every advertisement's reported\n   strength.\"\n  []\n  (atom {:nodes {}\n         :conns {}\n         :addr {}\n         :peer-of {}\n         :unreachable #{}\n         :dead #{}\n         :stopped #{}\n         :write-fail #{}\n         :loss-fn nil\n         :queue []\n         :now 0\n         :rssi -60\n         :counter 0}))\n\n\n(defn advance!\n  \"Time moves. The discovery throttle's windows read this clock.\"\n  [net ms]\n  (swap! net update :now + ms)\n  nil)\n\n\n(defn unreachable!\n  \"`a` and `b` never hear each other: no advertisements, no links, no\n   frames, as if out of range. Existing connections are left alone;\n   `unlink!` tears those down.\"\n  [net a b]\n  (swap! net update :unreachable conj (if (neg? (compare a b)) [a b] [b a]))\n  nil)\n\n\n(defn set-loss!\n  \"A frame-loss predicate: (f from to bytes) -> truthy drops one frame\n   in flight, silently, as the air does.\"\n  [net f]\n  (swap! net assoc :loss-fn f)\n  nil)\n\n\n(defn set-write-fail!\n  \"Every frame `a` sends toward `b` fails at the host write, reported as\n   a [:send-fail ...] radio event -- the plugin-level failure a real\n   stack answers with a write error, distinct from air loss.\"\n  [net a b fail?]\n  (swap! net (fn [n]\n               (assoc n :write-fail\n                      (if fail?\n                        (conj (:write-fail n) [a b])\n                        (disj (:write-fail n) [a b])))))\n  nil)\n\n\n(defn- reachable?\n  [net a b]\n  (and (not (contains? (:dead @net) a))\n       (not (contains? (:dead @net) b))\n       (not (contains? (:unreachable @net)\n                       (if (neg? (compare a b)) [a b] [b a])))))\n\n\n(defn- fresh-addr!\n  \"One opaque peer address, never reused.\"\n  [net]\n  (let [n (swap! net update :counter inc)]\n    (str \"peer-\" (:counter n))))\n\n\n(defn- note-addr!\n  [net addr node-id]\n  (swap! net assoc-in [:peer-of addr] node-id)\n  addr)\n\n\n(defn- addr-of!\n  \"The peer address `observer`'s radio reports `other` by in\n   advertisements, minted on first observation, stable per pair --\n   the advertisement is the stable thing; connections mint their own.\"\n  [net observer other]\n  (or (get-in @net [:addr observer other])\n      (let [addr (note-addr! net (fresh-addr! net) other)]\n        (swap! net assoc-in [:addr observer other] addr)\n        addr)))\n\n\n(defn addr\n  \"The advertisement address `observer` reports `other` by, or nil if\n   they have never observed each other.\"\n  [net observer other]\n  (get-in @net [:addr observer other]))\n\n\n(defn- conn-between\n  \"One [id conn role] for `owner`'s connection addressed `peer`, the\n   role (:a or :b) saying which end `owner` holds, or nil.\"\n  [net owner peer]\n  (some (fn [[id c]]\n          (cond\n            (and (= (:a c) owner) (= (:addr-at-a c) peer)) [id c :a]\n            (and (= (:b c) owner) (= (:addr-at-b c) peer)) [id c :b]))\n        (:conns @net)))\n\n\n(defn- feed!\n  \"One radio event for `node-id`'s machine, queued.\"\n  [net node-id ev]\n  (swap! net update :queue conj [node-id :event ev])\n  nil)\n\n\n(defn- establish!\n  \"One physical GATT connection out of `a`'s connect action: `a` dialed\n   the advertisement address it observed, `b` mints a fresh address for\n   the incoming connection -- the same pairing, two views, possibly two\n   addresses. Both machines hear [:link-up ...] with the role each\n   holds.\"\n  [net a b dial-addr]\n  (let [in-addr (note-addr! net (fresh-addr! net) a)\n        id (fresh-addr! net)]\n    (swap! net assoc-in [:conns id]\n           {:a a :b b :addr-at-a dial-addr :addr-at-b in-addr})\n    (feed! net a [:link-up dial-addr :central])\n    (feed! net b [:link-up in-addr :peripheral])))\n\n\n(defn- perform-connect!\n  [net a peer]\n  (let [b (get (:peer-of @net) peer)]\n    (cond\n      (nil? b)\n      (feed! net a [:link-failed peer])\n\n      (not (reachable? net a b))\n      (feed! net a [:link-failed peer])\n\n      :else\n      (establish! net a b peer))))\n\n\n(defn- perform-send-frame!\n  [net a peer bs]\n  (let [[_id c role] (conn-between net a peer)\n        other (cond\n                (nil? c) nil\n                (= role :a) (:b c)\n                :else (:a c))]\n    (cond\n      (nil? c)\n      (feed! net a [:send-fail peer \"no link\"])\n\n      (contains? (:write-fail @net) [a other])\n      (feed! net a [:send-fail peer \"write refused\"])\n\n      (and (:loss-fn @net) ((:loss-fn @net) a other bs))\n      ;; The air ate it: no report ever reaches the sender.\n      nil\n\n      :else\n      (feed! net other\n             [:frame (if (= role :a) (:addr-at-b c) (:addr-at-a c)) bs]))\n    nil))\n\n\n(defn- perform!\n  [net node-id action]\n  (let [[kind peer arg] action]\n    (case kind\n      :connect (perform-connect! net node-id peer)\n      :send-frame (perform-send-frame! net node-id peer arg)\n      :stop-radio (swap! net update :stopped conj node-id)\n      nil)))\n\n\n(defn pump!\n  \"Run everything in flight -- radio events and the actions they emit,\n   including everything pumping puts in flight -- in FIFO order, until\n   the world is quiescent.\"\n  [net]\n  (loop []\n    (let [q (:queue @net)]\n      (when (seq q)\n        (swap! net assoc :queue [])\n        (doseq [[node-id kind x] q]\n          (if (= kind :event)\n            (when-some [seam (:seam (get (:nodes @net) node-id))]\n              ((:radio! seam) x))\n            (perform! net node-id x)))\n        (recur))))\n  nil)\n\n\n(defn advertise!\n  \"One advertisement round: every live, unstopped node's radio is\n   observed by every other live, unstopped, reachable node. The\n   machines' connect policy and the throttle do the rest; `pump!` runs\n   at the end, so everything the round emits has settled.\"\n  [net]\n  (let [ids (->> (:nodes @net)\n                 (filter (fn [[id _n]] (and (not (contains? (:dead @net) id))\n                                            (not (contains? (:stopped @net) id)))))\n                 (map first)\n                 sort)]\n    (doseq [a ids\n            b ids\n            :when (and (not= a b) (reachable? net a b))]\n      (feed! net a [:adv (addr-of! net a b) (:rssi @net)]))\n    (pump! net)))\n\n\n(defn join!\n  \"Add `node-id` to the net as a bound radio node: a traffic ring, a\n   deposit ring, the host-free seam over the net's virtual radio, and\n   the writer composed over both, per the design's two moves collapsed\n   by the sim's synchronous bind. Answers the node map\n   {:id id :traffic h :deposit h :seam s :writer h :descriptor d}. The\n   mesh above it is the test's composition, not this one's.\"\n  [net node-id & [{:keys [capacity max-links announce-window-ms\n                          max-frame-bytes]}]]\n  (when (contains? (:nodes @net) node-id)\n    (throw (ex-info \"a sim node id is joined once\" {:node-id node-id})))\n  (let [capacity (or capacity default-ring-capacity)\n        ring (fn [] (:dao.stream/handle\n                     (ringbuffer/create!\n                      {:dao.stream/type ringbuffer/transport-type\n                       ringbuffer/capacity-key capacity})))\n        traffic (ring)\n        deposit (ring)\n        clock (fn [] (:now @net))\n        seam (links/seam\n              {:identity node-id\n               :deposit traffic\n               :max-frame-bytes max-frame-bytes\n               :max-links max-links\n               :announce-window-ms announce-window-ms\n               :now-ms clock\n               :radio {:perform! (fn [action] (swap! net update :queue conj [node-id :action action]))}})\n        descriptor {:dao.stream/type ble/transport-type\n                    :dao.stream/identity node-id\n                    :dao.stream.ble/self node-id}\n        node {:id node-id\n              :traffic traffic\n              :deposit deposit\n              :seam seam\n              :writer (ble/writer seam descriptor\n                                  (or max-frame-bytes\n                                      ble/default-max-frame-bytes))\n              :descriptor descriptor}]\n    (swap! net assoc-in [:nodes node-id] node)\n    (feed! net node-id [:radio-up node-id])\n    (pump! net)\n    node))\n\n\n(defn node\n  \"The node map `join!` answered, by id.\"\n  [net node-id]\n  (get (:nodes @net) node-id))\n\n\n(defn unlink!\n  \"Tear down every physical GATT connection between `a` and `b`: each\n   end's machine hears [:link-down ...] for the address it holds for\n   that connection, and the sim's connection records are cleared.\"\n  [net a b]\n  (let [conns (->> (:conns @net)\n                   (filter (fn [[_ c]]\n                             (or (and (= (:a c) a) (= (:b c) b))\n                                 (and (= (:a c) b) (= (:b c) a))))))]\n    (doseq [[id c] conns]\n      (swap! net update :conns dissoc id)\n      (feed! net (:a c) [:link-down (:addr-at-a c)])\n      (feed! net (:b c) [:link-down (:addr-at-b c)]))\n    (pump! net)))\n\n\n(defn die!\n  \"Kill `node-id`'s radio outright: every peer's connection to it goes\n   down (the peer hears [:link-down ...]; the dead node hears nothing,\n   as a dead radio reports nothing) and the node itself is taken off\n   the air -- no advertisements, no deliveries, and connects to it fail\n   with [:link-failed ...].\"\n  [net node-id]\n  (let [conns (->> (:conns @net)\n                   (filter (fn [[_ c]]\n                             (or (= (:a c) node-id) (= (:b c) node-id)))))]\n    (doseq [[id c] conns]\n      (swap! net update :conns dissoc id)\n      (let [[survivor addr]\n            (if (= (:a c) node-id)\n              [(:b c) (:addr-at-b c)]\n              [(:a c) (:addr-at-a c)])]\n        (feed! net survivor [:link-down addr])))\n    (swap! net update :dead conj node-id)\n    (pump! net)))\n\n\n(defn linked?\n  \"True iff the sim holds at least one physical GATT connection between\n   `a` and `b`.\"\n  [net a b]\n  (boolean\n   (some (fn [[_ c]]\n           (or (and (= (:a c) a) (= (:b c) b))\n               (and (= (:a c) b) (= (:b c) a))))\n         (:conns @net))))\n\n\n(defn values\n  \"Every value a reader handle currently retains, oldest first -- the\n   tests' one observation primitive.\"\n  [h]\n  (loop [c (:dao.stream/cursor (stream/cursor h stream/anchor-oldest))\n         acc []]\n    (let [r (stream/next h c)]\n      (if (= :dao.stream/ok (:dao.stream/outcome r))\n        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n        acc))))\n\n\n(defn events\n  \"The lifecycle events on `node`'s traffic ring, oldest first.\"\n  [net node-id]\n  (->> (values (:traffic (node net node-id)))\n       (filter ble/lifecycle-event?)))\n\n\n(defn frames\n  \"The frame events on `node`'s traffic ring, oldest first.\"\n  [net node-id]\n  (->> (values (:traffic (node net node-id)))\n       (filter ble/frame-event?)))\n\n\n(defn deliveries\n  \"The mesh delivery events on `node`'s deposit ring, oldest first.\"\n  [net node-id]\n  (->> (values (:deposit (node net node-id)))\n       (filter mesh/delivery-event?)))\n","exit_code":0,"status":"completed"}}
