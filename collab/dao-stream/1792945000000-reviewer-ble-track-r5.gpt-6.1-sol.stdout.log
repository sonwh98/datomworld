{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"rg -l -F 'ble-track' /Users/sto/workspace/datomworld/collab /Users/sto/workspace/datomworld/orchestrator-logs /Users/sto/workspace/datomworld-ble2/collab /Users/sto/workspace/datomworld-ble2/orchestrator-logs --glob '\"'!*.stdout.log'\"'; sed -n '220,400p' .agents/skills/code-review-pr/scripts/pr_reviewer.py\"","aggregated_output":"/Users/sto/workspace/datomworld/collab/1792945000000-reviewer-ble-track-r5.prompt.md\n            log_args = [\"log\", \"--oneline\", target]\n        else:\n            log_args = [\"log\", \"--oneline\", \"-n\", \"10\", target]\n\n    diff_text = run_git_command(git_args, cwd=repo_dir)\n\n    # Get numstat\n    numstat_raw = run_git_command(git_args + [\"--numstat\"], cwd=repo_dir)\n\n    # Get commit log if available\n    commits = []\n    try:\n        log_raw = run_git_command(log_args, cwd=repo_dir)\n        if log_raw:\n            commits = log_raw.splitlines()\n    except Exception:\n        commits = []\n\n    file_stats: List[FileStat] = []\n    total_additions = 0\n    total_deletions = 0\n    test_additions = 0\n    source_additions = 0\n\n    for line in numstat_raw.splitlines():\n        parts = line.split(\"\\t\")\n        if len(parts) == 3:\n            add_str, del_str, file_path = parts\n            add = int(add_str) if add_str.isdigit() else 0\n            dele = int(del_str) if del_str.isdigit() else 0\n\n            category, risk = categorize_file(file_path)\n            file_stats.append(\n                FileStat(\n                    path=file_path,\n                    additions=add,\n                    deletions=dele,\n                    category=category,\n                    risk_level=risk,\n                )\n            )\n\n            total_additions += add\n            total_deletions += dele\n\n            if category == \"Tests\":\n                test_additions += add\n            elif category in [\"Source Code\", \"Security/Auth\", \"Database/Schema\", \"API/Contract\"]:\n                source_additions += add\n\n    ratio = (test_additions / source_additions) if source_additions > 0 else (1.0 if test_additions > 0 else 0.0)\n\n    findings = scan_diff_content(diff_text)\n\n    # Add meta finding if source added without tests\n    if source_additions > 50 and test_additions == 0:\n        findings.append(\n            Finding(\n                severity=\"P1\",\n                category=\"TestCoverage\",\n                file_path=\"Repository\",\n                line_number=None,\n                message=f\"Significant source changes ({source_additions} lines added) without any new/updated tests.\",\n                snippet=\"\",\n            )\n        )\n\n    return ReviewSummary(\n        target=target,\n        total_files=len(file_stats),\n        total_additions=total_additions,\n        total_deletions=total_deletions,\n        test_additions=test_additions,\n        source_additions=source_additions,\n        test_to_source_ratio=round(ratio, 2),\n        file_stats=file_stats,\n        findings=findings,\n        commits=commits,\n    )\n\n\ndef generate_markdown_report(summary: ReviewSummary) -> str:\n    \"\"\"Formats ReviewSummary into a clean Markdown PR review report.\"\"\"\n    lines = []\n    lines.append(f\"# Code Review Summary for `{summary.target}`\")\n    lines.append(\"\")\n    lines.append(\"## Executive Overview\")\n    lines.append(f\"- **Total Files Changed:** {summary.total_files}\")\n    lines.append(f\"- **Lines Added:** +{summary.total_additions} | **Lines Deleted:** -{summary.total_deletions}\")\n    lines.append(f\"- **Test-to-Source Additions Ratio:** {summary.test_to_source_ratio} ({summary.test_additions} test lines vs {summary.source_additions} source lines)\")\n\n    high_risk_files = [f for f in summary.file_stats if f.risk_level == \"High\"]\n    overall_risk = \"HIGH\" if (high_risk_files or any(f.severity in [\"P0\", \"P1\"] for f in summary.findings)) else (\"MEDIUM\" if summary.total_additions > 100 else \"LOW\")\n    lines.append(f\"- **Overall Change Risk:** `{overall_risk}`\")\n    lines.append(\"\")\n\n    if summary.commits:\n        lines.append(\"### Included Commits\")\n        for c in summary.commits[:10]:\n            lines.append(f\"- {c}\")\n        if len(summary.commits) > 10:\n            lines.append(f\"- ... and {len(summary.commits) - 10} more commits.\")\n        lines.append(\"\")\n\n    lines.append(\"## Automated Scan Findings\")\n    if not summary.findings:\n        lines.append(\"✅ No critical security or code quality smells detected by automated scan.\")\n    else:\n        # Group by severity\n        for sev in [\"P0\", \"P1\", \"P2\", \"P3\"]:\n            sev_findings = [f for f in summary.findings if f.severity == sev]\n            if sev_findings:\n                sev_title = {\"P0\": \"P0 - Critical (Blocker)\", \"P1\": \"P1 - High (Must Address)\", \"P2\": \"P2 - Medium (Recommended)\", \"P3\": \"P3 - Low (Nit / Suggestion)\"}[sev]\n                lines.append(f\"### {sev_title}\")\n                for f in sev_findings:\n                    loc = f\"`{f.file_path}`\" + (f\":L{f.line_number}\" if f.line_number else \"\")\n                    lines.append(f\"- **[{f.category}]** {loc}: {f.message}\")\n                    if f.snippet:\n                        lines.append(f\"  ```\\n  {f.snippet}\\n  ```\")\n    lines.append(\"\")\n\n    lines.append(\"## File Churn & Risk Breakdown\")\n    lines.append(\"| File Path | Category | +Add | -Del | Risk |\")\n    lines.append(\"| :--- | :--- | :--- | :--- | :--- |\")\n    for f in sorted(summary.file_stats, key=lambda x: (x.risk_level != \"High\", x.risk_level != \"Medium\", -(x.additions + x.deletions))):\n        lines.append(f\"| `{f.path}` | {f.category} | +{f.additions} | -{f.deletions} | `{f.risk_level}` |\")\n    lines.append(\"\")\n\n    lines.append(\"## Reviewer Focus & Recommendations\")\n    categories_present = set(f.category for f in summary.file_stats)\n    if \"Security/Auth\" in categories_present:\n        lines.append(\"- 🔒 **Security / Auth:** Double-check credential handling, session management, and authorization checks.\")\n    if \"Database/Schema\" in categories_present:\n        lines.append(\"- 🗄️ **Database:** Verify migration rollback compatibility, index performance, and transaction boundaries.\")\n    if \"API/Contract\" in categories_present:\n        lines.append(\"- 🔌 **API Contract:** Ensure backward compatibility for public endpoints and schema definitions.\")\n    if summary.test_to_source_ratio < 0.3 and summary.source_additions > 30:\n        lines.append(\"- 🧪 **Testing:** Test coverage appears low relative to source code additions. Request unit/integration test additions.\")\n\n    return \"\\n\".join(lines)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"PR Reviewer & Git Diff Analyzer\")\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Subcommand to run\")\n\n    analyze_parser = subparsers.add_parser(\"analyze\", help=\"Analyze git target and generate report\")\n    analyze_parser.add_argument(\"--target\", default=\"main...HEAD\", help=\"Git ref/range to analyze (e.g. main...HEAD, HEAD~1, staged, working)\")\n    analyze_parser.add_argument(\"--output\", help=\"Output file path (Markdown or JSON depending on format)\")\n    analyze_parser.add_argument(\"--format\", choices=[\"markdown\", \"json\"], default=\"markdown\", help=\"Output format (markdown or json)\")\n    analyze_parser.add_argument(\"--repo-dir\", help=\"Target git repository directory\")\n\n    args = parser.parse_args()\n\n    if not args.command or args.command == \"analyze\":\n        target = getattr(args, \"target\", \"main...HEAD\")\n        output = getattr(args, \"output\", None)\n        fmt = getattr(args, \"format\", \"markdown\")\n        repo_dir = getattr(args, \"repo-dir\", None)\n\n        try:\n            summary = analyze_git_target(target, repo_dir=repo_dir)\n\n            if fmt == \"json\":\n                result = json.dumps(asdict(summary), indent=2)\n            else:\n                result = generate_markdown_report(summary)\n\n            if output:\n                out_path = Path(output)\n                out_path.parent.mkdir(parents=True, exist_ok=True)\n                out_path.write_text(result, encoding=\"utf-8\")\n                print(f\"✅ Review report written to: {out_path.resolve()}\")\n            else:\n                print(result)\n\n        except Exception as e:\n            sys.stderr.write(f\"Error during PR analysis: {e}\\n\")\n            sys.exit(1)\n\n\n","exit_code":0,"status":"completed"}}
