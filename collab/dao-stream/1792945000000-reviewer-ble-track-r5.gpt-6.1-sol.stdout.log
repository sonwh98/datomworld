   143\t\n   144\t(defn- connect-central!\n   145\t  \"One central connection to `peer`, per the [:connect ...] action: dial,\n   146\t   discover the mesh service, subscribe to its TX characteristic, and\n   147\t   route what arrives. Every late fact is a radio event: the\n   148\t   connection's frames, its failure, its end. A peer that connects but\n   149\t   serves no mesh profile is a failed dial -- the device is released,\n   150\t   the dial's slot freed with [:link-failed ...], and the next\n   151\t   advertisement window may try again -- never a silent connection the\n   152\t   seam holds but cannot use.\"\n   153\t  [radio! !links !subs peer service-uuid tx-uuid rx-uuid !watched]\n   154\t  (let [release! (fn [d]\n   155\t                   (-> (.disconnect ^fbp/BluetoothDevice d)\n   156\t                       (.catchError (fn [_] nil))))]\n   157\t    (try\n   158\t      (let [d (fbp/BluetoothDevice.fromId peer)\n   159\t            _ (await (.connect ^fbp/BluetoothDevice d\n   160\t                               .timeout (core/Duration .seconds 15)\n   161\t                               .autoConnect false))\n   162\t            {:keys [tx rx]} (await (mesh-characteristics\n   163\t                                    d service-uuid tx-uuid rx-uuid))]\n   164\t        (if tx\n   165\t          (do (await (.setNotifyValue ^fbp/BluetoothCharacteristic tx true))\n   166\t              (swap! !links assoc peer {:device d :tx tx :rx rx})\n   167\t              (watch-central! radio! !watched !subs peer d)\n   168\t              (swap! !subs conj\n   169\t                     (listen!\n   170\t                      (.-onValueReceived ^fbp/BluetoothCharacteristic tx)\n   171\t                      (fn [v] (radio! [:frame peer (bytes->uint8 v)]))\n   172\t                      (fn [e] (radio! [:send-fail peer (str \"notify: \" e)]))))\n   173\t              (radio! [:link-up peer :central]))\n   174\t          (do (release! d)\n   175\t              (radio! [:link-failed peer]))))\n   176\t      (catch Object _\n   177\t        (radio! [:link-failed peer])))))\n   178\t\n   179\t\n   180\t;; =============================================================================\n   181\t;; The peripheral role (flutter_ble_peripheral)\n   182\t;; =============================================================================\n   183\t\n   184\t\n   185\t(defn- start-peripheral!\n   186\t  \"Advertise the service UUID and serve its GATT profile: the TX\n   187\t   characteristic notified out, the RX one written in. GattWrite\n   188\t   carries no central identity, so every write arrives at the one\n   189\t   synthetic peer address. Subscription events are filtered by the TX\n   190\t   characteristic: a subscription to a write characteristic is not a\n   191\t   mesh link.\"\n   192\t  [radio! service-uuid tx-uuid rx-uuid !subs]\n   193\t  (let [p (periph/FlutterBlePeripheral)]\n   194\t    (try\n   195\t      (await (.start ^periph/FlutterBlePeripheral p\n   196\t                     .advertiseData\n   197\t                     (periph/AdvertiseDataCore .serviceUuid service-uuid)\n   198\t                     .gattServer\n   199\t                     (periph/GattServerSettings\n   200\t                      .serviceUuid service-uuid\n   201\t                      .txCharacteristicUuid tx-uuid\n   202\t                      .rxCharacteristicUuid rx-uuid)))\n   203\t      (swap! !subs conj\n   204\t             (listen!\n   205\t              (.-onGattWrite ^periph/FlutterBlePeripheral p)\n   206\t              (fn [w]\n   207\t                (let [^periph/GattWrite gw w]\n   208\t                  (when (= (.-characteristicUuid gw) rx-uuid)\n   209\t                    (radio! [:frame peripheral-peer\n   210\t                             (bytes->uint8 (.-data gw))]))))\n   211\t              (fn [e] (radio! [:send-fail peripheral-peer (str \"gatt: \" e)]))))\n   212\t      (swap! !subs conj\n   213\t             (listen!\n   214\t              (.-onCharacteristicSubscriptionChanged\n   215\t               ^periph/FlutterBlePeripheral p)\n   216\t              (fn [s]\n   217\t                (let [^periph/GattSubscription gs s]\n   218\t                  (when (= (.-characteristicUuid gs) tx-uuid)\n   219\t                    (if (.-subscribed gs)\n   220\t                      (radio! [:link-up peripheral-peer :peripheral])\n   221\t                      (radio! [:link-down peripheral-peer])))))\n   222\t              (fn [_] (radio! [:link-down peripheral-peer]))))\n   223\t      (catch Object e\n   224\t        (radio! [:bind-failed (str \"peripheral: \" e)])))\n   225\t    p))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; The seam: bind! and its radio map\n   230\t;; =============================================================================\n   231\t\n   232\t\n   233\t(defn- perform-connect!\n   234\t  \"The [:connect peer] action: dial through the central plugin. A peer\n   235\t   the scan never reported is dialed by address anyway -- fromId does\n   236\t   not need the advertisement.\"\n   237\t  [{:keys [radio! !links !subs !watched service-uuid tx-uuid rx-uuid]} peer]\n   238\t  (connect-central! radio! !links !subs peer service-uuid tx-uuid rx-uuid !watched))\n   239\t\n   240\t\n   241\t(defn- perform-send-frame!\n   242\t  \"The [:send-frame peer bytes] action: over the central link's RX\n   243\t   characteristic, or -- for the peripheral role's one synthetic peer --\n   244\t   sendData, which notifies every subscribed central at once. A failure\n   245\t   the host reports later arrives as the send-failed channel of\n   246\t   design 4. A link whose peer spoke only half the profile sends\n   247\t   nothing: the [:send-fail ...] for a write the host cannot serve is\n   248\t   the honest answer, and the mesh's redundancy is the recovery.\"\n   249\t  [{:keys [radio! !links tx-uuid]} peer ^Uint8List bs]\n   250\t  (if (= peer peripheral-peer)\n   251\t    (when-some [p (:peripheral (get @!links peripheral-peer))]\n   252\t      (-> (.sendData ^periph/FlutterBlePeripheral p bs\n   253\t                     .characteristicUuid tx-uuid)\n   254\t          (.catchError\n   255\t            (fn [e] (radio! [:send-fail peripheral-peer (str \"send: \" e)])))))\n   256\t    (when-some [{:keys [rx]} (get @!links peer)]\n   257\t      (when rx\n   258\t        (-> (.write ^fbp/BluetoothCharacteristic rx (vec bs) .withoutResponse false)\n   259\t            (.catchError\n   260\t              (fn [e] (radio! [:send-fail peer (str \"write: \" e)])))))))\n   261\t  nil)\n   262\t\n   263\t\n   264\t(defn- perform-stop-radio!\n   265\t  \"The [:stop-radio] action: the scan stops, every central device\n   266\t   disconnects, the advertisement stops, and every plugin subscription\n   267\t   is cancelled. Idempotent by the plugins' own contracts.\"\n   268\t  [{:keys [!links !subs]}]\n   269\t  ;; Every teardown future is caught: a platform refusal during stop is\n   270\t  ;; nobody's outcome (close! already answered ok), so it is dropped,\n   271\t  ;; never an unhandled zone error.\n   272\t  (-> (fbp/FlutterBluePlus.stopScan) (.catchError (fn [_] nil)))\n   273\t  (doseq [{:keys [device]} (vals @!links)]\n   274\t    (when device\n   275\t      (-> (.disconnect ^fbp/BluetoothDevice device)\n   276\t          (.catchError (fn [_] nil)))))\n   277\t  (when-some [p (:peripheral (get @!links peripheral-peer))]\n   278\t    (-> (.stop ^periph/FlutterBlePeripheral p)\n   279\t        (.catchError (fn [_] nil))))\n   280\t  (doseq [s @!subs]\n   281\t    (try (.cancel ^async/StreamSubscription s) (catch Object _ nil)))\n   282\t  (reset! !links {})\n   283\t  nil)\n   284\t\n   285\t\n   286\t(defn- start-radio!\n   287\t  \"The scan, started once per bind: every advertisement of the service\n   288\t   UUID delivered one by one, the machine's discovery throttle owning\n   289\t   the repetition; then the peripheral role serving the same profile.\n   290\t   The machine is told the radio is up only once both roles answered\n   291\t   -- [:radio-up self] is what deposits :bound, the event the design's\n   292\t   second move composes the writer from. A platform refusal anywhere is\n   293\t   :bind-failed, as data, and no bound is ever deposited.\"\n   294\t  [radio! identity service-uuid tx-uuid rx-uuid !subs !links]\n   295\t  (try\n   296\t    (await (fbp/FlutterBluePlus.startScan\n   297\t            .withServices [(fbp/Guid service-uuid)]\n   298\t            .continuousUpdates true\n   299\t            .oneByOne true))\n   300\t    (let [p (start-peripheral! radio! service-uuid tx-uuid rx-uuid !subs)]\n   301\t      (swap! !links assoc peripheral-peer {:peripheral p})\n   302\t      (radio! [:radio-up identity]))\n   303\t    (catch Object e\n   304\t      (radio! [:bind-failed (str e)]))))\n   305\t\n   306\t\n   307\t(defn bind!\n   308\t  \"The bind move of design 3 over the Flutter plugins: the bind data of\n   309\t   section 3 in, the seam contract's {:send! f :close! f} out at once\n   310\t   (with :radio! and :state exposed) -- the radio starts underneath,\n   311\t   and its first facts (:bound or :bind-failed) arrive on the traffic\n   312\t   stream as data. `:now-ms` defaults to the host clock; every other\n   313\t   key is composition data with the design's defaults. `:radio!` stays\n   314\t   exposed for a composition that must feed the machine platform facts\n   315\t   the plugins do not report (a suspension, a permission revocation).\"\n   316\t  [{:keys [identity deposit service-uuid max-frame-bytes max-links\n   317\t           announce-window-ms now-ms]}]\n   318\t  (let [service-uuid (or service-uuid ble/default-service-uuid)\n   319\t        tx-uuid ble/default-tx-uuid\n   320\t        rx-uuid ble/default-rx-uuid\n   321\t        !links (atom {})\n   322\t        !watched (atom #{})\n   323\t        !subs (atom [])\n   324\t        !machine! (atom nil)\n   325\t        ;; Forwarding reference: the machine is wired below, but the\n   326\t        ;; plugin streams are wired before it answers -- a radio fact\n   327\t        ;; arriving in between finds the atom nil and is dropped, and\n   328\t        ;; the plugins deliver nothing before their futures resolve.\n   329\t        radio! (fn [ev] (when-some [f @!machine!] (f ev)))\n   330\t        ctx {:radio! radio! :!links !links :!watched !watched :!subs !subs\n   331\t             :service-uuid service-uuid :tx-uuid tx-uuid :rx-uuid rx-uuid}\n   332\t        perform! (fn [action]\n   333\t                   (let [[kind peer arg] action]\n   334\t                     (case kind\n   335\t                       :connect (perform-connect! ctx peer)\n   336\t                       :send-frame (perform-send-frame! ctx peer (bytes->uint8 arg))\n   337\t                       :stop-radio (perform-stop-radio! ctx)\n   338\t                       nil)))\n   339\t        seam (links/seam\n   340\t              {:identity identity\n   341\t               :deposit deposit\n   342\t               :max-frame-bytes max-frame-bytes\n   343\t               :max-links max-links\n   344\t               :announce-window-ms announce-window-ms\n   345\t               :now-ms (or now-ms\n   346\t                           #(.-millisecondsSinceEpoch (core/DateTime.now)))\n   347\t               :radio {:perform! perform!}})]\n   348\t    (reset! !machine! (:radio! seam))\n   349\t    (adapter-events! radio!)\n   350\t    (scan-events! radio!)\n   351\t    (start-radio! radio! identity service-uuid tx-uuid rx-uuid !subs !links)\n   352\t    seam))\n   300\t  \"Every deposit onto the deposit writer, in order, each appended even if\n   301\t   the one before it answered non-ok -- the deposit writer is an evicting\n   302\t   ring by contract and never refuses (design 5). Total even if the\n   303\t   composition behind it is broken.\"\n   304\t  [deposit deposits]\n   305\t  (doseq [ev deposits]\n   306\t    (try (stream/append! deposit ev)\n   307\t         (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))))\n   308\t\n   309\t\n   310\t(defn seam\n   311\t  \"The generic adapter (design 6): the machine composed into the seam\n   312\t   contract `dao.stream.ble/writer` consumes, over a `radio` map the\n   313\t   host supplies:\n   314\t\n   315\t     {:perform! (fn [action])}   machine -> radio: [:connect peer],\n   316\t                                 [:send-frame peer bytes], [:stop-radio]\n   317\t\n   318\t   and answers {:send! f :close! f :radio! f :state f}: `:send!`/\n   319\t   `:close!` are the seam contract (bind data in, those two out, deposits\n   320\t   flowing to `:deposit` only); `:radio!` is the adapter's one entry, one\n   321\t   radio event in; `:state` observes the machine, for tests. `:send!`\n   322\t   hands the frame to the radio and answers `ok` -- it asserts nothing\n   323\t   about the air -- and a failure the host reports later arrives as a\n   324\t   [:send-fail ...] radio event, the send-failed channel of design 4.\n   325\t   The radio's own send failures are deposited; they are not retried.\"\n   326\t  [{:keys [identity deposit max-frame-bytes max-links announce-window-ms\n   327\t           now-ms radio]}]\n   328\t  (when-not (and (map? radio) (fn? (:perform! radio)))\n   329\t    (throw (ex-info \"a dao.stream.ble seam needs a radio with :perform!\"\n   330\t                    {:radio radio})))\n   331\t  (let [state (atom (initial-state\n   332\t                     {:identity identity\n   333\t                      :max-links max-links\n   334\t                      :announce-window-ms announce-window-ms\n   335\t                      :max-frame-bytes max-frame-bytes\n   336\t                      :now-ms now-ms}))\n   337\t        run! (fn [a]\n   338\t               (reset! state (:state a))\n   339\t               (append-deposits! deposit (: