                     (remember [identity next-seq])))))\n   282\t          (or first-refusal {:dao.stream/outcome :dao.stream/ok})))\n   283\t      {:dao.stream/outcome :dao.stream/invalid-value\n   284\t       :dao.stream.ble.mesh/reason \"value is outside the portable domain\"})))\n   285\t\n   382\t                 (recur (dec left)))\n   383\t\n   384\t             :dao.stream/blocked\n   385\t             (vreset! stop :drained)\n   386\t\n   387\t             :dao.stream/gap\n   388\t             ;; A raw gap adopts the recovery cursor and the step\n   389\t             ;; continues: those events are lost, indistinguishable\n   390\t             ;; from radio loss, and flooding's redundancy recovers\n   391\t             ;; exactly as it does for network loss. Link facts the\n   392\t             ;; gap swallowed may leave the neighbor set stale -- a\n   393\t             ;; dead neighbor's relays answer send-failed and cost\n   394\t             ;; nothing, while a cleared set would cost the mesh every\n   395\t             ;; relay it has, and a stable link emits no link-up to\n   396\t             ;; refill it. Stale-but-usable is the honest choice, and\n   397\t             ;; the next link-down corrects it.\n   398\t             (do (swap! mesh assoc :raw-cursor (:dao.stream/cursor r))\n   399\t                 (recur (dec left)))\n   400\t\n   401\t             ;; A closed or failed raw ring stops the step; the mesh\n   402\t             ;; answers what it processed. The composition re-binds or\n   403\t             ;; tears down; this layer invents neither.\n   404\t             (vreset! stop :drained)))))\n   405\t     (assoc @counts :status (or @stop :budget)))))\n   115\t  [state]\n   116\t  (< (+ (count (:links state)) (count (:connecting state)))\n   117\t     (:max-links state)))\n   118\t\n   119\t\n   120\t(defn- prune-announced\n   121\t  \"Announcement windows older than :announce-window-ms are dropped, so\n   122\t   a scanner seeing rotating