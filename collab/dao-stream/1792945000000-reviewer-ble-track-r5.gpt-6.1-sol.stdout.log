e advertisement stops, and every plugin subscription\n   267\t   is cancelled. Idempotent by the plugins' own contracts.\"\n   268\t  [{:keys [!links !subs]}]\n   269\t  ;; Every teardown future is caught: a platform refusal during stop is\n   270\t  ;; nobody's outcome (close! already answered ok), so it is dropped,\n   271\t  ;; never an unhandled zone error.\n   272\t  (-> (fbp/FlutterBluePlus.stopScan) (.catchError (fn [_] nil)))\n   273\t  (doseq [{:keys [device]} (vals @!links)]\n   274\t    (when device\n   275\t      (-> (.disconnect ^fbp/BluetoothDevice device)\n   276\t          (.catchError (fn [_] nil)))))\n   277\t  (when-some [p (:peripheral (get @!links peripheral-peer))]\n   278\t    (-> (.stop ^periph/FlutterBlePeripheral p)\n   279\t        (.catchError (fn [_] nil))))\n   280\t  (doseq [s @!subs]\n   281\t    (try (.cancel ^async/StreamSubscription s) (catch Object _ nil)))\n   282\t  (reset! !links {})\n   340\t              {:identity identity\n   341\t               :deposit deposit\n   342\t               :max-frame-bytes max-frame-bytes\n   343\t               :max-links max-links\n   344\t               :announce-window-ms announce-window-ms\n   345\t               :now-ms (or now-ms\n   346\t                           #(.-millisecondsSinceEpoch (core/DateTime.now)))\n   347\t               :radio {:perform! perform!}})]\n   348\t    (reset! !machine! (:radio! seam))\n   349\t    (adapter-events! radio!)\n   350\t    (scan-events! radio!)\n   351\t    (start-radio! radio! identity service-uuid tx-uuid rx-uuid !subs !links)\n   352\t    seam))\n   276\t\n   277\t(defn close!\n   278\t  \"The close path: the node stops advertising, scanning and serving, and\n   279\t   is observably gone. Every live link is lost with it, and each is\n   280\t   deposited as a link-down first -- the mesh above learns its neighbors\n   281\t   from those events, and a link fact the reader held must not outlive\n   282\t   the reader's evidence for it (design 5). Idempotent: a closed node's\n   283\t   close answers without deposits or actions.\"\n   284\t  [state]\n   285\t  (if (:closed? state)\n   286\t    (answer state [] [])\n   287\t    (answer (assoc state :closed? true :links {} :connecting #{})\n   288\t            (into [(ble/closed-event (:identity state))]\n   289\t                  (map (fn [p] (ble/link-down-event (:identity state) p)))\n   290\t                  (keys (:links state)))\n   291\t            [[:stop-radio]])))\n   292\t\n   293\t\n   294\t;; =============================================================================\n   295\t;; The generic adapter: one seam, any radio\n   296\t;; =============================================================================\n   297\t\n   134\t\n   135\t\n   136\t(deftest an-inbound-link-always-deposits-whatever-the-ceiling\n   137\t  (let [!now (atom 1000)\n   138\t        s (state !now :max-links 1)\n   139\t        s1 (:state (links/handle-radio-event s [:adv peer -60]))\n   140\t        s2 (:state (links/handle-radio-event s1 [:link-up peer :central]))\n   141\t        s3 (:state (links/handle-radio-event s2 [:link-up peer-b :peripheral]))\n   142\t        a4 (links/handle-radio-event s3 [:link-up \"peer-3\" :peripheral])]\n   143\t    (is (= [:dao.stream.ble/link-up] (events-of a4)))\n   144\t    (is (= 2 (count (:links s3))))\n   145\t    (is (= 3 (count (:links (:state a4)))))))\n   146\t\n   147\t\n   148\t;; =============================================================================\n(deftest one-dead-neighbor-starves-nothing\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\" \"c\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mb (make-mesh net \"b\" :identity \"origin-b\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")]\n      (doseq [m [ma mb mc]] (mesh/mesh-step! m))\n      ;; a's neighbor table still holds b; the link is gone, but a has\n      ;; not stepped through the link-down yet. The fan-out must hand\n      ;; the frame to c anyway.\n      (sim/unlink! net \"a\" \"b\")\n      (let [r (mesh/send! ma {:n 1})]\n        (is (= :dao.stream/transport-error (:dao.stream/outcome r)))\n        (sim/pump! net)\n        (mesh/mesh-step! mb)\n        (mesh/mesh-step! mc)\n        (testing \"the live neighbor received the frame\"\n          (is (= [{:origin \"origin-a\" :seq 0 :value {:n 1}}]\n                 (delivered net \"c\"))))\n        (testing \"the seq was spent: at least one link accepted\"\n          (is (= 1 (:next-seq @ma))))))))\n\n\n(deftest a-gap-leaves-the-neighbor-set-stale-and-usable\n  (let [net (sim/radio-net)]\n    (link-all! net \"a\" \"b\" \"c\")\n    (let [ma (make-mesh net \"a\" :identity \"origin-a\")\n          mc (make-mesh net \"c\" :identity \"origin-c\")]\n      (mesh/mesh-step! ma)\n      (mesh/mesh-step! mc)\n      (is (seq (:neighbors @ma)))\n      (sim/unlink! net \"a\" \"b\")\n      (testing \"the link facts arrive, then a gap swallows them\"\n        (doseq [_ (range 300)]\n          (stream/append! (:traffic (sim/node net \"a\"))\n                          (ble/frame-event \"a\" \"peer-x\"\n                                           (octets->bytes\n                                            (vec (cbor/encode\n                                                  (mesh/frame \"x\" 0 5 {}))))))))\n      (let [r (loop [r (mesh/mesh-step! ma)]\n                (if (= :drained (:status r))\n                  r\n                  (recur (mesh/mesh-step! ma))))]\n        (is (= :drained (:status r)))\n        (testing \"stale is the honest choice: the swallowed link-down\n                  leaves b in the set, because a cleared set would cost\n                  the mesh every relay it has and a stable link emits\n                  no link-up to refill it\"\n          (is (seq (:neighbors @ma))))\n        (testing \"and the mesh still works: the filler frame the gap\n                  did not swallow was relayed to c, and origin-a's send\n                  reached c through the stale relay's send-failed and\n                  the live one's ok\"\n          (is (= :dao.stream/transport-error\n                 (:dao.stream/outcome (mesh/send! ma {:n 1}))))\n          (sim/pump! net)\n          (mesh/mesh-step! mc)\n          (is (= [{:origin \"x\" :seq 0 :value {}}\n                  {:origin \"origin-a\" :seq 0 :value {:n 1}}]\n                 (delivered net \"c\"))))))))\n\n\n(deftest a-closed-raw-layer-clears-the-neighbor-set\n","exit_code":0,"status":"completed"}}
