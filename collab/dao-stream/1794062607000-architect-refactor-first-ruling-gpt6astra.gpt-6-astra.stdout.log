{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/main.cljc | sed -n '924,990p'; nl -ba src/cljc/yin/repl/main.cljc | sed -n '1051,1136p'; nl -ba src/cljc/yin/repl.cljc | sed -n '1260,1385p'; nl -ba src/cljc/yin/repl.cljc | sed -n '2040,2105p'; nl -ba src/cljc/dao/space/dht.cljc | sed -n '250,293p'; nl -ba src/cljc/dao/jing/dht.cljc | sed -n '1333,1386p'\"","aggregated_output":"   924\t   store's own resources (in durable mode, the exclusive directory\n   925\t   lock).  The shell has already stopped when a host calls this; the\n   926\t   memory store has nothing to release.  A DHT store's head board and\n   927\t   dials have been asked to stop and drained by then (`stop-tick`);\n   928\t   `yin.repl.dht/close!` is the last resort for whatever the budget\n   929\t   left.\"\n   930\t  [state]\n   931\t  (when-some [c (custody-of state)]\n   932\t    (compose/close! c))\n   933\t  (repl.dht/close! (:repl state))\n   934\t  (store/close! (get-in state [:repl :index-store])))\n   935\t\n   936\t\n   937\t(defn- entry-text\n   938\t  [entry]\n   939\t  (or (get entry driver/text-key) (get entry serve/text-key)))\n   940\t\n   941\t\n   942\t(defn banner\n   943\t  \"Text the composition prints before the first prompt, given parsed\n   944\t   options.  A DHT store states here (before its node steps once, so\n   945\t   before anything is shared) what it will share: the whole store when\n   946\t   `--dht-publish` is given, nothing otherwise (yin.repl.dht/banner).\"\n   947\t  [opts]\n   948\t  (let [spec (:index-store-spec opts)\n   949\t        dht? (= :dht (:type spec))]\n   950\t    (cond-> (vec (:startup-lines opts))\n   951\t      (seq (:rejected opts)) (conj telemetry-text)\n   952\t      (and (:port opts) (zero? (:port opts)))\n   953\t      (conj (str \"serving on all interfaces on an ephemeral port; the Serving\"\n   954\t                 \" line names it once bound. Anyone who can reach this port\"\n   955\t                 \" can evaluate code in this shell; there is no\"\n   956\t                 \" authentication.\"))\n   957\t\n   958\t      (and (:port opts) (not (zero? (:port opts))))\n   959\t      (conj (str \"serving on all interfaces: ws://127.0.0.1:\" (:port opts)\n   960\t                 (let [ip (local-ip)]\n   961\t                   (if (= \"127.0.0.1\" ip)\n   962\t                     \" and ws://<this machine's IP>:\"\n   963\t                     (str \" and ws://\" ip \":\")))\n   964\t                 (:port opts)\n   965\t                 \". Anyone who can reach this port can evaluate code in this\"\n   966\t                 \" shell; there is no authentication.\"))\n   967\t      (and (:headless? opts) (not (:port opts)))\n   968\t      (conj \"--headless has nothing to attend without a served endpoint\")\n   969\t      dht? (into (repl.dht/banner spec))\n   970\t      (and dht? (:publish? spec))\n   971\t      (conj (str \"dht: the code index and the code itself are shared: every\"\n   972\t                 \" evaluated program's rows are written to the index store\"\n   973\t                 \" each round\"))\n   974\t      (and dht? (:publisher opts))\n   975\t      (conj (str \"dht: names published here are signed by principal \"\n   976\t                 (:publisher opts) \" (key from \" (:dht-key-file opts) \")\"))\n   977\t      (and dht? (not (:publisher opts)))\n   978\t      (conj (str \"dht: no --dht-key: (yin.link/publish ...) is refused; names\"\n   979\t                 \" are still read, resolved, loaded and linked\"))\n   980\t      #?(:cljd false :jolt true :default false)\n   981\t      (into [shell/host-text\n   982\t             ;; J5: the native parser is disclosed; with no usable library\n   983\t             ;; Python is left out of the catalog and the reason is printed\n   984\t             #?(:jolt (if (python.antlr.parser/available?)\n   985\t                        (str \"python: the native C++ ANTLR4 parser\"\n   986\t                             \" (native/jolt-parser), in process; no process\"\n   987\t                             \" crash isolation\")\n   988\t                        \"python: unavailable-parser (the native parser library is missing or incompatible; bb build:jolt-native)\")\n   989\t                :default nil)]))))\n   990\t\n  1051\t  \"One tick of the single step owner: the local shell first, then the served\n  1052\t   endpoint, against the same shell value.  A DHT index store's node is stepped\n  1053\t   first (yin.repl.dht/step): its lines print before the shell's, a\n  1054\t   hydration still outstanding leaves every typed line waiting in the\n  1055\t   input medium, and a refused one stops the shell.  The custody control\n  1056\t   plane is stepped next, before the refusal and admission branches, so\n  1057\t   renewals, pending releases and request retries continue during\n  1058\t   hydration and past a refusal.  A `--port` process\n  1059\t   serves one shared shell, as v1's atom made it: the driver evaluates this\n  1060\t   tick's local\n  1061\t   lines first, so a definition typed at the local prompt is already in the\n  1062\t   shell the endpoint evaluates remote requests against in the same tick, and\n  1063\t   the endpoint's shell (remote definitions included) is threaded back\n  1064\t   before the next tick.  The custody program step follows the driver's own\n  1065\t   step and precedes the endpoint's; once the shell has stopped it is\n  1066\t   replaced by the stop latch, so no custody program call runs after\n  1067\t   `:running?` turns false.  A require parked on a closure load the node\n  1068\t   ended this tick is re-checked once, before any typed line, with no line\n  1069\t   of its own (yin.repl/recheck-on-tick, yin.vm.linker.dht.md 8.2),\n  1070\t   and linker progress resumes a parked run (7.5): its text prints after the\n  1071\t   node's lines.  Returns `[state server lines]`;\n  1072\t   the caller only prints.\"\n  1073\t  [state server now]\n  1074\t  (let [[repl dht-lines events] (repl.dht/step (:repl state) now)\n  1075\t        state (custody-control-step (assoc state :repl repl))]\n  1076\t    (cond\n  1077\t      (repl.dht/refusal repl)\n  1078\t      [(custody-stop (assoc state :running? false)) server dht-lines]\n  1079\t\n  1080\t      (not (repl.dht/admitting? repl))\n  1081\t      [state server dht-lines]\n  1082\t\n  1083\t      :else\n  1084\t      (let [[repl rechecked] (shell/recheck-on-tick (:repl state) events)\n  1085\t            dht-lines (cond-> dht-lines\n  1086\t                        (seq rechecked) (conj rechecked))\n  1087\t            state (assoc state :repl repl)\n  1088\t            stepped (driver/repl-step state now)\n  1089\t            stepped (if (:running? stepped)\n  1090\t                      (custody-program-step stepped)\n  1091\t                      (custody-stop stepped))\n  1092\t            [entries state'] (driver/take-outbox stepped)\n  1093\t            server' (when server\n  1094\t                      (serve/step (assoc-in server [:repl] (:repl state'))\n  1095\t                                  now))\n  1096\t            [server-entries server''] (if server'\n  1097\t                                        (serve/take-outbox server')\n  1098\t                                        [[] nil])\n  1099\t            state'' (if server'' (assoc state' :repl (:repl server'')) state')]\n  1100\t        [state'' server'' (into dht-lines\n  1101\t                                (map entry-text)\n  1102\t                                (into (vec entries) server-entries))]))))\n  1103\t\n  1104\t\n  1105\t(defn moved?\n  1106\t  \"The tick owner's cadence bit, computed from this tick's own results: true\n  1107\t   when there are lines to print, when the endpoint reports movement (a\n  1108\t   woken probe, a published notice), or when either composition still owes a\n  1109\t   write -- the shell's own or a custody control-plane one.  A pending write\n  1110\t   keeps cadence at the base interval; it must never wait out a backoff\n  1111\t   ceiling.\"\n  1112\t  [state server lines]\n  1113\t  (boolean (or (seq lines)\n  1114\t               (driver/pending-write? state)\n  1115\t               (repl.dht/busy? (:repl state))\n  1116\t               (custody-owed? state)\n  1117\t               (and server (serve/moved? server)))))\n  1118\t\n  1119\t\n  1120\t(defn prompt-owed?\n  1121\t  \"True when the operator is owed a fresh prompt after a tick: the tick\n  1122\t   printed lines, or it consumed input that printed nothing (a silent\n  1123\t   assignment), which only the input cursor's advance reveals.\"\n  1124\t  [state state' lines]\n  1125\t  (boolean (or (seq lines)\n  1126\t               (not= (:input-cursor state) (:input-cursor state')))))\n  1127\t\n  1128\t\n  1129\t(defn exit-status\n  1130\t  \"The process status a host exits with once the shell stops: 1 when the\n  1131\t   DHT store refused after startup (a failed bind, a hydration that could\n  1132\t   not complete), else 0.\"\n  1133\t  [state]\n  1134\t  (if (repl.dht/refusal (:repl state)) 1 0))\n  1135\t\n  1136\t\n  1260\t      (pos? n) (assoc :id-counter n)\n  1261\t      (pos? o) (assoc :origins o))))\n  1262\t\n  1263\t\n  1264\t(defn- link-raise\n  1265\t  \"The raise of a resumed link wait, carrying the identity the parked\n  1266\t   evaluation has minted so far -- the counters of the VM the raise\n  1267\t   interrupted, whose every earlier run is in them -- so a rollback\n  1268\t   cannot reuse it.  It carries the query interpreter's pair too: the\n  1269\t   requests it has answered stay answered when the shell rolls back.\n  1270\t   The linker successor carries every cursor and settled question.\"\n  1271\t  [error vm state]\n  1272\t  (ex-info (or (ex-message error) \"Link failed\")\n  1273\t           (assoc (or (ex-data error) {})\n  1274\t                  ::link-counter (:id-counter vm)\n  1275\t                  ::link-origins (:origins vm)\n  1276\t                  ::query-pair (:query-pair state)\n  1277\t                  ::linker (:linker state)\n  1278\t                  ::dht (:dht state)\n  1279\t                  ::indexer (:indexer state))))\n  1280\t\n  1281\t\n  1282\t(defn- carry-served\n  1283\t  \"`state` rolled back by a link raise, keeping what the interpreters\n  1284\t   already concluded: the query pair, the link pair past every request\n  1285\t   answered, the linker interpreter's past every\n  1286\t   question settled, the DHT node a load started or forgot on, and the\n  1287\t   indexer a `yin.link/publish` committed its name envelopes through.\"\n  1288\t  [state d]\n  1289\t  (cond-> state\n  1290\t    (::query-pair d) (assoc :query-pair (::query-pair d))\n  1291\t    (::linker d) (assoc :linker (::linker d))\n  1292\t    (contains? d ::dht) (assoc :dht (::dht d))\n  1293\t    (::indexer d) (assoc :indexer (::indexer d))))\n  1294\t\n  1295\t\n  1296\t(defn- link-context\n  1297\t  \"What a `yin.link` call is answered under (yin.repl.query/serve): the\n  1298\t   reader's authority, the publisher's key, and the requesting VM's\n  1299\t   primitives and module registry -- the modules it linked are derived\n  1300\t   from it, never recorded -- and the round.\"\n  1301\t  [state vm]\n  1302\t  {:authority (link/authority (:link-source state))\n  1303\t   :key (:dht-key state)\n  1304\t   :primitives (:primitives vm)\n  1305\t   :modules (:modules vm)\n  1306\t   :round (:round state)})\n  1307\t\n  1308\t\n  1309\t(defn- drive-links\n  1310\t  \"Serve the linker interpreter and run the parked VM alternately, at most\n  1311\t   `link-round-budget` rounds, while `vm` waits on a link.  A round that\n  1312\t   moves nothing ends the drive: a link whose content source cannot\n  1313\t   answer will not answer by waiting longer.  Returns\n  1314\t   `[state vm pending progress?]`, `pending` the links the interpreter\n  1315\t   reported `:pending`, and `progress?` true when a round moved\n  1316\t   something -- advanced a serve cursor, delivered a response or\n  1317\t   completed an install -- the fact the pending run's `:checks` resets\n  1318\t   on (yin.repl.link-policy.md section 3.1).  A refused or lost link\n  1319\t   raises as the VM's own, carrying the interrupted VM's minted\n  1320\t   identity.\n  1321\t\n  1322\t   `initial-progress` records progress from the caller's round.  When\n  1323\t   true, the first iteration runs the VM once without a round of its own.\n  1324\t\n  1325\t   A VM waiting on a `dao.space.query/q` call is driven the same way: the\n  1326\t   query interpreter (`yin.repl.query/serve`) answers from the session's\n  1327\t   indexer and the VM runs on.  Only a round the VM spends waiting on a\n  1328\t   link counts against `link-round-budget`; a query is answered in the\n  1329\t   round it is asked, so its rounds are bounded by `query-drive-budget`\n  1330\t   calls instead: a VM still waiting on a call once the drive has\n  1331\t   answered that many raises `query-call-limit-text` as its own error,\n  1332\t   the unanswered request abandoned with it.\"\n  1333\t  [state vm initial-progress]\n  1334\t  (loop [i 0\n  1335\t         calls 0\n  1336\t         vm vm\n  1337\t         state state\n  1338\t         pending []\n  1339\t         progress? initial-progress\n  1340\t         initial? initial-progress]\n  1341\t    (let [link? (link-waiting? vm)\n  1342\t          query? (query/waiting? vm)]\n  1343\t      (cond\n  1344\t        (or (vm/halted? vm) (not (or link? query?)) (>= i link-round-budget))\n  1345\t        [state vm pending progress?]\n  1346\t\n  1347\t        (and query? (>= calls query-drive-budget))\n  1348\t        (throw (link-raise (ex-info query-call-limit-text\n  1349\t                                    {:reason :yin.repl.query/call-limit\n  1350\t                                     :limit query-drive-budget})\n  1351\t                           vm\n  1352\t                           (update state :query-pair query/abandon-requests)))\n  1353\t\n  1354\t        :else\n  1355\t        (let [served (when (and link? (not initial?))\n  1356\t                       (link/round (assoc (:linker state)\n  1357\t                                          :source (:link-source state))\n  1358\t                                   (:dht state)))\n  1359\t              state (cond-> state\n  1360\t                      served (assoc :linker (:linker served)\n  1361\t                                    :dht (:dht served)))\n  1362\t              answered (when query?\n  1363\t                         (query/serve {:pair (:query-pair state)\n  1364\t                                       :indexer (:indexer state)\n  1365\t                                       :ast-indexer (:ast-indexer state)\n  1366\t                                       :dht (:dht state)\n  1367\t                                       :link (link-context state vm)\n  1368\t                                       :limits {:row-limit query-row-limit\n  1369\t                                                :byte-limit query-byte-limit}\n  1370\t                                       :budget (min query-serve-budget\n  1371\t                                                    (- query-drive-budget\n  1372\t                                                       calls))}))\n  1373\t              state (cond-> state\n  1374\t                      answered (assoc :query-pair (:pair answered)\n  1375\t                                      :dht (:dht answered)\n  1376\t                                      :indexer (:indexer answered)))\n  1377\t              pending (if (seq (:pending served)) (:pending served) pending)]\n  1378\t          (if (or initial? (:progress? served)\n  1379\t                  (:progress? answered))\n  1380\t            (let [vm' (try (vm/run vm)\n  1381\t                           (catch #?(:cljd Object :clj Exception :cljs js/Error)\n  1382\t                                  error\n  1383\t                             (throw (link-raise error vm state))))]\n  1384\t              (recur (if link? (inc i) i)\n  1385\t                     (+ calls (:answered answered 0))\n  2040\t                                  :pending-run nil)\n  2041\t                           d)\n  2042\t             (str text\n  2043\t                  (format-error error)\n  2044\t                  (dropped-lines-text (count (:pending-lines parked))))]\n  2045\t            (cond-> [] input (conj input))))))))\n  2046\t\n  2047\t\n  2048\t(defn recheck-pending\n  2049\t  \"One re-check of the shell's `:pending-run` without an input line --\n  2050\t   the step an unattended host drives at its own cadence\n  2051\t   (yin.repl.link-policy.md section 4): serve the interpreter, run the\n  2052\t   parked VM, and consult the link policy when the run is still\n  2053\t   pending.  A re-check that completes the run folds the retained lines\n  2054\t   exactly as a typed line's completion does.  Returns `[state text]`,\n  2055\t   `text` nil when nothing is pending.  It reads no clock and takes no\n  2056\t   callback; the host decides when to call it.\"\n  2057\t  [state]\n  2058\t  (if (:pending-run state)\n  2059\t    (recheck-pending* state nil false)\n  2060\t    [state nil]))\n  2061\t\n  2062\t\n  2063\t(defn recheck-on-tick\n  2064\t  \"Advance one linker round, carrying its successor before any VM run.\n  2065\t   Progress resumes the pending driver before another round; otherwise\n  2066\t   only a relevant load or installed head event rechecks the run.\"\n  2067\t  [state events]\n  2068\t  (let [served (link/round (assoc (:linker state)\n  2069\t                                  :source (:link-source state))\n  2070\t                           (:dht state))\n  2071\t        successor (assoc state :linker (:linker served)\n  2072\t                         :dht (:dht served))\n  2073\t        state (if (and (= (:linker state) (:linker served))\n  2074\t                       (= (:dht state) (:dht served)))\n  2075\t                state\n  2076\t                successor)\n  2077\t        links (get-in state [:pending-run :links])\n  2078\t        waits (set (keep :manifest links))\n  2079\t        heads (set (mapcat :principals links))]\n  2080\t    (cond\n  2081\t      (and (:progress? served) (:pending-run state))\n  2082\t      (recheck-pending* state nil true)\n  2083\t\n  2084\t      (some (fn [e]\n  2085\t              (or (and (contains? #{:loaded :load-failed}\n  2086\t                                  (:dao.space.dht/event e))\n  2087\t                       (contains? waits (:manifest e)))\n  2088\t                  (and (= :installed (:yin.head/event e))\n  2089\t                       (contains? heads (:principal e)))))\n  2090\t            events)\n  2091\t      (recheck-pending state)\n  2092\t\n  2093\t      :else [state nil])))\n  2094\t\n  2095\t\n  2096\t(defn- resume-pending\n  2097\t  \"One bounded re-check of the shell's `:pending-run` behind a typed\n  2098\t   line: while the run stays pending the line is retained -- the parked\n  2099\t   VM owns the store a new evaluation would fork -- and it evaluates,\n  2100\t   in typing order and exactly once, when the link completes.\"\n  2101\t  [state trimmed parsed]\n  2102\t  (recheck-pending* state {:trimmed trimmed, :parsed parsed} false))\n  2103\t\n  2104\t\n  2105\t(defn- command-line?\n   250\t(defn- node-over\n   251\t  \"The node composed from checked `opts` over the opened `local` store.\"\n   252\t  [opts local]\n   253\t  (let [{:keys [peers publish? bind-host bind-port max-inbound-bytes bind!]}\n   254\t        opts\n   255\t        [requests answers facts ticks traffic ledger] (repeatedly 6 ring)\n   256\t        socket? (boolean (seq peers))\n   257\t        composition (cond-> {:local local\n   258\t                             :requests requests\n   259\t                             :answers answers\n   260\t                             :facts facts\n   261\t                             :ticks ticks\n   262\t                             ::dht/id (dht/bytes->hex\n   263\t                                        (secure-random-bytes dht/id-length))\n   264\t                             ::dht/publish? publish?\n   265\t                             ::dht/bootstrap (vec peers)\n   266\t                             ::dht/bind-host bind-host}\n   267\t                      socket? (assoc :traffic traffic\n   268\t                                     ::dht/secret (secure-random-bytes\n   269\t                                                    secret-length)\n   270\t                                     ::dht/max-inbound-bytes max-inbound-bytes))\n   271\t        seam (when socket?\n   272\t               (bind! {:identity (str \"dao.space.dht:\"\n   273\t                                      (subs (::dht/id composition) 0 16))\n   274\t                       :deposit traffic\n   275\t                       :bind-host bind-host\n   276\t                       :bind-port bind-port\n   277\t                       :max-bytes (::dht/max-datagram dht/defaults)}))\n   278\t        ;; the DHT handle's put checks (address, oversize) over :local; its\n   279\t        ;; own replicate request goes to a sink, since the node's step\n   280\t        ;; owns every request (yin.vm.linker.dht.md 5.5)\n   281\t        front (dht/store-handle\n   282\t                {:local local\n   283\t                 :requests (ring 1)\n   284\t                 :max-message-bytes (::dht/max-message-bytes dht/defaults)})\n   285\t        closed? (volatile! false)]\n   286\t    {:peers (vec peers)\n   287\t     :publish? publish?\n   288\t     :limits (select-keys opts [:max-backlog :repair-batch :max-open\n   289\t                                :repair-slots :repair-ticks :repair-max-ticks\n   290\t                                :max-repairing])\n   291\t     :composition composition\n   292\t     :dht (when-not socket? (dht/state composition))\n   293\t     :seam seam\n  1333\t(defn store-handle\n  1334\t  \"The plain-data dao.jing byte-store handle over a DHT composition's\n  1335\t   :local and :requests: put-bytes-fn validates, refuses an oversize store\n  1336\t   message, inserts into :local, appends {:dao.jing.dht/replicate address}\n  1337\t   and returns the local verdict at once -- never the acknowledgement,\n  1338\t   which is the :dao.jing.dht/sent fact. get-bytes-fn reads :local only\n  1339\t   and never touches the network; close-fn closes :local.\"\n  1340\t  [{:keys [local requests max-message-bytes]}]\n  1341\t  (when-not (and (ifn? (:put-bytes-fn local)) (ifn? (:get-bytes-fn local)))\n  1342\t    (throw (defect \"store-handle needs a :local byte-store handle\"\n  1343\t             {:local local})))\n  1344\t  (when-not (and requests (stream/writer? requests))\n  1345\t    (throw (defect \"store-handle needs a :requests writer\" {})))\n  1346\t  (let [limit (or max-message-bytes (::max-message-bytes defaults))]\n  1347\t    {:local local\n  1348\t     :requests requests\n  1349\t     :put-bytes-fn\n  1350\t     (fn [address bs]\n  1351\t       (when-not (jing/segment-bytes-match? address bs)\n  1352\t         (throw (defect \"content address does not match the bytes\"\n  1353\t                  {:address address})))\n  1354\t       (when (oversize? limit address bs)\n  1355\t         (throw (defect \"the store message exceeds max-message-bytes\"\n  1356\t                  {:address address, :reason ::oversize,\n  1357\t                   :max-message-bytes limit})))\n  1358\t       (let [verdict ((:put-bytes-fn local) address bs)]\n  1359\t         (stream/append! requests {::replicate address})\n  1360\t         verdict))\n  1361\t     :get-bytes-fn (fn [address not-found]\n  1362\t                     ((:get-bytes-fn local) address not-found))\n  1363\t     :close-fn (fn [] (jing/close! local))}))\n","exit_code":0,"status":"completed"}}
