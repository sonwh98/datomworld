3\t                                           (stitch-all ks o keys 0 ins)\n   524\t                                           (stitch-one ks o k)\n   525\t                                           (stitch-all ks o keys ins len))\n   526\t                                     (one (Leaf. nl ks sett)))\n   527\t            ;; splitting\n   528\t            :else (let [h1 (quot (inc len) 2)\n   529\t                        h2 (- (inc len) h1)]\n   530\t                    (if (< ins h1)\n   531\t                      ;; new key goes to the first half\n   532\t                      (let [k1 (arr/anew h1)\n   533\t                            k2 (arr/anew h2)]\n   534\t                        (as-> (StitchAt. 0) o\n   535\t                              (stitch-all k1 o keys 0 ins)\n   536\t                              (stitch-one k1 o k)\n   537\t                              (stitch-all k1 o keys ins (dec h1)))\n   538\t                        (arr/acopy keys (dec h1) k2 0 (- len (dec h1)))\n   539\t                        (two (Leaf. h1 k1 sett) (Leaf. h2 k2 sett)))\n   540\t                      ;; copy first, insert into second\n   541\t                      (let [k1 (arr/asub keys 0 h1)\n   542\t                            k2 (arr/anew h2)]\n   543\t                        (as-> (StitchAt. 0) o\n   544\t                              (stitch-all k2 o keys h1 ins)\n   545\t                              (stitch-one k2 o k)\n   546\t                              (stitch-all k2 o keys ins len))\n   547\t                        (two (Leaf. h1 k1 sett) (Leaf. h2 k2 sett))))))))))\n   548\t\n   549\t\n   550\t  (node-disj\n   551\t    [this cmp k root? left right sett]\n   552\t    (let [idx (search keys len k cmp)]\n   553\t      (if (neg? idx)\n   554\t        UNCHANGED ; not in set\n   555\t        (let [new-len (dec len)\n   556\t              llen (safe-len left)\n   557\t              rlen (safe-len right)]\n   558\t          (cond\n   559\t            ;; nothing to merge\n   560\t            (or (>= new-len (min-bf* settings))\n   561\t                (and (nil? left) (nil? right)))\n   562\t            (if (editing? settings)\n   563\t              ;; transient in-place (Leaf.remove editable)\n   564\t              (do (arr/acopy keys (inc idx) keys idx (- len (inc idx)))\n   565\t                  (set! len new-len)\n   566\t                  (if (== idx new-len)\n   567\t                    (three left this right) ; removed last: maxKey\n   568\t                    ;; changed\n   569\t                    EARLY-EXIT))\n   570\t              (let [ck (arr/aremove-at keys len idx)]\n   571\t                (three left (Leaf. new-len ck sett) right)))\n   572\t            ;; can join with left\n   573\t            (and (some? left) (<= (+ llen new-len) (bf* settings)))\n   574\t            (let [jl (+ llen new-len)\n   575\t                  jk (arr/anew jl)]\n   576\t              (as-> (StitchAt. 0) o\n   577\t                    (stitch-all jk o (node-keys left) 0 llen)\n   578\t                    (stitch-all jk o keys 0 idx)\n   579\t                    (stitch-all jk o keys (inc idx) len))\n   580\t              (three nil (Leaf. jl jk sett) right))\n   581\t            ;; can join with right\n   582\t            (and (some? right) (<= (+ new-len rlen) (bf* settings)))\n   583\t            (let [jl (+ new-len rlen)\n   584\t                  jk (arr/anew jl)]\n   585\t              (as-> (StitchAt. 0) o\n   586\t                    (stitch-all jk o keys 0 idx)\n   587\t                    (stitch-all jk o keys (inc idx) len)\n   588\t                    (stitch-all jk o (node-keys right) 0 rlen))\n   589\t              (three left (Leaf. jl jk sett) nil))\n   590\t            ;; borrow from left\n   591\t            (and (some? left) (or (nil? right) (>= llen rlen)))\n   592\t            (let [total (+ llen new-len)\n   593\t                  nll (quot total 2)\n   594\t                  ncl (- total nll)\n   595\t                  ck (arr/anew ncl)\n   596\t                  lk (arr/asub (node-keys left) 0 nll)]\n   597\t              (as-> (StitchAt. 0) o\n   598\t                    (stitch-all ck o (node-keys left) nll llen)\n   599\t                    (stitch-all ck o keys 0 idx)\n   600\t                    (stitch-all ck o keys (inc idx) len))\n   601\t              (three (Leaf. nll lk sett) (Leaf. ncl ck sett) right))\n   602\t            ;; borrow from right\n   603\t            (some? right)\n   604\t            (let [total (+ new-len rlen)\n   605\t                  ncl (quot total 2)\n   606\t                  nrl (- total ncl)\n   607\t                  right-head (- rlen nrl)\n   608\t                  ck (arr/anew ncl)\n   609\t                  rk (arr/asub (node-keys right) right-head rlen)]\n   610\t              (as-> (StitchAt. 0) o\n   611\t                    (stitch-all ck o keys 0 idx)\n   612\t                    (stitch-all ck o keys (inc idx) len)\n   613\t                    (stitch-all ck o (node-keys right) 0 right-head))\n   614\t              (three left (Leaf. ncl ck sett) (Leaf. nrl rk sett)))\n   615\t            :else (throw (ex-info \"unreachable leaf disj state\" {})))))))\n   616\t\n   617\t\n   618\t  INodeInternal\n   619\t\n   620\t  (node-level [_] 0)\n   621\t\n   622\t\n   623\t  (node-keys [_] keys)\n   624\t\n   625\t\n   626\t  (node-children-arr [_] nil)\n   627\t\n   628\t\n   629\t  (node-addresses-arr [_] nil)\n   630\t\n   631\t\n   632\t  (node-child [_ i] (unhydrated! i))\n   633\t\n   634\t\n   635\t  (node-store [this storage] (-store storage this)))\n   636\t\n   637\t\n   638\t;; ---------------------------------------------------------------------------\n   639\t;; Branch (Branch.java). Per-slot state machine per §3.1; Phase 1 trees are\n   640\t;; all-dirty (addresses nil, children resident and strong).\n   641\t\n   642\t(deftype Branch\n   880\t                  (stitch-center-keys!\n   881\t                    ks\n   882\t                    (stitch-all ks (StitchAt. 0) keys 0 (dec idx)))\n   883\t                  (stitch-center-children!\n   884\t                    cs\n   885\t                    (stitch-all cs (StitchAt. 0) children 0 (dec idx)))\n   886\t                  (when as\n   887\t                    (stitch-center-addresses! as\n   888\t                                              (stitch-all as\n   889\t                                                          (StitchAt. 0)\n   890\t                                                          addresses\n   891\t                                                          0\n   892\t                                                          (dec idx))))\n   893\t                  (three left\n   894\t                         (Branch. level new-len ks cs as sett)\n   895\t                         right))\n   896\t                ;; can join with left\n   897\t                (and (some? left)\n   898\t                     (<= (+ (node-len left) new-len) (bf* settings)))\n   899\t                (let [llen (node-len left)\n   900\t                      jl (+ llen new-len)\n   901\t                      la (node-addresses-arr left)\n   902\t                      ks (arr/anew jl)\n   903\t                      cs (arr/anew jl)\n   904\t                      as (when (or la addresses) (arr/anew jl))]\n   905\t                  (as-> (StitchAt. 0) o\n   906\t                        (stitch-all ks o (node-keys left) 0 llen)\n   907\t                        (stitch-all ks o keys 0 (dec idx))\n   908\t                        (stitch-center-keys! ks o))\n   909\t                  (as-> (StitchAt. 0) o\n   910\t                        (stitch-all cs o (node-children-arr left) 0 llen)\n   911\t                        (stitch-all cs o children 0 (dec idx))\n   912\t                        (stitch-center-children! cs o))\n   913\t                  (when as\n   914\t                    (as-> (StitchAt. 0) o\n   915\t                          (stitch-all as o la 0 llen)\n   916\t                          (stitch-all as o addresses 0 (dec idx))\n   917\t                          (stitch-center-addresses! as o)))\n   918\t                  (three nil (Branch. level jl ks cs as sett) right))\n   919\t                ;; can join with right\n   920\t                (and (some? right)\n   921\t                     (<= (+ new-len (node-len right)) (bf* settings)))\n   922\t                (let [rlen (node-len right)\n   923\t                      jl (+ new-len rlen)\n   924\t                      ra (node-addresses-arr right)\n   925\t                      ks (arr/anew jl)\n   926\t                      cs (arr/anew jl)\n   927\t                      as (when (or addresses ra) (arr/anew jl))]\n   928\t                  (as-> (StitchAt. 0) o\n   929\t                        (stitch-all ks o keys 0 (dec idx))\n   930\t                        (stitch-center-keys! ks o)\n   931\t                        (stitch-all ks o (node-keys right) 0 rlen))\n   932\t                  (as-> (StitchAt. 0) o\n   933\t                        (stitch-all cs o children 0 (dec idx))\n   934\t                        (stitch-center-children! cs o)\n   935\t                        (stitch-all cs o (node-children-arr right) 0 rlen))\n   936\t                  (when as\n   937\t                    (as-> (StitchAt. 0) o\n   938\t                          (stitch-all as o addresses 0 (dec idx))\n   939\t                          (stitch-center-addresses! as o)\n   940\t                          (stitch-all as o ra 0 rlen)))\n   941\t                  (three left (Branch. level jl ks cs as sett) nil))\n   942\t                ;; borrow from left\n   943\t                (and (some? left)\n   944\t                     (or (nil? right)\n   945\t                         (>= (node-len left) (node-len right))))\n   946\t                (let [llen (node-len left)\n   947\t                      total (+ llen new-len)\n   948\t                      nll (quot total 2)\n   949\t                      ncl (- total nll)\n   950\t                      la (node-addresses-arr left)\n   951\t                      lc (node-children-arr left)\n   952\t                      lk (node-keys left)\n   953\t                      nlk (arr/asub lk 0 nll)\n   954\t                      nlc (let [c (arr/anew nll)]\n   955\t                            (stitch-all c (StitchAt. 0) lc 0 nll)\n   956\t                            c)\n   957\t                      nla (when la (arr/asub la 0 nll))\n   958\t                      ks (arr/anew ncl)\n   959\t                      cs (arr/anew ncl)\n   960\t                      as (when (or la addresses) (arr/anew ncl))]\n   961\t                  (as-> (StitchAt. 0) o\n   962\t                        (stitch-all ks o lk nll llen)\n   963\t                        (stitch-all ks o keys 0 (dec idx))\n   964\t                        (stitch-center-keys! ks o))\n   965\t                  (as-> (StitchAt. 0) o\n   966\t                        (stitch-all cs o lc nll llen)\n   967\t                        (stitch-all cs o children 0 (dec idx))\n   968\t                        (stitch-center-children! cs o))\n   969\t                  (when as\n   970\t                    (as-> (StitchAt. 0) o\n   971\t                          (stitch-all as o la nll llen)\n   972\t                          (stitch-all as o addresses 0 (dec idx))\n   973\t                          (stitch-center-addresses! as o)))\n   974\t                  (three (Branch. level nll nlk nlc nla sett)\n   975\t                         (Branch. level ncl ks cs as sett)\n   976\t                         right))\n   977\t                ;; borrow from right\n   978\t                (some? right)\n   979\t                (let [rlen (node-len right)\n   980\t                      total (+ new-len rlen)\n   981\t                      ncl (quot total 2)\n   982\t                      nrl (- total ncl)\n   983\t                      right-head (- rlen nrl)\n   984\t                      ra (node-addresses-arr right)\n   985\t                      rc (node-children-arr right)\n   986\t                      rk (node-keys right)\n   987\t                      nrk (arr/asub rk right-head rlen)\n   988\t                      nrc\n   989\t                      (let [c (arr/anew nrl)]\n   990\t                        (stitch-all c (StitchAt. 0) rc right-head rlen)\n   991\t                        c)\n   992\t                      nra (when ra (arr/asub ra right-head rlen))\n   993\t                      ks (arr/anew ncl)\n   994\t                      cs (arr/anew ncl)\n   995\t                      as (when (or addresses ra) (arr/anew ncl))]\n   996\t                  (as-> (StitchAt. 0) o\n   997\t                        (stitch-all ks o keys 0 (dec idx))\n   998\t                        (stitch-center-keys! ks o)\n   999\t                        (stitch-all ks o rk 0 right-head))\n  1000\t                  (as-> (StitchAt. 0) o\n  1001\t                        (stitch-all cs o children 0 (dec idx))\n  1002\t                        (stitch-center-children! cs o)\n  1003\t                        (stitch-all cs o rc 0 right-head))\n  1004\t                  (when as\n  1005\t                    (as-> (StitchAt. 0) o\n  1006\t                          (stitch-all as o addresses 0 (dec idx))\n  1007\t                          (stitch-center-addresses! as o)\n  1008\t                          (stitch-all as o ra 0 right-head)))\n  1009\t                  (three left\n  1010\t                         (Branch. level ncl ks cs as sett)\n  1011\t                         (Branch. level nrl nrk nrc nra sett)))\n  1012\t                :else (throw (ex-info \"unreachable branch disj state\"\n  1013\t                                      {})))))))))\n  1014\t\n  1015\t\n  1016\t  INodeInternal\n  1017\t\n  1018\t  (node-level [_] level)\n  1019\t\n  1020\t\n  1021\t  (node-keys [_] keys)\n  1022\t\n  1023\t\n  1024\t  (node-children-arr [_] children)\n  1025\t\n  1026\t\n  1027\t  (node-addresses-arr [_] addresses)\n  1028\t\n  1029\t\n  1030\t  (node-child\n  1031\t    [this i]\n  1032\t    ;; §3.1 per-slot state machine: state 1 (dirty) and state 2 (stored,\n  1033\t    ;; memoized) deref the slot; state 3 (stored, not faulted) restores\n  1034\t    ;; at addresses[i] and memoizes a ref-type reference. No storage\n  1035\t    ;; attached or no address => the slot is unhydrated (§5.4).\n  1036\t    (let [c (when children (read-ref (arr/aget children i)))]\n  1037\t      (if (some? c)\n  1038\t        (do (when-some [addr (when addresses (arr/aget addresses i))]\n  1039\t              (when-some [st (settings-storage settings)]\n  1040\t                (-accessed st addr)))\n  1041\t            c)\n  1042\t        (let [addr (when addresses (arr/aget addresses i))\n  1043\t              st (settings-storage settings)]\n  1044\t          (if (or (nil? addr) (nil? st))\n  1045\t            (unhydrated! i)\n  1046\t            (let [n (-restore st addr)]\n  1047\t              (when (nil? children)\n  1048\t                (set! children (arr/anew (arr/alength keys))))\n  1049\t              (arr/aset children i (make-ref settings n))\n  1050\t              n))))))\n  1051\t\n  1052\t\n  1053\t  (node-store\n  1054\t    [this storage]\n  1055\t    ;; children before parents (§5.1); slots already carrying an address\n  1056\t    ;; are clean subtrees and are skipped (§3.1) — this is what makes\n  1057\t    ;; incremental re-publish proportional to the changed path.\n  1058\t    (when (nil? addresses) (set! addresses (arr/anew (arr/alength keys))))\n  1059\t    (dotimes [i len]\n  1060\t      (when (nil? (arr/aget addresses i))\n  1061\t        (let [c (read-ref (arr/aget children i))]\n  1062\t          (when (nil? c)\n  1063\t            (throw (ex-info \"dirty child not resident\" {:slot i})))\n  1064\t          (arr/aset addresses i (node-store c storage))\n  1065\t          (arr/aset children i (make-store-ref settings c)))))\n  1066\t    (-store storage this)))\n  1067\t\n  1068\t\n  1069\t(defn branch?\n  1070\t  [node]\n  1071\t  (instance? Branch node))\n  1072\t\n  1073\t\n  1074\t;; ---------------------------------------------------------------------------\n  1075\t;; Blob conversion (§5.1/§5.2): pure functions over the EDN shapes\n  1076\t;; `publish-index!` persists today. Leaf `{:keys [...]}`, Branch\n  1077\t;; `{:level n :keys [...] :addresses [...]}`. Bounded by len, never by\n  1078\t;; allocation (grown transient arrays carry spare slots).\n  1079\t\n  1080\t(defn node->blob\n  1081\t  \"The §5.2 EDN blob for node. Branch slots must all be addressed (§3.1:\n  1082\t   no partially-addressed branch is ever serialized).\"\n  1083\t  [node]\n  1084\t  (let [ks (node-keys node)\n  1085\t        l (node-len node)\n  1086\t        keys-v (mapv #(arr/aget ks %) (range l))]\n  1087\t    (if (branch? node)\n  1088\t      (let [as (node-addresses-arr node)]\n  1089\t        {:level (node-level node),\n  1090\t         :keys keys-v,\n  1091\t         :addresses (mapv #(arr/aget as %) (range l))})\n  1092\t      {:keys keys-v})))\n  1093\t\n  1094\t\n  1095\t(defn blob->node\n  1096\t  \"Rebuild a node from its blob; type from blob shape (a map carrying\n  1097\t   :addresses is a Branch, one with :keys alone a Leaf — §5.1). Every node\n  1098\t   carries sett (the §5.1 settings-threading rule). Branch children start\n  1099\t   nil: every slot is §3.1 state 3.\"\n  1100\t  [blob ^Settings sett]\n  1998\t(defn- split-ranges\n  1999\t  \"[from to) chunk ranges over len items, chunks between min and max keys,\n  2000\t   aiming for avg — transcribes `split` (persistent_sorted_set.clj:63).\"\n  2001\t  [len avg mx]\n  2002\t  (loop [acc []\n  2003\t         from 0]\n  2004\t    (let [l (- len from)]\n  2005\t      (cond (== 0 l) acc\n  2006\t            (>= l (* 2 avg)) (recur (clojure.core/conj acc [from (+ from avg)])\n  2007\t                                    (+ from avg))\n  2008\t            (<= l mx) (clojure.core/conj acc [from len])\n  2009\t            :else (let [half (+ from (quot l 2))]\n  2010\t                    (-> acc\n  2011\t                        (clojure.core/conj [from half])\n  2012\t                        (clojure.core/conj [half len])))))))\n  2013\t\n  2014\t\n  2015\t(defn- distinct-sorted!\n  2016\t  \"Compact adjacent cmp-equal elements of sorted arr in place; new length.\"\n  2017\t  [arr cmp]\n  2018\t  (let [l (arr/alength arr)]\n  2019\t    (if (<= l 1)\n  2020\t      l\n  2021\t      (loop [w 1\n  2022\t             r 1]\n  2023\t        (if (== r l)\n  2024\t          w\n  2025\t          (let [x (arr/aget arr r)]\n  2026\t            (if (== 0 (cmp (arr/aget arr (dec w)) x))\n  2027\t              (recur w (inc r))\n  2028\t              (do (arr/aset arr w x) (recur (inc w) (inc r))))))))))\n  2029\t\n  2030\t\n  2031\t(defn from-sorted-array\n  2032\t  \"Fast path: build a set from a sorted, distinct array (first len items).\"\n  2033\t  ([cmp arr] (from-sorted-array cmp arr (arr/alength arr) nil))\n  2034\t  ([cmp arr len opts]\n  2035\t   (let [^Settings sett (make-settings opts)\n  2036\t         mx (bf* sett)\n  2037\t         avg (quot (+ (min-bf* sett) mx) 2)\n  2038\t         leaves (mapv (fn [[from to]]\n  2039\t                        (Leaf. (- to from) (arr/asub arr from to) sett))\n  2040\t                      (split-ranges len avg mx))]\n  2041\t     (loop [level 1\n  2042\t            nodes leaves]\n  2043\t       (condp == (clojure.core/count nodes)\n  2044\t         0 (BTSet. (:meta opts) cmp nil nil (empty-root sett) 0 0 sett nil)\n  2045\t         1 (BTSet. (:meta opts) cmp nil nil (nodes 0) len 0 sett nil)\n  2046\t         (recur (inc level)\n  2047\t                (mapv (fn [[from to]]\n  2048\t                        (let [n (- to from)\n  2049\t                              ks (arr/anew n)\n  2050\t                              cs (arr/anew n)]\n  2051\t                          (dotimes [i n]\n  2052\t                            (let [c (nodes (+ from i))]\n  2053\t                              (arr/aset ks i (node-lim-key c))\n  2054\t                              (arr/aset cs i c)))\n  2055\t                          (Branch. level n ks cs nil sett)))\n  2056\t                      (split-ranges (clojure.core/count nodes) avg mx))))))))\n  2057\t\n  2058\t\n  2059\t(defn from-sequential\n  2060\t  \"Build a set from an arbitrary collection (sorts and dedupes first).\"\n  2061\t  ([cmp coll] (from-sequential cmp coll nil))\n  2062\t  ([cmp coll opts]\n  2063\t   (let [arr (arr/from-coll coll)]\n  2064\t     (dotimes [i (arr/alength arr)]\n  2065\t       (when (nil? (arr/aget arr i)) (nil-element!)))\n  2066\t     (arr/asort arr cmp)\n  2067\t     (from-sorted-array cmp arr (distinct-sorted! arr cmp) opts))))\n  2068\t\n  2069\t\n  2070\t;; ---------------------------------------------------------------------------\n  2071\t;; Inspection helpers for the invariant test suite\n  2072\t\n  2073\t(defn node-keys-vec\n  2074\t  \"Vector of the node's valid keys [0 ... len).\"\n  2075\t  [node]\n  2076\t  (let [ks (node-keys node)] (mapv #(arr/aget ks %) (range (node-len node)))))\n  2077\t\n  2078\t\n  2079\t;; ---------------------------------------------------------------------------\n  2080\t;; Durability entry points (§5.1, Phase 4)\n  2081\t\n  2082\t(defn store-tree\n  2083\t  \"Store the dirty subgraph, children before parents (Merkle by\n  2084\t   construction); returns the root address. No-op returning the existing\n  2085\t   address when the set is already stored (§4). An empty set stores as nil\n  2086\t   (the existing convention: nil root address, walk of nil => ()).\"\n  2087\t  [^BTSet s storage]\n  2088\t  (when (pos? (.-cnt s)) (-store-tree! s storage)))\n  2089\t\n  2090\t\n  2091\t(defn restore-tree\n  2092\t  \"A lazy BTSet over `address`; nothing is fetched until traversed. `cnt`\n  2093\t   is the element count from the manifest (§5.1 — psset's fault-the-tree\n  2094\t   count sentinel is deliberately not ported). nil address => the empty\n  2095\t   set (cnt must be 0). The tree adopts the storage's Settings (`-settings`),\n  2096\t   which is how the manifest's branching factor reaches every restored\n  2097\t   node — never construct the storage with defaults for a tree published\n  2098\t   at another branching factor (§5.1).\"\n  2099\t  [cmp address storage cnt]\n  2100\t  (let [sett (-settings storage)]\n  2101\t    (if (nil? address)\n  2102\t      (BTSet. nil cmp nil storage (empty-root sett) 0 0 sett nil)\n  2103\t      (BTSet. nil cmp address storage nil cnt 0 sett nil))))\n  2104\t\n  2105\t\n  2106\t(defn walk-addresses\n  2107\t  \"Call on-address with every segment key reachable from address, the\n  2108\t   root's own address first; descend into a subtree only while on-address\n  2109\t   returns truthy (psset's prune protocol — lets a GC mark phase skip\n  2110\t   subtrees shared with already-marked versions). nil address => nothing.\"\n    35\t  (:require #?@(:cljd [[\"dart:async\" :as async]])\n    36\t            [dao.data.btree :as bt]\n    37\t            [dao.jing :as jing]))\n    38\t\n    39\t\n    40\t(def ^:private absent\n    41\t  \"Identity sentinel for handle misses (§5.1 sketch): keywords are not\n    42\t   reliably `identical?` on cljs, an opaque host object is.\"\n    43\t  #?(:cljd (Object.)\n    44\t     :clj (Object.)\n    45\t     :cljs (js-obj)))\n    46\t\n    47\t\n    48\t(defn read-node-blob\n    49\t  \"Read the decoded blob of exactly ONE node: one `dao.jing/get` (which\n    50\t   hash-verifies the stored bytes against `address` and decodes them), and\n    51\t   nothing else. It does not build a node, traverse or hydrate children, open\n    52\t   a handle, cache, or retry. An absent address throws \\\"missing index\n    53\t   segment\\\" with {:address address}; any failure `jing