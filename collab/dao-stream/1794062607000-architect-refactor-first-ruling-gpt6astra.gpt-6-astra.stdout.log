ting to\\n166:   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\\n169:   (content-hash v {:algorithm default-hash-algorithm}))\\n171:   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\\n172:     (digest-bytes algo (canonical-bytes v)))))\\n175:(defn segment-key\\n178:   The 1-arg form defaults to default-hash-algorithm (:blake3).\\n181:   (segment-key v {:algorithm default-hash-algorithm}))\\n183:   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\\n193:(defn parse-segment-address\\n223:(defn segment-address?\\n227:  (boolean (parse-segment-address x)))\\n234:  (if-let [parsed (parse-segment-address address)]\\n243:  (if-let [parsed (parse-segment-address address)]\\n257:   and its digest matches the hash of canonical-bytes of payload under the\\n259:   Never throws: malformed addresses, unknown algorithms, digest mismatches,\\n262:  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\\n264:      (let [bs (canonical-bytes payload)\\n278:  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\\n307:        (or (parse-segment-address address)\\n310:        bs (canonical-bytes payload)]\\n317:(defn segment-value\\n325:        (or (parse-segment-address address)\\n345:   :segment-address, :base64, :hash-mismatch, :non-canonical.\\\"\\n347:  (when-not (segment-address? address)\\n349:                    {:address address, :reason :segment-address})))\\n365:(defn materialize!\\n368:   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\\n389:   (materialize! handle payload {:algorithm default-hash-algorithm}))\\n399:     (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\\n404:       (let [bs (canonical-bytes payload)\\n444:  (when-not (segment-address? address)\\n454:        (segment-value address stored)))))\\n525:   payload, through dao.stream.observe/step with materialize! as the\\n559:   The effect is materialize!, which answers ok or throws: :failed is\\n569:                      :address (materialize! handle payload)})]\\n\\n(defn digest-bytes\\n  \\\"Digest host bytes bs with the specified algorithm keyword (:blake3, :sha256).\\n   Returns lowercase hexadecimal string. Unknown algorithms throw.\\\"\\n  [algorithm bs]\\n  (case algorithm\\n    :blake3 (blake3-bytes bs)\\n    :sha256 (sha256-bytes bs)\\n    (throw (ex-info (str \\\"unsupported hash algorithm: \\\" algorithm)\\n                    {:algorithm algorithm}))))\\n\\n\\n(defn digest-string\\n  \\\"Digest string s as UTF-8 bytes with the specified algorithm keyword.\\n   Returns lowercase hexadecimal string. Unknown algorithms throw.\\\"\\n  [algorithm s]\\n  (case algorithm\\n    :blake3 (blake3 s)\\n    :sha256 (sha256 s)\\n    (throw (ex-info (str \\\"unsupported hash algorithm: \\\" algorithm)\\n                    {:algorithm algorithm}))))\\n\\n\\n(defn canonical-bytes\\n  \\\"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\\n   of v -- the exact bytes content hashing digests, so\\n   `(digest-bytes algo (canonical-bytes v))` is\\n   `(content-hash v {:algorithm algo})`.\\n   This is the byte form Jing content travels in across a `dao.stream`\\n   boundary.\\\"\\n  [v]\\n  (cbor/encode v))\\n\\n\\n(defn content-hash\\n  \\\"Hash the canonical-bytes of v using the specified algorithm (defaulting to\\n   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\\n   Arities: [v] and [v {:keys [algorithm]}].\\\"\\n  ([v]\\n   (content-hash v {:algorithm default-hash-algorithm}))\\n  ([v opts]\\n   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\\n     (digest-bytes algo (canonical-bytes v)))))\\n\\n\\n(defn segment-key\\n  \\\"Mint the content-addressed key for an opaque payload, derived solely from\\n   the payload: :segment/<algorithm-id>-<digest>.\\n   The 1-arg form defaults to default-hash-algorithm (:blake3).\\n   The 2-arg form accepts {:algorithm :sha256} (or any registered algorithm).\\\"\\n  ([v]\\n   (segment-key v {:algorithm default-hash-algorithm}))\\n  ([v opts]\\n   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\\n         reg (clojure.core/get registry algo)]\\n     (when-not reg\\n       (throw (ex-info (str \\\"unsupported hash algorithm: \\\" algo)\\n                       {:algorithm algo})))\\n     (let [algo-id (:address-id reg)\\n           digest (content-hash v {:algorithm algo})]\\n       (keyword \\\"segment\\\" (str algo-id \\\"-\\\" digest))))))\\n\\n\\n(defn parse-segment-address\\n  \\\"The authoritative address parser: requires a `segment` namespace keyword,\\n   splits the name on the first `-` into algorithm identifier and digest,\\n   looks the identifier up by exact match (no prefix matching), validates\\n   digest length from the registry entry and lowercase-hex text, and\\n   reconstructs the canonical address to reject alternative spellings.\\n   Returns {:algorithm :<algo>, :digest \\\\\\\"<hex>\\\\\\\", :canonical :segment/...}\\n   or nil on any rejection (never throws).\\\"\\n  [address]\\n  (when (keyword? address)\\n    (when (= \\\"segment\\\" (namespace address))\\n      (let [n (name address)\\n            i (str/index-of n \\\"-\\\")]\\n        (when (and i (pos? i))\\n          (let [algo-id (subs n 0 i)\\n                digest (subs n (inc i))]\\n            (when (re-matches algorithm-id-pattern algo-id)\\n              (when-let [algo (clojure.core/get registry-by-address-id algo-id)]\\n                (let [{:keys [digest-bytes]}\\n                      (clojure.core/get registry algo)]\\n                  (when (and (= (* 2 digest-bytes) (count digest))\\n                             (re-matches hex-digit-pattern digest))\\n                    (let [canonical (keyword \\\"segment\\\"\\n                                             (str algo-id \\\"-\\\" digest))]\\n                      (when (= canonical address)\\n                        {:algorithm algo,\\n                         :digest digest,\\n                         :canonical canonical}))))))))))))\\n\\n\\n(defn segment-address?\\n  \\\"True when x is a valid content address in the closed registry:\\n   :segment/<algorithm>-<digest-hex>.\\\"\\n  [x]\\n  (boolean (parse-segment-address x)))\\n\\n\\n(defn segment-algorithm\\n  \\\"The algorithm keyword (:blake3, :sha256) carried by a segment address.\\n   Throws on invalid input.\\\"\\n  [address]\\n  (if-let [parsed (parse-segment-address address)]\\n    (:algorithm parsed)\\n    (throw (ex-info \\\"not a segment content address\\\" {:address address}))))\\n\\n\\n(defn segment-digest\\n  \\\"The lowercase hex digest carried by a segment address.\\n   Throws on invalid input.\\\"\\n  [address]\\n  (if-let [parsed (parse-segment-address address)]\\n    (:digest parsed)\\n    (throw (ex-info \\\"not a segment content address\\\" {:address address}))))\\n           (throw (ex-info\\n                    \\\"invalid backend put result\\\"\\n                    {:result result, :address address, :payload payload}))))))))\\n\\n\\n(defn get\\n  \\\"Retrieve the value stored at a content address.\\n\\n   Only valid registered content addresses are valid DaoJing reads;\\n   arbitrary keys and mutable roots are outside DaoJing and throw before the\\n   backend is consulted. The backend's bytes are hash-verified against the\\n   address and decoded; bytes that do not hash to the address throw.\\n   Returns not-found when the address is absent.\\\"\\n  [handle address not-found]\\n  (when-not (segment-address? address)\\n    (throw (ex-info \\\"dao.jing reads only valid segment content addresses\\\"\\n                    {:address address})))\\n  (let [get-fn (:get-bytes-fn handle)]\\n    (when-not (fn? get-fn)\\n      (throw (ex-info \\\"dao.jing handle requires :get-bytes-fn\\\"\\n                      {:handle handle})))\\n    (let [stored (get-fn address not-found)]\\n      (if (identical? stored not-found)\\n        not-found\\n        (segment-value address stored)))))\\n\\n\\n(defn close!\\n  \\\"Close the backend through its optional :close-fn. Idempotency is the\\n   backend's contract: close! simply delegates, so a backend that tolerates\\n   repeated closes may be closed repeatedly. Returns nil. Handles without\\n   :close-fn have nothing to release.\\\"\\n  [handle]\\n  (when-let [close-fn (:close-fn handle)] (close-fn))\\n  nil)\\n\\n\\n;; =============================================================================\\n;; Intake-pool observer (docs/design/dao.jing.md, The intake pool and\\n;; Cursor tracking and recovery)\\n;; =============================================================================\\n\\n(defn observer-state\\n  \\\"Construct the observer state for an explicit intake pool.\\n\\n   members is a sequence of {:stream <dao.stream reader handle> :cursor\\n   <opaque>} entries. The composition mints each cursor itself, from an\\n   anchor of its choosing, and hands it in; DaoJing never fabricates one.\\n   Returns plain data, no atoms or registration:\\n\\n     {:members [{:stream s, :cursor c, :status :pending} ...]\\n      :next 0}\\n\\n   A member without a :cursor, or whose :stream lacks the reader surface,\\n   is a composition defect and throws here, before any operation. :next is\\n   the fair round-robin index observe-step! polls first; :pending is the\\n   never-polled status. Because the state is plain data,\\n   (observer-state (:members state)) rebuilds one from its members.\\\"\\n  [members]\\n  {:members (mapv (fn [member]\\n                    (when-not (map? member)\\n                      (throw (ex-info\\n                               (str \\\"dao.jing pool members are \\\"\\n                                    \\\"{:stream s :cursor c} maps\\\")\\n                               {:member member})))\\n                    (when-not (contains? member :cursor)\\n                      (throw (ex-info\\n                               (str \\\"dao.jing pool member requires a cursor \\\"\\n                                    \\\"minted by its stream\\\")\\n                               {:member member})))\\n                    (when-not (stream/reader? (:stream member))\\n                      (throw (ex-info\\n                               (str \\\"dao.jing pool member requires a \\\"\\n                                    \\\"dao.stream reader\\\")\\n                               {:member member})))\\n                    {:stream (:stream member),\\n                     :cursor (:cursor member),\\n                     :status :pending})\\n                  members),\\n   :next 0})\\n\\n\\n(defn adopt-cursor\\n  \\\"Set member index's cursor to one the stream handed out. Beside a\\n   successful observation this is the only way a member's cursor changes:\\n   the pool performs no cursor arithmetic, inspects no cursor shape, and\\n   mints nothing. Recovering a gap is the caller's decision, made on the\\n   recovery cursor a gap report carries; nothing here resynchronizes\\n   anything on its own.\\\"\\n  [state index cursor]\\n  (assoc-in state [:members index :cursor] cursor))\\n\\n\\n(defn observe-step!\\n  \\\"Walk the intake pool once from (:next state) and process at most one\\n   payload, through dao.stream.observe/step with materialize! as the\\n   effect. Returns {:state next-state :signal s ...} where the signal is\\n   drawn from the declared next outcomes dao.stream declares, or, for a\\n   well-formed unrecognized outcome, that outcome's own keyword:\\n\\n     {:signal :dao.stream/ok, :address a}\\n       a payload was materialized; the member advanced to the successor\\n       cursor its stream returned, and yields its turn;\\n     {:signal :dao.stream/blocked}\\n       the pool is empty, or every non-ended member answered blocked;\\n     {:signal :dao.stream/end}\\n       every member has ended;\\n     {:signal :dao.stream/gap, :member i, :cursor recovery}\\n       member i's position was evicted;\\n     {:signal k, :member i, :result read}\\n       k is :dao.stream/cursor-mismatch, :dao.stream/invalid-cursor,\\n       :dao.stream/transport-error, or :dao.stream/refused -- or, for a\\n       well-formed outcome outside this contract version, that outcome\\n       itself, which the step classifies as refused.\\n\\n   gap and defect reports leave the member's cursor unchanged and move\\n   :next past the member, so the same condition is reported again on that\\n   member's next turn; nothing is auto-resynchronized. A defect carries the\\n   raw read under :result exactly as the step classified it -- a transport\\n   that answered with something that is not a well-formed outcome map is\\n   reported with its answer retained, never folded into a meaning nobody\\n   chose. A refused read reports the same way under its own outcome: a\\n   policy declined the member's read, nothing was observed, and the member\\n   keeps its cursor -- and an unrecognized outcome reports this way too,\\n   a newer contract being a refusal, not a defect. Blocked and\\n   ended members never prevent later members from being checked, and a\\n   member that yielded a payload loses its turn, so a continuously ready\\n   member cannot starve another.\\n\\n   The effect is materialize!, which answers ok or throws: :failed is\\n   unreachable, and a throwing effect propagates before any cursor moves,\\n   so the caller's state is untouched and the same payload is reprocessed\\n   from the same cursor once the backend succeeds.\\\"\\n  [handle state]\\n  (let [n (count (:members state))]\\n    (if (zero? n)\\n      {:state state, :signal :dao.stream/blocked}\\n      (let [effect (fn [payload]\\n                     {:dao.stream/outcome :dao.stream/ok\\n                      :address (materialize! handle payload)})]\\n        (loop [i (:next state)\\n               scanned 0\\n               state' state]\\n          (if (>= scanned n)\\n            {:state state'\\n             :signal (if (every? #(= :dao.stream/end (:status %))\\n                                 (:members state'))\\n                       :dao.stream/end\\n                       :dao.stream/blocked)}\\n            (let [member (nth (:members state') i)\\n                  r (observe/step (:stream member) (:cursor member) effect)]\\ntest/dao/data/btree_test.cljc:11:  - fill bounds: non-root nodes hold >= (quot branching-factor 2) and\\ntest/dao/data/btree_test.cljc:12:    <= branching-factor keys; a root branch has >= 2 children\\ntest/dao/data/btree_test.cljc:104:        bf (:branching-factor (bt/settings s))\\ntest/dao/data/btree_test.cljc:107:      (is (zero? (bt/node-len root)) \\\"empty set with non-empty root\\\")\\ntest/dao/data/btree_test.cljc:132:                    (bt/sorted-set* {:cmp compare, :branching-factor bf})\\ntest/dao/data/btree_test.cljc:193:          s (bt/from-sequential compare xs {:branching-factor bf})]\\ntest/dao/data/btree_test.cljc:204:  (let [s (bt/from-sequential compare (range 0 2000 2) {:branching-factor 16})]\\ntest/dao/data/btree_test.cljc:225:            final (loop [s (bt/sorted-set* {:cmp compare, :branching-factor bf})\\ntest/dao/data/btree_test.cljc:252:                  (bt/sorted-set* {:cmp compare, :branching-factor 16})\\ntest/dao/data/btree_test.cljc:286:        s (bt/from-sequential compare xs {:branching-factor 16})\\ntest/dao/data/btree_test.cljc:315:        s (bt/from-sequential compare xs {:branching-factor 16})\\ntest/dao/data/btree_test.cljc:348:        s (bt/from-sequential compare (range n) {:branching-factor 32})]\\ndocs/design/dao.data.btree.md:137:(deftype Settings [branching-factor   ;; max keys per node, default 512\\ndocs/design/dao.data.btree.md:165:- `minBranchingFactor` is `branching-factor >>> 1`; fill invariants and\\ndocs/design/dao.data.btree.md:244:  (node-len           [node])\\ndocs/design/dao.data.btree.md:327:| `node-len` / `node-lim-key` | `ANode.len` (`:26`), `maxKey` (`:34`), `minKey` (`:30`) | |\\ndocs/design/dao.data.btree.md:585:                                    ;; `opts` carries {:branching-factor n :ref-type k} —\\ndocs/design/dao.data.btree.md:586:                                    ;; the manifest's :branching-factor MUST be threaded\\ndocs/design/dao.data.btree.md:609:(`dao.space.index`) passes the manifest's `:branching-factor` (absent means\\ndocs/design/dao.data.btree.md:649:  `:branching-factor` (absent ⇒ 512) when restoring.\\ndocs/design/dao.data.btree.md:676:  `:branching-factor n` at the top level; absent means 512 (today's\\ndocs/design/dao.data.btree.md:718:`branching-factor >>> 1`, underflow merge/borrow in\\ndocs/design/dao.data.btree.md:737:  `conj`/`disj` driving nodes to the `branching-factor >>> 1` underflow\\ndocs/design/dao.data.btree.md:1164:  plus the additive `:branching-factor`; closed-map comparator resolution\\ndocs/design/dao.data.btree.md:1213:  the additive `:branching-factor`, and `fold`'s lazy-path guard also\\n38:   `:dao.stream.udp/max-message-bytes` (default 64 KiB) refuses an\\n39:   oversize send and bounds a reassembly's accumulated chunk bytes;\\n66:            [dao.stream.chunks :as chunks]\\n82:(def default-max-message-bytes\\n136:  [id part parts direction chunk]\\n141:   :dao.stream.udp/bytes chunk})\\n146:  (chunks/split payload max-datagram\\n168:   reports lost datagrams -- `port-step!` requires it. `:max-message-bytes`\\n171:  [{:keys [send! traffic raw-traffic max-message-bytes\\n185:         :max-message-bytes (or max-message-bytes\\n186:                                default-max-message-bytes)\\n208:   exceeds :dao.stream.udp/max-message-bytes -- never sent, torn or\\n215:      (> n (:max-message-bytes @port))\\n284:        (chunks/absorb @port k part parts bytes\\n285:                       (:max-message-bytes @port)\\n  outcome as data; the reader decides what missing data means.\\n- All expected operational outcomes are data, not exceptions or callbacks.\\n- No operation waits. Every operation returns what is true at the moment it is\\n  called; an answer not yet knowable arrives later as data.\\n- No hidden global state. DaoStream keeps no registry of streams, handles, or\\n  observers, and no operation consults ambient state.\\n- A logical stream has an identity that is plain data, the same through every\\n  handle on it, stable across attachment lifecycles and across serialization.\\n  Projecting that identity never fails.\\n\\nEvery clause below must be consistent with these invariants, and most derive\\nfrom one directly. Where a clause is instead an interoperability decision — the\\ndescriptor's properties, the result keyword namespace, the anchor set — it is\\nstated as a decision rather than dressed as a deduction. A proposed addition\\nthat contradicts an invariant does not belong in this contract; one that merely\\ncannot be deduced from them must say which decision it is and why.\\n\\n## Result Convention\\n\\nEvery DaoStream operation returns data.\\n\\n- Each operation's set of outcomes is **exhaustive**: a transport may produce\\nso that a later plan does not rediscover them as surprises.\\n\\n- **A writer does not learn where its value landed.** `append!`'s `ok` carries\\n  no cursor. Read-your-writes and causal references between streams arrive as\\n  an optional `:dao.stream/cursor` key on `ok`. Conditional append (\\\"only if\\n  the tail is still here\\\") would be an eighth operation; the design does not\\n  need it because it assumes **one writer per logical stream**, which\\n  `dao.space` practices and this document should say once in *Concurrency*.\\n- **History is not verifiable.** Identity is an opaque value nothing\\n  authenticates, and append-only is the transport's promise, not something a\\n  reader can check. Self-certifying identities and signed or hash-chained\\n  elements live in the payload, above the stream. The obligation on this layer\\n  is only the one it already meets: identity is compared structurally and never\\n  parsed.\\n- **Readiness.** Polling is O(n) in streams observed (*What it costs*). The\\n  extension is reserved, and `dao.stream.waitset.implementation-plan.md` pays\\n  the cost in the runtime without it.\\n- **Granularity.** An element is a whole value; there is no byte offset within\\n  one and no chunked element. Large media travel as content addresses in the\\n  payload, resolved through `dao.jing`.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/dao-space/1794057158000-architect-byte-cut-second-review-gpt6astra.gpt-6-astra.stdout.log:43:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '88,130p' test/dao/data/btree_test.cljc; sed -n '305,340p' src/cljc/dao/jing.cljc; sed -n '365,430p' src/cljc/dao/jing.cljc; sed -n '198,232p' src/cljc/dao/stream/udp.cljc; sed -n '1015,1048p' src/cljc/dao/space/index.cljc; sed -n '268,301p' test/yin/repl/index_test.cljc; sed -n '310,385p' test/yin/repl/index_test.cljc; rg -n 'branching-factor' src/cljc/dao/space src/cljc/yin/repl src/cljc/dao/data/btree/cursor.cljc; rg -n '26.?497|26.?720|S3|store-message-size' test docs/design/dao.jing.dht.md collab/dao-jing -g '*.cljc' -g '*.md'\\\"\",\"aggregated_output\":\"          (is (every? #(zero? (cmp (ks %)\\n                                   (bt/node-lim-key (bt/node-child node %))))\\n                      (range len))\\n              \\\"branch key does not equal child's max key\\\")\\n          (let [subs (mapv #(check-node (bt/node-child node %) cmp bf false)\\n                           (range len))]\\n            (is (apply = (map :depth subs)) \\\"leaves at differing depths\\\")\\n            {:count (reduce + (map :count subs)),\\n             :depth (inc (:depth (first subs)))}))\\n      (do (when-not root? (is (>= len min-fill) \\\"leaf underfilled\\\"))\\n          {:count len, :depth 0}))))\\n\\n\\n(defn- check-set\\n  [s]\\n  (let [root (bt/root s)\\n        bf (:branching-factor (bt/settings s))\\n        cmp (bt/comparator s)]\\n    (if (zero? (bt/count s))\\n      (is (zero? (bt/node-len root)) \\\"empty set with non-empty root\\\")\\n      (let [{:keys [count]} (check-node root cmp bf true)]\\n        (is (== count (bt/count s)) \\\"tree count differs from BTSet cnt\\\")))))\\n\\n\\n;; ---------------------------------------------------------------------------\\n;; Basics\\n\\n(deftest empty-set-test\\n  (let [s (bt/sorted-set-by compare)]\\n    (is (zero? (bt/count s)))\\n    (is (nil? (bt/seq s)))\\n    (is (nil? (bt/lookup s 1)))\\n    (is (false? (bt/contains? s 1)))\\n    (is (nil? (bt/slice s nil nil)))\\n    (is (nil? (bt/slice s 0 10)))\\n    (is (nil? (bt/rslice s 10 0)))\\n    (is (identical? s (bt/disj s 1)) \\\"disj on empty returns the same set\\\")\\n    (check-set s)))\\n\\n\\n(deftest basic-conj-test\\n  (doseq [bf [16 32]]\\n    (let [xs (pseudo-shuffle 11 (range 200))\\n  [address payload]\\n  (let [{:keys [algorithm digest]}\\n        (or (parse-segment-address address)\\n            (throw (ex-info \\\"not a segment content address\\\"\\n                            {:address address})))\\n        bs (canonical-bytes payload)]\\n    (when-not (= digest (digest-bytes algorithm bs))\\n      (throw (ex-info \\\"content address does not match the payload\\\"\\n                      {:address address, :payload payload})))\\n    bs))\\n\\n\\n(defn segment-value\\n  \\\"The value of payload bytes stored at address: verifies the bytes hash to\\n   the address under its carried algorithm, then decodes exactly one\\n   accepted payload without re-encoding it (the canonicality check ran\\n   once, at the ingress that accepted the bytes). Throws on a malformed\\n   address, a digest mismatch, or bytes that do not decode.\\\"\\n  [address bs]\\n  (let [{:keys [algorithm digest]}\\n        (or (parse-segment-address address)\\n            (throw (ex-info \\\"not a segment content address\\\"\\n                            {:address address})))]\\n    (when-not (= digest (digest-bytes algorithm bs))\\n      (throw (ex-info \\\"stored bytes do not hash to their content address\\\"\\n                      {:address address})))\\n    (cbor/decode-snapshot bs)))\\n\\n\\n(defn accept-bytes!\\n  \\\"The canonical payload bytes carried by the Base64 text b64 at address,\\n   or a throw: this is the one ingress canonicality check for bytes Jing\\n   did not encode itself (docs/design/dao.jing.cbor.md, Layering and\\n   interfaces). The text must be strict padded standard-alphabet Base64,\\n   the bytes must hash to the address under its carried algorithm, and\\n   they must decode as exactly one canonical payload. Every entry of\\n(defn materialize!\\n  \\\"Content-address payload and store it through the handle's byte store.\\n\\n   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\\n   and [handle payload {:keys [algorithm]}].\\n\\n   The payload is encoded exactly once. The address is derived solely from\\n   those canonical bytes, and the same bytes go to the backend effect\\n   :put-bytes-fn as (put-bytes-fn address bytes). The backend must answer\\n   with one of:\\n\\n     :inserted -- the bytes are durably stored now;\\n     :present  -- bytes are already stored under that address.\\n\\n   Any other answer is an invalid backend result and throws: DaoJing does\\n   not accept ambiguous truthiness. The address is returned only after the\\n   backend reports success.\\n\\n   On :present the stored bytes are read back through :get-bytes-fn and\\n   verified both by hash against the address and byte for byte against the\\n   proposed bytes. Equal content is idempotent and returns the same\\n   address. Content that does not hash to its own address is an integrity\\n   failure and throws loudly. Nothing is ever overwritten.\\\"\\n  ([handle payload]\\n   (materialize! handle payload {:algorithm default-hash-algorithm}))\\n  ([handle payload opts]\\n   (let [put (:put-bytes-fn handle)\\n         get-fn (:get-bytes-fn handle)]\\n     (when-not (fn? put)\\n       (throw (ex-info \\\"dao.jing handle requires :put-bytes-fn\\\"\\n                       {:handle handle})))\\n     (when-not (fn? get-fn)\\n       (throw (ex-info \\\"dao.jing handle requires :get-bytes-fn\\\"\\n                       {:handle handle})))\\n     (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\\n           reg (clojure.core/get registry algo)]\\n       (when-not reg\\n         (throw (ex-info (str \\\"unsupported hash algorithm: \\\" algo)\\n                         {:algorithm algo})))\\n       (let [bs (canonical-bytes payload)\\n             address (keyword \\\"segment\\\"\\n                              (str (:address-id reg) \\\"-\\\"\\n                                   (digest-bytes algo bs)))\\n             result (put address bs)]\\n         (case result\\n           :inserted address\\n           :present\\n           (let [stored (get-fn address content-missing)]\\n             (cond\\n               (identical? stored content-missing)\\n               (throw\\n                 (ex-info\\n                   \\\"backend reported :present but the content address is absent\\\"\\n                   {:address address, :payload payload}))\\n               ;; the read-back must hash to the address it sits at and be\\n               ;; the very bytes proposed\\n               (and (segment-bytes-match? address stored)\\n                    (cbor/bytes= stored bs))\\n               address\\n               :else\\n               (throw\\n                 (ex-info\\n                   (str \\\"content collision: the stored bytes do not match \\\"\\n                        \\\"their content address\\\")\\n                   {:address address, :payload payload}))))\\n           (throw (ex-info\\n  (let [r ((:send! @port) host dest-port bytes)]\\n    (if (and (map? r) (contains? r :dao.stream/outcome))\\n      r\\n      {:dao.stream/outcome :dao.stream/ok})))\\n\\n\\n(defn send-value!\\n  \\\"Encode and send `v` toward `host`:`dest-port` from `port`'s socket:\\n   a single datagram when it fits the budget, fragments when it does\\n   not, transport-error naming oversize when the encoded message\\n   exceeds :dao.stream.udp/max-message-bytes -- never sent, torn or\\n   partially sent. The seam's first non-ok outcome is the answer: a\\n   fragment run stops there, cleanly, nothing torn following it.\\\"\\n  [port host dest-port v]\\n  (let [payload (cbor/encode v)\\n        n (blen payload)]\\n    (cond\\n      (> n (:max-message-bytes @port))\\n      {:dao.stream/outcome :dao.stream/transport-error\\n       :dao.stream.remote/reason :dao.stream.remote/oversize}\\n\\n      (<= n max-datagram)\\n      (send-datagram! port host dest-port payload)\\n\\n      :else\\n      (let [id (:dao.stream.remote/id v)\\n            direction (direction-of v)]\\n        (loop [frags (fragments payload id direction)]\\n          (if (empty? frags)\\n            {:dao.stream/outcome :dao.stream/ok}\\n            (let [r (send-datagram! port host dest-port\\n                                    (cbor/encode (first frags)))]\\n              (if (= :dao.stream/ok (:dao.stream/outcome r))\\n                (recur (rest frags))\\n                r))))))))\\n              [:defect {:position position, :reason :mode, :element element}])\\n            [:defect {:position position, :reason :admission, :element element}])\\n          [:plan {:rows rows,\\n                  :facts (resolution-facts (:table ctx) (:batch index-state)),\\n                  :next-eid (:next ctx)}])))))\\n\\n\\n(defn- reject-batch\\n  \\\"§2.2's atomic rejection: trees, :ids, and :max-t unchanged, the monotonic\\n   :rejected count +1, exactly one drainable defect event, :batch advanced by\\n   exactly one — never zero, or every later cross-session ordinal (§3.2)\\n   would drift on the first malformed input.\\\"\\n  [index-state defect]\\n  (-> index-state\\n      (update :rejected inc)\\n      (update :defects conj (assoc defect :batch (:batch index-state)))\\n      (update :batch inc)))\\n\\n\\n(defn fold-batch\\n  \\\"One batch, one pure fold (§2.2): admit the batch through the outer\\n   grammar and the admitting element rule, resolve identity through the §3.1\\n   mode matrix, and conj the rows and the resolution facts into the four\\n   persistent trees — a fold that shares every unmodified node with the\\n   previous state. Covered indexes are sets: a duplicate row is a no-op.\\n\\n   The fold is atomic per batch: steps 0–2 validate and plan against the\\n   whole batch before step 3 touches a tree, so a rejected batch leaves the\\n   trees, :ids, and :max-t unchanged, increments :rejected, appends one\\n   defect event, and advances :batch exactly once — bad input is data, and\\n   the session continues past it; a bug in the fold itself is the throw. An\\n   empty admitted batch is a valid no-op: :batch advances once and nothing\\n   else changes. :max-t becomes the greater of itself and the batch's\\n   greatest observed row t (writer time; resolution facts carry the\\n\\n(deftest only-derived-publication-state-is-retained-between-rounds\\n  (let [held-keys #{:observer :local :content-store :session-token\\n                    :publish-opts :after-publish :next-e :transactions\\n                    :published :published-payloads :manifest-address\\n                    :lost? :failure :allocator :materialization}\\n        rounds (reductions\\n                 (fn [[state _] line] (repl/eval-input state line))\\n                 [(repl.frontends/create-state) nil]\\n                 [\\\"(+ 1 2)\\\" \\\"(def f (fn [x] (* x x)))\\\" \\\"(f 7)\\\" \\\"(+ 40 2)\\\"])]\\n    (doseq [[i [state _]] (map-indexed vector (rest rounds))\\n            :let [ix (:indexer state)\\n                  records (stream-values (:local ix))]]\\n      (testing (str \\\"after round \\\" (inc i))\\n        (is (= held-keys (set (keys ix)))\\n            \\\"only the allocator and verified coverage outlive the round\\\")\\n        (is (nil? (:intake-pool (:allocator ix))))\\n        (is (= (:published ix) (get-in ix [:materialization :transactions])))\\n        (is (= (:dao.stream/cursor (stream/cursor (:local ix) :dao.stream/newest))\\n               (get-in ix [:materialization :cursor])))\\n        (is (= (select-keys (:materialization ix)\\n                            [:cursor :transactions :manifest-address])\\n               (:index-publication (repl/repl-state state))))\\n        (is (every? #(contains? % :dao.space/transaction) records)\\n            \\\"the local log holds transaction records only, no publication payload\\\")\\n        (is (= (inc i) (count records)))\\n        (is (true? (:published? (repl.index/status ix))))\\n        (is (pos? (:published-payloads ix))\\n            \\\"the round did publish; its payloads went to dao.jing, not the indexer\\\")))\\n    (testing \\\"transaction time continues through the retained allocator\\\"\\n      (let [ix (:indexer (first (last rounds)))]\\n        (is (= [0 1 2 3]\\n               (mapv (comp :t :dao.space/transaction)\\n                     (stream-values (:local ix)))))))))\\n        result (transactor/publish! tx (:publish-opts ix))]\\n    (doseq [payload (stream-values intake)]\\n      (jing/materialize! (:content-store ix) payload))\\n    result))\\n\\n\\n(deftest incremental-publication-covers-the-same-history-as-full-reconstruction\\n  (let [{:keys [writer observer]} (small-medium 16)\\n        initial (repl.index/make-indexer\\n                  {:observer observer :session-token \\\"equivalence\\\"\\n                   :content-store (mem/create-content-mem)\\n                   :publish-opts {:branching-factor 4}})]\\n    (reduce\\n      (fn [ix round]\\n        ;; More than one transaction in a round, including repeated content.\\n        (doseq [v [round round (+ 100 round)]]\\n          (stream/append! writer (literal-packet v)))\\n        (let [next-ix (repl.index/step ix round)\\n              store (:content-store next-ix)\\n              incremental (index/read-manifest store (:manifest-address next-ix))\\n              full (:manifest (full-publication next-ix))]\\n          (is (true? (:published? (repl.index/status next-ix))))\\n          (is (= (:count full) (:count incremental)))\\n          (doseq [order [:eavt :aevt :avet :vaet]]\\n            (is (= (vec (index/walk-index-datoms store (get-in full [:indexes order])))\\n                   (vec (index/walk-index-datoms store (get-in incremental [:indexes order]))))\\n                (str \\\"identical covered facts at round \\\" round \\\" in \\\" order)))\\n          (is (= (:dao.stream/cursor (stream/cursor (:local next-ix) :dao.stream/newest))\\n                 (get-in next-ix [:materialization :cursor])))\\n          next-ix))\\n      initial\\n      (range 1 7))))\\n\\n\\n(deftest a-fresh-round-does-not-reopen-the-retained-history\\n  (let [reads (atom [])\\n        initial (update-in (repl.frontends/create-state) [:indexer :local]\\n                           #(->CountingLocal % reads))\\n        [state _] (evaluate initial [\\\"1\\\" \\\"2\\\" \\\"3\\\"])\\n        before (:indexer state)\\n        _ (reset! reads [])\\n        [after result] (repl/eval-input state \\\"4\\\")]\\n    (is (= \\\"4\\\" result))\\n    (is (not-any? #(= [:cursor :dao.stream/oldest] %) @reads)\\n        \\\"neither allocation nor publication reopens the prefix\\\")\\n    (is (= 2 (count (filter #(= :next (first %)) @reads)))\\n        \\\"one suffix record and one blocked read, independent of history\\\")\\n    (is (identical? (:next-t (:allocator before))\\n                    (get-in after [:indexer :allocator :next-t])))\\n    (is (= [0 1 2 3] (mapv :t (transactions after))))))\\n\\n\\n(deftest incremental-roots-match-a-full-insertion-replay\\n  (let [{:keys [writer observer]} (small-medium 16)\\n        store (mem/create-content-mem)\\n        initial (repl.index/make-indexer\\n                  {:observer observer :session-token \\\"roots\\\" :content-store store\\n                   :publish-opts {:branching-factor 16}})\\n        ix (reduce (fn [ix round]\\n                     (stream/append! writer (literal-packet round))\\n                     (repl.index/step ix round))\\n                   initial (range 1 13))\\n        intake (:dao.stream/handle\\n                 (memory-log/create! {:dao.stream/type memory-log/transport-type}))\\n        replay (reduce index/fold-batch\\n                       (index/session {:mode :resolved :schema {} :intake intake\\n                                       :branching-factor 16})\\n                       (stream-values (:local ix)))\\n        result (index/publish! replay)]\\n    (is (= :ok (:status result)))\\n    (is (= (get-in ix [:materialization :manifest])\\n           (get-in result [:state :publish :manifest]))\\n        \\\"all four root addresses equal a full insertion replay, including splits\\\")))\\n\\n\\n(deftest a-stale-or-foreign-live-cursor-falls-back-to-full-reconstruction\\nsrc/cljc/dao/data/btree/cursor.cljc:18:   The descriptor is {:root address-or-nil :count n :branching-factor b\\nsrc/cljc/yin/repl/index.cljc:368:               (= (:branching-factor manifest)\\nsrc/cljc/yin/repl/index.cljc:369:                  (:branching-factor (:publish-opts ix) 512)))\\nsrc/cljc/dao/space/index.cljc:28:       :count n :branching-factor n}` — no source stream, no pool, no epoch,\\nsrc/cljc/dao/space/index.cljc:288:   ... :vaet ...} :count n :branching-factor n}, each index address either\\nsrc/cljc/dao/space/index.cljc:294:       (= #{:indexes :count :branching-factor} (set (keys manifest)))\\nsrc/cljc/dao/space/index.cljc:299:       (integer? (:branching-factor manifest))\\nsrc/cljc/dao/space/index.cljc:300:       (<= 2 (:branching-factor manifest))\\nsrc/cljc/dao/space/index.cljc:343:   published manifest (`{:indexes {...} :count n :branching-factor n}`).\\nsrc/cljc/dao/space/index.cljc:348:   The manifest's :count and :branching-factor are threaded through\\nsrc/cljc/dao/space/index.cljc:352:   without :count or :branching-factor is foreign or hand-built and belongs\\nsrc/cljc/dao/space/index.cljc:355:  (let [{:keys [indexes count branching-factor]} manifest\\nsrc/cljc/dao/space/index.cljc:357:                                {:branching-factor (or branching-factor 512)})]\\nsrc/cljc/dao/space/index.cljc:523:             \\\"publish-index! :branching-factor must be an integer of at least 2\\\"\\nsrc/cljc/dao/space/index.cljc:524:             {:branching-factor branching})))\\nsrc/cljc/dao/space/index.cljc:595:                     {:branching-factor n, :select-stream f})\\nsrc/cljc/dao/space/index.cljc:597:   opts: {:branching-factor n — max keys per node, at least 2 (default 512)\\nsrc/cljc/dao/space/index.cljc:602:   (let [branching (validate-branching! (:branching-factor opts 512))\\nsrc/cljc/dao/space/index.cljc:606:         storage (bts/kv-storage handle {:branching-factor branching})\\nsrc/cljc/dao/space/index.cljc:609:           (bt/from-sequential cmp datoms {:branching-factor branching}))\\nsrc/cljc/dao/space/index.cljc:627:                   :branching-factor branching}]\\nsrc/cljc/dao/space/index.cljc:649:;;    :branching-factor n                             ; every node the session folds or\\nsrc/cljc/dao/space/index.cljc:791:      :branching-factor n              at least 2 (default 512)\\nsrc/cljc/dao/space/index.cljc:801:  [{:keys [mode schema intake branching-factor ids ref-type]}]\\nsrc/cljc/dao/space/index.cljc:807:  (validate-branching! (or branching-factor 512))\\nsrc/cljc/dao/space/index.cljc:812:  (let [branching (or branching-factor 512)\\nsrc/cljc/dao/space/index.cljc:815:                                {:branching-factor branching,\\nsrc/cljc/dao/space/index.cljc:829:     :branching-factor branching,\\nsrc/cljc/dao/space/index.cljc:1179:                  :branching-factor (:branching-factor index-state)}\\nsrc/cljc/dao/space/index.cljc:1325:                                  {:branching-factor (:branching-factor\\nsrc/cljc/dao/space/index.cljc:1391:        branching (:branching-factor manifest)\\nsrc/cljc/dao/space/index.cljc:1393:                                {:branching-factor branching,\\nsrc/cljc/dao/space/index.cljc:1404:                              {:branching-factor branching, :ref-type :strong}),\\nsrc/cljc/dao/space/index.cljc:1406:     :branching-factor branching,\\nsrc/cljc/dao/space/transactor.cljc:308:   publish-index! (e.g. :branching-factor, :select-stream). Publication is\\nsrc/cljc/dao/space/query.cljc:593:              (integer? (:branching-factor m))))))\\nsrc/cljc/dao/space/query.cljc:941:                          :branching-factor (:branching-factor manifest)\\ndocs/design/dao.jing.dht.md:177:before appending a datagram. Defaults to <code>127.0.0.1</code> in loopback S3.\\ndocs/design/dao.jing.dht.md:655:  iterative lookup asks again for more. S3 proves by test that the largest\\ndocs/design/dao.jing.dht.md:805:Encoded message bound, send and reassembly. S3 measures real covered-index nodes\\ndocs/design/dao.jing.dht.md:878:S3 measured a real `dao.space.index/publish-index!` build at the default\\ndocs/design/dao.jing.dht.md:880:index node blobs and one manifest; the largest canonical value was 26,497\\ndocs/design/dao.jing.dht.md:881:bytes, and its maximal-cookie `:store` wire value was 26,720 bytes. The\\ndocs/design/dao.jing.dht.md:909:Deleted in S3, together with <code>dao.jing.dht.node</code>, which implements\\ndocs/design/dao.jing.dht.md:923:Deleted in S3.\\ndocs/design/dao.jing.dht.md:941:Rewritten in S2 and S3.\\ndocs/design/dao.jing.dht.md:948:Order: **S1 and S2 -> S3 -> S4 -> S5.** S1 and S2 own disjoint files and neither\\ndocs/design/dao.jing.dht.md:956:the same format, and does not touch `dao.jing`. S3, which joins the two,\\ndocs/design/dao.jing.dht.md:981:`cookie-for`. Chunks are S3; the keyed MAC is S4. Acceptance:\\ndocs/design/dao.jing.dht.md:1001:**S3: real sockets and chunks.** Depends on S1 and S2. Chunk records and\\ndocs/design/dao.jing.dht.md:1019:**S4: hardening, lookup repair, storage bound.** Depends on S3. The keyed\\ncollab/dao-jing/1789691000000-review-dao-jing-cbor-glm.prompt.md:18:backend (memory, file, PostgreSQL, S3, remote/DHT). Jing is\\ncollab/dao-jing/1789691000000-review-dao-jing-cbor-glm.prompt.md:53:  third-party-implementable* backend layer (PostgreSQL, S3, the\\ncollab/dao-jing/1789691000000-review-dao-jing-cbor-glm.prompt.md:80:   backend, file backend, PostgreSQL/S3 backends — check whether carving\\ncollab/dao-jing/1789630022715-architect-jing-cbor-signoff.prompt.md:41:storage, like Datomic storage. Memory, files, PostgreSQL, S3, remote\\ntest/dao/jing_test.cljc:228:    (is (= \\\"552ee5466783e35ae00f007695e632684979d86c35487d5d9d062658f30b5994\\\"\\ncollab/dao-jing/1789680000000-architect-review-dao-jing-cbor.claude-fable-5-1.findings.md:25:- Backend/codec layering is otherwise clean — memory, PostgreSQL, S3 need zero CBOR knowledge (file backend's frame envelope is the one ambiguity, see finding 1).\\ncollab/dao-jing/1789700000000-architect-review-dao-jing-cbor-final.prompt.md:55:   PostgreSQL/S3 when they're equally in-repo.\\ncollab/dao-jing/1789569973938-review-jing-cbor-design.prompt.md:35:storage, like Datomic storage. Memory, files, PostgreSQL, S3, remote services,\\ncollab/dao-jing/1789569973938-review-jing-cbor-design.prompt.md:67:   concretely about memory, PostgreSQL, and S3 without requiring new backend\\ncollab/dao-jing/1788950986527-storage-space-transactor-phase1.glm-5.3.findings.md:17:   **Body unchanged** — S3, S6, S7 preserved verbatim, including all three\\ncollab/dao-jing/1788950986527-storage-space-transactor-phase1.glm-5.3.findings.md:36:   pinning S2, S3, S6, S7 directly through `index/datoms-from-elements`\\ncollab/dao-jing/1788950986527-storage-space-transactor-phase1.glm-5.3.findings.md:40:   - S3: the transaction record's exact shape — a good flatten, plus six\\ntest/dao/stream/transit_test.cljc:80:           (= \\\"552ee5466783e35ae00f007695e632684979d86c35487d5d9d062658f30b5994\\\"\\ncollab/dao-jing/1789630022715-architect-jing-cbor-signoff.claude-fable-5-1.findings.md:28:- **Backend independence, the central invariant: holds.** The byte-store contract is opaque `(address, bytes) → :inserted | :present` and `(address, sentinel) → bytes | sentinel`. Memory, file, remote, DHT, PostgreSQL, and S3 are interchangeable at that boundary; none needs CBOR, Clojure values, or domain knowledge. No database semantics enter storage. The numeric carriers and their portable operations are representation-level, which `dao.jing.md` explicitly permits, and they are exported by the codec namespace, not the storage wrapper.\\ncollab/dao-jing/1789690000000-architect-review-dao-jing-cbor-r2.claude-fable-5-1.findings.md:20:- The architecture diagram (`:38`) still lists `file` as a bare peer of `memory | PostgreSQL | S3 | remote | DHT` under one undifferentiated `backend:` line — no textual marker that `file` is categorically different from the others there.\\ncollab/dao-jing/1789690000000-architect-review-dao-jing-cbor-r2.claude-fable-5-1.findings.md:22:- The correction's own dichotomy — \\\"pluggable, third-party-implementable\\\" (PostgreSQL, S3, **and the memory/remote/DHT byte-store implementations**) vs. \\\"Jing's own built-in\\\" (file) — misclassifies `dao.jing.mem`, `dao.jing.remote`, and `dao.jing.dht`. Those are exactly as much Jing's own in-repo code as `dao.jing.file` is (same `dao.jing.*` namespace family, same source tree); PostgreSQL and S3 are the only backends that are actually third-party/not-yet-built. Grouping memory/remote/DHT with PostgreSQL/S3 to justify singling out file is not an accurate use of \\\"third-party.\\\"\\ncollab/dao-jing/1789700000000-architect-review-dao-jing-cbor-final.claude-fable-5-1.findings.md:27:- The new Objective text (`:24-40`) grounds the exception in re-ingestion-across-process-death rather than \\\"built-in vs. third-party,\\\" and explicitly corrects the misclassification I raised in r2 (memory/remote/DHT are equally in-repo, not equally \\\"third-party\\\" to unbuilt PostgreSQL/S3). This is a strictly better argument than what r1/r2 converged on.\\ncollab/dao-jing/1789700000000-architect-review-dao-jing-cbor-final.claude-fable-5-1.findings.md:28:- It also resolves my own r2 residual note: `## Backend changes` (`:334-337`) now opens with an explicit pointer back to the Objective's carve-out before its `### Memory and files` subsection, so a reader hitting that section first no longer has to reconstruct the exception from memory. The bare `backend: memory | file | PostgreSQL | S3 | remote | DHT | ...` diagram (`:46`) is still undifferentiated, but it now sits *below* an Objective paragraph that already explains the exception in detail — a minor residual, not a contradiction.\\ncollab/dao-jing/storage-space-query-v2.glm-5.3.findings.md:59:(ownership), S (snapshot), E (evaluator), L (lazy published). R5 pins S1-S3\\ncollab/dao-jing/storage-space-query-v2.glm-5.3.findings.md:146:this path (the old R5 throw tests are replaced by S1-S3 by the plan\\ncollab/dao-jing/1789569973938-review-jing-cbor-design.glm-5.3.findings.md:35:- **Storage correctness (item 5) — carried over and strengthened.** Snapshot copying, CAS insert-if-absent, `:present` byte read-back, fsync-before-ack, torn-tail recovery all descend from the current verified backends; verification improves (byte hash vs re-print). Old-store rejection is achievable: complete old EDN frames never look torn (framing is shared), and EDN text fails CBOR frame decode loudly before any truncation — the required nondestructive-rejection test is already listed. PostgreSQL/S3 reasoning stays at the right altitude.\\ncollab/dao-jing/1788977648939-architect-jing-remote-v2-plan.claude-fable-5-1.findings.md:255:| S3 | A bind failure throws from `serve-content!` and retains nothing | `[D]` **new** — `serving/start!` answers `transport-error` |\\ncollab/dao-jing/1788977648939-architect-jing-remote-v2-plan.claude-fable-5-1.findings.md:899:   server on the first's port throws (S3); `(:stop! server)` twice returns\\ncollab/dao-jing/1788977648939-architect-jing-remote-v2-plan.claude-fable-5-1.findings.md:1017:plus §5.2 #3–#9. They pin N1–N3, N6, N7, N10, N11, S2, S3, S5 through\\ntest/dao/stream/remote_channel_test.cljc:655:;; S3b: writer-surface tables, identities dials, detach, drain\\ntest/yang/typescript/antlr/class_prelude_test.cljc:203:;; ------------------------------------------------------------------- S3\\ntest/yang/typescript/antlr/object_parity_test.cljc:2:  \\\"Stage 0 (the T2 remainder), steps S3 and S4: constructibility by `:kind`\\ntest/yang/typescript/antlr/object_parity_test.cljc:114:;; ------------------------------------------------------------------ S3\\ntest/yang/typescript/antlr/object_parity_test.cljc:452:           (let [r (S3 {:js/str \\\"defineProperty\\\"} o {:js/str \\\"a\\\"} d)\\ntest/yang/typescript/antlr/object_parity_test.cljc:466:                   (S3 {:js/str \\\"defineProperty\\\"} o {:js/str \\\"a\\\"} d)\\ntest/yang/typescript/antlr/object_parity_test.cljc:468:                   (S3 {:js/str \\\"defineProperty\\\"} o {:js/str \\\"a\\\"} d))))\\ntest/yang/php/antlr/programs_p6.cljc:30:   arm), S3 (the dynamic-scope profile), S4 (namespaces, `use`, the\\ntest/yang/php/antlr/programs_p6.cljc:170:  \\\"Includes inside functions (P6 S3): the including scope is the function's\\ntest/yin/repl/dht_head_test.cljc:674:;; The channel owns the dial's liveness (H2 sign-off notes 1 to 3, S3a-2)\\ntest/yin/vm/linker/head_board_test.cljc:4:   S3a-2).\\ntest/yin/vm/linker/head_board_test.cljc:623:;; Explicit stop and stream-side liveness (S3a-2)\\ntest/yin/vm/linker/head_follow_test.cljc:1087:;; :polled and :answered (S3a-2)\\ntest/yang/python/antlr/linked_safepoint_test.cljc:258:   S3's tracing (the trace cell and its hooks in the prelude) moves it\\ntest/yang/python/antlr/linked_safepoint_test.cljc:259:   once more. S3's shared-call prelude revision moves it with `py`.\\\"\\ntest/yang/python/antlr/linked_prelude_test.cljc:244:   S3 shared-call publication moved the Python module manifest.\\\"\\ntest/yin/vm/semantic/frame_test.cljc:273:              [\\\"S3\\\" :window-representation (assoc worked-frame :yin.k/window {-1 nil}) worked-code :wait task]\\ntest/yang/python/antlr/int_contract_test.cljc:300:  \\\"What the guest sees of each module outcome (S3a, `py/int-result`)\\ntest/yin/vm/linker_require_test.cljc:2:  \\\"yin.vm.linker M4 slice S3 (docs/design/yin.vm.linker.md sections 7.2 to\\ntest/yang/python/antlr/int_contract_fixtures.cljc:43:   bits), and `small`, as the S3a limit tests run.\\\"\\ntest/yang/python/antlr/prelude_parity_test.cljc:784:  (testing \\\"S3 arithmetic, power and shifts promote exactly on every host\\\"\\ntest/yang/python/antlr/prelude_parity_test.cljc:1129:;; C3 slice S3a: integer limit reasons are guest exceptions\\ntest/yang/python/antlr/int_ops_test.cljc:2:  \\\"C3 S3-A/B/C exact operators and range/index audit on all four VMs.\\\"\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/dao-space/1794057158000-architect-byte-cut-second-review-gpt6astra.gpt-6-astra.stdout.log:45:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,205p' src/cljc/dao/data/btree/cursor.cljc; sed -n '70,101p' test/dao/data/btree_test.cljc; sed -n '870,891p' docs/design/dao.jing.dht.md; sed -n '74,122p' src/cljc/dao/jing.cljc; sed -n '270,312p' src/cljc/dao/stream/datagram.cljc; rg -n 'max-message|bound|limit' src/cljc/dao/jing/stream.cljc src/cljc/dao/stream/memory_log.cljc src/cljc/dao/stream/ringbuffer.cljc | head -45\\\"\",\"aggregated_output\":\"(ns dao.data.btree.cursor\\n  \\\"A pure, stepped, ascending cursor over PERSISTED B-tree node blobs\\n   (docs/design Phase 4b seam; the seam spec r7 as amended by r8).\\n\\n   The cursor never reads. It is an immutable value that a driver advances:\\n\\n     (start descriptor comparator)  -> cursor      no I/O; PINS the comparator\\n     (step cursor)                  -> outcome     one local transition\\n     (supply cursor response)       -> cursor      hand over the requested node\\n\\n   Outcomes of `step` (exactly one):\\n\\n     {:status :continue  :cursor c}                local progress, step again\\n     {:status :need-node :address a :cursor c}     fetch ONE node, then `supply`\\n     {:status :item      :value k :cursor c}       one stored key, in order\\n     {:status :done      :cursor c}                terminal\\n\\n   The descriptor is {:root address-or-nil :count n :branching-factor b\\n   :lower nil-or-{:key k :inclusive? bool} :upper nil-or-{:key k\\n   :inclusive? bool}}. A nil bound is unbounded; {:key nil ...} is a genuine\\n   nil key bound. `start` does not retain the branching factor at all (it is\\n   accepted in the descriptor and ignored), and this namespace never rejects\\n   a node for occupancy, fill or key count (those are builder policy, not\\n   persisted-format rules).\\n\\n   The persisted shapes are those of `dao.data.btree/node->blob`:\\n   a leaf is {:keys [...]}; a branch is {:level n :keys [...] :addresses\\n   [...]} whose keys are CHILD MAXIMA. A response is {:address a :node blob}.\\n\\n   ---- Protocol -------------------------------------------------------------\\n\\n   One request is pending at a time. Stepping a waiting cursor returns the\\n   same request and makes no progress (idempotent). `supply` throws a\\n   structured error (ex-data :dao.data.btree.cursor/error) when: no node is\\n   pending (:unexpected-response); the address differs from the pending one\\n   (:address-mismatch); or the request was already satisfied\\n   (:already-satisfied). Only the MOST RECENT satisfied address is remembered,\\n   so a stale response naming an earlier satisfied address, when nothing is\\n   pending, is classified :unexpected-response rather than :already-satisfied;\\n   every such path rejects, so the distinction is diagnostic only. A supplied node is validated by later `step`\\n   transitions, never inside `supply`; a malformed node is a structured\\n   failure (:malformed-node, :inconsistent-level, :unordered-keys,\\n   :separator-mismatch), never a silent empty or an endless traversal.\\n\\n   ---- Transitions (no multi-node recursive descent, no hidden loop) -------\\n\\n   begin -> request the root (an empty tree is :done with ZERO requests);\\n   validate (chunked) -> enter; enter a branch: choose a child (seek by child\\n   maxima, else leftmost), push an immutable path frame, request ONE child;\\n   enter a leaf: position (seek) and yield keys one at a time; an exhausted\\n   leaf ascends: each popped frame is one :continue, the next sibling is\\n   requested, and the descent is again one request per level; the upper bound\\n   stops before emitting a key outside it; no bounds is a full walk. Every\\n   transition does O(1) work bounded by constants: validation advances at\\n   most `validation-chunk` keys per step and a seek is a binary search over a\\n   node's keys (at most 32 comparisons).\\n\\n   Validation (the ONLY checks): leaf/branch shape; a branch has a positive\\n   integer level, vector keys and addresses of EQUAL length, every address\\n   present; keys strictly ordered under the pinned comparator; a child's level\\n   is strictly lower than its parent's (leaves are 0); a fetched child's\\n   maximum compares EQUAL to the parent separator under the pinned comparator\\n   (comparison equality, never content identity); a response matches the\\n   pending address. Yielded keys are also checked strictly increasing across\\n   leaves. That check is STRICT because of a safety premise: persisted trees\\n   are built from sorted sets, which cannot hold comparator-equal elements, so\\n   two comparator-equal consecutive keys are unrepresentable in this format\\n   (kind-tied values survive only through differing later comparator fields).\\n   A future editor must neither weaken the check to non-strict nor extend it\\n   to a format, such as multiset blobs, where comparator-equal neighbors are\\n   legal and it would falsely reject. Nothing else: roots, single-child spines and partial final chunks\\n   read fine. Validation is incremental and never fetches a sibling to\\n   validate the selected path; it does not certify the whole tree.\\n\\n   Path frames hold the immutable branch blob, its address, level, and the\\n   selected child position (which is also the advancement position). No frame\\n   holds a storage handle, execution state or clock; cursor state is a local\\n   value and is not promised to be serializable. This namespace calls nothing\\n   that restores implicitly (no resident-root, node-child, slice, seq on a\\n   set) and acquires no dependency on datoms, DaoSpace or any comparator.\\n\\n   ---- Comparator, sentinels and the stopping rule (r8) ---------------------\\n\\n   Bounds and node ordering use the comparator pinned at `start`; content\\n   equality must never terminate a comparator-equal range. Prefix scans are a\\n   caller policy, not inferred by the cursor: the caller seeks with a lower\\n   bound, takes keys while its own prefix test (for DaoSpace, `same-slot?`,\\n   a comparator tie on the scanned slot) holds, and stops requesting work at\\n   the first key outside the prefix. The scan must CONTINUE across values\\n   that compare equal but differ in content identity (1 and 1.0, 1.0M and\\n   1.00M, 0.0 and -0.0, which interleave by the later comparator fields);\\n   content-strict filtering happens AFTER candidate production. Never\\n   manufacture a generic upper key by replacing unspecified fields with nil:\\n   under nil-first ordering that is an incorrect upper boundary for a prefix\\n   range.\\n\\n   Seek keys are canonical datom slot positions [e a v t m], never\\n   physically reordered to match a comparator's field priority. Under the\\n   nil-first comparison of sentinel fields:\\n\\n     | Selected access path               | Lower sentinel       |\\n     |------------------------------------|----------------------|\\n     | EAVT, entity e                     | [e nil nil nil nil]  |\\n     | AEVT, attribute a                  | [nil a nil nil nil]  |\\n     | AVET, attribute a and value v      | [nil a v nil nil]    |\\n     | VAET, value v                      | [nil nil v nil nil]  |\\n     | Full EAVT walk                     | no lower bound       |\\n\\n   These are seek keys, not stored datoms. (This is usage documentation only:\\n   the namespace depends on none of it.)\\\")\\n\\n\\n(def validation-chunk\\n  \\\"The most keys one validating transition examines.\\\"\\n  32)\\n\\n\\n(defn- fail\\n  [kind message data]\\n  (throw (ex-info message (assoc data ::error kind))))\\n\\n\\n;; ---------------------------------------------------------------------------\\n;; start\\n;; ---------------------------------------------------------------------------\\n\\n(defn start\\n  \\\"A new cursor over the tree described by `descriptor`, pinning\\n   `comparator` (a two-argument function returning a negative, zero or\\n   positive number) for its whole life. Performs no I/O.\\\"\\n  [descriptor comparator]\\n  (let [{:keys [root lower upper], cnt :count} descriptor]\\n    (when-not (fn? comparator)\\n      (fail :invalid-descriptor \\\"a comparator function is required\\\" {}))\\n    (when-not (and (integer? cnt) (not (neg? cnt)))\\n      (fail :invalid-descriptor \\\":count must be a nonnegative integer\\\" {}))\\n    (when (and (pos? cnt) (nil? root))\\n      (fail :invalid-descriptor \\\"a non-empty tree needs a root address\\\"\\n            {:count cnt}))\\n    (doseq [[k b] [[:lower lower] [:upper upper]]]\\n      (when-not (or (nil? b) (and (map? b) (contains? b :key)))\\n        (fail :invalid-descriptor \\\"a bound is nil or {:key k :inclusive? bool}\\\"\\n              {:bound k})))\\n    {::phase (if (or (zero? cnt) (nil? root)) :done :begin)\\n     ::cmp comparator\\n     ::root root\\n     ::lower lower\\n     ::upper upper\\n     ::seeking? (some? lower)\\n     ::path []\\n     ::leaf nil\\n     ::pending nil\\n     ::incoming nil\\n     ::vi 0\\n     ::shaped? false\\n     ::last-key nil\\n     ::has-last? false\\n     ::satisfied nil}))\\n\\n\\n;; ---------------------------------------------------------------------------\\n;; supply\\n;; ---------------------------------------------------------------------------\\n\\n(defn supply\\n  \\\"Hand the requested node to a waiting cursor. Returns a cursor that the\\n   next `step` calls validate. Throws a structured error when nothing is\\n   pending, the address differs, or the request was already satisfied.\\\"\\n  [cursor response]\\n  (let [pending (::pending cursor)\\n        address (:address response)]\\n    (cond\\n      (not= :awaiting (::phase cursor))\\n      (if (and (some? (::satisfied cursor)) (= address (::satisfied cursor)))\\n        (fail :already-satisfied \\\"the request was already satisfied\\\"\\n              {:address address})\\n        (fail :unexpected-response \\\"no node is pending\\\" {:address address}))\\n\\n      (not= address (:address pending))\\n      (fail :address-mismatch \\\"response does not match the pending address\\\"\\n            {:expected (:address pending), :actual address})\\n\\n      :else\\n      (assoc cursor\\n             ::phase :validate\\n             ::pending nil\\n             ::incoming {:address address, :blob (:node response)}\\n             ::vi 0\\n             ::shaped? false\\n             ::satisfied address))))\\n\\n\\n;; ---------------------------------------------------------------------------\\n;; helpers\\n;; ---------------------------------------------------------------------------\\n\\n(defn- first-ge\\n  \\\"First index in keys whose key compares >= k; (count keys) when none.\\n   A binary search: at most 32 comparisons.\\\"\\n  [cmp ks k]\\n  (loop [low 0\\n         high (count ks)]\\n    (if (< low high)\\n      (let [mid (quot (+ low high) 2)]\\n        (if (neg? (cmp (nth ks mid) k))\\n                 (dec i)))\\n        v))))\\n\\n\\n;; ---------------------------------------------------------------------------\\n;; Invariant walker\\n\\n(defn- check-node\\n  \\\"Validates the subtree rooted at node; returns {:count n :depth d}.\\\"\\n  [node cmp bf root?]\\n  (let [min-fill (quot bf 2)\\n        ks (bt/node-keys-vec node)\\n        len (count ks)]\\n    (is (<= len bf) \\\"node exceeds branching factor\\\")\\n    (is (every? #(neg? (cmp (ks %) (ks (inc %)))) (range (dec len)))\\n        \\\"keys not strictly ascending within node\\\")\\n    (if (bt/branch? node)\\n      (do (is (>= len (if root? 2 min-fill)) \\\"branch underfilled\\\")\\n          (is (every? #(zero? (cmp (ks %)\\n                                   (bt/node-lim-key (bt/node-child node %))))\\n                      (range len))\\n              \\\"branch key does not equal child's max key\\\")\\n          (let [subs (mapv #(check-node (bt/node-child node %) cmp bf false)\\n                           (range len))]\\n            (is (apply = (map :depth subs)) \\\"leaves at differing depths\\\")\\n            {:count (reduce + (map :count subs)),\\n             :depth (inc (:depth (first subs)))}))\\n      (do (when-not root? (is (>= len min-fill) \\\"leaf underfilled\\\"))\\n          {:count len, :depth 0}))))\\n\\n\\n(defn- check-set\\n<code>127.0.0.1</code>\\n</td>\\n<td>\\nMust match the composed socket's bind family.\\n</td>\\n</tr>\\n</table>\\n\\nS3 measured a real `dao.space.index/publish-index!` build at the default\\nbranching factor of 512 over 512 distinct datoms. It emitted two covered\\nindex node blobs and one manifest; the largest canonical value was 26,497\\nbytes, and its maximal-cookie `:store` wire value was 26,720 bytes. The\\n65,536-byte default therefore covers this measured build. Larger application\\nvalues still require an explicit composition limit or refusal.\\n\\nEvery stream the DHT is composed over is an evicting ring: requests,\\nanswers, facts, raw traffic. None is a complete-history log.\\n\\n## 10. Today's code, and the slices that replace it\\n\\nWhat the tree holds on 2026-09-30, all of it replaced by this epic with no\\ncompatibility path:\\n\\n\\n(defn sha256\\n  \\\"SHA-256 hex digest of the UTF-8 bytes of string s. Rejection on\\n   unpaired surrogates via dao.host.text/utf8-encode.\\\"\\n  [s]\\n  (bytes->hex (hash/sha256-bytes (text/utf8-encode s))))\\n\\n\\n(defn sha256-bytes\\n  \\\"SHA-256 hex digest of host bytes bs (byte[] on the JVM, Uint8Array on\\n   ClojureScript, Uint8List on Dart). `(sha256-bytes (canonical-bytes v))`\\n   is the digest for `(content-hash v {:algorithm :sha256})`.\\\"\\n  [bs]\\n  (bytes->hex (hash/sha256-bytes bs)))\\n\\n\\n(def default-hash-algorithm\\n  \\\"The default algorithm used for implicit minting (content-hash, segment-key,\\n   materialize!). Never consulted when verifying an existing address.\\\"\\n  :blake3)\\n\\n\\n(def registry\\n  \\\"The closed, immutable algorithm registry. Both initial entries produce\\n   32-byte (64 lowercase hex character) digests.\\\"\\n  {:blake3 {:address-id \\\"blake3\\\", :digest-bytes 32}\\n   :sha256 {:address-id \\\"sha256\\\", :digest-bytes 32}})\\n\\n\\n(def ^:private registry-by-address-id\\n  (into {} (map (fn [[k v]] [(:address-id v) k])) registry))\\n\\n\\n(def ^:private algorithm-id-pattern\\n  \\\"Algorithm address identifiers are lowercase ASCII alphanumeric strings.\\\"\\n  #\\\"[a-z0-9]+\\\")\\n\\n\\n(def ^:private hex-digit-pattern\\n  #\\\"[0-9a-f]+\\\")\\n\\n\\n(defn blake3-bytes\\n  \\\"BLAKE3 lowercase hex digest of host bytes bs (byte[] on the JVM,\\n   Uint8Array on ClojureScript, Uint8List on Dart).\\\"\\n  [bs]\\n  (bytes->hex (hash/blake3-bytes bs)))\\n\\n    [_]\\n    {:dao.stream/outcome :dao.stream/ok\\n     :dao.stream/descriptor the-descriptor\\n     :dao.stream/identity (:dao.stream/identity the-descriptor)})\\n\\n\\n  stream/IDaoStreamWriter\\n\\n  (append!\\n    [_ v]\\n    (if @closed\\n      {:dao.stream/outcome :dao.stream/closed}\\n      (let [checked (check-outbound v max-bytes)]\\n        (if-some [reason (:refusal checked)]\\n          {:dao.stream/outcome :dao.stream/invalid-value\\n           :dao.stream.datagram/reason reason}\\n          (let [destination (:dao.stream.datagram/destination v)\\n                r (try\\n                    (send-fn (:dao.stream.datagram/host destination)\\n                             (:dao.stream.datagram/port destination)\\n                             (:bytes checked))\\n                    (catch #?(:cljd Object :clj Throwable :cljs :default) e\\n                      {:dao.stream/outcome :dao.stream/transport-error\\n                       :dao.stream.datagram/reason (str e)}))]\\n            (if (and (map? r) (contains? r :dao.stream/outcome))\\n              (if (#{:dao.stream/ok :dao.stream/transport-error\\n                     :dao.stream/closed} (:dao.stream/outcome r))\\n                r\\n                {:dao.stream/outcome :dao.stream/transport-error})\\n              {:dao.stream/outcome :dao.stream/ok}))))))\\n\\n\\n  stream/IDaoStreamClosable\\n\\n  (close!\\n    [_]\\n    (vreset! closed true)\\n    (try (close-fn)\\n         (catch #?(:cljd Object :clj Throwable :cljs :default) _\\n           nil))\\n    {:dao.stream/outcome :dao.stream/ok}))\\n\\n\\nsrc/cljc/dao/stream/memory_log.cljc:2:  \\\"In-memory, unbounded, append-only DaoStream v2 transport: the\\nsrc/cljc/dao/stream/memory_log.cljc:13:   (no capacity is declared; the transport is logically unbounded and\\nsrc/cljc/dao/stream/memory_log.cljc:156:    ;; after it.  Unbounded means conj is the whole write path — no\\nsrc/cljc/dao/jing/stream.cljc:2:  \\\"The explicit Jing/transport boundary adapter (D7's condition, U10).\\nsrc/cljc/dao/jing/stream.cljc:18:   byte string that crossed the wrong lane fails loudly at the boundary\\nsrc/cljc/dao/jing/stream.cljc:72:   Transit unwrap is a payload that crossed the wrong boundary.\\\"\\nsrc/cljc/dao/jing/stream.cljc:95:   boundary operation itself. There is no unwrap-payload: the canonical\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nsrc/cljc/dao/data/btree/storage.cljc:40:(def ^:private absent\nsrc/cljc/dao/data/btree/storage.cljc:48:(defn read-node-blob\nsrc/cljc/dao/data/btree/storage.cljc:62:(deftype KVStorage\nsrc/cljc/dao/data/btree/storage.cljc:93:(defn kv-storage\nsrc/cljc/dao/data/btree/storage.cljc:95:   {:branching-factor n (default 512) :ref-type k (default per host, §5.3)\nsrc/cljc/dao/data/btree/storage.cljc:98:   returned storage owns the Settings every tree restored through it shares\nsrc/cljc/dao/data/btree/storage.cljc:99:   (§5.1 threading rule); pass the manifest's :branching-factor here.\"\nsrc/cljc/dao/data/btree/storage.cljc:103:         sett (bt/->Settings (or (:branching-factor opts) 512)\nsrc/cljc/dao/data/btree/storage.cljc:118:(defn- async-source?\nsrc/cljc/dao/data/btree/storage.cljc:124:(deftype HydrationStorage\nsrc/cljc/dao/data/btree/storage.cljc:179:(defn hydration-storage\nsrc/cljc/dao/data/btree/storage.cljc:187:         sett (bt/->Settings (or (:branching-factor opts) 512)\nsrc/cljc/dao/data/btree/storage.cljc:200:(defn hydrate!\nsrc/cljc/dao/data/btree/storage.cljc:235:(defn- deferred\nsrc/cljc/dao/data/btree/storage.cljc:249:(defn- attempt\nsrc/cljc/dao/data/btree/storage.cljc:261:(defn- report\nsrc/cljc/dao/data/btree/storage.cljc:266:(defn- async-hydration-storage\nsrc/cljc/dao/data/btree/storage.cljc:274:(defn hydrate-async\nsrc/cljc/dao/data/btree/storage.cljc:340:(defn store-tree-async\nsrc/cljc/dao/space/index.cljc:28:       :count n :branching-factor n}` — no source stream, no pool, no epoch,\nsrc/cljc/dao/space/index.cljc:56:(defn- type-rank\nsrc/cljc/dao/space/index.cljc:71:(defn- native-integer?\nsrc/cljc/dao/space/index.cljc:76:(defn- compare-numbers\nsrc/cljc/dao/space/index.cljc:88:(defn compare-vals\nsrc/cljc/dao/space/index.cljc:117:(defn datom-e\nsrc/cljc/dao/space/index.cljc:122:(defn datom-a\nsrc/cljc/dao/space/index.cljc:127:(defn datom-v\nsrc/cljc/dao/space/index.cljc:132:(defn datom-t\nsrc/cljc/dao/space/index.cljc:137:(defn datom-m\nsrc/cljc/dao/space/index.cljc:142:(defn- cmp-field\nsrc/cljc/dao/space/index.cljc:156:(defn eavt-cmp\nsrc/cljc/dao/space/index.cljc:171:(defn aevt-cmp\nsrc/cljc/dao/space/index.cljc:186:(defn avet-cmp\nsrc/cljc/dao/space/index.cljc:201:(defn vaet-cmp\nsrc/cljc/dao/space/index.cljc:223:(defn- sorted-index-by\nsrc/cljc/dao/space/index.cljc:228:(defn subseq-from\nsrc/cljc/dao/space/index.cljc:237:(defn index-datoms\nsrc/cljc/dao/space/index.cljc:259:(def ^:private content-missing\nsrc/cljc/dao/space/index.cljc:268:(defn walk-index-datoms\nsrc/cljc/dao/space/index.cljc:286:(defn- valid-manifest?\nsrc/cljc/dao/space/index.cljc:288:   ... :vaet ...} :count n :branching-factor n}, each index address either\nsrc/cljc/dao/space/index.cljc:290:   address when count is positive. The B-tree branching factor is at least\nsrc/cljc/dao/space/index.cljc:294:       (= #{:indexes :count :branching-factor} (set (keys manifest)))\nsrc/cljc/dao/space/index.cljc:299:       (integer? (:branching-factor manifest))\nsrc/cljc/dao/space/index.cljc:300:       (<= 2 (:branching-factor manifest))\nsrc/cljc/dao/space/index.cljc:306:(defn read-manifest\nsrc/cljc/dao/space/index.cljc:332:(defn read-datoms\nsrc/cljc/dao/space/index.cljc:341:(defn restored-indexes\nsrc/cljc/dao/space/index.cljc:343:   published manifest (`{:indexes {...} :count n :branching-factor n}`).\nsrc/cljc/dao/space/index.cljc:348:   The manifest's :count and :branching-factor are threaded through\nsrc/cljc/dao/space/index.cljc:350:   without faulting the graph, and the branching factor reaches ever