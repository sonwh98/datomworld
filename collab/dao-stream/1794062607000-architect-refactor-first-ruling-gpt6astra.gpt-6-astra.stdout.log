w (ex-info \"invalid index manifest\"\n   315\t                      {:address manifest-address, :manifest manifest})))\n   316\t    (when-not (jing/segment-matches? manifest-address manifest)\n   317\t      (throw (ex-info \"index manifest content address mismatch\"\n   318\t                      {:expected manifest-address,\n   319\t                       :actual (let [algo (try\n   320\t                                            (jing/segment-algorithm\n   321\t                                              manifest-address)\n   322\t                                            (catch #?(:cljd Object\n   323\t                                                      :clj Throwable\n   324\t                                                      :cljs :default)\n   325\t                                                   _\n   326\t                                              jing/default-hash-algorithm))]\n   327\t                                 (jing/segment-key manifest {:algorithm algo})),\n   328\t                       :manifest manifest})))\n   329\t    manifest))\n   330\t\n   331\t\n   332\t(defn read-datoms\n   333\t  \"Eagerly read every datom in the EAVT index of a published manifest, in\n   334\t   index order, by walking the node graph with plain `jing/get`. Takes the\n   335\t   manifest's content address; an empty index reads as ().\"\n   336\t  [content-store manifest-address]\n   337\t  (let [manifest (read-manifest content-store manifest-address)]\n   338\t    (vec (walk-index-datoms content-store (:eavt (:indexes manifest))))))\n   339\t\n   340\t\n   341\t(defn restored-indexes\n   342\t  \"Lazily-loaded {:eavt :aevt :avet :vaet} dao.data.btree sets over a\n   343\t   published manifest (`{:indexes {...} :count n :branching-factor n}`).\n   344\t   Nothing is fetched until a query traverses; slice (subseq-from) then\n   345\t   loads only the seek path plus the matching range. Works on every\n   346\t   platform.\n   347\t\n   348\t   The manifest's