address bs]\n   507\t                     (if (contains? (:content @state) address)\n   508\t                       :present\n   509\t                       (do (swap! state\n   510\t                                  (fn [s]\n   511\t                                    (-> s\n   512\t                                        (assoc-in [:content address] bs)\n   513\t                                        (update :order conj [address bs]))))\n   514\t                           :inserted))),\n   515\t     :get-bytes-fn (fn [address not-found]\n   516\t                     (get-in @state [:content address] not-found))}))\n   517\t\n   518\t\n   519\t(defn- validate-branching!\n   520\t  [branching]\n   521\t  (when-not (and (integer? branching) (<= 2 branching))\n   522\t    (throw (ex-info\n   523\t             \"publish-index! :branching-factor must be an integer of at least 2\"\n   524\t             {:branching-factor branching})))\n   525\t  branching)\n   526\t\n   527\t\n   528\t(defn- select-intake-stream!\n   529\t  [intake-pool select-fn]\n   530\t  (when-not (coll? intake-pool)\n   531\t    (throw\n   532\t      (ex-info\n   533\t        \"publish-index! intake-pool must be a collection of writable dao.stream values\"\n   534\t        {:intake-pool intake-pool})))\n   535\t  (when (empty? intake-pool)\n   536\t    (throw (ex-info \"publish-index! intake-pool must be non-empty\"\n   537\t                    {:intake-pool intake-pool})))\n   538\t  (when-not (fn? select-fn)\n   539\t    (throw (ex-info\n   540\t             \"publish-index! :select-stream must be a function of the pool\"\n   541\t             {:select-stream select-fn})))\n   542\t  (let [selected (select-fn intake-pool)]\n   543\t    (when-not (boolean (some #(identical? % selected) intake-pool))\n   544\t      (throw\n   545\t        (ex-info\n   546\t          \"publish-index! :select-stream returned a value outside the intake pool\"\n   547\t          {:selected selected, :intake-pool intake-pool})))\n   548\t    selected))\n   549\t\n   550\t\n   551\t(defn- append-ok!\n   552\t  \"Append one opaque payload to an intake stream; every stream/append!\n   553\t   must answer `:dao.stream/ok`, anything else throws with the result\n   554\t   attached.\"\n   555\t  [stream payload]\n   556\t  (let [result (stream/append! stream payload)]\n   557\t    (when-not (and (map? result) (= :dao.stream/ok (:dao.stream/outcome result)))\n   558\t      (throw (ex-info (str \"publish-index! stream append failed: \"\n   559\t                           (pr-str result))\n   560\t                      {:stream stream, :result result, :payload payload})))\n   561\t    result))\n   562\t\n   563\t\n   564\t(defn publish-index!\n   565\t  \"The transactor entry point, agent-side (docs/design/dao.jing.md,\n   566\t   Publication from an agent).\n   567\t\n   568\t   1. Snapshots the agent's local stream (snapshot-datoms) — fully, before\n   569\t      any publication append. Atomic transaction records are flattened here.\n   570\t   2. Builds the four covered indexes into a temporary recording content\n   571\t      handle through dao.data.btree.storage/kv-storage, so addresses are\n   572\t      minted by jing/materialize! and equal blobs deduplicate in\n   573\t      children-before-parent first-insertion order.\n   574\t   3. Appends every unique node blob in that recorded order, then the\n   575\t      manifest, all to exactly the intake stream selected from the pool.\n   576\t   4. Returns {:manifest-address (jing/segment-key manifest) :manifest\n   577\t      manifest}.\n   578\t\n   579\t   The manifest address is derived from the manifest alone and never depends\n   580\t   on which intake stream carried it. A partial immutable prefix on a full\n   581\t   intake stream is acceptable and retry-safe: the manifest is always\n   582\t   appended last, so a :full failure can only have left node blobs.\n   583\t\n   584\t   Success acknowledges that every payload was appended to the selected\n   585\t   intake stream. It does not acknowledge that an asynchronous DaoJing\n   586\t   observer has materialized those payloads yet. Because the build starts at\n   587\t   the retained history's origin and reconstructs complete indexes,\n   588\t   local-stream must be on a complete-retention transport\n   589\t   (dao.stream.memory-log); the snapshot is complete before anything is\n   590\t   emitted.\n   591\t\n   592\t   Usage:\n   593\t     (publish-index! local-stream intake-pool)\n   594\t     (publish-index! local-stream intake-pool\n   595\t                     {:branching-factor n, :select-stream f})\n   596\t\n   597\t   opts: {:branching-factor n — max keys per node, at least 2 (default 512)\n   598\t          :select-stream f   — receives the pool and returns the intake\n   599\t                               stream to append to (default first)}\"\n   600\t  ([local-stream intake-pool] (publish-index! local-stream intake-pool nil))\n   601\t  ([local-stream intake-pool opts]\n   602\t   (let [branching (validate-branching! (:branching-factor opts 512))\n   603\t         intake (select-intake-stream! intake-pool (:select-stream opts first))\n   604\t         datoms (snapshot-datoms local-stream)\n   605\t         handle (recording-content-handle)\n   606\t         storage (bts/kv-storage handle {:branching-factor branching})\n   607\t         build-tree\n   608\t         (fn [cmp]\n   609\t           (bt/from-sequential cmp datoms {:branching-factor branching}))\n   610\t         trees {:eavt (build-tree eavt-cmp),\n   611\t                :aevt (build-tree aevt-cmp),\n   612\t                :avet (build-tree avet-cmp),\n   613\t                :vaet (build-tree vaet-cmp)}\n   614\t         root-addr (fn [tree]\n   615\t                     ;; an empty index has no root node; nil is the\n   616\t                     ;; explicit\n   617\t                     ;; \"nothing here\" (walk of nil => ())\n   618\t                     (when (seq datoms) (bt/store-tree tree storage)))\n   619\t         manifest {:indexes {:eavt (root-addr (:eavt trees)),\n   620\t                             :aevt (root-addr (:aevt trees)),\n   621\t                             :avet (root-addr (:avet trees)),\n   622\t                             :vaet (root-addr (:vaet trees))},\n   623\t                   ;; Covered indexes are sets. Their count must describe\n   624\t                   ;; the distinct tuples actually stored, not duplicate\n   625\t                   ;; occurrences in the source stream.\n   626\t                   :count (bt/count (:eavt trees)),\n   627\t                   :branching-factor branching}]\n   628\t     (doseq [[address bs] (:order @(:state handle))]\n   629\t       (append-ok! intake (jing/segment-value address bs)))\n   630\t     (append-ok! intake manifest)\n   631\t     {:manifest-address (jing/segment-key manifest), :manifest manifest})))\n   632\t\n   633\t\n   634\t;; =============================================================================\n   635\t;; The index session — dao.space.index as a dao.stream observer\n   636\t;; (docs/design/dao.space.index.as-observer.md)\n   637\t;; =============================================================================\n   638\t\n   775\t(defn session\n   776\t  \"Construct the initial index state — the consumer half of one\n   777\t   `dao.stream.observer` session (`{:observer o :consumer st}`; the\n   778\t   composition attaches the observer half itself). opts:\n   779\t\n   780\t     {:mode :resolved | :unresolved   fixed for the session's life (§3.1):\n   781\t                                      :resolved indexes media whose ids are\n   782\t                                      already durable and allocates nothing;\n   783\t                                      :unresolved indexes media that carry\n   784\t                                      per-batch tempids and owns every\n   785\t                                      positive user id it allocates\n   786\t      :schema {attr {:db/valueType ...}}  which attributes are refs\n   787\t      :intake w                        the dao.stream writer publications\n   788\t                                      append to; nil builds a session that\n   789\t                                      folds but cannot publish (publish!\n   790\t                                      throws until an intake is supplied)\n   791\t      :branching-factor n              at least 2 (default 512)\n   792\t      :ids {:next-eid n,               :unresolved only; defaults\n   793\t           :ownership :owned|:shared}  datom/first-user-id / :owned\n   794\t      :ref-type k                      the recording storage's ref-type;\n   795\t                                      default :strong (§4.1)}\n   796\t\n   797\t   The trees carry Settings with ref-type :strong over the session's\n   798\t   recording storage, so nothing a session holds can evict and refault —\n   799\t   §4.1's invariant that a tree's refaults resolve against durable content,\n   800\t   never the recording handle.\"\n   801\t  [{:keys [mode schema intake branching-factor ids ref-type]}]\n   802\t  (validate-mode! mode)\n   803\t  (validate-schema! schema)\n   804\t  (when (and (some? intake) (not (stream/writer? intake)))\n   805\t    (throw (ex-info \"index session :intake must be a dao.stream writer\"\n   806\t                    {:intake intake})))\n   807\t  (validate-branching! (or branching-factor 512))\n   808\t  (when (and (= :resolved mode) (some? ids))\n   809\t    (throw (ex-info\n   810\t             \"a :resolved index session allocates nothing; :ids belongs to :unresolved sessions\"\n   811\t             {:mode mode, :ids ids})))\n   812\t  (let [branching (or branching-factor 512)\n   813\t        recorder (recording-content-handle)\n   814\t        storage (bts/kv-storage recorder\n   815\t                                {:branching-factor branching,\n   816\t                                 ;; §4.1: every tree an index session holds is\n   817\t                                 ;; pinned :strong so a root is never evicted\n   818\t                                 ;; and never refaults through the drained\n   819\t                                 ;; recording handle. :test is the seam that\n   820\t                                 ;; pins the hazard deterministically.\n   821\t                                 :ref-type (or ref-type :strong)})\n   822\t        empty-tree (fn [cmp] (bt/restore-tree cmp nil storage 0))]\n   823\t    {:indexes {:eavt (empty-tree eavt-cmp),\n   824\t               :aevt (empty-tree aevt-cmp),\n   825\t               :avet (empty-tree avet-cmp),\n   826\t               :vaet (empty-tree vaet-cmp)},\n   827\t     :storage storage,\n   828\t     :recorder recorder,\n   829\t     :branching-factor branching,\n   830\t     :mode mode,\n   831\t     :ids (when (= :unresolved mode)\n   832\t            (validate-ids! (or ids {}))),\n   833\t     :batch 0,\n   834\t     :schema schema,\n   835\t     :max-t nil,\n   836\t     :rejected 0,\n   837\t     :publish {:intake intake, :staged nil, :manifest nil},\n   838\t     :defects []}))\n   839\t\n   840\t\n   841\t;; -----------------------------------------------------------------------------\n   842\t;; fold-batch: the outer grammar, the admitting element rule, the mode matrix\n   843\t;; -----------------------------------------------------------------------------\n  1085\t(defn- publication-terminal\n  1086\t  \"§4.1's throw for an outcome this forwarder cannot continue from — closed,\n  1087\t   invalid-value, transport-error, a malformed answer. The staged\n  1088\t   publication is preserved with :next at the count of accepted payloads\n  1089\t   (manifest-last still holds, so a partial prefix is never a publication),\n  1090\t   and the consumer it reached rides under :consumer so a driving\n  1091\t   run-on-stream carries the session that resumes rather than repeats.\"\n  1092\t  [index-state accepted payload result]\n  1093\t  (let [state' (assoc-in index-state [:publish :staged :next] accepted)]\n  1094\t    (throw\n  1095\t      (ex-info \"index publication cannot continue from this intake outcome\"\n  1096\t               {:outcome (when (map? result) (:dao.stream/outcome result)),\n  1097\t                :result result,\n  1098\t                :payload payload,\n  1099\t                :next accepted,\n  1100\t                :consumer state'}))))\n  1101\t\n  1102\t\n  1103\t(defn- attempt-publication\n  1104\t  \"Append staged payloads from :next until the intake accepts the manifest,\n  1105\t   answers full, or answers an outcome this forwarder cannot continue from.\n  1106\t   Returns {:status :ok, :state s'} — staged cleared, recording handle\n  1107\t   drained, ready for the next fold cycle — or {:status :full, :state s',\n  1108\t   :next i} with :next left at the failing payload so an ordinary retry\n  1109\t   never re-appends a payload the intake already accepted (at-most-once\n  1110\t   acceptance per staged occurrence under ordinary retries).\"\n  1111\t  [index-state]\n  1112\t  (let [{:keys [intake staged]} (:publish index-state)\n  1113\t        payloads (:payloads staged)]\n  1114\t    (loop [i (:next staged)]\n  1115\t      (if (= i (count payloads))\n  1116\t        ;; :next reached the end: the manifest has been accepted, which is\n  1117\t        ;; the only condition under which the recording handle is drained\n  1118\t        {:status :ok,\n  1119\t         :state (-> index-state\n  1120\t                    (assoc-in [:publish :staged] nil)\n  1121\t                    (update :recorder (fn [handle]\n  1122\t                                        (reset! (:state handle) {:content {}, :order []})\n  1123\t                                        handle)))}\n  1124\t        (let [payload (nth payloads i)\n  1125\t              result (stream/append! intake payload)]\n  1126\t          (cond\n  1127\t            (not (stream/valid-outcome? :append! result))\n  1128\t            (publication-terminal index-state i payload result)\n  1129\t\n  1130\t            (= :dao.stream/ok (:dao.stream/outcome result))\n  1131\t            (recur (inc i))\n  1132\t\n  1133\t            (= :dao.stream/full (:dao.stream/outcome result))\n  1134\t            {:status :full,\n  1135\t             :state (assoc-in index-state [:publish :staged :next] i),\n  1136\t             :next i}\n  1137\t\n  1138\t            :else\n  1139\t            (publication-terminal index-state i payload result)))))))\n  1140\t\n  1141\t\n  1142\t(defn publish!\n  1143\t  \"Stage this state's trees as one publication and attempt it (§2.1, §4.1) —\n  1144\t   the explicit composition step between run-on-stream rounds, after every n\n  1145\t   rounds, on blocked, or on a timer: the composition's choice. Each tree\n  1146\t   stores through the session's persistent recording storage, so only the\n  1147\t   subgraph dirty since the last publication is recorded, and the staged\n  1148\t   payloads are those recorded blobs in store order with the manifest last.\n  1149\t\n  1150\t   Returns {:status :ok, :state s'} on success, or {:status :full, :state\n  1151\t   s', :next i} when the intake refused payload i — the staged publication\n  1152\t   is still held (the consumer is not ready; flush-staged resumes at i), and\n  1153\t   a payload already accepted is never appended again by an ordinary retry.\n  1154\t   A terminal intake outcome after accepted blobs throws carrying :next and\n  1155\t   the successor :consumer, so the caller can resume publication from a\n  1156\t   restored session. Calling publish! while a publication is still staged is\n  1157\t   a caller error — a staged publication is never replaced, only resumed.\"\n  1158\t  [index-state]\n  1159\t  (when-some [staged (get-in index-state [:publish :staged])]\n  1160\t    (throw (ex-info\n  1161\t             \"publish! while a publication is still staged is a caller error; flush-staged resumes it\"\n  1162\t             {:staged staged})))\n  1163\t  (when-not (stream/writer? (get-in index-state [:publish :intake]))\n  1164\t    (throw (ex-info \"publish! requires an intake writer on the session\"\n  1165\t                    {:publish (:publish index-state)})))\n  1166\t  (let [trees (:indexes index-state)\n  1167\t        storage (:storage index-state)\n  1168\t        root-addr (fn [tree]\n  1169\t                    ;; an empty index has no root node; nil is the explicit\n  1170\t                    ;; \"nothing here\" (walk of nil => ())\n  1171\t                    (when (pos? (bt/count tree)) (bt/store-tree tree storage)))\n  1172\t        manifest {:indexes {:eavt (root-addr (:eavt trees)),\n  1173\t                            :aevt (root-addr (:aevt trees)),\n  1174\t                            :avet (root-addr (:avet trees)),\n  1175\t                            :vaet (root-addr (:vaet trees))},\n  1176\t                  ;; Covered indexes are sets: the count describes the\n  1177\t                  ;; distinct tuples actually stored\n  1178\t                  :count (bt/count (:eavt trees)),\n  1179\t                  :branching-factor (:branching-factor index-state)}\n  1180\t        payloads (conj (mapv (fn [[address bs]]\n  1181\t                               (jing/segment-value address bs))\n  1182\t                             (:order @(:state (:recorder index-state))))\n  1183\t                       manifest)]\n  1184\t    (attempt-publication\n  1185\t      (-> index-state\n  1186\t          (assoc-in [:publish :staged] {:payloads payloads, :next 0})\n  1187\t          (assoc-in [:publish :manifest] manifest)))))\n  1188\t\n  1189\t\n  1190\t(defn flush-staged\n  1310\t(defn verify-candidate\n  1311\t  \"§4.2's promotion gate: verify, through the durable store's read path\n  1312\t   (jing/get — never a recording handle or any cache whose presence proves\n  1313\t   nothing about durability), that the candidate's manifest reads back valid\n  1314\t   and that every address reachable from all four roots resolves, leaves\n  1315\t   included — checked inside the bt/walk-addresses visitor, because the\n  1316\t   walker does not itself restore leaves. Answers the candidate when fully\n  1317\t   verified; nil is 'verification incomplete, never success — a missing\n  1318\t   manifest, a missing leaf, or a read failure all answer nil, the check may\n  1319\t   be retried later, and because content is immutable and retained, a check\n  1320\t   that once passed stays passed.\"\n  1321\t  [candidate content-store]\n  1322\t  (try\n  1323\t    (let [manifest (read-manifest content-store (:manifest-address candidate))\n  1324\t          storage (bts/kv-storage content-store\n  1325\t                                  {:branching-factor (:branching-factor\n  1326\t                                                       manifest)})\n  1327\t          missing (volatile! false)\n  1328\t          resident? (fn [address]\n  1329\t                      (if (identical? (jing/get content-store address\n  1330\t                                                content-missing)\n  1331\t                                      content-missing)\n  1332\t                        (do (vreset! missing true) false)\n  1333\t                        true))]\n  1334\t      (doseq [root (vals (:indexes manifest))]\n  1335\t        (bt/walk-addresses storage root resident?))\n  1336\t      (when-not @missing candidate))\n  1337\t    (catch #?(:cljd Object\n  1338\t              :clj Throwable\n  1339\t              :cljs :default)\n  1340\t           _\n  1341\t      nil)))\n  1342\t\n  1343\t\n  1344\t(defn restore\n  1345\t  \"Rebuild the consumer half of a session from a *verified* checkpoint\n  1346\t   candidate (§4.2; verify-candidate is the gate — restore re-reads the\n  1347\t   manifest from the durable store and throws on absence). Refuses — throws\n  1348\t   — when the candidate's :mode or :schema-address differ from the session\n  1349\t   being constructed, or when its :ids was :shared: a session-local snapshot\n  1350\t   of a shared allocator is stale the moment any sibling allocates after\n  1351\t   it, and restoring it would re-mint ids siblings already hold. For\n  1352\t   independently allocated sessions the four trees are restored lazily\n  1353\t   through a session-constructed :strong kv-storage over the durable store —\n  1354\t   never the query read path (restored-indexes), whose storage takes the\n  1355\t   host default ref-type (:soft on the JVM) and would leave the roots\n  1356\t   evictable into refault through a drained recording handle (§4.1's F2\n  1357\t   hazard). :defects start fresh (drained diagnostics are not state); the\n  1358\t   durable :rejected is reinstated, and the composition re-attaches the\n  1359\t   observer at :cursor with :ingress-gaps seeded from the candidate\n  1360\t   (dao.stream.observer/attach's kept-cursor arity) — a partial index\n  1361\t   stays partial after restart.\n  1362\t\n  1363\t   opts:\n  1364\t     {:content-store h   durable jing handle the manifest and blobs read from\n  1365\t      :intake w          the new session's intake writer\n  1366\t      :mode m            of the session being constructed; must equal the\n  1367\t                         candidate's\n  1368\t      :schema s          ditto; its schema address must match candidate's\n  1369\t      :ref-type k        the restored trees' ref-type, default :strong (the\n  1370\t                         btree :test seam pins the F2 hazard deterministically)\n  1371\t      :verify? b         kv-storage integrity option (default false)}\"\n  1372\t  [candidate {:keys [content-store intake mode schema ref-type verify?]}]\n  1373\t  (when-not (and (map? candidate) (jing/segment-address? (:manifest-address candidate)))\n  1374\t    (throw (ex-info \"restore takes a checkpoint candidate carrying a manifest address\"\n  1375\t                    {:candidate candidate})))\n  1376\t  (when-not (stream/writer? intake)\n  1377\t    (throw (ex-info \"restore :intake must be a dao.stream writer\"\n  1378\t                    {:intake intake})))\n  1379\t  (when-not (= mode (:mode candidate))\n  1380\t    (throw (ex-info \"checkpoint candidate mode does not match the session being constructed\"\n  1381\t                    {:candidate-mode (:mode candidate), :session-mode mode})))\n  1382\t  (validate-schema! schema)\n  1383\t  (when-not (jing/segment-matches? (:schema-address candidate) schema)\n  1384\t    (throw (ex-info \"checkpoint candidate schema does not match the session being constructed\"\n  1385\t                    {:candidate-schema-address (:schema-address candidate)})))\n  1386\t  (when (= :shared (get-in candidate [:ids :ownership]))\n  1387\t    (throw (ex-info\n  1388\t             \"restore refuses a :shared allocator: a session-local snapshot of it is stale the moment any sibling allocates; coordinated recovery is a composition-level checkpoint over every sharing session\"\n  1389\t             {:ids (:ids candidate)})))\n  1390\t  (let [manifest (read-manifest content-store (:manifest-address candidate))\n  1391\t        branching (:branching-factor manifest)\n  1392\t        durable (bts/kv-storage content-store\n  1393\t                                {:branching-factor branching,\n  1394\t                                 :ref-type (or ref-type :strong),\n  1395\t                                 :verify? verify?})\n  1396\t        restore-tree (fn [cmp address]\n  1397\t                       (bt/restore-tree cmp address durable (:count manifest)))\n  1398\t        recorder (recording-content-handle)]\n  1399\t    {:indexes {:eavt (restore-tree eavt-cmp (get-in manifest [:indexes :eavt])),\n  1400\t               :aevt (restore-tree aevt-cmp (get-in manifest [:indexes :aevt])),\n  1401\t               :avet (restore-tree avet-cmp (get-in manifest [:indexes :avet])),\n  1402\t               :vaet (restore-tree vaet-cmp (get-in manifest [:indexes :vaet]))},\n  1403\t     :storage (bts/kv-storage recorder\n  1404\t                              {:branching-factor branching, :ref-type :strong}),\n  1405\t     :recorder recorder,\n  1406\t     :branching-factor branching,\n  1407\t     :mode (:mode candidate),\n  1408\t     :ids (:ids candidate),\n  1409\t     :batch (:batch candidate),\n  1410\t     :schema schema,\n  1411\t     :max-t (:max-t candidate),\n  1412\t     :rejected (:rejected candidate),\n  1413\t     :publish {:intake intake, :staged nil, :manifest nil},\n  1414\t     :defects []}))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"agent_message","text":"The frontier comparison is protecting a real invariant: `:branching-factor` is the count limit restored B-tree nodes use, not inherently a transport constant. It can come from a generic store publication policy without changing the manifest schema, but the check must remain. The byte budget also needs to reach the suffix/restore path; today that path does not receive `:publish-opts`."}}
