/banner).\"\nsrc/cljc/yin/repl/main.cljc:949:        dht? (= :dht (:type spec))]\nsrc/cljc/yin/repl/main.cljc:969:      dht? (into (repl.dht/banner spec))\nsrc/cljc/yin/repl/main.cljc:970:      (and dht? (:publish? spec))\nsrc/cljc/yin/repl/main.cljc:971:      (conj (str \"dht: the code index and the code itself are shared: every\"\nsrc/cljc/yin/repl/main.cljc:974:      (and dht? (:publisher opts))\nsrc/cljc/yin/repl/main.cljc:975:      (conj (str \"dht: names published here are signed by principal \"\nsrc/cljc/yin/repl/main.cljc:976:                 (:publisher opts) \" (key from \" (:dht-key-file opts) \")\"))\nsrc/cljc/yin/repl/main.cljc:977:      (and dht? (not (:publisher opts)))\nsrc/cljc/yin/repl/main.cljc:978:      (conj (str \"dht: no --dht-key: (yin.link/publish ...) is refused; names\"\nsrc/cljc/yin/repl/main.cljc:993:  \"Print a composition that ends at startup -- `--dht-keygen` -- and end\nsrc/cljc/yin/repl/main.cljc:1053:   first (yin.repl.dht/step): its lines print before the shell's, a\nsrc/cljc/yin/repl/main.cljc:1069:   of its own (yin.repl/recheck-on-tick, yin.vm.linker.dht.md 8.2),\nsrc/cljc/yin/repl/main.cljc:1074:  (let [[repl dht-lines events] (repl.dht/step (:repl state) now)\nsrc/cljc/yin/repl/main.cljc:1077:      (repl.dht/refusal repl)\nsrc/cljc/yin/repl/main.cljc:1078:      [(custody-stop (assoc state :running? false)) server dht-lines]\nsrc/cljc/yin/repl/main.cljc:1080:      (not (repl.dht/admitting? repl))\nsrc/cljc/yin/repl/main.cljc:1081:      [state server dht-lines]\nsrc/cljc/yin/repl/main.cljc:1085:            dht-lines (cond-> dht-lines\nsrc/cljc/yin/repl/main.cljc:1100:        [state'' server'' (into dht-lines\nsrc/cljc/yin/repl/main.cljc:1115:               (repl.dht/busy? (:repl state))\nsrc/cljc/yin/repl/main.cljc:1134:  (if (repl.dht/refusal (:repl state)) 1 0))\nsrc/cljc/yin/repl/main.cljc:1183:   which have already been asked to stop (`yin.repl.dht/stop!`,\nsrc/cljc/yin/repl/main.cljc:1188:   `yin.repl.dht/stopped?` for the shell's head board: an endpoint that never\nsrc/cljc/yin/repl/main.cljc:1195:  (let [[repl dht-lines _] (repl.dht/step (:repl state) now)\nsrc/cljc/yin/repl/main.cljc:1203:     (into (vec dht-lines) (map entry-text) entries)\nsrc/cljc/yin/repl/main.cljc:1205:          (repl.dht/stopped? repl))]))\nsrc/cljc/yin/repl/main.cljc:1218:               (get-in state [:repl :dht])\nsrc/cljc/yin/repl/main.cljc:1232:                (repl.dht/stopped? (:repl state))\nsrc/cljc/yin/repl/main.cljc:1274:    (loop [state (update state :repl repl.dht/stop!)\nsrc/cljc/yin/repl/main.cljc:1521:                                        :state (update state' :repl repl.dht/stop!)\nsrc/cljc/yin/repl/main.cljc:1659:                                        :state (update state' :repl repl.dht/stop!)\n","exit_code":0,"status":"completed"}}
