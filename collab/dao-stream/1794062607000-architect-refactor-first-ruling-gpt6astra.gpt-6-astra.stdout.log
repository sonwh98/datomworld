eers peers now) :now\n  2322\t                                 (+ now 250)\n  2323\t                                 :moved? (main/moved? state nil lines))\n  2324\t                          (update :lines into lines)\n  2325\t                          (update :moved into [(main/moved? state nil lines)]))))\n  2326\t             w (reduce (fn [w i]\n  2327\t                         (let [[state text] (type! (:state w) (str \"(def v\" i\n  2328\t                                                                   \" \" i \")\"))\n  2329\t                               m (get-in state [:repl :indexer\n  2330\t                                                :manifest-address])]\n  2331\t                           (is (= (str i) text) \"the prompt answers at once\")\n  2332\t                           (loop [w (assoc w :state state)]\n  2333\t                             (if (or (line-with (:lines w) (str \"published \" m))\n  2334\t                                     (> (:now w) 2000000))\n  2335\t                               w\n  2336\t                               (recur (step w))))))\n  2337\t                       {:state state :peers peers :now 0 :lines [] :moved []}\n  2338\t                       (range 20))\n  2339\t             firsts (filter #(re-find #\"dht: published \" %) (:lines w))\n  2340\t             idle (reduce (fn [w _] (step w)) (assoc w :moved []) (range 400))]\n  2341\t            (is (= 20 (count firsts)) (pr-str (count firsts)))\n  2342\t            (is (every? #(str/includes? % \"NOT acknowledged\") firsts))\n  2343\t            (is (not-any? #(str/includes? % \"acknowledged: sent\") (:lines idle))\n  2344\t                \"no event ever reports acknowledged\")\n  2345\t            (testing \"between repair cycles the ticker returns to its idle cadence\"\n  2346\t              (is (some true? (:moved idle)) \"repair cycles keep the base cadence\")\n  2347\t              (is (some false? (drop-while false? (:moved idle)))\n  2348\t         