match (query/current (query/relation\n81:                                                          base-datoms))\n88:                                (let [resolved-e (if (keyword? e)\n90:                                                     base-datoms\n91:                                                     same-tx-ident->eid\n95:                                      (get eid->ident resolved-e))))))\n102:                               (let [resolved-e (if (keyword? e)\n104:                                                    base-datoms\n105:                                                    same-tx-ident->eid\n109:                                     (get eid->ident resolved-e))))))\n116:(defn- expand-m-map\n117:  \"Expand inline metadata maps into additional datoms.\"\n119:  (let [m-map (:m-map op)]\n120:    (if m-map\n121:      (let [m-datoms (mapcat\n123:                         (if (and (or (sequential? v) (set? v)) (not (map? v)))\n124:                           (map #(vector eid a % t (:db/assert datom/reserved))\n126:                           [[eid a v t (:db/assert datom/reserved)]]))\n127:                       m-map)\n128:            op' (assoc op :m-raw eid)]\n129:        [op' m-datoms (inc eid)])\n133:(defn- collect-tempids\n134:  \"Collect all tempids from parsed ops and extra datoms.\"\n135:  [ops effective-ref-attrs extra-datoms]\n136:  (let [op-tempids (mapcat (fn [{:keys [e a v m-raw]}]\n138:                               (tempid? e) (conj e)\n140:                                    (tempid? v))\n142:                               (tempid? m-raw) (conj m-raw)))\n144:        extra-tempids (mapcat (fn [d]\n146:                                  (tempid? (nth d 0)) (conj (nth d 0))\n148:                                       (tempid? (nth d 2)))\n150:                                  (tempid? (nth d 4)) (conj (nth d 4))))\ndocs/design/yin.vm.macro.md:168:mark-tail    : ast tail? → ast                         ; §3.4\ndocs/design/yin.vm.macro.md:228:   