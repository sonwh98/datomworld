       [dao.stream.transit :as transit]\n                      [dao.stream.ringbuffer :as ring]\n                      [dao.stream.serving :as serving]\n                      [dao.stream.ws.jvm :as jvm]]))\n  #?(:cljs (:require-macros [dao.jing])))\n\n\n(defn- validate-address-payload!\n  \"Throw unless address is a strict segment address matching the payload's\n   content-derived hash.\"\n  [address payload]\n  (when-not (jing/segment-address? address)\n    (throw (ex-info \"content address must be a segment address\"\n                    {:address address, :payload payload})))\n  (when-not (= (jing/segment-hash address) (jing/content-hash payload))\n    (throw (ex-info \"content address does not match payload hash\"\n                    {:address address,\n                     :content-hash (jing/content-hash payload)}))))\n\n\n#_{:clj-kondo/ignore [:unused-binding]}\n\n\n(defn- with-lock\n  [lock f]\n  #?(:clj (locking lock (f))\n     :default (f)))\n\n\n(defn- valid-presence-envelope?\n   258\t\n   259\t(defn receive!\n   260\t  \"Adapter entry for one text WebSocket message.  It performs only wire\n   261\t   validation and envelope translation; application values are never judged.\"\n   262\t  [handle text]\n   263\t  (let [state (.-state ^WsHandle handle)\n   264\t        attachment (.-attachment ^WsHandle handle)]\n   265\t    (try\n   266\t      (let [frame (transit/decode text)]\n   267\t        (cond\n   268\t          (and (= :ws/accept (:ws/frame frame)) (= :connecting (:phase @state)))\n   269\t          (opened! handle)\n   270\t\n   271\t          (and (= :ws/disclaim (:ws/frame frame)) (= :connecting (:phase @state)))\n   272\t          (disclaimed! handle)\n   273\t\n   274\t          (and (= :ws/value (:ws/frame frame))\n   275\t               (contains? frame :ws/value)\n   276\t               (= :open (:phase @state))\n   277\t               (transit/portable-value? (:ws/value frame)))\n   278\t          (emit! state attachment :ws/payload (:ws/value frame))\n   279\t\n   280\t          :else (protocol-failure! state attachment)))\n   281\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   282\t        (protocol-failure! state attachment)))))\n   283\t\n   284\t\n   285\t(defn closed!\n   286\t  \"Adapter entry for host close completion.  The terminal event is guarded so\n   287\t   close/error races cannot duplicate it.\"\n   288\t  [handle code _reason]\n   289\t  (let [state (.-state ^WsHandle handle)\n   290\t        attachment (.-attachment ^WsHandle handle)]\n   360\t                 (compile-let bindings body-expr env tail? macro-env))\n   361\t           ;; Do block: (do expr1 expr2 ...)\n   362\t           do (compile-do operands env tail? macro-env)\n   363\t           ;; Short-circuit logical: expand to if chains so unevaluated operands are never touched\n   364\t           ;; (and)       → true\n   365\t           ;; (and x)     → x\n   366\t           ;; (and x y z) → (let [g x] (if g (and y z) g))\n   367\t           and (cond\n   368\t                 (empty? operands) {:type :literal :value true}\n   369\t                 (= 1 (count operands)) (compile-form (first operands) tail? env macro-env)\n   370\t                 :else (let [g (gensym \"and__\")]\n   371\t                         (compile-form (list 'let [g (first operands)]\n   372\t                                             (list 'if g (cons 'and (rest operands)) g))\n   373\t                                       tail? env macro-env)))\n   374\t           ;; (or)        → nil\n   375\t           ;; (or x)      → x\n   376\t           ;; (or x y z)  → (let [g x] (if g g (or y z)))\n   377\t           or  (cond\n   378\t                 (empty? operands) {:type :literal :value nil}\n   379\t                 (= 1 (count operands)) (compile-form (first operands) tail? env macro-env)\n   380\t                 :else (let [g (gensym \"or__\")]\n   381\t                         (compile-form (list 'let [g (first operands)]\n   382\t                                             (list 'if g g (cons 'or (rest operands))))\n   383\t                                       tail? env macro-env)))\n   384\t           ;; Quote: (quote form)\n   385\t           quote (compile-quote (first operands) tail?)\n   386\t           ;; Def: (def sym value)\n   387\t           def (let [[sym value] operands] (compile-def sym value env tail? macro-env))\n   388\t           ;; Function application: (f arg1 arg2 ...)\n   389\t           (compile-application operator operands env tail? macro-env))))\n   390\t     ;; Unknown form type\n130:             :operands [{:type :literal, :value fn-name}\n140:       (contains? #{'fn 'if 'let 'quote 'do 'def 'dao.stream.apply/call 'defmacro} (first form))))\n146:  {:type :literal, :value form})\n162:            :operands [{:type :literal, :value sym}\n281:(defn compile-quote\n282:  \"Compile a quoted form to Universal AST.\n368:                 (empty? operands) {:type :literal :value true}\n378:                 (empty? operands) {:type :literal :value nil}\n384:           ;; Quote: (quote form)\n385:           quote (compile-quote (first operands) tail?)\n444:                                        :operands [{:type :literal, :value macro-name}\n483:    => {:type :literal, :value 42}\n488:        :operands [{:type :literal, :value 1}\n489:                   {:type :literal, :value 2}]}\n497:                          {:type :literal, :value 2}]}}\"\n 31864\tdc.int i$1=arr$1.length;\n 31865\tfinal dc.List<dc.dynamic> fl$2=(dc.List<dc.dynamic>.filled(10, const lcoc_core.Keyword(null, \"end-line\", 1522187715, ), ));\n 31866\t(fl$2[1]=3436);\n 31867\t(fl$2[2]=const lcoc_core.Keyword(null, \"tag\", 2780644040, ));\n 31868\t(fl$2[3]=lcoc_core.PersistentList);\n 31869\t(fl$2[4]=const lcoc_core.Keyword(null, \"end-column\", 796248491, ));\n 31870\t(fl$2[5]=54);\n 31871\t(fl$2[6]=const lcoc_core.Keyword(null, \"line\", 878494669, ));\n 31872\t(fl$2[7]=3436);\n 31873\t(fl$2[8