{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/hygiene-doc-check.py <<'PY'\nimport json,re\nfrom pathlib import Path\nfrom markdown_it import MarkdownIt\nfrom html.parser import HTMLParser\norig=json.load(open('/tmp/hygiene-original.json'));md=MarkdownIt().enable('table')\nclass Cells(HTMLParser):\n def __init__(self):super().__init__();self.cells=[];self.cell=None\n def handle_starttag(self,t,a):\n  if t in ('td','th'):self.cell=''\n def handle_endtag(self,t):\n  if t in ('td','th') and self.cell is not None:self.cells.append(self.cell);self.cell=None\n def handle_data(self,s):\n  if self.cell is not None:self.cell+=s\nfor f,s in orig.items():\n if not f.endswith('.md'):continue\n a=Cells();a.feed(md.render(s));b=Cells();b.feed(md.render(Path(f).read_text()))\n def norm(x):\n  for u,v in {'—':',','–':'-','…':'...','§':'section ','→':'->','∪':'union','−':'-','∥':'and','’':\\\"'\\\",'×':'x'}.items():x=x.replace(u,v)\n  return re.sub(r'\\\\s+',' ',x).strip()\n aa=list(map(norm,a.cells));bb=list(map(norm,b.cells))\n print(f,len(aa),len(bb),'cells equal:',aa==bb)\n if aa\"'!=bb:\n  for i,(x,y) in enumerate(zip(aa,bb)):\n   if x!=y:print(i,repr(x),repr(y))\nPY\npython3 /tmp/hygiene-doc-check.py\ncljstyle check $(python3 -c '\"'import json; print(\\\" \\\".join(f for f in json.load(open(\\\"/tmp/hygiene-files.json\\\")) if not f.endswith(\\\".md\\\")))') > /tmp/hygiene-style.log 2>&1\nmise exec -- clj -M:kondo --lint \"'$(python3 -c '\"'import json; print(\\\" \\\".join(f for f in json.load(open(\\\"/tmp/hygiene-files.json\\\")) if not f.endswith(\\\".md\\\")))') > /tmp/hygiene-kondo.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
