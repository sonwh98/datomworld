{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/hygiene-wrap.py <<'PY'\nimport json,re,textwrap\nfrom pathlib import Path\nfs=json.loads(Path('/tmp/hygiene-files.json').read_text())\nel=json.loads(Path('/tmp/hygiene-eligible.json').read_text())\nrep={'—':',','–':'-','…':'...','§':'section ','→':'->','←':'<-','↔':'<->','✓':'yes','✗':'no','×':'x','’':\\\"'\\\",'“':'\\\"','”':'\\\"','≤':'<=','≥':'>='}\nfor f in fs:\n original=Path(f).read_text(); out=[]; instring=False\n for n,line in enumerate(original.splitlines(),1):\n  eligible=n in el[f]; bad=eligible and (len(line)>80 or not line.isascii())\n  # Lex original line to distinguish literal interiors and comments.\n  state=instring; spans=[]; start=None; spaces=[]; comment=None; escaped=False\n  for j,c in enumerate(line):\n   if state:\n    if escaped: escaped=False\n    elif c=='\\\\\\\\': escaped=True\n    elif c=='\\\"':\n     state=False\n     if start is not None: spans.append((start,j+1))\n   elif c==';': comment=j; break\n   elif c=='\\\"': state=True; start=j\n   elif c.isspace(): spaces.append(j)\n  if comment is None: instring=state\n  if not bad: out.append(line); continue\n  for a,b in rep.items(): line=line.replace(a,b)\n  if not line.isascii(): print('UNKNOWN',f,n,repr(line))\n  if f.endswith('.md'):\n   indent=re.match(r'\\\\s*',line).group(); subsequent=indent\n   if re.match(r'\\\\s*(?:[-*]|\\\\d+[.]) ',line): subsequent=indent+'  '\n   out.extend(textwrap.wrap(line,80,subsequent_indent=subsequent,break_long_words=False,break_on_hyphens=False) or ['']); continue\n  if comment is not None:\n   code=line[:comment].rstrip(); txt=line[comment:]; prefix=re.match(r';+\\\\s*',txt).group()\n   if code: out.append(code); indent=' '*len(re.match(r'\\\\s*',line).group())\n   else: indent=re.match(r'\\\\s*',line).group()\n   out.extend(textwrap.wrap(txt[len(prefix):],80-len(indent+prefix),initial_indent='',subsequent_indent='',break_long_words=False,break_on_hyphens=False) and [indent+prefix+x for x in textwrap.wrap(txt[len(prefix):],80-len(indent+prefix),break_long_words=False,break_on_hyphens=False)]); continue\n  if instring or (state is False and start is None and not spaces):\n   # Interior of a multiline docstring.\n   indent=re.match(r'\\\\s*',line).group()\n   out.extend(textwrap.wrap(line,80,subsequent_indent=indent,break_long_words=False,break_on_hyphens=False)); continue\n  # Replace too-wide individual string literals by exact concatenations.\n  line=re.sub(r'\\\"(?:\\\\\\\\.|[\"'^\"'\"\\\\\\\\])*\\\"',lambda m: '(str\\\\n'+ '\\\\n'.join(' \\\"'+x+'\\\"' for x in [m.group()[1:-1][i:i+60] for i in range(0,len(m.group()[1:-1]),60)])+')' if len(m.group())>70 and '\\\\\\\\' not in m.group() else m.group(),line)\n  for part in line.splitlines():\n   while len(part)>80:\n    quoted=False; esc=False; candidates=[]\n    for j,c in enumerate(part):\n     if esc: esc=False; continue\n     if quoted and c=='\\\\\\\\': esc=True\n     elif c=='\\\"': quoted=not quoted\n     elif not quoted and c.isspace() and j>len(part)-len(part.lstrip()): candidates.append(j)\n    opts=[j for j in candidates if j<=78]\n    if not opts: break\n    cut=max(opts); out.append(part[:cut].rstrip()); part='  '+part[cut:].lstrip()\n   out.append(part)\n Path(f).write_text('\\\\n'.join(out)+'\\\\n')\nPY\npython3 /tmp/hygiene-wrap.py\ncljstyle check \"'$(python3 -c '\"'import json; print(\\\" \\\".join(f for f in json.load(open(\\\"/tmp/hygiene-files.json\\\")) if not f.endswith(\\\".md\\\")))') > /tmp/hygiene-style.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
