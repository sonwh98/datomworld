ython/antlr/siteset_test.cljc:503:(deftest ^:slow noninterruptible-profile-imports-plain-test\ntest/yang/python/antlr/siteset_test.cljc:504:  (slow/guard \"noninterruptible-profile-imports-plain-test\"\ntest/yang/python/antlr/siteset_test.cljc:505:              noninterruptible-imports-plain))\ntest/yang/python/antlr/import_test.cljc:112:      (is (= '#{yang.call py} (required-modules program))))\ntest/yang/python/antlr/import_test.cljc:142:      (is (= '#{yang.call py} (required-modules program)))\ntest/yang/python/antlr/import_test.cljc:188:      (is (= '[yang.call py] (requires-of program)))\ntest/yang/python/antlr/import_test.cljc:290:      (is (= '[yang.call py]\ntest/yang/python/antlr/import_test.cljc:317:      (is (= '[yang.call py] (requires-of program))))\ntest/yang/python/antlr/import_test.cljc:353:      (is (= '[yang.call py]\ntest/yang/python/antlr/import_test.cljc:362:      (is (= '[yang.call py] (requires-of program)))\ntest/yang/python/antlr/import_test.cljc:378:      (is (= '[yang.call py] (requires-of ast)))\ntest/yang/python/antlr/import_test.cljc:421:      (is (= '#{yang.call py} (required-modules program))))))\ntest/yang/python/antlr/import_test.cljc:479:    (testing \"one application: the yang.call and py runtime requires,\ntest/yang/python/antlr/import_test.cljc:485:      (is (= '[yang.call py] (requires-of ast)))\ntest/yang/python/antlr/import_test.cljc:500:    (is (= '#{yang.call py} (required-modules ast)))\ntest/yang/python/antlr/import_test.cljc:503:                   'pym.k/spec))\ntest/yang/python/antlr/import_test.cljc:528:      (is (= '{py :test/address, pym.k :test/k, yang.call :test/call}\ntest/yang/python/antlr/import_test.cljc:535:    (testing \"a py- or pym.k-qualified free name is never a primitive\ntest/yang/python/antlr/import_test.cljc:537:      (is (empty? (filter #(contains? #{\"py\" \"pym.k\"} (namespace %))\ntest/yang/python/antlr/import_test.cljc:589:                     'yang.call (:call-address @h/published)}\ntest/yang