{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat test/resources/yang/python/dht-import-v1.generate.clj && sed -n '220,270p' test/yang/python/antlr/linked_prelude_test.cljc && sed -n '1,50p' test/resources/yang/python/dht-import-v1.edn\"","aggregated_output":";; Generator of test/resources/yang/python/dht-import-v1.edn.\n;;\n;; Provenance: the JVM publication of C4 slice I3's DHT import\n;; (yang.python.antlr.dht-import-fixture). Run from the repository root\n;; on the JVM, with the test paths on the classpath, to rewrite the\n;; artifact:\n;;\n;;   clojure -Sdeps '{:aliases {:t {:extra-paths [\"test\"]}}}' -M:t \\\n;;    test/resources/yang/python/dht-import-v1.generate.clj\n;;\n;; (not -A:test: that alias's main is the test runner and runs the suite)\n;;\n;; It publishes the committed CST packets of the guest units through\n;; `yang.python.antlr.publication` against `py` as the JVM publishes it,\n;; signs the name envelopes with the fixture's fixed test seeds, and\n;; writes the guest blobs, the manifest addresses, the envelopes and the\n;; importer packets. Every input is checked in, and Ed25519 signatures are\n;; deterministic, so a rerun on an unchanged tree rewrites the same data.\n;; Rerun it whenever the prelude, the lowering or the linker's\n;; publication moves an address; `dht-import-test` fails until it is.\n\n(require '[yang.python.antlr.dht-import-fixture :as fixture])\n\n\n(let [{:keys [lines refused]} (fixture/generate)]\n  (when refused\n    (throw (ex-info \"the artifact's publication was refused\" refused)))\n  (spit fixture/path (fixture/text lines))\n  (println \"wrote\" fixture/path))\n          (str depth \" deep\")))))\n\n\n;; =============================================================================\n;; A1 and A10. `py` publishes to one pinned manifest address; the walker is\n;; excluded, visibly\n;; =============================================================================\n\n(def ^:private manifest-golden\n  \"I1 moved this once: the definition list gained the module runtime\n   (`py/import`, module objects, sys.modules and its two pre-seeded\n   modules) and the `ImportError` class. I2 moved it once: py/import-sub,\n   py/import-from, py/import-star, py/import-fail and their helpers, and\n   a top-level module's `__package__` ''. I3 moved it once:\n   py/star-item, `__all__` read by index (ranges included), and\n   py/run-session, the REPL `__main__` runner. It moved once more with\n   the rebase onto master 4529b5bd: the profile digest in the manifest\n   uses BLAKE3 since 492ff50b. Phase 8ab regenerates the H/R\n   checksums, derivation records and index keys. The rebase onto I4-a\n   regenerates this again for statement-time import delivery. I6 over\n   landed I5 re-mints it through dht-import-v1.generate.clj. The\n   value-display slice (06065e42: py/result!, py.rt/value, the :py/value\n   answer of py/run-session) moved it to this address; the s3 tracing\n   slice moved only the hook prelude, so this address did not move. The\n   S3 shared-call publication moved the Python module manifest.\"\n  (keyword (str \"segment/blake3-\"\n                \"34893d591a14df92a0baf2f5edf41e1a8260195f8c64dde3e69a0be3bc3a5cb9\")))\n\n\n(def ^:private vector-formats\n  [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register])\n\n\n(defn- manifest-address\n  []\n  (let [{:keys [store result address]} @h/published\n        links (:links result)]\n    (testing \"one address on every host (JVM golden)\"\n      (is (= manifest-golden address) (pr-str (dissoc result :links :walk))))\n    (testing \"the three vector formats link :ok under :verifying\"\n      (doseq [f vector-formats]\n        (is (= :ok (get-in links [f :status])) (str f))\n        (is (= :verified (get-in links [f :trust])) (str f))))\n    (testing \"publishing twice into one store answers one address\"\n      (is (= address\n             (:address (publish/publish-module!\n                         store (prelude/module-spec registry\n                                                    (:call-address @h/published)))))))))\n\n\n(deftest ^:slow manifest-address-test\ndht-import-v1\n{:py :segment/blake3-34893d591a14df92a0baf2f5edf41e1a8260195f8c64dde3e69a0be3bc3a5cb9}\n{:principals {:a \"bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5\", :b \"55154f42065ea5a1bea05463826be2684eb92df92c100027aabaae57ca554207\"}}\n{:units {\"m\" :segment/blake3-dc0f90560bfd02f77e1db1fa96f39cdeada27c2a9fa8c0f6b2185d0609987488, \"k\" :segment/blake3-81acd3aa2e641be3357dad78307fabfab3a469642ce8b140b8e616c7a5cae55a, \"t\" :segment/blake3-d32053a78e19fe76bdc814576c4ff5d7039a46ffbdabfcc70bd4522b83380ef8, \"e\" :segment/blake3-e5197ebcc2bd0201f437d51de2ef042e3fb15020ff0864d0d579a7f59e674520}, :republished {\"k\" :segment/blake3-ed72c2d178c3c12e2377d496f2e01a852be62c46e809e9c2c6d8dd484ae52b6f}}\n{:importers {:d #:yang.cst{:version 1, :unit [:hand 0], :grammar \"hand\", :outcome :yang.cst/ok, :root 0, :nodes [{:id 0, :kind :rule, :rule \"file_input\", :children [1 13 45 76], :span [0 0]} {:id 1, :kind :rule, :rule \"stmt\", :children [2], :span [0 0]} {:id 2, :kind :rule, :rule \"simple_stmts\", :children [3 12], :span [0 0]} {:id 3, :kind :rule, :rule \"simple_stmt\", :children [4], :span [0 0]} {:id 4, :kind :rule, :rule \"import_stmt\", :children [5], :span [0 0]} {:id 5, :kind :rule, :rule \"import_name\", :children [6 7], :span [0 0]} {:id 6, :kind :token, :type \"IMPORT\", :text \"import\", :span [0 0]} {:id 7, :kind :rule, :rule \"dotted_as_names\", :children [8], :span [0 0]} {:id 8, :kind :rule, :rule \"dotted_as_name\", :children [9], :span [0 0]} {:id 9, :kind :rule, :rule \"dotted_name\", :children [10], :span [0 0]} {:id 10, :kind :rule, :rule \"name\", :children [11], :span [0 0]} {:id 11, :kind :token, :type \"NAME\", :text \"m\", :span [0 0]} {:id 12, :kind :token, :type \"NEWLINE\", :text \"\\n\", :span [0 0]} {:id 13, :kind :rule, :rule \"stm