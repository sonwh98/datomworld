r [(:path grammar) (str (:path grammar) \"/Java\")]]\n   258\t      (let [url (str \"https://api.github.com/repos/\" (:repo grammar)\n   259\t                     \"/contents/\" dir\n   260\t                     (when (:revision grammar)\n   261\t                       (str \"?ref=\" (:revision grammar))))\n   262\t            listing (String. (http-get-bytes url) \"UTF-8\")]\n   263\t        (println dir (mapv second (re-seq #\"\\\"path\\\":\\s*\\\"([^\\\"]+)\\\"\"\n   264\t                                          listing)))))))\n   265\t\n   266\t\n   267\t(defn -main\n   268\t  [& args]\n   269\t  (case (first args)\n   270\t    \"discover\" (discover!)\n   271\t    (generate!))\n   272\t  (shutdown-agents))\n","exit_code":0,"status":"completed"}}
