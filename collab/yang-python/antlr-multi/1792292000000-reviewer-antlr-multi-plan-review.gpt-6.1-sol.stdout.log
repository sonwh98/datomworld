{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat antlr/python3/manifest.edn; cat package.json; cat pubspec.yaml; rg -n 'antlr|test:cljs|test:cljd|test:clj' bb.edn deps.edn; nl -ba src/clj/yang/python/antlr/parser.clj; nl -ba src/clj/yang/python/antlr/repl_probe.clj\"","aggregated_output":"{:grammar {:repo \"antlr/grammars-v4\",\n           :path \"python/python3\",\n           :revision \"8af0d4c26c796ea27c15c3d85418f2d0f77c3adb\",\n           ;; The two MIT grammars are vendored verbatim beside this manifest\n           ;; (owner decision \"Vendor .g4 only\"); the two Java helpers, whose\n           ;; licence is unresolved, are still fetched at the pinned revision.\n           ;; Every file is digest-checked either way.\n           :files {\"Python3Lexer.g4\"\n                   {:blake3 \"407a5312b637ebe386eabaceca758a5714f1d3e26b1f058b96e43dca3ec02662\",\n                    :vendored \"antlr/python3/Python3Lexer.g4\"},\n                   \"Python3Parser.g4\"\n                   {:blake3 \"e82099eb8fda51ea8b49c266cba8eb2af47eb400fe657d8d8867b1eaf62fe00d\",\n                    :vendored \"antlr/python3/Python3Parser.g4\"},\n                   \"Java/Python3LexerBase.java\"\n                   {:blake3 \"5212b67286df5ec7f8818876cbb2bb178e80fcdc5b3daae69e225edd5f68d385\"},\n                   \"Java/Python3ParserBase.java\"\n                   {:blake3 \"f29fa8fc257027885afdd9c778add55a1128c83b0f888035904d952be0e5222d\"}},\n           :generate [\"Python3Lexer.g4\" \"Python3Parser.g4\"]},\n :tool {:antlr \"4.13.2\", :runtime \"org.antlr/antlr4-runtime 4.13.2\"},\n :target :java,\n :package \"yang.python.antlr.gen\",\n :flags [\"-Dlanguage=Java\" \"-package\" \"yang.python.antlr.gen\" \"-no-listener\"\n         \"-no-visitor\"],\n ;; Every Java helper gets `package yang.python.antlr.gen;` prepended.\n ;; Exact-text replacements, applied in order after that. Upstream builds\n ;; NEWLINE and DEDENT with CommonToken(start, stop) at the end of the\n ;; newline-plus-indentation lexeme and never sets their text, so ANTLR reads\n ;; their text back from whatever source sits there: a NEWLINE before an\n ;; INDENT reads a space, and a DEDENT reads the newline it follows. The patch\n ;; puts NEWLINE on its newline characters and makes DEDENT zero-width\n ;; (stop = start - 1), so every token's span is the source it came from.\n :patches\n {\"Java/Python3LexerBase.java\"\n  [[\"            emit(commonToken(Python3Lexer.NEWLINE, newLine));\"\n    \"            emit(positionedToken(Python3Lexer.NEWLINE, this._tokenStartCharIndex, this._tokenStartCharIndex + newLine.length() - 1));\"]\n   [\"        CommonToken dedent = commonToken(Python3Lexer.DEDENT, \\\"\\\");\"\n    \"        CommonToken dedent = positionedToken(Python3Lexer.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);\"]\n   [\"            this.emit(commonToken(Python3Lexer.NEWLINE, \\\"\\\\n\\\"));\"\n    \"            this.emit(positionedToken(Python3Lexer.NEWLINE, this.getCharIndex(), this.getCharIndex() - 1));\"]\n   [\"    private CommonToken commonToken(int type, String text) {\"\n    \"    private CommonToken positionedToken(int type, int start, int stop) {\\n        return new CommonToken(this._tokenFactorySourcePair, type, DEFAULT_TOKEN_CHANNEL, start, stop);\\n    }\\n\\n    private CommonToken commonToken(int type, String text) {\"]]},\n ;; BLAKE3 of every generated/patched .java file; generation fails on drift\n :generated {\"Python3Lexer.java\"\n             \"bb61a463af3d2c5d3f58778c0b10e082f1b3c88fd793102646e632087a540848\",\n             \"Python3LexerBase.java\"\n             \"1c8ac0a2bd1cc1499b842e251eea74a13cf7b6e984ece6cb5b55ff69403b354e\",\n             \"Python3Parser.java\"\n             \"8ba1f2398e52994e8ead1d68768c723bed6dbd4b5eccd48d57d585d1684f13d7\",\n             \"Python3ParserBase.java\"\n             \"332745797ab6423d234c796e80103823d718bc9da0a73643682a43d0c42c45be\"},\n ;; §4.5 license review\n :license {\"Python3Lexer.g4\" \"MIT (header: Copyright (c) 2014 Bart Kiers); vendored with its notice verbatim\",\n           \"Python3Parser.g4\" \"MIT (header: Copyright (c) 2014 Bart Kiers); vendored with its notice verbatim\",\n           \"Java/Python3LexerBase.java\" \"no notice in file; UNRESOLVED: not vendored, fetched by pinned digest\",\n           \"Java/Python3ParserBase.java\" \"no notice in file; UNRESOLVED: not vendored, fetched by pinned digest\",\n           \"antlr4-runtime 4.13.2\" \"BSD-3-Clause\"},\n ;; Generated artifacts include code derived from the two helpers, so their\n ;; provenance must be resolved before any generated artifact is distributed.\n :redistribution {:vendored-sources [\"antlr/python3/Python3Lexer.g4\"\n                                     \"antlr/python3/Python3Parser.g4\"],\n                  :generated-artifacts :none,\n                  :blocked-until \"Java helper provenance and licence resolved\"}}\n\n{\n  \"name\": \"datomworld\",\n  \"version\": \"0.0.1\",\n  \"private\": true,\n  \"devDependencies\": {\n    \"shadow-cljs\": \"3.3.5\"\n  },\n  \"dependencies\": {\n    \"@codemirror/lang-php\": \"^6.0.2\",\n    \"@codemirror/lang-python\": \"^6.2.1\",\n    \"@codemirror/theme-one-dark\": \"^6.1.3\",\n    \"@nextjournal/lang-clojure\": \"^1.0.0\",\n    \"@noble/hashes\": \"2.4.0\",\n    \"codemirror\": \"^6.0.2\",\n    \"ol\": \"^6.6.1\",\n    \"punycode\": \"^2.3.1\",\n    \"react\": \"^17.0.2\",\n    \"react-dom\": \"^17.0.2\",\n    \"ws\": \"^8.18.0\"\n  },\n  \"description\": \"A world built on data\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"SEE LICENSE IN LICENSE-EXCEPTION\"\n}\nname: datomworld_cljd\ndescription: ClojureDart experiment for Datomworld\npublish_to: 'none'\nenvironment:\n  # cbor 6.5.1 (the dao.stream.cbor Dart codec) requires >=3.7.0.\n  sdk: \">=3.7.0 <4.0.0\"\n\ndependencies:\n  flutter:\n    sdk: flutter\n  flutter_gpu:\n    sdk: flutter\n  http: ^1.2.0\n  cbor: 6.5.1\n  crypto: 3.0.7\n  # The :cljd NFC seam (yin.vm.debruijn's normalize-nfc). Pinned to the\n  # Unicode 16.0 release the de Bruijn projection design settled on\n  # 2026-09-21; 0.3.2 moved to Unicode 17.0.\n  unorm_dart: 0.3.1+1\n  # DaoJing multihash content-addressing (BLAKE3).\n  blake3_dart: 1.0.0\n  ed25519_edwards: 0.3.2\n\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n  test: ^1.29.0\n\nflutter:\n  assets:\n    - assets/shaders/simple_mesh.shaderbundle\n    - assets/images/earth_land_ocean_ice_2048.jpg\n    - assets/images/moon_texture_1024.jpg\n    - assets/images/earth_land_ocean_ice_1024.jpg\n    - assets/images/moon_texture_512.jpg\ndeps.edn:12:        ;; yang.python.antlr: the runtime the generated Python3 parser runs\ndeps.edn:13:        ;; on; pinned to the tool version in :antlr-gen (they are one release)\ndeps.edn:14:        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\ndeps.edn:20: ;; build/antlr/python3/classes: the generated Python3 parser, produced by\ndeps.edn:21: ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\ndeps.edn:23:         \"build/antlr/python3/classes\"]\ndeps.edn:76:           ;; The tool version must equal the antlr4-runtime above.\ndeps.edn:77:           :antlr-gen {:extra-paths [\"src/dev\"]\ndeps.edn:78:                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\ndeps.edn:79:                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\nbb.edn:2: {gen:python-antlr\nbb.edn:3:  {:doc \"Generate and compile the pinned grammars-v4 Python3 parser into build/antlr/python3/classes (antlr/python3/manifest.edn)\"\nbb.edn:4:   :task (shell \"clojure -M:antlr-gen\")}\nbb.edn:20:   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\nbb.edn:21:   ;; `bb test:cljs` without it skips those tests with a printed notice\nbb.edn:28:  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\nbb.edn:29:            :depends [build:yin-repl-node gen:python-antlr]\nbb.edn:32:  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\nbb.edn:36:  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\nbb.edn:42:                :depends [build:yin-repl-node gen:python-antlr]\nbb.edn:58:                 :depends [build:yin-repl-node gen:python-antlr]\nbb.edn:84:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n     1\t(ns yang.python.antlr.parser\n     2\t  \"The Python parser interpreter (JVM host): the grammars-v4 Python3 grammar\n     3\t   profile plus the stage that reads sealed source units from one stream and\n     4\t   writes CST packets to another. The generated recognizers come from\n     5\t   `clj -M:antlr-gen` (antlr/python3/manifest.edn); this is the only\n     6\t   namespace that names them.\"\n     7\t  (:require\n     8\t    [yang.antlr.cst :as cst]\n     9\t    [yang.stage :as stage])\n    10\t  (:import\n    11\t    (yang.python.antlr.gen\n    12\t      Python3Lexer\n    13\t      Python3Parser)))\n    14\t\n    15\t\n    16\t(def grammar-id\n    17\t  \"grammars-v4 python/python3 at its pinned revision, generated by ANTLR 4.13.2.\"\n    18\t  \"grammars-v4/python/python3@8af0d4c26c796ea27c15c3d85418f2d0f77c3adb antlr-4.13.2\")\n    19\t\n    20\t\n    21\t(def profile\n    22\t  {:grammar-id grammar-id,\n    23\t   :make-lexer (fn [cs] (Python3Lexer. cs)),\n    24\t   :make-parser (fn [ts] (Python3Parser. ts)),\n    25\t   :start (fn [^Python3Parser p] (.file_input p))})\n    26\t\n    27\t\n    28\t(defn make-worker\n    29\t  []\n    30\t  (cst/make-worker profile))\n    31\t\n    32\t\n    33\t(defn parse-source\n    34\t  \"Parse one complete source string as unit `unit`: the packet a sealed unit\n    35\t   with this text produces.\"\n    36\t  ([source] (parse-source (make-worker) [:unit 0] source))\n    37\t  ([worker unit source] (cst/parse-unit worker unit source)))\n    38\t\n    39\t\n    40\t(defn open-stage\n    41\t  \"A parser stage reading source events from `source-stream` and writing\n    42\t   CST packets to `cst-stream`, with its own worker.\"\n    43\t  [source-stream cst-stream]\n    44\t  (assoc (stage/open source-stream {:cst cst-stream} {})\n    45\t         ::transform (cst/parse-transform (make-worker))))\n    46\t\n    47\t\n    48\t(defn step-stage\n    49\t  [s]\n    50\t  (stage/step s (::transform s)))\n     1\t(ns yang.python.antlr.repl-probe\n     2\t  \"The Python ANTLR frontend's completeness probe (docs/design/yang.antlr.md\n     3\t   section 8.5.6, slice F3; JVM only, as the parser is). `probe` answers\n     4\t   whether the text typed so far is a whole submission:\n     5\t\n     6\t   - `:complete`: the text parses, or it is wrong in a way more lines cannot\n     7\t     mend (the shell then reports the syntax error);\n     8\t   - `:incomplete`: more lines can still finish it.\n     9\t\n    10\t   Two passes decide. A lexical `scan` follows short and triple-quoted\n    11\t   strings with their escapes, comments, typed bracket nesting and explicit\n    12\t   backslash continuation: a string still open waits for more lines unless\n    13\t   the text, with that string standing as an empty one, already fails on\n    14\t   or before it; a bracket or continuation still open waits too (a blank\n    15\t   line among them is legal Python), and a closer that matches no opener\n    16\t   is an error at once. Then\n    17\t   the parser runs, and its first error is classified by the token it\n    18\t   failed on: only a failure on the end-of-input tokens (EOF, and the\n    19\t   NEWLINE and DEDENT the lexer synthesizes there) is mendable by more\n    20\t   lines; any earlier token is not, so the error is reported even under an\n    21\t   open bracket. With brackets, strings and continuations closed, a blank\n    22\t   line ends the submission, and text that parses waits only while its\n    23\t   last logical line is indented: as in CPython's REPL, a blank line closes\n    24\t   a block.\"\n    25\t  (:require\n    26\t    [clojure.string :as str]\n    27\t    [yang.python.antlr.parser :as parser])\n    28\t  (:import\n    29\t    (org.antlr.v4.runtime\n    30\t      ANTLRErrorListener\n    31\t      BaseErrorListener\n    32\t      CharStreams\n    33\t      CommonTokenStream\n    34\t      Lexer\n    35\t      NoViableAltException\n    36\t      Parser\n    37\t      Token)\n    38\t    (org.antlr.v4.runtime.atn\n    39\t      ATN\n    40\t      LexerATNSimulator\n    41\t      ParserATNSimulator\n    42\t      PredictionContextCache)))\n    43\t\n    44\t\n    45\t;; =============================================================================\n    46\t;; Lexical scan\n    47\t;; =============================================================================\n    48\t\n    49\t(def ^:private opener-of\n    50\t  {\\) \\(, \\] \\[, \\} \\{})\n    51\t\n    52\t\n    53\t(defn- string-end\n    54\t  \"The index just past the string literal whose body starts at `i`, quoted\n    55\t   by `q`, tripled when `triple?`: `:open` when more lines can still close\n    56\t   it (a triple string, or a short string whose line ends in a backslash),\n    57\t   `:broken` when a short string's line ends without one. A backslash\n    58\t   escapes the next character, a newline included, in raw strings too.\"\n    59\t  [^String text i q triple?]\n    60\t  (let [n (count text)\n    61\t        closer (if triple? (str q q q) (str q))]\n    62\t    (loop [i i]\n    63\t      (if (>= i n)\n    64\t        (if triple? :open :broken)\n    65\t        (let [c (.charAt text i)]\n    66\t          (cond\n    67\t            (= \\\\ c) (if (< (inc i) n) (recur (+ i 2)) :open)\n    68\t            (.startsWith text closer (int i)) (+ i (count closer))\n    69\t            (and (not triple?) (= \\newline c)) :broken\n    70\t            :else (recur (inc i))))))))\n    71\t\n    72\t\n    73\t(defn scan\n    74\t  \"The lexical state at the end of `text`:\n    75\t\n    76\t     {:brackets [opener ...]   ; still open, innermost last\n    77\t      :block? b}               ; the last logical line is indented\n    78\t\n    79\t   plus `:string :open` when the text ends inside a string (`:string-at`\n    80\t   its opening quote), `:continued\n    81\t   true` when it ends on an explicit backslash continuation, or `:error`\n    82\t   (`:bracket`, `:string`) for a closer with no matching opener or a short\n    83\t   string broken by a newline; the scan stops there.\"\n    84\t  [^String text]\n    85\t  (let [n (count text)]\n    86\t    ;; line-begin: where the current logical line's physical line began;\n    87\t    ;; line?: no code yet on the current logical line\n    88\t    (loop [i 0\n    89\t           stack []\n    90\t           line-begin 0\n    91\t           line? true\n    92\t           block? false]\n    93\t      (let [state {:brackets stack, :block? block?}\n    94\t            code (fn [stack]\n    95\t                   [stack (if line? (> i line-begin) block?)])]\n    96\t        (if (>= i n)\n    97\t          state\n    98\t          (let [c (.charAt text i)]\n    99\t            (cond\n   100\t              (= \\# c)\n   101\t              (let [eol (str/index-of text \"\\n\" i)]\n   102\t                (recur (or eol n) stack line-begin line? block?))\n   103\t\n   104\t              (= \\newline c)\n   105\t              (if (empty? stack)\n   106\t                (recur (inc i) stack (inc i) true block?)\n   107\t                (recur (inc i) stack line-begin line? block?))\n   108\t\n   109\t              (or (= \\\" c) (= \\' c))\n   110\t              (let [triple? (.startsWith text (str c c c) (int i))\n   111\t                    end (string-end text (+ i (if triple? 3 1)) c triple?)\n   112\t                    [stack block?] (code stack)]\n   113\t                (case end\n   114\t                  :open (assoc state :string :open :string-at i)\n   115\t                  :broken (assoc state :error :string)\n   116\t                  (recur end stack line-begin false block?)))\n   117\t\n   118\t              (= \\\\ c)\n   119\t              (cond\n   120\t                (= (inc i) n) (assoc state :continued true)\n   121\t                (= \\newline (.charAt text (inc i)))\n   122\t                (recur (+ i 2) stack line-begin line? block?)\n   123\t                :else (let [[stack block?] (code stack)]\n   124\t                        (recur (inc i) stack line-begin false block?)))\n   125\t\n   126\t              (contains? #{\\( \\[ \\{} c)\n   127\t              (let [[stack block?] (code stack)]\n   128\t                (recur (inc i) (conj stack c) line-begin false block?))\n   129\t\n   130\t              (contains? opener-of c)\n   131\t              (if (= (peek stack) (opener-of c))\n   132\t                (let [[stack block?] (code stack)]\n   133\t                  (recur (inc i) (pop stack) line-begin false block?))\n   134\t                (assoc state :error :bracket))\n   135\t\n   136\t              (contains? #{\\space \\tab \\formfeed \\return} c)\n   137\t              (recur (inc i) stack line-begin line? block?)\n   138\t\n   139\t              :else\n   140\t              (let [[stack block?] (code stack)]\n   141\t                (recur (inc i) stack line-begin false block?)))))))))\n   142\t\n   143\t\n   144\t;; =============================================================================\n   145\t;; Parse: where the first error failed\n   146\t;; =============================================================================\n   147\t\n   148\t(defn- first-failure\n   149\t  \"Parse `source` and answer nil when it parses, `:end` when its first\n   150\t   error failed on an end-of-input token, else `:early`.\n   151\t\n   152\t   The failing token is the offending token of a mismatch; a\n   153\t   no-viable-alternative error names the token its prediction began at,\n   154\t   so for it the failing token is the furthest one the parser had read\n   155\t   when the error was reported. End-of-input tokens are EOF and the\n   156\t   zero-width ones after the last token with source text (the lexer's\n   157\t   EOF can carry a span, so it is excluded by type). A lexer error has no\n   158\t   token and is `:early`.\"\n   159\t  [^String source]\n   160\t  (let [{:keys [profile lexer-atn lexer-dfa lexer-cache parser-atn\n   161\t                parser-dfa parser-cache]}\n   162\t        (parser/make-worker)\n   163\t        far (volatile! -1)\n   164\t        failure (volatile! nil)\n   165\t        lexer ^Lexer ((:make-lexer profile) (CharStreams/fromString source))\n   166\t        tokens (proxy [CommonTokenStream] [lexer]\n   167\t                 (LT\n   168\t                   [k]\n   169\t                   (let [^Token t (proxy-super LT k)]\n   170\t                     (when t (vswap! far max (.getTokenIndex t)))\n   171\t                     t)))\n   172\t        listener (proxy [BaseErrorListener] []\n   173\t                   (syntaxError\n   174\t                     [_recognizer offending _line _column _msg e]\n   175\t                     (when-not @failure\n   176\t                       (vreset! failure\n   177\t                                (cond\n   178\t                                  (not (instance? Token offending)) :lexical\n   179\t                                  (instance? NoViableAltException e) @far\n   180\t                                  :else (.getTokenIndex ^Token offending))))))\n   181\t        _ (.setInterpreter\n   182\t            lexer\n   183\t            (LexerATNSimulator.\n   184\t              lexer\n   185\t              ^ATN lexer-atn\n   186\t              ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\" lexer-dfa\n   187\t              ^PredictionContextCache lexer-cache))\n   188\t        _ (.removeErrorListeners lexer)\n   189\t        _ (.addErrorListener lexer ^ANTLRErrorListener listener)\n   190\t        parser ^Parser ((:make-parser profile) tokens)\n   191\t        _ (.setInterpreter\n   192\t            parser\n   193\t            (ParserATNSimulator.\n   194\t              parser\n   195\t              ^ATN parser-atn\n   196\t              ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\" parser-dfa\n   197\t              ^PredictionContextCache parser-cache))\n   198\t        _ (.removeErrorListeners parser)\n   199\t        _ (.addErrorListener parser ^ANTLRErrorListener listener)]\n   200\t    ((:start profile) parser)\n   201\t    (let [index @failure\n   202\t          last-real (->> (.getTokens ^CommonTokenStream tokens)\n   203\t                         (keep (fn [^Token t]\n   204\t                                 (when (and (not= Token/EOF (.getType t))\n   205\t                                            (<= (.getStartIndex t)\n   206\t                                                (.getStopIndex t)))\n   207\t                                   (.getTokenIndex t))))\n   208\t                         (reduce max -1))]\n   209\t      (cond\n   210\t        (nil? index) nil\n   211\t        (and (int? index) (> index last-real)) :end\n   212\t        :else :early))))\n   213\t\n   214\t\n   215\t;; =============================================================================\n   216\t;; Probe\n   217\t;; =============================================================================\n   218\t\n   219\t(defn- last-line-blank?\n   220\t  [text]\n   221\t  (str/blank? (peek (str/split text #\"\\n\" -1))))\n   222\t\n   223\t\n   224\t(defn probe\n   225\t  [text]\n   226\t  (let [{:keys [error string string-at continued brackets block?]} (scan text)\n   227\t        open? (boolean (or continued (seq brackets)))]\n   228\t    (cond\n   229\t      error :complete\n   230\t      ;; the open string stands as an empty one: an error on it or before\n   231\t      ;; it is not mended by more lines\n   232\t      string (if (= :early (first-failure (str (subs text 0 string-at)\n   233\t                                               \"''\\n\")))\n   234\t               :complete\n   235\t               :incomplete)\n   236\t      (and (not open?) (last-line-blank? text)) :complete\n   237\t      :else (case (first-failure (str text \"\\n\"))\n   238\t              nil (if (or open? block?) :incomplete :complete)\n   239\t              :end :incomplete\n   240\t              :early :complete))))\n","exit_code":0,"status":"completed"}}
