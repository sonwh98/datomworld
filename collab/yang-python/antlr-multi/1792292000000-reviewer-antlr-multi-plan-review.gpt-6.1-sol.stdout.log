{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/dev/yang_antlr_gen.clj'","aggregated_output":"     1\t(ns yang-antlr-gen\n     2\t  \"Build-time generation of the grammars-v4 Python3 parser for the JVM host\n     3\t   (docs/design/yang.antlr.md §4.2). Reproducible from clean:\n     4\t\n     5\t     clj -M:antlr-gen            ; or: bb gen:python-antlr\n     6\t\n     7\t   1. Read the vendored grammars (antlr/python3/*.g4, MIT, committed) and\n     8\t      fetch the remaining pinned files at the manifest's revision (cached\n     9\t      under build/, re-fetched only when absent); refuse any digest mismatch.\n    10\t   2. Apply the recorded patch: the upstream Java base helpers carry no\n    11\t      package clause; the generated recognizers are put in\n    12\t      `yang.python.antlr.gen`, so the helpers get that one line prepended.\n    13\t   3. Run the pinned ANTLR tool (-Dlanguage=Java, no listener, no visitor).\n    14\t   4. Compile with the host javac into build/antlr/python3/classes, which\n    15\t      deps.edn puts on the classpath.\n    16\t   5. Digest every generated .java file and compare with the manifest's\n    17\t      recorded generated digests; a mismatch fails the build.\n    18\t\n    19\t   `clj -M:antlr-gen discover` prints the head commit of the grammar path, for\n    20\t   deliberately moving the pin. Nothing here runs at admission time.\"\n    21\t  (:require\n    22\t    [clojure.edn :as edn]\n    23\t    [clojure.java.io :as io]\n    24\t    [clojure.pprint :as pprint]\n    25\t    [clojure.string :as str])\n    26\t  (:import\n    27\t    (io.github.rctcwyvrn.blake3\n    28\t      Blake3)\n    29\t    (java.net\n    30\t      URI)\n    31\t    (java.net.http\n    32\t      HttpClient\n    33\t      HttpClient$Redirect\n    34\t      HttpRequest\n    35\t      HttpResponse$BodyHandlers)\n    36\t    (javax.tools\n    37\t      ToolProvider)))\n    38\t\n    39\t\n    40\t(def manifest-path \"antlr/python3/manifest.edn\")\n    41\t\n    42\t(def build-dir \"build/antlr/python3\")\n    43\t\n    44\t\n    45\t(defn- blake3\n    46\t  [^bytes bs]\n    47\t  (let [b (Blake3/newInstance)]\n    48\t    (.update b bs)\n    49\t    (.hexdigest b)))\n    50\t\n    51\t\n    52\t(defn- http-get-bytes\n    53\t  ^bytes [url]\n    54\t  (let [client (-> (HttpClient/newBuilder)\n    55\t                   (.followRedirects HttpClient$Redirect/NORMAL)\n    56\t                   (.build))\n    57\t        req (-> (HttpRequest/newBuilder (URI/create url))\n    58\t                (.header \"User-Agent\" \"datomworld-yang-antlr-gen\")\n    59\t                (.build))\n    60\t        resp (.send client req (HttpResponse$BodyHandlers/ofByteArray))]\n    61\t    (when-not (= 200 (.statusCode resp))\n    62\t      (throw (ex-info \"Fetch failed\" {:url url, :status (.statusCode resp)})))\n    63\t    (.body resp)))\n    64\t\n    65\t\n    66\t(defn- read-manifest\n    67\t  []\n    68\t  (edn/read-string (slurp manifest-path)))\n    69\t\n    70\t\n    71\t(defn- raw-url\n    72\t  [{:keys [repo revision path]} file]\n    73\t  (str \"https://raw.githubusercontent.com/\" repo \"/\" revision \"/\" path \"/\" file))\n    74\t\n    75\t\n    76\t(defn- read-bytes\n    77\t  ^bytes [f]\n    78\t  (java.nio.file.Files/readAllBytes (.toPath (io/file f))))\n    79\t\n    80\t\n    81\t(defn- source-bytes!\n    82\t  \"A pinned file's bytes: a vendored file from the repository, otherwise\n    83\t   the build cache, fetched from the pinned revision when absent.\"\n    84\t  [grammar file {:keys [vendored]} target]\n    85\t  (cond\n    86\t    vendored (let [bs (read-bytes vendored)]\n    87\t               (io/copy bs target)\n    88\t               bs)\n    89\t    (.exists target) (read-bytes target)\n    90\t    :else (let [bs (http-get-bytes (raw-url grammar file))]\n    91\t            (io/copy bs target)\n    92\t            bs)))\n    93\t\n    94\t\n    95\t(defn- fetch-grammar!\n    96\t  \"Each pinned file, vendored or fetched, digest-checked. A vendored file\n    97\t   must also be ASCII (§4.5). A mismatching fetched file leaves the cache; a\n    98\t   vendored file is never deleted.\"\n    99\t  [{:keys [grammar]}]\n   100\t  (let [src-dir (io/file build-dir \"upstream\")]\n   101\t    (.mkdirs src-dir)\n   102\t    (let [mismatches\n   103\t          (vec (for [[file {expected :blake3, :as entry}]\n   104\t                     (sort-by key (:files grammar))\n   105\t                     :let [target (io/file src-dir (str/replace file \"/\" \"__\"))\n   106\t                           bs (source-bytes! grammar file entry target)\n   107\t                           actual (blake3 bs)\n   108\t                           ascii? (every? #(<= 0 % 127) bs)]\n   109\t                     :when (or (println (if (:vendored entry) \"vendored\" \"fetched\")\n   110\t                                        file actual)\n   111\t                               (not= expected actual)\n   112\t                               (and (:vendored entry) (not ascii?)))]\n   113\t                 (do (.delete target)\n   114\t                     {:file file, :expected expected, :actual actual,\n   115\t                      :ascii ascii?})))]\n   116\t      (when (seq mismatches)\n   117\t        (throw (ex-info \"Grammar digest or ASCII check failed\"\n   118\t                        {:mismatches mismatches}))))\n   119\t    src-dir))\n   120\t\n   121\t\n   122\t(defn- delete-tree!\n   123\t  [f]\n   124\t  (let [f (io/file f)]\n   125\t    (when (.isDirectory f)\n   126\t      (doseq [c (.listFiles f)] (delete-tree! c)))\n   127\t    (.delete f)))\n   128\t\n   129\t\n   130\t(defn- apply-patch\n   131\t  \"One recorded exact-text replacement; the old text must occur exactly once.\"\n   132\t  [file text [old new]]\n   133\t  (let [n (count (re-seq (re-pattern (java.util.regex.Pattern/quote old))\n   134\t                         text))]\n   135\t    (when-not (= 1 n)\n   136\t      (throw (ex-info \"Patch does not apply\" {:file file, :old old, :matches n})))\n   137\t    (str/replace text old new)))\n   138\t\n   139\t\n   140\t(defn- stage-sources!\n   141\t  \"Copy grammars and helpers into one generation directory, applying the\n   142\t   recorded patches: the package clause for the Java helpers, then the\n   143\t   manifest's exact-text replacements.\"\n   144\t  [{:keys [grammar package patches]} src-dir]\n   145\t  (let [gen-in (io/file build-dir \"grammar\")]\n   146\t    (delete-tree! gen-in)\n   147\t    (.mkdirs gen-in)\n   148\t    (doseq [file (sort (keys (:files grammar)))]\n   149\t      (let [text (slurp (io/file src-dir (str/replace file \"/\" \"__\")))\n   150\t            base (last (str/split file #\"/\"))\n   151\t            text (if (str/ends-with? base \".java\")\n   152\t                   (str \"package \" package \";\\n\" text)\n   153\t                   text)\n   154\t            text (reduce (partial apply-patch file)\n   155\t                         text\n   156\t                         (get patches file))]\n   157\t        (spit (io/file gen-in base) text)))\n   158\t    gen-in))\n   159\t\n   160\t\n   161\t(defn- run-antlr!\n   162\t  [{:keys [package grammar]} gen-in]\n   163\t  (let [java-out (io/file build-dir \"java\")\n   164\t        pkg-dir (io/file java-out (str/replace package \".\" \"/\"))]\n   165\t    (delete-tree! java-out)\n   166\t    (.mkdirs pkg-dir)\n   167\t    (let [tool (org.antlr.v4.Tool.\n   168\t                 (into-array String\n   169\t                             (concat [\"-Dlanguage=Java\" \"-package\" package\n   170\t                                      \"-no-listener\" \"-no-visitor\"\n   171\t                                      \"-Xexact-output-dir\" \"-o\"\n   172\t                                      (.getPath pkg-dir) \"-lib\"\n   173\t                                      (.getPath gen-in)]\n   174\t                                     (map #(.getPath (io/file gen-in %))\n   175\t                                          (:generate grammar)))))]\n   176\t      (.processGrammarsOnCommandLine tool)\n   177\t      (when (pos? (.getNumErrors tool))\n   178\t        (throw (ex-info \"ANTLR generation failed\"\n   179\t                        {:errors (.getNumErrors tool)}))))\n   180\t    (doseq [f (.listFiles gen-in)\n   181\t            :when (str/ends-with? (.getName f) \".java\")]\n   182\t      (io/copy f (io/file pkg-dir (.getName f))))\n   183\t    pkg-dir))\n   184\t\n   185\t\n   186\t(defn- generated-digests\n   187\t  [pkg-dir]\n   188\t  (into (sorted-map)\n   189\t        (for [f (.listFiles (io/file pkg-dir))\n   190\t              :when (str/ends-with? (.getName f) \".java\")]\n   191\t          [(.getName f)\n   192\t           (blake3 (java.nio.file.Files/readAllBytes (.toPath f)))])))\n   193\t\n   194\t\n   195\t(defn- non-ascii-files\n   196\t  \"§4.5: generated textual sources stay ASCII.\"\n   197\t  [pkg-dir]\n   198\t  (vec (for [f (.listFiles (io/file pkg-dir))\n   199\t             :when (some #(> (int %) 127) (slurp f))]\n   200\t         (.getName f))))\n   201\t\n   202\t\n   203\t(defn- compile-java!\n   204\t  [pkg-dir]\n   205\t  (let [classes (io/file build-dir \"classes\")\n   206\t        compiler (ToolProvider/getSystemJavaCompiler)\n   207\t        sources (sort (map #(.getPath %)\n   208\t                           (filter #(str/ends-with? (.getName %) \".java\")\n   209\t                                   (.listFiles (io/file pkg-dir)))))]\n   210\t    (delete-tree! classes)\n   211\t    (.mkdirs classes)\n   212\t    (when-not compiler\n   213\t      (throw (ex-info \"No system Java compiler (a JDK is required)\" {})))\n   214\t    (let [rc (.run compiler nil nil nil\n   215\t                   (into-array String\n   216\t                               (concat [\"-nowarn\" \"--release\" \"11\" \"-cp\"\n   217\t               