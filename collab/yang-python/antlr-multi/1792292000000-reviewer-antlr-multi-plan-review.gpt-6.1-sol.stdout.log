{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yang/antlr/packet.cljc'","aggregated_output":"     1\t(ns yang.antlr.packet\n     2\t  \"Reading a portable CST packet (docs/design/yang.antlr.md §5.5; the shape\n     3\t   is documented on `yang.antlr.cst`). Portable and language-agnostic:\n     4\t   child edges are data, so the tree is validated before anything walks\n     5\t   it.\")\n     6\t\n     7\t\n     8\t(defn- malformed!\n     9\t  [message data]\n    10\t  (throw (ex-info message\n    11\t                  (merge {:yang.python.antlr/diagnostic\n    12\t                          :yang.python.antlr/malformed-cst}\n    13\t                         data))))\n    14\t\n    15\t\n    16\t(defn validate!\n    17\t  \"Return the packet when its nodes form one tree rooted at 0 with preorder\n    18\t   ids equal to their index and every child referenced exactly once, after\n    19\t   its parent; otherwise throw a qualified malformed-cst error.\"\n    20\t  [packet]\n    21\t  (let [nodes (:yang.cst/nodes packet)\n    22\t        n (count nodes)]\n    23\t    (when-not (and (vector? nodes) (pos? n) (= 0 (:yang.cst/root packet)))\n    24\t      (malformed! \"CST packet has no root\" {}))\n    25\t    (loop [i 0\n    26\t           seen #{}]\n    27\t      (if (< i n)\n    28\t        (let [node (nth nodes i)\n    29\t              kids (:children node)]\n    30\t          (when-not (= i (:id node))\n    31\t            (malformed! \"CST node id is not its index\" {:index i}))\n    32\t          (when-not (contains? #{:rule :token} (:kind node))\n    33\t            (malformed! \"CST node has an unknown kind\" {:id i}))\n    34\t          (doseq [k kids]\n    35\t            (when-not (and (integer? k) (< i k n) (not (contains? seen k)))\n    36\t              (malformed! \"CST child edge is not a tree edge\"\n    37\t                          {:parent i, :child k})))\n    38\t          (recur (inc i) (into seen kids)))\n    39\t        (when-not (= (dec n) (count seen))\n    40\t          (malformed! \"CST has nodes unreachable from the root\"\n    41\t                      {:reachable (count seen), :nodes n}))))\n    42\t    packet))\n    43\t\n    44\t\n    45\t(defn node\n    46\t  [packet id]\n    47\t  (nth (:yang.cst/nodes packet) id))\n    48\t\n    49\t\n    50\t(defn root\n    51\t  [packet]\n    52\t  (node packet (:yang.cst/root packet)))\n    53\t\n    54\t\n    55\t(defn children\n    56\t  [packet n]\n    57\t  (mapv #(node packet %) (:children n)))\n    58\t\n    59\t\n    60\t(defn rule?\n    61\t  ([n] (= :rule (:kind n)))\n    62\t  ([n rule-name] (and (= :rule (:kind n)) (= rule-name (:rule n)))))\n    63\t\n    64\t\n    65\t(defn token?\n    66\t  ([n] (= :token (:kind n)))\n    67\t  ([n text] (and (= :token (:kind n)) (= text (:text n)))))\n    68\t\n    69\t\n    70\t(defn child-rules\n    71\t  \"The rule children of `n` named `rule-name`, in order.\"\n    72\t  [packet n rule-name]\n    73\t  (filterv #(rule? % rule-name) (children packet n)))\n    74\t\n    75\t\n    76\t(defn has-token?\n    77\t  [packet n text]\n    78\t  (boolean (some #(token? % text) (children packet n))))\n","exit_code":0,"status":"completed"}}
