{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/python/antlr/cst_export_test.clj; nl -ba src/clj/yang/python/antlr/parser.clj; sed -n '185,225p' src/cljc/yang/frontend.cljc; cat shadow-cljs.edn; rg -n 'dynamic|type hint|warnings' docs/agents/build-n-test.md docs/design/yang.antlr.md; sed -n '25,110p' bb.edn\"","aggregated_output":"     1\t(ns yang.python.antlr.cst-export-test\n     2\t  \"The parser interpreter: CST packet goldens (rule names, byte spans,\n     3\t   synthetic tokens), syntax errors as records with no nodes, the source\n     4\t   protocol, and chunk invariance.\"\n     5\t  (:require\n     6\t    [clojure.test :refer [deftest is testing]]\n     7\t    [dao.stream :as stream]\n     8\t    [yang.antlr.cst :as cst]\n     9\t    [yang.antlr.packet :as packet]\n    10\t    [yang.python.antlr.parser :as parser]\n    11\t    [yin.vm.test-utils :as tu])\n    12\t  (:import\n    13\t    (yang.python.antlr.gen\n    14\t      Python3Parser)))\n    15\t\n    16\t\n    17\t(defn- shape\n    18\t  \"A packet's nodes as [rule-or-token-type span] pairs in preorder.\"\n    19\t  [pk]\n    20\t  (mapv (fn [n]\n    21\t          (if (= :rule (:kind n))\n    22\t            [(:rule n) (:span n)]\n    23\t            [(:type n) (:text n) (:span n)]))\n    24\t        (:yang.cst/nodes pk)))\n    25\t\n    26\t\n    27\t(deftest golden-assignment-test\n    28\t  (let [pk (parser/parse-source \"x = 1\\n\")]\n    29\t    (is (= :yang.cst/ok (:yang.cst/outcome pk)))\n    30\t    (is (= parser/grammar-id (:yang.cst/grammar pk)))\n    31\t    (is (true? (:yang.cst/complete pk)))\n    32\t    (is (= 0 (:yang.cst/root pk)))\n    33\t    (is (= [[\"file_input\" [0 6]]\n    34\t            [\"stmt\" [0 6]]\n    35\t            [\"simple_stmts\" [0 6]]\n    36\t            [\"simple_stmt\" [0 5]]\n    37\t            [\"expr_stmt\" [0 5]]\n    38\t            [\"testlist_star_expr\" [0 1]]\n    39\t            [\"test\" [0 1]]\n    40\t            [\"or_test\" [0 1]]\n    41\t            [\"and_test\" [0 1]]\n    42\t            [\"not_test\" [0 1]]\n    43\t            [\"comparison\" [0 1]]\n    44\t            [\"expr\" [0 1]]\n    45\t            [\"atom_expr\" [0 1]]\n    46\t            [\"atom\" [0 1]]\n    47\t            [\"name\" [0 1]]\n    48\t            [\"NAME\" \"x\" [0 1]]\n    49\t            [\"ASSIGN\" \"=\" [2 3]]\n    50\t            [\"testlist_star_expr\" [4 5]]\n    51\t            [\"test\" [4 5]]\n    52\t            [\"or_test\" [4 5]]\n    53\t            [\"and_test\" [4 5]]\n    54\t            [\"not_test\" [4 5]]\n    55\t            [\"comparison\" [4 5]]\n    56\t            [\"expr\" [4 5]]\n    57\t            [\"atom_expr\" [4 5]]\n    58\t            [\"atom\" [4 5]]\n    59\t            [\"NUMBER\" \"1\" [4 5]]\n    60\t            [\"NEWLINE\" \"\\n\" [5 6]]\n    61\t            [\"EOF\" \"<EOF>\" [6 6]]]\n    62\t           (shape pk)))\n    63\t    (testing \"ids are preorder indexes and children are ordered edges\"\n    64\t      (is (= (range (count (:yang.cst/nodes pk)))\n    65\t             (map :id (:yang.cst/nodes pk))))\n    66\t      (is (= [5 16 17] (:children (packet/node pk 4))))\n    67\t      (is (some? (packet/validate! pk))))\n    68\t    (testing \"EOF is synthetic and zero-width\"\n    69\t      (is (:synthetic (peek (:yang.cst/nodes pk)))))))\n    70\t\n    71\t\n    72\t(deftest spans-are-utf8-bytes-test\n    73\t  (testing \"a two-byte and a four-byte code point before a token shift its\n    74\t            span by bytes, not characters\"\n    75\t    (let [src \"s = 'é𝄞'\\nt = 2\\n\"\n    76\t          pk (parser/parse-source src)\n    77\t          tok (fn [text] (first (filter #(= text (:text %)) (:yang.cst/nodes pk))))]\n    78\t      (is (= [4 12] (:span (tok \"'é𝄞'\"))))\n    79\t      (is (= [13 14] (:span (tok \"t\"))))\n    80\t      (is (= (cst/utf8-bytes src) (second (:span (packet/root pk))))))))\n    81\t\n    82\t\n    83\t(deftest indentation-tokens-test\n    84\t  (let [pk (parser/parse-source \"if x:\\n    y = 1\\nz = 2\\n\")\n    85\t        toks (filterv #(= :token (:kind %)) (:yang.cst/nodes pk))\n    86\t        by-type (fn [t] (filterv #(= t (:type %)) toks))]\n    87\t    (testing \"INDENT covers the indentation it stands for\"\n    88\t      (is (= [[\"    \" [6 10] nil]]\n    89\t             (mapv (juxt :text :span :synthetic) (by-type \"INDENT\")))))\n    90\t    (testing \"DEDENT is synthetic and zero-width where the dedented line\n    91\t              starts (patched helper)\"\n    92\t      (let [[d] (by-type \"DEDENT\")]\n    93\t        (is (:synthetic d))\n    94\t        (is (= [16 16] (:span d)))))\n    95\t    (testing \"every NEWLINE sits on its newline, including the one before an\n    96\t              INDENT (patched helper)\"\n    97\t      (is (= [[nil [5 6]] [nil [15 16]] [nil [21 22]]]\n    98\t             (mapv (juxt :synthetic :span) (by-type \"NEWLINE\")))))\n    99\t    (testing \"a block's span covers its real text only\"\n   100\t      (let [block (first (filter #(= \"block\" (:rule %)) (:yang.cst/nodes pk)))]\n   101\t        (is (= [5 16] (:span block)))))))\n   102\t\n   103\t\n   104\t(deftest missing-final-newline-test\n   105\t  (testing \"known limitation of the pinned grammar's Java helper: it adds an\n   106\t            end-of-input NEWLINE only while indentation is open, so a\n   107\t            top-level statement without a final newline is a syntax error\n   108\t            record; the source is not silently normalized\"\n   109\t    (let [pk (parser/parse-source \"x = 1\")]\n   110\t      (is (= :yang.cst/syntax-error (:yang.cst/outcome pk))))\n   111\t    (let [pk (parser/parse-source \"if x:\\n    y = 1\")\n   112\t          nl (last (filter #(= \"NEWLINE\" (:type %)) (:yang.cst/nodes pk)))]\n   113\t      (is (= :yang.cst/ok (:yang.cst/outcome pk)))\n   114\t      (is (:synthetic nl))\n   115\t      (is (= [15 15] (:span nl))))))\n   116\t\n   117\t\n   118\t(deftest syntax-errors-are-records-test\n   119\t  (let [pk (parser/parse-source \"def f(:\\n    return 1\\n\")]\n   120\t    (is (= :yang.cst/syntax-error (:yang.cst/outcome pk)))\n   121\t    (is (not (contains? pk :yang.cst/nodes)) \"never a partial program\")\n   122\t    (is (not (contains? pk :yang.cst/root)))\n   123\t    (is (true? (:yang.cst/complete pk)))\n   124\t    (let [[e :as errors] (:yang.cst/errors pk)]\n   125\t      (is (seq errors))\n   126\t      (is (= :syntax-error (:kind e)))\n   127\t      (is (= 1 (:line e)))\n   128\t      (is (= [6 7] (:span e)))\n   129\t      (is (string? (:message e))))))\n   130\t\n   131\t\n   132\t(deftest lexer-errors-are-records-test\n   133\t  (let [pk (parser/parse-source \"x = $\\n\")]\n   134\t    (is (= :yang.cst/syntax-error (:yang.cst/outcome pk)))\n   135\t    (is (= [4 5] (:span (first (:yang.cst/errors pk)))))))\n   136\t\n   137\t\n   138\t(deftest exporter-is-deterministic-test\n   139\t  (let [src \"def f(a):\\n    return [a, {1: 'x'}]\\n\"]\n   140\t    (is (= (parser/parse-source src)\n   141\t           (parser/parse-source (parser/make-worker) [:unit 0] src)))))\n   142\t\n   143\t\n   144\t(deftest every-grammar-rule-name-is-exported-by-name-test\n   145\t  (testing \"rule records use the grammar's rule names\"\n   146\t    (let [names (set (seq Python3Parser/ruleNames))\n   147\t          pk (parser/parse-source\n   148\t               \"class A(B):\\n    def m(self, *a):\\n        while x: pass\\n\")]\n   149\t      (is (every? #(contains? names (:rule %))\n   150\t                  (filter #(= :rule (:kind %)) (:yang.cst/nodes pk)))))))\n   151\t\n   152\t\n   153\t;; =============================================================================\n   154\t;; The stage: source events in, packets out\n   155\t;; =============================================================================\n   156\t\n   157\t(defn- chunks\n   158\t  \"Split `src` at the given character offsets.\"\n   159\t  [src cuts]\n   160\t  (let [bounds (concat [0] cuts [(count src)])]\n   161\t    (mapv (fn [[a b]] (subs src a b)) (partition 2 1 bounds))))\n   162\t\n   163\t\n   164\t(defn- source-events\n   165\t  [unit texts]\n   166\t  (conj (vec (map-indexed (fn [i t]\n   167\t                            {:yang.source/event :yang.source/chunk,\n   168\t                             :yang.source/unit unit,\n   169\t                             :yang.source/ordinal i,\n   170\t                             :yang.source/text t})\n   171\t                          texts))\n   172\t        {:yang.source/event :yang.source/seal,\n   173\t         :yang.source/unit unit,\n   174\t         :yang.source/chunk-count (count texts)}))\n   175\t\n   176\t\n   177\t(defn- run-parser\n   178\t  [events]\n   179\t  (let [src (tu/new-memory-log)\n   180\t        out (tu/new-memory-log)]\n   181\t    (doseq [e events] (stream/append! src e))\n   182\t    (let [s (parser/step-stage (parser/open-stage src out))]\n   183\t      {:stage s, :packets (tu/drain out)})))\n   184\t\n   185\t\n   186\t(deftest stage-emits-one-packet-per-sealed-unit-test\n   187\t  (let [{:keys [stage packets]}\n   188\t        (run-parser (concat (source-events [:u 1] [\"x = 1\\n\"])\n   189\t                            (source-events [:u 2] [\"def f(:\\n\"])))]\n   190\t    (is (= :blocked (:status stage)))\n   191\t    (is (= [[:u 1] [:u 2]] (mapv :yang.cst/unit packets)))\n   192\t    (is (= [:yang.cst/ok :yang.cst/syntax-error]\n   193\t           (mapv :yang.cst/outcome packets)))\n   194\t    (is (= {} (:state stage)) \"sealed units leave no state behind\")))\n   195\t\n   196\t\n   197\t(deftest stage-waits-for-the-seal-test\n   198\t  (let [{:keys [stage packets]}\n   199\t        (run-parser (butlast (source-events [:u 1] [\"x = 1\\n\"])))]\n   200\t    (is (empty? packets))\n   201\t    (is (= {[:u 1] {0 \"x = 1\\n\"}} (:state stage)))))\n   202\t\n   203\t\n   204\t(deftest source-protocol-errors-test\n   205\t  (testing \"a seal with a missing chunk\"\n   206\t    (let [[chunk0 _chunk1 seal] (source-events [:u 1] [\"x = \" \"1\\n\"])\n   207\t          {:keys [packets]} (run-parser [chunk0 seal])]\n   208\t      (is (= :yang.cst/source-error (:yang.cst/outcome (first packets))))\n   209\t      (is (not (contains? (first packets) :yang.cst/nodes)))))\n   210\t  (testing \"a conflicting duplicate chunk\"\n   211\t    (let [[chunk0 _ seal] (source-events [:u 1] [\"x = \" \"1\\n\"])\n   212\t          {:keys [packets]}\n   213\t          (run-parser [chunk0 (assoc chunk0 :yang.source/text \"y = \") seal])]\n   214\t      (is (= :yang.cst/source-error (:yang.cst/outcome (first packets)))))))\n   215\t\n   216\t\n   217\t(deftest chunk-invariance-test\n   218\t  (let [src \"def f(a):\\n    s = 'é'\\n    return a\\nprint(f(1))\\n\"\n   219\t        splits [[] [1] [5 6 7] [10 11 12 13] (vec (range 1 (count src)))]\n   220\t        packets (mapv (fn [cuts]\n   221\t                        (first (:packets (run-parser\n   222\t                                           (source-events [:u 1]\n   223\t                                                          (chunks src cuts))))))\n   224\t                      splits)]\n   225\t    (is (= :yang.cst/ok (:yang.cst/outcome (first packets))))\n   226\t    (is (apply = packets))\n   227\t    (is (= (first packets) (parser/parse-source (parser/make-worker) [:u 1] src)))))\n     1\t(ns yang.python.antlr.parser\n     2\t  \"The Python parser interpreter (JVM host): the grammars-v4 Python3 grammar\n     3\t   profile plus the stage that reads sealed source units from one stream and\n     4\t   writes CST packets to another. The generated recognizers come from\n     5\t   `clj -M:antlr-gen` (antlr/python3/manifest.edn); this is the only\n     6\t   namespace that names them.\"\n     7\t  (:require\n     8\t    [yang.antlr.cst :as cst]\n     9\t    [yang.stage :as stage])\n    10\t  (:import\n    11\t    (yang.python.antlr.gen\n    12\t      Python3Lexer\n    13\t      Python3Parser)))\n    14\t\n    15\t\n    16\t(def grammar-id\n    17\t  \"grammars-v4 python/python3 at its pinned revision, generated by ANTLR 4.13.2.\"\n    18\t  \"grammars-v4/python/python3@8af0d4c26c796ea27c15c3d85418f2d0f77c3adb antlr-4.13.2\")\n    19\t\n    20\t\n    21\t(def profile\n    22\t  {:grammar-id grammar-id,\n    23\t   :make-lexer (fn [cs] (Python3Lexer. cs)),\n    24\t   :make-parser (fn [ts] (Python3Parser. ts)),\n    25\t   :start (fn [^Python3Parser p] (.file_input p))})\n    26\t\n    27\t\n    28\t(defn make-worker\n    29\t  []\n    30\t  (cst/make-worker profile))\n    31\t\n    32\t\n    33\t(defn parse-source\n    34\t  \"Parse one complete source string as unit `unit`: the packet a sealed unit\n    35\t   with this text produces.\"\n    36\t  ([source] (parse-source (make-worker) [:unit 0] source))\n    37\t  ([worker unit source] (cst/parse-unit worker unit source)))\n    38\t\n    39\t\n    40\t(defn open-stage\n    41\t  \"A parser stage reading source events from `source-stream` and writing\n    42\t   CST packets to `cst-stream`, with its own worker.\"\n    43\t  [source-stream cst-stream]\n    44\t  (assoc (stage/open source-stream {:cst cst-stream} {})\n    45\t         ::transform (cst/parse-transform (make-worker))))\n    46\t\n    47\t\n    48\t(defn step-stage\n    49\t  [s]\n    50\t  (stage/step s (::transform s)))\n  \"The installed revisions of frontend `id`, sorted.\"\n  [catalog id]\n  (->> (keys (:yang.frontend/entries catalog))\n       (keep (fn [[i r]] (when (= i id) r)))\n       sort\n       vec))\n\n\n(defn select\n  \"Select an installed frontend by `request`: `:yang.frontend/id`, and\n   optionally `:yang.frontend/revision` and any other manifest key\n   section 3.7 pins (SPI, language, grammar, profiles). Answers\n   `{:status :ok, :manifest m, :binding b}`, or a refusal:\n   `:yang.frontend/unknown` when no revision of the id (or the named\n   revision) is installed, `:yang.frontend/incompatible` when installed\n   candidates exist but none matches the pins, and\n   `:yang.frontend/ambiguous` with the matching `:revisions` when more\n   than one matches: the catalog never silently chooses (section 3.3).\"\n  [catalog request]\n  (let [id (:yang.frontend/id request)\n        revision (:yang.frontend/revision request)\n        pins (dissoc request :yang.frontend/id :yang.frontend/revision)\n        candidates (cond->> (revisions catalog id)\n                     revision (filter #{revision}))\n        matching (filter (fn [r]\n                           (let [m (get-in catalog\n                                           [:yang.frontend/entries [id r]\n                                            :manifest])]\n                             (= pins (select-keys m (keys pins)))))\n                         candidates)]\n    (cond (empty? candidates)\n          (refused :yang.frontend/unknown {:id id, :revision revision})\n          (empty? matching)\n          (refused :yang.frontend/incompatible\n                   {:id id, :revisions (vec candidates), :pins pins})\n          (next matching)\n          (refused :yang.frontend/ambiguous {:id id, :revisions (vec matching)})\n          :else (let [k [id (first matching)]]\n                  (merge {:status :ok}\n                         (get-in catalog [:yang.frontend/entries k]))))))\n;; shadow-cljs configuration\n;; Source paths come from deps.edn (:paths plus the :cljs alias's\n;; :extra-paths); shadow ignores any :source-paths set here when :deps\n;; is used.\n{:deps {:aliases [:cljs]}\n\n :dev-http {9000 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl.main/-main\n                        :output-to \"target/yin-repl.js\"}}}\ndocs/agents/build-n-test.md:91:dao.stream, codecs) and before a big merge. Not seen: dynamic loads\ndocs/design/yang.antlr.md:1192:| Prototype / dynamic    | Closures plus store cells  | JavaScript       |\ndocs/design/yang.antlr.md:1235:### 8.5 Dynamic: Python, indentation and dynamic values\ndocs/design/yang.antlr.md:1237:Python is dynamically typed, but ordinary name resolution is based on\ndocs/design/yang.antlr.md:1239:generally dynamically scoped. Whole-block binding analysis is needed to\ndocs/design/yang.antlr.md:1395:   un-boxing interpreter can later recover static reads where no dynamic\ndocs/design/yang.antlr.md:1622:Depth, handlers, and the current frame form one dynamic-context record\ndocs/design/yang.antlr.md:1651:dynamic-context record, the limit cell `py.rt/limit` (1000 by default)\ndocs/design/yang.antlr.md:1708:order: recursion (the dynamic-context record, the `:return` wrap,\ndocs/design/yang.antlr.md:1919:per-thread dynamic state (the frame-record stack, the recursion counter,\ndocs/design/yang.antlr.md:1932:| S2     | `send`, `throw`, `close`, and the dynamic context: `GeneratorExit`, |\ndocs/design/yang.antlr.md:2790:|                           | name; dynamic forms get an explicit diagnostic.  |\ndocs/design/yang.antlr.md:3324:The existing frontend's ignored type hints and limited closure handling\ndocs/design/yang.antlr.md:3390:checking, and Ruby dynamic dispatch are plugin-owned stages. Each has\ndocs/design/yang.antlr.md:3440:|                                |                   | entries. Dicts with dynamic keys need a container anyway.      |\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:python-antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:python-antlr]\n                :task (shell \"clojure -M:test\")}\n\n  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-node]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-peer]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Only the slow tests. Node and Dart select by namespace, so the other\n  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.\n  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\n                 :depends [build:yin-repl-node gen:python-antlr]\n                 :task (shell \"clojure -M:test -i :slow\")}\n\n  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-node]\n                  :task (let [re (-> (shell {:out :string}\n                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\n                                     :out\n                                     clojure.string/trim)]\n                          (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                                 \"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                                 \"compile\" \"test\" \"--config-merge\"\n                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\n\n  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-peer]\n                  :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                               \"bb src/dev/cljd_agg.clj --slow-only\")}\n\n  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\n             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\n\n  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\n            :depends [test:all:clj test:all:cljs test:all:cljd]}\n\n  test {:doc \"All three lanes in their fast default form (JVM, Node, Dart)\"\n        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n\n  ;; Only the tests a change can affect (src/dev/affected.clj): the\n  ;; reverse require closure of the changed files since the merge-base\n  ;; with master. Extra args pass through (--base REF, --changed FILE...).\n  ;; Exit 2 on a wide change (deps.edn, bb.edn, src/dev/, ...): run bb test.\n  test:changed {:doc \"Fast tests a change can affect, three lanes in parallel\"\n                :task (System/exit\n                        (:exit (apply shell {:continue true}\n                                      \"bb\" \"src/dev/affected.clj\"\n                                      *command-line-args*)))}\n\n  test:changed:clj {:doc \"JVM lane of test:changed\"\n                    :task (System/exit\n                            (:exit (apply shell {:continue true}\n                                          \"bb\" \"src/dev/affected.clj\"\n                                          \"--lane\" \"clj\" *command-line-args*)))}\n\n  test:changed:cljs {:doc \"Node lane of test:changed\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--lane\" \"cljs\"\n                                           *command-line-args*)))}\n\n  test:changed:cljd {:doc \"Dart lane of test:changed\"\n                     :task (System/exit\n","exit_code":0,"status":"completed"}}
