    CommonToken dedent = positionedToken(Python3Lexer.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);\n    63\t        dedent.setLine(this.lastToken.getLine());\n    64\t        return dedent;\n    65\t    }\n    66\t\n    67\t    private CommonToken positionedToken(int type, int start, int stop) {\n    68\t        return new CommonToken(this._tokenFactorySourcePair, type, DEFAULT_TOKEN_CHANNEL, start, stop);\n    69\t    }\n    70\t\n    71\t    private CommonToken commonToken(int type, String text) {\n    72\t        int stop = this.getCharIndex() - 1;\n    73\t        int start = text.isEmpty() ? stop : stop - text.length() + 1;\n    74\t        return new CommonToken(this._tokenFactorySourcePair, type, DEFAULT_TOKEN_CHANNEL, start, stop);\n    75\t    }\n    76\t\n    77\t    // Calculates the indentation of the provided spaces, taking the\n    78\t    // following rules into account:\n    79\t    //\n    80\t    // \"Tabs are replaced (from left to right) by one to eight spaces\n    81\t    //  such that the total number of characters up to and including\n    82\t    //  the replacement is a multiple of eight [...]\"\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-CWx0rx08' (errno=Operation not permitted)\n2026-10-17 20:05:39.991 xcodebuild[52565:70808744]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-17 20:05:40.289 xcodebuild[52565:70808742] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-JQ3fJAz2' (errno=Operation not permitted)\n2026-10-17 20:05:40.902 xcodebuild[52574:70808786]  DVTFilePathFSEvents: Failed to start fs ev