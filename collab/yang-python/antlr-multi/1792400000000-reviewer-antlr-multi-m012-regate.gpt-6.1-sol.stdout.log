ax (map second real))]))\n-        (note! (:id n) :rule-span-not-children))\n-      (when (and (empty? real) (not= a b))\n-        (note! (:id n) :empty-rule-not-zero-width)))\n-    @bad))\n+  \"Check a packet against its `source` text; return a vector of violations\n+   (empty when it conforms): the structure, then spans on UTF-8 boundaries,\n+   token text equal to the source, synthetic tokens only where the policy\n+   allows, ordered terminals and rule extents over real children.\"\n+  ([packet source] (conform packet source nil))\n+  ([packet source opts] (violations packet (assoc opts :source source))))\ndiff --git a/test/yang/antlr/conformance.cljc b/test/yang/antlr/conformance.cljc\nindex 7cabe630..42a3d4f7 100644\n--- a/test/yang/antlr/conformance.cljc\n+++ b/test/yang/antlr/conformance.cljc\n@@ -10,12 +10,14 @@\n \n \n (defn shape\n-  \"A packet's nodes as [rule span] and [type text span] entries in preorder.\"\n+  \"A packet's nodes in preorder: [rule span children] for a rule and\n+   [type text span synthetic?] for a token. The child edges and the synthetic\n+   flags are part of the shape, so a tree that differs only in them differs.\"\n   [pk]\n   (mapv (fn [n]\n           (if (= :rule (:kind n))\n-            [(:rule n) (:span n)]\n-            [(:type n) (:text n) (:span n)]))\n+            [(:rule n) (:span n) (:children n)]\n+            [(:type n) (:text n) (:span n) (boolean (:synthetic n))]))\n         (:yang.cst/nodes pk)))\n \n \n@@ -26,7 +28,7 @@\n   ([parse source expected]\n    (let [pk (parse source)]\n      (is (= :yang.cst/ok (:yang.cst/outcome pk)) source)\n-     (is (some? (packet/validate! pk)) source)\n+     (is (some? (packet/validate! pk {:source source})) source)\n      (is (= [] (packet/conform pk source)) source)\n      (when expected\n        (is (= expected (shape pk)) source))\n@@ -34,9 +36,11 @@\n \n \n (defn check-error\n-  \"`source` yields a syntax-error packet with no nodes whose first error has\n-   the given `line` an