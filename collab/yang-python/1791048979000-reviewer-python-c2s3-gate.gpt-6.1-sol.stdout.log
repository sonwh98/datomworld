ent '\"\n   660\t                                   nm \"'\"))\n   661\t                 (py/fill-kwdefaults fc (assoc slots i d) names (+ i 1))))\n   662\t             (py/fill-kwdefaults fc slots names (+ i 1))))))]\n   663\t    [py/bind-args\n   664\t     ;; positional, then keywords, then defaults; every failure a TypeError\n   665\t     (fn [fc args kwargs]\n   666\t       (let [spec (get fc :spec)\n   667\t             n (data/count (get spec :params))\n   668\t             given (data/count args)\n   669\t             star (get spec :star?)]\n   670\t         (if (if (get spec :no-kw) (< 0 (data/count kwargs)) false)\n   671\t           (py/fn-error fc \"() takes no keyword arguments\")\n   672\t           (if (if (< n given) (not star) false)\n   673\t             (py/fn-error fc \"() takes too many positional arguments\")\n   674\t             (let [state (py/bind-keywords\n   675\t                           fc\n   676\t                           (py/conj (py/conj (py/conj [] (py/pad args n 0 []))\n   677\t                                             (py/pad [] (data/count (get spec :kwonly)) 0 []))\n   678\t                                    (if (get spec :kwstar?) (py/dict-new) nil))\n   865\t         (if (py/numeric? b)\n   866\t           (op (py/num a) (py/num b))\n   867\t           (py/type-error {:py/str \"comparison not supported\"}))\n   868\t         (py/type-error {:py/str \"comparison not supported\"})))]\n   869\t    [py/kind\n   870\t     ;; the type tag of any guest value that carries one\n   871\t     (fn [x] (if (py/cell? x) (get (cell/get x) :py/type) (get x :py/type)))]\n   872\t    [py/add\n   873\t     (fn [a b]\n   874\t       (if (py/str? a)\n   875\t         (if (py/str? b)\n   876\t           (py/str (data/str-concat (get a :py/str) (get b :py/str)))\n   877\t           (py/type-error {:py/str \"can only concatenate str to str\"}))\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp i