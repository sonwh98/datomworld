"""C4 I2 oracle: lay out the I2 test modules under target/c4i2-oracle, run
each main with python3 (script dir on sys.path), print sys.version and
each main's stdout and last stderr line. Run from the worktree root:
python3 -I collab/<this file>.

The module sources are the ones import_programs holds, except that `nf`
also deletes its __file__ here: our modules never have one, and CPython's
"cannot import name" text then says "(unknown location)". `nf.sub` is not
laid out: CPython would auto-import it, which C4 refuses (ruling 13); the
oracle measures the text of the failed lookup."""
import os
import subprocess
import sys

ROOT = os.path.abspath("target/c4i2-oracle")

MODULES = {
    "a/__init__.py": 'print("a-body")\nv = 1\n',
    "a/b/__init__.py": 'print("a.b-body")\nw = 2\n',
    "a/b/c.py": ('print("a.b.c-body")\nfrom . import w\nfrom .. import v\n'
                 'from .d import y\nprint(__name__, __package__, w, v, y)\n'
                 'try:\n    from ... import z\nexcept ImportError as e:\n'
                 '    print(e.args[0])\n'),
    "a/b/d.py": 'y = 3\n',
    "g.py": ('print("g-body")\ntry:\n    from . import x\n'
             'except ImportError as e:\n    print(e.args[0])\n'
             'print(__name__, repr(__package__))\n'),
    "sx.py": 'p = 1\nq = 2\n_h = 3\n',
    "sy.py": '__all__ = ["r"]\nr = 4\nu = 5\n',
    "nf/__init__.py": 'print("nf-body")\n' + 'del __file__\n',
}

MAINS = {
    "dotted": ('import a.b.c\nimport a.b.c\nprint(a.b.c.__name__)\n'
               'print(a.b.__package__, a.__package__, a.b.c.__package__)\n'
               'print(a.b.d.y)\n'),
    "packageless": ('try:\n    from . import x\nexcept ImportError as e:\n'
                    '    print(e.args[0])\n'
                    'try:\n    from .m import y\nexcept ImportError as e:\n'
                    '    print(e.args[0])\n'
                    'try:\n    from .. import z\nexcept ImportError as e:\n'
                    '    print(e.args[0])\nprint("after", repr(__package__))\n'),
    "nosub": ('import nf\ntry:\n    from nf import sub\n'
              'except ImportError as e:\n    print(e.args[0])\n'
              'try:\n    from nf import zz\nexcept ImportError as e:\n'
              '    print(e.args[0])\n'),
    "forms": ('import a.b as x\nprint(x.__name__)\n'
              'from a.b import w as ww\nprint(ww)\n'
              'from a import b\nprint(b.__name__)\n'
              'import a\ndel a.b\nfrom a import b as bb\n'
              'print(bb.__name__)\n'
              'import g\nprint(g.__package__ == "")\n'),
    "star": ('from sx import *\nprint(p, q)\ntry:\n    print(_h)\n'
             'except NameError as e:\n    print(e.args[0])\n'
             'from sy import *\nprint(r)\ntry:\n    print(u)\n'
             'except NameError as e:\n    print(e.args[0])\n'),
    "starfn": 'def f():\n    from sx import *\n',
}

for rel, src in MODULES.items():
    path = os.path.join(ROOT, rel)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(src)
for name, src in MAINS.items():
    with open(os.path.join(ROOT, "main_" + name + ".py"), "w") as f:
        f.write(src)

print(sys.version)
for name in MAINS:
