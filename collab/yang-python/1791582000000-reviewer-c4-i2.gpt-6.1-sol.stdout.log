(defn- unsupported!
  [n construct]
  (throw (ex-info (str "Unsupported Python construct: " construct)
                  {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,
                   :rule (:rule n),
                   :construct construct,
                   :span (:span n)})))


(defn- syntax!
  [n message]
  (throw (ex-info message
                  {:yang.python.antlr/diagnostic :yang.python.antlr/syntax,
                   :rule (:rule n),
                   :span (:span n)})))


