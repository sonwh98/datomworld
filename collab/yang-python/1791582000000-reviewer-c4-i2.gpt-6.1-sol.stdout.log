;; Prints import_programs-style defs for the I2 sources: each packet the
;; JVM parser's for its source, as the nested form `packet` rebuilds.
;; Run: clojure -M:test -i collab/1791580000000-engineer-c4-i2.gen-packets.clj
(require '[clojure.pprint :as pp]
         '[yang.python.antlr.parser :as parser])

(defn form-of
  [pk]
  (let [nodes (:yang.cst/nodes pk)]
    (letfn [(walk [id]
              (let [n (nth nodes id)]
                (if (= :token (:kind n))
                  [(:type n) (:text n)]
                  (into [(keyword (:rule n))] (map walk) (:children n)))))]
      (walk (:yang.cst/root pk)))))

(def sources
  [["i2-a-packet" "print(\"a-body\")\nv = 1\n"]
   ["i2-ab-packet" "print(\"a.b-body\")\nw = 2\n"]
   ["i2-abc-packet"
    (str "print(\"a.b.c-body\")\nfrom . import w\nfrom .. import v\n"
         "from .d import y\nprint(__name__, __package__, w, v, y)\n"
         "try:\n    from ... import z\nexcept ImportError as e:\n"
         "    print(e.args[0])\n")]
   ["i2-abd-packet" "y = 3\n"]
   ["i2-g-packet"
    (str "print(\"g-body\")\ntry:\n    from . import x\n"
         "except ImportError as e:\n    print(e.args[0])\n"
         "print(__name__, repr(__package__))\n")]
   ["i2-sx-packet" "p = 1\nq = 2\n_h = 3\n"]
