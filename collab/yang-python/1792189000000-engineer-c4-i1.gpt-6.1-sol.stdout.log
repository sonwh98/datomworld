rs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D [:refs :run] [:refs :ready]]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n40:   definition while loading, so it allocates only a cell and a cursor, and\n41:   the hooks name base keys only inside their bodies. `module-uast` is the\n42:   same definition list as the linker module `pysp`, which requires `py`,\n46:   wrapper passes the stream's reference to `(pysp/attach! signals)`,\n91:(def function-definitions\n92:  \"The single definition list, `[store-key form]` in definition order:\n93:   every hook function, then `attach!`. Defining them runs nothing. Both\n148:    [py.sp/attach!\n152:     ;; install-time state. Idempotent, like `py/init!`\n154:       (if (= py.sp/cursor :py/uninit)\n161:(def ^:private state-definitions\n168:(defn- definitions->uast\n175:  (u/mark-tails (u/then (definitions->uast function-definitions)\n176:                        (definitions->uast state-definitions))))\n181:  (u/mark-tails (definitions->uast '[[py.sp/loop (fn [] :py/None)]\n194:  \"The linked safepointed run's tree: `py` required and initialized, `pysp`\n197:   init are idempotent re-entries. The load order is the linked one, the\n204:       (u/sexp->uast '(py/init!))\n205:       (u/app (u/v (symbol (name module-name) \"attach!\")) (u/v signals-key))\n210:;; The module emitter: the same definition list as the linker module `pysp`\n214:  \"Every key `pysp/attach!` defines, sorted: the handler cell and the\n216:   time by a `:py/uninit` placeholder so the linker's scanners discharge\n234:   definition keys and quoted keys alike. Keywords, strings and the\n240:(def ^:private module-definitions\n241:  \"The module's definition list: a `:py/uninit` placeholder for every\n243:   module-level definition, then every definition, stripped.\"\n244:  (into (mapv (fn [k] [(strip k) :py/uninit]) runtime-keys)\n246:        function-definitions))\n249:(def module-uast\n250:  \"The module tree: one application whose operands are the definitions,\n251:   in order, applied to a lambda that returns nil. Every definition runs\n254:   key; a `then` chain would leave every definition but the first inside\n257:                    module-definitions)\n263:  \"The module's exports: every `py.sp/` key of the definition list,\n266:             function-definitions)))\n274:                (remove (conj (prelude/defined-keys module-uast) 'yin/def)\n275:                        (prelude/free-names module-uast)))))\n292:   :ast module-uast,\nc3-fast.log\nc3-slow.log\ndht-slow.log\nfloat-fast.log\nfloat-slow.log\nimport-fast.log\nimport-slow.log\nremint.clj\nremint.log\n{:tasks\n {gen:python-antlr\n  {:doc \"Generate and compile the pinned grammars-v4 Python3 parser into build/antlr/python3/classes (antlr/python3/manifest.edn)\"\n   :task (shell \"clojure -M:antlr-gen\")}\n\n  build:yin-repl-node\n  {:doc \"Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js\"\n   ;; yin.repl.dht-process-test spawns it as the JVM-to-Node reader of\n   ;; DHT epic S5, a required leg: a missing build fails that test.\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl\")}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; Process B of the R5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM\n   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n   ;; `bb test:cljs` without it skips those tests with a printed notice\n   ;; rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:python-antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:python-antlr]\n                :task (shell \"clojure -M:test\")}\n\n  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-node]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-peer]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Only the slow tests. Node and Dart select by namespace, so the other\n  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.\n  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\n                 :depends [build:yin-repl-node gen:python-antlr]\n                 :task (shell \"clojure -M:test -i :slow\")}\n\n  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-node]\n                  :task (let [re (-> (shell {:out :string}\n                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\n                                     :out\n                                     clojure.string/trim)]\n                          (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                                 \"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                                 \"compile\" \"test\" \"--config-merge\"\n                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\n\n  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-peer]\n                  :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                               \"bb src/dev/cljd_agg.clj --slow-only\")}\n\n  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\n             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\n\n  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\n            :depends [test:all:clj test:all:cljs test:all:cljd]}\n\n  test {:doc \"All three lanes in their fast default form (JVM, Node, Dart)\"\n        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n\n  ;; Only the tests a change can affect (src/dev/affected.clj): the\n  ;; reverse require closure of the changed files since the merge-base\n  ;; with master. Extra args pass through (--base REF, --changed FILE...).\n  ;; Exit 2 on a wide change (deps.edn, bb.edn, src/dev/, ...): run bb test.\n  test:changed {:doc \"Fast tests a change can affect, three lanes in parallel\"\n                :task (System/exit\n                        (:exit (apply shell {:continue true}\n                                      \"bb\" \"src/dev/affected.clj\"\n                                      *command-line-args*)))}\n\n  test:changed:clj {:doc \"JVM lane of test:changed\"\n                    :task (System/exit\n                            (:exit (apply shell {:continue true}\n                                          \"bb\" \"src/dev/affected.clj\"\n                                          \"--lane\" \"clj\" *command-line-args*)))}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '155,210p' src/cljc/yang/python/antlr/safepoint.cljc; sed -n '210,310p' test/yang/python/antlr/linked_safepoint_test.cljc; sed -n '1,35p' test/yang/python/antlr/linked_prelude_test.cljc; rg -n '\\\\[py/(builtin|modules|global)' src/cljc/yang/python/antlr/prelude.cljc; cat target/c4-i6-pins/remint.clj; sed -n '170,215p' test/yang/python/antlr/linked_harness.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '155,210p' src/cljc/yang/python/antlr/safepoint.cljc; sed -n '210,310p' test/yang/python/antlr/linked_safepoint_test.cljc; sed -n '1,35p' test/yang/python/antlr/linked_prelude_test.cljc; rg -n '\\\\[py/(builtin|modules|global)' src/cljc/yang/python/antlr/prelude.cljc; cat target/c4-i6-pins/remint.clj; sed -n '170,215p' test/yang/python/antlr/linked_harness.cljc\"","aggregated_output":"         (do (yin/def (quote py.sp/handler) (cell/new :py/None))\n             (yin/def (quote py.sp/cursor) (stream/cursor signals))\n             :py/None)\n         :py/None))]])\n\n\n(def ^:private state-definitions\n  \"The bundled profile's runtime state, allocated while loading: a cell\n   and a cursor, nothing else.\"\n  '[[py.sp/handler (cell/new :py/None)]\n    [py.sp/cursor (stream/cursor py.sp/signals)]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(def uast\n  \"The bundled hook prelude: functions, then its cells and the signal cursor.\"\n  (u/mark-tails (u/then (definitions->uast function-definitions)\n                        (definitions->uast state-definitions))))\n\n\n(def noop-uast\n  \"Hooks that do nothing: the derived program under them is the naive one.\"\n  (u/mark-tails (definitions->uast '[[py.sp/loop (fn [] :py/None)]\n                                     [py.sp/call (fn [] :py/None)]\n                                     [py.sp/return (fn [v] v)]])))\n\n\n(defn program\n  \"The bundled derived run's tree: `hooks` (a hook prelude), then the derived\n   program `ast`.\"\n  [hooks ast]\n  (u/then hooks ast))\n\n\n(defn linked-program\n  \"The linked safepointed run's tree: `py` required and initialized, `pysp`\n   required, the signal stream the composition bound under `signals-key`\n   attached, then the derived linked program `a'`, whose own require and\n   init are idempotent re-entries. The load order is the linked one, the\n   inverse of the bundled hook-prelude-first order.\"\n  [a']\n  (u/mark-tails\n    (u/seq-nodes\n      [(u/sexp->uast (list 'require (list 'quote prelude/module-name)))\n       (u/sexp->uast (list 'require (list 'quote module-name)))\n       (u/sexp->uast '(py/init!))\n       (u/app (u/v (symbol (name module-name) \"attach!\")) (u/v signals-key))\n       a'])))\n\n\n;; =============================================================================\n;; The module emitter: the same definition list as the linker module `pysp`\n    (is (= hooks/module-exports (:exports spec)))\n    (testing \"the pinned requirement is py at its manifest address\"\n      (is (= {'py py-address} (:requires spec))))\n    (testing \"a py-qualified free name is never a primitive declaration:\n              the requirement covers it\"\n      (is (empty? (filter #(= \"py\" (namespace %))\n                          (keys (:primitives spec))))))\n    (testing \"the qualified declarations are exactly the host names\"\n      (is (= hooks/host-names\n             (set (filter namespace (keys (:primitives spec)))))))\n    (testing \"a host export is declared by its registry profile and effects\"\n      (is (every? #(and (contains? % :yin.k/profile)\n                        (contains? % :yin.k/effects))\n                  (keep #(get-in spec [:primitives %])\n                        (filter namespace (keys (:primitives spec))))))))\n  (testing \"a free name no registry module or primitive supplies is refused\n            before anything is published\"\n    (let [no-cell (-> (module/empty-registry)\n                      (data/register-data-module {::data/max-items 1048576})\n                      (prelude/register-integer-module h/integer-limits))\n          refusal (refusal-of #(hooks/module-spec no-cell py-address))]\n      (is (= :yang.python.antlr/undeclared-free\n             (:yang.python.antlr/refusal refusal)))\n      (is (= \"cell\" (namespace (:name refusal)))))))\n\n\n;; =============================================================================\n;; A1. `pysp` publishes to one pinned manifest address\n;; =============================================================================\n\n(def ^:private pysp-manifest-golden\n  \"I1, I2 and I3 each moved this once: the pinned `py` requirement is\n   py's own manifest address, which each slice's prelude change moved,\n   and the BLAKE3 profile digest of 492ff50b moved again. Phase 8ab\n   regenerates H/R and the pinned py requirement. The I4-a rebase moves\n   the pinned py requirement again for statement-time import delivery.\n   I6's reload runtime moves it once more (the hook prelude joins the\n   move; both hosts mint fbd90016).\"\n  (keyword (str \"segment/blake3-\"\n                \"fbd90016c267ff000f2c7e940ffa850fae3c6392c59ccfcbb92869e8fc2b29b8\")))\n\n\n(defn- pysp-manifest-address\n  []\n  (let [{:keys [store result address]} @h/published-pysp\n        links (:links result)]\n    (testing \"one address on every host (JVM golden)\"\n      (is (= pysp-manifest-golden address) (pr-str (dissoc result :links))))\n    (testing \"the three vector formats link :ok under :verifying\"\n      (doseq [f [:yin.semantic/code :yin.debruijn.code\n                 :yin.debruijn.register]]\n        (is (= :ok (get-in links [f :status])) (str f))))\n    (testing \"publishing twice into one store answers one address\"\n      (is (= address\n             (:address (publish/publish-module!\n                         store (hooks/module-spec (h/registry)\n                                                  (:address @h/published)))))))))\n\n\n(deftest ^:slow pysp-manifest-address-test\n  (slow/guard \"pysp-manifest-address-test\" pysp-manifest-address))\n\n\n;; =============================================================================\n;; Running A' linked\n;; =============================================================================\n\n(defn- outcome\n  \"A finished run as `[halted? blocked? rendered-value]`.\"\n  [task]\n  [(vm/halted? task) (vm/blocked? task) (render/output (vm/value task))])\n\n\n(defn- with-signals\n  \"A linked `prep` handing the task a signal stream holding `signals`.\"\n  [signals]\n  (fn [task]\n    (let [handle (tu/new-stream 8)]\n      (doseq [s signals] (stream/append! handle s))\n      (let [[ref task] (engine/attach-resource task handle)]\n        (assoc-in task [:store hooks/signals-key] ref)))))\n\n\n(defn- derived-ast\n  \"`A'` for `pk` under the linked profile.\"\n  [pk]\n  (vm/semantic-bytecode->ast\n    (tree-of (:derived (derive* pk hooks/linked-profile)))))\n\n\n(defn- on-every-vm\n  \"Every vector VM's outcome for `ast` under `signals`, or the throw; the\n   composition serves both modules.\"\n  ([ast] (on-every-vm ast []))\n  ([ast signals]\n   (into {}\n         (map (fn [k]\n                [k (try (outcome (h/run-linked\n                                   k ast\n                                   {:link-source (h/safepoint-source),\n                                    :prep (with-signals signals)}))\n(ns yang.python.antlr.linked-prelude-test\n  \"C4 slice P2 (docs/design/yang.antlr.md 8.5.6): the Python runtime\n   profile as the linker module `py`. The module emitter derives one\n   module tree, its exports and its publication spec from the single\n   definition list; the spec declares every free name of the tree, the\n   host exports by profile address; the AST walker's link stays refused\n   until L-b. The published module and the linked runs are\n   `yang.python.antlr.linked-harness`'s: one publication per process,\n   served `:trusted`, so every test that publishes or links is slow.\n\n   Cross-unit exception identity is tested in prelude notation over two\n   units of one task: until I1 Python source has no channel that carries\n   a value from one unit to another, so the Python-source form is I1's.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.jing.mem :as mem]\n    [dao.test-slow :as slow]\n    [yang.python.antlr.linked-harness :as h]\n    [yang.python.antlr.lower :as lower]\n    [yang.python.antlr.lower-portable-test :as portable]\n    [yang.python.antlr.prelude :as prelude]\n    [yang.python.antlr.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.engine :as engine]\n    [yin.vm.integer :as integer]\n    [yin.vm.linker :as linker]\n    [yin.vm.linker.interpreter :as link]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.module :as module]))\n\n\n(def ^:private limits\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n808:    [py/global-get\n841:    [py/global-set\n846:    [py/global-or\n1954:    [py/global-del-quiet (fn [g n] (py/dict-del-quiet g n))]\n1955:    [py/global-del\n2983:    [py/globals-fn\n3007:    [py/modules-ref\n3015:    [py/modules-put!\n3017:    [py/modules-del!\n(require '[clojure.string :as str]\n         '[yang.python.antlr.float-address-test :as float-test]\n         '[yang.python.antlr.linked-prelude-test :as linked-test]\n         '[yang.python.antlr.dht-import-fixture :as fixture]\n         '[yang.python.antlr.prelude :as prelude]\n         '[yang.python.antlr.safepoint :as hooks]\n         '[yang.safepoint :as safepoint]\n         '[yin.vm :as vm])\n\n(defn digest [address] (subs (name address) 7))\n(defn replace-pin [text old address]\n  (let [new (digest address)\n        ;; Existing tests split some digests across two string literals.\n        pattern (re-pattern (str/join \"\\\"\\\\s+\\\"\" (map #(apply str %) (partition-all 32 old))))]\n    (if (str/includes? text old)\n      (str/replace text old new)\n      (if (re-find pattern text)\n        (str/replace text pattern (str/join \"\\\"\\n                    \\\"\" (map #(apply str %) (partition-all 32 new))))\n        ;; Earlier pins used first chunks of 31 characters too.\n        (let [cut (some #(when (str/includes? text (subs old 0 %)) %) [31 32])]\n          (assert cut (str \"missing old pin \" old))\n          (-> text\n              (str/replace (subs old 0 cut) (subs new 0 cut))\n              (str/replace (subs old cut) (subs new cut))))))))\n\n(let [p (#'float-test/projected)\n      a (#'float-test/tree-of p)\n      {:keys [envelope record-address]} (safepoint/derive-envelope p hooks/profile :test/derived)\n      a-prime (#'float-test/tree-of envelope)\n      subtree (first (nth (get (:rows a) (:root a)) 3))\n      pins [[\"cfee487768bf7911d559d44a45f2946050ce2f9ea1ddb17da76c95461a2f61a0\" (:root (vm/ast->semantic-bytecode prelude/uast))]\n            [\"8f6f6d6e85e5027d51ac3e4ffbc155e3056bb0bcc435226aac9ee194a70d9fac\" (:root a)]\n            [\"9bf21a1516b4aa14a8a43877b3b86b596db3bb9159212c4ef4c1510872dabae5\" (:root a-prime)]\n            [\"ec2c04ffde26feb8edd56e6f2a7a4600449fcbd16021d688190d2b9b374bbeb0\" record-address]\n            [\"fb5a390a03acf410c2040696e273fe0878c20476724c131b0833d8bd3308c668\" subtree]]\n      path \"test/yang/python/antlr/float_address_test.cljc\"]\n  (doseq [[old new] pins] (println old \"=>\" new))\n  (println :hook (:root (vm/ast->semantic-bytecode hooks/uast)))\n  (spit path (reduce (fn [s [old new]] (replace-pin s old new)) (slurp path) pins)))\n\n(let [address (:py (fixture/parse (fixture/read-lines)))\n      path \"test/yang/python/antlr/linked_prelude_test.cljc\"]\n  (println :manifest address)\n  (spit path (replace-pin (slurp path) \"4aaaa09b192c5fed22786810b43880260aa2293ea0f0bb9c7c7978f14182048a\" address)))\n\n(let [n (count prelude/runtime-keys)\n      path \"test/yang/python/antlr/linked_prelude_test.cljc\"]\n  (println :runtime-keys n)\n  (spit path (str/replace (slurp path) \"(is (= 66 (count prelude/runtime-keys)))\"\n                          (str \"(is (= \" n \" (count prelude/runtime-keys)))\"))))\n(println :linked-program-root (:root (vm/ast->semantic-bytecode @#'linked-test/linked-x-equals-1)))\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `py`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `pysp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\n","exit_code":0,"status":"completed"}}
