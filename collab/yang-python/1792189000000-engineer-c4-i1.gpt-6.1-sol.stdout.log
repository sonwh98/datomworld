eral (get-in op [:body :type])))\n      (is (nil? (get-in op [:body :value])))\n      (is (every? some? (map def-key operands))))\n    (testing \"the placeholders come first, sorted, each the literal :py/uninit\"\n      (let [n (count prelude/runtime-keys)\n            placeholders (take n operands)]\n        (is (= prelude/runtime-keys (mapv def-key placeholders)))\n        (is (every? #(= {:type :literal, :value :py/uninit}\n                        (dissoc (get-in % [:operands 1]) :tail?))\n                    placeholders))))\n(ns yang.python.antlr.import-test\n  \"C4 slices I1, I2, I4-a and I6 (docs/design/yang.antlr.md 8.5.6): static\n   absolute imports of single modules (I1); packages, mangling, dotted,\n   aliased, from, relative and star imports (I2); statement-time delivery\n   and catchable linker refusals (I4-a); literal import_module, retained\n   image reload and import-hook refusals (I6). The fast tests pin the lowering\n   -- eager py delivery, statement-time guest delivery, the refusals -- and the\n   slow ones run the acceptance over `yang.python.antlr.linked-harness`:\n   every guest module is published once per process beside `py`, and each\n   run links over a source serving every name, so every test that\n   publishes or links is slow.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [dao.test-slow :as slow]\n    [dao.stream :as stream]\n    [yang.python.antlr.import-programs :as programs]\n    [yang.python.antlr.linked-harness :as h]\n    [yang.python.antlr.lower :as lower]\n    [yang.python.antlr.lower-portable-test :as portable]\n    [yang.python.antlr.prelude :as prelude]\n    [yang.python.antlr.publication :as publication]\n    [yang.python.antlr.render :as render]\n    [yang.python.antlr.scope :as scope]\n    [yang.python.antlr.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.module :as module]\n    [yin.vm.linker.interpreter :as link]))\n\n\n;; =============================================================================\n;; The fast tests: the lowering, before anything links\n;; =============================================================================\n\n(defn- nodes\n  \"Every node of map AST `ast`.\"\n  [ast]\n  (tree-seq map?\n            (fn [n] (filter map? (mapcat #(if (vector? %) % [%]) (vals n))))\n            ast))\n\n\n(defn- in-order\n  \"The nodes of map AST `ast` in evaluation order: an application after\n   its operands and its operator, a lambda operator's body (run once the\n   operands are bound) after the operands. `nodes` has no order.\"\n  [ast]\n  (letfn [(walk\n            [n]\n            (when (map? n)\n              (case (:type n)\n                :application (concat (mapcat walk (:operands n))\n                                     (walk (:operator n))\n                                     [n])\n                :lambda (cons n (walk (:body n)))\n                (cons n (mapcat walk\n                                (filter map?\n                                        (mapcat #(if (vector? %) % [%])\n                                                (vals n))))))))]\n    (walk ast)))\n\n\n(defn- requires-of\n  \"The literal module names the linked program's hoisted `(require 'm)`\n46:   its operands and its operator, a lambda operator's body (run once the\n56:                :lambda (cons n (walk (:body n)))\n109:        body (get-in (first (call-sites program 'py/run-main))\n110:                     [:operands 0 :body])]\n116:                            (nodes body)))]\n118:        (is (contains? vars 'pym.m/body))\n119:        (let [delivery (get-in (first (call-sites body 'py/import)) [:operands 1])\n120:              branch (:body (:operator (:body delivery)))]\n126:          (is (= '#{pym.m/spec pym.m/body}\n132:                  (call-sites body 'py/import)))\n134:                  (call-sites body 'py/global-set)))))))\n139:        body (get-in (first (call-sites program 'py/run-main))\n140:                     [:operands 0 :body])]\n146:                (call-sites body 'py/import))))))\n271:(defn- main-body\n273:  (get-in (first (call-sites program 'py/run-main)) [:operands 0 :body]))\n288:        calls (import-calls (main-body program))]\n299:                (call-sites (main-body program) 'py/global-set))))))\n305:        body (main-body program)\n307:                         (call-sites body 'py/global-set)))]\n315:                   (ordered-call-sites body 'py/import-from)))))\n327:    (let [body (main-body (lower/lower-packet programs/alias-rebind-main-packet\n331:                   (ordered-call-sites body 'py/import-from)))))))\n387:    (let [body (main-body (lower/lower-packet programs/star-main-packet\n389:      (is (= 2 (count (call-sites body 'py/import-star))))))\n426:    (let [body (lower/lower-module-body programs/del-packet)]\n431:                (nodes body)))))\n440:          body (lower/lower-module-body pk)\n442:                        (filter #(= :application (:type %)) (nodes body))))]\n480:              then the spec and body definitions\"\n484:      (is (nil? (get-in op [:body :value])))\n486:      (is (= '[spec body] (mapv def-key (drop 1 operands)))))\n487:    (testing \"the spec is the literal module record; the body is the same\n493:      (is (= '#{spec body} lower/module-exports)))\n527:      (is (= '#{spec body} (:exports spec)))\n591:  [task]\n592:  [(vm/halted? task) (vm/blocked? task) (render/output (vm/value task))])\n620:    (every= [true false {:py/out [\"a\" \"m-body\" \"b\"], :py/exception nil}]\n630:  (testing \"a second import does not re-execute the body: the sys.modules\n633:    (every= [true false {:py/out [\"m-body\" \"done\"], :py/exception nil}]\n635:    (every= [true false {:py/out [\"m-body\" \"7\"], :py/exception nil}]\n648:    (every= [true false {:py/out [\"m-body\" \"5\" \"absent\" \"('gone', 5)\"],\n658:(defn- raising-body-removes-its-entry-test\n660:  (testing \"a raising body propagates to the im