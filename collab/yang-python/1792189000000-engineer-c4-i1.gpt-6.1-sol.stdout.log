{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"tail -3 target/c4-i1-remint.log; git diff --stat; sed -n '247,264p' src/cljc/yang/python/antlr/safepoint.cljc; sed -n '268,318p' test/yang/python/antlr/linked_safepoint_test.cljc\"","aggregated_output":":float 8728d356a4f02fcab60c5a49bdafa684c3ee0bef41d79dff90f0609db4069d69 => :segment/blake3-8728d356a4f02fcab60c5a49bdafa684c3ee0bef41d79dff90f0609db4069d69\n:float 231cbc80225185736d332f5ad068d14e630003ea9882034b47a29879e6724f14 => :segment/blake3-231cbc80225185736d332f5ad068d14e630003ea9882034b47a29879e6724f14\n:bundled-hook :segment/blake3-2d387d0d4787a7222ad358d8d262d2d64b169162889461e84b954c1812074d08\n docs/design/yang.antlr.md                         |  2 +\n src/cljc/yang/python/antlr/safepoint.cljc         | 10 +++--\n test/yang/python/antlr/linked_prelude_test.cljc   | 33 ++++++++++++++\n test/yang/python/antlr/linked_safepoint_test.cljc | 52 +++++++++++++++++++++--\n 4 files changed, 89 insertions(+), 8 deletions(-)\n\n\n(def module-uast\n  \"The module tree: one application whose operands deliver the pinned\n   base prelude, then the definitions in order, applied to a lambda that\n   returns nil. Delivery never initializes the base runtime. Every\n   definition runs on the main sequence, unconditionally and before the one call, so the\n   linker's scanners discharge every body read of a sibling or a runtime\n   key; a `then` chain would leave every definition but the first inside\n   a closure body. Defining runs nothing.\"\n  (let [nodes (into [(u/sexp->uast '(require (quote py)))]\n                    (map (fn [[k form]] (u/def! k (u/sexp->uast form))))\n                    module-definitions)\n        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n\n\n(def module-exports\n             (:address (publish/publish-module!\n                         store (hooks/module-spec (h/registry)\n                                                  (:address @h/published)))))))))\n\n\n(deftest ^:slow pysp-manifest-address-test\n  (slow/guard \"pysp-manifest-address-test\" pysp-manifest-address))\n\n\n(defn- hook-install-does-not-initialize-runtime\n  []\n  (let [ast (u/sexp->uast '(require (quote pysp)))\n        py (:address @h/published)\n        pysp (:address @h/published-pysp)]\n    (doseq [k (keys h/backends)]\n      (testing (name k)\n        (let [task (h/run-linked k ast {:link-source (h/safepoint-source)})]\n          (is (vm/halted? task))\n          (is (not (vm/blocked? task)))\n          (testing \"the pinned base requirement installs code without cells\"\n            (is (empty? (:heap task)))\n            (is (= :py/uninit\n                   (get-in task [:module-stores py 'py.rt/state])))\n            (is (every? #(= :py/uninit\n                            (get-in task [:module-stores py %]))\n                        prelude/runtime-keys)))\n          (testing \"hook installation needs no signal stream or cursor\"\n            (is (every? #(= :py/uninit\n                            (get-in task [:module-stores pysp (hooks/strip %)]))\n                        hooks/runtime-keys))))\n        (testing \"installing hooks preserves the consumer's initialized base store\"\n          (let [ast (u/mark-tails\n                      (u/sexp->uast\n                        '(do (require (quote py))\n                             (py/init!)\n                             (py/modules-put! {:py/str \"task-marker\"} :consumer)\n                             (let [cls (py/object-class)]\n                               (do (require (quote pysp))\n                                   (conj (conj [] (= cls (py/object-class)))\n                                         (py/modules-ref {:py/str \"task-marker\"})))))))\n                task (h/run-linked k ast {:link-source (h/safepoint-source)})]\n            (is (= [true :consumer] (vm/value task)))))))))\n\n\n(deftest ^:slow hook-install-does-not-initialize-runtime-test\n  (slow/guard \"hook-install-does-not-initialize-runtime-test\"\n              hook-install-does-not-initialize-runtime))\n\n\n;; =============================================================================\n;; Running A' linked\n","exit_code":0,"status":"completed"}}
