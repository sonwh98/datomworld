    :depends [check:node-discovery]\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljs\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljd\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:list {:doc \"What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>...\"\n            (is (= \"ImportError\" (get-in (nth outcome 2)\n                                         [:py/exception :type])))\n            (is (= :absent (:reason response)) (pr-str response))\n            (is (= bogus (:address response)) (pr-str response)))\n        _ (testing \"the failed stage load is forgotten\"\n            (is (nil? (ld/stage-status (:reader w) m))))\n        [w outcome response _] (run w)]\n    (testing \"a second require starts a fresh stage load and is refused again\"\n      (is (= :absent (:reason response)) (pr-str response))\n      (is (= \"ImportError\" (get-in (nth outcome 2) [:py/exception :type]))))\n    (dht/close! (:pub w))\n    (dht/close! (:reader w))))\n\n\n(defn- dht-import-test\n  []\n  (let [lines (fixture/read-lines)\n        _ (this-host-publishes-the-artifact lines)\n        artifact (fixture/read-file)\n        a (get-in artifact [:principals :a])\n        src (source [a] [a])\n        w (publish-world artifact)\n        w (hook-import-refused-without-the-index w artifact)\n        w (site-sets-over-the-mesh w artifact)\n        w (hook-import-with-the-index w artifact)\n        w (a-hook-import-chain w artifact)\n        w (imports-over-the-dht w artifact src)\n        w (an-untrusted-principal-is-refused-on-every-vm w artifact)\n        w (a-trusted-principal-is-allowed-on-every-vm w artifact)\n        w (an-allow-binds-the-address-the-question-was-asked-about\n            w artifact)\n        w (republished-dependency-is-refused w artifact src)]\n    (dht/close! (:pub w))\n    (dht/close! (:reader w))\n    (an-absent-record-is-refused-and-retried)))\n\n\n(deftest ^:slow dht-import-test-test\n  (slow/guard \"dht-import-test\" dht-import-test))\n(ns yang.python.antlr.e2e-test\n  \"End to end, as a stream topology: source events -> parser stage -> CST\n   stream -> lowering stage -> program stream (source envelopes) -> an\n   evaluator on each of the four VMs (the AST walker observes a program\n   medium carrying the envelope's run member; the semantic, stack and\n   register VMs are built from the same member).\n\n   With hooks, the topology is longer: program stream -> encoder projection\n   -> row stream -> `yang.safepoint` stage -> derived stream, and each VM\n   runs the hook prelude followed by the derived program. `every-vm=` runs\n   every program both ways: under no-op hooks the derived program must\n   print what the naive one prints (safepoint slice 1, transparency).\n\n   The composition installs the real `cell` module (cell slice 1), the\n   real `data` module and the real `integer` module; nothing is stubbed.\n   Printed output is compared as Python text rendered at the boundary\n   (`yang.python.antlr.render`).\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [yang.python.antlr.linked-harness :as linked]\n            [yang.python.antlr.lower :as lower]\n            [yang.python.antlr.parser :as parser]\n            [yang.python.antlr.prelude :as prelude]\n            [yang.python.antlr.render :as render]\n            [yang.python.antlr.safepoint :as hooks]\n            [yang.python.antlr.import-programs :as imports]\n            [yang.python.antlr.safepoint-programs :as programs]\n            [yang.python.antlr.trace-programs :as trace]\n            [yang.safepoint :as safepoint]\n            [yin.repl :as repl]\n            [yin.repl.frontends :as frontends]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.engine :as engine]\n            [yin.vm.integer :as integer]\n\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n;; =============================================================================\n;; The host modules the lowering targets\n;; =============================================================================\n\n(ns yin.repl.python-antlr-test\n  \"Slice F3 (docs/design/yang.antlr.md section 8.5.6): the Python ANTLR\n   frontend at the REPL. State persists across submissions, the shell\n   shows what a submission printed and then the value of its last\n   top-level bare expression, a failed round\n   keeps the session's runtime state as it was, a round parked on a\n   require commits its frontend session only when it completes, and\n   `(reset)` and `(vm ...)` start a new process.\n\n   The session scenarios run on every host through a binding whose parse\n   stage answers the parser's packets, precompiled below (each def's\n   docstring is the source the REPL hands the parser), and through the\n   installed frontend, whose generated parser each host runs; the packets\n   are checked against the parser on every host so the two cannot drift.\n   The slow probe scenarios stay JVM-only.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [dao.test-slow :as slow]\n    [dao.jing.mem :as mem]\n    [dao.stream :as stream]\n    [dao.stream.ringbuffer :as ring]\n    [yang.clojure :as yang.clojure]\n    [yang.frontend :as frontend]\n    [yang.antlr.packet :as packet]\n    [yang.python.antlr.c3-programs :refer [asg at call e ex lit op st tc tx vr]]\n    [yang.python.antlr.lower-portable-test :refer [packet]]\n    [yang.python.antlr.repl :as python.repl]\n    [yang.python.antlr.parser :as parser]\n    #?@(:cljd [] :clj [[yang.python.antlr.repl-probe :as probe]])\n    [yin.repl :as repl]\n    [yin.repl.frontends :as frontends]\n    [yin.vm.linker.interpreter :as link]\n    [yin.vm.linker.publish :as publish]))\n\n\n;; =============================================================================\n;; Precompiled packets\n;; =============================================================================\n\n(defn- module\n  [& stmts]\n  (packet (-> [:file_input] (into stmts) (conj [\"EOF\" \"<EOF>\"]))))\n\n\n(def ^:private packets\n  \"The parser's packet for each line the session scenarios submit; the\n   REPL hands the parser the line with a newline appended.\"\n  {\"x = 1\" (module (st (asg (tc (vr \"x\")) (tc (lit \"1\"))))),\n   \"x = 5\" (module (st (asg (tc (vr \"x\")) (tc (lit \"5\"))))),\n   \"print(x)\" (module (st (ex (tc (call \"print\" (tc (vr \"x\"))))))),\n   \"x\" (module (st (ex (tc (vr \"x\"))))),\n   \"1/0\" (module (st (ex (tx (op (e (lit \"1\")) \"/\" (e (lit \"0\")))))))\n   \"even_squares = [x * x for x in range(1, 11) if x % 2 == 0]\"\n   (module\n     (st\n       (asg\n         (tc (vr \"even_squares\"))\n         (tc\n           [:atom_expr\n            [:atom\n             [\"OPEN_BRACK\" \"[\"]\n             [:testlist_comp\n              (tx (op (e (vr \"x\")) \"*\" (e (vr \"x\"))))\n              [:comp_for\n               [\"FOR\" \"for\"]\n               [:exprlist (e (vr \"x\"))]\n               [\"IN\" \"in\"]\n               [:or_test\n                [:and_test\n                 [:not_test\n                  [:comparison\n                   [:expr\n                    (call \"range\" (tc (lit \"1\")) (tc (lit \"11\")))]]]]]\n               [:comp_iter\n                [:comp_if\n                 [\"IF\" \"if\"]\n                 [:test_nocond\n                  [:or_test\n                   [:and_test\n","exit_code":1,"status":"failed"}}
