                         :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\n                  ;; the conformance compositions) overflow smaller stacks in\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n                  ;; the 4m minimum for the prelude recursion rows still holds)\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n60:                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n64:                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n108:            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n158:;; npx shadow-cljs compile test && node target/node-tests.js\n159:;; npx shadow-cljs release demo\n","exit_code":0,"status":"completed"}}
