{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"sed -n '150,210p' test/yang/python/antlr/dht_import_fixture.cljc && sed -n '690,745p' src/cljc/yang/python/antlr/lower.cljc && sed -n '1,160p' src/cljc/yang/python/antlr/parser.cljc\"","aggregated_output":"                          :manifest (get-in k2 [:addresses \"k\"]),\n                          :seq 7})]\n            foreign (assert-names key-b 1 [['pym.e (get addresses \"e\")]])\n            ;; I7: A's signed publication entry for each module's site-set\n            ;; record, the units' then k's republication\n            sites (into []\n                        (mapcat #(siteset/signed-entries\n                                   key-a (:sites %) (:addresses %)\n                                   (:bundles %)))\n                        [units k2])\n            blobs (sort-by (comp str key)\n                           (remove (fn [[a _]] (contains? installed a))\n                                   ((:entries-fn store))))]\n        {:lines\n         (into [magic\n                (pr-str {:py py})\n                (pr-str {:principals {:a (:public key-a),\n                                      :b (:public key-b)}})\n                (pr-str {:units addresses,\n                         :republished {\"k\" (get-in k2 [:addresses \"k\"])}})\n                (pr-str {:importers {:d programs/d-packet,\n                                     :tt programs/tt-packet,\n                                     :x programs/x-packet}})\n                (pr-str {:index :own, :signed (signed-only own)})\n                (pr-str {:index :republish, :signed (signed-only republish)})\n                (pr-str {:index :foreign, :signed (signed-only foreign)})\n                (pr-str {:index :sites, :signed sites})]\n               (map (fn [[a bs]] (pr-str [a (jing.dht/bytes->hex bs)])))\n               blobs)}))))\n\n\n(defn text\n  \"The artifact text of `lines`: one per line, newline terminated.\"\n  [lines]\n  (str (str/join \"\\n\" lines) \"\\n\"))\n\n\n(defn read-lines\n  \"The artifact's lines, blank ones dropped (Dart keeps a trailing one).\"\n  []\n  (vec (remove str/blank? (str/split-lines (cfx/read-path path)))))\n\n\n(defn parse\n  \"Artifact `lines` as data, `{:py :principals :units :republished\n   :importers :indexes {kind [signed ...]} :blobs {address hex}}`: what\n   two artifacts are compared by, since a host prints a map's entries in\n   its own order.\"\n  [lines]\n  (let [[m & forms] lines]\n    (when-not (= magic m)\n      (throw (ex-info \"not a dht-import-v1 artifact\" {:path path})))\n    (reduce (fn [acc line]\n              (let [form (edn/read-string line)]\n                (cond\n                  (vector? form) (assoc-in acc [:blobs (first form)]\n                                           (second form))\n                  (:index form) (assoc-in acc [:indexes (:index form)]\n                                          (:signed form))\n                  :else (merge acc form))))\n            {:blobs {}, :indexes {}}\n                                    (name-chain\n                                      (dotted-text\n                                        pk\n                                        (first (p/child-rules pk t \"dotted_name\"))))))\n                          (p/child-rules pk das \"dotted_as_name\")))\n                  \"atom_expr\"\n                  (do (when-let [call (import-module-call pk bindings n)]\n                        (vswap! out into (name-chain (:name call))))\n                      (run! walk (p/children pk n)))\n                  \"import_from\"\n                  (let [m (from-module pk unit n)]\n                    (when (string? m) (vswap! out into (name-chain m))))\n                  (run! walk (p/children pk n)))))]\n      (walk (p/root pk))\n      @out)))\n\n\n(defn imported-module-names\n  \"The distinct modules the unit statically imports, each dotted name's\n   ancestors ahead of it, source order: the pre-seeded `sys` and\n   `builtins` aside, and the unit's own name, whose sys.modules entry\n   answers while its body runs. `unit` is `{:name :package?}`, nil for a\n   packageless unit.\"\n  ([pk] (imported-module-names pk nil))\n  ([pk unit]\n   (into [] (comp (remove preseeded-modules)\n                  (remove #(= % (:name unit)))\n                  (distinct))\n         (packet-imports pk unit))))\n\n\n(defn- preseeded-imports-only?\n  \"Whether every import statement of the packet, at any depth, is I1's\n   `import sys`, `import builtins` or `import importlib`\n   (undotted, unaliased, pre-seeded):\n   the only imports the bundled profile lowers. Checked on the\n   statements, not on the delivery they need: a packageless relative\n   import needs none and is still an I2 form.\"\n  [pk]\n  (let [bindings (importlib-bindings pk)]\n    (letfn [(plain-preseeded?\n              [t]\n              (and (empty? (p/child-rules pk t \"name\"))\n                   (contains? preseeded-modules\n                              (dotted-text\n                                pk (first (p/child-rules pk t \"dotted_name\"))))))\n            (ok?\n              [n]\n              (or (not (p/rule? n))\n                  (case (:rule n)\n                    \"atom_expr\" (and (not (import-module-call pk bindings n))\n                                     (every? ok? (p/children pk n)))\n                    \"import_from\" false\n                    \"import_name\"\n                    (every? plain-preseeded?\n                            (p/child-rules\n(ns yang.python.antlr.parser\n  \"The Python parser interpreter: the grammars-v4 Python3 grammar profile\n   plus the stage that reads sealed source units from one stream and writes\n   CST packets to another. The generated recognizers come from `bb gen:antlr`\n   (antlr/python3/manifest.edn), one per host target; this is the only\n   namespace that names them, and the profile's three constructors are the\n   entire per-host surface.\"\n  (:require\n    #?@(:cljd [[\"package:antlr4/antlr4.dart\" :as antlr4]\n               [\"package:datomworld_cljd/antlr/python3/Python3Lexer.dart\"\n                :as lexer-ns]\n               [\"package:datomworld_cljd/antlr/python3/Python3Parser.dart\"\n                :as parser-ns]]\n        :cljs [[\"/yang/antlr/gen/python3/Python3Lexer.js\" :default Python3Lexer]\n               [\"/yang/antlr/gen/python3/Python3Parser.js\" :default Python3Parser]])\n    [yang.antlr.cst :as cst]\n    [yang.stage :as stage])\n  #?@(:cljd []\n      :jolt []\n      :clj [(:import\n              (yang.python.antlr.gen\n                Python3Lexer\n                Python3Parser))]))\n\n\n(def grammar-id\n  \"grammars-v4 python/python3 at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/python/python3@8af0d4c26c796ea27c15c3d85418f2d0f77c3adb antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   ;; jolt: the C++ recognizers live in native/jolt-parser behind the jolt\n   ;; yang.antlr.cst, which builds no lexer or parser from the profile\n   :make-lexer #?(:cljd (fn [cs] (lexer-ns/Python3Lexer cs))\n                  :jolt nil\n                  :default (fn [cs] (Python3Lexer. cs))),\n   :make-parser #?(:cljd (fn [ts] (parser-ns/Python3Parser ts))\n                   :jolt nil\n                   :default (fn [ts] (Python3Parser. ts))),\n   :start #?(:cljd (fn [p] (.file_input ^parser-ns/Python3Parser p))\n             :jolt nil\n             :clj (fn [^Python3Parser p] (.file_input p))\n             :cljs (fn [^js p] (.file_input p)))})\n\n\n(defn rule-names\n  \"The grammar's rule-name table. A function, so requiring this namespace\n   does no native work: on jolt the table is what the native parser reports,\n   read when first asked for (unavailable-parser is thrown while the library\n   is unavailable, and a later call retries).\"\n  []\n  ;; Dart's table is an instance member of the generated parser.\n  #?(:cljd (vec (.-ruleNames\n                  (parser-ns/Python3Parser\n                    (antlr4/CommonTokenStream\n                      (lexer-ns/Python3Lexer\n                        (antlr4/InputStream.fromString \"\"))))))\n     :jolt (cst/rule-names)\n     :clj (vec (seq Python3Parser/ruleNames))\n     :cljs (vec (.-ruleNames Python3Parser))))\n\n\n(defn available?\n  \"True when this host's recognizers can be built. Always on the JVM, Node\n   and Dart (the generated parser ships with the build); on jolt, only when\n   native/jolt-parser loaded and writes the expected layout, so a missing or\n   incompatible library leaves Python out of the catalog (never another\n   parser) instead of failing the load.\"\n  []\n  #?(:jolt (cst/available?) :default true))\n\n\n(defn make-worker\n  \"A worker for this grammar. On jolt it owns a native handle; dispose it with\n   `close-worker` (the convenience calls below dispose their own).\"\n  []\n  (cst/make-worker profile))\n\n\n(defn close-worker\n  \"Dispose `worker` (jolt: its native handle and caches; idempotent, and a\n   closed worker refuses further parses). The other hosts' workers are\n   collected, so this does nothing there.\"\n  [worker]\n  #?(:jolt (cst/close-worker worker) :default nil))\n\n\n(defn- with-worker\n  \"(f worker) over a worker made for this one call and disposed however f\n   exits (J5, known-gaps row 59: no convenience call leaves a native worker).\"\n  [f]\n  (let [w (make-worker)]\n    (try (f w)\n         (finally (close-worker w)))))\n\n\n(defn parse-source\n  \"Parse one complete source string as unit `unit`: the packet a sealed unit\n   with this text produces. The one-argument form makes a worker for the\n   call and disposes it.\"\n  ([source] (with-worker #(parse-source % [:unit 0] source)))\n  ([worker unit source] (cst/parse-unit worker unit source)))\n\n\n(defn first-failure\n  \"Where the grammar first refuses `source` (`yang.antlr.cst/first-failure`:\n   nil, :end or :early), with a worker made for this call and disposed.\n\n   On jolt an input over the native parser's budget answers :early: more\n   lines can only grow its size and its nesting, so it cannot be mended, and\n   the parse stage then reports the qualified :parser-budget refusal.\"\n  [source]\n  (with-worker\n    (fn [w]\n      (try (cst/first-failure w source)\n           (catch #?(:cljd Object :clj Exception :cljs :default) e\n             (if (= :parser-budget (:diagnostic (ex-data e)))\n               :early\n               (throw e)))))))\n\n\n(defn open-stage\n  \"A parser stage reading source events from `source-stream` and writing\n   CST packets to `cst-stream`. The stage owns its worker: `close-stage`\n   disposes it and `reset-stage` replaces it with a fresh one.\"\n  [source-stream cst-stream]\n  ;; the stage first: opening it can refuse (a source cursor that cannot be\n  ;; had), and then no worker exists to leak\n  (let [s (stage/open source-stream {:cst cst-stream} {})\n        w (make-worker)]\n    (try\n      (assoc s\n             ::worker w\n             ::transform (cst/parse-transform w))\n      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n        (close-worker w)\n        (throw e)))))\n\n\n(defn close-stage\n  \"Dispose the stage's worker (teardown). The stage parses no more.\"\n  [s]\n  (close-worker (::worker s))\n  nil)\n\n\n(defn reset-stage\n  \"The stage with its worker disposed and a fresh one in its place, so no\n   recognizer cache survives a reset.\"\n  [s]\n  (close-worker (::worker s))\n  (let [w (make-worker)]\n    (assoc s ::worker w ::transform (cst/parse-transform w))))\n\n\n(defn step-stage\n  [s]\n  (stage/step s (::transform s)))\n","exit_code":0,"status":"completed"}}
