{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"sed -n '108,128p' deps.edn; sed -n '1,24p' bb.edn; sed -n '235,290p' bb.edn\"","aggregated_output":"            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n                                 ;; oracle backend: Datomic Local, in-process,\n                                 ;; run in docker/oracle (dev-scope only)\n                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n{:tasks\n {gen:antlr\n  {:doc \"Generate the pinned grammars-v4 parsers for every target (antlr/*/manifest.edn): Java compiled into build/antlr/<g>/classes, JavaScript in build/antlr/<g>/js, Dart in lib/antlr/<g>; filters after --: --grammar g --target t\"\n   :task (apply shell \"bb\" \"src/dev/build_cache.clj\"\n                \"antlr\" *command-line-args*)}\n\n  autobahn:jolt\n  {:doc \"J6f Autobahn conformance: starts the testee and the Dockerized pinned suite, waits for the READY barrier, runs harness.py per role, collects results/, and shuts both sides down. Usage: bb autobahn:jolt <role> <agent>\"\n   :task (apply shell {:continue true} \"bash\" \"tools/jolt-autobahn/launch.sh\" *command-line-args*)}\n\n  deps:npm\n  {:doc \"Worktree-local npm ci, reused only while input and installed-file digests match\"\n   :task (shell \"bb\" \"src/dev/build_cache.clj\" \"npm\")}\n\n  ;; jolt host lane (experimental, docs/design/yin.repl-jolt-implementation.md)\n  bootstrap:jolt\n  {:doc \"Materialize the jolt-toolchain.edn pins into build/tools/jolt (mise Chez/CMake checked, jolt cloned at the full SHA, never pulled) and write build/tools/jolt-env.sh\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\")))}\n\n  test:jolt-bootstrap-neg\n  {:doc \"Copy/revert the jolt clone under gitignored build/bootstrap-neg (deleted on success, retained on failure) and declare a synthetic patch and prove bootstrap refuses it unapplied or corrupted, then accepts it applied (JOLT_BOOTSTRAP_TEST_DIR selects the source clone)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\" \"--test-negative\")))}\n\n  jolt:run\n  {:doc \"Run the bootstrapped jolt with build/tools/jolt-env.sh, passing every argument through (e.g. bb jolt:run -Srepro -M:jolt src/dev/jolt_j0c_workers.clj)\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"sh\" \"-c\"\n                         \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" \\\"$@\\\"\" \"jolt\"\n                         *command-line-args*)))}\n\n  build:yin-repl-node\n  {:doc \"Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js\"\n   ;; The Node lanes (test:cljs and its variants) depend on this task, so the\n   ;; generated JavaScript parser reaches them through it.\n   :depends [deps:npm gen:antlr]\n   ;; yin.repl.dht-process-test spawns it as the JVM-to-Node reader of\n   ;; DHT epic S5, a required leg: a missing build fails that test.\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl\")}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; The Dart lanes depend on this task, so the generated Dart parser\n   ;; reaches them through it.\n   :depends [gen:antlr]\n   ;; Process B of the R5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM\n   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n   ;; `bb test:cljs` without it skips those tests with a printed notice\n   ;; rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  build:demo\n  {:doc \"Release-compile the browser demo (shadow-cljs build :demo) to public/js/main.js\"\n   ;; The demo pulls in yang.python.antlr.parser, whose JavaScript\n   ;; recognizers live in build/antlr/python3/js (a :cljs classpath root),\n   ;; so a clean checkout generates them before compiling.\n   :depends [deps:npm gen:antlr]\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli release demo\")}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  check:node-discovery\n  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\n   :task (shell {:shutdown nil} \"bb src/dev/check_node_discovery.clj\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [check:node-discovery build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n","exit_code":0,"status":"completed"}}
