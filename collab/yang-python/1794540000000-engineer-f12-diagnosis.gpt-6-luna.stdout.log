{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"importers|def.*import|defn.*generate\\\" test/yang/python/antlr/dht_import_fixture.cljc test/yang/python/antlr/import_programs.cljc | tail -70 && rg -n \\\"defn imported-module-names|imported-module-names\\\" src/cljc/yang/python/antlr/lower.cljc && sed -n '365,415p' src/cljc/yang/python/antlr/lower.cljc\"","aggregated_output":"test/yang/python/antlr/dht_import_fixture.cljc:47:(def magic \"dht-import-v1\")\ntest/yang/python/antlr/dht_import_fixture.cljc:120:(defn generate\ntest/yang/python/antlr/dht_import_fixture.cljc:170:                (pr-str {:importers {:d programs/d-packet,\ntest/yang/python/antlr/dht_import_fixture.cljc:195:   :importers :indexes {kind [signed ...]} :blobs {address hex}}`: what\ntest/yang/python/antlr/import_programs.cljc:2982:  \"def f():\\n    from sx import *\\n\"\n707:(defn imported-module-names\n713:  ([pk] (imported-module-names pk nil))\n    (syntax! n \"malformed escape in string literal\"))\n  (let [cp (escape-value s 16)]\n    (when (> cp 0x10FFFF)\n      (syntax! n \"illegal Unicode character in \\\\U escape\"))\n    cp))\n\n\n(def ^:private simple-escapes\n  {\"\\\\\" \"\\\\\", \"'\" \"'\", \"\\\"\" \"\\\"\", \"n\" \"\\n\", \"t\" \"\\t\", \"r\" \"\\r\",\n   \"a\" (code-point->str 7), \"b\" (code-point->str 8), \"f\" (code-point->str 12),\n   \"v\" (code-point->str 11), \"\\n\" \"\"})\n\n\n(defn- unescape\n  [n body]\n  (let [len (count body)]\n    (loop [i 0\n           out []]\n      (if (>= i len)\n        (apply str out)\n        (let [c (subs body i (inc i))]\n          (if (and (= c \"\\\\\") (< (inc i) len))\n            (let [e (subs body (inc i) (+ i 2))]\n              (cond\n                (contains? simple-escapes e)\n                (recur (+ i 2) (conj out (get simple-escapes e)))\n                (= e \"x\") (recur (+ i 4)\n                                 (conj out (code-point->str\n                                             (hex-value n (subs body (+ i 2) (min len (+ i 4)))))))\n                (= e \"u\") (recur (+ i 6)\n                                 (conj out (code-point->str\n                                             (hex-value n (subs body (+ i 2) (min len (+ i 6)))))))\n                (= e \"U\") (recur (+ i 10)\n                                 (conj out (code-point->str\n                                             (hex-value n (subs body (+ i 2) (min len (+ i 10)))))))\n                (= e \"N\") (unsupported! n \"named unicode escape\")\n                (re-matches #\"[0-7]\" e)\n                (let [digits (re-find #\"^[0-7]{1,3}\" (subs body (inc i)))]\n                  (recur (+ i 1 (count digits))\n                         (conj out (code-point->str (escape-value digits 8)))))\n                :else (recur (+ i 2) (conj out c e))))\n            (recur (inc i) (conj out c))))))))\n\n\n(defn- parse-string\n  \"The value of one STRING token: prefixes u and r only.\"\n  [n text]\n  (let [prefix (str/lower-case (re-find #\"^[A-Za-z]*\" text))\n        quoted (subs text (count prefix))\n        q3 (subs quoted 0 (min 3 (count quoted)))\n        body (if (or (= q3 \"'''\") (= q3 \"\\\"\\\"\\\"\"))\n","exit_code":0,"status":"completed"}}
