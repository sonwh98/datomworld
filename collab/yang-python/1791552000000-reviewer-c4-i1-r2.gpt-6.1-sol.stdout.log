 false}\n++                                             :py/None)]\n++                                 (list 'py/print printed))))]\n++      (doseq [[k result] (run-with-prelude prelude/uast form)]\n++        (testing (str k)\n++          (is (= {:py/out [[\"m\" 7 5 nil true true true]], :py/exception nil}\n++                 result)\n++              (pr-str result)))))))\n++\n++\n+ (deftest prelude-notation-test\n+   (testing \"the prelude is canonical Universal AST: no reserved-name defect,\n+             and every definition key is a literal symbol\"\n","exit_code":1,"status":"failed"}}
