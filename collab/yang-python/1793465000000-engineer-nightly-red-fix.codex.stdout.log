                       |  13 +\n package.json                                       |   1 +\n pubspec.lock                                       |   8 +\n pubspec.yaml                                       |   2 +\n src/cljc/dao/data/btree/storage.cljc               |  37 ++-\n src/cljc/dao/jing.cljc                             | 303 +++++++++++++++------\n src/cljc/dao/jing/dht.cljc                         |  28 +-\n src/cljc/dao/jing/dht/kad.cljc                     |   2 +-\n src/cljc/dao/jing/dht/node.cljc                    |   2 +-\n src/cljc/dao/jing/file.cljc                        |   2 +-\n src/cljc/dao/jing/mem.cljc                         |  10 +-\n src/cljc/dao/jing/remote.cljc                      |   5 +-\n src/cljc/dao/jing/remote/async.cljc                |  32 ++-\n src/cljc/dao/jing/remote/step.cljc                 |  21 +-\n src/cljc/dao/jing/stream.cljc                      |   2 +-\n src/cljc/dao/space/index.cljc                      |  17 +-\n src/cljc/yin/vm.cljc                               |   9 +-\n src/cljc/yin/vm/completion.cljc                    |   2 +-\n src/cljc/yin/vm/content.cljc                       |   4 +-\n src/cljc/yin/vm/ledger.cljc                        |  24 +-\n src/cljc/yin/vm/macro.cljc                         |   5 +-\n src/cljc/yin/vm/semantic.cljc                      |   9 +-\n test/dao/data/btree_durability_test.cljc           |   6 +-\n test/dao/jing/hash_registry_contract_test.cljc     |  83 +-----\n test/dao/jing/stream_test.cljc                     |   5 +-\n test/dao/jing_test.cljc                            |  15 +-\n test/dao/stream/transit_test.cljc                  |  10 +-\n 30 files changed, 516 insertions(+), 255 deletions(-)\n192-+(defn parse-segment-address\n193-+  \"The authoritative address parser: requires a `segment` namespace keyword,\n194-+   splits the name on the first `-` into algorithm identifier and digest,\n195:+   looks the identifier up by exact match (no prefix matching), validates\n