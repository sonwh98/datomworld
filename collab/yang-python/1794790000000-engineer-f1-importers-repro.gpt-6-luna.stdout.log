rded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-peer]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Only the slow tests. Node and Dart select by namespace, so the other\n  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.\n  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\n                 :depends [build:yin-repl-node gen:antlr]\n                 :task (shell \"clojure -M:test -i :slow\")}\n\n  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [check:node-discovery build:yin-repl-node]\n                  :task (let [re (-> (shell {:out :string}\n                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\n                                     :out\n                                     clojure.string/trim)]\n                          (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                                 \"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                                 \"compile\" \"test\" \"--config-merge\"\n                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\n\n  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-peer]\n                  :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                               \"bb src/dev/cljd_agg.clj --slow-only\")}\n\n  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\n             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\n\n  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\n            :depends [test:all:clj