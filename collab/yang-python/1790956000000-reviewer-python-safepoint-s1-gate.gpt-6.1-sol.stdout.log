ooks/profile))))]\ntest/yang/python/antlr/safepoint_test.cljc:421:              (on-every-vm (hooks/program (u/then hooks/uast set-handler) a')\ntest/yang/python/antlr/safepoint_test.cljc:427:  (testing \"the derived program without the hook prelude names the hook\"\ntest/yang/python/antlr/safepoint_test.cljc:430:                           (tree-of (:derived (derive* while-true-pass hooks/profile))))\ntest/yang/python/antlr/safepoint_test.cljc:433:  (testing \"the naive program reads KeyboardInterrupt as a builtin its own\ntest/yang/python/antlr/safepoint_test.cljc:436:      (is (contains? (names-in ast) 'py.b/KeyboardInterrupt))\ntest/yang/python/antlr/safepoint_test.cljc:437:      (is (some #(= 'py.b/KeyboardInterrupt (:value (first (:operands %))))\ntest/yang/python/antlr/safepoint_test.cljc:442:(deftest hook-prelude-defines-only-py-sp-test\ntest/yang/python/antlr/safepoint_test.cljc:443:  (doseq [[label hook-prelude] [[:uast hooks/uast] [:noop-uast hooks/noop-uast]]]\ntest/yang/python/antlr/safepoint_test.cljc:444:    (let [ks (map #(:value (first (:operands %))) (definitions hook-prelude))]\ntest/yang/python/antlr/safepoint_test.cljc:449:(deftest hook-prelude-loads-alone-test\ntest/yang/python/antlr/safepoint_test.cljc:450:  (testing \"with only the signal stream and no base prelude, the hook prelude\ntest/yang/python/antlr/safepoint_test.cljc:452:    (doseq [[k result] (on-every-vm hooks/uast (with-signals [])\ntest/yang/python/antlr/safepoint_test.cljc:461:(def ^:private parking-hooks\ntest/yang/python/antlr/safepoint_test.cljc:462:  \"A `:loop` hook that counts and, at safepoint `py.sp/park-at`, reads an\ntest/yang/python/antlr/safepoint_test.cljc:489:  (testing \"a safepointed loop grows no continuation: parked at its 10th and\ntest/yang/python/antlr/safepoint_test.cljc:490:            its 100,000th safepoint, every VM holds the same frames\"\ntest/yang/python/antlr/safepoint_test.cljc:492:               (tree-of (:derived (derive* while-true-pass hooks/pro