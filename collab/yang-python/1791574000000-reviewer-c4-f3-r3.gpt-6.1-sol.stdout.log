   115	
   116	(deftest assignment-then-print-test
   117	  (doseq [lang langs]
   118	    (testing (str lang)
   119	      (let [[[assigned t1] [_ t2]] (feed (session lang) ["x = 1" "print(x)"])]
   120	        (is (= lang (:lang (session lang))))
   121	        (is (= ["" "1\n"] [t1 t2]))
   122	        (is (= :primed (:frontend-session assigned)))))))
   123	
   124	
   125	(deftest an-exception-keeps-the-session-test
   126	  (doseq [lang langs]
   127	    (testing (str lang)
   128	      (is (= ["" "ZeroDivisionError: division by zero\n" "5\n"]
   129	             (texts (session lang) ["x = 5" "1/0" "print(x)"]))))))
   130	
   131	
   132	(deftest reset-is-a-new-process-test
   133	  (doseq [lang langs]
   134	    (testing (str lang)
   135	      (let [[_ before [reset-state _] after]
   136	            (feed (session lang) ["x = 1" "print(x)" "(reset)" "print(x)"])]
   137	        (is (= "1\n" (second before)))
   138	        (is (nil? (:frontend-session reset-state)))
   139	        (is (= "NameError: name 'x' is not defined\n" (second after)))))))
   140	
   141	
   142	(deftest vm-rebuild-is-a-new-process-test
   143	  (doseq [lang langs]
   144	    (testing (str lang)
   145	      (let [vm-type (first (remove #{(:vm-type (session lang))}
   146	                                   [:semantic :register]))
   147	            [_ [switched _] gone _ again]
   148	            (feed (session lang)
   149	                  ["x = 1" (str "(vm " vm-type ")") "print(x)" "x = 5"
   150	                   "print(x)"])]
   151	        (is (= vm-type (:vm-type switched)))
   152	        (is (nil? (:frontend-session switched)))
   153	        (testing "the new VM runs the prelude again and has no x"
   154	          (is (= "NameError: name 'x' is not defined\n" (second gone))))
   155	        (is (= "5\n" (second again)))))))
   156	
   157	
   158	(deftest a-failed-first-round-keeps-the-runtime-uninitialized-test
   159	  (doseq [lang langs]
   160	    (testing (str lang)
   161	      (let [calls (atom 0)
   162	            report (fn [out exception]
   163	                     (if (= 1 (swap! calls inc))
   164	                       (throw (ex-info "report failed" {}))
   165	                       (python.repl/report out exception)))
   166	            [[failed failed-text] _ [_ text]]
   167	            (feed (session lang {:primitives {'py-report report}})
   168	                  ["x = 1" "x = 1" "print(x)"])]
   169	        (testing "the failed round is reported and leaves no session marker"
   170	          (is (str/includes? failed-text "report failed"))
   171	          (is (nil? (:frontend-session failed))))
   172	        (testing "the retry carries the prelude again and the session works"
   173	          (is (= "1\n" text)))))))
   174	
