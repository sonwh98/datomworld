    34	;; =============================================================================
    35	;; Precompiled packets
    36	;; =============================================================================
    37	
    38	(defn- module
    39	  [& stmts]
    40	  (packet (-> [:file_input] (into stmts) (conj ["EOF" "<EOF>"]))))
    41	
    42	
    43	(def ^:private packets
    44	  "The parser's packet for each line the session scenarios submit; the
    45	   REPL hands the parser the line with a newline appended."
    46	  {"x = 1" (module (st (asg (tc (vr "x")) (tc (lit "1"))))),
    47	   "x = 5" (module (st (asg (tc (vr "x")) (tc (lit "5"))))),
    48	   "print(x)" (module (st (ex (tc (call "print" (tc (vr "x"))))))),
    49	   "1/0" (module (st (ex (tx (op (e (lit "1")) "/" (e (lit "0")))))))})
    50	
    51	
    52	;; =============================================================================
    53	;; Sessions
    54	;; =============================================================================
    55	
    56	(def ^:private cst-manifest
    57	  {:yang.frontend/id :yang.python/cst,
    58	   :yang.frontend/spi 1,
    59	   :yang.frontend/revision "f3-test",
    60	   :yang.frontend/language :python.cst,
    61	   :yang.frontend/grammar {:yang.grammar/package "python3",
    62	                           :yang.grammar/entries {:module "file_input"},
    63	                           :yang.grammar/export-profile :yang.cst/v1},
    64	   :yang.frontend/options-schema :segment/none,
    65	   :yang.frontend/lowering-profile :segment/f3-test,
    66	   :yang.frontend/runtime-profile :segment/f3-test,
    67	   :yang.frontend/support-profile :segment/f3-test})
    68	
    69	
    70	(defn- cst-catalog
    71	  "The standard catalog plus the Python lowering behind a parse stage
    72	   that answers the precompiled packets."
    73	  []
    74	  (frontend/install (frontends/standard)
    75	                    cst-manifest
    76	                    {:parse (fn [source] (get packets source)),
    77	                     :lower python.repl/lower,
    78	                     :lower-session python.repl/lower-session,
    79	                     :display :output}))
