   220	(def ^:private module-ast
   221	  "`(yin/def f (fn [] 42))`."
   222	  {:type :application,
   223	   :operator {:type :variable, :name 'yin/def},
   224	   :operands [{:type :literal, :value 'f}
   225	              {:type :lambda, :params [], :body {:type :literal, :value 42}}]})
