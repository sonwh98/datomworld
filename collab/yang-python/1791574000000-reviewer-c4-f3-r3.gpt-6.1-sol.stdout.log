   228	(defn- silent-client
   229	  "A content-pair client on a wire nothing answers: a link over it stays
   230	   pending."
   231	  []
   232	  (let [medium #(-> {:dao.stream/type ring/transport-type,
   233	                     ring/capacity-key 64}
   234	                    ring/create!
   235	                    :dao.stream/handle)
   236	        responses (medium)]
   237	    {:requests (medium),
   238	     :answers responses,
   239	     :cursor (:dao.stream/cursor
   240	               (stream/cursor responses stream/anchor-newest))}))
   241	
   242	
   243	(defn- parked
   244	  "A counting shell that committed one round, then typed a require of
   245	   `mod` that parks: nothing answers its link."
   246	  [opts]
   247	  (let [[primed _] (repl/eval-input (counting-session opts) "(+ 1 2)")]
   248	    (first (repl/eval-input primed "(require (quote mod))"))))
