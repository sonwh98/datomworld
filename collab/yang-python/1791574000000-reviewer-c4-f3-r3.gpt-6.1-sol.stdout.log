   176	(deftest a-failed-later-round-keeps-the-previous-marker-test
   177	  (let [calls (atom 0)
   178	        report (fn [out exception]
   179	                 (if (= 2 (swap! calls inc))
   180	                   (throw (ex-info "report failed" {}))
   181	                   (python.repl/report out exception)))
   182	        [_ [failed _] [_ text]]
   183	        (feed (session :yang.python/cst {:primitives {'py-report report}})
   184	              ["x = 1" "x = 5" "print(x)"])]
   185	    (is (= :primed (:frontend-session failed)))
