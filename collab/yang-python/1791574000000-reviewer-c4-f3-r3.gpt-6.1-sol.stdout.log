   131	              (if (= (peek stack) (opener-of c))
   132	                (let [[stack block?] (code stack)]
   133	                  (recur (inc i) (pop stack) line-begin false block?))
   134	                (assoc state :error :bracket))
   135	
   136	              (contains? #{\space \tab \formfeed \return} c)
   137	              (recur (inc i) stack line-begin line? block?)
   138	
   139	              :else
   140	              (let [[stack block?] (code stack)]
   141	                (recur (inc i) stack line-begin false block?)))))))))
   142	
   143	
   144	;; =============================================================================
   145	;; Parse: where the first error failed
   146	;; =============================================================================
   147	
   148	(defn- first-failure
   149	  "Parse `source` and answer nil when it parses, `:end` when its first
   150	   error failed on an end-of-input token, else `:early`.
   151	
   152	   The failing token is the offending token of a mismatch; a
   153	   no-viable-alternative error names the token its prediction began at,
   154	   so for it the failing token is the furthest one the parser had read
   155	   when the error was reported. End-of-input tokens are EOF and the
   156	   zero-width ones after the last token with source text (the lexer's
   157	   EOF can carry a span, so it is excluded by type). A lexer error has no
   158	   token and is `:early`."
   159	  [^String source]
   160	  (let [{:keys [profile lexer-atn lexer-dfa lexer-cache parser-atn
   161	                parser-dfa parser-cache]}
   162	        (parser/make-worker)
   163	        far (volatile! -1)
   164	        failure (volatile! nil)
   165	        lexer ^Lexer ((:make-lexer profile) (CharStreams/fromString source))
   166	        tokens (proxy [CommonTokenStream] [lexer]
   167	                 (LT
   168	                   [k]
   169	                   (let [^Token t (proxy-super LT k)]
   170	                     (when t (vswap! far max (.getTokenIndex t)))
   171	                     t)))
   172	        listener (proxy [BaseErrorListener] []
   173	                   (syntaxError
   174	                     [_recognizer offending _line _column _msg e]
   175	                     (when-not @failure
   176	                       (vreset! failure
   177	                                (cond
   178	                                  (not (instance? Token offending)) :lexical
   179	                                  (instance? NoViableAltException e) @far
   180	                                  :else (.getTokenIndex ^Token offending))))))
   181	        _ (.setInterpreter
   182	            lexer
   183	            (LexerATNSimulator.
   184	              lexer
   185	              ^ATN lexer-atn
   186	              ^"[Lorg.antlr.v4.runtime.dfa.DFA;" lexer-dfa
   187	              ^PredictionContextCache lexer-cache))
   188	        _ (.removeErrorListeners lexer)
   189	        _ (.addErrorListener lexer ^ANTLRErrorListener listener)
   190	        parser ^Parser ((:make-parser profile) tokens)
   191	        _ (.setInterpreter
   192	            parser
   193	            (ParserATNSimulator.
   194	              parser
   195	              ^ATN parser-atn
   196	              ^"[Lorg.antlr.v4.runtime.dfa.DFA;" parser-dfa
   197	              ^PredictionContextCache parser-cache))
   198	        _ (.removeErrorListeners parser)
   199	        _ (.addErrorListener parser ^ANTLRErrorListener listener)]
   200	    ((:start profile) parser)
   201	    (let [index @failure
   202	          last-real (->> (.getTokens ^CommonTokenStream tokens)
   203	                         (keep (fn [^Token t]
   204	                                 (when (and (not= Token/EOF (.getType t))
   205	                                            (<= (.getStartIndex t)
   206	                                                (.getStopIndex t)))
   207	                                   (.getTokenIndex t))))
   208	                         (reduce max -1))]
   209	      (cond
   210	        (nil? index) nil
   211	        (and (int? index) (> index last-real)) :end
   212	        :else :early))))
   213	
   214	
   215	;; =============================================================================
   216	;; Probe
   217	;; =============================================================================
   218	
   219	(defn- last-line-blank?
   220	  [text]
   221	  (str/blank? (peek (str/split text #"\n" -1))))
   222	
   223	
   224	(defn probe
   225	  [text]
   226	  (let [{:keys [error string string-at continued brackets block?]} (scan text)
   227	        open? (boolean (or continued (seq brackets)))]
   228	    (cond
   229	      error :complete
   230	      ;; the open string stands as an empty one: an error on it or before
   231	      ;; it is not mended by more lines
   232	      string (if (= :early (first-failure (str (subs text 0 string-at)
   233	                                               "''\n")))
   234	               :complete
   235	               :incomplete)
   236	      (and (not open?) (last-line-blank? text)) :complete
   237	      :else (case (first-failure (str text "\n"))
   238	              nil (if (or open? block?) :incomplete :complete)
   239	              :end :incomplete
   240	              :early :complete))))
     1	(ns yang.python.antlr.repl
     2	  "The Python ANTLR frontend's REPL lowering (docs/design/yang.antlr.md
     3	   section 8.5.6, slice F3). Portable: the parser is JVM-only, but a host
     4	   that holds a CST packet lowers it here.
     5	
     6	   One REPL submission lowers to a program that runs the packet's module body
     7	   against the session's `__main__` namespace: the module object and its
     8	   globals dict live in `sys.modules` (ruling 18), so a name bound by one
     9	   submission is read by the next. `(reset)` rebuilds the VM, and with it the
    10	   runtime state.
    11	
    12	   The bundled prelude defines the runtime in the VM's store and `py/init!`
    13	   allocates its task state; running it twice would discard that state. The
    14	   first lowering of a session therefore carries the prelude and returns the
    15	   session marker `:primed`; later lowerings of the same session omit it. The
    16	   shell keeps the marker (`:frontend-session`) and clears it with the VM.
    17	
    18	   Printed lines and an uncaught exception are rendered by the host
    19	   primitive `py-report` (`report`) and written with the shell's own
    20	   `println`, so they arrive on the output medium in order."
    21	  (:require
    22	    [clojure.string :as str]
    23	    [yang.antlr.packet :as p]
    24	    [yang.python.antlr.lower :as lower]
    25	    [yang.python.antlr.prelude :as prelude]
    26	    [yang.python.antlr.render :as render]
    27	    [yang.python.antlr.uast :as u]))
    28	
    29	
    30	(def report-primitive
    31	  "The primitive name the lowered program calls."
    32	  'py-report)
    33	
    34	
    35	(defn report
    36	  "The text of one submission: each `print` call's line, then the uncaught
    37	   exception as `Type: args`, newline separated. Empty when it did neither."
    38	  [out exception]
    39	  (str/join
    40	    "\n"
    41	    (cond-> (mapv render/line out)
    42	      exception (conj (str (:type exception)
    43	                           (when (seq (:args exception))
    44	                             (str ": " (str/join " "
    45	                                                 (map render/py-str
    46	                                                      (:args exception))))))))))
    47	
    48	
    49	(def primitives
    50	  "The host primitives the lowered program needs, for a shell's `:primitives`."
    51	  {report-primitive report})
    52	
    53	
    54	(def ^:private run-form
    55	  '(do (cell/set! py.rt/out [])
    56	       (cell/set! py.rt/ctx (py/ctx nil 0 0 nil))
    57	       (let [hit (py/modules-ref (py/str "__main__"))
    58	             m (if (= hit :py/missing)
    59	                 (let [fresh (py/module-new (py/str "__main__") :py/None)]
    60	                   (do (py/modules-put! (py/str "__main__") fresh)
    61	                       fresh))
    62	                 hit)
    63	             d (py/module-dict m)
    64	             exc (py/try (fn []
    65	                           (do (%repl-body d (py/globals-fn d))
    66	                               :py/None))
    67	                         (fn [e] e)
    68	                         (fn [] :py/None))
    69	             text (py-report
    70	                    (cell/get py.rt/out)
    71	                    (if (= exc :py/None) nil (py/snapshot-exc exc)))]
    72	         (if (= text "") nil (println text)))))
    73	
    74	
    75	(defn- ok-packet!
    76	  [packet]
    77	  (if (= :yang.cst/ok (:yang.cst/outcome packet))
    78	    packet
    79	    (throw (ex-info
    80	             (let [e (first (:yang.cst/errors packet))]
    81	               (str "SyntaxError: " (:message e)
    82	                    (when (:line e) (str " (line " (:line e) ")"))))
    83	             {:yang.python.antlr/diagnostic :yang.python.antlr/syntax
    84	              :errors (:yang.cst/errors packet)}))))
    85	
    86	
    87	(defn lower-session
    88	  "`[ast session']` for one ok CST `packet` under `session` (nil on a fresh
    89	   session, `:primed` once the prelude has run)."
    90	  [packet session]
    91	  (let [packet (ok-packet! packet)
    92	        packet (cond-> packet
    93	                 (not (contains? packet :yang.python.antlr/max-digits))
    94	                 (assoc :yang.python.antlr/max-digits 4300))
    95	        _ (p/validate! packet)
    96	        body (lower/lower-module-body packet)
    97	        main (u/let1 '%repl-body
    98	                     (u/lam [lower/globals-sym lower/globals-fn-sym] body)
    99	                     (u/sexp->uast run-form))
   100	        ast (u/mark-tails (if (= :primed session)
   101	                            main
   102	                            (u/then prelude/uast main)))]
   103	    [ast :primed]))
   104	
   105	
   106	(defn lower
   107	  "The stateless lowering: a program that carries the prelude."
   108	  [packet]
   109	  (first (lower-session packet nil)))
     1	(ns yin.repl.python-antlr-test
     2	  "Slice F3 (docs/design/yang.antlr.md section 8.5.6): the Python ANTLR
     3	   frontend at the REPL. State persists across submissions, the shell
     4	   shows what a submission printed and not its value, a failed round
     5	   keeps the session's runtime state as it was, a round parked on a
     6	   require commits its frontend session only when it completes, and
     7	   `(reset)` and `(vm ...)` start a new process.
     8	
     9	   The parser is JVM-only, so the session scenarios run on every host
    10	   through a binding whose parse stage answers the parser's packets,
    11	   precompiled below (each def's docstring is the source the REPL hands
    12	   the parser); on the JVM they run through the installed frontend too,
    13	   and the packets are checked against the parser so the two cannot
    14	   drift. The completeness probe is JVM-only, as the parser is."
    15	  (:require
    16	    [clojure.string :as str]
    17	    [clojure.test :refer [deftest is testing]]
    18	    [dao.jing.mem :as mem]
    19	    [dao.stream :as stream]
    20	    [dao.stream.ringbuffer :as ring]
    21	    [yang.clojure :as yang.clojure]
    22	    [yang.frontend :as frontend]
    23	    [yang.python.antlr.c3-programs :refer [asg call e ex lit op st tc tx vr]]
    24	    [yang.python.antlr.lower-portable-test :refer [packet]]
    25	    [yang.python.antlr.repl :as python.repl]
    26	    #?@(:cljd [] :clj [[yang.python.antlr.parser :as parser]
    27	                       [yang.python.antlr.repl-probe :as probe]])
    28	    [yin.repl :as repl]
    29	    [yin.repl.frontends :as frontends]
    30	    [yin.repl.link :as link]
    31	    [yin.vm.linker.publish :as publish]))
    32	
