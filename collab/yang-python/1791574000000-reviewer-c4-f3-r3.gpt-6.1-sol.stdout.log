    99	(defn- feed
   100	  "Submit each line in order; every `[state text]` answered."
   101	  [state lines]
   102	  (rest (reductions (fn [[st _] line] (repl/eval-input st line))
   103	                    [state nil]
   104	                    lines)))
   105	
   106	
   107	(defn- texts
   108	  [state lines]
   109	  (mapv second (feed state lines)))
