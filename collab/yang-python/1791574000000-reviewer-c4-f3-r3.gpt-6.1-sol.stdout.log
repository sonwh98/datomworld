   200	(defn- counting-session
   201	  "A shell on a Clojure binding whose lowering counts its rounds in the
   202	   frontend session, so the marker shows which round was committed."
   203	  [opts]
   204	  (let [catalog (frontend/install
   205	                  (frontends/standard)
   206	                  counting-manifest
   207	                  {:input :forms,
   208	                   :parse identity,
   209	                   :lower #(yang.clojure/compile (first %)),
   210	                   :lower-session (fn [forms n]
   211	                                    [(yang.clojure/compile (first forms))
   212	                                     (inc (or n 0))])})]
   213	    (first (repl/eval-input
   214	             (frontends/create-state (merge {:frontends catalog,
   215	                                             :vm-type :stack}
   216	                                            opts))
   217	             "(lang :yang.test/counting)"))))
