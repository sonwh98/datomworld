    82	(defn- session
    83	  "A shell switched to `lang`, composed with `opts`."
    84	  ([lang] (session lang {}))
    85	  ([lang opts]
    86	   (first (repl/eval-input
    87	            (frontends/create-state (merge {:frontends (cst-catalog)} opts))
    88	            (str "(lang " lang ")")))))
    89	
    90	
    91	(def ^:private langs
    92	  "The ids every session scenario runs under: the precompiled packets on
    93	   every host, and the installed parser where it runs."
    94	  #?(:cljd [:yang.python/cst]
    95	     :clj [:yang.python/cst :yang.python/antlr]
    96	     :cljs [:yang.python/cst]))
