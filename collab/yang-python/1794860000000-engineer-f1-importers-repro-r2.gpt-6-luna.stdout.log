{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' test/yang/python/antlr/dht_import_fixture.cljc && sed -n '840,915p' test/yang/python/antlr/dht_import_test.cljc && sed -n '1,180p' shadow-cljs.edn && cat test/resources/yang/python/dht-import-v1.edn\"","aggregated_output":"(ns yang.python.antlr.dht-import-fixture\n  \"The JVM publication artifact of C4 slice I3's DHT import\n   (docs/design/yang.antlr.md 8.5.6): test/resources/yang/python/\n   dht-import-v1.edn, written on the JVM by\n   test/resources/yang/python/dht-import-v1.generate.clj.\n\n   It holds what a publisher `A` publishes and signs: the guest blobs of\n   the units m, k, t and e and of k's republication k2 (every blob of\n   their closures but `py`'s, which each reader has installed, and each\n   module's site set blob and publication record blob, I7), each\n   unit's manifest address, the signed name envelopes of three index\n   transactions -- `A` naming py, yang.call, m, k and t; `A` retracting k and\n   naming k2; a foreign principal `B` naming e -- and the importer\n   packets the reader lowers, and a fourth index transaction of `A`'s signed\n   site-set publication entries (I7). The keys are fixed test seeds, and Ed25519\n   signatures are deterministic, so one host's `generate` is the file\n   byte for byte.\n\n   `yang.python.antlr.dht-import-test` consumes the file on every host\n   without republishing anything, and checks that this host's own\n   `generate` equals it: a host whose publication of the same packets\n   differs from the JVM's fails there.\n\n   One EDN form per line: the magic, the header maps, then one\n   `[address hex]` line per blob in address order.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.string :as str]\n    [dao.jing :as jing]\n    [dao.jing.cbor-fixtures :as cfx]\n    [dao.jing.dht :as jing.dht]\n    [dao.jing.mem :as mem]\n    [yang.python.antlr.import-programs :as programs]\n    [yang.python.antlr.linked-harness :as h]\n    [yang.python.antlr.publication :as publication]\n    [yang.python.antlr.siteset :as siteset]\n    [yin.vm.linker.closure :as closure]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.linker.sign :as sign]))\n\n\n(def path\n  \"The artifact, relative to the repository root.\"\n  \"test/resources/yang/python/dht-import-v1.edn\")\n\n\n(def magic \"dht-import-v1\")\n\n\n(def key-a\n  \"The publisher `A`: a fixed test seed.\"\n  (let [seed (apply str (repeat 32 \"a1\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(def key-b\n  \"The foreign principal `B`: a fixed test seed.\"\n  (let [seed (apply str (repeat 32 \"b2\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(defn closure-addresses\n  \"Every blob address of the closure of `manifest` in `store`: the reads\n   one closure walk makes.\"\n  [store manifest]\n  (let [seen (atom #{})\n        get-bytes (:get-bytes-fn store)\n        recording (assoc store\n                         :get-bytes-fn\n                         (fn [address not-found]\n                           (swap! seen conj address)\n                           (get-bytes address not-found)))]\n    (closure/walk recording manifest)\n    @seen))\n\n\n(defn installed-py\n  \"`py`'s closure as this host published it, `{address bytes}`: the\n   Python runtime every reader has installed. It does not travel: three\n   of its blobs (the code images, about 1 MB each) exceed the DHT's\n   64 KiB message bound, which a `dao.space.dht` node does not let a\n   composition raise.\"\n  []\n  (let [{:keys [store address]} @h/published]\n    (select-keys ((:entries-fn store)) (closure-addresses store address))))\n\n\n(defn installed-pysp\n  \"`pysp`'s closure as this host published it, `{address bytes}`: the hook\n   runtime a reader under a hook profile has installed, as it has `py`\n   (the closure includes `py`'s).\"\n  []\n  (let [{:keys [store]} @h/published\n        pysp (:address @h/published-pysp)\n        addresses (closure-addresses store pysp)]\n    (select-keys ((:entries-fn store)) addresses)))\n\n\n(defn- unit\n  [nm pk]\n  {:name nm, :packet pk, :package? false})\n\n\n(defn- assert-names\n  \"`key`'s assertions binding each `[module address]` of `bound`, at\n   consecutive sequences from `seq0`.\"\n  [key seq0 bound]\n  (vec (map-indexed (fn [i [n a]]\n                      (publish/assertion key {:name n,\n                                              :manifest a,\n                                              :seq (+ seq0 i)}))\n                    bound)))\n\n\n(defn- signed-only\n  [signed]\n  (mapv #(select-keys % [:envelope :proof]) signed))\n\n\n(defn generate\n  \"This host's artifact: the units published from the committed packets\n   into a store holding `py` as this host published it, `A`'s and `B`'s\n   envelopes signed over the addresses. Answers `{:lines [...]}`, or the\n   first publication refusal as `{:refused r}`.\"\n  []\n  (let [py (:address @h/published)\n        installed (installed-py)\n        store (mem/create-content-mem installed)\n        units (publication/publish-units!\n                store (h/registry) py\n                [(unit \"m\" programs/m-packet) (unit \"k\" programs/k-packet)\n                 (unit \"t\" programs/t-packet) (unit \"e\" programs/e-packet)])\n        k2 (publication/publish-units! store (h/registry) py\n                                       [(unit \"k\" programs/k2-packet)])]\n    (if-let [refused (some #(when (not= :ok (:status %)) %) [units k2])]\n      {:refused refused}\n      (let [addresses (:addresses units)\n            own (assert-names key-a 1 [['py py]\n                                       ['yang.call (:call-address @h/published)]\n                                       ['pym.m (get addresses \"m\")]\n                                       ['pym.k (get addresses \"k\")]\n                                       ['pym.t (get addresses \"t\")]])\n            republish [(publish/retraction\n                         key-a\n                         {:of (jing/segment-key (:envelope (nth own 3))),\n                          :seq 6})\n                       (publish/assertion\n                         key-a\n                         {:name 'pym.k,\n                          :manifest (get-in k2 [:addresses \"k\"]),\n                          :seq 7})]\n            foreign (assert-names key-b 1 [['pym.e (get addresses \"e\")]])\n            ;; I7: A's signed publication entry for each module's site-set\n            ;; record, the units' then k's republication\n            sites (into []\n                        (mapcat #(siteset/signed-entries\n                                   key-a (:sites %) (:addresses %)\n                                   (:bundles %)))\n                        [units k2])\n            blobs (sort-by (comp str key)\n                           (remove (fn [[a _]] (contains? installed a))\n                                   ((:entries-fn store))))]\n        {:lines\n         (into [magic\n                (pr-str {:py py})\n                (pr-str {:principals {:a (:public key-a),\n                                      :b (:public key-b)}})\n                (pr-str {:units addresses,\n                         :republished {\"k\" (get-in k2 [:addresses \"k\"])}})\n                (pr-str {:importers {:d programs/d-packet,\n                                     :tt programs/tt-packet,\n                                     :x programs/x-packet}})\n                (pr-str {:index :own, :signed (signed-only own)})\n                (pr-str {:index :republish, :signed (signed-only republish)})\n                (pr-str {:index :foreign, :signed (signed-only foreign)})\n                (pr-str {:index :sites, :signed sites})]\n               (map (fn [[a bs]] (pr-str [a (jing.dht/bytes->hex bs)])))\n               blobs)}))))\n\n\n(defn text\n  \"The artifact text of `lines`: one per line, newline terminated.\"\n  [lines]\n  (str (str/join \"\\n\" lines) \"\\n\"))\n\n\n(defn read-lines\n  \"The artifact's lines, blank ones dropped (Dart keeps a trailing one).\"\n  []\n  (vec (remove str/blank? (str/split-lines (cfx/read-path path)))))\n\n\n(defn parse\n  \"Artifact `lines` as data, `{:py :principals :units :republished\n   :importers :indexes {kind [signed ...]} :blobs {address hex}}`: what\n   two artifacts are compared by, since a host prints a map's entries in\n   its own order.\"\n  [lines]\n  (let [[m & forms] lines]\n    (when-not (= magic m)\n      (throw (ex-info \"not a dht-import-v1 artifact\" {:path path})))\n    (reduce (fn [acc line]\n              (let [form (edn/read-string line)]\n                (cond\n                  (vector? form) (assoc-in acc [:blobs (first form)]\n                                           (second form))\n                  (:index form) (assoc-in acc [:indexes (:index form)]\n                                          (:signed form))\n                  :else (merge acc form))))\n            {:blobs {}, :indexes {}}\n            forms)))\n\n\n(defn read-file\n  \"The checked-in artifact, `parse`'s data with each blob as host\n   bytes.\"\n  []\n  (update (parse (read-lines))\n          :blobs\n          (fn [blobs]\n            (into {} (map (fn [[a hex]] [a (jing.dht/hex->bytes hex)]))\n                  blobs))))\n        m (get-in artifact [:units \"m\"])\n        bogus (jing/segment-key {:nobody :holds-this-record})\n        w (publish-world artifact)\n        [w _] (publish-index w [(siteset/signed-entry fixture/key-a m bogus)])\n        src (hook-source artifact)\n        run (fn [w]\n              (run-over-dht w :semantic (get-in artifact [:importers :d]) src\n                            noting-waits {:signals []}))\n        [w outcome response _] (run w)\n        _ (testing \"the miss is a refusal naming the record address\"\n            (is (= \"ImportError\" (get-in (nth outcome 2)\n                                         [:py/exception :type])))\n            (is (= :absent (:reason response)) (pr-str response))\n            (is (= bogus (:address response)) (pr-str response)))\n        _ (testing \"the failed stage load is forgotten\"\n            (is (nil? (ld/stage-status (:reader w) m))))\n        [w outcome response _] (run w)]\n    (testing \"a second require starts a fresh stage load and is refused again\"\n      (is (= :absent (:reason response)) (pr-str response))\n      (is (= \"ImportError\" (get-in (nth outcome 2) [:py/exception :type]))))\n    (dht/close! (:pub w))\n    (dht/close! (:reader w))))\n\n\n(defn- dht-import-test\n  []\n  (let [lines (fixture/read-lines)\n        _ (this-host-publishes-the-artifact lines)\n        artifact (fixture/read-file)\n        a (get-in artifact [:principals :a])\n        src (source [a] [a])\n        w (publish-world artifact)\n        w (hook-import-refused-without-the-index w artifact)\n        w (site-sets-over-the-mesh w artifact)\n        w (hook-import-with-the-index w artifact)\n        w (a-hook-import-chain w artifact)\n        w (imports-over-the-dht w artifact src)\n        w (an-untrusted-principal-is-refused-on-every-vm w artifact)\n        w (a-trusted-principal-is-allowed-on-every-vm w artifact)\n        w (an-allow-binds-the-address-the-question-was-asked-about\n            w artifact)\n        w (republished-dependency-is-refused w artifact src)]\n    (dht/close! (:pub w))\n    (dht/close! (:reader w))\n    (an-absent-record-is-refused-and-retried)))\n\n\n(deftest ^:slow dht-import-test-test\n  (slow/guard \"dht-import-test\" dht-import-test))\n;; shadow-cljs configuration\n;; Source paths come from deps.edn (:paths plus the :cljs alias's\n;; :extra-paths); shadow ignores any :source-paths set here when :deps\n;; is used.\n{:deps {:aliases [:cljs]}\n\n :dev-http {9000 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl.main/-main\n                        :output-to \"target/yin-repl.js\"}}}\ndht-import-v1\n{:py :segment/blake3-d9aead51dc2da70f8dcd8935f2a8c3bc052037967064b45d1914897ad03a6a9c}\n{:principals {:a \"bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5\", :b \"55154f42065ea5a1bea05463826be2684eb92df92c100027aabaae57ca554207\"}}\n{:units {\"m\" :segment/blake3-c23956287e72eb1bd12ede2fb38978df7091a0e348e43c9fa7d9f3661cc743f8, \"k\" :segment/blake3-c11144123b88240594cb05e358bbbf33e3451a77f2cfb512f07d6639c599c1e7, \"t\" :segment/blake3-00f50692fd4b42ce841dcfaf9f3f6ae2844afc96c9429a6fe55caf0c2b54a808, \"e\" :segment/blake3-763c0c50cf30597497fe7dcb2916b3d5d365074bd6115ed6d25235902a1b59d3}, :republished {\"k\" :segment/blake3-aef6a291e09f74fd065c426e7aec513ce31f89622fbb2cda1236222edf877fd7}}\n{:importers {:d #:yang.cst{:version 1, :unit [:hand 0], :grammar \"hand\", :outcome :yang.cst/ok, :root 0, :nodes [{:id 0, :kind :rule, :rule \"file_input\", :children [1 13 45 76], :span [0 0]} {:id 1, :kind :rule, :rule \"stmt\", :children [2], :span [0 0]} {:id 2, :kind :rule, :rule \"simple_stmts\", :children [3 12], :span [0 0]} {:id 3, :kind :rule, :rule \"simple_stmt\", :children [4], :span [0 0]} {:id 4, :kind :rule, :rule \"import_stmt\", :children [5], :span [0 0]} {:id 5, :kind :rule, :rule \"import_name\", :children [6 7], :span [0 0]} {:id 6, :kind :token, :type \"IMPORT\", :tex