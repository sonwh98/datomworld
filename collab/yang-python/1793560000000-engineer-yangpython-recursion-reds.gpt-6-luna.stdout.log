{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '450,520p' test/yang/python/antlr/safepoint_test.cljc && sed -n '450,510p' test/yang/python/antlr/linked_safepoint_test.cljc && sed -n '1,120p' deps.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '450,520p' test/yang/python/antlr/safepoint_test.cljc && sed -n '450,510p' test/yang/python/antlr/linked_safepoint_test.cljc && sed -n '1,120p' deps.edn\"","aggregated_output":";; =============================================================================\n;; Recursion (slice 2): depth accounting at :call and :return\n;; =============================================================================\n\n(def ^:private derived-ast\n  \"`A'` for `pk` under `hooks/profile`, memoized: `pk` is a constant\n   packet and `A'` an immutable value (`insertion-is-deterministic-test`\n   still derives twice through `derive*`).\"\n  (memoize\n    (fn [pk]\n      (vm/semantic-bytecode->ast\n        (tree-of (:derived (derive* pk hooks/profile)))))))\n\n\n(defn- with-run\n  \"`A'`, which is `(then prelude run)`, with its run replaced by `(f run)`.\"\n  [a' f]\n  (tails/remark-tails (update-in a' [:operator :body] f)))\n\n\n(defn- hooked\n  \"Every VM's outcome for `ast` under the real hook prelude.\"\n  [ast]\n  (on-every-vm (hooks/program hooks/uast ast) (with-signals []) outcome))\n\n\n(defn- recursion-error\n  []\n  (testing \"the default limit, exactly: f(999) is 1000 frames and completes;\n            f(1000) raises RecursionError, caught by except RecursionError;\n            probe(1) finds the limit at 1000 frames\"\n    (every= [true false {:py/out [\"0\" \"rec\" \"1000\"], :py/exception nil}]\n            (hooked (derived-ast programs/recursion)))))\n\n\n(deftest ^:slow recursion-error-test\n  (slow/guard \"recursion-error-test\"\n              recursion-error))\n\n\n(defn- limited\n  \"`A'` for `pk` run under recursion limit `n`, set before the module runs.\"\n  [pk n]\n  (with-run (derived-ast pk)\n    #(u/then (u/sexp->uast (list 'py.sp/set-recursion-limit! n)) %)))\n\n\n(defn- escape-restores-depth\n  []\n  (testing \"under limit 100: a raise through 50 frames with finally restores\n            the depth saved at the catching try, so probe finds 100 frames\n            again, neither fewer (depth left high) nor more (depth left\n            low), and 89 from 11 frames down. A finally thunk runs at its\n            frame's depth: while a RecursionError unwinds, the finally of\n            each of frames 1..99 calls h() within the limit; only frame\n            100's call exceeds it\"\n    (every= [true false {:py/out [\"unwound\" \"100\" \"89\" \"100\" \"99\" \"100\"],\n                         :py/exception nil}]\n            (hooked (limited programs/unwind 100)))))\n\n\n(deftest ^:slow escape-restores-depth-test\n  (slow/guard \"escape-restores-depth-test\"\n              escape-restores-depth))\n\n\n(defn- generator-depth\n  []\n  (testing \"under limit 100, depth measures the current continuation. A\n            generator resumed 20 frames down runs on top of its resumer\n            (its own frame is the 21st), so probe inside finds 79; resumed\n\n\n(deftest ^:slow linked-no-park-test\n  (slow/guard \"linked-no-park-test\" no-park))\n\n\n(defn- registered-handler-runs\n  []\n  (testing \"a registered Python handler is called with the signal and None,\n            and the program goes on; registered after `pysp/attach!`, so\n            `py/make-function` builds the function object\"\n    (let [set-handler (u/sexp->uast\n                        '(pysp/set-handler!\n                           (py/make-function \"h\" {:params [\"s\" \"f\"]} [] []\n                                             (fn [args] (py/print (py/vconj [] (py/arg args 0)))))))\n          ast (hooks/linked-program\n                (u/then set-handler (derived-ast programs/def-and-while)))]\n      (every= [true false {:py/out [\"7\" \"5\"], :py/exception nil}]\n              (on-every-vm ast [7])))))\n\n\n(deftest ^:slow linked-registered-handler-test\n  (slow/guard \"linked-registered-handler-test\" registered-handler-runs))\n\n\n(defn- recursion-error\n  []\n  (testing \"the default limit through the module boundary: f(999) is 1000\n            frames and completes; f(1000) raises RecursionError, caught by\n            except; probe(1) finds the limit at 1000 frames\"\n    (every= [true false {:py/out [\"0\" \"rec\" \"1000\"], :py/exception nil}]\n            (linked-run programs/recursion []))))\n\n\n(deftest ^:slow linked-recursion-error-test\n  (slow/guard \"linked-recursion-error-test\" recursion-error))\n\n\n(defn- escape-restores-depth\n  []\n  (testing \"under limit 100: a raise through 50 frames with finally\n            restores the depth saved at the catching try (probe finds 100\n            frames again), and a finally thunk runs at its frame's depth\"\n    (every= [true false {:py/out [\"unwound\" \"100\" \"89\" \"100\" \"99\" \"100\"],\n                         :py/exception nil}]\n            (limited-run programs/unwind 100 []))))\n\n\n(deftest ^:slow linked-escape-restores-depth-test\n  (slow/guard \"linked-escape-restores-depth-test\" escape-restores-depth))\n\n\n(defn- generator-depth\n  []\n  (testing \"under limit 100: depth measures the current continuation across\n            the module boundary as it does bundled — a generator resumed 20\n            frames down runs on top of its resumer, is rebased by a later\n            resume, and every crossing back restores the caller's record\"\n    (every= [true false {:py/out [\"79\" \"99\" \"100\" \"79\" \"100\" \"79\" \"99\"\n                                  \"100\"],\n                         :py/exception nil}]\n{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\" \"build/antlr/php/classes\"\n         \"build/antlr/typescript/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n          