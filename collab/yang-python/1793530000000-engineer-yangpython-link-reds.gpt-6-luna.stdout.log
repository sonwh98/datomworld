inks [f :status])) (str f))))\n    (testing \"publishing twice into one store answers one address\"\n      (is (= address\n             (:address (publish/publish-module!\n                         store (hooks/module-spec (h/registry)\n                                                  (:address @h/published)))))))))\n","exit_code":0,"status":"completed"}}
