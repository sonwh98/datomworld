{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2050,2190p' src/cljc/yang/python/antlr/lower.cljc && clojure -M:test -i :slow -n yang.python.antlr.siteset-test\"","aggregated_output":"   import_module calls that deliver guest modules need the linked profile.\"\n  ([packet] (lower-packet packet {}))\n  ([packet {:keys [prelude], :or {prelude :bundled}}]\n   (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n         main (app* 'py/run-main\n                    (u/lam [globals-sym globals-fn-sym]\n                           (lower-module-body packet)))]\n     (u/mark-tails\n       (case prelude\n         :bundled (if-not (preseeded-imports-only? pk)\n                    (throw (ex-info\n                             \"Imports need the linked prelude (docs/design/yang.antlr.md 8.5.6)\"\n                             {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n                              :construct \"import under the bundled prelude\"}))\n                    (u/then prelude/uast main))\n         :linked (u/seq-nodes\n                   [(app* 'require (u/lit 'yang.call))\n                    (app* 'require (u/lit prelude/module-name))\n                    (app* 'py/init!) main]))))))\n\n\n;; =============================================================================\n;; The module emitter: one Python unit as the linker module pym.<name>\n;; =============================================================================\n\n(def ^:private require-node core-module/require-node)\n\n\n(defn- calls-yang-call?\n  [ast]\n  (some (fn [n]\n          (and (symbol? n) (= \"yang.call\" (namespace n))))\n        (prelude/free-names ast)))\n\n\n(def module-exports\n  \"The exports of a compiled Python unit: its spec and body, immutable\n   after install (docs/design/yang.antlr.md 8.5.6's module shape).\"\n  '#{spec body})\n\n\n(defn- validate-module-name!\n  [name]\n  (when (or (empty? name)\n            (str/starts-with? name \".\")\n            (str/ends-with? name \".\")\n            (str/includes? name \"..\")\n            (str/includes? name \"$\"))\n    (throw (ex-info \"a module name is dotted identifiers\"\n                    {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n                     :construct \"malformed module name\",\n                     :name name}))))\n\n\n(defn module-packet\n  \"One ok packet as the linker module `pym.<mangled>`: one wide\n   application requiring `yang.call` first when the body reads that\n   convention, then `py`, then defining spec and body. Guest imports deliver\n   at statement time; module-spec\n   still pins every static import. `name` is\n   the dotted Python module name and `package?` (default false) whether\n   the unit is a package, which is source layout, not derivable from\n   rows: the spec records both, the runtime derives `__package__` from\n   them, and the lowering resolves relative imports against them. The\n   body is the same form `lower-packet` runs as `__main__`: one code\n   image, two roles.\"\n  [packet {:keys [name package?]}]\n  (validate-module-name! name)\n  (let [unit {:name name, :package? (boolean package?)}\n        body (u/lam [globals-sym globals-fn-sym]\n                    (lower-module-body packet unit))\n        defs [(u/def! 'spec (u/lit unit)) (u/def! 'body body)]\n        operands (into (vec (concat (when (calls-yang-call? body)\n                                      [(require-node 'yang.call)])\n                                    [(require-node prelude/module-name)]))\n                       defs)\n        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))\n\n\n(defn- declare-free-name\n  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n   when `covered` (the requirement-pinned module names) covers it.\"\n  [registry covered n]\n  (core-module/declare-free-name :yang.python.antlr/refusal\n                                 :yang.python.antlr/undeclared-free\n                                 registry covered n))\n\n\n(defn primitive-declaration\n  \"The `:primitives` profile free name `n` declares over `registry` (a bare\n   primitive's `vm/primitives` profile, or a host export's), as\n   `module-spec` declares it; throws on an undeclared name.\"\n  [registry n]\n  (second (declare-free-name registry #{} n)))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the Python module\n   `name` over the host registry `registry`, requiring `py` at\n   `py-address` and each imported module at its manifest address in\n   `deps` ({python-name address}). A free name of the module tree is\n   declared one of three ways, as the hook prelude's emitter declares\n   its own: a name qualified by `py` or by an imported `pym.<i>` is\n   covered by that requirement, discharged by a linked module of equal\n   manifest address; a bare name is a primitive declared by its\n   `vm/primitives` profile; any other `ns/name` is a host export\n   declared by the profile address the registry's host module `ns`\n   publishes. A free name none of these supplies is refused before\n   anything is published. `package?` is `module-packet`'s. This\n   namespace emits; it never publishes.\"\n  [registry packet {:keys [name package? py-address call-address deps]}]\n  (core-module/module-spec\n    :yang.python.antlr/refusal :yang.python.antlr/undeclared-free registry\n    {:name (module-symbol name),\n     :ast (module-packet packet {:name name, :package? package?}),\n     :exports module-exports,\n     :runtime-name prelude/module-name,\n     :runtime-address py-address,\n     :deps (cond-> (into {} (map (fn [[n a]] [(module-symbol n) a])) deps)\n             (calls-yang-call? (module-packet packet {:name name, :package? package?}))\n             (assoc 'yang.call call-address))}))\n\n\n(def ^:private module-tree core-module/module-tree)\n\n\n(def ^:private initializing-key :yang.python.antlr/initializing)\n\n\n(defn- cyclic-import-from\n  \"Preserve IMPORT_FROM's attribute/submodule fallback, specializing its\n   failure only while the target's task-local module object is initializing.\"\n  [m n]\n  (u/let1 '%from-module m\n          (u/let1 '%from-name n\n                  (u/let1 '%from-result (app* 'cell/new none)\n                          (app* 'py/try\n                                (u/lam [] (app* 'cell/set! (u/v '%from-result)\n                                                (app* 'py/import-from (u/v '%from-module) (u/v '%from-name))))\n                                (u/lam ['%from-error]\nDEPRECATED: Libs must be qualified, change codox => codox/codox (/Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/deps.edn)\nDEPRECATED: Libs must be qualified, change codox => codox/codox (/Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/deps.edn)\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.python.antlr.siteset-test\n\nERROR in (import-with-set-is-instrumented-test) (engine.cljc:52)\nUncaught exception, not in assertion.\nexpected: nil\n  actual: clojure.lang.ExceptionInfo: Module link refused: missing-site-set\n{:name yang.call, :yin.link/id [:t0 2], :manifest :segment/blake3-466b53cc8bddc0008e276a8a757a1361ca9b9801bf3372ce0d50948a0c35ff13, :reason :yang.python.antlr/missing-site-set, :status :refused, :link-module yang.call, :profile :py/hooks, :message \"profile :py/hooks requires hooks: no published site set for the module\", :yin.link/canonical :segment/blake3-466b53cc8bddc0008e276a8a757a1361ca9b9801bf3372ce0d50948a0c35ff13}\n at yin.vm.engine$fail.invokeStatic (engine.cljc:52)\n    yin.vm.engine$fail.invoke (engi