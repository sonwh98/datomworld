efore anything is published. This namespace emits; it never\n   publishes.\"\n  [registry call-address]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {'yang.call call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the py module reads an undeclared name\",\n                     :refusal-ns \"yang.python.antlr\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: every inline\n   literal (up to 2^53 - 1) must fit (C3 S2).\"\n  53)\n\n\n(defn register-integer-module\n  \"Return `registry` with the `integer` module installed under `limits`\n   for this profile: refused when `::integer/max-bits` is under\n   `min-integer-bits`, otherwise `integer/register-integer-module`.\"\n  [registry limits]\nsrc/cljc/yang/python/antlr/prelude.cljc:3738:  [registry call-address]\nsrc/cljc/yang/python/antlr/prelude.cljc:3742:                     :requires {'yang.call call-address},\nsrc/cljc/yang/python/antlr/lower.cljc:2161:  [registry packet {:keys [name package? py-address call-address deps]}]\nsrc/cljc/yang/python/antlr/lower.cljc:2171:             (assoc 'yang.call call-address))}))\nsrc/cljc/yang/python/antlr/lower.cljc:2214:  [registry units py-address call-address deps]\nsrc/cljc/yang/python/antlr/lower.cljc:2296:                          needs-call? (assoc 'yang.call call-address))})\nsrc/cljc/yang/python/antlr/lower.cljc:2315:  ([registry units py-address call-address deps]\nsrc/cljc/yang/python/antlr/lower.cljc:2316:   (scc-module-specs* registry units py-address call-address deps)))\nsrc/cljc/yang/python/antlr/publication.cljc:27:  [publish-fn call-address]\nsrc/cljc/yang/python/antlr/publication.cljc:32:                                      :py-address py-address, :