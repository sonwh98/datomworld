\n            relative imports and raises at each executed statement\"\n    (let [program (lower/lower-packet programs/packageless-main-packet\n                                      {:prelude :linked})]\n      (is (= '[yang.call py] (requires-of program)))\n      (is (= 3 (count (call-sites program 'py/import-fail))))\n      (is (empty? (import-calls program)))))\n  (testing \"a package's own `from . import x` resolves to itself: the\n            sys.modules entry answers, so it requires and names nothing\n            of itself\"\n    (let [pk (portable/packet\n               [:file_input\n                (statement\n                  [:import_stmt\n                   [:import_from [\"FROM\" \"from\"] [\"DOT\" \".\"]\n                    [\"IMPORT\" \"import\"]\n                    [:import_as_names [:import_as_name\n                                       [:name [\"NAME\" \"x\"]]]]]])\n                [\"EOF\" \"<EOF>\"]])\n          ast (lower/module-packet pk {:name \"a\", :package? true})]\n      (is (= '[py] (requires-of ast)))\n      (is (= {:name \"a\", :package? true}\n             (get-in (second (:operands ast)) [:operands 1 :value])))\n      (is (some #(= :py/None (get-in % [:operands 1 :value]))\n                (call-sites ast 'py/import))))))\n\n\n(deftest star-imports-lower-at-module-level-only-test\n  (testing \"from m import * copies into the module namespace\"\n  [store py result]\n  (link/composition\n    {:content-store store,\n     :derivation :trusted,\n     :name-env (merge {'py py, 'yang.call (:call-address @h/published)} (:bundles result)\n                      (into {} (map (fn [[n a]] [(lower/module-symbol n) a])) (:addresses result)))}))\n\n\n(defn- bundle-entry\n  [task bundle-name]\n  (module/module-entry (:modules (:modules task)) bundle-name))\n\n\n(deftest bundle-closures-lift-without-cells-test\n  (let [store (mem/create-content-mem)\n        ;; Installation never calls py. A tiny pure dependency keeps this\n        ;; test fast while retaining the real require, admission, and lift.\n        py (publish/publish-module! store {:name 'py, :ast (u/lit nil), :exports #{},\n                                           :requires {}, :primitives {}})\n        result (publication/publish-units! store (h/registry) (:address py)\n                                           [(unit \"a\" [\"b\"]) (unit \"b\" [\"a\"])])\n        source (scc-source store (:address py) result)]\n    (is (keyword? (:address py)) (pr-str (select-keys py [:status :reason :address])))\n    (is (= :ok (:status result)) (pr-str result))\n    (doseq [backend (keys h/backends)]\n      (let [task (h/run-linked backend (u/app (u/v 'try-require) (u/lit 'pym.a))\n                               {:link-source source})\n            entry (bundle-entry task 'pyscc.a$$b)]\n        (is (vm/halted? task) (str backend))\n        (is (= :ok (:status (vm/value task))) (str backend \" \" (pr-str (vm/value task))))\n        (is (= '#{m0-spec m1-spec m0-body m1-body} (set (keys (:slice entry)))) (str backend))\n        (doseq [body-key '[m0-body m1-body]]\n          (let [marker (get-in entry [:slice body-key])\n  [pysp]\n  (assoc requirement\n         :hooks-profile hooks/linked-profile\n         :pysp pysp))\n\n\n(defn- records-of\n  \"`{manifest [record-address]}` for the publication `result`.\"\n  [result]\n  (into {}\n        (map (fn [[n s]]\n               [(get (:addresses result) n) [(:record-address s)]]))\n        (:sites result)))\n\n\n\n\n(defn- published\n  \"A store holding a stand-in manifest of `ast` and its site set:\n   `[store manifest publication]`.\"\n  [ast]\n  (let [store (mem/create-content-mem)\n        tree (:tree (siteset/site-set-of ast))\n        manifest (jing/materialize! store {:yin.module/tree (:root tree)})]\n    [store manifest (siteset/publish! store manifest ast)]))\n\n\n(def ^:private requirement\n  {:profile :py/hooks, :hooks true})\n\n\n(def ^:private key-a\n  (let [seed (apply str (repeat 32 \"a1\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(def ^:private key-b\n  (let [seed (apply str (repeat 32 \"b2\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n","exit_code":0,"status":"completed"}}
