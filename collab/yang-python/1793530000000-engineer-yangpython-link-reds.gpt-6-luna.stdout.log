\\"out\\\" :test/pym.out, \\\"a\\\" :test/pym.a, \\\"b\\\" :test/pym.b},\\n            :bundles {'pyscc.a$$b :test/pyscc.a$$b}}\\n           (publication/publish-units! nil (h/registry) :test/py units {} publish-fn)))\\n    (is (= [{:name 'pym.out, :requires {'py :test/py}}\\n            {:name 'pyscc.a$$b, :requires {'py :test/py, 'pym.out :test/pym.out}}\\n            {:name 'pym.a, :requires {'pyscc.a$$b :test/pyscc.a$$b}}\\n            {:name 'pym.b, :requires {'pyscc.a$$b :test/pyscc.a$$b}}]\\n           @seen))))\\n\\n\\n(deftest alias-refusal-stops-publication-test\\n  (let [seen (atom [])\\n        publish-fn (fn [_ spec]\\n                     (swap! seen conj (:name spec))\\n                     (if (= 'pym.a (:name spec))\\n                       {:status :refused, :reason :test/refused}\\n                       {:status :ok, :address :test/address}))]\\n    (is (= {:status :refused, :reason :test/refused, :unit \\\"a\\\"}\\n           (publication/publish-units! nil (h/registry) :test/py\\n                                       [(unit \\\"a\\\" [\\\"b\\\"]) (unit \\\"b\\\" [\\\"a\\\"])\\n                                        (unit \\\"later\\\" [])] {} publish-fn)))\\n    (is (= '[pyscc.a$$b pym.a] @seen))))\\n\\n\\n(deftest malformed-scc-member-names-test\\n  (doseq [n [\\\"\\\" \\\".a\\\" \\\"a.\\\" \\\"a..b\\\" \\\"a$b\\\"]]\\n    (let [diagnostic (fn [f]\\n                       (try\\n                         (f)\\n                         nil\\n                         (catch #?(:cljd Object :clj clojure.lang.ExceptionInfo :cljs ExceptionInfo) e\\n                           (ex-data e))))\\n          expected {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\\n                    :construct \\\"malformed module name\\\", :name n}]\\n      (is (= expected (diagnostic #(lower/module-packet (:packet (unit n [])) {:name n}))))\\n      ;; No packet is supplied: name validation must precede body lowering.\\n      (doseq [units [[{:name n} {:name \\\"valid\\\"}]\\n                     [{:name \\\"valid\\\"} {:name n}]]]\\n        (is (= expected (diagnostic #(lower/scc-module-specs (h/registry) units :test/py {}))))))))\\n\\n\\n(deftest bundle-refusal-stops-publication-test\\n  (let [seen (atom [])\\n        publish-fn (fn [_ spec]\\n                     (swap! seen conj (:name spec))\\n                     {:status :refused, :reason :test/refused})]\\n    (is (= {:status :refused, :reason :test/refused, :unit \\\"pyscc.a$$b\\\"}\\n           (publication/publish-units! nil (h/registry) :test/py\\n                                       [(unit \\\"a\\\" [\\\"b\\\"]) (unit \\\"b\\\" [\\\"a\\\"])\\n                                        (unit \\\"later\\\" [])] {} publish-fn)))\\n    (is (= '[pyscc.a$$b] @seen))))\\n\\n\\n(deftest dotted-sibling-delivery-test\\n  (let [[bundle] (lower/scc-module-specs (h/registry)\\n                                         [(unit \\\"pkg.a\\\" [\\\"pkg.b\\\"]) (unit \\\"pkg.b\\\" [\\\"pkg.a\\\"])]\\n                                         :test/py {\\\"pkg\\\" :test/pkg})\\n        ast-nodes (nodes (:ast bundle))\\n        names (set (keep #(when (= :variable (:type %)) (:name %)) ast-nodes))]\\n    (is (= 'pyscc.pkg$a$$pkg$b (:name bundle)))\\n    (is (= '#{m0-body m1-body} (set (filter '#{m0-body m1-body} names))))\\n    (is (every? #(symbol? (:name %)) (filter #(= :variable (:type %)) ast-nodes)))\\n    (is (every? #(contains? names %) '[pym.pkg/spec pym.pkg/body]))\\n    (is (every? #(some (fn [node] (= % (:value node))) ast-nodes)\\n                [{:name \\\"pkg.a\\\", :package? false} {:name \\\"pkg.b\\\", :package? false}]))))\\n\\n\\n(defn- scc-source\\n  [store py result]\\n  (link/composition\\n    {:content-store store,\\n     :derivation :trusted,\\n     :name-env (merge {'py py} (:bundles result)\\n                      (into {} (map (fn [[n a]] [(lower/module-symbol n) a])) (:addresses result)))}))\\n\\n\\n(defn- bundle-entry\\n  [task bundle-name]\\n  (module/module-entry (:modules (:modules task)) bundle-name))\\n\\n\\n(deftest bundle-closures-lift-without-cells-test\\n  (let [store (mem/create-content-mem)\\n        ;; Installation never calls py. A tiny pure dependency keeps this\\n        ;; test fast while retaining the real require, admission, and lift.\\n        py (publish/publish-module! store {:name 'py, :ast (u/lit nil), :exports #{},\\n                                           :requires {}, :primitives {}})\\n        result (publication/publish-units! store (h/registry) (:address py)\\n                                           [(unit \\\"a\\\" [\\\"b\\\"]) (unit \\\"b\\\" [\\\"a\\\"])])\\n        source (scc-source store (:address py) result)]\\n    (is (keyword? (:address py)) (pr-str (select-keys py [:status :reason :address])))\\n    (is (= :ok (:status result)) (pr-str result))\\n    (doseq [backend (keys h/backends)]\\n      (let [task (h/run-linked backend (u/app (u/v 'try-require) (u/lit 'pym.a))\\n                               {:link-source source})\\n            entry (bundle-entry task 'pyscc.a$$b)]\\n        (is (vm/halted? task) (str backend))\\n        (is (= :ok (:status (vm/value task))) (str backend \\\" \\\" (pr-str (vm/value task))))\\n        (is (= '#{m0-spec m1-spec m0-body m1-body} (set (keys (:slice entry)))) (str backend))\\n        (doseq [body-key '[m0-body m1-body]]\\n          (let [marker (get-in entry [:slice body-key])\\n                env-key (if (= :semantic backend) :yin.k/env :yin.k/frames)]\\n            (is (contains? marker env-key) (str backend \\\" \\\" body-key))\\n            (is (empty? (get marker env-key)) (str backend \\\" \\\" body-key))))\\n        (is (not-any? #(= :cell-ref (:type %)) (tree-seq coll? seq entry)) (str backend))))))\\n\\n\\n(deftest ^:slow bundle-alias-delivery-and-lift-test\\n  (slow/guard \\\"bundle-alias-delivery-and-lift\\\"\\n              (fn []\\n                (let [units [{:name \\\"ca\\\", :packet programs/ca-packet}\\n                             {:name \\\"cb\\\", :packet programs/cb-packet}]\\n                      {:keys [store address]} @h/published\\n                      result (publication/publish-units! store (h/registry) address units)\\n                      source (scc-source store address result)]\\n                  (is (= :ok (:status result)) (pr-str result))\\n                  (doseq [backend (keys h/backends)]\\n                    ;; The real prelude and both aliases traverse the linker,\\n                    ;; so inspect the bundle slice it actually lifted.\\n                    (doseq [alias '[pym.ca pym.cb]]\\n                      (let [task (h/run-linked backend\\n                                               (u/app (u/v 'try-require) (u/lit alias))\\n                                               {:link-source source})\\n                            answer (vm/value task)\\n                            entry (bundle-entry task 'pyscc.ca$$cb)]\\n                        (is (= :ok (:status answer)) (str backend \\\" \\\" alias \\\" \\\" (pr-str answer)))\\n                        (is (= '#{m0-spec m1-spec m0-body m1-body} (set (keys (:slice entry)))) (str backend))\\n                        (is (not-any? #(= :cell-ref (:type %)) (tree-seq coll? seq entry)) (str backend)))))))))\\n\\n(defn- records-of\\n  \\\"`{manifest [record-address]}` for the publication `result`.\\\"\\n  [result]\\n  (into {}\\n        (map (fn [[n s]]\\n               [(get (:addresses result) n) [(:record-address s)]]))\\n        (:sites result)))\\n\\n\\n(def ^:private no-datoms\\n  {:datoms [], :principals []})\\n\\n\\n(deftest an-scc-member-alias-carries-no-set-test\\n  (let [[store py pysp] (stub-store)\\n        result (publication/publish-units!\\n                 store (h/registry) py\\n                 [{:name \\\"ca\\\", :packet programs/ca-packet}\\n                  {:name \\\"cb\\\", :packet programs/cb-packet}])\\n        bundle (get (:bundles result) 'pyscc.ca$$cb)\\n        alias-a (get (:addresses result) \\\"ca\\\")\\n        bundle-site (get (:sites result) 'pyscc.ca$$cb)\\n        ctx (assoc no-datoms :store store)]\\n    (is (= :ok (:status result)) (pr-str result))\\n    (testing \\\"the marks are in the bundle, which carries the set\\\"\\n      (is (seq (:set bundle-site)))\\n      (is (nil? (siteset/verify store bundle (:record-address bundle-site))))\\n      (is (= :ok (:status (siteset/admit store bundle\\n                                         [(:record-address bundle-site)]\\n                                         requirement)))))\\n    (testing \\\"an alias has no marks and no set\\\"\\n      (is (not (contains? (:sites result) \\\"ca\\\")))\\n      (is (not (contains? (:sites result) \\\"cb\\\"))))\\n    (testing \\\"a member import under a hook profile is refused by the stage,\\n              not run uninstrumented under the lie of an empty set\\\"\\n      (let [out ((siteset/stage (h/registry) (hook-requirement pysp) {})\\n                 ctx 'pym.ca alias-a)]\\n        (is (= :refused (:status out)))\\n        (is (= :yang.python.antlr/missing-site-set (:reason out)))\\n        (is (contains? siteset/reasons (:reason out)))\\n        (is (= 'pym.ca (:name out)))\\n        (is (= :py/hooks (:profile out)))))\\n    (testing \\\"a noninterruptible profile imports the alias as published\\\"\\n      (is (= {:status :ok, :address alias-a}\\n             (select-keys ((siteset/stage (h/registry)\\n                                          {:profile :py/plain,\\n                                           :noninterruptible true}\\n                                          {})\\n                           ctx 'pym.ca alias-a)\\n                          [:status :address]))))\\n    (is (some? bundle))))\\n\\n\\n(deftest the-stage-answers-the-derive-record-test\\n  (let [[store py pysp] (stub-store)\\n        result (publication/publish-units!\\n                 store (h/registry) py\\n                 [{:name \\\"w\\\", :packet loops/while-true-pass}])\\n        manifest (get (:addresses result) \\\"w\\\")\\n        ctx (assoc no-datoms :store store)\\n        out ((siteset/stage (h/registry) (hook-requirement pysp)\\n                            (records-of result))\\n             ctx 'pym.w manifest)\\n        record (jing/get store (:derivation out) nil)\\n        selected (filter (fn [[_ mark]]\\n                           (#{:loop :call} (if (vector? mark) (first mark) mark)))\\n                         (:set (get (:sites result) \\\"w\\\")))\\n        sites-address (jing/segment-key (safepoint/site-set selected))]\\n    (is (= :ok (:status out)) (pr-str out))\\n    (is (not= manifest (:address out)))\\n    (testing \\\"the :derive record is materialized and answered\\\"\\n      (is (= :derive (:yin.ledger/op record)))\\n      (is (= :yang.safepoint/insert (:yin.ledger/function record)))\\n      (is (= (:yin.module/tree (jing/get store manifest nil))\\n             (:yin.ledger/input record)))\\n      (is (= (:yin.module/tree (jing/get store (:address out) nil))\\n             (:yin.ledger/output record)))\\n      (is (= {:yang.safepoint/hooks hooks/linked-profile,\\n              :yang.safepoint/sites sites-address}\\n             (:yin.ledger/profile record))))))\\n\\n\\n(deftest a-dependency-with-no-set-refuses-the-chain-test\\n  (let [[store py pysp] (stub-store)\\n        result (publication/publish-units!\\n                 store (h/registry) py\\n                 [{:name \\\"k\\\", :packet programs/k-packet}\\n                  {:name \\\"t\\\", :packet programs/t-packet}])\\n        records (records-of result)\\n        t (get (:addresses result) \\\"t\\\")\\n        k (get (:addresses result) \\\"k\\\")\\n        stage (siteset/stage (h/registry) (hook-requirement pysp)\\n                             (dissoc records k))\\n        out (stage (assoc no-datoms :store store) 'pym.t t)]\\n    (is (= :ok (:status ((siteset/stage (h/registry) (hook-requirement pysp)\\n                                        records)\\n                         (assoc no-datoms :store store) 'pym.t t))))\\n    (is (= :refused (:status out)))\\n    (is (= :yang.python.antlr/missing-site-set (:reason out)))\\n    (is (= 'pym.k (:name out)))\\n    (is (= t (:via out)))))\\n\\n\\n(deftest the-stage-writes-nothing-until-it-can-complete-test\\n  (let [[store py pysp] (stub-store)\\n        result (publication/publish-units!\\n                 store (h/registry) py\\n                 [{:name \\\"k\\\", :packet loops/while-true-pass}\\n                  {:name \\\"t\\\", :packet programs/t-packet}])\\n        records (records-of result)\\n        t (get (:addresses result) \\\"t\\\")\\n        t-tree (:yin.module/tree (jing/get store t nil))\\n        entries ((:entries-fn store))\\n        stage (siteset/stage (h/registry) (hook-requirement pysp) records)\\n        damaged (mem/create-content-mem (dissoc entries t-tree))\\n        before ((:entries-fn damaged))\\n        out (stage (assoc no-datoms :store damaged) 'pym.t t)]\\n    (testing \\\"the parent's tree is absent after its child is complete\\\"\\n      (is (= {:status :missing, :address t-tree} out))\\n      (is (= (set (keys before)) (set (keys ((:entries-fn damaged)))))\\n          \\\"no blob was written\\\"))\\n    (testing \\\"re-running after the row arrives equals a cold run\\\"\\n      (let [_ (jing/materialize! damaged (jing/get store t-tree nil))\\n            warm (stage (assoc no-datoms :store damaged) 'pym.t t)\\n            cold (stage (assoc no-datoms :store store) 'pym.t t)]\\n        (is (= :ok (:status warm)))\\n        (is (= warm cold))))\\n    (testing \\\"a complete closure is written, the parent reading its child\\\"\\n      (let [full (mem/create-content-mem entries)\\n            ok (stage (assoc no-datoms :store full) 'pym.t t)]\\n        (is (= :ok (:status ok)))\\n        (is (some? (jing/get full (:address ok) nil)))\\n        (is (some? (jing/get full (:derivation ok) nil)))))))\\n\\n\\n;; =============================================================================\\n;; The acceptance: imports on the three vector VMs, through the linker\\n;; =============================================================================\\n\\n(defn- with-signals\\n  [signals]\\n  (fn [task]\\n    (let [handle (tu/new-stream 8)]\\n      (doseq [s signals] (stream/append! handle s))\\n      (let [[ref task] (engine/attach-resource task handle)]\\n        (assoc-in task [:store hooks/signals-key] ref)))))\\n\\n\\n(defn- publish!\\n  \\\"`units` published into the harness store: `publish-units!`'s answer.\\\"\\n  [units]\\n  (let [{:keys [store address]} @h/published\\n        result (publication/publish-units! store (h/registry) address units)]\\n    (is (= :ok (:status result)) (pr-str result))\\n    result))\\n\\n\\n(defn- name-env\\n  \\\"The canonical name environment of publication `result`: `py`, `pysp` and\\n   each unit's published address, the only addresses a stage-composed\\n   source is configured with.\\\"\\n  [result]\\n  (into {'py (:address @h/published),\\n         'pysp (:address @h/published-pysp)}\\n        (map (fn [[n a]] [(lower/module-symbol n) a]))\\n  (slow/guard \\\"an-import-chain-derives-bottom-up-test\\\"\\n              an-import-chain-derives-bottom-up))\\n\\n\\n(deftest the-stage-reports-the-first-absent-address-test\\n  (let [[store py pysp] (stub-store)\\n        result (publication/publish-units!\\n                 store (h/registry) py\\n                 [{:name \\\"k\\\", :packet loops/while-true-pass}\\n                  {:name \\\"t\\\", :packet programs/t-packet}])\\n        records (records-of result)\\n        t (get (:addresses result) \\\"t\\\")\\n        k (get (:addresses result) \\\"k\\\")\\n        t-record (:record-address (get (:sites result) \\\"t\\\"))\\n        t-set (:set-address (get (:sites result) \\\"t\\\"))\\n        k-tree (:yin.module/tree (jing/get store k nil))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '245,410p' src/cljc/yang/python/antlr/siteset.cljc && sed -n '110,180p' test/yang/python/antlr/siteset_test.cljc && sed -n '260,340p' test/yang/python/antlr/siteset_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '245,410p' src/cljc/yang/python/antlr/siteset.cljc && sed -n '110,180p' test/yang/python/antlr/siteset_test.cljc && sed -n '260,340p' test/yang/python/antlr/siteset_test.cljc\"","aggregated_output":"                 (not (every? entry-ok? set)) {:defect :kind}\n                 :else nil)]\n    (cond\n      (absent? m) (missing manifest)\n      (absent? r) (missing record-address)\n      (absent? set) (missing set-address)\n      defect (cond-> defect set-address (assoc :set set-address)))))\n\n\n(defn admit\n  \"A consumer's decision for the import of the module at `manifest` in\n   `handle`, `record-addresses` the publication records it discovered for\n   it, under `requirement`: `{:profile name :hooks true}` or `{:profile\n   name :noninterruptible true}`. Answers `{:status :ok :instrumented? true\n   :set [...] :set-address s :record a}` when a record verifies, `{:status\n   :ok :instrumented? false :note ...}` for a noninterruptible profile,\n   else a refusal naming the profile and the missing or mismatched set (its\n   address when the record names one); or `{:status :missing :address a}`,\n   the first address a record's verification reads that `handle` does not\n   hold (`verify`).\"\n  [handle manifest record-addresses requirement]\n  (cond\n    (:noninterruptible requirement)\n    {:status :ok,\n     :instrumented? false,\n     :note (str \"profile \" (pr-str (:profile requirement))\n                \" is noninterruptible: imported without a site set\")}\n\n    (:hooks requirement)\n    (if (empty? record-addresses)\n      (refusal :yang.python.antlr/missing-site-set requirement\n               \"no published site set for the module\" {:manifest manifest})\n      (loop [todo record-addresses\n             first-defect nil]\n        (if-let [a (first todo)]\n          (let [v (verify handle manifest a)]\n            (cond\n              (nil? v)\n              (let [set-address (:yang.site/set (fetch handle a))]\n                {:status :ok,\n                 :instrumented? true,\n                 :record a,\n                 :set-address set-address,\n                 :set (fetch handle set-address)})\n\n              (= :missing (:status v)) v\n\n              :else (recur (rest todo) (or first-defect [a v]))))\n          (let [[a defect] first-defect]\n            (refusal :yang.python.antlr/site-set-mismatch requirement\n                     (str \"the published site set\"\n                          (when-let [s (:set defect)] (str \" \" s))\n                          \" does not verify (\" (name (:defect defect)) \")\")\n                     (assoc defect :manifest manifest :record a))))))\n\n    :else\n    (refusal :yang.python.antlr/profile-undeclared requirement\n             \"the profile declares neither :hooks nor :noninterruptible\"\n             {:manifest manifest})))\n\n\n;; =============================================================================\n;; Link-time application\n;; =============================================================================\n\n(defn- load-tree\n  \"The canonical row set `{:root :rows}` of the tree at `root` in `handle`,\n   every row fetched by its address, depth-first: `{:status :missing\n   :address a}` for the first row the handle does not hold, nil when a row\n   is not its address or no tree row.\"\n  [handle root]\n  (loop [todo [root]\n         rows {}]\n    (if-let [id (peek todo)]\n      (if (contains? rows id)\n        (recur (pop todo) rows)\n        (let [body (read-at handle id)\n              slots (when (vector? body)\n                      (get vm/semantic-bytecode-grammar (first body)))]\n          (cond\n            (absent? body) (missing id)\n            slots (recur (into (pop todo)\n                               (mapcat (fn [[_ kind] v]\n                                         (case kind\n                                           :node [v]\n                                           :nodes v\n                                           nil))\n                                       slots\n                                       (rest body)))\n                         (assoc rows id (into [id] body)))\n            :else nil)))\n      {:root root, :rows rows})))\n\n\n(defn- derive-module\n  \"Publish into `handle` the instrumented module `A'` of the module `m` at\n   `manifest` for the verified set of `adm`: the published tree with the\n   hooks of `(:hooks-profile requirement)` at its sites, requiring\n   `(:pysp requirement)` beside its own requirements, each guest\n   requirement rebound through `derived` ({A A'}). The `:derive` record\n   (`yang.safepoint/derive-record`) is materialized beside it and its\n   address answered as `:derivation`; nothing transacts it into a ledger.\n   Answers `{:status :ok :address a' :derivation d}`, a refusal, or\n   `{:status :missing :address a}` for the first tree row the handle does\n   not hold, before anything is written.\"\n  [handle registry manifest m adm requirement derived]\n  (let [fail (fn [message data]\n               (refusal :yang.python.antlr/instrumentation-failed requirement\n                        message (assoc data :manifest manifest)))]\n    (if-not (jing/segment-address? (:pysp requirement))\n      (fail \"the hook module is not published\" {})\n      (try\n        (let [tree (load-tree handle (:yin.module/tree m))\n              absent (= :missing (:status tree))\n              sites (into {} (:set adm))\n              inserted (when (and tree (not absent))\n                         (safepoint/insert tree sites\n                                           (:hooks-profile requirement)))\n              ast (when inserted\n                    (vm/semantic-bytecode->ast (:tree inserted)))\n              runtime (or (:runtime requirement) '#{py pysp})\n              out (when ast\n                    (publish/publish-module!\n                      handle\n                      {:name (:yin.module/name m),\n                       :ast ast,\n                       :exports (:yin.module/exports m),\n                       :requires (assoc (into {}\n                                              (map (fn [[n a]]\n                                                     [n (if (contains? runtime n)\n                                                          a\n                                                          (get derived a a))]))\n                                              (:yin.module/requires m))\n                                        'pysp (:pysp requirement)),\n                       :primitives (into {}\n                                         (map (fn [[n _]]\n                                                [n (lower/primitive-declaration\n                                                     registry n)]))\n                                         (:yin.module/primitives m))}))]\n          (cond\n            absent tree\n            (nil? tree) (fail \"the module's tree is not published\" {})\n            (= :refused (:status out))\n            (fail \"the instrumented module did not publish\" {:cause out})\n            :else\n            {:status :ok,\n             :address (:address out),\n             :instrumented? true,\n             :set-address (:set-address adm),\n             :derivation (jing/materialize!\n                           handle\n                           (safepoint/derive-record\n                             (:yin.module/tree m)\n                             (:yin.module/tree (:manifest out))\n                             (:hooks-profile requirement)\n                             (:sites inserted)))}))\n        (catch #?(:cljd Object :clj Exception :cljs :default) e\n          (fail (str \"the instrumented module did not derive: \" (ex-message e))\n                {}))))))\n\n\n(defn- records-for\n  \"The record addresses for `manifest`: the local map `records`'s, then\n   those `ctx`'s loaded index datoms publish under its principals.\"\n  [ctx records manifest]\n  (into (vec (get records manifest))\n(deftest the-association-verifies-by-address-test\n  (let [[store manifest p] (published (module-ast loops/while-true-pass \"w\"))]\n    (is (nil? (siteset/verify store manifest (:record-address p))))\n    (is (= {:status :ok, :instrumented? true, :set (:set p),\n            :set-address (:set-address p)}\n           (select-keys (siteset/admit store manifest [(:record-address p)]\n                                       requirement)\n                        [:status :instrumented? :set :set-address])))\n    (testing \"an address the store does not hold has no record\"\n      (is (= :record-absent\n             (:defect (siteset/verify store manifest :segment/other)))))))\n\n\n(deftest every-moved-pin-is-a-mismatch-test\n  (let [[store manifest p] (published (module-ast loops/while-true-pass \"w\"))\n        r (:record p)\n        empty-set (jing/materialize! store [])\n        bad-entry (jing/materialize! store [[[0] :loop] [:oops]])\n        bad-kind (jing/materialize! store [[[0] :nonsense]])\n        at (fn [record] (jing/materialize! store record))]\n    (doseq [[defect tampered]\n            {:root (assoc r :yang.site/root :segment/other),\n             :revision (assoc r :yang.site/revision \"other\"),\n             :profile (assoc r :yang.site/profile :segment/other),\n             :set-absent (assoc r :yang.site/set :segment/other),\n             :set-empty (assoc r :yang.site/set empty-set),\n             :kind (assoc r :yang.site/set bad-kind),\n             :manifest (assoc r :yang.site/manifest :other)}]\n      (testing (name defect)\n        (let [address (at tampered)]\n          (is (= defect (:defect (siteset/verify store manifest address))))\n          (let [out (siteset/admit store manifest [address] requirement)]\n            (is (= :refused (:status out)))\n            (is (= :yang.python.antlr/site-set-mismatch (:reason out)))\n            (is (= :py/hooks (:profile out)))))))\n    (testing \"a non-pair element is a defect, not a throw\"\n      (is (= :kind (:defect (siteset/verify\n                              store manifest\n                              (at (assoc r :yang.site/set bad-entry)))))))\n    (testing \"the mismatch names the set address\"\n      (let [out (siteset/admit store manifest\n                               [(at (assoc r :yang.site/set empty-set))]\n                               requirement)]\n        (is (= empty-set (:set out)))\n        (is (str/includes? (:message out) (str empty-set)))))))\n\n\n(deftest a-missing-set-is-refused-by-profile-test\n  (let [[store manifest _] (published (module-ast loops/while-true-pass \"w\"))\n        out (siteset/admit store manifest [] requirement)]\n    (is (= :refused (:status out)))\n    (is (= :yang.python.antlr/missing-site-set (:reason out)))\n    (is (= :py/hooks (:profile out)))\n    (is (re-find #\":py/hooks\" (:message out)))\n    (is (re-find #\"site set\" (:message out)))))\n\n\n(deftest a-noninterruptible-profile-needs-no-set-test\n  (let [[store manifest _] (published (module-ast programs/m-packet \"m\"))\n        out (siteset/admit store manifest []\n                           {:profile :py/plain, :noninterruptible true})]\n    (is (= :ok (:status out)))\n    (is (false? (:instrumented? out)))\n    (is (re-find #\"noninterruptible\" (:note out)))))\n\n\n(deftest a-profile-must-declare-hooks-or-noninterruptible-test\n  (let [[store manifest p] (published (module-ast programs/m-packet \"m\"))\n        out (siteset/admit store manifest [(:record-address p)]\n                           {:profile :py/odd})]\n    (is (= :refused (:status out)))\n              not run uninstrumented under the lie of an empty set\"\n      (let [out ((siteset/stage (h/registry) (hook-requirement pysp) {})\n                 ctx 'pym.ca alias-a)]\n        (is (= :refused (:status out)))\n        (is (= :yang.python.antlr/missing-site-set (:reason out)))\n        (is (contains? siteset/reasons (:reason out)))\n        (is (= 'pym.ca (:name out)))\n        (is (= :py/hooks (:profile out)))))\n    (testing \"a noninterruptible profile imports the alias as published\"\n      (is (= {:status :ok, :address alias-a}\n             (select-keys ((siteset/stage (h/registry)\n                                          {:profile :py/plain,\n                                           :noninterruptible true}\n                                          {})\n                           ctx 'pym.ca alias-a)\n                          [:status :address]))))\n    (is (some? bundle))))\n\n\n(deftest the-stage-answers-the-derive-record-test\n  (let [[store py pysp] (stub-store)\n        result (publication/publish-units!\n                 store (h/registry) py\n                 [{:name \"w\", :packet loops/while-true-pass}])\n        manifest (get (:addresses result) \"w\")\n        ctx (assoc no-datoms :store store)\n        out ((siteset/stage (h/registry) (hook-requirement pysp)\n                            (records-of result))\n             ctx 'pym.w manifest)\n        record (jing/get store (:derivation out) nil)\n        selected (filter (fn [[_ mark]]\n                           (#{:loop :call} (if (vector? mark) (first mark) mark)))\n                         (:set (get (:sites result) \"w\")))\n        sites-address (jing/segment-key (safepoint/site-set selected))]\n    (is (= :ok (:status out)) (pr-str out))\n    (is (not= manifest (:address out)))\n    (testing \"the :derive record is materialized and answered\"\n      (is (= :derive (:yin.ledger/op record)))\n      (is (= :yang.safepoint/insert (:yin.ledger/function record)))\n      (is (= (:yin.module/tree (jing/get store manifest nil))\n             (:yin.ledger/input record)))\n      (is (= (:yin.module/tree (jing/get store (:address out) nil))\n             (:yin.ledger/output record)))\n      (is (= {:yang.safepoint/hooks hooks/linked-profile,\n              :yang.safepoint/sites sites-address}\n             (:yin.ledger/profile record))))))\n\n\n(deftest a-dependency-with-no-set-refuses-the-chain-test\n  (let [[store py pysp] (stub-store)\n        result (publication/publish-units!\n                 store (h/registry) py\n                 [{:name \"k\", :packet programs/k-packet}\n                  {:name \"t\", :packet programs/t-packet}])\n        records (records-of result)\n        t (get (:addresses result) \"t\")\n        k (get (:addresses result) \"k\")\n        stage (siteset/stage (h/registry) (hook-requirement pysp)\n                             (dissoc records k))\n        out (stage (assoc no-datoms :store store) 'pym.t t)]\n    (is (= :ok (:status ((siteset/stage (h/registry) (hook-requirement pysp)\n                                        records)\n                         (assoc no-datoms :store store) 'pym.t t))))\n    (is (= :refused (:status out)))\n    (is (= :yang.python.antlr/missing-site-set (:reason out)))\n    (is (= 'pym.k (:name out)))\n    (is (= t (:via out)))))\n\n\n(deftest the-stage-writes-nothing-until-it-can-complete-test\n  (let [[store py pysp] (stub-store)\n        result (publication/publish-units!\n                 store (h/registry) py\n                 [{:name \"k\", :packet loops/while-true-pass}\n                  {:name \"t\", :packet programs/t-packet}])\n        records (records-of result)\n        t (get (:addresses result) \"t\")\n        t-tree (:yin.module/tree (jing/get store t nil))\n        entries ((:entries-fn store))\n        stage (siteset/stage (h/registry) (hook-requirement pysp) records)\n        damaged (mem/create-content-mem (dissoc entries t-tree))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '410,500p' src/cljc/yang/python/antlr/siteset.cljc && sed -n '1,115p' test/yang/python/antlr/siteset_test.cljc && sed -n '380,420p' test/yang/python/antlr/siteset_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '410,500p' src/cljc/yang/python/antlr/siteset.cljc && sed -n '1,115p' test/yang/python/antlr/siteset_test.cljc && sed -n '380,420p' test/yang/python/antlr/siteset_test.cljc\"","aggregated_output":"  (into (vec (get records manifest))\n        (discover (:datoms ctx) (:principals ctx) manifest)))\n\n\n(defn- derive-closure\n  \"The instrumented module of `manifest` under a hook profile, derived\n   bottom-up: each guest requirement is admitted and derived first, so the\n   derived module pins the derived requirements it will link (`derived`,\n   {A A'}, derives a shared requirement once). Answers `{:status :ok\n   :address a' :derivation d :derived derived}`, the first refusal, with\n   `:name` the requirement that was refused and `:via` the module that\n   required it, or `{:status :missing :address a}` for the first address\n   (record, set, guest manifest, tree row) read in a fixed depth-first\n   order that the handle does not hold. Nothing is written until every\n   read has succeeded.\"\n  [ctx registry records requirement manifest derived]\n  (let [handle (:store ctx)\n        runtime (or (:runtime requirement) '#{py pysp})\n        adm (admit handle manifest (records-for ctx records manifest)\n                   requirement)]\n    (if (not= :ok (:status adm))\n      adm\n      (let [m (fetch handle manifest)\n            deps (sort-by (comp str key)\n                          (remove (comp runtime key)\n                                  (:yin.module/requires m)))\n            below (reduce (fn [acc [n a]]\n                            (if (contains? (:derived acc) a)\n                              acc\n                              (let [r (derive-closure ctx registry records\n                                                      requirement a\n                                                      (:derived acc))]\n                                (case (:status r)\n                                  :ok (assoc acc :derived (:derived r))\n                                  :missing (reduced r)\n                                  (reduced (cond-> (assoc r :via manifest)\n                                             (nil? (:name r)) (assoc :name n)))))))\n                          {:derived derived}\n                          deps)]\n        (if (:status below)\n          below\n          (let [out (derive-module handle registry manifest m adm requirement\n                                   (:derived below))]\n            (if (not= :ok (:status out))\n              out\n              (assoc out :derived (assoc (:derived below) manifest\n                                         (:address out))))))))))\n\n\n(defn- overlay\n  \"A write-buffering handle over `base`: reads see the buffer first, then\n   `base`; puts land in the buffer only, in put order. `flush!` writes the\n   buffer to `base`; dropping the overlay writes nothing.\"\n  [base]\n  (let [buf (atom {:bytes {}, :order []})\n        sentinel #?(:cljs (js-obj)\n                    :default (Object.))]\n    {:handle (assoc base\n                    :get-bytes-fn (fn [address not-found]\n                                    (let [bs (get-in @buf [:bytes address])]\n                                      (if (nil? bs)\n                                        ((:get-bytes-fn base) address not-found)\n                                        bs)))\n                    :put-bytes-fn (fn [address bs]\n                                    (if (or (contains? (:bytes @buf) address)\n                                            (let [existing ((:get-bytes-fn base)\n                                                            address\n                                                            sentinel)]\n                                              (and (some? existing)\n                                                   (not (identical? sentinel\n                                                                    existing)))))\n                                      :present\n                                      (do (swap! buf (fn [b]\n                                                       (-> b\n                                                           (assoc-in [:bytes address]\n                                                                     bs)\n                                                           (update :order conj\n                                                                   address))))\n                                          :inserted))))\n     :flush! (fn []\n               (let [{:keys [bytes order]} @buf]\n                 (doseq [a order] ((:put-bytes-fn base) a (get bytes a)))))}))\n\n\n(def reasons\n  \"The refusal reasons the stage answers, the composition's own.\"\n  #{:yang.python.antlr/missing-site-set\n    :yang.python.antlr/site-set-mismatch\n    :yang.python.antlr/profile-undeclared\n    :yang.python.antlr/instrumentation-failed})\n\n(ns yang.python.antlr.siteset-test\n  \"C4 slice I7 (docs/design/yang.antlr.md 8.5.6, ruling 14): published site\n   sets for imported modules.\n\n   The fast tests pin the set's content addressing and the consumer's\n   decisions over a stand-in manifest (the record pins a manifest's\n   `:yin.module/tree`, so no publication is forced): a set is the same\n   address for the same marks (content-addressed over the marks, so two\n   modules that mark alike share one), a record verifies by its own\n   address, every pin that moves, an empty set and a malformed entry are a\n   mismatch, a record is discovered only from a declared principal's signed\n   index entry, a missing set is refused naming the profile, a\n   noninterruptible profile imports without one, and an SCC member alias,\n   which carries no marks, is refused under a hook profile while its\n   bundle verifies.\n\n   The slow tests run the acceptance on the three vector VMs through the\n   linker: a published `while True` module imported under a hook profile\n   is delivered by the linker composition's `:stage` (`siteset/stage`) as\n   the instrumented module derived from its verified set and the published\n   tree alone, the name environment holding canonical addresses only, so a\n   pending signal interrupts it across the import boundary; the same import\n   without its set is refused at link time, naming the profile and the set,\n   before anything is derived or run; a noninterruptible profile imports the\n   module as published; and an import chain derives bottom-up, the outer\n   instrumented module pinning the inner one it links.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.string :as str]\n            [dao.jing :as jing]\n            [dao.jing.dht.mesh :as mesh]\n            [dao.jing.mem :as mem]\n            [dao.stream :as stream]\n            [dao.test-slow :as slow]\n            [yang.python.antlr.import-programs :as programs]\n            [yang.python.antlr.linked-harness :as h]\n            [yang.python.antlr.lower :as lower]\n            [yang.python.antlr.publication-test :as publication-test]\n            [yang.python.antlr.publication :as publication]\n            [yang.python.antlr.render :as render]\n            [yang.python.antlr.safepoint :as hooks]\n            [yang.python.antlr.safepoint-programs :as loops]\n            [yang.python.antlr.siteset :as siteset]\n            [yang.python.antlr.uast :as u]\n            [yang.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.engine :as engine]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.linker.sign :as sign]\n            [yin.vm.test-utils :as tu]))\n\n\n;; =============================================================================\n;; The fast tests\n;; =============================================================================\n\n(defn- module-ast\n  [pk nm]\n  (lower/module-packet pk {:name nm, :package? false}))\n\n\n(defn- published\n  \"A store holding a stand-in manifest of `ast` and its site set:\n   `[store manifest publication]`.\"\n  [ast]\n  (let [store (mem/create-content-mem)\n        tree (:tree (siteset/site-set-of ast))\n        manifest (jing/materialize! store {:yin.module/tree (:root tree)})]\n    [store manifest (siteset/publish! store manifest ast)]))\n\n\n(def ^:private requirement\n  {:profile :py/hooks, :hooks true})\n\n\n(def ^:private key-a\n  (let [seed (apply str (repeat 32 \"a1\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(def ^:private key-b\n  (let [seed (apply str (repeat 32 \"b2\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(deftest the-set-is-content-addressed-test\n  (let [wt (module-ast loops/while-true-pass \"w\")\n        [_ _ a] (published wt)\n        [_ _ b] (published wt)\n        [_ _ other] (published (module-ast programs/m-packet \"m\"))]\n    (testing \"the same code is the same set address\"\n      (is (= (:set-address a) (:set-address b)))\n      (is (= (:record-address a) (:record-address b))))\n    (testing \"other marks are another set\"\n      (is (not= (:set a) (:set other)))\n      (is (not= (:set-address a) (:set-address other))))\n    (testing \"a loop module's set marks its loop\"\n      (is (some (fn [[_ mark]] (= :loop mark)) (:set a))))\n    (testing \"the marks stay out of the published tree's rows\"\n      (is (not-any? #(= :yang/site %)\n                    (tree-seq coll? seq (:rows (:tree (siteset/site-set-of wt)))))))\n    (testing \"the record pins root, revision, profile and set\"\n      (is (= (:yang.site/root (:record a))\n             (:root (:tree (siteset/site-set-of wt)))))\n      (is (= siteset/frontend-revision (:yang.site/revision (:record a))))\n      (is (= siteset/profile-address\n             (:yang.site/profile (:record a)))))))\n\n\n(deftest the-association-verifies-by-address-test\n  (let [[store manifest p] (published (module-ast loops/while-true-pass \"w\"))]\n    (is (nil? (siteset/verify store manifest (:record-address p))))\n    (is (= {:status :ok, :instrumented? true, :set (:set p),\n            :set-address (:set-address p)}\n           (select-keys (siteset/admit store manifest [(:record-address p)]\n    result))\n\n\n(defn- name-env\n  \"The canonical name environment of publication `result`: `py`, `pysp` and\n   each unit's published address, the only addresses a stage-composed\n   source is configured with.\"\n  [result]\n  (into {'py (:address @h/published),\n         'yang.call (:call-address @h/published),\n         'pysp (:address @h/published-pysp)}\n        (map (fn [[n a]] [(lower/module-symbol n) a]))\n        (:addresses result)))\n\n\n(defn- staged-run\n  \"The importer `pk` on backend `k` over the linker source composed with\n   `stage` over `env` (canonical addresses only), under `signals`:\n   `{:outcome [halted? blocked? output] :responses [...]}`, every response\n   the link pair carried.\"\n  [k pk env stage signals]\n  (let [src (link/composition {:content-store (:store @h/published),\n                               :name-env env,\n                               :derivation :trusted,\n                               :stage stage})\n        pair (link/make-pair)\n        ast (hooks/linked-program (lower/lower-packet pk {:prelude :linked}))\n        task ((get h/backends k) ast (h/composition (h/registry) pair))\n        [task pair] (h/drive ((with-signals signals) task) pair src)]\n    {:outcome [(vm/halted? task) (vm/blocked? task)\n               (render/output (vm/value task))],\n     :responses (mesh/values (:responses pair))}))\n\n\n(defn- staged-on-every-vm\n  [pk env stage signals]\n  (into {}\n        (map (fn [k] [k (staged-run k pk env stage signals)]))\n        (keys h/backends)))\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"\\\\(defn stage|defn- stage\\\" src/cljc/yang/python/antlr/siteset.cljc && sed -n '515,570p' src/cljc/yang/python/antlr/siteset.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"\\\\(defn stage|defn- stage\\\" src/cljc/yang/python/antlr/siteset.cljc && sed -n '515,570p' src/cljc/yang/python/antlr/siteset.cljc\"","aggregated_output":"502:(defn stage\n   derived bottom-up from the verified sets (`:derivation` its `:derive`\n   record's address), or the refusal naming the profile, the set and the\n   `:name` refused.\"\n  [registry requirement records]\n  (let [runtime (or (:runtime requirement) '#{py pysp})]\n    (fn [ctx name address]\n      (cond\n        (contains? runtime name) {:status :ok, :address address}\n\n        (:noninterruptible requirement)\n        (assoc (admit (:store ctx) address [] requirement) :address address)\n\n        :else\n        (let [{:keys [handle flush!]} (overlay (:store ctx))\n              r (derive-closure (assoc ctx :store handle) registry records\n                                requirement address {})]\n          (case (:status r)\n            :ok (do (flush!)\n                    (select-keys r [:status :address :derivation :instrumented?\n                                    :set-address]))\n            :missing (select-keys r [:status :address])\n            (cond-> r (nil? (:name r)) (assoc :name name))))))))\n\n\n(defn signed-entries\n  \"The `publisher` key's signed publication entries for the site sets\n   `publish-units!` answered: `sites` (`:sites`), the manifest of each\n   from `addresses` (a Python name) or `bundles` (a bundle symbol), in\n   key order. The publisher that asserts these names indexes them in the\n   same transaction (`entry-datoms`); a module with no entry is refused\n   by every hook-profile reader.\"\n  [publisher sites addresses bundles]\n  (mapv (fn [[k s]]\n          (signed-entry publisher (or (get addresses k) (get bundles k))\n                        (:record-address s)))\n        (sort-by (comp str key) sites)))\n","exit_code":0,"status":"completed"}}
