   191	;; The parser and the probe (JVM)
   192	;; =============================================================================
   193	
   194	#?(:cljd nil
   195	   :clj
   196	   (defn- node-shape
   197	     [node]
   198	     (select-keys node [:id :kind :type :text :rule :children])))
   199	
   200	
   201	#?(:cljd nil
   202	   :clj
   203	   (deftest precompiled-packets-are-the-parsers-test
   204	     (doseq [[source p] packets]
   205	       (is (= (map node-shape
   206	                   (:yang.cst/nodes (parser/parse-source (str source "\n"))))
   207	              (map node-shape (:yang.cst/nodes p)))
   208	           source))))
   209	
   210	
   211	#?(:cljd nil
   212	   :clj
   213	   (deftest probe-buffers-an-open-block-test
   214	     (let [[[s1 t1] [s2 t2] [s3 t3] [_ t4]]
   215	           (feed (session :yang.python/antlr)
   216	                 ["def f(n):" "    return n + 1" "" "print(f(2))"])]
   217	       (testing "the header and body are buffered"
   218	         (is (= "" t1))
   219	         (is (= "def f(n):" (:pending-input s1)))
   220	         (is (= "" t2))
   221	         (is (some? (:pending-input s2))))
   222	       (testing "a blank line closes the block"
   223	         (is (nil? (:pending-input s3)))
   224	         (is (= "" t3)))
   225	       (testing "the function is callable afterwards"
   226	         (is (= "3\n" t4))))))
   227	
   228	
   229	#?(:cljd nil
   230	   :clj
   231	   (deftest probe-buffers-across-lines-test
   232	     (testing "an open bracket"
   233	       (is (= ["" "(1, 2)\n"]
   234	              (texts (session :yang.python/antlr) ["print((1," "2))"]))))
   235	     (testing "a blank line inside brackets does not submit"
   236	       (let [[[s1 t1] [s2 t2] [s3 t3]]
   237	             (feed (session :yang.python/antlr) ["print(" "" "1)"])]
   238	         (is (= ["" "" "1\n"] [t1 t2 t3]))
   239	         (is (= "print(\n" (:pending-input s2)))
   240	         (is (nil? (:pending-input s3)))
   241	         (is (some? (:pending-input s1)))))
   242	     (testing "an open triple string, brackets inside it"
   243	       (is (= ["" "" "hello\n(\n\n"]
   244	              (texts (session :yang.python/antlr)
   245	                     ["s = \"\"\"hello" "(" "\"\"\"; print(s)"]))))
   246	     (testing "explicit backslash continuation"
   247	       (is (= ["" "" "3\n"]
   248	              (texts (session :yang.python/antlr)
   249	                     ["x = 1 \\" "+ 2" "print(x)"]))))))
