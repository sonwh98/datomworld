   251	
   252	#?(:cljd nil
   253	   :clj
   254	   (deftest probe-reports-irreparable-errors-at-once-test
   255	     (doseq [bad ["x = (1 + * 2" "foo(1 2" "x = )" "x = (]" "x =" "1 +"
   256	                  "lambda x:" "s = 'abc"]]
   257	       (testing bad
   258	         (is (= :complete (probe/probe bad)))
   259	         (let [[[s t] [_ t']] (feed (session :yang.python/antlr)
   260	                                    [bad "print(2)"])]
   261	           (is (nil? (:pending-input s)))
   262	           (is (str/includes? t "SyntaxError"))
   263	           (testing "and the next submission evaluates"
   264	             (is (= "2\n" t'))))))))
   265	
   266	
   267	#?(:cljd nil
   268	   :clj
   269	   (deftest probe-classifies-test
   270	     (doseq [[text expected]
   271	             [["x = 1" :complete]
   272	              ["print(" :incomplete]
   273	              ["print(\n" :incomplete]
   274	              ["print((1," :incomplete]
   275	              ["d = {'a': [1, 2" :incomplete]
   276	              ["if x:\n  y = {1: (2" :incomplete]
   277	              ["f(a for a in b" :incomplete]
   278	              ["x = (1 if y else" :incomplete]
   279	              ["def f(n):" :incomplete]
   280	              ["def f(n): # body next" :incomplete]
   281	              ["@dec" :incomplete]
   282	              ["def f(n):\n    return n" :incomplete]
   283	              ["def f(n):\n    return n\n" :complete]
   284	              ["s = \"\"\"hello" :incomplete]
   285	              ["s = \"\"\"a\n  b\"\"\"" :complete]
   286	              ["s = \"\"\"(\"\"\"" :complete]
   287	              ["s = '(' # )" :complete]
   288	              ["s = 'it\\'s ('" :complete]
   289	              ["s = 'abc\\" :incomplete]
   290	              ["x = 1 \\" :incomplete]
   291	              ["x = 1 \\\n+ 2" :complete]
   292	              ["x = 1 # \\" :complete]
   293	              ["x = (1 + * 2" :complete]
   294	              ["x = )" :complete]]]
