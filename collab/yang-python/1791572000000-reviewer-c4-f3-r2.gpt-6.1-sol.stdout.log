   118	                (= \newline (.charAt text (inc i)))
   119	                (recur (+ i 2) stack line-begin line? block?)
   120	                :else (let [[stack block?] (code stack)]
   121	                        (recur (inc i) stack line-begin false block?)))
   122	
   123	              (contains? #{\( \[ \{} c)
   124	              (let [[stack block?] (code stack)]
   125	                (recur (inc i) (conj stack c) line-begin false block?))
   126	
   127	              (contains? opener-of c)
   128	              (if (= (peek stack) (opener-of c))
   129	                (let [[stack block?] (code stack)]
   130	                  (recur (inc i) (pop stack) line-begin false block?))
   131	                (assoc state :error :bracket))
   132	
   133	              (contains? #{\space \tab \formfeed \return} c)
   134	              (recur (inc i) stack line-begin line? block?)
   135	
   136	              :else
   137	              (let [[stack block?] (code stack)]
   138	                (recur (inc i) stack line-begin false block?)))))))))
   139	
   140	
   141	;; =============================================================================
   142	;; Parse: where the first error failed
   143	;; =============================================================================
   144	
   145	(defn- first-failure
   146	  "Parse `source` and answer nil when it parses, `:end` when its first
   147	   error failed on an end-of-input token, else `:early`.
   148	
   149	   The failing token is the offending token of a mismatch; a
   150	   no-viable-alternative error names the token its prediction began at,
   151	   so for it the failing token is the furthest one the parser had read
   152	   when the error was reported. End-of-input tokens are EOF and the
   153	   zero-width ones after the last token with source text (the lexer's
   154	   EOF can carry a span, so it is excluded by type). A lexer error has no
   155	   token and is `:early`."
   156	  [^String source]
   157	  (let [{:keys [profile lexer-atn lexer-dfa lexer-cache parser-atn
   158	                parser-dfa parser-cache]}
   159	        (parser/make-worker)
   160	        far (volatile! -1)
   161	        failure (volatile! nil)
   162	        lexer ^Lexer ((:make-lexer profile) (CharStreams/fromString source))
   163	        tokens (proxy [CommonTokenStream] [lexer]
   164	                 (LT
   165	                   [k]
   166	                   (let [^Token t (proxy-super LT k)]
   167	                     (when t (vswap! far max (.getTokenIndex t)))
   168	                     t)))
   169	        listener (proxy [BaseErrorListener] []
   170	                   (syntaxError
   171	                     [_recognizer offending _line _column _msg e]
   172	                     (when-not @failure
   173	                       (vreset! failure
   174	                                (cond
   175	                                  (not (instance? Token offending)) :lexical
   176	                                  (instance? NoViableAltException e) @far
   177	                                  :else (.getTokenIndex ^Token offending))))))
   178	        _ (.setInterpreter
   179	            lexer
   180	            (LexerATNSimulator.
   181	              lexer
   182	              ^ATN lexer-atn
   183	              ^"[Lorg.antlr.v4.runtime.dfa.DFA;" lexer-dfa
   184	              ^PredictionContextCache lexer-cache))
   185	        _ (.removeErrorListeners lexer)
   186	        _ (.addErrorListener lexer ^ANTLRErrorListener listener)
   187	        parser ^Parser ((:make-parser profile) tokens)
   188	        _ (.setInterpreter
   189	            parser
   190	            (ParserATNSimulator.
   191	              parser
   192	              ^ATN parser-atn
   193	              ^"[Lorg.antlr.v4.runtime.dfa.DFA;" parser-dfa
   194	              ^PredictionContextCache parser-cache))
   195	        _ (.removeErrorListeners parser)
   196	        _ (.addErrorListener parser ^ANTLRErrorListener listener)]
   197	    ((:start profile) parser)
   198	    (let [index @failure
   199	          last-real (->> (.getTokens ^CommonTokenStream tokens)
   200	                         (keep (fn [^Token t]
   201	                                 (when (and (not= Token/EOF (.getType t))
   202	                                            (<= (.getStartIndex t)
   203	                                                (.getStopIndex t)))
   204	                                   (.getTokenIndex t))))
   205	                         (reduce max -1))]
   206	      (cond
   207	        (nil? index) nil
   208	        (and (int? index) (> index last-real)) :end
   209	        :else :early))))
   210	
   211	
   212	;; =============================================================================
   213	;; Probe
   214	;; =============================================================================
   215	
   216	(defn- last-line-blank?
   217	  [text]
   218	  (str/blank? (peek (str/split text #"\n" -1))))
   219	
   220	
   221	(defn probe
   222	  [text]
   223	  (let [{:keys [error string continued brackets block?]} (scan text)
   224	        open? (boolean (or continued (seq brackets)))]
   225	    (cond
   226	      error :complete
   227	      string :incomplete
   228	      (and (not open?) (last-line-blank? text)) :complete
   229	      :else (case (first-failure (str text "\n"))
   230	              nil (if (or open? block?) :incomplete :complete)
   231	              :end :incomplete
   232	              :early :complete))))
     1	(ns yang.python.antlr.repl
     2	  "The Python ANTLR frontend's REPL lowering (docs/design/yang.antlr.md
     3	   §8.5.6, slice F3). Portable: the parser is JVM-only, but a host that
     4	   holds a CST packet lowers it here.
     5	
     6	   One REPL submission lowers to a program that runs the packet's module body
     7	   against the session's `__main__` namespace: the module object and its
     8	   globals dict live in `sys.modules` (ruling 18), so a name bound by one
     9	   submission is read by the next. `(reset)` rebuilds the VM, and with it the
    10	   runtime state.
    11	
    12	   The bundled prelude defines the runtime in the VM's store and `py/init!`
    13	   allocates its task state; running it twice would discard that state. The
    14	   first lowering of a session therefore carries the prelude and returns the
    15	   session marker `:primed`; later lowerings of the same session omit it. The
    16	   shell keeps the marker (`:frontend-session`) and clears it with the VM.
    17	
    18	   Printed lines and an uncaught exception are rendered by the host
    19	   primitive `py-report` (`report`) and written with the shell's own
    20	   `println`, so they arrive on the output medium in order."
    21	  (:require
    22	    [clojure.string :as str]
    23	    [yang.antlr.packet :as p]
    24	    [yang.python.antlr.lower :as lower]
    25	    [yang.python.antlr.prelude :as prelude]
    26	    [yang.python.antlr.render :as render]
    27	    [yang.python.antlr.uast :as u]))
    28	
    29	
    30	(def report-primitive
    31	  "The primitive name the lowered program calls."
    32	  'py-report)
    33	
    34	
    35	(defn report
    36	  "The text of one submission: each `print` call's line, then the uncaught
    37	   exception as `Type: args`, newline separated. Empty when it did neither."
    38	  [out exception]
    39	  (str/join
    40	    "\n"
    41	    (cond-> (mapv render/line out)
    42	      exception (conj (str (:type exception)
    43	                           (when (seq (:args exception))
    44	                             (str ": " (str/join " "
    45	                                                 (map render/py-str
    46	                                                      (:args exception))))))))))
    47	
    48	
    49	(def primitives
    50	  "The host primitives the lowered program needs, for a shell's `:primitives`."
    51	  {report-primitive report})
    52	
    53	
    54	(def ^:private run-form
    55	  '(do (cell/set! py.rt/out [])
    56	       (cell/set! py.rt/ctx (py/ctx nil 0 0 nil))
    57	       (let [hit (py/modules-ref (py/str "__main__"))
    58	             m (if (= hit :py/missing)
    59	                 (let [fresh (py/module-new (py/str "__main__") :py/None)]
    60	                   (do (py/modules-put! (py/str "__main__") fresh)
    61	                       fresh))
    62	                 hit)
    63	             d (py/module-dict m)
    64	             exc (py/try (fn []
    65	                           (do (%repl-body d (py/globals-fn d))
    66	                               :py/None))
    67	                         (fn [e] e)
    68	                         (fn [] :py/None))
    69	             text (py-report
    70	                    (cell/get py.rt/out)
    71	                    (if (= exc :py/None) nil (py/snapshot-exc exc)))]
    72	         (if (= text "") nil (println text)))))
    73	
    74	
    75	(defn- ok-packet!
    76	  [packet]
    77	  (if (= :yang.cst/ok (:yang.cst/outcome packet))
    78	    packet
    79	    (throw (ex-info
    80	             (let [e (first (:yang.cst/errors packet))]
    81	               (str "SyntaxError: " (:message e)
    82	                    (when (:line e) (str " (line " (:line e) ")"))))
    83	             {:yang.python.antlr/diagnostic :yang.python.antlr/syntax
    84	              :errors (:yang.cst/errors packet)}))))
    85	
    86	
    87	(defn lower-session
    88	  "`[ast session']` for one ok CST `packet` under `session` (nil on a fresh
    89	   session, `:primed` once the prelude has run)."
    90	  [packet session]
    91	  (let [packet (ok-packet! packet)
    92	        packet (cond-> packet
    93	                 (not (contains? packet :yang.python.antlr/max-digits))
    94	                 (assoc :yang.python.antlr/max-digits 4300))
    95	        _ (p/validate! packet)
    96	        body (lower/lower-module-body packet)
    97	        main (u/let1 '%repl-body
    98	                     (u/lam [lower/globals-sym lower/globals-fn-sym] body)
    99	                     (u/sexp->uast run-form))
   100	        ast (u/mark-tails (if (= :primed session)
   101	                            main
   102	                            (u/then prelude/uast main)))]
   103	    [ast :primed]))
   104	
   105	
   106	(defn lower
   107	  "The stateless lowering: a program that carries the prelude."
   108	  [packet]
   109	  (first (lower-session packet nil)))
     1	(ns yin.repl.python-antlr-test
     2	  "Slice F3 (docs/design/yang.antlr.md section 8.5.6): the Python ANTLR
     3	   frontend at the REPL. State persists across submissions, the shell
     4	   shows what a submission printed and not its value, a failed round
     5	   keeps the session's runtime state as it was, and `(reset)` and
     6	   `(vm ...)` start a new process.
     7	
     8	   The parser is JVM-only, so the session scenarios run on every host
     9	   through a binding whose parse stage answers the parser's packets,
    10	   precompiled below (each def's docstring is the source the REPL hands
    11	   the parser); on the JVM they run through the installed frontend too,
    12	   and the packets are checked against the parser so the two cannot
    13	   drift. The completeness probe is JVM-only, as the parser is."
    14	  (:require
    15	    [clojure.string :as str]
    16	    [clojure.test :refer [deftest is testing]]
    17	    [yang.frontend :as frontend]
    18	    [yang.python.antlr.c3-programs :refer [asg call e ex lit op st tc tx vr]]
    19	    [yang.python.antlr.lower-portable-test :refer [packet]]
    20	    [yang.python.antlr.repl :as python.repl]
    21	    #?@(:cljd [] :clj [[yang.python.antlr.parser :as parser]
    22	                       [yang.python.antlr.repl-probe :as probe]])
    23	    [yin.repl :as repl]
    24	    [yin.repl.frontends :as frontends]))
    25	
    26	
    27	;; =============================================================================
    28	;; Precompiled packets
    29	;; =============================================================================
    30	
    31	(defn- module
    32	  [& stmts]
    33	  (packet (-> [:file_input] (into stmts) (conj ["EOF" "<EOF>"]))))
    34	
    35	
    36	(def ^:private packets
    37	  "The parser's packet for each line the session scenarios submit; the
    38	   REPL hands the parser the line with a newline appended."
    39	  {"x = 1" (module (st (asg (tc (vr "x")) (tc (lit "1"))))),
    40	   "x = 5" (module (st (asg (tc (vr "x")) (tc (lit "5"))))),
    41	   "print(x)" (module (st (ex (tc (call "print" (tc (vr "x"))))))),
    42	   "1/0" (module (st (ex (tx (op (e (lit "1")) "/" (e (lit "0")))))))})
    43	
    44	
    45	;; =============================================================================
    46	;; Sessions
    47	;; =============================================================================
    48	
    49	(def ^:private cst-manifest
    50	  {:yang.frontend/id :yang.python/cst,
    51	   :yang.frontend/spi 1,
    52	   :yang.frontend/revision "f3-test",
    53	   :yang.frontend/language :python.cst,
    54	   :yang.frontend/grammar {:yang.grammar/package "python3",
    55	                           :yang.grammar/entries {:module "file_input"},
    56	                           :yang.grammar/export-profile :yang.cst/v1},
    57	   :yang.frontend/options-schema :segment/none,
    58	   :yang.frontend/lowering-profile :segment/f3-test,
    59	   :yang.frontend/runtime-profile :segment/f3-test,
    60	   :yang.frontend/support-profile :segment/f3-test})
    61	
    62	
    63	(defn- cst-catalog
    64	  "The standard catalog plus the Python lowering behind a parse stage
    65	   that answers the precompiled packets."
    66	  []
    67	  (frontend/install (frontends/standard)
    68	                    cst-manifest
    69	                    {:parse (fn [source] (get packets source)),
    70	                     :lower python.repl/lower,
    71	                     :lower-session python.repl/lower-session,
    72	                     :display :output}))
    73	
    74	
    75	(defn- session
    76	  "A shell switched to `lang`, composed with `opts`."
    77	  ([lang] (session lang {}))
    78	  ([lang opts]
    79	   (first (repl/eval-input
    80	            (frontends/create-state (merge {:frontends (cst-catalog)} opts))
    81	            (str "(lang " lang ")")))))
    82	
    83	
    84	(def ^:private langs
    85	  "The ids every session scenario runs under: the precompiled packets on
    86	   every host, and the installed parser where it runs."
    87	  #?(:cljd [:yang.python/cst]
    88	     :clj [:yang.python/cst :yang.python/antlr]
    89	     :cljs [:yang.python/cst]))
    90	
    91	
    92	(defn- feed
    93	  "Submit each line in order; every `[state text]` answered."
    94	  [state lines]
    95	  (rest (reductions (fn [[st _] line] (repl/eval-input st line))
    96	                    [state nil]
    97	                    lines)))
    98	
    99	
   100	(defn- texts
   101	  [state lines]
   102	  (mapv second (feed state lines)))
   103	
   104	
   105	;; =============================================================================
   106	;; Session scenarios (every host)
   107	;; =============================================================================
   108	
   109	(deftest assignment-then-print-test
   110	  (doseq [lang langs]
   111	    (testing (str lang)
   112	      (let [[[assigned t1] [_ t2]] (feed (session lang) ["x = 1" "print(x)"])]
   113	        (is (= lang (:lang (session lang))))
   114	        (is (= ["" "1\n"] [t1 t2]))
   115	        (is (= :primed (:frontend-session assigned)))))))
   116	
   117	
   118	(deftest an-exception-keeps-the-session-test
   119	  (doseq [lang langs]
   120	    (testing (str lang)
   121	      (is (= ["" "ZeroDivisionError: division by zero\n" "5\n"]
   122	             (texts (session lang) ["x = 5" "1/0" "print(x)"]))))))
   123	
   124	
   125	(deftest reset-is-a-new-process-test
   126	  (doseq [lang langs]
   127	    (testing (str lang)
   128	      (let [[_ before [reset-state _] after]
   129	            (feed (session lang) ["x = 1" "print(x)" "(reset)" "print(x)"])]
   130	        (is (= "1\n" (second before)))
   131	        (is (nil? (:frontend-session reset-state)))
   132	        (is (= "NameError: name 'x' is not defined\n" (second after)))))))
   133	
   134	
   135	(deftest vm-rebuild-is-a-new-process-test
   136	  (doseq [lang langs]
   137	    (testing (str lang)
   138	      (let [vm-type (first (remove #{(:vm-type (session lang))}
   139	                                   [:semantic :register]))
   140	            [_ [switched _] gone _ again]
   141	            (feed (session lang)
   142	                  ["x = 1" (str "(vm " vm-type ")") "print(x)" "x = 5"
   143	                   "print(x)"])]
   144	        (is (= vm-type (:vm-type switched)))
   145	        (is (nil? (:frontend-session switched)))
   146	        (testing "the new VM runs the prelude again and has no x"
   147	          (is (= "NameError: name 'x' is not defined\n" (second gone))))
   148	        (is (= "5\n" (second again)))))))
   149	
   150	
   151	(deftest a-failed-first-round-keeps-the-runtime-uninitialized-test
   152	  (doseq [lang langs]
   153	    (testing (str lang)
   154	      (let [calls (atom 0)
   155	            report (fn [out exception]
   156	                     (if (= 1 (swap! calls inc))
   157	                       (throw (ex-info "report failed" {}))
   158	                       (python.repl/report out exception)))
   159	            [[failed failed-text] _ [_ text]]
   160	            (feed (session lang {:primitives {'py-report report}})
   161	                  ["x = 1" "x = 1" "print(x)"])]
   162	        (testing "the failed round is reported and leaves no session marker"
   163	          (is (str/includes? failed-text "report failed"))
   164	          (is (nil? (:frontend-session failed))))
   165	        (testing "the retry carries the prelude again and the session works"
   166	          (is (= "1\n" text)))))))
   167	
   168	
   169	(deftest a-failed-later-round-keeps-the-previous-marker-test
   170	  (let [calls (atom 0)
   171	        report (fn [out exception]
   172	                 (if (= 2 (swap! calls inc))
   173	                   (throw (ex-info "report failed" {}))
   174	                   (python.repl/report out exception)))
   175	        [_ [failed _] [_ text]]
   176	        (feed (session :yang.python/cst {:primitives {'py-report report}})
   177	              ["x = 1" "x = 5" "print(x)"])]
   178	    (is (= :primed (:frontend-session failed)))
   179	    (testing "the failed round's binding rolled back with its VM"
   180	      (is (= "1\n" text)))))
   181	
   182	
   183	(deftest other-frontends-still-echo-their-value-test
   184	  (let [state (frontends/create-state)
   185	        [python _] (repl/eval-input state "(lang :yang.python/legacy)")]
   186	    (is (= "3" (second (repl/eval-input state "(+ 1 2)"))))
   187	    (is (= "3" (second (repl/eval-input python "1 + 2"))))))
