(ns yang.python.antlr.s3a-mutation-test
  (:require [clojure.test :as t :refer [deftest]]
            [clojure.walk :as walk]
            [yang.python.antlr.int-ops-test :as ops]
            [yang.python.antlr.prelude :as p]
            [yang.python.antlr.uast :as u]))

(def mutations
  [[\"bounded arithmetic\" 'py/arith
    '(fn [op a b] (py/checked-add (py/num a) (py/num b)))
    #'ops/exact-operators-test]
   [\"unary sign\" 'py/neg '(fn [a] (py/pos a))
    #'ops/exact-operators-test]
   [\"rounded comparison\" 'py/num-compare
    '(fn [a b]
       (let [x (data/float-value (py/num a))
             y (data/float-value (py/num b))]
         (if (< x y) -1 (if (> x y) 1 0))))
    #'ops/exact-operators-test]
   [\"float overflow mapping\" 'py/int-result
    (walk/postwalk-replace
      {:yin.vm.integer/float-overflow :mutation/ignored}
      (second (first (filter #(= 'py/int-result (first %))
                             p/function-definitions))))
    #'ops/exact-operators-test]
   [\"index bounds\" 'py/index '(fn [k n] 0)
    #'ops/index-range-repeat-test]
   [\"repeat bounds\" 'py/repeat '(fn [s n] (py/tuple []))
    #'ops/index-range-repeat-test]
   [\"slice clamp\" 'py/slice-positions '(fn [s n] [])
    #'ops/index-range-repeat-test]
   [\"range product\" 'py/range-elem
    '(fn [start step i]
       (py/int-result
         (integer/add start (py/int-result (integer/mul i step)))))
    #'ops/range-small-profile-test]])

(deftest intentional-mutations
  (doseq [[name key form test-var] mutations]
    (println \"MUTATION\" name)
    (let [ast (u/seq-nodes
                (map (fn [[k f]]
                       (u/def"'! k (u/sexp->uast (if (= k key) form f))))
                     p/function-definitions))]
      (with-redefs [p/uast ast]
        (t/test-vars [test-var])))))
EOF
