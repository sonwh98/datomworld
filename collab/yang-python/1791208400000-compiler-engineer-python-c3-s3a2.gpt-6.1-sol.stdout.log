(require '[yang.python.antlr.prelude-parity-test :as p]
         '[yang.python.antlr.prelude :as prelude]
         '[yang.python.antlr.uast :as u])
(let [run (:ast-walker @#'p/runners)
      forms {:integer '(let [loop (fn [self i x]
                                   (if (< i 100000)
                                     (self self (+ i 1) (py/add x 1)) x))]
                         (loop loop 0 0))
             :range '(let [r (py/range3 0 100000 1)
                           loop (fn [self i]
                                  (if (= (py/range-at r i) :py/stop)
                                    i (self self (+ i 1))))]
                       (loop loop 0))}]
  (doseq [[k form] forms]
    (let [ast (u/mark-tails (u/then prelude/uast (u/sexp->uast form)))
          begin (System/nanoTime)
          result (run ast)]
      (println k result (/ (- (System/nanoTime) begin) 1e9)))))

