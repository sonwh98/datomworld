(def decode
  '(fn [x]
     (if (= (get x :int) nil) x
         (py/int-result (integer/parse (get x :int) 16)))))


(def operate
  '(fn [op a b]
     (if (= op \"add\") (py/add a b)
         (if (= op \"sub\") (py/sub a b)
             (if (= op \"mul\") (py/mul a b)
                 (if (= op \"neg\") (py/neg a)
                     (if (= op \"lt\") (py/lt a b)
                         (if (= op \"le\") (py/le a b)
                             (if (= op \"gt\") (py/gt a b)
                                 (if (= op \"ge\") (py/ge a b)
                                     (if (= op \"eq\") (py/eq a b)
                                         (if (= op \"ne\") (py/ne a b)
                                             (py/truediv a b)))))))))))))


(defn fixture-form
  \"A guest loop evaluates every row, returning only mismatch indices.\"
  [rows]
  (list 'let
        ['decode decode 'operate operate
         'rows rows
         'loop
         '(fn [self i failures]
            (if (< i (data/count rows))
              (let [row (get rows i)
                    result
                    (py/try
                      (fn [] (operate (get row 0) (decode (get row 1))
                                       (decode (get row 2))))
                      (fn [e]
                        (data/str-concat
                          \""'!" (get (py/getattr (py/getattr e "__class__")
                                               "__name__") :py/str)))
                      (fn [] :py/None))]
                (self self (+ i 1)
                      (if (data/content= result (decode (get row 3)))
                        failures (conj failures i))))
              failures))]
        '"'(loop loop 0 [])))


(deftest fixture-parser-test
  (is (= (fixtures/parse \"int-ops-v1\\nCPython 3.9.6\\nadd\\t1\\t1\\t2\\n\")
