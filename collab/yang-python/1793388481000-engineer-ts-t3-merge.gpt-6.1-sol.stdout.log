tion-nt {:js/str \"F\"} 0 :strict :normal\ntest/yang/typescript/antlr/class_prelude_test.cljc:192:           g (js/make-function-nt {:js/str \"G\"} 0 :strict :normal\ntest/yang/typescript/antlr/class_prelude_test.cljc:215:   [(throws '(js/class-heritage (js/make-function-nt {:js/str \"a\"} 0 :lexical :arrow\ntest/yang/typescript/antlr/class_prelude_test.cljc:219:   ['(let [p (js/make-function {:js/str \"P\"} 0 :strict :normal (fn [t a] t))\ntest/yang/typescript/antlr/class_prelude_test.cljc:224:   [(throws '(let [p (js/make-function {:js/str \"P\"} 0 :strict :normal (fn [t a] t))]\ntest/yang/typescript/antlr/class_prelude_test.cljc:265:           m (js/make-function-nt {:js/str \"m\"} 0 :strict :method (fn [t a] t) false)\ntest/yang/typescript/antlr/class_prelude_test.cljc:266:           g (js/make-function-nt {:js/str \"get x\"} 0 :strict :method (fn [t a] 1) false)\ntest/yang/typescript/antlr/class_prelude_test.cljc:267:           s (js/make-function-nt {:js/str \"set x\"} 1 :strict :method (fn [t a] t) false)]\ntest/yang/typescript/antlr/class_prelude_test.cljc:289:             (js/make-function-nt {:js/str \"set x\"} 1 :strict :method\ntest/yang/typescript/antlr/class_prelude_test.cljc:369:           mf (js/make-function-nt {:js/str \"#m\"} 0 :strict :method (fn [t a] {:n 11}) false)\ntest/yang/typescript/antlr/class_prelude_test.cljc:370:           gf (js/make-function-nt {:js/str \"get #g\"} 0 :strict :method (fn [t a] {:n 22}) false)]\ntest/yang/typescript/antlr/class_prelude_test.cljc:386:                                        (js/make-function-nt {:js/str \"get #g\"} 0 :strict\ntest/yang/typescript/antlr/class_prelude_test.cljc:395:                                        (js/make-function-nt {:js/str \"#m\"} 0 :strict\ntest/yang/typescript/antlr/class_prelude_test.cljc:406:           getter (js/make-function-nt {:js/str \"get\"} 0 :strict :method\ntest/yang/typescript/antlr/class_prelude_test.cljc:408:           setter (js/make-function-nt {:js/str \"set\"} 1 :strict :method\ntest/yang/typescript/antlr/class_prelude_test.cljc:440:             (js/make-function-nt {:js/str \"#m\"} 0 :strict :method (fn [t a] 1) false))\ntest/yang/typescript/antlr/class_prelude_test.cljc:508:             (js/make-function-nt {:js/str \"get who\"} 0 :strict :method\ntest/yang/typescript/antlr/class_prelude_test.cljc:568:   [(throws '(let [f (js/make-function {:js/str \"F\"} 0 :strict :normal (fn [t a] t))]\ntest/yang/typescript/antlr/class_prelude_test.cljc:573:   ['(let [f (js/make-function {:js/str \"F\"} 0 :strict :normal (fn [t a] t))\n(ns yang.core.call\n  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n   §8.10). This namespace emits the same pure definitions into bundled\n   preludes and the linked `yang.call` module.\"\n  (:require [yang.core.prelude :as core]\n            [yang.core.uast :as u]))\n\n\n(def module-name\n  \"The linker module that publishes the shared calling runtime.\"\n  'yang.call)\n\n\n(def host-names\n  \"Host module names read by the guest definitions.\"\n  '#{cell/get data/callable? data/contains? data/count data/map?\n     data/string? data/vector?})\n\n\n(def definitions\n  \"The one ordered definition list used by both emitters.\"\n  '[;; Descriptor projection remains structural after callable admission.\n    [yang.call/_descriptor\n     (fn [callable]\n       (if (data/map? callable)\n         (if (= (get callable :type) :cell-ref)\n           (cell/get callable)\n           callable)\n         nil))]\n    [yang.call/entry\n     (fn [callable]\n       (get (yang.call/_descriptor callable) :yang.call/entry))]\n    [yang.call/eligible?\n     (fn [callable]\n       (let [descriptor (yang.call/_descriptor callable)]\n         (if (nil? (yang.call/entry callable))\n           false\n           (if (data/contains? descriptor :yang.call/eligible?)\n             ((get descriptor :yang.call/eligible?) callable)\n             true))))]\n    [yang.call/invocation\n     (fn [callee positional named raise]\n       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/invocation-with\n     (fn [callee positional named raise options]\n       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/_pair?\n     (fn [pair]\n       (if (data/vector? pair)\n         (= (data/count pair) 2)\n         false))]\n    [yang.call/_named-pairs?\n     (fn [pairs index]\n       (if (= index (data/count pairs))\n         true\n         (let [pair (data/nth pairs index)]\n           (if (yang.call/_pair? pair)\n             (if (data/string? (data/nth pair 0))\n               (yang.call/_named-pairs? pairs (+ index 1))\n               false)\n             false))))]\n    [yang.call/valid-invocation?\n     (fn [invocation]\n       (if (data/map? invocation)\n         (if (data/contains? invocation :yang.call/callee)\n           (if (data/contains? invocation :yang.call/positional)\n             (if (data/contains? invocation :yang.call/named)\n               (if (data/contains? invocation :yang.call/raise)\n                 (if (data/vector? (get invocation :yang.call/positional))\n                   (if (data/vector? (get invocation :yang.call/named))\n                     (yang.call/_named-pairs?\n                       (get invocation :yang.call/named) 0)\n                     false)\n                   false)\n                 false)\n               false)\n             false)\n           false)\n         false))]\n    [yang.call/condition\n     (fn [reason evidence]\n       (assoc (assoc {} :yang.call/reason reason)\n              :yang.call/data evidence))]\n    [yang.call/thrown\n     (fn [value]\n       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n              :yang.call/value value))]\n    [yang.call/transfer\n     (fn [raise condition]\n       (raise condition))]\n    [yang.call/invoke\n     (fn [callable positional named raise]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation callable positional named raise)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]\n    [yang.call/invoke-with\n     (fn [callable positional named raise options]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation-with\n                          callable positional named raise options)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]])\n\n\n(def ^:private public-exports\n  '#{entry eligible? invocation invocation-with valid-invocation? condition\n     thrown transfer invoke invoke-with})\n\n\n(def uast\n  \"The bundled definitions, in source order and tail marked.\"\n  (u/mark-tails\n    (reduce (fn [ast [key form]]\n              (u/then ast (u/def! key (u/sexp->uast form))))\n            (u/def! (ffirst definitions)\n                    (u/sexp->uast (second (first definitions))))\n            (rest definitions))))\n\n\n(def module-uast\n  \"The linked module tree built from the same `definitions`.\"\n  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n                                          [] definitions)]\n    (core/module-tree stripped [])))\n\n\n(def module-exports\n  \"Public module exports (private helper definitions stay internal).\"\n  public-exports)\n\n\n(def ^:private module-free-names\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"The linker module spec for `yang.call` over `registry`.\"\n  [registry]\n  (core/module-spec {:module-name module-name\n                     :ast module-uast\n                     :exports module-exports\n                     :requires {}\n                     :free-names module-free-names\n                     :registry registry\n                     :message \"the yang.call module reads an undeclared name\"\n                     :refusal-ns \"yang.call\"}))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/typescript/antlr/linked_prelude_test.cljc && sed -n '1680,1755p' src/cljc/yang/typescript/antlr/prelude.cljc && sed -n '1,130p' test/yang/typescript/antlr/class_prelude_test.cljc && sed -n '1,110p' src/cljc/yang/typescript/antlr/prelude.cljc && cat src/dev/subsystems.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/typescript/antlr/linked_prelude_test.cljc && sed -n '1680,1755p' src/cljc/yang/typescript/antlr/prelude.cljc && sed -n '1,130p' test/yang/typescript/antlr/class_prelude_test.cljc && sed -n '1,110p' src/cljc/yang/typescript/antlr/prelude.cljc && cat src/dev/subsystems.edn\"","aggregated_output":"(ns yang.typescript.antlr.linked-prelude-test\n  \"T1 step S5: the JavaScript runtime profile and its hook prelude as the\n   linker modules `js` and `jssp`. Both emit from the single definition\n   lists their bundled twins load; the specs declare every free name of\n   their trees; a linked run on the three vector VMs prints what the\n   bundled run prints; the AST walker's link stays refused until L-b. The\n   published modules and the linked runs are\n   `yang.typescript.antlr.linked-harness`'s: one publication per process,\n   served `:trusted`, so every test that publishes or links is slow.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.stream :as stream]\n    [dao.test-slow :as slow]\n    [yang.safepoint :as safepoint]\n    [yang.core.uast :as u]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.lower-portable-test :as portable]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yang.typescript.antlr.safepoint :as hooks]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.encoder :as encoder]\n    [yin.vm.engine :as engine]\n    [yin.vm.module :as module]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn- refusal-of\n  \"The ex-data of what `thunk` throws, or nil when it returns.\"\n  [thunk]\n  (try (thunk)\n       nil\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         (or (ex-data e) {}))))\n\n\n(defn- def-key\n  \"The literal key of a `(yin/def k v)` application node, else nil.\"\n  [node]\n  (when (and (map? node)\n             (= :application (:type node))\n             (= 'yin/def (get-in node [:operator :name])))\n    (get-in node [:operands 0 :value])))\n\n\n;; =============================================================================\n;; The module emitters\n;; =============================================================================\n\n(deftest jssp-module-uast-is-one-wide-application-test\n  (let [ast hooks/module-uast\n        operands (:operands ast)\n        definitions (butlast operands)]\n    (is (= :application (:type ast)))\n    (is (= :lambda (:type (:operator ast))))\n    (is (= (count operands) (count (:params (:operator ast)))))\n    (is (nil? (get-in ast [:operator :body :value])))\n    (is (= (u/sexp->uast '(require (quote js)))\n           (dissoc (last operands) :tail?)))\n    (testing \"the placeholders come first, each the literal :js/uninit\"\n      (let [n (count hooks/runtime-keys)\n            placeholders (take n definitions)]\n        (is (= (mapv hooks/strip hooks/runtime-keys)\n               (mapv def-key placeholders)))\n        (is (every? #(= {:type :literal, :value :js/uninit}\n                        (dissoc (get-in % [:operands 1]) :tail?))\n                    placeholders))))\n    (testing \"then every definition, stripped, in definition order\"\n      (is (= (mapv (comp hooks/strip first) hooks/function-definitions)\n             (mapv def-key (drop (count hooks/runtime-keys) definitions)))))\n    (testing \"no symbol of the module's own namespace survives stripping\"\n      (is (not-any? (fn [x] (and (symbol? x) (= \"js.sp\" (namespace x))))\n                    (tree-seq coll? seq ast))))\n    (testing \"`js/*` references stay qualified: the base prelude's exports\"\n      (is (some (fn [x] (and (symbol? x) (= \"js\" (namespace x))))\n                (tree-seq coll? seq ast))))))\n\n\n(deftest jssp-module-exports-test\n  (is (= (set (map (comp hooks/strip first) hooks/function-definitions))\n         hooks/module-exports))\n  (is (every? #(contains? hooks/module-exports %) '[attach! loop call]))\n  (is (not-any? namespace hooks/module-exports))\n  (is (not (contains? hooks/module-exports 'cursor)))\n  (is (empty? (filter #(contains? vm/primitives %) hooks/module-exports))))\n\n\n(deftest js-module-exports-stage0-entry-points-test\n  (testing \"the lowering's literal, for-in and JSON entry points are exported\"\n    (is (every? #(contains? prelude/module-exports %)\n                '[new-object new-array literal-proto! for-in-start for-in-next\n                  install-json! define-accessor-half! json-stringify json-parse]))))\n\n\n(deftest jssp-module-spec-test\n  (let [spec (hooks/module-spec (h/registry) :test/js-address)]\n    (is (= 'jssp (:name spec) hooks/module-name))\n    (is (= hooks/module-uast (:ast spec)))\n    (is (= hooks/module-exports (:exports spec)))\n    (is (= {'js :test/js-address} (:requires spec)))\n    (testing \"a js-qualified free name is covered by the requirement\"\n      (is (empty? (filter #(= \"js\" (namespace %)) (keys (:primitives spec))))))\n    (testing \"the qualified declarations are exactly the host names\"\n      (is (= hooks/host-names\n             (set (filter namespace (keys (:primitives spec)))))))\n    (testing \"a free name no registry module supplies is refused\"\n      (let [no-cell (-> (module/empty-registry)\n                        (data/register-data-module {::data/max-items 1048576})\n                        (prelude/register-integer-module h/integer-limits))\n            refusal (refusal-of #(hooks/module-spec no-cell :test/js-address))]\n        (is (= :yang.typescript.antlr/undeclared-free\n               (:yang.typescript.antlr/refusal refusal)))))))\n\n\n(deftest js-module-spec-declares-every-free-name-test\n  (let [call-address (:call-address @h/published)\n        spec (prelude/module-spec (h/registry) call-address)]\n    (is (= 'js (:name spec)))\n    (is (= prelude/module-exports (:exports spec)))\n    (is (= {'yang.call call-address} (:requires spec)))\n    (testing \"a registry without the data module is refused\"\n      (let [no-data (-> (module/empty-registry)\n                        module/register-cell-module\n                        (prelude/register-integer-module h/integer-limits))\n            refusal (refusal-of #(prelude/module-spec no-data call-address))]\n        (is (= :yang.typescript.antlr/undeclared-free\n               (:yang.typescript.antlr/refusal refusal)))\n        (is (= \"data\" (namespace (:name refusal))))))))\n\n\n;; =============================================================================\n;; Publication\n;; =============================================================================\n\n(defn- publication\n  []\n  (let [{:keys [result address]} @h/published\n        links (:links result)]\n    (testing \"js publishes with no undeclared free name\"\n      (is (some? address))\n      (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n        (is (= :ok (get-in links [f :status])) (str f))))\n    (testing \"the AST walker is refused :undeclared-free on a sibling read\n              until L-b; L-b's landing flips this assertion\"\n      (let [walker (get links :yin.ast/code)]\n        (is (= :refused (:status walker)))\n        (is (= :undeclared-free (:reason walker)))\n        (is (contains? prelude/module-exports (:name walker)))))\n    (testing \"jssp publishes over js\"\n      (let [{:keys [result]} @h/published-jssp]\n        (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n          (is (= :ok (get-in (:links result) [f :status])) (str f)))))))\n\n\n(deftest ^:slow publication-test\n  (slow/guard \"publication-test\" publication))\n\n\n;; =============================================================================\n;; Linked runs equal bundled runs\n;; =============================================================================\n\n(def ^:private programs\n  \"Hand-built packets: name -> packet.\"\n  {:log-literal (portable/program (portable/log-stmt (portable/num-expr \"1\"))),\n   :var-and-log (portable/program\n                  (portable/var-stmt \"var\" \"x\" (portable/num-expr \"7\"))\n                  (portable/log-stmt (portable/name-expr \"x\"))),\n   :let-in-tdz (portable/program\n                 (portable/log-stmt (portable/name-expr \"y\"))\n                 (portable/var-stmt \"let\" \"y\" (portable/num-expr \"1\")))})\n\n\n(defn- bundled\n  [ast]\n  (render/output ((get parity/runners :semantic) ast)))\n\n\n(defn- linked\n  [k ast]\n  (render/output (vm/value (h/run-linked k ast))))\n\n\n(defn- linked-equals-bundled\n  []\n  (doseq [[nm pk] programs\n          :let [expected (bundled (lower/lower-packet pk))\n                ast (lower/lower-packet pk {:prelude :linked})]]\n    (doseq [k (keys h/backends)]\n      (is (= expected (linked k ast)) (str nm \" \" k)))))\n\n\n(deftest ^:slow linked-equals-bundled-test\n  (slow/guard \"linked-equals-bundled-test\" linked-equals-bundled))\n\n\n;; =============================================================================\n;; The hook prelude linked: signals through the module boundary\n;; =============================================================================\n\n(def ^:private while-loop\n  \"`while (cond) { }` over singleExpression form `cond`.\"\n  (fn [cond-form]\n    [:iterationStatement\n     [\"While\" \"while\"] [\"OpenParen\" \"(\"]\n     [:expressionSequence cond-form]\n     [\"CloseParen\" \")\"]\n     [:statement [:block [\"OpenBrace\" \"{\"] [\"CloseBrace\" \"}\"]]]]))\n\n\n(def ^:private true-expr\n  [:singleExpression [:literal [\"BooleanLiteral\" \"true\"]]])\n\n\n(def ^:private false-expr\n  [:singleExpression [:literal [\"BooleanLiteral\" \"false\"]]])\n\n\n(def ^:private spin\n  (portable/program (while-loop true-expr)))\n\n\n(def ^:private caught\n  (portable/program\n    [:tryStatement\n     [\"Try\" \"try\"]\n     [:block [\"OpenBrace\" \"{\"]\n      [:statementList [:statement (while-loop true-expr)]]\n      [\"CloseBrace\" \"}\"]]\n     [:catchProduction\n      [\"Catch\" \"catch\"] [\"OpenParen\" \"(\"]\n      [:identifier [\"Identifier\" \"e\"]]\n      [\"CloseParen\" \")\"]\n      [:block [\"OpenBrace\" \"{\"]\n       [:statementList [:statement (portable/log-stmt (portable/num-expr \"9\"))]]\n       [\"CloseBrace\" \"}\"]]]]))\n\n\n(def ^:private spin-then-log\n  (portable/program (while-loop false-expr)\n                    (portable/log-stmt (portable/num-expr \"5\"))))\n\n\n(defn- envelope\n  [pk]\n  (let [[_ [[port e]]] (lower/lower-transform {:prelude :linked} pk)]\n    (assert (= :program port))\n    e))\n\n\n(defn- derived-ast\n  \"`A'` for `pk` under the linked profile.\"\n  [pk]\n  (let [projected (encoder/project (envelope pk))\n        {:keys [envelope]} (safepoint/derive-envelope projected\n                                                      hooks/linked-profile\n                                                      :test/derived)]\n    (vm/semantic-bytecode->ast (nth (:yin/batch envelope) (:yin/root envelope)))))\n\n\n(defn- with-signals\n  \"A linked `prep` handing the task a signal stream holding `signals`.\"\n  [signals]\n  (fn [task]\n    (let [handle (tu/new-stream 8)]\n      (doseq [s signals] (stream/append! handle s))\n      (let [[ref task] (engine/attach-resource task handle)]\n        (assoc-in task [:store hooks/signals-key] ref)))))\n\n\n(defn- outcome\n  [task]\n  [(vm/halted? task) (vm/blocked? task) (render/output (vm/value task))])\n\n\n(defn- on-every-vm\n  [ast signals]\n  (into {}\n        (map (fn [k]\n               [k (try (outcome (h/run-linked k ast\n                                              {:link-source (h/safepoint-source),\n                                               :prep (with-signals signals)}))\n                       (catch #?(:cljd Object :clj Exception :cljs :default) e\n                         [:thrown (ex-message e)]))]))\n        (keys h/backends)))\n\n\n(defn- every=\n  [expected results]\n  (doseq [[k result] results]\n    (is (= expected result) (str k))))\n\n\n(defn- linked-interrupt\n  []\n  (testing \"while (true) with one signal ends Interrupt, uncaught, through\n            the module boundary\"\n    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n            (on-every-vm (hooks/linked-program (derived-ast spin)) [2])))\n  (testing \"a try/catch around the loop does not catch it\"\n    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n            (on-every-vm (hooks/linked-program (derived-ast caught)) [2]))))\n\n\n(deftest ^:slow linked-interrupt-test\n  (slow/guard \"linked-interrupt-test\" linked-interrupt))\n\n\n(defn- linked-no-park\n  []\n  (testing \"with no signal pending the derived program finishes without\n            blocking and prints what the naive one prints\"\n    (every= [true false {:js/out [\"5\"], :js/uncaught nil}]\n            (on-every-vm (hooks/linked-program (derived-ast spin-then-log))\n                         []))))\n\n\n(deftest ^:slow linked-no-park-test\n  (slow/guard \"linked-no-park-test\" linked-no-park))\n\n\n(defn- fail-closed\n  []\n  (testing \"the derived linked program with no jssp binding names the hook\"\n    (doseq [[k result] (on-every-vm (derived-ast spin) [])]\n      (is (= :thrown (first result)) (str k))\n      (is (re-find #\"jssp/loop\" (second result)) (str k)))))\n\n\n(deftest ^:slow linked-fail-closed-test\n  (slow/guard \"linked-fail-closed-test\" fail-closed))\n             false))\n>>>>>>> origin/master\n         false))]\n    [js/construct-with-nt\n     ;; [[Construct]](args, nt): a derived constructor allocates nothing (its\n     ;; `this` is bound by super()); every other kind allocates from\n     ;; nt.prototype. A bound function constructs its target, passing the\n     ;; target as new.target when nt is the bound function itself.\n     (fn [f args nt]\n       (if (js/is-constructor? f)\n         (let [c (cell/get f)]\n           (if (nil? (get c :bound-target))\n             (if (= (get c :kind) :derived)\n               ((get c :code) :js/undefined args nt)\n               (let [pr (js/get-prop nt {:js/str \"prototype\"})\n                     o (js/make-object (if (js/object? pr) pr js.rt/obj-proto))\n                     _ (if (= (get c :kind) :class)\n                         (do (js/brand! o f) (js/run-fields! f o))\n                         :js/undefined)\n                     r (if (= (get c :nt?) true)\n                         ((get c :code) o args nt)\n                         ((get c :code) o args))]\n                 (if (js/object? r) r o)))\n             (js/construct-with-nt (get c :bound-target)\n                                   (data/into (get c :bound-args) args)\n                                   (if (= nt f) (get c :bound-target) nt))))\n         (js/throw-type-error {:js/str \"value is not a constructor\"})))]\n    [js/construct (fn [f args] (js/construct-with-nt f args f))]\n\n    ;; ---------------------------------------------------------- escapes\n    ;; The dynamic context is one record in one cell, {:handlers}: every\n    ;; capture point saves it and every escape restores it. The handler stack\n    ;; is a chain of frames [tag payload rest n]: :handler frames hold the\n    ;; continuation `throw` delivers to, :finally frames a thunk of one\n    ;; argument (the thrown value, or undefined) that every exit through\n    ;; them runs; n, the frame count, makes \"unwind to here\" an integer\n    ;; comparison. A first pass through a capture point is told from a\n    ;; re-entry by a flag cell, never by inspecting the continuation.\n    [js/ctx (fn [hs] (assoc {} :handlers hs))]\n    [js/rt-ctx (fn [] js.rt/ctx)]\n    [js/restore! (fn [saved] (cell/set! js.rt/ctx saved))]\n    [js/handlers (fn [] (get (cell/get js.rt/ctx) :handlers))]\n    [js/set-handlers!\n     (fn [hs] (cell/set! js.rt/ctx (assoc (cell/get js.rt/ctx) :handlers hs)))]\n    [js/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n    [js/frame\n     (fn [tag payload rest]\n       (conj (conj (conj (conj [] tag) payload) rest)\n             (+ 1 (js/frame-depth rest))))]\n    [js/pop-frame\n     (fn [hs]\n       (cell/set! js.rt/ctx (assoc (cell/get js.rt/ctx) :handlers (get hs 2))))]\n    [js/throw\n     (fn [e]\n       (let [hs (js/handlers)]\n         (if (nil? hs)\n           (:js/no-handler e)\n           (if (= (get hs 0) :finally)\n             (do (js/pop-frame hs) ((get hs 1) e) (js/throw e))\n             ((get hs 1) e)))))]\n    [js/unwind-to\n     ;; pop frames above frame count n, running each finally thunk\n     (fn [n]\n       (let [hs (js/handlers)]\n         (if (nil? hs)\n           :js/undefined\n           (if (<= (get hs 3) n)\n             :js/undefined\n             (do (js/pop-frame hs)\n                 (if (= (get hs 0) :finally)\n                   ((get hs 1) :js/undefined)\n                   :js/undefined)\n                 (js/unwind-to n))))))]\n    [js/try\n     (fn [body handler]\n       (let [saved (cell/get js.rt/ctx)\n(ns yang.typescript.antlr.class-prelude-test\n  \"T3 step S2: constructor kinds and `new.target` dispatch in the `js`\n   prelude. `make-function-nt`'s `nt?` flag, `call` refusing class kinds,\n   `construct-with-nt` allocating from `new.target.prototype`, derived\n   constructors, bound functions and `is-constructor?`. Tiny UAST programs\n   run on every VM through the parity harness.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [clojure.walk :as walk]\n    [dao.jing.cbor :as cbor]\n    [dao.test-slow :as slow]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]))\n\n\n(defn- result-vector?\n  [x]\n  (and (vector? x) (seq x) (not (symbol? (first x))) (some seq? x)))\n\n\n(defn- unqualify\n  [form]\n  (walk/postwalk\n    (fn [x]\n      (cond (and (symbol? x)\n                 (contains? #{\"clojure.core\" \"cljs.core\" \"cljd.core\"}\n                            (namespace x)))\n            (symbol (name x))\n            (result-vector? x) (reduce (fn [acc a] (list 'js/vconj acc a)) [] x)\n            :else x))\n    form))\n\n\n(def ^:private nt-recorder\n  \"A constructor body that records its new.target on `this`.\"\n  '(fn [this args nt]\n     (do (js/define-own! this {:js/str \"nt\"} (js/slot nt true true true))\n         :js/undefined)))\n\n\n(defn- check\n  \"Run `cases` ([form expected]) as one vector program on every VM.\"\n  [cases]\n  (let [form (parity/program-form\n               (reduce (fn [acc [f _]]\n                         (list 'js/vconj\n                               acc\n                               (unqualify (walk/postwalk-replace\n                                            {'NT-REC nt-recorder}\n                                            f))))\n                       []\n                       cases))\n        expected (mapv (fn [[_ e]] (parity/expected-value e)) cases)]\n    (doseq [[k result] (parity/run-with-prelude prelude/uast form)]\n      (testing (str k)\n        (is (= (count expected) (count result)) (pr-str result))\n        (when (and (vector? result) (= (count expected) (count result)))\n          (doseq [[[f _] exp act] (map vector cases expected result)]\n            (is (cbor/content= exp act)\n                (str (pr-str f) \" => \" (pr-str act) \", expected \"\n                     (pr-str exp)))))))))\n\n\n(defn- k\n  [x]\n  {:js/str x})\n\n\n(defn- throws\n  [expr]\n  (list 'js/try (list 'fn [] expr) '(fn [e] (js/get-prop e {:js/str \"name\"}))))\n\n\n(def ^:private kind-cases\n  [;; class kinds refuse an ordinary call; construct reaches the code\n   [(throws '(js/call (js/make-function-nt {:js/str \"A\"} 0 :strict :class\n                                           (fn [this args nt] this)\n                                           true)\n                      :js/undefined\n                      []))\n    (k \"TypeError\")]\n   [(throws '(js/call (js/make-function-nt {:js/str \"B\"} 0 :strict :derived\n                                           (fn [this args nt] this)\n                                           true)\n                      :js/undefined\n                      []))\n    (k \"TypeError\")]\n   ;; constructibility by :kind\n   ['(let [mk (fn [kind]\n                (js/is-constructor?\n                  (js/make-function-nt {:js/str \"f\"} 0 :strict kind\n                                       (fn [this args] this)\n                                       false)))]\n       [(mk :normal) (mk :class) (mk :derived) (mk :method) (mk :arrow)\n        (mk :getter) (mk :accessor) (mk :builtin)])\n    [true true true false false false false false]]\n   ;; the five-argument make-function is the nt?-false shape\n   ['(js/call (js/make-function {:js/str \"f\"} 1 :strict :normal\n                                (fn [this args] (js/arg args 0)))\n              :js/undefined\n              (js/vconj [] {:n 5}))\n    {:n 5}]])\n\n\n(def ^:private new-target-cases\n  [;; a plain call passes undefined as new.target\n   ['(js/call (js/make-function-nt {:js/str \"f\"} 0 :strict :normal\n                                   (fn [this args nt] nt)\n                                   true)\n              :js/undefined\n              [])\n    :js/undefined]\n   ;; construct passes the constructor itself\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  (fn [this args nt] nt)\n                                  true)]\n       (= (js/construct f []) f))\n    true]\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  NT-REC\n                                  true)\n           o (js/construct f [])]\n       (= (js/get-prop o {:js/str \"nt\"}) f))\n    true]\n   ;; construct-with-nt allocates from nt.prototype\n   ['(let [f (js/make-function-nt {:js/str \"F\"} 0 :strict :class\n                                  NT-REC\n                                  true)\n           g (js/make-function-nt {:js/str \"G\"} 0 :strict :class\n                                  (fn [this args nt] this)\n(ns ^{:clj-kondo/config '{:lint-as {yang.typescript.antlr.prelude/defquoted clojure.core/def}}}\n yang.typescript.antlr.prelude\n  \"The `js` runtime profile, written as Universal AST\n   (docs/design/yang.typescript.md sections 3, 9, 10; the T1 plan's\n   section 6). JavaScript semantics for operators, coercion, equality,\n   strings, objects, functions and exceptions live here as guest code,\n   not in Clojure: the lowering only emits applications of these names.\n\n   Value encoding:\n     undefined, null  :js/undefined, :js/null (and the never guest-visible\n                      :js/tdz of an uninitialized binding): never host nil\n     boolean          host true / false\n     number           float64 content (`data/float64`) at the producer, on\n                      every host (JS cannot tell 2 from 2.0 as a bare\n                      Number). Arithmetic unwraps with `data/float-value`,\n                      computes on bare host doubles and rewraps with\n                      `data/float64`. The prelude holds no integral float\n                      literal: 1 is written (data/float64 1)\n     bigint           the bare exact integer, through `integer/*`; a number\n                      and a bigint are told apart by content equality with\n                      the same value as float64 (`js/kind-of`)\n     string           {:js/str s} when the code units are well-formed\n                      UTF-16, {:js/units [u ...]} otherwise; `js/mk-str` is\n                      the one normalizing door, so strict equality of\n                      strings is host `=`\n     object           a cell holding {:js/type :object :proto <ref|:js/null>\n                      :props <om> :extensible? true}; the guest reference\n                      is the cell ref, identity is `=` on refs\n     function         a cell holding {:js/type :function :code\n                      (fn [this args] ..) :yang.call/entry\n                      (fn [invocation] ..) :this-mode :strict|:lexical\n                      :name s :length n :props <om> :proto ref}\n     property slot    {:value v :writable b :enumerable b :configurable b}\n     own-key map      `om`: {:index {key slot} :ints [..sorted..] :strs\n                      [..insertion..] :syms []}; guest-visible order is the\n                      vectors, never a host map's\n\n   Calling convention: source calls are (js/call f this args), with `args`\n   a vector built by `js/vconj`; `js/call` supplies one invocation record\n   to the shared entry. Constructors retain (js/construct F args), and a\n   function's private code is (fn [this args] ..).\n\n   Control flow is continuations: `js/throw`, `js/try`, `js/try-finally`\n   and `js/call-ec` copy the Python prelude's escape machinery with JS\n   payloads: `js/throw` takes any value, the handler stack lives in the one\n   record cell `js.rt/ctx` ({:handlers} only), and a flag cell tells a\n   first pass through a capture point from a re-entry.\n\n   Runtime state is allocated by `js/init!`, once per task, under\n   `js.rt/*` keys (`js.rt/state` is the literal :js/uninit until `js/init!`\n   flips it to :js/ready as its last write; a second call allocates\n   nothing): the context and out cells, the global object and the intrinsic\n   prototypes. The definitions are one list; `uast` is the bundled prelude\n   and `module-uast` the same list as the linker module `js`. The module\n   emitter strips only the namespace `js/`, so no definition is named like\n   a primitive (`js/get-prop`, not `js/get`), and no binder inside the\n   prelude is named like a definition.\n\n   Host names the prelude depends on and does not define: `host-names`\n   (the cell module from yin.vm.module, the integer module from\n   yin.vm.integer, the rest from yin.vm.data).\"\n  #?(:cljs (:require-macros [yang.typescript.antlr.prelude :refer [defquoted]]))\n  (:require\n    #?(:cljd [clojure.edn :as edn])\n    [yang.core.prelude :as core]\n    [yang.core.uast :as u]\n    [yang.core.call :as call]\n    [yin.vm.integer :as integer]))\n\n\n#?(:clj\n   (defmacro defquoted\n     \"`def` of the quoted data `form`. ClojureDart compiles quoted data to\n      straight-line Dart, which the Dart AOT compiler cannot take as one\n      initializer, so there the data is one EDN string read back at load.\"\n     [name doc form]\n     (if (find-ns 'cljd.compiler)\n       (list 'def name doc (list 'edn/read-string (pr-str (second form))))\n       (list 'def name doc form))))\n\n\n(def host-names\n  \"Module exports the prelude calls.\"\n  (into '#{cell/new cell/get cell/set! data/count data/into data/subvec\n           data/number? data/nth data/str-concat data/str-length data/substring\n           data/str->code-points data/code-points->str data/float64\n           data/float-value data/content= data/str-unit-length data/str-unit-at\n           data/str-units data/units->str integer/add integer/sub integer/neg\n           integer/mul integer/compare integer/quot-rem integer/to-float\n           integer/compare-float integer/pow integer/shift-right\n           integer/shift-left integer/bit-and integer/bit-or integer/bit-xor\n           integer/bit-not integer/from-float integer/floor-div-mod\n           integer/format integer/parse integer/float-digits\n           integer/decimal->float}\n        call/host-names))\n\n\n(defquoted ^:private core-definitions\n  \"Pure definitions: lambdas only, so defining them runs nothing.\"\n  '[;; ----------------------------------------------------------------- kinds\n    [js/cell? (fn [x] (= (get x :type) :cell-ref))]\n    [js/symbol?\n     (fn [x]\n       (if (js/cell? x) (= (get (cell/get x) :js/type) :symbol) false))]\n    [js/object? (fn [x] (if (js/cell? x) (not (js/symbol? x)) false))]\n    [js/make-symbol\n     (fn [description]\n       (cell/new (assoc (assoc {} :js/type :symbol) :description description)))]\n    [js/str?\n     (fn [x]\n;; Canonical Subsystems Definition for datom.world\n;; Longest-prefix match over Clojure/ClojureScript/ClojureDart namespaces.\n;; See docs/design/test.subsystems.md for architectural invariants and gate ladder.\n\n{:subsystems\n [;; Layer 0: Storage, Stream & Core Data Foundations\n  {:name \"dao.stream\"\n   :prefixes [\"dao.stream\"]\n   :layer 0}\n\n  {:name \"dao.jing\"\n   :prefixes [\"dao.jing\"]\n   :layer 0}\n\n  {:name \"dao.data\"\n   :prefixes [\"dao.data\"]\n   :layer 0}\n\n  {:name \"dao.host\"\n   :prefixes [\"dao.host\"]\n   :layer 0}\n\n  {:name \"dao.base\"\n   :prefixes [\"dao.await\" \"dao.lease\" \"dao.pretty\" \"dao.datom\" \"dao.test-slow\"]\n   :layer 0}\n\n  ;; Layer 1: Space, GUI & Graphics\n  {:name \"dao.space\"\n   :prefixes [\"dao.space\"]\n   :layer 1}\n\n  {:name \"dao.gui\"\n   :prefixes [\"dao.gui\"]\n   :layer 1}\n\n  {:name \"dao.postgraphics\"\n   :prefixes [\"dao.postgraphics\"]\n   :layer 1}\n\n  ;; Layer 2: Virtual Machines & Execution\n  {:name \"yin.vm.ucf\"\n   :prefixes [\"yin.vm.ucf\"]\n   :layer 2}\n\n  {:name \"yin.vm\"\n   :prefixes [\"yin.vm\"]\n   :layer 2}\n\n  ;; Layer 3: Languages & Repl\n  {:name \"yin.repl\"\n   :prefixes [\"yin.repl\"]\n   :layer 3}\n\n  {:name \"yang.python\"\n   :prefixes [\"yang.python\" \"yang.antlr\"]\n   :layer 3}\n\n  {:name \"yang.typescript\"\n   :prefixes [\"yang.typescript\"]\n   :layer 3}\n\n  {:name \"yang.php\"\n   :prefixes [\"yang.php\"]\n   :layer 3}\n\n  {:name \"yang.base\"\n   :prefixes [\"yang.clojure\" \"yang.frontend\" \"yang.safepoint\"\n              \"yang.stage\" \"yang.tails\" \"yang.io\" \"yang.core\"]\n   :layer 3}\n\n  ;; Layer 4: Demos & World Applications\n  {:name \"demo\"\n   :prefixes [\"datomworld\" \"yin.demo\"]\n   :layer 4}\n\n  {:name \"world\"\n   :prefixes [\"world\"]\n   :layer 4}\n\n  ;; Development & Benchmarking Tooling\n  {:name \"dev\"\n   :prefixes [\"affected\" \"affected-test\" \"cljd-agg\"]\n   :layer :dev}\n\n  {:name \"bench\"\n   :prefixes [\"bench\"]\n   :layer :bench}]}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"The merge produced three conflict blocks, all in `prelude.cljc`. I’ll keep master’s `js/call` routing and move T3’s class-call rejection and `new.target` arity handling into the shared entry on `make-function-nt`. That preserves both behaviors. The other blocks will retain T3’s kind-based constructor check and the combined definition list."}}
