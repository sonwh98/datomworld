{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' test/yang/typescript/antlr/source_call_test.cljc && sed -n '1,260p' test/yang/typescript/antlr/source_call_fixtures.cljc && sed -n '1,220p' test/yang/call/conformance.clj && sed -n '4016,4095p' docs/design/yang.antlr.md && sed -n '1,180p' test/yang/python/antlr/call_entry_test.cljc && sed -n '1,180p' test/yang/python/antlr/linked_harness.cljc\"","aggregated_output":"(ns yang.typescript.antlr.source-call-test\n  \"S11: real source calls through the shared convention (§8.10.11).\n   The composition publishes the separately lowered PHP body, runs it, and\n   projects its resolved functions into the JS global namespace. Neither\n   frontend's call nodes or function bodies are rewritten.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [dao.test-slow :as slow]\n    [yang.core.module :as core-module]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as php-lower]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.prelude :as php-prelude]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yang.typescript.antlr.source-call-fixtures :as fixtures]\n    [yin.vm :as vm]))\n\n\n(def ^:private published-php\n  (delay (h/publish-guest-module!\n           (php-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(defn- source-module\n  \"An ordinary module exporting the unmodified lowered source body.\"\n  [name packet]\n  (core-module/module-spec\n    :yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free\n    (h/registry)\n    {:name name,\n     :ast (core-module/module-tree\n            [(core-module/require-node 'php)\n             (u/def! 'body (u/lam [] (php-lower/lower-module-body packet)))]),\n     :exports '#{body},\n     :runtime-name 'php,\n     :runtime-address (:address @published-php)}))\n\n\n(defn- projection\n  \"Namespace composition only: preserve each resolved function cell.\"\n  [names]\n  (u/sexp->uast\n    (cons 'do\n          (map (fn [name]\n                 (list 'js/define-global! name (list 'php/resolve-fn name name)))\n               names))))\n\n\n(defn- check-source\n  [{:keys [module php-form functions ts-form expected]}]\n  (let [expected {:js/out (str/split-lines expected), :js/uncaught nil}\n        php-packet (php-h/packet php-form)\n        ts-packet (php-h/packet ts-form)\n        project (projection functions)\n        bundled (u/mark-tails\n                  (u/seq-nodes [(php-lower/lower-packet php-packet)\n                                prelude/uast project\n                                (u/app (u/v 'js/run-main) (lower/lower-unit ts-packet))]))]\n    (testing \"bundled source on every VM\"\n      (doseq [[backend run] parity/runners]\n        (is (= expected (render/output (run bundled))) (str backend))))\n    (testing \"published PHP source and linked JS on each admitted VM\"\n      (let [donor (h/publish-guest-module! (source-module module php-packet))\n            source (h/source {'yang.call (:call-address @h/published),\n                              'js (:address @h/published),\n                              'php (:address @published-php),\n                              module (:address donor)})\n            ast (u/mark-tails\n                  (u/seq-nodes\n                    [(core-module/require-node module)\n                     (u/sexp->uast '(php/init!))\n                     (u/app (u/v 'php/run-main) (u/v (symbol (str module) \"body\")))\n                     (core-module/require-node 'yang.call)\n                     (core-module/require-node 'js)\n                     (u/sexp->uast '(js/init!))\n                     project\n                     (lower/lower-packet ts-packet {:prelude :linked})]))]\n        (is (some? (:address donor)))\n        (doseq [backend (keys h/backends)]\n          (is (= :ok (get-in donor [:links (case backend\n                                             :semantic :yin.semantic/code\n                                             :stack :yin.debruijn.code\n                                             :register :yin.debruijn.register)\n                                    :status]))\n              (str backend \" source publication\"))\n          (is (= expected\n                 (render/output\n                   (vm/value (h/run-linked backend ast {:link-source source}))))\n              (str backend)))))))\n\n\n(deftest ^:slow source-calls-php-function-test\n  (slow/guard \"source-calls-php-function-test\" #(check-source fixtures/direct)))\n\n\n(deftest ^:slow source-foreign-store-and-callback-test\n  (slow/guard \"source-foreign-store-and-callback-test\" #(check-source fixtures/callback)))\n(ns yang.typescript.antlr.source-call-fixtures\n  \"Real PHP and TS source with parser-produced CST forms. Regeneration is\n   checked by source-call-parser-test; portable hosts lower these same forms.\")\n\n\n(def direct\n  '{:module phpm.s11-direct,\n    :php-source\n    \"<?php function phpfn($x, $y = 2.5) { return $x + $y; }\\n             function identity($x) { return $x; }\",\n    :functions [\"phpfn\" \"identity\"],\n    :ts-source\n    \"const stored = identity(phpfn);\\n     console.log(stored === phpfn, stored(1.5), phpfn(1.5, 3.5));\\n     const box = {f: stored}; console.log(box.f(2.5));\",\n    :expected \"true 4 5\\n5\",\n    :php-form\n    [:htmlDocument\n     [:phpBlock\n      [:topStatement\n       [:functionDeclaration\n        [\"Function_\" \"function\"]\n        [:identifier [\"Label\" \"phpfn\"]]\n        [\"OpenRoundBracket\" \"(\"]\n        [:formalParameterList\n         [:formalParameter [:variableInitializer [\"VarName\" \"$x\"]]]\n         [\"Comma\" \",\"]\n         [:formalParameter\n          [:variableInitializer\n           [\"VarName\" \"$y\"]\n           [\"Eq\" \"=\"]\n           [:constantInitializer [:constant [:literalConstant [\"Real\" \"2.5\"]]]]]]]\n        [\"CloseRoundBracket\" \")\"]\n        [:blockStatement\n         [\"OpenCurlyBracket\" \"{\"]\n         [:innerStatementList\n          [:innerStatement\n           [:statement\n            [:returnStatement\n             [\"Return\" \"return\"]\n             [:expression\n              [:expression [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$x\"]]]]]]\n              [\"Plus\" \"+\"]\n              [:expression [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$y\"]]]]]]]\n             [\"SemiColon\" \";\"]]]]]\n         [\"CloseCurlyBracket\" \"}\"]]]]\n      [:topStatement\n       [:functionDeclaration\n        [\"Function_\" \"function\"]\n        [:identifier [\"Label\" \"identity\"]]\n        [\"OpenRoundBracket\" \"(\"]\n        [:formalParameterList [:formalParameter [:variableInitializer [\"VarName\" \"$x\"]]]]\n        [\"CloseRoundBracket\" \")\"]\n        [:blockStatement\n         [\"OpenCurlyBracket\" \"{\"]\n         [:innerStatementList\n          [:innerStatement\n           [:statement\n            [:returnStatement\n             [\"Return\" \"return\"]\n             [:expression [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$x\"]]]]]]\n             [\"SemiColon\" \";\"]]]]]\n         [\"CloseCurlyBracket\" \"}\"]]]]]\n     [\"EOF\" \"<EOF>\"]],\n    :ts-form\n    [:program\n     [:sourceElements\n      [:sourceElement\n       [:statement\n        [:variableStatement\n         [:varModifier [\"Const\" \"const\"]]\n         [:variableDeclarationList\n          [:variableDeclaration\n           [:identifierOrKeyWord [:identifier [\"Identifier\" \"stored\"]]]\n           [\"Assign\" \"=\"]\n           [:singleExpression\n            [:singleExpression [:identifierName [:identifier [\"Identifier\" \"identity\"]]]]\n            [:arguments\n             [\"OpenParen\" \"(\"]\n             [:argumentList\n              [:argument\n               [:singleExpression [:identifierName [:identifier [\"Identifier\" \"phpfn\"]]]]]]\n             [\"CloseParen\" \")\"]]]]]\n         [\"SemiColon\" \";\"]]]]\n      [:sourceElement\n       [:statement\n        [:expressionStatement\n         [:expressionSequence\n          [:singleExpression\n           [:singleExpression\n            [:singleExpression [:identifierName [:identifier [\"Identifier\" \"console\"]]]]\n            [\"Dot\" \".\"]\n            [:identifierName [:identifier [\"Identifier\" \"log\"]]]]\n           [:arguments\n            [\"OpenParen\" \"(\"]\n            [:argumentList\n             [:argument\n              [:singleExpression\n               [:singleExpression [:identifierName [:identifier [\"Identifier\" \"stored\"]]]]\n               [\"IdentityEquals\" \"===\"]\n               [:singleExpression [:identifierName [:identifier [\"Identifier\" \"phpfn\"]]]]]]\n             [\"Comma\" \",\"]\n             [:argument\n              [:singleExpression\n               [:singleExpression [:identifierName [:identifier [\"Identifier\" \"stored\"]]]]\n               [:arguments\n                [\"OpenParen\" \"(\"]\n                [:argumentList\n                 [:argument\n                  [:singleExpression [:literal [:numericLiteral [\"DecimalLiteral\" \"1.5\"]]]]]]\n                [\"CloseParen\" \")\"]]]]\n             [\"Comma\" \",\"]\n             [:argument\n              [:singleExpression\n               [:singleExpression [:identifierName [:identifier [\"Identifier\" \"phpfn\"]]]]\n               [:arguments\n                [\"OpenParen\" \"(\"]\n                [:argumentList\n                 [:argument\n                  [:singleExpression [:literal [:numericLiteral [\"DecimalLiteral\" \"1.5\"]]]]]\n                 [\"Comma\" \",\"]\n                 [:argument\n                  [:singleExpression [:literal [:numericLiteral [\"DecimalLiteral\" \"3.5\"]]]]]]\n                [\"CloseParen\" \")\"]]]]]\n            [\"CloseParen\" \")\"]]]]\n         [\"SemiColon\" \";\"]]]]\n      [:sourceElement\n       [:statement\n        [:variableStatement\n         [:varModifier [\"Const\" \"const\"]]\n         [:variableDeclarationList\n          [:variableDeclaration\n           [:identifierOrKeyWord [:identifier [\"Identifier\" \"box\"]]]\n           [\"Assign\" \"=\"]\n           [:singleExpression\n            [:objectLiteral\n             [\"OpenBrace\" \"{\"]\n             [:propertyAssignment\n              [:propertyName [:identifierName [:identifier [\"Identifier\" \"f\"]]]]\n              [\"Colon\" \":\"]\n              [:singleExpression [:identifierName [:identifier [\"Identifier\" \"stored\"]]]]]\n             [\"CloseBrace\" \"}\"]]]]]\n         [\"SemiColon\" \";\"]]]]\n      [:sourceElement\n       [:statement\n        [:expressionStatement\n         [:expressionSequence\n          [:singleExpression\n           [:singleExpression\n            [:singleExpression [:identifierName [:identifier [\"Identifier\" \"console\"]]]]\n            [\"Dot\" \".\"]\n            [:identifierName [:identifier [\"Identifier\" \"log\"]]]]\n           [:arguments\n            [\"OpenParen\" \"(\"]\n            [:argumentList\n             [:argument\n              [:singleExpression\n               [:singleExpression\n                [:singleExpression [:identifierName [:identifier [\"Identifier\" \"box\"]]]]\n                [\"Dot\" \".\"]\n                [:identifierName [:identifier [\"Identifier\" \"f\"]]]]\n               [:arguments\n                [\"OpenParen\" \"(\"]\n                [:argumentList\n                 [:argument\n                  [:singleExpression [:literal [:numericLiteral [\"DecimalLiteral\" \"2.5\"]]]]]]\n                [\"CloseParen\" \")\"]]]]]\n            [\"CloseParen\" \")\"]]]]\n         [\"SemiColon\" \";\"]]]]]\n     [\"EOF\" \"<EOF>\"]]})\n\n\n(def callback\n  '{:module phpm.s11-callback,\n    :php-source\n    \"<?php function remember($f) { global $saved; $saved = $f; return $saved; }\\n             function recall() { global $saved; return $saved; }\\n             function callback($x) { global $saved; return $saved($x); }\",\n    :functions [\"remember\" \"recall\" \"callback\"],\n    :ts-source\n    \"let calls = 0; const captured = 2;\\n     const f = x => { calls++; return x + captured; };\\n     const returned = remember(f);\\n     console.log(returned === f, recall() === f, calls);\\n     console.log(callback(3), calls, recall() === f);\\n     console.log(returned(4), calls);\",\n    :expected \"true true 0\\n5 1 true\\n6 2\",\n    :php-form\n    [:htmlDocument\n     [:phpBlock\n      [:topStatement\n       [:functionDeclaration\n        [\"Function_\" \"function\"]\n        [:identifier [\"Label\" \"remember\"]]\n        [\"OpenRoundBracket\" \"(\"]\n        [:formalParameterList [:formalParameter [:variableInitializer [\"VarName\" \"$f\"]]]]\n        [\"CloseRoundBracket\" \")\"]\n        [:blockStatement\n         [\"OpenCurlyBracket\" \"{\"]\n         [:innerStatementList\n          [:innerStatement\n           [:statement\n            [:globalStatement\n             [\"Global\" \"global\"]\n             [:globalVar [\"VarName\" \"$saved\"]]\n             [\"SemiColon\" \";\"]]]]\n          [:innerStatement\n           [:statement\n            [:expressionStatement\n             [:expression\n              [:assignable\n               [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$saved\"]]]]]]\n              [:assignmentOperator [\"Eq\" \"=\"]]\n              [:expression [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$f\"]]]]]]]\n             [\"SemiColon\" \";\"]]]]\n          [:innerStatement\n           [:statement\n            [:returnStatement\n             [\"Return\" \"return\"]\n             [:expression\n              [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$saved\"]]]]]]\n             [\"SemiColon\" \";\"]]]]]\n         [\"CloseCurlyBracket\" \"}\"]]]]\n      [:topStatement\n       [:functionDeclaration\n        [\"Function_\" \"function\"]\n        [:identifier [\"Label\" \"recall\"]]\n        [\"OpenRoundBracket\" \"(\"]\n        [:formalParameterList]\n        [\"CloseRoundBracket\" \")\"]\n        [:blockStatement\n         [\"OpenCurlyBracket\" \"{\"]\n         [:innerStatementList\n          [:innerStatement\n           [:statement\n            [:globalStatement\n             [\"Global\" \"global\"]\n             [:globalVar [\"VarName\" \"$saved\"]]\n             [\"SemiColon\" \";\"]]]]\n          [:innerStatement\n           [:statement\n            [:returnStatement\n             [\"Return\" \"return\"]\n             [:expression\n              [:chain [:chainOrigin [:chainBase [:keyedVariable [\"VarName\" \"$saved\"]]]]]]\n             [\"SemiColon\" \";\"]]]]]\n         [\"CloseCurlyBracket\" \"}\"]]]]\n      [:topStatement\n       [:functionDeclaration\n        [\"Function_\" \"function\"]\n        [:identifier [\"Label\" \"callback\"]]\n        [\"OpenRoundBracket\" \"(\"]\n        [:formalParameterList [:formalParameter [:variableInitializer [\"VarName\" \"$x\"]]]]\n        [\"CloseRoundBracket\" \")\"]\n        [:blockStatement\n         [\"OpenCurlyBracket\" \"{\"]\n         [:innerStatementList\n          [:innerStatement\n           [:statement\n            [:globalStatement\n             [\"Global\" \"global\"]\n             [:globalVar [\"VarName\" \"$saved\"]]\n             [\"SemiColon\" \";\"]]]]\n          [:innerStatement\n           [:statement\n            [:returnStatement\n             [\"Return\" \"return\"]\n             [:expression\n              [:chain\n               [:chainOrigin\n(ns yang.call.conformance\n  \"The cross-language calling gates' shared composition (docs/design/\n   yang.antlr.md section 8.10.11): a donor program's named export reaches a\n   caller program by explicit published-export composition only.\n\n   A donor is real source of any admitted frontend, lowered unmodified and\n   published as an ordinary linker module whose one export, `body`, is the\n   lowered unit. A caller task requires that module, runs its body under the\n   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\n   `clj/run-main`), reads each named export from the donor runtime's global\n   namespace, and projects it into the caller runtime's namespace under the\n   same name; then the caller source, lowered unmodified, runs under its own\n   entry. The composition is a sequence of top-level nodes: no call node is\n   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\n   inserted, and the projected value is the donor's own callable value\n   (identity survives).\n\n   A callable value is task-local (a function is a cell, and cells are\n   task-local, section 8.11), so the export is answered as a node evaluated\n   in the caller's task, never as a host value carried between tasks.\n   `export-program` answers the donor's export alone as the program's value.\n\n   Every program runs linked on the three vector VMs (`semantic`, `stack`,\n   `register`) over the TypeScript linked harness's content store, where\n   `yang.call` and `js` already live and `php`, `py` and `clj` are\n   published beside them. The AST walker is not a backend: its links are\n   refused until L-b.\"\n  (:require\n    [clojure.string :as str]\n    [yang.clojure :as clj-comp]\n    [yang.clojure.prelude :as clj-prelude]\n    [yang.core.module :as core-module]\n    [yang.core.names :as names]\n    [yang.core.uast :as u]\n    [yang.php.antlr.cst :as php-cst]\n    [yang.php.antlr.lower :as php-lower]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.prelude :as php-prelude]\n    [yang.python.antlr.lower :as py-lower]\n    [yang.python.antlr.parser :as py-parser]\n    [yang.python.antlr.prelude :as py-prelude]\n    [yang.python.antlr.render :as py-render]\n    [yang.typescript.antlr.cst :as ts-cst]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as ts-lower]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]))\n\n\n(def ^:private published-php\n  \"`php` published once into `js`'s content store, pinning the same\n   `yang.call` revision (as `source-call-test` publishes it).\"\n  (delay (h/publish-guest-module!\n           (php-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(def ^:private published-py\n  \"`py` published beside `js` and `php`, over the same host registry and\n   `yang.call` revision.\"\n  (delay (h/publish-guest-module!\n           (py-prelude/module-spec (h/registry)\n                                   (:call-address @h/published)))))\n\n\n(def ^:private published-clj\n  \"`clj` published beside `js`, `php` and `py`, over the same host registry\n   and `yang.call` revision.\"\n  (delay (h/publish-guest-module!\n           (clj-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(defn- parse-ok\n  \"The CST packet of `source` under `parse`, refused unless the parse is ok.\"\n  [parse source]\n  (let [pk (parse source)]\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\n      (throw (ex-info \"donor or caller source does not parse\"\n                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\n    pk))\n\n\n(defn- python-export-symbol\n  [export]\n  (symbol (str \"xlang.python.export.\" export)))\n\n\n(defn- python-unit\n  [packet exports]\n  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\n         (u/seq-nodes\n           (concat (map (fn [export]\n                          (u/sexp->uast\n                            (list 'py/global-set py-lower/globals-sym\n                                  {:py/str export} (python-export-symbol export))))\n                        exports)\n                   [(py-lower/lower-module-body packet)]))))\n\n\n(def frontends\n  \"Each admitted frontend's profile, as data:\n\n   - `:runtime`, `:address`: the runtime module and its published address;\n   - `:refusal`: the publication refusal key and reason of its modules;\n   - `:deps` (optional): pinned requirements beyond the runtime its\n     lowered units read directly (the clojure unit's `yang.call` reads);\n   - `:parse`: source text to CST packet;\n   - `:unit`: packet and projected exports to the lowered unit its\n     `:run-main` entry takes;\n   - `:read-export`: export name to the form reading the runtime's global\n     namespace (JS `globalThis`, PHP's named-function table, Python's main\n     module dictionary, the clojure runtime's task-local namespace cell);\n   - `:project`: name and a value form to the form binding the value where\n     the runtime's source resolves a called name;\n   - `:render`: the `:run-main` value as test data.\"\n  {:typescript\n   {:runtime 'js,\n    :address #(:address @h/published),\n    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\n    :parse #(parse-ok ts-cst/parse-source %),\n    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\n    :run-main 'js/run-main,\n    :read-export (fn [export] (list 'js/global-get {:js/str export})),\n    :project (fn [name value] (list 'js/define-global! name value)),\n    :render render/output},\n   :php\n   {:runtime 'php,\n    :address #(:address @published-php),\n    :refusal [:yang.php/refusal :yang.php/undeclared-free],\n    :parse #(parse-ok php-cst/parse-source %),\n    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\n    :run-main 'php/run-main,\n    :read-export (fn [export]\n                   (list 'php/resolve-fn (str/lower-case export) export)),\n    :project (fn [name value]\n               (list 'php/declare-function! (str/lower-case name) value)),\n    :render php-h/render},\n   :python\n   {:runtime 'py,\n    :address #(:address @published-py),\n    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\n    :parse #(parse-ok py-parser/parse-source %),\n    :unit python-unit,\n    :run-main 'py/run-main,\n    :read-export (fn [export]\n                   (list 'py/global-get\n                         (list 'py/module-dict\n                               (list 'py/modules-ref {:py/str \"__main__\"}))\n                         {:py/str export})),\n    :project (fn [name value]\n               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\n    :render py-render/output},\n   :clojure\n   {:runtime 'clj,\n    :address #(:address @published-clj),\n    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\n    :deps (fn [] {'yang.call (:call-address @h/published)}),\n    :parse clj-comp/read-forms,\n    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\n    :run-main 'clj/run-main,\n    :read-export (fn [export] (list 'clj/global-get export)),\n    :project (fn [name value]\n               ;; The runtime global namespace is the one binding (as\n               ;; `js/define-global!` is for a JS caller): `lower-unit`\n               ;; reads each projected name through `clj/global-get`, so\n               ;; no task-store binding duplicates it. A caller top-level\n               ;; definition of the same name publishes after the\n               ;; projection and shadows it.\n               (list 'clj/define-global! name value)),\n    :render clj-comp/output}})\n\n\n(defn- profile\n  [frontend]\n  (or (get frontends frontend)\n      (throw (ex-info \"frontend not admitted\" {:frontend frontend}))))\n\n\n(defn- modules\n  \"The host registry, admitted by every runtime profile that checks it,\n   with the clojure guest library's host surface installed beside them.\n   Donor publication declares free names over this same registry, so a\n   clojure donor using the guest library (its `kind` and `portable`\n   hosts) publishes like it runs.\"\n  []\n  (clj-prelude/admit (php-prelude/admit (h/registry))))\n\n\n(defn publish-donor!\n  \"Publish the donor `source` of `frontend` as the module `module` (default\n   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\n   Answers `{:frontend :module :address :links}`.\"\n  ([frontend source]\n   (publish-donor! frontend source (symbol (str \"xlang.donor.\" (name frontend)))))\n  ([frontend source module]\n   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\n         [refusal-key reason] refusal\n         spec (core-module/module-spec\n                refusal-key reason (modules)\n                {:name module,\n                 :ast (core-module/module-tree\n                        [(core-module/require-node runtime)\n                         (u/def! 'body (unit (parse source) []))]),\n                 :exports '#{body},\n                 :runtime-name runtime,\n                 :runtime-address (address),\n                 :deps (if deps (deps) {})})\n         result (h/publish-guest-module! spec)]\n     {:frontend frontend,\n      :module module,\n      :address (:address result),\n      :links (:links result)})))\n\n\n(defn- runtime-entry\n  \"Require and initialize each distinct runtime of `frontend-keys`, once.\"\n  [frontend-keys]\n  (into [(core-module/require-node 'yang.call)]\n        (mapcat (fn [runtime]\n#### 8.10.11 Acceptance gates\n\nExecute real lowered source bodies, not only synthetic functions with\nthe expected slot. A harness may compose published exports and namespace\nprojections explicitly. It must not rewrite call nodes, extract foreign\n`:code`, or insert test-local language-pair wrappers to make calls work.\n\nRequired evidence:\n\n- **Local semantics:** existing suites preserve argument order, defaults,\n  required/extra arguments, keyword errors, receivers, exceptions, and\n  supported reference/static behavior.\n- **Direct calls:** each implemented frontend calls every other\n  conforming frontend through the same mechanism in both directions\n  with compatible values. Derive the test matrix from admitted\n  frontends; do not hard-code it into runtime dispatch.\n- **Higher-order calls:** pass, return, store, recurse, and call back\n  through received functions. Assert identity and captures without\n  replacement cells.\n- **Callable admission:** source data with an entry-spelled property\n  remains data; profile-constructed descriptors are admitted. Exercise\n  supported PHP string/array designators both under local resolution and\n  explicit callable export, preserving required late lookup without\n  foreign namespace guessing.\n- **Presence and binding:** distinguish missing from explicit\n  null/None/undefined; retain duplicate keywords until binding; supply\n  bound self once; evaluate receiver/spreads/defaults at source-defined\n  times and counts.\n- **Dynamic callability:** where supported, an existing instance becomes\n  eligible after its class gains a call method and ineligible after\n  deletion. Calls whose arguments change this metadata observe the\n  correct source-required lookup time without instance rewrapping.\n- **Opaque values:** round-trip foreign objects, functions, strings,\n  float64 content, and exact integers unchanged. Assert aliasing and no\n  silent rounding/null conversion. Unsupported operations yield\n  documented guest errors.\n- **References:** absent/incompatible writable-location profiles fail\n  before reference acquisition and the body, with no reference-induced\n  writeback. Source-required side effects from evaluating arguments still\n  occur; rejection must not erase them. Compatible profiles prove\n  mutation, aliasing, cleanup, and suspension behavior.\n- **Exceptions:** cover binding failures, arbitrary foreign thrown data,\n  catch-all/typed catches, unchanged rethrow, replacement in `finally`,\n  protocol-error rethrow, condition-shaped thrown maps, and A-to-B-to-A\n  propagation. Assert original exception identity and cleanup order,\n  not only rendered text. Store/return a generated `ForeignException`,\n  finish its creating activation, then rethrow it from another activation\n  and assert recovery of the original condition and payload identity.\n- **Context lifetime:** repeated success/raise/success, cross-runtime\n  recursion, and stream suspension/resume restore handler/depth/frame\n  state and perform arguments/cleanup exactly once. Entry boilerplate\n  must not double-count source recursion or tracing activations.\n- **Publication/custody:** bundled/linked forms agree; two importing\n  tasks have independent state. Existing gates still refuse foreign-task\n  cells, forged refs, host functions, and inadmissible continuations.\n- **Portability:** execute portable packet-to-UAST fixtures on JVM,\n  Node, and Dart over the four VMs wherever existing contracts admit\n  the program. JVM-only parsers may supply checked-in CST fixtures;\n  parser availability is distinct from calling conformance.\n\nReport callable kinds, binding/value extensions, actual host/VM\ncoverage as an explicit host-by-VM matrix, refusals, and remaining gaps\nper frontend revision. A scalar example or common UAST grammar alone\ndoes not establish conformance.\n\n#### 8.10.12 Cell-reference call routing and authenticity\n\nRuling of record (2026-11-04, owner-approved). A cross-language\nreference is a cell-ref map the VM issues (`{:type :cell-ref :id\n:cell-N :seal s}`). In Clojure a map is callable, so the call lowering\nmust route a callee between reference semantics and data semantics.\nThree rounds routed by value shape at call time (key presence,\nexact shape, minted-id language) and each left the same defect class:\ninnocent data whose shape imitates the reference language aborted at\n`cell/get` instead of answering as data. The defect is structural — a\ngenuine reference and a perfect imitation are field-identical maps,\nand the distinguishing fact (did the heap issue this?) is not in the\nvalue. It is in the heap. Only the issuer can answer.\n\n- **Vocabulary.** The `cell` host module's published effect vocabulary\n(ns yang.python.antlr.call-entry-test\n  \"Python function binder fixtures and source-call helper coverage for the\n   shared call runtime. The binder fixtures prove the record/constructor\n   contract only; they are not conformance evidence under docs/design/yang.antlr.md §8.10.11.\"\n  (:require [clojure.test :refer [deftest is]]\n            [yang.python.antlr.int-ops-test :as ops]\n            [yang.python.antlr.prelude :as prelude]))\n\n\n(def ^:private bindings\n  '[raise-exit (fn [condition] condition)\n    record (fn [f positional named]\n             (assoc (assoc (assoc (assoc {} :yang.call/callee f)\n                                  :yang.call/positional positional)\n                           :yang.call/named named)\n                    :yang.call/raise raise-exit))\n    invoke (fn [f positional named]\n             ((get (cell/get f) :yang.call/entry) (record f positional named)))\n    positional (py/make-function \"positional\" {:params [\"x\"]} [] []\n                                 (fn [args] (get args 0)))\n    named (py/make-function \"named\" {:params [\"x\" \"y\"]} [] []\n                            (fn [args] (get args 1)))\n    defaulted (py/make-function \"defaulted\" {:params [\"x\"]} [7] []\n                                (fn [args] (get args 0)))\n    variadic (py/make-function \"variadic\" {:params [\"x\"] :star? true} [] []\n                               (fn [args] (get (get args 1) :items)))\n    duplicate (py/make-function \"duplicate\" {:params [\"x\"]} [] []\n                                (fn [args] (get args 0)))\n    substituted (py/make-function \"substituted\" {:params [\"x\"]} [] []\n                                  (fn [args] (get args 0)))\n    receiver-fn (py/make-function \"receiver\" {:params [\"x\"]} [] []\n                                  (fn [args] (get args 0)))\n    profile-fn (py/make-function \"profile\" {:params [\"x\"]} [] []\n                                 (fn [args] (get args 0)))\n    caught (fn [thunk]\n             (py/try thunk\n                     (fn [e] (get (cell/get (get (cell/get e) :class)) :name))\n                     (fn [] :py/None)))])\n\n\n(def ^:private result-expressions\n  '[(if (get (cell/get positional) :yang.call/entry) true false)\n    (if (get (cell/get py.b/len) :yang.call/entry) true false)\n    (if (get (cell/get py.b/TypeError) :yang.call/entry) true false)\n    (let [absent (record positional [] [])\n          supplied (assoc (record positional [] []) :yang.call/receiver :py/None)]\n      (py/vconj (py/vconj [] (get absent :yang.call/receiver :py/missing))\n                (get supplied :yang.call/receiver :py/missing)))\n    (invoke positional [4] [])\n    (invoke named [1] [[\"y\" 9]])\n    (invoke defaulted [] [])\n    (invoke defaulted [:py/None] [])\n    (invoke variadic [1 2 3] [])\n    (let [r (invoke duplicate [1] [[\"x\" 2]])\n          e (get r :yang.call/value)]\n      (py/vconj (py/vconj [] (get r :yang.call/reason))\n                (get (cell/get (get (cell/get e) :class)) :name)))\n    (get ((get (cell/get positional) :yang.call/entry)\n          (record substituted [5] []))\n         :yang.call/reason)\n    (invoke receiver-fn [11] [])\n    ((get (cell/get receiver-fn) :yang.call/entry)\n     (assoc (record receiver-fn [12] []) :yang.call/receiver :py/None))\n    (get ((get (cell/get profile-fn) :yang.call/entry)\n          (assoc (record profile-fn [3] []) :yang.call/binding-profile :py/None))\n         :yang.call/reason)])\n\n\n(def ^:private fixtures\n  (list 'let bindings\n        (reduce (fn [acc expression] (list 'py/vconj acc expression))\n                []\n                result-expressions)))\n\n\n(deftest python-function-entry-record-contract-test\n  (let [expected [true false false [:py/missing :py/None]\n                  4 9 7 :py/None [2 3]\n                  [:yang.call/thrown \"TypeError\"]\n                  :yang.call/invalid-invocation\n                  11 12 :yang.call/unsupported-binding]]\n    (doseq [[backend result] (ops/run-with-prelude prelude/uast fixtures)]\n      (is (= expected result) (str backend)))))\n\n\n(def ^:private fixture\n  '(let [python-fn (py/make-function \"python\" {:params [\"x\" \"y\"]} [7] []\n                                     (fn [args] (get args 1)))\n         foreign-fn (assoc {}\n                           :yang.call/entry\n                           (fn [invocation]\n                             (get (get invocation :yang.call/positional) 0)))\n         call-python (py/call-kw python-fn [1] [])\n         call-named (py/call-kw python-fn [1] [[\"y\" 9]])\n         call-foreign (py/call foreign-fn [42])\n         not-callable (py/try (fn [] (py/call-kw {} [] []))\n                              (fn [e] (get (cell/get (get (cell/get e) :class)) :name))\n                              (fn [] :py/None))]\n     (py/vconj (py/vconj (py/vconj [] call-python) call-named)\n               (py/vconj (py/vconj [] call-foreign) not-callable))))\n\n\n(deftest python-source-calls-use-shared-entry-test\n  (doseq [[backend result] (ops/run-with-prelude prelude/uast fixture)]\n    (is (= [7 9 [42 \"TypeError\"]] result) (str backend))))\n\n\n(deftest python-cross-frontend-callable-identity-test\n  (let [fixture\n        '(let [php-function\n               (cell/new\n                 (assoc {:php/type :function}\n                        :yang.call/entry\n                        (fn [invocation]\n                          (get invocation :yang.call/callee))))\n               returned (py/call-kw php-function [] [])]\n           (if (= php-function returned) :same :different))]\n    (doseq [[backend result] (ops/run-with-prelude prelude/uast fixture)]\n      (is (= :same result) (str backend)))))\n(ns yang.python.antlr.linked-harness\n  \"The linked profile's composition for the Python tests (C4 slices P2\n   and P3, docs/design/yang.antlr.md 8.5.6): the namespace that requires\n   this is the publisher of `py` and `pysp`, so it publishes each module\n   once per process into one in-memory content store and serves them to\n   every linked run over a `yin.vm.linker.interpreter` composition under\n   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n   evidence is `publish-module!`'s own `link-local` links, which\n   `linked-prelude-test` asserts.\n\n   A linked run builds the program's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately\n   until the VM stops blocking, as the REPL's drive does. The AST walker\n   is not a backend here: its link of `py` is refused `:undeclared-free`\n   until L-b.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [dao.jing.mem :as mem]\n            [yang.core.call :as call]\n            [yang.python.antlr.prelude :as prelude]\n            [yang.python.antlr.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The ordinary Python composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked Python composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `pysp` polls a signal stream, so the\n   safepointed composition needs it even though `py` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`yang.call` and `py` published once into their own content store.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store, :result result, :address (:address result),\n       :call-result call-result, :call-address (:address call-result)})))\n\n\n(def published-pysp\n  \"`pysp` published once into `py`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{py <address> yang.call <address>}`, derivation `:trusted`, the test being the\n   publisher. Explicit name environments also receive the harness's\n   `yang.call` runtime module, which every linked Python body requires.\n   `pysp`-serving sources pass their own `name-env`, the\n   safepointed runs' `{'py a :pysp b}` both.\"\n  ([] (source {'py (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env (merge {'yang.call (:call-address @published)}\n                                       name-env),\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition for `pysp`, `py`, and the `yang.call` module\n   required by `py`.\"\n  []\n  (source {'py (:address @published), 'pysp (:address @published-pysp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `py`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. The test helper supplies the harness's\n   `yang.call` address as the runtime dependency when a test constructs a\n   spec directly. Guest modules are tiny beside `py`, so a test may publish\n   its own; publish imports bottom-up, the `deps` map naming each import's\n   address.\"\n  [spec]\n  (publish/publish-module! (:store @published)\n                           (update spec :requires\n                                   #(assoc (or % {}) 'yang.call\n                                           (:call-address @published)))))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n                 (assoc attached\n                        :pc pc :frames [] :continuation []\n                        :registers (vec (repeat (:registers body) nil))\n                        :halted? false :blocked? false :value nil)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task\n   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n","exit_code":0,"status":"completed"}}
