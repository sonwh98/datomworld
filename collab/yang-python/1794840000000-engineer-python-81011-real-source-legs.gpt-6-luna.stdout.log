{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/yang/python/antlr/source_call_test.cljc'","aggregated_output":"     1\t(ns yang.python.antlr.source-call-test\n     2\t  \"S11's first real-source conformance legs for Python (§8.10.11).\n     3\t   Each side is parsed and lowered by its frontend profile. The shared\n     4\t   conformance composition publishes exports and projects them by name.\"\n     5\t  (:require [clojure.test :refer [deftest is testing]]\n     6\t            [yang.call.conformance :as conformance]))\n     7\t\n     8\t\n     9\t(deftest python-donor-to-typescript-source-test\n    10\t  (testing \"a Python module export is called by unmodified TypeScript source\"\n    11\t    (is (= \"5\\n\"\n    12\t           (conformance/call\n    13\t             [:python \"def add(x, y):\\n    return x + y\\n\"]\n    14\t             [\"add\"]\n    15\t             [:typescript \"console.log(add(2, 3));\"]))))))\n    16\t\n    17\t\n    18\t(deftest typescript-donor-to-python-source-test\n    19\t  (testing \"a TypeScript module export is called by unmodified Python source\"\n    20\t    (is (= \"5\\n\"\n    21\t           (conformance/call\n    22\t             [:typescript \"function add(x, y) { return x + y; }\"]\n    23\t             [\"add\"]\n    24\t             [:python \"print(add(2, 3))\\n\"]))))))\n    25\t\n    26\t\n    27\t(deftest typescript-callback-through-python-source-test\n    28\t  (testing \"Python receives and calls the captured foreign function unchanged\"\n    29\t    (is (= \"True 7\\n\"\n    30\t           (conformance/call\n    31\t             [:typescript \"const captured = 4; function plus(x) { return x + captured; }\"]\n    32\t             [\"plus\"]\n    33\t             [:python \"def invoke(f):\\n    return (f is f, f(3))\\nprint(invoke(plus))\\n\"]))))))\n    34\t\n    35\t\n    36\t(deftest typescript-opaque-values-through-python-source-test\n    37\t  (testing \"Python returns foreign values unchanged through its source body\"\n    38\t    (is (= \"True True True True True\\n\"\n    39\t           (conformance/call\n    40\t             [:typescript (str \"const opaque = {answer: 42};\\n\"\n    41\t                               \"function foreign(x) { return x; }\\n\"\n    42\t                               \"const foreignText = 'unchanged';\\n\"\n    43\t                               \"const foreignFloat = 1.25;\\n\"\n    44\t                               \"const foreignInteger = 9007199254740993123456789n;\")]\n    45\t             [\"opaque\" \"foreign\" \"foreignText\" \"foreignFloat\" \"foreignInteger\"]\n    46\t             [:python (str \"def echo(value):\\n    return value\\n\"\n    47\t                           \"print(echo(opaque) is opaque, echo(foreign) is foreign, \"\n    48\t                           \"echo(foreignText) == foreignText, \"\n    49\t                           \"echo(foreignFloat) == foreignFloat, \"\n    50\t                           \"echo(foreignInteger) == foreignInteger)\\n\")]))))))\n","exit_code":0,"status":"completed"}}
