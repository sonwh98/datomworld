+;; =============================================================================
+;; The linked profile's admission through the shell (every host)
+;; =============================================================================
+
+(defn- temp-dir
+  []
+  (str "target/test-python-admission-" (random-uuid)))
+
+
+(defn- cleanup-dir!
+  [dir]
+  #?(:cljd (try (.deleteSync (dart-io/Directory. dir) .recursive true)
+                (catch Object _ nil))
+     :clj (let [f (java.io.File. dir)]
+            (when (.isDirectory f)
+              (doseq [child (.listFiles f)]
+                (.delete child))
+              (.delete f)))
+     :cljs (try (.rmSync (js/require "fs") dir #js {:recursive true,
+                                                    :force true})
+                (catch :default _ nil))))
+
+
+(defn- dht-shell
+  "A shell over a solo DHT store at `dir`, its own key `key`, declaring
+   the public keys `principals`, on the precompiled catalog."
+  [dir key principals]
+  (frontends/create-state
+    {:frontends (cst-catalog),
+     :index-store-spec {:type :dht,
+                        :dir dir,
+                        :peers [],
+                        :publish? false,
+                        :bind-host "127.0.0.1",
+                        :bind-port 0,
+                        :max-inbound-bytes repl.dht/default-max-inbound-bytes,
+                        :manifest nil,
+                        :bind! (mesh/seam (mesh/mesh) 4)},
+     :dht-key key,
+     :principals principals}))
+
+
+(defn- loaded
+  "Step the shell's node until index `m` has loaded, at most 2000
+   readings."
+  [state m]
+  (loop [state state
+         now 0]
+    (if (or (= :loaded (:status (space.dht/load-status (:dht state) m)))
+            (> now 20000))
+      state
+      (recur (first (repl.dht/step state now)) (+ now 10)))))
+
+
+(defn- link-responses
+  [state]
+  (mapv #(dissoc % :yin.link/id)
+        (mesh/values (get-in state [:link-pair :responses]))))
+
+
+(deftest a-linked-import-only-another-principal-asserts-is-refused-test
+  (let [dir (temp-dir)
+        a (sign/generate)
+        b (sign/generate)
+        e (jing/segment-key "pym.e: a manifest no node holds")]
+    (try
+      (let [state (dht-shell dir a [(:public b)])
+            signed (publish/assertion b {:name 'pym.e, :manifest e, :seq 1})
+            m (dht-test/publish-datoms!
+                (:dht state)
+                [{:db/id datom/first-user-id,
+                  :yin.module/envelope (:envelope signed),
+                  :yin.module/proof (:proof signed)}])
+            [state _] (repl/eval-input state "(require (quote dao.space.dht))")
+            [state _] (repl/eval-input state
+                                       (str "(dao.space.dht/load-index " m ")"))
+            state (loaded state m)
+            _ (is (= :loaded (:status (space.dht/load-status (:dht state) m))))
+            [state switched] (repl/eval-input state
+                                              "(lang :yang.python/cst-linked)")
+            [state text] (repl/eval-input state x-source)
+            refusal (peek (link-responses state))]
+        (is (= :yang.python/cst-linked (:lang state)) switched)
+        (testing "only B, a declared principal but not the session's own,
+                  asserts pym.e: the linked Python import is refused by
+                  the frontend's admission, before anything of it runs"
+          (is (= {:status :refused,
+                  :reason :yang.python.antlr/foreign-principal,
+                  :name 'pym.e,
+                  :asserters [(sign/principal (:public b))],
+                  :requires :L-e}
+                 refusal)
+              text)
+          (is (str/includes? text "foreign-principal") text)
+          (is (nil? (:pending-run state)))
+          (is (not (str/includes? text "caught-e")) text))
+        (testing "a Clojure program of the same shell, after (lang ...), is
+                  served without it: its require of pym.e starts the
+                  closure load and parks"
+          (let [[state _] (repl/eval-input state "(lang :clojure)")
+                [state text] (repl/eval-input state "(require (quote pym.e))")]
+            (is (some? (:pending-run state)) text)
+            (is (= refusal (peek (link-responses state)))
+                "no response, and so no refusal, was added")
+            (store/close! (:index-store (first (repl/eval-input
+                                                 state "(abandon)")))))))
+      (finally
+        (cleanup-dir! dir)))))
+
+
