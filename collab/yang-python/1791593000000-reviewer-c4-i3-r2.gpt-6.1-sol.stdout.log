   130	(defn principal-admission
   131	  "The admission a Python link source applies to each name it resolves
   132	   (`yin.repl.link/composition`'s `:admit`), until L-e: a name resolved
   133	   from signed assertions is admitted when one of the importer's own
   134	   principals, the public keys `publics` (64 lowercase hex), asserts it
   135	   -- it vouches for that very manifest address -- and a direct entry,
   136	   the composition's own, always. Any other is refused
   137	   `:yang.python.antlr/foreign-principal` with the `:name`, its
   138	   `:asserters`, and `:requires` `:L-e`, before anything of it links."
   139	  [publics]
   140	  (let [own (set (map sign/principal publics))]
   141	    (fn [name entry]
   142	      (let [provenance (:yin.link/provenance entry)
   143	            asserters (:yin.module/asserted-by provenance)]
   144	        (when-not (or (= :composition provenance) (some own asserters))
   145	          (refused :yang.python.antlr/foreign-principal
   146	                   {:name name,
   147	                    :asserters (vec asserters),
   148	                    :requires :L-e}))))))
