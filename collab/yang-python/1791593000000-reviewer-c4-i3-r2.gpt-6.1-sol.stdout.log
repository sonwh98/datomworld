    96	(defn publish-units!
    97	  "Publish `units` (`[{:name :package? :packet}]`) into the content store
    98	   `handle` over the host registry `registry`, `py` pinned at
    99	   `py-address` and each import outside the set at its address in
   100	   `published` ({python-name address}), in `publication-order`. Answers
   101	   `{:status :ok :addresses {python-name address}}` for the units of the
   102	   set, or the first refusal -- `publication-order`'s before anything is
   103	   written, else `publish-module!`'s with the unit's `:unit` name."
   104	  ([handle registry py-address units]
   105	   (publish-units! handle registry py-address units {}))
   106	  ([handle registry py-address units published]
   107	   (let [plan (publication-order units published)
   108	         by-name (into {} (map (juxt :name identity)) units)]
   109	     (if (= :refused (:status plan))
   110	       plan
   111	       (reduce
   112	         (fn [acc n]
   113	           (let [{:keys [packet package?]} (get by-name n)
   114	                 known (merge published (:addresses acc))
   115	                 deps (select-keys known (unit-imports (get by-name n)))
   116	                 res (publish/publish-module!
   117	                       handle
   118	                       (lower/module-spec registry packet
   119	                                          {:name n,
   120	                                           :package? package?,
   121	                                           :py-address py-address,
   122	                                           :deps deps}))]
   123	             (if (= :refused (:status res))
   124	               (reduced (assoc res :unit n))
   125	               (assoc-in acc [:addresses n] (:address res)))))
   126	         {:status :ok, :addresses {}}
   127	         (:order plan))))))
