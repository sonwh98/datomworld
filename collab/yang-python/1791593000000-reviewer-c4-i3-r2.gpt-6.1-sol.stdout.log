   235	;; =============================================================================
   236	;; A run over the DHT link source
   237	;; =============================================================================
   238	
   239	(defn- py-output
   240	  "The lines the Python runtime of `task` has printed, read off its
   241	   `py.rt/out` cell in py's module store: none when py has not run
   242	   `py/init!`, so no Python statement can have printed."
   243	  [task]
   244	  (let [ref (some #(get % 'py.rt/out) (vals (:module-stores task)))]
   245	    (mapv render/line (when ref (get-in task [:heap (:id ref) :value])))))
   246	
   247	
   248	(defn- guest-installs
   249	  "The guest modules `task` has started an install child for: the
   250	   `pym.*` names it has linked or is installing, as strings (a name
   251	   compares by its text whatever symbol value a kernel's registry
   252	   holds)."
   253	  [task]
   254	  (into (sorted-set)
   255	        (comp (map str)
   256	              (filter #(= "pym." (subs % 0 (min 4 (count %))))))
   257	        (concat (map first (module/module-entries (:modules task)))
   258	                (keys (:installs task)))))
   259	
   260	
   261	(defn- observed
   262	  "What `task` shows independently of its value: the lines it printed,
   263	   the guest modules it installed, and how many install children it ever
   264	   started (its origin counter, `py`'s included)."
   265	  [task]
   266	  {:output (py-output task),
   267	   :guests (guest-installs task),
   268	   :children (or (:origins task) 0)})
   269	
   270	
   271	(defn- run-over-dht
   272	  "The linked program of packet `pk` on `backend`, its link pair served
   273	   by the DHT source `src` from the world's reader, the world stepped
   274	   between rounds: `[w outcome last-response observation]`, the outcome
   275	   `[halted? blocked? output]` or `[:thrown message]`. The observation
   276	   is `observed` of the task the program ended as -- for a thrown run,
   277	   of the task the throwing run resumed, which holds every step before
   278	   the raise: a refused link raises at its resume, before anything
   279	   else runs."
   280	  [w backend pk src]
   281	  (let [pair (link/make-pair)
   282	        task ((get h/backends backend)
   283	              (lower/lower-packet pk {:prelude :linked})
   284	              (h/composition (h/registry) pair))
   285	        limit (+ (:now w) 1200000)
   286	        run (fn [task]
   287	              (try (vm/run task)
   288	                   (catch #?(:cljd Object :clj Exception :cljs :default) e
   289	                     {::thrown (ex-message e), ::resumed task})))]
   290	    (loop [w w
   291	           task (run task)
   292	           pair pair]
   293	      (let [response (dissoc (peek (mesh/values (:responses pair)))
   294	                             :yin.link/id :image)]
   295	        (cond
   296	          (::thrown task)
   297	          [w [:thrown (::thrown task)] response (observed (::resumed task))]
   298	
   299	          (and (vm/blocked? task) (< (:now w) limit))
   300	          (let [{:keys [pair dht]} (link/serve {:pair pair,
   301	                                                :source src,
   302	                                                :dht (:reader w)})
   303	                w (step-world (assoc w :reader dht))]
   304	            (recur w (run task) pair))
   305	
   306	          :else
   307	          [w
   308	           [(vm/halted? task) (vm/blocked? task)
   309	            (render/output (vm/value task))]
   310	           response
   311	           (observed task)])))))
   312	
   313	
   314	(defn- source
   315	  "The reader's DHT link source declaring the public keys `publics`, its
   316	   Python admission naming `own`."
   317	  [publics own]
   318	  (link/composition {:dht? true,
   319	                     :principals publics,
   320	                     :admit (publication/principal-admission own)}))
   321	
   322	
   323	(defn- on-every-vm
   324	  "Thread `w` through `run-over-dht` on every vector backend: `[w {backend
   325	   [outcome last-response observation]}]`."
   326	  [w pk src]
   327	  (reduce (fn [[w acc] k]
   328	            (let [[w outcome response seen] (run-over-dht w k pk src)]
   329	              [w (assoc acc k [outcome response seen])]))
   330	          [w {}]
   331	          (keys h/backends)))
