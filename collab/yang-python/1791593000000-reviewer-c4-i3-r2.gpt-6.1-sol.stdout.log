    38	(defn- rotate-least
    39	  "The cycle `names` rotated to start at its least name, so one cycle has
    40	   one diagnostic whatever unit the search entered it by."
    41	  [names]
    42	  (let [least (first (sort names))
    43	        i (first (keep-indexed (fn [i n] (when (= least n) i)) names))]
    44	    (vec (concat (drop i names) (take i names)))))
