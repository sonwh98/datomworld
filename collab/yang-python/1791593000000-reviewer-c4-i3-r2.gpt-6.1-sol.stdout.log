   139	;; =============================================================================
   140	;; The mesh world: a publisher, two plain peers, a reader
   141	;; =============================================================================
   142	
   143	(def ^:private big
   144	  "Every node's inbound bound: py's closure is replicated whole."
   145	  (* 512 1024 1024))
   146	
   147	
   148	(defn- peer-node
   149	  [net port]
   150	  (let [c (mesh/join! net port {::jing.dht/publish? true
   151	                                ::jing.dht/max-inbound-bytes big})]
   152	    {:composition c, :state (jing.dht/state c)}))
   153	
   154	
   155	(defn- node-at
   156	  "A node at mesh `port` whose local store already holds `seed`
   157	   ({address bytes}): content it has, not content it publishes."
   158	  [net port peer-ports publish? seed]
   159	  (dht/join {:local (mem/create-content-mem seed),
   160	             :publish? publish?,
   161	             :peers (mapv (fn [p] {:host mesh/host, :port p}) peer-ports),
   162	             :bind! (mesh/seam net port),
   163	             :max-inbound-bytes big}))
   164	
   165	
   166	(defn- step-world
   167	  "One reading: the publisher, the reader when there is one, then every
   168	   plain peer."
   169	  [w]
   170	  (let [now (:now w)
   171	        [pub pub-events] (dht/step (:pub w) now)
   172	        [reader] (when (:reader w) (dht/step (:reader w) now))]
   173	    (-> w
   174	        (assoc :pub pub
   175	               :reader reader
   176	               :peers (into {}
   177	                            (map (fn [[port {:keys [composition state]}]]
   178	                                   (mesh/tick! composition now)
   179	                                   [port {:composition composition,
   180	                                          :state (jing.dht/step state 256)}]))
   181	                            (:peers w))
   182	               :now (+ now 10))
   183	        (update :events into pub-events))))
   184	
   185	
   186	(defn- run-world
   187	  "Step `w` until `(done? w)`; `:failure` names `cause` when `span` more
   188	   readings pass first."
   189	  [w span cause done?]
   190	  (let [limit (+ (:now w) span)]
   191	    (loop [w w]
   192	      (cond
   193	        (done? w) w
   194	        (> (:now w) limit) (assoc w :failure cause)
   195	        :else (recur (step-world w))))))
   196	
   197	
   198	(defn- published?
   199	  [manifest]
   200	  (fn [w]
   201	    (some #(and (= :published (::dht/event %)) (= manifest (:manifest %)))
   202	          (:events w))))
   203	
   204	
   205	(defn- index!
   206	  "Publish the signed envelopes `signed` (`{:envelope :proof}`) as one
   207	   index transaction through `node` and announce it: its manifest."
   208	  [node signed]
   209	  (dht-test/publish-datoms!
   210	    node
   211	    (vec (map-indexed (fn [i s]
   212	                        {:db/id (+ datom/first-user-id i),
   213	                         :yin.module/envelope (:envelope s),
   214	                         :yin.module/proof (:proof s)})
   215	                      signed))))
   216	
   217	
   218	(defn- publish-index
   219	  "Publish `signed` as an index through the publisher, run until it is
   220	   reported, and load it onto the reader: `[w manifest]`."
   221	  [w signed]
   222	  (let [m (index! (:pub w) signed)
   223	        w (run-world w 600000 (str "the index " m " was not reported")
   224	                     (published? m))
   225	        _ (is (nil? (:failure w)) (:failure w))
   226	        w (run-world (update w :reader dht/load-index m)
   227	                     600000 (str "the index " m " did not load")
   228	                     #(contains? #{:loaded :failed}
   229	                                 (:status (dht/load-status (:reader %) m))))]
   230	    (is (nil? (:failure w)) (:failure w))
   231	    (is (= :loaded (:status (dht/load-status (:reader w) m))))
   232	    [w m]))
