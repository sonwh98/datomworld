   106	(defn create-state
   107	  "`yin.repl/create-state` composed with the standard catalog unless the
   108	   host supplies its own `:frontends`."
   109	  ([] (create-state {}))
   110	  ([opts]
   111	   (repl/create-state
   112	     (-> opts
   113	         (update :frontends #(or % (standard)))
   114	         (update :primitives #(merge python.antlr.repl/primitives %))))))
