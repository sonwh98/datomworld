    47	(defn publication-order
    48	  "The names of `units` (`[{:name :package? :packet}]`) in an order that
    49	   publishes every unit after the units of the set it imports, input order
    50	   otherwise; an import outside the set must be in `published`
    51	   ({python-name address}). Answers `{:status :ok :order [...]}`, or a
    52	   refusal: `:yang.python.antlr/import-cycle` with the `:cycle`'s names,
    53	   least first, in import order; `:yang.python.antlr/unpublished-import`
    54	   naming the `:module` no unit and no publication supplies and the unit
    55	   `:imported-by`."
    56	  [units published]
    57	  (let [by-name (into {} (map (juxt :name identity)) units)
    58	        imports (into {} (map (juxt :name unit-imports)) units)
    59	        missing (some (fn [u]
    60	                        (some (fn [m]
    61	                                (when-not (or (contains? by-name m)
    62	                                              (contains? published m))
    63	                                  {:module m, :imported-by (:name u)}))
    64	                              (get imports (:name u))))
    65	                      units)]
    66	    (if missing
    67	      (refused :yang.python.antlr/unpublished-import missing)
    68	      ;; depth first; `path` is the chain being visited, so meeting a name
    69	      ;; on it closes a cycle
    70	      (letfn [(visit
    71	                [acc path n]
    72	                (cond
    73	                  (:cycle acc) acc
    74	                  (some #{n} path) (assoc acc
    75	                                          :cycle
    76	                                          (rotate-least
    77	                                            (drop-while #(not= n %) path)))
    78	                  (contains? (:done acc) n) acc
    79	                  (not (contains? by-name n)) acc
    80	                  :else (let [a (reduce #(visit %1 (conj path n) %2)
    81	                                        acc
    82	                                        (get imports n))]
    83	                          (if (:cycle a)
    84	                            a
    85	                            (-> a
    86	                                (update :done conj n)
    87	                                (update :order conj n))))))]
    88	        (let [r (reduce #(visit %1 [] %2)
    89	                        {:done #{}, :order []}
    90	                        (map :name units))]
    91	          (if (:cycle r)
    92	            (refused :yang.python.antlr/import-cycle {:cycle (:cycle r)})
    93	            {:status :ok, :order (:order r)}))))))
