    73	(defn standard
    74	  "The standard catalog. The Clojure frontend consumes the forms the
    75	   shell's own reader read, so its parse stage is the identity.  The Python
    76	   ANTLR frontend is installed where its parser runs (the JVM); elsewhere
    77	   selecting it answers `unavailable-parser`.  It shows what a submission
    78	   printed and not the program's value (`:display :output`).  Its linked
    79	   profile, `:yang.python/antlr-linked`, runs the runtime as the module
    80	   `py` and imports modules through the shell's link source, under the
    81	   Python admission (`yang.python.antlr.repl/linked-binding`)."
    82	  []
    83	  (cond-> frontend/empty-catalog
    84	    true (frontend/install (manifest :yang.clojure/legacy :clojure)
    85	                           {:input :forms,
    86	                            :parse identity,
    87	                            :lower clojure-lower})
    88	    true (frontend/install (manifest :yang.python/legacy :python)
    89	                           {:parse identity, :lower yang.python/compile})
    90	    true (frontend/install (manifest :yang.php/legacy :php)
    91	                           {:parse identity, :lower yang.php/compile})
    92	    #?@(:cljd [] :clj [true (frontend/install
    93	                              (antlr-manifest)
    94	                              {:parse parse-python,
    95	                               :lower python.antlr.repl/lower,
    96	                               :lower-session python.antlr.repl/lower-session,
    97	                               :display :output,
    98	                               :probe python.antlr.probe/probe})
    99	                       true (frontend/install
   100	                              (antlr-linked-manifest)
   101	                              (assoc (python.antlr.repl/linked-binding
   102	                                       parse-python)
   103	                                     :probe python.antlr.probe/probe))])))
   104	
