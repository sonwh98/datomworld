   412	
   413	(defn- respond!
   414	  "Append `body` under the request's id on the response stream.  Returns
   415	   true when it landed, so the interpreter's cursor advances past the
   416	   request only then; a refused append leaves it to be re-read."
   417	  [pair request body]
   418	  (let [o (stream/append! (:responses pair)
   419	                          (assoc body :yin.link/id (:yin.link/id request)))]
   420	    (= :dao.stream/ok (:dao.stream/outcome o))))
   421	
   422	
   423	(defn serve
   424	  "One serve round of the interpreter over the link pair: read every
   425	   request `pair`'s cursor has not yet consumed and answer each in
   426	   request order, at most `budget` of them.  The first request nothing
   427	   can answer yet stops the round -- the requests behind it keep their
   428	   order -- and is reported under `:pending`; its cursor stays, so a
   429	   later round re-reads and re-attempts it.  A response the response
   430	   medium refuses reports its request pending the same way, and the
   431	   round reports no progress.  A content source links each manifest under
   432	   the composition's `:derivation` policy (`composition`'s option,
   433	   `:verifying` unless the composition asked for `:trusted`), and an
   434	   `:ok` response of a lowered format names its `:trust`.  `dht` is the
   435	   shell's DHT node, which a DHT source reads and advances.  Returns
   400	      state
   401	      (recur (first (repl.dht/step state now)) (+ now 10)))))
   402	
   403	
   404	(defn- link-responses
   405	  [state]
   406	  (mapv #(dissoc % :yin.link/id)
   407	        (mesh/values (get-in state [:link-pair :responses]))))
