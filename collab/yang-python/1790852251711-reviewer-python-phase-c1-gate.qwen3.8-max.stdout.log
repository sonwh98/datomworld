{"type":"event","event":{"type":"tool_completed","toolCallId":"call_27c7297150a441838a9f8246","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 130 lines\nNote: showing lines 1-130. More of the file remains. Use offset=131 to continue.\n1: (ns yang.python.antlr.e2e-test\n2:   \"End to end, as a stream topology: source events -> parser stage -> CST\n3:    stream -> lowering stage -> program stream -> an evaluator on each of the\n4:    four VMs (the AST walker observes the program stream itself; the\n5:    semantic, stack and register VMs are built from the same batch read back\n6:    from that stream).\n7: \n8:    The composition installs the real `cell` module (cell slice 1) and the\n9:    real `data` module; nothing is stubbed. Printed output is compared as\n10:    Python text rendered at the boundary (`yang.python.antlr.render`).\"\n11:   (:require\n12:     [clojure.test :refer [deftest is testing]]\n13:     [dao.stream :as stream]\n14:     [yang.python.antlr.lower :as lower]\n15:     [yang.python.antlr.parser :as parser]\n16:     [yang.python.antlr.render :as render]\n17:     [yin.vm :as vm]\n18:     [yin.vm.debruijn-linearize :as dl]\n19:     [yin.vm.debruijn-register-compile :as rc]\n20:     [yin.vm.debruijn.register :as rvm]\n21:     [yin.vm.debruijn.stack :as dvm]\n22:     [yin.vm.linearize :as linearize]\n23:     [yin.vm.module :as module]\n24:     [yin.vm.semantic :as semantic]\n25:     [yin.vm.test-utils :as tu]))\n26: \n27: \n28: ;; =============================================================================\n29: ;; The host modules the lowering targets\n30: ;; =============================================================================\n31: \n32: (def host-registrars\n33:   \"Registry steps the lowered programs need.\"\n34:   '[yin.vm.module/register-cell-module yin.vm.data/register-data-module])\n35: \n36: \n37: (defn host-registry\n38:   \"The registry with the cell and data modules installed.\"\n39:   []\n40:   (reduce (fn [reg sym] ((requiring-resolve sym) reg))\n41:           (module/empty-registry)\n42:           host-registrars))\n43: \n44: \n45: ;; =============================================================================\n46: ;; The topology\n47: ;; =============================================================================\n48: \n49: (def ^:private base-opts\n50:   {:make-stream tu/make-stream,\n51:    :capability-secret tu/secret,\n52:    :primitives vm/primitives})\n53: \n54: \n55: (def ^:private load-semantic\n56:   (vm/fresh-code-loader (linearize/ast-loader semantic/vm-load-program)\n57:                         vm/ast-contract))\n58: \n59: \n60: (defn- source-events\n61:   [unit text]\n62:   [{:yang.source/event :yang.source/chunk,\n63:     :yang.source/unit unit,\n64:     :yang.source/ordinal 0,\n65:     :yang.source/text text}\n66:    {:yang.source/event :yang.source/seal,\n67:     :yang.source/unit unit,\n68:     :yang.source/chunk-count 1}])\n69: \n70: \n71: (defn run-python\n72:   \"Every VM's value for `source`, as `{vm-key value}`; a throw becomes\n73:    `[:thrown message]`. `registry` is the module registry the composition\n74:    supplies.\"\n75:   [registry source]\n76:   (let [opts (assoc base-opts :modules registry)\n77:         session (tu/make-observer-session (tu/create-vm {:modules registry}))\n78:         program (:stream (:observer session))\n79:         src (tu/new-memory-log)\n80:         cst (tu/new-memory-log)\n81:         diagnostics (tu/new-memory-log)]\n82:     (doseq [e (source-events [:e2e 0] source)] (stream/append! src e))\n83:     (parser/step-stage (parser/open-stage src cst))\n84:     (lower/step-stage (lower/open-stage cst program diagnostics))\n85:     (let [batches (tu/drain program)\n86:           problems (tu/drain diagnostics)]\n87:       (if (seq problems)\n88:         {:diagnostics problems}\n89:         (let [datoms (first batches)\n90:               attempt (fn [f]\n91:                         (try (render/output (f))\n92:                              (catch Exception e [:thrown (ex-message e)])))]\n93:           {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n94:            :semantic (attempt #(vm/value (vm/run (load-semantic\n95:                                                    (semantic/create-vm opts)\n96:                                                    datoms)))),\n97:            :stack (attempt #(vm/value\n98:                               (vm/run (dvm/create-vm\n99:                                         (:image (dl/adapt datoms))\n100:                                         (assoc opts\n101:                                                :contract vm/stack-contract))))),\n102:            :register (attempt #(vm/value\n103:                                  (vm/run (rvm/create-vm\n104:                                            (:image (rc/adapt datoms))\n105:                                            (assoc opts\n106:                                                   :contract\n107:                                                   vm/register-contract)))))})))))\n108: \n109: \n110: (defn- prints\n111:   \"The rendered value of a run that printed `lines` and raised nothing.\"\n112:   [& lines]\n113:   {:py/out (vec lines), :py/exception nil})\n114: \n115: \n116: (defn- every-vm=\n117:   [expected source]\n118:   (let [results (run-python (host-registry) source)]\n119:     (is (not (contains? results :diagnostics)) (pr-str results))\n120:     (doseq [k [:ast-walker :semantic :stack :register]]\n121:       (is (= expected (get results k)) (str k)))))\n122: \n123: \n124: ;; =============================================================================\n125: ;; Programs\n126: ;; =============================================================================\n127: \n128: (deftest arithmetic-and-print-test\n129:   (every-vm= (prints \"7 3.5\" \"-4\")\n130:              \"print(1 + 2 * 3, 7 / 2)\\nprint(-(2 + 2))\\n\"))"}],"deferred":false}}
