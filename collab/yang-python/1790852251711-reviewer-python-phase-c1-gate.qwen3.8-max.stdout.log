{"type":"event","event":{"type":"tool_completed","toolCallId":"call_30c356834ca84148948f65a7","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 339 lines\n1: (ns yang.python.antlr.e2e-c1-test\n2:   \"Phase C1 end to end on all four VMs over the real cell and data modules,\n3:    through the same stream topology as `yang.python.antlr.e2e-test`:\n4:    finally and with on every exit, tuples and unpacking, slices, the new\n5:    operators, comprehensions, keyword arguments, and the r2 gate's P3s.\"\n6:   (:require\n7:     [clojure.test :refer [deftest is testing]]\n8:     [yang.python.antlr.e2e-test :as e2e]))\n9: \n10: \n11: (defn- prints\n12:   [& lines]\n13:   {:py/out (vec lines), :py/exception nil})\n14: \n15: \n16: (defn- every-vm=\n17:   [expected source]\n18:   (let [results (e2e/run-python (e2e/host-registry) source)]\n19:     (is (not (contains? results :diagnostics)) (pr-str results))\n20:     (doseq [k [:ast-walker :semantic :stack :register]]\n21:       (is (= expected (get results k)) (str k)))))\n22: \n23: \n24: (defn- lines\n25:   [& ls]\n26:   (apply str (map #(str % \"\\n\") ls)))\n27: \n28: \n29: ;; =============================================================================\n30: ;; 1. finally and with\n31: ;; =============================================================================\n32: \n33: (deftest finally-runs-on-every-exit-test\n34:   (testing \"normal completion, return, break, continue and raise all run the\n35:             finally block\"\n36:     (every-vm=\n37:       (prints \"end r end end\"\n38:               (str \"['body', 'fin-ok', 'body', 'fin-ok', 'body', 'fin-ok', \"\n39:                    \"'fin-ret', 'fin-brk', 'fin-cont', 'fin-cont', 'fin-cont', \"\n40:                    \"'fin-raise', 'caught']\"))\n41:       (lines \"log = []\"\n42:              \"def f(k):\"\n43:              \"    for i in range(3):\"\n44:              \"        try:\"\n45:              \"            if k == 'ret':\"\n46:              \"                return 'r'\"\n47:              \"            if k == 'brk':\"\n48:              \"                break\"\n49:              \"            if k == 'cont':\"\n50:              \"                continue\"\n51:              \"            if k == 'raise':\"\n52:              \"                raise ValueError('v')\"\n53:              \"            log.append('body')\"\n54:              \"        finally:\"\n55:              \"            log.append('fin-' + k)\"\n56:              \"    return 'end'\"\n57:              \"print(f('ok'), f('ret'), f('brk'), f('cont'))\"\n58:              \"try:\"\n59:              \"    f('raise')\"\n60:              \"except ValueError:\"\n61:              \"    log.append('caught')\"\n62:              \"print(log)\"))))\n63: \n64: \n65: (deftest finally-nesting-and-override-test\n66:   (testing \"nested finally blocks run innermost first; a return in finally\n67:             overrides; finally follows a handler that returns\"\n68:     (every-vm= (prints \"1 2 m ['inner', 'outer', 'except', 'fin']\")\n69:                (lines \"out = []\"\n70:                       \"def g():\"\n71:                       \"    try:\"\n72:                       \"        try:\"\n73:                       \"            return 1\"\n74:                       \"        finally:\"\n75:                       \"            out.append('inner')\"\n76:                       \"    finally:\"\n77:                       \"        out.append('outer')\"\n78:                       \"def h():\"\n79:                       \"    try:\"\n80:                       \"        return 1\"\n81:                       \"    finally:\"\n82:                       \"        return 2\"\n83:                       \"def m():\"\n84:                       \"    try:\"\n85:                       \"        raise KeyError('k')\"\n86:                       \"    except KeyError:\"\n87:                       \"        out.append('except')\"\n88:                       \"        return 'm'\"\n89:                       \"    finally:\"\n90:                       \"        out.append('fin')\"\n91:                       \"print(g(), h(), m(), out)\"))))\n92: \n93: \n94: (deftest raise-in-finally-and-handler-stack-test\n95:   (testing \"an exception raised in finally replaces the one in flight, and\n96:             the handler stack is consistent afterwards\"\n97:     (every-vm= (prints \"key ('b',)\" \"ok\" \"after-break\")\n98:                (lines \"try:\"\n99:                       \"    try:\"\n100:                       \"        raise ValueError('a')\"\n101:                       \"    finally:\"\n102:                       \"        raise KeyError('b')\"\n103:                       \"except KeyError as e:\"\n104:                       \"    print('key', e.args)\"\n105:                       \"except ValueError:\"\n106:                       \"    print('value')\"\n107:                       \"while True:\"\n108:                       \"    try:\"\n109:                       \"        break\"\n110:                       \"    finally:\"\n111:                       \"        pass\"\n112:                       \"try:\"\n113:                       \"    raise TypeError('t')\"\n114:                       \"except TypeError:\"\n115:                       \"    print('ok')\"\n116:                       \"print('after-break')\"))))\n117: \n118: \n119: (deftest with-statement-test\n120:   (testing \"__enter__/__exit__ on normal exit, a suppressing __exit__, return\n121:             through two managers, and a propagating exception\"\n122:     (every-vm= (prints \"enter a\" \"in a\" \"exit a none\" \"enter b\" \"exit b ValueError\"\n123:                        \"enter c\" \"enter d\" \"exit d none\" \"exit c none\" \"d\"\n124:                        \"enter e\" \"exit e KeyError\" \"propagated\")\n125:                (lines \"log = []\"\n126:                       \"class M:\"\n127:                       \"    def __init__(self, name, suppress=False):\"\n128:                       \"        self.name = name\"\n129:                       \"        self.suppress = suppress\"\n130:                       \"    def __enter__(self):\"\n131:                       \"        log.append('enter ' + self.name)\"\n132:                       \"        return self.name\"\n133:                       \"    def __exit__(self, t, v, tb):\"\n134:                       \"        log.append('exit ' + self.name + ' ' + ('none' if t is None else t.__name__))\"\n135:                       \"        return self.suppress\"\n136:                       \"with M('a') as x:\"\n137:                       \"    log.append('in ' + x)\"\n138:                       \"with M('b', True):\"\n139:                       \"    raise ValueError('swallowed')\"\n140:                       \"def f():\"\n141:                       \"    with M('c'), M('d') as y:\"\n142:                       \"        return y\"\n143:                       \"log.append(f())\"\n144:                       \"try:\"\n145:                       \"    with M('e'):\"\n146:                       \"        raise KeyError('k')\"\n147:                       \"except KeyError:\"\n148:                       \"    log.append('propagated')\"\n149:                       \"for line in log:\"\n150:                       \"    print(line)\"))))\n151: \n152: \n153: ;; =============================================================================\n154: ;; 2. Tuples, unpacking and slices\n155: ;; =============================================================================\n156: \n157: (deftest tuples-and-unpacking-test\n158:   (every-vm= (prints \"6 1 2 3 1 [2, 3, 4] ['a', 'b'] c p p\"\n159:                      \"a 1\" \"b 2\"\n160:                      \"2 1\"\n161:                      \"unpack\")\n162:              (lines \"t = (1, 2, 3)\"\n163:                     \"a, b, c = t\"\n164:                     \"x, (y, z) = 1, [2, 3]\"\n165:                     \"first, *rest = [1, 2, 3, 4]\"\n166:                     \"*init, last = 'abc'\"\n167:                     \"d = {(1, 2): 'p'}\"\n168:                     \"print(a + b + c, x, y, z, first, rest, init, last, d[1, 2], d[(1.0, 2)])\"\n169:                     \"for k, v in {'a': 1, 'b': 2}.items():\"\n170:                     \"    print(k, v)\"\n171:                     \"a, b = 1, 2\"\n172:                     \"a, b = b, a\"\n173:                     \"print(a, b)\"\n174:                     \"try:\"\n175:                     \"    p, q = [1, 2, 3]\"\n176:                     \"except ValueError:\"\n177:                     \"    print('unpack')\")))\n178: \n179: \n180: (deftest slices-test\n181:   (every-vm= (prints \"() (1,) (3, 2, 1) (2, 3) [4, 5] ell hlo\"\n182:                      \"(2, 3) he (3, 2)\"\n183:                      \"[0, 'a', 3, 4] [] True 3 [] [4, 3]\")\n184:              (lines \"t = (1, 2, 3)\"\n185:                     \"print((), (1,), t[::-1], t[1:], [1, 2, 3, 4, 5][-2:], 'hello'[1:4], 'hello'[::2])\"\n186:                     \"print(t[1:100], 'hello'[-100:2], t[100:0:-1])\"\n187:                     \"L = [0, 1, 2, 3, 4]\"\n188:                     \"L[1:3] = ['a']\"\n189:                     \"print(L, L[10:], t == (1, 2, 3), len(t), L[3:1], L[:1:-1])\")))\n190: \n191: \n192: (deftest tuples-are-values-and-unhashable-lists-test\n193:   (every-vm= (prints \"True False 2\" \"unhashable\")\n194:              (lines \"a = (1, [2])\"\n195:                     \"s = {(1, 2), (1, 2.0), (2, 1)}\"\n196:                     \"print((1, 2) == (1.0, 2), (1, 2) == (2, 1), len(s))\"\n197:                     \"try:\"\n198:                     \"    {[1]: 2}\"\n199:                     \"except TypeError:\"\n200:                     \"    print('unhashable')\")))\n201: \n202: \n203: ;; =============================================================================\n204: ;; 3. Operators\n205: ;; =============================================================================\n206: \n207: (deftest arithmetic-operators-test\n208:   (every-vm= (prints \"3 -4 1 2 -2 1024 0.5 8.0 -8 512 -4\"\n209:                      \"3.0 0.5 2 7 5 -6 2 16 -4 2\"\n210:                      \"zero\")\n211:              (lines \"print(7 // 2, -7 // 2, 7 % 3, -7 % 3, 7 % -3, 2 ** 10, 2 ** -1, 2.0 ** 3, (-2) ** 3, 2 ** 3 ** 2, -2 ** 2)\"\n212:                     \"print(7.5 // 2, -7.5 % 2, 6 & 3, 6 | 3, 6 ^ 3, ~5, -6 & 3, 1 << 4, -16 >> 2, 5 >> 1)\"\n213:                     \"try:\"\n214:                     \"    1 // 0\"\n215:                     \"except ZeroDivisionError:\"\n216:                     \"    print('zero')\")))\n217: \n218: \n219: (deftest membership-and-augmented-test\n220:   (every-vm= (prints \"True True False True False True True\"\n221:                      \"4 22 [1, 2, 1, 2] [0, 0, 0] abab (1, 1)\")\n222:              (lines \"print(3 in [1, 2, 3], 'ell' in 'hello', 'k' not in {'k': 1}, (1, 2) in [(1, 2)], 2 in (1, 3), 4 in range(5), 2 in {1, 2})\"\n223:                     \"x = 10\"\n224:                     \"x //= 3\"\n225:                     \"x **= 2\"\n226:                     \"x %= 5\"\n227:                     \"y = 6\"\n228:                     \"y &= 3\"\n229:                     \"y |= 8\"\n230:                     \"y ^= 1\"\n231:                     \"y <<= 2\"\n232:                     \"y >>= 1\"\n233:                     \"L = [1]\"\n234:                     \"M = L\"\n235:                     \"L += [2]\"\n236:                     \"L *= 2\"\n237:                     \"print(x, y, M, [0] * 3, 'ab' * 2, (1,) * 2)\")))\n238: \n239: \n240: ;; =============================================================================\n241: ;; 4. Comprehensions\n242: ;; =============================================================================\n243: \n244: (deftest comprehensions-test\n245:   (every-vm= (prints \"[4, 16] {3: 6, 4: 8} {0, 1}\"\n246:                      \"[(1, 0), (2, 0), (2, 1)] 10 ['a', 'b'] True False\"\n247:                      \"(1, 2) {1}\")\n248:              (lines \"xs = [1, 2, 3, 4]\"\n249:                     \"print([x * x for x in xs if x % 2 == 0], {x: x * 2 for x in xs if x > 2}, {x % 2 for x in [2, 3, 4]})\"\n250:                     \"print([(i, j) for i in range(3) for j in range(i)], sum(x for x in xs), list(c for c in 'ab'), any(x > 3 for x in xs), all(x > 3 for x in xs))\"\n251:                     \"print(tuple(x for x in [1, 2]), set(x for x in [1, 1]))\")))\n252: \n253: \n254: (deftest comprehension-scope-test\n255:   (testing \"the loop variable is local to the comprehension; the first\n256:             iterable is evaluated in the enclosing (here, class) scope;\n257:             closures over the loop variable share its one cell\"\n258:     (every-vm= (prints \"outer [0, 1]\" \"[0, 2, 4]\" \"[2, 2, 2]\")\n259:                (lines \"x = 'outer'\"\n260:                       \"ys = [x for x in range(2)]\"\n261:                       \"print(x, ys)\"\n262:                       \"class C:\"\n263:                       \"    n = 3\"\n264:                       \"    vals = [i * 2 for i in range(n)]\"\n265:                       \"print(C.vals)\"\n266:                       \"fs = [lambda: i for i in range(3)]\"\n267:                       \"print([f() for f in fs])\"))))\n268: \n269: \n270: ;; =============================================================================\n271: ;; 5. Keyword arguments\n272: ;; =============================================================================\n273: \n274: (deftest keyword-arguments-test\n275:   (every-vm= (prints \"[1, 2, (), 3, 4, {}]\"\n276:                      \"[1, 5, (6, 7), 8, 0, {'e': 9}]\"\n277:                      \"[1, 2, (3,), 4, 4, {'z': 5}]\"\n278:                      \"3 7 3\"\n279:                      \"TypeError g() missing required keyword-only argument 'b'\"\n280:                      \"TypeError g() takes too many positional arguments\"\n281:                      \"TypeError g() got an unexpected keyword argument 'c'\"\n282:                      \"TypeError g() got multiple values for argument 'a'\"\n283:                      \"TypeError f() missing required positional argument 'a'\")\n284:              (lines \"def f(a, b=2, *args, c, d=4, **kw):\"\n285:                     \"    return [a, b, args, c, d, kw]\"\n286:                     \"print(f(1, c=3))\"\n287:                     \"print(f(1, 5, 6, 7, c=8, e=9, d=0))\"\n288:                     \"print(f(*[1, 2, 3], **{'c': 4, 'z': 5}))\"\n289:                     \"def g(a, *, b):\"\n290:                     \"    return a + b\"\n291:                     \"class P:\"\n292:                     \"    def __init__(self, x, y=0):\"\n293:                     \"        self.s = x + y\"\n294:                     \"print(g(1, b=2), g(b=3, a=4), P(y=2, x=1).s)\"\n295:                     \"def check(thunk):\"\n296:                     \"    try:\"\n297:                     \"        thunk()\"\n298:                     \"    except TypeError as e:\"\n299:                     \"        print('TypeError', e.args[0])\"\n300:                     \"check(lambda: g(1))\"\n301:                     \"check(lambda: g(1, 2))\"\n302:                     \"check(lambda: g(1, b=2, c=3))\"\n303:                     \"check(lambda: g(1, a=2, b=3))\"\n304:                     \"check(lambda: f())\")))\n305: \n306: \n307: ;; =============================================================================\n308: ;; 6. The r2 gate's P3 notes\n309: ;; =============================================================================\n310: \n311: (deftest gate-p3-runtime-test\n312:   (testing \"global globals then globals(); builtin classes stay builtin when\n313:             the module rebinds their names (as in CPython); the\n314:             UnboundLocalError message; repr of quotes and control characters\"\n315:     (every-vm= (prints \"5 5\"\n316:                        \"caught ok\"\n317:                        \"cannot access local variable 'u' where it is not associated with a value\"\n318:                        \"['a\\\\nb', \\\"it's\\\", '\\\\x01']\")\n319:                (lines \"def f():\"\n320:                       \"    global globals\"\n321:                       \"    return globals()['k']\"\n322:                       \"k = 5\"\n323:                       \"print(f(), globals()['k'])\"\n324:                       \"TypeError = None\"\n325:                       \"object = 1\"\n326:                       \"class C:\"\n327:                       \"    pass\"\n328:                       \"try:\"\n329:                       \"    1 + 'a'\"\n330:                       \"except Exception:\"\n331:                       \"    print('caught', 'ok' if C() is not None else 'no')\"\n332:                       \"def g():\"\n333:                       \"    v = u\"\n334:                       \"    u = 1\"\n335:                       \"try:\"\n336:                       \"    g()\"\n337:                       \"except NameError as e:\"\n338:                       \"    print(e.args[0])\"\n339:                       \"print(['a\\\\nb', \\\"it's\\\", '\\\\x01'])\"))))"}],"deferred":false}}
