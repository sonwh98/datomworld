       :rule (:rule n),\n69:                    :span (:span n)})))\n70: \n71: \n72: (def unsupported-rules\n73:   \"Grammar rules outside the phase-A subset, with the construct each names.\"\n74:   {\"single_input\" \"interactive input\",\n75:    \"eval_input\" \"eval input\",\n76:    \"decorator\" \"decorator\",\n77:    \"decorators\" \"decorator\",\n78:    \"decorated\" \"decorator\",\n79:    \"async_funcdef\" \"async def\",\n80:    \"async_stmt\" \"async statement\",\n81:    \"annassign\" \"annotated assignment\",\n82:    \"del_stmt\" \"del statement\",\n83:    \"yield_stmt\" \"yield\",\n84:    \"yield_expr\" \"yield\",\n85:    \"yield_arg\" \"yield\",\n86:    \"import_stmt\" \"import\",\n87:    \"import_name\" \"import\",\n88:    \"import_from\" \"import\",\n89:    \"import_as_name\" \"import\",\n90:    \"import_as_names\" \"import\",\n91:    \"dotted_as_name\" \"import\",\n92:    \"dotted_as_names\" \"import\",\n93:    \"dotted_name\" \"import\",\n94:    \"assert_stmt\" \"assert statement\",\n95:    \"match_stmt\" \"match statement\",\n96:    \"subject_expr\" \"match statement\",\n97:    \"star_named_expressions\" \"match statement\",\n98:    \"star_named_expression\" \"match statement\",\n99:    \"case_block\" \"match statement\",\n100:    \"guard\" \"match statement\",\n101:    \"patterns\" \"match statement\",\n102:    \"pattern\" \"match statement\",\n103:    \"as_pattern\" \"match statement\",\n104:    \"or_pattern\" \"match statement\",\n105:    \"closed_pattern\" \"match statement\",\n106:    \"literal_pattern\" \"match statement\",\n107:    \"literal_expr\" \"match statement\",\n108:    \"complex_number\" \"match statement\",\n109:    \"signed_number\" \"match statement\",\n110:    \"signed_real_number\" \"match statement\",\n111:    \"real_number\" \"match statement\",\n112:    \"imaginary_number\" \"match statement\",\n113:    \"capture_pattern\" \"match statement\",\n114:    \"pattern_capture_target\" \"match statement\",\n115:    \"wildcard_pattern\" \"match statement\",\n116:    \"value_pattern\" \"match statement\",\n117:    \"attr\" \"match statement\",\n118:    \"name_or_attr\" \"match statement\",\n119:    \"group_pattern\" \"match statement\",\n120:    \"sequence_pattern\" \"match statement\",\n121:    \"open_sequence_pattern\" \"match statement\",\n122:    \"maybe_sequence_pattern\" \"match statement\",\n123:    \"maybe_star_pattern\" \"match statement\",\n124:    \"star_pattern\" \"match statement\",\n125:    \"mapping_pattern\" \"match statement\",\n126:    \"items_pattern\" \"match statement\",\n127:    \"key_value_pattern\" \"match statement\",\n128:    \"double_star_pattern\" \"match statement\",\n129:    \"class_pattern\" \"match statement\",\n130:    \"positional_patterns\" \"match statement\",\n131:    \"keyword_patterns\" \"match statement\",\n132:    \"keyword_pattern\" \"match statement\",\n133:    \"encoding_decl\" \"encoding declaration\"})\n134: \n135: \n136: (def consumed-rules\n137:   \"Rules read only by their parent's arm; they never reach `lower` alone.\"\n138:   #{\"parameters\" \"typedargslist\" \"tfpdef\" \"varargslist\" \"vfpdef\"\n139:     \"augassign\" \"except_clause\" \"block\" \"comp_op\" \"trailer\" \"subscriptlist\"\n140:     \"subscript_\" \"sliceop\" \"arglist\" \"argument\" \"testlist_comp\"\n141:     \"dictorsetmaker\" \"strings\" \"comp_for\" \"comp_iter\" \"comp_if\" \"with_item\"})\n142: \n143: \n144: (def handled-rules\n145:   \"Rules with their own arm in `lower`.\"\n146:   #{\"file_input\" \"stmt\" \"simple_stmts\" \"simple_stmt\" \"compound_stmt\"\n147:     \"flow_stmt\" \"expr_stmt\" \"testlist_star_expr\" \"testlist\" \"exprlist\"\n148:     \"pass_stmt\" \"break_stmt\" \"continue_stmt\" \"return_stmt\" \"raise_stmt\"\n149:     \"global_stmt\" \"nonlocal_stmt\" \"if_stmt\" \"while_stmt\" \"for_stmt\"\n150:     \"try_stmt\" \"with_stmt\" \"funcdef\" \"classdef\" \"test\" \"test_nocond\"\n151:     \"lambdef\" \"lambdef_nocond\" \"or_test\" \"and_test\" \"not_test\" \"comparison\"\n152:     \"expr\" \"star_expr\" \"atom_expr\" \"atom\" \"name\"})\n153: \n154: \n155: (defn- default-arm\n156:   [n]\n157:   (if-let [construct (get unsupported-rules (:rule n))]\n158:     (unsupported! n construct)\n159:     (throw (ex-info (str \"Unhandled grammar rule: \" (:rule n))\n160:                     {:yang.python.antlr/diagnostic\n161:                      :yang.python.antlr/unhandled-rule,\n162:                      :rule (:rule n),\n163:                      :span (:span n)}))))\n164: \n165: \n166: ;; =============================================================================\n167: ;; Small helpers\n168: ;; =============================================================================\n169: \n170: (defn- gen\n171:   [prefix n]\n172:   (symbol (str \"%\" prefix (:id n))))\n173: \n174: \n175: (defn- kids\n176:   [ctx n]\n177:   (p/children (:pk ctx) n))\n178: \n179: \n180: (defn- rules\n181:   [ctx n rule-name]\n182:   (p/child-rules (:pk ctx) n rule-name))\n183: \n184: \n185: (defn- rule-kids\n186:   [ctx n]\n187:   (filterv p/rule? (kids ctx n)))\n188: \n189: \n190: (defn- name-of\n191:   \"The identifier text of a `name` node.\"\n192:   [ctx n]\n193:   (:text (first (kids ctx n))))\n194: \n195: \n196: (defn- app*\n197:   [op-sym & args]\n198:   (apply u/app (u/v op-sym) args))\n199: \n200: \n201: (defn- build-vector\n202:   [elems]\n203:   (reduce (fn [acc e] (app* 'py/conj acc e)) (u/lit []) elems))\n204: \n205: \n206: (defn- truthy\n207:   [x]\n208:   (app* 'py/truthy x))\n209: \n210: \n211: (def ^:private none (u/lit :py/None))\n212: \n213: \n214: (defn- contains-rule?\n215:   \"True when `rule-name` occurs below `n` without crossing any `stop` rule.\"\n216:   [ctx n rule-name stop]\n217:   (boolean\n218:     (some (fn [k]\n219:             (and (p/rule? k)\n220:                  (or (= rule-name (:rule k))\n221:                      (and (not (contains? stop (:rule k)))\n222:                           (contains-rule? ctx k rule-name stop)))))\n223:           (kids ctx n))))\n224: \n225: \n226: (def ^:private scope-rules #{\"funcdef\" \"lambdef\" \"lambdef_nocond\" \"classdef\"})\n227: \n228: \n229: (def ^:private loop-and-scope-rules\n230:   (into scope-rules #{\"while_stmt\" \"for_stmt\"}))\n231: \n232: \n233: ;; =============================================================================\n234: ;; Literals\n235: ;; =============================================================================\n236: \n237: (def ^:private max-exact-int 9007199254740991)\n238: \n239: \n240: (defn- parse-radix\n241:   [n digits radix]\n242:   (reduce (fn [acc ch]\n243:             (let [d (str/index-of \"0123456789abcdef\" (str/lower-case (str ch)))]\n244:               (when (or (nil? d) (>= d radix))\n245:                 (unsupported! n \"number literal\"))\n246:               (let [x (+ (* acc radix) d)]\n247:                 (when (> x max-exact-int)\n248:                   (unsupported! n \"integer literal beyond 2^53\"))\n249:                 x)))\n250:           0\n251:           digits))\n252: \n253: \n254: (defn- parse-number\n255:   [n text]\n256:   (let [t (str/replace text \"_\" \"\")\n257:         lower (str/lower-case t)]\n258:     (cond\n259:       (str/ends-with? lower \"j\") (unsupported! n \"imaginary literal\")\n260:       (str/starts-with? lower \"0x\") (parse-radix n (subs t 2) 16)\n261:       (str/starts-with? lower \"0o\") (parse-radix n (subs t 2) 8)\n262:       (str/starts-with? lower \"0b\") (parse-radix n (subs t 2) 2)\n263:       ;; floats are tagged on every host (owner decision 3)\n264:       (re-find #\"[.eE]\" t) {:py/float #?(:cljd (double/parse t)\n265:                                          :clj (Double/parseDouble t)\n266:                                          :cljs (js/parseFloat t))}\n267:       ;; Python 3 reads 0755 as an error, not as octal or decimal\n268:       (and (str/starts-with? t \"0\") (re-find #\"[1-9]\" t))\n269:       (syntax! n (str \"leading zeros in decimal integer literals are not \"\n270:                       \"permitted; use an 0o prefix for octal integers\"))\n271:       :else (parse-radix n t 10))))\n272: \n273: \n274: (defn- code-point->str\n275:   [cp]\n276:   #?(:cljd (let [sb (StringBuffer)] (.writeCharCode sb cp) (.toString sb))\n277:      :clj (String. (Character/toChars (int cp)))\n278:      :cljs (.fromCodePoint js/String cp)))\n279: \n280: \n281: (defn- hex-value\n282:   [n s]\n283:   (when-not (re-matches #\"[0-9a-fA-F]+\" s)\n284:     (syntax! n \"malformed escape in string literal\"))\n285:   (let [cp (parse-radix n s 16)]\n286:     (when (> cp 0x10FFFF)\n287:       (syntax! n \"illegal Unicode character in \\\\U escape\"))\n288:     cp))\n289: \n290: \n291: (def ^:private simple-escapes\n292:   {\"\\\\\" \"\\\\\", \"'\" \"'\", \"\\\"\" \"\\\"\", \"n\" \"\\n\", \"t\" \"\\t\", \"r\" \"\\r\",\n293:    \"a\" (code-point->str 7), \"b\" (code-point->str 8), \"f\" (code-point->str 12),\n294:    \"v\" (code-point->str 11), \"\\n\" \"\"})\n295: \n296: \n297: (defn- unescape\n298:   [n body]\n299:   (let [len (count body)]\n300:     (loop [i 0\n301:            out []]\n302:       (if (>= i len)\n303:         (apply str out)\n304:         (let [c (subs body i (inc i))]\n305:           (if (and (= c \"\\\\\") (< (inc i) len))\n306:             (let [e (subs body (inc i) (+ i 2))]\n307:               (cond\n308:                 (contains? simple-escapes e)\n309:                 (recur (+ i 2) (conj out (get simple-escapes e)))\n310:                 (= e \"x\") (recur (+ i 4)\n311:                                  (conj out (code-point->str\n312:                                              (hex-value n (subs body (+ i 2) (min len (+ i 4)))))))\n313:                 (= e \"u\") (recur (+ i 6)\n314:                                  (conj out (code-point->str\n315:                                              (hex-value n (subs body (+ i 2) (min len (+ i 6)))))))\n316:                 (= e \"U\") (recur (+ i 10)\n317:                                  (conj out (code-point->str\n318:                                              (hex-value n (subs body (+ i 2) (min len (+ i 10)))))))\n319:                 (= e \"N\") (unsupported! n \"named unicode escape\")\n320:                 (re-matches #\"[0-7]\" e)\n321:                 (let [digits (re-find #\"^[0-7]{1,3}\" (subs body (inc i)))]\n322:                   (recur (+ i 1 (count digits))\n323:                          (conj out (code-point->str (parse-radix n digits 8)))))\n324:                 :else (recur (+ i 2) (conj out c e))))\n325:             (recur (inc i) (conj out c))))))))\n326: \n327: \n328: (defn- parse-string\n329:   \"The value of one STRING token: prefixes u and r only.\"\n330:   [n text]\n331:   (let [prefix (str/lower-case (re-find #\"^[A-Za-z]*\" text))\n332:         quoted (subs text (count prefix))\n333:         q3 (subs quoted 0 (min 3 (count quoted)))\n334:         body (if (or (= q3 \"'''\") (= q3 \"\\\"\\\"\\\"\"))\n335:                (subs quoted 3 (- (count quoted) 3))\n336:                (subs quoted 1 (dec (count quoted))))]\n337:     (case prefix\n338:       (\"\" \"u\") (unescape n body)\n339:       \"r\" body\n340:       (unsupported! n (if (str/includes? prefix \"b\")\n341:                         \"bytes literal\"\n342:                         \"f-string\")))))\n343: \n344: \n345: ;; =============================================================================\n346: ;; Names\n347: ;; =============================================================================\n348: \n349: (defn- resolve-name\n350:   [ctx name]\n351:   (scope/resolve (:analysis ctx) (:scope ctx) name))\n352: \n353: \n354: (def globals-sym\n355:   \"The module namespace dict: the module body's parameter, closed over by\n356:    every function in the module (Python's `__globals__`).\"\n357:   '%globals)\n358: \n359: \n360: (def globals-fn-sym\n361:   \"The module's `globals` builtin: a function object returning `%globals`,\n362:    the module body's second parameter.\"\n363:   '%globals-fn)\n364: \n365: \n366: (defn- global-key\n367:   [name]\n368:   (u/lit {:py/str name}))\n369: \n370: \n371: (defn- read-global\n372:   \"A module-level read at run time: the module dict, then, for a builtin\n373:    name, the builtin. A present module key always wins, so\n374:    `print(len([])); len = 1` reads the builtin first and the global after.\"\n375:   [_n name]\n376:   (cond\n377:     (contains? prelude/builtin-names name)\n378:     (app* 'py/global-or (u/v globals-sym) (global-key name)\n379:           (u/v (get prelude/builtin-names name)))\n380:     (= \"globals\" name)\n381:     (app* 'py/global-or (u/v globals-sym) (global-key name) (u/v globals-fn-sym))\n382:     :else (app* 'py/global-get (u/v globals-sym) (global-key name))))\n383: \n384: \n385: (defn- read-name\n386:   [ctx n name]\n387:   (let [r (resolve-name ctx name)]\n388:     (case (:kind r)\n389:       :cell (app* 'py/local-get (u/v (symbol name)) (u/lit {:py/str name}))\n390:       ;; a name the class body assigns: the class namespace at run time,\n391:       ;; then globals and builtins, as Python's class-body lookup does\n392:       :class-attr (app* 'py/class-ns-get (u/v (:class ctx)) (u/lit name)\n393:                         (u/lam [] (read-global n name)))\n394:       :global (read-global n name))))\n395: \n396: \n397: (defn- builtin?\n398:   \"True when `name` in this scope is the builtin, not a guest binding.\"\n399:   [ctx name]\n400:   (let [r (resolve-name ctx name)]\n401:     (and (= :global (:kind r)) (not (:declared? r)))))\n402: \n403: \n404: (def ^:private consuming-builtins\n405:   \"Builtins that consume an iterable argument eagerly: a generator\n406:    expression passed as their sole argument is indistinguishable from a\n407:    list, so it is lowered as one. Any other generator expression waits for\n408:    C2.\"\n409:   #{\"list\" \"tuple\" \"set\" \"sum\" \"any\" \"all\"})\n410: \n411: \n412: (defn- assign-name\n413:   [ctx name value]\n414:   (let [r (resolve-name ctx name)]\n415:     (case (:kind r)\n416:       :cell (app* 'cell/set! (u/v (symbol name)) value)\n417:       :class-attr (app* 'py/setattr (u/v (:class ctx)) (u/lit name) value)\n418:       :global (app* 'py/global-set (u/v globals-sym) (global-key name) value))))\n419: \n420: \n421: ;; =============================================================================\n422: ;; The dispatch: one arm per grammar rule\n423: ;; =============================================================================\n424: \n425: (declare lower-block lower-call lower-comprehension)\n426: \n427: \n428: (defn- elements\n429:   \"A host vector of display elements: each value conj'd, each `*iterable`\n430:    spliced, left to right.\"\n431:   [ctx elems]\n432:   (reduce (fn [acc e]\n433:             (if (p/rule? e \"star_expr\")\n434:               (app* 'py/extend acc ((:lower ctx) ctx (last (kids ctx e))))\n435:               (app* 'py/conj acc ((:lower ctx) ctx e))))\n436:           (u/lit [])\n437:           elems))\n438: \n439: \n440: (defn- display\n441:   \"A list rule's value: its one element, or the tuple of its elements when\n442:    it has several, a trailing comma or a starred element.\"\n443:   [ctx n]\n444:   (let [elems (rule-kids ctx n)\n445:         single? (and (= 1 (count elems)) (not (p/has-token? (:pk ctx) n \",\")))]\n446:     (cond\n447:       (and single? (p/rule? (first elems) \"star_expr\"))\n448:       (syntax! n \"can't use starred expression here\")\n449:       single? ((:lower ctx) ctx (first elems))\n450:       :else (app* 'py/tuple (elements ctx elems)))))\n451: \n452: \n453: (defn- fold-bool\n454:   \"`a or b or c` / `a and b and c`: short-circuit, returning an operand.\"\n455:   [ctx n or?]\n456:   (let [operands (rule-kids ctx n)]\n457:     (reduce (fn [rest-node operand]\n458:               (let [t (gen \"t\" operand)]\n459:                 (u/let1 t\n460:                         ((