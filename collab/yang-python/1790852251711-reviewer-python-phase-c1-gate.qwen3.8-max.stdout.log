n1103:      (fn [ks vs i acc]\n1104:        (let [k (get ks i :py/stop)]\n1105:          (if (= k :py/stop)\n1106:            acc\n1107:            (py/zip-pairs ks vs (+ i 1)\n1108:                          (conj acc (py/tuple (conj (conj [] k) (get vs i))))))))]\n1109:     [py/range-args\n1110:      (fn [a rest]\n1111:        (let [xs (get rest :items)\n1112:              n (data/count xs)]\n1113:          (if (= n 0)\n1114:            (py/range3 0 a 1)\n1115:            (if (= n 1)\n1116:              (py/range3 a (get xs 0) 1)\n1117:              (if (= n 2)\n1118:                (py/range3 a (get xs 0) (get xs 1))\n1119:                (py/type-error {:py/str \"range expected at most 3 arguments\"}))))))]\n1120: \n1121:     ;; ---------------------------------------------------------- print\n1122:     [py/snapshot\n1123:      (fn [x]\n1124:        (if (py/str? x)\n1125:          (get x :py/str)\n1126:          (if (= x :py/None)\n1127:            nil\n1128:            (if (py/cell? x)\n1129:              (py/snapshot-obj (cell/get x))\n1130:              (if (= (get x :py/type) :method)\n1131:                :py/method\n1132:                (if (= (get x :py/type) :tuple)\n1133:                  (assoc {} :py/tuple (py/snapshot-all (get x :items) 0 []))\n1134:                  (if (= (get x :py/type) :range)\n1135:                    (assoc {}\n1136:                           :py/range\n1137:                           (py/conj (py/conj (py/conj [] (get x :start))\n1138:                                             (get x :stop))\n1139:                                    (get x :step)))\n1140:                    x)))))))]\n1141:     [py/snapshot-all\n1142:      (fn [xs i acc]\n1143:        (let [x (get xs i :py/stop)]\n1144:          (if (= x :py/stop)\n1145:            acc\n1146:            (py/snapshot-all xs (+ i 1) (conj acc (py/snapshot x))))))]\n1147:     [py/snapshot-pairs\n1148:      (fn [ks vs i acc]\n1149:        (let [k (get ks i :py/stop)]\n1150:     