     ((:lower ctx) ctx (first ks))\n863:                              (butlast trailers))\n864:             last-t (last trailers)\n865:             head (first (kids ctx last-t))\n866:             o (gen \"o\" n)\n867:             k (gen \"k\" n)]\n868:         (cond\n869:           (p/token? head \"[\")\n870:           (u/let1 o receiver\n871:                   (u/let1 k (subscript-key ctx last-t)\n872:                           (app* 'py/setitem (u/v o) (u/v k)\n873:                                 (app* op (app* 'py/getitem (u/v o) (u/v k)) rhs))))\n874:           (p/token? head \".\")\n875:           (let [attr (u/lit (name-of ctx (second (kids ctx last-t))))]\n876:             (u/let1 o receiver\n877:                     (app* 'py/setattr (u/v o) attr\n878:                           (app* op (app* 'py/getattr (u/v o) attr) rhs))))\n879:           :else (unsupported! target \"augmented assignment to a call\"))))))\n880: \n881: \n882: (defn- lower-expr-stmt\n883:   [ctx n]\n884:   (let [ks (kids ctx n)]\n885:     (cond\n886:       (= 1 (count ks)) ((:lower ctx) ctx (first ks))\n887:       (p/rule? (second ks) \"annassign\") (unsupported! n \"annotated assignment\")\n888:       (p/rule? (second ks) \"augassign\")\n889:       (lower-augmented ctx n (first ks) (second ks) (nth ks 2))\n890:       :else\n891:       (let [sides (filterv p/rule? ks)\n892:             value-node (peek sides)\n893:             targets (pop sides)\n894:             _ (when (p/rule? value-node \"yield_expr\")\n895:                 (unsupported! value-node \"yield\"))\n896:             value ((:lower ctx) ctx value-node)]\n897:         (if (and (= 1 (count targets))\n898:                  (scope/simple-name (:pk ctx) (first targets)))\n899:           (assign-target ctx (first targets) value)\n900:           (let [tmp (gen \"v\" n)]\n901:             (u/let1 tmp value\n902:                     (u/seq-nodes (map #(assign-target ctx % (u/v tmp))\n903:                                       targets)))))))))\n904: \n905: \n906: ;; -----------------------------------------------------------------------------\n907: ;; Functions and classes\n908: ;; -----------------------------------------------------------------------------\n909: \n910: (defn- param-name\n911:   [ctx param]\n912:   (when (< 1 (count (:children param)))\n913:     (unsupported! param \"parameter annotation\"))\n914:   (name-of ctx (first (rules ctx param \"name\"))))\n915: \n916: \n917: (defn- param-spec\n918:   \"The shape of a parameter list, in the order Python writes it:\n919:    positional names with the default nodes of the trailing ones; `*name`\n920:    (or a bare `*`); keyword-only names with their default nodes; `**name`.\"\n921:   [ctx arg-list param-rule]\n922:   (loop [ks (if arg-list (kids ctx arg-list) [])\n923:          phase :positional\n924:          spec {:params [], :defaults [], :star? false, :kwonly [], :kwdefaults [],\n925:                :kwstar? false}]\n926:     (if-let [k (first ks)]\n927:       (cond\n928:         (p/token? k \",\") (recur (rest ks) phase spec)\n929:         (p/token? k \"**\")\n930:         (do (when (some #(p/rule? % param-rule) (drop 2 ks))\n931:               (syntax! arg-list \"arguments cannot follow var-keyword argument\"))\n932:             (param-name ctx (second ks))\n933:             (recur (drop 2 ks) :done (assoc spec :kwstar? true)))\n934:         (p/token? k \"*\")\n935:         (if (p/rule? (second ks) param-rule)\n936:           (do (param-name ctx (second ks))\n937:               (recur (drop 2 ks) :kwonly (assoc spec :star? true)))\n938:           (do (when-not (some #(p/rule? % param-rule) (rest ks))\n939:                 (syntax! arg-list \"named arguments must follow bare *\"))\n940:               (recur (rest ks) :kwonly spec)))\n941:         (p/rule? k param-rule)\n942:         (let [nm (param-name ctx k)\n943:               default (when (p/token? (second ks) \"=\") (nth ks 2))\n944:               ks' (if default (drop 3 ks) (rest ks))]\n945:           (if (= phase :kwonly)\n946:             (recur ks' phase (cond-> (update spec :kwonly conj nm)\n947:                                default (update :kwdefaults conj [nm default])))\n948:             (do (when (and (not default) (seq (:defaults spec)))\n949:                   (syntax! k \"non-default argument follows default argument\"))\n950:                 (recur ks' phase (cond-> (update spec :params conj nm)\n951:                                    default (update :defaults conj default))))))\n952:         :else (unsupported! arg-list \"parameter list\"))\n953:       spec)))\n954: \n955: \n956: (defn- function-value\n957:   \"A guest function object: `py/make-function` over code taking one\n958:    argument vector laid out as the parameters are written (positional,\n959:    `*args` tuple, keyword-only, `**kwargs` dict). Parameters are rebound to\n960:    cells, other locals are allocated unbound, then `body` (a node lowered\n961:    with the function's context). Defaults are evaluated here, at\n962:    definition time, in the enclosing context.\"\n963:   [ctx scope-node fname {:keys [params defaults star? kwonly kwdefaults kwstar?]}\n964:    body-fn]\n965:   (let [s (get-in (:analysis ctx) [:scopes (:id scope-node)])\n966:         all-params (:params s)\n967:         _ (when-not (= (count all-params) (count (distinct all-params)))\n968:             (syntax! scope-node \"duplicate argument in function definition\"))\n969:         args (gen \"args\" scope-node)\n970:         others (drop (count all-params) (:locals s))\n971:         body (body-fn (assoc ctx\n972:                              :scope (:id scope-node)\n973:                              :loop nil\n974:                              :exc nil\n975:                              :class nil))\n976:         cells (concat (map-indexed (fn [i _]\n977:                                      (app* 'cell/new\n978:                                            (app* 'py/arg (u/v args) (u/lit i))))\n979:                                    all-params)\n980:                       (map (fn [_] (app* 'cell/new (u/lit :py/unbound)))\n981:                            others))]\n982:     (app* 'py/make-function\n983:           (u/lit fname)\n984:           (u/lit (cond-> {:params params}\n985:                    star? (assoc :star? true)\n986:                    (seq kwonly) (assoc :kwonly kwonly)\n987:                    kwstar? (assoc :kwstar? true)))\n988:           (build-vector (map #((:lower ctx) ctx %) defaults))\n989:           (build-vector (map (fn [[nm d]]\n990:                                (build-vector [(u/lit nm) ((:lower ctx) ctx d)]))\n991:                              kwdefaults))\n992:           (u/lam [args]\n993:                  (if (seq (:locals s))\n994:                    (apply u/app (u/lam (map symbol (:locals s)) body) cells)\n995:                    body)))))\n996: \n997: \n998: (defn- lower-funcdef\n999:   [ctx n]\n1000:   (let [ks (kids ctx n)\n1001:         nm (name-of ctx (first (rules ctx n \"name\")))\n1002:         params (first (rules ctx n \"parameters\"))]\n1003:     (when (some #(p/token? % \"->\") ks) (unsupported! n \"return annotation\"))\n1004:     (assign-name\n1005:       ctx nm\n1006:       (function-value\n1007:         ctx n nm\n1008:         (param-spec ctx (first (rules ctx params \"typedargslist\")) \"tfpdef\")\n1009:         (fn [fctx]\n1010:           (let [block (first (rules ctx n \"block\"))]\n1011:             (if (contains-rule? ctx block \"return_stmt\" scope-rules)\n1012:               (let [ret (gen \"ret\" n)]\n1013:                 (app* 'py/call-ec\n1014:                       (u/lam [ret]\n1015:                              (u/seq-nodes\n1016:                                (conj (lower-block (assoc fctx :ret ret) block)\n1017:                                      none)))))\n1018:               (u/seq-nodes (conj (lower-block (assoc fctx :ret nil) block)\n1019:                                  none)))))))))\n1020: \n1021: \n1022: (defn- lower-lambdef\n1023:   \"`lambdef` and `lambdef_nocond` (a lambda inside a comprehension's `if`).\"\n1024:   [ctx n]\n1025:   (function-value ctx n \"<lambda>\"\n1026:                   (param-spec ctx (first (rules ctx n \"varargslist\")) \"vfpdef\")\n1027:                   (fn [fctx]\n1028:                     ((:lower ctx) (assoc fctx :ret nil) (peek (rule-kids ctx n))))))\n1029: \n1030: \n1031: (defn- lower-classdef\n1032:   [ctx n]\n1033:   (let [nm (name-of ctx (first (rules ctx n \"name\")))\n1034:         arglist (first (rules ctx n \"arglist\"))\n1035:         bases (if arglist (rules ctx arglist \"argument\") [])\n1036:         _ (when (> (count bases) 1) (unsupported! n \"multiple inheritance\"))\n1037:         base (if (seq bases)\n1038:                (let [ak (kids ctx (first bases))]\n1039:                  (when-not (and (= 1 (count ak)) (p/rule? (first ak) \"test\"))\n1040:                    (unsupported! n \"class keyword arguments\"))\n1041:                  ((:lower ctx) ctx (first ak)))\n1042:                (u/v 'py.b/object))\n1043:         cls (gen \"cls\" n)\n1044:         body (lower-block (assoc ctx\n1045:                                  :scope (:id n)\n1046:                                  :class cls\n1047:                                  :loop nil\n1048:                                  :ret nil\n1049:                                  :exc nil)\n1050:                           (first (rules ctx n \"block\")))]\n1051:     (u/let1 cls\n1052:             (app* 'py/make-class (u/lit nm) base)\n1053:             (u/seq-nodes (concat body [(assign-name ctx nm (u/v cls))])))))\n1054: \n1055: \n1056: ;; -----------------------------------------------------------------------------\n1057: ;; Control flow\n1058: ;; -----------------------------------------------------------------------------\n1059: \n1060: (defn- lower-if\n1061:   [ctx n]\n1062:   (let [tests (rules ctx n \"test\")\n1063:         blocks (rules ctx n \"block\")\n1064:         else-node (when (> (count blocks) (count tests))\n1065:                     (u/seq-nodes (lower-block ctx (peek blocks))))]\n1066:     (reduce (fn [alt [t b]]\n1067:               (u/if-node (truthy ((:lower ctx) ctx t))\n1068:                          (u/seq-nodes (lower-block ctx b))\n1069:                          alt))\n1070:             (or else-node none)\n1071:             (reverse (map vector tests blocks)))))\n1072: \n1073: \n1074: (defn- loop-body\n1075:   \"The loop body, run under a continue escape when it has a `continue`.\"\n1076:   [ctx body-block brk cont]\n1077:   (let [has-cont? (contains-rule? ctx body-block \"continue_stmt\"\n1078:                                   loop-and-scope-rules)\n1079:         body (u/seq-nodes (lower-block (assoc ctx\n1080:                                               :loop {:brk brk,\n1081:                                                      :cont (when has-cont? cont)})\n1082:                                        body-block))]\n1083:     (if has-cont?\n1084:       (app* 'py/call-ec (u/lam [cont] body))\n1085:       body)))\n1086: \n1087: \n1088: (defn- with-break\n1089:   [ctx body-block brk node]\n1090:   (if (contains-rule? ctx body-block \"break_stmt\" loop-and-scope-rules)\n1091:     (app* 'py/call-ec (u/lam [brk] node))\n1092:     node))\n1093: \n1094: \n1095: (defn- lower-while\n1096:   [ctx n]\n1097:   (let [[body-block else-block] (rules ctx n \"block\")\n1098:         brk (gen \"brk\" n)\n1099:         w (gen \"w\" n)\n1100:         body (loop-body ctx body-block brk (gen \"cont\" n))\n1101:         orelse (if else-block (u/seq-nodes (lower-block ctx else-block)) none)]\n1102:     (with-break ctx body-block brk\n1103:       (u/let1 w\n1104:               (u/lam [w]\n1105:                      (u/if-node (truthy ((:lower ctx) ctx\n1106:                                                       (first (rules ctx n \"test\"))))\n1107:                                 (u/then body (u/app (u/v w) (u/v w)))\n1108:                                 orelse))\n1109:               (u/app (u/v w) (u/v w))))))\n1110: \n1111: \n1112: (defn- lower-for\n1113:   [ctx n]\n1114:   (let [[body-block else-block] (rules ctx n \"block\")\n1115:         target (first (rules ctx n \"exprlist\"))\n1116:         brk (gen \"brk\" n)\n1117:         w (gen \"w\" n)\n1118:         it (gen \"it\" n)\n1119:         i (gen \"i\" n)\n1120:         x (gen \"x\" n)\n1121:         body (loop-body ctx body-block brk (gen \"cont\" n))\n1122:         orelse (if else-block (u/seq-nodes (lower-block ctx else-block)) none)]\n1123:     (with-break ctx body-block brk\n1124:       (u/let1 it\n1125:               (app* 'py/iterable (display ctx (first (rules ctx n \"testlist\"))))\n1126:               (u/let1 w\n1127:                       (u/lam [w i]\n1128:                              (u/let1 x\n1129:                                      (app* 'py/iter-at (u/v it) (u/v i))\n1130:                                      (u/if-node\n1131:                                        (app* '= (u/v x) (u/lit :py/stop))\n1132:                                        orelse\n1133:                                        (u/then (assign-target ctx target (u/v x))\n1134:                                                (u/then body\n1135:                                                        (u/app (u/v w) (u/v w)\n1136:                                                               (app* '+ (u/v i)\n1137:                                                                     (u/lit 1))))))))\n1138:                       (u/app (u/v w) (u/v w) (u/lit 0)))))))\n1139: \n1140: \n1141: (declare lower-try-except)\n1142: \n1143: \n1144: (defn- lower-try\n1145:   \"`try` with `except` clauses (`py/try`), with `finally` (`py/try-finally`\n1146:    around the rest), or both. The finally thunk takes the exception being\n1147:    raised through it, or None, and ignores it.\"\n1148:   [ctx n]\n1149:   (let [ks (kids ctx n)\n1150:         blocks (rules ctx n \"block\")]\n1151:     (if (some #(p/token? % \"finally\") ks)\n1152:       (app* 'py/try-finally\n1153:             (u/lam [] (if (seq (rules ctx n \"except_clause\"))\n1154:                         (lower-try-except ctx n (pop blocks))\n1155:                         (u/seq-nodes (lower-block ctx (first blocks)))))\n1156:             (u/lam [(gen \"fx\" n)] (u/seq-nodes (lower-block ctx (peek blocks)))))\n1157:       (lower-try-except ctx n blocks))))\n1158: \n1159: \n1160: (defn- lower-with\n1161:   \"`with a as x, b:` nests as `with a as x: with b:`; each item is\n1162:    `(py/with manager (fn [value] (assign target value) ...))`.\"\n1163:   [ctx n]\n1164:   (let [items (rules ctx n \"with_item\")\n1165:         body (u/seq-nodes (lower-block ctx (first (rules ctx n \"block\"))))]\n1166:     (reduce (fn [inner item]\n1167:               (let [ik (kids ctx item)\n1168:                     v (gen \"wv\" item)]\n1169:                 (app* 'py/with\n1170:                       ((:lower ctx) ctx (first ik))\n1171:                       (u/lam [v]\n1172:                              (if (p/has-token? (:pk ctx) item \"as\")\n1173:                                (u/then (assign-target ctx (last ik) (u/v v)) inner)\n1174:                                inner)))))\n1175:             body\n1176:             (reverse items))))\n1177: \n1178: \n1179: (defn- lower-try-except\n1180:   \"`try` with `except` clauses and an optional `else`: `blocks` are the try\n1181:    body, one block per clause, then the else block if any.\"\n1182:   [ctx n blocks]\n1183:   (let [exc (gen \"exc\" n)\n1184:         clauses (rules ctx n \"except_clause\")\n1185:         body (u/seq-nodes (lower-block ctx (first blocks)))\n1186:         handler-blocks (subvec blocks 1 (inc (count clauses)))\n1187:         else-block (get blocks (inc (count clauses)))\n1188:         hctx (assoc ctx :exc exc)\n1189:         dispatch\n1190:         (reduce\n1191:           (fn [fallthrough [clause block]]\n1192:             (let [ck (kids ctx clause)\n1193:                   cls-node (first (rules ctx clause \"test\"))\n1194:                   as-name (first (rules ctx clause \"name\"))\n1195:                   handler (u/seq-nodes\n1196:                             (concat (when as-name\n1197:                                       [(assign-name ctx (name-of ctx as-name)\n1198:                                                     (u/v exc))])\n1199:                                     (lower-block hctx block)))]\n1200:               (when (and (nil? cls-node) (> (count ck) 1))\n1201:                 (unsupported! clause \"except clause\"))\n1202:               (if cls-node\n1203:                 (u/if-node (app* 'py/isinstance (u/v exc)\n1204:                                  ((:lower ctx) ctx cls-node))\n1205:                            handler\n1206:                            fallthrough)\n1207:                 handler)))\n1208:           (app* 'py/raise (u/v exc))\n1209:           (reverse (map vector clauses handler-blocks)))]\n1210:     (app* 'py/try\n1211:           (u/lam [] body)\n1212:           (u/lam [exc] dispatch)\n1213:           (u/lam [] (if else-block\n1214:                       (u/seq-nodes (lower-block ctx else-block))\n1215:                       none)))))\n1216: \n1217: \n1218: (defn- lower-flow\n1219:   [ctx n]\n1220:   (case (:rule n)\n1221:     \"break_stmt\" (if-let [brk (get-in ctx [:loop :brk])]\n1222:                    (u/app (u/v brk) none)\n1223:                    (syntax! n \"'break' outside loop\"))\n1224:     \"continue_stmt\" (if (:loop ctx)\n1225:                       (u/app (u/v (get-in ctx [:loop :cont])) none)\n1226:                       (syntax! n \"'continue' not properly in loop\"))\n1227:     \"return_stmt\" (if-let [ret (:ret ctx)]\n1228:                     (u/app (u/v ret)\n1229:                            (if-let [value (first (rules ctx n \"testlist\"))]\n1230:                              (display ctx value)\n1231:                              none))\n1232:                     (syntax! n \"'return' outside function\"))\n1233:     \"raise_stmt\"\n1234:     (let [tests (rules ctx n \"test\")]\n1235:       (cond\n1236:         (p/has-token? (:pk ctx) n \"from\") (unsupported! n \"raise from\")\n1237:         (empty? tests) (if-let [exc (:exc ctx)]\n1238:                          (app* 'py/raise (u/v exc))\n1239:                          (unsupported! n \"bare raise outside except\"))\n1240:         :else (app* 'py/raise (app* 'py/as-exception\n1241:                                     ((:lower ctx) ctx (first tests))))))))\n1242: \n1243: \n1244: ;; -----------------------------------------------------------------------------\n1245: ;; Comprehensions\n1246: ;; -----------------------------------------------------------------------------\n1247: \n1248: (defn- comp-clauses\n1249:   \"A comprehension's clauses in order: `[:for target iterable]` and\n1250:    `[:if test]`.\"\n1251:   [ctx comp-node]\n1252:   (let [next-clause (fn [n]\n1253:                       (when-let [it (first (rules ctx n \"comp_iter\"))]\n1254:                         (first (rule-kids ctx it))))]\n1255:     (loop [n (first (rules ctx comp-node \"comp_for\"))\n1256:            acc []]\n1257:       (cond\n1258:         (nil? n) acc\n1259:         (p/rule? n \"comp_for\")\n1260:         (do (when (p/token? (first (kids ctx n)) \"async\")\n1261:               (unsupported! n \"async comprehension\"))\n1262:             (recur (next-clause n)\n1263:                    (conj acc [:for (first (rules ctx n \"exprlist\"))\n1264:                               (first (rules ctx n \"or_test\"))])))\n1265:         :else (recur (next-clause n)\n1266:                      (conj acc [:if (first (rules ctx n \"test_nocond\"))]))))))\n1267: \n1268: \n1269: (defn- lower-comprehension\n1270:   \"A list, set or dict comprehension (or a generator expression consumed\n1271:    eagerly, as a list) in its own scope: the first iterable is evaluated in\n1272:    the enclosing scope; the targets are cells local to the comprehension;\n1273:    each `for` walks with `py/for-each`, each `if` filters, and the\n1274:    innermost clause adds to a fresh result object.\"\n1275:   [ctx comp-node kind]\n1276:   (let [s (get-in (:analysis ctx) [:scopes (:id comp-node)])\n1277:         cctx (assoc ctx :scope (:id comp-node) :loop nil :ret nil :exc nil :class nil)\n1278:         clauses (comp-clauses ctx comp-node)\n1279:         elems (filterv #(not (p/rule? % \"comp_for\")) (rule-kids ctx comp-node))\n1280:         _ (when (some #(p/rule? % \"star_expr\") elems)\n1281:             (syntax! comp-node \"iterable unpacking cannot be used in comprehension\"))\n1282:         fst (gen \"first\" comp-node)\n1283:         acc (gen \"acc\" comp-node)\n1284:         lower (:lower ctx)\n1285:         emit (case kind\n1286:                :list (app* 'py/list-append (u/v acc) (lower cctx (first elems)))\n1287:                :set (app* 'py/set-add (u/v acc) (lower cctx (first elems)))\n1288:                :dict (app* 'py/dict-set (u/v acc) (lower cctx (first elems))\n1289:                            (lower cctx (second elems))))\n1290:         body (reduce (fn [inner [i [tag a b]]]\n1291:                        (if (= tag :for)\n1292:                          (let [x (gen \"x\" a)]\n1293:                            (app* 'py/for-each\n1294:                                  (if (zero? i) (u/v fst) (lower cctx b))\n1295:                                  (u/lam [x] (u/then (assign-target cctx a (u/v x))\n1296:                                                     inner))))\n1297:                          (u/if-node (truthy (lower cctx a)) inner none)))\n1298:                      emit\n1299:                      (reverse (map-indexed vector clauses)))\n1300:         result (u/let1 acc\n1301:                        (case kind\n1302:                          :list (app* 'py/list (u/lit []))\n1303:                          :set (app* 'py/set-new)\n1304:                          :dict (app* 'py/dict-new))\n1305:                        (u/then body (u/v acc)))]\n1306:     (u/let1 fst\n1307:             (lower ctx (nth (first clauses) 2))\n1308:             (if (seq (:locals s))\n1309:               (apply u/app\n1310:                      (u/lam (map symbol (:locals s)) result)\n1311:                      (map (fn [_] (app* 'cell/new (u/lit :py/unbound))) (:locals s)))\n1312:               result))))\n1313: \n1314: \n1315: ;; -----------------------------------------------------------------------------\n1316: ;; The one dispatch\n1317: ;; -----------------------------------------------------------------------------\n1318: \n1319: (defn- lower\n1320:   [ctx n]\n1321:   (case (:rule n)\n1322:     ;; ---- statements\n1323:     \"file_input\" (u/seq-nodes (conj (mapv #(lower ctx %)\n1324:                                           (rules ctx n \"stmt\"))\n1325:                                     none))\n1326:     \"stmt\" (lower ctx (first (kids ctx n)))\n1327:     \"simple_stmts\" (u/seq-nodes (mapv #(lower ctx %)\n1328:                                       (rules ctx n \"simple_stmt\")))\n1329:     \"simple_stmt\" (lower ctx (first (kids ctx n)))\n1330:     \"compound_stmt\" (lower ctx (first (kids ctx n)))\n1331:     \"flow_stmt\" (lower ctx (first (kids ctx n)))\n1332:     \"expr_stmt\" (lower-expr-stmt ctx n)\n1333:     \"pass_stmt\" none\n1334:     \"break_stmt\" (lower-flow ctx n)\n1335:     \"continue_stmt\" (lower-flow ctx n)\n1336:     \"return_stmt\" (lower-flow ctx n)\n1337:     \"raise_stmt\" (lower-flow ctx n)\n1338:     ;; declarations were consumed by scope analysis\n1339:     \"global_stmt\" none\n1340:     \"nonlocal_stmt\" none\n1341:     \"if_stmt\" (lower-if ctx n)\n1342:     \"while_stmt\" (lower-while ctx n)\n1343:     \"for_stmt\" (lower-for ctx n)\n1344:     \"try_stmt\" (lower-try ctx n)\n1345:     \"with_stmt\" (lower-with ctx n)\n1346:     \"funcdef\" (lower-funcdef ctx n)\n1347:     \"classdef\" (lower-classdef ctx n)\n1348:     ;; ---- expressions\n1349:     \"testlist_star_expr\" (display ctx n)\n1350:     \"testlist\" (display ctx n)\n1351:     \"exprlist\" (display ctx n)\n1352:     \"star_expr\" (syntax! n \"can't use starred expression here\")\n1353:     \"test_nocond\" (lower ctx (first (kids ctx n)))\n1354:     \"lambdef_nocond\" (lower-lambdef ctx n)\n1355:     \"test\" (let [ks (kids ctx n)]\n1356:              (if (= 1 (count ks))\n1357:                (lower ctx (first ks))\n1358:                (u/if-node (truthy (lower ctx (nth ks 2)))\n1359:                           (lower ctx (nth ks 0))\n1360:                           (lower ctx (nth ks 4)))))\n1361:     \"lambdef\" (lower-lambdef ctx n)\n1362:     \"or_test\" (fold-bool ctx n true)\n1363:     \"and_test\" (fold-bool ctx n false)\n1364:     \"not_test\" (let [ks (kids ctx n)]\n1365:                  (if (= 1 (count ks))\n1366:                    (lower ctx (first ks))\n1367:                    (app* 'py/not (lower ctx (second ks)))))\n1368:     \"comparison\" (lower-comparison ctx n)\n1369:     \"expr\" (lower-expr ctx n)\n1370:     \"atom_expr\" (lower-atom-expr ctx n)\n1371:     \"atom\" (lower-atom ctx n)\n1372:     \"name\" (read-name ctx n (name-of ctx n))\n1373:     (default-arm n)))\n1374: \n1375: \n1376: (defn- lower-block\n1377:   \"The statements of a `block` as a vector of nodes.\"\n1378:   [ctx block]\n1379:   (let [ks (kids ctx block)]\n1380:     (if (p/rule? (first ks) \"simple_stmts\")\n1381:       [(lower ctx (first ks))]\n1382:       (mapv #(lower ctx %) (rules ctx block \"stmt\")))))\n1383: \n1384: \n1385: ;; =============================================================================\n1386: ;; Packets\n1387: ;; =============================================================================\n1388: \n1389: (defn- context\n1390:   [packet]\n1391:   (let [pk (p/validate! packet)\n1392:         analysis (scope/analyze pk)]\n1393:     {:pk pk,\n1394:      :analysis analysis,\n1395:      :scope (:module analysis),\n1396:      :lower lower,\n1397:      :loop nil,\n1398:      :ret nil,\n1399:      :exc nil,\n1400:      :class nil}))\n1401: \n1402: \n1403: (defn lower-module-body\n1404:   \"The module's statements as one node, before the runtime wrapper: what\n1405:    lowering goldens compare.\"\n1406:   [packet]\n1407:   (let [ctx (context packet)]\n1408:     (lower ctx (p/root (:pk ctx)))))\n1409: \n1410: \n1411: (defn lower-packet\n1412:   \"The complete program for one ok packet: the prelude, then the module\n1413:    body run by `py/run-module`, with tail calls marked. Its value is\n1414:    `{:py/out [...] :py/exception nil-or-{:type :args}}`.\"\n1415:   [packet]\n1416:   (u/mark-tails\n1417:     (u/then prelude/uast\n1418:             (app* 'py/run-module\n1419:                   (u/lam [globals-sym globals-fn-sym] (lower-module-body packet))))))\n1420: \n1421: \n1422: ;; =============================================================================\n1423: ;; The lowering stage\n1424: ;; =============================================================================\n1425: \n1426: (defn- diagnostic\n1427:   [unit data message]\n1428:   (merge {:yang.cst/unit unit, :message message}\n1429:          (select-keys data [:yang.python.antlr/diagnostic :rule :construct\n1430:                             :span :name])))\n1431: \n1432: \n1433: (defn lower-transform\n1434:   \"The lowering stage's transform: an ok packet becomes one program batch\n1435:    (datoms) on port `:program`; a packet that is not ok, or a lowering\n1436:    diagnostic, becomes one record on port `:diagnostics` and no program.\n1437:    Stateless.\"\n1438:   [state packet]\n1439:   (let [unit (:yang.cst/unit packet)]\n1440:     (if (= :yang.cst/ok (:yang.cst/outcome packet))\n1441:       (try\n1442:         [state [[:program (vec (vm/ast->datoms (lower-packet packet)))]]]\n1443:         ;; ClojureDart's ex-info type is not catchable by name portably;\n1444:         ;; anything without a diagnostic in its ex-data is rethrown below\n1445:         (catch #?(:cljd Object\n1446:                   :clj clojure.lang.ExceptionInfo\n1447:                   :cljs ExceptionInfo)\n1448:                e\n1449:           (if (:yang.python.antlr/diagnostic (ex-data e))\n1450:             [state [[:diagnostics (diagnostic unit (ex-data e) (ex-message e))]]]\n1451:             (throw e))))\n1452:       [state\n1453:        [[:diagnostics {:yang.cst/unit unit,\n1454:                        :yang.python.antlr/diagnostic\n1455:                        (keyword \"yang.python.antlr\"\n1456:                                 (name (:yang.cst/outcome packet))),\n1457:                        :errors (:yang.cst/errors packet)}]]])))\n1458: \n1459: \n1460: (defn open-stage\n1461:   \"A lowering stage reading CST packets from `cst-stream`, writing program\n1462:    batches to `program-stream` and diagnostics to `diagnostics-stream`.\"\n1463:   [cst-stream program-stream diagnostics-stream]\n1464:   (stage/open cst-stream\n1465:               {:program program-stream, :diagnostics diagnostics-stream}\n1466:               {}))\n1467: \n1468: \n1469: (defn step-stage\n1470:   [s]\n1471:   (stage/step s lower-transform))"}],"deferred":false}}
