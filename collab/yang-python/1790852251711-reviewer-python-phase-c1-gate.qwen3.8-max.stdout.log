{"type":"event","event":{"type":"tool_completed","toolCallId":"call_d47ac3b14a4f4d4181821601","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 258 lines\n259: (deftest assignment-order-golden-test\n260:   (testing \"the value is evaluated once, before any target, and targets are\n261:             assigned left to right\"\n262:     (let [src \"a[i] = b = v\\n\"\n263:           tmp (sym \"v\" src \"expr_stmt\")]\n264:       (is (= (u/then (u/let1 tmp (gget \"v\")\n265:                              (u/then (py 'py/setitem (gget \"a\") (gget \"i\") (u/v tmp))\n266:                                      (gset \"b\" (u/v tmp))))\n267:                      none)\n268:              (body src))))))\n269: \n270: \n271: (deftest try-finally-golden-test\n272:   (testing \"finally is a thunk of the exception in flight (or None) run by\n273:             py/try-finally on every exit\"\n274:     (let [src \"try:\\n    f()\\nfinally:\\n    g()\\n\"\n275:           fx (sym \"fx\" src \"try_stmt\")]\n276:       (is (= (u/then (py 'py/try-finally\n277:                          (u/lam [] (call (gget \"f\")))\n278:                          (u/lam [fx] (call (gget \"g\"))))\n279:                      none)\n280:              (body src))))))\n281: \n282: \n283: (deftest with-golden-test\n284:   (let [src \"with m as x:\\n    pass\\n\"\n285:         wv (sym \"wv\" src \"with_item\")]\n286:     (is (= (u/then (py 'py/with (gget \"m\")\n287:                        (u/lam [wv] (u/then (gset \"x\" (u/v wv)) none)))\n288:                    none)\n289:            (body src)))))\n290: \n291: \n292: (deftest unpacking-golden-test\n293:   (testing \"the value is bound once; py/unpack-star returns before-items, the\n294:             middle as a list, after-items; targets are assigned left to right\"\n295:     (let [src \"a, *b = v\\n\"\n296:           tmp (sym \"v\" src \"expr_stmt\")\n297:           un (sym \"u\" src \"testlist_star_expr\")]\n298:       (is (= (u/then (u/let1 tmp (gget \"v\")\n299:                              (u/let1 un (py 'py/unpack-star (u/v tmp) (u/lit 1) (u/lit 0))\n300:                                      (u/then (gset \"a\" (py 'py/arg (u/v un) (u/lit 0)))\n301:                                              (gset \"b\" (py 'py/arg (u/v un) (u/lit 1))))))\n302:                      none)\n303:              (body src))))))\n304: \n305: \n306: (deftest comprehension-golden-test\n307:   (testing \"the first iterable is evaluated outside; the target is a cell\n308:             local to the comprehension; the result is a fresh list\"\n309:     (let [src \"[x for x in y]\\n\"\n310:           fst (sym \"first\" src \"testlist_comp\")\n311:           acc (sym \"acc\" src \"testlist_comp\")\n312:           x (sym \"x\" src \"exprlist\")]\n313:       (is (= (u/then\n314:                (u/let1 fst (gget \"y\")\n315:                        (u/app (u/lam '[x]\n316:                                      (u/let1 acc (py 'py/list (u/lit []))\n317:                                              (u/then (py 'py/for-each (u/v fst)\n318:                                                          (u/lam [x]\n319:                                                                 (u/then (py 'cell/set! (u/v 'x) (u/v x))\n320:                                                                         (py 'py/list-append (u/v acc)\n321:                                                                             (local \"x\")))))\n322:                                                      (u/v acc))))\n323:                               (py 'cell/new (u/lit :py/unbound))))\n324:                none)\n325:              (body src))))))\n326: \n327: \n328: (deftest keyword-call-golden-test\n329:   (testing \"positional values and *splices build the argument vector in\n330:             order; keywords and **splices build the keyword pairs\"\n331:     (is (= (u/then (py 'py/call-kw (gget \"f\")\n332:                        (py 'py/extend (py 'py/conj (u/lit []) (u/lit 1)) (gget \"a\"))\n333:                        (py 'py/kw-extend\n334:                            (py 'py/conj (u/lit [])\n335:                                (py 'py/conj (py 'py/conj (u/lit []) (u/lit \"k\")) (u/lit 2)))\n336:                            (gget \"d\")))\n337:                    none)\n338:            (body \"f(1, *a, k=2, **d)\\n\")))))\n339: \n340: \n341: (deftest slice-and-power-golden-test\n342:   (testing \"a slice is a value; ** is regrouped to the right\"\n343:     (is (= (u/seq-nodes [(py 'py/getitem (gget \"x\") (py 'py/slice (u/lit 1) none none))\n344:                          (py 'py/pow (gget \"a\") (py 'py/pow (gget \"b\") (gget \"c\")))\n345:                          none])\n346:            (body \"x[1:]\\na ** b ** c\\n\")))))\n347: \n348: \n349: (deftest program-shape-test\n350:   (let [program (lower/lower-packet (parser/parse-source \"x = 1\\n\"))]\n351:     (testing \"prelude first, then the module run by py/run-module, with tail\n352:               calls marked\"\n353:       (is (= (u/mark-tails\n354:                (u/then prelude/uast\n355:                        (py 'py/run-module\n356:                            (u/lam '[%globals %globals-fn]\n357:                                   (u/then (gset \"x\" (u/lit 1)) none)))))\n358:              program)))\n359:     (testing \"yin/def appears only in the prelude\"\n360:       (is (not (re-find #\"yin/def\" (pr-str (-> program :operands second))))))\n361:     (testing \"the batch passes the Universal AST's own checks\"\n362:       (is (nil? (vm/ast-reserved-defect program)))\n363:       (is (vector? (vm/ast->datoms program))))))\n364: \n365: \n366: (deftest tail-marks-test\n367:   (let [program (u/mark-tails (u/lam [] (body \"while x:\\n    pass\\n\")))\n368:         loop-lam (-> program :body :operands first :operands first)\n369:         continue-app (:consequent (:body loop-lam))]\n370:     (is (true? (:tail? continue-app)) \"the sequencing application\")\n371:     (is (true? (-> continue-app :operator :body :tail?)) \"the recursive call\")\n372:     (is (not (:tail? (-> program :body :operands first)))\n373:         \"an application that is an operand is never a tail call\")))\n374: \n375: \n376: ;; =============================================================================\n377: ;; Refusals\n378: ;; =============================================================================\n379: \n380: (defn- refusal\n381:   [src]\n382:   (try (body src)\n383:        nil\n384:        (catch clojure.lang.ExceptionInfo e\n385:          (select-keys (ex-data e) [:yang.python.antlr/diagnostic :rule :construct]))))\n386: \n387: \n388: (deftest unsupported-constructs-are-qualified-test\n389:   (doseq [[src rule construct]\n390:           [[\"import os\\n\" \"import_stmt\" \"import\"]\n391:            [\"def g():\\n    yield 1\\n\" \"yield_stmt\" \"yield\"]\n392:            [\"x = (i for i in y)\\n\" \"atom\" \"generator expression (phase C2)\"]\n393:            [\"f(i for i in y)\\n\" \"argument\" \"generator expression (phase C2)\"]\n394:            [\"x = a @ b\\n\" \"expr\" \"operator @\"]\n395:            [\"x @= b\\n\" \"augassign\" \"augmented @=\"]\n396:            [\"def f(a: int): pass\\n\" \"tfpdef\" \"parameter annotation\"]\n397:            [\"a[1:2:3] = x\\n\" \"trailer\" \"extended slice assignment\"]\n398:            [\"x = a[1:2, 3]\\n\" \"trailer\" \"multi-dimensional slicing\"]\n399:            [\"x = {**d}\\n\" \"atom\" \"dict unpacking in a display\"]\n400:            [\"x = f'{a}'\\n\" \"atom\" \"f-string\"]\n401:            [\"x = 1 <> 2\\n\" \"comp_op\" \"comparison <>\"]\n402:            [\"class C(A, B): pass\\n\" \"classdef\" \"multiple inheritance\"]\n403:            [\"del x\\n\" \"del_stmt\" \"del statement\"]\n404:            [\"assert x\\n\" \"assert_stmt\" \"assert statement\"]]]\n405:     (testing src\n406:       (is (= {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n407:               :rule rule,\n408:               :construct construct}\n409:              (refusal src))))))\n410: \n411: \n412: (deftest static-flow-errors-test\n413:   (doseq [[src message]\n414:           [[\"break\\n\" \"'break' outside loop\"]\n415:            [\"continue\\n\" \"'continue' not properly in loop\"]\n416:            [\"return 1\\n\" \"'return' outside function\"]\n417:            [\"def f(a, a): pass\\n\" \"duplicate argument in function definition\"]\n418:            [\"def f(a=1, b): pass\\n\" \"non-default argument follows default argument\"]\n419:            [\"while x:\\n    def f():\\n        break\\n\"\n420:             \"'break' outside loop\"]\n421:            [\"x = '\\\\U00110000'\\n\" \"illegal Unicode character in \\\\U escape\"]\n422:            [\"a, *b, *c = x\\n\" \"multiple starred expressions in assignment\"]\n423:            [\"*a = x\\n\" \"starred assignment target must be in a list or tuple\"]\n424:            [\"f(a=1, a=2)\\n\" \"keyword argument repeated: a\"]\n425:            [\"f(a=1, 2)\\n\" \"positional argument follows keyword argument\"]\n426:            [\"def f(*, ): pass\\n\" \"named arguments must follow bare *\"]\n427:            [\"a, b += 1\\n\" \"illegal expression for augmented assignment\"]\n428:            [\"x = [*a for a in b]\\n\" \"iterable unpacking cannot be used in comprehension\"]\n429:            [\"x = *a\\n\" \"can't use starred expression here\"]]]\n430:     (testing src\n431:       (is (= message\n432:              (try (body src)\n433:                   nil\n434:                   (catch clojure.lang.ExceptionInfo e (ex-message e))))))))\n435: \n436: \n437: (deftest leading-zero-decimal-is-rejected-test\n438:   (testing \"0755 never reaches the lowering: the pinned lexer has no token\n439:             for it, so the parser emits a syntax-error packet (the lowering\n440:             also refuses such a literal, should a grammar ever pass one)\"\n441:     (is (= :yang.cst/syntax-error\n442:            (:yang.cst/outco