{"type":"event","event":{"type":"tool_completed","toolCallId":"call_2754e069fd63412e8d431c7f","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 351 lines\n1: (ns yang.python.antlr.scope\n2:   \"Python binding collection and scope analysis over a CST packet\n3:    (docs/design/yang.antlr.md §8.5: scope analysis precedes lowering).\n4: \n5:    A scope is opened by the module (`file_input`), `funcdef`, `lambdef`\n6:    (and `lambdef_nocond`), `classdef`, and every comprehension or generator\n7:    expression (the `testlist_comp`, `dictorsetmaker` or `argument` node\n8:    holding the `comp_for`), and keyed by that node's CST id. A\n9:    comprehension's first iterable belongs to the enclosing scope, as in\n10:    Python 3. For each scope:\n11: \n12:      :kind       :module | :function | :lambda | :class | :comprehension\n13:      :parent     enclosing scope id (nil for the module)\n14:      :params     parameter names in order\n15:      :assigned   names bound in the scope, in first-occurrence order\n16:      :globals    names declared `global`\n17:      :nonlocals  names declared `nonlocal`\n18:      :locals     function/lambda: params, then the other assigned names\n19:                  that are neither global nor nonlocal. class: the class\n20:                  namespace. module: none (module names are globals).\n21: \n22:    Binding occurrences: the names inside `=`, augmented-assignment, `for`,\n23:    comprehension `for` and `with ... as` targets (plain, tuple, list or\n24:    starred, however nested), `except ... as` names, and `def`/`class` names.\n25:    A nested scope's body is not scanned for the enclosing scope.\n26: \n27:    `resolve` answers, for a name read or written in a scope, one of\n28:      {:kind :cell}                     a function-local cell, reached by the\n29:                                        Python name in the lexical env\n30:      {:kind :global :declared? bool}   a module global; declared? when the\n31:                                        module binds it or some scope\n32:                                        declares it global\n33:      {:kind :class-attr :scope id}     the class namespace being built\n34:    and never consults anything but the analysis.\"\n35:   (:refer-clojure :exclude [resolve])\n36:   (:require\n37:     [yang.antlr.packet :as p]))\n38: \n39: \n40: (defn- syntax-error!\n41:   [message node data]\n42:   (throw (ex-info message\n43:                   (merge {:yang.python.antlr/diagnostic\n44:                           :yang.python.antlr/syntax,\n45:                           :span (:span node)}\n46:                          data))))\n47: \n48: \n49: (def ^:private chain-rules\n50:   \"Rules that wrap a single expression when they have one child.\"\n51:   #{\"testlist_star_expr\" \"testlist\" \"exprlist\" \"test\" \"or_test\" \"and_test\"\n52:     \"not_test\" \"comparison\" \"expr\" \"atom_expr\" \"atom\"})\n53: \n54: \n55: (defn simple-name\n56:   \"The identifier when `n` is nothing but a name, else nil.\"\n57:   [pk n]\n58:   (loop [n n]\n59:     (cond\n60:       (p/rule? n \"name\") (:text (first (p/children pk n)))\n61:       (and (p/rule? n)\n62:            (contains? chain-rules (:rule n))\n63:            (= 1 (count (:children n))))\n64:       (recur (first (p/children pk n)))\n65:       :else nil)))\n66: \n67: \n68: (defn- name-text\n69:   [pk name-node]\n70:   (:text (first (p/children pk name-node))))\n71: \n72: \n73: (def ^:private tuple-rules\n74:   \"Rules that are a tuple (or list) of targets when they hold several\n75:    elements or a trailing comma.\"\n76:   #{\"testlist_star_expr\" \"testlist\" \"exprlist\" \"testlist_comp\"})\n77: \n78: \n79: (defn target-names\n80:   \"Every name a binding target binds: a plain name, or the names inside a\n81:    tuple, list or starred target, however nested. Subscript and attribute\n82:    targets bind nothing.\"\n83:   [pk n]\n84:   (loop [n n]\n85:     (cond\n86:       (simple-name pk n) [(simple-name pk n)]\n87:       (p/rule? n \"star_expr\") (target-names pk (last (p/children pk n)))\n88:       (and (p/rule? n) (contains? tuple-rules (:rule n))\n89:            (or (< 1 (count (:children n))) (p/has-token? pk n \",\")))\n90:       (vec (mapcat #(target-names pk %) (filter p/rule? (p/children pk n))))\n91:       (and (p/rule? n \"atom\")\n92:            (or (p/token? (first (p/children pk n)) \"(\")\n93:                (p/token? (first (p/children pk n)) \"[\")))\n94:       (let [inner (second (p/children pk n))]\n95:         (if (p/rule? inner \"testlist_comp\")\n96:           (vec (mapcat #(target-names pk %) (filter p/rule? (p/children pk inner))))\n97:           []))\n98:       (and (p/rule? n) (= 1 (count (:children n))))\n99:       (recur (first (p/children pk n)))\n100:       :else [])))\n101: \n102: \n103: (defn comprehension?\n104:   \"True for the node a comprehension or generator expression scopes over:\n105:    a `testlist_comp`, `dictorsetmaker` or `argument` with a `comp_for`.\"\n106:   [pk n]\n107:   (and (p/rule? n)\n108:        (contains? #{\"testlist_comp\" \"dictorsetmaker\" \"argument\"} (:rule n))\n109:        (boolean (some #(p/rule? % \"comp_for\") (p/children pk n)))))\n110: \n111: \n112: (defn first-iterable\n113:   \"The iterable of a comprehension's first `for`: Python evaluates it in the\n114:    enclosing scope.\"\n115:   [pk comp-node]\n116:   (first (p/child-rules pk (first (p/child-rules pk comp-node \"comp_for\")) \"or_test\")))\n117: \n118: \n119: (defn- names-of-decl\n120:   \"The names a `global_stmt` or `nonlocal_stmt` declares.\"\n121:   [pk n]\n122:   (mapv #(name-text pk %) (p/child-rules pk n \"name\")))\n123: \n124: \n125: (defn params-of\n126:   \"Parameter names of a funcdef or lambdef node, in order. Shapes the\n127:    lowering rejects (defaults, stars, annotations) still contribute their\n128:    names here so the analysis is total.\"\n129:   [pk scope-node]\n130:   (let [arg-list (case (:rule scope-node)\n131:                    \"funcdef\" (first (p/child-rules\n132:                                       pk\n133:                                       (first (p/child-rules pk scope-node\n134:                                                             \"parameters\"))\n135:                                       \"typedargslist\"))\n136:                    (\"lambdef\" \"lambdef_nocond\")\n137:                    (first (p/child-rules pk scope-node \"varargslist\"))\n138:                    nil)]\n139:     (if arg-list\n140:       (mapv #(name-text pk (first (p/child-rules pk % \"name\")))\n141:             (filter #(or (p/rule? % \"tfpdef\") (p/rule? % \"vfpdef\"))\n142:                     (p/children pk arg-list)))\n143:       [])))\n144: \n145: \n146: (defn- expr-stmt-targets\n147:   [pk n]\n148:   (let [kids (p/children pk n)]\n149:     (cond\n150:       (some #(p/rule? % \"augassign\") kids) [(first kids)]\n151:       (some #(p/rule? % \"annassign\") kids) [(first kids)]\n152:       (some #(p/token? % \"=\") kids)\n153:       (let [sides (filterv #(not (p/token? % \"=\")) kids)]\n154:         (pop sides))\n155:       :else [])))\n156: \n157: \n158: (defn- collect\n159:   \"Bindings, declarations and nested scope nodes of one scope's body. When\n160:    the scope is itself a comprehension, `own` is its node: that node's\n161:    `comp_for` clauses bind here and its first iterable is skipped (it\n162:    belongs to the enclosing scope).\"\n163:   [pk body-nodes own]\n164:   (let [acc (volatile! {:assigned [], :globals [], :nonlocals [], :nested []})\n165:         bind! (fn [nm]\n166:                 (when nm\n167:                   (vswap! acc update :assigned\n168:                           #(if (some #{nm} %) % (conj % nm)))))\n169:         skip (when own (:id (first-iterable pk own)))]\n170:     (letfn [(walk\n171:               [n]\n172:               (when (and (p/rule? n) (not= skip (:id n)))\n173:                 (cond\n174:                   ;; a nested comprehension: its own scope, except that its\n175:                   ;; first iterable is evaluated here\n176:                   (and (comprehension? pk n) (not= (:id own) (:id n)))\n177:                   (do (vswap! acc update :nested conj n)\n178:                       (walk (first-iterable pk n)))\n179:                   :else\n180:                   (case (:rule n)\n181:                     (\"funcdef\" \"classdef\")\n182:                     (do (bind! (name-text pk (first (p/child-rules pk n \"name\"))))\n183:                         (vswap! acc update :nested conj n)\n184:                         ;; class bases are evaluated in the enclosing scope\n185:                         (when (= \"classdef\" (:rule n))\n186:                           (run! walk (p/child-rules pk n \"arglist\"))))\n187:                     (\"lambdef\" \"lambdef_nocond\") (vswap! acc update :nested conj n)\n188:                     \"global_stmt\" (vswap! acc update :globals into\n189:                                           (names-of-decl pk n))\n190:                     \"nonlocal_stmt\" (vswap! acc update :nonlocals into\n191:                                             (names-of-decl pk n))\n192:                     \"expr_stmt\" (do (run! #(run! bind! (target-names pk %))\n193:                                           (expr-stmt-targets pk n))\n194:                                     (run! walk (p/children pk n)))\n195:                     (\"for_stmt\" \"comp_for\")\n196:                     (do (run! bind! (target-names pk (first (p/child-rules pk n\n197:                                                                            \"exprlist\"))))\n198:                         (run! walk (p/children pk n)))\n199:                     \"with_item\" (do (when (p/has-token? pk n \"as\")\n200:                                       (run! bind! (target-names\n201:                                                     pk\n202:                                                     (last (p/children pk n)))))\n203:                                     (run! walk (p/children pk n)))\n204:                     \"except_clause\" (do (when (p/has-token? pk n \"as\")\n205:                                           (bind! (name-text\n206:                                                    pk\n207:                                                    (first (p/child-rules\n208:                                                             pk n \"name\")))))\n209:                                         (run! walk (p/children pk n)))\n210:                     (run! walk (p/children pk n))))))]\n211:       (run! walk body-nodes))\n212:     @acc))\n213: \n214: \n215: (defn- body-nodes\n216:   [pk scope-node]\n217:   (case (:rule scope-node)\n218:     \"file_input\" (p/children pk scope-node)\n219:     (\"funcdef\" \"classdef\") (p/child-rules pk scope-node \"block\")\n220:     \"lambdef\" (p/child-rules pk scope-node \"test\")\n221:     \"lambdef_nocond\" (p/child-rules pk scope-node \"test_nocond\")\n222:     ;; a comprehension: its elements and clauses (first iterable skipped)\n223:     (\"testlist_comp\" \"dictorsetmaker\" \"argument\") [scope-node]))\n224: \n225: \n226: (defn- scope-kind\n227:   [scope-node]\n228:   (case (:rule scope-node)\n229:     \"file_input\" :module\n230:     \"funcdef\" :function\n231:     (\"lambdef\" \"lambdef_nocond\") :lambda\n232:     \"classdef\" :class\n233:     (\"testlist_comp\" \"dictorsetmaker\" \"argument\") :comprehension))\n234: \n235: \n236: (defn- analyze-scope\n237:   \"Records for `scope-node` and every scope nested in it.\"\n238:   [pk scope-node parent-id]\n239:   (let [kind (scope-kind scope-node)\n240:         {:keys [assigned globals nonlocals nested]}\n241:         (collect pk (body-nodes pk scope-node)\n242:                  (when (= :comprehension kind) scope-node))\n243:         params (params-of pk scope-node)\n244:         global-set (set globals)\n245:         nonlocal-set (set nonlocals)\n246:         _ (when (and (= :module kind) (seq nonlocals))\n247:             (syntax-error! \"nonlocal declaration not allowed at module level\"\n248:                            scope-node\n249:                            {:names nonlocals}))\n250:         _ (doseq [nm params]\n251:             (when (contains? global-set nm)\n252:               (syntax-error! (str \"name '\" nm \"' is parameter and global\")\n253:                              scope-node\n254:                              {:name nm})))\n255:         _ (doseq [nm nonlocals]\n256:             (when (contains? global-set nm)\n257:               (syntax-error! (str \"name '\" nm \"' is nonlocal and global\")\n258:                              scope-node\n259:                              {:name nm})))\n260:         others (remove #(or (contains? global-set %)\n261:                             (contains? nonlocal-set %)\n262:                             (some #{%} params))\n263:                        assigned)\n264:         record {:id (:id scope-node),\n265:                 :kind kind,\n266:                 :parent parent-id,\n267:                 :params params,\n268:                 :assigned assigned,\n269:                 :globals global-set,\n270:                 :nonlocals nonlocal-set,\n271:                 :locals (case kind\n272:                           :module []\n273:                           :class (vec others)\n274:                           (into params others))}]\n275:     (reduce (fn [acc child]\n276:               (merge acc (analyze-scope pk child (:id scope-node))))\n277:             {(:id scope-node) record}\n278:             nested)))\n279: \n280: \n281: (defn- function-scope?\n282:   [s]\n283:   (contains? #{:function :lambda :comprehension} (:kind s)))\n284: \n285: \n286: (defn- enclosing-binding\n287:   \"Resolve a free `name` starting at scope `id`: class scopes are skipped,\n288:    the nearest function that binds it locally wins, and the module ends the\n289:    walk.\"\n290:   [scopes global-names id name]\n291:   (loop [id id]\n292:     (let [s (get scopes id)]\n293:       (cond\n294:         (= :module (:kind s)) {:kind :global,\n295:                                :declared? (contains? global-names name)}\n296:         (= :class (:kind s)) (recur (:parent s))\n297:         (contains? (:globals s) name) {:kind :global, :declared? true}\n298:         (contains? (:nonlocals s) name) (recur (:parent s))\n299:         (some #{name} (:locals s)) {:kind :cell}\n300:         :else (recur (:parent s))))))\n301: \n302: \n303: (defn resolve\n304:   \"How `name`, used in scope `scope-id`, is reached (see the ns doc).\"\n305:   [{:keys [scopes global-names]} scope-id name]\n306:   (let [s (get scopes scope-id)]\n307:     (case (:kind s)\n308:       :module {:kind :global, :declared? (contains? global-names name)}\n309:       :class (if (some #{name} (:locals s))\n310:                {:kind :class-attr, :scope scope-id}\n311:                (enclosing-binding scopes global-names (:parent s) name))\n312:       (cond\n313:         (contains? (:globals s) name) {:kind :global, :declared? true}\n314:         (contains? (:nonlocals s) name)\n315:         (enclosing-binding scopes global-names (:parent s) name)\n316:         (some #{name} (:locals s)) {:kind :cell}\n317:         :else (enclosing-binding scopes global-names (:parent s) name)))))\n318: \n319: \n320: (defn- check-nonlocals!\n321:   [pk {:keys [scopes], :as analysis}]\n322:   (doseq [[id s] (sort-by key scopes)\n323:           nm (sort (:nonlocals s))]\n324:     (let [r (enclosing-binding scopes (:global-names analysis) (:parent s) nm)]\n325:       (when-not (= :cell (:kind r))\n326:         (syntax-error! (str \"no binding for nonlocal '\" nm \"' found\")\n327:                        (p/node pk id)\n328:                        {:name nm}))))\n329:   analysis)\n330: \n331: \n332: (defn analyze\n333:   \"The scope analysis of a validated packet: `{:scopes {id record}\n334:    :global-names #{...} :module id}`.\"\n335:   [pk]\n336:   (let [root (p/root pk)\n337:         scopes (analyze-scope pk root nil)\n338:         module (get scopes (:id root))\n339:         global-names (into (set (:assigned module))\n340:                            (mapcat :globals (vals scopes)))]\n341:     (check-nonlocals! pk\n342:                       {:scopes scopes,\n343:                        :global-names global-names,\n344:                        :module (:id root)})))\n345: \n346: \n347: (defn function-scope-ids\n348:   \"Ids of function and lambda scopes, for tests and tooling.\"\n349:   [analysis]\n350:   (sort (keep (fn [[id s]] (when (function-scope? s) id))\n351:               (:scopes analysis))))"}],"deferred":false}}
