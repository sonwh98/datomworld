62:    definition time, in the enclosing context.\"\n963:   [ctx scope-node fname {:keys [params defaults star? kwonly kwdefaults kwstar?]}\n964:    body-fn]\n965:   (let [s (get-in (:analysis ctx) [:scopes (:id scope-node)])\n966:         all-params (:params s)\n967:         _ (when-not (= (count all-params) (count (distinct all-params)))\n968:             (syntax! scope-node \"duplicate argument in function definition\"))\n969:         args (gen \"args\" scope-node)\n970:         others (drop (count all-params) (:locals s))\n971:         body (body-fn (assoc ctx\n972:                              :scope (:id scope-node)\n973:                              :loop nil\n974:                              :exc nil\n975:                              :class nil))\n976:         cells (concat (map-indexed (fn [i _]\n977:                                      (app* 'cell/new\n978:                                            (app* 'py/arg (u/v args) (u/lit i))))\n979:                                    all-params)\n980:                       (map (fn [_] (app* 'cell/new (u/lit :py/unbound)))\n981:                            others))]\n982:     (app* 'py/make-function\n983:           (u/lit fname)\n984:           (u/lit (cond-> {:params params}\n985:                    star? (assoc :star? true)\n986:                    (seq kwonly) (assoc :kwonly kwonly)\n987:                    kwstar? (assoc :kwstar? true)))\n988:           (build-vector (map #((:lower ctx) ctx %) defaults))\n989:           (build-vector (map (fn [[nm d]]\n990:                                (build-vector [(u/lit nm) ((:lower ctx) ctx d)]))\n991:                              kwdefaults))\n992:           (u/lam [args]\n993:                  (if (seq (:locals s))\n994:                    (apply u/app (u/lam (map symbol (:locals s)) body) cells)\n995:                    body)))))\n996: \n997: \n998: (defn- lower-funcdef\n999:   [ctx n]\n1000:   (let [ks (kids ctx n)\n1001:         nm (name-of ctx (first (rules ctx n \"name\")))\n1002:         params (first (rules ctx n \"parameters\"))]\n1003:     (when (some #(p/token? % \"->\") ks) (unsupported! n \"return annotation\"))\n1004:     (assign-name\n1005:       ctx nm\n1006:       (function-value\n1007:         ctx n nm\n1008:         (param-spec ctx (first (rules ctx params \"typedargslist\")) \"tfpdef\")\n1009:         (fn [fctx]\n1010:           (let [block (first (rules ctx n \"block\"))]\n1011:             (if (contains-rule? ctx block \"return_stmt\" scope-rules)\n1012:               (let [ret (gen \"ret\" n)]\n1013:                 (app* 'py/call-ec\n1014:                       (u/lam [ret]\n1015:                              (u/seq-nodes\n1016:                                (conj (lower-block (assoc fctx :ret ret) block)\n1017:                                      none)))))\n1018:               (u/seq-nodes (conj (lower-block (assoc fctx :ret nil) block)\n1019:                                  none)))))))))\n1020: \n1021: \n1022: (defn- lower-lambdef\n1023:   \"`lambdef` and `lambdef_nocond` (a lambda inside a comprehension's `if`).\"\n1024:   [ctx n]\n1025:   (function-value ctx n \"<lambda>\"\n1026:                   (param-spec ctx (first (rules ctx n \"varargslist\")) \"vfpdef\")\n1027:                   (fn [fctx]\n1028:                     ((:lower ctx) (assoc fctx :ret nil) (peek (rule-kids ctx n))))))\n1029: \n1030: \n1031: (defn- lower-classdef\n1032:   [ctx n]\n1033:   (let [nm (name-of ctx (first (rules ctx n \"name\")))\n1034:         arglist (first (rules ctx n \"arglist\"))\n1035:         bases (if arglist (rules ctx arglist \"argument\") [])\n1036:         _ (when (> (count bases) 1) (unsupported! n \"multiple inheritance\"))\n1037:         base (if (seq bases)\n1038:                (let [ak (kids ctx (first bases))]\n1039:                  (when-not (and (= 1 (count ak)) (p/rule? (first ak) \"test\"))\n1040:                    (unsupported! n \"class keyword arguments\"))\n1041:                  ((:lower ctx) ctx (first ak)))\n1042:                (u/v 'py.b/object))\n1043:         cls (gen \"cls\" n)\n1044:         body (lower-block (assoc ctx\n1045:                                  :scope (:id n)\n1046:                                  :class cls\n1047:                                  :loop nil\n1048:                                  :ret nil\n1049:                                  :exc nil)\n1050:                           (first (rules ctx n \"block\")))]\n1051:     (u/let1 cls\n1052:             (app* 'py/make-class (u/lit nm) base)\n1053:             (u/seq-nodes (concat body [(assign-name ctx nm (u/v cls))])))))\n1054: \n1055: \n1056: ;; -----------------------------------------------------------------------------\n1057: ;; Control flow\n1058: ;; -----------------------------------------------------------------------------\n1059: \n1060: (defn- lower-if\n1061:   [ctx n]\n1062:   (let [tests (rules ctx n \"test\")\n1063:         blocks (rules ctx n \"block\")\n1064:         else-node (when (> (count blocks) (count tests))\n1065:                     (u/seq-nodes (lower-block ctx (peek blocks))))]\n1066:     (reduce (fn [alt [t b]]\n1067:               (u/if-node (truthy ((:lower ctx) ctx t))\n1068:                          (u/seq-nodes (lower-block ctx b))\n1069:                          alt))\n1070:             (or else-node none)\n1071:             (reverse (map vector tests blocks)))))\n1072: \n1073: \n1074: (defn- loop-body\n1075:   \"The loop body, run under a continue escape when it has a `continue`.\"\n1076:   [ctx body-block brk cont]\n1077:   (let [has-cont? (contains-rule? ctx body-block \"continue_stmt\"\n1078:                                   loop-and-scope-rules)\n1079:         body (u/seq-nodes (lower-block (assoc ctx\n1080:                                               :loop {:brk brk,\n1081:                                                      :cont (when has-cont? cont)})\n1082:                                        body-block))]\n1083:     (if has-cont?\n1084:       (app* 'py/call-ec (u/lam [cont] body))\n1085:       body)))\n1086: \n1087: \n1088: (defn- with-break\n1089:   [ctx body-block brk node]\n1090:   (if (contains-rule? ctx body-block \"break_stmt\" loop-and-scope-rules)\n1091:     (app* 'py/call-ec (u/lam [brk] node))\n1092:     node))\n1093: \n1094: \n1095: (defn- lower-while\n1096:   [ctx n]\n1097:   (let [[body-block else-block] (rules ctx n \"block\")\n1098:         brk (gen \"brk\" n)\n1099:         w (gen \"w\" n)\n1100:         body (loop-body ctx body-block brk (gen \"cont\" n))\n1101:         orelse (if else-block (u/seq-nodes (lower-block ctx else-block)) none)]\n1102:     (with-break ctx body-block brk\n1103:       (u/let1 w\n1104:               (u/lam [w]\n1105:                      (u/if-node (truthy ((:lower ctx) ctx\n1106:                                                       (first (rules ctx n \"test\"))))\n1107:                                 (u/then body (u/app (u/v w) (u/v w)))\n1108:                                 orelse))\n1109:               (u/app (u/v w) (u/v w))))))\n1110: \n1111: \n1112: (defn- lower-for\n1113:   [ctx n]\n1114:   (let [[body-block else-block] (rules ctx n \"block\")\n1115:         target (first (rules ctx n \"exprlist\"))\n1116:         brk (gen \"brk\" n)\n1117:         w (gen \"w\" n)\n1118:         it (gen \"it\" n)\n1119:         i (gen \"i\" n)\n1120:         x (gen \"x\" n)\n1121:         body (loop-body ctx body-block brk (gen \"cont\" n))\n1122:         orelse (if else-block (u/seq-nodes (lower-block ctx else-block)) none)]\n1123:     (with-break ctx body-block brk\n1124:       (u/let1 it\n1125:               (app* 'py/iterable (display ctx (first (rules ctx n \"testlist\"))))\n1126:               (u/let1 w\n1127:                       (u/lam [w i]\n1128:                              (u/let1 x\n1129:                                      (app* 'py/iter-at (u/v it) (u/v i))\n1130:                                      (u/if-node\n1131:                                        (app* '= (u/v x) (u/lit :py/stop))\n1132:                                        orelse\n1133:                                        (u/then (assign-target ctx target (u/v x))\n1134:                                                (u/then body\n1135:                                                        (u/app (u/v w) (u/v w)\n1136:                                                               (app* '+ (u/v i)\n1137:                                                                     (u/lit 1))))))))\n1138:                       (u/app (u/v w) (u/v w) (u/lit 0)))))))\n1139: \n1140: \n1141: (declare lower-try-except)\n1142: \n1143: \n1144: (defn- lower-try\n1145:   \"`try` with `except` clauses (`py/try`), with `finally` (`py/try-finally`\n1146:    around the rest), or both. The finally thunk takes the exception being\n1147:    raised through it, or None, and ignores it.\"\n1148:   [ctx n]\n1149:   (let [ks (kids ctx n)\n1150:         blocks (rules ctx n \"block\")]\n1151:     (if (some #(p/token? % \"finally\") ks)\n1152:       (app* 'py/try-finally\n1153:             (u/lam [] (if (seq (rules ctx n \"except_clause\"))\n1154:                         (lower-try-except ctx n (pop blocks))\n1155:                         (u/seq-nodes (lower-block ctx (first blocks)))))\n1156:             (u/lam [(gen \"fx\" n)] (u/seq-nodes (lower-block ctx (peek blocks)))))\n1157:       (lower-try-except ctx n blocks))))\n1158: \n1159: \n1160: (defn- lower-with\n1161:   \"`with a as x, b:` nests as `with a as x: with b:`; each item is\n1162:    `(py/with manager (fn [value] (assign target value) ...))`.\"\n1163:   [ctx n]\n1164:   (let [items (rules ctx n \"with_item\")\n1165:         body (u/seq-nodes (lower-block ctx (first (rules ctx n \"block\"))))]\n1166:     (reduce (fn [inner item]\n1167:               (let [ik (kids ctx item)\n1168:                     v (gen \"wv\" item)]\n1169:                 (app* 'py/with\n1170:                       ((:lower ctx) ctx (first ik))\n1171:                       (u/lam [v]\n1172:                              (if (p/has-token? (:pk ctx) item \"as\")\n1173:                                (u/then (assign-target ctx (last ik) (u/v v)) inner)\n1174:                                inner)))))\n1175:             body\n1176:             (reverse items))))\n1177: \n1178: \n1179: (defn- lower-try-except\n1180:   \"`try` with `except` clauses and an optional `else`: `blocks` are the try\n1181:    body, one block per clause, then the else block if any.\"\n1182:   [ctx n blocks]\n1183:   (let [exc (gen \"exc\" n)\n1184:         clauses (rules ctx n \"except_clause\")\n1185:         body (u/seq-nodes (lower-block ctx (first blocks)))\n1186:         handler-blocks (subvec blocks 1 (inc (count clauses)))\n1187:         else-block (get blocks (inc (count clauses)))\n1188:         hctx (assoc ctx :exc exc)\n1189:         dispatch\n1190:         (reduce\n1191:           (fn [fallthrough [clause block]]\n1192:             (let [ck (kids ctx clause)\n1193:                   cls-node (first (rules ctx clause \"test\"))\n1194:                   as-name (first (rules ctx clause \"name\"))\n1195:                   handler (u/seq-nodes\n1196:                             (concat (when as-name\n1197:                                       [(assign-name ctx (name-of ctx as-name)\n1198:                                                     (u/v exc))])\n1199:                                     (lower-block hctx block)))]\n1200:               (when (and (nil? cls-node) (> (count ck) 1))\n1201:                 (unsupported! clause \"except clause\"))\n1202:               (if cls-node\n1203:                 (u/if-node (app* 'py/isinstance (u/v exc)\n1204:                                  ((:lower ctx) ctx cls-node))\n1205:                            handler\n1206:                            fallthrough)\n1207:                 handler)))\n1208:           (app* 'py/raise (u/v exc))\n1209:           (reverse (map vector clauses handler-blocks)))]\n1210:     (app* 'py/try\n1211:           (u/lam [] body)\n1212:           (u/lam [exc] dispatch)\n1213:           (u/lam [] (if else-block\n1214:                       (u/seq-nodes (lower-block ctx else-block))\n1215:                       none)))))\n1216: \n1217: \n1218: (defn- lower-flow\n1219:   [ctx n]\n1220:   (case (:rule n)\n1221:     \"break_stmt\" (if-let [brk (get-in ctx [:loop :brk])]\n1222:                    (u/app (u/v brk) none)\n1223:                    (syntax! n \"'break' outside loop\"))\n1224:     \"continue_stmt\" (if (:loop ctx)\n1225:                       (u/app (u/v (get-in ctx [:loop :cont])) none)\n1226:                       (syntax! n \"'continue' not properly in loop\"))\n1227:     \"return_stmt\" (if-let [ret (:ret ctx)]\n1228:                     (u/app (u/v ret)\n1229:                            (if-let [value (first (rules ctx n \"testlist\"))]\n1230:                              (display ctx value)\n1231:                              none))\n1232:                     (syntax! n \"'return' outside function\"))\n1233:     \"raise_stmt\"\n1234:     (let [tests (rules ctx n \"test\")]\n1235:       (cond\n1236:         (p/has-token? (:pk ctx) n \"from\") (unsupported! n \"raise from\")\n1237:         (empty? tests) (if-let [exc (:exc ctx)]\n1238:                          (app* 'py/raise (u/v exc))\n1239:                          (unsupported! n \"bare raise outside except\"))\n1240:         :else (app* 'py/raise (app* 'py/as-exception\n1241:                                     ((:lower ctx) ctx (first tests))))))))\n1242: \n1243: \n1244: ;; -----------------------------------------------------------------------------\n1245: ;; Comprehensions\n1246: ;; -----------------------------------------------------------------------------\n1247: \n1248: (defn- comp-clauses\n1249:   \"A comprehension's clauses in order: `[:for target iterable]` and\n1250:    `[:if test]`.\"\n1251:   [ctx comp-node]\n1252:   (let [next-clause (fn [n]\n1253:                       (when-let [it (first (rules ctx n \"comp_iter\"))]\n1254:                         (first (rule-kids ctx it))))]\n1255:     (loop [n (first (rules ctx comp-node \"comp_for\"))\n1256:            acc []]\n1257:       (cond\n1258:         (nil? n) acc\n1259:         (p/rule? n \"comp_for\")\n1260:         (do (when (p/token? (first (kids ctx n)) \"async\")\n1261:               (unsupported! n \"async comprehension\"))\n1262:             (recur (next-clause n)\n1263:                    (conj acc [:for (first (rules ctx n \"exprlist\"))\n1264:                               (first (rules ctx n \"or_test\"))])))\n1265:         :else (recur (next-clause n)\n1266:                      (conj acc [:if (first (rules ctx n \"test_nocond\"))]))))))\n1267: \n1268: \n1269: (defn- lower-comprehension\n1270:   \"A list, set or dict comprehension (or a generator expression consumed\n1271:    eagerly, as a list) in its own scope: the first iterable is evaluated in\n1272:    the enclosing scope; the targets are cells local to the comprehension;\n1273:    each `for` walks with `py/for-each`, each `if` filters, and the\n1274:    innermost clause adds to a fresh result object.\"\n1275:   [ctx comp-node kind]\n1276:   (let [s (get-in (:analysis ctx) [:scopes (:id comp-node)])\n1277:         cctx (assoc ctx :scope (:id comp-node) :loop nil :ret nil :exc nil :class nil)\n1278:         clauses (comp-clauses ctx comp-node)\n1279:         elems (filterv #(not (p/rule? % \"comp_for\")) (rule-kids ctx comp-node))\n1280:         _ (when (some #(p/rule? % \"star_expr\") elems)\n1281:             (syntax! comp-node \"iterable unpacking cannot be used in comprehension\"))\n1282:         fst (gen \"first\" comp-node)\n1283:         acc (gen \"acc\" comp-node)\n1284:         lower (:lower ctx)\n1285:         emit (case kind\n1286:                :list (app* 'py/list-append (u/v acc) (lower cctx (first elems)))\n1287:                :set (app* 'py/set-add (u/v acc) (lower cctx (first elems)))\n1288:                :dict (app* 'py/dict-set (u/v acc) (lower cctx (first elems))\n1289:                            (lower cctx (second elems))))\n1290:         body (reduce (fn [inner [i [tag a b]]]\n1291:                        (if (= tag :for)\n1292:                          (let [x (gen \"x\" a)]\n1293:                            (app* 'py/for-each\n1294:                                  (if (zero? i) (u/v fst) (lower cctx b))\n1295:                                  (u/lam [x] (u/then (assign-target cctx a (u/v x))\n1296:                                                     inner))))\n1297:                          (u/if-node (truthy (lower cctx a)) inner none)))\n1298:                      emit\n1299:                      (reverse (map-indexed vector clauses)))\n1300:         result (u/let1 acc\n1301:                        (case kind\n1302:                          :list (app* 'py/list (u/lit []))\n1303:                          :set (app* 'py/set-new)\n1304:                          :dict (app* 'py/dict-new))\n1305:                        (u/then body (u/v acc)))]\n1306:     (u/let1 fst\n1307:             (lower ctx (nth (first clauses) 2))\n1308:             (if (seq (:locals s))\n1309:               (apply u/app\n1310:                      (u/lam (map symbol (:locals s)) result)\n1311:                      (map (fn [_] (app* 'cell/new (u/lit :py/unbound))) (:locals s)))\n1312:               result))))\n1313: \n1314: \n1315: ;; -----------------------------------------------------------------------------\n1316: ;; The one dispatch\n1317: ;; -----------------------------------------------------------------------------\n1318: \n1319: (defn- lower\n1320:   [ctx n]\n1321:   (case (:rule n)\n1322:     ;; ---- statements\n1323:     \"file_input\" (u/seq-nodes (conj (mapv #(lower ctx %)\n1324:                                           (rules ctx n \"stmt\"))\n1325:                                     none))\n1326:     \"stmt\" (lower ctx (first (kids ctx n)))\n1327:     \"simple_stmts\" (u/seq-nodes (mapv #(lower ctx %)\n1328:                                       (rules ctx n \"simple_stmt\")))\n1329:     \"simple_stmt\" (lower ctx (first (kids ctx n)))\n1330:     \"compound_stmt\" (lower ctx (first (kids ctx n)))\n1331:     \"flow_stmt\" (lower ctx (first (kids ctx n)))\n1332:     \"expr_stmt\" (lower-expr-stmt ctx n)\n1333:     \"pass_stmt\" none\n1334:     \"break_stmt\" (lower-flow ctx n)\n1335:     \"continue_stmt\" (lower-flow ctx n)\n1336:     \"return_stmt\" (lower-flow ctx n)\n1337:     \"raise_stmt\" (lower-flow ctx n)\n1338:     ;; declarations were consumed by scope analysis\n1339:     \"global_stmt\" none\n1340:     \"nonlocal_stmt\" none\n1341:     \"if_stmt\" (lower-if ctx n)\n1342:     \"while_stmt\" (lower-while ctx n)\n1343:     \"for_stmt\" (lower-for ctx n)\n1344:     \"try_stmt\" (lower-try ctx n)\n1345:     \"with_stmt\" (lower-with ctx n)\n1346:     \"funcdef\" (lower-funcdef ctx n)\n1347:     \"classdef\" (lower-classdef ctx n)\n1348:     ;; ---- expressions\n1349:     \"testlist_star_expr\" (display ctx n)\n1350:     \"testlist\" (display ctx n)\n1351:     \"exprlist\" (display ctx n)\n1352:     \"star_expr\" (syntax! n \"can't use starred expression here\")\n1353:     \"test_nocond\" (lower ctx (first (kids ctx n)))\n1354:     \"lambdef_nocond\" (lower-lambdef ctx n)\n1355:     \"test\" (let [ks (kids ctx n)]\n1356:              (if (= 1 (count ks))\n1357:                (lower ctx (first ks))\n1358:                (u/if-node (truthy (lower ctx (nth ks 2)))\n1359:                           (lower ctx (nth ks 0))\n1360:                           (lower ctx (nth ks 4)))))\n1361:     \"lambdef\" (lower-lambdef ctx n)\n1362:     \"or_test\" (fold-bool ctx n true)\n1363:     \"and_test\" (fold-bool ctx n false)\n1364:     \"not_test\" (let [ks (kids ctx n)]\n1365:                  (if (= 1 (count ks))\n1366:                    (lower ctx (first ks))\n1367:                    (app* 'py/not (lower ctx (second ks)))))\n1368:     \"comparison\" (lower-comparison ctx n)\n1369:     \"expr\" (lower-expr ctx n)\n1370:     \"atom_expr\" (lower-atom-expr ctx n)\n1371:     \"atom\" (lower-atom ctx n)\n1372:     \"name\" (read-name ctx n (name-of ctx n))\n1373:     (default-arm n)))\n1374: \n1375: \n1376: (defn- lower-block\n1377:   \"The statements of a `block` as a vector of nodes.\"\n1378:   [ctx block]\n1379:   (let [ks (kids ctx block)]\n1380:     (if (p/rule? (first ks) \"simple_stmts\")\n1381:       [(lower ctx (first ks))]\n1382:       (mapv #(lower ctx %) (rules ctx block \"stmt\")))))\n1383: \n1384: \n1385: ;; =============================================================================\n1386: ;; Packets\n1387: ;; =============================================================================\n1388: \n1389: (defn- context\n1390:   [packet]\n1391:   (let [pk (p/validate! packet)\n1392:         analysis (scope/analyze pk)]\n1393:     {:pk pk,\n1394:      :analysis analysis,\n1395:      :scope (:module analysis),\n1396:      :lower lower,\n1397:      :loop nil,\n1398:      :ret nil,\n1399:      :exc nil,\n1400:      :class nil}))\n1401: \n1402: \n1403: (defn lower-module-body\n1404:   \"The module's statements as one node, before the runtime wrapper: what\n1405:    lowering goldens compare.\"\n1406:   [packet]\n1407:   (let [ctx (context packet)]\n1408:     (lower ctx (p/root (:pk ctx)))))\n1409: \n1410: \n1411: (defn lower-packet\n1412:   \"The complete program for one ok packet: the prelude, then the module\n1413:    body run by `py/run-module`, with tail calls marked. Its value is\n1414:    `{:py/out [...] :py/exception nil-or-{:type :args}}`.\"\n1415:   [packet]\n1416:   (u/mark-tails\n1417:     (u/then prelude/uast\n1418:             (app* 'py/run-module\n1419:                   (u/lam [globals-sym globals-fn-sym] (lower-module-body packet))))))\n1420: \n1421: \n1422: ;; =============================================================================\n1423: ;; The lowering stage\n1424: ;; =============================================================================\n1425: \n1426: (defn- diagnostic\n1427:   [unit data message]\n1428:   (merge {:yang.cst/unit unit, :message message}\n1429:          (select-keys data [:yang.python.antlr/diagnostic :rule :construct\n1430:                             :span :name])))\n1431: \n1432: \n1433: (defn lower-transform\n1434:   \"The lowering stage's transform: an ok packet becomes one program batch\n1435:    (datoms) on port `:program`; a packet that is not ok, or a lowering\n1436:    diagnostic, becomes one record on port `:diagnostics` and no program.\n1437:    Stateless.\"\n1438:   [state packet]\n1439:   (let [unit (:yang.cst/unit packet)]\n1440:     (if (= :yang.cst/ok (:yang.cst/outcome packet))\n1441:       (try\n1442:         [state [[:program (vec (vm/ast->datoms (lower-packet packet)))]]]\n1443:         ;; ClojureDart's ex-info type is not catchable by name portably;\n1444:         ;; anything without a diagnostic in its ex-data is rethrown below\n1445:         (catch #?(:cljd Object\n1446:                   :clj clojure.lang.ExceptionInfo\n1447:                   :cljs ExceptionInfo)\n1448:                e\n1449:           (if (:yang.python.antlr/diagnostic (ex-data e))\n1450:             [state [[:diagnostics (diagnostic unit (ex-data e) (ex-message e))]]]\n1451:             (throw e))))\n1452:       [state\n1453:        [[:diagnostics {:yang.cst/unit unit,\n1454:                        :yang.python.antlr/diagnostic\n1455:                        (keyword \"yang.python.antlr\"\n1456:                                 (name (:yang.cst/outcome packet))),\n1457:                        :errors (:yang.cst/errors packet)}]]])))\n1458: \n1459: \n1460: (defn open-stage\n1461:   \"A lowering stage reading CST packets from `cst-stream`, writing program\n1462:    batches to `program-stream` and diagnostics to `diagnostics-stream`.\"\n1463:   [cst-stream program-stream diagnostics-stream]\n1464:   (stage/open cst-stream\n1465:               {:program program-stream, :diagnostics diagnostics-stream}\n1466:               {}))\n1467: \n1468: \n1469: (defn step-stage\n1470:   [s]\n1471:   (stage/step s lower-transform))"}]}],"meta":{"source":"tool","messageId":"cb7fd6cd-cc26-474d-8718-dc2bcf6530dc"}},{"role":"assistant","content":[{"type":"thinking","thinking":"Next, I'll read scope.cljc and render.cljc (the smaller files), and the e2e_c1 tests. Also, for context, I'll check uast.cljc as well.","signature":""},{"type":"text","text":"Now scope.cljc and render.cljc.\n\n"},{"type":"tool_use","id":"call_2754e069fd63412e8d431c7f","name":"read_file","input":{"file_path":"/Users/sto/workspace/datomworld-py-c1/src/cljc/yang/python/antlr/scope.cljc"}}],"meta":{"source":"model","createdAt":1790852758277,"messageId":"0bba0aed-10bc-471f-81b9-0f77079ce252"}},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_2754e069fd63412e8d431c7f","content":[{"type":"text","text":"Read 1/1 file, 351 lines\n1: (ns yang.python.antlr.scope\n2:   \"Python binding collection and scope analysis over a CST packet\n3:    (docs/design/yang.antlr.md §8.5: scope analysis precedes lowering).\n4: \n5:    A scope is opened by the module (`file_input`), `funcdef`, `lambdef`\n6:    (and `lambdef_nocond`), `classdef`, and every comprehension or generator\n7:    expression (the `testlist_comp`, `dictorsetmaker` or `argument` node\n8:    holding the `comp_for`), and keyed by that node's CST id. A\n9:    comprehension's first iterable belongs to the enclosing scope, as in\n10:    Python 3. For each scope:\n11: \n12:      :kind       :module | :function | :lambda | :class | :comprehension\n13:      :parent     enclosing scope id (nil for the module)\n14:      :params     parameter names in order\n15:      :assigned   names bound in the scope, in first-occurrence order\n16:      :globals    names declared `global`\n17:      :nonlocals  names declared `nonlocal`\n18:      :locals     function/lambda: params, then the other assigned names\n19:                  that are neither global nor nonlocal. class: the class\n20:                  namespace. module: none (module names are globals).\n21: \n22:    Binding occurrences: the names inside `=`, augmented-assignment, `for`,\n23:    comprehension `for` and `with ... as` targets (plain, tuple, list or\n24:    starred, however nested), `except ... as` names, and `def`/`class` names.\n25:    A nested scope's body is not scanned for the enclosing scope.\n26: \n27:    `resolve` answers, for a name read or written in a scope, one of\n28:      {:kind :cell}                     a function-local cell, reached by the\n29:                                        Python name in the lexical env\n30:      {:kind :global :declared? bool}   a module global; declared? when the\n31:                                        module binds it or some scope\n32:                                        declares it global\n33:      {:kind :class-attr :scope id}     the class namespace being built\n34:    and never consults anything but the analysis.\"\n35:   (:refer-clojure :exclude [resolve])\n36:   (:require\n37:     [yang.antlr.packet :as p]))\n38: \n39: \n40: (defn- syntax-error!\n41:   [message node data]\n42:   (throw (ex-info message\n43:                   (merge {:yang.python.antlr/diagnostic\n44:                           :yang.python.antlr/syntax,\n45:                           :span (:span node)}\n46:                          data))))\n47: \n48: \n49: (def ^:private chain-rules\n50:   \"Rules that wrap a single expression when they have one child.\"\n51:   #{\"testlist_star_expr\" \"testlist\" \"exprlist\" \"test\" \"or_test\" \"and_test\"\n52:     \"not_test\" \"comparison\" \"expr\" \"atom_expr\" \"atom\"})\n53: \n54: \n55: (defn simple-name\n56:   \"The identifier when `n` is nothing but a name, else nil.\"\n57:   [pk n]\n58:   (loop [n n]\n59:     (cond\n60:       (p/rule? n \"name\") (:text (first (p/children pk n)))\n61:       (and (p/rule? n)\n62:            (contains? chain-rules (:rule n))\n63:            (= 1 (count (:children n))))\n64:       (recur (first (p/children pk n)))\n65:       :else nil)))\n66: \n67: \n68: (defn- name-text\n69:   [pk name-node]\n70:   (:text (first (p/children pk name-node))))\n71: \n72: \n73: (def ^:private tuple-rules\n74:   \"Rules that are a tuple (or list) of targets when they hold several\n75:    elements or a trailing comma.\"\n76:   #{\"testlist_star_expr\" \"testlist\" \"exprlist\" \"testlist_comp\"})\n77: \n78: \n79: (defn target-names\n80:   \"Every name a binding target binds: a plain name, or the names inside a\n81:    tuple, list or starred target, however nested. Subscript and attribute\n82:    targets bind nothing.\"\n83:   [pk n]\n84:   (loop [n n]\n85:     (cond\n86:       (simple-name pk n) [(simple-name pk n)]\n87:       (p/rule? n \"star_expr\") (target-names pk (last (p/children pk n)))\n88:       (and (p/rule? n) (contains? tuple-rules (:rule n))\n89:            (or (< 1 (count (:children n))) (p/has-token? pk n \",\")))\n90:       (vec (mapcat #(target-names pk %) (filter p/rule? (p/children pk n))))\n91:       (and (p/rule? n \"atom\")\n92:            (or (p/token? (first (p/children pk n)) \"(\")\n93:                (p/token? (first (p/children pk n)) \"[\")))\n94:       (let [inner (second (p/children pk n))]\n95:         (if (p/rule? inner \"testlist_comp\")\n96:           (vec (mapcat #(target-names pk %) (filter p/rule? (p/children pk inner))))\n97:           []))\n98:       (and (p/rule? n) (= 1 (count (:children n))))\n99:       (recur (first (p/children pk n)))\n100:       :else [])))\n101: \n102: \n103: (defn comprehension?\n104:   \"True for the node a comprehension or generator expression scopes over:\n105:    a `testlist_comp`, `dictorsetmaker` or `argument` with a `comp_for`.\"\n106:   [pk n]\n107:   (and (p/rule? n)\n108:        (contains? #{\"testlist_comp\" \"dictorsetmaker\" \"argument\"} (:rule n))\n109:        (boolean (some #(p/rule? % \"comp_for\") (p/children pk n)))))\n110: \n111: \n112: (defn first-iterable\n113:   \"The iterable of a comprehension's first `for`: Python evaluates it in the\n114:    enclosing scope.\"\n115:   [pk comp-node]\n116:   (first (p/child-rules pk (first (p/child-rules pk comp-node \"comp_for\")) \"or_test\")))\n117: \n118: \n119: (defn- names-of-decl\n120:   \"The names a `global_stmt` or `nonlocal_stmt` declares.\"\n121:   [pk n]\n122:   (mapv #(name-text pk %) (p/child-rules pk n \"name\")))\n123: \n124: \n125: (defn params-of\n126:   \"Parameter names of a funcdef or lambdef node, in order. Shapes the\n127:    lowering rejects (defaults, stars, annotations) still contribute their\n128:    names here so the analysis is total.\"\n129:   [pk scope-node]\n130:   (let [arg-list (case (:rule scope-node)\n131:                    \"funcdef\" (first (p/child-rules\n132:                                       pk\n133:                                       (first (p/child-rules pk scope-node\n134:                                                             \"parameters\"))\n135:                                       \"typedargslist\"))\n136:                    (\"lambdef\" \"lambdef_nocond\")\n137:                    (first (p/child-rules pk scope-node \"varargslist\"))\n138:                    nil)]\n139:     (if arg-list\n140:       (mapv #(name-text pk (first (p/child-rules pk % \"name\")))\n141:             (filter #(or (p/rule? % \"tfpdef\") (p/rule? % \"vfpdef\"))\n142:                     (p/children pk arg-list)))\n143:       [])))\n144: \n145: \n146: (defn- expr-stmt-targets\n147:   [pk n]\n148:   (let [kids (p/children pk n)]\n149:     (cond\n150:       (some #(p/rule? % \"augassign\") kids) [(first kids)]\n151:       (some #(p/rule? % \"annassign\") kids) [(first kids)]\n152:       (some #(p/token? % \"=\") kids)\n153:       (let [sides (filterv #(not (p/token? % \"=\")) kids)]\n154:         (pop sides))\n155:       :else [])))\n156: \n157: \n158: (defn- collect\n159:   \"Bindings, declarations and nested scope nodes of one scope's body. When\n160:    the scope is itself a comprehension, `own` is its node: that node's\n161:    `comp_for` clauses bind here and its first iterable is skipped (it\n162:    belongs to the enclosing scope).\"\n163:   [pk body-nodes own]\n164:   (let [acc (volatile! {:assigned [], :globals [], :nonlocals [], :nested []})\n165:         bind! (fn [nm]\n166:                 (when nm\n167:                   (vswap! acc update :assigned\n168:                           #(if (some #{nm} %) % (conj % nm)))))\n169:         skip (when own (:id (first-iterable pk own)))]\n170:     (letfn [(walk\n171:               [n]\n172:               (when (and (p/rule? n) (not= skip (:id n)))\n173:                 (cond\n174:                   ;; a nested comprehension: its own scope, except that its\n175:                   ;; first iterable is evaluated here\n176:                   (and (comprehension? pk n) (not= (:id own) (:id n)))\n177:                   (do (vswap! acc update :nested conj n)\n178:                       (walk (first-iterable pk n)))\n179:                   :else\n180:                   (case (:rule n)\n181:                     (\"funcdef\" \"classdef\")\n182:                     (do (bind! (name-text pk (first (p/child-rules pk n \"name\"))))\n183:                         (vswap! acc update :nested conj n)\n184:                         ;; class bases are evaluated in the enclosing scope\n185:                         (when (= \"classdef\" (:rule n))\n186:                           (run! walk (p/child-rules pk n \"arglist\"))))\n187:                     (\"lambdef\" \"lambdef_nocond\") (vswap! acc update :nested conj n)\n188:                     \"global_stmt\" (vswap! acc update :globals into\n189:                                           (names-of-decl pk n))\n190:                     \"nonlocal_stmt\" (vswap! acc update :nonlocals into\n191:                                             (names-of-decl pk n))\n192:                     \"expr_stmt\" (do (run! #(run! bind! (target-names pk %))\n193:                                           (expr-stmt-targets pk n))\n194:                                     (run! walk (p/children pk n)))\n195:                     (\"for_stmt\" \"comp_for\")\n196:                     (do (run! bind! (target-names pk (first (p/child-rules pk n\n197:                                                                            \"exprlist\"))))\n198:                         (run! walk (p/children pk n)))\n199:                     \"with_item\" (do (when (p/has-token? pk n \"as\")\n200:                                       (run! bind! (target-names\n201:                                                     pk\n202:                                                     (last (p/children pk n)))))\n203:                                     (run! walk (p/children pk n)))\n204:                     \"except_clause\" (do (when (p/has-token? pk n \"as\")\n205:                                           (bind! (name-text\n206:                                                    pk\n207:                                                    (first (p/child-rules\n208:                                                             pk n \"name\")))))\n209:                                         (run! walk (p/children pk n)))\n210:                     (run! walk (p/children pk n))))))]\n211:       (run! walk body-nodes))\n212:     @acc))\n213: \n214: \n215: (defn- body-nodes\n216:   [pk scope-node]\n217:   (case (:rule scope-node)\n218:     \"file_input\" (p/children pk scope-node)\n219:     (\"funcdef\" \"classdef\") (p/child-rules pk scope-node \"block\")\n220:     \"lambdef\" (p/child-rules pk scope-node \"test\")\n221:     \"lambdef_nocond\" (p/child-rules pk scope-node \"test_nocond\")\n222:     ;; a comprehension: its elements and clauses (first iterable skipped)\n223:     (\"testlist_comp\" \"dictorsetmaker\" \"argument\") [scope-node]))\n224: \n225: \n226: (defn- scope-kind\n227:   [scope-node]\n228:   (case (:rule scope-node)\n229:     \"file_input\" :module\n230:     \"funcdef\" :function\n231:     (\"lambdef\" \"lambdef_nocond\") :lambda\n232:     \"classdef\" :class\n233:     (\"testlist_comp\" \"dictorsetmaker\" \"argument\") :comprehension))\n234: \n235: \n236: (defn- analyze-scope\n237:   \"Records for `scope-node` and every scope nested in it.\"\n238:   [pk scope-node parent-id]\n239:   (let [kind (scope-kind scope-node)\n240:         {:keys [assigned globals nonlocals nested]}\n241:         (collect pk (body-nodes pk scope-node)\n242:                  (when (= :comprehension kind) scope-node))\n243:         params (params-of pk scope-node)\n244:         global-set (set globals)\n245:         nonlocal-set (set nonlocals)\n246:         _ (when (and (= :module kind) (seq nonlocals))\n247:             (syntax-error! \"nonlocal declaration not allowed at module level\"\n248:                            scope-node\n249:                            {:names nonlocals}))\n250:         _ (doseq [nm params]\n251:             (when (contains? global-set nm)\n252:               (syntax-error! (str \"name '\" nm \"' is parameter and global\")\n253:                              scope-node\n254:                              {:name nm})))\n255:         _ (doseq [nm nonlocals]\n256:             (when (contains? global-set nm)\n257:               (syntax-error! (str \"name '\" nm \"' is nonlocal and global\")\n258:                              scope-node\n259:                              {:name nm})))\n260:         others (remove #(or (contains? global-set %)\n261:                             (contains? nonlocal-set %)\n262:                             (some #{%} params))\n263:                        assigned)\n264:         record {:id (:id scope-node),\n265:                 :kind kind,\n266:                 :parent parent-id,\n267:                 :params params,\n268:                 :assigned assigned,\n269:                 :globals global-set,\n270:                 :nonlocals nonlocal-set,\n271:                 :locals (case kind\n272:                           :module []\n273:                           :class (vec others)\n274:                           (into params others))}]\n275:     (reduce (fn [acc child]\n276:               (merge acc (analyze-scope pk child (:id scope-node))))\n277:             {(:id scope-node) record}\n278:             nested)))\n279: \n280: \n281: (defn- function-scope?\n282:   [s]\n283:   (contains? #{:function :lambda :comprehension} (:kind s)))\n284: \n285: \n286: (defn- enclosing-binding\n287:   \"Resolve a free `name` starting at scope `id`: class scopes are skipped,\n288:    the nearest function that binds it locally wins, and the module ends the\n289:    walk.\"\n290:   [scopes global-names id name]\n291:   (loop [id id]\n292:     (let [s (get scopes id)]\n293:       (cond\n294:         (= :module (:kind s)) {:kind :global,\n295:                                :declared? (contains? global-names name)}\n296:         (= :class (:kind s)) (recur (:parent s))\n297:         (contains? (:globals s) name) {:kind :global, :declared? true}\n298:         (contains? (:nonlocals s) name) (recur (:parent s))\n299:         (some #{name} (:locals s)) {:kind :cell}\n300:         :else (recur (:parent s))))))\n301: \n302: \n303: (defn resolve\n304:   \"How `name`, used in scope `scope-id`, is reached (see the ns doc).\"\n305:   [{:keys [scopes global-names]} scope-id name]\n306:   (let [s (get scopes scope-id)]\n307:     (case (:kind s)\n308:       :module {:kind :global, :declared? (contains? global-names name)}\n309:       :class (if (some #{name} (:locals s))\n310:                {:kind :class-attr, :scope scope-id}\n311:                (enclosing-binding scopes global-names (:parent s) name))\n312:       (cond\n313:         (contains? (:globals s) name) {:kind :global, :declared? true}\n314:         (contains? (:nonlocals s) name)\n315:         (enclosing-binding scopes global-names (:parent s) name)\n316:         (some #{name} (:locals s)) {:kind :cell}\n317:         :else (enclosing-binding scopes global-names (:parent s) name)))))\n318: \n319: \n320: (defn- check-nonlocals!\n321:   [pk {:keys [scopes], :as analysis}]\n322:   (doseq [[id s] (sort-by key scopes)\n323:           nm (sort (:nonlocals s))]\n324:     (let [r (enclosing-binding scopes (:global-names analysis) (:parent s) nm)]\n325:       (when-not (= :cell (:kind r))\n326:         (syntax-error! (str \"no binding for nonlocal '\" nm \"' found\")\n327:                        (p/node pk id)\n328:                        {:name nm}))))\n329:   analysis)\n330: \n331: \n332: (defn analyze\n333:   \"The scope analysis of a validated packet: `{:scopes {id record}\n334:    :global-names #{...} :module id}`.\"\n335:   [pk]\n336:   (let [root (p/root pk)\n337:         scopes (analyze-scope pk root nil)\n338:         module (get scopes (:id root))\n339:         global-names (into (set (:assigned module))\n340:                            (mapcat :globals (vals scopes)))]\n341:     (check-nonlocals! pk\n342:                       {:scopes scopes,\n343:                        :global-names global-names,\n344:                        :module (:id root)})))\n345: \n346: \n347: (defn function-scope-ids\n348:   \"Ids of function and lambda scopes, for tests and tooling.\"\n349:   [analysis]\n350:   (sort (keep (fn [[id s]] (when (function-scope? s) id))\n351:               (:scopes analysis))))"}]}],"meta":{"source":"tool","messageId":"c62dbd63-11a7-42ce-b78c-fcf0fd934965"}},{"role":"assistant","content":[{"type":"thinking","thinking":"scope.cljc looks fine. Notes:\n\n- `check-nonlocals!` iterates over `(sort-by key scopes)` — scopes is a host map keyed by node IDs (numeric?). sort-by key on numeric IDs → deterministic. OK.\n- `analyze` iterates over `(vals scopes)` via mapcat :globals to build global-n