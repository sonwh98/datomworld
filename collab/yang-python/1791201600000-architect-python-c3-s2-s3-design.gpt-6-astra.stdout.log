(defn- bits
  [b]
  (host/magnitude-bit-length b))


(defn- out
  "Big integer result `b` in its canonical carrier, or `::bit-limit`."
  [limits b]
  (if (> (bits b) (::max-bits limits))
    ::bit-limit
    (host/demote b)))


(defn- pair
  "`[q r]`, or the first of them that is a limit reason."
  [q r]
  (cond (keyword? q) q
        (keyword? r) r
        :else [q r]))


