  [limits a b]
  (out limits (host/add (big! 'add 0 a) (big! 'add 1 b))))


(defn- int-sub
  [limits a b]
  (out limits (host/sub (big! 'sub 0 a) (big! 'sub 1 b))))


(defn- int-neg
  [limits a]
  (out limits (host/sub zero (big! 'neg 0 a))))


