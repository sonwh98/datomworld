    [yang.python.antlr.prelude :as p]
    [yang.python.antlr.uast :as u]))

(defn definition [key]
  (second (first (filter #(= key (first %)) p/function-definitions))))

(def mutations
  [[\"floor versus truncation\" 'py/floordiv
    '(fn [a b]
       (let [q (get (py/divmod-values a b) 0)]
         (if (if (< (integer/compare (py/num a) 0) 0)
                 (> (integer/compare (py/num b) 0) 0) false)
           (py/int-result (integer/add q 1)) q)))]
   [\"remainder sign\" 'py/mod
    '(fn [a b]
       (py/abs (get (py/int-result
                     (integer/floor-div-mod (py/num a) (py/num b))) 1)))]
   [\"divmod tuple order\" 'py/divmod
    '(fn [a b]
       (let [qr (py/divmod-values a b)]
         (py/tuple (py/conj (py/conj [] (get qr 1)) (get qr 0)))))]
   [\"zero division precheck\" 'py/division-check
    '(fn [a b] true)]
   [\"negative exponent path\" 'py/pow
    (walk/postwalk-replace
      {'(integer/compare e 0) 0}
      (definition 'py/pow))]
   [\"true division single rounding\" 'py/truediv
    '(fn [a b]
       (if (py/zero? b)
         (py/raise-new py.b/ZeroDivisionError {:py/str \"division by zero\"})
         (py/float (/ (py/as-float a) (py/as-float b)))))]])

(deftest intentional-mutations
  (doseq [[name key form] mutations]
    (println \"MUTATION\" name)
    (let [ast (u/seq-nodes
                (map (fn [[k f]]
                       (u/def"'! k (u/sexp->uast (if (= k key) form f))))
                     p/function-definitions))]
      (with-redefs [p/uast
                    (u/then ast
                            (u/seq-nodes
                              (map (fn [[k f]] (u/def! k (u/sexp->uast f)))
                                   @#'"'p/state-definitions)))]
        (t/test-vars [#'ops/exact-division-power-test])))))
