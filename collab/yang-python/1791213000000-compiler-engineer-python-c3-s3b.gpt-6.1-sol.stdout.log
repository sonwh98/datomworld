(def ^:private exact (integer/integer-module e2e/integer-limits))


(defn- source-value
  [v]
  (cond
    (nil? v) "None"
    (true? v) "True"
    (false? v) "False"
    (:int v) (let [hex (:int v)]
               (if (str/starts-with? hex "-")
                 (str "-0x" (subs hex 1)) (str "0x" hex)))
    :else (let [x (double (:py/float v))]
            (cond
