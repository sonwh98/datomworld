{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"head -55 test/yang/php/antlr/prelude_test.cljc; cat test/yang/php/antlr/cst_test.clj | head -90; rg -n ':yang.cst/(tokens|source|diagnostics)' src/cljs/yang/antlr/cst.cljs src/clj/yang/antlr/cst.clj; cat /tmp/nightly-node-manifest.edn 2>/dev/null | head -c 90; tail -20 target/nightly-dht-repro.log; tail -15 target/nightly-node-build.log\"","aggregated_output":"(ns yang.php.antlr.prelude-test\n  \"The PHP prelude's static contract on every host: the bundled program is\n   closed over its own definitions, the declared host names and the\n   primitives; it never reaches `dao.host.*`; the lowered program names no\n   runtime key; the module emitter's exports and manifest cover the same\n   list.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.walk :as walk]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.portable-harness :as h]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]))\n\n\n(def ^:private closed-names\n  (into (conj (prelude/defined-keys prelude/uast) 'yin/def)\n        (concat prelude/host-names (keys vm/primitives))))\n\n\n(deftest bundled-prelude-is-closed-test\n  (is (empty? (remove closed-names (prelude/free-names prelude/uast)))))\n\n\n(deftest prelude-reaches-no-dao-host-test\n  (is (not-any? #(str/starts-with? (str %) \"dao.host\") (prelude/free-names prelude/uast)))\n  (is (every? #(contains? #{\"cell\" \"data\" \"integer\"} (namespace %))\n              prelude/host-names)))\n\n\n(deftest lowered-program-names-no-runtime-key-test\n  (doseq [[id form] packets/forms\n          :let [free (prelude/free-names (lower/lower-module-body (h/packet form)))]]\n    (is (empty? (remove closed-names free)) (name id))\n    (is (not-any? #(= \"php.rt\" (namespace %)) free) (name id))))\n\n\n(deftest module-exports-cover-the-definitions-test\n  (is (contains? prelude/module-exports 'init!))\n  (is (contains? prelude/module-exports 'echo))\n  (is (not-any? #(= \"php.rt\" (namespace %)) prelude/module-exports))\n  (is (every? symbol? prelude/runtime-keys)))\n\n\n(deftest admit-refuses-a-registry-without-the-host-names-test\n  (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs ExceptionInfo :cljd Object)\n        (prelude/admit {}))))\n\n\n(deftest module-spec-declares-every-free-name-test\n  (testing \"over the real host registry the manifest builds, or refuses\"\n    (let [spec (prelude/module-spec (h/host-registry) :test/call-address)]\n(ns yang.php.antlr.cst-test\n  \"P0: PHP CST export. Sources are ASCII, so a byte span is a string span.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.antlr.packet :as packet]\n    [yang.php.antlr.cst :as cst]))\n\n\n(defn- tokens\n  [pk]\n  (filterv #(= :token (:kind %)) (:yang.cst/nodes pk)))\n\n\n(defn- real-tokens\n  [pk]\n  (remove :synthetic (tokens pk)))\n\n\n(defn- parse\n  \"The validated ok packet for `src`, whose real tokens are in source order\n   and whose every span reads back as exactly the token's text.\"\n  [src]\n  (let [pk (cst/parse-source src)]\n    (is (= :yang.cst/ok (:yang.cst/outcome pk)) (pr-str src))\n    (is (some? (packet/validate! pk)))\n    (doseq [{:keys [text span type]} (real-tokens pk)\n            :let [[a b] span]]\n      (is (= text (subs src a b)) (str type \" span \" span)))\n    (is (apply <= 0 (mapcat :span (real-tokens pk))) \"spans ascend\")\n    (is (= [(count src) (count src)] (:span (peek (tokens pk)))) \"EOF\")\n    pk))\n\n\n(defn- typed\n  [pk type]\n  (filterv #(= type (:type %)) (tokens pk)))\n\n\n(deftest inline-html-and-tags-test\n  (let [src \"a <?php echo 1; ?>b <?= $x ?>c\"\n        pk (parse src)]\n    (is (= [\"a \" \"b \" \"c\"] (mapv :text (typed pk \"HtmlText\"))))\n    (is (= [[0 2] [18 20] [29 30]] (mapv :span (typed pk \"HtmlText\"))))\n    (is (= [\"echo\" \"<?=\"] (mapv :text (typed pk \"Echo\"))))\n    (is (= [\"?>\" \"?>\"] (mapv :text (filter #(= \"?>\" (:text %))\n                                           (typed pk \"SemiColon\")))))))\n\n\n(deftest heredoc-test\n  (let [src \"<?php\\n$a = <<<EOF\\n  hi $n\\n  EOF;\\n\"\n        pk (parse src)]\n    (is (= \"<<<EOF\" (:text (first (typed pk \"StartHereDoc\")))))\n    (is (= \"  hi $n\\n\" (:text (second (typed pk \"HereDocText\")))))\n    (testing \"the end identifier and the `;` are real tokens over their own source\"\n      (is (= [\"  EOF\" [26 31]]\n             ((juxt :text :span) (first (typed pk \"HereDocEnd\")))))\n      (is (= [\";\" [31 32]]\n             ((juxt :text :span) (first (typed pk \"SemiColon\"))))))))\n\n\n(deftest heredoc-end-boundaries-test\n  (testing \"terminator at EOF without a newline\"\n    (let [pk (parse \"<?php $a = <<<EOF\\nhello\\nEOF;\")]\n      (is (= [\"EOF\"] (mapv :text (typed pk \"HereDocEnd\"))))\n      (is (= [\";\"] (mapv :text (typed pk \"SemiColon\"))))))\n  (testing \"terminator before same-line punctuation\"\n    (let [pk (parse \"<?php f(<<<EOF\\nhi\\nEOF);\\n\")]\n      (is (= [\"EOF\"] (mapv :text (typed pk \"HereDocEnd\"))))\n      (is (= [\")\"] (mapv :text (typed pk \"CloseRoundBracket\"))))\n      (is (= [\",\"] (mapv :text (typed (parse \"<?php f(<<<EOF\\nhi\\nEOF, 1);\\n\")\n                                      \"Comma\"))))))\n  (testing \"a longer name is body, not the terminator\"\n    (let [pk (parse \"<?php $a = <<<EOF\\nEOFX\\nEOF;\\n\")]\n      (is (= [\"\\n\" \"EOFX\\n\"] (mapv :text (typed pk \"HereDocText\")))))))\n\n\n(deftest double-quoted-heredoc-test\n  (let [pk (parse \"<?php $a = <<<\\\"EOF\\\"\\nhello\\nEOF;\\n\")]\n    (is (= [\"<<<\\\"EOF\\\"\"] (mapv :text (typed pk \"StartHereDoc\"))))\n    (is (= [\"EOF\"] (mapv :text (typed pk \"HereDocEnd\"))))))\n\n\n(deftest heredoc-without-semicolon-test\n  (let [src \"<?php\\nf(<<<EOF\\n  hi\\n  EOF\\n);\\n\"\n        pk (parse src)]\n  