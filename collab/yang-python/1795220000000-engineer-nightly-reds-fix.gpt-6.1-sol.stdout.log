{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/php/antlr/cst_test.clj; rg -n 'session.*catalog|standard.*catalog|php' test/yin/repl* -g '*frontend*'; tail -12 target/nightly-dht-fixed.log; tail -15 target/nightly-stack-recursion.log; tail -5 target/nightly-golden-run2.log; git diff --stat\"","aggregated_output":"(ns yang.php.antlr.cst-test\n  \"P0: PHP CST export. Sources are ASCII, so a byte span is a string span.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.antlr.packet :as packet]\n    [yang.php.antlr.cst :as cst]))\n\n\n(defn- tokens\n  [pk]\n  (filterv #(= :token (:kind %)) (:yang.cst/nodes pk)))\n\n\n(defn- real-tokens\n  [pk]\n  (remove :synthetic (tokens pk)))\n\n\n(defn- parse\n  \"The validated ok packet for `src`, whose real tokens are in source order\n   and whose every span reads back as exactly the token's text.\"\n  [src]\n  (let [pk (cst/parse-source src)]\n    (is (= :yang.cst/ok (:yang.cst/outcome pk)) (pr-str src))\n    (is (some? (packet/validate! pk)))\n    (doseq [{:keys [text span type]} (real-tokens pk)\n            :let [[a b] span]]\n      (is (= text (subs src a b)) (str type \" span \" span)))\n    (is (apply <= 0 (mapcat :span (real-tokens pk))) \"spans ascend\")\n    (is (= [(count src) (count src)] (:span (peek (tokens pk)))) \"EOF\")\n    pk))\n\n\n(defn- typed\n  [pk type]\n  (filterv #(= type (:type %)) (tokens pk)))\n\n\n(deftest inline-html-and-tags-test\n  (let [src \"a <?php echo 1; ?>b <?= $x ?>c\"\n        pk (parse src)]\n    (is (= [\"a \" \"b \" \"c\"] (mapv :text (typed pk \"HtmlText\"))))\n    (is (= [[0 2] [18 20] [29 30]] (mapv :span (typed pk \"HtmlText\"))))\n    (is (= [\"echo\" \"<?=\"] (mapv :text (typed pk \"Echo\"))))\n    (is (= [\"?>\" \"?>\"] (mapv :text (filter #(= \"?>\" (:text %))\n                                           (typed pk \"SemiColon\")))))))\n\n\n(deftest heredoc-test\n  (let [src \"<?php\\n$a = <<<EOF\\n  hi $n\\n  EOF;\\n\"\n        pk (parse src)]\n    (is (= \"<<<EOF\" (:text (first (typed pk \"StartHereDoc\")))))\n    (is (= \"  hi $n\\n\" (:text (second (typed pk \"HereDocText\")))))\n    (testing \"the end identifier and the `;` are real tokens over their own source\"\n      (is (= [\"  EOF\" [26 31]]\n             ((juxt :text :span) (first (typed pk \"HereDocEnd\")))))\n      (is (= [\";\" [31 32]]\n             ((juxt :text :span) (first (typed pk \"SemiColon\"))))))))\n\n\n(deftest heredoc-end-boundaries-test\n  (testing \"terminator at EOF without a newline\"\n    (let [pk (parse \"<?php $a = <<<EOF\\nhello\\nEOF;\")]\n      (is (= [\"EOF\"] (mapv :text (typed pk \"HereDocEnd\"))))\n      (is (= [\";\"] (mapv :text (typed pk \"SemiColon\"))))))\n  (testing \"terminator before same-line punctuation\"\n    (let [pk (parse \"<?php f(<<<EOF\\nhi\\nEOF);\\n\")]\n      (is (= [\"EOF\"] (mapv :text (typed pk \"HereDocEnd\"))))\n      (is (= [\")\"] (mapv :text (typed pk \"CloseRoundBracket\"))))\n      (is (= [\",\"] (mapv :text (typed (parse \"<?php f(<<<EOF\\nhi\\nEOF, 1);\\n\")\n                                      \"Comma\"))))))\n  (testing \"a longer name is body, not the terminator\"\n    (let [pk (parse \"<?php $a = <<<EOF\\nEOFX\\nEOF;\\n\")]\n      (is (= [\"\\n\" \"EOFX\\n\"] (mapv :text (typed pk \"HereDocText\")))))))\n\n\n(deftest double-quoted-heredoc-test\n  (let [pk (parse \"<?php $a = <<<\\\"EOF\\\"\\nhello\\nEOF;\\n\")]\n    (is (= [\"<<<\\\"EOF\\\"\"] (mapv :text (typed pk \"StartHereDoc\"))))\n    (is (= [\"EOF\"] (mapv :text (typed pk \"HereDocEnd\"))))))\n\n\n(deftest heredoc-without-semicolon-test\n  (let [src \"<?php\\nf(<<<EOF\\n  hi\\n  EOF\\n);\\n\"\n        pk (parse src)]\n    (is (= [\")\"] (mapv :text (typed pk \"CloseRoundBracket\"))))))\n\n\n(deftest nowdoc-test\n  (let [src \"<?php $a = <<<'EOF'\\n  hi $n\\n  EOF;\\n\"\n        pk (parse src)]\n    (is (= \"<<<'EOF'\" (:text (first (typed pk \"StartNowDoc\")))))\n    (is (= \"  hi $n\\n\" (:text (second (typed pk \"HereDocText\")))))))\n\n\n(deftest interpolation-test\n  (let [pk (parse \"<?php $s = \\\"hello $name\\\";\")]\n    (is (= [[\"StringPart\" \"hello \" [12 18]]]\n           (mapv (juxt :type :text :span) (typed pk \"StringPart\"))))\n    (is (= [[\"VarName\" \"$name\" [18 23]]]\n           (mapv (juxt :type :text :span) (rest (typed pk \"VarName\")))))))\n\n\n(deftest close-tag-newline-and-text-test\n  (testing \"?> swallows one following LF\"\n    (let [pk (parse \"<?php echo 1 ?>\\nfoo\")]\n      (is (= [\"?>\\n\" [13 16]]\n             ((juxt :text :span) (first (typed pk \"SemiColon\")))))\n      (is (= [\"foo\" [16 19]]\n             ((juxt :text :span) (first (typed pk \"HtmlText\")))))))\n  (testing \"?> swallows one following CRLF\"\n    (let [pk (parse \"<?php echo 1 ?>\\r\\nfoo\")]\n      (is (= [\"?>\\r\\n\" [13 17]]\n             ((juxt :text :span) (first (typed pk \"SemiColon\")))))\n      (is (= [\"foo\" [17 20]]\n             ((juxt :text :span) (first (typed pk \"HtmlText\")))))))\n  (testing \"only the first of two newlines is swallowed\"\n    (let [pk (parse \"<?php echo 1 ?>\\n\\nfoo\")]\n      (is (= [\"?>\\n\" [13 16]]\n             ((juxt :text :span) (first (typed pk \"SemiColon\")))))\n      (is (= [\"\\nfoo\" [16 20]]\n             ((juxt :text :span) (first (typed pk \"HtmlText\")))))))\n  (let [pk (parse \"<?= $x ?>\\n\")]\n    (is (= [\"?>\\n\" [7 10]]\n           ((juxt :text :span) (first (typed pk \"SemiColon\"))))))\n  (let [pk (parse \"<?php echo 1; ?>b\")]\n    (is (= [\"b\" [16 17]]\n           ((juxt :text :span) (first (typed pk \"HtmlText\")))))))\n\n\n(deftest close-tag-ends-statement-test\n  (let [pk (parse \"<?php echo 1 ?>\")]\n    (is (= [\"SemiColon\" \"?>\" [13 15]]\n           ((juxt :type :text :span) (first (typed pk \"SemiColon\")))))))\n\n\n(deftest generics-refused-test\n  (is (= {:yang.php/not-php :generics}\n         (cst/parse-source \"<?php function f<:T:>() {}\"))))\ntest/yin/repl_test.cljc:189:        [state _] (repl/eval-input (repl.frontends/create-state) \"(lang :yang/php)\")\ntest/yin/repl_test.cljc:721:(deftest a-php-submission-has-an-isolated-runtime-test\ntest/yin/repl_test.cljc:725:           [_ texts] (results state [\"(lang :yang/php)\" \"<?php echo 1 + 2;\"])]\ntest/yin/repl/frontend_catalog_test.cljc:4:   defined here evaluates on every VM, a session pins its catalog snapshot,\ntest/yin/repl/frontend_catalog_test.cljc:72:                                                \"(lang :yang/php)\"))\ntest/yin/repl/frontend_catalog_test.cljc:73:                                    \"<?php echo 1 + 2;\")))))\ntest/yin/repl/frontend_catalog_test.cljc:91:    (testing \"a session composed with the newer catalog pins its own snapshot\"\ntest/yin/repl/frontend_catalog_test.cljc:128:(deftest a-core-session-with-no-catalog-has-no-frontend-test\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\nloaded safepoint tests\nLoading initial Timbre config from: :default\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n antlr/php/manifest.edn                          | 60 +++++++++++++++++++++++--\n deps.edn                                        |  2 +-\n shadow-cljs.edn                                 |  6 +++\n src/clj/yang/php/antlr/cst.clj                  | 59 ------------------------\n src/cljc/yin/repl.cljc                          |  1 +\n src/cljc/yin/repl/dht.cljc                      |  5 +++\n src/cljc/yin/repl/frontends.cljc                |  7 ++-\n test/yang/python/antlr/linked_prelude_test.cljc | 21 ++++++++-\n test/yin/repl/dht_test.cljc                     |  9 +++-\n 9 files changed, 101 insertions(+), 69 deletions(-)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_52","type":"agent_message","text":"The DHT failure reproduces on the JVM too. Publication first fails in round 3 because a growing index page exceeds the DHT’s 64 KiB message limit; later rounds keep reporting an earlier manifest. I’ve reduced the DHT-backed REPL’s index branching factor and added assertions that expose publication failures directly. The eight-round test is running again.\n"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/cljc/yin/repl/dht.cljc');s=p.read_text().replace('''(assoc (dht/store node)\n           :head-fn''','''(assoc (dht/store node)\n           ;; The generic index default (512 keys) can put >64 KiB into\n           ;; one node as rounds accumulate. Keep REPL index pages below\n           ;; the DHT store-message bound for ordinary code datoms; an\n           ;; individually oversized value still gets the store's refusal.\n           :publish-opts {:branching-factor 64}\n           :head-fn''');p.write_text(s)\np=Path('src/cljc/yin/repl.cljc');s=p.read_text().replace(''':content-store index-store\n                                   :after-publish''',''':content-store index-store\n                                   :publish-opts (:publish-opts index-store)\n                                   :after-publish''');p.write_text(s)\np=Path('test/yin/repl/dht_test.cljc');s=p.read_text().replace('''                      (is (= 8 (count (distinct ms))))''','''                      ;; These are manifest addresses, not clock readings:\n                      ;; every round must publish before its ack is awaited.\n                      (is (= 8 (count (distinct ms))))\n                      (is (= 64 (get-in w [:shells :p :indexer :materialization\n                                           :manifest :branching-factor])))''');p.write_text(s)\nPY\nclojure -M:test -n yin.repl.dht-test -v yin.repl.dht-test/rounds-larger-than-the-pending-write-bound-are-acknowledged-never-busy > target/nightly-dht-fixed.log 2>&1\"","aggregated_output":"","exit_code":0,"status":"completed"}}
