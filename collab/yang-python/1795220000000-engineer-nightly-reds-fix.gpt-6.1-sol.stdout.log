{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '315,370p' test/yin/repl/main_test.cljc; sed -n '300,350p' src/cljc/yin/repl/index.cljc; sed -n '1935,1975p' src/cljc/yin/repl.cljc; cat src/cljc/yang/php/antlr/quoted.cljc; cat antlr/python3/manifest.edn | sed -n '65,130p'; sed -n '200,310p' src/dev/yang_antlr_gen.clj\"","aggregated_output":"   entries (`bin/yin_repl_main.dart`, the JVM and Node mains) run.\"\n  [lines]\n  (loop [state (repl/boot {})\n         lines lines\n         out []]\n    (if-let [line (first lines)]\n      (let [_ (driver/submit-line! (:input state) line)\n            [state' printed] (loop [state state\n                                    n 0]\n                               (let [[state' _ printed] (repl/step-all state\n                                                                       nil\n                                                                       n)]\n                                 (if (or (seq printed) (= n 50))\n                                   [state' printed]\n                                   (recur state' (inc n)))))]\n        (recur state' (rest lines) (conj out [line (vec printed)])))\n      out)))\n\n\n(deftest the-interactive-composition-holds-every-standard-language\n  (let [t (transcript [\"(host)\"\n                       \"(lang :yang/python)\"\n                       \"1 + 2\"\n                       \"[x * x for x in range(4)]\"\n                       \"'a' + 'b'\"\n                       \"(lang :python)\"\n                       \"1 + 2\"\n                       \"(lang :yang/php)\"\n                       \"<?php echo 1 + 2;\"\n                       \"(lang :yang/clojure)\"\n                       \"1 + 2\"\n                       \"(+ 1 2)\"])]\n    (is (str/starts-with? (first (get-in t [0 1])) \"Host: \"))\n    (is (= \"Switched to :yang/python\" (first (get-in t [1 1]))))\n    (is (= [\"3\"] (get-in t [2 1])))\n    (is (= [\"[0, 1, 4, 9]\"] (get-in t [3 1])))\n    (is (= [\"'ab'\"] (get-in t [4 1])))\n    (testing \"a language keyword is not a selector: the refusal names what\n              is installed, and the session keeps its frontend\"\n      (is (= [(str \"Error: unavailable-parser: Yin REPL language :python\"\n                   \" is not in the frontend catalog; installed: :clojure :php\"\n                   \" :python (ids :yang/clojure :yang/php :yang/python)\")]\n             (get-in t [5 1])))\n      (is (= [\"3\"] (get-in t [6 1]))))\n    (is (= \"Switched to :yang/php\" (first (get-in t [7 1]))))\n    (is (= [\"3\"] (get-in t [8 1])))\n    (is (= \"Switched to :yang/clojure\" (first (get-in t [9 1]))))\n    (testing \"Clojure reads `1 + 2` as three forms; the last value prints\"\n      (is (= [\"2\"] (get-in t [10 1]))))\n    (is (= [\"3\"] (get-in t [11 1])))))\n\n\n;; =============================================================================\n;; L4: the publisher's key file (docs/design/yin.vm.linker.dht.md 6.5)\n;; =============================================================================\n\n\n(defn- commit\n  \"Commit one packet as one transaction; its rows join `:unwritten`, which\n   the round writes before it publishes (`write-rows`).  A packet that\n   could not be projected or committed is consumed and recorded as the\n   failure, never counted, and materializes nothing.\"\n  [ix packet round]\n  (try\n    (let [{:keys [tx-data next-e root row-set]}\n          (packet->tx-data packet\n                           (:next-e ix)\n                           {:session-token (:session-token ix), :round round})\n          answer (transactor/transact! (get-in ix [:publication :transactor])\n                                       tx-data)]\n      (if (= :dao.stream/ok (:dao.stream/outcome answer))\n        [(-> ix\n             (assoc :next-e next-e)\n             (update :transactions inc)\n             (update :unwritten (fnil conj []) row-set))\n         true]\n        [(assoc ix\n                :failure {:round round\n                          :root root\n                          :stage :transact\n                          :outcome (:dao.stream/outcome answer)})\n         false]))\n    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n      [(assoc ix\n              :failure {:round round\n                        :stage :project\n                        :message (ex-message e)})\n       false])))\n\n\n(defn- materialize\n  \"Drain the intake into the store until it blocks.  Answers how many\n   payloads it materialized and, when the drain met a gap or a defect, what\n   it met.  The pool is not kept: its intake is dropped with the round.\"\n  [content-store pool]\n  (loop [pool pool\n         n 0]\n    (let [{:keys [signal], :as r} (jing/observe-step! content-store pool)]\n      (case signal\n        :dao.stream/ok\n        (let [missing #?(:cljd (Object.) :clj (Object.) :cljs (js-obj))]\n          ;; Every emitted dirty node reads back before HEAD moves. The\n          ;; unchanged subgraphs were verified by earlier publications;\n          ;; immutable retained content makes that verification reusable.\n          (when (identical? missing (jing/get content-store (:address r) missing))\n            (throw (ex-info \"published content could not be read back\"\n                            {:address (:address r)})))\n\n\n(defn- eval-compiled\n  \"Evaluate a program `compile-input` or `compile-source` lowered.  What\n   its lowering left (`::frontend`: the session and the `:render` hook) is\n   staged on the round and committed only where the round's VM state\n   survives: when the program halts, now or when its parked require\n   completes (`finalize-eval`).  A round that fails, rolls back, or is\n   abandoned keeps the shell's previous `:frontend-session`.\"\n  [state ast]\n  (let [staged (::frontend (meta ast))\n        [state' text] (eval-program (cond-> state\n                                      staged (assoc ::frontend staged))\n                                    ast)]\n    [(dissoc state' ::frontend) text]))\n\n\n(defn- eval-parsed*\n  \"The parse dispatch of one line, against a shell with no require to\n   re-check.\"\n  [state trimmed parsed]\n  (try\n    (let [forms (:forms parsed)\n          form (when (= 1 (count forms)) (first forms))]\n      (cond\n        (and form (command-form? form)) (handle-command state form)\n        (and form (datom-stream? form)) (eval-program state (vec form))\n        (and form (ast-map? form)) (eval-program state form)\n        forms (eval-compiled state (compile-input state trimmed forms))\n        (forms-input? state) [state (format-error (:error parsed))]\n        :else (eval-compiled state (compile-source state trimmed))))\n    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n      (let [[state' output-text] (drain-output state)]\n        [state' (str output-text (format-error error))]))))\n\n\n(defn- fold-queued\n  \"Evaluate the lines retained while a require was pending, in the order\n   they were typed, each exactly once, and join their texts.  A line that\n   parks the shell on a require of its own stops the fold: the lines\n   after it stay retained, in order, on the new `:pending-run`.\"\n(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\n yang.php.antlr.quoted\n  \"The `defquoted` macro the prelude's definition vectors share.\"\n  #?(:cljs (:require-macros [yang.php.antlr.quoted :refer [defquoted]]))\n  #?(:cljd (:require [clojure.edn :as edn])))\n\n\n#?(:clj\n   (defmacro defquoted\n     \"`def` of the quoted data `form`; ClojureDart reads it back from one EDN\n      string (its quoted data compiles to straight-line Dart).\"\n     [name doc form]\n     (if (find-ns 'cljd.compiler)\n       (list 'def name doc (list 'edn/read-string (pr-str (second form))))\n       (list 'def name doc form))))\n               \"1c8ac0a2bd1cc1499b842e251eea74a13cf7b6e984ece6cb5b55ff69403b354e\",\n               \"Python3Parser.java\"\n               \"8ba1f2398e52994e8ead1d68768c723bed6dbd4b5eccd48d57d585d1684f13d7\",\n               \"Python3ParserBase.java\"\n               \"332745797ab6423d234c796e80103823d718bc9da0a73643682a43d0c42c45be\"}},\n\n  ;; The JavaScript and Dart helpers build NEWLINE and DEDENT the same way as\n  ;; the Java one (commonToken at the end of the lexeme), so the same\n  ;; positioned-token patch is ported to each runtime's token API.\n  :javascript\n  {:runtime \"antlr4 4.13.2 (npm)\",\n   :flags [\"-Dlanguage=JavaScript\" \"-no-listener\" \"-no-visitor\"],\n   :helpers [\"JavaScript/Python3LexerBase.js\" \"JavaScript/Python3ParserBase.js\"],\n   :out \"build/antlr/python3/js/yang/antlr/gen/python3\",\n   :patches\n   {\"JavaScript/Python3ParserBase.js\" [[\"import antlr4 from 'antlr4';\"\n      \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]\n     [\"import Python3Parser from './Python3Parser.js';\\n\" \"\"]],\n    \"JavaScript/Python3LexerBase.js\"\n    [[\"import antlr4 from 'antlr4';\"\n      \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]\n     [\"            this.emitToken(this.commonToken(Python3Parser.NEWLINE, newLine));\"\n      \"            this.emitToken(this.positionedToken(Python3Parser.NEWLINE, this._tokenStartCharIndex, this._tokenStartCharIndex + newLine.length - 1));\"]\n     [\"        return this.commonToken(Python3Parser.DEDENT, \\\"\\\");\"\n      \"        const dedent = this.positionedToken(Python3Parser.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);\\n        if (this.lastToken) {\\n            dedent.line = this.lastToken.line;\\n        }\\n        return dedent;\"]\n     [\"            this.emitToken(this.commonToken(Python3Parser.NEWLINE, \\\"\\\\n\\\"));\"\n      \"            this.emitToken(this.positionedToken(Python3Parser.NEWLINE, this.getCharIndex(), this.getCharIndex() - 1));\"]\n     [\"    commonTok