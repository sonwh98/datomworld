{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat src/clj/yang/php/antlr/cst.clj; rg --files src | rg '(php|antlr)' | rg '(cljs|js|cst)'; sed -n '1,140p' src/cljc/yang/python/antlr/parser.cljc; sed -n '1770,1865p' src/cljc/yin/repl.cljc; sed -n '1,105p' test/yang/python/antlr/linked_helpers.cljc; rg -n 'authentic\\\\?|d9aead|34893d' src/cljc/yang/python test/resources/yang/python test/yang/python/antlr | head -25; ls target/node-tests.js node_modules/antlr4 build/antlr/php/js 2>/dev/null\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat src/clj/yang/php/antlr/cst.clj; rg --files src | rg '(php|antlr)' | rg '(cljs|js|cst)'; sed -n '1,140p' src/cljc/yang/python/antlr/parser.cljc; sed -n '1770,1865p' src/cljc/yin/repl.cljc; sed -n '1,105p' test/yang/python/antlr/linked_helpers.cljc; rg -n 'authentic\\\\?|d9aead|34893d' src/cljc/yang/python test/resources/yang/python test/yang/python/antlr | head -25; ls target/node-tests.js node_modules/antlr4 build/antlr/php/js 2>/dev/null\"","aggregated_output":"(ns yang.php.antlr.cst\n  \"The PHP parser worker (docs/design/yang.php.md section 6): the\n   grammars-v4 php grammar profile over the generic `yang.antlr.cst` worker.\n   The generated recognizers come from `bb gen:antlr` (antlr/php/manifest.edn);\n   the JVM is the only local target. The entry rule is `htmlDocument`.\n\n   The grammar's non-standard generics (`typeParameterListInBrackets`, the\n   `<: ... :>` brackets) are not PHP: a parse that uses them is refused as\n   `{:yang.php/not-php :generics}` rather than exported.\"\n  (:require\n    [yang.antlr.cst :as cst])\n  (:import\n    (yang.php.antlr.gen\n      PhpLexer\n      PhpParser)))\n\n\n(def grammar-id\n  \"grammars-v4 php at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/php@85e2dd1779ce556111ef98ead5d62a9858e95599 antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   :make-lexer (fn [cs] (PhpLexer. cs)),\n   :make-parser (fn [ts] (PhpParser. ts)),\n   :start (fn [^PhpParser p] (.htmlDocument p))})\n\n\n(defn make-worker\n  []\n  (cst/make-worker profile))\n\n\n(defn- generics?\n  [pk]\n  (boolean (some #(= \"typeParameterListInBrackets\" (:rule %))\n                 (:yang.cst/nodes pk))))\n\n\n(defn- line-starts\n  \"The UTF-8 byte offsets at which each source line begins (the line side\n   table, section 17: derived at the parse boundary, where the source is\n   known, so no later stage needs the text).\"\n  [^String source]\n  (let [bs (.getBytes source \"UTF-8\")]\n    (into [0] (keep-indexed (fn [i b] (when (= b 10) (inc i)))) bs)))\n\n\n(defn parse-source\n  \"Parse one complete PHP source string as unit `unit`: the CST packet, or\n   `{:yang.php/not-php :generics}` when the parse uses the grammar's generics\n   extension.\"\n  ([source] (parse-source (make-worker) [:unit 0] source))\n  ([worker unit source]\n   (let [pk (cst/parse-unit worker unit source)]\n     (if (generics? pk)\n       {:yang.php/not-php :generics}\n       (assoc pk :yang.php/line-starts (line-starts source))))))\nsrc/clj/yang/php/antlr/cst.clj\nsrc/clj/yang/typescript/antlr/cst.clj\nsrc/clj/yang/antlr/cst.clj\nsrc/cljd/yang/antlr/cst.cljd\nsrc/jolt/yang/antlr/cst.jolt\nsrc/cljs/yang/antlr/cst.cljs\n(ns yang.python.antlr.parser\n  \"The Python parser interpreter: the grammars-v4 Python3 grammar profile\n   plus the stage that reads sealed source units from one stream and writes\n   CST packets to another. The generated recognizers come from `bb gen:antlr`\n   (antlr/python3/manifest.edn), one per host target; this is the only\n   namespace that names them, and the profile's three constructors are the\n   entire per-host surface.\"\n  (:require\n    #?@(:cljd [[\"package:antlr4/antlr4.dart\" :as antlr4]\n               [\"package:datomworld_cljd/antlr/python3/Python3Lexer.dart\"\n                :as lexer-ns]\n               [\"package:datomworld_cljd/antlr/python3/Python3Parser.dart\"\n                :as parser-ns]]\n        :cljs [[\"/yang/antlr/gen/python3/Python3Lexer.js\" :default Python3Lexer]\n               [\"/yang/antlr/gen/python3/Python3Parser.js\" :default Python3Parser]])\n    [yang.antlr.cst :as cst]\n    [yang.stage :as stage])\n  #?@(:cljd []\n      :jolt []\n      :clj [(:import\n              (yang.python.antlr.gen\n                Python3Lexer\n                Python3Parser))]))\n\n\n(def grammar-id\n  \"grammars-v4 python/python3 at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/python/python3@8af0d4c26c796ea27c15c3d85418f2d0f77c3adb antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   ;; jolt: the C++ recognizers live in native/jolt-parser behind the jolt\n   ;; yang.antlr.cst, which builds no lexer or parser from the profile\n   :make-lexer #?(:cljd (fn [cs] (lexer-ns/Python3Lexer cs))\n                  :jolt nil\n                  :default (fn [cs] (Python3Lexer. cs))),\n   :make-parser #?(:cljd (fn [ts] (parser-ns/Python3Parser ts))\n                   :jolt nil\n                   :default (fn [ts] (Python3Parser. ts))),\n   :start #?(:cljd (fn [p] (.file_input ^parser-ns/Python3Parser p))\n             :jolt nil\n             :clj (fn [^Python3Parser p] (.file_input p))\n             :cljs (fn [^js p] (.file_input p)))})\n\n\n(defn rule-names\n  \"The grammar's rule-name table. A function, so requiring this namespace\n   does no native work: on jolt the table is what the native parser reports,\n   read when first asked for (unavailable-parser is thrown while the library\n   is unavailable, and a later call retries).\"\n  []\n  ;; Dart's table is an instance member of the generated parser.\n  #?(:cljd (vec (.-ruleNames\n                  (parser-ns/Python3Parser\n                    (antlr4/CommonTokenStream\n                      (lexer-ns/Python3Lexer\n                        (antlr4/InputStream.fromString \"\"))))))\n     :jolt (cst/rule-names)\n     :clj (vec (seq Python3Parser/ruleNames))\n     :cljs (vec (.-ruleNames Python3Parser))))\n\n\n(defn available?\n  \"True when this host's recognizers can be built. Always on the JVM, Node\n   and Dart (the generated parser ships with the build); on jolt, only when\n   native/jolt-parser loaded and writes the expected layout, so a missing or\n   incompatible library leaves Python out of the catalog (never another\n   parser) instead of failing the load.\"\n  []\n  #?(:jolt (cst/available?) :default true))\n\n\n(defn make-worker\n  \"A worker for this grammar. On jolt it owns a native handle; dispose it with\n   `close-worker` (the convenience calls below dispose their own).\"\n  []\n  (cst/make-worker profile))\n\n\n(defn close-worker\n  \"Dispose `worker` (jolt: its native handle and caches; idempotent, and a\n   closed worker refuses further parses). The other hosts' workers are\n   collected, so this does nothing there.\"\n  [worker]\n  #?(:jolt (cst/close-worker worker) :default nil))\n\n\n(defn- with-worker\n  \"(f worker) over a worker made for this one call and disposed however f\n   exits (J5, known-gaps row 59: no convenience call leaves a native worker).\"\n  [f]\n  (let [w (make-worker)]\n    (try (f w)\n         (finally (close-worker w)))))\n\n\n(defn parse-source\n  \"Parse one complete source string as unit `unit`: the packet a sealed unit\n   with this text produces. The one-argument form makes a worker for the\n   call and disposes it.\"\n  ([source] (with-worker #(parse-source % [:unit 0] source)))\n  ([worker unit source] (cst/parse-unit worker unit source)))\n\n\n(defn first-failure\n  \"Where the grammar first refuses `source` (`yang.antlr.cst/first-failure`:\n   nil, :end or :early), with a worker made for this call and disposed.\n\n   On jolt an input over the native parser's budget answers :early: more\n   lines can only grow its size and its nesting, so it cannot be mended, and\n   the parse stage then reports the qualified :parser-budget refusal.\"\n  [source]\n  (with-worker\n    (fn [w]\n      (try (cst/first-failure w source)\n           (catch #?(:cljd Object :clj Exception :cljs :default) e\n             (if (= :parser-budget (:diagnostic (ex-data e)))\n               :early\n               (throw e)))))))\n\n\n(defn open-stage\n  \"A parser stage reading source events from `source-stream` and writing\n   CST packets to `cst-stream`. The stage owns its worker: `close-stage`\n   disposes it and `reset-stage` replaces it with a fresh one.\"\n  [source-stream cst-stream]\n  ;; the stage first: opening it can refuse (a source cursor that cannot be\n  ;; had), and then no worker exists to leak\n  (let [s (stage/open source-stream {:cst cst-stream} {})\n        w (make-worker)]\n    (try\n      (assoc s\n             ::worker w\n             ::transform (cst/parse-transform w))\n      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n        (close-worker w)\n        (throw e)))))\n\n\n(defn- compile-input\n  \"Lower `input` through the selected frontend; `forms` are the shell\n   reader's forms, used by a frontend that consumes them.\"\n  [state input forms]\n  (let [binding (frontend-binding state (:lang state))]\n    (lower-parsed state binding\n                  ((:parse binding)\n                   (if (= :forms (:input binding)) forms input)))))\n\n\n(defn- forms-input?\n  [state]\n  (= :forms (:input (frontend-binding state (:lang state)))))\n\n\n(defn- compile-source\n  [state input]\n  (let [binding (frontend-binding state (:lang state))]\n    (lower-parsed state binding\n                  ((:parse binding)\n                   (if (= :forms (:input binding)) (read-forms input) input)))))\n\n\n(defn- compile-command-ast\n  \"The AST `(compile ...)` previews.  It lowers against a primed frontend\n   session: a session-staged frontend carries its prelude only on the\n   session's first lowering, and the preview is of the submitted form, not\n   of the runtime it would run on.  The session itself is not touched.\"\n  [state arg]\n  (let [state (assoc state :frontend-session :primed)]\n    (cond\n      (string? arg) (compile-source state arg)\n      (forms-input? state) (compile-input state nil [arg])\n      :else (throw (ex-info \"This compile command expects a source string\"\n                            {:lang (:lang state) :arg arg})))))\n\n\n(defn- render-compile-output\n  \"Render the frontend syntax, the input row batch, and what the session's\n   expander would make of it against its current store: the expanded tree\n   packet (or the expansion error) and the event rows.  The expansion is a\n   preview; its context is discarded, so nothing is committed.\"\n  [state ast]\n  (let [batch (encoder/program-batch ast)\n        {:keys [tree error log]}\n        (macro/expand-batch batch (get-in state [:expander :ctx]))]\n    (str \"AST:\\n\" (format-value ast)\n         \"\\n\\nInput rows:\\n\" (format-value batch)\n         (if tree\n           (str \"\\n\\nExpanded rows:\\n\" (format-value tree))\n           (str \"\\n\\nExpansion error:\\n\" (format-value error)))\n         \"\\n\\nEvents:\\n\" (format-value (second log)))))\n\n\n(defn- rebuild-session\n  \"Replace the VM, the expander, and their media, attachments, and\n   observers.  The value history is cleared with them: a closure in `*1`\n   names a code segment the old VM held, which the new one does not.  The\n   new expander holds only the standard forms.  A require still pending\n   on the old VM is dropped with it: its link pair is the session's, and\n   the new session answers from its own.\n\n   Over a durable store the code index is not the session's to drop: the\n   new indexer continues the old one's log, entity allocation, and\n   published manifest (`yin.repl.index/carry-over`), so a rebuild never\n   resets `t`.  Over the memory store it starts empty, as it always has.\"\n  [state vm-type]\n  (merge state\n         (cond-> (make-session vm-type (:output-stream state)\n                               (merge (selected-primitives (:frontends state)\n                                                           (:lang state))\n                                      (:extra-primitives state))\n                               (:shell-token state)\n                               (:index-store state)\n                               (:link-source state))\n           (store/durable? (:index-store state))\n           (update :indexer index/carry-over (:indexer state)))\n         {:vm-type vm-type\n          :ingress-loss? false\n          :last-value nil\n          :last-value-2 nil\n          :last-value-3 nil\n          :frontend-session nil\n          :pending-run nil}))\n\n\n(defn- configure-admission\n  \"Apply session configuration to the linker, retaining its live state.\"\n  [state admission]\n  (let [linker (link/reconfigure (:linker state) admission)]\n    (assoc state :admission admission :linker linker\n           :link-source (:source linker))))\n\n\n(defn- trust-command\n  [state command args]\nsed: test/yang/python/antlr/linked_helpers.cljc: No such file or directory\ntest/resources/yang/python/dht-import-v1.edn:2:{:py :segment/blake3-d9aead51dc2da70f8dcd8935f2a8c3bc052037967064b45d1914897ad03a6a9c}\ntest/resources/yang/python/dht-import-v1.edn:6:{:index :own, :signed [{:envelope #:yin.module{:op :assert, :name py, :manifest :segment/blake3-d9aead51dc2da70f8dcd8935f2a8c3bc052037967064b45d1914897ad03a6a9c, :asserted-by \"ed25519:bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5\", :seq 1}, :proof #:yin.module{:signature \"515852abe025e129d9550a02e1aa1c632bf07232ca289b82478034c72337a94f4130af0aa8a0c95e70237a32fb091268cb91f4ce62a01a8ecca1a6d5258c1909\"}} {:envelope #:yin.module{:op :assert, :name yang.call, :manifest :segment/blake3-ef21320944b651140c11dedebd8b443fb91d32f99678f9c274568fbe4d07eea4, :asserted-by \"ed25519:bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5\", :seq 2}, :proof #:yin.module{:signature \"55427921b83201e1761a5222f2bb2e2bf7539a3e252a565f69273ec550e292d5c4a38c271c3691fca899a0d0f209f2266f279c1b2ab3f2ee3c56f76c4dc82d03\"}} {:envelope #:yin.module{:op :assert, :name pym.m, :manifest :segment/blake3-c23956287e72eb1bd12ede2fb38978df7091a0e348e43c9fa7d9f3661cc743f8, :asserted-by \"ed25519:bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5\", :seq 3}, :proof #:yin.module{:signature \"af116638a2ab7790720303afa9ffe52e34a2dcc8c2f4ea4ae9775a44578bf83471478bb7766decbbf6af974b588fa46ce1961632889e6d6f1fa0ad0a1e333b0c\"}} {:envelope #:yi