{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"tail -80 src/dev/node_shard.clj; tail -12 target/nightly-python-jvm.log; tail -12 target/nightly-repl-jvm.log; tail -10 target/nightly-node-build.log; sed -n '1,85p' test/yang/typescript/antlr/string_forms_test.cljc; rg -n 'defn- every=|defn- on-every-vm' test/yang/python/antlr/safepoint_test.cljc test/yang/python/antlr/linked_safepoint_test.cljc; git diff -- antlr/php/manifest.edn | head -105\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"tail -80 src/dev/node_shard.clj; tail -12 target/nightly-python-jvm.log; tail -12 target/nightly-repl-jvm.log; tail -10 target/nightly-node-build.log; sed -n '1,85p' test/yang/typescript/antlr/string_forms_test.cljc; rg -n 'defn- every=|defn- on-every-vm' test/yang/python/antlr/safepoint_test.cljc test/yang/python/antlr/linked_safepoint_test.cljc; git diff -- antlr/php/manifest.edn | head -105\"","aggregated_output":"          ;; conditional compiles to a library with no cljs test vars). That\n          ;; is a lane exclusion, recorded for the summary — not a failure.\n          ;; A failure is a namespace the bundle KNOWS that then fails to\n          ;; run, which the expected-vs-completed check below catches.\n          exclusions (into {}\n                           (remove (fn [[_ nss]] (empty? nss)))\n                           (into {}\n                                 (map (fn [[s nss]]\n                                        [s (set/difference (set nss) bundle)]))\n                                 lists))]\n      (doseq [[s ex] exclusions]\n        (log (str \"lane-excluded \" s \": \" (str/join \",\" (sort ex)))))\n      ;; run up to PAR shards at a time (waves)\n      (let [t0 (System/currentTimeMillis)\n            shards (vec (filter (comp seq sel) (keys sel)))\n            runs (atom {})\n            run-one (fn [s]\n                      (let [t0 (System/currentTimeMillis)\n                            {:keys [exit]}\n                            (psh {:dir clone\n                                  :out (io/file (str out \"/\" s \".log\"))\n                                  :err (io/file (str out \"/\" s \".err.log\"))\n                                  :extra-env {\"DATOM_SLOW_TESTS\" \"1\"}\n                                  :continue true}\n                                 \"node\" \"target/node-tests.js\"\n                                 ;; ONE argument: shadow 3.3.5's runner accepts\n                                 ;; only --test=<list>; a separate \"--test\" arg\n                                 ;; is ignored (\"Unknown arg\") and the worker\n                                 ;; silently runs the FULL suite (2026-11-01).\n                                 (str \"--test=\" (str/join \",\" (sel s))))\n                            secs (quot (- (System/currentTimeMillis) t0) 1000)]\n                        (let [logtxt (try (slurp (str out \"/\" s \".log\"))\n                                          (catch Exception _ \"\"))\n                              suspicious (or (str/includes? logtxt \"Unknown arg\")\n                                             (str/includes? logtxt \"Ran 0 tests\"))]\n                          (when suspicious\n                            (fail! (str \"shard \" s \" ran nothing (selection not applied)\")))\n                          (swap! runs assoc s {:rc exit :secs secs}))\n                        (spit (str out \"/runs.txt\")\n                              (str s \" rc=\" exit \" secs=\" secs \"\\n\")\n                              :append true)))]\n        ;; WORK-STEALING pool, not waves: a wave scheduler parks the next\n        ;; shard until every shard in the current batch finishes, so four\n        ;; 20-second shards leave four slots idle while one heavy shard runs\n        ;; (observed 2026-11-01: load 3.6 on a 24-thread host). Each worker\n        ;; pulls the next shard as soon as it finishes, so all PAR slots stay\n        ;; busy until the queue drains and the wall is the heaviest shard.\n        (let [queue (atom shards)\n              take-one (fn []\n                         (locking queue\n                           (let [cur @queue]\n                             (when (seq cur)\n                               (reset! queue (subvec cur 1))\n                               (first cur)))))]\n          (->> (range (min par (count shards)))\n               (mapv (fn [i]\n                       (future\n                         (loop []\n                           (if-let [s (take-one)]\n                             (do (run-one s) (recur))\n                             i)))))\n               (mapv deref)))\n        (let [expected (count shards)\n              done (count @runs)\n              red (count (filter #(not= 0 (:rc %)) (vals @runs)))\n              wall (quot (- (System/currentTimeMillis) t0) 1000)]\n          (doseq [[s r] (sort @runs)]\n            (log (str s \" rc=\" (:rc r) \" secs=\" (:secs r))))\n          (log (str \"node-sharded lanes=\" done \" red-lanes=\" red\n                    \" wall=\" wall \"s\"))\n          (when-not (= expected done)\n            (fail! (str \"expected \" expected \" shards, completed \" done)))\n          (when (pos? red)\n            (fail! (str red \" red shards\"))))))\n    (log (str \"done rc=\" @rc))\n    (System/exit @rc)))\n\n\n(when (= *file* (System/getProperty \"babashka.file\"))\n  (apply -main *command-line-args*))\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.python.antlr.linked-prelude-test\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yin.repl.main-test\nLoading initial Timbre config from: :default\n[:test] Compiling ...\n[:test] Build completed. (279 files, 23 compiled, 0 warnings, 10.80s)\n(ns yang.typescript.antlr.string-forms-test\n  \"T1 step S8: the two-form string gate (design 3.4, plan acceptance items 4\n   to 6) on every host. A `\\\"\\\\uD800\\\"` literal lowers to the `:js/units`\n   form, projects to rows, decodes and runs on all four VMs reading back as\n   `:js/units`; indexing and `.slice(0, 1)` of a surrogate pair give\n   `:js/units`, `.charCodeAt` and `.length` count units, and concatenating\n   the halves yields `:js/str` again; a continuation and a lifted slice\n   holding `:js/units` keep their bytes through `engine/lift-slice` and a\n   receiving task.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.test-slow :as slow]\n            [yang.core.uast :as u]\n            [yang.typescript.antlr.lower :as lower]\n            [yang.typescript.antlr.lower-portable-test :as portable]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yang.typescript.antlr.prelude-parity-test :as parity]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as walker]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.engine :as engine]\n            [yin.vm.integer :as integer]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.semantic.derive :as derive]\n            [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.values :as values]))\n\n\n(def ^:private lone\n  \"The packet of `console.log(\\\"\\\\uD800\\\")`.\"\n  (portable/program\n    (portable/log-stmt\n      [:singleExpression [:literal [\"StringLiteral\" \"\\\"\\\\uD800\\\"\"]]])))\n\n\n(def ^:private pair\n  \"The packet of `console.log(\\\"\\\\uD83D\\\\uDE00\\\")`.\"\n  (portable/program\n    (portable/log-stmt\n      [:singleExpression\n       [:literal [\"StringLiteral\" \"\\\"\\\\uD83D\\\\uDE00\\\"\"]]])))\n\n\n(defn- literals\n  \"Every literal value in `tree`.\"\n  [tree]\n  (into []\n        (comp (filter #(and (map? %) (= :literal (:type %))))\n              (map :value))\n        (tree-seq coll? seq tree)))\n\n\n(deftest literal-forms-test\n  (testing \"a lone surrogate literal lowers to the :js/units form\"\n    (is (some #{{:js/units [55296]}} (literals (lower/lower-module-body lone)))))\n  (testing \"a well-formed pair lowers to the :js/str form\"\n    (is (some #{{:js/str \"😀\"}} (literals (lower/lower-module-body pair))))\n    (is (not-any? #(contains? % :js/units)\n                  (filter map? (literals (lower/lower-module-body pair)))))))\n\n\n(defn- through-rows\n  \"`ast` projected to rows, canonically encoded, decoded and read back as a\n   program.\"\n  [ast]\n  (vm/semantic-bytecode->ast\n    (cbor/decode (jing/canonical-bytes (vm/ast->semantic-bytecode ast)))))\n\n\n(defn- lone-literal-on-every-vm\n  []\n  (let [ast (lower/lower-packet lone)\n        decoded (through-rows ast)]\n    (testing \"projecting, encoding and decoding keeps the literal and the\n              program's address\"\n      (is (some #{{:js/units [55296]}} (literals decoded)))\n      (is (= (jing/segment-key (vm/ast->semantic-bytecode ast))\n             (jing/segment-key (vm/ast->semantic-bytecode decoded)))))\n    (testing \"the program as lowered and as decoded logs :js/units\"\n      (doseq [program [ast decoded]\ntest/yang/python/antlr/safepoint_test.cljc:90:(defn- on-every-vm\ntest/yang/python/antlr/safepoint_test.cljc:153:(defn- every=\ntest/yang/python/antlr/linked_safepoint_test.cljc:353:(defn- on-every-vm\ntest/yang/python/antlr/linked_safepoint_test.cljc:369:(defn- every=\ndiff --git a/antlr/php/manifest.edn b/antlr/php/manifest.edn\nindex aa3172f7..13563583 100644\n--- a/antlr/php/manifest.edn\n+++ b/antlr/php/manifest.edn\n@@ -3,7 +3,9 @@\n            :revision \"85e2dd1779ce556111ef98ead5d62a9858e95599\",\n            ;; All three files are MIT with their notices intact and are vendored\n            ;; verbatim beside this manifest; every file is digest-checked.\n-           :files {\"PhpLexer.g4\"\n+           :files {\"JavaScript/PhpLexerBase.js\"\n+                   {:blake3 \"d5fc3fbb28176a1943d5b0d6d968062523e64ef0d2be1c6e10eb6cf59dcff455\", :vendored \"antlr/php/JavaScript/PhpLexerBase.js\"},\n+                   \"PhpLexer.g4\"\n                    {:blake3 \"21a682a8e2962042d9e6ed39fa65b6feadca09736d64c0d7177a25d184a4ecab\",\n                     :vendored \"antlr/php/PhpLexer.g4\"},\n                    \"PhpParser.g4\"\n@@ -74,13 +76,63 @@\n                \"PhpLexerBase.java\"\n                \"9d719b7c28a361458a0cc55870c2d39034ef34cdd329b175d8c847268e3769ca\",\n                \"PhpParser.java\"\n-               \"cbbe279f2f03e8ff63d61eed8d051350233abfc9c45d4beacbb9d234343bf121\"}}},\n+               \"cbbe279f2f03e8ff63d61eed8d051350233abfc9c45d4beacbb9d234343bf121\"}},\n+  ;; Node uses the same grammar patches and positioned heredoc terminator.\n+  :javascript\n+  {:runtime \"antlr4 4.13.2 (npm)\",\n+ :flags [\"-Dlanguage=JavaScript\" \"-no-listener\" \"-no-visitor\"],\n+ :helpers [\"JavaScript/PhpLexerBase.js\"],\n+ :out \"build/antlr/php/js/yang/antlr/gen/php\",\n+ :patches\n+ {\"PhpLexer.g4\"\n+  [[\"'>' | '</script>'\" \"'>' ('\\\\r'? '\\\\n')? | '</script>'\"]\n+   [\"PHPEndSingleLineComment : '?' '>';\"\n+    \"PHPEndSingleLineComment : '?' '>' ('\\\\r'? '\\\\n')?;\"]\n+   [\"SeaWhitespace  : [ \\\\t\\\\r\\\\n]+ -> channel(HIDDEN);\"\n+    \"SeaWhitespace  : [ \\\\t\\\\r\\\\n]+ -> type(HtmlText);\"]\n+   [\"HtmlComment    : '<!' '--' .*? '-->'  -> channel(HIDDEN);\"\n+    \"HtmlComment    : '<!' '--' .*? '-->'  -> type(HtmlText);\"]\n+   [\"HtmlSpace                  : [ \\\\t\\\\r\\\\n]+ -> channel(HIDDEN);\"\n+    \"HtmlSpace                  : [ \\\\t\\\\r\\\\n]+ -> type(HtmlText);\"]\n+   [\"StartHereDoc : '<<<' [ \\\\t]* NameString {\"\n+    \"StartHereDoc : '<<<' [ \\\\t]* ('\\\"' NameString '\\\"' | NameString) {\"]\n+   [\"HereDocText: ~[\\\\r\\\\n]*? ('\\\\r'? '\\\\n' | '\\\\r');\"\n+    \"HereDocText: ~[\\\\r\\\\n]*? ('\\\\r'? '\\\\n' | '\\\\r');\\n// Never matches: HeredocEndToken in PhpLexerBase builds this token.\\nHereDocEnd: [ \\\\t]* NameString { false }?;\"]],\n+  \"PhpParser.g4\"\n+  [[\"    : StartHereDoc HereDocText+\\n\"\n+    \"    : StartHereDoc HereDocText+ HereDocEnd\\n\"]\n+   [\"    | StartNowDoc HereDocText+\\n\"\n+    \"    | StartNowDoc HereDocText+ HereDocEnd\\n\"]\n+   [\"    : Static variableInitializer (',' variableInitializer)* SemiColon\\n    ;\\n\"\n+    \"    : Static staticInitializer (',' staticInitializer)* SemiColon\\n    ;\\n\\nstaticInitializer\\n    : VarName (Eq expression)?\\n    ;\\n\"]\n+   [\"    | (expression '=>')? '&' chain\\n    ;\\n\"\n+    \"    | (expression '=>')? '&' chain\\n    | Ellipsis expression\\n    ;\\n\"]\n+   [\"    : Return expression? SemiColon\\n\"\n+    \"    : Return (expression | yieldExpression)? SemiColon\\n\"]\n+   [\"    | assignable assignmentOperator attributes? expression        # AssignmentExpression\\n\"\n+    \"    | assignable assignmentOperator attributes? (expression | yieldExpression) # AssignmentExpression\\n\"]]},\n+ :output-patches\n+ {\"PhpLexer.js\"\n+  [[\"import antlr4 from 'antlr4';\"\n+    \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]],\n+  \"PhpParser.js\"\n+  [[\"import antlr4 from 'antlr4';\"\n+    \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]]},\n+ :generated\n+ {\"PhpLexer.js\"\n+  \"bfa995b5cb0b6a73359f1d87cc949fd1d7e1ae994db5f192dd460ce10e043767\",\n+  \"PhpLexerBase.js\"\n+  \"d5fc3fbb28176a1943d5b0d6d968062523e64ef0d2be1c6e10eb6cf59dcff455\",\n+  \"PhpParser.js\"\n+  \"59fd36cbec61b0586521c66f1cd68f42541badfddb220052dc5ec9221cd6e6ff\"}}},\n  ;; yang.php.md section 6 license review\n- :license {\"PhpLexer.g4\" \"MIT (header: Copyright (c) 2015-2019 Ivan Kochurkin, Positive Technologies; (c) 2019 Thierry Marianne); vendored with its notice verbatim\",\n+ :license {\"JavaScript/PhpLexerBase.js\" \"MIT; Node port of the pinned Java helper, notice retained\",\n+           \"PhpLexer.g4\" \"MIT (header: Copyright (c) 2015-2019 Ivan Kochurkin, Positive Technologies; (c)