{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"rg --files src | rg 'yang/php/antlr/(cst|parser)|tasks/cljs|node_shard'; cat test/resources/yang/python/dht-import-v1.generate.clj | head -120; sed -n '1,145p' src/cljc/yin/vm/linker/publish.cljc; sed -n '2120,2200p' src/cljc/yin/repl.cljc; cat src/cljc/yang/php/antlr/lower.cljc | head -55; rg -n 'big-program|Date|currentTime|nanoTime|transaction|:t ' src/cljc/yin/repl/index.cljc src/cljc/yin/repl.cljc | head -80; rg -n 'node|exec-argv|nodejs|prepend' ~/.m2/repository/thheller/shadow-cljs/3.3.5 2>/dev/null\"","aggregated_output":"src/clj/yang/php/antlr/cst.clj\nsrc/dev/tasks/cljs.clj\nsrc/dev/node_shard.clj\n;; Generator of test/resources/yang/python/dht-import-v1.edn.\n;;\n;; Provenance: the JVM publication of C4 slice I3's DHT import\n;; (yang.python.antlr.dht-import-fixture). Run from the repository root\n;; on the JVM, with the test paths on the classpath, to rewrite the\n;; artifact:\n;;\n;;   clojure -Sdeps '{:aliases {:t {:extra-paths [\"test\"]}}}' -M:t \\\n;;    test/resources/yang/python/dht-import-v1.generate.clj\n;;\n;; (not -A:test: that alias's main is the test runner and runs the suite)\n;;\n;; It publishes the committed CST packets of the guest units through\n;; `yang.python.antlr.publication` against `py` as the JVM publishes it,\n;; signs the name envelopes with the fixture's fixed test seeds, and\n;; writes the guest blobs, the manifest addresses, the envelopes and the\n;; importer packets. Every input is checked in, and Ed25519 signatures are\n;; deterministic, so a rerun on an unchanged tree rewrites the same data.\n;; Rerun it whenever the prelude, the lowering or the linker's\n;; publication moves an address; `dht-import-test` fails until it is.\n\n(require '[yang.python.antlr.dht-import-fixture :as fixture])\n\n\n(let [{:keys [lines refused]} (fixture/generate)]\n  (when refused\n    (throw (ex-info \"the artifact's publication was refused\" refused)))\n  (spit fixture/path (fixture/text lines))\n  (println \"wrote\" fixture/path))\n(ns yin.vm.linker.publish\n  \"Publish a complete four-format module closure into a DaoJing handle,\n   derive a module from indexed code (docs/design/yin.vm.linker.dht.md\n   5.3), and sign the name envelopes that bind it (6.1, 6.5, 6.6).\"\n  (:require [dao.jing :as jing]\n            [dao.space.query :as query]\n            [yin.vm :as vm]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.semantic.derive :as derive]\n            [yin.vm.ledger :as ledger]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.linker :as linker]\n            [yin.vm.linker.closure :as closure]\n            [yin.vm.linker.requirements :as requirements]\n            [yin.vm.linker.sign :as sign]))\n\n\n(defn- refusal\n  [reason data]\n  (merge {:status :refused :reason reason} data))\n\n\n(defn- definitions\n  [ast]\n  (letfn [(scan\n            [node]\n            (when (map? node)\n              (case (:type node)\n                :lambda #{}\n                :application\n                (let [xs (:operands node)\n                      own (when (and (vm/definition-operator? (:operator node))\n                                     (= 2 (count xs))\n                                     (= :literal (:type (first xs)))\n                                     (symbol? (:value (first xs))))\n                            #{(:value (first xs))})]\n                  (into (or own #{}) (mapcat scan)\n                        (concat (when (= :lambda (:type (:operator node)))\n                                  [(:body (:operator node))])\n                                xs)))\n                #{})))]\n    (scan ast)))\n\n\n(defn footprint\n  \"Derive the manifest footprint from tree rows, declared profiles and dependencies.\"\n  [handle {:keys [ast tree primitives requires]}]\n  (let [tree (or tree (vm/ast->semantic-bytecode ast))\n        own (vm/ast-requirements (query/relation (vals (:rows tree))))\n        bad-primitive (some (fn [[name profile]]\n                              (when-not (and (map? profile)\n                                             (keyword? (:yin.k/profile profile))\n                                             (set? (:yin.k/effects profile)))\n                                name))\n                            primitives)\n        missing (some (fn [[name address]]\n                        (let [manifest (jing/get handle address ::absent)]\n                          (when (= ::absent manifest) [name address])))\n                      requires)]\n    (cond\n      (seq (:ffi-ops own))\n      (refusal :yin.link.publish/ffi-op {:ffi-ops (:ffi-ops own)})\n\n      (seq (:parked-ids own))\n      (refusal :yin.link.publish/parked-id {:parked-ids (:parked-ids own)})\n\n      bad-primitive\n      (refusal :yin.link.publish/unprofiled-primitive\n               {:primitive bad-primitive})\n\n      missing\n      (refusal :yin.link.publish/missing-requirement\n               {:name (first missing) :manifest (second missing)})\n\n      :else\n      {:store-keys (:store-keys own)\n       :effects (into (or (:effects own) #{})\n                      (concat (mapcat :yin.k/effects (vals primitives))\n                              (mapcat (fn [address]\n                                        (get-in (jing/get handle address nil)\n                                                [:yin.module/footprint :effects]))\n                                      (vals requires))))})))\n\n\n(def code-formats\n  \"The four code format records a module manifest links through.\"\n  [linker/ast-format linker/semantic-format\n   linker/stack-format linker/register-format])\n\n\n(defn link-local\n  \"Link `format`'s image through the manifest `address` over `handle`'s\n   own content, `:verifying` with discharge deferred, as a serving\n   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\n   call, so no request reaches any peer.  `opts` overrides the link\n   options; its `:bounds` are the runtime's composition bounds (section\n   4.2 step 2), every one left out taking `linker/default-bounds`.\"\n  ([handle address format] (link-local handle address format nil))\n  ([handle address format opts]\n   (linker/link-manifest\n     (linker/local-runtime\n       handle {:formats (into {} (map (fn [f] [(:format f) f]))\n                              (conj code-formats linker/manifest-format\n                                    linker/record-format))\n               :bounds (:bounds opts)})\n     address (:format format) {:primitives vm/primitives}\n     (merge {:contract (:contract format)\n             :derivation :verifying\n             :defer-discharge true}\n            (dissoc opts :bounds)))))\n\n\n(defn- publish-closure!\n  \"`publish-module!` under the composition bounds of `opts`.\"\n  [handle {:keys [name ast exports requires primitives] :as spec} opts]\n  (let [undefined (first (remove (definitions ast) exports))\n        tree (when-not undefined\n               (try (vm/ast->semantic-bytecode ast)\n                    (catch #?(:cljd Object :clj Exception :cljs :default) _\n                      (refusal :yin.link.publish/malformed-tree {}))))\n        defect (when (and tree (not= :refused (:status tree)))\n                 (vm/validate-rows tree))\n        ;; each pinned closure is walked before anything is written; an\n        ;; absent pinned manifest is the footprint's missing-requirement\n        requirement\n        (when (and tree (not defect) (not= :refused (:status tree)))\n          (some (fn [[n address]]\n                  (let [w (closure/walk handle address opts)]\n                    (case (:yin.link.closure/outcome w)\n                      :complete nil\n                      :invalid (refusal :yin.link.publish/invalid-requirement\n                                        {:name n})\n                      :missing (when (not= address (:address w))\n                                 (refusal :yin.link.publish/incomplete-requirement\n                                          {:name n :walk w})))))\n                (sort-by (fn [[n _]] (str n)) requires)))\n        fp (when (and tree (not defect) (not requirement)\n                      (not= :refused (:status tree)))\n             (footprint handle (assoc spec :tree tree)))]\n    (cond\n      undefined\n      (refusal :yin.link.publish/undefined-export {:export undefined})\n\n    (eval-parsed* state trimmed parsed)))\n\n\n(defn- input-probe\n  \"The completeness probe of the session's frontend, or nil when it has\n   none or none is installed (the compile then reports it).\"\n  [state]\n  (:probe (usable-binding (select-frontend (:frontends state) (:lang state)))))\n\n\n(defn eval-input\n  \"Evaluate one input line locally, returning `[state text]`.\n\n   Input that is not yet a whole submission is retained as `:pending-input`\n   and produces no text: for a frontend with a `:probe` the probe decides\n   and the line is kept verbatim (whitespace can be inside a string);\n   otherwise the brackets must balance.  Nothing here is asynchronous: the\n   driver, not this namespace, decides when the next step happens.\"\n  [state line]\n  (let [probe (input-probe state)\n        pending (or (:pending-input state) \"\")\n        line (if probe line (str/trim line))\n        combined (if (str/blank? pending)\n                   line\n                   (str pending \"\\n\" line))]\n    (cond\n      (and probe (str/blank? combined))\n      [(assoc state :pending-input nil) \"\"]\n\n      (if probe\n        (= :incomplete (probe combined))\n        (pos? (bracket-balance combined)))\n      [(assoc state :pending-input combined) \"\"]\n\n      :else\n      (let [state' (assoc state :pending-input nil)\n            parsed (try {:forms (read-forms combined)}\n                        (catch #?(:cljd Object\n                                  :clj Exception\n                                  :cljs js/Error) error\n                          {:error error}))]\n        (eval-parsed state' combined parsed)))))\n\n\n(defn repl-state\n  \"A serializable summary of shell state.\n\n   The stream summaries read the ledger rather than asking a handle whether it\n   is closed: dao.stream has no `closed?`, and an idle medium has no last\n   operation.\n   The program media are the composition's own, observed beside the VM, so\n   the shell reports what it knows of them — the declared capacity, the gaps\n   the session's observers counted, and whether a loss has already refused\n   further evaluation.  Each `:pending` entry carries the link policy's\n   name (`:manual` or `:fn`) and the pending run's `:checks`, so a host\n   can display why a run is still waiting (yin.repl.link-policy.md\n   section 3.5).  `:macros` maps each macro the expander's store holds\n   to its lambda's root address (yin.vm.macro.md §10.1).  `:index` is the\n   code indexer's `yin.repl.index/status`: whether every committed program\n   is published, whether a gap lost the indexer, and its last failure.\n   `:index-publication` exposes the verified code-log cursor and covered\n   transaction count for owner diagnostics, never a substitute query view.\n   `:ast-index` is the AST indexer's `yin.repl.ast-index/status`: the sizes\n   of its `$ast` and `$occ` relations, whether a gap lost it, and why it\n   failed.\"\n  [state]\n  {:lang (:lang state)\n   :macros (into (sorted-map-by #(compare (str %1) (str %2)))\n                 (map (fn [[sym entry]]\n                        [sym (first (:yin.macro/tree entry))]))\n                 (get-in state [:expander :ctx :store]))\n   :vm {:type (:vm-type state)\n        :halted? (vm/halted? (:vm state))\n        :blocked? (vm/blocked? (:vm state))\n        :in-stream {:capacity ingress-capacity\n                    :gaps (ingress-gaps state)\n                    :lost? (boolean (:ingress-loss? state))}}\n   :running? (:running? state)\n   :output {:cursor (:output-cursor state)\n            :last-outcome (get-in state [:ledger :output] :untried)}\n   :pending (when-let [parked (:pending-run state)]\n(ns yang.php.antlr.lower\n  \"The PHP lowering interpreter: CST packets in, Universal AST program\n   batches out (docs/design/yang.php.md sections 3, 7). Portable.\n\n   Per packet: validate the tree, analyze scopes (`yang.php.antlr.scope`),\n   then lower with one `case` arm per grammar rule. A rule P1 does not lower\n   fails with `:yang.php/unsupported` naming the rule and construct; a rule\n   with no arm fails with `:yang.php/unhandled-rule`. Nothing is silently\n   dropped.\n\n   Decided lowering rules (collab/1792905000000 plan):\n   - A top-level `$x` is `(php/global-get \\\"x\\\")` / `(php/global-set! \\\"x\\\" v)`;\n     inside a function it is a lexical cell `$x` allocated at entry holding\n     `:php/undef`. Loops are self-applied `:loop`-marked lambdas whose\n     `break`/`continue` are `php/call-ec` escapes bound to `%brk<id>` and\n     `%cont<id>`, created only when the body uses them; the `:loops` stack of\n     the context resolves `break n`. `switch` is one stack level: a chain of\n     lambdas whose bodies tail-call the next case.\n   - A function is `(php/declare-function! name (php/make-function name spec\n     (fn [%fn %args] body) statics))`; top-level unconditional declarations\n     are hoisted. `return` is an escape from `php/call-ec`, bound only when\n     the body has a `return`.\n   - The unit is its hoisted top-level function declarations, then its\n     statements in order, run under `php/run-main`.\n   - Inline HTML is `(php/echo \\\"bytes\\\")`; `echo a, b` is\n     `(php/echo (php/to-string a))` per operand; a PHP string is a byte\n     carrier (a latin-1 string), literal text resolved here to UTF-8 bytes.\n   - `&&`, `||`, `and`, `or`, `?:` are `:if` nodes over `php/to-bool`, never\n     applications, so they short circuit. Every other operator is one\n     application of a `php/` function of the prelude.\n   - A call `f(a, b)` resolves `f` before any argument runs:\n     `(let [%f (php/resolve-fn \\\"f\\\" \\\"F\\\")] (php/call %f [a b]))`.\n   - Generated names are `%<prefix><cst-id>`; `%` cannot begin a PHP name, so\n     no guest name shadows a name the lowering emits. The lowering never\n     names a runtime key (`php.rt/*`).\n\n   Diagnostic namespace: \\\"yang.php\\\".\"\n  (:require\n    [clojure.string :as str]\n    [clojure.walk :as walk]\n    [dao.host.text :as text]\n    [dao.jing.cbor :as cbor]\n    [yang.antlr.packet :as p]\n    [yang.core.lower :as core]\n    [yang.core.module :as core-module]\n    [yang.core.stage :as core-stage]\n    [yang.core.uast :as u]\n    [yang.php.antlr.builtins :as builtins]\n    [yang.php.antlr.prelude :as prelude]\n    [yang.php.antlr.scope :as scope]\n    [yang.stage :as stage]\n    [yin.vm :as vm]\n    [yin.vm.integer :as integer]))\n\n\nsrc/cljc/yin/repl.cljc:1178:   forwarded packet as one transaction and publishes the covered indexes.\nsrc/cljc/yin/repl.cljc:2181:   transaction count for owner diagnostics, never a substitute query view.\nsrc/cljc/yin/repl.cljc:2210:                                   [:cursor :transactions :manifest-address])\nsrc/cljc/yin/repl/index.cljc:9:   (yin.vm.code-as-tuples.md §6.5) and committed as ONE atomic transaction\nsrc/cljc/yin/repl/index.cljc:19:   frontier: its log cursor, manifest and transaction count. Each fresh\nsrc/cljc/yin/repl/index.cljc:143:   transactions are committed to (dao.space.transactor requires memory-log\nsrc/cljc/yin/repl/index.cljc:156:   `{:cursor c :transactions n :manifest-address a :manifest m :max-t t}`.\nsrc/cljc/yin/repl/index.cljc:167:   :transactions 0\nsrc/cljc/yin/repl/index.cljc:193:   memory log holding the recovered datoms as transaction records, one\nsrc/cljc/yin/repl/index.cljc:198:   transaction, so `q` answers from it before anything new is evaluated.\nsrc/cljc/yin/repl/index.cljc:212:        (let [answer (stream/append! log {:dao.space/transaction\nsrc/cljc/yin/repl/index.cljc:213:                                          {:t t, :datoms (vec (get by-t t))}})]\nsrc/cljc/yin/repl/index.cljc:216:                            {:t t, :outcome answer})))))\nsrc/cljc/yin/repl/index.cljc:220:             :transactions (count ts)\nsrc/cljc/yin/repl/index.cljc:229:   transaction log, entity allocation, counts, published manifest, and\nsrc/cljc/yin/repl/index.cljc:237:         (select-keys previous [:local :next-e :transactions :published\nsrc/cljc/yin/repl/index.cljc:302:  \"Commit one packet as one transaction; its rows join `:unwritten`, which\nsrc/cljc/yin/repl/index.cljc:317:             (update :transactions inc)\nsrc/cljc/yin/repl/index.cljc:359:   composition's one-record-per-transaction log. A stale/foreign cursor,\nsrc/cljc/yin/repl/index.cljc:363:  (let [{:keys [cursor transactions manifest-address manifest max-t]}\nsrc/cljc/yin/repl/index.cljc:367:               (= transactions (:published ix))\nsrc/cljc/yin/repl/index.cljc:373:                         :ids nil :batch transactions :max-t max-t :rejected 0}\nsrc/cljc/yin/repl/index.cljc:377:              expected (- (:transactions ix) transactions)]\nsrc/cljc/yin/repl/index.cljc:420:  \"Publish the covered indexes over every committed transaction, using\nsrc/cljc/yin/repl/index.cljc:423:   answers becomes the reported one, covering `:published` transactions;\nsrc/cljc/yin/repl/index.cljc:440:                           :published (:transactions ix)\nsrc/cljc/yin/repl/index.cljc:443:                                             :transactions (:transactions ix)\nsrc/cljc/yin/repl/index.cljc:480:        committed? (> (:transactions ix) (:transactions indexer))\nsrc/cljc/yin/repl/index.cljc:492:   p}` -- as ONE transaction, then publish the covered indexes at once,\nsrc/cljc/yin/repl/index.cljc:497:   transaction refused is recorded as the failure, like a packet's.\"\nsrc/cljc/yin/repl/index.cljc:518:                           (update :transactions inc)\nsrc/cljc/yin/repl/index.cljc:541:  {:transactions (:transactions indexer)\nsrc/cljc/yin/repl/index.cljc:543:                    (= (:published indexer) (:transactions indexer)))\n","exit_code":1,"status":"failed"}}
