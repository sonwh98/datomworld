;; CPython itself (JVM only)
;; =============================================================================

#?(:cljd nil
   :clj
   (defn- python-expr
     [s]
     (if (str/starts-with? s "f:")
       (str "float(" (str/replace (subs s 2) "^" "**") ")")
       (str/replace s "^" "**"))))


