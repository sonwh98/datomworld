                            (:yin.k/cells lifted)\n   462\t                                          (registers-of entry))\n   463\t        e (:entry lowered)\n   464\t        rs (:resources lowered)\n   465\t        receiver (quiesced-receiver datoms lowered\n   466\t                                    (linked-machine 'host.the-module))]\n   467\t    (testing \"the machine parked through the engine, envelope retained\"\n   468\t      (is (vm/blocked? parked))\n   469\t      (is (= :link-request (:reason entry)))\n   470\t      (is (= module/link-request-resource (:request entry)))\n   471\t      (is (= module/link-response-resource (:response entry)))\n   472\t      (is (map? (:envelope entry)) \"the request the retry appends\"))\n   473\t    (testing \"the lower parks the wait where the engine polls\"\n   474\t      (is (= module/link-request-resource (:request e))\n   475\t          \"the retry appends at the engine's fixed request key\")\n   476\t      (is (= module/link-response-resource (:response e))\n   477\t          \"the poll reads at the engine's fixed response key\")\n   478\t      (is (contains? rs (:request e)))\n   479\t      (is (contains? rs (:response e))\n   480\t          \"the pair's reflections stand under the fixed keys\"))\n   481\t    (testing \"the engine's own poll retries and resumes the require\"\n   482\t      ;; the linker answered before the migration: the response sits\n   483\t      ;; on the emitter's response stream, past the kept cursor\n   484\t      (stream/append! resp-src\n   485\t                      {:status :ok,\n   486\t                       :yin.link/id (:link-id entry),\n   487\t                       :manifest {:yin.module/name 'host.the-module}})\n   488\t      (is (vm/blocked? (vm/run receiver))\n   489\t          \"first poll: the envelope is retried, the answer not yet read\")\n   490\t      (let [w0 (:dao.stream/cursor\n   491\t                 (stream/cursor req-src :dao.stream/oldest))]\n   492\t        (is (= :warmed\n   493\t               (:dao.stream/value (stream/next req-src w0)))\n   494\t            \"reading the warm-up frees the slot the retry needs\"))\n   495\t      (serve-mirror! peer)\n   496\t      (let [c0 (:dao.stream/cursor\n   497\t                 (stream/cursor req-src :dao.stream/oldest))\n   498\t            r (stream/next req-src c0)]\n   499\t        (is (= :dao.stream/ok (:dao.stream/outcome r)))\n   500\t        (is (= (:envelope entry) (:dao.stream/value r))\n   501\t            \"the envelope verbatim, appended via the fixed request key\"))\n   502\t      (let [done (vm/run receiver)]\n   503\t        (is (vm/halted? done))\n   504\t        (is (= 'host.the-module (vm/value done))\n   505\t            \"the require resumes with the module's own value\")\n   506\t        (is (empty? (:wait-set done)))))))\n   507\t\n   508\t\n   509\t(deftest a-retained-ffi-request-migrates-and-the-retry-resumes\n   510\t  (let [t (toy)\n   511\t        peer (served-peer t)\n   512\t        serve! (server peer (:channel t) #{:reader :writer})\n   513\t        attach! (attacher t)\n   514\t        program (then (call-node :op/echo \"hello\")\n   515\t                      (call-node :op/echo \"world\"))\n   516\t        [datoms parked entry call-in-src call-out-src]\n   517\t        (parked-caller program)\n   518\t        kept (get-in parked [:resources vm/call-out-cursor-key :cursor])\n   519\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   520\t        pending (:yin.k/pending lifted)\n   521\t        ;; the resumer's own pair and its own handler, under the fixed\n   522\t        ;; keys: they serve the program's subsequent calls and can\n   523\t        ;; never answer the migrated one\n   524\t        own-call-in (ring 8)\n   525\t        own-call-out (ring 8)\n   526\t        own (calling-machine own-call-in own-call-out\n   527\t                             {:op/echo (constantly \"local!\")})\n   528\t        own-pair (select-keys (:resources own)\n   529\t                              [vm/call-in-stream-key\n   530\t                               vm/call-out-stream-key\n   531\t                               vm/call-out-cursor-key])\n   532\t        lowered (ucf.remote/lower-pending attach! pending\n   533\t                                          (:yin.k/cells lifted)\n   534\t                                          (registers-of entry)\n   535\t                                          (keys own-pair))\n   536\t        e (:entry lowered)\n   537\t        rs (:resources lowered)\n   538\t        receiver (-> (quiesced-receiver datoms lowered own)\n   539\t                     (update :resources #(merge own-pair %)))\n   540\t        oldest (fn [h]\n   541\t                 (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n   542\t        ;; the emitter's bridge answered the migrated call before the\n   543\t        ;; migration: the response sits on the emitter's call-out,\n   544\t        ;; past the kept cursor\n   545\t        _ (stream/append! call-out-src\n   546\t                          (apply2/success-response\n   547\t                            (:call-id entry) \"echo!\"))\n   548\t        ;; phase 1: the sweep retries the retained request through the\n   549\t        ;; carried request reflection, and the restored response wait\n   550\t        ;; polls the carried response route\n   551\t        r1 (vm/run receiver)\n   552\t        wait-a (first (:wait-set r1))\n   553\t        warm-up (stream/next call-in-src (oldest call-in-src))\n   554\t        _ (serve-mirror! peer)\n   555\t        landed (stream/next call-in-src (oldest call-in-src))\n   556\t        ;; phase 2: the carried route delivers the response; the\n   557\t        ;; program's own next call parks on the receiver's local pair\n   558\t        ;; and its own handler answers it there\n   559\t        r2 (vm/run r1)]\n   560\t    (testing \"the machine parked through the engine, request retained\"\n   561\t      (is (vm/blocked? parked))\n   562\t      (is (true? (:request-sent entry)))\n   563\t      (is (= vm/call-in-stream-key (:stream-id entry)))\n   564\t      (is (apply2/request? (:datom entry))))\n   565\t    (testing \"the lift carries both endpoints and the kept response cell\"\n   566\t      (is (contains? pending :yin.k/request))\n   567\t      (is (contains? pending :yin.k/response)\n   568\t          \"both endpoint markers ride beside the retained envelope\")\n   569\t      (is (= :yin.k/c-0 (:yin.k/response-cell pending)))\n   570\t      (is (= (get-in pending [:yin.k/response :dao.stream/identity])\n   571\t             (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/stream\n   572\t                             :dao.stream/identity]))\n   573\t          \"the response endpoint's marker is the route cell's stream\")\n   574\t      (is (= kept\n   575\t             (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   576\t          \"the kept response position\"))\n   577\t    (testing \"the lower allocates fresh keys and carries the route\"\n   578\t      (is (contains? rs (:stream-id e))\n   579\t          \"the retry writes through the carried request reflection\")\n   580\t      (is (not= vm/call-in-stream-key (:stream-id e))\n   581\t          \"never the receiver's own call-in key\")\n   582\t      (is (not (contains? rs vm/call-in-stream-key)))\n   583\t      (is (not (contains? rs vm/call-out-stream-key)))\n   584\t      (is (not (contains? rs vm/call-out-cursor-key))\n   585\t          \"no route is ever installed at a fixed key\")\n   586\t      (is (= (:response-cursor e) (get-in wait-a [:cursor-ref :id]))\n   587\t          \"the restored response wait polls the carried cell's key\")\n   588\t      (is (= (:response-stream e) (:stream-id wait-a))\n   589\t          \"reading the carried response reflection\")\n   590\t      (let [route (get rs (:response-cursor e))]\n   591\t        (is (= kept (:cursor route))\n   592\t            \"at the kept response position\")\n   593\t        (is (= (:response-stream e) (:stream-id route))\n   594\t            \"naming the carried response reflection\")\n   595\t        (is (contains? rs (:response-stream e)))))\n   596\t    (testing \"the retried call is answered on the emitter's pair\"\n   597\t      (is (vm/blocked? r1)\n   598\t          \"first round: the request is retried, the response not yet\n   599\t           read\")\n   600\t      (is (= :warmed (:dao.stream/value warm-up))\n   601\t          \"reading the warm-up freed the slot the retry needed\")\n   602\t      (is (= :dao.stream/ok (:dao.stream/outcome landed)))\n   603\t      (is (= (:datom entry) (:dao.stream/value landed))\n   604\t          \"the retained request verbatim, through the carried request\n   605\t           reflection\")\n   606\t      (is (= \"echo!\"\n   607\t             (apply2/response-ok\n   608\t               (:dao.stream/value\n   609\t                 (stream/next call-out-src (oldest call-out-src)))))\n   610\t          \"the emitter's bridge answered it on the emitter's pair\"))\n   611\t    (testing \"the carried route delivers, and later calls are local\"\n   612\t      (is (vm/halted? r2))\n   613\t      (is (= \"local!\" (vm/value r2))\n   614\t          \"the migrated result came from the emitter's bridge; the\n   615\t           receiver's own handler answered only the program's own next\n   616\t           call\")\n   617\t      (is (not= kept (:cursor (get-in r2 [:resources\n   618\t                                          (:response-cursor e)])))\n   619\t          \"the carried route's cursor advanced: the response was read\n   620\t           through it\")\n   621\t      (is (= [\"world\"]\n   622\t             (apply2/request-args\n   623\t               (:dao.stream/value\n   624\t                 (stream/next own-call-in (oldest own-call-in)))))\n   625\t          \"the subsequent call's request is on the receiver's own\n   626\t           call-in\")\n   627\t      (is (= \"local!\"\n   628\t             (apply2/response-ok\n   629\t               (:dao.stream/value\n   630\t                 (stream/next own-call-out (oldest own-call-out)))))\n   631\t          \"and its answer is on the receiver's own call-out\"))))\n   632\t\n   633\t\n   634\t;; =============================================================================\n   635\t;; Unsatisfied: an unpublishable cursor, a source that cannot be\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '490,760p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '490,760p'\"","aggregated_output":"   490\t  [used]\n   491\t  (loop [n (inc (count @used))]\n   492\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n   493\t      (if (contains? @used k)\n   494\t        (recur (inc n))\n   495\t        (do (swap! used conj k) k)))))\n   496\t\n   497\t\n   498\t(defn- pending-markers\n   499\t  \"Every stream marker `pending` names beside its cells' -- the\n   500\t   target of a put, both endpoints of a retained call, the pair of\n   501\t   a link request.\"\n   502\t  [pending]\n   503\t  (case (:yin.k/reason pending)\n   504\t    :put [(:yin.k/stream pending)]\n   505\t    :ffi-request [(:yin.k/request pending)\n   506\t                  (:yin.k/response pending)]\n   507\t    (:link-request :link-response)\n   508\t    [(:yin.k/request pending)\n   509\t     (:yin.k/response pending)]\n   510\t    []))\n   511\t\n   512\t\n   513\t(defn- attach-all\n   514\t  \"One attach per distinct stream identity. The first attach that\n   515\t   does not answer ok -- a reflection marked gone included -- refuses\n   516\t   the lower as `:yin.k/unsatisfied` naming that identity. Returns\n   517\t   {:handles {identity handle}}; `lower-frame` allocates each\n   518\t   reflection its own collision-free resource key.\"\n   519\t  [attach! markers]\n   520\t  (let [by-id (reduce (fn [m mkr]\n   521\t                        (update m (:dao.stream/identity mkr) #(or % mkr)))\n   522\t                      {} markers)]\n   523\t    (reduce-kv (fn [acc identity mkr]\n   524\t                 (if-let [h (lower-marker attach! mkr)]\n   525\t                   (assoc-in acc [:handles identity] h)\n   526\t                   (reduced (unsatisfied identity))))\n   527\t               {:handles {}}\n   528\t               by-id)))\n   529\t\n   530\t\n   531\t(defn- cell-resources\n   532\t  \"The fresh cursor entry each UCF cell lowers to, under the key\n   533\t   `cell-keys` allocated for it: its carried position, on the\n   534\t   reflection of the stream the cell names. Two references to one\n   535\t   cell share the one entry, and one ref per cell keeps its own\n   536\t   (S7.5.3); equal cell ids across separately lowered frames got\n   537\t   different keys, so no two frames ever share an entry. A response\n   538\t   route is no exception: it lowers under its own fresh key, never\n   539\t   at a fixed key, so distinct routes stay distinct and no migrated\n   540\t   route can ever misroute a new call.\"\n   541\t  [streams cells cell-keys]\n   542\t  (into {}\n   543\t        (map (fn [[cid cell]]\n   544\t               [(cell-keys cid)\n   545\t                {:stream-id (streams (cell-identity cells cid)),\n   546\t                 :cursor (:yin.k/position cell)}]))\n   547\t        cells))\n   548\t\n   549\t\n   550\t(defn- link-pair-resources\n   551\t  \"The engine's fixed link keys (`module/link-request-resource`,\n   552\t   `module/link-response-resource`) mapped onto the reflections a\n   553\t   lowered link wait uses: the engine's sweep retries a\n   554\t   `:link-request` by appending at the fixed request key\n   555\t   (`module/append-link-request`) and polls a `:link-response` at the\n   556\t   fixed response key (`poll-link-response`), so a lowered link wait\n   557\t   parks where the engine looks. One pair per task: the identity of\n   558\t   each side rides the pending's own markers.\"\n   559\t  [streams resources pendings]\n   560\t  (reduce (fn [acc pending]\n   561\t            (if (contains? #{:link-request :link-response}\n   562\t                           (:yin.k/reason pending))\n   563\t              (let [req-id (get-in pending [:yin.k/request\n   564\t                                            :dao.stream/identity])\n   565\t                    resp-id (get-in pending [:yin.k/response\n   566\t                                             :dao.stream/identity])\n   567\t                    req (get resources (streams req-id))\n   568\t                    resp (get resources (streams resp-id))]\n   569\t                (if (and req resp)\n   570\t                  (assoc acc\n   571\t                         module/link-request-resource req,\n   572\t                         module/link-response-resource resp)\n   573\t                  acc))\n   574\t              acc))\n   575\t          {}\n   576\t          pendings))\n   577\t\n   578\t\n   579\t(defn- lower-one\n   580\t  \"One pending of S7.4.3, lowered: `{:entry e}` -- the wait-set\n   581\t   entry the receiver parks, the caller's register context `ctx`\n   582\t   merged verbatim under the stream and cell fields the data\n   583\t   rebuilds -- or an outcome carrying `:yin.k/status`, naming the\n   584\t   stream identity where one is known. Every wait polls the key\n   585\t   `cell-keys` allocated for its cell, reading the stream key\n   586\t   `streams` allocated for the cell's reflection: migrated waits\n   587\t   poll routes no new call shares. A retained request's retry\n   588\t   writes through the request reflection's allocated key and stamps\n   589\t   the carried response route (`:response-cursor`,\n   590\t   `:response-stream`) for its restore.\"\n   591\t  [pending ctx streams cells cell-keys]\n   592\t  (case (:yin.k/reason pending)\n   593\t    :next\n   594\t    (let [cid (:yin.k/cell pending)]\n   595\t      (if-let [sid (streams (cell-identity cells cid))]\n   596\t        {:entry (merge ctx\n   597\t                       {:reason :next,\n   598\t                        :stream-id sid,\n   599\t                        :cursor-ref {:type :cursor-ref,\n   600\t                                     :id (cell-keys cid)}})}\n   601\t        (unsatisfied (cell-identity cells cid))))\n   602\t\n   603\t    :put\n   604\t    (if-let [sid (streams (get-in pending [:yin.k/stream\n   605\t                                           :dao.stream/identity]))]\n   606\t      {:entry (merge ctx\n   607\t                     {:reason :put,\n   608\t                      :stream-id sid,\n   609\t                      :datom (:yin.k/value pending)})}\n   610\t      (unsatisfied (get-in pending [:yin.k/stream :dao.stream/identity])))\n   611\t\n   612\t    :ffi\n   613\t    (let [cid (:yin.k/cell pending)]\n   614\t      (if-let [sid (streams (cell-identity cells cid))]\n   615\t        {:entry (merge ctx\n   616\t                       (cond-> {:reason :next,\n   617\t                                :call-id (:yin.k/call-id pending),\n   618\t                                :stream-id sid,\n   619\t                                :cursor-ref {:type :cursor-ref,\n   620\t                                             :id (cell-keys cid)}}\n   621\t                         (contains? pending :yin.k/op)\n   622\t                         (assoc :op (:yin.k/op pending))))}\n   623\t        (unsatisfied (cell-identity cells cid))))\n   624\t\n   625\t    :ffi-request\n   626\t    (let [req-id (get-in pending [:yin.k/request\n   627\t                                  :dao.stream/identity])\n   628\t          resp-id (get-in pending [:yin.k/response\n   629\t                                   :dao.stream/identity])]\n   630\t      (if-let [req (streams req-id)]\n   631\t        (if-let [resp (streams resp-id)]\n   632\t          {:entry (merge ctx\n   633\t                         {:reason :put,\n   634\t                          :request-sent true,\n   635\t                          :call-id (:yin.k/call-id pending),\n   636\t                          :op (:yin.k/request-op pending),\n   637\t                          :stream-id req,\n   638\t                          :datom (apply2/request\n   639\t                                   (:yin.k/call-id pending)\n   640\t                                   (:yin.k/request-op pending)\n   641\t                                   (:yin.k/request-args pending)),\n   642\t                          :response-cursor\n   643\t                          (cell-keys (:yin.k/response-cell pending)),\n   644\t                          :response-stream resp})}\n   645\t          (unsatisfied resp-id))\n   646\t        (unsatisfied req-id)))\n   647\t\n   648\t    (:link-request :link-response)\n   649\t    (let [reason (:yin.k/reason pending)\n   650\t          cid (:yin.k/cell pending)\n   651\t          sid (streams (cell-identity cells cid))\n   652\t          req (streams (get-in pending [:yin.k/request\n   653\t                                        :dao.stream/identity]))]\n   654\t      (if (and sid req)\n   655\t        {:entry (merge ctx\n   656\t                       (cond-> {:reason reason,\n   657\t                                :link-id (:yin.k/link-id pending),\n   658\t                                :name (:yin.k/name pending),\n   659\t                                :request module/link-request-resource,\n   660\t                                :response module/link-response-resource,\n   661\t                                :cursor (:yin.k/position (get cells cid))}\n   662\t                         (= :link-request reason)\n   663\t                         (assoc :envelope (:yin.k/envelope pending))))}\n   664\t        (unsatisfied (cell-identity cells cid))))\n   665\t\n   666\t    :install\n   667\t    {:entry (merge ctx\n   668\t                   {:reason :install, :name (:yin.k/name pending)})}\n   669\t\n   670\t    {:yin.k/status :yin.k/undecodable,\n   671\t     :yin.k/reason (:yin.k/reason pending)}))\n   672\t\n   673\t\n   674\t(defn lower-frame\n   675\t  \"A whole frame set of S7.4.3 pendings, lowered together as one\n   676\t   batch: `{:entries [e ...], :resources table}` -- one private\n   677\t   resource key allocated per distinct served identity and one per\n   678\t   distinct UCF cell, two waiters on one cell lowering back into one\n   679\t   shared entry and independent cells staying independent (S7.5.3);\n   680\t   equal cell ids across separately lowered frames get different\n   681\t   keys. `occupied` is the receiver's existing resource keys: every\n   682\t   allocated key is checked against it, against the VM's fixed\n   683\t   resource keys, and against keys already allocated in the batch,\n   684\t   regenerating on collision. With the same `:yin.k/unsatisfied` and\n   685\t   `:yin.k/undecodable` outcomes `lift-frame` gives. Where the engine\n   686\t   resolves a wait at one of its own fixed resource keys, the lower\n   687\t   parks the wait there: a link wait's pair under\n   688\t   `module/link-request-resource` and `module/link-response-resource`.\n   689\t   A retained request's retry writes through its carried request\n   690\t   reflection's allocated key and stamps the carried response route\n   691\t   (`:response-cursor`, `:response-stream`) for its restore.\n   692\t   `contexts`, parallel to `pendings`, is each entry's register\n   693\t   context, merged verbatim.\"\n   694\t  ([attach! pendings cells contexts]\n   695\t   (lower-frame attach! pendings cells contexts nil))\n   696\t  ([attach! pendings cells contexts occupied]\n   697\t   (let [ms (distinct (remove nil?\n   698\t                              (concat (map :yin.k/stream (vals cells))\n   699\t                                      (mapcat pending-markers pendings))))\n   700\t         a (attach-all attach! ms)]\n   701\t     (if (contains? a :yin.k/status)\n   702\t       a\n   703\t       (let [used (atom (into fixed-resource-keys occupied))\n   704\t             handles (:handles a)\n   705\t             streams (into {}\n   706\t                           (map (fn [identity]\n   707\t                                  [identity (fresh-key used)]))\n   708\t                           (sort-by str (keys handles)))\n   709\t             resources (into {}\n   710\t                             (map (fn [[identity sid]]\n   711\t                                    [sid (handles identity)]))\n   712\t                             streams)\n   713\t             cell-keys (into {}\n   714\t                             (map (fn [cid] [cid (fresh-key used)]))\n   715\t                             (sort-by str (keys cells)))\n   716\t             lowered (mapv #(lower-one %1 %2 streams cells cell-keys)\n   717\t                           pendings contexts)]\n   718\t         (if-let [refusal (some #(when (contains? % :yin.k/status) %)\n   719\t                                lowered)]\n   720\t           refusal\n   721\t           {:entries (mapv :entry lowered),\n   722\t            :resources (merge resources\n   723\t                              (cell-resources streams cells cell-keys)\n   724\t                              (link-pair-resources streams resources\n   725\t                                                   pendings))}))))))\n   726\t\n   727\t\n   728\t(defn lower-pending\n   729\t  \"One pending entry of S7.4.3, lowered: `{:entry e, :resources\n   730\t   table}` -- the wait-set entry `ctx`'s registers ride on, and the\n   731\t   fresh resource entries it polls through -- with the same\n   732\t   `:yin.k/unsatisfied` and `:yin.k/undecodable` outcomes\n   733\t   `lower-frame` gives. `occupied` is the receiver's existing\n   734\t   resource keys, as `lower-frame`'s. Frame assembly that shares\n   735\t   cursor entries across entries is `lower-frame`'s.\"\n   736\t  ([attach! pending cells ctx]\n   737\t   (lower-pending attach! pending cells ctx nil))\n   738\t  ([attach! pending cells ctx occupied]\n   739\t   (let [r (lower-frame attach! [pending] cells [ctx] occupied)]\n   740\t     (if (contains? r :yin.k/status)\n   741\t       r\n   742\t       (-> r\n   743\t           (assoc :entry (first (:entries r)))\n   744\t           (dissoc :entries))))))\n","exit_code":0,"status":"completed"}}
