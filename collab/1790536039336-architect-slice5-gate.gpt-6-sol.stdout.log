            its reflection, never as the grantor's :lapsed record\"\n   668\t    (let [ab (new-buffer 64)\n   669\t          ba (new-buffer 64)\n   670\t          channel {:dao.stream/type :dao.stream.test/channel\n   671\t                   :dao.stream/identity \"lease-composition-channel\"}\n   672\t          served (new-buffer 8)\n   673\t          _ (append-ok! served :v1)\n   674\t          table (atom {\"served-1\" {:handle served :surface #{:reader}}})\n   675\t          mirror (atom (:dao.stream/cursor (ds/cursor ab ds/anchor-oldest)))\n   676\t          serve! (fn [] (swap! mirror #(remote/mirror-step @table ab % ba)))\n   677\t          attach! (remote/attacher\n   678\t                    {:dao.stream.remote/channels {channel {:reader ba\n   679\t                                                           :writer ab}}})\n   680\t          refl (:dao.stream/handle\n   681\t                 (attach! {:dao.stream/type :dao.stream/remote\n   682\t                           :dao.stream/identity \"served-1\"\n   683\t                           :dao.stream/channel channel}))\n   684\t          system (composed {:reclaim (fn [subject]\n   685\t                                       (swap! table dissoc subject)\n   686\t                                       true)})\n   687\t          system (-> system\n   688\t                     (update :judge lease/author-grant\n   689\t                             (lease/grant :l1 \"served-1\" :holder-a {:ms 10}))\n   690\t                     (tick! 1)\n   691\t                     step!)]\n   692\t      ;; after the initial tick: the holder's reflection resolves and\n   693\t      ;; reads the served entry\n   694\t      (serve!)\n   695\t      (ds/cursor refl :dao.stream/oldest)\n   696\t      (serve!)\n   697\t      (let [c0 (:dao.stream/cursor (ds/cursor refl :dao.stream/oldest))]\n   698\t        (is (= :dao.stream/blocked (:dao.stream/outcome (ds/next refl c0))))\n   699\t        (serve!)\n   700\t        (is (= :v1 (:dao.stream/value (ds/next refl c0)))\n   701\t            \"the reflection resolved and reads the served entry\")\n   702\t        (let [system (-> system (fact! (lease/renewal :l1)) (tick! 7) step!)]\n   703\t          (is (= {:ms 7} (get-in system [:judge :ledger :l1 :last-observation]))\n   704\t              \"the renewal on the per-author medium counted as evidence\")\n   705\t          (let [system (-> system (tick! 18) step!)]\n     1\t(ns yin.repl.serve-connect-wire-test\n     2\t  \"The demo REPL flow over a real JVM WebSocket: `serve!` and `connect`\n     3\t   composed together, over `dao.stream.remote`'s requests/answers\n     4\t   reflection pair, with no fake transport anywhere in the path.\"\n     5\t  (:require [clojure.test :refer [deftest is]]\n     6\t            [yin.repl.adapter :as adapter]\n     7\t            [yin.repl.connect :as connect]\n     8\t            [yin.repl.host.jvm :as host]\n     9\t            [yin.repl.serve :as serve])\n    10\t  (:import [java.net ServerSocket]))\n    11\t\n    12\t\n    13\t(defn- free-port\n    14\t  []\n    15\t  (with-open [socket (ServerSocket. 0)]\n    16\t    (.getLocalPort socket)))\n    17\t\n    18\t\n    19\t(defn- await-pred\n    20\t  [pred]\n    21\t  (let [deadline (+ (System/currentTimeMillis) 5000)]\n    22\t    (loop []\n    23\t      (or (pred)\n    24\t          (when (< (System/currentTimeMillis) deadline)\n    25\t            (Thread/sleep 5)\n    26\t            (recur))))))\n    27\t\n    28\t\n    29\t(defn- start-server!\n    30\t  [port]\n    31\t  (let [state (atom (serve/serve! {:bind-port port :host (host/websocket)}))\n    32\t        running (atom true)\n    33\t        ticker (doto (Thread.\n    34\t                       (fn []\n    35\t                         (while @running\n    36\t                           (swap! state serve/step (System/currentTimeMillis))\n    37\t                           (Thread/sleep 5)))\n    38\t                       \"serve-connect-wire-test\")\n    39\t                 (.setDaemon true)\n    40\t                 (.start))]\n    41\t    {:state state\n    42\t     :stop! (fn [] (reset! running false) (.join ticker 1000))}))\n    43\t\n    44\t\n    45\t(defn- warm-up!\n    46\t  \"Drive the connection's dial and poll its RPC client for a while before\n    47\t   anything is submitted: the answers reflection's `:dao.stream/newest`\n    48\t   mint (docs/design/dao.stream.remote.md section 5's Linda mint) and the\n    49\t   underlying WebSocket handshake both settle asynchronously, and only\n    50\t   `poll!` retries the mint.  Submitting before it settles is exactly the\n    51\t   ordering the section-5 toy warns against: a mint that resolves after a\n    52\t   request already answered would orphan that answer.\"\n    53\t  [connection adapter-state]\n    54\t  (await-pred\n    55\t    (fn []\n    56\t      (connect/step! @connection)\n    57\t      (let [polled (adapter/poll-responses @adapter-state 8)]\n    58\t        (reset! adapter-state (:yin.repl.adapter/state polled))\n    59\t        (not= :dao.stream/newest\n    60\t              (:cursor (:yin.repl.adapter/rpc @adapter-state)))))))\n    61\t\n    62\t\n    63\t(defn- submit-with-retry!\n    64\t  \"Retry `adapter/submit-input` until the request lands: the requests\n    65\t   reflection's writer may answer `:dao.stream/full` for a moment right\n    66\t   after attach, while the underlying WebSocket handshake is still\n    67\t   settling.  `rpc/request!` retains the same allocated envelope across\n    68\t   calls while `:unsent`, ignoring `input` on a retry, exactly as\n    69\t   `yin.repl.driver`'s own `retry-unsent` does.\"\n    70\t  [connection adapter-state input]\n    71\t  (await-pred\n    72\t    (fn []\n    73\t      (connect/step! @connection)\n    74\t      (let [result (adapter/submit-input @adapter-state input)]\n    75\t        (reset! adapter-state (:yin.repl.adapter/state result))\n    76\t        (not= :yin.repl.adapter/pending-request\n    77\t              (:yin.repl.adapter/outcome result))))))\n    78\t\n    79\t\n    80\t(defn- poll-until-event!\n    81\t  [connection adapter-state]\n    82\t  (let [events (atom [])]\n    83\t    (await-pred\n    84\t      (fn []\n    85\t        (connect/step! @connection)\n    86\t        (let [polled (adapter/poll-responses @adapter-state 8)]\n    87\t          (reset! adapter-state (:yin.repl.adapter/state polled))\n    88\t          (swap! events into (:yin.repl.adapter/events polled))\n    89\t          (seq @events))))\n    90\t    @events))\n    91\t\n    92\t\n    93\t(deftest eval-round-trips-then-disconnect-and-reattach-over-a-real-socket\n    94\t  (let [port (free-port)\n    95\t        {:keys [state stop!]} (start-server! port)]\n    96\t    (try\n    97\t      (is (await-pred #(= :running (:status @state))))\n    98\t      (let [url (str \"daostream:ws://127.0.0.1:\" port \"/repl\")\n    99\t            opened (connect/open {:url url :host (host/websocket)})]\n   100\t        (is (= :yin.repl.connect/attached (get opened connect/outcome-key)))\n   101\t        (let [connection (atom (get opened connect/connection-key))\n   102\t              adapter-state (atom (adapter/state (get opened connect/client-key)))]\n   103\t          (is (= :established (:status @connection)))\n   104\t\n   105\t          (is (warm-up! connection adapter-state))\n   106\t          (is (submit-with-retry! connection adapter-state \"(+ 1 2)\"))\n   107\t          (let [events (poll-until-event! connection adapter-state)]\n   108\t            (is (= :yin.repl.adapter/response\n   109\t                   (:yin.repl.adapter/event (first events))))\n   110\t            (is (= \"3\" (:yin.repl.adapter/value (first events)))))\n   111\t\n   112\t          (connect/close! @connection)\n   113\t          (is (await-pred\n   114\t                #(do\n   115\t                   (connect/step! @connection)\n   116\t                   (let [polled (adapter/poll-responses @adapter-state 8)]\n   117\t                     (reset! adapter-state (:yin.repl.adapter/state polled))\n   118\t                     (= :dao.stream.apply/detached\n   119\t                        (:terminal (:yin.repl.adapter/rpc @adapter-state)))))))\n   120\t\n   121\t          (let [reattached (connect/reattach\n   122\t                             @connection (:yin.repl.adapter/rpc @adapter-state))]\n   123\t            (is (= :yin.repl.connect/reattached\n   124\t                   (get reattached connect/outcome-key)))\n   125\t            (reset! connection (get reattached connect/connection-key))\n   126\t            (swap! adapter-state assoc :yin.repl.adapter/rpc\n   127\t                   (get reattached connect/client-key)))\n   128\t          (is (= :established (:status @connection)))\n   129\t\n   130\t          (is (submit-with-retry! connection adapter-state \"(+ 40 2)\"))\n   131\t          (let [events (poll-until-event! connection adapter-state)]\n   132\t            (is (= \"42\" (:yin.repl.adapter/value (first events)))))))\n   133\t      (finally (stop!)))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/remote.cljc | sed -n '580,665p'; nl -ba src/cljc/yin/repl/main.cljc | sed -n '175,225p'; nl -ba src/cljc/dao/stream/ws.cljc | sed -n '240,335p'; rg -n ':ws/disclaim|:ws/accept|close-ended\"'!|:served'\"' src/cljc/dao/stream/ws.cljc src/cljc/dao/stream/ws_project.cljc src/cljc/yin/repl\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/remote.cljc | sed -n '580,665p'; nl -ba src/cljc/yin/repl/main.cljc | sed -n '175,225p'; nl -ba src/cljc/dao/stream/ws.cljc | sed -n '240,335p'; rg -n ':ws/disclaim|:ws/accept|close-ended\"'!|:served'\"' src/cljc/dao/stream/ws.cljc src/cljc/dao/stream/ws_project.cljc src/cljc/yin/repl\"","aggregated_output":"   580\t\n   581\t(defn- refl-cursor\n   582\t  \"The cursor operation: a filed answer for the anchor is returned,\n   583\t   and a filed protocol error translated; otherwise a cursor request\n   584\t   is sent if none is outstanding, and the answer is transport-error\n   585\t   with :dao.stream/retry? true. Once closed, cursor answers closed;\n   586\t   once gone, transport-error naming not-found.\"\n   587\t  [refl a]\n   588\t  (let [link (:link @refl)]\n   589\t    (drain! link)\n   590\t    (cond\n   591\t      (:closed? @refl) (result :dao.stream/closed)\n   592\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   593\t      (surface-lacks? refl :dao.stream/cursor)\n   594\t      (translated :dao.stream.remote/no-surface)\n   595\t      :else\n   596\t      (or (filed-cursor link refl a)\n   597\t          (when-not (:channel-gone? @link)\n   598\t            (send-or-count! link refl :dao.stream/cursor a)\n   599\t            (retry-read))\n   600\t          (translated :dao.stream.remote/channel-gone)))))\n   601\t\n   602\t\n   603\t(defn- refl-next\n   604\t  \"The next operation: a filed answer for the cursor is returned and\n   605\t   forgotten; otherwise a next request is sent if none is outstanding,\n   606\t   and the answer is blocked -- nothing is observable at this position\n   607\t   through this handle yet. After close, filed outcomes then end. The\n   608\t   reflection never judges a cursor: cursor-mismatch and\n   609\t   invalid-cursor are only ever relayed from the source.\"\n   610\t  [refl c]\n   611\t  (let [link (:link @refl)]\n   612\t    (drain! link)\n   613\t    (cond\n   614\t      (:closed? @refl)\n   615\t      (or (filed-next! link refl c) (result :dao.stream/end))\n   616\t\n   617\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   618\t\n   619\t      (surface-lacks? refl :dao.stream/next)\n   620\t      (translated :dao.stream.remote/no-surface)\n   621\t\n   622\t      :else\n   623\t      (or (filed-next! link refl c)\n   624\t          (when-not (:channel-gone? @link)\n   625\t            (send-or-count! link refl :dao.stream/next c)\n   626\t            (result :dao.stream/blocked))\n   627\t          (translated :dao.stream.remote/channel-gone)))))\n   628\t\n   629\t\n   630\t(defn- refl-append\n   631\t  \"The append! operation: send the request and return the channel\n   632\t   writer's outcome -- ok is acceptance on the outbound path, exactly\n   633\t   the contract's Writing rule for a transport that carries values\n   634\t   toward a stream elsewhere. The source's outcome is emitted on the\n   635\t   event writer when it is filed, correlated by id; append! never\n   636\t   answers the source's full. Only an accepted send is in flight: a\n   637\t   refused append! never crossed, so its effect is not unknown.\"\n   638\t  [refl v]\n   639\t  (let [link (:link @refl)]\n   640\t    (drain! link)\n   641\t    (cond\n   642\t      (:closed? @refl) (result :dao.stream/closed)\n   643\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   644\t      (surface-lacks? refl :dao.stream/append!)\n   645\t      (translated :dao.stream.remote/no-surface)\n   646\t      :else\n   647\t      (let [req (wire-request link refl :dao.stream/append! [v])\n   648\t            r (stream/append! (:writer @link) req)]\n   649\t        (when (= :dao.stream/ok (:dao.stream/outcome r))\n   650\t          (register! link refl req))\n   651\t        r))))\n   652\t\n   653\t\n   654\t(defn- refl-close\n   655\t  \"The close! operation, local: the reflection forgets its\n   656\t   outstanding ids and its kept, unsent probe, reporting each\n   657\t   outstanding append! on the event writer as append-unknown -- an\n   658\t   append whose answer never arrives has unknown effect; afterwards\n   659\t   append! answers closed, cursor answers closed, next answers filed\n   660\t   outcomes then end, and nothing crosses the wire. Idempotent, per\n   661\t   the contract's Close.\"\n   662\t  [refl]\n   663\t  (let [link (:link @refl)]\n   664\t    (swap! link update :pending\n   665\t           (fn [kept]\n   175\t   (let [result (request-stop! state)]\n   176\t     (when w (wake/nudge! w))\n   177\t     result)))\n   178\t\n   179\t\n   180\t(defn stop-tick\n   181\t  \"One shutdown tick for an endpoint that has already been asked to stop.\n   182\t   Returns `[server lines stopped?]`.\n   183\t\n   184\t   `serve/stopped?` is the whole of the exit condition: an endpoint that never\n   185\t   bound is done on the first tick, because no host exists to report a\n   186\t   `:stopped` fact for it.\"\n   187\t  [server now]\n   188\t  (let [server' (serve/step server now)\n   189\t        [entries server''] (serve/take-outbox server')]\n   190\t    [server'' (mapv entry-text entries) (serve/stopped? server'')]))\n   191\t\n   192\t\n   193\t;; =============================================================================\n   194\t;; clj — a reader thread that only appends, and one owned poller thread\n   195\t;; =============================================================================\n   196\t\n   197\t#?(:cljd nil\n   198\t   :clj\n   199\t   (do\n   200\t     (defn- print-prompt!\n   201\t       []\n   202\t       (print prompt)\n   203\t       (flush))\n   204\t\n   205\t     (defn- drain-server!\n   206\t       \"The shell has quit, so the endpoint stops before the host exits: ask it\n   207\t        once, then keep stepping until it reports `:stopped` or the bounded\n   208\t        budget runs out.  A connected client must observe `:ws/ended`, not the\n   209\t        `:ws/closed` a process exit would leave behind.  The bounded drain\n   210\t        sleeps the base interval — it is a budget, not a cadence.\"\n   211\t       [server w]\n   212\t       (when server\n   213\t         (loop [server (serve/stop! server)\n   214\t                remaining stop-ticks]\n   215\t           (let [[server' lines stopped?] (stop-tick server\n   216\t                                                     (System/currentTimeMillis))]\n   217\t             (doseq [line lines]\n   218\t               (println line))\n   219\t             (cond\n   220\t               stopped? nil\n   221\t               (zero? remaining) (println stop-timeout-text)\n   222\t               :else (do (wake/sleep! w tick-millis)\n   223\t                         (recur server' (dec remaining))))))))\n   224\t\n   225\t     (defn poll-loop!\n   240\t  (let [state (.-state ^WsHandle handle)\n   241\t        attachment (.-attachment ^WsHandle handle)\n   242\t        socket (volatile! nil)]\n   243\t    (swap! state\n   244\t           (fn [s]\n   245\t             (if (= :closed (:phase s))\n   246\t               s\n   247\t               (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   248\t    (when (= :failed (invoke-close! @socket ended-close-code \"dao.stream/ended\"))\n   249\t      (emit-reason! state attachment :ws/error :ws/close-failure))\n   250\t    (outcome :dao.stream/ok)))\n   251\t\n   252\t\n   253\t(defn- new-handle\n   254\t  [descriptor attachment target phase socket codec]\n   255\t  (let [state (atom {:phase phase :socket socket :deposit target\n   256\t                     :resolution? false :terminal? false})]\n   257\t    [(WsHandle. state descriptor attachment codec) state]))\n   258\t\n   259\t\n   260\t(defn- protocol-failure!\n   261\t  [state attachment]\n   262\t  (emit-reason! state attachment :ws/error :ws/decode-failure)\n   263\t  (swap! state assoc :phase :closed)\n   264\t  (invoke-close! (:socket @state) protocol-close-code \"dao.stream/protocol-error\"))\n   265\t\n   266\t\n   267\t(defn opened!\n   268\t  \"Adapter entry: the peer's accept control was received (client), or the\n   269\t   endpoint accepted a matching handoff acknowledgement (server).\"\n   270\t  [handle]\n   271\t  (let [state (.-state ^WsHandle handle)\n   272\t        attachment (.-attachment ^WsHandle handle)\n   273\t        emit? (volatile! false)]\n   274\t    (swap! state (fn [s]\n   275\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   276\t                     (do (vreset! emit? true) (assoc s :phase :open :resolution? true))\n   277\t                     s)))\n   278\t    (when @emit? (emit! state attachment :ws/opened))))\n   279\t\n   280\t\n   281\t(defn disclaimed!\n   282\t  \"Adapter entry for the authoritative first `:ws/disclaim` control frame.\"\n   283\t  [handle]\n   284\t  (let [state (.-state ^WsHandle handle)\n   285\t        attachment (.-attachment ^WsHandle handle)\n   286\t        emit? (volatile! false)]\n   287\t    (swap! state (fn [s]\n   288\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   289\t                     (do (vreset! emit? true) (assoc s :resolution? true :phase :closed))\n   290\t                     s)))\n   291\t    (when @emit?\n   292\t      (emit! state attachment :ws/not-found)\n   293\t      (invoke-close! (:socket @state) disclaim-close-code \"dao.stream/not-found\"))))\n   294\t\n   295\t\n   296\t(defn- deliver!\n   297\t  \"Decode one inbound frame payload with the handle's codec and dispatch its\n   298\t   envelope.  Wire validation only; application values are never judged.\"\n   299\t  [handle payload]\n   300\t  (let [state (.-state ^WsHandle handle)\n   301\t        attachment (.-attachment ^WsHandle handle)\n   302\t        codec (.-codec ^WsHandle handle)]\n   303\t    (try\n   304\t      (let [frame ((:ws/decode codec) payload)]\n   305\t        (cond\n   306\t          (and (= :ws/accept (:ws/frame frame)) (= :connecting (:phase @state)))\n   307\t          (opened! handle)\n   308\t\n   309\t          (and (= :ws/disclaim (:ws/frame frame)) (= :connecting (:phase @state)))\n   310\t          (disclaimed! handle)\n   311\t\n   312\t          (and (= :ws/value (:ws/frame frame))\n   313\t               (contains? frame :ws/value)\n   314\t               (= :open (:phase @state))\n   315\t               ((:ws/portable-value? codec) (:ws/value frame)))\n   316\t          (emit! state attachment :ws/payload (:ws/value frame))\n   317\t\n   318\t          :else (protocol-failure! state attachment)))\n   319\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   320\t        (protocol-failure! state attachment)))))\n   321\t\n   322\t\n   323\t(defn receive!\n   324\t  \"Adapter entry for one text WebSocket message.  A text frame on a binary\n   325\t   profile is a protocol failure — the transport reads the frame's declared\n   326\t   kind, never its content.\"\n   327\t  [handle text]\n   328\t  (if (= :text (:ws/frame-kind (.-codec ^WsHandle handle)))\n   329\t    (deliver! handle text)\n   330\t    (protocol-failure! (.-state ^WsHandle handle)\n   331\t                       (.-attachment ^WsHandle handle))))\n   332\t\n   333\t\n   334\t(defn receive-binary!\n   335\t  \"Adapter entry for one binary WebSocket message (a host byte payload):\nsrc/cljc/dao/stream/ws.cljc:232:(defn close-ended!\nsrc/cljc/dao/stream/ws.cljc:282:  \"Adapter entry for the authoritative first `:ws/disclaim` control frame.\"\nsrc/cljc/dao/stream/ws.cljc:306:          (and (= :ws/accept (:ws/frame frame)) (= :connecting (:phase @state)))\nsrc/cljc/dao/stream/ws.cljc:309:          (and (= :ws/disclaim (:ws/frame frame)) (= :connecting (:phase @state)))\nsrc/cljc/dao/stream/ws.cljc:411:;; round 2): the :served table and the accept/disclaim handshake go once t