             {:traffic {:dao.stream/handle traffic\n   371\t                                                :dao.stream/surface #{:writer}}\n   372\t                                      :admission admission\n   373\t                                      :reader traffic\n   374\t                                      :cursor (newest traffic)\n   375\t                                      :ring (buffer)}))})\n   376\t         listener (atom (node/listen! endpoint\n   377\t                                      {:host \"127.0.0.1\" :port 0\n   378\t                                       :on-error #(swap! listener-errors conj :listener-error)\n   379\t                                       ;; The listener negotiates exactly the\n   380\t                                       ;; endpoint's own codec table.\n   381\t                                       :codecs codecs}))]\n   382\t     {:echo echo\n   383\t      :control control\n   384\t      :offer (:offer (first handoffs))\n   385\t      :listener listener\n   386\t      :listener-errors listener-errors\n   387\t      :traffic-media traffic-media\n   388\t      :acceptor acceptor\n   389\t      :descriptor table-descriptor})))\n   390\t\n   391\t\n   392\t(defn- server-tick\n   393\t  \"One explicit driver tick: transport, offer and mirror, over the\n   394\t   `\\\"echo\\\"` identity every accepted connection's reflection reads and\n   395\t   writes directly -- there is no handler to step, since `append!` and\n   396\t   `next` are the mirror's own primitives.\"\n   397\t  [fixture now]\n   398\t  (project/accept-step! (:acceptor fixture) now))\n   399\t\n   400\t\n   401\t(defn- make-client\n   402\t  \"Dial the endpoint and attach one reflection of `\\\"echo\\\"`, over a fresh\n   403\t   traffic medium and channel ring, before any attach! -- the boundary\n   404\t   composition discipline of dao.stream.ws.md.  The optional map arity\n   405\t   selects the wire codec profile (default Transit).\"\n   406\t  ([client-descriptor] (make-client client-descriptor {}))\n   407\t  ([client-descriptor {:keys [codec] :as _options}]\n   408\t   (let [traffic (buffer)\n   409\t         cursor (newest traffic)\n   410\t         ring (buffer)\n   411\t         attach! (ws/make-attacher\n   412\t                   (cond-> {:traffic {:dao.stream/handle traffic :dao.stream/surface #{:writer}}\n   413\t                            :admission admission\n   414\t                            :connect! node/connect!}\n   415\t                     codec (assoc :codec codec)))\n   416\t         dial (project/dial {:attach! attach!\n   417\t                             :traffic {:dao.stream/handle traffic}\n   418\t                             :cursor cursor\n   419\t                             :ring ring\n   420\t                             :table {}})\n   421\t         attach (project/dial-attach!\n   422\t                  dial {:dao.stream/type :dao.stream/remote\n   423\t                        :dao.stream/identity \"echo\"\n   424\t                        :dao.stream/channel client-descriptor})]\n   425\t     {:traffic traffic\n   426\t      :cursor cursor\n   427\t      :dial dial\n   428\t      :attach attach\n   429\t      :handle (:dao.stream/handle attach)\n   430\t      :completed (atom [])})))\n   431\t\n   432\t\n   433\t(defn- client-tick!\n   434\t  [client]\n   435\t  (project/dial-step! (:dial client)))\n   436\t\n   437\t\n   438\t(defn- client-ticker\n   439\t  [client]\n   440\t  (js/setInterval (fn [] (client-tick! client)) 10))\n   441\t\n   442\t\n   443\t(defn- channel-attachment\n   444\t  \"The channel's ws attachment identity -- the id every envelope the wire\n   445\t   deposits for this connection carries, as distinct from the remote\n   446\t   attacher's own attachment id on the reflection dial-attach! answered.\"\n   447\t  [client]\n   448\t  (:attachment (project/channel (:dial client))))\n   449\t\n   450\t\n   451\t(defn- channel-handle\n   452\t  \"The channel's ws handle -- the socket writer a detachment closes -- as\n   453\t   distinct from the reflection handle dial-attach! answered.\"\n   454\t  [client]\n   455\t  (:handle (project/channel (:dial client))))\n   456\t\n   457\t\n   458\t;; =============================================================================\n   459\t;; End to end over real loopback sockets\n   460\t;; =============================================================================\n   461\t\n   462\t\n   463\t(defn- read-oldest\n   464\t  \"Mint the oldest cursor (retrying while the reflection answers a\n   465\t   retryable mint) then read one value past it.  Returns the read\n   466\t   result, or nil while either step is still pending.\"\n   467\t  [handle]\n   468\t  (let [c (stream/cursor handle stream/anchor-oldest)]\n   469\t    (when (= :dao.stream/ok (:dao.stream/outcome c))\n   470\t      (let [r (stream/next handle (:dao.stream/cursor c))]\n   471\t        (when (= :dao.stream/ok (:dao.stream/outcome r)) r)))))\n   472\t\n   473\t\n   474\t(defn- read-next-ok\n   475\t  \"One next read past `cursor`, answered only on `:dao.stream/ok` --\n   476\t   while the reflection's own ask is in flight it answers blocked, so a\n   477\t   caller polling this until truthy is the retry that op never gets for\n   478\t   itself.  Returns the read result, or nil while still pending.\"\n   479\t  [handle cursor]\n   480\t  (let [r (stream/next handle cursor)]\n   481\t    (when (= :dao.stream/ok (:dao.stream/outcome r)) r)))\n   482\t\n   483\t\n   484\t(defn- append-ok\n   485\t  \"One append attempt, answered only on `:dao.stream/ok` -- a reflection's\n   486\t   append! answers `:dao.stream/full` (never retried on its own) while the\n   487\t   underlying socket is still `:connecting`, exactly as the descriptor\n   488\t   probe is; a caller polling this until truthy is the retry that op\n   489\t   never gets for itself.  Returns the outcome map, or nil while still\n   490\t   pending.\"\n   491\t  [handle value]\n   492\t  (let [r (stream/append! handle value)]\n   493\t    (when (= :dao.stream/ok (:dao.stream/outcome r)) r)))\n   494\t\n   495\t\n   496\t(defn- a-reflection-verified\n   497\t  \"The round trip's assertions: the reflected value, the real new-flow\n   498\t   event sequence on the client medium, and the per-attachment\n   499\t   correlation.\"\n   500\t  [fixture server ticker client finish result]\n   501\t  (is (= \"hello\" (:dao.stream/value result)))\n   502\t  (let [events (drain (:traffic client))\n   503\t        answers (payload-values events)\n   504\t        me (channel-attachment client)]\n   505\t    ;; The new flow's real sequence: the accept event, then one envelope\n   506\t    ;; per mirror answer -- the descriptor probe's ok (the link's first\n   507\t    ;; asker-minted id 0, carrying the served surface), the append!'s\n   508\t    ;; source ok, the cursor mint, and the next with the echoed value.\n   509\t    (is (= [[:ws/opened nil] [:ws/payload nil] [:ws/payload nil]\n   510\t            [:ws/payload nil] [:ws/payload nil]]\n   511\t           (mapv (juxt :ws/event :ws/reason) events)))\n   512\t    (is (= 0 (:dao.stream.remote/id (first answers))))\n   513\t    (is (= #{:writer :reader}\n   514\t           (:dao.stream.remote/surface (first answers))))\n   515\t    (is (some? (:dao.stream/cursor (nth answers 2))))\n   516\t    (is (= \"echo\" (:dao.stream/identity (last answers))))\n   517\t    (is (= \"hello\" (:dao.stream/value (last answers))))\n   518\t    ;; Every deposited envelope on the client medium is attributed to\n   519\t    ;; this attachment: demultiplexing survived the real wire.\n   520\t    (is (every? #(= me (:ws/attachment %)) events)))\n   521\t  (is (= 1 (count @(:traffic-media fixture))))\n   522\t  (is (empty? (drain (:control fixture))))\n   523\t  (teardown! fixture [client] server ticker)\n   524\t  (finish))\n   525\t\n   526\t\n   527\t(defn- a-reflection-read-back\n   528\t  \"One accepted append: read the echo back through the reflection.\"\n   529\t  [fixture server ticker client finish appended]\n   530\t  (is (= :dao.stream/ok (:dao.stream/outcome appended)))\n   531\t  (after 4000 #(read-oldest (:handle client))\n   532\t         \"the echoed value never arrived\" fixture server [client] finish\n   533\t         (fn [result]\n   534\t           (a-reflection-verified fixture server ticker client finish\n   535\t                                  result))))\n   536\t\n   537\t\n   538\t(deftest a-reflection-round-trips-append-and-next-through-a-real-node-listener\n   539\t  (async done\n   540\t         (let [fixture (server-fixture)\n   110\t  target)\n   111\t\n   112\t\n   113\t(defn- attachment-id\n   114\t  []\n   115\t  (str (random-uuid)))\n   116\t\n   117\t\n   118\t(defn- invoke-close!\n   119\t  [socket code reason]\n   120\t  (when-let [f (:close! socket)]\n   121\t    (try\n   122\t      (f code reason)\n   123\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   124\t        ;; The connection has already transitioned locally.  The caller adds a\n   125\t        ;; diagnostic where it still has a functioning composed medium.\n   126\t        :failed))))\n   127\t\n   128\t\n   129\t(defn- send-result\n   130\t  [socket payload]\n   131\t  ;; The payload is whatever the attachment's codec produced — a string for\n   132\t  ;; text profiles, host bytes for binary profiles.  The transport never\n   133\t  ;; inspects it; the host `:send!` seam owns the typed frame.\n   134\t  (try\n   135\t    (let [x ((:send! socket) payload)]\n   136\t      (cond\n   137\t        (or (nil? x) (= true x) (= :ok x)) (outcome :dao.stream/ok)\n   138\t        (= false x) (outcome :dao.stream/full)\n   139\t        (and (map? x) (:dao.stream/outcome x)) x\n   140\t        :else (outcome :dao.stream/transport-error)))\n   141\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   142\t      (outcome :dao.stream/transport-error))))\n   143\t\n   144\t\n   145\t(declare receive! closed! opened! disclaimed!)\n   146\t\n   147\t\n   148\t(defn- deposit!\n   149\t  [state event]\n   150\t  (let [target (:deposit @state)\n   151\t        result (stream/append! (:dao.stream/handle target) event)]\n   152\t    ;; A host promised this medium admits all boundary events.  A failed\n   153\t    ;; deposit is therefore terminal, rather than a reason to retain a hidden\n   154\t    ;; inbox or silently discard the event.\n   155\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n   156\t      (let [socket (:socket @state)]\n   157\t        (swap! state assoc :phase :closed)\n   158\t        (invoke-close! socket 1000 \"dao.stream/deposit-failed\")))\n   159\t    result))\n   160\t\n   161\t\n   162\t(defn- emit!\n   163\t  \"Deposit one boundary event.  The four-argument form carries a payload and\n   164\t   always keys it, because nil is an ordinary portable value: a consumer must be\n   165\t   able to tell `value nil` from `no value` with `contains?`.\"\n   166\t  ([state attachment event]\n   167\t   (deposit! state {:ws/attachment attachment :ws/event event}))\n   168\t  ([state attachment event value]\n   169\t   (deposit! state {:ws/attachment attachment :ws/event event :ws/value value})))\n   170\t\n   171\t\n   172\t(defn- emit-reason!\n   173\t  [state attachment event reason]\n   174\t  (deposit! state {:ws/attachment attachment :ws/event event :ws/reason reason}))\n   175\t\n   176\t\n   177\t(defn- terminal!\n   178\t  [state attachment event]\n   179\t  (let [emit? (volatile! false)]\n   180\t    (swap! state\n   181\t           (fn [s]\n   182\t             (if (:terminal? s)\n   183\t               s\n   184\t               (do (vreset! emit? true)\n   185\t                   (assoc s :terminal? true :phase :closed)))))\n   186\t    (when @emit? (emit! state attachment event))))\n   187\t\n   188\t\n   189\t(deftype WsHandle\n   190\t  [state descriptor attachment codec]\n   191