operator\n   220\t   `(disconnect)` ends that immediately — the shell is local again from the next\n   221\t   line, without waiting for the terminal event the boundary will deposit — while\n   222\t   an uninvited drop keeps routing so the input can queue for a reattachment.  A\n   223\t   terminal with no reattachment behind it ends it too.\"\n   224\t  [state]\n   225\t  (and (:adapter state)\n   226\t       (not (connect/operator-detached? (:connection state)))\n   227\t       (let [terminal (remote-terminal state)]\n   228\t         (or (nil? terminal) (contains? queueable-terminals terminal)))))\n   229\t\n   230\t\n   231\t(defn- abandon-unsent\n   232\t  \"Give up any allocated-but-unsent request, with the reason the driver owns.\n   233\t\n   234\t   The RPC client would otherwise retry that exact envelope on the next binding,\n   235\t   in place of the line the operator types after reattaching.  Abandoning it\n   236\t   publishes the loss as an ordinary completion, so the line is reported rather\n   237\t   than silently replayed or dropped.\"\n   238\t  [state reason]\n   239\t  (if (rpc-client state)\n   240\t    (update-in state [:adapter :yin.repl.adapter/rpc] rpc/abandon-unsent reason)\n   241\t    state))\n   242\t\n   243\t\n   244\t(declare publish-adapter-events)\n   245\t\n   246\t\n   247\t(defn- abandon-unsent-now\n   248\t  \"Finish and publish the old request path before replacing an adapter wholesale.\n   249\t\n   250\t   The ordinary disconnect/reattach paths retain their adapter until the next\n   251\t   poll can publish its completion.  A fresh connection does not: it installs a\n   252\t   new adapter immediately, so every already-unpublished completion must cross\n   253\t   into the driver's outbox first or it is discarded with the old adapter.  An\n   254\t   unsent envelope is abandoned before that unconditional publication step.\"\n   255\t  [state reason]\n   256\t  (if-not (:adapter state)\n   257\t    state\n   258\t    (let [state (cond-> state\n   259\t                  (remote-unsent? state) (abandon-unsent reason))\n   260\t          published (adapter/publish-completions (:adapter state))]\n   261\t      (publish-adapter-events\n   262\t        (assoc state :adapter (:yin.repl.adapter/state published))))))\n   263\t\n   264\t\n   265\t(defn- disconnect\n   266\t  \"`disconnect` is `close!`.  The connection value, its traffic medium, and its\n   267\t   cursors are kept: the terminal fact arrives as a deposited event, and that is\n   268\t   what makes a later `(connect …)` a `rebind` rather than a new client.\n   269\t\n   270\t   Input queued for the remote shell is dropped rather than carried across the\n   271\t   disconnection: the operator asked to stop talking to it.  A request already\n   272\t   allocated but never appended is abandoned on the same grounds, and says so.\"\n   273\t  [state]\n   274\t  (cond\n   275\t    (:connection state)\n   276\t    (-> state\n   277\t        (assoc :connection (connect/close! (:connection state) :operator))\n   278\t        (abandon-unsent :yin.repl.driver/operator-disconnect)\n   279\t        (assoc :queued [] :retrying nil)\n   280\t        (publish :yin.repl.driver/notice\n   281\t                 (str \"Disconnecting from \" (:url (:connection state)))))\n   282\t\n   283\t    (:adapter state)\n   284\t    (-> state\n   285\t        detach-remote\n   286\t        (publish :yin.repl.driver/notice \"Disconnected from remote shell\"))\n   287\t\n   288\t    :else\n   289\t    (publish state :yin.repl.driver/notice \"Not connected to a remote shell\")))\n   290\t\n   291\t\n   292\t(defn- connect-failure\n   293\t  [state result]\n   294\t  (publish state :yin.repl.driver/notice\n   295\t           (str (get result connect/message-key)\n   296\t                \" [\" (name (get result connect/outcome-key)) \"]\")))\n   297\t\n   298\t\n   299\t(defn- reattach\n   300\t  [state url]\n   301\t  (let [result (connect/reattach (:connection state) (rpc-client state))]\n   302\t    (if-not (= :yin.repl.connect/reattached (get result connect/outcome-key))\n   303\t      (connect-failure state result)\n   304\t      (-> state\n   305\t          (assoc :connection (get result connect/connection-key))\n   306\t          (assoc-in [:adapter :yin.repl.adapter/rpc] (get result connect/client-key))\n   307\t          ;; The retained envelope was encoded for the attachment that died, so\n   308\t          ;; it is reported lost rather than resent as the first thing the new\n   309\t          ;; binding says, ahead of whatever the operator types next.  Over the\n   310\t          ;; WebSocket boundary the retry meets a closed writer first and RPC\n   311\t          ;; completes it there; this holds for a host whose writer keeps\n   312\t          ;; answering `full` after its peer is gone.\n   313\t          (abandon-unsent :yin.repl.driver/abandoned-on-reattach)\n   314\t          (assoc :outstanding nil :retrying nil)\n   315\t          (publish :yin.repl.driver/notice (str \"Reattaching to \" url))\n   316\t          (publish :yin.repl.connect/connected (str \"Connected to \" url))))))\n   317\t\n   318\t\n   319\t(defn- open-connection\n   320\t  [state url]\n   321\t  (let [result (connect/open {:url url :host (:host state)})\n   322\t        dropped (count (:queued state))]\n   323\t    (if-not (= :yin.repl.connect/attached (get result connect/outcome-key))\n   324\t      (connect-failure state result)\n   325\t      (-> state\n   326\t          (abandon-unsent-now :yin.repl.driver/abandoned-on-fresh-connection)\n   327\t          (cond-> (pos? dropped)\n   328\t            (publish :yin.repl.driver/notice\n   329\t                     (str \"Discarded \" dropped \" queued remote \"\n   330\t                          (if (= 1 dropped) \"line\" \"lines\")\n   635\t                     step!)\n   636\t          ;; the holder's renewal rides its envelope: :ws/attachment\n   637\t          system (-> system\n  