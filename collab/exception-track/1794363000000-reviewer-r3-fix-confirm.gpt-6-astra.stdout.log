77\t(defn- rewrite-ex-info\n   978\t  \"(ex-info msg data cause?) as the portable map holding its parts. The\n   979\t   accessors read through the generated exception wrapper: a retained\n   980\t   condition's wrapper carries the original payload privately, so\n   981\t   (ex-message e)/(ex-data e) answer the payload's parts while a plain\n   982\t   value still answers by keyword lookup.\"\n   983\t  [form]\n   984\t  (cond\n   985\t    (seq? form)\n   986\t    (cond\n   987\t      (empty? form) form\n   988\t      (= 'quote (first form)) form\n   989\t      (#{'.getMessage 'ex-message 'ex-data} (first form))\n   990\t      (do (when-not (= 2 (count form))\n   991\t            (reject! \"Error accessor requires one portable error value\" {:form form}))\n   992\t          (list (if (= 'ex-data (first form)) 'dsg__ex_data 'dsg__ex_message)\n   993\t                (rewrite-ex-info (second form))))\n   994\t      (and (symbol? (first form)) (= \\. (first (name (first form)))))\n   995\t      (reject! \"Host exception/interop accessor is not portable\" {:form form})\n   996\t      (= 'ex-info (first form))\n   997\t      (let [[_ msg data cause] (map rewrite-ex-info form)]\n   998\t        (cond-> {:yin.k/message msg, :yin.k/data data}\n   999\t          (< 3 (count form)) (assoc :yin.k/cause cause)))\n  1000\t      :else (rebuild form (map rewrite-ex-info form)))\n  1001\t    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\n  1002\t    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\n  1003\t    (set? form) (into #{} (map rewrite-ex-info) form)\n  1004\t    :else form))\n  1005\t\n  1006\t\n  1007\t(defn- call-kind\n  1008\t  [env head]\n  1009\t  (cond\n  1010\t    (keyword? head) :keyword\n  1011\t    (not (symbol? head)) :guest\n  1012\t    ;; a compiler-internal helper introduced by the pre-pass (the exception\n  1013\t    ;; accessors): a direct application, never a guest invocation\n  1014\t    (reserv