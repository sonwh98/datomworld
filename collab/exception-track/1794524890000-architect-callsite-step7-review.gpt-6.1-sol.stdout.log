\t    (testing (str id)\n    30\t      (doseq [[backend actual] (legs/run-leg leg)]\n    31\t        (is (= (legs/expected leg) actual) (str backend))))))\n    32\t\n    33\t\n    34\t(deftest python-provenance-export-surface-test\n    35\t  (let [private-names '#{dsg__condition-exception cell/dsg__new-provenance\n    36\t                         cell/dsg__provenance}\n    37\t        exposed? (fn [x]\n    38\t                   (some #(str/includes? (str x) %)\n    39\t                         [\"dsg__\" \"provenance\" \"condition-exception\"]))\n    40\t        public-private-users\n    41\t        (into #{}\n    42\t              (keep (fn [[k form]]\n    43\t                      (when (and (= \"py\" (namespace k))\n    44\t                                 (some private-names (tree-seq coll? seq form)))\n    45\t                        k)))\n    46\t              py-prelude/definitions)]\n    47\t    (is (not-any? exposed? (concat py-prelude/module-exports py-prelude/runtime-keys)))\n    48\t    ;; Only reception and egress may use the private constructor and reader.\n    49\t    ;; This also catches a renamed mint-wrapping helper.\n    50\t    (is (= '#{py/call-kw py/function-entry} public-private-users))))\n    51\t\n    52\t\n    53\t(deftest ^:slow python-foreign-reception-test\n    54\t  ;; R2: an otherwise-foreign payload is wrapped in a generated local\n    55\t  ;; ForeignException; an already-local exception is delivered unchanged.\n    56\t  (check-fixture :python/local-reception)           ; stays green\n    57\t  (check-fixture :python/foreign-reception)         ; R→G\n    58\t  (check-fixture :python/retained-foreign-lifetime) ; R→G\n    59\t  ;; The clojure→python typed reception and stored-wrapper rethrow legs.\n    60\t  (check-leg [:clojure :python :typed-catch])\n    61\t  (check-leg [:clojure :python :unchanged-rethrow])\n    62\t  (check-leg [:clojure :python :retained-lifetime]))\n    63\t\n    64\t\n    65\t(deftest ^:slow python-protocol-reception-test\n    66\t  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n    67\t  ;; complete condition instead of collapsing into a bare TypeError.\n    68\t  (check-fixture :python/protocol-not-callable)\n    69\t  (check-fixture :python/protocol-invalid-invocation)\n    70\t  (check-fixture :python/protocol-unsupported-binding)\n    71\t  (check-fixture :python/saved-protocol-not-callable)\n    72\t  (check-fixture :python/saved-protocol-invalid-invocation)\n    73\t  (check-fixture :python/saved-protocol-unsupported-binding))\n    74\t\n    75\t\n    76\t(deftest ^:slow python-egress-sanity-test\n    77\t  ;; Egress forwards a retained generated exception's original condition and\n    78\t  ;; still produces the plain thrown condition for fresh/forged payloads.\n    79\t  (check-fixture :python/fresh-named)       ; stays green\n    80\t  (check-fixture :python/fresh-closure)     ; stays green\n    81\t  (check-fixture :python/binding)           ; stays green\n    82\t  (check-fixture :python/forged-retention)) ; stays green (R5: no source-writable forgery)\n    83\t\n    84\t\n    85\t(deftest ^:slow python-kit-parity-test\n    86\t  ;; Match exception-probes/protocol-condition and injected exactly: the\n    87\t  ;; refusal is produced by public validation, then delivered by a callable\n    88\t  ;; cell's raise exit through a parsed Python f() and bare re-raise.\n    89\t  (let [donor (kit/publish-donor! :python contract/boundary-source)\n    90\t        source \"def receive(f):\\n    try:\\n        return f()\\n    except BaseException as e:\\n        raise\\n\"\n   101\t\n   102\t\n   103\t(deftest ^{:slow true :gates #{::contract/r5} :frontends #{:typescript}}\n   104\t  typescript-store-root-unreachability-test\n   105\t  ;; Guest side: a genuine wrapper carries no provenance, condition or\n   106\t  ;; seal slot, and no global name holds the store or a seal.\n   107\t  ;; Host side: the private store is not a runtime key and neither\n   108\t  ;; installed retention name is a module export, so admitted source\n   109\t  ;; cannot reach it by enumerating either, and no frozen pre-init\n   110\t  ;; export binding can silently answer for it.\n   111\t  (doseq [[backend actual] (probes/run-typescript-identity-store :store-root)]\n   112\t    (if (instance? Throwable actual)\n   113\t      (do-report {:type :error :message (str \"store-root unreachability \" backend \" operational failure\")\n   114\t                  :expected {:retained true :wrapper-clean true :globals-clean true} :actual actual})\n   115\t      (is (= {:retained true :wrapper-clean true :globals-clean true} actual)\n   116\t          (str \"store-root unreachability \" backend))))\n   117\t  (is (not-any? #(str/includes? (str %) \"retained\") js-prelude/runtime-keys)\n   118\t      \"no retained store/seal runtime key for admitted source to name\")\n   119\t  (is (not (contains? js-prelude/module-exports 'retained-condition))\n   120\t      \"retained-condition is not a module export: no frozen pre-init binding\")\n   121\t  (is (not (contains? js-prelude/module-exports 'raise-protocol))\n   122\t      \"raise-protocol is not a module export: no frozen pre-init binding\"))\n   123\t\n   124\t\n   125\t(deftest ^{:slow true :gates #{::contract/r5} :frontends #{:typescript}}\n   126\t  typescript-copied-wrapper-forgery-test\n   127\t  ;; A fresh cell carrying a copy of a genuine protocol wrapper's complete\n   128\t  ;; contents, thrown from another activation, must NOT forward the\n   129\t  ;; original condition: provenance is bound to the genuine wrapper's\n   130\t  ;; identity, not to its copyable contents.\n   131\t  (doseq [[backend actual] (probes/run-typescript-forgery :copied)]\n   132\t    (if (instance? Throwable actual)\n   133\t      (do-report {:type :error :message (str \"copied wrapper \" backend \" operational failure\")\n   134\t                  :expected {:retained true :copy-refused true} :actual actual})\n   135\t      (is (= {:retained true :copy-refused true} actual)\n   136\t          (str \"copied wrapper \" backend)))))\n34:   `%<n>` by `yang.core.names/canonicalize` before tail marking.\"\n182:(defn- seq-of\n2337:         main (names/canonicalize\n2349:   `js/run-main`, generated names canonicalized, tail calls marked, C1\n2358:   (let [main (names/canonicalize (app* 'js/run-main (lower-unit* packet)))]\n     1\tCreated-Local: 2026-11-07 0x:xx +0700\n     2\tCoding-Agent: interactive (ZCode / GLM seat, yang.typescript / yang.php orchestrator)\n     3\t\n     4\t# Reply to 1794980000000 (part 1) — the equality-gate scope answer received and adopted\n     5\t\n     6\tClear and adopted: the cross-host occurrence-key equality gate is **part of each frontend's own acceptance** (the same source on different hosts → identical coordinates; never cross-frontend). Our adoption rounds' acceptance now includes:\n     7\t\n     8\t- **php adoption**: the php equality check on the applicable lanes (JVM + Node; Dart when the dart lane is in the round's matrix) — the php prelude publication artifacts and program occurrences compared across hosts.\n     9\t- **ts adoption**: the ts equality check on its lanes, same shape.\n    10\t\n    11\tBoth run on our shiva lanes at acceptance time per our standing flow. The B2 round (P5 lifecycle, in flight on the muse lane) predates this gate — its own acceptance is the ruled comparison rules + the shiva e2e/oracle pass; the equality gate attaches to the adoption rounds that follow it.\n    12\t\n    13\tThe H3-6 auditor inputs (part 2 of your note) are for the sol/jupiter audit lane — not our seat's action, but noted: our sol dispatches run locally and we'll keep the jupiter lane free of session collisions with yours.\n","exit_code":0,"status":"completed"}}
