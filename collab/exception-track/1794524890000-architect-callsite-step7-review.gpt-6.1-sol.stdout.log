  103\t       (raise condition))]\n   104\t    [yang.call/invoke\n   105\t     (fn [callable positional named raise]\n   106\t       (if (data/callable? raise)\n   107\t         (if (yang.call/eligible? callable)\n   108\t           (let [target (yang.call/entry callable)\n   109\t                 record (yang.call/invocation callable positional named raise)]\n   110\t             (if (not (nil? target))\n   111\t               (if (yang.call/valid-invocation? record)\n   112\t                 (target record)\n   113\t                 (yang.call/transfer\n   114\t                   raise\n   115\t                   (yang.call/condition :yang.call/invalid-invocation\n   116\t                                        {:yang.call/callee callable})))\n   117\t               (yang.call/transfer\n   118\t                 raise\n   119\t                 (yang.call/condition :yang.call/invalid-invocation\n   120\t                                      {:yang.call/callee callable}))))\n   121\t           (yang.call/transfer\n   122\t             raise\n   123\t             (yang.call/condition :yang.call/not-callable\n   124\t                                  {:yang.call/callee callable})))\n   125\t         (raise (yang.call/condition :yang.call/invalid-invocation\n   126\t                                     {:yang.call/reason :missing-raise-exit}))))]\n   127\t    [yang.call/invoke-with\n   128\t     (fn [callable positional named raise options]\n   129\t       (if (data/callable? raise)\n   130\t         (if (yang.call/eligible? callable)\n   131\t           (let [target (yang.call/entry callable)\n   132\t                 record (yang.call/invocation-with\n   133\t                          callable positional named raise options)]\n   134\t             (if (not (nil? target))\n   135\t               (if (yang.call/valid-invocation? record)\n   136\t                 (target record)\n   137\t                 (yang.call/transfer\n   138\t                   raise\n   139\t    