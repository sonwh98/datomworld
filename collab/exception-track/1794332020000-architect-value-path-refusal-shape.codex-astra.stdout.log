   (if (outcomes? env) (arity-error-form fn-name source) (list 'data/count))\\n  1040\\t            (reverse arities))))\\n  1041\\t\\n  1042\\t\\n  1043\\t(defn- check-av-params!\\n  1044\\t  [params]\\n  1045\\t  (when-not (vector? params)\\n  1046\\t    (reject! \\\"fn parameters must be a vector\\\" {:params params}))\\n  1047\\t  (doseq [p params]\\n  1048\\t    (when (= '& p)\\n  1049\\t      (reject! \\\"Variadic fn parameters are not supported\\\" {:params params}))\\n  1050\\t    (check-binder! p params)))\\n  1051\\t\\n  1052\\t\\n  1053\\t(defn- outcome-node\\n  1054\\t  [tag value]\\n  1055\\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\\n  1056\\t\\n  1057\\t\\n  1058\\t(defn- call-entry\\n  1059\\t  \\\"The unary public entry, closed over a private argument-vector body.\\\"\\n  1060\\t  []\\n  1061\\t  (let [body (symbol (str reserved-prefix \\\"body\\\"))\\n  1062\\t        invocation (symbol (str reserved-prefix \\\"invocation\\\"))\\n  1063\\t        outcome (symbol (str reserved-prefix \\\"entry_outcome\\\"))\\n  1064\\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\\n  1065\\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\\n  1066\\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\\n  1067\\t        binding-error (outcome-node\\n  1068\\t                        error-tag\\n  1069\\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1070\\t                               (u/lit :yin.k/message)\\n  1071\\t                               (u/lit \\\"Clojure functions do not accept named arguments\\\")\\n  1072\\t                               (u/lit :yin.k/data)\\n  1073\\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1074\\t                                      (u/lit :yang.call/named) named)))\\n  1075\\t        entry-body (u/let1\\n  1076\\t                     outcome\\n  1077\\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\\n  1078\\t                                (u/app (u/v body) positional)\\n  1079\\t                                binding-error)\\n  1080\\t                     (u/if-node (u/app (u/v 'dsg__equal)\\n  1081\\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\\n  1082\\t                                       (u/lit ok-tag))\\n  1083\\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\\n  1084\\t                                (u/app raise\\n  1085\\t                                       (u/app (u/v 'yang.call/thrown)\\n  1086\\t                                              (u/app (u/v 'data/nth)\\n  1087\\t                                                     (u/v outcome) (u/lit 1))))))\\n  1088\\t        ;; The private lane forwards the body's outcome in tail position.\\n  1089\\t        ;; The public entry still converts outcomes to value/raise normally.\\n  1090\\t        ;; The compiler's token packet - a two-element vector whose first\\n  1091\\t        ;; element is the compiler-held token - selects the private tail\\n  1092\\t        ;; lane on the SAME unary entry: no record unwrap, no map lookups.\\n  1093\\t        ;; A guest cannot forge it: the token is compiler-held and the\\n  1094\\t        ;; reserved-prefix regime refuses binding or shadowing it. Maps\\n  1095\\t        ;; keep the ordinary record path. The vector guard is required:\\n  1096\\t        ;; data/nth refuses non-vectors, and dsg__get reads vectors as\\n  1097\\t        ;; nil whenever the program defines its own get.\\n  1098\\t        packet (u/if-node\\n  1099\\t                 (u/app (u/v 'data/vector?) (u/v invocation))\\n  1100\\t                 ;; the packet is exactly two elements: the arity guard runs\\n  1101\\t                 ;; before data/nth so an empty or overlong vector refuses\\n  1102\\t                 ;; as an outcome instead of a host-side data refusal\\n  1103\\t                 (u/if-node\\n  1104\\t                   (u/app (u/v 'dsg__equal)\\n  1105\\t                          (u/app (u/v 'data/count) (u/v invocation))\\n  1106\\t                          (u/lit 2))\\n  1107\\t                   (u/if-node\\n  1108\\t                     (u/app (u/v 'dsg__equal)\\n  1109\\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\\n  1110\\t                            (u/v 'dsg__call_token))\\n  1111\\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\\n  1112\\t                     ;; a vector without the compiler-held token is NOT the\\n  1113\\t                     ;; record path: applying the body here would hand every\\n  1114\\t                     ;; forged vector the private lane. Refuse explicitly.\\n  1115\\t                     (u/lit [:yin.k/error\\n  1116\\t                             {:yin.k/message \\\"Invocation is neither an authenticated packet nor an invocation record\\\"\\n  1117\\t                              :yin.k/data {}}]))\\n  1118\\t                   (u/lit [:yin.k/error\\n  1119\\t                           {:yin.k/message \\\"Invocation is neither an authenticated packet nor an invocation record\\\"\\n  1120\\t                            :yin.k/data {}}]))\\n  1121\\t                 (u/if-node\\n  1122\\t                   (u/app (u/v 'dsg__equal)\\n  1123\\t                          (u/app (u/v 'dsg__get) (u/v invocation)\\n  1124\\t                                 (u/lit :clj/outcome-token))\\n  1125\\t                          (u/v 'dsg__call_token))\\n  1126\\t                   (u/if-node (u/app (u/v 'dsg__empty) named)\\n  1127\\t                              (u/app (u/v body) positional)\\n  1128\\t                              binding-error)\\n  1129\\t                   entry-body))\\n  1130\\t        entry (u/lam [invocation] packet)]\\n  1131\\t    (u/lam [body] entry)))\\n  1132\\t\\n  1133\\t\\n  1134\\t(defn- admit-call-descriptor\\n  1135\\t  \\\"Admit a descriptor constructed by trusted UAST/profile code. This is not\\n  1136\\t   a source form: entry-spelled source maps never pass through this constructor.\\\"\\n  1137\\t  [descriptor-ast tail?]\\n  1138\\t  (let [descriptor-name 'dsg__descriptor\\n  1139\\t        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\\n  1140\\t                         (u/lit :clj/admission) (u/lit nil))\\n  1141\\t        ;; The factory closure captures the canonical descriptor and private\\n  1142\\t        ;; token. Projection reconstructs and compares that opaque closure;\\n  1143\\t        ;; it never applies a source-supplied predicate. An equal immutable\\n  1144\\t        ;; reconstruction is the same value, not admission of different data.\\n  1145\\t        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\\n  1270\\t                                     (u/app (u/v 'data/str-index-of)\\n  1271\\t                                            (u/app (u/v 'kind/name) id)\\n  1272\\t                                            (u/lit \\\"cell-\\\"))\\n  1273\\t                                     (u/lit 0))\\n  1274\\t                              (u/lit true)\\n  1275\\t                              (u/lit false))\\n  1276\\t                   (u/lit false))]\\n  1277\\t    (u/if-node (u/app (u/v 'dsg__equal)\\n  1278\\t                      (u/app (u/v 'dsg__get) callee (u/lit :type))\\n  1279\\t                      (u/lit :cell-ref))\\n  1280\\t               (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :id))\\n  1281\\t                          (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :seal))\\n  1282\\t                                     (u/if-node (u/app (u/v 'dsg__equal)\\n  1283\\t                                                       (u/app (u/v 'data/count) callee)\\n  1284\\t                                                       (u/lit 3))\\n  1285\\t                                                (u/if-node (u/app (u/v 'data/string?) seal)\\n  1286\\t                                                           (u/if-node (u/app (u/v 'dsg__equal)\\n  1287\\t                                                                             (u/app (u/v 'data/str-length) seal)\\n  1288\\t                                                                             (u/lit 64))\\n  1289\\t                                                                      id-names-cell?\\n  1290\\t                                                                      (u/lit false))\\n  1291\\t                                                           (u/lit false))\\n  1292\\t                                                (u/lit false))\\n  1293\\t                                     (u/lit false))\\n  1294\\t                          (u/lit false))\\n  1295\\t               (u/lit false))))\\n  1296\\t\\n  1297\\t\\n  1298\\t(defn- compile-guest-call\\n  1299\\t  \\\"Admit a source operator before common invocation. Only generated UAST\\n  1300\\t   implementation calls apply private closures directly.\\\"\\n  1301\\t  [callee-ast arguments-ast env tail?]\\n  1302\\t  (if-not (outcomes? env)\\n  1303\\t    (cond-> (u/app callee-ast arguments-ast)\\n  1304\\t      tail? (assoc :tail? true))\\n  1305\\t    (let [callee (symbol (str reserved-prefix \\\"callee\\\"))\\n  1306\\t          arguments (symbol (str reserved-prefix \\\"arguments\\\"))\\n  1307\\t          escape (symbol (str reserved-prefix \\\"raise_escape\\\"))\\n  1308\\t          condition (symbol (str reserved-prefix \\\"condition\\\"))\\n  1309\\t          result (symbol (str reserved-prefix \\\"call_result\\\"))\\n  1310\\t          condition->outcome (u/if-node\\n  1311\\t                               (u/app (u/v 'dsg__equal)\\n  1312\\t                                      (u/app (u/v 'dsg__get) (u/v condition)\\n  1313\\t                                             (u/lit :yang.call/reason))\\n  1314\\t                                      (u/lit :yang.call/thrown))\\n  1315\\t                               (outcome-node\\n  1316\\t                                 error-tag\\n  1317\\t                                 (u/app (u/v 'dsg__get) (u/v condition)\\n  1318\\t                                        (u/lit :yang.call/value)))\\n  1319\\t                               (outcome-node error-tag (u/v condition)))\\n  1320\\t          raise (u/lam [condition]\\n  1321\\t                       (assoc (u/app (u/v escape)\\n  1322\\t                                     (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1323\\t                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\\n  1324\\t                                            (u/lit :clj/outcome) condition->outcome))\\n  1325\\t                              :tail? true))\\n  1326\\t          common-call (u/let1\\n  1327\\t                        result\\n  1328\\t                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\\n  1329\\t                               (u/lit []) raise)\\n  1330\\t                        (outcome-node ok-tag (u/v result)))\\n  1331\\t          refused (outcome-node\\n  1332\\t                    error-tag\\n  1333\\t                    (u/app (u/v 'yang.call/condition)\\n  1334\\t                           (u/lit :yang.call/not-callable)\\n  1335\\t                           (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1336\\t                                  (u/lit :yang.call/callee) (u/v callee))))\\n  1337\\t          activation (u/if-node\\n  1338\\t                       (u/app (u/v 'data/callable?) (u/v escape))\\n  1339\\t                       common-call\\n  1340\\t                       ;; Applying the escape resumes the capture operand.\\n  1341\\t                       ;; Only our authenticated transfer packet may resume\\n  1342\\t                       ;; here; an invalid captured value explicitly refuses.\\n  1343\\t                       (u/if-node\\n  1344\\t                         (u/app (u/v 'dsg__equal)\\n  1345\\t                                (u/app (u/v 'dsg__get) (u/v escape)\\n  1346\\t                                       (u/lit :clj/escape-token))\\n  1347\\t                                (u/v 'dsg__call_token))\\n  1348\\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\\n  1349\\t                         (outcome-node\\n  1350\\t                           error-tag\\n  1351\\t                           (u/app (u/v 'yang.call/condition)\\n  1352\\t                                  (u/lit :yang.call/invalid-invocation)\\n  1353\\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\\n  1354\\t          public-bridge (u/app (u/lam [escape] activation) u/capture)\\n  1355\\t          bridged (if tail?\\n  1356\\t                    (u/if-node\\n  1357\\t                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\\n  1358\\t                      (u/app (u/v 'yang.call/invoke-with)\\n  1359\\t                             (u/v callee) (u/v arguments) (u/lit [])\\n  1360\\t                             (u/lam [condition] condition->outcome)\\n  1361\\t                             (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1362\\t                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\\n  1363\\t                      public-bridge)\\n  1364\\t                    public-bridge)\\n  1365\\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\\n  1366\\t                              bridged refused)\\n  1367\\t          ;; A callee carrying a call entry is convention territory whether it\\n  1368\\t          ;; admits or forges one, so admission rules it. Everything else is a\\n  1369\\t          ;; data-side invocation - a collection lookup or a raw closure call -\\n  1370\\t          ;; and the guest library's invoker owns those semantics. The invoker\\n  1371\\t          ;; is itself a published descriptor, so it is reached the same way\\n  1372\\t          ;; any guest callee is; its raise escapes to a capture of this site\\n  1373\\t          ;; and the resumed pass materializes the error outcome here.\\n  1374\\t          value-call (u/app\\n  1375\\t                       (u/lam ['dsg__raise_escape]\\n  1376\\t                              (u/if-node\\n  1377\\t                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\\n  1378\\t                                (u/let1\\n  1379\\t                                  (symbol (str reserved-prefix \\\"invoker_result\\\"))\\n  1380\\t                                  (u/app (u/v 'yang.call/invoke)\\n  1381\\t                                         (u/v 'invoke-value)\\n  1382\\t                                         (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\\n  1383\\t                                         (u/lit [])\\n  1384\\t                                         (u/lam [condition]\\n  1385\\t                                                (assoc (u/app (u/v 'dsg__raise_escape)\\n  1386\\t                                                              (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1387\\t                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\\n  1388\\t                                                                     (u/lit :clj/outcome) condition->outcome))\\n  1389\\t                                                       :tail? true)))\\n  1390\\t                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \\\"invoker_result\\\")))))\\n  1391\\t                                (u/if-node\\n  1392\\t                                  (u/app (u/v 'dsg__equal)\\n  1393\\t                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\\n  1394\\t                                                (u/lit :clj/escape-token))\\n  1395\\t                                         (u/v 'dsg__call_token))\\n  1396\\t                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\\n  1397\\t                                  (outcome-node\\n  1398\\t                                    error-tag\\n  1399\\t                                    (u/app (u/v 'yang.call/condition)\\n  1400\\t                                           (u/lit :yang.call/invalid-invocation)\\n  1401\\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\\n  1402\\t                       u/capture)\\n  1403\\t          routed (if (::invoker env)\\n  1404\\t                   (u/if-node\\n  1405\\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\\n  1406\\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\\n  1407\\t                                           (u/lit true)\\n  1408\\t                                           (cell-ref-shaped-node (u/v callee)))\\n  1409\\t                                (u/lit false))\\n  1410\\t                     admitted\\n  2410\\t;; Guest-side source, compiled through this compiler like any program: the\\n  2411\\t;; functions that invoke guest closures (map, filter, reduce, comp, partial)\\n  2412\\t;; must run on the VM, never on the host, because a closure is a VM value. It\\n  2413\\t;; is written for the argument-vector convention with the outcome model, so a\\n  2414\\t;; closure it calls is unwrapped by the compiler's own early-return pattern\\n  2415\\t;; and a closure's failure ends the library function with the same outcome.\\n  2416\\t;;\\n  2417\\t;; What is derived, from the VM primitives and the `data` module only:\\n  2418\\t;; identity, inc/dec, second, the collection predicates (coll?/vector?/map?/\\n  2419\\t;; set?/seq?/list?/sequential?, from the `portable/*` adapters of data/count,\\n  2420\\t;; peek, dissoc and disj: a refusal as data says \\\"not that kind\\\"), boolean?,\\n  2421\\t;; fn? (data/callable?), seq, rem, reverse, list, cons, vector, count,\\n  2422\\t;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\\n  2423\\t;; keys/vals/disj and set union/difference,\\n  2424\\t;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\\n  2425\\t;; compiler intrinsic over the convention's argument vector.\\n  2426\\t;;\\n  2427\\t;; What stays a host primitive, named by the `kind` module: a symbol, a\\n  2428\\t;; keyword and a host string are distinguished or built only by the host\\n  2429\\t;; (symbol?, keyword?, name, symbol, keyword, str, int?), as is metadata access\\n  2430\\t;; (meta and with-meta). The current data ABI has no metadata-write export,\\n  2431\\t;; so with-meta is an explicit pure representation seam, not an ambient store.\\n  2432\\t;; No VM primitive tells a symbol from a keyword. Clojure Var identity is an\\n  2433\\t;; explicitly admitted kind/var? seam on the JVM; namespace lookup (resolve)\\n  2434\\t;; still requires a separately installed host capability.\\n  2435\\t;;\\n  2436\\t;; Known compromises: `reduced` is an untyped tagged map, so reduced? matches\\n  2437\\t;; any map holding :yin.k/reduced true; seq refuses a non-collection (a string\\n  2438\\t;; is the data module's str-* ops, not a seq); eager sequences are lists;\\n  2439\\t;; rem rejects non-integers and a zero divisor before arithmetic; the compiler\\n  2440\\t;; emits bare conj and vec, so a program may not define or bind either.\\n  2441\\t;; When collection calls are needed, invoke-value is a library helper whose\\n  2442\\t;; local capture is refused explicitly.\\n  2443\\t;;\\n  2444\\t;; Variadic Clojure functions are fixed-arity here (the convention has no\\n  2445\\t;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\