\\t   collection predicates read (yang.clojure's `library-adapters`). A\\n   158\\t   linked clojure composition registers them beside the other runtimes'\\n   159\\t   registry surfaces; a composition without a clojure program reads none\\n   160\\t   of them.\\\"\\n   161\\t  [registry]\\n   162\\t  (let [portable (into {}\\n   163\\t                       (map (fn [[source _]]\\n   164\\t                              (let [op (symbol (name source))]\\n   165\\t                                [op (yang/outcome-adapter data/refusal-message\\n   166\\t                                                          (get data/data-module op))])))\\n   167\\t                       yang/library-adapters)]\\n   168\\t    (-> registry\\n   169\\t        (register-library-module 'kind yang/kind-module yang/kind-arities)\\n   170\\t        (register-library-module\\n   171\\t          'portable portable\\n   172\\t          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\\n   173\\t                (keys portable))))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n -i 'deftest.*(exception|throw|catch|finally|rethrow|try)|testing.*(exception|throw|catch|finally|rethrow)|ForeignException|yang.call/thrown|yang.call/raise' test/yang/clojure_test.clj test/yang/typescript/antlr test/yang/php/antlr test/yang/python/antlr test/yang/core/call_test.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n -i 'deftest.*(exception|throw|catch|finally|rethrow|try)|testing.*(exception|throw|catch|finally|rethrow)|ForeignException|yang.call/thrown|yang.call/raise' test/yang/clojure_test.clj test/yang/typescript/antlr test/yang/php/antlr test/yang/python/antlr test/yang/core/call_test.cljc\\\"\