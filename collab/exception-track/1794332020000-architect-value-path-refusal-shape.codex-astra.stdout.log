comes a `clj/global-get`, both under the name's string.\\n  2942\\t   The `names` a unit is lowered with are its own top-level definitions,\\n  2943\\t   its guest library's and the projected names the composition bound in\\n  2944\\t   the runtime global namespace, so a projected export and a definition\\n  2945\\t   read through the one binding: a definition the unit itself runs\\n  2946\\t   publishes after the projection and shadows it. A store definition\\n  2947\\t   inside the unit thunk is conditional to the linker, so no body read\\n  2948\\t   of it discharges (the runtime preludes avoid this by keeping every\\n  2949\\t   definition at module level); the runtime global namespace is the\\n  2950\\t   linked unit's definition table instead, as a Python module body\\n  2951\\t   writes its dictionary. Lexically bound names, quoted literals and\\n  2952\\t   macro definitions keep their store shape: a macro is not a runtime\\n  2953\\t   value.\\\"\\n  2954\\t  [node names bound]\\n  2955\\t  (case (:type node)\\n  2956\\t    :literal node\\n  2957\\t    :vm/current-continuation node\\n  2958\\t    :variable (if (and (contains? names (:name node))\\n  2959\\t                       (not (contains? bound (:name node))))\\n  2960\\t                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\\n  2961\\t                node)\\n  2962\\t    :lambda (assoc node :body (publish-to-globals (:body node) names\\n  2963\\t                                                  (into bound (:params node))))\\n  2964\\t    :application\\n  2965\\t    (if (and (= 'yin/def (get-in node [:operator :name]))\\n  2966\\t             (= 2 (count (:operands node)))\\n  2967\\t             (= :literal (:type (first (:operands node))))\\n  2968\\t             (contains? names (:value (first (:operands node)))))\\n  2969\\t      (u/app (u/v 'clj/define-global!)\\n  2970\\t             (u/lit (str (:value (first (:operands node)))))\\n  2971\\t             (publish-to-globals (second (:operands node)) names bound))\\n  2972\\t      (assoc node\\n  2973\\t             :operator (publish-to-globals (:operator node) names bound)\\n  2974\\t             :operands (mapv #(publish-to-globals % names bound)\\n  2975\\t                             (:operands node))))\\n  2976\\t    :if (cond-> node\\n  2977\\t          (contains? node :test)\\n  2978\\t          (assoc :test (publish-to-globals (:test node) names bound))\\n  2979\\t          (contains? node :consequent)\\n  2980\\t          (assoc :consequent (publish-to-globals (:consequent node) names bound))\\n  2981\\t          (contains? node :alternate)\\n  2982\\t          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\\n  2983\\t    (reduce (fn [n k]\\n  2984\\t              (let [v (get n k)]\\n  2985\\t                (if (or (and (map? v) (contains? v :type)) (vector? v))\\n  2986\\t                  (assoc n k (globals-child v names bound))\\n  2987\\t                  n)))\\n  2988\\t            node (keys node))))\\n  2989\\t\\n  2990\\t\\n  2991\\t(defn lower-unit\\n  2992\\t  \\\"The `clj/run-main` entry's unit for the top-level source `forms`: one\\n  2993\\t   thunk whose call runs the program — `forms` plus the definitions of\\n  2994\\t   the guest library they need, compiled unmodified under `unit-opts`\\n  2995\\t   and published to the runtime global namespace by\\n  2996\\t   `publish-to-globals` — so the helper's export projection can read\\n  2997\\t   each top-level definition. The two-argument form also takes the\\n  2998\\t   projected `exports` (names the composition already bound in the\\n  2999\\t   runtime global namespace): their free reads publish the same way, so\\n  3000\\t   the projection is the caller's binding for them. The program's own\\n  3001\\t   `yang.call` call sites need no free-name declaration: the convention\\n  3002\\t   preamble `compile-program` emits defines those names locally, and\\n  3003\\t   the donor publication pins the `yang.call` module for the qualified\\n  3004\\t   reads that remain.\\\"\\n  3005\\t  ([forms] (lower-unit forms []))\\n  3006\\t  ([forms exports]\\n  3007\\t   (let [source (vec forms)\\n  3008\\t         library (library-for source)\\n  3009\\t         program (compile-program (concat source library) true unit-opts)\\n  3010\\t         macros (into #{}\\n  3011\\t                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\\n  3012\\t                            (map (comp strip-symbol-meta second)))\\n  3013\\t                      (concat source library))\\n  3014\\t         names (reduce disj\\n  3015\\t                       (into (set (top-level-names source))\\n  3016\\t                             (concat (map (comp strip-symbol-meta second) library)\\n  3017\\t                                     (map symbol exports)))\\n  3018\\t                       macros)]\\n  3019\\t     (u/lam [] (publish-to-globals program names #{})))))\\n  3020\\t\\n  3021\\t\\n  3022\\t(defn output\\n  3023\\t  \\\"The `clj/run-main` value as test data.\\\"\\n  3024\\t  [value]\\n  3025\\t  (pr-str value))\\n  1319\\t(deftest test-common-call-source-admission\\n  1320\\t  (doseq [form '[(let [x 5] (x 1))\\n  1321\\t                 (let [x {:ordinary :map}] (x 1))\\n  1322\\t                 (let [x {:yang.call/entry 5}] (x 1))\\n  1323\\t                 (let [x {:py/type :function :code :legacy}] (x 1))\\n  1324\\t                 (let [x {:yang.call/entry 5}] ((if true x x) 1))\\n  1325\\t                 (let [x {:yang.call/entry (yang.call/entry f)}] (x 1))\\n  1326\\t                 (let [x (assoc {} :yang.call/entry (get f :yang.call/entry))] (x 1))\\n  1327\\t                 (let [x (assoc f :extra :forged)] (x 1))\\n  1328\\t                 (let [x (assoc f :yang.call/entry (yang.call/entry g))] (x 1))\\n  1329\\t                 (let [x (assoc {} :yang.call/entry (yang.call/entry f)\\n  1330\\t                                :clj/admission (get f :clj/admission))] (x 1))\\n  1331\\t                 (let [x {:yang.call/entry (yang.call/entry f)\\n  1332\\t                          :clj/admission (fn [x] true)}] (x 1))]]\\n  1333\\t    (doseq [wrap [identity #(list '+ 1 %)]]\\n  1334\\t      (let [result (run-outcome ['(defn f\\n  1335\\t                                    [x]\\n  1336\\t                                    x)\\n  1337\\t                                 '(defn g\\n  1338\\t                                    [x]\\n  1339\\t                                    (+ x 1)) (wrap form)])]\\n  1340\\t        (is (= :yin.k/error (first result)) (pr-str form))\\n  1341\\t        (is (= :yang.call/not-callable (:yang.call/reason (second result)))\\n  1342\\t            (pr-str form)))))\\n  1343\\t  (is (= [:yin.k/ok [false false true 21]]\\n  1344\\t         (run-outcome '[(defn f\\n  1345\\t                          [x]\\n  1346\\t                          x)\\n  1347\\t                        [(yang.call/eligible? {:yang.call/entry (yang.call/entry f)})\\n  1348\\t                         (yang.call/eligible? (assoc f :extra :forged))\\n  1349\\t                         (yang.call/eligible? f)\\n  1350\\t                         (f 21)]]))))\\n  1351\\t\\n  1352\\t\\n  1353\\t(deftest test-common-call-token-packet-forgery-refuses\\n  1354\\t  (testing \\\"a forged vector applied to the extracted public entry never\\n  1355\\t            enters the private body: the entry authenticates the packet on\\n  1356\\t            the compiler-held token and forged shapes refuse. The extraction\\n  1357\\t            and application happen INSIDE a compiled program (the packet\\n  1358\\t            dispatch lives in its preamble scope), the call spliced in as\\n  1359\\t            UAST over a marker call, on both evaluators.\\\"\\n  1360\\t    ;; forged VECTORS are the packet-dispatch axis (the P1 axis): each must\\n  1361\\t    ;; produce an error outcome without the body running. Scalar and empty\\n  1362\\t    ;; invocations hit the public entry's pre-existing non-record refusal\\n  1363\\t    ;; (a host throw, same before D2) and are covered by the entry's own\\n  1364\\t    ;; behavior, not this regression.\\n  1365\\t    (doseq [forged '[[] [42] [nil [42]] [a b c d]]]\\n  1366\\t      (let [;; the packet dispatch reached at runtime: extract the public\\n  1367\\t            ;; entry of the target (a source defn), then apply the forged\\n  1368\\t            ;; vector to it directly - bypassing source lowering entirely\\n  1369\\t            call-ast (u/let1 'raw\\n  1370\\t                             (u/app (u/v 'yang.call/entry) (u/v 'target))\\n  1371\\t                             (u/app (u/v 'raw) (u/lit forged)))\\n  1372\\t            ast (walk/postwalk\\n  1373\\t                  (fn [node]\\n  1374\\t                    (if (= node (u/v 'marker-call)) call-ast node))\\n  1375\\t                  (yang/compile-program\\n  1376\\t                    ['(defn target\\n  1377\\t                        [x]\\n  1378\\t                        :private-body-entered)\\n  1379\\t                     '(marker-call)]\\n  1380\\t                    true\\n  1381\\t                    {:convention :arg-vector\\n  1382\\t                     :outcomes true\\n  1383\\t                     :native (set (keys vm/primitive-profiles))}))]\\n  1384\\t        (doseq [run [walker-run semantic-run]]\\n  1385\\t          (let [result (try\\n  1386\\t                         (first (run ast))\\n  1387\\t                         (catch clojure.lang.ExceptionInfo e\\n  1388\\t                           (pr-str {:caught (ex-message e) :data (ex-data e)})))]\\n  2080\\t    (try\\n  2081\\t      (run-guest-ast ast cell-modules lane 1000000)\\n  2082\\t      (catch clojure.lang.ExceptionInfo e\\n  2083\\t        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\\n  2084\\t\\n  2085\\t\\n  2086\\t(deftest test-common-call-cell-ref-map-invocation\\n  2087\\t  (testing \\\"a full-shape data map with a 64-character seal is ordinary invocable data\\\"\\n  2088\\t    ;; The map spells every key of an issued reference and the seal has the\\n  2089\\t    ;; issued format; its :id names nothing in the engine's heap id language\\n  2090\\t    ;; (:cell-N), so it can never be genuine and its invocation is the map\\n  2091\\t    ;; lookup, on both evaluators, where the previous rounds' shape gates\\n  2092\\t    ;; routed it to admission and the dereference refused it.\\n  2093\\t    (is (= [:yin.k/ok :cell-ref]\\n  2094\\t           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\"}]\\n  2095\\t                            (m :type))])))\\n  2096\\t    (is (= [:yin.k/ok :some-key]\\n  2097\\t           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\"}]\\n  2098\\t                            (m :id))]))))\\n  2099\\t  (testing \\\"a runtime-built full-shape map (assoc, not a bound literal) invokes as data\\\"\\n  2100\\t    (is (= [:yin.k/ok :cell-ref]\\n  2101\\t           (run-library '[(let [m (assoc (assoc (assoc {} :type :cell-ref)\\n  2102\\t                                                :id :some-key)\\n  2103\\t                                         :seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\")]\\n  2104\\t                            (m :type))]))))\\n  2105\\t  (testing \\\"a full-shape map that is data is not call-eligible\\\"\\n  2106\\t    (is (= [:yin.k/ok false]\\n  2107\\t           (run-library '[(yang.call/eligible? {:type :cell-ref :id :some-key\\n  2108\\t                                                :seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\"})]))))\\n  2109\\t  (testing \\\"genuine references still dereference through admission\\\"\\n  2110\\t    ;; A cell the engine minted (:cell-0), holding a descriptor with a\\n  2111\\t    ;; callable entry: the call reaches the entry.\\n  2112\\t    (doseq [lane [:walker :semantic]]\\n  2113\\t      (is (= [:yin.k/ok :called]\\n  2114\\t             (run-cell-probe (u/app (u/v 'cell/new)\\n  2115\\t                                    (u/app (u/v 'assoc) (u/lit {})\\n  2116\\t                                           (u/lit :yang.call/entry)\\n  2117\\t                                           (u/lam ['invocation] (u/lit :called))))\\n  2118\\t                             lane))\\n  2119\\t          (str lane \\\" genuine live\\\"))))\\n  2120\\t  (testing \\\"a genuine-but-dead reference keeps the standing refusal\\\"\\n  2121\\t    ;; A genuine cell whose contents carry no call entry: admission answers\\n  2122\\t    ;; false and the call refuses as not-callable — the behavior the D2 bar\\n  2123\\t    ;; pins, unchanged by the data fallback.\\n  2124\\t    (doseq [lane [:walker :semantic]]\\n  2125\\t      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\\n  2126\\t                                                     lane)]\\n  2127\\t        (is (and (= :yin.k/error tag)\\n  2128\\t                 (= :yang.call/not-callable (:yang.call/reason payload)))\\n  2129\\t            (str lane \\\" genuine dead: \\\" (pr-str result))))))\\n  2130\\t  (testing \\\"the residual, pinned: a forged id inside the heap language fails closed in the VM\\\"\\n  2131\\t    ;; A map whose :id is a :cell-N keyword and whose seal has the issued\\n  2132\\t    ;; format but not the issued content: it is a dereference candidate the\\n  2133\\t    ;; VM's heap+seal check rejects — a host-level refusal, the same fate\\n  2134\\t    ;; any forged reference meets anywhere in the system. No in-language\\n  2135\\t    ;; authenticity probe exists (check-ref! throws past every guest catch),\\n  2136\\t    ;; so this class stays fail-closed until yin.vm publishes one.\\n  2137\\t    (doseq [lane [:walker :semantic]]\\n  2138\\t      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\\n  2139\\t             (run-cell-probe (u/lit {:type :cell-ref :id :cell-7\\n  2140\\t                                     :seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\"})\\n  2141\\t                             lane))\\n  2142\\t          (str lane \\\" forged in-language id\\\")))))\\n  2143\\t\\n  2144\\t\\n  2145\\t(deftest test-library-closes-over-its-own-names\\n  2565\\t                      (sum-calls (- n 1) (inc1 acc))))\\n  2566\\t                  (sum-calls 500 0)]\\n  2567\\t          ast (yang/compile-program forms true outcome-opts)]\\n  2568\\t      (doseq [lane [:walker :semantic]]\\n  2569\\t        (is (= [:yin.k/ok 500]\\n  2570\\t               (run-guest-ast ast outcome-modules lane 185000))\\n  2571\\t            (str lane \\\": 1000 intra-unit calls fit comfortably inside 185k steps.\\n  2572\\t                      The unary-entry token-packet lane (D2) with the final arity guard\\n  2573\\t                      measures 160,046 walker steps (86,822 semantic) for these 1000\\n  2574\\t                      calls - the guard's invocation-shape count check moved the walker\\n  2575\\t                      cost from the pre-guard 140,142 (140/call) to ~160/call. The\\n  2576\\t                      budget keeps ~15% headroom over the measured cost, recalibrated\\n  2577\\t                      2026-11-04 by direct step-count measurement.\\\")))))\\n  2578\\t  (testing \\\"local shadowing of a top-level defn preserves dynamic admission and routing\\\"\\n  2579\\t    (doseq [lane [:walker :semantic]]\\n  2580\\t      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\\n  2581\\t                            :yang.call/data {:yang.call/callee 5}}]\\n  2582\\t             (run-library '[(defn f\\n  2583\\t                              [x]\\n  2584\\t                              (+ x 100))\\n  2585\\t                            (let [f 5 v [f]] (f 1))]\\n  2586\\t                          library-opts lane 200000)))\\n  2587\\t      (is (= [:yin.k/ok 42]\\n  2588\\t             (run-library '[(defn f\\n  2589\\t                              [x]\\n  2590\\t                              (+ x 100))\\n  2591\\t                            (let [f (fn [y] (* y 2))] (f 21))]\\n  2592\\t                          library-opts lane 200000)))\\n  2593\\t      (is (= [:yin.k/ok 9]\\n  2594\\t             (run-library '[(defn f\\n  2595\\t                              [x]\\n  2596\\t                              (+ x 100))\\n  2597\\t                            (let [f {:k 9} v [f]] (f :k))]\\n  2598\\t                          library-opts lane 200000))\\n  2599\\t          \\\"entry-absent local map routes to invoke-value\\\")\\n  2600\\t      (let [[tag payload] (run-library\\n  2601\\t                            '[(defn f\\n  2602\\t                                [x]\\n  2603\\t                                (+ x 100))\\n  2604\\t                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]\\n  2605\\t                                (f 1))]\\n  2606\\t                            library-opts lane 200000)]\\n  2607\\t        (is (= :yin.k/error tag))\\n  2608\\t        (is (= :yang.call/not-callable (:yang.call/reason payload))\\n  2609\\t            \\\"entry-present forged local map routes to admission and refuses\\\"))\\n  2610\\t      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\\n  2611\\t                            :yang.call/data {:yang.call/callee 5}}]\\n  2612\\t             (run-library '[(defn f\\n  2613\\t                              [[f]]\\n  2614\\t                              (f 1))\\n  2615\\t                            (f [5])]\\n  2616\\t                          library-opts lane 200000))\\n  2617\\t          \\\"destructured parameter shadows enclosing defn\\\")\\n  2618\\t      (is (= [:yin.k/ok 7]\\n  2619\\t             (run-library '[(defn f\\n  2620\\t                              [x]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:24:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba test/yang/cross_lang_test.clj | sed -n '1,290p'; rg -n 'cell-ref|yang.call/(eligible\\\\\\\\?|invoke|entry)|defn.*call|\\\\\\\\[js/call|\\\\\\\\[php/call|\\\\\\\\[py/call' src/cljc/yang/typescript/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude_p9.cljc src/cljc/yang/python/antlr/prelude.cljc | head -160; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '350,385p'; rg -n 'cell/get|cell/set|cell/new' src/cljc/yin/vm/cell.cljc\\\"\",\"aggregated_output\":\"     1\\t(ns yang.cross-lang-test\\n     2\\t  \\\"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\\n     3\\t   bottom out in `:application`, and the engine neither knows nor cares which\\n     4\\t   frontend minted a closure. A TypeScript function value is called from\\n     5\\t   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\\n     6\\t   task, one run.\\n     7\\t\\n     8\\t   The seam is explicit published-export composition (8.10.11), owned by\\n     9\\t   `yang.call.conformance`: the donor source is published as a module and\\n    10\\t   run unmodified, its named export is read from the donor runtime's global\\n    11\\t   namespace (`globalThis.ts_fn`, PHP's `phpfn` function) and projected into the caller\\n    12\\t   runtime's namespace under the same name, and the caller source runs\\n    13\\t   unmodified. No call node is rewritten and no foreign `:code` extracted:\\n    14\\t   the caller holds the donor's own function cell, as the identity check\\n    15\\t   (`stored === phpfn`) shows.\\n    16\\t\\n    17\\t   What is pinned as LIMITS (documented expectations, not failures):\\n    18\\t   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\\n    19\\t   PHP null (`:php/null`) is neither JS null nor undefined. Each case runs\\n    20\\t   linked on the three vector VMs, which must agree.\\\"\\n    21\\t  (:require\\n    22\\t    [clojure.test :refer [deftest is testing]]\\n    23\\t    [yang.call.conformance :as xl]))\\n    24\\t\\n    25\\t\\n    26\\t(deftest ts-closure-called-from-php-test\\n    27\\t  (testing \\\"a number crosses as a number: float in, float out\\\"\\n    28\\t    (is (= \\\"4\\\"\\n    29\\t           (xl/call [:typescript \\\"globalThis.ts_fn = (x, y) => x + y;\\\"]\\n    30\\t                    [\\\"ts_fn\\\"]\\n    31\\t                    [:php \\\"<?php echo ts_fn(1.5, 2.5);\\\"]))))\\n    32\\t  (testing \\\"the PHP caller sees the result as an ordinary value\\\"\\n    33\\t    (is (= \\\"yes\\\"\\n    34\\t           (xl/call [:typescript \\\"globalThis.ts_fn = (x, y) => x + y;\\\"]\\n    35\\t                    [\\\"ts_fn\\\"]\\n    36\\t                    [:php \\\"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\\\"])))))\\n    37\\t\\n    38\\t\\n    39\\t(deftest php-closure-called-from-ts-test\\n    40\\t  (testing \\\"TS stores and calls the same PHP function cell it received\\\"\\n    41\\t    (is (= {:js/out [\\\"true 5\\\"], :js/uncaught nil}\\n    42\\t           (xl/call [:php \\\"<?php function phpfn($a, $b) { return $a + $b; }\\\"]\\n    43\\t                    [\\\"phpfn\\\"]\\n    44\\t                    [:typescript\\n    45\\t                     \\\"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\\\"])))))\\n    46\\t\\n    47\\t\\n    48\\t(deftest python-calls-typescript-closure-test\\n    49\\t  (testing \\\"TS stores and calls the same Python function cell it received\\\"\\n    50\\t    (is (= {:py/out [\\\"22\\\"], :py/exception nil}\\n    51\\t           (xl/call [:typescript\\n    52\\t                     (str \\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\"\\n    53\\t                          \\\"return stored === f ? f(20n) + 1n : -1n; };\\\")]\\n    54\\t                    [\\\"ts_apply\\\"]\\n    55\\t                    [:python \\\"print(ts_apply(lambda x: x + 1))\\\\n\\\"])))))\\n    56\\t\\n    57\\t\\n    58\\t(deftest typescript-calls-python-closure-test\\n    59\\t  (testing \\\"Python stores and calls the same TS function cell it received\\\"\\n    60\\t    (is (= {:js/out [\\\"22n\\\"], :js/uncaught nil}\\n    61\\t           (xl/call [:python\\n    62\\t                     (str \\\"def py_apply(f):\\\\n\\\"\\n    63\\t                          \\\"    global stored\\\\n\\\"\\n    64\\t                          \\\"    stored = f\\\\n\\\"\\n    65\\t                          \\\"    return f(20) + 1 if stored is f else -1\\\")]\\n    66\\t                    [\\\"py_apply\\\"]\\n    67\\t                    [:typescript\\n    68\\t                     \\\"console.log(py_apply(x => x + 1n));\\\"])))))\\n    69\\t\\n    70\\t\\n    71\\t(deftest python-calls-php-closure-test\\n    72\\t  (testing \\\"PHP stores and calls the same Python function cell it received\\\"\\n    73\\t    (is (= {:py/out [\\\"22\\\"], :py/exception nil}\\n    74\\t           (xl/call [:php\\n    75\\t                     (str \\\"<?php function php_apply($f) { global $stored; \\\"\\n    76\\t                          \\\"$stored = $f; return $stored === $f ? $f(20) + 1 : -1; }\\\")]\\n    77\\t                    [\\\"php_apply\\\"]\\n    78\\t                    [:python \\\"print(php_apply(lambda x: x + 1))\\\\n\\\"])))))\\n    79\\t\\n    80\\t\\n    81\\t(deftest php-calls-python-closure-test\\n    82\\t  (testing \\\"Python stores and calls the same PHP function cell it received\\\"\\n    83\\t    (is (= \\\"22\\\"\\n    84\\t           (xl/call [:python\\n    85\\t                     (str \\\"def py_apply(f):\\\\n\\\"\\n    86\\t                          \\\"    global stored\\\\n