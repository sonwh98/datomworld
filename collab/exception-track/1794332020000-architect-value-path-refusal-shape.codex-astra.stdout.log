          (is (= 62 (vm/value terminal)))
          (is (= (- full-steps budget) rem-steps)
              (str lane ": resuming carried consumer completes in exact remaining steps")))))))


(deftest test-intra-unit-call-lowering-guards-and-budget
  (testing "tight per-call step budget holds across non-tail and tail intra-unit calls"
    (let [forms '[(defn inc1
                    [x]
                    (+ x 1))
                  (defn sum-calls
                    [n acc]
                    (if (= n 0)
                      acc
                      (sum-calls (- n 1) (inc1 acc))))
                  (sum-calls 500 0)]
          ast (yang/compile-program forms true outcome-opts)]
      (doseq [lane [:walker :semantic]]
        (is (= [:yin.k/ok 500]
               (run-guest-ast ast outcome-modules lane 185000))
            (str lane ": 1000 intra-unit calls fit comfortably inside 185k steps.
                      The unary-entry token-packet lane (D2) with the final arity guard
                      measures 160,046 walker steps (86,822 semantic) for these 1000
                      calls - the guard's invocation-shape count check moved the walker
                      cost from the pre-guard 140,142 (140/call) to ~160/call. The
                      budget keeps ~15% headroom over the measured cost, recalibrated
                      2026-11-04 by direct step-count measurement.")))))
  (testing "local shadowing of a top-level defn preserves dynamic admission and routing"
    (doseq [lane [:walker :semantic]]
      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable
                            :yang.call/data {:yang.call/callee 5}}]
             (run-library '[(defn f
                              [x]
                              (+ x 100))
                            (let [f 5 v [f]] (f 1))]
                          library-opts lane 200000)))
      (is (= [:yin.k/ok 42]
             (run-library '[(defn f
                              [x]
                              (+ x 100))
                            (let [f (fn [y] (* y 2))] (f 21))]
                          library-opts lane 200000)))
      (is (= [:yin.k/ok 9]
             (run-library '[(defn f
                              [x]
                              (+ x 100))
                            (let [f {:k 9} v [f]] (f :k))]
                          library-opts lane 200000))
          "entry-absent local map routes to invoke-value")
      (let [[tag payload] (run-library
                            '[(defn f
                                [x]
                                (+ x 100))
                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]
                                (f 1))]
                            library-opts lane 200000)]
        (is (= :yin.k/error tag))
        (is (= :yang.call/not-callable (:yang.call/reason payload))
            "entry-present forged local map routes to admission and refuses"))
      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable
                            :yang.call/data {:yang.call/callee 5}}]
             (run-library '[(defn f
                              [[f]]
                              (f 1))
                            (f [5])]
                          library-opts lane 200000))
          "destructured parameter shadows enclosing defn")
      (is (= [:yin.k/ok 7]
             (run-library '[(defn f
                              [x]
                              99)
                            (try
                              (throw (ex-info "boom" {:k 7}))
                              (catch Exception f
                                (let [d (get f :yin.k/data) v [d]]
                                  (d :k))))]
                          library-opts lane 200000))
          "catch binder shadows top-level defn")))
  (testing "top-level def/defn interactions, error outcomes, and operand order"
  "The library's definitions, in order, as quoted source."
  '[(defn identity
      [x]
      x)
    (defn inc
      [x]
      (+ x 1))
    (defn dec
      [x]
      (- x 1))
    (defn second
      [x]
      (first (rest x)))
    (defn not=
      [a b]
      (not (= a b)))
    (defn boolean?
      [x]
      (or (= x true) (= x false)))
    (defn fn?
      [x]
      (if (data/callable? x) true (yang.call/eligible? x)))
    (defn ^:yin.k/invoker invoke-value
      [f args]
      (cond
        (vector? f) (if (= 1 (count args)) (nth f (first args))
                        (throw (ex-info "Vector invocation requires one index" {:argc (count args)})))
        (or (map? f) (keyword? f))
        (if (<= 1 (count args) 2)
          (if (keyword? f) (get (first args) f (second args))
              (get f (first args) (second args)))
          (throw (ex-info "Lookup invocation requires one key and optional default" {:argc (count args)})))
        (set? f) (if (= 1 (count args))
                   (if (contains? f (first args)) (first args) nil)
                   (throw (ex-info "Set invocation requires one key" {:argc (count args)})))
        ;; Everything unsupported - a scalar, a raw closure the convention
        ;; never published, a forged shape that slipped past the call-site
        ;; routing - refuses as the admission path would. No apply here: a
        ;; guest apply would re-enter the call-site dispatcher and recurse.
        ;; The compiler-generated raise handler stamps :dsg__condition with
        ;; the unforgeable token; the library form cannot name it directly.
        :else (throw (yang.call/condition :yang.call/not-callable {:yang.call/callee f}))))
    (defn update
      ([m k f] (assoc m k (f (get m k))))
      ([m k f a] (assoc m k (f (get m k) a)))
