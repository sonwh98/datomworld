 (u/lit :yang.call/named))\n  1070\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1071\t        binding-error (outcome-node\n  1072\t                        error-tag\n  1073\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1074\t                               (u/lit :yin.k/message)\n  1075\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1076\t                               (u/lit :yin.k/data)\n  1077\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1078\t                                      (u/lit :yang.call/named) named)))\n  1079\t        entry-body (u/let1\n  1080\t                     outcome\n  1081\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\n  1082\t                                (u/app (u/v body) positional)\n  1083\t                                binding-error)\n  1084\t                     (u/if-node (u/app (u/v 'dsg__equal)\n  1085\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\n  1086\t                                       (u/lit ok-tag))\n  1087\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1088\t                                (u/app raise\n  1089\t                                       (u/app (u/v 'yang.call/thrown)\n  1090\t                                              (u/app (u/v 'data/nth)\n  1091\t                                                     (u/v outcome) (u/lit 1))))))\n  1092\t        ;; The private lane forwards the body's outcome in tail position.\n  1093\t        ;; The public entry still converts outcomes to value/raise normally.\n  1094\t        ;; The compiler's token packet - a two-element vector whose first\n  1095\t        ;; element is the compiler-held token - selects the private tail\n  1096\t        ;; lane on the SAME unary entry: no record unwrap, no map lookups.\n  1097\t        ;; A guest cannot for