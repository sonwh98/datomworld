   997\\t  [refusal-message f]\\n   998\\t  (fn [& args]\\n   999\\t    (try\\n  1000\\t      [ok-tag (apply f args)]\\n  1001\\t      (catch #?(:clj Throwable, :cljs :default, :cljd Object) e\\n  1002\\t        (let [data (ex-data e)]\\n  1003\\t          (if (and (= refusal-message (ex-message e))\\n  1004\\t                   (contains? data :yin.vm.data/op)\\n  1005\\t                   (contains? data :yin.vm.data/reason))\\n  1006\\t            [error-tag data]\\n  1007\\t            (throw e)))))))\\n  1008\\t\\n  1009\\t\\n  1010\\t(defn- av-let\\n  2316\\t                                            false))))\\n  2317\\t                                    false)))\\n  2318\\t                             ;; The intra-unit dispatcher: resolve the unit's public entry,\\n  2319\\t                             ;; apply it with the compiler's token packet [token args] - one\\n  2320\\t                             ;; variadic conj and one application, no record construction.\\n  2321\\t                             ;; Non-map callees refuse.\\n  2322\\t                             (u/sexp->uast\\n  2323\\t                               (list 'fn '[dsg__callee dsg__args]\\n  2324\\t                                     (list 'if '(data/map? dsg__callee)\\n  2325\\t                                           (list (list (if (contains? (::defined env) 'get)\\n  2326\\t                                                         'dsg__get\\n  2327\\t                                                         'get)\\n  2328\\t                                                       'dsg__callee\\n  2329\\t                                                       :yang.call/entry)\\n  2330\\t                                                 (list 'conj '[]\\n  2331\\t                                                       'dsg__call_token\\n  2332\\t                                                       'dsg__args))\\n  2333\\t                                           '(conj (conj [] :yi