l-ref :id :cell-N :seal s}`; the content lives in the task's `:heap` (see `state.md`), never in the named store.\\nsrc/cljc/yin/vm/module.cljc:392:  (make-effect :cell/get {:cell c}))\\nsrc/cljc/yin/vm/module.cljc:409:   'get (vm/primitive-profile 'get :effectful [1] #{:cell/get} :none)\\nsrc/cljc/yin/vm/engine.cljc:331:(defn authentic-ref?\\nsrc/cljc/yin/vm/engine.cljc:362:  (if (authentic-ref? state kind ref)\\nsrc/cljc/yin/vm/engine.cljc:906:                  (not (authentic-ref? vm (:type x) x))\\nsrc/cljc/yin/vm/engine.cljc:2725:          :cell/get\\nsrc/cljc/yin/vm/engine.cljc:2726:          (let [id (check-ref! state :cell/get :cell-ref (:cell effect))]\\n  1140\\t             (p/rule? (first ks) \\\"newOperand\\\"))\\n  1141\\t         (or (and (some #(p/token? % \\\".\\\") ks)\\n  1142\\t                  (contains? #{\\\"identifierName\\\" \\\"typeGeneric\\\"} (:rule (peek ks))))\\n  1143\\t             (and (p/token? (peek ks) \\\"]\\\")\\n  1144\\t                  (some #(p/token? % \\\"[\\\") ks)\\n  1145\\t                  (p/rule? (nth ks (- (count ks) 2)) \\\"expressionSequence\\\"))))))\\n  1146\\t\\n  1147\\t\\n  1148\\t(defn- refuse-global!\\n  1149\\t  \\\"Permanently refuse (design section 8) the bare identifier `nm` at\\n  1150\\t   `callee` when it resolves to the global, not to a declared binding.\\\"\\n  1151\\t  [ctx callee nm]\\n  1152\\t  (when (and (= nm (simple-name ctx callee))\\n  1153\\t             (= :global (:kind (resolve-name ctx nm))))\\n  1154\\t    (refuse! callee nm :never)))\\n  1155\\t\\n  1156\\t\\n  1157\\t(defn- lower-super-call\\n  1158\\t  \\\"`super(args)` in a derived constructor, or an arrow inside it.\\\"\\n  1159\\t  [ctx args]\\n  1160\\t  (app* 'js/super-call\\n  1161\\t        (app* 'cell/get (u/v (:class-cell ctx)))\\n  1162\\t        (nt-node ctx)\\n  1163\\t        (u/v (:this-cell ctx))\\n  1164\\t        args))\\n  1165\\t\\n  1166\\t\\n  1167\\t(defn- lower-call\\n  1168\\t  [ctx n]\\n  1169\\t  (let [