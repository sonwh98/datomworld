or; }\\\"\\n    54\\t                         \\\" catch (Exception $e) { echo 'A'; } catch (Throwable $e) { echo 'B'; }\\\")))))\\n    55\\t  (testing \\\"an unmatched exception propagates out of the function\\\"\\n    56\\t    (is (= \\\"outer\\\"\\n    57\\t           (out (str \\\"<?php function f() { try { throw new Exception('x'); } catch (TypeError $e) { echo 'no'; } }\\\"\\n    58\\t                     \\\" try { f(); } catch (Exception $e) { echo 'outer'; }\\\")))))\\n    59\\t  (testing \\\"a leading backslash names the same class\\\"\\n    60\\t    (is (= \\\"k\\\" (out \\\"<?php try { throw new Exception; } catch (\\\\\\\\Exception $e) { echo 'k'; }\\\")))))\\n    61\\t\\n    62\\t\\n    63\\t(deftest finally-test\\n    64\\t  (testing \\\"finally runs on every exit and can override a return\\\"\\n    65\\t    (is (= \\\"F1\\\" (out \\\"<?php function f() { try { return 1; } finally { echo 'F'; } } echo f();\\\")))\\n    66\\t    (is (= \\\"2\\\" (out \\\"<?php function f() { try { return 1; } finally { return 2; } } echo f();\\\")))\\n    67\\t    (is (= \\\"Fa\\\" (out (str \\\"<?php try { try { throw new Exception('a'); } finally { echo 'F'; } }\\\"\\n    68\\t                          \\\" catch (Exception $e) { echo $e->getMessage(); }\\\")))))\\n    69\\t  (testing \\\"an exception from finally replaces the one in flight\\\"\\n    70\\t    (is (= \\\"b\\\" (out (str \\\"<?php try { try { throw new Exception('a'); } finally { throw new Exception('b'); } }\\\"\\n    71\\t                         \\\" catch (Exception $e) { echo $e->getMessage(); }\\\")))))\\n    72\\t  (testing \\\"finally after a catch, in a loop with break\\\"\\n    73\\t    (is (= \\\"cF\\\" (out \\\"<?php try { throw new Exception; } catch (Exception $e) { echo 'c'; } finally { echo 'F'; }\\\")))\\n    74\\t    (is (= \\\"F\\\" (out \\\"<?php while (true) { try { break; } finally { echo 'F'; } }\\\")))))\\n    75\\t\\n    76\\t\\n    77\\t(deftest match-test\\n    78\\t  (testin