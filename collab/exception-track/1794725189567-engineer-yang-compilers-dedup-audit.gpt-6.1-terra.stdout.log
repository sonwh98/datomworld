 311\t  \"The canonical row set `{:root :rows}` of the tree at `root` in `handle`,\n   312\t   every row fetched by its address, depth-first: `{:status :missing\n   313\t   :address a}` for the first row the handle does not hold, nil when a row\n   314\t   is not its address or no tree row.\"\n   315\t  [handle root]\n   316\t  (loop [todo [root]\n   317\t         rows {}]\n   318\t    (if-let [id (peek todo)]\n   319\t      (if (contains? rows id)\n   320\t        (recur (pop todo) rows)\n   321\t        (let [body (read-at handle id)\n   322\t              slots (when (vector? body)\n   323\t                      (get vm/semantic-bytecode-grammar (first body)))]\n   324\t          (cond\n   325\t            (absent? body) (missing id)\n   326\t            slots (recur (into (pop todo)\n   327\t                               (mapcat (fn [[_ kind] v]\n   328\t                                         (case kind\n   329\t                                           :node [v]\n   330\t                                           :nodes v\n   331\t                                           nil))\n   332\t                                       slots\n   333\t                                       (rest body)))\n   334\t                         (assoc rows id (into [id] body)))\n   335\t            :else nil)))\n   336\t      {:root root, :rows rows})))\n   337\t\n   338\t\n   459\t(defn- overlay\n   460\t  \"A write-buffering handle over `base`: reads see the buffer first, then\n   461\t   `base`; puts land in the buffer only, in put order. `flush!` writes the\n   462\t   buffer to `base`; dropping the overlay writes nothing.\"\n   463\t  [base]\n   464\t  (let [buf (atom {:bytes {}, :order []})\n   465\t        sentinel #?(:cljs (js-obj)\n   466\t                    :default (Object.))]\n   467\t    {:handle (assoc base\n   468\t                    :get-bytes-fn (fn [address not-found]\n   469\t                                    (let [bs (get-in @buf [:bytes address])]\n   470\t                                      (if (nil? bs)\n   471\t                                        ((:get-bytes-fn base) address not-found)\n   472\t                                        bs)))\n   473\t                    :put-bytes-fn (fn [address bs]\n   474\t                                    (if (or (contains? (:bytes @buf) address)\n   475\t                                            (let [existing ((:get-bytes-fn base)\n   476\t                                                            address\n   477\t                                                            sentinel)]\n   478\t                                              (and (some? existing)\n   479\t                                                   (not (identical? sentinel\n   480\t                                                                    existing)))))\n   481\t                                      :present\n   482\t                                      (do (swap! buf (fn [b]\n   483\t                                                       (-> b\n   484\t                                                           (assoc-in [:bytes address]\n   485\t                                                                     bs)\n   486\t                                                           (update :order conj\n   487\t                                                                   address))))\n   488\t                                          :inserted))))\n   489\t     :flush! (fn []\n   490\t               (let [{:keys [bytes order]} @buf]\n   491\t                 (doseq [a order] ((:put-bytes-fn base) a (get bytes a)))))}))\n   492\t\n   493\t\n(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\n yang.php.antlr.quoted\n  \"The `defquoted` macro the prelude's definition vectors share.\"\n  #?(:cljs (:require-macros [yang.php.antlr.quoted :refer [defquoted]]))\n  #?(:cljd (:require [clojure.edn :as edn])))\n\n\n#?(:clj\n   (defmacro defquoted\n     \"`def` of the quoted data `form`; ClojureDart reads it back from one EDN\n      string (its quoted data compiles to straight-line Dart).\"\n     [name doc form]\n     (if (find-ns 'cljd.compiler)\n       (list 'def name doc (list 'edn/read-string (pr-str (second form))))\n       (list 'def name doc form))))\nsrc/cljc/yang/php/antlr/lower.cljc:208:(defn- hex-value\nsrc/cljc/yang/php/antlr/lower.cljc:2323:(defn- wrap-escape\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:119:(defn- definitions->uast\nsrc/cljc/yang/python/antlr/prelude.cljc:3684:(defn- definitions->uast\nsrc/cljc/yang/typescript/antlr/prelude.cljc:4306:(defn- definitions->uast\nsrc/cljc/yang/python/antlr/lower.cljc:234:(defn- build-vector\nsrc/cljc/yang/python/antlr/lower.cljc:344:(defn- code-point->str\nsrc/cljc/yang/python/antlr/lower.cljc:362:(defn- hex-value\nsrc/cljc/yang/php/antlr/safepoint.cljc:40:(defn- definitions->uast\nsrc/cljc/yang/python/antlr/safepoint.cljc:361:(defn- definitions->uast\nsrc/cljc/yang/typescript/antlr/lower.cljc:177:(defn- build-vector\nsrc/cljc/yang/typescript/antlr/lower.cljc:233:(defn- wrap-escape\nsrc/cljc/yang/typescript/antlr/lower.cljc:243:(defn- code-point->str\nsrc/cljc/yang/typescript/antlr/lower.cljc:302:(defn- hex-value\nsrc/cljc/yang/php/antlr/prelude.cljc:6197:(defn- definitions->uast\n\n(def ^:private app* core/app*)\n\n\n(defn- build-vector\n  [elems]\n  (reduce (fn [acc e] (app* 'py/vconj acc e)) (u/lit []) elems))\n\n\n(defn- truthy\n  [x]\n  (app* 'py/truthy x))\n\n\n(def ^:private none (u/lit :py/None))\n\n\n(def ^:private contains-rule? core/contains-rule?)\n\n\n(def ^:private scope-rules #{\"funcdef\" \"lambdef\" \"lambdef_nocond\" \"classdef\"})\n(defn- code-point->str\n  [cp]\n  #?(:cljd (let [sb (StringBuffer)] (.writeCharCode sb cp) (.toString sb))\n     :clj (String. (Character/toChars (int cp)))\n     :cljs (.fromCodePoint js/String cp)))\n\n\n(defn- escape-value\n  \"The value of an escape's hex or octal `digits`, already checked: at\n   most eight, so the native accumulator is exact on every host.\"\n  [digits radix]\n  (reduce (fn [acc ch]\n            (+ (* acc radix)\n               (str/index-of \"0123456789abcdef\" (str/lower-case (str ch)))))\n          0\n          digits))\n\n\n(defn- hex-value\n  [n s]\n  (when-not (re-matches #\"[0-9a-fA-F]+\" s)\n    (syntax! n \"malformed escape in string literal\"))\n  (let [cp (escape-value s 16)]\n    (when (> cp 0x10FFFF)\n      (syntax! n \"illegal Unicode character in \\\\U escape\"))\n    cp))\n\n\n(def ^:private simple-escapes\n(defn- truthy\n  [x]\n  (app* 'js/to-boolean x))\n\n\n(defn- build-vector\n  [elems]\n  (reduce (fn [acc e] (app* 'js/vconj acc e)) (u/lit []) elems))\n\n\n(defn- seq-of\n(defn- wrap-escape\n  \"`node` run under a `js/call-ec` that binds escape `sym`, when `bound?`.\"\n  [bound? sym node]\n  (if bound? (app* 'js/call-ec (u/lam [sym] node)) node))\n\n\n;; =============================================================================\n;; Literals\n;; =============================================================================\n\n(defn- code-point->str\n  [cp]\n  #?(:cljd (let [sb (StringBuffer)] (.writeCharCode sb cp) (.toString sb))\n     :clj (String. (Character/toChars (int cp)))\n     :cljs (.fromCodePoint js/String cp)))\n\n\n(defn- text-units\n(defn- hex-value\n  [n s]\n  (when-not (re-matches #\"[0-9a-fA-F]+\" s)\n    (syntax! n \"Invalid escape sequence\"))\n  (reduce (fn [acc ch]\n            (+ (* acc 16) (str/index-of \"0123456789abcdef\" (str/lower-case (str ch)))))\n          0\n          s))\n\n\n(defn- cp-units\n  3121 src/cljc/yang/clojure.cljc\n   248 src/cljc/yang/clojure/prelude.cljc\n   197 src/cljc/yang/core/call.cljc\n    74 src/cljc/yang/core/claims.cljc\n    99 src/cljc/yang/core/lower.cljc\n   103 src/cljc/yang/core/module.cljc\n    69 src/cljc/yang/core/names.cljc\n   177 src/cljc/yang/core/prelude.cljc\n   172 src/cljc/yang/core/publication.cljc\n    95 src/cljc/yang/core/stage.cljc\n   151 src/cl