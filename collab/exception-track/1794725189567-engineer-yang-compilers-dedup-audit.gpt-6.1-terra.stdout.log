cipals.\"\n+  [ctx records manifest]\n+  (into (vec (get records manifest))\n+        (discover (:datoms ctx) (:principals ctx) manifest)))\n+\n+\n+(defn- derive-closure\n+  \"The instrumented module of `manifest` under a hook profile, derived\n+   bottom-up: each guest requirement is admitted and derived first, so the\n+   derived module pins the derived requirements it will link (`derived`,\n+   {A A'}, derives a shared requirement once). Answers `{:status :ok\n+   :address a' :derivation d :derived derived}`, the first refusal, with\n+   `:name` the requirement that was refused and `:via` the module that\n+   required it, or `{:status :missing :address a}` for the first address\n+   (record, set, guest manifest, tree row) read in a fixed depth-first\n+   order that the handle does not hold. Nothing is written until every\n+   read has succeeded.\"\n+  [ctx registry records requirement manifest derived]\n+  (let [handle (:store ctx)\n+        runtime (or (:runtime requirement) '#{py pysp yang.call})\n+        adm (admit handle manifest (records-for ctx records manifest)\n+                   requirement)]\n+    (if (not= :ok (:status adm))\n+      adm\n+      (let [m (fetch handle manifest)\n+            deps (sort-by (comp str key)\n+                          (remove (comp runtime key)\n+                                  (:yin.module/requires m)))\n+            below (reduce (fn [acc [n a]]\n+                            (if (contains? (:derived acc) a)\n+                              acc\n+                              (let [r (derive-closure ctx registry records\n+                                                      requirement a\n+                                                      (:derived acc))]\n+                                (case (:status r)\n+                                  :ok (assoc acc :derived (:derived r))\n+                                  :missing (reduced r)\n+                                  (reduced (cond-> (assoc r :via manifest)\n+                                             (nil? (:name r)) (assoc :name n)))))))\n+                          {:derived derived}\n+                          deps)]\n+        (if (:status below)\n+          below\n+          (let [out (derive-module handle registry manifest m adm requirement\n+                                   (:derived below))]\n+            (if (not= :ok (:status out))\n+              out\n+              (assoc out :derived (assoc (:derived below) manifest\n+                                         (:address out))))))))))\n+\n+\n (defn- overlay\n   \"A write-buffering handle over `base`: reads see the buffer first, then\n    `base`; puts land in the buffer only, in put order. `flush!` writes the\n@@ -227,102 +491,62 @@\n                  (doseq [a order] ((:put-bytes-fn base) a (get bytes a)))))}))\n \n \n-(defn- stage-refusal\n-  [reason manifest]\n-  {:status :refused, :reason reason, :manifest manifest})\n-\n-\n-(defn- stage-admit\n-  [handle manifest records]\n-  (let [m (read-at handle manifest)]\n-    (cond\n-      (absent? m) (missing manifest)\n-      (not (map? m)) (stage-refusal :yang.php.antlr/site-set-mismatch manifest)\n-      (empty? records) (stage-refusal :yang.php.antlr/missing-site-set manifest)\n-      :else\n-      (loop [[a & more] records]\n-        (if-not a\n-          (stage-refusal :yang.php.antlr/site-set-mismatch manifest)\n-          (let [record (read-at handle a)\n-                set-address (when (map? record) (:yang.site/set record))\n-                sites (when set-address (read-at handle set-address))]\n-            (cond\n-              (absent? record) (missing a)\n-              (absent? sites) (missing set-address)\n-              (verify handle manifest a) {:status :ok, :record a}\n-              :else (recur more))))))))\n-\n-\n-(defn- derive-closure\n-  [ctx registry requirement records manifest derived]\n-  (let [handle (:store ctx)\n-        runtime (or (:runtime requirement) '#{php php.sp yang.call})\n-        candidates (into (vec (get records manifest))\n-                         (discover (:datoms ctx) (:principals ctx) manifest))\n-        admitted (stage-admit handle manifest candidates)]\n-    (if (not= :ok (:status admitted)) admitted\n-        (let [m (read-at handle manifest)\n-              deps (sort-by (comp str key)\n-                            (remove (comp runtime key) (:yin.module/requires m)))\n-              below (reduce (fn [acc [name address]]\n-                              (if (contains? (:derived acc) address) acc\n-                                  (let [r (derive-closure ctx registry requirement records\n-                                                          address (:derived acc))]\n-                                    (if (= :ok (:status r))\n-                                      (assoc acc :derived (:derived r))\n-                                      (reduced (cond-> r\n-                                                 (nil? (:name r)) (assoc :name name)\n-                                                 true (assoc :via manifest)))))))\n-                            {:derived derived} deps)]\n-          (if (:status below) below\n-              (let [tree (load-tree handle (:yin.module/tree m))]\n-                (cond\n-                  (= :missing (:status tree)) tree\n-                  (nil? tree) (stage-refusal :yang.php.antlr/instrumentation-failed manifest)\n-                  :else\n-                  (try\n-                    (let [d (derive-verified handle manifest (:record admitted) tree\n-                                             (:hooks-profile requirement))\n-                          ast (when d (u/then (core-module/require-node 'php.sp)\n-                                              (vm/semantic-bytecode->ast (:tree d))))\n-                          requires (assoc (into {} (map (fn [[n a]]\n-                                                          [n (if (contains? runtime n) a\n-                                                                 (get (:derived below) a a))]))\n-                                                (:yin.module/requires m))\n-                                          'php.sp (:php-sp requirement))\n-                          primitives (when ast\n-                                       (core-module/free-primitives\n-                                         :yang.php/error :yang.php/undeclared registry\n-                                         (set (keys requires)) ast))\n-                          out (when ast (publish/publish-module!\n-                                          handle {:name (:yin.module/name m), :ast ast,\n-                                                  :exports (:yin.module/exports m),\n-                                                  :requires requires, :primitives primitives}))]\n-                      (if (or (nil? out) (= :refused (:status out)))\n-                        (stage-refusal :yang.php.antlr/instrumentation-failed manifest)\n-                        (let [record (assoc (:record d) :yin.ledger/output\n-                                            (:yin.module/tree (:manifest out)))]\n-                          {:status :ok, :address (:address out),\n-                           :derivation (jing/materialize! handle record),\n-                           :derived (assoc (:derived below) manifest (:address out))})))\n-                    (catch #?(:cljd Object :clj Exception :cljs :default) e\n-                      (assoc (stage-refusal :yang.php.antlr/instrumentation-failed manifest)\n-                             :message (ex-message e)))))))))))\n+(def reasons\n+  \"The refusal reasons the stage answers, the composition's own.\"\n+  #{:yang.python.antlr/missing-site-set\n+    :yang.python.antlr/site-set-mismatch\n+    :yang.python.antlr/profile-undeclared\n+    :yang.python.antlr/instrumentation-failed})\n \n \n (defn stage\n-  \"A write-buffered, bottom-up stage over verified PHP site publications.\"\n+  \"The link-time stage (`yin.vm.linker.interpreter/composition`'s `:stage`)\n+   of a Python import under `requirement`: `{:profile name :hooks true\n+   :hooks-profile p :pysp address}` or `{:profile name :noninterruptible\n+   true}`, with `:runtime` the names of the runtime modules (default `py`,\n+   `pysp`, and `yang.call`) it passes through. `yang.call` is the shared\n+   call dispatcher, not guest Python code, so it has no Python site marks.\n+   `records` ({manifest [record-address ...]})\n+   are the local publication's records; a DHT source supplies none and the\n+   stage discovers them from the index datoms of its context. The stage\n+   reads only the context's `:store` and never fetches: it answers\n+   `{:status :missing :address a}` for the first address that store does\n+   not hold, and is run again once it is there. Answers\n+   `(fn [ctx name address])`: `{:status :ok :address address}` as published\n+   when noninterruptible, else the address of the instrumented module\n+   derived bottom-up from the verified sets (`:derivation` its `:derive`\n+   record's address), or the refusal naming the profile, the set and the\n+   `:name` refused.\"\n   [registry requirement records]\n-  (let [runtime (or (:runtime requirement) '#{php php.sp yang.call})]\n+  (let [runtime (or (:runtime requirement) '#{py pysp yang.call})]\n     (fn [ctx name address]\n       (cond\n         (contains? runtime name) {:status :ok, :address address}\n-        (:noninterruptible requirement) {:status :ok, :address address}\n-        (not (:hooks requirement)) (stage-refusal :yang.php.antlr/profile-undeclared address)\n+\n+        (:noninterruptible requirement)\n+        (assoc (admit (:store ctx) address [] requirement) :address address)\n+\n         :else\n         (let [{:keys [handle flush!]} (overlay (:store ctx))\n-              result (derive-closure (assoc ctx :store handle) registry requirement\n-                                     records address {})]\n-          (if (= :ok (:status result))\n-            (do (flush!) (select-keys result [:status :address :derivation]))\n-            result))))))\n+              r (derive-closure (assoc ctx :store handle) registry records\n+                                requirement address {})]\n+          (case (:status r)\n+            :ok (do (flush!)\n+                    (select-keys r [:status :address :derivation :instrumented?\n+                                    :set-address]))\n+            :missing (select-keys r [:status :address])\n+            (cond-> r (nil? (:name r)) (assoc :name name))))))))\n+\n+\n+(defn signed-entries\n+  \"The `publisher` key's signed publication entries for the site sets\n+   `publish-units!` answered: `sites` (`:sites`), the manifest of each\n+   from `addresses` (a Python name) or `bundles` (a bundle symbol), in\n+   key order. The publisher that asserts these names indexes them in the\n+   same transaction (`entry-datoms`); a module with no entry is refused\n+   by every hook-profile reader.\"\n+  [publisher sites addresses bundles]\n+  (mapv (fn [[k s]]\n+          (signed-entry publisher (or (get addresses k) (get bundles k))\n+                        (:record-address s)))\n+        (sort-by (comp str key) sites)))\n(ns yang.php.antlr.publication\n  \"P6 (docs/design/yang.php.md section 11): a set of compiled PHP units\n   published as linker modules. The ordering, SCC bundling and publish loop\n   are `yang.core.publication`'s; this namespace supplies the PHP hooks: the\n   includes `lower/imported-unit-names` folds, the `lower/module-spec` and\n   `lower/scc-module-specs` emitters and site sets; no binder table.\n\n   A unit is `{:name path :packet p :strict-types b}`, `path` its normalized\n   relative path; the optional class map entry is `{:name \\\"$classmap\\\"\n   :classes {class path} :paths [path ...]}`. Name assertions stay the\n   linker's: this namespace publishes content, it signs nothing.\"\n  (:require\n    [yang.core.publication :as core]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.siteset :as siteset]\n    [yin.vm.linker.publish :as publish]))\n\n\n(defn- class-map?\n  \"The autoload class map entry of a unit set, `{:name \\\"$classmap\\\" :classes\n   {class path} :paths [path ...]}`: it imports every path it lists, so it\n   publishes last and an unpublished path is refused by name (plan P6 R9).\"\n  [unit]\n  (= lower/classmap-name (:name unit)))\n\n\n(defn- config\n  [publish-fn]\n  {:imported-names (fn [{:keys [name packet], :as unit}]\n                     (if (class-map? unit)\n                       (lower/classmap-paths unit)\n                       (lower/imported-unit-names packet {:path name}))),\n   :module-spec (fn [registry {:keys [name packet strict-types], :as unit} php-address deps]\n                  (if (class-map? unit)\n                    (lower/classmap-spec registry unit php-address deps)\n                    (lower/module-spec registry packet\n                                       {:path name,\n                                        :strict-types strict-types,\n                                        :php-address php-address,\n                                        :deps deps}))),\n   :scc-module-specs lower/scc-module-specs,\n   :site-set siteset/publish!,\n   :alias-site-set true,\n   :binder-table nil,\n   :refusal-ns \"yang.php\",\n   :publish-fn publish-fn})\n\n\n(defn publication-order\n  \"Dependency-first names, retaining the input order for acyclic units.\n   Cyclic components appear as sorted member vectors in :order, one\n   publication step per SCC. An include edge no unit and no `published`\n   entry supplies is refused `:yang.php/unpublished-import` by name.\"\n  [units published]\n  (core/publication-order (config publish/publish-module!) units published))\n\n\n(defn publish-units!\n  \"Publish `units` into the content store `handle` over the host registry\n   `registry`, `php` pinned at `php-address` and each include outside the\n   set at its address in `published` ({path address}), in\n   `publication-order`. Answers `{:status :ok :addresses {path address}\n   :bundles {bundle-symbol address}}`, or the first refusal:\n   `publication-order`'s before anything is written, else\n   `publish-module!`'s with a string `:unit`.\"\n  ([handle registry php-address units]\n   (publish-units! handle registry php-address units {}))\n  ([handle registry php-address units published]\n   (publish-units! handle registry php-address units published publish/publish-module!))\n  ([handle registry php-address units published publish-fn]\n   (core/publish-units! (config publish-fn) handle registry php-address units published)))\n(ns yang.python.antlr.publication\n  \"C4 slices I3 and I5 (docs/design/yang.antlr.md 8.5.6): a set of compiled Python\n   units published as linker modules. The ordering, SCC bundling and publish\n   loop are `yang.core.publication`'s; this namespace supplies the Python\n   hooks: the imports `lower/imported-module-names` hoists, the\n   `lower/module-spec` and `lower/scc-module-specs` emitters, the I7 site\n   set, and no binder table. Every Python module pins the `yang.call`\n   address from the published `py` module's requirements because its\n   runtime call path uses that dispatcher.\n   Name assertions stay the linker's (`yin.vm.linker.publish/assertion`\n   and `name-envelopes`): this namespace publishes content, it signs\n   nothing.\"\n  (:require [dao.jing :as jing]\n            [yang.core.publication :as core]\n            [yang.python.antlr.lower :as lower]\n            [yang.python.antlr.siteset :as siteset]\n            [yin.vm.linker.publish :as publish]))\n\n\n(defn- unit-imports\n  \"The Python modules unit `u` statically imports.\"\n  [{:keys [name package? packet]}]\n  (lower/imported-module-names packet\n                               {:name name, :package? (boolean package?)}))\n\n\n(defn- config\n  [publish-fn call-address]\n  {:imported-names unit-imports,\n   :module-spec (fn [registry {:keys [name package? packet]} py-address deps]\n                  (lower/module-spec registry packet\n                                     {:name name, :package? package?,\n                                      :py-address py-address, :call-address call-address,\n                                      :deps deps})),\n   :scc-module-specs (fn [registry units py-address deps]\n                       (lower/scc-module-specs registry units py-address call-address deps)),\n   :site-set siteset/publish!,\n   :binder-table nil,\n   :refusal-ns \"yang.python.antlr\",\n   :publish-fn publish-fn})\n\n\n(defn publication-order\n  \"Dependency-first names, retaining the I3 order for acyclic units.\n   Cyclic components appear as sorted member vectors in :order, one\n   publication step per SCC. External imports must be in `published`.\"\n  [units published]\n  (core/publication-order (config publish/publish-module! nil) units published))\n\n\n(defn publish-units!\n  \"Publish `units` (`[{:name :package? :packet}]`) into the content store\n   `handle` over the host registry `registry`, `py` pinned at\n   `py-address` and each import outside the set at its address in\n   `published` ({python-name address}), in `publication-order`. Answers\n   `{:status :ok :addresses {python-name address}\n     :bundles {bundle-symbol address}\n     :sites {python-name-or-bundle-symbol site-publication}}` for the units\n   of the set (`siteset/publish!`'s answer for each module published beside\n   its code image, I7; an SCC member alias carries no marks and so no\n   entry, its bundle does). The publisher that asserts these names\n   indexes `siteset/signed-entries` of `:sites` in the same index\n   transaction; a module whose entry is missing is refused by every\n   hook-profile reader. Or the\n   first refusal: `publication-order`'s before anything is written, else\n   `publish-module!`'s with a string `:unit`: the Python name for a member,\n   or the bundle module name for an SCC bundle. Every bundle name must be\n   asserted/bound alongside the member names for aliases to deliver.\n   Optional `publish-fn` takes `[handle spec]`, defaulting to\n   `publish/publish-module!`, for both bundles and members.\"\n  ([handle registry py-address units]\n   (publish-units! handle registry py-address units {}))\n  ([handle registry py-address units published]\n   (publish-units! handle registry py-address units published publish/publish-module!))\n  ([handle registry py-address units published publish-fn]\n   (let [py-manifest (when (and handle py-address)\n                       (jing/get handle py-address nil))\n         call-address (get-in py-manifest [:yin.module/requires 'yang.call])]\n     (core/publish-units! (config publish-fn call-address)\n                          handle registry py-address units published))))\n(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]\n    [yang.core.module :as module]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def ticks-profile\n  \"Statement completion hooks for PHP's lexical ticks directives. This is\n   separate from the execution-budget profile so ticks do not charge it.\"\n  {:line {:hook 'php.sp/line, :operands true, :after true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\n\n\n(defn module-spec\n  \"The linked ticks hook delegates to the shared PHP runtime.\"\n  [registry php-address]\n  (let [ast (module/module-tree\n              [(module/require-node 'php)\n               (u/def! 'line (u/sexp->uast '(fn [line site] (php/tick-line line site))))])\n        requires {'php php-address}]\n    {:name 'php.sp, :ast ast, :exports '#{line}, :requires requires,\n     :primitives (module/free-primitives :yang.php/error :yang.php/undeclared\n                                         registry (set (keys requires)) ast)}))\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:119:(defn- definitions->uast\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:126:  (u/mark-tails (u/then (definitions->uast function-definitions)\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:127:                        (definitions->uast state-definitions))))\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:132:  (u/mark-tails (definitions->uast '[[js.sp/loop (fn [] :js/undefined)]\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:136:(defn program\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:143:(defn linked-program\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:170:(defn strip\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:213:(defn module-spec\nsrc/cljc/yang/python/antlr/safepoint.cljc:361:(defn- definitions->uast\nsrc/cljc/yang/python/antlr/safepoint.cljc:368:  (u/mark-tails (u/then (definitions->uast function-definitions)\nsrc/cljc/yang/python/antlr/safepoint.cljc:369:                        (definitions->uast state-definitions))))\nsrc/cljc/yang/python/antlr/safepoint.cljc:374:  (u/mark-tails (definitions->uast '[[py.sp/loop (fn [] :py/None)]\nsrc/cljc/yang/python/antlr/safepoint.cljc:379:(defn program\nsrc/cljc/yang/python/antlr/safepoint.cljc:386:(defn linked-program\nsrc/cljc/yang/python/antlr/safepoint.cljc:416:(defn strip\nsrc/cljc/yang/python/antlr/safepoint.cljc:454:(defn module-spec\n1:(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\n79:    #?(:cljd [clojure.edn :as edn])\n86:    [yang.php.antlr.prelude-module :as module-defs]\n87:    [yang.php.antlr.prelude-p9 :as p9-defs]\n88:    [yang.php.antlr.quoted :refer [defquoted]]\n113:(defquoted ^:private core-definitions\n6192:  (into (into (into core-definitions module-defs/definitions) p9-defs/definitions)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"diff -u <(sed -n '361,475p' src/cljc/yang/python/antlr/safepoint.cljc) <(sed -n '119,233p' src/cljc/yang/typescript/antlr/safepoint.cljc) | head -230; diff -u <(sed -n '166,229p' src/cljc/yang/php/antlr/siteset.cljc) <(sed -n '310,338p;459,493p' src/cljc/yang/python/antlr/siteset.cljc); diff -u <(sed -n '1,105p' src/cljc/yang/python/antlr/render.cljc) <(sed -n '1,102p' src/cljc/yang/typescript/antlr/render.cljc) | head -140; rg -n '\"'^'\"\\\\(def' src/cljc/yang/clojure.cljc src/cljc/yang/core/{lower,publication,stage}.cljc src/cljc/yang/{frontend,stage,safepoint,tails}.cljc | tail -70\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
