jc\n@@ -118,6 +118,19 @@\n      :metadata (:yin/frontend-metadata projected)}))\n \n \n+(defn- project-under\n+  \"`project` under an explicit batch token: the same medium and the same\n+   member index, a DIFFERENT admission. `distinct-admission-token-test` uses\n+   it to model two admissions of one packet, which is the only way to\n+   exercise design `:139`'s fresh-admission-identity requirement from\n+   inside a frontend suite.\"\n+  [ast batch-token]\n+  (let [projected (encoder/project\n+                    (encoder/source-envelope medium batch-token [ast]))]\n+    {:tree (first (:yin/batch projected))\n+     :metadata (:yin/frontend-metadata projected)}))\n+\n+\n (defn- eligible-under\n   \"The eligible C1 site set of canonical `tree` under `origin`, derived\n    here directly from the occurrence relation and the row tags —\n@@ -176,6 +189,12 @@\n   (filterv #(= :yang/call-site (nth % 3)) metadata))\n \n \n+(defn- row-origins\n+  \"The distinct occurrence origins a C1 marker relation carries.\"\n+  [metadata]\n+  (into #{} (map first) (marker-rows metadata)))\n+\n+\n (defn- failure-rule\n   [f]\n   (try (f) ::no-failure\n@@ -687,44 +706,95 @@\n ;; The export audit (the python F2 pin's shape, itself the ts twin's mirror)\n ;; =============================================================================\n \n+(def ^:private guest-surface-deny-strings\n+  \"Substrings no guest-visible name may carry: the occurrence contract's own\n+   key, and the exception track's reserved-door family.\"\n+  [\"call-site\" \"callsite\" \"call_site\" \"dsg__\" \"provenance\"])\n+\n+\n+(defn- exposed-name?\n+  \"True when guest-visible name `x` carries a deny-listed substring.\"\n+  [x]\n+  (some #(str/includes? (str x) %) guest-surface-deny-strings))\n+\n+\n+(def ^:private exception-track-doors\n+  \"The exception track's reserved runtime doors and its private condition\n+   constructor — a DIFFERENT key family from `:yang/call-site` (landed\n+   `8c10c5b7`). Neither the `js` nor the `jssp` prelude may reach them: the\n+   js runtime authenticates a retained condition through its own sealed\n+   companion cell (`prelude.cljc:1653-1714`), never a VM door.\"\n+  '#{cell/dsg__new-provenance\n+     cell/dsg__provenance\n+     dsg__condition-exception})\n+\n+\n+(defn- audit-definition-users\n+  \"The keys of `definitions` (`[key form]` pairs) whose form TREE references\n+   any of `names`. A closed set over trees, not a deny-list over names, so a\n+   RENAMED wrapper is caught too — which is what makes the python F2 shape\n+   strictly stronger than the ts twin it mirrored.\"\n+  [definitions names]\n+  (into #{}\n+        (keep (fn [[k form]]\n+                (when (some names (tree-seq coll? seq form))\n+                  k)))\n+        definitions))\n+\n+\n+(defn- audit-guest-c1-keys\n+  \"The keys of `definitions` whose form tree carries the compile-time C1\n+   key. Always empty: C1 is frontend metadata on the lowered tree, never a\n+   guest-readable definition, so a runtime key that answered for it would be\n+   a second, parallel mechanism.\"\n+  [definitions]\n+  (audit-definition-users definitions #{:yang/call-site}))\n+\n+\n+(def ^:private renamed-hook-wrapper-definitions\n+  \"The NEGATIVE fixture for the closed-set audit: two `js.sp` definitions\n+   whose OWN NAMES are neutral — no `dsg__`, no `provenance` — but whose\n+   bodies reach the exception track's reserved doors. This is the shape a\n+   name-based deny-list passes and a tree-based closed set catches.\"\n+  '[[js.sp/condition-slot (fn [c] (cell/dsg__new-provenance c))]\n+    [js.sp/read-slot (fn [s] (cell/dsg__provenance s))]])\n+\n+\n (deftest export-audit-pin-test\n   (testing \"no C1 or exception-track provenance surface is guest-visible\"\n-    (let [exposed? (fn [x]\n-                     (some #(str/includes? (str x) %)\n-                           [\"call-site\" \"callsite\" \"call_site\"\n-                            \"dsg__\" \"provenance\"]))]\n-      (doseq [[label exports runtime-keys]\n-              [[\"js\" prelude/module-exports prelude/runtime-keys]\n-               [\"jssp\" hooks/module-exports hooks/runtime-keys]]]\n-        (testing label\n-          (is (not-any? exposed? exports)\n-              \"no export names the occurrence contract or the runtime doors\")\n-          (is (not-any? exposed? runtime-keys)\n-              \"no runtime key the task allocates names either\")))))\n-  (testing \"no js definition reaches the exception track's reserved doors,\n-            and none carries the compile-time C1 key\"\n-    (let [private-names '#{cell/dsg__new-provenance\n-                           cell/dsg__provenance\n-                           dsg__condition-exception}\n-          door-users (into #{}\n-                           (keep (fn [[k form]]\n-                                   (when (some private-names\n-                                               (tree-seq coll? seq form))\n-                                     k)))\n-                           prelude/definitions)\n-          c1-users (into #{}\n-                         (keep (fn [[k form]]\n-                                 (when (some #{:yang/call-site}\n-                                             (tree-seq coll? seq form))\n-                                   k)))\n-                         prelude/definitions)]\n-      (is (= #{} door-users)\n-          \"a DIFFERENT key family: the js prelude authenticates a retained\n-           condition through its own sealed companion cell, never the VM's\n-           provenance doors, so nothing here re-mints or reuses them\")\n-      (is (= #{} c1-users)\n-          \"C1 is compile-time frontend metadata on the lowered tree, never\n-           a guest definition the runtime can read\")))\n+    (doseq [[label exports runtime-keys]\n+            [[\"js\" prelude/module-exports prelude/runtime-keys]\n+             [\"jssp\" hooks/module-exports hooks/runtime-keys]]]\n+      (testing label\n+        (is (not-any? exposed-name? exports)\n+            \"no export names the occurrence contract or the runtime doors\")\n+        (is (not-any? exposed-name? runtime-keys)\n+            \"no runtime key the task allocates names either\"))))\n+  (testing \"NEITHER prelude reaches the exception track's reserved doors, and\n+            neither carries the compile-time C1 key\"\n+    (doseq [[label definitions] [[\"js\" prelude/definitions]\n+                                 [\"jssp\" hooks/function-definitions]]]\n+      (testing label\n+        (is (= #{} (audit-definition-users definitions exception-track-doors))\n+            \"a DIFFERENT key family: nothing here re-mints or reuses the VM's\n+             provenance doors, so no neutrally named wrapper reaches them\")\n+        (is (= #{} (audit-guest-c1-keys definitions))\n+            \"C1 is compile-time frontend metadata on the lowered tree, never\n+             a guest definition the runtime can read\"))))\n+  (testing \"the closed-set audit is not vacuous: a RENAMED wrapper is caught\"\n+    (is (= '#{js.sp/condition-slot js.sp/read-slot}\n+           (audit-definition-users renamed-hook-wrapper-definitions\n+                                   exception-track-doors))\n+        \"both neutral-named wrappers reaching a reserved door are named, so\n+         the empty sets above are a real audit, not an unexercised predicate\")\n+    (is (= #{} (audit-guest-c1-keys renamed-hook-wrapper-definitions))\n+        \"the fixture reaches the doors and not the C1 key, so the two audits\n+         stay independent of each other\")\n+    (testing \"the name-based deny-list leg alone would have MISSED it\"\n+      (is (not-any? exposed-name?\n+                    (map first renamed-hook-wrapper-definitions))\n+          \"neither wrapper's own name carries a deny-listed substring — this\n+           is exactly why the closed-set leg scans form trees\")))\n   (testing \"the audited surface is the whole guest-visible surface, not a\n             sample of it\"\n     (is (= (set prelude/module-exports)\n@@ -738,3 +808,228 @@\n            (set (map (comp hooks/strip first) hooks/function-definitions)))\n         \"and jssp's are exactly its definition list, mirroring\n          linked-prelude-test's own pin\")))\n+\n+\n+;; =============================================================================\n+;; A reviewed literal coordinate pin, and the distinct-admission-token\n+;; negative fixture (design §5.2 :272, §3.2 :139)\n+;; =============================================================================\n+\n+(def ^:private reviewed-var-x-paths\n+  \"The REVIEWED literal coordinate paths of `(lower/lower-module-body var-x)`\n+   — `var x = 1;`, the smallest fixture in this suite. Hand-derived from the\n+   row grammar (`yin/vm.cljc:1017-1038`) and the design's path rule (`:39`: a\n+   scalar child slot step is a row position; a child in a `nodes` slot is\n+   `[slot-position member-index]`; the root is `[]`), and NOT read back from\n+   `vm/application-occurrences` — so the expected side of\n+   `coordinate-pin-test` is independent of the extraction and enumeration\n+   machinery every other test here uses, in the style of\n+   `yang.clojure-callsite-test:119`.\n+\n+   The tree is the golden at `lower_portable_test.cljc:206-217`: one\n+   cell-binding application over a `cell/new` operand, whose lambda body is\n+   two nested sequencing applications ending in `cell/set!`. Five\n+   applications, therefore five paths:\n+\n+     []                     the cell-binding application, i.e. the root\n+     [[3 0]]                its operand 0, `(cell/new :js/undefined)`\n+     [2 3]                  the binding lambda's body: the outer `then`\n+     [2 3 [3 0]]            that `then`'s operand 0: the inner `then`\n+     [2 3 [3 0] [3 0]]      the inner `then`'s operand 0: `(cell/set! …)`\n+\n+   The lambdas at `[2]`, `[2 3 2]` and `[2 3 [3 0] 2]`, and every literal,\n+   are not occurrences and must not appear.\"\n+  #{[]\n+    [[3 0]]\n+    [2 3]\n+    [2 3 [3 0]]\n+    [2 3 [3 0] [3 0]]})\n+\n+\n+(def ^:private reviewed-var-x-root\n+  \"The REVIEWED canonical root address of `(lower/lower-module-body var-x)`.\n+\n+   A root is `segment/blake3-<hex>` over the root row and cannot be derived\n+   by hand, so this slot is nil until the first green run freezes it — see\n+   findings FIX-ROUND-2 item (1). While it is nil, `coordinate-pin-test` pins\n+   the root RELATIONALLY instead: well-formed, identical with the markers\n+   stripped, and identical after a second finalization walk. All three are\n+   host-independent and need no hash. Fill this in and the pin additionally\n+   becomes a frozen absolute golden.\"\n+  nil)\n+\n+\n+(deftest coordinate-pin-test\n+  (testing \"the reviewed literal coordinate set of the smallest fixture\"\n+    (let [{:keys [tree metadata]} (project (lower/lower-module-body var-x))\n+          expected (into #{}\n+                         (map (fn [path] [origin (:root tree) path]))\n+                         reviewed-var-x-paths)]\n+      (is (= 5 (count reviewed-var-x-paths))\n+          \"five applications in `var x = 1;`'s module body\")\n+      (is (= expected (marked metadata))\n+          \"the hand-derived paths ARE the whole marker set: the expected side\n+           consults no occurrence-enumeration machinery\")\n+      (is (= expected (eligible tree))\n+          \"and they are exactly the eligible set the canonical rows imply, so\n+           the hand derivation and the occurrence relation agree\")\n+      (is (= reviewed-var-x-paths\n+             (into #{} (map #(nth % 2)) (marker-rows metadata)))\n+          \"the same five paths, origin-free\")\n+      (is (true? (yang/validate-call-site-coverage! tree metadata origin)))))\n+  (testing \"the reviewed root pin\"\n+    (let [produced (lower/lower-module-body var-x)\n+          root (:root (:tree (project produced)))]\n+      (if-let [frozen reviewed-var-x-root]\n+        (is (= frozen root)\n+            \"the frozen absolute canonical root address\")\n+        (testing \"not yet frozen: the three host-independent root pins that\n+                  stand in for it\"\n+          (is (and (keyword? root) (= \"segment\" (namespace root))\n+                   (str/starts-with? (name root) \"blake3-\"))\n+              \"the root is a well-formed canonical segment address\")\n+          (is (= root (:root (vm/ast->semantic-bytecode\n+                               (strip-call-sites produced))))\n+              \"identical with the markers stripped, so the address cannot\n+               depend on C1 — provenance stays out of hashed content\")\n+          (is (= root (:root (:tree (project (u/annotate-call-sites produced)))))\n+              \"and identical after a second finalization walk\"))))))\n+\n+\n+(deftest distinct-admission-token-test\n+  (testing \"identical text admitted twice under DISTINCT supplied tokens\n+            demands different origins (design §5.2 :272's negative fixture;\n+            §3.2 :139 — C1 requires fresh admission identity)\"\n+    (let [token-a [:hand 0]\n+          token-b [:hand 1]\n+          origin-a (vm/source-origin medium token-a 0)\n+          origin-b (vm/source-origin medium token-b 0)\n+          a (project-under (lower/lower-module-body var-x) token-a)\n+          b (project-under (lower/lower-module-body var-x) token-b)]\n+      (is (= token-a (:yang.cst/unit var-x))\n+          \"both admissions carry the SAME packet identity, which is exactly\n+           why the supplied token and not the packet must carry admission\n+           freshness — design :139: packet identity alone is insufficient\n+           if reused for distinct admissions\")\n+      (is (not= origin-a origin-b)\n+          \"the two admissions are distinct occurrence origins\")\n+      (is (= #{origin-a} (row-origins (:metadata a))))\n+      (is (= #{origin-b} (row-origins (:metadata b))))\n+      (is (not= (row-origins (:metadata a)) (row-origins (:metadata b)))\n+          \"so the two coordinate SETS differ\")\n+      (is (= (:root (:tree a)) (:root (:tree b)))\n+          \"one content address for both: an occurrence is (content address,\n+           origin), never content alone\")\n+      (is (= (marked-pairs (:metadata a)) (marked-pairs (:metadata b)))\n+          \"and one origin-free path set — cross-host equality is REPLAY\n+           equality, and must not turn occurrences into content identities\")\n+      (is (not= (marked-under (:metadata a) origin-a)\n+                (marked-under (:metadata b) origin-b))\n+          \"yet the full coordinates differ, because their origins do\")\n+      (is (true? (yang/validate-call-site-coverage!\n+                   (:tree a) (:metadata a) origin-a)))\n+      (is (true? (yang/validate-call-site-coverage!\n+                   (:tree b) (:metadata b) origin-b)))))\n+  (testing \"a RETRY keeps its token: re-admitting identical text under the\n+            SAME token reproduces the SAME origin, so a retry fabricates no\n+            fresh admission identity (design :139)\"\n+    (let [retry-token [:hand 0]\n+          retry-origin (vm/source-origin medium retry-token 0)\n+          first-admission (project-under (lower/lower-module-body var-x)\n+                                         retry-token)\n+          retry (project-under (lower/lower-module-body var-x) retry-token)]\n+      (is (= #{retry-origin} (row-origins (:metadata first-admission))))\n+      (is (= #{retry-origin} (row-origins (:metadata retry)))\n+          \"the retry keeps the token, so it keeps the origin\")\n+      (is (= (marked-under (:metadata first-admission) retry-origin)\n+             (marked-under (:metadata retry) retry-origin))\n+          \"and reproduces exactly the same coordinate set\"))))\n+\n+\n+;; =============================================================================\n+;; Obligation TS-SP-C1 — the ts derived envelope's PARTIAL correspondence,\n+;; documented. This test PASSES by pinning the limitation and naming the\n+;; obligation; it is deliberately not a red-light on the suite.\n+;; =============================================================================\n+\n+(def ^:private derived-medium\n+  \"The medium a ts host derives under: `safepoint/derive-envelope`'s third\n+   argument. No ts caller supplies `:injected-origin`.\"\n+  :yang.ts/derived)\n+\n+\n+(defn- derive\n+  \"The safepoint-derived envelope of `ast` under `profile`, admitted on this\n+   test's medium and derived onto `derived-medium` — `derive-envelope` at its\n+   3-arity, exactly as every ts caller invokes it: `safepoint/transform`\n+   (`yang/safepoint.cljc:455`), `e2e-test`'s `derive-program` (`:71-86`),\n+   `safepoint-test`'s `derive*` (`:132-136`), `linked-prelude-test`'s\n+   `derived-ast` (`:249-262`).\"\n+  [ast profile]\n+  (let [projected (encoder/project (encoder/source-envelope medium token [ast]))]\n+    (:envelope (safepoint/derive-envelope projected profile derived-medium))))\n+\n+\n+(deftest ts-sp-c1-obligation-test\n+  (testing \"TS-SP-C1 part 1 — a ts derived envelope carries PARTIAL\n+            correspondence by named obligation, not by oversight: surviving\n+            occurrences keep their own origins, injected hook applications\n+            are recorded WITHOUT one, because no ts caller supplies\n+            :injected-origin and inventing an origin is forbidden\"\n+    (let [derived (derive (lower/lower-packet while-x {:prelude :linked})\n+                          hooks/profile)\n+          rows (marker-rows (:yin/frontend-metadata derived))\n+          tree (nth (:yin/batch derived) (:yin/root derived))\n+          correspondence (:yang.safepoint/correspondence derived)\n+          entries (:entries correspondence)\n+          injected (filterv #(= :safepoint/injected (:kind %)) entries)\n+          surviving (filterv #(= :surviving (:kind %)) entries)\n+          eligible-paths (into #{} (map second)\n+                               (vm/application-occurrences tree))\n+          claimed-paths (into #{} (map #(nth % 2) rows))]\n+      (is (some? correspondence)\n+          \"the derived envelope carries an explicit correspondence record\")\n+      (is (seq surviving) \"the surviving occurrences are mapped\")\n+      (is (seq rows) \"and keep their C1 rows\")\n+      (is (seq injected)\n+          \"the injected hook applications are named in the correspondence\")\n+      (is (not-any? :origin injected)\n+          \"TS-SP-C1: each injected occurrence is recorded WITHOUT an origin —\n+           partial correspondence, deliberately, never a fabricated claim\")\n+      (is (every? #(some? (get-in % [:input 0])) surviving)\n+          \"while every surviving entry keeps its own incoming origin, inside\n+           its :input coordinate\")\n+      (is (= (into #{} (map #(nth % 0) rows))\n+             (into #{} (map #(get-in % [:input 0]) surviving)))\n+          \"and each claimed row carries exactly one surviving entry's origin\")\n+      (is (every? eligible-paths claimed-paths)\n+          \"every claimed path is a real application of the derived tree\")\n+      (is (not= claimed-paths eligible-paths)\n+          \"TS-SP-C1: but the claim is a STRICT subset — partial\n+           correspondence, NOT complete derived-tree adoption\")))\n+  (testing \"TS-SP-C1 part 2 — re-projecting that derived envelope DROPS its\n+            C1 rows silently, so derived-envelope re-projection stays OUTSIDE\n+            the accepted C1 routes until the shared encoder gap is resolved.\n+            Pinned so the behaviour is documented, and so a fix in the shared\n+            encoder flips this test rather than passing quietly.\"\n+    (let [derived (derive (lower/lower-packet while-x {:prelude :linked})\n+                          hooks/profile)\n+          reprojected (encoder/project derived)]\n+      (is (seq (marker-rows (:yin/frontend-metadata derived)))\n+          \"the derived envelope carries C1 rows on entry\")\n+      (is (= [] (:yin/frontend-metadata reprojected))\n+          \"TS-SP-C1: they are GONE after re-projection, with no refusal and\n+           no diagnosis. The already-projected member arm at\n+           encoder.cljc:115-125 reads :frontend-metadata off the MEMBER,\n+           where derive-envelope never puts it — the rows ride the ENVELOPE —\n+           so check-projected-claim! sees no claim to check; encoder.cljc\n+           :156-160 then overwrites the envelope-level relation with the\n+           empty concatenation over members. That gap is in the SHARED\n+           encoder and is owned cross-track, out of scope for this round\")\n+      (is (= (:yin/batch derived) (:yin/batch reprojected))\n+          \"the canonical rows are untouched: the drop is provenance-only\")\n+      (is (= (:yang.safepoint/correspondence derived)\n+             (:yang.safepoint/correspondence reprojected))\n+          \"and the correspondence record survives, because project-envelope\n+           assocs onto the incoming envelope — so the evidence of what was\n+           dropped is still retrievable\"))))\n   100\t(def ^:private medium\n   101\t  \"This test's program medium: the origin's first opaque coordinate, which\n   102\t   the admitting composition supplies and the frontend never mints.\"\n   103\t  :yang.ts/callsite-test)\n   104\t\n   105\t\n   106\t(def ^:private token \"ts-callsite-1\")\n   107\t\n   108\t\n   109\t(def ^:private origin [:source medium token 0])\n   110\t\n   111\t\n   112\t(defn- project\n   113\t  \"The canonical rows and the generic frontend-metadata side table of `ast`\n   114\t   under this test's admission origin, through the production encoder.\"\n   115\t  [ast]\n   116\t  (let [projected (encoder/project (encoder/source-envelope medium token [ast]))]\n   117\t    {:tree (first (:yin/batch projected))\n   118\t     :metadata (:yin/frontend-metadata projected)}))\n   119\t\n   120\t\n   121\t(defn- project-under\n   122\t  \"`project` under an explicit batch token: the same medium and the same\n   123\t   member index, a DIFFERENT admission. `distinct-admission-token-test` uses\n   124\t   it to model two admissions of one packet, which is the only way to\n   125\t   exercise design `:139`'s fresh-admission-identity requirement from\n   126\t   inside a frontend suite.\"\n   127\t  [ast batch-token]\n   128\t  (let [projected (encoder/project\n   129\t                    (encoder/source-envelope medium batch-token [ast]))]\n   130\t    {:tree (first (:yin/batch projected))\n   131\t     :metadata (:yin/frontend-metadata projected)}))\n   132\t\n   133\t\n   134\t(defn- eligible-under\n   135\t  \"The eligible C1 site set of canonical `tree` under `origin`, derived\n   136\t   here directly from the occurrence relation and the row tags —\n   137\t   independently of the producer's own walk.\"\n   138\t  [tree origin]\n   139\t  (into #{}\n   140\t        (map (fn [[root path]] [origin root path]))\n   141\t        (vm/application-occurrences tree)))\n   142\t\n   143\t\n   144\t(defn- eligible\n   145\t  [tree]\n   146\t  (eligible-under tree origin))\n   147\t\n   148\t\n   149\t(defn- occurrence-pairs\n   150\t  \"The `[root-address path]` of every `:application` occurrence of\n   151\t   canonical `tree`: the projection a consumer derives from canonical rows\n   152\t   alone, origin-free.\"\n   153\t  [tree]\n   154\t  (into #{} (map (fn [[root path]] [root path])) (vm/application-occurrences tree)))\n   155\t\n   156\t\n   157\t(defn- marked-under\n   158\t  \"The `[origin root-address path]` of the C1 rows of `metadata` claimed\n   159\t   under `origin` — the ORIGIN-SCOPED marker set. Filtering on the row's\n   160\t   own origin coordinate is what makes the query meaningful: a relation\n   161\t   admitted under a DIFFERENT origin answers empty here, which is how\n   162\t   `stage-envelope-test` proves the frontend stamps no origin of its own.\n   163\t   (The origin-free projection a consumer derives from canonical rows alone\n   164\t   is `marked-pairs`, below.)\"\n   165\t  [metadata origin]\n   166\t  (into #{}\n   167\t        (comp (filter #(and (= :yang/call-site (nth % 3))\n   168\t                            (= origin (nth % 0))))\n   169\t              (map (fn [[o r path _ _]] [o r path])))\n   170\t        metadata))\n   171\t\n   172\t\n   173\t(defn- marked\n   174\t  [metadata]\n   175\t  (marked-under metadata origin))\n   176\t\n   177\t\n   178\t(defn- marked-pairs\n   179\t  \"The `[root-address path]` projection of a C1 marker relation.\"\n   180\t  [metadata]\n   181\t  (into #{}\n   182\t        (comp (filter #(= :yang/call-site (nth % 3)))\n   183\t              (map (fn [[_ r path _ _]] [r path])))\n   184\t        metadata))\n   185\t\n   186\t\n   187\t(defn- marker-rows\n   188\t  [metadata]\n   189\t  (filterv #(= :yang/call-site (nth % 3)) metadata))\n   190\t\n   191\t\n   192\t(defn- row-origins\n   193\t  \"The distinct occurrence origins a C1 marker relation carries.\"\n   194\t  [metadata]\n   195\t  (into #{} (map first) (marker-rows metadata)))\n   196\t\n   197\t\n   198\t(defn- failure-rule\n   199\t  [f]\n   200\t  (try (f) ::no-failure\n   201\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   202\t         (:rule (ex-data e)))))\n   680\t          unit (project (lower/lower-unit var-x))]\n   681\t      (is (= :application (:type (lower/lower-module-body var-x))))\n   682\t      (is (contains? (marked-pairs (:metadata body)) [(:root (:tree body)) []])\n   683\t          \"lower-module-body's root is the cell-binding application, so the\n   684\t           empty path is one of its coordinates\")\n   685\t      (is (= :lambda (:type (lower/lower-unit var-x))))\n   686\t      (is (not (contains? (marked-pairs (:metadata unit))\n   687\t                          [(:root (:tree unit)) []]))\n   688\t          \"lower-unit's root is a lambda, which is not an occurrence: the\n   689\t           coordinate set follows the row tags, never the tree's size\")))\n   690\t  (testing \"every composed production tree claims its own root\"\n   691\t    (doseq [[label ast] [[\"lower-packet, linked\"\n   692\t                          (lower/lower-packet var-x {:prelude :linked})]\n   693\t                         [\"lower-packet, bundled\" (lower/lower-packet var-x)]\n   694\t                         [\"lower-units, linked\"\n   695\t                          (lower/lower-units [var-x] {:prelude :linked})]\n   696\t                         [\"js module-uast\" prelude/module-uast]\n   697\t                         [\"jssp module-uast\" hooks/module-uast]]]\n   698\t      (testing label\n   699\t        (let [{:keys [tree metadata]} (project ast)]\n   700\t          (is (= :application (:type ast)))\n   701\t          (is (contains? (marked-pairs metadata) [(:root tree) []])\n   702\t              \"the composed root is itself an application, and is claimed\"))))))\n   703\t\n   704\t\n   705\t;; =============================================================================\n   706\t;; The export audit (the python F2 pin's shape, itself the ts twin's mirror)\n   707\t;; =============================================================================\n   708\t\n   709\t(def ^:private guest-surface-deny-strings\n   710\t  \"Substrings no guest-visible name may carry: the occurrence contract's own\n   711\t   key, and the exception track's reserved-door family.\"\n   712\t  [\"call-site\" \"callsite\" \"call_site\" \"dsg__\" \"provenance\"])\n   713\t\n   714\t\n   715\t(defn- exposed-name?\n   716\t  \"True when guest-visible name `x` carries a deny-listed substring.\"\n   717\t  [x]\n   718\t  (some #(str/includes? (str x) %) guest-surface-deny-strings))\n   719\t\n   720\t\n   721\t(def ^:private exception-track-doors\n   722\t  \"The exception track's reserved runtime doors and its private condition\n   723\t   constructor — a DIFFERENT key family from `:yang/call-site` (landed\n   724\t   `8c10c5b7`). Neither the `js` nor the `jssp` prelude may reach them: the\n   725\t   js runtime authenticates a retained condition through its own sealed\n   726\t   companion cell (`prelude.cljc:1653-1714`), never a VM door.\"\n   727\t  '#{cell/dsg__new-provenance\n   728\t     cell/dsg__provenance\n   729\t     dsg__condition-exception})\n   730\t\n   731\t\n   732\t(defn- audit-definition-users\n   733\t  \"The keys of `definitions` (`[key form]` pairs) whose form TREE references\n   734\t   any of `names`. A closed set over trees, not a deny-list over names, so a\n   735\t   RENAMED wrapper is caught too — which is what makes the python F2 shape\n   736\t   strictly stronger than the ts twin it mirrored.\"\n   737\t  [definitions names]\n   738\t  (into #{}\n   739\t        (keep (fn [[k form]]\n   740\t                (when (some names (tree-seq coll? seq form))\n   741\t                  k)))\n   742\t        definitions))\n   743\t\n   744\t\n   745\t(defn- audit-guest-c1-keys\n   746\t  \"The keys of `definitions` whose form tree carries the compile-time C1\n   747\t   key. Always empty: C1 is frontend metadata on the lowered tree, never a\n   748\t   guest-readable definition, so a runtime key that answered for it would be\n   749\t   a second, parallel mechanism.\"\n   750\t  [definitions]\n   751\t  (audit-definition-users definitions #{:yang/call-site}))\n   752\t\n   753\t\n   754\t(def ^:private renamed-hook-wrapper-definitions\n   755\t  \"The NEGATIVE fixture for the closed-set audit: two `js.sp` definitions\n   756\t   whose OWN NAMES are neutral — no `dsg__`, no `provenance` — but whose\n   757\t   bodies reach the exception track's reserved doors. This is the shape a\n   758\t   name-based deny-list passes and a tree-based closed set catches.\"\n   759\t  '[[js.sp/condition-slot (fn [c] (cell/dsg__new-provenance c))]\n   760\t    [js.sp/read-slot (fn [s] (cell/dsg__provenance s))]])\n   761\t\n   762\t\n   763\t(deftest export-audit-pin-test\n   764\t  (testing \"no C1 or exception-track provenance surface is guest-visible\"\n   765\t    (doseq [[label exports runtime-keys]\n   766\t            [[\"js\" prelude/module-exports prelude/runtime-keys]\n   767\t             [\"jssp\" hooks/module-exports hooks/runtime-keys]]]\n   768\t      (testing label\n   769\t        (is (not-any? exposed-name? exports)\n   770\t            \"no export names the occurrence contract or the runtime doors\")\n   771\t        (is (not-any? exposed-name? runtime-keys)\n   772\t            \"no runtime key the task allocates names either\"))))\n   773\t  (testing \"NEITHER prelude reaches the exception track's reserved doors, and\n   774\t            neither carries the compile-time C1 key\"\n   775\t    (doseq [[label definitions] [[\"js\" prelude/definitions]\n   776\t                                 [\"jssp\" hooks/function-definitions]]]\n   777\t      (testing label\n   778\t        (is (= #{} (audit-definition-users definitions exception-track-doors))\n   779\t            \"a DIFFERENT key family: nothing here re-mints or reuses the VM's\n   780\t             provenance doors, so no neutrally named wrapper reaches them\")\n   781\t        (is (= #{} (audit-guest-c1-keys definitions))\n   782\t            \"C1 is compile-time frontend metadata on the lowered tree, never\n   783\t             a guest definition the runtime can read\"))))\n   784\t  (testing \"the closed-set audit is not vacuous: a RENAMED wrapper is caught\"\n   785\t    (is (= '#{js.sp/condition-slot js.sp/read-slot}\n   786\t           (audit-definition-users renamed-hook-wrapper-definitions\n   787\t                                   exception-track-doors))\n   788\t        \"both neutral-named wrappers reaching a reserved door are named, so\n   789\t         the empty sets above are a real audit, not an unexercised predicate\")\n   790\t    (is (= #{} (audit-guest-c1-keys renamed-hook-wrapper-definitions))\n   791\t        \"the fixture reaches the doors and not the C1 key, so the two audits\n   792\t         stay independent of each other\")\n   793\t    (testing \"the name-based deny-list leg alone would have MISSED it\"\n   794\t      (is (not-any? exposed-name?\n   795\t                    (map first renamed-hook-wrapper-definitions))\n   796\t          \"neither wrapper's own name carries a deny-listed substring — this\n   797\t           is exactly why the closed-set leg scans form trees\")))\n   798\t  (testing \"the audited surface is the whole guest-visible surface, not a\n   799\t            sample of it\"\n   800\t    (is (= (set prelude/module-exports)\n   801\t           (into #{}\n   802\t                 (keep (fn [[k _]]\n   803\t                         (when (= \"js\" (namespace k)) (prelude/strip k))))\n   804\t                 prelude/definitions))\n   805\t        \"the js exports are exactly its js-namespaced definitions; the\n   806\t         internal js.rt/* store keys are not exported\")\n   807\t    (is (= (set hooks/module-exports)\n   808\t           (set (map (comp hooks/strip first) hooks/function-definitions)))\n   809\t        \"and jssp's are exactly its definition list, mirroring\n   810\t         linked-prelude-test's own pin\")))\n   811\t\n   812\t\n   813\t;; =============================================================================\n   814\t;; A reviewed literal coordinate pin, and the distinct-admission-token\n   815\t;; negative fixture (design §5.2 :272, §3.2 :139)\n   816\t;; =============================================================================\n   817\t\n   818\t(def ^:private reviewed-var-x-paths\n   819\t  \"The REVIEWED literal coordinate paths of `(lower/lower-module-body var-x)`\n   820\t   — `var x = 1;`, the smallest fixture in this suite. Hand-derived from the\n   821\t   row grammar (`yin/vm.cljc:1017-1038`) and the design's path rule (`:39`: a\n   822\t   scalar child slot step is a row position; a child in a `nodes` slot is\n   823\t   `[slot-position member-index]`; the root is `[]`), and NOT read back from\n   824\t   `vm/application-occurrences` — so the expected side of\n   825\t   `coordinate-pin-test` is independent of the extraction and enumeration\n   826\t   machinery every other test here uses, in the style of\n   827\t   `yang.clojure-callsite-test:119`.\n   828\t\n   829\t   The tree is the golden at `lower_portable_test.cljc:206-217`: one\n   830\t   cell-binding application over a `cell/new` operand, whose lambda body is\n   831\t   two nested sequencing applications ending in `cell/set!`. Five\n   832\t   applications, therefore five paths:\n   833\t\n   834\t     []                     the cell-binding application, i.e. the root\n   835\t     [[3 0]]                its operand 0, `(cell/new :js/undefined)`\n   836\t     [2 3]                  the binding lambda's body: the outer `then`\n   837\t     [2 3 [3 0]]            that `then`'s operand 0: the inner `then`\n   838\t     [2 3 [3 0] [3 0]]      the inner `then`'s operand 0: `(cell/set! …)`\n   839\t\n   840\t   The lambdas at `[2]`, `[2 3 2]` and `[2 3 [3 0] 2]`, and every literal,\n   841\t   are not occurrences and must not appear.\"\n   842\t  #{[]\n   843\t    [[3 0]]\n   844\t    [2 3]\n   845\t    [2 3 [3 0]]\n   846\t    [2 3 [3 0] [3 0]]})\n   847\t\n   848\t\n   849\t(def ^:private reviewed-var-x-root\n   850\t  \"The REVIEWED canonical root address of `(lower/lower-module-body var-x)`.\n   851\t\n   852\t   A root is `segment/blake3-<hex>` over the root row and cannot be derived\n   853\t   by hand, so this slot is nil until the first green run freezes it — see\n   854\t   findings FIX-ROUND-2 item (1). While it is nil, `coordinate-pin-test` pins\n   855\t   the root RELATIONALLY instead: well-formed, identical with the markers\n   856\t   stripped, and identical after a second finalization walk. All three are\n   857\t   host-independent and need no hash. Fill this in and the pin additionally\n   858\t   becomes a frozen absolute golden.\"\n   859\t  nil)\n   860\t\n   861\t\n   862\t(deftest coordinate-pin-test\n   863\t  (testing \"the reviewed literal coordinate set of the smallest fixture\"\n   864\t    (let [{:keys [tree metadata]} (project (lower/lower-module-body var-x))\n   865\t          expected (into #{}\n   866\t                         (map (fn [path] [origin (:root tree) path]))\n   867\t                         reviewed-var-x-paths)]\n   868\t      (is (= 5 (count reviewed-var-x-paths))\n   869\t          \"five applications in `var x = 1;`'s module body\")\n   870\t      (is (= expected (marked metadata))\n   871\t          \"the hand-derived paths ARE the whole marker set: the expected side\n   872\t           consults no occurrence-enumeration machinery\")\n   873\t      (is (= expected (eligible tree))\n   874\t          \"and they are exactly the eligible set the canonical rows imply, so\n   875\t           the hand derivation and the occurrence relation agree\")\n   876\t      (is (= reviewed-var-x-paths\n   877\t             (into #{} (map #(nth % 2)) (marker-rows metadata)))\n   878\t          \"the same five paths, origin-free\")\n   879\t      (is (true? (yang/validate-call-site-coverage! tree metadata origin)))))\n   880\t  (testing \"the reviewed root pin\"\n   881\t    (let [produced (lower/lower-module-body var-x)\n   882\t          root (:root (:tree (project produced)))]\n   883\t      (if-let [frozen reviewed-var-x-root]\n   884\t        (is (= frozen root)\n   885\t            \"the frozen absolute canonical root address\")\n   886\t        (testing \"not yet frozen: the three host-independent root pins that\n   887\t                  stand in for it\"\n   888\t          (is (and (keyword? root) (= \"segment\" (namespace root))\n   889\t                   (str/starts-with? (name root) \"blake3-\"))\n   890\t              \"the root is a well-formed canonical segment address\")\n   891\t          (is (= root (:root (vm/ast->semantic-bytecode\n   892\t                               (strip-call-sites produced))))\n   893\t              \"identical with the markers stripped, so the address cannot\n   894\t               depend on C1 — provenance stays out of hashed content\")\n   895\t          (is (= root (:root (:tree (project (u/annotate-call-sites produced)))))\n   896\t              \"and identical after a second finalization walk\"))))))\n   897\t\n   898\t\n   899\t(deftest distinct-admission-token-test\n   900\t  (testing \"identical text admitted twice under DISTINCT supplied tokens\n   901\t            demands different origins (design §5.2 :272's negative fixture;\n   902\t            §3.2 :139 — C1 requires fresh admission identity)\"\n   903\t    (let [token-a [:hand 0]\n   904\t          token-b [:hand 1]\n   905\t          origin-a (vm/source-origin medium token-a 0)\n   906\t          origin-b (vm/source-origin medium token-b 0)\n   907\t          a (project-under (lower/lower-module-body var-x) token-a)\n   908\t          b (project-under (lower/lower-module-body var-x) token-b)]\n   909\t      (is (= token-a (:yang.cst/unit var-x))\n   910\t          \"both admissions carry the SAME packet identity, which is exactly\n   911\t           why the supplied token and not the packet must carry admission\n   912\t           freshness — design :139: packet identity alone is insufficient\n   913\t           if reused for distinct admissions\")\n   914\t      (is (not= origin-a origin-b)\n   915\t          \"the two admissions are distinct occurrence origins\")\n   916\t      (is (= #{origin-a} (row-origins (:metadata a))))\n   917\t      (is (= #{origin-b} (row-origins (:metadata b))))\n   918\t      (is (not= (row-origins (:metadata a)) (row-origins (:metadata b)))\n   919\t          \"so the two coordinate SETS differ\")\n   920\t      (is (= (:root (:tree a)) (:root (:tree b)))\n   921\t          \"one content address for both: an occurrence is (content address,\n   922\t           origin), never content alone\")\n   923\t      (is (= (marked-pairs (:metadata a)) (marked-pairs (:metadata b)))\n   924\t          \"and one origin-free path set — cross-host equality is REPLAY\n   925\t           equality, and must not turn occurrences into content identities\")\n   926\t      (is (not= (marked-under (:metadata a) origin-a)\n   927\t                (marked-under (:metadata b) origin-b))\n   928\t          \"yet the full coordinates differ, because their origins do\")\n   929\t      (is (true? (yang/validate-call-site-coverage!\n   930\t                   (:tree a) (:metadata a) origin-a)))\n   931\t      (is (true? (yang/validate-call-site-coverage!\n   932\t                   (:tree b) (:metadata b) origin-b)))))\n   933\t  (testing \"a RETRY keeps its token: re-admitting identical text under the\n   934\t            SAME token reproduces the SAME origin, so a retry fabricates no\n   935\t            fresh admission identity (design :139)\"\n   936\t    (let [retry-token [:hand 0]\n   937\t          retry-origin (vm/source-origin medium retry-token 0)\n   938\t          first-admission (project-under (lower/lower-module-body var-x)\n   939\t                                         retry-token)\n   940\t          retry (project-under (lower/lower-module-body var-x) retry-token)]\n   941\t      (is (= #{retry-origin} (row-origins (:metadata first-admission))))\n   942\t      (is (= #{retry-origin} (row-origins (:metadata retry)))\n   943\t          \"the retry keeps the token, so it keeps the origin\")\n   944\t      (is (= (marked-under (:metadata first-admission) retry-origin)\n   945\t             (marked-under (:metadata retry) retry-origin))\n   946\t          \"and reproduces exactly the same coordinate set\"))))\n   947\t\n   948\t\n   949\t;; =============================================================================\n   950\t;; Obligation TS-SP-C1 — the ts derived envelope's PARTIAL correspondence,\n   951\t;; documented. This test PASSES by pinning the limitation and naming the\n   952\t;; obligation; it is deliberately not a red-light on the suite.\n   953\t;; =============================================================================\n   954\t\n   955\t(def ^:private derived-medium\n   956\t  \"The medium a ts host derives under: `safepoint/derive-envelope`'s third\n   957\t   argument. No ts caller supplies `:injected-origin`.\"\n   958\t  :yang.ts/derived)\n   959\t\n   960\t\n   961\t(defn- derive\n   962\t  \"The safepoint-derived envelope of `ast` under `profile`, admitted on this\n   963\t   test's medium and derived onto `derived-medium` — `derive-envelope` at its\n   964\t   3-arity, exactly as every ts caller invokes it: `safepoint/transform`\n   965\t   (`yang/safepoint.cljc:455`), `e2e-test`'s `derive-program` (`:71-86`),\n   966\t   `safepoint-test`'s `derive*` (`:132-136`), `linked-prelude-test`'s\n   967\t   `derived-ast` (`:249-262`).\"\n   968\t  [ast profile]\n   969\t  (let [projected (encoder/project (encoder/source-envelope medium token [ast]))]\n   970\t    (:envelope (safepoint/derive-envelope projected profile derived-medium))))\n   971\t\n   972\t\n   973\t(deftest ts-sp-c1-obligation-test\n   974\t  (testing \"TS-SP-C1 part 1 — a ts derived envelope carries PARTIAL\n   975\t            correspondence by named obligation, not by oversight: surviving\n   976\t            occurrences keep their own origins, injected hook applications\n   977\t            are recorded WITHOUT one, because no ts caller supplies\n   978\t            :injected-origin and inventing an origin is forbidden\"\n   979\t    (let [derived (derive (lower/lower-packet while-x {:prelude :linked})\n   980\t                          hooks/profile)\n   981\t          rows (marker-rows (:yin/frontend-metadata derived))\n   982\t          tree (nth (:yin/batch derived) (:yin/root derived))\n   983\t          correspondence (:yang.safepoint/correspondence derived)\n   984\t          entries (:entries correspondence)\n   985\t          injected (filterv #(= :safepoint/injected (:kind %)) entries)\n   986\t          surviving (filterv #(= :surviving (:kind %)) entries)\n   987\t          eligible-paths (into #{} (map second)\n   988\t                               (vm/application-occurrences tree))\n   989\t          claimed-paths (into #{} (map #(nth % 2) rows))]\n   990\t      (is (some? correspondence)\n   991\t          \"the derived envelope carries an explicit correspondence record\")\n   992\t      (is (seq surviving) \"the surviving occurrences are mapped\")\n   993\t      (is (seq rows) \"and keep their C1 rows\")\n   994\t      (is (seq injected)\n   995\t          \"the injected hook applications are named in the correspondence\")\n   996\t      (is (not-any? :origin injected)\n   997\t          \"TS-SP-C1: each injected occurrence is recorded WITHOUT an origin —\n   998\t           partial correspondence, deliberately, never a fabricated claim\")\n   999\t      (is (every? #(some? (get-in % [:input 0])) surviving)\n  1000\t          \"while every surviving entry keeps its own incoming origin, inside\n  1001\t           its :input coordinate\")\n  1002\t      (is (= (into #{} (map #(nth % 0) rows))\n  1003\t             (into #{} (map #(get-in % [:input 0]) surviving)))\n  1004\t          \"and each claimed row carries exactly one surviving entry's origin\")\n  1005\t      (is (every? eligible-paths claimed-paths)\n  1006\t          \"every claimed path is a real application of the derived tree\")\n  1007\t      (is (not= claimed-paths eligible-paths)\n  1008\t          \"TS-SP-C1: but the claim is a STRICT subset — partial\n  1009\t           correspondence, NOT complete derived-tree adoption\")))\n  1010\t  (testing \"TS-SP-C1 part 2 — re-projecting that derived envelope DROPS its\n  1011\t            C1 rows silently, so derived-envelope re-projection stays OUTSIDE\n  1012\t            the accepted C1 routes until the shared encoder gap is resolved.\n  1013\t            Pinned so the behaviour is documented, and so a fix in the shared\n  1014\t            encoder flips this test rather than passing quietly.\"\n  1015\t    (let [derived (derive (lower/lower-packet while-x {:prelude :linked})\n  1016\t                          hooks/profile)\n  1017\t          reprojected (encoder/project derived)]\n  1018\t      (is (seq (marker-rows (:yin/frontend-metadata derived)))\n  1019\t          \"the derived envelope carries C1 rows on entry\")\n  1020\t      (is (= [] (:yin/frontend-metadata reprojected))\n  1021\t          \"TS-SP-C1: they are GONE after re-projection, with no refusal and\n  1022\t           no diagnosis. The already-projected member arm at\n  1023\t           encoder.cljc:115-125 reads :frontend-metadata off the MEMBER,\n  1024\t           where derive-envelope never puts it — the rows ride the ENVELOPE —\n  1025\t           so check-projected-claim! sees no claim to check; encoder.cljc\n  1026\t           :156-160 then overwrites the envelope-level relation with the\n  1027\t           empty concatenation over members. That gap is in the SHARED\n  1028\t           encoder and is owned cross-track, out of scope for this round\")\n  1029\t      (is (= (:yin/batch derived) (:yin/batch reprojected))\n  1030\t          \"the canonical rows are untouched: the drop is provenance-only\")\n  1031\t      (is (= (:yang.safepoint/correspondence derived)\n  1032\t             (:yang.safepoint/correspondence reprojected))\n  1033\t          \"and the correspondence record survives, because project-envelope\n  1034\t           assocs onto the incoming envelope — so the evidence of what was\n  1035\t           dropped is still retrievable\"))))\n","exit_code":0,"status":"completed"}}
