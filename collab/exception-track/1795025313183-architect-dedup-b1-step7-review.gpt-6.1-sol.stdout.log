{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"git worktree list --porcelain | rg -B2 -A2 'dedup|dry'\nrg --files collab/exception-track | rg '(batch1|round2).*?(patch|findings)'\nsed -n '60,140p' src/cljc/yang/core/uast.cljc\nsed -n '1,100p' src/cljc/yang/core/module.cljc\"","aggregated_output":"collab/exception-track/1795022027297-architect-dedup-round2-malleability-conformance.gemini-4-argon-high.findings.md\ncollab/exception-track/1795020669393-architect-yang-dedup-round2-audit.gemini-4-argon-high.findings.md\ncollab/exception-track/1795022967614-astra-dedup-round2-dual-role-review.gpt-6-astra.findings.md\n  \"The parameter a sequencing lambda binds and ignores. `%` cannot begin a\n   Python identifier, so it never shadows a guest name.\"\n  '%_)\n\n\n(defn then\n  \"Evaluate `a` for effect, then `b`.\"\n  [a b]\n  (app (lam [discard] b) a))\n\n\n(defn seq-nodes\n  \"Evaluate every node in order; the value is the last one's.\"\n  [nodes]\n  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n\n\n(defn let1\n  [sym value body]\n  (app (lam [sym] body) value))\n\n\n(defn sexp->uast\n  [form]\n  (cond\n    (symbol? form) (v form)\n    (seq? form)\n    (let [[head & args] form]\n      (case head\n        fn (lam (first args) (sexp->uast (second args)))\n        if (if-node (sexp->uast (first args))\n                    (sexp->uast (second args))\n                    (sexp->uast (nth args 2)))\n        do (seq-nodes (map sexp->uast args))\n        let (let [[bindings body] args]\n              (reduce (fn [inner [sym value]]\n                        (let1 sym (sexp->uast value) inner))\n                      (sexp->uast body)\n                      (reverse (partition 2 bindings))))\n        quote (lit (first args))\n        %capture capture\n        (apply app (sexp->uast head) (map sexp->uast args))))\n    :else (lit form)))\n\n\n(def mark-tails\n  \"`yang.tails/mark-tails`: the lowering marks its tree with the same\n   function a rewriting stage recomputes the marks with.\"\n  tails/mark-tails)\n\n\n;; =============================================================================\n;; Call-site occurrence contract C1 (Addendum A, design §2)\n;; =============================================================================\n;;\n;; Every final `:application` occurrence of a produced tree carries the\n;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n;; from canonical rows and emits it into the frontend-metadata side table\n;; as `[origin root-address path :yang/call-site 1]`, where the first\n;; three coordinates are the site id. The key carries no callee identity,\n;; source arity, or ambient classification. It is distinct from\n;; `:yang/site`, the safepoint mark, which travels as node metadata.\n;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n;; continuation nodes) are not `:application` nodes and are never marked.\n;; The walk lives here, beside the other shared tree transforms, so every\n;; frontend's module trees finalize the same way; `yang.clojure` owns the\n;; contract's validation over canonical rows.\n\n(defn annotate-call-sites\n  \"The finished map AST `node` with `:yang/call-site 1` on every\n   `:application` node, at every depth the row grammar knows. Literal\n   payloads are data, never syntax, and are not walked. Marking is\n   idempotent and preserves node metadata and every other key, so\n   canonical rows, roots, and executable outcomes are unchanged.\"\n  [node]\n  (let [tag (:type node)\n        slots (get vm/semantic-bytecode-grammar tag)]\n    (when-not slots\n      (throw (ex-info \"Unknown AST node type\" {:type tag, :node node})))\n    (let [walked (reduce (fn [n [field kind]]\n(ns yang.core.module\n  \"Module emitter machinery shared by every language frontend\n   (docs/design/yang.typescript.md §17, lift L3): the linker module naming\n   rule, the `require` and wide-application tree nodes, free-name\n   declaration over a host registry, and the `module-spec` and SCC bundle\n   shapes `yin.vm.linker.publish/publish-module!` takes. A language supplies\n   its prefix, its runtime module and its module AST; nothing here knows a\n   source language.\"\n  (:require\n    [clojure.string :as str]\n    [yang.core.prelude :as prelude]\n    [yang.core.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.module :as module]))\n\n\n(defn module-symbol\n  \"The linker module name of source module `name` under language `prefix`\n   (\\\"py\\\", \\\"php\\\", \\\"js\\\"): `<prefix>m.` then the name with each dot a `$`,\n   so no linker module name is a dotted prefix of another.\"\n  [prefix name]\n  (symbol (str prefix \"m.\" (str/replace name \".\" \"$\"))))\n\n\n(defn require-node\n  \"(require 'm) as a tree node.\"\n  [m]\n  (u/sexp->uast (list 'require (list 'quote m))))\n\n\n(defn module-tree\n  \"A wide application: all definitions remain at module level.\"\n  [operands]\n  (prelude/wide-app operands))\n\n\n(defn declare-free-name\n  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n   when `covered` (the requirement-pinned module names) covers it. A name\n   no `vm/primitives` profile or host export supplies throws, with\n   `refusal` under `refusal-key` in its data.\"\n  [refusal-key refusal registry covered n]\n  (if (and (symbol? n) (some? (namespace n))\n           (contains? covered (symbol (namespace n))))\n    nil\n    (if-let [profile (vm/profile-of vm/primitives n)]\n      [n profile]\n      (if-let [address (module/host-export-profile registry n)]\n        (let [entry (module/module-entry (:modules registry)\n                                         (symbol (namespace n)))\n              f (get-in entry [:slice (symbol (name n))])]\n          [n {:yin.k/profile address,\n              :yin.k/effects\n              (get (:callable-effects registry) f #{})}])\n        (throw (ex-info \"the module reads an undeclared name\"\n                        {refusal-key refusal, :name n}))))))\n\n\n(defn free-primitives\n  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n  [refusal-key refusal registry covered ast]\n  (let [free (remove (conj (prelude/defined-keys ast) 'yin/def)\n                     (prelude/free-names ast))]\n    (into {}\n          (keep (partial declare-free-name refusal-key refusal registry covered))\n          (sort-by str free))))\n\n\n(defn module-spec\n  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n   ({module-symbol address}). A free name under a required module is covered\n   by it; any other is declared as `declare-free-name` does.\"\n  [refusal-key refusal registry\n   {:keys [name ast exports runtime-name runtime-address deps]}]\n  (let [requires (into {runtime-name runtime-address} deps)]\n    {:name name,\n     :ast ast,\n     :exports exports,\n     :requires requires,\n     :primitives (free-primitives refusal-key refusal registry\n                                  (set (keys requires)) ast)}))\n\n\n(defn alias-spec\n  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n   `body-key` exports.\"\n  [name exports require-profile bundle-name spec-key body-key]\n  {:name name,\n   :exports exports,\n   :primitives {'require require-profile},\n   :ast (module-tree\n          [(require-node bundle-name)\n           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n\n\n(defn scc-module-specs\n  \"The SCC publication shape: the `bundle` spec first, then the member alias\n","exit_code":0,"status":"completed"}}
