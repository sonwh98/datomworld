alArgumentException _ ::no-match)))\n   776\t\n   777\t\n   778\t(defn- c-dispatch\n   779\t  \"The synthetic dispatch compiled through yang.clojure and run on the VM:\n   780\t   the outcomes of calling it on each of `inputs`, in order.\"\n   781\t  [row inputs]\n   782\t  (let [dispatch (list 'defn 'dispatch '[e] (list* 'case 'e (dispatch-clauses row)))]\n   783\t    (mapv (fn [input] (run-outcome [dispatch] (list 'dispatch (list 'quote input)))) inputs)))\n   784\t\n   785\t\n   786\t(deftest test-case-arm-table\n   787\t  (testing \"the checked-in table is the walk of the corpus's case sites\"\n   788\t    (is (= 6 (count case-arm-table)))\n   789\t    (is (= (case-arm-rows) case-arm-table)\n   790\t        \"regenerate with: clj -X:test:dev latte-oracle-tables/-main\")\n   791\t    (is (= #{['latte_kernel.norm 'beta-red] ['latte_kernel.norm 'beta-delta-normalize]\n   792\t             ['latte_kernel.proof 'elab-proof] ['latte_kernel.proof 'elab-proof-step]\n   793\t             ['latte_kernel.typing 'type-of-term] ['latte_kernel.syntax 'mk-fresh]}\n   794\t           (set (map (juxt :ns :fn) case-arm-table)))))\n   795\t  (testing \"every arm of every site has constants, and arms never share one\"\n   796\t    (doseq [{:keys [arms] :as row} case-arm-table\n   797\t            :let [constants (mapcat :constants arms)]]\n   798\t      (is (every? (comp seq :constants) arms) (pr-str (:fn row)))\n   799\t      (is (apply distinct? constants) (pr-str (:fn row))))))\n   800\t\n   801\t\n   802\t(deftest test-case-arm-fixtures\n   803\t  (doseq [{:keys [arms default?] :as row} case-arm-table\n   804\t          :let [label (str (:ns row) \"/\" (:fn row) \" line \" (:line row))]]\n   805\t    (testing label\n   806\t      (testing \"every constant of every arm dispatches to its own arm, A = C\"\n   807\t        (let [inputs (mapcat :constants arms)\n   808\t              expected (mapcat (fn [{:keys [arm constants]}] (repeat (count constants) arm)) arms)]\n   809\t          (is (= expected (map #(a-dispatch row %) inputs)) \"host case\")\n   810\t          (is (= (map (fn [e] [:yin.k/ok e]) expected) (c-dispatch row inputs)) \"VM\")))\n   811\t      (testing \"an input no clause names takes the default, or fails without one\"\n   812\t        (let [[c] (c-dispatch row [unmatched])]\n   813\t          (if default?\n   814\t            (do (is (= :default (a-dispatch row unmatched)))\n   815\t                (is (= [:yin.k/ok :default] c)))\n   816\t            (do (is (= ::no-match (a-dispatch row unmatched)))\n   817\t                (is (= :yin.k/error (first c)))\n   818\t                (is (= \"No matching clause in case\" (:yin.k/message (second c)))))))))))\n   819\t\n   820\t\n   821\t;; =============================================================================\n   822\t;; Slice 7: upstream higher-order and syntax anchors, both VM lanes\n   823\t;; =============================================================================\n   824\t\n   825\t(def ^:private slice7-anchors\n   826\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice7_anchors.edn\"))))\n   827\t\n   828\t\n   829\t(deftest test-oracle-slice7-library-anchors\n   830\t  (let [{:keys [dependency-groups anchors]} slice7-anchors]\n   831\t    (is (= '#{map-with vremove term-reduce free-vars vars subst alpha-norm readable-term}\n   832\t           (set (map :fn anchors))))\n   833\t    (doseq [{ns-sym :ns fname :fn :keys [groups deps args]} anchors\n   834\t            :let [names (distinct (concat (mapcat dependency-groups groups) deps))\n   835\t                  forms (mapv #(desugar (get top-forms [ns-sym %])) names)\n   836\t                  qsym (symbol (str (str/replace (str ns-sym) \"_\" \"-\") \"/\" fname))]]\n   837\t      (testing (str qsym)\n   838\t        (is (every? some? forms) \"every declared dependency exists in pinned upstream\")\n   839\t        (doseq [arg-forms args\n   840\t                :let [host-args (mapv eval arg-for