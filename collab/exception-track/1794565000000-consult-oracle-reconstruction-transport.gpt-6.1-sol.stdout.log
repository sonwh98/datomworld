{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/latte_oracle_test.clj | sed -n '730,930p'\"","aggregated_output":"   730\t  [form]\n   731\t  (filter #(and (seq? %) (= 'case (first %))) (tree-seq coll? seq form)))\n   732\t\n   733\t\n   734\t(defn- case-clause-constants\n   735\t  \"The constants of one clause key: a list groups them, anything else is one.\"\n   736\t  [k]\n   737\t  (if (seq? k) (vec k) [k]))\n   738\t\n   739\t\n   740\t(defn- case-arm-rows\n   741\t  \"One row per `case` site in the manifest forms: the clause constants of each\n   742\t   arm, and whether the site has a default.\"\n   743\t  []\n   744\t  (vec (for [{:keys [ns name]} manifest\n   745\t             c (case-forms (get top-forms [ns name]))\n   746\t             :let [clauses (drop 2 c)]]\n   747\t         {:ns ns, :fn name, :line (:line (meta c))\n   748\t          :default? (odd? (count clauses))\n   749\t          :arms (vec (map-indexed (fn [i [k _]] {:arm i, :constants (case-clause-constants k)})\n   750\t                                  (partition 2 clauses)))})))\n   751\t\n   752\t\n   753\t(def ^:private case-arm-table\n   754\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/case_arms.edn\"))))\n   755\t\n   756\t\n   757\t(def ^:private unmatched\n   758\t  \"An input no corpus clause names.\"\n   759\t  :yang.latte-oracle/unmatched)\n   760\t\n   761\t\n   762\t(defn- dispatch-clauses\n   763\t  \"The clauses of a synthetic `case`: each arm's constants as one group\n   764\t   returning the arm index, then the default `:default` when the site has one.\"\n   765\t  [{:keys [arms default?]}]\n   766\t  (concat (mapcat (fn [{:keys [arm constants]}] [(apply list constants) arm]) arms)\n   767\t          (when default? [:default])))\n   768\t\n   769\t\n   770\t(defn- a-dispatch\n   771\t  \"The host `case` over the same clauses, applied to `input`; ::no-match when\n   772\t   no clause (and no default) takes it.\"\n   773\t  [row input]\n   774\t  (try ((eval (list 'fn '[e] (list* 'case 'e (dispatch-clauses row)))) input)\n   775\t       (catch IllegalArgumentException _ ::no-match)))\n   776\t\n   777\t\n   778\t(defn- c-dispatch\n   779\t  \"The synthetic dispatch compiled through yang.clojure and run on the VM:\n   780\t   the outcomes of calling it on each of `inputs`, in order.\"\n   781\t  [row inputs]\n   782\t  (let [dispatch (list 'defn 'dispatch '[e] (list* 'case 'e (dispatch-clauses row)))]\n   783\t    (mapv (fn [input] (run-outcome [dispatch] (list 'dispatch (list 'quote input)))) inputs)))\n   784\t\n   785\t\n   786\t(deftest test-case-arm-table\n   787\t  (testing \"the checked-in table is the walk of the corpus's case sites\"\n   788\t    (is (= 6 (count case-arm-table)))\n   789\t    (is (= (case-arm-rows) case-arm-table)\n   790\t        \"regenerate with: clj -X:test:dev latte-oracle-tables/-main\")\n   791\t    (is (= #{['latte_kernel.norm 'beta-red] ['latte_kernel.norm 'beta-delta-normalize]\n   792\t             ['latte_kernel.proof 'elab-proof] ['latte_kernel.proof 'elab-proof-step]\n   793\t             ['latte_kernel.typing 'type-of-term] ['latte_kernel.syntax 'mk-fresh]}\n   794\t           (set (map (juxt :ns :fn) case-arm-table)))))\n   795\t  (testing \"every arm of every site has constants, and arms never share one\"\n   796\t    (doseq [{:keys [arms] :as row} case-arm-table\n   797\t            :let [constants (mapcat :constants arms)]]\n   798\t      (is (every? (comp seq :constants) arms) (pr-str (:fn row)))\n   799\t      (is (apply distinct? constants) (pr-str (:fn row))))))\n   800\t\n   801\t\n   802\t(deftest test-case-arm-fixtures\n   803\t  (doseq [{:keys [arms default?] :as row} case-arm-table\n   804\t          :let [label (str (:ns row) \"/\" (:fn row) \" line \" (:line row))]]\n   805\t    (testing label\n   806\t      (testing \"every constant of every arm dispatches to its own arm, A = C\"\n   807\t        (let [inputs (mapcat :constants arms)\n   808\t              expected (mapcat (fn [{:keys [arm constants]}] (repeat (count constants) arm)) arms)]\n   809\t          (is (= expected (map #(a-dispatch row %) inputs)) \"host case\")\n   810\t          (is (= (map (fn [e] [:yin.k/ok e]) expected) (c-dispatch row inputs)) \"VM\")))\n   811\t      (testing \"an input no clause names takes the default, or fails without one\"\n   812\t        (let [[c] (c-dispatch row [unmatched])]\n   813\t          (if default?\n   814\t            (do (is (= :default (a-dispatch row unmatched)))\n   815\t                (is (= [:yin.k/ok :default] c)))\n   816\t            (do (is (= ::no-match (a-dispatch row unmatched)))\n   817\t                (is (= :yin.k/error (first c)))\n   818\t                (is (= \"No matching clause in case\" (:yin.k/message (second c)))))))))))\n   819\t\n   820\t\n   821\t;; =============================================================================\n   822\t;; Slice 7: upstream higher-order and syntax anchors, both VM lanes\n   823\t;; =============================================================================\n   824\t\n   825\t(def ^:private slice7-anchors\n   826\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice7_anchors.edn\"))))\n   827\t\n   828\t\n   829\t(deftest test-oracle-slice7-library-anchors\n   830\t  (let [{:keys [dependency-groups anchors]} slice7-anchors]\n   831\t    (is (= '#{map-with vremove term-reduce free-vars vars subst alpha-norm readable-term}\n   832\t           (set (map :fn anchors))))\n   833\t    (doseq [{ns-sym :ns fname :fn :keys [groups deps args]} anchors\n   834\t            :let [names (distinct (concat (mapcat dependency-groups groups) deps))\n   835\t                  forms (mapv #(desugar (get top-forms [ns-sym %])) names)\n   836\t                  qsym (symbol (str (str/replace (str ns-sym) \"_\" \"-\") \"/\" fname))]]\n   837\t      (testing (str qsym)\n   838\t        (is (every? some? forms) \"every declared dependency exists in pinned upstream\")\n   839\t        (doseq [arg-forms args\n   840\t                :let [host-args (mapv eval arg-forms)\n   841\t                      a (a-leg (upstream-fn qsym) host-args)\n   842\t                      c (run-outcome forms (list* fname arg-forms))]]\n   843\t          (is (agrees? a c) (str qsym \" \" (pr-str arg-forms)\n   844\t                                 \" A=\" (pr-str a) \" C=\" (pr-str c)))\n   845\t          (when (contains? a :value)\n   846\t            (is (= (result-shape (:value a)) (result-shape (second c)))\n   847\t                \"value equality also preserves nested metadata and collection shape\")))))))\n   848\t\n   849\t\n   850\t(deftest test-oracle-slice7-finite-zip\n   851\t  ;; The pinned corpus has one consumer, proof/compile-proof's :assume arm:\n   852\t  ;; it loops over all pairs to build declarations, then reverses all pairs\n   853\t  ;; to build discharges. It requires finite, fully consumed inputs; it does\n   854\t  ;; not catch zip failures or depend on partial realization/error timing.\n   855\t  (let [source (get top-forms ['latte_kernel.utils 'zip])\n   856\t        forms [(desugar source)]]\n   857\t    (is (thrown-with-msg? clojure.lang.ExceptionInfo #\"Only finite utils/zip\"\n   858\t          (desugar '(defn other\n   859\t                      [s]\n   860\t                      (lazy-seq s)))))\n   861\t    (is (= 1 (count (filter #(= 'lazy-seq %) (walk-symbols source))))\n   862\t        \"zip is the single explicit eager lazy-seq adaptation\")\n   863\t    (doseq [input [nil [] '() '[a A] '(a A b B c C) '[a A b]]\n   864\t            :let [a (a-leg (upstream-fn 'latte-kernel.utils/zip) [input])\n   865\t                  c (run-outcome forms (list 'zip (list 'quote input)))]]\n   866\t      (is (agrees? a c) (str \"fully realized finite zip \" (pr-str input))))\n   867\t    (is (= [:yin.k/ok [true 2 '[a A] '([b B]) '(:front [a A] [b B])]]\n   868\t           (run-outcome forms\n   869\t                        '(let [s (zip '(a A b B))]\n   870\t                           [(seq? s) (count s) (first s) (rest s) (conj s :front)]))))))\n   871\t\n   872\t\n   873\t;; =============================================================================\n   874\t;; Slice 8: immutable kernel state and explicit extension installation\n   875\t;; =============================================================================\n   876\t\n   877\t(def ^:private context-source\n   878\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/context.edn\"))))\n   879\t\n   880\t\n   881\t(defn- context-upstream-form\n   882\t  \"Keep the upstream implementation, changing only the environment boundary\n   883\t   and module-local names. Both delta implementations read the SAME binding.\"\n   884\t  [ns-sym fname]\n   885\t  (let [renames (if (#{'latte_kernel.nbe 'latte_kernel.norm} ns-sym)\n   886\t                  {'delta-reduction (symbol (str (last (str/split (clojure.core/name ns-sym) #\"\\.\")) \"-delta\"))\n   887\t                   'instantiate-def (symbol (str (last (str/split (clojure.core/name ns-sym) #\"\\.\")) \"-instantiate\"))}\n   888\t                  {})]\n   889\t    (walk/postwalk\n   890\t      (fn [x]\n   891\t        (cond\n   892\t          (and (seq? x) (#{'deref 'clojure.core/deref} (first x))\n   893\t               (= '+unfold-implicit+ (second x))) '(:unfold-implicit def-env)\n   894\t          (contains? '{get-in lookup-in not-empty context-not-empty\n   895\t                       ffirst context-ffirst list* context-list-star} x)\n   896\t          (get '{get-in lookup-in not-empty context-not-empty\n   897\t                 ffirst context-ffirst list* context-list-star} x)\n   898\t          (symbol? x) (get renames x x)\n   899\t          :else x))\n   900\t      (desugar (get top-forms [ns-sym fname])))))\n   901\t\n   902\t\n   903\t(def ^:private context-forms\n   904\t  (into context-source\n   905\t        (concat\n   906\t          (map #(context-upstream-form 'latte_kernel.syntax %)\n   907\t               '[kind? type? variable? binder? lambda? prod? app? ascription? ref?\n   908\t                 host-constant? binderify free-vars vars mk-fresh subst- rebinder subst])\n   909\t          (map #(context-upstream-form 'latte_kernel.nbe %) '[instantiate-def delta-reduction])\n   910\t          (map #(context-upstream-form 'latte_kernel.norm %) '[instantiate-def delta-reduction])\n   911\t          [(context-upstream-form 'latte_kernel.proof 'elab-proof)]\n   912\t          (map #(context-upstream-form 'latte_kernel.unparser %)\n   913\t               '[unparse-term-once unparse-term-rec prod-impl-unparser])\n   914\t          '[(defn unparse\n   915\t              [kernel term]\n   916\t              (first (unparse-term-rec (:unparser-registry kernel) (unparser-order kernel) term)))\n   917\t            (defn install-fundamental-unparsers\n   918\t              [kernel]\n   919\t              (register-unparser kernel :fundamental :prod-impl prod-impl-unparser))])))\n   920\t\n   921\t\n   922\t(defn- context-for\n   923\t  \"The transitive source dependency closure, preserving upstream order.\"\n   924\t  [program]\n   925\t  (let [by-name (into {} (map (juxt second identity)) context-forms)\n   926\t        mentions (fn [form] (filter #(contains? by-name %) (walk-symbols form)))\n   927\t        needed (loop [todo (seq (mapcat mentions program)) seen #{}]\n   928\t                 (if-let [n (first todo)]\n   929\t                   (if (contains? seen n)\n   930\t                     (recur (next todo) seen)\n","exit_code":0,"status":"completed"}}
