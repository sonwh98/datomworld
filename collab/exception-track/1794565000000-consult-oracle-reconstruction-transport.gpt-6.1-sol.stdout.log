\"\n  1516\t  [ctx x]\n  1517\t  (let [m (:m ctx)]\n  1518\t    (cond\n  1519\t      (values/host-typed? x)\n  1520\t      (cond\n  1521\t        (not (values/owned-by? x (:owner m)))\n  1522\t        (outcome! :yin.k/non-portable :foreign-value {:yin.k/hint (values/kind-of x)})\n  1523\t        (values/closure? x) [:row (closure-node ctx (values/payload x))]\n  1524\t        (values/continuation? x) [:row (node :reified [(state-node ctx (values/payload x))])]\n  1525\t        :else (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint (values/kind-of x)}))\n  1526\t      (fn? x) [:row (node :prim [(primitive-name ctx x)])]\n  1527\t      (map? x)\n  1528\t      (case (:type x)\n  1529\t        :stream-ref (if (engine/authentic-ref? m :stream-ref x)\n  1530\t                      [:row (stream-row! ctx (:id x))]\n  1531\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n  1532\t        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)\n  1533\t                      [:cursor-cell (cell-for! ctx (:id x))]\n  1534\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))\n  1535\t        :parked-continuation (if (contains? (:parked m) (:id x))\n  1536\t                               [:row (node :parked-ref [(:id x)])]\n  1537\t                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))\n  1538\t        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})\n  1539\t        (collection-value ctx :map (mapcat identity x) x))\n  1540\t      (vector? x) (collection-value ctx :vec x x)\n  1541\t      (set? x) (collection-value ctx :set (vec x) x)\n  1542\t      (seq? x) (collection-value ctx :list (vec x) x)\n  1543\t      (scalar-literal? x) [:lit x]\n  1544\t      :else (outcome! :yin.k/non-portable :host-object {}))))\n  1545\t\n  1546\t\n  1750\t            (contains? m :yin.k/rec