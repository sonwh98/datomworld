xiom :name name :params params :arity arity :type type})\\n (defn ->Notation [name notation-fn]\\n   {:latte/kind :notation :name name :notation-fn notation-fn})\\n (defn ->Implicit [name implicit-fn]\\n   {:latte/kind :implicit :name name :implicit-fn implicit-fn})\\n (defn definition? [v] (= :definition (:latte/kind v)))\\n (defn theorem? [v] (= :theorem (:latte/kind v)))\\n (defn axiom? [v] (= :axiom (:latte/kind v)))\\n (defn notation? [v] (= :notation (:latte/kind v)))\\n (defn implicit? [v] (= :implicit (:latte/kind v)))\\n (defn latte-definition? [v]\\n   (or (definition? v) (theorem? v) (axiom? v) (notation? v) (implicit? v)))\\n (defn kernel-context [definitions opacity-policy unfold-implicit]\\n   {:definitions definitions\\n    :unparser-registry {:fundamental [] :standard [] :user [] :unparsers {}}\\n    :opacity-policy opacity-policy :unfold-implicit unfold-implicit :fresh 0})\\n (defn local-definitions [kernel] (second (:definitions kernel)))\\n (defn register-definition\\n   ([kernel rdef] (register-definition kernel rdef false))\\n   ([kernel rdef local?]\\n    (let [[globals locals] (:definitions kernel)]\\n      (assoc kernel :definitions\\n             (if local? [globals (assoc locals (:name rdef) rdef)]\\n                 [(assoc globals (:name rdef) rdef) locals])))))\\n (defn fetch-definition\\n   ([kernel dname] (fetch-definition kernel dname false))\\n   ([kernel dname local-only?]\\n    (let [[globals locals] (:definitions kernel)]\\n      (if (symbol? dname)\\n        (if-let [ldef (get locals dname)]\\n          [:ok ldef]\\n          (if local-only?\\n            [:ko {:msg \\\"No such (local) definition\\\" :def dname}]\\n            (if-let [gdef (get globals dname)]\\n              [:ok gdef]\\n              [:ko {:msg \\\"No such (global) definition\\\" :def dname}])))\\n        (throw (ex-info \\\"Cannot fetch definition (please report)\\\" {:dname dname}))))))\\n (defn registered-definition?\\n   ([kernel dname] (registered-definit