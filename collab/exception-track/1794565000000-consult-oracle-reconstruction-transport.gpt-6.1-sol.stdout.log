mplicit (:latte/kind v)))\n    29\t (defn latte-definition? [v]\n    30\t   (or (definition? v) (theorem? v) (axiom? v) (notation? v) (implicit? v)))\n    31\t (defn kernel-context [definitions opacity-policy unfold-implicit]\n    32\t   {:definitions definitions\n    33\t    :unparser-registry {:fundamental [] :standard [] :user [] :unparsers {}}\n    34\t    :opacity-policy opacity-policy :unfold-implicit unfold-implicit :fresh 0})\n    35\t (defn local-definitions [kernel] (second (:definitions kernel)))\n    36\t (defn register-definition\n    37\t   ([kernel rdef] (register-definition kernel rdef false))\n    38\t   ([kernel rdef local?]\n    39\t    (let [[globals locals] (:definitions kernel)]\n    40\t      (assoc kernel :definitions\n    41\t             (if local? [globals (assoc locals (:name rdef) rdef)]\n    42\t                 [(assoc globals (:name rdef) rdef) locals])))))\n    43\t (defn fetch-definition\n    44\t   ([kernel dname] (fetch-definition kernel dname false))\n    45\t   ([kernel dname local-only?]\n    46\t    (let [[globals locals] (:definitions kernel)]\n    47\t      (if (symbol? dname)\n    48\t        (if-let [ldef (get locals dname)]\n    49\t          [:ok ldef]\n    50\t          (if local-only?\n    51\t            [:ko {:msg \"No such (local) definition\" :def dname}]\n    52\t            (if-let [gdef (get globals dname)]\n    53\t              [:ok gdef]\n    54\t              [:ko {:msg \"No such (global) definition\" :def dname}])))\n    55\t        (throw (ex-info \"Cannot fetch definition (please report)\" {:dname dname}))))))\n    56\t (defn registered-definition?\n    57\t   ([kernel dname] (registered-definition? kernel dname false))\n    58\t   ([kernel dname local?] (= :ok (first (fetch-definition kernel dname local?)))))\n    59\t (defn qualify-def [kernel dname]\n    60\t   (if (= :ok (first (fetch-definition kernel dname)))\n    61\t     dname\n    62\t     (throw (ex-info \"Cannot qualify symbol: not a known definition\" {:symbol dname}))))\n    63\t (defn fresh-name [kernel prefix]\n    64\t   [(gensym prefix (:fresh kernel)) (assoc kernel :fresh (+ (:fresh kernel) 1))])\n    65\t (defn install-unfold-implicit [kernel unfold-fn]\n    66\t   (assoc kernel :unfold-implicit unfold-fn))\n    67\t (defn install-opacity-function [kernel opacity-fn]\n    68\t   (assoc kernel :opacity-policy opacity-fn))\n    69\t (defn missing-opacity-policy [ddef opaque?]\n    70\t   (throw (ex-info \"Opacity management function not installed (please report)\" {:weird true})))\n    71\t (defn missing-unfold-implicit [kernel ctx implicit-def args]\n    72\t   (throw (ex-info \"Implicit unfolding function not installed\" {})))\n    73\t (defn definition-opacity [ddef opaque?]\n    74\t   (assoc ddef :opts (assoc (:opts ddef) :opaque opaque?)))\n    75\t (defn is-opaque? [ddef]\n    76\t   (if-let [opts (get ddef :opts)] (get opts :opaque)))\n    77\t (defn elab-opacity [kernel names opaque?]\n    78\t   (reduce\n    79\t     (fn [kernel dname]\n    80\t       (let [[status ddef] (fetch-definition kernel dname)]\n    81\t         (when (= status :ko)\n    82\t           (throw (ex-info \"Cannot qualify symbol: not a known definition\" {:symbol dname})))\n    83\t         (when (= (if (is-opaque? ddef) true false) opaque?)\n    84\t           (throw (ex-info (if opaque? \":opaque fails: definition is already opaque\"\n    85\t                              \":transparent fails: definition is not opaque\") {:name dname})))\n    86\t         (let [updated ((:opacity-policy kernel) ddef opaque?)]\n    87\t           (register-definition kernel updated (contains? (local-definitions kernel) dname)))))\n    88\t     kernel names))\n    89\t (defn elab-opaque [kernel names] (elab-opacity kernel names true))\n    90\t (defn elab-transparent [kernel names] (elab-opacity kernel names false))\n    91\t ;; Preserve the upstream unregister's :user-from-:standard behavior exactly.\n    92\t (defn unregister-unpars