{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '250,345p'\"","aggregated_output":"   250\t    ;; The dynamic context is one record in one cell, {:handlers :depth\n   251\t    ;; :base :frame}: every capture point saves it and every escape\n   252\t    ;; restores it with the current :base left alone (`py/restore!`), so\n   253\t    ;; an escape inside a generator restores its depth relative to the\n   254\t    ;; activation it runs in; only crossings set :base. The handler stack\n   255\t    ;; is a chain of frames [kind payload rest n depth]: :handler frames\n   256\t    ;; hold the continuation `raise` delivers to, :finally frames hold a\n   257\t    ;; thunk of one argument (the exception, or None) that every exit\n   258\t    ;; through them runs. n, the frame count, makes \"unwind to here\" an\n   259\t    ;; integer comparison; depth is the (activation-relative) call depth\n   260\t    ;; the frame was pushed at, which its thunk runs at.\n   261\t    [py/ctx\n   262\t     (fn [handlers depth base frame]\n   263\t       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\n   264\t                     :base base)\n   265\t              :frame frame))]\n   266\t    [py/abs-depth (fn [c] (+ (get c :base) (get c :depth)))]\n   267\t    [py/rt-ctx\n   268\t     ;; the dynamic-context cell itself (C4 slice P3): the base prelude\n   269\t     ;; owns the record, and the hook prelude counts frames in it, but\n   270\t     ;; `py.rt/*` is an internal store key no closure of another module\n   271\t     ;; can name, so linked hooks read the cell through this export\n   272\t     (fn [] py.rt/ctx)]\n   273\t    [py/rt-limit\n   274\t     ;; the recursion-limit cell, the same door\n   275\t     (fn [] py.rt/limit)]\n   276\t    [py/restore!\n   277\t     (fn [saved]\n   278\t       (cell/set! py.rt/ctx\n   279\t                  (assoc saved :base (get (cell/get py.rt/ctx) :base))))]\n   280\t    [py/handlers (fn [] (get (cell/get py.rt/ctx) :handlers))]\n   281\t    [py/set-handlers!\n   282\t     (fn [hs] (cell/set! py.rt/ctx (assoc (cell/get py.rt/ctx) :handlers hs)))]\n   283\t    [py/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n   284\t    [py/frame\n   285\t     (fn [kind payload rest]\n   286\t       (py/vconj (py/vconj (py/vconj (py/vconj (py/vconj [] kind) payload) rest)\n   287\t                           (+ 1 (py/frame-depth rest)))\n   288\t                 (get (cell/get py.rt/ctx) :depth)))]\n   289\t    [py/pop-frame\n   290\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\n   291\t     (fn [hs]\n   292\t       (cell/set! py.rt/ctx\n   293\t                  (assoc (assoc (cell/get py.rt/ctx) :handlers (get hs 2))\n   294\t                         :depth (get hs 4))))]\n   295\t    [py/raise\n   296\t     (fn [e]\n   297\t       (let [hs (py/handlers)]\n   298\t         (if (nil? hs)\n   299\t           (:py/no-handler e)\n   300\t           (if (= (get hs 0) :finally)\n   301\t             (do (py/pop-frame hs)\n   302\t                 ((get hs 1) e)\n   303\t                 (py/raise e))\n   304\t             ((get hs 1) e)))))]\n   305\t    [py/unwind-to\n   306\t     ;; pop frames above frame count n, running each finally thunk with None\n   307\t     (fn [n]\n   308\t       (let [hs (py/handlers)]\n   309\t         (if (nil? hs)\n   310\t           :py/None\n   311\t           (if (<= (get hs 3) n)\n   312\t             :py/None\n   313\t             (do (py/pop-frame hs)\n   314\t                 (if (= (get hs 0) :finally) ((get hs 1) :py/None) :py/None)\n   315\t                 (py/unwind-to n))))))]\n   316\t    [py/try\n   317\t     (fn [body handler orelse]\n   318\t       (let [saved (cell/get py.rt/ctx)\n   319\t             flag (cell/new :first)]\n   320\t         ((fn [r]\n   321\t            (if (= (cell/get flag) :first)\n   322\t              (do (cell/set! flag :re-entered)\n   323\t                  (py/set-handlers! (py/frame :handler r (get saved :handlers)))\n   324\t                  (body)\n   325\t                  (py/restore! saved)\n   326\t                  (orelse))\n   327\t              (do (py/restore! saved)\n   328\t                  (handler r))))\n   329\t          (%capture))))]\n   330\t    [py/try-finally\n   331\t     ;; normal exit runs `fin` here; raise and escapes run it as they\n   332\t     ;; unwind through the :finally frame\n   333\t     (fn [body fin]\n   334\t       (let [saved (cell/get py.rt/ctx)]\n   335\t         (do (py/set-handlers! (py/frame :finally fin (get saved :handlers)))\n   336\t             (let [v (body)]\n   337\t               (do (py/restore! saved)\n   338\t                   (fin :py/None)\n   339\t                   v)))))]\n   340\t    [py/call-ec\n   341\t     (fn [f]\n   342\t       (let [saved (cell/get py.rt/ctx)\n   343\t             flag (cell/new :first)]\n   344\t         ((fn [r]\n   345\t            (if (= (cell/get flag) :first)\n","exit_code":0,"status":"completed"}}
