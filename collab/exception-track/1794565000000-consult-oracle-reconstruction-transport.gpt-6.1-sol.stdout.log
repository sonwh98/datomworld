er kernel :fundamental :prod-impl prod-impl-unparser))])))\\n\\n\\n(defn- context-for\\n  \\\"The transitive source dependency closure, preserving upstream order.\\\"\\n  [program]\\n  (let [by-name (into {} (map (juxt second identity)) context-forms)\\n        mentions (fn [form] (filter #(contains? by-name %) (walk-symbols form)))\\n        needed (loop [todo (seq (mapcat mentions program)) seen #{}]\\n                 (if-let [n (first todo)]\\n                   (if (contains? seen n)\\n                     (recur (next todo) seen)\\n                     (recur (concat (next todo) (mentions (get by-name n))) (conj seen n)))\\n                   seen))]\\n    (filterv #(contains? needed (second %)) context-forms)))\\n\\n\\n(defn- context-host-form\\n  \\\"B is ordinary Clojure over the checked-in adaptation. The sole guest\\n   outcome intrinsic becomes the equivalent host catch; data primitives and\\n   deterministic gensym retain exactly their portable contracts.\\\"\\n  [form]\\n  (walk/postwalk\\n    (fn [x]\\n      (cond\\n        (and (seq? x) (= 'yin.k/outcome-of (first x)))\\n        `(try [:yin.k/ok ~(second x)]\\n              (catch clojure.lang.ExceptionInfo e#\\n                [:yin.k/error {:yin.k/message (ex-message e#) :yin.k/data (ex-data e#)}]))\\n        (and (seq? x) (= 'gensym (first x)))\\n        (let [[_ prefix n] x]\\n          (list 'let ['prefix prefix 'n n]\\n                '(if (map? prefix)\\n                   [(symbol (str \\\"G__\\\" n (:counter prefix)))\\n                    (assoc prefix :counter (inc (:counter prefix)))]\\n                   (symbol (str prefix n)))))\\n        (and (seq? x) (= 'fresh-symbol (first x)))\\n        (let [[_ supply prefix] x]\\n          (list 'let ['supply supply]\\n                (list 'vector (list 'symbol (list 'str \\\"G__\\\" prefix '(:counter supply)))\\n                      '(assoc supply :counter (inc (:counter supply))))))\\n        (= x 'data/dissoc) 'clojure.core/dissoc\\n        :else x))\\n    form))\\n\\n\\n(defn- context-b\\n  [forms call]\\n  (let [ns-sym (gensym \\\"latte-context-b-\\\")\\n        sandbox (create-ns ns-sym)]\\n    (try\\n      (binding [*ns* sandbox]\\n                                   'k2 '(install-opacity-function k1 missing-opacity-policy)]\\n                             '[(= (:unfold-implicit k0) missing-unfold-implicit)\\n                               (= (:unfold-implicit k1) (:unfold-implicit k0))\\n                               (= (:opacity-policy k0) definition-opacity)]))))))\\n\\n\\n(defn- assert-machine-data-within-budget!\\n  \\\"Bound recursive validation work, which the VM instruction budget cannot\\n   interrupt. Throw outside `is` so exhaustion also stops UCF reconstruction.\\\"\\n  [value limit]\\n  (let [visits (volatile! 0)\\n        check vm/machine-data?\\n        valid? (with-redefs [vm/machine-data?\\n                             (fn [x]\\n                               (when (> (vswap! visits inc) limit)\\n                                 (throw (ex-info \\\"Machine-data validation budget exhausted\\\"\\n                                                 {:visits @visits :limit limit})))\\n                               (check x))]\\n                 (vm/machine-data? value))]\\n    (is valid?)\\n    (is (<= @visits limit) \\\"descriptor environments have bounded validation work\\\")))\\n\\n\\n(deftest test-oracle-slice8-context-reconstruction\\n  (let [program [(list 'let ['checkpoint\\n                             (list 'let ['base initial-context 'offset 4]\\n                                   '(register-unparser base :captured\\n                                                       (fn [term] [(+ offset term) true])))]\\n                       '(unparse checkpoint 3))]\\n        forms (into (context-for program) program)\\n        ast (yang/compile-program (into (yang/library-for forms) forms) true arg-vector-opts)\\n        modules (oracle-registry yang/kind-module)\\n        run-bounded (fn [machine]\\n                      (loop [m machine n 0]\\n                        (cond\\n                          (vm/halted? m) (vm/value m)\\n                          (= n 1000000)\\n                          (throw (ex-info \\\"Context execution budget exhausted\\\" {:steps n}))\\n                          :else (recur (vm/step m) (inc n)))))]\\n    (is (vm/plain-data? context-source) \\\"adaptation is plain code data\\\")\\n    (is (vm/plain-data? ast) \\\"runtime closures are never embedded as literals\\\")\\n    (testing \\\"code rows round-trip and reconstruct the closure registry on both lanes\\\"\\n      (let [[_root datoms] (vm/ast->datoms-with-root ast)\\n            rebuilt (vm/datoms->ast (cbor/decode (cbor/encode datoms)))]\\n        (doseq [lane [:walker :semantic]]\\n          (is (= [:yin.k/ok 7] (compiler-test/run-guest-ast rebuilt modules lane 1000000))))))\\n    (testing \\\"a live registry with a captured guest closure survives UCF reconstruction\\\"\\n      (let [code (vm/ast->semantic-bytecode ast)\\n            bytecode (:vector (linearize/project-rows code))\\n            source-index {(ucf/code-address bytecode) #{(:root code)}}\\n            machine (semantic/load-vector (rows-support/new-machine {:modules modules})\\n\\n(deftest test-oracle-slice8-admission\\n  (let [symbols (set (filter symbol? (tree-seq coll? seq context-forms)))\\n        ambient '#{atom swap! reset! deref clojure.core/deref resolve var? alter-var-root\\n                   defrecord println print pprint pp/pprint nano-time System/nanoTime}]\\n    (is (empty? (filter symbols ambient)) \\\"context source has no ambient state, host lookup or diagnostics\\\")\\n    (is (vm/plain-data? context-forms)))\\n  (testing \\\"free-symbol admission catches undeclared guest dependencies before execution\\\"\\n    (is (= '#{missing-extension}\\n           (unbound-ast-symbols (yang/compile '(fn [x] (missing-extension x))) []))))\\n  (testing \\\"context modules reject undeclared namespace lookup at admission\\\"\\n    (doseq [call ['(resolve 'clojure.core/map)]]\\n      (is (thrown-with-msg? clojure.lang.ExceptionInfo #\\\"Unadmitted context dependencies\\\"\\n            (run-outcome [] call (oracle-registry yang/kind-module) true))))))\\n\\n\\n(deftest test-oracle-slice8-implicit-delta-errors\\n  (let [fail-form '(fn [kernel ctx x]\\n                     (throw (ex-info \\\"extension failed\\\" {:msg \\\"data wins\\\" :extra 7})))\\n        implicit ((upstream-fn 'latte-kernel.defenv/->Implicit) 'i (eval fail-form))\\n        env ((upstream-fn 'latte-kernel.defenv/register-definition) [{} {}] implicit)\\n        term '(i [:latte-kernel.presyntax/host-constant 7])]\\n    (doseq [[a-name c-name] [['latte-kernel.nbe/delta-reduction 'nbe-delta]\\n                             ['latte-kernel.norm/delta-reduction 'norm-delta]]]\\n      (let [a (with-redefs-fn {(upstream-fn 'latte-kernel.norm/+unfold-implicit+) (atom nil)\\n                               (upstream-fn 'latte-kernel.nbe/+unfold-implicit+) (atom nil)}\\n                (fn []\\n                  ((upstream-fn 'latte-kernel.norm/install-unfold-implicit!)\\n                   (upstream-fn 'latte-kernel.typing/unfold-implicit))\\n                  (a-leg (upstream-fn a-name) [env [] term])))\\n            c (context-bc host-constant-unfold\\n                          (list 'let ['k (list 'register-definition\\n                                               (list 'install-unfold-implicit initial-context 'unfold-host-constants)\\n                                               (list '->Implicit ''i fail-form))]\\n                                (list c-name 'k [] (list 'quote term))))]\\n        (is (agrees? a c))))))\\n\\n\\n(defn- a-opacity-proof\\n  ([script] (a-opacity-proof script false))\\n  ([script install?]\\n   (let [ns-sym (gensym \\\"latte-proof-a-\\\")\\n         sandbox (create-ns ns-sym)\\n         ddef ((upstream-fn 'latte-kernel.defenv/->Definition) 'd [] 0 'body #{} 'T {})\\n         policy (fn [v flag] (alter-var-root v assoc-in [:opts :opaque] flag))]\\n     (try\\n       (intern sandbox 'd ddef)\\n       (binding [*ns* sandbox]\\n         (with-redefs-fn {(upstream-fn 'latte-kernel.proof/+opacity-fn+)\\n                          (atom (if install?\\n                                  (fn [_ _] (throw (ex-info \\\"Policy not installed\\\" {}))) policy))}\\n           (fn []\\n             (when install?\\n               ((upstream-fn 'latte-kernel.proof/install-opacity-function) policy))\\n             (a-leg (upstream-fn 'latte-kernel.proof/elab-proof) [[{} {}] [] script]))))\\n       (finally (remove-ns ns-sym))))))\\n\\n\\n(deftest test-oracle-slice8-upstream-proof-loop\\n  (testing \\\"the original proof loop threads updated contexts across state steps\\\"\\n    (doseq [script ['((:opaque d) (:transparent d) (:opaque d) (:transparent d))\\nCreated-GMT: 2026-11-11 13:40:00 GMT\\nCreated-Local: 2026-11-11 20:40:00 +0700\\nCoding-Agent: muse\\nSession-ID: 7db9b5cc-3472-4c31-9657-1b41aaa76ae3\\n\\n# cc3 bounded run declaration v2 — NEW versioned run (astra r4 ruling (c))\\n\\nThis declaration is written BEFORE the v2 measurement run, per design\\n§6.3 and astra's r4 exceedance ruling (c). It creates a NEW, explicitly\\nversioned bounded run. It does not amend, re-scope, or relabel the\\nsuperseded run (see §5).\\n\\n## 1. Pinned corpus, revision, host, and JVM settings\\n\\n| Item | Pinned value |\\n|---|---|\\n| Worktree / branch | `/Users/sto/workspace/datomworld-cc3`, branch `cc3-lowering-provenance` |\\n| Base revision | `ced9f2c2bdb43ab4a416b4ab408c76eb29245764` plus the uncommitted cc3 diff (ten tracked files, +1651/−98 at r6 delivery: the eight cc3 files plus the two F7 diagnostic scripts `test/d2_wedge_min_repro.clj` / `test/d2_wedge_probe2.clj`, which the measurement script does not load; latte oracle test file further changed in r5 for F2 caller threading — behaviour-neutral for this fixture's compiled content). Exact pin: see the digest rows below and §6. |\\n| Fixture (the whole corpus of this run) | `{:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}` admitted through `kernel-compile`, bound through `cc3-oracle-binding` |\\n| Upstream oracle revision | latte-kernel `86fca0d1d054af005cb37395eae04500d45e6279` (pinned in `deps.edn` `:test` alias) |\\n| Compiler base recorded by the evidence harness | `7dc18478` |\\n| Host | Darwin 25.6.0 arm64, Apple M1 Pro, 17,179,869,184 B RAM |\\n| JVM | OpenJDK 17.0.18+0 (Homebrew, 64-Bit Server VM, mixed mode) |\\n| Clojure | Clojure CLI 1.12.4.1602; no explicit `-Xmx` (JVM default max heap). JVM stack: **corrected in r6 (V2)** — the v2 (r5) measured command (§4 as originally written) activated ONLY the `:f6` alias, which supplied `:extra-paths [\\\"test\\\"]` and the latte-kernel `:extra-deps` and NO `:jvm-opts`; the project `:test` alias was NOT activated, so its `-Xss64m` (`deps.edn:52`) and its test-runner main-opts were NOT in effect for the v2 run. The v2 samples therefore stand as measured under the JVM default thread stack. The v2.1 declared command (§4, r6 revision) supplies `-Xss64m` explicitly through `:f6`'s own `:jvm-opts [\\\"-Xss64m\\\"]`, and the v2.1 results in §6 were measured under exactly that declared command. `-Xss64m` is declared for parity with the `:test` stack policy and headroom, not because the v2 ceilings depended on it: the v2 samples already met every ceiling without it. |\\n| Measurement script | `collab/yang-clojure/1794386683000-cc3-f6-measure.clj` (in-repo, r5 revision: maximum-based rule, compiled-inclusive holder) |\\n| Measured patch pin (SHA-256) | `git diff` (ten tracked files listed in §6) = `05076f51add1a5b5285c62c6b85c7eb8875d7c2780a7b33613e46742a250887d` (computed 2026-11-11 after the final r6 code edit; reproduce with `git diff \\\\| shasum -a 256` in this worktree) |\\n| Measurement script pin (SHA-256) | `shasum -a 256 collab/yang-clojure/1794386683000-cc3-f6-measure.clj` = `345b432dace388ce20bb463d2241c650b400b644b5194cd0ddae1a3fb42b37c8` |\\n\\n## 2. Retained object set and maximum simultaneous retention\\n\\nThe retained set for one fixture, all held simultaneously by one local\\nholder (never a global Var), is:\\n\\n- the **compiled input**: the `kernel-compile` result (compiled AST,\\n  stamped AST, site table, retained `:admission-origin`);\\n- the **binding**: `cc3-oracle-binding` result (C1 tree, rows, marked\\n  and eligible occurrence sets, site→key binding);\\n- the **reconstruction evidence**: the binding's stamped tree/rows,\\n  stamped marked/eligible sets, site correspondence map, and stamped\\n  paths — i.e. everything needed to reconstruct and verify each bound\\n  key from the retained compilation;\\n- the lowered images: `linearize/project-rows` output plus\\n  `derive/stack-image` and `derive/register-image`;\\n- the provenance relation (schema-1 map over admission/root and the\\n  semantic, stack, and register call-provenance) and, in the pipeline\\n  variant, its durable record in a file-backed content store.\\n\\nTwo holder variants are measured: **binding-only** (binding, lowered\\nimages, relation, reconstruction evidence — the compiled input is\\nreleased after binding) and **compiled-inclusive** (the same set plus\\nthe retained compiled input). The compiled-inclusive variant is the\\nacceptance variant; the binding-only variant is reported for\\ncomparison and is NOT the acceptance holder.\\n\\n**Maximum simultaneously retained fixtures: 1.** Every retained and\\npeak measurement holds exactly one fixture's retained set at a time;\\nthe previous holder is released (and GC-pinned) before the next\\nrepetition builds a new one.\\n\\n## 3. Ceilings (separate, finite, pilot-justified)\\n\\nPilot measurements (superseded run, r4, warm JVM, same host/JVM):\\nbinding-only retained samples 7,960,192 / 7,921,728 / 8,044,024 B\\n(median 7,960,192 B, **maximum 8,044,024 B**); compiled-inclusive\\nsamples 9,008,912 / 8,939,024 / 8,826,416 B (median 8,939,024 B,\\n**maximum 9,008,912 B**); serialized rows 293,924 B; serialized\\nrelation 802,260 B; peak used heap 292,720,240 B (GC-pinned baseline\\n38,967,336 B); pipeline elapsed 1,727 ms.\\n\\n| Ceiling | v2 bound | Justification / headroom over pilot |\\n|---|---|---|\\n| Storage, per artifact (serialized canonical bytes) | **2,000,000 B** | Kept from r2. Pilot rows 293,924 B (6.8× headroom), relation 802,260 B (2.5× headroom). |\\n| Storage, aggregate retained serialized set (rows + relation + durable record, 1 fixture) | **4,000,000 B** | Pilot rows+relation = 1,096,184 B; the durable record is a small map over the same data. 4,000,000 B is ≥3.6× the pilot partial sum, leaving room for the record while staying finite. |\\n| Retained memory, aggregate (1 fixture, compiled-inclusive holder) | **12,000,000 B** | Set ABOVE the pilot compiled-inclusive **maximum** 9,008,912 B by 2,991,088 B (**+33.2% headroom**; +34.2% over the 8,939,024 B median; +49.2% over the binding-only maximum 8,044,024 B). Pilot repetition spread was ~2% (8,826,416–9,008,912 B), so 33% covers GC-delta noise, the longer r5 run-scope strings (tens of bytes), and host jitter on this machine class, without being an order-of-magnitude loosening. The floor is the measured maximum, per ruling (c): a ceiling at or below 9,008,912 B would declare a run already known to exceed it. |\\n| Peak heap (absolute used heap during the pipeline) | **1,073,741,824 B (1 GiB)** | Kept from r2. Pilot peak 292,720,240 B is 27.3% of this ceiling (3.67× headroom); the figure is absolute used heap (baseline + harness + transients), so the margin absorbs sampler/baseline variance. |\\n| Time, per pipeline repetition (compile → persistence → both tagged lanes) | **10,000 ms** | Kept from r2. Pilot 1,727 ms gives 5.8× headroom; warm-JVM figure, cold-JVM limits are stated in §4. |\\n| Guest instructions / trace records per C lane | **4,000,000 / 1,000,000** | Restated from the r1 record, NOT raised. |\\n\\n## 4. Exact reproducible measurement procedure\\n\\nScript: `collab/yang-clojure/1794386683000-cc3-f6-measure.clj`\\n(r5 revision). Run from the worktree root:\\n\\n```\\nclojure -Sdeps '{:aliases {:f6 {:extra-paths [\\\"test\\\"] :jvm-opts [\\\"-Xss64m\\\"] :extra-deps {latte-kernel/latte-kernel {:git/url \\\"https://github.com/latte-central/latte-kernel\\\" :git/sha \\\"86fca0d1d054af005cb37395eae04500d45e6279\\\"}}}}}' -M:f6 collab/yang-clojure/1794386683000-cc3-f6-measure.clj\\n```\\n\\n(Settings actually in effect, r6-corrected: the `:f6` alias defined\\ninline by `-Sdeps` supplies everything — `:extra-paths [\\\"test\\\"]` puts\\nthe oracle test namespace on the classpath, `:jvm-opts [\\\"-Xss64m\\\"]`\\nsets the thread stack (added in the r6 revision of this command; the\\nv2 run used the same command WITHOUT `:jvm-opts`, i.e. the JVM\\ndefault stack — see §1), and `:extra-deps` pins latte-kernel. The\\nproject's `:test` alias is NOT activated: its `-Xss64m`\\n(`deps.edn:52`) and test-runner main opts play no part. The\\nlatte-kernel git dependency is named explicitly because the `:test`\\nalias, which normally carries it, also carries the test-runner main\\nopts; the git checkout is already cached locally. Verdicts are read\\nfrom the script's printed `:under-ceilings-v2` map, computed by the\\nmaximum rule below. The v2.1 results under this exact declared\\ncommand are recorded in §6.)\\n\\nProcedure, in order:\\n\\n1. **Warmup**: build one retained structure and one full pipeline\\n   pass, DISCARD both, GC-pin. Class loading / JIT are charged to the\\n   warmup, not to measured repetitions.\\n2. **Retained memory**: 5 repetitions per holder variant\\n   (binding-only, then compiled-inclusive). Each repetition builds a\\n   fresh holder held only by a local, samples GC-pinned used heap\\n   (`System/gc()`, 50 ms, `System/gc()`, then\\n   `Runtime.totalMemory − freeMemory`) before and after, uses\\n   `System/identityHashCode` on the holder AFTER the second sample so\\n   it cannot be collected early, and releases it on return. ALL 5\\n   samples per variant are recorded.\\n3. **Peak / pipeline**: 3 pipeline repetitions. A sampler thread\\n   records used heap every 2 ms across lowering → binding /\\n   projection / derives → actual serialization\\n   (`dao.jing/canonical-bytes`) → durable persistence\\n   (`dao.jing/materialize!` of relation and record into a file-backed\\n   `yin.repl.store`, closed) → tagged execution (both C lanes must\\n   reach `:completed`). Peak, per-repetition elapsed time, and\\n   serialized byte counts are recorded per repetition.\\n4. **Pass/fail is MAXIMUM-based** (r5 F6 fix): a ceiling is met only\\n   if the MAXIMUM observed value is at or under it — retained memory:\\n   max of the 5 compiled-inclusive samples ≤ 12,000,000 B (the\\n   binding-only samples are reported, and also max-checked against\\n   the same aggregate ceiling for information); storage: max per\\n   artifact and max aggregate ≤ their ceilings; peak heap: max peak\\n   over the 3 repetitions ≤ 1 GiB; time: max elapsed ≤ 10,000 ms.\\n   Any single sample over its ceiling = EXCEEDED. Medians are\\n   printed for information only and never establish compliance.\\n\\nSampling limitations (named, not hidden): retained and peak figures\\nare process-wide JVM used-heap values, not an object-graph census;\\n`System/gc()` is a hint the JVM honored observably here, not a\\nguarantee; 2 ms peak sampling can miss sub-2 ms transients; figures\\nare comparable only on this host/JVM class and only for the named\\nholder scope; times are warm-JVM (the discarded warmup precedes all\\nmeasured repetitions).\\n\\n## 5. Superseded run: failed status preserved\\n\\nThe r2/r4 bounded run (8,000,000 B aggregate retained ceiling,\\nmedian-based accounting in its r4 record) **FAILED and remains\\nfailed**. Its exceedances, restated with maximum-based accounting:\\n\\n- compiled-inclusive holder: samples 9,008,912 / 8,939,024 /\\n  8,826,416 B — every sample over the 8,000,000 B ceiling.\\n  **EXCEEDED.**\\n- binding-only holder: samples 7,960,192 / 7,921,728 / 8,044,024 B —\\n  the 8,044,024 B sample is over the 8,000,000 B ceiling, so under\\n  the corrected maximum rule this holder is **EXCEEDED** too (its r4\\n  \\\"under (99.5%)\\\" median label is corrected in r5; the samples\\n  themselves are unchanged).\\n\\nNothing in this v2 declaration relabels that run successful, raises\\nits ceiling retroactively, or shrinks its fixture. The v2 run below\\nis a separate, new run under the ceilings in §3; its results are\\nrecorded in the r5 findings, not back-written into the superseded\\nrun's record.\\n\\n## 6. Exact pin and v2.1 re-measurement under the corrected declared settings (r6, V2)\\n\\nPin (computed 2026-11-11 after the final r6 code edit; nothing in\\nthe measured patch changed afterwards — the digest was re-verified\\nidentical after the diagnostic-script runs and lint):\\n\\n- Ten-file tracked diff (`git diff`, +1651/−98):\\n  `src/cljc/yin/repl.cljc`, `src/cljc/yin/vm/linker/publish.cljc`,\\n  `src/cljc/yin/vm/semantic/derive.cljc`,\\n  `src/cljc/yin/vm/semantic/linearize.cljc`,\\n  `test/d2_wedge_min_repro.clj`, `test/d2_wedge_probe2.clj`,\\n  `test/yang/clojure_callsite_test.cljc`,\\n  `test/yang/latte_oracle_test.clj`,\\n  `test/yin/vm/semantic/derive_test.cljc`,\\n  `test/yin/vm/semantic/linearize_test.cljc`.\\n  SHA-256 of `git diff` output:\\n  `05076f51add1a5b5285c62c6b85c7eb8875d7c2780a7b33613e46742a250887d`.\\n- Measurement script SHA-256:\\n  `345b432dace388ce20bb463d2241c650b400b644b5194cd0ddae1a3fb42b37c8`.\\n- This declaration and the findings are untracked collab files and\\n  are not part of the `git diff` digest. Nothing is committed.\\n\\nV2.1 run: the §4 command exactly as now declared (with\\n`:jvm-opts [\\\"-Xss64m\\\"]` supplied by `:f6`), 2026-11-11, warm JVM,\\nthis host/JVM; run scope\\n`cc3-f6-measure-v2-326ca2ee-2f81-4711-9377-42cd2c62e080`;\\nafter-release GC-used heap 39,226,944 B; both C lanes `:completed`\\nin all 3 pipeline repetitions; the run's `/tmp/cc3-f6-store-*` file\\nstores were removed afterwards. All samples recorded; verdicts are\\nmaximum-based (§4 rule):\\n\\n| Quantity | V2.1 samples (all recorded) | Maximum | Ceiling (§3) | Verdict (max rule) |\\n|---|---|---|---|---|\\n| Retained: compiled-inclusive holder (acceptance) | 8,828,592 / 8,832,864 / 8,888,424 / 8,829,928 / 8,924,640 B | 8,924,640 B | 12,000,000 B | PASS (74.4% of ceiling) |\\n| Retained: binding-only holder (informational) | 8,203,464 / 7,920,344 / 7,918,160 / 8,014,944 / 7,923,464 B | 8,203,464 B | 12,000,000 B | under (informational; not the acceptance holder) |\\n| Storage: rows canonical bytes | 312,886 B ×3 | 312,886 B | 2,000,000 B | PASS |\\n| Storage: relation canonical bytes | 856,315 B ×3 | 856,315 B | 2,000,000 B | PASS |\\n| Storage: durable record canonical bytes | 544 B ×3 | 544 B | — (in aggregate) | — |\\n| Storage: aggregate retained set | 1,169,745 B ×3 | 1,169,745 B | 4,000,000 B | PASS |\\n| Peak used heap (2 ms sampling) | 251,948,768 / 272,026,880 / 263,341,656 B | 272,026,880 B | 1,073,741,824 B | PASS |\\n| Pipeline elapsed | 772 / 769 / 743 ms | 772 ms | 10,000 ms | PASS |\\n\\nThe script's printed `:under-ceilings-v2` map was all-true. The\\nv2.1 figures sit beside the v2 (r5) figures (compiled-inclusive max\\n8,931,952 B without `-Xss64m`; v2.1 max 8,924,640 B with it) — the\\nceiling holds under both stack settings, which is why §1 records\\n`-Xss64m` as declared parity/headroom rather than a requirement.\\nSerialized sizes are unchanged from v2 (the measurement fixture's\\nadmission scope is the script's own run scope in both runs).\\n  `:*-median-informational` and never establish compliance.\\n- The superseded run's table is corrected honestly: in the r4\\n  findings, the binding-only holder's verdict now reads EXCEEDED\\n  (the 8,044,024 B sample is over the 8,000,000 B ceiling; the r4\\n  median-based \\\"under (99.5%)\\\" label was wrong). Its samples are\\n  unchanged, and the compiled-inclusive holder remains EXCEEDED.\\n  The superseded run stays FAILED — see the v2 declaration §5.\\n\\n## Item 3 — NEW versioned bounded run (ruling (c)) — DECLARED AND RUN\\n\\nDeclaration (written BEFORE the v2 run):\\n`collab/yang-clojure/1794390804000-cc3-bounded-run-declaration-v2.md`\\n(worktree mirror) — pinned corpus/revision and host/JVM settings;\\nretained object set INCLUDING the compiled input and the binding's\\nreconstruction evidence (correspondence, stamped trees/rows/paths),\\nmaximum simultaneously retained fixtures = 1; separate finite\\nceilings — storage 2,000,000 B per artifact and 4,000,000 B\\naggregate, retained memory **12,000,000 B** (above the pilot\\ncompiled-inclusive maximum 9,008,912 B by +33.2% stated headroom;\\n+34.2% over its 8,939,024 B median; the pilot binding-only maximum\\n8,044,024 B also clears it by +49.2%), peak heap 1,073,741,824 B,\\ntime 10,000 ms per pipeline repetition, guest instructions / trace\\nrecords 4,000,000 / 1,000,000 restated not raised; the exact\\nreproducible procedure (compiled-inclusive acceptance variant, 5\\nretained repetitions per variant, 3 pipeline repetitions, 2 ms peak\\nsampling, sampling limitations, maximum-based pass/fail); and the\\nsuperseded run's failed status and both exceedances, without\\nrelabelling it successful.\\n\\nV2 measurement results (2026-11-11, warm JVM, this host/JVM; run\\nscope `cc3-f6-measure-v2-ce2fe8c8-2562-4b4a-9326-e51ac82c74e9`; run\\ncommand in the declaration §4; both C lanes `:completed` in all 3\\npipeline repetitions; after-release GC-used heap 39,313,800 B):\\n\\n| Quantity | V2 samples (all recorded) | Maximum | V2 ceiling | Verdict (max rule) |\\n|---|---|---|---|---|\\n| Retained: compiled-inclusive holder (acceptance) | 8,913,176 / 8,839,920 / 8,931,952 / 8,825,592 / 8,877,128 B | 8,931,952 B | 12,000,000 B | PASS (74.4% of ceiling) |\\n| Retained: binding-only holder (informational) | 8,274,760 / 7,918,496 / 7,918,208 / 7,933,840 / 7,968,320 B | 8,274,760 B | 12,000,000 B | under (informational; not the acceptance holder) |\\n| Storage: rows canonical bytes | 312,886 B ×3 | 312,886 B | 2,000,000 B | PASS |\\n| Storage: relation canonical bytes | 856,315 B ×3 | 856,315 B | 2,000,000 B | PASS |\\n| Storage: durable record canonical bytes | 544 B ×3 | 544 B | — (in aggregate) | — |\\n| Storage: aggregate retained set | 1,169,745 B ×3 | 1,169,745 B | 4,000,000 B | PASS |\\n| Peak used heap (2 ms sampling) | 253,908,344 / 283,147,736 / 259,288,088 B | 283,147,736 B | 1,073,741,824 B | PASS |\\n| Pipeline elapsed | 820 / 873 / 849 ms | 873 ms | 10,000 ms | PASS |\\n\\nNotes: v2 serialized sizes exceed the r4 pilot's (rows 293,924 →\\n312,886 B; relation 802,260 → 856,315 B) because admission origins\\nnow carry the longer r5 run-scope strings — inside the declared\\nheadroom and recorded, not hidden. Retained-memory method limits are\\nunchanged (process-wide used-heap delta, GC-pinned, warm JVM; an\\norder-of-magnitude claim comparable only on this host/JVM class,\\nnever an object-graph census; 2 ms sampling can miss sub-2 ms\\ntransients). The `/tmp/cc3-f6-store-*` file stores from this run\\nwere removed after the run.\\n\\n## Red-first evidence\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat test/yang/latte_oracle/unfold_implicit.edn; sed -n '95,145p' test/yang/latte_oracle/context.edn; sed -n '1300,1355p;600,690p' test/yang/latte_oracle_test.clj; rg -n 'unfold-implicit|host-constant' test/yang/latte_oracle_test.clj | head -45; git log --oneline --all --grep='cc3' | head -20\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat test/yang/latte_oracle/unfold_implicit.edn; sed -n '95,145p' test/yang/latte_oracle/context.edn; sed -n '1300,1355p;600,690p' test/yang/latte_oracle_test.clj; rg -n 'unfold-implicit|host-constant' test/yang/latte_oracle_test.clj | head -45; git log --oneline --all --grep='cc3' | head -20\\\"\",\"aggregated_output\":\";; B-leg adaptation of latte-kernel.typing/unfold-implicit (typing.cljc:453, the\\n;; one try in the corpus). It is NOT compiled from upstream source: the manifest\\n;; marks it as explicitly adapted. The catch is replaced by the outcome model:\\n;; the implicit function is a guest closure applied to the argument vector, its\\n;; error outcome is consumed here (yin.k/outcome-of is the raw call, not\\n;; unwrapped at the call site), and the :ko result merges the error's data\\n;; over :implicit and :msg in upstream's order (the data wins). The upstream\\n;; def-env and ctx parameters only reach type-of-implicit-args and\\n;; call-implicit, so this fixture takes the implicit definition and the\\n;; already-typed arguments.\\n(defn unfold-implicit\\n  [implicit-def args]\\n  (let [outcome (yin.k/outcome-of ((:fn implicit-def) args))]\\n    (if (= :yin.k/error (first outcome))\\n      [:ko (conj {:implicit (:name implicit-def)\\n                  :msg (:yin.k/message (second outcome))}\\n                 (:yin.k/data (second outcome)))\\n       nil]\\n      [:ok (second outcome) args])))\\n       (throw (ex-info \\\"No such unparser.\\\" {:ident ident})))\\n     (assoc kernel :unparser-registry\\n            {:fundamental (into [] (remove (fn [x] (= x ident)) (:fundamental registry)))\\n             :standard (into [] (remove (fn [x] (= x ident)) (:standard registry)))\\n             :user (into [] (remove (fn [x] (= x ident)) (:standard registry)))\\n             :unparsers (data/dissoc (:unparsers registry) ident)})))\\n (defn register-unparser\\n   ([kernel ident unparser] (register-unparser kernel :user ident unparser))\\n   ([kernel category ident unparser]\\n    (let [kernel (if (lookup-in kernel [:unparser-registry :unparsers ident])\\n                   (unregister-unparser kernel ident) kernel)\\n          registry (:unparser-registry kernel)]\\n      (when (not (contains? #{:fundamental :standard :user} category))\\n        (throw (ex-info \\\"Wrong unparser category.\\\" {:category category})))\\n      (assoc kernel :unparser-registry\\n             (assoc registry category (conj (get registry category) ident)\\n                    :unparsers (assoc (:unparsers registry) ident unparser))))))\\n (defn unparser-order [kernel]\\n   (let [registry (:unparser-registry kernel)]\\n     (concat (:fundamental registry) (:standard registry) (:user registry))))\\n ;; Same typed-argument boundary as the slice-5 catch adaptation, now with\\n ;; the real record field and calling convention (def-env ctx & typed-args).\\n (defn unfold-typed-implicit [kernel ctx implicit-def targs args]\\n   (let [outcome (yin.k/outcome-of (apply (:implicit-fn implicit-def) kernel ctx targs))]\\n     (if (= :yin.k/error (first outcome))\\n       [:ko (merge {:implicit (:name implicit-def) :msg (:yin.k/message (second outcome))}\\n                   (:yin.k/data (second outcome))) nil]\\n       [:ok (second outcome) args])))\\n ;; These are the state/diagnostic arms of proof/elab-proof-step. The full\\n ;; parsing/typing arms belong to slice 9; unsupported steps fail explicitly.\\n ;; The updated context occupies the original def-env slot in :cont, so the\\n ;; existing proof loop passes it to all subsequent steps.\\n (defn elab-proof-step [kernel ctx var-deps def-uses step args]\\n   (case step\\n     :opaque [:cont [(elab-opaque kernel args) ctx var-deps def-uses]]\\n     :transparent [:cont [(elab-transparent kernel args) ctx var-deps def-uses]]\\n     (:print-term :print-type :print-def :print-defenv)\\n     [:cont [kernel ctx var-deps def-uses]]\\n     (throw (ex-info \\\"Unsupported context proof step\\\" {:step step :args args}))))]\\n  (testing \\\"norm and nbe delta-reduction: No such definition\\\"\\n    (doseq [[qsym ns-sym args] [['latte-kernel.nbe/delta-reduction 'latte_kernel.nbe\\n                                 ['[{} {}] [] '(no-such-definition-xyz)]]\\n                                ['latte-kernel.norm/delta-reduction 'latte_kernel.norm\\n                                 ['[{} {}] [] '(no-such-definition-xyz)]]]\\n            :let [[a c] (ab qsym ns-sym\\n                            [['latte_kernel.defenv 'fetch-definition]\\n                             ['latte_kernel.syntax 'ref?]\\n                             'delta-reduction]\\n                            args)]]\\n      (is (= \\\"No such definition\\\" (get-in a [:thrown :message])) (str qsym))\\n      (is (= :yin.k/error (first c))))))\\n\\n\\n;; =============================================================================\\n;; Slice 5: unfold-implicit, adapted from typing.cljc:453\\n;; =============================================================================\\n\\n(def ^:private unfold-implicit-adaptation\\n  \\\"The checked-in B-leg source of `typing/unfold-implicit`\\n   (test/yang/latte_oracle/unfold_implicit.edn).\\\"\\n  (edn/read-string (slurp (io/resource \\\"yang/latte_oracle/unfold_implicit.edn\\\"))))\\n\\n\\n(defn- upstream-unfold\\n  \\\"The upstream catch shape over a host implicit fn.\\\"\\n  [implicit-def args]\\n  (try [:ok ((:fn implicit-def) args) args]\\n       (catch clojure.lang.ExceptionInfo e\\n         [:ko (merge {:implicit (:name implicit-def), :msg (ex-message e)} (ex-data e)) nil])))\\n\\n\\n(deftest test-oracle-slice5-unfold-implicit\\n  (let [b-leg (fn [fn-form args]\\n                (run-outcome [(list 'def 'impl {:name ''imp, :fn fn-form})\\n                              unfold-implicit-adaptation]\\n                             (list 'unfold-implicit 'impl (list 'quote args))))\\n        ok-form '(fn [args] (first args))\\n        a-ok {:name 'imp, :fn first}\\n        a-throw {:name 'imp, :fn (fn [_] (throw (ex-info \\\"implicit failed\\\" {:msg \\\"data wins\\\" :extra 1})))}\\n        throw-form '(fn [args] (throw (ex-info \\\"implicit failed\\\" {:msg \\\"data wins\\\", :extra 1})))]\\n    (testing \\\"success: [:ok value args]\\\"\\n      (is (= (upstream-unfold a-ok '[7 8])\\n             (second (b-leg ok-form '[7 8])))))\\n    (testing \\\"failure: error outcome consumed, data overrides :msg, result is [:ko ... nil]\\\"\\n      (is (= (upstream-unfold a-throw '[7])\\n             (second (b-leg throw-form '[7]))))\\n      (is (= [:ko {:implicit 'imp, :msg \\\"data wins\\\", :extra 1} nil]\\n             (second (b-leg throw-form '[7])))))))\\n\\n\\n;; =============================================================================\\n;; Slice 5: the throw-site inventory\\n;; =============================================================================\\n\\n(defn- throw-forms\\n  [form]\\n  (filter #(and (seq? %) (= 'throw (first %))) (tree-seq coll? seq form)))\\n\\n\\n(defn- throw-symbol-count\\n  \\\"Every `throw` symbol in the manifest's top-level forms.\\\"\\n  []\\n  (count (for [{:keys [ns name]} manifest\\n               s (tree-seq coll? seq (get top-forms [ns name]))\\n               :when (= 'throw s)]\\n           s)))\\n\\n\\n(def ^:private fixture-sites\\n  \\\"[ns fn message-fragment] of the sites slice 5 fixes with an A/B fixture.\\\"\\n  #{['latte_kernel.utils 'safe-get \\\"No such value\\\"]\\n    ['latte_kernel.utils 'zip \\\"odd number\\\"]\\n    ['latte_kernel.defenv 'fetch-definition \\\"Cannot fetch\\\"]\\n    ['latte_kernel.norm 'delta-reduction \\\"No such definition\\\"]\\n    ['latte_kernel.nbe 'delta-reduction \\\"No such definition\\\"]})\\n\\n\\n(defn- disposition\\n  [ns-sym fname message]\\n  (if (some (fn [[n f frag]]\\n              (and (= n ns-sym) (= f fname) message (str/includes? message frag)))\\n            fixture-sites)\\n    {:disposition :fixture}\\n    {:disposition :deferred\\n     :to (str \\\"the slice that admits \\\" ns-sym \\\"/\\\" fname)}))\\n\\n\\n(defn- throw-site-rows\\n  []\\n  (vec (for [{:keys [ns name]} manifest\\n        ast (yang/compile-program (into (yang/library-for forms) forms) true arg-vector-opts)\\n        modules (oracle-registry yang/kind-module)\\n        run-bounded (fn [machine]\\n                      (loop [m machine n 0]\\n                        (cond\\n                          (vm/halted? m) (vm/value m)\\n                          (= n 1000000)\\n                          (throw (ex-info \\\"Context execution budget exhausted\\\" {:steps n}))\\n                          :else (recur (vm/step m) (inc n)))))]\\n    (is (vm/plain-data? context-source) \\\"adaptation is plain code data\\\")\\n    (is (vm/plain-data? ast) \\\"runtime closures are never embedded as literals\\\")\\n    (testing \\\"code rows round-trip and reconstruct the closure registry on both lanes\\\"\\n      (let [[_root datoms] (vm/ast->datoms-with-root ast)\\n            rebuilt (vm/datoms->ast (cbor/decode (cbor/encode datoms)))]\\n        (doseq [lane [:walker :semantic]]\\n          (is (= [:yin.k/ok 7] (compiler-test/run-guest-ast rebuilt modules lane 1000000))))))\\n    (testing \\\"a live registry with a captured guest closure survives UCF reconstruction\\\"\\n      (let [code (vm/ast->semantic-bytecode ast)\\n            bytecode (:vector (linearize/project-rows code))\\n            source-index {(ucf/code-address bytecode) #{(:root code)}}\\n            machine (semantic/load-vector (rows-support/new-machine {:modules modules})\\n                                          bytecode vm/semantic-contract)\\n            checkpoint (loop [m machine n 0]\\n                         (cond\\n                           (get-in m [:env 'checkpoint]) m\\n                           (or (vm/halted? m) (= n 1000000))\\n                           (throw (ex-info \\\"Context checkpoint was not reached\\\" {:steps n}))\\n                           :else (recur (vm/step m) (inc n))))\\n            k (get-in checkpoint [:env 'checkpoint])\\n            _ (is (values/closure? (get-in k [:unparser-registry :unparsers :captured\\n                                              :yang.call/entry])))\\n            _ (assert-machine-data-within-budget! k 100000)\\n            wire (rows/lift-task checkpoint (rows-support/serve-table) {:source-index source-index})\\n            _ (is (vm/plain-data? wire) \\\"serialized context contains code references, not host closures\\\")\\n            {:keys [attach!]} (rows-support/attacher)\\n            restored (rows/lower-task (rows-support/new-machine {:modules modules})\\n                                      (cbor/decode (cbor/encode wire)) attach!)\\n            k' (get-in restored [:env 'checkpoint])]\\n        (is (values/closure? (get-in k' [:unparser-registry :unparsers :captured\\n                                         :yang.call/entry])))\\n        (assert-machine-data-within-budget! k' 100000)\\n        (is (= [:yin.k/ok 7] (run-bounded restored)))\\n        (is (= [:yin.k/ok 7] (run-bounded checkpoint))))))\\n  (testing \\\"host callbacks cannot enter code data through registry literals\\\"\\n    (is (thrown? Exception\\n          (encoder/project\\n            (encoder/source-envelope\\n              :program \\\"slice8-host-callback-refusal\\\"\\n              [{:type :literal :value {:unparser-registry {:unparsers {:bad identity}}}}]))))))\\n\\n\\n(deftest test-oracle-slice8-admission\\n  (let [symbols (set (filter symbol? (tree-seq coll? seq context-forms)))\\n        ambient '#{atom swap! reset! deref clojure.core/deref resolve var? alter-var-root\\n                   defrecord println print pprint pp/pprint nano-time System/nanoTime}]\\n    (is (empty? (filter symbols ambient)) \\\"context source has no ambient state, host lookup or diagnostics\\\")\\n352:      ;; ::prestx/host-constant must resolve through the real alias\\n353:      (is (contains? (set kws) :latte-kernel.presyntax/host-constant))\\n6