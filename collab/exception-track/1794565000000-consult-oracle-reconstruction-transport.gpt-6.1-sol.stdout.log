{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/clojure.cljc | sed -n '837,982p;1170,1235p;2195,2265p;2408,2473p'\"","aggregated_output":"   837\t\n   838\t;; =============================================================================\n   839\t;; The continuation lane (slice 5, ported off the outcome model)\n   840\t;; =============================================================================\n   841\t;;\n   842\t;; Opted in with `:outcomes true` beside the argument-vector convention (the\n   843\t;; flag now selects the continuation lane, not the retired outcome tuples).\n   844\t;; Guest functions return plain values; `throw` lowers to `clj/throw`, `try`\n   845\t;; to `clj/try`/`clj/try-finally` (the `%capture` handler-stack family), and a\n   846\t;; guest call delivers an escaping condition through the §8.10.7 raise exit.\n   847\t;; The public entry installs the same bridge before argument binding. Only the\n   848\t;; `compile-program` boundary still wraps the program in `[:yin.k/ok value]` /\n   849\t;; `[:yin.k/error raised]` for the harness. `ex-info` becomes a portable map\n   850\t;; under namespaced keys, `ex-message`/`ex-data` its accessors. Generated names\n   851\t;; carry the reserved `dsg__` prefix; the program pre-pass keeps user code out\n   852\t;; of that prefix. A macro call is opaque to the pass: the expander owns it.\n   853\t\n   854\t(def ^:private ok-tag :yin.k/ok)\n   855\t\n   856\t(def ^:private error-tag :yin.k/error)\n   857\t\n   858\t\n   859\t(defn- outcomes?\n   860\t  [env]\n   861\t  (some? (::outcomes env)))\n   862\t\n   863\t\n   864\t(defn- rebuild\n   865\t  \"A list of `items` carrying the reader metadata of `form`.\"\n   866\t  [form items]\n   867\t  (let [out (apply list items)]\n   868\t    (if-let [m (meta form)]\n   869\t      (with-meta out m)\n   870\t      out)))\n   871\t\n   872\t\n   873\t;; =============================================================================\n   874\t;; The clj continuation family (R3 §8.10.7; the (B) port)\n   875\t;; =============================================================================\n   876\t;;\n   877\t;; The port converges clojure's exception lowering onto the continuation\n   878\t;; encoding: a `%capture` handler stack in a dynamic-context cell, exactly\n   879\t;; like the py/ts/php preludes (`yang.clojure.prelude` carries the reference\n   880\t;; implementation under `clj/`). A source `(throw e)` lowers to `clj/throw`,\n   881\t;; `(try ...)` to `clj/try`/`clj/try-finally`, and function bodies return\n   882\t;; plain values. A guest call delivers a callee's escaping condition through\n   883\t;; the §8.10.7 raise exit, and the public entry installs the same bridge.\n   884\t;; Ordinary thrown values remain raw; protocol conditions travel in a\n   885\t;; provenance carrier. `compile-program` emits this family\n   886\t;; inline (the linked runtime binds the same family from the prelude); it\n   887\t;; routes the capture-sensitive primitives through the `dsg__*` helpers so a\n   888\t;; program definition of `get`/`assoc`/`=` cannot capture a frame access.\n   889\t\n   890\t(def ^:private continuation-family\n   891\t  \"The `clj/` continuation family, `[key form]` in prelude notation (each\n   892\t   form is read with `u/sexp->uast`). Mirrors `yang.clojure.prelude`'s\n   893\t   escapes section, minus `call-ec`/`unwind-to` (clojure has no\n   894\t   break/continue/return escapes). The handler stack is a chain of frames\n   895\t   [tag payload rest n]; a `:handler` frame holds the continuation\n   896\t   `clj/raise` delivers to, a `:finally` frame a one-argument thunk every\n   897\t   exit through it runs.\"\n   898\t  '[[clj/ctx (fn [hs] (dsg__assoc {} :handlers hs))]\n   899\t    [clj/handlers (fn [] (dsg__get (cell/get clj.rt/ctx) :handlers))]\n   900\t    [clj/set-handlers!\n   901\t     (fn [hs]\n   902\t       (cell/set! clj.rt/ctx (dsg__assoc (cell/get clj.rt/ctx) :handlers hs)))]\n   903\t    [clj/restore! (fn [saved] (cell/set! clj.rt/ctx saved))]\n   904\t    [clj/frame-depth (fn [hs] (if (dsg__equal hs nil) 0 (dsg__get hs 3)))]\n   905\t    [clj/frame\n   906\t     (fn [tag payload rest]\n   907\t       (conj (conj (conj (conj [] tag) payload) rest)\n   908\t             (+ 1 (clj/frame-depth rest))))]\n   909\t    [clj/pop-frame\n   910\t     (fn [hs]\n   911\t       (cell/set! clj.rt/ctx\n   912\t                  (dsg__assoc (cell/get clj.rt/ctx) :handlers (dsg__get hs 2))))]\n   913\t    [clj/raise\n   914\t     (fn [e]\n   915\t       (let [hs (clj/handlers)]\n   916\t         (if (dsg__equal hs nil)\n   917\t           (dsg__get e :clj/no-handler)\n   918\t           (if (dsg__equal (dsg__get hs 0) :finally)\n   919\t             (do (clj/pop-frame hs) ((dsg__get hs 1) e) (clj/raise e))\n   920\t             ((dsg__get hs 1) e)))))]\n   921\t    [clj/throw (fn [e] (clj/raise e))]\n   922\t    [clj/try\n   923\t     (fn [body handler]\n   924\t       (let [saved (cell/get clj.rt/ctx)\n   925\t             flag (cell/new :first)]\n   926\t         ((fn [r]\n   927\t            (if (dsg__equal (cell/get flag) :first)\n   928\t              (do (cell/set! flag :re-entered)\n   929\t                  (clj/set-handlers! (clj/frame :handler r (dsg__get saved :handlers)))\n   930\t                  (let [v (body)] (do (clj/restore! saved) v)))\n   931\t              (do (clj/restore! saved) (handler r))))\n   932\t          (%capture))))]\n   933\t    [clj/try-finally\n   934\t     (fn [body fin]\n   935\t       (let [saved (cell/get clj.rt/ctx)]\n   936\t         (do (clj/set-handlers! (clj/frame :finally fin (dsg__get saved :handlers)))\n   937\t             (let [v (body)]\n   938\t               (do (clj/restore! saved) (fin nil) v)))))]])\n   939\t\n   940\t\n   941\t(def ^:private ex-message-form\n   942\t  '(fn [dsg__value] (dsg__get dsg__value :yin.k/message)))\n   943\t\n   944\t\n   945\t(def ^:private ex-data-form\n   946\t  '(fn [dsg__value] (dsg__get dsg__value :yin.k/data)))\n   947\t\n   948\t\n   949\t(def ^:private continuation-uast\n   950\t  \"The continuation family tree: define every `clj/` entry (store-defined,\n   951\t   like `yang.core.call/uast`) then allocate the `clj.rt/ctx` cell. The\n   952\t   family's capture-sensitive primitives are the `dsg__*` names, bound at\n   953\t   emission by `compile-program`.\"\n   954\t  (u/then\n   955\t    (reduce (fn [ast [key form]]\n   956\t              (u/then ast (u/def! key (u/sexp->uast form))))\n   957\t            (u/lit nil)\n   958\t            continuation-family)\n   959\t    (u/def! 'clj.rt/ctx\n   960\t            (u/app (u/v 'cell/new) (u/app (u/v 'clj/ctx) (u/lit nil))))))\n   961\t\n   962\t\n   963\t(def continuation-family-names\n   964\t  \"The `clj/` continuation-family store definitions `compile-program` emits\n   965\t   inline (plus the `clj.rt/ctx` cell): compiler-bound names an admission scan\n   966\t   must accept, like the preamble's `dsg__*` helpers. Exposed so a harness\n   967\t   admission check stays in sync with the family instead of hardcoding it.\"\n   968\t  (into #{'clj.rt/ctx} (map first continuation-family)))\n   969\t\n   970\t\n   971\t(defn- rewrite-ex-info\n   972\t  \"(ex-info msg data cause?) as the portable map holding its parts. The\n   973\t   accessors read through the generated exception wrapper: a retained\n   974\t   condition's wrapper carries the original payload privately, so\n   975\t   (ex-message e)/(ex-data e) answer the payload's parts while a plain\n   976\t   value still answers by keyword lookup.\"\n   977\t  [form]\n   978\t  (cond\n   979\t    (seq? form)\n   980\t    (cond\n   981\t      (empty? form) form\n   982\t      (= 'quote (first form)) form\n  1170\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n  1171\t\n  1172\t\n  1173\t(defn- call-entry\n  1174\t  \"The unary public entry, closed over a private argument-vector body. It\n  1175\t   installs the exception bridge (`clj/try`) before argument binding, so an\n  1176\t   escaping raise forwards an authenticated condition or wraps an ordinary\n  1177\t   value as `:yang.call/thrown` exactly once after cleanup.\"\n  1178\t  []\n  1179\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1180\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1181\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1182\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1183\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1184\t        binding-error (u/app\n  1185\t                        (u/v 'clj/throw)\n  1186\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1187\t                               (u/lit :yin.k/message)\n  1188\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1189\t                               (u/lit :yin.k/data)\n  1190\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1191\t                                      (u/lit :yang.call/named) named)))\n  1192\t        forged-refusal (u/app\n  1193\t                         (u/v 'clj/throw)\n  1194\t                         (u/lit {:yin.k/message\n  1195\t                                 \"Invocation is neither an authenticated packet nor an invocation record\"\n  1196\t                                 :yin.k/data {}}))\n  1197\t        ;; The record path: bind and run the body under clj/try, delivering\n  1198\t        ;; an authenticated condition or a fresh :yang.call/thrown condition.\n  1199\t        entry-body (u/app\n  1200\t                     (u/v 'clj/try)\n  1201\t                     (u/lam [] (u/if-node (u/app (u/v 'dsg__empty) named)\n  1202\t                                          (u/app (u/v body) positional)\n  1203\t                                          binding-error))\n  1204\t                     (u/lam ['dsg__e]\n  1205\t                            (u/let1 'dsg__provenance\n  1206\t                                    (u/app (u/v 'cell/dsg__provenance) (u/v 'dsg__e))\n  1207\t                                    (assoc (u/app raise\n  1208\t                                                  (u/if-node\n  1209\t                                                    (u/app (u/v 'dsg__equal) (u/v 'dsg__provenance) (u/lit nil))\n  1210\t                                                    (u/app (u/v 'yang.call/thrown) (u/v 'dsg__e))\n  1211\t                                                    (u/v 'dsg__provenance))) :tail? true))))\n  1212\t        ;; The private lane forwards the body's plain value in tail position\n  1213\t        ;; (a raise from it propagates to the caller's own handler — the lane\n  1214\t        ;; installs no bridge). The compiler's token packet, a two-element\n  1215\t        ;; vector [token args], selects it on the SAME unary entry. A guest\n  1216\t        ;; cannot forge the token; maps keep the ordinary record path.\n  1217\t        packet (u/if-node\n  1218\t                 (u/app (u/v 'data/vector?) (u/v invocation))\n  1219\t                 (u/if-node\n  1220\t                   (u/app (u/v 'dsg__equal)\n  1221\t                          (u/app (u/v 'data/count) (u/v invocation))\n  1222\t                          (u/lit 2))\n  1223\t                   (u/if-node\n  1224\t                     (u/app (u/v 'dsg__equal)\n  1225\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\n  1226\t                            (u/v 'dsg__call_token))\n  1227\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\n  1228\t                     forged-refusal)\n  1229\t                   forged-refusal)\n  1230\t                 entry-body)\n  1231\t        entry (u/lam [invocation] packet)]\n  1232\t    (u/lam [body] entry)))\n  1233\t\n  1234\t\n  1235\t(defn- admit-call-descriptor\n  2195\t   values, `throw`/`try` onto the continuation family); definitions keep\n  2196\t   their own lowering.\"\n  2197\t  [env macro-env form]\n  2198\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\n  2199\t    form\n  2200\t    (lower-function-body env macro-env [] [form])))\n  2201\t\n  2202\t\n  2203\t(defn- top-boundary\n  2204\t  \"The top-level exception boundary: run `ast` under `clj/try`, answering\n  2205\t   `[:yin.k/ok value]` on normal return and `[:yin.k/error raised]` on a\n  2206\t   raise. The `[:yin.k/ok|error]` wrapper is the harness contract (a linked\n  2207\t   entry's `clj/unwrap-outcome` removes one level); inside it, function\n  2208\t   bodies return plain values and a raise is the only error channel.\"\n  2209\t  [ast]\n  2210\t  (u/app (u/v 'clj/try)\n  2211\t         (u/lam [] (outcome-node ok-tag ast))\n  2212\t         (u/lam ['dsg__e]\n  2213\t                (u/let1 'dsg__p (u/app (u/v 'cell/dsg__provenance) (u/v 'dsg__e))\n  2214\t                        (outcome-node error-tag\n  2215\t                                      (u/if-node (u/app (u/v 'dsg__equal) (u/v 'dsg__p) (u/lit nil))\n  2216\t                                                 (u/v 'dsg__e) (u/v 'dsg__p)))))))\n  2217\t\n  2218\t\n  2219\t(defn compile-program\n  2220\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n  2221\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n  2222\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n  2223\t   with :macro? true on the lambda; the encoder turns that flag into a\n  2224\t   declaration row and the expander, not this compiler, recognizes calls.\n  2225\t   The three-argument form takes `opts` opting into the argument-vector\n  2226\t   convention (see `program-env`); without it the output is the native one.\"\n  2227\t  ([forms] (compile-program forms true))\n  2228\t  ([forms tail?] (compile-program forms tail? nil))\n  2229\t  ([forms tail? opts]\n  2230\t   (run! check-program-symbols! forms)\n  2231\t   (let [env (program-env forms opts)]\n  2232\t     ;; A discarded definition must not become a lexical binding in the\n  2233\t     ;; following definitions. Descriptor entry and body closures both capture\n  2234\t     ;; their environment: retaining the previous descriptor here doubles its\n  2235\t     ;; paths at each definition during machine-data validation and UCF lift.\n  2236\t     (letfn [(discard-result\n  2237\t               [ast]\n  2238\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n  2239\t             (go\n  2240\t               [forms macro-env]\n  2241\t               (if (empty? forms)\n  2242\t                 (compile-literal nil tail?)\n  2243\t                 (let [head       (cond->> (first forms)\n  2244\t                                    (outcomes? env) (lower-top-form env macro-env))\n  2245\t                       rest-forms (rest forms)]\n  2246\t                   (cond\n  2247\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n  2248\t                     ;; lambda the encoder declares; later forms see the name\n  2249\t                     ;; only so the native defn lowering can yield to it.\n  2250\t                     (and (seq? head) (= 'defmacro (first head)))\n  2251\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n  2252\t                       (cond-> {:type     :application\n  2253\t                                :operator {:type :lambda, :params ['_]\n  2254\t                                           :body (go rest-forms\n  2255\t                                                     (assoc macro-env\n  2256\t                                                            (strip-symbol-meta (second head))\n  2257\t                                                            {:type :user}))}\n  2258\t                                :operands [(discard-result defined)]}\n  2259\t                         tail? (assoc :tail? true)))\n  2260\t                     ;; def: sequence with current macro-env\n  2261\t                     (and (seq? head) (= 'def (first head)))\n  2262\t                     (let [[_ name value] head\n  2263\t                           value (if (outcomes? env)\n  2264\t                                   (lower-function-body env macro-env [] [value])\n  2265\t                                   value)]\n  2408\t                                      nil)))))\n  2409\t           ;; The exception accessors and the continuation family. The\n  2410\t           ;; `dsg__ex_message`/`dsg__ex_data` accessors read the portable\n  2411\t           ;; ex-info map; the continuation family (`clj/try`, `clj/throw`,\n  2412\t           ;; `clj/raise`, ...) is the port's `%capture` handler-stack scheme,\n  2413\t           ;; emitted inline (the linked runtime binds the same family from the\n  2414\t           ;; prelude). Its capture-sensitive primitives are the `dsg__*`\n  2415\t           ;; names bound outside it.\n  2416\t           (outcomes? env) (u/let1 'dsg__ex_message\n  2417\t                                   (u/sexp->uast ex-message-form))\n  2418\t           (outcomes? env) (u/let1 'dsg__ex_data\n  2419\t                                   (u/sexp->uast ex-data-form))\n  2420\t           ;; A linked unit shares the required clj module's handler stack.\n  2421\t           ;; Its inline counterpart names the private clj.rt/ctx store key,\n  2422\t           ;; which cannot be read from a different module.\n  2423\t           (and (outcomes? env) (not (:linked-runtime opts))) (u/then\n  2424\t                                                                (discard-result continuation-uast))\n  2425\t           (outcomes? env) (u/then\n  2426\t                             (discard-result\n  2427\t                               (u/app (u/lam '[get = assoc empty?] call/uast)\n  2428\t                                      (u/v 'dsg__get) (u/v 'dsg__equal)\n  2429\t                                      (u/v 'dsg__assoc) (u/v 'dsg__empty))))\n  2430\t           (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\n  2431\t           ;; Guest closures keep captured environments portable: binding host\n  2432\t           ;; primitive values here would make UCF machine-data validation fail.\n  2433\t           ;; These helpers cover generated map lookups/writes and comparisons;\n  2434\t           ;; conj/vec are already protected by the convention's binder checks.\n  2435\t           ;; Evaluate siblings outside each other's bindings to avoid retaining\n  2436\t           ;; a chain of redundant helper environments.\n  2437\t           (outcomes? env) (#(u/app\n  2438\t                               (u/lam '[dsg__get dsg__equal dsg__assoc dsg__empty] %)\n  2439\t                               (if (contains? (::defined env) 'get)\n  2440\t                                 (u/sexp->uast\n  2441\t                                   '(fn [m k]\n  2442\t                                      (if (data/map? m)\n  2443\t                                        (let [find (fn [self entries]\n  2444\t                                                     (if (data/content= 0 (data/count entries))\n  2445\t                                                       nil\n  2446\t                                                       (let [pair (data/nth entries 0)]\n  2447\t                                                         (if (data/content= k (data/nth pair 0))\n  2448\t                                                           (data/nth pair 1)\n  2449\t                                                           (self self (data/subvec entries 1))))))]\n  2450\t                                          (find find (vec m)))\n  2451\t                                        nil)))\n  2452\t                                 (u/sexp->uast '(fn [m k] (get m k))))\n  2453\t                               (u/sexp->uast '(fn [a b] (data/content= a b)))\n  2454\t                               (if (contains? (::defined env) 'assoc)\n  2455\t                                 (u/sexp->uast\n  2456\t                                   '(fn [m k v k2 v2 k3 v3]\n  2457\t                                      (let [one (conj m (conj [] k v))]\n  2458\t                                        (if (data/content= k2 nil)\n  2459\t                                          one\n  2460\t                                          (let [two (conj one (conj [] k2 v2))]\n  2461\t                                            (if (data/content= k3 nil)\n  2462\t                                              two\n  2463\t                                              (conj two (conj [] k3 v3))))))))\n  2464\t                                 (u/sexp->uast\n  2465\t                                   '(fn [m k v k2 v2 k3 v3]\n  2466\t                                      (if (data/content= k2 nil)\n  2467\t                                        (assoc m k v)\n  2468\t                                        (if (data/content= k3 nil)\n  2469\t                                          (assoc m k v k2 v2)\n  2470\t                                          (assoc m k v k2 v2 k3 v3))))))\n  2471\t                               (u/sexp->uast '(fn [xs] (data/content= 0 (data/count xs))))))\n  2472\t           (outcomes? env) tails/remark-tails))))))\n  2473\t\n","exit_code":0,"status":"completed"}}
