m.provenance/stack\\\\n+                                             (mapv (fn [row]\\\\n+                                                     (assoc row 0 h-address))\\\\n+                                                   (:call-provenance stack-full))\\\\n+                                             :yin.vm.provenance/register\\\\n+                                             (mapv (fn [row]\\\\n+                                                     (assoc row 0 r-address))\\\\n+                                                   (:call-provenance register-full))})\\\\n                                record {:yang.call-site/schema 1\\\\n                                        :yang.call-site/manifest address\\\\n                                        :yang.call-site/root (:root tree)\\\\n                                        :yang.call-site/origin (:origin claim)\\\\n-                                       :yang.call-site/table table}]\\\\n+                                       :yang.call-site/table table\\\\n+                                       :yang.call-site/provenance provenance}]\\\\n                            {:record (jing/materialize! handle record)\\\\n                             :table table\\\\n+                            :provenance provenance\\\\n                             :origin (:origin claim)\\\\n                             :root (:root tree)\\\\n                             :manifest address}))\\\\n@@ -493,6 +533,53 @@\\\\n                     :tree tree}))))))))))\\\\n \\\\n \\\\n+(defn published-instruction-provenance\\\\n+  \\\\\\\"The durable instruction provenance a C1-claiming publication\\\\n+   persisted beside its manifest (cc3 item 3): `{:root r :semantic\\\\n+   [[segment pc origin root path] …] :stack […] :register […]}` with\\\\n+   one row per call instruction of each image, every key a claimed\\\\n+   occurrence of the module's tree — or nil when no record verifies\\\\n+   or the publication claimed no C1 (legacy unannotated publications\\\\n+   persist none and remain fully loadable). Accepts the\\\\n+   `publish-module!` result map or the publication record's address,\\\\n+   held to the same manifest/root linkage as\\\\n+   `published-call-site-table`. The relation lives OUTSIDE the\\\\n+   schema-1 manifest hash: the record names it, the manifest never\\\\n+   names the record.\\\\\\\"\\\\n+  ([handle record-or-result]\\\\n+   (if (map? record-or-result)\\\\n+     (published-instruction-provenance handle\\\\n+                                       (:address record-or-result)\\\\n+                                       (get-in record-or-result\\\\n+                                               [:call-sites :record]))\\\\n+     (published-instruction-provenance handle nil record-or-result)))\\\\n+  ([handle manifest-address record-address]\\\\n+   (when (jing/segment-address? record-address)\\\\n+     (let [record (jing/get handle record-address nil)]\\\\n+       (when (and (map? record)\\\\n+                  (= 1 (:yang.call-site/schema record))\\\\n+                  (jing/segment-address? (:yang.call-site/manifest record))\\\\n+                  (or (nil? manifest-address)\\\\n+                      (= manifest-address (:yang.call-site/manifest record)))\\\\n+                  (jing/segment-address? (:yang.call-site/provenance record)))\\\\n+         (let [manifest (jing/get handle\\\\n+                                  (:yang.call-site/manifest record) nil)]\\\\n+           (when (and (map? manifest)\\\\n+                      (= (:yang.call-site/root record)\\\\n+                         (:yin.module/tree manifest)))\\\\n+             (let [relation (jing/get handle\\\\n+                                      (:yang.call-site/provenance record)\\\\n+                                      nil)]\\\\n+               (when (and (map? relation)\\\\n+                          (= 1 (:yin.vm.provenance/schema relation))\\\\n+                          (= (:yang.call-site/root record)\\\\n+                             (:yin.vm.provenance/root relation)))\\\\n+                 {:root (:yin.vm.provenance/root relation)\\\\n+                  :semantic (:yin.vm.provenance/semantic relation)\\\\n+                  :stack (:yin.vm.provenance/stack relation)\\\\n+                  :register (:yin.vm.provenance/register relation)})))))))))\\\\n+\\\\n+\\\\n ;; =============================================================================\\\\n ;; Deriving a module from indexed code (5.3)\\\\n ;; =============================================================================\\\\ndiff --git a/src/cljc/yin/vm/semantic/derive.cljc b/src/cljc/yin/vm/semantic/derive.cljc\\\\nindex dec0816c..7899e90c 100644\\\\n--- a/src/cljc/yin/vm/semantic/derive.cljc\\\\n+++ b/src/cljc/yin/vm/semantic/derive.cljc\\\\n@@ -57,12 +57,45 @@\\\\n           v)))\\\\n \\\\n \\\\n+(defn- call-key-map\\\\n+  \\\\\\\"The `{semantic-pc [origin root path]}` map a `:call-provenance`\\\\n+   relation (`linearize/project-rows`' rows) names over vector `v` —\\\\n+   cc3 item 2. A row naming a pc that holds no `:call` in `v` refuses:\\\\n+   native provenance is reconstructed through each format's own PC\\\\n+   derivation, never assumed from PC equality across formats.\\\\\\\"\\\\n+  [v call-provenance]\\\\n+  (reduce (fn [m row]\\\\n+            (when-not (and (vector? row) (= 4 (count row))\\\\n+                           (integer? (nth row 0))\\\\n+                           (<= 0 (nth row 0)) (< (nth row 0) (count v))\\\\n+                           (= :call (first (nth v (nth row 0)))))\\\\n+              (throw (ex-info \\\\\\\"Call provenance names a non-call semantic pc\\\\\\\"\\\\n+                              {:rule :call-provenance, :row row})))\\\\n+            (assoc m (nth row 0) (subvec row 1)))\\\\n+          {}\\\\n+          call-provenance))\\\\n+\\\\n+\\\\n (defn stack-image\\\\n   \\\\\\\"Stackify A's parsed expressions, placing closure bodies in FIFO order.\\\\n-   Labels and diagnostics are derived solely from A.\\\\\\\"\\\\n-  [v]\\\\n-  (let [{rv :vector bodies :bodies} (resolve v)\\\\n+   Labels and diagnostics are derived solely from A.\\\\n+\\\\n+   The two-argument form reconstructs call provenance through the\\\\n+   stack derivation's own PC mapping: `opts`' `:call-provenance` is\\\\n+   the semantic vector's `[[pc origin root path] …]` and its\\\\n+   `:segment-address` is the segment coordinate the caller supplies\\\\n+   for this image. The result then carries `:call-provenance`\\\\n+   `[[segment-address pc origin root path] …]` for its `:call` pcs\\\\n+   and a `{:kind :call …}` side-table diagnostic at each (the existing\\\\n+   `:closure`/`:var` diagnostic shapes are undisturbed). The image\\\\n+   itself is identical with or without provenance.\\\\\\\"\\\\n+  ([v] (stack-image v nil))\\\\n+  ([v {:keys [segment-address call-provenance]}]\\\\n+   (let [{rv :vector bodies :bodies} (resolve v)\\\\n         by-start (into {} (map (juxt :start identity)) bodies)\\\\n+        keys-by-pc (when (some? call-provenance)\\\\n+                     (call-key-map v call-provenance))\\\\n+        call-rows (volatile! [])\\\\n         image (volatile! [])\\\\n         side (volatile! {})\\\\n         labels (volatile! {})\\\\n@@ -90,6 +123,11 @@\\\\n                   :var (do (diagnostic! {:kind :var :source pc})\\\\n                            (emit! (if (= op :load-bound) [:load-bound x y] [:load-free x])))\\\\n                   :call (do (doseq [child children] (walk child) (emit! [:push]))\\\\n+                            (when-let [[o r p] (get keys-by-pc pc)]\\\\n+                              (diagnostic! {:kind :call :source pc\\\\n+                                            :origin o :root r :path p})\\\\n+                              (vswap! call-rows conj\\\\n+                                      [segment-address (count @image) o r p]))\\\\n                             (emit! [:call (count y) z]))\\\\n                   :ffi-call (do (doseq [child children] (walk child) (emit! [:push]))\\\\n                                 (emit! [:ffi-call x (count y)]))\\\\n@@ -112,12 +150,13 @@\\\\n       (loop [i 0]\\\\n         (when-let [[l body] (get @queue i)]\\\\n           (mark! l) (body! body) (recur (inc i))))\\\\n-      {:image (mapv (fn [t]\\\\n-                      (case (first t)\\\\n-                        (:jump :branch-false) (assoc t 1 (get @labels (nth t 1)))\\\\n-                        :closure (assoc t 2 (get @labels (nth t 2)))\\\\n-                        t)) @image)\\\\n-       :side-table @side})))\\\\n+      (cond-> {:image (mapv (fn [t]\\\\n+                              (case (first t)\\\\n+                                (:jump :branch-false) (assoc t 1 (get @labels (nth t 1)))\\\\n+                                :closure (assoc t 2 (get @labels (nth t 2)))\\\\n+                                t)) @image)\\\\n+               :side-table @side}\\\\n+        (some? call-provenance) (assoc :call-provenance @call-rows))))))\\\\n \\\\n \\\\n (defn- allocation\\\\n@@ -153,9 +192,18 @@\\\\n \\\\n (defn register-image\\\\n   \\\\\\\"Allocate temporaries by linear scan over A's live points; preserve A's\\\\n-   layout and fill saved windows using the register format's liveness.\\\\\\\"\\\\n-  [v]\\\\n-  (let [{rv :vector bodies :bodies} (resolve v)\\\\n+   layout and fill saved windows using the register format's liveness.\\\\n+\\\\n+   The two-argument form reconstructs call provenance: layout is\\\\n+   preserved, so a semantic `:call` pc IS the register pc — the result\\\\n+   then carries `:call-provenance`\\\\n+   `[[segment-address pc origin root path] …]` under `opts`'\\\\n+   caller-supplied `:segment-address`, mapped from `opts`'\\\\n+   `:call-provenance` (the semantic vector's rows). The image itself\\\\n+   is identical with or without provenance.\\\\\\\"\\\\n+  ([v] (register-image v nil))\\\\n+  ([v {:keys [segment-address call-provenance]}]\\\\n+   