                     :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\\\\n  3964\\\\t            compiled (kernel-compile fixture)\\\\n  3965\\\\t            wrappers (into []\\\\n  3966\\\\t                           (filter (fn [[_ node]]\\\\n  3967\\\\t                                     (kernel-stamped-args? node)))\\\\n  3968\\\\t                           (cc3-walk (:ast compiled) [] []))\\\\n  3969\\\\t            [p2 _] (second wrappers)\\\\n  3970\\\\t            k (cc3-stamp-site-id (second (first wrappers)))\\\\n  3971\\\\t            duplicated (cc3-assoc-at (:ast compiled) p2\\\\n  3972\\\\t                                      (fn [w]\\\\n  3973\\\\t                                        (assoc-in w [:operands 0 :operands 1\\\\n  3974\\\\t                                                     :operands 1 :value]\\\\n  3975\\\\t                                                  k)))]\\\\n  3976\\\\t        (is (= :compiled (:status compiled)))\\\\n  3977\\\\t        (is (<= 2 (count wrappers)) \\\\\\\"precondition: at least two stamped sites\\\\\\\")\\\\n  3978\\\\t        (is (some? k))\\\\n  3979\\\\t        (is (= :cc3-duplicate-stamp-site\\\\n  3980\\\\t               (try (cc3-oracle-binding (assoc compiled :ast duplicated))\\\\n  3981\\\\t                    ::no-failure\\\\n  3982\\\\t                    (catch Exception e (:rule (ex-data e)))))\\\\n  3983\\\\t            \\\\\\\"two wrappers carrying one site id refuse, never overwrite\\\\\\\")))))\\\\n  3984\\\\t\\\\n  3985\\\\t\\\\n  3986\\\\t(deftest test-cc3-distinct-admissions-distinct-origins\\\\n  3987\\\\t  ;; cc3 r3 item F2: the admission coordinate is an explicit,\\\\n  3988\\\\t  ;; composition-supplied scope plus a per-scope ordinal, retained\\\\n  3989\\\\t  ;; with the compilation as plain data — no per-JVM global counter.\\\\n  3990\\\\t  ;; Two scopes whose ordinals both restarted at 0, admitting\\\\n  3991\\\\t  ;; identical content, mint distinct origins; replaying one retained\\\\n  3992\\\\t  ;; admission (the binding test above) keeps its one origin.\\\\n  3993\\\\t  (let [fixture {:id :cc3-binding\\\\n  3994\\\\t                 :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\\\\n  3995\\\\t        a (kernel-compile fixture \\\\\\\"run-a\\\\\\\" 0)\\\\n  3996\\\\t        b (kernel-compile fixture \\\\\\\"run-b\\\\\\\" 0)]\\\\n  3997\\\\t    (is (= :compiled (:status a)))\\\\n  3998\\\\t    (is (= :compiled (:status b)))\\\\n  3999\\\\t    (is (= (:canonical-source-hash a) (:canonical-source-hash b))\\\\n  4000\\\\t        \\\\\\\"precondition: the content really is identical\\\\\\\")\\\\n  4001\\\\t    (is (= 0 (nth (:admission-origin a) 3) (nth (:admission-origin b) 3))\\\\n  4002\\\\t        \\\\\\\"precondition: both scopes restarted their ordinal at 0\\\\\\\")\\\\n  4003\\\\t    (is (= \\\\\\\"run-a\\\\\\\" (nth (:admission-origin a) 2)))\\\\n  4004\\\\t    (is (= \\\\\\\"run-b\\\\\\\" (nth (:admission-origin b) 2)))\\\\n  4005\\\\t    (is (not= (:admission-origin a) (:admission-origin b))\\\\n  4006\\\\t        \\\\\\\"distinct scopes with restarted ordinals mint distinct origins\\\\\\\")\\\\n  4007\\\\t    (let [ba (cc3-oracle-binding a)\\\\n  4008\\\\t          bb (cc3-oracle-binding b)]\\\\n  4009\\\\t      (is (= (:admission-origin a) (:origin ba)))\\\\n  4010\\\\t      (is (= (:admission-origin b) (:origin bb)))\\\\n  4011\\\\t      (is (= (:binding ba) (:binding (cc3-oracle-binding a)))\\\\n  4012\\\\t          \\\\\\\"replay reuses the recorded coordinate of scope run-a\\\\\\\")\\\\n  4013\\\\t      (is (= (set (keys (:binding ba))) (set (keys (:binding bb)))))\\\\n  4014\\\\t      (is (not= (set (vals (:binding ba))) (set (vals (:binding bb))))\\\\n  4015\\\\t          \\\\\\\"the same sites bind under each admission's own origin\\\\\\\"))))\\\\n   113\\\\tmeasurement method. It stands in the r1 findings as an\\\\n   114\\\\tincomplete-preflight run; nothing here re-stamps it. The r2 record\\\\n   115\\\\tadded serialized sizes, timings, and finite ceilings, but its\\\\n   116\\\\t\\\\\\\"retained memory\\\\\\\" figure was the canonical serialized byte count and\\\\n   117\\\\tits heap figure one post-binding sample; r3 replaces those two\\\\n   118\\\\tclaims with the measurements below and preserves the rest.\\\\n   119\\\\t\\\\n   120\\\\tMeasured 2026-11-11 in-session (JVM, warm; fixture\\\\n   121\\\\t`{:call (latte-kernel.utils/vectorn? [1 2 3] 2)}` through\\\\n   122\\\\t`kernel-compile`, `cc3-oracle-binding`, `linearize/project-rows`,\\\\n   123\\\\t`derive/stack-image`, `derive/register-image`, and both tagged C\\\\n   124\\\\tlanes; script `/tmp/cc3-f6-measure.clj`):\\\\n   125\\\\t\\\\n   126\\\\t- Serialized storage: canonical byte counts (`dao.jing/canonical-bytes`)\\\\n   127\\\\t  of the C1 rows and of the 3-lane provenance relation. This measures\\\\n   128\\\\t  storage bytes, not live objects.\\\\n   129\\\\t- Retained JVM memory: used-heap delta (`Runtime.totalMemory −\\\\n   130\\\\t  freeMemory`) around the retained structure's lifetime\\\\n   131\\\\t  (`{binding, semantic/stack/register images, relation}` held in a\\\\n   132\\\\t  holder), with `System/gc()` pins before each sample, repeated for\\\\n   133\\\\t  stability. Method limits: process-wide JVM figure including the\\\\n   134\\\\t  test harness; `System/gc()` is a hint the JVM honored observably\\\\n   135\\\\t  here, not a guarantee; the delta is comparable only on this\\\\n   136\\\\t  host/JVM and only as an order-of-magnitude retained-size claim,\\\\n   137\\\\t  never as an exact object-graph size.\\\\n   138\\\\t- Peak memory: a sampler thread recorded used heap every 5 ms across\\\\n   139\\\\t  lowering → persistence (binding/projection/derives) → tagged\\\\n   140\\\\t  execution (both C lanes); the peak is the maximum sample, checked\\\\n   141\\\\t  against the declared ceiling. Boundary samples per stage are also\\\\n   142\\\\t  recorded. Limit: 5 ms sampling can miss sub-5 ms transients.\\\\n   143\\\\t\\\\n   144\\\\tF6-NUMBERS-TBD\\\\n   145\\\\t\\\\n   146\\\\tFailure rule (unchanged): exceeding any ceiling is a failed bounded\\\\n   147\\\\trun; bounds are never silently raised.\\\\n   148\\\\t\\\\n   149\\\\t## Red-first evidence\\\\n   150\\\\t\\\\n   151\\\\tTests were written before the fix for each item; observed red in this\\\\n   152\\\\tsession:\\\\n   153\\\\t\\\\n   154\\\\t| Item | Red | Green |\\\\n   155\\\\t|---|---|---|\\\\n   156\\\\t| F1+F2 (oracle) | `test-cc3-correspondence-verifies-grammar-data` + `test-cc3-distinct-admissions-distinct-origins`: 7 failures, 1 error (scalar mutations accepted, non-`gate-site!` wrapper accepted, duplicate IDs silently overwritten; distinct test errored on the not-yet-existing scoped arity) | 0 (both tests, plus nested + binding deftests: 4 tests, 64 assertions) |\\\\n   157\\\\t| F4 (durable) | `repl-packet-provenance-survives-failure-test`: 2 failures (throwing round added no handle — 2 handles before and after; no retrievable relation for the throwing round) | 0 (7 assertions; with the r2 durable test: 2 tests, 14 assertions) |\\\\n   158\\\\t| F6 | n/a — record/measurement fix, no code | measured record above |\\\\n   159\\\\t\\\\n   160\\\\t## Verification\\\\n   161\\\\t\\\\n   162\\\\t| Lane | Command | Outcome |\\\\n   163\\\\t|---|---|---|\\\\n   164\\\\t| Callsite battery | `clojure -M:test -n yang.clojure-callsite-test` | 35 tests, 396 assertions, 0 failures, 0 errors |\\\\n   165\\\\t| Touched semantic + repl | `clojure -M:test -n yin.vm.semantic.linearize-test -n yin.vm.semantic.derive-test -n yin.repl-test -n yin.repl.store-test` | 130 tests, 7,733 assertions, 0 failures, 0 errors |\\\\n   166\\\\t| Oracle binding | `clojure -M:test -n yang.latte-oracle-test -v yang.latte-oracle-test/test-cc3-oracle-site-c1-binding` (in the 4-test run) | 0 failures |\\\\n   167\\\\t| Oracle nested correspondence | `… -v yang.latte-oracle-test/test-cc3-stamp-correspondence-nested` | 0 failures |\\\\n   168\\\\t| Oracle distinct admissions | `… -v yang.latte-oracle-test/test-cc3-distinct-admissions-distinct-origins` | 0 failures |\\\\n   169\\\\t| Oracle grammar-data (new) | `… -v yang.latte-oracle-test/test-cc3-correspondence-verifies-grammar-data` | 0 failures |\\\\n   170\\\\t| REPL provenance durable (r2) | `… -v yang.clojure-callsite-test/repl-packet-provenance-durable-test` | 0 failures |\\\\n   171\\\\t| REPL provenance survives failure (new) | `… -v yang.clojure-callsite-test/repl-packet-provenance-survives-failure-test` | 0 failures |\\\\n   172\\\\t| kondo (all 8 changed files) | `clj -M:kondo --lint <8 files>` | errors: 0, warnings: 0 |\\\\n   173\\\\t\\\\n   174\\\\t## Invariants and unchanged items\\\\n   175\\\\t\\\\n   176\\\\t- Zero canonical change, legacy loadability, metadata-never-hashed:\\\\n   177\\\\t  the r1/r2 assertions still pass inside the suites above; r3 adds no\\\\n   178\\\\t  guest instructions and no runtime instrumentation. Origins are\\\\n   179\\\\t  never minted from content: the F2 coordinate is supplied by the\\\\n   180\\\\t  admitting composition and recorded as plain data; `kernel-compile`'s\\\\n   181\\\\t  scoped arity refuses a malformed scope/ordinal through\\\\n   182\\\\t  `vm/source-origin` (`:rule :origin`) before compilation.\\\\n   183\\\\t- No hidden global state: the F2 fix removes the harness's last\\\\n   184\\\\t  admission atom; `stamped-paths`' volatile in `cc3-oracle-binding`\\\\n   185\\\\t  was also removed in passing (entries are plain collected data).\\\\n   186\\\\t- Datom lane (r1 item 4): restriction unchanged — row lane only, D1's\\\\n   187\\\\t  stated dependency; not re-opened by this round.\\\\n   188\\\\t- DHT custody (owner-visible, unchanged): `dht/publish-name!` still\\\\n   189\\\\t  discards the `:call-sites` handle (now carrying `:provenance`);\\\\n   190\\\\t  `dht.cljc` remains forbidden and unedited — the one-line forwarding\\\\n(require 'yang.latte-oracle-test 'dao.jing 'yin.vm.semantic.linearize 'yin.vm.semantic.derive)\\\\n(def kc @#'yang.latte-oracle-test/kernel-compile)\\\\n(def binding @#'yang.latte-oracle-test/cc3-oracle-binding)\\\\n(def kernel-c @#'yang.latte-oracle-test/kernel-c)\\\\n(import '(java.lang Runtime System))\\\\n(def rt (Runtime/getRuntime))\\\\n(defn used [] (- (.totalMemory rt) (.freeMemory rt)))\\\\n(defn gc-used [] (System/gc) (Thread/sleep 50) (System/gc) (used))\\\\n(def fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)})\\\\n;; peak sampler across lowering -> persistence(projection/derives) -> tagged execution\\\\n(def peak (atom 0))\\\\n(def stop (atom false))\\\\n(def sampler (Thread. (fn [] (while (not @stop) (swap! peak max (used)) (Thread/sleep 5)))))\\\\n(def t0 (System/currentTimeMillis))\\\\n(def base (gc-used))\\\\n(.start sampler)\\\\n(def stage-peaks (atom []))\\\\n(defn mark [label] (swap! stage-peaks conj [label (used)]))\\\\n(def compiled (kc fixture)) (mark :after-compile)\\\\n(def b (binding compiled)) (mark :after-binding)\\\\n(def sem (yin.vm.semantic.linearize/project-rows (:tree b) nil (:rows b))) (mark :after-project-rows)\\\\n(def stack (yin.vm.semantic.derive/stack-image (:vector sem) {:segment-address :seg/stack :call-provenance (:call-provenance sem)})) (mark :after-stack)\\\\n(def reg (yin.vm.semantic.derive/register-image (:vector sem) {:segment-address :seg/register :call-provenance (:call-provenance sem)})) (mark :after-register)\\\\n(def relation {:semantic (:call-provenance sem) :stack (:call-provenance stack) :register (:call-provenance reg)})\\\\n(def c-walker (kernel-c compiled :c-walker)) (mark :after-c-walker)\\\\n(def c-sem (kernel-c compiled :c-semantic)) (mark :after-c-semantic)\\\\n(reset! stop true) (.join sampler)\\\\n(def elapsed (- (System/currentTimeMillis) t0))\\\\n;; serialized storage (canonical bytes) vs retained JVM objects (used-heap delta, gc-pinned)\\\\n(def rows-bytes (count (dao.jing/canonical-bytes (:rows b))))\\\\n(def rel-bytes (count (dao.jing/canonical-bytes relation)))\\\\n(def retained-box (atom nil))\\\\n(def before-retain (gc-used))\\\\n(reset! retained-box {:binding b :sem sem :stack stack :reg reg :relation relation})\\\\n(def after-retain (gc-used))\\\\n;; repeat delta measurement for stability\\\\n(def deltas (mapv (fn [_] (let [x (atom nil) b0 (gc-used)] (reset! x {:b b :s sem :st stack :r reg}) (let [a (gc-used)] (reset! x nil) (- a b0)))) (range 3)))\\\\n(println :compiled-status (:status compiled))\\\\n(println :c-status (:status c-walker) (:status c-sem))\\\\n(println :rows-canonical-bytes rows-bytes)\\\\n(println :relation-canonical-bytes rel-bytes)\\\\n(println :heap-baseline-gc-used base)\\\\n(println :stage-used stage-peaks)\\\\n(println :peak-used-during-pipeline @peak)\\\\n(println :peak-over-baseline (- @peak base))\\\\n(println :retained-delta-first (- after-retain before-retain))\\\\n(println :retained-deltas-repeat deltas)\\\\n(println :elapsed-ms elapsed)\\\\n(println :ceiling-bytes 1073741824 :peak-under-ceiling (< @peak 1073741824))\\\\n(System/exit 0)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794377000000-reviewer-cc3-r3-confirm.gpt-6-astra.stdout.log:14:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg -n 'kernel-compile|defn- link-raise|defn- carry-served|link-raise' test/yang/latte_oracle_test.clj src/cljc/yin/repl.cljc; nl -ba src/cljc/yin/repl.cljc | sed -n '1540,1680p;1855,1924p'; nl -ba /tmp/cc3-f6-measure.clj | sed -n '1,85p'; nl -ba src/cljc/yin/vm/encoder.cljc | sed -n '25,45p;140,159p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"src/cljc/yin/repl.cljc:1551:(defn- link-raise\\\\nsrc/cljc/yin/repl.cljc:1569:(defn- carry-served\\\\nsrc/cljc/yin/repl.cljc:1637:        (throw (link-raise (ex-info query-call-limit-text\\\\nsrc/cljc/yin/repl.cljc:1672:                           