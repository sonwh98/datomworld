+(deftest test-exception-r3-protocol-condition-crosses-the-public-entry
+  (testing "the acceptance kit's boundary shape: a well-formed qualified
+            condition raised into a clojure call site, caught and rethrown
+            by source, is handed to the invocation's raise exit by the
+            PUBLIC entry with its qualified reason and its identity - never
+            re-minted as a fresh :yang.call/thrown. This is the row
+            `yang.call.exception-contract-test`'s `:clojure/protocol-*`
+            fixtures measure; `run-cell-program`'s intra-unit call does not
+            reach it (ruling v2 §R3; design §8.10.7)"
+    (doseq [lane [:walker :semantic]]
+      (doseq [[reason evidence]
+              [[:yang.call/not-callable {:yang.call/callee {}}]
+               [:yang.call/invalid-invocation {:yang.call/callee :target}]
+               [:yang.call/unsupported-binding
+                {:yang.call/binding-profile :contract/unsupported}]]]
+        (let [condition {:yang.call/reason reason :yang.call/data evidence}]
+          (is (= [:yin.k/ok condition]
+                 (run-public-entry-program
+                   '[(defn receive
+                       [f]
+                       (try (f) (catch Exception e (throw e))))
+                     (yang.call/invoke receive (conj [] marker-operand) []
+                                       marker-raise)]
+                   (cell-entry-node condition)
+                   lane))
+              (str lane " " reason " keeps its reason and identity across the"
+                   " public entry"))))))
+  (testing "the saved variant: a wrapper the guest retained and rethrew from
+            a LATER activation still crosses the public entry as the
+            condition the convention built (`:clojure/saved-protocol-*`)"
+    (doseq [lane [:walker :semantic]]
+      (doseq [reason [:yang.call/not-callable
+                      :yang.call/invalid-invocation
+                      :yang.call/unsupported-binding]]
+        (let [condition {:yang.call/reason reason
+                         :yang.call/data {:yang.call/callee :target}}]
+          (is (= [:yin.k/ok condition]
+                 (run-public-entry-program
+                   '[(def saved (cell/new nil))
+                     (defn retain
+                       [f]
+                       (try (f) (catch Exception e (cell/set! saved e) e)))
+                     (defn later
+                       []
+                       (throw (cell/get saved)))
+                     (let [_held (retain marker-operand)]
+                       (yang.call/invoke later (conj []) [] marker-raise))]
+                   (cell-entry-node condition)
+                   lane))
+              (str lane " " reason " saved and rethrown later keeps its reason")))))))
