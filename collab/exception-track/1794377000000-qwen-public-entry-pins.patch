+(defn- run-public-entry-program
+  "Like `run-cell-program`, but the call under test is an explicit
+   `yang.call/invoke` on the callee's published descriptor rather than an
+   intra-unit call, and the invocation's raise exit is a raw identity
+   lambda spliced at `marker-raise`. The condition therefore crosses
+   `call-entry`'s PUBLIC lane (`entry-body`), which is where a linked
+   composition's boundary probe observes it — `run-cell-program`'s
+   intra-unit call takes the private token lane and is classified instead
+   by `strip-top-outcome` at the harness top. The answered value is the
+   condition the public entry handed the raise exit."
+  [program node lane]
+  (let [raise (u/lam ['marker_condition] (u/v 'marker_condition))
+        splice (fn [n]
+                 (cond
+                   (and (map? n) (= :variable (:type n)))
+                   (case (:name n)
+                     marker-operand node
+                     marker-raise raise
+                     n)
+                   :else n))
+        ast (walk/postwalk
+              splice
+              (yang/compile-program
+                (into (yang/library-for program) program)
+                true
+                library-opts))]
+    (try
+      (run-guest-ast ast library-modules lane 1000000)
+      (catch clojure.lang.ExceptionInfo e
+        [:thrown (select-keys (ex-data e) [:reason :effect])]))))
+
