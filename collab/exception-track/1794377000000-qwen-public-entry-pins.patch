+(defn- uast-variable-names
+  "Every `:variable` name read anywhere in map AST `node`."
+  [node]
+  (into #{}
+        (comp (filter #(and (map? %) (= :variable (:type %)))) (map :name))
+        (tree-seq (fn [x] (or (and (map? x) (contains? x :type)) (vector? x)))
+                  (fn [x] (if (map? x) (vals x) x))
+                  node)))
+
+
+(defn- uast-global-reads
+  "Every name a `clj/global-get` read in map AST `node` looks up, as the
+   string the linked unit's runtime global namespace is keyed by."
+  [node]
+  (into #{}
+        (comp (filter (fn [n]
+                        (and (map? n)
+                             (= :application (:type n))
+                             (= 'clj/global-get (get-in n [:operator :name]))
+                             (= :literal (:type (first (:operands n)))))))
+              (map (comp :value first :operands)))
+        (tree-seq (fn [x] (or (and (map? x) (contains? x :type)) (vector? x)))
+                  (fn [x] (if (map? x) (vals x) x))
+                  node)))
+
+
+(deftest test-exception-r3-linked-unit-keeps-the-retained-seam
+  (testing "a LINKED unit's wrapper helpers still read the issuer's retained
+            mint and query as host names. `lower-unit` rewrites the compiled
+            program with `publish-to-globals` after `compile-program`
+            finalized it, and that rewrite turns a free read of any name the
+            unit defines into a `clj/global-get` lookup: were it to capture
+            the reserved-prefix helpers or the two `cell/` host reads, the
+            wrapper would mint or decode through the runtime global
+            namespace instead of the heap, and every qualified condition
+            would reach the boundary as a fresh :yang.call/thrown"
+    (let [unit (yang/lower-unit
+                 (yang/read-forms
+                   (str "(defn receive [f] (try (f) (catch Exception e (throw e)))) "
+                        "(def saved (cell/new nil)) "
+                        "(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) "
+                        "(defn later [] (throw (cell/get saved)))"))
+                 [])
+          names (uast-variable-names unit)
+          globals (uast-global-reads unit)]
+      (is (contains? names 'cell/dsg__new-retained)
+          "the retained mint survives the linked-unit rewrite as a host read")
+      (is (contains? names 'cell/retained?)
+          "the retained query survives the linked-unit rewrite as a host read")
+      (is (empty? (filter #(or (some? (namespace (symbol %)))
+                               (.startsWith ^String % "dsg__"))
+                          globals))
+          (str "no qualified host read and no reserved-prefix binding was "
+               "rewritten into a runtime global lookup: " (pr-str globals))))))
+
