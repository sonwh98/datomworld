{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1780,1860p' test/yang/clojure_callsite_test.cljc; sed -n '79,115p' src/cljc/yang/core/prelude.cljc; sed -n '1,150p' src/cljc/yang/core/module.cljc\"","aggregated_output":"            \"identical content under a different admission is not borrowed\")))\n    (testing \"a wrong-version retained table proves nothing\"\n      (let [bad (into {}\n                      (map-indexed (fn [i [k rs]]\n                                     [k (if (zero? i)\n                                          (assoc-in rs [0 4] 2)\n                                          rs)])\n                                   tables))\n            spec (publish/module-from-index\n                   db {:name 'closed :exports '[g] :primitives vm/primitives\n                       :call-site-tables bad\n                       :call-site-admissions (repl/call-site-admissions state)})]\n        (is (claim-free? spec))))\n    (testing \"an incomplete retained table proves nothing\"\n      (let [bad (into {}\n                      (map-indexed (fn [i [k rs]]\n                                     [k (if (zero? i) (pop rs) rs)])\n                                   tables))\n            spec (publish/module-from-index\n                   db {:name 'closed :exports '[g] :primitives vm/primitives\n                       :call-site-tables bad\n                       :call-site-admissions (repl/call-site-admissions state)})]\n        (is (claim-free? spec))))))\n\n\n(deftest repl-query-link-forwarding-test\n  ;; :cljd first — the publish-name! spy needs with-redefs, which\n  ;; ClojureDart lacks, and the forwarding is only observable through\n  ;; that spy; the rest of the namespace stays dart-runnable\n  #?(:cljd nil\n     :default\n     (testing \"yin.shell.query/link-answer forwards the link context's\n             :call-site-tables to publish-name!\"\n       (let [{:keys [state]} (session-index [\"(def k (fn [] 1))\"])\n             tables (repl/call-site-tables state)\n             captured (atom nil)]\n         (with-redefs [linker-dht/publish-name!\n                       (fn [_node _db opts]\n                         (reset! captured opts)\n                         {:status :ok :address :segment/test\n                          :links {} :envelopes []})]\n           (let [[_ _ response]\n                 (#'shell-query/link-answer\n                  {} (:indexer state)\n                  {:authority nil :key {} :primitives vm/primitives\n                   :modules {} :call-site-tables tables :round 1}\n                  {}\n                  (apply2/request 1 (get shell-query/link-ops 'publish)\n                                  ['closed '[k]]))]\n             (is (some? response))\n             (is (= tables (:call-site-tables @captured))\n                 \"ordinary yin.link/publish now carries the retained tables\")))))))\n\n;; =============================================================================\n;; cc2 fix round r3: admission identity + explicit wrappers (astra r2 confirm)\n;; =============================================================================\n\n(defn- r3-claim-free?\n  \"True when `spec` carries no C1 claim and publishes with no side table.\"\n  [spec]\n  (let [tree (vm/ast->semantic-bytecode (:ast spec))\n        side (vm/ast-side-tables (:ast spec) tree origin)\n        res (publish/publish-module! (mem/create-content-mem) spec)]\n    (and (empty? (filter #(= :yang/call-site (nth % 3))\n                         (:frontend-metadata side)))\n         (not (contains? spec :call-site-rows))\n         (jing/segment-address? (:address res))\n         (not (contains? res :call-sites)))))\n\n\n(defn- r3-programs\n  \"The indexed programs of `db` as `[m root t]` rows.\"\n  [db]\n  (query/collect\n    (query/q '[:find ?m ?r ?t :where [?m :yin.repl/root ?r ?t _]] db)))\n\n\n(deftest module-from-index-c1-r3-test\n  (let [{:keys [state db]} (session-index [\"(def k (fn [] 1))\"\n                                           \"(def g (fn [] (+ (k) 41)))\"])\n        tables (repl/call-site-tables state)\n(defn free-names\n  \"Every variable name some occurrence of the map AST `ast` reads\n   unbound by an enclosing lambda.\"\n  [ast]\n  (letfn [(walk-node\n            [acc node bound]\n            (cond\n              (vector? node) (reduce (fn [a n] (walk-node a n bound)) acc node)\n              (not (map? node)) acc\n              :else\n              (case (:type node)\n                :variable (if (contains? bound (:name node))\n                            acc\n                            (conj acc (:name node)))\n                :literal acc\n                :lambda (walk-node acc (:body node) (into bound (:params node)))\n                (reduce (fn [a v] (walk-node a v bound)) acc (vals node)))))]\n    (walk-node #{} ast #{})))\n\n\n(defn defined-keys\n  \"Every literal key the map AST `ast` defines with `yin/def`, at any\n   depth.\"\n  [ast]\n  (set (keep (fn [node]\n               (when (and (map? node)\n                          (= :application (:type node))\n                          (= 'yin/def (get-in node [:operator :name])))\n                 (get-in node [:operands 0 :value])))\n             (tree-seq coll? seq ast))))\n\n\n(defn free-name-vec\n  \"The names `ast` reads and does not define, sorted.\"\n  [ast]\n  (vec (sort-by str\n                (remove (conj (defined-keys ast) 'yin/def) (free-names ast)))))\n(ns yang.core.module\n  \"Module emitter machinery shared by every language frontend\n   (docs/design/yang.typescript.md §17, lift L3): the linker module naming\n   rule, the `require` and wide-application tree nodes, free-name\n   declaration over a host registry, and the `module-spec` and SCC bundle\n   shapes `yin.vm.linker.publish/publish-module!` takes. A language supplies\n   its prefix, its runtime module and its module AST; nothing here knows a\n   source language.\"\n  (:require\n    [clojure.string :as str]\n    [yang.core.prelude :as prelude]\n    [yang.core.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.module :as module]))\n\n\n(defn module-symbol\n  \"The linker module name of source module `name` under language `prefix`\n   (\\\"py\\\", \\\"php\\\", \\\"js\\\"): `<prefix>m.` then the name with each dot a `$`,\n   so no linker module name is a dotted prefix of another.\"\n  [prefix name]\n  (symbol (str prefix \"m.\" (str/replace name \".\" \"$\"))))\n\n\n(defn require-node\n  \"(require 'm) as a tree node.\"\n  [m]\n  (u/sexp->uast (list 'require (list 'quote m))))\n\n\n(defn module-tree\n  \"A wide application: all definitions remain at module level.\"\n  [operands]\n  (prelude/wide-app operands))\n\n\n(defn declare-free-name\n  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n   when `covered` (the requirement-pinned module names) covers it. A name\n   no `vm/primitives` profile or host export supplies throws, with\n   `refusal` under `refusal-key` in its data.\"\n  [refusal-key refusal registry covered n]\n  (if (and (symbol? n) (some? (namespace n))\n           (contains? covered (symbol (namespace n))))\n    nil\n    (if-let [profile (vm/profile-of vm/primitives n)]\n      [n profile]\n      (if-let [address (module/host-export-profile registry n)]\n        (let [entry (module/module-entry (:modules registry)\n                                         (symbol (namespace n)))\n              f (get-in entry [:slice (symbol (name n))])]\n          [n {:yin.k/profile address,\n              :yin.k/effects\n              (get (:callable-effects registry) f #{})}])\n        (throw (ex-info \"the module reads an undeclared name\"\n                        {refusal-key refusal, :name n}))))))\n\n\n(defn free-primitives\n  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n  [refusal-key refusal registry covered ast]\n  (let [free (remove (conj (prelude/defined-keys ast) 'yin/def)\n                     (prelude/free-names ast))]\n    (into {}\n          (keep (partial declare-free-name refusal-key refusal registry covered))\n          (sort-by str free))))\n\n\n(defn module-spec\n  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n   ({module-symbol address}). A free name under a required module is covered\n   by it; any other is declared as `declare-free-name` does.\"\n  [refusal-key refusal registry\n   {:keys [name ast exports runtime-name runtime-address deps]}]\n  (let [requires (into {runtime-name runtime-address} deps)]\n    {:name name,\n     :ast ast,\n     :exports exports,\n     :requires requires,\n     :primitives (free-primitives refusal-key refusal registry\n                                  (set (keys requires)) ast)}))\n\n\n(defn alias-spec\n  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n   `body-key` exports.\"\n  [name exports require-profile bundle-name spec-key body-key]\n  {:name name,\n   :exports exports,\n   :primitives {'require require-profile},\n   :ast (module-tree\n          [(require-node bundle-name)\n           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n\n\n(defn scc-module-specs\n  \"The SCC publication shape: the `bundle` spec first, then the member alias\n   specs (each `alias-spec`'s output) in member order.\"\n  [bundle aliases]\n  (into [bundle] aliases))\n","exit_code":0,"status":"completed"}}
