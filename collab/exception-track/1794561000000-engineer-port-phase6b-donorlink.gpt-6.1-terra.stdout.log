{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2610,2690p' test/yang/clojure_callsite_test.cljc; rg -n 'link-answer|linking|require-node' test/yang/clojure --glob '*.clj*' | head\"","aggregated_output":"     ;; throw from it reaches the recheck recovery catch directly. The\n     ;; render raise carries the shell snapshot (empty included) here\n     ;; too: the park round's genuine Warning (when its retention really\n     ;; failed) stays where it was, the completing recheck reports the\n     ;; renderer error alone, nothing fabricated enters the session,\n     ;; and the completed handles survive exactly once — with no late\n     ;; Warning surfacing on the next round either.\n     (doseq [[label genuine-failure?] [[\"healthy retention\" false]\n                                       [\"genuine retention failure\" true]]]\n       (testing label\n         (let [fail? (atom false)\n               render-armed? (atom false)\n               store (mem/create-content-mem)\n               address (r10-publish-module store (r10-closed-module)\n                                           (quote mod) #{(quote f)})\n               [s1 _] (repl/eval-input\n                       (repl-frontends/create-state\n                        {:frontends (r10-render-catalog\n                                     (r10-forged-renderer render-armed?))\n                         :index-store (r9-refusing-store fail?)\n                         :content-store store\n                         :name-env {(quote mod) address}})\n                       \"(def k (fn [] 1))\")\n               [s2 _] (repl/eval-input s1 \"(def g (fn [] (+ (k) 41)))\")\n               handles-before (repl/call-provenance-handles s2)]\n           (is (seq handles-before) \"precondition: earlier retention completed\")\n           (is (empty? (repl/call-provenance-failures s2))\n               \"precondition: retention was healthy so far\")\n           (reset! fail? genuine-failure?)\n           (reset! render-armed? true)\n           (let [parked (assoc s2 :link-source\n                               (r10-withholding-source (:link-source s2)\n                                                       address))\n                 [held park-text] (repl/eval-input parked\n                                                  \"(require (quote mod))\")]\n             (is (some? (:pending-run held))\n                 \"precondition: the require parked behind the withholding source\")\n             (let [handles-parked (repl/call-provenance-handles held)]\n               (if genuine-failure?\n                 (do (is (= handles-before handles-parked)\n                         \"the failed park round advertises no handle\")\n                     (is (= 1 (count (re-seq #\"call provenance was not retained\"\n                                              park-text)))\n                         \"the park round warned of its genuine failure once\"))\n                 (do (is (= (inc (count handles-before))\n                            (count handles-parked))\n                         \"the healthy park round retained its own handle\")\n                     (is (not (str/includes? park-text\n                                             \"call provenance was not retained\"))\n                         \"the healthy park round warns not\")))\n               (let [[s4 text] (repl/recheck-pending\n                                (assoc held :link-source\n                                       (link/composition\n                                        {:content-store store\n                                         :name-env {(quote mod) address}})))]\n                 (is (str/starts-with? text \"Error: renderer boom\")\n                     \"the completing recheck reports the renderer error alone\")\n                 (is (not (str/includes? text \"forged\"))\n                     \"no fabricated content reaches the round text\")\n                 (is (not (str/includes? text\n                                         \"call provenance was not retained\"))\n                     \"the genuine Warning is not repeated by the recheck round\")\n                 (is (not-any? #(= :forged/admission (:admission %))\n                               (repl/call-provenance-failures s4))\n                     \"no fabricated failure becomes a session diagnostic\")\n                 (is (not (contains? (repl/call-provenance-handles s4)\n                                     [:forged/admission \"forged-root\"]))\n                     \"no fabricated handle is advertised\")\n                 (is (every? jing/segment-address?\n                             (vals (repl/call-provenance-handles s4)))\n                     \"every advertised handle is a real retained record\")\n                 (is (= handles-parked (repl/call-provenance-handles s4))\n                     \"the completed handles survive exactly once\")\n                 (if genuine-failure?\n                   (do (is (= 1 (count (repl/call-provenance-failures s4)))\n                           \"the genuine retention failure survives exactly once\")\n                       (is (= :relation\n                              (:stage (first (repl/call-provenance-failures\n                                              s4)))))\n                       (is (some? (:admission\n                                   (first (repl/call-provenance-failures s4))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '140,215p' test/yang/typescript/antlr/linked_harness.cljc; sed -n '450,500p' test/yang/call/conformance.clj; tail -10 /private/tmp/donor-focused.log; tail -10 /private/tmp/donor-clojure.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '140,215p' test/yang/typescript/antlr/linked_harness.cljc; sed -n '450,500p' test/yang/call/conformance.clj; tail -10 /private/tmp/donor-focused.log; tail -10 /private/tmp/donor-clojure.log\"","aggregated_output":"               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n                 (assoc attached\n                        :pc pc :frames [] :continuation []\n                        :registers (vec (repeat (:registers body) nil))\n                        :halted? false :blocked? false :value nil)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task\n   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`. Options:\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `js`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `jssp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\n\n(defn exception-call\n  \"The exception-leg counterpart of `call`, with uniform per-VM outcomes.\n   Source supplies the donor raises / caller catches patterns. Always keep\n   the backend map: agreement alone must not hide which VM ran a red leg.\"\n  [[donor-frontend donor-source] exports [caller-frontend caller-source]]\n  (let [donor (publish-donor! donor-frontend donor-source)]\n    (update-vals\n      (run-program donor (compose-exception donor exports caller-frontend caller-source))\n      #(exception-outcome caller-frontend %))))\n\n\n(defn error-results\n  \"Map `e` across each vector VM backend as an operational failure.\"\n  [e]\n  (into (sorted-map) (map (fn [backend] [backend e]) (keys h/backends))))\n\n\n(defn run-exception-program\n  \"The exception probes' independent VM runs, concurrent on the JVM. Each\n   job owns its registry, task, link pair AND content-serving composition;\n   no stream cursor is shared. Only the published content store is read\n   by all three. A host Exception is kept as the original host object for\n   clojure.test's :error reporting, NEVER relabelled as a guest condition.\n   All jobs settle even if one fails. `run-program` is unchanged.\"\n  [donor ast]\n  (try\n    ;; Resolve publication delays before starting independent readers.\n    (link-source donor)\n    (let [jobs (mapv (fn [backend]\n                       [backend\n                        (future\n                          (try\n                            (vm/value\n                              (h/run-linked backend ast\n                                            {:modules (modules)\n                                             :link-source (link-source donor)}))\n                            (catch Exception e e)))])\n                     (keys h/backends))]\n      (into (sorted-map)\n            (map (fn [[backend job]] [backend @job])) jobs))\n    (catch Throwable e\n      (error-results e))))\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.call.python-exception-test\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.clojure.stream-eval-test\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,145p' test/yang/typescript/antlr/linked_harness.cljc; sed -n '95,170p' test/yang/call/conformance.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,145p' test/yang/typescript/antlr/linked_harness.cljc; sed -n '95,170p' test/yang/call/conformance.clj\"","aggregated_output":"(ns yang.typescript.antlr.linked-harness\n  \"The linked profile's composition for the JavaScript tests (T1 step S5,\n   docs/design/yang.typescript.md section 13): the namespace that requires\n   this is the publisher of `js` and `jssp`, so it publishes each module\n   once per process into one in-memory content store and serves them to\n   every linked run over a `yin.vm.linker.interpreter` composition under\n   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n   evidence is `publish-module!`'s own `link-local` links, which\n   `linked-prelude-test` asserts.\n\n   A linked run builds the program's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately\n   until the VM stops blocking, as the REPL's drive does. The AST walker\n   is not a backend here: its link of `js` is refused `:undeclared-free`\n   until L-b.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [dao.jing.mem :as mem]\n            [yang.core.call :as call]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yang.typescript.antlr.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The ordinary JavaScript composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked JavaScript composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `jssp` polls a signal stream, so the\n   safepointed composition needs it even though `js` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`js` published once into its own content store:\n   `{:store s :result r :address a :call-address ca}`. `yang.call` is\n   published first so `js` pins its shared calling runtime.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store,\n       :result result,\n       :address (:address result),\n       :call-address (:address call-result)})))\n\n\n(def published-jssp\n  \"`jssp` published once into `js`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test\n   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n  ([] (source {'js (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition over the published modules: `jssp` requires\n   `js`, and `js` requires `yang.call`.\"\n  []\n  (source {'js (:address @published),\n           'jssp (:address @published-jssp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n(defn- python-export-symbol\n  [export]\n  (symbol (str \"xlang.python.export.\" export)))\n\n\n(defn- python-unit\n  [packet exports]\n  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\n         (u/seq-nodes\n           (concat (map (fn [export]\n                          (u/sexp->uast\n                            (list 'py/global-set py-lower/globals-sym\n                                  {:py/str export} (python-export-symbol export))))\n                        exports)\n                   [(py-lower/lower-module-body packet)]))))\n\n\n(def frontends\n  \"Each admitted frontend's profile, as data:\n\n   - `:runtime`, `:address`: the runtime module and its published address;\n   - `:refusal`: the publication refusal key and reason of its modules;\n   - `:deps` (optional): pinned requirements beyond the runtime its\n     lowered units read directly (the clojure unit's `yang.call` reads);\n   - `:parse`: source text to CST packet;\n   - `:unit`: packet and projected exports to the lowered unit its\n     `:run-main` entry takes;\n   - `:read-export`: export name to the form reading the runtime's global\n     namespace (JS `globalThis`, PHP's named-function table, Python's main\n     module dictionary, the clojure runtime's task-local namespace cell);\n   - `:project`: name and a value form to the form binding the value where\n     the runtime's source resolves a called name;\n   - `:render`: the `:run-main` value as test data.\"\n  {:typescript\n   {:runtime 'js,\n    :address #(:address @h/published),\n    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\n    :parse #(parse-ok ts-cst/parse-source %),\n    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\n    :run-main 'js/run-main,\n    :read-export (fn [export] (list 'js/global-get {:js/str export})),\n    :project (fn [name value] (list 'js/define-global! name value)),\n    :render render/output},\n   :php\n   {:runtime 'php,\n    :address #(:address @published-php),\n    :refusal [:yang.php/refusal :yang.php/undeclared-free],\n    :parse #(parse-ok php-cst/parse-source %),\n    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\n    :run-main 'php/run-main,\n    :read-export (fn [export]\n                   (list 'php/resolve-fn (str/lower-case export) export)),\n    :project (fn [name value]\n               (list 'php/declare-function! (str/lower-case name) value)),\n    :render php-h/render},\n   :python\n   {:runtime 'py,\n    :address #(:address @published-py),\n    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\n    :parse #(parse-ok py-parser/parse-source %),\n    :unit python-unit,\n    :run-main 'py/run-main,\n    :read-export (fn [export]\n                   (list 'py/global-get\n                         (list 'py/module-dict\n                               (list 'py/modules-ref {:py/str \"__main__\"}))\n                         {:py/str export})),\n    :project (fn [name value]\n               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\n    :render py-render/output},\n   :clojure\n   {:runtime 'clj,\n    :address #(:address @published-clj),\n    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\n    :deps (fn [] {'yang.call (:call-address @h/published)}),\n    :parse clj-comp/read-forms,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '160,180p' src/cljc/yang/clojure/prelude.cljc; rg -n 'defn admit' src/cljc/yang/clojure/prelude.cljc; sed -n '35,95p' test/yang/call/conformance.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '160,180p' src/cljc/yang/clojure/prelude.cljc; rg -n 'defn admit' src/cljc/yang/clojure/prelude.cljc; sed -n '35,95p' test/yang/call/conformance.clj\"","aggregated_output":"    ;; through as the failure value for the caller to render.\n    [clj/unwrap-outcome\n     (fn [value]\n       (if (if (data/vector? value) (= (data/count value) 2) false)\n         (if (= (data/nth value 0) :yin.k/ok)\n           (data/nth value 1)\n           value)\n         value))]\n    ;; The global namespace is the task's, not the entry's: no reset\n    ;; here, so projections and earlier units' definitions survive.\n    [clj/run-main\n     (fn [body]\n       (do (clj/init!)\n           (clj/unwrap-outcome (body))))]])\n\n\n(def module-definitions\n  \"The module's definition list: an `:clj/uninit` placeholder for every\n   runtime key, then every definition, stripped.\"\n  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n\n229:(defn admit\n    [yang.php.antlr.cst :as php-cst]\n    [yang.php.antlr.lower :as php-lower]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.prelude :as php-prelude]\n    [yang.python.antlr.lower :as py-lower]\n    [yang.python.antlr.parser :as py-parser]\n    [yang.python.antlr.prelude :as py-prelude]\n    [yang.python.antlr.render :as py-render]\n    [yang.typescript.antlr.cst :as ts-cst]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as ts-lower]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]))\n\n\n(defn- publish-guest!\n  \"Publish guest module `spec` into the harness store, throwing immediately\n   with `result` in ex-data if publication is refused.\"\n  [spec]\n  (let [result (h/publish-guest-module! spec)]\n    (when (= :refused (:status result))\n      (throw (ex-info (str \"Guest module publication refused: \" (or (:reason result) (:status result)))\n                      result)))\n    result))\n\n\n(def ^:private published-php\n  \"`php` published once into `js`'s content store, pinning the same\n   `yang.call` revision (as `source-call-test` publishes it).\"\n  (delay (publish-guest!\n           (php-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(def ^:private published-py\n  \"`py` published beside `js` and `php`, over the same host registry and\n   `yang.call` revision.\"\n  (delay (publish-guest!\n           (py-prelude/module-spec (h/registry)\n                                   (:call-address @h/published)))))\n\n\n(def ^:private published-clj\n  \"`clj` published beside `js`, `php` and `py`, over the same host registry\n   and `yang.call` revision.\"\n  (delay (publish-guest!\n           (clj-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(defn- parse-ok\n  \"The CST packet of `source` under `parse`, refused unless the parse is ok.\"\n  [parse source]\n  (let [pk (parse source)]\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\n      (throw (ex-info \"donor or caller source does not parse\"\n                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\n    pk))\n\n\n(defn- python-export-symbol\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/clojure/donor_link_test.clj <<'EOF'\n(ns yang.clojure.donor-link-test\n  (:require [clojure.test :refer [deftest is]]\n            [yang.clojure :as clj]\n            [yang.clojure.prelude :as prelude]\n            [yang.core.module :as module]\n            [yang.core.prelude :as core]\n            [yang.core.uast :as u]\n            [yang.typescript.antlr.linked-harness :as h]\n            [yin.vm :as vm]))\n\n(deftest linked-donor-uses-runtime-context\n  (let [{:keys [store call-address]} @h/published\n        registry (prelude/admit (h/registry))\n        runtime (h/publish-guest-module\"'! (prelude/module-spec registry call-address))\n        unit (clj/lower-unit '\"'[(try (throw 42) (catch Exception e e))])\n        ast (module/module-tree [(module/require-node 'clj) (u/def\"'! '\"'body unit)])\n        spec (module/module-spec :test/refusal :test/undeclared registry\n                                 {:name 'test.clj-donor :ast ast :exports '#{body}\n                                  :runtime-name 'clj :runtime-address (:address runtime)\n                                  :deps {'yang.call call-address}})\n        donor (h/publish-guest-module\"'! spec)\n        source (yin.vm.linker.interpreter/composition\n                 {:content-store store :derivation :trusted\n                  :name-env {'\"'clj (:address runtime) 'yang.call call-address\n                             'test.clj-donor (:address donor)}})\n        program (u/sexp->uast '(do (require 'test.clj-donor)\n                                   (clj/run-main test.clj-donor/body)))]\n    (is (contains? prelude/module-exports 'rt-ctx))\n    (is (not (contains? (core/free-names unit) 'clj.rt/ctx)))\n    (is (contains? (core/free-names unit) 'clj/try))\n    (doseq [backend [:semantic :stack :register]]\n      (is (= 42 (vm/value (h/run-linked backend program {:modules registry :link-source source})))\n          (str backend)))))\nEOF\nclojure -M:test -n yang.clojure.donor-link-test > /private/tmp/donor-pin.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
