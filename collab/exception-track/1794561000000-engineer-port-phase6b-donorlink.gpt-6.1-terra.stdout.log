{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '55,100p' src/cljc/yang/core/module.cljc; sed -n '175,225p' src/cljc/yang/clojure/prelude.cljc; sed -n '3050,3120p' src/cljc/yang/clojure.cljc; sed -n '850,910p;980,1040p' test/yang/clojure_callsite_test.cljc\"","aggregated_output":"        (throw (ex-info \"the module reads an undeclared name\"\n                        {refusal-key refusal, :name n}))))))\n\n\n(defn free-primitives\n  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n  [refusal-key refusal registry covered ast]\n  (let [free (remove (conj (prelude/defined-keys ast) 'yin/def)\n                     (prelude/free-names ast))]\n    (into {}\n          (keep (partial declare-free-name refusal-key refusal registry covered))\n          (sort-by str free))))\n\n\n(defn module-spec\n  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n   ({module-symbol address}). A free name under a required module is covered\n   by it; any other is declared as `declare-free-name` does.\"\n  [refusal-key refusal registry\n   {:keys [name ast exports runtime-name runtime-address deps]}]\n  (let [requires (into {runtime-name runtime-address} deps)]\n    {:name name,\n     :ast ast,\n     :exports exports,\n     :requires requires,\n     :primitives (free-primitives refusal-key refusal registry\n                                  (set (keys requires)) ast)}))\n\n\n(defn alias-spec\n  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n   `body-key` exports.\"\n  [name exports require-profile bundle-name spec-key body-key]\n  {:name name,\n   :exports exports,\n   :primitives {'require require-profile},\n   :ast (module-tree\n          [(require-node bundle-name)\n           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n\n\n(defn scc-module-specs\n  \"The SCC publication shape: the `bundle` spec first, then the member alias\n\n(def module-definitions\n  \"The module's definition list: an `:clj/uninit` placeholder for every\n   runtime key, then every definition, stripped.\"\n  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n\n\n(def module-uast\n  \"The module tree: one wide application over the definitions, so every\n   sibling and runtime key read is discharged at module level. C1\n   finalized, like every production `yang.clojure` tree.\"\n  (yang/annotate-call-sites (core/module-tree module-definitions [])))\n\n\n(def module-exports\n  \"The module's exports: every `clj/` key of the definition list, stripped.\"\n  (core/exports \"clj\" definitions))\n\n\n(def ^:private module-free-names\n  \"The names the module tree reads and does not define, sorted: the host\n   exports its manifest must declare.\"\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `clj` over\n   the host registry `registry`, pinned to the published `yang.call`\n   module at `call-address` — the convention's call-address, as every\n   runtime's publication carries. A free name nothing supplies is refused\n   before anything is published. This namespace emits; it never publishes.\"\n  [registry call-address]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {'yang.call call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the clj module reads an undeclared name\",\n                     :refusal-ns \"yang.clojure\"}))\n\n\n(defn register-library-module\n  \"Return `registry` with host module `name` installed over `entries`\n   (`[export function]` pairs) at `arities`, each export pure.\"\n  [registry name entries arities]\n  (module/register-host-module\n    registry name\n    (into {} entries)\n    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n                node)\n    :lambda (assoc node :body (publish-to-globals (:body node) names\n                                                  (into bound (:params node))))\n    :application\n    (if (and (= 'yin/def (get-in node [:operator :name]))\n             (= 2 (count (:operands node)))\n             (= :literal (:type (first (:operands node))))\n             (contains? names (:value (first (:operands node)))))\n      (u/app (u/v 'clj/define-global!)\n             (u/lit (str (:value (first (:operands node)))))\n             (publish-to-globals (second (:operands node)) names bound))\n      (assoc node\n             :operator (publish-to-globals (:operator node) names bound)\n             :operands (mapv #(publish-to-globals % names bound)\n                             (:operands node))))\n    :if (cond-> node\n          (contains? node :test)\n          (assoc :test (publish-to-globals (:test node) names bound))\n          (contains? node :consequent)\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n          (contains? node :alternate)\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n    (reduce (fn [n k]\n              (let [v (get n k)]\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\n                  (assoc n k (globals-child v names bound))\n                  n)))\n            node (keys node))))\n\n\n(defn lower-unit\n  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n   thunk whose call runs the program — `forms` plus the definitions of\n   the guest library they need, compiled unmodified under `unit-opts`\n   and published to the runtime global namespace by\n   `publish-to-globals` — so the helper's export projection can read\n   each top-level definition. The two-argument form also takes the\n   projected `exports` (names the composition already bound in the\n   runtime global namespace): their free reads publish the same way, so\n   the projection is the caller's binding for them. The program's own\n   `yang.call` call sites need no free-name declaration: the convention\n   preamble `compile-program` emits defines those names locally, and\n   the donor publication pins the `yang.call` module for the qualified\n   reads that remain.\"\n  ([forms] (lower-unit forms []))\n  ([forms exports]\n   (let [source (vec forms)\n         library (library-for source)\n         program (compile-program (concat source library) true unit-opts)\n         macros (into #{}\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n                            (map (comp strip-symbol-meta second)))\n                      (concat source library))\n         names (reduce disj\n                       (into (set (top-level-names source))\n                             (concat (map (comp strip-symbol-meta second) library)\n                                     (map symbol exports)))\n                       macros)]\n     ;; `publish-to-globals` rewrites nodes after `compile-program`\n     ;; finalized them, so the unit is finalized again over its\n     ;; finished tree: the rewrite's own applications are occurrences.\n     (annotate-call-sites (u/lam [] (publish-to-globals program names #{}))))))\n\n\n(defn output\n  \"The `clj/run-main` value as test data.\"\n  [value]\n  (pr-str value))\n                           :ast ast\n                           :exports #{'f}\n                           :requires {}\n                           :primitives {'inc {:yin.k/profile :yin.k/pure\n                                              :yin.k/effects #{}}}})]\n          (is (= :refused (:status res)))\n          (is (= :yin.link.publish/unsupported-call-site-version\n                 (:reason res)))\n          (is (= bad-value (:unsupported-version res)))\n          (is (nil? (:address res))))))))\n\n\n(def ^:private publish-registry\n  \"The host registry the published-module test publishes over: the\n   `cell` and `data` host modules the `clj` and `yang.call` module\n   trees read.\"\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})))\n\n\n(deftest published-module-test\n  (testing \"the markers are retrievable from the published module\"\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module!\n                        store (call/module-spec publish-registry))\n          call-address (:address call-result)\n          clj-result (publish/publish-module!\n                       store (clj-prelude/module-spec publish-registry\n                                                      call-address))\n          clj-address (:address clj-result)]\n      (is (some? call-address))\n      (is (some? clj-address))\n      (doseq [[label result]\n              [[\"yang.call\" call-result]\n               [\"clj\" clj-result]]]\n        (testing label\n          (is (some? (get-in result [:call-sites :record]))\n              \"the publication retains its side table beside the manifest\")\n          (let [{:keys [tree origin rows]}\n                (publish/published-call-site-table store result)]\n            (is (some? rows)\n                \"the markers are retrievable from the published module\")\n            (is (pos? (count rows)))\n            (is (= (eligible-under tree origin) (marked rows)))\n            (is (true? (yang/validate-call-site-coverage!\n                         tree rows origin {:declared? true}))))))))\n  (testing \"an unscoped re-publication of the same specification is\n            the same recorded admission (the default admission identity\n            is derived from the specification's own durable inputs,\n            never a hidden counter), and a retrieval replays the one\n            recorded admission it names\"\n    (let [store (mem/create-content-mem)\n          ast (yang/compile-program '[(defn f\n                                        [x]\n                                        (inc x)) (f 2)])\n          spec {:name 'twin-admissions\n                :ast ast\n                :exports #{'f}\n                :requires {}\n                :primitives {'inc {:yin.k/profile :yin.k/pure\n                       {:yin.link.publish/admission \"pinned-admission\"})]\n          (is (some? (:address pinned)))\n          (is (= [:source :yin.vm.linker.publish/publish\n                  \"pinned-admission\" 0]\n                 (get-in pinned [:call-sites :origin]))\n              \"the pinned token is the admission identity, persisted in\n               the record and retrieved from it\")\n          (is (= [:source :yin.vm.linker.publish/publish\n                  \"pinned-admission\" 0]\n                 (:origin (publish/published-call-site-table\n                            store pinned))))))))\n  (testing \"an unannotated module publishes no table and claims none\"\n    (let [store (mem/create-content-mem)\n          plain (publish/publish-module!\n                  store {:name 'plain\n                         :ast {:type :application\n                               :operator {:type :variable :name 'yin/def}\n                               :operands [{:type :literal :value 'f}\n                                          {:type :literal :value 42}]}\n                         :exports #{'f} :requires {} :primitives {}})]\n      (is (some? (:address plain)))\n      (is (not (contains? plain :call-sites)))\n      (is (nil? (publish/published-call-site-table store plain)))))\n  (testing \"the manifest excludes the side table; the record names the manifest\"\n    (let [store (mem/create-content-mem)\n          result (publish/publish-module!\n                   store (clj-prelude/module-spec\n                           publish-registry\n                           (:address (publish/publish-module!\n                                       store\n                                       (call/module-spec publish-registry)))))\n          address (:address result)\n          manifest (jing/get store address nil)\n          record-address (get-in result [:call-sites :record])\n          record (jing/get store record-address nil)]\n      (is (not (contains? manifest :yin.module/call-sites))\n          \"the hashed manifest keeps the closed schema-1 key set\")\n      (is (every? jing/segment-address?\n                  ((juxt :table :record) (:call-sites result))))\n      (is (= address (:yang.call-site/manifest record))\n          \"the publication record names the manifest\")\n      (is (= address (get-in result [:call-sites :manifest])))\n      (is (= (:yin.module/tree manifest) (:yang.call-site/root record)))\n      (is (some? (jing/get store (get-in result [:call-sites :table]) nil)))\n      (is (some? record))\n      (is (some? (publish/published-call-site-table store record-address))\n          \"the record address alone retrieves the table\")\n      (is (nil? (publish/published-call-site-table\n                  store (:yin.module/tree manifest) record-address))\n          \"a record held to a manifest it does not name does not verify\")\n      ;; transfer: fetch exactly the closure the walk answers missing, as\n      ;; a dao.space.dht load does, into a fresh store; the side table\n      ;; travels only when its record and table are carried explicitly,\n      ;; since the closure no longer follows them\n      (let [fresh (mem/create-content-mem)]\n        (loop [n 0]\n          (let [w (closure/walk fresh address)]\n            (if (= :missing (:yin.link.closure/outcome w))\n              (do (jing/materialize!\n                    fresh (jing/get store (:address w) ::absent))\n                  (recur (inc n)))\n","exit_code":0,"status":"completed"}}
