c env ::top-level true) macro-env)\\\\\\\\n  2507\\\\\\\\t                     ;; sequence\\\\\\\\n  2508\\\\\\\\t                     :else\\\\\\\\n  2509\\\\\\\\t                     (cond-> {:type     :application\\\\\\\\n  2510\\\\\\\\t                              :operator {:type :lambda, :params ['_]\\\\\\\\n  2511\\\\\\\\t                                         :body (go rest-forms macro-env)}\\\\\\\\n  2512\\\\\\\\t                              :operands [(discard-result\\\\\\\\n  2513\\\\\\\\t                                           (compile-form head false\\\\\\\\n  2514\\\\\\\\t                                                         (assoc env ::top-level true) macro-env))]}\\\\\\\\n  2515\\\\\\\\t                       tail? (assoc :tail? true))))))]\\\\\\\\n  2516\\\\\\\\t       (annotate-call-sites\\\\\\\\n  2517\\\\\\\\t         (cond->> (go forms initial-macro-env)\\\\\\\\n  2518\\\\\\\\t           (outcomes? env) strip-top-outcome\\\\\\\\n  2519\\\\\\\\t           ;; The two sibling closures share one frame: separate bindings would\\\\\\\\n  2520\\\\\\\\t           ;; retain one extra helper environment in every closure a guest\\\\\\\\n  2521\\\\\\\\t           ;; captures (the machine-data validation bound notices).\\\\\\\\n  2522\\\\\\\\t           (outcomes? env) (#(u/app\\\\\\\\n  2523\\\\\\\\t                               (u/lam '[dsg__admitted? dsg__intra_call] %)\\\\\\\\n  2524\\\\\\\\t                               (u/sexp->uast\\\\\\\\n  2525\\\\\\\\t                                 '(fn [dsg__candidate]\\\\\\\\n  2526\\\\\\\\t                                    (if (data/map? dsg__candidate)\\\\\\\\n  2527\\\\\\\\t                                      ;; A map is offered to the dereference\\\\\\\\n  2528\\\\\\\\t                                      ;; only when the heap authenticates it\\\\\\\\n(ns yang.tails\\\\\\\\n  \\\\\\\\\\\\\\\"Tail marks over the Universal AST, shared by every stage that builds or\\\\\\\\n   rewrites a tree. A tail call pushes no frame on the VMs that honour the\\\\\\\\n   mark, so a mark is only sound for the tree it was computed over: a stage\\\\\\\\n   that wraps a body must strip every mark and recompute them over the whole\\\\\\\\n   derived tree, or a wrapped body's old tail calls would skip the wrapper.\\\\\\\\\\\\\\\"\\\\\\\\n  (:require\\\\\\\\n    [yin.vm :as vm]))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn mark-tails\\\\\\\\n  \\\\\\\\\\\\\\\"Set `:tail? true` on every application in tail position of a lambda body,\\\\\\\\n   through `if` branches. Definitions are never marked. Lowering relies on\\\\\\\\n   this for loops, which are self-applied lambdas: the recursive call and the\\\\\\\\n   sequencing lambda around it are both tail calls, so an iteration grows no\\\\\\\\n   continuation on the VMs that honour the mark.\\\\\\\\\\\\\\\"\\\\\\\\n  [node]\\\\\\\\n  (letfn [(walk\\\\\\\\n            [node tail?]\\\\\\\\n            (case (:type node)\\\\\\\\n              :lambda (assoc node :body (walk (:body node) true))\\\\\\\\n              :if (assoc node\\\\\\\\n                         :test (walk (:test node) false)\\\\\\\\n                         :consequent (walk (:consequent node) tail?)\\\\\\\\n                         :alternate (walk (:alternate node) tail?))\\\\\\\\n              :application\\\\\\\\n              (let [definition? (= 'yin/def (:name (:operator node)))\\\\\\\\n                    node (assoc node\\\\\\\\n                                :operator (walk (:operator node) false)\\\\\\\\n                                :operands (mapv #(walk % false)\\\\\\\\n                                                (:operands node)))]\\\\\\\\n                (if (and tail? (not definition?))\\\\\\\\n                  (assoc node :tail? true)\\\\\\\\n                  node))\\\\\\\\n              node))]\\\\\\\\n    (walk node false)))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn strip-tails\\\\\\\\n  \\\\\\\\\\\\\\\"`node` with every `:tail?` mark removed, at every depth and under every\\\\\\\\n   node type the row grammar knows, so `mark-tails` starts from nothing.\\\\\\\\\\\\\\\"\\\\\\\\n  [node]\\\\\\\\n  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\\\\\\\\n    (reduce (fn [n [field kind]]\\\\\\\\n              (case kind\\\\\\\\n                :node (update n field strip-tails)\\\\\\\\n                :nodes (update n field #(mapv strip-tails %))\\\\\\\\n                n))\\\\\\\\n            (dissoc node :tail?)\\\\\\\\n            slots)))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn remark-tails\\\\\\\\n  \\\\\\\\\\\\\\\"Strip every tail mark and recompute them over the whole of `node`.\\\\\\\\\\\\\\\"\\\\\\\\n  [node]\\\\\\\\n  (mark-tails (strip-tails node)))\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_13\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"sed -n '3830,3910p' docs/design/yang.antlr.md; rg -n 'condition-identical|saved-protocol|retain|later|clojure/protocol' test/yang/call/exception*.clj; rg -n 'reserved|check-program-symbols|check-binder|rewrite-ex-info' src/cljc/yang/clojure.cljc\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_13\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"sed -n '3830,3910p' docs/design/yang.antlr.md; rg -n 'condition-identical|saved-protocol|retain|later|clojure/protocol' test/yang/call/exception*.clj; rg -n 'reserved|check-program-symbols|check-binder|rewrite-ex-info' src/cljc/yang/clojure.cljc\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"on the stack. No caller-side rewrapping or language-pair cache is allowed.\\\\\\\\n\\\\\\\\nThese are in-task rules. A closure, continuation, cell, or live invocation\\\\\\\\nis not made portable by this convention. Linker/UCF custody and admission\\\\\\\\nstill govern task/host crossings; currently refused cell-bearing lifts\\\\\\\\nremain refused. Live closures in an invocation must not be placed in\\\\\\\\ncanonical literal data or sent as a purported portable request.\\\\\\\\n\\\\\\\\n#### 8.10.7 Normal return and escaping conditions\\\\\\\\n\\\\\\\\nNormal return is the value of ordinary Yin application. There is no\\\\\\\\nextra return continuation, completion packet around each result, or new\\\\\\\\nlanguage-specific return instruction.\\\\\\\\n\\\\\\\\nAn escaping source exception invokes the supplied raise exit with:\\\\\\\\n\\\\\\\\n```clojure\\\\\\\\n{:yang.call/reason :yang.call/thrown\\\\\\\\n :yang.call/value  original-thrown-value}\\\\\\\\n```\\\\\\\\n\\\\\\\\nThis is the argument to an exceptional continuation transfer, not an\\\\\\\\nordinary return. Returning an identical-looking map returns normal data.\\\\\\\\nLikewise, a source program throwing a map with these keys throws that\\\\\\\\nmap as the **payload of a new condition**; its shape is never evidence\\\\\\\\nthat it is already a condition to forward. No engine-effect value is\\\\\\\\nsynthesized.\\\\\\\\n\\\\\\\\nProtocol failures use qualified reasons such as\\\\\\\\n`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\\\\\\\\n`:yang.call/unsupported-binding`, with plain evidence. The caller maps\\\\\\\\nthem to a documented local exception form retaining the complete\\\\\\\\noriginal condition. Callee argument-binding failures retain the actual\\\\\\\\ncallee exception under `:yang.call/thrown`. These reasons do not extend\\\\\\\\n`dao.stream`'s outcome algebra.\\\\\\\\n\\\\\\\\nThe receiving caller interprets an escaping exception as follows:\\\\\\\\n\\\\\\\\n1. A payload valid as an exception in its own runtime retains that\\\\\\\\n   runtime's ordinary catching and identity behavior.\\\\\\\\n2. A runtime permitting arbitrary thrown values, such as JavaScript,\\\\\\\\n   may deliver the original payload directly.\\\\\\\\n3. A runtime requiring exception objects, such as Python or PHP,\\\\\\\\n   represents an otherwise foreign payload with its own\\\\\\\\n   `ForeignException`, retaining the complete condition and original\\\\\\\\n   payload. Catch-all catches this local object. Typed source catches\\\\\\\\n   match its local hierarchy, never guessed foreign class names.\\\\\\\\n\\\\\\\\n`ForeignException` is a proposed prelude-owned type, not a VM type.\\\\\\\\nUnchanged rethrow propagates the original condition without adding\\\\\\\\nwrappers. Raising a new exception creates a new condition. Crossing back\\\\\\\\ninto a runtime recognizing the original exception restores its original\\\\\\\\ntype and identity. Formatting a foreign payload must not implicitly\\\\\\\\ninvoke a foreign method.\\\\\\\\n\\\\\\\\nThe runtime associates its generated wrapper's identity with the retained\\\\\\\\ncondition for the wrapper's entire lifetime, separate from source-writable\\\\\\\\nattributes. The association normally lives in private wrapper-cell\\\\\\\\ncontents, or an equivalent task-owned identity structure with the same\\\\\\\\nlifetime. It survives storing or returning the wrapper after the creating\\\\\\\\ncall/catch activation has ended, and remains recoverable when that same\\\\\\\\nwrapper is rethrown in another activation. Temporary catch state alone is\\\\\\\\ninsufficient. Reachability/reclamation must retain the condition and its\\\\\\\\npayload while the wrapper is live, without an ambient registry.\\\\\\\\n\\\\\\\\nThe runtime must not detect wrappers or unwrap arbitrary maps by their\\\\\\\\nkey names. JavaScript may expose raw payloads for\\\\\\\\n`:yang.call/thrown`; its local exception for a protocol failure must still\\\\\\\\nretain that failure's qualified condition. Rethrowing the same generated\\\\\\\\nexception forwards that complete condition, including protocol reasons;\\\\\\\\nthrowing an unrelated value creates a new `:yang.call/thrown` condition.\\\\\\\\nSaved activation state refers to this identity-owned association; exiting\\\\\\\\nor restoring a catch does not destroy it.\\\\\\\\n\\\\\\\\nVM application/custody defects and host implementation failures remain\\\\\\\\noperational failures. Do not catch them broadly and relabel them as\\\\\\\\nsource exceptions. Existing explicit stream/module refusals keep their\\\\\\\\nsource mappings under the relevant profiles.\\\\\\\\n\\\\\\\\n#### 8.10.8 Cleanup, re-entry, and suspension\\\\\\\\n\\\\\\\\ntest/yang/call/exception_contract.clj:21:   `retain` returns normally before `later` raises from a new activation.\\\\\\\\ntest/yang/call/exception_contract.clj:36:              \\\\\\\\\\\\\\\"def retain(f):\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"    global saved\\\\\\\\\\\\\\\"\\\\\\\\ntest/yang/call/exception_contract.clj:39:              \\\\\\\\\\\\\\\"def later():\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"    raise saved\\\\\\\\\\\\\\\"\\\\\\\\ntest/yang/call/exception_contract.clj:55:        \\\\\\\\\\\\\\\"globalThis.retain = function(f) { try { return f(); } catch (e) { saved = e; return e; } };\\\\\\\\\\\\\\\"\\\\\\\\ntest/yang/call/exception_contract.clj:56:        \\\\\\\\\\\\\\\"globalThis.later = function() { throw saved; };\\\\\\\\\\\\\\\"\\\\\\\\ntest/yang/call/exception_contract.clj:66:        \\\\\\\\\\\\\\\"function retain($f) { global $saved; try { return $f(); } catch (Throwable $e) { $saved = $e; return $e; } }\\\\\\\\\\\\\\\"\\\\\\\\ntest/yang/call/exception_contract.clj:67:        \\\\\\\\\\\\\\\"function later() { global $saved; throw $saved; }\\\\\\\\\\\\\\\"\\\\\\\\ntest/yang/call/exception_contract.clj:78:        \\\\\\\\\\\\\\\"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \\\\\\\\\\\\\\\"\\\\\\