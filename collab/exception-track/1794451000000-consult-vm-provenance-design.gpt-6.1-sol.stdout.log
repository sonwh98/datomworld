n    15\t\n    16\t\n    17\t(defn module-symbol\n    18\t  \"The linker module name of source module `name` under language `prefix`\n    19\t   (\\\"py\\\", \\\"php\\\", \\\"js\\\"): `<prefix>m.` then the name with each dot a `$`,\n    20\t   so no linker module name is a dotted prefix of another.\"\n    21\t  [prefix name]\n    22\t  (symbol (str prefix \"m.\" (str/replace name \".\" \"$\"))))\n    23\t\n    24\t\n    25\t(defn require-node\n    26\t  \"(require 'm) as a tree node.\"\n    27\t  [m]\n    28\t  (u/sexp->uast (list 'require (list 'quote m))))\n    29\t\n    30\t\n    31\t(defn module-tree\n    32\t  \"A wide application: all definitions remain at module level.\"\n    33\t  [operands]\n    34\t  (prelude/wide-app operands))\n    35\t\n    36\t\n    37\t(defn declare-free-name\n    38\t  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n    39\t   when `covered` (the requirement-pinned module names) covers it. A name\n    40\t   no `vm/primitives` profile or host export supplies throws, with\n    41\t   `refusal` under `refusal-key` in its data.\"\n    42\t  [refusal-key refusal registry covered n]\n    43\t  (if (and (symbol? n) (some? (namespace n))\n    44\t           (contains? covered (symbol (namespace n))))\n    45\t    nil\n    46\t    (if-let [profile (vm/profile-of vm/primitives n)]\n    47\t      [n profile]\n    48\t      (if-let [address (module/host-export-profile registry n)]\n    49\t        (let [entry (module/module-entry (:modules registry)\n    50\t                                         (symbol (namespace n)))\n    51\t              f (get-in entry [:slice (symbol (name n))])]\n    52\t          [n {:yin.k/profile address,\n    53\t              :yin.k/effects\n    54\t              (get (:callable-effects registry) f #{})}])\n    55\t        (throw (ex-info \"the module reads an undeclared name\"\n    56\t                        {refusal-key refusal, :name n}))))))\n    57\t\n    58\t\n    59\t(defn free-p