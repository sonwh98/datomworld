\\\\t   (run! check-program-symbols! forms)\\\\\\\\n  2461\\\\\\\\t   (let [env (program-env forms opts)]\\\\\\\\n  2462\\\\\\\\t     ;; A discarded definition must not become a lexical binding in the\\\\\\\\n  2463\\\\\\\\t     ;; following definitions. Descriptor entry and body closures both capture\\\\\\\\n  2464\\\\\\\\t     ;; their environment: retaining the previous descriptor here doubles its\\\\\\\\n  2465\\\\\\\\t     ;; paths at each definition during machine-data validation and UCF lift.\\\\\\\\n  2466\\\\\\\\t     (letfn [(discard-result\\\\\\\\n  2467\\\\\\\\t               [ast]\\\\\\\\n  2468\\\\\\\\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\\\\\\\\n  2469\\\\\\\\t             (go\\\\\\\\n  2470\\\\\\\\t               [forms macro-env]\\\\\\\\n  2471\\\\\\\\t               (if (empty? forms)\\\\\\\\n  2472\\\\\\\\t                 (compile-literal nil tail?)\\\\\\\\n  2473\\\\\\\\t                 (let [head       (cond->> (first forms)\\\\\\\\n  2474\\\\\\\\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\\\\\\\\n  2475\\\\\\\\t                                    (outcomes? env) (lower-top-form env macro-env))\\\\\\\\n  2476\\\\\\\\t                       rest-forms (rest forms)]\\\\\\\\n  2477\\\\\\\\t                   (cond\\\\\\\\n  2478\\\\\\\\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\\\\\\\\n  2479\\\\\\\\t                     ;; lambda the encoder declares; later forms see the name\\\\\\\\n  2480\\\\\\\\t                     ;; only so the native defn lowering can yield to it.\\\\\\\\n  2481\\\\\\\\t                     (and (seq? head) (= 'defmacro (first head)))\\\\\\\\n  2482\\\\\\\\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\\\\\\\\n  2483\\\\\\\\t                       (cond-> {:type     :application\\\\\\\\n  2484\\\\\\\\t                                :operator {:type :lambda, :p