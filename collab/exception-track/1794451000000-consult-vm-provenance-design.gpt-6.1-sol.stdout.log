ed static property (`A::$s = 'x'`) is not type-checked; only a reference to it is (a source keyed by class and property, row 46), so assignment through the reference is checked and the direct assignment is not | checkpoint B audit (fixture package) | yang.php | P4 S10 (departure fixture from the object permutation alphabet) or earlier if the sprop write path gains a coercion | P3 |\n   865\t     ;; the module's binding when present, else `builtin`: used for\n   866\t     ;; `globals`, whose value is per module and so not in the builtins dict\n   867\t     (fn [g n builtin]\n   868\t       (let [c (cell/get g)\n   869\t             slot (get (get c :index) n :py/missing)]\n   870\t         (if (= slot :py/missing) builtin (get (get c :vals) slot))))]\n   871\t    [py/class-ns-get\n   872\t     ;; a name assigned in a class body, read in that body: the class\n   873\t     ;; namespace as it is now, else `fallback` (globals, then builtins)\n   874\t     (fn [cls name fallback]\n   875\t       (let [x (get (get (cell/get cls) :attrs) name :py/missing)]\n   876\t         (if (= x :py/missing) (fallback) x)))]\n   877\t\n   878\t    ;; ---------------------------------------------------------- functions\n   879\t    ;; A function's `spec` is static data from the lowering:\n   880\t    ;;   {:params [positional names] :star? bool :kwonly [names] :kwstar? bool}\n   881\t    ;; `defaults` holds the trailing positional defaults and `kwdefaults`\n   882\t    ;; [[name value] ...] the keyword-only ones, both evaluated at\n   883\t    ;; definition time. `code` takes one vector laid out as the parameters\n   884\t    ;; are written: positional, the *args tuple, keyword-only, the **kwargs\n   885\t    ;; dict.\n   886\t    [py/function-entry\n   887\t     ;; Generated boilerplate. Python functions are unbound here: a supplied\n   888\t     ;; receiver remains in the invocation but is not injected into args.\n   889\t     (fn [owner invocation]\n   890\t       (let [callee (get invocation :yang.call/callee :py/missing)\n   891\t             positional (get invocation :yang.call/positional :py/missing)\n   892\t             named (get invocation :yang.call/named :py/missing)\n   893\t             raise-exit (get invocation :yang.call/raise :py/missing)\n   894\t             binding-profile (get invocation :yang.call/binding-profile :py/missing)]\n   895\t         (if (if (= callee :py/missing) true\n   896\t                 (if (= positional :py/missing) true\n   897\t                     (if (= named :py/missing) true\n   898\t                         (if (= raise-exit :py/missing) true\n   899\t                             (not (= callee owner))))))\n   900\t           (raise-exit {:yang.call/reason :yang.call/invalid-invocation})\n   901\t           (if (not (= binding-profile :py/missing))\n   902\t             (raise-exit (assoc {:yang.call/reason :yang.call/unsupported-binding}\n   903\t                                :yang.call/binding-profile binding-profile))\n   904\t             (let [fc (cell/get owner)\n   905\t                   result (cell/new :py/None)]\n   906\t               (py/try\n   907\t                 (fn []\n   908\t                   (cell/set! result\n   909\t                              ((get fc :code)\n   910\t                               (py/bind-args fc positional named))))\n   911\t                 (fn [e]\n   912\t                   ;; A retained generated exception forwards its original\n   913\t                   ;; condition unchanged (no new wrapper); a fresh source\n   914\t                   ;; exception still becomes the plain §8.10.7 thrown\n   915\t                   ;; condition. Retention rides the exception's identity,\n   916\t                   ;; outside source-writable attributes.\n   917\t                   (let [retained (py/retained-condition e)]\n   918\t                     (raise-exit\n   919\t                       (if (= retained :py/missing)\n   920\t                         (assoc {:yang.call/reason :yang.call/thrown}\n   921\t                                :yang.call/value e)\n   922\t                         retained))))\n   923\t                 (fn [] (cell/get result))))))))]\n   924\t    [py/function-cell\n   925\t     (fn [name spec defaults kwdefaults code entry?]\n   926\t       (let [content (assoc (assoc (assoc (assoc (assoc (assoc {} :py/type :function)\n   927\t                                                        :name name)\n   928\t                                                 :spec spec)\n   929\t                                          :defaults defaults)\n   930\t                                   :kwdefaults kwdefaults)\n   931\t                            :code code)\n   932\t             f (cell/new content)]\n   933\t         (if entry?\n   934\t           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\n   935\t                                   (fn [invocation]\n   936\t                                     (py/function-entry f invocation))))\n   937\t               f)\n   938\t           f)))]\n   939\t    [py/make-function\n   940\t     (fn [name spec defaults kwdefaults code]\n   941\t       (py/function-cell name spec defaults kwdefaults code true))]\n   942\t    [py/make-builtin-function\n   943\t     (fn [name spec defaults kwdefaults code]\n   944\t       (py/function-cell name spec defaults kwdefaults code false))]\n   945\t    [py/fn-error\n  1020\t             n (data/count (get spec :params))\n  1021\t             given (data/count args)\n  1022\t             star (get spec :star?)]\n  1023\t         (if (if (get spec :no-kw) (< 0 (data/count kwargs)) false)\n  1024\t           (py/fn-error fc \"() takes no keyword arguments\")\n  1025\t           (if (if (< n given) (not star) false)\n  1026\t             (py/fn-error fc \"() takes too many positional arguments\")\n  1027\t             (let [state (py/bind-keywords\n  1028\t                           fc\n  1029\t                           (py/vconj (py/vconj (py/vconj [] (py/pad args n 0 []))\n  1030\t                                               (py/pad [] (data/count (get spec :kwonly)) 0 []))\n  1031\t                                     (if (get spec :kwstar?) (py/dict-new) nil))\n  1032\t                           kwargs\n  1033\t                           0)\n  1034\t                   slots (py/fill-defaults fc (get state 0) (get fc :defaults) n 0)\n  1035\t                   ko (py/fill-kwdefaults fc (get state 1) (get spec :kwonly) 0)\n  1036\t                   with-star (if star\n  1037\t                               (py/vconj slots\n  1038\t                                         (py/tuple (if (< n given) (data/subvec args n) [])))\n  1039\t                               slots)\n  1040\t                   with-ko (data/into with-star ko)]\n  1041\t               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\n  1042\t    [py/call (fn [f args] (py/call-kw f args []))]\n  1043\t    [py/condition-exception\n  1044\t     ;; Identity-owned provenance, separate from source-writable :attrs.\n  1045\t     ;; Attribute edits and leaving the creating activation preserve it;\n  1046\t     ;; reachability of the exception retains the entire condition/payload.\n  1047\t     ;; Only this constructor writes the private slot, never a guest marker\n  1048\t     ;; or a condition-shaped payload. No ambient identity registry is used.\n  1049\t     (fn [cls msg condition]\n  1050\t       (let [e (py/make-exc cls msg)]\n  1051\t         (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition))\n  1052\t             e)))]\n  1053\t    [py/retained-condition\n  1054\t     ;; The identity-owned slot a generated exception carries, read without\n  1055\t     ;; ever consulting source-writable :attrs; :py/missing when absent.\n  1056\t     ;; A local instance only: a foreign or forged value has no slot.\n  1057\t     (fn [e]\n  1058\t       (if (= (py/content-type e) :instance)\n  1059\t         (get (cell/get e) :py/retained-condition :py/missing)\n  1060\t         :py/missing))]\n  1061\t    [py/call-kw\n  1062\t     (fn [f args kwargs]\n  1063\t       (if (= (get f :py/type) :method)\n  1064\t         (py/call-kw (get f :fn) (data/into (py/vconj [] (get f :self)) args) kwargs)\n  1065\t         (if (= (py/content-type f) :class)\n  1066\t           (py/instantiate f args kwargs)\n  1067\t           (if (yang.call/eligible? f)\n  1068\t             (yang.call/invoke\n  1069\t               f args kwargs\n  1070\t               (fn [condition]\n  1071\t                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\n  1072\t                   (let [value (get condition :yang.call/value)]\n  1073\t                     (py/raise\n  1074\t                       (if (if (= (py/content-type value) :instance)\n  1075\t                             (py/subclass? (get (cell/get value) :class)\n  1076\t                                           py.b/BaseException)\n  1077\t                             false)\n  1078\t                         value\n  1079\t                         ;; A local hierarchy and fixed local message: neither\n  1080\t                         ;; foreign class names nor foreign methods participate.\n  1081\t                         (py/condition-exception\n  1082\t                           (py/make-class \"ForeignException\" py.b/Exception)\n  1083\t                           {:py/str \"foreign exception\"} condition))))\n  1084\t                   (py/raise\n  1085\t                     (py/condition-exception py.b/TypeError\n  1086\t                                             {:py/str \"object is not callable\"}\n  1087\t                                             condition)))))\n  1088\t             (if (= (py/content-type f) :function)\n  1089\t               (let [fc (cell/get f)]\n  1090\t                 ((get fc :code) (py/bind-args fc args kwargs)))\n  1091\t               (py/type-error {:py/str \"object is not callable\"}))))))]\n  1092\t    [py/instantiate\n  1093\t     (fn [cls args kwargs]\n  1094\t       (let [inst (py/make-instance cls)\n  1095\t             init (py/class-lookup cls \"__init__\")]\n  1096\t         ;; without __init__ only exception classes take arguments (they\n  1097\t         ;; become `args`); any other class takes none\n  1098\t         (do (if (= init :py/missing)\n  1099\t               (if (py/subclass? cls py.b/BaseException)\n  1100\t                 ;; the builtin exception constructor takes positional\n  1101\t                 ;; arguments only; an explicit __init__ binds keywords\n  1102\t                 (if (< 0 (data/count kwargs))\n  1103\t                   (py/type-error\n  1104\t                     (py/str (data/str-concat (get (cell/get cls) :name)\n  1105\t                                              \"() takes no keyword arguments\")))\n     1\t(ns yang.call.python-exception-test\n     2\t  \"Python boundary pins for ruling v2 R2/R3 + egress. Receivers and rethrows\n     3\t   are parsed source; malformed protocol delivery uses the shared boundary kit.\n     4\t   The focused local gate for the exception-py-r2r3 round: the python subset of\n     5\t   the shiva acceptance instrument, never a substitute for the full ledger.\"\n     6\t  (:require [clojure.test :refer [deftest is testing]]\n     7\t            [yang.call.conformance :as kit]\n     8\t            [yang.call.exception-contract :as contract]\n     9\t            [yang.call.exception-legs :as legs]\n    10\t            [yang.call.exception-probes :as probes]))\n    11\t\n    12\t\n    13\t(defn- check-fixture\n    14\t  \"Run one python fixture isolated on all three vector VMs and assert its\n    15\t   compliant `:expected` value on each backend.\"\n    16\t  [id]\n    17\t  (let [fixture (first (filter #(= id (:id %)) contract/fixtures))]\n    18\t    (testing (str id)\n    19\t      (doseq [[backend actual] (probes/run-fixture fixture)]\n    20\t        (is (= (:expected fixture) actual) (str backend))))))\n    21\t\n    22\t\n    23\t(defn- check-leg\n    24\t  \"Run one directed source pair/scenario and assert `legs/expected` per VM.\"\n    25\t  [id]\n    26\t  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\n    27\t    (testing (str id)\n    28\t      (doseq [[backend actual] (legs/run-leg leg)]\n    29\t        (is (= (legs/expected leg) actual) (str backend))))))\n    30\t\n    31\t\n    32\t(deftest ^:slow python-foreign-reception-test\n    33\t  ;; R2: an otherwise-foreign payload is wrapped in a generated local\n    34\t  ;; ForeignException; an already-local exception is delivered unchanged.\n    35\t  (check-fixture :python/local-reception)           ; stays green\n    36\t  (check-fixture :python/foreign-reception)         ; R→G\n    37\t  (check-fixture :python/retained-foreign-lifetime) ; R→G\n    38\t  ;; The clojure→python typed reception and stored-wrapper rethrow legs.\n    39\t  (check-leg [:clojure :python :typed-catch])\n    40\t  (check-leg [:clojure :python :unchanged-rethrow])\n    41\t  (check-leg [:clojure :python :retained-lifetime]))\n    42\t\n    43\t\n    44\t(deftest ^:slow python-protocol-reception-test\n    45\t  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n    46\t  ;; complete condition instead of collapsing into a bare TypeError.\n    47\t  (check-fixture :python/protocol-not-callable)\n    48\t  (check-fixture :python/protocol-invalid-invocation)\n    49\t  (check-fixture :python/protocol-unsupported-binding)\n    50\t  (check-fixture :python/saved-protocol-not-callable)\n    51\t  (check-fixture :python/saved-protocol-invalid-invocation)\n    52\t  (check-fixture :python/saved-protocol-unsupported-binding))\n    53\t\n    54\t\n    55\t(deftest ^:slow python-egress-sanity-test\n    56\t  ;; Egress forwards a retained generated exception's original condition and\n    57\t  ;; still produces the plain thrown condition for fresh/forged payloads.\n    58\t  (check-fixture :python/fresh-named)       ; stays green\n    59\t  (check-fixture :python/fresh-closure)     ; stays green\n    60\t  (check-fixture :python/binding)           ; stays green\n    61\t  (check-fixture :python/forged-retention)) ; stays green (R5: no source-writable forgery)\n    62\t\n    63\t\n    64\t(deftest ^:slow python-kit-parity-test\n    65\t  ;; Match exception-probes/protocol-condition and injected exactly: the\n    66\t  ;; refusal is produced by public validation, then delivered by a callable\n    67\t  ;; cell's raise exit through a parsed Python f() and bare re-raise.\n    68\t  (let [donor (kit/publish-donor! :python contract/boundary-source)\n    69\t        source \"def receive(f):\\n    try:\\n        return f()\\n    except BaseException as e:\\n        raise\\n\"\n    70\t        call (fn [callee args]\n    71\t               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n    72\t        observation\n    73\t        (kit/guard-exceptions-form\n    74\t          [:python]\n    75\t          (list 'let\n    76\t                ['condition (list 'get (call {} []) :condition)\n    77\t                 'injected\n    78\t                 (list 'cell/new\n    79\t                       (list 'assoc {} :yang.call/entry\n    80\t                             (list 'fn ['invocation]\n    81\t                                   (list (list 'get 'invocation :yang.call/raise)\n    82\t                                         'condition))))\n    83\t                 'result (call (kit/export-form :python \"receive\") ['injected])]\n    84\t                (kit/observation-map-form\n    85\t                  {:reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n    86\t                   :condition-identical (list '= 'condition (list 'get 'result :condition))})))\n    87\t        results (kit/run-exception-program\n    88\t                  donor (kit/compose-exception dono