       lane))\\\\n+            (str lane \\\\\\\": the transplanted proof never authenticates the forged map\\\\\\\"))))))\\\\n+\\\\n+\\\\n+(deftest test-exception-r3-modified-condition-refuses\\\\n+  (testing \\\\\\\"1: modifying a caught exception cannot change the retained\\\\n+            condition. The wrapper's identity still decodes to the genuine\\\\n+            condition, so the forged evidence is never forwarded.\\\\\\\"\\\\n+    (doseq [lane [:walker :semantic]]\\\\n+      (let [condition {:yang.call/reason :yang.call/not-callable\\\\n+                       :yang.call/data {:yang.call/callee :target}}]\\\\n+        (is (= [:yin.k/error condition]\\\\n+               (run-cell-program\\\\n+                 '[(defn receive\\\\n+                     [f]\\\\n+                     (try (f)\\\\n+                          (catch Exception e\\\\n+                            (let [g (fn [v] (throw v))]\\\\n+                              (g (assoc e\\\\n+                                        :yang.call/reason :yang.call/unsupported-binding\\\\n+                                        :yang.call/data {:forged true}))))))\\\\n+                   (receive marker-operand)]\\\\n+                 (cell-entry-node condition)\\\\n+                 lane))\\\\n+            (str lane \\\\\\\": the genuine retained condition survives modification\\\\\\\"))))))\\\\n+\\\\n+\\\\n+(deftest test-exception-r3-condition-field-preserved\\\\n+  (testing \\\\\\\"3: an ordinary :dsg__condition field in a transferred protocol\\\\n+            condition round-trips byte-identical, after immediate AND saved\\\\n+            rethrow: provenance lives outside the original map\\\\\\\"\\\\n+    (doseq [lane [:walker :semantic]]\\\\n+      (let [condition {:yang.call/reason :yang.call/not-callable\\\\n+                       :yang.call/data {:yang.call/callee :target}\\\\n+                       :dsg__condition :ordinary-evidence}]\\\\n+        (is (= [:yin.k/error condition]\\\\n+               (run-cell-program\\\\n+                 '[(defn receive\\\\n+                     [f]\\\\n+                     (try (f) (catch Exception e (throw e))))\\\\n+                   (receive marker-operand)]\\\\n+                 (cell-entry-node condition)\\\\n+                 lane))\\\\n+            (str lane \\\\\\\": immediate rethrow preserves the ordinary field\\\\\\\"))\\\\n+        (is (= [:yin.k/error condition]\\\\n+               (run-cell-program\\\\n+                 '[(def saved (cell/new nil))\\\\n+                   (defn retain\\\\n+                     [f]\\\\n+                     (try (f) (catch Exception e (cell/set! saved e) e)))\\\\n+                   (defn later\\\\n+                     []\\\\n+                     (throw (cell/get saved)))\\\\n+                   (let [retained (retain marker-operand)]\\\\n+                     (later))]\\\\n+                 (cell-entry-node condition)\\\\n+                 lane))\\\\n+            (str lane \\\\\\\": saved rethrow preserves the ordinary field\\\\\\\"))))))\\\\n+\\\\n+\\\\n (deftest test-outcome-safe-get\\\\n   (let [forms '[(defn safe-get\\\\n                   [coll key]\\\\n@@ -2617,9 +2843,12 @@\\\\n                               (let [raw (yang.call/entry f) v [raw]] (raw {}))]\\\\n                             library-opts lane 1000000)]\\\\n         (is (= :yin.k/error tag) \\\\\\\"a projected raw closure terminates\\\\\\\")\\\\n-        (is (= :yang.call/not-callable\\\\n-               (-> payload :yang.call/value :yang.call/reason))\\\\n-            \\\\\\\"a raw closure keeps the adoption's refusal (inside the boundary's §8.10.7 wrap)\\\\\\\"))\\\\n+        (is (= :yang.call/thrown (:yang.call/reason payload))\\\\n+            \\\\\\\"the boundary wraps the refusal in a NEW thrown condition\\\\\\\")\\\\n+        (is (= :yang.call/not-callable (-> payload :yang.call/value :yang.call/reason))\\\\n+            \\\\\\\"the adoption's refusal is the new condition's payload\\\\\\\")\\\\n+        (is (some? (get-in payload [:yang.call/value :yang.call/data :yang.call/callee]))\\\\n+            \\\\\\\"the refusal names the callee in its evidence\\\\\\\"))\\\\n       (doseq [entry [nil false]]\\\\n         (let [[tag payload] (run-library\\\\n                               [(list 'let ['m {:yang.call/entry entry :x 42} 'v '[m]]\\\\n@@ -2628,15 +2857,22 @@\\\\n           (is (= :yin.k/error tag) (str \\\\\\\"a \\\\\\\" (pr-str entry) \\\\\\\" entry is present, not absent\\\\\\\"))\\\\n           (is (= :yang.call/not-callable (:yang.call/reason payload))\\\\n               (str \\\\\\\"a \\\\\\\" (pr-str entry) \\\\\\\" entry reaches admission and refuses\\\\\\\"))))\\\\n-      (let [tail-run (run-library\\\\n-                       '[(defn tail-refusal\\\\n-                           []\\\\n-                           (let [five 5 v [five]] (five 1)))\\\\n-                         (tail-refusal)]\\\\n-                       library-opts lane 1000000)]\\\\n-        (is (= :yang.call/not-callable\\\\n-               (-> (second tail-run) :yang.call/value :yang.call/reason))\\\\n-            \\\\\\\"the refusal survives a tail-position value call (inside the §8.10.7 wrap)\\\\\\\"))\\\\n+      (let [[tag payload] (run-library\\\\n+                            '[(defn tail-refusal\\\\n+                                []\\\\n+                                (let [five 5 v [five]] (five 1)))\\\\n+                              (tail-refusal)]\\\\n+                            library-opts lane 1000000)]\\\\n+        (is (= :yin.k/error tag))\\\\n+        (is (= :yang.call/thrown (:yang.call/reason payload))\\\\n+            \\\\\\\"the refusal survives a tail-position value call inside a NEW thrown condition\\\\\\\")\\\\n+        (is (= {:yang.call/reason :yang.call/not-callable\\\\n+                :yang.call/data {:yang.call/callee 5}}\\\\n+               (:yang.call/value payload))\\\\n+            \\\\\\\"the inner refusal and the callee evidence are both pinned\\\\\\\")\\\\n+        (is (= {:yang.call/callee 5}\\\\n+               (get-in payload [:yang.call/value :yang.call/data]))\\\\n+            \\\\\\\"the callee evidence names the scalar callee\\\\\\\"))\\\\n       (doseq [[where form] [[1 '(five (boom) 2)] [2 '(five 1 (boom))]]]\\\\n         (let [[tag payload] (run-library\\\\n                               ['(defn boom\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/exception-track/1794341300000-reviewer-r3-exception-clojure.gpt-6-astra.stdout.log; cat docs/agents/build-n-test.md; cat .agents/skills/code-review-pr/references/review_checklist.md'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/exception-track/1794341300000-reviewer-r3-exception-clojure.gpt-6-astra.stdout.log; cat docs/agents/build-n-test.md; cat .agents/skills/code-review-pr/references/review_checklist.md'\\\",\\\"aggregated_output\\\":\\\"{\\\\\\\"type\\\\\\\":\\\\\\\"thread.started\\\\\\\",\\\\\\\"thread_id\\\\\\\":\\\\\\\"01a1c717-4f0c-7c13-803c-9b674b051abf\\\\\\\"}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"turn.started\\\\\\\"}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_0\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"I’ll read the architecture rules, R3/R5 rulings, and review skill, then trace the two-commit diff statically. I won’t edit files or rerun suites. I’m using the `code-review-pr` skill for this review.\\\\\\\\n\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_1\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'cat docs/design/datom.world.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_2\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'cat .agents/skills/code-review-pr/SKILL.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_2\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'cat .agents/skills/code-review-pr/SKILL.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"---\\\\\\\\nname: code-review-pr\\\\\\\\ndescription: >-\\\\\\\\n  Performs comprehensive, high-quality code reviews on Git pull requests, branches, commit ranges, or local working tree diffs. Analyzes code correctness, security, architecture, test coverage, and performance using automated diff analysis and structured review checklists.\\\\\\\\n---\\\\\\\\n\\\\\\\\n# Code Review PR Skill\\\\\\\\n\\\\\\\\n## Overview\\\\\\\\n\\\\\\\\nThe `code-review-pr` skill provides an end-to-end framework for conducting rigorous, actionable code reviews on Git pull requests, feature branches, commit ranges, or working tree diffs. It combines automated diff scanning via `scripts/pr_reviewer.py` with structured review checklists across security, correctness, architecture, performance, and testing.\\\\\\\\n\\\\\\\\nUse this skill whenever asked to:\\\\\\\\n- Review a pull request or feature branch (`git diff main...HEAD`).\\\\\\\\n- Review recent commits (`git diff HEAD~1` or commit range).\\\\\\\\n- Review uncommitted local changes (`git diff` or staged changes).\\\\\\\\n- Perform a security, quality, or architecture audit of proposed code changes.\\\\\\\\n\\\\\\\\n---\\\\\\\\n\\\\\\\\n## Quick Start\\\\\\\\n\\\\\\\\nRun the automated PR reviewer script to generate an initial risk assessment, churn metrics, and automated smell scan:\\\\\\\\n\\\\\\\\n```bash\\\\\\\\n# 1. Review branch changes against main (Default PR review)\\\\\\\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target main...HEAD\\\\\\\\n\\\\\\\\n# 2. Review last commit\\\\\\\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target HEAD~1\\\\\\\\n\\\\\\\\n# 3. Review uncommitted working tree changes\\\\\\\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target working\\\\\\\\n\\\\\\\\n# 4. Save review report to file\\\\\\\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target main...HEAD --output review_report.md\\\\\\\\n```\\\\\\\\n\\\\\\\\n---\\\\\\\\n\\\\\\\\n## Code Review Workflow\\\\\\\\n\\\\\\\\nFollow this step-by-step process when executing a code review:\\\\\\\\n\\\\\\\\n### Step 1: Run Automated Diff Analysis\\\\\\\\nExecute `scripts/pr_reviewer.py analyze` for the target Git ref/range. Review the output to determine:\\\\\\\\n- Total lines added/deleted and file churn distribution.\\\\\\\\n- High-risk modified files (e.g., Security/Auth, Database/Schema, Infrastructure, API Contracts).\\\\\\\\n- Test-to-source additions ratio.\\\\\\\\n- Automated static findings (hardcoded secrets, debug leftovers, swallowed exceptions, SQL injection risks).\\\\\\\\n\\\\\\\\n### Step 2: Deep-Dive Code Inspection\\\\\\\\nInspect the diffs for high-risk files using `git diff <target> -- <path>` or `view_file`. Focus on:\\\\\\\\n1. **Logic & Edge Cases**:\\\\\\\\n   - Boundary checks, null/nil handling, empty collections, zero division.\\\\\\\\n   - Resource leaks (unclosed streams, file handles, DB connections).\\\\\\\\n   - Race conditions, shared state mutation, concurrency locks.\\\\\\\\n2. **Security & Credentials**:\\\\\\\\n   - No hardcoded API keys, passwords, or tokens.\\\\\\\\n   - Input validation before execution or query interpolation.\\\\\\\\n   - Proper authorization checks on new or updated endpoints.\\\\\\\\n3. **Architecture & Contracts**:\\\\\\\\n   - Preserving backward compatibility on existing API functions/endpoints.\\\\\\\\n   - Proper module separation and clean interface boundaries.\\\\\\\\n4. **Test Coverage & Quality**:\\\\\\\\n   - Ensuring new source logic is accompanied by unit/integration tests.\\\\\\\\n   - Verifying tests validate actual assertions rather than just non-crashing execution.\\\\\\\\n\\\\\\\\n### Step 3: Reference Checklist & Severity Taxonomy\\\\\\\\nConsult [references/review_checklist.md](references/review_checklist.md) to classify findings:\\\\\\\\n- **P0 (Critical / Blocker)**: Security breaches, data loss risks, severe crashes, hardcoded credentials.\\\\\\\\n- **P1 (High / Must Address)**: Logic bugs, broken API contracts, swallowed exceptions, missing critical tests.\\\\\\\\n- **P2 (Medium / Recommended)**: Performance bottlenecks, code duplication, missing parameter validation.\\\\\\\\n- **P3 (Low / Suggestion)**: Minor formatting, naming improvements, leftover comments/TODOs.\\\\\\\\n\\\\\\\\n### Step 4: Formulate Structured Review Report\\\\\\\\nPresent findings to the user using the following template:\\\\\\\\n\\\\\\\\n```markdown\\\\\\\\n# 🔍 Code Review Report\\\\\\\\n\\\\\\\\n## Executive Summary\\\\\\\\n- **Target:** `<git-ref>`\\\\\\\\n- **Verdict:** `[ APPROVED | REQUEST CHANGES | COMMENT ]`\\\\\\\\n- **Overall Risk:** `[ LOW | MEDIUM | HIGH ]`\\\\\\\\n- **Metrics:** `X files changed, +Y / -Z lines`\\\\\\\\n\\\\\\\\n## 🚨 Critical Findings (P0 / P1)\\\\\\\\n- **[Severity]** `path/to/file.ext:L123` - Short issue description.\\\\\\\\n  ```diff\\\\\\\\n  - problematic code\\\\\\\\n  + suggested fix\\\\\\\\n  ```\\\\\\\\n\\\\\\\\n## 💡 Improvements & Suggestions (P2 / P3)\\\\\\\\n- **[Severity]** `path/to/file.ext` - Recommendation details.\\\\\\\\n\\\\\\\\n## 🧪 Test Coverage & Quality Assessment\\\\\\\\n- Evaluation of test ratio and edge case coverage.\\\\\\\\n\\\\\\\\n## 🌟 Positive Highlights\\\\\\\\n- Clean implementations, thorough documentation, or well-structured refactoring.\\\\\\\\n```\\\\\\\\n\\\\\\\\n---\\\\\\\\n\\\\\\\\n## Utility Script Reference\\\\\\\\n\\\\\\\\nThe bundled helper script `scripts/pr_reviewer.py` supports the following options:\\\\\\\\n\\\\\\\\n| Parameter | Type | Default | Description |\\\\\\\\n| :--- | :--- | :--- | :--- |\\\\\\\\n| `--target` | String | `main...HEAD` | Git range/ref (`main...HEAD`, `HEAD~1`, `staged`, `working`) |\\\\\\\\n| `--output` | String | None | File path to write report output |\\\\\\\\n| `--format` | String | `markdown` | Output format (`markdown` or `json`) |\\\\\\\\n| `--repo-dir` | String | Current Dir | Path to the target Git repository |\\\\\\\\n\\\\\\\\n---\\\\\\\\n\\\\\\\\n## Common Review Pitfalls\\\\\\\\n\\\\\\\\n1. **Nit Tunnel Vision**: Focusing heavily on formatting or naming while missing underlying logic bugs or edge-case crashes.\\\\\\\\n2. **Ignoring Test Ratio**: Approving large source code changes without verifying corresponding test coverage additions.\\\\\\\\n3. **Swallowing Symptoms**: Suggesting `try/except` wrappers around failing code rather than addressing root cause invalid inputs or broken state.\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_1\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'cat docs/design/datom.world.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"---\\\\\\\\ndescription: Core philosophy, foundational axioms, invariants, primitives (tuples, streams, host boundaries), architectural commitments, design principles, code style, and development workflow for datom.world\\\\\\\\n---\\\\\\\\n\\\\\\\\n# DATOM.WORLD ARCHITECTURAL FOUNDATIONS & DEVELOPMENT RULES\\\\\\\\n\\\\\\\\n## Core Philosophy\\\\\\\\n\\\\\\\\nEverything is data.\\\\\\\\nInterpretation > abstraction.\\\\\\\\nExplicit causality > implicit assumptions.\\\\\\\\nRestrictions are a feature.\\\\\\\\n\\\\\\\\n### Foundational Axioms\\\\\\\\n\\\\\\\\n1. **Everything is a Stream**: Portable I/O and system data flow through append-only streams; hosts may also install explicit local functions that perform direct I/O.\\\\\\\\n2. **Interpretation Creates Semantics**: Data is syntax; semantics only emerge through interpretation (one truth, many perspectives).\\\\\\\\n   At system scale, a \\\\\\\\\\\\\\\"system\\\\\\\\\\\\\\\" is an emergent property of interpreters of\\\\\\\\n   pure data, not an object, service, or stored artifact. Find the\\\\\\\\n   interpreters and the data they share to find the system.\\\\\\\\n3. **Code and State are Datoms**: Code (Universal AST) and runtime execution state are structured datoms, enabling syntax independence and structural reflection.\\\\\\\\n4. **Everything is a Continuation**: Computation is modeled as serializable, portable continuations that can pause, travel across streams, and resume anywhere.\\\\\\\\n\\\\\\\\n## Non-Negotiable Invariants\\\\\\\\n\\\\\\\\n- Do not introduce hidden global state.\\\\\\\\n- Do not introduce implicit control flow.\\\\\\\\n- Do not introduce callbacks; every callback is an event on a stream.\\\\\\\\n- Do not introduce shared mutable state.\\\\\\\\n- Do not collapse interpretation and execution into the same layer.\\\\\\\\n- Do not assume graphs: graphs must be constructed explicitly from tuples.\\\\\\\\n- Do not lose information (unitarity): streams are append-only and no datom is destroyed, only reinterpreted. The Universal AST is never lost: it is always retrievable wherever code is lowered, by address or by a query over its datoms. Every derived form (semantic vector, native images, indexes) is an interpretation of it and may drop facts only because the AST remains.\\\\\\\\n\\\\\\\\n## Tuples and Datoms\\\\\\\\n\\\\\\\\nTuples are elements in an open moduli space, graded by dimension $n$. A tuple can be any dimension/size.\\\\\\\\nA datom is the canonical persistent tuple `[e a v t m]` (entity, attribute, value, transaction, metadata). Persistent facts are immutable datoms.\\\\\\\\nSource scope belongs to the interpreter, never to an appended tuple slot. Queries keep physical sources as separate db-values and express union or joins explicitly.\\\\\\\\n\\\\\\\\nSee [`docs/design/datom.md`](./datom.md) for full specification.\\\\\\\\n\\\\\\\\n## Streams\\\\\\\\n\\\\\\\\n`dao.stream` is an I/O monad and the system's portable I/O ABI. Functions consume streams and produce streams.\\\\\\\\nHosts may install arbitrary local functions, including direct I/O; their availability and migration semantics must be explicit.\\\\\\\\nPortable behavior cannot assume them; portable side effects appear as stream emissions. Direct-I/O host modules are explicitly local and non-migratable (owner decision, 2026-10-23).\\\\\\\\nStreams are values that can be sent through streams.\\\\\\\\nStreams carry whatever values the consumer needs: no datom requirement, no privileged payload shape.\\\\\\\\n\\\\\\\\nA stream has no privileged reader, and its meaning is not in it. Any number\\\\\\\\nof interpreters may observe the same medium, and each constructs its own\\\\\\\\nsemantics from the same batches: a `yin.vm` evaluator observing a program\\\\\\\\nstream constructs CESK state and executes it; `dao.space.index` observing\\\\\\\\nthe very same stream materializes covered indexes, so `dao.space.query/q`\\\\\\\\nanswers Datalog over the program as it grows. Neither knows the other\\\\\\\\nexists. The medium is their only coupling, and each observer's ignorance of\\\\\\\\nthe other is load-bearing: the evaluator never consults an index to run,\\\\\\\\nand the index never evaluates a form to index it. This is how axiom 2\\\\\\\\nbecomes architecture: one stream, many interpretations, none of them\\\\\\\\nthe stream's own.\\\\\\\\n\\\\\\\\nFunctions can take anything and return anything.\\\\\\\\nAgents are functions, closures, or continuations in `yin.vm` that communicate portably with the outside world through `dao.stream`. Portable agent behavior is specified through stream effects; host-local functions may also perform direct I/O.\\\\\\\\n\\\\\\\\nSee [`docs/design/dao.stream.md`](./dao.stream.md) for full stream specification.\\\\\\\\nSee [`docs/design/yin.vm.streams-all-the-way-down.md`](./yin.vm.streams-all-the-way-down.md) for VM architecture.\\\\\\\\n\\\\\\\\n### Host Boundaries\\\\\\\\n\\\\\\\\nA host boundary is the dao.stream abstraction boundary; implementations do not add contracts.\\\\\\\\n[datom.world.abi.md](./datom.world.abi.md) owns the doctrine, owner rulings, taxonomy, floor and custody rules.\\\\\\\\n\\\\\\\\n## Architectural Commitments\\\\\\\\n\\\\\\\\n- **`dao.jing` is syntax, agents are semantics**: the content-addressed encoding stays passive and payload-agnostic.\\\\\\\\n- **Macros are stream topology**: an evaluator knows nothing about macro expansion; expansion happens on the syntax side of a medium boundary, upstream of any evaluator.\\\\\\\\n- **Peer observers, one stream**: a generic evaluator and `dao.space` independently observe the same stream topic, as described under Streams. This is not a claim about any two consumers regardless of what they consume.\\\\\\\\n- **Observers are independent and optional**: nothing requires a medium to have any particular set of consumers. Which observers exist for a stream is a per-composition choice, not a design-time commitment.\\\\\\\\n\\\\\\\\n## Design Principles\\\\\\\\n\\\\\\\\nCode quality is measured by malleability: how cheaply can changes adapt without breaking promises?\\\\\\\\nStigmergic coordination emerges from sharing data across streams.\\\\\\\\n\\\\\\\\n**Systems emerge from interpreters of pure data.** Streams are the\\\\\\\\ncomposition medium; each interpreter gives the same data a perspective\\\\\\\\nwithout collapsing interpretation into execution or owning the truth.\\\\\\\\n\\\\\\\\n- `dao.space` emerges from `dao.space.index` and `dao.space.query` over\\\\\\\\n  ordinary streams.\\\\\\\\n- ShiBi capability, metering, and budget emerge from different\\\\\\\\n  interpreters over the same tuples; no token object is stored.\\\\\\\\n- The four VMs interpret one Universal AST; many syntaxes feed that AST.\\\\\\\\n- The semantic AST in `dao.space` is queryable facts projected by the\\\\\\\\n  auto-index observer.\\\\\\\\n- Client and server are roles in one stigmergic behavior implemented by\\\\\\\\n  interpreters, not distinct kinds of nodes.\\\\\\\\n\\\\\\\\n**Derive, don't persist.** Before adding a tag, slot, or field to any\\\\\\\\ncanonical content-hashed structure (an AST grammar, a datom schema, a row\\\\\\\\nshape), check whether a correctly scoped Datalog query over\\\\\\\\n`dao.space.query/q` can already compute the fact. If it can, it belongs as a\\\\\\\\nquery or projection: new persisted structure migrates every downstream\\\\\\\\nconsumer and duplicates authority over a fact a query derives fresh. The\\\\\\\\nretired `:global` tag in\\\\\\\\n[`docs/design/yin.vm.code-as-tuples.md`](./yin.vm.code-as-tuples.md) is the\\\\\\\\ncase study, including the scoping bug that a naive query introduced.\\\\\\\\n\\\\\\\\nSee [`docs/agents/malleability.md`](../agents/malleability.md) for complete design guidance (cohesion, coupling, bounded complexity, evolution, testing strategy).\\\\\\\\nSee [`docs/agents/vocabulary.md`](../agents/vocabulary.md) for domain vocabulary reference (biology, economics, physics, philosophy).\\\\\\\\n\\\\\\\\n## Code Style\\\\\\\\n\\\\\\\\n- Prefer simple data over rich types.\\\\\\\\n- Prefer total functions over partial ones.\\\\\\\\n- Prefer declarative pipelines over imperative logic.\\\\\\\\n- Avoid cleverness.\\\\\\\\n- Name things after what they do to streams.\\\\\\\\n\\\\\\\\n## Development Workflow\\\\\\\\n\\\\\\\\n- Do not invent abstractions that hide streams.\\\\\\\\n- Do not suggest mainstream frameworks unless explicitly asked.\\\\\\\\n- Do not optimize prematurely.\\\\\\\\n- When uncertain, ask at the architectural level, not the implementation level.\\\\\\\\n- Explanations should align with Plan 9 / Datomic / Lisp lineage.\\\\\\\\n- Program store writes go through `engine/store-put`; any other store write\\\\\\\\n  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\\\\\\\\n  detects must be on its allowlist; its docstring states the residual it\\\\\\\\n  leaves to review.\\\\\\\\n\\\\\\\\n### Problem Decomposition\\\\\\\\n\\\\\\\\nIf a problem appears complex:\\\\\\\\n1. Decompose it into streams.\\\\\\\\n2. Identify invariants.\\\\\\\\n3. Restrict degrees of freedom.\\\\\\\\n4. Make causality explicit.\\\\\\\\n5. Let structure emerge from constraints.\\\\\\\\n\\\\\\\\n## Operational & Specialized Guides\\\\\\\\n\\\\\\\\n- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\\\\\\\\n- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\\\\\\\\n- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\\\\\\\\n- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; each orchestrator session has its own append-only log at `orchestrator-logs/<unix-time-stamp>-<brief-orchestrator-descriptive-name>.md` under the repository root.\\\\\\\\n- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_3\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'git status --short; git diff --stat 8cd9fc92..778747ce; cat collab/exception-track/1794960000000-owner-ruling-exception-uniformity-v2.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_3\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc 'git status --short; git diff --stat 8cd9fc92..778747ce; cat collab/exception-track/1794960000000-owner-ruling-exception-uniformity-v2.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"git: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-qM0X4zK5' (errno=Operation not permitted)\\\\\\\\n2026-11-11 03:12:50.730 xcodebuild[96658:121017272]  DVTFilePathFSEvents: Failed to start fs event stream.\\\\\\\\n2026-11-11 03:12:51.002 xcodebuild[96658:121017271] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\\\\\\\\\\\\\"Input/output error\\\\\\\\\\\\\\\". Using NSCachesDirectory instead.\\\\\\\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-l14Cl6P5' (errno=Operation not permitted)\\\\\\\\n2026-1