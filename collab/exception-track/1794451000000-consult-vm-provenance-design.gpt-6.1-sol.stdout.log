  (assoc-in state [:heap id] {:value v, :seal seal}))\n \n \n ;; =============================================================================\n@@ -2808,34 +2784,10 @@\n              :blocked? false})\n           :cell/set!\n           (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n-            ;; A retained carrier's contents are frozen for its lifetime:\n-            ;; the heap entry's issuer-side mark refuses every write, with\n-            ;; the same fail-closed convention `check-ref!` uses.\n-            (when (:retained (get-in state [:heap id]))\n-              (fail \"Cannot mutate a retained cell\"\n-                    {:reason :retained-cell, :effect :cell/set!,\n-                     :kind :cell-ref, :id id}))\n             {:state (heap-write state id (get-in state [:heap id :seal])\n                                 (:val effect)),\n              :value (:val effect),\n              :blocked? false})\n-          ;; The retained mint: like `:cell/new`, but the heap entry carries\n-          ;; the issuer-side `:retained` mark. Only a compiler-internal,\n-          ;; unpublished module binding produces this effect, so guest\n-          ;; `cell/new` can never mint a marked entry.\n-          :cell/new-retained\n-          (let [[id s'] (gensym (count-allocation state (:val effect)) \"cell\")\n-                ref (issue-ref s' :cell-ref id)]\n-            {:state (heap-write-retained s' id (:seal ref) (:val effect)),\n-             :value ref,\n-             :blocked? false})\n-          ;; The retained query: the same heap+seal predicate as\n-          ;; `:cell/authentic?`, plus the entry's `:retained` mark, answered\n-          ;; as data. A pure query: no state change, never fatal.\n-          :cell/retained?\n-          {:state state,\n-           :value (retained-ref? state (:cell effect)),\n-           :blocked? false}\n           ;; The cell-ref ruling of record: the same heap+seal predicate\n           ;; `check-ref!` consults (r10), answered as data instead of\n           ;; failing closed, so compiled call routing can ask the issuer\ndiff --git a/src/cljc/yin/vm/module.cljc b/src/cljc/yin/vm/module.cljc\nindex 5307e77f..0bc916ad 100644\n--- a/src/cljc/yin/vm/module.cljc\n+++ b/src/cljc/yin/vm/module.cljc\n@@ -410,31 +410,9 @@\n   (make-effect :cell/authentic? {:cell c}))\n \n \n-(defn new-retained-cell\n-  \"The retained mint: a new cell whose heap entry the issuer marks\n-   `:retained`. Published ONLY under the reserved-prefix name\n-   `cell/dsg__new-retained`, which guest source cannot spell (the yang\n-   compilers refuse the `dsg__` prefix in any source position), so a\n-   guest `cell/new` can never mint a marked entry. A marked entry's\n-   contents are frozen: `:cell/set!` refuses it for its lifetime.\"\n-  [v]\n-  (make-effect :cell/new-retained {:val v}))\n-\n-\n-(defn retained-cell?\n-  \"The pure retained query beside `authentic?`: did the heap issue `c`\n-   as a retained carrier (authentic, with the entry's `:retained` mark)?\n-   The engine answers from the heap entry, never from the value's shape,\n-   so a guest copy of a retained cell's contents answers false.\n-   Non-fatal, state unchanged.\"\n-  [c]\n-  (make-effect :cell/retained? {:cell c}))\n-\n-\n (def cell-module\n   \"The `cell` module definition. Registering it is a composition step.\"\n-  {'new new-cell, 'get get-cell, 'set! set-cell!, 'authentic? authentic-cell?\n-   'dsg__new-retained new-retained-cell, 'retained? retained-cell?})\n+  {'new new-cell, 'get get-cell, 'set! set-cell!, 'authentic? authentic-cell?})\n \n \n (def cell-profiles\n@@ -444,11 +422,7 @@\n    'get (vm/primitive-profile 'get :effectful [1] #{:cell/get} :none)\n    'set! (vm/primitive-profile 'set! :effectful [2] #{:cell/set!} :none)\n    'authentic? (vm/primitive-profile 'authentic? :effectful [1]\n-                                     #{:cell/authentic?} :none)\n-   'dsg__new-retained (vm/primitive-profile 'dsg__new-retained :effe