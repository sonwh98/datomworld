  (list 'data/content= (list 'data/count av-sym) n)\n  1262\t                    form\n  1263\t                    else))\n  1264\t            (if (outcomes? env) (arity-error-form fn-name source) (list 'data/count))\n  1265\t            (reverse arities))))\n  1266\t\n  1267\t\n  1268\t(defn- check-av-params!\n  1269\t  [params]\n  1270\t  (when-not (vector? params)\n  1271\t    (reject! \"fn parameters must be a vector\" {:params params}))\n  1272\t  (doseq [p params]\n  1273\t    (when (= '& p)\n  1274\t      (reject! \"Variadic fn parameters are not supported\" {:params params}))\n  1275\t    (check-binder! p params)))\n  1276\t\n  1277\t\n  1278\t(defn- outcome-node\n  1279\t  [tag value]\n  1280\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n  1281\t\n  1282\t\n  1283\t(defn- call-entry\n  1284\t  \"The unary public entry, closed over a private argument-vector body.\"\n  1285\t  []\n  1286\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1287\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1288\t        outcome (symbol (str reserved-prefix \"entry_outcome\"))\n  1289\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1290\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1291\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1292\t        binding-error (outcome-node\n  1293\t                        error-tag\n  1294\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1295\t                               (u/lit :yin.k/message)\n  1296\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1297\t                               (u/lit :yin.k/data)\n  1298\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1299\t                                      (u/lit :yang.call/named) named)))\n  1300\t        entry-body (u/let1\n  1301\t                     outcome\n  1302\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\n  1303\t                                (u/app (u/v body) positional)\n  1304\t                                binding-error)\n  1305\t                     (u/if-node (u/app (u/v 'dsg__equal)\n  1306\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\n  1307\t                                       (u/lit ok-tag))\n  1308\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1309\t                                (u/app raise\n  1310\t                                       (u/app (u/v 'yang.call/thrown)\n  1311\t                                              (u/app (u/v 'data/nth)\n  1312\t                                                     (u/v outcome) (u/lit 1))))))\n  1313\t        ;; The private lane forwards the body's outcome in tail position.\n  1314\t        ;; The public entry still converts outcomes to value/raise normally.\n  2820\t    (defn string?\n  2821\t      [x]\n  2822\t      (= :yin.k/ok (first (yin.k/outcome-of (data/str-length x)))))\n  2823\t    (defn with-meta\n  2824\t      [x m]\n  2825\t      (kind/with-meta x m))\n  2826\t    (defn coll?\n  2827\t      [x]\n  2828\t      (if (nil? x)\n  2829\t        false\n  2830\t        (= :yin.k/ok (first (yin.k/outcome-of (data/count x))))))\n  2831\t    (defn vector?\n  2832\t      [x]\n  2833\t      (if (nil? x)\n  2834\t        false\n  2835\t        (= :yin.k/ok (first (yin.k/outcome-of (data/peek x))))))\n  2836\t    (defn map?\n  2837\t      [x]\n  2838\t      (if (nil? x)\n  2839\t        false\n  2840\t        (= :yin.k/ok (first (yin.k/outcome-of (data/dissoc x))))))\n  2841\t    (defn set?\n  2842\t      [x]\n  2843\t      (if (nil? x)\n  2844\t        false\n  2845\t        (= :yin.k/ok (first (yin.k/outcome-of (data/disj x))))))\n  2846\t    (defn sequential?\n  2847\t      [x]\n  2848\t      (if (coll? x) (if (map? x) false (not (set? x))) false))\n  2849\t    (defn seq?\n  2850\t      [x]\n  2851\t      (if (sequential? x) (not (vector? x)) false))\n  2852\t    (defn list?\n  2853\t      [x]\n  2854\t      (seq? x))\n  2855\t    ;; The VM's rest returns a vector. Supply the source language's sequence\n  2856\t    ;; shape here without changing that VM primitive.\n  2857\t    (defn rest\n  2858\t      [coll]\n  2859\t      (let [v (vec coll)]\n  2860\t        (loop [i (- (count v) 1), acc '()]\n  2861\t          (if (< i 1) acc (recur (- i 1) (conj acc (data/nth v i)))))))\n  2862\t    (defn seq\n  2863\t      [x]\n  2864\t      (cond\n  2865\t        (nil? x) nil\n  2866\t        (if (coll? x) (empty? x) false) nil\n  2867\t        (seq? x) x\n  2868\t        (coll? x) (reverse (reverse x))\n  2869\t        :else (throw (ex-info \"seq of a non-collection is not supported\"\n  2870\t                              {:value x}))))\n  2871\t    (defn rem\n  2872\t      [a b]\n  2873\t      (cond\n  2874\t        (not (if (int? a) (int? b) false))\n  2875\t        (throw (ex-info \"rem requires integer operands\" {:a a :b b}))\n  2876\t        (= b 0) (throw (ex-info \"Divide by zero\" {:a a}))\n  2877\t        (< a 0) (- 0 (rem (- 0 a) b))\n  2878\t        (< b 0) (rem a (- 0 b))\n  2879\t        :else (loop [r a]\n  2880\t                (if (< r b) r (recur (- r b))))))\n  2881\t    (defn reverse\n  2882\t      [coll]\n  2883\t      (loop [s coll\n  2884\t             acc '()]\n  2885\t        (if (empty? s) acc (recur (rest s) (conj acc (first s))))))\n  2886\t    (defn cons\n  2887\t      [x coll]\n  2888\t      (conj (reverse (reverse coll)) x))\n  2889\t    (defn list\n  2890\t      ([] '())\n  2891\t      ([a] (conj '() a))\n  2892\t      ([a b] (conj '() b a))\n  2893\t      ([a b c] (conj '() c b a))\n  2894\t      ([a b c d] (conj '() d c b a))\n  2895\t      ([a b c d e] (conj '() e d c b a))\n170:   throw, naming the failed `:rule`.\"\n177:       (throw (ex-info \"Malformed call-