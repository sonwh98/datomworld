t  {:rule :reserved-name, :name name, :role role})\n   131\t\n   132\t\n   133\t(defn refuse-reserved!\n   134\t  \"Throw the Rule R refusal for `name` in `role`, merged with `data`.\"\n   135\t  ([role name] (refuse-reserved! role name {}))\n   136\t  ([role name data]\n   137\t   (throw (ex-info (str \"Reserved name \" name \" used as \"\n   138\t                        (clojure.core/name role))\n   139\t                   (merge data (reserved-name-defect role name))))))\n   140\t\n   141\t\n   142\t(defn check-params!\n   143\t  \"Refuse a lambda's binders where they would bind: a reserved name\n   144\t   (Rule R), and any binder that is not a symbol, refused as\n   145\t   `:non-symbol-parameter` with the binder's coarse `:kind`. A keyword\n   146\t   parameter would otherwise write any key into a named kernel's\n   147\t   environment, `:yin.k/store-of` included. `data` is merged into the\n   148\t   refusal. Returns `params`.\"\n   149\t  ([params] (check-params! params {}))\n   150\t  ([params data]\n   151\t   (when-let [p (some #(when (reserved-name? %) %) params)]\n   152\t     (refuse-reserved! :binder p data))\n   153\t   ;; the bad binder is boxed: a nil or false binder must not read as none\n   154\t   (when-let [[p] (some #(when-not (symbol? %) [%]) params)]\n   155\t     (throw (ex-info \"Lambda parameter is not a symbol\"\n   156\t                     (merge data\n   157\t                            {:reason :non-symbol-parameter,\n   158\t                             :kind (values/kind-of p)}))))\n   159\t   params))\n   160\t\n   161\t\n   162\t(defn check-bindings!\n   163\t  \"Refuse a supplied map (an env, a store, a registry) that binds a\n   164\t   reserved name. Returns `m`.\"\n   165\t  [role m]\n   166\t  (when (map? m)\n   167\t    (when-let [n (some #(when (reserved-name? %) %) (keys m))]\n   168\t      (refuse-reserved! role n)))\n   169\t  m)\n   170\t\n   171\t\n   172\t(defn definition-operator?\n   173\t  \"True when a map AST no