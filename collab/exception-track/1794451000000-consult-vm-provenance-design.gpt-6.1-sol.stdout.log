and 'or})\n1074:  \"True when evaluating `form` can produce an error outcome: a throw, or a\n1084:          (= 'throw head) true\n1217:          throw (lower-operand env (first ops) (fn [v] [error-tag v]))\n1322:            (throw e)))))))\n1407:                                                  (u/app (u/v 'dsg__condition_retained) (u/v err-val))\n1411:                                                           (u/app (u/v 'yang.call/thrown) (u/v err-val)))\n1471:        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\n1474:                                 (u/lit :clj/admission) witness))]\n1617:          condition (symbol (str reserved-prefix \"condition\"))\n1620:          refusal (symbol (str reserved-prefix \"refusal_condition\"))\n1621:          missing-exit (symbol (str reserved-prefix \"missing_raise_condition\"))\n1623:          ;; An ordinary `:yang.call/thrown` condition delivers its payload\n1625:          ;; condition)`, so the caught value IS the payload. A value\n1626:          ;; arriving without a qualified reason IS a guest throw payload\n  1638\t\n  1639\t(defn- call-node\n  1640\t  \"Call function cell node `f` with the arguments of `arguments`.\"\n  1641\t  [ctx f arguments refs]\n  1642\t  (let [[pos named] (lower-arguments ctx arguments refs)]\n  1643\t    (core/site :call\n  1644\t               (if (seq refs)\n  1645\t                 (app* 'php/call-with-binding-profile\n  1646\t                       f pos (or named (u/lit []))\n  1647\t                       (u/lit \"sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb\"))\n  1648\t                 (if named\n  1649\t                   (app* 'php/call-named f pos named)\n  1650\t                   (app* 'php/call f pos))))))\n  1651\t\n  1652\t\n  1653\t(defn- argument-chains\n  1654\t  \"The `chain` of each argument of `arguments`, for the language constructs\n  1655\t   that take variables (`isset`, `empty`, `unset`).\"\n  1656\t  [ctx n args]\n  1657\t  (mapv (fn [a]\n  1658\t          (let [ks (core/kids ctx a)\n  1659\t                e (first ks)\n  1660\t                c (when (and (= 1 (count ks)) (p/rule? e \"expression\"))\n  1661\t                    (first (core/rules ctx e \"chain\")))]\n  1662\t            (or c (unsupported! n :argument-form))))\n  1663\t        (core/rules ctx args \"actualArgument\")))\n  1664\t\n  1665\t\n  1666\t(defn- function-name\n  1667\t  \"`{:lc :written :fallback-lc :fallback}` for a call's `functionCallName`:\n  1668\t   the lower-cased fully qualified name and the name as written, plus the\n  1669\t   global name an unqualified call inside a namespace falls back to.\"\n  1670\t  [ctx n]\n  1671\t  (let [ks (core/kids ctx n)\n  1672\t        q (first ks)]\n  1673\t    (when-not (and (= 1 (count ks)) (p/rule? q \"qualifiedNamespaceName\"))\n  1674\t      (unsupported! n :dynamic-call))\n  1675\t    (let [{:keys [primary fallback]} (resolve-global-name ctx :function (qname-parts ctx q))]\n  1676\t      {:lc (str/lower-case primary),\n  1677\t       :written primary,\n  1678\t       :fallback-lc (some-> fallback str/lower-case),\n  1679\t       :fallback fallback})))\n  1680\t\n  1681\t\n  1682\t(defn- note-unknown-builtin!\n  1683\t  \"Warn when `lc` names a catalogue function that neither the unit declares\n  1684\t   nor the prelude supplies.\"\n  1685\t  [ctx n lc written]\n  1686\t  (when (and (contains? builtins/catalogue lc)\n  4508\t           (= lc \"closure\")\n  4509\t           (php/class-is? (if (nil? (get v :php/obj))\n  4510\t                            (get v :class)\n  4511\t                            (get (cell/get (get v :php/obj)) :class))\n  4512\t                          lc))\n  4513\t         false))]\n  4514\t    [php/throwable? (fn [v] (php/instance-of v \"throwable\"))]\n  4515\t    [php/throw-value\n  4516\t     (fn [v]\n  4517\t       (if (php/throwable? v)\n  4518\t         (php/raise (php/addref v))\n  4519\t         (php/throw-error \"Error\" \"Can only throw objects\")))]\n  4520\t    [php/match-repr\n  4521\t     (fn [v]\n  4522\t       (let [k (php/kind v)]\n  4523\t         (if (= k :int) (integer/format v)\n  4524\t             (if (= k :string) (data/str-concat \"'\" v \"'\")\n  4525\t                 (if (= k :bool) (if v \"true\" \"false\")\n  4526\t                     (if (= k :null) \"NULL\"\n  4527\t                         (if (= k :float) (php/to-string v)\n  4528\t                             (data/str-concat \"of type \"\n  4529\t                                              (if (nil? (get v :php/obj))\n  4530\t                                                (php/type-name k)\n  4531\t                                                (get (php/obj-state v) :class))))))))))]\n  4532\t    [php/unhandled-match\n  4533\t     (fn [v]\n  4534\t       (php/throw-error \"UnhandledMatchError\"\n  4535\t                        (data/str-concat \"Unhandled match case \" (php/match-repr v))))]\n  4536\t    [php/throwable-method\n  4537\t     ;; the Throwable accessors until P4 supplies real classes\n  4538\t     (fn [o lc name]\n  4539\t       (let [props (get o :props)]\n  4540\t         (if (= lc \"getmessage\") (get props \"message\")\n     1\t(ns yang.core.prelude\n     2\t  \"Emitter machinery shared by every language's runtime-profile prelude\n     3\t   (docs/design/yang.typescript.md §17, lift L1). A language supplies its\n     4\t   module's own namespace string, its uninit sentinel, its definition list\n     5\t   and its refusal namespace; everything here is a pure function of those.\"\n     6\t  (:require\n     7\t    [clojure.walk :as walk]\n     8\t    [yang.core.uast :as u]\n     9\t    [yin.vm :as vm]\n    10\t    [yin.vm.module :as module]))\n    11\t\n    12\t\n    13\t(defn define\n    14\t  \"`(yin/def (quote key) form)` in prelude notation: the key quoted, so\n    15\t   `sexp->uast` reads it as the literal symbol Rule R requires.\"\n    16\t  [key form]\n    17\t  (list 'yin/def (list 'quote key) form))\n    18\t\n    19\t\n    20\t(defn strip\n    21\t  \"`sym` without the module's own namespace `ns-str`; any other value as it\n    22\t   is. Qualified internal store keys stay qualified.\"\n    23\t  [ns-str sym]\n    24\t  (if (and (symbol? sym) (= ns-str (namespace sym)))\n    25\t    (symbol (name sym))\n    26\t    sym))\n    27\t\n    28\t\n    29\t(defn strip-form\n    30\t  \"A prelude-notation form with every symbol `strip`ped: references,\n    31\t   definition keys and quoted keys alike. Keywords, strings and the\n    32\t   keys of literal maps are untouched.\"\n    33\t  [ns-str form]\n    34\t  (walk/postwalk (partial strip ns-str) form))\n    35\t\n    36\t\n    37\t(defn placeholder\n    38\t  \"The `[k uninit]` definition for runtime key `k`, so each read of it is\n    39\t   discharged by an unconditional module-level definition.\"\n    40\t  [k uninit]\n    41\t  [k uninit])\n    42\t\n    43\t\n    44\t(defn module-definitions\n    45\t  \"The module's definition list: a `uninit` placeholder for every runtime\n    46\t   key (stripped of `ns-str`), then every definition, stripped.\"\n    47\t  [ns-str uninit runtime-keys definitions]\n    48\t  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n    49\t        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n    50\t        definitions))\n    51\t\n    52\t\n    53\t(defn wide-app\n    54\t  \"One application whose operands are `nodes` (in order), applied to a lambda\n    55\t   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n    56\t   linker's scanners discharge every body read of a sibling or runtime key;\n    57\t   a `then` chain would nest definitions in closure bodies.\"\n    58\t  [nodes]\n    59\t  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    60\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n    61\t\n    62\t\n    63\t(defn module-tree\n    64\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    65\t   the `trailing` UAST nodes.\"\n    66\t  [defs trailing]\n    67\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    68\t                  trailing)))\n    69\t\n    70\t\n    71\t(defn exports\n    72\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    73\t   stripped.\"\n    74\t  [ns-str definitions]\n    75\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    76\t             definitions)))\n    77\t\n    78\t\n    79\t(defn free-names\n    80\t  \"Every variable name some occurrence of the map AST `ast` reads\n    81\t   unbound by an enclosing lambda.\"\n    82\t  [ast]\n    83\t  (letfn [(walk-node\n    84\t            [acc node bound]\n    85\t            (cond\n    86\t              (vector? node) (reduce (fn [a n] (walk-node a n bound)) acc node)\n    87\t              (not (map? node)) acc\n    88\t              :else\n    89\t              (case (:type node)\n    90\t                :variable (if (contains? bound (:name node))\n    91\t                            acc\n    92\t                            (conj acc (:name node)))\n    93\t                :literal acc\n    94\t                :lambda (walk-node acc (:body node) (into bound (:params node)))\n    95\t                (reduce (fn [a v] (walk-node a v bound)) acc (vals node)))))]\n    96\t    (walk-node #{} ast #{})))\n    97\t\n    98\t\n    99\t(defn defined-keys\n   100\t  \"Every literal key the map AST `ast` defines with `yin/def`, at any\n","exit_code":0,"status":"completed"}}
