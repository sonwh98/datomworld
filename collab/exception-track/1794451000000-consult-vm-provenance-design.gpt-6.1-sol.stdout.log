rn; anything else\n   436\t   (maps, keywords, literals) is outside the supported surface.\"\n   437\t  [b pattern]\n   438\t  (cond\n   439\t    (and (symbol? b) (nil? (namespace b)) (not= '& b))\n   440\t    (when (reserved-name? b)\n  1308\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1309\t                                (u/app raise\n  1310\t                                       (u/app (u/v 'yang.call/thrown)\n  1311\t                                              (u/app (u/v 'data/nth)\n  1312\t                                                     (u/v outcome) (u/lit 1))))))\n  1313\t        ;; The private lane forwards the body's outcome in tail position.\n  1314\t        ;; The public entry still converts outcomes to value/raise normally.\n  1315\t        ;; The compiler's token packet - a two-element vector whose first\n  1316\t        ;; element is the compiler-held token - selects the private tail\n  1317\t        ;; lane on the SAME unary entry: no record unwrap, no map lookups.\n  1318\t        ;; A guest cannot forge it: the token is compiler-held and the\n  1319\t        ;; reserved-prefix regime refuses binding or shadowing it. Maps\n  1320\t        ;; keep the ordinary record path. The vector guard is required:\n  1321\t        ;; data/nth refuses non-vectors, and dsg__get reads vectors as\n  1322\t        ;; nil whenever the program defines its own get.\n  1323\t        packet (u/if-node\n  1324\t                 (u/app (u/v 'data/vector?) (u/v invocation))\n  1325\t                 ;; the packet is exactly two elements: the arity guard runs\n  1326\t                 ;; before data/nth so an empty or overlong vector refuses\n  1327\t                 ;; as an outcome instead of a host-side data refusal\n  1328\t                 (u/if-node\n  1329\t                   (u/app (u/v 'dsg__equal)\n  1330\t                          (u/app (u/v 'data/count) (u/v invocation))\n  1331\t                          (u/lit 2))\n  1332\t                   (u/if-node\n  1333\t                     (u/app (u/v 'dsg__equal)\n  1334\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\n  1335\t                            (u/v 'dsg__call_token))\n  1336\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\n  1337\t                     ;; a vector without the compiler-held token is NOT the\n  1338\t                     ;; record path: applying the body here would hand every\n  1339\t                     ;; forged vector the private lane. Refuse explicitly.\n  1340\t                     (u/lit [:yin.k/error\n  1341\t                             {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1342\t                              :yin.k/data {}}]))\n  1498\t                                                                      (u/lit false))\n  1499\t                                                           (u/lit false))\n  1500\t                                                (u/lit false))\n  1501\t                                     (u/lit false))\n  1502\t                          (u/lit false))\n  1503\t               (u/lit false))))\n  1504\t\n  1505\t\n  1506\t(defn- compile-guest-call\n  1507\t  \"Admit a source operator before common invocation. Only generated UAST\n  1508\t   implementation calls apply private closures directly.\"\n  1509\t  [callee-ast arguments-ast env tail?]\n  1510\t  (if-not (outcomes? env)\n  1511\t    (cond-> (u/app callee-ast arguments-ast)\n  1512\t      tail? (assoc :tail? true))\n  1513\t    (let [callee (symbol (str reserved-prefix \"callee\"))\n  1514\t          arguments (symbol (str reserved-prefix \"arguments\"))\n  1515\t          escape (symbol (str reserved-prefix \"raise_escape\"))\n  1516\t          condition (symbol (str reserved-prefix \"condition\"))\n  1517\t          result (symbol (str reserved-prefix \"call_result\"))\n  1518\t          condition->outcome (u/if-node\n  1519\t                               (u/app (u/v 'dsg__equal)\n  1520\t                                      (u/app (u/v 'dsg__get) (u/v condition)\n  1521\t                                             (u/lit :yang.call/reason))\n  1522\t                                      (u/lit :yang.call/thrown))\n  1523\t                               (outcome-node\n  1524\t                                 error-tag\n  1525\t                                 (u/app (u/v 'dsg__get) (u/v condition)\n  1526\t                                        (u/lit :yang.call/value)))\n  1527\t                               (outcome-node error-tag (u/v condition)))\n  1528\t          raise (u/lam [condition]\n  1529\t                       (assoc (u/app (u/v escape)\n  1530\t                                     (u/app (u/v 'dsg__assoc) (u/lit {})\n  1531\t                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n  1532\t                                            (u/lit :clj/outcome) condition->outcome))\n  1533\t                              :tail? true))\n  1534\t          common-call (u/let1\n  1535\t                        result\n  1536\t                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n  1537\t                               (u/lit []) raise)\n  1538\t                        (outcome-node ok-tag (u/v result)))\n  1539\t          refused (outcome-node\n  1540\t                    error-tag\n  1541\t                    (u/app (u/v 'yang.call/condition)\n  1542\t                           (u/lit :yang.call/not-callable)\n  1543\t                           (u/app (u/v 'dsg__assoc) (u/lit {})\n  1544\t                                  (u/lit :yang.call/callee) (u/v callee))))\n  2305\t  (if-not opts\n  2306\t    {}\n  2307\t    (do (when-not (= :arg-vector (:convention opts))\n  2308\t          (reject! \"Unknown compile-program convention\" {:opts opts}))\n  2309\t        (when-let [hit (seq (filter control-heads (:macros opts)))]\n  2310\t          (reject! \"A :macros entry names a compiler form\" {:macros (vec hit)}))\n  2311\t        (let [defined (into #{}\n  2312\t                            (keep (fn [f]\n  2313\t                                    (when (and (seq? f)\n  2314\t                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\n  2315\t                                               (symbol? (second f)))\n  2316\t                                      (strip-symbol-meta (second f)))))\n  2317\t                            forms)\n  2318\t              defined-fns (top-level-defined-fns forms (:macros opts))]\n  2319\t          ;; the compiler emits bare conj and vec (collection literals, apply),\n  2320\t          ;; so a program definition of either would capture them\n  2321\t          (when-let [hit (first (filter #{'conj 'vec} defined))]\n  2322\t            (reject! (str \"Defining \" hit \" would capture the argument-vector constructor\")\n  2323\t                     {:name hit}))\n  2324\t          (cond-> {::convention {:native (set (if (map? (:native opts))\n  2325\t                                                (keys (:native opts))\n  2326\t                                                (:native opts)))\n  2327\t                                 :arities (into {}\n  2328\t                                                (keep (fn [[sym profile]]\n  2329\t                                                        (when-let [a (if (map? profile)\n  2330\t                                                                       (:yin.k/arities profile)\n  2331\t                                                                       profile)]\n  2332\t                                                          [sym a])))\n  2333\t                                                (when (map? (:native opts)) (:native opts)))\n  2334\t                                 :macros (set (:macros opts))}\n  2335\t                   ::defined defined\n  2336\t                   ::defined-fns defined-fns\n  2337\t                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n  2338\t                                                  (= 'invoke-value (second %))\n  2339\t                                                  (:yin.k/invoker (meta (second %)))) forms))}\n  2340\t            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n  2341\t\n  2342\t\n  2343\t(defn- check-program-symbols!\n  2344\t  \"The program pre-pass. Quoted data is exempt. The reserved prefix names\n  2345\t   compiler temporaries, so no user symbol may carry it in ANY position\n  2346\t   (binder, reference, definition name); `loop` and `recur` are special forms,\n  2347\t   so they may only head a list, never stand as a value or a binder.\"\n  2348\t  [form]\n  2349\t  (cond\n  2350\t    (symbol? form)\n  2351\t    (do (when (reserved-name? form)\n  2352\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n  2353\t                   {:symbol form, :prefix reserved-prefix}))\n  2354\t        (when (and (nil? (namespace form)) (contains? #{'loop 'recur} form))\n  2355\t          (reject! (str form \" is only legal in operator position\") {:symbol form})))\n  2356\t    (seq? form)\n  2357\t    (when-not (= 'quote (first form))\n  2358\t      (let [head (first form)]\n  2359\t        (when (and (symbol? head) (reserved-name? head))\n  2360\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n  2361\t                   {:symbol head, :prefix reserved-prefix}))\n  2362\t        (when-not (symbol? head)\n  2363\t          (check-program-symbols! head))\n  2364\t        (run! check-program-symbols! (rest form))))\n  2365\t    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n  2366\t    (coll? form) (run! check-program-symbols! form)))\n  2367\t\n  2368\t\n  2369\t(defn- check-top-level-discard!\