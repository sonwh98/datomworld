iled to start fs event stream.\\\\n2026-11-11 03:14:50.576 xcodebuild[97216:121021580] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\\\\\"Input/output error\\\\\\\". Using NSCachesDirectory instead.\\\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-DSbbpV4D' (errno=Operation not permitted)\\\\n2026-11-11 03:14:51.248 xcodebuild[97221:121021627]  DVTFilePathFSEvents: Failed to start fs event stream.\\\\n2026-11-11 03:14:51.443 xcodebuild[97221:121021625] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\\\\\"Input/output error\\\\\\\". Using NSCachesDirectory instead.\\\\n  2540\\\\t                                      ;; any `:id` spelling may be asked\\\\n  2541\\\\t                                      ;; about and the r4 heap-id-language\\\\n  2542\\\\t                                      ;; discriminator is retired. A shape\\\\n  2543\\\\t                                      ;; the heap does not authenticate is\\\\n  2544\\\\t                                      ;; data: it falls to the witness\\\\n  2545\\\\t                                      ;; branch and, entryless, is no more\\\\n  2546\\\\t                                      ;; admitted than any other source map,\\\\n  2547\\\\t                                      ;; so its invocation stays ordinary\\\\n  2548\\\\t                                      ;; map data. An authenticated\\\\n  2549\\\\t                                      ;; reference dereferences; an\\\\n  2550\\\\t                                      ;; authenticated cell whose contents\\\\n  2551\\\\t                                      ;; carry no callable entry is not\\\\n  2552\\\\t                                      ;; admitted (authentication is not\\\\n  2553\\\\t                                      ;; authorization, rule 3), and the\\\\n  2554\\\\t                                      ;; call-site routing that consulted\\\\n  2555\\\\t                                      ;; here refuses it as not-callable.\\\\n  2556\\\\t                                      (let [dsg__cell-ref?\\\\n  2557\\\\t                                            (if (dsg__equal\\\\n  2558\\\\t                                                  (dsg__get dsg__candidate :type)\\\\n  2559\\\\t                                                  :cell-ref)\\\\n  2560\\\\t                                              (if (data/contains? dsg__candidate\\\\n  2561\\\\t                                                                  :id)\\\\n  2562\\\\t                                                (if (data/contains? dsg__candidate\\\\n  2563\\\\t                                                                    :seal)\\\\n  2564\\\\t                                                  (if (dsg__equal\\\\n  2565\\\\t                                                        (data/count dsg__candidate)\\\\n  2566\\\\t                                                        3)\\\\n  2567\\\\t                                                    (if (data/string?\\\\n  2568\\\\t                                                          (dsg__get dsg__candidate\\\\n  2569\\\\t                                                                    :seal))\\\\n  2570\\\\t                                                      (if (dsg__equal\\\\n  2571\\\\t                                                            (data/str-length\\\\n  2572\\\\t                                                              (dsg__get dsg__candidate\\\\n  2573\\\\t                                                                        :seal))\\\\n  2574\\\\t                                                            64)\\\\n  2575\\\\t                                                        true\\\\n  2576\\\\t                                                        false)\\\\n  2577\\\\t                                                      false)\\\\n  2578\\\\t                                                    false)\\\\n  2579\\\\t                                                  false)\\\\n  2580\\\\t                                                false)\\\\n  2581\\\\t                                              false)]\\\\n  2582\\\\t                                        (if dsg__cell-ref?\\\\n  2583\\\\t                                          (if (cell/authentic? dsg__candidate)\\\\n  2584\\\\t                                            (let [dsg__descriptor\\\\n  2585\\\\t                                                  (cell/get dsg__candidate)\\\\n  2586\\\\t                                                  dsg__entry\\\\n  2587\\\\t                                                  (dsg__get dsg__descriptor\\\\n  2588\\\\t                                                            :yang.call/entry)]\\\\n  2589\\\\t                                              (data/callable? dsg__entry))\\\\n  2590\\\\t                                            false)\\\\n  2591\\\\t                                          (let [dsg__entry\\\\n  2592\\\\t                                                (dsg__get dsg__candidate\\\\n  2593\\\\t                                                          :yang.call/entry)\\\\n  2594\\\\t                                                dsg__witness\\\\n  2595\\\\t                                                (dsg__get dsg__candidate\\\\n  2596\\\\t                                                          :clj/admission)]\\\\n  2597\\\\t                                            (if (data/callable? dsg__entry)\\\\n  2598\\\\t                                              (if (data/callable? dsg__witness)\\\\n  2599\\\\t                                                (dsg__equal\\\\n  2600\\\\t                                                  dsg__witness\\\\n  2601\\\\t                                                  (dsg__make_admission\\\\n  2602\\\\t                                                    (dsg__assoc dsg__candidate\\\\n  2603\\\\t                                                                :clj/admission\\\\n  2604\\\\t                                                                nil)))\\\\n  2605\\\\t                                                false)\\\\n  2606\\\\t                                              false))))\\\\n  2607\\\\t                                      false)))\\\\n  2608\\\\t                               ;; The intra-unit dispatcher: resolve the unit's public entry,\\\\n  2609\\\\t                               ;; apply it with the compiler's token packet [token args] - one\\\\n             (run-outcome [(list 'let [binding 5]\\\\n                                 '(let [f (fn [x] x)] (f 21)))]))))\\\\n    (testing (str \\\\\\\"a later source definition of \\\\\\\" binding)\\\\n      (is (= [:yin.k/ok 21]\\\\n             (run-outcome [(list 'def binding 5) '(defn f\\\\n                                                    [x]\\\\n                                                    x) '(f 21)]))))\\\\n    (testing (str \\\\\\\"raise through a parameter named \\\\\\\" binding)\\\\n      (is (= [:yin.k/error {:yin.k/message \\\\\\\"boom\\\\\\\", :yin.k/data {:x 21}}]\\\\n             (run-outcome\\\\n               ['(defn g\\\\n                   []\\\\n                   (throw (ex-info \\\\\\\"boom\\\\\\\" {:x 21})))\\\\n                (list 'defn 'f [binding] '(g))\\\\n                '(+ 1 (f 5))])))))\\\\n  (is (= [:yin.k/ok 1]\\\\n         (run-outcome '[(def f (let [get 5] (fn [x] x))) (f 1)]))))\\\\n\\\\n\\\\n(deftest test-common-call-source-admission\\\\n  (doseq [form '[(let [x 5] (x 1))\\\\n                 (let [x {:ordinary :map}] (x 1))\\\\n                 (let [x {:yang.call/entry 5}]