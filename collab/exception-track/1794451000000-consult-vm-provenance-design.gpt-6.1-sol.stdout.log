tiated, an instance of\n   756\t     ;; one is raised as is, anything else is a TypeError\n   757\t     (fn [x]\n   758\t       (let [t (py/content-type x)]\n   759\t         (if (if (= t :class) (py/subclass? x py.b/BaseException) false)\n   760\t           (py/call x [])\n   761\t           (if (if (= t :instance)\n   762\t                 (py/subclass? (get (cell/get x) :class) py.b/BaseException)\n   763\t                 false)\n   764\t             x\n   765\t             (py/type-error {:py/str \"exceptions must derive from BaseException\"})))))]\n   766\t    [py/subclass?\n   767\t     (fn [c target]\n   768\t       (if (= c :py/None)\n   769\t         false\n  1034\t                   slots (py/fill-defaults fc (get state 0) (get fc :defaults) n 0)\n  1035\t                   ko (py/fill-kwdefaults fc (get state 1) (get spec :kwonly) 0)\n  1036\t                   with-star (if star\n  1037\t                               (py/vconj slots\n  1038\t                                         (py/tuple (if (< n given) (data/subvec args n) [])))\n  1039\t                               slots)\n  1040\t                   with-ko (data/into with-star ko)]\n  1041\t               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\n  1042\t    [py/call (fn [f args] (py/call-kw f args []))]\n  1043\t    [py/condition-exception\n  1044\t     ;; Identity-owned provenance, separate from source-writable :attrs.\n  1045\t     ;; Attribute edits and leaving the creating activation preserve it;\n  1046\t     ;; reachability of the exception retains the entire condition/payload.\n  1047\t     ;; Only this constructor writes the private slot, never a guest marker\n  1048\t     ;; or a condition-shaped payload. No ambient identity registry is used.\n  1049\t     (fn [cls msg condition]\n  1050\t       (let [e (py/make-exc cls msg)]\n  1051\t         (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition))\n  1052\t             e)))]\n  1053\t    [py/retained-condition\n  1054\t     ;; The identity-owned slot a generated exception carries, read without\n  1055\t     ;; ever consulting source-writable :attrs; :py/missing when absent.\n  1056\t     ;; A local instance only: a foreign or forged value has no slot.\n  1057\t     (fn [e]\n  1058\t       (if (= (py/content-type e) :instance)\n  1059\t         (get (cell/get e) :py/retained-condition :py/missing)\n  1060\t         :py/missing))]\n  1061\t    [py/call-kw\n  1062\t     (fn [f args kwargs]\n340:  (if (namespace sym)\n341:    (symbol (namespace sym) (name sym))\n427:  (when-not (and (symbol? sym) (nil? (namespace sym)))\n467:            (when-not (and (symbol? sym) (nil? (namespace sym)) (not= '& sym))\n795:;; The dispatch names are module-qualified, which no let binder can shadow.\n818:(defn- native-name?\n825:         (or (some? (namespace sym))\n3236:   the donor publication pins the `yang.call` module for the qualified\n  1608\t                                           (u/lit :yang.call/invalid-invocation)\n  1609\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n  1610\t                       u/capture)\n  1611\t          routed (if (::invoker env)\n  1612\t                   (u/if-node\n  1613\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n  1614\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n  1615\t                                           (u/lit true)\n  1616\t                                           ;; the shape is only WHEN to ask (ruling of\n  1617\t                                           ;; record, rule 2): the heap answers\n  1618\t                                           ;; `cell/authentic?`, and an unauthenticated\n  1619\t                                           ;; shape takes ordinary map invocation\n  1620\t                                           (u/if-node (cell-ref-shaped-node (u/