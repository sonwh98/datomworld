5\t    (if (constant-form? form)\n  2146\t      (compile-literal form tail?)\n  2147\t      (compile-constructed-collection form tail? env macro-env))\n  2148\t    ;; The empty list is self-evaluating data, not an application\n  2149\t    (and (seq? form) (empty? form)) (compile-literal form tail?)\n  2150\t    ;; Variables (symbols)\n  2151\t    (symbol? form) (if (native-name? env form)\n  2152\t                     (if (outcomes? env)\n  2153\t                       (compile-call-descriptor (compile-adapter form env false macro-env) tail?)\n  2154\t                       (compile-adapter form env tail? macro-env))\n  2155\t                     (compile-variable form tail?))\n  2156\t    ;; Special forms and function application\n  2157\t    (seq? form)\n  2158\t    (let [[operator & operands] form]\n  2159\t      (cond\n  2160\t        ;; dao.stream.apply call: (dao.stream.apply/call :op/name arg1 arg2)\n163:   4 `integer` exports included, through `admit` before a program runs.\n168:   module `py` (`module-exports`, `module-spec`), which a linked program\n204:  \"Module exports the prelude calls.\"\n3710:(def module-name\n3715:(def runtime-keys\n3740:  (core/module-definitions \"py\" :py/uninit runtime-keys definitions))\n3753:(def module-exports\n3754:  \"The module's exports: every `py/` key of the definition list,\n3756:  (core/exports \"py\" definitions))\n3772:   primitives and the host exports its manifest must declare.\"\n3783:  (core/module-spec {:module-name module-name,\n3785:                     :exports module-exports,\n    35\t   :scc-module-specs (fn [registry units py-address deps]\n    36\t                       (lower/scc-module-specs registry units py-address call-address deps)),\n    37\t   :site-set siteset/publish!,\n    38\t   :binder-table nil,\n    39\t   :refusal-ns \"yang.python.antlr\",\n    40\t   :publish-fn publish-fn})\n    41\t\n    42\t\n    43\t(defn publication-order\n    44\t  \"Dependency-first names, retaining the I3 order for acyclic units.\n    45\t   Cyclic components appear as sorted member vectors in :order, one\n    46\t   publication step per SCC. External imports must be in `published`.\"\n    47\t  [units published]\n    48\t  (core/publication-order (config publish/publish-module! nil) units published))\n    49\t\n    50\t\n    51\t(defn publish-units!\n    52\t  \"Publish `units` (`[{:name :package? :packet}]`) into the content store\n    53\t   `handle` over the host registry `registry`, `py` pinned at\n    54\t   `py-address` and each import outside the set at its address in\n    55\t   `published` ({python-name address}), in `publication-order`. Answers\n    56\t   `{:status :ok :addresses {python-name address}\n    57\t     :bundles {bundle-symbol address}\n    58\t     :sites {python-name-or-bundle-symbol site-publication}}` for the units\n    59\t   of the set (`siteset/publish!`'s answer for each module published beside\n    60\t   its code image, I7; an SCC member alias carries no marks and so no\n    61\t   entry, its bundle does). The publisher that asserts these names\n    62\t   indexes `siteset/signed-entries` of `:sites` in the same index\n    63\t   transaction; a module whose entry is missing is refused by every\n    64\t   hook-profile reader. Or the\n    65\t   first refusal: `publication-order`'s before anything is written, else\n    66\t   `publish-module!`'s with a string `:unit`: the Python name for a member,\n    67\t   or the bundle module name for an SCC bundle. Every bundle name must be\n    68\t   asserted/bound alongside the member names for aliases to deliver.\n    69\t   Optional `publish-fn` takes `[handle spec]`, defaulting to\n    70\t   `publish/publish-module!`, for both bundles and members.\"\n    71\t  ([handle registry py-address units]\n    72\t   (publish-units! handle registry py-address units {}))\n    73\t  ([handle registry py-address units published]\n    74\t   (publish-units! handle registry py-address units published publish/publish-module!))\n    75\t  ([handle registry py-address units published publish-fn]\n    76\t   (let [py-manifest (when (and handle py-address)\n    77\t                       (jing/get handle py-address nil))\n    78\t         call-address (get-in py-manifest [:yin.module/requires 'yang.call])]\n    79\t     (core/publish-units! (config publish-fn call-address)\n    80\t                          handle registry py-address units published))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"I’m settling on one opaque heap slot and one shared reserved mint/read pair. Python and PHP should adopt it for generated wrappers; Clojure needs it for protocol exceptions even after the continuation port. JS can keep its shipped identity store for now. The adoption work must also keep provenance-writing helpers private: exporting a helper that accepts an arbitrary condition would bypass the reserved mint door."}}
