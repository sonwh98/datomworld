{"type":"item.started","item":{"id":"item_156","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('test/yang/call/python_exception_test.clj')\nassert not p.exists()\np.write_text(r'''(ns yang.call.python-exception-test\n  \\\"Python boundary pins for ruling v2 R2/R3. Receivers and rethrows are\n   parsed source; malformed protocol delivery uses the shared boundary kit.\\\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]\n            [yang.call.exception-probes :as probes]))\n\n\n(defn- check-fixture\n  [id & [source]]\n  (let [fixture (cond-> (first (filter #(= id (:id %)) contract/fixtures))\n                  source (assoc :source source))]\n    (testing (str id)\n      (doseq [[backend actual] (probes/run-fixture fixture)]\n        (is (= (:expected fixture) actual) (str backend))))))\n\n\n(deftest \"'^:slow python-foreign-reception-test\n  (check-fixture :python/local-reception)\n  (check-fixture :python/foreign-reception)\n  (testing \"real Clojure source throws; Python catches a local ForeignException\"\n    (let [leg (first (filter #(= [:clojure :python :typed-catch] (:id %))\n                             contract/pair-matrix))]\n      (doseq [[backend actual] (legs/run-leg leg)]\n        (is (= (legs/expected leg) actual) (str backend))))))\n'\"''')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
