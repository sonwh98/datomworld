gpt-6-astra.stdout.log:33:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_16\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba src/cljc/yin/vm/module.cljc | sed -n '372,420p'; nl -ba src/cljc/yang/clojure.cljc | sed -n '2070,2110p'; nl -ba test/yang/call/conformance.clj | sed -n '185,218p'; rg -n 'mapv|defn map|defn partial|defn comp|defn reduce' src/cljc/yang/clojure.cljc | tail -15\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"   372\\\\t\\\\n   373\\\\t\\\\n   374\\\\t;; =============================================================================\\\\n   375\\\\t;; The `cell` module\\\\n   376\\\\t;; =============================================================================\\\\n   377\\\\t;;\\\\n   378\\\\t;; A cell is a mutable location in the task's `:heap`, reached by a sealed\\\\n   379\\\\t;; `:cell-ref` (Architect cell ruling, slice 1). These are pure effect\\\\n   380\\\\t;; constructors like the stream module's: they touch no heap, and the engine\\\\n   381\\\\t;; interprets the effects they return. The heap is VM state, so a mutation\\\\n   382\\\\t;; is shared by every closure over the ref and is never rolled back when a\\\\n   383\\\\t;; continuation is invoked (box semantics).\\\\n   384\\\\t\\\\n   385\\\\t(defn new-cell\\\\n   386\\\\t  [v]\\\\n   387\\\\t  (make-effect :cell/new {:val v}))\\\\n   388\\\\t\\\\n   389\\\\t\\\\n   390\\\\t(defn get-cell\\\\n   391\\\\t  [c]\\\\n   392\\\\t  (make-effect :cell/get {:cell c}))\\\\n   393\\\\t\\\\n   394\\\\t\\\\n   395\\\\t(defn set-cell!\\\\n   396\\\\t  [c v]\\\\n   397\\\\t  (make-effect :cell/set! {:cell c, :val v}))\\\\n   398\\\\t\\\\n   399\\\\t\\\\n   400\\\\t(def cell-module\\\\n   401\\\\t  \\\\\\\"The `cell` module definition. Registering it is a composition step.\\\\\\\"\\\\n   402\\\\t  {'new new-cell, 'get get-cell, 'set! set-cell!})\\\\n   403\\\\t\\\\n   404\\\\t\\\\n   405\\\\t(def cell-profiles\\\\n   406\\\\t  \\\\\\\"UCF 7.5.2 profiles for the `cell` module's bindings: each an\\\\n   407\\\\t   `:effectful` pure effect constructor declaring its one effect kind.\\\\\\\"\\\\n   408\\\\t  {'new (vm/primitive-profile 'new :effectful [1] #{:cell/new} :none)\\\\n   409\\\\t   'get (vm/primitive-profile 'get :effectful [1] #{:cell/get} :none)\\\\n   410\\\\t   'set! (vm/primitive-profile 'set! :effectful [2] #{:cell/set!} :none)})\\\\n   411\\\\t\\\\n   412\\\\t\\\\n   413\\\\t(defn register-cell-module\\\\n   414\\\\t  \\\\\\\"Return registry with the `cell` module registered.\\\\\\\"\\\\n   415\\\\t  [registry]\\\\n   416\\\\t  (register-host-module registry 'cell cell-module cell-profiles))\\\\n   417\\\\t\\\\n   418\\\\t\\\\n   419\\\\t;; =============================================================================\\\\n   420\\\\t;; Built-in effect handlers\\\\n  2070\\\\t  \\\\\\\"The compile-time env of one program. Without `opts` it is empty: the\\\\n  2071\\\\t   native path. `{:convention :arg-vector, :native #{symbol}, :macros\\\\n  2072\\\\t   #{symbol}}` opts into the argument-vector convention: `:native` names the\\\\n  2073\\\\t   primitives a bare symbol may call directly (a set, or a map from name to\\\\n  2074\\\\t   its published profile, whose `:yin.k/arities` give an adapter its admitted\\\\n  2075\\\\t   counts), `:macros` the expander-side\\\\n  2076\\\\t   macro names whose calls must stay ordinary applications. The program's\\\\n  2077\\\\t   own top-level definitions are never native. `:outcomes true` adds the\\\\n  2078\\\\t   outcome model (see its section); `:adapters` maps a primitive that\\\\n  2079\\\\t   declares domain failures to the host adapter returning its outcome.\\\\\\\"\\\\n  2080\\\\t  [forms opts]\\\\n  2081\\\\t  (if-not opts\\\\n  2082\\\\t    {}\\\\n  2083\\\\t    (do (when-not (= :arg-vector (:convention opts))\\\\n  2084\\\\t          (reject! \\\\\\\"Unknown compile-program convention\\\\\\\" {:opts opts}))\\\\n  2085\\\\t        (when-let [hit (seq (filter control-heads (:macros opts)))]\\\\n  2086\\\\t          (reject! \\\\\\\"A :macros entry names a compiler form\\\\\\\" {:macros (vec hit)}))\\\\n  2087\\\\t        (let [defined (into #{}\\\\n  2088\\\\t                            (keep (fn [f]\\\\n  2089\\\\t                                    (when (and (seq? f)\\\\n  2090\\\\t                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\\\\n  2091\\\\t                                               (symbol? (second f)))\\\\n  2092\\\\t                                      (strip-symbol-meta (second f)))))\\\\n  2093\\\\t                            forms)\\\\n  2094\\\\t              defined-fns (top-level-defined-fns forms (:macros opts))]\\\\n  2095\\\\t          ;; the compiler emits bare conj and vec (collection literals, apply),\\\\n  2096\\\\t          ;; so a program definition of either would capture them\\\\n  2097\\\\t          (when-let [hit (first (filter #{'conj 'vec} defined))]\\\\n  2098\\\\t            (reject! (str \\\\\\\"Defining \\\\\\\" hit \\\\\\\" would capture the argument-vector constructor\\\\\\\")\\\\n  2099\\\\t                     {:name hit}))\\\\n  2100\\\\t          (cond-> {::convention {:native (set (if (map? (:native opts))\\\\n  2101\\\\t                                                (keys (:native opts))\\\\n  2102\\\\t                                                (:native opts)))\\\\n  2103\\\\t                                 :arities (into {}\\\\n  2104\\\\t                                                (keep (fn [[sym profile]]\\\\n  2105\\\\t                                                        (when-let [a (if (map? profile)\\\\n  2106\\\\t                                                                       (:yin.k/arities profile)\\\\n  2107\\\\t                                                                       profile)]\\\\n  2108\\\\t                                                          [sym a])))\\\\n  2109\\\\t                                                (when (map? (:native opts)) (:native opts)))\\\\n  2110\\\\t                                 :macros (set (:macros opts))}\\\\n   185\\\\t   hosts) publishes like it runs.\\\\\\\"\\\\n   186\\\\t  []\\\\n   187\\\\t  (clj-prelude/admit (php-prelude/admit (h/registry))))\\\\n   188\\\\t\\\\n   189\\\\t\\\\n   190\\\\t(defn publish-donor!\\\\n   191\\\\t  \\\\\\\"Publish the donor `source` of `frontend` as the module `module` (default\\\\n   192\\\\t   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\\\\n   193\\\\t   Answers `{:frontend :module :address :links}`.\\\\\\\"\\\\n   194\\\\t  ([frontend source]\\\\n   195\\\\t   (publish-donor! frontend source (symbol (str \\\\\\\"xlang.donor.\\\\\\\" (name frontend)))))\\\\n   196\\\\t  ([frontend source module]\\\\n   197\\\\t   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\\\\n   198\\\\t         [refusal-key reason] refusal\\\\n   199\\\\t         spec (core-module/module-spec\\\\n   200\\\\t                refusal-key reason (modules)\\\\n   201\\\\t                {:name module,\\\\n   202\\\\t                 :ast (core-module/module-tree\\\\n   203\\\\t                        [(core-module/require-node runtime)\\\\n   204\\\\t                         (u/def! 'body (unit (parse source) []))]),\\\\n   205\\\\t                 :exports '#{body},\\\\n   206\\\\t                 :runtime-name runtime,\\\\n   207\\\\t                 :runtime-address (address),\\\\n   208\\\\t                 :deps (if deps (deps) {})})\\\\n   209\\\\t         result (h/publish-guest-module! spec)]\\\\n   210\\\\t     {:frontend frontend,\\\\n   211\\\\t      :module module,\\\\n   212\\\\t      :address (:address result),\\\\n   213\\\\t      :links (:links result)})))\\\\n   214\\\\t\\\\n   215\\\\t\\\\n   216\\\\t(defn- runtime-entry\\\\n   217\\\\t  \\\\\\\"Require and initialize each distinct runtime of `frontend-keys`, once.\\\\\\\"\\\\n   218\\\\t  [frontend-keys]\\\\n1891:(defn compile-quote\\\\n2025:(defn compile-form\\\\n2168:(defn compile-program\\\\n2422:;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\\\\n2614:    (defn map?\\\\n2683:    (defn reduced\\\\n2686:    (defn reduced?\\\\n2692:    (defn reduce\\\\n2702:    (defn map\\\\n2714:    (defn mapv\\\\n2768:    (defn comp\\\\n2777:    (defn partial\\\\n2846:(defn compile\\\\n2934:    (vector? x) (mapv #(globals-child % names bound) x)\\\\n2974:             :operands (mapv #(publish-to-globals % names bound)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:34:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_17\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"**I would not adopt the proposed ruling as written.** Separating reference resolution from map lookup is sound. Making the projected-name set the exclusive selector breaks an existing higher-order matrix leg and the written calling contract. The scissor argument also conflates *invalid lookalikes* with *exact copies of valid bearer references*.\\\\n\\\\nI reviewed `f35c65c2` and checked the corresponding calling-contract passages in master. No files changed; no suites run. Behavioral predictions below are architectural deductions, not reported test results.\\\\n\\\\n**1. Problem framing: the impossibility is real, but narrower than stated.**\\\\n\\\\nThere are three distinct cases:\\\\n\\\\n| Value | What can distinguish it? |\\\\n|---|---|\\\\n| A minted reference with a valid seal and live cell | Heap validation |\\\\n| A map with the minted shape but an incorrect seal or nonexistent ID | Heap validation distinguishes it from the first case |\\\\n| A field-identical reconstruction of the first reference | Nothing observing only that value and the same heap can distinguish it |\\\\n\\\\nThe current engine already implements this distinction internally: `authentic-ref?` checks the cell’s membership and recorded seal. It does not check construction history. Consequently, reconstructing the exact valid map produces another usable bearer reference—not a forgery under the existing admission rule. [engine.cljc:331](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:331)\\\\n\\\\nThus:\\\\n\\\\n- **Correct:** shape inspection cannot establish authenticity.\\\\n- **Correct:** neither shape inspection nor authentication can recover different intentions behind two identical values.\\\\n- **Incorrect:** the wrong-seal `:cell-7` exposure is itself the identical-value impossibility. Its seal distinguishes it from a genuine reference when checked against the heap.\\\\n- **Overstated:** option 2 provides “full fidelity.” It fixes invalid lookalikes; it cannot make identical authenticated values behave differently according to their construction histories.\\\\n\\\\nNonces and signed minting marks authenticate possession, not intent: a complete copy includes the nonce or mark. The existing seal is already such an authenticator. [engine.cljc:299](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:299)\\\\n\\\\nProvenance could distinguish occurrences **only by adding another semantic input**: an opaque carrier, tracked occurrence identity, explicit annotation, or provenance propagated through every relevant operation. That costs representation/ABI changes or tracking through parameters, collections, returns, and transport. Serializable provenance remains copyable; preventing copying requires an additional authority or restriction. It also needs reconciliation with the present prohibition on new descriptor seals/runtime provenance registries and the current restrictions on transporting live callables. [yang.antlr.md:3580](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3580), [yang.antlr.md:3826](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3826)\\\\n\\\\nOne further framing correction: **`cell/get` does not run the closure.** It validates and returns cell contents as data. The shared calling helper subsequently extracts the entry and applies it. Keeping those stages distinct strengthens the architectural argument. [engine.cljc:2725](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:2725), [call.cljc:97](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/core/call.cljc:97)\\\\n\\\\n**2. Solution: explicit operations hold; projected-name-only dispatch does not preserve the current language.**\\\\n\\\\nThe decisive existing counterexample is:\\\\n\\\\n```clojure\\\\n(defn clj_apply [f] (+ (f 20) 1))\\\\n```\\\\n\\\\nThe matrix passes a TypeScript closure into this Clojure donor and expects `22n`. Here `f` is a parameter, not a projected name. Moreover, the donor is published with an **empty projection list**. Under the proposed rule, `(f 20)` takes the data path and performs a lookup on the reference map instead of invoking the callback. This is already a required test, not a hypothetical future feature. [cross_lang_test.clj:100](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:100), [conformance.clj:190](/Users/sto/workspace/datomworld-cljrt/test/yang/call/conformance.clj:190)\\\\n\\\\nThe same failure follows for ordinary first-class uses:\\\\n\\\\n```clojure\\\\n(let [f probe] (f 20))\\\\n((identity probe) 20)\\\\n(let [bag {:f probe}] ((:f bag) 20))\\\\n(apply probe [20])\\\\n```\\\\n\\\\nThese are deductions from the proposed rule. They matter because the contract explicitly requires passed, returned, stored, and recursively invoked functions to retain their calling behavior; the compiler also routes `apply` through general guest invocation. [yang.antlr.md:3822](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3822), [yang.antlr.md:4026](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:4026), [clojure.cljc:1418](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1418)\\\\n\\\\nAdditional problems:\\\\n\\\\n- **A projected name is not necessarily cell-backed.** Clojure functions are immutable admitted descriptors, and the convention also allows immutable bound-method descriptors. A projected-name call must select convention invocation, not unconditional `cell/get`. [clojure.cljc:1153](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1153), [yang.antlr.md:3572](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3572)\\\\n- **The projection set declares names, not callable kinds.** The matrix projects ordinary data too: `answer` is exported as `42`. No callable classification accompanies `exports`. [conformance.clj:245](/Users/sto/workspace/datomworld-cljrt/test/yang/call/conformance.clj:245), [cross_lang_test.clj:134](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:134)\\\\n- **Shadowing requires binding resolution, not name membership.** `(let [probe {:marker 42}] (probe :marker))` must resolve the local map. Top-level definitions can also replace projected globals; this is expressly supported and tested. [clojure.cljc:2938](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:2938), [cross_lang_test.clj:141](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:141)\\\\n- **Runtime namespace state can outlive a compilation unit.** Globals persist across `run-main` entries and are mutable through `define-global!`. A frozen name list cannot establish the future value’s interpretation without an additional binding contract. [prelude.cljc:14](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure/prelude.cljc:14), [prelude.cljc:70](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure/prelude.cljc:70)\\\\n\\\\nThe present harness knows the caller’s export names before lowering, so direct calls can be specialized. That does **not** establish knowledge of callback arguments, returned functions, or future namespace updates. Re-entry already appears in the calling contract; arbitrary runtime projection through streams would need an explicit protocol rather than an assumed static set. [conformance.clj:263](/Users/sto/workspace/datomworld-cljrt/test/yang/call/conformance.clj:263), [yang.antlr.md:3822](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3822)\\\\n\\\\nFinally, “data API always answers” needs qualification: map invocation still has arity rules. The existing helper rejects calls without one key and, optionally, a default. [clojure.cljc:2506](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:2506)\\\\n\\\\n**3. Axiom fit: syntax-selected interpretation is compatible, but not uniquely preferred.**\\\\n\\\\nAxiom 2 says an interpreter creates semantics. It does not say interpretation must be decided entirely during lowering or must ignore runtime state. The architectural example explicitly has the evaluator construct CESK state and execute the interpreted stream. [datom.world.md:17](/Users/sto/workspace/datomworld-cljrt/docs/design/datom.world.md:17), [datom.world.md:50](/Users/sto/workspace/datomworld-cljrt/docs/design/datom.world.md:50)\\\\n\\\\nA non-fatal authentication operation can preserve the existing separation:\\\\n\\\\n1. The compiler emits ordinary UAST.\\\\n2. A generic cell effect reports whether a reference authenticates.\\\\n3. Compiled guest code decides whether to invoke a callable or perform a lookup.\\\\n4. The engine remains unaware of Clojure map-call semantics.\\\\n\\\\nThat follows the existing cell-module architecture: its functions construct effects; the engine interprets those effects against VM state. It does not require the compiler to consult a running heap or introduce another evaluator. [module.cljc:378](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/module.cljc:378)\\\\n\\\\nMy assessment:\\\\n\\\\n- **Position-selected APIs:** compatible, provided their semantic restrictions are explicit.\\\\n- **Reserved shape:** also compatible. The philosophy explicitly permits restrictions, although this restriction sacrifices source-map behavior. [datom.world.md:7](/Users/sto/workspace/datomworld-cljrt/docs/design/datom.world.md:7)\\\\n- **Authentication probe:** also compatible, provided it exposes generic reference facts rather than implementing frontend dispatch inside the engine.\\\\n\\\\nThe invariant would weigh against **engine-owned Clojure dispatch**, not against all runtime authentication. The convention already permits eligibility predicates to read explicit runtime metadata and heap state. [yang.antlr.md:3603](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3603)\\\\n\\\\nTherefore I do not accept “option 2 collapses interpretation and execution” as an established architectural objection.\\\\n\\\\n**4. Bag semantics: coherent as a new restriction, incompatible with today’s contract.**\\\\n\\\\n“Reference stored into data becomes data” is misleading under the proposal. Nothing changes on storage: the same reference remains in the bag. What changes is **the operation selected at the eventual call site**. The contract currently says values pass unchanged and aliases retain the same sealed references. [yang.antlr.md:3773](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3773)\\\\n\\\\nEquality can therefore survive while callability fails. Passing an identity assertion is insufficient.\\\\n\\\\nThe matrix checks both: TypeScript’s `stored === phpfn` is immediately followed by `stored(2, 3)`, and several other legs invoke received parameters. Applying the position rule across frontends would break those legs; applying it only to Clojure still breaks the Clojure callback leg above. [cross_lang_test.clj:39](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:39), [cross_lang_test.clj:48](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:48), [cross_lang_test.clj:100](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:100)\\\\n\\\\nThe owner can choose a language where received references require explicit invocation syntax. But that would be a **breaking convention/profile revision**, retracting transparent higher-order invocation—not merely documenting an overlooked corner in §8.10. The existing acceptance gate explicitly says “pass, return, store, recurse, and call back.” Master contains the same requirement. [worktree §8.10.11](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:4026), [master §8.10.11](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:4026)\\\\n\\\\n**5. Migration: D2’s packet mechanism survives, but its surrounding dispatch cannot be declared unaffected.**\\\\n\\\\nThe packet mechanism answers a different question: **which entry protocol is being used?** Its exact two-element vector and compiler-token check select the private outcome lane on the existing unary entry. That mechanism need not change to fix cell-reference classification. [clojure.cljc:1090](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1090)\\\\n\\\\nThree reconciliation points remain:\\\\n\\\\n- **Descriptor admission is runtime value inspection.** It reconstructs and compares an opaque witness. Its constructor explicitly says an equal immutable reconstruction is the same value. Thus “never examine the value at runtime” cannot be a universal rule while this mechanism remains. Scope the rule precisely if retaining it. [clojure.cljc:1134](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1134), [clojure.cljc:2311](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:2311)\\\\n- **“Data invocation everywhere else” would also bypass ordinary admitted function descriptors.** Preserve their admission path explicitly. Existing tests require dynamically bound local functions to work and local maps to remain lookups. [clojure_test.clj:2578](/Users/sto/workspace/datomworld-cljrt/test/yang/clojure_test.clj:2578)\\\\n- **Removing only `dsg__cell-ref?` is insufficient.** There is a second shape test in call routing, admission guards around explicit `eligible?`/`invoke`, and shared `_descriptor` dereferencing on `:type :cell-ref`. All relevant entry points need a consistent policy. [clojure.cljc:1245](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1245), [clojure.cljc:1403](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1403), [clojure.cljc:1458](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1458), [call.cljc:23](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/core/call.cljc:23)\\\\n\\\\nThere is also a separate entry-key collision: current routing sends maps containing `:yang.call/entry` to admission, and a regression test requires an unadmitted such map to refuse. Leaving this untouched may be a valid scope decision, but then “ordinary map application always remains data” is still not generally true. [clojure.cljc:1405](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1405), [clojure_test.clj:2600](/Users/sto/workspace/datomworld-cljrt/test/yang/clojure_test.clj:2600)\\\\n\\\\nOther frontend landmines extend beyond call sites:\\\\n\\\\n- TypeScript’s `typeof` path dereferences cell-shaped values before common eligibility; changing only `js/call` leaves that exposure. Member-call lowering also preserves the receiver and must continue doing so. [TS prelude:135](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/typescript/antlr/prelude.cljc:135), [TS lower:1167](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/typescript/antlr/lower.cljc:1167)\\\\n- Python’s call path includes bound-method handling, class instantiation, and common invocation. A universal projected-name switch would bypass these distinctions. [Python prelude:1033](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/python/antlr/prelude.cljc:1033)\\\\n- PHP resolves runtime strings, arrays, closures, and callable objects. These cannot be reduced to a compile-time export-name set. [PHP prelude:4229](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/php/antlr/prelude.cljc:4229)\\\\n\\\\n**6. Verdict: retain the two operations; reject projected-name-only selection as the default rule.**\\\\n\\\\nGiven the existing first-class calling contract, I would rule for **option 2, with explicit data lookup and a precise bearer-value policy**:\\\\n\\\\n1. **Explicit reference resolution remains strict.** Invalid references refuse through the existing validation boundary. [engine.cljc:354](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:354)\\\\n2. **Ordinary application recognizes admitted descriptors and authenticated live references at runtime.** Introduce a generic, non-fatal authentication effect—or authenticated read result—using the engine’s existing authentication logic. Invalid cell-shaped maps take ordinary map semantics.\\\\n3. **A valid reference without an admitted callable entry is not callable.** Authentication alone must not authorize execution. The existing genuine-cell-without-entry test already pins that distinction. [clojure_test.clj:2120](/Users/sto/workspace/datomworld-cljrt/test/yang/clojure_test.clj:2120)\\\\n4. **An exact copy of a valid reference retains bearer behavior.** If the program wants its fields as data, it uses explicit lookup. Do not promise construction-history-sensitive behavior for identical values.\\\\n5. **Static specialization is an optimization requiring proof**, including shadowing and higher-order behavior—not a replacement semantic based on projection membership. This matches the convention’s existing fast-path obligation. [yang.antlr.md:3964](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3964)\\\\n\\\\nThis requires a declared VM API/profile change; the current cell module exposes only `new`, `get`, and `set!`. [module.cljc:400](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/module.cljc:400)\\\\n\\\\nIf the owner instead requires **every program-reconstructed map, including an exact authenticated copy, to default to lookup**, explicit reference-invocation syntax is a coherent alternative. But then higher-order callers need explicit operation contracts, and §8.10’s transparent invocation promise must change. A projected-name list alone does not supply those contracts.\\\"}}\\n     1\\tCreated-GMT: 2026-11-07 03:30:00 GMT\\n     2\\tCreated-Local: 2026-11-07 10:30:00 +07 (+0700)\\n     3\\tStatus: OWNER-APPROVED 2026-11-07 — \\\"enforce everywhere consistently. this should be a separate track.\\\"\\n     4\\t\\n     5\\t# RULING OF RECORD — the exception track: §8.10.7 enforced uniformly in all four frontends\\n     6\\t\\n     7\\t## The decision\\n     8\\t\\n     9\\tException handling is enforced uniformly across yang.clojure, yang.typescript (js),\\n    10\\tyang.php, and yang.python. Every escaping source exception — from any frontend, through\\n    11\\tany boundary — compiles down to THE SAME continuation: the caller's supplied raise exit\\n    12\\treceiving the §8.10.7 condition\\n    13\\t\\n    14\\t    {:yang.call/reason :yang.call/thrown, :yang.call/value original-thrown-value}\\n    15\\t\\n    16\\tand every receiving runtime implements the §8.10.7 reception rules (1)–(3) as written.\\n    17\\tThis is a SEPARATE TRACK: it does not ride any frontend's ongoing slice; it has its own\\n    18\\tfolder (`collab/exception-track/`), its own rounds, and its own acceptance gate. The four\\n    19\\tfrontend seats cede these exception-fix surfaces to the track's rounds; the track files\\n    20\\tper-frontend results back into each seat's records.\\n    21\\t\\n    22\\t## The uniformity requirements (each is testable)\\n    23\\t\\n    24\\t**R1 — the callee bridge (js, php are non-compliant today).** Every frontend's published\\n    25\\tfunction entry (and closure/higher-order entry) installs the exception bridge: it reads\\n    26\\tthe supplied `:yang.call/raise` and delivers every escaping source exception AND argument\\n    27\\tbinding failure to it as the §8.10.7 condition. No frontend may let an escaping exception\\n    28\\tfollow the host engine's own handler stack (js today, prelude.cljc:1581), and no frontend\\n    29\\tmay return an uncaught error as an ordinary value (php today, prelude.cljc:190/2384).\\n    30\\t\\n    31\\t**R2 — foreign reception (python, php are non-compliant today).** On receiving a thrown\\n    32\\tcondition: a payload valid in the receiving runtime keeps that runtime's ordinary\\n    33\\tcatching and identity behavior; a runtime permitting arbitrary thrown values (js) may\\n    34\\tdeliver the payload raw; a runtime requiring exception objects (python, php) represents a\\n    35\\tforeign payload with its own generated `ForeignException`, retaining the complete\\n    36\\tcondition and original payload — catch-all catches it, typed catches match the LOCAL\\n    37\\thierarchy, never guessed foreign class names. Raising the raw envelope (php:2384) or the\\n    38\\traw payload (python:1034) is non-compliant.\\n    39\\t\\n    40\\t**R3 — protocol failures retain the condition.** `:yang.call/not-callable`,\\n    41\\t`:invalid-invocation`, `:unsupported-binding` map to a documented local exception form\\n    42\\tretaining the complete original condition, so an unchanged rethrow can forward it. A fresh\\n    43\\tlocal error containing only rendered text (js:1627, python:1046) is non-compliant.\\n    44\\t\\n    45\\t**R4 — clojure unifies.** The internal outcome-token channel\\n    46\\t(clojure.cljc:1110/1486) may remain an optimization ONLY with a proof of equivalence at\\n    47\\tevery boundary; absent that proof it unifies onto the raise-exit path. Clojure's `try`\\n    48\\trejection of `finally` and its single-catch restriction are source-semantics decisions\\n    49\\tTHIS RULING DOES NOT CHANGE — R4 is about the continuation, not clojure's catch surface.\\n    50\\t\\n    51\\t**R5 — no new shape-routing.** Nothing in the track may route on the condition map's\\n    52\\tshape beyond the §8.10.7 contract; a lookalike map stays ordinary data (the cell-ref\\n    53\\truling's rule, restated). No synthesized engine-effect exception values.\\n    54\\t\\n    55\\t## What the audit establishes (the baseline)\\n    56\\t\\n    57\\tThe gpt-6.1-sol audit (collab/yang-python/1794900000000, verdict DIVERGENT, HEAD\\n    58\\te9a0b430) is the track's baseline evidence: python hooks the raise exit (R1 compliant);\\n    59\\tjs and php lack the bridge (R1); python and php lack ForeignException (R2); js and python\\n    60\\tlose protocol conditions (R3); clojure has the private channel (R4). Zero cross-language\\n    61\\t§8.10.7 legs exist in the conformance kit today.\\n    62\\t\\n    63\\t## Acceptance gate\\n    64\\t\\n    65\\tThe conformance kit (`test/yang/call/conformance.clj`) grows exception legs — the\\n    66\\t§8.10.11 exception row as acceptance: binding failures, arbitrary foreign thrown data,\\n    67\\tcatch-all/typed catches, unchanged rethrow, finally replacement, protocol-error rethrow,\\n    68\\tcondition-shaped thrown maps staying data, A→B→A propagation with identity and cleanup\\n    69\\torder, and the stored-ForeignException rethrown-from-another-activation case. The track\\n    70\\tis DONE when every admitted pair passes those legs with real source on both sides, and\\n    71\\tthe divergences R1–R4 are each closed by a focused test pinning the compliant behavior.\\n    72\\t\\n    73\\t## Sequencing\\n    74\\t\\n    75\\tArchitect review of this ruling, then an engineer mob review, then per-frontend fix\\n    76\\trounds (smallest first: R3 js/python, R1 php, R2 python/php, R4 clojure), the conformance\\n    77\\tlegs landing alongside the fixes they gate. The known-gaps row for this track is filed\\n    78\\tfrom the audit's divergence list.\\n    79\\t\\n    80\\t— filed by the yang.python orchestrator seat on the owner's instruction\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:42:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'ForeignException|yang.call/entry|function-entry|outcome-token' src/cljc/yang/python/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude.cljc src/cljc/yang/typescript/antlr/prelude.cljc src/cljc/yang/clojure.cljc; nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '260,363p'; nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '214,260p'; nl -ba src/cljc/yang/clojure/prelude.cljc | sed -n '72,110p'\\\"\",\"aggregated_output\":\"src/cljc/yang/typescript/antlr/prelude.cljc:30:                      (fn [this args] ..) :yang.call/entry\\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1567:    ;; :yang.call/entry (fn [invocation] ..)\\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1602:                                                                                  :yang.call/entry entry)\\nsrc/cljc/yang/python/antlr/prelude.cljc:35:                     :code (fn [args] ...) :yang.call/entry\\nsrc/cljc/yang/python/antlr/prelude.cljc:886:    [py/function-entry\\nsrc/cljc/yang/python/antlr/prelude.cljc:925:           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\\nsrc/cljc/yang/python/antlr/prelude.cljc:927:                                     (py/function-entry f invocation))))\\nsrc/cljc/yang/php/antlr/prelude.cljc:30:                             :yang.call/entry (fn [invocation])}\\nsrc/cljc/yang/php/antlr/prelude.cljc:1137:       (if (not (nil? (yang.call/entry a)))\\nsrc/cljc/yang/php/antlr/prelude.cljc:2264:           (cell/set! f (assoc (cell/get f) :yang.call/entry\\nsrc/cljc/yang/php/antlr/prelude.cljc:4224:              :yang.call/entry\\nsrc/cljc/yang/php/antlr/prelude.cljc:4234:       (if (not (nil? (yang.call/entry v)))\\nsrc/clj