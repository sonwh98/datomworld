{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg --files collab | rg '179434[13]|surface-registry|unification-ruling'; sed -n '1,240p' test/yang/python/antlr/exception_call_test.clj; sed -n '1,240p' test/yang/call/exception_contract_test.clj\"","aggregated_output":"(ns yang.python.antlr.exception-call-test\n  \"Round 0: six directed Python-containing pairs, compliant assertions.\n   JS/PHP/Clojure-only pairs remain explicitly pending in the shared matrix.\n   A red result is a runtime divergence, never the expected test value.\"\n  (:require [clojure.test :refer [deftest is testing do-report]]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]))\n\n\n(defn- check-pair\n  [donor caller]\n  (let [observations (legs/run-pair donor caller)]\n    (doseq [{:keys [id scenario] :as leg}\n            (filter #(and (= donor (:donor %)) (= caller (:caller %)))\n                    contract/pair-matrix)]\n      (testing (str id)\n        (try\n          (let [expected (legs/expected leg)\n                results (get observations id)]\n            (println \"EXCEPTION-PAIR\"\n                     (pr-str {:id id :gates (:gates leg) :frontends (:frontends leg)\n                              :expected expected\n                              :results (update-vals results #(if (instance? Throwable %)\n                                                               {:host/error (.getMessage ^Throwable %)\n                                                                :host/data (ex-data %)} %))\n                              :status (update-vals results #(cond (instance? Throwable %) :error\n                                                                  (= expected %) :green :else :red))}))\n            (doseq [[backend actual] results]\n              (if (instance? Throwable actual)\n                (do-report {:type :error :message (str id \" \" backend \" operational failure\")\n                            :expected expected :actual actual})\n                (is (= expected actual) (str donor \" -> \" caller \" \" scenario \" \" backend)))))\n          (catch Exception e\n            (do-report {:type :error :message (str id \" source leg failed to execute\")\n                        :expected (legs/expected leg) :actual e})))))))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :typescript}}\n  python-to-typescript-test (check-pair :python :typescript))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :typescript}}\n  typescript-to-python-test (check-pair :typescript :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :php}}\n  python-to-php-test (check-pair :python :php))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :php}}\n  php-to-python-test (check-pair :php :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :clojure}}\n  python-to-clojure-test (check-pair :python :clojure))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :clojure}}\n  clojure-to-python-test (check-pair :clojure :python))\n(ns yang.call.exception-contract-test\n  \"Intentionally red until exception rounds 1–4 repair the runtimes. Never\n   invert assertions or encode today's divergences as expected behavior.\"\n  (:require [clojure.test :refer [deftest is testing do-report]]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-probes :as probes]))\n\n\n(defn- check-frontend\n  [frontend]\n  (let [observations (probes/run-frontend frontend)]\n    (doseq [{:keys [id expected] :as fixture}\n            (filter #(= frontend (:frontend %)) contract/fixtures)]\n      (testing (str id \" gates=\" (:gates fixture))\n        (try\n          (let [results (get observations id)]\n            (println \"PROVENANCE\"\n                     (pr-str {:id id :gates (:gates fixture) :frontends (:frontends fixture)\n                              :expected expected\n                              :results (update-vals results #(if (instance? Throwable %)\n                                                               {:host/error (.getMessage ^Throwable %)\n                                                                :host/data (ex-data %)} %))\n                              :status (update-vals results #(cond (instance? Throwable %) :error\n                                                                  (= expected %) :green :else :red))}))\n            (doseq [[backend actual] results]\n              (if (instance? Throwable actual)\n                (do-report {:type :error :message (str id \" \" backend \" operational failure\")\n                            :expected expected :actual actual})\n                (is (= expected actual) (str id \" \" backend)))))\n          (catch Exception e\n            (do-report {:type :error :message (str id \" boundary fixture failed to execute\")\n                        :expected expected :actual e})))))))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2 ::contract/r3 ::contract/r5}\n           :frontends #{:python}}\n  python-provenance-test\n  (check-frontend :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2 ::contract/r3 ::contract/r5}\n           :frontends #{:php}}\n  php-provenance-test\n  (check-frontend :php))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r3 ::contract/r5}\n           :frontends #{:typescript}}\n  typescript-provenance-test\n  (check-frontend :typescript))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r3 ::contract/r5}\n           :frontends #{:clojure}}\n  clojure-provenance-test\n  (check-frontend :clojure))\n","exit_code":0,"status":"completed"}}
