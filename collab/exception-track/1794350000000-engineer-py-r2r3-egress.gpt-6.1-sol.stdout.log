               (u/app (u/v 'dsg__get) (u/v escape)\\\\n  1333\\\\t                                       (u/lit :clj/escape-token))\\\\n  1334\\\\t                                (u/v 'dsg__call_token))\\\\n  1335\\\\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\\\\n  1336\\\\t                         (outcome-node\\\\n  1337\\\\t                           error-tag\\\\n  1338\\\\t                           (u/app (u/v 'yang.call/condition)\\\\n  1339\\\\t                                  (u/lit :yang.call/invalid-invocation)\\\\n  1340\\\\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\\\\n  1341\\\\t          public-bridge (u/app (u/lam [escape] activation) u/capture)\\\\n  1342\\\\t          bridged (if tail?\\\\n  1343\\\\t                    (u/if-node\\\\n  1344\\\\t                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\\\\n  1345\\\\t                      (u/app (u/v 'yang.call/invoke-with)\\\\n  1346\\\\t                             (u/v callee) (u/v arguments) (u/lit [])\\\\n  1347\\\\t                             (u/lam [condition] condition->outcome)\\\\n  1348\\\\t                             (u/app (u/v 'dsg__assoc) (u/lit {})\\\\n  1349\\\\t                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\\\\n  1350\\\\t                      public-bridge)\\\\n  1351\\\\t                    public-bridge)\\\\n  1352\\\\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\\\\n  1353\\\\t                              bridged refused)\\\\n  1354\\\\t          ;; A callee carrying a call entry is convention territory whether it\\\\n  1355\\\\t          ;; admits or forges one, so admission rules it. Everything else is a\\\\n  1356\\\\t          ;; data-side invocation - a collection lookup or a raw closure call -\\\\n  1357\\\\t          ;; and the guest library's invoker owns those semantics. The invoker\\\\n  1358\\\\t          ;; is itself a published descriptor, so it is reached the same way\\\\n  1359\\\\t          ;; any guest callee is; its raise escapes to a capture of this site\\\\n  1360\\\\t          ;; and the resumed pass materializes the error outcome here.\\\\n  1361\\\\t          value-call (u/app\\\\n  1362\\\\t                       (u/lam ['dsg__raise_escape]\\\\n  1363\\\\t                              (u/if-node\\\\n  1364\\\\t                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\\\\n  1365\\\\t                                (u/let1\\\\n  1366\\\\t                                  (symbol (str reserved-prefix \\\\\\\"invoker_result\\\\\\\"))\\\\n  1367\\\\t                                  (u/app (u/v 'yang.call/invoke)\\\\n  1368\\\\t                                         (u/v 'invoke-value)\\\\n  1369\\\\t                                         (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\\\\n  1370\\\\t                                         (u/lit [])\\\\n  1371\\\\t                                         (u/lam [condition]\\\\n  1372\\\\t                                                (assoc (u/app (u/v 'dsg__raise_escape)\\\\n  1373\\\\t                                                              (u/app (u/v 'dsg__assoc) (u/lit {})\\\\n  1374\\\\t                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\\\\n  1375\\\\t                                                                     (u/lit :clj/outcome) condition->outcome))\\\\n  1376\\\\t                                                       :tail? true)))\\\\n  1377\\\\t                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \\\\\\\"invoker_result\\\\\\\")))))\\\\n  1378\\\\t                                (u/if-node\\\\n  1379\\\\t                                  (u/app (u/v 'dsg__equal)\\\\n  1380\\\\t                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\\\\n  1381\\\\t                                                (u/lit :clj/escape-token))\\\\n  1382\\\\t                                         (u/v 'dsg__call_token))\\\\n  1383\\\\t                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\\\\n  1384\\\\t                                  (outcome-node\\\\n  1385\\\\t                                    error-tag\\\\n  1386\\\\t                                    (u/app (u/v 'yang.call/condition)\\\\n  1387\\\\t                                           (u/lit :yang.call/invalid-invocation)\\\\n  1388\\\\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\\\\n  1389\\\\t                       u/capture)\\\\n  1390\\\\t          routed (if (::invoker env)\\\\n  1391\\\\t                   (u/if-node\\\\n  1392\\\\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\\\\n  1393\\\\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\\\\n  1394\\\\t                                           (u/lit true)\\\\n  1395\\\\t                                           ;; the shape is only WHEN to ask (ruling of\\\\n  1396\\\\t                                           ;; record, rule 2): the heap answers\\\\n  1397\\\\t                                           ;; `cell/authentic?`, and an unauthenticated\\\\n  1398\\\\t                                           ;; shape takes ordinary map invocation\\\\nsrc/cljc/yang/core/call.cljc:37:    [yang.call/entry\\\\nsrc/cljc/yang/core/call.cljc:39:       (get (yang.call/_descriptor callable) :yang.call/entry))]\\\\nsrc/cljc/yang/core/call.cljc:43:         (if (nil? (yang.call/entry callable))\\\\nsrc/cljc/yang/core/call.cljc:49:     (fn [callee positional named raise]\\\\nsrc/cljc/yang/core/call.cljc:53:              :yang.call/raise raise))]\\\\nsrc/cljc/yang/core/call.cljc:55:     (fn [callee positional named raise options]\\\\nsrc/cljc/yang/core/call.cljc:59:              :yang.call/raise raise))]\\\\nsrc/cljc/yang/core/call.cljc:81:               (if (data/contains? invocation :yang.call/raise)\\\\nsrc/cljc/yang/core/call.cljc:97:    [yang.call/thrown\\\\nsrc/cljc/yang/core/call.cljc:99:       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\\\\nsrc/cljc/yang/core/call.cljc:102:     (fn [raise condition]\\\\nsrc/cljc/yang/core/call.cljc:103:       (raise condition))]\\\\nsrc/cljc/yang/core/call.cljc:105:     (fn [callable positional named raise]\\\\nsrc/cljc/yang/core/call.cljc:106:       (if (data/callable? raise)\\\\nsrc/cljc/yang/core/call.cljc:108:           (let [target (yang.call/entry callable)\\\\nsrc/cljc/yang/core/call.cljc:109:                 record (yang.call/invocation callable positional named raise)]\\\\nsrc/cljc/yang/core/call.cljc:114:                   raise\\\\nsrc/cljc/yang/core/call.cljc:118:                 raise\\\\nsrc/cljc/yang/core/call.cljc:122:             raise\\\\nsrc/cljc/yang/core/call.cljc:125:         (raise (yang.call/condition :yang.call/invalid-invocation\\\\nsrc/cljc/yang/core/call.cljc:126:                                     {:yang.call/reason :missing-raise-exit}))))]\\\\nsrc/cljc/yang/core/call.cljc:128:     (fn [callable positional named raise options]\\\\nsrc/cljc/yang/core/call.cljc:129:       (if (data/callable? raise)\\\\nsrc/cljc/yang/core/call.cljc:131:           (let [target (yang.call/entry callable)\\\\nsrc/cljc/yang/core/call.cljc:133:                          callable positional named raise options)]\\\\nsrc/cljc/yang/core/call.cljc:138:                   raise\\\\nsrc/cljc/yang/core/call.cljc:142:                 raise\\\\nsrc/cljc/yang/core/call.cljc:146:             raise\\\\nsrc/cljc/yang/core/call.cljc:149:         (raise (yang.call/condition :yang.call/invalid-invocation\\\\nsrc/cljc/yang/core/call.cljc:150:                                     {:yang.call/reason :missing-raise-exit}))))]])\\\\nsrc/cljc/yang/core/call.cljc:154:  '#{entry eligible? invocation invocation-with valid-invocation? condition\\\\nsrc/cljc/yang/core/call.cljc:155:     thrown transfer invoke invoke-with})\\\\nsrc/cljc/yang/core/call.cljc:185:  \\\\\\\"The linker module spec for `yang.call` over `registry`.\\\\\\\"\\\\nsrc/cljc/yang/core/call.cljc:186:  [registry]\\\\nsrc/cljc/yang/core/call.cljc:192:                     :registry registry\\\\nsrc/cljc/yang/clojure/prelude.cljc:10:   - the entry, `clj/run-main`: initialize the runtime state, run the\\\\nsrc/cljc/yang/clojure/prelude.cljc:12:     program's value with the outcome model's `[:yin.k/ok value]`\\\\nsrc/cljc/yang/clojure/prelude.cljc:14:     entry does not reset the global namespace: the namespace lives for\\\\nsrc/cljc/yang/clojure/prelude.cljc:17:     into the next unit's run (as `js/run-main` leaves `globalThis`\\\\nsrc/cljc/yang/clojure/prelude.cljc:29:   - admission, `admit`: the registry surface a linked clojure composition\\\\nsrc/cljc/yang/clojure/prelude.cljc:81:    ;; ------------------------------------------------------------- entry\\\\nsrc/cljc/yang/clojure/prelude.cljc:82:    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\\\\nsrc/cljc/yang/clojure/prelude.cljc:83:    ;; internal, so the entry removes one wrapper level from the\\\\nsrc/cljc/yang/clojure/prelude.cljc:85:    ;; wrapped again, so one level is exact). An error outcome passes\\\\nsrc/cljc/yang/clojure/prelude.cljc:87:    [clj/unwrap-outcome\\\\nsrc/cljc/yang/clojure/prelude.cljc:94:    ;; The global namespace is the task's, not the entry's: no reset\\\\nsrc/cljc/yang/clojure/prelude.cljc:96:    [clj/run-main\\\\nsrc/cljc/yang/clojure/prelude.cljc:99:           (clj/unwrap-outcome (body))))]])\\\\nsrc/cljc/yang/clojure/prelude.cljc:127:   the host registry `registry`, pinned to the published `yang.call`\\\\nsrc/cljc/yang/clojure/prelude.cljc:131:  [registry call-address]\\\\nsrc/cljc/yang/clojure/prelude.cljc:138:                     :registry registry,\\\\nsrc/cljc/yang/clojure/prelude.cljc:144:  \\\\\\\"Return `registry` with host module `name` installed over `entries`\\\\nsrc/cljc/yang/clojure/prelude.cljc:146:  [registry name entries arities]\\\\nsrc/cljc/yang/clojure/prelude.cljc:148:    registry name\\\\nsrc/cljc/yang/clojure/prelude.cljc:155:  \\\\\\\"Return `registry` with the guest library's host surface installed: the\\\\nsrc/cljc/yang/clojure/prelude.cljc:159:   registry surfaces; a composition without a clojure program reads none\\\\nsrc/cljc/yang/clojure/prelude.cljc:161:  [registry]\\\\nsrc/cljc/yang/clojure/prelude.cljc:165:                                [op (yang/outcome-adapter data/refusal-message\\\\nsrc/cljc/yang/clojure/prelude.cljc:168:    (-> registry\\\\n(ns yang.call.conformance\\\\n  \\\\\\\"The cross-language calling gates' shared composition (docs/design/\\\\n   yang.antlr.md section 8.10.11): a donor program's named export reaches a\\\\n   caller program by explicit published-export composition only.\\\\n\\\\n   A donor is real source of any admitted frontend, lowered unmodified and\\\\n   published as an ordinary linker module whose one export, `body`, is the\\\\n   lowered unit. A caller task requires that module, runs its body under the\\\\n   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\\\\n   `clj/run-main`), reads each named export from the donor runtime's global\\\\n   namespace, and projects it into the caller runtime's namespace under the\\\\n   same name; then the caller source, lowered unmodified, runs under its own\\\\n   entry. The composition is a sequence of top-level nodes: no call node is\\\\n   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\\\\n   inserted, and the projected value is the donor's own callable value\\\\n   (identity survives).\\\\n\\\\n   A callable value is task-local (a function is a cell, and cells are\\\\n   task-local, section 8.11), so the export is answered as a node evaluated\\\\n   in the caller's task, never as a host value carried between tasks.\\\\n   `export-program` answers the donor's export alone as the program's value.\\\\n\\\\n   Every program runs linked on the three vector VMs (`semantic`, `stack`,\\\\n   `register`) over the TypeScript linked harness's content store, where\\\\n   `yang.call` and `js` already live and `php`, `py` and `clj` are\\\\n   published beside them. The AST walker is not a backend: its links are\\\\n   refused until L-b.\\\\\\\"\\\\n  (:require\\\\n    [clojure.string :as str]\\\\n    [yang.clojure :as clj-comp]\\\\n    [yang.clojure.prelude :as clj-prelude]\\\\n    [yang.core.module :as core-module]\\\\n    [yang.core.names :as names]\\\\n    [yang.core.uast :as u]\\\\n    [yang.php.antlr.cst :as php-cst]\\\\n    [yang.php.antlr.lower :as php-lower]\\\\n    [yang.php.antlr.portable-harness :as php-h]\\\\n    [yang.php.antlr.prelude :as php-prelude]\\\\n    [yang.python.antlr.lower :as py-lower]\\\\n    [yang.python.antlr.parser :as py-parser]\\\\n    [yang.python.antlr.prelude :as py-prelude]\\\\n    [yang.python.antlr.render :as py-render]\\\\n    [yang.typescript.antlr.cst :as ts-cst]\\\\n    [yang.typescript.antlr.linked-harness :as h]\\\\n    [yang.typescript.antlr.lower :as ts-lower]\\\\n    [yang.typescript.antlr.render :as render]\\\\n    [yin.vm :as vm]))\\\\n\\\\n\\\\n(def ^:private published-php\\\\n  \\\\\\\"`php` published once into `js`'s content store, pinning the same\\\\n   `yang.call` revision (as `source-call-test` publishes it).\\\\\\\"\\\\n  (delay (h/publish-guest-module!\\\\n           (php-prelude/module-spec (h/registry)\\\\n                                    (:call-address @h/published)))))\\\\n\\\\n\\\\n(def ^:private published-py\\\\n  \\\\\\\"`py` published beside `js` and `php`, over the same host registry and\\\\n   `yang.call` revision.\\\\\\\"\\\\n  (delay (h/publish-guest-module!\\\\n           (py-prelude/module-spec (h/registry)\\\\n                                   (:call-address @h/published)))))\\\\n\\\\n\\\\n(def ^:private published-clj\\\\n  \\\\\\\"`clj` published beside `js`, `php` and `py`, over the same host registry\\\\n   and `yang.call` revision.\\\\\\\"\\\\n  (delay (h/publish-guest-module!\\\\n           (clj-prelude/module-spec (h/registry)\\\\n                                    (:call-address @h/published)))))\\\\n\\\\n\\\\n(defn- parse-ok\\\\n  \\\\\\\"The CST packet of `source` under `parse`, refused unless the parse is ok.\\\\\\\"\\\\n  [parse source]\\\\n  (let [pk (parse source)]\\\\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\\\\n      (throw (ex-info \\\\\\\"donor or caller source does not parse\\\\\\\"\\\\n                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\\\\n    pk))\\\\n\\\\n\\\\n(defn- python-export-symbol\\\\n  [export]\\\\n  (symbol (str \\\\\\\"xlang.python.export.\\\\\\\" export)))\\\\n\\\\n\\\\n(defn- python-unit\\\\n  [packet exports]\\\\n  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\\\\n         (u/seq-nodes\\\\n           (concat (map (fn [export]\\\\n                          (u/sexp->uast\\\\n                            (list 'py/global-set py-lower/globals-sym\\\\n                                  {:py/str export} (python-export-symbol export))))\\\\n                        exports)\\\\n                   [(py-lower/lower-module-body packet)]))))\\\\n\\\\n\\\\n(def frontends\\\\n  \\\\\\\"Each admitted frontend's profile, as data:\\\\n\\\\n   - `:runtime`, `:address`: the runtime module and its published address;\\\\n   - `:refusal`: the publication refusal key and reason of its modules;\\\\n   - `:deps` (optional): pinned requirements beyond the runtime its\\\\n     lowered units read directly (the clojure unit's `yang.call` reads);\\\\n   - `:parse`: source text to CST packet;\\\\n   - `:unit`: packet and projected exports to the lowered unit its\\\\n     `:run-main` entry takes;\\\\n   - `:read-export`: export name to the form reading the runtime's global\\\\n     namespace (JS `globalThis`, PHP's named-function table, Python's main\\\\n     module dictionary, the clojure runtime's task-local namespace cell);\\\\n   - `:project`: name and a value form to the form binding the value where\\\\n     the runtime's source resolves a called name;\\\\n   - `:render`: the `:run-main` value as test data.\\\\\\\"\\\\n  {:typescript\\\\n   {:runtime 'js,\\\\n    :address #(:address @h/published),\\\\n    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\\\\n    :parse #(parse-ok ts-cst/parse-source %),\\\\n    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\\\\n    :run-main 'js/run-main,\\\\n    :read-export (fn [export] (list 'js/global-get {:js/str export})),\\\\n    :project (fn [name value] (list 'js/define-global! name value)),\\\\n    :render render/output},\\\\n   :php\\\\n   {:runtime 'php,\\\\n    :address #(:address @published-php),\\\\n    :refusal [:yang.php/refusal :yang.php/undeclared-free],\\\\n    :parse #(parse-ok php-cst/parse-source %),\\\\n    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\\\\n    :run-main 'php/run-main,\\\\n    :read-export (fn [export]\\\\n                   (list 'php/resolve-fn (str/lower-case export) export)),\\\\n    :project (fn [name value]\\\\n               (list 'php/declare-function! (str/lower-case name) value)),\\\\n    :render php-h/render},\\\\n   :python\\\\n   {:runtime 'py,\\\\n    :address #(:address @published-py),\\\\n    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\\\\n    :parse #(parse-ok py-parser/parse-source %),\\\\n    :unit python-unit,\\\\n    :run-main 'py/run-main,\\\\n    :read-export (fn [export]\\\\n                   (list 'py/global-get\\\\n                         (list 'py/module-dict\\\\n                               (list 'py/modules-ref {:py/str \\\\\\\"__main__\\\\\\\"}))\\\\n                         {:py/str export})),\\\\n    :project (fn [name value]\\\\n               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\\\\n    :render py-render/output},\\\\n   :clojure\\\\n   {:runtime 'clj,\\\\n    :address #(:address @published-clj),\\\\n    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\\\\n    :deps (fn [] {'yang.call (:call-address @h/published)}),\\\\n    :parse clj-comp/read-forms,\\\\n    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\\\\n    :run-main 'clj/run-main,\\\\n    :read-export (fn [export] (list 'clj/global-get export)),\\\\n    :project (fn [name value]\\\\n               ;; The runtime global namespace is the one binding (as\\\\n               ;; `js/define-global!` is for a JS caller): `lower-unit`\\\\n               ;; reads each projected name through `clj/global-get`, so\\\\n               ;; no task-store binding duplicates it. A caller top-level\\\\n               ;; definition of the same name publishes after the\\\\n               ;; projection and shadows it.\\\\n               (list 'clj/define-global! name value)),\\\\n    :render clj-comp/output}})\\\\n\\\\n\\\\n(defn- profile\\\\n  [frontend]\\\\n  (or (get frontends frontend)\\\\n      (throw (ex-info \\\\\\\"frontend not admitted\\\\\\\" {:frontend frontend}))))\\\\n\\\\n\\\\n(defn- modules\\\\n  \\\\\\\"The host registry, admitted by every runtime profile that checks it,\\\\n   with the clojure guest library's host surface installed beside them.\\\\n   Donor publication declares free names over this same registry, so a\\\\n   clojure donor using the guest library (its `kind` and `portable`\\\\n   hosts) publishes like it runs.\\\\\\\"\\\\n  []\\\\n  (clj-prelude/admit (php-prelude/admit (h/registry))))\\\\n\\\\n\\\\n(defn publish-donor!\\\\n  \\\\\\\"Publish the donor `source` of `frontend` as the module `module` (default\\\\n   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\\\\n   Answers `{:frontend :module :address :links}`.\\\\\\\"\\\\n  ([frontend source]\\\\n   (publish-donor! frontend source (symbol (str \\\\\\\"xlang.donor.\\\\\\\" (name frontend)))))\\\\n  ([frontend source module]\\\\n   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\\\\n         [refusal-key reason] refusal\\\\n         spec (core-module/module-spec\\\\n                refusal-key reason (modules)\\\\n                {:name module,\\\\n                 :ast (core-module/module-tree\\\\n                        [(core-module/require-node runtime)\\\\n                         (u/def! 'body (unit (parse source) []))]),\\\\n                 :exports '#{body},\\\\n                 :runtime-name runtime,\\\\n                 :runtime-address (address),\\\\n                 :deps (if deps (deps) {})})\\\\n         result (h/publish-guest-module! spec)]\\\\n     {:frontend frontend,\\\\n      :module module,\\\\n      :address (:address result),\\\\n      :links (:links result)})))\\\\n\\\\n\\\\n(defn- runtime-entry\\\\n  \\\\\\\"Require and initialize each distinct runtime of `frontend-keys`, once.\\\\\\\"\\\\n  [frontend-keys]\\\\n  (into [(core-module/require-node 'yang.call)]\\\\n        (mapcat (fn [runtime]\\\\n                  [(core-module/require-node runtime)\\\\n                   (u/sexp->uast (list (symbol (str runtime) \\\\\\\"init!\\\\\\\")))]))\\\\n        (distinct (map (comp :runtime profile) frontend-keys))))\\\\n\\\\n\\\\n(defn- donor-run\\\\n  \\\\\\\"The donor module required and its body run under its runtime's entry.\\\\\\\"\\\\n  [{:keys [frontend module]}]\\\\n  [(core-module/require-node module)\\\\n   (u/app (u/v (:run-main (profile frontend)))\\\\n          (u/v (symbol (str module) \\\\\\\"body\\\\\\\")))])\\\\n\\\\n\\\\n(defn export-program\\\\n  \\\\\\\"The program whose value is the donor's `export`, read from its runtime's\\\\n   global namespace after its body ran.\\\\\\\"\\\\n  [donor export]\\\\n  (let [{:k