              library-opts lane 200000)))\\\\n  2587\\\\t      (is (= [:yin.k/ok 42]\\\\n  2588\\\\t             (run-library '[(defn f\\\\n  2589\\\\t                              [x]\\\\n  2590\\\\t                              (+ x 100))\\\\n  2591\\\\t                            (let [f (fn [y] (* y 2))] (f 21))]\\\\n  2592\\\\t                          library-opts lane 200000)))\\\\n  2593\\\\t      (is (= [:yin.k/ok 9]\\\\n  2594\\\\t             (run-library '[(defn f\\\\n  2595\\\\t                              [x]\\\\n  2596\\\\t                              (+ x 100))\\\\n  2597\\\\t                            (let [f {:k 9} v [f]] (f :k))]\\\\n  2598\\\\t                          library-opts lane 200000))\\\\n  2599\\\\t          \\\\\\\"entry-absent local map routes to invoke-value\\\\\\\")\\\\n  2600\\\\t      (let [[tag payload] (run-library\\\\n  2601\\\\t                            '[(defn f\\\\n  2602\\\\t                                [x]\\\\n  2603\\\\t                                (+ x 100))\\\\n  2604\\\\t                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]\\\\n  2605\\\\t                                (f 1))]\\\\n  2606\\\\t                            library-opts lane 200000)]\\\\n  2607\\\\t        (is (= :yin.k/error tag))\\\\n  2608\\\\t        (is (= :yang.call/not-callable (:yang.call/reason payload))\\\\n  2609\\\\t            \\\\\\\"entry-present forged local map routes to admission and refuses\\\\\\\"))\\\\n  2610\\\\t      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\\\\n  2611\\\\t                            :yang.call/data {:yang.call/callee 5}}]\\\\n  2612\\\\t             (run-library '[(defn f\\\\n  2613\\\\t                              [[f]]\\\\n  2614\\\\t                              (f 1))\\\\n  2615\\\\t                            (f [5])]\\\\n  2616\\\\t                          library-opts lane 200000))\\\\n  2617\\\\t          \\\\\\\"destructured parameter shadow