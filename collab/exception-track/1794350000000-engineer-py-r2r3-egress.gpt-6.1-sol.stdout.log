{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"date; ls -l /tmp/exception-py-g0.log; sed -n '330,432p' test/yang/call/conformance.clj; sed -n '462,505p' test/yang/call/conformance.clj; sed -n '1,140p' test/yang/python/antlr/call_entry_test.cljc\"","aggregated_output":"Wed Nov 11 03:34:25 +07 2026\n-rw-r--r--@ 1 sto  wheel  574 Nov 11 03:33 /tmp/exception-py-g0.log\n(defn export-form\n  \"The guest form reading a source-produced export after composition. This\n   reads the public namespace, never the callable's private code slot.\"\n  [frontend export]\n  ((:read-export (profile frontend)) export))\n\n\n(defn compose-exception\n  \"Compose real donor/caller source exactly as `compose` does, optionally\n   followed by an unlowered boundary observation form. The source bodies\n   and their call nodes are untouched. Boundary forms are for provenance\n   assertions and malformed invocations, not substitute source-pair legs.\"\n  ([donor exports caller-frontend caller-source]\n   (compose donor exports caller-frontend caller-source))\n  ([donor exports caller-frontend caller-source observation]\n   (u/mark-tails\n     (u/then (compose donor exports caller-frontend caller-source)\n             (u/sexp->uast observation)))))\n\n\n(defn observation-map-form\n  \"Emit a map whose known observation values are guest expressions.\n   sexp->uast intentionally treats a map literal as DATA, including lists\n   and symbols within it. Dynamic boundary observations use explicit assoc,\n   never a transformation of parsed source or a runtime shape detector.\"\n  [entries]\n  (reduce (fn [form [k value]] (list 'assoc form k value)) {} entries))\n\n\n(defn observation-vector-form\n  \"Emit a boundary argument vector of evaluated expressions. Like maps,\n   vectors in sexp->uast are otherwise literal data.\"\n  [expressions]\n  (reduce (fn [form value] (list 'conj form value)) [] expressions))\n\n\n(defn boundary-call-form\n  \"An abortive observer of a public entry, as guest code. All arguments are\n   forms. `options` selects invoke-with when present. A returned envelope\n   is recorded as :return; only the supplied exit records :raise. Transfer\n   count and the after-call sentinel live in task cells. No payload is\n   snapshotted here: assertions must precede rendering.\"\n  ([callee positional named]\n   (boundary-call-form callee positional named nil))\n  ([callee positional named options]\n   (let [phase (gensym \"phase\")\n         transfers (gensym \"transfers\")\n         after (gensym \"after\")\n         escape (gensym \"escape\")\n         condition (gensym \"condition\")\n         returned (gensym \"returned\")\n         raise (list 'fn [condition]\n                     (list 'do\n                           (list 'cell/set! transfers (list '+ 1 (list 'cell/get transfers)))\n                           (list escape\n                                 (observation-map-form\n                                   {:route :raise :condition condition\n                                    :transfers (list 'cell/get transfers)\n                                    :after (list 'cell/get after)}))))\n         invocation (if options\n                      (list 'yang.call/invoke-with callee positional named raise options)\n                      (list 'yang.call/invoke callee positional named raise))]\n     (list 'let [phase (list 'cell/new false)\n                 transfers (list 'cell/new 0) after (list 'cell/new false)]\n           (list (list 'fn [escape]\n                       (list 'if (list 'cell/get phase)\n                             escape\n                             (list 'do (list 'cell/set! phase true)\n                                   (list 'let [returned invocation]\n                                         (list 'do (list 'cell/set! after true)\n                                               (observation-map-form\n                                                 {:route :return :value returned\n                                                  :transfers (list 'cell/get transfers)\n                                                  :after (list 'cell/get after)}))))))\n                 (list '%capture))))))\n\n\n(defn guard-exceptions-form\n  \"Diagnostic outer handlers: expose an escape that bypassed the supplied\n   boundary exit as :unbridged, rather than letting no-handler obscure the\n   assertion. These are NOT replacement callee bridges: :unbridged always\n   fails the provenance contract. Catch data stays guest-local.\"\n  [frontend-keys form]\n  (reduce\n    (fn [body frontend]\n      (let [e (gensym \"unbridged\")\n            handler (list 'fn [e] {:route :unbridged :frontend frontend})]\n        (case frontend\n          :typescript (list 'js/try (list 'fn [] body) handler)\n          (:python :php)\n          (let [result (gensym \"result\")\n                try-name (if (= frontend :python) 'py/try 'php/try)]\n            (list 'let [result (list 'cell/new nil)]\n                  (list try-name\n                        (list 'fn [] (list 'cell/set! result body))\n                        handler\n                        (list 'fn [] (list 'cell/get result)))))\n          :clojure body)))\n    form (distinct frontend-keys)))\n\n\n(defn exception-outcome\n  \"Uniform observation of a runtime root's output. Preserve its exception\n(defn error-results\n  \"Map `e` across each vector VM backend as an operational failure.\"\n  [e]\n  (into (sorted-map) (map (fn [backend] [backend e]) (keys h/backends))))\n\n\n(defn run-exception-program\n  \"The exception probes' independent VM runs, concurrent on the JVM. Each\n   job owns its registry, task, link pair AND content-serving composition;\n   no stream cursor is shared. Only the published content store is read\n   by all three. A host Exception is kept as the original host object for\n   clojure.test's :error reporting, NEVER relabelled as a guest condition.\n   All jobs settle even if one fails. `run-program` is unchanged.\"\n  [donor ast]\n  (try\n    ;; Resolve publication delays before starting independent readers.\n    (link-source donor)\n    (let [jobs (mapv (fn [backend]\n                       [backend\n                        (future\n                          (try\n                            (vm/value\n                              (h/run-linked backend ast\n                                            {:modules (modules)\n                                             :link-source (link-source donor)}))\n                            (catch Exception e e)))])\n                     (keys h/backends))]\n      (into (sorted-map)\n            (map (fn [[backend job]] [backend @job])) jobs))\n    (catch Throwable e\n      (error-results e))))\n(ns yang.python.antlr.call-entry-test\n  \"Python function binder fixtures and source-call helper coverage for the\n   shared call runtime. The binder fixtures prove the record/constructor\n   contract only; they are not conformance evidence under docs/design/yang.antlr.md §8.10.11.\"\n  (:require [clojure.test :refer [deftest is]]\n            [yang.python.antlr.int-ops-test :as ops]\n            [yang.python.antlr.prelude :as prelude]))\n\n\n(def ^:private bindings\n  '[raise-exit (fn [condition] condition)\n    record (fn [f positional named]\n             (assoc (assoc (assoc (assoc {} :yang.call/callee f)\n                                  :yang.call/positional positional)\n                           :yang.call/named named)\n                    :yang.call/raise raise-exit))\n    invoke (fn [f positional named]\n             ((get (cell/get f) :yang.call/entry) (record f positional named)))\n    positional (py/make-function \"positional\" {:params [\"x\"]} [] []\n                                 (fn [args] (get args 0)))\n    named (py/make-function \"named\" {:params [\"x\" \"y\"]} [] []\n                            (fn [args] (get args 1)))\n    defaulted (py/make-function \"defaulted\" {:params [\"x\"]} [7] []\n                                (fn [args] (get args 0)))\n    variadic (py/make-function \"variadic\" {:params [\"x\"] :star? true} [] []\n                               (fn [args] (get (get args 1) :items)))\n    duplicate (py/make-function \"duplicate\" {:params [\"x\"]} [] []\n                                (fn [args] (get args 0)))\n    substituted (py/make-function \"substituted\" {:params [\"x\"]} [] []\n                                  (fn [args] (get args 0)))\n    receiver-fn (py/make-function \"receiver\" {:params [\"x\"]} [] []\n                                  (fn [args] (get args 0)))\n    profile-fn (py/make-function \"profile\" {:params [\"x\"]} [] []\n                                 (fn [args] (get args 0)))\n    caught (fn [thunk]\n             (py/try thunk\n                     (fn [e] (get (cell/get (get (cell/get e) :class)) :name))\n                     (fn [] :py/None)))])\n\n\n(def ^:private result-expressions\n  '[(if (get (cell/get positional) :yang.call/entry) true false)\n    (if (get (cell/get py.b/len) :yang.call/entry) true false)\n    (if (get (cell/get py.b/TypeError) :yang.call/entry) true false)\n    (let [absent (record positional [] [])\n          supplied (assoc (record positional [] []) :yang.call/receiver :py/None)]\n      (py/vconj (py/vconj [] (get absent :yang.call/receiver :py/missing))\n                (get supplied :yang.call/receiver :py/missing)))\n    (invoke positional [4] [])\n    (invoke named [1] [[\"y\" 9]])\n    (invoke defaulted [] [])\n    (invoke defaulted [:py/None] [])\n    (invoke variadic [1 2 3] [])\n    (let [r (invoke duplicate [1] [[\"x\" 2]])\n          e (get r :yang.call/value)]\n      (py/vconj (py/vconj [] (get r :yang.call/reason))\n                (get (cell/get (get (cell/get e) :class)) :name)))\n    (get ((get (cell/get positional) :yang.call/entry)\n          (record substituted [5] []))\n         :yang.call/reason)\n    (invoke receiver-fn [11] [])\n    ((get (cell/get receiver-fn) :yang.call/entry)\n     (assoc (record receiver-fn [12] []) :yang.call/receiver :py/None))\n    (get ((get (cell/get profile-fn) :yang.call/entry)\n          (assoc (record profile-fn [3] []) :yang.call/binding-profile :py/None))\n         :yang.call/reason)])\n\n\n(def ^:private fixtures\n  (list 'let bindings\n        (reduce (fn [acc expression] (list 'py/vconj acc expression))\n                []\n                result-expressions)))\n\n\n(deftest python-function-entry-record-contract-test\n  (let [expected [true false false [:py/missing :py/None]\n                  4 9 7 :py/None [2 3]\n                  [:yang.call/thrown \"TypeError\"]\n                  :yang.call/invalid-invocation\n                  11 12 :yang.call/unsupported-binding]]\n    (doseq [[backend result] (ops/run-with-prelude prelude/uast fixtures)]\n      (is (= expected result) (str backend)))))\n\n\n(def ^:private fixture\n  '(let [python-fn (py/make-function \"python\" {:params [\"x\" \"y\"]} [7] []\n                                     (fn [args] (get args 1)))\n         foreign-fn (assoc {}\n                           :yang.call/entry\n                           (fn [invocation]\n                             (get (get invocation :yang.call/positional) 0)))\n         call-python (py/call-kw python-fn [1] [])\n         call-named (py/call-kw python-fn [1] [[\"y\" 9]])\n         call-foreign (py/call foreign-fn [42])\n         not-callable (py/try (fn [] (py/call-kw {} [] []))\n                              (fn [e] (get (cell/get (get (cell/get e) :class)) :name))\n                              (fn [] :py/None))]\n     (py/vconj (py/vconj (py/vconj [] call-python) call-named)\n               (py/vconj (py/vconj [] call-foreign) not-callable))))\n\n\n(deftest python-source-calls-use-shared-entry-test\n  (doseq [[backend result] (ops/run-with-prelude prelude/uast fixture)]\n    (is (= [7 9 [42 \"TypeError\"]] result) (str backend))))\n\n\n(deftest python-cross-frontend-callable-identity-test\n  (let [fixture\n        '(let [php-function\n               (cell/new\n                 (assoc {:php/type :function}\n                        :yang.call/entry\n                        (fn [invocation]\n                          (get invocation :yang.call/callee))))\n               returned (py/call-kw php-function [] [])]\n           (if (= php-function returned) :same :different))]\n    (doseq [[backend result] (ops/run-with-prelude prelude/uast fixture)]\n      (is (= :same result) (str backend)))))\n","exit_code":0,"status":"completed"}}
