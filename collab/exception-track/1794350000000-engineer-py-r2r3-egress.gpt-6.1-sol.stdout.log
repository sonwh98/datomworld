                      (if (kind/keyword?\\\\n  2288\\\\t                                                            (dsg__get dsg__candidate\\\\n  2289\\\\t                                                                      :id))\\\\n  2290\\\\t                                                        (dsg__equal\\\\n  2291\\\\t                                                          (data/str-index-of\\\\n  2292\\\\t                                                            (kind/name\\\\n  2293\\\\t                                                              (dsg__get dsg__candidate\\\\n  2294\\\\t                                                                        :id))\\\\n  2295\\\\t                                                            \\\\\\\"cell-\\\\\\\")\\\\n  2296\\\\t                                                          0)\\\\n  2297\\\\t                                                        false)\\\\n  2298\\\\t                                                      false)\\\\n  2299\\\\t                                                    false)\\\\n  2300\\\\t                                                  false)\\\\n  2301\\\\t                                                false)\\\\n  2302\\\\t                                              false)\\\\n  2303\\\\t                                            false)]\\\\n  2304\\\\t                                      (if dsg__cell-ref?\\\\n  2305\\\\t                                        (let [dsg__descriptor\\\\n  2306\\\\t                                              (cell/get dsg__candidate)\\\\n  2307\\\\t                                              dsg__entry\\\\n  2308\\\\t                                              (dsg__get dsg__descriptor\\\\n  2309\\\\t                                                        :yang.call/entry)]\\\\n  2310\\\\t                                          (data/callable? dsg__entry))\\\\n  2311\\\\t                                        (let [dsg__entry\\\\n  2312\\\\t                                              (dsg__get dsg__candidate\\\\n  2313\\\\t                                                        :yang.call/entry)\\\\n  2314\\\\t                                              dsg__witness\\\\n  2315\\\\t                                              (dsg__get dsg__candidate\\\\n  2316\\\\t                                                        :clj/admission)]\\\\n  2317\\\\t                                          (if (data/callable? dsg__entry)\\\\n  2318\\\\t                                            (if (data/callable? dsg__witness)\\\\n  2319\\\\t                                              (dsg__equal\\\\n  2320\\\\t                                                dsg__witness\\\\n  2321\\\\t                                                (dsg__make_admission\\\\n  2322\\\\t                                                  (dsg__assoc dsg__candidate\\\\n  2323\\\\t                                                              :clj/admission\\\\n  2324\\\\t                                                              nil)))\\\\n  2325\\\\t                                              false)\\\\n  2326\\\\t                                            false))))\\\\n  2327\\\\t                                    false)))\\\\n  2328\\\\t                             ;; The intra-unit dispatcher: resolve the unit's public entry,\\\\n  2329\\\\t                             ;; apply it with the compiler's token packet [token args] - one\\\\n  2330\\\\t                             ;; variadic conj and one application, no record construction.\\\\n  2331\\\\t                             ;; Non-map callees refuse.\\\\n  2332\\\\t                             (u/sexp->uast\\\\n  2333\\\\t                               (list 'fn '[dsg__callee dsg__args]\\\\n  2334\\\\t                                     (list 'if '(data/map? dsg__callee)\\\\n  2335\\\\t                                           (list (list (if (contains? (::defined env) 'get)\\\\n  2336\\\\t                                                         'dsg__get\\\\n  2337\\\\t                                                         'get)\\\\n  2338\\\\t                                                       'dsg__callee\\\\n  2339\\\\t                                                       :yang.call/entry)\\\\n  2340\\\\t                                                 (list 'conj '[]\\\\n  2341\\\\t                                                       'dsg__call_token\\\\n  2342\\\\t                                                       'dsg__args))\\\\n  2343\\\\t                                           '(conj (conj [] :yin.k/error)\\\\n  2344\\\\t                                                  (yang.call/condition\\\\n  2345\\\\t                                                    :yang.call/not-callable\\\\n  2346\\\\t                                                    (dsg__assoc {} :yang.call/callee dsg__callee))))))))\\\\n  2347\\\\t         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\\\\n  2348\\\\t         (outcomes? env) (u/let1\\\\n  2349\\\\t                           'dsg__make_admission\\\\n  2350\\\\t                           (u/sexp->uast\\\\n  2351\\\\t                             '(fn [dsg__descriptor]\\\\n  2352\\\\t                                (fn [dsg__candidate]\\\\n  2353\\\\t                                  (if (data/callable? dsg__call_token)\\\\n  2354\\\\t                                    (dsg__get dsg__descriptor :yang.call/entry)\\\\n  2355\\\\t                                    nil)))))\\\\n  2356\\\\t         (outcomes? env) (u/then\\\\n  2357\\\\t                           (discard-result\\\\n  2358\\\\t                             (u/app (u/lam '[get = assoc empty?] call/uast)\\\\n  2359\\\\t                                    (u/v 'dsg__get) (u/v 'dsg__equal)\\\\n  2360\\\\t                                    (u/v 'dsg__assoc) (u/v 'dsg__empty))))\\\\n  2361\\\\t         (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\\\\n  2362\\\\t         ;; Guest closures keep captured environments portable: binding host\\\\n  2363\\\\t         ;; primitive values here would make UCF machine-data validation fail.\\\\n  2364\\\\t         ;; These helpers cover generated map lookups/writes and comparisons;\\\\n  2365\\\\t         ;; conj/vec are already protected by the convention's binder checks.\\\\n  2366\\\\t         ;; Evaluate siblings outside each other's bindings to avoid retaining\\\\n  2367\\\\t         ;; a chain of redundant helper environments.\\\\n  2368\\\\t         (outcomes? env) (#(u/app\\\\n  2369\\\\t                             (u/lam '[dsg__get dsg__equal dsg__assoc dsg__empty] %)\\\\n  2370\\\\t                             (if (contains? (::defined env) 'get)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:13:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/yang/call/conformance.clj | sed -n '1,330p'; rg -n 'identity|higher.order|returned|callback|bag|token|descriptor|cell-ref' test/yang/call\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\t(ns yang.call.conformance\\\\n     2\\\\t  \\\\\\\"The cross-language calling gates' shared composition (docs/design/\\\\n     3\\\\t   yang.antlr.md section 8.10.11): a donor program's named export reaches a\\\\n     4\\\\t   caller program by explicit published-export composition only.\\\\n     5\\\\t\\\\n     6\\\\t   A donor is real source of any admitted frontend, lowered unmodified and\\\\n     7\\\\t   published as an ordinary linker module whose one export, `body`, is the\\\\n     8\\\\t   lowered unit. A caller task requires that module, runs its body under the\\\\n     9\\\\t   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\\\\n    10\\\\t   `clj/run-main`), reads each named export from the donor runtime's global\\\\n    11\\\\t   namespace, and projects it into the caller runtime's namespace under the\\\\n    12\\\\t   same name; then the caller source, lowered unmodified, runs under its own\\\\n    13\\\\t   entry. The composition is a sequence of top-level nodes: no call node is\\\\n    14\\\\t   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\\\\n    15\\\\t   inserted, and the projected value is the donor's own callable value\\\\n    16\\\\t   (identity survives).\\\\n    17\\\\t\\\\n    18\\\\t   A callable value is task-local (a function is a cell, and cells are\\\\n    19\\\\t   task-local, section 8.11), so the export is answered as a node evaluated\\\\n    20\\\\t   in the caller's task, never as a host value carried between tasks.\\\\n    21\\\\t   `export-program` answers the donor's export alone as the program's value.\\\\n    22\\\\t\\\\n    23\\\\t   Every program runs linked on the three vector VMs (`semantic`, `stack`,\\\\n    24\\\\t   `register`) over the TypeScript linked harness's content store, where\\\\n    25\\\\t   `yang.call` and `js` already live and `php`, `py` and `clj` are\\\\n    26\\\\t   published beside them. The AST walker is not a backend: its links are\\\\n    27\\\\t   refused until L-b.\\\\\\\"\\\\n    28\\\\t  (:require\\\\n    29\\\\t    [clojure.string :as str]\\\\n    30\\\\t    [yang.clojure :as clj-comp]\\\\n    31\\\\t    [yang.clojure.prelude :as clj-prelude]\\\\n    32\\\\t    [yang.core.module :as core-module]\\\\n    33\\\\t    [yang.core.names :as names]\\\\n    34\\\\t    [yang.core.uast :as u]\\\\n    35\\\\t    [yang.php.antlr.cst :as php-cst]\\\\n    36\\\\t    [yang.php.antlr.lower :as php-lower]\\\\n    37\\\\t    [yang.php.antlr.portable-harness :as php-h]\\\\n    38\\\\t    [yang.php.antlr.prelude :as php-prelude]\\\\n    39\\\\t    [yang.python.antlr.lower :as py-lower]\\\\n    40\\\\t    [yang.python.antlr.parser :as py-parser]\\\\n    41\\\\t    [yang.python.antlr.prelude :as py-prelude]\\\\n    42\\\\t    [yang.python.antlr.render :as py-render]\\\\n    43\\\\t    [yang.typescript.antlr.cst :as ts-cst]\\\\n    44\\\\t    [yang.typescript.antlr.linked-harness :as h]\\\\n    45\\\\t    [yang.typescript.antlr.lower :as ts-lower]\\\\n    46\\\\t    [yang.typescript.antlr.render :as render]\\\\n    47\\\\t    [yin.vm :as vm]))\\\\n    48\\\\t\\\\n    49\\\\t\\\\n    50\\\\t(def ^:private published-php\\\\n    51\\\\t  \\\\\\\"`php` published once into `js`'s content store, pinning the same\\\\n    52\\\\t   `yang.call` revision (as `source-call-test` publishes it).\\\\\\\"\\\\n    53\\\\t  (delay (h/publish-guest-module!\\\\n    54\\\\t           (php-prelude/module-spec (h/registry)\\\\n    55\\\\t                                    (:call-address @h/published)))))\\\\n    56\\\\t\\\\n    57\\\\t\\\\n    58\\\\t(def ^:private published-py\\\\n    59\\\\t  \\\\\\\"`py` published beside `js` and `php`, over the same host registry and\\\\n    60\\\\t   `yang.call` revision.\\\\\\\"\\\\n    61\\\\t  (delay (h/publish-guest-module!\\\\n    62\\\\t           (py-prelude/module-spec (h/registry)\\\\n    63\\\\t                                   (:call-address @h/published)))))\\\\n    64\\\\t\\\\n    65\\\\t\\\\n    66\\\\t(def ^:private published-clj\\\\n    67\\\\t  \\\\\\\"`clj` published beside `js`, `php` and `py`, over the same host registry\\\\n    68\\\\t   and `yang.call` revision.\\\\\\\"\\\\n    69\\\\t  (delay (h/publish-guest-module!\\\\n    70\\\\t           (clj-prelude/module-spec (h/registry)\\\\n    71\\\\t                                    (:call-address @h/published)))))\\\\n    72\\\\t\\\\n    73\\\\t\\\\n    74\\\\t(defn- parse-ok\\\\n    75\\\\t  \\\\\\\"The CST packet of `source` under `parse`, refused unless the parse is ok.\\\\\\\"\\\\n    76\\\\t  [parse source]\\\\n    77\\\\t  (let [pk (parse source)]\\\\n    78\\\\t    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\\\\n    79\\\\t      (throw (ex-info \\\\\\\"donor or caller source does not parse\\\\\\\"\\\\n    80\\\\t                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\\\\n    81\\\\t    pk))\\\\n    82\\\\t\\\\n    83\\\\t\\\\n    84\\\\t(defn- python-export-symbol\\\\n    85\\\\t  [export]\\\\n    86\\\\t  (symbol (str \\\\\\\"xlang.python.export.\\\\\\\" export)))\\\\n    87\\\\t\\\\n    88\\\\t\\\\n    89\\\\t(defn- python-unit\\\\n    90\\\\t  [packet exports]\\\\n    91\\\\t  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\\\\n    92\\\\t         (u/seq-nodes\\\\n    93\\\\t           (concat (map (fn [export]\\\\n    94\\\\t                          (u/sexp->uast\\\\n    95\\\\t                            (list 'py/global-set py-lower/globals-sym\\\\n    96\\\\t                                  {:py/str export} (python-export-symbol export))))\\\\n    97\\\\t                        exports)\\\\n    98\\\\t                   [(py-lower/lower-module-body packet)]))))\\\\n    99\\\\t\\\\n   100\\\\t\\\\n   101\\\\t(def frontends\\\\n   102\\\\t  \\\\\\\"Each admitted frontend's profile, as data:\\\\n   103\\\\t\\\\n   104\\\\t   - `:runtime`, `:address`: the runtime module and its published address;\\\\n   105\\\\t   - `:refusal`: the publication refusal key and reason of its modules;\\\\n   106\\\\t   - `:deps` (optional): pinned requirements beyond the runtime its\\\\n   107\\\\t     lowered units read directly (the clojure unit's `yang.call` reads);\\\\n   108\\\\t   - `:parse`: source text to CST packet;\\\\n   109\\\\t   - `:unit`: packet and projected exports to the lowered unit its\\\\n   110\\\\t     `:run-main` entry takes;\\\\n   111\\\\t   - `:read-export`: export name to the form reading the runtime's global\\\\n   112\\\\t     namespace (JS `globalThis`, PHP's named-function table, Python's main\\\\n   113\\\\t     module dictionary, the clojure runtime's task-local namespace cell);\\\\n   114\\\\t   - `:project`: name and a value form to the form binding the value where\\\\n   115\\\\t     the runtime's source resolves a called name;\\\\n   116\\\\t   - `:render`: the `:run-main` value as test data.\\\\\\\"\\\\n   117\\\\t  {:typescript\\\\n   118\\\\t   {:runtime 'js,\\\\n   119\\\\t    :address #(:address @h/published),\\\\n   120\\\\t    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\\\\n   121\\\\t    :parse #(parse-ok ts-cst/parse-source %),\\\\n   122\\\\t    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\\\\n   123\\\\t    :run-main 'js/run-main,\\\\n   124\\\\t    :read-export (fn [export] (list 'js/global-get {:js/str export})),\\\\n   125\\\\t    :project (fn [name value] (list 'js/define-global! name value)),\\\\n   126\\\\t    :render render/output},\\\\n   127\\\\t   :php\\\\n   128\\\\t   {:runtime 'php,\\\\n   129\\\\t    :address #(:address @published-php),\\\\n   130\\\\t    :refusal [:yang.php/refusal :yang.php/undeclared-free],\\\\n   131\\\\t    :parse #(parse-ok php-cst/parse-source %),\\\\n   132\\\\t    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\\\\n   133\\\\t    :run-main 'php/run-main,\\\\n   134\\\\t    :read-export (fn [export]\\\\n   135\\\\t                   (list 'php/resolve-fn (str/lower-case export) export)),\\\\n   136\\\\t    :project (fn [name value]\\\\n   137\\\\t               (list 'php/declare-function! (str/lower-case name) value)),\\\\n   138\\\\t    :render php-h/render},\\\\n   139\\\\t   :python\\\\n   140\\\\t   {:runtime 'py,\\\\n   141\\\\t    :address #(:address @published-py),\\\\n   142\\\\t    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\\\\n   143\\\\t    :parse #(parse-ok py-parser/parse-source %),\\\\n   144\\\\t    :unit python-unit,\\\\n   145\\\\t    :run-main 'py/run-main,\\\\n   146\\\\t    :read-export (fn [export]\\\\n   147\\\\t                   (list 'py/global-get\\\\n   148\\\\t                         (list 'py/module-dict\\\\n   149\\\\t                               (list 'py/modules-ref {:py/str \\\\\\\"__main__\\\\\\\"}))\\\\n   150\\\\t                         {:py/str export})),\\\\n   151\\\\t    :project (fn [name value]\\\\n   152\\\\t               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\\\\n   153\\\\t    :render py-render/output},\\\\n   154\\\\t   :clojure\\\\n   155\\\\t   {:runtime 'clj,\\\\n   156\\\\t    :address #(:address @published-clj),\\\\n   157\\\\t    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\\\\n   158\\\\t    :deps (fn [] {'yang.call (:call-address @h/published)}),\\\\n   159\\\\t    :parse clj-comp/read-forms,\\\\n   160\\\\t    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\\\\n   161\\\\t    :run-main 'clj/run-main,\\\\n   162\\\\t    :read-export (fn [export] (list 'clj/global-get export)),\\\\n   163\\\\t    :project (fn [name value]\\\\n   164\\\\t               ;; The runtime global namespace is the one binding (as\\\\n   165\\\\t               ;; `js/define-global!` is for a JS caller): `lower-unit`\\\\n   166\\\\t               ;; reads each projected name through `clj/global-get`, so\\\\n   167\\\\t               ;; no task-store binding duplicates it. A caller top-level\\\\n   168\\\\t               ;; definition of the same name publishes after the\\\\n   169\\\\t               ;; projection and shadows it.\\\\n   170\\\\t               (list 'clj/define-global! name value)),\\\\n   171\\\\t    :render clj-comp/output}})\\\\n   172\\\\t\\\\n   173\\\\t\\\\n   174\\\\t(defn- profile\\\\n   175\\\\t  [frontend]\\\\n   176\\\\t  (or (get frontends frontend)\\\\n   177\\\\t      (throw (ex-info \\\\\\\"frontend not admitted\\\\\\\" {:frontend frontend}))))\\\\n   178\\\\t\\\\n   179\\\\t\\\\n   180\\\\t(defn- modules\\\\n   181\\\\t  \\\\\\\"The host registry, admitted by every runtime profile that checks it,\\\\n   182\\\\t   with the clojure guest library's host surface installed beside them.\\\\n   183\\\\t   Donor publication declares free names over this same registry, so a\\\\n   184\\\\t   clojure donor using the guest library (its `kind` and `portable`\\\\n   185\\\\t   hosts) publishes like it runs.\\\\\\\"\\\\n   186\\\\t  []\\\\n   187\\\\t  (clj-prelude/admit (php-prelude/admit (h/registry))))\\\\n   188\\\\t\\\\n   189\\\\t\\\\n   190\\\\t(defn publish-donor!\\\\n   191\\\\t  \\\\\\\"Publish the donor `source` of `frontend` as the module `module` (default\\\\n   192\\\\t   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\\\\n   193\\\\t   Answers `{:frontend :module :address :links}`.\\\\\\\"\\\\n   194\\\\t  ([frontend source]\\\\n   195\\\\t   (publish-donor! frontend source (symbol (str \\\\\\\"xlang.donor.\\\\\\\" (name frontend)))))\\\\n   196\\\\t  ([frontend source module]\\\\n   197\\\\t   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\\\\n   198\\\\t         [refusal-key reason] refusal\\\\n   199\\\\t         spec (core-module/module-spec\\\\n   200\\\\t                refusal-key reason (modules)\\\\n   201\\\\t                {:name module,\\\\n   202\\\\t                 :ast (core-module/module-tree\\\\n   203\\\\t                        [(core-module/require-node runtime)\\\\n   204\\\\t                         (u/def! 'body (unit (parse source) []))]),\\\\n   205\\\\t                 :exports '#{body},\\\\n   206\\\\t                 :runtime-name runtime,\\\\n   207\\\\t                 :runtime-address (address),\\\\n   208\\\\t                 :deps (if deps (deps) {})})\\\\n   209\\\\t         result (h/publish-guest-module! spec)]\\\\n   210\\\\t     {:frontend frontend,\\\\n   211\\\\t      :module module,\\\\n   212\\\\t      :address (:address result),\\\\n   213\\\\t      :links (:links result)})))\\\\n   214\\\\t\\\\n   215\\\\t\\\\n   216\\\\t(defn- runtime-entry\\\\n   217\\\\t  \\\\\\\"Require and initialize each distinct runtime of `frontend-keys`, once.\\\\\\\"\\\\n   218\\\\t  [frontend-keys]\\\\n   219\\\\t  (into [(core-module/require-node 'yang.call)]\\\\n   220\\\\t        (mapcat (fn [runtime]\\\\n   221\\\\t                  [(core-module/require-node runtime)\\\\n   222\\\\t                   (u/sexp->uast (list (symbol (str runtime) \\\\\\\"init!\\\\\\\")))]))\\\\n   223\\\\t        (distinct (map (comp :runtime profile) frontend-keys))))\\\\n   224\\\\t\\\\n   225\\\\t\\\\n   226\\\\t(defn- donor-run\\\\n   227\\\\t  \\\\\\\"The donor module required and its body run under its runtime's entry.\\\\\\\"\\\\n   228\\\\t  [{:keys [frontend module]}]\\\\n   229\\\\t  [(core-module/require-node module)\\\\n   230\\\\t   (u/app (u/v (:run-main (profile frontend)))\\\\n   231\\\\t          (u/v (symbol (str module) \\\\\\\"body\\\\\\\")))])\\\\n   232\\\\t\\\\n   233\\\\t\\\\n   234\\\\t(defn export-program\\\\n   235\\\\t  \\\\\\\"The program whose value is the donor's `export`, read from its runtime's\\\\n   236\\\\t   global namespace after its body ran.\\\\\\\"\\\\n   237\\\\t  [donor export]\\\\n   238\\\\t  (let [{:keys [read-export]} (profile (:frontend donor))]\\\\n   239\\\\t    (u/mark-tails\\\\n   240\\\\t      (u/seq-nodes (concat (runtime-entry [(:frontend donor)])\\\\n   241\\\\t                           (donor-run donor)\\\\n   242\\\\t                           [(u/sexp->uast (read-export export))])))))\\\\n   243\\\\t\\\\n   244\\\\t\\\\n   245\\\\t(defn compose\\\\n   246\\\\t  \\\\\\\"The caller program: the donor's body run, each name of `exports` read\\\\n   247\\\\t   from the donor runtime and projected into `caller-frontend`'s namespace\\\\n   248\\\\t   under the same name, then `caller-source`, lowered unmodified, run under\\\\n   249\\\\t   its runtime's entry. Its value is the caller entry's value.\\\\\\\"\\\\n   250\\\\t  [donor exports caller-frontend caller-source]\\\\n   251\\\\t  (let [{:keys [read-export]} (profile (:frontend donor))\\\\n   252\\\\t        {:keys [project parse unit run-main]} (profile caller-frontend)]\\\\n   253\\\\t    (u/mark-tails\\\\n   254\\\\t      (u/seq-nodes\\\\n   255\\\\t        (concat (runtime-entry [(:frontend donor) caller-frontend])\\\\n   256\\\\t                (donor-run donor)\\\\n   257\\\\t                (map (fn [export]\\\\n   258\\\\t                       (let [value (symbol (str \\\\\\\"xlang.export.\\\\\\\" export))]\\\\n   259\\\\t                         (u/let1 value\\\\n   260\\\\t                                 (u/sexp->uast (read-export export))\\\\n   261\\\\t                                 (u/sexp->uast (project export value)))))\\\\n   262\\\\t                     exports)\\\\n   263\\\\t                [(u/app (u/v run-main) (unit (parse caller-source) exports))])))))\\\\n   264\\\\t\\\\n   265\\\\t\\\\n   266\\\\t(defn link-source\\\\n   267\\\\t  \\\\\\\"The serving composition naming the runtimes and the donor module.\\\\\\\"\\\\n   268\\\\t  [{:keys [module address]}]\\\\n   269\\\\t  (h/source {'yang.call (:call-address @h/published),\\\\n   270\\\\t             'js (:address @h/published),\\\\n   271\\\\t             'php (:address @published-php),\\\\n   272\\\\t             'py (:address @published-py),\\\\n   273\\\\t             'clj (:address @published-clj),\\\\n   274\\\\t             module address}))\\\\n   275\\\\t\\\\n   276\\\\t\\\\n   277\\\\t(defn run-program\\\\n   278\\\\t  \\\\\\\"`{backend value}` of `ast`, linked against `donor`, on each vector VM.\\\\\\\"\\\\n   279\\\\t  [donor ast]\\\\n   280\\\\t  (let [src (link-source donor)]\\\\n   281\\\\t    (into (sorted-map)\\\\n   282\\\\t          (map (fn [backend]\\\\n   283\\\\t                 [backend\\\\n   284\\\\t                  (vm/value (h/run-linked backend ast {:modules (modules),\\\\n   285\\\\t                                                       :link-source src}))]))\\\\n   286\\\\t          (keys h/backends))))\\\\n   287\\\\t\\\\n   288\\\\t\\\\n   289\\\\t(defn agreed\\\\n   290\\\\t  \\\\\\\"The one value every backend of `results` answered, else\\\\n   291\\\\t   `{:disagreement results}`.\\\\\\\"\\\\n   292\\\\t  [results]\\\\n   293\\\\t  (let [vs (set (vals results))]\\\\n   294\\\\t    (if (= 1 (count vs)) (first vs) {:disagreement results})))\\\\n   295\\\\t\\\\n   296\\\\t\\\\n   297\\\\t(defn call\\\\n   298\\\\t  \\\\\\\"Publish the donor `[frontend source]`, compose its `exports` into the\\\\n   299\\\\t   caller `[frontend source]`, run it on each vector VM and answer the\\\\n   300\\\\t   caller's rendered value when every backend agrees (else\\\\n   301\\\\t   `{:disagreement {backend rendered}}`).\\\\\\\"\\\\n   302\\\\t  [[donor-frontend donor-source] exports [caller-frontend caller-source]]\\\\n   303\\\\t  (let [donor (publish-donor! donor-frontend donor-source)\\\\n   304\\\\t        render (:render (profile caller-frontend))]\\\\n   305\\\\t    (agreed (update-vals (run-program donor (compose donor exports caller-frontend\\\\n   306\\\\t                                                     caller-source))\\\\n   307\\\\t                         render))))\\\\ntest/yang/call/conformance.clj:16:   (identity survives).\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:15:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba docs/design/yang.antlr.md | sed -n '3514,3645p;3717,3748p;3771,3832p;3937,4040p'; rg -n 'dsg__call_token|token-packet|D2' src/cljc/yang test/yang/core docs/design/yang.antlr.md\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"  3514\\\\t### 8.10 Shared function calling convention\\\\n  3515\\\\t\\\\n  3516\\\\t**Status: proposed, 2026-10-29; not implemented.** This section specifies\\\\n  3517\\\\tone invocation convention for every conforming ANTLR-based Yang frontend.\\\\n  3518\\\\tExamples are non-exhaustive. Adding a language must not add a case to Yang\\\\n  3519\\\\tcore, a language-pair bridge, or an evaluator transition. The words\\\\n  3520\\\\t**must**, **must not**, and **may** state requirements on a future\\\\n  3521\\\\tconforming implementation, not claims about current code.\\\\n  3522\\\\t\\\\n  3523\\\\t#### 8.10.1 Decision and scope\\\\n  3524\\\\t\\\\n  3525\\\\tA Yin function is a Yin function, independent of its source syntax. The\\\\n  3526\\\\tVM applies a closure to operands. Source calling semantics are ordinary\\\\n  3527\\\\tUAST implementing the call site and callee entry, above the VM.\\\\n  3528\\\\t\\\\n  3529\\\\tEvery supported source-level callable, after its source-required\\\\n  3530\\\\tresolution, exposes `:yang.call/entry`, an ordinary Yin closure taking\\\\n  3531\\\\texactly one invocation record. Invoking it is an ordinary\\\\n  3532\\\\t`:application`. No AST tag, lambda slot, instruction, host primitive,\\\\n  3533\\\\teffect kind, or source-language test is added to the VM.\\\\n  3534\\\\t\\\\n  3535\\\\tThis is an internal calling convention, not a transport, another system\\\\n  3536\\\\tABI, or a host callback interface. Calls between source languages inside\\\\n  3537\\\\tone task do not themselves cross a host boundary. Portable I/O and\\\\n  3538\\\\tcross-task interaction continue through `dao.stream`.\\\\n  3539\\\\t\\\\n  3540\\\\t**Transparent calling** means that an admitted callable can be passed,\\\\n  3541\\\\tstored, returned, and invoked by any conforming frontend without a\\\\n  3542\\\\thandwritten language-pair wrapper. It does not mean every foreign value\\\\n  3543\\\\tsatisfies every source operation. Invocation, name visibility, and value\\\\n  3544\\\\tinterpretation are distinct obligations.\\\\n  3545\\\\t\\\\n  3546\\\\tThe convention covers ordinary source calls and supported callable\\\\n  3547\\\\tobjects, including higher-order calls. It does not make macros runtime\\\\n  3548\\\\tfunctions, grant JavaScript `[[Construct]]`, turn a generator into an\\\\n  3549\\\\tordinary returning function, or add a source feature a frontend refuses.\\\\n  3550\\\\tConstructors and asynchronous operations keep their declared source\\\\n  3551\\\\tsemantics; ordinary callability does not imply either capability.\\\\n  3552\\\\t\\\\n  3553\\\\t#### 8.10.2 Callable representation and identity\\\\n  3554\\\\t\\\\n  3555\\\\tKeep the callable's existing identity and source-specific data. Add the\\\\n  3556\\\\tcommon entry beside its private code and metadata:\\\\n  3557\\\\t\\\\n  3558\\\\t```clojure\\\\n  3559\\\\t;; Illustrative contents of one task-owned Python function cell.\\\\n  3560\\\\t;; `entry` and `body-code` are live Yin closures, not literal AST maps.\\\\n  3561\\\\t{:yang.call/entry entry\\\\n  3562\\\\t :py/type :function\\\\n  3563\\\\t :spec parameter-spec\\\\n  3564\\\\t :defaults defaults\\\\n  3565\\\\t :code body-code}\\\\n  3566\\\\t```\\\\n  3567\\\\t\\\\n  3568\\\\tThe existing `:code` field is not the shared entry: its signature differs\\\\n  3569\\\\tbetween preludes. It may remain private. Cross-language callers must not\\\\n  3570\\\\tinspect it or extract it to bypass the entry.\\\\n  3571\\\\t\\\\n  3572\\\\tA cell-backed callable stores the entry in its cell contents. An\\\\n  3573\\\\timmutable callable descriptor, such as a bound method, may carry it\\\\n  3574\\\\tdirectly in its map. The common prelude projects the entry structurally:\\\\n  3575\\\\tread an existing sealed cell reference through `cell/get`, or inspect\\\\n  3576\\\\tthe immutable descriptor, then obtain `:yang.call/entry`. It must not\\\\n  3577\\\\tdispatch on `:py/type`, `:js/type`, `:php/type`, language names, or a\\\\n  3578\\\\tregistry of languages.\\\\n  3579\\\\t\\\\n  3580\\\\tAn admitted callable is a runtime cell/descriptor constructed or exposed\\\\n  3581\\\\tby the callable constructors or import/export projections of a pinned,\\\\n  3582\\\\tconforming profile. The entry slot is a runtime descriptor field, not a\\\\n  3583\\\\tsource property that promotes arbitrary data to a function. A Python\\\\n  3584\\\\tdictionary, JavaScript object, or PHP array containing a source key\\\\n  3585\\\\tspelled `:yang.call/entry` remains ordinary source data unless an explicit\\\\n  3586\\\\tprofile-defined projection makes it a callable descriptor. Source\\\\n  3587\\\\tproperty access must not overwrite or masquerade as this runtime slot.\\\\n  3588\\\\tThis is an obligation of construction and source resolution, not a new\\\\n  3589\\\\tVM type, descriptor seal, or runtime provenance/language registry. Once\\\\n  3590\\\\tthe resolved descriptor is admitted, the shared projection is structural;\\\\n  3591\\\\tUAST deliberately constructing a conforming descriptor opts into the\\\\n  3592\\\\tconvention rather than changing a source language's data-map semantics.\\\\n  3593\\\\t\\\\n  3594\\\\tMissing entry means not callable. Constructors must install a genuine\\\\n  3595\\\\tunary Yin closure, and supported source mutations must preserve that\\\\n  3596\\\\tinvariant. Unary arity is a constructor/profile conformance obligation,\\\\n  3597\\\\tnot a signature introspection operation: Yin closures are opaque and the\\\\n  3598\\\\tVM's existing argument binding does not enforce this convention's arity.\\\\n  3599\\\\tA key in a map grants no VM privilege; application, ownership, and\\\\n  3600\\\\teffect checks still apply. A non-applicable entry remains an operational\\\\n  3601\\\\tVM application defect, not a source exception caught by the shared helper.\\\\n  3602\\\\t\\\\n  3603\\\\tFor callable kinds whose eligibility can change, the same cell or\\\\n  3604\\\\tdescriptor may also contain `:yang.call/eligible?`, a unary Yin predicate\\\\n  3605\\\\ton the original callable. Without it, an entry is eligible by default.\\\\n  3606\\\\tWith it, the common callable test uses its boolean result. The predicate\\\\n  3607\\\\treads explicit runtime metadata/heap only; it must not mutate state,\\\\n  3608\\\\tevaluate arguments, execute the target body, or invoke getters/user hooks.\\\\n  3609\\\\tIt has the same constructor/arity obligations as the entry. For example,\\\\n  3610\\\\tan instance can keep one dispatch entry while eligibility follows whether\\\\n  3611\\\\tits class currently supplies a supported call method; changing the class\\\\n  3612\\\\tdoes not require rewriting every instance.\\\\n  3613\\\\t\\\\n  3614\\\\tCall eligibility is tested at the callability-check point required by\\\\n  3615\\\\tthe caller's source, not universally before argument evaluation. The\\\\n  3616\\\\tentry resolves/rechecks a dynamic target at its source-required dispatch\\\\n  3617\\\\tpoint so argument side effects that change eligibility remain visible.\\\\n  3618\\\\tStatic callable kinds need no predicate.\\\\n  3619\\\\t\\\\n  3620\\\\tSource callable designators, such as PHP function-name strings and\\\\n  3621\\\\tcallable arrays where supported, are resolved under their source's rules\\\\n  3622\\\\tbefore common invocation. They do not gain entry slots merely by being\\\\n  3623\\\\tstrings or arrays. Exporting a designator as a first-class callable needs\\\\n  3624\\\\tan explicit frontend projection to an admitted descriptor, retaining any\\\\n  3625\\\\tsource-required late lookup and receiver semantics. Passing the raw\\\\n  3626\\\\tstring or array as data leaves it unchanged; a foreign caller must not\\\\n  3627\\\\tguess its language or search an ambient namespace to invoke it. This is\\\\n  3628\\\\tsource resolution/projection, not a language-pair wrapper around an\\\\n  3629\\\\talready admitted function.\\\\n  3630\\\\t\\\\n  3631\\\\tCross-language passage must not allocate a replacement function cell.\\\\n  3632\\\\tReturned functions retain their original identity, captures, defaults,\\\\n  3633\\\\tbound receiver, properties, and static state. A receiving frontend's\\\\n  3634\\\\tcallable test follows this common eligibility rule rather than rejecting\\\\n  3635\\\\tforeign native tags. Foreign attribute access and type reflection remain\\\\n  3636\\\\tprofile-owned; callability grants no general right to interpret another\\\\n  3637\\\\truntime's cell layout.\\\\n  3638\\\\t\\\\n  3639\\\\tCompiler-internal lambdas and host functions do not acquire this\\\\n  3640\\\\tconvention merely by being applicable in Yin. A source import exposing\\\\n  3641\\\\tone must emit an entry from its declared signature and effect profile.\\\\n  3642\\\\tIt must not guess an opaque closure's signature or bypass host-effect\\\\n  3643\\\\tand custody rules. Internal helper calls need not construct records.\\\\n  3644\\\\t\\\\n  3645\\\\t#### 8.10.3 Invocation record\\\\n  3717\\\\t#### 8.10.4 Source semantics at caller and callee\\\\n  3718\\\\t\\\\n  3719\\\\tThe caller's lowering preserves its source rules for callable resolution,\\\\n  3720\\\\targument/receiver evaluation, and spread or unpacking. Evaluate each\\\\n  3721\\\\texpression exactly once, in the source-defined order. Errors required\\\\n  3722\\\\tbefore argument evaluation must still occur before it. The record holds\\\\n  3723\\\\tevaluated values; the callee must not reevaluate source expressions.\\\\n  3724\\\\t\\\\n  3725\\\\tAfter source resolution, calls use the common projection and application.\\\\n  3726\\\\tFor a cell-backed callable, the successful path is schematically:\\\\n  3727\\\\t\\\\n  3728\\\\t```clojure\\\\n  3729\\\\t;; UAST notation after source evaluation/resolution and validation.\\\\n  3730\\\\t;; The caller has already established `raise-exit`.\\\\n  3731\\\\t(let [entry (get (cell/get f) :yang.call/entry)\\\\n  3732\\\\t      invocation (assoc evaluated-arguments\\\\n  3733\\\\t                        :yang.call/callee f\\\\n  3734\\\\t                        :yang.call/raise raise-exit)]\\\\n  3735\\\\t  (entry invocation))\\\\n  3736\\\\t```\\\\n  3737\\\\t\\\\n  3738\\\\tThe shared prelude handles projection and validation for cell-backed and\\\\n  3739\\\\timmutable callables. Existing `py/call`, `js/call`, or `php/call` names\\\\n  3740\\\\tmay remain as source call-site helpers, but must not reject an admitted\\\\n  3741\\\\tforeign callable because its native type tag differs.\\\\n  3742\\\\t\\\\n  3743\\\\tThe callee entry installs its exception boundary **before parameter\\\\n  3744\\\\tbinding**. It owns defaults, arity checks, positional/named/variadic\\\\n  3745\\\\tbinding, receiver interpretation, and supported source constraints and\\\\n  3746\\\\tcoercions. It then invokes its body using its private lowered signature\\\\n  3747\\\\tand captured environment.\\\\n  3748\\\\t\\\\n  3771\\\\t#### 8.10.5 Values and projections\\\\n  3772\\\\t\\\\n  3773\\\\tThe base convention passes arguments, results, callable values, cell\\\\n  3774\\\\treferences, and thrown payloads **unchanged**. It performs no scalar\\\\n  3775\\\\tconversion, copying, serialization, or object-model translation. Opaque\\\\n  3776\\\\tvalues may be stored and passed back without understanding them. Within\\\\n  3777\\\\tone task, aliases retain the same sealed references and ownership.\\\\n  3778\\\\t\\\\n  3779\\\\tA Python identity function can return a JavaScript object unchanged. A\\\\n  3780\\\\tJavaScript higher-order function can invoke an admitted Python function.\\\\n  3781\\\\tLanguage-specific operations on unsupported foreign encodings may raise\\\\n  3782\\\\tthe receiving profile's documented guest error. Calling compatibility\\\\n  3783\\\\tdoes not establish that Python `2` is a JavaScript Number rather than a\\\\n  3784\\\\tBigInt, or that a Python string map is a JavaScript string.\\\\n  3785\\\\t\\\\n  3786\\\\tIn particular, preserve:\\\\n  3787\\\\t\\\\n  3788\\\\t- The distinction between null, None, undefined, and absent arguments.\\\\n  3789\\\\t- Exact integers without silent narrowing or floating-point rounding.\\\\n  3790\\\\t- Float64 content, signed zero, declared NaN behavior, byte strings,\\\\n  3791\\\\t  Unicode scalar strings, and UTF-16 code-unit strings in their own forms.\\\\n  3792\\\\t- Object identity and aliasing; an object's cell is not a caller's\\\\n  3793\\\\t  writable variable binding.\\\\n  3794\\\\t\\\\n  3795\\\\tIf conversion is wanted, the export/import declaration must pin an\\\\n  3796\\\\texplicit value projection by content address. Its loss/range/null/string/\\\\n  3797\\\\tidentity rules are compilation inputs, and its code remains in the UAST.\\\\n  3798\\\\tProjections may be implemented once per language and agreed data\\\\n  3799\\\\tvocabulary. The shared mechanism must not grow a matrix of caller-language/\\\\n  3800\\\\tcallee-language conversions or silently select a projection.\\\\n  3801\\\\t\\\\n  3802\\\\tConformance therefore distinguishes **invocation compatibility** from\\\\n  3803\\\\t**value-operation compatibility**. Transparent invocation is mandatory;\\\\n  3804\\\\tarbitrary foreign arithmetic or object access is not implied. Every\\\\n  3805\\\\tadvertised projection needs separate behavioral conformance tests.\\\\n  3806\\\\t\\\\n  3807\\\\t#### 8.10.6 References, higher-order calls, and ownership\\\\n  3808\\\\t\\\\n  3809\\\\tBy-value arguments may contain shared object references. That does not\\\\n  3810\\\\tauthorize rebinding the caller's variable: a value read from a local is\\\\n  3811\\\\tnot a location capability.\\\\n  3812\\\\t\\\\n  3813\\\\tSource-local reference arguments keep their pinned native binding\\\\n  3814\\\\tprofile. A call requiring foreign writable locations must declare a\\\\n  3815\\\\tcompatible profile or fail with a guest binding error before the body.\\\\n  3816\\\\tSilently allocating a temporary and claiming writeback is forbidden.\\\\n  3817\\\\tA location extension must define read/write operations, alias identity,\\\\n  3818\\\\tevaluation of nested paths exactly once, lifetime, ownership, cleanup,\\\\n  3819\\\\tand suspension. Generic callers must not decode PHP reference markers\\\\n  3820\\\\tor bypass its copy/count rules.\\\\n  3821\\\\t\\\\n  3822\\\\tFunctions passed, returned, or called recursively keep the common entry\\\\n  3823\\\\tand original identity. This includes calls back into a runtime already\\\\n  3824\\\\ton the stack. No caller-side rewrapping or language-pair cache is allowed.\\\\n  3825\\\\t\\\\n  3826\\\\tThese are in-task rules. A closure, continuation, cell, or live invocation\\\\n  3827\\\\tis not made portable by this convention. Linker/UCF custody and admission\\\\n  3828\\\\tstill govern task/host crossings; currently refused cell-bearing lifts\\\\n  3829\\\\tremain refused. Live closures in an invocation must not be placed in\\\\n  3830\\\\tcanonical literal data or sent as a purported portable request.\\\\n  3831\\\\t\\\\n  3832\\\\t#### 8.10.7 Normal return and escaping conditions\\\\n  3937\\\\t#### 8.10.9 Publication, visibility, and reproducibility\\\\n  3938\\\\t\\\\n  3939\\\\tShared callability creates no common global scope. An import or\\\\n  3940\\\\tcomposition explicitly binds exports in the receiving source namespace\\\\n  3941\\\\tunder its normal name/module rules. Missing names keep their source\\\\n  3942\\\\terrors. No fallback searches other frontends, the filesystem, a host\\\\n  3943\\\\tpackage registry, or ambient globals.\\\\n  3944\\\\t\\\\n  3945\\\\tLinked modules publish code and immutable specifications. Their bodies\\\\n  3946\\\\tinstantiate function objects and common entries in the importing task,\\\\n  3947\\\\tas section 8.5.6 requires. Install children must not export live function\\\\n  3948\\\\tcells. A higher-order result is an ordinary runtime value, not a new\\\\n  3949\\\\tlinker publication on each call.\\\\n  3950\\\\t\\\\n  3951\\\\tLowering/runtime profiles pin the implementation and binding/value\\\\n  3952\\\\textensions. Existing dependency/effect/custody checks remain. Type facts\\\\n  3953\\\\tstay beside code under `yin.vm.typecheck`, not in lambda language tags.\\\\n  3954\\\\tDo not duplicate existing lambda parameters in another persisted\\\\n  3955\\\\tauthority over the private body signature.\\\\n  3956\\\\t\\\\n  3957\\\\tBefore admitting a compiled composition, its profile/dependency\\\\n  3958\\\\tdeclarations must establish one compatible convention revision for the\\\\n  3959\\\\tentries it exposes. An incompatible revision needs an explicitly pinned\\\\n  3960\\\\tprojection or is refused before execution. Neither a common slot name nor\\\\n  3961\\\\tan opaque runtime closure proves revision compatibility. No runtime\\\\n  3962\\\\tlanguage registry or inspection of captured environments supplies it.\\\\n  3963\\\\t\\\\n  3964\\\\tChanged entry code changes code identities through the normal encoder.\\\\n  3965\\\\tRetain source, lowered UAST, pinned profiles, and projections under\\\\n  3966\\\\texisting provenance/unitarity rules. A fast path may omit the record\\\\n  3967\\\\tonly after proving equivalent evaluation, binding, foreign callability,\\\\n  3968\\\\texceptions, effects, suspension, and identity. Correctness must not\\\\n  3969\\\\tdepend on that optimization.\\\\n  3970\\\\t\\\\n  3971\\\\t#### 8.10.10 Current code and migration\\\\n  3972\\\\t\\\\n  3973\\\\tThe current code records the gap, not a second normative convention:\\\\n  3974\\\\t\\\\n  3975\\\\t| Current implementation | Private call path |\\\\n  3976\\\\t|---|---|\\\\n  3977\\\\t| `yang.python.antlr.prelude` | `py/call-kw` binds arguments and applies the function cell's `:code` to one vector. |\\\\n  3978\\\\t| `yang.typescript.antlr.prelude` | `js/call` checks `:js/type :function` and applies `:code` to receiver and argument vector. |\\\\n  3979\\\\t| `yang.php.antlr.prelude` | `php/call` applies `:code` to the function cell and argument vector; named/reference handling is separate. |\\\\n  3980\\\\t| `test/yang/cross_lang_test.clj` | Demonstrates PHP/TypeScript substrate composition using lookup rewriting and a test-local `js-shaped` wrapper; not proof of this convention. |\\\\n  3981\\\\t\\\\n  3982\\\\tImplementation proceeds as separately verified changes:\\\\n  3983\\\\t\\\\n  3984\\\\t1. Supply the shared guest prelude and fixtures for entry discovery,\\\\n  3985\\\\t   record validation, and condition transfer, using existing bundled/\\\\n  3986\\\\t   linked prelude emitter machinery.\\\\n  3987\\\\t2. Add entries to each supported callable constructor and builtin;\\\\n  3988\\\\t   preserve source metadata/private code while putting binding and\\\\n  3989\\\\t   exception boundaries under the entry. Keep existing source `:call`\\\\n  3990\\\\t   safepoint marks on their original source activation, normally the\\\\n  3991\\\\t   private body; generated entry/binding boilerplate remains unmarked.\\\\n  3992\\\\t   Do not copy a body's source mark onto its entry and count both. A\\\\n  3993\\\\t   separately proved instrumentation transformation may relocate a mark\\\\n  3994\\\\t   only while preserving its source timing and exactly one activation.\\\\n  3995\\\\t3. Route source-resolved calls and callable tests through the convention,\\\\n  3996\\\\t   including supported bound methods, callable objects, recursion, and\\\\n  3997\\\\t   nested runtime re-entry.\\\\n  3998\\\\t4. Integrate explicit export/name projections with module publication\\\\n  3999\\\\t   and task-local instantiation; remove test-only language-pair wrappers\\\\n  4000\\\\t   from the new conformance paths.\\\\n  4001\\\\t5. Pass the acceptance gates before advertising a conforming frontend\\\\n  4002\\\\t   revision. Old body signatures must not be mistaken for new entries.\\\\n  4003\\\\t\\\\n  4004\\\\tA frontend is not conformant while its advertised supported callable\\\\n  4005\\\\tkinds need pairwise wrappers. Legacy non-ANTLR frontends gain no claim\\\\n  4006\\\\tfrom this proposal; joining later requires the same entry obligations.\\\\n  4007\\\\tThere is no implication that current Python, PHP, TypeScript, or a host\\\\n  4008\\\\ttarget has completed this migration.\\\\n  4009\\\\t\\\\n  4010\\\\t#### 8.10.11 Acceptance gates\\\\n  4011\\\\t\\\\n  4012\\\\tExecute real lowered source bodies, not only synthetic functions with\\\\n  4013\\\\tthe expected slot. A harness may compose published exports and namespace\\\\n  4014\\\\tprojections explicitly. It must not rewrite call nodes, extract foreign\\\\n  4015\\\\t`:code`, or insert test-local language-pair wrappers to make calls work.\\\\n  4016\\\\t\\\\n  4017\\\\tRequired evidence:\\\\n  4018\\\\t\\\\n  4019\\\\t- **Local semantics:** existing suites preserve argument order, defaults,\\\\n  4020\\\\t  required/extra arguments, keyword errors, receivers, exceptions, and\\\\n  4021\\\\t  supported reference/static behavior.\\\\n  4022\\\\t- **Direct calls:** each implemented frontend calls every other\\\\n  4023\\\\t  conforming frontend through the same mechanism in both directions\\\\n  4024\\\\t  with compatible values. Derive the test matrix from admitted\\\\n  4025\\\\t  frontends; do not hard-code it into runtime dispatch.\\\\n  4026\\\\t- **Higher-order calls:** pass, return, store, recurse, and call back\\\\n  4027\\\\t  through received functions. Assert identity and captures without\\\\n  4028\\\\t  replacement cells.\\\\n  4029\\\\t- **Callable admission:** source data with an entry-spelled property\\\\n  4030\\\\t  remains data; profile-constructed descriptors are admitted. Exercise\\\\n  4031\\\\t  supported PHP string/array designators both under local resolution and\\\\n  4032\\\\t  explicit callable export, preserving required late lookup without\\\\n  4033\\\\t  foreign namespace guessing.\\\\n  4034\\\\t- **Presence and binding:** distinguish missing from explicit\\\\n  4035\\\\t  null/None/undefined; retain duplicate keywords until binding; supply\\\\n  4036\\\\t  bound self once; evaluate receiver/spreads/defaults at source-defined\\\\n  4037\\\\t  times and counts.\\\\n  4038\\\\t- **Dynamic callability:** where supported, an existing instance becomes\\\\n  4039\\\\t  eligible after its class gains a call method and ineligible after\\\\n  4040\\\\t  deletion. Calls whose arguments change this metadata observe the\\\\nsrc/cljc/yang/clojure.cljc:1110:                            (u/v 'dsg__call_token))\\\\nsrc/cljc/yang/clojure.cljc:1125:                          (u/v 'dsg__call_token))\\\\nsrc/cljc/yang/clojure.cljc:1323:                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\\\\nsrc/cljc/yang/clojure.cljc:1347:                                (u/v 'dsg__call_token))\\\\nsrc/cljc/yang/clojure.cljc:1362:                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\\\\nsrc/cljc/yang/clojure.cljc:1387:                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\\\\nsrc/cljc/yang/clojure.cljc:1395:                                         (u/v 'dsg__call_token))\\\\nsrc/cljc/yang/clojure.cljc:2341:                                                       'dsg__call_token\\\\nsrc/cljc/yang/clojure.cljc:2353:                                  (if (data/callable? dsg__call_token)\\\\nsrc/cljc/yang/clojure.cljc:2361:         (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:17:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_7\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba src/cljc/yang/clojure.cljc | sed -n '2170,2395p'; nl -ba test/yang/call/conformance.clj | sed -n '1,175p;235,270p'; rg --files test/yang/call; rg -n 'identity|store|higher|return|callback|bag|cell-ref|descriptor' test/yang/call/*\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"  2170\\\\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\\\\n  2171\\\\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\\\\n  2172\\\\t   with :macro? true on the lambda; the encoder turns that flag into a\\\\n  2173\\\\t   declaration row and the expander, not this compiler, recognizes calls.\\\\n  2174\\\\t   The three-argument form takes `opts` opting into the argument-vector\\\\n  2175\\\\t   convention (see `program-env`); without it the output is the native one.\\\\\\\"\\\\n  2176\\\\t  ([forms] (compile-program forms true))\\\\n  2177\\\\t  ([forms tail?] (compile-program forms tail? nil))\\\\n  2178\\\\t  ([forms tail? opts]\\\\n  2179\\\\t   (run! check-program-symbols! forms)\\\\n  2180\\\\t   (let [env (program-env forms opts)]\\\\n  2181\\\\t     ;; A discarded definition must not become a lexical binding in the\\\\n  2182\\\\t     ;; following definitions. Descriptor entry and body closures both capture\\\\n  2183\\\\t     ;; their environment: retaining the previous descriptor here doubles its\\\\n  2184\\\\t     ;; paths at each definition during machine-data validation and UCF lift.\\\\n  2185\\\\t     (letfn [(discard-result\\\\n  2186\\\\t               [ast]\\\\n  2187\\\\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\\\\n  2188\\\\t             (go\\\\n  2189\\\\t               [forms macro-env]\\\\n  2190\\\\t               (if (empty? forms)\\\\n  2191\\\\t                 (compile-literal nil tail?)\\\\n  2192\\\\t                 (let [head       (cond->> (first forms)\\\\n  2193\\\\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\\\\n  2194\\\\t                                    (outcomes? env) (lower-top-form env macro-env))\\\\n  2195\\\\t                       rest-forms (rest forms)]\\\\n  2196\\\\t                   (cond\\\\n  2197\\\\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\\\\n  2198\\\\t                     ;; lambda the encoder declares; later forms see the name\\\\n  2199\\\\t                     ;; only so the native defn lowering can yield to it.\\\\n  2200\\\\t                     (and (seq? head) (= 'defmacro (first head)))\\\\n  2201\\\\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\\\\n  2202\\\\t                       (cond-> {:type     :application\\\\n  2203\\\\t                                :operator {:type :lambda, :params ['_]\\\\n  2204\\\\t                                           :body (go rest-forms\\\\n  2205\\\\t                                                     (assoc macro-env\\\\n  2206\\\\t                                                            (strip-symbol-meta (second head))\\\\n  2207\\\\t                                                            {:type :user}))}\\\\n  2208\\\\t                                :operands [(discard-result defined)]}\\\\n  2209\\\\t                         tail? (assoc :tail? true)))\\\\n  2210\\\\t                     ;; def: sequence with current macro-env\\\\n  2211\\\\t                     (and (seq? head) (= 'def (first head)))\\\\n  2212\\\\t                     (let [[_ name value] head\\\\n  2213\\\\t                           value (cond-> value (outcomes? env) rewrite-ex-info)]\\\\n  2214\\\\t                       (when (and (outcomes? env)\\\\n  2215\\\\t                                  (failing? (assoc env ::macro-env macro-env) value))\\\\n  2216\\\\t                         (reject! \\\\\\\"A def value cannot call guest functions under the outcome model\\\\\\\"\\\\n  2217\\\\t                                  {:name name}))\\\\n  2218\\\\t                       (cond-> {:type     :application\\\\n  2219\\\\t                                :operator {:type :lambda, :params ['_]\\\\n  2220\\\\t                                           :body (go rest-forms macro-env)}\\\\n  2221\\\\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\\\\n  2222\\\\t                         tail? (assoc :tail? true)))\\\\n  2223\\\\t                     ;; single form\\\\n  2224\\\\t                     (= 1 (count forms))\\\\n  2225\\\\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\\\\n  2226\\\\t                     ;; sequence\\\\n  2227\\\\t                     :else\\\\n  2228\\\\t                     (cond-> {:type     :application\\\\n  2229\\\\t                              :operator {:type :lambda, :params ['_]\\\\n  2230\\\\t                                         :body (go rest-forms macro-env)}\\\\n  2231\\\\t                              :operands [(discard-result\\\\n  2232\\\\t                                           (compile-form head false\\\\n  2233\\\\t                                                         (assoc env ::top-level true) macro-env))]}\\\\n  2234\\\\t                       tail? (assoc :tail? true))))))]\\\\n  2235\\\\t       (cond->> (go forms initial-macro-env)\\\\n  2236\\\\t         ;; The two sibling closures share one frame: separate bindings would\\\\n  2237\\\\t         ;; retain one extra helper environment in every closure a guest\\\\n  2238\\\\t         ;; captures (the machine-data validation bound notices).\\\\n  2239\\\\t         (outcomes? env) (#(u/app\\\\n  2240\\\\t                             (u/lam '[dsg__admitted? dsg__intra_call] %)\\\\n  2241\\\\t                             (u/sexp->uast\\\\n  2242\\\\t                               '(fn [dsg__candidate]\\\\n  2243\\\\t                                  (if (data/map? dsg__candidate)\\\\n  2244\\\\t                                    ;; A map is offered to the dereference\\\\n  2245\\\\t                                    ;; only when it could be a reference\\\\n  2246\\\\t                                    ;; the VM issued, as the descriptor\\\\n  2247\\\\t                                    ;; projection treats a cell-backed\\\\n  2248\\\\t                                    ;; callable (yang.antlr.md 8.10.2),\\\\n  2249\\\\t                                    ;; whose entry lives in the cell\\\\n  2250\\\\t                                    ;; contents: the issued format\\\\n  2251\\\\t                                    ;; (`:type :cell-ref`, `:id`, `:seal`,\\\\n  2252\\\\t                                    ;; no other entries, a 64-character\\\\n  2253\\\\t                                    ;; string seal) AND an `:id` in the\\\\n  2254\\\\t                                    ;; engine's heap id language — every\\\\n  2255\\\\t                                    ;; cell id is a `:cell-N` keyword, so\\\\n  2256\\\\t                                    ;; any other `:id` names no cell the\\\\n  2257\\\\t                                    ;; task could have minted and the map\\\\n  2258\\\\t                                    ;; is data. Data falls to the witness\\\\n  2259\\\\t                                    ;; branch and, entryless, is no more\\\\n  2260\\\\t                                    ;; admitted than any other source map,\\\\n  2261\\\\t                                    ;; so its invocation stays ordinary\\\\n  2262\\\\t                                    ;; map data. A candidate that passes\\\\n  2263\\\\t                                    ;; with a wrong seal is a capability\\\\n  2264\\\\t                                    ;; counterfeit: `cell/get` fails\\\\n  2265\\\\t                                    ;; closed in the VM and grants\\\\n  2266\\\\t                                    ;; nothing — authenticity is the VM's\\\\n  2267\\\\t                                    ;; heap+seal check, never a shape.\\\\n  2268\\\\t                                    (let [dsg__cell-ref?\\\