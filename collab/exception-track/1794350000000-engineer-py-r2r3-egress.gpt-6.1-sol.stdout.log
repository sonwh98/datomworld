     r))\\n   351\\t          (%capture))))]\\n   352\\t    [py/type-of\\n   353\\t     (fn [x] (if (= (py/content-type x) :instance) (get (cell/get x) :class) :py/None))]\\n   354\\t    [py/with\\n   355\\t     ;; the language reference's expansion: __exit__ is looked up before\\n   356\\t     ;; __enter__ runs; an exception calls __exit__(type, value, None) and\\n   357\\t     ;; is suppressed when that is truthy; every other exit calls\\n   358\\t     ;; __exit__(None, None, None)\\n   359\\t     ;; Both dunders are looked up on the manager's type, as implicit\\n   360\\t     ;; invocations are; an instance attribute of that name is not used.\\n   361\\t     (fn [mgr suite]\\n   362\\t       (let [cls (py/type-of mgr)\\n   363\\t             enter-fn (if (= cls :py/None) :py/missing (py/class-lookup cls \\\"__enter__\\\"))\\n   214\\t    [php/try\\n   215\\t     (fn [body handler orelse]\\n   216\\t       (let [saved (cell/get php.rt/ctx)\\n   217\\t             flag (cell/new :first)]\\n   218\\t         ((fn [r]\\n   219\\t            (if (= (cell/get flag) :first)\\n   220\\t              (do (cell/set! flag :re-entered)\\n   221\\t                  (php/set-handlers! (php/frame :handler r (get saved :handlers)))\\n   222\\t                  (body)\\n   223\\t                  (php/restore! saved)\\n   224\\t                  (orelse))\\n   225\\t              (do (php/restore! saved)\\n   226\\t                  (handler r))))\\n   227\\t          (%capture))))]\\n   228\\t    [php/try-finally\\n   229\\t     ;; normal exit runs `fin` here; raise and escapes run it as they\\n   230\\t     ;; unwind through the :finally frame\\n   231\\t     (fn [body fin]\\n   232\\t       (let [saved (cell/get php.rt/ctx)]\\n   233\\t         (do (php/set-handlers! (php/frame :finally fin (get saved :handlers)))\\n   234\\t             (let [v (body)]\\n   235\\t               (do (php/restore! saved)\\n   236\\t                   (fin :php/null)\\n   237\\t                 