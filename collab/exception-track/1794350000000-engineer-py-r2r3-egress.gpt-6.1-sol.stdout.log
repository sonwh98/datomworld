                                  (u/lit :yang.call/entry)\\\\n  2117\\\\t                                           (u/lam ['invocation] (u/lit :called))))\\\\n  2118\\\\t                             lane))\\\\n  2119\\\\t          (str lane \\\\\\\" genuine live\\\\\\\"))))\\\\n  2120\\\\t  (testing \\\\\\\"a genuine-but-dead reference keeps the standing refusal\\\\\\\"\\\\n  2121\\\\t    ;; A genuine cell whose contents carry no call entry: admission answers\\\\n  2122\\\\t    ;; false and the call refuses as not-callable — the behavior the D2 bar\\\\n  2123\\\\t    ;; pins, unchanged by the data fallback.\\\\n  2124\\\\t    (doseq [lane [:walker :semantic]]\\\\n  2125\\\\t      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\\\\n  2126\\\\t                                                     lane)]\\\\n  2127\\\\t        (is (and (= :yin.k/error tag)\\\\n  2128\\\\t                 (= :yang.call/not-callable (:yang.call/reason payload)))\\\\n  2129\\\\t            (str lane \\\\\\\" genuine dead: \\\\\\\" (pr-str result))))))\\\\n  2130\\\\t  (testing \\\\\\\"the residual, pinned: a forged id inside the heap language fails closed in the VM\\\\\\\"\\\\n  2131\\\\t    ;; A map whose :id is a :cell-N keyword and whose seal has the issued\\\\n  2132\\\\t    ;; format but not the issued content: it is a dereference candidate the\\\\n  2133\\\\t    ;; VM's heap+seal check rejects — a host-level refusal, the same fate\\\\n  2134\\\\t    ;; any forged reference meets anywhere in the system. No in-language\\\\n  2135\\\\t    ;; authenticity probe exists (check-ref! throws past every guest catch),\\\\n  2136\\\\t    ;; so this class stays fail-closed until yin.vm publishes one.\\\\n  2137\\\\t    (doseq [lane [:walker :semantic]]\\\\n  2138\\\\t      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\\\\n  2139\\\\t             (run-cell-probe (u/lit {:type :cell-ref :id :cell-7\\\\n  2140\\\\t                        