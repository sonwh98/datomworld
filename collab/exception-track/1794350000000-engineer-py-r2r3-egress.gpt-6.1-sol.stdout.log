? x)\nsrc/cljc/yang/python/antlr/prelude.cljc:2562:           (if (py/cell? x)\n   {:id :suspension-and-recursion :gates #{::r1 ::r2}\n    :frontends frontends :execution :pending-frontend-rounds}\n   {:id :host-vm-publication-parity :gates #{::r1 ::r2 ::r3 ::r5}\n    :frontends frontends :execution :pending-frontend-rounds\n    :cases #{:node :dart :bundled :task-isolation :custody-refusals}}\n   {:id :methods-and-callable-objects :gates #{::r1 ::r2 ::r3}\n    :frontends frontends :execution :pending-frontend-rounds}\n   {:id :foreign-formatting-and-class-name-forgery :gates #{::r2 ::r5}\n    :frontends #{:python :php} :execution :pending-frontend-rounds}])\n\n\n(defn ledger-seed\n  \"Derive obligations per frontend; no hand-maintained claim of acceptance.\"\n  []\n  (into (sorted-map)\n        (for [f (sort frontends)]\n          [f (into #{} (mapcat :gates)\n                   (filter #(contains? (:frontends %) f)\n                           (concat fixtures pair-matrix pending-obligations)))])))\n\n\n(defn open-gates\n  \"Given `{fixture-or-leg-id :green/:red/:pending}`, derive remaining gates\n   per frontend. Unreported/pending obligations stay open. A green scalar\n   observation cannot close a broader portability or lifetime obligation.\"\n  [statuses]\n  (into (sorted-map)\n        (for [f (sort frontends)]\n          [f (into #{} (mapcat :gates)\n                   (filter #(and (contains? (:frontends %) f)\n                                 (not= :green (get statuses (:id %) :pending)))\n                           (concat fixtures pair-matrix pending-obligations)))])))\n(ns yang.python.antlr.source-call-test\n  \"S11's first real-source conformance legs for Python (§8.10.11).\n   Each side is parsed and lowered by its frontend profile. The shared\n   conformance composition publishes exports and projects them by name.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.call.conformance :as conformance]))\n\n\n(deftest python-donor-to-typescript-source-test\n  (testing \"a Python module export is called by unmodified TypeScript source\"\n    (is (= {:js/out [\"22n\"], :js/uncaught nil}\n           (conformance/call\n             [:python (str \"def py_apply(f):\\n\"\n                           \"    global stored\\n\"\n                           \"    stored = f\\n\"\n                           \"    return f(20) + 1 if stored is f else -1\")]\n             [\"py_apply\"]\n             [:typescript \"console.log(py_apply(x => x + 1n));\"])))))\n\n\n(deftest typescript-donor-to-python-source-test\n  (testing \"a TypeScript module export is called by unmodified Python source\"\n    (is (= {:py/out [\"22\"], :py/exception nil}\n           (conformance/call\n             [:typescript (str \"globalThis.ts_apply = f => { globalThis.stored = f; \"\n                               \"return stored === f ? f(20n) + 1n : -1n; }\")]\n             [\"ts_apply\"]\n             [:python \"print(ts_apply(lambda x: x + 1))\\n\"])))))\n\n\n(deftest typescript-callback-through-python-source-test\n  (testing \"Python receives and calls the captured foreign function unchanged\"\n    (is (= {:py/out [\"(True, 21)\"], :py/exception nil}\n           (conformance/call\n             [:typescript (str \"const captured = 1n; \"\n                               \"globalThis.foreign = x => x + captured;\")]\n             [\"foreign\"]\n             [:python (str \"def invoke(f):\\n\"\n                           \"    stored = f\\n\"\n                           \"    return stored is f, f(20)\\n\"\n                           \"print(invoke(foreign))\\n\")])))))\n\n\n(deftest typescript-opaque-values-through-python-source-test\n  (testing \"Python returns foreign values unchanged through its source body\"\n    (is (= {:py/out [\"True True True True True\"], :py/exception nil}\n           (conformance/call\n             [:typescript (str \"globalThis.opaque = {answer: 42};\\n\"\n                               \"globalThis.foreign = x => x;\\n\"\n                               \"globalThis.foreignText = 'unchanged';\\n\"\n                               \"globalThis.foreignFloat = 1.25;\\n\"\n                               \"globalThis.foreignInteger = 9007199254740993123456789n;\")]\n             [\"opaque\" \"foreign\" \"foreignText\" \"foreignFloat\" \"foreignInteger\"]\n             [:python (str \"def echo(value):\\n    return value\\n\"\n                           \"print(echo(opaque) is opaque, echo(foreign) is foreign, \"\n                           \"echo(foreignText) is foreignText, \"\n                           \"echo(foreignFloat) is foreignFloat, \"\n                           \"echo(foreignInteger) is foreignInteger)\\n\")])))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"tail -4 /tmp/exception-py-g0.log; rg '\"'^PROVENANCE|''^EXCEPTION-PAIR|''^Ran |''^.*failures,.*errors'\"' /tmp/exception-py-g0.log | cut -c1-220 | tail -20; sed -n '1,155p' test/yang/call/exception_contract.clj; sed -n '1,160p' test/yang/call/exception_legs.clj; sed -n '1690,1770p' src/cljc/yang/python/antlr/prelude.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"tail -4 /tmp/exception-py-g0.log; rg '\"'^PROVENANCE|''^EXCEPTION-PAIR|''^Ran |''^.*failures,.*errors'\"' /tmp/exception-py-g0.log | cut -c1-220 | tail -20; sed -n '1,155p' test/yang/call/exception_contract.clj; sed -n '1,160p' test/yang/call/exception_legs.clj; sed -n '1690,1770p' src/cljc/yang/python/antlr/prelude.cljc\"","aggregated_output":"Running tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.call.exception-contract-test\n(ns yang.call.exception-contract\n  \"Round 0's executable §8.10.7 provenance contract. Source strings are\n   parsed by the JVM kit, never patched after lowering. Boundary probes\n   alone may manufacture invocations that valid source cannot express.\n   `fixtures` is the acceptance-ledger input; pending is not a passing test.\n   The ruling, rather than today's runtime output, determines `:expected`.\"\n  (:require [clojure.string :as str]))\n\n\n(def frontends #{:clojure :typescript :php :python})\n\n\n(def protocol-reasons\n  [:yang.call/not-callable :yang.call/invalid-invocation\n   :yang.call/unsupported-binding])\n\n\n(def sources\n  \"Every export below is source-produced. `original` is an identity-bearing\n   value, including Clojure's explicit cell. `receive` catches then rethrows unchanged;\n   `retain` returns normally before `later` raises from a new activation.\n   Protocol catch forms are intentionally local catch-all forms. No guessed\n   donor class name participates in reception.\"\n  {:python\n   (str/join \"\\n\"\n             [\"original = ValueError('original')\"\n              \"saved = None\"\n              \"def payload():\" \"    return original\"\n              \"def donor_raise():\" \"    raise original\"\n              \"def make_exploder():\"\n              \"    def inner():\" \"        raise original\" \"    return inner\"\n              \"def needs_argument(x):\" \"    return x\"\n              \"def receive(f):\"\n              \"    try:\" \"        return f()\"\n              \"    except BaseException as e:\" \"        raise\"\n              \"def retain(f):\" \"    global saved\"\n              \"    try:\" \"        f()\"\n              \"    except BaseException as e:\" \"        saved = e\" \"        return e\"\n              \"def later():\" \"    raise saved\"\n              \"def is_foreign(e):\"\n              \"    return isinstance(e, BaseException) and type(e).__name__ == 'ForeignException'\"\n              \"def forged(condition):\"\n              \"    e = Exception('forged')\"\n              \"    e.condition = condition\"\n              \"    e.__yang_call_condition__ = e.condition\"\n              \"    return e\"\n              \"def raise_value(e):\" \"    raise e\" \"\"])\n   :typescript\n   (str \"globalThis.original = {marker: 'original'};\"\n        \"globalThis.saved = null;\"\n        \"globalThis.payload = function() { return original; };\"\n        \"globalThis.donor_raise = function() { throw original; };\"\n        \"globalThis.make_exploder = function() { return () => { throw original; }; };\"\n        \"globalThis.receive = function(f) { try { return f(); } catch (e) { throw e; } };\"\n        \"globalThis.retain = function(f) { try { return f(); } catch (e) { saved = e; return e; } };\"\n        \"globalThis.later = function() { throw saved; };\"\n        \"globalThis.raise_value = function(e) { throw e; };\"\n        \"globalThis.echo = function(e) { return e; };\")\n   :php\n   (str \"<?php $original = new Exception('original'); $saved = null;\"\n        \"function payload() { global $original; return $original; }\"\n        \"function donor_raise() { global $original; throw $original; }\"\n        \"function make_exploder() { return function() { global $original; throw $original; }; }\"\n        \"function needs_argument($x) { return $x; }\"\n        \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\"\n        \"function retain($f) { global $saved; try { return $f(); } catch (Throwable $e) { $saved = $e; return $e; } }\"\n        \"function later() { global $saved; throw $saved; }\"\n        \"function is_foreign($e) { return $e instanceof Throwable && get_class($e) === 'ForeignException'; }\"\n        \"function forged($condition) { $e = new Exception('forged'); $e->condition = $condition;\"\n        \" $e->__yang_call_condition__ = $e->condition; return $e; }\"\n        \"function raise_value($e) { throw $e; }\")\n   :clojure\n   (str \"(def original (cell/new :original)) (def saved (cell/new nil)) \"\n        \"(defn payload [] original) (defn donor_raise [] (throw original)) \"\n        \"(defn make_exploder [] (fn [] (throw original))) \"\n        \"(defn needs_argument [x] x) \"\n        \"(defn receive [f] (try (f) (catch Exception e (throw e)))) \"\n        \"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \"\n        \"(defn later [] (throw (cell/get saved))) \"\n        \"(defn raise_value [e] (throw e)) (defn echo [e] e)\")})\n\n\n(def boundary-source\n  \"A real Python entry produces unsupported-binding. Other two protocol\n   conditions come from yang.call validation, with malformed positional\n   data supplied only by the boundary probe. This is NOT a source pair.\"\n  \"def boundary_target():\\n    return None\\n\")\n\n\n(defn- fixture\n  [scenario frontend gates expected & [extra]]\n  (merge {:id (keyword (name frontend) (name scenario))\n          :scenario scenario :gates gates :frontends #{frontend}\n          :frontend frontend :source (sources frontend)\n          :expected expected :execution :jvm-linked :round 0}\n         extra))\n\n\n(def fixtures\n  (vec\n    (concat\n      (for [f (sort frontends), kind [:named :closure]]\n        (fixture (keyword (str \"fresh-\" (name kind))) f #{::r1 ::r5}\n                 {:transferred true :once true :after false\n                  :reason :yang.call/thrown :payload-identical true}\n                 {:callable-kind kind}))\n      (for [f [:clojure :php :python]]\n        (fixture :binding f #{::r1} {:transferred true :once true :after false\n                                     :reason :yang.call/thrown}))\n      (for [f (sort frontends), reason protocol-reasons]\n        (fixture (keyword (str \"protocol-\" (name reason))) f #{::r3}\n                 {:transferred true :once true :after false\n                  :condition-identical true :reason reason}\n                 {:protocol-reason reason}))\n      (for [f [:python :php]]\n        (fixture :local-reception f #{::r2}\n                 {:returned true :payload-identical true}))\n      (for [f [:python :php]]\n        (fixture :foreign-reception f #{::r2}\n                 {:returned true :local-foreign-exception true}))\n      (for [f [:python :php]]\n        (fixture :retained-foreign-lifetime f #{::r2 ::r5}\n                 {:retained true :local-foreign-exception true\n                  :transferred true :once true :after false\n                  :condition-identical true :payload-identical true}))\n      (for [f (sort frontends), reason protocol-reasons]\n        (fixture (keyword (str \"saved-protocol-\" (name reason))) f #{::r3 ::r5}\n                 {:retained true :transferred true :once true :after false\n                  :condition-identical true :reason reason}\n                 {:protocol-reason reason}))\n      (for [f [:clojure :typescript], scenario [:shape-return :shape-throw]]\n        (fixture scenario f #{::r5}\n                 (if (= scenario :shape-return)\n                   {:returned true :payload-identical true}\n                   {:transferred true :once true :after false\n                    :reason :yang.call/thrown :payload-identical true})))\n      (for [f [:python :php]]\n        (fixture :forged-retention f #{::r5}\n                 {:transferred true :once true :after false\n                  :reason :yang.call/thrown :payload-identical true})))))\n\n\n(def pair-scenarios\n  \"Source-pair obligations. Python directions run in Round 0; the other\n   six directions are authored by the same generators but explicitly await\n   their frontend rounds. R4's private/public equivalence is a separate\n   obligation, never inferred from a green pair.\"\n  {:catch-all #{::r1 ::r2}\n   :typed-catch #{::r1 ::r2}\n   :unchanged-rethrow #{::r1 ::r2}\n   :binding #{::r1}\n   :finally-replacement #{::r1 ::r2}\n   :retained-lifetime #{::r1 ::r2}\n   :round-trip #{::r1 ::r2}\n   :success-raise-success #{::r1 ::r2}})\n(ns yang.call.exception-legs\n  \"Real-source directed exception legs. All twelve directions share these\n   source generators; no language-pair runtime wrapper or call-node rewrite.\n   Python-containing directions run on JVM in R0. The remaining directions\n   are authored but pending their rounds (exception-contract/pair-matrix).\"\n  (:require [clojure.string :as str]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]))\n\n\n(defn- define\n  [frontend name params body]\n  (case frontend\n    :python (str \"def \" name \"(\" (str/join \", \" params) \"):\\n\"\n                 (str/join \"\\n\" (map #(str \"    \" %) (str/split-lines body))) \"\\n\")\n    :typescript (str \"globalThis.\" name \" = function(\" (str/join \", \" params)\n                     \") { \" body \" };\\n\")\n    :php (str \"function \" name \"(\" (str/join \", \" (map #(str \"$\" %) params))\n              \") { \" body \" }\\n\")\n    :clojure (str \"(defn \" name \" [\" (str/join \" \" params) \"] \" body \")\\n\")))\n\n\n(defn donor-exports\n  \"Only exports the donor actually defines. JS's absent required-argument\n   helper is never read/projected: that source capability has no binding row.\"\n  [frontend]\n  (cond-> [\"donor_raise\" \"payload\" \"success\"]\n    (not= frontend :typescript) (conj \"needs_argument\")))\n\n\n(defn donor-source\n  [frontend]\n  (str (contract/sources frontend)\n       (define frontend \"success\" []\n         (case frontend :python \"return True\" :clojure \"true\" \"return true;\"))\n       (define frontend \"home\" [\"f\" \"done\"]\n         (case frontend\n           :python (str \"try:\\n    f()\\nexcept ValueError as e:\\n\"\n                        \"    return e is original and done()\\nreturn False\")\n           :typescript (str \"try { f(); } catch(e) { return e === original && done(); }\"\n                            \" return false;\")\n           :php (str \"global $original; try { $f(); } catch(Exception $e) {\"\n                     \" return $e === $original && $done(); } return false;\")\n           :clojure \"(try (f) false (catch Exception e (and (= e original) (done))))\"))))\n\n\n(def catch-all-body\n  {:python \"try:\\n    donor_raise()\\nexcept:\\n    return True\\nreturn False\"\n   :typescript \"try { donor_raise(); } catch(e) { return true; } return false;\"\n   :php \"try { donor_raise(); } catch(Throwable $e) { return true; } return false;\"\n   :clojure \"(try (donor_raise) false (catch Exception e true))\"})\n\n\n(defn caller-source\n  [frontend scenario]\n  (let [header (case frontend :php \"<?php \" \"\")\n        probe #(define frontend \"probe\" [] %)\n        ;; `done` checks exactly-once cleanup, before the home runtime\n        ;; recognizes its original exception again. Clojure uses its\n        ;; admitted catch surface, and does not acquire finally syntax.\n        counter (case frontend\n                  :python \"cleaned = 0\\n\"\n                  :typescript \"globalThis.cleaned = 0;\\n\"\n                  :php \"$cleaned = 0;\\n\"\n                  :clojure \"(def cleaned (cell/new 0))\\n\")\n        done (define frontend \"done\" []\n               (case frontend\n                 :python \"return cleaned == 1\"\n                 :typescript \"return cleaned === 1;\"\n                 :php \"global $cleaned; return $cleaned === 1;\"\n                 :clojure \"(= (cell/get cleaned) 1)\"))]\n    (str header\n         (case scenario\n           :catch-all (probe (catch-all-body frontend))\n           :typed-catch\n           (probe (case frontend\n                    :python (str \"try:\\n    donor_raise()\\nexcept BaseException as e:\\n\"\n                                 \"    return type(e).__name__ == 'ForeignException'\\nreturn False\")\n                    :php \"try { donor_raise(); } catch(ForeignException $e) { return true; } return false;\"\n                    ;; JS has no typed syntax; Clojure admits exactly this\n                    ;; restricted catch. Neither row claims class matching.\n                    (catch-all-body frontend)))\n           :unchanged-rethrow\n           (str (case frontend :python \"caught = 0\\n\"\n                      :typescript \"globalThis.caught = 0;\\n\"\n                      :php \"$caught = 0;\\n\"\n                      :clojure \"(def caught (cell/new 0))\\n\")\n                (define frontend \"caught_once\" []\n                  (case frontend :python \"return caught == 1\"\n                        :typescript \"return caught === 1;\"\n                        :php \"global $caught; return $caught === 1;\"\n                        :clojure \"(= (cell/get caught) 1)\"))\n                (probe (case frontend\n                         :python \"global caught\\ntry:\\n    donor_raise()\\nexcept BaseException:\\n    caught += 1\\n    raise\"\n                         :typescript \"try { donor_raise(); } catch(e) { caught += 1; throw e; }\"\n                         :php \"global $caught; try { donor_raise(); } catch(Throwable $e) { $caught += 1; throw $e; }\"\n                         :clojure \"(try (donor_raise) (catch Exception e (cell/set! caught (+ (cell/get caught) 1)) (throw e)))\")))\n           :binding (probe (str/replace (catch-all-body frontend) \"donor_raise\" \"needs_argument\"))\n           :success-raise-success\n           (probe (case frontend\n                    :python (str \"if not success():\\n    return False\\n\"\n                                 \"try:\\n    donor_raise()\\nexcept:\\n    return success()\\nreturn False\")\n                    :typescript \"if (!success()) return false; try { donor_raise(); } catch(e) { return success(); } return false;\"\n                    :php \"if (!success()) return false; try { donor_raise(); } catch(Throwable $e) { return success(); } return false;\"\n                    :clojure \"(and (success) (try (donor_raise) false (catch Exception e (success))))\"))\n           :finally-replacement\n           (do\n             (when (= frontend :clojure)\n               (throw (ex-info \"Clojure finally remains an explicit source refusal\"\n                               {:frontend frontend :scenario scenario})))\n             (str\n               (case frontend\n                 :python \"replacement = ValueError('replacement')\\n\"\n                 :typescript \"globalThis.replacement = {marker: 'replacement'};\\n\"\n                 :php \"$replacement = new Exception('replacement');\\n\")\n               (define frontend \"replacement_payload\" []\n                 (case frontend :python \"return replacement\"\n                       :typescript \"return replacement;\"\n                       :php \"global $replacement; return $replacement;\"))\n               (probe (case frontend\n                        :python \"try:\\n    donor_raise()\\nfinally:\\n    raise replacement\"\n                        :typescript \"try { donor_raise(); } finally { throw replacement; }\"\n                        :php \"global $replacement; try { donor_raise(); } finally { throw $replacement; }\"))))\n           :retained-lifetime\n           (str\n             (case frontend :python \"saved = None\\n\" :typescript \"globalThis.saved = null;\\n\"\n                   :php \"$saved = null;\\n\" :clojure \"(def saved (cell/new nil))\\n\")\n             (define frontend \"save_foreign\" []\n               (case frontend\n                 :python \"global saved\\ntry:\\n    donor_raise()\\nexcept BaseException as e:\\n    saved = e\\n    return e\"\n                 :typescript \"try { donor_raise(); } catch(e) { saved = e; return e; }\"\n                 :php \"global $saved; try { donor_raise(); } catch(Throwable $e) { $saved = $e; return $e; }\"\n                 :clojure \"(try (donor_raise) (catch Exception e (cell/set! saved e) e))\"))\n             (define frontend \"saved_local\" []\n               (case frontend\n                 :python \"return isinstance(saved, BaseException) and type(saved).__name__ == 'ForeignException'\"\n                 :php \"global $saved; return $saved instanceof Throwable && get_class($saved) === 'ForeignException';\"\n                 :typescript \"return true;\" :clojure \"true\"))\n             (probe (case frontend :python \"raise saved\" :typescript \"throw saved;\"\n                          :php \"global $saved; throw $saved;\" :clojure \"(throw (cell/get saved))\")))\n           :round-trip\n           (str counter done\n                (probe (case frontend\n                         :python \"global cleaned\\ntry:\\n    donor_raise()\\nfinally:\\n    cleaned += 1\"\n                         :typescript \"try { donor_raise(); } finally { cleaned += 1; }\"\n                         :php \"global $cleaned; try { donor_raise(); } finally { $cleaned += 1; }\"\n                         :clojure \"(try (donor_raise) (catch Exception e (cell/set! cleaned (+ (cell/get cleaned) 1)) (throw e)))\")))))))\n\n\n(defn- call\n  [frontend export args]\n  (kit/boundary-call-form (kit/export-form frontend export)\n                          (kit/observation-vector-form args) []))\n\n\n(defn observation-form\n  [{:keys [donor caller scenario probe-export]}]\n  (let [result 'leg.result\n        original 'leg.original\n        transfer {:transferred (list '= :raise (list 'get result :route))\n     (fn [r x]\n       (let [start (get r :start)\n             stop (get r :stop)\n             step (get r :step)]\n         (if (if (< (integer/compare 0 step) 0)\n               (if (<= (integer/compare start x) 0)\n                 (< (integer/compare x stop) 0) false)\n               (if (< (integer/compare stop x) 0)\n                 (<= (integer/compare x start) 0) false))\n           (= (get (py/int-result (integer/floor-div-mod x step)) 1)\n              (get (py/int-result (integer/floor-div-mod start step)) 1))\n           false)))]\n    [py/in (fn [x c] (py/contains c x))]\n    [py/not-in (fn [x c] (not (py/contains c x)))]\n    [py/eq-items\n     (fn [xs ys i]\n       (let [x (get xs i :py/stop)\n             y (get ys i :py/stop)]\n         (if (= x :py/stop)\n           (= y :py/stop)\n           (if (= y :py/stop)\n             false\n             (if (py/same? x y) (py/eq-items xs ys (+ i 1)) false)))))]\n    [py/ne (fn [a b] (not (py/eq a b)))]\n    ;; `is` is content identity for every non-cell value (C3 ruling 8,\n    ;; yang.antlr.md 8.5.4): equal integers are `is`-equal at any\n    ;; magnitude, every NaN is one value, 0.0 is not -0.0, True is not 1;\n    ;; a cell is `is` only itself\n    [py/is (fn [a b] (data/content= a b))]\n    [py/is-not (fn [a b] (not (data/content= a b)))]\n\n    ;; ---------------------------------------------------------- truthiness\n    [py/truthy\n     (fn [x]\n       (if (= x false)\n         false\n         (if (= x true)\n           true\n           (if (= x :py/None)\n             false\n             (if (py/str? x)\n               (not (= x {:py/str \"\"}))\n               (if (py/cell? x)\n                 (py/obj-truthy (cell/get x))\n                 (if (= (get x :py/type) :tuple)\n                   (< 0 (data/count (get x :items)))\n                   (if (py/numeric? x) (not (py/zero? x)) true))))))))]\n    [py/obj-truthy\n     (fn [c]\n       (let [t (get c :py/type)]\n         (if (= t :list)\n           (< 0 (data/count (get c :items)))\n           (if (if (= t :dict) true (= t :set)) (< 0 (data/count (get c :keys))) true))))]\n    [py/lnot (fn [x] (if (py/truthy x) false true))]\n\n    ;; ---------------------------------------------------------- lists\n    [py/list\n     (fn [items]\n       (cell/new (assoc (assoc {} :py/type :list) :items items)))]\n    [py/list-append\n     (fn [l x]\n       (let [c (cell/get l)]\n         (do (cell/set! l (assoc c :items (conj (get c :items) x)))\n             :py/None)))]\n    [py/index\n     (fn [k n]\n       (if (py/int? k)\n         (let [i (py/num k)]\n           ;; Reject before addition, so even a huge negative index does\n           ;; not construct a value outside the integer resource budget.\n           (if (if (< (integer/compare i 0) 0)\n                 (< (integer/compare i (- 0 n)) 0)\n                 (>= (integer/compare i n) 0))\n             (py/raise-new py.b/IndexError\n                           {:py/str \"list index out of range\"})\n             (if (< (integer/compare i 0) 0)\n               (py/int-result (integer/add i n)) i)))\n         (py/type-error {:py/str \"list indices must be integers\"})))]\n\n    ;; ---------------------------------------------------------- exact numbers\n    ;; Version 3 has ten reasons. Numbers take the cheap first arm;\n","exit_code":0,"status":"completed"}}
