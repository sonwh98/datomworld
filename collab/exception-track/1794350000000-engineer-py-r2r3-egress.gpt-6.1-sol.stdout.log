ess store, throwing immediately\n+   with `result` in ex-data if publication is refused.\"\n+  [spec]\n+  (let [result (h/publish-guest-module! spec)]\n+    (when (= :refused (:status result))\n+      (throw (ex-info (str \"Guest module publication refused: \" (or (:reason result) (:status result)))\n+                      result)))\n+    result))\n+\n+\n (def ^:private published-php\n   \"`php` published once into `js`'s content store, pinning the same\n    `yang.call` revision (as `source-call-test` publishes it).\"\n-  (delay (h/publish-guest-module!\n+  (delay (publish-guest!\n            (php-prelude/module-spec (h/registry)\n                                     (:call-address @h/published)))))\n \n@@ -58,7 +69,7 @@\n (def ^:private published-py\n   \"`py` published beside `js` and `php`, over the same host registry and\n    `yang.call` revision.\"\n-  (delay (h/publish-guest-module!\n+  (delay (publish-guest!\n            (py-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n \n@@ -66,7 +77,7 @@\n (def ^:private published-clj\n   \"`clj` published beside `js`, `php` and `py`, over the same host registry\n    and `yang.call` revision.\"\n-  (delay (h/publish-guest-module!\n+  (delay (publish-guest!\n            (clj-prelude/module-spec (h/registry)\n                                     (:call-address @h/published)))))\n \n@@ -187,6 +198,12 @@\n   (clj-prelude/admit (php-prelude/admit (h/registry))))\n \n \n+(defn- claims-call-sites?\n+  \"True when map AST `ast` carries the C1 call-site key anywhere.\"\n+  [ast]\n+  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n+\n+\n (defn publish-donor!\n   \"Publish the donor `source` of `frontend` as the module `module` (default\n    `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\n@@ -196,17 +213,20 @@\n   ([frontend source module]\n    (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\n          [refusal-key reason] refusal\n+         ast (let [raw (core-module/module-tree\n+                         [(core-module/require-node runtime)\n+                          (u/def! 'body (unit (parse source) []))])]\n+               (cond-> raw\n+                 (claims-call-sites? raw) u/annotate-call-sites))\n          spec (core-module/module-spec\n                 refusal-key reason (modules)\n                 {:name module,\n-                 :ast (core-module/module-tree\n-                        [(core-module/require-node runtime)\n-                         (u/def! 'body (unit (parse source) []))]),\n+                 :ast ast,\n                  :exports '#{body},\n                  :runtime-name runtime,\n                  :runtime-address (address),\n                  :deps (if deps (deps) {})})\n-         result (h/publish-guest-module! spec)]\n+         result (publish-guest! spec)]\n      {:frontend frontend,\n       :module module,\n       :address (:address result),\n@@ -439,6 +459,12 @@\n       #(exception-outcome caller-frontend %))))\n \n \n+(defn error-results\n+  \"Map `e` across each vector VM backend as an operational failure.\"\n+  [e]\n+  (into (sorted-map) (map (fn [backend] [backend e]) (keys h/backends))))\n+\n+\n (defn run-exception-program\n   \"The exception probes' independent VM runs, concurrent on the JVM. Each\n    job owns its registry, task, link pair AND content-serving composition;\n@@ -447,17 +473,20 @@\n    clojure.test's :error reporting, NEVER relabelled as a guest condition.\n    All jobs settle even if one fails. `run-program` is unchanged.\"\n   [donor ast]\n-  ;; Resolve publication delays before starting independent readers.\n-  (link-source donor)\n-  (let [jobs (mapv (fn [backend]\n-                     [backend\n-                      (future\n-                        (try\n-                          (vm/value\n-                            (h/run-linked backend ast\n-                                          {:modules (modules)\n-                                           :link-source (link-source donor)}))\n-                          (catch Exception e e)))])\n-                   (keys h/backends))]\n-    (into (sorted-map)\n-          (map (fn [[backend job]] [backend @job])) jobs)))\n+  (try\n+    ;; Resolve publication delays before starting independent readers.\n+    (link-source donor)\n+    (let [jobs (mapv (fn [backend]\n+                       [backend\n+                        (future\n+                          (try\n+                            (vm/value\n+                              (h/run-linked backend ast\n+                                            {:modules (modules)\n+                                             :link-source (link-source donor)}))\n+                            (catch Exception e e)))])\n+                     (keys h/backends))]\n+      (into (sorted-map)\n+            (map (fn [[backend job]] [backend @job])) jobs))\n+    (catch Throwable e\n+      (error-results e))))\ncollab/exception-track/1794245000000-engineer-donor-link-absent-r2.prompt.md:45:   restored to their ledger rows (green/red as recorded, zero absent\ncollab/exception-track/1794245000000-engineer-donor-link-absent-r2.prompt.md:47:2. For the PHP provenance rows: their ledger state is `:error` with the\ncollab/exception-track/1794245000000-engineer-donor-link-absent-r2.prompt.md:52:   signature still matches the ledger's (whatever its text) or has drifted\ncollab/exception-track/1794245000000-engineer-donor-link-absent-r2.prompt.md:56:   the kit the same way. If it matches the ledger, say so and stop.\ncollab/exception-track/1794245000000-engineer-donor-link-absent-r2.prompt.md:59:   already-error-at-baseline rows whose state must EQUAL the ledger rather\ncollab/exception-track/1794245000000-engineer-donor-link-absent-r2.prompt.md:60:   than be green. Do not overclaim.\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:5:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat /Users/sto/workspace/datomworld/.agents/skills/code-review-pr/SKILL.md'\",\"aggregated_output\":\"---\\nname: code-review-pr\\ndescription: >-\\n  Performs comprehensive, high-quality code reviews on Git pull requests, branches, commit ranges, or local working tree diffs. Analyzes code correctness, security, architecture, test coverage, and performance using automated diff analysis and structured review checklists.\\n---\\n\\n# Code Review PR Skill\\n\\n## Overview\\n\\nThe `code-review-pr` skill provides an end-to-end framework for conducting rigorous, actionable code reviews on Git pull requests, feature branches, commit ranges, or working tree diffs. It combines automated diff scanning via `scripts/pr_reviewer.py` with structured review checklists across security, correctness, architecture, performance, and testing.\\n\\nUse this skill whenever asked to:\\n- Review a pull request or feature branch (`git diff main...HEAD`).\\n- Review recent commits (`git diff HEAD~1` or commit range).\\n- Review uncommitted local changes (`git diff` or staged changes).\\n- Perform a security, quality, or architecture audit of proposed code changes.\\n\\n---\\n\\n## Quick Start\\n\\nRun the automated PR reviewer script to generate an initial risk assessment, churn metrics, and automated smell scan:\\n\\n```bash\\n# 1. Review branch changes against main (Default PR review)\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target main...HEAD\\n\\n# 2. Review last commit\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target HEAD~1\\n\\n# 3. Review uncommitted working tree changes\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target working\\n\\n# 4. Save review report to file\\npython3 .agents/skills/code-review-pr/scripts/pr_reviewer.py analyze --target main...HEAD --output review_report.md\\n```\\n\\n---\\n\\n## Code Review Workflow\\n\\nFollow this step-by-step process when executing a code review:\\n\\n### Step 1: Run Automated Diff Analysis\\nExecute `scripts/pr_reviewer.py analyze` for the target Git ref/range. Review the output to determine:\\n- Total lines added/deleted and file churn distribution.\\n- High-risk modified files (e.g., Security/Auth, Database/Schema, Infrastructure, API Contracts).\\n- Test-to-source additions ratio.\\n- Automated static findings (hardcoded secrets, debug leftovers, swallowed exceptions, SQL injection risks).\\n\\n### Step 2: Deep-Dive Code Inspection\\nInspect the diffs for high-risk files using `git diff <target> -- <path>` or `view_file`. Focus on:\\n1. **Logic & Edge Cases**:\\n   - Boundary checks, null/nil handling, empty collections, zero division.\\n   - Resource leaks (unclosed streams, file handles, DB connections).\\n   - Race conditions, shared state mutation, concurrency locks.\\n2. **Security & Credentials**:\\n   - No hardcoded API keys, passwords, or tokens.\\n   - Input validation before execution or query interpolation.\\n   - Proper authorization checks on new or updated endpoints.\\n3. **Architecture & Contracts**:\\n   - Preserving backward compatibility on existing API functions/endpoints.\\n   - Proper module separation and clean interface boundaries.\\n4. **Test Coverage & Quality**:\\n   - Ensuring new source logic is accompanied by unit/integration tests.\\n   - Verifying tests validate actual assertions rather than just non-crashing execution.\\n\\n### Step 3: Reference Checklist & Severity Taxonomy\\nConsult [references/review_checklist.md](references/review_checklist.md) to classify findings:\\n- **P0 (Critical / Blocker)**: Security breaches, data loss risks, severe crashes, hardcoded credentials.\\n- **P1 (High / Must Address)**: Logic bugs, broken API contracts, swallowed exceptions, missing critical tests.\\n- **P2 (Medium / Recommended)**: Performance bottlenecks, code duplication, missing parameter validation.\\n- **P3 (Low / Suggestion)**: Minor formatting, naming improvements, leftover comments/TODOs.\\n\\n### Step 4: Formulate Structured Review Report\\nPresent findings to the user using the following template:\\n\\n```markdown\\n# 🔍 Code Review Report\\n\\n## Executive Summary\\n- **Target:** `<git-ref>`\\n- **Verdict:** `[ APPROVED | REQUEST CHANGES | COMMENT ]`\\n- **Overall Risk:** `[ LOW | MEDIUM | HIGH ]`\\n- **Metrics:** `X files changed, +Y / -Z lines`\\n\\n## 🚨 Critical Findings (P0 / P1)\\n- **[Severity]** `path/to/file.ext:L123` - Short issue description.\\n  ```diff\\n  - problematic code\\n  + suggested fix\\n  ```\\n\\n## 💡 Improvements & Suggestions (P2 / P3)\\n- **[Severity]** `path/to/file.ext` - Recommendation details.\\n\\n## 🧪 Test Coverage & Quality Assessment\\n- Evaluation of test ratio and edge case coverage.\\n\\n## 🌟 Positive Highlights\\n- Clean implementations, thorough documentation, or well-structured refactoring.\\n```\\n\\n---\\n\\n## Utility Script Reference\\n\\nThe bundled helper script `scripts/pr_reviewer.py` supports the following options:\\n\\n| Parameter | Type | Default | Description |\\n| :--- | :--- | :--- | :--- |\\n| `--target` | String | `main...HEAD` | Git range/ref (`main...HEAD`, `HEAD~1`, `staged`, `working`) |\\n| `--output` | String | None | File path to write report output |\\n| `--format` | String | `markdown` | Output format (`markdown` or `json`) |\\n| `--repo-dir` | String | Current Dir | Path to the target Git repository |\\n\\n---\\n\\n## Common Review Pitfalls\\n\\n1. **Nit Tunnel Vision**: Focusing heavily on formatting or naming while missing underlying logic bugs or edge-case crashes.\\n2. **Ignoring Test Ratio**: Approving large source code changes without verifying corresponding test coverage additions.\\n3. **Swallowing Symptoms**: Suggesting `try/except` wrappers around failing code rather than addressing root cause invalid inputs or broken state.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:9:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat docs/design/datom.world.md'\",\"aggregated_output\":\"---\\ndescription: Core philosophy, foundational axioms, invariants, primitives (tuples, streams, host boundaries), architectural commitments, design principles, code style, and development workflow for datom.world\\n---\\n\\n# DATOM.WORLD ARCHITECTURAL FOUNDATIONS & DEVELOPMENT RULES\\n\\n## Core Philosophy\\n\\nEverything is data.\\nInterpretation > abstraction.\\nExplicit causality > implicit assumptions.\\nRestrictions are a feature.\\n\\n### Foundational Axioms\\n\\n1. **Everything is a Stream**: Portable I/O and system data flow through append-only streams; hosts may also install explicit local functions that perform direct I/O.\\n2. **Interpretation Creates Semantics**: Data is syntax; semantics only emerge through interpretation (one truth, many perspectives).\\n   At system scale, a \\\"system\\\" is an emergent property of interpreters of\\n   pure data, not an object, service, or stored artifact. Find the\\n   interpreters and the data they share to find the system.\\n3. **Code and State are Datoms**: Code (Universal AST) and runtime execution state are structured datoms, enabling syntax independence and structural reflection.\\n4. **Everything is a Continuation**: Computation is modeled as serializable, portable continuations that can pause, travel across streams, and resume anywhere.\\n\\n## Non-Negotiable Invariants\\n\\n- Do not introduce hidden global state.\\n- Do not introduce implicit control flow.\\n- Do not introduce callbacks; every callback is an event on a stream.\\n- Do not introduce shared mutable state.\\n- Do not collapse interpretation and execution into the same layer.\\n- Do not assume graphs: graphs must be constructed explicitly from tuples.\\n- Do not lose information (unitarity): streams are append-only and no datom is destroyed, only reinterpreted. The Universal AST is never lost: it is always retrievable wherever code is lowered, by address or by a query over its datoms. Every derived form (semantic vector, native images, indexes) is an interpretation of it and may drop facts only because the AST remains.\\n\\n## Tuples and Datoms\\n\\nTuples are elements in an open moduli space, graded by dimension $n$. A tuple can be any dimension/size.\\nA datom is the canonical persistent tuple `[e a v t m]` (entity, attribute, value, transaction, metadata). Persistent facts are immutable datoms.\\nSource scope belongs to the interpreter, never to an appended tuple slot. Queries keep physical sources as separate db-values and express union or joins explicitly.\\n\\nSee [`docs/design/datom.md`](./datom.md) for full specification.\\n\\n## Streams\\n\\n`dao.stream` is an I/O monad and the system's portable I/O ABI. Functions consume streams and produce streams.\\nHosts may install arbitrary local functions, including direct I/O; their availability and migration semantics must be explicit.\\nPortable behavior cannot assume them; portable side effects appear as stream emissions. Direct-I/O host modules are explicitly local and non-migratable (owner decision, 2026-10-23).\\nStreams are values that can be sent through streams.\\nStreams carry whatever values the consumer needs: no datom requirement, no privileged payload shape.\\n\\nA stream has no privileged reader, and its meaning is not in it. Any number\\nof interpreters may observe the same medium, and each constructs its own\\nsemantics from the same batches: a `yin.vm` evaluator observing a program\\nstream constructs CESK state and executes it; `dao.space.index` observing\\nthe very same stream materializes covered indexes, so `dao.space.query/q`\\nanswers Datalog over the program as it grows. Neither knows the other\\nexists. The medium is their only coupling, and each observer's ignorance of\\nthe other is load-bearing: the evaluator never consults an index to run,\\nand the index never evaluates a form to index it. This is how axiom 2\\nbecomes architecture: one stream, many interpretations, none of them\\nthe stream's own.\\n\\nFunctions can take anything and return anything.\\nAgents are functions, closures, or continuations in `yin.vm` that communicate portably with the outside world through `dao.stream`. Portable agent behavior is specified through stream effects; host-local functions may also perform direct I/O.\\n\\nSee [`docs/design/dao.stream.md`](./dao.stream.md) for full stream specification.\\nSee [`docs/design/yin.vm.streams-all-the-way-down.md`](./yin.vm.streams-all-the-way-down.md) for VM architecture.\\n\\n### Host Boundaries\\n\\nA host boundary is the dao.stream abstraction boundary; implementations do not add contracts.\\n[datom.world.abi.md](./datom.world.abi.md) owns the doctrine, owner rulings, taxonomy, floor and custody rules.\\n\\n## Architectural Commitments\\n\\n- **`dao.jing` is syntax, agents are semantics**: the content-addressed encoding stays passive and payload-agnostic.\\n- **Macros are stream topology**: an evaluator knows nothing about macro expansion; expansion happens on the syntax side of a medium boundary, upstream of any evaluator.\\n- **Peer observers, one stream**: a generic evaluator and `dao.space` independently observe the same stream topic, as described under Streams. This is not a claim about any two consumers regardless of what they consume.\\n- **Observers are independent and optional**: nothing requires a medium to have any particular set of consumers. Which observers exist for a stream is a per-composition choice, not a design-time commitment.\\n\\n## Design Principles\\n\\nCode quality is measured by malleability: how cheaply can changes adapt without breaking promises?\\nStigmergic coordination emerges from sharing data across streams.\\n\\n**Systems emerge from interpreters of pure data.** Streams are the\\ncomposition medium; each interpreter gives the same data a perspective\\nwithout collapsing interpretation into execution or owning the truth.\\n\\n- `dao.space` emerges from `dao.space.index` and `dao.space.query` over\\n  ordinary streams.\\n- ShiBi capability, metering, and budget emerge from different\\n  interpreters over the same tuples; no token object is stored.\\n- The four VMs interpret one Universal AST; many syntaxes feed that AST.\\n- The semantic AST in `dao.space` is queryable facts projected by the\\n  auto-index observer.\\n- Client and server are roles in one stigmergic behavior implemented by\\n  interpreters, not distinct kinds of nodes.\\n\\n**Derive, don't persist.** Before adding a tag, slot, or field to any\\ncanonical content-hashed structure (an AST grammar, a datom schema, a row\\nshape), check whether a correctly scoped Datalog query over\\n`dao.space.query/q` can already compute the fact. If it can, it belongs as a\\nquery or projection: new persisted structure migrates every downstream\\nconsumer and duplicates authority over a fact a query derives fresh. The\\nretired `:global` tag in\\n[`docs/design/yin.vm.code-as-tuples.md`](./yin.vm.code-as-tuples.md) is the\\ncase study, including the scoping bug that a naive query introduced.\\n\\nSee [`docs/agents/malleability.md`](../agents/malleability.md) for complete design guidance (cohesion, coupling, bounded complexity, evolution, testing strategy).\\nSee [`docs/agents/vocabulary.md`](../agents/vocabulary.md) for domain vocabulary reference (biology, economics, physics, philosophy).\\n\\n## Code Style\\n\\n- Prefer simple data over rich types.\\n- Prefer total functions over partial ones.\\n- Prefer declarative pipelines over imperative logic.\\n- Avoid cleverness.\\n- Name things after what they do to streams.\\n\\n## Development Workflow\\n\\n- Do not invent abstractions that hide streams.\\n- Do not suggest mainstream frameworks unless explicitly asked.\\n- Do not optimize prematurely.\\n- When uncertain, ask at the architectural level, not the implementation level.\\n- Explanations should align with Plan 9 / Datomic / Lisp lineage.\\n- Program store writes go through `engine/store-put`; any other store write\\n  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\\n  detects must be on its allowlist; its docstring states the residual it\\n  leaves to review.\\n\\n### Problem Decomposition\\n\\nIf a problem appears complex:\\n1. Decompose it into streams.\\n2. Identify invariants.\\n3. Restrict degrees of freedom.\\n4. Make causality explicit.\\n5. Let structure emerge from constraints.\\n\\n## Operational & Specialized Guides\\n\\n- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\\n- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\\n- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\\n- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; each orchestrator session has its own append-only log at `orchestrator-logs/<unix-time-stamp>-<brief-orchestrator-descriptive-name>.md` under the repository root.\\n- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/exception-track/1794920000000-owner-ruling-exception-uniformity.md'\",\"aggregated_output\":\"Created-GMT: 2026-11-07 03:30:00 GMT\\nCreated-Local: 2026-11-07 10:30:00 +07 (+0700)\\nStatus: OWNER-APPROVED 2026-11-07 — \\\"enforce everywhere consistently. this should be a separate track.\\\"\\n\\n# RULING OF RECORD — the exception track: §8.10.7 enforced uniformly in all four frontends\\n\\n## The decision\\n\\nException handling is enforced uniformly across yang.clojure, yang.typescript (js),\\nyang.php, and yang.python. Every escaping source exception — from any frontend, through\\nany boundary — compiles down to THE SAME continuation: the caller's supplied raise exit\\nreceiving the §8.10.7 condition\\n\\n    {:yang.call/reason :yang.call/thrown, :yang.call/value original-thrown-value}\\n\\nand every receiving runtime implements the §8.10.7 reception rules (1)–(3) as written.\\nThis is a SEPARATE TRACK: it does not ride any frontend's ongoing slice; it has its own\\nfolder (`collab/exception-track/`), its own rounds, and its own acceptance gate. The four\\nfrontend seats cede these exception-fix surfaces to the track's rounds; the track files\\nper-frontend results back into each seat's records.\\n\\n## The uniformity requirements (each is testable)\\n\\n**R1 — the callee bridge (js, php are non-compliant today).** Every frontend's published\\nfunction entry (and closure/higher-order entry) installs the exception bridge: it reads\\nthe supplied `:yang.call/raise` and delivers every escaping source exception AND argument\\nbinding failure to it as the §8.10.7 condition. No frontend may let an escaping exception\\nfollow the host engine's own handler stack (js today, prelude.cljc:1581), and no frontend\\nmay return an uncaught error as an ordinary value (php today, prelude.cljc:190/2384).\\n\\n**R2 — foreign reception (python, php are non-compliant today).** On receiving a thrown\\ncondition: a payload valid in the receiving runtime keeps that runtime's ordinary\\ncatching and identity behavior; a runtime permitting arbitrary thrown values (js) may\\ndeliver the payload raw; a runtime requiring exception objects (python, php) represents a\\nforeign payload with its own generated `ForeignException`, retaining the complete\\ncondition and original payload — catch-all catches it, typed catches match the LOCAL\\nhierarchy, never guessed foreign class names. Raising the raw envelope (php:2384) or the\\nraw payload (python:1034) is non-compliant.\\n\\n**R3 — protocol failures retain the condition.** `:yang.call/not-callable`,\\n`:invalid-invocation`, `:unsupported-binding` map to a documented local exception form\\nretaining the complete original condition, so an unchanged rethrow can forward it. A fresh\\nlocal error containing only rendered text (js:1627, python:1046) is non-compliant.\\n\\n**R4 — clojure unifies.** The internal outcome-token channel\\n(clojure.cljc:1110/1486) may remain an optimization ONLY with a proof of equivalence at\\nevery boundary; absent that proof it unifies onto the raise-exit path. Clojure's `try`\\nrejection of `finally` and its single-catch restriction are source-semantics decisions\\nTHIS RULING DOES NOT CHANGE — R4 is about the continuation, not clojure's catch surface.\\n\\n**R5 — no new shape-routing.** Nothing in the track may route on the condition map's\\nshape beyond the §8.10.7 contract; a lookalike map stays ordinary data (the cell-ref\\nruling's rule, restated). No synthesized engine-effect exception values.\\n\\n## What the audit establishes (the baseline)\\n\\nThe gpt-6.1-sol audit (collab/yang-python/1794900000000, verdict DIVERGENT, HEAD\\ne9a0b430) is the track's baseline evidence: python hooks the raise exit (R1 compliant);\\njs and php lack the bridge (R1); python and php lack ForeignException (R2); js and python\\nlose protocol conditions (R3); clojure has the private channel (R4). Zero cross-language\\n§8.10.7 legs exist in the conformance kit today.\\n\\n## Acceptance gate\\n\\nThe conformance kit (`test/yang/call/conformance.clj`) grows exception legs — the\\n§8.10.11 exception row as acceptance: binding failures, arbitrary foreign thrown data,\\ncatch-all/typed catches, unchanged rethrow, finally replacement, protocol-error rethrow,\\ncondition-shaped thrown maps staying data, A→B→A propagation with identity and cleanup\\norder, and the stored-ForeignException rethrown-from-another-activation case. The track\\nis DONE when every admitted pair passes those legs with real source on both sides, and\\nthe divergences R1–R4 are each closed by a focused test pinning the compliant behavior.\\n\\n## Sequencing\\n\\nArchitect review of this ruling, then an engineer mob review, then per-frontend fix\\nrounds (smallest first: R3 js/python, R1 php, R2 python/php, R4 clojure), the conformance\\nlegs landing alongside the fixes they gate. The known-gaps row for this track is filed\\nfrom the audit's divergence list.\\n\\n— filed by the yang.python orchestrator seat on the owner's instruction\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat .agents/skills/code-review-pr/references/review_checklist.md'\",\"aggregated_output\":\"# Code Review PR Checklist & Taxonomy\\n\\nWhen performing code reviews, evaluate changes using this structured checklist and severity taxonomy.\\n\\n---\\n\\n## 1. Finding Severity Taxonomy\\n\\n| Severity | Label | Definition | Examples |\\n| :--- | :--- | :--- | :--- |\\n| **P0** | **Critical (Blocker)** | Security vulnerabilities, data loss risks, production crashes, secret leakage. Must be fixed before merging. | Hardcoded tokens, unhandled NullPointer on critical path, SQL injection, broken auth check. |\\n| **P1** | **High (Must Address)** | Logic bugs, breaking API changes, missing error handling on external calls, race conditions, lack of tests for complex logic. | Swallowed exceptions, broken retry loop, missing backward compatibility in API schema. |\\n| **P2** | **Medium (Recommended)** | Performance inefficiencies, code duplication, sub-optimal data structures, non-idiomatic style. | Unnecessary DB query inside loop, missing index, missing parameter validation. |\\n| **P3** | **Low (Nit / Suggestion)** | Minor formatting, naming improvements, leftover comments/TODOs, minor doc polish. | Variable naming clarity, typos in docstrings, cleaning leftover TODO comments. |\\n\\n---\\n\\n## 2. Comprehensive Review Checklist\\n\\n### A. Logic & Correctness\\n- [ ] **Edge Cases**: Does the code handle null/nil/undefined, empty collections, zero values, boundary numbers, and unexpected inputs?\\n- [ ] **State & Concurrency**: Are shared state mutations thread-safe? Are locks acquired/released properly without deadlock risks?\\n- [ ] **Control Flow**: Are all conditional branches covered? Do loops have guaranteed termination conditions?\\n- [ ] **Error Propagation**: Are errors caught and logged/surfaced appropriately, rather than swallowed silently (`catch (Exception e) {}`)?\\n\\n### B. Security & Credentials\\n- [ ] **No Hardcoded Secrets**: Are API keys, passwords, bearer tokens, or private keys excluded from code and config?\\n- [ ] **Input Validation & Sanitization**: Are external inputs validated before processing or passing to system shells, DB queries, or HTML rendering?\\n- [ ] **Authentication & Authorization**: Do endpoints verify user identity and check permissions before executing state changes?\\n- [ ] **Safe Dependencies**: Are newly added packages pinned to trusted versions without known vulnerabilities?\\n\\n### C. Architecture & API Design\\n- [ ] **Preserve API Contracts**: Are public method signatures, REST endpoints, and schema definitions backward compatible?\\n- [ ] **Single Responsibility**: Are modules, classes, and functions focused on a clear, single responsibility?\\n- [ ] **Coupling & Cohesion**: Is the new code properly modularized without introducing circular dependencies or leaky abstractions?\\n- [ ] **Idempotence**: Are retry loops or state-changing operations safe to re-execute on transient failures?\\n\\n### D. Performance & Resource Efficiency\\n- [ ] **N+1 Queries**: Are database or remote API calls executed in batches rather than inside loops?\\n- [ ] **Resource Cleanup**: Are file handles, database connections, streams, and web sockets closed explicitly (or managed via try-with-resources / context managers)?\\n- [ ] **Memory & Allocation**: Are large datasets streamed or paginated rather than loaded fully into memory at once?\\n\\n### E. Test Coverage & Quality\\n- [ ] **Test Coverage**: Do new features or bug fixes include corresponding unit or integration tests?\\n- [ ] **Test Quality**: Do tests verify actual assertions rather than just checking that code runs without throwing?\\n- [ ] **Edge Case Tests**: Are failure modes, invalid inputs, and error handlers covered by unit tests?\\n\\n---\\n\\n## 3. Review Feedback Guidelines\\n\\n1. **Be Specific**: Always reference the exact file line number, function name, and context.\\n2. **Explain the \\\"Why\\\"**: Don't just say \\\"change this\\\". Explain the risk or benefit (e.g., \\\"This could lead to a race condition if two threads call `transact!` simultaneously...\\\").\\n3. **Provide Concrete Fixes**: Offer concrete, copy-pasteable diff snippets where appropriate.\\n4. **Acknowledge Good Work**: Highlight well-crafted solutions, thorough tests, or clean refactorings.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:17:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'tail -n 300 collab/yang-python/1794900000000-reviewer-exception-uniformity-audit.gpt-6.1-sol.stdout.log'\",\"aggregated_output\":\"{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"01a1b1c4-7ea1-7c83-938d-c4ba15a3803d\\\"}\\n{\\\"type\\\":\\\"turn.started\\\"}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_0\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I’ll read the architecture rules, then trace exception lowering, call boundaries, and test evidence in the specified worktree. I’ll keep the audit read-only and avoid running tests.\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"pwd && git status --short && rg --files -g AGENTS.md -g '*yang.antlr*' -g '*datom.world.md'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"pwd && git status --short && rg --files -g AGENTS.md -g '*yang.antlr*' -g '*datom.world.md'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"/Users/sto/workspace/datomworld-f12\\\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-euV8Sa40' (errno=Operation not permitted)\\\\n2026-11-06 23:50:20.656 xcodebuild[20787:113049836]  DVTFilePathFSEvents: Failed to start fs event stream.\\\\n2026-11-06 23:50:21.048 xcodebuild[20787:113049835] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\\\\\"Input/output error\\\\\\\". Using NSCachesDirectory instead.\\\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\\\ngit: error: couldn't create cache file '/tmp/xcrun_db-Qld1dRlb' (errno=Operation not permitted)\\\\n2026-11-06 23:50:22.535 xcodebuild[20809:113049914]  DVTFilePathFSEvents: Failed to start fs event stream.\\\\n2026-11-06 23:50:22.930 xc