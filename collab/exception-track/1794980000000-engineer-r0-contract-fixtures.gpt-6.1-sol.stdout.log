{"type":"item.completed","item":{"id":"item_93","type":"command_execution","command":"/bin/zsh -lc \"git diff -- test/yang/call/exception_contract.clj; sed -n '1,180p' test/yang/call/exception_probes.clj\"","aggregated_output":"diff --git a/test/yang/call/exception_contract.clj b/test/yang/call/exception_contract.clj\nindex e95fea64..cfdd7a12 100644\n--- a/test/yang/call/exception_contract.clj\n+++ b/test/yang/call/exception_contract.clj\n@@ -17,7 +17,7 @@\n \n (def sources\n   \"Every export below is source-produced. `original` is an identity-bearing\n-   value, including Clojure's atom. `receive` catches then rethrows unchanged;\n+   value, including Clojure's explicit cell. `receive` catches then rethrows unchanged;\n    `retain` returns normally before `later` raises from a new activation.\n    Protocol catch forms are intentionally local catch-all forms. No guessed\n    donor class name participates in reception.\"\n@@ -26,7 +26,7 @@\n              [\"original = ValueError('original')\"\n               \"saved = None\"\n               \"def payload():\" \"    return original\"\n-              \"def explode():\" \"    raise original\"\n+              \"def donor_raise():\" \"    raise original\"\n               \"def make_exploder():\"\n               \"    def inner():\" \"        raise original\" \"    return inner\"\n               \"def needs_argument(x):\" \"    return x\"\n@@ -49,7 +49,7 @@\n    (str \"globalThis.original = {marker: 'original'};\"\n         \"globalThis.saved = null;\"\n         \"globalThis.payload = function() { return original; };\"\n-        \"globalThis.explode = function() { throw original; };\"\n+        \"globalThis.donor_raise = function() { throw original; };\"\n         \"globalThis.make_exploder = function() { return () => { throw original; }; };\"\n         \"globalThis.receive = function(f) { try { return f(); } catch (e) { throw e; } };\"\n         \"globalThis.retain = function(f) { try { return f(); } catch (e) { saved = e; return e; } };\"\n@@ -59,7 +59,7 @@\n    :php\n    (str \"<?php $original = new Exception('original'); $saved = null;\"\n         \"function payload() { global $original; return $original; }\"\n-        \"function explode() { global $original; throw $original; }\"\n+        \"function donor_raise() { global $original; throw $original; }\"\n         \"function make_exploder() { return function() { global $original; throw $original; }; }\"\n         \"function needs_argument($x) { return $x; }\"\n         \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\"\n@@ -70,13 +70,13 @@\n         \" $e->__yang_call_condition__ = $e->condition; return $e; }\"\n         \"function raise_value($e) { throw $e; }\")\n    :clojure\n-   (str \"(def original (atom :original)) (def saved (atom nil)) \"\n-        \"(defn payload [] original) (defn explode [] (throw original)) \"\n+   (str \"(def original (cell/new :original)) (def saved (cell/new nil)) \"\n+        \"(defn payload [] original) (defn donor_raise [] (throw original)) \"\n         \"(defn make_exploder [] (fn [] (throw original))) \"\n         \"(defn needs_argument [x] x) \"\n         \"(defn receive [f] (try (f) (catch Exception e (throw e)))) \"\n-        \"(defn retain [f] (try (f) (catch Exception e (reset! saved e) e))) \"\n-        \"(defn later [] (throw @saved)) \"\n+        \"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \"\n+        \"(defn later [] (throw (cell/get saved))) \"\n         \"(defn raise_value [e] (throw e)) (defn echo [e] e)\")})\n \n \n@@ -112,6 +112,9 @@\n                  {:transferred true :once true :after false\n                   :condition-identical true :reason reason}\n                  {:protocol-reason reason}))\n+      (for [f [:python :php]]\n+        (fixture :local-reception f #{::r2}\n+                 {:returned true :payload-identical true}))\n       (for [f [:python :php]]\n         (fixture :foreign-reception f #{::r2}\n                  {:returned true :local-foreign-exception true}))\n@@ -155,7 +158,8 @@\n (def pair-matrix\n   (vec (for [donor (sort frontends), caller (sort frontends)\n              :when (not= donor caller), [scenario gates] (sort pair-scenarios)\n-             :when (not (and (= scenario :binding) (= donor :typescript)))]\n+             :when (not (and (= scenario :binding) (= donor :typescript)))\n+             :when (not (and (= scenario :finally-replacement) (= caller :clojure)))]\n          {:id [donor caller scenario] :donor donor :caller caller\n           :scenario scenario :gates gates :frontends #{donor caller}\n           :execution (if (#{donor caller} :python)\n@@ -168,9 +172,11 @@\n   [{:id :clojure-private-public-equivalence :gates #{::r4}\n     :frontends #{:clojure} :execution :pending-round-4\n     :cases #{:caught :uncaught :protocol-rethrow :binding :higher-order}}\n+   {:id :clojure-finally-refusal :gates #{::r4}\n+    :frontends #{:clojure} :execution :preserve-source-refusal}\n    {:id :suspension-and-recursion :gates #{::r1 ::r2}\n     :frontends frontends :execution :pending-frontend-rounds}\n-   {:id :host-vm-publication-parity :gates #{::r1 ::r2 ::r3 ::r4 ::r5}\n+   {:id :host-vm-publication-parity :gates #{::r1 ::r2 ::r3 ::r5}\n     :frontends frontends :execution :pending-frontend-rounds\n     :cases #{:node :dart :bundled :task-isolation :custody-refusals}}\n    {:id :methods-and-callable-objects :gates #{::r1 ::r2 ::r3}\n(ns yang.call.exception-probes\n  \"Boundary materialization of exception-contract/fixtures. Synthetic entries\n   occur ONLY for delivery of boundary-generated conditions; source pairs\n   live in exception-legs. Every receiver/rethrow body is parsed source.\"\n  (:require [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]))\n\n\n(defn- read-export [frontend name] (kit/export-form frontend name))\n(defn- call [callee args] (kit/boundary-call-form callee args []))\n\n\n(def ^:private boundary-donor\n  (delay (kit/publish-donor! :python contract/boundary-source)))\n\n\n(defn- transfer-summary [result]\n  {:transferred (list '= (list 'get result :route) :raise)\n   :once (list '= 1 (list 'get result :transfers))\n   :after (list 'get result :after)})\n\n\n(defn- reason [result]\n  (list 'get (list 'get result :condition) :yang.call/reason))\n\n\n(defn- payload [result]\n  (list 'get (list 'get result :condition) :yang.call/value))\n\n\n(defn- protocol-condition [reason]\n  (let [target (read-export :python \"boundary_target\")]\n    (list 'get\n          (case reason\n            :yang.call/not-callable (call {} [])\n            :yang.call/invalid-invocation\n            (kit/boundary-call-form target :malformed-positional [])\n            :yang.call/unsupported-binding\n            (kit/boundary-call-form target [] []\n                                    {:yang.call/binding-profile :contract/unsupported}))\n          :condition)))\n\n\n(defn- injected [condition]\n  ;; This is a boundary delivery fixture, never counted as a real-source\n  ;; directed pair. The source receiver still uses its ordinary call helper.\n  (list 'cell/new\n        (list 'assoc {} :yang.call/entry\n              (list 'fn ['invocation]\n                    (list (list 'get 'invocation :yang.call/raise) condition)))))\n\n\n(defn observation-form\n  \"A fixture's guest-side assertions as plain booleans and qualified reasons.\n   Neither live payloads nor wrappers are rendered or ferried between tasks.\"\n  [{:keys [scenario frontend protocol-reason]}]\n  (let [export #(read-export frontend %)\n        result 'probe.result\n        original 'probe.original\n        condition 'probe.condition\n        retained 'probe.retained\n        wrapper 'probe.wrapper\n        fresh-summary (assoc (transfer-summary result)\n                             :reason (reason result)\n                             :payload-identical (list '= original (payload result)))\n        protocol-summary (assoc (transfer-summary result)\n                                :reason (reason result)\n                                :condition-identical\n                                (list '= condition (list 'get result :condition)))]\n    (kit/guard-exceptions-form\n      [:python frontend]\n      (cond\n        (#{:fresh-named :fresh-closure :forged-retention} scenario)\n        (list 'let [original (list 'get (call (export (if (= scenario :forged-retention)\n                                                       \"forged\" \"payload\")) []) :value)\n                    result (case scenario\n                             :fresh-named (call (export \"donor_raise\") [])\n                             :fresh-closure\n                             (call (list 'get (call (export \"make_exploder\") []) :value) [])\n                             :forged-retention (call (export \"raise_value\") [original]))]\n              fresh-summary)\n\n        (= scenario :binding)\n        (list 'let [result (call (export \"needs_argument\") [])]\n              (assoc (transfer-summary result) :reason (reason result)))\n\n        (#{:shape-return :shape-throw} scenario)\n        (list 'let [original {:yang.call/reason :yang.call/not-callable\n                              :yang.call/data {:nested [:ordinary :data]}}\n                    result (call (export (if (= scenario :shape-return) \"echo\" \"raise_value\"))\n                                 [original])]\n              (if (= scenario :shape-return)\n                {:returned (list '= (list 'get result :route) :return)\n                 :payload-identical (list '= original (list 'get result :value))}\n                fresh-summary))\n\n        protocol-reason\n        (list 'let [condition (protocol-condition protocol-reason)\n                    'probe.injected (injected condition)]\n              (if (.startsWith (name scenario) \"saved-protocol-\")\n                (list 'let [retained (call (export \"retain\") ['probe.injected])\n                            result (call (export \"later\") [])]\n                      (assoc protocol-summary\n                             :retained (list '= (list 'get retained :route) :return)))\n                (list 'let [result (call (export \"receive\") ['probe.injected])]\n                      protocol-summary)))\n\n        (= scenario :local-reception)\n        (list 'let [original (list 'get (call (export \"payload\") []) :value)\n                    condition {:yang.call/reason :yang.call/thrown\n                               :yang.call/value original}\n                    'probe.injected (injected condition)\n                    result (call (export \"retain\") ['probe.injected])]\n              {:returned (list '= :return (list 'get result :route))\n               :payload-identical (list '= original (list 'get result :value))})\n\n        (#{:foreign-reception :retained-foreign-lifetime} scenario)\n        (list 'let [original (list 'cell/new {:foreign/payload :identity})\n                    condition {:yang.call/reason :yang.call/thrown\n                               :yang.call/value original\n                               :yang.call/data {:complete [:extra :evidence]}}\n                    'probe.injected (injected condition)\n                    retained (call (export \"retain\") ['probe.injected])\n                    wrapper (list 'get retained :value)\n                    'probe.local (call (export \"is_foreign\") [wrapper])]\n              (let [local (list '= true (list 'get 'probe.local :value))\n                    returned (list '= (list 'get retained :route) :return)]\n                (if (= scenario :foreign-reception)\n                  {:returned returned :local-foreign-exception local}\n                  (list 'let [result (call (export \"later\") [])]\n                        (assoc (transfer-summary result)\n                               :retained returned :local-foreign-exception local\n                               :condition-identical (list '= condition (list 'get result :condition))\n                               :payload-identical (list '= original (payload result)))))))\n\n        :else (throw (ex-info \"unknown provenance fixture\" {:scenario scenario}))))))\n\n\n(defn run-fixture\n  \"One source-created receiver per task. All three linked vector VMs run.\n   A fresh task prevents a deliberately broken bridge from poisoning the\n   next fixture's handler context.\"\n  [{:keys [frontend source] :as fixture}]\n  (let [donor @boundary-donor]\n    (kit/run-program\n      donor\n      (kit/compose-exception donor [\"boundary_target\"] frontend source\n                             (observation-form fixture)))))\n","exit_code":0,"status":"completed"}}
