r-try-except ctx n blocks))))\\n  1678\\t\\n  1679\\t\\n  1680\\t(defn- lower-with\\n  1681\\t  \\\"`with a as x, b:` nests as `with a as x: with b:`; each item is\\n  1682\\t   `(py/with manager (fn [value] (assign target value) ...))`.\\\"\\n  1683\\t  [ctx n]\\n  1684\\t  (let [items (rules ctx n \\\"with_item\\\")\\n  1685\\t        body (u/seq-nodes (lower-block ctx (first (rules ctx n \\\"block\\\"))))]\\n  1686\\t    (reduce (fn [inner item]\\n  1687\\t              (let [ik (kids ctx item)\\n  1688\\t                    v (gen \\\"wv\\\" item)]\\n  1689\\t                (app* 'py/with\\n  1690\\t                      ((:lower ctx) ctx (first ik))\\n  1691\\t                      (u/lam [v]\\n  1692\\t                             (if (p/has-token? (:pk ctx) item \\\"as\\\")\\n  1693\\t                               (u/then (assign-target ctx (last ik) (u/v v)) inner)\\n  1694\\t                               inner)))))\\n  1695\\t            body\\n  1696\\t            (reverse items))))\\n  1697\\t\\n  1698\\t\\n  1699\\t(defn- lower-try-except\\n  1700\\t  \\\"`try` with `except` clauses and an optional `else`: `blocks` are the try\\n  1701\\t   body, one block per clause, then the else block if any.\\\"\\n  1702\\t  [ctx n blocks]\\n  1703\\t  (let [exc (gen \\\"exc\\\" n)\\n  1704\\t        clauses (rules ctx n \\\"except_clause\\\")\\n  1705\\t        body (u/seq-nodes (lower-block ctx (first blocks)))\\n  1706\\t        handler-blocks (subvec blocks 1 (inc (count clauses)))\\n  1707\\t        else-block (get blocks (inc (count clauses)))\\n  1708\\t        hctx (assoc ctx :exc exc)\\n  1709\\t        dispatch\\n  1710\\t        (reduce\\n  1711\\t          (fn [fallthrough [clause block]]\\n  1712\\t            (let [ck (kids ctx clause)\\n  1713\\t                  cls-node (first (rules ctx clause \\\"test\\\"))\\n  1714\\t                  as-name (first (rules ctx clause \\\"name\\\"))\\n  1715\\t                  handler (if as-name\\n  1716\\t   