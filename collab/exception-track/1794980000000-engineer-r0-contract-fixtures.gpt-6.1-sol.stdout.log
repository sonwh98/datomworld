{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3010,3045p' src/cljc/yang/clojure.cljc; sed -n '105,132p' test/yang/php/antlr/portable_harness.cljc; sed -n '155,180p' src/cljc/yang/typescript/antlr/render.cljc; cat src/cljc/yang/core/call.cljc\"","aggregated_output":"         program (compile-program (concat source library) true unit-opts)\n         macros (into #{}\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n                            (map (comp strip-symbol-meta second)))\n                      (concat source library))\n         names (reduce disj\n                       (into (set (top-level-names source))\n                             (concat (map (comp strip-symbol-meta second) library)\n                                     (map symbol exports)))\n                       macros)]\n     (u/lam [] (publish-to-globals program names #{})))))\n\n\n(defn output\n  \"The `clj/run-main` value as test data.\"\n  [value]\n  (pr-str value))\n    {:yang.cst/version 1,\n     :yang.cst/unit [:hand 0],\n     :yang.cst/grammar \"hand\",\n     :yang.cst/outcome :yang.cst/ok,\n     :yang.cst/root 0,\n     :yang.cst/nodes @out,\n     :yang.cst/complete true}))\n\n\n(defn render\n  \"The text a unit prints (ASCII here: the carrier is the text), then, for an\n   uncaught error, the fatal line (no path).\"\n  [{:php/keys [out uncaught fatal]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n       (when fatal\n         (str \"PHP Fatal error:  \" fatal))))\n\n\n(defn lower-through-stage\n  \"`{:ast a :warnings w}` or `{:diagnostics d}` for `pk` through the lowering\n   stage. Warning-severity diagnostics do not stop the program.\"\n  [pk]\n  (let [cst-log (new-memory-log)\n        program (new-memory-log)\n        diagnostics (new-memory-log)]\n    (stream/append! cst-log pk)\n\n\n(defn output\n  \"A program