0\\t(defn- source-module\\n    31\\t  \\\"An ordinary module exporting the unmodified lowered source body.\\\"\\n    32\\t  [name packet]\\n    33\\t  (core-module/module-spec\\n    34\\t    :yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free\\n    35\\t    (h/registry)\\n    36\\t    {:name name,\\n    37\\t     :ast (core-module/module-tree\\n    38\\t            [(core-module/require-node 'php)\\n    39\\t             (u/def! 'body (u/lam [] (php-lower/lower-module-body packet)))]),\\n    40\\t     :exports '#{body},\\n    41\\t     :runtime-name 'php,\\n    42\\t     :runtime-address (:address @published-php)}))\\n    43\\t\\n    44\\t\\n    45\\t(defn- projection\\n    46\\t  \\\"Namespace composition only: preserve each resolved function cell.\\\"\\n    47\\t  [names]\\n    48\\t  (u/sexp->uast\\n    49\\t    (cons 'do\\n    50\\t          (map (fn [name]\\n    51\\t                 (list 'js/define-global! name (list 'php/resolve-fn name name)))\\n    52\\t               names))))\\n    53\\t\\n    54\\t\\n    55\\t(defn- check-source\\n    56\\t  [{:keys [module php-form functions ts-form expected]}]\\n    57\\t  (let [expected {:js/out (str/split-lines expected), :js/uncaught nil}\\n    58\\t        php-packet (php-h/packet php-form)\\n    59\\t        ts-packet (php-h/packet ts-form)\\n    60\\t        project (projection functions)\\n    61\\t        bundled (u/mark-tails\\n    62\\t                  (u/seq-nodes [(php-lower/lower-packet php-packet)\\n    63\\t                                prelude/uast project\\n    64\\t                                (u/app (u/v 'js/run-main) (lower/lower-unit ts-packet))]))]\\n    65\\t    (testing \\\"bundled source on every VM\\\"\\n    66\\t      (doseq [[backend run] parity/runners]\\n    67\\t        (is (= expected (render/output (run bundled))) (str backend))))\\n    68\\t    (testing \\\"published PHP source and linked JS on each admitted VM\\\"\\n    69\\t      (let [donor (h/publish-guest-