{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'yin/capture|capture ' test/yang/typescript/antlr/prelude_parity_test.cljc | head -25; sed -n '740,795p' test/yang/typescript/antlr/prelude_parity_test.cljc; sed -n '1,130p' src/cljc/yang/clojure/prelude.cljc; sed -n '880,925p' src/cljc/yang/python/antlr/prelude.cljc; sed -n '1020,1055p' src/cljc/yang/python/antlr/prelude.cljc; rg -n 'exception|class|snapshot' src/cljc/yang/python/antlr/prelude.cljc | tail -18; sed -n '1,180p' test/yang/cross_lang_test.clj\"","aggregated_output":"                 (js/call f :js/undefined [:js/undefined]))))]\n    (testing (str k)\n      (is (= [0 1] (if (vector? result) result [:thrown result]))))))\n\n\n(deftest ^:slow shared-call-eligibility-on-every-vm-test\n  (doseq [[k result]\n          (run-with-prelude\n            prelude/uast\n            '(let [foreign\n                   (cell/new\n                     (assoc (assoc {} :py/type :function)\n                            :yang.call/entry\n                            (fn [invocation]\n                              (get invocation :yang.call/callee))))\n                   disabled\n                   (cell/new\n                     (assoc (assoc (assoc {} :py/type :native)\n                                   :yang.call/entry (fn [invocation] invocation))\n                            :yang.call/eligible? (fn [callee] false)))]\n               (js/vconj\n                 (js/vconj (js/vconj [] (js/callable? foreign))\n                           (= foreign (js/call foreign :js/undefined [])))\n                 (js/callable? disabled))))]\n    (testing (str k)\n      (is (= [true true false] (if (vector? result) result [:thrown result]))))))\n\n\n(deftest ^:slow shared-call-thrown-value-on-every-vm-test\n  (doseq [[backend result]\n          (run-with-prelude\n            prelude/uast\n            '(let [payload (js/make-object :js/null)\n                   f (cell/new\n                       (assoc {} :yang.call/entry\n                              (fn [invocation]\n                                ((get invocation :yang.call/raise)\n                                 (yang.call/thrown payload)))))]\n               (js/try (fn [] (js/call f :js/undefined []))\n                       (fn [caught] (= caught payload)))))]\n    (is (= true result) (str backend))))\n\n\n(defn- finally-order-on-every-vm\n  []\n  (testing \"nested finally frames run inner first, once each, before the\n            outer handler\"\n    (doseq [[k result]\n            (run-with-prelude\n              prelude/uast\n              '(let [log (cell/new [])]\n                 (js/vconj\n                   (js/vconj\n                     []\n                     (js/try (fn []\n                               (js/try-finally\n(ns yang.clojure.prelude\n  \"The `clj` runtime module (docs/design/yang.antlr.md section 8.10):\n   the published linker module every linked clojure program requires, as\n   `js`, `php` and `py` are for their frontends. It is written in prelude\n   notation and emitted with the same core machinery those preludes use;\n   it never runs on the host.\n\n   Three surfaces, mirroring the other runtimes:\n\n   - the entry, `clj/run-main`: initialize the runtime state, run the\n     unit — the thunk `yang.clojure/lower-unit` lowered — and answer the\n     program's value with the outcome model's `[:yin.k/ok value]`\n     wrapper removed, since that wrapper is frontend-internal. The\n     entry does not reset the global namespace: the namespace lives for\n     the task, so a projection the composition bound between two\n     entries and a definition an earlier unit published both survive\n     into the next unit's run (as `js/run-main` leaves `globalThis`\n     standing);\n   - the runtime global namespace, `clj/define-global!` and\n     `clj/global-get`: a task-local map in a cell (`clj.rt/globals`,\n     allocated once per task by `clj/init!`), keyed by export name. A\n     program's top-level definitions land here through its unit's own\n     publishing, and the conformance helper's export projection reads\n     and writes it — the one binding a linked unit reads a projected or\n     defined name through. A definition a unit runs publishes after\n     any projection of the same name and shadows it. The JS\n     `globalThis` table, the PHP named-function table and the Python\n     module dictionary are the same seam;\n   - admission, `admit`: the registry surface a linked clojure composition\n     needs beside the others — the `kind` module and the `portable`\n     adapters of the data exports the guest library's collection\n     predicates read.\n\n   The module pins the shared calling runtime (`yang.call`) at the\n   convention's call-address, as the other runtimes do, and refuses before\n   anything is published when a free name nothing supplies is read.\"\n  (:require [yang.core.prelude :as core]\n            [yang.clojure :as yang]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.module :as module]))\n\n\n(def module-name\n  \"The linker module name of the clojure runtime.\"\n  'clj)\n\n\n(def runtime-keys\n  \"Every runtime key, each with an `:clj/uninit` placeholder at module\n   level so every read is discharged before `clj/init!` allocates the\n   real cell. They stay qualified: internal store keys, never guest\n   names.\"\n  '[clj.rt/state clj.rt/globals])\n\n\n(def definitions\n  \"The module's definition list, in prelude notation (the module's own\n   `clj/` prefix is stripped on emit).\"\n  '[;; ------------------------------------------------- state and namespace\n    [clj/init!\n     (fn []\n       (if (= clj.rt/state :clj/uninit)\n         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n             (yin/def (quote clj.rt/state) :clj/ready))\n         :clj/ready))]\n    ;; the runtime global namespace: one task-local map in a cell, keyed by\n    ;; export name. `clj/define-global!` answers the value, so a publish\n    ;; sequence can chain through it.\n    [clj/define-global!\n     (fn [name value]\n       (do (cell/set! clj.rt/globals\n                      (assoc (cell/get clj.rt/globals) name value))\n           value))]\n    [clj/global-get\n     (fn [name]\n       (if (data/contains? (cell/get clj.rt/globals) name)\n         (get (cell/get clj.rt/globals) name)\n         :clj/unbound))]\n\n    ;; ------------------------------------------------------------- entry\n    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n    ;; internal, so the entry removes one wrapper level from the\n    ;; program's value (a program returning that vector as data was\n    ;; wrapped again, so one level is exact). An error outcome passes\n    ;; through as the failure value for the caller to render.\n    [clj/unwrap-outcome\n     (fn [value]\n       (if (if (data/vector? value) (= (data/count value) 2) false)\n         (if (= (data/nth value 0) :yin.k/ok)\n           (data/nth value 1)\n           value)\n         value))]\n    ;; The global namespace is the task's, not the entry's: no reset\n    ;; here, so projections and earlier units' definitions survive.\n    [clj/run-main\n     (fn [body]\n       (do (clj/init!)\n           (clj/unwrap-outcome (body))))]])\n\n\n(def module-definitions\n  \"The module's definition list: an `:clj/uninit` placeholder for every\n   runtime key, then every definition, stripped.\"\n  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n\n\n(def module-uast\n  \"The module tree: one wide application over the definitions, so every\n   sibling and runtime key read is discharged at module level.\"\n  (core/module-tree module-definitions []))\n\n\n(def module-exports\n  \"The module's exports: every `clj/` key of the definition list, stripped.\"\n  (core/exports \"clj\" definitions))\n\n\n(def ^:private module-free-names\n  \"The names the module tree reads and does not define, sorted: the host\n   exports its manifest must declare.\"\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `clj` over\n   the host registry `registry`, pinned to the published `yang.call`\n   module at `call-address` — the convention's call-address, as every\n   runtime's publication carries. A free name nothing supplies is refused\n   before anything is published. This namespace emits; it never publishes.\"\n    ;;   {:params [positional names] :star? bool :kwonly [names] :kwstar? bool}\n    ;; `defaults` holds the trailing positional defaults and `kwdefaults`\n    ;; [[name value] ...] the keyword-only ones, both evaluated at\n    ;; definition time. `code` takes one vector laid out as the parameters\n    ;; are written: positional, the *args tuple, keyword-only, the **kwargs\n    ;; dict.\n    [py/function-entry\n     ;; Generated boilerplate. Python functions are unbound here: a supplied\n     ;; receiver remains in the invocation but is not injected into args.\n     (fn [owner invocation]\n       (let [callee (get invocation :yang.call/callee :py/missing)\n             positional (get invocation :yang.call/positional :py/missing)\n             named (get invocation :yang.call/named :py/missing)\n             raise-exit (get invocation :yang.call/raise :py/missing)\n             binding-profile (get invocation :yang.call/binding-profile :py/missing)]\n         (if (if (= callee :py/missing) true\n                 (if (= positional :py/missing) true\n                     (if (= named :py/missing) true\n                         (if (= raise-exit :py/missing) true\n                             (not (= callee owner))))))\n           (raise-exit {:yang.call/reason :yang.call/invalid-invocation})\n           (if (not (= binding-profile :py/missing))\n             (raise-exit (assoc {:yang.call/reason :yang.call/unsupported-binding}\n                                :yang.call/binding-profile binding-profile))\n             (let [fc (cell/get owner)\n                   result (cell/new :py/None)]\n               (py/try\n                 (fn []\n                   (cell/set! result\n                              ((get fc :code)\n                               (py/bind-args fc positional named))))\n                 (fn [e]\n                   (raise-exit (assoc {:yang.call/reason :yang.call/thrown}\n                                      :yang.call/value e)))\n                 (fn [] (cell/get result))))))))]\n    [py/function-cell\n     (fn [name spec defaults kwdefaults code entry?]\n       (let [content (assoc (assoc (assoc (assoc (assoc (assoc {} :py/type :function)\n                                                        :name name)\n                                                 :spec spec)\n                                          :defaults defaults)\n                                   :kwdefaults kwdefaults)\n                            :code code)\n             f (cell/new content)]\n         (if entry?\n           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\n                           (py/vconj (py/vconj (py/vconj [] (py/pad args n 0 []))\n                                               (py/pad [] (data/count (get spec :kwonly)) 0 []))\n                                     (if (get spec :kwstar?) (py/dict-new) nil))\n                           kwargs\n                           0)\n                   slots (py/fill-defaults fc (get state 0) (get fc :defaults) n 0)\n                   ko (py/fill-kwdefaults fc (get state 1) (get spec :kwonly) 0)\n                   with-star (if star\n                               (py/vconj slots\n                                         (py/tuple (if (< n given) (data/subvec args n) [])))\n                               slots)\n                   with-ko (data/into with-star ko)]\n               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\n    [py/call (fn [f args] (py/call-kw f args []))]\n    [py/call-kw\n     (fn [f args kwargs]\n       (if (= (get f :py/type) :method)\n         (py/call-kw (get f :fn) (data/into (py/vconj [] (get f :self)) args) kwargs)\n         (if (= (py/content-type f) :class)\n           (py/instantiate f args kwargs)\n           (if (yang.call/eligible? f)\n             (yang.call/invoke\n               f args kwargs\n               (fn [condition]\n                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\n                   (py/raise (get condition :yang.call/value))\n                   (py/type-error {:py/str \"object is not callable\"}))))\n             (if (= (py/content-type f) :function)\n               (let [fc (cell/get f)]\n                 ((get fc :code) (py/bind-args fc args kwargs)))\n               (py/type-error {:py/str \"object is not callable\"}))))))]\n    [py/instantiate\n     (fn [cls args kwargs]\n       (let [inst (py/make-instance cls)\n             init (py/class-lookup cls \"__init__\")]\n         ;; without __init__ only exception classes take arguments (they\n3320:                    :py/exception\n3321:                    (if (= exc :py/None) nil (py/snapshot-exc exc))))))]\n3326:     ;; body's re-raise the program's snapshotted value. One code image\n3338:                    :py/exception\n3339:                    (if (= exc :py/None) nil (py/snapshot-exc exc))))))]\n3344:     ;; the output, the exception and :py/value (the last bare expression\n3365:                    :py/exception\n3366:                    (if (= exc :py/None) nil (py/snapshot-exc exc))))))]])\n3369:(def builtin-classes\n3370:  \"Builtin class name -> [store key, base store key or nil].\"\n3373:   ;; raised by the safepoint hook prelude's signal delivery; the class is a\n3566:  \"`py/init!`'s body: the four runtime cells, every builtin class,\n3586:                                 (cond->> (list 'py/make-class nm (or base :py/None))\n3587:                                   (= \"StopIteration\" nm) (list 'py/stop-iteration-class))))\n3588:                             builtin-classes))]\n3597:                             builtin-classes))\n3673:   runtime cells, the builtin classes, functions and method\n3679:                        (mapv second builtin-classes)\n(ns yang.cross-lang-test\n  \"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\n   bottom out in `:application`, and the engine neither knows nor cares which\n   frontend minted a closure. A TypeScript function value is called from\n   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\n   task, one run.\n\n   The seam is explicit published-export composition (8.10.11), owned by\n   `yang.call.conformance`: the donor source is published as a module and\n   run unmodified, its named export is read from the donor runtime's global\n   namespace (`globalThis.ts_fn`, PHP's `phpfn` function) and projected into the caller\n   runtime's namespace under the same name, and the caller source runs\n   unmodified. No call node is rewritten and no foreign `:code` extracted:\n   the caller holds the donor's own function cell, as the identity check\n   (`stored === phpfn`) shows.\n\n   What is pinned as LIMITS (documented expectations, not failures):\n   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\n   PHP null (`:php/null`) is neither JS null nor undefined. Each case runs\n   linked on the three vector VMs, which must agree.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.call.conformance :as xl]))\n\n\n(deftest ts-closure-called-from-php-test\n  (testing \"a number crosses as a number: float in, float out\"\n    (is (= \"4\"\n           (xl/call [:typescript \"globalThis.ts_fn = (x, y) => x + y;\"]\n                    [\"ts_fn\"]\n                    [:php \"<?php echo ts_fn(1.5, 2.5);\"]))))\n  (testing \"the PHP caller sees the result as an ordinary value\"\n    (is (= \"yes\"\n           (xl/call [:typescript \"globalThis.ts_fn = (x, y) => x + y;\"]\n                    [\"ts_fn\"]\n                    [:php \"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\"])))))\n\n\n(deftest php-closure-called-from-ts-test\n  (testing \"TS stores and calls the same PHP function cell it received\"\n    (is (= {:js/out [\"true 5\"], :js/uncaught nil}\n           (xl/call [:php \"<?php function phpfn($a, $b) { return $a + $b; }\"]\n                    [\"phpfn\"]\n                    [:typescript\n                     \"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\"])))))\n\n\n(deftest python-calls-typescript-closure-test\n  (testing \"TS stores and calls the same Python function cell it received\"\n    (is (= {:py/out [\"22\"], :py/exception nil}\n           (xl/call [:typescript\n                     (str \"globalThis.ts_apply = f => { globalThis.stored = f; \"\n                          \"return stored === f ? f(20n) + 1n : -1n; };\")]\n                    [\"ts_apply\"]\n                    [:python \"print(ts_apply(lambda x: x + 1))\\n\"])))))\n\n\n(deftest typescript-calls-python-closure-test\n  (testing \"Python stores and calls the same TS function cell it received\"\n    (is (= {:js/out [\"22n\"], :js/uncaught nil}\n           (xl/call [:python\n                     (str \"def py_apply(f):\\n\"\n                          \"    global stored\\n\"\n                          \"    stored = f\\n\"\n                          \"    return f(20) + 1 if stored is f else -1\")]\n                    [\"py_apply\"]\n                    [:typescript\n                     \"console.log(py_apply(x => x + 1n));\"])))))\n\n\n(deftest python-calls-php-closure-test\n  (testing \"PHP stores and calls the same Python function cell it received\"\n    (is (= {:py/out [\"22\"], :py/exception nil}\n           (xl/call [:php\n                     (str \"<?php function php_apply($f) { global $stored; \"\n                          \"$stored = $f; return $stored === $f ? $f(20) + 1 : -1; }\")]\n                    [\"php_apply\"]\n                    [:python \"print(php_apply(lambda x: x + 1))\\n\"])))))\n\n\n(deftest php-calls-python-closure-test\n  (testing \"Python stores and calls the same PHP function cell it received\"\n    (is (= \"22\"\n           (xl/call [:python\n                     (str \"def py_apply(f):\\n\"\n                          \"    global stored\\n\"\n                          \"    stored = f\\n\"\n                          \"    return f(20) + 1 if stored is f else -1\")]\n                    [\"py_apply\"]\n                    [:php \"<?php echo py_apply(function($x) { return $x + 1; });\"])))))\n\n\n;; yang.clojure <-> TypeScript, both directions. yang.clojure now publishes\n;; its runtime module (`clj`: the run-main entry, the task-local global\n;; namespace and the admission surface, yang.clojure.prelude), so the named\n;; skip is closed: the helper drives a clojure donor or caller like any\n;; other admitted frontend, and the same-cell identity check runs here too.\n\n\n(deftest clojure-closure-called-from-typescript-test\n  (testing \"TS stores and calls the same clojure function cell it received\"\n    ;; Clojure integers are bare exact integers, the value JS spells as a\n    ;; BigInt, so the TS callback adds with `1n` and logs `22n`.\n    (is (= {:js/out [\"true 22n\"], :js/uncaught nil}\n           (xl/call [:clojure \"(defn clj_apply [f] (+ (f 20) 1))\"]\n                    [\"clj_apply\"]\n                    [:typescript\n                     (str \"const stored = clj_apply; \"\n                          \"console.log(stored === clj_apply, stored(x => x + 1n));\")])))))\n\n\n(deftest typescript-closure-called-from-clojure-test\n  (testing \"TS stores and calls the same clojure function cell it received\"\n    (is (= \"22\"\n           (xl/call [:typescript\n                     (str \"globalThis.ts_apply = f => { globalThis.stored = f; \"\n                          \"return stored === f ? f(20n) + 1n : -1n; };\")]\n                    [\"ts_apply\"]\n                    [:clojure \"(ts_apply (fn [x] (+ x 1)))\"])))))\n\n\n(deftest clojure-projection-through-runtime-globals-test\n  (testing \"the projected value is read via clj/global-get inside the caller's run\"\n    ;; `ts_apply` is no top-level definition of the caller, so its read\n    ;; inside `apply-it` reaches the runtime global namespace the helper\n    ;; projected into, not a task-store binding.\n    (is (= \"22\"\n           (xl/call [:typescript\n                     (str \"globalThis.ts_apply = f => { globalThis.stored = f; \"\n                          \"return stored === f ? f(20n) + 1n : -1n; };\")]\n                    [\"ts_apply\"]\n                    [:clojure\n                     \"(defn apply-it [] (ts_apply (fn [x] (+ x 1)))) (apply-it)\"]))))\n  (testing \"a second clj/run-main entry still sees the earlier unit's globals\"\n    (is (= \"42\"\n           (xl/call [:clojure \"(def answer 42)\"]\n                    [\"answer\"]\n                    [:clojure \"(defn get-answer [] answer) (get-answer)\"])))))\n\n\n(deftest clojure-caller-shadows-projected-global-test\n  (testing \"a caller-defined name shadows the projected one\"\n    ;; The caller's own `shared` runs: its definition publishes after the\n    ;; projection, so the runtime global holds the caller's function.\n    (is (= \"21\"\n           (xl/call [:clojure \"(defn shared [x] (+ x 100))\"]\n                    [\"shared\"]\n                    [:clojure \"(defn shared [x] (+ x 1)) (shared 20)\"])))))\n\n\n(deftest clojure-source-cell-ref-map-invocation-test\n  (testing \"a source map {:type :cell-ref} is ordinary invocable data\"\n    ;; The donor's exported function invokes its own source map literal:\n    ;; the map lookup answers 42, where the structural cell test used to\n    ;; dereference the map as a cell and fail the VM.\n    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n           (xl/call [:clojure\n                     \"(defn probe [] ({:type :cell-ref :marker 42} :marker))\"]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"]))))\n  (testing \"a source map with the full forged cell-ref shape is ordinary invocable data\"\n    ;; The map spells every key of an issued reference among its own\n    ;; entries; it is still data, so the lookup answers 42 where key\n    ;; presence alone used to dereference it and fail the VM.\n    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n           (xl/call [:clojure\n                     \"(defn probe [] ({:type :cell-ref :id :customer :seal \\\"wax\\\" :marker 42} :marker))\"]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"]))))\n  (testing \"a full-shape three-entry map with a valid-format 64-char seal is ordinary invocable data\"\n    ;; The exact issued format — three entries, a seal string of the issued\n    ;; length — with an :id the engine's heap never minted: the call site\n    ;; asks the heap (cell/authentic?), the heap does not authenticate the\n    ;; map, and the invocation is the map lookup answering the stored seal\n    ;; string, where the shape gates of the previous rounds routed it to\n    ;; admission and the dereference refused the VM.\n    (is (= {:js/out [(str \"\\\"\" (apply str (repeat 64 \"a\")) \"\\\"\")], :js/uncaught nil}\n           (xl/call [:clojure\n                     (str \"(defn probe [] ({:type :cell-ref :id :some-key \"\n                          \":seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\"} :seal))\")]\n","exit_code":0,"status":"completed"}}
