onor-source] exports [caller-frontend caller-source]]\\n  (let [donor (publish-donor! donor-frontend donor-source)\\n        render (:render (profile caller-frontend))]\\n    (agreed (update-vals (run-program donor (compose donor exports caller-frontend\\n                                                     caller-source))\\n                         render))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yang/typescript/antlr/prelude.cljc | sed -n '1500,1660p;1680,1760p;1840,1880p'; nl -ba src/cljc/yang/typescript/antlr/lower.cljc | sed -n '2155,2205p'; rg -n 'throwStatement|js/throw|yang.call/entry|call-entry' src/cljc/yang/typescript/antlr/{lower,prelude}.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yang/typescript/antlr/prelude.cljc | sed -n '1500,1660p;1680,1760p;1840,1880p'; nl -ba src/cljc/yang/typescript/antlr/lower.cljc | sed -n '2155,2205p'; rg -n 'throwStatement|js/throw|yang.call/entry|call-entry' src/cljc/yang/typescript/antlr/{lower,prelude}.cljc\\\"\",\"aggregated_output\":\"  1500\\t                                (js/str-concat (js/key-text key) {:js/str \\\"'\\\"}))))\\n  1501\\t             (if (= k :string)\\n  1502\\t               (if (if (= key {:js/str \\\"length\\\"})\\n  1503\\t                     true\\n  1504\\t                     (let [i (js/index-key-value key)]\\n  1505\\t                       (if (<= 0 i) (< i (js/str-unit-length base)) false)))\\n  1506\\t                 (js/throw-type-error\\n  1507\\t                   (js/str-concat {:js/str \\\"Cannot delete property '\\\"}\\n  1508\\t                                  (js/str-concat (js/key-text key) {:js/str \\\"'\\\"})))\\n  1509\\t                 true)\\n  1510\\t 