    (run-outcome [(list 'defn 'f [] value) '(f)]))))))\n\n\n(deftest test-common-call-hand-constructed-descriptor\n  (testing \"explicit UAST/profile construction admits a foreign body\"\n    ;; The constructor runs inside the compiled profile's private bindings.\n    ;; No Clojure source map receives admission from its entry spelling.\n    (let [descriptor (#'yang/admit-call-descriptor\n                      (u/sexp->uast\n                        '(assoc {} :foreign/type :function\n                                :yang.call/entry\n\n\n(deftest test-portable-try-outcomes\n  (doseq [lane [:walker :semantic]\n          [form expected]\n          [['(try :ok (catch Exception e :bad)) :ok]\n           ['(try (throw (ex-info \"failure\" {:extra 7}))\n                  (catch Exception e [(.getMessage e) (ex-data e)])) [\"failure\" {:extra 7}]]\n           ['(try (try (throw (ex-info \"inner\" {}))\n                       (catch Exception e (throw (ex-info \"outer\" (ex-data e)))))\n                  (catch Exception e (.getMessage e))) \"outer\"]\n           ['(let [v (try (+ 1 (throw (ex-info \"early\" {})))\n                          (catch Exception e 8))] (inc v)) 9]]]\n    (is (= [:yin.k/ok expected] (run-library [form] library-opts lane 1000000))))\n  (doseq [form '[(try 1 (catch Exception e 2) :ignored)\n                 (try 1 (finally 2))\n                 (try 1 (catch Throwable e 2))\n                 (try 1 (catch Exception e (.getStackTrace e)))]]\n    (is (thrown? clojure.lang.ExceptionInfo\n          (yang/compile-program [form] true library-opts)))))\n\n\n(deftest test-guest-callable-collections-and-threading\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok ['b 2 :absent :k nil 3 {:n 3}]]\n           (run-library\n             '[(let [v '[a b] m {:k 2} s #{:k} k :n]\n                 [(v 1) (m :k) (m :missing :absent) (s :k) (s :missing)\n                  (k {:n 3}) (-> {:n 1} (update :n + 2))])]\n             library-opts lane 1000000))))\n  (is (= [:yin.k/ok :caught]\n         (run-library '[(try (let [v [1]] (v)) (catch Exception e :caught))]))))\n\n\n(deftest test-value-invocation-refusals-are-terminating\n  (testing \"entry-absent callees refuse through the library invoker instead of\n            re-entering the dispatcher; the vector binder only forces the\n            invoker into the library so the routing is actually exercised\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(let [five 5 v [five]] (five 1))]\n                          library-opts lane 1000000))\n          \"a scalar callee terminates as not-callable\")\n      (let [[tag _] (run-library\n                      '[(defn f\n                          [x]\n                          x)\n                        (let [e yang.call/entry v [e]] (e f))]\n  (testing \"the SPL tree and the Error/Exception split\"\n    (is (= \"1,1,1,0,1\"\n           (out (str \"<?php $e = new BadMethodCallException;\"\n                     \" echo $e instanceof BadFunctionCallException ? 1 : 0, ',';\"\n                     \" echo $e instanceof LogicException ? 1 : 0, ',';\"\n                     \" echo $e instanceof Throwable ? 1 : 0, ',';\"\n                     \" echo $e instanceof Error ? 1 : 0, ',';\"\n                     \" echo (new JsonException) instanceof Exception ? 1 : 0;\")))))\n  (testing \"ErrorException and the engine errors extend the right roots\"\n    (is (= \"11\" (out (str \"<?php echo (new ErrorException) instanceof Exception ? 1 : 0;\"\n                          \" echo (new DivisionByZeroError) instanceof Error ? 1 : 0;\"))))))\n\n\n(deftest throw-test\n  (testing \"throw as an expression\"\n    (is (= \"caught\"\n           (out (str \"<?php function f($x) { return $x ?? throw new Exception('caught'); }\"\n                     \" try { f(null); } catch (Exception $e) { echo $e->getMessage(); }\"))))\n    (is (= \"ok\" (out \"<?php $v = null; $r = $v ?? 'ok'; echo $r;\"))))\n  (testing \"throwing a non-Throwable\"\n    (is (= \"Can only throw objects\"\n           (-> (uncaught \"<?php throw 5;\") :message))))\n  (testing \"rethrow keeps the same object\"\n    (is (= \"1\"\n           (out (str \"<?php try { try { throw new Exception('a'); } catch (Exception $e) { throw $e; } }\"\n                     \" catch (Exception $f) { echo $f->getMessage() == 'a' ? 1 : 0; }\"))))))\n\n\n(deftest catch-test\n  (testing \"multi-type catch, optional variable, first match wins\"\n    (is (= \"A\" (out (str \"<?php try { throw new TypeError('t'); }\"\n                         \" catch (RuntimeException | TypeError $e) { echo 'A'; } catch (Error $e) { echo 'B'; }\"))))\n    (is (= \"c\" (out \"<?php try { throw new Exception; } catch (Exception) { echo 'c'; }\")))\n    (is (= \"B\" (out (str \"<?php try { throw new Error; }\"\n                         \" catch (Exception $e) { echo 'A'; } catch (Throwable $e) { echo 'B'; }\")))))\n  (testing \"an unmatched exception propagates out of the function\"\n    (is (= \"outer\"\n           (out (str \"<?php function f() { try { throw new Exception('x'); } catch (TypeError $e) { echo 'no'; } }\"\n                     \" try { f(); } catch (Exception $e) { echo 'outer'; }\")))))\n  (testing \"a leading backslash names the same class\"\n    (is (= \"k\" (out \"<?php try { throw new Exception; } catch (\\\\Exception $e) { echo 'k'; }\")))))\n\n\n(deftest finally-test\n  (testing \"finally runs on every exit and can override a return\"\n    (is (= \"F1\" (out \"<?php function f() { try { return 1; } finally { echo 'F'; } } echo f();\")))\n    (is (= \"2\" (out \"<?php function f() { try { return 1; } finally { return 2; } } echo f();\")))\n    (is (= \"Fa\" (out (str \"<?php try { try { throw new Exception('a'); } finally { echo 'F'; } }\"\n                          \" catch (Exception $e) { echo $e->getMessage(); }\")))))\n  (testing \"an exception from finally replaces the one in flight\"\n    (is (= \"b\" (out (str \"<?php try { try { throw new Exception('a'); } finally { throw new Exception('b'); } }\"\n                         \" catch (Exception $e) { echo $e->getMessage(); }\")))))\n  (testing \"finally after a catch, in a loop with break\"\n    (is (= \"cF\" (out \"<?php try { throw new Exception; } catch (Exception $e) { echo 'c'; } finally { echo 'F'; }\")))\n    (is (= \"F\" (out \"<?php while (true) { try { break; } finally { echo 'F'; } }\")))))\n\n\n(deftest match-test\n  (testing \"strict comparison, several arms, default\"\n    (is (= \"b\" (out \"<?php echo match (2) { 1 => 'a', 2, 3 => 'b', default => 'z' };\")))\n    (is (= \"z\" (out \"<?php echo match ('2') { 2 => 'a', default => 'z' };\"))))\n  (testing \"objects match by identity\"\n    (is (= \"same\"\n           (out (str \"<?php class A {} $a = new A; $b = new A;\"\n                     \" echo match ($a) { $b => 'other', $a => 'same' };\")))))\n  (testing \"no arm: UnhandledMatchError with PHP's text\"\n    (is (= {:class \"UnhandledMatchError\", :message \"Unhandled match case 5\"}\n           (uncaught \"<?php echo match (5) { 1 => 'a' };\")))\n    (is (= {:class \"UnhandledMatchError\", :message \"Unhandled match case 'x'\"}\n           (uncaught \"<?php echo match ('x') { 1 => 'a' };\")))\n    (is (= {:class \"UnhandledMatchError\", :message \"Unhandled match case of type A\"}\ntest/yang/python/antlr/prelude_parity_test.cljc:1760:           (u/sexp->uast '(let [x (%capture)] (if x 1 {:a 1})))))))\n    ;; `nt?` true means the code takes a third argument, the new.target\n    ;; (undefined under a plain call); `js/make-function` keeps the landed\n    ;; five-argument shape for the callers that never construct through\n    ;; new.target.\n    [js/make-function\n     (fn [name length this-mode kind code]\n       (js/make-function-nt name length this-mode kind code false))]\n    [js/make-function-nt\n     (fn [name length this-mode kind code nt?]\n       ;; Ordinary calls enter through yang.call; construction still applies\n       ;; the private code with its explicit new.target below.\n       (let [entry\n             (fn [invocation]\n               (let [callee (get invocation :yang.call/callee)\n                     c (cell/get callee)\n                     k (get c :kind)\n                     receiver (if (data/contains? invocation :yang.call/receiver)\n                                (get invocation :yang.call/receiver)\n                                :js/undefined)]\n                 (if (if (= k :class) true (= k :derived))\n                   (js/throw-type-error\n                     {:js/str \"Class constructor cannot be invoked without 'new'\"})\n                   (let [t (if (= (get c :this-mode) :lexical) :js/undefined receiver)\n                         args (get invocation :yang.call/positional)]\n                     (if (= (get c :nt?) true)\n                       ((get c :code) t args :js/undefined)\n                       ((get c :code) t args))))))]\n         (let [f (cell/new\n                   (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc (assoc {}\n                                                                                                :js/type\n                                                                                                :function)\n                                                                                         :code code)\n                                                                                  :yang.call/entry entry)\n                                                                           :this-mode this-mode)\n                                                                    :name name)\n                                                             :length length)\n                                                      :props (js/om-new))\n                                               :proto js.rt/fn-proto)\n                                        :extensible? true)\n                                 :kind\n                                 kind)\n                          :nt?\n                          nt?))]\n           (do (js/define-own! f\n                               {:js/str \"length\"}\n                               (js/slot (data/float64 length) false false true))\n           (data/into (php/vconj [] prefix) cs2)\n           (php/inc-at cs2 (- i 1)))))]\n    [php/inc-at\n     ;; Perl-style string increment from position i; a non-alphanumeric\n     ;; character stops the carry\n     (fn [cs i]\n       (let [c (get cs i)]\n         (if (if (>= c 97) (<= c 122) false)\n           (if (= c 122) (php/carry cs i 97 97) (assoc cs i (+ c 1)))\n           (if (if (>= c 65) (<= c 90) false)\n             (if (= c 90) (php/carry cs i 65 65) (assoc cs i (+ c 1)))\n             (if (if (>= c 48) (<= c 57) false)\n               (if (= c 57) (php/carry cs i 48 49) (assoc cs i (+ c 1)))\n               cs)))))]\n    [php/inc-string\n     (fn [s]\n       (if (= s \"\")\n         \"1\"\n         (let [r (php/numeric-string s)]\n           (if (php/full-num? r)\n             (php/add (get r 1) 1)\n             (let [cs (data/str->code-points s)]\n               (data/code-points->str (php/inc-at cs (- (data/count cs) 1))))))))]\n    [php/inc\n     (fn [v]\n       (let [k (php/kind v)]\n         (if (php/numk? k) (php/add v 1)\n             (if (= k :null) 1\n                 (if (= k :bool) v\n                     (if (= k :string) (php/inc-string v)\n                         (php/throw-error \"TypeError\" \"Cannot increment this value\")))))))]\n    [php/dec\n     (fn [v]\n       (let [k (php/kind v)]\n         (if (php/numk? k) (php/sub v 1)\n             (if (= k :null)\n               (do (php/warn\n                     2\n                     \"Decrement on type null has no effect, this will change in the next major version of PHP\")\n","exit_code":0,"status":"completed"}}
