apture operand.\\n  1328\\t                       ;; Only our authenticated transfer packet may resume\\n  1329\\t                       ;; here; an invalid captured value explicitly refuses.\\n  1330\\t                       (u/if-node\\n  1331\\t                         (u/app (u/v 'dsg__equal)\\n  1332\\t                                (u/app (u/v 'dsg__get) (u/v escape)\\n  1333\\t                                       (u/lit :clj/escape-token))\\n  1334\\t                                (u/v 'dsg__call_token))\\n  1335\\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\\n  1336\\t                         (outcome-node\\n  1337\\t                           error-tag\\n  1338\\t                           (u/app (u/v 'yang.call/condition)\\n  1339\\t                                  (u/lit :yang.call/invalid-invocation)\\n  1340\\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\\n  1341\\t          public-bridge (u/app (u/lam [escape] activation) u/capture)\\n  1342\\t          bridged (if tail?\\n  1343\\t                    (u/if-node\\n  1344\\t                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\\n  1345\\t                      (u/app (u/v 'yang.call/invoke-with)\\n  1346\\t                             (u/v callee) (u/v arguments) (u/lit [])\\n  1347\\t                             (u/lam [condition] condition->outcome)\\n  1348\\t                             (u/app (u/v 'dsg__assoc) (u/lit {})\\n  1349\\t                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\\n  1350\\t                      public-bridge)\\n  1351\\t                    public-bridge)\\n  1352\\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\\n  1353\\t                              bridged refused)\\n  1354\\t          ;; A callee carrying a call entry is convention territory whether it\\n  1355\\t          ;; admits or forges one, so ad