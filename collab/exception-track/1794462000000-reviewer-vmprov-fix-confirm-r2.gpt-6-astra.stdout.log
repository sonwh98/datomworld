{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' src/cljc/yang/frontend.cljc; sed -n '1,43p' src/cljc/yin/repl/frontends.cljc; sed -n '60,110p' test/yin/vm/provenance_test.cljc; sed -n '230,278p' test/yin/vm/provenance_test.cljc; sed -n '660,925p' src/cljc/yin/vm/macro.cljc; sed -n '1,130p' .agents/skills/code-review-pr/scripts/pr_reviewer.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' src/cljc/yang/frontend.cljc; sed -n '1,43p' src/cljc/yin/repl/frontends.cljc; sed -n '60,110p' test/yin/vm/provenance_test.cljc; sed -n '230,278p' test/yin/vm/provenance_test.cljc; sed -n '660,925p' src/cljc/yin/vm/macro.cljc; sed -n '1,130p' .agents/skills/code-review-pr/scripts/pr_reviewer.py\"","aggregated_output":"(ns yang.frontend\n  \"The language frontend catalog (docs/design/yang.antlr.md section 3,\n   section 8.5.6 slice F1): manifest validation, `install`, and `select`.\n\n   A catalog is a plain immutable value. There is no global registry and\n   no namespace-load registration: `install` returns a new catalog and\n   never changes its argument, so an in-flight request that pinned a\n   catalog snapshot keeps its behavior (section 3.3).\n\n   A manifest is portable data only: no functions, host handles, records,\n   or other host objects anywhere in it (section 3.1). The installed\n   binding is the host's own value, kept beside the manifest and never\n   inspected here; its shape is the composition's (slice F2).\n\n   Revisions of one frontend id coexist (section 3.7): an entry is keyed by\n   `[id revision]`, and a revision is immutable once installed.\n\n   Every refusal is a returned data outcome,\n   `{:status :refused, :reason :yang.frontend/<reason>}` plus its evidence;\n   a selection is `{:status :ok, :manifest m, :binding b}`.\")\n\n\n(def supported-spi\n  \"The SPI revisions (`:yang.frontend/spi`) this catalog admits.\"\n  #{1})\n\n\n(def refusal-reasons\n  \"Every reason a catalog refusal may carry.\"\n  #{:yang.frontend/malformed :yang.frontend/non-portable\n    :yang.frontend/incompatible-spi :yang.frontend/revision-conflict\n    :yang.frontend/unknown :yang.frontend/ambiguous\n    :yang.frontend/incompatible})\n\n\n(defn refused\n  \"A qualified refusal: `{:status :refused, :reason reason}` merged with\n   the evidence `data`.\"\n  ([reason] (refused reason {}))\n  ([reason data]\n   (merge data {:status :refused, :reason reason})))\n\n\n(defn refused?\n  \"True when `res` is a catalog refusal.\"\n  [res]\n  (and (map? res) (= :refused (:status res))))\n\n\n(defn ok?\n  \"True when `res` is a successful selection.\"\n  [res]\n  (and (map? res) (= :ok (:status res))))\n\n\n;; =============================================================================\n;; Manifest validation (sections 3.1, 3.7)\n;; =============================================================================\n\n(defn- non-portable-path\n  \"The path to the first value in `x` that is not portable data, or nil.\n   A set member has no stable position, so its path ends at the set, and a\n   map key's path ends at its map. With several defects the first reported\n   follows host iteration order.\"\n  [x path]\n(ns yin.repl.frontends\n  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n   8.5.6, slice F2): the hand-written Clojure frontend and the ANTLR PHP and\n   Python frontends installed into a `yang.frontend` catalog. This is\n   the only place the REPL composition names a language's namespace;\n   `yin.repl` core steps whatever binding the catalog selects.\n\n   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n   `:input :forms` when the frontend consumes the forms the shell reader\n   already read, else the source text.\"\n  (:require\n    [yang.clojure :as yang.clojure]\n    [yang.frontend :as frontend]\n    #?@(:cljd []\n        :jolt []\n        :default [[yang.php.antlr.cst :as php.antlr.cst]\n                  [yang.php.antlr.lower :as php.antlr.lower]])\n    #?@(:cljd [[yang.python.antlr.repl :as python.antlr.repl]\n               [yang.python.antlr.parser :as python.antlr.parser]\n               [yang.python.antlr.repl-probe :as python.antlr.probe]]\n        :default [[yang.python.antlr.repl :as python.antlr.repl]\n                  [yang.python.antlr.parser :as python.antlr.parser]\n                  [yang.python.antlr.repl-probe :as python.antlr.probe]])\n    [yin.repl :as repl]))\n\n\n(defn- manifest\n  [id language]\n  {:yang.frontend/id id,\n   :yang.frontend/spi 1,\n   :yang.frontend/revision \"legacy-1\",\n   :yang.frontend/language language,\n   :yang.frontend/grammar {:yang.grammar/package \"none\",\n                           :yang.grammar/entries {:module \"program\"},\n                           :yang.grammar/export-profile :yang.cst/v1},\n   :yang.frontend/options-schema :segment/none,\n   :yang.frontend/lowering-profile :segment/legacy,\n   :yang.frontend/runtime-profile :segment/legacy,\n   :yang.frontend/support-profile :segment/legacy})\n\n\n(defn clojure-manifest\n  \"The Clojure frontend's manifest. Its coverage promise changed under\n\n(defn- on-every-vm\n  ([ast] (on-every-vm ast opts))\n  ([ast o]\n   (into {}\n         (map (fn [k]\n                [k (try (run-on k ast (get o :gc-threshold 1000000000))\n                        (catch #?(:clj Exception :cljs :default :cljd Object)\n                               e\n                          [:thrown (ex-data e)]))]))\n         (keys builders))))\n\n\n(defn- every-vm=\n  [expected ast]\n  (doseq [threshold [1 1000000000]\n          [k result] (on-every-vm ast (assoc opts :gc-threshold threshold))]\n    (is (= expected (if (vector? result) result (vm/value result)))\n        (str k \" at gc threshold \" threshold))))\n\n\n(defn- refusal-of\n  [thunk]\n  (try (thunk)\n       nil\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         (or (ex-data e) {}))))\n\n\n(defn- lit [x] {:type :literal, :value x})\n(defn- v [sym] {:type :variable, :name sym})\n(defn- lam [params body] {:type :lambda, :params params, :body body})\n(defn- app [op & args] {:type :application, :operator op, :operands (vec args)})\n(defn- then [a b] (app (lam ['_] b) a))\n(defn- let1 [sym init body] (app (lam [sym] body) init))\n(defn- pair [a b] (app (v 'conj) (app (v 'conj) (lit []) a) b))\n(defn- new-cell [x] (app (v 'cell/new) x))\n(defn- get-cell [c] (app (v 'cell/get) c))\n(defn- set-cell! [c x] (app (v 'cell/set!) c x))\n(defn- new-provenance-cell [value provenance]\n  (app (v 'cell/dsg__new-provenance) value provenance))\n(defn- provenance-cell [candidate]\n  (app (v 'cell/dsg__provenance) candidate))\n\n\n(deftest mint-installs-provenance-atomically-test\n  (every-vm= {:retained 1}\n             (let1 'c (new-provenance-cell (lit 42) (lit {:retained 1}))\n                   (provenance-cell (v 'c)))))\n\n\n            \"the provenance was held as an extra root through the\n             allocation-triggered collection\")))))\n\n\n(deftest dropping-the-wrapper-reclaims-the-cluster-test\n  (doseq [k (keys builders)]\n    (let [[state wrapper-ref payload-ref] (minted-wrapper k)\n          dropped (engine/collect state)]\n      (testing (str k)\n        (is (not (contains? (:heap dropped) (:id wrapper-ref))))\n        (is (not (contains? (:heap dropped) (:id payload-ref)))\n            \"the payload cell reachable only through provenance is collected\n             once its wrapper is\")))))\n\n\n(deftest exported-helper-refuses-the-doors-test\n  (let [prelude (m/prelude identity)\n        variable (get prelude 'yin/variable)\n        lambda (get prelude 'yin/lambda)\n        make-def (get prelude 'yin/make-def)\n        body (m/ast->packet (lit 1))]\n    (testing \"yin/variable - the reference helper\"\n      (doseq [door '[cell/dsg__new-provenance cell/dsg__provenance]]\n        (let [d (refusal-of #(variable door))]\n          (is (= true (:yin.macro/prelude d)) (str door))\n          (is (= door (:name d)) (str door)))))\n    (testing \"yin/lambda - the binder helper\"\n      (let [d (refusal-of #(lambda ['cell/dsg__provenance] body))]\n        (is (= true (:yin.macro/prelude d)))\n        (is (= 'cell/dsg__provenance (:name d)))))\n    (testing \"yin/make-def - the definition-target helper\"\n      (let [name-tree (m/ast->packet (lit 'cell/dsg__provenance))\n            d (refusal-of #(make-def name-tree body))]\n        (is (= true (:yin.macro/prelude d)))\n        (is (= 'cell/dsg__provenance (:name d)))))\n    (testing \"a quoted name is inert data, not a refusal\"\n      (is (nil? (refusal-of\n                  #(m/invoke (m/macro-entry\n                               (m/ast->packet\n                                 (lam [] (app (v 'yin/literal)\n                                              (lit 'cell/dsg__new-provenance))))\n                               vm/ast-contract)\n                             []\n                             (m/make-ctx {:token \"t\"}))))))))\n\n\n(defn- expand-door-batch\n  \"`expand-batch` one input AST under a fresh context whose store holds\n   `macros`, a map of name -> macro-source form (compiled with the Clojure\n   answers the origin of the occurrence at `rel`, a path relative to\n   `p`'s root — the pending expansion origin for a node the macro's\n   code constructed, or, below a child coordinate that retains a\n   passed-through packet, that packet's own origin function. The\n   function rides the packet's metadata, so it is content-addressing\n   invisible and never leaks into a final tree.\"\n  [p f]\n  (vary-meta p assoc ::origin-of f))\n\n\n(defn- origin-of-fn\n  \"The construction origin function packet `p` carries, or nil.\"\n  [p]\n  (::origin-of (meta p)))\n\n\n(def ^:private tracking-meta-keys\n  \"The private provenance entries the expander rides on packet values.\n   They are host functions, so they must never enter a hashed or\n   validated data slot (P1-2); every other metadata entry is the\n   caller's legitimate data and is preserved.\"\n  #{::origin-of})\n\n\n(defn- strip-tracking\n  \"Remove only the private tracking entries, recursively, from `x`:\n   every collection element, map key and value, and every metadata map\n   (including metadata on metadata) is visited, so a packet nested at\n   any depth inside a literal payload loses its host-function origin\n   while legitimate user metadata survives untouched.\"\n  [x]\n  (let [x' (cond (record? x) x\n                 (map? x) (into (empty x)\n                                (map (fn [[k v]]\n                                       [(strip-tracking k)\n                                        (strip-tracking v)]))\n                                x)\n                 (set? x) (into (empty x) (map strip-tracking) x)\n                 (vector? x) (mapv strip-tracking x)\n                 (sequential? x) (with-meta\n                                   (apply list (map strip-tracking x))\n                                   nil)\n                 :else x)\n        m (meta x)]\n    (if m\n      (let [m' (strip-tracking\n                 (apply dissoc m tracking-meta-keys))]\n        (with-meta x' (when-not (and (empty? m') (nil? (meta m'))) m')))\n      x')))\n\n\n(defn- packet-has-application?\n  \"True when packet `p` contains an `:application` occurrence, the only\n   occurrences whose provenance a correspondence ever reads.\"\n  [p]\n  (boolean (and (packet? p)\n                (some #(= :application (row-tag %)) (second p)))))\n\n\n(defn- register-lineage!\n  \"Record packet `p` in the invocation `lineage` (an atom of entries)\n   under the identity of its rows vector. Host decomposition\n   (`first`/`rest`/`get`) hands that very object to reassembly, so the\n   entry is how a rebuilt packet proves it is this packet retained,\n   never a content twin built anew. Returns `p`.\"\n  [lineage p]\n  (when (and lineage (packet? p) (origin-of-fn p))\n    (when-not (some #(identical? (second p) (:rows %)) @lineage)\n      (swap! lineage conj {:root (first p), :rows (second p),\n                           :fn (origin-of-fn p)})))\n  p)\n\n\n(defn- lineage-origin-for\n  \"The retained origin function for candidate packet `c`, or nil when\n   no registered packet unambiguously accounts for it. Content\n   equality alone never suffices — a freshly built twin