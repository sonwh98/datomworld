= :variable (nth row 1)) (nth row 2))))\n   599\t        def-op? (fn [addr] (= 'yin/def (var-name addr)))\n   600\t        literal-sym (fn [addr]\n   601\t                      (let [row (get rows addr)]\n   602\t                        (when (= :literal (nth row 1))\n   603\t                          (let [v (nth row 2)]\n   604\t                            (when (symbol? v) v)))))\n   605\t        check (fn [role sym]\n   606\t                (when (vm/reserved-prefix-name? sym)\n   607\t                  {:rule :reserved-prefix, :role role, :name sym}))]\n   608\t    (some (fn [[_ row]]\n   609\t            (case (nth row 1)\n   610\t              :variable (check :variable (nth row 2))\n   611\t              :lambda (some #(check :binder %) (nth row 2))\n   612\t              (:vm/store-get :vm/store-put) (check :store-key (nth row 2))\n   613\t              :application (when (def-op? (nth row 2))\n   614\t                             (when-let [k (literal-sym (first (nth row 3)))]\n   615\t                               (check :definition-key k)))\n   616\t              nil))\n   617\t          rows)))\n   618\t\n   619\t\n   620\t(defn- packet?\n   621\t  [x]\n   622\t  (and (vector? x) (= 2 (count x)) (jing/segment-address? (first x))\n   623\t       (vector? (second x))))\n   624\t\n   625\t\n   273\t                             (m/make-ctx {:token \"t\"}))))))))\n   274\t\n   275\t\n   276\t(defn- expand-door-batch\n   277\t  \"`expand-batch` one input AST under a fresh context whose store holds\n   278\t   `macros`, a map of name -> macro-source form (compiled with the Clojure\n   279\t   frontend). Returns the `expand-batch` result map.\"\n   280\t  [input-ast macros]\n   281\t  (let [store (into {}\n   282\t                    (map (fn [[nm src]]\n   283\t                           [nm (m/macro-entry\n   284\t                                 (m/ast->packet (yang/compile src))\n   285\t                                 vm/ast-contract)]))\n   286\t                    macros)\n   287\t        cx (m/make-ctx {:token \"t\" :store store})\n   288\t        input (m/ast->packet input-ast)]\n   289\t    (m/expand-batch [:yin.program/batch [input] 0 [] []] cx)))\n   290\t\n   291\t\n   292\t(deftest macro-door-is-refused-at-expansion-test\n   293\t  (testing \"a guest macro returning a quoted door packet as a value is\n   294\t            refused at expansion, so indirect application never mints\"\n   295\t    (let [door (m/ast->packet {:type :variable :name 'cell/dsg__new-provenance})\n   296\t          leak-source (list 'fn [] (list 'quote door))\n   297\t          input (app (app (v 'leak)) (lit 42) (lit {:forged true}))\n   298\t          r (expand-door-batch input (hash-map 'leak leak-source))]\n   299\t      (is (= :error (:status r)))\n   300\t      (is (re-find #\"dsg__new-provenance\" (str (:error r))))))\n   301\t  (testing \"a guest macro assembling yin/def over a door name via\n   302\t            yin/application (skipping yin/make-def) is refused at expansion\"\n   303\t    (let [redefine-source '(fn []\n   304\t                             (yin/application\n   305\t                               (yin/variable (quote yin/def))\n   306\t                               (conj []\n   307\t                                     (yin/literal (quote cell/dsg__provenance))\n   308\t                                     (yin/literal 123))))\n   309\t          input (app (v 'redefine))\n   310\t          r (expand-door-batch input (hash-map 'redefine redefine-source))]\n   311\t      (is (= :error (:status r)))\n   312\t      (is (re-find #\"dsg__provenance\" (str (:error r)))))))\n   313\t\n   314\t\n   315\t(deftest mint-refuses-nil-provenance-test\n   316\t  (doseq [k (keys builders)]\n   317\t    (testing (str k)\n   318\t      (let [q (quiesce (run-on k (new-cell (lit :payload)) 1000000))\n   319\t            d (refusal-of #(engine/handle-effect\n   320\t                             q\n   321\t                          