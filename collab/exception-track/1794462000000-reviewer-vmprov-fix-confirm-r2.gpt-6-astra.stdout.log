.cljc\nindex 80ceccd9..48a09577 100644\n--- a/src/cljc/yin/vm/macro.cljc\n+++ b/src/cljc/yin/vm/macro.cljc\n@@ -580,6 +580,43 @@\n                    {:op op, :name sym})))\n \n \n+(defn- reserved-prefix-defect\n+  \"The first compiler-private (`dsg__`-prefixed) name the macro's output\n+   packet `tree` carries in an executable position, as `{:rule\n+   :reserved-prefix :role r :name s}`, or nil. Covers a `:variable`\n+   reference, a `:lambda` binder, a `:vm/store-get`/`:vm/store-put` key,\n+   and a `yin/def` definition target assembled by application (the\n+   `yin/make-def` bypass). A `:literal` holding a quoted `dsg__` symbol is\n+   inert data and is not a position — only the symbol a definition names.\n+   Legitimate compiler-generated `dsg__` occurrences live in retained\n+   source syntax, never in a macro's output, so they are preserved by the\n+   trusted construction provenance the expander threads separately.\"\n+  [tree]\n+  (let [{:keys [rows]} (packet->row-set tree)\n+        var-name (fn [addr]\n+                   (let [row (get rows addr)]\n+                     (when (= :variable (nth row 1)) (nth row 2))))\n+        def-op? (fn [addr] (= 'yin/def (var-name addr)))\n+        literal-sym (fn [addr]\n+                      (let [row (get rows addr)]\n+                        (when (= :literal (nth row 1))\n+                          (let [v (nth row 2)]\n+                            (when (symbol? v) v)))))\n+        check (fn [role sym]\n+                (when (vm/reserved-prefix-name? sym)\n+                  {:rule :reserved-prefix, :role role, :name sym}))]\n+    (some (fn [[_ row]]\n+            (case (nth row 1)\n+              :variable (check :variable (nth row 2))\n+              :lambda (some #(check :binder %) (nth row 2))\n+              (:vm/store-get :vm/store-put) (check :store-key (nth row 2))\n+              :application (when (def-op? (nth row 2))\n+                             (when-let [k (literal-sym (first (nth row 3)))]\n+                               (check :definition-key k)))\n+              nil))\n+          rows)))\n+\n+\n (defn- packet?\n   [x]\n   (and (vector? x) (= 2 (count x)) (jing/segment-address? (first x))\n@@ -1456,9 +1493,16 @@\n           [(failed st error) address]\n           (if-let [e (valid-tree? tree {:working? true})]\n             [(failed st (invalid (:reason e))) address]\n-            (let [n (count (set (map first (second tree))))]\n-              (if (> n (:max-rows-per-expansion guards))\n+            (let [n (count (set (map first (second tree))))\n+                  rp (reserved-prefix-defect tree)]\n+              (cond\n+                rp\n+                [(failed st (invalid rp)) address]\n+\n+                (> n (:max-rows-per-expansion guards))\n                 [(failed st {:kind :row-guard, :scope :expansion, :rows n}) address]\n+\n+                :else\n                 (let [st' (merge-output st tree)]\n                   (if (::conflict st')\n                     [(failed st (invalid :address-conflict)) address]\ndiff --git a/test/yin/vm/provenance_test.cljc b/test/yin/vm/provenance_test.cljc\nindex 6ebdf862..19471d2e 100644\n--- a/test/yin/vm/provenance_test.cljc\n+++ b/test/yin/vm/provenance_test.cljc\n@@ -9,6 +9,7 @@\n   (:require [yin.vm.semantic.linearize :as sr-linearize]\n             [yin.vm.semantic.derive :as derive]\n             [clojure.test :refer [deftest is testing]]\n+            [yang.clojure :as yang]\n             [yin.vm :as vm]\n             [yin.vm.ast-walker :as walker]\n             [yin.vm.debruijn.register :as rvm]\n@@ -272,13 +273,54 @@\n                              (m/make-ctx {:token \"t\"}))))))))\n \n \n-(deftest macro-cannot-construct-the-mint-door-test\n-  (testing \"a macro body that builds the door as a variable for indirect\n-            application is refused at invocation, not at expansion\"\n-    (let [macro-ast (lam []\n-                         (app (v 'yin/variable)\n-                              (lit 'cell/dsg__new-provenance)))\n-          entry (m/macro-entry (m/ast->packet macro-ast) vm/ast-contract)\n-          d (refusal-of #(m/invoke entry [] (m/make-ctx {:token \"t\"})))]\n-      (is (= :body-error (:kind d)))\n-      (is (re-find #\"dsg__new-provenance\" (str (:message d)))))))\n+(defn- expand-door-batch\n+  \"`expand-batch` one input AST under a fresh context whose store holds\n+   `macros`, a map of name -> macro-source form (compiled with the Clojure\n+   frontend). Returns the `expand-batch` result map.\"\n+  [input-ast macros]\n+  (let [store (into {}\n+                    (map (fn [[nm src]]\n+                           [nm (m/macro-entry\n+                                 (m/ast->packet (yang/compile src))\n+                                 vm/ast-contract)]))\n+                    macros)\n+        cx (m/make-ctx {:token \"t\" :store store})\n+        input (m/ast->packet input-ast)]\n+    (m/expand-batch [:yin.program/batch [input] 0 [] []] cx)))\n+\n+\n+(deftest macro-door-is-refused-at-expansion-test\n+  (testing \"a guest macro returning a quoted door packet as a value is\n+            refused at expansion, so indirect application never mints\"\n+    (let [door (m/ast->packet {:type :variable :name 'cell/dsg__new-provenance})\n+          leak-source (list 'fn [] (list 'quote door))\n+          input (app (app (v 'leak)) (lit 42) (lit {:forged true}))\n+          r (expand-door-batch input (hash-map 'leak leak-source))]\n+      (is (= :error (:status r)))\n+      (is (re-find #\"dsg__new-provenance\" (str (:error r))))))\n+  (testing \"a guest macro assembling yin/def over a door name via\n+            yin/application (skipping yin/make-def) is refused at expansion\"\n+    (let [redefine-source '(fn []\n+                             (yin/application\n+                               (yin/variable (quote yin/def))\n+                               (conj []\n+                                     (yin/literal (quote cell/dsg__provenance))\n