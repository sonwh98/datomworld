========================\n   994\t;; docs/design/yin.vm.code-as-tuples.md §2. One row `[id tag & slots]` per\n   995\t;; distinct node; `id` is `(jing/segment-key [tag & slots])`.\n   996\t\n   997\t(def semantic-bytecode-grammar\n   998\t  \"The Universal AST row-slot table (yin.vm.code-as-tuples.md §2.3):\n   999\t   tag -> ordered `[field kind]` slots, rather than executable bytecode. Position `i` of a\n  1000\t   row body (after the tag) holds the map field named at `i`, so this one\n  1001\t   table drives both projection and reconstruction.\"\n  1002\t  {:literal [[:value :data]],\n  1003\t   :variable [[:name :sym]],\n  1004\t   :lambda [[:params :syms] [:body :node]],\n  1005\t   :application [[:operator :node] [:operands :nodes] [:tail? :bool]],\n  1006\t   :if [[:test :node] [:consequent :node] [:alternate :node]],\n  1007\t   :dao.stream.apply/call [[:op :kw] [:operands :nodes]],\n  1008\t   :vm/gensym [[:prefix :str]],\n  1009\t   :vm/store-get [[:key :key]],\n  1010\t   :vm/store-put [[:key :key] [:val :data]],\n  1011\t   :vm/current-continuation [],\n  1012\t   :vm/park [],\n  1013\t   :vm/resume [[:parked-id :kw] [:val :node]],\n  1014\t   :stream/make [[:buffer :int]],\n  1015\t   :stream/put [[:target :node] [:val :node]],\n  1016\t   :stream/cursor [[:source :node]],\n  1017\t   :stream/next [[:source :node]],\n  1018\t   :stream/close [[:source :node]]})\n  1019\t\n  1020\t\n  1021\t(def ^:private semantic-bytecode-defaults\n  1022\t  \"§2.4 saturation: `[tag field]` -> the default written map→rows. rows→map\n  1023\t   never re-defaults; a nil in one of these slots is a defect.\"\n  1024\t  {[:vm/gensym :prefix] \"id\",\n  1025\t   [:stream/make :buffer] default-stream-capacity,\n","exit_code":0,"status":"completed"}}
