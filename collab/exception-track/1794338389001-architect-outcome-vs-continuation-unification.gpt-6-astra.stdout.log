n  1236\t  (let [bindings (into [] (mapcat (fn [i p] [p (list 'data/nth av-sym i)]) (range) params))\n  1237\t        lowered? (outcomes? env)\n  1238\t        body (if lowered?\n  1239\t               (lower-function-body env macro-env params body-forms)\n  1240\t               (body-expression body-forms))]\n  1241\t    (if (some mentions-recur? body-forms)\n  1242\t      (with-meta (if lowered?\n  1243\t                   (list 'loop bindings body)\n  1244\t                   (list* 'loop bindings body-forms))\n  1245\t        {::fn-loop true})\n  1246\t      (list 'let bindings body))))\n  1247\t\n  1248\t\n  1249\t(defn- av-dispatch\n  1250\t  \"Nested ifs over the argument vector's count, one branch per arity\n  1251\t   {:n count :form branch}. An unmatched count falls through to a\n  1252\t   zero-argument data/count, which the data module refuses with :reason\n  1253\t   :arity; under the outcome model it is an arity error outcome naming\n  1254\t   `fn-name` (or the anonymous fn's `source`) instead.\"\n  1255\t  [env fn-name source arities]\n  1256\t  (let [counts (map :n arities)]\n  1257\t    (when (not= (count counts) (count (set counts)))\n  1258\t      (reject! \"Two arities with the same parameter count\" {:counts (vec counts)}))\n  1259\t    (reduce (fn [else {:keys [n form]}]\n  1260\t              (list 'if\n  1261\t                    (list 'data/content= (list 'data/count av-sym) n)\n  1262\t                    form\n  1263\t                    else))\n  1264\t            (if (outcomes? env) (arity-error-form fn-name source) (list 'data/count))\n  1265\t            (reverse arities))))\n  1266\t\n  1267\t\n  1268\t(defn- check-av-params!\n  1269\t  [params]\n  1270\t  (when-not (vector? params)\n  1271\t    (reject! \"fn parameters must be a vector\" {:params params}))\n  1272\t  (doseq [p params]\n  1273\t    (when (= '& p)\n  1274\t      (reject! \"Variadic fn parameters are not supported\" {:params params}))\n  1275\t    (check-binder! p params)))\n  1276\t\n  1277\t\n  1278\t(defn- outcome-node\n  1279\t  [tag value]\n  1280\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n  1281\t\n  1282\t\n  1283\t(defn- call-entry\n  1284\t  \"The unary public entry, closed over a private argument-vector body.\"\n  1285\t  []\n  1286\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1287\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1288\t        outcome (symbol (str reserved-prefix \"entry_outcome\"))\n  1289\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1290\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1291\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1292\t        binding-error (outcome-node\n  1293\t                        error-tag\n  1294\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1295\t                               (u/lit :yin.k/message)\n  1296\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1297\t                               (u/lit :yin.k/data)\n  1298\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1299\t                                      (u/lit :yang.call/named) named)))\n  1300\t        entry-body (u/let1\n  1301\t                     outcome\n  1302\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\n  1303\t                                (u/app (u/v body) positional)\n  1304\t                                binding-error)\n  1305\t                     (u/if-node (u/app (u/v 'dsg__equal)\n  1306\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\n  1307\t                                       (u/lit ok-tag))\n  1308\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1309\t                                (u/app raise\n  1310\t                                       (u/app (u/v 'yang.call/thrown)\n  1311\t                                              (u/app (u/v 'data/nth)\n  1312\t                                                     (u/v outcome) (u/lit 1))))))\n  1313\t        ;; The private lane forwards the body's outcome in tail position.\n  1314\t        ;; The public entry still converts outcomes to value/raise normally.\n  1315\t        ;; The compiler's token packet - a two-element vector whose first\n  1316\t        ;; element is the compiler-held token - selects the private tail\n  1317\t        ;; lane on the SAME unary entry: no record unwrap, no map lookups.\n  1318\t        ;; A guest cannot forge it: the token is compiler-held and the\n  1319\t        ;; reserved-prefix regime refuses binding or shadowing it. Maps\n  1320\t        ;; keep the ordinary record path. The vector guard is required:\n  1321\t        ;; data/nth refuses non-vectors, and dsg__get reads vectors as\n  1322\t        ;; nil whenever the program defines its own get.\n  1323\t        packet (u/if-node\n  1324\t                 (u/app (u/v 'data/vector?) (u/v invocation))\n  1325\t                 ;; the packet is exactly two elements: the arity guard runs\n  1326\t                 ;; before data/nth so an empty or overlong vector refuses\n  1327\t                 ;; as an outcome instead of a host-side data refusal\n  1328\t                 (u/if-node\n  1329\t                   (u/app (u/v 'dsg__equal)\n  1330\t                          (u/app (u/v 'data/count) (u/v invocation))\n  1331\t                          (u/lit 2))\n  1332\t                   (u/if-node\n  1333\t                     (u/app (u/v 'dsg__equal)\n  1334\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\n  1335\t                            (u/v 'dsg__call_token))\n  1336\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\n  1337\t                     ;; a vector without the compiler-held token is NOT the\n  1338\t                     ;; record path: applying the body here would hand every\n  1339\t                     ;; forged vector the private lane. Refuse explicitly.\n  1340\t                     (u/lit [:yin.k/error\n  1341\t                             {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1342\t                              :yin.k/data {}}]))\n  1343\t                   (u/lit [:yin.k/error\n  1344\t                           {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1345\t                            :yin.k/data {}}]))\n  1346\t                 (u/if-node\n  1347\t                   (u/app (u/v 'dsg__equal)\n  1348\t                          (u/app (u/v 'dsg__get) (u/v invocation)\n  1349\t                                 (u/lit :clj/outcome-token))\n  1350\t                          (u/v 'dsg__call_token))\n  1351\t                   (u/if-node (u/app (u/v 'dsg__empty) named)\n  1352\t                              (u/app (u/v body) positional)\n  1353\t                              binding-error)\n  1354\t                   entry-body))\n  1355\t        entry (u/lam [invocation] packet)]\n  1356\t    (u/lam [body] entry)))\n  1357\t\n  1358\t\n  1359\t(defn- admit-call-descriptor\n  1360\t  \"Admit a descriptor constructed by trusted UAST/profile code. This is not\n  1361\t   a source form: entry-spelled source maps never pass through this constructor.\"\n  1362\t  [descriptor-ast tail?]\n  1363\t  (let [descriptor-name 'dsg__descriptor\n  1364\t        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\n  1365\t                         (u/lit :clj/admission) (u/lit nil))\n  1490\t                                     (u/if-node (u/app (u/v 'dsg__equal)\n  1491\t                                                       (u/app (u/v 'data/count) callee)\n  1492\t                                                       (u/lit 3))\n  1493\t                                                (u/if-node (u/app (u/v 'data/string?) seal)\n  1494\t                                                           (u/if-node (u/app (u/v 'dsg__equal)\n  1495\t                                                                             (u/app (u/v 'data/str-length) seal)\n  1496\t                                                                             (u/lit 64))\n  1497\t                                                                      (u/lit true)\n  1498\t                                                                      (u/lit false))\n  1499\t                                                           (u/lit false))\n  1500\t                                                (u/lit false))\n  1501\t                                     (u/lit false))\n  1502\t                          (u/lit false))\n  1503\t               (u/lit false))))\n  1504\t\n  1505\t\n  1506\t(defn- compile-guest-call\n  1507\t  \"Admit a source operator before common invocation. Only generated UAST\n  1508\t   implementation calls apply private closures directly.\"\n  1509\t  [callee-ast arguments-ast env tail?]\n  1510\t  (if-not (outcomes? env)\n  1511\t    (cond-> (u/app callee-ast arguments-ast)\n  1512\t      tail? (assoc :tail? true))\n  1513\t    (let [callee (symbol (str reserved-prefix \"callee\"))\n  1514\t          arguments (symbol (str reserved-prefix \"arguments\"))\n  1515\t          escape (symbol (str reserved-prefix \"raise_escape\"))\n  1516\t          condition (symbol (str reserved-prefix \"condition\"))\n  1517\t          result (symbol (str reserved-prefix \"call_result\"))\n  1518\t          condition->outcome (u/if-node\n  1519\t                               (u/app (u/v 'dsg__equal)\n  1520\t                                      (u/app (u/v 'dsg__get) (u/v condition)\n  1521\t                                             (u/lit :yang.call/reason))\n  1522\t                                      (u/lit :yang.call/thrown))\n  1523\t                               (outcome-node\n  1524\t                                 error-tag\n  1525\t                                 (u/app (u/v 'dsg__get) (u/v condition)\n  1526\t                                        (u/lit :yang.call/value)))\n  1527\t                               (outcome-node error-tag (u/v condition)))\n  1528\t          raise (u/lam [condition]\n  1529\t                       (assoc (u/app (u/v escape)\n  1530\t                                     (u/app (u/v 'dsg__assoc) (u/lit {})\n  1531\t                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n  1532\t                                            (u/lit :clj/outcome) condition->outcome))\n  1533\t                              :tail? true))\n  1534\t          common-call (u/let1\n  1535\t                        result\n  1536\t                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n  1537\t                               (u/lit []) raise)\n  1538\t                        (outcome-node ok-tag (u/v result)))\n  1539\t          refused (outcome-node\n  1540\t                    error-tag\n  1541\t                    (u/app (u/v 'yang.call/condition)\n  1542\t                           (u/lit :yang.call/not-callable)\n  1543\t                           (u/app (u/v 'dsg__assoc) (u/lit {})\n  1544\t                                  (u/lit :yang.call/callee) (u/v callee))))\n  1545\t          activation (u/if-node\n  1546\t                       (u/app (u/v 'data/callable?) (u/v escape))\n  1547\t                       common-call\n  1548\t                       ;; Applying the escape resumes the capture operand.\n  1549\t                       ;; Only our authenticated transfer packet may resume\n  1550\t                       ;; here; an invalid captured value explicitly refuses.\n  1551\t                       (u/if-node\n  1552\t                         (u/app (u/v 'dsg__equal)\n  1553\t                                (u/app (u/v 'dsg__get) (u/v escape)\n  1554\t                                       (u/lit :clj/escape-token))\n  1555\t                                (u/v 'dsg__call_token))\n  1556\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\n  1557\t                         (outcome-node\n  1558\t                           error-tag\n  1559\t                           (u/app (u/v 'yang.call/condition)\n  1560\t                                  (u/lit :yang.call/invalid-invocation)\n  1561\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\n  1562\t          public-bridge (u/app (u/lam [escape] activation) u/capture)\n  1563\t          bridged (if tail?\n  1564\t                    (u/if-node\n  1565\t                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\n  1566\t                      (u/app (u/v 'yang.call/invoke-with)\n  1567\t                             (u/v callee) (u/v arguments) (u/lit [])\n  1568\t                             (u/lam [condition] condition->outcome)\n  1569\t                             (u/app (u/v 'dsg__assoc) (u/lit {})\n  1570\t                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\n  1571\t                      public-bridge)\n  1572\t                    public-bridge)\n  1573\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n  1574\t                              bridged refused)\n  1575\t          ;; A callee carrying a call entry is convention territory whether it\n  1576\t          ;; admits or forges one, so admission rules it. Everything else is a\n  1577\t          ;; data-side invocation - a collection lookup or a raw closure call -\n  1578\t          ;; and the guest library's invoker owns those semantics. The invoker\n  1579\t          ;; is itself a published descriptor, so it is reached the same way\n  1580\t          ;; any guest callee is; its raise escapes to a capture of this site\n  1581\t          ;; and the resumed pass materializes the error outcome here.\n  1582\t          value-call (u/app\n  1583\t                       (u/lam ['dsg__raise_escape]\n  1584\t                              (u/if-node\n  1585\t                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\n  1586\t                                (u/let1\n  1587\t                                  (symbol (str reserved-prefix \"invoker_result\"))\n  1588\t                                  (u/app (u/v 'yang.call/invoke)\n  1589\t                                         (u/v 'invoke-value)\n  1590\t                                         (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\n  1591\t                                         (u/lit [])\n  1592\t                                         (u/lam [condition]\n  1593\t                                                (assoc (u/app (u/v 'dsg__raise_escape)\n  1594\t                                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n  1595\t                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n  1596\t                                                                     (u/lit :clj/outcome) condition->outcome))\n  1597\t                                                       :tail? true)))\n  1598\t                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \"invoker_result\")))))\n  1599\t                                (u/if-node\n  1600\t                                  (u/app (u/v 'dsg__equal)\n  1601\t                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n  1602\t                                                (u/lit :clj/escape-token))\n  1603\t                                         (u/v 'dsg__call_token))\n  1604\t                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n  1605\t                                  (outcome-node\n  1606\t                                    error-tag\n  1607\t                                    (u/app (u/v 'yang.call/condition)\n  1608\t                                           (u/lit :yang.call/invalid-invocation)\n  1609\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n  1610\t                       u/capture)\n  1611\t          routed (if (::invoker env)\n  1612\t                   (u/if-node\n  1613\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n  1614\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n  1615\t                                           (u/lit true)\n  1616\t                                           ;; the shape is only WHEN to ask (ruling of\n  1617\t                                           ;; record, rule 2): the heap answers\n  1618\t                                           ;; `cell/authentic?`, and an unauthenticated\n  1619\t                                           ;; shape takes ordinary map invocation\n  1620\t                                           (u/if-node (cell-ref-shaped-node (u/v callee))\n  1621\t                                                      (u/app (u/v 'cell/authentic?) (u/v callee))\n  1622\t                                                      (u/lit false)))\n  1623\t                                (u/lit false))\n  1624\t                     admitted\n  1625\t                     value-call)\n  1626\t                   admitted)]\n  1627\t      (cond-> (u/mark-tails (u/let1 callee callee-ast\n  1628\t                                    (u/let1 arguments arguments-ast routed)))\n  1629\t        tail? (assoc :tail? true)))))\n  1630\t\n  1631\t\n  1632\t(defn- compile-apply\n  1633\t  \"(apply f a b coll) as one application of f to the assembled argument\n  1634\t   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n  1635\t   serves a guest closure and an adapted native alike.\"\n  1636\t  [operands env tail? macro-env]\n  1637\t  (when (< (count operands) 2)\n  1638\t    (reject! \"apply takes a function and an argument collection\"\n  1639\t             {:operands (count operands)}))\n  1640\t  (let [[f & more] operands\n2:  \"The register-shaped canonical evaluator: effects, continuations, FFI,\n20:   halted?        ; boolean, true when active continuation has completed\n21:   k              ; continuation, a vector of frames (innermost last) or nil\n28:   parked         ; parked continuations map\n35:   ready-queue    ; vector of runnable continuations\n38:   wait-set       ; vector of continuations waiting on a transport\n52:  \"Materialize control, window, environment and continuation; value is exit-only.\"\n87:(defn- tail-builders\n191:                          args (mapv #(get W %) (nth inst 3)) tail? (nth inst 4)]\n194:                                       frame (when-not tail?\n199:                                          (if tail? K (conj K frame)) remaining))\n207:                                              (if tail? (tail-builders seg pc K)\n214:                              (if tail?\n221:                        :continuation\n222:                        (let [value (engine/continuation-argument args)\n249:                    parked (engine/park-continuation state payload call-id)\n263:              :current-continuation\n265:                    payload (assoc (act-payload seg pc E W K rd (:analysis image)) :type :reified-continuation)]\n266:                (recur machine seg (inc pc) (assoc W rd (values/continuation (:owner machine) payload)) E K remaining))\n268:                        (engine/park-continuation (act-payload seg pc E W K (nth inst 1) (:analysis image)))\n270:              :resume (let [restored (engine/resume-continuation (put-registers machine seg pc W E K)\n303:  (engine/run-loop machine engine/active-continuation? #(vm-hot* % nil)\n379:  (continuation [machine] (:k machine)))\n","exit_code":0,"status":"completed"}}
