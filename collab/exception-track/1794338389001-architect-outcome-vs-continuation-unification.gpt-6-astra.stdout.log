 148\\\\t     thrown transfer invoke invoke-with})\\\\n   149\\\\t\\\\n   150\\\\t\\\\n   151\\\\t(def uast\\\\n   152\\\\t  \\\\\\\"The bundled definitions, in source order and tail marked.\\\\\\\"\\\\n   153\\\\t  (u/mark-tails\\\\n   154\\\\t    (reduce (fn [ast [key form]]\\\\n   155\\\\t              (u/then ast (u/def! key (u/sexp->uast form))))\\\\n   156\\\\t            (u/def! (ffirst definitions)\\\\n   157\\\\t                    (u/sexp->uast (second (first definitions))))\\\\n   158\\\\t            (rest definitions))))\\\\n   159\\\\t\\\\n   160\\\\t\\\\n   161\\\\t(def module-uast\\\\n   162\\\\t  \\\\\\\"The linked module tree built from the same `definitions`.\\\\\\\"\\\\n   163\\\\t  (let [stripped (core/module-definitions \\\\\\\"yang.call\\\\\\\" :yang.call/uninit\\\\n   164\\\\t                                          [] definitions)]\\\\n   165\\\\t    (core/module-tree stripped [])))\\\\n   166\\\\t\\\\n   167\\\\t\\\\n   168\\\\t(def module-exports\\\\n   169\\\\t  \\\\\\\"Public module exports (private helper definitions stay internal).\\\\\\\"\\\\n   170\\\\t  public-exports)\\\\n   171\\\\t\\\\n   172\\\\t\\\\n   173\\\\t(def ^:private module-free-names\\\\n   174\\\\t  (core/free-name-vec module-uast))\\\\n   175\\\\t\\\\n   176\\\\t\\\\n   177\\\\t(defn module-spec\\\\n   178\\\\t  \\\\\\\"The linker module spec for `yang.call` over `registry`.\\\\\\\"\\\\n   179\\\\t  [registry]\\\\n   180\\\\t  (core/module-spec {:module-name module-name\\\\n   181\\\\t                     :ast module-uast\\\\n   182\\\\t                     :exports module-exports\\\\n   183\\\\t                     :requires {}\\\\n   184\\\\t                     :free-names module-free-names\\\\n   185\\\\t                     :registry registry\\\\n   186\\\\t                     :message \\\\\\\"the yang.call module reads an undeclared name\\\\\\\"\\\\n   187\\\\t                     :refusal-ns \\\\\\\"yang.call\\\\\\\"}))\\\\n  2150\\\\t  [env macro-env forms form]\\\\n  2151\\\\t  (when (and (next forms)\\\\n  2152\\\\t             (not (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form))))\\\\n  2153\\\\t             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\\\\n  2154\\\\t    (reject! \\\\\\\"A non-final top-level form that may fail would discard its error outcome\\\\\\\"\\\\n  2155\\\\t             {:form form}))\\\\n  2156\\\\t  form)\\\\n  2157\\\\t\\\\n  2158\\\\t\\\\n  2159\\\\t(defn- lower-top-form\\\\n  2160\\\\t  \\\\\\\"Under the outcome model a top-level expression returns an outcome like a\\\\n  2161\\\\t   function body; definitions keep their own lowering.\\\\\\\"\\\\n  2162\\\\t  [env macro-env form]\\\\n  2163\\\\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\\\\n  2164\\\\t    form\\\\n  2165\\\\t    (lower-function-body env macro-env [] [form])))\\\\n  2166\\\\t\\\\n  2167\\\\t\\\\n  2168\\\\t(defn compile-program\\\\n  2169\\\\t  \\\\\\\"Compile a sequence of Clojure forms into a single Universal AST.\\\\n  2170\\\\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\\\\n  2171\\\\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\\\\n  2172\\\\t   with :macro? true on the lambda; the encoder turns that flag into a\\\\n  2173\\\\t   declaration row and the expander, not this compiler, recognizes calls.\\\\n  2174\\\\t   The three-argument form takes `opts` opting into the argument-vector\\\\n  2175\\\\t   convention (see `program-env`); without it the output is the native one.\\\\\\\"\\\\n  2176\\\\t  ([forms] (compile-program forms true))\\\\n  2177\\\\t  ([forms tail?] (compile-program forms tail? nil))\\\\n  2178\\\\t  ([forms tail? opts]\\\\n  2179\\\\t   (run! check-program-symbols! forms)\\\\n  2180\\\\t   (let [env (program-env forms opts)]\\\\n  2181\\\\t     ;; A discarded definition must not become a lexical binding in the\\\\n  2182\\\\t     ;; following