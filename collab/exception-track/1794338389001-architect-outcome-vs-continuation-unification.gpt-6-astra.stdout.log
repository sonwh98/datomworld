\\\t  \\\\\\\"The cross-language calling gates' shared composition (docs/design/\\\\n     3\\\\t   yang.antlr.md section 8.10.11): a donor program's named export reaches a\\\\n     4\\\\t   caller program by explicit published-export composition only.\\\\n     5\\\\t\\\\n     6\\\\t   A donor is real source of any admitted frontend, lowered unmodified and\\\\n     7\\\\t   published as an ordinary linker module whose one export, `body`, is the\\\\n     8\\\\t   lowered unit. A caller task requires that module, runs its body under the\\\\n     9\\\\t   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\\\\n    10\\\\t   `clj/run-main`), reads each named export from the donor runtime's global\\\\n    11\\\\t   namespace, and projects it into the caller runtime's namespace under the\\\\n    12\\\\t   same name; then the caller source, lowered unmodified, runs under its own\\\\n    13\\\\t   entry. The composition is a sequence of top-level nodes: no call node is\\\\n    14\\\\t   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\\\\n    15\\\\t   inserted, and the projected value is the donor's own callable value\\\\n    16\\\\t   (identity survives).\\\\n    17\\\\t\\\\n    18\\\\t   A callable value is task-local (a function is a cell, and cells are\\\\n    19\\\\t   task-local, section 8.11), so the export is answered as a node evaluated\\\\n    20\\\\t   in the caller's task, never as a host value carried between tasks.\\\\n    21\\\\t   `export-program` answers the donor's export alone as the program's value.\\\\n    22\\\\t\\\\n    23\\\\t   Every program runs linked on the three vector VMs (`semantic`, `stack`,\\\\n    24\\\\t   `register`) over the TypeScript linked harness's content store, where\\\\n    25\\\\t   `yang.call` and `js` already live and `php`, `py` and `clj` are\\\\n    26\\\\t   published beside them. The AST walker is not a backend: its links are\\\\n    27\\\\t   refused until L-b.\\\\\\\"\\\\n    28\\\\t  (:require\\\\n    29\\\\t    [clojure.string :as str]\\\\n    30\\\\t    [yang.clojure :as clj-comp]\\\\n    31\\\\t    [yang.clojure.prelude :as clj-prelude]\\\\n    32\\\\t    [yang.core.module :as core-module]\\\\n    33\\\\t    [yang.core.names :as names]\\\\n    34\\\\t    [yang.core.uast :as u]\\\\n    35\\\\t    [yang.php.antlr.cst :as php-cst]\\\\n    36\\\\t    [yang.php.antlr.lower :as php-lower]\\\\n    37\\\\t    [yang.php.antlr.portable-harness :as php-h]\\\\n    38\\\\t    [yang.php.antlr.prelude :as php-prelude]\\\\n    39\\\\t    [yang.python.antlr.lower :as py-lower]\\\\n    40\\\\t    [yang.python.antlr.parser :as py-parser]\\\\n    41\\\\t    [yang.python.antlr.prelude :as py-prelude]\\\\n    42\\\\t    [yang.python.antlr.render :as py-render]\\\\n    43\\\\t    [yang.typescript.antlr.cst :as ts-cst]\\\\n    44\\\\t    [yang.typescript.antlr.linked-harness :as h]\\\\n    45\\\\t    [yang.typescript.antlr.lower :as ts-lower]\\\\n    46\\\\t    [yang.typescript.antlr.render :as render]\\\\n    47\\\\t    [yin.vm :as vm]))\\\\n    48\\\\t\\\\n    49\\\\t\\\\n    50\\\\t(def ^:private published-php\\\\n    51\\\\t  \\\\\\\"`php` published once into `js`'s content store, pinning the same\\\\n    52\\\\t   `yang.call` revision (as `source-call-test` publishes it).\\\\\\\"\\\\n    53\\\\t  (delay (h/publish-guest-module!\\\\n    54\\\\t           (php-prelude/module-spec (h/registry)\\\\n    55\\\\t                                    (:call-address @h/published)))))\\\\n    56\\\\t\\\\n    57\\\\t\\\\n    58\\\\t(def ^:private published-py\\\\n    59\\\\t  \\\\\\\"`py` published beside `js` and `php`, over the same host registry and\\\\n    60\\\\t   `yang.call` revision.\\\\\\\"\\\\n    61\\\\t  (delay (h/publish-guest-module!\\\\n    62\\\\t           (py-prelude/module-spec (h/registry)\\\\n    63\\\\t                                   (:call-address @h/published)))))\\\\n    64\\\\t\\\\n    65\\\\t\\\\n    66\\\\t(def ^:private published-clj\\\\n    67\\\\t  \\\\\\\"`clj` published beside `js`, `php` and `py`, over the same host registry\\\\n    68\\\\t   and `yang.call` revision.\\\\\\\"\\\\n    69\\\\t  (delay (h/publish-guest-module!\\\\n    70\\\\t           (clj-prelude/module-spec (h/registry)\\\\n    71\\\\t                                    (:call-address @h/published)))))\\\\n    72\\\\t\\\\n    73\\\\t\\\\n    74\\\\t(defn- parse-ok\\\\n    75\\\\t  \\\\\\\"The CST packet of `source` under `parse`, refused unless the parse is ok.\\\\\\\"\\\\n    76\\\\t  [parse source]\\\\n    77\\\\t  (let [pk (parse source)]\\\\n    78\\\\t    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\\\\n    79\\\\t      (throw (ex-info \\\\\\\"donor or caller source does not parse\\\\\\\"\\\\n    80\\\\t                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\\\\n    81\\\\t    pk))\\\\n    82\\\\t\\\\n    83\\\\t\\\\n    84\\\\t(defn- python-export-symbol\\\\n    85\\\\t  [export]\\\\n    86\\\\t  (symbol (str \\\\\\\"xlang.python.export.\\\\\\\" export)))\\\\n    87\\\\t\\\\n    88\\\\t\\\\n    89\\\\t(defn- python-unit\\\\n    90\\\\t  [packet exports]\\\\n    91\\\\t  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\\\\n    92\\\\t         (u/seq-nodes\\\\n    93\\\\t           (concat (map (fn [export]\\\\n    94\\\\t                          (u/sexp->uast\\\\n    95\\\\t                            (list 'py/global-set py-lower/globals-sym\\\\n    96\\\\t                                  {:py/str export} (python-export-symbol export))))\\\\n    97\\\\t                        exports)\\\\n    98\\\\t                   [(py-lower/lower-module-body packet)]))))\\\\n    99\\\\t\\\\n   100\\\\t\\\\n   101\\\\t(def frontends\\\\n   102\\\\t  \\\\\\\"Each admitted frontend's profile, as data:\\\\n   103\\\\t\\\\n   104\\\\t   - `:runtime`, `:address`: the runtime module and its published address;\\\\n   105\\\\t   - `:refusal`: the publication refusal key and reason of its modules;\\\\n   106\\\\t   - `:deps` (optional): pinned requirements beyond the runtime its\\\\n   107\\\\t     lowered units read directly (the clojure unit's `yang.call` reads);\\\\n   108\\\\t   - `:parse`: source text to CST packet;\\\\n   109\\\\t   - `:unit`: packet and projected exports to the lowered unit its\\\\n   110\\\\t     `:run-main` entry takes;\\\\n   111\\\\t   - `:read-export`: export name to the form reading the runtime's global\\\\n   112\\\\t     namespace (JS `globalThis`, PHP's named-function table, Python's main\\\\n   113\\\\t     module dictionary, the clojure runtime's task-local namespace cell);\\\\n   114\\\\t   - `:project`: name and a value form to the form binding the value where\\\\n   115\\\\t     the runtime's source resolves a called name;\\\\n   116\\\\t   - `:render`: the `:run-main` value as test data.\\\\\\\"\\\\n   117\\\\t  {:typescript\\\\n   118\\\\t   {:runtime 'js,\\\\n   119\\\\t    :address #(:address @h/published),\\\\n   120\\\\t    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\\\\n   121\\\\t    :parse #(parse-ok ts-cst/parse-source %),\\\\n   122\\\\t    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\\\\n   123\\\\t    :run-main 'js/run-main,\\\\n   124\\\\t    :read-export (fn [export] (list 'js/global-get {:js/str export})),\\\\n   125\\\\t    :project (fn [name value] (list 'js/define-global! name value)),\\\\n   126\\\\t    :render render/output},\\\\n   127\\\\t   :php\\\\n   128\\\\t   {:runtime 'php,\\\\n   129\\\\t    :address #(:address @published-php),\\\\n   130\\\\t    :refusal [:yang.php/refusal :yang.php/undeclared-free],\\\\n   131\\\\t    :parse #(parse-ok php-cst/parse-source %),\\\\n   132\\\\t    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\\\\n   133\\\\t    :run-main 'php/run-main,\\\\n   134\\\\t    :read-export (fn [export]\\\\n   135\\\\t                   (list 'php/resolve-fn (str/lower-case export) export)),\\\\n   136\\\\t    :project (fn [name value]\\\\n   137\\\\t               (list 'php/declare-function! (str/lower-case name) value)),\\\\n   138\\\\t    :render php-h/render},\\\\n   139\\\\t   :python\\\\n   140\\\\t   {:runtime 'py,\\\\n   141\\\\t    :address #(:address @published-py),\\\\n   142\\\\t    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\\\\n   143\\\\t    :parse #(parse-ok py-parser/parse-source %),\\\\n   144\\\\t    :unit python-unit,\\\\n   145\\\\t    :run-main 'py/run-main,\\\\n   146\\\\t    :read-export (fn [export]\\\\n   147\\\\t                   (list 'py/global-get\\\\n   148\\\\t                         (list 'py/module-dict\\\\n   149\\\\t                               (list 'py/modules-ref {:py/str \\\\\\\"__main__\\\\\\\"}))\\\\n   150\\\\t                         {:py/str export})),\\\\n   151\\\\t    :project (fn [name value]\\\\n   152\\\\t               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\\\\n   153\\\\t    :render py-render/output},\\\\n   154\\\\t   :clojure\\\\n   155\\\\t   {:runtime 'clj,\\\\n   156\\\\t    :address #(:address @published-clj),\\\\n   157\\\\t    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\\\\n   158\\\\t    :deps (fn [] {'yang.call (:call-address @h/published)}),\\\\n   159\\\\t    :parse clj-comp/read-forms,\\\\n   160\\\\t    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\\\\n   161\\\\t    :run-main 'clj/run-main,\\\\n   162\\\\t    :read-export (fn [export] (list 'clj/global-get export)),\\\\n   163\\\\t    :project (fn [name value]\\\\n   164\\\\t               ;; The runtime global namespace is the one binding (as\\\\n   165\\\\t               ;; `js/define-global!` is for a JS caller): `lower-unit`\\\\n   166\\\\t               ;; reads each projected name through `clj/global-get`, so\\\\n   167\\\\t               ;; no task-store binding duplicates it. A caller top-level\\\\n   168\\\\t               ;; definition of the same name publishes after the\\\\n   169\\\\t               ;; projection and shadows it.\\\\n   170\\\\t               (list 'clj/define-global! name value)),\\\\n   171\\\\t    :render clj-comp/output}})\\\\n   172\\\\t\\\\n   173\\\\t\\\\n   174\\\\t(defn- profile\\\\n   175\\\\t  [frontend]\\\\n   176\\\\t  (or (get frontends frontend)\\\\n   177\\\\t      (throw (ex-info \\\\\\\"frontend not admitted\\\\\\\" {:frontend frontend}))))\\\\n   178\\\\t\\\\n   179\\\\t\\\\n   180\\\\t(defn- modules\\\\n   181\\\\t  \\\\\\\"The host registry, admitted by every runtime profile that checks it,\\\\n   182\\\\t   with the clojure guest library's host surface installed beside them.\\\\n   183\\\\t   Donor publication declares free names over this same registry, so a\\\\n   184\\\\t   clojure donor using the guest library (its `kind` and `portable`\\\\n   185\\\\t   hosts) publishes like it runs.\\\\\\\"\\\\n   186\\\\t  []\\\\n   187\\\\t  (clj-prelude/admit (php-prelude/admit (h/registry))))\\\\n   188\\\\t\\\\n   189\\\\t\\\\n   190\\\\t(defn publish-donor!\\\\n   191\\\\t  \\\\\\\"Publish the donor `source` of `frontend` as the module `module` (default\\\\n   192\\\\t   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\\\\n   193\\\\t   Answers `{:frontend :module :address :links}`.\\\\\\\"\\\\n   194\\\\t  ([frontend source]\\\\n   195\\\\t   (publish-donor! frontend source (symbol (str \\\\\\\"xlang.donor.\\\\\\\" (name frontend)))))\\\\n   196\\\\t  ([frontend source module]\\\\n   197\\\\t   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\\\\n   198\\\\t         [refusal-key reason] refusal\\\\n   199\\\\t         spec (core-module/module-spec\\\\n   200\\\\t                refusal-key reason (modules)\\\\n   201\\\\t                {:name module,\\\\n   202\\\\t                 :ast (core-module/module-tree\\\\n   203\\\\t                        [(core-module/require-node runtime)\\\\n   204\\\\t                         (u/def! 'body (unit (parse source) []))]),\\\\n   205\\\\t                 :exports '#{body},\\\\n   206\\\\t                 :runtime-name runtime,\\\\n   207\\\\t                 :runtime-address (address),\\\\n   208\\\\t                 :deps (if deps (deps) {})})\\\\n   209\\\\t         result (h/publish-guest-module! spec)]\\\\n   210\\\\t     {:frontend frontend,\\\\n   211\\\\t      :module module,\\\\n   212\\\\t      :address (:address result),\\\\n   213\\\\t      :links (:links result)})))\\\\n   214\\\\t\\\\n   215\\\\t\\\\n   216\\\\t(defn- runtime-entry\\\\n   217\\\\t  \\\\\\\"Require and initialize each distinct runtime of `frontend-keys`, once.\\\\\\\"\\\\n   218\\\\t  [frontend-keys]\\\\n   219\\\\t  (into [(core-module/require-node 'yang.call)]\\\\n   220\\\\t        (mapcat (fn [runtime]\\\\n   221\\\\t                  [(core-module/require-node runtime)\\\\n   222\\\\t                   (u/sexp->uast (list (symbol (str runtime) \\\\\\\"init!\\\\\\\")))]))\\\\n   223\\\\t        (distinct (map (comp :runtime profile) frontend-keys))))\\\\n   224\\\\t\\\\n   225\\\\t\\\\n   226\\\\t(defn- donor-run\\\\n   227\\\\t  \\\\\\\"The donor module required and its body run under its runtime's entry.\\\\\\\"\\\\n   228\\\\t  [{:keys [frontend module]}]\\\\n   229\\\\t  [(core-module/require-node module)\\\\n   230\\\\t   (u/app (u/v (:run-main (profile frontend)))\\\\n   231\\\\t          (u/v (symbol (str module) \\\\\\\"body\\\\\\\")))])\\\\n   232\\\\t\\\\n   233\\\\t\\\\n   234\\\\t(defn export-program\\\\n   235\\\\t  \\\\\\\"The program whose value is the donor's `export`, read from its runtime's\\\\n   236\\\\t   global namespace after its body ran.\\\\\\\"\\\\n   237\\\\t  [donor export]\\\\n   238\\\\t  (let [{:keys [read-export]} (profile (:frontend donor))]\\\\n   239\\\\t    (u/mark-tails\\\\n   240\\\\t      (u/seq-nodes (concat (runtime-entry [(:frontend donor)])\\\\n   241\\\\t                           (donor-run donor)\\\\n   242\\\\t                           [(u/sexp->uast (read-export export))])))))\\\\n   243\\\\t\\\\n   244\\\\t\\\\n   245\\\\t(defn compose\\\\n   246\\\\t  \\\\\\\"The caller program: the donor's body run, each name of `exports` read\\\\n   247\\\\t   from the donor runtime and projected into `caller-frontend`'s namespace\\\\n   248\\\\t   under the same name, then `caller-source`, lowered unmodified, run under\\\\n   249\\\\t   its runtime's entry. Its value is the caller entry's value.\\\\\\\"\\\\n   250\\\\t  [donor exports caller-frontend caller-source]\\\\n   251\\\\t  (let [{:keys [read-export]} (profile (:frontend donor))\\\\n   252\\\\t        {:keys [project parse unit run-main]} (profile caller-frontend)]\\\\n   253\\\\t    (u/mark-tails\\\\n   254\\\\t      (u/seq-nodes\\\\n   255\\\\t        (concat (runtime-entry [(:frontend donor) caller-frontend])\\\\n   256\\\\t                (donor-run donor)\\\\n   257\\\\t                (map (fn [export]\\\\n   258\\\\t                       (let [value (symbol (str \\\\\\\"xlang.export.\\\\\\\" export))]\\\\n   259\\\\t                         (u/let1 value\\\\n   260\\\\t                                 (u/sexp->uast (read-export export))\\\\n   261\\\\t                                 (u/sexp->uast (project export value)))))\\\\n   262\\\\t                     exports)\\\\n   263\\\\t                [(u/app (u/v run-main) (unit (parse caller-source) exports))])))))\\\\n   264\\\\t\\\\n   265\\\\t\\\\n   266\\\\t(defn link-source\\\\n   267\\\\t  \\\\\\\"The serving composition naming the runtimes and the donor module.\\\\\\\"\\\\n   268\\\\t  [{:keys [module address]}]\\\\n   269\\\\t  (h/source {'yang.call (:call-address @h/published),\\\\n   270\\\\t             'js (:address @h/published),\\\\n   271\\\\t             'php (:address @published-php),\\\\n   272\\\\t             'py (:address @published-py),\\\\n   273\\\\t             'clj (:address @published-clj),\\\\n   274\\\\t             module address}))\\\\n   275\\\\t\\\\n   276\\\\t\\\\n   277\\\\t(defn run-program\\\\n   278\\\\t  \\\\\\\"`{backend value}` of `ast`, linked against `donor`, on each vector VM.\\\\\\\"\\\\n   279\\\\t  [donor ast]\\\\n   280\\\\t  (let [src (link-source donor)]\\\\n     1\\\\t(ns yang.cross-lang-test\\\\n     2\\\\t  \\\\\\\"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\\\\n     3\\\\t   bottom out in `:application`, and the engine neither knows nor cares which\\\\n     4\\\\t   frontend minted a closure. A TypeScript function value is called from\\\\n     5\\\\t   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\\\\n     6\\\\t   task, one run.\\\\n     7\\\\t\\\\n     8\\\\t   The seam is explicit published-export composition (8.10.11), owned by\\\\n     9\\\\t   `yang.call.conformance`: the donor source is published as a module and\\\\n    10\\\\t   run unmodified, its named export is read from the donor runtime's global\\\\n    11\\\\t   namespace (`globalThis.ts_fn`, PHP's `phpfn` function) and projected into the caller\\\\n    12\\\\t   runtime's namespace under the same name, and the caller source runs\\\\n    13\\\\t   unmodified. No call node is rewritten and no foreign `:code` extracted:\\\\n    14\\\\t   the caller holds the donor's own function cell, as the identity check\\\\n    15\\\\t   (`stored === phpfn`) shows.\\\\n    16\\\\t\\\\n    17\\\\t   What is pinned as LIMITS (documented expectations, not failures):\\\\n    18\\\\t   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\\\\n    19\\\\t   PHP null (`:php/null`) is neither JS null nor undefined. Each case runs\\\\n    20\\\\t   linked on the three vector VMs, which must agree.\\\\\\\"\\\\n    21\\\\t  (:require\\\\n    22\\\\t    [clojure.test :refer [deftest is testing]]\\\\n    23\\\\t    [yang.call.conformance :as xl]))\\\\n    24\\\\t\\\\n    25\\\\t\\\\n    26\\\\t(deftest ts-closure-called-from-php-test\\\\n    27\\\\t  (testing \\\\\\\"a number crosses as a number: float in, float out\\\\\\\"\\\\n    28\\\\t    (is (= \\\\\\\"4\\\\\\\"\\\\n    29\\\\t           (xl/call [:typescript \\\\\\\"globalThis.ts_fn = (x, y) => x + y;\\\\\\\"]\\\\n    30\\\\t                    [\\\\\\\"ts_fn\\\\\\\"]\\\\n    31\\\\t                    [:php \\\\\\\"<?php echo ts_fn(1.5, 2.5);\\\\\\\"]))))\\\\n    32\\\\t  (testing \\\\\\\"the PHP caller sees the result as an ordinary value\\\\\\\"\\\\n    33\\\\t    (is (= \\\\\\\"yes\\\\\\\"\\\\n    34\\\\t           (xl/call [:typescript \\\\\\\"globalThis.ts_fn = (x, y) => x + y;\\\\\\\"]\\\\n    35\\\\t                    [\\\\\\\"ts_fn\\\\\\\"]\\\\n    36\\\\t                    [:php \\\\\\\"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\\\\\\\"])))))\\\\n    37\\\\t\\\\n    38\\\\t\\\\n    39\\\\t(deftest php-closure-called-from-ts-test\\\\n    40\\\\t  (testing \\\\\\\"TS stores and calls the same PHP function cell it received\\\\\\\"\\\\n    41\\\\t    (is (= {:js/out [\\\\\\\"true 5\\\\\\\"], :js/uncaught nil}\\\\n    42\\\\t           (xl/call [:php \\\\\\\"<?php function phpfn($a, $b) { return $a + $b; }\\\\\\\"]\\\\n    43\\\\t                    [\\\\\\\"phpfn\\\\\\\"]\\\\n    44\\\\t                    [:typescript\\\\n    45\\\\t                     \\\\\\\"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\\\\\\\"])))))\\\\n    46\\\\t\\\\n    47\\\\t\\\\n    48\\\\t(deftest python-calls-typescript-closure-test\\\\n    49\\\\t  (testing \\\\\\\"TS stores and calls the same Python function cell it received\\\\\\\"\\\\n    50\\\\t    (is (= {:py/out [\\\\\\\"22\\\\\\\"], :py/exception nil}\\\\n    51\\\\t           (xl/call [:typescript\\\\n    52\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n    53\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n    54\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n    55\\\\t                    [:python \\\\\\\"print(ts_apply(lambda x: x + 1))\\\\\\\\n\\\\\\\"])))))\\\\n    56\\\\t\\\\n    57\\\\t\\\\n    58\\\\t(deftest typescript-calls-python-closure-test\\\\n    59\\\\t  (testing \\\\\\\"Python stores and calls the same TS function cell it received\\\\\\\"\\\\n    60\\\\t    (is (= {:js/out [\\\\\\\"22n\\\\\\\"], :js/uncaught nil}\\\\n    61\\\\t           (xl/call [:python\\\\n    62\\\\t                     (str \\\\\\\"def py_apply(f):\\\\\\\\n\\\\\\\"\\\\n    63\\\\t                          \\\\\\\"    global stored\\\\\\\\n\\\\\\\"\\\\n    64\\\\t                          \\\\\\\"    stored = f\\\\\\\\n\\\\\\\"\\\\n    65\\\\t                          \\\\\\\"    return f(20) + 1 if stored is f else -1\\\\\\\")]\\\\n    66\\\\t                    [\\\\\\\"py_apply\\\\\\\"]\\\\n    67\\\\t                    [:typescript\\\\n    68\\\\t                     \\\\\\\"console.log(py_apply(x => x + 1n));\\\\\\\"])))))\\\\n    69\\\\t\\\\n    70\\\\t\\\\n    71\\\\t(deftest python-calls-php-closure-test\\\\n    72\\\\t  (testing \\\\\\\"PHP stores and calls the same Python function cell it received\\\\\\\"\\\\n    73\\\\t    (is (= {:py/out [\\\\\\\"22\\\\\\\"], :py/exception nil}\\\\n    74\\\\t           (xl/call [:php\\\\n    75\\\\t                     (str \\\\\\\"<?php function php_apply($f) { global $stored; \\\\\\\"\\\\n    76\\\\t                          \\\\\\\"$stored = $f; return $stored === $f ? $f(20) + 1 : -1; }\\\\\\\")]\\\\n    77\\\\t                    [\\\\\\\"php_apply\\\\\\\"]\\\\n    78\\\\t                    [:python \\\\\\\"print(php_apply(lambda x: x + 1))\\\\\\\\n\\\\\\\"])))))\\\\n    79\\\\t\\\\n    80\\\\t\\\\n    81\\\\t(deftest php-calls-python-closure-test\\\\n    82\\\\t  (testing \\\\\\\"Python stores and calls the same PHP function cell it received\\\\\\\"\\\\n    83\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n    84\\\\t           (xl/call [:python\\\\n    85\\\\t                     (str \\\\\\\"def py_apply(f):\\\\\\\\n\\\\\\\"\\\\n    86\\\\t                          \\\\\\\"    global stored\\\\\\\\n\\\\\\\"\\\\n    87\\\\t                          \\\\\\\"    stored = f\\\\\\\\n\\\\\\\"\\\\n    88\\\\t                          \\\\\\\"    return f(20) + 1 if stored is f else -1\\\\\\\")]\\\\n    89\\\\t                    [\\\\\\\"py_apply\\\\\\\"]\\\\n    90\\\\t                    [:php \\\\\\\"<?php echo py_apply(function($x) { return $x + 1; });\\\\\\\"])))))\\\\n    91\\\\t\\\\n    92\\\\t\\\\n    93\\\\t;; yang.clojure <-> TypeScript, both directions. yang.clojure now publishes\\\\n    94\\\\t;; its runtime module (`clj`: the run-main entry, the task-local global\\\\n    95\\\\t;; namespace and the admission surface, yang.clojure.prelude), so the named\\\\n    96\\\\t;; skip is closed: the helper drives a clojure donor or caller like any\\\\n    97\\\\t;; other admitted frontend, and the same-cell identity check runs here too.\\\\n    98\\\\t\\\\n    99\\\\t\\\\n   100\\\\t(deftest clojure-closure-called-from-typescript-test\\\\n   101\\\\t  (testing \\\\\\\"TS stores and calls the same clojure function cell it received\\\\\\\"\\\\n   102\\\\t    ;; Clojure integers are bare exact integers, the value JS spells as a\\\\n   103\\\\t    ;; BigInt, so the TS callback adds with `1n` and logs `22n`.\\\\n   104\\\\t    (is (= {:js/out [\\\\\\\"true 22n\\\\\\\"], :js/uncaught nil}\\\\n   105\\\\t           (xl/call [:clojure \\\\\\\"(defn clj_apply [f] (+ (f 20) 1))\\\\\\\"]\\\\n   106\\\\t                    [\\\\\\\"clj_apply\\\\\\\"]\\\\n   107\\\\t                    [:typescript\\\\n   108\\\\t                     (str \\\\\\\"const stored = clj_apply; \\\\\\\"\\\\n   109\\\\t                          \\\\\\\"console.log(stored === clj_apply, stored(x => x + 1n));\\\\\\\")])))))\\\\n   110\\\\t\\\\n   111\\\\t\\\\n   112\\\\t(deftest typescript-closure-called-from-clojure-test\\\\n   113\\\\t  (testing \\\\\\\"TS stores and calls the same clojure function cell it received\\\\\\\"\\\\n   114\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n   115\\\\t           (xl/call [:typescript\\\\n   116\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n   117\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n   118\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n   119\\\\t                    [:clojure \\\\\\\"(ts_apply (fn [x] (+ x 1)))\\\\\\\"])))))\\\\n   120\\\\t\\\\n   121\\\\t\\\\n   122\\\\t(deftest clojure-projection-through-runtime-globals-test\\\\n   123\\\\t  (testing \\\\\\\"the projected value is read via clj/global-get inside the caller's run\\\\\\\"\\\\n   124\\\\t    ;; `ts_apply` is no top-level definition of the caller, so its read\\\\n   125\\\\t    ;; inside `apply-it` reaches the runtime global namespace the helper\\\\n   126\\\\t    ;; projected into, not a task-store binding.\\\\n   127\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n   128\\\\t           (xl/call [:typescript\\\\n   129\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n   130\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n   131\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n   132\\\\t                    [:clojure\\\\n   133\\\\t                     \\\\\\\"(defn apply-it [] (ts_apply (fn [x] (+ x 1)))) (apply-it)\\\\\\\"]))))\\\\n   134\\\\t  (testing \\\\\\\"a second clj/run-main entry still sees the earlier unit's globals\\\\\\\"\\\\n   135\\\\t    (is (= \\\\\\\"42\\\\\\\"\\\\n   136\\\\t           (xl/call [:clojure \\\\\\\"(def answer 42)\\\\\\\"]\\\\n   137\\\\t                    [\\\\\\\"answer\\\\\\\"]\\\\n   138\\\\t                    [:clojure \\\\\\\"(defn get-answer [] answer) (get-answer)\\\\\\\"])))))\\\\n   139\\\\t\\\\n   140\\\\t\\\\n   141\\\\t(deftest clojure-caller-shadows-projected-global-test\\\\n   142\\\\t  (testing \\\\\\\"a caller-defined name shadows the projected one\\\\\\\"\\\\n   143\\\\t    ;; The caller's own `shared` runs: its definition publishes after the\\\\n   144\\\\t    ;; projection, so the runtime global holds the caller's function.\\\\n   145\\\\t    (is (= \\\\\\\"21\\\\\\\"\\\\n   146\\\\t           (xl/call [:clojure \\\\\\\"(defn shared [x] (+ x 100))\\\\\\\"]\\\\n   147\\\\t                    [\\\\\\\"shared\\\\\\\"]\\\\n   148\\\\t                    [:clojure \\\\\\\"(defn shared [x] (+ x 1)) (shared 20)\\\\\\\"])))))\\\\n   149\\\\t\\\\n   150\\\\t\\\\n   151\\\\t(deftest clojure-source-cell-ref-map-invocation-test\\\\n   152\\\\t  (testing \\\\\\\"a source map {:type :cell-ref} is ordinary invocable data\\\\\\\"\\\\n   153\\\\t    ;; The donor's exported function invokes its own source map literal:\\\\n   154\\\\t    ;; the map lookup answers 42, where the structural cell test used to\\\\n   155\\\\t    ;; dereference the map as a cell and fail the VM.\\\\n   156\\\\t    (is (= {:js/out [\\\\\\\"42n\\\\\\\"], :js/uncaught nil}\\\\n   157\\\\t           (xl/call [:clojure\\\\n   158\\\\t                     \\\\\\\"(defn probe [] ({:type :cell-ref :marker 42} :marker))\\\\\\\"]\\\\n   159\\\\t                    [\\\\\\\"probe\\\\\\\"]\\\\n   160\\\\t                    [:typescript \\\\\\\"console.log(probe());\\\\\\\"]))))\\\\n   161\\\\t  (testing \\\\\\\"a source map with the full forged cell-ref shape is ordinary invocable data\\\\\\\"\\\\n   162\\\\t    ;; The map spells every key of an issued reference among its own\\\\n   163\\\\t    ;; entries; it is still data, so the lookup answers 42 where key\\\\n   164\\\\t    ;; presence alone used to dereference it and fail the VM.\\\\n   165\\\\t    (is (= {:js/out [\\\\\\\"42n\\\\\\\"], :js/uncaught nil}\\\\n   166\\\\t           (xl/call [:clojure\\\\n   167\\\\t                     \\\\\\\"(defn probe [] ({:type :cell-ref :id :customer :seal \\\\\\\\\\\\\\\"wax\\\\\\\\\\\\\\\" :marker 42} :marker))\\\\