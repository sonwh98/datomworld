\\n   391\\\\t  [c]\\\\n   392\\\\t  (make-effect :cell/get {:cell c}))\\\\n   393\\\\t\\\\n   394\\\\t\\\\n   395\\\\t(defn set-cell!\\\\n   396\\\\t  [c v]\\\\n   397\\\\t  (make-effect :cell/set! {:cell c, :val v}))\\\\n   398\\\\t\\\\n   399\\\\t\\\\n   400\\\\t(def cell-module\\\\n   401\\\\t  \\\\\\\"The `cell` module definition. Registering it is a composition step.\\\\\\\"\\\\n   402\\\\t  {'new new-cell, 'get get-cell, 'set! set-cell!})\\\\n   403\\\\t\\\\n   404\\\\t\\\\n   405\\\\t(def cell-profiles\\\\n   406\\\\t  \\\\\\\"UCF 7.5.2 profiles for the `cell` module's bindings: each an\\\\n   407\\\\t   `:effectful` pure effect constructor declaring its one effect kind.\\\\\\\"\\\\n   408\\\\t  {'new (vm/primitive-profile 'new :effectful [1] #{:cell/new} :none)\\\\n   409\\\\t   'get (vm/primitive-profile 'get :effectful [1] #{:cell/get} :none)\\\\n   410\\\\t   'set! (vm/primitive-profile 'set! :effectful [2] #{:cell/set!} :none)})\\\\n   411\\\\t\\\\n   412\\\\t\\\\n   413\\\\t(defn register-cell-module\\\\n   414\\\\t  \\\\\\\"Return registry with the `cell` module registered.\\\\\\\"\\\\n   415\\\\t  [registry]\\\\n   416\\\\t  (register-host-module registry 'cell cell-module cell-profiles))\\\\n   417\\\\t\\\\n   418\\\\t\\\\n   419\\\\t;; =============================================================================\\\\n   420\\\\t;; Built-in effect handlers\\\\n  2070\\\\t  \\\\\\\"The compile-time env of one program. Without `opts` it is empty: the\\\\n  2071\\\\t   native path. `{:convention :arg-vector, :native #{symbol}, :macros\\\\n  2072\\\\t   #{symbol}}` opts into the argument-vector convention: `:native` names the\\\\n  2073\\\\t   primitives a bare symbol may call directly (a set, or a map from name to\\\\n  2074\\\\t   its published profile, whose `:yin.k/arities` give an adapter its admitted\\\\n  2075\\\\t   counts), `:macros` the expander-side\\\\n  2076\\\\t   macro names whose calls must stay ordinary applications. The program's\\\\n  2077\\\\t   own top-level definitions are never native. `:outcomes true` adds the\\\\n  2078\\\\t   outcome model (see its section); `:adapters` maps a primitive that\\\\n  2079\\\\t   declares domain failures to the host adapter returning its outcome.\\\\\\\"\\\\n  2080\\\\t  [forms opts]\\\\n  2081\\\\t  (if-not opts\\\\n  2082\\\\t    {}\\\\n  2083\\\\t    (do (when-not (= :arg-vector (:convention opts))\\\\n  2084\\\\t          (reject! \\\\\\\"Unknown compile-program convention\\\\\\\" {:opts opts}))\\\\n  2085\\\\t        (when-let [hit (seq (filter control-heads (:macros opts)))]\\\\n  2086\\\\t          (reject! \\\\\\\"A :macros entry names a compiler form\\\\\\\" {:macros (vec hit)}))\\\\n  2087\\\\t        (let [defined (into #{}\\\\n  2088\\\\t                            (keep (fn [f]\\\\n  2089\\\\t                                    (when (and (seq? f)\\\\n  2090\\\\t                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\\\\n  2091\\\\t                                               (symbol? (second f)))\\\\n  2092\\\\t                                      (strip-symbol-meta (second f)))))\\\\n  2093\\\\t                            forms)\\\\n  2094\\\\t              defined-fns (top-level-defined-fns forms (:macros opts))]\\\\n  2095\\\\t          ;; the compiler emits bare conj and vec (collection literals, apply),\\\\n  2096\\\\t          ;; so a program definition of either would capture them\\\\n  2097\\\\t          (when-let [hit (first (filter #{'conj 'vec} defined))]\\\\n  2098\\\\t            (reject! (str \\\\\\\"Defining \\\\\\\" hit \\\\\\\" would capture the argument-vector constructor\\\\\\\")\\\\n  2099\\\\t                     {:name hit}))\\\\n  2100\\\\t          (cond-> {::convention {:native (set (if (map? (:native opts))\\\\n  2101\\\\t                                                (keys (:native opts))\\\\n  2102\\\\t                                                (:native opts)))\\\\n  2103\\\\t                                 :arities (into {}\\\\n  2104\\\\t                                                (keep (fn [[sym profile]]\\\\n  2105\\\\t                                                        (when-let [a (if (map? profile)\\\\n  2106\\\\t                                                                       (:yin.k/arities profile)\\\\n  2107\\\\t                                                                       profile)]\\\\n  2108\\\\t                                                          [sym a])))\\\\n  2109\\\\t                                                (when (map? (:native opts)) (:native opts)))\\\\n  2110\\\\t                                 :macros (set (:macros opts))}\\\\n   185\\\\t   hosts) publishes like it runs.\\\\\\\"\\\\n   186\\\\t  []\\\\n   187\\\\t  (clj-prelude/admit (php-prelude/admit (h/registry))))\\\\n   188\\\\t\\\\n   189\\\\t\\\\n   190\\\\t(defn publish-donor!\\\\n   191\\\\t  \\\\\\\"Publish the donor `source` of `frontend` as the module `module` (default\\\\n   192\\\\t   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\\\\n   193\\\\t   Answers `{:frontend :module :address :links}`.\\\\\\\"\\\\n   194\\\\t  ([frontend source]\\\\n   195\\\\t   (publish-donor! frontend source (symbol (str \\\\\\\"xlang.donor.\\\\\\\" (name frontend)))))\\\\n   196\\\\t  ([frontend source module]\\\\n   197\\\\t   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\\\\n   198\\\\t         [refusal-key reason] refusal\\\\n   199\\\\t         spec (core-module/module-spec\\\\n   200\\\\t                refusal-key reason (modules)\\\\n   201\\\\t                {:name module,\\\\n   202\\\\t                 :ast (core-module/module-tree\\\\n   203\\\\t                        [(core-module/require-node runtime)\\\\n   204\\\\t                         (u/def! 'body (unit (parse source) []))]),\\\\n   205\\\\t                 :exports '#{body},\\\\n   206\\\\t                 :runtime-name runtime,\\\\n   207\\\\t                 :runtime-address (address),\\\\n   208\\\\t                 :deps (if deps (deps) {})})\\\\n   209\\\\t         result (h/publish-guest-module! spec)]\\\\n   210\\\\t     {:frontend frontend,\\\\n   211\\\\t      :module module,\\\\n   212\\\\t      :address (:address result),\\\\n   213\\\\t      :links (:links result)})))\\\\n   214\\\\t\\\\n   215\\\\t\\\\n   216\\\\t(defn- runtime-entry\\\\n   217\\\\t  \\\\\\\"Require and initialize each distinct runtime of `frontend-keys`, once.\\\\\\\"\\\\n   218\\\\t  [frontend-keys]\\\\n1891:(defn compile-quote\\\\n2025:(defn compile-form\\\\n2168:(defn compile-program\\\\n2422:;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\\\\n2614:    (defn map?\\\\n2683:    (defn reduced\\\\n2686:    (defn reduced?\\\\n2692:    (defn reduce\\\\n2702:    (defn map\\\\n2714:    (defn mapv\\\\n2768:    (defn comp\\\\n2777:    (defn partial\\\\n2846:(defn compile\\\\n2934:    (vector? x) (mapv #(globals-child % names bound) x)\\\\n2974:             :operands (mapv #(publish-to-globals % names bound)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log:34:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_17\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"**I would not adopt the proposed ruling as written.** Separating reference resolution from map lookup is sound. Making the projected-name set the exclusive selector breaks an existing higher-order matrix leg and the written calling contract. The scissor argument also conflates *invalid lookalikes* with *exact copies of valid bearer references*.\\\\n\\\\nI reviewed `f35c65c2` and checked the corresponding calling-contract passages in master. No files changed; no suites run. Behavioral predictions below are architectural deductions, not reported test results.\\\\n\\\\n**1. Problem framing: the impossibility is real, but narrower than stated.**\\\\n\\\\nThere are three distinct cases:\\\\n\\\\n| Value | What can distinguish it? |\\\\n|---|---|\\\\n| A minted reference with a valid seal and live cell | Heap validation |\\\\n| A map with the minted shape but an incorrect seal or nonexistent ID | Heap validation distinguishes it from the first case |\\\\n| A field-identical reconstruction of the first reference | Nothing observing only that value and the same heap can distinguish it |\\\\n\\\\nThe current engine already implements this distinction internally: `authentic-ref?` checks the cell’s membership and recorded seal. It does not check construction history. Consequently, reconstructing the exact valid map produces another usable bearer reference—not a forgery under the existing admission rule. [engine.cljc:331](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:331)\\\\n\\\\nThus:\\\\n\\\\n- **Correct:** shape inspection cannot establish authenticity.\\\\n- **Correct:** neither shape inspection nor authentication can recover different intentions behind two identical values.\\\\n- **Incorrect:** the wrong-seal `:cell-7` exposure is itself the identical-value impossibility. Its seal distinguishes it from a genuine reference when checked against the heap.\\\\n- **Overstated:** option 2 provides “full fidelity.” It fixes invalid lookalikes; it cannot make identical authenticated values behave differently according to their construction histories.\\\\n\\\\nNonces and signed minting marks authenticate possession, not intent: a complete copy includes the nonce or mark. The existing seal is already such an authenticator. [engine.cljc:299](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:299)\\\\n\\\\nProvenance could distinguish occurrences **only by adding another semantic input**: an opaque carrier, tracked occurrence identity, explicit annotation, or provenance propagated through every relevant operation. That costs representation/ABI changes or tracking through parameters, collections, returns, and transport. Serializable provenance remains copyable; preventing copying requires an additional authority or restriction. It also needs reconciliation with the present prohibition on new descriptor seals/runtime provenance registries and the current restrictions on transporting live callables. [yang.antlr.md:3580](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3580), [yang.antlr.md:3826](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3826)\\\\n\\\\nOne further framing correction: **`cell/get` does not run the closure.** It validates and returns cell contents as data. The shared calling helper subsequently extracts the entry and applies it. Keeping those stages distinct strengthens the architectural argument. [engine.cljc:2725](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:2725), [call.cljc:97](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/core/call.cljc:97)\\\\n\\\\n**2. Solution: explicit operations hold; projected-name-only dispatch does not preserve the current language.**\\\\n\\\\nThe decisive existing counterexample is:\\\\n\\\\n```clojure\\\\n(defn clj_apply [f] (+ (f 20) 1))\\\\n```\\\\n\\\\nThe matrix passes a TypeScript closure into this Clojure donor and expects `22n`. Here `f` is a parameter, not a projected name. Moreover, the donor is published with an **empty projection list**. Under the proposed rule, `(f 20)` takes the data path and performs a lookup on the reference map instead of invoking the callback. This is already a required test, not a hypothetical future feature. [cross_lang_test.clj:100](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:100), [conformance.clj:190](/Users/sto/workspace/datomworld-cljrt/test/yang/call/conformance.clj:190)\\\\n\\\\nThe same failure follows for ordinary first-class uses:\\\\n\\\\n```clojure\\\\n(let [f probe] (f 20))\\\\n((identity probe) 20)\\\\n(let [bag {:f probe}] ((:f bag) 20))\\\\n(apply probe [20])\\\\n```\\\\n\\\\nThese are deductions from the proposed rule. They matter because the contract explicitly requires passed, returned, stored, and recursively invoked functions to retain their calling behavior; the compiler also routes `apply` through general guest invocation. [yang.antlr.md:3822](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3822), [yang.antlr.md:4026](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:4026), [clojure.cljc:1418](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1418)\\\\n\\\\nAdditional problems:\\\\n\\\\n- **A projected name is not necessarily cell-backed.** Clojure functions are immutable admitted descriptors, and the convention also allows immutable bound-method descriptors. A projected-name call must select convention invocation, not unconditional `cell/get`. [clojure.cljc:1153](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1153), [yang.antlr.md:3572](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3572)\\\\n- **The projection set declares names, not callable kinds.** The matrix projects ordinary data too: `answer` is exported as `42`. No callable classification accompanies `exports`. [conformance.clj:245](/Users/sto/workspace/datomworld-cljrt/test/yang/call/conformance.clj:245), [cross_lang_test.clj:134](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:134)\\\\n- **Shadowing requires binding resolution, not name membership.** `(let [probe {:marker 42}] (probe :marker))` must resolve the local map. Top-level definitions can also replace projected globals; this is expressly supported and tested. [clojure.cljc:2938](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:2938), [cross_lang_test.clj:141](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:141)\\\\n- **Runtime namespace state can outlive a compilation unit.** Globals persist across `run-main` entries and are mutable through `define-global!`. A frozen name list cannot establish the future value’s interpretation without an additional binding contract. [prelude.cljc:14](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure/prelude.cljc:14), [prelude.cljc:70](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure/prelude.cljc:70)\\\\n\\\\nThe present harness knows the caller’s export names before lowering, so direct calls can be specialized. That does **not** establish knowledge of callback arguments, returned functions, or future namespace updates. Re-entry already appears in the calling contract; arbitrary runtime projection through streams would need an explicit protocol rather than an assumed static set. [conformance.clj:263](/Users/sto/workspace/datomworld-cljrt/test/yang/call/conformance.clj:263), [yang.antlr.md:3822](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3822)\\\\n\\\\nFinally, “data API always answers” needs qualification: map invocation still has arity rules. The existing helper rejects calls without one key and, optionally, a default. [clojure.cljc:2506](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:2506)\\\\n\\\\n**3. Axiom fit: syntax-selected interpretation is compatible, but not uniquely preferred.**\\\\n\\\\nAxiom 2 says an interpreter creates semantics. It does not say interpretation must be decided entirely during lowering or must ignore runtime state. The architectural example explicitly has the evaluator construct CESK state and execute the interpreted stream. [datom.world.md:17](/Users/sto/workspace/datomworld-cljrt/docs/design/datom.world.md:17), [datom.world.md:50](/Users/sto/workspace/datomworld-cljrt/docs/design/datom.world.md:50)\\\\n\\\\nA non-fatal authentication operation can preserve the existing separation:\\\\n\\\\n1. The compiler emits ordinary UAST.\\\\n2. A generic cell effect reports whether a reference authenticates.\\\\n3. Compiled guest code decides whether to invoke a callable or perform a lookup.\\\\n4. The engine remains unaware of Clojure map-call semantics.\\\\n\\\\nThat follows the existing cell-module architecture: its functions construct effects; the engine interprets those effects against VM state. It does not require the compiler to consult a running heap or introduce another evaluator. [module.cljc:378](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/module.cljc:378)\\\\n\\\\nMy assessment:\\\\n\\\\n- **Position-selected APIs:** compatible, provided their semantic restrictions are explicit.\\\\n- **Reserved shape:** also compatible. The philosophy explicitly permits restrictions, although this restriction sacrifices source-map behavior. [datom.world.md:7](/Users/sto/workspace/datomworld-cljrt/docs/design/datom.world.md:7)\\\\n- **Authentication probe:** also compatible, provided it exposes generic reference facts rather than implementing frontend dispatch inside the engine.\\\\n\\\\nThe invariant would weigh against **engine-owned Clojure dispatch**, not against all runtime authentication. The convention already permits eligibility predicates to read explicit runtime metadata and heap state. [yang.antlr.md:3603](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3603)\\\\n\\\\nTherefore I do not accept “option 2 collapses interpretation and execution” as an established architectural objection.\\\\n\\\\n**4. Bag semantics: coherent as a new restriction, incompatible with today’s contract.**\\\\n\\\\n“Reference stored into data becomes data” is misleading under the proposal. Nothing changes on storage: the same reference remains in the bag. What changes is **the operation selected at the eventual call site**. The contract currently says values pass unchanged and aliases retain the same sealed references. [yang.antlr.md:3773](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3773)\\\\n\\\\nEquality can therefore survive while callability fails. Passing an identity assertion is insufficient.\\\\n\\\\nThe matrix checks both: TypeScript’s `stored === phpfn` is immediately followed by `stored(2, 3)`, and several other legs invoke received parameters. Applying the position rule across frontends would break those legs; applying it only to Clojure still breaks the Clojure callback leg above. [cross_lang_test.clj:39](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:39), [cross_lang_test.clj:48](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:48), [cross_lang_test.clj:100](/Users/sto/workspace/datomworld-cljrt/test/yang/cross_lang_test.clj:100)\\\\n\\\\nThe owner can choose a language where received references require explicit invocation syntax. But that would be a **breaking convention/profile revision**, retracting transparent higher-order invocation—not merely documenting an overlooked corner in §8.10. The existing acceptance gate explicitly says “pass, return, store, recurse, and call back.” Master contains the same requirement. [worktree §8.10.11](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:4026), [master §8.10.11](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:4026)\\\\n\\\\n**5. Migration: D2’s packet mechanism survives, but its surrounding dispatch cannot be declared unaffected.**\\\\n\\\\nThe packet mechanism answers a different question: **which entry protocol is being used?** Its exact two-element vector and compiler-token check select the private outcome lane on the existing unary entry. That mechanism need not change to fix cell-reference classification. [clojure.cljc:1090](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1090)\\\\n\\\\nThree reconciliation points remain:\\\\n\\\\n- **Descriptor admission is runtime value inspection.** It reconstructs and compares an opaque witness. Its constructor explicitly says an equal immutable reconstruction is the same value. Thus “never examine the value at runtime” cannot be a universal rule while this mechanism remains. Scope the rule precisely if retaining it. [clojure.cljc:1134](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1134), [clojure.cljc:2311](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:2311)\\\\n- **“Data invocation everywhere else” would also bypass ordinary admitted function descriptors.** Preserve their admission path explicitly. Existing tests require dynamically bound local functions to work and local maps to remain lookups. [clojure_test.clj:2578](/Users/sto/workspace/datomworld-cljrt/test/yang/clojure_test.clj:2578)\\\\n- **Removing only `dsg__cell-ref?` is insufficient.** There is a second shape test in call routing, admission guards around explicit `eligible?`/`invoke`, and shared `_descriptor` dereferencing on `:type :cell-ref`. All relevant entry points need a consistent policy. [clojure.cljc:1245](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1245), [clojure.cljc:1403](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1403), [clojure.cljc:1458](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1458), [call.cljc:23](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/core/call.cljc:23)\\\\n\\\\nThere is also a separate entry-key collision: current routing sends maps containing `:yang.call/entry` to admission, and a regression test requires an unadmitted such map to refuse. Leaving this untouched may be a valid scope decision, but then “ordinary map application always remains data” is still not generally true. [clojure.cljc:1405](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/clojure.cljc:1405), [clojure_test.clj:2600](/Users/sto/workspace/datomworld-cljrt/test/yang/clojure_test.clj:2600)\\\\n\\\\nOther frontend landmines extend beyond call sites:\\\\n\\\\n- TypeScript’s `typeof` path dereferences cell-shaped values before common eligibility; changing only `js/call` leaves that exposure. Member-call lowering also preserves the receiver and must continue doing so. [TS prelude:135](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/typescript/antlr/prelude.cljc:135), [TS lower:1167](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/typescript/antlr/lower.cljc:1167)\\\\n- Python’s call path includes bound-method handling, class instantiation, and common invocation. A universal projected-name switch would bypass these distinctions. [Python prelude:1033](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/python/antlr/prelude.cljc:1033)\\\\n- PHP resolves runtime strings, arrays, closures, and callable objects. These cannot be reduced to a compile-time export-name set. [PHP prelude:4229](/Users/sto/workspace/datomworld-cljrt/src/cljc/yang/php/antlr/prelude.cljc:4229)\\\\n\\\\n**6. Verdict: retain the two operations; reject projected-name-only selection as the default rule.**\\\\n\\\\nGiven the existing first-class calling contract, I would rule for **option 2, with explicit data lookup and a precise bearer-value policy**:\\\\n\\\\n1. **Explicit reference resolution remains strict.** Invalid references refuse through the existing validation boundary. [engine.cljc:354](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/engine.cljc:354)\\\\n2. **Ordinary application recognizes admitted descriptors and authenticated live references at runtime.** Introduce a generic, non-fatal authentication effect—or authenticated read result—using the engine’s existing authentication logic. Invalid cell-shaped maps take ordinary map semantics.\\\\n3. **A valid reference without an admitted callable entry is not callable.** Authentication alone must not authorize execution. The existing genuine-cell-without-entry test already pins that distinction. [clojure_test.clj:2120](/Users/sto/workspace/datomworld-cljrt/test/yang/clojure_test.clj:2120)\\\\n4. **An exact copy of a valid reference retains bearer behavior.** If the program wants its fields as data, it uses explicit lookup. Do not promise construction-history-sensitive behavior for identical values.\\\\n5. **Static specialization is an optimization requiring proof**, including shadowing and higher-order behavior—not a replacement semantic based on projection membership. This matches the convention’s existing fast-path obligation. [yang.antlr.md:3964](/Users/sto/workspace/datomworld-cljrt/docs/design/yang.antlr.md:3964)\\\\n\\\\nThis requires a declared VM API/profile change; the current cell module exposes only `new`, `get`, and `set!`. [module.cljc:400](/Users/sto/workspace/datomworld-cljrt/src/cljc/yin/vm/module.cljc:400)\\\\n\\\\nIf the owner instead requires **every program-reconstructed map, including an exact authenticated copy, to default to lookup**, explicit reference-invocation syntax is a coherent alternative. But then higher-order callers need explicit operation contracts, and §8.10’s transparent invocation promise must change. A projected-name list alone does not supply those contracts.\\\"}}\\n     1\\tCreated-GMT: 2026-11-07 03:30:00 GMT\\n     2\\tCreated-Local: 2026-11-07 10:30:00 +07 (+0700)\\n     3\\tStatus: OWNER-APPROVED 2026-11-07 — \\\"enforce everywhere consistently. this should be a separate track.\\\"\\n     4\\t\\n     5\\t# RULING OF RECORD — the exception track: §8.10.7 enforced uniformly in all four frontends\\n     6\\t\\n     7\\t## The decision\\n     8\\t\\n     9\\tException handling is enforced uniformly across yang.clojure, yang.typescript (js),\\n    10\\tyang.php, and yang.python. Every escaping source exception — from any frontend, through\\n    11\\tany boundary — compiles down to THE SAME continuation: the caller's supplied raise exit\\n    12\\treceiving the §8.10.7 condition\\n    13\\t\\n    14\\t    {:yang.call/reason :yang.call/thrown, :yang.call/value original-thrown-value}\\n    15\\t\\n    16\\tand every receiving runtime implements the §8.10.7 reception rules (1)–(3) as written.\\n    17\\tThis is a SEPARATE TRACK: it does not ride any frontend's ongoing slice; it has its own\\n    18\\tfolder (`collab/exception-track/`), its own rounds, and its own acceptance gate. The four\\n    19\\tfrontend seats cede these exception-fix surfaces to the track's rounds; the track files\\n    20\\tper-frontend results back into each seat's records.\\n    21\\t\\n    22\\t## The uniformity requirements (each is testable)\\n    23\\t\\n    24\\t**R1 — the callee bridge (js, php are non-compliant today).** Every frontend's published\\n    25\\tfunction entry (and closure/higher-order entry) installs the exception bridge: it reads\\n    26\\tthe supplied `:yang.call/raise` and delivers every escaping source exception AND argument\\n    27\\tbinding failure to it as the §8.10.7 condition. No frontend may let an escaping exception\\n    28\\tfollow the host engine's own handler stack (js today, prelude.cljc:1581), and no frontend\\n    29\\tmay return an uncaught error as an ordinary value (php today, prelude.cljc:190/2384).\\n    30\\t\\n    31\\t**R2 — foreign reception (python, php are non-compliant today).** On receiving a thrown\\n    32\\tcondition: a payload valid in the receiving runtime keeps that runtime's ordinary\\n    33\\tcatching and identity behavior; a runtime permitting arbitrary thrown values (js) may\\n    34\\tdeliver the payload raw; a runtime requiring exception objects (python, php) represents a\\n    35\\tforeign payload with its own generated `ForeignException`, retaining the complete\\n    36\\tcondition and original payload — catch-all catches it, typed catches match the LOCAL\\n    37\\thierarchy, never guessed foreign class names. Raising the raw envelope (php:2384) or the\\n    38\\traw payload (python:1034) is non-compliant.\\n    39\\t\\n    40\\t**R3 — protocol failures retain the condition.** `:yang.call/not-callable`,\\n    41\\t`:invalid-invocation`, `:unsupported-binding` map to a documented local exception form\\n    42\\tretaining the complete original condition, so an unchanged rethrow can forward it. A fresh\\n    43\\tlocal error containing only rendered text (js:1627, python:1046) is non-compliant.\\n    44\\t\\n    45\\t**R4 — clojure unifies.** The internal outcome-token channel\\n    46\\t(clojure.cljc:1110/1486) may remain an optimization ONLY with a proof of equivalence at\\n    47\\tevery boundary; absent that proof it unifies onto the raise-exit path. Clojure's `try`\\n    48\\trejection of `finally` and its single-catch restriction are source-semantics decisions\\n    49\\tTHIS RULING DOES NOT CHANGE — R4 is about the continuation, not clojure's catch surface.\\n    50\\t\\n    51\\t**R5 — no new shape-routing.** Nothing in the track may route on the condition map's\\n    52\\tshape beyond the §8.10.7 contract; a lookalike map stays ordinary data (the cell-ref\\n    53\\truling's rule, restated). No synthesized engine-effect exception values.\\n    54\\t\\n    55\\t## What the audit establishes (the baseline)\\n    56\\t\\n    57\\tThe gpt-6.1-sol audit (collab/yang-python/1794900000000, verdict DIVERGENT, HEAD\\n    58\\te9a0b430) is the track's baseline evidence: python hooks the raise exit (R1 compliant);\\n    59\\tjs and php lack the bridge (R1); python and php lack ForeignException (R2); js and python\\n    60\\tlose protocol conditions (R3); clojure has the private channel (R4). Zero cross-language\\n    61\\t§8.10.7 legs exist in the conformance kit today.\\n    62\\t\\n    63\\t## Acceptance gate\\n    64\\t\\n    65\\tThe conformance kit (`test/yang/call/conformance.clj`) grows exception legs — the\\n    66\\t§8.10.11 exception row as acceptance: binding failures, arbitrary foreign thrown data,\\n    67\\tcatch-all/typed catches, unchanged rethrow, finally replacement, protocol-error rethrow,\\n    68\\tcondition-shaped thrown maps staying data, A→B→A propagation with identity and cleanup\\n    69\\torder, and the stored-ForeignException rethrown-from-another-activation case. The track\\n    70\\tis DONE when every admitted pair passes those legs with real source on both sides, and\\n    71\\tthe divergences R1–R4 are each closed by a focused test pinning the compliant behavior.\\n    72\\t\\n    73\\t## Sequencing\\n    74\\t\\n    75\\tArchitect review of this ruling, then an engineer mob review, then per-frontend fix\\n    76\\trounds (smallest first: R3 js/python, R1 php, R2 python/php, R4 clojure), the conformance\\n    77\\tlegs landing alongside the fixes they gate. The known-gaps row for this track is filed\\n    78\\tfrom the audit's divergence list.\\n    79\\t\\n    80\\t— filed by the yang.python orchestrator seat on the owner's instruction\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n1155:collab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:55:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_27\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba docs/design/yang.antlr.md | sed -n '3854,3941p'; nl -ba docs/design/yang.antlr.md | sed -n '4054,4082p'; nl -ba test/yang/call/conformance.clj | sed -n '18,32p'; nl -ba test/yang/call/conformance.clj | sed -n '277,316p'; nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '4076,4096p'; nl -ba src/cljc/yang/php/antlr/lower.cljc | sed -n '3590,3658p'\\\"\",\"aggregated_output\":\"  3854\\tmap as the **payload of a new condition**; its shape is never evidence\\n  3855\\tthat it is already a condition to forward. No engine-effect value is\\n  3856\\tsynthesized.\\n  3857\\t\\n  3858\\tProtocol failures use qualified reasons such as\\n  3859\\t`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\\n  3860\\t`:yang.call/unsupported-binding`, with plain evidence. The caller maps\\n  3861\\tthem to a documented local exception form retaining the complete\\n  3862\\toriginal condition. Callee argument-binding failures retain the actual\\n  3863\\tcallee exception under `:yang.call/thrown`. These reasons do not extend\\n  3864\\t`dao.stream`'s outcome algebra.\\n  3865\\t\\n  3866\\tThe receiving caller interprets an escaping exception as follows:\\n  3867\\t\\n  3868\\t1. A payload valid as an exception in its own runtime retains that\\n  3869\\t   runtime's ordinary catching and identity behavior.\\n  3870\\t2. A runtime permitting arbitrary thrown values, such as JavaScript,\\n  3871\\t   may deliver the original payload directly.\\n  3872\\t3. A runtime requiring exception objects, such as Python or PHP,\\n  3873\\t   represents an otherwise foreign payload with its own\\n  3874\\t   `ForeignException`, retaining the complete condition and original\\n  3875\\t   payload. Catch-all catches this local object. Typed source catches\\n  3876\\t   match its local hierarchy, never guessed foreign class names.\\n  3877\\t\\n  3878\\t`ForeignException` is a proposed prelude-owned type, not a VM type.\\n  3879\\tUnchanged rethrow propagates the original condition without adding\\n  3880\\twrappers. Raising a new exception creates a new condition. Crossing back\\n  3881\\tinto a runtime recognizing the original exception restores its original\\n  3882\\ttype and identity. Formatting a foreign payload must not implicitly\\n  3883\\tinvoke a foreign method.\\n  3884\\t\\n  3885\\tThe runtime associates its generated wrapper's identity with the retained\\n  3886\\tcondition for the wrapper's entire lifetime, separate from source-writable\\n  3887\\tattributes. The association normally lives in private wrapper-cell\\n  3888\\tcontents, or an equivalent task-owned identity structure with the same\\n  3889\\tlifetime. It survives storing or returning the wrapper after the creating\\n  3890\\tcall/catch activation has ended, and remains recoverable when that same\\n  3891\\twrapper is rethrown in another activation. Temporary catch state alone is\\n  3892\\tinsufficient. Reachability/reclamation must retain the condition and its\\n  3893\\tpayload while the wrapper is live, without an ambient registry.\\n  3894\\t\\n  3895\\tThe runtime must not detect wrappers or unwrap arbitrary maps by their\\n  3896\\tkey names. JavaScript may expose raw payloads for\\n  3897\\t`:yang.call/thrown`; its local exception for a protocol failure must still\\n  3898\\tretain that failure's qualified condition. Rethrowing the same generated\\n  3899\\texception forwards that complete condition, including protocol reasons;\\n  3900\\tthrowing an unrelated value creates a new `:yang.call/thrown` condition.\\n  3901\\tSaved activation state refers to this identity-owned association; exiting\\n  3902\\tor restoring a catch does not destroy it.\\n  3903\\t\\n  3904\\tVM application/custody defects and host implementation failures remain\\n  3905\\toperational failures. Do not catch them broadly and relabel them as\\n  3906\\tsource exceptions. Existing explicit stream/module refusals keep their\\n  3907\\tsource mappings under the relevant profiles.\\n  3908\\t\\n  3909\\t#### 8.10.8 Cleanup, re-entry, and suspension\\n  3910\\t\\n  3911\\tEach activation establishes its own exception bridge and saves its\\n  3912\\tcallee runtime's dynamic context. Binding, body, and exit run under that\\n  3913\\tbridge. Before invoking the caller's raise exit, let source catches and\\n  3914\\tcleanup complete and restore saved handler/depth/frame state. Normal\\n  3915\\treturn restores it too. A source `finally` replacing a pending return\\n  3916\\tor exception does so before common propagation under its own rules.\\n  3917\\t\\n  3918\\tIn A-to-B-to-A calls, the innermost activation must not jump to an older\\n  3919\\tA handler past B. Its entry bridge is the boundary: inner A cleanup\\n  3920\\tprecedes B cleanup, which precedes outer A handling. Every activation\\n  3921\\towns its saved state and raise exit, without a single current-foreign-\\n  3922\\thandler cell or ambient dispatcher. Unchanged rethrow preserves the\\n  3923\\tinner exception as specified in section 8.10.7.\\n  3924\\t\\n  3925\\tCleanup runs once per actual exit. Resuming a suspended VM transition\\n  3926\\tmust not repeat parameter binding, argument evaluation, defaults,\\n  3927\\treference acquisition, or completed cleanup. The record, continuations,\\n  3928\\tand explicit runtime state use the existing continuation machinery and\\n  3929\\tits admission restrictions.\\n  3930\\t\\n  3931\\tA generator or asynchronous function returns its source-defined object.\\n  3932\\tSuspension on a stream effect keeps the activation; it is not a new\\n  3933\\tcall. A later generator resume or scheduled job has a new activation and\\n  3934\\tvalid bridge, never the raise exit of a call that already returned.\\n  3935\\tUnrestricted continuation escape across foreign frames is not implicitly\\n  3936\\tsupported: a claiming profile must define and test restoration and\\n  3937\\treference lifetimes for every crossed frame.\\n  3938\\t\\n  3939\\tInvoking a function-valued argument is internal Yin computation.\\n  3940\\tHost-initiated callbacks remain stream events under\\n  3941\\t`datom.world.abi.md`; this convention adds no host callback facility.\\n  4054\\t  writeback. Source-required side effects from evaluating arguments still\\n  4055\\t  occur; rejection must not erase them. Compatible profiles prove\\n  4056\\t  mutation, aliasing, cleanup, and suspension behavior.\\n  4057\\t- **Exceptions:** cover binding failures, arbitrary foreign thrown data,\\n  4058\\t  catch-all/typed catches, unchanged rethrow, replacement in `finally`,\\n  4059\\t  protocol-error rethrow, condition-shaped thrown maps, and A-to-B-to-A\\n  4060\\t  propagation. Assert original exception identity and cleanup order,\\n  4061\\t  not only rendered text. Store/return a generated `ForeignException`,\\n  4062\\t  finish its creating activation, then rethrow it from another activation\\n  4063\\t  and assert recovery of the original condition and payload identity.\\n  4064\\t- **Context lifetime:** repeated success/raise/success, cross-runtime\\n  4065\\t  recursion, and stream suspension/resume restore handler/depth/frame\\n  4066\\t  state and perform arguments/cleanup exactly once. Entry boilerplate\\n  4067\\t  must not double-count source recursion or tracing activations.\\n  4068\\t- **Publication/custody:** bundled/linked forms agree; two importing\\n  4069\\t  tasks have independent state. Existing gates still refuse foreign-task\\n  4070\\t  cells, forged refs, host functions, and inadmissible continuations.\\n  4071\\t- **Portability:** execute portable packet-to-UAST fixtures on JVM,\\n  4072\\t  Node, and Dart over the four VMs wherever existing contracts admit\\n  4073\\t  the program. JVM-only parsers may supply checked-in CST fixtures;\\n  4074\\t  parser availability is distinct from calling conformance.\\n  4075\\t\\n  4076\\tReport callable kinds, binding/value extensions, actual host/VM\\n  4077\\tcoverage as an explicit host-by-VM matrix, refusals, and remaining gaps\\n  4078\\tper frontend revision. A scalar example or common UAST grammar alone\\n  4079\\tdoes not establish conformance.\\n  4080\\t\\n  4081\\t#### 8.10.12 Cell-reference call routing and authenticity\\n  4082\\t\\n    18\\t   A callable value is task-local (a function is a cell, and cells are\\n    19\\t   task-local, section 8.11), so the export is answered as a node evaluated\\n    20\\t   in the caller's task, never as a host value carried between tasks.\\n    21\\t   `export-program` answers the donor's export alone as the program's value.\\n    22\\t\\n    23\\t   Every program runs linked on the three vector VMs (`semantic`, `stack`,\\n    24\\t   `register`) over the TypeScript linked harness's content store, where\\n    25\\t   `yang.call` and `js` already live and `php`, `py` and `clj` are\\n    26\\t   published beside them. The AST walker is not a backend: its links are\\n    27\\t   refused until L-b.\\\"\\n    28\\t  (:require\\n    29\\t    [clojure.string :as str]\\n    30\\t    [yang.clojure :as clj-comp]\\n    31\\t    [yang.clojure.prelude :as clj-prelude]\\n    32\\t    [yang.core.module :as core-module]\\n   277\\t(defn run-program\\n   278\\t  \\\"`{backend value}` of `ast`, linked against `donor`, on each vector VM.\\\"\\n   279\\t  [donor ast]\\n   280\\t  (let [src (link-source donor)]\\n   281\\t    (into (sorted-map)\\n   282\\t          (map (fn [backend]\\n   283\\t                 [backend\\n   284\\t                  (vm/value (h/run-linked backend ast {:modules (modules),\\n   285\\t                                                       :link-source src}))]))\\n   286\\t          (keys h/backends))))\\n   287\\t\\n   288\\t\\n   289\\t(defn agreed\\n   290\\t  \\\"The one value every backend of `results` answered, else\\n   291\\t   `{:disagreement results}`.\\\"\\n   292\\t  [results]\\n   293\\t  (let [vs (set (vals results))]\\n   294\\t    (if (= 1 (count vs)) (first vs) {:disagreement results})))\\n   295\\t\\n   296\\t\\n   297\\t(defn call\\n   298\\t  \\\"Publish the donor `[frontend source]`, compose its `exports` into the\\n   299\\t   caller `[frontend source]`, run it on each vector VM and answer the\\n   300\\t   caller's rendered value when every backend agrees (else\\n   301\\t   `{:disagreement {backend rendered}}`).\\\"\\n   302\\t  [[donor-frontend donor-source] exports [caller-frontend caller-source]]\\n   303\\t  (let [donor (publish-donor! donor-frontend donor-source)\\n   304\\t        render (:render (profile caller-frontend))]\\n   305\\t    (agreed (update-vals (run-program donor (compose donor exports caller-frontend\\n   306\\t                                                     caller-source))\\n   307\\t                         render))))\\n  4076\\t       (if (= (php/kind v) :obj)\\n  4077\\t         (if (= (get v :php/type) :closure)\\n  4078\\t           (= lc \\\"closure\\\")\\n  4079\\t           (php/class-is? (if (nil? (get v :php/obj))\\n  4080\\t                            (get v :class)\\n  4081\\t                            (get (cell/get (get v :php/obj)) :class))\\n  4082\\t                          lc))\\n  4083\\t         false))]\\n  4084\\t    [php/throwable? (fn [v] (php/instance-of v \\\"throwable\\\"))]\\n  4085\\t    [php/throw-value\\n  4086\\t     (fn [v]\\n  4087\\t       (if (php/throwable? v)\\n  4088\\t         (php/raise (php/addref v))\\n  4089\\t         (php/throw-error \\\"Error\\\" \\\"Can only throw objects\\\")))]\\n  4090\\t    [php/match-repr\\n  4091\\t     (fn [v]\\n  4092\\t       (let [k (php/kind v)]\\n  4093\\t         (if (= k :int) (integer/format v)\\n  4094\\t             (if (= k :string) (data/str-concat \\\"'\\\" v \\\"'\\\")\\n  4095\\t                 (if (= k :bool) (if v \\\"true\\\" \\\"false\\\")\\n  4096\\t                     (if (= k :null) \\\"NULL\\\"\\n  3590\\t    \\\"ifStatement\\\" (lower-if ctx n)\\n  3591\\t    \\\"whileStatement\\\" (lower-while ctx n)\\n  3592\\t    \\\"doWhileStatement\\\" (lower-do-while ctx n)\\n  3593\\t    \\\"forStatement\\\" (lower-for ctx n)\\n  3594\\t    \\\"foreachStatement\\\" (lower-foreach ctx n)\\n  3595\\t    \\\"switchStatement\\\" (lower-switch ctx n)\\n  3596\\t    \\\"breakStatement\\\" (lower-escape ctx n :break)\\n  3597\\t    \\\"continueStatement\\\" (lower-escape ctx n :continue)\\n  3598\\t    \\\"returnStatement\\\" (lower-return ctx n)\\n  3599\\t    \\\"tryCatchFinally\\\" (lower-try ctx n)\\n  3600\\t    \\\"throwStatement\\\" (app* 'php/throw-value (lower ctx (first (core/rules ctx n \\\"expression\\\"))))\\n  3601\\t    \\\"staticVariableStatement\\\" (lower-static ctx n)\\n  3602\\t    \\\"globalStatement\\\" (lower-global ctx n)\\n  3603\\t    \\\"unsetStatement\\\" (lower-unset ctx n (core/rules ctx (first (core/rules ctx n \\\"chainList\\\")) \\\"chain\\\"))\\n  3604\\t    \\\"functionDeclaration\\\" (lower-function ctx n)\\n  3605\\t    \\\"constant\\\" (lower-constant ctx n)\\n  3606\\t    \\\"arrayCreation\\\" (lower-array ctx n)\\n  3607\\t    (\\\"classDeclaration\\\" \\\"enumDeclaration\\\") (lower-class ctx n)\\n  3608\\t    \\\"declareStatement\\\" (lower-declare ctx n)\\n  3609\\t    (core/default-arm diagnostic-ns \\\"PHP\\\" unsupported-rules n)))\\n  3610\\t\\n  3611\\t\\n  3612\\t;; =============================================================================\\n  3613\\t;; Packets\\n  3614\\t;; =============================================================================\\n  3615\\t\\n  3616\\t(defn- hoisted?\\n  3617\\t  \\\"True for a top-level statement that is an unconditional function\\n  3618\\t   declaration: PHP declares it before the unit's first statement runs.\\\"\\n  3619\\t  [ctx item]\\n  3620\\t  (p/rule? (rule-head ctx item) \\\"functionDeclaration\\\"))\\n  3621\\t\\n  3622\\t\\n  3623\\t(defn- declared-functions\\n  3624\\t  \\\"Every function the unit declares: lower-cased fully qualified name to the\\n  3625\\t   vector of its by-reference parameter positions.\\\"\\n  3626\\t  [ctx]\\n  3627\\t  (letfn [(refs\\n  3628\\t            [n]\\n  3629\\t            (let [fps (core/rules ctx (first (core/rules ctx n \\\"formalParameterList\\\"))\\n  3630\\t                                  \\\"formalParameter\\\")]\\n  3631\\t              (vec (keep-indexed (fn [i fp] (when (some #(p/token? % \\\"&\\\") (core/kids ctx fp)) i))\\n  3632\\t                                 fps))))\\n  3633\\t          (walk\\n  3634\\t            [ictx n]\\n  3635\\t            (into (if (p/rule? n \\\"functionDeclaration\\\")\\n  3636\\t                    {(str/lower-case (ns-prefixed ictx (function-written ctx n))) (refs n)}\\n  3637\\t                    {})\\n  3638\\t                  (mapcat #(walk ictx %))\\n  3639\\t                  (core/rule-kids ctx n)))]\\n  3640\\t    (into {} (mapcat #(walk (item-ctx ctx %) %)) (:items ctx))))\\n  3641\\t\\n  3642\\t\\n  3643\\t(def entry-path\\n  3644\\t  \\\"The entry unit's declared path when the composition names none.\\\"\\n  3645\\t  \\\"main.php\\\")\\n  3646\\t\\n  3647\\t\\n  3648\\t(defn- context\\n  3649\\t  ([packet] (context packet {}))\\n  3650\\t  ([packet {:keys [path linked?], :or {path entry-path}}]\\n  3651\\t   (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\\n  3652\\t         ctx {:pk pk,\\n  3653\\t              :analysis (scope/analyze pk),\\n  3654\\t              :loops [],\\n  3655\\t              :unit {:path path},\\n  3656\\t              :linked? (boolean linked?),\\n  3657\\t              :warnings (atom [])}\\n  3658\\t         ctx (merge ctx (unit-layout ctx))]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n1156:collab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:56:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_28\",\"type\":\"agent_message\",\"text\":\"**ACCEPT WITH AMENDMENTS.** The central decision matches §8.10.7, but the ruling needs corrections to its scope, coverage, sequencing, and completion gate.\\n\\nReviewed the ruling and the audit’s last agent message against `/Users/sto/workspace/datomworld-f12`, HEAD `e9a0b430`. The ruling and audit files were read from the main workspace because they are absent from f12. No files edited; no tests run. Behavioral findings below are static deductions.\\n\\n1. **[P1] Explicitly assign R3 to all four frontends.**\\n\\n   The audit’s third divergence includes Clojure and PHP, but the ruling’s baseline summary and sequencing reduce it to JS/Python.\\n\\n   Clojure receives a protocol failure as whole-condition catch data at [clojure.cljc:1306](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1306), then public escape unconditionally wraps that data in `:yang.call/thrown` at [1088](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1088). Retention alone therefore does not preserve the original reason.\\n\\n   PHP constructs a fresh `Error` for `not-callable` and raises other envelopes directly at [prelude.cljc:2384](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2384). The same problem exists in `call-with-binding-profile` and `call-named`. R2’s treatment of *thrown* conditions does not automatically fix those protocol failures.\\n\\n   **Amendment:** explicitly include PHP and Clojure reception **and outbound unchanged rethrow** under R3. Use the fully qualified keywords `:yang.call/invalid-invocation` and `:yang.call/unsupported-binding`; the unqualified spellings currently printed in R3 are different keywords.\\n\\n2. **[P1] Make retained-condition forwarding and activation lifetime explicit requirements.**\\n\\n   R2 summarizes reception rules (1)–(3), but those are only part of §8.10.7. The remaining requirements include:\\n\\n   - Unchanged rethrow forwards the complete original condition without another wrapper.\\n   - A fresh exception creates a new condition.\\n   - Returning to the originating runtime restores original type and identity.\\n   - Retention belongs to the generated exception’s identity for its entire lifetime, outside source-writable attributes and without an ambient registry.\\n   - Formatting foreign payloads must not invoke foreign methods implicitly.\\n\\n   These are explicit [design requirements](/Users/sto/workspace/datomworld-f12/docs/design/yang.antlr.md:3878), not optional implementation details. The saved-wrapper acceptance case covers part of this, but does not by itself test attribute tampering, reclamation/reachability, or formatting.\\n\\n   Also incorporate [§8.10.8](/Users/sto/workspace/datomworld-f12/docs/design/yang.antlr.md:3911): establish the bridge before binding; complete cleanup and restore handler/depth/frame state before transferring; restore state on normal return; preserve exactly-once behavior across suspension. Later generator resumes must not reuse a raise exit belonging to a completed call.\\n\\n   This matters even for Python’s existing bridge: [prelude.cljc:912](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:912) always constructs a new thrown condition. Adding retained wrappers at reception without changing egress will still nest wrappers or lose protocol reasons.\\n\\n3. **[P1] Correct the sequencing; PHP bridge and reception changes must land together.**\\n\\n   The proposed order omits **R1 JS entirely**. R3 JS cannot establish cross-boundary rethrow while JS entries still ignore the supplied raise exit.\\n\\n   More immediately, **R1 PHP before R2 PHP risks breaking existing PHP-to-PHP catches**. After the bridge is installed, an escaping local Throwable will reach `php/call` inside a condition envelope. Today that helper raises the envelope itself. Local typed catches then receive a map instead of the original Throwable; explicit rethrow rejects non-Throwable values at [prelude.cljc:4085](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:4085).\\n\\n   A workable order is:\\n\\n   - Specify retained-condition provenance and add focused failing fixtures.\\n   - Land JS R1 with R3 reception/egress.\\n   - Land PHP R1 with R2 and R3 reception/egress as one coherent round, including Closure entries and all three call helpers.\\n   - Land Python R2/R3 with the corresponding egress change.\\n   - Complete Clojure R3/R4, including any retained fast-path proof.\\n\\n   JS and Python work can proceed independently once the contract is fixed. Clojure need not precede the others, but Clojure-containing pairs cannot be declared conformant before its protocol-rethrow gap closes. “R3 first” is safe as preparatory work; it is insufficient as a completed semantic fix.\\n\\n4. **[P1] The stated acceptance gate is necessary but insufficient.**\\n\\n   The shared kit is a JVM `.clj` harness running linked programs on **semantic, stack, and register** VMs. It explicitly excludes the AST walker’s unsupported linked path. See [conformance.clj:23](/Users/sto/workspace/datomworld-f12/test/yang/call/conformance.clj:23) and [run-program](/Users/sto/workspace/datomworld-f12/test/yang/call/conformance.clj:277).\\n\\n   Amend the completion gate to require:\\n\\n   - **An explicit directed pair matrix.** Four admitted frontends imply twelve cross-language directions, including Clojure↔PHP and Clojure↔Python, plus local regressions. Derive this from admission data rather than whichever tests happen to exist.\\n   - **Callable-kind coverage.** Named functions alone do not prove Closure/higher-order entries, supported methods, callable objects, or builtins comply.\\n   - **Context-lifetime cases:** success→raise→success, re-entry, suspension/resume, and exactly-once binding/cleanup.\\n   - **Host-by-VM results:** JVM, Node, and Dart across all admitted VM paths, with explicit refusals. Use portable parser-produced fixtures where necessary. Test bundled AST-walker paths where admitted; do not require unsupported linked execution.\\n   - **Bundled/linked parity and task isolation**, preserving existing custody refusals.\\n   - **Guest identity assertions before rendering.** Equal rendered messages are not identity evidence.\\n\\n   These follow the adjacent [context, publication, and portability acceptance rows](/Users/sto/workspace/datomworld-f12/docs/design/yang.antlr.md:4064). Adding exception tests only to the current kit would leave Node, Dart, and admitted fourth-VM execution unproved.\\n\\n5. **[P2] Resolve wording that otherwise overreaches or contradicts the design.**\\n\\n   - “Every escaping source exception … receiving `:yang.call/thrown`” needs an exception for **unchanged rethrows of retained protocol failures**. Those must preserve their original qualified reason. State the displayed envelope rule for **fresh source exceptions**.\\n   - Scope “through any boundary” to admitted guest-call boundaries. VM/custody defects and host implementation failures remain operational failures; no broad host catch-and-relabel is authorized. [Design:3904](/Users/sto/workspace/datomworld-f12/docs/design/yang.antlr.md:3904)\\n   - R2’s “raw payload … is non-compliant” must say **otherwise foreign payload**. Delivering an already-valid local exception raw is required by reception rule (1).\\n   - “Every admitted pair passes those legs” needs applicability rules. JS has no typed-catch syntax; Clojure’s admitted surface rejects `finally`. Exercise cleanup in the participating frontend that supports it and preserve Clojure’s rejection tests.\\n   - R5 should distinguish a **returned** condition-shaped map, which is normal data, from a **thrown** condition-shaped map, which is the payload of a fresh condition.\\n   - R4 is consistent with the design’s permission for proven fast paths. Do not interpret “same continuation” as requiring identical internal lowering. Conversely, one exception test does not prove the full evaluation/binding/effects/suspension/identity equivalence required by §8.10.9.\\n\\n6. **[P2] Correct the citation-backed descriptions; the underlying locations mostly check out.**\\n\\n   | Checked locations | Result |\\n   |---|---|\\n   | JS [1581](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1581), [1627](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1627) | Confirmed: entry directly applies private code without reading raise; reception extracts thrown payloads and discards protocol conditions when constructing TypeErrors. |\\n   | PHP [190](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:190), [2264](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2264), [2384](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2384), [4217](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:4217) | Confirmed: empty-stack raise returns normally; named placement/body lack a bridge; reception raises envelopes; Closure entry drops the supplied exit and delegates through `php/call`. |\\n   | Python [886–912](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:886), [1034](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:1034), [1046](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:1046) | Confirmed: binding and body are protected; thrown reception raises raw payloads; protocol reception constructs a generic TypeError. |\\n   | Clojure [904](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:904), [1088](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1088), [1110](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1110), [1486](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1486) | Confirmed: error outcomes, public wrapping, authenticated private entry lane, and intra-unit fast routing. |\\n\\n   The substantive citation error is the ruling’s description of JS as following the **“host engine’s own handler stack.”** It follows the **guest JS runtime’s continuation-backed handler stack** in `js.rt/ctx`; see [js/throw and js/try](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1704). The audit correctly makes this distinction.\\n\\n   Two anchors should also be tightened: PHP `2384` demonstrates envelope reception, while `190` demonstrates normal return on an empty handler stack. Clojure `1110` is the packet-length guard; `1115` and `1125–1133` show the actual private branches. These are imprecise anchors, not evidence that the private-channel claim is false.\\n\\nAll five requirements can be pinned, with the following focused evidence:\\n\\n| Requirement | Focused test |\\n|---|---|\\n| **R1** | Invoke a real lowered entry with a recording, non-returning raise exit. Trigger a body exception and binding/default failure; assert exact payload identity, one transfer, and no normal return. Repeat for Closure/higher-order entries. |\\n| **R2** | Foreign payload → local catch-all/typed catch → unchanged rethrow → origin. Assert local hierarchy, original identity, saved-wrapper lifetime, and replacement behavior. |\\n| **R3** | Exercise all three qualified reasons in each frontend; catch and rethrow the generated exception across another activation. Assert the entire condition, including evidence, survives. Use boundary fixtures for malformed invocations that valid source cannot naturally construct. |\\n| **R4** | Compare public and authenticated private paths for caught/uncaught throws, protocol rethrow, binding failures, and higher-order re-entry. Preserve source-surface rejection tests; supply broader equivalence evidence if retaining the optimization. |\\n| **R5** | Return and throw exact condition lookalikes, including runtime-built maps; forge wrapper-looking attributes. Assert ordinary return or a fresh thrown payload, never unauthorized condition forwarding. |\\n\\nThe audit’s divergence list is substantially represented, but **Clojure/PHP protocol rethrow, JS bridge scheduling, and the broader completion evidence need explicit ownership before this is reliable as a ruling of record.**\"}}\n1368:  2728\t                      The unary-entry token-packet lane (D2) with the final arity guard\n1524:surface (single catch, no `finally`) is a source-semantics decision this ruling does not\n1538:Completed-GMT: 2026-11-10 17:35:19 GMT\n1541:**Ruling: (B).** The entry-absent library value path produces a `:yang.call/thrown` condition whose value is the `:yang.call/not-callable` map:\n1563:Completed-GMT: 2026-11-10 17:35:19 GMT\n1566:**Ruling: (B).** The entry-absent library value path produces a `:yang.call/thrown` condition whose value is the `:yang.call/not-callable` map:\n","exit_code":0,"status":"completed"}}
