ery\\\\n  2949\\\\t   definition at module level); the runtime global namespace is the\\\\n  2950\\\\t   linked unit's definition table instead, as a Python module body\\\\n  2951\\\\t   writes its dictionary. Lexically bound names, quoted literals and\\\\n  2952\\\\t   macro definitions keep their store shape: a macro is not a runtime\\\\n  2953\\\\t   value.\\\\\\\"\\\\n  2954\\\\t  [node names bound]\\\\n  2955\\\\t  (case (:type node)\\\\n  2956\\\\t    :literal node\\\\n  2957\\\\t    :vm/current-continuation node\\\\n  2958\\\\t    :variable (if (and (contains? names (:name node))\\\\n  2959\\\\t                       (not (contains? bound (:name node))))\\\\n  2960\\\\t                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\\\\n  2961\\\\t                node)\\\\n  2962\\\\t    :lambda (assoc node :body (publish-to-globals (:body node) names\\\\n  2963\\\\t                                                  (into bound (:params node))))\\\\n  2964\\\\t    :application\\\\n  2965\\\\t    (if (and (= 'yin/def (get-in node [:operator :name]))\\\\n  2966\\\\t             (= 2 (count (:operands node)))\\\\n  2967\\\\t             (= :literal (:type (first (:operands node))))\\\\n  2968\\\\t             (contains? names (:value (first (:operands node)))))\\\\n  2969\\\\t      (u/app (u/v 'clj/define-global!)\\\\n  2970\\\\t             (u/lit (str (:value (first (:operands node)))))\\\\n  2971\\\\t             (publish-to-globals (second (:operands node)) names bound))\\\\n  2972\\\\t      (assoc node\\\\n  2973\\\\t             :operator (publish-to-globals (:operator node) names bound)\\\\n  2974\\\\t             :operands (mapv #(publish-to-globals % names bound)\\\\n  2975\\\\t                             (:operands node))))\\\\n  2976\\\\t    :if (cond-> node\\\\n  2977\\\\t          (contains? node :test)\\\\n  2978\\\\t          (assoc :test (publish-to-globals (:test node) names bound))\\\\n  2979\\\\t          (contains? node :consequent)\\\\n  2980\\\\t          (assoc :consequent (publish-to-globals (:consequent node) names bound))\\\\n  2981\\\\t          (contains? node :alternate)\\\\n  2982\\\\t          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\\\\n  2983\\\\t    (reduce (fn [n k]\\\\n  2984\\\\t              (let [v (get n k)]\\\\n  2985\\\\t                (if (or (and (map? v) (contains? v :type)) (vector? v))\\\\n  2986\\\\t                  (assoc n k (globals-child v names bound))\\\\n  2987\\\\t                  n)))\\\\n  2988\\\\t            node (keys node))))\\\\n  2989\\\\t\\\\n  2990\\\\t\\\\n  2991\\\\t(defn lower-unit\\\\n  2992\\\\t  \\\\\\\"The `clj/run-main` entry's unit for the top-level source `forms`: one\\\\n  2993\\\\t   thunk whose call runs the program — `forms` plus the definitions of\\\\n  2994\\\\t   the guest library they need, compiled unmodified under `unit-opts`\\\\n  2995\\\\t   and published to the runtime global namespace by\\\\n  2996\\\\t   `publish-to-globals` — so the helper's export projection can read\\\\n  2997\\\\t   each top-level definition. The two-argument form also takes the\\\\n  2998\\\\t   projected `exports` (names the composition already bound in the\\\\n  2999\\\\t   runtime global namespace): their free reads publish the same way, so\\\\n  3000\\\\t   the projection is the caller's binding for them. The program's own\\\\n  3001\\\\t   `yang.call` call sites need no free-name declaration: the convention\\\\n  3002\\\\t   preamble `compile-program` emits defines those names locally, and\\\\n  3003\\\\t   the donor publication pins the `yang.call` module for the qualified\\\\n  3004\\\\t   reads that remain.\\\\\\\"\\\\n  3005\\\\t  ([forms] (lower-unit forms []))\\\\n  3006\\\\t  ([forms exports]\\\\n  3007\\\\t   (let [source (vec forms)\\\\n  3008\\\\t         library (library-for source)\\\\n  3009\\\\t         program (compile-program (concat source library) true unit-opts)\\\\n  3010\\\\t         macros (into