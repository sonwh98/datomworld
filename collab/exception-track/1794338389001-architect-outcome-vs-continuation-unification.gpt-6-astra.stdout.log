on a user-function call passes its\\\\n  1529\\\\t  operands as one vector.\\\\\\\"\\\\n  1530\\\\t  ([operator operands env tail?] (compile-application operator operands env tail? initial-macro-env))\\\\n  2500\\\\t    (defn boolean?\\\\n  2501\\\\t      [x]\\\\n  2502\\\\t      (or (= x true) (= x false)))\\\\n  2503\\\\t    (defn fn?\\\\n  2504\\\\t      [x]\\\\n  2505\\\\t      (if (data/callable? x) true (yang.call/eligible? x)))\\\\n  2506\\\\t    (defn ^:yin.k/invoker invoke-value\\\\n  2507\\\\t      [f args]\\\\n  2508\\\\t      (cond\\\\n  2509\\\\t        (vector? f) (if (= 1 (count args)) (nth f (first args))\\\\n  2510\\\\t                        (throw (ex-info \\\\\\\"Vector invocation requires one index\\\\\\\" {:argc (count args)})))\\\\n  2511\\\\t        (or (map? f) (keyword? f))\\\\n  2512\\\\t        (if (<= 1 (count args) 2)\\\\n  2513\\\\t          (if (keyword? f) (get (first args) f (second args))\\\\n  2514\\\\t              (get f (first args) (second args)))\\\\n  2515\\\\t          (throw (ex-info \\\\\\\"Lookup invocation requires one key and optional default\\\\\\\" {:argc (count args)})))\\\\n  2516\\\\t        (set? f) (if (= 1 (count args))\\\\n  2517\\\\t                   (if (contains? f (first args)) (first args) nil)\\\\n  2518\\\\t                   (throw (ex-info \\\\\\\"Set invocation requires one key\\\\\\\" {:argc (count args)})))\\\\n  2519\\\\t        ;; Everything unsupported - a scalar, a raw closure the convention\\\\n  2520\\\\t        ;; never published, a forged shape that slipped past the call-site\\\\n  2521\\\\t        ;; routing - refuses as the admission path would. No apply here: a\\\\n  2522\\\\t        ;; guest apply would re-enter the call-site dispatcher and recurse.\\\\n  2523\\\\t        :else (throw (yang.call/condition :yang.call/not-callable {:yang.call/callee f}))))\\\\n  2524\\\\t    (defn update\\\\n  2525\\\\t      ([m k f] (assoc m k (f (get m k))))\\\\n  2526\\\\t      ([m k f a] (assoc m k (