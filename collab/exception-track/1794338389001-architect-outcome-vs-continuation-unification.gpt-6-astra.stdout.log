\t  (if-not (outcomes? env)\\\\n  1290\\\\t    (cond-> (u/app callee-ast arguments-ast)\\\\n  1291\\\\t      tail? (assoc :tail? true))\\\\n  1292\\\\t    (let [callee (symbol (str reserved-prefix \\\\\\\"callee\\\\\\\"))\\\\n  1293\\\\t          arguments (symbol (str reserved-prefix \\\\\\\"arguments\\\\\\\"))\\\\n  1294\\\\t          escape (symbol (str reserved-prefix \\\\\\\"raise_escape\\\\\\\"))\\\\n  1295\\\\t          condition (symbol (str reserved-prefix \\\\\\\"condition\\\\\\\"))\\\\n  1296\\\\t          result (symbol (str reserved-prefix \\\\\\\"call_result\\\\\\\"))\\\\n  1297\\\\t          condition->outcome (u/if-node\\\\n  1298\\\\t                               (u/app (u/v 'dsg__equal)\\\\n  1299\\\\t                                      (u/app (u/v 'dsg__get) (u/v condition)\\\\n  1300\\\\t                                             (u/lit :yang.call/reason))\\\\n  1301\\\\t                                      (u/lit :yang.call/thrown))\\\\n  1302\\\\t                               (outcome-node\\\\n  1303\\\\t                                 error-tag\\\\n  1304\\\\t                                 (u/app (u/v 'dsg__get) (u/v condition)\\\\n  1305\\\\t                                        (u/lit :yang.call/value)))\\\\n  1306\\\\t                               (outcome-node error-tag (u/v condition)))\\\\n  1307\\\\t          raise (u/lam [condition]\\\\n  1308\\\\t                       (assoc (u/app (u/v escape)\\\\n  1309\\\\t                                     (u/app (u/v 'dsg__assoc) (u/lit {})\\\\n  1310\\\\t                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\\\\n  1311\\\\t                                            (u/lit :clj/outcome) condition->outcome))\\\\n  1312\\\\t                              :tail? true))\\\\n  1313\\\\t          common-call (u/let1\\\\n  1314\\\\t                        result\\\\n  1315\\\\t                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\\\\n  1316\\\\t                               (u/lit []) raise)\\\\n  1317\\\\t                        (outcome-node ok-tag (u/v result)))\\\\n  1318\\\\t          refused (outcome-node\\\\n  1319\\\\t                    error-tag\\\\n  1320\\\\t                    (u/app (u/v 'yang.call/condition)\\\\n  1321\\\\t                           (u/lit :yang.call/not-callable)\\\\n  1322\\\\t                           (u/app (u/v 'dsg__assoc) (u/lit {})\\\\n  1323\\\\t                                  (u/lit :yang.call/callee) (u/v callee))))\\\\n  1324\\\\t          activation (u/if-node\\\\n  1325\\\\t                       (u/app (u/v 'data/callable?) (u/v escape))\\\\n  1326\\\\t                       common-call\\\\n  1327\\\\t                       ;; Applying the escape resumes the capture operand.\\\\n  1328\\\\t                       ;; Only our authenticated transfer packet may resume\\\\n  1329\\\\t                       ;; here; an invalid captured value explicitly refuses.\\\\n  1330\\\\t                       (u/if-node\\\\n  1331\\\\t                         (u/app (u/v 'dsg__equal)\\\\n  1332\\\\t                                (u/app (u/v 'dsg__get) (u/v escape)\\\\n  1333\\\\t                                       (u/lit :clj/escape-token))\\\\n  1334\\\\t                                (u/v 'dsg__call_token))\\\\n  1335\\\\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\\\\n  1336\\\\t                         (outcome-node\\\\n  1337\\\\t                           error-tag\\\\n  1338\\\\t                           (u/app (u/v 'yang.call/condition)\\\\n  1339\\\\t                                  (u/lit :yang.call/invalid-invocation)\\\\n  1340\\\\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\\\\n  1341\\\\t          public-bridge (u/app (u/lam [escape] activation) u/capture)\\\\n  1342\\\\t          bridged (if tail?\\\\n  1343\\\\t                    (u/if-node\\\\n  1344\\\\t                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\\\\n  1345\\\\t                      (u/app (u/v 'yang.call/invoke-with)\\\\n  1346\\\\t                             (u/v callee) (u/v arguments) (u/lit [])\\\\n  1347\\\\t                             (u/lam [condition] condition->outcome)\\\\n  1348\\\\t                             (u/app (u/v 'dsg__assoc) (u/lit {})\\\\n  1349\\\\t                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\\\\n  1350\\\\t                      public-bridge)\\\\n  1351\\\\t                    public-bridge)\\\\n  1352\\\\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\\\\n  1353\\\\t                              bridged refused)\\\\n  1354\\\\t          ;; A callee carrying a call entry is convention territory whether it\\\\n  1355\\\\t          ;; admits or forges one, so admission rules it. Everything else is a\\\\n  1356\\\\t          ;; data-side invocation - a collection lookup or a raw closure call -\\\\n  1357\\\\t          ;; and the guest library's invoker owns those semantics. The invoker\\\\n  1358\\\\t          ;; is itself a published descriptor, so it is reached the same way\\\\n  1359\\\\t          ;; any guest callee is; its raise escapes to a capture of this site\\\\n  1360\\\\t          ;; and the resumed pass materializes the error outcome here.\\\\n  1361\\\\t          value-call (u/app\\\\n  1362\\\\t                       (u/lam ['dsg__raise_escape]\\\\n  1363\\\\t                              (u/if-node\\\\n  1364\\\\t                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\\\\n  1365\\\\t                                (u/let1\\\\n  1366\\\\t                                  (symbol (str reserved-prefix \\\\\\\"invoker_result\\\\\\\"))\\\\n  1367\\\\t                                  (u/app (u/v 'yang.call/invoke)\\\\n  1368\\\\t                                         (u/v 'invoke-va