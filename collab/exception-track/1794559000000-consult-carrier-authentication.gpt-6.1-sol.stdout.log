compile-apply\n  1447\t  \"(apply f a b coll) as one application of f to the assembled argument\n  1448\t   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n  1449\t   serves a guest closure and an adapted native alike.\"\n  1450\t  [operands env tail? macro-env]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba ../datomworld-r3-orch/src/cljc/yang/clojure.cljc | sed -n '875,988p;1170,1255p;2350,2415p;3070,3110p'; nl -ba src/cljc/yin/vm/values.cljc | sed -n '1,31p'; nl -ba src/cljc/yang/clojure.cljc | sed -n '410,440p;2338,2378p'; nl -ba test/yang/call/python_exception_test.clj | sed -n '25,80p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba ../datomworld-r3-orch/src/cljc/yang/clojure.cljc | sed -n '875,988p;1170,1255p;2350,2415p;3070,3110p'; nl -ba src/cljc/yin/vm/values.cljc | sed -n '1,31p'; nl -ba src/cljc/yang/clojure.cljc | sed -n '410,440p;2338,2378p'; nl -ba test/yang/call/python_exception_test.clj | sed -n '25,80p'\"","aggregated_output":"   875\t      out)))\n   876\t\n   877\t\n   878\t;; =============================================================================\n   879\t;; The clj continuation family (R3 §8.10.7; the (B) port)\n   880\t;; =============================================================================\n   881\t;;\n   882\t;; The port converges clojure's exception lowering onto the continuation\n   883\t;; encoding: a `%capture` handler stack in a dynamic-context cell, exactly\n   884\t;; like the py/ts/php preludes (`yang.clojure.prelude` carries the reference\n   885\t;; implementation under `clj/`). A source `(throw e)` lowers to `clj/throw`,\n   886\t;; `(try ...)` to `clj/try`/`clj/try-finally`, and function bodies return\n   887\t;; plain values. A guest call delivers a callee's escaping condition through\n   888\t;; the §8.10.7 raise exit, and the public entry installs the same bridge.\n   889\t;; The caught value IS the payload/condition — no wrapper, no retention\n   890\t;; object, no per-call-site routing. `compile-program` emits this family\n   891\t;; inline (the linked runtime binds the same family from the prelude); it\n   892\t;; routes the capture-sensitive primitives through the `dsg__*` helpers so a\n   893\t;; program definition of `get`/`assoc`/`=` cannot capture a frame access.\n   894\t\n   895\t(def ^:private continuation-family\n   896\t  \"The `clj/` continuation family, `[key form]` in prelude notation (each\n   897\t   form is read with `u/sexp->uast`). Mirrors `yang.clojure.prelude`'s\n   898\t   escapes section, minus `call-ec`/`unwind-to` (clojure has no\n   899\t   break/continue/return escapes). The handler stack is a chain of frames\n   900\t   [tag payload rest n]; a `:handler` frame holds the continuation\n   901\t   `clj/raise` delivers to, a `:finally` frame a one-argument thunk every\n   902\t   exit through it runs.\"\n   903\t  '[[clj/ctx (fn [hs] (dsg__assoc {} :handlers hs))]\n   904\t    [clj/handlers (fn [] (dsg__get (cell/get clj.rt/ctx) :handlers))]\n   905\t    [clj/set-handlers!\n   906\t     (fn [hs]\n   907\t       (cell/set! clj.rt/ctx (dsg__assoc (cell/get clj.rt/ctx) :handlers hs)))]\n   908\t    [clj/restore! (fn [saved] (cell/set! clj.rt/ctx saved))]\n   909\t    [clj/frame-depth (fn [hs] (if (dsg__equal hs nil) 0 (dsg__get hs 3)))]\n   910\t    [clj/frame\n   911\t     (fn [tag payload rest]\n   912\t       (conj (conj (conj (conj [] tag) payload) rest)\n   913\t             (+ 1 (clj/frame-depth rest))))]\n   914\t    [clj/pop-frame\n   915\t     (fn [hs]\n   916\t       (cell/set! clj.rt/ctx\n   917\t                  (dsg__assoc (cell/get clj.rt/ctx) :handlers (dsg__get hs 2))))]\n   918\t    [clj/raise\n   919\t     (fn [e]\n   920\t       (let [hs (clj/handlers)]\n   921\t         (if (dsg__equal hs nil)\n   922\t           (dsg__get e :clj/no-handler)\n   923\t           (if (dsg__equal (dsg__get hs 0) :finally)\n   924\t             (do (clj/pop-frame hs) ((dsg__get hs 1) e) (clj/raise e))\n   925\t             ((dsg__get hs 1) e)))))]\n   926\t    [clj/throw (fn [e] (clj/raise e))]\n   927\t    [clj/try\n   928\t     (fn [body handler]\n   929\t       (let [saved (cell/get clj.rt/ctx)\n   930\t             flag (cell/new :first)]\n   931\t         ((fn [r]\n   932\t            (if (dsg__equal (cell/get flag) :first)\n   933\t              (do (cell/set! flag :re-entered)\n   934\t                  (clj/set-handlers! (clj/frame :handler r (dsg__get saved :handlers)))\n   935\t                  (let [v (body)] (do (clj/restore! saved) v)))\n   936\t              (do (clj/restore! saved) (handler r))))\n   937\t          (%capture))))]\n   938\t    [clj/try-finally\n   939\t     (fn [body fin]\n   940\t       (let [saved (cell/get clj.rt/ctx)]\n   941\t         (do (clj/set-handlers! (clj/frame :finally fin (dsg__get saved :handlers)))\n   942\t             (let [v (body)]\n   943\t               (do (clj/restore! saved) (fin nil) v)))))]])\n   944\t\n   945\t\n   946\t(def ^:private ex-message-form\n   947\t  '(fn [dsg__value] (dsg__get dsg__value :yin.k/message)))\n   948\t\n   949\t\n   950\t(def ^:private ex-data-form\n   951\t  '(fn [dsg__value] (dsg__get dsg__value :yin.k/data)))\n   952\t\n   953\t\n   954\t(def ^:private continuation-uast\n   955\t  \"The continuation family tree: define every `clj/` entry (store-defined,\n   956\t   like `yang.core.call/uast`) then allocate the `clj.rt/ctx` cell. The\n   957\t   family's capture-sensitive primitives are the `dsg__*` names, bound at\n   958\t   emission by `compile-program`.\"\n   959\t  (u/then\n   960\t    (reduce (fn [ast [key form]]\n   961\t              (u/then ast (u/def! key (u/sexp->uast form))))\n   962\t            (u/lit nil)\n   963\t            continuation-family)\n   964\t    (u/def! 'clj.rt/ctx\n   965\t            (u/app (u/v 'cell/new) (u/app (u/v 'clj/ctx) (u/lit nil))))))\n   966\t\n   967\t\n   968\t(def continuation-family-names\n   969\t  \"The `clj/` continuation-family store definitions `compile-program` emits\n   970\t   inline (plus the `clj.rt/ctx` cell): compiler-bound names an admission scan\n   971\t   must accept, like the preamble's `dsg__*` helpers. Exposed so a harness\n   972\t   admission check stays in sync with the family instead of hardcoding it.\"\n   973\t  (into #{'clj.rt/ctx} (map first continuation-family)))\n   974\t\n   975\t\n   976\t(defn- rewrite-ex-info\n   977\t  \"(ex-info msg data cause?) as the portable map holding its parts. The\n   978\t   accessors read through the generated exception wrapper: a retained\n   979\t   condition's wrapper carries the original payload privately, so\n   980\t   (ex-message e)/(ex-data e) answer the payload's parts while a plain\n   981\t   value still answers by keyword lookup.\"\n   982\t  [form]\n   983\t  (cond\n   984\t    (seq? form)\n   985\t    (cond\n   986\t      (empty? form) form\n   987\t      (= 'quote (first form)) form\n   988\t      (#{'.getMessage 'ex-message 'ex-data} (first form))\n  1170\t    (check-binder! p params)))\n  1171\t\n  1172\t\n  1173\t(defn- outcome-node\n  1174\t  [tag value]\n  1175\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n  1176\t\n  1177\t\n  1178\t(defn- call-entry\n  1179\t  \"The unary public entry, closed over a private argument-vector body. It\n  1180\t   installs the exception bridge (`clj/try`) before argument binding, so an\n  1181\t   escaping raise from the body or a binding failure delivers\n  1182\t   `{:yang.call/reason :yang.call/thrown :yang.call/value v}` to the caller's\n  1183\t   raise exit exactly once (§8.10.8 cleanup first, then the caller's raise).\"\n  1184\t  []\n  1185\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1186\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1187\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1188\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1189\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1190\t        binding-error (u/app\n  1191\t                        (u/v 'clj/throw)\n  1192\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1193\t                               (u/lit :yin.k/message)\n  1194\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1195\t                               (u/lit :yin.k/data)\n  1196\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1197\t                                      (u/lit :yang.call/named) named)))\n  1198\t        forged-refusal (u/app\n  1199\t                         (u/v 'clj/throw)\n  1200\t                         (u/lit {:yin.k/message\n  1201\t                                 \"Invocation is neither an authenticated packet nor an invocation record\"\n  1202\t                                 :yin.k/data {}}))\n  1203\t        ;; The record path: bind and run the body under clj/try, delivering\n  1204\t        ;; any raise (a body throw or the binding failure) as a fresh\n  1205\t        ;; :yang.call/thrown condition to the caller's raise exit.\n  1206\t        entry-body (u/app\n  1207\t                     (u/v 'clj/try)\n  1208\t                     (u/lam [] (u/if-node (u/app (u/v 'dsg__empty) named)\n  1209\t                                          (u/app (u/v body) positional)\n  1210\t                                          binding-error))\n  1211\t                     (u/lam ['dsg__e]\n  1212\t                            (u/app raise (u/app (u/v 'yang.call/thrown) (u/v 'dsg__e)))))\n  1213\t        ;; The private lane forwards the body's plain value in tail position\n  1214\t        ;; (a raise from it propagates to the caller's own handler — the lane\n  1215\t        ;; installs no bridge). The compiler's token packet, a two-element\n  1216\t        ;; vector [token args], selects it on the SAME unary entry. A guest\n  1217\t        ;; cannot forge the token; maps keep the ordinary record path.\n  1218\t        packet (u/if-node\n  1219\t                 (u/app (u/v 'data/vector?) (u/v invocation))\n  1220\t                 (u/if-node\n  1221\t                   (u/app (u/v 'dsg__equal)\n  1222\t                          (u/app (u/v 'data/count) (u/v invocation))\n  1223\t                          (u/lit 2))\n  1224\t                   (u/if-node\n  1225\t                     (u/app (u/v 'dsg__equal)\n  1226\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\n  1227\t                            (u/v 'dsg__call_token))\n  1228\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\n  1229\t                     forged-refusal)\n  1230\t                   forged-refusal)\n  1231\t                 entry-body)\n  1232\t        entry (u/lam [invocation] packet)]\n  1233\t    (u/lam [body] entry)))\n  1234\t\n  1235\t\n  1236\t(defn- admit-call-descriptor\n  1237\t  \"Admit a descriptor constructed by trusted UAST/profile code. This is not\n  1238\t   a source form: entry-spelled source maps never pass through this constructor.\"\n  1239\t  [descriptor-ast tail?]\n  1240\t  (let [descriptor-name 'dsg__descriptor\n  1241\t        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\n  1242\t                         (u/lit :clj/admission) (u/lit nil))\n  1243\t        ;; The factory closure captures the canonical descriptor and private\n  1244\t        ;; token. Projection reconstructs and compares that opaque closure;\n  1245\t        ;; it never applies a source-supplied predicate. An equal immutable\n  1246\t        ;; reconstruction is the same value, not admission of different data.\n  1247\t        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\n  1248\t        published (u/let1 descriptor-name canonical\n  1249\t                          (u/app (u/v 'dsg__assoc) (u/v descriptor-name)\n  1250\t                                 (u/lit :clj/admission) witness))]\n  1251\t    (cond-> (u/mark-tails published)\n  1252\t      tail? (assoc :tail? true))))\n  1253\t\n  1254\t\n  1255\t(defn- compile-call-descriptor\n  2350\t                                                (dsg__get dsg__candidate\n  2351\t                                                          :clj/admission)]\n  2352\t                                            (if (data/callable? dsg__entry)\n  2353\t                                              (if (data/callable? dsg__witness)\n  2354\t                                                (dsg__equal\n  2355\t                                                  dsg__witness\n  2356\t                                                  (dsg__make_admission\n  2357\t                                                    (dsg__assoc dsg__candidate\n  2358\t                                                                :clj/admission\n  2359\t                                                                nil)))\n  2360\t                                                false)\n  2361\t                                              false))))\n  2362\t                                      false)))\n  2363\t                               ;; The intra-unit dispatcher: resolve the unit's public entry,\n  2364\t                               ;; apply it with the compiler's token packet [token args] - one\n  2365\t                               ;; variadic conj and one application, no record construction.\n  2366\t                               ;; Non-map callees refuse.\n  2367\t                               (u/sexp->uast\n  2368\t                                 (list 'fn '[dsg__callee dsg__args]\n  2369\t                                       (list 'if '(data/map? dsg__callee)\n  2370\t                                             (list (list (if (contains? (::defined env) 'get)\n  2371\t                                                           'dsg__get\n  2372\t                                                           'get)\n  2373\t                                                         'dsg__callee\n  2374\t                                                         :yang.call/entry)\n  2375\t                                                   (list 'conj '[]\n  2376\t                                                         'dsg__call_token\n  2377\t                                                         'dsg__args))\n  2378\t                                             '(clj/raise\n  2379\t                                                (yang.call/condition\n  2380\t                                                  :yang.call/not-callable\n  2381\t                                                  (dsg__assoc {} :yang.call/callee dsg__callee))))))))\n  2382\t           (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n  2383\t           (outcomes? env) (u/let1\n  2384\t                             'dsg__make_admission\n  2385\t                             (u/sexp->uast\n  2386\t                               '(fn [dsg__descriptor]\n  2387\t                                  (fn [dsg__candidate]\n  2388\t                                    (if (data/callable? dsg__call_token)\n  2389\t                                      (dsg__get dsg__descriptor :yang.call/entry)\n  2390\t                                      nil)))))\n  2391\t           ;; The exception accessors and the continuation family. The\n  2392\t           ;; `dsg__ex_message`/`dsg__ex_data` accessors read the portable\n  2393\t           ;; ex-info map; the continuation family (`clj/try`, `clj/throw`,\n  2394\t           ;; `clj/raise`, ...) is the port's `%capture` handler-stack scheme,\n  2395\t           ;; emitted inline (the linked runtime binds the same family from the\n  2396\t           ;; prelude). Its capture-sensitive primitives are the `dsg__*`\n  2397\t           ;; names bound outside it.\n  2398\t           (outcomes? env) (u/let1 'dsg__ex_message\n  2399\t                                   (u/sexp->uast ex-message-form))\n  2400\t           (outcomes? env) (u/let1 'dsg__ex_data\n  2401\t                                   (u/sexp->uast ex-data-form))\n  2402\t           (outcomes? env) (u/then\n  2403\t                             (discard-result continuation-uast))\n  2404\t           (outcomes? env) (u/then\n  2405\t                             (discard-result\n  2406\t                               (u/app (u/lam '[get = assoc empty?] call/uast)\n  2407\t                                      (u/v 'dsg__get) (u/v 'dsg__equal)\n  2408\t                                      (u/v 'dsg__assoc) (u/v 'dsg__empty))))\n  2409\t           (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\n  2410\t           ;; Guest closures keep captured environments portable: binding host\n  2411\t           ;; primitive values here would make UCF machine-data validation fail.\n  2412\t           ;; These helpers cover generated map lookups/writes and comparisons;\n  2413\t           ;; conj/vec are already protected by the convention's binder checks.\n  2414\t           ;; Evaluate siblings outside each other's bindings to avoid retaining\n  2415\t           ;; a chain of redundant helper environments.\n  3070\t   the projection is the caller's binding for them. The program's own\n  3071\t   `yang.call` call sites need no free-name declaration: the convention\n  3072\t   preamble `compile-program` emits defines those names locally, and\n  3073\t   the donor publication pins the `yang.call` module for the qualified\n  3074\t   reads that remain.\"\n  3075\t  ([forms] (lower-unit forms []))\n  3076\t  ([forms exports]\n  3077\t   (let [source (vec forms)\n  3078\t         library (library-for source)\n  3079\t         program (compile-program (concat source library) true unit-opts)\n  3080\t         macros (into #{}\n  3081\t                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n  3082\t                            (map (comp strip-symbol-meta second)))\n  3083\t                      (concat source library))\n  3084\t         names (reduce disj\n  3085\t                       (into (set (top-level-names source))\n  3086\t                             (concat (map (comp strip-symbol-meta second) library)\n  3087\t                                     (map symbol exports)))\n  3088\t                       macros)]\n  3089\t     ;; `publish-to-globals` rewrites nodes after `compile-program`\n  3090\t     ;; finalized them, so the unit is finalized again over its\n  3091\t     ;; finished tree: the rewrite's own applications are occurrences.\n  3092\t     (annotate-call-sites (u/lam [] (publish-to-globals program names #{}))))))\n  3093\t\n  3094\t\n  3095\t(defn output\n  3096\t  \"The `clj/run-main` value as test data.\"\n  3097\t  [value]\n  3098\t  (pr-str value))\n     1\t(ns yin.vm.values\n     2\t  \"The in-machine closure and continuation values (D7).\n     3\t\n     4\t   A closure and a captured continuation are host types minted only by a\n     5\t   kernel, never by a guest primitive or a module export. `closure?` and\n     6\t   `continuation?` are type tests, so an ordinary map is always data,\n     7\t   including one carrying `:type :closure` or `:type :reified-continuation`:\n     8\t   a program cannot forge either by building its map.\n     9\t\n    10\t   Each type wraps the kernel's own payload map unchanged, plus an owner\n    11\t   tag: the task the value was minted in (`owner-tag`). Lift, lower,\n    12\t   completion and heap reclamation read the payload, so they keep operating\n    13\t   on the maps they already understand.\n    14\t\n    15\t   Neither type answers keyword lookup, unlike `yin.vm.effect`'s `Effect`:\n    16\t   a guest `get` on a closure answers nil, never its captured environment.\n    17\t   Neither is a function: `fn?` is false, so no kernel's primitive arm is\n    18\t   taken. Equality is structural over kind, owner and payload, and hash\n    19\t   agrees with it, so two runs of one program give equal VM states and a\n    20\t   closure can be a set member or a map key.\n    21\t\n    22\t   Both print opaquely, on every host and through `str`, `pr-str` and every\n    23\t   guest print: `{:type :closure}` or `{:type :continuation}`, never the\n    24\t   payload, a captured value, or the owner tag (`marker-text`).\n    25\t\n    26\t   These are table C laws of docs/design/dao.stream.host-boundary.md\n    27\t   (§4.2), which a port must meet: equal iff kind, owner and payload are\n    28\t   equal; hash of `[kind owner payload]`; print the marker text.\n    29\t\n    30\t   Cell, stream and cursor references stay sealed plain data: they name\n    31\t   table entries, are already unforgeable, and must stay usable as keys.\"\n   410\t(def ^:private reserved-prefix \"dsg__\")\n   411\t\n   412\t\n   413\t(defn- reject!\n   414\t  [message data]\n   415\t  (throw (ex-info message data)))\n   416\t\n   417\t\n   418\t(defn- reserved-name?\n   419\t  [sym]\n   420\t  (= reserved-prefix (subs (name sym) 0 (min (count (name sym))\n   421\t                                             (count reserved-prefix)))))\n   422\t\n   423\t\n   424\t(defn- check-def-name!\n   425\t  \"A definition name is a plain symbol outside the reserved prefix.\"\n   426\t  [operator sym]\n   427\t  (when-not (and (symbol? sym) (nil? (namespace sym)))\n   428\t    (reject! (str operator \" needs a plain symbol name\") {:name sym}))\n   429\t  (when (reserved-name? sym)\n   430\t    (reject! \"Definition name uses the reserved destructuring prefix\"\n   431\t             {:name sym, :prefix reserved-prefix})))\n   432\t\n   433\t\n   434\t(defn- check-binder!\n   435\t  \"A binder is a plain symbol or a nested sequential pattern; anything else\n   436\t   (maps, keywords, literals) is outside the supported surface.\"\n   437\t  [b pattern]\n   438\t  (cond\n   439\t    (and (symbol? b) (nil? (namespace b)) (not= '& b))\n   440\t    (when (reserved-name? b)\n  2338\t                                                  (= 'invoke-value (second %))\n  2339\t                                                  (:yin.k/invoker (meta (second %)))) forms))}\n  2340\t            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n  2341\t\n  2342\t\n  2343\t(defn- check-program-symbols!\n  2344\t  \"The program pre-pass. Quoted data is exempt. The reserved prefix names\n  2345\t   compiler temporaries, so no user symbol may carry it in ANY position\n  2346\t   (binder, reference, definition name); `loop` and `recur` are special forms,\n  2347\t   so they may only head a list, never stand as a value or a binder.\"\n  2348\t  [form]\n  2349\t  (cond\n  2350\t    (symbol? form)\n  2351\t    (do (when (reserved-name? form)\n  2352\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n  2353\t                   {:symbol form, :prefix reserved-prefix}))\n  2354\t        (when (and (nil? (namespace form)) (contains? #{'loop 'recur} form))\n  2355\t          (reject! (str form \" is only legal in operator position\") {:symbol form})))\n  2356\t    (seq? form)\n  2357\t    (when-not (= 'quote (first form))\n  2358\t      (let [head (first form)]\n  2359\t        (when (and (symbol? head) (reserved-name? head))\n  2360\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n  2361\t                   {:symbol head, :prefix reserved-prefix}))\n  2362\t        (when-not (symbol? head)\n  2363\t          (check-program-symbols! head))\n  2364\t        (run! check-program-symbols! (rest form))))\n  2365\t    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n  2366\t    (coll? form) (run! check-program-symbols! form)))\n  2367\t\n  2368\t\n  2369\t(defn- check-top-level-discard!\n  2370\t  \"Only the last top-level form's outcome reaches the harness, so a non-final,\n  2371\t   non-definition form that may fail would have its error silently discarded:\n  2372\t   refuse it, as a def value that calls guest functions is refused. Returns\n  2373\t   `form`.\"\n  2374\t  [env macro-env forms form]\n  2375\t  (when (and (next forms)\n  2376\t             (not (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form))))\n  2377\t             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\n  2378\t    (reject! \"A non-final top-level form that may fail would discard its error outcome\"\n    25\t(defn- check-leg\n    26\t  \"Run one directed source pair/scenario and assert `legs/expected` per VM.\"\n    27\t  [id]\n    28\t  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\n    29\t    (testing (str id)\n    30\t      (doseq [[backend actual] (legs/run-leg leg)]\n    31\t        (is (= (legs/expected leg) actual) (str backend))))))\n    32\t\n    33\t\n    34\t(deftest python-provenance-export-surface-test\n    35\t  (let [private-names '#{dsg__condition-exception cell/dsg__new-provenance\n    36\t                         cell/dsg__provenance}\n    37\t        exposed? (fn [x]\n    38\t                   (some #(str/includes? (str x) %)\n    39\t                         [\"dsg__\" \"provenance\" \"condition-exception\"]))\n    40\t        public-private-users\n    41\t        (into #{}\n    42\t              (keep (fn [[k form]]\n    43\t                      (when (and (= \"py\" (namespace k))\n    44\t                                 (some private-names (tree-seq coll? seq form)))\n    45\t                        k)))\n    46\t              py-prelude/definitions)]\n    47\t    (is (not-any? exposed? (concat py-prelude/module-exports py-prelude/runtime-keys)))\n    48\t    ;; Only reception and egress may use the private constructor and reader.\n    49\t    ;; This also catches a renamed mint-wrapping helper.\n    50\t    (is (= '#{py/call-kw py/function-entry} public-private-users))))\n    51\t\n    52\t\n    53\t(deftest ^:slow python-foreign-reception-test\n    54\t  ;; R2: an otherwise-foreign payload is wrapped in a generated local\n    55\t  ;; ForeignException; an already-local exception is delivered unchanged.\n    56\t  (check-fixture :python/local-reception)           ; stays green\n    57\t  (check-fixture :python/foreign-reception)         ; R→G\n    58\t  (check-fixture :python/retained-foreign-lifetime) ; R→G\n    59\t  ;; The clojure→python typed reception and stored-wrapper rethrow legs.\n    60\t  (check-leg [:clojure :python :typed-catch])\n    61\t  (check-leg [:clojure :python :unchanged-rethrow])\n    62\t  (check-leg [:clojure :python :retained-lifetime]))\n    63\t\n    64\t\n    65\t(deftest ^:slow python-protocol-reception-test\n    66\t  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n    67\t  ;; complete condition instead of collapsing into a bare TypeError.\n    68\t  (check-fixture :python/protocol-not-callable)\n    69\t  (check-fixture :python/protocol-invalid-invocation)\n    70\t  (check-fixture :python/protocol-unsupported-binding)\n    71\t  (check-fixture :python/saved-protocol-not-callable)\n    72\t  (check-fixture :python/saved-protocol-invalid-invocation)\n    73\t  (check-fixture :python/saved-protocol-unsupported-binding))\n    74\t\n    75\t\n    76\t(deftest ^:slow python-egress-sanity-test\n    77\t  ;; Egress forwards a retained generated exception's original condition and\n    78\t  ;; still produces the plain thrown condition for fresh/forged payloads.\n    79\t  (check-fixture :python/fresh-named)       ; stays green\n    80\t  (check-fixture :python/fresh-closure)     ; stays green\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '300,360p'; nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '1060,1105p'; rg -n 'dsg__new-provenance' src/cljc --glob '*.cljc'; nl -ba collab/exception-track/1794477000000-reviewer-py-adoption-step7.glm-5.3.findings.md | sed -n '1,100p'; nl -ba ../datomworld-r3-orch/src/cljc/yang/clojure.cljc | sed -n '2364,2392p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '300,360p'; nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '1060,1105p'; rg -n 'dsg__new-provenance' src/cljc --glob '*.cljc'; nl -ba collab/exception-track/1794477000000-reviewer-py-adoption-step7.glm-5.3.findings.md | sed -n '1,100p'; nl -ba ../datomworld-r3-orch/src/cljc/yang/clojure.cljc | sed -n '2364,2392p'\"","aggregated_output":"   300\t(defn- seal-of\n   301\t  \"The seal of a `kind` reference to resource `id` under `secret`.\"\n   302\t  [secret kind id]\n   303\t  (jing/content-hash [:yin.k/seal secret kind id] {:algorithm :blake3}))\n   304\t\n   305\t\n   306\t(defn- cursor-cell?\n   307\t  \"True when a resource is a cursor cell, `{:stream-id id :cursor c}`.\n   308\t   A cursor cell is the VM's mutable box (with identity) holding one\n   309\t   immutable `dao.stream` cursor; `:stream/next` overwrites its `:cursor`\n   310\t   with the successor. A guest program holds a sealed `:cursor-ref` naming\n   311\t   it, never the cell itself. Not to be confused with `yin.vm.cell`, the\n   312\t   general heap box. Vocabulary: UCF §7.5.3, \\\"Terminology\\\".\"\n   313\t  [resource]\n   314\t  (and (map? resource) (contains? resource :stream-id)))\n   315\t\n   316\t\n   317\t(defn issue-ref\n   318\t  \"A reference of `kind` (`:stream-ref`, `:cursor-ref`, or `:cell-ref`) to\n   319\t   resource or heap cell `id`, sealed under the task's capability secret.\n   320\t   A task composed\n   321\t   without a secret cannot issue one: it fails closed rather than issue a\n   322\t   reference anyone could forge.\"\n   323\t  [state kind id]\n   324\t  (let [secret (:capability-secret state)]\n   325\t    (when (nil? secret)\n   326\t      (fail (str \"This task has no capability secret, so it cannot issue\"\n   327\t                 \" a resource reference\")\n   328\t            {:reason :no-capability-secret, :kind kind, :id id}))\n   329\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\n   330\t\n   331\t\n   332\t(defn authentic-ref?\n   333\t  \"True when `ref` is a `kind` reference this task issued: its seal\n   334\t   verifies under the task's secret, and it names a live resource of that\n   335\t   kind. A `:cell-ref` is checked against `:heap` instead: its id is live\n   336\t   by `contains?` (a cell may hold nil) and its seal equals the one the\n   337\t   heap entry recorded at allocation, so no hash is computed per access.\"\n   338\t  [state kind ref]\n   339\t  (let [secret (:capability-secret state)\n   340\t        id (when (map? ref) (:id ref))]\n   341\t    (if (= :cell-ref kind)\n   342\t      (let [heap (:heap state)]\n   343\t        (boolean (and (some? secret)\n   344\t                      (= kind (:type ref))\n   345\t                      (contains? heap id)\n   346\t                      (= (:seal ref) (:seal (get heap id))))))\n   347\t      (let [resource (get (:resources state) id)]\n   348\t        (boolean (and (some? secret)\n   349\t                      (= kind (:type ref))\n   350\t                      (some? resource)\n   351\t                      (= (:seal ref) (seal-of secret kind id))\n   352\t                      (= (= :cursor-ref kind) (cursor-cell? resource))))))))\n   353\t\n   354\t\n   355\t(defn check-ref!\n   356\t  \"The resource id a program-supplied `kind` reference names, once its\n   357\t   seal verifies (r10). Anything else fails closed with\n   358\t   `:forged-resource-reference`, naming the effect and the id it named;\n   359\t   a cell ref whose id the heap does not hold is\n   360\t   `:dead-or-forged-reference` instead: its cell was swept, or never was.\n  1060\t         (if (= (py/content-type f) :class)\n  1061\t           (py/instantiate f args kwargs)\n  1062\t           (if (yang.call/eligible? f)\n  1063\t             (yang.call/invoke\n  1064\t               f args kwargs\n  1065\t               (fn [condition]\n  1066\t                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\n  1067\t                   (let [value (get condition :yang.call/value)]\n  1068\t                     (py/raise\n  1069\t                       (if (if (= (py/content-type value) :instance)\n  1070\t                             (py/subclass? (get (cell/get value) :class)\n  1071\t                                           py.b/BaseException)\n  1072\t                             false)\n  1073\t                         value\n  1074\t                         ;; A local hierarchy and fixed local message: neither\n  1075\t                         ;; foreign class names nor foreign methods participate.\n  1076\t                         (dsg__condition-exception\n  1077\t                           (py/make-class \"ForeignException\" py.b/Exception)\n  1078\t                           {:py/str \"foreign exception\"} condition))))\n  1079\t                   (py/raise\n  1080\t                     (dsg__condition-exception py.b/TypeError\n  1081\t                                               {:py/str \"object is not callable\"}\n  1082\t                                               condition)))))\n  1083\t             (if (= (py/content-type f) :function)\n  1084\t               (let [fc (cell/get f)]\n  1085\t                 ((get fc :code) (py/bind-args fc args kwargs)))\n  1086\t               (py/type-error {:py/str \"object is not callable\"}))))))]\n  1087\t    [py/instantiate\n  1088\t     (fn [cls args kwargs]\n  1089\t       (let [inst (py/make-instance cls)\n  1090\t             init (py/class-lookup cls \"__init__\")]\n  1091\t         ;; without __init__ only exception classes take arguments (they\n  1092\t         ;; become `args`); any other class takes none\n  1093\t         (do (if (= init :py/missing)\n  1094\t               (if (py/subclass? cls py.b/BaseException)\n  1095\t                 ;; the builtin exception constructor takes positional\n