135\t    [clj/try\n   136\t     (fn [body handler]\n   137\t       (let [saved (cell/get clj.rt/ctx)\n   138\t             flag (cell/new :first)]\n   139\t         ((fn [r]\n   140\t            (if (= (cell/get flag) :first)\n   141\t              (do (cell/set! flag :re-entered)\n   142\t                  (clj/set-handlers! (clj/frame :handler r (get saved :handlers)))\n   143\t                  (let [v (body)] (do (clj/restore! saved) v)))\n   144\t              (do (clj/restore! saved) (handler r))))\n   145\t          (%capture))))]\n   146\t    [clj/try-finally\n   147\t     ;; normal exit runs `fin` here; throw and escapes run it as they unwind\n   148\t     ;; through the :finally frame\n   149\t     (fn [body fin]\n   150\t       (let [saved (cell/get clj.rt/ctx)]\n   151\t         (do (clj/set-handlers! (clj/frame :finally fin (get saved :handlers)))\n   152\t             (let [v (body)]\n   153\t               (do (clj/restore! saved) (fin nil) v)))))]\n   154\t\n   155\t    ;; ------------------------------------------------------------- entry\n   156\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n   157\t    ;; internal, so the entry removes one wrapper level from the\n   158\t    ;; program's value (a program returning that vector as data was\n   159\t    ;; wrapped again, so one level is exact). An error outcome passes\n   160\t    ;; through as the failure value for the caller to render.\n   161\t    [clj/unwrap-outcome\n   162\t     (fn [value]\n   163\t       (if (if (data/vector? value) (= (data/count value) 2) false)\n   164\t         (if (= (data/nth value 0) :yin.k/ok)\n   165\t           (data/nth value 1)\n   166\t           value)\n   167\t         value))]\n   168\t    ;; The global namespace is the task's, not the entry's: no reset\n   169\t    ;; here, so projections and earlier units' definitions survive.\n   170\t    [clj/run-main\n   171\t     (fn [body]\n   172\t       (do (clj/init!)\n   173\t           (clj/unwrap-outcome (body))))]])\n   174\t\n   175\t\n   176\t(def module-definitions\n   177\t  \"The module's definition list: an `:clj/uninit` placeholder for every\n   178\t   runtime key, then every definition, stripped.\"\n   179\t  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n   180\t\n   181\t\n   182\t(def module-uast\n   183\t  \"The module tree: one wide application over the definitions, so every\n   184\t   sibling and runtime key read is discharged at module level. C1\n   185\t   finalized, like every production `yang.clojure` tree.\"\n   186\t  (yang/annotate-call-sites (core/module-tree module-definitions [])))\n   187\t\n   188\t\n   189\t(def module-exports\n   190\t  \"The module's exports: every `clj/` key of the definition list, stripped.\"\n   191\t  (core/exports \"clj\" definitions))\n   192\t\n   193\t\n   194\t(def ^:private module-free-names\n   195\t  \"The names the module tree reads and does not define, sorted: the host\n   196\t   exports its manifest must declare.\"\n   197\t  (core/free-name-vec module-uast))\n   198\t\n   199\t\n   200\t(defn module-spec\n   201\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `clj` over\n   202\t   the host registry `registry`, pinned to the published `yang.call`\n   203\t   module at `call-address` — the convention's call-address, as every\n   204\t   runtime's publication carries. A free name nothing supplies is refused\n   205\t   before anything is published. This namespace emits; it never publishes.\"\n   206\t  [registry call-address]\n   207\t  (core/module-spec {:module-name module-name,\n   208\t                     :ast module-uast,\n   209\t                     :exports module-exports,\n   210\t                     :requires {'yang.call call-address},\n   211\t                     :free-names module-free-names,\n   212\t                     :skip? #(= \"yang.call\" (namespace %)),\n   213\t                     :registry registry,\n   214\t                     :message \"the clj module reads an undeclared name\",\n   215\t                     :refusal-ns \"yang.clojure\"}))\n   216\t\n   217\t\n   218\t(defn register-library-module\n   219\t  \"Return `registry` with host module `name` installed over `entries`\n   220\t   (`[export function]` pairs) at `arities`, each export pure.\"\n   221\t  [registry name entries arities]\n   222\t  (module/register-host-module\n   223\t    registry name\n   224\t    (into {} entries)\n   225\t    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n   226\t          entries)))\n   227\t\n   228\t\n   229\t(defn admit\n   230\t  \"Return `registry` with the guest library's host surface installed: the\n   231\t   `kind` module and the `portable` adapters of the data exports the\n   232\t   collection predicates read (yang.clojure's `library-adapters`). A\n   233\t   linked clojure composition registers them beside the other runtimes'\n   234\t   registry surfaces; a composition without a clojure program reads none\n   235\t   of them.\"\n   236\t  [registry]\n   237\t  (let [portable (into {}\n   238\t                       (map (fn [[source _]]\n   239\t                              (let [op (symbol (name source))]\n   240\t                                [op (yang/outcome-adapter data/refusal-message\n   241\t                                                          (get data/data-module op))])))\n   242\t                       yang/library-adapters)]\n   243\t    (-> registry\n   244\t        (register-library-module 'kind yang/kind-module yang/kind-arities)\n   245\t        (register-library-module\n   246\t          'portable portable\n   247\t          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n   248\t                (keys portable))))))\n  1320\t                                   (lower-function-body env macro-env [] [call])\n  1321\t                                   call)}))\n  1322\t                      (adapter-counts env sym))]\n  1323\t    (compile-lambda [av-sym] (av-dispatch env sym nil arities) env tail? macro-env)))\n  1324\t\n  1325\t\n  1326\t(defn- apply-call?\n  1327\t  \"True when `operator` is the `apply` intrinsic: not bound locally and not\n  1328\t   defined by the program.\"\n  1329\t  [env operator]\n  1330\t  (and (= 'apply operator)\n  1331\t       (not (contains? (locals env) operator))\n  1332\t       (not (contains? (::defined env) operator))))\n  1333\t\n  1334\t\n  1335\t(defn- intra-unit-fn?\n  1336\t  \"True when `operator` statically names a top-level `defn`/`defn-` of this\n  1337\t   unit under the outcome model: unshadowed by locals and never defined by\n  1338\t   `def` or `defmacro`.\"\n  1339\t  [env operator]\n  1340\t  (and (outcomes? env)\n  1341\t       (symbol? operator)\n  1342\t       (not (contains? (locals env) operator))\n  1343\t       (contains? (::defined-fns env) operator)))\n  1344\t\n  1345\t\n  1346\t(defn- cell-ref-shaped-node\n  1347\t  \"The UAST pre-filter for WHEN to ask the heap about a callee: the\n  1348\t   callee could be a cell reference the VM issued — `:type :cell-ref`\n  1349\t   with the `:id` and `:seal` every issued reference carries, no other\n  1350\t   entries, a seal of the issued form (a 64-character string). The\n  1351\t   shape never decides meaning (ruling of record, rule 2): a map\n  1352\t   passing it is only worth asking about, and the `cell/authentic?`\n  1353\t   query emitted beside it answers. Any `:id` spelling may name a\n  1354\t   cell, so the r4 heap-id-language discriminator is retired — the\n  1355\t   minted `:cell-N` restriction was itself a value-shape guess the\n  1356\t   issuer never certified. A map that fails this pre-filter is never\n  1357\t   asked and never dereferenced: it routes to ordinary map\n  1358\t   invocation, which grants no cell capability.\"\n  1359\t  [callee]\n  1360\t  (let [seal (u/app (u/v 'dsg__get) callee (u/lit :seal))]\n  1361\t    (u/if-node (u/app (u/v 'dsg__equal)\n  1362\t                      (u/app (u/v 'dsg__get) callee (u/lit :type))\n  1363\t                      (u/lit :cell-ref))\n  1364\t               (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :id))\n  1365\t                          (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :seal))\n  1366\t                                     (u/if-node (u/app (u/v 'dsg__equal)\n  1367\t                                                       (u/app (u/v 'data/count) callee)\n  1368\t                                                       (u/lit 3))\n  1369\t                                                (u/if-node (u/app (u/v 'data/string?) seal)\n  1370\t                                                           (u/if-node (u/app (u/v 'dsg__equal)\n  1371\t                                                                             (u/app (u/v 'data/str-length) seal)\n  1372\t                                                                             (u/lit 64))\n  1373\t                                                                      (u/lit true)\n  1374\t                                                                      (u/lit false))\n  1375\t                                                           (u/lit false))\n  1376\t                                                (u/lit false))\n  1377\t                                     (u/lit false))\n  1378\t                          (u/lit false))\n  1379\t               (u/lit false))))\n  1380\t\n  1381\t\n  1382\t(defn- compile-guest-call\n  1383\t  \"Admit a source operator before common invocation. The raise exit delivers\n  1384\t   the callee's escaping condition into the clj continuation: a\n  1385\t   `:yang.call/thrown` condition delivers its payload (the caught value IS the\n  1386\t   payload), any other value (a qualified protocol condition or an unmarked\n  1387\t   value) delivers whole. Only generated UAST implementation calls apply\n  1388\t   private closures directly.\"\n  1389\t  [callee-ast arguments-ast env tail?]\n  1390\t  (if-not (outcomes? env)\n  1391\t    (cond-> (u/app callee-ast arguments-ast)\n  1392\t      tail? (assoc :tail? true))\n  1393\t    (let [callee (symbol (str reserved-prefix \"callee\"))\n  1394\t          arguments (symbol (str reserved-prefix \"arguments\"))\n  1395\t          condition (symbol (str reserved-prefix \"condition\"))\n  1396\t          raise-exit (u/lam [condition]\n  1397\t                            (assoc (u/app (u/v 'clj/raise)\n  1398\t                                          (u/if-node\n  1399\t                                            (u/app (u/v 'dsg__equal)\n  1400\t                                                   (u/app (u/v 'dsg__get) (u/v condition)\n  1401\t                                                          (u/lit :yang.call/reason))\n  1402\t                                                   (u/lit :yang.call/thrown))\n  1403\t                                            (u/app (u/v 'dsg__get) (u/v condition)\n  1404\t                                                   (u/lit :yang.call/value))\n  1405\t                                            (u/v condition)))\n  1406\t                                   :tail? true))\n  1407\t          common-call (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n  1408\t                             (u/lit []) raise-exit)\n  1409\t          refused (u/app (u/v 'clj/raise)\n  1410\t                         (u/app (u/v 'yang.call/condition)\n  1411\t                                (u/lit :yang.call/not-callable)\n  1412\t                                (u/app (u/v 'dsg__assoc) (u/lit {})\n  1413\t                                       (u/lit :yang.call/callee) (u/v callee))))\n  1414\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n  1415\t                              common-call refused)\n  1416\t          ;; A callee carrying a call entry is convention territor