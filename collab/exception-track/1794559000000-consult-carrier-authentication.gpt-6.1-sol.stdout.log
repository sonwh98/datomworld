     (if (outcomes? env) (arity-error-form fn-name source) (list 'data/count))\n  1265\t            (reverse arities))))\n  1266\t\n  1267\t\n  1268\t(defn- check-av-params!\n  1269\t  [params]\n  1270\t  (when-not (vector? params)\n  1271\t    (reject! \"fn parameters must be a vector\" {:params params}))\n  1272\t  (doseq [p params]\n  1273\t    (when (= '& p)\n  1274\t      (reject! \"Variadic fn parameters are not supported\" {:params params}))\n  1275\t    (check-binder! p params)))\n  1276\t\n  1277\t\n  1278\t(defn- outcome-node\n  1279\t  [tag value]\n  1280\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n  1281\t\n  1282\t\n  1283\t(defn- call-entry\n  1284\t  \"The unary public entry, closed over a private argument-vector body.\"\n  1285\t  []\n  1286\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1287\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1288\t        outcome (symbol (str reserved-prefix \"entry_outcome\"))\n  1289\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1290\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1291\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1292\t        binding-error (outcome-node\n  1293\t                        error-tag\n  1294\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1295\t                               (u/lit :yin.k/message)\n  1296\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1297\t                               (u/lit :yin.k/data)\n  1298\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1299\t                                      (u/lit :yang.call/named) named)))\n  1300\t        entry-body (u/let1\n  1301\t                     outcome\n  1302\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\n  1303\t                                (u/app (u/v body) positional)\n  1304\t                                binding-error)\n  1305\t                     (u/if-node (u/app (u/v 'dsg__equal)\n  1306\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\n  1307\t                                       (u/lit ok-tag))\n  1308\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1309\t                                (u/app raise\n  1310\t                                       (u/app (u/v 'yang.call/thrown)\n  1311\t                                              (u/app (u/v 'data/nth)\n  1312\t                                                     (u/v outcome) (u/lit 1))))))\n  1313\t        ;; The private lane forwards the body's outcome in tail position.\n  1314\t        ;; The public entry still converts outcomes to value/raise normally.\n  1315\t        ;; The compiler's token packet - a two-element vector whose first\n  1316\t        ;; element is the compiler-held token - selects the private tail\n  1317\t        ;; lane on the SAME unary entry: no record unwrap, no map lookups.\n  1318\t        ;; A guest cannot forge it: the token is compiler-held and the\n  1319\t        ;; reserved-prefix regime refuses binding or shadowing it. Maps\n  1320\t        ;; keep the ordinary record path. The vector guard is required:\n  1321\t        ;; data/nth refuses non-vectors, and dsg__get reads vectors as\n  1322\t        ;; nil whenever the program defines its own get.\n  1323\t        packet (u/if-node\n  1324\t                 (u/app (u/v 'data/vector?) (u/v invocation))\n  1325\t                 ;; the packet is exactly two elements: the arity guard runs\n  1326\t                 ;; before data/nth so an empty or overlong vector refuses\n  1327\t                 ;; as an outcome instead of a host-side data refusal\n  1328\t                 (u/if-node\n  1329\t                   (u/app (u/v 'dsg__equal)\n  1330\t                          (u/app (u/v 'data/count) (u/v invocation))\n  1331\t                          (u/lit 2))\n  1332\t                   (u/if-node\n  1333\t                     (u/app (u/v 'dsg__equal)\n  1334\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\n  1335\t                            (u/v 'dsg__call_token))\n  1336\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\n  1337\t                     ;; a vector without the compiler-held token is NOT the\n  1338\t                     ;; record path: applying the body here would hand every\n  1339\t                     ;; forged vector the private lane. Refuse explicitly.\n  1340\t                     (u/lit [:yin.k/error\n  1341\t                             {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1342\t                              :yin.k/data {}}]))\n  1343\t                   (u/lit [:yin.k/error\n  1344\t                           {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1345\t                            :yin.k/data {}}]))\n  1346\t                 (u/if-node\n  1347\t                   (u/app (u/v 'dsg__equal)\n  1348\t                          (u/app (u/v 'dsg__get) (u/v invocation)\n  1349\t                                 (u/lit :clj/outcome-token))\n  1350\t                          (u/v 'dsg__call_token))\n  1351\t                   (u/if-node (u/app (u/v 'dsg__empty) named)\n  1352\t                              (u/app (u/v body) positional)\n  1353\t                              binding-error)\n  1354\t                   entry-body))\n  1355\t        entry (u/lam [invocation] packet)]\n  1356\t    (u/lam [body] entry)))\n  1357\t\n  1358\t\n  1359\t(defn- admit-call-descriptor\n  1360\t  \"Admit a descriptor constructed by trusted UAST/profile code. This is not\n  1361\t   a source form: entry-spelled source maps never pass through this constructor.\"\n  1362\t  [descriptor-ast tail?]\n  1363\t  (let [descriptor-name 'dsg__descriptor\n  1364\t        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\n  1365\t                         (u/lit :clj/admission) (u/lit nil))\n  1366\t        ;; The factory closure captures the canonical descriptor and private\n  1367\t        ;; token. Projection reconstructs and compares that opaque closure;\n  1368\t        ;; it never applies a source-supplied predicate. An equal immutable\n  1369\t        ;; reconstruction is the same value, not admission of different data.\n  1370\t        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\n  1371\t        published (u/let1 descriptor-name canonical\n  1372\t                          (u/app (u/v 'dsg__assoc) (u/v descriptor-name)\n  1373\t                                 (u/lit :clj/admission) witness))]\n  1374\t    (cond-> (u/mark-tails published)\n  1375\t      tail? (assoc :tail? true))))\n  1376\t\n  1377\t\n  1378\t(defn- compile-call-descriptor\n  1379\t  \"Publish a private body through a canonical constructor-created entry.\"\n  1380\t  [body-ast tail?]\n  1381\t  (admit-call-descriptor\n  1382\t    (u/app (u/v 'dsg__assoc) (u/lit {})\n  1383\t           (u/lit :yang.call/entry) (u/app (u/v 'dsg__make_entry) body-ast)\n  1384\t           (u/lit :clj/type) (u/lit :function)\n  1385\t           (u/lit :clj/outcomes?) (u/lit true))\n  1386\t    tail?))\n  1387\t\n  1388\t\n  1389\t(defn- compile-av-fn\n  1390\t  \"Compile arities [{:params :body}] to one closure over an argument vector.\n  1391\t   `fn-name` names the function in an arity error outcome. Under the outcome\n  1392\t   model the published value is an immutable common-call descriptor.\"\n  1393\t  ([arities env tail? macro-env] (compile-av-fn arities env tail? macro-env nil nil))\n  1394\t  ([arities env tail? macro-env fn-name] (compile-av-fn arities env tail? macro-env fn-name nil))\n  1395\t  ([arities env tail? macro-env fn-name source]\n  1396\t   (let [arities (mapv (fn [{:keys [params body]}]\n  1397\t                         (check-av-params! params)\n  1398\t                         {:n (count params)\n  1399\t                          :form (av-let env macro-env params body)})\n  1400\t                       arities)\n  1401\t         body (compile-lambda [av-sym] (av-dispatch env fn-name source arities)\n  1402\t                              env false macro-env)]\n  1403\t     (if (outcomes? env)\n  1404\t       (compile-call-descriptor body tail?)\n  1405\t       (cond-> body tail? (assoc :tail? true))))))\n  1406\t\n  1407\t\n  1408\t(defn- fn-arities\n  1409\t  \"Arities of (fn [params] body*) or (fn ([params] body*)+) operands.\"\n  1410\t  [operands]\n  1411\t  (cond\n  1412\t    (vector? (first operands))\n  1413\t    [{:params (first operands), :body (rest operands)}]\n  1414\t\n  1415\t    (and (seq operands) (every? #(and (seq? %) (vector? (first %))) operands))\n  1416\t    (mapv (fn [a] {:params (first a), :body (rest a)}) operands)\n  1417\t\n  1418\t    :else (reject! \"fn parameters must be a vector\" {:params (first operands)})))\n  1419\t\n  1420\t\n  1421\t(defn- adapter-counts\n  1422\t  \"The argument counts an adapter for native `sym` admits: the fixed arities\n  1423\t   of its `:yin.k/arities` profile, extended to `adapter-variadic-cap` when\n  1424\t   the profile is `:variadic`. A name with no declared profile admits\n  1425\t   0 to `default-adapter-arity`.\"\n  1426\t  [env sym]\n  1427\t  (if-let [declared (get-in env [::convention :arities sym])]\n  1428\t    (let [fixed (filter number? declared)\n  1429\t          from (if (seq fixed) (apply max fixed) 0)]\n  1430\t      (vec (sort (distinct (concat fixed\n  1431\t                                   (when (some #{:variadic} declared)\n  1432\t                                     (range from (inc (max from adapter-variadic-cap)))))))))\n  1433\t    (vec (range (inc default-adapter-arity)))))\n  1434\t\n  1435\t\n  1436\t(defn- compile-adapter\n  1437\t  \"A fresh closure over the convention that calls native `sym` with the\n  1438\t   unpacked arguments, for each admitted count.\"\n  1439\t  [sym env tail? macro-env]\n  1440\t  (let [arities (mapv (fn [n]\n  1441\t                        (let [call (cons sym (map #(list 'data/nth av-sym %) (range n)))]\n  1442\t                          {:n n\n  1443\t                           :form (if (outcomes? env)\n  1444\t                                   (lower-function-body env macro-env [] [call])\n  1445\t                                   call)}))\n     1\t(ns yang.clojure.prelude\n     2\t  \"The `clj` runtime module (docs/design/yang.antlr.md section 8.10):\n     3\t   the published linker module every linked clojure program requires, as\n     4\t   `js`, `php` and `py` are for their frontends. It is written in prelude\n     5\t   notation and emitted with the same core machinery those preludes use;\n     6\t   it never runs on the host.\n     7\t\n     8\t   Three surfaces, mirroring the other runtimes:\n     9\t\n    10\t   - the entry, `clj/run-main`: initialize the runtime state, run the\n    11\t     unit — the thunk `yang.clojure/lower-unit` lowered — and answer the\n    12\t     program's value with the outcome model's `[:yin.k/ok value]`\n    13\t     wrapper removed, since that wrapper is frontend-internal. The\n    14\t     entry does not reset the global namespace: the namespace lives for\n    15\t     the task, so a projection the composition bound between two\n    16\t     entries and a definition an earlier unit published both survive\n    17\t     into the next unit's run (as `js/run-main` leaves `globalThis`\n    18\t     standing);\n    19\t   - the runtime global namespace, `clj/define-global!` and\n    20\t     `clj/global-get`: a task-local map in a cell (`clj.rt/globals`,\n    21\t     allocated once per task by `clj/init!`), keyed by export name. A\n    22\t     program's top-level definitions land here through its unit's own\n    23\t     publishing, and the conformance helper's export projection reads\n    24\t     and writes it — the one binding a linked unit reads a projected or\n    25\t     defined name through. A definition a unit runs publishes after\n    26\t     any projection of the same name and shadows it. The JS\n    27\t     `globalThis` table, the PHP named-function table and the Python\n    28\t     module dictionary are the same seam;\n    29\t   - admission, `admit`: the registry surface a linked clojure composition\n    30\t     needs beside the others — the `kind` module and the `portable`\n    31\t     adapters of the data exports the guest library's collection\n    32\t     predicates read.\n    33\t\n    34\t   The module pins the shared calling runtime (`yang.call`) at the\n    35\t   convention's call-address, as the other runtimes do, and refuses before\n    36\t   anything is published when a free name nothing supplies is read.\"\n    37\t  (:require [yang.core.prelude :as core]\n    38\t            [yang.clojure :as yang]\n    39\t            [yin.vm :as vm]\n    40\t            [yin.vm.data :as data]\n    41\t            [yin.vm.module :as module]))\n    42\t\n    43\t\n    44\t(def module-name\n    45\t  \"The linker module name of the clojure runtime.\"\n    46\t  'clj)\n    47\t\n    48\t\n    49\t(def runtime-keys\n    50\t  \"Every runtime key, each with an `:clj/uninit` placeholder at module\n    51\t   level so every read is discharged before `clj/init!` allocates the\n    52\t   real cell. They stay qualified: internal store keys, never guest\n    53\t   names.\"\n    54\t  '[clj.rt/state clj.rt/globals])\n    55\t\n    56\t\n    57\t(def definitions\n    58\t  \"The module's definition list, in prelude notation (the module's own\n    59\t   `clj/` prefix is stripped on emit).\"\n    60\t  '[;; ------------------------------------------------- state and namespace\n    61\t    [clj/init!\n    62\t     (fn []\n    63\t       (if (= clj.rt/state :clj/uninit)\n    64\t         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n    65\t             (yin/def (quote clj.rt/state) :clj/ready))\n    66\t         :clj/ready))]\n    67\t    ;; the runtime global namespace: one task-local map in a cell, keyed by\n    68\t    ;; export name. `clj/define-global!` answers the value, so a publish\n    69\t    ;; sequence can chain through it.\n    70\t    [clj/define-global!\n    71\t     (fn [name value]\n    72\t       (do (cell/set! clj.rt/globals\n    73\t                      (assoc (cell/get clj.rt/globals) name value))\n    74\t           value))]\n    75\t    [clj/global-get\n    76\t     (fn [name]\n    77\t       (if (data/contains? (cell/get clj.rt/globals) name)\n    78\t         (get (cell/get clj.rt/globals) name)\n    79\t         :clj/unbound))]\n    80\t\n    81\t    ;; ------------------------------------------------------------- entry\n    82\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n    83\t    ;; internal, so the entry removes one wrapper level from the\n    84\t    ;; program's value (a program returning that vector as data was\n    85\t    ;; wrapped again, so one level is exact). An error outcome passes\n    86\t    ;; through as the failure value for the caller to render.\n    87\t    [clj/unwrap-outcome\n    88\t     (fn [value]\n    89\t       (if (if (data/vector? value) (= (data/count value) 2) false)\n    90\t         (if (= (data/nth value 0) :yin.k/ok)\n    91\t           (data/nth value 1)\n    92\t           value)\n    93\t         value))]\n    94\t    ;; The global namespace is the task's, not the entry's: no reset\n    95\t    ;; here, so projections and earlier units' definitions survive.\n    96\t    [clj/run-main\n    97\t     (fn [body]\n    98\t       (do (clj/init!)\n    99\t           (clj/unwrap-outcome (body))))]])\n   100\t\n   101\t\n   102\t(def module-definitions\n   103\t  \"The module's definition list: an `:clj/uninit` placeholder for every\n   104\t   runtime key, then every definition, stripped.\"\n   105\t  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n   106\t\n   107\t\n   108\t(def module-uast\n   109\t  \"The module tree: one wide application over the definitions, so every\n   110\t   sibling and runtime key read is discharged at module level. C1\n   111\t   finalized, like every production `yang.clojure` tree.\"\n   112\t  (yang/annotate-call-sites (core/module-tree module-definitions [])))\n   113\t\n   114\t\n   115\t(def module-exports\n   116\t  \"The module's exports: every `clj/` key of the definition list, stripped.\"\n   117\t  (core/exports \"clj\" definitions))\n   118\t\n   119\t\n   120\t(def ^:private module-free-names\n   121\t  \"The names the module tree reads and does not define, sorted: the host\n   122\t   exports its manifest must declare.\"\n   123\t  (core/free-name-vec module-uast))\n   124\t\n   125\t\n   126\t(defn module-spec\n   127\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `clj` over\n   128\t   the host registry `registry`, pinned to the published `yang.call`\n   129\t   module at `call-address` — the convention's call-address, as every\n   130\t   runtime's publication carries. A free name nothing supplies is refused\n   131\t   before anything is published. This namespace emits; it never publishes.\"\n   132\t  [registry call-address]\n   133\t  (core/module-spec {:module-name module-name,\n   134\t                     :ast module-uast,\n   135\t                     :exports module-exports,\n   136\t                     :requires {'yang.call call-address},\n   137\t                     :free-names module-free-names,\n   138\t                     :skip? #(= \"yang.call\" (namespace %)),\n   139\t                     :registry registry,\n   140\t                     :message \"the clj module reads an undeclared name\",\n   141\t                     :refusal-ns \"yang.clojure\"}))\n   142\t\n   143\t\n   144\t(defn register-library-module\n   145\t  \"Return `registry` with host module `name` installed over `entries`\n   146\t   (`[export function]` pairs) at `arities`, each export pure.\"\n   147\t  [registry name entries arities]\n   148\t  (module/register-host-module\n   149\t    registry name\n   150\t    (into {} entries)\n   151\t    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n   152\t          entries)))\n   153\t\n   154\t\n   155\t(defn admit\n   156\t  \"Return `registry` with the guest library's host surface installed: the\n   157\t   `kind` module and the `portable` adapters of the data exports the\n   158\t   collection predicates read (yang.clojure's `library-adapters`). A\n   159\t   linked clojure composition registers them beside the other runtimes'\n   160\t   registry surfaces; a composition without a clojure program reads none\n   161\t   of them.\"\n   162\t  [registry]\n   163\t  (let [portable (into {}\n   164\t                       (map (fn [[source _]]\n   165\t                              (let [op (symbol (name source))]\n   166\t                                [op (yang/outcome-adapter data/refusal-message\n   167\t                                                          (get data/data-module op))])))\n   168\t                       yang/library-adapters)]\n   169\t    (-> registry\n   170\t        (register-library-module 'kind yang/kind-module yang/kind-arities)\n   171\t        (register-library-module\n   172\t          'portable portable\n   173\t          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n   174\t                (keys portable))))))\n","exit_code":0,"status":"completed"}}
