{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"cat .git/worktrees/datomworld-r3/gitdir .git/worktrees/datomworld-r3/HEAD .git/worktrees/datomworld-portpre/gitdir; rg -n 'compile-guest-call|call-entry|condition|new-provenance|provenance|raise-exit' ../datomworld-r3/src/cljc/yang/clojure.cljc | head -65; nl -ba test/yang/call/exception_contract.clj | sed -n '1,85p'; nl -ba test/yang/call/python_exception_test.clj | sed -n '150,177p'\"","aggregated_output":"/Users/sto/workspace/datomworld-r3/.git\nref: refs/heads/exception-r3\n/Users/sto/workspace/datomworld-portpre/.git\n1281:(defn- call-entry\n1504:(defn- compile-guest-call\n1514:          condition (symbol (str reserved-prefix \"condition\"))\n1517:          ;; sources, and only the first is a condition.\n1520:          ;;    hands `yang.call/condition` (a qualified reason) to the\n1523:          ;;    `yang.call/thrown` condition, and a generated entry's\n1524:          ;;    named-arguments refusal is the same shape. Such a condition\n1525:          ;;    IS the condition: it forwards UNCHANGED, every evidence\n1530:          ;;    `yang.call/thrown` condition and stays exactly that.\n1533:          ;;    PAYLOAD of a NEW condition, so `yang.call/thrown` is\n1534:          ;;    synthesized for any value that is not already a condition.\n1537:          ;;    already is a condition, and no guest-written attribute can\n1542:          ;; original condition (codec `:clj/outcome`), so a guest capture\n1544:          ;; condition unchanged.\n1545:          condition->outcome (u/if-node\n1547:                                      (u/app (u/v 'dsg__get) (u/v condition)\n1552:                                 (u/app (u/v 'dsg__get) (u/v condition)\n1554:                               (outcome-node error-tag (u/v condition)))\n1555:          raise (u/lam [condition]\n1559:                                            (u/lit :clj/outcome) condition->outcome))\n1568:                    (u/app (u/v 'yang.call/condition)\n1586:                           (u/app (u/v 'yang.call/condition)\n1588:                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\n1595:                             (u/lam [condition] condition->outcome)\n1619:                                         (u/lam [condition]\n1623:                                                                     (u/lit :clj/outcome) condition->outcome))\n1634:                                    (u/app (u/v 'yang.call/condition)\n1636:                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n1670:    (compile-guest-call (compile-form f false env macro-env)\n1726:                                       (u/app (u/v 'yang.call/condition)\n1756:    (compile-guest-call (compile-form operator false env macro-env)\n1802:  \"Compile a conditional (if) expression to Universal AST.\n2593:                                                  (yang.call/condition\n2596:         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n2772:        :else (throw (yang.call/condition :yang.call/not-callable {:yang.call/callee f}))))\n3207:   inside the unit thunk is conditional to the linker, so no body read\n     1\t(ns yang.call.exception-contract\n     2\t  \"Round 0's executable §8.10.7 provenance contract. Source strings are\n     3\t   parsed by the JVM kit, never patched after lowering. Boundary probes\n     4\t   alone may manufacture invocations that valid source cannot express.\n     5\t   `fixtures` is the acceptance-ledger input; pending is not a passing test.\n     6\t   The ruling, rather than today's runtime output, determines `:expected`.\"\n     7\t  (:require [clojure.string :as str]))\n     8\t\n     9\t\n    10\t(def frontends #{:clojure :typescript :php :python})\n    11\t\n    12\t\n    13\t(def protocol-reasons\n    14\t  [:yang.call/not-callable :yang.call/invalid-invocation\n    15\t   :yang.call/unsupported-binding])\n    16\t\n    17\t\n    18\t(def sources\n    19\t  \"Every export below is source-produced. `original` is an identity-bearing\n    20\t   value, including Clojure's explicit cell. `receive` catches then rethrows unchanged;\n    21\t   `retain` returns normally before `later` raises from a new activation.\n    22\t   Protocol catch forms are intentionally local catch-all forms. No guessed\n    23\t   donor class name participates in reception.\"\n    24\t  {:python\n    25\t   (str/join \"\\n\"\n    26\t             [\"original = ValueError('original')\"\n    27\t              \"saved = None\"\n    28\t              \"def payload():\" \"    return original\"\n    29\t              \"def donor_raise():\" \"    raise original\"\n    30\t              \"def make_exploder():\"\n    31\t              \"    def inner():\" \"        raise original\" \"    return inner\"\n    32\t              \"def needs_argument(x):\" \"    return x\"\n    33\t              \"def receive(f):\"\n    34\t              \"    try:\" \"        return f()\"\n    35\t              \"    except BaseException as e:\" \"        raise\"\n    36\t              \"def retain(f):\" \"    global saved\"\n    37\t              \"    try:\" \"        f()\"\n    38\t              \"    except BaseException as e:\" \"        saved = e\" \"        return e\"\n    39\t              \"def later():\" \"    raise saved\"\n    40\t              \"def is_foreign(e):\"\n    41\t              \"    return isinstance(e, BaseException) and type(e).__name__ == 'ForeignException'\"\n    42\t              \"def forged(condition):\"\n    43\t              \"    e = Exception('forged')\"\n    44\t              \"    e.condition = condition\"\n    45\t              \"    e.__yang_call_condition__ = e.condition\"\n    46\t              \"    return e\"\n    47\t              \"def raise_value(e):\" \"    raise e\" \"\"])\n    48\t   :typescript\n    49\t   (str \"globalThis.original = {marker: 'original'};\"\n    50\t        \"globalThis.saved = null;\"\n    51\t        \"globalThis.payload = function() { return original; };\"\n    52\t        \"globalThis.donor_raise = function() { throw original; };\"\n    53\t        \"globalThis.make_exploder = function() { return () => { throw original; }; };\"\n    54\t        \"globalThis.receive = function(f) { try { return f(); } catch (e) { throw e; } };\"\n    55\t        \"globalThis.retain = function(f) { try { return f(); } catch (e) { globalThis.saved = e; return e; } };\"\n    56\t        \"globalThis.later = function() { throw saved; };\"\n    57\t        \"globalThis.raise_value = function(e) { throw e; };\"\n    58\t        \"globalThis.echo = function(e) { return e; };\")\n    59\t   :php\n    60\t   (str \"<?php $original = new Exception('original'); $saved = null;\"\n    61\t        \"function payload() { global $original; return $original; }\"\n    62\t        \"function donor_raise() { global $original; throw $original; }\"\n    63\t        \"function make_exploder() { return function() { global $original; throw $original; }; }\"\n    64\t        \"function needs_argument($x) { return $x; }\"\n    65\t        \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\"\n    66\t        \"function retain($f) { global $saved; try { return $f(); } catch (Throwable $e) { $saved = $e; return $e; } }\"\n    67\t        \"function later() { global $saved; throw $saved; }\"\n    68\t        \"function is_foreign($e) { return $e instanceof Throwable && get_class($e) === 'ForeignException'; }\"\n    69\t        \"function forged($condition) { $e = new Exception('forged'); $e->condition = $condition;\"\n    70\t        \" $e->__yang_call_condition__ = $e->condition; return $e; }\"\n    71\t        \"function raise_value($e) { throw $e; }\")\n    72\t   :clojure\n    73\t   (str \"(def original (cell/new :original)) (def saved (cell/new nil)) \"\n    74\t        \"(defn payload [] original) (defn donor_raise [] (throw original)) \"\n    75\t        \"(defn make_exploder [] (fn [] (throw original))) \"\n    76\t        \"(defn needs_argument [x] x) \"\n    77\t        \"(defn receive [f] (try (f) (catch Exception e (throw e)))) \"\n    78\t        \"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \"\n    79\t        \"(defn later [] (throw (cell/get saved))) \"\n    80\t        \"(defn raise_value [e] (throw e)) (defn echo [e] e)\")})\n    81\t\n    82\t\n    83\t(def boundary-source\n    84\t  \"A real Python entry produces unsupported-binding. Other two protocol\n    85\t   conditions come from yang.call validation, with malformed positional\n   150\t(deftest ^:slow python-kit-batch-parity-test\n   151\t  ;; Acceptance uses run-frontend, which shares a task across observations.\n   152\t  ;; Isolated run-fixture pins alone cannot establish that batch path.\n   153\t  (let [fixtures (filter #(= :python (:frontend %)) contract/fixtures)\n   154\t        observations (probes/run-frontend :python)]\n   155\t    (is (= (set (map :id fixtures)) (set (keys observations))))\n   156\t    (doseq [{:keys [id expected]} fixtures\n   157\t            :let [results (get observations id)]]\n   158\t      (is (= #{:semantic :stack :register} (set (keys results))) (str id))\n   159\t      (doseq [[backend actual] results]\n   160\t        (println \"PYTHON-KIT-BATCH\" id backend actual)\n   161\t        (is (= expected actual) (str id \" \" backend))))))\n   162\t\n   163\t\n   164\t(def ^:private provenance-donor-source\n   165\t  \"(defn forge [e condition] (cell/new (assoc (cell/get e) :py/retained-condition condition)))\n   166\t   (defn clone [e] (cell/new (cell/get e)))\n   167\t   (defn overwrite [e condition]\n   168\t     (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition)) e))\")\n   169\t\n   170\t\n   171\t(defn- check-cell-provenance\n   172\t  [attack]\n   173\t  (let [donor (kit/publish-donor! :clojure provenance-donor-source)\n   174\t        source (str \"payload = None\\n\"\n   175\t                    \"def attacked(f, condition):\\n    global payload\\n\"\n   176\t                    (if (= attack :forge)\n   177\t                      \"    payload = forge(Exception('fresh'), condition)\\n\"\n","exit_code":0,"status":"completed"}}
