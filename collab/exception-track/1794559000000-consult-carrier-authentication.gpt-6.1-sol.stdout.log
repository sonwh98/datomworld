14\t\n   215\t\n   216\t(deftest mint-held-provenance-survives-its-own-collection-test\n   217\t  (doseq [k (keys builders)]\n   218\t    (let [result (run-on k (new-cell (lit :payload)) 1000000)\n   219\t          payload-ref (vm/value result)\n   220\t          q (quiesce result)\n   221\t          q (assoc q :gc (assoc (:gc q) :since 0 :threshold 1))\n   222\t          {:keys [state]}\n   223\t          (engine/handle-effect q (module/make-effect :cell/new-provenance\n   224\t                                                       {:val :visible\n   225\t                                                        :provenance payload-ref})\n   226\t                                {})]\n   227\t      (testing (str k)\n   228\t        (is (zero? (:since (:gc state))) \"the mint allocation collected\")\n   229\t        (is (contains? (:heap state) (:id payload-ref))\n   230\t            \"the provenance was held as an extra root through the\n   231\t             allocation-triggered collection\")))))\n   232\t\n   233\t\n   234\t(deftest dropping-the-wrapper-reclaims-the-cluster-test\n   235\t  (doseq [k (keys builders)]\n   236\t    (let [[state wrapper-ref payload-ref] (minted-wrapper k)\n   237\t          dropped (engine/collect state)]\n   238\t      (testing (str k)\n   239\t        (is (not (contains? (:heap dropped) (:id wrapper-ref))))\n   240\t        (is (not (contains? (:heap dropped) (:id payload-ref)))\n   241\t            \"the payload cell reachable only through provenance is collected\n   242\t             once its wrapper is\")))))\n808:  \"The largest count an adapter admits for a native name with no declared\n809:   profile (`:native` given as a plain set).\"\n819:(defn- native-name?\n827:             (contains? (:native conv) sym)))))\n904:    [clj/handlers (fn [] (dsg__get (cell/get clj.rt/ctx) :handlers))]\n907:       (cell/set! clj.rt/ctx (dsg__assoc (cell/get clj.rt/ctx) :handlers hs)))]\n908:    [clj/restore! (fn [saved] (cell/set! clj.rt/ctx save