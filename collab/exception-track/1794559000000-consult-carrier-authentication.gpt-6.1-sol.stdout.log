\t               (rvm/create-vm ((:register images) ast)\n    53\t                              (assoc o :contract vm/register-contract)))})\n    54\t\n    55\t\n    56\t(defn- run-on\n    57\t  [k ast threshold]\n    58\t  (vm/run ((get builders k) ast (assoc opts :gc-threshold threshold))))\n    59\t\n    60\t\n    61\t(defn- on-every-vm\n    62\t  ([ast] (on-every-vm ast opts))\n    63\t  ([ast o]\n    64\t   (into {}\n    65\t         (map (fn [k]\n  2945\t;; its module's globals. No call node is rewritten and no foreign\n  2946\t;; `:code` is extracted: the unit is the program's own lowering,\n  2947\t;; wrapped.\n  2948\t\n  2949\t(def unit-opts\n  2950\t  \"The `compile-program` opts a linked unit compiles with: the\n  2951\t   argument-vector convention with the outcome model over the guest\n  2952\t   library's adapters, every VM primitive callable directly by bare name.\"\n  2953\t  {:convention :arg-vector,\n  2954\t   :outcomes true,\n  2955\t   :adapters library-adapters,\n  2956\t   :native vm/primitive-profiles})\n  2957\t\n  2958\t\n  2959\t(def top-defining-operators\n  2960\t  \"The operators whose second element names a top-level definition.\"\n    15\t  [callee args]\n    16\t  (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n    17\t\n    18\t\n    19\t(def ^:private boundary-donor\n    20\t  (delay (kit/publish-donor! :python contract/boundary-source)))\n    21\t\n    22\t\n    23\t(defn- transfer-summary\n    24\t  [result]\n    25\t  {:transferred (list '= (list 'get result :route) :raise)\n    26\t   :once (list '= 1 (list 'get result :transfers))\n    27\t   :after (list 'get result :after)})\n    28\t\n    29\t\n    30\t(defn- reason\n    31\t  [result]\n    32\t  (list 'get (list 'get result :condition) :yang.call/reason))\n    33\t\n    34\t\n    35\t(defn- payload\n    36\t  [result]\n    37\t  (list 'get (list 'get result :condition) :yang.call/value))\n    38\t\n    39\t\n    40\t(defn- protocol-condition\n    41\t  [reason]\n    42\t  (let [target (read-export :python \"boundary_target\")]\n    43\t    (list 'get\n    44\t          (case reason\n    45\t            :yang.call/not-callable (call {} [])\n    46\t            :yang.call/invalid-invocation\n    47\t            (kit/boundary-call-form target :malformed-positional [])\n    48\t            :yang.call/unsupported-binding\n    49\t            (kit/boundary-call-form target [] []\n    50\t                                    {:yang.call/binding-profile :contract/unsupported}))\n    51\t          :condition)))\n    52\t\n    53\t\n    54\t(defn- injected\n    55\t  [condition]\n    56\t  ;; This is a boundary delivery fixture, never counted as a real-source\n    64\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    65\t   the `trailing` UAST nodes.\"\n    66\t  [defs trailing]\n    67\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    68\t                  trailing)))\n    69\t\n    70\t\n    71\t(defn exports\n    72\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    73\t   stripped.\"\n    74\t  [ns-str definitions]\n    75\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    76\t             definitions)))\n    77\t\n    78\t\n    79\t(defn free-names\n    80\t  \"Every variable name some occurrence of the map AST `ast` reads\n    81\t   unbound by an enclosing lambda.\"\n","exit_code":0,"status":"completed"}}
