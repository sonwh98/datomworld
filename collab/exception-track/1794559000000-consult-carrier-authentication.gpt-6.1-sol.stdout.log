  (receive (fn [] (throw original)) original)]\n  1832\t               library-opts lane 1000000))\n  1833\t          (str lane \": (= e original) for a cell payload\"))))\n  1834\t  (testing \"(A) protocol: the retained wrapper answers its condition's\n  1835\t            accessors, and a saved wrapper rethrows it byte-identical\"\n  1836\t    (doseq [lane [:walker :semantic]]\n  1837\t      (let [condition {:yang.call/reason :yang.call/not-callable\n  1838\t                       :yang.call/data {:yang.call/callee :target}}]\n  1839\t        (is (= [:yin.k/ok [:yang.call/not-callable {:yang.call/callee :target}]]\n  1840\t               (run-cell-program\n  1841\t                 '[(defn receive\n  1842\t                     [f]\n  1843\t                     (try (f)\n  1844\t                          (catch Exception e\n  1845\t                            [(:yang.call/reason e) (get e :yang.call/data)])))\n  1846\t                   (receive marker-operand)]\n  1847\t                 (cell-entry-node condition)\n  1848\t                 lane))\n  1849\t            (str lane \": reason and data read through the wrapper\"))\n  1850\t        (is (= [:yin.k/error condition]\n  1851\t               (run-cell-program\n  1852\t                 '[(def saved (cell/new nil))\n  1853\t                   (defn retain\n  1854\t                     [f]\n  1855\t                     (try (f) (catch Exception e (cell/set! saved e) e)))\n  1856\t                   (defn later\n  1857\t                     []\n  1858\t                     (throw (cell/get saved)))\n  1859\t                   (let [retained (retain marker-operand)]\n  1860\t                     (later))]\n  1861\t                 (cell-entry-node condition)\n  1862\t                 lane))\n  1863\t            (str lane \": saved retain then rethrow forwards byte-identical\")))))\n  1864\t  ;; The forged-retention probes are RETIRED with the :retained cell seam\n  1865\t  ;; (owner NO, decision 1794372000000). Unde