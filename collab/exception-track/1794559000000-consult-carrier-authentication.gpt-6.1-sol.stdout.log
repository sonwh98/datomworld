n [] (get (cell/get clj.rt/ctx) :handlers))]\\nsrc/cljc/yang/clojure/prelude.cljc:109:    [clj/set-handlers!\\nsrc/cljc/yang/clojure/prelude.cljc:110:     (fn [hs] (cell/set! clj.rt/ctx (assoc (cell/get clj.rt/ctx) :handlers hs)))]\\nsrc/cljc/yang/clojure/prelude.cljc:118:       (cell/set! clj.rt/ctx (assoc (cell/get clj.rt/ctx) :handlers (get hs 2))))]\\nsrc/cljc/yang/clojure/prelude.cljc:119:    [clj/raise\\nsrc/cljc/yang/clojure/prelude.cljc:120:     ;; deliver `e` to the current handler stack; with no handler above it\\nsrc/cljc/yang/clojure/prelude.cljc:122:     ;; installs a top-level handler). A :finally frame runs its thunk with\\nsrc/cljc/yang/clojure/prelude.cljc:125:       (let [hs (clj/handlers)]\\nsrc/cljc/yang/clojure/prelude.cljc:127:           (:clj/no-handler e)\\nsrc/cljc/yang/clojure/prelude.cljc:129:             (do (clj/pop-frame hs) ((get hs 1) e) (clj/raise e))\\nsrc/cljc/yang/clojure/prelude.cljc:133:     ;; wrapping, so it is `clj/raise` under the guest name\\nsrc/cljc/yang/clojure/prelude.cljc:134:     (fn [e] (clj/raise e))]\\nsrc/cljc/yang/clojure/prelude.cljc:138:       (let [hs (clj/handlers)]\\nsrc/cljc/yang/clojure/prelude.cljc:147:     (fn [body handler]\\nsrc/cljc/yang/clojure/prelude.cljc:153:                  (clj/set-handlers! (clj/frame :handler r (get saved :handlers)))\\nsrc/cljc/yang/clojure/prelude.cljc:155:              (do (clj/restore! saved) (handler r))))\\nsrc/cljc/yang/clojure/prelude.cljc:162:         (do (clj/set-handlers! (clj/frame :finally fin (get saved :handlers)))\\nsrc/cljc/yang/clojure/prelude.cljc:173:                       (do (clj/unwind-to (clj/frame-depth (get saved :handlers)))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n19:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1160,1265p' src/cljc/yang/clojure.cljc; sed -n '2250,2405p' src/cljc/yang/clojure.cljc; sed -n '1450,1515p' test/yang/clojure_test.clj; sed -n '1860,1915p' test/yang/clojure_test.clj\\\"\",\"aggregated_output\":\"            (reverse arities))))\\n\\n\\n(defn- check-av-params!\\n  [params]\\n  (when-not (vector? params)\\n    (reject! \\\"fn parameters must be a vector\\\" {:params params}))\\n  (doseq [p params]\\n    (when (= '& p)\\n      (reject! \\\"Variadic fn parameters are not supported\\\" {:params params}))\\n    (check-binder! p params)))\\n\\n\\n(defn- outcome-node\\n  [tag value]\\n  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\\n\\n\\n(defn- call-entry\\n  \\\"The unary public entry, closed over a private argument-vector body. It\\n   installs the exception bridge (`clj/try`) before argument binding, so an\\n   escaping raise from the body or a binding failure delivers\\n   `{:yang.call/reason :yang.call/thrown :yang.call/value v}` to the caller's\\n   raise exit exactly once (§8.10.8 cleanup first, then the caller's raise).\\\"\\n  []\\n  (let [body (symbol (str reserved-prefix \\\"body\\\"))\\n        invocation (symbol (str reserved-prefix \\\"invocation\\\"))\\n        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\\n        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\\n        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\\n        binding-error (u/app\\n                        (u/v 'clj/throw)\\n                        (u/app (u/v 'dsg__assoc) (u/lit {})\\n                               (u/lit :yin.k/message)\\n                               (u/lit \\\"Clojure functions do not accept named arguments\\\")\\n                               (u/lit :yin.k/data)\\n                               (u/app (u/v 'dsg__assoc) (u/lit {})\\n                                      (u/lit :yang.call/named) named)))\\n        forged-refusal (u/app\\n                         (u/v 'clj/throw)\\n                         (u/lit {:yin.k/message\\n                                 \\\"Invocation is neither an authenticated packet nor an invocation record\\\"\\n                                 :yin.k/data {}}))\\n        ;; The record path: bind and run the body under clj/try, delivering\\n        ;; any raise (a body throw or the binding failure) as a fresh\\n        ;; :yang.call/thrown condition to the caller's raise exit.\\n        entry-body (u/app\\n                     (u/v 'clj/try)\\n                     (u/lam [] (u/if-node (u/app (u/v 'dsg__empty) named)\\n                                          (u/app (u/v body) positional)\\n                                          binding-error))\\n                     (u/lam ['dsg__e]\\n                            (u/app raise (u/app (u/v 'yang.call/thrown) (u/v 'dsg__e)))))\\n        ;; The private lane forwards the body's plain value in tail position\\n        ;; (a raise from it propagates to the caller's own handler — the lane\\n        ;; installs no bridge). The compiler's token packet, a two-element\\n        ;; vector [token args], selects it on the SAME unary entry. A guest\\n        ;; cannot forge the token; maps keep the ordinary record path.\\n        packet (u/if-node\\n                 (u/app (u/v 'data/vector?) (u/v invocation))\\n                 (u/if-node\\n                   (u/app (u/v 'dsg__equal)\\n                          (u/app (u/v 'data/count) (u/v invocation))\\n                          (u/lit 2))\\n                   (u/if-node\\n                     (u/app (u/v 'dsg__equal)\\n                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\\n                            (u/v 'dsg__call_token))\\n                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\\n                     forged-refusal)\\n                   forged-refusal)\\n                 entry-body)\\n        entry (u/lam [invocation] packet)]\\n    (u/lam [body] entry)))\\n\\n\\n(defn- admit-call-descriptor\\n  \\\"Admit a descriptor constructed by trusted UAST/profile code. This is not\\n   a source form: entry-spelled source maps never pass through this constructor.\\\"\\n  [descriptor-ast tail?]\\n  (let [descriptor-name 'dsg__descriptor\\n        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\\n                         (u/lit :clj/admission) (u/lit nil))\\n        ;; The factory closure captures the canonical descriptor and private\\n        ;; token. Projection reconstructs and compares that opaque closure;\\n        ;; it never applies a source-supplied predicate. An equal immutable\\n        ;; reconstruction is the same value, not admission of different data.\\n        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\\n        published (u/let1 descriptor-name canonical\\n                          (u/app (u/v 'dsg__assoc) (u/v descriptor-name)\\n                                 (u/lit :clj/admission) witness))]\\n    (cond-> (u/mark-tails published)\\n      tail? (assoc :tail? true))))\\n\\n\\n(defn- compile-call-descriptor\\n  \\\"Publish a private body through a canonical constructor-created entry.\\\"\\n  [body-ast tail?]\\n  (admit-call-descriptor\\n    (u/app (u/v 'dsg__assoc) (u/lit {})\\n           (u/lit :yang.call/entry) (u/app (u/v 'dsg__make_entry) body-ast)\\n           (u/lit :clj/type) (u/lit :function))\\n    tail?))\\n\\n\\n(defn- compile-av-fn\\n                     (let [[_ name value] head\\n                           value (if (outcomes? env)\\n                                   (lower-function-body env macro-env [] [value])\\n                                   value)]\\n                       (cond-> {:type     :application\\n                                :operator {:type :lambda, :params ['_]\\n                                           :body (go rest-forms macro-env)}\\n                                :operands [(discard-result (compile-def name value env false macro-env))]}\\n                         tail? (assoc :tail? true)))\\n                     ;; single form\\n                     (= 1 (count forms))\\n                     (compile-form head tail? (assoc env ::top-level true) macro-env)\\n                     ;; sequence\\n                     :else\\n                     (cond-> {:type     :application\\n                              :operator {:type :lambda, :params ['_]\\n                                         :body (go rest-forms macro-env)}\\n                              :operands [(discard-result\\n                                           (compile-form head false\\n                                                         (assoc env ::top-level true) macro-env))]}\\n                       tail? (assoc :tail? true))))))]\\n       (annotate-call-sites\\n         (cond->> (go forms initial-macro-env)\\n           (outcomes? env) top-boundary\\n           ;; The two sibling closures share one frame: separate bindings would\\n           ;; retain one extra helper environment in every closure a guest\\n           ;; captures (the machine-data validation bound notices).\\n           (outcomes? env) (#(u/app\\n                               (u/lam '[dsg__admitted? dsg__intra_call] %)\\n                               (u/sexp->uast\\n                                 '(fn [dsg__candidate]\\n                                    (if (data/map? dsg__candidate)\\n                                      ;; A map is offered to the dereference\\n                                      ;; only when the heap authenticates it\\n                                      ;; (ruling of record, rule 2), as the\\n                                      ;; descriptor projection treats a\\n                                      ;; cell-backed callable\\n                                      ;; (yang.antlr.md 8.10.2), whose entry\\n                                      ;; lives in the cell contents. The\\n                                      ;; issued format (`:type :cell-ref`,\\n                                      ;; `:id`, `:seal`, no other entries, a\\n                                      ;; 64-character string seal) is only\\n                                      ;; the pre-filter for WHEN to ask;\\n                                      ;; `cell/authentic?` — the issuer's\\n                                      ;; own heap+seal answer — decides, so\\n                                      ;; any `:id` spelling may be asked\\n                                      ;; about and the r4 heap-id-language\\n                                      ;; discriminator is retired. A shape\\n                                      ;; the heap does not authenticate is\\n                                      ;; data: it falls to the witness\\n                                      ;; branch and, entryless, is no more\\n                                      ;; admitted than any other source map,\\n                                      ;; so its invocation stays ordinary\\n                                      ;; map data. An authenticated\\n                                      ;; reference dereferences; an\\n                                      ;; authenticated cell whose contents\\n                                      ;; carry no callable entry is not\\n                                      ;; admitted (authentication is not\\n                                      ;; authorization, rule 3), and the\\n                                      ;; call-site routing that consulted\\n                                      ;; here refuses it as not-callable.\\n                                      (let [dsg__cell-ref?\\n                                            (if (dsg__equal\\n                                                  (dsg__get dsg__candidate :type)\\n                                                  :cell-ref)\\n                                              (if (data/contains? dsg__candidate\\n                                                                  :id)\\n                                                (if (data/contains? dsg__candidate\\n                                                                    :seal)\\n                                                  (if (dsg__equal\\n                                                        (data/count dsg__candidate)\\n                                                        3)\\n                                                    (if (data/string?\\n                                                          (dsg__get dsg__candidate\\n                                                                    :seal))\\n                                                      (if (dsg__equal\\n                                                            (data/str-length\\n                                                              (dsg__get dsg__candidate\\n                                                                        :seal))\\n                                                            64)\\n                                                        true\\n                                                        false)\\n                                                      false)\\n                                                    false)\\n                                                  false)\\n                                                false)\\n                                              false)]\\n                                        (if dsg__cell-ref?\\n                                          (if (cell/authentic? dsg__candidate)\\n                                            (let [dsg__descriptor\\n                                                  (cell/get dsg__candidate)\\n                                                  dsg__entry\\n                                                  (dsg__get dsg__descriptor\\n                                                            :yang.call/entry)]\\n                                              (data/callable? dsg__entry))\\n                                            false)\\n                                          (let [dsg__entry\\n                                                (dsg__get dsg__candidate\\n                                                          :yang.call/entry)\\n                                                dsg__witness\\n                                                (dsg__get dsg__candidate\\n                                                          :clj/admission)]\\n                                            (if (data/callable? dsg__entry)\\n                                              (if (data/callable? dsg__witness)\\n                                                (dsg__equal\\n                                                  dsg__witness\\n                                                  (dsg__make_admission\\n                                                    (dsg__assoc dsg__candidate\\n                                                                :clj/admission\\n                                                                nil)))\\n                                                false)\\n                                              false))))\\n                                      false)))\\n                               ;; The intra-unit dispatcher: resolve the unit's public entry,\\n                               ;; apply it with the compiler's token packet [token args] - one\\n                               ;; variadic conj and one application, no record construction.\\n                               ;; Non-map callees refuse.\\n                               (u/sexp->uast\\n                                 (list 'fn '[dsg__callee dsg__args]\\n                                       (list 'if '(data/map? dsg__callee)\\n                                             (list (list (if (contains? (::defined env) 'get)\\n                                                           'dsg__get\\n                                                           'get)\\n                                                         'dsg__callee\\n                                                         :yang.call/entry)\\n                                                   (list 'conj '[]\\n                                                         'dsg__call_token\\n                                                         'dsg__args))\\n                                             '(clj/raise\\n                                                (yang.call/condition\\n                                                  :yang.call/not-callable\\n                                                  (dsg__assoc {} :yang.call/callee dsg__callee))))))))\\n           (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\\n           (outcomes? env) (u/let1\\n                             'dsg__make_admission\\n                             (u/sexp->uast\\n                               '(fn [dsg__descriptor]\\n                                  (fn [dsg__candidate]\\n                                    (if (data/callable? dsg__call_token)\\n                                      (dsg__get dsg__descriptor :yang.call/entry)\\n                                      nil)))))\\n           ;; The exception accessors and the continuation family. The\\n           ;; `dsg__ex_message`/`dsg__ex_data` accessors read the portable\\n           ;; ex-info map; the continuation family (`clj/try`, `clj/throw`,\\n           ;; `clj/raise`, ...) is the port's `%capture` handler-stack scheme,\\n           ;; emitted inline (the linked runtime binds the same family from the\\n           ;; prelude). Its capture-sensitive primitives are the `dsg__*`\\n           ;; names bound outside it.\\n           (outcomes? env) (u/let1 'dsg__ex_message\\n                                   (u/sexp->uast ex-message-form))\\n           (outcomes? env) (u/let1 'dsg__ex_data\\n                                   (u/sexp->uast ex-data-form))\\n           (outcomes? env) (u/then\\n                             (discard-result continuation-uast))\\n           (outcomes? env) (u/then\\n                             (discard-result\\n      (is (= [:yin.k/ok :yang.call/not-callable]\\n             (run-profile-outcome\\n               '[(let [condition (yang.call/invoke 5 [21] [] profile-raise)]\\n                   (get condition :yang.call/reason))]))))))\\n\\n\\n;; =============================================================================\\n;; The exception track, Clojure round R3: protocol failures retain and\\n;; forward the complete condition (ruling v2, §R3; design §8.10.7)\\n;; =============================================================================\\n\\n(declare run-cell-program)\\n(declare run-library library-opts)\\n\\n\\n(defn- cell-entry-node\\n  [condition]\\n  (u/app (u/v 'cell/new)\\n         (u/app (u/v 'assoc) (u/lit {})\\n                (u/lit :yang.call/entry)\\n                (u/lam ['invocation]\\n                       (u/app (u/app (u/v 'dsg__get) (u/v 'invocation) (u/lit :yang.call/raise))\\n                              (u/lit condition))))))\\n\\n\\n(deftest test-exception-r3-protocol-condition-forwarded-unchanged\\n  (testing \\\"a protocol failure delivered to the guest's own raise continuation\\n            is caught and rethrown unchanged: the complete original condition,\\n            qualified reason AND plain evidence, with no :yang.call/thrown\\n            wrapper (ruling R3: the call site no longer reclassifies)\\\"\\n    (doseq [lane [:walker :semantic]]\\n      (doseq [[reason evidence]\\n              [[:yang.call/not-callable {:yang.call/callee 5}]\\n               [:yang.call/invalid-invocation {:yang.call/callee :target}]\\n               [:yang.call/unsupported-binding\\n                {:yang.call/binding-profile :contract/unsupported}]]]\\n        (is (= [:yin.k/error {:yang.call/reason reason :yang.call/data evidence}]\\n               (run-cell-program\\n                 '[(defn receive\\n                     [f]\\n                     (try (f) (catch Exception e (throw e))))\\n                   (receive marker-operand)]\\n                 (cell-entry-node {:yang.call/reason reason :yang.call/data evidence})\\n                 lane))\\n            (str lane \\\" \\\" reason \\\" forwards the condition the convention built, with\\n                 its evidence, unchanged\\\")))))\\n  (testing \\\"(A): an ordinary thrown condition delivers its payload raw;\\n            evidence beyond `:yang.call/value` is not retained across a\\n            call site - the wire condition is reconstructible from the\\n            payload as a fresh thrown condition at a public entry\\\"\\n    (doseq [lane [:walker :semantic]]\\n      (let [condition {:yang.call/reason :yang.call/thrown\\n                       :yang.call/value {:foreign/payload :identity}\\n                       :yang.call/data {:complete [:extra :evidence]}}]\\n        (is (= [:yin.k/error {:foreign/payload :identity}]\\n               (run-cell-program\\n                 '[(defn run\\n                     [f]\\n                     (f))\\n                   (run marker-operand)]\\n                 (cell-entry-node condition)\\n                 lane))\\n            (str lane \\\": an escaping thrown condition delivers its payload\\\"))\\n        (is (= [:yin.k/error {:foreign/payload :identity}]\\n               (run-cell-program\\n                 '[(defn receive\\n                     (later))]\\n                 (cell-entry-node condition)\\n                 lane))\\n            (str lane \\\": saved retain then rethrow forwards byte-identical\\\")))))\\n  ;; The forged-retention probes are RETIRED with the :retained cell seam\\n  ;; (owner NO, decision 1794372000000). Under the continuation encoding\\n  ;; there is no retention object: a caught protocol condition is the plain\\n  ;; condition map (data), and a guest copy of it is ordinary data, never an\\n  ;; authenticated carrier. The replay/mutation hole the retention object\\n  ;; plugged dies with it — the raise