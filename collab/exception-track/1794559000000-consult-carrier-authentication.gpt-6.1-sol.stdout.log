{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '190,225p;865,960p;1010,1085p'; nl -ba test/yang/call/python_exception_test.clj | sed -n '1,220p'\"","aggregated_output":"   190\t\n   191\t#?(:clj\n   192\t   (defmacro defquoted\n   193\t     \"`def` of the quoted data `form`.  ClojureDart compiles quoted data to\n   194\t      straight-line Dart (this prelude is about 65,000 lines of it), which the\n   195\t      Dart AOT compiler cannot take as one initializer, so there the data is\n   196\t      one EDN string read back at load.\"\n   197\t     [name doc form]\n   198\t     (if (find-ns 'cljd.compiler)\n   199\t       (list 'def name doc (list 'edn/read-string (pr-str (second form))))\n   200\t       (list 'def name doc form))))\n   201\t\n   202\t\n   203\t(def host-names\n   204\t  \"Module exports the prelude calls.\"\n   205\t  (into '#{cell/new cell/get cell/set! cell/dsg__new-provenance cell/dsg__provenance\n   206\t           data/count data/into data/subvec\n   207\t           data/number? data/contains? data/dissoc data/str-concat data/str-length\n   208\t           data/str-index-of data/str->code-points data/code-points->str\n   209\t           data/float64 data/float-value data/content=\n   210\t           integer/add integer/sub integer/neg integer/mul integer/compare\n   211\t           integer/to-float integer/compare-float integer/true-div\n   212\t           integer/pow integer/shift-right integer/bit-and\n   213\t           integer/bit-or integer/bit-xor integer/bit-not integer/from-float\n   214\t           integer/floor-div-mod integer/shift-left integer/format integer/parse\n   215\t           integer/float-digits integer/decimal->float integer/max-digits\n   216\t           data/substring data/max-items}\n   217\t        call/host-names))\n   218\t\n   219\t\n   220\t(defquoted ^:private core-definitions\n   221\t  \"Pure definitions: lambdas only, so defining them runs nothing.\"\n   222\t  '[;; ---------------------------------------------------------------- kinds\n   223\t    [py/cell? (fn [x] (= (get x :type) :cell-ref))]\n   224\t    [py/str? (fn [x] (not (nil? (get x :py/str))))]\n   225\t    [py/str (fn [s] (assoc {} :py/str s))]\n   865\t    [py/global-or\n   866\t     ;; the module's binding when present, else `builtin`: used for\n   867\t     ;; `globals`, whose value is per module and so not in the builtins dict\n   868\t     (fn [g n builtin]\n   869\t       (let [c (cell/get g)\n   870\t             slot (get (get c :index) n :py/missing)]\n   871\t         (if (= slot :py/missing) builtin (get (get c :vals) slot))))]\n   872\t    [py/class-ns-get\n   873\t     ;; a name assigned in a class body, read in that body: the class\n   874\t     ;; namespace as it is now, else `fallback` (globals, then builtins)\n   875\t     (fn [cls name fallback]\n   876\t       (let [x (get (get (cell/get cls) :attrs) name :py/missing)]\n   877\t         (if (= x :py/missing) (fallback) x)))]\n   878\t\n   879\t    ;; ---------------------------------------------------------- functions\n   880\t    ;; A function's `spec` is static data from the lowering:\n   881\t    ;;   {:params [positional names] :star? bool :kwonly [names] :kwstar? bool}\n   882\t    ;; `defaults` holds the trailing positional defaults and `kwdefaults`\n   883\t    ;; [[name value] ...] the keyword-only ones, both evaluated at\n   884\t    ;; definition time. `code` takes one vector laid out as the parameters\n   885\t    ;; are written: positional, the *args tuple, keyword-only, the **kwargs\n   886\t    ;; dict.\n   887\t    [py/function-entry\n   888\t     ;; Generated boilerplate. Python functions are unbound here: a supplied\n   889\t     ;; receiver remains in the invocation but is not injected into args.\n   890\t     (fn [owner invocation]\n   891\t       (let [callee (get invocation :yang.call/callee :py/missing)\n   892\t             positional (get invocation :yang.call/positional :py/missing)\n   893\t             named (get invocation :yang.call/named :py/missing)\n   894\t             raise-exit (get invocation :yang.call/raise :py/missing)\n   895\t             binding-profile (get invocation :yang.call/binding-profile :py/missing)]\n   896\t         (if (if (= callee :py/missing) true\n   897\t                 (if (= positional :py/missing) true\n   898\t                     (if (= named :py/missing) true\n   899\t                         (if (= raise-exit :py/missing) true\n   900\t                             (not (= callee owner))))))\n   901\t           (raise-exit {:yang.call/reason :yang.call/invalid-invocation})\n   902\t           (if (not (= binding-profile :py/missing))\n   903\t             (raise-exit (assoc {:yang.call/reason :yang.call/unsupported-binding}\n   904\t                                :yang.call/binding-profile binding-profile))\n   905\t             (let [fc (cell/get owner)\n   906\t                   result (cell/new :py/None)]\n   907\t               (py/try\n   908\t                 (fn []\n   909\t                   (cell/set! result\n   910\t                              ((get fc :code)\n   911\t                               (py/bind-args fc positional named))))\n   912\t                 (fn [e]\n   913\t                   ;; A retained generated exception forwards its original\n   914\t                   ;; condition unchanged (no new wrapper); a fresh source\n   915\t                   ;; exception still becomes the plain §8.10.7 thrown\n   916\t                   ;; condition. Retention rides the exception's identity,\n   917\t                   ;; outside source-writable attributes.\n   918\t                   (let [retained (cell/dsg__provenance e)]\n   919\t                     (raise-exit\n   920\t                       (if (nil? retained)\n   921\t                         (assoc {:yang.call/reason :yang.call/thrown}\n   922\t                                :yang.call/value e)\n   923\t                         retained))))\n   924\t                 (fn [] (cell/get result))))))))]\n   925\t    [py/function-cell\n   926\t     (fn [name spec defaults kwdefaults code entry?]\n   927\t       (let [content (assoc (assoc (assoc (assoc (assoc (assoc {} :py/type :function)\n   928\t                                                        :name name)\n   929\t                                                 :spec spec)\n   930\t                                          :defaults defaults)\n   931\t                                   :kwdefaults kwdefaults)\n   932\t                            :code code)\n   933\t             f (cell/new content)]\n   934\t         (if entry?\n   935\t           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\n   936\t                                   (fn [invocation]\n   937\t                                     (py/function-entry f invocation))))\n   938\t               f)\n   939\t           f)))]\n   940\t    [py/make-function\n   941\t     (fn [name spec defaults kwdefaults code]\n   942\t       (py/function-cell name spec defaults kwdefaults code true))]\n   943\t    [py/make-builtin-function\n   944\t     (fn [name spec defaults kwdefaults code]\n   945\t       (py/function-cell name spec defaults kwdefaults code false))]\n   946\t    [py/fn-error\n   947\t     (fn [fc msg] (py/type-error (py/str (data/str-concat (get fc :name) msg))))]\n   948\t    [py/index-of\n   949\t     (fn [xs x i]\n   950\t       (let [y (get xs i :py/stop)]\n   951\t         (if (= y :py/stop) -1 (if (= y x) i (py/index-of xs x (+ i 1))))))]\n   952\t    [py/pad\n   953\t     ;; the first n of xs, :py/missing where xs is shorter\n   954\t     (fn [xs n i acc]\n   955\t       (if (< i n) (py/pad xs n (+ i 1) (conj acc (get xs i :py/missing))) acc))]\n   956\t    [py/bind-keyword\n   957\t     ;; state is [positional-slots kwonly-slots kwargs-dict-or-nil]\n   958\t     (fn [fc state name x]\n   959\t       (let [spec (get fc :spec)\n   960\t             pi (py/index-of (get spec :params) name 0)\n  1010\t             (let [d (py/lookup-pair (get fc :kwdefaults) nm 0)]\n  1011\t               (if (= d :py/missing)\n  1012\t                 (py/fn-error fc (data/str-concat\n  1013\t                                   \"() missing required keyword-only argument '\"\n  1014\t                                   nm \"'\"))\n  1015\t                 (py/fill-kwdefaults fc (assoc slots i d) names (+ i 1))))\n  1016\t             (py/fill-kwdefaults fc slots names (+ i 1))))))]\n  1017\t    [py/bind-args\n  1018\t     ;; positional, then keywords, then defaults; every failure a TypeError\n  1019\t     (fn [fc args kwargs]\n  1020\t       (let [spec (get fc :spec)\n  1021\t             n (data/count (get spec :params))\n  1022\t             given (data/count args)\n  1023\t             star (get spec :star?)]\n  1024\t         (if (if (get spec :no-kw) (< 0 (data/count kwargs)) false)\n  1025\t           (py/fn-error fc \"() takes no keyword arguments\")\n  1026\t           (if (if (< n given) (not star) false)\n  1027\t             (py/fn-error fc \"() takes too many positional arguments\")\n  1028\t             (let [state (py/bind-keywords\n  1029\t                           fc\n  1030\t                           (py/vconj (py/vconj (py/vconj [] (py/pad args n 0 []))\n  1031\t                                               (py/pad [] (data/count (get spec :kwonly)) 0 []))\n  1032\t                                     (if (get spec :kwstar?) (py/dict-new) nil))\n  1033\t                           kwargs\n  1034\t                           0)\n  1035\t                   slots (py/fill-defaults fc (get state 0) (get fc :defaults) n 0)\n  1036\t                   ko (py/fill-kwdefaults fc (get state 1) (get spec :kwonly) 0)\n  1037\t                   with-star (if star\n  1038\t                               (py/vconj slots\n  1039\t                                         (py/tuple (if (< n given) (data/subvec args n) [])))\n  1040\t                               slots)\n  1041\t                   with-ko (data/into with-star ko)]\n  1042\t               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\n  1043\t    [py/call (fn [f args] (py/call-kw f args []))]\n  1044\t    [dsg__condition-exception\n  1045\t     ;; The privileged mint: a generated exception whose complete original\n  1046\t     ;; condition rides the VM provenance slot, outside source-writable\n  1047\t     ;; :attrs. Attribute edits and leaving the creating activation preserve\n  1048\t     ;; it; reachability of the exception retains the whole condition/payload.\n  1049\t     ;; Only this constructor mints through the reserved door; it is a\n  1050\t     ;; compiler-private (`dsg__`) name, outside guest exports, projections,\n  1051\t     ;; and aliases, so no guest can mint arbitrary provenance.\n  1052\t     (fn [cls msg condition]\n  1053\t       (if (data/map? condition)\n  1054\t         (cell/dsg__new-provenance (cell/get (py/make-exc cls msg)) condition)\n  1055\t         (py/make-exc py.b/TypeError condition)))]\n  1056\t    [py/call-kw\n  1057\t     (fn [f args kwargs]\n  1058\t       (if (= (get f :py/type) :method)\n  1059\t         (py/call-kw (get f :fn) (data/into (py/vconj [] (get f :self)) args) kwargs)\n  1060\t         (if (= (py/content-type f) :class)\n  1061\t           (py/instantiate f args kwargs)\n  1062\t           (if (yang.call/eligible? f)\n  1063\t             (yang.call/invoke\n  1064\t               f args kwargs\n  1065\t               (fn [condition]\n  1066\t                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\n  1067\t                   (let [value (get condition :yang.call/value)]\n  1068\t                     (py/raise\n  1069\t                       (if (if (= (py/content-type value) :instance)\n  1070\t                             (py/subclass? (get (cell/get value) :class)\n  1071\t                                           py.b/BaseException)\n  1072\t                             false)\n  1073\t                         value\n  1074\t                         ;; A local hierarchy and fixed local message: neither\n  1075\t                         ;; foreign class names nor foreign methods participate.\n  1076\t                         (dsg__condition-exception\n  1077\t                           (py/make-class \"ForeignException\" py.b/Exception)\n  1078\t                           {:py/str \"foreign exception\"} condition))))\n  1079\t                   (py/raise\n  1080\t                     (dsg__condition-exception py.b/TypeError\n  1081\t                                               {:py/str \"object is not callable\"}\n  1082\t                                               condition)))))\n  1083\t             (if (= (py/content-type f) :function)\n  1084\t               (let [fc (cell/get f)]\n  1085\t                 ((get fc :code) (py/bind-args fc args kwargs)))\n     1\t(ns yang.call.python-exception-test\n     2\t  \"Python boundary pins for ruling v2 R2/R3 + egress. Receivers and rethrows\n     3\t   are parsed source; malformed protocol delivery uses the shared boundary kit.\n     4\t   The focused local gate for the exception-py-r2r3 round: the python subset of\n     5\t   the shiva acceptance instrument, never a substitute for the full ledger.\"\n     6\t  (:require [clojure.string :as str]\n     7\t            [clojure.test :refer [deftest is testing]]\n     8\t            [yang.call.conformance :as kit]\n     9\t            [yang.call.exception-contract :as contract]\n    10\t            [yang.call.exception-legs :as legs]\n    11\t            [yang.call.exception-probes :as probes]\n    12\t            [yang.python.antlr.prelude :as py-prelude]))\n    13\t\n    14\t\n    15\t(defn- check-fixture\n    16\t  \"Run one python fixture isolated on all three vector VMs and assert its\n    17\t   compliant `:expected` value on each backend.\"\n    18\t  [id]\n    19\t  (let [fixture (first (filter #(= id (:id %)) contract/fixtures))]\n    20\t    (testing (str id)\n    21\t      (doseq [[backend actual] (probes/run-fixture fixture)]\n    22\t        (is (= (:expected fixture) actual) (str backend))))))\n    23\t\n    24\t\n    25\t(defn- check-leg\n    26\t  \"Run one directed source pair/scenario and assert `legs/expected` per VM.\"\n    27\t  [id]\n    28\t  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\n    29\t    (testing (str id)\n    30\t      (doseq [[backend actual] (legs/run-leg leg)]\n    31\t        (is (= (legs/expected leg) actual) (str backend))))))\n    32\t\n    33\t\n    34\t(deftest python-provenance-export-surface-test\n    35\t  (let [private-names '#{dsg__condition-exception cell/dsg__new-provenance\n    36\t                         cell/dsg__provenance}\n    37\t        exposed? (fn [x]\n    38\t                   (some #(str/includes? (str x) %)\n    39\t                         [\"dsg__\" \"provenance\" \"condition-exception\"]))\n    40\t        public-private-users\n    41\t        (into #{}\n    42\t              (keep (fn [[k form]]\n    43\t                      (when (and (= \"py\" (namespace k))\n    44\t                                 (some private-names (tree-seq coll? seq form)))\n    45\t                        k)))\n    46\t              py-prelude/definitions)]\n    47\t    (is (not-any? exposed? (concat py-prelude/module-exports py-prelude/runtime-keys)))\n    48\t    ;; Only reception and egress may use the private constructor and reader.\n    49\t    ;; This also catches a renamed mint-wrapping helper.\n    50\t    (is (= '#{py/call-kw py/function-entry} public-private-users))))\n    51\t\n    52\t\n    53\t(deftest ^:slow python-foreign-reception-test\n    54\t  ;; R2: an otherwise-foreign payload is wrapped in a generated local\n    55\t  ;; ForeignException; an already-local exception is delivered unchanged.\n    56\t  (check-fixture :python/local-reception)           ; stays green\n    57\t  (check-fixture :python/foreign-reception)         ; R→G\n    58\t  (check-fixture :python/retained-foreign-lifetime) ; R→G\n    59\t  ;; The clojure→python typed reception and stored-wrapper rethrow legs.\n    60\t  (check-leg [:clojure :python :typed-catch])\n    61\t  (check-leg [:clojure :python :unchanged-rethrow])\n    62\t  (check-leg [:clojure :python :retained-lifetime]))\n    63\t\n    64\t\n    65\t(deftest ^:slow python-protocol-reception-test\n    66\t  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n    67\t  ;; complete condition instead of collapsing into a bare TypeError.\n    68\t  (check-fixture :python/protocol-not-callable)\n    69\t  (check-fixture :python/protocol-invalid-invocation)\n    70\t  (check-fixture :python/protocol-unsupported-binding)\n    71\t  (check-fixture :python/saved-protocol-not-callable)\n    72\t  (check-fixture :python/saved-protocol-invalid-invocation)\n    73\t  (check-fixture :python/saved-protocol-unsupported-binding))\n    74\t\n    75\t\n    76\t(deftest ^:slow python-egress-sanity-test\n    77\t  ;; Egress forwards a retained generated exception's original condition and\n    78\t  ;; still produces the plain thrown condition for fresh/forged payloads.\n    79\t  (check-fixture :python/fresh-named)       ; stays green\n    80\t  (check-fixture :python/fresh-closure)     ; stays green\n    81\t  (check-fixture :python/binding)           ; stays green\n    82\t  (check-fixture :python/forged-retention)) ; stays green (R5: no source-writable forgery)\n    83\t\n    84\t\n    85\t(deftest ^:slow python-kit-parity-test\n    86\t  ;; Match exception-probes/protocol-condition and injected exactly: the\n    87\t  ;; refusal is produced by public validation, then delivered by a callable\n    88\t  ;; cell's raise exit through a parsed Python f() and bare re-raise.\n    89\t  (let [donor (kit/publish-donor! :python contract/boundary-source)\n    90\t        source \"def receive(f):\\n    try:\\n        return f()\\n    except BaseException as e:\\n        raise\\n\"\n    91\t        call (fn [callee args]\n    92\t               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n    93\t        observation\n    94\t        (kit/guard-exceptions-form\n    95\t          [:python]\n    96\t          (list 'let\n    97\t                ['condition (list 'get (call {} []) :condition)\n    98\t                 'injected\n    99\t                 (list 'cell/new\n   100\t                       (list 'assoc {} :yang.call/entry\n   101\t                             (list 'fn ['invocation]\n   102\t                                   (list (list 'get 'invocation :yang.call/raise)\n   103\t                                         'condition))))\n   104\t                 'result (call (kit/export-form :python \"receive\") ['injected])]\n   105\t                (kit/observation-map-form\n   106\t                  {:reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n   107\t                   :condition-identical (list '= 'condition (list 'get 'result :condition))})))\n   108\t        results (kit/run-exception-program\n   109\t                  donor (kit/compose-exception donor [\"boundary_target\"]\n   110\t                                               :python source observation))]\n   111\t    (is (= #{:semantic :stack :register} (set (keys results))))\n   112\t    (doseq [[backend actual] results]\n   113\t      (println \"PYTHON-KIT-PARITY\" backend actual)\n   114\t      (is (= {:reason :yang.call/not-callable :condition-identical true} actual)\n   115\t          (str backend)))))\n   116\t\n   117\t\n   118\t(deftest ^:slow python-malformed-condition-test\n   119\t  (let [donor (kit/publish-donor! :python contract/boundary-source)\n   120\t        source \"def receive(f):\\n    try:\\n        return f()\\n    except TypeError:\\n        raise\\n\"\n   121\t        call (fn [callee args]\n   122\t               (kit/boundary-call-form callee (kit/observation-vector-form args) []))]\n   123\t    (doseq [malformed [nil :garbage]]\n   124\t      (let [observation\n   125\t            (kit/guard-exceptions-form\n   126\t              [:python]\n   127\t              (list 'let\n   128\t                    ['injected (list 'cell/new\n   129\t                                     (list 'assoc {} :yang.call/entry\n   130\t                                           (list 'fn ['invocation]\n   131\t                                                 (list (list 'get 'invocation :yang.call/raise)\n   132\t                                                       malformed))))\n   133\t                     'result (call (kit/export-form :python \"receive\") ['injected])\n   134\t                     'condition (list 'get 'result :condition)\n   135\t                     'exception (list 'get 'condition :yang.call/value)\n   136\t                     'content (list 'cell/get 'exception)]\n   137\t                    (kit/observation-map-form\n   138\t                      {:reason (list 'get 'condition :yang.call/reason)\n   139\t                       :payload (list 'get (list 'get (list 'get 'content :attrs) \"args\") :items)\n   140\t                       :provenance (list 'cell/dsg__provenance 'exception)})))\n   141\t            results (kit/run-exception-program\n   142\t                      donor (kit/compose-exception donor [\"boundary_target\"]\n   143\t                                                   :python source observation))]\n   144\t        (is (= #{:semantic :stack :register} (set (keys results))))\n   145\t        (doseq [[backend actual] results]\n   146\t          (is (= {:reason :yang.call/thrown :payload [malformed] :provenance nil} actual)\n   147\t              (str malformed \" \" backend)))))))\n   148\t\n   149\t\n   150\t(deftest ^:slow python-kit-batch-parity-test\n   151\t  ;; Acceptance uses run-frontend, which shares a task across observations.\n   152\t  ;; Isolated run-fixture pins alone cannot establish that batch path.\n   153\t  (let [fixtures (filter #(= :python (:frontend %)) contract/fixtures)\n   154\t        observations (probes/run-frontend :python)]\n   155\t    (is (= (set (map :id fixtures)) (set (keys observations))))\n   156\t    (doseq [{:keys [id expected]} fixtures\n   157\t            :let [results (get observations id)]]\n   158\t      (is (= #{:semantic :stack :register} (set (keys results))) (str id))\n   159\t      (doseq [[backend actual] results]\n   160\t        (println \"PYTHON-KIT-BATCH\" id backend actual)\n   161\t        (is (= expected actual) (str id \" \" backend))))))\n   162\t\n   163\t\n   164\t(def ^:private provenance-donor-source\n   165\t  \"(defn forge [e condition] (cell/new (assoc (cell/get e) :py/retained-condition condition)))\n   166\t   (defn clone [e] (cell/new (cell/get e)))\n   167\t   (defn overwrite [e condition]\n   168\t     (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition)) e))\")\n   169\t\n   170\t\n   171\t(defn- check-cell-provenance\n   172\t  [attack]\n   173\t  (let [donor (kit/publish-donor! :clojure provenance-donor-source)\n   174\t        source (str \"payload = None\\n\"\n   175\t                    \"def attacked(f, condition):\\n    global payload\\n\"\n   176\t                    (if (= attack :forge)\n   177\t                      \"    payload = forge(Exception('fresh'), condition)\\n\"\n   178\t                      (str \"    try:\\n        f()\\n    except BaseException as e:\\n\"\n   179\t                           (if (= attack :clone)\n   180\t                             \"        payload = clone(e)\\n\"\n   181\t                             \"        payload = overwrite(e, condition)\\n\")))\n   182\t                    \"    raise payload\\n\"\n   183\t                    \"def attacked_payload():\\n    return payload\\n\")\n   184\t        call (fn [callee args]\n   185\t               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n   186\t        observation\n   187\t        (kit/guard-exceptions-form\n   188\t          [:python]\n   189\t          (list 'let\n   190\t                ['condition (list 'get (call {} []) :condition)\n   191\t                 'replacement (list 'assoc 'condition :probe/forged true)\n   192\t                 'injected\n   193\t                 (list 'cell/new\n   194\t                       (list 'assoc {} :yang.call/entry\n   195\t                             (list 'fn ['invocation]\n   196\t                                   (list (list 'get 'invocation :yang.call/raise)\n   197\t                                         'condition))))\n   198\t                 'result (call (kit/export-form :python \"attacked\")\n   199\t                               ['injected 'replacement])\n   200\t                 'payload (list 'get (call (kit/export-form :python \"attacked_payload\") [])\n   201\t                                :value)]\n   202\t                (kit/observation-map-form\n   203\t                  (cond->\n   204\t                    {:route (list 'get 'result :route)\n   205\t                     :transfers (list 'get 'result :transfers)\n   206\t                     :after (list 'get 'result :after)\n   207\t                     :reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n   208\t                     :original-forwarded (list '= 'condition (list 'get 'result :condition))\n   209\t                     :replacement-forwarded (list '= 'replacement (list 'get 'result :condition))}\n   210\t                    (not= attack :overwrite)\n   211\t                    (assoc :payload-identical\n   212\t                           (list '= 'payload (list 'get (list 'get 'result :condition)\n   213\t                                                   :yang.call/value)))))))\n   214\t        results (kit/run-exception-program\n   215\t