859\t              (str \"a \" (pr-str entry) \" entry reaches admission and refuses\"))))\n  2860\t      (let [[tag payload] (run-library\n  2861\t                            '[(defn tail-refusal\n  2862\t                                []\n  2863\t                                (let [five 5 v [five]] (five 1)))\n  2864\t                              (tail-refusal)]\n  2865\t                            library-opts lane 1000000)]\n  2866\t        (is (= :yin.k/error tag))\n  2867\t        (is (= :yang.call/thrown (:yang.call/reason payload))\n  2868\t            \"the refusal survives a tail-position value call inside a NEW thrown condition\")\n  2869\t        (is (= {:yang.call/reason :yang.call/not-callable\n  2870\t                :yang.call/data {:yang.call/callee 5}}\n  2871\t               (:yang.call/value payload))\n  2872\t            \"the inner refusal and the callee evidence are both pinned\")\n  2873\t        (is (= {:yang.call/callee 5}\n  2874\t               (get-in payload [:yang.call/value :yang.call/data]))\n  2875\t            \"the callee evidence names the scalar callee\"))\n  2876\t      (doseq [[where form] [[1 '(five (boom) 2)] [2 '(five 1 (boom))]]]\n  2877\t        (let [[tag payload] (run-library\n  2878\t                              ['(defn boom\n  2879\t                                  []\n  2880\t                                  (throw (ex-info \"boom\" {})))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"Both VM lanes reproduced the identity gaps. A caught map equals its payload directly, but `[e]` does not equal `[original]`; map-key lookup misses; and `count` returns the wrapper’s three fields. A caught `nil` also tests truthy, and an aliased `vector?` gives a different answer from a direct call. I’m now testing whether copying complete cell contents bypasses the required lifetime association."}}
