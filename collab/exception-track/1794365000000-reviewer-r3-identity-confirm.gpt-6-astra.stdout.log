1), \\\\\\\\\\\\\\\"\\\\\\\\n   409\\\\\\\\t                           \\\\\\\\\\\\\\\"0 << 100, -1 >> 100, \\\\\\\\\\\\\\\"\\\\\\\\n   410\\\\\\\\t                           \\\\\\\\\\\\\\\"ov(lambda: ~(2 ** 53)), 1 << 53)\\\\\\\\\\\\\\\")))))\\\\\\\\n   411\\\\\\\\t\\\\\\\\n   412\\\\\\\\t\\\\\\\\n   413\\\\\\\\t(deftest ^:slow gate-p3-round2-test\\\\\\\\n   414\\\\\\\\t  (testing \\\\\\\\\\\\\\\"break and continue in finally swallow the exception in flight\\\\\\\\n   415\\\\\\\\t            (legal since 3.8); raising a non-exception is a TypeError;\\\\\\\\n   416\\\\\\\\t            `except E as e` unbinds e; range len and membership in closed\\\\\\\\n   417\\\\\\\\t            form; dict/set size change during iteration is a RuntimeError;\\\\\\\\n   418\\\\\\\\t            float % and // as CPython's fmod-corrected divmod; builtins take\\\\\\\\n   419\\\\\\\\t            no keywords; a class without __init__ takes no arguments; with\\\\\\\\n   420\\\\\\\\t            looks its dunders up on the type\\\\\\\\\\\\\\\"\\\\\\\\n   421\\\\\\\\t    (every-vm= (prints \\\\\\\\\\\\\\\"after break\\\\\\\\\\\\\\\"\\\\\\\\n   422\\\\\\\\t                       \\\\\\\\\\\\\\\"3\\\\\\\\\\\\\\\"\\\\\\\\n   423\\\\\\\\t                       \\\\\\\\\\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\\\\\\\\\"\\\\\\\\n   424\\\\\\\\t                       \\\\\\\\\\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\\\\\\\\\"\\\\\\\\n   425\\\\\\\\t                       \\\\\\\\\\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\\\\\\\\\"\\\\\\\\n   426\\\\\\\\t                       \\\\\\\\\\\\\\\"TypeError exceptions must derive from BaseException\\\\\\\\\\\\\\\"\\\\\\\\n   427\\\\\\\\t                       \\\\\\\\\\\\\\\"err unbound\\\\\\\\\\\\\\\"\\\\\\\\n   428\\\\\\\\t                       \\\\\\\\\\\\\\\"e2 unbound\\\\\\\\\\\\\\\"\\\\\\\\n   429\\\\\\\\t                       \\\\\\\\\\\\\\\"1501199875790166 True True False 0 4\\\\\\\\\\\\\\\"\\\\\\\\n   430\\\\\\\\t                       \\\\\\\\\\\\\\\"dictionary changed size during iteration\\\\\\\\\\\\\\\"\\\\\\\\n   431\\\\\\\\t                       \\\\\\\\\\\\\\\"Set changed size during iteration\\\\\\\\\\\\\\\"\\\\\\\\n   432\\\\\\\\t                       (str \\\\\\\\\\\\\\\"0.3999999999999999 5.0 0.7000000000000002 -4.0 0.5 \\\\\\\\\\\\\\\"\\\\\\\\n   433\\\\\\\\t                            \\\\\\\\\\\\\\\"0.09999999999999998 1.0000005382899513\\\\\\\\\\\\\\\")\\\\\\\\n   434\\\\\\\\t                       \\\\\\\\\\\\\\\"TypeError\\\\\\\\\\\\\\\"\\\\\\\\n   435\\\\\\\\t                       \\\\\\\\\\\\\\\"TypeError\\\\\\\\\\\\\\\"\\\\\\\\n   436\\\\\\\\t                       \\\\\\\\\\\\\\\"not a context manager\\\\\\\\\\\\\\\")\\\\\\\\n   437\\\\\\\\t               (lines \\\\\\\\\\\\\\\"for i in range(2):\\\\\\\\\\\\\\\"\\\\\\\\n   438\\\\\\\\t                      \\\\\\\\\\\\\\\"    try:\\\\\\\\\\\\\\\"\\\\\\\\n   439\\\\\\\\t                      \\\\\\\\\\\\\\\"        raise ValueError('x')\\\\\\\\\\\\\\\"\\\\\\\\n   440\\\\\\\\t                      \\\\\\\\\\\\\\\"    finally:\\\\\\\\\\\\\\\"\\\\\\\\n   441\\\\\\\\t                      \\\\\\\\\\\\\\\"        break\\\\\\\\\\\\\\\"\\\\\\\\n   442\\\\\\\\t                      \\\\\\\\\\\\\\\"print('after break')\\\\\\\\\\\\\\\"\\\\\\\\n   443\\\\\\\\t                      \\\\\\\\\\\\\\\"n = 0\\\\\\\\\\\\\\\"\\\\\\\\n   444\\\\\\\\t                      \\\\\\\\\\\\\\\"for i in range(3):\\\\\\\\\\\\\\\"\\\\\\\\n   445\\\\\\\\t                      \\\\\\\\\\\\\\\"    try:\\\\\\\\\\\\\\\"\\\\\\\\n   446\\\\\\\\t                      \\\\\\\\\\\\\\\"        raise KeyError('k')\\\\\\\\\\\\\\\"\\\\\\\\n   447\\\\\\\\t                      \\\\\\\\\\\\\\\"    finally:\\\\\\\\\\\\\\\"\\\\\\\\n   448\\\\\\\\t                      \\\\\\\\\\\\\\\"        n += 1\\\\\\\\\\\\\\\"\\\\\\\\n   449\\\\\\\\t                      \\\\\\\\\\\\\\\"        continue\\\\\\\\\\\\\\\"\\\\\\\\n   450\\\\\\\\t                      \\\\\\\\\\\\\\\"print(n)\\\\\\\\\\\\\\\"\\\\\\\\n   451\\\\\\\\t                      \\\\\\\\\\\\\\\"class NotExc:\\\\\\\\\\\\\\\"\\\\\\\\n   452\\\\\\\\t                      \\\\\\\\\\\\\\\"    pass\\\\\\\\\\\\\\\"\\\\\\\\n   453\\\\\\\\t                      \\\\\\\\\\\\\\\"for v in [1, 'x', NotExc, NotExc()]:\\\\\\\\\\\\\\\"\\\\\\\\n   454\\\\\\\\t                      \\\\\\\\\\\\\\\"    try:\\\\\\\\\\\\\\\"\\\\\\\\n   455\\\\\\\\t                      \\\\\\\\\\\\\\\"        raise v\\\\\\\\\\\\\\\"\\\\\\\\n   456\\\\\\\\t                      \\\\\\\\\\\\\\\"    except TypeError as e:\\\\\\\\\\\\\\\"\\\\\\\\n   457\\\\\\\\t                      \\\\\\\\\\\\\\\"        print('TypeError', e.args[0])\\\\\\\\\\\\\\\"\\\\\\\\n   458\\\\\\\\t                      \\\\\\\\\\\\\\\"try:\\\\\\\\\\\\\\\"\\\\\\\\n   459\\\\\\\\t                      \\\\\\\\\\\\\\\"    raise KeyError('k')\\\\\\\\\\\\\\\"\\\\\\\\n   460\\\\\\\\t                      \\\\\\\\\\\\\\\"except KeyError as err:\\\\\\\\\\\\\\\"\\\\\\\\n   461\\\\\\\\t                      \\\\\\\\\\\\\\\"    pass\\\\\\\\\\\\\\\"\\\\\\\\n   462\\\\\\\\t                      \\\\\\\\\\\\\\\"try:\\\\\\\\\\\\\\\"\\\\\\\\n   463\\\\\\\\t                      \\\\\\\\\\\\\\\"    print(err)\\\\\\\\\\\\\\\"\\\\\\\\n   464\\\\\\\\t                      \\\\\\\\\\\\\\\"except NameError:\\\\\\\\\\\\\\\"\\\\\\\\n   465\\\\\\\\t                      \\\\\\\\\\\\\\\"    print('err unbound')\\\\\\\\\\\\\\\"\\\\\\\\n   466\\\\\\\\t                      \\\\\\\\\\\\\\\"def f():\\\\\\\\\\\\\\\"\\\\\\\\n   467\\\\\\\\t                      \\\\\\\\\\\\\\\"    try:\\\\\\\\\\\\\\\"\\\\\\\\n   468\\\\\\\\t                      \\\\\\\\\\\\\\\"        raise KeyError('k')\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_28\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"All four frontends have a concrete divergence from the full contract. Clojure and Python produce the required condition for fresh escaping exceptions at their public entries; JavaScript and PHP lack that hookup. Foreign reception and unchanged protocol-error rethrow also differ. The local tests pin substantial exception behavior, but I found no real-source language pair exercising §8.10.7 propagation.\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_29\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"The “same continuation” claim is **false in this snapshot**. Clojure and Python connect fresh escaping exceptions to the supplied raise exit; JavaScript and PHP do not. Foreign reception and protocol-error rethrow also diverge.\\\\\\\\n\\\\\\\\nRead-only audit of `/Users/sto/workspace/datomworld-f12`, HEAD `e9a0b430`. No files edited; no tests run. Behavioral consequences below are static deductions from the code.\\\\\\\\n\\\\\\\\n**yang.clojure — DIVERGENT.**\\\\\\\\n\\\\\\\\n- **Lowering:** `throw` becomes `[:yin.k/error payload]`. `try` examines that outcome and binds its payload to the handler. It accepts exactly one `Exception`/`ExceptionInfo` catch, performs no runtime class discrimination, and rejects `finally`. See [clojure.cljc:904](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:904).\\\\\\\\n- **Raise-exit hookup:** the public entry reads `:yang.call/raise` at line 1070 and invokes it with `(yang.call/thrown payload)` at [clojure.cljc:1088](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1088). Fresh public escapes therefore have the specified condition shape.\\\\\\\\n- **Private path:** intra-unit calls pass `[compiler-token args]` and receive outcomes directly; authenticated outcome-token calls also bypass public value/raise conversion. See [clojure.cljc:1110](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1110), [clojure.cljc:1486](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1486). Thus its internal exception lowering is an ordinary result channel, unlike the other frontends’ handler continuations.\\\\\\\\n- **Foreign reception:** `compile-guest-call` supplies a capture-backed raise closure. A delivered `:yang.call/thrown` becomes an error outcome containing the **raw payload**; another reason becomes an error outcome containing the **whole condition as data**. See [clojure.cljc:1297](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure.cljc:1297). Source catches receive that data. Rethrowing a protocol condition subsequently reaches the public entry’s unconditional `yang.call/thrown`, changing its reason rather than forwarding the original condition.\\\\\\\\n- **Root:** `clj/run-main` unwraps successful outcomes and leaves error outcomes as reporting values; it supplies no invocation raise exit. See [clojure/prelude.cljc:87](/Users/sto/workspace/datomworld-f12/src/cljc/yang/clojure/prelude.cljc:87).\\\\\\\\n\\\\\\\\n**yang.typescript / JavaScript — DIVERGENT.**\\\\\\\\n\\\\\\\\n- **Lowering:** `throw` calls `js/throw`; `try/catch` calls `js/try`; an enclosing `finally` calls `js/try-finally`. See [lower.cljc:2165](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/lower.cljc:2165), line 2214.\\\\\\\\n- **Local continuation:** `js/try` captures a guest continuation and installs it in `js.rt/ctx`; `js/throw` walks that runtime’s handler/finally stack. These are guest continuations, not host-native `try/catch`. See [prelude.cljc:1704](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1704).\\\\\\\\n- **Raise-exit hookup: absent for escaping source exceptions.** The published function entry directly applies `:code`; it neither reads `:yang.call/raise` nor installs a per-activation exception bridge. See [prelude.cljc:1581](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1581). An escaping throw therefore follows existing JS handlers rather than the foreign caller’s supplied exit. With no JS handler, it reaches the `:js/no-handler` expression.\\\\\\\\n- **Foreign reception:** `js/call` really does deliver `:yang.call/value` raw through `js/throw`. However, protocol failures become newly constructed `TypeError`s containing only selected text; the original condition is discarded. See [prelude.cljc:1627](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1627). Unchanged protocol-error rethrow cannot recover it.\\\\\\\\n- **Root:** `js/run-main` installs a JS root handler and snapshots uncaught values; it does not repair the missing callee bridge. See [prelude.cljc:1850](/Users/sto/workspace/datomworld-f12/src/cljc/yang/typescript/antlr/prelude.cljc:1850).\\\\\\\\n\\\\\\\\n**yang.php — DIVERGENT.**\\\\\\\\n\\\\\\\\n- **Lowering:** source throws call `php/throw-value`; catches dispatch through local `php/instance-of`; unmatched catches call `php/raise`; `finally` becomes `php/try-finally`. See [lower.cljc:1889](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/lower.cljc:1889), line 3600. `throw-value` requires a local Throwable and then raises it. See [prelude.cljc:4084](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:4084).\\\\\\\\n- **Local continuation:** `php/try` captures a guest handler continuation; `php/raise` walks PHP’s handler/finally stack. With an empty stack, `php/raise` **returns the error normally**. See [prelude.cljc:190](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:190).\\\\\\\\n- **Raise-exit hookup: absent for source/binding exceptions.** The function entry performs named-argument placement and applies `:code` without an exception bridge. Its supplied raise exit is used only for unsupported binding profiles. See [prelude.cljc:2264](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2264), line 2281. The Closure entry likewise ignores the supplied exit and delegates through `php/call`: [prelude.cljc:4217](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:4217).\\\\\\\\n- **Foreign reception:** `php/call`, `call-with-binding-profile`, and `call-named` convert not-callable to a fresh local `Error`; otherwise they call **`php/raise condition`**, without extracting `:yang.call/value`. See [prelude.cljc:2384](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:2384), line 4314. Even an original PHP Throwable arriving inside a valid thrown condition is therefore delivered as its envelope, not restored.\\\\\\\\n- **`ForeignException`: nowhere.** No wrapper, local hierarchy, or identity-owned retained-condition association exists. `catch (Throwable)` receives no valid local wrapper; explicitly throwing the envelope cannot preserve the original condition.\\\\\\\\n- **Root:** `php/run-main` catches through PHP’s local stack and snapshots the result. See [prelude.cljc:5070](/Users/sto/workspace/datomworld-f12/src/cljc/yang/php/antlr/prelude.cljc:5070).\\\\\\\\n\\\\\\\\n**yang.python — DIVERGENT.**\\\\\\\\n\\\\\\\\n- **Lowering:** `raise X` calls `py/as-exception` then `py/raise`; bare rethrow uses the captured exception directly. Typed clauses use `py/exc-matches`, bare `except` selects its handler unconditionally, and `finally` becomes `py/try-finally`. See [lower.cljc:1664](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/lower.cljc:1664), lines 1699 and 1759.\\\\\\\\n- **Local continuation:** `py/try` captures and installs a guest handler, restoring saved context before calling its handler; `py/raise` runs intervening finally frames. See [prelude.cljc:294](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:294).\\\\\\\\n- **Raise-exit hookup: present.** `py/function-entry` reads the supplied exit at line 893 and places **both argument binding and body execution** inside `py/try`. Its handler invokes that exit with the required `:yang.call/thrown`/`:yang.call/value` condition. See [prelude.cljc:886](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:886), line 912. Fresh escaping Python exceptions and binding failures follow the intended boundary path.\\\\\\\\n- **Foreign reception:** `py/call-kw` delivers every thrown payload directly through `py/raise`, without validating whether it is a local exception or wrapping foreign data. Protocol failures become a generic `TypeError`, losing the condition. See [prelude.cljc:1034](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:1034).\\\\\\\\n- **`ForeignException`: nowhere.** Bare `except` can receive raw foreign data, but typed catches use `py/type-of` and the local hierarchy; foreign data has no generated local exception class. Explicit `raise e` applies `py/as-exception` and can replace that foreign payload with a `TypeError`. See [prelude.cljc:352](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:352), lines 754 and 802. There is no wrapper-lifetime condition association to recover in another activation.\\\\\\\\n- **Root:** `py/run-main` catches and snapshots through Python’s local stack. See [prelude.cljc:3322](/Users/sto/workspace/datomworld-f12/src/cljc/yang/python/antlr/prelude.cljc:3322).\\\\\\\\n\\\\\\\\n**Local coverage inventory — assertions present, not rerun.**\\\\\\\\n\\\\\\\\n| Frontend | What its own tests pin |\\\\\\\\n|---|---|\\\\\\\\n| Clojure | Throw/error outcomes: [clojure_test.clj:1162](/Users/sto/workspace/datomworld-f12/test/yang/clojure_test.clj:1162). Broad admitted catch, nested replacement throw, operand escape, and rejection of `finally`/`Throwable`: [line 2452](/Users/sto/workspace/datomworld-f12/test/yang/clojure_test.clj:2452). Named binding failure emits `:yang.call/thrown`: line 1429. No unchanged-rethrow identity assertion found in these cases. |\\\\\\\\n| JavaScript | Object and primitive throws, catch-all, finally on normal/return exits, string rethrow, uncaught exceptions: [e2e_test.clj:254](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/e2e_test.clj:254). Finally ordering/escape cleanup: [prelude_parity_test.cljc:677](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/prelude_parity_test.cljc:677), line 785. Typed catch syntax is inapplicable. |\\\\\\\\n| PHP | Throwable hierarchy, typed/multi-type catches, `Throwable` catch-all, unmatched propagation, rethrow, finally/return override and exception replacement: [exceptions_test.clj:19](/Users/sto/workspace/datomworld-f12/test/yang/php/antlr/exceptions_test.clj:19), lines 33, 48 and 63. The test labelled “rethrow keeps the same object” checks its message, **not object identity**. |\\\\\\\\n| Python | Typed catches across a local callee, bare rethrow, uncaught errors: [e2e_test.clj:534](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/e2e_test.clj:534), lines 554 and 609. Bare catch-all lowering: [lower_test.clj:197](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/lower_test.clj:197). Finally on every exit, nested cleanup, return override and replacement exception: [e2e_c1_test.clj:30](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/e2e_c1_test.clj:30), lines 62 and 91. Binder condition shape: [call_entry_test.cljc:76](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/call_entry_test.cljc:76). |\\\\\\\\n\\\\\\\\n**Cross-language evidence: the “zero exception legs” report is confirmed for the checked-in conformance tests.**\\\\\\\\n\\\\\\\\nThe shared kit composes donor exports and runs caller source; it contains no exception scenario itself: [conformance.clj:245](/Users/sto/workspace/datomworld-f12/test/yang/call/conformance.clj:245). Its real-source consumers in [cross_lang_test.clj:26](/Users/sto/workspace/datomworld-f12/test/yang/cross_lang_test.clj:26), Python’s [source_call_test.clj:9](/Users/sto/workspace/datomworld-f12/test/yang/python/antlr/source_call_test.clj:9), and TS/PHP’s [source_call_test.cljc:98](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/source_call_test.cljc:98) exercise successful calls, callbacks, identity and opaque values—not escaping exceptions.\\\\\\\\n\\\\\\\\nThere **is** a JavaScript reception fixture asserting payload identity after a hand-built entry invokes the supplied raise exit: [prelude_parity_test.cljc:768](/Users/sto/workspace/datomworld-f12/test/yang/typescript/antlr/prelude_parity_test.cljc:768). That is useful helper evidence, but no second frontend compiles the throw. Likewise, shared helper tests construct conditions directly: [call_test.cljc:157](/Users/sto/workspace/datomworld-f12/test/yang/core/call_test.cljc:157).\\\\\\\\n\\\\\\\\nConsequently, no real-source language pair currently establishes the §8.10.7 propagation contract, including binding-failure propagation, foreign typed/catch-all reception, unchanged/protocol rethrow, finally replacement, A→B→A cleanup and identity, or saved `ForeignException` rethrow from another activation.\\\\\\\\n\\\\\\\\n**Ranked divergences:**\\\\\\\\n\\\\\\\\n1. **Missing callee exception bridges in JavaScript and PHP.** Their entries bypass the supplied raise exit for source exceptions; PHP binding failures also occur outside such a bridge. Evidence: JS prelude line 1581; PHP prelude lines 2264 and 4217.\\\\\\\\n2. **Missing foreign-exception reception in Python and PHP.** Python raises raw foreign payloads; PHP raises the entire condition envelope. Neither implements `ForeignException` or its lifetime-owned condition association. Evidence: Python prelude line 1034; PHP prelude line 2384.\\\\\\\\n3. **Original protocol conditions do not survive unchanged rethrow.** JS/Python discard them while constructing local errors; Clojure retains them as catch data but wraps a rethrow in a new thrown condition; PHP supplies an envelope without a valid local wrapper. Evidence: JS line 1634; Python line 1046; Clojure lines 1306 and 1088; PHP lines 2391 and 4085.\\\\\\\\n4. **Clojure has a distinct internal failure channel and restricted catch/finally lowering.** Error vectors and authenticated private calls carry failures as ordinary results before public conversion. Evidence: compiler lines 904, 1110 and 1486.\\\\\\\\n\\\\\\\\nI found no synthesized engine-effect exception value, guessed foreign class-name matching, or source-map detector that forwards data merely because it looks like a condition. Dispatch on the reason of an actually delivered boundary condition is distinct from that forbidden shape inference.\\\\\\\\n\\\\\\\\n**Overall verdict: DIVERGENT.**\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"turn.completed\\\\\\\",\\\\\\\"usage\\\\\\\":{\\\\\\\"input_tokens\\\\\\\":1190399,\\\\\\\"cached_input_tokens\\\\\\\":1069312,\\\\\\\"cache_write_input_tokens\\\\\\\":0,\\\\\\\"output_tokens\\\\\\\":10086,\\\\\\\"reasoning_output_tokens\\\\\\\":2837}}\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'content=|defn.*equal|closure.*equal|identical' src/cljc/yin/vm/data.cljc src/cljc/yin/vm/closure.cljc src/cljc/dao/jing.cljc src/cljc/yin/vm*.cljc | head -85; sed -n '630,677p' src/cljc/yang/clojure.cljc; sed -n '1,85p' test/yang/call/exception_contract.clj; sed -n '1,95p' collab/exception-track/1794320926000-architect-dsg-condition-r4-coupling.gemini-4-argon-high.findings.md\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'content=|defn.*equal|closure.*equal|identical' src/cljc/yin/vm/data.cljc src/cljc/yin/vm/closure.cljc src/cljc/dao/jing.cljc src/cljc/yin/vm*.cljc | head -85; sed -n '630,677p' src/cljc/yang/clojure.cljc; sed -n '1,85p' test/yang/call/exception_contract.clj; sed -n '1,95p' collab/exception-track/1794320926000-architect-dsg-condition-r4-coupling.gemini-4-argon-high.findings.md\\\"\",\"aggregated_output\":\"rg: src/cljc/yin/vm/closure.cljc: No such file or directory (os error 2)\\nsrc/cljc/dao/jing.cljc:438:               (identical? stored content-missing)\\nsrc/cljc/dao/jing.cljc:476:      (if (identical? stored not-found)\\nsrc/cljc/yin/vm/data.cljc:13:   Results are identical on CLJ, CLJS and CLJD:\\nsrc/cljc/yin/vm/data.cljc:85:   +/- `max-safe`, else nil. The bound keeps an index identical on hosts\\nsrc/cljc/yin/vm/data.cljc:484:(defn- data-content=\\nsrc/cljc/yin/vm/data.cljc:490:  (or (identical? a b)\\nsrc/cljc/yin/vm/data.cljc:493:        (cbor/content= a b))))\\nsrc/cljc/yin/vm/data.cljc:531:   ['content= [2] data-content=]\\nsrc/cljc/yin/vm.cljc:463:                            (when (identical? (primitive-function entry)\\nsrc/cljc/yin/vm.cljc:494:                             (when (identical? (primitive-function candidate)\\nsrc/cljc/yin/vm.cljc:1074:   `dao.jing.cbor/content=`, the encoder's own kind-strict equality, so canonical\\nsrc/cljc/yin/vm.cljc:1110:             :else (cbor/content= a b))))\\nsrc/cljc/yin/vm.cljc:1122:   commits to its children's ids; structurally identical subtrees mint one\\nsrc/cljc/yin/vm.cljc:1127:   leaves by `dao.jing.cbor/content=`), and a mismatch throws\\nsrc/cljc/yin/vm.cljc:1938:   is no longer `identical?` to it, so a primitive added later is\\nsrc/cljc/yin/vm.cljc:2057:                                    (and (identical?\\nsrc/cljc/yin/vm.cljc:2062:                                         (identical?\\n                   (not (and (map? (first trailing)) (nil? (next trailing)))))\\n          (reject! \\\"Unexpected forms after fn arities\\\" {:name fn-name}))\\n        {:name fn-name, :meta (merge header (first trailing))\\n         :arities (mapv (fn [a]\\n                          (when-not (vector? (first a))\\n                            (reject! \\\"Malformed fn arity\\\" {:name fn-name}))\\n                          {:params (first a), :body (rest a)})\\n                        arities)})\\n\\n      :else\\n      (reject! (str \\\"Malformed \\\" operator \\\" form\\\") {:name fn-name}))))\\n\\n\\n(declare compile-fn compile-av-fn)\\n\\n\\n(defn- compile-defn\\n  \\\"Compile a defn form natively to a yin/def application: the tree the\\n   expander's standard `defn` also produces. This path is used only when no\\n   defmacro named defn is in scope. Several arities need the argument-vector\\n   convention: a plain Yin closure nil-fills missing arguments and drops\\n   extras, so it cannot observe the call's argument count.\\\"\\n  [operator operands env tail? macro-env]\\n  (let [{fn-name :name, header :meta, :keys [arities]} (parse-defn operator operands)\\n        fn-ast (if (::convention env)\\n                 (compile-av-fn arities env false macro-env fn-name)\\n                 (do (when (< 1 (count arities))\\n                       (reject! \\\"Multi-arity fn is not supported: closures cannot observe argument count\\\"\\n                                {:name fn-name, :arities (count arities)}))\\n                     (let [{:keys [params body]} (first arities)]\\n                       (compile-fn params body env false macro-env))))\\n        ast (cond-> {:type :application\\n                     :operator {:type :variable, :name 'yin/def}\\n                     :operands [{:type :literal, :value (strip-symbol-meta fn-name)}\\n                                fn-ast]}\\n              tail? (assoc :tail? true))]\\n    (if (seq header)\\n      (vary-meta ast merge header)\\n      ast)))\\n\\n\\n(defn- check-macro-params!\\n  \\\"Every macro parameter is a plain symbol outside the reserved prefix; an\\n   & must be followed by exactly one binder.\\\"\\n  [params]\\n  (doseq [p params :when (not= '& p)]\\n    (check-binder! p params)\\n    (when-not (symbol? p)\\n(ns yang.call.exception-contract\\n  \\\"Round 0's executable §8.10.7 provenance contract. Source strings are\\n   parsed by the JVM kit, never patched after lowering. Boundary probes\\n   alone may manufacture invocations that valid source cannot express.\\n   `fixtures` is the acceptance-ledger input; pending is not a passing test.\\n   The ruling, rather than today's runtime output, determines `:expected`.\\\"\\n  (:require [clojure.string :as str]))\\n\\n\\n(def frontends #{:clojure :typescript :php :python})\\n\\n\\n(def protocol-reasons\\n  [:yang.call/not-callable :yang.call/invalid-invocation\\n   :yang.call/unsupported-binding])\\n\\n\\n(def sources\\n  \\\"Every export below is source-produced. `original` is an identity-bearing\\n   value, including Clojure's explicit cell. `receive` catches then rethrows unchanged;\\n   `retain` returns normally before `later` raises from a new activation.\\n   Protocol catch forms are intentionally local catch-all forms. No guessed\\n   donor class name participates in reception.\\\"\\n  {:python\\n   (str/join \\\"\\\\n\\\"\\n             [\\\"original = ValueError('original')\\\"\\n              \\\"saved = None\\\"\\n              \\\"def payload():\\\" \\\"    return original\\\"\\n              \\\"def donor_raise():\\\" \\\"    raise original\\\"\\n              \\\"def make_exploder():\\\"\\n              \\\"    def inner():\\\" \\\"        raise original\\\" \\\"    return inner\\\"\\n              \\\"def needs_argument(x):\\\" \\\"    return x\\\"\\n              \\\"def receive(f):\\\"\\n              \\\"    try:\\\" \\\"        return f()\\\"\\n              \\\"    except BaseException as e:\\\" \\\"        raise\\\"\\n              \\\"def retain(f):\\\" \\\"    global saved\\\"\\n              \\\"    try:\\\" \\\"        f()\\\"\\n              \\\"    except BaseException as e:\\\" \\\"        saved = e\\\" \\\"        return e\\\"\\n              \\\"def later():\\\" \\\"    raise saved\\\"\\n              \\\"def is_foreign(e):\\\"\\n              \\\"    return isinstance(e, BaseException) and type(e).__name__ == 'ForeignException'\\\"\\n              \\\"def forged(condition):\\\"\\n              \\\"    e = Exception('forged')\\\"\\n              \\\"    e.condition = condition\\\"\\n              \\\"    e.__yang_call_condition__ = e.condition\\\"\\n              \\\"    return e\\\"\\n              \\\"def raise_value(e):\\\" \\\"    raise e\\\" \\\"\\\"])\\n   :typescript\\n   (str \\\"globalThis.original = {marker: 'original'};\\\"\\n        \\\"globalThis.saved = null;\\\"\\n        \\\"globalThis.payload = function() { return original; };\\\"\\n        \\\"globalThis.donor_raise = function() { throw original; };\\\"\\n        \\\"globalThis.make_exploder = function() { return () => { throw original; }; };\\\"\\n        \\\"globalThis.receive = function(f) { try { return f(); } catch (e) { throw e; } };\\\"\\n        \\\"globalThis.retain = function(f) { try { return f(); } catch (e) { saved = e; return e; } };\\\"\\n        \\\"globalThis.later = function() { throw saved; };\\\"\\n        \\\"globalThis.raise_value = function(e) { throw e; };\\\"\\n        \\\"globalThis.echo = function(e) { return e; };\\\")\\n   :php\\n   (str \\\"<?php $original = new Exception('original'); $saved = null;\\\"\\n        \\\"function payload() { global $original; return $original; }\\\"\\n        \\\"function donor_raise() { global $original; throw $original; }\\\"\\n        \\\"function make_exploder() { return function() { global $original; throw $original; }; }\\\"\\n        \\\"function needs_argument($x) { return $x; }\\\"\\n        \\\"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\\\"\\n        \\\"function retain($f) { global $saved; try { return $f(); } catch (Throwable $e) { $saved = $e; return $e; } }\\\"\\n        \\\"function later() { global $saved; throw $saved; }\\\"\\n        \\\"function is_foreign($e) { return $e instanceof Throwable && get_class($e) === 'ForeignException'; }\\\"\\n        \\\"function forged($condition) { $e = new Exception('forged'); $e->condition = $condition;\\\"\\n        \\\" $e->__yang_call_condition__ = $e->condition; return $e; }\\\"\\n        \\\"function raise_value($e) { throw $e; }\\\")\\n   :clojure\\n   (str \\\"(def original (cell/new :original)) (def saved (cell/new nil)) \\\"\\n        \\\"(defn payload [] original) (defn donor_raise [] (throw original)) \\\"\\n        \\\"(defn make_exploder [] (fn [] (throw original))) \\\"\\n        \\\"(defn needs_argument [x] x) \\\"\\n        \\\"(defn receive [f] (try (f) (catch Exception e (throw e)))) \\\"\\n        \\\"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \\\"\\n        \\\"(defn later [] (throw (cell/get saved))) \\\"\\n        \\\"(defn raise_value [e] (throw e)) (defn echo [e] e)\\\")})\\n\\n\\n(def boundary-source\\n  \\\"A real Python entry produces unsupported-binding. Other two protocol\\n   conditions come from yang.call validation, with malformed positional\\n## Ruling: **(B) Load-bearing** (as a provenance distinction between retained protocol conditions and guest-thrown condition-shaped data; **defective in `98519957`** because `compile-program` leaves stale `:tail? true` marks on the operand of `strip-top-outcome`, causing `:semantic` to tail-skip the top-level stripper, and because literal `:dsg__condition true` is guest-forgeable under R5)\\n\\n---\\n\\n### 1. Complete Inventory of `:dsg__condition` on `exception-r3-impl` (`98519957`)\\n\\n`git grep -n 'dsg__condition' 98519957` finds **11 lines across 9 sites**, all in [`src/cljc/yang/clojure.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc) (`0` occurrences on `master` @ `8cd9fc92`, `0` occurrences in `test/`):\\n\\n#### A. 7 Writer Sites (all in [`src/cljc/yang/clojure.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc) at `98519957`)\\n\\n1. **[`src/cljc/yang/clojure.cljc:1543-1544`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1543-L1544)** — [`condition->outcome`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1530-L1549) inside [`compile-guest-call`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1517-L1658) (consequent branch when `reason` is one of `:yang.call/{thrown, not-callable, invalid-invocation, unsupported-binding}`):\\n   ```clojure\\n   (outcome-node error-tag\\n                 (u/app (u/v 'dsg__assoc) (u/v condition) (u/lit :dsg__condition) (u/lit true)))\\n   ```\\n2. **[`src/cljc/yang/clojure.cljc:1546-1548`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1546-L1548)** — [`condition->outcome`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1530-L1549) inside [`compile-guest-call`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1517-L1658) (alternate branch when `condition` has no recognized `:yang.call/reason`):\\n   ```clojure\\n   (outcome-node error-tag\\n                 (u/app (u/v 'dsg__assoc)\\n                        (u/app (u/v 'yang.call/thrown) (u/v condition))\\n                        (u/lit :dsg__condition) (u/lit true)))\\n   ```\\n3. **[`src/cljc/yang/clojure.cljc:1560-1567`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1560-L1567)** — `refused` inside [`compile-guest-call`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1517-L1658) (when `(dsg__admitted? callee)` is false):\\n   stamps `(u/lit :dsg__condition) (u/lit true)` onto `(yang.call/condition :yang.call/not-callable {:yang.call/callee callee})`.\\n4. **[`src/cljc/yang/clojure.cljc:1580-1586`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1580-L1586)** — `activation` inside [`compile-guest-call`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1517-L1658) (when `escape` fails `:clj/escape-token` check):\\n   stamps `(u/lit :dsg__condition) (u/lit true)` onto `(yang.call/condition :yang.call/invalid-invocation {:yang.call/reason :missing-raise-exit})`.\\n5. **[`src/cljc/yang/clojure.cljc:1630-1636`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1630-L1636)** — `value-call` inside [`compile-guest-call`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1517-L1658) (when `dsg__raise_escape` fails `:clj/escape-token` check):\\n   stamps `(u/lit :dsg__condition) (u/lit true)` onto `(yang.call/condition :yang.call/invalid-invocation {:yang.call/reason :missing-raise-exit})`.\\n6. **[`src/cljc/yang/clojure.cljc:2612-2617`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2612-L2617)** — `dsg__intra_call` inside [`compile-program`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2398-L2678) (non-map `dsg__callee` branch):\\n   ```clojure\\n   '(conj (conj [] :yin.k/error)\\n          (dsg__assoc (yang.call/condition :yang.call/not-callable\\n                                           (dsg__assoc {} :yang.call/callee dsg__callee))\\n                      :dsg__condition true))\\n   ```\\n7. **[`src/cljc/yang/clojure.cljc:2794-2795`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2794-L2795)** — `invoke-value` in [`library`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2680-L2900) (`:else` branch for non-callable `f`):\\n   ```clojure\\n   :else\\n   (throw (assoc (yang.call/condition :yang.call/not-callable {:yang.call/callee f})\\n                 :dsg__condition true))\\n   ```\\n\\n#### B. 2 Reader + Stripper Sites (4 grep lines, all in [`src/cljc/yang/clojure.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc) at `98519957`)\\n\\n1. **[`src/cljc/yang/clojure.cljc:1309-1317`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1309-L1317) (lines `:1313` and `:1315`)** — `entry-body` tail inside [`call-entry`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1239-L1331):\\n   When a callable activation finishes with `outcome = [:yin.k/error err-val]`, tests `(if (data/map? err-val) (dsg__get err-val :dsg__condition) false)`:\\n   - **Truthy**: calls `(u/app raise (u/app (u/v 'data/dissoc) (u/v err-val) (u/lit :dsg__condition)))` — strips `:dsg__condition` and forwards `err-val` directly as the condition to `raise`.\\n   - **Falsy**: calls `(u/app raise (u/app (u/v 'yang.call/thrown) (u/v err-val)))` — wraps `err-val` as the `:yang.call/value` of a fresh `:yang.call/thrown` condition.\\n2. **[`src/cljc/yang/clojure.cljc:2419-2435`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2419-L2435) (lines `:2431` and `:2433`, invoked at `:2507`)** — `strip-top-outcome` inside [`compile-program`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2398-L2678):\\n   Wraps `(go forms initial-macro-env)` in `(u/let1 top-res ast ...)`; when `(= (data/nth top-res 0) :yin.k/error)` and `(dsg__get top-err :dsg__condition)` is truthy, returns `[:yin.k/error (data/dissoc top-err :dsg__condition)]`.\\n\\n---\\n\\n### 2. Why `test-value-invocation-refusals-are-terminating` (`test/yang/clojure_test.clj:2598`) and the R3 Tests Failed with `:dsg__condition true`\\n\\nIn [`test-value-invocation-refusals-are-terminating`](file:///Users/sto/workspace/datomworld/test/yang/clojure_test.clj#L2594-L2637) (`clojure_test.clj:2598`) and the R3 tests (`clojure_test.clj:1486, 1501, 1510, 2735, 2765`), **every failure occurs on `:semantic` while `:walker` passes**:\\n\\n1. In [`test-value-invocation-refusals-are-terminating`](file:///Users/sto/workspace/datomworld/test/yang/clojure_test.clj#L2598), `(let [five 5 v [five]] (five 1))` compiles `(five 1)` via `value-call` ([`clojure.cljc:1607-1637`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1607-L1637)) into `(yang.call/invoke invoke-value [five 1] {:yang.call/raise ...})`.\\n2. `invoke-value` ([`clojure.cljc:2794-2795`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2794-L2795)) throws `{:yang.call/reason :yang.call/not-callable, :yang.call/data {:yang.call/callee 5}, :dsg__condition true}`.\\n3. `invoke-value`'s [`call-entry`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1312-L1315) strips `:dsg__condition` and passes `{:yang.call/reason :yang.call/not-callable, :yang.call/data {:yang.call/callee 5}}` to `value-call`'s `:yang.call/raise` handler ([`clojure.cljc:1617-1622`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1617-L1622)).\\n4. `value-call`'s `:yang.call/raise` handler invokes [`condition->outcome`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1543-L1544), which **re-stamps `:dsg__condition true`** and escapes via `dsg__raise_escape` with `[:yin.k/error {:yang.call/reason :yang.call/not-callable, :yang.call/data {:yang.call/callee 5}, :dsg__condition true}]`.\\n5. Because `(let [five 5 v [five]] (five 1))` is a top-level program expression (not inside a `defn`'s `call-entry`), only `strip-top-outcome` ([`clojure.cljc:2419-2435`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2419-L2435), threaded at [`:2507`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2507)) sits between that outcome and the caller.\\n6. **Why `:semantic` skips `strip-top-outcome` completely**:\\n   - Inside [`compile-program`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2446), `go` is initialized with `tail? = true` (`:2446`). As `go` lowers top-level forms ([`:2458-2504`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2458-L2504)), it explicitly attaches `:tail? true` to every top-level sequencing application (`:2479`, `:2492`, `:2504`) and passes `tail? = true` into the final form (`:2495` -> [`compile-guest-call:1656`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1656)).\\n   - Next, [`strip-top-outcome`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2507) wraps `(go forms initial-macro-env)` as the **operand** (`ast`) of `(u/let1 top-res ast ...)` (`((fn [top-res] ...) ast)`).\\n   - At [`clojure.cljc:2674`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2674), `compile-program` runs `(u/mark-tails ...)` ([`yang.tails/mark-tails`](file:///Users/sto/workspace/datomworld/src/cljc/yang/tails.cljc#L36-L70)), which walks application operands with `tail? = false` ([`tails.cljc:47`](file:///Users/sto/workspace/datomworld/src/cljc/yang/tails.cljc#L47)) **without stripping pre-existing `:tail? true` marks** (violating the invariant documented at [`src/cljc/yang/tails.cljc:1-6`](file:///Users/sto/workspace/datomworld/src/cljc/yang/tails.cljc#L1-L6): *\\\"a stage that wraps a body must strip every mark and recompute them over the whole derived tree, or a wrapped body's old tail calls would skip the wrapper\\\"*).\\n   - On `:walker` (which ignores `:tail?`), `ast` returns normally into `strip-top-outcome`, which strips `:dsg__condition`. On `:semantic` ([`yin.vm.semantic.linearize:116`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/linearize.cljc#L116)), the stale `:tail? true` on `ast` emits a tail `:call` (`tail? = true`) that returns directly out of the enclosing frame, **bypassing `strip-top-outcome` completely**.\\n\\n---\\n\\n### 3. Why **(B) Load-bearing** Holds (Why Simply Deleting `:dsg__condition` Fails R3 + R5)\\n\\nIn `yang.clojure`, both:\\n- a caught-and-rethrown protocol condition — e.g., `(defn receive [f] (try (f) (catch Exception e (throw e))))` or across separate activations `(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e)))` followed by `(defn later [] (throw (cell/get saved)))` ([`test/yang/call/exception_contract.clj:77-79`](file:///Users/sto/workspace/datomworld/test/yang/call/exception_contract.clj#L77-L79), probed at [`test/yang/call/exception_probes.clj:112-135`](file:///Users/sto/workspace/datomworld/test/yang/call/exception_probes.clj#L112-L135)) — and\\n- a guest-thrown condition-shaped data map — e.g., `(defn raise_value [e] (throw e))` with `{:yang.call/reason :yang.call/not-callable, :yang.call/data {:nested [:ordinary :data]}}` ([`test/yang/call/exception_contract.clj:80`](file:///Users/sto/workspace/datomworld/test/yang/call/exception_contract.clj#L80), probed by `:clojure/shape-throw` at [`test/yang/call/exception_probes.clj:101-110`](file:///Users/sto/workspace/datomworld/test/yang/call/exception_probes.clj#L101-L110) and `test-exception-r3-thrown-shape-stays-data` at [`test/yang/clojure_test.clj:1521-1560`](file:///Users/sto/workspace/datomworld/test/yang/clojure_test.clj#L1521-L1560))\\n\\nenter the outcome channel through the **exact same `(throw x)` lowering** at [`src/cljc/yang/clojure.cljc:1125`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1125) (`[error-tag v]`) and arrive at [`call-entry`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1309-L1317).\\n\\n- If [`call-entry`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1309-L1317) wraps every `err-val` in `(yang.call/thrown err-val)` (as `master` @ `8cd9fc92` does), rethrowing a caught `:yang.call/not-callable` condition double-wraps it into `:yang.call/thrown`, violating **Ruling v2 §R3**.\\n- If [`call-entry`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1309-L1317) inspects only structural keys (`:yang.call/reason`), guest `(throw {:yang.call/reason :yang.call/not-callable, :yang.call/data ...})` is forwarded as a raw `:yang.call/not-callable` refusal instead of `:yang.call/thrown`, violating **Ruling v2 §R2 & §R5**.\\n- Furthermore, because [`check-program-symbols!`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2370-L2394) rejects reserved-prefix **symbols** (`symbol?` at `:2377`, `:2386`) and **not keywords**, guest source can legally write `{:yang.call/reason :yang.call/not-callable, :dsg__condition true}`. Checking `(dsg__get err-val :dsg__condition)` for literal `true` allows guest code to forge a retained condition, violating **Ruling v2 §R5** (*\\\"forged or source-writable attributes on a wrapper-looking value never authenticate a retained condition\\\"*).\\n\\n---\\n\\n### 4. Minimal Fix Instruction for the Implementation Round (R3 vs R4 Ownership)\\n\\n#### What R3 Owns and Must Change Now (in [`src/cljc/yang/clojure.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc))\\n\\n1. **Fix the stale `:tail? true` mark in [`compile-program`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2446-L2674) so `strip-top-outcome` is never tail-skipped on `:semantic`**:\\n   - At [`src/cljc/yang/clojure.cljc:2674`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2674), replace `u/mark-tails` with [`yang.tails/remark-tails`](file:///Users/sto/workspace/datomworld/src/cljc/yang/tails.cljc#L72-L77) (or pass `(if (outcomes? env) false tail?)` to `go` at [`:2446`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2446) in addition to `remark-tails`), so pre-existing `:tail? true` marks inside `(go forms initial-macro-env)` are stripped and recomputed after `strip-top-outcome` wraps the body at [`:2507`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2507).\\n2. **Authenticate `:dsg__condition` with the compiler-held closure token `dsg__call_token` instead of literal `true` (satisfying R5)**:\\n   - `dsg__call_token` ([`clojure.cljc:2632`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2632)) is already an unforgeable per-unit closure value (`(fn [x] x)`) in scope of `call-entry`, `compile-guest-call`, `dsg__intra_call`, and `strip-top-outcome`, and its symbol name `dsg__call_token` is blocked in user forms by [`check-program-symbols!`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2370-L2394).\\n   - At writer sites **#1–#6** ([`clojure.cljc:1544, 1548, 1567, 1586, 1636, 2617`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1543-L1636)), stamp `:dsg__condition` with `(u/v 'dsg__call_token)` (and `dsg__call_token` in quoted `dsg__intra_call` at `:2617`) instead of `true`.\\n   - At writer site **#7** (`invoke-value` in `library`, [`clojure.cljc:2794-2795`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2794-L2795)), remove `(throw (assoc ... :dsg__condition true))` and instead trigger a genuine `not-callable` refusal that stamps `dsg__call_token` via compiler-generated code (or invoke `(f)` / a non-callable refusal helper lowered by the compiler), because `library` forms pass through `check-program-symbols!` when spliced in `run-library` tests.\\n   - At the two reader/stripper sites ([`call-entry` at `clojure.cljc:1312-1315`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L1312-L1315) and [`strip-top-outcome` at `clojure.cljc:2430-2433`](file:///Users/sto/workspace/datomworld/src/cljc/yang/clojure.cljc#L2430-L2433)), replace the truthiness check `(dsg__get err-val :dsg__condition)` with token equality `(dsg__equal (dsg__get err-val :dsg__condition) dsg__call_token)`.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"agent_message\",\"text\":\"Two static counterexamples have emerged. A catch handler can copy the retained token onto a different map, which then passes the provenance check. Also, ordinary exceptions caught across a public call now arrive as envelopes, so existing `ex-message` and `ex-data` accessors read the wrong level. I’m checking the remaining field-preservation cases and test assertions.\\n\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '478,497p' src/cljc/yin/vm/data.cljc; rg -n 'defn content=|closure|Closure' src/cljc/dao/jing/cbor.cljc | head -45; git diff --name-only 8cd9fc92..778747ce; git show 778747ce:src/cljc/yang/clojure.cljc | nl -ba | sed -n '2540,2609p'; sed -n '1300,1410p' test/yang/clojure_test.clj\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '478,497p' src/cljc/yin/vm/data.cljc; rg -n 'defn content=|closure|Closure' src/cljc/dao/jing/cbor.cljc | head -45; git diff --name-only 8cd9fc92..778747ce; git show 778747ce:src/cljc/yang/clojure.cljc | nl -ba | sed -n '2540,2609p'; sed -n '1300,1410p' test/yang/clojure_test.clj\\\"\",\"aggregated_output\":\"(defn- ref?\\n  \\\"True when `x` is a stream, cursor or cell reference.\\\"\\n  [x]\\n  (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x))))\\n\\n\\n(defn- data-content=\\n  \\\"True when `a` and `b` have one identity under content addressing:\\n   Jing's kind-strict content equality, so every NaN is one value, 0.0 is\\n   not -0.0, 1 is not 1.0, and collections recurse. A callable or a\\n   reference compares by host `=`, so content addressing never walks it.\\\"\\n  [a b]\\n  (or (identical? a b)\\n      (if (or (callable? a) (callable? b) (ref? a) (ref? b))\\n        (= a b)\\n        (cbor/content= a b))))\\n\\n\\n;; =============================================================================\\n;; The module\\n561:(defn content=\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-x1aAtbBl' (errno=Operation not permitted)\\n2026-11-11 03:14:47.677 xcodebuild[97187:121021459]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 03:14:47.904 xcodebuild[97187:121021430] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from con