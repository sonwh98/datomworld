r (:name node))))\\n                node)\\n    :lambda (assoc node :body (publish-to-globals (:body node) names\\n                                                  (into bound (:params node))))\\n    :application\\n    (if (and (= 'yin/def (get-in node [:operator :name]))\\n             (= 2 (count (:operands node)))\\n             (= :literal (:type (first (:operands node))))\\n             (contains? names (:value (first (:operands node)))))\\n      (u/app (u/v 'clj/define-global!)\\n             (u/lit (str (:value (first (:operands node)))))\\n             (publish-to-globals (second (:operands node)) names bound))\\n      (assoc node\\n             :operator (publish-to-globals (:operator node) names bound)\\n             :operands (mapv #(publish-to-globals % names bound)\\n                             (:operands node))))\\n    :if (cond-> node\\n          (contains? node :test)\\n          (assoc :test (publish-to-globals (:test node) names bound))\\n          (contains? node :consequent)\\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\\n          (contains? node :alternate)\\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\\n    (reduce (fn [n k]\\n              (let [v (get n k)]\\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\\n                  (assoc n k (globals-child v names bound))\\n                  n)))\\n            node (keys node))))\\n\\n\\n(defn lower-unit\\n  \\\"The `clj/run-main` entry's unit for the top-level source `forms`: one\\n   thunk whose call runs the program — `forms` plus the definitions of\\n   the guest library they need, compiled unmodified under `unit-opts`\\n   and published to the runtime global namespace by\\n   `publish-to-globals` — so the helper's export projection can read\\n   each top-level definition. The two-argument form also takes the\\n   projected `exports` (names the composition already bound in the\\n   runtime global namespace): their free reads publish the same way, so\\n   the projection is the caller's binding for them. The program's own\\n   `yang.call` call sites need no free-name declaration: the convention\\n   preamble `compile-program` emits defines those names locally, and\\n   the donor publication pins the `yang.call` module for the qualified\\n   reads that remain.\\\"\\n  ([forms] (lower-unit forms []))\\n  ([forms exports]\\n   (let [source (vec forms)\\n         library (library-for source)\\n         program (compile-program (concat source library) true unit-opts)\\n         macros (into #{}\\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\\n                            (map (comp strip-symbol-meta second)))\\n                      (concat source library))\\n         names (reduce disj\\n                       (into (set (top-level-names source))\\n                             (concat (map (comp strip-symbol-meta second) library)\\n                                     (map symbol exports)))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '43,92p' src/cljc/yin/vm/values.cljc; git show 778747ce:src/cljc/yang/clojure.cljc | nl -ba | sed -n '3250,3295p'; date -u '+%Y-%m-%d %H:%M:%S GMT'; date '+%Y-%m-%d %H:%M:%S %Z'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '43,92p' src/cljc/yin/vm/values.cljc; git show 778747ce:src/cljc/yang/clojure.cljc | nl -ba | sed -n '3250,3295p'; date -u '+%Y-%m-%d %H:%M:%S GMT'; date '+%Y-%m-%d %H:%M:%S %Z'\\\"\",\"aggregated_output\":\"(deftype Closure\\n  [owner payload]\\n  #?@(:cljd [cljd.core/IEquiv\\n             (-equiv [_ other]\\n                     (and (instance? Closure other)\\n                          (= owner (.-owner ^Closure other))\\n                          (= payload (.-payload ^Closure other))))\\n             cljd.core/IHash\\n             (-hash [_] (hash [:closure owner payload]))\\n             cljd.core/IPrint\\n             (-print [_ sink] (.write sink (:closure marker-text)))\\n             Object\\n             (toString [_] (:closure marker-text))]\\n      :clj [Object\\n            (equals [_ other]\\n                    (and (instance? Closure other)\\n                         (= owner (.-owner ^Closure other))\\n                         (= payload (.-payload ^Closure other))))\\n            (hashCode [_] (hash [:closure owner payload]))\\n            (toString [_] (:closure marker-text))\\n            clojure.lang.IHashEq\\n            (hasheq [_] (hash [:closure owner payload]))]\\n      :cljs [IEquiv\\n             (-equiv [_ other]\\n                     (and (instance? Closure other)\\n                          (= owner (.-owner ^Closure other))\\n                          (= payload (.-payload ^Closure other))))\\n             IHash\\n             (-hash [_] (hash [:closure owner payload]))\\n             IPrintWithWriter\\n             (-pr-writer [_ writer _opts]\\n                         (-write writer (:closure marker-text)))\\n             Object\\n             (toString [_] (:closure marker-text))]))\\n\\n\\n(deftype Continuation\\n  [owner payload]\\n  #?@(:cljd [cljd.core/IEquiv\\n             (-equiv [_ other]\\n                     (and (instance? Continuation other)\\n                          (= owner (.-owner ^Continuation other))\\n                          (= payload (.-payload ^Continuation other))))\\n             cljd.core/IHash\\n             (-hash [_] (hash [:continuation owner payload]))\\n             cljd.core/IPrint\\n             (-print [_ sink] (.write sink (:continuation marker-text)))\\n             Object\\n             (toString [_] (:continuation marker-text))]\\n      :clj [Object\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-Ec8YV0Vc' (errno=Operation not permitted)\\n2026-11-11 03:15:30.042 xcodebuild[97371:121022765]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 03:15:30.252 xcodebuild[97371:121022763] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\"Input/output error\\\". Using NSCachesDirectory instead.\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-xni5qdFF' (errno=Operation not permitted)\\n2026-11-11 03:15:30.938 xcodebuild[97376:121022814]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 03:15:31.104 xcodebuild[97376:121022812] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\"Input/output error\\\". Using NSCachesDirectory instead.\\n  3250\\t   linked unit's definition table instead, as a Python module body\\n  3251\\t   writes its dictionary. Lexically bound names, quoted literals and\\n  3252\\t   macro definitions keep their store shape: a macro is not a runtime\\n  3253\\t   value.\\\"\\n  3254\\t  [node names bound]\\n  3255\\t  (case (:type node)\\n  3256\\t    :literal node\\n  3257\\t    :vm/current-continuation node\\n  3258\\t    :variable (if (and (contains? names (:name node))\\n  3259\\t                       (not (contains? bound (:name node))))\\n  3260\\t                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\\n  3261\\t                node)\\n  3262\\t    :lambda (assoc node :body (publish-to-globals (:body node) names\\n  3263\\t                                                  (into bound (:params node))))\\n  3264\\t    :application\\n  3265\\t    (if (and (= 'yin/def (get-in