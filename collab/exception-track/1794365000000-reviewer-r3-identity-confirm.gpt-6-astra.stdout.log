\\n  1630\\t                                                (u/lit :clj/escape-token))\\n  1631\\t                                         (u/v 'dsg__call_token))\\n  1632\\t                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\\n  1633\\t                                  (outcome-node\\n  1634\\t                                    error-tag\\n  1635\\t                                    (u/app (u/v 'dsg__assoc)\\n  1636\\t                                           (u/app (u/v 'yang.call/condition)\\n  1637\\t                                                  (u/lit :yang.call/invalid-invocation)\\n  1638\\t                                                  (u/lit {:yang.call/reason :missing-raise-exit}))\\n  1639\\t                                           (u/lit :dsg__condition) (u/v 'dsg__call_token))))))\\n  1640\\t                       u/capture)\\n  1641\\t          routed (if (::invoker env)\\n  1642\\t                   (u/if-node\\n  1643\\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\\n  1644\\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\\n  1645\\t                                           (u/lit true)\\n  1646\\t                                           ;; the shape is only WHEN to ask (ruling of\\n  1647\\t                                           ;; record, rule 2): the heap answers\\n  1648\\t                                           ;; `cell/authentic?`, and an unauthenticated\\n  1649\\t                                           ;; shape takes ordinary map invocation\\n  1650\\t                                           (u/if-node (cell-ref-shaped-node (u/v callee))\\n  1651\\t                                                      (u/app (u/v 'cell/authentic?) (u/v callee))\\n  1652\\t                                                      (u/lit false)))\\n  1653\\t                                (u/lit false))\\n  1654\\t                     admitted\\n  1655\\t                     value-call)\\n  1656\\t                   admitted)]\\n  1657\\t      (cond-> (u/mark-tails (u/let1 callee callee-ast\\n  1658\\t                                    (u/let1 arguments arguments-ast routed)))\\n  1659\\t        tail? (assoc :tail? true)))))\\n  1660\\t\\n  1661\\t\\n  1662\\t(defn- compile-apply\\n  1663\\t  \\\"(apply f a b coll) as one application of f to the assembled argument\\n  1664\\t   vector (into [a b] (vec coll)): the convention's own calling shape, so it\\n  1665\\t   serves a guest closure and an adapted native alike.\\\"\\n  1666\\t  [operands env tail? macro-env]\\n  1667\\t  (when (< (count operands) 2)\\n  1668\\t    (reject! \\\"apply takes a function and an argument collection\\\"\\n  1669\\t             {:operands (count operands)}))\\n  1670\\t  (let [[f & more] operands\\n  1671\\t        lead (vec (butlast more))\\n  1672\\t        coll-form (list 'vec (last more))]\\n  1673\\t    (compile-guest-call (compile-form f false env macro-env)\\n  1674\\t                        (compile-form (if (seq lead)\\n  1675\\t                                        (list 'data/into lead coll-form)\\n  2360\\t                                                                       (:yin.k/arities profile)\\n  2361\\t                                                                       profile)]\\n  2362\\t                                                          [sym a])))\\n  2363\\t                                                (when (map? (:native opts)) (:native opts)))\\n  2364\\t                                 :macros (set (:macros opts))}\\n  2365\\t                   ::defined defined\\n  2366\\t                   ::defined-fns defined-fns\\n  2367\\t                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\\n  2368\\t                                                  (= 'invoke-value (second %))\\n  2369\\t                                                  (:yin.k/invoker (meta (second %)))) forms))}\\n  2370\\t            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\\n  2371\\t\\n  2372\\t\\n  2373\\t(defn- check-program-symbols!\\n  2374\\t  \\\"The program pre-pass. Quoted data is exempt. The reserved prefix names\\n  2375\\t   compiler temporaries, so no user symbol may carry it in ANY position\\n  2376\\t   (binder, reference, definition name); `loop` and `recur` are special forms,\\n  2377\\t   so they may only head a list, never stand as a value or a binder.\\\"\\n  2378\\t  [form]\\n  2379\\t  (cond\\n  2380\\t    (symbol? form)\\n  2381\\t    (do (when (reserved-name? form)\\n  2382\\t          (reject! \\\"Symbol uses the reserved destructuring prefix\\\"\\n  2383\\t                   {:symbol form, :prefix reserved-prefix}))\\n  2384\\t        (when (and (nil? (namespace form)) (contains? #{'loop 'recur} form))\\n  2385\\t          (reject! (str form \\\" is only legal in operator position\\\") {:symbol form})))\\n  2386\\t    (seq? form)\\n  2387\\t    (when-not (= 'quote (first form))\\n  2388\\t      (let [head (first form)]\\n  2389\\t        (when (and (symbol? head) (reserved-name? head))\\n  2390\\t          (reject! \\\"Symbol uses the reserved destructuring prefix\\\"\\n  2391\\t                   {:symbol head, :prefix reserved-prefix}))\\n  2392\\t        (when-not (symbol? head)\\n  2393\\t          (check-program-symbols! head))\\n  2394\\t        (run! check-program-symbols! (rest form))))\\n  2395\\t    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\\n  2396\\t    (coll? form) (run! check-program-symbols! form)))\\n  2397\\t\\n  2398\\t\\n  2399\\t(defn- check-top-level-discard!\\n  2400\\t  \\\"Only the last top-level form's outcome reaches the harness, so a non-final,\\n  2401\\t   non-definition form that may fail would have its error silently discarded:\\n  2402\\t   refuse it, as a def value that calls guest functions is refused. Returns\\n  2403\\t   `form`.\\\"\\n  2404\\t  [env macro-env forms form]\\n  2405\\t  (when (and (next forms)\\n  2406\\t             (not (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form))))\\n  2407\\t             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\\n  2408\\t    (reject! \\\"A non-final top-level form that may fail would discard its error outcome\\\"\\n  2409\\t             {:form form}))\\n  2410\\t  form)\\n  2411\\t\\n  2412\\t\\n  2413\\t(defn- lower-top-form\\n  2414\\t  \\\"Under the outcome model a top-level expression returns an outcome like a\\n  2415\\t   function body; definitions keep their own lowering.\\\"\\n  2416\\t  [env macro-env form]\\n  2417\\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\\n  2418\\t    form\\n  2419\\t    (lower-function-body env macro-env [] [form])))\\n  2420\\t\\n  2421\\t\\n  2422\\t(defn- strip-top-outcome\\n  2423\\t  [ast]\\n  2424\\t  (let [top-res (symbol (str reserved-prefix \\\"top_res\\\"))\\n  2425\\t        top-err (symbol (str reserved-prefix \\\"top_err\\\"))]\\n  2426\\t    (u/let1 top-res ast\\n  2427\\t            (u/if-node\\n  2428\\t              (u/if-node (u/app (u/v 'data/vector?) (u/v top-res))\\n  2429\\t                         (u/if-node (u/app (u/v 'dsg__equal)\\n  2430\\t                                           (u/app (u/v 'data/count) (u/v top-res))\\n  2431\\t                                           (u/lit 2))\\n  2432\\t                                    (u/app (u/v 'dsg__equal)\\n  2433\\t                                           (u/app (u/v 'data/nth) (u/v top-res) (u/lit 0))\\n  2434\\t                                           (u/lit error-tag))\\n  2435\\t                                    (u/lit false))\\n  2436\\t                         (u/lit false))\\n  2437\\t              (u/let1 top-err (u/app (u/v 'data/nth) (u/v top-res) (u/lit 1))\\n  2438\\t                      (u/if-node\\n  2439\\t                        (u/if-node (u/app (u/v 'data/map?) (u/v top-err))\\n  2440\\t                                   (u/app (u/v 'dsg__equal)\\n  2441\\t                                          (u/app (u/v 'dsg__get) (u/v top-err) (u/lit :dsg__condition))\\n  2442\\t                                          (u/v 'dsg__call_token))\\n  2443\\t                                   (u/lit false))\\n  2444\\t                        (outcome-node error-tag (u/app (u/v 'data/dissoc) (u/v top-err) (u/lit :dsg__condition)))\\n  2445\\t                        (u/v top-res)))\\n  2446\\t              (u/v top-res)))))\\n  2447\\t\\n  2448\\t\\n  2449\\t(defn compile-program\\n  2450\\t  \\\"Compile a sequence of Clojure forms into a single Universal AST.\\n  2451\\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\\n  2452\\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\\n  2453\\t   with :macro? true on the lambda; the encoder turns that flag into a\\n  2454\\t   declaration row and the expander, not this compiler, recognizes calls.\\n  2455\\t   The three-argument form takes `opts` opting into the argument-vector\\n  2456\\t   convention (see `program-env`); without it the output is the native one.\\\"\\n  2457\\t  ([forms] (compile-program forms true))\\n  2458\\t  ([forms tail?] (compile-program forms tail? nil))\\n  2459\\t  ([forms tail? opts]\\n  2460\\t   (run! check-program-symbols! forms)\\n  2461\\t   (let [env (program-env forms opts)]\\n  2462\\t     ;; A discarded definition must not become a lexical binding in the\\n  2463\\t     ;; following definitions. Descriptor entry and body closures both capture\\n  2464\\t     ;; their environment: retaining the previous descriptor here doubles its\\n  2465\\t     ;; paths at each definition during machine-data validation and UCF lift.\\n  2466\\t     (letfn [(discard-result\\n  2467\\t               [ast]\\n  2468\\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\\n  2469\\t             (go\\n  2470\\t               [forms macro-env]\\n  2471\\t               (if (empty? forms)\\n  2472\\t                 (compile-literal nil tail?)\\n  2473\\t                 (let [head       (cond->> (first forms)\\n  2474\\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\\n  2475\\t                                    (outcomes? env) (lower-top-form env macro-env))\\n  2476\\t                       rest-forms (rest forms)]\\n  2477\\t                   (cond\\n  2478\\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\\n  2479\\t                     ;; lambda the encoder declares; later forms see the name\\n  2480\\t                     ;; only so the native defn lowering can yield to it.\\n  2481\\t                     (and (seq? head) (= 'defmacro (first head)))\\n  2482\\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\\n  2483\\t                       (cond-> {:type     :application\\n  2484\\t                                :operator {:type :lambda, :params ['_]\\n  2485\\t                                           :body (go rest-forms\\n  2486\\t                                                     (assoc macro-env\\n  2487\\t                                                            (strip-symbol-meta (second head))\\n  2488\\t                                                            {:type :user}))}\\n  2489\\t                                :operands [(discard-result defined)]}\\n  2490\\t                         tail? (assoc :tail? true)))\\n  2491\\t                     ;; def: sequence with current macro-env\\n  2492\\t                     (and (seq? head) (= 'def (first head)))\\n  2493\\t                     (let [[_ name value] head\\n  2494\\t                           value (cond-> value (outcomes? env) rewrite-ex-info)]\\n  2495\\t                       (when (and (outcomes? env)\\n  2496\\t                                  (failing? (assoc env ::macro-env macro-env) value))\\n  2497\\t                         (reject! \\\"A def value cannot call guest functions under the outcome model\\\"\\n  2498\\t                                  {:name name}))\\n  2499\\t                       (cond-> {:type     :application\\n  2500\\t                                :operator {:type :lambda, :params ['_]\\n  2501\\t                                           :body (go rest-forms macro-env)}\\n  2502\\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\\n  2503\\t                         tail? (assoc :tail? true)))\\n  2504\\t                     ;; single form\\n  2505\\t                     (= 1 (count forms))\\n  2506\\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\\n  2507\\t                     ;; sequence\\n  2508\\t                     :else\\n  2509\\t                     (cond-> {:type     :application\\n  2510\\t                              :operator {:type :lambda, :params ['_]\\n  2511\\t                                         :body (go rest-forms macro-env)}\\n  2512\\t                              :operands [(discard-result\\n  2513\\t                                           (compile-form head false\\n  2514\\t                                                         (assoc env ::top-level true) macro-env))]}\\n  2515\\t                       tail? (assoc :tail? true))))))]\\n  2516\\t       (annotate-call-sites\\n  2517\\t         (cond->> (go forms initial-macro-env)\\n  2518\\t           (outcomes? env) strip-top-outcome\\n  2519\\t           ;; The two sibling closures share one frame: separate bindings would\\n  2520\\t           ;; retain one extra helper environment in every closure a guest\\n  2521\\t           ;; captures (the machine-data validation bound notices).\\n  2522\\t           (outcomes? env) (#(u/app\\n  2523\\t                               (u/lam '[dsg__admitted? dsg__intra_call] %)\\n  2524\\t                               (u/sexp->uast\\n  2525\\t                                 '(fn [dsg__candidate]\\n  2526\\t                                    (if (data/map? dsg__candidate)\\n  2527\\t                                      ;; A map is offered to the dereference\\n  2528\\t                                      ;; only when the heap authenticates it\\n(ns yang.tails\\n  \\\"Tail marks over the Universal AST, shared by every stage that builds or\\n   rewrites a tree. A tail call pushes no frame on the VMs that honour the\\n   mark, so a mark is only sound for the tree it was computed over: a stage\\n   that wraps a body must strip every mark and recompute them over the whole\\n   derived tree, or a wrapped body's old tail calls would skip the wrapper.\\\"\\n  (:require\\n    [yin.vm :as vm]))\\n\\n\\n(defn mark-tails\\n  \\\"Set `:tail? true` on every application in tail position of a lambda body,\\n   through `if` branches. Definitions are never marked. Lowering relies on\\n   this for loops, which are self-applied lambdas: the recursive call and the\\n   sequencing lambda around it are both tail calls, so an iteration grows no\\n   continuation on the VMs that honour the mark.\\\"\\n  [node]\\n  (letfn [(walk\\n            [node tail?]\\n            (case (:type node)\\n              :lambda (assoc node :body (walk (:body node) true))\\n              :if (assoc node\\n                         :test (walk (:test node) false)\\n                         :consequent (walk (:consequent node) tail?)\\n                         :alternate (walk (:alternate node) tail?))\\n              :application\\n              (let [definition? (= 'yin/def (:name (:operator node)))\\n                    node (assoc node\\n                                :operator (walk (:operator node) false)\\n                                :operands (mapv #(walk % false)\\n                                                (:operands node)))]\\n                (if (and tail? (not definition?))\\n                  (assoc node :tail? true)\\n                  node))\\n              node))]\\n    (walk node false)))\\n\\n\\n(defn strip-tails\\n  \\\"`node` with every `:tail?` mark removed, at every depth and under every\\n   node type the row grammar knows, so `mark-tails` starts from nothing.\\\"\\n  [node]\\n  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\\n    (reduce (fn [n [field kind]]\\n              (case kind\\n                :node (update n field strip-tails)\\n                :nodes (update n field #(mapv strip-tails %))\\n                n))\\n            (dissoc node :tail?)\\n            slots)))\\n\\n\\n(defn remark-tails\\n  \\\"Strip every tail mark and recompute them over the whole of `node`.\\\"\\n  [node]\\n  (mark-tails (strip-tails node)))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '3830,3910p' docs/design/yang.antlr.md; rg -n 'condition-identical|saved-protocol|retain|later|clojure/protocol' test/yang/call/exception*.clj; rg -n 'reserved|check-program-symbols|check-binder|rewrite-ex-info' src/cljc/yang/clojure.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '3830,3910p' docs/design/yang.antlr.md; rg -n 'condition-identical|saved-protocol|retain|later|clojure/protocol' test/yang/call/exception*.clj; rg -n 'reserved|check-program-symbols|check-binder|rewrite-ex-info' src/cljc/yang/clojure.cljc\\\"\",\"aggregated_output\":\"on the stack. No caller-side rewrapping or language-pair cache is allowed.\\n\\nThese are in-task rules. A closure, continuation, cell, or live invocation\\nis not made portable by this convention. Linker/UCF custody and admission\\nstill govern task/host crossings; currently refused cell-bearing lifts\\nremain refused. Live closures in an invocation must not be placed in\\ncanonical literal data or sent as a purported portable request.\\n\\n#### 8.10.7 Normal return and escaping conditions\\n\\nNormal return is the value of ordinary Yin application. There is no\\nextra return continuation, completion packet around each result, or new\\nlanguage-specific return instruction.\\n\\nAn escaping source exception invokes the supplied raise exit with:\\n\\n```clojure\\n{:yang.call/reason :yang.call/thrown\\n :yang.call/value  original-thrown-value}\\n```\\n\\nThis is the argument to an exceptional continuation transfer, not an\\nordinary return. Returning an identical-looking map returns normal data.\\nLikewise, a source program throwing a map with these keys throws that\\nmap as the **payload of a new condition**; its shape is never evidence\\nthat it is already a condition to forward. No engine-effect value is\\nsynthesized.\\n\\nProtocol failures use qualified reasons such as\\n`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\\n`:yang.call/unsupported-binding`, with plain evidence. The caller maps\\nthem to a documented local exception form retaining the complete\\noriginal condition. Callee argument-binding failures retain the actual\\ncallee exception under `:yang.call/thrown`. These reasons do not extend\\n`dao.stream`'s outcome algebra.\\n\\nThe receiving caller interprets an escaping exception as follows:\\n\\n1. A payload valid as an exception in its own runtime retains that\\n   runtime's ordinary catching and identity behavior.\\n2. A runtime permitting arbitrary thrown values, such as JavaScript,\\n   may deliver the original payload directly.\\n3. A runtime requiring exception objects, such as Python or PHP,\\n   represents an otherwise foreign payload with its own\\n   `ForeignException`, retaining the complete condition and original\\n   payload. Catch-all catches this local object. Typed source catches\\n   match its local hierarchy, never guessed foreign class names.\\n\\n`ForeignException` is a proposed prelude-owned type, not a VM type.\\nUnchanged rethrow propagates the original condition without adding\\nwrappers. Raising a new exception creates a new condition. Crossing back\\ninto a runtime recognizing the original exception restores its original\\ntype and identity. Formatting a foreign payload must not implicitly\\ninvoke a foreign method.\\n\\nThe runtime associates its generated wrapper's identity with the retained\\ncondition for the wrapper's entire lifetime, separate from source-writable\\nattributes. The association normally lives in private wrapper-cell\\ncontents, or an equivalent task-owned identity structure with the same\\nlifetime. It survives storing or returning the wrapper after the creating\\ncall/catch activation has ended, and remains recoverable when that same\\nwrapper is rethrown in another activation. Temporary catch state alone is\\ninsufficient. Reachability/reclamation must retain the condition and its\\npayload while the wrapper is live, without an ambient registry.\\n\\nThe runtime must not detect wrappers or unwrap arbitrary maps by their\\nkey names. JavaScript may expose raw payloads for\\n`:yang.call/thrown`; its local exception for a protocol failure must still\\nretain that failure's qualified condition. Rethrowing the same generated\\nexception forwards that complete condition, including protocol reasons;\\nthrowing an unrelated value creates a new `:yang.call/thrown` condition.\\nSaved activation state refers to this identity-owned association; exiting\\nor restoring a catch does not destroy it.\\n\\nVM application/custody defects and host implementation failures remain\\noperational failures. Do not catch them broadly and relabel them as\\nsource exceptions. Existing explicit stream/module refusals keep their\\nsource mappings under the relevant profiles.\\n\\n#### 8.10.8 Cleanup, re-entry, and suspension\\n\\ntest/yang/call/exception_contract.clj:21:   `retain` returns normally before `later` raises from a new activation.\\ntest/yang/call/exception_contract.clj:36:              \\\"def retain(f):\\\" \\\"    global saved\\\"\\ntest/yang/call/exception_contract.clj:39:              \\\"def later():\\\" \\\"    raise saved\\\"\\ntest/yang/call/exception_contract.clj:55:        \\\"globalThis.retain = function(f) { try { return f(); } catch (e) { saved = e; return e; } };\\\"\\ntest/yang/call/exception_contract.clj:56:        \\\"globalThis.later = function() { throw saved; };\\\"\\ntest/yang/call/exception_contract.clj:66:        \\\"function retain($f) { global $saved; try { return $f(); } catch (Throwable $e) { $saved = $e; return $e; } }\\\"\\ntest/yang/call/exception_contract.clj:67:        \\\"function later() { global $saved; throw $saved; }\\\"\\ntest/yang/call/exception_contract.clj:78:        \\\"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \\\"\\ntest/yang/call/exception_contract.clj:79:        \\\"(defn later [] (throw (cell/get saved))) \\\"\\ntest/yang/call/exception_contract.clj:113:                  :condition-identical true :reason reason}\\ntest/yang/call/exception_contract.clj:122:        (fixture :retained-foreign-lifetime f #{::r2 ::r5}\\ntest/yang/call/exception_contract.clj:123:                 {:retained true :local-foreign-exception true\\ntest/yang/call/exception_contract.clj:125:                  :condition-identical true :payload-identical true}))\\ntest/yang/call/exception_contract.clj:127:        (fixture (keyword (str \\\"saved-protocol-\\\" (name reason))) f #{::r3 ::r5}\\ntest/yang/call/exception_contract.clj:128:                 {:retained true :transferred true :once true :after false\\ntest/yang/call/exception_contract.clj:129:                  :condition-identical true :reason reason}\\ntest/yang/call/exception_contract.clj:153:   :retained-lifetime #{::r1 ::r2