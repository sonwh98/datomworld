ain\\\\\\\\n   113\\\\\\\\t     module dictionary, the clojure runtime's task-local namespace cell);\\\\\\\\n   114\\\\\\\\t   - `:project`: name and a value form to the form binding the value where\\\\\\\\n   115\\\\\\\\t     the runtime's source resolves a called name;\\\\\\\\n   116\\\\\\\\t   - `:render`: the `:run-main` value as test data.\\\\\\\\\\\\\\\"\\\\\\\\n   117\\\\\\\\t  {:typescript\\\\\\\\n   118\\\\\\\\t   {:runtime 'js,\\\\\\\\n   119\\\\\\\\t    :address #(:address @h/published),\\\\\\\\n   120\\\\\\\\t    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\\\\\\\\n   121\\\\\\\\t    :parse #(parse-ok ts-cst/parse-source %),\\\\\\\\n   122\\\\\\\\t    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\\\\\\\\n   123\\\\\\\\t    :run-main 'js/run-main,\\\\\\\\n   124\\\\\\\\t    :read-export (fn [export] (list 'js/global-get {:js/str export})),\\\\\\\\n   125\\\\\\\\t    :project (fn [name value] (list 'js/define-global! name value)),\\\\\\\\n   126\\\\\\\\t    :render render/output},\\\\\\\\n   127\\\\\\\\t   :php\\\\\\\\n   128\\\\\\\\t   {:runtime 'php,\\\\\\\\n   129\\\\\\\\t    :address #(:address @published-php),\\\\\\\\n   130\\\\\\\\t    :refusal [:yang.php/refusal :yang.php/undeclared-free],\\\\\\\\n   131\\\\\\\\t    :parse #(parse-ok php-cst/parse-source %),\\\\\\\\n   132\\\\\\\\t    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\\\\\\\\n   133\\\\\\\\t    :run-main 'php/run-main,\\\\\\\\n   134\\\\\\\\t    :read-export (fn [export]\\\\\\\\n   135\\\\\\\\t                   (list 'php/resolve-fn (str/lower-case export) export)),\\\\\\\\n   136\\\\\\\\t    :project (fn [name value]\\\\\\\\n   137\\\\\\\\t               (list 'php/declare-function! (str/lower-case name) value)),\\\\\\\\n   138\\\\\\\\t    :render php-h/render},\\\\\\\\n   139\\\\\\\\t   :python\\\\\\\\n   140\\\\\\\\t   {:runtime 'py,\\\\\\\\n   141\\\\\\\\t    :address #(:address @published-py),\