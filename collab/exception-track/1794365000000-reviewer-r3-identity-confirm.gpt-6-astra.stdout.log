e the reserved prefix.\\\"\\n429:  (when (reserved-name? sym)\\n430:    (reject! \\\"Definition name uses the reserved destructuring prefix\\\"\\n431:             {:name sym, :prefix reserved-prefix})))\\n434:(defn- check-binder!\\n440:    (when (reserved-name? b)\\n441:      (reject! \\\"Binding name uses the reserved destructuring prefix\\\"\\n442:               {:binder b, :prefix reserved-prefix}))\\n463:              (check-binder! (second xs) pattern)\\n469:            (check-binder! sym pattern)\\n478:              (check-binder! x pattern)\\n508:  (cond-> (symbol (str reserved-prefix path))\\n554:          (do (check-binder! target target)\\n567:          :else (check-binder! target target))))))\\n579:            (check-binder! p params)\\n672:  \\\"Every macro parameter is a plain symbol outside the reserved prefix; an\\n676:    (check-binder! p params)\\n803:(def ^:private av-sym (symbol (str reserved-prefix \\\"av\\\")))\\n862:;; reserved `dsg__` prefix and bind through the internal `dsg__let`, which\\n902:  (symbol (str reserved-prefix \\\"o\\\" (swap! (::gen env) inc))))\\n905:(defn- rewrite-ex-info\\n917:                (rewrite-ex-info (second form))))\\n921:      (let [[_ msg data cause] (map rewrite-ex-info form)]\\n924:      :else (rebuild form (map rewrite-ex-info form)))\\n925:    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\\n926:    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\\n927:    (set? form) (into #{} (map rewrite-ex-info) form)\\n1138:                (check-binder! binding clause)\\n1186:              (rewrite-ex-info (body-expression body-forms))))\\n1275:    (check-binder! p params)))\\n1286:  (let [body (symbol (str reserved-prefix \\\"body\\\"))\\n1287:        invocation (symbol (str reserved-prefix \\\"invocation\\\"))\\n1288:        outcome (symbol (str reserved-prefix \\\"entry_outcome\\\"))\\n1319:        ;; reserved-prefix regime refuses binding or shadowing it. Maps\\n1513:    (let [callee (symbol (str reserved-prefix \\\"callee\\\"))\\n1514:          arguments (symbol (str reserved-prefix \\\"arguments\\\"))\\n1515:          escape (symbol (str reserved-prefix \\\"raise_escape\\\"))\\n1516:          condition (symbol (str reserved-prefix \\\"condition\\\"))\\n1517:          result (symbol (str reserved-prefix \\\"call_result\\\"))\\n1587:                                  (symbol (str reserved-prefix \\\"invoker_result\\\"))\\n1598:                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \\\"invoker_result\\\")))))\\n1894:          self (symbol (str reserved-prefix \\\"loop\\\" depth))\\n1964:;; `dsg__let` (no binder check) under the reserved prefix; the name carries a\\n1978:  (symbol (str reserved-prefix tag (::gen-depth env 0))))\\n2343:(defn- check-program-symbols!\\n2344:  \\\"The program pre-pass. Quoted data is exempt. The reserved prefix names\\n2351:    (do (when (reserved-name? form)\\n2352:          (reject! \\\"Symbol uses the reserved destructuring prefix\\\"\\n2353:                   {:symbol form, :prefix reserved-prefix}))\\n2359:        (when (and (symbol? head) (reserved-name? head))\\n2360:          (reject! \\\"Symbol uses the reserved destructuring prefix\\\"\\n2361:                   {:symbol head, :prefix reserved-prefix}))\\n2363:          (check-program-symbols! head))\\n2364:        (run! check-program-symbols! (rest form))))\\n2365:    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\\n2366:    (coll? form) (run! check-program-symbols! form)))\\n2377:             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\\n2403:   (run! check-program-symbols! forms)\\n2437:                           value (cond-> value (outcomes? env) rewrite-ex-info)]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '3828,3905p' docs/design/yang.antlr.md; cat src/cljc/yang/tails.cljc; sed -n '900,930p' src/cljc/yang/clojure.cljc; sed -n '65,125p' test/yang/call/exception_probes.clj\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '3828,3905p' docs/design/yang.antlr.md; cat src/cljc/yang/tails.cljc; sed -n '900,930p' src/cljc/yang/clojure.cljc; sed -n '65,125p' test/yang/call/exception_probes.clj\\\"\",\"aggregated_output\":\"Functions passed, returned, or called recursively keep the common entry\\nand original identity. This includes calls back into a runtime already\\non the stack. No caller-side rewrapping or language-pair cache is allowed.\\n\\nThese are in-task rules. A closure, continuation, cell, or live invocation\\nis not made portable by this convention. Linker/UCF custody and admission\\nstill govern task/host crossings; currently refused cell-bearing lifts\\nremain refused. Live closures in an invocation must not be placed in\\ncanonical literal data or sent as a purported portable request.\\n\\n#### 8.10.7 Normal return and escaping conditions\\n\\nNormal return is the value of ordinary Yin application. There is no\\nextra return continuation, completion packet around each result, or new\\nlanguage-specific return instruction.\\n\\nAn escaping source exception invokes the supplied raise exit with:\\n\\n```clojure\\n{:yang.call/reason :yang.call/thrown\\n :yang.call/value  original-thrown-value}\\n```\\n\\nThis is the argument to an exceptional continuation transfer, not an\\nordinary return. Returning an identical-looking map returns normal data.\\nLikewise, a source program throwing a map with these keys throws that\\nmap as the **payload of a new condition**; its shape is never evidence\\nthat it is already a condition to forward. No engine-effect value is\\nsynthesized.\\n\\nProtocol failures use qualified reasons such as\\n`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\\n`:yang.call/unsupported-binding`, with plain evidence. The caller maps\\nthem to a documented local exception form retaining the complete\\noriginal condition. Callee argument-binding failures retain the actual\\ncallee exception under `:yang.call/thrown`. These reasons do not extend\\n`dao.stream`'s outcome algebra.\\n\\nThe receiving caller interprets an escaping exception as follows:\\n\\n1. A payload valid as an exception in its own runtime retains that\\n   runtime's ordinary catching and identity behavior.\\n2. A runtime permitting arbitrary thrown values, such as JavaScript,\\n   may deliver the original payload directly.\\n3. A runtime requiring exception objects, such as Python or PHP,\\n   represents an otherwise foreign payload with its own\\n   `ForeignException`, retaining the complete condition and original\\n   payload. Catch-all catches this local object. Typed source catches\\n   match its local hierarchy, never guessed foreign class names.\\n\\n`ForeignException` is a proposed prelude-owned type, not a VM type.\\nUnchanged rethrow propagates the original condition without adding\\nwrappers. Raising a new exception creates a new condition. Crossing back\\ninto a runtime recognizing the original exception restores its original\\ntype and identity. Formatting a foreign payload must not implicitly\\ninvoke a foreign method.\\n\\nThe runtime associates its generated wrapper's identity with the retained\\ncondition for the wrapper's entire lifetime, separate from source-writable\\nattributes. The association normally lives in private wrapper-cell\\ncontents, or an equivalent task-owned identity structure with the same\\nlifetime. It survives storing or returning the wrapper after the creating\\ncall/catch activation has ended, and remains recoverable when that same\\nwrapper is rethrown in another activation. Temporary catch state alone is\\ninsufficient. Reachability/reclamation must retain the condition and its\\npayload while the wrapper is live, without an ambient registry.\\n\\nThe runtime must not detect wrappers or unwrap arbitrary maps by their\\nkey names. JavaScript may expose raw payloads for\\n`:yang.call/thrown`; its local exception for a protocol failure must still\\nretain that failure's qualified condition. Rethrowing the same generated\\nexception forwards that complete condition, including protocol reasons;\\nthrowing an unrelated value creates a new `:yang.call/thrown` condition.\\nSaved activation state refers to this identity-owned association; exiting\\nor restoring a catch does not destroy it.\\n\\nVM application/custody defects and host implementation failures remain\\noperational failures. Do not catch them broadly and relabel them as\\n(ns yang.tails\\n  \\\"Tail marks over the Universal AST, shared by every stage that builds or\\n   rewrites a tree. A tail call pushes no frame on the VMs that honour the\\n   mark, so a mark is only sound for the tree it was computed over: a stage\\n   that wraps a body must strip every mark and recompute them over the whole\\n   derived tree, or a wrapped body's old tail calls would skip the wrapper.\\\"\\n  (:require\\n    [yin.vm :as vm]))\\n\\n\\n(defn mark-tails\\n  \\\"Set `:tail? true` on every application in tail position of a lambda body,\\n   through `if` branches. Definitions are never marked. Lowering relies on\\n   this for loops, which are self-applied lambdas: the recursive call and the\\n   sequencing lambda around it are both tail calls, so an iteration grows no\\n   continuation on the VMs that honour the mark.\\\"\\n  [node]\\n  (letfn [(walk\\n            [node tail?]\\n            (case (:type node)\\n              :lambda (assoc node :body (walk (:body node) true))\\n              :if (assoc node\\n                         :test (walk (:test node) false)\\n                         :consequent (walk (:consequent node) tail?)\\n                         :alternate (walk (:alternate node) tail?))\\n              :application\\n              (let [definition? (= 'yin/def (:name (:operator node)))\\n                    node (assoc node\\n                                :operator (walk (:operator node) false)\\n                                :operands (mapv #(walk % false)\\n                                                (:operands node)))]\\n                (if (and tail? (not definition?))\\n                  (assoc node :tail? true)\\n                  node))\\n              node))]\\n    (walk node false)))\\n\\n\\n(defn strip-tails\\n  \\\"`node` with every `:tail?` mark removed, at every depth and under every\\n   node type the row grammar knows, so `mark-tails` starts from nothing.\\\"\\n  [node]\\n  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\\n    (reduce (fn [n [field kind]]\\n              (case kind\\n                :node (update n field strip-tails)\\n                :nodes (update n field #(mapv strip-tails %))\\n                n))\\n            (dissoc node :tail?)\\n            slots)))\\n\\n\\n(defn remark-tails\\n  \\\"Strip every tail mark and recompute them over the whole of `node`.\\\"\\n  [node]\\n  (mark-tails (strip-tails node)))\\n(defn- gen-sym\\n  [env]\\n  (symbol (str reserved-prefix \\\"o\\\" (swap! (::gen env) inc))))\\n\\n\\n(defn- rewrite-ex-info\\n  \\\"(ex-info msg data cause?) as the portable map holding its parts.\\\"\\n  [form]\\n  (cond\\n    (seq? form)\\n    (cond\\n      (empty? form) form\\n      (= 'quote (first form)) form\\n      (#{'.getMessage 'ex-message 'ex-data} (first form))\\n      (do (when-not (= 2 (count form))\\n            (reject! \\\"Error accessor requires one portable error value\\\" {:form form}))\\n          (list (if (= 'ex-data (first form)) :yin.k/data :yin.k/message)\\n                (rewrite-ex-info (second form))))\\n      (and (symbol? (first form)) (= \\\\. (first (name (first form)))))\\n      (reject! \\\"Host exception/interop accessor is not portable\\\" {:form form})\\n      (= 'ex-info (first form))\\n      (let [[_ msg data cause] (map rewrite-ex-info form)]\\n        (cond-> {:yin.k/message msg, :yin.k/data data}\\n          (< 3 (count form)) (assoc :yin.k/cause cause)))\\n      :else (rebuild form (map rewrite-ex-info form)))\\n    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\\n    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\\n    (set? form) (into #{} (map rewrite-ex-info) form)\\n    :else form))\\n\\n\\n  \\\"A fixture's guest-side assertions as plain booleans and qualified reasons.\\n   Neither live payloads nor wrappers are rendered or ferried between tasks.\\\"\\n  [{:keys [scenario frontend protocol-reason]}]\\n  (let [export #(read-export frontend %)\\n        result 'probe.result\\n        original 'probe.original\\n        condition 'probe.condition\\n        retained 'probe.retained\\n        wrapper 'probe.wrapper\\n        fresh-summary (assoc (transfer-summary result)\\n                             :reason (reason result)\\n                             :payload-identical (list '= original (payload result)))\\n        protocol-summary (assoc (transfer-summary result)\\n                                :reason (reason result)\\n                                :condition-identical\\n                                (list '= condition (list 'get result :condition)))]\\n    (kit/guard-exceptions-form\\n      [:python frontend]\\n      (cond\\n        (#{:fresh-named :fresh-closure :forged-retention} scenario)\\n        (list 'let [original (list 'get (call (export (if (= scenario :forged-retention)\\n                                                        \\\"forged\\\" \\\"payload\\\"))\\n                                              (if (= scenario :forged-retention)\\n                                                [(protocol-condition :yang.call/not-callable)] [])) :value)\\n                    result (case scenario\\n                             :fresh-named (call (export \\\"donor_raise\\\") [])\\n                             :fresh-closure\\n                             (call (list 'get (call (export \\\"make_exploder\\\") []) :value) [])\\n                             :forged-retention (call (export \\\"raise_value\\\") [original]))]\\n              (kit/observation-map-form fresh-summary))\\n\\n        (= scenario :binding)\\n        (list 'let [result (call (export \\\"needs_argument\\\") [])]\\n              (kit/observation-map-form\\n                (assoc (transfer-summary result) :reason (reason result))))\\n\\n        (#{:shape-return :shape-throw} scenario)\\n        (list 'let [original {:yang.call/reason :yang.call/not-callable\\n                              :yang.call/data {:nested [:ordinary :data]}}\\n                    result (call (export (if (= scenario :shape-return) \\\"echo\\\" \\\"raise_value\\\"))\\n                                 [original])]\\n              (kit/observation-map-form (if (= scenario :shape-return)\\n                                          {:returned (list '= (list 'get result :route) :return)\\n                                           :payload-identical (list '= original (list 'get result :value))}\\n                                          fresh-summary)))\\n\\n        protocol-reason\\n        (list 'let [condition (protocol-condition protocol-reason)\\n                    'probe.injected (injected condition)]\\n              (if (.startsWith (name scenario) \\\"saved-protocol-\\\")\\n                (list 'let [retained (call (export \\\"retain\\\") ['probe.injected])\\n                            result (call (export \\\"later\\\") [])]\\n                      (kit/observation-map-form\\n                        (assoc protocol-summary\\n                               :retained (list '= (list 'get retained :route) :return))))\\n                (list 'let [result (call (export \\\"receive\\\") ['probe.injected])]\\n                      (kit/observation-map-form protocol-summary))))\\n\\n        (= scenario :local-reception)\\n        (list 'let [original (list 'get (call (export \\\"payload\\\") []) :value)\\n                    condition (kit/observation-map-form\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"git show 778747ce:src/cljc/yang/clojure.cljc | nl -ba | sed -n '1685,1755p;2449,2527p;2605,2690p'; git show 778747ce:test/yang/clojure_test.clj | nl -ba | sed -n '2555,2665p;2725,2795p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"git show 778747ce:src/cljc/yang/clojure.cljc | nl -ba | sed -n '1685,1755p;2449,2527p;2605,2690p'; git show 778747ce:test/yang/clojure_test.clj | nl -ba | sed -n '2555,2665p;2725,2795p'\\\"\",\"aggregated_output\":\"git: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-dRKt0N1w' (errno=Operation not permitted)\\n2026-11-11 03:14:00.390 xcodebuild[96996:121019695]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 03:14:00.586 xcodebuild[96996:121019693] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\"Input/output error\\\". Using NSCachesDirectory instead.\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-Z0fPM6l4' (errno=Operation not permitted)\\n2026-11-11 03:14:01.334 xcodebuild[97000:121019719]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 03:14:01.534 xcodebuild[97000:121019717] [MT] DVTDeveloperPaths: Failed to get length