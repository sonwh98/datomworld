allocator.\n    (defn fresh-symbol\n      [supply prefix]\n      [(kind/symbol (kind/str \"G__\" prefix (:counter supply)))\n       (assoc supply :counter (+ (:counter supply) 1))])\n    (defn gensym\n      ([n] (if (int? n)\n             (kind/symbol (kind/str \"G__\" n))\n             (throw (ex-info \"gensym requires an explicit fresh-name supply\"\n                             {:prefix n :required 'fresh-symbol}))))\n      ([prefix n] (if (map? prefix) (fresh-symbol prefix n)\n                      (kind/symbol (kind/str prefix n)))))\n    (defn last\n      [coll]\n      (if (empty? coll) nil\n          (loop [s coll]\n            (if (empty? (rest s)) (first s) (recur (rest s))))))\n    (defn butlast\n      [coll]\n      (loop [s coll acc []]\n        (if (empty? s) (seq acc)\n            (if (empty? (rest s)) (seq acc)\n                (recur (rest s) (conj acc (first s)))))))\n    (defn nth\n      ([coll n] (if (nil? coll) nil (data/nth (vec coll) n)))\n      ([coll n missing] (if (and (int? n) (<= 0 n) (< n (count coll)))\n                          (data/nth (vec coll) n) missing)))\n    (defn string?\n      [x]\n      (= :yin.k/ok (first (yin.k/outcome-of (data/str-length x)))))\n    (defn with-meta\n      [x m]\n      (kind/with-meta x m))\n    (defn coll?\n      [x]\n      (if (nil? x)\n        false\n        (= :yin.k/ok (first (yin.k/outcome-of (data/count x))))))\n    (defn vector?\n      [x]\n      (if (nil? x)\n        false\n        (= :yin.k/ok (first (yin.k/outcome-of (data/peek x))))))\n    (defn map?\n      [x]\n      (if (nil? x)\n        false\n        (= :yin.k/ok (first (yin.k/outcome-of (data/dissoc x))))))\n    (defn set?\n      [x]\n      (if (nil? x)\n        false\n        (= :yin.k/ok (first (yin.k/outcome-of (data/disj x))))))\n    (defn sequential?\n      [x]\n      (if (coll? x) (if (map? x) false (not (set? x))) false))\n    (defn seq?\n      [x]\n      (if (sequential? x) (not (vector? x)) false))\n    (defn list?\n      [x]\n    