e-form\n  2457\t  \"Compile one Clojure form and retain the reader's plain metadata on the\n  2458\t   emitted Universal AST node. The tuple boundary removes it from content\n  2459\t   and writes positions and other frontend facts to occurrence side tables.\n  2460\t   The returned tree is C1-finalized (`annotate-call-sites`); recursive\n  2461\t   calls inside one compilation defer to the owning call's walk.\"\n  2462\t  ([form] (compile-form form false {} initial-macro-env))\n  2463\t  ([form env] (compile-form form false env initial-macro-env))\n  2464\t  ([form tail? env] (compile-form form tail? env initial-macro-env))\n  2465\t  ([form tail? env macro-env]\n  2466\t   (if *call-site-finalizing*\n  2467\t     (compile-form-1 form tail? env macro-env)\n  2468\t     (binding [*call-site-finalizing* true]\n  2469\t       (annotate-call-sites (compile-form-1 form tail? env macro-env))))))\n  2470\t\n  2471\t\n  2472\t(defn- top-level-defined-fns\n  2473\t  \"Plain symbols in `forms` whose top-level definitions are exclusively native\n  2474\t   `defn` or `defn-` descriptors. Any `def`, `defmacro`, or external macro\n  2475\t   excludes the symbol (or the unit, when macros are active) from static\n  2476\t   intra-unit dispatch so dynamic admission still governs.\"\n  2477\t  [forms external-macros]\n  2478\t  (if (or (seq external-macros)\n  2479\t          (some #(and (seq? %) (= 'defmacro (first %))) forms))\n  2480\t    #{}\n  2481\t    (:fns\n  2482\t      (reduce (fn [{:keys [fns non-fns] :as acc} f]\n  2483\t                (if-not (and (seq? f) (symbol? (second f)))\n  2484\t                  acc\n  2485\t                  (let [head (first f)\n  2486\t                        sym  (strip-symbol-meta (second f))]\n  2487\t                    (cond\n  2488\t                      (= 'def head)\n  2489\t                      {:fns (disj fns sym), :non-fns (conj non-fns sym)}\n  2490\t\n  2491\t                      (contains? #{'defn 'defn-} head)\n  2492\t                      {:fns     (if (contains? non-fns sym) fns (conj fns sym))\n  2493\t                       :non-fns non-fns}\n  2494\t\n  2495\t                      :else acc))))\n  2496\t              {:fns #{}, :non-fns #{}}\n  2497\t              forms))))\n  2498\t\n  2499\t\n  2500\t(defn- program-env\n  2501\t  \"The compile-time env of one program. Without `opts` it is empty: the\n  2502\t   native path. `{:convention :arg-vector, :native #{symbol}, :macros\n  2503\t   #{symbol}}` opts into the argument-vector convention: `:native` names the\n  2504\t   primitives a bare symbol may call directly (a set, or a map from name to\n  2505\t   its published profile, whose `:yin.k/arities` give an adapter its admitted\n  2506\t   counts), `:macros` the expander-side\n  2507\t   macro names whose calls must stay ordinary applications. The program's\n  2508\t   own top-level definitions are never native. `:outcomes true` adds the\n  2509\t   outcome model (see its section); `:adapters` maps a primitive that\n  2510\t   declares domain failures to the host adapter returning its outcome.\"\n  2511\t  [forms opts]\n  2512\t  (if-not opts\n  2513\t    {}\n  2514\t    (do (when-not (= :arg-vector (:convention opts))\n  2515\t          (reject! \"Unknown compile-program convention\" {:opts opts}))\n  2516\t        (when-let [hit (seq (filter control-heads (:macros opts)))]\n  2517\t          (reject! \"A :macros entry names a compiler form\" {:macros (vec hit)}))\n  2518\t        (let [defined (into #{}\n  2519\t                            (keep (fn [f]\n  2520\t                                    (when (and (seq? f)\n  2521\t                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\n  2522\t                                               (symbol? (second f)))\n  2523\t                                      (strip-symbol-meta (second f)))))\n  2524\t                            forms)\n  2525\t              defined-fns (top-level-defined-fns forms (:macros opts))]\n  2526\t          ;; the compiler emits bare conj and vec (collection literals, apply),\n  2527\t          ;; so a program definition of either would capture them\n  2528\t          (when-let [hit (first (filter #{'conj 'vec} defined))]\n  2529\t            (reject! (str \"Defining \" hit \" would capture the argument-vector constructor\")\n  2530\t                     {:name hit}))\n  2531\t          (cond-> {::convention {:native (set (if (map? (:native opts))\n  2532\t                                                (keys (:native opts))\n  2533\t                                                (:native opts)))\n  2534\t                                 :arities (into {}\n  2535\t                                                (keep (fn [[sym profile]]\n  2536\t                                                        (when-let [a (if (map? profile)\n  2537\t                                                                       (:yin.k/arities profile)\n  2538\t                                                                       profile)]\n  2539\t                                                          [sym a])))\n  2540\t                                                (when (map? (:native opts)) (:native opts)))\n  2541\t                                 :macros (set (:macros opts))}\n  2542\t                   ::defined defined\n  2543\t                   ::defined-fns defined-fns\n  2544\t                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n  2545\t                                                  (= 'invoke-value (second %))\n  2546\t                                                  (:yin.k/invoker (meta (second %)))) forms))}\n  2547\t            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n  2548\t\n  2549\t\n  2550\t(defn- check-program-symbols!\n  2551\t  \"The program pre-pass. Quoted data is exempt. The reserved prefix names\n  2552\t   compiler temporaries, so no