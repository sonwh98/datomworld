            _ (when-let [k (some #(when-not (keyword? %) %) (keys updates))]\n  2306\t                (fail \"Ready entry resource update carries a non-minted key\"\n  2307\t                      {:rule :resource-update-key, :key k}))\n  2308\t            base (assoc state\n  2309\t                        :ready-queue rest-queue\n  2310\t                        :resources (merge (:resources state) updates)\n  2311\t                        :blocked? false\n  2312\t                        :halted? false)]\n  2313\t        (if-let [terminal (terminal-resume-outcome entry)]\n  2314\t          (throw-terminal-resume! entry terminal)\n  2315\t          (restore-fn base entry (:value entry)))))))\n  2316\t\n  2317\t\n  2318\t(defn scheduler-round\n  2319\t  \"One round between continuations: poll the wait set, then resume whatever\n  2320\t   woke, through `restore-fn` (`base entry val -> state`, the one restore\n  2321\t   signature `yin.vm.engine.md` §2.1 states). Returns the polled state when\n  2322\t   nothing woke, so a caller always gets a state back.\n  2323\t\n  2324\t   The restore operation is a composition parameter\n  2325\t   (`yin.vm.engine.md` §7, edit 1); every VM was writing this composition\n  2326\t   by hand.\"\n  2327\t  [state restore-fn]\n  2328\t  (let [v' (check-wait-set state)]\n  2329\t    (or (resume-from-run-queue v' restore-fn) v')))\n  2330\t\n  2331\t\n  2332\t(defn scheduler-round-fuel\n  2333\t  \"One sweep with one budgeted action per child, then at most one resume.\n  2334\t   run-child is the semantic bounded entry with its budget already supplied.\"\n  2335\t  [state restore-fn run-child]\n  2336\t  (let [polled (check-wait-set state run-child)]\n  2337\t    (or (resume-from-run-queue polled restore-fn) polled)))\n  2338\t\n  2339\t\n  2340\t(defn park-id\n  2341\t  \"The local park id the next `park-continuation` mints: `:parked-N` from\n  2342\t   this VM's own counter, unique within the VM only.\"\n  2343\t  [state]\n  2344\t  (key