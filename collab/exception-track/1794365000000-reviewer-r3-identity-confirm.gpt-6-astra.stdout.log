          {:form form}))\n  2587\t  form)\n  2588\t\n  2589\t\n  2590\t(defn- lower-top-form\n  2591\t  \"Under the outcome model a top-level expression returns an outcome like a\n  2592\t   function body; definitions keep their own lowering.\"\n  2593\t  [env macro-env form]\n  2594\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\n  2595\t    form\n  2596\t    (lower-function-body env macro-env [] [form])))\n  2597\t\n  2598\t\n  2599\t(defn- strip-top-outcome\n  2600\t  [ast]\n  2601\t  (let [top-res (symbol (str reserved-prefix \"top_res\"))\n  2602\t        top-err (symbol (str reserved-prefix \"top_err\"))\n  2603\t        top-retained (symbol (str reserved-prefix \"top_retained\"))]\n  2604\t    (u/let1 top-res ast\n  2605\t            (u/if-node\n  2606\t              (u/if-node (u/app (u/v 'data/vector?) (u/v top-res))\n  2607\t                         (u/if-node (u/app (u/v 'dsg__equal)\n  2608\t                                           (u/app (u/v 'data/count) (u/v top-res))\n  2609\t                                           (u/lit 2))\n  2610\t                                    (u/app (u/v 'dsg__equal)\n  2611\t                                           (u/app (u/v 'data/nth) (u/v top-res) (u/lit 0))\n  2612\t                                           (u/lit error-tag))\n  2613\t                                    (u/lit false))\n  2614\t                         (u/lit false))\n  2615\t              (u/let1 top-err (u/app (u/v 'data/nth) (u/v top-res) (u/lit 1))\n  2616\t                      (u/let1 top-retained\n  2617\t                              (u/app (u/v 'dsg__condition_retained) (u/v top-err))\n  2618\t                              (u/if-node\n  2619\t                                (u/app (u/v 'dsg__equal) (u/v top-retained) (u/lit nil))\n  2620\t                                (u/v top-res)\n  2621\t                                (outcome-node\n  2622\t                                  error-tag\n  2623\t                                  (u/app (u/v 'data/nth) (u/v top-retained) (u/lit 1))))))\n  2624\t              (u/v top-res)))))\n  2625\t\n  2626\t\n  2627\t(defn compile-program\n  2628\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n  2629\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n  2630\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n  2631\t   with :macro? true on the lambda; the encoder turns that flag into a\n  2632\t   declaration row and the expander, not this compiler, recognizes calls.\n  2633\t   The three-argument form takes `opts` opting into the argument-vector\n  2634\t   convention (see `program-env`); without it the output is the native one.\"\n  2635\t  ([forms] (compile-program forms true))\n  2636\t  ([forms tail?] (compile-program forms tail? nil))\n  2637\t  ([forms tail? opts]\n  2638\t   (run! check-program-symbols! forms)\n  2639\t   (let [env (program-env forms opts)]\n  2640\t     ;; A discarded definition must not become a lexical binding in the\n  2641\t     ;; following definitions. Descriptor entry and body closures both capture\n  2642\t     ;; their environment: retaining the previous descriptor here doubles its\n  2643\t     ;; paths at each definition during machine-data validation and UCF lift.\n  2644\t     (letfn [(discard-result\n  2645\t               [ast]\n  2646\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n  2647\t             (go\n  2648\t               [forms macro-env]\n  2649\t               (if (empty? forms)\n  2650\t                 (compile-literal nil tail?)\n  2651\t                 (let [head       (cond->> (first forms)\n  2652\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\n  2653\t                                    (outcomes? env) (lower-top-form env macro-env))\n  2654\t                       rest-forms (rest forms)]\n  2655\t                   (cond\n  2656\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n  2657\t                     ;; lambda the encoder declares; later forms see the name\n  2658\t                     ;; only so the native defn lowering can yield to it.\n  2659\t                     (and (seq? head) (= 'defmacro (first head)))\n  2660\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n  2661\t                       (cond-> {:type     :application\n  2662\t                                :operator {:type :lambda, :params ['_]\n  2663\t                                           :body (go rest-forms\n  2664\t                                                     (assoc macro-env\n  2665\t                                                            (strip-symbol-meta (second head))\n  2666\t                                                            {:type :user}))}\n  2667\t                                :operands [(discard-result defined)]}\n  2668\t                         tail? (assoc :tail? true)))\n  2669\t                     ;; def: sequence with current macro-env\n  2670\t                     (and (seq? head) (= 'def (first head)))\n  2671\t                     (let [[_ name value] head\n  2672\t                           value (cond-> value (outcomes? env) rewrite-ex-info)]\n  2673\t                       (when (and (outcomes? env)\n  2674\t                                  (failing? (assoc env ::macro-env macro-env) value))\n  2675\t                         (reject! \"A def value cannot call guest functions under the outcome model\"\n  2676\t                                  {:name name}))\n  2677\t                       (cond-> {:type     :application\n  2678\t                                :operator {:type :lambda, :params ['_]\n  2679\t                                           :body (go rest-forms macro-env)}\n  2680\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\n  2681\t                         tail? (assoc :tail? true)))\n  2682\t                     ;; single form\n  2683\t                     (= 1 (count forms))\n  2684\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n  2685\t                     ;; sequence\n  2686\t                     :else\n  2687\t                     (cond-> {:type     :application\n  2688\t                              :operator {:type :lambda, :params ['_]\n  2689\t                                         :body (go rest-forms macro-env)}\n  2690\t                              :operands [(discard-result\n  2691\t                                           (compile-form head false\n  2692\t                                                         (assoc env ::top-level true) macro-env))]}\n  2693\t                       tail? (assoc :tail? true))))))]\n  2694\t       (annotate-call-sites\n  2695\t         (cond->> (go forms initial-macro-env)\n  2696\t           (outcomes? env) strip-top-outcome\n  2697\t           ;; The two sibling closures share one frame: separate bindings would\n  2698\t           ;; retain one extra helper environment in every closure a guest\n  2699\t           ;; captures (the machine-data validation bound notices).\n  2700\t           (outcomes? env) (#(u/app\n  2701\t                               (u/lam '[dsg__admitted? dsg__intra_call] %)\n  2702\t                               (u/sexp->uast\n  2703\t                                 '(fn [dsg__candidate]\n  2704\t                                    (if (data/map? dsg__candidate)\n  2705\t                                      ;; A map is offered to the dereference\n  2706\t                                      ;; only when the heap authenticates it\n  2707\t                                      ;; (ruling of record, rule 2), as the\n  2708\t                                      ;; descriptor projection treats a\n  2709\t                                      ;