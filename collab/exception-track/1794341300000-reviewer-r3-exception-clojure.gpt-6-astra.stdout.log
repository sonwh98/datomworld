   (reject! \"Symbol uses the reserved destructuring prefix\"\n2353:                   {:symbol form, :prefix reserved-prefix}))\n2359:        (when (and (symbol? head) (reserved-name? head))\n2360:          (reject! \"Symbol uses the reserved destructuring prefix\"\n2361:                   {:symbol head, :prefix reserved-prefix}))\n2363:          (check-program-symbols! head))\n2364:        (run! check-program-symbols! (rest form))))\n2365:    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n2366:    (coll? form) (run! check-program-symbols! form)))\n2377:             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\n2403:   (run! check-program-symbols! forms)\n2437:                           value (cond-> value (outcomes? env) rewrite-ex-info)]\n","exit_code":0,"status":"completed"}}
