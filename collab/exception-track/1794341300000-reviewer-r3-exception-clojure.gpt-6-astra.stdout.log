n [inner item]\\\\n  1687\\\\t              (let [ik (kids ctx item)\\\\n  1688\\\\t                    v (gen \\\\\\\"wv\\\\\\\" item)]\\\\n  1689\\\\t                (app* 'py/with\\\\n  1690\\\\t                      ((:lower ctx) ctx (first ik))\\\\n  1691\\\\t                      (u/lam [v]\\\\n  1692\\\\t                             (if (p/has-token? (:pk ctx) item \\\\\\\"as\\\\\\\")\\\\n  1693\\\\t                               (u/then (assign-target ctx (last ik) (u/v v)) inner)\\\\n  1694\\\\t                               inner)))))\\\\n  1695\\\\t            body\\\\n  1696\\\\t            (reverse items))))\\\\n  1697\\\\t\\\\n  1698\\\\t\\\\n  1699\\\\t(defn- lower-try-except\\\\n  1700\\\\t  \\\\\\\"`try` with `except` clauses and an optional `else`: `blocks` are the try\\\\n  1701\\\\t   body, one block per clause, then the else block if any.\\\\\\\"\\\\n  1702\\\\t  [ctx n blocks]\\\\n  1703\\\\t  (let [exc (gen \\\\\\\"exc\\\\\\\" n)\\\\n  1704\\\\t        clauses (rules ctx n \\\\\\\"except_clause\\\\\\\")\\\\n  1705\\\\t        body (u/seq-nodes (lower-block ctx (first blocks)))\\\\n  1706\\\\t        handler-blocks (subvec blocks 1 (inc (count clauses)))\\\\n  1707\\\\t        else-block (get blocks (inc (count clauses)))\\\\n  1708\\\\t        hctx (assoc ctx :exc exc)\\\\n  1709\\\\t        dispatch\\\\n  1710\\\\t        (reduce\\\\n  1711\\\\t          (fn [fallthrough [clause block]]\\\\n  1712\\\\t            (let [ck (kids ctx clause)\\\\n  1713\\\\t                  cls-node (first (rules ctx clause \\\\\\\"test\\\\\\\"))\\\\n  1714\\\\t                  as-name (first (rules ctx clause \\\\\\\"name\\\\\\\"))\\\\n  1715\\\\t                  handler (if as-name\\\\n  1716\\\\t                            ;; `except E as e:` binds e for the handler and\\\\n  1717\\\\t                            ;; unbinds it on every exit, as `del e` in a\\\\n  1718\\\\t                            ;; finally would\\\\n  1719\\\\t                            (let [nm (name-of ctx as-name)]\\\\n  1720\\\\t                              (app* 'py/try-finally\\\\n  1721\\\\t                                    (u/lam [] (u/seq-nodes\\\\n  1722\\\\t                                                (cons (assign-name ctx nm (u/v exc))\\\\n  1723\\\\t                                                      (lower-block hctx block))))\\\\n  1724\\\\t                                    (u/lam [(gen \\\\\\\"ux\\\\\\\" clause)] (unbind-name ctx nm))))\\\\n  1725\\\\t                            (u/seq-nodes (lower-block hctx block)))]\\\\n  1726\\\\t              (when (and (nil? cls-node) (> (count ck) 1))\\\\n  1727\\\\t                (unsupported! clause \\\\\\\"except clause\\\\\\\"))\\\\n  1728\\\\t              (if cls-node\\\\n  1729\\\\t                (u/if-node (app* 'py/exc-matches (u/v exc)\\\\n  1730\\\\t                                 ((:lower ctx) ctx cls-node))\\\\n  1731\\\\t                           handler\\\\n  1732\\\\t                           fallthrough)\\\\n  1733\\\\t                handler)))\\\\n  1734\\\\t          (app* 'py/raise (u/v exc))\\\\n  1735\\\\t          (reverse (map vector clauses handler-blocks)))]\\\\n  1736\\\\t    (app* 'py/try\\\\n  1737\\\\t          (u/lam [] body)\\\\n  1738\\\\t          (u/lam [exc] dispatch)\\\\n  1739\\\\t          (u/lam [] (if else-block\\\\n  1740\\\\t                      (u/seq-nodes (lower-block ctx else-block))\\\\n  1741\\\\t                      none)))))\\\\n  1742\\\\t\\\\n  1743\\\\t\\\\n  1744\\\\t(defn- lower-flow\\\\n  1745\\\\t  [ctx n]\\\\n  1746\\\\t  (case (:rule n)\\\\n  1747\\\\t    \\\\\\\"break_stmt\\\\\\\" (if-let [brk (get-in ctx [:loop :brk])]\\\\n  1748\\\\t                   (u/app (u/v brk) none)\\\\n  1749\\\\t                   (syntax! n \\\\\\\"'break' outside loop\\\\\\\"))\\\\n  1750\\\\t    \\\\\\\"continue_stmt\\\\\\\" (if (:loop ctx)\\\\n  1751\\\\t                      (u/app (u/v (get-in ctx [:loop :cont])) none)\\\\n  1752\\\\t                      (syntax! n \\\\\\\"'continue' not properly in loop\\\\\\\"))\\\\n  1753\\\\t    \\\\\\\"return_stmt\\\\\\\" (if-let [ret (:ret ctx)]\\\\n  1754\\\\t                    (u/app (u/v ret)\\\\n  1755\\\\t                           (if-let [value (first (rules ctx n \\\\\\\"testlist\\\\\\\"))]\\\\n  1756\\\\t                             (display ctx value)\\\\n  1757\\\\t                             none))\\\\n  1758\\\\t                    (syntax! n \\\\\\\"'return' outside function\\\\\\\"))\\\\n  1759\\\\t    \\\\\\\"raise_stmt\\\\\\\"\\\\n  1760\\\\t    (let [tests (rules ctx n \\\\\\\"test\\\\\\\")]\\\\n  1761\\\\t      (cond\\\\n  1762\\\\t        (p/has-token? (:pk ctx) n \\\\\\\"from\\\\\\\") (unsupported! n \\\\\\\"raise from\\\\\\\")\\\\n  1763\\\\t        (empty? tests) (if-let [exc (:exc ctx)]\\\\n  1764\\\\t                         (app* 'py/raise (u/v exc))\\\\n  1765\\\\t                         (unsupported! n \\\\\\\"bare raise outside except\\\\\\\"))\\\\n  1766\\\\t        :else (app* 'py/raise (app* 'py/as-exception\\\\n  1767\\\\t                                    ((:lower ctx) ctx (first tests))))))))\\\\n  1768\\\\t\\\\n  1769\\\\t\\\\n  1770\\\\t(def ^:private comprehension-names\\\\n  1771\\\\t  {:list \\\\\\\"list comprehension\\\\\\\", :set \\\\\\\"set comprehension\\\\\\\", :dict \\\\\\\"dict comprehension\\\\\\\",\\\\n  1772\\\\t   :genexp \\\\\\\"generator expression\\\\\\\"})\\\\n     1\\\\t(ns yang.clojure.prelude\\\\n     2\\\\t  \\\\\\\"The `clj` runtime module (docs/design/yang.antlr.md section 8.10):\\\\n     3\\\\t   the published linker module every linked clojure program requires, as\\\\n     4\\\\t   `js`, `php` and `py` are for their frontends. It is written in prelude\\\\n     5\\\\t   notation and emitted with the same core machinery those preludes use;\\\\n     6\\\\t   it never runs on the host.\\\\n     7\\\\t\\\\n     8\\\\t   Three surfaces, mirroring the other runtimes:\\\\n     9\\\\t\\\\n    10\\\\t   - the entry, `clj/run-main`: initialize the runtime state, run the\\\\n    11\\\\t     unit — the thunk `yang.clojure/lower-unit` lowered — and answer the\\\\n    12\\\\t     program's value with the outcome model's `[:yin.k/ok value]`\\\\n    13\\\\t     wrapper removed, since that wrapper is frontend-internal. The\\\\n    14\\\\t     entry does not reset the global namespace: the namespace lives for\\\\n    15\\\\t     the task, so a projection the composition bound between two\\\\n    16\\\\t     entries and a definition an earlier unit published both survive\\\\n    17\\\\t     into the next unit's run (as `js/run-main` leaves `globalThis`\\\\n    18\\\\t     standing);\\\\n    19\\\\t   - the runtime global namespace, `clj/define-global!` and\\\\n    20\\\\t     `clj/global-get`: a task-local map in a cell (`clj.rt/globals`,\\\\n    21\\\\t     allocated once per task by `clj/init!`), keyed by export name. A\\\\n    22\\\\t     program's top-level definitions land here through its unit's own\\\\n    23\\\\t     publishing, and the conformance helper's export projection reads\\\\n    24\\\\t     and writes it — the one binding a linked unit reads a projected or\\\\n    25\\\\t     defined name through. A definition a unit runs publishes after\\\\n    26\\\\t     any projection of the same name and shadows it. The JS\\\\n    27\\\\t     `globalThis` table, the PHP named-function table and the Python\\\\n    28\\\\t     module dictionary are the same seam;\\\\n    29\\\\t   - admission, `admit`: the registry surface a linked clojure composition\\\\n    30\\\\t     needs beside the others — the `kind` module and the `portable`\\\\n    31\\\\t     adapters of the data exports the guest library's collection\\\\n    32\\\\t     predicates read.\\\\n    33\\\\t\\\\n    34\\\\t   The module pins the shared calling runtime (`yang.call`) at the\\\\n    35\\\\t   convention's call-address, as the other runtimes do, and refuses before\\\\n    36\\\\t   anything is published when a free name nothing supplies is read.\\\\\\\"\\\\n    37\\\\t  (:require [yang.core.prelude :as core]\\\\n    38\\\\t            [yang.clojure :as yang]\\\\n    39\\\\t            [yin.vm :as vm]\\\\n    40\\\\t            [yin.vm.data :as data]\\\\n    41\\\\t            [yin.vm.module :as module]))\\\\n    42\\\\t\\\\n    43\\\\t\\\\n    44\\\\t(def module-name\\\\n    45\\\\t  \\\\\\\"The linker module name of the clojure runtime.\\\\\\\"\\\\n    46\\\\t  'clj)\\\\n    47\\\\t\\\\n    48\\\\t\\\\n    49\\\\t(def runtime-keys\\\\n    50\\\\t  \\\\\\\"Every runtime key, each with an `:clj/uninit` placeholder at module\\\\n    51\\\\t   level so every read is discharged before `clj/init!` allocates the\\\\n    52\\\\t   real cell. They stay qualified: internal store keys, never guest\\\\n    53\\\\t   names.\\\\\\\"\\\\n    54\\\\t  '[clj.rt/state clj.rt/globals])\\\\n    55\\\\t\\\\n    56\\\\t\\\\n    57\\\\t(def definitions\\\\n    58\\\\t  \\\\\\\"The module's definition list, in prelude notation (the module's own\\\\n    59\\\\t   `clj/` prefix is stripped on emit).\\\\\\\"\\\\n    60\\\\t  '[;; ------------------------------------------------- state and namespace\\\\n    61\\\\t    [clj/init!\\\\n    62\\\\t     (fn []\\\\n    63\\\\t       (if (= clj.rt/state :clj/uninit)\\\\n    64\\\\t         (do (yin/def (quote clj.rt/globals) (cell/new {}))\\\\n    65\\\\t             (yin/def (quote clj.rt/state) :clj/ready))\\\\n    66\\\\t         :clj/ready))]\\\\n    67\\\\t    ;; the runtime global namespace: one task-local map in a cell, keyed by\\\\n    68\\\\t    ;; export name. `clj/define-global!` answers the value, so a publish\\\\n    69\\\\t    ;; sequence can chain through it.\\\\n    70\\\\t    [clj/define-global!\\\\n    71\\\\t     (fn [name value]\\\\n    72\\\\t       (do (cell/set! clj.rt/globals\\\\n    73\\\\t                      (assoc (cell/get clj.rt/globals) name value))\\\\n    74\\\\t           value))]\\\\n    75\\\\t    [clj/global-get\\\\n    76\\\\t     (fn [name]\\\\n    77\\\\t       (if (data/contains? (cell/get clj.rt/globals) name)\\\\n    78\\\\t         (get (cell/get clj.rt/globals) name)\\\\n    79\\\\t         :clj/unbound))]\\\\n    80\\\\t\\\\n    81\\\\t    ;; ------------------------------------------------------------- entry\\\\n    82\\\\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\\\\n    83\\\\t    ;; internal, so the entry removes one wrapper level from the\\\\n    84\\\\t    ;; program's value (a program returning that vector as data was\\\\n    85\\\\t    ;; wrapped again, so one level is exact). An error outcome passes\\\\n    86\\\\t    ;; through as the failure value for the caller to render.\\\\n    87\\\\t    [clj/unwrap-outcome\\\\n    88\\\\t     (fn [value]\\\\n    89\\\\t       (if (if (data/vector? value) (= (data/count value) 2) false)\\\\n    90\\\\t         (if (= (data/nth value 0) :yin.k/ok)\\\\n    91\\\\t           (data/nth value 1)\\\\n    92\\\\t           value)\\\\n    93\\\\t         value))]\\\\n    94\\\\t    ;; The global namespace is the task's, not the entry's: no reset\\\\n    95\\\\t    ;; here, so projections and earlier units' definitions survive.\\\\n    96\\\\t    [clj/run-main\\\\n    97\\\\t     (fn [body]\\\\n    98\\\\t       (do (clj/init!)\\\\n    99\\\\t           (clj/unwrap-outcome (body))))]])\\\\n   100\\\\t\\\\n   101\\\\t\\\\n   102\\\\t(def module-definitions\\\\n   103\\\\t  \\\\\\\"The module's definition list: an `:clj/uninit` placeholder for every\\\\n   104\\\\t   runtime key, then every definition, stripped.\\\\\\\"\\\\n   105\\\\t  (core/module-definitions \\\\\\\"clj\\\\\\\" :clj/uninit runtime-keys definitions))\\\\n   106\\\\t\\\\n   107\\\\t\\\\n   108\\\\t(def module-uast\\\\n   109\\\\t  \\\\\\\"The module tree: one wide application over the definitions, so every\\\\n   110\\\\t   sibling and runtime key read is discharged at module level.\\\\\\\"\\\\n   111\\\\t  (core/module