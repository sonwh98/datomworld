on))\n  1228\t            [error-tag data]\n  1229\t            (throw e)))))))\n  1230\t\n  1231\t\n  1232\t(defn- av-let\n  1233\t  \"(let [p0 (data/nth av 0) ...] body): positional parameters of one arity.\n  1234\t   A body that recurs is a loop over the same bindings: one recur target per\n  1235\t   arity. Under the outcome model the body is lowered first.\"\n  1236\t  [env macro-env params body-forms]\n  1237\t  (let [bindings (into [] (mapcat (fn [i p] [p (list 'data/nth av-sym i)]) (range) params))\n  1238\t        lowered? (outcomes? env)\n  1239\t        body (if lowered?\n  1240\t               (lower-function-body env macro-env params body-forms)\n  1241\t               (body-expression body-forms))]\n  1242\t    (if (some mentions-recur? body-forms)\n  1243\t      (with-meta (if lowered?\n  1244\t                   (list 'loop bindings body)\n  1245\t                   (list* 'loop bindings body-forms))\n  1246\t        {::fn-loop true})\n  1247\t      (list 'let bindings body))))\n  1248\t\n  1249\t\n  1250\t(defn- av-dispatch\n  1251\t  \"Nested ifs over the argument vector's count, one branch per arity\n  1252\t   {:n count :form branch}. An unmatched count falls through to a\n  1253\t   zero-argument data/count, which the data module refuses with :reason\n  1254\t   :arity; under the outcome model it is an arity error outcome naming\n  1255\t   `fn-name` (or the anonymous fn's `source`) instead.\"\n  1256\t  [env fn-name source arities]\n  1257\t  (let [counts (map :n arities)]\n  1258\t    (when (not= (count counts) (count (set counts)))\n  1259\t      (reject! \"Two arities with the same parameter count\" {:counts (vec counts)}))\n  1260\t    (reduce (fn [else {:keys [n form]}]\n  1261\t              (list 'if\n  1262\t                    (list 'data/content= (list 'data/count av-sym) n)\n  1263\t                    form\n  1264\t                    else))\n  1265\t            (if (outcomes? env) (arity-error-form fn-name source) (list 'data/count))\n  1266\t            (reverse arities))))\n  1267\t\n  1268\t\n  1269\t(defn- check-av-params!\n  1270\t  [params]\n  1271\t  (when-not (vector? params)\n  1272\t    (reject! \"fn parameters must be a vector\" {:params params}))\n  1273\t  (doseq [p params]\n  1274\t    (when (= '& p)\n  1275\t      (reject! \"Variadic fn parameters are not supported\" {:params params}))\n  1276\t    (check-binder! p params)))\n  1277\t\n  1278\t\n  1279\t(defn- outcome-node\n  1280\t  [tag value]\n  1281\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n  1282\t\n  1283\t\n  1284\t(defn- call-entry\n  1285\t  \"The unary public entry, closed over a private argument-vector body.\"\n  1286\t  []\n  1287\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1288\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1289\t        outcome (symbol (str reserved-prefix \"entry_outcome\"))\n  1290\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1291\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1292\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1293\t        binding-error (outcome-node\n  1294\t                        error-tag\n  1295\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1296\t                               (u/lit :yin.k/message)\n  1297\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1298\t                               (u/lit :yin.k/data)\n  1299\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1300\t                                      (u/lit :yang.call/named) named)))\n  1301\t        entry-body (u/let1\n  1302\t                     outcome\n  1303\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\n  1304\t                                (u/app (u/v body) positional)\n  1305\t                                binding-error)\n  1306\t                     (u/if-node (u/app (u/v 'dsg__equal)\n  1307\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\n  1308\t                                       (u/lit ok-tag))\n  1309\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1310\t                                (let [err-val (symbol (str reserved-prefix \"entry_err\"))]\n  1311\t                                  (u/let1 err-val (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n  1312\t                                          (u/if-node\n  1313\t                                            (u/if-node (u/app (u/v 'data/map?) (u/v err-val))\n  1314\t                                                       (u/app (u/v 'dsg__equal)\n  1315\t                                                              (u/app (u/v 'dsg__get) (u/v err-val) (u/lit :dsg__condition))\n  1316\t                                                              (u/v 'dsg__call_token))\n  1317\t                                                       (u/lit false))\n  1318\t                                            (u/app raise (u/app (u/v 'data/dissoc) (u/v err-val) (u/lit :dsg__condition)))\n  1319\t                                            (u/app raise\n  1320\t                                                   (u/app (u/v 'yang.call/thrown) (u/v err-val))))))))\n  1321\t        ;; The private lane forwards the body's outcome in tail position.\n  1322\t        ;; The public entry still converts outcomes to value/raise normally.\n  1323\t        ;; The compiler's token packet - a two-element vector whose first\n  1324\t        ;; element is the compiler-held token - selects the private tail\n  1325\t        ;; lane on the SAME unary entry: no record unwrap, no map lookups.\n  1326\t        ;; A guest cannot forge it: the token is compiler-held and the\n  1327\t        ;; reserved-prefix regime refuses binding or shadowing it. Maps\n  1328\t        ;; keep the ordinary record path. The vector guard is required:\n  1329\t        ;; data/nth refuses non-vectors, and dsg__get reads vectors as\n  1330\t        ;; nil whenever the program defines its own get.\n  1331\t        packet (u/if-node\n  1332\t                 (u/app (u/v 'data/vector?) (u/v invocation))\n  1333\t                 ;; the packet is exactly two elements: the arity guard runs\n  1334\t                 ;; before data/nth so an empty or overlong vector refuses\n  1335\t                 ;; as an outcome instead of a host-side data refusal\n  1336\t                 (u/if-node\n  1337\t                   (u/app (u/v 'dsg__equal)\n  1338\t                          (u/app (u/v 'data/count) (u/v invocation))\n  1339\t                          (u/lit 2))\n  1340\t                   (u/if-node\n  1341\t                     (u/app (u/v 'dsg__equal)\n  1342\t                            (u/app (u/v 'data/nth) (u/v invocation) (u/lit 0))\n  1343\t                            (u/v 'dsg__call_token))\n  1344\t                     (u/app (u/v body) (u/app (u/v 'data/nth) (u/v invocation) (u/lit 1)))\n  1345\t                     ;; a vector without the compiler-held token is NOT the\n  1346\t                     ;; record path: applying the body here would hand every\n  1347\t                     ;; forged vector the private lane. Refuse explicitly.\n  1348\t                     (u/lit [:yin.k/error\n  1349\t                             {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1350\t                              :yin.k/data {}}]))\n  1351\t                   (u/lit [:yin.k/error\n  1352\t                           {:yin.k/message \"Invocation is neither an authenticated packet nor an invocation record\"\n  1353\t                            :yin.k/data {}}]))\n  1354\t                 (u/if-node\n  1355\t                   (u/app (u/v 'dsg__equal)\n  1356\t                          (u/app (u/v 'dsg__get) (u/v invocation)\n  1357\t                                 (u/lit :clj/outcome-token))\n  1358\t                          (u/v 'dsg__call_token))\n  1359\t                   (u/if-node (u/app (u/v 'dsg__empty) named)\n  1360\t                              (u/app (u/v body) positional)\n  1361\t                              binding-error)\n  1362\t                   entry-body))\n  1363\t        entry (u/lam [invocation] packet)]\n  1364\t    (u/lam [body] entry)))\n  1365\t\n  1366\t\n  1367\t(defn- admit-call-descriptor\n  1368\t  \"Admit a descriptor constructed by trusted UAST/profile code. This is not\n  1369\t   a source form: entry-spelled source maps never pass through this constructor.\"\n  1370\t  [descriptor-ast tail?]\n  1371\t  (let [descriptor-name 'dsg__descriptor\n  1372\t        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\n  1373\t                         (u/lit :clj/admission) (u/lit nil))\n  1374\t        ;; The factory closure captures the canonical descriptor and private\n  1375\t        ;; token. Projection reconstructs and compares that opaque closure;\n  1376\t        ;; it never applies a source-supplied predicate. An equal immutable\n  1377\t        ;; reconstruction is the same value, not admission of different data.\n  1378\t        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\n  1379\t        published (u/let1 descriptor-name canonical\n  1380\t                          (u/app (u/v 'dsg__assoc) (u/v descriptor-name)\n  1381\t                                 (u/lit :clj/admission) witness))]\n  1382\t    (cond-> (u/mark-tails published)\n  1383\t      tail? (assoc :tail? true))))\n  1384\t\n  1385\t\n  1386\t(defn- compile-call-descriptor\n  1387\t  \"Publish a private body through a canonical constructor-created entry.\"\n  1388\t  [body-ast tail?]\n  1389\t  (admit-call-descriptor\n  1390\t    (u/app (u/v 'dsg__assoc) (u/lit {})\n  1391\t           (u/lit :yang.call/entry) (u/app (u/v 'dsg__make_entry) body-ast)\n  1392\t           (u/lit :clj/type) (u/lit :function)\n  1393\t           (u/lit :clj/outcomes?) (u/lit true))\n  1394\t    tail?))\n  1395\t\n  1396\t\n  1397\t(defn- compile-av-fn\n  1398\t  \"Compile arities [{:params :body}] to one closure over an argument vector.\n  1399\t   `fn-name` names the function in an arity error outcome. Under the outcome\n  1400\t   model the published value is an immutable common-call descriptor.\"\n  1401\t  ([arities env tail? macro-env] (compile-av-fn arities env tail? macro-env nil nil))\n  1402\t  ([arities env tail? macro-env fn-name] (compile-av-fn arities env tail? macro-env fn-name nil))\n  1403\t  ([arities env tail? macro-env fn-name source]\n  1404\t   (let [arities (mapv (fn [{:keys [params body]}]\n  1405\t                         (check-av-params! params)\n  1406\t                         {:n (count params)\n  1407\t                          :form (av-let env macro-env params body)})\n  1408\t                       arities)\n  1409\t         body (compile-lambda [av-sym] (av-dispatch env fn-name source arities)\n  1410\t                              env false macro-env)]\n  1411\t     (if (outcomes? env)\n  1412\t       (compile-call-descriptor body tail?)\n  1413\t       (cond-> body tail? (assoc :tail? true))))))\n  1414\t\n  1415\t\n  1416\t(defn- fn-arities\n  1417\t  \"Arities of (fn [params] body*) or (fn ([params] body*)+) operands.\"\n  1418\t  [operands]\n  1419\t  (cond\n  1420\t    (vector? (first operands))\n  1421\t    [{:params (first operands), :body (rest operands)}]\n  1422\t\n  1423\t    (and (seq operands) (every? #(and (seq? %) (vector? (first %))) operands))\n  1424\t    (mapv (fn [a] {:params (first a), :body (rest a)}) operands)\n  1425\t\n  1426\t    :else (reject! \"fn parameters must be a vector\" {:params (first operands)})))\n  1427\t\n  1428\t\n  1429\t(defn- adapter-counts\n  1430\t  \"The argument counts an adapter for native `sym` admits: the fixed arities\n  1431\t   of its `:yin.k/arities` profile, extended to `adapter-variadic-cap` when\n  1432\t   the profile is `:variadic`. A name with no declared profile admits\n  1433\t   0 to `default-adapter-arity`.\"\n  1434\t  [env sym]\n  1435\t  (if-let [declared (get-in env [::convention :arities sym])]\n  1436\t    (let [fixed (filter number? declared)\n  1437\t          from (if (seq fixed) (apply max fixed) 0)]\n  1438\t      (vec (sort (distinct (concat fixed\n  1439\t                                   (when (some #{:variadic} declared)\n  1440\t                                     (range from (inc (max from adapter-variadic-cap)))))))))\n  1441\t    (vec (range (inc default-adapter-arity)))))\n  1442\t\n  1443\t\n  1444\t(defn- compile-adapter\n  1445\t  \"A fresh closure over the convention that calls native `sym` with the\n  1446\t   unpacked arguments, for each admitted count.\"\n  1447\t  [sym env tail? macro-env]\n  1448\t  (let [arities (mapv (fn [n]\n  1449\t                        (let [call (cons sym (map #(list 'data/nth av-sym %) (range n)))]\n  1450\t                          {:n n\n  1451\t                           :form (if (outcomes? env)\n  1452\t                                   (lower-function-body env macro-env [] [call])\n  1453\t                                   call)}))\n  1454\t                      (adapter-counts env sym))]\n  1455\t    (compile-lambda [av-sym] (av-dispatch env sym nil arities) env tail? macro-env)))\n  1456\t\n  1457\t\n  1458\t(defn- apply-call?\n  1459\t  \"True when `operator` is the `apply` intrinsic: not bound locally and not\n  1460\t   defined by the program.\"\n  1461\t  [env operator]\n  1462\t  (and (= 'apply operator)\n  1463\t       (not (contains? (locals env) operator))\n  1464\t       (not (contains? (::defined env) operator))))\n  1465\t\n  1466\t\n  1467\t(defn- intra-unit-fn?\n  1468\t  \"True when `operator` statically names a top-level `defn`/`defn-` of this\n  1469\t   unit under the outcome model: unshadowed by locals and never defined by\n  1470\t   `def` or `defmacro`.\"\n  1471\t  [env operator]\n  1472\t  (and (outcomes? env)\n  1473\t       (symbol? operator)\n  1474\t       (not (contains? (locals env) operator))\n  1475\t       (contains? (::defined-fns env) operator)))\n  1476\t\n  1477\t\n  1478\t(defn- cell-ref-shaped-node\n  1479\t  \"The UAST pre-filter for WHEN to ask the heap about a callee: the\n  1480\t   callee could be a cell reference the VM issued — `:type :cell-ref`\n  1481\t   with the `:id` and `:seal` every issued reference carries, no other\n  1482\t   entries, a seal of the issued form (a 64-character string). The\n  1483\t   shape never decides meaning (ruling of record, rule 2): a map\n  1484\t   passing it is only worth asking about, and the `cell/authentic?`\n  1485\t   query emitted beside it answers. Any `:id` spelling may name a\n  1486\t   cell, so the r4 heap-id-language discriminator is retired — the\n  1487\t   minted `:cell-N` restriction was itself a value-shape guess the\n  1488\t   issuer never certified. A map that fails this pre-filter is never\n  1489\t   asked and never dereferenced: it routes to ordinary map\n  1490\t   invocation, which grants no cell capability.\"\n  1491\t  [callee]\n  1492\t  (let [seal (u/app (u/v 'dsg__get) callee (u/lit :seal))]\n  1493\t    (u/if-node (u/app (u/v 'dsg__equal)\n  1494\t                      (u/app (u/v 'dsg__get) callee (u/lit :type))\n  1495\t                      (u/lit :cell-ref))\n  1496\t               (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :id))\n  1497\t                          (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :seal))\n  1498\t                                     (u/if-node (u/app (u/v 'dsg__equal)\n  1499\t                                                       (u/app (u/v 'data/count) callee)\n  1500\t                                                       (u/lit 3))\n  1501\t                                                (u/if-node (u/app (u/v 'data/string?) seal)\n  1502\t                                                           (u/if-node (u/app (u/v 'dsg__equal)\n  1503\t                                                                             (u/app (u/v 'data/str-length) seal)\n  1504\t                                                                             (u/lit 64))\n  1505\t                                                                      (u/lit true)\n  1506\t                                                                      (u/lit false))\n  1507\t                                                           (u/lit false))\n  1508\t                                                (u/lit false))\n  1509\t                                     (u/lit false))\n  1510\t                          (u/lit false))\n  1511\t               (u/lit false))))\n  1512\t\n  1513\t\n  1514\t(defn- compile-guest-call\n  1515\t  \"Admit a source operator before common invocation. Only generated UAST\n  1516\t   implementation calls apply private closures directly.\"\n  1517\t  [callee-ast arguments-ast env tail?]\n  1518\t  (if-not (outcomes? env)\n  1519\t    (cond-> (u/app callee-ast arguments-ast)\n  1520\t      tail? (assoc :tail? true))\n  1521\t    (let [callee (symbol (str reserved-prefix \"callee\"))\n  1522\t          arguments (symbol (str reserved-prefix \"arguments\"))\n  1523\t          escape (symbol (str reserved-prefix \"raise_escape\"))\n  1524\t          condition (symbol (str reserved-prefix \"condition\"))\n  1525\t          result (symbol (str reserved-prefix \"call_result\"))\n  1526\t          reason (symbol (str reserved-prefix \"reason\"))\n  1527\t          ;; R3 (ruling v2 §R3, §R5; design §8.10.7).\n  1528\t          ;; An error outcome carries a condition with a qualified reason\n  1529\t          ;; unchanged (reason, value, and evidence intact), stamped with\n  1530\t          ;; the compiler's authentic condition marker. Values arriving\n  1531\t          ;; without a qualified reason are guest throw payloads wrapped in\n  1532\t          ;; a fresh yang.call/thrown condition.\n  1533\t          condition->outcome (u/let1 reason (u/app (u/v 'dsg__get) (u/v condition) (u/lit :yang.call/reason))\n  1534\t                                     (u/if-node\n  1535\t                                       (u/if-node\n  1536\t                                         (u/app (u/v 'dsg__equal) (u/v reason) (u/lit :yang.call/thrown))\n  1537\t                                         (u/lit true)\n  1538\t                                         (u/if-node\n  1539\t                                           (u/app (u/v 'dsg__equal) (u/v reason) (u/lit :yang.call/not-callable))\n  1540\t                                           (u/lit true)\n  1541\t                                           (u/if-node\n  1542\t                                             (u/app (u/v 'dsg__equal) (u/v reason) (u/lit :yang.call/invalid-invocation))\n  1543\t                                             (u/lit true)\n  1544\t                                             (u/app (u/v 'dsg__equal) (u/v reason) (u/lit :yang.call/unsupported-binding)))))\n  1545\t                                       (outcome-node error-tag\n  1546\t                                                     (u/app (u/v 'dsg__assoc) (u/v condition)\n  1547\t                                                            (u/lit :dsg__condition) (u/v 'dsg__call_token)))\n  1548\t                                       (outcome-node error-tag\n  1549\t                                                     (u/app (u/v 'dsg__assoc)\n  1550\t                                                            (u/app (u/v 'yang.call/thrown) (u/v condition))\n  1551\t                                                            (u/lit :dsg__condition) (u/v 'dsg__call_token)))))\n  1552\t          raise (u/lam [condition]\n  1553\t                       (assoc (u/app (u/v escape)\n  1554\t                                     (u/app (u/v 