)))\n  2445\t                        (u/v top-res)))\n  2446\t              (u/v top-res)))))\n  2447\t\n  2448\t\n  2449\t(defn compile-program\n  2450\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n  2451\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n  2452\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n  2453\t   with :macro? true on the lambda; the encoder turns that flag into a\n  2454\t   declaration row and the expander, not this compiler, recognizes calls.\n  2455\t   The three-argument form takes `opts` opting into the argument-vector\n  2456\t   convention (see `program-env`); without it the output is the native one.\"\n  2457\t  ([forms] (compile-program forms true))\n  2458\t  ([forms tail?] (compile-program forms tail? nil))\n  2459\t  ([forms tail? opts]\n  2460\t   (run! check-program-symbols! forms)\n  2461\t   (let [env (program-env forms opts)]\n  2462\t     ;; A discarded definition must not become a lexical binding in the\n  2463\t     ;; following definitions. Descriptor entry and body closures both capture\n  2464\t     ;; their environment: retaining the previous descriptor here doubles its\n  2465\t     ;; paths at each definition during machine-data validation and UCF lift.\n  2466\t     (letfn [(discard-result\n  2467\t               [ast]\n  2468\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n  2469\t             (go\n  2470\t               [forms macro-env]\n  2471\t               (if (empty? forms)\n  2472\t                 (compile-literal nil tail?)\n  2473\t                 (let [head       (cond->> (first forms)\n  2474\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\n  2475\t                                    (outcomes? env) (lower-top-form env macro-env))\n  2476\t                       rest-forms (rest forms)]\n  2477\t                   (cond\n  2478\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n  2479\t                     ;; lambda the encoder declares; later forms see the name\n  2480\t                     ;; only so the native defn lowering can yield to it.\n  2481\t                     (and (seq? head) (= 'defmacro (first head)))\n  2482\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n  2483\t                       (cond-> {:type     :application\n  2484\t                                :operator {:type :lambda, :params ['_]\n  2485\t                                           :body (go rest-forms\n  2486\t                                                     (assoc macro-env\n  2487\t                                                            (strip-symbol-meta (second head))\n  2488\t                                                            {:type :user}))}\n  2489\t                                :operands [(discard-result defined)]}\n  2490\t                         tail? (assoc :tail? true)))\n  2491\t                     ;; def: sequence with current macro-env\n  2492\t                     (and (seq? head) (= 'def (first head)))\n  2493\t                     (let [[_ name value] head\n  2494\t                           value (cond-> value (outcomes? env) rewrite-ex-info)]\n  2495\t                       (when (and (outcomes? env)\n  2496\t                                  (failing? (assoc env ::macro-env macro-env) value))\n  2497\t                         (reject! \"A def value cannot call guest functions under the outcome model\"\n  2498\t                                  {:name name}))\n  2499\t                       (cond-> {:type     :application\n  2500\t                                :operator {:type :lambda, :params ['_]\n  2501\t                                           :body (go rest-forms macro-env)}\n  2502\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\n  2503\t                         tail? (assoc :tail? true)))\n  2504\t                     ;; single form\n  2505\t                     (= 1 (count forms))\n  2506\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n  2507\t                     ;; sequence\n  2508\t                     :else\n  2509\t                     (cond-> {:type     :application\n  2510\t                              :operator {:type :lambda, :params ['_]\n  2511\t                                         :body (go rest-forms macro-env)}\n  2512\t                              :operands [(discard-result\n  2513\t                                           (compile-form head false\n  2514\t                                                         (assoc env ::top-level true) macro-env))]}\n  2515\t                       tail? (assoc :tail? true))))))]\n  2516\t       (annotate-call-sites\n  2517\t         (cond->> (go forms initial-macro-env)\n  2518\t           (outcomes? env) strip-top-outcome\n  2519\t           ;; The two sibling closures share one frame: separate bindings would\n  2520\t           ;; retain one extra helper environment in every closure a guest\n  2521\t           ;; captures (the machine-data validation bound notices).\n  2522\t           (outcomes? env) (#(u/app\n  2523\t                               (u/lam '[dsg__admitted? dsg__intra_call] %)\n  2524\t                               (u/sexp->uast\n  2525\t                                 '(fn [dsg__candidate]\n  2526\t                                    (if (data/map? dsg__candidate)\n  2527\t                                      ;; A map is offered to the dereference\n  2528\t                                      ;; only when the heap authenticates it\n(ns yang.tails\n  \"Tail marks over the Universal AST, shared by every stage that builds or\n   rewrites a tree. A tail call pushes no frame on the VMs that honour the\n   mark, so a mark is only sound for the tree it was computed over: a stage\n   that wraps a body must strip every mark and recompute them over the whole\n   derived tree, or a wrapped body's old tail calls would skip the wrapper.\"\n  (:require\n    [yin.vm :as vm]))\n\n\n(defn mark-tails\n  \"Set `:tail? true` on every application in tail position of a lambda body,\n   through `if` branches. Definitions are never marked. Lowering relies on\n   this for loops, which are self-applied lambdas: the recursive call and the\n   sequencing lambda around it are both tail calls, so an iteration grows no\n   continuation on the VMs that honour the mark.\"\n  [node]\n  (letfn [(walk\n            [node tail?]\n            (case (:type node)\n              :lambda (assoc node :body (walk (:body node) true))\n              :if (assoc node\n                         :test (walk (:test node) false)\n                         :consequent (walk (:consequent node) tail?)\n                         :alternate (walk (:alternate node) tail?))\n              :application\n              (let [definition? (= 'yin/def (:name (:operator node)))\n                    node (assoc node\n                                :operator (walk (:operator node) false)\n                                :operands (mapv #(walk % false)\n                                                (:operands node)))]\n                (if (and tail? (not definition?))\n                  (assoc node :tail? true)\n                  node))\n              node))]\n    (walk node false)))\n\n\n(defn strip-tails\n  \"`node` with every `:tail?` mark removed, at every depth and under every\n   node type the row grammar knows, so `mark-tails` starts from nothing.\"\n  [node]\n  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\n    (reduce (fn [n [field kind]]\n              (case kind\n                :node (update n field strip-tails)\n                :nodes (update n field #(mapv strip-tails %))\n                n))\n            (dissoc node :tail?)\n            slots)))\n\n\n(defn remark-tails\n  \"Strip every tail mark and recompute them over the whole of `node`.\"\n  [node]\n  (mark-tails (strip-tails node)))\n","exit_code":0,"status":"completed"}}
