est]\\\\n  1892\\\\t  (let [types (mapv #(str/lower-case (class-text ctx %))\\\\n  1893\\\\t                    (core/rules ctx clause \\\\\\\"qualifiedStaticTypeRef\\\\\\\"))\\\\n  1894\\\\t        var (some #(when (and (p/token? %) (= \\\\\\\"VarName\\\\\\\" (:type %))) (:text %))\\\\n  1895\\\\t                  (core/kids ctx clause))\\\\n  1896\\\\t        test (reduce (fn [acc t]\\\\n  1897\\\\t                       (u/if-node acc (u/lit true) (app* 'php/instance-of e (u/lit t))))\\\\n  1898\\\\t                     (u/lit false)\\\\n  1899\\\\t                     types)\\\\n  1900\\\\t        body (lower ctx (first (core/rules ctx clause \\\\\\\"blockStatement\\\\\\\")))]\\\\n  1901\\\\t    (u/if-node test\\\\n  1902\\\\t               (if var\\\\n  1903\\\\t                 (u/then (write-var ctx var e) body)\\\\n  1904\\\\t                 (u/then (app* 'php/delref e) body))\\\\n  1905\\\\t               rest)))\\\\n  1906\\\\t\\\\n  1907\\\\t\\\\n  1908\\\\t(defn- lower-try\\\\n  1909\\\\t  \\\\\\\"`try { } catch (T $e) { } finally { }`: `php/try` delivers the error to the\\\\n  1910\\\\t   catch clauses in order, an unmatched one is raised again; `php/try-finally`\\\\n  1911\\\\t   runs the finally block on every exit, escapes and errors included.\\\\\\\"\\\\n  1912\\\\t  [ctx n]\\\\n  1913\\\\t  (let [block (first (core/rules ctx n \\\\\\\"blockStatement\\\\\\\"))\\\\n  1914\\\\t        clauses (core/rules ctx n \\\\\\\"catchClause\\\\\\\")\\\\n  1915\\\\t        fin (first (core/rules ctx n \\\\\\\"finallyStatement\\\\\\\"))\\\\n  1916\\\\t        e (core/gen \\\\\\\"e\\\\\\\" n)\\\\n  1917\\\\t        mark (core/gen \\\\\\\"mk\\\\\\\" n)\\\\n  1918\\\\t        body (lower ctx block)\\\\n  1919\\\\t        guarded (if (seq clauses)\\\\n  1920\\\\t                  (u/let1 mark\\\\n  1921\\\\t                          (app* 'php/tmp-mark)\\\\n  1922\\\\t                          (app* 'php/try\\\\n  1923\\\\t                                (u/lam [] bo