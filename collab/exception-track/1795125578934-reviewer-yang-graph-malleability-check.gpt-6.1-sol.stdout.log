{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '400,495p' src/cljc/yang/antlr/packet.cljc\nsed -n '1,90p' src/cljc/yang/php/antlr/prelude.cljc\nsed -n '22,55p' src/cljc/yang/python/antlr/lower.cljc\nsed -n '28,55p' src/cljc/yang/typescript/antlr/lower.cljc\nsed -n '1,29p' src/cljc/yang/php/antlr/eval_coordinator.cljc\nsed -n '1,25p' src/cljc/yang/php/antlr/siteset.cljc\"","aggregated_output":"                      [a b] (:span n)]]\n          (when (and (seq real)\n                     (not= [a b] [(apply min (map first real))\n                                  (apply max (map second real))]))\n            (note! (:id n) :rule-span-not-children))\n          (when (and (empty? real) (not= a b))\n            (note! (:id n) :empty-rule-not-zero-width)))\n        @bad))))\n\n\n(defn violations\n  \"Every way `packet` breaks the contract, as a vector of\n   {:violation kw ...} (empty when it conforms). The structure is checked\n   first; the source-dependent checks run only on a well-formed packet and\n   only when `:source` is given. `opts`: `:source` the sealed source text,\n   `:rule-names` the grammar's rule-name set.\"\n  [packet {:keys [source rule-names]}]\n  (let [structural (structure-violations packet rule-names)]\n    (if (or (seq structural) (nil? source))\n      structural\n      (source-violations packet source))))\n\n\n(defn validate!\n  \"Return the packet when it keeps the contract (`violations`); otherwise\n   throw a qualified malformed-cst error carrying the first violation and\n   all of them. Without `opts` the check is structural; with `:source` it is\n   source-aware. The error's diagnostic is `<ns>/malformed-cst` under the\n   caller's `:diagnostic-ns` (`default-diagnostic-ns` when it names none).\"\n  ([packet] (validate! packet nil))\n  ([packet opts]\n   (let [bad (violations packet opts)]\n     (when (seq bad)\n       (malformed! (get opts :diagnostic-ns default-diagnostic-ns)\n                   (str \"CST packet violates its contract: \"\n                        (name (:violation (first bad))))\n                   (assoc (select-keys (first bad) [:id :error])\n                          :violations bad)))\n     packet)))\n\n\n(defn node\n  [packet id]\n  (nth (:yang.cst/nodes packet) id))\n\n\n(defn root\n  [packet]\n  (node packet (:yang.cst/root packet)))\n\n\n(defn children\n  [packet n]\n  (mapv #(node packet %) (:children n)))\n\n\n(defn rule?\n  ([n] (= :rule (:kind n)))\n  ([n rule-name] (and (= :rule (:kind n)) (= rule-name (:rule n)))))\n\n\n(defn token?\n  ([n] (= :token (:kind n)))\n  ([n text] (and (= :token (:kind n)) (= text (:text n)))))\n\n\n(defn child-rules\n  \"The rule children of `n` named `rule-name`, in order.\"\n  [packet n rule-name]\n  (filterv #(rule? % rule-name) (children packet n)))\n\n\n(defn has-token?\n  [packet n text]\n  (boolean (some #(token? % text) (children packet n))))\n\n\n;; =============================================================================\n;; Conformance, the per-target oracle\n;; =============================================================================\n\n(defn conform\n  \"Check a packet against its `source` text; return a vector of violations\n   (empty when it conforms): the structure, then spans on UTF-8 boundaries,\n   token text equal to the source, synthetic tokens only where the policy\n   allows, ordered terminals and rule extents over real children.\"\n  ([packet source] (conform packet source nil))\n  ([packet source opts] (violations packet (assoc opts :source source))))\n(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\n yang.php.antlr.prelude\n  \"The PHP runtime profile, written as Universal AST\n   (docs/design/yang.php.md sections 3.5, 7, 9). PHP semantics for operators,\n   juggling, comparison, output and errors live here as guest code, not in\n   Clojure: the lowering only emits applications of these names.\n\n   Value encoding (P1):\n     int             host integer in [-2^63, 2^63-1] (a BigInt carrier on JS\n                     past 2^53); every operator computes the exact result\n                     through the `integer` module and demotes to float when\n                     it leaves the range\n     float           untagged Jing float64 content (`data/float64`), the\n                     shared ruling of yang.typescript.md section 2; the kind\n                     test is `php/kind`, never a second tag. The prelude\n                     holds no integral float literal (JS reads 1.0 as 1):\n                     floats are built with `data/float64` or computed, and\n                     host arithmetic only ever sees `data/float-value`\n     string          a host string whose every char is one byte (a latin-1\n                     carrier); the lowering resolves literal text to bytes\n     bool            host true / false\n     null            :php/null\n     array           {:php/type :array :index {key value} :order [key ...]\n                     :next-index n}: a persistent ordered map; keys are\n                     ints or strings (`php/array-key`); `:next-index` is\n                     absent until the first integer key is written\n     error object    {:php/type :obj :class name :ord n :props {\\\"message\\\"\n                     \\\"code\\\" \\\"previous\\\"}}\n     function        a cell {:php/type :function :name s :code (fn [args])\n                             :yang.call/entry (fn [invocation])}\n\n   Runtime state is allocated by `php/init!`, once per task, under the slot\n   `php.rt/state` (the literal `:php/uninit` until `php/init!` flips it to\n   `:php/ready` as its last write):\n     php.rt/ctx            the dynamic context {:handlers :depth :base :frame}\n     php.rt/out            a cell holding the buffer stack, a vector of\n                           buffers, each a vector of byte-string chunks;\n                           `php/echo` conjs onto the last buffer, the\n                           bottom buffer is never popped\n     php.rt/globals        a cell holding the plain array of section 10.1\n                           (`$GLOBALS`), `(php/empty-array)` initially\n     php.rt/functions      a cell holding a map of lower-cased name to\n                           function cell; builtins are pre-seeded\n     php.rt/classes        a cell holding a map of class name to class record\n                           (the Throwable hierarchy, data only)\n     php.rt/next-ord       a cell, the per-task object ordinal\n     php.rt/next-cell      a cell, the per-task counted-cell id (`:id`)\n     php.rt/request        a cell holding the explicit request record\n     php.rt/response       a cell holding ordered response records\n                           (compositions without streams)\n     php.rt/response-stream, php.rt/diag-stream\n                           cells holding the composition-supplied stream\n                           references execution emits response and\n                           diagnostic records on, :php/null without them\n     php.rt/headers-sent, php.rt/status   output state and the response status\n     php.rt/error-handler  a cell, :php/null or a callable\n     php.rt/error-handlers a cell holding previous handlers for restoration\n     php.rt/error-reporting a cell, the mask (E_ALL initially)\n     php.rt/diag           a cell, the vector of diagnostic records\n     php.rt/int-max, php.rt/int-min   exact integers computed in `init!`,\n                           never literals (literals past 2^53 are not\n                           portable)\n\n   Errors are raised with `php/raise`; with no handler frame above them they\n   reach the unit root, `php/run-main`, which answers output, response and\n   diagnostic records, any uncaught error, and an exit status when present.\n\n   Float text: `php/float-text x ndigit` is `zend_gcvt`; `ndigit` 14 is\n   `echo` (precision), 17 is `var_dump` (serialize_precision -1, the\n   shortest round trip from `integer/float-digits`).\n\n   Two emitters, one source: `definitions` is the only definition list.\n   `uast` is the bundled prelude; `module-uast` is the same list as the\n   linker module `php`. The module emitter strips only the module's own\n   namespace `php/`; `php.rt/*` stays qualified.\n\n   Host names the prelude depends on and does not define: `host-names`.\"\n  (:require\n    #?(:cljd [clojure.edn :as edn])\n    [clojure.string :as str]\n    [clojure.walk :as walk]\n    [yang.core.prelude-admission :as prelude-admission]\n    [yang.core.prelude :as core]\n    [yang.core.call :as call]\n    [yang.core.uast :as u]\n    [yang.php.antlr.builtins :as builtins]\n    [yang.php.antlr.prelude-module :as module-defs]\n    [yang.php.antlr.prelude-p9 :as p9-defs]\n    [yang.php.antlr.quoted :refer [defquoted]]\n    [yin.vm.integer :as integer]))\n     binds positional, keyword, default, `*args` and `**kwargs`.\n   - Control flow is continuations: a function with a `return` runs its body\n     under `py/call-ec`; loops are self-applied lambdas whose `break` and\n     `continue` are escapes; `try` installs a handler continuation through\n     `py/try`, and `raise` invokes the innermost one. `finally` is a\n     `py/try-finally` frame that every exit runs; `with` is `py/with`, the\n     language reference's expansion over the same two forms.\n   - Tuple, list and starred targets unpack with `py/unpack` /\n     `py/unpack-star`; comprehensions run in their own scope with the first\n     iterable evaluated outside it. List, set and dict comprehensions are\n     eager; a generator expression is an anonymous generator whose first\n     iterable is evaluated and `iter()`-checked at creation, every other\n     clause lazily, at each resume.\n   - `import m` (C4 I1) lowers at the statement to `(py/import m\n     pym.m/spec pym.m/body)` plus the binding of the module object, one\n     `(require 'pym.m)` hoisted per import in the program wrapper (linked\n     only); `sys` and `builtins` come pre-seeded with no delivery. `del\n     m.y` is a delattr call, `del x` an unbind. I2: `import a.b.c` loads\n     the chain `a`, `a.b` (`pym.a$b`), `a.b.c` in order through\n     `py/import-sub`, which sets each fresh submodule on its parent;\n     `as`, `from` (`py/import-from`), `*` (`py/import-star`) and relative\n     imports, resolved statically against the unit's declared name and\n     package-ness, a failure raising at the statement (`py/import-fail`).\n   - A function whose body yields is a generator function: its code binds\n     the arguments and allocates the cells, then returns\n     `(py/make-generator name (fn [%gen] body))`; each `yield v` is\n     `(py/yield %gen v)`, each `yield from x` `(py/yield-from %gen x)`.\n     The `:gen` binder is reset in every nested scope,\n     so a `yield` at module or class level, or in a comprehension's or\n     generator expression's own scope, is a syntax error.\n   - Operators, truthiness, equality, objects and exceptions are prelude\n     calls (`yang.python.antlr.prelude`).\n\n   Generated names come from CST node ids (`%brk17`, `%w17`, ...): unique per\n     iteration. `try` is `js/try` and `finally` `js/try-finally`.\n   - A construct outside slice T1 refuses with\n     `:yang.ts/unsupported` carrying `:construct` and `:slice`; type-only\n     rules refuse as `\\\"type syntax\\\"` (slice T8). Nothing is silently\n     dropped, and no rule reaches `:yang.ts/unhandled-rule` from a T0\n     fixture.\n\n   Generated names come from CST node ids (`%brk17`) and are renamed to\n   `%<n>` by `yang.core.names/canonicalize` before tail marking.\"\n  (:require\n    [clojure.string :as str]\n    [dao.jing.cbor :as cbor]\n    [yang.antlr.packet :as p]\n    [yang.core.lower :as core]\n    [yang.core.names :as names]\n    [yang.core.stage :as core-stage]\n    [yang.core.uast :as u]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.scope :as scope]))\n\n\n;; =============================================================================\n;; Diagnostics and the refusal tables\n;; =============================================================================\n\n(def ^:private diagnostic-ns \"yang.ts\")\n\n\n(ns yang.php.antlr.eval-coordinator\n  \"Composition-supplied eval frontend and stream service.\"\n  (:require [dao.jing :as jing]\n            [dao.stream :as stream]\n            [yang.antlr.packet :as packet]\n            [yang.php.antlr.cst :as cst]\n            [yang.php.antlr.eval-admission :as admission]\n            [yang.php.antlr.eval-publication :as publication]\n            [yang.php.antlr.eval-transport :as transport]\n            [yang.php.antlr.scope :as scope]\n            [yang.php.antlr.siteset :as siteset]))\n\n\n(defn make-worker\n  []\n  (cst/make-eval-worker))\n\n\n(defn compile-request\n  \"Prepare one request for later eval-unit emission. Identity includes the\n   complete request (including bytes and caller-supplied revisions/options),\n   the source goal, grammar and admission profile. No caller runtime state is\n   needed by this service.\"\n  [worker request]\n  (let [{:keys [source] :as admitted} (admission/admit-request request)]\n    (if-not source\n      admitted\n      (let [pk (cst/parse-source worker (:yang.compile/unit request) source)\n            identity {:request request\n(ns yang.php.antlr.siteset\n  \"Publication of PHP occurrence marks beside canonical module rows.\"\n  (:require\n    [dao.jing :as jing]\n    [yang.core.siteset-store :as store]\n    [yang.core.siteset-publication :as publication]\n    [yang.safepoint :as safepoint]\n    [yang.core.module :as core-module]\n    [yang.core.uast :as u]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm :as vm]\n    [yin.vm.linker.sign :as sign]))\n\n\n(def frontend-revision \"yang.php.antlr.lower/sites-1\")\n\n\n(def lowering-profile\n  {:yang.site/unit :module, :yang.site/prelude :linked,\n   :yang.site/kinds [:cal