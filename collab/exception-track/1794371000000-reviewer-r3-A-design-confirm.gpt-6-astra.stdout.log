)\n                 (let [{:keys [segment pc]} (:control m)\n                       a (get-in m [:code segment :analysis])]\n                   [(state-node ctx {:yin.k/state :run :segment segment :pc pc :env (:env m)\n                                     :window (select-keys (:window m) (analysis/live a pc)) :k (:k m)})]) [])\n          ready (mapv #(ready-node ctx %) (:ready-queue m))\n          parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n          store (store-node ctx (:store m))\n          result (when (= :halted kind) (lift-value ctx value))\n          installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n          module-stores (module-store-nodes ctx)\n          acc @(:acc ctx)\n          segments (:segments acc)\n          code (into {} (map (fn [a]\n                               (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n                                 [a v]\n                                 (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n                     segments)\n          pins (discharge! ctx code)\n          index (or (:source-index opts) {})\n          missing-trees (into #{} (remove #(seq (get index %))) segments)\n          _ (when (seq missing-trees)\n              (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n          requires (merge pins {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n                                :yin.k/segments segments\n                                :yin.k/trees (select-keys index segments)})\n   closure origin segment, module store, and cursor cell the encoding\n   reaches. A closure lifts through the kernel and names the module store\n   its body resolves against: its own `:store-of`, or `own` when it has\n   none -- a closure the child's own body made. A closure or\n   continuation another task minted refuses as `:foreign-value`: lift is\n   the only crossing, and only for the owner. Every literal map is\n   wrapped, a `:type :closure` map included, so a program's data can\n   never forge a marker. A stream or\n   cursor reference is authenticated before it is encoded (r11): its seal\n   and resource kind must verify under the emitter's own secret, or it\n   refuses as `:forged-resource-reference`; only then is it encoded,\n   without its seal, as a stream marker or a cell reference. A\n   continuation, a host object, and an unnamed host function refuse as\n   UCF 7.5.4 kinds; a heap `:cell-ref` refuses as `:cell` until the heap\n   slice lifts.\"\n  [vm own found]\n  (letfn [(encode\n            [x]\n            (cond\n              (scalar? x) x\n              ;; Host types before the map arm: a plain map carrying\n              ;; `:type :closure` is a literal and is wrapped as one.\n              (values/host-typed? x)\n              (cond\n                (not (values/owned-by? x (:owner vm)))\n                (non-portable! :foreign-value {:yin.k/hint (values/kind-of x)})\n                (values/closure? x)\n                (let [marker (module/lift-closure vm (values/payload x) encode)\n                      m (or (get marker store-of-key) own)]\n                  (swap! found (fn [acc]\n                                 (-> acc\n                                     (update :origins conj\n                                             (:yin.k/segment marker))\n                                     (update :stores conj m))))\n                  (assoc marker store-of-key m))\n                :else\n                (non-portable! :non-canonicalizable\n                               {:yin.k/hint :reified-continuation}))\n              (map? x)\n              (case (:type x)\n                (:stream-ref :cursor-ref)\n                (cond\n                  (not (authentic-ref? vm (:type x) x))\n                  (non-portable! :forged-resource-reference\n                                 {:yin.k/hint (:type x)})\n                  (= :stream-ref (:type x)) (stream-marker vm (:id x))\n                  :else {:yin.k/tag :yin.k/cursor-ref,\n                         :yin.k/cell (cell-for! vm found (:id x))})\n                :parked-continuation\n                (non-portable! :non-canonicalizable {:yin.k/hint (:type x)})\n                ;; slice 1 refuses every cell-bearing lift; copy-on-lift\n                ;; of the heap slice is slice 2\n                :cell-ref\n                (non-portable! :cell {:yin.k/hint (:id x)})\n                {:yin.k/tag :yin.k/literal,\n                 :yin.k/entries (into []\n                                      (mapcat (fn [[k v]]\n                                                [(encode k) (encode v)]))\n                                      x)})\n              (vector? x) (mapv encode x)\n              (set? x) (into #{} (map encode) x)\n17:`yin.vm.semantic.cursor-cell-numbering.md`.\n323:&blocked:&& \\to \\text{wait}\\ \\{\\mathrm{act}(seg,pc{+}1,E,\\mathrm{saved}(pc{+}1,rd),K),\\ \\{\\text{:deliver :rd :rd } rd\\},\\ \\text{pending: cursor cell } c\\}\\\\\n668:| blocked read | `:stream-next rd c` → `blocked` | `act`, pending cursor cell `c` | `rd` ← read value; nil on `end`; `:dao.stream/gap` on gap |\n670:| FFI call, sent | `:ffi-call rd op args` → `ok` | `act`, pending `:ffi` (call id, response cursor cell); in-VM `:reason :next` with `:call-id` | `rd` ← correlated `ok` value; `error` raises; bookkeeping removed |\n1163:   discovery-order cursor-cell numbering), 6b (`lift-task`/`lower-task`),\ndocs/design/yin.vm.ucf-transport-tuples.md:672:`:noncanonical-cursor-cells` and an unresolved one as\ndocs/design/yin.vm.ucf-transport-tuples.md:673:`:unresolved-cursor-cells` even when the task also has a frame defect.\ndocs/design/yin.vm.ucf-transport-tuples.md:677:- `:cursor-cells`: the census's pair count is charged first, before the\ndocs/design/yin.vm.ucf-transport-tuples.md:686:  `[:depth]`. After the scan every recursive read of the task (cell\ndocs/design/yin.vm.ucf-transport-tuples.md:692:  (walk, key walk, cell scans, count and rank preparation), keyed (one\ndocs/design/yin.vm.ucf-transport-tuples.md:694:  charged) or spelled, one unit per cell in a key walk's memo key, and,\ndocs/design/yin.vm.ucf-transport-tuples.md:720:from the census's cursor cells onto `1 … n`; a violation (a census cell\ndocs/design/yin.vm.ucf-transport-tuples.md:722:carrying the missing and extra cells, never a refusal and never a\ndocs/design/yin.vm.ucf-transport-tuples.md:726:a source-cursor-cell-to-number bijection, so the receiver does not compare\ndocs/design/yin.vm.ucf-transport-tuples.md:730:`:noncanonical-cursor-cells`. Every labeling that yields the selected\ndocs/design/yin.vm.ucf-transport-tuples.md:739:any attachment, never labels the state `:noncanonical-cursor-cells`, and\ndocs/design/yin.vm.ucf-transport-tuples.md:741:refusal refuses `:yin.k/undecodable` kind `:unresolved-cursor-cells`.\ndocs/design/yin.vm.ucf-transport-tuples.md:744:different states sharing a closure over the same cursor cell may number it\ndocs/design/yin.vm.ucf-transport-tuples.md:747:never affected rows below a cursor cell. On lower, each `C` becomes one fresh\ndocs/design/yin.vm.ucf-transport-tuples.md:748:private resource entry seeded at its carried position; every `[:cursor-cell C]`\ndocs/design/yin.vm.ucf-transport-tuples.md:749:maps to that entry; two references to one cursor cell share it and one\ndocs/design/yin.vm.ucf-transport-tuples.md:750:reference per cursor cell keeps its own (UCF §7.5.3).\ndocs/design/yin.vm.ucf-transport-tuples.md:756:commits to reachable content and cursor-cell contents through the census;\ndocs/design/yin.vm.ucf-transport-tuples.md:802:   unreachable row is `:yin.k/undecodable`); every `[:cursor-cell C]` names a\ndocs/design/yin.vm.ucf-transport-tuples.md:827:   `:noncanonical-cursor-cells`; kind `:unresolved-cursor-cells` if the\ndocs/design/yin.vm.ucf-transport-tuples.md:847:   agreement of §5.3 (cursor-cell stream, envelope ids, module names); every\ndocs/design/yin.vm.ucf-transport-tuples.md:861:   with cursor cells claims `:dao.stream.remote/v1`; module-store coverage is\ndocs/design/yin.vm.ucf-transport-tuples.md:900:    private resource entry per cursor cell, the parked table, children first\ndocs/design/yin.vm.ucf-transport-tuples.md:910:(`:reason-mismatch`, `:pending-try`, `:noncanonical-cursor-cells`,\ndocs/design/yin.vm.ucf-transport-tuples.md:911:`:unresolved-cursor-cells`), `:yin.k/hash-mismatch`,\ndocs/design/yin.vm.ucf-transport-tuples.md:914:`:metadata` and `:unresolved-cursor-cells`.\ndocs/design/yin.vm.ucf-transport-tuples.md:918:**Lift** (reference machine): refuse a hold (continuation §7.1 step 1; amended 2026-10-16, any-pc: no quiescence refusal, completed wakes travel as `:ready` rows); number cursor cells (§6);\ndocs/design/yin.vm.ucf-transport-tuples.md:936:(`:yin.k/values`) has no counterpart, sharing being Merkle; its cursor cell\ndocs/design/yin.vm.ucf-transport-tuples.md:947:`:yin.k/recovery-cell-ids` retains resource-key/cursor-cell associations.\ndocs/design/yin.vm.ucf-transport-tuples.md:964:  record, not minted; cursor-cell bodies and op-ids are carried verbatim; the\ndocs/design/yin.vm.ucf-transport-tuples.md:994:   canonical encoding, distinct from the semantic root id; cursor-cell ids\ndocs/design/yin.vm.ucf-transport-tuples.md:1026:   retained in the skeleton, which §6 now requires (`[:cursor-cell <class>]`,\ndocs/design/yin.vm.ucf-transport-tuples.md:1035:    a bound on decoded bytes, rows, cursor cells, traversal depth and\ndocs/design/yin.vm.ucf-transport-tuples.md:1042:    it never labels a valid state `:noncanonical-cursor-cells`, never\ndocs/design/yin.vm.ucf-transport-tuples.md:1053:defined by discovery order, and the `:unresolved-cursor-cells` refusal;\n#!/usr/bin/env python3\n\"\"\"\nPR Reviewer Utility Script for Git-based Code Reviews.\nParses git diffs, analyzes churn and file risk categories, scans for security smells\nand debugging code, and produces structured markdown or JSON review reports.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\n\n\n@dataclass\nclass Finding:\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\n    file_path: str\n    line_number: Optional[int]\n    message: str\n    snippet: str\n\n\n@dataclass\nclass FileStat:\n    path: str\n    additions: int\n    deletions: int\n    category: str\n    risk_level: str  # High, Medium, Low\n\n\n@dataclass\nclass ReviewSummary:\n    target: str\n    total_files: int\n    total_additions: int\n    total_deletions: int\n    test_additions: int\n    source_additions: int\n    test_to_source_ratio: float\n    file_stats: List[FileStat] = field(default_factory=list)\n    findings: List[Finding] = field(default_factory=list)\n    commits: List[str] = field(default_factory=list)\n\n\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\n    \"\"\"Helper to run git commands cleanly.\"\"\"\n    cmd = [\"git\"] + args\n    try:\n        res = subprocess.run(\n            cmd,\n            cwd=cwd,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=True,\n        )\n        return res.stdout.strip()\n    except subprocess.CalledProcessError as e:\n        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n        raise RuntimeError(f\"Git execution failed: {e.stderr.strip()}\")\n\n\ndef categorize_file(file_path: str) -> Tuple[str, str]:\n    \"\"\"Categorizes file type and assigns risk level.\"\"\"\n    path_lower = file_path.lower()\n\n    # Security & Auth\n    if any(k in path_lower for k in [\"auth\", \"secret\", \"crypto\", \"token\", \"permission\", \"jwt\", \"oauth\", \"password\"]):\n        return \"Security/Auth\", \"High\"\n\n    # Database & Schema\n    if any(k in path_lower for k in [\"migration\", \"schema\", \".sql\", \"entity\", \"db/\"]):\n        return \"Database/Schema\", \"High\"\n\n    # Infrastructure & Config\n    if any(k in path_lower for k in [\"docker\", \"terraform\", \".tf\", \".env\", \"k8s\", \"helm\", \"ci/cd\", \".github/workflows\"]):\n        return \"Infra/Config\", \"High\"\n    if any(file_path.endswith(ext) for ext in [\"package.json\", \"deps.edn\", \"Cargo.toml\", \"go.mod\", \"requirements.txt\", \"pom.xml\", \"build.gradle\"]):\n        return \"Dependencies\", \"Medium\"\n\n    # API / Interfaces\n    if any(k in path_lower for k in [\"proto\", \"openapi\", \"swagger\", \"graphql\", \"router\", \"controller\", \"api/\"]):\n        return \"API/Contract\", \"Medium\"\n\n    # Tests\n    if any(k in path_lower for k in [\"test\", \"spec\", \"mock\", \"fixture\", \"e2e\"]):\n        return \"Tests\", \"Low\"\n\n    # Documentation\n    if any(file_path.endswith(ext) for ext in [\".md\", \".rst\", \".txt\", \"LICENSE\"]):\n        return \"Documentation\", \"Low\"\n\n    # Core source\n    return \"Source Code\", \"Medium\"\n\n\ndef scan_diff_content(diff_text: str) -> List[Finding]:\n    \"\"\"Scans diff text for added code smells and risks.\"\"\"\n    findings: List[Finding] = []\n\n    # Patterns to match added lines\n    patterns = [\n        # Secret leaks\n        (\n            r\"(?i)^\\+.*(api[_\\-]?key|secret[_\\-]?key|bearer\\s+[a-z0-9_\\-\\.]{20,}|private[_\\-]?key)\\s*[:=]\\s*['\\\"][A-Za-z0-9%+\\/=\\-_]{8,}['\\\"]\",\n            \"P0\",\n            \"Security\",\n            \"Possible hardcoded credential or secret detected.\",\n        ),\n        (\n            r\"^\\+.*-----BEGIN (RSA|OPENSSH|EC|PRIVATE) KEY-----\",\n            \"P0\",\n            \"Security\",\n            \"Embedded private key detected.\",\n        ),\n        # Debug code left behind\n        (\n            r\"^\\+.*\\b(console\\.log|print\\(|debugger;|binding\\.pry|import pdb; pdb\\.set_trace|println!|fmt\\.Println)\\b\",\n            \"P3\",\n            \"Debug\",\n            \"Leftover debug statement detected.\",\n        ),\n        # Dangerous functions\n        (\n            r\"^\\+.*\\b(eval\\(|exec\\(|os\\.system\\(|subprocess\\.Popen\\(.*shell\\s*=\\s*True|dangerouslySetInnerHTML)\\b\",\n            \"P1\",\n            \"Security\",\n            \"Potentially unsafe dynamic execution or shell invocation.\",\n        ),\n        # Swallowed exceptions\n        (\n            r\"^\\+.*\\b(catch\\s*\\([^\\)]*\\)\\s*\\{\\s*\\}|except:\\s*pass|rescue\\s*=>\\s*nil)\\b\",\n            \"P2\",\n","exit_code":0,"status":"completed"}}
