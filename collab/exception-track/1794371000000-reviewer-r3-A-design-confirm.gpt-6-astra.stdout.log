testing \"fn takes arities too\"\n    (is (= [1 3] (run-av '[(let [g (fn\n                                     ([a] a)\n                                     ([a b] (+ a b)))] [(g 1) (g 1 2)])]))))\n  (testing \"a wrong count is refused as an arity refusal, never nil-filled\"\n545:  (testing \"header metadata is retained on the definition node\"\n1526:            NEW condition - its shape is never evidence of a retained\n1576:  (testing \"2: the complete wire condition is retained privately, so an\n1592:          (str lane \": the caught wrapper rethrows the retained condition\")))))\n1733:  (testing \"1: modifying a caught exception cannot change the retained\n1752:            (str lane \": the genuine retained condition survives modification\"))))))\n1781:                   (let [retained (retain marker-operand)]\n1215637209.basis\n1215637209.cp\n1318952242.basis\n1318952242.cp\n1318952242.jvm\n1318952242.main\n1318952242.manifest\n2410757473.basis\n2410757473.cp\n2410757473.main\n2484545867.basis\n2484545867.cp\n2770481537.basis\n2770481537.cp\n2770481537.main\n3644903311.basis\n3644903311.cp\n3644903311.jvm\n3644903311.main\n3644903311.manifest\n4183786633.basis\n4183786633.cp\n4183786633.jvm\n4183786633.main\n4183786633.manifest\n868029096.basis\n868029096.cp\n868029096.main\n/usr/bin/java\n/opt/homebrew/bin/clojure\n/usr/bin/python3\n","exit_code":0,"status":"completed"}}
