{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,100p' test/yang/clojure_test.clj && sed -n '1780,2020p' test/yang/clojure_test.clj && cat deps.edn\"","aggregated_output":"(ns yang.clojure-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.stream :as stream]\n            [dao.stream.observer :as observer]\n            [yang.clojure :as yang]\n            [yang.core.uast :as u]\n            [yang.io :as yang-io]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as ast-walker]\n            [yin.vm.data :as data]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.engine :as engine]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.values :as values]))\n\n\n;; v1 registered the stream module globally at load time; the v2 composition\n;; registers it in the registry it hands the VM.\n(def ^:private base-vm-opts\n  {:modules (module/register-stream-module (module/default-registry))})\n\n\n(defn compile-and-run\n  ([form] (compile-and-run form {} {}))\n  ([form env] (compile-and-run form env {}))\n  ([form env vm-opts]\n   (-> (tu/make-observer-session\n         (tu/create-vm (merge base-vm-opts {:env env} vm-opts)))\n       (tu/queue-ast! (yang/compile form))\n       tu/run-session\n       :consumer\n       vm/value)))\n\n\n(deftest reader-metadata-becomes-occurrence-side-tables\n  (let [form (with-meta '(+ 1 2)\n               {:file \"sample.clj\" :line 9 :column 3 :note :source-form})\n        ast (yang/compile form)\n        projected (encoder/project\n                    (encoder/source-envelope :program \"batch-1\" [ast]))\n        tree (first (:yin/batch projected))\n        origin [:source :program \"batch-1\" 0]]\n    (is (= {:file \"sample.clj\" :line 9 :column 3 :note :source-form}\n           (meta ast)))\n    (is (some #{[origin (:root tree) [] \"sample.clj\" 9 3]}\n              (:yin/source-positions projected)))\n    (is (some #{[origin (:root tree) [] :note :source-form]}\n              (:yin/frontend-metadata projected)))))\n\n\n(deftest indexing-reader-injects-nested-source-positions\n  (let [ast (first (yang-io/compile-string \"(+ x\\n   (* x 2))\"))]\n    (is (= {:file \"<string>\" :line 1 :column 1\n            :end-line 2 :end-column 12}\n           (select-keys (meta ast)\n                        [:file :line :column :end-line :end-column])))\n    (is (= {:file \"<string>\" :line 2 :column 4\n            :end-line 2 :end-column 11}\n           (select-keys (meta (second (:operands ast)))\n                        [:file :line :column :end-line :end-column])))\n    (is (= {:file \"<string>\" :line 2 :column 5\n            :end-line 2 :end-column 6}\n           (select-keys (meta (:operator (second (:operands ast))))\n                        [:file :line :column :end-line :end-column])))))\n\n\n(defn compile-program-and-run\n  ([forms] (compile-program-and-run forms {} {}))\n  ([forms env] (compile-program-and-run forms env {}))\n  ([forms env vm-opts]\n   (-> (tu/make-observer-session\n         (tu/create-vm (merge base-vm-opts {:env env} vm-opts)))\n       (tu/queue-ast! (yang/compile-program forms))\n       tu/run-session\n       :consumer\n       vm/value)))\n\n\n(deftest test-compile-literals\n  (testing \"Compiling literal values\"\n    (testing \"Numbers\"\n      (is (= {:type :literal, :value 42} (yang/compile 42)))\n      (is (= {:type :literal, :value 3.14} (yang/compile 3.14)))\n      (is (= {:type :literal, :value -10} (yang/compile -10))))\n    (testing \"Strings\"\n      (is (= {:type :literal, :value \"hello\"} (yang/compile \"hello\"))))\n    (testing \"Booleans\"\n      (is (= {:type :literal, :value true} (yang/compile true)))\n      (is (= {:type :literal, :value false} (yang/compile false))))\n    (testing \"Nil\" (is (= {:type :literal, :value nil} (yang/compile nil))))\n    (testing \"Keywords\"\n      (is (= {:type :literal, :value :foo} (yang/compile :foo))))\n    (testing \"Vectors\"\n      (is (= {:type :literal, :value [1 2 3]} (yang/compile [1 2 3]))))\n    (testing \"Maps\"\n      (is (= {:type :literal, :value {:a 1, :b 2}}\n                     (throw (cell/get saved)))\n                   (let [retained (retain marker-operand)]\n                     (later))]\n                 (cell-entry-node condition)\n                 lane))\n            (str lane \": saved rethrow preserves the ordinary field\"))))))\n\n\n(deftest test-outcome-safe-get\n  (let [forms '[(defn safe-get\n                  [coll key]\n                  (let [val (get coll key)]\n                    (if val val (throw (ex-info \"No such value in collection\" {:coll coll, :key key})))))]]\n    (is (= [:yin.k/ok 1] (run-outcome (conj forms '(safe-get {:a 1} :a)))))\n    (is (= [:yin.k/error {:yin.k/message \"No such value in collection\"\n                          :yin.k/data {:coll {:a 1}, :key :b}}]\n           (run-outcome (conj forms '(safe-get {:a 1} :b)))))))\n\n\n(deftest test-outcome-nested-call-operand\n  (let [defs '[(defn g\n                 [x]\n                 (if x x (throw (ex-info \"g failed\" {:x x}))))\n               (defn h\n                 [x]\n                 x)]\n        failed [:yin.k/error {:yin.k/message \"g failed\", :yin.k/data {:x nil}}]]\n    (testing \"an error in an operand of a nested call ends the caller\"\n      (is (= failed (run-outcome (into defs '[(defn f\n                                                [x]\n                                                (+ 1 (g x))) (f nil)]))))\n      (is (= [:yin.k/ok 6] (run-outcome (into defs '[(defn f\n                                                       [x]\n                                                       (+ 1 (g x))) (f 5)]))))\n      (is (= failed (run-outcome (into defs '[(defn f\n                                                [x]\n                                                (h (h (g x)))) (f nil)])))\n          \"through two enclosing calls\"))\n    (testing \"operands evaluate left to right and stop at the first failure\"\n      (is (= [failed [:a]]\n             [(run-outcome (into defs '[(defn f\n                                          [x]\n                                          [(probe/note :a) (g x) (probe/note :b)])\n                                        (f nil)]))\n              @effect-log])))))\n\n\n(deftest test-outcome-mid-do-stops-later-effects\n  (let [forms '[(defn boom\n                  []\n                  (throw (ex-info \"stop\" {})))\n                (defn run\n                  []\n                  (do (probe/note :before) (boom) (probe/note :after) :done))\n                (run)]]\n    (is (= [[:yin.k/error {:yin.k/message \"stop\", :yin.k/data {}}] [:before]]\n           [(run-outcome forms) @effect-log]))\n    (is (= [[:yin.k/ok :done] [:before :after]]\n           [(run-outcome (assoc forms 0 '(defn boom\n                                           []\n                                           nil))) @effect-log]))))\n\n\n(deftest test-outcome-loop-and-control\n  (testing \"loop and function-level recur return the outcome of their exit\"\n    (is (= [:yin.k/ok 55]\n           (run-outcome '[(defn sum\n                            [n acc]\n                            (if (= n 0) acc (recur (- n 1) (+ acc n)))) (sum 10 0)])))\n    (is (= [:yin.k/ok :found]\n           (run-outcome '[(defn find-it\n                            [xs]\n                            (loop [xs xs] (if (= (first xs) 3) :found (recur (rest xs)))))\n                          (find-it [1 2 3])])))\n    (is (= [:yin.k/error {:yin.k/message \"bad 3\", :yin.k/data {}}]\n           (run-outcome '[(defn chk\n                            [n]\n                            (if (= n 3) (throw (ex-info \"bad 3\" {})) n))\n                          (defn all\n                            [n]\n                            (loop [i 0] (if (< i n) (do (chk i) (recur (+ i 1))) :ok)))\n                          (all 5)]))))\n  (testing \"and / or / let / destructuring around may-fail calls\"\n    (is (= [:yin.k/ok [2 1]]\n           (run-outcome '[(defn id\n                            [x]\n                            x)\n                          (defn f\n                            [[a b]]\n                            (let [[c d] [(id b) (id a)]] [c d]))\n                          (f [1 2])])))\n    (is (= [:yin.k/ok :y]\n           (run-outcome '[(defn id\n                            [x]\n                            x) (defn f\n                                 [a]\n                                 (or (id nil) (and (id a) :y))) (f 1)])))))\n\n\n(deftest test-outcome-arity-names-the-function\n  (let [forms '[(defn f\n                  ([x] x)\n                  ([x y] y))]]\n    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/fn 'f, :yin.k/argc 3}]\n           (run-outcome (conj forms '(f 1 2 3)))))\n    (is (= [:yin.k/ok 2] (run-outcome (conj forms '(f 1 2)))))))\n\n\n(deftest test-outcome-primitive-adapter\n  (testing \"an adapted refusal is an error outcome with the refusal's op and reason\"\n    (let [out (run-outcome '[(data/nth [1 2] 5)])]\n      (is (= :yin.k/error (first out)))\n      (is (= 'nth (:yin.vm.data/op (second out))))\n      (is (= :out-of-range (:yin.vm.data/reason (second out))))))\n  (is (= [:yin.k/ok 2] (run-outcome '[(data/nth [1 2] 1)])))\n  (testing \"the adapter catches only the module's own refusal\"\n    (let [other (yang/outcome-adapter\n                  data/refusal-message\n                  (fn [] (throw (ex-info \"other\" {:yin.vm.data/op 'x, :yin.vm.data/reason :y}))))]\n      (is (thrown-with-msg? clojure.lang.ExceptionInfo #\"other\" (other))))\n    (let [npe (yang/outcome-adapter data/refusal-message\n                                    (fn [] (throw (NullPointerException.))))]\n      (is (thrown? NullPointerException (npe))))))\n\n\n(deftest test-outcome-native-path-emits-none\n  (let [forms '[(defn f\n                  [x]\n                  (throw (ex-info \"t\" {}))) (defn g\n                                              [x]\n                                              (+ x 1)) (g 1)]]\n    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true av-opts)))\n        \"the convention without :outcomes carries no outcome tags\")\n    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program '[(defn g\n                                                                        [x]\n                                                                        (+ x 1)) (g 1)]))))\n    (is (some #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true outcome-opts))))))\n\n\n(deftest test-outcome-common-call-depth\n  (let [prog (fn [defs n] (yang/compile-program (conj defs (list 'cnt n)) true outcome-opts))\n        three '[(defn c\n                  [n]\n                  (if (= n 0) :done (a (- n 1))))\n                (defn b\n                  [n]\n                  (c n))\n                (defn a\n                  [n]\n                  (b n))\n                (defn cnt\n                  [n]\n                  (a n))]\n        direct '[(defn cnt\n                   [n]\n                   (if (= n 0) :done (cnt (- n 1))))]\n        wrapped '[(defn cnt\n                    [n]\n                    (if (= n 0) 0 (+ 1 (cnt (- n 1)))))]]\n    (doseq [[label defs] [[\"self tail call\" direct] [\"three tail calls\" three]]\n            [lane run-lane] [[:walker walker-run] [:semantic semantic-run]]]\n      (let [[v0 d0] (run-lane (prog defs 0))\n            [v100 d100] (run-lane (prog defs 100))\n            [v1000 d1000] (run-lane (prog defs 1000))\n            tag (str lane \" \" label)]\n        (is (= [:yin.k/ok :done] v0 v100 v1000) tag)\n        (is (= d100 d1000)\n            (str tag \": depth is constant in the iteration count\"))\n        (is (<= d1000 (+ d0 2))\n            (str tag \": at most two frames above the initial call\"))))\n    (testing \"a non-tail unwrap also grows with the iteration count\"\n      (let [[_ d10] (semantic-run (prog wrapped 10))\n            [_ d100] (semantic-run (prog wrapped 100))]\n        (is (> d100 (+ d10 50)))))))\n\n\n(deftest test-outcome-refusals\n  (let [opts (assoc outcome-opts :macros #{'unless})\n        refused (fn [forms]\n                  (try (yang/compile-program forms true opts) nil\n                       (catch clojure.lang.ExceptionInfo e (ex-message e))))]\n    (testing \"a macro call with an operand that may fail is refused, naming the macro\"\n      (is (re-find #\"Macro call unless\"\n                   (refused '[(defn g\n                                [x]\n                                x) (defn f\n                                     [x]\n                                     (unless (g x) 1 :else 2))])))\n      (is (re-find #\"Macro call unless\"\n                   (refused '[(defn g\n                                [x]\n                                x) (defn f\n                                     [x]\n                                     (+ 1 (unless :else (g x))))]))\n          \"in operand position too\"))\n    (testing \"a macro call whose operands cannot fail is still opaque and accepted\"\n      (is (nil? (refused '[(defn f\n                             [x]\n                             (unless (= x 1) 1 :else 2))]))))\n    (testing \"cond is a compiler form: a may-fail operand is lowered, not refused\"\n      (is (nil? (refused '[(defn g\n                             [x]\n                             x) (defn f\n                                  [x]\n                                  (cond (g x) 1 :else 2))]))))\n    (testing \"a non-final top-level form that may fail is refused\"\n      (is (re-find #\"non-final top-level\"\n                   (refused '[(defn g\n                                [x]\n                                x) (g 1) (g 2)])))\n      (is (nil? (refused '[(defn g\n                             [x]\n                             x) (g 1)])) \"the final form is the harness's\")\n      (is (nil? (refused '[(defn g\n                             [x]\n                             x) (+ 1 2) (g 2)])) \"a non-failing form is fine\"))))\n\n\n(deftest test-program-pre-pass\n  (testing \"a reserved-prefix symbol is refused in any position\"\n    (doseq [forms ['[(def x dsg__y)]\n                   '[(defn f\n                       []\n                       (g dsg__av))]\n                   '[(let [a dsg__z] a)]\n                   '[(def dsg__w 1)]\n                   '[[dsg__q]]\n                   '[(fn [x] {:k dsg__v})]]]\n      (is (thrown? clojure.lang.ExceptionInfo (yang/compile-program forms)) (pr-str forms))))\n  (testing \"bare loop and recur are refused outside operator position\"\n    (doseq [forms ['[(map recur [1])]\n                   '[[loop]]\n                   '[(let [loop 1] loop)]\n                   '[(fn [recur] recur)]\n                   '[(def x loop)]]]\n      (is (thrown? clojure.lang.ExceptionInfo (yang/compile-program forms)) (pr-str forms))))\n  (testing \"quoted data is exempt and operator position stays legal\"\n    (is (= '(loop recur dsg__x) (compile-program-and-run '[(quote (loop recur dsg__x))])))\n    (is (some? (yang/compile-program '[(loop [i 0] (if (< i 2) (recur (+ i 1)) i))])))))\n\n\n{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\" \"build/antlr/php/classes\"\n         \"build/antlr/typescript/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\n                  ;; the conformance compositions) overflow smaller stacks in\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n                  ;; the 4m minimum for the prelude recursion rows still holds)\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\" \"build/antlr/php/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n                                 ;; oracle backend: Datomic Local, in-process,\n                                 ;; run in docker/oracle (dev-scope only)\n                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.repl.main\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yin.repl.python-antlr-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:clojuredart:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n