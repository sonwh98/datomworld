ey of contract C1.\\\\\\\"\\\\n388:;; Generated names carry the reserved `dsg__` prefix and derive from the\\\\n410:(def ^:private reserved-prefix \\\\\\\"dsg__\\\\\\\")\\\\n418:(defn- reserved-name?\\\\n420:  (= reserved-prefix (subs (name sym) 0 (min (count (name sym))\\\\n421:                                             (count reserved-prefix)))))\\\\n425:  \\\\\\\"A definition name is a plain symbol outside the reserved prefix.\\\\\\\"\\\\n429:  (when (reserved-name? sym)\\\\n430:    (reject! \\\\\\\"Definition name uses the reserved destructuring prefix\\\\\\\"\\\\n431:             {:name sym, :prefix reserved-prefix})))\\\\n434:(defn- check-binder!\\\\n440:    (when (reserved-name? b)\\\\n441:      (reject! \\\\\\\"Binding name uses the reserved destructuring prefix\\\\\\\"\\\\n442:               {:binder b, :prefix reserved-prefix}))\\\\n463:              (check-binder! (second xs) pattern)\\\\n469:            (check-binder! sym pattern)\\\\n478:              (check-binder! x pattern)\\\\n508:  (cond-> (symbol (str reserved-prefix path))\\\\n554:          (do (check-binder! target target)\\\\n567:          :else (check-binder! target target))))))\\\\n579:            (check-binder! p params)\\\\n672:  \\\\\\\"Every macro parameter is a plain symbol outside the reserved prefix; an\\\\n676:    (check-binder! p params)\\\\n803:(def ^:private av-sym (symbol (str reserved-prefix \\\\\\\"av\\\\\\\")))\\\\n862:;; reserved `dsg__` prefix and bind through the internal `dsg__let`, which\\\\n902:  (symbol (str reserved-prefix \\\\\\\"o\\\\\\\" (swap! (::gen env) inc))))\\\\n905:(defn- rewrite-ex-info\\\\n917:                (rewrite-ex-info (second form))))\\\\n921:      (let [[_ msg data cause] (map rewrite-ex-info form)]\\\\n924:      :else (rebuild form (map rewrite-ex-info form)))\\\\n925:    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\\\\n926:    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\\\\n927:  