cause the mark is in the heap, not the value.\n+   A pure query: no state change, never fatal.\"\n+  [state ref]\n+  (boolean (and (authentic-ref? state :cell-ref ref)\n+                (map? ref)\n+                (:retained (get (:heap state) (:id ref))))))\n+\n+\n (defn check-ref!\n   \"The resource id a program-supplied `kind` reference names, once its\n    seal verifies (r10). Anything else fails closed with\n@@ -2443,9 +2456,20 @@\n \n (defn- heap-write\n   \"`state` with heap cell `id` holding `v` under `seal`: allocation when the\n-   cell is new, a write (the seal unchanged) when it is live.\"\n+   cell is new, a write (the seal unchanged) when it is live. Any other\n+   heap-entry fact (the `:retained` mark) survives a write.\"\n+  [state id seal v]\n+  (assoc-in state [:heap id] (assoc (get-in state [:heap id] {})\n+                                    :value v, :seal seal)))\n+\n+\n+(defn- heap-write-retained\n+  \"`state` with a NEW heap cell `id` holding `v` under `seal`, marked\n+   `:retained`: the issuer-side fact that this cell is a retained carrier.\n+   The mark lives only in the heap entry, never in the value, so no guest\n+   copy of the reference or its contents carries it.\"\n   [state id seal v]\n-  (assoc-in state [:heap id] {:value v, :seal seal}))\n+  (assoc-in state [:heap id] {:value v, :seal seal, :retained true}))\n \n \n ;; =============================================================================\n@@ -2784,10 +2808,34 @@\n              :blocked? false})\n           :cell/set!\n           (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n+            ;; A retained carrier's contents are frozen for its lifetime:\n+            ;; the heap entry's issuer-side mark refuses every write, with\n+            ;; the same fail-closed convention `check-ref!` uses.\n+            (when (:retained (get-in state [:heap id]))\n+              (fail \"Cannot mutate a retained cell\"\n+                    {:reason :retained-cell, :effect :cell/set!,\n+                     :kind :cell-ref, :id id}))\n             {:state (heap-write state id (get-in state [:heap id :seal])\n                                 (:val effect)),\n              :value (:val effect),\n              :blocked? false})\n+          ;; The retained mint: like `:cell/new`, but the heap entry carries\n+          ;; the issuer-side `:retained` mark. Only a compiler-internal,\n+          ;; unpublished module binding produces this effect, so guest\n+          ;; `cell/new` can never mint a marked entry.\n+          :cell/new-retained\n+          (let [[id s'] (gensym (count-allocation state (:val effect)) \"cell\")\n+                ref (issue-ref s' :cell-ref id)]\n+            {:state (heap-write-retained s' id (:seal ref) (:val effect)),\n+             :value ref,\n+             :blocked? false})\n+          ;; The retained query: the same heap+seal predicate as\n+          ;; `:cell/authentic?`, plus the entry's `:retained` mark, answered\n+          ;; as data. A pure query: no state change, never fatal.\n+          :cell/retained?\n+          {:state state,\n+           :value (retained-ref? state (:cell effect)),\n+           :blocked? false}\n           ;; The cell-ref ruling of record: the same heap+seal predicate\n           ;; `check-ref!` consults (r10), answered as data instead of\n           ;; failing closed, so compiled call routing can ask the issuer\ndiff --git a/src/cljc/yin/vm/module.cljc b/src/cljc/yin/vm/module.cljc\nindex 0bc916ad..5307e77f 100644\n--- a/src/cljc/yin/vm/module.cljc\n+++ b/src/cljc/yin/vm/module.cljc\n@@ -410,9 +410,31 @@\n   (make-effect :cell/authentic? {:cell c}))\n \n \n+(defn new-retained-cell\n+  \"The retained mint: a new cell whose heap entry the issuer marks\n+   `:retained`. Published ONLY under the reserved-prefix name\n+   `cell/dsg__new-retained`, which guest source cannot spell (the yang\n+   compilers refuse the `dsg__` prefix in any source position), so a\n+   guest `cell/new`