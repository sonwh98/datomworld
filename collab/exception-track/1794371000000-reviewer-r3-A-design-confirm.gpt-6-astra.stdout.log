{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2334,2435p' test/yang/clojure_test.clj; sed -n '1,135p' src/cljc/yin/vm/module.cljc; sed -n '1,90p' src/cljc/yin/vm/engine.cljc; rg -n 'defn.*lift|heap' src/cljc/yin/vm/values.cljc; ls /opt/homebrew/bin/git /opt/homebrew/bin/python3\"","aggregated_output":"(def ^:private library-opts\n  {:convention :arg-vector, :outcomes true\n   :adapters yang/library-adapters\n   :native vm/primitive-profiles})\n\n\n(defn run-guest-machine\n  \"Run an AST through either observer composition with a finite instruction\n   budget. Return the terminal machine so fixtures can observe its streams.\"\n  [ast modules lane step-limit]\n  (let [run-bounded (fn [machine]\n                      (loop [v machine, n 0]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) v\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n :consumer v}))\n                          :else (recur (vm/step v) (inc n)))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-ast\n  \"The value from run-guest-machine; shared by library and oracle fixtures.\"\n  [ast modules lane step-limit]\n  (vm/value (run-guest-machine ast modules lane step-limit)))\n\n\n(defn- run-library\n  \"The raw outcome of the last of `forms`, compiled with the library\n   definitions the program needs.\"\n  ([forms] (run-library forms library-opts))\n  ([forms opts]\n   (let [walker (run-library forms opts :walker 1000000)\n         semantic (run-library forms opts :semantic 1000000)]\n     (is (= walker semantic) (str \"library lanes agree: \" (pr-str forms)))\n     walker))\n  ([forms opts lane step-limit]\n   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\n                  library-modules lane step-limit)))\n\n\n(defn- lib\n  \"The value of the single expression `form`, or the raw error outcome.\"\n  [form]\n  (let [[tag payload] (run-library [form])]\n    (if (= :yin.k/ok tag) payload [tag payload])))\n\n\n(defn- run-cell-program\n  \"The value of running the compiled `program` (quoted forms) with `node`\n   spliced into the marker operand, on one lane — every call keeps its\n   call-site routing — or the thrown refusal's ex-data.\"\n  [program node lane]\n  (let [ast (walk/postwalk\n              (fn [n] (if (= n (u/v 'marker-operand)) node n))\n              (yang/compile-program\n                (into (yang/library-for program) program)\n                true\n                library-opts))]\n    (try\n      (run-guest-ast ast library-modules lane 1000000)\n      (catch clojure.lang.ExceptionInfo e\n        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\n\n\n(defn- run-cell-probe\n  \"The value of running the compiled probe program — `(probe <node>)`, so\n   the spliced `node` sits at a call's callee position — on one lane, or\n   the thrown refusal's ex-data.\"\n  [node lane]\n  (run-cell-program\n    '[(defn probe\n        [m]\n        (m :type))\n      (probe marker-operand)]\n    node lane))\n\n\n(deftest test-common-call-cell-ref-map-invocation\n  (testing \"a full-shape data map with a 64-character seal is ordinary invocable data\"\n    ;; The map spells every key of an issued reference and the seal has the\n    ;; issued format; the call site asks the heap (cell/authentic?), the\n    ;; heap does not authenticate it, and the invocation is the map lookup,\n    ;; on both evaluators — the ruling of record replaces the r4 id-language\n    ;; gate: no id spelling is consulted, the issuer answers.\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n(ns yin.vm.module\n  \"Module system for Yin VM v2.\n\n   The v1 module system kept two `defonce` atoms and mutated them at load\n   time. A registry is a value here: an ordinary map carried in VM state and\n   supplied by the composition that wires the VM.\n\n     (-> (empty-registry)\n         (register-host-module 'my.lib {'foo (fn [x] x)} profiles)\n         (register-stream-module))\n\n   Nothing in this namespace runs at load time, and nothing registers itself.\n   A composition that wants Yin source to reach `(stream/...)` registers the\n   stream module explicitly and supplies `:make-stream` beside it.\"\n  (:require\n    [clojure.string :as str]\n    [dao.jing :as jing]\n    [dao.stream :as stream]\n    [yin.vm :as vm]\n    [yin.vm.effect :as effect]))\n\n\n;; =============================================================================\n;; Registry values\n;; =============================================================================\n\n(defn empty-registry\n  \"An empty module registry value.\"\n  []\n  {:modules {}, :effect-handlers {}})\n\n\n(defn- symbol->path\n  \"Split a dotted symbol into a get-in path of symbols.\n   'yin.io.file-input-stream → ['yin 'io 'file-input-stream]\"\n  [sym]\n  (mapv symbol (str/split (str sym) #\"\\.\")))\n\n\n(defn- walk-path\n  \"Descend a registry's :modules map along path, a sequence of symbols.\n\n   Namespace segments step through plain maps until the path reaches a\n   module entry (a map carrying :manifest); the remaining segments read\n   that entry's task-local lowered `:bindings` when it holds them -- a\n   linked module (yin.vm.linker.md section 8.3) -- and its `:slice`\n   otherwise, which for a host module is the host values themselves, so\n   a binding name resolves to its export.\"\n  [node path]\n  (if (seq path)\n    (if (and (map? node) (contains? node :manifest))\n      (get-in node (into [(if (contains? node :bindings) :bindings :slice)]\n                         path))\n      (when-let [child (get node (first path))]\n        (walk-path child (rest path))))\n    node))\n\n\n(defn module-entry\n  \"The registry entry of module `module-name` in `modules` (a registry's\n   `:modules` map), or nil when the dotted path reaches no module entry.\"\n  [modules module-name]\n  (let [node (reduce (fn [node seg] (when (map? node) (get node seg)))\n                     modules\n                     (symbol->path module-name))]\n    (when (and (map? node) (contains? node :manifest)) node)))\n\n\n(defn assoc-module\n  \"Return registry with `entry` installed as module `module-name`.\"\n  [registry module-name entry]\n  (assoc-in (or registry (empty-registry))\n            (into [:modules] (symbol->path module-name))\n            entry))\n\n\n(defn link-module\n  \"The `linked` transition's registry update (yin.vm.linker.md sections\n   7.3 and 8.3): `registry` gains the module `manifest` names as the\n   portable encoding of acts 1 to 3 -- `{:manifest m :address a\n   :derivation d :slice {sym encoded} :stores {address snapshot} :cells\n   {cell-id cell} :images {identity image}}` -- never lowered values. `a`\n   is the manifest's own address; `lifted` is the act-1 lift, `{:slice\n   :stores :cells :images}`, the cells being the logical cursor cells its\n   references name (r9) and the images the verified origin images a\n   receiving task attaches.\n   Each receiving task lowers the entry into its own `:bindings`.\"\n  [registry manifest derivation lifted]\n  (assoc-module registry\n                (:yin.module/name manifest)\n                {:manifest manifest,\n                 :address (jing/segment-key manifest),\n                 :derivation derivation,\n                 :slice (:slice lifted),\n                 :stores (:stores lifted),\n                 :cells (:cells lifted),\n                 :images (:images lifted)}))\n\n\n(defn module-entries\n  \"Every `[name entry]` a registry value holds, the module name read back\n   from each entry's manifest.\"\n  [registry]\n  (letfn [(walk\n            [node]\n            (when (map? node)\n              (if (contains? node :manifest)\n                [[(:yin.module/name (:manifest node)) node]]\n                (mapcat walk (vals node)))))]\n    (vec (walk (:modules registry)))))\n\n\n(defn pin-conflict\n  \"The deterministic refusal when receiving `entry` as `module-name`\n   would disagree with a linked manifest's dependency pin. Missing\n   dependencies are permitted; pins are derived from registry manifests.\"\n  [registry module-name entry]\n  (let [linked (filter (fn [[_ e]] (some? (:address e)))\n                       (module-entries registry))\n        existing (keep (fn [[owner e]]\n                         (let [requires (:yin.module/requires (:manifest e))]\n                           (when (and (contains? requires module-name)\n                                      (not= (get requires module-name)\n                                            (:address entry)))\n                             [module-name owner (get requires module-name)\n                              (:address entry)])))\n                       linked)\n        incoming (keep (fn [[name pinned]]\n                         (when-let [held (module-entry (:modules registry) name)]\n                           (when (not= pinned (:address held))\n                             [name module-name pinned (:address held)])))\n                       (:yin.module/requires (:manifest entry)))\n        conflict (first (sort-by (fn [[name owner pinned address]]\n                                   [(str name) (str owner) (str pinned) (str address)])\n                                 (concat existing incoming)))]\n(ns yin.vm.engine\n  \"Shared evaluation machinery for Yin VMs on DaoStream v2.\n\n   What the port changed, and why:\n\n   - **The host supplies streams.** `:stream/make` calls the composition's\n     `:make-stream`; there is no transport identity in this namespace. Every\n     other stream handler is a protocol call on a handle already in the\n     private `:resources` table, which no store instruction reads, reached\n     through a reference whose seal is verified first.\n   - **Cursors are opaque.** A cursor cell in `:resources` is\n     `{:stream-id id :cursor <opaque>}`. Nothing increments one.\n   - **Outcomes are maps, and every handler is total over its closed set.**\n     `blocked` and `full` park; `end` and `gap` are values the program sees;\n     the rest are errors that name their outcome.\n   - **Waiters are gone.** No v2 transport is waitable, so the polling wait\n     set is the mechanism rather than a fallback. A poll is a synchronous\n     `next` or `append!` on the handle in `:resources`; no scheduler runtime\n     sits between the VM and its streams. Cadence comes from the driver\n     above the VM.\n   - **`:stream/take` is gone.** Destructive read needs a reader position in\n     the medium, which the contract retired.\n   - **The module registry is a value** carried in VM state, so effect\n     dispatch and `resolve-var` read a supplied registry rather than a global.\n   - **Program observation is not engine work.** `ready-for-ingress?` lives\n     here because it speaks the scheduler's own vocabulary, but the program\n     handle, cursor, and gap count belong to `dao.stream.observer`;\n     nothing in this namespace polls a program stream.\"\n  (:refer-clojure :exclude [gensym])\n  (:require #?@(:cljd [[\"dart:core\" :as dart-core]])\n            [clojure.set]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.stream :as stream]\n            [dao.stream.apply :as apply2]\n            [dao.stream.waitset :as waitset]\n            [yin.vm :as vm]\n            [yin.vm.ffi :as ffi]\n            [dao.host.integer :as integer-host]\n            [yin.vm.linker :as linker]\n            [yin.vm.module :as module]\n            [yin.vm.telemetry :as telemetry]\n            [yin.vm.values :as values]))\n\n\n(defn- outcome\n  [result]\n  (:dao.stream/outcome result))\n\n\n(defn- fail\n  [message data]\n  (throw (ex-info message data)))\n\n\n(defn bind-params\n  \"Zips params with args, nil-filling any params beyond args' length.\n   Extra args beyond params' length are dropped. §7.7.2: an under-arity\n   call leaves missing parameter names bound to nil, not absent.\"\n  [params args]\n  (into {} (map vector params (concat args (repeat nil)))))\n\n\n;; =============================================================================\n;; Application refusals (D6)\n;; =============================================================================\n;;\n;; One vocabulary, in the `:reason` shape, for every kernel:\n;;\n;;   :not-applicable      the operator is neither a host function, a\n;;                        closure nor a continuation; carries a coarse\n;;                        `:kind`, never the value\n;;   :foreign-value       a closure or continuation another task minted;\n;;                        carries `:kind :closure` or `:continuation`\n;;   :foreign-format      a continuation of another kernel format or image\n;;   :continuation-arity  a continuation applied to other than one argument\n\n(defn operator-kind\n  \"Classify the operator `f` a kernel of `state` is about to apply:\n   `:host-fn`, `:closure` or `:continuation`. A closure or continuation\n   must be owned by this task (`:owner`); anything else is refused. The\n   one classifier every kernel's application calls.\"\n  [state f]\n  (cond (fn? f) :host-fn\n        (values/host-typed? f)\n        (if (values/owned-by? f (:owner state))\n          (if (values/closure? f) :closure :continuation)\n          (fail \"Cannot apply a value of another task\"\n                {:reason :foreign-value, :kind (values/kind-of f)}))\n        :else (fail \"Cannot apply non-function\"\n12:   completion and heap reclamation read the payload, so they keep operating\nls: /opt/homebrew/bin/git: No such file or directory\nls: /opt/homebrew/bin/python3: No such file or directory\n","exit_code":1,"status":"failed"}}
