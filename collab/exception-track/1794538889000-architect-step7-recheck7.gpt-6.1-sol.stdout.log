alue false})]\\n                (kit/observation-map-form\\n                  {:retained (list '= :return (list 'get 'probe.retained :route))\\n                   :plain-local-error (list '= false (list 'get 'probe.local :value))})))\\n        results (run-provenance-observation observation)]\\n    (is (= #{:semantic :stack :register} (set (keys results))))\\n    (doseq [[backend actual] results]\\n      (println \\\"PHP-NIL-CONDITION\\\" backend actual)\\n      (is (= {:retained true :plain-local-error true} actual)\\n          (str backend \\\": a nil condition raises the plain local Error, \\\"\\n               \\\"never a provenance mint (got \\\" (pr-str actual) \\\")\\\")))))\\ncollab/exception-track/1794430000000-owner-brief-vm-provenance-storage.md\\ncollab/exception-track/1794930000000-engineer-exception-ruling-review.gemini-3.8-flash.stdout.log\\ncollab/exception-track/1794930000000-engineer-exception-ruling-review.kimi-k3.1-pro.stdout.log\\ncollab/exception-track/1794920000000-owner-ruling-exception-uniformity.md\\ncollab/exception-track/1794930000000-engineer-exception-ruling-review.gpt-6.1-sol.stdout.log\\ncollab/exception-track/1794960000000-owner-ruling-exception-uniformity-v2.md\\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log\\ncollab/exception-track/1794930000000-engineer-exception-ruling-review.qwen3.8-max.stdout.log\\ncollab/exception-track/1795300000000-yangclojure-ack-tsphp-ordering-and-prelude-ownership.md\\ncollab/exception-track/1794527932000-engineer-php-r1r2r3-r11.qwen3.8-max.findings.md\\ncollab/exception-track/1794532719000-architect-step7-recheck6.gpt-6.1-sol.stdout.log\\ncollab/exception-track/1794532719000-architect-step7-recheck6.prompt.md\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/exception-track/1794532719000-architect-step7-recheck6.gpt-6.1-sol.stdout.log:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc