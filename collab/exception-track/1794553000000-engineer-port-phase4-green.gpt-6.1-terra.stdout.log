redit only through adapter-declared ambient-literal sites; delegations and the :gate-site/none entry site never credit\"\ntest/yang/latte_oracle_test.clj:3536:      (finally\ntest/yang/php/antlr/phpt_selection.edn:3177:   \"<?php\\nfunction foo1() {\\n    try {\\n        throw new Exception(\\\"not catch\\\");\\n        return true;\\n    } finally {\\n        try {\\n            throw new Exception(\\\"caught\\\");\\n        } catch (Exception $e) {\\n        }\\n    }\\n}\\ntry {\\n    $foo = foo1();\\n    var_dump($foo);\\n} catch (Exception $e) {\\n    do {\\n        var_dump($e->getMessage());\\n    } while ($e = $e->getPrevious());\\n}\\n\\nfunction foo2() {\\n    try  {\\n        try {\\n            throw new Exception(\\\"caught\\\");\\n            return true;\\n        } finally {\\n            try {\\n                throw new Exception(\\\"caught\\\");\\n            } catch (Exception $e) {\\n            }\\n        }\\n    } catch (Exception $e) {\\n    }\\n}\\n\\n$foo = foo2();\\nvar_dump($foo);\\n\\nfunction foo3() {\\n    try {\\n        throw new Exception(\\\"not caught\\\");\\n        return true;\\n    } finally {\\n        try {\\n            throw new NotExists();\\n        } catch (Exception $e) {\\n        }\\n    }\\n}\\n\\n$bar = foo3();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3178:   :title \"Fixed Bug #65784 (Segfault with finally)\",\ntest/yang/php/antlr/phpt_selection.edn:3225:   \"<?php\\nfunction bar() {\\n    try {\\n        echo \\\"1\\\\n\\\";\\n        try {\\n        } finally {\\n            try {\\n            } finally {\\n            }\\n            echo \\\"2\\\\n\\\";\\n        }\\n    } finally {\\n        try {\\n            throw new Exception (\\\"\\\");\\n        } catch (Exception $ab) {\\n            echo \\\"3\\\\n\\\";\\n        } finally {\\n            try {\\n            } finally {\\n                echo \\\"4\\\\n\\\";\\n                try  {\\n                } finally {\\n                }\\n                echo \\\"5\\\\n\\\";\\n            }\\n        }\\n        echo \\\"6\\\\n\\\";\\n        try {\\n        } finally {\\n            while (1) {\\n                try {\\n                    echo \\\"7\\\\n\\\";\\n                    break;\\n                } finally {\\n                    echo \\\"8\\\\n\\\";\\n                }\\n                echo \\\"bad\\\";\\n            }\\n            echo \\\"9\\\\n\\\";\\n            while (1) {\\n                try {\\n                    throw new Exception(\\\"\\\");\\n                } catch(Exception $e) {\\n                    echo \\\"10\\\\n\\\";\\n                    break;\\n                } finally {\\n                    echo \\\"11\\\\n\\\";\\n                }\\n                echo \\\"bak\\\\n\\\";\\n            }\\n        }\\n        echo \\\"12\\\\n\\\";\\n    }\\n    echo \\\"13\\\\n\\\";\\n}\\nbar();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3227:   \"Bug #66608 (Incorrect behavior with nested \\\"finally\\\" blocks)\",\ntest/yang/php/antlr/phpt_selection.edn:3726:   \"<?php\\ntry {\\n    echo \\\"Outer try\\\\n\\\";\\n    try {\\n        echo \\\"  Middle try\\\\n\\\";\\n        throw new Exception();\\n    } finally {\\n        echo \\\"  Middle finally\\\\n\\\";\\n        try {\\n            echo \\\"    Inner try\\\\n\\\";\\n        } finally {\\n            echo \\\"    Inner finally\\\\n\\\";\\n        }\\n    }\\n    echo \\\"Outer shouldn't get here\\\\n\\\";\\n} catch (Exception $e) {\\n    echo \\\"Outer catch\\\\n\\\";\\n} finally {\\n    echo \\\"Outer finally\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3727:   :title \"Bug #70012 (Exception lost with nested finally block)\",\ntest/yang/php/antlr/phpt_selection.edn:3729:   \"Outer try\\n  Middle try\\n  Middle finally\\n    Inner try\\n    Inner finally\\nOuter catch\\nOuter finally\",\ntest/yang/php/antlr/phpt_selection.edn:3998:   \"<?php\\ntry {\\n    $e = new Exception(\\\"Foo\\\");\\n    try {\\n        throw  new Exception(\\\"Bar\\\", 0, $e);\\n    } finally {\\n        throw $e;\\n    }\\n} catch (Exception $e) {\\n    var_dump((string)$e);\\n}\\n\\ntry {\\n    $e = new Exception(\\\"Foo\\\");\\n    try {\\n        throw new Exception(\\\"Bar\\\", 0, $e);\\n    } finally {\\n        throw new Exception(\\\"Dummy\\\", 0, $e);\\n    }\\n} catch (Exception $e) {\\n    var_dump((string)$e);\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4000:   \"Bug #70944 (try{ } finally{} can create infinite chains of exceptions)\",\ntest/yang/php/antlr/phpt_selection.edn:4354:   \"<?php\\nfunction test() {\\n    try {\\n        return 5;\\n    } finally {\\n        try {\\n            echo 1;\\n        } finally {\\n            echo 2;\\n        }\\n    }\\n}\\n\\n\\n\\n$a = test();\\nif($a !== 5) {\\n    echo \\\"FAILED: expected 5, received \\\", var_export($a), PHP_EOL;\\n} else {\\n    echo \\\"Passed\\\", PHP_EOL;\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4355:   :title \"Bug #72188 (Nested try/finally blocks losing return value)\",\ntest/yang/php/antlr/phpt_selection.edn:4360:   \"<?php\\nfunction test() {\\n    $a = 1;\\n    try {\\n        return $a;\\n    } finally {\\n        $a = 2;\\n    }\\n}\\nvar_dump(test());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4361:   :title \"Bug #72215 (Wrong return value if var modified in finally)\",\ntest/yang/php/antlr/phpt_selection.edn:4372:   \"<?php\\nfunction test() : int {\\n    $d = 1.5;\\n    try {\\n        return $d;\\n    } finally {\\n        var_dump($d);\\n    }\\n}\\nvar_dump(test());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4373:   :title \"Bug #72347 (VERIFY_RETURN type casts visible in finally)\",\ntest/yang/php/antlr/phpt_selection.edn:7162:   \"<?php\\nfunction test() {\\n    try {\\n        $a = [1, 2, 3];\\n        return $a + [];\\n    } finally {\\n        throw new Exception;\\n    }\\n}\\n\\ntry {\\n    test();\\n} catch (Exception $e) {\\n    echo \\\"exception\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7163:   :title \"Live range & throw from finally\",\n","exit_code":0,"status":"completed"}}
