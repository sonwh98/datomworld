                       (fn [] (throw (NullPointerException.))))]\n      (is (thrown? NullPointerException (npe))))))\n\n\n(deftest test-outcome-native-path-emits-none\n  (let [forms '[(defn f\n                  [x]\n                  (throw (ex-info \"t\" {}))) (defn g\n                                              [x]\n                                              (+ x 1)) (g 1)]]\n    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true av-opts)))\n        \"the convention without :outcomes carries no outcome tags\")\n    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program '[(defn g\n                                (+ x 100))\n                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]\n                                (f 1))]\n                            library-opts lane 200000)]\n        (is (= :yin.k/error tag))\n        (is (= :yang.call/not-callable (:yang.call/reason payload))\n            \"entry-present forged local map routes to admission and refuses\"))\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(defn f\n                              [[f]]\n                              (f 1))\n                            (f [5])]\n                          library-opts lane 200000))\n          \"destructured parameter shadows enclosing defn\")\n      (is (= [:yin.k/ok 7]\n             (run-library '[(defn f\n                              [x]\n                              99)\n                            (try\n                              (throw (ex-info \"boom\" {:k 7}))\n                              (catch Exception f\n                                (let [d (get f :yin.k/data) v [d]]\n                                  (d :k))))]\n                          library-opts lane 200000))\n          \"catch binder shadows top-level defn\")))\n  (testing \"top-level def/defn interactions, err