ngine issues carries a seal over its kind and id under the task's\n297:;; verifies the seal first: a literal with a wrong or missing seal fails\n300:(defn- seal-of\n301:  \"The seal of a `kind` reference to resource `id` under `secret`.\"\n303:  (jing/content-hash [:yin.k/seal secret kind id] {:algorithm :blake3}))\n310:   with the successor. A guest program holds a sealed `:cursor-ref` naming\n318:  \"A reference of `kind` (`:stream-ref`, `:cursor-ref`, or `:cell-ref`) to\n319:   resource or heap cell `id`, sealed under the task's capability secret.\n329:    {:type kind, :id id, :seal (seal-of secret kind id)}))\n333:  \"True when `ref` is a `kind` reference this task issued: its seal\n335:   kind. A `:cell-ref` is checked against `:heap` instead: its id is live\n336:   by `contains?` (a cell may hold nil) and its seal equals the one the\n341:    (if (= :cell-ref kind)\n346:                      (= (:seal ref) (:seal (get heap id))))))\n351:                      (= (:seal ref) (seal-of secret kind id))\n357:   seal verifies (r10). Anything else fails closed with\n366:          dead? (and (= :cell-ref kind) (not (contains? (:heap state) id)))]\n382:   sealed under the task's secret. This is how a stream reaches a program:\n470:   answers a sealed reference; the reference is issued first, so a task\n541:   into a cursor cell in `:resources`, and answers a sealed reference.\n565:   sealed cursor reference and installs an unminted cell, with no handle\n873:   cursor reference is authenticated before it is encoded (r11): its seal\n876:   without its seal, as a stream marker or a cell reference. A\n878:   UCF 7.5.4 kinds; a heap `:cell-ref` refuses as `:cell` until the heap\n917:                :cell-ref\n939:   or cursor marker is a fresh reference sealed under the receiver's\n1097:   coordinates into the entry's `:bindings`, every reference re-sealed\n2445:  \"`state` with heap cell `id` holding `v` under `seal`: allocation when the\n2446:   cell is new, a write (the seal unchanged) when it is live.\"\n2447:  [state id seal v]\n2448:  (assoc-in state [:heap id] {:value v, :seal seal}))\n2467:  \"The id the map `x` names when it is a `:cell-ref` authentic against\n2470:  (when (= :cell-ref (:type x))\n2473:      (when (and (some? entry) (= (:seal x) (:seal entry))) id))))\n2775:                ref (issue-ref s' :cell-ref id)]\n2776:            {:state (heap-write s' id (:seal ref) (:val effect)),\n2780:          (let [id (check-ref! state :cell/get :cell-ref (:cell effect))]\n2786:          (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n2787:            {:state (heap-write state id (get-in state [:heap id :seal])\n2791:          ;; The cell-ref ruling of record: the same heap+seal predicate\n2798:           :value (authentic-ref? state :cell-ref (:cell effect)),\n;; The `cell` module\n;; =============================================================================\n;;\n;; A cell is a mutable location in the task's `:heap`, reached by a sealed\n;; `:cell-ref` (Architect cell ruling, slice 1). These are pure effect\n;; constructors like the stream module's: they touch no heap, and the engine\n;; interprets the effects they return. The heap is VM state, so a mutation\n;; is shared by every closure over the ref and is never rolled back when a\n;; continuation is invoked (box semantics). Beside the three mutators the\n;; module publishes `authentic?`, the ruling-of-record query a caller's\n;; compiled code asks the issuer before dereferencing a cell-ref-shaped\n;; callee; it answers a boolean and changes nothing.\n\n(defn new-cell\n  [v]\n  (make-effect :cell/new {:val v}))\n\n\n(defn get-cell\n  [c]\n  (make-effect :cell/get {:cell c}))\n\n\n(defn set-cell!\n  [c v]\n  (make-effect :cell/set! {:cell c, :val v}))\n\n\n(defn authentic-cell?\n  \"The pure query the cell-ref ruling of record added: does the heap\n   issue `c` as a cell reference? The engine answers the same\n   heap+seal predicate `check-ref!` consults, as a boolean, so compiled\n   call routing can ask the issuer instead of guessing from a value's\n   shape. Non-fatal, state unchanged.\"\n  [c]\n  (make-effect :cell/authentic? {:cell c}))\n\n\n(def cell-module\n  \"The `cell` module definition. Registering it is a composition step.\"\n  {'new new-cell, 'get get-cell, 'set! set-cell!, 'authentic? authentic-cell?})\n\n\n(def cell-profiles\n  \"UCF 7.5.2 profiles for the `cell` module's bindings: each an\n   `:effectful` pure effect constructor declaring its one effect kind.\"\n  {'new (vm/primitive-profile 'new :effectful [1] #{:cell/new} :none)\n   'get (vm/primitive-profile 'get :effectful [1] #{:cell/get} :none)\n   'set! (vm/primitive-profile 'set! :effectful [2] #{:cell/set!} :none)\n   'authentic? (vm/primitive-profile 'authentic? :effectful [1]\n                                     #{:cell/authentic?} :none)})\n\n\n(defn register-cell-module\n  \"Return registry with the `cell` module registered.\"\n  [registry]\n1:(ns ^{:clj-kondo/config '{:lint-as {yang.python.antlr.prelude/defquoted clojure.core/def}}}\n179:   Host names the prelude depends on and does not define: `host-names`\n182:  #?(:cljs (:require-macros [yang.python.antlr.prelude :refer [defquoted]]))\n192:   (defmacro defquoted\n203:(def host-names\n216:        call/host-names))\n219:(defquoted ^:private core-definitions\n3444:(defquoted builtin-functions\n3552:(defquoted ^:private method-implementations\n3609:(defn- init-form\n3684:  (into core-definitions\n3686:         ['py/init! (init-form)]]))\n3719:   pre-seeded module objects. Read from the same tables `init-form` reads.\"\n3814:  \"Return `registry` when it supplies every one of `host-names`, else\n3823:  (core/admit registry host-names\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4114,4169p' src/cljc/yang/typescript/antlr/prelude.cljc; rg -n 'retained-store' src/cljc/yang/typescript/antlr/prelude.cljc; ls .cpcache; sed -n '337,430p' test/yang/call/conformance.clj; rg -n 'kondo' deps.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '4114,4169p' src/cljc/yang/typescript/antlr/prelude.cljc; rg -n 'retained-store' src/cljc/yang/typescript/antlr/prelude.cljc; ls .cpcache; sed -n '337,430p' test/yang/call/conformance.clj; rg -n 'kondo' deps.edn\"","aggregated_output":"         '(js/install-json!)\n         '(js/define-own! js.rt/global\n                          {:js/str \"undefined\"}\n                          (js/slot :js/undefined false false false))\n         '(js/define-own! js.rt/global\n                          {:js/str \"NaN\"}\n                          (js/slot (js/nan) false false false))\n         '(js/define-own! js.rt/global\n                          {:js/str \"Infinity\"}\n                          (js/slot (data/float64 (data/float-value ##Inf)) false false false))\n         '(js/define-global! \"globalThis\" js.rt/global)\n         '(let [c (js/make-object js.rt/obj-proto)]\n            (do (js/def-method! c \"log\" 0 js/console-log)\n                (js/define-global! \"console\" c)))]\n        ;; last, so a failed init never reports ready\n        [(define 'js.rt/state :js/ready) :js/undefined])\n      :js/undefined)))\n\n\n(def ^:private t4-definitions\n  [['js/args-object '(fn [args] (js/new-array args))]\n   ['js/spread-array-items\n    '(fn [items i out]\n       (if (< i (data/count items))\n         (js/spread-array-items\n           items\n           (+ i 1)\n           (js/vconj out (js/item-val (get items i))))\n         out))]\n   ['js/args-spread\n    '(fn [args value]\n       (if (js/array? value)\n         (data/into args\n                    (js/spread-array-items (get (cell/get value) :items) 0 []))\n         (js/throw-type-error {:js/str \"Spread value is not iterable\"})))]])\n\n\n(def definitions\n  \"The single definition list, `[store-key form]` in definition order:\n   every prelude function, the literal state slot, then `js/init!`.\n   Defining them runs nothing.\"\n  (into (into (into (into (into (into core-definitions object-definitions)\n                                t4-definitions)\n                          array-definitions)\n                    json-definitions)\n              class-definitions)\n        [['js.rt/state :js/uninit] ['js/init! (init-form)]]))\n\n\n(def ^:private linked-definitions\n  \"The `js` module body; the common call runtime is pinned as a requirement.\"\n  definitions)\n\n\n(defn- definitions->uast\n  [defs]\n1360937979.basis\n1360937979.cp\n2276128749.basis\n2276128749.cp\n2410757473.basis\n2410757473.cp\n2410757473.main\n2602022000.basis\n2602022000.cp\n2770481537.basis\n2770481537.cp\n2770481537.main\n3555353264.basis\n3555353264.cp\n357380518.basis\n357380518.cp\n357380518.jvm\n357380518.main\n357380518.manifest\n3644903311.basis\n3644903311.cp\n3644903311.jvm\n3644903311.main\n3644903311.manifest\n3936417337.basis\n3936417337.cp\n4183786633.basis\n4183786633.cp\n4183786633.jvm\n4183786633.main\n4183786633.manifest\n4264801897.basis\n4264801897.cp\n4264801897.jvm\n832525122.basis\n832525122.cp\n832525122.jvm\n832525122.main\n832525122.manifest\n868029096.basis\n868029096.cp\n868029096.main\n(defn compose-exception\n  \"Compose real donor/caller source exactly as `compose` does, optionally\n   followed by an unlowered boundary observation form. The source bodies\n   and their call nodes are untouched. Boundary forms are for provenance\n   assertions and malformed invocations, not substitute source-pair legs.\"\n  ([donor exports caller-frontend caller-source]\n   (compose donor exports caller-frontend caller-source))\n  ([donor exports caller-frontend caller-source observation]\n   (u/mark-tails\n     (u/then (compose donor exports caller-frontend caller-source)\n             (u/sexp->uast observation)))))\n\n\n(defn observation-map-form\n  \"Emit a map whose known observation values are guest expressions.\n   sexp->uast intentionally treats a map literal as DATA, including lists\n   and symbols within it. Dynamic boundary observations use explicit assoc,\n   never a transformation of parsed source or a runtime shape detector.\"\n  [entries]\n  (reduce (fn [form [k value]] (list 'assoc form k value)) {} entries))\n\n\n(defn observation-vector-form\n  \"Emit a boundary argument vector of evaluated expressions. Like maps,\n   vectors in sexp->uast are otherwise literal data.\"\n  [expressions]\n  (reduce (fn [form value] (list 'conj form value)) [] expressions))\n\n\n(defn boundary-call-form\n  \"An abortive observer of a public entry, as guest code. All arguments are\n   forms. `options` selects invoke-with when present. A returned envelope\n   is recorded as :return; only the supplied exit records :raise. Transfer\n   count and the after-call sentinel live in task cells. No payload is\n   snapshotted here: assertions must precede rendering.\"\n  ([callee positional named]\n   (boundary-call-form callee positional named nil))\n  ([callee positional named options]\n   (let [phase (gensym \"phase\")\n         transfers (gensym \"transfers\")\n         after (gensym \"after\")\n         escape (gensym \"escape\")\n         condition (gensym \"condition\")\n         returned (gensym \"returned\")\n         raise (list 'fn [condition]\n                     (list 'do\n                           (list 'cell/set! transfers (list '+ 1 (list 'cell/get transfers)))\n                           (list escape\n                                 (observation-map-form\n                                   {:route :raise :condition condition\n                                    :transfers (list 'cell/get transfers)\n                                    :after (list 'cell/get after)}))))\n         invocation (if options\n                      (list 'yang.call/invoke-with callee positional named raise options)\n                      (list 'yang.call/invoke callee positional named raise))]\n     (list 'let [phase (list 'cell/new false)\n                 transfers (list 'cell/new 0) after (list 'cell/new false)]\n           (list (list 'fn [escape]\n                       (list 'if (list 'cell/get phase)\n                             escape\n                             (list 'do (list 'cell/set! phase true)\n                                   (list 'let [returned invocation]\n                                         (list 'do (list 'cell/set! after true)\n                                               (observation-map-form\n                                                 {:route :return :value returned\n                                                  :transfers (list 'cell/get transfers)\n                                                  :after (list 'cell/get after)}))))))\n                 (list '%capture))))))\n\n\n(defn guard-exceptions-form\n  \"Diagnostic outer handlers: expose an escape that bypassed the supplied\n   boundary exit as :unbridged, rather than letting no-handler obscure the\n   assertion. These are NOT replacement callee bridges: :unbridged always\n   fails the provenance contract. Catch data stays guest-local.\"\n  [frontend-keys form]\n  (reduce\n    (fn [body frontend]\n      (let [e (gensym \"unbridged\")\n            handler (list 'fn [e] {:route :unbridged :frontend frontend})]\n        (case frontend\n          :typescript (list 'js/try (list 'fn [] body) handler)\n          (:python :php)\n          (let [result (gensym \"result\")\n                try-name (if (= frontend :python) 'py/try 'php/try)]\n            (list 'let [result (list 'cell/new nil)]\n                  (list try-name\n                        (list 'fn [] (list 'cell/set! result body))\n                        handler\n                        (list 'fn [] (list 'cell/get result)))))\n          :clojure body)))\n    form (distinct frontend-keys)))\n\n\n119:           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n120:                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"Python instances store their state in ordinary VM heap cells. Python attribute writes use `:attrs`, but admitted Clojure source can read and replace the whole cell value. The existing cell API provides no private attachment storage, so a prelude-only change cannot supply the requested provenance.\n\nI’ll add and run the three failing pins now. The fix needs a small host/VM addition outside the ceded prelude regions."}}
{"type":"item.completed","item":{"id":"item_14","type":"agent_message","text":"May I extend this round to add private, capability-keyed attachments to VM cell heap entries, with GC tracing, then use a private Python constructor/reader closure to access them? The current cell API exposes only new/get/set!/authentic?, so the exact-identity provenance requirement cannot be met within the ceded prelude regions alone.\n- Authorize the minimal VM cell support and focused tests\n- Keep ceded regions only; deliver failing pins and blocker"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2450,2585p' src/cljc/yin/vm/engine.cljc; sed -n '185,220p' src/cljc/yang/python/antlr/prelude.cljc; sed -n '1,90p' test/yang/call/conformance.clj; sed -n '110,125p' deps.edn; rg -n 'seal|cell/get|cell/new|GC|collect' test/yin/vm/heap* test/yin/vm/*cell*\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2450,2585p' src/cljc/yin/vm/engine.cljc; sed -n '185,220p' src/cljc/yang/python/antlr/prelude.cljc; sed -n '1,90p' test/yang/call/conformance.clj; sed -n '110,125p' deps.edn; rg -n 'seal|cell/get|cell/new|GC|collect' test/yin/vm/heap* test/yin/vm/*cell*\"","aggregated_output":"\n;; =============================================================================\n;; Heap reclamation (Architect heap-reclamation design, slice 1)\n;; =============================================================================\n;;\n;; A deterministic, allocation-triggered, stop-the-world mark-sweep over\n;; `:heap`, as a pure `vm -> vm'`. The `:cell/new` arm counts allocations in\n;; `:gc` and collects when the count reaches the threshold, so two runs\n;; collect at the same allocation. Marking runs over the heap as it was when\n;; the cycle began (a persistent map, so the snapshot is a reference) and the\n;; sweep removes only ids of that snapshot: an id allocated at or after the\n;; cycle's counter start is not in it and is spared. A budgeted marker can\n;; later run the same `trace` k steps per round. Ids are never reused:\n;; `:id-counter` only grows, so a ref to a swept cell names nothing and is\n;; refused `:dead-or-forged-reference`.\n\n(defn- heap-ref-id\n  \"The id the map `x` names when it is a `:cell-ref` authentic against\n   `heap`, else nil.\"\n  [heap x]\n  (when (= :cell-ref (:type x))\n    (let [id (:id x)\n          entry (get heap id)]\n      (when (and (some? entry) (= (:seal x) (:seal entry))) id))))\n\n\n(defn- moded\n  \"`work` with each of `xs` pushed in `mode`, `:kernel` or `:data`.\"\n  [work mode xs]\n  (into work (map (fn [x] [mode x])) xs))\n\n\n(defn- identity-hash\n  \"The host's identity hash of `o`: one number per object, whatever the\n   object's size. It reads no field of `o`, so a continuation holding a\n   thousand-frame chain costs what a scalar costs.\"\n  [o]\n  #?(:clj (System/identityHashCode o)\n     :cljs (goog/getUid o)\n     :cljd (dart-core/identityHashCode o)))\n\n\n;; `trace` cannot key its seen set on `(hash [mode value])`, the shape a\n;; Clojure set asks for: a closure's and a continuation's `-hash` is\n;; structural over kind, owner and payload by law (`yin.vm.values`, table C),\n;; so hashing one recurses through its whole payload — the captured\n;; environments, the continuation chain below, the AST bodies those hold. A\n;; guest that has grown a 1000-frame handler chain then exhausts the host\n;; stack inside the collector, long before its own recursion guard fires\n;; (stack audit r2: a 13,542-frame trace, every frame a `hash`).\n;;\n;; Identity is also the sounder key, and not only the cheaper one. Nothing\n;; is missed by it: a value already walked is the same object, and an\n;; equal-but-distinct one is walked again, finding the same ids. `found` —\n;; hence the heap the sweep leaves — is what value-keyed dedup computed.\n(deftype Visited\n  [mode o]\n  #?@(:cljd [cljd.core/IEquiv\n             (-equiv [_ other]\n                     (and (instance? Visited other)\n                          (= mode (.-mode ^Visited other))\n                          (identical? o (.-o ^Visited other))))\n             cljd.core/IHash\n             (-hash [_] (bit-xor (hash mode) (identity-hash o)))]\n      :clj [Object\n            (equals [_ other]\n                    (and (instance? Visited other)\n                         (= mode (.-mode ^Visited other))\n                         (identical? o (.-o ^Visited other))))\n            (hashCode [_] (bit-xor (hash mode) (identity-hash o)))\n            clojure.lang.IHashEq\n            (hasheq [_] (bit-xor (hash mode) (identity-hash o)))]\n      :cljs [IEquiv\n             (-equiv [_ other]\n                     (and (instance? Visited other)\n                          (= mode (.-mode ^Visited other))\n                          (identical? o (.-o ^Visited other))))\n             IHash\n             (-hash [_] (bit-xor (hash mode) (identity-hash o)))]))\n\n\n(defn- trace\n  \"`found` plus the ids of `heap` reachable from `roots`, a map\n   `{:kernel [...] :data [...]}` of root values by mode. Two modes keep\n   guest data from being read as kernel shapes (gemini reclamation gate,\n   concern 1):\n\n   - `:kernel`, a value in a kernel position (a kernel root, an engine\n     table entry, a closure or continuation payload, or a kernel child of\n     one): the kernel's `gc-children` may interpret it, and answers which\n     of its children are kernel positions and which are values. A value\n     it does not recognize is walked whole, as data.\n   - `:data`, a value position (an environment value, an operand, a\n     register, a cell's content): every map is walked whole, never\n     pruned, so a guest map shaped like a frame cannot hide a cell ref.\n     Only a closure or continuation, a host type no guest can forge,\n     re-enters `:kernel` mode through its payload.\n\n   Scalars hold nothing. With `follow?` a newly found id's content is\n   traced too, as data (marking); without, only the refs met directly\n   (pinning). Each object is visited once per mode, so shared environments\n   cost one walk and a cell holding its own ref terminates; the visit is\n   keyed on identity (`Visited`), never on a value's structural hash,\n   which for a closure or a continuation would recurse through the whole\n   chain it holds. The worklist is explicit: a deep continuation chain\n   does not grow the host stack.\"\n  [vm heap roots found follow?]\n  (let [children-of (if (satisfies? module/IModuleKernel vm)\n                      #(module/gc-children vm %)\n                      (constantly nil))]\n    (loop [work (-> ()\n                    (moded :kernel (:kernel roots))\n                    (moded :data (:data roots)))\n           seen #{}\n           found found]\n      (if (empty? work)\n        found\n        (let [[mode x] (peek work)\n              work (pop work)\n              visit (when-not (scalar? x) (Visited. mode x))]\n          (if (or (nil? visit) (contains? seen visit))\n            (recur work seen found)\n            (let [id (when (map? x) (heap-ref-id heap x))\n                  new-id? (and (some? id) (not (contains? found id)))\n                  children (when (and (= :kernel mode)\n                                      (not (values/host-typed? x)))\n                             (children-of x))\n                  work (cond-> work\n                         (and new-id? follow?)\n                         (conj [:data (:value (get heap id))])\n                         (values/host-typed? x)\n                         (conj [:kernel (values/payload x)])\n                         (some? children)\n                         (-> (moded :kernel (:kernel children))\n                             (moded :data (:values children)))\n                         (and (nil? children) (map? x))\n    [yang.core.call :as call]\n    [yang.core.prelude :as core]\n    [yang.python.antlr.uast :as u]\n    [yin.vm.integer :as integer]))\n\n\n#?(:clj\n   (defmacro defquoted\n     \"`def` of the quoted data `form`.  ClojureDart compiles quoted data to\n      straight-line Dart (this prelude is about 65,000 lines of it), which the\n      Dart AOT compiler cannot take as one initializer, so there the data is\n      one EDN string read back at load.\"\n     [name doc form]\n     (if (find-ns 'cljd.compiler)\n       (list 'def name doc (list 'edn/read-string (pr-str (second form))))\n       (list 'def name doc form))))\n\n\n(def host-names\n  \"Module exports the prelude calls.\"\n  (into '#{cell/new cell/get cell/set! data/count data/into data/subvec\n           data/number? data/contains? data/dissoc data/str-concat data/str-length\n           data/str-index-of data/str->code-points data/code-points->str\n           data/float64 data/float-value data/content=\n           integer/add integer/sub integer/neg integer/mul integer/compare\n           integer/to-float integer/compare-float integer/true-div\n           integer/pow integer/shift-right integer/bit-and\n           integer/bit-or integer/bit-xor integer/bit-not integer/from-float\n           integer/floor-div-mod integer/shift-left integer/format integer/parse\n           integer/float-digits integer/decimal->float integer/max-digits\n           data/substring data/max-items}\n        call/host-names))\n\n\n(defquoted ^:private core-definitions\n  \"Pure definitions: lambdas only, so defining them runs nothing.\"\n(ns yang.call.conformance\n  \"The cross-language calling gates' shared composition (docs/design/\n   yang.antlr.md section 8.10.11): a donor program's named export reaches a\n   caller program by explicit published-export composition only.\n\n   A donor is real source of any admitted frontend, lowered unmodified and\n   published as an ordinary linker module whose one export, `body`, is the\n   lowered unit. A caller task requires that module, runs its body under the\n   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\n   `clj/run-main`), reads each named export from the donor runtime's global\n   namespace, and projects it into the caller runtime's namespace under the\n   same name; then the caller source, lowered unmodified, runs under its own\n   entry. The composition is a sequence of top-level nodes: no call node is\n   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\n   inserted, and the projected value is the donor's own callable value\n   (identity survives).\n\n   A callable value is task-local (a function is a cell, and cells are\n   task-local, section 8.11), so the export is answered as a node evaluated\n   in the caller's task, never as a host value carried between tasks.\n   `export-program` answers the donor's export alone as the program's value.\n\n   Every program runs linked on the three vector VMs (`semantic`, `stack`,\n   `register`) over the TypeScript linked harness's content store, where\n   `yang.call` and `js` already live and `php`, `py` and `clj` are\n   published beside them. The AST walker is not a backend: its links are\n   refused until L-b.\"\n  (:require\n    [clojure.string :as str]\n    [yang.clojure :as clj-comp]\n    [yang.clojure.prelude :as clj-prelude]\n    [yang.core.module :as core-module]\n    [yang.core.names :as names]\n    [yang.core.uast :as u]\n    [yang.php.antlr.cst :as php-cst]\n    [yang.php.antlr.lower :as php-lower]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.prelude :as php-prelude]\n    [yang.python.antlr.lower :as py-lower]\n    [yang.python.antlr.parser :as py-parser]\n    [yang.python.antlr.prelude :as py-prelude]\n    [yang.python.antlr.render :as py-render]\n    [yang.typescript.antlr.cst :as ts-cst]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as ts-lower]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]))\n\n\n(defn- publish-guest!\n  \"Publish guest module `spec` into the harness store, throwing immediately\n   with `result` in ex-data if publication is refused.\"\n  [spec]\n  (let [result (h/publish-guest-module! spec)]\n    (when (= :refused (:status result))\n      (throw (ex-info (str \"Guest module publication refused: \" (or (:reason result) (:status result)))\n                      result)))\n    result))\n\n\n(def ^:private published-php\n  \"`php` published once into `js`'s content store, pinning the same\n   `yang.call` revision (as `source-call-test` publishes it).\"\n  (delay (publish-guest!\n           (php-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(def ^:private published-py\n  \"`py` published beside `js` and `php`, over the same host registry and\n   `yang.call` revision.\"\n  (delay (publish-guest!\n           (py-prelude/module-spec (h/registry)\n                                   (:call-address @h/published)))))\n\n\n(def ^:private published-clj\n  \"`clj` published beside `js`, `php` and `py`, over the same host registry\n   and `yang.call` revision.\"\n  (delay (publish-guest!\n           (clj-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(defn- parse-ok\n  \"The CST packet of `source` under `parse`, refused unless the parse is ok.\"\n  [parse source]\n  (let [pk (parse source)]\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\n      (throw (ex-info \"donor or caller source does not parse\"\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\ntest/yin/vm/cell_test.cljc:3:   `cell` module's `cell/new`, `cell/get`, `cell/set!` over the task\ntest/yin/vm/cell_test.cljc:4:   `:heap`, reached by a sealed `:cell-ref`. Each program runs on all four\ntest/yin/vm/cell_test.cljc:84:   collecting at every allocation and never collecting.\"\ntest/yin/vm/cell_test.cljc:158:  (app (v 'cell/new) x))\ntest/yin/vm/cell_test.cljc:163:  (app (v 'cell/get) c))\ntest/yin/vm/cell_test.cljc:182:  \"(cell/set! c (+ (cell/get c) 1))\"\ntest/yin/vm/cell_test.cljc:300:               (if (= :cell/get effect)\ntest/yin/vm/cell_test.cljc:315:  (doseq [effect [:cell/get :cell/set!]]\ntest/yin/vm/cell_test.cljc:316:    (testing (str effect \" with a wrong seal on a live id\")\ntest/yin/vm/cell_test.cljc:317:      (forged-refusal effect (app (v 'assoc) (v 'a) (lit :seal) (lit \"x\"))))\ntest/yin/vm/cell_test.cljc:318:    (testing (str effect \" with another live cell's id under this seal\")\ntest/yin/vm/cell_test.cljc:325:    (testing (str effect \" with a literal that has no seal\")\ntest/yin/vm/cell_test.cljc:326:      (forged-refusal effect (app (v 'assoc) (v 'a) (lit :seal) (lit nil))))\ntest/yin/vm/cell_test.cljc:340:                       (app (v 'assoc) (v 'c) (lit :seal)\ntest/yin/vm/heap_reclamation_test.cljc:128:  (app (v 'cell/new) x))\ntest/yin/vm/heap_reclamation_test.cljc:133:  (app (v 'cell/get) c))\ntest/yin/vm/heap_reclamation_test.cljc:173:(deftest every-vm-starts-with-an-empty-collector-test\ntest/yin/vm/heap_reclamation_test.cljc:182:(deftest a-spawned-child-starts-with-an-empty-collector-test\ntest/yin/vm/heap_reclamation_test.cljc:247:  (set (map :value (vals (:heap (engine/collect vm))))))\ntest/yin/vm/heap_reclamation_test.cljc:305:      (is (= 2 (count (:heap (engine/collect q)))) (str k))\ntest/yin/vm/heap_reclamation_test.cljc:310:(deftest an-evaluated-operand-survives-a-collection-test\ntest/yin/vm/heap_reclamation_test.cljc:314:            second operand allocates and collects at every allocation\"\ntest/yin/vm/heap_reclamation_test.cljc:344:          (engine/handle-effect q (module/make-effect :cell/new {:val keep}) {})]\ntest/yin/vm/heap_reclamation_test.cljc:346:        (is (zero? (:since (:gc state))) \"the allocation collected\")\ntest/yin/vm/heap_reclamation_test.cljc:348:            \"the boxed cell survived its own allocation's collection\")\ntest/yin/vm/heap_reclamation_test.cljc:359:          swept (engine/collect (assoc-in q [:store 'x] keep))\ntest/yin/vm/heap_reclamation_test.cljc:362:                      (module/make-effect :cell/get {:cell junk})\ntest/yin/vm/heap_reclamation_test.cljc:365:          (engine/handle-effect swept (module/make-effect :cell/new {:val 1}) {})]\ntest/yin/vm/heap_reclamation_test.cljc:369:                :effect :cell/get,\ntest/yin/vm/heap_reclamation_test.cljc:378:                                       (module/make-effect :cell/get\ntest/yin/vm/heap_reclamation_test.cljc:390:            survives collections at every allocation and reads back\"\ntest/yin/vm/heap_reclamation_test.cljc:456:(deftest two-runs-collect-identically-test\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat > /private/tmp/py-provenance-tests.txt <<'EOF'\n\n\n(def \"'^:private provenance-donor-source\n  \"(defn forge [e condition] (cell/new (assoc (cell/get e) :py/retained-condition condition)))\n   (defn clone [e] (cell/new (cell/get e)))\n   (defn overwrite [e condition]\n     (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition)) e))\")\n\n\n(defn- check-cell-provenance\n  [attack]\n  (let [donor (kit/publish-donor! :clojure provenance-donor-source)\n        source (str \"payload = None'\"\\\\n\\\"\n                    \\\"def attacked(f, condition):\\\\n    global payload\\\\n\\\"\n                    (if (= attack :forge)\n                      \\\"    payload = forge(Exception('fresh'), condition)\\\\n\\\"\n                      (str \\\"    try:\\\\n        f()\\\\n    except BaseException as e:\\\\n\\\"\n                           (if (= attack :clone)\n                             \\\"        payload = clone(e)\\\\n\\\"\n                             \\\"        payload = overwrite(e, condition)\\\\n\\\")))\n                    \\\"    raise payload\\\\n\\\"\n                    \\\"def attacked_payload():\\\\n    return payload\\\\n\\\")\n        call (fn [callee args]\n               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n        observation\n        (kit/guard-exceptions-form\n          [:python]\n          (list 'let\n                ['condition (list 'get (call {} []) :condition)\n                 'replacement (list 'assoc 'condition :probe/forged true)\n                 'injected\n                 (list 'cell/new\n                       (list 'assoc {} :yang.call/entry\n                             (list 'fn ['invocation]\n                                   (list (list 'get 'invocation :yang.call/raise)\n                                         'condition))))\n                 'result (call (kit/export-form :python \\\"attacked\\\")\n                               ['injected 'replacement])\n                 'payload (list 'get (call (kit/export-form :python \\\"attacked_payload\\\") [])\n                                :value)]\n                (kit/observation-map-form\n                  (cond->\n                    {:route (list 'get 'result :route)\n                     :transfers (list 'get 'result :transfers)\n                     :after (list 'get 'result :after)\n                     :reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n                     :original-forwarded (list '= 'condition (list 'get 'result :condition))\n                     :replacement-forwarded (list '= 'replacement (list 'get 'result :condition))}\n                    (not= attack :overwrite)\n                    (assoc :payload-identical\n                           (list '= 'payload (list 'get (list 'get 'result :condition)\n                                                    :yang.call/value)))))))\n        results (kit/run-exception-program\n                  donor (kit/compose-exception donor [\\\"forge\\\" \\\"clone\\\" \\\"overwrite\\\"]\n                                               :python source observation))\n        expected (cond-> {:route :raise :transfers 1 :after false\n                          :reason (if (= attack :overwrite)\n                                    :yang.call/not-callable :yang.call/thrown)\n                          :original-forwarded (= attack :overwrite)\n                          :replacement-forwarded false}\n                   (not= attack :overwrite) (assoc :payload-identical true))]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \\\"PYTHON-CELL-PROVENANCE\\\" attack backend actual)\n      (is (= expected actual) (str attack \\\" \\\" backend)))))\n\n\n(deftest \"'^:slow python-cell-forgery-test\n  (check-cell-provenance :forge))\n\n\n(deftest ''^:slow python-retained-clone-test\n  (check-cell-provenance :clone))\n\n\n(deftest ''^:slow python-retained-overwrite-test\n  (check-cell-provenance :overwrite))\nEOF\ncat /private/tmp/py-provenance-tests.txt >> test/yang/call/python_exception_test.clj'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
