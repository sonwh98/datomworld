hon_exception_test.clj\\nnew file mode 100644\\nindex 00000000..023e9f8e\\n--- /dev/null\\n+++ b/test/yang/call/python_exception_test.clj\\n@@ -0,0 +1,60 @@\\n+(ns yang.call.python-exception-test\\n+  \\\"Python boundary pins for ruling v2 R2/R3 + egress. Receivers and rethrows\\n+   are parsed source; malformed protocol delivery uses the shared boundary kit.\\n+   The focused local gate for the exception-py-r2r3 round: the python subset of\\n+   the shiva acceptance instrument, never a substitute for the full ledger.\\\"\\n+  (:require [clojure.test :refer [deftest is testing]]\\n+            [yang.call.exception-contract :as contract]\\n+            [yang.call.exception-legs :as legs]\\n+            [yang.call.exception-probes :as probes]))\\n+\\n+\\n+(defn- check-fixture\\n+  \\\"Run one python fixture isolated on all three vector VMs and assert its\\n+   compliant `:expected` value on each backend.\\\"\\n+  [id]\\n+  (let [fixture (first (filter #(= id (:id %)) contract/fixtures))]\\n+    (testing (str id)\\n+      (doseq [[backend actual] (probes/run-fixture fixture)]\\n+        (is (= (:expected fixture) actual) (str backend))))))\\n+\\n+\\n+(defn- check-leg\\n+  \\\"Run one directed source pair/scenario and assert `legs/expected` per VM.\\\"\\n+  [id]\\n+  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\\n+    (testing (str id)\\n+      (doseq [[backend actual] (legs/run-leg leg)]\\n+        (is (= (legs/expected leg) actual) (str backend))))))\\n+\\n+\\n+(deftest ^:slow python-foreign-reception-test\\n+  ;; R2: an otherwise-foreign payload is wrapped in a generated local\\n+  ;; ForeignException; an already-local exception is delivered unchanged.\\n+  (check-fixture :python/local-reception)           ; stays green\\n+  (check-fixture :python/foreign-reception)         ; R→G\\n+  (check-fixture :python/retained-foreign-lifetime) ; R→G\\n+  ;; The clojure→python typed reception and stored-wrapper rethrow legs.\\n+  (check-leg [:clojure :python :typed-catch])\\n+  (check-leg [:clojure :python :unchanged-rethrow])\\n+  (check-leg [:clojure :python :retained-lifetime]))\\n+\\n+\\n+(deftest ^:slow python-protocol-reception-test\\n+  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\\n+  ;; complete condition instead of collapsing into a bare TypeError.\\n+  (check-fixture :python/protocol-not-callable)\\n+  (check-fixture :python/protocol-invalid-invocation)\\n+  (check-fixture :python/protocol-unsupported-binding)\\n+  (check-fixture :python/saved-protocol-not-callable)\\n+  (check-fixture :python/saved-protocol-invalid-invocation)\\n+  (check-fixture :python/saved-protocol-unsupported-binding))\\n+\\n+\\n+(deftest ^:slow python-egress-sanity-test\\n+  ;; Egress forwards a retained generated exception's original condition and\\n+  ;; still produces the plain thrown condition for fresh/forged payloads.\\n+  (check-fixture :python/fresh-named)       ; stays green\\n+  (check-fixture :python/fresh-closure)     ; stays green\\n+  (check-fixture :python/binding)           ; stays green\\n+  (check-fixture :python/forged-retention)) ; stays green (R5: no source-writable forgery)\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-gg82jOZF' (errno=Operation not permitted)\\n2026-11-11 20:10:37.394 xcodebuild[61571:122690099]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 20:10:37.649 xcodebuild[61571:122690097] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\"Input/output error\\\". Using NSCachesDirectory instead.\\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\\ngit: error: couldn't create cache file '/tmp/xcrun_db-oYiNXzwz' (errno=Operation not permitted)\\n2026-11-11 20:10:38.455 xcodebuild[61588:122690134]  DVTFilePathFSEvents: Failed to start fs event stream.\\n2026-11-11 20:10:38.663 xcodebuild[61588:122690133] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \\\"Input/output error\\\". Using NSCachesDirectory instead.\\ndiff --git a/collab/exception-track/1794375661926-python-r2-kit-overlay-findings.md b/collab/exception-track/1794375661926-python-r2-kit-overlay-findings.md\\nnew file mode 100644\\nindex 00000000..e7bdf648\\n--- /dev/null\\n+++ b/collab/exception-track/1794375661926-python-r2-kit-overlay-findings.md\\n@@ -0,0 +1,125 @@\\n+Created-GMT: 2026-11-11T05:41:01.926963+00:00\\n+Coding-Agent: codex\\n+Session-ID: 01a1c90e-221e-7f11-8906-e490c6c6379a\\n+Branch: exception-py-r2r3\\n+Regression instrument: be87df74\\n+\\n+# Python r2: the acceptance overlay restored the baseline prelude\\n+\\n+The steward's red output is real. The saved acceptance inputs show why it differs\\n+from the clean branch: the overlay replaced the fixed prelude after checkout.\\n+No additional runtime change is justified by this reproduction. This round adds\\n+both an explicit injected-call pin and the exact Python batch path to the unit gate.\\n+\\n+## Exact divergence and evidence\\n+\\n+Read-only inspection of shiva's existing `~/ci/xtrack-py-logs/head` recorded\\n+`a396ae28ebba86d544dae9dc9578d2a48c11129a`. Its rc file recorded the 2928-second\\n+failing contract/pair run. Its `cmd2.log` contains the reported Python\\n+`:yang.call/thrown` / `:condition-identical false` output.\\n+\\n+However, `/tmp/xtrack-py.sh:9` (the saved launch script) extracts\\n+`~/ci/xtrack-py.tgz` AFTER checking out the branch. That archive contains one file:\\n+`src/cljc/yang/python/antlr/prelude.cljc`. The remote archive's file and the saved\\n+local archive's file have the same SHA-256. Both are byte-identical to the prelude\\n+at **4cfa609d**, before all three exception fixes. Remote modification times tie\\n+these inputs to the run: archive `2026-11-10T23:37:55Z`, launcher `23:38:08Z`,\\n+recorded HEAD `23:38:17Z`, final test log `2026-11-11T00:27:22Z`.\\n+\\n+| Content | Prelude SHA-256 |\\n+| --- | --- |\\n+| Remote and local xtrack-py overlay; git 4cfa609d | `78c406307a7464d9a64336b5bf15af7bc75afe84323cb7c1111fd6ae42a5ad80` |\\n+| Git a396ae28, 04cb7887, and this clean branch | `dd004ce5d21a6cf51c07869fe26cc2cee16162df0a6f20802c3f4c4dec87354d` |\\n+\\n+The archived prelude has no `ForeignException`, `py/condition-exception`, or\\n+`py/retained-condition`. Its exact loss points are:\\n+\\n+- `prelude.cljc:1046`: protocol reception creates a fresh `TypeError`, dropping\\n+  the incoming condition.\\n+- `prelude.cljc:912`: public egress unconditionally constructs a fresh\\n+  `:yang.call/thrown` condition around that exception.\\n+- `prelude.cljc:1045`: otherwise-foreign thrown payloads are raised raw, so the\\n+  foreign-reception fixture cannot receive a local ForeignException.\\n+\\n+The clean branch already repairs these paths at current `prelude.cljc:917`,\\n+`:1051`, and `:1061`: generated local exceptions retain the complete condition in\\n+an identity-owned slot outside source-writable attributes; egress forwards that\\n+retained condition. Fresh/forged exceptions still produce fresh thrown conditions.\\n+\\n+## What the first gate missed\\n+\\n+There was no weaker reason/identity assertion in the original protocol pins:\\n+`check-fixture` already compares each full compliant expected map, including\\n+`:reason` and `:condition-identical`, via `probes/run-fixture`.\\n+The old gate did isolate fixtures rather than use acceptance's batched\\n+`probes/run-frontend`. The new batch pin closes that coverage difference. The\\n+confirmed disagreement is caused by different prelude bytes, which a HEAD-only\\n+check does not detect.\\n+\\n+## Changes and verification\\n+\\n+`be87df74` is the requested standalone regression-instrument commit. It adds:\\n+\\n+- A callable cell built exactly like `exception-probes/injected`, delivering a\\n+  validation-generated not-callable condition through parsed Python `receive`\\n+  with bare re-raise. Reason and guest condition identity are asserted.\\n+- The acceptance test's exact `probes/run-frontend :python` batch. Every Python\\n+  fixture and all three backends must be present; every full expected map is\\n+  asserted. Both pins print their guest-side observations for review.\\n+\\n+The new pin passed immediately on the clean branch. Using the archived baseline\\n+prelude instead reproduced exactly `{:reason :yang.call/thrown,\\n+:condition-identical false}` on register, semantic, and stack: three assertion\\n+failures, with no operational errors. This validates the instrument against the\\n+actual shipped acceptance content, rather than inventing a failure in fixed code.\\n+\\n+No runtime, type builtin, shared prelude, or scanner golden changed. Scanner\\n+regeneration is therefore unnecessary. No local exception-contract-test or\\n+Node/Dart lane ran. Existing shiva artifacts were read; no remote test was started.\\n+\\n+| Gate | Result |\\n+| --- | --- |\\n+| Clean python-exception-test | 5 tests / 105 assertions / 0 failures / 0 errors |\\n+| Shared four namespaces | 20 tests / 325 assertions / 0 failures / 0 errors |\\n+| Same copied pin with archived acceptance prelude | 1 test / 4 assertions / 3 failures / 0 errors (expected red) |\\n+| Kondo, changed test namespace | 0 errors / 0 warnings |\\n+\\n+Focused clean command:\\n+\\n+```sh\\n+clj -M:test -n yang.call.python-exception-test\\n+```\\n+\\n+Shared command:\\n+\\n+```sh\\n+clj -M:test -n yang.call.exception-source-test -n yang.python.antlr.source-call-test -n yang.python.antlr.call-entry-test -n yang.php.antlr.cst-test\\n+```\\n+\\n+Logs: `/tmp/exception-py-r2-parity.log`, `/tmp/exception-py-r2-shared.log`,\\n+`/tmp/exception-py-r2-overlay.log`. The archived prelude is used only through a\\n+separate temporary classpath; it never replaces the worktree file. A temporary\\n+single-test namespace calls the new pin's exact test body. JVM jobs run serially\\n+and detached with nohup.\\n+\\n+## Claims for the steward's clean remote rerun\\n+\\n+All 13 Python fixtures (39 backend observations) pass locally through the exact\\n+acceptance batch. The eight formerly red fixture claims are:\\n+\\n+- `:python/foreign-reception`\\n+- `:python/retained-foreign-lifetime`\\n+- `:python/protocol-not-callable`\\n+- `:python/protocol-invalid-invocation`\\n+- `:python/protocol-unsupported-binding`\\n+- `:python/saved-protocol-not-callable`\\n+- `:python/saved-protocol-invalid-invocation`\\n+- `:python/saved-protocol-unsupported-binding`\\n+\\n+The isolated pins also preserve the three clojure-to-python typed-catch,\\n+unchanged-rethrow, and retained-lifetime legs. These are local evidence claims;\\n+the authoritative ledger remains for the steward's remote verification.\\n+\\n+Rerun the committed branch with **no overlay** (`rverify.sh` files-list argument\\n+`-`). Verify a clean working tree and the fixed prelude hash above, rather than\\n+HEAD alone. The complete contract suite belongs to that remote rerun.\\ndiff --git a/test/yang/call/python_exception_test.clj b/test/yang/call/python_exception_test.clj\\nindex 023e9f8e..3766d933 100644\\n--- a/test/yang/call/python_exception_test.clj\\n+++ b/test/yang/call/python_exception_test.clj\\n@@ -4,6 +4,7 @@\\n    The focused local gate for the exception-py-r2r3 round: the python subset of\\n    the shiva acceptance instrument, never a substitute for the full ledger.\\\"\\n   (:require [clojure.test :refer [deftest is testing]]\\n+            [yang.call.conformance :as kit]\\n             [yang.call.exception-contract :as contract]\\n             [yang.call.exception-legs :as legs]\\n             [yang.call.exception-probes :as probes]))\\n@@ -58,3 +59,50 @@\\n   (check-fixture :python/fresh-closure)     ; stays green\\n   (check-fixture :python/binding)           ; stays green\\n   (check-fixture :python/forged-retention)) ; stays green (R5: no source-writable forgery)\\n+\\n+\\n+(deftest ^:slow python-kit-parity-test\\n+  ;; Match exception-probes/protocol-condition and injected exactly: the\\n+  ;; refusal is produced by public validation, then delivered by a callable\\n+  ;; cell's raise exit through a parsed Python f() and bare re-raise.\\n+  (let [donor (kit/publish-donor! :python contract/boundary-source)\\n+        source \\\"def receive(f):\\\\n    try:\\\\n        return f()\\\\n    except BaseException as e:\\\\n        raise\\\\n\\\"\\n+        call (fn [callee args]\\n+               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\\n+        observation\\n+        (kit/guard-exceptions-form\\n+          [:python]\\n+          (list 'let\\n+                ['condition (list 'get (call {} []) :condition)\\n+                 'injected\\n+                 (list 'cell/new\\n+                       (list 'assoc {} :yang.call/entry\\n+                             (list 'fn ['invocation]\\n+                                   (list (list 'get 'invocation :yang.call/raise)\\n+                                         'condition))))\\n+                 'result (call (kit/export-form :python \\\"receive\\\") ['injected])]\\n+                (kit/observation-map-form\\n+                  {:reason (list 'get (list 'get 'result :condition) :yang.call/reason)\\n+                   :condition-identical (list '= 'condition (list 'get 'result :condition))})))\\n+        results (kit/run-exception-program\\n+                  donor (kit/compose-exception donor [\\\"boundary_target\\\"]\\n+                                               :python source observation))]\\n+    (is (= #{:semantic :stack :register} (set (keys results))))\\n+    (doseq [[backend actual] results]\\n+      (println \\\"PYTHON-KIT-PARITY\\\" backend actual)\\n+      (is (= {:reason :yang.call/not-callable :condition-identical true} actual)\\n+          (str backend)))))\\n+\\n+\\n+(deftest ^:slow python-kit-batch-parity-test\\n+  ;; Acceptance uses run-frontend, which shares a task across observations.\\n+  ;; Isolated run-fixture pins alone cannot establish that batch path.\\n+  (let [fixtures (filter #(= :python (:frontend %)) contract/fixtures)\\n+        observations (probes/run-frontend :python)]\\n+    (is (= (set (map :id fixtures)) (set (keys observations))))\\n+    (doseq [{:keys [id expected]} fixtures\\n+            :let [results (get observations id)]]\\n+      (is (= #{:semantic :stack :register} (set (keys results))) (str id))\\n+      (doseq [[backend actual] results]\\n+        (println \\\"PYTHON-KIT-BATCH\\\" id backend actual)\\n+        (is (= expected actual) (str id \\\" \\\" backend))))))\\n62:                     retains an imported module's image for reload\\n294:    [py/raise\\n302:                 (py/raise e))\\n383:                             (py/raise e))))\\n425:           (py/raise-new py.b/ValueError {:py/str \\\"generator already executing\\\"})\\n440:                 (py/raise-new py.b/RecursionError\\n507:         (if (= (get m 0) :throw) (py/raise (get m 1)) (get m 1))))]\\n518:             (py/raise v)\\n520:               (py/raise (py/call py.b/StopIteration\\n528:         (if (= tag :yield) (get o 1) (if (= tag :return) :py/stop (py/raise (get o 1))))))]\\n575:           (py/raise-new py.b/RuntimeError\\n580:               (py/raise (get o 1)))\\n618:           (if (= tag :return) (get o 1) (py/raise (get o 1))))))]\\n668:           (if (= (get o 0) :raise) (py/raise (get o 1)) :py/stop))))]\\n752:    [py/raise-new (fn [cls msg] (py/raise (py/make-exc cls msg)))]\\n753:    [py/type-error (fn [msg] (py/raise-new py.b/TypeError msg))]\\n802:    [py/exc-matches\\n821:           (py/raise-new py.b/UnboundLocalError\\n836:               (py/raise-new py.b/NameError\\n843:       (py/raise-new py.b/NotImplementedError\\n912:                   ;; A retained generated exception forwards its original\\n917:                   (let [retained (py/retained-condition e)]\\n919:                       (if (= retained :py/missing)\\n922:                         retained))))\\n1046:     ;; reachability of the exception retains the entire condition/payload.\\n1051:         (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition))\\n1053:    [py/retained-condition\\n1059:         (get (cell/get e) :py/retained-condition :py/missing)\\n1073:                     (py/raise\\n1082:                           (py/make-class \\\"ForeignException\\\" py.b/Exception)\\n1084:                   (py/raise\\n1146:    [py/attr-error (fn [name] (py/raise-new py.b/AttributeError (py/str name)))]\\n1324:             (py/raise-new py.b/OverflowError\\n1450:         (py/raise-new py.b/OverflowError\\n1457:             (py/raise-new py.b/ZeroDivisionError\\n1470:                   (py/raise-new py.b/ZeroDivisionError (py/str message))\\n1515:             (py/raise e))))]\\n1558:                   (py/raise-new\\n1570:               (py/raise-new\\n1607:           (py/raise-new py.b/ValueError {:py/str \\\"negative shift count\\\"})\\n1620:                 (py/raise-new py.b/ZeroDivisionError\\n1624:               (py/raise-new py.b/ZeroDivisionError\\n1630:                   (py/raise-new py.b/OverflowError message)\\n1634:                       (py/raise-new py.b/OverflowError message)))))))\\n1804:             (py/raise-new py.b/IndexError\\n1818:           (py/raise (let [e (py/make-instance py.b/MemoryError)]\\n1821:             (py/raise-new py.b/ValueError\\n1831:               (py/raise-new py.b/OverflowError\\n1991:               (py/raise-new py.b/NotImplementedError\\n1996:           (py/raise-new py.b/NotImplementedError\\n2069:         (py/raise-new py.b/NameError\\n2084:           (py/raise-new py.b/NameError\\n2142:           (py/raise-new py.b/ValueError {:py/str \\\"slice step cannot be zero\\\"})\\n2173:         (py/raise-new py.b/NotImplementedError\\n2200:                     (py/raise-new py.b/KeyError k)\\n2237:           (py/raise-new py.b/ValueError {:py/str \\\"range() arg 3 must not be zero\\\"})\\n2269:           (py/raise-new py.b/OverflowError\\n2352:                   (py/raise-new py.b/RuntimeError\\n2441:           (py/raise-new py.b/ValueError {:py/str \\\"not enough values to unpack\\\"})\\n2443:             (py/raise-new py.b/ValueError {:py/str \\\"too many values to unpack\\\"})\\n2451:           (py/raise-new py.b/ValueError {:py/str \\\"not enough values to unpack\\\"})\\n2565:                 (assoc {} :py/class (get c :name))\\n2814:       (py/raise-new\\n2861:         (py/raise-new py.b/ValueError\\n2865:           (py/raise-new\\n2880:             (py/raise-new\\n2910:       (py/raise-new\\n3015:                   (py/raise-new\\n3088:               (py/raise-new\\n3148:                     (fn [e] (do (py/modules-del! name) (py/raise e)))\\n3154:     ;; Execute the retained image with the original namespace. In\\n3164:               (py/raise-new py.b/ImportError {:py/str \\\"reload has no compiled module body\\\"})\\n3166:             (py/raise-new py.b/ImportError {:py/str \\\"reload module is not in sys.modules\\\"})))\\n3170:       (py/raise-new\\n3193:             (py/raise e))))]\\n3260:               (py/raise-new\\n3347:     (fn [msg] (py/raise-new py.b/ImportError msg))]\\n3361:                    :py/exception\\n3379:                    :py/exception\\n3406:                    :py/exception\\n3524:                                   (py/raise-new\\n3560:                                     (py/raise-new py.b/NotImplementedError\\ngit is /usr/bin/git\\npython3 is /usr/bin/python3\\nclojure is /opt/homebrew/bin/clojure\\nclojure is /opt/homebrew/bin/clojure\\n\",\"exit_code\":1,\"status\":\"failed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat docs/agents/build-n-test.md && cat deps.edn && sed -n '1,260p' test/yang/call/exception_probes.clj && sed -n '1,210p' test/yang/call/exception_contract.clj\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat docs/agents/build-n-test.md && cat deps.edn && sed -n '1,260p' test/yang/call/exception_probes.clj && sed -n '1,210p' test/yang/call/exception_contract.clj\\\"\",\"aggregated_output\":\"---\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\n---\\n\\n# BUILD & TEST\\n\\n## Commands\\n\\n```sh\\n# Tests (Babashka runner)\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\nbb test:slow         # Only the slow tests, on every lane\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\n# (dao.test-slow/guard \\\"name\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\n# under test/), so the non-slow tests inside those namespaces also run there.\\n# On Node, shadow also runs the test namespaces those nine require (about\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\n# not subsystems). On the many-core remote hosts see \\\"Remote test servers\\\" below for\\n# which lanes may overlap.\\n#\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\n# (or `clojure -M:test -i :slow -n <ns>`).\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\n# When a test fails, reproduce and fix it by running ONLY the failing test\\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01;\\n# for a fix branch, the previously-failing tests green IS the merge bar\\n# (owner ruling 2026-11-07; see Gate Ladder G0).\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\n# overlap lanes, see \\\"Remote test servers\\\" below).\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\nnpm test             # Node.js tests\\n\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\n                         # and the linker L5 Node reader that requires a module\\n                         # by name): `clojure -M:test` without it fails that test\\n```\\n\\n### Changed-only tests: `bb test:changed`\\n\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\nreach: the reverse require closure of the files changed since the\\nmerge-base with master, plus fixtures that mention a changed resource path,\\ntests that walk a changed tree, and each src file's `_test` by convention.\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\n(let-bound roots count), and a change under a root selects it. The three\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\nas for a change to the core everything requires (yin.vm engine,\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\\nand spawned programs that changed (target/yin-repl.js, Dart peers).\\n\\n### Sharded quick JVM feedback and change routing\\n\\n```sh\\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\\nbb test:routed                                 # Git change set, same base as test:changed\\nbb deps:npm                                    # Content-checked local npm ci\\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\\n```\\n\\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\\nthe JVM portion of G3. Without selection flags it selects every JVM test;\\n`--changed FILE...` or `--base REF` uses `affected/select` and\\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\\nsemantics. `--workers N` must be positive (default 4 on the laptop).\\n\\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\\n`affected/select-subsystems` and the same longest-prefix ownership rule as\\n`test:sub`. As in the shiva script below, currently unowned namespaces run\\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\\nPrerequisites are derived from the entire selected JVM reach and finish\\nserially before workers start; the Node REPL build prerequisite\\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\\n\\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\\nand `summary.edn`. Before execution it checks **set equality** between selected\\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\\nThe final summary totals tests, assertions, failures and errors and separates\\nJVM wall time from total time including selection/builds. A nonzero child exit,\\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\\nDry plans write namespace evidence but execute no builds or tests. An empty\\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\\n\\n`test:routed <changed-files...>` applies this priority table to the whole change\\nset, prints the exact dispatch, executes it and propagates its result:\\n\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Change class (first match wins)                                                              | Dispatch                                                              |\\n+==============================================================================================+=======================================================================+\\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\\n|                                                                                              | lint only                                                             |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\\n|                                                                                              | selection                                                             |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n\\nMixed changes take the widest matching route. Missing paths, an empty git change\\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\\nits zero exit is **not** a verification result. Documentation checks inspect\\nstaged and unstaged changes together against HEAD. Paths absent from\\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\\nexecutable examples or validate documentation links.\\n\\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\\nmeans the dispatched gate completed successfully, not that every landing gate\\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\\nand failed dispatches. Successful checked docs, selected tri-host, and full\\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\\nresults, so automation must inspect the scope as well as the exit code.\\n\\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\\ntri-host success: for foundation/compiler changes also run\\n`bb test:changed:cljs --changed <paths>` and\\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\\ndemo smoke checks and review/landing gates all remain required. Node and Dart\\nlanes retain their current commands. The original unsharded tasks remain\\navailable. **Individual tests may run on the laptop; suite-scale runs may\\nnot (owner ruling 2026-11-04).** A single failing test or one namespace\\nreproduces quickly and is fine locally. Everything suite-scale — subsystem\\nlane sets (G1), changed-set runs (G2), the full quick suite, the slow tier,\\n`bb test:all`, and `nightly.clj` — runs on the remote hosts: the suite has\\noutgrown the laptop. The slow tier is 52 long namespaces whose JVM\\nprocesses each multi-thread (test workers, JIT, GC threads sized by core\\ncount); four of them GC-thrashing at once drove a laptop load average over\\n100 on 2026-11-01 while making no progress (the remote hosts run this tier:\\njupiter 5,645 s at 12 workers, shiva comparable). Do not run another lane\\nset concurrently on the laptop either.\\n\\n#### Worktree-local prerequisite caches\\n\\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\\nrecorded helper/generated digests and runtime pins), the generator/cache source,\\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\\nremoved or corrupted outputs trigger a full generation, retaining the generator's\\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\\ninvalidate the complete-build stamp.\\n\\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\\nenvironment and worktree identity; it verifies the installed file tree before\\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\\nensure this dependency too. Direct `npm ci` is still available.\\n\\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\\nlock only after confirming its owning process died. Symlinked output parents\\nthat escape the worktree are refused. This is reuse **within one worktree**,\\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\\nstill require the existing worktree isolation/serialization rules; the cache\\ndoes not make overlapping builds and tests safe. Peer executables and shadow\\nbuilds themselves are not cached by this mechanism.\\n\\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\\nouter command **258.27 s**). The original `test:changed:clj` command completed\\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\\nrounds to whole seconds). The investigation's earlier unsharded command had\\ntimed out at 300 s without a summary. These are single-run observations, not\\na median/p95 claim or a replacement for tri-host landing verification.\\n\\n### Subsystem-first tests: `bb test:sub`\\n\\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\\nis by longest namespace prefix matching.\\n\\n```sh\\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\\nbb test:sub:clj <subsystem>...    # JVM lane alone\\nbb test:sub:cljs <subsystem>...   # Node lane alone\\nbb test:sub:cljd <subsystem>...   # Dart lane alone\\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\\n```\\n\\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\\n\\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\\n- **Infrastructure**: `dev`, `bench`\\n\\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:antlr`)\\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\\nselected namespaces and run automatically when needed.\\n\\n#### Gate Ladder (docs/design/test.subsystems.md)\\n\\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\\n   **Failure-reproduction rule (owner ruling 2026-11-01): when a test fails anywhere — a\\n   gate, the nightly, or a delegate report — reproduce and fix it by running ONLY the\\n   failing test, never the whole suite.** JVM: `clojure -M:test -n <ns>` (a single\\n   deftest: add `-v <ns>/<var-name>`). Node: `node target/node-tests.js --test=<ns>`\\n   (built by `bb build:yin-repl-node` first only if that test needs the Node REPL).\\n   Dart: `bb src/dev/cljd_agg.clj --only <ns>[/<test-name>]` (owner ruling\\n   2026-11-07: the focus rule runs the failing TEST, not the namespace —\\n   `NS/test-name` entries become flutter `--plain-name` filters so only the\\n   named deftests execute; fall back to bare `<ns>` only when the failing\\n   var inside the namespace is not yet known, and narrow as soon as it is).\\n   Fix against the failing test alone, re-run it green, then climb back up\\n   (G1 for the home subsystem, G2 for dependents).\\n   Dart bug-chases may set `DATOM_FAIL_FAST=1` (owner ruling 2026-11-07): the\\n   scoped run stops at the first failure so the report arrives in minutes instead\\n   of after the full scoped set. Gate runs never set it — the merge bar needs the\\n   complete pass/fail picture. All dart runs use `--reporter expanded`, which\\n   streams failure names and positions inline so an interrupted run still retains\\n   them (the nightly's compact reporter lost 7 failure names to its 30000s wall,\\n   2026-11-06).\\n   Merge bar for a fix branch (owner ruling 2026-11-07, sharpening the 2026-11-01\\n   ruling): when the work is fixing already-failing tests, the previously-failing\\n   tests re-run green IS the merge bar — a fix branch merges on that alone; the\\n   G1/G2 climb applies to new feature slices, not to fixes. The full suite still\\n   gets its end-to-end confirmation from the daily nightly (04:00 VN), which is\\n   what catches collateral damage, not a pre-merge suite run.\\n   Never reproduce or chase a failure with the full suite or the slow tier — the full\\n   suite is not a debugging tool, and running it locally for one failing test is the\\n   exact misuse that drove a laptop load average over 100 (2026-11-01). A failure that\\n   only reproduces under the full suite's concurrency is diagnosed with the suite's own\\n   logs (its per-shard/per-test output), not by re-running the suite repeatedly.\\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\\n4. **G3 Master (merged in place by the 2026-11-01 owner ruling)**: The landing gate\\n   for a change is the **tests that cover the feature being built** — `bb test:changed`\\n   (G2) already includes the reverse-require closure of the changed files, and a wide\\n   change still routes to the full quick lane. The complete suite is no longer a\\n   per-merge gate: it runs twice a day on the remote hosts (see \\\"Cadence\\\" below), so a\\n   break is caught within hours without charging every merge ~400 minutes of slow tier.\\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge\\n   (`bb test:slow` or `bb test:all`), at each phase boundary of a multi-phase track\\n   (owner decision 2026-10-12), and implicitly twice daily by the scheduled run below.\\n   G0 to G3 run the quick tier; G4 runs the slow tier.\\n\\n\\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\\nslice L5) is two tests:\\n\\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\\n  processes over real loopback UDP. A JVM publisher with a key file\\n  publishes modules by name, and JVM and Node readers require them by\\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\\n  and checks each section 9 failure as data. Ports are ephemeral, and\\n  every wait is bounded. A run takes a few minutes. Run it alone with\\n  `clojure -M:test -n yin.repl.dht-process-test`, after\\n  `bb build:yin-repl-node`.\\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\\n  signed-name leg runs here, because no Dart `yin.repl.main` process\\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\\n  REPL.\\n\\n```sh\\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\\n\\n# ClojureDart\\nclj -M:clojuredart:cljd compile\\n\\n# Linting\\nclj -M:kondo --lint <path>\\n```\\n\\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\\n(greedy by file size; each imports its files and calls their `main`), runs\\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\\ndifferent namespaces share an isolate per shard. Failures stay attributable:\\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\\n\\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\\ncompile does not prune it when a source file is deleted or renamed. The\\naggregated lanes only run namespaces that still exist under `test/`, but a\\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\\nbefore relying on that to prove a deletion or rename took effect.\\n\\n## Test tiers: quick and slow\\n\\nThe suite has two tiers so that slow tests run less often than quick ones\\n(owner decision, 2026-10-12).\\n\\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\\n- **Slow tier:** the tagged deftests. `bb test:slow` or\\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\\n- **The tagging rule** is the one above (\\\"When to tag a test slow\\\"): a deftest that\\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\\n  in all (some were already tagged). Per-test times are not in the repo: measure again\\n  with the method below before changing the cut.\\n- **Cadence (owner ruling 2026-11-05):** a merge needs only the tests that cover the\\n  feature being built — the affected/dependent set from `bb test:changed` (or\\n  `bb test:sub <own> --slow` when the change touches slow-tagged code). The FULL suite,\\n  including the slow tier, runs **once a day at 04:00 Asia/Ho_Chi_Minh** as a\\n  disjoint lane pair (`src/dev/nightly.clj`): **jupiter takes the jvm lane, shiva\\n  takes node and dart** (each lane in its own clone; shiva publishes the run pin,\\n  jupiter reads it and falls back to its own current master as an advisory run).\\n  The measured long set is ~400 minutes of serial slow-tier work, so it cannot be\\n  a per-merge cost; a break is instead caught by the next scheduled run.\\n  The schedule is an **hourly cron plus a Vietnam-time guard** in\\n  `~/ci/nightly-cron.sh` on each host (the guard fires only at the 04 VN hour and\\n  `flock` skips a slot whose previous run is still active), so it is immune to the\\n  DST shifts of either host's local timezone. **The cron entries are currently\\n  REMOVED (owner instruction 2026-11-06)**: the wrappers remain installed on both\\n  hosts and re-arming is one crontab line each\\n  (`0 * * * * ~/ci/nightly-cron.sh >> ~/ci/nightly-cron.log 2>&1`). Logs:\\n  `~/ci/nightly-cron.log`; results: `~/ci/nightly-results/<stamp>/summary.txt`.\\n\\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \\\"Remote test\\nservers\\\" for how to run them):\\n\\n| Run | Time |\\n|---|---|\\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\\n\\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\\n\\n**How the per-test times were measured.** To time every deftest of a namespace alone,\\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\\notherwise swallows `-e`, and every JVM runs the whole suite):\\n\\n```sh\\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\\\"test\\\"]}}}' -M:t timing.clj\\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\\n# load) is paid by the first test in file order; check before tagging that test alone.\\n```\\n\\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\\nJVM test namespace under `test/`:\\n\\n```sh\\n#!/usr/bin/env bash\\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\ncd \\\"$1\\\" || exit 2\\nPAR=\\\"${2:-8}\\\"\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nOUT=\\\"$1/target-ci/shards\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\nts() { date +%H:%M:%S; }\\necho \\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\" | tee \\\"$OUT/summary.txt\\\"\\nnpm ci --silent >\\\"$OUT/npm.log\\\" 2>&1                   && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nbb build:yin-repl-node >\\\"$OUT/build-node.log\\\" 2>&1     && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nbb gen:antlr >\\\"$OUT/antlr.log\\\" 2>&1             && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nSUBS=\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\"\\n: > \\\"$OUT/covered.txt\\\"\\nfor s in $SUBS; do\\n  bb test:sub:list \\\"$s\\\" 2>/dev/null | awk \\\"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\"\\\\\\\");print}\\\" > \\\"$OUT/ns-$s.txt\\\"\\n  cat \\\"$OUT/ns-$s.txt\\\" >> \\\"$OUT/covered.txt\\\"\\n  echo \\\"$s $(wc -l < \\\"$OUT/ns-$s.txt\\\")\\\" >> \\\"$OUT/plan.txt\\\"\\ndone\\n# coverage: every JVM test namespace under test/ vs the union of the shards\\nfind test -type f \\\\( -name \\\"*_test.clj\\\" -o -name \\\"*_test.cljc\\\" \\\\) | sed -e \\\"s#^test/##\\\" -e \\\"s#\\\\.cljc\\\\?\\\\$##\\\" -e \\\"s#/#.#g\\\" -e \\\"s#_#-#g\\\" | sort -u > \\\"$OUT/all.txt\\\"\\nsort -u \\\"$OUT/covered.txt\\\" > \\\"$OUT/covered.sorted\\\"\\ncomm -23 \\\"$OUT/all.txt\\\" \\\"$OUT/covered.sorted\\\" > \\\"$OUT/ns-uncovered.txt\\\"\\necho \\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nrun_shard() {\\n  s=$1; f=\\\"$OUT/ns-$s.txt\\\"; [ -s \\\"$f\\\" ] || return 0\\n  args=(); while read -r n; do args+=(-n \\\"$n\\\"); done < \\\"$f\\\"\\n  t0=$(date +%s); clojure -M:test -e :slow \\\"${args[@]}\\\" >\\\"$OUT/$s.log\\\" 2>&1; rc=$?\\n  echo \\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\"^Ran \\\" \\\"$OUT/$s.log\\\" | tail -1)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n}\\nexport -f run_shard; export OUT; export -f ts\\nprintf \\\"%s\\\\n\\\" $SUBS uncovered | xargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_shard {}\\\"\\necho \\\"done $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n```\\n\\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\\n\\n```sh\\n#!/usr/bin/env bash\\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\ncd \\\"$1\\\" || exit 2\\nPAR=\\\"${2:-6}\\\"\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nOUT=\\\"$1/target-ci/slowtier\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\nrun_ns() {\\n  n=$1; t0=$(date +%s)\\n  clojure -M:test -i :slow -n \\\"$n\\\" > \\\"$OUT/$n.log\\\" 2>&1; rc=$?\\n  echo \\\"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \\\"^Ran \\\" \\\"$OUT/$n.log\\\" | tail -1)\\\" >> \\\"$OUT/summary.txt\\\"\\n}\\nexport -f run_ns; export OUT\\necho \\\"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\\\" > \\\"$OUT/summary.txt\\\"\\nxargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_ns {}\\\" < \\\"$HOME/ci/pertest-ns.txt\\\"\\necho \\\"done $(date +%H:%M:%S)\\\" >> \\\"$OUT/summary.txt\\\"\\n```\\n\\n## Remote test servers: shiva and jupiter\\n\\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\\nand `git`.\\n\\n| Host | Cores / RAM | Toolchain state (server snapshot checked 2026-10-11; repo selection comes from `mise.toml`) |\\n|---|---|---|\\n| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\\n| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). mise was moved off the apt package to the official user-local install (`~/.local/bin/mise`, 2026.11.2, owner action 2026-11-07) so both hosts share shiva's layout; toolchains in `~/.local/share/mise/installs/` were untouched. Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\\n\\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\\n\\n### Kill remote processes by exact PID, never by name pattern\\n\\nOn these hosts, kill a runaway nightly/lane process by its exact PID\\n(`pgrep -af <pattern>` only to LIST, then `kill <pid>`), never with\\n`pkill -f <string>` / `killall <name>`. Measured 2026-11-06: `pkill -f\\n\\\"nightly.clj\\\"` over SSH matched the invoking bash command line itself\\n(the pattern appears in `ps` output of the session carrying the kill),\\nterminating the SSH session mid-command — exit 255 with the kill\\nhalf-done. A name-pattern kill also races concurrent seats: another\\norchestrator's delegate process whose arguments embed the same string\\ndies with yours. If the PID from `pgrep -af` is ambiguous (several\\ncandidates), inspect with `ps -o pid,etime,args -p <pid>` first and kill\\nthe exact process; a session that dies under you is a symptom of this\\nmistake, not a host outage.\\n\\n### Get the code there: push to origin, never rsync\\n\\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\\nwould take about an hour), and an unanchored `--exclude build` also dropped source\\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\\nbranch from the laptop (a feature branch, never master), make one scratch clone on\\nthe host from its existing checkout (a local clone takes seconds), and fetch:\\n\\n```sh\\n# once per host: a separate scratch clone, not the working copy\\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\\n  URL=$(git remote get-url origin);\\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\\n  cd ~/ci/datomworld-<name>; git remote set-url origin \\\"$URL\\\";\\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\\n```\\n\\nTo test another branch later, fetch and check it out in the scratch clone with\\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\\nwas never pushed cannot be tested remotely.\\n\\n### A clone is only current if it updated from real master\\n\\nA scratch clone's `origin/master` ref is only as fresh as the place it fetches\\nfrom — and a clone made from another scratch clone inherits that clone's *stale*\\nrefs. Measured on shiva 2026-11-02: the `dg` clone was created from the `p4`\\nscratch clone, whose local `master` ref had not moved since October 26 because\\nevery lane on it ran detached off fetched branches; the `dg` lane's\\n`checkout origin/master` therefore produced a commit 436 commits behind real\\nmaster, and the G3 Dart leg honestly reported failures (the datagram fix) for a\\ntree that did not contain them.\\n\\nBefore any lane runs in a clone — every time, not just the first:\\n\\n```sh\\ncd ~/ci/datomworld-<name>\\ngit remote get-url origin          # must be the GitHub URL, never another scratch clone\\ngit fetch -q origin \\\"+refs/heads/*:refs/remotes/origin/*\\\"\\ngit checkout -q --detach origin/master   # or the lane's branch\\ngit merge-base --is-ancestor <the-commit-hash-you-pushed> HEAD && echo CURRENT\\n```\\n\\nIf `origin` is not GitHub, repoint it (`git remote set-url origin \\\"$URL\\\"`). If\\nthe `merge-base` check fails, the clone's bookkeeping lies: refetch, or delete\\nand recreate the clone from GitHub directly. Never trust a hash the clone\\nreports without comparing it to the hash your push from the laptop printed.\\n\\n### Activate the toolchain in the right order\\n\\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\\ninto the clone:\\n\\n```sh\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\\ncd ~/ci/datomworld-<name>\\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\\nmise install                                    # install versions selected by this checkout's mise.toml\\neval \\\"$(mise env -s bash)\\\"                       # puts the repo-selected tools on PATH\\nmise current flutter                            # verify the selected Flutter version\\n```\\n\\nActivating mise before the `cd` and `mise trust` leaves the repo-selected tools\\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \\\"Can't\\nfind flutter on PATH\\\", and so does `bb build:yin-repl-peer`.\\n\\n### Which lanes may overlap (reconciling the one-lane-set rule)\\n\\n\\\"One lane set at a time\\\" and \\\"one Dart lane at a time\\\" are per-machine rules about\\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\\n`test.subsystems.md` section 5 item 6 says the same (\\\"on one machine where\\navoidable\\\"). The laptop additionally never runs the slow tier or the nightly\\ndriver (see the sharded-lane section) — a full slow tier there reached a load\\naverage over 100 on 2026-11-01; the remote hosts own that tier. On shiva (24 cores) and jupiter (48) the cores are not the limit, so\\nlanes may overlap, with these limits:\\n\\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\\n  by the design's own reasoning (\\\"each worktree owns its own `cljd-out`\\\"), not yet\\n  verified by a measured run.\\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\\n  JVM lane only reads `target/yin-repl.js`.\\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\\n- **Different branches in different clones** are independent, so two branches may\\n  run on one host if its cores and RAM allow (62 GB each).\\n- Do not treat this as permission to overlap lanes on the laptop.\\n\\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\\nthis rule was written down; its results are advisory until repeated with a\\nseparate Dart clone.\\n\\n**The nightly driver now enforces this by construction.** `src/dev/nightly.clj`\\n(2026-11-03, kimi-reviewed) runs a multi-lane invocation as one concurrent\\nfuture per lane, each in its OWN clone — jvm keeps the primary clone, node\\nand dart get `<primary>-node` / `<primary>-dart`. The pinned SHA is resolved\\nonce and checked out in every lane clone; a cache-warm pass\\n(`clojure -P -M:test:cljs:clojuredart:cljd`) runs in the primary before\\nfan-out so two clones never fetch into the shared `~/.m2`/`~/.gitlibs`\\nconcurrently; per-lane summaries are appended serially after the futures\\njoin. A single-lane invocation (jupiter's `jvm`) is unchanged: one clone,\\none serial lane. Both hosts run the same driver — the lane list on the\\ncommand line (shiva: `node,dart` + `--pin-publish`; jupiter: `jvm` +\\n`--pin-read --pin-peer shiva...`) is the only difference.\\n\\n### Scratch-clone first-run gaps (two measured sightings)\\n\\nA fresh scratch clone needs two things the lane runner does not yet set up\\nitself; until the runner heuristic is fixed, do them by hand before the\\nfirst lane:\\n\\n1. **`npm install`** — the Node tests require npm deps (`@noble/hashes` was\\n   the measured miss on shiva 2026-11-02: the cljs lane ran but the\\n   node-tests bundle died with `MODULE_NOT_FOUND`).\\n2. **`bb gen:antlr`** — the `prerequisites` heuristic in\\n   `src/dev/affected.clj` decides `:gen:antlr` from the JVM lane's reach\\n   only (\\\"ANTLR classes are JVM only\\\" — stale: python keeps multi-target\\n   parsers), so a cljs/cljd-only selection that reaches\\n   `yang.python.antlr.parser` (e.g. `bb test:sub:cljs yang.base` via\\n   `yin.repl.frontends`) skips the generation and the shadow build dies on\\n   the missing `Python3Lexer.js`. Sighted independently on the p4 lane\\n   (PhpLexer ClassNotFoundException) and the yang.base cljs lane\\n   (2026-11-02). The lane-runner fix landed 2026-11-03 (eb27fd47).\\n\\n### Merge verification: run the suite from a fresh clone, not the authoring worktree\\n\\nA merge whose new code reads a file that was never `git add`ed passes in\\nthe authoring worktree (the untracked file is still on disk there) and\\nbreaks everywhere else. Measured: the H3-0 landing (1fd7236b) merged\\n`kernel-declarations` — which reads\\n`yang/latte_oracle/slice9_declarations.edn` via `io/resource` at load —\\nwithout the file (untracked in the authoring worktree); master's\\nyang.latte-oracle-test died at load until the file was restored\\n(2026-11-04). Before landing any merge that adds code reading a new\\nresource, or after any merge at all when in doubt:\\n\\n```sh\\ngit worktree add /tmp/merge-verify <merge-commit>\\ncd /tmp/merge-verify && <the touched subsystem's focused test>\\ngit worktree remove /tmp/merge-verify\\n```\\n\\nA fresh clone/worktree has only committed files — a missing untracked\\nresource fails there immediately.\\n\\n### Ledger commit hygiene: never commit a conflict marker\\n\\nThe append-only ledgers (`docs/agents/known-gaps.md`,\\n`orchestrator-logs/*.md`, `docs/agents/routing-status.md`) resolve rebase\\nand merge conflicts by the union rule, which means conflicts are common —\\nand a conflict marker that reaches a commit silently corrupts the record\\n(measured: the 2026-10-30 rebase landed a log with three committed\\n`<<<<<<<`/`>>>>>>>` markers and dropped records the union was supposed to\\nkeep; caught by the architect four rounds later). Before committing ANY\\nchange to a ledger file:\\n\\n```sh\\ngit diff --cached | grep -E '^\\\\+(<{7}|={7}$|>{7})' && echo CONFLICT-MARKERS-STAGED\\ngit grep -E '^(<{7}|={7}$|>{7})' -- docs/agents/known-gaps.md orchestrator-logs docs/agents/routing-status.md\\n```\\n\\nIf either hits, the commit stops until the union is redone. When resolving\\na ledger conflict, prefer regenerating the union from both sides' section\\nlists over hand-merging, and re-read the result against BOTH parents before\\nstaging.\\n\\n### The jolt J2 lane: run it with `--jobs` on the servers\\n\\nThe jolt lane's core mode (`bb src/dev/jolt_j2_lane.clj core [--jobs N]\\n[--only re] [--timeout-ms M]`) runs each test namespace as its own child jolt\\nprocess (own Chez VM, own native parser library load, own log under\\n`build/j2-logs/core/`), so the namespaces cannot corrupt one another — the\\nonly thing `--jobs N` overlaps is the waiting. The default is `jobs 1`\\n(strictly serial), which on jupiter makes the full ~179-namespace lane a\\n5-6-hour run.\\n\\nOn the servers, run it with `--jobs 16`:\\n\\n- jolt children are essentially single-threaded (the 16 MiB parse thread\\n  only burns during parses) and cost 1-2 GB each, so 16 concurrent children\\n  sit far inside jupiter's 48 cores / 62 GB and shiva's 24 / 62;\\n- the lane's wall time is dominated by a few long namespaces\\n  (`yin.repl.python-antlr-test` has an explicit 3-hour step,\\n  `yin.vm.semantic.safepoint-harness-test` needs one — see\\n  `step-timeout-ms` in `src/dev/jolt_j2_lane.clj`), so beyond ~16 workers\\n  the critical path is the longest child, not the count;\\n- **parallel is unproven until checked once**: the recorded lane evidence\\n  (J2 closure, the safepoint 60/265,225/0 pass) was all produced `jobs 1`.\\n  The first parallel run must be compared per-namespace against a serial\\n  baseline; any namespace that flips red gets one serial re-run to\\n  attribute before its evidence is trusted. Until that first comparison\\n  passes, keep `jobs 1` for anything whose verdict is timing-sensitive —\\n  timeout and wall-time measurements, native-memory/leak gates, and the\\n  merge-decision qualification runs.\\n\\nSuites that exceed the lane's default step budget are pinned in the lane's\\n`step-timeout-ms` map with their measured wall time; a namespace timing out\\nunder the default budget is a reason to measure it serially and add an\\nentry, not to re-run under the same bound.\\n\\n### The full run\\n\\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\\ntasks use (the `bb test` task runs them one after another), and records each\\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\\n\\n```sh\\n#!/usr/bin/env bash\\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (both hosts run all three lanes; a second clone for Dart is recommended)\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\nDART=\\\"${2:-}\\\"\\ncd \\\"$1\\\" || exit 2\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nLOG=\\\"$1/target-ci\\\"; mkdir -p \\\"$LOG\\\"\\nts() { date +%H:%M:%S; }\\necho \\\"start $(ts) $(git rev-parse --short HEAD)\\\" | tee \\\"$LOG/summary.txt\\\"\\nnpm ci --silent >\\\"$LOG/npm.log\\\" 2>&1               && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb build:yin-repl-node >\\\"$LOG/build-node.log\\\" 2>&1 && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb gen:antlr >\\\"$LOG/antlr.log\\\" 2>&1         && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb build:yin-repl-peer >\\\"$LOG/build-peer.log\\\" 2>&1 && echo \\\"dart peer built $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nlane() { name=$1; shift; s=$(date +%s); \\\"$@\\\" >\\\"$LOG/$name.log\\\" 2>&1; rc=$?\\n         echo \\\"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"; }\\nlane jvm  clojure -M:test -e :slow &\\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\\nif [ -n \\\"$DART\\\" ]; then                            # its own clone (own lib/cljd-out, build/)\\n  ( cd \\\"$DART\\\" && mise trust >/dev/null 2>&1 && eval \\\"$(mise env -s bash)\\\"\\n    bb build:yin-repl-peer >\\\"$LOG/build-peer-dart.log\\\" 2>&1\\n    lane dart bb src/dev/cljd_agg.clj ) &\\nfi\\nwait\\necho \\\"done $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\n```\\n\\n```sh\\nssh <host> 'tmux new-session -d -s ci-full \\\"bash -lc \\\\\\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\\\\\"\\\"'\\n```\\n\\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\\n`bb test:clj`. For the slow set use `-i :slow` (or `bb test:slow`); the slow C4\\nscanner row took about 11-19 minutes on the JVM and about 79 minutes on Node\\n(measured 2026-10-11).\\n\\n### Known differences from the laptop\\n\\n- **`dao.stream.datagram.dart-test/refusals-and-lifecycle-events` on Linux —\\n  MEASURED AND FIXED (2026-11-02).** The old entry inferred that \\\"a second UDP bind on\\n  a taken port behaves differently on Linux\\\"; confirmed, with the cause. Dart's\\n  `RawDatagramSocket.bind` defaults to `reuseAddress: true`, and **Linux honours\\n  `SO_REUSEADDR` for UDP**, so a second bind to a port a reuse-enabled socket already\\n  holds *succeeds* (`strace`: `SO_REUSEADDR=1` on both sockets, no `SO_REUSEPORT`, both\\n  kernel `bind()` calls succeed); macOS refuses with errno 48. The seam was correct\\n  throughout — given a genuinely exclusive holder (`reuseAddress: false`) it deposits\\n  `bind-failed` in ~10 ms with errno 98. The test asserted one host's binding policy\\n  rather than the contract, so it now binds its own exclusive blocker\\n  (`RawDatagramSocket.bind \\\"127.0.0.1\\\" 0 .reuseAddress false .reusePort false`) and\\n  points the seam at that port: the failure path is exercised on both hosts. Verified\\n  on shiva: the namespace passes 5/5.\\n- A JVM lane started before the Dart peer is built skips the Dart-peer tests with a\\n  printed notice. The script builds the peer first so they run.\\n- Both hosts run other work (a QEMU guest and rustdesk on shiva); idle load is\\n  under 1, but timings are not a clean benchmark.\\n\\n### The nightly full suite and the branch-testing rule (2026-10-30 owner ruling)\\n\\nOwner, verbatim: \\\"since the complete test can take a good 7-8hrs to run\\ncompletely, it should be schedule to run once a day at 3am. while\\nbranch/worktree test should only run test that are targeting code\\nchanges\\\" — and, clarifying the nightly's target: \\\"it should not be for\\nonly a worktree/branch. the nightly complete test should be for master.\\\"\\n\\nTwo tiers, by target and purpose:\\n\\n- **The nightly full suite runs MASTER ONLY** (`~/ci/nightly-cron.sh` on\\n  shiva and jupiter, hourly cron plus a 04:00 Vietnam guard and flock,\\n  documented under \\\"Cadence\\\" above; the driver fetches and checks out\\n  origin/master before anything runs). Every lane, across the host pair:\\n  the JVM full suite on jupiter, the full Node and Dart suites on shiva.\\n  Its results are a\\n  post-hoc integrity net for master, NOT a landing gate. Failures it\\n  finds route to fix rounds the next morning.\\n- **Branch/worktree testing runs only the namespaces that target the\\n  changed code** (the diff's own tests plus the surfaces the diff\\n  touches), one JVM per namespace, plus one cheap portable lane (Node)\\n  when cljc goldens or fixtures moved. Never the full tier on a branch:\\n  a branch gate needs the changed code proven, not the whole tree\\n  re-proven. A branch is never promoted by its own testing — the merge\\n  to master is what puts it under the nightly.\\n\\nAn orchestrator landing a slice cites the subset runs plus the gate\\nsign-off; the nightly catches what the subset could not see, and a red\\nnightly owns the follow-up.\\n\\n**The merge precondition (2026-10-30 owner ruling, restored 2026-10-31 —\\na dedup pass dropped this section along with a stale duplicate of the\\ntwo-tier policy; both stand):** before any merge into master, the\\n`dao.stream` tests must run and pass — dao.stream is what everything is\\nbuilt on. Concretely: `bb test:sub dao.stream` (the subsystem's tests,\\n`--slow` when the slice touches slow-guarded surfaces) is part of every\\nbranch gate regardless of which subsystems the diff's own changes\\nselect, because a change can break the foundation without touching it.\\nA red dao.stream blocks the merge until fixed or diagnosed as\\npre-existing by the owning seat.\\n\\n### Measured times (first runs, 2026-10-11, commit 84c7c9b7, all lanes concurrent)\\n\\nShiva, Dart lane: 1054 s (17.5 min) cold, with the JVM and Node lanes running beside\\nit, against about 9 minutes on the 8-core laptop run alone. Prerequisites (`npm ci`,\\nNode REPL, ANTLR) took about 30 s; the Dart peer 91 s. JVM and Node lane times are\\nnot recorded yet: fill them in from `summary.txt` after a completed run. Running the\\nlanes concurrently on one host did not make the Dart lane faster, so count on the\\nextra cores, and measure before relying on a speedup. (Historical record — the\\n\\\"free laptop\\\" comparison predates the 2026-11-04 ruling that suite-scale runs\\nbelong on the remote hosts.)\\n\\n### Jupiter verification run (2026-10-29, commit 7c0a078f, scratch clone, sequential lanes)\\n\\nFirst full tri-host verification of jupiter. Prerequisites (npm ci, Node REPL,\\nANTLR via `gen:antlr`, Dart peer) all succeeded; the stale 3.41.9 Flutter was\\nreplaced with 3.47.8 before the Dart lane. Results: **JVM quick tier\\n(`test:quick-sharded`, 12 workers) rc=0 in 702 s** (cold, every shard green);\\n**Node quick tier rc=0 in 4583 s** (all tests pass, but roughly 15x the\\nlaptop — route Node lanes to shiva; the laptop comparison is historical and\\nsuite-scale Node runs no longer belong there per the 2026-11-04 ruling);\\n**Dart quick tier\\nrc=1 in 1495 s with the ONLY failure the documented known Linux-only red**\\n(`dao.stream.datagram.dart-test/refusals-and-lifecycle-events`, same\\ntaken-port/bind-failed signature recorded above). Routing summary: jupiter\\nis the preferred JVM/sharding box (48 cores); Node stays off it when wall\\ntime matters; Dart works on either host. Timings are single cold runs, not\\nmedians, and two foreign QEMU guests idle on the host.\\n\\nOne exception to the concurrency above: never run two lanes that both trigger\\n`gen:antlr` (the quick `test:cljs`/`test:cljd` tasks) in the SAME worktree at the\\nsame time — they race on `build/antlr` and `lib/antlr` and fail with\\n\\\"Patch does not apply\\\" or \\\"Generated sources differ from the recorded digests\\\".\\nRun them sequentially, or in separate clones (as the slow-tier harness does).\\nThe fix after a collision is `rm -rf build/antlr lib/antlr` and a rerun; the\\ngenerator is not idempotent over an already-patched tree. Corroborated twice in\\none week (the M3 round and the C3 completion round, 2026-10-18).\\n\\n### Remote agent execution (delegate CLIs on shiva and jupiter)\\n\\nOwner relay, 2026-10-24: the delegate agent CLIs — `claude`, `codex`, `glm` —\\nare installed and usable **on the remote hosts themselves**, not only from the\\norchestrator's laptop. This generalizes this section from \\\"run tests remotely\\nover SSH\\\" to \\\"delegate whole work agents remotely\\\": a heavy implementation or\\nverification leg (test lanes, native builds, fault-injection runs, multi-hour\\nsuites) can be executed by a delegate agent running on the server, keeping the\\norchestrator's laptop unloaded.\\n\\nThe pattern (composed from the rules above plus the delegate-invocation\\nreference):\\n\\n1. **Land the branch on origin first** (push from the laptop; never rsync) and\\n   prepare the scratch clone per \\\"Get the code there\\\".\\n2. **Start a named tmux session** for the task; run the agent inside it with\\n   the toolchain activated *inside* the tmux command (`eval \\\"$(mise env -s\\n   bash)\\\"` after the `cd` — the non-interactive SSH shell does not have it).\\n   A fresh clone hits mise's interactive trust prompt, which blocks the whole\\n   session until answered via `tmux send-keys`; pre-empt it with `mise trust`\\n   inside the same command.\\n3. **The remote agent works in the clone**: implement, build, run lanes,\\n   write its findings artifact — the same brief form as any delegate dispatch\\n   (role template, bounded file ownership, deliverable path), just executing\\n   on the host. Long jobs survive SSH drops because of tmux.\\n4. **The orchestrator polls detached files, never the pane** (pane captures\\n   carry control characters that make output look empty): rc files, summary\\n   logs and `ls *.flag` sentinels written by the run.\\n5. **Division of labor**: bookkeeping and polling are orchestrator SSH\\n   one-liners; execution belongs to the remote agent. Do not run heavy lanes\\n   from the orchestrator's laptop while a remote agent owns the same gate.\\n6. **Same trust rules as any delegate**: remote execution does not waive\\n   Workflow steps 6–7 of the orchestrator role — artifacts are verified, and\\n   review before commit applies to remote-produced work identically.\\n   Session-ID capture and resume rules from the delegate-invocation reference\\n   apply per host (each host's `~/.claude`, `~/.codex` store is its own).\\n\\nKnown state: `claude` and `codex` verified working on shiva (2026-10-24, the\\njolt canonical-fixes verification ran there); `glm` reported available by the\\nowner on both hosts, not yet exercised. Both hosts are toolchain-verified for\\nthe full tri-host suite (jupiter verified 2026-10-29 — see Measured times;\\nits 3.41.9 Flutter was replaced with 3.47.8, and model availability per\\nhost is governed by `routing-status.md`, not this file).\\n\\n## Testing Philosophy & TDD\\n\\nWrite tests before implementing features (TDD).\\n\\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\\n\\nWhen implementing a feature or fix:\\n1. **Red phase**: Write the test first — define what should happen.\\n2. **Green phase**: Implement the minimum code to pass the test.\\n3. **Refactor phase**: Refactor if needed while keeping tests green.\\n\\nThis ensures code is testable by design and implementation matches actual requirements.\\n\\n## Debugging Malformed CLJ / EDN / CLJS\\n\\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\\n\\n1. **Run clj-kondo first**:\\n   ```sh\\n   clj -M:kondo --lint path/to/file.cljs\\n   ```\\n\\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\\n\\n3. **Fix one bracket at a time, re-run checker after each fix**:\\n   Common patterns:\\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\\n   - Both can coexist while total bracket count is zero-sum.\\n\\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\\n{:deps {org.clojure/core.async {:mvn/version \\\"1.8.741\\\"}\\n        org.clojure/tools.reader {:mvn/version \\\"1.5.0\\\"}\\n        ring/ring {:mvn/version \\\"1.14.1\\\"}\\n        com.cognitect/transit-clj {:mvn/version \\\"1.0.333\\\"}\\n        org.replikativ/boring {:mvn/version \\\"0.1.30\\\"}\\n        com.datomic/peer {:mvn/version \\\"1.0.7364\\\"}\\n        org.postgresql/postgresql {:mvn/version \\\"42.7.3\\\"}\\n        org.clojure/data.json {:mvn/version \\\"2.5.0\\\"}\\n        http-kit/http-kit {:mvn/version \\\"2.8.0\\\"}\\n        org.jsoup/jsoup {:mvn/version \\\"1.18.3\\\"}\\n        instaparse/instaparse {:mvn/version \\\"1.5.0\\\"}\\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\\n        org.antlr/antlr4-runtime {:mvn/version \\\"4.13.2\\\"}\\n        criterium/criterium {:mvn/version \\\"0.4.6\\\"}\\n        io.github.rctcwyvrn/blake3 {:mvn/version \\\"1.3\\\"}\\n        stigmergy/chp {:mvn/version \\\"0.1.0-SNAPSHOT\\\"\\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\\n :cljd/opts {}\\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\\n :paths [\\\"src/clj\\\" \\\"src/cljc\\\" \\\"src/cljs\\\" \\\"src/cljd\\\"\\n         \\\"build/antlr/python3/classes\\\" \\\"build/antlr/php/classes\\\"\\n         \\\"build/antlr/typescript/classes\\\"]\\n :aliases {:clean {:extra-paths [\\\"src/dev\\\"]\\n                   :exec-fn clean/clean}\\n           :profile-btree {:extra-paths [\\\"src/dev\\\"]\\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\\n                                        {:mvn/version \\\"0.3.0\\\"}}\\n                           :main-opts [\\\"-m\\\" \\\"btree-bench\\\"]}\\n           :test {:extra-paths [\\\"test\\\"]\\n                  :extra-deps {io.github.cognitect-labs/test-runner\\n                               {:git/tag \\\"v0.5.1\\\" :git/sha \\\"dfb30dd\\\"}\\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\\n                               ;; the differential oracle for the yang.clojure gap\\n                               ;; program (pinned; MIT; dependency-free)\\n                               latte-kernel/latte-kernel\\n                               {:git/url \\\"https://github.com/latte-central/latte-kernel\\\"\\n                                :git/sha \\\"86fca0d1d054af005cb37395eae04500d45e6279\\\"}}\\n                  ;; The guest recursion limit allows depth that needs more than the\\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\\n                  ;; before it can raise Python's RecursionError, so the same tests\\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\\n                  ;; the conformance compositions) overflow smaller stacks in\\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\\n                  ;; the 4m minimum for the prelude recursion rows still holds)\\n                  :jvm-opts [\\\"-Xss64m\\\"]\\n                  :main-opts [\\\"-m\\\" \\\"cognitect.test-runner\\\"]\\n                  :exec-fn cognitect.test-runner.api/test}\\n           :nREPL {:extra-paths [\\\"test\\\"]\\n                   :extra-deps {nrepl/nrepl {:mvn/version \\\"1.0.0\\\"}\\n                                cider/cider-nrepl {:mvn/version \\\"0.58.0\\\"}}\\n                   :main-opts [\\\"-m\\\" \\\"nrepl.cmdline\\\" \\\"--middleware\\\" \\\"[cider.nrepl/cider-middleware]\\\"]}\\n           :cljs {:extra-paths [\\\"test\\\" \\\"src/dev\\\" \\\"build/antlr/python3/js\\\" \\\"build/antlr/php/js\\\"]\\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \\\"3.3.5\\\"}\\n                               reagent/reagent {:mvn/version \\\"2.0.1\\\"}\\n                               com.cognitect/transit-cljs {:mvn/version \\\"0.8.280\\\"}}}\\n           :dev {:extra-paths [\\\"src/dev\\\"]\\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \\\"3.3.5\\\"}\\n                              cider/cider-nrepl {:mvn/version \\\"0.58.0\\\"}\\n                              reagent/reagent {:mvn/version \\\"2.0.1\\\"}\\n                              com.cognitect/transit-cljs {:mvn/version \\\"0.8.280\\\"}\\n                              ;; benchmark baseline + psset-fixtures\\n                              ;; generator only; production uses\\n                              ;; dao.data.btree\\n                              persistent-sorted-set/persistent-sorted-set\\n                              {:mvn/version \\\"0.3.0\\\"}}\\n                 :jvm-opts [\\\"-Dconfig=config.clj\\\"]}\\n           ;; The one ClojureDart pin. Compose it with the build aliases:\\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\\n           :clojuredart {:extra-deps {sonwh98/clojuredart\\n                                      {:git/url \\\"https://github.com/sonwh98/ClojureDart.git\\\"\\n                                       :sha \\\"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\\\"}\\n                                      }}\\n           :cljd {:extra-paths [\\\"test\\\"]\\n                  :main-opts [\\\"-m\\\" \\\"cljd.build\\\"]\\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \\\"2.8.0\\\"}}\\n                    :jvm-opts [\\\"-Dconfig=config.clj\\\"]\\n                    :main-opts [\\\"-m\\\" \\\"world.server\\\"]}\\n           :clj-yin-repl {:main-opts [\\\"-m\\\" \\\"yin.repl.main\\\"]}\\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\\n           ;; listed for audited portable namespaces only (its JVM namespaces\\n           ;; are selected away by :jolt reader branches, never loaded). No\\n           ;; generated Java parser classes, no JS/Dart roots, and no\\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\\n           ;; needs one.\\n           :jolt {:replace-paths [\\\"src/jolt\\\" \\\"src/cljc\\\" \\\"src/clj\\\"]\\n                  :replace-deps {}}\\n           :jolt-yin-repl {:main-opts [\\\"-m\\\" \\\"yin.repl.main\\\"]}\\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\\n           :jolt-test {:extra-paths [\\\"test\\\" \\\"src/dev\\\"]}\\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\\n           :jolt-diag {:extra-paths [\\\"src/dev/jolt_diag\\\"]}\\n           :cljs-yin-repl\\n           {:extra-paths [\\\"test\\\" \\\"src/dev\\\"]\\n            :extra-deps {thheller/shadow-cljs {:mvn/version \\\"3.3.5\\\"}\\n                         reagent/reagent {:mvn/version \\\"2.0.1\\\"}\\n                         com.cognitect/transit-cljs {:mvn/version \\\"0.8.280\\\"}}\\n            :main-opts [\\\"-m\\\" \\\"yin.repl.node-runner\\\"]}\\n           :fmt {:extra-paths [\\\"src/dev\\\"]\\n                 :exec-fn tasks/fix-all}\\n           ;; Build-time generation of the grammars-v4 Python3 parser.\\n           ;; The tool version must equal the antlr4-runtime above.\\n           :antlr-gen {:extra-paths [\\\"src/dev\\\"]\\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \\\"4.13.2\\\"}}\\n                       :main-opts [\\\"-m\\\" \\\"yang-antlr-gen\\\"]}\\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \\\"2026.01.19\\\"}}\\n                   :main-opts [\\\"-m\\\" \\\"clj-kondo.main\\\"]}\\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\\n           ;; dependency. Backend deps/config are pinned separately once selected.\\n           :oracle {:extra-paths [\\\"src/dev\\\" \\\"test\\\"]\\n                    :extra-deps {com.datomic/client-api {:mvn/version \\\"1.0.69\\\"}\\n                                 ;; oracle backend: Datomic Local, in-process,\\n                                 ;; run in docker/oracle (dev-scope only)\\n                                 com.datomic/local {:mvn/version \\\"1.0.301\\\"}}}\\n           :dbg {:extra-paths [\\\"test\\\"]\\n                 :main-opts [\\\"-m\\\" \\\"debug-cljd\\\"]\\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\\n           :cljd-yin-repl {:main-opts [\\\"-m\\\" \\\"yin.repl.runner\\\"]}\\n           :cljd-yin-repl-build\\n           {:main-opts  [\\\"-m\\\" \\\"cljd.build\\\"]\\n            :cljd/opts  {:kind       :dart\\n                         :main       yin.repl.main\\n                         :output-dir \\\"build/yin-repl\\\"\\n                         :output-to  \\\"build/yin-repl/yin_repl.dart\\\"}}\\n           :dep-graph {:extra-paths [\\\"src/dev\\\"]\\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \\\"1.5.0\\\"}}\\n                       :main-opts [\\\"-m\\\" \\\"dep-graph\\\"]}}}\\n\\n\\n;; clj -X:fmt\\n\\n;; clj -M:nREPL\\n\\n;; clj -M:nREPL:server\\n;; clj -M:test\\n;; clj -M:test -n yin.vm-literal-test\\n;; clj -M:test -n yin.vm-continuation-test\\n;; clj -M:test -n yin.repl.python-antlr-test\\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\\n\\n;; clj -X:clean\\n\\n;; npx shadow-cljs compile test && node target/node-tests.js\\n;; npx shadow-cljs release demo\\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\\n\\n\\n;; mise exec -- clj -M:clojuredart:cljd watch \\n;; mise exec -- flutter run \\n\\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\\n;; flutter emulators --launch Pixel_3_API_34\\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \\n;; emulator -list-avds\\n\\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\\n;;  clj -M:dep-graph --filter \\\"yin.*\\\"   # only yin namespaces\\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine\\n(ns yang.call.exception-probes\\n  \\\"Boundary materialization of exception-contract/fixtures. Synthetic entries\\n   occur ONLY for delivery of boundary-generated conditions; source pairs\\n   live in exception-legs. Every receiver/rethrow body is parsed source.\\\"\\n  (:require [yang.call.conformance :as kit]\\n            [yang.call.exception-contract :as contract]))\\n\\n\\n(defn- read-export\\n  [frontend name]\\n  (kit/export-form frontend name))\\n\\n\\n(defn- call\\n  [callee args]\\n  (kit/boundary-call-form callee (kit/observation-vector-form args) []))\\n\\n\\n(def ^:private boundary-donor\\n  (delay (kit/publish-donor! :python contract/boundary-source)))\\n\\n\\n(defn- transfer-summary\\n  [result]\\n  {:transferred (list '= (list 'get result :route) :raise)\\n   :once (list '= 1 (list 'get result :transfers))\\n   :after (list 'get result :after)})\\n\\n\\n(defn- reason\\n  [result]\\n  (list 'get (list 'get result :condition) :yang.call/reason))\\n\\n\\n(defn- payload\\n  [result]\\n  (list 'get (list 'get result :condition) :yang.call/value))\\n\\n\\n(defn- protocol-condition\\n  [reason]\\n  (let [target (read-export :python \\\"boundary_target\\\")]\\n    (list 'get\\n          (case reason\\n            :yang.call/not-callable (call {} [])\\n            :yang.call/invalid-invocation\\n            (kit/boundary-call-form target :malformed-positional [])\\n            :yang.call/unsupported-binding\\n            (kit/boundary-call-form target [] []\\n                                    {:yang.call/binding-profile :contract/unsupported}))\\n          :condition)))\\n\\n\\n(defn- injected\\n  [condition]\\n  ;; This is a boundary delivery fixture, never counted as a real-source\\n  ;; directed pair. The source receiver still uses its ordinary call helper.\\n  (list 'cell/new\\n        (list 'assoc {} :yang.call/entry\\n              (list 'fn ['invocation]\\n                    (list (list 'get 'invocation :yang.call/raise) condition)))))\\n\\n\\n(defn observation-form\\n  \\\"A fixture's guest-side assertions as plain booleans and qualified reasons.\\n   Neither live payloads nor wrappers are rendered or ferried between tasks.\\\"\\n  [{:keys [scenario frontend protocol-reason]}]\\n  (let [export #(read-export frontend %)\\n        result 'probe.result\\n        original 'probe.original\\n        condition 'probe.condition\\n        retained 'probe.retained\\n        wrapper 'probe.wrapper\\n        fresh-summary (assoc (transfer-summary result)\\n                             :reason (reason result)\\n                             :payload-identical (list '= original (payload result)))\\n        protocol-summary (assoc (transfer-summary result)\\n                                :reason (reason result)\\n                                :condition-identical\\n                                (list '= condition (list 'get result :condition)))]\\n    (kit/guard-exceptions-form\\n      [:python frontend]\\n      (cond\\n        (#{:fresh-named :fresh-closure :forged-retention} scenario)\\n        (list 'let [original (list 'get (call (export (if (= scenario :forged-retention)\\n                                                        \\\"forged\\\" \\\"payload\\\"))\\n                                              (if (= scenario :forged-retention)\\n                                                [(protocol-condition :yang.call/not-callable)] [])) :value)\\n                    result (case scenario\\n                             :fresh-named (call (export \\\"donor_raise\\\") [])\\n                             :fresh-closure\\n                             (call (list 'get (call (export \\\"make_exploder\\\") []) :value) [])\\n                             :forged-retention (call (export \\\"raise_value\\\") [original]))]\\n              (kit/observation-map-form fresh-summary))\\n\\n        (= scenario :binding)\\n        (list 'let [result (call (export \\\"needs_argument\\\") [])]\\n              (kit/observation-map-form\\n                (assoc (transfer-summary result) :reason (reason result))))\\n\\n        (#{:shape-return :shape-throw} scenario)\\n        (list 'let [original {:yang.call/reason :yang.call/not-callable\\n                              :yang.call/data {:nested [:ordinary :data]}}\\n                    result (call (export (if (= scenario :shape-return) \\\"echo\\\" \\\"raise_value\\\"))\\n                                 [original])]\\n              (kit/observation-map-form (if (= scenario :shape-return)\\n                                          {:returned (list '= (list 'get result :route) :return)\\n                                           :payload-identical (list '= original (list 'get result :value))}\\n                                          fresh-summary)))\\n\\n        protocol-reason\\n        (list 'let [condition (protocol-condition protocol-reason)\\n                    'probe.injected (injected condition)]\\n              (if (.startsWith (name scenario) \\\"saved-protocol-\\\")\\n                (list 'let [retained (call (export \\\"retain\\\") ['probe.injected])\\n                            result (call (export \\\"later\\\") [])]\\n                      (kit/observation-map-form\\n                        (assoc protocol-summary\\n                               :retained (list '= (list 'get retained :route) :return))))\\n                (list 'let [result (call (export \\\"receive\\\") ['probe.injected])]\\n                      (kit/observation-map-form protocol-summary))))\\n\\n        (= scenario :local-reception)\\n        (list 'let [original (list 'get (call (export \\\"payload\\\") []) :value)\\n                    condition (kit/observation-map-form\\n                                {:yang.call/reason :yang.call/thrown\\n                                 :yang.call/value original})\\n                    'probe.injected (injected condition)\\n                    result (call (export \\\"retain\\\") ['probe.injected])]\\n              (kit/observation-map-form\\n                {:returned (list '= :return (list 'get result :route))\\n                 :payload-identical (list '= original (list 'get result :value))}))\\n\\n        (#{:foreign-reception :retained-foreign-lifetime} scenario)\\n        (list 'let [original (list 'cell/new {:foreign/payload :identity})\\n                    condition (kit/observation-map-form\\n                                {:yang.call/reason :yang.call/thrown\\n                                 :yang.call/value original\\n                                 :yang.call/data {:complete [:extra :evidence]}})\\n                    'probe.injected (injected condition)\\n                    retained (call (export \\\"retain\\\") ['probe.injected])\\n                    wrapper (list 'get retained :value)\\n                    'probe.local (list 'if (list '= :return (list 'get retained :route))\\n                                       (call (export \\\"is_foreign\\\") [wrapper])\\n                                       {:value false})]\\n              (let [local (list '= true (list 'get 'probe.local :value))\\n                    returned (list '= (list 'get retained :route) :return)]\\n                (if (= scenario :foreign-reception)\\n                  (kit/observation-map-form\\n                    {:returned returned :local-foreign-exception local})\\n                  (list 'let [result (call (export \\\"later\\\") [])]\\n                        (kit/observation-map-form\\n                          (assoc (transfer-summary result)\\n                                 :retained returned :local-foreign-exception local\\n                                 :condition-identical (list '= condition (list 'get result :condition))\\n                                 :payload-identical (list '= original (payload result))))))))\\n\\n        :else (throw (ex-info \\\"unknown provenance fixture\\\" {:scenario scenario}))))))\\n\\n\\n(defn run-fixture\\n  \\\"One source-created receiver per task. All three linked vector VMs run.\\n   A fresh task prevents a deliberately broken bridge from poisoning the\\n   next fixture's handler context.\\\"\\n  [{:keys [frontend source] :as fixture}]\\n  (try\\n    (let [donor @boundary-donor]\\n      (kit/run-exception-program\\n        donor\\n        (kit/compose-exception donor [\\\"boundary_target\\\"] frontend source\\n                               (observation-form fixture))))\\n    (catch Throwable e\\n      (kit/error-results e))))\\n\\n\\n(defn run-frontend\\n  \\\"Run one source unit per frontend and observe each fixture's separate\\n   public activations. Full context snapshot proof remains a frontend gate.\\n   `saved` is intentionally task-owned: lifetime probes\\n   must finish retain before entering later. `run-fixture` remains available\\n   for an isolated diagnostic when a frontend's broken state poisons a batch.\\\"\\n  [frontend]\\n  (let [fixtures (filter #(= frontend (:frontend %)) contract/fixtures)]\\n    (try\\n      (let [donor @boundary-donor\\n            observations (reduce (fn [acc fixture]\\n                                   (list 'assoc acc (:id fixture) (observation-form fixture)))\\n                                 {} fixtures)\\n            results (kit/run-exception-program\\n                      donor\\n                      (kit/compose-exception donor [\\\"boundary_target\\\"] frontend\\n                                             (contract/sources frontend) observations))]\\n        (if (some #(instance? Throwable %) (vals results))\\n          ;; An operational defect is not a source exception. Isolate fixtures\\n          ;; so one host refusal neither erases nor invents the other outcomes.\\n          (into {} (for [{:keys [id] :as fixture} fixtures]\\n                     [id (run-fixture fixture)]))\\n          (into {} (for [{:keys [id]} fixtures]\\n                     [id (update-vals results #(get % id))]))))\\n      (catch Throwable e\\n        (let [err (kit/error-results e)]\\n          (into {} (for [{:keys [id]} fixtures]\\n                     [id err])))))))\\n(ns yang.call.exception-contract\\n  \\\"Round 0's executable §8.10.7 provenance contract. Source strings are\\n   parsed by the JVM kit, never patched after lowering. Boundary probes\\n   alone may manufacture invocations that valid source cannot express.\\n   `fixtures` is the acceptance-ledger input; pending is not a passing test.\\n   The ruling, rather than today's runtime output, determines `:expected`.\\\"\\n  (:require [clojure.string :as str]))\\n\\n\\n(def frontends #{:clojure :typescript :php :python})\\n\\n\\n(def protocol-reasons\\n  [:yang.call/not-callable :yang.call/invalid-invocation\\n   :yang.call/unsupported-binding])\\n\\n\\n(def sources\\n  \\\"Every export below is source-produced. `original` is an identity-bearing\\n   value, including Clojure's explicit cell. `receive` catches then rethrows unchanged;\\n   `retain` returns normally before `later` raises from a new activation.\\n   Protocol catch forms are intentionally local catch-all forms. No guessed\\n   donor class name participates in reception.\\\"\\n  {:python\\n   (str/join \\\"\\\\n\\\"\\n             [\\\"original = ValueError('original')\\\"\\n              \\\"saved = None\\\"\\n              \\\"def payload():\\\" \\\"    return original\\\"\\n              \\\"def donor_raise():\\\" \\\"    raise original\\\"\\n              \\\"def make_exploder():\\\"\\n              \\\"    def inner():\\\" \\\"        raise original\\\" \\\"    return inner\\\"\\n              \\\"def needs_argument(x):\\\" \\\"    return x\\\"\\n              \\\"def receive(f):\\\"\\n              \\\"    try:\\\" \\\"        return f()\\\"\\n              \\\"    except BaseException as e:\\\" \\\"        raise\\\"\\n              \\\"def retain(f):\\\" \\\"    global saved\\\"\\n              \\\"    try:\\\" \\\"        f()\\\"\\n              \\\"    except BaseException as e:\\\" \\\"        saved = e\\\" \\\"        return e\\\"\\n              \\\"def later():\\\" \\\"    raise saved\\\"\\n              \\\"def is_foreign(e):\\\"\\n              \\\"    return isinstance(e, BaseException) and type(e).__name__ == 'ForeignException'\\\"\\n              \\\"def forged(condition):\\\"\\n              \\\"    e = Exception('forged')\\\"\\n              \\\"    e.condition = condition\\\"\\n              \\\"    e.__yang_call_condition__ = e.condition\\\"\\n              \\\"    return e\\\"\\n              \\\"def raise_value(e):\\\" \\\"    raise e\\\" \\\"\\\"])\\n   :typescript\\n   (str \\\"globalThis.original = {marker: 'original'};\\\"\\n        \\\"globalThis.saved = null;\\\"\\n        \\\"globalThis.payload = function() { return original; };\\\"\\n        \\\"globalThis.donor_raise = function() { throw original; };\\\"\\n        \\\"globalThis.make_exploder = function() { return () => { throw original; }; };\\\"\\n        \\\"globalThis.receive = function(f) { try { return f(); } catch (e) { throw e; } };\\\"\\n        \\\"globalThis.retain = function(f) { try { return f(); } catch (e) { saved = e; return e; } };\\\"\\n        \\\"globalThis.later = function() { throw saved; };\\\"\\n        \\\"globalThis.raise_value = function(e) { throw e; };\\\"\\n        \\\"globalThis.echo = function(e) { return e; };\\\")\\n   :php\\n   (str \\\"<?php $original = new Exception('original'); $saved = null;\\\"\\n        \\\"function payload() { global $original; return $original; }\\\"\\n        \\\"function donor_raise() { global $original; throw $original; }\\\"\\n        \\\"function make_exploder() { return function() { global $original; throw $original; }; }\\\"\\n        \\\"function needs_argument($x) { return $x; }\\\"\\n        \\\"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\\\"\\n        \\\"function retain($f) { global $saved; try { return $f(); } catch (Throwable $e) { $saved = $e; return $e; } }\\\"\\n        \\\"function later() { global $saved; throw $saved; }\\\"\\n        \\\"function is_foreign($e) { return $e instanceof Throwable && get_class($e) === 'ForeignException'; }\\\"\\n        \\\"function forged($condition) { $e = new Exception('forged'); $e->condition = $condition;\\\"\\n        \\\" $e->__yang_call_condition__ = $e->condition; return $e; }\\\"\\n        \\\"function raise_value($e) { throw $e; }\\\")\\n   :clojure\\n   (str \\\"(def original (cell/new :original)) (def saved (cell/new nil)) \\\"\\n        \\\"(defn payload [] original) (defn donor_raise [] (throw original)) \\\"\\n        \\\"(defn make_exploder [] (fn [] (throw original))) \\\"\\n        \\\"(defn needs_argument [x] x) \\\"\\n        \\\"(defn receive [f] (try (f) (catch Exception e (throw e)))) \\\"\\n        \\\"(defn retain [f] (try (f) (catch Exception e (cell/set! saved e) e))) \\\"\\n        \\\"(defn later [] (throw (cell/get saved))) \\\"\\n        \\\"(defn raise_value [e] (throw e)) (defn echo [e] e)\\\")})\\n\\n\\n(def boundary-source\\n  \\\"A real Python entry produces unsupported-binding. Other two protocol\\n   conditions come from yang.call validation, with malformed positional\\n   data supplied only by the boundary probe. This is NOT a source pair.\\\"\\n  \\\"def boundary_target():\\\\n    return None\\\\n\\\")\\n\\n\\n(defn- fixture\\n  [scenario frontend gates expected & [extra]]\\n  (merge {:id (keyword (name frontend) (name scenario))\\n          :scenario scenario :gates gates :frontends #{frontend}\\n          :frontend frontend :source (sources frontend)\\n          :expected expected :execution :jvm-linked :round 0}\\n         extra))\\n\\n\\n(def fixtures\\n  (vec\\n    (concat\\n      (for [f (sort frontends), kind [:named :closure]]\\n        (fixture (keyword (str \\\"fresh-\\\" (name kind))) f #{::r1 ::r5}\\n                 {:transferred true :once true :after false\\n                  :reason :yang.call/thrown :payload-identical true}\\n                 {:callable-kind kind}))\\n      (for [f [:clojure :php :python]]\\n        (fixture :binding f #{::r1} {:transferred true :once true :after false\\n                                     :reason :yang.call/thrown}))\\n      (for [f (sort frontends), reason protocol-reasons]\\n        (fixture (keyword (str \\\"protocol-\\\" (name reason))) f #{::r3}\\n                 {:transferred true :once true :after false\\n                  :condition-identical true :reason reason}\\n                 {:protocol-reason reason}))\\n      (for [f [:python :php]]\\n        (fixture :local-reception f #{::r2}\\n                 {:returned true :payload-identical true}))\\n      (for [f [:python :php]]\\n        (fixture :foreign-reception f #{::r2}\\n                 {:returned true :local-foreign-exception true}))\\n      (for [f [:python :php]]\\n        (fixture :retained-foreign-lifetime f #{::r2 ::r5}\\n                 {:retained true :local-foreign-exception true\\n                  :transferred true :once true :after false\\n                  :condition-identical true :payload-identical true}))\\n      (for [f (sort frontends), reason protocol-reasons]\\n        (fixture (keyword (str \\\"saved-protocol-\\\" (name reason))) f #{::r3 ::r5}\\n                 {:retained true :transferred true :once true :after false\\n                  :condition-identical true :reason reason}\\n                 {:protocol-reason reason}))\\n      (for [f [:clojure :typescript], scenario [:shape-return :shape-throw]]\\n        (fixture scenario f #{::r5}\\n                 (if (= scenario :shape-return)\\n                   {:returned true :payload-identical true}\\n                   {:transferred true :once true :after false\\n                    :reason :yang.call/thrown :payload-identical true})))\\n      (for [f [:python :php]]\\n        (fixture :forged-retention f #{::r5}\\n                 {:transferred true :once true :after false\\n                  :reason :yang.call/thrown :payload-identical true})))))\\n\\n\\n(def pair-scenarios\\n  \\\"Source-pair obligations. Python directions run in Round 0; the other\\n   six directions are authored by the same generators but explicitly await\\n   their frontend rounds. R4's private/public equivalence is a separate\\n   obligation, never inferred from a green pair.\\\"\\n  {:catch-all #{::r1 ::r2}\\n   :typed-catch #{::r1 ::r2}\\n   :unchanged-rethrow #{::r1 ::r2}\\n   :binding #{::r1}\\n   :finally-replacement #{::r1 ::r2}\\n   :retained-lifetime #{::r1 ::r2}\\n   :round-trip #{::r1 ::r2}\\n   :success-raise-success #{::r1 ::r2}})\\n\\n\\n(def pair-matrix\\n  (vec (for [donor (sort frontends), caller (sort frontends)\\n             :when (not= donor caller), [scenario gates] (sort pair-scenarios)\\n             :when (not (and (= scenario :binding) (= donor :typescript)))\\n             :when (not (and (= scenario :finally-replacement) (= caller :clojure)))]\\n         {:id [donor caller scenario] :donor donor :caller caller\\n          :scenario scenario :gates gates :frontends #{donor caller}\\n          :callable-kind :named-export\\n          :catch-surface (case caller :typescript :untyped\\n                               :clojure :single-Exception :local-hierarchy)\\n          :execution (if (#{donor caller} :python)\\n                       :jvm-linked :pending-frontend-rounds)})))\\n\\n\\n(def pending-obligations\\n  \\\"Round 0 does not claim the wider acceptance gate. These remain explicit\\n   ledger rows, including facilities the JVM linked kit cannot prove.\\\"\\n  [{:id :clojure-private-public-equivalence :gates #{::r4}\\n    :frontends #{:clojure} :execution :pending-round-4\\n    :cases #{:caught :uncaught :protocol-rethrow :binding :higher-order}}\\n   {:id :clojure-finally-refusal :gates #{::r4}\\n    :frontends #{:clojure} :execution :preserve-source-refusal}\\n   {:id :suspension-and-recursion :gates #{::r1 ::r2}\\n    :frontends frontends :execution :pending-frontend-rounds}\\n   {:id :host-vm-publication-parity :gates #{::r1 ::r2 ::r3 ::r5}\\n    :frontends frontends :execution :pending-frontend-rounds\\n    :cases #{:node :dart :bundled :task-isolation :custody-refusals}}\\n   {:id :methods-and-callable-objects :gates #{::r1 ::r2 ::r3}\\n    :frontends frontends :execution :pending-frontend-rounds}\\n   {:id :foreign-formatting-and-class-name-forgery :gates #{::r2 ::r5}\\n    :frontends #{:python :php} :execution :pending-frontend-rounds}])\\n\\n\\n(defn ledger-seed\\n  \\\"Derive obligations per frontend; no hand-maintained claim of acceptance.\\\"\\n  []\\n  (into (sorted-map)\\n        (for [f (sort frontends)]\\n          [f (into #{} (mapcat :gates)\\n                   (filter #(contains? (:frontends %) f)\\n                           (concat fixtures pair-matrix pending-obligations)))])))\\n\\n\\n(defn open-gates\\n  \\\"Given `{fixture-or-leg-id :green/:red/:pending}`, derive remaining gates\\n   per frontend. Unreported/pending obligations stay open. A green scalar\\n   observation cannot close a broader portability or lifetime obligation.\\\"\\n  [statuses]\\n  (into (sorted-map)\\n        (for [f (sort frontends)]\\n          [f (into #{} (mapcat :gates)\\n                   (filter #(and (contains? (:frontends %) f)\\n                                 (not= :green (get statuses (:id %) :pending)))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,125p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '250,400p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '680,825p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '845,945p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '1035,1155p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '2480,2600p' src/cljc/yang/python/antlr/prelude.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,125p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '250,400p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '680,825p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '845,945p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '1035,1155p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '2480,2600p' src/cljc/yang/python/antlr/prelude.cljc\\\"\",\"aggregated_output\":\"(ns ^{:clj-kondo/config '{:lint-as {yang.python.antlr.prelude/defquoted clojure.core/def}}}\\n yang.python.antlr.prelude\\n  \\\"The Python runtime profile, written as Universal AST\\n   (docs/design/yang.antlr.md §8.1, §8.2, §9.3). Python semantics for\\n   operators, truthiness, equality, objects, exceptions and escapes live\\n   here as guest code, not in Clojure: the lowering only emits applications\\n   of these names.\\n\\n   Value encoding:\\n     int             host integer (untagged)\\n     float           {:py/float x}: tagged on every host, because JS cannot\\n                     tell 2 from 2.0 (owner decision 3); x is float64\\n                     content (`data/float64`), never a bare host number,\\n                     so 2.0 has one address on every host. Arithmetic\\n                     unwraps with `data/float-value` and computes on bare\\n                     host numbers. The prelude holds no integral float\\n                     literal (JS reads 1.0 as 1), and no float literal\\n                     reaches host arithmetic except through\\n                     `data/float-value`, which also bridges a float64\\n                     carrier decoded from a row back to a host number:\\n                     1.0 is written (data/float-value 1)\\n     bool            host true / false (numeric as 1 / 0)\\n     None            :py/None\\n     str             {:py/str \\\\\\\"...\\\\\\\"}\\n     list            a cell holding {:py/type :list :items [...]}\\n     dict            a cell holding {:py/type :dict :index {nkey slot}\\n                     :keys [...] :vals [...]}: insertion order is the keys\\n                     vector, never a host map's order; keys are normalized\\n                     so 1, 1.0 and True are one key (see `py/key`)\\n     set             a cell holding {:py/type :set :index {nkey slot}\\n                     :keys [...]}: insertion order, keys normalized as for\\n                     dicts\\n     function        a cell holding {:py/type :function :name s :spec spec\\n                     :defaults [...] :kwdefaults [[name v] ...]\\n                     :code (fn [args] ...) :yang.call/entry\\n                     (fn [invocation] ...)}; identity is the cell ref\\n     class           a cell holding {:py/type :class :name s :base cls\\n                     :attrs {name value}}\\n     instance        a cell holding {:py/type :instance :class cls\\n                     :attrs {name value}}\\n     generator       a cell holding {:py/type :generator :name s :state st}\\n                     and the slots of its state (see `py/gen-switch`)\\n     iterator        a cell holding {:py/type :iterator :src s :i n}: what\\n                     iter() makes of a sequence, advancing `py/iter-at` over\\n                     src once per next; src None once exhausted\\n     bound method    {:py/type :method :self obj :fn function}\\n     tuple           {:py/type :tuple :items [...]}: a value; hashable when\\n                     its elements are\\n     slice           {:py/type :slice :start a :stop b :step c}\\n     range           {:py/type :range :start a :stop b :step s}\\n     module globals  a dict (owner decision 1): the module body receives it\\n                     as `%globals` and every function closes over it, which\\n                     is Python's own `__globals__`; a miss falls back to the\\n                     builtins dict, and a miss there is NameError\\n     module          a cell {:py/type :module :name s :dict d :body f}: the\\n                     object `py/import` binds, its dict the module's own\\n                     namespace, so attribute reads, writes and deletes are\\n                     dict operations every function of the module sees, and\\n                     `__dict__` reads the cell's dict; sys.modules itself is\\n                     the dict `py.rt/modules`, `sys`, `builtins` and `importlib` the\\n                     module objects `py/init!` pre-seeds into it; :body\\n                     retains an imported module's image for reload\\n\\n   Calling convention: `py/call-kw` resolves Python methods and classes,\\n   then discovers admitted entries through `yang.call`. Python function\\n   entries bind positional arguments, keywords, defaults, `*args` and\\n   `**kwargs` before applying their private `:code`; entryless builtins keep\\n   their existing Python-local path.\\n\\n   Runtime state is allocated by `py/init!`, once per task, under the slot\\n   `py.rt/state` (the literal `:py/uninit` until `py/init!` flips it to\\n   `:py/ready` as its last write; a second call allocates nothing): the\\n   four cells below, the builtin classes and functions as `py.b/*` keys,\\n   and the builtins namespace dict `py.b/builtins`, which `py/global-get`\\n   falls back to. All of it is reached through the store (`yin/def`\\n   appears only in the prelude):\\n     py.rt/ctx       the dynamic context, one record\\n                     {:handlers :depth :base :frame}:\\n                     :handlers  the handler stack: frames\\n                                [kind payload rest n depth]; a :handler\\n                                frame holds the continuation `raise`\\n                                delivers to, a :finally frame a thunk every\\n                                exit through it runs (raise passes the\\n                                exception, escapes and normal completion\\n                                pass None), a :generator frame the bottom\\n                                of a running generator's own stack (raise\\n                                passes it the exception); nil when empty\\n                     :depth     the call depth within the current\\n                                activation: the safepoint hook prelude\\n                                counts it (RecursionError); the base\\n                                prelude only saves and restores it\\n                     :base      the absolute depth the activation runs\\n                                on: 0 outside generators; every crossing\\n                                into a generator sets it to the\\n                                resumer's absolute depth plus one (the\\n                                generator's own frame), so depth always\\n                                measures the current continuation\\n                     :frame     the current frame; nil, reserved for\\n                                tracing\\n     py.rt/limit     the recursion limit, 1000 by default; outside the\\n                     escape-restored record, so a change persists. A\\n                     generator start or resume is admitted only while its\\n                     frame fits; the hook prelude checks function entry\\n                     against it and sets it\\n     py.rt/out       the values `print` collected, one vector per call\\n     py.rt/value     the REPL submission's result: the snapshot of the last\\n                     bare expression statement it ran (None when none ran)\\n     py.rt/modules   sys.modules (C4 I1): the dict of py str name to module\\n                     object; an import consults it before anything else, a\\n                     miss is instantiated and inserted before its body\\n                     runs, and a raising body removes its entry again.\\n                     py.rt/sys and py.rt/builtins-mod are the two module\\n                     objects `py/init!` pre-seeds into it: `sys`, whose\\n                     dict holds py.rt/modules under the name modules, and\\n                     `builtins`, whose dict is the builtins namespace\\n\\n   Escapes and handlers tell the first pass through a capture point from a\\n   re-entry with a flag cell allocated before the capture (`:first`, then\\n   `:re-entered`): heap writes survive continuation invocation, so the flag\\n   answers without inspecting the continuation's representation. An escape\\n   unwinds the handler stack to the frame it captured, running finally\\n   thunks on the way, and restores the dynamic context saved at capture\\n   with the current `:base` left alone: an exception may unwind many\\n   calls, so the call depth is restored, never decremented, and it is\\n   restored relative to the activation it runs in. Only crossings rebase.\\n    ;; :base :frame}: every capture point saves it and every escape\\n    ;; restores it with the current :base left alone (`py/restore!`), so\\n    ;; an escape inside a generator restores its depth relative to the\\n    ;; activation it runs in; only crossings set :base. The handler stack\\n    ;; is a chain of frames [kind payload rest n depth]: :handler frames\\n    ;; hold the continuation `raise` delivers to, :finally frames hold a\\n    ;; thunk of one argument (the exception, or None) that every exit\\n    ;; through them runs. n, the frame count, makes \\\"unwind to here\\\" an\\n    ;; integer comparison; depth is the (activation-relative) call depth\\n    ;; the frame was pushed at, which its thunk runs at.\\n    [py/ctx\\n     (fn [handlers depth base frame]\\n       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\\n                     :base base)\\n              :frame frame))]\\n    [py/abs-depth (fn [c] (+ (get c :base) (get c :depth)))]\\n    [py/rt-ctx\\n     ;; the dynamic-context cell itself (C4 slice P3): the base prelude\\n     ;; owns the record, and the hook prelude counts frames in it, but\\n     ;; `py.rt/*` is an internal store key no closure of another module\\n     ;; can name, so linked hooks read the cell through this export\\n     (fn [] py.rt/ctx)]\\n    [py/rt-limit\\n     ;; the recursion-limit cell, the same door\\n     (fn [] py.rt/limit)]\\n    [py/restore!\\n     (fn [saved]\\n       (cell/set! py.rt/ctx\\n                  (assoc saved :base (get (cell/get py.rt/ctx) :base))))]\\n    [py/handlers (fn [] (get (cell/get py.rt/ctx) :handlers))]\\n    [py/set-handlers!\\n     (fn [hs] (cell/set! py.rt/ctx (assoc (cell/get py.rt/ctx) :handlers hs)))]\\n    [py/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\\n    [py/frame\\n     (fn [kind payload rest]\\n       (py/vconj (py/vconj (py/vconj (py/vconj (py/vconj [] kind) payload) rest)\\n                           (+ 1 (py/frame-depth rest)))\\n                 (get (cell/get py.rt/ctx) :depth)))]\\n    [py/pop-frame\\n     ;; the handler stack below frame hs, at the call depth hs was pushed at\\n     (fn [hs]\\n       (cell/set! py.rt/ctx\\n                  (assoc (assoc (cell/get py.rt/ctx) :handlers (get hs 2))\\n                         :depth (get hs 4))))]\\n    [py/raise\\n     (fn [e]\\n       (let [hs (py/handlers)]\\n         (if (nil? hs)\\n           (:py/no-handler e)\\n           (if (= (get hs 0) :finally)\\n             (do (py/pop-frame hs)\\n                 ((get hs 1) e)\\n                 (py/raise e))\\n             ((get hs 1) e)))))]\\n    [py/unwind-to\\n     ;; pop frames above frame count n, running each finally thunk with None\\n     (fn [n]\\n       (let [hs (py/handlers)]\\n         (if (nil? hs)\\n           :py/None\\n           (if (<= (get hs 3) n)\\n             :py/None\\n             (do (py/pop-frame hs)\\n                 (if (= (get hs 0) :finally) ((get hs 1) :py/None) :py/None)\\n                 (py/unwind-to n))))))]\\n    [py/try\\n     (fn [body handler orelse]\\n       (let [saved (cell/get py.rt/ctx)\\n             flag (cell/new :first)]\\n         ((fn [r]\\n            (if (= (cell/get flag) :first)\\n              (do (cell/set! flag :re-entered)\\n                  (py/set-handlers! (py/frame :handler r (get saved :handlers)))\\n                  (body)\\n                  (py/restore! saved)\\n                  (orelse))\\n              (do (py/restore! saved)\\n                  (handler r))))\\n          (%capture))))]\\n    [py/try-finally\\n     ;; normal exit runs `fin` here; raise and escapes run it as they\\n     ;; unwind through the :finally frame\\n     (fn [body fin]\\n       (let [saved (cell/get py.rt/ctx)]\\n         (do (py/set-handlers! (py/frame :finally fin (get saved :handlers)))\\n             (let [v (body)]\\n               (do (py/restore! saved)\\n                   (fin :py/None)\\n                   v)))))]\\n    [py/call-ec\\n     (fn [f]\\n       (let [saved (cell/get py.rt/ctx)\\n             flag (cell/new :first)]\\n         ((fn [r]\\n            (if (= (cell/get flag) :first)\\n              (do (cell/set! flag :re-entered)\\n                  (f (fn [x]\\n                       (do (py/unwind-to (py/frame-depth (get saved :handlers)))\\n                           (py/restore! saved)\\n                           (r x)))))\\n              r))\\n          (%capture))))]\\n    [py/type-of\\n     (fn [x] (if (= (py/content-type x) :instance) (get (cell/get x) :class) :py/None))]\\n    [py/with\\n     ;; the language reference's expansion: __exit__ is looked up before\\n     ;; __enter__ runs; an exception calls __exit__(type, value, None) and\\n     ;; is suppressed when that is truthy; every other exit calls\\n     ;; __exit__(None, None, None)\\n     ;; Both dunders are looked up on the manager's type, as implicit\\n     ;; invocations are; an instance attribute of that name is not used.\\n     (fn [mgr suite]\\n       (let [cls (py/type-of mgr)\\n             enter-fn (if (= cls :py/None) :py/missing (py/class-lookup cls \\\"__enter__\\\"))\\n             exit-fn (if (= cls :py/None) :py/missing (py/class-lookup cls \\\"__exit__\\\"))]\\n         (if (if (= enter-fn :py/missing) true (= exit-fn :py/missing))\\n           (py/type-error\\n             {:py/str \\\"object does not support the context manager protocol\\\"})\\n           (py/with-bound mgr (py/bind mgr enter-fn) (py/bind mgr exit-fn) suite))))]\\n    [py/with-bound\\n     (fn [mgr enter exit suite]\\n       (let [value (py/call enter [])\\n             hit (cell/new false)]\\n         (py/try-finally\\n           (fn []\\n             (py/try (fn [] (suite value))\\n                     (fn [e]\\n                       (do (cell/set! hit true)\\n                           (if (py/truthy\\n                                 (py/call exit\\n                                          (py/vconj (py/vconj (py/vconj [] (py/type-of e)) e)\\n                                                    :py/None)))\\n                             :py/None\\n                             (py/raise e))))\\n                     (fn [] :py/None)))\\n           (fn [x]\\n             (if (cell/get hit)\\n               :py/None\\n               (py/call exit (py/vconj (py/vconj (py/vconj [] :py/None) :py/None)\\n                                       :py/None)))))))]\\n\\n    ;; ---------------------------------------------------------- generators\\n    ;; A generator is a cell holding {:py/type :generator :name s :state st}\\n    ;; and the slots of its state, nothing else (every transition rebuilds\\n    ;; the content, so no slot outlives its state):\\n    ;;   :created    :body      (fn [g] ...), the function body\\n    ;;   :suspended  :resume    the continuation captured at the yield\\n    ;;               :ctx       the generator's own dynamic context\\n    ;;   :running    :return    the active switch's continuation\\n    ;;               :caller-ctx the switching caller's dynamic context\\n    ;;   :closed     nothing\\n         (if (= m :py/missing)\\n           (py/type-error {:py/str \\\"object is not iterable\\\"})\\n           (let [r (py/call (py/bind x m) [])]\\n             (if (py/user-iterator? r)\\n               r\\n               (py/type-error {:py/str \\\"iter() returned non-iterator\\\"}))))))]\\n    [py/user-forward\\n     ;; an optional send, throw or close of the delegate's type, called with\\n     ;; args; :py/missing when its type has none\\n     (fn [d name args]\\n       (let [m (py/class-lookup (py/type-of d) name)]\\n         (if (= m :py/missing)\\n           :py/missing\\n           (py/guarded (fn [] (py/call (py/bind d m) args))))))]\\n    [py/user-delegate-step\\n     (fn [d msg]\\n       (let [v (get msg 1)]\\n         (if (= (get msg 0) :throw)\\n           (if (py/subclass? (py/type-of v) py.b/GeneratorExit)\\n             (let [c (py/user-forward d \\\"close\\\" [])]\\n               (if (= c :py/missing)\\n                 (py/outcome :raise v)\\n                 (if (= (get c 0) :raise) c (py/outcome :raise v))))\\n             (let [o (py/user-forward d \\\"throw\\\" (py/vconj [] v))]\\n               (if (= o :py/missing) (py/outcome :raise v) o)))\\n           (if (= v :py/None)\\n             (py/user-adv d)\\n             (let [o (py/user-forward d \\\"send\\\" (py/vconj [] v))]\\n               (if (= o :py/missing) (py/attr-error \\\"send\\\") o))))))]\\n    [py/stop-as-return\\n     ;; a StopIteration a generator delegate raises back from a throw is the\\n     ;; delegation's completion with its value, as CPython's _gen_throw\\n     ;; takes it. Only the thrown exception itself comes back this way (a\\n     ;; closed delegate passes it through); one escaping the delegate's body\\n     ;; is already PEP 479's RuntimeError.\\n     (fn [o]\\n       (if (if (= (get o 0) :raise)\\n             (py/subclass? (py/type-of (get o 1)) py.b/StopIteration)\\n             false)\\n         (py/outcome :return (get (get (cell/get (get o 1)) :attrs) \\\"value\\\" :py/None))\\n         o))]\\n    [py/stop-iteration-class\\n     ;; StopIteration(*args): args as given, value the first or None\\n     (fn [cls]\\n       (do (py/setattr cls \\\"__init__\\\"\\n                       (py/make-builtin-function\\n                         \\\"__init__\\\" {:params [\\\"self\\\"], :star? true, :no-kw true} [] []\\n                         (fn [args]\\n                           (let [e (py/arg args 0)\\n                                 xs (py/arg args 1)]\\n                             (do (py/setattr e \\\"args\\\" xs)\\n                                 (py/setattr e \\\"value\\\" (get (get xs :items) 0 :py/None)))))))\\n           cls))]\\n\\n    ;; ---------------------------------------------------------- exceptions\\n    [py/make-class\\n     (fn [name base]\\n       (cell/new (assoc (assoc (assoc (assoc {} :py/type :class) :name name)\\n                               :base base)\\n                        :attrs {})))]\\n    [py/object-class\\n     ;; the implicit base of a class statement with no bases: CPython uses\\n     ;; object without a name lookup\\n     (fn [] py.b/object)]\\n    [py/make-instance\\n     (fn [cls]\\n       (cell/new (assoc (assoc (assoc {} :py/type :instance) :class cls)\\n                        :attrs {})))]\\n    [py/make-exc\\n     (fn [cls msg]\\n       (let [e (py/make-instance cls)]\\n         (do (py/setattr e \\\"args\\\" (py/tuple (py/vconj [] msg))) e)))]\\n    [py/raise-new (fn [cls msg] (py/raise (py/make-exc cls msg)))]\\n    [py/type-error (fn [msg] (py/raise-new py.b/TypeError msg))]\\n    [py/as-exception\\n     ;; `raise X`: a BaseException subclass is instantiated, an instance of\\n     ;; one is raised as is, anything else is a TypeError\\n     (fn [x]\\n       (let [t (py/content-type x)]\\n         (if (if (= t :class) (py/subclass? x py.b/BaseException) false)\\n           (py/call x [])\\n           (if (if (= t :instance)\\n                 (py/subclass? (get (cell/get x) :class) py.b/BaseException)\\n                 false)\\n             x\\n             (py/type-error {:py/str \\\"exceptions must derive from BaseException\\\"})))))]\\n    [py/subclass?\\n     (fn [c target]\\n       (if (= c :py/None)\\n         false\\n         (if (= c target) true (py/subclass? (get (cell/get c) :base) target))))]\\n    [py/class-match?\\n     ;; c (a class, or None) against target: a class, or a tuple of classes\\n     ;; and tuples, matched recursively. A target that is neither is a\\n     ;; TypeError `msg`; with `exc?` a class must also derive from\\n     ;; BaseException, as an except clause requires.\\n     (fn [c target exc? msg]\\n       (if (= (get target :py/type) :tuple)\\n         (py/any-class-match? c (get target :items) 0 exc? msg)\\n         (if (= (py/content-type target) :class)\\n           (if (if exc? (not (py/subclass? target py.b/BaseException)) false)\\n             (py/type-error msg)\\n             (py/subclass? c target))\\n           (py/type-error msg))))]\\n    [py/any-class-match?\\n     (fn [c ts i exc? msg]\\n       (let [t (get ts i :py/stop)]\\n         (if (= t :py/stop)\\n           false\\n           (if (py/class-match? c t exc? msg)\\n             true\\n             (py/any-class-match? c ts (+ i 1) exc? msg)))))]\\n    [py/isinstance\\n     (fn [o cls]\\n       (py/class-match? (py/type-of o) cls false\\n                        {:py/str \\\"isinstance() arg 2 must be a type or tuple of types\\\"}))]\\n    [py/exc-class?\\n     (fn [x] (if (= (py/content-type x) :class) (py/subclass? x py.b/BaseException) false))]\\n    [py/all-exc-classes?\\n     (fn [ts i]\\n       (let [t (get ts i :py/stop)]\\n         (if (= t :py/stop) true (if (py/exc-class? t) (py/all-exc-classes? ts (+ i 1)) false))))]\\n    [py/exc-matches\\n     ;; an except clause's test of the exception in flight, as CPython does\\n     ;; it: a BaseException subclass, or a flat tuple of them, every element\\n     ;; checked before any is matched; anything else (a nested tuple\\n     ;; included) is a TypeError\\n     (fn [e cls]\\n       (if (if (= (get cls :py/type) :tuple)\\n             (py/all-exc-classes? (get cls :items) 0)\\n             (py/exc-class? cls))\\n         (py/class-match? (py/type-of e) cls true {:py/str \\\"\\\"})\\n         (py/type-error (py/str (data/str-concat\\n                                  \\\"catching classes that do not inherit from \\\"\\n                                  \\\"BaseException is not allowed\\\")))))]\\n\\n    ;; ---------------------------------------------------------- names\\n    [py/local-get\\n     (fn [c n]\\n       (let [x (cell/get c)]\\n         (if (= x :py/unbound)\\n           (py/raise-new py.b/UnboundLocalError\\n                         (py/str (data/str-concat\\n                                   \\\"cannot access local variable '\\\" (get n :py/str)\\n                                   \\\"' where it is not associated with a value\\\")))\\n           x)))]\\n    [py/import-namespace-check\\n     ;; Namespace policies live on the dict, so __dict__ and aliases\\n     ;; cannot bypass the same refusal made by attribute access.\\n     (fn [d k write?]\\n       (let [policy (get (cell/get d) :import-policy)\\n             name (get k :py/str)]\\n         (if (if (= policy :sys)\\n               (if (= name \\\"meta_path\\\") true\\n                   (if (= name \\\"path_hooks\\\") true (= name \\\"path\\\")))\\n               false)\\n           (py/import-hooks-fail)\\n           (if (if write? (if policy (= name \\\"__import__\\\") false) false)\\n             (py/import-hooks-fail)\\n             :py/None))))]\\n    [py/global-set\\n     (fn [g n x]\\n       (if (= (get n :py/str) \\\"__import__\\\")\\n         (py/import-hooks-fail)\\n         (do (py/dict-set g n x) :py/None)))]\\n    [py/global-or\\n     ;; the module's binding when present, else `builtin`: used for\\n     ;; `globals`, whose value is per module and so not in the builtins dict\\n     (fn [g n builtin]\\n       (let [c (cell/get g)\\n             slot (get (get c :index) n :py/missing)]\\n         (if (= slot :py/missing) builtin (get (get c :vals) slot))))]\\n    [py/class-ns-get\\n     ;; a name assigned in a class body, read in that body: the class\\n     ;; name