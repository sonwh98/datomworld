remains structural after callable admission,\\\\n    23\\\\t    ;; with one ruling-of-record refinement: a `:cell-ref`-shaped map is\\\\n    24\\\\t    ;; dereferenced only when the heap authenticates it (`cell/authentic?`,\\\\n    25\\\\t    ;; the issuer's own answer). A map that imitates the reference language\\\\n    26\\\\t    ;; is data, so it projects to itself and its fate follows the ordinary\\\\n    27\\\\t    ;; descriptor rules, exactly as any other map's would.\\\\n    28\\\\t    [yang.call/_descriptor\\\\n    29\\\\t     (fn [callable]\\\\n    30\\\\t       (if (data/map? callable)\\\\n    31\\\\t         (if (if (= (get callable :type) :cell-ref)\\\\n    32\\\\t               (cell/authentic? callable)\\\\n    33\\\\t               false)\\\\n    34\\\\t           (cell/get callable)\\\\n    35\\\\t           callable)\\\\n    36\\\\t         nil))]\\\\n    37\\\\t    [yang.call/entry\\\\n    38\\\\t     (fn [callable]\\\\n    39\\\\t       (get (yang.call/_descriptor callable) :yang.call/entry))]\\\\n    40\\\\t    [yang.call/eligible?\\\\n    41\\\\t     (fn [callable]\\\\n    42\\\\t       (let [descriptor (yang.call/_descriptor callable)]\\\\n    43\\\\t         (if (nil? (yang.call/entry callable))\\\\n    44\\\\t           false\\\\n    45\\\\t           (if (data/contains? descriptor :yang.call/eligible?)\\\\n    46\\\\t             ((get descriptor :yang.call/eligible?) callable)\\\\n    47\\\\t             true))))]\\\\n    48\\\\t    [yang.call/invocation\\\\n    49\\\\t     (fn [callee positional named raise]\\\\n    50\\\\t       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\\\\n    51\\\\t                            :yang.call/positional positional)\\\\n    52\\\\t                     :yang.call/named named)\\\\n    53\\\\t              :yang.call/raise raise))]\\\\n    54\\\\t    [yang.call/invocation-with\\\\n    55\\\\t     (fn [callee positional named raise options]\\\\n    56\\\\t       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\\\\n    57\\\\t                            :yang.call/positional positional)\\\\n    58\\\\t                     :yang.call/named named)\\\\n    59\\\\t              :yang.call/raise raise))]\\\\n    60\\\\t    [yang.call/_pair?\\\\n    61\\\\t     (fn [pair]\\\\n    62\\\\t       (if (data/vector? pair)\\\\n    63\\\\t         (= (data/count pair) 2)\\\\n    64\\\\t         false))]\\\\n    65\\\\t    [yang.call/_named-pairs?\\\\n    66\\\\t     (fn [pairs index]\\\\n    67\\\\t       (if (= index (data/count pairs))\\\\n    68\\\\t         true\\\\n    69\\\\t         (let [pair (data/nth pairs index)]\\\\n    70\\\\t           (if (yang.call/_pair? pair)\\\\n    71\\\\t             (if (data/string? (data/nth pair 0))\\\\n    72\\\\t               (yang.call/_named-pairs? pairs (+ index 1))\\\\n    73\\\\t               false)\\\\n    74\\\\t             false))))]\\\\n    75\\\\t    [yang.call/valid-invocation?\\\\n    76\\\\t     (fn [invocation]\\\\n    77\\\\t       (if (data/map? invocation)\\\\n    78\\\\t         (if (data/contains? invocation :yang.call/callee)\\\\n    79\\\\t           (if (data/contains? invocation :yang.call/positional)\\\\n    80\\\\t             (if (data/contains? invocation :yang.call/named)\\\\n    81\\\\t               (if (data/contains? invocation :yang.call/raise)\\\\n    82\\\\t                 (if (data/vector? (get invocation :yang.call/positional))\\\\n    83\\\\t                   (if (data/vector? (get invocation :yang.call/named))\\\\n    84\\\\t                     (yang.call/_named-pairs?\\\\n    85\\\\t                       (get invocation :yang.call/named) 0)\\\\n    86\\\\t                     false)\\\\n    87\\\\t                   false)\\\\n    88\\\\t                 false)\\\\n    89\\\\t               false)\\\\n    90\\\\t             false)\\\\n    91\\\\t           false)\\\\n    92\\\\t         false))]\\\\n    93\\\\t    [yang.call/condition\\\\n    94\\\\t     (fn [reason evi