              (py/try\\n                 (fn []\\n                   (cell/set! result\\n                              ((get fc :code)\\n                               (py/bind-args fc positional named))))\\n                 (fn [e]\\n                   ;; A retained generated exception forwards its original\\n                   ;; condition unchanged (no new wrapper); a fresh source\\n                   ;; exception still becomes the plain §8.10.7 thrown\\n                   ;; condition. Retention rides the exception's identity,\\n                   ;; outside source-writable attributes.\\n                   (let [retained (py/retained-condition e)]\\n                     (raise-exit\\n                       (if (= retained :py/missing)\\n                         (assoc {:yang.call/reason :yang.call/thrown}\\n                                :yang.call/value e)\\n                         retained))))\\n                 (fn [] (cell/get result))))))))]\\n    [py/function-cell\\n     (fn [name spec defaults kwdefaults code entry?]\\n       (let [content (assoc (assoc (assoc (assoc (assoc (assoc {} :py/type :function)\\n                                                        :name name)\\n                                                 :spec spec)\\n                                          :defaults defaults)\\n                                   :kwdefaults kwdefaults)\\n                            :code code)\\n             f (cell/new content)]\\n         (if entry?\\n           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\\n                                   (fn [invocation]\\n                                     (py/function-entry f invocation))))\\n               f)\\n           f)))]\\n    [py/make-function\\n     (fn [name spec defaults kwdefaults code]\\n       (py/function-cell name spec defaults kwdefaults code true))]\\n    [py/make-builtin-function\\n     (fn [name spec defaults kwdefaults code]\\n       (py/function-cell name spec defaults kwdefaults code false))]\\n    [py/fn-error\\n                   ko (py/fill-kwdefaults fc (get state 1) (get spec :kwonly) 0)\\n                   with-star (if star\\n                               (py/vconj slots\\n                                         (py/tuple (if (< n given) (data/subvec args n) [])))\\n                               slots)\\n                   with-ko (data/into with-star ko)]\\n               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\\n    [py/call (fn [f args] (py/call-kw f args []))]\\n    [py/condition-exception\\n     ;; Identity-owned provenance, separate from source-writable :attrs.\\n     ;; Attribute edits and leaving the creating activation preserve it;\\n     ;; reachability of the exception retains the entire condition/payload.\\n     ;; Only this constructor writes the private slot, never a guest marker\\n     ;; or a condition-shaped payload. No ambient identity registry is used.\\n     (fn [cls msg condition]\\n       (let [e (py/make-exc cls msg)]\\n         (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition))\\n             e)))]\\n    [py/retained-condition\\n     ;; The identity-owned slot a generated exception carries, read without\\n     ;; ever consulting source-writable :attrs; :py/missing when absent.\\n     ;; A local instance only: a foreign or forged value has no slot.\\n     (fn [e]\\n       (if (= (py/content-type e) :instance)\\n         (get (cell/get e) :py/retained-condition :py/missing)\\n         :py/missing))]\\n    [py/call-kw\\n     (fn [f args kwargs]\\n       (if (= (get f :py/type) :method)\\n         (py/call-kw (get f :fn) (data/into (py/vconj [] (get f :self)) args) kwargs)\\n         (if (= (py/content-type f) :class)\\n           (py/instantiate f args kwargs)\\n           (if (yang.call/eligible? f)\\n             (yang.call/invoke\\n               f args kwargs\\n               (fn [condition]\\n                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\\n                   (let [value (get condition :yang.call/value)]\\n                     (py/raise\\n                       (if (if (= (py/content-type value) :instance)\\n                             (py/subclass? (get (cell/get value) :class)\\n                                           py.b/BaseException)\\n                             false)\\n                         value\\n                         ;; A local hierarchy and fixed local message: neither\\n                         ;; foreign class names nor foreign methods participate.\\n                         (py/condition-exception\\n                           (py/make-class \\\"ForeignException\\\" py.b/Exception)\\n                           {:py/str \\\"foreign exception\\\"} condition))))\\n                   (py/raise\\n                     (py/condition-exception py.b/TypeError\\n                                             {:py/str \\\"object is not callable\\\"}\\n                                             condition)))))\\n             (if (= (py/content-type f) :function)\\n               (let [fc (cell/get f)]\\n                 ((get fc :code) (py/bind-args fc args kwargs)))\\n               (py/type-error {:py/str \\\"object is not callable\\\"}))))))]\\n    [py/instantiate\\n     (fn [cls args kwargs]\\n       (let [inst (py/make-instance cls)\\n             init (py/class-lookup cls \\\"__init__\\\")]\\n         ;; without __init__ only exception classes take arguments (they\\n         ;; become `args`); any other class takes none\\n         (do (if (= init :py/missing)\\n               (if (py/subclass? cls py.b/BaseException)\\n                 ;; the builtin exception constructor takes positional\\n                 ;; arguments only; an explicit __init__ binds keywords\\n                 (if (< 0 (data/count kwargs))\\n                   (py/type-error\\n                     (py/str (data/str-concat (get (cell/get cls) :name)\\n                                      