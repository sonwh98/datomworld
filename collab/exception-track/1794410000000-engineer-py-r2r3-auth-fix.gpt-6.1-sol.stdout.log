\n   229\\\\t     ;; normal exit runs `fin` here; raise and escapes run it as they\\\\n   230\\\\t     ;; unwind through the :finally frame\\\\n   231\\\\t     (fn [body fin]\\\\n   232\\\\t       (let [saved (cell/get php.rt/ctx)]\\\\n   233\\\\t         (do (php/set-handlers! (php/frame :finally fin (get saved :handlers)))\\\\n   234\\\\t             (let [v (body)]\\\\n   235\\\\t               (do (php/restore! saved)\\\\n   236\\\\t                   (fin :php/null)\\\\n   237\\\\t                   v)))))]\\\\n   238\\\\t    [php/call-ec\\\\n    72\\\\t       (do (cell/set! clj.rt/globals\\\\n    73\\\\t                      (assoc (cell/get clj.rt/globals) name value))\\\\n    74\\\\t           value))]\\\\n    75\\\\t    [clj/global-get\\\\n    76\\\\t     (fn [name]\\\\n    77\\\\t       (if (data/contains? (cell/get clj.rt/globals) name)\\\\n    78\\\\t         (get (cell/get clj.rt/globals) name)\\\\n    79\\\\t         :clj/unbound))]\\\\n    80\\\\t\\\\n    81\\\\t    ;; ------------------------------------------------------------- entry\\\\n    82\\\\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\\\\n    83\\\\t    ;; internal, so the entry removes one wrapper level from the\\\\n    84\\\\t    ;; program's value (a program returning that vector as data was\\\\n    85\\\\t    ;; wrapped again, so one level is exact). An error outcome passes\\\\n    86\\\\t    ;; through as the failure value for the caller to render.\\\\n    87\\\\t    [clj/unwrap-outcome\\\\n    88\\\\t     (fn [value]\\\\n    89\\\\t       (if (if (data/vector? value) (= (data/count value) 2) false)\\\\n    90\\\\t         (if (= (data/nth value 0) :yin.k/ok)\\\\n    91\\\\t           (data/nth value 1)\\\\n    92\\\\t           value)\\\\n    93\\\\t         value))]\\\\n    94\\\\t    ;; The global namespace is the task's, not the entry's: no reset\\\\n    95\\\\t    ;; here, so projections and earlier units' definitions survive.\\\\n    96\\\\t    [clj/run-main\\\\n    97\\\\t     (fn [body]\\\\n    98\\\\t       (do (clj/init!)\\\\n    99\\\\t           (clj/unwrap-outcome (body))))]])\\\\n   100\\\\t\\\\n   101\\\\t\\\\n   102\\\\t(def module-definitions\\\\n   103\\\\t  \\\\\\\"The module's definition list: an `:clj/uninit` placeholder for every\\\\n   104\\\\t   runtime key, then every definition, stripped.\\\\\\\"\\\\n   105\\\\t  (core/module-definitions \\\\\\\"clj\\\\\\\" :clj/uninit runtime-keys definitions))\\\\n   106\\\\t\\\\n   107\\\\t\\\\n   108\\\\t(def module-uast\\\\n   109\\\\t  \\\\\\\"The module tree: one wide application over the definitions, so every\\\\n   110\\\\t   sibling and runtime key read is discharged at module level.\\\\\\\"\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/exception-track/1794930000000-architect-exception-ruling-review.gpt-6-astra.stdout.log:50:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_24\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '1,130p' test/yang/typescript/antlr/source_call_test.cljc; sed -n '1,85p' test/yang/typescript/antlr/source_call_fixtures.cljc; rg -n 'yang.*(call|conformance)|source-call' test --glob '*runner*' --glob '*.cljd' --glob '*config*'; nl -ba src/cljc/yang/core/call.cljc | sed -n '1,245p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"(ns yang.typescript.antlr.source-call-test\\\\n  \\\\\\\"S11: real source calls through the shared convention (§8.10.11).\\\\n   The composition publishes the separately lowered PHP body, runs it, and\\\\n   projects its resolved functions into the JS global namespace. Neither\\\\n   frontend's call nodes or function bodies are rewritten.\\\\\\\"\\\\n  (:require\\\\n    [clojure.string :as str]\\\\n    [clojure.test :refer [deftest is testing]]\\\\n    [dao.test-slow :as slow]\\\\n    [yang.core.module :as core-module]\\\\n    [yang.core.uast :as u]\\\\n    [yang.php.antlr.lower :as php-lower]\\\\n    [yang.php.antlr.portable-harness :as php-h]\\\\n    [yang.php.antlr.prelude :as php-prelude]\\\\n    [yang.typescript.antlr.linked-harness :as h]\\\\n    [yang.typescript.antlr.lower :as lower]\\\\n    [yang.typescript.antlr.prelude :as prelude]\\\\n    [yang.typescript.antlr.prelude-parity-test :as parity]\\\\n    [yang.typescript.antlr.render :as render]\\\\n    [yang.typescript.antlr.source-call-fixtures :as fixtures]\\\\n    [yin.vm :as vm]))\\\\n\\\\n\\\\n(def ^:private published-php\\\\n  (delay (h/publish-guest-module!\\\\n           (php-prelude/module-spec (h/registry)\\\\n                                    (:call-address @h/published)))))\\\\n\\\\n\\\\n(defn- source-module\\\\n  \\\\\\\"An ordinary module exporting the unmodified lowered source body.\\\\\\\"\\\\n  [name packet]\\\\n  (core-module/module-spec\\\\n    :yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free\\\\n    (h/registry)\\\\n    {:name name,\\\\n     :ast (core-module/module-tree\\\\n            [(core-module/require-node 'php)\\\\n             (u/def! 'body (u/lam [] (php-lower/lower-module-body packet)))]),\\\\n     :exports '#{body},\\\\n     :runtime-name 'php,\\\\n     :runtime-address (:address @published-php)}))\\\\n\\\\n\\\\n(defn- projection\\\\n  \\\\\\\"Namespace composition only: preserve each resolved function cell.\\\\\\\"\\\\n  [names]\\\\n  (u/sexp->uast\\\\n    (cons 'do\\\\n          (map (fn [name]\\\\n                 (list 'js/define-global! name (list 'php/resolve-fn name name)))\\\\n               names))))\\\\n\\\\n\\\\n(defn- check-source\\\\n  [{:keys [module php-form functions ts-form expected]}]\\\\n  (let [expected {:js/out (str/split-lines expected), :js/uncaught nil}\\\\n        php-packet (php-h/packet php-form)\\\\n        ts-packet (php-h/packet ts-form)\\\\n        project (projection functions)\\\\n        bundled (u/mark-tails\\\\n                  (u/seq-nodes [(php-lower/lower-packet php-packet)\\\\n                                prelude/uast project\\\\n                                (u/app (u/v 'js/run-main) (lower/lower-unit ts-packet))]))]\\\\n    (testing \\\\\\\"bundled source on every VM\\\\\\\"\\\\n      (doseq [[backend run] parity/runners]\\\\n        (is (= expected (render/output (run bundled))) (str backend))))\\\\n    (testing \\\\\\\"published PHP source and linked JS on each admitted VM\\\\\\\"\\\\n      (let [donor (h/publish-guest-module! (source-module module php-packet))\\\\n            source (h/source {'yang.call (:call-address @h/published),\\\\n                              'js (:address @h/published),\\\\n                              'php (:address @published-php),\\\\n                              module (:address donor)})\\\\n            ast (u/mark-tails\\\\n                  (u/seq-nodes\\\\n                    [(core-module/require-node module)\\\\n                     (u/sexp->uast '(php/init!))\\\\n                     (u/app (u/v 'php/run-main) (u/v (symbol (str module) \\\\\\\"body\\\\\\\")))\\\\n                     (core-module/require-node 'yang.call)\\\\n                     (core-module/require-node 'js)\\\\n                     (u/sexp->uast '(js/init!))\\\\n                     project\\\\n                     (lower/lower-packet ts-packet {:prelude :linked})]))]\\\\n        (is (some? (:address donor)))\\\\n        (doseq [backend (keys h/backends)]\\\\n          (is (= :ok (get-in donor [:links (case backend\\\\n                                             :semantic :yin.semantic/code\\\\n                                             :stack :yin.debruijn.code\\\\n                                             :register :yin.debruijn.register)\\\\n                                    :status]))\\\\n              (str backend \\\\\\\" source publication\\\\\\\"))\\\\n          (is (= expected\\\\n                 (render/output\\\\n                   (vm/value (h/run-linked backend ast {:link-source source}))))\\\\n              (str backend)))))))\\\\n\\\\n\\\\n(deftest ^:slow source-calls-php-function-test\\\\n  (slow/guard \\\\\\\"source-calls-php-function-test\\\\\\\" #(check-source fixtures/direct)))\\\\n\\\\n\\\\n(deftest ^:slow source-foreign-store-and-callback-test\\\\n  (slow/guard \\\\\\\"source-foreign-store-and-callback-test\\\\\\\" #(check-source fixtures/callback)))\\\\n(ns yang.typescript.antlr.source-call-fixtures\\\\n  \\\\\\\"Real PHP and TS source with parser-produced CST forms. Regeneration is\\\\n   checked by source-call-parser-test; portable hosts lower these same forms.\\\\\\\")\\\\n\\\\n\\\\n(def direct\\\\n  '{:module phpm.s11-direct,\\\\n    :php-source\\\\n    \\\\\\\"<?php function phpfn($x, $y = 2.5) { return $x + $y; }\\\\\\\\n             function identity($x) { return $x; }\\\\\\\",\\\\n    :functions [\\\\\\\"phpfn\\\\\\\" \\\\\\\"identity\\\\\\\"],\\\\n    :ts-source\\\\n    \\\\\\\"const stored = identity(phpfn);\\\\\\\\n     console.log(stored === phpfn, stored(1.5), phpfn(1.5, 3.5));\\\\\\\\n     const box = {f: stored}; console.log(box.f(2.5));\\\\\\\",\\\\n    :expected \\\\\\\"true 4 5\\\\\\\\n5\\\\\\\",\\\\n    :php-form\\\\n    [:htmlDocument\\\\n     [:phpBlock\\\\n      [:topStatement\\\\n       [:functionDeclaration\\\\n        [\\\\\\\"Function_\\\\\\\" \\\\\\\"function\\\\\\\"]\\\\n        [:identifier [\\\\\\\"Label\\\\\\\" \\\\\\\"phpfn\\\\\\\"]]\\\\n        [\\\\\\\"OpenRoundBracket\\\\\\\" \\\\\\\"(\\\\\\\"]\\\\n        [:formalParameterList\\\\n         [:formalParameter [:variableInitializer [\\\\\\\"VarName\\\\\\\" \\\\\\\"$x\\\\\\\"]]]\\\\n         [\\\\\\\"Comma\\\\\\\" \\\\\\\",\\\\\\\"]\\\\n         [:formalParameter\\\\n          [:variableInitializer\\\\n           [\\\\\\\"VarName\\\\\\\" \\\\\\\"$y\\\\\\\"]\\\\n           [\\\\\\\"Eq\\\\\\\" \\\\\\\"=\\\\\\\"]\\\\n           [:constantInitializer [:constant [:literalConstant [\\\\\\\"Real\\\\\\\" \\\\\\\"2.5\\\\\\\"]]]]]]]\\\\n        [\\\\\\\"CloseRoundBracket\\\\\\\" \\\\\\\")\\\\\\\"]\\\\n        [:blockStatement\\\\n       