r/prelude.cljc && sed -n '1150,1250p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '2500,2598p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '2060,2092p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '1,145p' test/yang/call/conformance.clj && sed -n '315,431p' test/yang/call/conformance.clj && sed -n '460,510p' test/yang/call/conformance.clj && ls -la .cpcache && ls -l build/antlr/python3/classes\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '155,220p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '1150,1250p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '2500,2598p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '2060,2092p' src/cljc/yang/python/antlr/prelude.cljc && sed -n '1,145p' test/yang/call/conformance.clj && sed -n '315,431p' test/yang/call/conformance.clj && sed -n '460,510p' test/yang/call/conformance.clj && ls -la .cpcache && ls -l build/antlr/python3/classes\\\"\",\"aggregated_output\":\"   digits `py/float-repr` lays out by the same rule as the boundary\\n   renderer. `print` checks the digit limit of every integer it shows\\n   before it appends anything.\\n\\n   Sequence repetition (C3 slice S7, ruling 11) checks the exact size of\\n   its result against the composition's `data/max-items` before it\\n   builds anything; a larger one raises MemoryError. A composition\\n   proves it supplies every host name, `data/max-items` and the version\\n   4 `integer` exports included, through `admit` before a program runs.\\n\\n   Two emitters, one source (C4 slice P2): `definitions` is the only\\n   definition list. `uast` is the bundled prelude a program tree carries\\n   ahead of its body; `module-uast` is the same list as the linker\\n   module `py` (`module-exports`, `module-spec`), which a linked program\\n   requires instead. The module emitter strips only the module's own\\n   namespace `py/`; `py.b/*` and `py.rt/*` stay qualified internal keys,\\n   each runtime key with a module-level `:py/uninit` placeholder so the\\n   linker's scanners discharge the bodies that read it before `py/init!`\\n   defines it. `py/vconj` and `py/lnot` are not `py/conj` and `py/not`\\n   because a bare key equal to a primitive name would shadow that\\n   primitive inside the module. `py/rt-ctx` and `py/rt-limit` (P3) hand\\n   the hook prelude the two cells this prelude owns, which a linked\\n   `pysp` closure cannot name across the module boundary.\\n\\n   Host names the prelude depends on and does not define: `host-names`\\n   (the cell module from yin.vm.module, the integer module from\\n   yin.vm.integer, the rest from yin.vm.data).\\\"\\n  #?(:cljs (:require-macros [yang.python.antlr.prelude :refer [defquoted]]))\\n  (:require\\n    #?(:cljd [clojure.edn :as edn])\\n    [yang.core.call :as call]\\n    [yang.core.prelude :as core]\\n    [yang.python.antlr.uast :as u]\\n    [yin.vm.integer :as integer]))\\n\\n\\n#?(:clj\\n   (defmacro defquoted\\n     \\\"`def` of the quoted data `form`.  ClojureDart compiles quoted data to\\n      straight-line Dart (this prelude is about 65,000 lines of it), which the\\n      Dart AOT compiler cannot take as one initializer, so there the data is\\n      one EDN string read back at load.\\\"\\n     [name doc form]\\n     (if (find-ns 'cljd.compiler)\\n       (list 'def name doc (list 'edn/read-string (pr-str (second form))))\\n       (list 'def name doc form))))\\n\\n\\n(def host-names\\n  \\\"Module exports the prelude calls.\\\"\\n  (into '#{cell/new cell/get cell/set! data/count data/into data/subvec\\n           data/number? data/contains? data/dissoc data/str-concat data/str-length\\n           data/str-index-of data/str->code-points data/code-points->str\\n           data/float64 data/float-value data/content=\\n           integer/add integer/sub integer/neg integer/mul integer/compare\\n           integer/to-float integer/compare-float integer/true-div\\n           integer/pow integer/shift-right integer/bit-and\\n           integer/bit-or integer/bit-xor integer/bit-not integer/from-float\\n           integer/floor-div-mod integer/shift-left integer/format integer/parse\\n           integer/float-digits integer/decimal->float integer/max-digits\\n           data/substring data/max-items}\\n        call/host-names))\\n\\n\\n(defquoted ^:private core-definitions\\n  \\\"Pure definitions: lambdas only, so defining them runs nothing.\\\"\\n     ;; py/import-from falls back from (I2)\\n     (fn [o name]\\n       (if (py/cell? o)\\n         (let [c (cell/get o)\\n               t (get c :py/type)]\\n           (if (= t :instance)\\n             (let [own (get (get c :attrs) name :py/missing)]\\n               (if (= own :py/missing)\\n                 (let [m (py/class-lookup (get c :class) name)]\\n                   (if (= m :py/missing) :py/missing (py/bind o m)))\\n                 own))\\n             (if (= t :module)\\n               ;; the module's dict is its namespace, so every attribute\\n               ;; (the dunders py/module-new sets included) reads through\\n               ;; it; `__dict__` is the dict itself (C4 I1). The lookup\\n               ;; key is a call: a map literal here would embed the symbol\\n               (if (= name \\\"__dict__\\\")\\n                 (get c :dict)\\n                 (let [dc (do (py/import-namespace-check (get c :dict) (py/str name) false)\\n                              (cell/get (get c :dict)))\\n                       slot (get (get dc :index)\\n                                 (assoc {} :py/str name)\\n                                 :py/missing)]\\n                   (if (= slot :py/missing)\\n                     :py/missing\\n                     (get (get dc :vals) slot))))\\n               (if (= t :class)\\n                 (let [m (py/class-lookup o name)]\\n                   (if (= m :py/missing)\\n                     (if (= name \\\"__name__\\\") (py/str (get c :name)) :py/missing)\\n                     m))\\n                 (if (= t :list)\\n                   (if (= name \\\"append\\\")\\n                     (py/method o py.b/list-append)\\n                     :py/missing)\\n                   (if (= t :function)\\n                     (if (= name \\\"__name__\\\")\\n                       (py/str (get c :name))\\n                       :py/missing)\\n                     (if (= t :set)\\n                       (if (= name \\\"add\\\") (py/method o py.b/set-add) :py/missing)\\n                       (if (= t :dict)\\n                         (if (= name \\\"items\\\")\\n                           (py/method o py.b/dict-items)\\n                           (if (= name \\\"keys\\\")\\n                             (py/method o py.b/dict-keys)\\n                             (if (= name \\\"values\\\")\\n                               (py/method o py.b/dict-values)\\n                               (if (= name \\\"get\\\")\\n                                 (py/method o py.b/dict-get)\\n                                 :py/missing))))\\n                         (if (= t :generator)\\n                           (py/gen-attr o name)\\n                           (if (= t :iterator)\\n                             (if (= name \\\"__next__\\\")\\n                               (py/method o py.b/gen-next)\\n                               (if (= name \\\"__iter__\\\")\\n                                 (py/method o py.b/gen-iter)\\n                                 :py/missing))\\n                             :py/missing))))))))))\\n         :py/missing))]\\n    [py/getattr\\n     (fn [o name]\\n       (let [x (py/lookup-attr o name)]\\n         (if (= x :py/missing) (py/attr-error name) x)))]\\n    [py/setattr\\n     (fn [o name x]\\n       (if (py/cell? o)\\n         (let [c (cell/get o)\\n               t (get c :py/type)]\\n           (if (if (= t :instance) true (= t :class))\\n             (do (cell/set! o (assoc c :attrs (assoc (get c :attrs) name x)))\\n                 :py/None)\\n             (if (= t :module)\\n               ;; a module attribute is a binding in the module's dict\\n               ;; (C4 I1), so the module's own functions see the write;\\n               ;; the key is a call, as py/getattr's\\n               (do (py/dict-set (get c :dict) (assoc {} :py/str name) x)\\n                   :py/None)\\n               (py/attr-error name))))\\n         (py/attr-error name)))]\\n\\n    ;; ---------------------------------------------------------- numbers\\n    ;; Exact integer arithmetic goes through the module's guarded kernels.\\n    [py/as-float\\n     ;; The integer bridge can refuse before any host float operation.\\n     (fn [a]\\n       (if (py/float? a)\\n         (py/num a)\\n         (data/float-value (py/int-result (integer/to-float (py/num a))))))]\\n    [py/arith\\n     (fn [op a b]\\n       (if (py/numeric? a)\\n         (if (py/numeric? b)\\n           (if (if (py/float? a) true (py/float? b))\\n             (let [x (py/as-float a)\\n                   y (py/as-float b)]\\n               (py/float (if (= op :add) (+ x y)\\n                             (if (= op :sub) (- x y) (* x y)))))\\n             (let [x (py/num a)\\n                   y (py/num b)]\\n       (let [c (cell/get d)]\\n         (py/list (py/zip-pairs (get c :keys) (get c :vals) 0 []))))]\\n    [py/zip-pairs\\n     (fn [ks vs i acc]\\n       (let [k (get ks i :py/stop)]\\n         (if (= k :py/stop)\\n           acc\\n           (py/zip-pairs ks vs (+ i 1)\\n                         (conj acc (py/tuple (conj (conj [] k) (get vs i))))))))]\\n    [py/range-args\\n     (fn [a rest]\\n       (let [xs (get rest :items)\\n             n (data/count xs)]\\n         (if (= n 0)\\n           (py/range3 0 a 1)\\n           (if (= n 1)\\n             (py/range3 a (get xs 0) 1)\\n             (if (= n 2)\\n               (py/range3 a (get xs 0) (get xs 1))\\n               (py/type-error {:py/str \\\"range expected at most 3 arguments\\\"}))))))]\\n\\n    ;; ---------------------------------------------------------- print\\n    [py/snapshot\\n     (fn [x]\\n       (if (py/str? x)\\n         (get x :py/str)\\n         (if (= x :py/None)\\n           nil\\n           (if (py/cell? x)\\n             (py/snapshot-obj (cell/get x))\\n             (if (= (get x :py/type) :method)\\n               :py/method\\n               (if (= (get x :py/type) :tuple)\\n                 (assoc {} :py/tuple (py/snapshot-all (get x :items) 0 []))\\n                 (if (= (get x :py/type) :range)\\n                   (assoc {}\\n                          :py/range\\n                          (py/vconj (py/vconj (py/vconj [] (get x :start))\\n                                              (get x :stop))\\n                                    (get x :step)))\\n                   x)))))))]\\n    [py/snapshot-all\\n     (fn [xs i acc]\\n       (let [x (get xs i :py/stop)]\\n         (if (= x :py/stop)\\n           acc\\n           (py/snapshot-all xs (+ i 1) (conj acc (py/snapshot x))))))]\\n    [py/snapshot-pairs\\n     (fn [ks vs i acc]\\n       (let [k (get ks i :py/stop)]\\n         (if (= k :py/stop)\\n           acc\\n           (py/snapshot-pairs ks vs (+ i 1)\\n                              (conj acc (conj (conj [] (py/snapshot k))\\n                                              (py/snapshot (get vs i))))))))]\\n    [py/snapshot-obj\\n     (fn [c]\\n       (let [t (get c :py/type)]\\n         (if (= t :list)\\n           (py/snapshot-all (get c :items) 0 [])\\n           (if (= t :dict)\\n             (assoc {} :py/dict (py/snapshot-pairs (get c :keys) (get c :vals) 0 []))\\n             (if (= t :instance)\\n               (assoc {} :py/instance (get (cell/get (get c :class)) :name))\\n               (if (= t :class)\\n                 (assoc {} :py/class (get c :name))\\n                 (if (= t :function)\\n                   (assoc {} :py/function (get c :name))\\n                   (if (= t :set)\\n                     (assoc {} :py/set (py/snapshot-all (get c :keys) 0 []))\\n                     (if (= t :generator)\\n                       (assoc {} :py/generator (get c :name))\\n                       (if (= t :iterator)\\n                         (assoc {} :py/iterator \\\"iterator\\\")\\n                         (if (= t :module)\\n                           (assoc {} :py/module (get c :name))\\n                           :py/object)))))))))))]\\n    [py/snapshot-exc\\n     (fn [e]\\n       (if (= (py/content-type e) :instance)\\n         (let [c (cell/get e)]\\n           (assoc (assoc {} :type (get (cell/get (get c :class)) :name))\\n                  :args\\n                  (py/snapshot-all (get (get (get c :attrs) \\\"args\\\" (py/tuple []))\\n                                        :items)\\n                                   0\\n                                   [])))\\n         (py/snapshot e)))]\\n    [py/check-print-all\\n     (fn [xs i]\\n       (let [x (get xs i :py/stop)]\\n         (if (= x :py/stop)\\n           :py/None\\n           (do (py/check-print x) (py/check-print-all xs (+ i 1))))))]\\n    [py/check-print\\n     ;; The digit limit of every integer print will show, in the shapes\\n     ;; py/snapshot walks, so a breach raises before py.rt/out changes.\\n     ;; Small integers too: the `small` profile's limit is 5 digits.\\n     (fn [x]\\n                                   (py/reindex ks2 0 {})))\\n                 :py/None)))))]\\n    [py/global-del-quiet (fn [g n] (py/dict-del-quiet g n))]\\n    [py/global-del\\n     ;; strict `del x` at module level: must be bound in the module's own dict,\\n     ;; never falling back to builtins; absent is NameError\\n     (fn [g n]\\n       (if (py/dict-has? g n)\\n         (py/dict-del-quiet g n)\\n         (py/raise-new py.b/NameError\\n                       (py/str (data/str-concat \\\"name '\\\" (get n :py/str)\\n                                                \\\"' is not defined\\\")))))]\\n    [py/delattr-quiet\\n     (fn [o name]\\n       (let [c (cell/get o)]\\n         (do (cell/set! o (assoc c :attrs (data/dissoc (get c :attrs) name)))\\n             :py/None)))]\\n    [py/class-ns-del\\n     ;; strict `del x` inside class body: must exist in class attrs, else NameError\\n     (fn [cls name]\\n       (let [c (cell/get cls)]\\n         (if (not (= (get (get c :attrs) name :py/missing) :py/missing))\\n           (do (cell/set! cls (assoc c :attrs (data/dissoc (get c :attrs) name)))\\n               :py/None)\\n           (py/raise-new py.b/NameError\\n                         (py/str (data/str-concat \\\"name '\\\" name \\\"' is not defined\\\"))))))]\\n    [py/delattr\\n     ;; `del o.name` (C4 I1): a module binding removed from the module's\\n     ;; dict, AttributeError naming the attribute when it is absent; the\\n     ;; keys are calls, as py/getattr's\\n     (fn [o name]\\n       (let [c (cell/get o)]\\n         (if (= (get c :py/type) :module)\\n(ns yang.call.conformance\\n  \\\"The cross-language calling gates' shared composition (docs/design/\\n   yang.antlr.md section 8.10.11): a donor program's named export reaches a\\n   caller program by explicit published-export composition only.\\n\\n   A donor is real source of any admitted frontend, lowered unmodified and\\n   published as an ordinary linker module whose one export, `body`, is the\\n   lowered unit. A caller task requires that module, runs its body under the\\n   donor runtime's own entry (`js/run-main`, `php/run-main`, `py/run-main`,\\n   `clj/run-main`), reads each named export from the donor runtime's global\\n   namespace, and projects it into the caller runtime's namespace under the\\n   same name; then the caller source, lowered unmodified, runs under its own\\n   entry. The composition is a sequence of top-level nodes: no call node is\\n   rewritten, no foreign `:code` is extracted, no language-pair wrapper is\\n   inserted, and the projected value is the donor's own callable value\\n   (identity survives).\\n\\n   A callable value is task-local (a function is a cell, and cells are\\n   task-local, section 8.11), so the export is answered as a node evaluated\\n   in the caller's task, never as a host value carried between tasks.\\n   `export-program` answers the donor's export alone as the program's value.\\n\\n   Every program runs linked on the three vector VMs (`semantic`, `stack`,\\n   `register`) over the TypeScript linked harness's content store, where\\n   `yang.call` and `js` already live and `php`, `py` and `clj` are\\n   published beside them. The AST walker is not a backend: its links are\\n   refused until L-b.\\\"\\n  (:require\\n    [clojure.string :as str]\\n    [yang.clojure :as clj-comp]\\n    [yang.clojure.prelude :as clj-prelude]\\n    [yang.core.module :as core-module]\\n    [yang.core.names :as names]\\n    [yang.core.uast :as u]\\n    [yang.php.antlr.cst :as php-cst]\\n    [yang.php.antlr.lower :as php-lower]\\n    [yang.php.antlr.portable-harness :as php-h]\\n    [yang.php.antlr.prelude :as php-prelude]\\n    [yang.python.antlr.lower :as py-lower]\\n    [yang.python.antlr.parser :as py-parser]\\n    [yang.python.antlr.prelude :as py-prelude]\\n    [yang.python.antlr.render :as py-render]\\n    [yang.typescript.antlr.cst :as ts-cst]\\n    [yang.typescript.antlr.linked-harness :as h]\\n    [yang.typescript.antlr.lower :as ts-lower]\\n    [yang.typescript.antlr.render :as render]\\n    [yin.vm :as vm]))\\n\\n\\n(defn- publish-guest!\\n  \\\"Publish guest module `spec` into the harness store, throwing immediately\\n   with `result` in ex-data if publication is refused.\\\"\\n  [spec]\\n  (let [result (h/publish-guest-module! spec)]\\n    (when (= :refused (:status result))\\n      (throw (ex-info (str \\\"Guest module publication refused: \\\" (or (:reason result) (:status result)))\\n                      result)))\\n    result))\\n\\n\\n(def ^:private published-php\\n  \\\"`php` published once into `js`'s content store, pinning the same\\n   `yang.call` revision (as `source-call-test` publishes it).\\\"\\n  (delay (publish-guest!\\n           (php-prelude/module-spec (h/registry)\\n                                    (:call-address @h/published)))))\\n\\n\\n(def ^:private published-py\\n  \\\"`py` published beside `js` and `php`, over the same host registry and\\n   `yang.call` revision.\\\"\\n  (delay (publish-guest!\\n           (py-prelude/module-spec (h/registry)\\n                                   (:call-address @h/published)))))\\n\\n\\n(def ^:private published-clj\\n  \\\"`clj` published beside `js`, `php` and `py`, over the same host registry\\n   and `yang.call` revision.\\\"\\n  (delay (publish-guest!\\n           (clj-prelude/module-spec (h/registry)\\n                                    (:call-address @h/published)))))\\n\\n\\n(defn- parse-ok\\n  \\\"The CST packet of `source` under `parse`, refused unless the parse is ok.\\\"\\n  [parse source]\\n  (let [pk (parse source)]\\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\\n      (throw (ex-info \\\"donor or caller source does not parse\\\"\\n                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\\n    pk))\\n\\n\\n(defn- python-export-symbol\\n  [export]\\n  (symbol (str \\\"xlang.python.export.\\\" export)))\\n\\n\\n(defn- python-unit\\n  [packet exports]\\n  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\\n         (u/seq-nodes\\n           (concat (map (fn [export]\\n                          (u/sexp->uast\\n                            (list 'py/global-set py-lower/globals-sym\\n                                  {:py/str export} (python-export-symbol export))))\\n                        exports)\\n                   [(py-lower/lower-module-body packet)]))))\\n\\n\\n(def frontends\\n  \\\"Each admitted frontend's profile, as data:\\n\\n   - `:runtime`, `:address`: the runtime module and its published address;\\n   - `:refusal`: the publication refusal key and reason of its modules;\\n   - `:deps` (optional): pinned requirements beyond the runtime its\\n     lowered units read directly (the clojure unit's `yang.call` reads);\\n   - `:parse`: source text to CST packet;\\n   - `:unit`: packet and projected exports to the lowered unit its\\n     `:run-main` entry takes;\\n   - `:read-export`: export name to the form reading the runtime's global\\n     namespace (JS `globalThis`, PHP's named-function table, Python's main\\n     module dictionary, the clojure runtime's task-local namespace cell);\\n   - `:project`: name and a value form to the form binding the value where\\n     the runtime's source resolves a called name;\\n   - `:render`: the `:run-main` value as test data.\\\"\\n  {:typescript\\n   {:runtime 'js,\\n    :address #(:address @h/published),\\n    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\\n    :parse #(parse-ok ts-cst/parse-source %),\\n    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\\n    :run-main 'js/run-main,\\n    :read-export (fn [export] (list 'js/global-get {:js/str export})),\\n    :project (fn [name value] (list 'js/define-global! name value)),\\n    :render render/output},\\n   :php\\n   {:runtime 'php,\\n    :address #(:address @published-php),\\n    :refusal [:yang.php/refusal :yang.php/undeclared-free],\\n    :parse #(parse-ok php-cst/parse-source %),\\n    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\\n    :run-main 'php/run-main,\\n    :read-export (fn [export]\\n\\n\\n(defn call\\n  \\\"Publish the donor `[frontend source]`, compose its `exports` into the\\n   caller `[frontend source]`, run it on each vector VM and answer the\\n   caller's rendered value when every backend agrees (else\\n   `{:disagreement {backend rendered}}`).\\\"\\n  [[donor-frontend donor-source] exports [caller-frontend caller-source]]\\n  (let [donor (publish-donor! donor-frontend donor-source)\\n        render (:render (profile caller-frontend))]\\n    (agreed (update-vals (run-program donor (compose donor exports caller-frontend\\n                                                     caller-source))\\n                         render))))\\n\\n\\n(defn export-form\\n  \\\"The guest form reading a source-produced export after composition. This\\n   reads the public namespace, never the callable's private code slot.\\\"\\n  [frontend export]\\n  ((:read-export (profile frontend)) export))\\n\\n\\n(defn compose-exception\\n  \\\"Compose real donor/caller source exactly as `compose` does, optionally\\n   followed by an unlowered boundary observation form. The source bodies\\n   and their call nodes are untouched. Boundary forms are for provenance\\n   assertions and malformed invocations, not substitute source-pair legs.\\\"\\n  ([donor exports caller-frontend caller-source]\\n   (compose donor exports caller-frontend caller-source))\\n  ([donor exports caller-frontend caller-source observation]\\n   (u/mark-tails\\n     (u/then (compose donor exports caller-frontend caller-source)\\n             (u/sexp->uast observation)))))\\n\\n\\n(defn observation-map-form\\n  \\\"Emit a map whose known observation values are guest expressions.\\n   sexp->uast intentionally treats a map literal as DATA, including lists\\n   and symbols within it. Dynamic boundary observations use explicit assoc,\\n   never a transformation of parsed source or a runtime shape detector.\\\"\\n  [entries]\\n  (reduce (fn [form [k value]] (list 'assoc form k value)) {} entries))\\n\\n\\n(defn observation-vector-form\\n  \\\"Emit a boundary argument vector of evaluated expressions. Like maps,\\n   vectors in sexp->uast are otherwise literal data.\\\"\\n  [expressions]\\n  (reduce (fn [form value] (list 'conj form value)) [] expressions))\\n\\n\\n(defn boundary-call-form\\n  \\\"An abortive observer of a public entry, as guest code. All arguments are\\n   forms. `options` selects invoke-with when present. A returned envelope\\n   is recorded as :return; only the supplied exit records :raise. Transfer\\n   count and the after-call sentinel live in task cells. No payload is\\n   snapshotted here: assertions must precede rendering.\\\"\\n  ([callee positional named]\\n   (boundary-call-form callee positional named nil))\\n  ([callee positional named options]\\n   (let [phase (gensym \\\"phase\\\")\\n         transfers (gensym \\\"transfers\\\")\\n         after (gensym \\\"after\\\")\\n         escape (gensym \\\"escape\\\")\\n         condition (gensym \\\"condition\\\")\\n         returned (gensym \\\"returned\\\")\\n         raise (list 'fn [condition]\\n                     (list 'do\\n                           (list 'cell/set! transfers (list '+ 1 (list 'cell/get transfers)))\\n                           (list escape\\n                                 (observation-map-form\\n                                   {:route :raise :condition condition\\n                                    :transfers (list 'cell/get transfers)\\n                                    :after (list 'cell/get after)}))))\\n         invocation (if options\\n                      (list 'yang.call/invoke-with callee positional named raise options)\\n                      (list 'yang.call/invoke callee positional named raise))]\\n     (list 'let [phase (list 'cell/new false)\\n                 transfers (list 'cell/new 0) after (list 'cell/new false)]\\n           (list (list 'fn [escape]\\n                       (list 'if (list 'cell/get phase)\\n                             escape\\n                             (list 'do (list 'cell/set! phase true)\\n                                   (list 'let [returned invocation]\\n                                         (list 'do (list 'cell/set! after true)\\n                                               (observation-map-form\\n                                                 {:route :return :value returned\\n                                                  :transfers (list 'cell/get transfers)\\n                                                  :after (list 'cell/get after)}))))))\\n                 (list '%capture))))))\\n\\n\\n(defn guard-exceptions-form\\n  \\\"Diagnostic outer handlers: expose an escape that bypassed the supplied\\n   boundary exit as :unbridged, rather than letting no-handler obscure the\\n   assertion. These are NOT replacement callee bridges: :unbridged always\\n   fails the provenance contract. Catch data stays guest-local.\\\"\\n  [frontend-keys form]\\n  (reduce\\n    (fn [body frontend]\\n      (let [e (gensym \\\"unbridged\\\")\\n            handler (list 'fn [e] {:route :unbridged :frontend frontend})]\\n        (case frontend\\n          :typescript (list 'js/try (list 'fn [] body) handler)\\n          (:python :php)\\n          (let [result (gensym \\\"result\\\")\\n                try-name (if (= frontend :python) 'py/try 'php/try)]\\n            (list 'let [result (list 'cell/new nil)]\\n                  (list try-name\\n                        (list 'fn [] (list 'cell/set! result body))\\n                        handler\\n                        (list 'fn [] (list 'cell/get result)))))\\n          :clojure body)))\\n    form (distinct frontend-keys)))\\n\\n\\n(defn exception-outcome\\n\\n\\n(defn error-results\\n  \\\"Map `e` across each vector VM backend as an operational failure.\\\"\\n  [e]\\n  (into (sorted-map) (map (fn [backend] [backend e]) (keys h/backends))))\\n\\n\\n(defn run-exception-program\\n  \\\"The exception probes' independent VM runs, concurrent on the JVM. Each\\n   job owns its registry, task, link pair AND content-serving composition;\\n   no stream cursor is shared. Only the published content store is read\\n   by all three. A host Exception is kept as the original host object for\\n   clojure.test's :error reporting, NEVER relabelled as a guest condition.\\n   All jobs settle even if one fails. `run-program` is unchanged.\\\"\\n  [donor ast]\\n  (try\\n    ;; Resolve publication delays before starting independent readers.\\n    (link-source donor)\\n    (let [jobs (mapv (fn [backend]\\n                       [backend\\n                        (future\\n                          (try\\n                            (vm/value\\n                              (h/run-linked backend ast\\n                                            {:modules (modules)\\n                                             :link-source (link-source donor)}))\\n                            (catch Exception e e)))])\\n                     (keys h/backends))]\\n      (into (sorted-map)\\n            (map (fn [[backend job]] [backend @job])) jobs))\\n    (catch Throwable e\\n      (error-results e))))\\ntotal 2888\\ndrwxr-xr-x@ 44 sto  staff   1408 Nov 11 12:43 .\\ndrwxr-xr-x@ 61 sto  staff   1952 Nov  7 10:29 ..\\n-rw-r--r--@  1 sto  staff  84622 Nov 11 07:30 1360937979.basis\\n-rw-r--r--@  1 sto  staff  11856 Nov 11 07:30 1360937979.cp\\n-rw-r--r--@  1 sto  staff  84470 Nov 11 03:38 2276128749.basis\\n-rw-r--r--@  1 sto  staff  11851 Nov 11 03:38 2276128749.cp\\n-rw-r--r--@  1 sto  staff  90526 Nov  7 10:38 2410757473.basis\\n-rw-r--r--@  1 sto  staff  12894 Nov  7 10:38 2410757473.cp\\n-rw-r--r--@  1 sto  staff     18 Nov  7 10:38 2410757473.main\\n-rw-r--r--@  1 sto  staff  84655 Nov  7 13:39 2602022000.basis\\n-rw-r--r--@  1 sto  staff  11859 Nov  7 13:39 2602022000.cp\\n-rw-r--r--@  1 sto  staff  86757 Nov  7 13:38 2770481537.basis\\n-rw-r--r--@  1 sto  staff  12246 Nov  7 13:38 2770481537.cp\\n-rw-r--r--@  1 sto  staff     18 Nov  7 13:38 2770481537.main\\n-rw-r--r--@  1 sto  staff  98606 Nov  6 00:31 3555353264.basis\\n-rw-r--r--@  1 sto  staff  14277 Nov  6 00:31 3555353264.cp\\n-rw-r--r--@  1 sto  staff  94911 Nov 11 12:33 357380518.basis\\n-rw-r--r--@  1 sto  staff  13482 Nov 11 12:33 357380518.cp\\n-rw-r--r--@  1 sto  staff      8 Nov 11 12:33 357380518.jvm\\n-rw-r--r--@  1 sto  staff     25 