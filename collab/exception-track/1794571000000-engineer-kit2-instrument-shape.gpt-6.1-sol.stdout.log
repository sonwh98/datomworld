nor)\n                (map (fn [export]\n                       (let [value (symbol (str \"xlang.export.\" export))]\n                         (u/let1 value\n                                 (u/sexp->uast (read-export export))\n                                 (u/sexp->uast (project export value)))))\n                     exports)\n                [(u/app (u/v run-main) (unit (parse caller-source) exports))])))))\n\n\n(defn link-source\n  \"The serving composition naming the runtimes and the donor module.\"\n  [{:keys [module address]}]\n  (h/source {'yang.call (:call-address @h/published),\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.call.exception-source-test\nLoading initial Timbre config from: :default\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\nKIT2-UNCHANGED {:contract-fixtures 47, :frontend-source-and-donor-strings 3, :fixture-observation-forms 34, :non-php-donor-leg-observation-forms 69}\n","exit_code":0,"status":"completed"}}
