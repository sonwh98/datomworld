     854b74c3 [exception-r3-impl]\n/Users/sto/workspace/datomworld-roundC                           81648a4b [roundC-p9-fixtures]\n/Users/sto/workspace/datomworld-wp-w0a                           be1a3a25 [wp-w0a]\n/Users/sto/workspace/datomworld-xlink                            b0463cd2 [fix/exception-kit-donor-publication]\n/Users/sto/workspace/datomworld-yang-s9                          12d14e1e [yang-slice9]\n/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j4d-fixes 67aa4cd2 [jolt-j4d-fixes]\n/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j5        0fe6ad0d [jolt-j5]\n/Users/sto/workspace/datomworld/r3-fix-wt                        fbd8da0f (detached HEAD)\n0001-refactor-yin.repl-decouple-engine-from-DHT-and-extra.patch\n0001-test-yin.repl-pin-baseline-contracts-and-parameteriz.patch\n8f2-head-hjroh20c\nMozillaUpdateLock-1F42C145FFDD4120\nRustDesk-501\nacc.md\naccept-detail.txt\nack-marker\nadd_helpers.py\nadd_startup.py\nanalyze_dht_test_create_state.py\nanalyze_failures.py\napply_dht_test_adapter.py\napply_dht_test_updates.py\napply_remaining_fixes.py\napply_replacements.py\napply_step_adapter.py\napply_test_fixes.py\nargon-ruling.txt\narms.py\nastra-confirm.md\nastra-confirm2.md\nastra-final.md\nastra-jupiter.md\nastra-reconfirm.md\n(ns yang.python.antlr.exception-call-test\n  \"Round 0's six Python-containing pairs, plus the RETIRE Clojure-caller pairs.\n   Other JS/PHP/Clojure-only pairs remain pending in the shared matrix.\n   A red result is a runtime divergence, never the expected test value.\"\n  (:require [clojure.test :refer [deftest is testing do-report]]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]))\n\n\n(defn- check-pair\n  [donor caller]\n  (let [observations (legs/run-pair donor caller)]\n    (doseq [{:keys [id scenario] :as leg}\n            (filter #(and (= donor (:donor %)) (= caller (:caller %)))\n                    contract/pair-matrix)]\n      (testing (str id)\n        (try\n          (let [expected (legs/expected leg)\n                results (get observations id)]\n            (println \"EXCEPTION-PAIR\"\n                     (pr-str {:id id :gates (:gates leg) :frontends (:frontends leg)\n                              :expected expected\n                              :results (update-vals results #(if (instance? Throwable %)\n                                                               {:host/error (.getMessage ^Throwable %)\n                                                                :host/data (ex-data %)} %))\n                              :status (update-vals results #(cond (instance? Throwable %) :error\n                                                                  (= expected %) :green :else :red))}))\n            (doseq [[backend actual] results]\n              (if (instance? Throwable actual)\n                (do-report {:type :error :message (str id \" \" backend \" operational failure\")\n                            :expected expected :actual actual})\n                (is (= expected actual) (str donor \" -> \" caller \" \" scenario \" \" backend)))))\n          (catch Exception e\n            (do-report {:type :error :message (str id \" source leg failed to execute\")\n                        :expected (legs/expected leg) :actual e})))))))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :typescript}}\n  python-to-typescript-test (check-pair :python :typescript))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :typescript}}\n  typescript-to-python-test (check-pair :typescript :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :php}}\n  python-to-php-test (check-pair :python :php))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :php}}\n  php-to-python-test (check-pair :php :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2