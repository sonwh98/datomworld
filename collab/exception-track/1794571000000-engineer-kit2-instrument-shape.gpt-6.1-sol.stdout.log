n/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\" \"build/antlr/php/classes\"\n         \"build/antlr/typescript/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n              