                     (list 'let [returned invocation]\n                                         (list 'do (list 'cell/set! after true)\n                                               (observation-map-form\n                                                 {:route :return :value returned\n                                                  :transfers (list 'cell/get transfers)\n                                                  :after (list 'cell/get after)}))))))\n                 (list '%capture))))))\n\n\n(defn guard-exceptions-form\n  \"Diagnostic outer handlers: expose an escape that bypassed the supplied\n   boundary exit as :unbridged, rather than letting no-handler obscure the\n   assertion. These are NOT replacement callee bridges: :unbridged always\n   fails the provenance contract. Catch data stays guest-local.\"\n  [frontend-keys form]\n  (reduce\n    (fn [body frontend]\n      (let [e (gensym \"unbridged\")\n            handler (list 'fn [e] {:route :unbridged :frontend frontend})]\n        (case frontend\n          :typescript (list 'js/try (list 'fn [] body) handler)\n          (:python :php)\n          (let [result (gensym \"result\")\n                try-name (if (= frontend :python) 'py/try 'php/try)]\n            (list 'let [result (list 'cell/new nil)]\n                  (list try-name\n                        (list 'fn [] (list 'cell/set! result body))\n                        handler\n                        (list 'fn [] (list 'cell/get result)))))\n          :clojure body)))\n    form (distinct frontend-keys)))\n\n\n(require '[clojure.java.shell :as shell]\n         '[clojure.string :as str]\n         '[clojure.walk :as walk]\n         '[yang.call.exception-contract :as contract]\n         '[yang.call.exception-probes :as probes]\n         '[yang.call.exception-legs :as legs])\n\n(defn before! [file from to]\n  (let [{:keys [exit out err]}\n        (shell/sh \"git\" \"show\" (str \"6b5dfa7f:test/yang/call/\" file \".clj\")\n                  :dir \"/Users/sto/workspace/datomworld-kitfinally\")]\n    (assert (zero? exit) err)\n    (load-string (str/replace-first out (str \"(ns \" from) (str \"(ns \" to)))))\n\n(before! \"exception_contract\" \"yang.call.exception-contract\" \"kit2.before.contract\")\n(before! \"exception_probes\" \"yang.call.exception-probes\" \"kit2.before.probes\")\n(before! \"exception_legs\" \"yang.call.exception-legs\" \"kit2.before.legs\")\n\n(in-ns 'user)\n(def unaffected [:python :typescript :clojure])\n(def fixtures (filter #(not= :php (:frontend %)) contract/fixtures))\n(def pair-legs (filter #(not= :php (:donor %)) contract/pair-matrix))\n(def before-fixtures\n  (walk/postwalk\n    #(if (and (keyword? %) (= \"kit2.before.contract\" (namespace %)))\n       (keyword \"yang.call.exception-contract\" (name %)) %)\n    kit2.before.contract/fixtures))\n(assert (= (mapv #(dissoc % :source) before-fixtures)\n           (mapv #(dissoc % :source) contract/fixtures)))\n(doseq [frontend unaffected]\n  (assert (= (kit2.before.contract/sources frontend) (contract/sources frontend)))\n  (assert (= (kit2.before.legs/donor-source frontend) (legs/donor-source frontend))))\n(doseq [fixture fixtures]\n  (assert (= (kit2.before.probes/observation-form fixture)\n             (probes/observation-form fixture)) (:id fixture)))\n(doseq [leg pair-legs]\n  (assert (= (kit2.before.legs/observation-form leg)\n             (legs/observation-form leg)) (:id leg)))\n(println \"KIT2-UNCHANGED\"\n         {:contract-fixtures (count contract/fixtures)\n          :frontend-source-and-donor-strings (count unaffected)\n          :fixture-observation-forms (count fixtures)\n          :non-php-donor-leg-observation-forms (count pair-legs)})\n(shutdown-agents)\n","exit_code":0,"status":"completed"}}
