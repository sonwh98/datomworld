5\\t            base (query/discard-answers\\n  1906\\t                   (if (or (::link-counter d) (::link-origins d))\\n  1907\\t                     (carry-link-identity\\n  1908\\t                       (:vm state)\\n  1909\\t                       {:id-counter (::link-counter d)\\n  1910\\t                        :origins (::link-origins d)})\\n  1911\\t                     (:vm state))\\n  1912\\t                   (:query-pair expanded))]\\n  1913\\t        (consume-failed-round (carry-served\\n  1914\\t                                (cond-> (assoc expanded :vm base)\\n  1915\\t                                  ;; r3 F4: provenance handles the\\n  1916\\t                                  ;; evaluator stage completed before\\n  1917\\t                                  ;; throwing ride the recovered session\\n  1918\\t                                  (::call-provenance-handles d)\\n  1919\\t                                  (update :call-provenance-handles\\n  1920\\t                                          merge\\n  1921\\t                                          (::call-provenance-handles d)))\\n  1922\\t                                d)\\n  1923\\t                              error)))))\\n  1924\\t\\n     1\\t(require 'yang.latte-oracle-test 'dao.jing 'yin.vm.semantic.linearize 'yin.vm.semantic.derive)\\n     2\\t(def kc @#'yang.latte-oracle-test/kernel-compile)\\n     3\\t(def binding @#'yang.latte-oracle-test/cc3-oracle-binding)\\n     4\\t(def kernel-c @#'yang.latte-oracle-test/kernel-c)\\n     5\\t(import '(java.lang Runtime System))\\n     6\\t(def rt (Runtime/getRuntime))\\n     7\\t(defn used [] (- (.totalMemory rt) (.freeMemory rt)))\\n     8\\t(defn gc-used [] (System/gc) (Thread/sleep 50) (System/gc) (used))\\n     9\\t(def fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)})\\n    10\\t;; peak sampler across lowering -> persistence(projection/derives) -> tagged execution\\n    11\\t(def peak (atom 0))\\n    12\\t(def stop (atom false))\\n    13\\t(def sampler (Thread. (fn [] (while (not @stop) (swap! peak max (used)) (Thread/sleep 5)))))\\n    14\\t(def t0 (System/currentTimeMillis))\\n    15\\t(def base (gc-used))\\n    16\\t(.start sampler)\\n    17\\t(def stage-peaks (atom []))\\n    18\\t(defn mark [label] (swap! stage-peaks conj [label (used)]))\\n    19\\t(def compiled (kc fixture)) (mark :after-compile)\\n    20\\t(def b (binding compiled)) (mark :after-binding)\\n    21\\t(def sem (yin.vm.semantic.linearize/project-rows (:tree b) nil (:rows b))) (mark :after-project-rows)\\n    22\\t(def stack (yin.vm.semantic.derive/stack-image (:vector sem) {:segment-address :seg/stack :call-provenance (:call-provenance sem)})) (mark :after-stack)\\n    23\\t(def reg (yin.vm.semantic.derive/register-image (:vector sem) {:segment-address :seg/register :call-provenance (:call-provenance sem)})) (mark :after-register)\\n    24\\t(def relation {:semantic (:call-provenance sem) :stack (:call-provenance stack) :register (:call-provenance reg)})\\n    25\\t(def c-walker (kernel-c compiled :c-walker)) (mark :after-c-walker)\\n    26\\t(def c-sem (kernel-c compiled :c-semantic)) (mark :after-c-semantic)\\n    27\\t(reset! stop true) (.join sampler)\\n    28\\t(def elapsed (- (System/currentTimeMillis) t0))\\n    29\\t;; serialized storage (canonical bytes) vs retained JVM objects (used-heap delta, gc-pinned)\\n    30\\t(def rows-bytes (count (dao.jing/canonical-bytes (:rows b))))\\n    31\\t(def rel-bytes (count (dao.jing/canonical-bytes relation)))\\n    32\\t(def retained-box (atom nil))\\n    33\\t(def before-retain (gc-used))\\n    34\\t(reset! retained-box {:binding b :sem sem :stack stack :reg reg :relation relation})\\n    35\\t(def after-retain (gc-used))\\n    36\\t;; repeat delta measurement for stability\\n    37\\t(def deltas (mapv (fn [_] (let [x (atom nil) b0 (gc-used)] (reset! x {:b b :s sem :st stack :r reg}) (let [a (gc-used)] (reset! x nil) (- a b0)))) (range 3)))\\n    38\\t(println :compiled-status (:status compiled))\\n    39\\t(println :c-status (:status c-walker) (:status c-sem))\\n    40\\t(println :rows-canonical-bytes rows-bytes)\\n    41\\t(println :relation-canonical-bytes rel-bytes)\\n    42\\t(println :heap-baseline-gc-used base)\\n    43\\t(println :stage-used stage-peaks)\\n    44\\t(println :peak-used-during-pipeline @peak)\\n    45\\t(println :peak-over-baseline (- @peak base))\\n    46\\t(println :retained-delta-first (- after-retain before-retain))\\n    47\\t(println :retained-deltas-repeat deltas)\\n    48\\t(println :elapsed-ms elapsed)\\n    49\\t(println :ceiling-bytes 1073741824 :peak-under-ceiling (< @peak 1073741824))\\n    50\\t(System/exit 0)\\n    25\\t(defn source-envelope\\n    26\\t  \\\"Construct the provenance-bearing input value ruled by D4. The admitting\\n    27\\t   composition supplies its program medium's logical identity and mints a\\n    28\\t   fresh batch token before append. `members` is ordered and `root` selects\\n    29\\t   the member the evaluator runs. The constructor validates but never mints:\\n    30\\t   retries of an unaccepted staged append must retain the caller's token.\\\"\\n    31\\t  ([source-medium batch-token members]\\n    32\\t   (source-envelope source-medium batch-token members 0))\\n    33\\t  ([source-medium batch-token members root]\\n    34\\t   (let [envelope {:yin/source-medium source-medium\\n    35\\t                   :yin/batch-token batch-token\\n    36\\t                   :yin/batch (vec members)\\n    37\\t                   :yin/root root}]\\n    38\\t     ;; Validating the root origin validates the two opaque coordinates too.\\n    39\\t     (when-not (and (integer? root) (<= 0 root) (< root (count members)))\\n    40\\t       (throw (ex-info \\\"Malformed source batch envelope\\\"\\n    41\\t                       {:rule :batch-envelope, :envelope envelope})))\\n    42\\t     (vm/source-origin source-medium batch-token root)\\n    43\\t     envelope)))\\n    44\\t\\n    45\\t\\n   140\\t(defn- project-envelope\\n   141\\t  [{:yin/keys [source-medium batch-token batch root] :as envelope}]\\n   142\\t  (when-not (and (vector? batch)\\n   143\\t                 (seq batch)\\n   144\\t                 (integer? root)\\n   145\\t                 (<= 0 root)\\n   146\\t                 (< root (count batch)))\\n   147\\t    (throw (ex-info \\\"Malformed source batch envelope\\\"\\n   148\\t                    {:rule :batch-envelope, :envelope envelope})))\\n   149\\t  (let [projected (mapv (fn [j member]\\n   150\\t                          (project-member member\\n   151\\t                                          (vm/source-origin source-medium\\n   152\\t                                                            batch-token j)\\n   153\\t                                          j))\\n   154\\t                        (range) batch)]\\n   155\\t    (assoc envelope\\n   156\\t           :yin/batch (mapv :tree projected)\\n   157\\t           :yin/source-positions (into [] (mapcat :source-positions) projected)\\n   158\\t           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\\n   159\\t           :yin/entity-occurrences (into [] (mapcat :entity-occurrences) projected))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794343683000-architect-cc3-d1-mob.gemini-4-argon-high.stdout.log:1:{\"conversation_id\":\"4b7ced60-62f7-4668-82a3-c72aececc945\",\"status\":\"SUCCESS\",\"response\":\"Completed-GMT: 2026-11-10 20:52:00 GMT\\nCompleted-Local: 2026-11-11 03:52:00 +0700\\n\\nQ1 VERDICT: SUFFICIENT WITH THREE BOUNDARY-RESPECTING LOWERING REQUIREMENTS (native-image PC→K reconstruction is in `cc3` scope inside `derive.cljc`/`publish.cljc`; runtime evaluator caller-K propagation is a continuation-seat boundary item not required for `cc3` or `D1`).\\nQ2 VERDICT: (ii) SEPARATE COMPANION FILE `test/yang/latte_oracle/slice9_correspondence.edn` REFERENCING VERBATIM `:version 1` `slice9_site_tables.edn`.\\nQ3 VERDICT: AMEND ORDER TO `cc2 → cc3 → D1 → cc4` (`D1` before `cc4`).\\n\\n---\\n\\n## Question 1 — `cc3` Route Sufficiency\\n\\n`Q1 VERDICT: SUFFICIENT WITH THREE BOUNDARY-RESPECTING LOWERING REQUIREMENTS (native-image PC→K reconstruction is in cc3 scope inside derive.cljc/publish.cljc; runtime evaluator caller-K propagation is a continuation-seat boundary item not required for cc3 or D1).`\\n\\n### Evidence \\u0026 Severity-Ordered Defect Analysis for Route (a)\\n\\nRoute (a) — extending [`src/cljc/yin/vm/semantic/linearize.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/linearize.cljc), [`src/cljc/yin/vm/semantic/derive.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/derive.cljc), [`src/cljc/yin/vm/linker/publish.cljc`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/linker/publish.cljc), and [`test/yang/latte_oracle_test.clj`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj) without editing any evaluator (`ast_walker.cljc`, `semantic.cljc`, `debruijn/stack.cljc`, `debruijn_register_effects.cljc`) — **is sufficient** to meet the Design §2.4, §2.5, and §4.2 acceptance bar, provided `cc3` addresses three concrete defects in the current naive lowering/oracle plumbing:\\n\\n1. **[P1 — Per-Occurrence Origin Loss in `linearize/project-rows`] (`src/cljc/yin/vm/semantic/linearize.cljc:188-214`, `src/cljc/yin/vm/linker/publish.cljc:312`)**:\\n   - **What fails if unaddressed**: [`linearize/project-rows`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/linearize.cljc#L200-L214) currently accepts only a single scalar `origin` (`(when-not (or (nil? origin) (vm/occurrence-origin? origin)) ...)`) and stamps that single `origin` onto every PC (`(mapv (fn [pc [_ path]] [pc origin root path]) (range) sources)`), omitting `segment-address`. Under Owner Ruling U1 ([`1795310000000:13`](file:///Users/sto/workspace/datomworld/collab/yang-clojure/1795310000000-owner-ruling-occurrence-identity-unitarity.md#L13)) and `cc1`'s [`macro/final-call-site-metadata`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/macro.cljc#L1598-L1627), a post-expansion tree contains **heterogeneous per-occurrence origins**: `[:source medium batch j]` for retained source applications and `[:expansion record-address]` for macro-generated applications. Passing a single `origin` to `project-rows` would overwrite `[:expansion record-address]` origins on macro-generated `:call` instructions and fail Design §2.4/§4.2 step 5 reconstruction.\\n   - **Minimal boundary-respecting remedy**: Extend `linearize/project-rows` (or add a provenance-projection arity/helper in `linearize.cljc`) to accept an optional `path -\\u003e origin` lookup map (derived from the C1 side table `[origin root-address path :yang/call-site 1]`) alongside the fallback admission `origin`, and prepend `segment-address` (`(:address result)`, i.e. `(ucf/code-address code)` at [`linearize.cljc:211`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/linearize.cljc#L211)) so each emitted provenance row has the canonical 5-tuple shape `[segment-address pc origin root-address path]` ([`docs/design/yin.vm.code-as-tuples.md:447,920-924`](file:///Users/sto/workspace/datomworld/docs/design/yin.vm.code-as-tuples.md#L447)). In [`linearize/project-datoms`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/linearize.cljc#L298-L302), `flatten-tree` already computes `sources` as `[[id path] ...]` and discards `path` at line 302 (`(mapv (fn [pc [id _]] [pc id]) (range) sources)`); retain `path` or provide the entity-to-occurrence bridge with [`encoder/datom-entity-occurrences`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/encoder.cljc#L67-L93) as required by Design §2.4 ([`1794670000000:77`](file:///Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md#L77)).\\n\\n2. **[P1 — Native-Image `PC → K` Reconstruction Scope \\u0026 Validator Contract Guard] (`src/cljc/yin/vm/semantic/derive.cljc:60-184`, `src/cljc/yin/vm/linker.cljc:2121-2133`, `src/cljc/yin/vm/debruijn_register_code.cljc:699-707`)**:\\n   - **Scope classification**: Native-image `PC → K` reconstruction (Design §2.4, [`1794670000000:75`](file:///Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md#L75)) is **in `cc3` scope** because it is a pure static lowering derivation in `derive.cljc` and `publish.cljc` — it requires **zero** evaluator/runtime changes.\\n   - **How it works statically**:\\n     - `derive/resolve` ([`derive.cljc:21-42`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/derive.cljc#L21-L42)) parses the semantic vector `v` via [`code/parse`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/code.cljc#L349-L435) into expression trees `{:op mnemonic :pc semantic-pc :children [...]}` while preserving semantic PCs.\\n     - `derive/register-image` ([`derive.cljc:154-184`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/derive.cljc#L154-L184)) preserves `v`'s exact instruction indices (`(mapv (fn [pc t] ...) (range (count rv)) rv)` at `:162-176`), so register `pc == semantic-pc` for every `:call` instruction, with `segment-address = (rcode/register-hash r-image)`.\\n     - `derive/stack-image` ([`derive.cljc:60-120`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/derive.cljc#L60-L120)) walks each parsed `{:op :pc :children}` node and at `:call` (`:92-93`) emits `[:push]` for each child followed by `(emit! [:call (count y) z])`. At that `emit!`, the stack PC is `(count @image)` and the semantic PC is `(:pc node)`. `stack-image` already records `{:kind :closure :source pc}` and `{:kind :var :source pc}` in `:side-table` (`:79,88,90,120`).\\n   - **What fails if done carelessly**: Over 40 call sites across `src/` and `test/` (including [`linker/relowered`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/linker.cljc#L2131-L2132) and [`rcode/register-image-defect`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/debruijn_register_code.cljc#L699-L707)) pass `(derive/register-image v)` directly to `rcode/register-hash`, `rcode/register-image-defect`, and `rvm/create-vm`.\\n   - **Minimal boundary-respecting remedy**: Keep the return shapes of `(:image (derive/stack-image v))` and `(derive/register-image v)` byte-identical so existing hashes and lowering profiles (`linker/stack-lowering-profile`, `linker/register-lowering-profile`) are untouched. Record `:call` (and `:ffi-call`) `stack-pc -\\u003e semantic-pc` in `stack-image`'s `:side-table` (at [`derive.cljc:92-95`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/derive.cljc#L92-L95)) and add a pure helper in `derive.cljc` (e.g., `derive/instruction-provenance`) that composes semantic provenance `[[sem-addr sem-pc origin root path] ...]` with stack (`h` = `(dcode/image-hash h-image)`) and register (`r` = `(rcode/register-hash r-image)`) PC mappings to emit `[segment-address native-pc origin root-address path]`. Persist the instruction-provenance relations in [`publish-closure!`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/linker/publish.cljc#L356-L368) beside `:yang.call-site/table` (outside the closed schema-1 manifest hash, preserving `83b52a0b`).\\n\\n3. **[P1 — Path Shift Under `kernel-stamp-sites` in the Oracle Bridge] (`test/yang/latte_oracle_test.clj:2192-2320, 2449-2476`)**:\\n   - **What fails if unaddressed**: In [`kernel-compile`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L2460-L2465), `(yang/compile-program program true opts)` produces the unstamped C1-annotated map AST `compiled`. Then [`kernel-stamp-sites`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L2227-L2237) rewrites every stamped call's `args-node` into `(data/nth (dsg__intra_call gate-site! (conj [] k args-node)) 1)`. When a guest call is nested inside the arguments of an outer stamped guest call (`:2261, :2277`), the wrapper shifts the inner call's structural `path` in `stamped` relative to `compiled`, and adds 3 synthetic `:application` nodes (`data/nth`, `dsg__intra_call`, `conj`) per stamped site.\\n   - **Minimal boundary-respecting remedy**: During `kernel-stamp-sites` (or a paired walk over the unstamped `compiled` AST before/during stamping), track the exact grammar structural `path` (using `vm/semantic-bytecode-grammar` slot positions, matching [`linearize/slot-position`](file:///Users/sto/workspace/datomworld/src/cljc/yin/vm/semantic/linearize.cljc#L33-L43)) in the **unstamped** compiled tree (and, if stamping is retained for runtime execution, also in the C1-re-annotated `stamped` tree). Pass the unstamped C program through `encoder/program-batch` → `macro/expand-batch` (with explicit fixture admission origin) so every stamped integer site `k` (`1..N`) binds 1-to-1 to its canonical persisted occurrence key `K = [origin root-address path]` in the post-expansion C1 side table.\\n   - **Why evaluator runtime changes are NOT needed**: The oracle's guest-level `gate-site!` cell instrumentation ([`test/yang/latte_oracle_test.clj:1983-2013`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L1983-L2013)) is explicitly licensed by Signed Addendum A §A1/§A3 ([`1794630000000:13,21`](file:///Users/sto/workspace/datomworld/collab/yang-clojure/1794630000000-architect-attribution-addendum-a-RECORD.md#L13)) and Design §2.5/§4.1 ([`1794670000000:81-101, 219`](file:///Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md#L81-L101)). It already captures the caller site after operand evaluation and before callee body entry in both `:c-walker` and `:c-semantic` within the 4,000,000-instruction budget. Binding integer `k` to persisted `K = [origin root-address path]` via `:yang.correspondence/origin-bindings` (`[[site-id K] ...]`) satisfies Design §2.5 and §4.2 (independent reconstruction, exact coverage of all `:application` occurrences including uncredited helpers, and exact multiplicities) while leaving `ast_walker`, `semantic`, `stack`, and `register` evaluators untouched for the continuation-semantics seat.\\n\\n---\\n\\n## Question 2 — `D1` Evidence Format\\n\\n`Q2 VERDICT: (ii) SEPARATE COMPANION FILE test/yang/latte_oracle/slice9_correspondence.edn REFERENCING VERBATIM :version 1 slice9_site_tables.edn.`\\n\\n### Evidence-Backed Reasoning\\n\\n1. **Compatibility Argument (Complete Grep of Readers \\u0026 Writers)**:\\n   - Across `src/`, `test/`, and `docs/`, [`test/yang/latte_oracle/slice9_site_tables.edn`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle/slice9_site_tables.edn) has **only one code reader** and **one code writer**:\\n     - Reader: [`test/yang/latte_oracle_test.clj:3412-3415`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L3412-L3415) (`test-kernel-gate-evidence-writer-round-trip`), which asserts `(= 1 (:version tables))` and `(= (count (:fixtures written)) (count (:fixtures tables)))`.\\n     - Writer: [`test/yang/latte_oracle_test.clj:3284-3293`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L3284-L3293) (`write-kernel-gate-evidence!`, plus temp-file cleanup at `:3418`).\\n     - Metadata pointer: [`test/yang/latte_oracle_test.clj:3247`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L3247) and [`test/yang/latte_oracle/slice9_evidence.edn:25`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle/slice9_evidence.edn#L25) (`:site-tables-file \\\"slice9_site_tables.edn\\\"`).\\n     - Prose citations: [`test/yang/latte_oracle/slice9_gate.md:24,228`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle/slice9_gate.md#L24) and [`test/yang/latte_oracle/attribution_inventory.md:202`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle/attribution_inventory.md#L202).\\n   - However, **in-memory consumers** of `(:site-table row)` in `test/yang/latte_oracle_test.clj` require homogeneous keys matching the third element of `:executed-calls` (`[fname arity site-id]` in `slice9_evidence.edn`):\\n     - [`kernel-stale-sites`](file:///Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj#L2368-L2382) iterates `(for [[k s] table :when (and (symbol? (:callee s)) (not (contains? recorded k)))] k)` and calls `(sort ...)` at line 2380.\\n     - Under choice (i), dual-keying `:site-table` in-place with both integer keys (`1..N`) and vector keys (`K = [origin root-address path]`) while `:executed-calls` in `slice9_evidence.edn` records integer `1..N` causes **two immediate breakages**: (a) every `K` key is not in `recorded` and is falsely reported as a stale site, and (b) `(sort ...)` over mixed `java.lang.Long` and `PersistentVector` keys throws `ClassCastException`!\\n\\n2. **Failure-Mode \\u0026 Contract Argument (Design §1, §2.5, §3.4, §4.1, §4.2 and Unitarity)**:\\n   - **Design §1 (`1794670000000:12`)**: *\\\"Publish the durable correspondence as an additional addressable record referring to the oracle's evidence **without changing that evidence's format**.\\\"*\\n   - **Design §2.5 (`1794670000000:97`)**: *\\\"preserve its evidence verbatim and publish a reviewed binding of its origin fields to this semantic domain; **do not rewrite its tables behind an unchanged version**.\\\"*\\n   - **Design §4.1 (`1794670000000:183-220`)**: Defines `:yang.correspondence/schema 1` with a **closed key set** (`:200`), where `:yang.correspondence/evidence` points to `\\u003cJing address of OracleEvidence\\u003e` (\\\"**OracleEvidence verbatim**: same EDN data shape, schema/version, field names, vectors, site ids, source-hash value and classifications. Do not project a subset or copy its rows into a second durable site-table shape\\\", `:202`), and `:yang.correspondence/origin-bindings` (`[[\\u003cephemeral site id from OracleEvidence\\u003e \\u003cpersisted occurrence key\\u003e] ...]`, `:188-189, 219`) binds the oracle's integer site IDs to persisted C1 occurrence keys `K = [origin root-address path]`.\\n   - **Comment in `test/yang/latte_oracle_test.clj:3281-3283`**: *\\\"one derived table and one canonical-source-hash per fixture, stable across refreshes so the later durable correspondence record lands additively\\\"* — keeping `slice9_site_tables.edn` byte-stable while landing `slice9_correspondence.edn` beside it honors this comment literally and matches the `83b52a0b` (`:yang.call-site/schema 1` naming `:yang.call-site/manifest`) and `yang.python.antlr.siteset` (`siteset.cljc:5-22`) precedents cited in Design §4.2 (`:223`).\\n   - **Failure-mode separation (Design §3.4, `:171-174`)**: With a separate `slice9_correspondence.edn`, any corruption, recipe mismatch, or origin-binding failure in `D1` fails D1 correspondence verification cleanly without mutating or invalidating the accepted `:version 1` oracle evidence (`slice9_site_tables.edn` and `slice9_evidence.edn`), and never rewrites historical evidence.\\n\\n---\\n\\n## Question 3 — Decomposition Confirmation\\n\\n`Q3 VERDICT: AMEND ORDER TO cc2 → cc3 → D1 → cc4 (D1 before cc4).`\\n\\n### Dependency Analysis \\u0026 Ordering Justification\\n\\n1. **Does `D1` depend on `cc4` (four-host equality + budget gate)? No.**\\n   - `D1` produces `test/yang/latte_oracle/slice9_correspondence.edn`, the `:yang.correspondence.recipe/schema 1` recipe, and the 7-step independent reconstruction verifier ([`Design §4.2:225-235`](file:///Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md#L225-L235)) in `test/yang/latte_oracle_test.clj` / `src/dev/latte_oracle_tables.clj`.\\n   - The LaTTe oracle is JVM-only (`.clj`). Its prerequisites are `cc1` (landed), `cc2` (in flight on `cc2-transform-session-c1`), and `cc3` (lowering provenance in `linearize.cljc`/`derive.cljc`/`publish.cljc` + the oracle `site-id ↔ K` binding). Once `cc3` lands, `D1` has zero dependency on `cc4`'s Node, Dart, or Jolt host lanes.\\n\\n2. **Does `cc4` depend on `D1`? Yes — by both the signed acceptance sequence and the budget specification:**\\n   - **Design §8 Steps 3 → 4 → 5 (`1794670000000:373-375`) and Signed Addendum A §A4 (`1794630000000:25`)**:\\n     - Step 3 (`cc1`–`cc3`) implements common occurrence/side-table production, preservation, and publication.\\n     - Step 4 (`D1`) implements and independently reconstructs `D1` **before** Step 5 (`cc4`, accepting each production frontend after its four-host brief, cross-host equality, and budget measurements pass).\\n     - Signed Addendum A §A4 (`1794630000000:25`) explicitly strikes *\\\"or atomically with\\\"*: D1 implementation and independent verification must complete before accepting reliance.\\n   - **Design §5.3 (`1794670000000:284`) \\u0026 §6.1 (`1794670000000:296`)**:\\n     - Design §6.1 defines the mandatory static budget `S_static` (measured in `cc4`) to include *\\\"exact encoded bytes of C1 rows, provenance tables, retained origin records, **D1 and its reconstruction inputs**\\\"*, and Design §5.3 requires the frontend acceptance bundle (`cc4`) to include the completed D1 verification result. Running `D1` before `cc4` allows `cc4` to measure the final `D1` artifact bytes in `S_static` and include the D1 verification result in a single pass.\\n   - **Engineering Risk Reduction**:\\n     - Running `D1`'s 7-step independent reconstruction verifier immediately after `cc3` stress-tests `cc3`'s C1 side-table and instruction-provenance schemas on the full 54-fixture LaTTe corpus *before* running the expensive four-host (JVM, Node, Dart, Jolt) replay equality and prelude republication battery in `cc4`. If `D1` exposes any schema or provenance defect in `cc3`, fixing it before `cc4` avoids repeating the 4-host verification run.\\n\\n---\\n\\n## Risks Surfaced to the Owner\\n\\n1. **Exception-Track (B)-Fallback Pre-Claim Hazard (`collab/exception-track/1794343000000-exception-track-surface-registry.md:32-36, 54-58`)**:\\n   - The continuation-semantics seat has noted a conditional `(B)` fallback if Clojure R4 equivalence proof fails, which could touch `clojure.cljc` broadly or pre-claim `encoder.cljc`, `publish.cljc`, `linearize.cljc`, or `derive.cljc`. Because `cc3` touches `linearize.cljc`, `derive.cljc`, and `publish.cljc`, dispatching `cc3` promptly after `cc2` lands (while Clojure R3/R4 is still in its `clojure.cljc`-internal phase) avoids any file-lock contention.\\n2. **Untracked vs. Tracked Code Size of `slice9_correspondence.edn` (`Design §6.1, §6.3`)**:\\n   - In `D1`, storing full C1 metadata rows and instruction-provenance tables inline for all 54 LaTTe fixtures inside a single checked-in EDN file could make `slice9_correspondence.edn` very large (tens of megabytes) because each fixture compiles the inlined LaTTe kernel + preludeclosure. To keep `slice9_correspondence.edn` compact and diffable while satisfying Design §4.1 (`:183-205`), `slice9_correspondence.edn` should store the **content addresses (`dao.jing` digests)** for `:yang.correspondence/evidence`, `:yang.correspondence/recipe`, `:yang.correspondence/metadata`, and `:yang.correspondence/instruction-provenance` alongside the compact `:yang.correspondence/origin-bindings` (`[[site-int K] ...]`) per fixture, and the 7-step verifier (`Design §4.2`) should reconstruct and verify those content-addressed relations in a content-addressed store/handle during verification rather than checking in multi-megabyte raw instruction vectors per fixture.\\n3. **Jolt J2 Load Check in `cc4` (`collab/jolt/1794900000000-orchestrator-handoff-jolt-seat.md:33-34`)**:\\n   - When `cc4` runs the four-host gate (JVM, Node, Dart, Jolt), ensure `yang.clojure-callsite-test` is wired into the Jolt lane alongside the pending J2 load check of `yang.clojure` so both obligations close in one Jolt run.\\n\",\"duration_seconds\":313.156519,\"num_turns\":1,\"usage\":{\"input_tokens\":165522,\"output_tokens\":21613,\"thinking_tokens\":12893,\"cache_read_tokens\":1086833,\"total_tokens\":187135}}\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:113:| Durable correspondence | New separate schema 1 below. | Unknown schema, missing evidence, failed reconstruction or ambiguous linkage refuses reliance, independently of code loadability. |\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:254:| Python | Local source parser, packet/module/import/SCC/session paths, publications | Local generated parser plus all packet/session/publication paths | Local generated parser plus all packet/session/publication paths | Native C++ Python parser plus packet/session/publication/load paths; unavailable parser is a failed required source gate with a recorded reason, not a green skip |\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:284:Each brief's acceptance bundle contains: exact producer/artifact checklist; input/commit/profile pins; C1 coverage counts and root/hash invariance; four-host results and cross-host equality report; correctness battery results; before/after budgets and measurements; legacy-load/missing-provenance refusal; and D1 verification result if it relies on correspondence. No frontend can satisfy this bundle merely by running the oracle test.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:286:## 6. Measurement and declared budgets\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:288:These are measurement requirements and design cost models, **not measured performance claims**. Signed A3 requires a budget impact per frontend, and line 29 requires static/runtime separation. This read-only design has no authority to invent benchmark results. Numeric per-corpus totals remain **unknown — the implementation round's inventory decides by measuring the pinned baseline before tagged runs**.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:324:| Compile/expand/publish/verify/load/query time | Declare finite absolute time limits and allowed deltas against B/S in the preflight record. Pilot B/S measurements may set these; a tagged timeout is a failed bounded run. |\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:329:For other frontends, no oracle 4M/1M setting is inherited by default. Their adoption preflight must give numeric ceilings for each required fixture/prelude/host and format. Exceeding a declared bound blocks that acceptance run; changing bounds creates a new versioned run declaration and preserves the failed run.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:331:### 6.4 Budget impact allocated per frontend\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:333:| Frontend | Mandatory static budget scope | Mandatory dynamic budget scope |\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:340:The storage/work formulas are the design's budget impact; numbers require the pinned post-sweep corpus and are not asserted here. Shared `yang.call` must be reported once as retained shared content and separately as each frontend's dependency, avoiding both double charging and disappearance. Prelude republishing on four hosts is mandatory even when code hashes remain unchanged: the new occurrence/provenance artifacts need independent production/load evidence.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:382:- **Prelude/host budget is unmeasured:** four-host republication is the broadest artifact obligation. No numeric annotation/trace overhead or passing lane is claimed by this design; preflight must record actual per-frontend bounds.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794421000000-reviewer-cc3-r11-confirm-jupiter-r5.gpt-6-astra.findings.md:6:C2: CONFIRMED — Failures carry shell-assigned admission, root, and stage; produce an additive Warning; and persist in session diagnostics. Failed writes advertise no handle. Unclaimed packets remain distinct.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1793950384477-architect-dart-cljd-guards-review.prompt.md:24:In response to the reported nightly break on the Shiva dart lane where `cljd compile` failed due to JVM classes and missing symbols leaking into ClojureDart compilation:\n/Users/sto/workspace/datomworld/collab/yang-clojure/1793860000000-engineer-h3-1-fix-call-lowering.prompt.md:17:- FORBIDDEN: `yang.call` or `yin.vm` changes; any acceptance-budget change (the 12M proposal is DEFERRED by ruling); coverage credit from diagnostic trials.\n/Users/sto/workspace/datomworld/collab/yang-clojure/1793860000000-engineer-h3-1-fix-call-lowering.prompt.md:23:From your own packet: the two blocked fixtures (`check-accepted` c-walker-only, `check-assume-have-discharge` both lanes) exhaust the 2,000,000-step budget through intra-unit/admitted Clojure call lowering overhead. Your recommended fix brings all 106 fixtures inside the existing 2,000,000 budget on both lanes. Fix exactly that: the call-lowering path for intra-unit/admitted calls so the avoidable per-call cost (the overhead your packet measured between the lowered forms and the direct application) is removed, WITHOUT weakening the guards the adoption and the H3-0 review pinned: admission for anything not statically intra-unit, the outcome-token machinery in tail position, operand evaluation order, and the H3-0 reconciliation's shape-based routing (entry-present callees to admission, entry-absent to invoke-value).\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794388800000-reviewer-cc3-r4-confirm.gpt-6-astra.stdout.log:1:2026-11-11T09:49:00.075923Z ERROR codex_models_manager::manager: failed to refresh available models: request timed out\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794388800000-reviewer-cc3-r4-confirm.gpt-6-astra.stdout.log:2:2026-11-11T09:49:00.134271Z ERROR codex_models_manager::manager: failed to refresh available models: request timed out\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794388800000-reviewer-cc3-r4-confirm.gpt-6-astra.stdout.log:4:2026-11-11T09:49:05.788998Z ERROR codex_models_manager::manager: failed to refresh available models: request timed out\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794388800000-reviewer-cc3-r4-confirm.gpt-6-astra.stdout.log:6:2026-11-11T09:49:17.540556Z ERROR codex_models_manager::manager: failed to refresh available models: request timed out\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794388800000-reviewer-cc3-r4-confirm.gpt-6-astra.stdout.log:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba test/yang/clojure_callsite_test.cljc | sed -n '2050,2220p'; nl -ba test/yang/latte_oracle_test.clj | sed -n '2450,2535p;3620,3650p;3980,4060p'\\\"\",\"aggregated_output\":\"  2050\\t             (failure-rule\\n  2051\\t               #(repl/packet-call-provenance state packet [:oracle/fixture 1])))))))\\n  2052\\t\\n  2053\\t\\n  2054\\t#?(:clj\\n  2055\\t   (deftest repl-packet-provenance-survives-failure-test\\n  2056\\t     ;; cc3 r3 item F4: a claimed program that throws after loading\\n  2057\\t     ;; has already persisted its provenance relation; the lookup\\n  2058\\t     ;; handle completed before the throw must survive the\\n  2059\\t     ;; exception/recovery path and stay retrievable after reopening.\\n  2060\\t     (let [dir (str \\\"target/test-cc3-provenance-fail-\\\" (random-uuid))\\n  2061\\t           cleanup (fn [] (let [f (java.io.File. dir)]\\n  2062\\t                            (when (.exists f)\\n  2063\\t                              (run! #(.delete %) (reverse (file-seq f))))))]\\n  2064\\t       (try\\n  2065\\t         (let [state (reduce (fn [s line] (first (repl/eval-input s line)))\\n  2066\\t                             (repl-frontends/create-state\\n  2067\\t                               {:index-store-spec {:type :file :dir dir}})\\n  2068\\t                             [\\\"(def k (fn [] 1))\\\"\\n  2069\\t                              \\\"(def g (fn [] (+ (k) 41)))\\\"])\\n  2070\\t               handles-before (repl/call-provenance-handles state)\\n  2071\\t               [state' failed] (repl/eval-input state \\\"(+ (g) (/ 1 0))\\\")\\n  2072\\t               handles (repl/call-provenance-handles state')]\\n  2073\\t           (is (seq handles-before))\\n  2074\\t           (is (str/includes? failed \\\"Error: \\\")\\n  2075\\t               \\\"precondition: the claimed program really threw\\\")\\n  2076\\t           (is (< (count handles-before) (count handles))\\n  2077\\t               \\\"the throwing round's completed retention is not dropped\\\")\\n  2078\\t           (let [new-handles (into {}\\n  2079\\t                                   (remove (fn [[k _]]\\n  2080\\t                                             (contains? handles-before k)))\\n  2081\\t                                   handles)\\n  2082\\t                 [[admission root] handle before]\\n  2083\\t                 (first (keep (fn [[[a r] h]]\\n  2084\\t                    