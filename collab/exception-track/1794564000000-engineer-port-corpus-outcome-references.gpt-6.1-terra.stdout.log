closures are constructed by guest evaluation.\n[(defn context-not-empty [x] (if (seq x) x nil))\n (defn context-ffirst [x] (first (first x)))\n (defn context-list-star\n   ([a tail] (cons a tail))\n   ([a b tail] (cons a (cons b tail))))\n (defn lookup-in [coll path]\n   (reduce (fn [coll k] (get coll k)) coll path))\n (defn ->Definition [name params arity parsed-term term-free-vars type opts]\n   {:latte/kind :definition :name name :params params :arity arity\n    :parsed-term parsed-term :term-free-vars term-free-vars :type type :opts opts})\n (defn ->Theorem [name params arity type proof]\n   {:latte/kind :theorem :name name :params params :arity arity :type type :proof proof})\n (defn ->Axiom [name params arity type]\n   {:latte/kind :axiom :name name :params params :arity arity :type type})\n (defn ->Notation [name notation-fn]\n   {:latte/kind :notation :name name :notation-fn notation-fn})\n (defn ->Implicit [name implicit-fn]\n   {:latte/kind :implicit :name name :implicit-fn implicit-fn})\n (defn definition? [v] (= :definition (:latte/kind v)))\n (defn theorem? [v] (= :theorem (:latte/kind v)))\n (defn axiom? [v] (= :axiom (:latte/kind v)))\n (defn notation? [v] (= :notation (:latte/kind v)))\n (defn implicit? [v] (= :implicit (:latte/kind v)))\n (defn latte-definition? [v]\n   (or (definition? v) (theorem? v) (axiom? v) (notation? v) (implicit? v)))\n (defn kernel-context [definitions opacity-policy unfold-implicit]\n   {:definitions definitions\n    :unparser-registry {:fundamental [] :standard [] :user [] :unparsers {}}\n    :opacity-policy opacity-policy :unfold-implicit unfold-implicit :fresh 0})\n (defn local-definitions [kernel] (second (:definitions kernel)))\n (defn register-definition\n   ([kernel rdef] (register-definition kernel rdef false))\n   ([kernel rdef local?]\n    (let [[globals locals] (:definitions kernel)]\n      (assoc kernel :definitions\n             (if local? [globals (assoc locals (:name rdef) rdef)]\n                 [(assoc globals (:name rdef) rdef) locals])))))\n (defn fetch-definition\n   ([kernel dname] (fetch-definition kernel dname false))\n   ([kernel dname local-only?]\n    (let [[globals locals] (:definitions kernel)]\n      (if (symbol? dname)\n        (if-let [ldef (get locals dname)]\n          [:ok ldef]\n          (if local-only?\n            [:ko {:msg \"No such (local) definition\" :def dname}]\n            (if-let [gdef (get globals dname)]\n              [:ok gdef]\n              [:ko {:msg \"No such (global) definition\" :def dname}])))\n        (throw (ex-info \"Cannot fetch definition (please report)\" {:dname dname}))))))\n (defn registered-definition?\n   ([kernel dname] (registered-definition? kernel dname false))\n   ([kernel dname local?] (= :ok (first (fetch-definition kernel dname local?)))))\n (defn qualify-def [kernel dname]\n   (if (= :ok (first (fetch-definition kernel dname)))\n     dname\n     (throw (ex-info \"Cannot qualify symbol: not a known definition\" {:symbol dname}))))\n (defn fresh-name [kernel prefix]\n   [(gensym prefix (:fresh kernel)) (assoc kernel :fresh (+ (:fresh kernel) 1))])\n (defn install-unfold-implicit [kernel unfold-fn]\n   (assoc kernel :unfold-implicit unfold-fn))\n (defn install-opacity-function [kernel opacity-fn]\n   (assoc kernel :opacity-policy opacity-fn))\n (defn missing-opacity-policy [ddef opaque?]\n   (throw (ex-info \"Opacity management function not installed (please report)\" {:weird true})))\n (defn missing-unfold-implicit [kernel ctx implicit-def args]\n   (throw (ex-info \"Implicit unfolding function not installed\" {})))\n (defn definition-opacity [ddef opaque?]\n   (assoc ddef :opts (assoc (:opts ddef) :opaque opaque?)))\n (defn is-opaque? [ddef]\n   (if-let [opts (get ddef :opts)] (get opts :opaque)))\n (defn elab-opacity [kernel names opaque?]\n   (reduce\n     (fn [kernel dname]\n       (let [[status ddef] (fetch-definition kernel dname)]\n         (when (= status :ko)\n           (throw (ex-info \"Cannot qua