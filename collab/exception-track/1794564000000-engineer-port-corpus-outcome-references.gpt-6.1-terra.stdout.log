ected data).\\n   186\\t- Datom lane (r1 item 4): restriction unchanged — row lane only, D1's\\n   187\\t  stated dependency; not re-opened by this round.\\n   188\\t- DHT custody (owner-visible, unchanged): `dht/publish-name!` still\\n   189\\t  discards the `:call-sites` handle (now carrying `:provenance`);\\n   190\\t  `dht.cljc` remains forbidden and unedited — the one-line forwarding\\n(require 'yang.latte-oracle-test 'dao.jing 'yin.vm.semantic.linearize 'yin.vm.semantic.derive)\\n(def kc @#'yang.latte-oracle-test/kernel-compile)\\n(def binding @#'yang.latte-oracle-test/cc3-oracle-binding)\\n(def kernel-c @#'yang.latte-oracle-test/kernel-c)\\n(import '(java.lang Runtime System))\\n(def rt (Runtime/getRuntime))\\n(defn used [] (- (.totalMemory rt) (.freeMemory rt)))\\n(defn gc-used [] (System/gc) (Thread/sleep 50) (System/gc) (used))\\n(def fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)})\\n;; peak sampler across lowering -> persistence(projection/derives) -> tagged execution\\n(def peak (atom 0))\\n(def stop (atom false))\\n(def sampler (Thread. (fn [] (while (not @stop) (swap! peak max (used)) (Thread/sleep 5)))))\\n(def t0 (System/currentTimeMillis))\\n(def base (gc-used))\\n(.start sampler)\\n(def stage-peaks (atom []))\\n(defn mark [label] (swap! stage-peaks conj [label (used)]))\\n(def compiled (kc fixture)) (mark :after-compile)\\n(def b (binding compiled)) (mark :after-binding)\\n(def sem (yin.vm.semantic.linearize/project-rows (:tree b) nil (:rows b))) (mark :after-project-rows)\\n(def stack (yin.vm.semantic.derive/stack-image (:vector sem) {:segment-address :seg/stack :call-provenance (:call-provenance sem)})) (mark :after-stack)\\n(def reg (yin.vm.semantic.derive/register-image (:vector sem) {:segment-address :seg/register :call-provenance (:call-provenance sem)})) (mark :after-register)\\n(def relation {:semantic (:call-provenance sem) :stack (:call-provenance stack) :register (:call-provenance reg)})\\n(def c-walker (kernel-c compiled :c-walker)) (mark :after-c-walker)\\n(def c-sem (kernel-c compiled :c-semantic)) (mark :after-c-semantic)\\n(reset! stop true) (.join sampler)\\n(def elapsed (- (System/currentTimeMillis) t0))\\n;; serialized storage (canonical bytes) vs retained JVM objects (used-heap delta, gc-pinned)\\n(def rows-bytes (count (dao.jing/canonical-bytes (:rows b))))\\n(def rel-bytes (count (dao.jing/canonical-bytes relation)))\\n(def retained-box (atom nil))\\n(def before-retain (gc-used))\\n(reset! retained-box {:binding b :sem sem :stack stack :reg reg :relation relation})\\n(def after-retain (gc-used))\\n;; repeat delta measurement for stability\\n(def deltas (mapv (fn [_] (let [x (atom nil) b0 (gc-used)] (reset! x {:b b :s sem :st stack :r reg}) (let [a (gc-used)] (reset! x nil) (- a b0)))) (range 3)))\\n(println :compiled-status (:status compiled))\\n(println :c-status (:status c-walker) (:status c-sem))\\n(println :rows-canonical-bytes rows-bytes)\\n(println :relation-canonical-bytes rel-bytes)\\n(println :heap-baseline-gc-used base)\\n(println :stage-used stage-peaks)\\n(println :peak-used-during-pipeline @peak)\\n(println :peak-over-baseline (- @peak base))\\n(println :retained-delta-first (- after-retain before-retain))\\n(println :retained-deltas-repeat deltas)\\n(println :elapsed-ms elapsed)\\n(println :ceiling-bytes 1073741824 :peak-under-ceiling (< @peak 1073741824))\\n(System/exit 0)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794377000000-reviewer-cc3-r3-confirm.gpt-6-astra.stdout.log:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'kernel-compile|defn- link-raise|defn- carry-served|link-raise' test/yang/latte_oracle_test.clj src/cljc/yin/repl.cljc; nl -ba src/cljc/yin/repl.cljc | sed -n '1540,1680p;1855,1924p'; nl -ba /tmp/cc3-f6-measure.clj | sed -n '1,85p'; nl -ba src/cljc/yin/vm/encoder.cljc | sed -n '25,45p;140,159p