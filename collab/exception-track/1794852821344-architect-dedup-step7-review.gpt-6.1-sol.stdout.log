{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' .agents/skills/code-review-pr/scripts/pr_reviewer.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"\nPR Reviewer Utility Script for Git-based Code Reviews.\nParses git diffs, analyzes churn and file risk categories, scans for security smells\nand debugging code, and produces structured markdown or JSON review reports.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\n\n\n@dataclass\nclass Finding:\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\n    file_path: str\n    line_number: Optional[int]\n    message: str\n    snippet: str\n\n\n@dataclass\nclass FileStat:\n    path: str\n    additions: int\n    deletions: int\n    category: str\n    risk_level: str  # High, Medium, Low\n\n\n@dataclass\nclass ReviewSummary:\n    target: str\n    total_files: int\n    total_additions: int\n    total_deletions: int\n    test_additions: int\n    source_additions: int\n    test_to_source_ratio: float\n    file_stats: List[FileStat] = field(default_factory=list)\n    findings: List[Finding] = field(default_factory=list)\n    commits: List[str] = field(default_factory=list)\n\n\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\n    \"\"\"Helper to run git commands cleanly.\"\"\"\n    cmd = [\"git\"] + args\n    try:\n        res = subprocess.run(\n            cmd,\n            cwd=cwd,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=True,\n        )\n        return res.stdout.strip()\n    except subprocess.CalledProcessError as e:\n        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n        raise RuntimeError(f\"Git execution failed: {e.stderr.strip()}\")\n\n\ndef categorize_file(file_path: str) -> Tuple[str, str]:\n    \"\"\"Categorizes file type and assigns risk level.\"\"\"\n    path_lower = file_path.lower()\n\n    # Security & Auth\n    if any(k in path_lower for k in [\"auth\", \"secret\", \"crypto\", \"token\", \"permission\", \"jwt\", \"oauth\", \"password\"]):\n        return \"Security/Auth\", \"High\"\n\n    # Database & Schema\n    if any(k in path_lower for k in [\"migration\", \"schema\", \".sql\", \"entity\", \"db/\"]):\n        return \"Database/Schema\", \"High\"\n\n    # Infrastructure & Config\n    if any(k in path_lower for k in [\"docker\", \"terraform\", \".tf\", \".env\", \"k8s\", \"helm\", \"ci/cd\", \".github/workflows\"]):\n        return \"Infra/Config\", \"High\"\n    if any(file_path.endswith(ext) for ext in [\"package.json\", \"deps.edn\", \"Cargo.toml\", \"go.mod\", \"requirements.txt\", \"pom.xml\", \"build.gradle\"]):\n        return \"Dependencies\", \"Medium\"\n\n    # API / Interfaces\n    if any(k in path_lower for k in [\"proto\", \"openapi\", \"swagger\", \"graphql\", \"router\", \"controller\", \"api/\"]):\n        return \"API/Contract\", \"Medium\"\n\n    # Tests\n    if any(k in path_lower for k in [\"test\", \"spec\", \"mock\", \"fixture\", \"e2e\"]):\n        return \"Tests\", \"Low\"\n\n    # Documentation\n    if any(file_path.endswith(ext) for ext in [\".md\", \".rst\", \".txt\", \"LICENSE\"]):\n        return \"Documentation\", \"Low\"\n\n    # Core source\n    return \"Source Code\", \"Medium\"\n\n\ndef scan_diff_content(diff_text: str) -> List[Finding]:\n    \"\"\"Scans diff text for added code smells and risks.\"\"\"\n    findings: List[Finding] = []\n\n    # Patterns to match added lines\n    patterns = [\n        # Secret leaks\n        (\n            r\"(?i)^\\+.*(api[_\\-]?key|secret[_\\-]?key|bearer\\s+[a-z0-9_\\-\\.]{20,}|private[_\\-]?key)\\s*[:=]\\s*['\\\"][A-Za-z0-9%+\\/=\\-_]{8,}['\\\"]\",\n            \"P0\",\n            \"Security\",\n            \"Possible hardcoded credential or secret detected.\",\n        ),\n        (\n            r\"^\\+.*-----BEGIN (RSA|OPENSSH|EC|PRIVATE) KEY-----\",\n            \"P0\",\n            \"Security\",\n            \"Embedded private key detected.\",\n        ),\n        # Debug code left behind\n        (\n            r\"^\\+.*\\b(console\\.log|print\\(|debugger;|binding\\.pry|import pdb; pdb\\.set_trace|println!|fmt\\.Println)\\b\",\n            \"P3\",\n            \"Debug\",\n            \"Leftover debug statement detected.\",\n        ),\n        # Dangerous functions\n        (\n            r\"^\\+.*\\b(eval\\(|exec\\(|os\\.system\\(|subprocess\\.Popen\\(.*shell\\s*=\\s*True|dangerouslySetInnerHTML)\\b\",\n            \"P1\",\n            \"Security\",\n            \"Potentially unsafe dynamic execution or shell invocation.\",\n        ),\n        # Swallowed exceptions\n        (\n            r\"^\\+.*\\b(catch\\s*\\([^\\)]*\\)\\s*\\{\\s*\\}|except:\\s*pass|rescue\\s*=>\\s*nil)\\b\",\n            \"P2\",\n","exit_code":0,"status":"completed"}}
