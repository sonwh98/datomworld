{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' test/yang/core/call_test.cljc; sed -n '110,185p' src/cljc/yang/clojure/prelude.cljc; rg -n 'finally' test/yang/clojure_test.clj | tail -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' test/yang/core/call_test.cljc; sed -n '110,185p' src/cljc/yang/clojure/prelude.cljc; rg -n 'finally' test/yang/clojure_test.clj | tail -25\"","aggregated_output":"(ns yang.core.call-test\n  \"Synthetic guest proof for the language-neutral calling runtime.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.core.call :as call]\n            [yang.core.prelude :as core]\n            [yang.core.uast :as u]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.semantic.derive :as derive]\n            [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.test-utils :as tu]))\n\n\n(def ^:private registry\n  (-> (module/empty-registry)\n      module/register-cell-module\n      data/register-data-module))\n\n\n(def ^:private opts\n  {:make-stream tu/make-stream\n   :capability-secret tu/secret\n   :primitives vm/primitives\n   :modules registry})\n\n\n(def ^:private load-semantic-ast\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(def ^:private runners\n  {:ast-walker (fn [ast] (vm/eval (tu/create-vm opts) ast))\n   :semantic (fn [ast]\n               (vm/run (load-semantic-ast (semantic/create-vm opts)\n                                          (vm/ast->datoms ast))))\n   :stack (fn [ast]\n            (vm/run (dvm/create-vm\n                      (:image (derive/stack-image\n                                (:vector (sr-linearize/project ast))))\n                      (assoc opts :contract vm/stack-contract))))\n   :register (fn [ast]\n               (vm/run (rvm/create-vm\n                         (derive/register-image\n                           (:vector (sr-linearize/project ast)))\n                         (assoc opts :contract vm/register-contract))))})\n\n\n(defn- run-everywhere\n  [emitter form]\n  (let [ast (u/mark-tails (u/then emitter (u/sexp->uast form)))]\n    (into {}\n          (map (fn [[engine run]] [engine (vm/value (run ast))]))\n          runners)))\n\n\n(deftest base-validation-and-construction-test\n  (testing \"required fields, ordered names, duplicate names and receiver presence\"\n    (is (every? true?\n                (vals (run-everywhere\n                        call/uast\n                        '(yang.call/valid-invocation?\n                           {:yang.call/callee :f\n                            :yang.call/positional []\n                            :yang.call/named [[\"x\" 1] [\"x\" 2]]\n                            :yang.call/raise :exit\n                            :yang.call/receiver nil})))))\n    (is (every? false?\n                (vals (run-everywhere\n                        call/uast\n                        '(yang.call/valid-invocation?\n                           {:yang.call/callee :f\n                            :yang.call/positional []\n                            :yang.call/named [[1 :bad]]\n                            :yang.call/raise :exit})))))\n    (is (every? false?\n                (vals (run-everywhere\n                        call/uast\n                        '(yang.call/valid-invocation?\n                           {:yang.call/callee :f\n                            :yang.call/positional nil\n                            :yang.call/named []\n                            :yang.call/raise :exit}))))))\n  (testing \"invocation-with retains optional fields and cannot replace core fields\"\n    (is (every? true?\n                (vals (run-everywhere\n                        call/uast\n                        '(let [record\n                               (yang.call/invocation-with\n                                 :callee [] [] :exit\n                                 {:yang.call/receiver nil\n                                  :yang.call/callee :substitute})]\n                           (if (= :callee (get record :yang.call/callee))\n                             (if (data/contains? record :yang.call/receiver)\n                               (nil? (get record :yang.call/receiver))\n                               false)\n                             false))))))))\n\n\n(deftest entry-and-invocation-test\n  (testing \"descriptor entry, eligibility, original identity and unchanged result\"\n    (is (every? true?\n                (vals (run-everywhere\n                        call/uast\n                        '(let [callee {:opaque [1 2]}\n                               descriptor\n                               (assoc {}\n                                      :yang.call/entry\n                                      (fn [inv]\n                                        (get inv :yang.call/callee)))]\n                           (yang.call/eligible? descriptor))))))\n    (let [payload [1 2]]\n      (is (every? #(= payload %)\n                  (vals (run-everywhere\n                          call/uast\n                          '(let [callee (assoc {} :opaque [1 2])\n                                 descriptor\n                                 (assoc callee\n                                        :yang.call/entry\n                                        (fn [inv]\n                                          (get (get inv :yang.call/callee)\n                                               :opaque)))]\n                             (yang.call/invoke descriptor [] []\n                                               (fn [condition]\n                                                 condition)))))))))\n  (testing \"cell-backed entry lookup and an ineligible descriptor\"\n    (is (every? true?\n                (vals (run-everywhere\n                        call/uast\n                        '(let [descriptor\n                               (cell/new\n                                 (assoc {}\n                                        :yang.call/entry\n                                        (fn [inv] :called)))\n                               ineligible\n                               (assoc (assoc {} :yang.call/entry\n                                             (fn [inv] :wrong))\n                                      :yang.call/eligible?\n                                      (fn [callee] false))\n                               called\n                               (yang.call/invoke\n                                 descriptor [] []\n                                 (fn [condition] condition))\n                               result\n                               (yang.call/invoke\n                                 ineligible [] []\n                                 (fn [condition] condition))]\n                           (if (= :called called)\n                             (= :yang.call/not-callable\n                                (get result :yang.call/reason))\n                             false))))))))\n\n\n(deftest conditions-and-transfer-test\n  (testing \"throwing wraps condition-shaped data; normal return remains data\"\n    (is (every? true?\n                (vals (run-everywhere\n                        call/uast\n                        '(let [payload {:yang.call/reason :yang.call/thrown\n                                        :yang.call/value :inner}\n                               result (yang.call/thrown payload)]\n                           (if (= payload (get result :yang.call/value))\n                             (= :yang.call/thrown\n                                (get result :yang.call/reason))\n                             false)))))))\n  (testing \"transfer applies the supplied exit once\"\n    (is (every? #(= {:yang.call/reason :yang.call/not-callable\n                     :yang.call/data {:callee :value}\n                     :seen true}\n                    %)\n                (vals (run-everywhere\n                        call/uast\n                        '(yang.call/transfer\n                           (fn [condition]\n                             (assoc condition :seen true))\n                           (yang.call/condition :yang.call/not-callable\n                                                {:callee :value})))))))\n  (testing \"bundled and linked emitters use the same definition source\"\n    (is (= call/module-uast\n           (u/annotate-call-sites\n             (core/module-tree\n               (core/module-definitions \"yang.call\" :yang.call/uninit\n                                        [] call/definitions)\n               []))))\n    (is (= call/module-exports\n           (:exports (call/module-spec registry))))\n    (is (= call/host-names\n           (set (filter namespace\n                        (keys (:primitives (call/module-spec registry)))))))\n    (is (every? true?\n                (vals (run-everywhere\n                        call/module-uast\n                        '(valid-invocation?\n                           {:yang.call/callee :f\n                            :yang.call/positional []\n                            :yang.call/named []\n                            :yang.call/raise :exit})))))))\n\n\n(deftest cross-frontend-callable-identity-fixture-test\n  (testing \"a stored PHP function crosses a TS entry, is called, and stays same-cell\"\n    (let [results (run-everywhere\n                    call/uast\n                    '(let [php-function\n                           (cell/new\n                             (assoc {:php/type :function}\n                                    :yang.call/entry\n                                    (fn [invocation]\n                                      (get invocation :yang.call/callee))))\n                           stored (cell/new php-function)\n                           original (cell/get stored)\n                           typescript-relay\n                           (assoc {}\n                                  :yang.call/entry\n                                  (fn [invocation]\n                                    (yang.call/invoke\n                                      (get invocation :yang.call/receiver)\n                                      [] []\n                                      (get invocation :yang.call/raise))))\n                           returned\n                           (yang.call/invoke-with\n                             typescript-relay [] []\n                             (fn [condition] condition)\n                             (assoc {} :yang.call/receiver original))]\n                       (if (= original returned) :same :different)))]\n      (is (every? #{:same} (vals results))\n          (pr-str results))))\n  (testing \"Python calls a TS entry, receives a callback, then calls the PHP entry\"\n    (let [results\n          (run-everywhere\n            call/uast\n            '(let [php-function\n                   (cell/new\n                     (assoc {:php/type :function}\n                            :yang.call/entry\n                            (fn [invocation]\n                              (get invocation :yang.call/callee))))\n     (fn [hs] (cell/set! clj.rt/ctx (assoc (cell/get clj.rt/ctx) :handlers hs)))]\n    [clj/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n    [clj/frame\n     (fn [tag payload rest]\n       (conj (conj (conj (conj [] tag) payload) rest)\n             (+ 1 (clj/frame-depth rest))))]\n    [clj/pop-frame\n     (fn [hs]\n       (cell/set! clj.rt/ctx (assoc (cell/get clj.rt/ctx) :handlers (get hs 2))))]\n    [clj/raise\n     ;; deliver `e` to the current handler stack; with no handler above it\n     ;; the value escapes the whole stack (unreached in practice: the entry\n     ;; installs a top-level handler). A :finally frame runs its thunk with\n     ;; `e` before the raise continues.\n     (fn [e]\n       (let [hs (clj/handlers)]\n         (if (nil? hs)\n           (:clj/no-handler e)\n           (if (= (get hs 0) :finally)\n             (do (clj/pop-frame hs) ((get hs 1) e) (clj/raise e))\n             ((get hs 1) e)))))]\n    [clj/throw\n     ;; the guest `(throw e)` form: clojure throws arbitrary values with no\n     ;; wrapping, so it is `clj/raise` under the guest name\n     (fn [e] (clj/raise e))]\n    [clj/unwind-to\n     ;; pop frames above frame count n, running each finally thunk with nil\n     (fn [n]\n       (let [hs (clj/handlers)]\n         (if (nil? hs)\n           nil\n           (if (<= (get hs 3) n)\n             nil\n             (do (clj/pop-frame hs)\n                 (if (= (get hs 0) :finally) ((get hs 1) nil) nil)\n                 (clj/unwind-to n))))))]\n    [clj/try\n     (fn [body handler]\n       (let [saved (cell/get clj.rt/ctx)\n             flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (clj/set-handlers! (clj/frame :handler r (get saved :handlers)))\n                  (let [v (body)] (do (clj/restore! saved) v)))\n              (do (clj/restore! saved) (handler r))))\n          (%capture))))]\n    [clj/try-finally\n     ;; normal exit runs `fin` here; throw and escapes run it as they unwind\n     ;; through the :finally frame\n     (fn [body fin]\n       (let [saved (cell/get clj.rt/ctx)]\n         (do (clj/set-handlers! (clj/frame :finally fin (get saved :handlers)))\n             (let [v (body)]\n               (do (clj/restore! saved) (fin nil) v)))))]\n    [clj/call-ec\n     (fn [f]\n       (let [saved (cell/get clj.rt/ctx)\n             flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (f (fn [x]\n                       (do (clj/unwind-to (clj/frame-depth (get saved :handlers)))\n                           (clj/restore! saved)\n                           (r x)))))\n              r))\n          (%capture))))]\n\n    ;; ---------------------------