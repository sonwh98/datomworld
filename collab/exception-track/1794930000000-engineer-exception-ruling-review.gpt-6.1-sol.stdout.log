           \\\" echo (new JsonException) instanceof Exception ? 1 : 0;\\\")))))\\n    28\\t  (testing \\\"ErrorException and the engine errors extend the right roots\\\"\\n    29\\t    (is (= \\\"11\\\" (out (str \\\"<?php echo (new ErrorException) instanceof Exception ? 1 : 0;\\\"\\n    30\\t                          \\\" echo (new DivisionByZeroError) instanceof Error ? 1 : 0;\\\"))))))\\n    31\\t\\n    32\\t\\n    33\\t(deftest throw-test\\n    34\\t  (testing \\\"throw as an expression\\\"\\n    35\\t    (is (= \\\"caught\\\"\\n    36\\t           (out (str \\\"<?php function f($x) { return $x ?? throw new Exception('caught'); }\\\"\\n    37\\t                     \\\" try { f(null); } catch (Exception $e) { echo $e->getMessage(); }\\\"))))\\n    38\\t    (is (= \\\"ok\\\" (out \\\"<?php $v = null; $r = $v ?? 'ok'; echo $r;\\\"))))\\n    39\\t  (testing \\\"throwing a non-Throwable\\\"\\n    40\\t    (is (= \\\"Can only throw objects\\\"\\n    41\\t           (-> (uncaught \\\"<?php throw 5;\\\") :message))))\\n    42\\t  (testing \\\"rethrow keeps the same object\\\"\\n    43\\t    (is (= \\\"1\\\"\\n    44\\t           (out (str \\\"<?php try { try { throw new Exception('a'); } catch (Exception $e) { throw $e; } }\\\"\\n    45\\t                     \\\" catch (Exception $f) { echo $f->getMessage() == 'a' ? 1 : 0; }\\\"))))))\\n    46\\t\\n    47\\t\\n    48\\t(deftest catch-test\\n    49\\t  (testing \\\"multi-type catch, optional variable, first match wins\\\"\\n    50\\t    (is (= \\\"A\\\" (out (str \\\"<?php try { throw new TypeError('t'); }\\\"\\n    51\\t                         \\\" catch (RuntimeException | TypeError $e) { echo 'A'; } catch (Error $e) { echo 'B'; }\\\"))))\\n    52\\t    (is (= \\\"c\\\" (out \\\"<?php try { throw new Exception; } catch (Exception) { echo 'c'; }\\\")))\\n    53\\t    (is (= \\\"B\\\" (out (str \\\"<?php try { throw new Error; }\\\"\\n    54\\t                         \\\" catch (Exception $e) { echo 'A'; } catch (Throwable $e) { echo 'B'; }\\\")))))\\n    55\\t  (testing \\\"an unmatched exception propagates out of the function\\\"\\n    56\\t    (is (= \\\"outer\\\"\\n    57\\t           (out (str \\\"<?php function f() { try { throw new Exception('x'); } catch (TypeError $e) { echo 'no'; } }\\\"\\n    58\\t                     \\\" try { f(); } catch (Exception $e) { echo 'outer'; }\\\")))))\\n    59\\t  (testing \\\"a leading backslash names the same class\\\"\\n    60\\t    (is (= \\\"k\\\" (out \\\"<?php try { throw new Exception; } catch (\\\\\\\\Exception $e) { echo 'k'; }\\\")))))\\n    61\\t\\n    62\\t\\n    63\\t(deftest finally-test\\n    64\\t  (testing \\\"finally runs on every exit and can override a return\\\"\\n    65\\t    (is (= \\\"F1\\\" (out \\\"<?php function f() { try { return 1; } finally { echo 'F'; } } echo f();\\\")))\\n    66\\t    (is (= \\\"2\\\" (out \\\"<?php function f() { try { return 1; } finally { return 2; } } echo f();\\\")))\\n    67\\t    (is (= \\\"Fa\\\" (out (str \\\"<?php try { try { throw new Exception('a'); } finally { echo 'F'; } }\\\"\\n    68\\t                          \\\" catch (Exception $e) { echo $e->getMessage(); }\\\")))))\\n    69\\t  (testing \\\"an exception from finally replaces the one in flight\\\"\\n    70\\t    (is (= \\\"b\\\" (out (str \\\"<?php try { try { throw new Exception('a'); } finally { throw new Exception('b'); } }\\\"\\n    71\\t                         \\\" catch (Exception $e) { echo $e->getMessage(); }\\\")))))\\n    72\\t  (testing \\\"finally after a catch, in a loop with break\\\"\\n    73\\t    (is (= \\\"cF\\\" (out \\\"<?php try { throw new Exception; } catch (Exception $e) { echo 'c'; } finally { echo 'F'; }\\\")))\\n    74\\t    (is (= \\\"F\\\" (out \\\"<?php while (true) { try { break; } finally { echo 'F'; } }\\\")))))\\n    75\\t\\n    76\\t\\n    77\\t(deftest match-test\\n    78\\t  (testing \\\"strict comparison, several arms, default\\\"\\n    79\\t    (is (= \\\"b\\\" (out \\\"<?ph