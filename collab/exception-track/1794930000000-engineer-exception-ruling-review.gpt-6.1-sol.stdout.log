                  (u/lit :yang.call/invalid-invocation)\\n  1388\\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\\n  1389\\t                       u/capture)\\n  1390\\t          routed (if (::invoker env)\\n  1391\\t                   (u/if-node\\n  1392\\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\\n  1393\\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\\n  1394\\t                                           (u/lit true)\\n  1395\\t                                           ;; the shape is only WHEN to ask (ruling of\\n  1396\\t                                           ;; record, rule 2): the heap answers\\n  1397\\t                                           ;; `cell/authentic?`, and an unauthenticated\\n  1398\\t                                           ;; shape takes ordinary map invocation\\nsrc/cljc/yang/core/call.cljc:37:    [yang.call/entry\\nsrc/cljc/yang/core/call.cljc:39:       (get (yang.call/_descriptor callable) :yang.call/entry))]\\nsrc/cljc/yang/core/call.cljc:43:         (if (nil? (yang.call/entry callable))\\nsrc/cljc/yang/core/call.cljc:49:     (fn [callee positional named raise]\\nsrc/cljc/yang/core/call.cljc:53:              :yang.call/raise raise))]\\nsrc/cljc/yang/core/call.cljc:55:     (fn [callee positional named raise options]\\nsrc/cljc/yang/core/call.cljc:59:              :yang.call/raise raise))]\\nsrc/cljc/yang/core/call.cljc:81:               (if (data/contains? invocation :yang.call/raise)\\nsrc/cljc/yang/core/call.cljc:97:    [yang.call/thrown\\nsrc/cljc/yang/core/call.cljc:99:       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\\nsrc/cljc/yang/core/call.cljc:102:     (fn [raise condition]\\nsrc/cljc/yang/core/call.cljc:103:       (raise condition))]\\nsrc/cljc/yang/core/call.cljc:105:     (fn [callable positional named raise]\\nsrc/cljc/yang/core/call.cljc:106:       (if (data/callable