{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/typescript/antlr/prelude.cljc | sed -n '1550,1765p'; nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '865,920p;1005,1065p'\"","aggregated_output":"  1550\t           (if (= k :string)\n  1551\t             (js/string-get v key)\n  1552\t             (if (if (= k :number) true (if (= k :boolean) true (if (= k :bigint) true (= k :symbol))))\n  1553\t               (js/get-prop-r (js/proto-of-primitive v) key v)\n  1554\t               (js/throw-type-error\n  1555\t                 (js/str-concat\n  1556\t                   {:js/str \"Cannot read properties of \"}\n  1557\t                   (js/str-concat\n  1558\t                     (js/to-string v)\n  1559\t                     (js/str-concat\n  1560\t                       {:js/str \" (reading '\"}\n  1561\t                       (js/str-concat (js/to-string key)\n  1562\t                                      {:js/str \"')\"}))))))))))]\n  1563\t\n  1564\t\n  1565\t    ;; ------------------------------------------------------------ functions\n  1566\t    ;; A function cell holds {:js/type :function :code (fn [this args] ..)\n  1567\t    ;; :yang.call/entry (fn [invocation] ..)\n  1568\t    ;; :this-mode :strict|:lexical :name s :length n :props om :proto ref\n  1569\t    ;; :extensible? true}; every call is (js/call f this args).\n  1570\t    ;; `nt?` true means the code takes a third argument, the new.target\n  1571\t    ;; (undefined under a plain call); `js/make-function` keeps the landed\n  1572\t    ;; five-argument shape for the callers that never construct through\n  1573\t    ;; new.target.\n  1574\t    [js/make-function\n  1575\t     (fn [name length this-mode kind code]\n  1576\t       (js/make-function-nt name length this-mode kind code false))]\n  1577\t    [js/make-function-nt\n  1578\t     (fn [name length this-mode kind code nt?]\n  1579\t       ;; Ordinary calls enter th