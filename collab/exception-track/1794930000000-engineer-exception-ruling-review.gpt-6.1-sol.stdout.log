ing();\\n} catch (Exception $e) {}\\n\\nvar_dump(error_reporting());\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1113:   \"Bug #38623 (leaks in a tricky code with switch() and exceptions)\",\ntest/yang/php/antlr/phpt_selection.edn:1121:   \"Bug #38624 (Strange warning when incrementing an object property and exception is thrown from __get method)\",\ntest/yang/php/antlr/phpt_selection.edn:1295:   \"<?php\\n\\nclass ehandle{\\n    static public function exh ($ex) {\\n        echo 'foo';\\n    }\\n}\\n\\nset_exception_handler(\\\"ehandle::exh\\\");\\n\\nthrow new Exception (\\\"Whiii\\\");\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1297:   \"Bug #40815 (using strings like \\\"class::func\\\" and static methods in set_exception_handler() might result in crash).\",\ntest/yang/php/antlr/phpt_selection.edn:1373:   \"<?php\\n\\nclass wrapper {\\n    public $context;\\n    function stream_open() {\\n        return true;\\n    }\\n    function stream_eof() {\\n        throw new exception();\\n    }\\n}\\n\\nstream_wrapper_register(\\\"wrap\\\", \\\"wrapper\\\");\\n$fp = fopen(\\\"wrap://...\\\", \\\"r\\\");\\nfeof($fp);\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1375:   \"Bug #41421 (Uncaught exception from a stream wrapper segfaults)\",\ntest/yang/php/antlr/phpt_selection.edn:1505:   \"Bug #43175 (__destruct() throwing an exception with __call() causes segfault)\",\ntest/yang/php/antlr/phpt_selection.edn:1607:   :title \"Bug #44184 (Double free of loop-variable on exception)\",\ntest/yang/php/antlr/phpt_selection.edn:1630:   \"<?php\\n\\ntry {\\n    define('foo::bar', 1);\\n} catch (ValueError $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\ntry {\\n    define('::', 1);\\n} catch (ValueError $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1714:   \"Bug #45805 (Crash on throwing 