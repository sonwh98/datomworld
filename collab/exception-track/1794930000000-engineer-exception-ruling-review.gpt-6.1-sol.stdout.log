n() {\\n    echo 'Second handler' . PHP_EOL;\\n});\\n\\nset_exception_handler(null);\\n\\nset_exception_handler(function() {\\n    echo 'Fourth handler' . PHP_EOL;\\n});\\n\\nrestore_exception_handler();\\nrestore_exception_handler();\\n\\nthrow new Exception();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2879:   \"Bug #63206 Fully support exception_handler stacking, even with null\",\ntest/yang/php/antlr/phpt_selection.edn:2983:   \"<?php\\n\\nfunction exception_error_handler() {\\n        throw new Exception();\\n}\\n\\nset_error_handler(\\\"exception_error_handler\\\");\\ntry {\\n   $undefined->undefined();\\n} catch(Throwable $e) {\\n    echo \\\"Exception is thrown\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3079:   \"<?php\\n\\n#[AllowDynamicProperties]\\nclass a extends exception {\\n    public function __construct() {\\n        $this->message = NULL;\\n        $this->string  = NULL;\\n        $this->code    = array();\\n        $this->line = 0;\\n    }\\n}\\n\\nthrow new a;\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3088:   \"<?php\\n\\nclass a extends exception {\\n    public function __construct() {\\n        $this->line = 0;\\n    }\\n}\\n\\nthrow new a;\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3097:   \"<?php\\n\\nclass a extends exception {\\n    public function __construct() {\\n        $this->line = 0;\\n        $this->file = \\\"\\\";\\n    }\\n}\\n\\nthrow new a;\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3115:   \"<?php\\n// this makes ob_end_clean raise an error\\nob_end_flush();\\n\\nclass ExceptionHandler {\\n    public function __invoke (Exception $e)\\n    {\\n        // this triggers the custom error handler\\n        ob_end_clean();\\n    }\\n}\\n\\n// this must be a class, closure does not trigger segfault\\nset_exception_handler(new ExceptionHandler());\\n\\n// exception must be thrown from error handler.\\nset_error_handler(function()\\n{\\n    $e = new Exception;\\n    $e->_trace = debug_backtrace();\\n\\n    throw $e;\\n});\\n\\n// trigger error handler\\n$a['waa'];\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3462:   \"Bug #69212: Leaking VIA_HANDLER func when exception thrown in __call/... arg passing\",\ntest/yang/php/antlr/phpt_selection.edn:3909:   \"Bug #70785 (Infinite loop due to exception during identical comparison)\",\ntest/yang/php/antlr/phpt_selection.edn:4000:   \"Bug #70944 (try{ } finally{} can create infinite chains of exceptions)\",\ntest/yang/php/antlr/phpt_selection.edn:4330:   \"<?php\\nerror_reporting(E_ALL);\\n$var11 = new StdClass();\\n\\ntry {\\n    $var16 = error_reporting($var11);\\n} catch (TypeError $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4533:   \"Bug #73337 (try/catch not working with two exceptions inside a same operation)\",\ntest/yang/php/antlr/phpt_selection.edn:4541:   \"Bug #73338: Ensure exceptions in function init opcodes are cleaned properly\",\ntest/yang/php/antlr/phpt_selection.edn:4942:   \"<?php\\n\\nfunction handleError($errno, $errstr, $errfile, $errline) {\\n    $exception = new exception(\\\"blah\\\");\\n    throw $exception;\\n}\\nset_error_handler('handleError', E_ALL);\\n$c = $b[$a];\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4944:   \"Bug #76025 (Segfault while throwing exception in error_handler)\",\ntest/yang/php/antlr/phpt_selection.edn:4982:   \"Bug #76502: Chain of mixed exceptions and errors does not serialize properly\",\ntest/yang/php/antlr/phpt_selection.edn:5165:   \"Bug #78239: Deprecation notice during string conversion converted to exception hangs\",\ntest/yang/php/antlr/phpt_selection.edn:5331:   \"Bug #78810: RW fetches do not throw \\\"uninitialized property\\\" exception\",\ntest/yang/php/antlr/phpt_selection.edn:5435:   \"Bug #79790: \\\"Illegal offset type\\\" exception during AST evaluation not handled properly\",\ntest/yang/php/antlr/phpt_selection.edn:5570:   \"<?php\\n\\nclass x {\\n    public function __construct(){\\n        set_exception_handler([$this, 'dummyExceptionHandler']);\\n        set_exception_handler([$this, 'dummyExceptionHandler']);\\n        set_error_handler([$this, 'dummyErrorHandler']);\\n        set_error_handler([$this, 'dummyErrorHandler']);\\n    }\\n\\n    public function __call($m, $p) {}\\n}\\n\\nnew x;\\n\\n?>\\n===DONE===\",\ntest/yang/php/antlr/phpt_selection.edn:5572:   \"Bug #80045: memleak after two set_exception_handler calls with __call\",\ntest/yang/php/antlr/phpt_selection.edn:5673:   \"<?php\\n\\nfunction exceptions_error_handler($severity, $message, $filename, $lineno) {\\n    if (error_reporting() & $severity) {\\n        throw new ErrorException($message, 0, $severity, $filename, $lineno);\\n    }\\n}\\nset_error_handler('exceptions_error_handler');\\n\\n$float = 10e120;\\n$string_float = (string) $float;\\n\\n$string = 'Here is some text for good measure';\\n\\ntry {\\n    echo 'Float casted to string compile', \\\\PHP_EOL;\\n    $string[(string) 10e120] = 'E';\\n    var_dump($string);\\n} catch (\\\\TypeError $e) {\\n    echo $e->getMessage(), \\\\PHP_EOL;\\n}\\n\\n/* This same bug also permits to modify the first byte of a string even if\\n * the offset is invalid */\\ntry {\\n    /* This must not affect the string value */\\n    $string[\\\"wrong\\\"] = \\\"f\\\";\\n} catch (\\\\Throwable $e) {\\n    echo $e->getMessage() . \\\\PHP_EOL;\\n}\\nvar_dump($string);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5791:   :title \"Iterator exceptions in foreach by value\",\ntest/yang/php/antlr/phpt_selection.edn:5912:   :title \"Empty foreach loops with exception must not leak\",\ntest/yang/php/antlr/phpt_selection.edn:6168:   :title \"GC 030: GC and exceptions in destructors\",\ntest/yang/php/antlr/phpt_selection.edn:6871:   \"<?php\\n\\nclass Foo {\\n    public function __construct(\\n        public readonly int $bar\\n    ) {}\\n\\n    public function __clone()\\n    {\\n        $this->bar = 2;\\n        var_dump($this);\\n        $this->bar = 3;\\n    }\\n}\\n\\n$foo = new Foo(1);\\n\\ntry {\\n    clone $foo;\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\necho \\\"done\\\";\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6879:   \"<?php\\n\\nclass Foo {\\n    public function __construct(\\n        public readonly int $bar,\\n        public readonly int $baz\\n    ) {}\\n\\n    public function wrongCloneOld()\\n    {\\n        $instance = clone $this;\\n        $this->bar++;\\n    }\\n\\n    public function wrongCloneNew()\\n    {\\n        $instance = clone $this;\\n        $instance->baz++;\\n    }\\n}\\n\\n$foo = new Foo(1, 1);\\n\\ntry {\\n    $foo->wrongCloneOld();\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\ntry {\\n    $foo->wrongCloneNew();\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6888:   \"<?php\\n\\nclass Foo {\\n    public function __construct(\\n        public readonly int $bar,\\n        public readonly int $baz\\n    ) {}\\n\\n    public function __clone() {}\\n\\n    public function wrongCloneOld()\\n    {\\n        $instance = clone $this;\\n        $this->bar++;\\n    }\\n\\n    public function wrongCloneNew()\\n    {\\n        $instance = clone $this;\\n        $instance->baz++;\\n    }\\n}\\n\\n$foo = new Foo(1, 1);\\n\\ntry {\\n    $foo->wrongCloneOld();\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\ntry {\\n    $foo->wrongCloneNew();\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6897:   \"<?php\\n\\nclass Foo {\\n    public function __construct(\\n        public readonly int $bar\\n    ) {}\\n\\n    public function __clone()\\n    {\\n        $this->bar += 2;\\n        var_dump($this);\\n        $this->bar += 3;\\n    }\\n}\\n\\n$foo = new Foo(1);\\n\\ntry {\\n    clone $foo;\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\ntry {\\n    clone $foo;\\n} catch (Error $exception) {\\n    echo $exception->getMessage() . \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7098:   :title \"Temporary leak on exception\",\ntest/yang/php/antlr/phpt_selection.edn:7147:   \"<?php\\ntry {\\n    switch (\\\"1\\\" . (int)2) {\\n        case 12:\\n            throw new Exception();\\n    }\\n} catch (Exception $e) {\\n    echo \\\"exception\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7149:   :expect \"exception\",\ntest/yang/php/antlr/phpt_selection.edn:7154:   \"<?php\\nclass bar {\\n        public $foo = 1;\\n        public $bar = 1;\\n\\n        function __destruct() {\\n                throw $this->foo;\\n        }\\n}\\nforeach (new bar as &$foo) {\\n        try {\\n                $foo = new Exception;\\n                return; // frees the loop variable\\n        } catch (Exception $e) {\\n                echo \\\"exception\\\\n\\\";\\n        }\\n}\\necho \\\"end\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7162:   \"<?php\\nfunction test() {\\n    try {\\n        $a = [1, 2, 3];\\n        return $a + [];\\n    } finally {\\n        throw new Exception;\\n    }\\n}\\n\\ntry {\\n    test();\\n} catch (Exception $e) {\\n    echo \\\"exception\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7164:   :expect \"exception\",\ntest/yang/php/antlr/phpt_selection.edn:7169:   \"<?php\\nclass A {\\n    function __destruct() {\\n        throw new Exception();\\n    }\\n}\\n$b = new A();\\n$x = 0;\\n$c = [[$x,$x]];\\ntry {\\n    list($a, $b) = $c[0];\\n} catch (Exception $e) {\\n    echo \\\"exception\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7171:   :expect \"exception\",\ntest/yang/php/antlr/phpt_selection.edn:8216:  {:id \"tests/classes/destructor_and_exceptions.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8217:   :path \"tests/classes/destructor_and_exceptions.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8219:   \"<?php\\n\\nclass FailClass\\n{\\n    public $fatal;\\n\\n    function __destruct()\\n    {\\n        echo __METHOD__ . \\\"\\\\n\\\";\\n        throw new exception(\\\"FailClass\\\");\\n        echo \\\"Done: \\\" . __METHOD__ . \\\"\\\\n\\\";\\n    }\\n}\\n\\ntry\\n{\\n    $a = new FailClass;\\n    unset($a);\\n}\\ncatch(Exception $e)\\n{\\n    echo \\\"Caught: \\\" . $e->getMessage() . \\\"\\\\n\\\";\\n}\\n\\nclass FatalException extends Exception\\n{\\n    function __construct($what)\\n    {\\n        echo __METHOD__ . \\\"\\\\n\\\";\\n        $o = new FailClass;\\n        unset($o);\\n        echo \\\"Done: \\\" . __METHOD__ . \\\"\\\\n\\\";\\n    }\\n}\\n\\ntry\\n{\\n    throw new FatalException(\\\"Damn\\\");\\n}\\ncatch(Exception $e)\\n{\\n    echo \\\"Caught Exception: \\\" . $e->getMessage() . \\\"\\\\n\\\";\\n}\\ncatch(FatalException $e)\\n{\\n    echo \\\"Caught FatalException: \\\" . $e->getMessage() . \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8220:   :title \"ZE2 catch exception thrown in destructor\",\n    70\t    [clj/define-global!\n    71\t     (fn [name value]\n    72\t       (do (cell/set! clj.rt/globals\n    73\t                      (assoc (cell/get clj.rt/globals) name value))\n    74\t           value))]\n    75\t    [clj/global-get\n    76\t     (fn [name]\n    77\t       (if (data/contains? (cell/get clj.rt/globals) name)\n    78\t         (get (cell/get clj.rt/globals) name)\n    79\t         :clj/unbound))]\n    80\t\n    81\t    ;; ------------------------------------------------------------- entry\n    82\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n    83\t    ;; internal, so the entry removes one wrapper level from the\n    84\t    ;; program's value (a program returning that vector as data was\n    85\t    ;; wrapped again, so one level is exact). An error outcome passes\n    86\t    ;; through as the failure value for the caller to render.\n    87\t    [clj/unwrap-outcome\n    88\t     (fn [value]\n    89\t       (if (if (data/vector? value) (= (data/count value) 2) false)\n    90\t         (if (= (data/nth value 0) :yin.k/ok)\n    91\t           (data/nth value 1)\n    92\t           value)\n    93\t         value))]\n    94\t    ;; The global namespace is the task's, not the entry's: no reset\n    95\t    ;; here, so projections and earlier units' definitions survive.\n    96\t    [clj/run-main\n    97\t     (fn [body]\n    98\t       (do (clj/init!)\n    99\t           (clj/unwrap-outcome (body))))]])\n   100\t\n   101\t\n   102\t(def module-definitions\n   103\t  \"The module's definition list: an `:clj/uninit` placeholder for every\n   104\t   runtime key, then every definition, stripped.\"\n   105\t  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n   280\t    [py/set-handlers!\n   281\t     (fn [hs] (cell/set! py.rt/ctx (assoc (cell/get py.rt/ctx) :handlers hs)))]\n   282\t    [py/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n   283\t    [py/frame\n   284\t     (fn [kind payload rest]\n   285\t       (py/vconj (py/vconj (py/vconj (py/vconj (py/vconj [] kind) payload) rest)\n   286\t                           (+ 1 (py/frame-depth rest)))\n   287\t                 (get (cell/get py.rt/ctx) :depth)))]\n   288\t    [py/pop-frame\n   289\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\n   290\t     (fn [hs]\n   291\t       (cell/set! py.rt/ctx\n   292\t                  (assoc (assoc (cell/get py.rt/ctx) :handlers (get hs 2))\n   293\t                         :depth (get hs 4))))]\n   294\t    [py/raise\n   295\t     (fn [e]\n   296\t       (let [hs (py/handlers)]\n   297\t         (if (nil? hs)\n   298\t           (:py/no-handler e)\n   299\t           (if (= (get hs 0) :finally)\n   300\t             (do (py/pop-frame hs)\n   301\t       