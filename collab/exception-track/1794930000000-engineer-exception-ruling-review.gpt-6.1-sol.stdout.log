{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/core/prelude.cljc | sed -n '1,245p'; nl -ba src/cljc/yang/clojure.cljc | sed -n '1122,1140p;1300,1367p;2275,2353p'; rg -n 'yang.call|source-call|prelude-parity|portable|dart|cljd' shadow-cljs.edn deps.edn cljdoc.edn bb.edn | tail -n 85\"","aggregated_output":"     1\t(ns yang.core.prelude\n     2\t  \"Emitter machinery shared by every language's runtime-profile prelude\n     3\t   (docs/design/yang.typescript.md §17, lift L1). A language supplies its\n     4\t   module's own namespace string, its uninit sentinel, its definition list\n     5\t   and its refusal namespace; everything here is a pure function of those.\"\n     6\t  (:require\n     7\t    [clojure.walk :as walk]\n     8\t    [yang.core.uast :as u]\n     9\t    [yin.vm :as vm]\n    10\t    [yin.vm.module :as module]))\n    11\t\n    12\t\n    13\t(defn define\n    14\t  \"`(yin/def (quote key) form)` in prelude notation: the key quoted, so\n    15\t   `sexp->uast` reads it as the literal symbol Rule R requires.\"\n    16\t  [key form]\n    17\t  (list 'yin/def (list 'quote key) form))\n    18\t\n    19\t\n    20\t(defn strip\n    21\t  \"`sym` without the module's own namespace `ns-str`; any other value as it\n    22\t   is. Qualified internal store keys stay qualified.\"\n    23\t  [ns-str sym]\n    24\t  (if (and (symbol? sym) (= ns-str (namespace sym)))\n    25\t    (symbol (name sym))\n    26\t    sym))\n    27\t\n    28\t\n    29\t(defn strip-form\n    30\t  \"A prelude-notation form with every symbol `strip`ped: references,\n    31\t   definition keys and quoted keys alike. Keywords, strings and the\n    32\t   keys of literal maps are untouched.\"\n    33\t  [ns-str form]\n    34\t  (walk/postwalk (partial strip ns-str) form))\n    35\t\n    36\t\n    37\t(defn placeholder\n    38\t  \"The `[k uninit]` definition for runtime key `k`, so each read of it is\n    39\t   discharged by an unconditional module-level definition.\"\n    40\t  [k uninit]\n    41\t  [k uninit])\n    42\t\n    43\t\n    44\t(defn module-definitions\n    45\t  \"The module's definition list: a `uninit` placeholder for every runtime\n    46\t   key (stripped of `ns-str`), then every definition, stripped.\"\n    47\t  [ns-str uninit runtime-keys definitions]\n    48\t  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n    49\t        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n    50\t        definitions))\n    51\t\n    52\t\n    53\t(defn wide-app\n    54\t  \"One application whose operands are `nodes` (in order), applied to a lambda\n    55\t   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n    56\t   linker's scanners discharge every body read of a sibling or runtime key;\n    57\t   a `then` chain would nest definitions in closure bodies.\"\n    58\t  [nodes]\n    59\t  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    60\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n    61\t\n    62\t\n    63\t(defn module-tree\n    64\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    65\t   the `trailing` UAST nodes.\"\n    66\t  [defs trailing]\n    67\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    68\t                  trailing)))\n    69\t\n    70\t\n    71\t(defn exports\n    72\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    73\t   stripped.\"\n    74\t  [ns-str definitions]\n    75\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    76\t             definitions)))\n    77\t\n    78\t\n    79\t(defn free-names\n    80\t  \"Every variable name some occurrence of the map AST `ast` reads\n    81\t   unbound by an enclosing lambda.\"\n    82\t  [ast]\n    83\t  (letfn [(walk-node\n    84\t            [acc node bound]\n    85\t            (cond\n    86\t              (vector? node) (reduce (fn [a n] (walk-node a n bound)) acc node)\n    87\t              (not (map? node)) acc\n    88\t              :else\n    89\t              (case (:type node)\n    90\t                :variable (if (contains? bound (:name node))\n    91\t                            acc\n    92\t                            (conj acc (:name node)))\n    93\t                :literal acc\n    94\t                :lambda (walk-node acc (:body node) (into bound (:params node)))\n    95\t                (reduce (fn [a v] (walk-node a v bound)) acc (vals node)))))]\n    96\t    (walk-node #{} ast #{})))\n    97\t\n    98\t\n    99\t(defn defined-keys\n   100\t  \"Every literal key the map AST `ast` defines with `yin/def`, at any\n   101\t   depth.\"\n   102\t  [ast]\n   103\t  (set (keep (fn [node]\n   104\t               (when (and (map? node)\n   105\t                          (= :application (:type node))\n   106\t                          (= 'yin/def (get-in node [:operator :name])))\n   107\t                 (get-in node [:operands 0 :value])))\n   108\t             (tree-seq coll? seq ast))))\n   109\t\n   110\t\n   111\t(defn free-name-vec\n   112\t  \"The names `ast` reads and does not define, sorted.\"\n   113\t  [ast]\n   114\t  (vec (sort-by str\n   115\t                (remove (conj (defined-keys ast) 'yin/def) (free-names ast)))))\n   116\t\n   117\t\n   118\t(defn- refusal\n   119\t  [refusal-ns kind data]\n   120\t  (merge {(keyword refusal-ns \"refusal\") (keyword refusal-ns kind)} data))\n   121\t\n   122\t\n   123\t(defn host-declaration\n   124\t  \"`[n declaration]` for free name `n`: a primitive by its `vm/primitives`\n   125\t   profile, a host export `ns/name` by the profile address the registry's\n   126\t   host module `ns` publishes and its `:callable-effects` effect set; nil\n   127\t   when neither supplies it.\"\n   128\t  [registry n]\n   129\t  (if-let [profile (vm/profile-of vm/primitives n)]\n   130\t    [n profile]\n   131\t    (when-let [address (module/host-export-profile registry n)]\n   132\t      (let [entry (module/module-entry (:modules registry) (symbol (namespace n)))\n   133\t            f (get-in entry [:slice (symbol (name n))])]\n   134\t        [n {:yin.k/profile address,\n   135\t            :yin.k/effects (get (:callable-effects registry) f #{})}]))))\n   136\t\n   137\t\n   138\t(defn module-spec\n   139\t  \"`yin.vm.linker.publish/publish-module!`'s spec for module `module-name`.\n   140\t   `skip?` (n -> bool) marks free names a requirement already declares;\n   141\t   `requires` is the requirement map. A free name nothing supplies is\n   142\t   refused with `message` under `refusal-ns` before anything is published.\n   143\t   This namespace emits; it never publishes.\"\n   144\t  [{:keys [module-name ast exports requires free-names skip? registry message\n   145\t           refusal-ns]}]\n   146\t  {:name module-name,\n   147\t   :ast ast,\n   148\t   :exports exports,\n   149\t   :requires requires,\n   150\t   :primitives\n   151\t   (into {}\n   152\t         (keep (fn [n]\n   153\t                 (when-not (and skip? (skip? n))\n   154\t                   (or (host-declaration registry n)\n   155\t                       (throw (ex-info message\n   156\t                                       (refusal refusal-ns \"undeclared-free\"\n   157\t                                                {:name n})))))))\n   158\t         free-names)})\n   159\t\n   160\t\n   161\t(defn admit\n   162\t  \"Return `registry` when it supplies every one of `host-names`, else refuse\n   163\t   it before any program runs, naming each missing export in\n   164\t   `:<refusal-ns>/missing`.\"\n   165\t  [registry host-names message refusal-ns]\n   166\t  (let [missing (vec (sort-by str\n   167\t                              (remove #(some? (module/resolve-module\n   168\t                                        