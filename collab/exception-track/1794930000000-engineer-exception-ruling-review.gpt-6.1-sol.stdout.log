ce cls)]\n   751\t         (do (py/setattr e \"args\" (py/tuple (py/vconj [] msg))) e)))]\n   752\t    [py/raise-new (fn [cls msg] (py/raise (py/make-exc cls msg)))]\n   753\t    [py/type-error (fn [msg] (py/raise-new py.b/TypeError msg))]\n   754\t    [py/as-exception\n   755\t     ;; `raise X`: a BaseException subclass is instantiated, an instance of\n   756\t     ;; one is raised as is, anything else is a TypeError\n   757\t     (fn [x]\n   758\t       (let [t (py/content-type x)]\n   759\t         (if (if (= t :class) (py/subclass? x py.b/BaseException) false)\n   760\t           (py/call x [])\n   761\t           (if (if (= t :instance)\n   762\t                 (py/subclass? (get (cell/get x) :class) py.b/BaseException)\n   763\t                 false)\n   764\t             x\n   765\t             (py/type-error {:py/str \"exceptions must derive from BaseException\"})))))]\n   766\t    [py/subclass?\n   767\t     (fn [c target]\n   768\t       (if (= c :py/None)\n   769\t         false\n   770\t         (if (= c target) true (py/subclass? (get (cell/get c) :base) target))))]\n   771\t    [py/class-match?\n   772\t     ;; c (a class, or None) against target: a class, or a tuple of classes\n   773\t     ;; and tuples, matched recursively. A target that is neither is a\n   774\t     ;; TypeError `msg`; with `exc?` a class must also derive from\n   775\t     ;; BaseException, as an except clause requires.\n   776\t     (fn [c target exc? msg]\n   777\t       (if (= (get target :py/type) :tuple)\n   778\t         (py/any-class-match? c (get target :items) 0 exc? msg)\n   779\t         (if (= (py/content-type target) :class)\n   780\t           (if (if exc? (not (py/subclass? target py.b/BaseException)) false)\n   781\t             (py/type-error msg)\n   782\t             (py/subclass? c target))\n   783\t           (py/type-error msg))))]\n   784\t    [py/any-class-match?\n   785\t     (fn [c ts i exc? msg]\n   786\t       (let [t (get ts i :py/stop)]\n   787\t         (if (= t :py/stop)\n   788\t           false\n   789\t           (if (py/class-match? c t exc? msg)\n   790\t             true\n   791\t             (py/any-class-match? c ts (+ i 1) exc? msg)))))]\n   792\t    [py/isinstance\n   793\t     (fn [o cls]\n   794\t       (py/class-match? (py/type-of o) cls false\n   795\t                        {:py/str \"isinstance() arg 2 must be a type or tuple of types\"}))]\n   796\t    [py/exc-class?\n   797\t     (fn [x] (if (= (py/content-type x) :class) (py/subclass? x py.b/BaseException) false))]\n   798\t    [py/all-exc-classes?\n   799\t     (fn [ts i]\n   800\t       (let [t (get ts i :py/stop)]\n   801\t         (if (= t :py/stop) true (if (py/exc-class? t) (py/all-exc-classes? ts (+ i 1)) false))))]\n   802\t    [py/exc-matches\n   803\t     ;; an except clause's test of the exception in flight, as CPython does\n   804\t     ;; it: a BaseException subclass, or a flat tuple of them, every element\n   805\t     ;; checked before any is matched; anything else (a nested tuple\n   806\t     ;; included) is a TypeError\n   807\t     (fn [e cls]\n   808\t       (if (if (= (get cls :py/type) :tuple)\n   809\t             (py/all-exc-classes? (get cls :items) 0)\n   810\t             (py/exc-class? cls))\n   811\t         (py/class-match? (py/type-of e) cls true {:py/str \"\"})\n   812\t         (py/type-error (py/str (data/str-concat\n   813\t                                  \"catching classes that do not inherit from \"\n   814\t                                  \"BaseException is not allowed\")))))]\n   815\t\n   816\t    ;; ---------------------------------------------------------- names\n   817\t    [py/local-get\n   818\t     (fn [c n]\n   819\t       (let [x (cell/get c)]\n   820\t         (if (= x :py/unbound)\n","exit_code":0,"status":"completed"}}
