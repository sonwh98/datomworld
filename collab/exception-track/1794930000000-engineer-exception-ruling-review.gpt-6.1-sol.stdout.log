ct() {\\n    echo \\\"Inside constructor\\\\n\\\";\\n    throwme($this);\\n  }\\n\\n  function __destruct() {\\n    echo \\\"Inside destructor\\\\n\\\";\\n  }\\n}\\n\\ntry {\\n  $bar = new foo;\\n} catch(Exception $exc) {\\n  echo \\\"Caught exception!\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:278:   \"Bug #29368.1 (The destructor is called when an exception is thrown from the constructor).\",\ntest/yang/php/antlr/phpt_selection.edn:279:   :expect \"Inside constructor\\nCaught exception!\",\ntest/yang/php/antlr/phpt_selection.edn:286:   \"Bug #29368.2 (The destructor is called when an exception is thrown from the constructor).\",\ntest/yang/php/antlr/phpt_selection.edn:292:   \"<?php\\nclass Foo {\\n    function __construct() {\\n        echo __METHOD__ . \\\"\\\\n\\\";\\n    }\\n    function __destruct() {\\n        echo __METHOD__ . \\\"\\\\n\\\";\\n    }\\n}\\nclass Bar {\\n    function __construct() {\\n        echo __METHOD__ . \\\"\\\\n\\\";\\n        throw new Exception;\\n    }\\n    function __destruct() {\\n        echo __METHOD__ . \\\"\\\\n\\\";\\n    }\\n}\\n\\ntry {\\n    new Foo() + new Bar();\\n} catch(Exception $exc) {\\n    echo \\\"Caught exception!\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:294:   \"Bug #29368.3 (The destructor is called when an exception is thrown from the constructor).\",\ntest/yang/php/antlr/phpt_selection.edn:296:   \"Foo::__construct\\nBar::__construct\\nFoo::__destruct\\nCaught exception!\",\ntest/yang/php/antlr/phpt_selection.edn:357:   :title \"Bug #30161 (Segmentation fault with exceptions)\",\ntest/yang/php/antlr/phpt_selection.edn:365:   \"Bug #30162 (Catching exception in constructor couses lose of $this)\",\ntest/yang/php/antlr/phpt_selection.edn:417:   :title \"Bug #30707 (Segmentation fault on exception in method)\",\ntest/yang/php/antlr/phpt_selection.edn:425:   \"Bug #30725 (PHP segfaults when an exception is thrown in getIterator() within foreach)\",\ntest/yang/php/antlr/ph