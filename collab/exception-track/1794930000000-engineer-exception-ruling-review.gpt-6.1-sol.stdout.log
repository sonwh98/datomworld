     (vm/run (load-semantic-ast (semantic/create-vm opts)\n    56\t                                          (vm/ast->datoms ast)))),\n    57\t   :stack (fn [ast]\n    58\t            (vm/run (dvm/create-vm\n    59\t                      (:image (derive/stack-image\n    60\t                                (:vector (sr-linearize/project ast))))\n    61\t                      (assoc opts :contract vm/stack-contract)))),\n    62\t   :register (fn [ast]\n    63\t               (vm/run\n    64\t                 (rvm/create-vm\n    65\t                   (derive/register-image (:vector (sr-linearize/project ast)))\n    66\t                   (assoc opts :contract vm/register-contract))))})\n    67\t\n    68\t\n    69\t(def runners\n    70\t  (into {}\n    71\t        (map (fn [[k run]] [k (fn [ast] (vm/value (run ast)))]))\n    72\t        vm-runners))\n    73\t\n    74\t\n    75\t(defn run-with-prelude\n    76\t  \"The value of `form` (prelude notation) after `prelude-ast`, on each VM.\"\n    77\t  [prelude-ast form]\n    78\t  (let [ast (u/mark-tails (u/then prelude-ast (u/sexp->uast form)))\n    79\t        attempt (fn [run]\n    80\t                  (try (run ast)\n   760\t               (js/vconj\n   761\t                 (js/vconj (js/vconj [] (js/callable? foreign))\n   762\t                           (= foreign (js/call foreign :js/undefined [])))\n   763\t                 (js/callable? disabled))))]\n   764\t    (testing (str k)\n   765\t      (is (= [true true false] (if (vector? result) result [:thrown result]))))))\n   766\t\n   767\t\n   768\t(deftest ^:slow shared-call-thrown-value-on-every-vm-test\n   769\t  (doseq [[backend result]\n   770\t          (run-with-prelude\n   771\t            prelude/uast\n   772\t            '(let [payload (js/make-object :js/null)\n   773\t                   f (cell/new\n   774\t                       (assoc {} :yang.call/entry\n   775\t                              (fn [invocation]\n   776\t                                