/read-string (slurp \"test/yang/latte_oracle/slice9_evidence.edn\"))]\ntest/yang/latte_oracle_test.clj:3574:               (set (map :id (filter #(= :recorded-deviation (:status %)) (:fixtures written)))))\ntest/yang/latte_oracle_test.clj:3579:                    (:fixtures written))\ntest/yang/latte_oracle_test.clj:3580:            \"every fixture row keeps its raw A/B/C comparisons\")\ntest/yang/latte_oracle_test.clj:3586:          (is (= (count (:fixtures written)) (count (:fixtures tables)))\ntest/yang/latte_oracle_test.clj:3587:              \"every fixture row carries its derived site table and canonical-source-hash\")))\ntest/yang/latte_oracle_test.clj:3588:      (finally\ntest/yang/latte_oracle_test.clj:3595:;; cc3: oracle integer sites bound to post-expansion C1 occurrence keys\ntest/yang/latte_oracle_test.clj:3747:(defn- cc3-oracle-binding\ntest/yang/latte_oracle_test.clj:3748:  \"Bind each stamped oracle site id to its post-expansion C1 key\ntest/yang/latte_oracle_test.clj:3758:   `kernel-compile` recorded WHEN ADMITTING the fixture and retained\ntest/yang/latte_oracle_test.clj:3762:   [:oracle/fixture <id>] is never minted.\"\ntest/yang/latte_oracle_test.clj:3864:(deftest test-cc3-oracle-site-c1-binding\ntest/yang/latte_oracle_test.clj:3872:        fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\ntest/yang/latte_oracle_test.clj:3873:        compiled (kernel-compile-in-run run fixture)]\ntest/yang/latte_oracle_test.clj:3879:          (cc3-oracle-binding compiled)\ntest/yang/latte_oracle_test.clj:3889:        (is (false? (vm/occurrence-origin? [:oracle/fixture :cc3-binding]))\ntest/yang/latte_oracle_test.clj:3890:            \"a fixture id alone is not a persisted origin\")\ntest/yang/latte_oracle_test.clj:3892:               (try (cc3-oracle-binding (dissoc compiled :admission-origin))\ntest/yang/latte_oracle_test.clj:3897:        (is (= binding (:binding (cc3-oracle-binding compiled)))))\ntest/yang/latte_oracle_test.clj:3902:            \"uncredited helpers and generated applications are C1 occurrences but NOT oracle sites\"))\ntest/yang/latte_oracle_test.clj:3924:              \"one stamping wrapper per oracle site\")\ntest/yang/latte_oracle_test.clj:3986:          (is (seq define-paths) \"the fixture carries Rule-R definitions\")\ntest/yang/latte_oracle_test.clj:4110:      (let [fixture {:id :cc3-binding\ntest/yang/latte_oracle_test.clj:4113:                       (fresh-admission-run :cc3-duplicate-run) fixture)\ntest/yang/latte_oracle_test.clj:4128:               (try (cc3-oracle-binding (assoc compiled :ast duplicated))\ntest/yang/latte_oracle_test.clj:4145:  (let [fixture {:id :cc3-binding\ntest/yang/latte_oracle_test.clj:4147:        a (kernel-compile fixture \"run-a\" 0)\ntest/yang/latte_oracle_test.clj:4148:        b (kernel-compile fixture \"run-b\" 0)\ntest/yang/latte_oracle_test.clj:4149:        a1 (kernel-compile fixture \"run-a\" 1)]\ntest/yang/latte_oracle_test.clj:4169:    (let [ba (cc3-oracle-binding a)\ntest/yang/latte_oracle_test.clj:4170:          bb (cc3-oracle-binding b)\ntest/yang/latte_oracle_test.clj:4171:          ba1 (cc3-oracle-binding a1)]\ntest/yang/latte_oracle_test.clj:4176:      (is (= (:binding ba) (:binding (cc3-oracle-binding a)))\ntest/yang/latte_oracle_test.clj:4189:  ;; every fixture row goes through) assigns DISTINCT ordinals within\ntest/yang/latte_oracle_test.clj:4194:  (let [fixture {:id :cc3-binding\ntest/yang/latte_oracle_test.clj:4197:        row-0 (kernel-row-in-run run fixture)\ntest/yang/latte_oracle_test.clj:4198:        row-1 (kernel-row-in-run run fixture)\ntest/yang/latte_oracle_test.clj:4200:                    (fresh-admission-run :caller-evidence-run) fixture)\ntest/yang/latte_oracle_test.clj:4201:        replay-row (kernel-row fixture (:scope run) 0)]\ntest/yang/latte_oracle_test.clj:4205:        \"the first fixture in the run takes ordinal 0 under the run scope\")\ntest/yang/latte_oracle_test.clj:4207:        \"the second fixture in the same run takes a distinct ordinal\")\n","exit_code":0,"status":"completed"}}
