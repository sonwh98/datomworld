++ b/test/yang/call/exception_source_test.clj\n@@ -35,7 +35,27 @@\n \n \n (deftest clojure-restricted-catch-surface-preserved-test\n-  (is (thrown? clojure.lang.ExceptionInfo\n-        (lower :clojure \"(try 1 (finally 2))\" [])))\n+  ;; Still refused: the admitted catch surface is one Exception/ExceptionInfo\n+  ;; catch. Retiring the `finally` refusal does not widen the catch classes.\n   (is (thrown? clojure.lang.ExceptionInfo\n         (lower :clojure \"(try 1 (catch Throwable e 2))\" []))))\n+\n+\n+(deftest clojure-finally-admitted-test\n+  ;; Owner ruling 1794556000000 retired the refusal: a dialect's surface\n+  ;; derives from its source language. This ns is a generator check, so it\n+  ;; pins compilation; the finally clause's runtime effect is the pair\n+  ;; matrix's `:finally-replacement` leg, pinned below.\n+  (is (map? (lower :clojure \"(try 1 (finally 2))\" []))))\n+\n+\n+(deftest ^:slow clojure-finally-replacement-leg-test\n+  ;; Live for the first time now that the pair-matrix exclusion is gone.\n+  ;; `python->clojure` is the only new clojure-caller direction with an\n+  ;; executing pair deftest and a proven donor, so it is the one leg pinned\n+  ;; here: pair deftests are pair-scale and `-v` cannot address a single leg.\n+  (let [leg (first (filter #(= [:python :clojure :finally-replacement] (:id %))\n+                           contract/pair-matrix))]\n+    (is (some? leg))\n+    (doseq [[backend actual] (legs/run-leg leg)]\n+      (is (= (legs/expected leg) actual) (str backend)))))\n(ns yang.python.antlr.exception-call-test\n  \"Round 0: six directed Python-containing pairs, compliant assertions.\n   JS/PHP/Clojure-only pairs remain explicitly pending in the shared matrix.\n   A red result is a runtime divergence, never the expected test value.\"\n  (:require [clojure.test :refer [deftest is testing do-report]]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]))\n\n\n(defn- check-pair\n  [donor caller]\n  (let [observations (legs/run-pair donor caller)]\n    (doseq [{:keys [id scenario] :as leg}\n            (filter #(and (= donor (:donor %)) (= caller (:caller %)))\n                    contract/pair-matrix)]\n      (testing (str id)\n        (try\n          (let [expected (legs/expected leg)\n                results (get observations id)]\n            (println \"EXCEPTION-PAIR\"\n                     (pr-str {:id id :gates (:gates leg) :frontends (:frontends leg)\n                              :expected expected\n                              :results (update-vals results #(if (instance? Throwable %)\n                                                               {:host/error (.getMessage ^Throwable %)\n                                                                :host/data (ex-data %)} %))\n                              :status (update-vals results #(cond (instance? Throwable %) :error\n                                                                  (= expected %) :green :else :red))}))\n            (doseq [[backend actual] results]\n              (if (instance? Throwable actual)\n                (do-report {:type :error :message (str id \" \" backend \" operational failure\")\n                            :expected expected :actual actual})\n                (is (= expected actual) (str donor \" -> \" caller \" \" scenario \" \" backend)))))\n          (catch Exception e\n            (do-report {:type :error :message (str id \" source leg failed to execute\")\n                        :expected (legs/expected leg) :actual e})))))))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :typescript}}\n  python-to-typescript-test (check-pair :python :typescript))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :typescript}}\n  typescript-to-python-test (check-pair :typescript :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :php}}\n  python-to-php-test (check-pair :python :php))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :php}}\n  php-to-python-test (check-pair :php :python))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :clojure}}\n  python-to-clojure-test (check-pair :python :clojure))\n\n\n(deftest ^{:slow true :gates #{::contract/r1 ::contract/r2} :frontends #{:python :clojure}}\n  clojure-to-python-test (check-pair :clojure :python))\ncat: test/yang/php/antlr/exception_call_test.clj: No such file or directory\n","exit_code":1,"status":"failed"}}
