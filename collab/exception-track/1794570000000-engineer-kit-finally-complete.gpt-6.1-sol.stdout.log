{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/call/exception_source_test.clj && cat test/yang/call/php_exception_test.clj && cat test/yang/call/python_exception_test.clj && cat test/yang/call/exception_legs.clj'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/call/exception_source_test.clj && cat test/yang/call/php_exception_test.clj && cat test/yang/call/python_exception_test.clj && cat test/yang/call/exception_legs.clj'","aggregated_output":"(ns yang.call.exception-source-test\n  \"Generator checks: refusals here are fixture defects, never runtime reds.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]))\n\n\n(defn- lower\n  [frontend source exports]\n  (let [{:keys [parse unit]} (get kit/frontends frontend)]\n    (unit (parse source) exports)))\n\n\n(deftest provenance-source-compilation-test\n  (doseq [[frontend source] contract/sources]\n    (testing (name frontend)\n      (is (map? (lower frontend source [])))))\n  (is (map? (lower :python contract/boundary-source []))))\n\n\n(deftest all-directed-pair-sources-compile-test\n  (doseq [frontend (sort contract/frontends)]\n    (testing (str \"donor \" frontend)\n      (is (map? (lower frontend (legs/donor-source frontend) [])))))\n  (doseq [{:keys [id donor caller scenario]} contract/pair-matrix]\n    (testing (str id)\n      (is (map? (lower caller (legs/caller-source caller scenario)\n                       (legs/donor-exports donor))))))\n  (doseq [[[donor caller :as direction] pair-legs]\n          (group-by (juxt :donor :caller) contract/pair-matrix)]\n    (testing (str \"batch \" direction)\n      (is (map? (lower caller (legs/batch-caller-source caller pair-legs)\n                       (legs/donor-exports donor)))))))\n\n\n(deftest clojure-restricted-catch-surface-preserved-test\n  ;; Still refused: the admitted catch surface is one Exception/ExceptionInfo\n  ;; catch. Retiring the `finally` refusal does not widen the catch classes.\n  (is (thrown? clojure.lang.ExceptionInfo\n        (lower :clojure \"(try 1 (catch Throwable e 2))\" []))))\n\n\n(deftest clojure-finally-admitted-test\n  ;; Owner ruling 1794556000000 retired the refusal: a dialect's surface\n  ;; derives from its source language. This ns is a generator check, so it\n  ;; pins compilation; the finally clause's runtime effect is the pair\n  ;; matrix's `:finally-replacement` leg, pinned below.\n  (is (map? (lower :clojure \"(try 1 (finally 2))\" []))))\n\n\n(deftest ^:slow clojure-finally-replacement-leg-test\n  ;; Live for the first time now that the pair-matrix exclusion is gone.\n  ;; `python->clojure` is the only new clojure-caller direction with an\n  ;; executing pair deftest and a proven donor, so it is the one leg pinned\n  ;; here: pair deftests are pair-scale and `-v` cannot address a single leg.\n  (let [leg (first (filter #(= [:python :clojure :finally-replacement] (:id %))\n                           contract/pair-matrix))]\n    (is (some? leg))\n    (doseq [[backend actual] (legs/run-leg leg)]\n      (is (= (legs/expected leg) actual) (str backend)))))\n(ns yang.call.php-exception-test\n  \"PHP boundary pins for ruling v2 R1+R2+R3 (one coherent round). Receivers\n   and rethrows are parsed source; malformed protocol delivery uses the\n   shared boundary kit. The focused local gate for the exception-php-r1r2r3\n   round: the php subset of the shiva acceptance instrument, never a\n   substitute for the full ledger.\"\n  (:require [clojure.string :as str]\n            [clojure.test :refer [deftest is testing]]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]\n            [yang.call.exception-probes :as probes]\n            [yang.php.antlr.prelude :as php-prelude]))\n\n\n(defn- check-fixture\n  \"Run one php fixture isolated on all three vector VMs and assert its\n   compliant `:expected` value on each backend.\"\n  [id]\n  (let [fixture (first (filter #(= id (:id %)) contract/fixtures))]\n    (testing (str id)\n      (doseq [[backend actual] (probes/run-fixture fixture)]\n        (is (= (:expected fixture) actual) (str backend))))))\n\n\n(defn- check-leg\n  \"Run one directed source pair/scenario and assert `legs/expected` per VM.\"\n  [id]\n  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\n    (testing (str id)\n      (doseq [[backend actual] (legs/run-leg leg)]\n        (is (= (legs/expected leg) actual) (str id \" \" backend))))))\n\n\n(deftest ^:slow php-fresh-egress-test\n  ;; R1: the function entry and the Closure entry read the supplied\n  ;; :yang.call/raise and deliver every escaping exception (and binding\n  ;; failure) exactly once as the thrown condition; nothing runs after.\n  (check-fixture :php/fresh-named)\n  (check-fixture :php/fresh-closure)\n  (check-fixture :php/binding))\n\n\n(deftest ^:slow php-foreign-reception-test\n  ;; R2: an already-local Throwable is delivered unchanged (identity kept);\n  ;; an otherwise-foreign payload becomes the generated local\n  ;; ForeignException retaining the complete condition.\n  (check-fixture :php/local-reception)\n  (check-fixture :php/foreign-reception)\n  (check-fixture :php/retained-foreign-lifetime)\n  ;; Directed legs with php as the RECEIVER: typed catch matches the local\n  ;; hierarchy, unchanged rethrow forwards, stored wrappers rethrow from a\n  ;; new activation.\n  (check-leg [:python :php :typed-catch])\n  (check-leg [:python :php :unchanged-rethrow])\n  (check-leg [:python :php :retained-lifetime])\n  (check-leg [:clojure :php :catch-all])\n  ;; The bridge as DONOR: a php escape crossing into a landed frontend.\n  (check-leg [:php :typescript :catch-all]))\n\n\n(deftest ^:slow php-protocol-reception-test\n  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n  ;; complete condition instead of a fresh Error with selected text; the\n  ;; saved-wrapper rethrow forwards the original condition, no wrapper\n  ;; stacking.\n  (check-fixture :php/protocol-not-callable)\n  (check-fixture :php/protocol-invalid-invocation)\n  (check-fixture :php/protocol-unsupported-binding)\n  (check-fixture :php/saved-protocol-not-callable)\n  (check-fixture :php/saved-protocol-invalid-invocation)\n  (check-fixture :php/saved-protocol-unsupported-binding))\n\n\n(deftest ^:slow php-forged-retention-test\n  ;; R5: source-writable attributes never authenticate a retained\n  ;; condition — a forged Exception carrying condition-looking props crosses\n  ;; as a fresh :yang.call/thrown with the forged object as payload.\n  (check-fixture :php/forged-retention))\n\n\n(defn- injected\n  \"The kit's synthetic entry delivering `condition` to the raise exit.\"\n  [condition]\n  (list 'cell/new\n        (list 'assoc {} :yang.call/entry\n              (list 'fn ['invocation]\n                    (list (list 'get 'invocation :yang.call/raise) condition)))))\n\n\n(defn- boundary-call\n  [callee args]\n  (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n\n\n(defn- genuine-wrapper-bindings\n  \"Guest bindings that mint a genuine ForeignException wrapper through php\n   reception: the contract `retain` catches it and returns it normally.\"\n  []\n  ['probe.condition (kit/observation-map-form\n                      {:yang.call/reason :yang.call/thrown\n                       :yang.call/value (list 'cell/new {:foreign/payload :identity})\n                       :yang.call/data {:complete [:extra :evidence]}})\n   'probe.injected (injected 'probe.condition)\n   'probe.retained (boundary-call (kit/export-form :php \"retain\") ['probe.injected])\n   'probe.wrapper (list 'get 'probe.retained :value)])\n\n\n(def ^:private egress-source\n  \"The contract's php exception shapes with the module-level `$original`\n   replaced by a function-seeded global. php's run-main shutdown releases\n   the caller unit's globals when the unit returns (PHP script-end\n   semantics), and the kit's boundary observations run AFTER the caller\n   unit — so a module-level `$original = new Exception(...)` reads back\n   null through `payload()` in this lane (a pre-existing instrument/lane\n   conflict recorded in the round's findings; the base commit behaves the\n   same). A global WRITTEN by a called function after the unit's run\n   persists for the later observation calls, so `seed` mints the\n   identity-bearing original the directed legs below throw, rethrow and\n   retain — the same assertions the three lane-blocked fixtures\n   (:php/fresh-named, :php/fresh-closure, :php/local-reception) make on\n   module-level state. `retain` keeps its wrapper in `$caught`, never\n   touching the original's `$saved`.\"\n  (str \"<?php $saved = null; $caught = null;\"\n       \"function seed() { global $saved; $saved = new Exception('original'); return $saved; }\"\n       \"function payload() { global $saved; return $saved; }\"\n       \"function donor_raise() { global $saved; throw $saved; }\"\n       \"function make_exploder() { return function() { global $saved; throw $saved; }; }\"\n       \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\"\n       \"function retain($f) { global $caught; try { return $f(); }\"\n       \" catch (Throwable $e) { $caught = $e; return $e; } }\"))\n\n\n(defn- run-egress-observation\n  \"The egress source as caller, the python boundary donor beside it, and\n   `observation` appended: all three linked vector VMs.\"\n  [observation]\n  (let [donor (kit/publish-donor! :python contract/boundary-source)]\n    (kit/run-exception-program\n      donor (kit/compose-exception donor [\"boundary_target\"] :php\n                                   egress-source observation))))\n\n\n(deftest ^:slow php-fresh-egress-directed-test\n  ;; R1, directed (the in-lane form of :php/fresh-named and\n  ;; :php/fresh-closure): the function entry and the Closure entry deliver\n  ;; the escaping source Exception to the supplied raise exit exactly once\n  ;; as {:yang.call/thrown, original} — the payload IS the thrown object.\n  (let [observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let ['probe.seeded (boundary-call (kit/export-form :php \"seed\") [])\n                      'original (list 'get 'probe.seeded :value)\n                      'probe.named (boundary-call (kit/export-form :php \"donor_raise\") [])\n                      'probe.closure (boundary-call\n                                       (list 'get (boundary-call\n                                                    (kit/export-form :php \"make_exploder\") [])\n                                             :value) [])]\n                (kit/observation-map-form\n                  {:seeded (list '= :return (list 'get 'probe.seeded :route))\n                   :named-transferred (list '= :raise (list 'get 'probe.named :route))\n                   :named-once (list '= 1 (list 'get 'probe.named :transfers))\n                   :named-after (list 'get 'probe.named :after)\n                   :named-reason (list 'get (list 'get 'probe.named :condition)\n                                       :yang.call/reason)\n                   :named-payload-identical\n                   (list '= 'original (list 'get (list 'get 'probe.named :condition)\n                                            :yang.call/value))\n                   :closure-transferred (list '= :raise (list 'get 'probe.closure :route))\n                   :closure-once (list '= 1 (list 'get 'probe.closure :transfers))\n                   :closure-after (list 'get 'probe.closure :after)\n                   :closure-reason (list 'get (list 'get 'probe.closure :condition)\n                                         :yang.call/reason)\n                   :closure-payload-identical\n                   (list '= 'original (list 'get (list 'get 'probe.closure :condition)\n                                            :yang.call/value))})))\n        expected {:seeded true\n                  :named-transferred true :named-once true :named-after false\n                  :named-reason :yang.call/thrown :named-payload-identical true\n                  :closure-transferred true :closure-once true :closure-after false\n                  :closure-reason :yang.call/thrown :closure-payload-identical true}]\n    (doseq [[backend actual] (run-egress-observation observation)]\n      (is (= expected actual) (str backend)))))\n\n\n(deftest ^:slow php-local-reception-directed-test\n  ;; R2, directed (the in-lane form of :php/local-reception): a thrown\n  ;; condition whose payload is already a php Throwable keeps its ordinary\n  ;; catching and identity — re-raised UNCHANGED (typed catch, unchanged\n  ;; rethrow, returned identity), never wrapped.\n  (let [observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let ['probe.seeded (boundary-call (kit/export-form :php \"seed\") [])\n                      'original (list 'get 'probe.seeded :value)\n                      'probe.condition (kit/observation-map-form\n                                         {:yang.call/reason :yang.call/thrown\n                                          :yang.call/value 'original})\n                      'probe.injected (injected 'probe.condition)\n                      'probe.reres (boundary-call (kit/export-form :php \"receive\")\n                                                  ['probe.injected])\n                      'probe.rtres (boundary-call (kit/export-form :php \"retain\")\n                                                  ['probe.injected])]\n                (kit/observation-map-form\n                  {:seeded (list '= :return (list 'get 'probe.seeded :route))\n                   :rethrow-transferred (list '= :raise (list 'get 'probe.reres :route))\n                   :rethrow-once (list '= 1 (list 'get 'probe.reres :transfers))\n                   :rethrow-reason (list 'get (list 'get 'probe.reres :condition)\n                                         :yang.call/reason)\n                   :rethrow-payload-identical\n                   (list '= 'original (list 'get (list 'get 'probe.reres :condition)\n                                            :yang.call/value))\n                   :retain-returned (list '= :return (list 'get 'probe.rtres :route))\n                   :retain-payload-identical\n                   (list '= 'original (list 'get 'probe.rtres :value))})))\n        expected {:seeded true\n                  :rethrow-transferred true :rethrow-once true\n                  :rethrow-reason :yang.call/thrown\n                  :rethrow-payload-identical true\n                  :retain-returned true :retain-payload-identical true}]\n    (doseq [[backend actual] (run-egress-observation observation)]\n      (is (= expected actual) (str backend)))))\n\n\n(defn- run-provenance-observation\n  \"The contract php source as caller, the python boundary donor beside it,\n   and `observation` appended: all three linked vector VMs.\"\n  [observation]\n  (let [donor (kit/publish-donor! :python contract/boundary-source)]\n    (kit/run-exception-program\n      donor (kit/compose-exception donor [\"boundary_target\"] :php\n                                   (contract/sources :php) observation))))\n\n\n(deftest ^:slow php-copied-wrapper-forgery-test\n  ;; A fresh state cell carrying a genuine wrapper's complete contents is a\n  ;; DIFFERENT object: provenance is bound to the wrapper's identity (its\n  ;; sealed state-cell reference), never to its copyable contents. Throwing\n  ;; the copy from a new activation must NOT forward the original condition.\n  (let [observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let (into (genuine-wrapper-bindings)\n                           ['probe.copy (list 'assoc {} :php/obj\n                                              (list 'cell/new\n                                                    (list 'cell/get\n                                                          (list 'get 'probe.wrapper :php/obj))))\n                            'probe.result (boundary-call (kit/export-form :php \"raise_value\")\n                                                         ['probe.copy])])\n                (kit/observation-map-form\n                  {:retained (list '= :return (list 'get 'probe.retained :route))\n                   :copy-refused\n                   (list 'if (list '= :raise (list 'get 'probe.result :route))\n                         (list 'if (list '= 1 (list 'get 'probe.result :transfers))\n                               (list 'if (list '= :yang.call/thrown\n                                               (list 'get (list 'get 'probe.result :condition)\n                                                     :yang.call/reason))\n                                     (list '= 'probe.copy\n                                           (list 'get (list 'get 'probe.result :condition)\n                                                 :yang.call/value))\n                                     false)\n                               false)\n                         false)})))]\n    (doseq [[backend actual] (run-provenance-observation observation)]\n      (is (= {:retained true :copy-refused true} actual) (str backend)))))\n\n\n(deftest ^:slow php-mutated-wrapper-forwarding-test\n  ;; Mutating the genuine wrapper's own state (its copied-visible contents)\n  ;; neither breaks nor replaces the association: rethrowing the SAME\n  ;; wrapper still forwards the ORIGINAL condition (sol's round-2 attack,\n  ;; adapted to the php handle layout).\n  (let [observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let (into (genuine-wrapper-bindings)\n                           ['probe.attack\n                            (list 'do (list 'cell/set!\n                                            (list 'get 'probe.wrapper :php/obj)\n                                            (list 'assoc\n                                                  (list 'cell/get\n                                                        (list 'get 'probe.wrapper :php/obj))\n                                                  :ord 9999)))\n                            'probe.result (boundary-call (kit/export-form :php \"raise_value\")\n                                                         ['probe.wrapper])])\n                (kit/observation-map-form\n                  {:retained (list '= :return (list 'get 'probe.retained :route))\n                   :original-forwarded\n                   (list 'if (list '= :raise (list 'get 'probe.result :route))\n                         (list 'if (list '= 1 (list 'get 'probe.result :transfers))\n                               (list '= 'probe.condition (list 'get 'probe.result :condition))\n                               false)\n                         false)})))]\n    (doseq [[backend actual] (run-provenance-observation observation)]\n      (is (= {:retained true :original-forwarded true} actual) (str backend)))))\n\n\n(deftest ^:slow php-kit-parity-test\n  ;; The hard-rule pin: exercise :reason classification AND\n  ;; :condition-identical payload identity at the ADMITTED guest-call\n  ;; boundary the way yang.call.exception-contract-test does — the refusal\n  ;; is produced by public validation (not-callable on an empty map),\n  ;; delivered by a callable cell's raise exit through parsed PHP `receive`\n  ;; and its bare `throw $e` rethrow.\n  (let [source (str \"<?php \"\n                    \"function receive($f) { try { return $f(); } catch (Throwable $e) { throw $e; } }\")\n        observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let ['condition (list 'get (boundary-call {} []) :condition)\n                      'injected (injected 'condition)\n                      'result (boundary-call (kit/export-form :php \"receive\") ['injected])]\n                (kit/observation-map-form\n                  {:reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n                   :condition-identical (list '= 'condition (list 'get 'result :condition))})))\n        donor (kit/publish-donor! :python contract/boundary-source)\n        results (kit/run-exception-program\n                  donor (kit/compose-exception donor [\"boundary_target\"]\n                                               :php source observation))]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PHP-KIT-PARITY\" backend actual)\n      (is (= {:reason :yang.call/not-callable :condition-identical true} actual)\n          (str backend)))))\n\n\n(deftest ^:slow php-kit-batch-parity-test\n  ;; Acceptance uses run-frontend, which shares a task across observations.\n  ;; Isolated run-fixture pins alone cannot establish that batch path.\n  (let [fixtures (filter #(= :php (:frontend %)) contract/fixtures)\n        observations (probes/run-frontend :php)]\n    (is (= (set (map :id fixtures)) (set (keys observations))))\n    (doseq [{:keys [id expected]} fixtures\n            :let [results (get observations id)]]\n      (is (= #{:semantic :stack :register} (set (keys results))) (str id))\n      (doseq [[backend actual] results]\n        (println \"PHP-KIT-BATCH\" id backend actual)\n        (is (= expected actual) (str id \" \" backend))))))\n\n\n(deftest php-retention-store-surface-test\n  ;; Host side (the php analog of the ts store-root pin's host half): the\n  ;; private retained-condition store is not a runtime key and none of the\n  ;; installed retention names is a module export, so admitted source cannot\n  ;; reach the store by enumerating either, and no frozen pre-init export\n  ;; binding can silently answer for it. The r7 steward addendum's F2\n  ;; mirror: the GENERAL surface half — no reserved-door (dsg__) name and\n  ;; no mint/retention name appears in EITHER surface, not just the\n  ;; individually named ones (the definition-graph half lives in\n  ;; php-mint-reachability-test).\n  (is (not-any? #(str/includes? (str %) \"retained\") php-prelude/runtime-keys)\n      \"no retained store/seal runtime key for admitted source to name\")\n  (is (not-any? #(str/includes? (str %) \"dsg__\") php-prelude/runtime-keys)\n      \"no reserved-door runtime key for admitted source to name\")\n  (is (not-any? #(str/includes? (str %) \"dsg__\") php-prelude/module-exports)\n      \"no reserved-door name is a module export\")\n  (is (not-any? #(re-find #\"mint|retained|raise-foreign|raise-protocol\"\n                          (str %))\n                php-prelude/module-exports)\n      \"no mint/retention name is a module export\")\n  (is (not (contains? php-prelude/module-exports 'retained-condition))\n      \"retained-condition is not a module export: no frozen pre-init binding\")\n  (is (not (contains? php-prelude/module-exports 'raise-protocol))\n      \"raise-protocol is not a module export: no frozen pre-init binding\")\n  (is (not (contains? php-prelude/module-exports 'raise-foreign))\n      \"raise-foreign is not a module export: no frozen pre-init binding\"))\n\n\n(deftest php-provenance-adoption-test\n  ;; The r3 adoption pins (host side, the php twin of the py adoption audit\n  ;; the step-7 review asked for): wrapper retention goes through the VM\n  ;; provenance primitive's reserved doors — cell/dsg__new-provenance mints,\n  ;; cell/dsg__provenance reads — declared as host dependencies of the php\n  ;; module, never reimplemented in prelude code; and no minting or retention\n  ;; helper is a module export (the exported-helper bypass class the ruling\n  ;; names: a guest able to call the mint could forge provenance of its own\n  ;; choosing).\n  (is (contains? php-prelude/host-names 'cell/dsg__new-provenance)\n      \"the reserved mint door is a declared host dependency\")\n  (is (contains? php-prelude/host-names 'cell/dsg__provenance)\n      \"the reserved read door is a declared host dependency\")\n  (is (not (contains? php-prelude/module-exports 'mint-retained))\n      \"the mint helper is not a module export\")\n  ;; r4 (sol P1): the php.rt/-prefix assertion above cannot catch a\n  ;; dangerous helper under a stripped php/ name — module-exports holds\n  ;; STRIPPED names, so the condition-accepting receiver must be named\n  ;; explicitly too.\n  (is (not (contains? php-prelude/module-exports 'receive-condition))\n      \"the condition-accepting receiver is not a module export\")\n  (is (not-any? #(str/starts-with? (str %) \"php.rt/\") php-prelude/module-exports)\n      \"no php.rt name is a module export: no guest-reachable retention surface\"))\n\n\n(deftest php-mint-reachability-test\n  ;; r4 (sol P1): no module export — no php/-prefixed definition, the only\n  ;; ones core/exports takes — DIRECTLY reaches the provenance mint or the\n  ;; condition-accepting receiver. One hop is the discriminating depth: a\n  ;; direct mention is a guest-reachable name whose own parameter can flow\n  ;; to the mint as a condition (the php/receive-condition bypass), while\n  ;; deeper reachability runs through the call helpers' callback wiring,\n  ;; where every condition is bridge- or validation-built, never a guest\n  ;; argument. The three call helpers are whitelisted for exactly that\n  ;; wiring: they mention the receiver only as the raise exit they hand to\n  ;; yang.call/invoke. RED while php/receive-condition is exported (its\n  ;; body references php.rt/raise-foreign and php.rt/raise-protocol).\n  (let [defs (into {} @#'yang.php.antlr.prelude/core-definitions)\n        exports php-prelude/module-exports\n        minters '#{php.rt/mint-retained php.rt/raise-foreign\n                   php.rt/raise-protocol php.rt/receive-condition}\n        whitelist '#{php/call php/call-with-binding-profile php/call-named}\n        exported-keys (filter #(contains? exports (php-prelude/strip %)) (keys defs))\n        mentions (fn [form] (some minters (tree-seq coll? seq form)))\n        offenders (remove whitelist (filter (fn [k] (mentions (get defs k))) exported-keys))]\n    (is (pos? (count exported-keys)) \"the audit saw the export surface\")\n    (is (empty? offenders)\n        (str \"exported definitions reach the mint surface: \" (pr-str offenders)))))\n\n\n(defn- resolution-refusal?\n  \"True when `x` is exactly the expected outcome of calling the retired\n   receiver name: the engine's variable-resolution refusal naming\n   php/receive-condition — never an unrelated failure.\"\n  [x]\n  (and (instance? Throwable x)\n       (map? (ex-data x))\n       (= 'php/receive-condition (get (ex-data x) :symbol))))\n\n\n(deftest ^:slow php-exported-mint-forgery-test\n  ;; r4 (sol P1), the executed bypass: while the receiver is exported, a\n  ;; composed unit's boundary form can call it directly with a forged\n  ;; condition — the receiver mints a GENUINE provenance-carrying\n  ;; ForeignException whose retained condition is the attacker's map, and\n  ;; the unchanged rethrow forwards it as if it were a real retained\n  ;; condition. After the repair the receiver is php.rt/receive-condition\n  ;; (compiler-private, never exported), so the forged call cannot even\n  ;; link: no green run ever delivers the forged condition. The assertion\n  ;; (tightened per sol's r5 P3 follow-up) accepts ONLY the expected\n  ;; resolution refusal of the retired name, or an explicitly successful\n  ;; observation answering :forged-forwarded false — an unrelated host\n  ;; exception, nil or a malformed observation fails the pin.\n  (let [observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let ['probe.forged (kit/observation-map-form\n                                      {:yang.call/reason :yang.call/not-callable\n                                       :yang.call/data {:forged true}})\n                      'probe.box (list 'cell/new nil)\n                      'probe.caught (list 'php/try\n                                          (list 'fn []\n                                                (list 'php/receive-condition 'probe.forged))\n                                          (list 'fn ['e]\n                                                (list 'do (list 'cell/set! 'probe.box 'e) nil))\n                                          (list 'fn [] nil))\n                      'probe.wrapper (list 'cell/get 'probe.box)\n                      'probe.result (boundary-call (kit/export-form :php \"raise_value\")\n                                                   ['probe.wrapper])]\n                (kit/observation-map-form\n                  {:caught-a-wrapper (list 'not (list 'nil? 'probe.wrapper))\n                   :forged-forwarded\n                   (list 'if (list '= :raise (list 'get 'probe.result :route))\n                         (list '= 'probe.forged (list 'get 'probe.result :condition))\n                         false)})))\n        results (run-provenance-observation observation)]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PHP-MINT-FORGERY\" backend (type actual))\n      (is (or (resolution-refusal? actual)\n              (and (map? actual) (false? (:forged-forwarded actual))))\n          (str backend \": only the resolution refusal of the retired name, or an \"\n               \"explicit no-forgery observation, is acceptable (got \"\n               (pr-str actual) \")\")))))\n\n\n(deftest ^:slow php-handle-shaped-foreign-payload-test\n  ;; r4 (sol P2) + r5 (sol's re-check counterexamples): ordinary foreign\n  ;; data shaped like a php object is FOREIGN — reception retains the\n  ;; complete original condition (reason, evidence, payload identity) in\n  ;; the ForeignException instead of refusing at the unauthenticated cell\n  ;; read, the class lookup, or the ownership acquisition. The r5 shapes\n  ;; pin the representation mismatches (MIXED TAGS — instance-of selects\n  ;; by the non-nil :php/obj key; AUTHENTIC CELL WITH INVALID STATE —\n  ;; authenticity proves liveness, not object state); the r6 shapes pin\n  ;; the ownership consumer (addref's slot-kind selects :php/ref FIRST,\n  ;; so COMPETING MARKERS on an otherwise-valid map or real handle are\n  ;; consumed unchecked; and a string class alone is insufficient when\n  ;; :rc is absent — addref's count acquisition consumes it); the count\n  ;; shapes pin the domain admission itself — a count the ownership\n  ;; arithmetic cannot operate on (non-number, float content, a computed\n  ;; ratio) is invalid counted-object state and is retained whole rather\n  ;; than consumed. The native int ENDPOINTS are not here: sol's endpoint\n  ;; ruling (re-check 5) is that a count the repaired exact arithmetic\n  ;; itself produces — at the long maximum, past it, or at the minimum —\n  ;; is ordinary LOCAL state whose class and identity §8.10.7 rule 1\n  ;; preserves, so those shapes assert local identity in\n  ;; php-count-acquisition-test below. All eleven shapes run in ONE\n  ;; composed program (the batch-parity task-sharing shape), not one kit\n  ;; run per shape: the laptop lane's dao.jing stall reliably catches the\n  ;; 8th consecutive per-shape run in one JVM.\n  (let [shapes [[\"non-reference\" {:php/obj 42}]\n                [\"forged-ref\" {:php/obj {:type :cell-ref, :id 99999, :seal \"forged\"}}]\n                [\"forged-class\" {:php/type :obj, :class 42, :props {}}]\n                [\"mixed-tags\" {:php/type :obj, :class \"Exception\", :php/obj 42}]\n                [\"authentic-cell-bad-class\"\n                 ;; :rc 1 keeps the class check independently discriminating\n                 ;; (the re-check3 coverage note): without a valid count the\n                 ;; count rejection could mask a class-validation regression\n                 (kit/observation-map-form {:php/obj (list 'cell/new {:class 42, :rc 1})})]\n                [\"map-mixed-ref\" {:php/type :obj, :class \"Exception\", :php/ref 42}]\n                [\"real-handle-competing-ref\"\n                 (list 'assoc (list 'php/make-error \"Exception\" \"real\") :php/ref 42)]\n                [\"string-class-no-rc\"\n                 (kit/observation-map-form {:php/obj (list 'cell/new {:class \"Exception\"})})]\n                ;; non-number counts stay rejected (the r6 rule; pinned so\n                ;; the incrementability refinement cannot silently drop it)\n                [\"non-number-count\"\n                 (kit/observation-map-form\n                   {:php/obj (list 'cell/new (list 'assoc {:class \"Exception\"}\n                                                   :rc \"bad\"))})]\n                ;; FLOAT64 CONTENT is not an exact-integer carrier on any\n                ;; host (a JVM/Dart double, the JS Float64 carrier), so it\n                ;; is not a count. This is sol's own re-check5 control.\n                ;; His other one, (data/float-value 1), is deliberately NOT\n                ;; pinned: on JS it yields a bare integral Number, which\n                ;; exact-integer? admits, so its disposition is genuinely\n                ;; host-divergent and a JVM-only pin would freeze the\n                ;; wrong half of it.\n                [\"float-count\"\n                 (kit/observation-map-form\n                   {:php/obj (list 'cell/new (list 'assoc {:class \"Exception\"}\n                                                   :rc (list 'data/float64 1)))})]\n                ;; r10 residual 2: a computed RATIO count — data/number? and\n                ;; php/int? both pass it (kind's float64 content test), but\n                ;; it is not an exact-integer carrier and the integer\n                ;; primitives refuse it; the count test must use the EXACT\n                ;; domain predicate (integer/integer?), not a php\n                ;; representation classifier.\n                [\"ratio-count\"\n                 (kit/observation-map-form\n                   {:php/obj (list 'cell/new (list 'assoc {:class \"Exception\"}\n                                                   :rc (list '/ 1 2)))})]]\n        leg (fn [label payload]\n              (let [n (fn [k] (symbol (str \"probe.\" (name label) \".\" (name k))))\n                    p (n :payload) c (n :condition) i (n :injected)\n                    r (n :retained) w (n :wrapper) loc (n :local) l (n :later)]\n                {:bindings [p payload\n                            c (kit/observation-map-form\n                                {:yang.call/reason :yang.call/thrown\n                                 :yang.call/value p\n                                 :yang.call/data {:complete [:evidence]}})\n                            i (injected c)\n                            r (boundary-call (kit/export-form :php \"retain\") [i])\n                            w (list 'get r :value)\n                            loc (list 'if (list '= :return (list 'get r :route))\n                                      (boundary-call (kit/export-form :php \"is_foreign\") [w])\n                                      {:value false})\n                            ;; immediately after this shape's retain: later\n                            ;; reads the $saved this retain stored, before\n                            ;; the next shape's retain overwrites it\n                            l (boundary-call (kit/export-form :php \"later\") [])]\n                 :entries {(keyword (str label \"-retained\"))\n                           (list '= :return (list 'get r :route))\n                           (keyword (str label \"-local\"))\n                           (list '= true (list 'get loc :value))\n                           (keyword (str label \"-condition\"))\n                           (list '= c (list 'get l :condition))\n                           (keyword (str label \"-payload\"))\n                           (list '= p (list 'get (list 'get l :condition)\n                                            :yang.call/value))}}))\n        legs (map (partial apply leg) shapes)\n        observation (kit/guard-exceptions-form\n                      [:php]\n                      (list 'let (into [] (mapcat :bindings) legs)\n                            (kit/observation-map-form (into {} (mapcat :entries) legs))))\n        expected (into {} (mapcat (fn [[label _]]\n                                    (map (fn [k] [(keyword (str label \"-\" k)) true])\n                                         [\"retained\" \"local\" \"condition\" \"payload\"])))\n                       shapes)\n        results (run-provenance-observation observation)]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PHP-HANDLE-SHAPED\" backend actual)\n      (is (= expected actual)\n          (str backend \": every handle-shaped foreign payload retains the \"\n               \"complete condition\")))))\n\n\n(def ^:private count-source\n  \"The r11 count-domain receiver: an ORDINARY php catch/return — no numeric\n   operation anywhere in the source — whose `return $e` runs the lowerer's\n   routine php/addref acquisition on the caught value, so a count that\n   survives reception must survive the next acquisition too.\n   `is_local_exception` reads the caught value's own class through the\n   contract's proven `get_class` idiom, which is what distinguishes an\n   unchanged local Exception from the ForeignException a wrapping reception\n   delivers. Every count below is admitted LOCAL state under sol's endpoint\n   ruling: MAX-1, which reception's acquisition moves ONTO the native long\n   maximum and the return then moves past it, into the host big carrier,\n   where the raw host + threw; MAX and MIN themselves, which the repaired\n   exact arithmetic produces and consumes like any other count; and 2^53,\n   the JS safe-Number boundary — a plain Long on the JVM, which is what this\n   lane verifies, and a BigInt carrier on JS, where the same decimal parses\n   past the safe range and a raw (+ rc 1) mixes a BigInt with a Number and\n   throws a TypeError (the re-check's Node primitive diagnostic, both signs;\n   the tri-host acceptance lane covers Node). The fifth count, T-1 =\n   2^99999 - 1, is sol's re-check6 counterexample: a legal guest count one\n   ordinary acquisition below the endpoint r11's doubling probe had itself\n   created, which must therefore stay local across BOTH receptions.\"\n  (str \"<?php function catch_return($f) {\"\n       \" try { return $f(); } catch (Throwable $e) { return $e; } }\"\n       \" function is_local_exception($e) { return get_class($e) === 'Exception'; }\"))\n\n\n(deftest ^:slow php-count-acquisition-test\n  ;; r11, sol's re-check5 residual: reception must preserve local type and\n  ;; identity across ordinary acquisitions AND across a LATER reception.\n  ;; Each shape calls the same receiver TWICE on the same callable and the\n  ;; same condition, keeping the first result live in a guest binding while\n  ;; the second call runs — no count edits, no numeric operations and no\n  ;; malformed-condition tricks in between. At the previous tip the\n  ;; near-max row failed exactly here: the first call returned the original\n  ;; Exception, its acquisitions left the count AT the native maximum, and\n  ;; the second reception excluded that endpoint and came back a\n  ;; ForeignException. An ordinary catch retaining one more reference\n  ;; cannot make an unchanged local exception foreign (§8.10.7 rule 1,\n  ;; owner ruling v2 R2), so BOTH results are asserted identical to the\n  ;; original payload and of the original Exception class. The endpoint\n  ;; cases live here rather than in the foreign set above because this\n  ;; ruling makes them local; their foreign-disposition payload forms are\n  ;; unchanged, only the asserted disposition moved.\n  ;; r12 adds the fifth shape, sol's re-check6 counterexample: the\n  ;; doubling probe r11 layered on top of the increment probe was itself an\n  ;; admission endpoint, one ordinary acquisition away from a legally\n  ;; constructed count. Five shapes x six observations = 30 expected keys\n  ;; per backend.\n  (let [shapes [[\"near-max\" (list 'integer/parse \"9223372036854775806\")]\n                [\"max\" (list 'integer/parse \"9223372036854775807\")]\n                [\"min\" (list 'integer/parse \"-9223372036854775808\")]\n                [\"js-number-boundary\" (list 'integer/parse \"9007199254740992\")]\n                ;; r12, sol's re-check6 counterexample: T-1, one below\n                ;; T = 2^(max-bits - 1) = 2^99999 in these lanes, built\n                ;; entirely from admitted integer-module operations, so it\n                ;; is a legal guest count and no raw host arithmetic is\n                ;; involved. r11's doubling probe admitted it, ONE ordinary\n                ;; acquisition moved it to T, and the next reception's\n                ;; doubling (T+T = 2^max-bits) answered ::bit-limit — so a\n                ;; purely local Throwable the runtime itself had just\n                ;; produced came back as a ForeignException, the identity\n                ;; failure re-check5 condemned, recreated by the\n                ;; classifier's own extra computation. Red at the previous\n                ;; tip on the two second-* keys; green with the doubling\n                ;; removed, because addref's rc+1 and delref's rc-1 both\n                ;; still yield integers at T.\n                [\"t-minus-one\"\n                 (list 'integer/sub (list 'integer/shift-left 1 99999) 1)]]\n        leg (fn [[label count-form]]\n              (let [n (fn [k] (symbol (str \"probe.\" (name label) \".\" (name k))))\n                    p (n :payload) c (n :condition) i (n :injected)\n                    r1 (n :first) v1 (n :first-value) g1 (n :first-class)\n                    r2 (n :second) v2 (n :second-value) g2 (n :second-class)]\n                {:bindings [p (kit/observation-map-form\n                                {:php/obj (list 'cell/new\n                                                (list 'assoc {:class \"Exception\"}\n                                                      :rc count-form))})\n                            c (kit/observation-map-form\n                                {:yang.call/reason :yang.call/thrown\n                                 :yang.call/value p})\n                            i (injected c)\n                            ;; the first reception; v1 stays bound, so the\n                            ;; first result is still live across the second\n                            r1 (boundary-call (kit/export-form :php \"catch_return\") [i])\n                            v1 (list 'get r1 :value)\n                            g1 (boundary-call (kit/export-form :php \"is_local_exception\") [v1])\n                            ;; the second reception of the SAME condition\n                            r2 (boundary-call (kit/export-form :php \"catch_return\") [i])\n                            v2 (list 'get r2 :value)\n                            g2 (boundary-call (kit/export-form :php \"is_local_exception\") [v2])]\n                 :entries {(keyword (str label \"-first-returned\"))\n                           (list '= :return (list 'get r1 :route))\n                           (keyword (str label \"-first-class\"))\n                           (list '= true (list 'get g1 :value))\n                           (keyword (str label \"-first-identical\"))\n                           (list '= p v1)\n                           (keyword (str label \"-second-returned\"))\n                           (list '= :return (list 'get r2 :route))\n                           (keyword (str label \"-second-class\"))\n                           (list '= true (list 'get g2 :value))\n                           (keyword (str label \"-second-identical\"))\n                           (list '= p v2)}}))\n        legs (map leg shapes)\n        observation (kit/guard-exceptions-form\n                      [:php]\n                      (list 'let (into [] (mapcat :bindings) legs)\n                            (kit/observation-map-form (into {} (mapcat :entries) legs))))\n        expected (into {} (mapcat (fn [[label _]]\n                                    (map (fn [k] [(keyword (str label \"-\" k)) true])\n                                         [\"first-returned\" \"first-class\" \"first-identical\"\n                                          \"second-returned\" \"second-class\" \"second-identical\"]))\n                                  shapes))\n        donor (kit/publish-donor! :python contract/boundary-source)\n        results (kit/run-exception-program\n                  donor (kit/compose-exception donor [\"boundary_target\"] :php\n                                               count-source observation))]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PHP-COUNT-ACQUISITION\" backend actual)\n      (is (= expected actual)\n          (str backend \": every boundary count keeps its Exception class and \"\n               \"its identity through two receptions, the first result live\")))))\n\n\n(deftest ^:slow php-count-limit-test\n  ;; r11: the limit-aware half of the admission predicate, and the reason\n  ;; removing the signed-64-bit bounds is not a bare revert. The integer\n  ;; module bounds every result IT produces by ::integer/max-bits, but the\n  ;; VM's raw host `+` (yin.vm/primitives registers clojure.core's) does\n  ;; not, so a guest can hold an exact integer the module will not operate\n  ;; on: 2^99999 + 2^99999 = 2^100000, one bit wider than the 100000-bit\n  ;; limit these lanes install (yang.typescript.antlr.linked-harness's\n  ;; integer-limits, the registry yang.call.conformance admits). For such a\n  ;; count integer/add answers the ::bit-limit KEYWORD instead of an\n  ;; integer; installing that as :rc would make the next ownership\n  ;; operation refuse with a host :wrong-type failure escaping the\n  ;; boundary. php/obj-val? therefore probes the arithmetic itself —\n  ;; addref's own rc+1 and delref's own rc-1, and nothing else — instead of\n  ;; bounding the carrier, so this count is FOREIGN and retained whole:\n  ;; genuinely unsupported state, told apart from the endpoint counts the\n  ;; repaired arithmetic produces all by itself. This is the half of the\n  ;; limit policy that must NOT be deleted along with r11's doubling probe;\n  ;; the other half — a count one acquisition below the doubling's own\n  ;; endpoint, T-1, which must stay LOCAL through two receptions — is the\n  ;; `t-minus-one` shape of php-count-acquisition-test above, where the\n  ;; two-reception harness already lives. Kept in its own deftest so its\n  ;; lane-specific width cannot contaminate the shape matrix; under a\n  ;; composition limit other than 100000 bits the shift would need\n  ;; re-deriving.\n  (let [n (fn [k] (symbol (str \"probe.over-limit.\" (name k))))\n        p (n :payload) c (n :condition) i (n :injected)\n        r (n :retained) w (n :wrapper) loc (n :local) l (n :later)\n        wide (list '+ (list 'integer/shift-left 1 99999) (list 'integer/shift-left 1 99999))\n        observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let [p (kit/observation-map-form\n                          {:php/obj (list 'cell/new\n                                          (list 'assoc {:class \"Exception\"} :rc wide))})\n                      c (kit/observation-map-form\n                          {:yang.call/reason :yang.call/thrown\n                           :yang.call/value p\n                           :yang.call/data {:complete [:evidence]}})\n                      i (injected c)\n                      r (boundary-call (kit/export-form :php \"retain\") [i])\n                      w (list 'get r :value)\n                      loc (list 'if (list '= :return (list 'get r :route))\n                                (boundary-call (kit/export-form :php \"is_foreign\") [w])\n                                {:value false})\n                      l (boundary-call (kit/export-form :php \"later\") [])]\n                (kit/observation-map-form\n                  {:retained (list '= :return (list 'get r :route))\n                   :local (list '= true (list 'get loc :value))\n                   :condition (list '= c (list 'get l :condition))\n                   :payload (list '= p (list 'get (list 'get l :condition)\n                                             :yang.call/value))})))\n        results (run-provenance-observation observation)]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PHP-COUNT-LIMIT\" backend actual)\n      (is (= {:retained true :local true :condition true :payload true} actual)\n          (str backend \": a count wider than the composition's integer limit \"\n               \"is foreign and retained whole (got \" (pr-str actual) \")\")))))\n\n\n(deftest ^:slow php-nil-condition-reception-test\n  ;; The steward addendum's F1 nil-guard choice, taken DELIBERATELY as\n  ;; option (a): a non-map or nil condition delivered to reception is NOT\n  ;; provenance-minted (nil provenance is refused by the reserved door —\n  ;; an operational failure that would escape the boundary behavior); it\n  ;; raises the documented plain local Error — no ForeignException, no\n  ;; wrapper, nothing retained. The kit never builds such a condition;\n  ;; this pins the boundary behavior for the instrument-level anomaly.\n  (let [observation\n        (kit/guard-exceptions-form\n          [:php]\n          (list 'let ['probe.injected (injected nil)\n                      'probe.retained (boundary-call (kit/export-form :php \"retain\")\n                                                     ['probe.injected])\n                      'probe.wrapper (list 'get 'probe.retained :value)\n                      'probe.local (list 'if\n                                         (list '= :return\n                                               (list 'get 'probe.retained :route))\n                                         (boundary-call (kit/export-form :php \"is_foreign\")\n                                                        ['probe.wrapper])\n                                         {:value false})]\n                (kit/observation-map-form\n                  {:retained (list '= :return (list 'get 'probe.retained :route))\n                   :plain-local-error (list '= false (list 'get 'probe.local :value))})))\n        results (run-provenance-observation observation)]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PHP-NIL-CONDITION\" backend actual)\n      (is (= {:retained true :plain-local-error true} actual)\n          (str backend \": a nil condition raises the plain local Error, \"\n               \"never a provenance mint (got \" (pr-str actual) \")\")))))\n(ns yang.call.python-exception-test\n  \"Python boundary pins for ruling v2 R2/R3 + egress. Receivers and rethrows\n   are parsed source; malformed protocol delivery uses the shared boundary kit.\n   The focused local gate for the exception-py-r2r3 round: the python subset of\n   the shiva acceptance instrument, never a substitute for the full ledger.\"\n  (:require [clojure.string :as str]\n            [clojure.test :refer [deftest is testing]]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]\n            [yang.call.exception-legs :as legs]\n            [yang.call.exception-probes :as probes]\n            [yang.python.antlr.prelude :as py-prelude]))\n\n\n(defn- check-fixture\n  \"Run one python fixture isolated on all three vector VMs and assert its\n   compliant `:expected` value on each backend.\"\n  [id]\n  (let [fixture (first (filter #(= id (:id %)) contract/fixtures))]\n    (testing (str id)\n      (doseq [[backend actual] (probes/run-fixture fixture)]\n        (is (= (:expected fixture) actual) (str backend))))))\n\n\n(defn- check-leg\n  \"Run one directed source pair/scenario and assert `legs/expected` per VM.\"\n  [id]\n  (let [leg (first (filter #(= id (:id %)) contract/pair-matrix))]\n    (testing (str id)\n      (doseq [[backend actual] (legs/run-leg leg)]\n        (is (= (legs/expected leg) actual) (str backend))))))\n\n\n(deftest python-provenance-export-surface-test\n  (let [private-names '#{dsg__condition-exception cell/dsg__new-provenance\n                         cell/dsg__provenance}\n        exposed? (fn [x]\n                   (some #(str/includes? (str x) %)\n                         [\"dsg__\" \"provenance\" \"condition-exception\"]))\n        public-private-users\n        (into #{}\n              (keep (fn [[k form]]\n                      (when (and (= \"py\" (namespace k))\n                                 (some private-names (tree-seq coll? seq form)))\n                        k)))\n              py-prelude/definitions)]\n    (is (not-any? exposed? (concat py-prelude/module-exports py-prelude/runtime-keys)))\n    ;; Only reception and egress may use the private constructor and reader.\n    ;; This also catches a renamed mint-wrapping helper.\n    (is (= '#{py/call-kw py/function-entry} public-private-users))))\n\n\n(deftest ^:slow python-foreign-reception-test\n  ;; R2: an otherwise-foreign payload is wrapped in a generated local\n  ;; ForeignException; an already-local exception is delivered unchanged.\n  (check-fixture :python/local-reception)           ; stays green\n  (check-fixture :python/foreign-reception)         ; R→G\n  (check-fixture :python/retained-foreign-lifetime) ; R→G\n  ;; The clojure→python typed reception and stored-wrapper rethrow legs.\n  (check-leg [:clojure :python :typed-catch])\n  (check-leg [:clojure :python :unchanged-rethrow])\n  (check-leg [:clojure :python :retained-lifetime]))\n\n\n(deftest ^:slow python-protocol-reception-test\n  ;; R3: not-callable / invalid-invocation / unsupported-binding retain the\n  ;; complete condition instead of collapsing into a bare TypeError.\n  (check-fixture :python/protocol-not-callable)\n  (check-fixture :python/protocol-invalid-invocation)\n  (check-fixture :python/protocol-unsupported-binding)\n  (check-fixture :python/saved-protocol-not-callable)\n  (check-fixture :python/saved-protocol-invalid-invocation)\n  (check-fixture :python/saved-protocol-unsupported-binding))\n\n\n(deftest ^:slow python-egress-sanity-test\n  ;; Egress forwards a retained generated exception's original condition and\n  ;; still produces the plain thrown condition for fresh/forged payloads.\n  (check-fixture :python/fresh-named)       ; stays green\n  (check-fixture :python/fresh-closure)     ; stays green\n  (check-fixture :python/binding)           ; stays green\n  (check-fixture :python/forged-retention)) ; stays green (R5: no source-writable forgery)\n\n\n(deftest ^:slow python-kit-parity-test\n  ;; Match exception-probes/protocol-condition and injected exactly: the\n  ;; refusal is produced by public validation, then delivered by a callable\n  ;; cell's raise exit through a parsed Python f() and bare re-raise.\n  (let [donor (kit/publish-donor! :python contract/boundary-source)\n        source \"def receive(f):\\n    try:\\n        return f()\\n    except BaseException as e:\\n        raise\\n\"\n        call (fn [callee args]\n               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n        observation\n        (kit/guard-exceptions-form\n          [:python]\n          (list 'let\n                ['condition (list 'get (call {} []) :condition)\n                 'injected\n                 (list 'cell/new\n                       (list 'assoc {} :yang.call/entry\n                             (list 'fn ['invocation]\n                                   (list (list 'get 'invocation :yang.call/raise)\n                                         'condition))))\n                 'result (call (kit/export-form :python \"receive\") ['injected])]\n                (kit/observation-map-form\n                  {:reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n                   :condition-identical (list '= 'condition (list 'get 'result :condition))})))\n        results (kit/run-exception-program\n                  donor (kit/compose-exception donor [\"boundary_target\"]\n                                               :python source observation))]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PYTHON-KIT-PARITY\" backend actual)\n      (is (= {:reason :yang.call/not-callable :condition-identical true} actual)\n          (str backend)))))\n\n\n(deftest ^:slow python-malformed-condition-test\n  (let [donor (kit/publish-donor! :python contract/boundary-source)\n        source \"def receive(f):\\n    try:\\n        return f()\\n    except TypeError:\\n        raise\\n\"\n        call (fn [callee args]\n               (kit/boundary-call-form callee (kit/observation-vector-form args) []))]\n    (doseq [malformed [nil :garbage]]\n      (let [observation\n            (kit/guard-exceptions-form\n              [:python]\n              (list 'let\n                    ['injected (list 'cell/new\n                                     (list 'assoc {} :yang.call/entry\n                                           (list 'fn ['invocation]\n                                                 (list (list 'get 'invocation :yang.call/raise)\n                                                       malformed))))\n                     'result (call (kit/export-form :python \"receive\") ['injected])\n                     'condition (list 'get 'result :condition)\n                     'exception (list 'get 'condition :yang.call/value)\n                     'content (list 'cell/get 'exception)]\n                    (kit/observation-map-form\n                      {:reason (list 'get 'condition :yang.call/reason)\n                       :payload (list 'get (list 'get (list 'get 'content :attrs) \"args\") :items)\n                       :provenance (list 'cell/dsg__provenance 'exception)})))\n            results (kit/run-exception-program\n                      donor (kit/compose-exception donor [\"boundary_target\"]\n                                                   :python source observation))]\n        (is (= #{:semantic :stack :register} (set (keys results))))\n        (doseq [[backend actual] results]\n          (is (= {:reason :yang.call/thrown :payload [malformed] :provenance nil} actual)\n              (str malformed \" \" backend)))))))\n\n\n(deftest ^:slow python-kit-batch-parity-test\n  ;; Acceptance uses run-frontend, which shares a task across observations.\n  ;; Isolated run-fixture pins alone cannot establish that batch path.\n  (let [fixtures (filter #(= :python (:frontend %)) contract/fixtures)\n        observations (probes/run-frontend :python)]\n    (is (= (set (map :id fixtures)) (set (keys observations))))\n    (doseq [{:keys [id expected]} fixtures\n            :let [results (get observations id)]]\n      (is (= #{:semantic :stack :register} (set (keys results))) (str id))\n      (doseq [[backend actual] results]\n        (println \"PYTHON-KIT-BATCH\" id backend actual)\n        (is (= expected actual) (str id \" \" backend))))))\n\n\n(def ^:private provenance-donor-source\n  \"(defn forge [e condition] (cell/new (assoc (cell/get e) :py/retained-condition condition)))\n   (defn clone [e] (cell/new (cell/get e)))\n   (defn overwrite [e condition]\n     (do (cell/set! e (assoc (cell/get e) :py/retained-condition condition)) e))\")\n\n\n(defn- check-cell-provenance\n  [attack]\n  (let [donor (kit/publish-donor! :clojure provenance-donor-source)\n        source (str \"payload = None\\n\"\n                    \"def attacked(f, condition):\\n    global payload\\n\"\n                    (if (= attack :forge)\n                      \"    payload = forge(Exception('fresh'), condition)\\n\"\n                      (str \"    try:\\n        f()\\n    except BaseException as e:\\n\"\n                           (if (= attack :clone)\n                             \"        payload = clone(e)\\n\"\n                             \"        payload = overwrite(e, condition)\\n\")))\n                    \"    raise payload\\n\"\n                    \"def attacked_payload():\\n    return payload\\n\")\n        call (fn [callee args]\n               (kit/boundary-call-form callee (kit/observation-vector-form args) []))\n        observation\n        (kit/guard-exceptions-form\n          [:python]\n          (list 'let\n                ['condition (list 'get (call {} []) :condition)\n                 'replacement (list 'assoc 'condition :probe/forged true)\n                 'injected\n                 (list 'cell/new\n                       (list 'assoc {} :yang.call/entry\n                             (list 'fn ['invocation]\n                                   (list (list 'get 'invocation :yang.call/raise)\n                                         'condition))))\n                 'result (call (kit/export-form :python \"attacked\")\n                               ['injected 'replacement])\n                 'payload (list 'get (call (kit/export-form :python \"attacked_payload\") [])\n                                :value)]\n                (kit/observation-map-form\n                  (cond->\n                    {:route (list 'get 'result :route)\n                     :transfers (list 'get 'result :transfers)\n                     :after (list 'get 'result :after)\n                     :reason (list 'get (list 'get 'result :condition) :yang.call/reason)\n                     :original-forwarded (list '= 'condition (list 'get 'result :condition))\n                     :replacement-forwarded (list '= 'replacement (list 'get 'result :condition))}\n                    (not= attack :overwrite)\n                    (assoc :payload-identical\n                           (list '= 'payload (list 'get (list 'get 'result :condition)\n                                                   :yang.call/value)))))))\n        results (kit/run-exception-program\n                  donor (kit/compose-exception donor [\"forge\" \"clone\" \"overwrite\"]\n                                               :python source observation))\n        expected (cond-> {:route :raise :transfers 1 :after false\n                          :reason (if (= attack :overwrite)\n                                    :yang.call/not-callable :yang.call/thrown)\n                          :original-forwarded (= attack :overwrite)\n                          :replacement-forwarded false}\n                   (not= attack :overwrite) (assoc :payload-identical true))]\n    (is (= #{:semantic :stack :register} (set (keys results))))\n    (doseq [[backend actual] results]\n      (println \"PYTHON-CELL-PROVENANCE\" attack backend actual)\n      (is (= expected actual) (str attack \" \" backend)))))\n\n\n(deftest ^:slow python-cell-forgery-test\n  (check-cell-provenance :forge))\n\n\n(deftest ^:slow python-retained-clone-test\n  (check-cell-provenance :clone))\n\n\n(deftest ^:slow python-retained-overwrite-test\n  (check-cell-provenance :overwrite))\n(ns yang.call.exception-legs\n  \"Real-source directed exception legs. All twelve directions share these\n   source generators; no language-pair runtime wrapper or call-node rewrite.\n   Python-containing directions run on JVM in R0. The remaining directions\n   are authored but pending their rounds (exception-contract/pair-matrix).\"\n  (:require [clojure.string :as str]\n            [yang.call.conformance :as kit]\n            [yang.call.exception-contract :as contract]))\n\n\n(defn- define\n  [frontend name params body]\n  (case frontend\n    :python (str \"def \" name \"(\" (str/join \", \" params) \"):\\n\"\n                 (str/join \"\\n\" (map #(str \"    \" %) (str/split-lines body))) \"\\n\")\n    :typescript (str \"globalThis.\" name \" = function(\" (str/join \", \" params)\n                     \") { \" body \" };\\n\")\n    :php (str \"function \" name \"(\" (str/join \", \" (map #(str \"$\" %) params))\n              \") { \" body \" }\\n\")\n    :clojure (str \"(defn \" name \" [\" (str/join \" \" params) \"] \" body \")\\n\")))\n\n\n(defn donor-exports\n  \"Only exports the donor actually defines. JS's absent required-argument\n   helper is never read/projected: that source capability has no binding row.\"\n  [frontend]\n  (cond-> [\"donor_raise\" \"payload\" \"success\"]\n    (not= frontend :typescript) (conj \"needs_argument\")))\n\n\n(defn donor-source\n  [frontend]\n  (str (contract/sources frontend)\n       (define frontend \"success\" []\n         (case frontend :python \"return True\" :clojure \"true\" \"return true;\"))\n       (define frontend \"home\" [\"f\" \"done\"]\n         (case frontend\n           :python (str \"try:\\n    f()\\nexcept ValueError as e:\\n\"\n                        \"    return e is original and done()\\nreturn False\")\n           :typescript (str \"try { f(); } catch(e) { return e === original && done(); }\"\n                            \" return false;\")\n           :php (str \"global $original; try { $f(); } catch(Exception $e) {\"\n                     \" return $e === $original && $done(); } return false;\")\n           :clojure \"(try (f) false (catch Exception e (and (= e original) (done))))\"))))\n\n\n(def catch-all-body\n  {:python \"try:\\n    donor_raise()\\nexcept:\\n    return True\\nreturn False\"\n   :typescript \"try { donor_raise(); } catch(e) { return true; } return false;\"\n   :php \"try { donor_raise(); } catch(Throwable $e) { return true; } return false;\"\n   :clojure \"(try (donor_raise) false (catch Exception e true))\"})\n\n\n(defn caller-source\n  [frontend scenario]\n  (let [header (case frontend :php \"<?php \" \"\")\n        probe #(define frontend \"probe\" [] %)\n        ;; `done` checks exactly-once cleanup, before the home runtime\n        ;; recognizes its original exception again. `:round-trip`'s clojure\n        ;; arm still cleans up through the admitted catch surface rather than\n        ;; `finally`; converting it belongs to the dialect-definition round.\n        counter (case frontend\n                  :python \"cleaned = 0\\n\"\n                  :typescript \"globalThis.cleaned = 0;\\n\"\n                  :php \"$cleaned = 0;\\n\"\n                  :clojure \"(def cleaned (cell/new 0))\\n\")\n        done (define frontend \"done\" []\n               (case frontend\n                 :python \"return cleaned == 1\"\n                 :typescript \"return cleaned === 1;\"\n                 :php \"global $cleaned; return $cleaned === 1;\"\n                 :clojure \"(= (cell/get cleaned) 1)\"))]\n    (str header\n         (case scenario\n           :catch-all (probe (catch-all-body frontend))\n           :typed-catch\n           (probe (case frontend\n                    :python (str \"try:\\n    donor_raise()\\nexcept BaseException as e:\\n\"\n                                 \"    return type(e).__name__ == 'ForeignException'\\nreturn False\")\n                    :php \"try { donor_raise(); } catch(ForeignException $e) { return true; } return false;\"\n                    ;; JS has no typed syntax; Clojure admits exactly this\n                    ;; restricted catch. Neither row claims class matching.\n                    (catch-all-body frontend)))\n           :unchanged-rethrow\n           (str (case frontend :python \"caught = 0\\n\"\n                      :typescript \"globalThis.caught = 0;\\n\"\n                      :php \"$caught = 0;\\n\"\n                      :clojure \"(def caught (cell/new 0))\\n\")\n                (define frontend \"caught_once\" []\n                  (case frontend :python \"return caught == 1\"\n                        :typescript \"return caught === 1;\"\n                        :php \"global $caught; return $caught === 1;\"\n                        :clojure \"(= (cell/get caught) 1)\"))\n                (probe (case frontend\n                         :python \"global caught\\ntry:\\n    donor_raise()\\nexcept BaseException:\\n    caught += 1\\n    raise\"\n                         :typescript \"try { donor_raise(); } catch(e) { caught += 1; throw e; }\"\n                         :php \"global $caught; try { donor_raise(); } catch(Throwable $e) { $caught += 1; throw $e; }\"\n                         :clojure \"(try (donor_raise) (catch Exception e (cell/set! caught (+ (cell/get caught) 1)) (throw e)))\")))\n           :binding (probe (str/replace (catch-all-body frontend) \"donor_raise\" \"needs_argument\"))\n           :success-raise-success\n           (probe (case frontend\n                    :python (str \"if not success():\\n    return False\\n\"\n                                 \"try:\\n    donor_raise()\\nexcept:\\n    return success()\\nreturn False\")\n                    :typescript \"if (!success()) return false; try { donor_raise(); } catch(e) { return success(); } return false;\"\n                    :php \"if (!success()) return false; try { donor_raise(); } catch(Throwable $e) { return success(); } return false;\"\n                    :clojure \"(and (success) (try (donor_raise) false (catch Exception e (success))))\"))\n           :finally-replacement\n           (str\n             (case frontend\n               :python \"replacement = ValueError('replacement')\\n\"\n               :typescript \"globalThis.replacement = {marker: 'replacement'};\\n\"\n               :php \"$replacement = new Exception('replacement');\\n\"\n               :clojure \"(def replacement (cell/new :replacement))\\n\")\n             (define frontend \"replacement_payload\" []\n               (case frontend :python \"return replacement\"\n                     :typescript \"return replacement;\"\n                     :php \"global $replacement; return $replacement;\"\n                     :clojure \"replacement\"))\n             (probe (case frontend\n                      :python \"try:\\n    donor_raise()\\nfinally:\\n    raise replacement\"\n                      :typescript \"try { donor_raise(); } finally { throw replacement; }\"\n                      :php \"global $replacement; try { donor_raise(); } finally { throw $replacement; }\"\n                      :clojure \"(try (donor_raise) (finally (throw replacement)))\")))\n           :retained-lifetime\n           (str\n             (case frontend :python \"saved = None\\n\" :typescript \"globalThis.saved = null;\\n\"\n                   :php \"$saved = null;\\n\" :clojure \"(def saved (cell/new nil))\\n\")\n             (define frontend \"save_foreign\" []\n               (case frontend\n                 :python \"global saved\\ntry:\\n    donor_raise()\\nexcept BaseException as e:\\n    saved = e\\n    return e\"\n                 :typescript \"try { donor_raise(); } catch(e) { saved = e; return e; }\"\n                 :php \"global $saved; try { donor_raise(); } catch(Throwable $e) { $saved = $e; return $e; }\"\n                 :clojure \"(try (donor_raise) (catch Exception e (cell/set! saved e) e))\"))\n             (define frontend \"saved_local\" []\n               (case frontend\n                 :python \"return isinstance(saved, BaseException) and type(saved).__name__ == 'ForeignException'\"\n                 :php \"global $saved; return $saved instanceof Throwable && get_class($saved) === 'ForeignException';\"\n                 :typescript \"return true;\" :clojure \"true\"))\n             (probe (case frontend :python \"raise saved\" :typescript \"throw saved;\"\n                          :php \"global $saved; throw $saved;\" :clojure \"(throw (cell/get saved))\")))\n           :round-trip\n           (str counter done\n                (probe (case frontend\n                         :python \"global cleaned\\ntry:\\n    donor_raise()\\nfinally:\\n    cleaned += 1\"\n                         :typescript \"try { donor_raise(); } finally { cleaned += 1; }\"\n                         :php \"global $cleaned; try { donor_raise(); } finally { $cleaned += 1; }\"\n                         :clojure \"(try (donor_raise) (catch Exception e (cell/set! cleaned (+ (cell/get cleaned) 1)) (throw e)))\")))))))\n\n\n(defn- call\n  [frontend export args]\n  (kit/boundary-call-form (kit/export-form frontend export)\n                          (kit/observation-vector-form args) []))\n\n\n(defn observation-form\n  [{:keys [donor caller scenario probe-export]}]\n  (let [result 'leg.result\n        original 'leg.original\n        transfer {:transferred (list '= :raise (list 'get result :route))\n                  :once (list '= 1 (list 'get result :transfers))\n                  :after (list 'get result :after)\n                  :reason (list 'get (list 'get result :condition) :yang.call/reason)\n                  :payload-identical\n                  (list '= original (list 'get (list 'get result :condition) :yang.call/value))}\n        probe-export (or probe-export \"probe\")\n        simple {:returned (list '= :return (list 'get result :route))\n                :value (list 'get result :value)}]\n    (kit/guard-exceptions-form\n      [donor caller]\n      (case scenario\n        (:catch-all :typed-catch :binding :success-raise-success)\n        (list 'let [result (call caller probe-export [])] (kit/observation-map-form simple))\n        :round-trip\n        (list 'let [result (call donor \"home\" [(kit/export-form caller probe-export)\n                                               (kit/export-form caller \"done\")])]\n              (kit/observation-map-form simple))\n        :retained-lifetime\n        (list 'let [original (list 'get (call donor \"payload\" []) :value)\n                    'leg.saved (call caller \"save_foreign\" [])\n                    'leg.local (call caller \"saved_local\" [])\n                    result (call caller probe-export [])]\n              (kit/observation-map-form\n                (assoc transfer :retained (list '= :return (list 'get 'leg.saved :route))\n                       :local (list 'get 'leg.local :value))))\n        (:unchanged-rethrow :finally-replacement)\n        (list 'let [original (list 'get (if (= scenario :finally-replacement)\n                                          (call caller \"replacement_payload\" [])\n                                          (call donor \"payload\" [])) :value)\n                    result (call caller probe-export [])]\n              (kit/observation-map-form (cond-> transfer\n                                          (= scenario :unchanged-rethrow)\n                                          (assoc :caught (list 'get (call caller \"caught_once\" []) :value)))))))))\n\n\n(defn expected\n  [{:keys [scenario]}]\n  (if (#{:catch-all :typed-catch :binding :success-raise-success :round-trip} scenario)\n    {:returned true :value true}\n    (cond-> {:transferred true :once true :after false\n             :reason :yang.call/thrown :payload-identical true}\n      (= scenario :unchanged-rethrow) (assoc :caught true)\n      (= scenario :retained-lifetime) (assoc :retained true :local true))))\n\n\n(def ^:private published-donors\n  (into {} (for [frontend contract/frontends]\n             [frontend (delay (kit/publish-donor! frontend (donor-source frontend)))])))\n\n\n(defn run-leg\n  [{:keys [donor caller scenario] :as leg}]\n  (try\n    (let [published @(get published-donors donor)]\n      (kit/run-exception-program\n        published\n        (kit/compose-exception published\n                               (donor-exports donor)\n                               caller (caller-source caller scenario)\n                               (observation-form leg))))\n    (catch Throwable e\n      (kit/error-results e))))\n\n\n(defn- probe-name\n  [scenario]\n  (str \"probe_\" (str/replace (name scenario) \"-\" \"_\")))\n\n\n(defn batch-caller-source\n  \"One parsed caller unit with distinct named probes. Renaming happens in\n   generated SOURCE, before parsing; no lowered call nodes are changed.\"\n  [caller pair-legs]\n  (str (when (= caller :php) \"<?php \")\n       (apply str\n              (for [{:keys [scenario]} pair-legs]\n                (-> (caller-source caller scenario)\n                    (str/replace #\"^<\\?php \" \"\")\n                    (str/replace #\"\\bprobe\\b\" (probe-name scenario)))))))\n\n\n(defn run-pair\n  \"All authored scenarios for a directed pair, on each vector VM. Each\n   probe enters through its own public entry. Guards report unbridged\n   escapes; full context snapshot proof remains a frontend gate.\"\n  [donor caller]\n  (let [pair-legs (filter #(and (= donor (:donor %)) (= caller (:caller %)))\n                          contract/pair-matrix)]\n    (try\n      (let [published @(get published-donors donor)\n            observations (reduce\n                           (fn [acc {:keys [scenario] :as leg}]\n                             (list 'assoc acc scenario\n                                   (observation-form\n                                     (assoc leg :probe-export (probe-name scenario)))))\n                           {} pair-legs)\n            results (kit/run-exception-program\n                      published\n                      (kit/compose-exception published\n                                             (donor-exports donor)\n                                             caller (batch-caller-source caller pair-legs)\n                                             observations))]\n        (if (some #(instance? Throwable %) (vals results))\n          (into {} (for [{:keys [id] :as leg} pair-legs]\n                     [id (run-leg leg)]))\n          (into {} (for [{:keys [id scenario]} pair-legs]\n                     [id (update-vals results #(get % scenario))]))))\n      (catch Throwable e\n        (let [err (kit/error