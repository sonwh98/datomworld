ist 'dsg__raw-fn [binding]\n                          (body-expression (map rewrite-throw-try handler)))))\n            body-form)]\n      (if fin\n        (list 'clj/try-finally\n              (list 'dsg__raw-fn [] guarded)\n              (list 'dsg__raw-fn ['_] (body-expression (map rewrite-throw-try (rest fin)))))\n        guarded))))\n\n\n(defn- lower-function-body\n  \"The plain-value body of one function over `params`, with `throw`/`try`\n29:   - the continuation family, `clj/try`, `clj/try-finally`, `clj/throw`,\n146:    [clj/try-finally\nM  src/cljc/yang/clojure.cljc\nM  src/cljc/yang/clojure/prelude.cljc\n M test/yang/call/exception_contract.clj\n M test/yang/call/exception_legs.clj\n M test/yang/call/exception_source_test.clj\nA  test/yang/clojure/donor_link_test.clj\nM  test/yang/clojure_test.clj\nM  test/yang/core/call_test.cljc\nM  test/yang/latte_oracle/context.edn\nA  test/yang/latte_oracle/depth_baseline_fbd8da0f.edn\nA  test/yang/latte_oracle/depth_comparison.md\nA  test/yang/latte_oracle/depth_post_port.edn\nM  test/yang/latte_oracle/unfold_implicit.edn\nM  test/yang/latte_oracle_test.clj\n M test/yang/python/antlr/exception_call_test.clj\n","exit_code":0,"status":"completed"}}
