r stage's transform over source events (`packet/transform`).\"\n     1\t(ns yang.core.uast\n     2\t  \"Universal AST constructors shared by every language lowering and prelude. Every\n     3\t   function returns a canonical map node (`:literal`, `:variable`, `:lambda`,\n     4\t   `:application`, `:if`, `:vm/current-continuation`); nothing here adds a\n     5\t   node type.\n     6\t\n     7\t   `sexp->uast` reads a small s-expression notation into those same nodes so\n     8\t   the prelude can be written legibly:\n     9\t\n    10\t     symbol            -> :variable\n    11\t     (fn [params] b)   -> :lambda\n    12\t     (if t c a)        -> :if\n    13\t     (do a b ... z)    -> sequencing through one-parameter lambdas\n    14\t     (let [x v ...] b) -> nested immediately applied lambdas\n    15\t     (quote x)         -> :literal x\n    16\t     (%capture)        -> :vm/current-continuation\n    17\t     (yin/def k v)     -> the definition application\n    18\t     (f a ...)         -> :application\n    19\t     any other value   -> :literal\"\n    20\t  (:require\n    21\t    [yang.tails :as tails]\n    22\t    [yin.vm :as vm]))\n    23\t\n    24\t\n    25\t(defn lit\n    26\t  [x]\n    27\t  {:type :literal, :value x})\n    28\t\n    29\t\n    30\t(defn v\n    31\t  [sym]\n    32\t  {:type :variable, :name sym})\n    33\t\n    34\t\n    35\t(defn lam\n    36\t  [params body]\n    37\t  {:type :lambda, :params (vec params), :body body})\n    38\t\n    39\t\n    40\t(defn app\n    41\t  [op & args]\n    42\t  {:type :application, :operator op, :operands (vec args)})\n    43\t\n    44\t\n    45\t(defn if-node\n    46\t  [t c a]\n    47\t  {:type :if, :test t, :consequent c, :alternate a})\n    48\t\n    49\t\n    50\t(def capture {:type :vm/current-continuation})\n    51\t\n    52\t\n    53\t(defn def!\n    54\t  \"`(yin/def key value)`: key is a literal symbol.\"\n    55\t  [key value]\n    56\t  (app (v 'yin/def) (lit key) value))\n    57\t\n    58\t\n    59\t(def discard\n    60\t  \"The parameter a sequencing lambda binds and ignores. `%` cannot begin a\n    61\t   Python identifier, so it never shadows a guest name.\"\n    62\t  '%_)\n    63\t\n    64\t\n    65\t(defn then\n    66\t  \"Evaluate `a` for effect, then `b`.\"\n    67\t  [a b]\n    68\t  (app (lam [discard] b) a))\n    69\t\n    70\t\n    71\t(defn seq-nodes\n    72\t  \"Evaluate every node in order; the value is the last one's.\"\n    73\t  [nodes]\n    74\t  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n    75\t\n    76\t\n    77\t(defn let1\n    78\t  [sym value body]\n    79\t  (app (lam [sym] body) value))\n    80\t\n    81\t\n    82\t(defn sexp->uast\n    83\t  [form]\n    84\t  (cond\n    85\t    (symbol? form) (v form)\n    86\t    (seq? form)\n    87\t    (let [[head & args] form]\n    88\t      (case head\n    89\t        fn (lam (first args) (sexp->uast (second args)))\n    90\t        if (if-node (sexp->uast (first args))\n   150\t                                     {:yang.call/reason :missing-raise-exit}))))]])\n   151\t\n   152\t\n   153\t(def ^:private public-exports\n   154\t  '#{entry eligible? invocation invocation-with valid-invocation? condition\n   155\t     thrown transfer invoke invoke-with})\n   156\t\n   157\t\n   158\t(def uast\n   159\t  \"The bundled definitions, in source order and tail marked.\"\n   160\t  (u/mark-tails\n   161\t    (reduce (fn [ast [key form]]\n   162\t              (u/then ast (u/def! key (u/sexp->uast form))))\n   163\t            (u/def! (ffirst definitions)\n   164\t                    (u/sexp->uast (second (first definitions))))\n   165\t            (rest definitions))))\n   166\t\n   167\t\n   168\t(def module-uast\n   169\t  \"The linked module tree built from the same `definitions`. C1\n   170\t   finalized, like every published production tree: its\n   171\t   `:yang/call-site` markers publish beside its manifest (see\n   172\t   `yin.vm.linker.publish`).\"\n   173\t  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n   174\t                                          [] definitions)]\n   175\t    (u/annotate-call-sites (core/module-tree stripped []))))\n   176\t\n   177\t\n   178\t(def module-exports\n   179\t  \"Public module exports (private helper definitions stay internal).\"\n   180\t  public-exports)\n   181\t\n   182\t\n   183\t(def ^:private module-free-names\n   184\t  (core/free-name-vec module-uast))\n   185\t\n   186\t\n   187\t(defn module-spec\n   188\t  \"The linker module spec for `yang.call` over `registry`.\"\n   189\t  [registry]\n   190\t  (core/module-spec {:module-name module-name\n   191\t                     :ast module-uast\n   192\t                     :exports module-exports\n   193\t                     :requires {}\n   194\t                     :free-names module-free-names\n   195\t                     :registry registry\n   196\t                     :message \"the yang.call module reads an undeclared name\"\n   197\t                     :refusal-ns \"yang.call\"}))\n    82\t  (vary-meta node assoc :yang/site kind))\n    83\t\n    84\t\n    85\t(defn app*\n    86\t  [op-sym & args]\n    87\t  (apply u/app (u/v op-sym) args))\n    88\t\n    89\t\n    90\t(defn contains-rule?\n    91\t  \"True when `rule-name` occurs below `n` without crossing any `stop` rule.\"\n    92\t  [ctx n rule-name stop]\n    93\t  (boolean\n    94\t    (some (fn [k]\n    95\t            (and (p/rule? k)\n    96\t                 (or (= rule-name (:rule k))\n    97\t                     (and (not (contains? stop (:rule k)))\n    98\t                          (contains-rule? ctx k rule-name stop)))))\n    99\t          (kids ctx n))))\n   100\t\n   101\t\n   102\t(defn code-point->str\n   103\t  [cp]\n   104\t  #?(:cljd (let [sb (StringBuffer)] (.writeCharCode sb cp) (.toString sb))\n   105\t     :clj (String. (Character/toChars (int cp)))\n   106\t     :cljs (.fromCodePoint js/String cp)))\n   107\t\n   108\t\n