so each read of it is\n    39\t   discharged by an unconditional module-level definition.\"\n    40\t  [k uninit]\n    41\t  [k uninit])\n    42\t\n    43\t\n    44\t(defn module-definitions\n    45\t  \"The module's definition list: a `uninit` placeholder for every runtime\n    46\t   key (stripped of `ns-str`), then every definition, stripped.\"\n    47\t  [ns-str uninit runtime-keys definitions]\n    48\t  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n    49\t        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n    50\t        definitions))\n    51\t\n    52\t\n    53\t(defn wide-app\n    54\t  \"One application whose operands are `nodes` (in order), applied to a lambda\n    55\t   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n    56\t   linker's scanners discharge every body read of a sibling or runtime key;\n    57\t   a `then` chain would nest definitions in closure bodies.\"\n    58\t  [nodes]\n    59\t  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    60\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n    61\t\n    62\t\n    63\t(defn module-tree\n    64\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    65\t   the `trailing` UAST nodes.\"\n    66\t  [defs trailing]\n    67\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    68\t                  trailing)))\n    69\t\n    70\t\n    71\t(defn exports\n    72\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    73\t   stripped.\"\n    74\t  [ns-str definitions]\n    75\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    76\t             definitions)))\n    77\t\n    78\t\n    79\t(defn free-names\n    80\t  \"Every variable name some occurrence of the map AST `ast` reads\n     1\t(ns yang.php.antlr.siteset\n     2\t  \"Publication of PHP occurrence marks beside canonical module rows.\"\n     3\t  (:require\n     4\t    [dao.jing :as jing]\n     5\t    [yang.core.siteset-store :as store]\n     6\t    [yang.core.siteset-publication :as publication]\n     7\t    [yang.safepoint :as safepoint]\n     8\t    [yang.core.module :as core-module]\n     9\t    [yang.core.uast :as u]\n    10\t    [yin.vm.linker.publish :as publish]\n    11\t    [yin.vm :as vm]\n    12\t    [yin.vm.encoder :as encoder]\n    13\t    [yin.vm.linker.sign :as sign]))\n    14\t\n    15\t\n    16\t(def frontend-revision \"yang.php.antlr.lower/sites-1\")\n    17\t\n    18\t\n    19\t(def lowering-profile\n    20\t  {:yang.site/unit :module, :yang.site/prelude :linked,\n    21\t   :yang.site/kinds [:call :line :loop]})\n    22\t\n    23\t\n    24\t(def profile-address (jing/segment-key lowering-profile))\n    25\t\n    26\t\n    27\t(defn site-set-of\n    28\t  \"The canonical root and occurrence marks of module AST `ast`.\"\n    29\t  [ast]\n    30\t  (let [env (encoder/project (encoder/source-envelope\n    31\t                               :yang.php.antlr/site-set [:site-set 0] [ast]))\n    32\t        tree (nth (:yin/batch env) (:yin/root env))\n    33\t        origin (vm/source-origin (:yin/source-medium env)\n    34\t                                 (:yin/batch-token env) (:yin/root env))\n    35\t        sites (safepoint/sites (:yin/frontend-metadata env) origin (:root tree))]\n    36\t    {:root (:root tree), :set (safepoint/site-set sites)}))\n    37\t\n    38\t\n    39\t(defn publish!\n    40\t  \"Publish the set, including an empty set, and its manifest/root binding.\"\n    41\t  [handle manifest ast]\n    42\t  (let [{:keys [root set]} (site-set-of ast)\n    43\t        set-address (jing/materialize! handle (vec set))\n    44\t        record {:yang.site/manifest manifest, :yang.site/root root,\n    45\t                :yang.site/revision frontend-revision,\n    46\t                :yang.site/profile profile-address, :yang.site/set set-address}]\n    47\t    {:record record, :record-address (jing/materialize! handle record),\n    48\t     :set-address set-address, :set set}))\n    49\t\n    50\t\n    51\t(defn- read-at\n    52\t  [handle address]\n    53\t  (when (jing/segment-address? address)\n    54\t    (let [bytes ((:get-bytes-fn handle) address ::absent)]\n    55\t      (cond\n    56\t        (or (nil? bytes) (= ::absent bytes)) ::absent\n    57\t        (jing/segment-bytes-match? address bytes) (jing/segment-value address bytes)))))\n    58\t\n    59\t\n    60\t(defn verify\n    61\t  \"Read and verify a published set, or return nil for missing or mismatched\n    62\t   metadata. An empty set is a valid publication.\"\n    63\t  [handle manifest record-address]\n    64\t  (let [module (read-at handle manifest)\n    65\t        record (read-at handle record-address)\n    66\t        sites (read-at handle (when (map? record) (:yang.site/set record)))]\n    67\t    (when (and (map? module) (map? record) (vector? sites)\n    68\t               (= manifest (:yang.site/manifest record))\n    69\t               (= (:yin.module/tree module) (:yang.site/root record))\n    70\t               (= frontend-revision (:yang.site/revision record))\n    71\t               (= profile-address (:yang.site/profile record))\n    72\t               (every? (fn [entry]\n    73\t                         (and (vector? entry) (= 2 (count entry))\n    74\t                              (vector? (first entry))\n    75\t                              (let [mark (second entry)\n    76\t                                    kind (if (vector? mark) (first mark) mark)]\n    77\t                                (contains? #{:call :line :loop} kind))))\n    78\t                       sites)\n    79\t               (= sites (safepoint/site-set (into {} sites))))\n    80\t      {:record record, :set sites})))\n    81\t\n    82\t\n    83\t(defn signed-entry\n    84\t  \"Sign the association between a published manifest and its site record.\"\n    85\t  [key manifest record-address]\n    86\t  (publication/signed-entry key manifest record-address))\n    87\t\n    88\t\n    89\t(defn entry-datoms\n    90\t  \"Index signed site publications alongside name assertions.\"\n    91\t  [signed]\n    92\t  (publication/entry-datoms signed))\n    93\t\n    94\t\n    95\t(defn discover\n    96\t  \"Find site record addresses signed by a declared public key for manifest.\"\n    97\t  [datoms publics manifest]\n    98\t  (let [proofs (reduce (fn [acc [e a v]]\n    99\t                         (cond-> acc\n   100\t                           (= a :yang.site/proof) (update e (fnil conj #{}) v)))\n   101\t                       {} datoms)]\n   102\t    (vec (distinct\n   103\t           (keep (fn [[e a env]]\n   104\t                   (when (and (= a :yang.site/envelope) (map? env)\n   105\t                              (= :publish (:yang.site/op env))\n   106\t                              (= manifest (:yang.site/manifest env)))\n   107\t                     (let [ps (get proofs e)\n   108\t                           sig (when (= 1 (count ps))\n   109\t                                 (:yin.module/signature (first ps)))]\n   110\t                       (when (and (string? sig)\n   111\t                                  (some #(and (= (:yin.module/asserted-by env)\n   112\t                                                 (sign/principal %))\n   113\t                                              (sign/verify-envelope\n   114\t                                                % (jing/canonical-bytes env) sig))\n   115\t                                        publics))\n   116\t                         (:yang.site/record env)))))\n   117\t                 datoms)))))\n   118\t\n   119\t\n   120\t(defn signed-entries\n   121\t  \"Sign all site publications returned by unit publication, including aliases.\"\n   122\t  [publisher sites addresses bundles]\n   123\t  (publication/signed-entrie