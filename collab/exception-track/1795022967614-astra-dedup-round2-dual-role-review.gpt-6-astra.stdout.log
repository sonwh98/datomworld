op-level form.\"\n    35\t  [file-path]\n    36\t  (let [forms (read-source file-path)] (mapv yang/compile forms)))\n    37\t\n    38\t\n    39\t(defn compile-string\n    40\t  \"Compile a string containing Clojure code to Universal AST.\n    41\t  Returns a vector of compiled AST nodes, one for each form.\"\n    42\t  [source-str]\n    43\t  (let [forms (read-forms source-str \"<string>\")]\n    44\t    (mapv yang/compile forms)))\n    45\t\n    46\t\n    47\t(defn write-ast\n    48\t  \"Write compiled AST to a file as EDN.\n    49\t  The AST is a map-based structure that can be serialized to EDN.\"\n    50\t  [ast-nodes file-path]\n    51\t  (spit file-path (pr-str ast-nodes)))\n    52\t\n    53\t\n    54\t(defn compile-and-save\n    55\t  \"Compile a source file and save the AST to an output file.\n    56\t  Returns the compiled AST.\"\n    57\t  [source-path output-path]\n    58\t  (let [ast (compile-file source-path)]\n    59\t    (write-ast ast output-path)\n    60\t    ast))\n     1\t(ns yang.io\n     2\t  \"Platform-specific I/O for Yang compiler on Node.js.\n     3\t\n     4\t  Provides functions to compile Clojure source files to Universal AST.\"\n     5\t  (:require\n     6\t    [cljs.tools.reader :as reader]\n     7\t    [cljs.tools.reader.reader-types :as reader-types]\n     8\t    [yang.clojure :as yang]))\n     9\t\n    10\t\n    11\t(def fs (js/require \"fs\"))\n    12\t\n    13\t\n    14\t(defn- read-forms\n    15\t  [source file-name]\n    16\t  (let [r (reader-types/indexing-push-back-reader source 1 file-name)]\n    17\t    (loop [forms []]\n    18\t      (let [form (reader/read {:eof ::eof} r)]\n    19\t        (if (= form ::eof) forms (recur (conj forms form)))))))\n    20\t\n    21\t\n    22\t(defn read-source\n    23\t  \"Read Clojure source code from a file.\n    24\t  Returns a sequence of forms.\"\n    25\t  [file-path]\n    26\t  (try (let [content (.readFileSync fs file-path \"utf8\")\n    27\t             forms (read-forms content file-path)]\n    28\t         forms)\n    29\t       (catch js/Error e\n    30\t         (throw (ex-info \"Failed to read source file\"\n    31\t                         {:file file-path, :error (.-message e)}\n    32\t                         e)))))\n    33\t\n    34\t\n    35\t(defn compile-file\n    36\t  \"Compile a Clojure source file to Universal AST.\n    37\t  Returns a vector of compiled AST nodes, one for each top-level form.\"\n    38\t  [file-path]\n    39\t  (let [forms (read-source file-path)] (mapv yang/compile forms)))\n    40\t\n    41\t\n    42\t(defn compile-string\n    43\t  \"Compile a string containing Clojure code to Universal AST.\n    44\t  Returns a vector of compiled AST nodes, one for each form.\"\n    45\t  [source-str]\n    46\t  (let [forms (read-forms source-str \"<string>\")]\n    47\t    (mapv yang/compile forms)))\n    48\t\n    49\t\n    50\t(defn write-ast\n    51\t  \"Write compiled AST to a file as EDN.\n    52\t  The AST is a map-based structure that can be serialized to EDN.\"\n    53\t  [ast-nodes file-path]\n    54\t  (.writeFileSync fs file-path (pr-str ast-nodes) \"utf8\"))\n    55\t\n    56\t\n    57\t(defn compile-and-save\n    58\t  \"Compile a source file and save the AST to an output file.\n    59\t  Returns the compiled AST.\"\n    60\t  [source-path output-path]\n    61\t  (let [ast (compile-file source-path)]\n    62\t    (write-ast ast output-path)\n    63\t    ast))\n     1\t(ns yang.php.antlr.eval-transport\n     2\t  \"Validation of the portable, sealed eval compiler request.\")\n     3\t\n     4\t\n     5\t(def request-fields\n     6\t  #{:yang.compile/request :yang.compile/unit :yang.compile/frontend-revision\n     7\t    :yang.compile/compiler-revision :yang.compile/goal :yang.compile/provenance\n     8\t    :yang.compile/options :yang.php/source})\n     9\t\n    10\t\n    11\t(defn portable-data?\n    12\t  \"True for the data forms accepted by this request protocol.\"\n    13\t  [x]\n    14\t  (cond\n    15\t    (or (nil? x) (boolean? x) (string? x) (number? x)\n    16\t        (keyword? x) (symbol? x)) true\n    17\t    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\n    18\t    (or (vector? x) (set? x) (list? x)) (every? portable-data? x)\n    19\t    :else false))\n    20\t\n    21\t\n    22\t(defn request-defect\n    23\t  \"Return a protocol defect or nil. Unknown fields are refused so that\n    24\t   caller runtime state cannot accidentally be included at the top level.\"\n    25\t  [request]\n    26\t  (cond\n    27\t    (not (map? request)) :request-shape\n    28\t    (some #(not (contains? request %)) request-fields) :missing-field\n    29\t    (some #(not (contains? request-fields %)) (keys request)) :unknown-field\n    30\t    (not= :eval (:yang.compile/goal request)) :wrong-goal\n    31\t    (not (string? (:yang.php/source request))) :source-shape\n    32\t    (not (map? (:yang.compile/options request))) :options-shape\n    33\t    (not (portable-data? request)) :non-portable-data\n    34\t    :else nil))\n    48\t     :cljs (js/Uint8Array. (clj->js bs))))\n    49\t\n    50\t\n    51\t(defn admit\n    52\t  \"Decode a byte carrier once. Malformed carriers are protocol violations;\n    53\t   malformed UTF-8 produces the classified PHP diagnostic.\"\n    54\t  [carrier]\n    55\t  (if-not (string? carrier)\n    56\t    {:reason :carrier-representation}\n    57\t    (let [bs (mapv #(text/code-unit carrier %) (range (text/unit-count carrier)))]\n    58\t      (if (some #(> % 255) bs)\n    59\t        {:reason :carrier-representation}\n    60\t        (if-let [[start end] (bad-sequence bs)]\n    61\t          {:diagnostic {:yang.php/diagnostic :yang.php/unsupported\n    62\t                        :construct :eval :reason :source-encoding :encoding :utf-8\n    63\t                        :byte-offset start :span [start end]}}\n    64\t          (let [source (text/utf8-decode (host-bytes bs))\n    65\t                encoded (mapv #(bit-and % 255) (text/utf8-encode source))]\n    66\t            (if (= bs encoded)\n    67\t              {:source source}\n    68\t              (throw (ex-info \"UTF-8 round trip failed\" {:reason :utf8-round-trip})))))))))\n    69\t\n    70\t\n    71\t(defn admit-request\n    72\t  \"Admit a sealed eval request, preserving correlation and provenance on refusal.\n    73\t   On success the original request and its derived parser view travel together.\"\n    74\t  [request]\n    75\t  (let [{:keys [source diagnostic reason]} (admit (:yang.php/source request))]\n    76\t    (cond\n    77\t      diagnostic (assoc (select-keys request [:yang.compile/request :yang.compile/unit\n    78\t                                              :yang.compile/provenance])\n    79\t                        :yang.compile/outcome :yang.compile/rejected\n    80\t                        :yang.compile/reason :yang.compile/unsupported\n    81\t                        :yang.compile/diagnostic diagnostic)\n    82\t      reason (assoc (select-keys request [:yang.compile/request :yang.compile/unit\n    83\t                                          :yang.compile/provenance])\n    84\t                    :yang.compile/outcome :yang.compile/rejected\n    85\t                    :yang.compile/reason :yang.compile/invalid-request\n    86\t                    :yang.compile/detail reason)\n    87\t      :else {:request request :source source})))\n    45\t  [worker request]\n    46\t  (if-let [defect (transport/request-defect request)]\n    47\t    (cond-> {:yang.compile/outcome :yang.compile/rejected\n    48\t             :yang.compile/reason :yang.compile/invalid-request\n    49\t             :yang.compile/detail defect}\n    50\t      (and (map? request) (contains? request :yang.compile/request)\n    51\t           (transport/portable-data? (:yang.compile/request request)))\n    52\t      (assoc :yang.compile/request (:yang.compile/request request)))\n    53\t    (compile-request worker request)))\n    54\t\n    55\t\n    56\t(defn- compile-and-publish*!\n    57\t  \"Compile a sealed request and publish its canonical module and occurrence\n    58\t   set to the composition's store. Linker admission is a separate step.\"\n    59\t  [{:keys [worker store registry stage-requirement]} request]\n    60\t  (let [{:keys [cst identity] :as prepared} (compile-transport-request worker request)\n    61\t        correlation (when (map? request)\n    62\t                      (select-keys request [:yang.compile/request :yang.compile/unit\n    63\t                                            :yang.compile/provenance]))]\n    64\t    (cond\n    65\t      (:yang.compile/outcome prepared) prepared\n    66\t      (not= :yang.cst/ok (:yang.cst/outcome cst))\n    67\t      (merge correlation {:yang.compile/outcome :yang.compile/rejected\n    68\t                          :yang.compile/reason :yang.compile/invalid-source\n    69\t                          :yang.compile/diagnostics (:yang.cst/errors cst)})\n    70\t      :else\n    71\t      (let [name (symbol (str \"eval.\" (name (jing/segment-key identity))))\n    72\t            result (publication/publish! store registry name prepared)]\n    73\t        (if (= :ok (:status result))\n    74\t          (let [address (:address result)\n    75\t                site (:sites result)\n    76\t                stage (when stage-requirement\n    77\t                        (siteset/stage registry stage-requirement\n    78\t                                       {address [(:record-address site)]}))\n    79\t                derived (when stage (stage {:store store :datoms [] :principals []}\n    80\t                                           name address))]\n    81\t            (if (and derived (not= :ok (:status derived)))\n    82\t              (merge correlation {:yang.compile/outcome :yang.compile/rejected\n    83\t                                  :yang.compile/reason :yang.compile/derivation-failed\n    84\t                                  :yang.compile/detail derived})\n    85\t              (merge correlation {:yang.compile/outcome :yang.compile/published\n    86\t                                  :yang.compile/module name\n    87\t                                  :yang.compile/address address\n    88\t                                  :yang.compile/source-address (:source-address result)\n    89\t                                  :yang.compile/site-record (:record-address site)}\n    90\t                     (when derived {:yang.compile/active-address (:address derived)\n    91\t                                    :yang.compile/derivation (:derivation derived)}))))\n    92\t          (merge correlation {:yang.compile/outcome :yang.compile/rejected\n    93\t                              :yang.compile/reason :yang.compile/publication-failed\n    94\t                              :yang.compile/detail (select-keys result [:reason :status])}))))))\n    95\t\n    96\t\n    97\t(defn compile-and-publish!\n    98\t  \"Compile and publish, returning classified frontend diagnostics to the caller.\"\n    99\t  [state request]\n   100\t  (try\n   101\t    (compile-and-publish*! state request)\n   102\t    (catch #?(:cljd Object :clj Exception :cljs :default) e\n   103\t      (let [diagnostic (ex-data e)]\n   104\t        (if (:yang.php/diagnostic diagnostic)\n   105\t          (merge (when (map? request)\n   106\t                   (select-keys request [:yang.compile/request :yang.compile/unit\n   107\t                                         :yang.compile/provenance]))\n   108\t                 {:yang.compile/outcome :yang.compile/rejected\n   109\t                  :yang.compile/reason (if (= :yang.php/compile-error\n   110\t                                              (:yang.php/diagnostic diagnostic))\n   111\t                                         :yang.compile/invalid-source\n   112\t                                         :yang.compile/unsupported)\n   113\t                  :yang.compile/diagnostic diagnostic})\n   114\t          (throw e))))))\n   115\t\n   116\t\n   117\t(defn serve\n   118\t  \"Serve at most `budget` requests. Advance the immutable request cursor only\n   119\t   after its answer is appended, so a full response stream loses no request.\"\n   120\t  ([state] (serve state 32))\n   121\t  ([state budget]\n   122\t   (loop [state state, remaining budget]\n   123\t     (if (not (pos? remaining))\n   124\t       state\n   125\t       (let [read (or (:pending state)\n   126\t                      (let [item (stream/next (:requests state) (:cursor state))]\n   127\t                        (when (= :dao.stream/ok (:dao.stream/outcome item))\n   128\t                          {:cursor (:dao.stream/cursor item)\n   129\t                           :answer (compile-and-publish! state (:dao.stream/value item))})))]\n   130\t         (if read\n   131\t           (let [written (stream/append! (:responses state) (:answer read))]\n   132\t             (if (= :dao.stream/ok (:dao.stream/outcome written))\n   133\t               (recur (-> state (assoc :cursor (:cursor read)) (dissoc :pending))\n   134\t                      (dec remaining))\n   135\t               (assoc state :pending read)))\n   136\t           state))))))\n464:(defn profile-of\n1003:(defn source-origin\n1039:(def semantic-bytecode-grammar\n1193:               slots (or (get semantic-bytecode-grammar tag)\n1231:  (let [slots (get semantic-bytecode-grammar tag)\n1278:                    slots (or (get semantic-bytecode-grammar tag)\n1364:                          slots (get semantic-bytecode-grammar tag)]\n1404:        safe-slots (fn [tag] (get semantic-bytecode-grammar tag))\n1584:                 slots (get semantic-bytecode-grammar tag)\n1621:  (let [slots (get semantic-bytecode-grammar (semantic-bytecode-row-tag row))]\n1988:                                                            (profile-of\n2089:                                                            (profile-of\n61:(defn module-entry\n149:(defn resolve-module\n270:(defn host-export-profile\n25:(defn source-envelope\n31:  ([source-medium batch-token members]\n32:   (source-envelope source-medium batch-token members 0))\n33:  ([source-medium batch-token members root]\n35:                   :yin/batch-token batch-token\n42:     (vm/source-origin source-medium batch-token root)\n115:    (let [metadata (:frontend-metadata member)]\n117:        (throw (ex-info \"Supplied frontend-metadata is not a row sequence\"\n118:                        {:rule :frontend-metadata, :member-index member-index,\n123:       :frontend-metadata (vec (or metadata [])),\n141:  [{:yin/keys [source-medium batch-token batch root] :as envelope}]\n152:                                                            batch-token j)\n158:           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\n162:(defn project\n242:  \"The reserved frontend-metadata key of the call-site occurrence\n","exit_code":0,"status":"completed"}}
