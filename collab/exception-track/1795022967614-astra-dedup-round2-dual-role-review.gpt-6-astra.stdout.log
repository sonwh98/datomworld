{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '450,478p;993,1085p'\n nl -ba src/cljc/yin/vm/module.cljc | sed -n '55,80p;145,170p;265,300p'\n nl -ba src/cljc/yin/vm/encoder.cljc | sed -n '1,55p;135,180p'\n nl -ba src/cljc/yang/safepoint.cljc | sed -n '38,49p;65,112p'\n nl -ba src/cljc/yang/python/antlr/siteset.cljc | sed -n '400,488p'\n nl -ba src/cljc/yang/php/antlr/siteset.cljc | sed -n '260,298p'\"","aggregated_output":"   450\t  \"Portable projection of the standard registry, retained as a convenience.\"\n   451\t  (into {} (map (fn [[name entry]]\n   452\t                  [name (select-keys entry primitive-profile-keys)]))\n   453\t        primitives))\n   454\t\n   455\t\n   456\t(def primitive-canonical-names\n   457\t  \"Canonical-name declarations for intentional aliases in `primitives`.\n   458\t\n   459\t   The table is name -> canonical name, not function -> name, so it remains\n   460\t   plain portable data. `=` and `==` intentionally share one host function.\"\n   461\t  {'== '=})\n   462\t\n   463\t\n   464\t(defn profile-of\n   465\t  \"Return `name`'s published profile from a registry, or nil.\"\n   466\t  [registry name]\n   467\t  (when-let [entry (get registry name)]\n   468\t    (when (and (map? entry) (contains? entry :yin.k/profile))\n   469\t      (select-keys entry primitive-profile-keys))))\n   470\t\n   471\t\n   472\t(defn name-of\n   473\t  \"Reverse-look up `primitive` by host-object identity.\n   474\t\n   475\t   Returns nil when unnamed, `::ambiguous` when several names remain after\n   476\t   applying `canonical-names`, or the one resolved name. The two-argument\n   477\t   form declares no aliases.\"\n   478\t  ([primitive-map primitive]\n   993\t                      (plain-data? (nth origin 1))\n   994\t                      (some? (nth origin 2))\n   995\t                      (plain-data? (nth origin 2))\n   996\t                      (integer? (nth origin 3))\n   997\t                      (not (neg? (nth origin 3))))\n   998\t         :expansion (and (= 2 (count origin))\n   999\t                         (jing/segment-address? (nth origin 1)))\n  1000\t         false)))\n  1001\t\n  1002\t\n  1003\t(defn source-origin\n  1004\t  \"Construct and validate the source occurrence coordinate owned by a batch\n  1005\t   envelope. Throws with `:rule :origin` instead of allowing an incomplete\n  1006\t   coordinate to enter a provenance or frontend side table.\"\n  1007\t  [medium batch-token member-index]\n  1008\t  (let [origin [:source medium batch-token member-index]]\n  1009\t    (when-not (occurrence-origin? origin)\n  1010\t      (throw (ex-info \"Malformed source occurrence origin\"\n  1011\t                      {:rule :origin, :origin origin})))\n  1012\t    origin))\n  1013\t\n  1014\t\n  1015\t(defn loaded-code-floor\n  1016\t  \"The lowest entity id claimed by the segments in a `{segment-id image}`\n  1017\t   code map — each segment id minus its length — or 0 when none is loaded.\n  1018\t   A loader minting a fresh local segment id allocates below this floor\n  1019\t   (`semantic/load-ast` for projected AST batches, `semantic/load-vector`\n  1020\t   for canonical instruction vectors), so successive loads never collide\n  1021\t   with a live id.\"\n  1022\t  [code]\n  1023\t  (if (map? code)\n  1024\t    (reduce-kv (fn [floor seg image]\n  1025\t                 (if (and (integer? seg) (map? image))\n  1026\t                   (min floor (- seg (or (:length image) 0)))\n  1027\t                   floor))\n  1028\t               0\n  1029\t               code)\n  1030\t    0))\n  1031\t\n  1032\t\n  1033\t;; =============================================================================\n  1034\t;; Semantic bytecode: flat content-addressed rows\n  1035\t;; =============================================================================\n  1036\t;; docs/design/yin.vm.code-as-tuples.md §2. One row `[id tag & slots]` per\n  1037\t;; distinct node; `id` is `(jing/segment-key [tag & slots])`.\n  1038\t\n  1039\t(def semantic-bytecode-grammar\n  1040\t  \"The Universal AST row-slot table (yin.vm.code-as-tuples.md §2.3):\n  1041\t   tag -> ordered `[field kind]` slots, rather than executable bytecode. Position `i` of a\n  1042\t   row body (after the tag) holds the map field named at `i`, so this one\n  1043\t   table drives both projection and reconstruction.\"\n  1044\t  {:literal [[:value :data]],\n  1045\t   :variable [[:name :sym]],\n  1046\t   :lambda [[:params :syms] [:body :node]],\n  1047\t   :application [[:operator :node] [:operands :nodes] [:tail? :bool]],\n  1048\t   :if [[:test :node] [:consequent :node] [:alternate :node]],\n  1049\t   :dao.stream.apply/call [[:op :kw] [:operands :nodes]],\n  1050\t   :vm/gensym [[:prefix :str]],\n  1051\t   :vm/store-get [[:key :key]],\n  1052\t   :vm/store-put [[:key :key] [:val :data]],\n  1053\t   :vm/current-continuation [],\n  1054\t   :vm/park [],\n  1055\t   :vm/resume [[:parked-id :kw] [:val :node]],\n  1056\t   :stream/make [[:buffer :int]],\n  1057\t   :stream/put [[:target :node] [:val :node]],\n  1058\t   :stream/cursor [[:source :node]],\n  1059\t   :stream/next [[:source :node]],\n  1060\t   :stream/close [[:source :node]]})\n  1061\t\n  1062\t\n  1063\t(def ^:private semantic-bytecode-defaults\n  1064\t  \"§2.4 saturation: `[tag field]` -> the default written map→rows. rows→map\n  1065\t   never re-defaults; a nil in one of these slots is a defect.\"\n  1066\t  {[:vm/gensym :prefix] \"id\",\n  1067\t   [:stream/make :buffer] default-stream-capacity,\n  1068\t   [:application :tail?] false,\n  1069\t   [:application :operands] [],\n  1070\t   [:dao.stream.apply/call :operands] []})\n  1071\t\n  1072\t\n  1073\t(defn- strip-symbol-meta\n  1074\t  \"§2.5: reader metadata on names is frontend metadata, not content.\"\n  1075\t  [x]\n  1076\t  (if (symbol? x) (with-meta x nil) x))\n  1077\t\n  1078\t\n  1079\t(defn- strip-reader-positions\n  1080\t  \"§2.5: reader source positions are provenance, not content. Removes\n  1081\t   `:line`/`:column`/`:end-line`/`:end-column` from metadata at every depth\n  1082\t   of a `data`/`key` payload, including inside metadata maps and their own\n  1083\t   metadata, keeping all other metadata and every collection\n  1084\t   type. `dao.jing` already leaves these keys out of the address; this keeps\n  1085\t   them out of the row body too.\"\n    55\t                           path)))\n    56\t      (when-let [child (get node (first path))]\n    57\t        (walk-path child (rest path))))\n    58\t    node))\n    59\t\n    60\t\n    61\t(defn module-entry\n    62\t  \"The registry entry of module `module-name` in `modules` (a registry's\n    63\t   `:modules` map), or nil when the dotted path reaches no module entry.\"\n    64\t  [modules module-name]\n    65\t  (let [node (reduce (fn [node seg] (when (map? node) (get node seg)))\n    66\t                     modules\n    67\t                     (symbol->path module-name))]\n    68\t    (when (and (map? node) (contains? node :manifest)) node)))\n    69\t\n    70\t\n    71\t(defn assoc-module\n    72\t  \"Return registry with `entry` installed as module `module-name`.\"\n    73\t  [registry module-name entry]\n    74\t  (let [registry (or registry (empty-registry))\n    75\t        path (into [:modules] (symbol->path module-name))\n    76\t        children (into {} (filter (comp symbol? key)) (get-in registry path))]\n    77\t    (assoc-in registry path (merge children entry))))\n    78\t\n    79\t\n    80\t(defn link-module\n   145\t       :pinned pinned,\n   146\t       :linked address})))\n   147\t\n   148\t\n   149\t(defn resolve-module\n   150\t  \"Get a value from a registry value by dotted symbol path.\n   151\t   (resolve-module r 'io)                    → the 'io registry entry\n   152\t   (resolve-module r 'io.file-output-stream) → the specific export\"\n   153\t  [registry sym]\n   154\t  (walk-path (:modules registry) (symbol->path sym)))\n   155\t\n   156\t\n   157\t(defn register-effect-handler\n   158\t  \"Return registry with handler-fn installed for effect keyword kw.\n   159\t   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\"\n   160\t  [registry kw handler-fn]\n   161\t  (assoc-in (or registry (empty-registry)) [:effect-handlers kw] handler-fn))\n   162\t\n   163\t\n   164\t(defn get-effect-handler\n   165\t  \"Get the handler function for an effect keyword.\"\n   166\t  [registry kw]\n   167\t  (get (:effect-handlers registry) kw))\n   168\t\n   169\t\n   170\t(defn list-modules\n   265\t                 :derivation nil,\n   266\t                 :slice fns,\n   267\t                 :stores {}})))\n   268\t\n   269\t\n   270\t(defn host-export-profile\n   271\t  \"The profile address host module `ns` publishes for export `name`, when\n   272\t   `qualified-sym` is `ns/name` and `registry` holds `ns` as a\n   273\t   host-registered entry (`register-host-module`'s shape, `:address`\n   274\t   nil); else nil. A linked entry never answers: the\n   275\t   `:yin.module/primitives` of a fetched manifest are the primitives that\n   276\t   module assumes, not exports it provides.\"\n   277\t  [registry qualified-sym]\n   278\t  (when (and (symbol? qualified-sym) (some? (namespace qualified-sym)))\n   279\t    (let [entry (module-entry (:modules registry)\n   280\t                              (symbol (namespace qualified-sym)))]\n   281\t      (when (and (some? entry) (nil? (:address entry)))\n   282\t        (get-in entry [:manifest :yin.module/primitives\n   283\t                       (symbol (name qualified-sym))])))))\n   284\t\n   285\t\n   286\t;; =============================================================================\n   287\t;; Effect descriptors\n   288\t;; =============================================================================\n   289\t\n   290\t;; An effect is the host type `yin.vm.effect/Effect` (D4): `effect?` is a\n   291\t;; type test, and a map is data whatever keys it carries. `make-effect` is\n   292\t;; the trusted constructor for host code; it is never a guest primitive or\n   293\t;; module export.\n   294\t\n   295\t(def effect?\n   296\t  \"True when a value is an effect minted by `make-effect`.\"\n   297\t  effect/effect?)\n   298\t\n   299\t\n   300\t(def make-effect\n     1\t(ns yin.vm.encoder\n     2\t  \"The encoder observer: the `run-on-stream` consumer the composition\n     3\t   attaches over the program medium so the semantic VM never sees a map AST\n     4\t   or a datom batch (§9.1, `docs/design/yin.vm.code-as-tuples.md`).\n     5\t\n     6\t   It is a stage in its own right, not a loader arm. The composition hands\n     7\t   its session the row medium's writer as the consumer; `run-on-stream`\n     8\t   hands it each observed program batch; it projects the batch to the\n     9\t   canonical row set and forwards it — appends it to the row medium. The\n    10\t   evaluator observer the composition attaches to that row medium\n    11\t   independently is the next stage: the two never call each other, they\n    12\t   communicate through the row medium alone, so compiler and evaluator stay\n    13\t   independently attachable (no direct function-to-function coupling\n    14\t   without a stream boundary).\n    15\t\n    16\t   Projection is this boundary's one job (§9.1): the map AST the frontends\n    17\t   emit projects directly through `yin.vm/ast->semantic-bytecode`; a\n    18\t   `:yin/*` datom batch projects through the explicit datom→row adapter\n    19\t   below — §7.1's projection path, for media that carry datoms.\"\n    20\t  (:require [dao.stream :as stream]\n    21\t            [dao.stream.observer :as observer]\n    22\t            [yin.vm :as vm]))\n    23\t\n    24\t\n    25\t(defn source-envelope\n    26\t  \"Construct the provenance-bearing input value ruled by D4. The admitting\n    27\t   composition supplies its program medium's logical identity and mints a\n    28\t   fresh batch token before append. `members` is ordered and `root` selects\n    29\t   the member the evaluator runs. The constructor validates but never mints:\n    30\t   retries of an unaccepted staged append must retain the caller's token.\"\n    31\t  ([source-medium batch-token members]\n    32\t   (source-envelope source-medium batch-token members 0))\n    33\t  ([source-medium batch-token members root]\n    34\t   (let [envelope {:yin/source-medium source-medium\n    35\t                   :yin/batch-token batch-token\n    36\t                   :yin/batch (vec members)\n    37\t                   :yin/root root}]\n    38\t     ;; Validating the root origin validates the two opaque coordinates too.\n    39\t     (when-not (and (integer? root) (<= 0 root) (< root (count members)))\n    40\t       (throw (ex-info \"Malformed source batch envelope\"\n    41\t                       {:rule :batch-envelope, :envelope envelope})))\n    42\t     (vm/source-origin source-medium batch-token root)\n    43\t     envelope)))\n    44\t\n    45\t\n    46\t(defn- datom-child-places\n    47\t  [get-attr eid]\n    48\t  (case (get-attr eid :yin/type)\n    49\t    :lambda [[3 (get-attr eid :yin/body)]]\n    50\t    :application (concat [[2 (get-attr eid :yin/operator)]]\n    51\t                         (map-indexed (fn [i child] [[3 i] child])\n    52\t                                      (get-attr eid :yin/operands)))\n    53\t    :if [[2 (get-attr eid :yin/test)]\n    54\t         [3 (get-attr eid :yin/consequent)]\n    55\t         [4 (get-attr eid :yin/alternate)]]\n   135\t    (throw (ex-info \"Unsupported source batch member\"\n   136\t                    {:rule :batch-member, :member member,\n   137\t                     :member-index member-index}))))\n   138\t\n   139\t\n   140\t(defn- project-envelope\n   141\t  [{:yin/keys [source-medium batch-token batch root] :as envelope}]\n   142\t  (when-not (and (vector? batch)\n   143\t                 (seq batch)\n   144\t                 (integer? root)\n   145\t                 (<= 0 root)\n   146\t                 (< root (count batch)))\n   147\t    (throw (ex-info \"Malformed source batch envelope\"\n   148\t                    {:rule :batch-envelope, :envelope envelope})))\n   149\t  (let [projected (mapv (fn [j member]\n   150\t                          (project-member member\n   151\t                                          (vm/source-origin source-medium\n   152\t                                                            batch-token j)\n   153\t                                          j))\n   154\t                        (range) batch)]\n   155\t    (assoc envelope\n   156\t           :yin/batch (mapv :tree projected)\n   157\t           :yin/source-positions (into [] (mapcat :source-positions) projected)\n   158\t           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\n   159\t           :yin/entity-occurrences (into [] (mapcat :entity-occurrences) projected))))\n   160\t\n   161\t\n   162\t(defn project\n   163\t  \"One program-medium batch to its canonical row set `{:root id, :rows …}`\n   164\t   (§6.1). A batch that is neither a map AST nor a datom batch is a defect\n   165\t   of the medium and throws here, at the boundary, naming where it failed.\"\n   166\t  [batch]\n   167\t  (cond\n   168\t    (and (map? batch) (contains? batch :yin/batch))\n   169\t    (project-envelope batch)\n   170\t\n   171\t    (map? batch) (vm/ast->semantic-bytecode batch)\n   172\t    :else (datoms->rows batch)))\n   173\t\n   174\t\n   175\t;; =============================================================================\n   176\t;; The macro expander's input batch (yin.vm.macro.md §2.1, §10.2)\n   177\t;; =============================================================================\n   178\t\n   179\t(defn- definition-name\n   180\t  \"The name of a `(yin/def <literal-symbol> val