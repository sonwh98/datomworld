1)))\nsrc/cljc/yin/vm/debruijn_register_effects.cljc:352:                                         (vm/machine-data? frames))\nsrc/cljc/yin/vm/debruijn_register_effects.cljc:404:                      (when-not (vm/machine-data? (:datom entry))\nsrc/cljc/yin/vm/debruijn_register_effects.cljc:433:                            (when-not (vm/machine-data? (apply2/request-args req))\ntest/yang/php/antlr/include_test.clj:2:  \"P6 S1-S5: linked inclusion, dynamic scope, namespaces, constants and the\ntest/yang/php/antlr/include_test.clj:3:   autoload class map. Linked fixtures run on the three vector VMs (the AST\ntest/yang/php/antlr/include_test.clj:40:  [fixture]\ntest/yang/php/antlr/include_test.clj:41:  (lh/run-fixture (parse-units fixture) \"main.php\"\ntest/yang/php/antlr/include_test.clj:42:                  {:computed? (:computed fixture), :class-map (:class-map fixture)}))\ntest/yang/php/antlr/include_test.clj:45:(deftest ^:slow p6-fixtures-linked-on-every-vm-test\ntest/yang/php/antlr/include_test.clj:46:  (doseq [{:keys [id out diag uncaught warnings oracle] :as fixture} p6/enabled\ntest/yang/php/antlr/include_test.clj:47:          :when (contains? fixture :out)\ntest/yang/php/antlr/include_test.clj:48:          :let [r (try (run fixture)\ntest/yang/php/antlr/include_test.clj:63:    (doseq [[label fixture expected-sites]\ntest/yang/php/antlr/include_test.clj:72:        (let [units (parse-units fixture)\ntest/yang/php/antlr/include_test.clj:78:              result (run fixture)]\ntest/yang/php/antlr/include_test.clj:167:  (let [fixture (some #(when (= :ns-use-function-const (:id %)) %) p6/enabled)\ntest/yang/php/antlr/include_test.clj:168:        result (run fixture)]\ntest/yang/php/antlr/include_test.clj:169:    (is (some? fixture))\ntest/yang/php/antlr/include_test.clj:184:  (testing \"an include inside a function lowers (the dynamic-scope profile)\"\ntest/yang/php/antlr/include_test.clj:198:        linked (lh/run-fixture {\"main.php\" (cst/parse-source src)})]\n",