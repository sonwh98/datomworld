with the value, so it must be plain data too.\"\n  [x]\n  (or (nil? x)\n      (and (cond (or (boolean? x) (number? x) (cbor/float64? x) (string? x)\n                     (keyword? x) (symbol? x))\n                 true\n                 (map? x) (and (every? plain-data? (keys x))\n                               (every? plain-data? (vals x)))\n                 (coll? x) (every? plain-data? x)\n                 :else false)\n           (plain-data? (meta x)))))\n\n\n(defn machine-data?\n  \"`plain-data?` for a value inside a machine payload: a closure or a\n   continuation, a host type only a kernel mints, counts as its payload,\n   as the plain map it was before D7. Rows and code datoms stay\n   `plain-data?`, plus the exact-integer big carriers (ruling 4).\"\n  [x]\n  #?(:clj\n     (let [seen (java.util.IdentityHashMap.)]\n       (letfn [(check\n                 [v]\n                 (cond\n                   (nil? v) true\n                   (.containsKey seen v) (= :valid (.get seen v))\n                   :else\n                   (do (.put seen v :visiting)\n                       (let [valid? (if (values/host-typed? v)\n                                      (check (values/payload v))\n                                      (and (cond (or (boolean? v) (number? v)\n                                                     (integer-host/big-carrier? v) (cbor/float64? v)\n                                                     (string? v) (keyword? v) (symbol? v)) true\n                                                 (map? v) (and (every? check (keys v))\n                                                               (every? check (vals v)))\n                                                 (coll? v) (every? check v)\n                                                 :else false)\n                                           (check (meta v))))]\n                         (.put seen v (if valid? :valid :invalid))\n                         valid?))))]\n         (check x)))\n    