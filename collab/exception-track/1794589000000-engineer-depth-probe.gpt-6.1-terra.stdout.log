{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '970,1060p;2500,2555p' test/yang/clojure_test.clj && rg -n 'defn run-linked|def backends|defn .*linked' test/yang/typescript/antlr/linked_harness* && cat docs/agents/build-n-test.md | head -100 && git branch -avv | head -25\"","aggregated_output":"                 (get-in a [:operator :name])\n                 (get-in a [:operator :type]))\n               (boolean (:tail? a))]))))\n\n\n(deftest test-loop-tail-audit\n  (let [form '(loop [i 0] (if (< i 3) (recur (+ i 1)) i))]\n    (testing \"exactly the let chain, the initial application and the recur are tail\"\n      (is (= {[:lambda true] 2        ; initializer let, worker-binding let\n              ['dsg__loop0 true] 2    ; initial application, recur\n              ['< false] 1            ; the test\n              ['+ false] 1}           ; a recur operand is never tail\n             (frequencies (applications (yang/compile form))))))\n    (testing \"a loop in operand position is not itself tail; its recur still is\"\n      (is (= {[:lambda false] 2, ['dsg__loop0 false] 1, ['dsg__loop0 true] 1\n              ['< false] 1, ['+ false] 1}\n             (frequencies (applications (yang/compile-form form false {}))))))))\n\n\n;; --- continuation-depth gates -----------------------------------------------\n\n(defn- walker-depth\n  \"Length of the :next chain from the VM's k.\"\n  [vm]\n  (loop [k (vm/continuation vm), n 0]\n    (if k (recur (:next k) (inc n)) n)))\n\n\n(defn- semantic-depth\n  [vm]\n  (count (vm/continuation vm)))\n\n\n(defn- stepper\n  \"A run function stepping the VM one instruction at a time, recording the\n   maximum depth `depth-of` reports in :max-depth.\"\n  [depth-of]\n  (fn [vm]\n    (loop [v vm, mx (depth-of vm)]\n      (if (or (vm/halted? v) (vm/blocked? v))\n        (assoc v :max-depth mx)\n        (let [v' (vm/step v)]\n          (recur v' (max mx (depth-of v'))))))))\n\n\n(defn- walker-run\n  \"[value max-depth] of `ast` on the walker lane.\"\n  [ast]\n  (let [session (-> (tu/make-observer-session (tu/create-vm {:modules av-modules}))\n                    (tu/queue-ast! ast))\n        done (observer/run-on-stream\n               session engine/ready-for-ingress?\n               (vm/fresh-code-loader ast-walker/vm-load-program vm/ast-contract)\n               (stepper walker-depth))]\n    [(vm/value (:consumer done)) (:max-depth (:consumer done))]))\n\n\n(defn- semantic-run\n  \"[value max-depth] of `ast` on the semantic lane.\"\n  [ast]\n  (let [session (tu/make-encoder-session\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret\n                                       :modules av-modules}))\n        load-rows (vm/fresh-code-loader\n                    (fn [machine rows stamp]\n                      (vm/check-contract! vm/ast-contract stamp)\n                      (semantic/load-vector\n                        machine\n                        (:vector (if (contains? rows :yin/batch)\n                                   (linearize/project-rows\n                                     (nth (:yin/batch rows) (:yin/root rows))\n                                     (vm/source-origin (:yin/source-medium rows)\n                                                       (:yin/batch-token rows)\n                                                       (:yin/root rows)))\n                                   (linearize/project-rows rows)))\n                        vm/semantic-contract))\n                    vm/ast-contract)]\n    (stream/append! (:program session) ast)\n    (let [encoded (assoc session :encoder (encoder/forward-on-stream (:encoder session)))\n          done (observer/run-on-stream (:evaluator encoded) engine/ready-for-ingress?\n                                       load-rows (stepper semantic-depth))]\n      [(vm/value (:consumer done)) (:max-depth (:consumer done))])))\n\n\n(defn- countdown-ast\n  \"A program counting down from n through a loop or a function-level recur,\n   in tail position or as an operand of conj.\"\n  [kind n shape]\n  (let [form (walk/postwalk-replace\n               {'N n}\n                          :else (recur (vm/step v) (inc n)))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-machine-depth\n  \"Like run-guest-machine, but records the maximum continuation depth\n   (the semantic lane's K-vector length, or the walker lane's :next chain\n   length) across the run, and returns the terminal machine with the max\n   depth attached under `:max-depth`.\"\n  [ast modules lane step-limit]\n  (let [depth-of (if (= lane :semantic) semantic-depth walker-depth)\n        run-bounded (fn [machine]\n                      (loop [v machine, n 0, mx (depth-of machine)]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) (assoc v :max-depth mx)\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n :consumer v}))\n                          :else (let [v' (vm/step v)]\n                                  (recur v' (inc n) (max mx (depth-of v')))))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-ast\n  \"The value from run-guest-machine; shared by library and oracle fixtures.\"\n112:(def backends\n177:(defn run-linked\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# When a test fails, reproduce and fix it by running ONLY the failing test\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01;\n# for a fix branch, the previously-failing tests green IS the merge bar\n# (owner ruling 2026-11-07; see Gate Ladder G0).\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n# overlap lanes, see \"Remote test servers\" below).\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\nnpm test             # Node.js tests\n\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n                         # and the linker L5 Node reader that requires a module\n                         # by name): `clojure -M:test` without it fails that test\n```\n\n### Changed-only tests: `bb test:changed`\n\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\nreach: the reverse require closure of the files changed since the\nmerge-base with master, plus fixtures that mention a changed resource path,\ntests that walk a changed tree, and each src file's `_test` by convention.\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\nfs/walk-file-tree or .listFiles; each string literal argument of its\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\n(let-bound roots count), and a change under a root selects it. The three\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\nland a slice confined to a package. Exit 2 (from :list too) is a wide\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\nas for a change to the core everything requires (yin.vm engine,\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\n  agent.tzu.postgraphics                             471ff5e3 feat(tzu): add illustration protocol and remove iteration cap\n+ ble-track2                                         c0e2f8d4 (/Users/sto/workspace/datomworld-ble2) feat(dao.stream.ble): BLE radio transport and flooding mesh — raw layer, link machine, dart seam\n  c4-i5                                              51117e93 [origin/c4-i5: ahead 17, behind 3] fix(yang.python.antlr): injectable publish seam in publish-units!, drop with-redefs\n  c4-i6                                              39774640 test(yang.python.antlr): re-mint the pysp manifest golden for the I6 prelude profile bump\n  c4-i6-r4                                           a53762b2 [origin/c4-i6-r4: ahead 60, behind 2] docs(orchestrator-log): C3-S2 closure (already landed be1f8d06); the stale worktree removed\n+ callsite-contract-clojure                          847aa885 (/Users/sto/workspace/datomworld-cc1) [origin/callsite-contract-clojure: behind 59] fix(yang.clojure): construction-threaded occurrence origins from retained expansion history (cc1 fix round 5, ruling U1)\n+ callsite-ts-adoption                               5fd6e20d (/Users/sto/workspace/datomworld-callsite) test(yang.typescript): freeze the reviewed root pin at the sol-APPROVED value (step-7 r2); Node/Dart lanes must now meet the frozen baseline\n+ cc2-transform-session-c1                           a1133cbe (/Users/sto/workspace/datomworld-cc2) [origin/master: behind 134] fix(yang.clojure): cc2 r3+r4 — admission pairing from commit evidence, wrapper provenance from assembly\n  cc3-lowering-provenance                            897786cf [origin/master: behind 118] fix(yang.clojure): cc3 r7-r11 — recovery trusts only shell-owned retention state\n  dao.stream-redesign                                0dcd3f9c docs(design): articulate stigmergic coordination and adapter value contracts\n  dao.stream.whatsapp                                d2532b10 [origin/dao.stream.whatsapp] Refactor dao.stream.whatsapp to use self-hosted gateway with Baileys\n  dht-import-regen-test                              bcf5a3a8 test(yang.python): regenerate dht-import-v1.edn and align dht-import-test for statement-time imports\n* exception-depth-probe                              56cc5ca3 [origin/master] docs(exception-track): relay to mastergreen (dartfix2 stop + stash ownership) and relay to yang.clojure (salvage stash holds their callsite edit) — recreated as -r2 after the originals vanished untracked\n  exception-js-r1r3                                  40284c15 test(yang.typescript): re-derive the float-address pins for the JS R1+R3 boundary round\n+ exception-kit-finally                              a429a3eb (/Users/sto/workspace/datomworld-kitfinally) [origin/exception-kit-finally] test(exception-kit): seed PHP identity payloads after shutdown\n+ exception-php-r1r2r3                               20cb8d7d (/Users/sto/workspace/datomworld-phpexc) [origin/exception-php-r1r2r3] docs(collab): the PHP R1+R2+R3 round record — r1-r12 trail, shiva acceptance (33 rows red->green), reviewer re-routing, and the lane findings for the steward\n  exception-py-r2r3                                  428bbdd7 [origin/exception-py-r2r3] test(yin.vm.semantic): regenerate the :c4 :py scanner pins for the provenance adoption\n  exception-r0                                       5f99d070 docs(collab): the handoff ADDENDUM — the deltas since the handoff (the exception track owed R3/R4, the cc1 fix chain state, the float pins, the jolt arc, the dao.stream relay, the Xcode event, the H3-6 audit reassignment) — written so a fresh session resumes seamlessly\n+ exception-r3                                       b1b9abae (/Users/sto/workspace/datomworld-r3) Merge remote-tracking branch 'origin/callsite-contract-clojure' into HEAD\n  exception-r3-impl                                  854b74c3 [origin/exception-r3-impl] test(yang.clojure): reconstruct oracle registry at quiescence\n  f1-importers-diagnosis                             da883518 docs(collab): the attribution-as-query ruling DRAFT v4 — kimi k3.1-pro's four amendments incorporated\n  f1-importers-diagnosis-r2                          7ab37566 docs(collab): reply to the yang.clojure seat — the per-frontend equality-gate scope adopted for the php/ts adoption rounds\n+ f12-diagnosis-fixes                                a6f74280 (/private/tmp/dw-f12) test(yin.repl.python-antlr): the compile-contract packet added — the cst stage parses from precompiled packets, the new source had none\n  feat/p1-forward-fixes                              d5f120d0 [origin/master: behind 352] fix(yang.php): the shutdown escape and buffer-drain placement\n  feat/p5-oracle-recording                           a7cf7a0f [origin/master: behind 398] fix(yang.php): the P5 fold comparisons and runner records\n","exit_code":0,"status":"completed"}}
