eturn true;\\\\n    } finally {\\\\n        try {\\\\n            throw new NotExists();\\\\n        } catch (Exception $e) {\\\\n        }\\\\n    }\\\\n}\\\\n\\\\n$bar = foo3();\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3178:   :title \\\"Fixed Bug #65784 (Segfault with finally)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3225:   \\\"<?php\\\\nfunction bar() {\\\\n    try {\\\\n        echo \\\\\\\"1\\\\\\\\n\\\\\\\";\\\\n        try {\\\\n        } finally {\\\\n            try {\\\\n            } finally {\\\\n            }\\\\n            echo \\\\\\\"2\\\\\\\\n\\\\\\\";\\\\n        }\\\\n    } finally {\\\\n        try {\\\\n            throw new Exception (\\\\\\\"\\\\\\\");\\\\n        } catch (Exception $ab) {\\\\n            echo \\\\\\\"3\\\\\\\\n\\\\\\\";\\\\n        } finally {\\\\n            try {\\\\n            } finally {\\\\n                echo \\\\\\\"4\\\\\\\\n\\\\\\\";\\\\n                try  {\\\\n                } finally {\\\\n                }\\\\n                echo \\\\\\\"5\\\\\\\\n\\\\\\\";\\\\n            }\\\\n        }\\\\n        echo \\\\\\\"6\\\\\\\\n\\\\\\\";\\\\n        try {\\\\n        } finally {\\\\n            while (1) {\\\\n                try {\\\\n                    echo \\\\\\\"7\\\\\\\\n\\\\\\\";\\\\n                    break;\\\\n                } finally {\\\\n                    echo \\\\\\\"8\\\\\\\\n\\\\\\\";\\\\n                }\\\\n                echo \\\\\\\"bad\\\\\\\";\\\\n            }\\\\n            echo \\\\\\\"9\\\\\\\\n\\\\\\\";\\\\n            while (1) {\\\\n                try {\\\\n                    throw new Exception(\\\\\\\"\\\\\\\");\\\\n                } catch(Exception $e) {\\\\n                    echo \\\\\\\"10\\\\\\\\n\\\\\\\";\\\\n                    break;\\\\n                } finally {\\\\n                    echo \\\\\\\"11\\\\\\\\n\\\\\\\";\\\\n                }\\\\n                echo \\\\\\\"bak\\\\\\\\n\\\\\\\";\\\\n            }\\\\n        }\\\\n        echo \\\\\\\"12\\\\\\\\n\\\\\\\";\\\\n    }\\\\n    echo \\\\\\\"13\\\\\\\\n\\\\\\\";\\\\n}\\\\nbar();\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3227:   \\\"Bug #66608 (Incorrect behavior with nested \\\\\\\"finally\\\\\\\" blocks)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3726:   \\\"<?php\\\\ntry {\\\\n    echo \\\\\\\"Outer try\\\\\\\\n\\\\\\\";\\\\n    try {\\\\n        echo \\\\\\\"  Middle try\\\\\\\\n\\\\\\\";\\\\n        throw new Exception();\\\\n    } finally {\\\\n        echo \\\\\\\"  Middle finally\\\\\\\\n\\\\\\\";\\\\n        try {\\\\n            echo \\\\\\\"    Inner try\\\\\\\\n\\\\\\\";\\\\n        } finally {\\\\n            echo \\\\\\\"    Inner finally\\\\\\\\n\\\\\\\";\\\\n        }\\\\n    }\\\\n    echo \\\\\\\"Outer shouldn't get here\\\\\\\\n\\\\\\\";\\\\n} catch (Exception $e) {\\\\n    echo \\\\\\\"Outer catch\\\\\\\\n\\\\\\\";\\\\n} finally {\\\\n    echo \\\\\\\"Outer finally\\\\\\\\n\\\\\\\";\\\\n}\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3727:   :title \\\"Bug #70012 (Exception lost with nested finally block)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3729:   \\\"Outer try\\\\n  Middle try\\\\n  Middle finally\\\\n    Inner try\\\\n    Inner finally\\\\nOuter catch\\\\nOuter finally\\\",\\ntest/yang/php/antlr/phpt_selection.edn:3998:   \\\"<?php\\\\ntry {\\\\n    $e = new Exception(\\\\\\\"Foo\\\\\\\");\\\\n    try {\\\\n        throw  new Exception(\\\\\\\"Bar\\\\\\\", 0, $e);\\\\n    } finally {\\\\n        throw $e;\\\\n    }\\\\n} catch (Exception $e) {\\\\n    var_dump((string)$e);\\\\n}\\\\n\\\\ntry {\\\\n    $e = new Exception(\\\\\\\"Foo\\\\\\\");\\\\n    try {\\\\n        throw new Exception(\\\\\\\"Bar\\\\\\\", 0, $e);\\\\n    } finally {\\\\n        throw new Exception(\\\\\\\"Dummy\\\\\\\", 0, $e);\\\\n    }\\\\n} catch (Exception $e) {\\\\n    var_dump((string)$e);\\\\n}\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4000:   \\\"Bug #70944 (try{ } finally{} can create infinite chains of exceptions)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4354:   \\\"<?php\\\\nfunction test() {\\\\n    try {\\\\n        return 5;\\\\n    } finally {\\\\n        try {\\\\n            echo 1;\\\\n        } finally {\\\\n            echo 2;\\\\n        }\\\\n    }\\\\n}\\\\n\\\\n\\\\n\\\\n$a = test();\\\\nif($a !== 5) {\\\\n    echo \\\\\\\"FAILED: expected 5, received \\\\\\\", var_export($a), PHP_EOL;\\\\n} else {\\\\n    echo \\\\\\\"Passed\\\\\\\", PHP_EOL;\\\\n}\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4355:   :title \\\"Bug #72188 (Nested try/finally blocks losing return value)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4360:   \\\"<?php\\\\nfunction test() {\\\\n    $a = 1;\\\\n    try {\\\\n        return $a;\\\\n    } finally {\\\\n        $a = 2;\\\\n    }\\\\n}\\\\nvar_dump(test());\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4361:   :title \\\"Bug #72215 (Wrong return value if var modified in finally)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4372:   \\\"<?php\\\\nfunction test() : int {\\\\n    $d = 1.5;\\\\n    try {\\\\n        return $d;\\\\n    } finally {\\\\n        var_dump($d);\\\\n    }\\\\n}\\\\nvar_dump(test());\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:4373:   :title \\\"Bug #72347 (VERIFY_RETURN type casts visible in finally)\\\",\\ntest/yang/php/antlr/phpt_selection.edn:7162:   \\\"<?php\\\\nfunction test() {\\\\n    try {\\\\n        $a = [1, 2, 3];\\\\n        return $a + [];\\\\n    } finally {\\\\n        throw new Exception;\\\\n    }\\\\n}\\\\n\\\\ntry {\\\\n    test();\\\\n} catch (Exception $e) {\\\\n    echo \\\\\\\"exception\\\\\\\\n\\\\\\\";\\\\n}\\\\n?>\\\",\\ntest/yang/php/antlr/phpt_selection.edn:7163:   :title \\\"Live range & throw from finally\\\",\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794553000000-engineer-port-phase4-green.gpt-6.1-terra.stdout.log:16:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '3838,3930p' docs/design/yang.antlr.md\\\"\",\"aggregated_output\":\"#### 8.10.7 Normal return and escaping conditions\\n\\nNormal return is the value of ordinary Yin application. There is no\\nextra return continuation, completion packet around each result, or new\\nlanguage-specific return instruction.\\n\\nAn escaping source exception invokes the supplied raise exit with:\\n\\n```clojure\\n{:yang.call/reason :yang.call/thrown\\n :yang.call/value  original-thrown-value}\\n```\\n\\nThis is the argument to an exceptional continuation transfer, not an\\nordinary return. Returning an identical-looking map returns normal data.\\nLikewise, a source program throwing a map with these keys throws that\\nmap as the **payload of a new condition**; its shape is never evidence\\nthat it is already a condition to forward. No engine-effect value is\\nsynthesized.\\n\\nProtocol failures use qualified reasons such as\\n`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\\n`:yang.call/unsupported-binding`, with plain evidence. The caller maps\\nthem to a documented local exception form retaining the complete\\noriginal condition. Callee argument-binding failures retain the actual\\ncallee exception under `:yang.call/thrown`. These reasons do not extend\\n`dao.stream`'s outcome algebra.\\n\\nThe receiving caller interprets an escaping exception as follows:\\n\\n1. A payload valid as an exception in its own runtime retains that\\n   runtime's ordinary catching and identity behavior.\\n2. A runtime permitting arbitrary thrown values, such as JavaScript,\\n   may deliver the original payload directly.\\n3. A runtime requiring exception objects, such as Python or PHP,\\n   represents an otherwise foreign payload with its own\\n   `ForeignException`, retaining the complete condition and original\\n   payload. Catch-all catches this local object. Typed source catches\\n   match its local hierarchy, never guessed foreign class names.\\n\\n`ForeignException` is a proposed prelude-owned type, not a VM type.\\nUnchanged rethrow propagates the original condition without adding\\nwrappers. Raising a new exception creates a new condition. Crossing back\\ninto a runtime recognizing the original exception restores its original\\ntype and identity. Formatting a foreign payload must not implicitly\\ninvoke a foreign method.\\n\\nThe runtime associates its generated wrapper's identity with the retained\\ncondition for the wrapper's entire lifetime, separate from source-writable\\nattributes. The association normally lives in private wrapper-cell\\ncontents, or an equivalent task-owned identity structure with the same\\nlifetime. It survives storing or returning the wrapper after the creating\\ncall/catch activation has ended, and remains recoverable when that same\\nwrapper is rethrown in another activation. Temporary catch state alone is\\ninsufficient. Reachability/reclamation must retain the condition and its\\npayload while the wrapper is live, without an ambient registry.\\n\\nThe runtime must not detect wrappers or unwrap arbitrary maps by their\\nkey names. JavaScript may expose raw payloads for\\n`:yang.call/thrown`; its local exception for a protocol failure must still\\nretain that failure's qualified condition. Rethrowing the same generated\\nexception forwards that complete condition, including protocol reasons;\\nthrowing an unrelated value creates a new `:yang.call/thrown` condition.\\nSaved activation state refers to this identity-owned association; exiting\\nor restoring a catch does not destroy it.\\n\\nVM application/custody defects and host implementation failures remain\\noperational failures. Do not catch them broadly and relabel them as\\nsource exceptions. Existing explicit stream/module refusals keep their\\nsource mappings under the relevant profiles.\\n\\n#### 8.10.8 Cleanup, re-entry, and suspension\\n\\nEach activation establishes its own exception bridge and saves its\\ncallee runtime's dynamic context. Binding, body, and exit run under that\\nbridge. Before invoking the caller's raise exit, let source catches and\\ncleanup complete and restore saved handler/depth/frame state. Normal\\nreturn restores it too. A source `finally` replacing a pending return\\nor exception does so before common propagation under its own rules.\\n\\nIn A-to-B-to-A calls, the innermost activation must not jump to an older\\nA handler past B. Its entry bridge is the boundary: inner A cleanup\\nprecedes B cleanup, which precedes outer A handling. Every activation\\nowns its saved state and raise exit, without a single current-foreign-\\nhandler cell or ambient dispatcher. Unchanged rethrow preserves the\\ninner exception as specified in section 8.10.7.\\n\\nCleanup runs once per actual exit. Resuming a suspended VM transition\\nmust not repeat parameter binding, argument evaluation, defaults,\\nreference acquisition, or completed cleanup. The record, continuations,\\nand explicit runtime state use the existing continuation machinery and\\nits admission restrictions.\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794553000000-engineer-port-phase4-green.gpt-6.1-terra.stdout.log:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git log --oneline -15'\",\"aggregated_output\":\"6adb9b94 Record pre-port kernel-gate depth baseline\\n8456c2e9 feat(yang.clojure): port Phase 3r — kernel-gate corpus off the outcome model + depth harness\\n8e1dab6d feat(yang.clojure): port phase 2 — the continuation lane (consumer wiring)\\n99f43131 feat(yang.clojure): port phase 1 — the continuation family in the clj prelude\\nf29191fb fix(yin.vm): remove the :retained cell seam per owner NO (decision 1794372000000)\\n9c10d2ca fix(yang.clojure): raw ordinary payloads, heap-retained protocol wrapper (R3 (A))\\n7d7fc0b3 fix(yang.clojure): caught payload identity — guest operations observe the visible value, not the wrapper (R3)\\n0fa9fe0e fix(yang.clojure): generated exception wrapper — provenance outside the condition map (R3 review fixes)\\n9811faca fix(yang.clojure): token-authenticate retained-condition provenance; guard strip-top-outcome for non-outcome units (R3)\\n7c1be750 fix(yang.clojure): protocol conditions retain and forward unchanged through the public escape (R3)\\nb134207f docs(collab): the P3 follow-ups merged (fea3adb4) — F1 shape-check + first malformed-condition pin, F2 export audit, F3 comment honestly corrected by the round; gate 15/234/0; a third silent-revert incident recorded with the standing-rule extension\\nfea3adb4 docs(scanner): correct deferred group guidance\\nb8fe4b84 test(python): audit provenance export surface\\n7f10befa fix(python): reject malformed provenance conditions\\n462f287a docs(log): routing absorbed — muse/glm/argon windows dark to ~Nov 16, jupiter pool fixed; adoption lanes re-armed qwen-primary\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794553000000-engineer-port-phase4-green.gpt-6.1-terra.stdout.log:28:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git show --stat 8456c2e9'\",\"aggregated_output\":\"commit 8456c2e9e0e99127d5b71650fc3bb69d4349c4e7\\nAuthor: Sonny To <son.c.to@gmail.com>\\nDate:   Fri Nov 13 04:19:00 2026 +0700\\n\\n    feat(yang.clojure): port Phase 3r — kernel-gate corpus off the outcome model + depth harness\\n    \\n    Admit the clj/ continuation family (continuation-family-names) so the\\n    kernel-gate corpus compiles under the continuation lane. Port the site\\n    stamping off the outcome model: gate-site! returns the argument vector as a\\n    plain value (no data/nth outcome unwrap), and the cc3 attribution machinery\\n    recognizes the two-application shape. Drop the retired :clj/outcomes?\\n    descriptor marker. Add the max live-K depth harness (run-guest-machine-depth)\\n    with per-workload measurement (kernel-gate-depths) and the post-port baselines\\n    EDN (155 workloads).\\n    \\n    Co-Authored-By: Claude Code <noreply@anthropic.com>\\n\\n src/cljc/yang/clojure.cljc                 |   8 +\\n test/yang/clojure_test.clj                 |  34 ++++\\n test/yang/latte_oracle/depth_post_port.edn |   4 +\\n test/yang/latte_oracle_test.clj            | 314 ++++++++++++++++-------------\\n 4 files changed, 216 insertions(+), 144 deletions(-)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794553000000-engineer-port-phase4-green.gpt-6.1-terra.stdout.log:55:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_27\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff --stat f29191fb..HEAD -- test/yang/call/python_exception_test.clj test/yang/clojure_test.clj && git log --oneline f29191fb..HEAD -- test/yang/clojure_test.clj test/yang/call/python_exception_test.clj'\",\"aggregated_output\":\" test/yang/clojure_test.clj | 222 ++++++++++++++++++++++++---------------------\\n 1 file changed, 119 insertions(+), 103 deletions(-)\\n8456c2e9 feat(yang.clojure): port Phase 3r — kernel-gate corpus off the outcome model + depth harness\\n8e1dab6d feat(yang.clojure): port phase 2 — the continuation lane (consumer wiring)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794560000000-engineer-port-phase6-provenance-carrier.gpt-6.1-terra-r3.stdout.log:5:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat /Users/sto/workspace/datomworld/collab/exception-track/1794559000000-consult-carrier-authentication.gpt-6.1-sol.findings.md'\",\"aggregated_output\":\"Created-GMT: 2026-11-12 22:55:00 GMT\\nCreated-Local: 2026-11-13 05:55:00 +07 (+0700)\\nCoding-Agent: codex (gpt-6.1-sol)\\nRole: Architect (carrier-authentication design consult)\\nStatus: CONSULT VERDICT OF RECORD — CARRIER RESOLVED VIA PROVENANCE\\n\\nCompleted-GMT: 2026-11-12 22:42:12 GMT  \\nCompleted-Local: 2026-11-13 05:42:12 +0700\\n\\n**Ruling: use the existing provenance primitive. It satisfies constraints 1–6 and resolves the design blocker for the 18 rows.** Implementing it and passing acceptance remain necessary before marking those rows green. This consult was read-only; no tests were run.\\n\\nPhase 5’s finding is correct. Closures deny guest access to their environments; structural equality does not provide condition recovery. Applying an unknown closure with a private token is unsafe. Withdraw the closure-only remedy. See the [kernel value contract](/Users/sto/workspace/datomworld/src/cljc/yin/vm/values.cljc:15) and [Phase 5 finding](/Users/sto/workspace/datomworld/collab/exception-track/1794557000000-engineer-port-phase5-carrier.gpt-6.1-terra.stdout.log:62).\\n\\n1. **Provenance supplies the required authority and lifetime.**\\n\\n   The mint takes **two arguments**, `visible` and `condition`. They become separate heap fields—not a guest-visible `[visible condition]` vector:\\n\\n   ```clojure\\n   ;; Compiler-generated operation:\\n   (cell/dsg__new-provenance visible condition)\\n\\n   ;; Resulting host-owned entry:\\n   {:value visible\\n    :seal issued-seal\\n    :provenance condition}\\n   ```\\n\\n   Allocation installs both fields atomically and rejects nil provenance. The reader authenticates the live reference against the heap and seal **before** reading provenance; an unmarked cell, forged/dead reference, map, or closure returns nil. It never applies the candidate. See [mint and reader](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2808) and [authentication](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:332).\\n\\n   **`cell/set!` preserves provenance.** It updates `:value` through `heap-write`, which preserves sibling fields. Therefore overwriting visible contents cannot replace, clear, or install the retained condition. See [heap-write](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2444), [set!](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2793), and the [preservation and copying pins](/Users/sto/workspace/datomworld/test/yin/vm/provenance_test.cljc:123).\\n\\n   The association belongs to the wrapper’s heap identity. GC follows provenance from live entries and pinned entries; mint-time collection roots the incoming condition too. There is no separate registry or handler-lifetime association. See [ordinary tracing](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2579), [pinned tracing](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2618), and [lifetime pins](/Users/sto/workspace/datomworld/test/yin/vm/provenance_test.cljc:194).\\n\\n2. **This is consistent with the owner’s NO.**\\n\\n   The rejected proposal added a `:retained` mark, new mint/query operations, and a marked-cell write refusal. The superseding directive requires the continuation port with no frontend-specific VM change. See the [NO](/Users/sto/workspace/datomworld/collab/exception-track/1794372000000-owner-decision-r3-vm-retained-seam.md:64) and [final directive](/Users/sto/workspace/datomworld/collab/exception-track/1794372000000-owner-decision-r3-vm-retained-seam.md:90).\\n\\n   This design consumes already-landed shared infrastructure and permits visible writes. Moreover, amendment 5 explicitly requires provenance adoption for Clojure’s continuation port; its [adoption ruling](/Users/sto/workspace/datomworld/collab/exception-track/1794451000000-consult-vm-provenance-design.gpt-6.1-sol.findings.md:104) and [port relay](/Users/sto/workspace/datomworld/collab/exception-track/1794456002000-to-yangclojure-port-adopts-provenance-primitive.md:12) already record that direction. No constraint relaxation is required.\\n\\n3. **Implement this exact path.**\\n\\n   Clojure references below are to `exception-r3-impl @ f15423c2`, in `/Users/sto/workspace/datomworld-r3-orch`.\\n\\n   - **Mint at trusted protocol reception.** In [`compile-guest-call`’s raise exit](/Users/sto/workspace/datomworld-r3-orch/src/cljc/yang/clojure.cljc:1396), retain the existing raw-payload path for `:yang.call/thrown`. For a qualified protocol condition `c`, deliver `(cell/dsg__new-provenance c c)` to `clj/raise`: initially `visible = c`, privately `provenance = c`, preserving every evidence field.\\n\\n     Apply the same constructor to compiler-generated local protocol refusals, including the [admission refusal](/Users/sto/workspace/datomworld-r3-orch/src/cljc/yang/clojure.cljc:1409) and [private dispatcher refusal](/Users/sto/workspace/datomworld-r3-orch/src/cljc/yang/clojure.cljc:2378). Minting belongs to these known condition-producing sites. A source `(throw condition-shaped-map)` must never mint provenance.\\n\\n   - **Carry the reference unchanged.** `clj/throw`, `clj/raise`, catches, and finally unwinding transport the carrier itself. Do not decode it into its visible map during transfer or saving.\\n\\n   - **Authenticate and recover at public egress.** Replace the unconditional fresh-thrown conversion in [`call-entry`’s handler](/Users/sto/workspace/datomworld-r3-orch/src/cljc/yang/clojure.cljc:1211) with this generated logic:\\n\\n     ```clojure\\n     (let [p (cell/dsg__provenance e)]\\n       (raise-exit\\n         (if (nil? p)\\n           (yang.call/thrown e)\\n           p)))\\n     ```\\n\\n     Query once. Forward the recovered condition unchanged. Do not inspect visible contents, require a frontend tag, reconstruct the condition, or apply `e`. Emit protected primitives/helpers so guest definitions cannot capture these operations.\\n\\n   - **Keep construction authority private.** Prefer direct generated UAST calls. Any factored constructor or recovery helper must use protected `dsg__` names and remain outside exports, projections, and aliases. The existing [reserved-name contract](/Users/sto/workspace/datomworld/src/cljc/yin/vm.cljc:124) and [macro-admission pins](/Users/sto/workspace/datomworld/test/yin/vm/provenance_test.cljc:245) protect the primitive doors; do not introduce an exported helper that accepts arbitrary provenance.\\n\\n   - **Expose protocol observations deliberately.** Keep the carrier as the documented identity-bearing local protocol exception. Supported condition lookups/accessors can authenticate first and project its visible value. That projection must not replace the reference used for throw or save. Replace the stale [“no carrier” implementation test assumption](/Users/sto/workspace/datomworld-r3-orch/test/yang/clojure_test.clj:1866); leave acceptance expectations intact.\\n\\n   Python’s `00ca2d1c` implements precisely this separation: [private wrapper mint](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/prelude.cljc:1044), [protocol reception](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/prelude.cljc:1079), and [egress recovery](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/prelude.cljc:918).\\n\\n4. **Saved cases and depth remain compatible.**\\n\\n   The kit stores `e` into `saved`, returns from `retain`, then throws `(cell/get saved)` in `later`. That retrieves the same sealed carrier reference, whose provenance outlives the original activation. See the [actual source fixtures](/Users/sto/workspace/datomworld/test/yang/call/exception_contract.clj:72) and [separate activation probe](/Users/sto/workspace/datomworld/test/yang/call/exception_probes.clj:111).\\n\\n   A content clone gets no provenance; an alias retains authority; overwriting the original carrier’s visible contents still forwards its original condition. Add Clojure pins for these cases and for a thrown closure whose body must never run.\\n\\n   Mint/read add fixed work at exception boundaries. Preserve the [private tail lane’s direct body application](/Users/sto/workspace/datomworld-r3-orch/src/cljc/yang/clojure.cljc:1213), add no handler there, and tail-mark the final raise calls. Re-run the established depth gates; this consult establishes compatibility, not measured depth results.\\n\\n5. **Ledger claim after acceptance.**\\n\\n   Six fixtures × semantic/stack/register = 18 rows. The unchanged [expectations](/Users/sto/workspace/datomworld/test/yang/call/exception_contract.clj:110) require all three qualified reasons, whole-condition equality, one transfer, no fallthrough, and successful retention for saved cases.\\n\\n   Use this claim only after those results are measured:\\n\\n   > Closed 18 Clojure protocol/saved-protocol rows on semantic, stack, and register at `<SHA>` / `<run>`. Qualified protocol conditions are retained in write-once private heap provenance owned by the generated carrier’s identity. Public egress authenticates and recovers without applying the raised value, forwarding the complete original condition once. Saved rethrows survive the creating activation. Unmarked lookalikes remain fresh thrown payloads. No frontend VM changes or ambient retention registry were introduced.\\n\\n**CARRIER RESOLVED VIA PROVENANCE**\",\"exit_code\":0,\"status\":\"completed\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794560000000-engineer-port-phase6-provenance-carrier.gpt-6.1-terra-r3.stdout.log:6:{\"type\":\"item.started\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'dsg__get|cell/|nil\\\\\\\\?|clj/throw|depth' src/cljc/yang/clojure.cljc test/yang/clojure_test.clj | tail -100; sed -n '1650,1905p' test/yang/clojure_test.clj; cat docs/agents/build-n-test.md | head -100\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n/Users/sto/workspace/datomworld/collab/exception-track/1794560000000-engineer-port-phase6-provenance-carrier.gpt-6.1-terra-r3.stdout.log:7:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"com