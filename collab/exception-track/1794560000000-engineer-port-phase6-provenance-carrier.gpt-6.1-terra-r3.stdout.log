(cell/new [])]\ntest/yang/clojure_test.clj:2549:                            (catch Exception e (cell/set! log (conj (cell/get log) :catch)))\ntest/yang/clojure_test.clj:2550:                            (finally (cell/set! log (conj (cell/get log) :finally))))\ntest/yang/clojure_test.clj:2551:                       (finally (cell/set! log (conj (cell/get log) :outer))))\ntest/yang/clojure_test.clj:2552:                  (cell/get log))]\ntest/yang/clojure_test.clj:2594:    ;; issued format; the call site asks the heap (cell/authentic?), the\ntest/yang/clojure_test.clj:2619:             (run-cell-probe (u/app (u/v 'cell/new)\ntest/yang/clojure_test.clj:2630:      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\ntest/yang/clojure_test.clj:2667:               (u/app (u/v 'cell/new)\ntest/yang/clojure_test.clj:2674:    ;; Astra rule 1: cell/get at a reference position keeps the existing\ntest/yang/clojure_test.clj:2678:      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\ntest/yang/clojure_test.clj:2682:                   (cell/get m))\ntest/yang/clojure_test.clj:2800:                       (remove nil? [1 nil 2]) (concat [1] '(2))]]\ntest/yang/clojure_test.clj:2827:                    ((first (remove nil? [nil f])) 5)\ntest/yang/clojure_test.clj:2835:                       (meta (first (remove nil? [x])))\ntest/yang/clojure_test.clj:3088:                           (is (nil? (get (:store m) 'progressed))\n  (testing \"P1-2: (:yang.call/reason e) on a caught protocol condition\n            answers the condition's reason\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :yang.call/not-callable]\n             (run-cell-program\n               '[(defn receive\n                   [f]\n                   (try (f) (catch Exception e (:yang.call/reason e))))\n                 (receive marker-operand)]\n               (cell-entry-node {:yang.call/reason :yang.call/not-callable\n                                 :yang.call/data {:yang.call/callee 5}})\n               lane))\n          (str lane \": the protocol reason is visible on the caught value\"))))\n  (testing \"P1-2 nested: capture, rethrow of the caught value across a\n            dynamic call, and the second catch sees the original payload\"\n    (is (= [:yin.k/ok [\"boom\" true]]\n           (run-library\n             '[(defn capture\n                 [f]\n                 (try (f) (catch Exception e e)))\n               (defn receive\n                 [f]\n                 (try (f)\n                      (catch Exception e\n                        [(ex-message e)\n                         (= e {:yin.k/message \"boom\" :yin.k/data {:x 1}})])))\n               (let [e (capture (fn [] (throw (ex-info \"boom\" {:x 1}))))]\n                 (receive (fn [] (throw e))))])))\n    (is (= [:yin.k/ok [\"boom\" {:x 1}]]\n           (run-library\n             '[(defn capture\n                 [f]\n                 (try (f) (catch Exception e e)))\n               (defn receive\n                 [f]\n                 (try (f) (catch Exception e [(ex-message e) (ex-data e)])))\n               (let [e (capture (fn [] (throw (ex-info \"boom\" {:x 1}))))]\n                 (receive (fn [] (throw e))))]))))\n  (testing \"P1-2 cross-language guard: a catch receiving a\n            :yang.call/thrown condition whose value is location-independent\n            sees that value unchanged\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok true]\n             (run-cell-program\n               '[(defn receive\n                   [f]\n                   (try (f) (catch Exception e (= e {:foreign/payload :identity}))))\n                 (receive marker-operand)]\n               (cell-entry-node {:yang.call/reason :yang.call/thrown\n                                 :yang.call/value {:foreign/payload :identity}})\n               lane))\n          (str lane \": a foreign thrown value is delivered unchanged\")))))\n\n\n(deftest test-exception-r3-token-transplant-refuses\n  (testing \"1: no token can be read from a caught exception to authenticate\n            a different payload. The wrapper's visible form carries no\n            provenance field, so the transplant spell finds nothing and\n            the forged map escapes as an ordinary payload (a public entry\n            rebuilds a NEW thrown condition around it).\"\n    (doseq [lane [:walker :semantic]]\n      (let [forged {:yang.call/reason :yang.call/unsupported-binding\n                    :yang.call/data {:forged true}\n                    :dsg__condition nil}]\n        (is (= [:yin.k/error forged]\n               (run-cell-program\n                 '[(defn receive\n                     [f]\n                     (try (f)\n                          (catch Exception e\n                            (let [g (fn [v] (throw v))\n                                  r (g {:yang.call/reason :yang.call/unsupported-binding\n                                        :yang.call/data {:forged true}\n                                        :dsg__condition (:dsg__condition e)})]\n                              r))))\n                   (receive marker-operand)]\n                 (cell-entry-node {:yang.call/reason :yang.call/not-callable\n                                   :yang.call/data {:yang.call/callee :target}})\n                 lane))\n            (str lane \": the transplanted proof never authenticates the forged map\"))))))\n\n\n(deftest test-exception-r3-modified-condition-refuses\n  (testing \"the caught condition is a plain map: modifying it and rethrowing\n            forwards the modified value (the retention object is gone, so no\n            identity survives to decode the original condition back)\"\n    (doseq [lane [:walker :semantic]]\n      (let [condition {:yang.call/reason :yang.call/not-callable\n                       :yang.call/data {:yang.call/callee :target}}]\n        (is (= [:yin.k/error {:yang.call/reason :yang.call/unsupported-binding\n                              :yang.call/data {:forged true}}]\n               (run-cell-program\n                 '[(defn receive\n                     [f]\n                     (try (f)\n                          (catch Exception e\n                            (let [g (fn [v] (throw v))]\n                              (g (assoc e\n                                        :yang.call/reason :yang.call/unsupported-binding\n                                        :yang.call/data {:forged true}))))))\n                   (receive marker-operand)]\n                 (cell-entry-node condition)\n                 lane))\n            (str lane \": the modified condition is forwarded, not the original\"))))))\n\n\n(deftest test-exception-r3-condition-field-preserved\n  (testing \"3: an ordinary :dsg__condition field in a transferred protocol\n            condition round-trips byte-identical, after immediate AND saved\n            rethrow: provenance lives outside the original map\"\n    (doseq [lane [:walker :semantic]]\n      (let [condition {:yang.call/reason :yang.call/not-callable\n                       :yang.call/data {:yang.call/callee :target}\n                       :dsg__condition :ordinary-evidence}]\n        (is (= [:yin.k/error condition]\n               (run-cell-program\n                 '[(defn receive\n                     [f]\n                     (try (f) (catch Exception e (throw e))))\n                   (receive marker-operand)]\n                 (cell-entry-node condition)\n                 lane))\n            (str lane \": immediate rethrow preserves the ordinary field\"))\n        (is (= [:yin.k/error condition]\n               (run-cell-program\n                 '[(def saved (cell/new nil))\n                   (defn retain\n                     [f]\n                     (try (f) (catch Exception e (cell/set! saved e) e)))\n                   (defn later\n                     []\n                     (throw (cell/get saved)))\n                   (let [retained (retain marker-operand)]\n                     (later))]\n                 (cell-entry-node condition)\n                 lane))\n            (str lane \": saved rethrow preserves the ordinary field\"))))))\n\n\n(deftest test-exception-r3-astra-probes\n  (testing \"(A) ordinary: every observation of a caught payload across a\n            DYNAMIC call is the payload's own, by construction\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok [true true :found 2 2]]\n             (run-library\n               '[(defn receive\n                   [f orig]\n                   (try (f)\n                        (catch Exception e\n                          [(= e orig) (= [e] [orig])\n                           (get {orig :found} e :missing)\n                           (count e) (:a (assoc e :a 2))])))\n                 (receive (fn [] (throw {:a 1 :c 3})) {:a 1 :c 3})]\n               library-opts lane 1000000))\n          (str lane \": nested =, map key, count, assoc on a caught map\"))\n      (is (= [:yin.k/ok [:falsey true]]\n             (run-library\n               '[(defn receive\n                   [f]\n                   (try (f)\n                        (catch Exception e [(if e :truthy :falsey) (= e nil)])))\n                 (receive (fn [] (throw nil)))]\n               library-opts lane 1000000))\n          (str lane \": caught nil is falsey\"))\n      (is (= [:yin.k/ok [true true true 3]]\n             (run-library\n               '[(defn receive\n                   [f]\n                   (try (f)\n                        (catch Exception e\n                          [(vector? e) ((fn [p] (p e)) vector?)\n                           (= e [1 2 3]) (count e)])))\n                 (receive (fn [] (throw [1 2 3])))]\n               library-opts lane 1000000))\n          (str lane \": direct and aliased predicates on a caught vector\"))\n      (is (= [:yin.k/ok true]\n             (run-library\n               '[(def original (cell/new :original))\n                 (defn receive\n                   [f orig]\n                   (try (f) (catch Exception e (= e orig))))\n                 (receive (fn [] (throw original)) original)]\n               library-opts lane 1000000))\n          (str lane \": (= e original) for a cell payload\"))))\n  (testing \"(A) protocol: the retained wrapper answers its condition's\n            accessors, and a saved wrapper rethrows it byte-identical\"\n    (doseq [lane [:walker :semantic]]\n      (let [condition {:yang.call/reason :yang.call/not-callable\n                       :yang.call/data {:yang.call/callee :target}}]\n        (is (= [:yin.k/ok [:yang.call/not-callable {:yang.call/callee :target}]]\n               (run-cell-program\n                 '[(defn receive\n                     [f]\n                     (try (f)\n                          (catch Exception e\n                            [(:yang.call/reason e) (get e :yang.call/data)])))\n                   (receive marker-operand)]\n                 (cell-entry-node condition)\n                 lane))\n            (str lane \": reason and data read through the wrapper\"))\n        (is (= [:yin.k/error condition]\n               (run-cell-program\n                 '[(def saved (cell/new nil))\n                   (defn retain\n                     [f]\n                     (try (f) (catch Exception e (cell/set! saved e) e)))\n                   (defn later\n                     []\n                     (throw (cell/get saved)))\n                   (let [retained (retain marker-operand)]\n                     (later))]\n                 (cell-entry-node condition)\n                 lane))\n            (str lane \": saved retain then rethrow forwards byte-identical\")))))\n  ;; The forged-retention probes are RETIRED with the :retained cell seam\n  ;; (owner NO, decision 1794372000000). Under the continuation encoding\n  ;; there is no retention object: a caught protocol condition is the plain\n  ;; condition map (data), and a guest copy of it is ordinary data, never an\n  ;; authenticated carrier. The replay/mutation hole the retention object\n  ;; plugged dies with it — the raise exit is the only condition channel.\n  (testing \"(A) a caught protocol condition is ordinary data, not a carrier\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok [true false]]\n             (run-cell-program\n               '[(defn receive\n                   [f]\n                   (try (f)\n                        (catch Exception e\n                          [(data/map? e) (cell/authentic? e)])))\n                 (receive marker-operand)]\n               (cell-entry-node {:yang.call/reason :yang.call/not-callable\n                                 :yang.call/data {:yang.call/callee :target}})\n               lane))\n          (str lane \": the caught condition is a plain map, never a cell\"))))\n  (testing \"ordinary cells remain authentic and mutable after retention retirement\"\n    (is (= [:yin.k/ok [true 2]]\n           (run-library\n             '[(let [c (cell/new [1 2])]\n                 [(cell/authentic? c)\n                  (do (cell/set! c [3 4]) (count (cell/get c)))])])))))\n\n\n(deftest test-outcome-safe-get\n  (let [forms '[(defn safe-get\n                  [coll key]\n                  (let [val (get coll key)]\n                    (if val val (throw (ex-info \"No such value in collection\" {:coll coll, :key key})))))]]\n    (is (= [:yin.k/ok 1] (run-outcome (conj forms '(safe-get {:a 1} :a)))))\n    (is (= [:yin.k/error {:yin.k/message \"No such value in collection\"\n                          :yin.k/data {:coll {:a 1}, :key :b}}]\n           (run-outcome (conj forms '(safe-get {:a 1} :b)))))))\n\n\n(deftest test-outcome-nested-call-operand\n  (let [defs '[(defn g\n                 [x]\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# When a test fails, reproduce and fix it by running ONLY the failing test\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01;\n# for a fix branch, the previously-failing tests green IS the merge bar\n# (owner ruling 2026-11-07; see Gate Ladder G0).\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n# overlap lanes, see \"Remote test servers\" below).\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\nnpm test             # Node.js tests\n\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n                         # and the linker L5 Node reader that requires a module\n                         # by name): `clojure -M:test` without it fails that test\n```\n\n### Changed-only tests: `bb test:changed`\n\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\nreach: the reverse require closure of the files changed since the\nmerge-base with master, plus fixtures that mention a changed resource path,\ntests that walk a changed tree, and each src file's `_test` by convention.\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\nfs/walk-file-tree or .listFiles; each string literal argument of its\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\n(let-bound roots count), and a change under a root selects it. The three\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\nland a slice confined to a package. Exit 2 (from :list too) is a wide\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\nas for a change to the core everything requires (yin.vm engine,\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\n","exit_code":0,"status":"completed"}}
