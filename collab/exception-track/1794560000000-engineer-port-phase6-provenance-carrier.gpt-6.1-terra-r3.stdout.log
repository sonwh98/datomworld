{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"sed -n '170,245p' test/yang/call/conformance.clj; sed -n '945,980p;3060,3105p' /private/tmp/carrier-implemented.cljc\"","aggregated_output":"    :parse clj-comp/read-forms,\n    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\n    :run-main 'clj/run-main,\n    :read-export (fn [export] (list 'clj/global-get export)),\n    :project (fn [name value]\n               ;; The runtime global namespace is the one binding (as\n               ;; `js/define-global!` is for a JS caller): `lower-unit`\n               ;; reads each projected name through `clj/global-get`, so\n               ;; no task-store binding duplicates it. A caller top-level\n               ;; definition of the same name publishes after the\n               ;; projection and shadows it.\n               (list 'clj/define-global! name value)),\n    :render clj-comp/output}})\n\n\n(defn- profile\n  [frontend]\n  (or (get frontends frontend)\n      (throw (ex-info \"frontend not admitted\" {:frontend frontend}))))\n\n\n(defn- modules\n  \"The host registry, admitted by every runtime profile that checks it,\n   with the clojure guest library's host surface installed beside them.\n   Donor publication declares free names over this same registry, so a\n   clojure donor using the guest library (its `kind` and `portable`\n   hosts) publishes like it runs.\"\n  []\n  (clj-prelude/admit (php-prelude/admit (h/registry))))\n\n\n(defn- claims-call-sites?\n  \"True when map AST `ast` carries the C1 call-site key anywhere.\"\n  [ast]\n  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n\n\n(defn publish-donor!\n  \"Publish the donor `source` of `frontend` as the module `module` (default\n   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\n   Answers `{:frontend :module :address :links}`.\"\n  ([frontend source]\n   (publish-donor! frontend source (symbol (str \"xlang.donor.\" (name frontend)))))\n  ([frontend source module]\n   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\n         [refusal-key reason] refusal\n         ast (let [raw (core-module/module-tree\n                         [(core-module/require-node runtime)\n                          (u/def! 'body (unit (parse source) []))])]\n               (cond-> raw\n                 (claims-call-sites? raw) u/annotate-call-sites))\n         spec (core-module/module-spec\n                refusal-key reason (modules)\n                {:name module,\n                 :ast ast,\n                 :exports '#{body},\n                 :runtime-name runtime,\n                 :runtime-address (address),\n                 :deps (if deps (deps) {})})\n         result (publish-guest! spec)]\n     {:frontend frontend,\n      :module module,\n      :address (:address result),\n      :links (:links result)})))\n\n\n(defn- runtime-entry\n  \"Require and initialize each distinct runtime of `frontend-keys`, once.\"\n  [frontend-keys]\n  (into [(core-module/require-node 'yang.call)]\n        (mapcat (fn [runtime]\n                  [(core-module/require-node runtime)\n                   (u/sexp->uast (list (symbol (str runtime) \"init!\")))]))\n        (distinct (map (comp :runtime profile) frontend-keys))))\n\n\n(def ^:private ex-data-form\n  '(fn [dsg__value] (dsg__get dsg__value :yin.k/data)))\n\n\n(def ^:private continuation-uast\n  \"The continuation family tree: define every `clj/` entry (store-defined,\n   like `yang.core.call/uast`) then allocate the `clj.rt/ctx` cell. The\n   family's capture-sensitive primitives are the `dsg__*` names, bound at\n   emission by `compile-program`.\"\n  (u/then\n    (reduce (fn [ast [key form]]\n              (u/then ast (u/def! key (u/sexp->uast form))))\n            (u/lit nil)\n            continuation-family)\n    (u/def! 'clj.rt/ctx\n            (u/app (u/v 'cell/new) (u/app (u/v 'clj/ctx) (u/lit nil))))))\n\n\n(def continuation-family-names\n  \"The `clj/` continuation-family store definitions `compile-program` emits\n   inline (plus the `clj.rt/ctx` cell): compiler-bound names an admission scan\n   must accept, like the preamble's `dsg__*` helpers. Exposed so a harness\n   admission check stays in sync with the family instead of hardcoding it.\"\n  (into #{'clj.rt/ctx} (map first continuation-family)))\n\n\n(defn- rewrite-ex-info\n  \"(ex-info msg data cause?) as the portable map holding its parts. The\n   accessors read through the generated exception wrapper: a retained\n   condition's wrapper carries the original payload privately, so\n   (ex-message e)/(ex-data e) answer the payload's parts while a plain\n   value still answers by keyword lookup.\"\n  [form]\n  (cond\n    (seq? form)\n    (cond\n             (publish-to-globals (second (:operands node)) names bound))\n      (assoc node\n             :operator (publish-to-globals (:operator node) names bound)\n             :operands (mapv #(publish-to-globals % names bound)\n                             (:operands node))))\n    :if (cond-> node\n          (contains? node :test)\n          (assoc :test (publish-to-globals (:test node) names bound))\n          (contains? node :consequent)\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n          (contains? node :alternate)\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n    (reduce (fn [n k]\n              (let [v (get n k)]\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\n                  (assoc n k (globals-child v names bound))\n                  n)))\n            node (keys node))))\n\n\n(defn lower-unit\n  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n   thunk whose call runs the program — `forms` plus the definitions of\n   the guest library they need, compiled unmodified under `unit-opts`\n   and published to the runtime global namespace by\n   `p