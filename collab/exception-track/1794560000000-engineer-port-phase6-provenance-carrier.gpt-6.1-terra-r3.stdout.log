    (cond-> (u/mark-tails\n                (apply u/app\n                       (u/lam [candidate]\n                              (u/if-node\n                                (u/app (u/v 'dsg__admitted?) (u/v candidate))\n                                (u/app (u/v 'yang.call/eligible?) (u/v candidate))\n                                (u/lit false)))\n                       (map #(compile-form % false env macro-env) operands)))\n        tail? (assoc :tail? true)))\n\n    (and (outcomes? env)\n         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n         (<= 4 (count operands)))\n1475:        (when (contains? (locals env) 'get)\n1479:                 :operator {:type :variable, :name 'get}\n2370:                                             (list (list (if (contains? (::defined env) 'get)\n2372:                                                           'get)\n2418:                               (if (contains? (::defined env) 'get)\n","exit_code":0,"status":"completed"}}
