{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2195,2225p;1465,1485p' src/cljc/yang/clojure.cljc; sed -n '2558,2585p' test/yang/clojure_test.clj; rg -n \\\"\\\\bget\\\\b\\\" src/cljc/yang/clojure.cljc | grep -E 'adapters|native|\\\\[get|defn get' | head\"","aggregated_output":"        lead (vec (butlast more))\n        coll-form (list 'vec (last more))]\n    (compile-guest-call (compile-form f false env macro-env)\n                        (compile-form (if (seq lead)\n                                        (list 'data/into lead coll-form)\n                                        coll-form)\n                                      false env macro-env)\n                        env tail?)))\n\n\n(defn- compile-av-application\n  [operator operands env tail? macro-env]\n  (cond\n    (apply-call? env operator) (compile-apply operands env tail? macro-env)\n\n    ;; (:k m) / (:k m default): a static lookup\n    (keyword? operator)\n    (do (when-not (<= 1 (count operands) 2)\n          (reject! \"A keyword call takes a map and an optional default\"\n                   {:keyword operator, :operands (count operands)}))\n        (when (contains? (locals env) 'get)\n(defn- lower-top-form\n  \"A non-definition top-level expression lowers like a function body (plain\n   values, `throw`/`try` onto the continuation family); definitions keep\n   their own lowering.\"\n  [env macro-env form]\n  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\n    form\n    (lower-function-body env macro-env [] [form])))\n\n\n(defn- top-boundary\n  \"The top-level exception boundary: run `ast` under `clj/try`, answering\n   `[:yin.k/ok value]` on normal return and `[:yin.k/error raised]` on a\n   raise. The `[:yin.k/ok|error]` wrapper is the harness contract (a linked\n   entry's `clj/unwrap-outcome` removes one level); inside it, function\n   bodies return plain values and a raise is the only error channel.\"\n  [ast]\n  (u/app (u/v 'clj/try)\n         (u/lam [] (outcome-node ok-tag ast))\n         (u/lam ['dsg__e] (outcome-node error-tag (u/v 'dsg__e)))))\n\n\n(defn compile-program\n  \"Compile a sequence of Clojure forms into a single Universal AST.\n   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n   with :macro? true on the lambda; the encoder turns that flag into a\n   declaration row and the expander, not this compiler, recognizes calls.\n   The three-argument form takes `opts` opting into the argument-vector\n   convention (see `program-env`); without it the output is the native one.\"\n  ([forms] (compile-program forms true))\n          (str lane \" \" forms)))))\n\n\n(defn- run-cell-program\n  \"The value of running the compiled `program` (quoted forms) with `node`\n   spliced into the marker operand, on one lane — every call keeps its\n   call-site routing — or the thrown refusal's ex-data.\"\n  [program node lane]\n  (let [ast (walk/postwalk\n              (fn [n] (if (= n (u/v 'marker-operand)) node n))\n              (yang/compile-program\n                (into (yang/library-for program) program)\n                true\n                library-opts))]\n    (try\n      (run-guest-ast ast library-modules lane 1000000)\n      (catch clojure.lang.ExceptionInfo e\n        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\n\n\n(defn- run-cell-probe\n  \"The value of running the compiled probe program — `(probe <node>)`, so\n   the spliced `node` sits at a call's callee position — on one lane, or\n   the thrown refusal's ex-data.\"\n  [node lane]\n  (run-cell-program\n    '[(defn probe\n        [m]\n2416:                               (u/app (u/lam '[get = assoc empty?] call/uast)\n","exit_code":0,"status":"completed"}}
