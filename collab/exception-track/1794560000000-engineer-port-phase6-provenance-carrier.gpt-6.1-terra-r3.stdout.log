sors. Generated names\n;; carry the reserved `dsg__` prefix; the program pre-pass keeps user code out\n;; of that prefix. A macro call is opaque to the pass: the expander owns it.\n\n(def ^:private ok-tag :yin.k/ok)\n\n(def ^:private error-tag :yin.k/error)\n\n\n(defn- outcomes?\n  [env]\n  (some? (::outcomes env)))\n\n\n(defn- binder-symbols\n  [b]\n  (into #{} (comp (filter symbol?) (remove #{'&})) (tree-seq coll? seq b)))\n\n\n(defn- rebuild\n  \"A list of `items` carrying the reader metadata of `form`.\"\n  [form items]\n  (let [out (apply list items)]\n    (if-let [m (meta form)]\n      (with-meta out m)\n      out)))\n\n\n;; =============================================================================\n;; The clj continuation family (R3 §8.10.7; the (B) port)\n;; =============================================================================\n;;\n;; The port converges clojure's exception lowering onto the continuation\n;; encoding: a `%capture` handler stack in a dynamic-context cell, exactly\n;; like the py/ts/php preludes (`yang.clojure.prelude` carries the reference\n;; implementation under `clj/`). A source `(throw e)` lowers to `clj/throw`,\n;; `(try ...)` to `clj/try`/`clj/try-finally`, and function bodies return\n;; plain values. A guest call delivers a callee's escaping condition through\n;; the §8.10.7 raise exit, and the public entry installs the same bridge.\n;; The caught value IS the payload/condition — no wrapper, no retention\n;; object, no per-call-site routing. `compile-program` emits this family\n;; inline (the linked runtime binds the same family from the prelude); it\n;; routes the capture-sensitive primitives through the `dsg__*` helpers so a\n;; program definition of `get`/`assoc`/`=` cannot capture a frame access.\n\n(def ^:private continuation-family\n  \"The `clj/` continuation family, `[key form]` in prelude notation (each\n   form is read with `u/sexp->uast`). Mirrors `yang.clojure.prelude`'s\n   escapes section, minus `call-ec`/`unwind-to` (clojure has no\n   break/continue/return escapes). The handler stack is a chain of frames\n   [tag payload rest n]; a `:handler` frame holds the continuation\n   `clj/raise` delivers to, a `:finally` frame a one-argument thunk every\n   exit through it runs.\"\n  '[[clj/ctx (fn [hs] (dsg__assoc {} :handlers hs))]\n    [clj/handlers (fn [] (dsg__get (cell/get clj.rt/ctx) :handlers))]\n    [clj/set-handlers!\n     (fn [hs]\n       (cell/set! clj.rt/ctx (dsg__assoc (cell/get clj.rt/ctx) :handlers hs)))]\n    [clj/restore! (fn [saved] (cell/set! clj.rt/ctx saved))]\n    [clj/frame-depth (fn [hs] (if (dsg__equal hs nil) 0 (dsg__get hs 3)))]\n    [clj/frame\n     (fn [tag payload rest]\n       (conj (conj (conj (conj [] tag) payload) rest)\n             (+ 1 (clj/frame-depth rest))))]\n    [clj/pop-frame\n     (fn [hs]\n       (cell/set! clj.rt/ctx\n                  (dsg__assoc (cell/get clj.rt/ctx) :handlers (dsg__get hs 2))))]\n    [clj/raise\n     (fn [e]\n       (let [hs (clj/handlers)]\n         (if (dsg__equal hs nil)\n           (dsg__get e :clj/no-handler)\n           (if (dsg__equal (dsg__get hs 0) :finally)\n             (do (clj/pop-frame hs) ((dsg__get hs 1) e) (clj/raise e))\n             ((dsg__get hs 1) e)))))]\n    [clj/throw (fn [e] (clj/raise e))]\n    [clj/try\n     (fn [body handler]\n       (let [saved (cell/get clj.rt/ctx)\n             flag (cell/new :first)]\n         ((fn [r]\n            (if (dsg__equal (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (clj/set-handlers! (clj/frame :handler r (dsg__get saved :handlers)))\n                  (let [v (body)] (do (clj/restore! saved) v)))\n              (do (clj/restore! saved) (handler r))))\n          (%capture))))]\n    [clj/try-finally\n     (fn [body fin]\n       (let [saved (cell/get clj.rt/ctx)]\n         (do (clj/set-handlers! (clj/frame :finally fin (dsg__get saved :handlers)))\n             (let [v (body)]\n               (do (clj/restore! saved) (fin nil) v)))))]])\n\n\n(def ^:private ex-message-form\n  '(fn [dsg__value] (dsg__get dsg__value :yin.k/message)))\n\n\n(def ^:private ex-data-form\n  '(fn [dsg__value] (dsg__get dsg__value :yin.k/data)))\n\n\n(def ^:private continuation-uast\n  \"The continuation family tree: define every `clj/` entry (store-defined,\n  (testing \"if-some and when-some: a may-fail initializer, false is some\"\n    (is (= [:yin.k/ok :some] (outcome-of-call '(if-some [y (g x)] :some :none) '(f 1))))\n    (is (error? (outcome-of-call '(if-some [y (g x)] :some :none) '(f nil))))\n    (is (= [:yin.k/ok :some] (outcome-of-call '(if-some [y (= x 1)] :some :none) '(f 2))))\n    (is (= [:yin.k/ok 2] (outcome-of-call '(when-some [y (g x)] (+ y 1)) '(f 1))))\n    (is (error? (outcome-of-call '(when-some [y (g x)] y) '(f nil)))))\n  (testing \"the initializer evaluates once\"\n    (is (= [:yin.k/ok 1] (outcome-of-call '(if-let [y (g (probe/note x))] y 0) '(f 1))))\n    (is (= [1] @effect-log)))\n  (testing \"a user macro operand is accepted: there is no may-fail\n            classification to refuse under the continuation encoding\"\n    (is (nil? (try (yang/compile-program\n                     [fails-on-nil '(defn f\n                                      [x]\n                                      (unless (g x) 1 2))]\n                     true (assoc outcome-opts :macros #{'unless}))\n                   nil\n                   (catch clojure.lang.ExceptionInfo e (ex-message e)))))))\n\n\n;; =============================================================================\n;; Slice 7: the guest collection and higher-order library\n;; =============================================================================\n\n(def ^:private library-modules\n  \"The library's whole host surface: the `kind` module, the `portable`\n   adapters of the data exports the collection predicates read, and the\n   `cell` module. Every outcome-model program's emitted call routing reads\n   `cell/authentic?` once a callee passes the cell-ref shape pre-filter,\n   and a spliced `cell/new` mints genuine references (the engine seals\n   them under the test composition's capability secret), so the lane's\n   registry supplies the cell host as the linked compositions' do.\"\n  (let [host (fn [registry module-name fns arities]\n               (module/register-host-module\n                 registry module-name fns\n                 (into {} (map (fn [[op _]]\n                                 [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n                       fns)))\n        portable (into {}\n                       (map (fn [[source _]]\n                              (let [op (symbol (name source))]\n                                [op (yang/outcome-adapter data/refusal-message\n                                                          (get data/data-module op))])))\n                       yang/library-adapters)]\n    (-> av-modules\n        (module/register-cell-module)\n        (host 'kind yang/kind-module yang/kind-arities)\n        (host 'portable portable\n              (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n                    (keys portable))))))\n\n\n(def ^:private library-opts\n  {:convention :arg-vector, :outcomes true\n   :adapters yang/library-adapters\n   :native vm/primitive-profiles})\n\n\n(defn run-guest-machine\n  \"Run an AST through either observer composition with a finite instruction\n   budget. Return the terminal machine so fixtures can observe its streams.\"\n  [ast modules lane step-limit]\n  (let [run-bounded (fn [machine]\n                      (loop [v machine, n 0]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) v\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n :consumer v}))\n                          :else (recur (vm/step v) (inc n)))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n","exit_code":0,"status":"completed"}}
