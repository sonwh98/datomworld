st (into call/definitions definitions)))\nsrc/cljc/yang/php/antlr/prelude.cljc-6225-\nsrc/cljc/yang/php/antlr/prelude.cljc-6226-\nsrc/cljc/yang/php/antlr/prelude.cljc-6227-(def uast\nsrc/cljc/yang/php/antlr/prelude.cljc-6228-  \"The bundled prelude: every definition, then the task's runtime state\nsrc/cljc/yang/php/antlr/prelude.cljc-6229-   allocated by `php/init!`.\"\nsrc/cljc/yang/php/antlr/prelude.cljc-6230-  (u/then functions-uast (u/sexp->uast '(php/init!))))\nsrc/cljc/yang/php/antlr/prelude.cljc-6231-\nsrc/cljc/yang/php/antlr/prelude.cljc-6232-\nsrc/cljc/yang/php/antlr/prelude.cljc-6233-;; =============================================================================\nsrc/cljc/yang/php/antlr/prelude.cljc-6234-;; The module emitter: the same definition list as the linker module `php`\nsrc/cljc/yang/php/antlr/prelude.cljc-6235-;; =============================================================================\nsrc/cljc/yang/php/antlr/prelude.cljc-6236-\nsrc/cljc/yang/php/antlr/prelude.cljc-6237-(def module-name\nsrc/cljc/yang/php/antlr/prelude.cljc-6238-  \"The linker module the PHP runtime profile is published as.\"\nsrc/cljc/yang/php/antlr/prelude.cljc-6239-  'php)\n==> src/cljc/yang/core/prelude.cljc <==\n(ns yang.core.prelude\n  \"Emitter machinery shared by every language's runtime-profile prelude\n   (docs/design/yang.typescript.md §17, lift L1). A language supplies its\n   module's own namespace string, its uninit sentinel, its definition list\n   and its refusal namespace; everything here is a pure function of those.\"\n  (:require\n    [clojure.walk :as walk]\n    [yang.core.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.module :as module]))\n\n\n(defn define\n  \"`(yin/def (quote key) form)` in prelude notation: the key quoted, so\n   `sexp->uast` reads it as the literal symbol Rule R requires.\"\n  [key form]\n  (list 'yin/def (list 'quote key) form))\n\n\n(defn strip\n  \"`sym` without the module's own namespace `ns-str`; any other value as it\n   is. Qualified internal store keys stay qualified.\"\n  [ns-str sym]\n  (if (and (symbol? sym) (= ns-str (namespace sym)))\n    (symbol (name sym))\n    sym))\n\n\n(defn strip-form\n  \"A prelude-notation form with every symbol `strip`ped: references,\n   definition keys and quoted keys alike. Keywords, strings and the\n   keys of literal maps are untouched.\"\n  [ns-str form]\n  (walk/postwalk (partial strip ns-str) form))\n\n\n(defn placeholder\n  \"The `[k uninit]` definition for runtime key `k`, so each read of it is\n   discharged by an unconditional module-level definition.\"\n  [k uninit]\n  [k uninit])\n\n\n(defn module-definitions\n  \"The module's definition list: a `uninit` placeholder for every runtime\n\n==> src/cljc/yang/core/lower.cljc <==\n(ns yang.core.lower\n  \"Lowering helpers shared by every language's CST-to-Universal-AST lowering\n   (docs/design/yang.typescript.md §17, lift L2): the CST accessors over a\n   lowering context `{:pk packet ...}`, the generated-name supply, safepoint\n   site marks, and the diagnostic builders. A language supplies its\n   diagnostic namespace (a string such as \\\"yang.python.antlr\\\"), its name\n   for messages and its table of unsupported rules.\"\n  (:require\n    [yang.antlr.packet :as p]\n    [yang.core.uast :as u]))\n\n\n;; =============================================================================\n;; Diagnostics\n;; =============================================================================\n\n(defn unsupported!\n  \"Throw the `<diagnostic-ns>/unsupported` diagnostic for rule node `n`\n   naming `construct`; `language` is the name the message uses.\"\n  [diagnostic-ns language n construct]\n  (throw (ex-info (str \"Unsupported \" language \" construct: \" construct)\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"unsupported\"),\n                   :rule (:rule n),\n                   :construct construct,\n                   :span (:span n)})))\n\n\n(defn syntax!\n  \"Throw the `<diagnostic-ns>/syntax` diagnostic for rule node `n`.\"\n  [diagnostic-ns n message]\n  (throw (ex-info message\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"syntax\"),\n                   :rule (:rule n),\n                   :span (:span n)})))\n\n\n(defn default-arm\n  \"The arm of a rule with no lowering: `unsupported!` when `refusals` (rule\n   name to construct) names it, otherwise `<diagnostic-ns>/unhandled-rule`.\"\n  [diagnostic-ns language refusals n]\n  (if-let [construct (get refusals (:rule n))]\n    (unsupported! diagnostic-ns language n construct)\n    (throw (ex-info (str \"Unhandled grammar rule: \" (:rule n))\n","exit_code":0,"status":"completed"}}
