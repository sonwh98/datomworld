{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '179,194p;222,250p'\"","aggregated_output":"   179\t(defn handle-put\n   180\t  \"Handle :stream/put. Total over the five append outcomes.\n   181\t   Returns {:value v :state s} on success, {:park true :stream-id id :state s}\n   182\t   on `full`. `closed`, `invalid-value` and `transport-error` are errors that\n   183\t   name their outcome, as v1's throw on a closed stream did.\"\n   184\t  [state effect]\n   185\t  (let [stream-ref (:stream effect)\n   186\t        val (:val effect)\n   187\t        stream-id (:id stream-ref)\n   188\t        handle (get (:store state) stream-id)]\n   189\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   190\t    (let [result (stream/append! handle val)\n   191\t          o (outcome result)]\n   192\t      (case o\n   193\t        :dao.stream/ok {:value val, :state state}\n   194\t        :dao.stream/full {:park true, :stream-id stream-id, :state state}\n   222\t   lost. The three terminal outcomes are errors.\"\n   223\t  [state effect]\n   224\t  (let [cursor-ref (:cursor effect)\n   225\t        cursor-id (:id cursor-ref)\n   226\t        store (:store state)\n   227\t        cursor-data (get store cursor-id)]\n   228\t    (when (nil? cursor-data) (fail \"Invalid cursor reference\" {:ref cursor-ref}))\n   229\t    (let [stream-id (:stream-id cursor-data)\n   230\t          handle (get store stream-id)]\n   231\t      (when (nil? handle)\n   232\t        (fail \"Stream not found for cursor\" {:stream-id stream-id}))\n   233\t      (let [result (stream/next handle (:cursor cursor-data))\n   234\t            o (outcome result)\n   235\t            advance (fn [state* value]\n   236\t                      {:value value,\n   237\t                       :state (assoc state*\n   238\t                                     :store\n   239\t                                     (assoc store\n   240\t                                            cursor-id\n   241\t                                            (assoc cursor-data\n   242\t                                                   :cursor\n   243\t                                                   (:dao.stream/cursor\n   244\t                                                     result))))})]\n   245\t        (case o\n   246\t          :dao.stream/ok (advance state (:dao.stream/value result))\n   247\t          :dao.stream/blocked {:park true,\n   248\t                               :cursor-ref cursor-ref,\n   249\t                               :stream-id stream-id,\n   250\t                               :state state}\n","exit_code":0,"status":"completed"}}
