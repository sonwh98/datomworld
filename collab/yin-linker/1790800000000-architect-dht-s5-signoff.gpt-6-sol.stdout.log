repl/dht_process_test.clj:61:(def ^:private node-script\ntest/yin/repl/dht_process_test.clj:106:  (let [deadline (+ (System/currentTimeMillis) ms)]\ntest/yin/repl/dht_process_test.clj:109:          (when (< (System/currentTimeMillis) deadline)\ntest/yin/repl/dht_process_test.clj:158:            (is (await-line p #\"dht: node [0-9a-f]+ listening on 127\\.0\\.0\\.1:\\d+\"\ntest/yin/repl/dht_process_test.clj:175:          (testing \"the round printed its result before the network answered\"\ntest/yin/repl/dht_process_test.clj:190:            ;; Typed before the reader has hydrated: these lines wait in its\ntest/yin/repl/dht_process_test.clj:194:            (testing \"the reader hydrates the remote index over the network\"\ntest/yin/repl/dht_process_test.clj:195:              (is (await-line d (re-pattern (str \"dht: hydrated :\" manifest))\ntest/yin/repl/dht_process_test.clj:202:                (is (< (index-of-match d #\"dht: hydrated\")\ntest/yin/repl/dht_process_test.clj:205:            (testing \"the reader's own rounds continue that index, unshared\"\ntest/yin/repl/dht_process_test.clj:206:              ;; Its require and q rounds each published over the hydrated\ntest/yin/repl/dht_process_test.clj:214:            (testing \"plain Clojure in this JVM loads the same index over UDP\"\ntest/yin/repl/dht_process_test.clj:216:                    node (dht/load-index\ntest/yin/repl/dht_process_test.clj:218:                                      :peers [{:host \"127.0.0.1\" :port pa}]})\ntest/yin/repl/dht_process_test.clj:220:                    deadline (+ (System/currentTimeMillis) exchange-ms)\ntest/yin/repl/dht_process_test.clj:221:                    node (loop [node node]\ntest/yin/repl/dht_process_test.clj:222:                           (let [[node _] (dht/step node (System/currentTimeMillis))]\ntest/yin/repl/dht_process_test.clj:223:                             (if (or (not= :loading (:status (dht/load-status node m)))\ntest/yin/repl/dht_process_test.clj:224:     