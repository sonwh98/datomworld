: `step` walks the index it\n    27\t     names through the local store and fetches each blob the store lacks\n    28\t     with a `:jing/get` (`dao.jing.content.step`), until all four covered\n    29\t     indexes read back whole and cover the manifest's count.\n    30\t   * `db` and `q` read a loaded index through `dao.space.index/\n    31\t     read-manifest` and `restored-indexes` (`dao.space.query/\n    32\t     published-db`), locally.\n    33\t\n    34\t   `step` answers `[node events]`, each event a plain map under\n    35\t   `:dao.space.dht/event`: `:bound`, `:bind-failed`, `:published`\n    36\t   (`:acknowledged?`, with `:peers` sent to, or the `:reason` and the\n    37\t   `:peers` it reached), `:publication-unknown` (the facts were lost),\n    38\t   `:loaded`, and `:load-failed`.\"\n    39\t  (:require #?@(:cljd [[\"dart:math\" :as math]\n    40\t                       [\"dart:typed_data\" :as typed]\n    41\t                       [dao.stream.datagram.dart :as datagram.host]]\n    42\t                :cljs [[dao.stream.datagram.node :as datagram.host]]\n    43\t                :clj [[dao.stream.datagram.jvm :as datagram.host]])\n    44\t            [clojure.string :as str]\n    45\t            [dao.jing :as jing]\n    46\t            [dao.jing.content.step :as content.step]\n    47\t            [dao.jing.dht :as dht]\n    48\t            [dao.jing.file :as jing.file]\n    49\t            [dao.space.index :as index]\n    50\t            [dao.space.query :as query]\n    51\t            [dao.stream :as stream]\n    52\t            [dao.stream.datagram :as datagram]\n    53\t            [dao.stream.ringbuffer :as ringbuffer]))\n    54\t\n    55\t\n    56\t;; =============================================================================\n    57\t;; Options and defaults\n    58\t;; =============================================================================\n    59\t\n    60\t(def default-max-inbound-bytes\n    61\t  \"The default inbound storage bound (`:dao.jing.dht/max-inbound-bytes`):\n    62\t   64 MiB of peers' `:store` payloads a publishing node accepts before it\n    63\t   refuses them explicitly.\"\n    64\t  (* 64 1024 1024))\n    65\t\n    66\t\n    67\t(def defaults\n    68\t  \"`join`'s option defaults: solo, publishing off, loopback on an\n    69\t   ephemeral port, the default inbound bound.\"\n    70\t  {:peers []\n    71\t   :publish? false\n    72\t   :bind-host \"127.0.0.1\"\n    73\t   :bind-port 0\n    74\t   :max-inbound-bytes default-max-inbound-bytes})\n    75\t\n    76\t\n    77\t(def secret-length\n    78\t  \"Bytes of the root secret minted per join: section 8's floor.\"\n    79\t  32)\n    80\t\n    81\t\n    82\t(def ring-capacity\n    83\t  \"Capacity of each ring the node is composed over: requests, answers,\n    84\t   facts, ticks, traffic, and the publication ledger.\"\n    85\t  4096)\n    86\t\n    87\t\n    88\t(def step-budget\n    89\t  \"The DHT's per-stage budget per step.\"\n    90\t  64)\n    91\t\n    92\t\n    93\t(def fetch-budget\n    94\t  \"Answers the load client reads per step.\"\n    95\t  16)\n    96\t\n    97\t\n    98\t(def content-name\n    99\t  \"The content log `join` opens inside a `:dir`.\"\n   100\t  \"content.jing\")\n   101\t\n   102\t\n   103\t(defn default-bind\n   104\t  \"This build's datagram host seam (dao.stream.datagram.md section 3): the\n   105\t   JVM's, Node's `dgram` (required only when a socket binds, so a browser\n   106\t   build compiles), or Dart's.\"\n   107\t  []\n   108\t  #?(:cljd datagram.host/bind!\n   109\t     :cljs datagram.host/bind!\n   110\t     :clj datagram.host/bind!))\n   111\t\n   112\t\n   113\t(defn secure-random-bytes\n   114\t  \"`n` bytes from the host's cryptographically secure generator.\"\n   115\t  [n]\n   116\t  #?(:cljd (let [r (math/Random.secure)]\n   117\t             (typed/Uint8List.fromList\n   118\t               (vec (repeatedly n #(.nextInt r 256)))))\n   119\t     :clj (let [bs (byte-array n)]\n   120\t            (.nextBytes (java.security.SecureRandom.) bs)\n   121\t            bs)\n   122\t     :cljs (.getRandomValues js/crypto (js/Uint8Array. n))))\n   123\t\n   124\t\n   125\t(defn- option-refusal\n   126\t  \"Why `opts` cannot join, or nil.\"\n   127\t  [{:keys [local dir peers publish? bind-host bind-port max-inbound-bytes\n   128\t           bind!]}]\n   129\t  (cond\n   130\t    (not (or (and (map? local) (ifn? (:put-bytes-fn local)))\n   131\t             (and (string? dir) (not (str/blank? dir)))))\n   132\t    \"a node needs a :local dao.jing store or a :dir\"\n   133\t\n   134\t    (not (and (sequential? peers)\n   135\t              (every? #(and (map? %)\n   136\t                            (datagram/ip-literal? (:host %))\n   137\t                            (datagram/valid-port? (:port %)))\n   138\t                      peers)))\n   139\t    \"peers must be {:host <IP literal> :port <1 to 65535>}\"\n   140\t\n   141\t    (not (boolean? publish?))\n   142\t    \":publish? must be true or false\"\n   143\t\n   144\t    (not (datagram/ip-literal? bind-host))\n   145\t    \":bind-host must be an IP literal\"\n   146\t\n   147\t    (not (and (integer? bind-port) (<= 0 bind-port 65535)))\n   148\t    \":bind-port must be 0 (ephemeral) or 1 to 65535\"\n   149\t\n   150\t    (not (and (integer? max-inbound-bytes) (<= 0 max-inbound-bytes)))\n   151\t    \":max-inbound-bytes must be a nonnegative integer\"\n   152\t\n   153\t    (and (seq peers) (not (fn? bind!)))\n   154\t    \"a node with peers needs a datagram host seam (:bind!)\"))\n   155\t\n   156\t\n   157\t;; =============================================================================\n   158\t;; join\n   159\t;; =============================================================================\n   160\t\n   161\t(defn- ring\n   162\t  []\n   163\t  (:dao.stream/handle\n   164\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n   165\t                         ringbuffer/capacity-key ring-capacity})))\n   166\t\n   167\t\n   168\t(defn- oldest\n   169\t  [handle]\n   170\t  (:dao.stream/cursor (stream/cursor handle :dao.stream/oldest)))\n   171\t\n   172\t\n   173\t(defn- local-store\n   174\t  [{:keys [local dir]}]\n   175\t  (or local\n   176\t      (jing.file/create-content-file (str (str/replace dir #\"/+$\" \"\")\n   177\t                                          \"/\" content-name))))\n   178\t\n   179\t\n   180\t(defn join\n   181\t  \"Join the DHT from `opts` and answer the node:\n   182\t\n   183\t   * `:local` — the node's own `dao.jing` store — or `:dir`, a directory\n   184\t     whose `content.jing` content log is opened as it (this API takes no\n   185\t     directory lock: a caller that shares a directory across processes\n   186\t     passes its own locked store as `:local`, as `yin.repl` does);\n   187\t   * `:peers` — bootstrap contacts `[{:host ip :port p} ...]`, none for\n   188\t     solo;\n   189\t   * `:publish?` — whether everything in the local store is public;\n   190\t   * `:bind-host`, `:bind-port` — the socket's address, loopback and\n   191\t     ephemeral by default;\n   192\t   * `:max-inbound-bytes` — the inbound storage bound;\n   193\t   * `:bind!` — the datagram host seam, `default-bind` by default.\n   194\t\n   195\t   Refuses an invalid option with its reason.  The node owns `:local`\n   196\t   from here: `close!` closes it.\"\n   197\t  [opts]\n   198\t  (let [opts (merge defaults {:bind! (default-bind)} opts)]\n   199\t    (when-some [why (option-refusal opts)]\n   200\t      (throw (ex-info (str \"dao.space.dht/join: \" why)\n   201\t                      (dissoc opts :bind! :local))))\n   202\t    (let [{:keys [peers publish? bind-host bind-port max-inbound-bytes bind!]} opts\n   203\t          local (local-store opts)\n   204\t          [requests answers facts ticks traffic ledger] (repeatedly 6 ring)\n   205\t          socket? (boolean (seq peers))\n   206\t          composition (cond-> {:local local\n   207\t                               :requests requests\n   208\t                               :answers answers\n   209\t                               :facts facts\n   210\t                               :ticks ticks\n   211\t                               ::dht/id (dht/bytes->hex\n   212\t                                          (secure-random-bytes dht/id-length))\n   213\t                               ::dht/publish? publish?\n   214\t                               ::dht/bootstrap (vec peers)\n   215\t                               ::dht/bind-host bind-host}\n   216\t                        socket? (assoc :traffic traffic\n   217\t                                       ::dht/secret (secure-random-bytes\n   218\t                                                      secret-length)\n   219\t                                       ::dht/max-inbound-bytes max-inbound-bytes))\n   220\t          seam (when socket?\n   221\t                 (bind! {:identity (str \"dao.space.dht:\"\n   222\t                                        (subs (::dht/id composition) 0 16))\n   223\t                         :deposit traffic\n   224\t                         :bind-host bind-host\n   225\t                         :bind-port bind-port\n   226\t                         :max-bytes (::dht/max-datagram dht/defaults)}))\n   227\t          front (dht/store-handle\n   228\t                  {:local local\n   229\t                   :requests requests\n   230\t                   :max-message-bytes (::dht/max-message-bytes dht/defaults)})\n   231\t          closed? (volatile! false)]\n   232\t      {:peers (vec peers)\n   233\t       :publish? publish?\n   234\t       :composition composition\n   235\t       :dht (when-not socket? (dht/state composition))\n   236\t       :seam seam\n   237\t       :traffic-cursor (when socket? (oldest traffic))\n   238\t       :facts (oldest facts)\n   239\t       :ledger ledger\n   240\t       :ledger-cursor (oldest ledger)\n   241\t       :origin nil\n   242\t       :reading nil\n   243\t       :window []\n   244\t       :publications []\n   245\t       :client (content.step/client-state requests answers (oldest answers))\n   246\t       :loads {}\n   247\t       :refusal nil\n   248\t       :handle {:put-bytes-fn (fn [address bs]\n   249\t                               (let [verdict ((:put-bytes-fn front) address bs)]\n   250\t                                 (stream/append! ledger {::put address})\n   251\t                                 verdict))\n   252\t               :get-bytes-fn (:get-bytes-fn local)\n   253\t               :close-fn (fn []\n   254\t                           (when-not @closed?\n   255\t                             (vreset! closed? true)\n   256\t                             (try (when seam ((:close! seam)))\n   257\t                                  (finally\n   258\t                                    (jing/close! local)))))}})))\n   259\t\n   260\t\n   261\t(defn store\n   262\t  \"The node's `dao.jing` byte-store handle: put inserts into the local\n   263\t   store and asks the node to replicate, answering the local verdict at\n   264\t   once; get reads the local store; close closes the socket and the\n   265\t   local store.\"\n   266\t  [node]\n   267\t  (:handle node))\n   268\t\n   269\t\n   270\t(defn local\n   271\t  \"The node's own local `dao.jing` store.\"\n   272\t  [node]\n   273\t  (get-in node [:composition :local]))\n   274\t\n   275\t\n   276\t(defn node-id\n   277\t  \"The node's id: 64 lowercase hex characters.\"\n   278\t  [node]\n   279\t  (get-in node [:composition ::dht/id]))\n   280\t\n   281\t\n   282\t(defn announce!\n   283\t  \"Declare that the blobs put through `store` since the last announcement\n   284\t   are the publication whose manifest is `manifest-address`: `step`\n   285\t   reports it `:published`, acknowledged or not.\"\n   286\t  [node manifest-address]\n   287\t  (stream/append! (:ledger node) {::manifest manifest-address})\n   288\t  node)\n   289\t\n   290\t\n   291\t(defn close!\n   292\t  \"Close the node's socket and its local store.  Idempotent.\"\n   293\t  [node]\n   294\t  (jing/close! (:handle node)))\n   295\t\n   296\t\n   297\t;; =============================================================================\n   298\t;; step: ticks, binding, the DHT\n   299\t;; =============================================================================\n   300\t\n   301\t(defn- tick\n   302\t  [node now]\n   303\t  (let [origin (or (:origin node) now)\n   304\t        reading (max (or (:reading node) 0) (- now origin))]\n   305\t    (stream/append! (get-in node [:composition :ticks])\n   306\t                    {:dao.lease/event :dao.lease/tick\n   307\t                     :dao.lease/reading reading})\n   308\t    (assoc node :origin origin :reading reading)))\n   309\t\n   310\t\n   311\t(defn- bind-step\n   312\t  \"While the socket binds, read its lifecycle facts: bound completes the\n   313\t   composition with the writer over the address actually bound; a failed\n   314\t   bind refuses the node.\"\n   315\t  [node]\n   316\t  (if (or (:dht node) (:refusal node))\n   317\t    [node []]\n   318\t    (let [traffic (get-in node [:composition :traffic])]\n   319\t      (loop [cursor (:traffic-cursor node)]\n   320\t        (let [next (stream/next traffic cursor)\n   321\t              v (:dao.stream/value next)]\n   322\t          (case (:dao.stream/outcome next)\n   323\t            :dao.stream/ok\n   324\t            (case (:dao.stream.datagram/event v)\n   325\t              :dao.stream.datagram/bound\n   326\t              (let [{host :dao.stream.datagram/host\n   327\t                     port :dao.stream.datagram/port} (:dao.stream.datagram/local v)\n   328\t                    descriptor {:dao.stream/type datagram/transport-type\n   329\t                                :dao.stream/identity (:dao.stream.datagram/socket v)\n   330\t                                :dao.stream.datagram/bind-host host\n   331\t                                :dao.stream.datagram/bind-port port}\n   332\t                    composition (assoc (:composition node)\n   333\t                                       :datagrams\n   334\t                                       (datagram/writer (:seam node) descriptor\n   335\t                                                        (::dht/max-datagram\n   336\t                                                          dht/defaults)))]\n   337\t                [(assoc node\n   338\t                        :composition composition\n   339\t                        :dht (dht/state composition)\n   340\t                        :traffic-cursor nil)\n   341\t                 [{::event :bound :host host :port port :id (node-id node)}]])\n   342\t\n   343\t              :dao.stream.datagram/bind-failed\n   344\t              (let [reason (str (:dao.stream.datagram/reason v))]\n   345\t                [(assoc node :refusal (str \"the socket could not bind \"\n   346\t                                           (get-in node [:composition\n   347\t                                                         ::dht/bind-host])\n   348\t                                           \": \" reason))\n   349\t                 [{::event :bind-failed :reason reason}]])\n   350\t\n   351\t              (recur (:dao.stream/cursor next)))\n   352\t\n   353\t            :dao.stream/gap (recur (:dao.stream/cursor next))\n   354\t            [(assoc node :traffic-cursor cursor) []]))))))\n   355\t\n   356\t\n   357\t;; =============================================================================\n   358\t;; Publications: the ledger, and the facts that answer it\n   359\t;; =============================================================================\n   360\t\n   361\t(defn- read-all\n   362\t  \"Every value on `handle` after `cursor`: `[values cursor' gap?]`.\"\n   363\t  [handle cursor]\n   364\t  (loop [cursor cursor\n   365\t         acc []\n   366\t         gap? false]\n   367\t    (let [next (stream/next handle cursor)]\n   368\t      (case (:dao.stream/outcome next)\n   369\t        :dao.stream/ok (recur (:dao.stream/cursor next)\n   370\t                              (conj acc (:dao.stream/value next))\n   371\t                              gap?)\n   372\t        :dao.stream/gap (recur (:dao.stream/cursor next) acc true)\n   373\t        [acc cursor gap?]))))\n   374\t\n   375\t\n   376\t(defn- open-publications\n   377\t  \"Close the ledger's windows into publications: the blobs put since the\n   378\t   last announcement, up to the manifest announced.\"\n   379\t  [node]\n   380\t  (let [[entries cursor gap?] (read-all (:ledger node) (:ledger-cursor node))]\n   381\t    (reduce (fn [node entry]\n   382\t              (if-some [m (::manifest entry)]\n   383\t                (let [addresses (distinct (conj (:window node) m))]\n   384\t                  (-> node\n   385\t                      (update :publications conj\n   386\t                              {:manifest m\n   387\t                               :waiting (set addresses)\n   388\t                               :blobs (count addresses)\n   389\t                               :sent {}\n   390\t                               :refused {}})\n   391\t                      (assoc :window [])))\n   392\t                (update node :window conj (::put entry))))\n   393\t            (cond-> (assoc node :ledger-cursor cursor)\n   394\t              gap? (assoc :window []))\n   395\t            entries)))\n   396\t\n   397\t\n   398\t(defn- apply-fact\n   399\t  [publication {::dht/keys [fact address peers reason]}]\n   400\t  (if (contains? (:waiting publication) address)\n   401\t    (case fact\n   402\t      ::dht/sent (-> publication\n   403\t                     (update :waiting disj address)\n   404\t                     (assoc-in [:sent address] peers))\n   405\t      ::dht/unacknowledged (-> publication\n   406\t                               (update :waiting disj address)\n   407\t                               (assoc-in [:refused address]\n   408\t                                         {:reason reason :peers peers}))\n   409\t      publication)\n   410\t    publication))\n   411\t\n   412\t\n   413\t(defn- publication-event\n   414\t  [node {:keys [manifest blobs sent refused]}]\n   415\t  (if (empty? refused)\n   416\t    {::event :published :manifest manifest :blobs blobs\n   417\t     :acknowledged? true :peers (apply min (vals sent))}\n   418\t    (let [[_ {:keys [reason peers]}] (first (sort-by (comp str key) refused))]\n   419\t      {::event :published :manifest manifest :blobs blobs\n   420\t       :acknowledged? false :reason reason :peers peers\n   421\t       :ack-peers (::dht/ack-peers (:dht node) (::dht/ack-peers dht/defaults))})))\n   422\t\n   423\t\n   424\t(defn- settle-publications\n   425\t  \"Report every publication all of whose blobs the DHT has settled, in\n   426\t   publication order.  A lost fact reports the publications it may have\n   427\t   belonged to as unknown, never as acknowledged.\"\n   428\t  [node]\n   429\t  (let [[facts cursor gap?] (read-all (get-in node [:composition :facts])\n   430\t                                      (:facts node))\n   431\t        pubs (reduce (fn [pubs f] (mapv #(apply-fact % f) pubs))\n   432\t                     (:publications node)\n   433\t                     facts)]\n   434\t    (if gap?\n   435\t      [(assoc node :facts cursor :publications [])\n   436\t       (mapv #(hash-map ::event :publication-unknown :manifest (:manifest %))\n   437\t             pubs)]\n   438\t      [(assoc node\n   439\t              :facts cursor\n   440\t              :publications (filterv #(seq (:waiting %)) pubs))\n   441\t       (mapv #(publication-event node %)\n   442\t             (filterv #(empty? (:waiting %)) pubs))])))\n   443\t\n   444\t\n   445\t;; =============================================================================\n   446\t;; Loading a published index\n   447\t;; =============================================================================\n   448\t\n   449\t(defn- probing\n   450\t  \"`handle` whose miss throws naming the missing address, so an index\n   451\t   walk says what to fetch next.\"\n   452\t  [handle]\n   453\t  (let [absent #?(:cljd (Object.) :clj (Object.) :cljs (js-obj))]\n   454\t    {:get-bytes-fn (fn [address _not-found]\n   455\t                     (let [v ((:get-bytes-fn handle) address absent)]\n   456\t                       (if (identical? absent v)\n   457\t                         (throw (ex-info \"missing\" {::missing address}))\n   458\t                         v)))\n   459\t     :put-bytes-fn (fn [_ _] (throw (ex-info \"read only\" {})))\n   460\t     :close-fn (fn [] nil)}))\n   461\t\n   462\t\n   463\t(defn- missing-in\n   464\t  [e]\n   465\t  (loop [e e]\n   466\t    (when e\n   467\t      (or (get (ex-data e) ::missing)\n   468\t          (recur (ex-cause e))))))\n   469\t\n   470\t\n   471\t(defn index-datoms\n   472\t  \"The EAVT datoms of the covered index `manifest-address` names in\n   473\t   `handle`, walked whole: `dao.space.index/read-manifest`, then every\n   474\t   index root it names, each of which must cover exactly the manifest's\n   475\t   `:count` datoms.  Throws on a missing blob or an invalid index.\"\n   476\t  [handle manifest-address]\n   477\t  (let [manifest (index/read-manifest handle manifest-address)\n   478\t        walked (into {}\n   479\t                     (map (fn [[k root]]\n   480\t                            [k (vec (index/walk-index-datoms handle root))]))\n   481\t                     (:indexes manifest))]\n   482\t    (doseq [[k datoms] walked]\n   483\t      (when-not (= (:count manifest) (count datoms))\n   484\t        (throw (ex-info (str \"the \" (name k) \" index covers \" (count datoms)\n   485\t                             \" datoms, not the manifest's \" (:count manifest))\n   486\t                        {:index k :manifest manifest-address}))))\n   487\t    (or (:eavt walked) [])))\n   488\t\n   489\t\n   490\t(defn load-index\n   491\t  \"Start loading the published index `manifest-address` names into the\n   492\t   node's local store; `step` advances it and reports `:loaded` or\n   493\t   `:load-failed`.  A load already started, loaded or failed is left as\n   494\t   it is.  Answers the node.\"\n   495\t  [node manifest-address]\n   496\t  (when-not (jing/segment-address? manifest-address)\n   497\t    (throw (ex-info \"dao.space.dht/load-index takes a manifest address\"\n   498\t                    {:manifest manifest-address})))\n   499\t  (if (contains? (:loads node) manifest-address)\n   500\t    node\n   501\t    (assoc-in node [:loads manifest-address]\n   502\t              {:status :loading :fetching nil :fetched 0})))\n   503\t\n   504\t\n   505\t(defn load-status\n   506\t  \"`{:status :loading | :loaded | :failed ...}` for `manifest-address`, or\n   507\t   nil when no load was started: `:loaded` carries `:datoms` (the count)\n   508\t   and `:fetched` (blobs fetched from peers), `:failed` its `:reason`.\"\n   509\t  [node manifest-address]\n   510\t  (when-let [{:keys [status fetched datoms reason]}\n   511\t             (get-in node [:loads manifest-address])]\n   512\t    (cond-> {:status status :fetched fetched}\n   513\t      (= :loaded status) (assoc :datoms (count datoms))\n   514\t      (= :failed status) (assoc :reason reason))))\n   515\t\n   516\t\n   517\t(defn loaded-datoms\n   518\t  \"The EAVT datoms of a loaded index, or nil.\"\n   519\t  [node manifest-address]\n   520\t  (let [record (get-in node [:loads manifest-address])]\n     1\t(ns yin.repl.dht\n     2\t  \"The REPL's DHT index store, `--index-store dht:<dir>` (DHT epic slice\n     3\t   S5: docs/design/dao.jing.dht.md section 10; docs/design/\n     4\t   yin.repl.dao.space-index.md, \\\"DHT store\\\").  It is composed with the\n     5\t   plain Clojure path, `dao.space.dht`, and adds only what the shell owns:\n     6\t   the durable directory, the lines it prints, and when it admits\n     7\t   evaluation.\n     8\t\n     9\t   `open` opens `<dir>` exactly as `file:<dir>` does — the exclusive lock,\n    10\t   the content log, HEAD, the validated snapshot (yin.repl.store) — and\n    11\t   joins a `dao.space.dht` node with that locked store as its `:local`.\n    12\t   The indexer publishes through the node's store: each put inserts\n    13\t   locally and appends one replicate request, and the manifest reads back\n    14\t   locally, so a round never waits on the network.  The HEAD write then\n    15\t   announces the publication to the node.\n    16\t\n    17\t   `step` is the node's one step owner, called by the host's single\n    18\t   ticker (yin.repl.main/step-all) with the host's clock reading; it\n    19\t   renders the node's events as the lines the REPL prints: where the\n    20\t   socket bound, and for each publication whether it was acknowledged —\n    21\t   sent to N peers — or not, and why.\n    22\t\n    23\t   A reader handed a manifest address (`:manifest`) loads it through\n    24\t   `dao.space.dht/load-index` before the shell admits any evaluation, as a\n    25\t   restart installs its recovery first, then writes it to HEAD and\n    26\t   rehydrates the indexer from the loaded datoms, so `q` answers the\n    27\t   remote run's facts.  A load that cannot complete, or a socket that\n    28\t   cannot bind, refuses the shell (`refusal`); it never starts over an\n    29\t   empty index.  Remote indexes are also reachable at the prompt, through\n    30\t   the `dao.space.dht` host module (yin.repl.query), over the same node.\"\n    31\t  (:require [clojure.string :as str]\n    32\t            [dao.space.dht :as dht]\n    33\t            [yin.repl.index :as index]\n    34\t            [yin.repl.store :as store]))\n    35\t\n    36\t\n    37\t(def default-max-inbound-bytes\n    38\t  \"The CLI default of the inbound storage bound; `dao.space.dht`'s.\"\n    39\t  dht/default-max-inbound-bytes)\n    40\t\n    41\t\n    42\t(defn- refused-head\n    43\t  \"Why a reader cannot hydrate `manifest` into a directory whose own HEAD\n    44\t   already names `recovered`, or nil.  Hydration never replaces an index\n    45\t   the directory holds.\"\n    46\t  [dir manifest recovered]\n    47\t  (when (and manifest recovered (not= manifest recovered))\n    48\t    (str dir \" already holds an index (HEAD names \" recovered \"); hydrate \"\n    49\t         manifest \" into an empty directory\")))\n    50\t\n    51\t\n    52\t(defn open\n    53\t  \"Open a `dht:<dir>` store from its spec (yin.repl.store/checked-spec):\n    54\t   the durable directory store, and the `dao.space.dht` node joined over\n    55\t   it.  Answers the store handle the shell keeps — the node's store, with\n    56\t   the durable HEAD write announcing each publication, the recovery, and\n    57\t   the directory — carrying the node under `:dht`, which the shell moves\n    58\t   onto its own state (yin.repl/create-state).\"\n    59\t  [spec]\n    60\t  (let [{:keys [dir peers publish? bind-host bind-port max-inbound-bytes\n    61\t                manifest bind!]} (store/checked-spec spec)\n    62\t        base (store/open-durable dir)]\n    63\t    (try\n    64\t      (when-some [why (refused-head dir manifest\n    65\t                                    (get-in base [:recovery :manifest]))]\n    66\t        (throw (ex-info why {:dir dir :manifest manifest})))\n    67\t      (let [node (dht/join {:local base\n    68\t                            :peers peers\n    69\t                            :publish? publish?\n    70\t                            :bind-host bind-host\n    71\t                            :bind-port bind-port\n    72\t                            :max-inbound-bytes max-inbound-bytes\n    73\t                            :bind! (or bind! (dht/default-bind))})\n    74\t            node (cond-> (assoc node ::dir dir)\n    75\t                   (and manifest (not= manifest (get-in base [:recovery :manifest])))\n    76\t                   (-> (dht/load-index manifest)\n    77\t                       (assoc ::hydrating manifest)))]\n    78\t        (assoc (dht/store node)\n    79\t               :head-fn (fn [manifest-address]\n    80\t                          ((:head-fn base) manifest-address)\n    81\t                          (dht/announce! node manifest-address))\n    82\t               :recovery (:recovery base)\n    83\t               :durable-dir dir\n    84\t               :dht node))\n    85\t      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n    86\t        (store/close! base)\n    87\t        (throw e)))))\n    88\t\n    89\t\n    90\t(defn without-runner\n    91\t  \"The store handle the shell keeps: `open`'s answer without the node,\n    92\t   which the shell carries as its own `:dht`.  Any other handle is\n    93\t   answered as it is.\"\n    94\t  [handle]\n    95\t  (dissoc handle :dht))\n    96\t\n    97\t\n    98\t;; =============================================================================\n    99\t;; Lines\n   100\t;; =============================================================================\n   101\t\n   102\t(defn- address-text\n   103\t  [host port]\n   104\t  (if (str/includes? host \":\") (str \"[\" host \"]:\" port) (str host \":\" port)))\n   105\t\n   106\t\n   107\t(defn- reason-text\n   108\t  [node {:keys [reason peers ack-peers]}]\n   109\t  (case reason\n   110\t    :dao.jing.dht/solo (str \"solo — no --dht-peer is configured, so nothing \"\n   111\t                            \"was sent; the index is in \" (::dir node) \" only\")\n   112\t    :dao.jing.dht/unpublished (str \"publication is off — this node fetches \"\n   113\t                                   \"only; start with --dht-publish to share\")\n   114\t    :dao.jing.dht/too-few-peers (str \"too few peers — sent to \" peers \" of \"\n   115\t                                     ack-peers \" before the acknowledgement \"\n   116\t                                     \"deadline\")\n   117\t    :dao.jing.dht/oversize \"a blob exceeds the DHT message bound\"\n   118\t    :dao.jing.dht/absent \"a blob was no longer in the local store\"\n   119\t    :dao.jing.dht/busy \"too many writes were pending\"\n   120\t    (str reason)))\n   121\t\n   122\t\n   123\t(defn- event-line\n   124\t  [node {:keys [manifest blobs acknowledged? peers host port id reason datoms\n   125\t                fetched], :as event}]\n   126\t  (case (::dht/event event)\n   127\t    :bound (str \"dht: node \" (subs id 0 16) \" listening on \"\n   128\t                (address-text host port) \"; peers: \"\n   129\t                (str/join \", \" (map #(address-text (:host %) (:port %))\n   130\t                                    (:peers node)))\n   131\t                (if (:publish? node) \"; publishing\" \"; fetch-only\"))\n   132\t    :bind-failed (str \"dht: refused: the socket could not bind: \" reason)\n   133\t    :published (str \"dht: published \" manifest \" (\" blobs \" blobs) — \"\n   134\t                    (if acknowledged?\n   135\t                      (str \"acknowledged: sent to \" peers \" peers\")\n   136\t                      (str \"NOT acknowledged: \" (reason-text node event)\n   137\t                           \"; the local copy is durable\")))\n   138\t    :publication-unknown (str \"dht: published \" manifest\n   139\t                              \" — acknowledgement unknown: facts were lost\")\n   140\t    :loaded (str (if (= manifest (::hydrating node)) \"dht: hydrated \" \"dht: loaded \")\n   141\t                 manifest \" — \" datoms \" datoms, \" fetched \" blobs fetched\"\n   142\t                 (when (= manifest (::hydrating node)) \"; evaluation admitted\"))\n   143\t    :load-failed (str \"dht: \" (if (= manifest (::hydrating node)) \"refused: \" \"\")\n   144\t                      \"loading \" manifest \" failed: \" reason\n   145\t                      (when (= manifest (::hydrating node))\n   146\t                        \"; the remote index was not hydrated\"))\n   147\t    (pr-str event)))\n   148\t\n   149\t\n   150\t;; =============================================================================\n   151\t;; The step\n   152\t;; =============================================================================\n   153\t\n   154\t(defn- hydrated\n   155\t  \"Install the loaded remote index as this directory's: HEAD first, then\n   156\t   the indexer, exactly as a restart's recovery is installed.\"\n   157\t  [shell node]\n   158\t  (let [manifest (::hydrating node)\n   159\t        recovery {:manifest manifest :datoms (dht/loaded-datoms node manifest)}]\n   160\t    ((:head-fn (dht/local node)) manifest)\n   161\t    (-> shell\n   162\t        (update :indexer index/rehydrate recovery)\n   163\t        (assoc :index-recovery recovery\n   164\t               :dht (dissoc node ::hydrating)))))\n   165\t\n   166\t\n   167\t(defn step\n   168\t  \"Advance the shell's node once at the host's clock reading `now`\n   169\t   (dao.space.dht/step) and answer `[shell' lines]`: its events as lines,\n   170\t   a completed hydration installed, a failed one or a failed bind\n   171\t   recorded as the shell's refusal.  A shell without a DHT store is\n   172\t   answered unchanged.\"\n   173\t  [shell now]\n   174\t  (if-let [node (:dht shell)]\n   175\t    (let [[node events] (dht/step node now)\n   176\t          lines (mapv #(event-line node %) events)\n   177\t          hydrating (::hydrating node)\n   178\t          status (when hydrating (:status (dht/load-status node hydrating)))\n   179\t          node (cond-> node\n   180\t                 (and hydrating (= :failed status))\n   181\t                 (assoc ::refusal (str/join \"\\n\" (filter #(str/includes? % \"refused\")\n   182\t                                                         lines)))\n   183\t                 (dht/refusal node)\n   184\t                 (assoc ::refusal (dht/refusal node)))\n   185\t          shell (assoc shell :dht node)]\n   186\t      [(if (= :loaded status) (hydrated shell node) shell) lines])\n   187\t    [shell []]))\n   188\t\n   189\t\n   190\t(defn refusal\n   191\t  \"The text that refused the shell's DHT store after startup — a failed\n   192\t   bind or a hydration that could not complete — or nil.\"\n   193\t  [shell]\n   194\t  (get-in shell [:dht ::refusal]))\n   195\t\n   196\t\n   197\t(defn admitting?\n   198\t  \"True when the shell may evaluate: no hydration is outstanding and none\n   199\t   was refused.\"\n   200\t  [shell]\n   201\t  (let [node (:dht shell)]\n   202\t    (or (nil? node)\n   203\t        (and (nil? (::hydrating node)) (nil? (::refusal node))))))\n   204\t\n   205\t\n   206\t(defn busy?\n   207\t  \"True while the node owes the REPL a line; the ticker keeps its base\n   208\t   cadence then.\"\n   209\t  [shell]\n   210\t  (boolean (some-> (:dht shell) dht/busy?)))\n   211\t\n   212\t\n   213\t(defn banner\n   214\t  \"What the REPL states at startup about a DHT store spec, before the\n   215\t   node steps once — and so before anything is shared.\"\n   216\t  [{:keys [dir peers publish? bind-host bind-port]}]\n   217\t  (let [content (store/content-path dir)\n   218\t        peers-text (str/join \", \" (map #(address-text (:host %) (:port %)) peers))]\n   219\t    (cond-> []\n   220\t      (empty? peers)\n   221\t      (conj (str \"dht: solo — no --dht-peer, so no socket is opened; \"\n   222\t                 \"publications are durable in \" dir \" and acknowledged by no one\"))\n   223\t\n   224\t      (seq peers)\n   225\t      (conj (str \"dht: binding \" (address-text bind-host bind-port)\n   226\t                 (when (zero? bind-port) \" (ephemeral)\")\n   227\t                 \"; peers \" peers-text))\n   228\t\n   229\t      (and publish? (seq peers))\n   230\t      (conj (str \"dht: publishing is ON. Everything in \" content\n   231\t                 \" will be shared: the whole code index this directory holds\"\n   232\t                 \" — every program recovered from HEAD and every program\"\n   233\t                 \" evaluated from now on — with any peer that asks for its\"\n   234\t                 \" address. Omit --dht-publish to fetch only.\"))\n   235\t\n   236\t      (and publish? (empty? peers))\n   237\t      (conj (str \"dht: publishing is on, but solo: nothing in \" content\n   238\t                 \" leaves this process\"))\n   239\t\n   240\t      (and (not publish?) (seq peers))\n   241\t      (conj \"dht: fetch-only — nothing this node holds is shared (--dht-publish shares it)\"))))\n","exit_code":0,"status":"completed"}}
