         :recovery (:recovery base)\n    88\t               :durable-dir dir\n    89\t               :dht node))\n    90\t      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n    91\t        (store/close! base)\n    92\t        (throw e)))))\n    93\t\n   200\t;; =============================================================================\n   201\t\n   202\t(defn- hydrated\n   203\t  \"Install the loaded remote index as this directory's: HEAD first, then\n   204\t   the indexer, exactly as a restart's recovery is installed.\"\n   205\t  [shell node]\n   206\t  (let [manifest (::hydrating node)\n   207\t        recovery {:manifest manifest :datoms (dht/loaded-datoms node manifest)}]\n   208\t    ((:head-fn (dht/local node)) manifest)\n   209\t    (-> shell\n   210\t        (update :indexer index/rehydrate recovery)\n   211\t        (assoc :index-recovery recovery\n   212\t               :dht (dissoc node ::hydrating)))))\n   213\t\n   214\t\n   215\t(defn join-token\n   260\t              node\n   261\t              (and hydrating (= :failed status))\n   262\t              (assoc\n   263\t                ::refusal (str/join\n   264\t                            \"\\n\" (filter\n   265\t                                   #(str/includes?\n   266\t                                      %\n   267\t                                      \"refused\")\n   268\t                                   lines)))\n   269\t              (dht/refusal node)\n   270\t              (assoc ::refusal (dht/refusal node)))\n   271\t       shell (assoc shell :dht node)]\n   272\t      [(if (= :loaded status) (hydrated shell node) shell) lines events])\n   273\t    [shell [] []]))\n   274\t\n   275\t\n   276\t(defn refusal\n   277\t  \"The text that refused the shell's DHT store after startup (a failed\n   278\t   bind or a hydration that could not complete), or nil.\"\n   279\t  [shell]\n   280\t  (get-in shell [:dht ::refusal]))\n   281\t\n   282\t\n   283\t(defn admitting?\n   284\t 