gn/principal (:public key))]\n   677\t                (is (= [manifest next-manifest] @heads))\n   678\t                (is (= (inc published) (seq-at reader next-manifest)))\n   679\t                (is (= :duplicate\n   680\t                       (head/judge p published manifest\n   681\t                                   (head/trace key manifest published))))\n   682\t                (is (= :candidate\n   683\t                       (head/judge p published manifest\n   684\t                                   (head/trace key next-manifest\n   685\t                                               (inc published)))))))\n   686\t            (close! reader)))\n   687\t        (testing \"a different manifest: refused, HEAD unchanged, lock released\"\n   688\t          (let [held (head-manifest rdir)\n   689\t                other (jing/segment-key \"another index\")\n   690\t                e (refusal-of #(recorded-dht-store\n   691\t                                 (spec 74 {:manifest other})\n   692\t                                 heads))]\n   693\t            (is (some? e))\n   694\t            (is (str/includes? (ex-message e) (str held)))\n   695\t            (is (= held (head-manifest rdir)))\n   696\t            (is (= 2 (count @heads)))\n   697\t            (store/close! (repl.dht/open (spec 75 {}))))))\n   698\t      (finally\n   699\t        (run! cleanup-dir! [pdir rdir])))))\n   700\t\n   701\t\n   702\t(deftest a-manifest-no-peer-holds-refuses-the-reader\n   703\t  (let [dir (temp-dir)\n   704\t        net (mesh/mesh)\nsrc/cljc/dao/space/dht.cljc:255:        composition (cond-> {:local local\nsrc/cljc/dao/space/dht.cljc:271:                                      (subs (::dht/id composition) 0 16))\nsrc/cljc/dao/space/dht.cljc:289:     :composition composition\nsrc/cljc/dao/space/dht.cljc:290:     :dht (when-not socket? (dht/state composition))\nsrc/cljc/dao/space/dht.cljc:369:(defn local\nsrc/cljc/dao/space/dht.cljc:372:  (get-in node [:composition :local]