+(require '[yin.vm :as vm] '[yin.vm.linker :as l]
+         '[yin.vm.linker.publish :as p] '[yin.vm.linker-test :as lt]
+         '[yin.repl.link :as link] '[dao.jing.mem :as mem]
+         '[dao.jing :as jing] '[dao.stream :as s])
+(let [store (mem/create-content-mem)
+      tree (vm/ast->semantic-bytecode {:type :variable :name 'unresolved})
+      root (vm/materialize-tree! store tree)
+      rt (l/local-runtime store {:formats {:yin.ast/code l/ast-format}
+                                :indexes {:yin.ast/code {root root}}})
+      request {:yin.link/id [:probe 0] :yin.link/format :yin.ast/code
+               :yin.link/contract vm/ast-contract :yin.link/identity root}
+      run (fn [request]
+            (let [[st _] (l/request-link (:state rt) request)]
+              (loop [st st]
+                (let [r (l/step ((:drive rt) st) 32)]
+                  (if-let [c (first (:completions r))] c
+                    (recur (:state r)))))))]
+  (prn :ordinary-request (select-keys (run request) [:status :obligations]))
+  (prn :unscanned-request (select-keys (run (assoc request :yin.link/scan? false))
+                                     [:status :obligations]))
+  (jing/close! store))
+(let [store (mem/create-content-mem)
+      {:keys [ast exports]} ((ns-resolve 'yin.vm.linker-test 'wide-module) 30)
+      {:keys [address]} (p/publish-module! store {:name 'wide :ast ast :exports exports
+                                                :requires {} :primitives
+                                                (select-keys vm/primitives ['+ '*])})]
+  (doseq [policy [:verifying :trusted]]
+    (let [source (link/composition {:content-store store :name-env {'wide address}
+                                    :derivation policy})
+          pair (link/make-pair)]
+      (s/append! (:requests pair) {:yin.link/id [:probe 1] :yin.link/name 'wide
+                                   :yin.link/format :yin.debruijn.code
+                                   :yin.link/contract vm/stack-contract})
+      (loop [pair pair n 0]
+        (when (< n 3)
+          (let [r (link/serve {:pair pair :source source})]
+            (prn :serve policy :round n :pending (:pending r) :progress? (:progress? r))
+            (recur (:pair r) (inc n)))))))
+  (jing/close! store))
