   (.setDaemon true)\n   161\t                 (.start))]\n   162\t    {:label label\n   163\t     :process process\n   164\t     :lines lines\n   165\t     :reader reader\n   166\t     :stdin (io/writer (.getOutputStream process))}))\n   167\t\n   168\t\n   169\t(defn- spawn!\n   170\t  \"Start one REPL process — `command`, a `yin.repl.main` JVM by default,\n   171\t   then `args`.\"\n   172\t  ([label args] (spawn! label (jvm-command) args))\n   173\t  ([label command args]\n   174\t   (spawn-command! label (into (vec command) args))))\n   175\t\n   176\t\n   177\t(defn- type!\n   178\t  [{:keys [stdin]} line]\n   179\t  (.write ^java.io.Writer stdin (str line \"\\n\"))\n   180\t  (.flush ^java.io.Writer stdin))\n   181\t\n   182\t\n   183\t(defn- await-line\n   184\t  \"The first output line matching `re`, polling until `ms` pass.\"\n   185\t  [{:keys [lines]} re ms]\n   186\t  (let [deadline (+ (System/currentTimeMillis) ms)]\n   187\t    (loop []\n   188\t      (or (some #(when (re-find re %) %) @lines)\n   189\t          (when (< (System/currentTimeMillis) deadline)\n   190\t            (Thread/sleep 50)\n   191\t            (recur))))))\n   192\t\n   193\t\n   194\t(defn- index-of-match\n   195\t  [{:keys [lines]} re]\n   196\t  (first (keep-indexed (fn [i l] (when (re-find re l) i)) @lines)))\n   197\t\n   198\t\n   199\t(defn- stop!\n   200\t  [{:keys [process] :as p}]\n   201\t  (try (type! p \"(quit)\") (catch Exception _ nil))\n   202\t  (when-not (.waitFor ^Process process 20 TimeUnit/SECONDS)\n   203\t    (.destroyForcibly ^Process process)\n   204\t    (.waitFor ^Process process 10 TimeUnit/SECONDS)))\n   205\t\n   206\t\n   207\t(defn- transcript\n   208\t  [{:keys [label lines]}]\n   209\t  (str label \":\\n\" (str/join \"\\n\" @lines)))\n   210\t\n   211\t\n   212\t(def ^:private token-query\n   213\t  (str \"(dao.space.query/q (quote [:find ?s :where [?e :yin/value 4242 ?t ?m]\"\n   214\t       \" [?m :yin.repl/session ?s ?t1 ?m1]]) {:view :history})\"))\n   215\t\n   216\t\n   217\t(def ^:private remote-query\n   218\t  '[:find ?v :where [?e :yin/value ?v]])\n   219\t\n   220\t\n   221\t(defn- bound-port\n   222\t  \"The port a REPL process reported it bound, waiting for the report.\"\n   223\t  [p]\n   224\t  (some->> (await-line p listening startup-ms)\n   225\t           (re-find listening)\n   226\t           second\n   227\t           Long/parseLong))\n   228\t\n   229\t\n   230\t(deftest separate-jvm-processes-exchange-content-over-loopback\n   231\t  (let [anchor (start-anchor!)\n   232\t        dirs (vec (repeatedly 6 temp-dir))\n   233\t        peer #(str \"127.0.0.1:\" %)\n   234\t        procs (atom [])]\n   235\t    (try\n   236\t      (let [b (spawn! \"listener-b\" [\"--index-store\" (str \"dht:\" (dirs 1))\n   237\t                                    \"--dht-peer\" (peer (:port anchor))])\n   238\t            c (spawn! \"listener-c\" [\"--index-store\" (str \"dht:\" (dirs 2))\n   239\t                                    \"--dht-peer\" (peer (:port anchor))])\n   240\t            _ (swap! procs into [b c])\n   241\t            [pb pc] [(bound-port b) (bound-port c)]\n   242\t            _ (testing \"each listener binds an ephemeral port and reports it\"\n   243\t                (is (some? pb) (transcript b))\n   244\t                (is (some? pc) (transcript c)))\n   245\t            a (spawn! \"publisher-a\" [\"--index-store\" (str \"dht:\" (dirs 0))\n   246\t                                     \"--dht-peer\" (peer pb) \"--dht-peer\" (peer pc)\n   247\t                                     \"--dht-publish\"])\n   248\t            _ (swap! procs conj a)\n   249\t            pa (bound-port a)]\n   250\t        (testing \"the publisher binds and reports its address too\"\n   251\t          (is (some? pa) (transcript a)))\n   252\t        (testing \"the publisher's directory is locked against every other owner\"\n   253\t          (let [e (try (dht/close! (dht/join {:dir (dirs 0)})) nil\n   254\t                       (catch Exception e e))]\n   255\t            (is (some? e) \"a plain join in this process is refused\")\n   256\t            (is (str/includes? (str (ex-message e)) (dirs 0))))\n   257\t          (let [rival (spawn! \"rival-a\" [\"--index-store\" (str \"dht:\" (dirs 0))])]\n   258\t            (swap! procs conj rival)\n   259\t            (is (.waitFor ^Process (:process rival) 240 TimeUnit/SECONDS)\n   260\t                (transcript rival))\n   261\t            (is (= 1 (.exitValue ^Process (:process rival))) (transcript rival))\n   262\t            (is (some #(and (str/includes? % (dirs 0)) (str/includes? % \"locked\"))\n   263\t                      @(:lines rival))\n   264\t                (transcript rival))))\n   265\t        (testing \"the publisher stated what it would share before sharing\"\n   266\t          (is (await-line a #\"publishing is ON\\. Everything in .*content\\.jing will be shared\"\n   267\t                          1000)\n   268\t              (transcript a))\n   269\t          (is (await-line b #\"fetch-only\" 1000) (transcript b)))\n   270\t        (type! a \"(def answer 4242)\")\n   271\t        (let [published (await-line a #\"dht: published :segment/\\S+ .*acknowledged\"\n   272\t                                    exchange-ms)\n   273\t              manifest (second (re-find #\"dht: published :(segment/\\S+)\"\n   274\t                                        (str published)))]\n   275\t          (testing \"the publication is acknowledged: sent to 2 peers\"\n   276\t            (is (some? published) (transcript a))\n   277\t            (is (re-find #\"— acknowledged: sent to 2 peers\" (str published))\n   278\t                (transcript a)))\n   279\t          (testing \"the round printed its result before the network answered\"\n   280\t            (is (< (index-of-match a #\"^(yin> )*4242$\")\n   281\t                   (index-of-match a #\"dht: published\"))\n   282\t                (transcript a)))\n   283\t          (testing \"the publisher's HEAD names what it announced\"\n   284\t            (is (str/includes? (slurp (str (dirs 0) \"/HEAD\")) (str \":\" manifest))))\n   285\t          (type! a \"(require (quote dao.space.query))\")\n   286\t          (type! a token-query)\n   287\t          (let [own (await-line a #\"#\\{\\[\\\"[0-9a-f-]+\\\"\\]\\}\" exchange-ms)\n   288\t                token (second (re-find #\"\\\"([0-9a-f-]+)\\\"\" (str own)))\n   289\t                d (spawn! \"reader-d\" [\"--index-store\" (str \"dht:\" (dirs 3))\n   290\t                                      \"--dht-peer\" (peer pa)\n   291\t                                      \"--dht-manifest\" (str \":\" manifest)])]\n   292\t            (swap! procs conj d)\n   293\t            (is (some? token) (transcript a))\n   294\t            ;; Typed before the reader has hydrated: these lines wait in its\n   295\t            ;; input medium until the remote index is installed.\n   296\t            (type! d \"(require (quote dao.space.query))\")\n   297\t            (type! d token-query)\n   298\t            (testing \"the reader hydrates the remote index over the network\"\n   299\t              (is (await-line d (re-pattern (str \"dht: hydrated :\" manifest))\n   300\t                              startup-ms)\n   301\t                  (transcript d)))\n   302\t            (testing \"and q answers the publisher's fact under its token\"\n   303\t              (let [answer (await-line d #\"#\\{\\[\\\"[0-9a-f-]+\\\"\\]\\}\" exchange-ms)]\n   304\t                (is (some? answer) (transcript d))\n   305\t                (is (str/includes? (str answer) (str token)) (transcript d))\n   306\t                (is (< (index-of-match d #\"dht: hydrated\")\n   307\t                       (index-of-match d #\"#\\{\\[\\\"\"))\n   308\t                    \"the typed lines ran only once the index was installed\")))\n   309\t            (testing \"the reader's own rounds continue that index, unshared\"\n   310\t              ;; Its require and q rounds each published over the hydrated\n   311\t              ;; index, so its HEAD has moved past the manifest it fetched,\n   312\t              ;; and publishing is off, so none of it left the process.\n   313\t              (is (await-line d #\"dht: published :segment/\\S+ .*NOT acknowledged: publication is off\"\n   314\t                              exchange-ms)\n   315\t                  (transcript d))\n2: {test:clj {:doc \"Run JVM tests (via clj); the DHT process test needs the Node REPL build\"\n3:            :depends [build:yin-repl-node]\n6:  build:yin-repl-node\n12:  test:cljs {:doc \"Run Node tests (via shadow-cljs with :cljs alias)\"\n23:   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n24:   ;; `bb test:cljs` without it skips those tests with a printed notice\n30:  test:cljd {:doc \"Run Dart tests (via clojure -M:cljd)\"\n35:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}}}\n","exit_code":0,"status":"completed"}}
