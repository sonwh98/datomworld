st.cljc:601:           (fs/unlock! (:lock outcome))\ntest/yin/repl/store_test.cljc:606:           (is (= #{rival} (claim-files dir))\ntest/yin/repl/store_test.cljc:607:               \"the rival's claim survives; the dead owner's is gone and\ntest/yin/repl/store_test.cljc:623:         ;; crashed too, after its claim and before it finished.\ntest/yin/repl/store_test.cljc:631:           (is (not-any? #{dead-owner dead-contender} (claim-files dir))\ntest/yin/repl/store_test.cljc:632:               \"both crashed claims are reclaimed, with no operator\")\ntest/yin/repl/store_test.cljc:640:   (def ^:private worker-contender-js\ntest/yin/repl/store_test.cljc:641:     \"One Node worker thread contending for the directory with this build's\ntest/yin/repl/store_test.cljc:642:      own `dao.space.store.fs/lock!`.  It loads the compiled test bundle's\ntest/yin/repl/store_test.cljc:644:      and the runner's autorun — so the worker has its own `held`\ntest/yin/repl/store_test.cljc:645:      registry and shares the process's pid, exactly like a second worker\ntest/yin/repl/store_test.cljc:652:       \"const {workerData} = require('worker_threads');\\n\"\ntest/yin/repl/store_test.cljc:654:       \"const {sab, bundle, dir, id} = workerData;\\n\"\ntest/yin/repl/store_test.cljc:666:       \"let held = null;\\n\"\ntest/yin/repl/store_test.cljc:667:       \"for (let i = 0; i < 50 && held === null; i++) {\\n\"\ntest/yin/repl/store_test.cljc:668:       \"  try { held = fsns.lock_BANG_(dir); }\\n\"\ntest/yin/repl/store_test.cljc:671:       \"Atomics.store(flags, 2 + id, held === null ? 2 : 1); Atomics.notify(flags, 2 + id);\\n\"\ntest/yin/repl/store_test.cljc:672:       \"if (held !== null) {\\n\"\ntest/yin/repl/store_test.cljc:674:       \"  fsns.unlock_BANG_(held);\\n\"\ntest/yin/repl/store_test.cljc:681:   (deftest two-worker-threads-of-one-process-never-both-own-the-directory\ntest/yin/repl/store_test.cljc:683:           Worker (.-Worker (js/require \"worker_threads\"))\ntest/yin/rep