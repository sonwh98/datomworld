eftest is testing]]\n    30\t            [dao.jing.dht :as jing.dht]\n    31\t            [dao.jing.mem :as mem]\n    32\t            [dao.space.dht :as dht]\n    33\t            [dao.stream :as stream]\n    34\t            [dao.stream.datagram :as datagram]\n    35\t            [dao.stream.datagram.jvm :as datagram.jvm]\n    36\t            [dao.stream.ringbuffer :as ringbuffer])\n    37\t  (:import (java.util.concurrent TimeUnit)))\n    38\t\n    39\t\n    40\t(def ^:private startup-ms\n    41\t  \"Bound on one JVM REPL's startup: it loads the whole shell from source.\"\n    42\t  240000)\n    43\t\n    44\t\n    45\t(def ^:private exchange-ms\n    46\t  \"Bound on one network outcome once every process is up.\"\n    47\t  60000)\n    48\t\n    49\t\n    50\t(defn- ring\n    51\t  []\n    52\t  (:dao.stream/handle\n    53\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    54\t                         ringbuffer/capacity-key 4096})))\n    55\t\n    56\t\n    57\t(defn- start-anchor!\n    58\t  \"The first node: a `dao.jing.dht` core node on an ephemeral loopback\n    59\t   port, which needs no bootstrap contact to hold a socket, stepped by\n    60\t   one owner thread with its monotonic clock as ticks.  Answers `{:port p\n    61\t   :stop! f}`.\"\n    62\t  []\n    63\t  (let [traffic (ring)\n    64\t        seam (datagram.jvm/bind! {:identity \"anchor\" :deposit traffic\n    65\t                                  :bind-host \"127.0.0.1\" :bind-port 0\n    66\t                                  :max-bytes 1200})\n    67\t        bound (loop []\n    68\t                (let [r (stream/next traffic\n    69\t                                     (:dao.stream/cursor\n    70\t                                       (stream/cursor traffic :dao.stream/oldest)))]\n    71\t                  (if (= :dao.stream/ok (:dao.stream/outcome r))\n    72\t                    (:dao.stream/value r)\n    73\t                    (do (Thread/sleep 5) (recur)))))\n    74\t        port (get-in bound [:dao.stream.datagram/local :dao.stream.datagram/port])\n    75\t        ticks (ring)\n    76\t        state (jing.dht/state\n    77\t                {:local (mem/create-content-mem)\n    78\t                 :requests (ring) :answers (ring) :facts (ring) :ticks ticks\n    79\t                 :traffic traffic\n    80\t                 :datagrams (datagram/writer\n    81\t                              seam\n    82\t                              {:dao.stream/type datagram/transport-type\n    83\t                               :dao.stream/identity \"anchor\"\n    84\t                               :dao.stream.datagram/bind-host \"127.0.0.1\"\n    85\t                               :dao.stream.datagram/bind-port port}\n    86\t                              1200)\n    87\t                 ::jing.dht/id (jing.dht/bytes->hex (dht/secure-random-bytes 32))\n    88\t                 ::jing.dht/secret (dht/secure-random-bytes 32)\n    89\t                 ::jing.dht/max-inbound-bytes 0})\n    90\t        running (atom true)\n    91\t        origin (System/nanoTime)\n    92\t        thread (doto (Thread.\n    93\t                       ^Runnable\n    94\t                       (fn []\n    95\t                         (loop [state state]\n    96\t                           (when @running\n    97\t                             (stream/append! ticks\n    98\t                                             {:dao.lease/event :dao.lease/tick\n    99\t                                              :dao.lease/reading\n   100\t                                              (quot (- (System/nanoTime) origin)\n   101\t                                                    1000000)})\n   102\t                             (let [state (jing.dht/step state 64)]\n   103\t                               (Thread/sleep 5)\n   104\t                               (recur state)))))\n   105\t                       \"dht-process-anchor\")\n   106\t                 (.setDaemon true