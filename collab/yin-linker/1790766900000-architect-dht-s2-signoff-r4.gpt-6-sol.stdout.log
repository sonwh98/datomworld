{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/jing/dht.cljc | sed -n '290,390p;760,830p;1020,1100p;1130,1175p'; nl -ba test/dao/jing/dht_test.cljc | sed -n '345,390p;750,845p'\"","aggregated_output":"   290\t  (update state\n   291\t          :table\n   292\t          (fn [t]\n   293\t            (kad/observe (forget-address t host port)\n   294\t                         (::id state)\n   295\t                         {:id id, :host host, :port port}))))\n   296\t\n   297\t\n   298\t(defn- fresh?\n   299\t  \"A peer is fresh when a matched reply from it arrived within the last\n   300\t   cookie-epoch-ticks, by this node's own ticks.\"\n   301\t  [state pkey]\n   302\t  (let [seen (get-in state [:seen pkey])\n   303\t        now (:now state)]\n   304\t    (and (some? seen)\n   305\t         (some? now)\n   306\t         (< (- now seen) (::cookie-epoch-ticks state)))))\n   307\t\n   308\t\n   309\t;; =============================================================================\n   310\t;; Queries\n   311\t;; =============================================================================\n   312\t\n   313\t(defn- mint-q\n   314\t  [state host port]\n   315\t  (loop []\n   316\t    (let [q (rand-int 2147483647)]\n   317\t      (if (contains? (:queries state) [host port q]) (recur) q))))\n   318\t\n   319\t\n   320\t(defn- op-record\n   321\t  [state owner]\n   322\t  (get-in state owner))\n   323\t\n   324\t\n   325\t(defn- query-message\n   326\t  \"The request a query sends: its op's fields, the peer's cookie when this\n   327\t   node holds one, and padding otherwise (only a :ping is ever sent\n   328\t   without a cookie).\"\n   329\t  [state {:keys [op q owner]} cookie]\n   330\t  (let [record (op-record state owner)\n   331\t        m (cond-> {::v 1, :op op, :q q, :id (hex->bytes (::id state))}\n   332\t            (= :find op) (assoc :target (hex->bytes (:target record)))\n   333\t            (= :store op) (assoc :address (:address record)\n   334\t                                 :bytes ((:get-bytes-fn (:local state))\n   335\t                                         (:address record)\n   336\t                                         nil))\n   337\t            (= :fetch op) (assoc :address (:address record)))]\n   338\t    (if cookie (assoc m :cookie cookie) (padded m))))\n   339\t\n   340\t\n   341\t(defn- add-query\n   342\t  \"Record a pending query under its key and in its owner's index entry, so\n   343\t   an operation visits only its own queries.\"\n   344\t  [state qkey query]\n   345\t  (-> state\n   346\t      (assoc-in [:queries qkey] query)\n   347\t      (update-in [:query-index (:owner query)] (fnil conj #{}) qkey)))\n   348\t\n   349\t\n   350\t(defn- remove-query\n   351\t  \"Forget a pending query and its index entry; an owner left with no\n   352\t   queries leaves the index.\"\n   353\t  [state qkey]\n   354\t  (if-let [owner (get-in state [:queries qkey :owner])]\n   355\t    (let [left (disj (get-in state [:query-index owner]) qkey)]\n   356\t      (-> state\n   357\t          (update :queries dissoc qkey)\n   358\t          (update :query-index\n   359\t                  #(if (empty? left) (dissoc % owner) (assoc % owner left)))))\n   360\t    state))\n   361\t\n   362\t\n   363\t(defn- issue\n   364\t  \"Send one query for owner to peer pkey. Returns [state' outcome]: with\n   365\t   no cookie held the query is a padded :ping whatever the purpose; a\n   366\t   :store additionally needs a fresh peer. A query the socket refused is\n   367\t   not recorded.\"\n   368\t  [state owner [host port :as pkey] purpose]\n   369\t  (let [cookie (get-in state [:cookies pkey])\n   370\t        op (case purpose\n   371\t             :lookup (if cookie :find :ping)\n   372\t             :fetch (if cookie :fetch :ping)\n   373\t             :store (if (and cookie (fresh? state pkey)) :store :ping))\n   374\t        q (mint-q state host port)\n   375\t        query {:op op, :q q, :owner owner, :pkey pkey, :purpose purpose,\n   376\t               :sent (:now state), :resent? false}\n   377\t        outcome (send-datagram! state host port\n   378\t                                (query-message state query cookie))]\n   379\t    (if (= :dao.stream/ok outcome)\n   380\t      [(add-query state [host port q] query) outcome]\n   381\t      [state outcome])))\n   382\t\n   383\t\n   384\t(defn- owner-queries\n   385\t  \"Owner's pending queries, visited through the index alone.\"\n   386\t  [state owner]\n   387\t  (keep #(get (:queries state) %) (get-in state [:query-index owner])))\n   388\t\n   389\t\n   390\t(defn- drop-owner\n   760\t          (take max-find-peers (when (sequential? peers) peers))))\n   761\t\n   762\t\n   763\t(defn- route-reply\n   764\t  \"Route a matched, full reply to the operation that owns its query.\"\n   765\t  [state query m]\n   766\t  (let [owner (:owner query)\n   767\t        pkey (:pkey query)]\n   768\t    (if-not (op-record state owner)\n   769\t      state\n   770\t      (case (:op query)\n   771\t        :find (-> state\n   772\t                  (update-in (conj owner :answered) conj pkey)\n   773\t                  (hint owner (:peers m)))\n   774\t        :store (if (true? (:ok m))\n   775\t                 (update-in state (conj owner :confirmed) inc)\n   776\t                 state)\n   777\t        :fetch (let [address (:address (op-record state owner))\n   778\t                     bs (when (and (true? (:found m))\n   779\t                                   (wire/byte-payload? (:bytes m)))\n   780\t                          (verified-bytes address (:bytes m)))]\n   781\t                 (if bs\n   782\t                   (let [verdict ((:put-bytes-fn (:local state)) address bs)]\n   783\t                     (when-not (#{:inserted :present} verdict)\n   784\t                       (throw (ex-info \"dao.jing.dht: invalid local put result\"\n   785\t                                       {:address address, :result verdict})))\n   786\t                     (finish-get state owner bs nil))\n   787\t                   (update-in state (conj owner :fetched) conj pkey)))\n   788\t        state))))\n   789\t\n   790\t\n   791\t(defn- on-reply\n   792\t  \"A reply is matched by [observed source, :q] against a pending query sent\n   793\t   to that address; anything else is dropped. A reply arriving after its\n   794\t   query's deadline is dropped too: the query stays pending, and its\n   795\t   owner's own advance records the failed try, so no verdict depends on\n   796\t   which operations a budgeted step reached. A need-cookie reply's cookie\n   797\t   rides one re-send, without consuming a try; a full reply proves and\n   798\t   freshens the peer.\"\n   799\t  [state host port m]\n   800\t  (let [qkey [host port (:q m)]\n   801\t        query (get-in state [:queries qkey])\n   802\t        pkey [host port]]\n   803\t    (cond\n   804\t      (not (and query\n   805\t                (bytes-of? (:id m) id-length)\n   806\t                (bytes-of? (:cookie m) cookie-length)))\n   807\t      state\n   808\t\n   809\t      (let [sent (:sent query)\n   810\t            now (:now state)]\n   811\t        (and sent now (>= (- now sent) (::query-ticks state))))\n   812\t      state\n   813\t\n   814\t      ;; the need-cookie reply's cookie is untrusted: it rides the one\n   815\t      ;; resend and is kept only once a full reply carries it\n   816\t      (true? (:need-cookie m))\n   817\t      (let [owner (:owner query)]\n   818\t        (cond\n   819\t          (:resent? query) state\n   820\t          (nil? (op-record state owner)) (remove-query state qkey)\n   821\t          :else\n   822\t          (let [query (assoc query :resent? true :sent (:now state))\n   823\t                outcome (send-datagram! state host port\n   824\t                                        (query-message state query\n   825\t                                                       (:cookie m)))]\n   826\t            (if (= :dao.stream/ok outcome)\n   827\t              (assoc-in state [:queries qkey] query)\n   828\t              ;; a refused resend is a failed send, as in issue\n   829\t              (-> state\n   830\t                  (remove-query qkey)\n  1020\t         left budget]\n  1021\t    (let [reader (get state reader-key)\n  1022\t          cursor (get state cursor-key)]\n  1023\t      (cond\n  1024\t        (contains? stream/standard-anchors cursor)\n  1025\t        (let [r (stream/cursor reader cursor)]\n  1026\t          (if (= :dao.stream/ok (:dao.stream/outcome r))\n  1027\t            (recur (assoc state cursor-key (:dao.stream/cursor r)) left)\n  1028\t            state))\n  1029\t\n  1030\t        (not (pos? left)) state\n  1031\t\n  1032\t        :else\n  1033\t        (let [r (stream/next reader cursor)\n  1034\t              outcome (:dao.stream/outcome r)]\n  1035\t          (cond\n  1036\t            (= :dao.stream/ok outcome)\n  1037\t            (recur (f (assoc state cursor-key (:dao.stream/cursor r))\n  1038\t                      (:dao.stream/value r))\n  1039\t                   (dec left))\n  1040\t\n  1041\t            (= :dao.stream/gap outcome)\n  1042\t            (recur (-> (assoc state cursor-key (:dao.stream/cursor r))\n  1043\t                       (fact {::fact ::gap, ::stream stream-name}))\n  1044\t                   (dec left))\n  1045\t\n  1046\t            :else state))))))\n  1047\t\n  1048\t\n  1049\t;; =============================================================================\n  1050\t;; Stage 4: advance pending work\n  1051\t;; =============================================================================\n  1052\t\n  1053\t(defn- expire-queries\n  1054\t  \"A query past query-ticks is a failed try: the peer's cookie is\n  1055\t   discarded (the query may have been dropped in silence), so the next try\n  1056\t   is a padded :ping; a peer out of tries is dead for that operation and\n  1057\t   leaves the table. A query sent before the first tick starts its clock\n  1058\t   at the first reading. Only owner's queries are expired: expiry is part of\n  1059\t   advancing that one operation, so it shares the step's budget.\"\n  1060\t  [state owner]\n  1061\t  (let [now (:now state)]\n  1062\t    (reduce\n  1063\t      (fn [state [qkey {:keys [sent pkey]}]]\n  1064\t        (cond\n  1065\t          (nil? sent) (assoc-in state [:queries qkey :sent] now)\n  1066\t          (< (- now sent) (::query-ticks state)) state\n  1067\t          :else\n  1068\t          (let [state (-> state\n  1069\t                          (remove-query qkey)\n  1070\t                          (update :cookies dissoc pkey)\n  1071\t                          (update-in (conj owner :failures pkey) (fnil inc 0)))]\n  1072\t            (if (>= (get-in state (conj owner :failures pkey)) (::tries state))\n  1073\t              (-> state\n  1074\t                  (update-in (conj owner :dead) conj pkey)\n  1075\t                  (update :table forget-address (first pkey) (second pkey)))\n  1076\t              state))))\n  1077\t      state\n  1078\t      (if now\n  1079\t        (keep (fn [qkey]\n  1080\t                (when-let [query (get (:queries state) qkey)] [qkey query]))\n  1081\t              (get-in state [:query-index owner]))\n  1082\t        []))))\n  1083\t\n  1084\t\n  1085\t(defn- advance\n  1086\t  \"Advance at most budget pending operations, round robin: the operations\n  1087\t   are taken in order after :advance-cursor (the last one advanced),\n  1088\t   wrapping, and the cursor moves to the last one taken. Each taken\n  1089\t   operation first expires its own queries, then advances.\"\n  1090\t  [state budget]\n  1091\t  (let [owners (vec (sort (concat (map (fn [a] [:writes a])\n  1092\t                                       (keys (:writes state)))\n  1093\t                                  (map (fn [a] [:gets a])\n  1094\t                                       (keys (:gets state))))))\n  1095\t        after (:advance-cursor state)\n  1096\t        start (or (first (keep-indexed (fn [i o]\n  1097\t                                         (when (or (nil? after)\n  1098\t                                                   (pos? (compare o after)))\n  1099\t                                           i))\n  1100\t                                       owners))\n  1130\t  (ex-info (str \"dao.jing.dht: \" message) data))\n  1131\t\n  1132\t\n  1133\t(defn state\n  1134\t  \"Validate a composition (section 2) and return the DHT's state: a plain\n  1135\t   map of its handles, cursors, limits, routing table and pending tables.\n  1136\t   Throws on a composition defect; performs no stream operation.\"\n  1137\t  [composition]\n  1138\t  (let [c (merge defaults composition)\n  1139\t        {:keys [local requests answers facts ticks traffic datagrams]} c\n  1140\t        ack-peers (::ack-peers c)]\n  1141\t    (when-not (and (ifn? (:put-bytes-fn local)) (ifn? (:get-bytes-fn local)))\n  1142\t      (throw (defect \"composition needs a :local byte-store handle\"\n  1143\t                     {:local local})))\n  1144\t    (when-not (and requests (stream/reader? requests))\n  1145\t      (throw (defect \"composition needs a :requests reader\" {})))\n  1146\t    (when-not (and answers (stream/writer? answers))\n  1147\t      (throw (defect \"composition needs an :answers writer\" {})))\n  1148\t    (when-not (and facts (stream/writer? facts))\n  1149\t      (throw (defect \"composition needs a :facts writer\" {})))\n  1150\t    (when-not (and ticks (stream/reader? ticks))\n  1151\t      (throw (defect \"composition needs a :ticks reader\" {})))\n  1152\t    (when-not (= (some? traffic) (some? datagrams))\n  1153\t      (throw (defect \":traffic and :datagrams are composed together or not\"\n  1154\t                     {})))\n  1155\t    (when (and traffic\n  1156\t               (not (and (stream/reader? traffic) (stream/writer? datagrams))))\n  1157\t      (throw (defect \":traffic must be a reader and :datagrams a writer\" {})))\n  1158\t    (when-not (node-id? (::id c))\n  1159\t      (throw (defect \"the node id must be 64 lowercase hex characters\"\n  1160\t                     {:id (::id c)})))\n  1161\t    (when-not (and (integer? ack-peers) (<= 2 ack-peers kad/k))\n  1162\t      (throw (defect \"ack-peers must be an integer from 2 to k\"\n  1163\t                     {:ack-peers ack-peers, :k kad/k})))\n  1164\t    (merge c\n  1165\t           {:requests-cursor (get c :requests-cursor :dao.stream/oldest)\n  1166\t            :ticks-cursor (get c :ticks-cursor :dao.stream/oldest)\n  1167\t            :traffic-cursor (get c :traffic-cursor :dao.stream/oldest)\n  1168\t            :now nil\n  1169\t            :table {}\n  1170\t            :cookies {}\n  1171\t            :seen {}\n  1172\t            :queries {}\n  1173\t            :query-index {}\n  1174\t            :writes {}\n  1175\t            :gets {}\n   345\t            (mesh/request! a {::dht/replicate address})\n   346\t            (drive states comps 6000 6)\n   347\t            (is (= {::dht/fact ::dht/sent, ::dht/address address,\n   348\t                    ::dht/peers 2}\n   349\t                   (last (fact-of a ::dht/sent))))))))))\n   350\t\n   351\t\n   352\t(defn- at-port?\n   353\t  [port]\n   354\t  #(= [mesh/host port] [(:host %) (:port %)]))\n   355\t\n   356\t\n   357\t(deftest a-query-that-times-out-is-retried-then-its-peer-is-dead\n   358\t  (let [net (mesh/mesh)\n   359\t        comps (grid net [1 2 3] {})\n   360\t        a (comps 1)\n   361\t        _ (mesh/request! a (put-request \"w1\" [:proves 2 3]))\n   362\t        states (drive (start comps) comps 0 6)]\n   363\t    (is (some (at-port? 3) (dht/routing-entries (states 1))) \"3 is proven\")\n   364\t    ;; node 3 goes silent; at 60000 no peer is fresh, so both are pinged\n   365\t    (mesh/leave! net 3)\n   366\t    (mesh/request! a (put-request \"t\" [:timeout]))\n   367\t    ;; time advances 100 ticks per round, so node 2's replies arrive within\n   368\t    ;; their query deadline (a reply read after it is dropped)\n   369\t    (let [tick-rounds (fn [states from to]\n   370\t                        (reduce (fn [states t] (drive states comps t 1))\n   371\t                                states\n   372\t                                (range from to 100)))\n   373\t          states (tick-rounds states 60000 61100)]\n   374\t      (is (some (at-port? 3) (dht/routing-entries (states 1)))\n   375\t          \"two timed-out tries: still an entry\")\n   376\t      (let [states (tick-rounds states 61100 61600)]\n   377\t        (is (not-any? (at-port? 3) (dht/routing-entries (states 1)))\n   378\t            \"the third timed-out try: dead, removed from the table\")\n   379\t        (is (some (at-port? 2) (dht/routing-entries (states 1))))\n   380\t        (drive states comps 65000 1)\n   381\t        (is (= [{::dht/fact ::dht/unacknowledged,\n   382\t                 ::dht/address (jing/segment-key [:timeout]),\n   383\t                 ::dht/reason ::dht/too-few-peers, ::dht/peers 1,\n   384\t                 ::dht/local :inserted}]\n   385\t               (fact-of a ::dht/unacknowledged)))))))\n   386\t\n   387\t\n   388\t(deftest every-at-once-unacknowledged-reason\n   389\t  (testing \"solo: answered in the step that reads the request\"\n   390\t    (let [c (mesh/solo)\n   750\t  []\n   751\t  (let [net (mesh/mesh)\n   752\t        a (mesh/join! net 1 {::dht/publish? true\n   753\t                             ::dht/bootstrap [(mesh/contact 2)]})\n   754\t        b (mesh/join! net 2 {::dht/publish? true})]\n   755\t    (mesh/tick! a 0)\n   756\t    (mesh/tick! b 0)\n   757\t    (mesh/request! a (put-request \"n\" [:need-cookie]))\n   758\t    (let [sa (dht/step (dht/state a) 64)\n   759\t          sb (dht/step (dht/state b) 64)]\n   760\t      {:net net, :sa sa, :sb sb})))\n   761\t\n   762\t\n   763\t(deftest query-expiry-is-bounded-by-the-budget\n   764\t  ;; expiring a query is pending work too: only the operations a step\n   765\t  ;; advances have their queries expired in that step\n   766\t  (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   767\t                                     ::dht/bootstrap [(mesh/contact 2)]})\n   768\t        expired (fn [s] (count (filter #(seq (:failures %)) (vals (:writes s)))))]\n   769\t    (doseq [i (range 5)]\n   770\t      (mesh/request! c (put-request (str \"e\" i) [:expiry i])))\n   771\t    (mesh/tick! c 0)\n   772\t    (let [s (dht/step (dht/state c) 16)]\n   773\t      (is (= [0 5] [(expired s) (count (:queries s))]))\n   774\t      (mesh/tick! c 500)\n   775\t      (let [s1 (dht/step s 2)\n   776\t            s2 (dht/step s1 2)\n   777\t            s3 (dht/step s2 2)]\n   778\t        (is (= [2 4 5] (map expired [s1 s2 s3]))\n   779\t            \"each budget-2 step expires the queries of two operations\")))))\n   780\t\n   781\t\n   782\t(deftest a-reply-after-its-query-deadline-is-dropped\n   783\t  ;; a write skipped by a budget-1 step keeps its expired queries pending\n   784\t  ;; until its own advance; a reply arriving meanwhile must not count\n   785\t  (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   786\t                                     ::dht/bootstrap [(mesh/contact 2)\n   787\t                                                      (mesh/contact 3)]})]\n   788\t    (mesh/request! c (put-request \"x\" [:late 1]))\n   789\t    (mesh/request! c (put-request \"y\" [:late 2]))\n   790\t    (mesh/tick! c 0)\n   791\t    (let [s (dht/step (dht/state c) 16)\n   792\t          _ (is (= 4 (count (:queries s))) \"each write pinged 2 and 3\")\n   793\t          _ (mesh/tick! c 600)\n   794\t          s (dht/step s 1)\n   795\t          late (filter #(= 0 (:sent (val %))) (:queries s))]\n   796\t      (is (= 2 (count late)) \"the skipped write's queries: expired, pending\")\n   797\t      (doseq [[[_ port q] _] late]\n   798\t        (inject! c port {::dht/v 1, :op :reply, :q q,\n   799\t                         :id (dht/hex->bytes (mesh/node-id port)),\n   800\t                         :cookie (dht/cookie-for 0 mesh/host 1),\n   801\t                         :ok true}))\n   802\t      ;; budget 2: both late replies are read, and the round robin advances\n   803\t      ;; the skipped write first\n   804\t      (let [s (dht/step s 2)]\n   805\t        (is (empty? (fact-of c ::dht/sent)) \"no acknowledgement from a late reply\")\n   806\t        (is (empty? (dht/routing-entries s)) \"the late reply proves no peer\")\n   807\t        (is (empty? (:seen s)) \"and freshens none\")\n   808\t        (is (= 2 (count (filter #(seq (:failures %)) (vals (:writes s)))))\n   809\t            \"the skipped write recorded its failed tries in its own advance\")))))\n   810\t\n   811\t\n   812\t(defn- queries-by-owner\n   813\t  [s]\n   814\t  (reduce (fn [m [qkey query]] (update m (:owner query) (fnil conj #{}) qkey))\n   815\t          {}\n   816\t          (:queries s)))\n   817\t\n   818\t\n   819\t(deftest queries-are-indexed-by-owner\n   820\t  ;; an operation visits only its own queries: the index must always equal\n   821\t  ;; the grouping of :queries by owner, and forget finished operations\n   822\t  (let [net (mesh/mesh)\n   823\t        comps (grid net [1 2 3] {})]\n   824\t    (mesh/request! (comps 1) (put-request \"i\" [:indexed]))\n   825\t    (mesh/request! (comps 2) (get-request \"j\" [:nowhere-indexed]))\n   826\t    (mesh/tick-all! comps 0)\n   827\t    (let [states (loop [states (start comps)\n   828\t                        n 0]\n   829\t                   (doseq [[p s] states]\n   830\t                     (is (= (queries-by-owner s) (:query-index s))\n   831\t                         (str \"node \" p \", round \" n)))\n   832\t                   (if (< n 12) (recur (mesh/step-all states 1) (inc n)) states))]\n   833\t      (is (= [{} {}] [(:writes (states 1)) (:gets (states 2))]) \"all finished\")\n   834\t      (is (every? #(= {} (:query-index %)) (vals states)))))\n   835\t  (testing \"an operation dropped with queries pending leaves no index entry\"\n   836\t    ;; query-ticks beyond ack-ticks: the query is still pending at give-up\n   837\t    (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   838\t                                       ::dht/query-ticks 10000\n   839\t                                       ::dht/bootstrap [(mesh/contact 9)]})]\n   840\t      (mesh/request! c (put-request \"d\" [:dropped]))\n   841\t      (mesh/tick! c 0)\n   842\t      (let [s (dht/step (dht/state c) 16)]\n   843\t        (is (= 1 (count (:queries s))))\n   844\t        (is (= (queries-by-owner s) (:query-index s)))\n   845\t        (mesh/tick! c 5000)\n","exit_code":0,"status":"completed"}}
