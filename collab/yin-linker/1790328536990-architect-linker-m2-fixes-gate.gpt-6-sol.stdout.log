{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker.cljc | sed -n '585,850p'\"","aggregated_output":"   585\t  [body]\n   586\t  (let [slots (get vm/semantic-bytecode-grammar (first body))]\n   587\t    (when (and slots (= (count slots) (dec (count body))))\n   588\t      (mapcat (fn [[_field kind] v]\n   589\t                (case kind\n   590\t                  :node (when (jing/segment-address? v) [v])\n   591\t                  :nodes (filter jing/segment-address? v)\n   592\t                  nil))\n   593\t              slots (rest body)))))\n   594\t\n   595\t\n   596\t;; =============================================================================\n   597\t;; Format records (section 5)\n   598\t;; =============================================================================\n   599\t\n   600\t(def stack-format\n   601\t  \"The `:yin.debruijn.code` format record: stack images identified by H\n   602\t   under the \\\"b1\\\" contract, one canonical vector per image. Free names\n   603\t   are `:load-free` operands, definitions `:store-put` operands,\n   604\t   application sites the call opcodes -- all position-bearing by pc\n   605\t   (section 5.3).\"\n   606\t  {:format              :yin.debruijn.code,\n   607\t   :contract            \"b1\",\n   608\t   :identity-fn         debruijn-code/image-hash,\n   609\t   :identity-matches-fn (fn [H v] (= H (debruijn-code/image-hash v))),\n   610\t   :row-defect-fn       debruijn-code/image-defect,\n   611\t   :validate-fn         debruijn-code/image-defect,\n   612\t   :obligations-fn      stack-free-occurrences,\n   613\t   :definitions-fn      vector-definition-occurrences,\n   614\t   :applications-fn     vector-application-sites,\n   615\t   :parts-fn            (constantly nil)})\n   616\t\n   617\t\n   618\t(def register-format\n   619\t  \"The `:yin.debruijn.register` format record: register images identified\n   620\t   by R under the \\\"r1\\\" contract, one image map per image. Free names\n   621\t   are `[:load-free rd name]` operands across all bodies, definitions\n   622\t   the `:store-put` keys, application sites the call opcodes\n   623\t   (section 5.4).\"\n   624\t  {:format              :yin.debruijn.register,\n   625\t   :contract            \"r1\",\n   626\t   :identity-fn         debruijn-register-code/register-hash,\n   627\t   :identity-matches-fn (fn [R v]\n   628\t                          (= R (debruijn-register-code/register-hash v))),\n   629\t   :row-defect-fn       debruijn-register-code/register-image-defect,\n   630\t   :validate-fn         debruijn-register-code/register-image-defect,\n   631\t   :obligations-fn      register-free-occurrences,\n   632\t   :definitions-fn      register-definition-occurrences,\n   633\t   :applications-fn     register-application-sites,\n   634\t   :parts-fn            (constantly nil)})\n   635\t\n   636\t\n   637\t(def semantic-format\n   638\t  \"The `:yin.semantic/code` format record: the canonical positional\n   639\t   instruction vector stored as the exact payload at its own\n   640\t   `segment-key` (UCF section 7.3.4), under the \\\"v2\\\" contract. Identity\n   641\t   and address are one preimage; step 3 still runs, because it is the\n   642\t   only check that the index did not point the identity at a different,\n   643\t   correctly stored payload (section 4.2). Free names are `:var`\n   644\t   operands, definitions `:store-put` operands, application sites the\n   645\t   call opcodes (section 5.2).\"\n   646\t  {:format              :yin.semantic/code,\n   647\t   :contract            \"v2\",\n   648\t   :identity-fn         jing/segment-key,\n   649\t   :identity-matches-fn jing/segment-matches?,\n   650\t   :row-defect-fn       code/well-formed-vector?,\n   651\t   :validate-fn         code/well-formed-vector?,\n   652\t   :obligations-fn      semantic-free-occurrences,\n   653\t   :definitions-fn      vector-definition-occurrences,\n   654\t   :applications-fn     vector-application-sites,\n   655\t   :parts-fn            (constantly nil)})\n   656\t\n   657\t\n   658\t(def ast-format\n   659\t  \"The `:yin.ast/code` format record: one row body `[tag & slots]` per\n   660\t   address (D3), the root row's id the tree's identity, under the \\\"v2\\\"\n   661\t   contract. Step 2 is a bounded worklist over the grammar's\n   662\t   `node`/`nodes` slots; the whole tree is assembled for step 4 by\n   663\t   prepending each part's address, the shape `validate-rows` takes. All\n   664\t   three scanners are Datalog over the rows, position-bearing by\n   665\t   occurrence path (section 5.1).\"\n   666\t  {:format              :yin.ast/code,\n   667\t   :contract            \"v2\",\n   668\t   :identity-fn         jing/segment-key,\n   669\t   :identity-matches-fn jing/segment-matches?,\n   670\t   :row-defect-fn       row-local-defect,\n   671\t   :validate-fn         vm/validate-rows,\n   672\t   :obligations-fn      tree-free-name-occurrences,\n   673\t   :definitions-fn      tree-definition-occurrences,\n   674\t   :applications-fn     tree-application-sites,\n   675\t   :parts-fn            body-child-ids})\n   676\t\n   677\t\n   678\t;; =============================================================================\n   679\t;; The H and R indexes (section 6)\n   680\t;; =============================================================================\n   681\t\n   682\t(defn address-attribute\n   683\t  \"The index attribute a format's identities are published under:\n   684\t   `:yin.debruijn.code/address` or `:yin.debruijn.register/address`.\"\n   685\t  [format]\n   686\t  (keyword (name (:format format)) \"address\"))\n   687\t\n   688\t\n   689\t(defn index-from-datoms\n   690\t  \"A plain identity -> address map read from index datoms\n   691\t   `[identity attribute address]`, keeping only the attribute `format`\n   692\t   publishes under. The index is composition data; an entry is a claim,\n   693\t   not a proof (step 3 checks it).\"\n   694\t  [format datoms]\n   695\t  (let [attr (address-attribute format)]\n   696\t    (into {}\n   697\t          (keep (fn [[e a v]] (when (= attr a) [e v])))\n   698\t          datoms)))\n   699\t\n   700\t\n   701\t;; =============================================================================\n   702\t;; The receiver environment (step 5)\n   703\t;; =============================================================================\n   704\t;; The receiver binds a free name in the order\n   705\t;; `yin.vm.engine/resolve-var` uses: free env -> store -> primitives ->\n   706\t;; module registry. A name the image publisher meant as a primitive or a\n   707\t;; module binding must resolve there; a receiver whose free env or store\n   708\t;; also binds it would bind it differently, so that is refused as\n   709\t;; shadowed rather than executed (D11).\n   710\t\n   711\t(defn- obligation-name\n   712\t  \"The name an obligation carries: a section 4.1 record's `:name`, or\n   713\t   the bare name itself.\"\n   714\t  [obligation]\n   715\t  (if (map? obligation) (:name obligation) obligation))\n   716\t\n   717\t\n   718\t(defn- shadowed?\n   719\t  [{:keys [free-env store]} obligation]\n   720\t  (let [sym (obligation-name obligation)]\n   721\t    (or (contains? free-env sym) (contains? store sym))))\n   722\t\n   723\t\n   724\t(defn- resolvable?\n   725\t  [{:keys [primitives modules]} obligation]\n   726\t  (let [sym (obligation-name obligation)]\n   727\t    (or (contains? primitives sym)\n   728\t        (some (fn [k] (and (map? k) (= sym (:name k))))\n   729\t              (keys primitives))\n   730\t        (and (symbol? sym)\n   731\t             (some? (namespace sym))\n   732\t             (some? (module/resolve-module\n   733\t                      modules\n   734\t                      (symbol (str (namespace sym) \".\" (name sym)))))))))\n   735\t\n   736\t\n   737\t(defn free-name-defect\n   738\t  \"The first step-5 refusal for the obligations `obligations` against\n   739\t   `receiver` (`{:free-env :store :primitives :modules}`, every key\n   740\t   optional), or nil when every obligation binds in the receiver\n   741\t   identically. An obligation is a section 4.1 record; a bare name is\n   742\t   accepted for compositions that scan names themselves. The registry\n   743\t   discharges an obligation under its own entry -- a composition that\n   744\t   derives its registry from the same scan keys the records -- or under\n   745\t   the bare name.\"\n   746\t  [receiver obligations]\n   747\t  (some (fn [obligation]\n   748\t          (cond (shadowed? receiver obligation)\n   749\t                (refused :shadowed-free\n   750\t                         {:name (obligation-name obligation)})\n   751\t                (not (resolvable? receiver obligation))\n   752\t                (refused :unresolved-free\n   753\t                         {:name (obligation-name obligation)})))\n   754\t        obligations))\n   755\t\n   756\t\n   757\t;; =============================================================================\n   758\t;; Step 5a: the occurrence/definition join (section 4.2)\n   759\t;; =============================================================================\n   760\t\n   761\t(defn- precedes?\n   762\t  \"True when position `d` executes before position `u` under the\n   763\t   position's own order (section 4.1): a pc for the vector formats, the\n   764\t   tree's slot order for an occurrence path `[root path]`. Positions of\n   765\t   different shapes, or of different roots, never discharge each other.\"\n   766\t  [d u]\n   767\t  (cond\n   768\t    (and (integer? d) (integer? u)) (< d u)\n   769\t    (and (vector? d) (vector? u)\n   770\t         (= 2 (count d)) (= 2 (count u))\n   771\t         (= (nth d 0) (nth u 0)))\n   772\t    (path-before? (nth d 1) (nth u 1))\n   773\t    :else false))\n   774\t\n   775\t\n   776\t(defn- scanned\n   777\t  \"The records `slot`'s scanner yields for `value`, or nil when the slot\n   778\t   is missing or the scanner cannot run -- step 5a then falls under the\n   779\t   conservative degradation (section 4.1).\"\n   780\t  [format slot value]\n   781\t  (try (when-let [f (get format slot)] (f value))\n   782\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n   783\t\n   784\t\n   785\t(defn- undischarged\n   786\t  \"Step 5a's join: the free-name occurrences the scanners yielded,\n   787\t   against the definitions and the application sites. A definition\n   788\t   discharges an occurrence by defined-before-use under control-flow\n   789\t   dominance -- an unconditional definition whose position precedes the\n   790\t   occurrence's (section 4.1's order rules). A main-sequence occurrence\n   791\t   whose every definition is later is `:use-before-definition`; one\n   792\t   whose only definitions are conditional and earlier keeps its\n   793\t   obligation. A lambda-body occurrence is discharged only by an\n   794\t   unconditional definition that precedes every application site; an\n   795\t   image with no application site discharges a body occurrence against\n   796\t   every unconditional definition; with no usable application positions\n   797\t   nothing inside a body is discharged at all. A position the scanners\n   798\t   could not compute retains its occurrence and never discharges.\n   799\t   Returns `{:obligations [...]}` -- the retained records, in scan\n   800\t   order -- or a `:use-before-definition` refusal naming the\n   801\t   occurrence.\"\n   802\t  [occurrences definitions applications]\n   803\t  (let [sites (vec applications)\n   804\t        usable-sites? (and (sequential? applications)\n   805\t                           (every? (fn [s] (some? (:at s))) sites))\n   806\t        by-name (group-by :name definitions)\n   807\t        unconditional (fn [defs]\n   808\t                        (filter (fn [d]\n   809\t                                  (and (some? (:at d))\n   810\t                                       (false? (:conditional? d))))\n   811\t                                defs))\n   812\t        verdict\n   813\t        (fn [occ]\n   814\t          (let [at (:at occ)]\n   815\t            (if (nil? at)\n   816\t              :retained\n   817\t              (let [defs (get by-name (:name occ))]\n   818\t                (if-not (:in-body? occ)\n   819\t                  (let [dominating (filter (fn [d]\n   820\t                                             (precedes? (:at d) at))\n   821\t                                           (unconditional defs))]\n   822\t                    (cond\n   823\t                      (seq dominating) :discharged\n   824\t                      (and (seq defs)\n   825\t                           (every? (fn [d]\n   826\t                                     (and (some? (:at d))\n   827\t                                          (precedes? at (:at d))))\n   828\t                                   defs))\n   829\t                      :use-before-definition\n   830\t                      :else :retained))\n   831\t                  (cond\n   832\t                    (not usable-sites?) :retained\n   833\t                    (empty? sites)\n   834\t                    (if (seq (unconditional defs))\n   835\t                      :discharged\n   836\t                      :retained)\n   837\t                    :else\n   838\t                    (if (seq (filter (fn [d]\n   839\t                                       (every? (fn [s]\n   840\t                                                 (precedes? (:at d)\n   841\t                                                            (:at s)))\n   842\t                                               sites))\n   843\t                                     (unconditional defs)))\n   844\t                      :discharged\n   845\t                      :retained)))))))]\n   846\t    (reduce (fn [acc occ]\n   847\t              (case (verdict occ)\n   848\t                :discharged acc\n   849\t                :retained (update acc :obligations conj occ)\n   850\t                :use-before-definition\n","exit_code":0,"status":"completed"}}
