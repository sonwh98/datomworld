currence rules\n   373\t   wrapped to carry each occurrence's path (section 4.1).\"\n   374\t  [tree]\n   375\t  (let [{:keys [root db occ]} (tree-rows tree)]\n   376\t    (->> (query/collect\n   377\t           (query/q tree-occurrence-query db occ\n   378\t                    vm/occurrence-rules root\n   379\t                    {:fns vm/occurrence-fns}))\n   380\t         (map (fn [[name path]]\n   381\t                (let [[in-body? _] (tree-enclosure tree path)]\n   382\t                  {:name name, :at [root path], :in-body? in-body?})))\n   383\t         (sort-by (comp second :at) path-order)\n   384\t         vec)))\n   385\t\n   386\t\n   387\t(defn- tree-definition-occurrences\n   388\t  \"Every constant store key the tree binds at module level as a section\n   389\t   4.1 record `{:name key :at [root path] :conditional? b}`: the\n   390\t   store-key query behind `vm/ast-requirements` (`:vm/store-put` rows),\n   391\t   each binding row carried with its occurrence path and enclosing tags\n   392\t   (section 4.1).\"\n   393\t  [tree]\n   394\t  (let [{:keys [root db occ]} (tree-rows tree)]\n   395\t    (->> (query/collect\n   396\t           (query/q tree-definition-query db occ root))\n   397\t         (map (fn [[key path]]\n   398\t                (let [[_ conditional?] (tree-enclosure tree path)]\n   399\t                  {:name key, :at [root path],\n   400\t                   :conditional? conditional?})))\n   401\t         (sort-by (comp second :at) path-order)\n   402\t         vec)))\n   403\t\n   404\t\n   405\t(defn- tree-application-sites\n   406\t  \"Every application row of the tree as a section 4.1 record `{:at\n   407\t   [root path]}` -- one application site: a position at which the image\n   408\t   may apply a closure it creates (section 4.1).\"\n   409\t  [tree]\n   410\t  (let [{:keys [root db occ]} (tree-rows tree)]\n   411\t    (->> (query/collect\n   412\t           (query/q tree-application-query db occ root))\n   413\t         (map (fn [[path]] {:at [root path]}))\n   414\t         (sort-by (comp second :at) path-order)\n   415\t         vec)))\n   416\t\n   417\t\n   418\t(defn- stack-free-occurrences\n   419\t  \"Every `:load-free` occurrence of a canonical stack instruction vector\n   420\t   as a section 4.1 record `{:name sym :at pc :in-body? b}`, in pc\n   421\t   order. Over a vector whose closure body spans the scope walk cannot\n   422\t   read, every `:load-free` name degrades to a record with no position\n   423\t   (section 4.1).\"\n   424\t  [v]\n   425\t  (if-let [spans (safe-layout v)]\n   426\t    (vec (keep-indexed\n   427\t           (fn [pc t]\n   428\t             (when (and (vector? t) (= :load-free (nth t 0)))\n   429\t               {:name (nth t 1), :at pc,\n   430\t                :in-body? (in-body-pc? spans pc)}))\n   431\t           v))\n   432\t    (degraded-occurrences (stack-free-names v))))\n   433\t\n   434\t\n   435\t(defn- vector-definition-occurrences\n   436\t  \"Every `:store-put` key the canonical instruction vector `v` binds, as\n   437\t   a section 4.1 record `{:name key :at pc :conditional? b}`: conditional\n   438\t   when a jump target range or a closure body encloses the pc (section\n   439\t   4.1). Degrades to records with no position over a vector whose body\n   440\t   spans the scope walk cannot read.\"\n   441\t  [v]\n   442\t  (if-let [spans (safe-layout v)]\n   443\t    (let [ranges (conditional-ranges v)]\n   444\t      (vec (keep-indexed\n   445\t             (fn [pc t]\n   446\t               (when (and (vector? t)\n   447\t                          (= :store-put (nth t 0))\n   448\t                          (< 1 (count t)))\n   449\t                 {:name (nth t 1), :at pc,\n   450\t                  :conditional? (or (contains? ranges pc)\n   451\t                                    (in-body-pc? spans pc))}))\n   452\t             v)))\n   453\t    (degraded-definitions\n   454\t      (keep (fn [t]\n   455\t              (when (and (vector? t)\n   456\t                         (= :store-put (nth t 0))\n   457\t                         (< 1 (count t)))\n   458\t                (nth t 1)))\n   459\t            v))))\n   460\t\n   461\t\n   462\t(defn- vector-application-sites\n   463\t  \"Every application site of the canonical instruction vector `v` as a\n   464\t   section 4.1 record `{:at pc}`: a `:call` or `:ffi-call` pc -- a\n   465\t   direct call, a call of an imported name, or a call of a primitive\n   466\t   that receives a function argument, the callee possibly applying what\n   467\t   it is handed (section 4.1). Degrades to records with no position over\n   468\t   a vector whose body spans the scope walk cannot read.\"\n   469\t  [v]\n   470\t  (let [call? (fn [t]\n   471\t                (and (vector? t)\n   472\t                     (contains? #{:call :ffi-call} (nth t 0))))]\n   473\t    (if (safe-layout v)\n   474\t      (vec (keep-indexed (fn [pc t] (when (call? t) {:at pc})) v))\n   475\t      (vec (keep (fn [t] (when (call? t) {:at nil})) v)))))\n   476\t\n   477\t\n   478\t(defn- register-body-at\n   479\t  \"The index of the declared body of register image map `image` whose pc\n   480\t   range covers `p`, or nil: body 0 is the main program, every other\n   481\t   body a lambda's.\"\n   482\t  [image p]\n   483\t  (some (fn [i]\n   484\t          (let [b (nth (:bodies image) i)]\n   485\t            (when (and (integer? (:start b)) (integer? (:end b))\n   486\t                       (<= (:start b) p (:end b)))\n   487\t              i)))\n   488\t        (range (count (:bodies image)))))\n   489\t\n   490\t\n   491\t(defn- register-in-body?\n   492\t  \"Whether pc `p` of register image map `image` lies in a lambda body\n   493\t   rather than the main program (section 4.1).\"\n   494\t  [image p]\n   495\t  (let [i (register-body-at image p)]\n   496\t    (boolean (and i (pos? i)))))\n   497\t\n   498\t\n   499\t(defn- register-conditional-ranges\n   500\t  \"The conditional target range pcs of a register image's instructions\n   501\t   (section 4.1): a `:jump`'s target is its first operand, a\n   502\t   `:branch-false`'s its second.\"\n   503\t  [image]\n   504\t  (into #{}\n   505\t        (mapcat (fn [[b t]]\n   506\t                  (when (and (integer? t) (not= b t))\n   507\t                    (range (inc (min b t)) (max b t)))))\n   508\t        (keep-indexed\n   509\t          (fn [pc t]\n   510\t            (when (vector? t)\n   511\t              (case (nth t 0)\n   512\t                :jump [pc (nth t 1)]\n   513\t                :branch-false [pc (nth t 2)]\n   514\t                nil)))\n   515\t          (:instructions image))))\n   516\t\n   517\t\n   518\t(defn- register-free-occurrences\n   519\t  \"Every `:load-free` occurrence across all bodies of a register image\n   520\t   map as a section 4.1 record `{:name sym :at pc :in-body? b}`, in pc\n   521\t   order. A register `:load-free` is `[:load-free rd name]`.\"\n   522\t  [image]\n   523\t  (vec (keep-indexed\n   524\t         (fn [pc t]\n   525\t           (when (and (vector? t) (= :load-free (nth t 0)))\n   526\t             {:name (nth t 2), :at pc,\n   527\t              :in-body? (register-in-body? image pc)}))\n   528\t         (:instructions image))))\n   529\t\n   530\t\n   531\t(defn- register-definition-occurrences\n   532\t  \"Every `:store-put` key the register image binds, as a section 4.1\n   533\t   record `{:name key :at pc :conditional? b}`: conditional when a jump\n   534\t   target range or a lambda body encloses the pc (section 4.1). A\n   535\t   register `:store-put` is `[:store-put rd key value]`.\"\n   536\t  [image]\n   537\t  (let [ranges (register-conditional-ranges image)]\n   538\t    (vec (keep-indexed\n   539\t           (fn [pc t]\n   540\t             (when (and (vector? t) (= :store-put (nth t 0)))\n   541\t               {:name (nth t 2), :at pc,\n   542\t                :conditional? (or (contains? ranges pc)\n   543\t                                  (register-in-body? image pc))}))\n   544\t           (:instructions image)))))\n   545\t\n   546\t\n   547\t(defn- register-application-sites\n   548\t  \"Every application site of the register image as a section 4.1 record\n   549\t   `{:at pc}`: a `:call` or `:ffi-call` pc (section 4.1).\"\n   550\t  [image]\n   551\t  (vec (keep-indexed\n   552\t         (fn [pc t]\n   553\t           (when (and (vector? t)\n   554\t                      (contains? #{:call :ffi-call} (nth t 0)))\n   555\t             {:at pc}))\n   556\t         (:instructions image))))\n   557\t\n   558\t\n   559\t;; =============================================================================\n   560\t;; Row-local validation and the parts worklist (sections 5.1, 4.2 step 2)\n   561\t;; =============================================================================\n   562\t\n   563\t(defn row-local-defect\n   564\t  \"The section 7.4 row-local rules -- `:tag`, `:arity`, `:slot-kind`,\n   565\t   `:saturation` -- over one row body `[tag & slots]`, nil when the body\n   566\t   is locally well formed. The whole-tree rules (`:id-resolves`,\n   567\t   `:acyclic`, `:root-reachable`) cannot run over one body and are never\n   568\t   reported here: a locally well-formed body's child ids resolve in\n   569\t   step 2's worklist. A malformed row's slots are never followed\n   570\t   (section 5.1). A body that is not a vector is a `:tag` defect: only a\n   571\t   vector can be a row.\"\n   572\t  [body]\n   573\t  (let [row (if (vector? body) (into [::root] body) [::root body])\n   574\t        res (vm/validate-rows {:root ::root, :rows {::root row}})]\n   575\t    (when (contains? #{:tag :arity :slot-kind :saturation} (:rule res))\n   576\t      res)))\n   577\t\n   578\t\n   579\t(defn- body-child-ids\n   580\t  \"The child row ids of one fetched body's `node`/`nodes` slots, by the\n   581\t   grammar's own positions. Only valid segment addresses are followed: a\n   582\t   slot holding something else stays in the row for `validate-rows` to\n   583\t   name as its `:slot-kind` defect, exactly as it would in a\n   584\t   hand-supplied row set.\"\n   585\t  [body]\n","exit_code":0,"status":"completed"}}
