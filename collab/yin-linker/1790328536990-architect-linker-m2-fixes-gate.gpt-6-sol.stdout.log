q path)]\n   327\t    (if (nil? steps)\n   328\t      (get rows id)\n   329\t      (let [row (get rows id)\n   330\t            step (first steps)\n   331\t            child (when row\n   332\t                    (if (vector? step)\n   333\t                      (let [slot (nth row (nth step 0))]\n   334\t                        (when (vector? slot) (nth slot (nth step 1))))\n   335\t                      (nth row step)))]\n   336\t        (recur child (next steps))))))\n   337\t\n   338\t\n   339\t(defn- tree-enclosure\n   340\t  \"Whether the occurrence at `path` lies inside a lambda body, and\n   341\t   whether an `:if` branch or a lambda body encloses it -- section 4.1's\n   342\t   `:in-body?` and `:conditional?`. Each proper prefix of `path` names\n   343\t   the row the next step leaves: a `:lambda`'s body slot is 3, an `:if`'s\n   344\t   branches 3 and 4 (the section 2.3 grammar's own positions).\"\n   345\t  [tree path]\n   346\t  (loop [i 0, in-body? false, conditional? false]\n   347\t    (if (or (and in-body? conditional?) (>= i (count path)))\n   348\t      [in-body? conditional?]\n   349\t      (let [row (tree-row-at tree (subvec path 0 i))\n   350\t            tag (and row (nth row 1))\n   351\t            step (nth path i)]\n   352\t        (recur (inc i)\n   353\t               (or in-body? (and (= :lambda tag) (= 3 step)))\n   354\t               (or conditional?\n   355\t                   (and (= :lambda tag) (= 3 step))\n   356\t                   (and (= :if tag) (or (= 3 step) (= 4 step)))))))))\n   357\t\n   358\t\n   359\t(defn- tree-rows\n   360\t  \"The row and occurrence relations the tree scanners query, with the\n   361\t   tree's root.\"\n   362\t  [tree]\n   363\t  (let [root (:root tree)\n   364\t        db (query/relation (vals (:rows tree)))\n   365\t        occ (query/relation (vm/occurrences tree))]\n   366\t    {:root root, :db db, :occ occ}))\n   367\t\n   368\t\n   369\t(defn- tree-free-name-occurrences\n   370\t  \"Every free `:variable` occurrence of the tree `{:root root :rows {id\n   371\t   row}}` as a section 4.1 record `{:name sym :at [root path] :in-body?\n   372\t   b}`, in the tree's own path order: `vm/free-names`' occurrence rules\n   373\t   wrapped to carry each occurrence's path (section 4.1).\"\n   374\t  [tree]\n   375\t  (let [{:keys [root db occ]} (tree-rows tree)]\n   376\t    (->> (query/collect\n   377\t           (query/q tree-occurrence-query db occ\n   378\t                    vm/occurrence-rules root\n   379\t                    {:fns vm/occurrence-fns}))\n   380\t         (map (fn [[name path]]\n   381\t                (let [[in-body? _] (tree-enclosure tree path)]\n   382\t                  {:name name, :at [root path], :in-body? in-body?})))\n   383\t         (sort-by (comp second :at) path-order)\n   384\t         vec)))\n   385\t\n   386\t\n   387\t(defn- tree-definition-occurrences\n   388\t  \"Every constant store key the tree binds at module level as a section\n   389\t   4.1 record `{:name key :at [root path] :conditional? b}`: the\n   390\t   store-key query behind `vm/ast-requirements` (`:vm/store-put` rows),\n   391\t   each binding row carried with its occurrence path and enclosing tags\n   392\t   (section 4.1).\"\n   393\t  [tree]\n   394\t  (let [{:keys [root db occ]} (tree-rows tree)]\n   395\t    (->> (query/collect\n   396\t           (query/q tree-definition-query db occ root))\n   397\t         (map (fn [[key path]]\n   398\t                (let [[_ conditional?] (tree-enclosure tree path)]\n   399\t                  {:name key, :at [root path],\n   400\t                   :conditional? conditional?})))\n   401\t         (sort-by (comp second :at) path-order)\n   402\t         vec)))\n   403\t\n   404\t\n   405\t(defn- tree-application-sites\n   406\t  \"Every application row of the tree as a section 4.1 record `{:at\n   407\t   [root path]}` -- one application site: a position at which the image\n   408\t   may apply a closure it creates (section 4.1).\"\n   409\t  [tree]\n   410\t  (let [{:keys [root db occ]} (tree-rows tree)]\n   411\t    (->> (query/collect\n   412\t           (query/q tree-application-query db occ root))\n   413\t         (map (fn [[path]] {:at [root path]}))\n   414\t         (sort-by (comp second :at) path-order)\n   415\t         vec)))\n   416\t\n   417\t\n   418\t(defn- stack-free-occurrences\n   419\t  \"Every `:load-free` occurrence of a canonical stack instruction vector\n   420\t   as a section 4.1 record `{:name sym :at pc :in-body? b}`, in pc\n   421\t   order. Over a vector whose closure body spans the scope walk cannot\n   422\t   read, every `:load-free` name degrades to a record with no position\n   423\t   (section 4.1).\"\n   424\t  [v]\n   425\t  (if-let [spans (safe-layout v)]\n   426\t    (vec (keep-indexed\n   427\t           (fn [pc t]\n   428\t             (when (and (vector? t) (= :load-free (nth t 0)))\n   429\t               {:name (nth t 1), :at pc,\n   430\t                :in-body? (in-body-pc? spans pc)}))\n   431\t           v))\n   432\t    (degraded-occurrences (stack-free-names v))))\n   433\t\n   434\t\n   435\t(defn- vector-definition-occurrences\n   436\t  \"Every `:store-put` key the canonical instruction vector `v` binds, as\n   437\t   a section 4.1 record `{:name key :at pc :conditional? b}`: conditional\n   438\t   when a jump target range or a closure body encloses the pc (section\n   439\t   4.1). Degrades to records with no position over a vector whose body\n   440\t   spans the scope walk cannot read.\"\n   441\t  [v]\n   442\t  (if-let [spans (safe-layout v)]\n   443\t    (let [ranges (conditional-ranges v)]\n   444\t      (vec (keep-indexed\n   445\t             (fn [pc t]\n   446\t               (when (and (vector? t)\n   447\t                          (= :store-put (nth t 0))\n   448\t                          (< 1 (count t)))\n   449\t                 {:name (nth t 1), :at pc,\n   450\t                  :conditional? (or (contains? ranges pc)\n   451\t                                    (in-body-pc? spans pc))}))\n   452\t             v)))\n   453\t    (degraded-definitions\n   454\t      (keep (fn [t]\n   455\t              (when (and (vector? t)\n   456\t                         (= :store-put (nth t 0))\n   457\t                         (< 1 (count t)))\n   458\t                (nth t 1)))\n   459\t            v))))\n   460\t\n   461\t\n   462\t(defn- vector-application-sites\n   463\t  \"Every application site of the canonical instruction vector `v` as a\n   464\t   section 4.1 record `{:at pc}`: a `:call` or `:ffi-call` pc -- a\n   465\t   direct call, a call of an imported name, or a call of a primitive\n   466\t   that receives a function argument, the callee possibly applying what\n   467\t   it is handed (section 4.1). Degrades to records with no position over\n   468\t   a vector whose body spans the scope walk cannot read.\"\n   469\t  [v]\n   470\t  (let [call? (fn [t]\n   750\t                         {:name (obligation-name obligation)})\n   751\t                (not (resolvable? receiver obligation))\n   752\t                (refused :unresolved-free\n   753\t                         {:name (obligation-name obligation)})))\n   754\t        obligations))\n   755\t\n   756\t\n   757\t;; =============================================================================\n   758\t;; Step 5a: the occurrence/definition join (section 4.2)\n   759\t;; =============================================================================\n   760\t\n   761\t(defn- precedes?\n   762\t  \"True when position `d` executes before position `u` under the\n   763\t   position's own order (section 4.1): a pc for the vector formats, the\n   764\t   tree's slot order for an occurrence path `[root path]`. Positions of\n   765\t   different shapes, or of different roots, never discharge each other.\"\n   766\t  [d u]\n   767\t  (cond\n   768\t    (and (integer? d) (integer? u)) (< d u)\n   769\t    (and (vector? d) (vector? u)\n   770\t         (= 2 (count d)) (= 2 (count u))\n   771\t         (= (nth d 0) (nth u 0)))\n   772\t    (path-before? (nth d 1) (nth u 1))\n   773\t    :else false))\n   774\t\n   775\t\n   776\t(defn- scanned\n   777\t  \"The records `slot`'s scanner yields for `value`, or nil when the slot\n   778\t   is missing or the scanner cannot run -- step 5a then falls under the\n   779\t   conservative degradation (section 4.1).\"\n   780\t  [format slot value]\n   781\t  (try (when-let [f (get format slot)] (f value))\n   782\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n   783\t\n   784\t\n   785\t(defn- undischarged\n   786\t  \"Step 5a's join: the free-name occurrences the scanners yielded,\n   787\t   against the definitions and the application sites. A definition\n   788\t   discharges an occurrence by defined-before-use under control-flow\n   789\t   dominance -- an unconditional definition whose position precedes the\n   790\t   occurrence's (section 4.1's order rules). A main-sequence occurrence\n   791\t   whose every definition is later is `:use-before-definition`; one\n   792\t   whose only definitions are conditional and earlier keeps its\n   793\t   obligation. A lambda-body occurrence is discharged only by an\n   794\t   unconditional definition that precedes every application site; an\n   795\t   image with no application site discharges a body occurrence against\n   796\t   every unconditional definition; with no usable application positions\n   797\t   nothing inside a body is discharged at all. A position the scanners\n   798\t   could not compute retains its occurrence and never discharges.\n   799\t   Returns `{:obligations [...]}` -- the retained records, in scan\n   800\t   order -- or a `:use-before-definition` refusal naming the\n   801\t   occurrence.\"\n   802\t  [occurrences definitions applications]\n   803\t  (let [sites (vec applications)\n   804\t        usable-sites? (and (sequential? applications)\n   805\t                           (every? (fn [s] (some? (:at s))) sites))\n   806\t        by-name (group-by :name definitions)\n   807\t        unconditional (fn [defs]\n   808\t                        (filter (fn [d]\n   809\t                                  (and (some? (:at d))\n   810\t                                       (false? (:conditional? d))))\n   811\t                                defs))\n   812\t        verdict\n   813\t        (fn [occ]\n   814\t          (let [at (:at occ)]\n   815\t            (if (nil? at)\n   816\t              :retained\n   817\t              (let [defs (get by-name (:name occ))]\n   818\t                (if-not (:in-body? occ)\n   819\t                  (let [dominating (filter (fn [d]\n   820\t                                             (precedes? (:at d) at))\n   821\t                                           (unconditional defs))]\n   822\t                    (cond\n   823\t                      (seq dominating) :discharged\n   824\t                      (and (seq defs)\n   825\t                           (every? (fn [d]\n   826\t                                     (and (some? (:at d))\n   827\t                                          (precedes? at (:at d))))\n   828\t                                   defs))\n   829\t                      :use-before-definition\n   830\t                      :else :retained))\n   831\t                  (cond\n   832\t                    (not usable-sites?) :retained\n   833\t                    (empty? sites)\n   834\t                    (if (seq (unconditional defs))\n   835\t                      :discharged\n   836\t                      :retained)\n   837\t                    :else\n   838\t                    (if (seq (filter (fn [d]\n   839\t                                       (every? (fn [s]\n   840\t                                                 (precedes? (:at d)\n   841\t                                                            (:at s)))\n   842\t                                               sites))\n   843\t                                     (unconditional defs)))\n   844\t                      :discharged\n   845\t                      :retained)))))))]\n   846\t    (reduce (fn [acc occ]\n   847\t              (case (verdict occ)\n   848\t                :discharged acc\n   849\t                :retained (update acc :obligations conj occ)\n   850\t                :use-before-definition\n   851\t                (reduced {:obligations []\n   852\t                          :defect (refused :use-before-definition\n   853\t                                           {:name (:name occ),\n   854\t                                            :at (:at occ)})})))\n   855\t            {:obligations []}\n   856\t            occurrences)))\n   857\t\n   858\t\n   859\t;; =============================================================================\n   860\t;; fetch (section 4)\n   861\t;; =============================================================================\n   862\t\n   863\t(def ^:private missing\n   864\t  \"Opaque per-host not-found sentinel for `jing/get`, never a keyword: a\n   865\t   keyword sentinel could collide with a genuinely stored payload.\"\n   920\t\n   921\t\n   922\t(defn- row-defect\n   923\t  \"Step 2's per-part check, or nil when the part is locally well formed.\n   924\t   A `:row-defect-fn` that throws refuses like a validator.\"\n   925\t  [format value]\n   926\t  (try ((:row-defect-fn format) value)\n   927\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   928\t         {:rule :validator-refused})))\n   929\t\n   930\t\n   931\t(defn- validation-defect\n   932\t  [format value]\n   933\t  (try ((:validate-fn format) value)\n   934\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   935\t         {:rule :validator-refused})))\n   936\t\n   937\t\n   938\t(defn- fetch-one\n   939\t  \"One worklist visit: read `address` raw, verify it against the address\n   940\t   it was requested at, check its size against the byte `budget`\n   941\t   remaining before decoding anything, then validate it row-locally --\n   942\t   in that order, so an oversized or malformed row is refused before\n   943\t   anything it references is decoded or enqueued. Returns\n   944\t   `{:value v :bytes n}` or a refusal.\"\n   945\t  [handle format identity address budget]\n   946\t  (let [bs (read-address handle address)]\n   947\t    (cond\n   948\t      (identical? missing bs)\n   949\t      (refused :absent {:address address})\n   950\t\n   951\t      (not (jing/segment-bytes-match? address bs))\n   952\t      (refused :address-mismatch {:address address, :value (decoded bs)})\n   953\t\n   954\t      (and budget (> (byte-count bs) budget))\n   955\t      (refused :parts-limit {:bound :max-bytes, :address address})\n   956\t\n   957\t      :else\n   958\t      (let [value (decoded bs)]\n   959\t        (if (nil? value)\n   960\t          (refused :address-mismatch {:address address, :value nil})\n   961\t          (if-let [defect (row-defect format value)]\n   962\t            (refused :descriptor-defect\n   963\t                     {:identity identity, :address address,\n   964\t                      :defect defect})\n   965\t            {:value value, :bytes (byte-count bs)}))))))\n   966\t\n   967\t\n   968\t(def default-bounds\n   969\t  \"The safe finite composition bounds a fetch falls back to where the\n   970\t   caller supplies none (section 4.2 step 2): generous for every honest\n   971\t   image the compositions hold, finite for a hostile one, so no fetch\n   972\t   path walks an unbounded worklist.\"\n   973\t  {:max-parts 4096, :max-depth 256, :max-bytes 16777216})\n   974\t\n   975\t\n   976\t(defn- bounded\n   977\t  \"The composition's `bounds` with every bound it left nil (or never\n   978\t   named) taking `default-bounds`.\"\n   979\t  [bounds]\n   980\t  (into default-bounds\n   981\t        (map (fn [[k v]] [k (or v (get default-bounds k))]))\n   982\t        (or bounds {})))\n   983\t\n   984\t\n   985\t(defn- enqueue-children\n   986\t  \"The children of one fetched part that are not already enqueued, each\n   987\t   paired with its depth, up to the parts budget: the first child beyond\n   988\t   the remaining `max-parts` is refused `:parts-limit`, naming the bound\n   989\t   and its own address, before it is fetched (section 4.2). Returns\n   990\t   `{:queue [[address depth] ...] :fresh [address ...]}` or a refusal.\"\n   991\t  [child-addrs enqueued depth max-parts]\n   992\t  (loop [[child & more] (filter (fn [a] (not (contains? enqueued a)))\n   993\t                                (distinct child-addrs))\n   994\t         n (count enqueued)\n   995\t         acc []]\n   996\t    (cond\n   997\t      (nil? child)\n   998\t      {:queue (mapv (fn [a] [a (inc depth)]) acc), :fresh acc}\n   999\t\n  1000\t      (>= n max-parts)\n  1001\t      (refused :parts-limit {:bound :max-parts, :address child})\n  1002\t\n  1003\t      :else\n  1004\t      (recur more (inc n) (conj acc child)))))\n  1005\t\n  1006\t\n  1007\t(defn- fetch-parts\n  1008\t  \"Step 2: the bounded breadth-first worklist from `root-address`\n  1009\t   (section 4.2). `:parts-fn` names the further addresses a fetched\n  1010\t   payload references; the walk enqueues them behind the current one,\n  1011\t   verifies each the same way, and visits each address once. `bounds` is\n  1012\t   the composition's `{:max-parts n :max-depth d :max-bytes b}`, every\n  1013\t   bound finite (`bounded`); exceeding one is `:parts-limit` naming the\n  1014\t   bound and the address at which it was hit. The parts budget is\n  1015\t   enforced at enqueue time -- a child beyond the remaining budget is\n  1016\t   refused before it is fetched -- and the byte budget before a payload\n  1017\t   is decoded. Returns `{:parts {address body} :multi? boolean}` or a\n  1018\t   refusal. `:multi?` is the record's own answer to whether the format\n  1019\t   has parts at all: a single-payload format's `:parts-fn` returns nil,\n  1020\t   a multi-part format's a sequence, possibly empty for a leaf row.\"\n  1021\t  [handle format identity root-address bounds]\n  1022\t  (let [{:keys [max-parts max-depth max-bytes]} (bounded bounds)]\n  1023\t    (loop [queue [[root-address 0]]\n  1024\t           index 0\n  1025\t           parts {}\n  1026\t           bytes 0\n  1027\t           enqueued #{root-address}\n  1028\t           multi? nil]\n  1029\t      (if (= index (count queue))\n  1030\t        {:parts parts, :multi? (boolean multi?)}\n  1031\t        (let [[address depth] (nth queue index)]\n  1032\t          (cond\n  1033\t            (and max-depth (> depth max-depth))\n  1034\t            (refused :parts-limit {:bound :max-depth, :address address})\n  1035\t\n  1036\t            :else\n  1037\t            (let [res (fetch-one handle format identity address\n  1038\t                                 (when max-bytes (- max-bytes bytes)))]\n  1039\t              (if (refused? res)\n  1040\t                res\n  1041\t                (let [value (:value res)\n  1042\t                      bytes' (+ bytes (:bytes res))\n  1043\t                      child-addrs ((:parts-fn format) value)\n  1044\t                      multi?' (if (nil? multi?)\n  1045\t                                (not (nil? child-addrs))\n  1046\t                                multi?)\n  1047\t                      enqueued' (enqueue-children child-addrs enqueued\n  1048\t                                                  depth max-parts)]\n  1049\t                  (if (refused? enqueued')\n  1050\t                    enqueued'\n  1051\t                    (recur (into queue (:queue enqueued'))\n  1052\t                           (inc index)\n  1053\t                           (assoc parts address value)\n  1054\t                           bytes'\n  1055\t                           (into enqueued (:fresh enqueued'))\n  1056\t                           multi?')))))))))))\n  1057\t\n  1058\t\n  1059\t(defn fetch\n  1060\t  \"Fetches and verifies an image by its identity using handle, index, and\n","exit_code":0,"status":"completed"}}
