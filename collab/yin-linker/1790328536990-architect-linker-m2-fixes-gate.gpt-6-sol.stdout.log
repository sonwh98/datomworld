  461\t;; Step 6: the verified image, one fetch for all four formats (S11.14)\n   462\t;; =============================================================================\n   463\t\n   464\t(deftest fetch-returns-the-verified-image\n   465\t  (doseq [[label format mint] formats]\n   466\t    (testing label\n   467\t      (let [store (mem/create-content-mem)\n   468\t            image (mint worked-example)\n   469\t            {:keys [identity index]} (publish store format image)\n   470\t            res (linker/fetch store index format identity receiver)]\n   471\t        (is (linker/ok? res))\n   472\t        (is (not (linker/refused? res)))\n   473\t        (is (= (:format format) (:format res)))\n   474\t        (is (= identity (:identity res)))\n   475\t        (is (= image (:value res)))\n   476\t        (is (jing/segment-matches? (:address res)\n   477\t                                   (stored-payload format image)))\n   478\t        (is (contains? (set (map :name (:obligations res))) '+)\n   479\t            \"the free-name obligations travel with the image\")\n   480\t        (is (= res (linker/fetch store index format identity receiver))\n   900\t        (is (= :parts-limit (:reason res)))\n   901\t        (is (= {:bound :max-parts, :address mid-id}\n   902\t               (select-keys res [:bound :address]))\n   903\t            \"naming the bound and the address it was hit at\")))\n   904\t    (testing \"the :max-depth bound\"\n   905\t      (let [res (linker/fetch store {root root} linker/ast-format root\n   906\t                              receiver {:max-depth 1})]\n   907\t        (is (= :parts-limit (:reason res)))\n   908\t        (is (= {:bound :max-depth, :address leaf-id}\n   909\t               (select-keys res [:bound :address])))))\n   910\t    (testing \"the :max-bytes bound\"\n   911\t      (let [res (linker/fetch store {root root} linker/ast-format root\n   912\t                              receiver {:max-bytes 1})]\n   913\t        (is (= :parts-limit (:reason res)))\n   914\t        (is (= {:bound :max-bytes, :address root}\n   915\t               (select-keys res [:bound :address]))\n   916\t            \"the first payload alone exceeds it\")))\n   917\t    (jing/close! store)))\n   918\t\n   919\t\n   920\t(deftest max-bytes-is-checked-before-decode\n   921\t  (let [store (mem/create-content-mem)\n   922\t        ;; one row that is both oversized and malformed: the budget, not\n   923\t        ;; the row, must be what refuses it under a tight bound\n   924\t        big (into [:literal] (concat (range 512) [:extra]))\n   925\t        root (jing/materialize! store big)]\n   926\t    (is (= {:status :refused, :reason :parts-limit, :bound :max-bytes,\n   927\t            :address root}\n   928\t           (select-keys (linker/fetch store {root root} linker/ast-format\n   929\t                                      root receiver {:max-bytes 64})\n   930\t                        [:status :reason :bound :address]))\n   931\t        \"the oversized row is refused before its slots are decoded and\n   932\t         judged\")\n   933\t    (is (= :descriptor-defect\n   934\t           (:reason (linker/fetch store {root root} linker/ast-format\n   935\t                                  root receiver)))\n   936\t        \"under the finite defaults the same row is judged: the refusal\n   937\t         above is the budget's, not the row's\")\n   938\t    (jing/close! store)))\n   939\t\n   940\t\n   941\t(deftest the-parts-budget-is-enforced-at-enqueue-time\n   942\t  (let [store (mem/create-content-mem)\n   943\t        leaf-id (jing/segment-key [:literal 5])\n   944\t        other-leaf (jing/segment-key [:literal 6])\n   945\t        mid-body (app-body leaf-id)\n   946\t        mid-id (jing/segment-key mid-body)\n   947\t        root-body [:application mid-id [other-leaf] false]\n   948\t        root (jing/segment-key root-body)]\n   949\t    (doseq [body [root-body mid-body]]\n   950\t      (jing/materialize! store body))\n   951\t    (let [counts (atom {})\n   952\t          res (linker/fetch (counting-store store counts)\n   953\t                            {root root} linker/ast-format root\n   954\t                            receiver {:max-parts 2})]\n   955\t      (is (= {:bound :max-parts, :address other-leaf}\n   956\t             (select-keys res [:bound :address]))\n   957\t          \"the child beyond the budget is refused while its sibling is\n   958\t           enqueued, before either is fetched\")\n   959\t      (is (zero? (get @counts mid-id 0))\n   960\t          \"no child beyond the budget is ever read\")\n   961\t      (is (= 1 (get @counts root 0))))\n   962\t    (jing/close! store)))\n   963\t\n   964\t\n   965\t(deftest a-fetch-without-explicit-bounds-is-finite\n   966\t  (let [store (mem/create-content-mem)\n   967\t        root (loop [child (jing/segment-key [:literal 1]), i 0]\n   968\t               (if (= i 300)\n   969\t                 child\n   970\t                 (let [body (app-body child)]\n   971\t                   (jing/materialize! store body)\n   972\t                   (recur (jing/segment-key body) (inc i)))))\n   973\t        res (linker/fetch store {root root} linker/ast-format root\n   974\t                          receiver)]\n   975\t    (is (= {:reason :parts-limit, :bound :max-depth}\n   976\t           (select-keys res [:reason :bound]))\n   977\t        \"the linker's own finite `default-bounds` end the walk\")\n   978\t    (jing/close! store)))\n   979\t\n   980\t\n   981\t;; =============================================================================\n   982\t;; Section 4.2 step 5a: the occurrence/definition join\n   983\t;; =============================================================================\n   984\t\n   985\t(deftest a-definition-discharges-a-use-after-it\n   986\t  (doseq [[label format mint] formats]\n   987\t    (testing label\n   988\t      (let [store (mem/create-content-mem)\n   989\t            {:ke