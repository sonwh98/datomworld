84\t     3. ((:identity-matches-fn format) identity root :hash-mismatch\n  1085\t     4. ((:validate-fn format) whole) is nil         :descriptor-defect\n  1086\t     5a. the scanners' occurrences join their        :use-before-definition\n  1087\t         definitions: an unconditional definition\n  1088\t         that dominates the occurrence discharges\n  1089\t         it; the rest are retained\n  1090\t     5b. every retained obligation binds in the      :unresolved-free,\n  1091\t         receiver                                    :shadowed-free\n  1092\t     6. the verified image\n  1093\t\n  1094\t   For a multi-part format the whole of steps 4 to 6 is the tree\n  1095\t   assembled by prepending each fetched part's address, the shape\n  1096\t   `validate-rows` takes (section 5.1), and the outcome carries\n  1097\t   `:parts {address body}`.\"\n  1098\t  ([handle index format identity]\n  1099\t   (fetch handle index format identity {}))\n  1100\t  ([handle index format identity receiver]\n  1101\t   (fetch handle index format identity receiver nil))\n  1102\t  ([handle index format identity receiver opts]\n  1103\t   (let [{:keys [contract]} opts]\n  1104\t     (if (and (some? contract) (not= contract (:contract format)))\n  1105\t       (refused :contract-mismatch\n  1106\t                {:expected contract, :actual (:contract format)})\n  1107\t       (if-let [address (index identity)]\n  1108\t         (if-not (jing/segment-address? address)\n  1109\t           (refused :absent {:address address})\n  1110\t           (let [worklist (fetch-parts handle format identity address\n  1111\t                                       opts)]\n  1112\t             (if (refused? worklist)\n  1113\t               worklist\n  1114\t               (let [{:keys [parts multi?]} worklist\n  1115\t                     root-value (get parts address)\n  1116\t                     whole (if multi?\n  1117\t                             {:root identity,\n  1118\t                              :rows (into {}\n  1119\t                                          (map (fn [[a v]] [a (into [a] v)]))\n  1120\t                                          parts)}\n  1121\t                             root-value)]\n  1122\t                 (if-not (matches-identity? format identity root-value)\n  1123\t                   (refused :hash-mismatch\n  1124\t                            {:expected identity,\n  1125\t                             :actual (identity-of format root-value)})\n  1126\t                   (if-let [defect (validation-defect format whole)]\n  1127\t                     (refused :descriptor-defect\n  1128\t                              {:identity identity, :defect defect})\n  1129\t                     (let [joined (undischarged\n  1130\t                                    ((:obligations-fn format) whole)\n  1131\t                                    (scanned format :definitions-fn\n  1132\t                                             whole)\n  1133\t                                    (scanned format :applications-fn\n  1134\t                                             whole))]\n  1135\t                       (or (:defect joined)\n  1136\t                           (free-name-defect receiver\n  1137\t                                             (:obligations joined))\n  1138\t                           (merge {:status :ok,\n  1139\t                                   :format (:format format),\n  1140\t                                   :identity identity,\n  1141\t                                   :address address,\n  1142\t                                   :value whole,\n  1143\t                                   :obligations (:obligations joined)}\n  1144\t                                  (when multi? {:parts parts}))))))))))\n  1145\t         (refused :absent {:identity identity}))))))\n  1146\t\n  1147\t\n  1148\t;; =============================================================================\n  1149\t;; Publishing (the mint-side counterpart the tests and compositions use)\n  1150\t;; =============================================================================\n  1151\t\n  1152\t(defn publish!\n  1153\t  \"Store `image` in `handle` and return its index datom\n  1154\t   `[identity attribute address]`. The address is the store's own\n  1155\t   `segment-key`; the identity is the format's own mint. The caller owns\n  1156\t   the index: nothing is recorded here. The two storage-derived formats\n  1157\t   mint through `yin.vm.content` instead (section 9).\"\n  1158\t  [handle format image]\n  1159\t  (let [address (jing/materialize! handle image)]\n  1160\t    [((:identity-fn format) image) (address-attribute format) address]))\n  1161\t\n  1162\t\n  1163\t;; =============================================================================\n  1164\t;; Same-root pairing (section 7)\n  1165\t;; =============================================================================\n  1166\t\n  1167\t(defn pairing-datoms\n  1168\t  \"The mint-time pairing datoms recorded beside a named root.\"\n  1169\t  [root H R]\n  1170\t  [[root :yin.debruijn.code/hash H]\n  1171\t   [root :yin.debruijn.register/hash R]])\n  1172\t\n  1173\t\n  1174\t(defn root-pairing\n  1175\t  \"`{:root root :H H :R R}` read from pairing datoms, or nil when either\n  1176\t   half is missing.\"\n  1177\t  [root datoms]\n  1178\t  (let [value-of (fn [attr]\n  1179\t                   (some (fn [[e a v]] (when (and (= root e) (= attr a)) v))\n  1180\t                         datoms))\n  1181\t        H (value-of :yin.debruijn.code/hash)\n  1182\t        R (value-of :yin.debruijn.register/hash)]\n  1183\t    (when (and H R) {:root root, :H H, :R R})))\n  1184\t\n  1185\t\n  1186\t(defn- relowered-hashes\n  1187\t  [source-datoms]\n  1188\t  (try\n  1189\t    (let [resolved (resolve/resolve source-datoms)]\n  1190\t      {:H (debruijn-code/image-hash\n","exit_code":0,"status":"completed"}}
