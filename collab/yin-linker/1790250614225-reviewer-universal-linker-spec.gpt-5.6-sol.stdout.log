3\t         rows {}]\n    84\t    (if (= index (count queue))\n    85\t      (let [tree {:root root, :rows rows}]\n    86\t        (when-let [{:keys [rule path id]} (vm/validate-rows tree)]\n    87\t          (throw (ex-info \"Semantic bytecode row set failed validation\"\n    88\t                          (cond-> {:rule rule}\n    89\t                            path (assoc :path path)\n    90\t                            id (assoc :id id)))))\n    91\t        tree)\n    92\t      (let [id (nth queue index)]\n    93\t        (if (contains? rows id)\n    94\t          (recur queue (inc index) rows)\n    95\t          (let [body (jing/get handle id absent)]\n    96\t            (cond\n    97\t              (identical? body absent)\n    98\t              (throw (ex-info \"dao.jing content address resolves to no payload\"\n    99\t                              {:id id}))\n   100\t\n   101\t              (not (jing/segment-matches? id body))\n   102\t              (throw (ex-info \"dao.jing content does not hash to its address\"\n   103\t                              {:id id, :body body}))\n   104\t\n   105\t              :else\n   106\t              (recur (into queue (if (vector? body) (body-child-ids body) []))\n   107\t                     (inc index)\n   108\t                     (assoc rows id (if (vector? body)\n   109\t                                      (into [id] body)\n   110\t                                      [id body]))))))))))\n   111\t\n   112\t\n   113\t(defn materialize-vector!\n   114\t  \"Materialize one canonical instruction vector as the exact payload at its\n   115\t   own `(jing/segment-key v)` address (UCF §7.3.4: nothing else may hash\n  1070\t   item-index]` (§2.5).\"\n  1071\t  [tag body]\n  1072\t  (let [slots (get semantic-bytecode-grammar tag)]\n  1073\t    (mapcat (fn [i [_ kind] v]\n  1074\t              (case kind\n  1075\t                :node [[[i] v]]\n  1076\t                :nodes (map-indexed (fn [j cid] [[[i j] cid]]) v)\n  