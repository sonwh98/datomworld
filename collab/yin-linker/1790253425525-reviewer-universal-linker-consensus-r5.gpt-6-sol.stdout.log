isited new-visited)))))\n  1123\t        defect-path (fn [id] (get paths id))\n  1124\t        defect-res (fn [rule id & [path-suffix]]\n  1125\t                     (if-let [p (defect-path id)]\n  1126\t                       {:rule rule :path (if path-suffix (into p path-suffix) p)}\n  1127\t                       {:rule rule :id id}))\n  1128\t        tag-defect (some (fn [[id row]]\n  1129\t                           (let [tag (safe-tag row)]\n  1130\t                             (when-not (safe-slots tag)\n  1131\t                               (defect-res :tag id))))\n  1132\t                         rows)\n  1133\t        arity-defect (some (fn [[id row]]\n  1134\t                             (let [tag (safe-tag row)\n  1135\t                                   slots (safe-slots tag)\n  1136\t                                   body (subvec row 1)]\n  1137\t                               (when (not= (count slots) (dec (count body)))\n  1138\t                                 (defect-res :arity id))))\n  1139\t                           rows)\n  1140\t        slot-kind-defect (some (fn [[id row]]\n  1141\t                                 (let [tag (safe-tag row)\n  1142\t                                       slots (safe-slots tag)\n  1143\t                                       body (subvec row 1)]\n  1144\t                                   (some identity\n  1145\t                                         (map (fn [i [field kind] v]\n  1145\t                                         (map (fn [i [field kind] v]\n  1146\t                                                (when-not (or (semantic-bytecode-slot-kind-ok? kind v)\n  1147\t                                                              (and (nil? v) (contains? semantic-bytecode-defaults [tag field])))\n  1148\t                                                  (defect-res :slot-kind id [i])))\n  1149\t                                              (range 1 (inc (count slots))) slots (rest body)))))\n  1150\t                               rows)\n  1151\t        saturation-defect (some (fn [[id row]]\n  1152\t                                  (let [tag (safe-tag row)\n  1153\t                                        slots (safe-slots tag)\n  1154\t                                        body (subvec row 1)]\n  1155\t                                    (some identity\n  1156\t                                          (map (fn [i [field kind] v]\n  1157\t                                                 (when (and (nil? v)\n  1158\t                                                            (contains? semantic-bytecode-defaults [tag field]))\n  1159\t                                                   (defect-res :saturation id [i])))\n  1160\t                                               (range 1 (inc (count slots))) slots (rest body)))))\n  1161\t                                rows)\n  1162\t        id-resolves-defect (or (when-not (contains? rows root)\n  1163\t                                 {:rule :id-resolves :path []})\n  1164\t                               (some (fn [[id row]]\n  1165\t                                       (some (fn [[suffix cid]]\n  1166\t                                               (when-not (contains? rows cid)\n  1167\t                                                 (defect-res :id-resolves id suffix)))\n  1168\t                                             (safe-children id)))\n  1169\t                                     rows))\n  1170\t        acyclic-defect (letfn [(check-cycle\n  1171\t                                 [id on-path]\n  1172\t                                 (cond\n  1173\t                                   (contains? on-path id) (defect-res :acyclic id)\n  1174\t                                   :else\n  1175\t                                   (let [row (get rows id)]\n  1176\t                                     (when row\n  1177\t                                       (let [on-path' (conj on-path id)]\n  1178\t         