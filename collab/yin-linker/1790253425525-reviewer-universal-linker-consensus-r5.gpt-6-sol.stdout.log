n entry back into the registers; and the FFI\nsrc/cljc/yin/vm/debruijn/stack.cljc:27:       {:segment :pc :frames :stack :continuation :format :hash}\nsrc/cljc/yin/vm/debruijn/stack.cljc:29:   `:format` is `:yin.debruijn.code` and `:hash` is the loaded image's H\nsrc/cljc/yin/vm/debruijn/stack.cljc:32:   `stack-restore` refuses any entry whose model or image differs with a\nsrc/cljc/yin/vm/debruijn/stack.cljc:64:;; `yin.vm.engine/resolve-var` implements for the named VM. :hash is the\nsrc/cljc/yin/vm/debruijn/stack.cljc:102:   earlier image cannot be restored against this one: `stack-restore`\nsrc/cljc/yin/vm/debruijn/stack.cljc:107:         :hash (dcode/image-hash segment)\nsrc/cljc/yin/vm/debruijn/stack.cljc:143:            :hash nil,\nsrc/cljc/yin/vm/debruijn/stack.cljc:207:   return-frame continuation are the running ones. `:format` and `:hash`\nsrc/cljc/yin/vm/debruijn/stack.cljc:217:   :hash (:hash vm)})\nsrc/cljc/yin/vm/debruijn/stack.cljc:225:                   :hash (:hash entry),\nsrc/cljc/yin/vm/debruijn/stack.cljc:227:                   :expected-hash (:hash base)})))\nsrc/cljc/yin/vm/debruijn/stack.cljc:230:(defn stack-restore\nsrc/cljc/yin/vm/debruijn/stack.cljc:237:   the entry's `:format` is `:yin.debruijn.code` and its `:hash` equals the\nsrc/cljc/yin/vm/debruijn/stack.cljc:258:                 (= (:hash base) (:hash entry)))\nsrc/cljc/yin/vm/debruijn/stack.cljc:325:   identical request, and `stack-restore` turns that writer into the\nsrc/cljc/yin/vm/debruijn/stack.cljc:543:                                    stack-restore))\nsrc/cljc/yin/vm/debruijn/stack.cljc:565:                   #(engine/resume-from-run-queue % stack-restore)))\nsrc/cljc/yin/vm/debruijn/stack.cljc:583:          (engine/scheduler-round this stack-restore)\n   270\t      (assoc base\n   271\t             :segment (:segment entry)\n   272\t             :pc (:pc entry)\n   273\t             :frames (:frames entry)\n   274\t             :continuation (:continuation entry)\n   275\t             :stack (conj (vec (:stack entry)) val)\n   276\t             :value val\n   277\t             ;; Restored registers are active work: a driver resuming a\n   278\t             ;; halted machine directly through `engine/resume-continuation`\n   279\t             ;; gets a running one back, as the semantic VM's restore gives.\n   280\t             :halted? false))))\n   281\t\n   282\t\n   283\t(defn- park-entry-fns\n   284\t  \"Wait-entry builders for an instruction whose effect may block (design\n   285\t   section 4.1, item 5): each closes over the post-instruction registers\n   286\t   and returns them merged with `:reason` and the resource ids from the\n   287\t   handler's result. Nothing else is attached: no handle, no closure, no\n   288\t   restore function.\"\n   289\t  [vm pc' stack']\n   290\t  (let [regs (registers vm pc' stack')]\n   291\t    {:stream/put (fn [_state _effect result]\n   292\t                   (assoc regs\n   293\t                          :reason :put\n   294\t                          :stream-id (:stream-id result))),\n   295\t     :stream/next (fn [_state _effect result]\n   296\t                    (assoc regs\n   297\t                           :reason :next\n   298\t                           :cursor-ref (:cursor-ref result)\n   299\t                           :stream-id (:stream-id result)))}))\n   300\t\n   301\t\n   302\t(defn- run-effect\n   303\t  \"Dispatch one effect through the engine from the instruction at `(:pc vm)`\n   304\t   with `stack'` its operand stack after popping the instruction's operands.\n   305\t   On a value the machine continues at pc+1 with the value on the stack; on\n   306\t   a park the engine has already placed the pure-data entry in the wait set\n   307\t   and marked the machine blocked, and the registers mirror that entry.\"\n   308\t  [vm effect stack']\n   309\t  (let [pc' (inc (:pc vm))\n   310\t        {:keys [state value blocked?]}\n   311\t        (engine/handle-effect vm\n   312\t                              effect\n   313\t                              {:park-entry-fns (park-entry-fns vm pc' stack')})]\n   314\t    (if blocked?\n   315\t      (assoc state :pc pc' :stack stack')\n   316\t      (assoc state :pc pc' :stack (conj stack' value)))))\n   317\t\n   318\t\n   319\t(defn- ffi-call\n   320\t  \"`[:ffi-call op argc]`: park-and-call over the FFI pair (the two-step of\n   255\t                                  :frames (:frames entry)\n   256\t                                  :continuation (:continuation entry)\n   257\t                                  :halted? false)\n   258\t                           val)\n   259\t        (let [segment (:segment entry)\n   260\t              pc (:pc entry)\n   261\t              body (body-of-pc segment pc)\n   262\t              reg-count (:registers body)\n   263\t              dest (:dest entry)\n   264\t              restored-regs\n   265\t              (reduce (fn [acc [r v]] (assoc acc r v))\n   266\t                      (vec (repeat reg-count nil))\n   267\t                      (:regs entry))\n   268\t              final-regs (if (some? dest)\n   269\t                           (assoc restored-regs dest val)\n   270\t                           restored-regs)]\n   271\t          (assoc base\n   272\t                 :segment segment\n   273\t                 :pc pc\n   274\t                 :frames (:frames entry)\n   275\t                 :registers final-regs\n   276\t                 :continuation (:continuation entry)\n   277\t                 :value val\n   278\t                 :halted? false))))))\n   279\t\n   280\t\n   281\t;; =============================================================================\n   282\t;; Effects & FFI dispatch\n   283\t;; =============================================================================\n   284\t\n   285\t(defn- park-entry-fns\n   286\t  [payload]\n   287\t  {:stream/put (fn [_state effect result]\n   288\t                 (assoc payload\n   289\t                        :reason :put\n   290\t                        :stream-id (:stream-id result)\n   291\t                        :datom (:val effect))),\n   292\t   :stream/next (fn [_state _effect result]\n   293\t                  (assoc payload\n   294\t                         :reason :next\n   295\t                         :cursor-ref (:cursor-ref result)\n   296\t                         :stream-id (:stream-id result)))})\n   297\t\n   298\t\n   299\t(defn- run-effect\n   300\t  [vm effect inst]\n   301\t  (let [opts (when (rcode/boundary-opcodes (first inst))\n   302\t               {:park-entry-fns\n   303\t                (park-entry-fns (effects/continuation-payload vm inst))})\n   304\t        pc' (inc (:pc vm))\n   305\t        {:keys [state value blocked?]}\n   306\t        (engine/handle-effect vm effect opts)]\n   307\t    (if blocked?\n   308\t      (assoc state :pc pc')\n   309\t      (let [rd (nth inst 1)]\n   310\t        (assoc state\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/debruijn/stack.cljc | sed -n '205,270p'; nl -ba src/cljc/yin/vm/debruijn/register.cljc | sed -n '197,263p'; nl -ba docs/design/yin.vm.linker.md | sed -n '1708,1727p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/debruijn/stack.cljc | sed -n '205,270p'; nl -ba src/cljc/yin/vm/debruijn/register.cljc | sed -n '197,263p'; nl -ba docs/design/yin.vm.linker.md | sed -n '1708,1727p'\"","aggregated_output":"   205\t   (design section 4.1, item 3): `pc'` is the advanced pc and `stack'` the\n   206\t   operand stack with the instruction's operands popped. Frames and the\n   207\t   return-frame continuation are the running ones. `:format` and `:hash`\n   208\t   stamp the model and image identity that produced it. Free environment,\n   209\t   store, primitives, and modules are not registers and stay on the state.\"\n   210\t  [vm pc' stack']\n   211\t  {:segment (:segment vm),\n   212\t   :pc pc',\n   213\t   :frames (:frames vm),\n   214\t   :stack stack',\n   215\t   :continuation (:continuation vm),\n   216\t   :format format-tag,\n   217\t   :hash (:hash vm)})\n   218\t\n   219\t\n   220\t(defn- refuse-continuation!\n   221\t  [base entry]\n   222\t  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n   223\t                  {:rule :continuation-format,\n   224\t                   :format (:format entry),\n   225\t                   :hash (:hash entry),\n   226\t                   :expected-format format-tag,\n   227\t                   :expected-hash (:hash base)})))\n   228\t\n   229\t\n   230\t(defn stack-restore\n   231\t  \"This machine's one restore function, `base entry val -> state`\n   232\t   (`yin.vm.engine.md` section 2.1; design section 4.1, item 4). `base` is\n   233\t   the state after the engine has done its part; `entry` is the wait, ready,\n   234\t   or parked record; `val` is the value the parked instruction receives.\n   235\t\n   236\t   It first refuses with a qualified `:continuation-format` outcome unless\n   237\t   the entry's `:format` is `:yin.debruijn.code` and its `:hash` equals the\n   238\t   loaded image's H: a continuation from the named VM, from the register\n   239\t   kernel, or from another image is never interpreted here.\n   240\t\n   241\t   Then the FFI two-step, on the entry keys the `yin.vm.ffi` convention\n   242\t   owns, in the semantic VM's placement:\n   243\t\n   244\t   - A `:request-sent` entry is a writer whose retained request has now been\n   245\t     appended. It must not resume: its registers are re-parked as the\n   246\t     call-out reader (`ffi/response-wait-entry`) and the machine stays\n   247\t     blocked.\n   248\t   - A `:call-id` entry is a response reader. The woken value is a response\n   249\t     envelope, so `ffi/call-result` unwraps it and checks correlation, and\n   250\t     the parked call leaves `:parked` rather than accumulating.\n   251\t\n   252\t   Otherwise the registers are written from the entry and `val` is conjed\n   253\t   onto the restored `:stack` -- the B3 obligation that every\n   254\t   value-producing opcode lands on the stack, since there is no\n   255\t   accumulator.\"\n   256\t  [base entry val]\n   257\t  (when-not (and (= format-tag (:format entry))\n   258\t                 (= (:hash base) (:hash entry)))\n   259\t    (refuse-continuation! base entry))\n   260\t  (if (:request-sent entry)\n   261\t    (-> base\n   262\t        (update :wait-set (fnil conj [])\n   263\t                (ffi/response-wait-entry entry (:call-id entry)))\n   264\t        (assoc :value :yin/blocked\n   265\t               :blocked? true\n   266\t               :halted? false))\n   267\t    (let [call-id (:call-id entry)\n   268\t          base (if call-id (update base :parked dissoc call-id) base)\n   269\t          val (if call-id (ffi/call-result val call-id) val)]\n   270\t      (assoc base\n   197\t                                  (vec (repeat reg-count nil))\n   198\t                                  (:regs frame))\n   199\t            final-regs (if (some? dest)\n   200\t                         (assoc restored-regs dest val)\n   201\t                         restored-regs)]\n   202\t        (assoc vm\n   203\t               :segment seg\n   204\t               :hash (:hash frame)\n   205\t               :pc return-pc\n   206\t               :frames (:frames frame)\n   207\t               :registers final-regs\n   208\t               :continuation (pop continuation)\n   209\t               :value val\n   210\t               :halted? false))\n   211\t      (assoc vm :halted? true, :value val))))\n   212\t\n   213\t\n   214\t(defn- refuse-continuation!\n   215\t  [base entry]\n   216\t  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n   217\t                  {:rule :continuation-format,\n   218\t                   :format (:format entry),\n   219\t                   :hash (:hash entry),\n   220\t                   :expected-format format-tag,\n   221\t                   :expected-hash (:hash base)})))\n   222\t\n   223\t\n   224\t(defn register-restore\n   225\t  \"The register VM's restore function, `base entry val -> state`\n   226\t   (design section 5.2.3). Validates format identity and image hash R,\n   227\t   checks that the payload is defect-free via effects/continuation-defect,\n   228\t   checks that `val` is plain data, handles the FFI two-step, and delivers\n   229\t   `val` via `:write-result` or `:return-result`.\"\n   230\t  [base entry val]\n   231\t  (when-not (and (= format-tag (:format entry))\n   232\t                 (= (:hash base) (:hash entry)))\n   233\t    (refuse-continuation! base entry))\n   234\t  (when-let [defect (effects/continuation-defect entry)]\n   235\t    (throw (ex-info \"Corrupt or tampered continuation payload\"\n   236\t                    defect)))\n   237\t  (when-not (vm/plain-data? val)\n   238\t    (throw (ex-info \"Resume value must be plain data\"\n   239\t                    {:rule :resume-value, :val val})))\n   240\t  (if (:request-sent entry)\n   241\t    (-> base\n   242\t        (update :wait-set (fnil conj [])\n   243\t                (ffi/response-wait-entry entry (:call-id entry)))\n   244\t        (assoc :value :yin/blocked\n   245\t               :blocked? true\n   246\t               :halted? false))\n   247\t    (let [call-id (:call-id entry)\n   248\t          base (if call-id (update base :parked dissoc call-id) base)\n   249\t          val (if call-id (ffi/call-result val call-id) val)\n   250\t          resume-mode (:resume-mode entry)]\n   251\t      (if (= :return-result resume-mode)\n   252\t        (return-transition (assoc base\n   253\t                                  :segment (:segment entry)\n   254\t                                  :pc (:pc entry)\n   255\t                                  :frames (:frames entry)\n   256\t                                  :continuation (:continuation entry)\n   257\t                                  :halted? false)\n   258\t                           val)\n   259\t        (let [segment (:segment entry)\n   260\t              pc (:pc entry)\n   261\t              body (body-of-pc segment pc)\n   262\t              reg-count (:registers body)\n   263\t              dest (:dest entry)\n  1708\t   `:contract-mismatch` before validation runs.\n  1709\t8. A malformed row is refused before any of its children is requested,\n  1710\t   and every composition bound produces `:parts-limit`.\n  1711\t9. Local `fetch` produces exactly the content-pair traffic the stepped\n  1712\t   path produces and holds no content handle.\n  1713\t\n  1714\tRequire:\n  1715\t\n  1716\t10. `(require 'foo)` on each of the four backends, over ring buffers,\n  1717\t    parks, links, installs through the child phases, and resumes with\n  1718\t    `'foo`; the same over the JVM WebSocket content path.\n  1719\t11. The registry value holds no function that arrived by linking; every\n  1720\t    linked module's `:bindings` came from an isolated child evaluation\n  1721\t    that reached halt with every export bound.\n  1722\t12. UCF section 7.4.1 carries `:link-request`, `:link-response`, and\n  1723\t    `:install` safepoints, section 7.4.3 their pending variants, section\n  1724\t    7.5.1 the `:yin.k/binding` closure variants of section 7.3, and a\n  1725\t    parked entry of each kind lifts and lowers through UCF's round-trip\n  1726\t    test.\n  1727\t13. Every swapped-image and swapped-name case in M4 refuses before load.\n","exit_code":0,"status":"completed"}}
