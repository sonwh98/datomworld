{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/jing/dht/node_test.cljc | sed -n '1,65p;130,225p'\nnl -ba src/cljc/dao/jing/dht/node.cljc | sed -n '98,187p'\nnl -ba src/cljc/dao/stream/transit.cljc | sed -n '46,73p;93,121p'\nrg -n 'dao\\\\.stream\\\\.transit|transit-clj|transit-java' test/dao/jing/dht/node_test.cljc src/cljc/dao/jing/dht/node.cljc deps.edn\nrg --files /Users/sto/.m2/repository/com/cognitect | rg 'transit.*(jar|pom)\"'$'\"'\"","aggregated_output":"     1\t(ns dao.jing.dht.node-test\n     2\t  \"JVM integration tests for the UDP Kademlia node: real sockets on\n     3\t  localhost exchanging datagrams. The transport is JVM-only today (see\n     4\t  docs/design/dao.jing.dht.md, Transport), so every test is :clj-guarded;\n     5\t  the backend semantics themselves are covered cross-platform in\n     6\t  dao.jing.dht-test.\"\n     7\t  ;; :cljd nil must come FIRST (first matching branch wins and the cljd\n     8\t  ;; host pass also matches :clj): otherwise the host pass sees the\n     9\t  ;; deftests, registers a test namespace, and generates a Dart test\n    10\t  ;; entrypoint with no main. The :namespaces rule is disabled\n    11\t  ;; project-wide (see root .cljstyle) because it would otherwise flip\n    12\t  ;; this order back on every `cljstyle fix`.\n    13\t  #?(:cljd nil\n    14\t     :clj (:require [clojure.test :refer [deftest is testing]]\n    15\t                    [dao.jing :as jing]\n    16\t                    [dao.jing.mem :as mem]\n    17\t                    [dao.jing.dht :as dht]\n    18\t                    [dao.jing.dht.node :as node]\n    19\t                    [dao.stream.transit :as transit]\n    20\t                    [cognitect.transit :as raw-transit])))\n    21\t\n    22\t\n    23\t#?(:cljd nil\n    24\t   :clj\n    25\t   (defn- raw-encode\n    26\t     \"Encode straight through cognitect.transit, bypassing v2's\n    27\t      `ensure-portable!` on the outbound side too, so a datagram carrying a\n    28\t      tag v2 rejects (e.g. uuid) can be constructed as a hostile peer\n    29\t      unconstrained by the portable domain would send it.\"\n    30\t     ^bytes [msg]\n    31\t     (let [out (java.io.ByteArrayOutputStream.)]\n    32\t       (raw-transit/write (raw-transit/writer out :json) msg)\n    33\t       (.getBytes (.toString out \"UTF-8\") \"UTF-8\"))))\n    34\t\n    35\t\n    36\t#?(:cljd nil\n    37\t   :clj\n    38\t   (defn- with-cluster\n    39\t     \"Run f with n DHT content stores over real UDP nodes on localhost, the\n    40\t      first node acting as the bootstrap peer for the rest. Closes\n    41\t      everything.\"\n    42\t     [n f]\n    43\t     (let [opts {:host \"127.0.0.1\", :timeout-ms 300, :tries 2}\n    44\t           head (node/create-content-dht-udp opts)\n    45\t           port (:port (dht/self-peer (:net head)))\n    46\t           tail (doall (repeatedly (dec n)\n    47\t                                   #(node/create-content-dht-udp\n    48\t                                      (assoc opts\n    49\t                                             :bootstrap [{:host \"127.0.0.1\",\n    50\t                                                          :port port}]))))\n    51\t           stores (into [head] tail)]\n    52\t       (try (f stores) (finally (run! jing/close! stores))))))\n    53\t\n    54\t\n    55\t#?(:cljd nil\n    56\t   :clj\n    57\t   (deftest udp-materialize-then-get-across-nodes\n    58\t     (testing\n    59\t       \"a payload materialized on one UDP node is fetched by another over the wire\"\n    60\t       (with-cluster 3\n    61\t         (fn [[a _ c]]\n    62\t           (let [v {:bytes [1 2 3]}\n    63\t                 k (jing/materialize! a v)]\n    64\t             (is (= v (jing/get c k nil)))))))))\n    65\t\n   130\t            (let [handle (deref #'node/handle)\n   131\t                  local (mem/create-content-mem)]\n   132\t              (is (thrown? Exception\n   133\t                    (handle local {} {:op :root-get, :k :root/head})))\n   134\t              (is (thrown? Exception\n   135\t                    (handle local\n   136\t                            {}\n   137\t                            {:op :root-cas,\n   138\t                             :k :root/head,\n   139\t                             :expected 0,\n   140\t                             :v {:p \"x\"}})))))))\n   141\t\n   142\t\n   143\t#?(:cljd nil\n   144\t   :clj\n   145\t   (deftest hostile-datagram-does-not-kill-the-receiver\n   146\t     (testing\n   147\t       \"a datagram with a malformed :from is dropped; the node keeps serving\"\n   148\t       (with-cluster\n   149\t         2\n   150\t         (fn [[a b]]\n   151\t           (let [port (:port (dht/self-peer (:net b)))\n   152\t                 payload (.getBytes ^String\n   153\t                          (transit/encode\n   154\t                            {:op :ping, :rpc 0, :from {:id 42}})\n   155\t                                    \"UTF-8\")]\n   156\t             (with-open [s (java.net.DatagramSocket.)]\n   157\t               (.send s\n   158\t                      (java.net.DatagramPacket.\n   159\t                        payload\n   160\t                        (alength payload)\n   161\t                        (java.net.InetAddress/getByName \"127.0.0.1\")\n   162\t                        (int port))))\n   163\t             (Thread/sleep 100)\n   164\t             ;; b's receiver must survive to deliver the reply to the\n   165\t             ;; forced fetch, whose value never replicated off a\n   166\t             (let [v {:bytes [42]}\n   167\t                   k (jing/materialize! (:local a) v)]\n   168\t               (is (= v (jing/get b k nil))))))))))\n   169\t\n   170\t\n   171\t#?(:cljd nil\n   172\t   :clj\n   173\t   (deftest non-portable-tag-decode-failure-is-dropped-not-fatal\n   174\t     (testing\n   175\t       \"a datagram outside dao.stream's portable domain is dropped on\n   176\t        decode, drawing no reply; the node keeps serving (D8: v2 decode\n   177\t        throws where v1 did not, for a uuid/bigint/bigdec/uri/quoted/link\n   178\t        tag)\"\n   179\t       (with-cluster\n   180\t         2\n   181\t         (fn [[a b]]\n   182\t           (let [port (:port (dht/self-peer (:net b)))\n   183\t                 payload (raw-encode\n   184\t                           {:op :ping, :rpc 0, :id (java.util.UUID/randomUUID)})]\n   185\t             (with-open [s (java.net.DatagramSocket.)]\n   186\t               (.send s\n   187\t                      (java.net.DatagramPacket.\n   188\t                        payload\n   189\t                        (alength payload)\n   190\t                        (java.net.InetAddress/getByName \"127.0.0.1\")\n   191\t                        (int port)))\n   192\t               (.setSoTimeout s 200)\n   193\t               (is (thrown? java.net.SocketTimeoutException\n   194\t                     (.receive s (java.net.DatagramPacket.\n   195\t                                   (byte-array 65536) 65536)))\n   196\t                   \"a datagram carrying a non-portable tag draws no reply: decode throws before the ping is ever handled\"))\n   197\t             (let [v {:bytes [43]}\n   198\t                   k (jing/materialize! (:local a) v)]\n   199\t               (is (= v (jing/get b k nil))))))))))\n   200\t\n   201\t\n   202\t#?(:cljd nil\n   203\t   :clj\n   204\t   (deftest rpc-failure-means-unreachable-not-thrown\n   205\t     (testing\n   206\t       \"a host that cannot be resolved or reached yields nil/false per the\n   207\t       IDhtNet contract, never an exception\"\n   208\t       (let [net (node/create-node\n   209\t                   {:host \"127.0.0.1\", :timeout-ms 100, :tries 1})\n   210\t             bad {:id (dht/node-id \"bad\" 1),\n   211\t                  :host \"invalid host name with spaces\",\n   212\t                  :port 1}]\n   213\t         (try (is (nil? (dht/fetch-content net bad :segment/abc)))\n   214\t              (is (nil? (dht/find-closer net bad (dht/node-id \"t\" 0))))\n   215\t              (is (false?\n   216\t                    (dht/store-content! net bad :segment/abc {:bytes [1]})))\n   217\t              (finally (dht/close-net! net)))))))\n   218\t\n   219\t\n   220\t#?(:cljd nil\n   221\t   :clj\n   222\t   (deftest udp-packet-size-variation\n   223\t     (testing\n   224\t       \"packets of varying sizes can be received sequentially without truncation\"\n   225\t       (with-cluster 2\n    98\t#?(:cljd nil\n    99\t   :clj\n   100\t   (defn- handle\n   101\t     \"Serve one request against this node's local content store.\"\n   102\t     [local table msg]\n   103\t     (case (:op msg)\n   104\t       :ping {:pong true}\n   105\t       :find-node {:peers (kad/nearest @table (:target msg) kad/k)}\n   106\t       ;; peers are untrusted: the address must be the exact strict\n   107\t       ;; segment address for the payload, never a bare hash, a\n   108\t       ;; foreign namespace, or a mismatched value, and the local\n   109\t       ;; backend's verdict must be an explicit :inserted/:present\n   110\t       :store-content\n   111\t       (let [{:keys [address v]} msg]\n   112\t         (try\n   113\t           (if (and (jing/segment-address? address)\n   114\t                    (= (jing/segment-hash address) (jing/content-hash v)))\n   115\t             (let [result ((:put-content-fn local) address v)]\n   116\t               (if (#{:inserted :present} result) {:ok true} {:ok false}))\n   117\t             {:ok false})\n   118\t           (catch Exception _ {:ok false})))\n   119\t       ;; :found travels explicitly on both reads: values are opaque\n   120\t       ;; and nil is a legal one, so it cannot be inferred from :v\n   121\t       :fetch-content\n   122\t       (let [v (jing/get local (:address msg) missing)]\n   123\t         (if (identical? v missing) {:found false} {:found true, :v v}))\n   124\t       ;; no root or CAS op exists on this wire; unknown ops are\n   125\t       ;; thrown and answered as {:error ...} by the receiver\n   126\t       (throw (ex-info \"dao.jing.dht.node: unknown op\" {:op (:op msg)})))))\n   127\t\n   128\t\n   129\t#?(:cljd nil\n   130\t   :clj\n   131\t   (defn- start-receiver!\n   132\t     \"One daemon thread per node: decodes datagrams, observes senders into\n   133\t      the routing table, delivers replies to pending requests, and serves\n   134\t      requests. Replies go to the datagram's source address, not the claimed\n   135\t      :from.\"\n   136\t     [^DatagramSocket socket local table self ^ConcurrentHashMap pending]\n   137\t     (doto\n   138\t       (Thread.\n   139\t         (fn []\n   140\t           (let [buf (byte-array 65536)\n   141\t                 packet (DatagramPacket. buf (alength buf))]\n   142\t             (while (not (.isClosed socket))\n   143\t               ;; three failure domains, contained separately so no\n   144\t               ;; single datagram or transient fault can kill the\n   145\t               ;; loop: the loop exits only when the socket closes\n   146\t               (when (try (.receive socket packet)\n   147\t                          true\n   148\t                          (catch Exception _\n   149\t                            ;; socket closed -> while exits; any\n   150\t                            ;; other receive fault: back off instead\n   151\t                            ;; of spinning hot. 10ms is not tuned,\n   152\t                            ;; only bounded: short enough to shrug\n   153\t                            ;; off a transient fault, long enough to\n   154\t                            ;; cap a persistent one at ~100\n   155\t                            ;; attempts/sec\n   156\t                            (when-not (.isClosed socket) (Thread/sleep 10))\n   157\t                            false))\n   158\t                 (let [msg (try (decode packet) (catch Exception _ nil))]\n   159\t                   (when (map? msg)\n   160\t                     (try (when-let [from (:from msg)]\n   161\t                            (when (not= (:id from) (:id self))\n   162\t                              (swap! table kad/observe (:id self) from)))\n   163\t                          (if (= :reply (:op msg))\n   164\t                            (when-let [p (.remove pending (:rpc msg))]\n   165\t                              (deliver p (:value msg)))\n   166\t                            (let [value (try (handle local table msg)\n   167\t                                             (catch Exception e\n   168\t                                               {:error (str (type e))}))\n   169\t                                  reply (encode {:op :reply,\n   170\t                                                 :rpc (:rpc msg),\n   171\t                                                 :from self,\n   172\t                                                 :value value})]\n   173\t                              ;; an oversized reply is dropped, not\n   174\t                              ;; torn; the requester times out and\n   175\t                              ;; treats this peer as not holding the\n   176\t                              ;; value\n   177\t                              (when (<= (alength reply) max-datagram)\n   178\t                                (.send socket\n   179\t                                       (DatagramPacket. reply\n   180\t                                                        (alength reply)\n   181\t                                                        (.getAddress packet)\n   182\t                                                        (.getPort packet))))))\n   183\t                          ;; a hostile message (e.g. malformed :from)\n   184\t                          ;; is dropped, never fatal\n   185\t                          (catch Exception _ nil)))))))))\n   186\t       (.setDaemon true)\n   187\t       (.start))))\n    46\t(defn- portable-map?\n    47\t  [x]\n    48\t  (and (every? portable-value? (keys x))\n    49\t       (every? portable-value? (vals x))))\n    50\t\n    51\t\n    52\t(defn portable-value?\n    53\t  \"True when x belongs to the v2 portable value domain.\"\n    54\t  [x]\n    55\t  (cond\n    56\t    (nil? x) true\n    57\t    (or (true? x) (false? x) (string? x) (keyword? x) (symbol? x)) true\n    58\t    ;; The ClojureDart decoder represents out-of-domain Transit tags as\n    59\t    ;; records. Reject those before the recursive map case admits them.\n    60\t    #?(:cljd (or (transit/tagged-value? x)\n    61\t                 (transit/uuid? x)\n    62\t                 (transit/uri? x)\n    63\t                 (transit/bigint? x)\n    64\t                 (transit/bigdec? x)\n    65\t                 (transit/quoted? x)\n    66\t                 (transit/link? x))\n    67\t       :default false) false\n    68\t    (number? x) (safe-number? x)\n    69\t    (map? x) (portable-map? x)\n    70\t    (vector? x) (every? portable-value? x)\n    71\t    (list? x) (every? portable-value? x)\n    72\t    (set? x) (every? portable-value? x)\n    73\t    :else false))\n    93\t(defn- ensure-portable!\n    94\t  [x]\n    95\t  (when-let [error (validate-portable x)]\n    96\t    (throw (ex-info \"value is outside the DaoStream v2 portable domain\" error)))\n    97\t  x)\n    98\t\n    99\t\n   100\t(defn encode\n   101\t  \"Encode one portable value as Transit JSON text.\"\n   102\t  [value]\n   103\t  (ensure-portable! value)\n   104\t  #?(:cljd (transit/encode value)\n   105\t     :clj (let [out (java.io.ByteArrayOutputStream.)]\n   106\t            (transit/write (transit/writer out :json) value)\n   107\t            (.toString out \"UTF-8\"))\n   108\t     :cljs (transit/write (transit/writer :json) value)\n   109\t     :default (throw (ex-info \"no DaoStream v2 Transit implementation\" {}))))\n   110\t\n   111\t\n   112\t(defn decode\n   113\t  \"Decode Transit JSON text and reject values outside the portable domain.\"\n   114\t  [text]\n   115\t  (let [value\n   116\t        #?(:cljd (transit/decode text)\n   117\t           :clj (let [in (java.io.ByteArrayInputStream. (.getBytes text \"UTF-8\"))]\n   118\t                  (transit/read (transit/reader in :json)))\n   119\t           :cljs (transit/read (transit/reader :json) text)\n   120\t           :default (throw (ex-info \"no DaoStream v2 Transit implementation\" {})))]\n   121\t    (ensure-portable! value)))\ndeps.edn:3:        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\ndeps.edn:47:                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\ndeps.edn:52:                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\ndeps.edn:73:                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\ndeps.edn:80:                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n/Users/sto/.m2/repository/com/cognitect/transit-clj/0.8.275/transit-clj-0.8.275.pom\n/Users/sto/.m2/repository/com/cognitect/transit-java/1.0.371/transit-java-1.0.371.pom\n/Users/sto/.m2/repository/com/cognitect/transit-java/1.0.371/transit-java-1.0.371.jar\n/Users/sto/.m2/repository/com/cognitect/transit-clj/1.0.333/transit-clj-1.0.333.jar\n/Users/sto/.m2/repository/com/cognitect/transit-clj/1.0.333/transit-clj-1.0.333.pom\n/Users/sto/.m2/repository/com/cognitect/transit-java/1.0.343/transit-java-1.0.343.jar\n/Users/sto/.m2/repository/com/cognitect/transit-java/1.0.343/transit-java-1.0.343.pom\n/Users/sto/.m2/repository/com/cognitect/transit-java/1.0.362/transit-java-1.0.362.pom\n/Users/sto/.m2/repository/com/cognitect/transit-cljs/0.8.220/transit-cljs-0.8.220.pom\n/Users/sto/.m2/repository/com/cognitect/transit-cljs/0.8.256/transit-cljs-0.8.256.jar\n/Users/sto/.m2/repository/com/cognitect/transit-cljs/0.8.256/transit-cljs-0.8.256.pom\n/Users/sto/.m2/r