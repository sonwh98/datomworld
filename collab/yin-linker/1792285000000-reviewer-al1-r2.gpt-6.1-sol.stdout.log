    26	  #{:require :require-macros :use})
    27	
    28	
    29	(defn- repl-ns?
    30	  [x]
    31	  (and (symbol? x)
    32	       (let [s (str x)]
    33	         (or (= "yin.repl" s) (.startsWith s "yin.repl.")))))
    34	
    35	
    36	(defn- symbols-in
    37	  [form]
    38	  (cond
    39	    (reader-conditional? form) (symbols-in (:form form))
    40	    (symbol? form) [form]
    41	    (coll? form) (mapcat symbols-in form)
    42	    :else nil))
    43	
    44	
    45	(defn- clauses
    46	  "The `ns` body elements with every reader conditional opened: each
    47	   branch of a `#?` is one element, each branch of a `#?@` a sequence
    48	   of elements, recursively, whatever the host."
    49	  [body]
    50	  (mapcat (fn [x]
    51	            (if (reader-conditional? x)
    52	              (let [branches (take-nth 2 (rest (:form x)))]
    53	                (clauses (if (:splicing? x) (apply concat branches) branches)))
    54	              [x]))
    55	          body))
    56	
    57	
    58	(defn repl-requires
    59	  "The `yin.repl` namespaces the `ns` form of `text` requires, as a
    60	   sorted vector; `[:unreadable message]` when its first form cannot be
    61	   read; `[:no-ns-form]` when its first form is not an `ns` form, which
    62	   includes an empty file (every source file under `roots` is a
    63	   namespace)."
    64	  [text]
    65	  (try
    66	    (binding [reader/*default-data-reader-fn* (fn [_ v] v)
    67	              *ns* (create-ns 'yin.vm.linker.layering-reader)]
    68	      (let [eof (Object.)
    69	            form (reader/read {:read-cond :preserve, :eof eof}
    70	                              (rt/indexing-push-back-reader text))]
    71	        (if (and (seq? form) (= 'ns (first form)))
    72	          (->> (clauses (rest form))
    73	               (filter #(and (seq? %) (contains? require-clauses (first %))))
    74	               (mapcat symbols-in)
    75	               (filter repl-ns?)
    76	               distinct
    77	               sort
    78	               vec)
    79	          [:no-ns-form])))
    80	    (catch Exception e
    81	      [:unreadable (ex-message e)])))
    82	
    83	
    84	(defn- source-files
    85	  ([] (mapcat source-files roots))
