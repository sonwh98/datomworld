    88	        (filter #(.isFile ^java.io.File %))
    89	        (map #(.getPath ^java.io.File %))
    90	        (filter #(re-find #"\.clj[csd]?$" %))
    91	        sort)))
    92	
    93	
    94	(defn violations
    95	  "file -> the `yin.repl` namespaces it requires, for every file under
    96	   `roots` that requires one."
    97	  []
    98	  (into (sorted-map)
    99	        (keep (fn [path]
   100	                (let [found (repl-requires (slurp path))]
   101	                  (when (seq found) [path found]))))
   102	        (source-files)))
