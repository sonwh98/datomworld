   492	(defn- mint-link-id
   493	  "The next link id `[origin counter]` of this task (section 7.2, step 3):
   494	   the task's origin tag beside its own engine counter."
   495	  [state]
   496	  (let [counter (or (:id-counter state) 0)]
   497	    [[(or (:origin state) :t0) counter]
   498	     (assoc state :id-counter (inc counter))]))
   499	
   500	
   501	(defn append-link-request
   502	  "Append `entry`'s retained envelope on the link request stream. `ok`
   503	   moves the entry to the `:link-response` state; `full` keeps it in
   504	   `:link-request`, envelope verbatim, for the next poll; the terminal
   505	   outcomes throw, naming the outcome and the link id. Under a custody
   506	   gate (`gate`, the machine's `yin.vm/gate-mode`) nothing is appended:
   507	   the entry is returned as `full` would leave it."
   508	  ([resources entry] (append-link-request resources entry nil))
   509	  ([resources entry gate]
   510	   (if (some? gate)
   511	     entry
   512	     (let [writer (get resources link-request-resource)
   513	           o (:dao.stream/outcome (stream/append! writer (:envelope entry)))]
   514	       (case o
   515	         :dao.stream/ok (-> entry
   516	                            (dissoc :envelope)
   517	                            (assoc :reason :link-response))
   518	         :dao.stream/full entry
   519	         (throw (ex-info "Link request could not be appended"
   520	                         {:outcome o, :link-id (:link-id entry)})))))))
   521	
   522	
   523	(defn require-handler
   524	  "Resolve `:module/require` (yin.vm.linker.md sections 7.2 and 8.3).
   525	
   526	   A module already in the registry value -- a host module, or one linked
   527	   earlier and lowered into this task -- answers now. A module installing
   528	   in this scheduler (section 7.3) is neither linked nor absent: the
   529	   requiring continuation joins that install's waiters as an `:install`
   530	   entry. Anything else is a miss, and a miss never throws for absence:
   531	   it mints a `:dao.stream/newest` cursor on the link response stream,
   532	   THEN builds the `:link-request` wait entry -- cursor before append, so
   533	   a response that lands before the entry is first polled is not skipped
   534	   -- and appends the envelope under the link id `[origin counter]`. On
   535	   `ok` the entry waits in `:link-response`; on `full` it stays in
   536	   `:link-request` and the poll retries it. Under a custody gate the mint
   537	   and the append are the driver's: the entry is built without `:cursor`
   538	   and parks in `:link-request` with nothing sent. The entry is the kernel's
   539	   registers plus the link fields: resource ids and plain data, never a
   540	   handle.
   541	
   542	   A module already on this task's install ancestry is `:require-cycle`
   543	   naming the chain (section 7.4): the child that asked is refused. A VM
   544	   composed without a link pair cannot link, so its miss fails as v1's
   545	   did, naming the modules it has."
   546	  [state effect {:keys [park-entry-fns]}]
   547	  (let [module-name (:module effect)
   548	        build (get park-entry-fns :module/require)
   549	        registers #(if build (build state effect nil) {})
   550	        resources (:resources state)
   551	        response (get resources link-response-resource)]
   552	    (cond
   553	      (some? (resolve-module (:modules state) module-name))
   554	      {:value module-name, :state state, :blocked? false}
   555	
   556	      (some #{module-name} (:ancestry state))
   557	      (throw (ex-info "Require cycle"
   558	                      {:reason :require-cycle,
   559	                       :module module-name,
   560	                       :chain (conj (vec (:ancestry state)) module-name)}))
   561	
   562	      (installing? state module-name)
   563	      (block-on state (assoc (registers) :reason :install :name module-name))
   564	
   565	      (not (and response (get resources link-request-resource)))
   566	      (throw (ex-info "Module is not in this VM's registry"
   567	                      {:module module-name,
   568	                       :available (vec (list-modules (:modules state)))}))
   569	
   570	      :else
   571	      (let [gate (vm/gate-mode state)
   572	            minted (when (nil? gate)
   573	                     (stream/cursor response stream/anchor-newest))
   574	            _ (when (and (nil? gate)
   575	                         (not= :dao.stream/ok (:dao.stream/outcome minted)))
   576	                (throw (ex-info "Link response cursor mint failed"
   577	                                {:outcome (:dao.stream/outcome minted),
   578	                                 :module module-name})))
   579	            [link-id state] (mint-link-id state)
   580	            {:keys [format contract]} (link-format state)
   581	            entry (assoc (registers)
   582	                         :reason :link-request
   583	                         :name module-name
   584	                         :link-id link-id
   585	                         :envelope {:yin.link/id link-id,
   586	                                    :yin.link/name module-name,
   587	                                    :yin.link/format format,
   588	                                    :yin.link/contract contract}
   589	                         :request link-request-resource
   590	                         :response link-response-resource)
   591	            entry (cond-> entry
   592	                    minted (assoc :cursor (:dao.stream/cursor minted)))]
   593	        (block-on state (append-link-request resources entry gate))))))
   594	
   595	
   596	(defn default-registry
   597	  "A registry with the built-in effect handlers and no modules."
   598	  []
   599	  (-> (empty-registry)
   600	      (register-effect-handler :module/require require-handler)))

