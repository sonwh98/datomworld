   302	(defn dependency-bindings
   303	  "One entry per requirement of the loaded closure of `manifest-address`,
   304	   in walk order: whether the dependency's name resolves, in the reader's
   305	   own name environment, to the address its publisher pinned.  `:binding`
   306	   is `:ok`, `:absent` (with the fold's `:diagnostics` for that name),
   307	   `:ambiguous` (`:addresses`, `:asserters`) or `:mismatch` (`:resolved`,
   308	   `:asserters`).  Refused `:yin.link.dht/not-loaded` unless the closure
   309	   is `:loaded`."
   310	  [node authority manifest-address]
   311	  (if-some [w (loaded-closure node manifest-address)]
   312	    (let [folded (fold node authority)]
   313	      (mapv (fn [{:keys [module name manifest]}]
   314	              (let [entry (get-in folded [:env :names name])
   315	                    base {:module module :name name :pinned manifest}
   316	                    asserters (get-in entry [:yin.link/provenance
   317	                                             :yin.module/asserted-by])]
   318	                (cond
   319	                  (= :ambiguous-name (:reason entry))
   320	                  (assoc base :binding :ambiguous
   321	                         :addresses (:addresses entry)
   322	                         :asserters (:asserters entry))
   323	
   324	                  (not= :ok (:status entry))
   325	                  (assoc base :binding :absent
   326	                         :diagnostics (diagnostics-for folded name))
   327	
   328	                  (= manifest (:address entry))
   329	                  (assoc base :binding :ok)
   330	
   331	                  :else
   332	                  (assoc base :binding :mismatch
