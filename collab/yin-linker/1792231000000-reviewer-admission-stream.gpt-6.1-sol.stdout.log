   480	(defn- block-on
   481	  "The handler outcome that parks the continuation as `entry`."
   482	  [state entry]
   483	  {:state (-> state
   484	              (update :wait-set (fnil conj []) entry)
   485	              (assoc :value :yin/blocked
   486	                     :blocked? true
   487	                     :halted? false)),
   488	   :value :yin/blocked,
   489	   :blocked? true})
