  1275	(defn- drive-links
  1276	  "Serve the linker interpreter and run the parked VM alternately, at most
  1277	   `link-round-budget` rounds, while `vm` waits on a link.  A round that
  1278	   moves nothing ends the drive: a link whose content source cannot
  1279	   answer will not answer by waiting longer.  Returns
  1280	   `[state vm pending progress?]`, `pending` the links the interpreter
  1281	   reported `:pending`, and `progress?` true when a round moved
  1282	   something -- advanced a serve cursor, delivered a response or
  1283	   completed an install -- the fact the pending run's `:checks` resets
  1284	   on (yin.repl.link-policy.md section 3.1).  A refused or lost link
  1285	   raises as the VM's own, carrying the interrupted VM's minted
  1286	   identity.
  1287	
  1288	   A VM waiting on a `dao.space.query/q` call is driven the same way: the
  1289	   query interpreter (`yin.repl.query/serve`) answers from the session's
  1290	   indexer and the VM runs on.  Only a round the VM spends waiting on a
  1291	   link counts against `link-round-budget`; a query is answered in the
  1292	   round it is asked, so its rounds are bounded by `query-drive-budget`
  1293	   calls instead: a VM still waiting on a call once the drive has
  1294	   answered that many raises `query-call-limit-text` as its own error,
  1295	   the unanswered request abandoned with it."
  1296	  [state vm]
  1297	  (loop [i 0
  1298	         calls 0
  1299	         vm vm
  1300	         state state
  1301	         pending []
  1302	         progress? false]
  1303	    (let [link? (link-waiting? vm)
  1304	          query? (query/waiting? vm)]
  1305	      (cond
  1306	        (or (vm/halted? vm) (not (or link? query?)) (>= i link-round-budget))
  1307	        [state vm pending progress?]
  1308	
  1309	        (and query? (>= calls query-drive-budget))
  1310	        (throw (link-raise (ex-info query-call-limit-text
  1311	                                    {:reason :yin.repl.query/call-limit
  1312	                                     :limit query-drive-budget})
  1313	                           vm
  1314	                           (update state :query-pair query/abandon-requests)))
  1315	
  1316	        :else
  1317	        (let [served (when link?
  1318	                       (link/serve {:pair (:link-pair state)
  1319	                                    :source (:link-source state)
  1320	                                    :dht (:dht state)}))
  1321	              state (cond-> state
  1322	                      served (assoc :link-pair (:pair served)
  1323	                                    :dht (:dht served)))
  1324	              answered (when query?
  1325	                         (query/serve {:pair (:query-pair state)
  1326	                                       :indexer (:indexer state)
  1327	                                       :ast-indexer (:ast-indexer state)
  1328	                                       :dht (:dht state)
  1329	                                       :link (link-context state vm)
  1330	                                       :limits {:row-limit query-row-limit
  1331	                                                :byte-limit query-byte-limit}
  1332	                                       :budget (min query-serve-budget
  1333	                                                    (- query-drive-budget
  1334	                                                       calls))}))
  1335	              state (cond-> state
  1336	                      answered (assoc :query-pair (:pair answered)
  1337	                                      :dht (:dht answered)
  1338	                                      :indexer (:indexer answered)))
  1339	              pending (if (seq (:pending served)) (:pending served) pending)]
  1340	          (if (or (:progress? served) (:progress? answered))
  1341	            (let [vm' (try (vm/run vm)
  1342	                           (catch #?(:cljd Object :clj Exception :cljs js/Error)
  1343	                                  error
  1344	                             (throw (link-raise error vm state))))]
  1345	              (recur (if link? (inc i) i)
  1346	                     (+ calls (:answered answered 0))
  1347	                     vm'
