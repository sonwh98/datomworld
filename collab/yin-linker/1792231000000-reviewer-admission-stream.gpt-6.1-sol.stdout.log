   226	(defn- name-entry
   227	  "The outcome for one name: :absent for zero remaining assertions, a
   228	   successful resolution with provenance for exactly one distinct
   229	   manifest address, :ambiguous-name naming every remaining address
   230	   and asserter for more than one. Entries are ordered by address, so
   231	   the outcome never depends on carrier order, recency, or sequence."
   232	  [decls snapshot cands]
   233	  (let [entries (sort-by (fn [e] (str (:address e) " " (:asserter e)))
   234	                         (distinct
   235	                           (map (fn [cand]
   236	                                  {:address (get (:env cand)
   237	                                                 :yin.module/manifest)
   238	                                   :asserter (:principal cand)})
   239	                                cands)))
   240	        addresses (distinct (map :address entries))
   241	        asserters (distinct (map :asserter entries))]
   242	    (case (count addresses)
   243	      0 {:status :refused :reason :absent}
   244	      1 {:status :ok
   245	         :address (first addresses)
   246	         :yin.link/provenance
   247	         {:yin.module/asserted-by (vec asserters)
   248	          :yin.link/proof-kind
   249	          (vec (distinct (map (fn [p] (get (get decls p) :proof))
   250	                              asserters)))
   251	          :yin.link/snapshot snapshot}}
   252	      {:status :refused
   253	       :reason :ambiguous-name
   254	       :addresses (vec addresses)
   255	       :asserters (vec asserters)})))
