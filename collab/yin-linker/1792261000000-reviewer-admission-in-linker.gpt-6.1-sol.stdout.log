;; =============================================================================
;; `require` lowers to the linker (yin.vm.linker.md section 7)
;; =============================================================================

(defprotocol IModuleKernel
  "What a kernel supplies the install child and the `linked` transition
   (yin.vm.linker.md section 7.3). Every method is a pure function of a
   VM value; the engine owns the phases, the kernel owns its coordinates."

  (link-format
    [vm]
    "`{:format kw :contract s}`: the format this kernel links, and the
     execution contract it runs.")

  (spawn-module
    [vm image opts]
    "A fresh VM of this backend with the verified `image` loaded by the
     ordinary loader, holding nothing of `vm`'s state but its composition
     values (primitives, stream constructor, link pair). `opts` carries
     `:modules` (the child's module view), `:origin`, and `:ancestry`.")

  (image-identity
    [vm image]
    "The identity this kernel's code space names `image` by: H, R, the
     vector's address, or the tree's root row id.")

  (image-holds?
    [vm image segment]
    "True when a closure marker's `:yin.k/segment` falls in `image`.")

  (attach-module
    [vm image]
    "`vm` with `image` attached by the kernel's `attach-image` under its
     own contract; an image already held is not attached twice.")

(defn ask
  "Append the question for link `request` over the resolved `entry` of
   its name, bound to that resolution: the manifest address, every
   asserter, and the entry's provenance verbatim, with the request's own
   format and contract.  Answers `{:admission a :id id}` with the
   question retained under its link id and the serial advanced, or
   `{:admission admission}` unchanged when the medium refused it."
  [admission request entry]
  (let [link-id (:yin.link/id request)
        id [link-id (:serial admission)]
        provenance (:yin.link/provenance entry)
        question {:yin.admit/id id
                  :yin.link/id link-id
                  :yin.admit/name (:yin.link/name request)
                  :yin.admit/address (:address entry)
                  :yin.admit/asserters (vec (:yin.module/asserted-by
                                              provenance))
                  :yin.admit/provenance provenance
                  :yin.link/format (:yin.link/format request)
                  :yin.link/contract (:yin.link/contract request)}]
    (if (ok? (stream/append! (get-in admission [:pair :questions]) question))
      {:admission (-> admission
                      (assoc-in [:asked link-id] question)
                      (update :serial inc))
       :id id}
      {:admission admission})))

(defn recheck-on-answers
  "The host ticker's re-check of a pending run parked on an admission
   question (yin.vm.linker.dht.md 7.5 and 8.2), beside
   `recheck-on-load-events`: serve the in-process admission interpreter
   when the session runs one, drain at most `serve-budget` answers off
   the answer medium, and keep the successor state whatever matched --
   irrelevant answers are consumed and gone.  `recheck-pending` runs
   once if and only if a retained answer's admission id is the
   `:admission` of a pending link; otherwise the answer is `[state'
   nil]`, with no re-check and no `:checks`.  With nothing pending it
   still drains.  No clock: the host decides when to call it."
  [state]
  (if-let [adm (:admission state)]
    (let [admitted (serve-admission state)
          state (cond-> state
                  admitted (assoc :admitter (:interpreter admitted)))
          adm (admission/drain adm link/serve-budget)
          state (assoc state :admission adm)
          waiting (set (keep :admission
                             (get-in state [:pending-run :links])))]
      (if (some #(contains? waiting %) (keys (:answers adm)))
        (recheck-pending state)
        [state nil]))
    [state nil]))


(defn- resume-pending
  "One bounded re-check of the shell's `:pending-run` behind a typed
   line: while the run stays pending the line is retained -- the parked
   VM owns the store a new evaluation would fork -- and it evaluates,
   in typing order and exactly once, when the link completes."
