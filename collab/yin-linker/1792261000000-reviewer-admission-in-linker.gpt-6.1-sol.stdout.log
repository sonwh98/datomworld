(defn- drive-links
  "Serve the linker interpreter and run the parked VM alternately, at most
   `link-round-budget` rounds, while `vm` waits on a link.  A round that
   moves nothing ends the drive: a link whose content source cannot
   answer will not answer by waiting longer.  Returns
   `[state vm pending progress?]`, `pending` the links the interpreter
   reported `:pending`, and `progress?` true when a round moved
   something -- advanced a serve cursor, delivered a response or
   completed an install -- the fact the pending run's `:checks` resets
   on (yin.repl.link-policy.md section 3.1).  A refused or lost link
   raises as the VM's own, carrying the interrupted VM's minted
   identity.

   The admission interpreter serves right after the linker interpreter
   (yin.vm.linker.dht.md 7.5): a question appended and a question
   answered are each progress, so a require asked about and answered in
   process completes within the drive, two rounds later.

   A VM waiting on a `dao.space.query/q` call is driven the same way: the
   query interpreter (`yin.repl.query/serve`) answers from the session's
   indexer and the VM runs on.  Only a round the VM spends waiting on a
   link counts against `link-round-budget`; a query is answered in the
   round it is asked, so its rounds are bounded by `query-drive-budget`
   calls instead: a VM still waiting on a call once the drive has
   answered that many raises `query-call-limit-text` as its own error,
   the unanswered request abandoned with it."
  [state vm]
  (loop [i 0
         calls 0
         vm vm
         state state
         pending []
         progress? false]
    (let [link? (link-waiting? vm)
          query? (query/waiting? vm)]
      (cond
        (or (vm/halted? vm) (not (or link? query?)) (>= i link-round-budget))
        [state vm pending progress?]

        (and query? (>= calls query-drive-budget))
        (throw (link-raise (ex-info query-call-limit-text
                                    {:reason :yin.repl.query/call-limit
                                     :limit query-drive-budget})
                           vm
                           (update state :query-pair query/abandon-requests)))

        :else
        (let [served (when link?
                       (link/serve {:pair (:link-pair state)
                                    :source (:link-source state)
                                    :dht (:dht state)
                                    :admission (:admission state)}))
              state (cond-> state
                      served (assoc :link-pair (:pair served)
                                    :dht (:dht served)
                                    :admission (:admission served)))
              admitted (when link? (serve-admission state))
              state (cond-> state
                      admitted (assoc :admitter (:interpreter admitted)))
              answered (when query?
                         (query/serve {:pair (:query-pair state)
                                       :indexer (:indexer state)
                                       :ast-indexer (:ast-indexer state)
                                       :dht (:dht state)
                                       :link (link-context state vm)
                                       :limits {:row-limit query-row-limit
                                                :byte-limit query-byte-limit}
                                       :budget (min query-serve-budget
                                                    (- query-drive-budget
                                                       calls))}))
              state (cond-> state
                      answered (assoc :query-pair (:pair answered)
                                      :dht (:dht answered)
                                      :indexer (:indexer answered)))
              pending (if (seq (:pending served)) (:pending served) pending)]
          (if (or (:progress? served)
                  (:progress? admitted)
                  (:progress? answered))
            (let [vm' (try (vm/run vm)
                           (catch #?(:cljd Object :clj Exception :cljs js/Error)
                                  error
                             (throw (link-raise error vm state))))]
              (recur (if link? (inc i) i)
                     (+ calls (:answered answered 0))
                     vm'
                     state
                     pending
                     true))
            [state vm pending progress?]))))))

   the link policy when the re-check leaves the run pending, `:checks`
   counting this pending run's re-checks that made no progress and
   resetting on one that did, or, when the re-check raised the link's
   refusal, return the shell to the round's base with the error as text
   and evaluate `input` there.  `input` is nil for the host's
   `recheck-pending`, which evaluates no line of its own."
  [state input]
  (let [parked (:pending-run state)]
    (try
      (let [[state' vm' pending progress?] (drive-links state (:vm parked))]
        (if (vm/halted? vm')
          (let [vm'' (engine/restore-initial-env (:env (:base parked)) vm')
                [st text] (finalize-eval state
                                         (cond-> (assoc state' :vm vm'')
                                           (:frontend parked)
                                           (assoc ::frontend
                                                  (:frontend parked)))
                                         (tokenize state' vm''))]
            (fold-queued [(assoc st :vm vm'' :pending-run nil) text]
                         (cond-> (vec (:pending-lines parked))
                           input (conj input))))
          (let [checks (if progress? 0 (inc (or (:checks parked) 0)))
                parked' (cond-> (assoc parked
                                       :vm vm'
                                       :links pending
                                       :checks checks)
                          input (update :pending-lines
                                        (fnil conj []) input))
                [st text] (drain-output (assoc state'
                                               :vm vm'
                                               :pending-run parked'))]
            (consult-link-policy st text (pending-text pending)))))
      (catch #?(:cljd Object :clj Exception :cljs js/Error) error
        (let [[st text] (drain-output state)
              d (ex-data error)]
          (fold-queued
            [(carry-served (assoc st
                                  :vm (query/discard-answers
                                        (carry-link-identity
                                          (:base parked)
                                          {:id-counter (::link-counter d)
                                           :origins (::link-origins d)})
                                        (:query-pair st))
                                  :pending-run nil)
                           d)
             (str text
                  (format-error error)
                  (dropped-lines-text (count (:pending-lines parked))))]
            (cond-> [] input (conj input))))))))


(defn recheck-pending
  "One re-check of the shell's `:pending-run` without an input line --
   the step an unattended host drives at its own cadence
   (yin.repl.link-policy.md section 4): serve the interpreter, run the
   parked VM, and consult the link policy when the run is still
   pending.  A re-check that completes the run folds the retained lines
   exactly as a typed line's completion does.  Returns `[state text]`,
   `text` nil when nothing is pending.  It reads no clock and takes no
   callback; the host decides when to call it."
  [state]
  (if (:pending-run state)
    (recheck-pending* state nil)
    [state nil]))


(defn recheck-on-load-events
  "The host ticker's re-check of a pending run over a DHT link source
   (yin.vm.linker.dht.md 8.2): `recheck-pending`, once, if and only if
   `events` -- one tick's `dao.space.dht/step` events and head follower
   events -- hold a `:loaded` or `:load-failed` event for a manifest a
   pending link waits on, or an `:installed` head of a principal a
   pending link awaits (yin.vm.linker.dht.head.md 5.6, first contact).
   Any other event, and any event while nothing waits on it, answers
   `[state nil]` with `state` itself: no re-check, no `:checks`."
  [state events]
  (let [links (get-in state [:pending-run :links])
        waits (set (keep :manifest links))
        heads (set (mapcat :principals links))]
    (if (some (fn [e]
                (or (and (contains? #{:loaded :load-failed}
                                    (:dao.space.dht/event e))
                         (contains? waits (:manifest e)))
                    (and (= :installed (:yin.head/event e))
                         (contains? heads (:principal e)))))
              events)
      (recheck-pending state)
      [state nil])))


(defn recheck-on-answers
  "The host ticker's re-check of a pending run parked on an admission
   question (yin.vm.linker.dht.md 7.5 and 8.2), beside
   `recheck-on-load-events`: serve the in-process admission interpreter
   when the session runs one, drain at most `serve-budget` answers off
   the answer medium, and keep the successor state whatever matched --
   irrelevant answers are consumed and gone.  `recheck-pending` runs
   once if and only if a retained answer's admission id is the
   `:admission` of a pending link; otherwise the answer is `[state'
   nil]`, with no re-check and no `:checks`.  With nothing pending it
   still drains.  No clock: the host decides when to call it."
  [state]
  (if-let [adm (:admission state)]
    (let [admitted (serve-admission state)
          state (cond-> state
                  admitted (assoc :admitter (:interpreter admitted)))
(defn context
  "The composition-owned context `verify` receives, from the session:
   the subject, the principal of the composition's own key (nil without
   one), and the session token.  Authorization vocabulary stays here and
   in the policy; the question and the linker carry none."
  [{:keys [key session]}]
  {:yin.admit/subject (when key (sign/principal (:public key)))
   :yin.admit/session session})


(defn trusted-asserter
  "The default verify: allow when some asserter of `question` is in the
   `decision` set, else refuse `:yin.admit/untrusted-principal` naming
   the asserters."
  [decision _context question]
  (let [asserters (vec (:yin.admit/asserters question))]
    (when-not (some #(contains? decision %) asserters)
      {:yin.admit/reason :yin.admit/untrusted-principal
       :yin.admit/asserters asserters})))


(defn- composed
  "One verify of `verify`: a function, or a sequence of them composed so
   the first reason wins."
  [verify]
  (cond
    (nil? verify) trusted-asserter
    (fn? verify) verify
    :else (fn [decision context question]
            (some #(% decision context question) verify))))


(defn policy
  "The interpreter's policy from a composition's `:admission` option:
   `:own` the composition's own principals, `:trusted` an explicit set
   of principal ids (`ed25519:<hex>`), `:verify` a verify function or a
   sequence of them, and the decision snapshot: a static `:decision`, or
   the newest value of a capacity-1 `:decision-medium`, or by default
   the union of own and trusted principals."
  [{:keys [own trusted verify decision decision-medium] :as opts}]
  (let [principals (into (set own) trusted)]
    (cond-> {:own (set own)
             :trusted (set trusted)
             :verify (composed verify)}
      decision-medium (assoc :decision-medium decision-medium)
      (contains? opts :decision) (assoc :decision decision)
      (not (or decision-medium (contains? opts :decision)))
      (assoc :decision principals))))


(defn interpreter
(defn run-descriptor
  "The run an abandon retires: link ids `[origin k]` with `from <= k <
   until` of `:ids`, and every install child origin `origin.m` with
   `from <= m < until` of `:children`, with its descendants.  `base` is
   the VM the run began from, `parked` the VM it was given up as; an
   absent counter is zero.  Both counters mint the current value then
   increment, so each interval is half-open."
  [base parked]
  {:origin (or (:origin parked) :t0)
   :ids [(or (:id-counter base) 0) (or (:id-counter parked) 0)]
   :children [(or (:origins base) 0) (or (:origins parked) 0)]})


(defn- run-owned?
  "Whether link id `id` belongs to `run`: its own origin within `:ids`,
   or an install child origin within `:children` exactly, or one of its
   descendants -- matched on the child's name followed by \".\", never
   a raw prefix, so `:t0.10` is not a descendant of `:t0.1`."
  [id {:keys [origin ids children]}]
  (when (and (vector? id) (= 2 (count id)) (keyword? (first id))
             (integer? (second id)))
    (let [[o k] id
          [from until] ids
          [cfrom cuntil] children
          on (name o)]
      (or (and (= o origin) (<= from k) (< k until))
          (some (fn [m]
                  (let [child (str (name origin) "." m)]
                    (or (= on child)
                        (str/starts-with? on (str child ".")))))
                (range cfrom cuntil))))))


(defn retire
  "Retire the requests of an abandoned `run` (`run-descriptor`) still
   unread on `pair`: walking from the request cursor, each request the
   run owns is passed over with no response -- the engine has already
   retired its id, so a response would be late -- and the first request
   it does not own stops the walk, keeping request order.  Every
   admission question and answer of a retired request is dropped.
   Returns `{:pair p :admission a :retired [link-id ...]}`."
  [{:keys [pair admission]} run]
  (loop [pair pair
         retired []]
    (let [r (stream/next (:requests pair) (:cursor pair))
          id (:yin.link/id (:dao.stream/value r))]
      (if (and (= :dao.stream/ok (:dao.stream/outcome r))
               (run-owned? id run))
        (recur (assoc pair :cursor (:dao.stream/cursor r)) (conj retired id))
        {:pair pair
         :admission (some-> admission (admission/forget retired))
         :retired retired}))))

