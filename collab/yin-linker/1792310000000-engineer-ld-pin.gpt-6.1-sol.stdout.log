            retry ((:continue b) (assoc task :ready-queue []) (req 'foo))
            [done r] (drive retry (assoc r :table {'foo good, 'bar dep}))]
        (is (= 2 (count (:ready-queue task))))
        (is (= [:link-refused :link-refused]
