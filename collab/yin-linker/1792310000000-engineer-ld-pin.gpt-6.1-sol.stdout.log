                  body (if (contains? #{:matching :fresh} mode)
                         quoted-import-module
                         (def"'! '"'n (lit 7)))
                  response (module-response
                             backend 'foo body ['n]
                             {:yin.module/requires {'bar address}})
                  r (assoc-in r [:table 'foo] response)
