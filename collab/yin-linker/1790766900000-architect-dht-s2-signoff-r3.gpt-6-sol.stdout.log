tes-of? (:id m) id-length)\n   782\t                (bytes-of? (:cookie m) cookie-length)))\n   783\t      state\n   784\t\n   785\t      ;; the need-cookie reply's cookie is untrusted: it rides the one\n   786\t      ;; resend and is kept only once a full reply carries it\n   787\t      (true? (:need-cookie m))\n   788\t      (let [owner (:owner query)]\n   789\t        (cond\n   790\t          (:resent? query) state\n   791\t          (nil? (op-record state owner)) (update state :queries dissoc qkey)\n   792\t          :else\n   793\t          (let [query (assoc query :resent? true :sent (:now state))\n   794\t                outcome (send-datagram! state host port\n   795\t                                        (query-message state query\n   796\t                                                       (:cookie m)))]\n   797\t            (if (= :dao.stream/ok outcome)\n   798\t              (assoc-in state [:queries qkey] query)\n   799\t              ;; a refused resend is a failed send, as in issue\n   800\t              (-> state\n   801\t                  (update :queries dissoc qkey)\n   802\t                  (update-in (conj owner :dead) conj pkey))))))\n   803\t\n   804\t      :else\n   805\t      (-> state\n   806\t          (update :queries dissoc qkey)\n   807\t          (prove (bytes->hex (:id m)) host port)\n   808\t          (assoc-in [:cookies pkey] (:cookie m))\n   809\t          (assoc-in [:seen pkey] (:now state))\n   810\t          (route-reply query m)))))\n   811\t\n   812\t\n   813\t(defn- on-traffic\n   814\t  [state v]\n   815\t  (let [source (:dao.stream.datagram/source v)\n   880\t\n   881\t\n   882\t(defn- join-write\n   883\t  \"Create or join the one pending write for address; r (optional) waits on\n   884\t   it with its local verdict. A write already acknowledged answers r at\n   885\t   once.\"\n   886\t  [state address r verdict]\n   887\t  (let [record (or (get-in state [:writes address])\n   888\t                   (assoc (new-op