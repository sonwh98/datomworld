{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'expire|advance|orphan|starv|budget|defer' test/dao/jing/dht_test.cljc; nl -ba test/dao/jing/dht_test.cljc | sed -n '710,845p'\"","aggregated_output":"7:   unmodified content clients (dao.jing.content.step). Time advances only\n457:(deftest time-advances-only-by-appended-ticks\n462:    (is (empty? (mesh/facts c)) \"no tick observed: nothing expires\")\n718:(deftest the-advance-stage-is-bounded-by-the-budget\n719:  ;; section 2: every stage of a step is bounded by budget, the advance of\n730:      ;; every query expires at 500, so every write owes a new ping\n740:            \"at most budget operations advance per step, round robin\")))))\n759:(deftest query-expiry-is-bounded-by-the-budget\n761:  ;; advances have their queries expired in that step\n764:        expired (fn [s] (count (filter #(seq (:failures %)) (vals (:writes s)))))]\n769:      (is (= [0 5] [(expired s) (count (:queries s))]))\n774:        (is (= [2 4 5] (map expired [s1 s2 s3]))\n775:            \"each budget-2 step expires the queries of two operations\")))))\n   710\t    (is (= [\"g2\" \"g3\"] (map :jing/request (mesh/answers c)))\n   711\t        \"requests lost to the gap are never answered\")))\n   712\t\n   713\t\n   714\t;; ---------------------------------------------------------------------------\n   715\t;; Sign-off fix round 1\n   716\t;; ---------------------------------------------------------------------------\n   717\t\n   718\t(deftest the-advance-stage-is-bounded-by-the-budget\n   719\t  ;; section 2: every stage of a step is bounded by budget, the advance of\n   720\t  ;; pending work included; the pending operations are taken round robin\n   721\t  (let [net (mesh/mesh)\n   722\t        c (mesh/join! net 1 {::dht/publish? true\n   723\t                             ::dht/bootstrap [(mesh/contact 2)]})]\n   724\t    (doseq [i (range 5)]\n   725\t      (mesh/request! c (put-request (str \"w\" i) [:bounded i])))\n   726\t    (mesh/tick! c 0)\n   727\t    (let [s (dht/step (dht/state c) 16)]\n   728\t      (is (= 5 (count (:writes s))))\n   729\t      (is (= 5 (mesh/log-size net)) \"each write pinged the one contact\")\n   730\t      ;; every query expires at 500, so every write owes a new ping\n   731\t      (mesh/tick! c 500)\n   732\t      (let [counts (loop [s s\n   733\t                          acc []]\n   734\t                     (if (= 3 (count acc))\n   735\t                       acc\n   736\t                       (let [before (mesh/log-size net)\n   737\t                             s (dht/step s 2)]\n   738\t                         (recur s (conj acc (- (mesh/log-size net) before))))))]\n   739\t        (is (= [2 2 1] counts)\n   740\t            \"at most budget operations advance per step, round robin\")))))\n   741\t\n   742\t\n   743\t(defn- need-cookie-pair\n   744\t  \"Node 1 has sent its padded first ping to node 2, and node 2 has answered\n   745\t   need-cookie: returns {:net :sa :sb} with that reply waiting for node 1.\"\n   746\t  []\n   747\t  (let [net (mesh/mesh)\n   748\t        a (mesh/join! net 1 {::dht/publish? true\n   749\t                             ::dht/bootstrap [(mesh/contact 2)]})\n   750\t        b (mesh/join! net 2 {::dht/publish? true})]\n   751\t    (mesh/tick! a 0)\n   752\t    (mesh/tick! b 0)\n   753\t    (mesh/request! a (put-request \"n\" [:need-cookie]))\n   754\t    (let [sa (dht/step (dht/state a) 64)\n   755\t          sb (dht/step (dht/state b) 64)]\n   756\t      {:net net, :sa sa, :sb sb})))\n   757\t\n   758\t\n   759\t(deftest query-expiry-is-bounded-by-the-budget\n   760\t  ;; expiring a query is pending work too: only the operations a step\n   761\t  ;; advances have their queries expired in that step\n   762\t  (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   763\t                                     ::dht/bootstrap [(mesh/contact 2)]})\n   764\t        expired (fn [s] (count (filter #(seq (:failures %)) (vals (:writes s)))))]\n   765\t    (doseq [i (range 5)]\n   766\t      (mesh/request! c (put-request (str \"e\" i) [:expiry i])))\n   767\t    (mesh/tick! c 0)\n   768\t    (let [s (dht/step (dht/state c) 16)]\n   769\t      (is (= [0 5] [(expired s) (count (:queries s))]))\n   770\t      (mesh/tick! c 500)\n   771\t      (let [s1 (dht/step s 2)\n   772\t            s2 (dht/step s1 2)\n   773\t            s3 (dht/step s2 2)]\n   774\t        (is (= [2 4 5] (map expired [s1 s2 s3]))\n   775\t            \"each budget-2 step expires the queries of two operations\")))))\n   776\t\n   777\t\n   778\t(deftest a-need-cookie-cookie-is-untrusted-until-a-full-reply\n   779\t  (let [address (jing/segment-key [:need-cookie])\n   780\t        pkey [mesh/host 2]]\n   781\t    (testing \"a need-cookie reply's cookie rides the resend, and no further\"\n   782\t      (let [{:keys [sa sb]} (need-cookie-pair)\n   783\t            sa2 (dht/step sa 64)]\n   784\t        (is (not (contains? (:cookies sa2) pkey)))\n   785\t        (is (= 1 (count (:queries sa2))) \"the resend is pending\")\n   786\t        (dht/step sb 64)\n   787\t        (is (contains? (:cookies (dht/step sa2 64)) pkey)\n   788\t            \"trusted after the full reply\")))\n   789\t    (testing \"a resend the socket refuses is a failed send\"\n   790\t      (let [{:keys [net sa]} (need-cookie-pair)]\n   791\t        (swap! net assoc :refuse?\n   792\t               (fn [from to] (= [[mesh/host 1] pkey] [from to])))\n   793\t        (let [sa2 (dht/step sa 64)]\n   794\t          (is (not (contains? (:cookies sa2) pkey)))\n   795\t          (is (empty? (:queries sa2)) \"not left pending\")\n   796\t          (is (contains? (get-in sa2 [:writes address :dead]) pkey)\n   797\t              \"the peer is not tried again for this write\"))))))\n   798\t\n   799\t\n   800\t(deftest an-unpublished-node-still-routes-fetches-and-caches\n   801\t  ;; owner decision 6, fetch-only: publish? false refuses inbound stores\n   802\t  ;; and serves nothing it holds, yet still routes and caches what it asks for\n   803\t  (let [net (mesh/mesh)\n   804\t        comps {1 (mesh/join! net 1 {::dht/bootstrap [(mesh/contact 2)]})\n   805\t               2 (mesh/join! net 2 {::dht/publish? true\n   806\t                                    ::dht/bootstrap [(mesh/contact 3)]})\n   807\t               3 (mesh/join! net 3 {::dht/publish? true})}\n   808\t        v {:fetch-only true}\n   809\t        address (jing/segment-key v)\n   810\t        states (start comps)]\n   811\t    (is (false? (::dht/publish? (states 1))) \"unpublished by default\")\n   812\t    (jing/materialize! (:local (comps 3)) v)\n   813\t    ;; node 2 proves node 3 by asking it for something neither holds\n   814\t    (mesh/request! (comps 2) (get-request \"warm\" [:elsewhere]))\n   815\t    (let [states (drive states comps 0 8)\n   816\t          _ (is (some (at-port? 3) (dht/routing-entries (states 2))))\n   817\t          _ (mesh/request! (comps 1) (get-request \"g\" v))\n   818\t          states (mesh/step-all states 8)]\n   819\t      (is (= {:jing/request \"g\", :jing/found? true, :jing/bytes (b64 v)}\n   820\t             (last (mesh/answers (comps 1))))\n   821\t          \"fetched on a remote miss\")\n   822\t      (is (= v (jing/get (:local (comps 1)) address nil)) \"cached in :local\")\n   823\t      (is (some (at-port? 3) (dht/routing-entries (states 1)))\n   824\t          \"the holder was reached through node 2's :find hints\")\n   825\t      (testing \"it answers :find for others\"\n   826\t        (mesh/request! (comps 2) (get-request \"via-1\" [:unknown 2]))\n   827\t        (mesh/step-all states 8)\n   828\t        (is (some #(and (= :reply (get-in % [:message :op]))\n   829\t                        (contains? (:message %) :peers))\n   830\t                  (mesh/sent-from net 1)))))))\n","exit_code":0,"status":"completed"}}
