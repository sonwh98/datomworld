2\t\n   543\t(defn- replication-done?\n   544\t  [state owner]\n   545\t  (let [sent (:sent (op-record state owner))]\n   546\t    (and (lookup-done? state owner)\n   547\t         (empty? (owner-queries state owner))\n   548\t         (or (>= (count sent) kad/k)\n   549\t             (empty? (targets state owner sent))))))\n   550\t\n   551\t\n   552\t(defn- advance-write\n   553\t  \"Section 4.3: send toward known fresh peers until ack-peers are counted,\n   554\t   look up when too few are known, acknowledge the moment the count is\n   555\t   reached, then replicate best effort; not acknowledged at ack-ticks.\"\n   556\t  [state address]\n   557\t  (let [owner [:writes address]\n   558\t        state (update-in state (conj owner :started) #(or % (:now state)))\n   559\t        {:keys [started acked?]} (op-record state owner)\n   560\t        now (:now state)\n   561\t        late? (and now started (>= (- now started) (::ack-ticks state)))]\n   562\t    (cond\n   563\t      (and late? (not acked?)) (give-up-write state owner)\n   564\t      late? (replicated state owner)\n   565\t\n   566\t      (not acked?)\n   567\t      (let [state (-> (add-cands state owner)\n   568\t                      (send-stores owner (::ack-peers state)))]\n   569\t        (if (>= (count (:sent (op-record state owner))) (::ack-peers state))\n   570\t          (acknowledge state owner)\n   571\t          (issue-lookup state owner)))\n   572\t\n   573\t      :else\n   574\t      (let [state (-> (add-cands state owner)\n   575\t                      (send-stores owner kad/k)\n   576\t                      (issue-lookup owner))]\n   577\t        (if (replication-done? state owner)\n   578\t          (replicated state owner)\n   579\t          state)))))\n   580\t\n   581\t\n   582\t;; =============================================================================\n   583\t;; Section 4.5: pending gets\n   584\t;; =============================================================================\n   585\t\n  1015\t                   (dec left))\n  1016\t\n  1017\t            :else state))))))\n  1018\t\n  1019\t\n  1020\t;; =============================================================================\n  1021\t;; Stage 4: advance pending work\n  1022\t;; =============================================================================\n  1023\t\n  1024\t(defn- expire-queries\n  1025\t  \"A query past query-ticks is a failed try: the peer's cookie is\n  1026\t   discarded (the query may have been dropped in silence), so the next try\n  1027\t   is a padded :ping; a peer out of tries is dead for that operation and\n  1028\t   leaves the table. A query sent before the first tick starts its clock\n  1029\t   at the first reading. Only owner's queries are expired: expiry is part of\n  1030\t   advancing that one operation, so it shares the step's budget.\"\n  1031\t  [state owner]\n  1032\t  (let [now (:now state)]\n  1033\t    (reduce\n  1034\t      (fn [state [qkey {:keys [sent pkey]}]]\n  1035\t        (cond\n  1036\t          (nil? sent) (assoc-in state [:queries qkey :sent] now)\n  1037\t          (< (- now sent) (::query-ticks state)) state\n  1038\t          :else\n  1039\t          (let [state (-> state\n  1040\t                          (update :queries dissoc qkey)\n  1041\t                          (update :cookies dissoc pkey)\n  1042\t                          (update-in (conj owner :failures pkey) (fnil inc 0)))]\n  1043\t            (if (>= (get-in state (conj owner :failures pkey)) (::tries state))\n  1044\t              (-> state\n  1045\t                  (update-in (conj owner :dead) conj pkey)\n  1046\t                  (update :table forget-address (first pkey) (second pkey)))\n  1047\t              state))))\n  1048\t      state\n  1049\t      (if now\n  1050\t        (filter #(= owner (:owner (val %))) (:queries state))\n  1051\t        []))))\n  1052\t\n  1053\t\n  1054\t(defn- advance\n  1055\t  \"Advance at most budget pending operations, round robin: the operations\n  1056\t   are taken in order after :advance-cursor (the last one advanced),\n  1057\t   wrapping, and the cursor moves to the last one taken. Each taken\n  1058\t   operation first expires its own queries, then advances.\"\n  1059\t  [state budget]\n  1060\t  (let [owners (vec (sort (concat (map (fn [a] [:writes a])\n  1061\t                                       (keys (:writes state)))\n  1062\t                                  (map (fn [a] [:gets a])\n  1063\t                                       (keys (:gets state))))))\n  1064\t        after (:advance-cursor state)\n  1065\t        start (or (first (keep-indexed (fn [i o]\n  1066\t                                         (when (or (nil? after)\n  1067\t                                                   (pos? (compare o after)))\n  1068\t                                           i))\n  1069\t                                       owners))\n  1070\t                  0)\n  1071\t        n (count owners)\n  1072\t        taken (mapv #(nth owners (mod (+ start %) n))\n  1073\t                    (range (min (max 0 budget) n)))]\n  1074\t    (reduce (fn [state [kind address :as owner]]\n  1075\t              (cond-> (assoc state :advance-cursor owner)\n  1076\t                (get-in state owner)\n  1077\t                (as-> s (let [s (expire-queries s owner)]\n  1078\t                          (if (= :writes kind)\n  1079\t                            (advance-write s address)\n  1080\t                            (advance-get s address))))))\n  1081\t            state\n  1082\t            taken)))\n  1083\t\n  1084\t\n  1085\t;; =============================================================================\n  1086\t;; Stage 5 and the public surface\n  1087\t;; =============================================================================\n  1088\t\n  1089\t(defn- flush-out\n  1090\t  [state]\n  1091\t  (doseq [v (:out-answers state)] (stream/append! (:answers state) v))\n  1092\t  (doseq [v (:out-facts state)] (stream/append! (:facts state) v))\n  1093\t  (assoc state :out-answers [] :out-facts []))\n  1094\t\n  1095\t\n  1145\t            :out-answers []\n  1146\t            :out-facts []})))\n  1147\t\n  1148\t\n  1149\t(defn step\n  1150\t  \"The only thing that advances the DHT, in section 2's order, each stage\n  1151\t   bounded by budget: drain ticks; read traffic; read requests; advance\n  1152\t   pending work; append answers and facts. Returns the successor state.\n  1153\t   This is an interpreter step -- it performs stream operations -- under\n  1154\t   a single-owner precondition: one caller, one state thread.\"\n  1155\t  [state budget]\n  1156\t  (-> state\n  1157\t      (drain :ticks :ticks-cursor :ticks budget on-tick)\n  1158\t      (cond-> (:traffic state)\n  1159\t        (drain :traffic :traffic-cursor :traffic budget on-traffic))\n  1160\t      (drain :requests :requests-cursor :requests budget on-request-value)\n  1161\t      (cond-> (not (solo? state)) (advance budget))\n  1162\t      flush-out))\n  1163\t\n  1164\t\n  1165\t;; =============================================================================\n   455\t  wire v1. S2 proves by test that the need-cookie reply never encodes to more\n   456\t  than 256 bytes. A request carrying a cookie carries no `:pad`. A request\n   457\t  without a cookie is only ever a padded `:ping`: a requester never sends\n   458\t  `:find`, `:store`, `:fetch` or a chunk to a peer it holds no cookie for.\n   459\t- **Recovery.** On a need-cookie reply the requester re-sends the query\n   460\t  once carrying the new cookie; that re-send does not consume a try. The\n   461\t  need-cookie reply's cookie is untrusted: it rides that one re-send, and\n   462\t  the requester stores a peer's cookie only when a full reply carries it. A\n   463\t  re-send the socket refuses is a failed send. A query\n   464\t  that times out against a peer may have been dropped in silence (an expired\n   465\t  cookie o