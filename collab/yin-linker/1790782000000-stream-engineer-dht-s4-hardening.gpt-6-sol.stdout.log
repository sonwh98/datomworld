ff:ffff:ffff:ffff:ffff:ffff:ffff\" 65535),\ntest/dao/jing/dht_test.cljc:163:        b (mesh/join! net 2 {::dht/publish? true})\ntest/dao/jing/dht_test.cljc:186:            (is (= (hex (dht/cookie-for 0 mesh/host 9)) (hex (:cookie m))))\ntest/dao/jing/dht_test.cljc:208:                                           (assoc :cookie (dht/cookie-for\ntest/dao/jing/dht_test.cljc:279:            (is (= (hex (dht/cookie-for 0 mesh/host 1))\ntest/dao/jing/dht_test.cljc:312:        a (mesh/join! net 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:340:                       2 (mesh/join! net 2 {::dht/publish? true})\ntest/dao/jing/dht_test.cljc:341:                       3 (mesh/join! net 3 {::dht/publish? true})}\ntest/dao/jing/dht_test.cljc:418:          _ (mesh/join! net 2 {::dht/publish? true})\ntest/dao/jing/dht_test.cljc:430:               (mesh/join! (mesh/mesh) 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:442:    (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true})\ntest/dao/jing/dht_test.cljc:450:    (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:462:  (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:479:        comps {1 (mesh/join! net 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:551:        comps (grid net [1 2] {::dht/publish? false})\ntest/dao/jing/dht_test.cljc:722:(deftest the-advance-stage-is-bounded-by-the-budget\ntest/dao/jing/dht_test.cljc:723:  ;; section 2: every stage of a step is bounded by budget, the advance of\ntest/dao/jing/dht_test.cljc:726:        c (mesh/join! net 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:729:      (mesh/request! c (put-request (str \"w\" i) [:bounded i])))\ntest/dao/jing/dht_test.cljc:752:        a (mesh/join! net 1 {::dht/publish? true\ntest/dao/jing/dht_test.cljc:754:        b (mesh/join! net 2 {::dht/publish? true})]\ntest/dao/jing/dht_test.cljc:763:(deftest query-expiry-is-bounded-by-the-budget\ntest/dao/jing/dht_test.cljc:766: