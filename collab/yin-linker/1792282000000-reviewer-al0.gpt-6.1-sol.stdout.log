  ([{:keys [pair source dht admission]} budget]
   (loop [pair pair
          node dht
          admission (some-> admission (admission/drain budget))
          remaining budget
          pending []
          progress? false]
     (let [done {:pair pair, :pending pending, :progress? progress?,
                 :dht node, :admission admission}]
       (if (zero? remaining)
         done
