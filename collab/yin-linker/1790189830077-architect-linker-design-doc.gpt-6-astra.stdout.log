ress)\n   229\t                  cached (jing/materialize! local value {:algorithm algo})]\n   230\t              (when-not (= address cached)\n   231\t                (throw\n   232\t                  (ex-info\n   233\t                    \"dao.jing.dht: fetched content cached under the wrong address\"\n   234\t                    {:address address, :cached cached})))\n   235\t              value)\n   236\t            not-found))))))\n   237\t\n   238\t\n   239\t(defn- make-close\n   240\t  [{:keys [net local closed-atom]}]\n   241\t  (fn []\n   242\t    (with-lock closed-atom\n   243\t      (fn []\n   244\t        (when-not @closed-atom\n   245\t          (let [err-net (try (close-net! net)\n   246\t                             nil\n   247\t                             (catch #?(:clj Throwable\n   248\t                                       :cljs :default\n   249\t                                       :cljd Object)\n   250\t                                    e\n   251\t                               e))\n   252\t                err-local (try (jing/close! local)\n   253\t                               nil\n   254\t                               (catch #?(:clj Throwable\n   255\t                                         :cljs :default\n   256\t                                         :cljd Object)\n   257\t                                      e\n   258\t                                 e))]\n   259\t            (if (or err-net err-local)\n   260\t              (throw (or err-net err-local))\n   261\t              (reset! closed-atom true))))\n   262\t        nil))))\n   263\t\n   264\t\n   265\t;; =============================================================================\n   266\t;; Handle constructor\n   267\t;; =============================================================================\n    88\t(defn content-client\n    89\t  \"Wrap an RPC client as a dao.jing content handle.\n    90\t\n    91\t   call-fn is invoked as (call-fn client op args) and close-fn as\n    92\t   (close-fn client). Close is guarded so concurrent JVM closes call the\n    93\t   underlying close-fn exactly once; if close-fn throws, the client stays\n    94\t   open for retry.\"\n    95\t  [client call-fn close-fn]\n    96\t  (when-not (ifn? call-fn)\n    97\t    (throw (ex-info \"call-fn must be a function\" {:call-fn call-fn})))\n    98\t  (when-not (ifn? close-fn)\n    99\t    (throw (ex-info \"close-fn must be a function\" {:close-fn close-fn})))\n   100\t  (let [closed-atom (atom false)\n   101\t        close-lock #?(:clj (Object.)\n   102\t                      :default nil)\n   103\t        ensure-open (fn []\n   104\t                      (when @closed-atom\n   105\t                        (throw (ex-info \"content client is closed\"\n   106\t                                        {:client client}))))]\n   107\t    {:client client,\n   108\t     :closed-atom closed-atom,\n   109\t     :put-content-fn (fn [address payload]\n   110\t                       (ensure-open)\n   111\t                       (call-fn client :jing/put-content [address payload])),\n   112\t     :get-content-fn\n   113\t     (fn [address not-found]\n   114\t       (ensure-open)\n   115\t       (let [resp (call-fn client :jing/get-content [address])]\n   116\t         (if (valid-presence-envelope? resp)\n   117\t           (if (:found? resp) (:value resp) not-found)\n   118\t           (throw\n   119\t             (ex-info\n   120\t               \"malformed RPC response: presence envelope must contain exactly :found? (boolean) and :value keys\"\n   121\t               {:operation :jing/get-content,\n   122\t                :address address,\n   123\t                :response resp}))))),\n   124\t     :close-fn (fn []\n   125\t                 (with-lock close-lock\n   126\t                   (fn []\n   127\t                     (when-not @closed-atom\n   128\t                       (close-fn client)\n   129\t                       (compare-and-set! closed-atom false true)))))}))\n   130\t\n   131\t\n   132\t;; =============================================================================\n   133\t;; The DaoStream v2 portable core (migration Phase 1)\n   134\t;; =============================================================================\n   135\t\n   136\t(def content-path\n   137\t  \"The request-target path a content endpoint serves, and the path an absent\n   138\t   URL path names.  An explicit path, including an explicit /, is kept as\n   139\t   written (D7).\"\n   140\t  \"/jing\")\n   340\t  (drain-outboxes\n   341\t    (cond-> (update state :outstanding dissoc id)\n   342\t      (= id (get-in state [:unsent :id])) (rpc/abandon-unsent reason))))\n   343\t\n   344\t\n   345\t(defn completion-value\n   346\t  \"Interpret one completion. An ok response yields its value; an error\n   347\t   response throws {:operation op :error {code message}}; a completion that\n   348\t   carries a :reason instead of a response is a lost call and throws\n   349\t   {:operation op :reason r} (N9).\"\n   350\t  [completion]\n   351\t  (let [op (:dao.stream.rpc/op completion)\n   352\t        response (:dao.stream.rpc/response completion)]\n   353\t    (if (some? response)\n   354\t      (if-let [error (apply/response-error response)]\n   355\t        (throw (ex-info \"remote error response\"\n   356\t                        {:operation op :error error}))\n   357\t        (apply/response-ok response))\n   358\t      (throw (ex-info \"remote completion lost\"\n   359\t                      {:operation op\n   360\t                       :reason (:dao.stream.rpc/reason completion)})))))\n   361\t\n   362\t\n   490\t   :kw operand is a scalar under `encode-scalar` (a bare symbol or\n   491\t   keyword is already inside that domain); :str and :bool are framed\n   492\t   directly; :uint, :pc, and :buffer are fixed-width 8-byte little-endian\n   493\t   integers with no tag or length prefix at all -- self-delimiting by\n   494\t   construction, since every tuple's arity is fixed by its mnemonic, so a\n   495\t   framing tag would only be redundant weight.\"\n   496\t  [kind x]\n   497\t  (case kind\n   498\t    (:data :sym :kw) (encode-scalar x)\n   499\t    ;; a non-nil :str operand is a string, i.e. exactly `encode-scalar`'s\n   500\t    ;; :string class -- routed through it rather than framed directly, so\n   501\t    ;; it gets the same well-formed-utf16? guard a :const string value\n   502\t    ;; already gets, instead of hashing an unpaired surrogate unrefused\n   503\t    :str (if (nil? x) (framed :string \"\") (encode-scalar x))\n   504\t    :bool (framed :bool (if x \"01\" \"00\"))\n   505\t    (:uint :pc :buffer) (int64-le-hex (or x 0))))\n   506\t\n   507\t\n   508\t(defn- encode-tuple\n   509\t  [t]\n   510\t  (let [kinds (tuple-kinds t)]\n   511\t    (apply str (get mnemonic-tag (mnemonic-of t))\n   512\t           (map-indexed (fn [i kind] (encode-operand kind (nth t (inc i)))) kinds))))\n   513\t\n   514\t\n   515\t(defn encode-image\n   516\t  \"The canonical positional instruction vector's own bytes (S2 item 6):\n   517\t   every pc-indexed tuple's bytes, in pc order, concatenated with no\n   518\t   outer header -- pc order and each tuple's fixed arity are the only\n   519\t   framing the whole vector needs.\"\n   520\t  [v]\n   521\t  (apply str (map encode-tuple v)))\n   522\t\n   523\t\n   524\t(def descriptor-hash\n   525\t  \"The descriptor's own content hash, under this dimension's own\n   526\t   encoder -- the same 'hash the descriptor through its own canonical\n   527\t   encoder' shape `yin.vm.debruijn/dimension-hash` uses for its\n   528\t   descriptor, computed here with this dimension's distinct encoder\n   529\t   rather than that one.\"\n   530\t  (jing/sha256 (encode-scalar descriptor)))\n   531\t\n   532\t\n   533\t(defn image-hash\n   534\t  \"The ONE function that computes H (S2 item 6): `jing/sha256` over the\n   535\t   descriptor hash (which already folds in the lowering-contract\n   536\t   version) concatenated with the canonical instruction vector's own\n   537\t   bytes -- pc-indexed tuples, refs already resolved to pcs, no header,\n   538\t   exact scalar bytes. `jing/sha256`, not `jing/sha256-bytes`: this\n   539\t   dimension's canonical encoding is hex text (`encode-image` returns a\n   540\t   string, via `framed`/`to-hex`), the same shape `jing/sha256` hashes\n   541\t   for `yin.vm.debruijn/dimension-hash`, so hashing the string directly\n   542\t   is the fit; `sha256-bytes` would apply to a raw byte buffer this\n   543\t   encoder never produces. H is the ONLY executable and sharing identity\n   544\t   this file computes: no projection fingerprint, no second identity.\"\n   545\t  [v]\n   546\t  (jing/sha256 (str descriptor-hash (encode-image v))))\n   547\t\n   548\t\n   549\t;; =============================================================================\n   550\t;; Host-boundary scalar-class support (S2 item 5)\n   222\t  (let [kinds (tuple-kinds t)]\n   223\t    (apply str\n   224\t           (debruijn-code/encode-scalar (mnemonic-of t))\n   225\t           (map-indexed\n   226\t             (fn [i _kind]\n   227\t               (debruijn-code/encode-scalar (nth t (inc i))))\n   228\t             kinds))))\n   229\t\n   230\t\n   231\t(defn encode-instructions\n   232\t  [instructions]\n   233\t  (apply str (map encode-tuple instructions)))\n   234\t\n   235\t\n   236\t(defn- encode-body\n   237\t  [{:keys [locals registers start end]}]\n   238\t  (debruijn-code/encode-scalar [locals registers start end]))\n   239\t\n   240\t\n   241\t(defn encode-register-image\n   242\t  \"The canonical register image's own bytes (design section 3): every\n   243\t   declared body's `[locals registers start end]` in body order, then\n   244\t   every pc-indexed tuple's bytes in pc order -- the two parts design\n   245\t   section 3's table names ('body ranges plus positional instructions').\"\n   246\t  [{:keys [bodies instructions]}]\n   247\t  (str (apply str (map encode-body bodies)) (encode-instructions instructions)))\n   248\t\n   249\t\n   250\t(def descriptor-hash\n   251\t  (jing/sha256 (debruijn-code/encode-scalar descriptor)))\n   252\t\n   253\t\n   254\t(defn register-hash\n   255\t  \"The ONE function that computes R (design section 3): `R = sha256\n   256\t   (register-descriptor-hash || canonical-register-vector)`. Received\n   257\t   register bytes must be hashed before decoding, as B1's wire rule\n   258\t   requires -- no receive path exists in this phase, but this function's\n   259\t   own shape (bytes in, hash out, no host-value peeking) already supports\n   260\t   that later use.\"\n   261\t  [register-image]\n   262\t  (jing/sha256 (str descriptor-hash (encode-register-image register-image))))\n   263\t\n   264\t\n   265\t;; =============================================================================\n   266\t;; body-liveness (design section 4.5)\n   267\t;; =============================================================================\n   268\t;; A standard backward dataflow, one pure function of the instruction\n   202\tnot a stream gap.\n   203\t\n   204\tThe code-image identity H is computed by one B1 function, `image-hash`, over\n   205\tthe descriptor hash, including its lowering-contract version, and the\n   206\tcanonical positional instruction vector: pc-indexed tuples, refs resolved to\n   207\tpcs, no header, and exact scalar bytes. Provenance is\n   208\ta diagnostic side table indexed by pc and is outside the hash. H is the only\n   209\texecutable and sharing identity. No projection fingerprint or second identity\n   210\tis attached to the image, request, response, verification, or cache. Any later\n   211\tcache is keyed by H.\n   212\tNo cache is specified by B0 through B5; any later cache is an explicit value\n   213\tkeyed by H. A receiver hashes the received canonical wire bytes before\n   214\tdecoding; those bytes are H's preimage. `jing/segment-key` is only the storage\n   215\taddress for the same bytes and is not H; `yin.vm.content` stores and fetches\n   216\tbytes, while verification recomputes `image-hash`. H is computed using explicit\n   217\tSHA-256 and is pinned by the VM format contract version; it is completely\n   218\tindependent of DaoJing's `default-hash-algorithm` and does not change when\n   219\tDaoJing defaults to BLAKE3.\n   220\t\n   221\t## 3. Lowering and scope\n   222\t\n   223\tLowering is two stages, both pure stream-to-stream functions:\n#!/usr/bin/env python3\n\"\"\"\nPR Reviewer Utility Script for Git-based Code Reviews.\nParses git diffs, analyzes churn and file risk categories, scans for security smells\nand debugging code, and produces structured markdown or JSON review reports.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\n\n\n@dataclass\nclass Finding:\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\n    file_path: str\n    line_number: Optional[int]\n    message: str\n    snippet: str\n\n\n@dataclass\nclass FileStat:\n    path: str\n    additions: int\n    deletions: int\n    category: str\n    risk_level: str  # High, Medium, Low\n\n\n@dataclass\nclass ReviewSummary:\n    target: str\n    total_files: int\n    total_additions: int\n    total_deletions: int\n    test_additions: int\n    source_additions: int\n    test_to_source_ratio: float\n    file_stats: List[FileStat] = field(default_factory=list)\n    findings: List[Finding] = field(default_factory=list)\n    commits: List[str] = field(default_factory=list)\n\n\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\n    \"\"\"Helper to run git commands cleanly.\"\"\"\n    cmd = [\"git\"] + args\n    try:\n        res = subprocess.run(\n            cmd,\n            cwd=cwd,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=True,\n        )\n        return res.stdout.strip()\n    except subprocess.CalledProcessError as e:\n        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n        raise RuntimeError(f\"Git execution failed: {e.stderr.strip()}\")\n\n\ndef categorize_file(file_path: str) -> Tuple[str, str]:\n    \"\"\"Categorizes file type and assigns risk level.\"\"\"\n    path_lower = file_path.lower()\n\n    # Security & Auth\n    if any(k in path_lower for k in [\"auth\", \"secret\", \"crypto\", \"token\", \"permission\", \"jwt\", \"oauth\", \"password\"]):\n        return \"Security/Auth\", \"High\"\n\n    # Database & Schema\n    if any(k in path_lower for k in [\"migration\", \"schema\", \".sql\", \"entity\", \"db/\"]):\n        return \"Database/Schema\", \"High\"\n\n    # Infrastructure & Config\n    if any(k in path_lower for k in [\"docker\", \"terraform\", \".tf\", \".env\", \"k8s\", \"helm\", \"ci/cd\", \".github/workflows\"]):\n        return \"Infra/Config\", \"High\"\n    if any(file_path.endswith(ext) for ext in [\"package.json\", \"deps.edn\", \"Cargo.toml\", \"go.mod\", \"requirements.txt\", \"pom.xml\", \"build.gradle\"]):\n        return \"Dependencies\", \"Medium\"\n\n    # API / Interfaces\n    if any(k in path_lower for k in [\"proto\", \"openapi\", \"swagger\", \"graphql\", \"router\", \"controller\", \"api/\"]):\n        return \"API/Contract\", \"Medium\"\n\n    # Tests\n    if any(k in path_lower for k in [\"test\", \"spec\", \"mock\", \"fixture\", \"e2e\"]):\n        return \"Tests\", \"Low\"\n\n    # Documentation\n    if any(file_path.endswith(ext) for ext in [\".md\", \".rst\", \".txt\", \"LICENSE\"]):\n        return \"Documentation\", \"Low\"\n\n    # Core source\n    return \"Source Code\", \"Medium\"\n\n\ndef scan_diff_content(diff_text: str) -> List[Finding]:\n    \"\"\"Scans diff text for added code smells and risks.\"\"\"\n    findings: List[Finding] = []\n\n    # Patterns to match added lines\n    patterns = [\n        # Secret leaks\n        (\n            r\"(?i)^\\+.*(api[_\\-]?key|secret[_\\-]?key|bearer\\s+[a-z0-9_\\-\\.]{20,}|private[_\\-]?key)\\s*[:=]\\s*['\\\"][A-Za-z0-9%+\\/=\\-_]{8,}['\\\"]\",\n            \"P0\",\n            \"Security\",\n            \"Possible hardcoded credential or secret detected.\",\n        ),\n        (\n            r\"^\\+.*-----BEGIN (RSA|OPENSSH|EC|PRIVATE) KEY-----\",\n            \"P0\",\n            \"Security\",\n            \"Embedded private key detected.\",\n        ),\n        # Debug code left behind\n        (\n            r\"^\\+.*\\b(console\\.log|print\\(|debugger;|binding\\.pry|import pdb; pdb\\.set_trace|println!|fmt\\.Println)\\b\",\n            \"P3\",\n            \"Debug\",\n            \"Leftover debug statement detected.\",\n        ),\n        # Dangerous functions\n        (\n            r\"^\\+.*\\b(eval\\(|exec\\(|os\\.system\\(|subprocess\\.Popen\\(.*shell\\s*=\\s*True|dangerouslySetInnerHTML)\\b\",\n            \"P1\",\n            \"Security\",\n            \"Potentially unsafe dynamic execution or shell invocation.\",\n        ),\n        # Swallowed exceptions\n        (\n            r\"^\\+.*\\b(catch\\s*\\([^\\)]*\\)\\s*\\{\\s*\\}|except:\\s*pass|rescue\\s*=>\\s*nil)\\b\",\n            \"P2\",\n            \"ErrorHandling\",\n            \"Swallowed exception without logging or handling.\",\n        ),\n        # Potential SQL Injection\n        (\n            r\"(?i)^\\+.*((select|insert|update|delete)\\s+.*%s|(select|insert|update|delete)\\s+.*\\$[a-z0-9_]+|(select|insert|update|delete)\\s+.*\\+\\s*[a-z0-9_]+)\",\n            \"P1\",\n            \"Security\",\n            \"Potential SQL string concatenation detected. Use parameterized queries.\",\n        ),\n        # TODO / FIXME additions\n        (\n            r\"(?i)^\\+.*\\b(TODO|FIXME|HACK|XXX)\\b\",\n            \"P3\",\n            \"Quality\",\n            \"Added TODO/FIXME annotation. Verify if it should be resolved before merging.\",\n        ),\n        # Hardcoded Localhost / IPs\n        (\n            r\"^\\+.*(http://localhost|http://127\\.0\\.0\\.1|127\\.0\\.0\\.1:[0-9]+)\",\n            \"P2\",\n            \"Config\",\n            \"Hardcoded localhost or loopback address found in diff.\",\n        ),\n    ]\n\n    current_file = \"\"\n    line_num = 0\n\n    for line in diff_text.splitlines():\n        if line.startswith(\"--- a/\"):\n            continue\n        if line.startswith(\"+++ b/\"):\n            current_file = line[6:]\n            continue\n        if line.startswith(\"@@ \"):\n            # Extract starting line number for b/ side\n            match = re.search(r\"\\+([0-9]+)\", line)\n            if match:\n                line_num = int(match.group(1)) - 1\n            continue\n\n        if line.startswith(\"+\") and not line.startswith(\"+++\"):\n            line_num += 1\n            for regex, severity, category, message in patterns:\n                if re.search(regex, line):\n                    findings.append(\n                        Finding(\n                            severity=severity,\n                            category=category,\n                            file_path=current_file,\n                            line_number=line_num,\n                            message=message,\n                            snippet=line[1:].strip(),\n                        )\n                    )\n        elif not line.startswith(\"-\"):\n            line_num += 1\n\n    return findings\n","exit_code":0,"status":"completed"}}
