m/udp.cljc:289:  (let [{:dao.stream.udp/keys [part parts direction bytes]} v]\nsrc/cljc/dao/stream/udp.cljc:295:         (#{:dao.stream.udp/request :dao.stream.udp/answer} direction)\nsrc/cljc/dao/stream/udp.cljc:316:(defn- absorb-fragment!\nsrc/cljc/dao/stream/udp.cljc:317:  \"Fold one well-formed fragment envelope into the port's reassembly\nsrc/cljc/dao/stream/udp.cljc:326:   a fragment disagreeing with the parts count a partial already\nsrc/cljc/dao/stream/udp.cljc:329:  (let [{:dao.stream.remote/keys [id]\nsrc/cljc/dao/stream/udp.cljc:330:         :dao.stream.udp/keys [part parts direction bytes]} frag\nsrc/cljc/dao/stream/udp.cljc:366:  (stream/append! (:traffic @port)\nsrc/cljc/dao/stream/udp.cljc:367:                  {:dao.stream.udp/attachment attachment\nsrc/cljc/dao/stream/udp.cljc:368:                   :dao.stream.udp/source {:dao.stream.udp/host host\nsrc/cljc/dao/stream/udp.cljc:369:                                           :dao.stream.udp/port src-port}\nsrc/cljc/dao/stream/udp.cljc:370:                   :dao.stream.udp/value v}))\nsrc/cljc/dao/stream/udp.cljc:373:(defn receive!\nsrc/cljc/dao/stream/udp.cljc:375:   `port`'s socket, as `bytes`. Malformed CBOR is dropped as a\nsrc/cljc/dao/stream/udp.cljc:376:   diagnostic below the mirror and the link, per dao.stream.remote.md\nsrc/cljc/dao/stream/udp.cljc:377:   2.1, and so is a fragment envelope whose own fields are malformed\nsrc/cljc/dao/stream/udp.cljc:379:   deposits at once; a fragment envelope folds into reassembly and\nsrc/cljc/dao/stream/udp.cljc:388:                                                   :cljs :default) _\nsrc/cljc/dao/stream/udp.cljc:391:      (if (fragment-envelope? v)\nsrc/cljc/dao/stream/udp.cljc:392:        (when (well-formed-fragment? v)\nsrc/cljc/dao/stream/udp.cljc:393:          (when-some [payload (absorb-fragment! port attachment v)]\nsrc/cljc/dao/stream/udp.cljc:396:                                             :cljs :default) _\nsrc/cljc/dao/stream/udp.cljc:415:                 (stream/reader? traffic)\nsrc/cljc/dao/stream/udp.cljc:417:                 (stream/reader? ring)\nsrc/cljc/dao/stream/udp.cljc:418:                 (stream/writer? ring))\nsrc/cljc/dao/stream/udp.cljc:419:    (throw (ex-info \"invalid dao.stream.udp projection composition\"\nsrc/cljc/dao/stream/udp.cljc:435:          r (stream/next (:traffic s) (:cursor s))]\nsrc/cljc/dao/stream/udp.cljc:436:      (case (:dao.stream/outcome r)\nsrc/cljc/dao/stream/udp.cljc:437:        :dao.stream/ok\nsrc/cljc/dao/stream/udp.cljc:438:        (let [event (:dao.stream/value r)]\nsrc/cljc/dao/stream/udp.cljc:439:          (swap! project assoc :cursor (:dao.stream/cursor r))\nsrc/cljc/dao/stream/udp.cljc:440:          (when (= (:attachment s) (:dao.stream.udp/attachment event))\nsrc/cljc/dao/stream/udp.cljc:441:            (stream/append! (:ring s) (:dao.stream.udp/value event)))\nsrc/cljc/dao/stream/udp.cljc:444:        :dao.stream/gap\nsrc/cljc/dao/stream/udp.cljc:445:        (do (swap! project assoc :cursor (:dao.stream/cursor r))\nsrc/cljc/dao/stream/udp.cljc:463:  stream/IDaoStreamDescriptor\nsrc/cljc/dao/stream/udp.cljc:467:    {:dao.stream/outcome :dao.stream/ok\nsrc/cljc/dao/stream/udp.cljc:468:     :dao.stream/descriptor descriptor\nsrc/cljc/dao/stream/udp.cljc:469:     :dao.stream/identity (:dao.stream/identity descriptor)})\nsrc/cljc/dao/stream/udp.cljc:472:  stream/IDaoStreamWriter\nsrc/cljc/dao/stream/udp.cljc:487:    (throw (ex-info \"dao.stream.udp attacher needs :port\" {:config config})))\nsrc/cljc/dao/stream/udp.cljc:491:      {:dao.stream/outcome :dao.stream/invalid-descriptor}\nsrc/cljc/dao/stream/udp.cljc:492:      (let [host (:dao.stream.udp/host descriptor)\nsrc/cljc/dao/stream/udp.cljc:493:            dest-port (:dao.stream.udp/port descriptor)]\nsrc/cljc/dao/stream/udp.cljc:494:        {:dao.stream/outcome :dao.stream/ok\nsrc/cljc/dao/stream/udp.cljc:495:         :dao.stream/handle (UdpHandle. port host dest-port descriptor)\nsrc/cljc/dao/stream/ud