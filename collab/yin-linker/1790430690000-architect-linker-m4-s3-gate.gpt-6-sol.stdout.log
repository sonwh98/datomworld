{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '400,1080p'\"","aggregated_output":"   400\t  [kind data]\n   401\t  (fail \"Value is not portable\"\n   402\t        (merge data {:yin.k/status :yin.k/non-portable, :yin.k/kind kind})))\n   403\t\n   404\t\n   405\t(defn- scalar?\n   406\t  [x]\n   407\t  (or (nil? x) (boolean? x) (number? x) (string? x) (keyword? x)\n   408\t      (symbol? x)))\n   409\t\n   410\t\n   411\t(def ^:private ffi-pair-keys\n   412\t  \"The FFI pair's store keys: engine resources, never part of a module\n   413\t   store snapshot, as they are never part of a UCF store slice.\"\n   414\t  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key})\n   415\t\n   416\t\n   417\t(defn- encode-primitive\n   418\t  \"A host function as UCF 7.5.2's primitive marker: its one name in\n   419\t   `vm`'s primitives, with that name's profile address.\"\n   420\t  [vm f]\n   421\t  (let [n (vm/name-of (:primitives vm)\n   422\t                      (or (:primitive-canonical-names vm) {})\n   423\t                      f)\n   424\t        profile (when (symbol? n) (vm/profile-of (:primitives vm) n))]\n   425\t    (cond\n   426\t      (nil? n) (non-portable! :unnamed-function {})\n   427\t      (not (symbol? n)) (non-portable! :ambiguous-primitive {})\n   428\t      (= :host (:yin.k/class profile))\n   429\t      (non-portable! :host-state-primitive {:yin.k/name n})\n   430\t      :else {:yin.k/tag :yin.k/primitive,\n   431\t             :yin.k/name n,\n   432\t             :yin.k/profile (:yin.k/profile profile)})))\n   433\t\n   434\t\n   435\t(defn- encoder\n   436\t  \"UCF 7.5.1's `encode` over values of `vm`, recording into `found` every\n   437\t   closure origin segment and module store the encoding reaches. A\n   438\t   closure lifts through the kernel and names the module store its body\n   439\t   resolves against: its own `:store-of`, or `own` when it has none -- a\n   440\t   closure the child's own body made. Every literal map is wrapped, so a\n   441\t   program's data can never forge a marker. A stream or cursor reference\n   442\t   cannot be authenticated before it is encoded (no reference is sealed\n   443\t   here yet), so it refuses as `:forged-resource-reference`; a\n   444\t   continuation, a host object, and an unnamed host function refuse as\n   445\t   UCF 7.5.4 kinds.\"\n   446\t  [vm own found]\n   447\t  (letfn [(encode\n   448\t            [x]\n   449\t            (cond\n   450\t              (scalar? x) x\n   451\t              (map? x)\n   452\t              (case (:type x)\n   453\t                :closure\n   454\t                (let [marker (module/lift-closure vm x encode)\n   455\t                      m (or (get marker store-of-key) own)]\n   456\t                  (swap! found (fn [acc]\n   457\t                                 (-> acc\n   458\t                                     (update :origins conj\n   459\t                                             (:yin.k/segment marker))\n   460\t                                     (update :stores conj m))))\n   461\t                  (assoc marker store-of-key m))\n   462\t                (:stream-ref :cursor-ref)\n   463\t                (non-portable! :forged-resource-reference\n   464\t                               {:yin.k/hint (:type x)})\n   465\t                (:reified-continuation :parked-continuation)\n   466\t                (non-portable! :non-canonicalizable {:yin.k/hint (:type x)})\n   467\t                {:yin.k/tag :yin.k/literal,\n   468\t                 :yin.k/entries (into []\n   469\t                                      (mapcat (fn [[k v]]\n   470\t                                                [(encode k) (encode v)]))\n   471\t                                      x)})\n   472\t              (vector? x) (mapv encode x)\n   473\t              (set? x) (into #{} (map encode) x)\n   474\t              (seq? x) (apply list (map encode x))\n   475\t              (fn? x) (encode-primitive vm x)\n   476\t              :else (non-portable! :host-object\n   477\t                                   {:yin.k/hint\n   478\t                                    #?(:cljd (str (.-runtimeType x))\n   479\t                                       :default (str (type x)))})))]\n   480\t    encode))\n   481\t\n   482\t\n   483\t(defn- decoder\n   484\t  \"UCF 7.5.1's `decode` into `vm`'s coordinates: every map is a marker, a\n   485\t   closure lowers through the kernel, and a primitive is the receiver's\n   486\t   own function under an equal profile, or `:yin.k/unsatisfied`.\"\n   487\t  [vm]\n   488\t  (letfn [(decode\n   489\t            [x]\n   490\t            (cond\n   491\t              (map? x)\n   492\t              (case (:yin.k/tag x)\n   493\t                :yin.k/literal (into {}\n   494\t                                     (map (fn [[k v]] [(decode k) (decode v)]))\n   495\t                                     (partition 2 (:yin.k/entries x)))\n   496\t                :yin.k/closure (module/lower-closure vm x decode)\n   497\t                :yin.k/primitive\n   498\t                (let [n (:yin.k/name x)\n   499\t                      entry (get (:primitives vm) n)]\n   500\t                  (if (and (some? entry)\n   501\t                           (= (:yin.k/profile x)\n   502\t                              (:yin.k/profile (vm/profile-of (:primitives vm)\n   503\t                                                             n))))\n   504\t                    (vm/primitive-function entry)\n   505\t                    (fail \"Primitive unsatisfied at the receiver\"\n   506\t                          {:yin.k/status :yin.k/unsatisfied,\n   507\t                           :yin.k/name n,\n   508\t                           :yin.k/profile (:yin.k/profile x)})))\n   509\t                (fail \"Undecodable value\"\n   510\t                      {:yin.k/status :yin.k/undecodable,\n   511\t                       :yin.k/tag (:yin.k/tag x)}))\n   512\t              (vector? x) (mapv decode x)\n   513\t              (set? x) (into #{} (map decode) x)\n   514\t              (seq? x) (apply list (map decode x))\n   515\t              :else x))]\n   516\t    decode))\n   517\t\n   518\t\n   519\t(defn- encode-store\n   520\t  [encode store]\n   521\t  (into {}\n   522\t        (keep (fn [[k v]]\n   523\t                (when-not (contains? ffi-pair-keys k)\n   524\t                  [(encode k) (encode v)])))\n   525\t        store))\n   526\t\n   527\t\n   528\t(defn- decode-store\n   529\t  [decode snapshot]\n   530\t  (into {} (map (fn [[k v]] [(decode k) (decode v)])) snapshot))\n   531\t\n   532\t\n   533\t(defn lift-slice\n   534\t  \"Act 1 of `linked` (yin.vm.linker.md section 7.3): the halted child's\n   535\t   exports and module stores in the portable encoding. `own` is the\n   536\t   module's manifest address. Returns `{:slice {sym encoded} :stores\n   537\t   {address snapshot} :origins #{segment}}`: one snapshot per module --\n   538\t   the child's own store under `own`, and every dependency store the\n   539\t   encoding reaches as it stands in the child at halt, mutations\n   540\t   included. A `:store-of` with no snapshot is `:yin.k/non-portable` of\n   541\t   kind `:missing-module-store`; any refused leaf refuses the lift.\"\n   542\t  [child own exports]\n   543\t  (let [found (atom {:origins #{}, :stores #{}})\n   544\t        encode (encoder child own found)\n   545\t        store (:store child)\n   546\t        slice (into {} (map (fn [k] [k (encode (get store k))])) exports)\n   547\t        stores (loop [stores {own (encode-store encode store)}]\n   548\t                 (let [pending (remove #(contains? stores %)\n   549\t                                       (sort-by str (:stores @found)))]\n   550\t                   (if (empty? pending)\n   551\t                     stores\n   552\t                     (recur\n   553\t                       (reduce\n   554\t                         (fn [acc m]\n   555\t                           (if-let [s (get-in child [:module-stores m])]\n   556\t                             (assoc acc m (encode-store encode s))\n   557\t                             (non-portable! :missing-module-store\n   558\t                                            {store-of-key m})))\n   559\t                         stores\n   560\t                         pending)))))]\n   561\t    {:slice slice, :stores stores, :origins (:origins @found)}))\n   562\t\n   563\t\n   564\t(defn receive-module\n   565\t  \"Acts 3 and 4 of `linked` for one receiving task (yin.vm.linker.md\n   566\t   section 7.3): attach every origin image of `entry` the kernel does not\n   567\t   yet hold, non-destructively; lower the slice against this task's own\n   568\t   coordinates into the entry's `:bindings`; and instantiate each store\n   569\t   snapshot into `:module-stores` unless the task already holds that\n   570\t   module's store -- first link wins, a live instance is never\n   571\t   overwritten. Nothing is written into the task's own `:store`.\"\n   572\t  [state module-name entry]\n   573\t  (let [attached (reduce module/attach-module state\n   574\t                         (map val (sort-by key (:images entry))))\n   575\t        decode (decoder attached)\n   576\t        bindings (into {}\n   577\t                       (map (fn [[k v]] [k (decode v)]))\n   578\t                       (:slice entry))\n   579\t        stores (reduce-kv (fn [acc m snapshot]\n   580\t                            (if (contains? acc m)\n   581\t                              acc\n   582\t                              (assoc acc m (decode-store decode snapshot))))\n   583\t                          (or (:module-stores attached) {})\n   584\t                          (:stores entry))]\n   585\t    (-> attached\n   586\t        (assoc :module-stores stores)\n   587\t        (update :modules module/assoc-module module-name\n   588\t                (assoc entry :bindings bindings)))))\n   589\t\n   590\t\n   591\t;; =============================================================================\n   592\t;; Link waits and the install child (yin.vm.linker.md sections 7.2 to 7.4)\n   593\t;; =============================================================================\n   594\t\n   595\t(def ^:private link-reasons\n   596\t  \"The wait reasons `require` adds: the two link states and the install.\"\n   597\t  #{:link-request :link-response :install})\n   598\t\n   599\t\n   600\t(defn- link-entry?\n   601\t  [entry]\n   602\t  (contains? link-reasons (:reason entry)))\n   603\t\n   604\t\n   605\t(defn- ready\n   606\t  \"A woken ready entry: the registers, resumed with `value`.\"\n   607\t  [entry value]\n   608\t  (-> entry\n   609\t      (dissoc :envelope :request :response :cursor)\n   610\t      (assoc :value value)))\n   611\t\n   612\t\n   613\t(defn- refused-entry\n   614\t  \"A woken ready entry that raises `refusal` as the effect's error at its\n   615\t   resume, the way an FFI `error` raises.\"\n   616\t  [entry refusal]\n   617\t  (assoc (ready entry nil) :status :link-refused :refusal refusal))\n   618\t\n   619\t\n   620\t(defn- retire\n   621\t  \"Record link `id` as retired: a response for it is afterwards a\n   622\t   duplicate (`:restored`) or late (`:abandoned`).\"\n   623\t  [state id how]\n   624\t  (assoc-in state [:link-retired id] how))\n   625\t\n   626\t\n   627\t(defn- skip\n   628\t  \"Record one skipped response (section 7.2, step 7): a telemetry\n   629\t   diagnostic, and one entry under `:link-diagnostics`. A response another\n   630\t   live entry of this task awaits is not a skip kind and is passed over\n   631\t   silently.\"\n   632\t  [state entry id]\n   633\t  (let [retired (get-in state [:link-retired id])\n   634\t        kind (cond (= :restored retired) :duplicate\n   635\t                   (= :abandoned retired) :late\n   636\t                   (some #(= id (:link-id %)) (:wait-set state)) nil\n   637\t                   :else :unknown)]\n   638\t    (if (nil? kind)\n   639\t      state\n   640\t      (let [d {:kind kind, :id id, :entry (:link-id entry)}]\n   641\t        (-> state\n   642\t            (update :link-diagnostics (fnil conj []) d)\n   643\t            (telemetry/emit-snapshot :link-skip d))))))\n   644\t\n   645\t\n   646\t(defn take-link-diagnostics\n   647\t  \"Every skip diagnostic recorded since the last take, and the state\n   648\t   without them: each is handed out exactly once.\"\n   649\t  [state]\n   650\t  [(vec (:link-diagnostics state)) (dissoc state :link-diagnostics)])\n   651\t\n   652\t\n   653\t(defn- obligation-name\n   654\t  [obligation]\n   655\t  (if (map? obligation) (:name obligation) obligation))\n   656\t\n   657\t\n   658\t(defn- discharge-defect\n   659\t  \"Step 5b against the live state of the receiving task (section 7.2,\n   660\t   step 7): `yin.vm.linker/discharge` over the response's obligations,\n   661\t   then profile equality for every obligation the manifest names under\n   662\t   `:yin.module/primitives` -- a same-named primitive of a different\n   663\t   profile is `:unresolved-free`. A namespaced obligation of a module the\n   664\t   manifest requires is the install's to satisfy: the child requires it,\n   665\t   and the receiving task receives it at `linked`.\"\n   666\t  [state response]\n   667\t  (let [manifest (:manifest response)\n   668\t        requires (set (keys (:yin.module/requires manifest)))\n   669\t        deferred? (fn [o]\n   670\t                    (let [n (obligation-name o)]\n   671\t                      (and (symbol? n)\n   672\t                           (some? (namespace n))\n   673\t                           (contains? requires (symbol (namespace n))))))\n   674\t        obligations (remove deferred? (:obligations response))\n   675\t        receiver {:free-env (or (:free-env state) {}),\n   676\t                  :store (:store state),\n   677\t                  :primitives (:primitives state),\n   678\t                  :modules (:modules state)}]\n   679\t    (or (linker/discharge receiver obligations)\n   680\t        (some (fn [o]\n   681\t                (let [n (obligation-name o)\n   682\t                      expected (get-in manifest [:yin.module/primitives n])\n   683\t                      actual (:yin.k/profile\n   684\t                               (or (vm/profile-of (:primitives state) n)\n   685\t                                   (get (:primitive-profiles state) n)))]\n   686\t                  (when (and (some? expected) (not= expected actual))\n   687\t                    (linker/refused :unresolved-free\n   688\t                                    {:name n,\n   689\t                                     :expected expected,\n   690\t                                     :actual actual}))))\n   691\t              obligations))))\n   692\t\n   693\t\n   694\t(defn- error-refusal\n   695\t  \"The refusal an install raises for a thrown error: the error's own\n   696\t   `:reason` when it carries one (`:require-cycle`), its non-portable\n   697\t   status when a lift refused, and `:install-error` otherwise.\"\n   698\t  [module-name e]\n   699\t  (let [d (or (ex-data e) {})]\n   700\t    (merge d\n   701\t           {:status :refused,\n   702\t            :reason (or (:reason d)\n   703\t                        (when (= :yin.k/non-portable (:yin.k/status d))\n   704\t                          :yin.k/non-portable)\n   705\t                        :install-error),\n   706\t            :module module-name,\n   707\t            :message (ex-message e)})))\n   708\t\n   709\t\n   710\t(defn- linked-entries\n   711\t  \"The `[name entry]` pairs of a registry that were linked, not\n   712\t   host-registered: they carry a manifest address.\"\n   713\t  [registry]\n   714\t  (filterv (fn [[_ entry]] (some? (:address entry)))\n   715\t           (module/module-entries registry)))\n   716\t\n   717\t\n   718\t(defn- manifest-address\n   719\t  \"The manifest's address: a manifest is content named by its address.\"\n   720\t  [response]\n   721\t  (jing/segment-key (:manifest response)))\n   722\t\n   723\t\n   724\t(defn- spawn-child\n   725\t  \"`loading` (section 7.3): a fresh child of the parent's backend over the\n   726\t   verified image, under a fresh origin tag, its install ancestry the\n   727\t   parent's plus this module, and a module view of its own: each linked\n   728\t   entry the parent holds is attached and lowered into the child's\n   729\t   coordinates here, never the parent's lowered values reused.\"\n   730\t  [state module-name response]\n   731\t  (let [n (or (:origins state) 0)\n   732\t        origin (keyword (str (name (or (:origin state) :t0)) \".\" n))\n   733\t        registry (reduce (fn [r [m entry]]\n   734\t                           (module/assoc-module r m (dissoc entry :bindings)))\n   735\t                         (:modules state)\n   736\t                         (linked-entries (:modules state)))\n   737\t        child (module/spawn-module state\n   738\t                                   (:value (:image response))\n   739\t                                   {:modules registry,\n   740\t                                    :origin origin,\n   741\t                                    :ancestry (conj (vec (:ancestry state))\n   742\t                                                    module-name)})\n   743\t        child (reduce (fn [c [m entry]] (receive-module c m entry))\n   744\t                      child\n   745\t                      (linked-entries registry))]\n   746\t    [child (assoc state :origins (inc n))]))\n   747\t\n   748\t\n   749\t(defn- wake-installed\n   750\t  \"Move every `:install` wait entry naming `module-name` to the ready\n   751\t   queue, woken with `value`, or with `refusal` raised.\"\n   752\t  [state module-name value refusal]\n   753\t  (let [waiter? (fn [e]\n   754\t                  (and (= :install (:reason e)) (= module-name (:name e))))\n   755\t        waiters (filter waiter? (:wait-set state))]\n   756\t    (-> state\n   757\t        (update :wait-set (fn [ws] (filterv (complement waiter?) ws)))\n   758\t        (update :ready-queue (fnil into [])\n   759\t                (map (fn [e]\n   760\t                       (if refusal (refused-entry e refusal) (ready e value))))\n   761\t                waiters))))\n   762\t\n   763\t\n   764\t(defn- refuse-install\n   765\t  \"`refused` (section 7.3): nothing from the child's store is published,\n   766\t   every waiter is restored with the refusal as the effect's error, and\n   767\t   the install entry is removed so a later require may try again.\"\n   768\t  [state module-name refusal]\n   769\t  (-> state\n   770\t      (update :installs dissoc module-name)\n   771\t      (wake-installed module-name nil refusal)))\n   772\t\n   773\t\n   774\t(defn- verified-images\n   775\t  \"Every image this scheduler verified that the child's slice may name as\n   776\t   an origin: the install's own, and those held by identity under the\n   777\t   registry of the child or of the receiving task (section 7.3, act 2).\"\n   778\t  [state child response]\n   779\t  (into [(:value (:image response))]\n   780\t        (mapcat (fn [[_ entry]] (vals (:images entry))))\n   781\t        (concat (linked-entries (:modules child))\n   782\t                (linked-entries (:modules state)))))\n   783\t\n   784\t\n   785\t(defn- link-install\n   786\t  \"`validated` then `linked` (section 7.3): the child reached halt; every\n   787\t   export must be a key of its store (`:export-missing`); the slice is\n   788\t   lifted (act 1) and its origins checked against the images this\n   789\t   scheduler verified (act 2, `:foreign-image`); the receiving task then\n   790\t   receives, first, the entry -- its store snapshots win over the plain\n   791\t   registry snapshot of a dependency, since the child's mutations are\n   792\t   what the slice carries -- and then every module the child linked that\n   793\t   it lacks (acts 3 and 4), and every waiter is restored with the name.\"\n   794\t  [state module-name {:keys [vm response]}]\n   795\t  (let [manifest (:manifest response)\n   796\t        address (manifest-address response)\n   797\t        exports (sort-by str (:yin.module/exports manifest))\n   798\t        missing (vec (remove #(contains? (:store vm) %) exports))]\n   799\t    (if (seq missing)\n   800\t      (refuse-install state module-name\n   801\t                      {:status :refused,\n   802\t                       :reason :export-missing,\n   803\t                       :module module-name,\n   804\t                       :names missing})\n   805\t      (let [lifted (try (lift-slice vm address exports)\n   806\t                        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   807\t                          {:refusal (error-refusal module-name e)}))]\n   808\t        (if-let [refusal (:refusal lifted)]\n   809\t          (refuse-install state module-name refusal)\n   810\t          (let [verified (verified-images state vm response)\n   811\t                origin-of (fn [seg]\n   812\t                            (some #(when (module/image-holds? vm % seg) %)\n   813\t                                  verified))\n   814\t                foreign (first (remove origin-of\n   815\t                                       (sort-by str (:origins lifted))))]\n   816\t            (if (some? foreign)\n   817\t              (refuse-install state module-name\n   818\t                              {:status :refused,\n   819\t                               :reason :foreign-image,\n   820\t                               :module module-name,\n   821\t                               :segment foreign})\n   822\t              (let [images (into {}\n   823\t                                 (map (fn [seg]\n   824\t                                        (let [img (origin-of seg)]\n   825\t                                          [(module/image-identity vm img)\n   826\t                                           img])))\n   827\t                                 (:origins lifted))\n   828\t                    entry (module/module-entry\n   829\t                            (:modules (module/link-module\n   830\t                                        nil manifest (:derivation response)\n   831\t                                        (assoc lifted :images images)))\n   832\t                            module-name)\n   833\t                    received (receive-module state module-name entry)\n   834\t                    received (reduce\n   835\t                               (fn [s [m dep]]\n   836\t                                 (if (some? (module/module-entry\n   837\t                                              (:modules (:modules s)) m))\n   838\t                                   s\n   839\t                                   (receive-module s m (dissoc dep :bindings))))\n   840\t                               received\n   841\t                               (linked-entries (:modules vm)))]\n   842\t                (-> received\n   843\t                    (update :installs dissoc module-name)\n   844\t                    (wake-installed module-name module-name nil))))))))))\n   845\t\n   846\t\n   847\t(defn- advance-install\n   848\t  \"Step the install child of `module-name` in this round, beside every\n   849\t   other task (section 7.3): `running` runs it until it halts or parks.\n   850\t   A parked child stays `parked`; a halted one goes on to `validated`; an\n   851\t   error refuses the install.\"\n   852\t  [state module-name]\n   853\t  (let [inst (get-in state [:installs module-name])\n   854\t        [child refusal]\n   855\t        (try [(vm/run (:vm inst)) nil]\n   856\t             (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   857\t               [nil (error-refusal module-name e)]))]\n   858\t    (cond\n   859\t      refusal (refuse-install state module-name refusal)\n   860\t      (:blocked? child)\n   861\t      (assoc-in state [:installs module-name]\n   862\t                (assoc inst :vm child :phase :parked))\n   863\t      (:halted? child) (link-install state module-name (assoc inst :vm child))\n   864\t      :else (assoc-in state [:installs module-name]\n   865\t                      (assoc inst :vm child :phase :running)))))\n   866\t\n   867\t\n   868\t(defn- advance-installs\n   869\t  [state]\n   870\t  (reduce advance-install state (sort-by str (keys (:installs state)))))\n   871\t\n   872\t\n   873\t(defn- start-install\n   874\t  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n   875\t   `[state refusal]`.\"\n   876\t  [state module-name response link-id]\n   877\t  (try\n   878\t    (let [[child state] (spawn-child state module-name response)]\n   879\t      [(assoc-in state [:installs module-name]\n   880\t                 {:phase :running, :vm child, :parent link-id,\n   881\t                  :response response})\n   882\t       nil])\n   883\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   884\t      [state (assoc (error-refusal module-name e) :phase :loading)])))\n   885\t\n   886\t\n   887\t(defn- settle\n   888\t  \"Act on the response correlated with `entry`: a refusal (or loss) is\n   889\t   raised as the effect's error; `:ok` runs step 5b against the live\n   890\t   state and, discharged, starts the install child, the entry becoming\n   891\t   an `:install` waiter. A module linked or installing meanwhile answers\n   892\t   or joins instead, and a manifest naming another module than the one\n   893\t   required is `:module-name-mismatch`, never installed. Returns `[state\n   894\t   waiting woken]`.\"\n   895\t  [state entry response]\n   896\t  (let [state (retire state (:link-id entry) :restored)\n   897\t        module-name (:name entry)\n   898\t        waiter (-> entry\n   899\t                   (dissoc :envelope :request :response :cursor :link-id)\n   900\t                   (assoc :reason :install))]\n   901\t    (cond\n   902\t      (not= :ok (:status response))\n   903\t      [state nil (refused-entry entry response)]\n   904\t\n   905\t      (some? (module/resolve-module (:modules state) module-name))\n   906\t      [state nil (ready entry module-name)]\n   907\t\n   908\t      (contains? (:installs state) module-name) [state waiter nil]\n   909\t\n   910\t      ;; the linker checks the name (section 8.1); a response that names\n   911\t      ;; another module is never installed under this one\n   912\t      (not= module-name (get-in response [:manifest :yin.module/name]))\n   913\t      [state nil\n   914\t       (refused-entry entry\n   915\t                      (linker/refused :module-name-mismatch\n   916\t                                      {:requested module-name,\n   917\t                                       :manifest (get-in\n   918\t                                                   response\n   919\t                                                   [:manifest\n   920\t                                                    :yin.module/name])}))]\n   921\t\n   922\t      :else\n   923\t      (if-let [refusal (discharge-defect state response)]\n   924\t        [state nil (refused-entry entry refusal)]\n   925\t        (let [[state refusal] (start-install state module-name response\n   926\t                                             (:link-id entry))]\n   927\t          (if refusal\n   928\t            [state nil (refused-entry entry refusal)]\n   929\t            [state waiter nil]))))))\n   930\t\n   931\t\n   932\t(defn- poll-link-response\n   933\t  \"Poll a `:link-response` entry's kept cursor (section 7.2, step 7):\n   934\t   advance past every response whose `:yin.link/id` is not its own,\n   935\t   keeping the cursor at the first unconsumed position, and act only on\n   936\t   exact correlation. `blocked` keeps waiting; `gap` and the terminal\n   937\t   outcomes are raised as the effect's error. Returns `[state waiting\n   938\t   woken]`.\"\n   939\t  [state entry]\n   940\t  (let [reader (get (:resources state) module/link-response-resource)]\n   941\t    (loop [state state\n   942\t           cursor (:cursor entry)]\n   943\t      (let [r (stream/next reader cursor)\n   944\t            o (outcome r)]\n   945\t        (case o\n   946\t          :dao.stream/ok\n   947\t          (let [v (:dao.stream/value r)\n   948\t                id (when (map? v) (:yin.link/id v))\n   949\t                entry (assoc entry :cursor (:dao.stream/cursor r))]\n   950\t            (if (= id (:link-id entry))\n   951\t              (settle state entry v)\n   952\t              (recur (skip state entry id) (:cursor entry))))\n   953\t          :dao.stream/blocked [state (assoc entry :cursor cursor) nil]\n   954\t          [(retire state (:link-id entry) :restored)\n   955\t           nil\n   956\t           (refused-entry entry\n   957\t                          {:status :refused,\n   958\t                           :reason :link-stream,\n   959\t                           :outcome o,\n   960\t                           :link-id (:link-id entry)})])))))\n   961\t\n   962\t\n   963\t(defn- poll-link-entry\n   964\t  \"One poll of a link wait entry: a `:link-request` retries its retained\n   965\t   envelope and, appended, polls on as a `:link-response`; an `:install`\n   966\t   waits for its install. Returns `[state waiting woken]`.\"\n   967\t  [state entry]\n   968\t  (case (:reason entry)\n   969\t    :link-request\n   970\t    (let [entry' (module/append-link-request (:resources state) entry)]\n   971\t      (if (= :link-response (:reason entry'))\n   972\t        (poll-link-response state entry')\n   973\t        [state entry' nil]))\n   974\t    :link-response (poll-link-response state entry)\n   975\t    :install [state entry nil]))\n   976\t\n   977\t\n   978\t(defn- poll-links\n   979\t  \"Poll every link wait entry once, in wait-set order, and then step the\n   980\t   install children. Returns the state with the still-waiting link\n   981\t   entries appended to `others` and the woken ones queued.\"\n   982\t  [state links others]\n   983\t  (let [[state waiting woken]\n   984\t        (reduce (fn [[state waiting woken] entry]\n   985\t                  (let [[state w k] (poll-link-entry state entry)]\n   986\t                    [state\n   987\t                     (cond-> waiting w (conj w))\n   988\t                     (cond-> woken k (conj k))]))\n   989\t                [state [] []]\n   990\t                links)]\n   991\t    (-> state\n   992\t        (assoc :wait-set (into (vec others) waiting))\n   993\t        (update :ready-queue (fnil into []) woken)\n   994\t        advance-installs)))\n   995\t\n   996\t\n   997\t(defn abandon-link\n   998\t  \"A composition gives up on link `link-id` (section 7.2, step 7): the\n   999\t   entry leaves the wait set and is restored with `reason` raised as the\n  1000\t   effect's error; the id is retired, so a response arriving later is\n  1001\t   `:late`. The linker side's `abandon` is the composition's call. An id\n  1002\t   no entry holds leaves the state unchanged.\"\n  1003\t  [state link-id reason]\n  1004\t  (let [held? (fn [e]\n  1005\t                (and (contains? #{:link-request :link-response} (:reason e))\n  1006\t                     (= link-id (:link-id e))))]\n  1007\t    (if-let [entry (first (filter held? (:wait-set state)))]\n  1008\t      (-> state\n  1009\t          (update :wait-set (fn [ws] (filterv (complement held?) ws)))\n  1010\t          (retire link-id :abandoned)\n  1011\t          (update :ready-queue (fnil conj [])\n  1012\t                  (refused-entry entry\n  1013\t                                 {:status :lost,\n  1014\t                                  :reason reason,\n  1015\t                                  :link-id link-id})))\n  1016\t      state)))\n  1017\t\n  1018\t\n  1019\t(defn check-wait-set\n  1020\t  \"Check wait-set entries against their transports.\n  1021\t\n  1022\t   The sweep is `dao.stream.waitset/check` — this engine was that library's\n  1023\t   seed and is now its first consumer. Every entry is resolved to a live\n  1024\t   handle and an opaque cursor out of the store by `waitset-resolver` and\n  1025\t   polled with a synchronous `next` or `append!` — resolution happens per\n  1026\t   poll, so the stored entry itself never carries a handle. There is no\n  1027\t   transport-local waking to fall back from: this is the only mechanism.\n  1028\t\n  1029\t   Entries are polled one at a time in wait-set order, and a woken reader's\n  1030\t   successor cursor is written back to the store before the next entry is\n  1031\t   resolved. Waiters sharing a cursor-ref therefore read distinct values —\n  1032\t   the value at the cursor wakes the first, its successor wakes the next —\n  1033\t   instead of every waiter reading the value at the shared pre-poll\n  1034\t   cursor. An entry that stays waiting is retained in its stored,\n  1035\t   resource-id form.\n  1036\t\n  1037\t   Each woken result's `:status` is stamped onto its ready entry, where\n  1038\t   `terminal-resume-outcome` reads it: an outcome the immediate operation\n  1039\t   raises as an error fails the same way when the resume pops it — and a\n  1040\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n  1041\t   there too, before any continuation is restored.\n  1042\t\n  1043\t   The link wait entries `require` adds (yin.vm.linker.md section 7.2) are\n  1044\t   polled first, by the engine rather than the stream sweep: a\n  1045\t   `:link-request` retries its envelope, a `:link-response` advances its\n  1046\t   own kept cursor to the response carrying its id, and an `:install`\n  1047\t   waits on its install child. The install children are then stepped in\n  1048\t   this same round (section 7.3), so a child that halts restores its\n  1049\t   waiters here; nothing about a child runs inside a restore.\"\n  1050\t  [state]\n  1051\t  (let [wait-set (:wait-set state)]\n  1052\t    (if (and (empty? wait-set) (empty? (:installs state)))\n  1053\t      state\n  1054\t      (let [state (poll-links state\n  1055\t                              (filterv link-entry? wait-set)\n  1056\t                              (remove link-entry? wait-set))\n  1057\t            wait-set (:wait-set state)\n  1058\t            streams (filterv (complement link-entry?) wait-set)\n  1059\t            {:keys [woken store], :as result}\n  1060\t            (waitset/check {:waiting streams} waitset-resolver (:store state))\n  1061\t            v (assoc state\n  1062\t                     :store store\n  1063\t                     :wait-set (into (:waiting (:waitset result))\n  1064\t                                     (filter link-entry?)\n  1065\t                                     wait-set))]\n  1066\t        (update v\n  1067\t                :ready-queue (fnil into [])\n  1068\t                (make-woken-run-queue-entries v woken))))))\n  1069\t\n  1070\t\n  1071\t(declare handle-effect resume-continuation)\n  1072\t\n  1073\t\n  1074\t(defn run-loop\n  1075\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n  1076\t   `resume-fn` pops and restores them.\"\n  1077\t  [state active? step-fn resume-fn]\n  1078\t  (loop [v state]\n  1079\t    (let [q (or (:ready-queue v) [])]\n  1080\t      (cond (active? v) (recur (step-fn v))\n","exit_code":0,"status":"completed"}}
