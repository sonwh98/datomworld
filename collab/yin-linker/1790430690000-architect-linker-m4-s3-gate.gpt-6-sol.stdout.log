{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '840,1080p'\"","aggregated_output":"   840\t                               received\n   841\t                               (linked-entries (:modules vm)))]\n   842\t                (-> received\n   843\t                    (update :installs dissoc module-name)\n   844\t                    (wake-installed module-name module-name nil))))))))))\n   845\t\n   846\t\n   847\t(defn- advance-install\n   848\t  \"Step the install child of `module-name` in this round, beside every\n   849\t   other task (section 7.3): `running` runs it until it halts or parks.\n   850\t   A parked child stays `parked`; a halted one goes on to `validated`; an\n   851\t   error refuses the install.\"\n   852\t  [state module-name]\n   853\t  (let [inst (get-in state [:installs module-name])\n   854\t        [child refusal]\n   855\t        (try [(vm/run (:vm inst)) nil]\n   856\t             (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   857\t               [nil (error-refusal module-name e)]))]\n   858\t    (cond\n   859\t      refusal (refuse-install state module-name refusal)\n   860\t      (:blocked? child)\n   861\t      (assoc-in state [:installs module-name]\n   862\t                (assoc inst :vm child :phase :parked))\n   863\t      (:halted? child) (link-install state module-name (assoc inst :vm child))\n   864\t      :else (assoc-in state [:installs module-name]\n   865\t                      (assoc inst :vm child :phase :running)))))\n   866\t\n   867\t\n   868\t(defn- advance-installs\n   869\t  [state]\n   870\t  (reduce advance-install state (sort-by str (keys (:installs state)))))\n   871\t\n   872\t\n   873\t(defn- start-install\n   874\t  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n   875\t   `[state refusal]`.\"\n   876\t  [state module-name response link-id]\n   877\t  (try\n   878\t    (let [[child state] (spawn-child state module-name response)]\n   879\t      [(assoc-in state [:installs module-name]\n   880\t                 {:phase :running, :vm child, :parent link-id,\n   881\t                  :response response})\n   882\t       nil])\n   883\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   884\t      [state (assoc (error-refusal module-name e) :phase :loading)])))\n   885\t\n   886\t\n   887\t(defn- settle\n   888\t  \"Act on the response correlated with `entry`: a refusal (or loss) is\n   889\t   raised as the effect's error; `:ok` runs step 5b against the live\n   890\t   state and, discharged, starts the install child, the entry becoming\n   891\t   an `:install` waiter. A module linked or installing meanwhile answers\n   892\t   or joins instead, and a manifest naming another module than the one\n   893\t   required is `:module-name-mismatch`, never installed. Returns `[state\n   894\t   waiting woken]`.\"\n   895\t  [state entry response]\n   896\t  (let [state (retire state (:link-id entry) :restored)\n   897\t        module-name (:name entry)\n   898\t        waiter (-> entry\n   899\t                   (dissoc :envelope :request :response :cursor :link-id)\n   900\t                   (assoc :reason :install))]\n   901\t    (cond\n   902\t      (not= :ok (:status response))\n   903\t      [state nil (refused-entry entry response)]\n   904\t\n   905\t      (some? (module/resolve-module (:modules state) module-name))\n   906\t      [state nil (ready entry module-name)]\n   907\t\n   908\t      (contains? (:installs state) module-name) [state waiter nil]\n   909\t\n   910\t      ;; the linker checks the name (section 8.1); a response that names\n   911\t      ;; another module is never installed under this one\n   912\t      (not= module-name (get-in response [:manifest :yin.module/name]))\n   913\t      [state nil\n   914\t       (refused-entry entry\n   915\t                      (linker/refused :module-name-mismatch\n   916\t                                      {:requested module-name,\n   917\t                                       :manifest (get-in\n   918\t                                                   response\n   919\t                                                   [:manifest\n   920\t                                                    :yin.module/name])}))]\n   921\t\n   922\t      :else\n   923\t      (if-let [refusal (discharge-defect state response)]\n   924\t        [state nil (refused-entry entry refusal)]\n   925\t        (let [[state refusal] (start-install state module-name response\n   926\t                                             (:link-id entry))]\n   927\t          (if refusal\n   928\t            [state nil (refused-entry entry refusal)]\n   929\t            [state waiter nil]))))))\n   930\t\n   931\t\n   932\t(defn- poll-link-response\n   933\t  \"Poll a `:link-response` entry's kept cursor (section 7.2, step 7):\n   934\t   advance past every response whose `:yin.link/id` is not its own,\n   935\t   keeping the cursor at the first unconsumed position, and act only on\n   936\t   exact correlation. `blocked` keeps waiting; `gap` and the terminal\n   937\t   outcomes are raised as the effect's error. Returns `[state waiting\n   938\t   woken]`.\"\n   939\t  [state entry]\n   940\t  (let [reader (get (:resources state) module/link-response-resource)]\n   941\t    (loop [state state\n   942\t           cursor (:cursor entry)]\n   943\t      (let [r (stream/next reader cursor)\n   944\t            o (outcome r)]\n   945\t        (case o\n   946\t          :dao.stream/ok\n   947\t          (let [v (:dao.stream/value r)\n   948\t                id (when (map? v) (:yin.link/id v))\n   949\t                entry (assoc entry :cursor (:dao.stream/cursor r))]\n   950\t            (if (= id (:link-id entry))\n   951\t              (settle state entry v)\n   952\t              (recur (skip state entry id) (:cursor entry))))\n   953\t          :dao.stream/blocked [state (assoc entry :cursor cursor) nil]\n   954\t          [(retire state (:link-id entry) :restored)\n   955\t           nil\n   956\t           (refused-entry entry\n   957\t                          {:status :refused,\n   958\t                           :reason :link-stream,\n   959\t                           :outcome o,\n   960\t                           :link-id (:link-id entry)})])))))\n   961\t\n   962\t\n   963\t(defn- poll-link-entry\n   964\t  \"One poll of a link wait entry: a `:link-request` retries its retained\n   965\t   envelope and, appended, polls on as a `:link-response`; an `:install`\n   966\t   waits for its install. Returns `[state waiting woken]`.\"\n   967\t  [state entry]\n   968\t  (case (:reason entry)\n   969\t    :link-request\n   970\t    (let [entry' (module/append-link-request (:resources state) entry)]\n   971\t      (if (= :link-response (:reason entry'))\n   972\t        (poll-link-response state entry')\n   973\t        [state entry' nil]))\n   974\t    :link-response (poll-link-response state entry)\n   975\t    :install [state entry nil]))\n   976\t\n   977\t\n   978\t(defn- poll-links\n   979\t  \"Poll every link wait entry once, in wait-set order, and then step the\n   980\t   install children. Returns the state with the still-waiting link\n   981\t   entries appended to `others` and the woken ones queued.\"\n   982\t  [state links others]\n   983\t  (let [[state waiting woken]\n   984\t        (reduce (fn [[state waiting woken] entry]\n   985\t                  (let [[state w k] (poll-link-entry state entry)]\n   986\t                    [state\n   987\t                     (cond-> waiting w (conj w))\n   988\t                     (cond-> woken k (conj k))]))\n   989\t                [state [] []]\n   990\t                links)]\n   991\t    (-> state\n   992\t        (assoc :wait-set (into (vec others) waiting))\n   993\t        (update :ready-queue (fnil into []) woken)\n   994\t        advance-installs)))\n   995\t\n   996\t\n   997\t(defn abandon-link\n   998\t  \"A composition gives up on link `link-id` (section 7.2, step 7): the\n   999\t   entry leaves the wait set and is restored with `reason` raised as the\n  1000\t   effect's error; the id is retired, so a response arriving later is\n  1001\t   `:late`. The linker side's `abandon` is the composition's call. An id\n  1002\t   no entry holds leaves the state unchanged.\"\n  1003\t  [state link-id reason]\n  1004\t  (let [held? (fn [e]\n  1005\t                (and (contains? #{:link-request :link-response} (:reason e))\n  1006\t                     (= link-id (:link-id e))))]\n  1007\t    (if-let [entry (first (filter held? (:wait-set state)))]\n  1008\t      (-> state\n  1009\t          (update :wait-set (fn [ws] (filterv (complement held?) ws)))\n  1010\t          (retire link-id :abandoned)\n  1011\t          (update :ready-queue (fnil conj [])\n  1012\t                  (refused-entry entry\n  1013\t                                 {:status :lost,\n  1014\t                                  :reason reason,\n  1015\t                                  :link-id link-id})))\n  1016\t      state)))\n  1017\t\n  1018\t\n  1019\t(defn check-wait-set\n  1020\t  \"Check wait-set entries against their transports.\n  1021\t\n  1022\t   The sweep is `dao.stream.waitset/check` — this engine was that library's\n  1023\t   seed and is now its first consumer. Every entry is resolved to a live\n  1024\t   handle and an opaque cursor out of the store by `waitset-resolver` and\n  1025\t   polled with a synchronous `next` or `append!` — resolution happens per\n  1026\t   poll, so the stored entry itself never carries a handle. There is no\n  1027\t   transport-local waking to fall back from: this is the only mechanism.\n  1028\t\n  1029\t   Entries are polled one at a time in wait-set order, and a woken reader's\n  1030\t   successor cursor is written back to the store before the next entry is\n  1031\t   resolved. Waiters sharing a cursor-ref therefore read distinct values —\n  1032\t   the value at the cursor wakes the first, its successor wakes the next —\n  1033\t   instead of every waiter reading the value at the shared pre-poll\n  1034\t   cursor. An entry that stays waiting is retained in its stored,\n  1035\t   resource-id form.\n  1036\t\n  1037\t   Each woken result's `:status` is stamped onto its ready entry, where\n  1038\t   `terminal-resume-outcome` reads it: an outcome the immediate operation\n  1039\t   raises as an error fails the same way when the resume pops it — and a\n  1040\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n  1041\t   there too, before any continuation is restored.\n  1042\t\n  1043\t   The link wait entries `require` adds (yin.vm.linker.md section 7.2) are\n  1044\t   polled first, by the engine rather than the stream sweep: a\n  1045\t   `:link-request` retries its envelope, a `:link-response` advances its\n  1046\t   own kept cursor to the response carrying its id, and an `:install`\n  1047\t   waits on its install child. The install children are then stepped in\n  1048\t   this same round (section 7.3), so a child that halts restores its\n  1049\t   waiters here; nothing about a child runs inside a restore.\"\n  1050\t  [state]\n  1051\t  (let [wait-set (:wait-set state)]\n  1052\t    (if (and (empty? wait-set) (empty? (:installs state)))\n  1053\t      state\n  1054\t      (let [state (poll-links state\n  1055\t                              (filterv link-entry? wait-set)\n  1056\t                              (remove link-entry? wait-set))\n  1057\t            wait-set (:wait-set state)\n  1058\t            streams (filterv (complement link-entry?) wait-set)\n  1059\t            {:keys [woken store], :as result}\n  1060\t            (waitset/check {:waiting streams} waitset-resolver (:store state))\n  1061\t            v (assoc state\n  1062\t                     :store store\n  1063\t                     :wait-set (into (:waiting (:waitset result))\n  1064\t                                     (filter link-entry?)\n  1065\t                                     wait-set))]\n  1066\t        (update v\n  1067\t                :ready-queue (fnil into [])\n  1068\t                (make-woken-run-queue-entries v woken))))))\n  1069\t\n  1070\t\n  1071\t(declare handle-effect resume-continuation)\n  1072\t\n  1073\t\n  1074\t(defn run-loop\n  1075\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n  1076\t   `resume-fn` pops and restores them.\"\n  1077\t  [state active? step-fn resume-fn]\n  1078\t  (loop [v state]\n  1079\t    (let [q (or (:ready-queue v) [])]\n  1080\t      (cond (active? v) (recur (step-fn v))\n","exit_code":0,"status":"completed"}}
