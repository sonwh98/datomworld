{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '290,320p' test/yin/vm/linker_require_test.cljc; sed -n '1070,1095p' test/yin/vm/linker_require_test.cljc\"","aggregated_output":"       [vm r]))))\n\n\n(defn- refusal-of\n  \"The ex-data of what `thunk` throws, or nil when it returns.\"\n  [thunk]\n  (try (thunk)\n       nil\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         (or (ex-data e) {}))))\n\n\n;; =============================================================================\n;; A require of an unlinked module links, installs, and resumes\n;; =============================================================================\n\n(def ^:private answer-module\n  \"`(yin/def f (fn [] 42))`.\"\n  (def! 'f (lam [] (lit 42))))\n\n\n(deftest a-require-links-installs-and-resumes-with-the-module-test\n  (doseq [backend (keys backends)]\n    (testing (name backend)\n      (let [pair (link-pair)\n            program (then (req 'foo) (app (v 'foo/f)))\n            root ((:vm (get backends backend)) program (composition pair))\n            r (responder pair {'foo (module-response backend 'foo\n                                                     answer-module ['f])})\n            [done r] (drive root r)\n            entry (module/module-entry (:modules (:modules done)) 'foo)]\n;; =============================================================================\n;; The install child's refusals\n;; =============================================================================\n\n(defn- drive-to-wakeup\n  \"Poll scheduler rounds without restoring the ready continuations.\"\n  [task r]\n  (loop [task task\n         r r\n         i 0]\n    (if (or (seq (:ready-queue task)) (< 40 i))\n      [task r]\n      (let [r (respond! r)]\n        (recur (engine/check-wait-set task) r (inc i))))))\n\n\n(defn- pin-refusal\n  [pinned linked]\n  {:status :refused,\n   :reason :dependency-pin-mismatch,\n   :module 'foo,\n   :name 'bar,\n   :pinned pinned,\n   :linked linked})\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat >> test/yin/vm/linker_require_test.cljc <<'EOF'\n\n\n;; L-d-1: the bare primitive resumes with linker outcomes as data.\n(defn- try-req\n  [spec]\n  (app (v 'try-require) (lit spec)))\n\n\n(deftest try-require-absent-continues-test\n  (doseq [[backend b] backends]\n    (testing (name backend)\n      (let [pair (link-pair)\n            program (app (lam '[result] (app (v 'vector) (v 'result)\n                                             (lit :continued)))\n                          (try-req 'foo))\n            [done r] (drive ((:vm b) program (composition pair))\n                            (responder pair {}))\n            [result continued] (vm/value done)]\n        (is (= :continued continued))\n        (is (= {:status :refused, :reason :absent, :module 'foo,\n                :name 'foo, :yin.link/id [:t0 0]}\n               result))\n        (is (= 1 (count (:requests r))))\n        (is (empty? (:wait-set done)))))))\n\n\n(deftest try-require-success-and-registry-hit-test\n  (doseq [[backend b] backends]\n    (testing (name backend)\n      (let [pair (link-pair)\n            program (app (lam '[result]\n                             (app (v 'vector) (v 'result)\n                                  (app (v 'foo/f))))\n                          (try-req '[foo :as foo]))\n            [done r] (drive ((:vm b) program (composition pair))\n                            (responder pair\n                                       {'foo (module-response backend 'foo\n                                                              answer-module\n                                                              ['f])}))\n            [hit r] (drive ((:continue b) done (try-req 'foo)) r)]\n        (is (= [{:status :ok, :module 'foo} 42] (vm/value done)))\n        (is (= {:status :ok, :module 'foo} (vm/value hit)))\n        (is (= 1 (count (:requests r))))\n        (is (empty? (:wait-set hit)))))))\n\n\n(deftest try-require-host-hit-test\n  (doseq [[backend b] backends]\n    (testing (name backend)\n      (let [pair (link-pair)\n            opts (update (composition pair) :modules\n                         module/register-host-module 'foo {'f inc}\n                         {'f (vm/primitive-profile 'f :pure [1] #{} :none)})\n            [done r] (drive ((:vm b) (try-req 'foo) opts)\n                            (responder pair {}))]\n        (is (= {:status :ok, :module 'foo} (vm/value done)))\n        (is (empty? (:requests r)))\n        (is (empty? (:wait-set done)))))))\n\n\n(deftest try-require-cycle-is-data-test\n  (doseq [[backend b] backends]\n    (testing (name backend)\n      (let [pair (link-pair)\n            root (assoc ((:vm b) (try-req 'foo) (composition pair))\n                        :ancestry '[foo bar])\n            [done r] (drive root (responder pair {}))]\n        (is (= {:status :refused, :reason :require-cycle, :module 'foo,\n                :chain '[foo bar foo]}\n               (vm/value done)))\n        (is (empty? (:requests r)))\n        (is (empty? (:wait-set done)))))))\n\n\n(deftest try-require-abandon-link-is-data-test\n  (doseq [[backend b] backends]\n    (testing (name backend)\n      (let [pair (link-pair)\n            root (vm/run ((:vm b) (try-req 'foo) (composition pair)))\n            id (:link-id (first (:wait-set root)))\n            abandoned (engine/abandon-link root id :cancelled)\n            done (vm/run abandoned)]\n        (is (= {:status :lost, :reason :cancelled, :link-id id}\n               (vm/value done)))\n        (is (= :abandoned (get (:link-retired done) id)))\n        (is (empty? (:wait-set done)))))))\n\n\n(deftest try-require-and-require-co-waiters-test\n  (doseq [[backend b] backends]\n    (testing (name backend)\n      (let [pair (link-pair)\n            opts (composition pair)\n            plain (vm/run ((:vm b) (req 'foo) opts))\n            attempt (vm/run ((:vm b) (try-req 'foo) opts))\n