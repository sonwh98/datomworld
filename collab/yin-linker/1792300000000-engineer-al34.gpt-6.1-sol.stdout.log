(ns yin.vm.linker.interpreter
  "The REPL's linker-side composition (yin.vm.linker.md sections 6.1 and 9,
   M5): the interpreter box of the four-stream topology.

   The shell composes the link pair per VM (`yin.repl/make-session`) and
   the content pair per content source; this namespace owns the second
   and answers what the first receives.  One serve round reads every link
   request the interpreter has not yet seen, resolves each by name
   through the composition's name environment -- the snapshot the host
   supplies, an authority fold (`yin.vm.linker.authority/name-environment`)
   reduced to `name -> manifest address` -- and links the manifest's
   image over the content pair, appending the response the requesting
   task correlates on (section 7.2, steps 5 to 6).

   Step 5b is deferred: the obligations travel on the response and the
   receiving task's engine discharges them against its live state
   (section 7.2, step 7), so the interpreter passes
   `:defer-discharge` to `link-manifest` and discharges nothing here.

   Liveness is the composition's (section 6.3, D6): an attempt serves the
   content pair for at most `attempt-budget` drive rounds and then
   reports the link `:pending` -- nothing is appended, the request is
   re-read and re-attempted on a later round, and `abandon` is the
   shell's.  No clock, no atom, no global: every input is an argument or
   a composition value, and every outcome is plain data.

   A DHT link source (docs/design/yin.vm.linker.dht.md 4.1) holds no
   handle: each serve round receives the shell's `dao.space.dht` node
   and answers the node after it.  A resolved name whose closure is not
   loaded starts its load (`yin.vm.linker.dht/load-module`) and reports
   the link `:pending`, naming the manifest it waits on; the node's own
   step fetches.  A failed load is refused in its section 9 shape and
   forgotten; a loaded one has its dependency bindings checked, then
   links over a local runtime on the node's store, asking no peer."
  (:require [clojure.string :as str]
            [dao.jing.content :as content]
            [dao.space.dht :as dht]
            [dao.stream :as stream]
            [dao.stream.ringbuffer :as ring]
            [yin.vm.linker :as linker]
            [yin.vm.linker.admission :as admission]
            [yin.vm.linker.dht :as linker.dht]
            [yin.vm.linker.sign :as sign]))


(def pair-capacity
  "Declared capacity of each link-pair medium, in elements.  The shell
   appends one request per require, and a response medium a receiver
   never drains answers `gap` (an evicted request is never re-read), so
   the bound is generous and the eviction it guards against is a host
   assembly defect, not an operating condition."
  1024)


(def content-capacity
  "Declared capacity of each content-pair medium, in elements.  One
   attempt's traffic is a handful of requests; the media persist across
   attempts and every attempt mints its cursors at their newest end, so
   an old element is never read again."
  1024)


(def attempt-budget
  "Drive rounds one link attempt may spend before it reports `:pending`.
   A local pair answers within a few rounds per content request, so the
   budget is reached only by a content source that never answers."
  64)


(def serve-steps
  "Server advances one drive round performs at most.  Each answers at
   least one waiting content request, so a local pair drains in a bound
   number of rounds."
  32)


(def serve-budget
  "Link requests one serve round answers, in request order.  It exceeds
   what one evaluation's requires can enqueue, so a round that spends it
   is answering a queue the shell did not write."
  64)


(def formats
  "The seven format records a serving composition holds (sections 5 and
   8.1): the five execution formats a requesting kernel names, and the
   two the manifest flow fetches internally."
  (into {}
        (map (fn [r] [(:format r) r]))
        [linker/ast-format linker/semantic-format linker/semantic-register-format
         linker/stack-format
         linker/register-format linker/manifest-format
         linker/record-format]))


(defn- medium
  [capacity]
  (:dao.stream/handle
    (ring/create! {:dao.stream/type ring/transport-type
                   ring/capacity-key capacity})))


(defn- newest
  [handle]
  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))


(defn make-pair
  "The link pair of one session (section 6.1): the request and response
   media, `capacity` elements each (`pair-capacity` by default), and the
   interpreter's own request cursor, minted before any request exists."
  ([] (make-pair pair-capacity))
  ([capacity]
   (let [requests (medium capacity)
         responses (medium capacity)]
     {:requests requests
      :responses responses
      :cursor (:dao.stream/cursor
                (stream/cursor requests stream/anchor-oldest))})))


(defn composition
  "The content side of the shell's link composition, from the host's
   creation options.  `content-store` is a `dao.jing` byte-store handle
   served in process over its own ring-buffer content pair (the
   single-process and durable-local rows of section 6.1);
   `content-client` is the linker's content-pair client map
   `{:requests w :answers r :cursor c}` on a connection whose far end
   serves content (the remote-content row), and the drive then only
   steps the linker, the server running elsewhere (section 6.4).  A
   content source is optional: with none, every link stays `:pending`
   and says so.  Supplying both is a composition defect.  `dht?` is the
   DHT link source (yin.vm.linker.dht.md 4.1): it reads content from the
   node each serve round is handed, holds nothing here, and is refused
   together with either content source.

   `principals` are the public keys (64 lowercase hex) whose signed name
   assertions the reader honors (yin.vm.linker.dht.md 7.1), and `key`
   the node's own publisher key, whose principal is declared too (6.5):
   a node resolves the names it published.  Only the public half is
   kept here.  `follow` are the principal ids (`ed25519:<hex>`) whose
   published heads the DHT source follows (yin.vm.linker.dht.head.md
   5.6): a name that is `:absent` while one of them has no installed head
   is pending on it, not refused.

   `derivation` is the composition's derivation policy (section 8.1) for
   the manifest links it serves from a content source: `:verifying`, the
   default, or `:trusted`, which only a composition that is its own
   publisher asks for. The response names the trust it applied.

                (recur (assoc pair :cursor (:dao.stream/cursor r))
                       node
                       (some-> admission (admission/settle link-id))
                       (dec remaining)
                       pending
                       true)
                {:pair pair
                 :pending (conj pending
                                (cond-> {:name (:yin.link/name request)
                                         :yin.link/id link-id}
                                  waits (assoc :manifest waits)
                                  heads (assoc :principals heads)
                                  asking (assoc :admission asking)))
                 :progress? (or progress? (true? asked?))
                 :dht node
                 :admission admission}))))))))


(defn serve
  "Serve requests over the legacy composition, draining answers once."
  ([comp] (serve comp serve-budget))
  ([comp budget]
   (serve-requests
     (update comp :admission #(some-> % (admission/drain budget)))
     budget)))


(defn make
  "Mint one linker value over `source`, with optional holder `context`.
   Only signed-name sources mint an admission pair. A configured policy
   attaches its in-process interpreter; external policy attaches none."
  ([source] (make source nil))
  ([source context]
   (let [signed? (= :dht (get-in source [:content :kind]))
         adm (when signed? (admission/make-state pair-capacity))
         policy (:admission source)]
     (cond-> {:pair (make-pair) :source source}
       adm (assoc :admission adm)
       (and adm policy)
       (assoc :interpreter (admission/interpreter adm policy)
              :context (admission/context context))))))


(defn round
  "Drain once, serve requests to the first pending, then answer in process.
   Always return the successor, even when nothing reports progress."
  ([linker node] (round linker node serve-budget))
  ([linker node budget]
   (let [before (:admission linker)
         drained (some-> before (admission/drain budget))
         matched? (not= (:answers before) (:answers drained))
         served (serve-requests (assoc linker :dht node :admission drained)
                                budget)
         successor (cond-> (assoc linker :pair (:pair served))
                     before (assoc :admission (:admission served)))
         answered (when (:interpreter successor)
                    (admission/serve
                      {:interpreter (:interpreter successor)
                       :policy (get-in successor [:source :admission])
                       :context (:context successor)}
                      budget))
         successor (cond-> successor
                     answered (assoc :interpreter (:interpreter answered)))]
     {:linker successor
      :dht (:dht served)
      :pending (:pending served)
      :answered (:answered answered 0)
      :progress? (boolean (or matched? (:progress? served)
                              (:progress? answered)))})))


;; =============================================================================
;; Retirement of an abandoned run (yin.vm.linker.dht.md 7.5)
;; =============================================================================

(defn run-descriptor
  "The run an abandon retires: link ids `[origin k]` with `from <= k <
   until` of `:ids`, and every install child origin `origin.m` with
   `from <= m < until` of `:children`, with its descendants.  `base` is
   the VM the run began from, `parked` the VM it was given up as; an
   absent counter is zero.  Both counters mint the current value then
   increment, so each interval is half-open."
  [base parked]
  {:origin (or (:origin parked) :t0)
   :ids [(or (:id-counter base) 0) (or (:id-counter parked) 0)]
   :children [(or (:origins base) 0) (or (:origins parked) 0)]})


(defn- run-owned?
  "Whether link id `id` belongs to `run`: its own origin within `:ids`,
   or an install child origin within `:children` exactly, or one of its
   descendants -- matched on the child's name followed by \".\", never
   a raw prefix, so `:t0.10` is not a descendant of `:t0.1`."
  [id {:keys [origin ids children]}]
  (when (and (vector? id) (= 2 (count id)) (keyword? (first id))
             (integer? (second id)))
    (let [[o k] id
          [from until] ids
          [cfrom cuntil] children
          on (name o)]
      (or (and (= o origin) (<= from k) (< k until))
          (some (fn [m]
                  (let [child (str (name origin) "." m)]
                    (or (= on child)
                        (str/starts-with? on (str child ".")))))
                (range cfrom cuntil))))))


(defn retire
  "Retire the requests of an abandoned `run` (`run-descriptor`) still
   unread on `pair`: walking from the request cursor, each request the
   run owns is passed over with no response -- the engine has already
   retired its id, so a response would be late -- and the first request
   it does not own stops the walk, keeping request order.  Every
   admission question and answer of a retired request is dropped.
   Returns the successor value with `:retired [link-id ...]`."
  [{:keys [pair admission] :as linker} run]
  (loop [pair pair
         retired []]
    (let [r (stream/next (:requests pair) (:cursor pair))
          id (:yin.link/id (:dao.stream/value r))]
      (if (and (= :dao.stream/ok (:dao.stream/outcome r))
               (run-owned? id run))
        (recur (assoc pair :cursor (:dao.stream/cursor r)) (conj retired id))
        (cond-> (assoc linker :pair pair :retired retired)
          admission (assoc :admission (admission/forget admission retired)))))))
(ns yin.vm.linker.admission
  "The admission pair (yin.vm.linker.dht.md section 7.5): the trust
   question a DHT link source asks before it loads a name another
   principal asserts, and the interpreter that answers it.

   Two ring media sit beside the link pair.  The composition appends a
   question -- plain data bound to the resolution it was asked about,
   carrying no session and no subject -- to the question medium and
   parks the link; one interpreter reads the questions and appends one
   answer each to the answer medium; the composition drains the answers
   with a persisted cursor and keeps those that match a question it
   still holds.  Neither side calls the other: each knows only the two
   media.

   The composition's half is a value, `make-state`: the pair, the
   questions it has asked keyed by link id, the matching answers it has
   drained keyed by admission id `[link-id serial]`, and the serial it
   mints the next id from, never reused.  The interpreter's half is
   another value, `interpreter`: its question cursor and the decision
   snapshot it last read.  No clock, no atom, no global: every outcome
   is plain data, and every read persists its cursor.

   The interpreter answers with `(verify decision context question)`,
   the ShiBi verify signature (dao.shibi.md): nil allows, a reason map
   refuses.  The default policy's decision is the composition's own
   principals and an explicit trusted set; it allows a question one of
   whose asserters is in it.  Trust is not safety: the linker checks
   closure origin, store ownership and dependency pins whatever the
   answer says, and conditions must be empty."
  (:require [dao.stream :as stream]
            [dao.stream.ringbuffer :as ring]
            [yin.vm.linker.sign :as sign]))


(def reasons
  "Every reason the admission seam refuses with: the default policy's,
   the composition's fail-closed refusals of an answer it cannot honor,
   and the refusal of a DHT source composed with no admission state."
  #{:yin.admit/untrusted-principal
    :yin.admit/decision-ended
    :yin.admit/malformed-answer
    :yin.admit/unsupported-condition
    :yin.admit/unconfigured})


(defn- medium
  [capacity]
  (:dao.stream/handle
    (ring/create! {:dao.stream/type ring/transport-type
                   ring/capacity-key capacity})))


(defn- oldest
  [handle]
  (:dao.stream/cursor (stream/cursor handle stream/anchor-oldest)))


(defn- ok?
  [r]
  (= :dao.stream/ok (:dao.stream/outcome r)))


;; =============================================================================
;; The composition's half
;; =============================================================================

(defn make-state
  "The composition's admission state over a fresh pair of `capacity`
   elements each: the question and answer media, the answer cursor
   minted at the answer medium's oldest end before any answer exists,
   nothing asked, nothing answered, serial 0.  An unread answer is
   evicted when the unread backlog exceeds `capacity`: the host bounds
   that backlog by its production rate and drain cadence, and an
   evicted answer's question stays open until its request is retired."
  [capacity]
  (let [questions (medium capacity)
        answers (medium capacity)]
    {:pair {:questions questions
            :answers answers
            :cursor (oldest answers)}
     :asked {}
     :answers {}
     :serial 0}))


(defn- answer-link-id
  "The link id component of answer `a`'s admission id, or nil when the
   answer carries no `[link-id serial]`."
  [a]
  (let [id (when (map? a) (:yin.admit/id a))]
    (when (and (vector? id) (= 2 (count id)))
      (first id))))


(defn- keep-answer
  "`admission` with answer `a` retained when its id is exactly the id of
   the question asked for its link id and no answer is held for it yet:
   the first answer wins, and a duplicate, a stale serial, or an answer
   for an unknown or retired id correlates to nothing and is dropped."
  [admission a]
  (let [id (:yin.admit/id a)
        asked (get-in admission [:asked (answer-link-id a)])]
    (if (and (some? asked)
             (= id (:yin.admit/id asked))
             (not (contains? (:answers admission) id)))
      (assoc-in admission [:answers id] a)
      admission)))


(defn drain
  "Consume at most `budget` elements of the answer medium from the
   composition's persisted cursor, keeping the answers that match a
   question still asked (`keep-answer`), and answer the successor state
   with the cursor past everything read.  A gap adopts the recovery
   cursor the transport answers -- the earliest retained position,
   never an evicted one -- and continues within the budget; blocked or
   end stops.  The same function serves a link round and the host's
   recheck hook."
  [admission budget]
  (let [answers (get-in admission [:pair :answers])]
    (loop [admission admission
           left budget]
      (if (<= left 0)
        admission
        (let [r (stream/next answers (get-in admission [:pair :cursor]))
              admission' (assoc-in admission [:pair :cursor]
                                   (:dao.stream/cursor r))]
          (case (:dao.stream/outcome r)
            :dao.stream/ok (recur (keep-answer admission'
                                               (:dao.stream/value r))
                                  (dec left))
            :dao.stream/gap (recur admission' (dec left))
            admission))))))


(defn ask
  "Append the question for link `request` over the resolved `entry` of
   its name, bound to that resolution: the manifest address, every
   asserter, and the entry's provenance verbatim, with the request's own
   format and contract.  Answers `{:admission a :id id}` with the
   question retained under its link id and the serial advanced, or
   `{:admission admission}` unchanged when the medium refused it."
  [admission request entry]
  (let [link-id (:yin.link/id request)
        id [link-id (:serial admission)]
        provenance (:yin.link/provenance entry)
        question {:yin.admit/id id
                  :yin.link/id link-id
                  :yin.admit/name (:yin.link/name request)
                  :yin.admit/address (:address entry)
                  :yin.admit/asserters (vec (:yin.module/asserted-by
                                              provenance))
                  :yin.admit/provenance provenance
                  :yin.link/format (:yin.link/format request)
                  :yin.link/contract (:yin.link/contract request)}]
    (if (ok? (stream/append! (get-in admission [:pair :questions]) question))
      {:admission (-> admission
                      (assoc-in [:asked link-id] question)
                      (update :serial inc))
       :id id}
      {:admission admission})))


(defn asked
  "The question `admission` holds for `link-id`, or nil."
  [admission link-id]
  (get-in admission [:asked link-id]))


(defn answer-to
  (loop [interp interp]
    (let [r (stream/next medium (:decision-cursor interp))]
      (case (:dao.stream/outcome r)
        :dao.stream/ok (recur (assoc interp
                                     :decision-cursor (:dao.stream/cursor r)
                                     :snapshot (:dao.stream/value r)
                                     :snapshot? true))
        :dao.stream/gap (recur (assoc interp
                                      :decision-cursor
                                      (:dao.stream/cursor r)))
        :dao.stream/end (assoc interp :ended? true)
        interp))))


(defn- snapshot
  "`interp` with this round's decision snapshot, read once."
  [interp policy]
  (if-let [medium (:decision-medium policy)]
    (read-decisions interp medium)
    (assoc interp :snapshot (:decision policy) :snapshot? true)))


(defn- decide
  [interp policy context question]
  (let [base {:yin.admit/id (:yin.admit/id question)}]
    (if (:ended? interp)
      (assoc base
             :yin.admit/decision :refuse
             :yin.admit/reason :yin.admit/decision-ended)
      (let [r ((:verify policy) (:snapshot interp) context question)]
        (cond
          (nil? r) (assoc base
                          :yin.admit/decision :allow
                          :yin.admit/conditions {})
          (map? r) (merge r base {:yin.admit/decision :refuse})
          :else (assoc base :yin.admit/decision :refuse))))))


(defn serve
  "One round of the interpreter: read the decision snapshot once, then
   answer at most `budget` questions in order, one answer each.  With no
   snapshot yet and the decision medium not ended, nothing is answered
   and the questions stay.  `verify` runs synchronously on the one
   snapshot; it opens, fetches and waits for nothing.  An answer the
   medium refuses stops the round with its question unread.  Returns
   `{:interpreter i :progress? bool :answered n}`."
  [{:keys [interpreter policy context]} budget]
  (let [interp (snapshot interpreter policy)]
    (if-not (or (:ended? interp) (:snapshot? interp))
      {:interpreter interp, :progress? false, :answered 0}
      (loop [interp interp
             n 0
             left budget]
        (let [done {:interpreter interp, :progress? (pos? n), :answered n}]
          (if (<= left 0)
            done
            (let [r (stream/next (:questions interp) (:cursor interp))]
              (case (:dao.stream/outcome r)
                :dao.stream/ok
                (let [a (decide interp policy context (:dao.stream/value r))]
                  (if (ok? (stream/append! (:answers interp) a))
                    (recur (assoc interp :cursor (:dao.stream/cursor r))
                           (inc n)
                           (dec left))
                    done))

                :dao.stream/gap
                (recur (assoc interp :cursor (:dao.stream/cursor r))
                       n
                       (dec left))

                done))))))))

