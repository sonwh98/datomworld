ind kind :fetched fetched\n1163:                :fetching (:address fetching)}\n1164:      :loaded {:status status :kind kind :fetched fetched :value value}\n1165:      :failed {:status status :kind kind :fetched fetched :reason reason})))\n1178:(defn loaded-datoms\n1186:(defn loaded-indexes\n1214:(defn- fail-load\n1218:                                              :fetching nil)\n1223:(defn- advance-load\n1225:  (let [{:keys [fetching kind walk], :as record} (get-in node [:loads m])\n1226:        done (when fetching (get done-by-id (:id fetching)))]\n1228:      (and fetching (nil? done)) [node []]\n1231:      ;; advance-loads drops it once none does\n1233:      (let [a (:address fetching)]\n1235:                           :cause (get-in node [:misses a] ::dht/gap)}))\n1238:      (let [fetched (cond-> (:fetched record) done inc)\n1239:            node (update-in node [:loads m] assoc :fetching nil :fetched fetched)\n1245:           [(cond-> {::event :loaded :manifest m :kind kind :fetched fetched}\n1259:                   (assoc-in [:loads m :fetching] {:id id :address a}))\n1269:(defn- advance-loads\n1276:                                                           fetch-budget)\n1279:                                    (let [[node more] (advance-load node m done-by-id)]\n1284:        ;; only the causes of addresses still being fetched\n1285:        [(update node :misses select-keys (fetching node)) events]))))\n1292:(defn step\n1309:          [node loaded] (advance-loads node)\n","exit_code":0,"status":"completed"}}
