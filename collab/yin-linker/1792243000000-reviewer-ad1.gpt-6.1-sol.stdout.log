    60	(defn- publish!
    61	  "Publish module `n` into `store`, `(yin/def f body)`, after `(require
    62	   'dep)` when `dep` is given, pinned to `dep-address`: its manifest
    63	   address."
    64	  ([store n body] (publish! store n body nil nil))
    65	  ([store n body dep dep-address]
    66	   (:address
    67	     (publish/publish-module!
    68	       store
    69	       (if dep
    70	         {:name n
    71	          :ast (call {:type :lambda :params '[_] :body (ct/def! 'f body)}
    72	                     (call (variable 'require) (ct/lit dep)))
    73	          :exports #{'f}
    74	          :requires {dep dep-address}
    75	          :primitives (assoc ct/plus 'require
    76	                             (vm/profile-of vm/primitives 'require))}
    77	         {:name n :ast (ct/def! 'f body) :exports #{'f} :requires {}
    78	          :primitives ct/plus})))))
