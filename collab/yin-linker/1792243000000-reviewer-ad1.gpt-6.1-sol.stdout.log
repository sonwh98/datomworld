   235	(defn trusted-asserter
   236	  "The default verify: allow when some asserter of `question` is in the
   237	   `decision` set, else refuse `:yin.admit/untrusted-principal` naming
   238	   the asserters."
   239	  [decision _context question]
   240	  (let [asserters (vec (:yin.admit/asserters question))]
   241	    (when-not (some #(contains? decision %) asserters)
   242	      {:yin.admit/reason :yin.admit/untrusted-principal
   243	       :yin.admit/asserters asserters})))
