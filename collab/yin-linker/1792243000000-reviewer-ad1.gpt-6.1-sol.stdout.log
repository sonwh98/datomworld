   176	(defn judge
   177	  "nil when `answer` allows with empty conditions; otherwise the refusal
   178	   it amounts to, as `{:yin.admit/reason r ...}`.  A refusal keeps the
   179	   answer's reason and open keys.  Non-empty conditions refuse
   180	   `:yin.admit/unsupported-condition` and anything else that is not an
   181	   allow or a refusal with a keyword reason refuses
   182	   `:yin.admit/malformed-answer`: both fail closed."
   183	  [answer]
   184	  (let [decision (:yin.admit/decision answer)
   185	        conditions (get answer :yin.admit/conditions {})]
   186	    (cond
   187	      (and (= :allow decision) (map? conditions) (empty? conditions)) nil
   188	
   189	      (and (= :allow decision) (map? conditions))
   190	      {:yin.admit/reason :yin.admit/unsupported-condition
   191	       :yin.admit/conditions conditions}
   192	
   193	      (and (= :refuse decision) (keyword? (:yin.admit/reason answer)))
   194	      (dissoc answer :yin.admit/id :yin.admit/decision)
   195	
   196	      :else {:yin.admit/reason :yin.admit/malformed-answer})))
