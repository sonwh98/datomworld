   275	(defn interpreter
   276	  "The in-process interpreter's state over `admission`'s pair under
   277	   `policy`: the two media, its question cursor minted at the oldest
   278	   end, and its decision-medium cursor when the policy names one."
   279	  [admission policy]
   280	  (let [{:keys [questions answers]} (:pair admission)
   281	        decisions (:decision-medium policy)]
   282	    (cond-> {:questions questions
   283	             :answers answers
   284	             :cursor (oldest questions)}
   285	      decisions (assoc :decision-cursor (oldest decisions)))))
   286	
   287	
   288	(defn- read-decisions
   289	  "`interp` after reading the decision medium to its present end: the
   290	   newest value read is the snapshot, an ended medium is `:ended?`."
   291	  [interp medium]
   292	  (loop [interp interp]
   293	    (let [r (stream/next medium (:decision-cursor interp))]
   294	      (case (:dao.stream/outcome r)
   295	        :dao.stream/ok (recur (assoc interp
   296	                                     :decision-cursor (:dao.stream/cursor r)
   297	                                     :snapshot (:dao.stream/value r)
   298	                                     :snapshot? true))
   299	        :dao.stream/gap (recur (assoc interp
   300	                                      :decision-cursor
   301	                                      (:dao.stream/cursor r)))
   302	        :dao.stream/end (assoc interp :ended? true)
   303	        interp))))
   304	
   305	
   306	(defn- snapshot
   307	  "`interp` with this round's decision snapshot, read once."
   308	  [interp policy]
   309	  (if-let [medium (:decision-medium policy)]
   310	    (read-decisions interp medium)
   311	    (assoc interp :snapshot (:decision policy) :snapshot? true)))
   312	
   313	
   314	(defn- decide
   315	  [interp policy context question]
   316	  (let [base {:yin.admit/id (:yin.admit/id question)}]
   317	    (if (:ended? interp)
   318	      (assoc base
   319	             :yin.admit/decision :refuse
   320	             :yin.admit/reason :yin.admit/decision-ended)
   321	      (let [r ((:verify policy) (:snapshot interp) context question)]
   322	        (cond
   323	          (nil? r) (assoc base
   324	                          :yin.admit/decision :allow
   325	                          :yin.admit/conditions {})
   326	          (map? r) (merge r base {:yin.admit/decision :refuse})
   327	          :else (assoc base :yin.admit/decision :refuse))))))
   328	
   329	
   330	(defn serve
   331	  "One round of the interpreter: read the decision snapshot once, then
   332	   answer at most `budget` questions in order, one answer each.  With no
   333	   snapshot yet and the decision medium not ended, nothing is answered
   334	   and the questions stay.  `verify` runs synchronously on the one
   335	   snapshot; it opens, fetches and waits for nothing.  An answer the
   336	   medium refuses stops the round with its question unread.  Returns
   337	   `{:interpreter i :progress? bool :answered n}`."
   338	  [{:keys [interpreter policy context]} budget]
   339	  (let [interp (snapshot interpreter policy)]
   340	    (if-not (or (:ended? interp) (:snapshot? interp))
   341	      {:interpreter interp, :progress? false, :answered 0}
   342	      (loop [interp interp
   343	             n 0
   344	             left budget]
   345	        (let [done {:interpreter interp, :progress? (pos? n), :answered n}]
   346	          (if (<= left 0)
   347	            done
   348	            (let [r (stream/next (:questions interp) (:cursor interp))]
   349	              (case (:dao.stream/outcome r)
   350	                :dao.stream/ok
   351	                (let [a (decide interp policy context (:dao.stream/value r))]
   352	                  (if (ok? (stream/append! (:answers interp) a))
   353	                    (recur (assoc interp :cursor (:dao.stream/cursor r))
   354	                           (inc n)
   355	                           (dec left))
   356	                    done))
   357	
   358	                :dao.stream/gap
   359	                (recur (assoc interp :cursor (:dao.stream/cursor r))
   360	                       n
   361	                       (dec left))
   362	
   363	                done))))))))

