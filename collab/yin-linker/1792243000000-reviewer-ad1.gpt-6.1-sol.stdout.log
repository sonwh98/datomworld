   136	(defn ask
   137	  "Append the question for link `request` over the resolved `entry` of
   138	   its name, bound to that resolution: the manifest address, every
   139	   asserter, and the entry's provenance verbatim, with the request's own
   140	   format and contract.  Answers `{:admission a :id id}` with the
   141	   question retained under its link id and the serial advanced, or
   142	   `{:admission admission}` unchanged when the medium refused it."
   143	  [admission request entry]
   144	  (let [link-id (:yin.link/id request)
   145	        id [link-id (:serial admission)]
   146	        provenance (:yin.link/provenance entry)
   147	        question {:yin.admit/id id
   148	                  :yin.link/id link-id
   149	                  :yin.admit/name (:yin.link/name request)
   150	                  :yin.admit/address (:address entry)
   151	                  :yin.admit/asserters (vec (:yin.module/asserted-by
   152	                                              provenance))
   153	                  :yin.admit/provenance provenance
   154	                  :yin.link/format (:yin.link/format request)
   155	                  :yin.link/contract (:yin.link/contract request)}]
   156	    (if (ok? (stream/append! (get-in admission [:pair :questions]) question))
   157	      {:admission (-> admission
   158	                      (assoc-in [:asked link-id] question)
   159	                      (update :serial inc))
   160	       :id id}
   161	      {:admission admission})))
   162	
