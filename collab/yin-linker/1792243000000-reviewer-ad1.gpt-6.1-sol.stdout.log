   116	(defn- world
   117	  "The solo node and its modules: `own.m`, `own2.m`, `own3.m`, `app.m`
   118	   (requires `own.m`), `bad.m` (its body raises), `mid.m` (requires
   119	   `inner.m`) and `inner.m` (requires `their.m`) asserted by A,
   120	   `their.m` asserted by B, and `direct.m` asserted by nobody."
   121	  []
   122	  (let [node (dht/join {:local (mem/create-content-mem)})
   123	        store (dht/local node)
   124	        own (publish! store 'own.m forty-two)
   125	        their (publish! store 'their.m forty-two)
   126	        inner (publish! store 'inner.m
   127	                        (call (variable '+) (variable 'their.m/f) (ct/lit 1))
   128	                        'their.m their)
   129	        addresses {'own.m own
   130	                   'own2.m (publish! store 'own2.m forty-two)
   131	                   'own3.m (publish! store 'own3.m forty-two)
   132	                   'app.m (publish! store 'app.m
   133	                                    (call (variable '+) (variable 'own.m/f)
   134	                                          (ct/lit 1))
   135	                                    'own.m own)
   136	                   'bad.m (publish! store 'bad.m
   137	                                    (call (variable '+) (ct/lit 1)
   138	                                          (call (ct/lit 1))))
   139	                   'inner.m inner
   140	                   'mid.m (publish! store 'mid.m
   141	                                    (call (variable '+) (variable 'inner.m/f)
   142	                                          (ct/lit 1))
   143	                                    'inner.m inner)
   144	                   'their.m their
   145	                   'direct.m (publish! store 'direct.m forty-two)}
   146	        by-a (map-indexed (fn [i n] (assertion a n (get addresses n) (inc i)))
   147	                          '[own.m own2.m own3.m app.m bad.m inner.m mid.m])]
   148	    {:node (index! node (conj (vec by-a)
   149	                              (assertion b 'their.m their 1)))
   150	     :store store
   151	     :addresses addresses
   152	     :by-a (vec by-a)}))
