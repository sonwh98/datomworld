   349	                     :body ::pending
   350	                     :waits address}
   351	
   352	      (not= linker.dht/module-kind (:kind status))
   353	      {:node node
   354	       :body {:status :refused
   355	              :reason :dao.space.dht/kind-conflict
   356	              :address address
   357	              :recorded (:kind status)}}
   358	
   359	      (= :loading (:status status)) {:node node, :body ::pending, :waits address}
   360	
   361	      (= :failed (:status status)) {:node (dht/forget node address)
   362	                                    :body (linker.dht/load-refusal status)}
