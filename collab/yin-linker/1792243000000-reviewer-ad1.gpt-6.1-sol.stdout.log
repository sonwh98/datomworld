   276	  (let [w (world)
   277	        s (round (ask! (seam w) [:t0 0] 'own.m))]
   278	    (testing "the first round asks: the question is appended, reported as
   279	              progress, and the link parks on it with nothing loaded"
   280	      (is (true? (get-in s [:served :progress?])))
   281	      (is (= [{:name 'own.m :yin.link/id [:t0 0] :admission [[:t0 0] 0]}]
   282	             (get-in s [:served :pending])))
   283	      (is (= [{:yin.admit/id [[:t0 0] 0]
   284	               :yin.link/id [:t0 0]
   285	               :yin.admit/name 'own.m
   286	               :yin.admit/address (address w 'own.m)
   287	               :yin.admit/asserters [pa]
   288	               :yin.admit/provenance (:yin.link/provenance
   289	                                       (ld/resolve-name
   290	                                         (:node s)
   291	                                         (link/authority (:src s))
   292	                                         'own.m))
   293	               :yin.link/format :yin.semantic/code
   294	               :yin.link/contract vm/semantic-contract}]
   295	             (questions-of (:adm s))))
