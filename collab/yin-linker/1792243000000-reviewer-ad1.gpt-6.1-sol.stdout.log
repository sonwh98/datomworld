   215	
   216	(defn- round
   217	  "One link serve round, then one interpreter round, then one node step."
   218	  [s]
   219	  (let [served (link/serve {:pair (:pair s)
   220	                            :source (:src s)
   221	                            :dht (:node s)
   222	                            :admission (:adm s)})
   223	        admitted (when (:interp s)
   224	                   (admission/serve {:interpreter (:interp s)
   225	                                     :policy (get-in s [:src :admission])
   226	                                     :context ctx}
   227	                                    link/serve-budget))
   228	        [node _] (dht/step (:dht served) (:now s))]
   229	    (assoc s
   230	           :pair (:pair served)
   231	           :adm (:admission served)
   232	           :interp (if admitted (:interpreter admitted) (:interp s))
   233	           :node node
   234	           :now (+ 10 (:now s))
   235	           :served served
   236	           :admitted admitted)))
   237	
