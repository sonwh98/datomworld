   653	       "const {workerData} = require('worker_threads');\n"
   654	       "const nodeFs = require('fs'); const nodePath = require('path');\n"
   655	       "const {sab, bundle, dir, id} = workerData;\n"
   656	       "const flags = new Int32Array(sab);\n"
   657	       "const pause = new Int32Array(new SharedArrayBuffer(4));\n"
   658	       "const last = 'SHADOW_IMPORT(\"dao.space.store.fs.js\");';\n"
   659	       "let text = nodeFs.readFileSync(bundle, 'utf8');\n"
   660	       "text = text.slice(text.indexOf('\\n') + 1, text.indexOf(last) + last.length);\n"
