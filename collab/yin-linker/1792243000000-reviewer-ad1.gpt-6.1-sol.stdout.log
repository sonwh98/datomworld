   246	(defn- composed
   247	  "One verify of `verify`: a function, or a sequence of them composed so
   248	   the first reason wins."
   249	  [verify]
   250	  (cond
   251	    (nil? verify) trusted-asserter
   252	    (fn? verify) verify
   253	    :else (fn [decision context question]
   254	            (some #(% decision context question) verify))))
   255	
