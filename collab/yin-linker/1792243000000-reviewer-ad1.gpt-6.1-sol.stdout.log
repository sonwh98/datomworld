   183	(defn- seam
   184	  "A DHT link source over `w`'s node, declaring B, holding A's key, its
   185	   in-process interpreter composed from `opts` -- none when `opts` is
   186	   nil -- and a fresh link pair and admission state."
   187	  ([w] (seam w {}))
   188	  ([w opts] (seam w opts (admission/make-state link/pair-capacity)))
   189	  ([w opts adm]
   190	   (let [src (link/composition {:dht? true
   191	                                :principals [(:public b)]
   192	                                :key a
   193	                                :admission opts})]
   194	     {:src src
   195	      :node (:node w)
   196	      :pair (link/make-pair)
   197	      :adm adm
   198	      :interp (when (:admission src)
   199	                (admission/interpreter adm (:admission src)))
   200	      :now 0})))
