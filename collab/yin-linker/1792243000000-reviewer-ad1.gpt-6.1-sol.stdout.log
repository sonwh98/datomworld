   100	(defn- index!
   101	  "Publish the signed envelopes `signed` as one index through `node`,
   102	   load it, and step the node until it is loaded: the node."
   103	  [node signed]
   104	  (let [m (dht-test/publish-datoms!
   105	            node
   106	            (vec (map-indexed (fn [i {:keys [env proof]}]
   107	                                {:db/id (+ datom/first-user-id i)
   108	                                 :yin.module/envelope env
   109	                                 :yin.module/proof proof})
   110	                              signed)))
   111	        [node _] (dht/step (dht/load-index node m) 0)]
   112	    (is (= :loaded (:status (dht/load-status node m))))
   113	    node))
