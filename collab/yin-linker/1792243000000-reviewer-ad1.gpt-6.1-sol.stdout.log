#!/usr/bin/env python3
"""AD-1 mutation pass: one mutation per mechanism, red once, restored,
cmp-confirmed.  Run from the worktree root."""
import filecmp
import re
import shutil
import subprocess
import sys

LINK = "src/cljc/yin/repl/link.cljc"
ADM = "src/cljc/yin/repl/admission.cljc"
REPL = "src/cljc/yin/repl.cljc"
ENG = "src/cljc/yin/vm/engine.cljc"
T = "yin.repl.admission-test/"

MUTATIONS = [
    ("F1 retained address", LINK,
     "(dht-attempt node declared request (:yin.admit/address q))",
     "(dht-attempt node declared request (:address (linker.dht/resolve-name"
     " node declared (:yin.link/name request))))",
     [T + "an-allow-binds-the-address-the-question-was-asked-about-test"]),
    ("retire delimited prefix", LINK,
     "(str/starts-with? on (str child \".\"))",
     "(str/starts-with? on child)",
     [T + "retire-matches-the-run-s-interval-and-delimited-descendants-test"]),
    ("retire half-open lower bound", LINK,
     "(and (= o origin) (<= from k) (< k until))",
     "(and (= o origin) (< from k) (< k until))",
     [T + "retire-matches-the-run-s-interval-and-delimited-descendants-test"]),
    ("question append is progress", LINK,
     ":progress? (or progress? (true? asked?))",
     ":progress? progress?",
     [T + "a-trusted-asserter-is-allowed-over-the-question-it-was-asked-test"]),
    ("unconfigured refusal", LINK,
     """          (nil? admission)
          {:node node
           :body {:status :refused
                  :reason :yin.admit/unconfigured
                  :name name}}""",
     """          (nil? admission)
          {:node node, :body ::pending}""",
     [T + "a-dht-source-with-no-admission-state-refuses-unconfigured-test"]),
    ("drain persists its cursor", ADM,
     "(recur (keep-answer admission'",
     "(recur (keep-answer admission",
     [T + "the-drain-recovers-from-a-gap-at-the-earliest-retained-answer-test"]),
    ("exact admission id (stale serial)", ADM,
     "(= id (:yin.admit/id asked))",
     "true",
     [T + "answers-correlate-by-exact-admission-id-and-the-first-stands-test"]),
    ("first answer wins", ADM,
     "(not (contains? (:answers admission) id))",
     "true",
     [T + "answers-correlate-by-exact-admission-id-and-the-first-stands-test"]),
    ("non-empty conditions refuse", ADM,
     "(and (= :allow decision) (map? conditions) (empty? conditions)) nil",
     "(and (= :allow decision) (map? conditions)) nil",
     [T + "an-answer-the-composition-cannot-honor-refuses-test"]),
    ("malformed answer refuses", ADM,
     ":else {:yin.admit/reason :yin.admit/malformed-answer}",
     ":else nil",
     [T + "an-answer-the-composition-cannot-honor-refuses-test"]),
    ("verify receives the context", ADM,
     "(let [r ((:verify policy) (:snapshot interp) context question)]",
     "(let [r ((:verify policy) (:snapshot interp) {} question)]",
     [T + "verify-receives-the-snapshot-the-context-and-the-question-test"]),
    ("ended snapshot refuses", ADM,
     ":dao.stream/end (assoc interp :ended? true)",
     ":dao.stream/end interp",
     [T + "an-ended-decision-medium-refuses-with-no-load-started-test"]),
    ("absent snapshot answers nothing", ADM,
     "(if-not (or (:ended? interp) (:snapshot? interp))",
     "(if-not true",
     [T + "an-unanswered-question-survives-sixty-four-rounds-test"]),
    ("default verify: trusted asserter", ADM,
     "(when-not (some #(contains? decision %) asserters)",
     "(when-not true",
     [T + "an-untrusted-principal-is-refused-with-no-load-started-test"]),
    ("registry admission record", ENG,
     "(= :allow (:yin.admit/decision response))",
     "false",
     [T + "a-trusted-import-records-its-admission-on-every-vm-test"]),
    ("abandon retires the run", REPL,
     """               :link-pair (:pair retired)
               :admission (:admission retired)
               :pending-run nil)""",
     """               :pending-run nil)""",
     [T + "abandon-retires-the-run-and-the-pair-serves-on-test"]),
    ("carry-served restores admission", REPL,
     "(::admission d) (assoc :admission (::admission d))",
     "false (assoc :admission (::admission d))",
     [T + "an-install-error-keeps-the-admission-it-settled-test"]),
    ("drive continues on an answer", REPL,
     """          (if (or (:progress? served)
                  (:progress? admitted)
                  (:progress? answered))""",
     """          (if (or (:progress? served)
                  (:progress? answered))""",
     [T + "an-answer-alone-is-progress-and-the-drive-continues-test"]),
    ("hook re-checks only on a pending id", REPL,
     "(if (some #(contains? waiting %) (keys (:answers adm)))",
     "(if (some? (:pending-run state))",
     [T + "the-host-hook-drains-irrelevant-answers-without-a-re-check-test"]),
    ("hook persists the drained state", REPL,
     """          state (assoc state :admission adm)
          waiting""",
     """          waiting""",
     [T + "the-host-hook-drains-irrelevant-answers-without-a-re-check-test"]),
]


def run(vars_):
    args = ["clojure", "-M:test"]
    for v in vars_:
        args += ["-v", v]
    p = subprocess.run(args, capture_output=True, text=True, timeout=1200)
    out = p.stdout + p.stderr
    m = re.search(r"(\d+) failures, (\d+) errors", out)
    if not m:
        return None, out[-1500:]
    return int(m.group(1)) + int(m.group(2)), out


def main():
    only = set(sys.argv[1:])
    results = []
    for name, path, old, new, vars_ in MUTATIONS:
        if only and name not in only:
            continue
        backup = "target/ad1/mut.bak"
        shutil.copyfile(path, backup)
        src = open(path).read()
        n = src.count(old)
        if n != 1:
            results.append((name, "NOT APPLIED (%d matches)" % n))
            print(name, "NOT APPLIED", n, flush=True)
            continue
        try:
            open(path, "w").write(src.replace(old, new))
            bad, out = run(vars_)
        finally:
            shutil.copyfile(backup, path)
        same = filecmp.cmp(backup, path, shallow=False)
        verdict = ("RED (%s)" % bad) if bad else ("NOT RED: %s" % bad)
        line = "%s: %s; restored, cmp %s" % (name, verdict,
                                             "identical" if same else "DIFF")
        results.append((name, line))
        print(line, flush=True)
        if bad is None:
            print(out, flush=True)
    print("DONE", flush=True)


main()
