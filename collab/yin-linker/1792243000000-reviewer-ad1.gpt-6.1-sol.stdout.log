   257	(defn policy
   258	  "The interpreter's policy from a composition's `:admission` option:
   259	   `:own` the composition's own principals, `:trusted` an explicit set
   260	   of principal ids (`ed25519:<hex>`), `:verify` a verify function or a
   261	   sequence of them, and the decision snapshot: a static `:decision`, or
   262	   the newest value of a capacity-1 `:decision-medium`, or by default
   263	   the union of own and trusted principals."
   264	  [{:keys [own trusted verify decision decision-medium] :as opts}]
   265	  (let [principals (into (set own) trusted)]
   266	    (cond-> {:own (set own)
   267	             :trusted (set trusted)
   268	             :verify (composed verify)}
   269	      decision-medium (assoc :decision-medium decision-medium)
   270	      (contains? opts :decision) (assoc :decision decision)
   271	      (not (or decision-medium (contains? opts :decision)))
   272	      (assoc :decision principals))))
