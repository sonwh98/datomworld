   331	(deftest an-unanswered-question-survives-sixty-four-rounds-test
   332	  (let [w (world)
   333	        s (round (ask! (seam w {:decision-medium (capacity-1)}) [:t0 0]
   334	                       'own.m))
   335	        pending (get-in s [:served :pending])
   336	        asked (:asked (:adm s))
   337	        later (nth (iterate round s) 64)]
   338	    (testing "an absent snapshot answers nothing and reports no progress"
   339	      (is (= 0 (get-in s [:admitted :answered])))
   340	      (is (false? (get-in s [:admitted :progress?]))))
   341	    (testing "sixty-four rounds later: the same pending entry, one question,
   342	              no answer, no response, no progress, nothing loaded"
   343	      (is (= pending (get-in later [:served :pending])))
   344	      (is (= asked (:asked (:adm later))))
   345	      (is (= 1 (count (questions-of (:adm later)))))
   346	      (is (empty? (mesh/values (get-in later [:adm :pair :answers]))))
   347	      (is (empty? (responses later)))
   348	      (is (false? (get-in later [:served :progress?])))
   349	      (is (nil? (status (:node later) w 'own.m))))
