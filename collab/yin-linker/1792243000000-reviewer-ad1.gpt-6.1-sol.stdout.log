   563	;; The shell: a REPL whose link source is the node
   564	;; =============================================================================
   565	
   566	(defn- shell
   567	  "A REPL of `vm-type` over `w`'s node, holding A's key and declaring B,
   568	   composed with the creation options `opts`."
   569	  ([w vm-type] (shell w vm-type {}))
   570	  ([w vm-type opts]
   571	   (-> (repl.frontends/create-state (merge {:vm-type vm-type
   572	                                            :dht-key a
   573	                                            :principals [(:public b)]}
   574	                                           opts))
   575	       (assoc :dht (:node w))
   576	       (assoc-in [:link-source :content] {:kind :dht}))))
   577	
   578	
   579	(defn- type!
   580	  [state line]
   581	  (repl/eval-input state line))
   582	
   583	
   584	(defn- require!
   585	  [state n]
   586	  (type! state (str "(require (quote " n "))")))
   587	
   588	
   589	(defn- pending-admission
   590	  [state]
   591	  (some :admission (get-in state [:pending-run :links])))
   592	
   593	
   594	(defn- settle
   595	  "Step the node and re-check the pending run until `done?` holds or 40
   596	   re-checks pass: `[state text]`."
   597	  ([state] (settle state #(nil? (:pending-run %))))
   598	  ([state done?]
   599	   (loop [state state
   600	          text ""
   601	          i 0]
   602	     (if (or (done? state) (>= i 40))
   603	       [state text]
   604	       (let [[node _] (dht/step (:dht state) (* 10 i))
   605	             [state t] (repl/recheck-pending (assoc state :dht node))]
   606	         (recur state (str text t) (inc i)))))))
   607	
   608	
   609	(defn- answer-at!
   610	  "Append `answer` to the shell's answer medium, as an external
   611	   interpreter."
   612	  [state answer]
   613	  (stream/append! (get-in state [:admission :pair :answers]) answer)
   614	  state)
   615	
   616	
   617	(defn- shell-responses
   618	  [state]
   619	  (mesh/values (get-in state [:link-pair :responses])))
   620	
   621	
   622	(defn- entry
   623	  [state n]
   624	  (module/module-entry (:modules (:modules (:vm state))) n))
