   627	(defn- preload
   628	  "The shell with `n`'s closure loaded on its node, so an allow links at
   629	   once."
   630	  [state w n]
   631	  (loop [node (ld/load-module (:dht state) (address w n))
   632	         i 0]
   633	    (if (or (= :loaded (:status (ld/module-status node (address w n))))
   634	            (> i 40))
   635	      (assoc state :dht node)
   636	      (recur (first (dht/step node (* 10 i))) (inc i)))))
