     1	(ns yin.repl.admission
     2	  "The admission pair (yin.vm.linker.dht.md section 7.5): the trust
     3	   question a DHT link source asks before it loads a name another
     4	   principal asserts, and the interpreter that answers it.
     5	
     6	   Two ring media sit beside the link pair.  The composition appends a
     7	   question -- plain data bound to the resolution it was asked about,
     8	   carrying no session and no subject -- to the question medium and
     9	   parks the link; one interpreter reads the questions and appends one
    10	   answer each to the answer medium; the composition drains the answers
    11	   with a persisted cursor and keeps those that match a question it
    12	   still holds.  Neither side calls the other: each knows only the two
    13	   media.
    14	
    15	   The composition's half is a value, `make-state`: the pair, the
    16	   questions it has asked keyed by link id, the matching answers it has
    17	   drained keyed by admission id `[link-id serial]`, and the serial it
    18	   mints the next id from, never reused.  The interpreter's half is
    19	   another value, `interpreter`: its question cursor and the decision
    20	   snapshot it last read.  No clock, no atom, no global: every outcome
    21	   is plain data, and every read persists its cursor.
    22	
    23	   The interpreter answers with `(verify decision context question)`,
    24	   the ShiBi verify signature (dao.shibi.md): nil allows, a reason map
    25	   refuses.  The default policy's decision is the composition's own
    26	   principals and an explicit trusted set; it allows a question one of
    27	   whose asserters is in it.  Trust is not safety: the linker checks
    28	   closure origin, store ownership and dependency pins whatever the
    29	   answer says, and conditions must be empty."
    30	  (:require [dao.stream :as stream]
    31	            [dao.stream.ringbuffer :as ring]
    32	            [yin.vm.linker.sign :as sign]))
    33	
    34	
    35	(def reasons
    36	  "Every reason the admission seam refuses with: the default policy's,
    37	   the composition's fail-closed refusals of an answer it cannot honor,
    38	   and the refusal of a DHT source composed with no admission state."
    39	  #{:yin.admit/untrusted-principal
    40	    :yin.admit/decision-ended
    41	    :yin.admit/malformed-answer
    42	    :yin.admit/unsupported-condition
    43	    :yin.admit/unconfigured})
    44	
    45	
    46	(defn- medium
    47	  [capacity]
    48	  (:dao.stream/handle
    49	    (ring/create! {:dao.stream/type ring/transport-type
    50	                   ring/capacity-key capacity})))
    51	
    52	
    53	(defn- oldest
    54	  [handle]
    55	  (:dao.stream/cursor (stream/cursor handle stream/anchor-oldest)))
    56	
    57	
    58	(defn- ok?
    59	  [r]
    60	  (= :dao.stream/ok (:dao.stream/outcome r)))
    61	
    62	
    63	;; =============================================================================
    64	;; The composition's half
    65	;; =============================================================================
    66	
    67	(defn make-state
    68	  "The composition's admission state over a fresh pair of `capacity`
    69	   elements each: the question and answer media, the answer cursor
    70	   minted at the answer medium's oldest end before any answer exists,
    71	   nothing asked, nothing answered, serial 0.  An unread answer is
    72	   evicted when the unread backlog exceeds `capacity`: the host bounds
    73	   that backlog by its production rate and drain cadence, and an
    74	   evicted answer's question stays open until its request is retired."
    75	  [capacity]
    76	  (let [questions (medium capacity)
    77	        answers (medium capacity)]
    78	    {:pair {:questions questions
    79	            :answers answers
    80	            :cursor (oldest answers)}
    81	     :asked {}
    82	     :answers {}
    83	     :serial 0}))
    84	
    85	
    86	(defn- answer-link-id
    87	  "The link id component of answer `a`'s admission id, or nil when the
    88	   answer carries no `[link-id serial]`."
    89	  [a]
    90	  (let [id (when (map? a) (:yin.admit/id a))]
    91	    (when (and (vector? id) (= 2 (count id)))
    92	      (first id))))
    93	
    94	
    95	(defn- keep-answer
    96	  "`admission` with answer `a` retained when its id is exactly the id of
    97	   the question asked for its link id and no answer is held for it yet:
    98	   the first answer wins, and a duplicate, a stale serial, or an answer
    99	   for an unknown or retired id correlates to nothing and is dropped."
   100	  [admission a]
   101	  (let [id (:yin.admit/id a)
   102	        asked (get-in admission [:asked (answer-link-id a)])]
   103	    (if (and (some? asked)
   104	             (= id (:yin.admit/id asked))
   105	             (not (contains? (:answers admission) id)))
   106	      (assoc-in admission [:answers id] a)
   107	      admission)))
   108	
   109	
   110	(defn drain
   111	  "Consume at most `budget` elements of the answer medium from the
   112	   composition's persisted cursor, keeping the answers that match a
   113	   question still asked (`keep-answer`), and answer the successor state
   114	   with the cursor past everything read.  A gap adopts the recovery
   115	   cursor the transport answers -- the earliest retained position,
   116	   never an evicted one -- and continues within the budget; blocked or
   117	   end stops.  The same function serves a link round and the host's
   118	   recheck hook."
   119	  [admission budget]
   120	  (let [answers (get-in admission [:pair :answers])]
   121	    (loop [admission admission
   122	           left budget]
   123	      (if (<= left 0)
   124	        admission
   125	        (let [r (stream/next answers (get-in admission [:pair :cursor]))
   126	              admission' (assoc-in admission [:pair :cursor]
   127	                                   (:dao.stream/cursor r))]
   128	          (case (:dao.stream/outcome r)
   129	            :dao.stream/ok (recur (keep-answer admission'
   130	                                               (:dao.stream/value r))
   131	                                  (dec left))
   132	            :dao.stream/gap (recur admission' (dec left))
   133	            admission))))))
