   666	       "while (Atomics.load(flags, 0) === 0) Atomics.wait(flags, 0, 0, 100);\n"
   667	       "let held = null;\n"
   668	       "for (let i = 0; i < 50 && held === null; i++) {\n"
   669	       "  try { held = fsns.lock_BANG_(dir); }\n"
   670	       "  catch (e) { Atomics.wait(pause, 0, 0, Math.floor(Math.random() * 20)); }\n"
