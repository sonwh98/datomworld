{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/main.cljc | sed -n '90,450p'; nl -ba src/cljc/yin/repl/store.cljc\"","aggregated_output":"    90\t  \"A `--dht-manifest` value — the address as printed, with or without its\n    91\t   leading colon — as the segment address keyword.\"\n    92\t  [text]\n    93\t  (when (string? text)\n    94\t    (keyword (if (str/starts-with? text \":\") (subs text 1) text))))\n    95\t\n    96\t\n    97\t(def ^:private dht-flags\n    98\t  #{\"--dht-peer\" \"--dht-publish\" \"--dht-bind\" \"--dht-port\"\n    99\t    \"--dht-max-inbound-bytes\" \"--dht-manifest\" \"--dht-key\" \"--dht-principal\"})\n   100\t\n   101\t\n   102\t(defn parse-principal\n   103\t  \"A `--dht-principal` value: a declared publisher's public key, exactly\n   104\t   64 lowercase hexadecimal characters (yin.vm.linker.dht.md 6.2).\"\n   105\t  [text]\n   106\t  (if (and (string? text) (re-matches #\"^[0-9a-f]{64}$\" text))\n   107\t    text\n   108\t    (throw (ex-info (str \"--dht-principal takes a public key of 64 lowercase \"\n   109\t                         \"hexadecimal characters, not \" (pr-str text))\n   110\t                    {:value text}))))\n   111\t\n   112\t\n   113\t;; =============================================================================\n   114\t;; The publisher's key file (yin.vm.linker.dht.md 6.5)\n   115\t;; =============================================================================\n   116\t\n   117\t(defn- split-path\n   118\t  \"`[dir name]` of a file path.\"\n   119\t  [path]\n   120\t  (if-let [i (str/last-index-of path \"/\")]\n   121\t    [(subs path 0 i) (subs path (inc i))]\n   122\t    [\".\" path]))\n   123\t\n   124\t\n   125\t(defn load-key\n   126\t  \"The publisher key `{:seed :public}` the key file at `path` holds, or a\n   127\t   refusal of startup with the reason: a file that does not exist, or one\n   128\t   `yin.vm.linker.sign/key-from-text` refuses.  Nothing falls back to a\n   129\t   fresh key, and no refusal carries the file's content.\"\n   130\t  [path]\n   131\t  (let [[dir name] (split-path path)\n   132\t        text (fs/read-file-text dir name)\n   133\t        key (when text (sign/key-from-text text))]\n   134\t    (cond\n   135\t      (nil? text)\n   136\t      (throw (ex-info (str \"--dht-key \" path \": the key file does not exist; \"\n   137\t                           \"nothing falls back to a fresh key (create one with \"\n   138\t                           \"--dht-keygen \" path \")\")\n   139\t                      {:path path}))\n   140\t\n   141\t      (= :refused (:status key))\n   142\t      (throw (ex-info (str \"--dht-key \" path \": the key file is refused (\"\n   143\t                           (:reason key) \")\")\n   144\t                      {:path path :reason (:reason key)}))\n   145\t\n   146\t      :else key)))\n   147\t\n   148\t\n   149\t(defn- write-new-file!\n   150\t  \"Create `path` holding `text`, readable by its owner only where the host\n   151\t   can set that, refusing an existing file: a key file is never\n   152\t   overwritten.\"\n   153\t  [path text]\n   154\t  (let [exists (fn []\n   155\t                 (ex-info (str \"--dht-keygen \" path \": the file exists; \"\n   156\t                               \"a key file is never overwritten\")\n   157\t                          {:path path}))]\n   158\t    #?(:cljd (let [f (io/File. path)]\n   159\t               (when (.existsSync f) (throw (exists)))\n   160\t               (try (.createSync f .exclusive true)\n   161\t                    (catch Object _ (throw (exists))))\n   162\t               (.writeAsStringSync f text))\n   163\t       :clj (let [p (.toPath (java.io.File. ^String path))\n   164\t                  owner-only (java.nio.file.attribute.PosixFilePermissions/asFileAttribute\n   165\t                               (java.nio.file.attribute.PosixFilePermissions/fromString\n   166\t                                 \"rw-------\"))]\n   167\t              (try\n   168\t                (try (java.nio.file.Files/createFile\n   169\t                       p (into-array java.nio.file.attribute.FileAttribute\n   170\t                                     [owner-only]))\n   171\t                     (catch UnsupportedOperationException _\n   172\t                       (java.nio.file.Files/createFile\n   173\t                         p (make-array java.nio.file.attribute.FileAttribute 0))))\n   174\t                (catch java.nio.file.FileAlreadyExistsException _\n   175\t                  (throw (exists))))\n   176\t              (spit path text))\n   177\t       :cljs (let [fs-module (js/require \"fs\")]\n   178\t               (try (.writeFileSync fs-module path text #js {:flag \"wx\" :mode 384})\n   179\t                    (catch :default e\n   180\t                      (if (= \"EEXIST\" (.-code e))\n   181\t                        (throw (exists))\n   182\t                        (throw (ex-info (str \"--dht-keygen \" path \": \" (.-message e))\n   183\t                                        {:path path})))))))))\n   184\t\n   185\t\n   186\t(defn keygen!\n   187\t  \"Write a new key, from the host CSPRNG, to a new key file at `path`\n   188\t   (`--dht-keygen`), and answer the lines to print and the exit status.\n   189\t   The seed is never printed.\"\n   190\t  [path]\n   191\t  (let [key (sign/generate)]\n   192\t    (write-new-file! path (str (sign/key-text key) \"\\n\"))\n   193\t    {:lines (cond-> [(str \"dht: wrote a new Ed25519 key to \" path \"; its principal is \"\n   194\t                          (sign/principal (:public key)) \". Keep the file: a lost key \"\n   195\t                          \"can never sign again, and a new key is a new principal.\")]\n   196\t              ;; dart:io sets no file permissions (yin.vm.linker.dht.md 6.5)\n   197\t              #?(:cljd true :default false)\n   198\t              (conj (str \"dht: WARNING: this host cannot restrict the key file's \"\n   199\t                         \"permissions; it is readable as the process umask allows. \"\n   200\t                         \"Restrict it now: chmod 600 \" path)))\n   201\t     :exit 0}))\n   202\t\n   203\t\n   204\t(defn- dht-spec\n   205\t  \"Fold the `--dht-*` flags into the `dht:<dir>` spec, checked by\n   206\t   `yin.repl.store/checked-spec`.  They mean nothing to any other store,\n   207\t   and a bind address means nothing to a solo node, so each such use is\n   208\t   refused rather than ignored.\"\n   209\t  [spec {:keys [flags peers publish? bind-host bind-port max-inbound-bytes\n   210\t                manifest]}]\n   211\t  (cond\n   212\t    (and (seq flags) (not= :dht (:type spec)))\n   213\t    (throw (ex-info (str (str/join \", \" (sort flags))\n   214\t                         \" need --index-store dht:<dir>\")\n   215\t                    {:flags (vec (sort flags))}))\n   216\t\n   217\t    (not= :dht (:type spec)) spec\n   218\t\n   219\t    (and (empty? peers) (or bind-host bind-port))\n   220\t    (throw (ex-info (str \"--dht-bind and --dht-port need a --dht-peer: \"\n   221\t                         \"with no peers the DHT store is solo and opens \"\n   222\t                         \"no socket\")\n   223\t                    {}))\n   224\t\n   225\t    (and bind-host (not (datagram/ip-literal? bind-host)))\n   226\t    (throw (ex-info (str \"--dht-bind must be an IP literal, not \"\n   227\t                         (pr-str bind-host))\n   228\t                    {:value bind-host}))\n   229\t\n   230\t    :else\n   231\t    (store/checked-spec\n   232\t      (cond-> (assoc spec :peers (vec peers) :publish? (boolean publish?))\n   233\t        bind-host (assoc :bind-host bind-host)\n   234\t        bind-port (assoc :bind-port bind-port)\n   235\t        max-inbound-bytes (assoc :max-inbound-bytes max-inbound-bytes)\n   236\t        manifest (assoc :manifest manifest)))))\n   237\t\n   238\t\n   239\t(defn- dht-number\n   240\t  [flag text]\n   241\t  (or (parse-int text)\n   242\t      (throw (ex-info (str flag \" takes an integer, not \" (pr-str text))\n   243\t                      {:value text}))))\n   244\t\n   245\t\n   246\t(defn parse-args\n   247\t  \"Parse the host arguments.  `--telemetry` and `--telemetry-stream` are\n   248\t   rejected rather than ignored.  `--index-store` is parsed into\n   249\t   `:index-store-spec` — `:mem` (also what omission means),\n   250\t   `{:type :file :dir dir}`, or the DHT store `{:type :dht :dir dir ...}`\n   251\t   — and a missing value, an unknown scheme, or an empty directory is\n   252\t   refused here, by `yin.repl.store/parse-arg`, before any host composes.\n   253\t\n   254\t   The DHT store's options are their own flags (yin.repl.dht):\n   255\t   `--dht-peer host:port`, repeatable, the bootstrap contacts — none\n   256\t   means solo, with no socket; `--dht-publish`, the separate declaration\n   257\t   that shares the store; `--dht-bind ip` and `--dht-port p`, the\n   258\t   socket's address, loopback and ephemeral unless given;\n   259\t   `--dht-max-inbound-bytes n`, the inbound storage bound; and\n   260\t   `--dht-manifest address`, a remote index to hydrate before the first\n   261\t   evaluation; `--dht-key file`, the publisher's stable key file\n   262\t   (yin.vm.linker.dht.md 6.5); and `--dht-principal hex`, repeatable, a\n   263\t   publisher whose signed names this node honors (7.1).  Any of them\n   264\t   without `dht:<dir>` is refused.  `--dht-keygen file` writes a new key\n   265\t   file and exits.\"\n   266\t  [args]\n   267\t  (loop [args (seq args)\n   268\t         opts {:headless? false :host nil :port nil :rejected []\n   269\t               :index-store-spec :mem}\n   270\t         dht {:flags #{} :peers []}]\n   271\t    (if-let [arg (first args)]\n   272\t      (let [dht (cond-> dht (dht-flags arg) (update :flags conj arg))\n   273\t            value (second args)]\n   274\t        (case arg\n   275\t          \"--port\" (recur (nnext args)\n   276\t                          (assoc opts :port (when-let [p (second args)]\n   277\t                                              #?(:cljd (int/parse p)\n   278\t                                                 :cljs (js/parseInt p 10)\n   279\t                                                 :clj (Long/parseLong p))))\n   280\t                          dht)\n   281\t          \"--host\" (recur (nnext args) (assoc opts :host (second args)) dht)\n   282\t          \"--headless\" (recur (next args) (assoc opts :headless? true) dht)\n   283\t          \"--index-store\" (recur (nnext args)\n   284\t                                 (assoc opts\n   285\t                                        :index-store-spec\n   286\t                                        (store/parse-arg (second args)))\n   287\t                                 dht)\n   288\t          \"--dht-peer\" (recur (nnext args) opts\n   289\t                              (update dht :peers conj (parse-peer value)))\n   290\t          \"--dht-publish\" (recur (next args) opts (assoc dht :publish? true))\n   291\t          \"--dht-bind\" (recur (nnext args) opts\n   292\t                              (assoc dht :bind-host (str value)))\n   293\t          \"--dht-port\" (recur (nnext args) opts\n   294\t                              (assoc dht :bind-port (dht-number arg value)))\n   295\t          \"--dht-max-inbound-bytes\" (recur (nnext args) opts\n   296\t                                           (assoc dht :max-inbound-bytes\n   297\t                                                  (dht-number arg value)))\n   298\t          \"--dht-manifest\" (recur (nnext args) opts\n   299\t                                  (assoc dht :manifest (parse-manifest value)))\n   300\t          \"--dht-key\" (recur (nnext args)\n   301\t                             (assoc opts :dht-key-file\n   302\t                                    (or value\n   303\t                                        (throw (ex-info \"--dht-key needs a key file\"\n   304\t                                                        {}))))\n   305\t                             dht)\n   306\t          \"--dht-principal\" (recur (nnext args)\n   307\t                                   (update opts :principals (fnil conj [])\n   308\t                                           (parse-principal value))\n   309\t                                   dht)\n   310\t          \"--dht-keygen\" (recur (nnext args)\n   311\t                                (assoc opts :dht-keygen\n   312\t                                       (or value\n   313\t                                           (throw (ex-info \"--dht-keygen needs a file\"\n   314\t                                                           {}))))\n   315\t                                dht)\n   316\t          \"--telemetry\" (recur (next args) (update opts :rejected conj arg) dht)\n   317\t          \"--telemetry-stream\" (recur (nnext args)\n   318\t                                      (update opts :rejected conj arg) dht)\n   319\t          (recur (next args) (update opts :extra (fnil conj []) arg) dht)))\n   320\t      (update opts :index-store-spec dht-spec dht))))\n   321\t\n   322\t\n   323\t(defn boot\n   324\t  \"Create the composition: one shell, one input medium, one cursor held only by\n   325\t   the step owner, and the host WebSocket adapter `(connect …)` attaches\n   326\t   through.  The parsed `:index-store-spec` reaches the shell's store\n   327\t   selection, which resolves and opens it once at construction.\"\n   328\t  ([] (boot {}))\n   329\t  ([opts] (driver/create-state\n   330\t            {:host (or (:adapter opts) (host/websocket))\n   331\t             :repl (shell/create-state {:index-store-spec\n   332\t                                        (:index-store-spec opts)\n   333\t                                        :dht-key (:dht-key opts)\n   334\t                                        :principals (:principals opts)})})))\n   335\t\n   336\t\n   337\t(defn boot-server\n   338\t  \"Compose the served endpoint for `--port`, or nil when no port was asked for.\n   339\t\n   340\t   `serve!` returns immediately.  Whether a listener bound is a fact the\n   341\t   endpoint's lifecycle medium reports, and the ticker prints it.\"\n   342\t  [opts]\n   343\t  (when (:port opts)\n   344\t    (serve/serve! {:bind-port (:port opts)\n   345\t                   :bind-host (or (:host opts) serve/default-bind-host)\n   346\t                   :host (or (:adapter opts) (host/websocket))})))\n   347\t\n   348\t\n   349\t(defn startup\n   350\t  \"Parse the arguments and compose the whole shell — the store the parsed\n   351\t   `:index-store-spec` names included — or answer the refusal text.  This\n   352\t   is the one gate every host's `-main` passes through before it prints a\n   353\t   banner or starts a loop, so an invalid `--index-store`, an unsupported\n   354\t   host for it, or a directory that cannot be opened refuses startup with\n   355\t   its reason rather than composing a shell around a fallback store.\n   356\t\n   357\t   Only a designed refusal is answered: an error carrying no ex-info\n   358\t   keeps its stack trace, because it is a defect, not an operator error.\n   359\t\n   360\t   `--dht-keygen` composes nothing: it writes the key file and answers\n   361\t   `{:lines [...] :exit 0}` for the host to print and exit with.  A\n   362\t   `--dht-key` file is loaded here (`load-key`); the key reaches the\n   363\t   shell, and only its principal reaches the options the banner reads.\"\n   364\t  [args]\n   365\t  (try\n   366\t    (let [opts (parse-args args)]\n   367\t      (if-some [path (:dht-keygen opts)]\n   368\t        (keygen! path)\n   369\t        (let [key (some-> (:dht-key-file opts) load-key)\n   370\t              opts (cond-> opts\n   371\t                     key (assoc :publisher (sign/principal (:public key))))]\n   372\t          {:opts opts\n   373\t           :state (boot (assoc opts :dht-key key))\n   374\t           :server (boot-server opts)})))\n   375\t    (catch #?(:cljd Object\n   376\t              :clj Throwable\n   377\t              :cljs :default)\n   378\t           e\n   379\t      (if (ex-data e)\n   380\t        {:refusal (or (ex-message e) (str e))}\n   381\t        (throw e)))))\n   382\t\n   383\t\n   384\t(defn- refuse!\n   385\t  \"Print why the composition refused to start and end the process with a\n   386\t   failing status, so a refused startup never looks like a working shell.\"\n   387\t  [refusal]\n   388\t  (println refusal)\n   389\t  #?(:cljd (io/exit 1)\n   390\t     :clj (.halt (Runtime/getRuntime) 1)\n   391\t     :cljs (.exit js/process 1)))\n   392\t\n   393\t\n   394\t(defn close-index-store!\n   395\t  \"Release the index store's lifecycle resources before the host exits —\n   396\t   in durable mode, the exclusive directory lock.  The shell has already\n   397\t   stopped when a host calls this; the memory store has nothing to\n   398\t   release.\"\n   399\t  [state]\n   400\t  (store/close! (get-in state [:repl :index-store])))\n   401\t\n   402\t\n   403\t(defn- entry-text\n   404\t  [entry]\n   405\t  (or (get entry driver/text-key) (get entry serve/text-key)))\n   406\t\n   407\t\n   408\t(defn banner\n   409\t  \"Text the composition prints before the first prompt, given parsed\n   410\t   options.  A DHT store states here — before its node steps once, so\n   411\t   before anything is shared — what it will share: the whole store when\n   412\t   `--dht-publish` is given, nothing otherwise (yin.repl.dht/banner).\"\n   413\t  [opts]\n   414\t  (let [spec (:index-store-spec opts)\n   415\t        dht? (= :dht (:type spec))]\n   416\t    (cond-> []\n   417\t      (seq (:rejected opts)) (conj telemetry-text)\n   418\t      (and (:headless? opts) (not (:port opts)))\n   419\t      (conj \"--headless has nothing to attend without a served endpoint\")\n   420\t      dht? (into (repl.dht/banner spec))\n   421\t      (and dht? (:publish? spec))\n   422\t      (conj (str \"dht: the code index and the code itself are shared: every\"\n   423\t                 \" evaluated program's rows are written to the index store\"\n   424\t                 \" each round\"))\n   425\t      (and dht? (:publisher opts))\n   426\t      (conj (str \"dht: names published here are signed by principal \"\n   427\t                 (:publisher opts) \" (key from \" (:dht-key-file opts) \")\"))\n   428\t      (and dht? (not (:publisher opts)))\n   429\t      (conj (str \"dht: no --dht-key: (yin.link/publish ...) is refused; names\"\n   430\t                 \" are still read, resolved, loaded and linked\")))))\n   431\t\n   432\t\n   433\t(defn- exit-with!\n   434\t  \"Print a composition that ends at startup -- `--dht-keygen` -- and end\n   435\t   the process with its status.\"\n   436\t  [{:keys [lines exit]}]\n   437\t  (doseq [line lines]\n   438\t    (println line))\n   439\t  #?(:cljd (io/exit exit)\n   440\t     :clj (.halt (Runtime/getRuntime) (int exit))\n   441\t     :cljs (.exit js/process exit)))\n   442\t\n   443\t\n   444\t(defn step-all\n   445\t  \"One tick of the single step owner: the local shell first, then the served\n   446\t   endpoint — against the same shell value.  A DHT index store's node is stepped\n   447\t   first (yin.repl.dht/step): its lines print before the shell's, a\n   448\t   hydration still outstanding leaves every typed line waiting in the\n   449\t   input medium, and a refused one stops the shell.  A `--port` process\n   450\t   serves one shared shell, as v1's atom made it: the driver evaluates this tick's local\n     1\t(ns yin.repl.store\n     2\t  \"Startup selection of the code index's store\n     3\t   (docs/design/yin.repl.dao.space-index.md; the durable-store startup\n     4\t   contract, slices 1-3, and the DHT store of epic S5).\n     5\t\n     6\t   The store is chosen once, before the shell composes: `mem` — a fresh\n     7\t   in-memory `dao.jing` store, today's behaviour — `file:<dir>`, the\n     8\t   durable directory store (dao.space.store), or `dht:<dir>`, that store\n     9\t   with a DHT node composed over it (yin.repl.dht).  This namespace parses\n    10\t   the `--index-store` value, validates the `:index-store-spec` an\n    11\t   embedder may hand `yin.repl/create-state`, and opens the store the\n    12\t   resolved spec names.  Every bad spec — a missing value, an unknown\n    13\t   scheme, an empty directory, a directory that cannot be opened, a host\n    14\t   build without file support — is refused with its reason; nothing falls\n    15\t   back to memory silently.\n    16\t\n    17\t   The durable directory itself — the exclusive lock, HEAD, the validated\n    18\t   snapshot, `:recovery` — is dao.space.store's; this namespace is one of\n    19\t   its consumers.  The shell installs the recovery before it admits any\n    20\t   evaluation (`yin.repl.index/rehydrate`), and a durable store\n    21\t   (`durable?`) also carries the index across `(reset)` and VM\n    22\t   selection; the memory store keeps today's empty rebuild.\"\n    23\t  (:require [clojure.string :as str]\n    24\t            [dao.jing :as jing]\n    25\t            [dao.jing.mem :as jing.mem]\n    26\t            [dao.space.store :as durable]\n    27\t            [dao.stream.datagram :as datagram]))\n    28\t\n    29\t\n    30\t(def file-scheme\n    31\t  \"The `--index-store` scheme prefix naming a durable file store.\"\n    32\t  \"file:\")\n    33\t\n    34\t\n    35\t(def dht-scheme\n    36\t  \"The `--index-store` scheme prefix naming the DHT store: the durable\n    37\t   directory store of `file:<dir>` composed under a `dao.jing.dht` node\n    38\t   (yin.repl.dht).\"\n    39\t  \"dht:\")\n    40\t\n    41\t\n    42\t(def ^:private supported-args\n    43\t  [\"mem\" (str file-scheme \"<dir>\") (str dht-scheme \"<dir>\")])\n    44\t\n    45\t\n    46\t(defn parse-arg\n    47\t  \"The `--index-store` value as a spec: `:mem`, or `{:type :file :dir dir}`\n    48\t   for `file:<dir>`.  A missing value, an unknown scheme, and an empty\n    49\t   directory are refused here — with the supported forms named — so the\n    50\t   arguments parser can refuse a bad flag before anything composes.\"\n    51\t  [value]\n    52\t  (cond\n    53\t    (nil? value)\n    54\t    (throw (ex-info \"--index-store needs a value: mem, file:<dir> or dht:<dir>\"\n    55\t                    {:supported supported-args}))\n    56\t\n    57\t    (= value \"mem\")\n    58\t    :mem\n    59\t\n    60\t    (str/starts-with? value file-scheme)\n    61\t    (let [dir (subs value (count file-scheme))]\n    62\t      (if (str/blank? dir)\n    63\t        (throw (ex-info \"--index-store file:<dir> needs a directory\"\n    64\t                        {:value value\n    65\t                         :supported supported-args}))\n    66\t        {:type :file :dir dir}))\n    67\t\n    68\t    (str/starts-with? value dht-scheme)\n    69\t    (let [dir (subs value (count dht-scheme))]\n    70\t      (if (str/blank? dir)\n    71\t        (throw (ex-info \"--index-store dht:<dir> needs a directory\"\n    72\t                        {:value value\n    73\t                         :supported supported-args}))\n    74\t        {:type :dht :dir dir}))\n    75\t\n    76\t    :else\n    77\t    (throw (ex-info (str \"Unknown --index-store \" (pr-str value)\n    78\t                         \"; supported: mem, file:<dir>, dht:<dir>\")\n    79\t                    {:value value\n    80\t                     :supported supported-args}))))\n    81\t\n    82\t\n    83\t(defn- dht-refusal\n    84\t  \"Why a `{:type :dht ...}` spec is not a DHT store composition, or nil.\n    85\t   A spec with no peers is solo: it opens no socket, so a manifest to\n    86\t   fetch has nothing to fetch through and is refused rather than\n    87\t   ignored.\"\n    88\t  [{:keys [dir peers publish? bind-host bind-port max-inbound-bytes manifest\n    89\t           bind!]}]\n    90\t  (cond\n    91\t    (not (and (string? dir) (not (str/blank? dir))))\n    92\t    \"--index-store dht:<dir> needs a directory\"\n    93\t\n    94\t    (not (and (vector? peers)\n    95\t              (every? #(and (map? %)\n    96\t                            (datagram/ip-literal? (:host %))\n    97\t                            (datagram/valid-port? (:port %)))\n    98\t                      peers)))\n    99\t    \"DHT peers must be {:host <IP literal> :port <1 to 65535>}\"\n   100\t\n   101\t    (not (boolean? publish?))\n   102\t    \"the DHT publication declaration must be true or false\"\n   103\t\n   104\t    (not (datagram/ip-literal? bind-host))\n   105\t    \"the DHT bind host must be an IP literal\"\n   106\t\n   107\t    (not (and (integer? bind-port) (<= 0 bind-port 65535)))\n   108\t    \"the DHT bind port must be 0 (ephemeral) or 1 to 65535\"\n   109\t\n   110\t    (not (and (integer? max-inbound-bytes) (<= 0 max-inbound-bytes)))\n   111\t    \"--dht-max-inbound-bytes must be a nonnegative integer\"\n   112\t\n   113\t    (and (empty? peers) (some? manifest))\n   114\t    (str \"--dht-manifest needs a --dht-peer to fetch from: with no peers \"\n   115\t         \"the DHT store is solo and opens no socket\")\n   116\t\n   117\t    (not (or (nil? manifest) (jing/segment-address? manifest)))\n   118\t    \"--dht-manifest must be a segment manifest address\"\n   119\t\n   120\t    (not (or (nil? bind!) (fn? bind!)))\n   121\t    \":bind! must be a dao.stream.datagram host seam function\"))\n   122\t\n   123\t\n   124\t(def default-max-inbound-bytes\n   125\t  \"The CLI default of the DHT store's inbound storage bound\n   126\t   (`:dao.jing.dht/max-inbound-bytes`): 64 MiB of payload a publishing\n   127\t   node accepts from peers' `:store` requests before it refuses them\n   128\t   explicitly.  `--dht-max-inbound-bytes` overrides it.\"\n   129\t  (* 64 1024 1024))\n   130\t\n   131\t\n   132\t(def dht-defaults\n   133\t  \"The DHT store spec's defaults: solo (no peers), publishing off, bound\n   134\t   to loopback on an ephemeral port, the default inbound bound, and no\n   135\t   manifest to hydrate.\"\n   136\t  {:peers []\n   137\t   :publish? false\n   138\t   :bind-host \"127.0.0.1\"\n   139\t   :bind-port 0\n   140\t   :max-inbound-bytes default-max-inbound-bytes\n   141\t   :manifest nil})\n   142\t\n   143\t\n   144\t(defn checked-spec\n   145\t  \"Validate an `:index-store-spec` as `yin.repl/create-state` receives it:\n   146\t   nil means the `mem` default, `:mem` names it, and a file store is the\n   147\t   map `{:type :file :dir dir}` with a non-empty directory string.  A DHT\n   148\t   store is `{:type :dht :dir dir}` plus its options, `dht-defaults`\n   149\t   filled in; see yin.repl.dht.  Anything else is refused with the\n   150\t   supported forms named.\"\n   151\t  [spec]\n   152\t  (cond\n   153\t    (nil? spec) :mem\n   154\t    (= :mem spec) :mem\n   155\t    (and (map? spec)\n   156\t         (= :file (:type spec))\n   157\t         (string? (:dir spec))\n   158\t         (not (str/blank? (:dir spec))))\n   159\t    spec\n   160\t\n   161\t    (and (map? spec) (= :dht (:type spec)))\n   162\t    (let [spec (merge dht-defaults spec)]\n   163\t      (if-some [refusal (dht-refusal spec)]\n   164\t        (throw (ex-info refusal {:spec (dissoc spec :bind!)}))\n   165\t        spec))\n   166\t\n   167\t    :else\n   168\t    (throw (ex-info (str \"Unknown :index-store-spec \" (pr-str spec)\n   169\t                         \"; supported: :mem, {:type :file :dir <dir>}, \"\n   170\t                         \"{:type :dht :dir <dir> ...}\")\n   171\t                    {:spec spec\n   172\t                     :supported [:mem {:type :file :dir \"<dir>\"}\n   173\t                                 {:type :dht :dir \"<dir>\"}]}))))\n   174\t\n   175\t\n   176\t(defn open\n   177\t  \"Open the store `spec` names and keep it plain: `:mem` (or nil) is a\n   178\t   fresh in-memory `dao.jing` store; `{:type :file :dir dir}` is the\n   179\t   durable directory store at `dir` (dao.space.store/open): exclusive,\n   180\t   validating, its HEAD writer, recovery and lock on the handle.  A spec\n   181\t   this build cannot open is refused with its reason; a `dht:<dir>` spec\n   182\t   is opened by yin.repl.dht, which composes its node over the same\n   183\t   durable store.\"\n   184\t  [spec]\n   185\t  (let [checked (checked-spec spec)]\n   186\t    (case (if (map? checked) (:type checked) checked)\n   187\t      :mem (jing.mem/create-content-mem)\n   188\t      :file (durable/open (:dir checked))\n   189\t      :dht (throw (ex-info (str \"a dht:<dir> store is opened by \"\n   190\t                                \"yin.repl.dht/open, which composes its node\")\n   191\t                           {:spec (dissoc checked :bind!)})))))\n   192\t\n   193\t\n   194\t(defn durable?\n   195\t  \"True when `store` is a durable directory store: its published index\n   196\t   outlives the process, so a session rebuild continues it rather than\n   197\t   starting an empty one (dao.space.store/durable?).\"\n   198\t  [store]\n   199\t  (durable/durable? store))\n   200\t\n   201\t\n   202\t(defn close!\n   203\t  \"Release the store's lifecycle resources (dao.space.store/close!): the\n   204\t   content log and, in durable mode, the directory lock.  Idempotent.\"\n   205\t  [store]\n   206\t  (durable/close! store))\n","exit_code":0,"status":"completed"}}
