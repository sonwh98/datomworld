it holds\n731:   `:repair-batch` addresses there.\"\n735:        batch (limit node :repair-batch)]\n738:           held (held-in-repair node id)]\n746:                             (update :repair conj a)\n747:                             (assoc-in [:queued a] :repair)\n748:                             (assoc-in [:repair-owner a] id))\n753:(defn- admit-repairs\n764:;; Release (5.5.2): below the DHT's bound, repair slots reserved\n790:                        (update :repair-owner dissoc a)\n806:    (let [slots (limit node :repair-slots)\n808:          node (issue node :repair\n809:                      (take-issuable node (:repair node)\n811:                                          (- slots (in-flight node :repair)))))\n812:          fresh-bound (if (seq (:repair node))\n867:      [(assoc node :pubs [] :fresh [] :repair [] :queued {} :repair-owner {}\n896:             :repairing? (and (not= :acknowledged r) (nil? (:ended pub)))}\n908:                    (limit node :repair-ticks)\n909:                    (min (* 2 (:delay pub)) (limit node :repair-max-ticks)))]\n913:               :due (if (:retry? pub) (:reading node) (+ (:reading node) delay))\n914:               :retry? false))\n921:      (when (and (not= :acknowledged (result pub)) (zero? (:retryable pub)))\n922:        ::terminal)))\n965:  \"Beyond `:max-repairing`, retire the oldest repairing publications.\"\n969:    (let [repairing (filter repairing? (:pubs node))]\n970:      (if (<= (count repairing) (limit node :max-repairing))\n972:        (let [oldest (assoc (first repairing) :ended ::displaced)]\n993:;; retry! and cancel! (5.5.4, 5.5.5)\n1001:(defn retry!\n1002:  \"Make the next repair cycle of the publication `manifest-address` due\n1004:   (`:dao.space.dht/not-repairing`) unless it is repairing.  Answers the\n1007:  (when-not (some #(and (= manifest-address (:manifest %)) (repairing? %))\n1009:    (throw (refused ::not-repairing\n1010:                    (str \"no publication of \" manifest-address \" is repairing\")\n1014:                 (if (repairing? pub)\n1015:                   (cond-> (assoc pub :delay (limit node :repair-ticks))\n1016:                     (:cycle pub) (assoc :retry? true)\n1169:  \"`node` without `address`'s terminal load record, so a new `load`\n1294:   append it as a tick; finish binding; admit repairs, then the puts and\n1304:          node (admit-repairs node)\n1321:  \"What the node retains now: queue entries (`:fresh`, `:repair`),\n1323:   `:outstanding-repair`), live publications (`:live`), those awaiting a\n1324:   first report (`:open`) and repairing (`:repairing`), and the ledger\n1328:   :repair (count (:repair node))\n1331:   :outstanding-repair (in-flight node :repair)\n1334:   :repairing (count (filter repairing? (:pubs node)))\n1345:   :repairing? (repairing? pub)\n1350:   :repair-queued (held-in-repair node (:id pub))\n1356:   repair state and ledger entries.\"\n1371:   outstanding.  A publication waiting for its next repair cycle does\n1383:             (seq (:repair node))\n7:   shape and address checks.  It reads bytes through the handle with a\n12:   It verifies shape and address only.  It does not re-lower, discharge\n42:  [address role path]\n44:   :address address :role role :path path})\n48:  ([address role path code] (invalid address role path code nil))\n49:  ([address role path code detail]\n51:    :address address :role role :path path\n56:  \"Read `address` as the walk's next blob: `[st value]`, or `[st' nil]`\n58:   own memory and counted once.  Order: absent, address, then the parts\n60:  [st address role path]\n61:  (if (contains? (:seen st) address)\n62:    [st (get (:seen st) address)]\n64:          bs (if (jing/segment-address? address)\n65:               ((:get-bytes-fn handle) address sentinel)\n68:        (not (jing/segment-address? address))\n69:        [(stop st (invalid address role path :address-mismatch)) nil]\n72:        [(stop st (missing address role path)) nil]\n74:        (not (jing/segment-bytes-match? address bs))\n75:        [(stop st (invalid address role path :address-mismatch)) nil]\n78:        [(stop st (invalid address role path :parts-limit {:bound :max-parts}))\n82:        [(stop st (invalid address role path :parts-limit {:bound :max-bytes}))\n86:        (let [value (try (jing/segment-value address bs)\n90:            [(stop st (invalid address role path :address-mismatch)) nil]\n94:                 (assoc-in [:seen address] value))\n108:      (let [[address depth] (first queue)]\n110:          (stop st (invalid address :row path :parts-limit {:bound :max-depth}))\n111:          (let [[st body] (read-blob st address :row path)]\n116:              (stop st (invalid address :row path :row-defect\n135:            (if-some [address (get (:yin.module/derivations manifest) format-kw)]\n136:              (let [[st record] (read-blob st address :record path)]\n141:                  (reduced (stop st (invalid address :record path :record-defect\n145:                  (reduced (stop st (invalid address :record path\n164:                    address (if (= :yin.semantic/code format-kw)\n167:                (if (nil? address)\n171:                  (let [[st image] (read-blob st address :image path)]\n178:                      (reduced (stop st (invalid address :image path\n195:  [st manifest-address manifest path depth]\n198:                             {:module manifest-address :name n :manifest pinned})]\n214:  [st manifest-address role path depth]\n215:  (let [path (conj path manifest-address)\n216:        [st manifest] (read-blob st manifest-address role path)]\n221:      (stop st (invalid manifest-address role path :manifest-defect\n226:                   (update :visited conj manifest-address)\n227:                   (update :modules conj manifest-address)\n233:          (walk-requires st manifest-address manifest path depth))))))\n237:  \"Walk the closure of `manifest-address` in `handle` (section 4.2), with\n243:      :address a :role role :path [...]}\n248:      :address a :role role :path [...] :defect {:code c :detail d}}\n251:   `path` the manifest addresses from the root to the module the blob\n252:   belongs to.  `:code` is one of `:address-mismatch`, `:manifest-defect`,\n255:  ([handle manifest-address] (walk handle manifest-address nil))\n256:  ([handle manifest-address opts]\n269:                         manifest-address :manifest [] 0)]\n272:          :manifest manifest-address\n   175\t```\n   176\t\n   177\tThe name binding is a set of Ed25519-signed envelopes binding the name to\n   178\tthat manifest address, committed through the session's indexer as one\n   179\ttransaction whose HEAD write announces the publication. The node then\n   180\treports the result: `dht: published :segment/... (N blobs)` followed by\n   181\t`acknowledged: sent to N peers`, or a PARTIAL or NOT acknowledged line\n   182\tnaming the count of blobs not sent, the first reason, and whether it is\n   183\tretrying; a publication that is not acknowledged is retried in the\n   184\tbackground while the node is open. Republishing a name at another\n   185\tmanifest retracts the standing assertion first. `:links` is per format,\n   186\tand a format it refused at publish time (an export reading a module-level\n   187\tdefinition from inside a lambda refuses the tree format) refuses at\n   188\trequire time too.\n   189\t\n   190\t**Loading it in another yin.repl.** Start the reader against a peer, with\n   191\tthe publisher's index manifest and its principal:\n   192\t\n   193\t```bash\n   194\tclj -M:clj-yin-repl --index-store dht:/tmp/yin-b --dht-peer 127.0.0.1:53812 \\\n   195\t    --dht-manifest :segment/... --dht-principal ed25519:...\n   196\t```\n   197\t\n   198\tHydration runs before the first evaluation: typed lines wait in the input\n   199\tmedium until the reader prints `dht: hydrated :<manifest>`, with the\n   200\tdatom and blob counts, and `evaluation admitted`. Then require by name:\n   201\t\n   202\t```clojure\n   203\tyin> (require (quote my.lib))\n   204\t;; require pending: my.lib (link N); lines typed meanwhile ...\n   205\tyin> 'my.lib\n   206\tyin> (my.lib/f 1)\n   207\t4201\n   208\t```\n   209\t\n   210\tA require whose closure the node does not hold prints the\n   211\t`;; require pending: ...` line and parks: the node fetches the module's\n   212\tclosure from the peers, the parked require is re-checked when the load\n   213\tends, lines typed meanwhile run when it completes, and `(abandon)` gives\n   214\tit up. The require answers the module's name and the export evaluates.\n   215\tEach VM's session links the module itself, so after `(vm :type)` require\n   216\tthe name again: the same published name evaluates on all four VMs.\n   217\t`(yin.link/names)` answers the names this node resolves, each with its\n   218\tmanifest address and the principal that asserted it.\n   219\t\n   220\t**Why a required name can be trusted.** Content is content-addressed,\n   221\tand every hop re-verifies it: a blob fetched from a peer is checked\n   222\tagainst the address it was asked for before it enters the local store,\n   223\tand the closure walk re-checks the manifest, every tree row, every\n   224\tderivation record and every image against its own address. A manifest\n   225\tlinks at a name only if it declares that name. Names resolve only from\n   226\tsigned assertions of declared principals: an undeclared publisher, or a\n   227\tproof that does not verify, refuses the require `:absent` with the\n   228\treasons as data. The same address asserted by several declared\n   229\tprincipals resolves with every asserter named; two distinct addresses\n   230\trefuse `:ambiguous-name`. A failed load is refused and forgotten, so a\n   231\tlater require starts a new load. The link source reads only the node's\n   232\town store, and the directory's lock keeps one owner per directory. A\n   233\tretraction whose target no loaded snapshot holds is reported once,\n   234\tglobally, by `(yin.link/names)`, never as a per-name diagnostic.\n   235\t`docs/design/yin.vm.linker.dht.md` is the contract for all of it.\n   236\t\n   237\t**The plain-Clojure path.** A non-REPL client takes the same path through\n   238\tplain functions: `dao.space.dht/join` over a store, `load-index` for a\n   239\tmanifest address (step the node with `dao.space.dht/step`; `load-status`\n   240\tanswers `:loading`, `:loaded`, or `:failed` with the reason as data),\n   241\t`yin.vm.linker.dht/names` to resolve names under an authority of\n   242\tdeclared principals (`yin.vm.linker.dht/authority`),\n   243\t`yin.vm.linker.dht/load-module` for a module's closure, and\n   244\t`yin.vm.linker.dht/link` for one format's image; every failure answers\n   245\tthe data of that design's section 9. At the prompt,\n   246\t`(require (quote dao.space.dht))` exposes the same calls as host\n   247\tfunctions over the shell's own node.\n   248\t\n   249\t**Operational notes.** Keep the key file: a lost key can never sign\n   250\tagain, and a new key is a new principal. Receivers verify names against\n   251\tthe publisher's principal, not against where the bytes came from, so\n   252\thand the principal out with the network address and replace the\n   253\tdeclaration when a key rotates. The Node reader the process tests spawn\n   254\tis a build artifact: `bb build:yin-repl-node` writes `target/yin-repl.js`,\n   255\tand a missing build fails `test/yin/repl/dht_process_test.clj`. A fresh\n   256\tworktree must run `clj -M:antlr-gen` before JVM test runs: the generated\n   257\tparser path, `build/antlr/python3/classes`, is on the classpath and\n   258\tabsent until generated.\n   259\t\n   260\tSee [`docs/design/yin.repl.implementation-plan.md`](../../../../docs/design/yin.repl.implementation-plan.md)\n#!/usr/bin/env python3\n\"\"\"\nPR Reviewer Utility Script for Git-based Code Reviews.\nParses git diffs, analyzes churn and file risk categories, scans for security smells\nand debugging code, and produces structured markdown or JSON review reports.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\n\n\n@dataclass\nclass Finding:\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\n    file_path: str\n    line_number: Optional[int]\n    message: str\n    snippet: str\n\n\n@dataclass\nclass FileStat:\n    path: str\n    additions: int\n    deletions: int\n    category: str\n    risk_level: str  # High, Medium, Low\n\n\n@dataclass\nclass ReviewSummary:\n    target: str\n    total_files: int\n    total_additions: int\n    total_deletions: int\n    test_additions: int\n    source_additions: int\n    test_to_source_ratio: float\n    file_stats: List[FileStat] = field(default_factory=list)\n    findings: List[Finding] = field(default_factory=list)\n    commits: List[str] = field(default_factory=list)\n\n\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\n    \"\"\"Helper to run git commands cleanly.\"\"\"\n    cmd = [\"git\"] + args\n    try:\n        res = subprocess.run(\n            cmd,\n            cwd=cwd,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=True,\n        )\n        return res.stdout.strip()\n    except subprocess.CalledProcessError as e:\n        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n        raise RuntimeError(f\"Git execution failed: {e.stderr.strip()}\")\n\n\ndef categorize_file(file_path: str) -> Tuple[str, str]:\n    \"\"\"Categorizes file type and assigns risk level.\"\"\"\n    path_lower = file_path.lower()\n\n    # Security & Auth\n    if any(k in path_lower for k in [\"auth\", \"secret\", \"crypto\", \"token\", \"permission\", \"jwt\", \"oauth\", \"password\"]):\n        return \"Security/Auth\", \"High\"\n\n    # Database & Schema\n    if any(k in path_lower for k in [\"migration\", \"schema\", \".sql\", \"entity\", \"db/\"]):\n        return \"Database/Schema\", \"High\"\n\n    # Infrastructure & Config\n    if any(k in path_lower for k in [\"docker\", \"terraform\", \".tf\", \".env\", \"k8s\", \"helm\", \"ci/cd\", \".github/workflows\"]):\n        return \"Infra/Config\", \"High\"\n    if any(file_path.endswith(ext) for ext in [\"package.json\", \"deps.edn\", \"Cargo.toml\", \"go.mod\", \"requirements.txt\", \"pom.xml\", \"build.gradle\"]):\n        return \"Dependencies\", \"Medium\"\n\n    # API / Interfaces\n    if any(k in path_lower for k in [\"proto\", \"openapi\", \"swagger\", \"graphql\", \"router\", \"controller\", \"api/\"]):\n        return \"API/Contract\", \"Medium\"\n\n    # Tests\n    if any(k in path_lower for k in [\"test\", \"spec\", \"mock\", \"fixture\", \"e2e\"]):\n        return \"Tests\", \"Low\"\n\n    # Documentation\n    if any(file_path.endswith(ext) for ext in [\".md\", \".rst\", \".txt\", \"LICENSE\"]):\n        return \"Documentation\", \"Low\"\n\n    # Core source\n# Code Review PR Checklist & Taxonomy\n\nWhen performing code reviews, evaluate changes using this structured checklist and severity taxonomy.\n\n---\n\n## 1. Finding Severity Taxonomy\n\n| Severity | Label | Definition | Examples |\n| :--- | :--- | :--- | :--- |\n| **P0** | **Critical (Blocker)** | Security vulnerabilities, data loss risks, production crashes, secret leakage. Must be fixed before merging. | Hardcoded tokens, unhandled NullPointer on critical path, SQL injection, broken auth check. |\n| **P1** | **High (Must Address)** | Logic bugs, breaking API changes, missing error handling on external calls, race conditions, lack of tests for complex logic. | Swallowed exceptions, broken retry loop, missing backward compatibility in API schema. |\n| **P2** | **Medium (Recommended)** | Performance inefficiencies, code duplication, sub-optimal data structures, non-idiomatic style. | Unnecessary DB query inside loop, missing index, missing parameter validation. |\n| **P3** | **Low (Nit / Suggestion)** | Minor formatting, naming improvements, leftover comments/TODOs, minor doc polish. | Variable naming clarity, typos in docstrings, cleaning leftover TODO comments. |\n\n---\n\n## 2. Comprehensive Review Checklist\n\n### A. Logic & Correctness\n- [ ] **Edge Cases**: Does the code handle null/nil/undefined, empty collections, zero values, boundary numbers, and unexpected inputs?\n- [ ] **State & Concurrency**: Are shared state mutations thread-safe? Are locks acquired/released properly without deadlock risks?\n- [ ] **Control Flow**: Are all conditional branches covered? Do loops have guaranteed termination conditions?\n- [ ] **Error Propagation**: Are errors caught and logged/surfaced appropriately, rather than swallowed silently (`catch (Exception e) {}`)?\n\n### B. Security & Credentials\n- [ ] **No Hardcoded Secrets**: Are API keys, passwords, bearer tokens, or private keys excluded from code and config?\n- [ ] **Input Validation & Sanitization**: Are external inputs validated before processing or passing to system shells, DB queries, or HTML rendering?\n- [ ] **Authentication & Authorization**: Do endpoints verify user identity and check permissions before executing state changes?\n- [ ] **Safe Dependencies**: Are newly added packages pinned to trusted versions without known vulnerabilities?\n\n### C. Architecture & API Design\n- [ ] **Preserve API Contracts**: Are public method signatures, REST endpoints, and schema definitions backward compatible?\n- [ ] **Single Responsibility**: Are modules, classes, and functions focused on a clear, single responsibility?\n- [ ] **Coupling & Cohesion**: Is the new code properly modularized without introducing circular dependencies or leaky abstractions?\n- [ ] **Idempotence**: Are retry loops or state-changing operations safe to re-execute on transient failures?\n\n### D. Performance & Resource Efficiency\n- [ ] **N+1 Queries**: Are database or remote API calls executed in batches rather than inside loops?\n- [ ] **Resource Cleanup**: Are file handles, database connections, streams, and web sockets closed explicitly (or managed via try-with-resources / context managers)?\n- [ ] **Memory & Allocation**: Are large datasets streamed or paginated rather than loaded fully into memory at once?\n\n### E. Test Coverage & Quality\n- [ ] **Test Coverage**: Do new features or bug fixes include corresponding unit or integration tests?\n- [ ] **Test Quality**: Do tests verify actual assertions rather than just checking that code runs without throwing?\n- [ ] **Edge Case Tests**: Are failure modes, invalid inputs, and error handlers covered by unit tests?\n\n---\n\n## 3. Review Feedback Guidelines\n\n1. **Be Specific**: Always reference the exact file line number, function name, and context.\n2. **Explain the \"Why\"**: Don't just say \"change this\". Explain the risk or benefit (e.g., \"This could lead to a race condition if two threads call `transact!` simultaneously...\").\n3. **Provide Concrete Fixes**: Offer concrete, copy-pasteable diff snippets where appropriate.\n4. **Acknowledge Good Work**: Highlight well-crafted solutions, thorough tests, or clean refactorings.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/query.cljc | sed -n '450,700p'; nl -ba src/cljc/dao/space/dht.cljc | sed -n '515,550p;885,935p;960,986p'; nl -ba src/cljc/yin/repl/link.cljc | sed -n '295,373p'; rg -n 'dht|load-ended|resume-pending' src/cljc/yin/repl.cljc; rg -n 'antlr-gen|build/antlr/python3|build:yin-repl-node|yin-repl.js' deps.edn bb.edn test/yin/repl/dht_process_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
