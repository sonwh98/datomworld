{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/main.cljc | sed -n '97,258p'; nl -ba src/cljc/yin/repl/dht.cljc\"","aggregated_output":"    97\t(def ^:private dht-flags\n    98\t  #{\"--dht-peer\" \"--dht-publish\" \"--dht-bind\" \"--dht-port\"\n    99\t    \"--dht-max-inbound-bytes\" \"--dht-manifest\" \"--dht-key\" \"--dht-principal\"})\n   100\t\n   101\t\n   102\t(defn parse-principal\n   103\t  \"A `--dht-principal` value: a declared publisher's public key, exactly\n   104\t   64 lowercase hexadecimal characters (yin.vm.linker.dht.md 6.2).\"\n   105\t  [text]\n   106\t  (if (and (string? text) (re-matches #\"^[0-9a-f]{64}$\" text))\n   107\t    text\n   108\t    (throw (ex-info (str \"--dht-principal takes a public key of 64 lowercase \"\n   109\t                         \"hexadecimal characters, not \" (pr-str text))\n   110\t                    {:value text}))))\n   111\t\n   112\t\n   113\t;; =============================================================================\n   114\t;; The publisher's key file (yin.vm.linker.dht.md 6.5)\n   115\t;; =============================================================================\n   116\t\n   117\t(defn- split-path\n   118\t  \"`[dir name]` of a file path.\"\n   119\t  [path]\n   120\t  (if-let [i (str/last-index-of path \"/\")]\n   121\t    [(subs path 0 i) (subs path (inc i))]\n   122\t    [\".\" path]))\n   123\t\n   124\t\n   125\t(defn load-key\n   126\t  \"The publisher key `{:seed :public}` the key file at `path` holds, or a\n   127\t   refusal of startup with the reason: a file that does not exist, or one\n   128\t   `yin.vm.linker.sign/key-from-text` refuses.  Nothing falls back to a\n   129\t   fresh key, and no refusal carries the file's content.\"\n   130\t  [path]\n   131\t  (let [[dir name] (split-path path)\n   132\t        text (fs/read-file-text dir name)\n   133\t        key (when text (sign/key-from-text text))]\n   134\t    (cond\n   135\t      (nil? text)\n   136\t      (throw (ex-info (str \"--dht-key \" path \": the key file does not exist; \"\n   137\t                           \"nothing falls back to a fresh key (create one with \"\n   138\t                           \"--dht-keygen \" path \")\")\n   139\t                      {:path path}))\n   140\t\n   141\t      (= :refused (:status key))\n   142\t      (throw (ex-info (str \"--dht-key \" path \": the key file is refused (\"\n   143\t                           (:reason key) \")\")\n   144\t                      {:path path :reason (:reason key)}))\n   145\t\n   146\t      :else key)))\n   147\t\n   148\t\n   149\t(defn- write-new-file!\n   150\t  \"Create `path` holding `text`, readable by its owner only where the host\n   151\t   can set that, refusing an existing file: a key file is never\n   152\t   overwritten.\"\n   153\t  [path text]\n   154\t  (let [exists (fn []\n   155\t                 (ex-info (str \"--dht-keygen \" path \": the file exists; \"\n   156\t                               \"a key file is never overwritten\")\n   157\t                          {:path path}))]\n   158\t    #?(:cljd (let [f (io/File. path)]\n   159\t               (when (.existsSync f) (throw (exists)))\n   160\t               (try (.createSync f .exclusive true)\n   161\t                    (catch Object _ (throw (exists))))\n   162\t               (.writeAsStringSync f text))\n   163\t       :clj (let [p (.toPath (java.io.File. ^String path))\n   164\t                  owner-only (java.nio.file.attribute.PosixFilePermissions/asFileAttribute\n   165\t                               (java.nio.file.attribute.PosixFilePermissions/fromString\n   166\t                                 \"rw-------\"))]\n   167\t              (try\n   168\t                (try (java.nio.file.Files/createFile\n   169\t                       p (into-array java.nio.file.attribute.FileAttribute\n   170\t                                     [owner-only]))\n   171\t                     (catch UnsupportedOperationException _\n   172\t                       (java.nio.file.Files/createFile\n   173\t                         p (make-array java.nio.file.attribute.FileAttribute 0))))\n   174\t                (catch java.nio.file.FileAlreadyExistsException _\n   175\t                  (throw (exists))))\n   176\t              (spit path text))\n   177\t       :cljs (let [fs-module (js/require \"fs\")]\n   178\t               (try (.writeFileSync fs-module path text #js {:flag \"wx\" :mode 384})\n   179\t                    (catch :default e\n   180\t                      (if (= \"EEXIST\" (.-code e))\n   181\t                        (throw (exists))\n   182\t                        (throw (ex-info (str \"--dht-keygen \" path \": \" (.-message e))\n   183\t                                        {:path path})))))))))\n   184\t\n   185\t\n   186\t(defn keygen!\n   187\t  \"Write a new key, from the host CSPRNG, to a new key file at `path`\n   188\t   (`--dht-keygen`), and answer the lines to print and the exit status.\n   189\t   The seed is never printed.\"\n   190\t  [path]\n   191\t  (let [key (sign/generate)]\n   192\t    (write-new-file! path (str (sign/key-text key) \"\\n\"))\n   193\t    {:lines (cond-> [(str \"dht: wrote a new Ed25519 key to \" path \"; its principal is \"\n   194\t                          (sign/principal (:public key)) \". Keep the file: a lost key \"\n   195\t                          \"can never sign again, and a new key is a new principal.\")]\n   196\t              ;; dart:io sets no file permissions (yin.vm.linker.dht.md 6.5)\n   197\t              #?(:cljd true :default false)\n   198\t              (conj (str \"dht: WARNING: this host cannot restrict the key file's \"\n   199\t                         \"permissions; it is readable as the process umask allows. \"\n   200\t                         \"Restrict it now: chmod 600 \" path)))\n   201\t     :exit 0}))\n   202\t\n   203\t\n   204\t(defn- dht-spec\n   205\t  \"Fold the `--dht-*` flags into the `dht:<dir>` spec, checked by\n   206\t   `yin.repl.store/checked-spec`.  They mean nothing to any other store,\n   207\t   and a bind address means nothing to a solo node, so each such use is\n   208\t   refused rather than ignored.\"\n   209\t  [spec {:keys [flags peers publish? bind-host bind-port max-inbound-bytes\n   210\t                manifest]}]\n   211\t  (cond\n   212\t    (and (seq flags) (not= :dht (:type spec)))\n   213\t    (throw (ex-info (str (str/join \", \" (sort flags))\n   214\t                         \" need --index-store dht:<dir>\")\n   215\t                    {:flags (vec (sort flags))}))\n   216\t\n   217\t    (not= :dht (:type spec)) spec\n   218\t\n   219\t    (and (empty? peers) (or bind-host bind-port))\n   220\t    (throw (ex-info (str \"--dht-bind and --dht-port need a --dht-peer: \"\n   221\t                         \"with no peers the DHT store is solo and opens \"\n   222\t                         \"no socket\")\n   223\t                    {}))\n   224\t\n   225\t    (and bind-host (not (datagram/ip-literal? bind-host)))\n   226\t    (throw (ex-info (str \"--dht-bind must be an IP literal, not \"\n   227\t                         (pr-str bind-host))\n   228\t                    {:value bind-host}))\n   229\t\n   230\t    :else\n   231\t    (store/checked-spec\n   232\t      (cond-> (assoc spec :peers (vec peers) :publish? (boolean publish?))\n   233\t        bind-host (assoc :bind-host bind-host)\n   234\t        bind-port (assoc :bind-port bind-port)\n   235\t        max-inbound-bytes (assoc :max-inbound-bytes max-inbound-bytes)\n   236\t        manifest (assoc :manifest manifest)))))\n   237\t\n   238\t\n   239\t(defn- dht-number\n   240\t  [flag text]\n   241\t  (or (parse-int text)\n   242\t      (throw (ex-info (str flag \" takes an integer, not \" (pr-str text))\n   243\t                      {:value text}))))\n   244\t\n   245\t\n   246\t(defn parse-args\n   247\t  \"Parse the host arguments.  `--telemetry` and `--telemetry-stream` are\n   248\t   rejected rather than ignored.  `--index-store` is parsed into\n   249\t   `:index-store-spec` — `:mem` (also what omission means),\n   250\t   `{:type :file :dir dir}`, or the DHT store `{:type :dht :dir dir ...}`\n   251\t   — and a missing value, an unknown scheme, or an empty directory is\n   252\t   refused here, by `yin.repl.store/parse-arg`, before any host composes.\n   253\t\n   254\t   The DHT store's options are their own flags (yin.repl.dht):\n   255\t   `--dht-peer host:port`, repeatable, the bootstrap contacts — none\n   256\t   means solo, with no socket; `--dht-publish`, the separate declaration\n   257\t   that shares the store; `--dht-bind ip` and `--dht-port p`, the\n   258\t   socket's address, loopback and ephemeral unless given;\n     1\t(ns yin.repl.dht\n     2\t  \"The REPL's DHT index store, `--index-store dht:<dir>` (DHT epic slice\n     3\t   S5: docs/design/dao.jing.dht.md section 10; docs/design/\n     4\t   yin.repl.dao.space-index.md, \\\"DHT store\\\").  It is composed with the\n     5\t   plain Clojure path, `dao.space.dht`, and adds only what the shell owns:\n     6\t   the durable directory, the lines it prints, and when it admits\n     7\t   evaluation.\n     8\t\n     9\t   `open` opens `<dir>` exactly as `file:<dir>` does — the exclusive lock,\n    10\t   the content log, HEAD, the validated snapshot (dao.space.store) — and\n    11\t   joins a `dao.space.dht` node with that locked store as its `:local`.\n    12\t   The indexer publishes through the node's store: each put inserts\n    13\t   locally and appends one replicate request, and the manifest reads back\n    14\t   locally, so a round never waits on the network.  The HEAD write then\n    15\t   announces the publication to the node.\n    16\t\n    17\t   `step` is the node's one step owner, called by the host's single\n    18\t   ticker (yin.repl.main/step-all) with the host's clock reading; it\n    19\t   renders the node's events as the lines the REPL prints: where the\n    20\t   socket bound, and for each publication its result — acknowledged,\n    21\t   sent to N peers, or partial or not acknowledged with the count of\n    22\t   blobs not sent, the first reason, and whether the node is retrying —\n    23\t   and each later change of it (yin.vm.linker.dht.md 5.5.6).  A load's\n    24\t   failure reason is data; it is rendered as text here.\n    25\t\n    26\t   A reader handed a manifest address (`:manifest`) loads it through\n    27\t   `dao.space.dht/load-index` before the shell admits any evaluation, as a\n    28\t   restart installs its recovery first, then writes it to HEAD and\n    29\t   rehydrates the indexer from the loaded datoms, so `q` answers the\n    30\t   remote run's facts.  A load that cannot complete, or a socket that\n    31\t   cannot bind, refuses the shell (`refusal`); it never starts over an\n    32\t   empty index.  Remote indexes are also reachable at the prompt, through\n    33\t   the `dao.space.dht` host module (yin.repl.query), over the same node.\"\n    34\t  (:require [clojure.string :as str]\n    35\t            [dao.space.dht :as dht]\n    36\t            [dao.space.store :as durable]\n    37\t            [yin.repl.index :as index]\n    38\t            [yin.repl.store :as store]))\n    39\t\n    40\t\n    41\t(def default-max-inbound-bytes\n    42\t  \"The CLI default of the inbound storage bound; `dao.space.dht`'s.\"\n    43\t  dht/default-max-inbound-bytes)\n    44\t\n    45\t\n    46\t(defn- refused-head\n    47\t  \"Why a reader cannot hydrate `manifest` into a directory whose own HEAD\n    48\t   already names `recovered`, or nil.  Hydration never replaces an index\n    49\t   the directory holds.\"\n    50\t  [dir manifest recovered]\n    51\t  (when (and manifest recovered (not= manifest recovered))\n    52\t    (str dir \" already holds an index (HEAD names \" recovered \"); hydrate \"\n    53\t         manifest \" into an empty directory\")))\n    54\t\n    55\t\n    56\t(defn open\n    57\t  \"Open a `dht:<dir>` store from its spec (yin.repl.store/checked-spec):\n    58\t   the durable directory store, and the `dao.space.dht` node joined over\n    59\t   it.  Answers the store handle the shell keeps — the node's store, with\n    60\t   the durable HEAD write announcing each publication, the recovery, and\n    61\t   the directory — carrying the node under `:dht`, which the shell moves\n    62\t   onto its own state (yin.repl/create-state).\"\n    63\t  [spec]\n    64\t  (let [{:keys [dir peers publish? bind-host bind-port max-inbound-bytes\n    65\t                manifest bind!]} (store/checked-spec spec)\n    66\t        base (durable/open dir)]\n    67\t    (try\n    68\t      (when-some [why (refused-head dir manifest\n    69\t                                    (get-in base [:recovery :manifest]))]\n    70\t        (throw (ex-info why {:dir dir :manifest manifest})))\n    71\t      (let [node (dht/join {:local base\n    72\t                            :peers peers\n    73\t                            :publish? publish?\n    74\t                            :bind-host bind-host\n    75\t                            :bind-port bind-port\n    76\t                            :max-inbound-bytes max-inbound-bytes\n    77\t                            :bind! (or bind! (dht/default-bind))})\n    78\t            node (cond-> (assoc node ::dir dir)\n    79\t                   (and manifest (not= manifest (get-in base [:recovery :manifest])))\n    80\t                   (-> (dht/load-index manifest)\n    81\t                       (assoc ::hydrating manifest)))]\n    82\t        (assoc (dht/store node)\n    83\t               :head-fn (fn [manifest-address]\n    84\t                          ((:head-fn base) manifest-address)\n    85\t                          (dht/announce! node manifest-address))\n    86\t               :recovery (:recovery base)\n    87\t               :durable-dir dir\n    88\t               :dht node))\n    89\t      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n    90\t        (store/close! base)\n    91\t        (throw e)))))\n    92\t\n    93\t\n    94\t(defn without-runner\n    95\t  \"The store handle the shell keeps: `open`'s answer without the node,\n    96\t   which the shell carries as its own `:dht`.  Any other handle is\n    97\t   answered as it is.\"\n    98\t  [handle]\n    99\t  (dissoc handle :dht))\n   100\t\n   101\t\n   102\t;; =============================================================================\n   103\t;; Lines\n   104\t;; =============================================================================\n   105\t\n   106\t(defn- address-text\n   107\t  [host port]\n   108\t  (if (str/includes? host \":\") (str \"[\" host \"]:\" port) (str host \":\" port)))\n   109\t\n   110\t\n   111\t(defn- reason-text\n   112\t  \"One blob's failure reason as the REPL prints it.\"\n   113\t  [node {:keys [reason peers]}]\n   114\t  (case reason\n   115\t    :dao.jing.dht/solo (str \"solo — no --dht-peer is configured, so nothing \"\n   116\t                            \"was sent; the index is in \" (::dir node) \" only\")\n   117\t    :dao.jing.dht/unpublished (str \"publication is off — this node fetches \"\n   118\t                                   \"only; start with --dht-publish to share\")\n   119\t    :dao.jing.dht/too-few-peers (str \"too few peers — sent to \" peers \" of \"\n   120\t                                     (dht/ack-peers node) \" before the \"\n   121\t                                     \"acknowledgement deadline\")\n   122\t    :dao.jing.dht/oversize \"a blob exceeds the DHT message bound\"\n   123\t    :dao.jing.dht/absent \"a blob was no longer in the local store\"\n   124\t    :dao.jing.dht/busy \"too many writes were pending\"\n   125\t    :dao.space.dht/backlog-full \"the replicate backlog was full\"\n   126\t    :dao.space.dht/publications-full (str \"too many publications awaited \"\n   127\t                                          \"their first report\")\n   128\t    :dao.space.dht/cancelled \"cancelled\"\n   129\t    (str reason)))\n   130\t\n   131\t\n   132\t(def ^:private ended-text\n   133\t  {:dao.space.dht/terminal \"every remaining failure is final\"\n   134\t   :dao.space.dht/cancelled \"cancelled\"\n   135\t   :dao.space.dht/displaced \"displaced by newer publications\"})\n   136\t\n   137\t\n   138\t(defn- result-text\n   139\t  \"A publication's result (yin.vm.linker.dht.md 5.5.6): when it is not\n   140\t   acknowledged, the count of failed blobs, the first reason, and whether\n   141\t   the node is retrying.\"\n   142\t  [node {:keys [result blobs peers failed repairing? ended]}]\n   143\t  (if (= :acknowledged result)\n   144\t    (str \"acknowledged: sent to \" peers \" peers\")\n   145\t    (str (if (= :partial result)\n   146\t           \"PARTIAL: the manifest was sent; \"\n   147\t           \"NOT acknowledged: \")\n   148\t         (reason-text node (first failed))\n   149\t         \"; \" (count failed) \" of \" blobs \" blobs not sent\"\n   150\t         (cond\n   151\t           repairing? \"; retrying while the node is open\"\n   152\t           ended (str \"; not retrying (\" (get ended-text ended (str ended)) \")\")\n   153\t           :else \"; not retrying\")\n   154\t         \"; the local copy is durable\")))\n   155\t\n   156\t\n   157\t(defn- failure-text\n   158\t  \"A load's failure reason, data (dao.space.dht 4.3), as text.\"\n   159\t  [{:dao.space.dht/keys [failure] :keys [address cause defect outcome]}]\n   160\t  (case failure\n   161\t    :miss (str \"no peer produced \" address \" (\" (name cause) \")\")\n   162\t    :invalid (str \"the content \" (when address (str \"at \" address \" \"))\n   163\t                  \"is invalid (\" (:code defect) \")\"\n   164\t                  (when-let [text (:text defect)] (str \": \" text)))\n   165\t    :unaskable (str \"could not ask for \" address \" (\" (name outcome) \")\")\n   166\t    (pr-str failure)))\n   167\t\n   168\t\n   169\t(defn- event-line\n   170\t  [node {:keys [manifest blobs host port id reason datoms fetched], :as event}]\n   171\t  (case (::dht/event event)\n   172\t    :bound (str \"dht: node \" (subs id 0 16) \" listening on \"\n   173\t                (address-text host port) \"; peers: \"\n   174\t                (str/join \", \" (map #(address-text (:host %) (:port %))\n   175\t                                    (:peers node)))\n   176\t                (if (:publish? node) \"; publishing\" \"; fetch-only\"))\n   177\t    :bind-failed (str \"dht: refused: the socket could not bind: \" reason)\n   178\t    (:published :republished)\n   179\t    (str \"dht: \" (name (::dht/event event)) \" \" manifest \" (\" blobs \" blobs) — \"\n   180\t         (result-text node event))\n   181\t    :publication-unknown (str \"dht: published \" manifest\n   182\t                              \" — acknowledgement unknown: facts were lost\")\n   183\t    :loaded (str (if (= manifest (::hydrating node)) \"dht: hydrated \" \"dht: loaded \")\n   184\t                 manifest \" — \"\n   185\t                 (when datoms (str datoms \" datoms, \"))\n   186\t                 fetched \" blobs fetched\"\n   187\t                 (when (= manifest (::hydrating node)) \"; evaluation admitted\"))\n   188\t    :load-failed (str \"dht: \" (if (= manifest (::hydrating node)) \"refused: \" \"\")\n   189\t                      \"loading \" manifest \" failed: \" (failure-text reason)\n   190\t                      (when (= manifest (::hydrating node))\n   191\t                        \"; the remote index was not hydrated\"))\n   192\t    (pr-str event)))\n   193\t\n   194\t\n   195\t;; =============================================================================\n   196\t;; The step\n   197\t;; =============================================================================\n   198\t\n   199\t(defn- hydrated\n   200\t  \"Install the loaded remote index as this directory's: HEAD first, then\n   201\t   the indexer, exactly as a restart's recovery is installed.\"\n   202\t  [shell node]\n   203\t  (let [manifest (::hydrating node)\n   204\t        recovery {:manifest manifest :datoms (dht/loaded-datoms node manifest)}]\n   205\t    ((:head-fn (dht/local node)) manifest)\n   206\t    (-> shell\n   207\t        (update :indexer index/rehydrate recovery)\n   208\t        (assoc :index-recovery recovery\n   209\t               :dht (dissoc node ::hydrating)))))\n   210\t\n   211\t\n   212\t(defn step\n   213\t  \"Advance the shell's node once at the host's clock reading `now`\n   214\t   (dao.space.dht/step) and answer `[shell' lines events]`: its events as\n   215\t   lines, and as the data the ticker reads to re-check a pending require\n   216\t   (yin.repl/recheck-on-load-events), a completed hydration installed, a\n   217\t   failed one or a failed bind recorded as the shell's refusal.  A shell\n   218\t   without a DHT store is answered unchanged.\"\n   219\t  [shell now]\n   220\t  (if-let [node (:dht shell)]\n   221\t    (let [[node events] (dht/step node now)\n   222\t          lines (mapv #(event-line node %) events)\n   223\t          hydrating (::hydrating node)\n   224\t          status (when hydrating (:status (dht/load-status node hydrating)))\n   225\t          node (cond-> node\n   226\t                 (and hydrating (= :failed status))\n   227\t                 (assoc ::refusal (str/join \"\\n\" (filter #(str/includes? % \"refused\")\n   228\t                                                         lines)))\n   229\t                 (dht/refusal node)\n   230\t                 (assoc ::refusal (dht/refusal node)))\n   231\t          shell (assoc shell :dht node)]\n   232\t      [(if (= :loaded status) (hydrated shell node) shell) lines events])\n   233\t    [shell [] []]))\n   234\t\n   235\t\n   236\t(defn refusal\n   237\t  \"The text that refused the shell's DHT store after startup — a failed\n   238\t   bind or a hydration that could not complete — or nil.\"\n   239\t  [shell]\n   240\t  (get-in shell [:dht ::refusal]))\n   241\t\n   242\t\n   243\t(defn admitting?\n   244\t  \"True when the shell may evaluate: no hydration is outstanding and none\n   245\t   was refused.\"\n   246\t  [shell]\n   247\t  (let [node (:dht shell)]\n   248\t    (or (nil? node)\n   249\t        (and (nil? (::hydrating node)) (nil? (::refusal node))))))\n   250\t\n   251\t\n   252\t(defn busy?\n   253\t  \"True while the node owes the REPL a line; the ticker keeps its base\n   254\t   cadence then.\"\n   255\t  [shell]\n   256\t  (boolean (some-> (:dht shell) dht/busy?)))\n   257\t\n   258\t\n   259\t(defn banner\n   260\t  \"What the REPL states at startup about a DHT store spec, before the\n   261\t   node steps once — and so before anything is shared.\"\n   262\t  [{:keys [dir peers publish? bind-host bind-port]}]\n   263\t  (let [content (durable/content-path dir)\n   264\t        peers-text (str/join \", \" (map #(address-text (:host %) (:port %)) peers))]\n   265\t    (cond-> []\n   266\t      (empty? peers)\n   267\t      (conj (str \"dht: solo — no --dht-peer, so no socket is opened; \"\n   268\t                 \"publications are durable in \" dir \" and acknowledged by no one\"))\n   269\t\n   270\t      (seq peers)\n   271\t      (conj (str \"dht: binding \" (address-text bind-host bind-port)\n   272\t                 (when (zero? bind-port) \" (ephemeral)\")\n   273\t                 \"; peers \" peers-text))\n   274\t\n   275\t      (and publish? (seq peers))\n   276\t      (conj (str \"dht: publishing is ON. Everything in \" content\n   277\t                 \" will be shared: the whole code index this directory holds\"\n   278\t                 \" — every program recovered from HEAD and every program\"\n   279\t                 \" evaluated from now on — with any peer that asks for its\"\n   280\t                 \" address. Omit --dht-publish to fetch only.\"))\n   281\t\n   282\t      (and publish? (empty? peers))\n   283\t      (conj (str \"dht: publishing is on, but solo: nothing in \" content\n   284\t                 \" leaves this process\"))\n   285\t\n   286\t      (and (not publish?) (seq peers))\n   287\t      (conj \"dht: fetch-only — nothing this node holds is shared (--dht-publish shares it)\")\n   288\t\n   289\t      true\n   290\t      (conj (str \"dht: a (require ...) of a module this node does not hold \"\n   291\t                 \"may fetch its code from peers; it stays pending until the \"\n   292\t                 \"load ends, and (abandon) gives it up\")))))\n","exit_code":0,"status":"completed"}}
