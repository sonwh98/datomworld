port [2 3 1]\n   207\t                              {:manifest manifest :principals principals}))\n   208\t        w (run-world w (+ (:now w) 60000) (str (name k) \" did not hydrate\")\n   209\t                     #(repl.dht/admitting? (get-in % [:shells k])))]\n   210\t    (is (nil? (:failure w)) (:failure w))\n   211\t    (is (nil? (repl.dht/refusal (get-in w [:shells k]))))\n   212\t    w))\n   213\t\n   214\t\n   215\t(defn- require-at\n   216\t  \"Require `module` at shell `k` and run until the run ends: `[w text]`,\n   217\t   the require's own text.\"\n   218\t  [w k module]\n   219\t  (let [[w text] (eval-at w k (str \"(require (quote \" module \"))\"))\n   220\t        w (run-world w (+ (:now w) 120000) (str \"the require of \" module \" never ended\")\n   221\t                     #(nil? (get-in % [:shells k :pending-run])))]\n   222\t    (is (nil? (:failure w)) (:failure w))\n   223\t    [w text]))\n   224\t\n   225\t\n   226\t(def ^:private vm-types\n   227\t  [:ast-walker :semantic :stack :register])\n   228\t\n   229\t\n   230\t(deftest a-reader-requires-a-published-module-by-name-on-all-four-vms\n   231\t  (let [[adir bdir] [(temp-dir) (temp-dir)]\n   232\t        net (mesh/mesh)\n   233\t        key (sign/generate)\n   234\t        principal (sign/principal (:public key))]\n   235\t    (try\n   236\t      (let [[w m] (publish-world net adir key)\n   237\t            w (hydrate w :b bdir 4 m [(:public key)])\n   238\t            names (ld/names (get-in w [:shells :b :dht])\n   239\t                            (ld/authority {:principals [(:public key)]}))]\n   240\t        (testing \"the reader resolves both names, each signed by the publisher\"\n   241\t          (doseq [n '[my.lib my.store]]\n   242\t            (is (= [principal] (get-in names [:names n :yin.link/provenance\n   243\t                                              :yin.module/asserted-by]))\n   244\t                (pr-str (get-in names [:names n])))))\n   245\t        (reduce\n   246\t          (fn [w vm-type]\n   247\t            (let [[w _] (eval-at w :b (str \"(vm \" vm-type \")\"))\n   248\t                  [w text] (require-at w :b 'my.lib)\n   249\t                  linked (get-in w [:shells :b :last-value])\n   250\t                  lib-response (last-response w :b)\n   251\t                  [w answer] (eval-at w :b \"(my.lib/f 1)\")\n   252\t                  [w _] (require-at w :b 'my.store)\n   253\t                  store-response (last-response w :b)\n   254\t                  [_ value] (eval-at w :b \"(my.store/g)\")]\n   255\t              (testing (name vm-type)\n   256\t                (when (= :ast-walker vm-type)\n   257\t                  (is (str/includes? text \"pending\")\n   258\t                      \"the first require waits on the closure load\"))\n   259\t                (is (= 'my.lib linked) (pr-str lib-response))\n   260\t                (is (= \"4201\" answer))\n   261\t                (testing \"the store corpus\"\n   262\t                  (when (= :ast-walker vm-type)\n   263\t                    (is (= {:status :refused :reason :undeclared-free :name 'base}\n   264\t                           (select-keys store-response [:status :reason :name]))\n   265\t                        (str \"the linker's reason, naming the read: \"\n   266\t                             (pr-str store-response))))\n   267\t                  (when-not (= :ast-walker vm-type)\n   268\t                    (is (= :ok (:status store-response)) (pr-str store-response))\n   269\t                    (is (= \"8\" value))))\n   270\t                nil)\n   271\t              w))\n   272\t          w\n   273\t          vm-types)\n   274\t        (close-all! w))\n   275\t      (finally\n   276\t        (run! cleanup-dir! [adir bdir])))))\n   277\t\n   278\t\n     1\t(ns yin.repl.link\n     2\t  \"The REPL's linker-side composition (yin.vm.linker.md sections 6.1 and 9,\n     3\t   M5): the interpreter box of the four-stream topology.\n     4\t\n     5\t   The shell composes the link pair per VM (`yin.repl/make-session`) and\n     6\t   the content pair per content source; this namespace owns the second\n     7\t   and answers what the first receives.  One serve round reads every link\n     8\t   request the interpreter has not yet seen, resolves each by name\n     9\t   through the composition's name environment -- the snapshot the host\n    10\t   supplies, an authority fold (`yin.vm.linker.authority/name-environment`)\n    11\t   reduced to `name -> manifest address` -- and links the manifest's\n    12\t   image over the content pair, appending the response the requesting\n    13\t   task correlates on (section 7.2, steps 5 to 6).\n    14\t\n    15\t   Step 5b is deferred: the obligations travel on the response and the\n    16\t   receiving task's engine discharges them against its live state\n    17\t   (section 7.2, step 7), so the interpreter passes\n    18\t   `:defer-discharge` to `link-manifest` and discharges nothing here.\n    19\t\n    20\t   Liveness is the composition's (section 6.3, D6): an attempt serves the\n    21\t   content pair for at most `attempt-budget` drive rounds and then\n    22\t   reports the link `:pending` -- nothing is appended, the request is\n    23\t   re-read and re-attempted on a later round, and `abandon` is the\n    24\t   shell's.  No clock, no atom, no global: every input is an argument or\n    25\t   a composition value, and every outcome is plain data.\n    26\t\n    27\t   A DHT link source (docs/design/yin.vm.linker.dht.md 4.1) holds no\n    28\t   handle: each serve round receives the shell's `dao.space.dht` node\n    29\t   and answers the node after it.  A resolved name whose closure is not\n    30\t   loaded starts its load (`yin.vm.linker.dht/load-module`) and reports\n    31\t   the link `:pending`, naming the manifest it waits on; the node's own\n    32\t   step fetches.  A failed load is refused in its section 9 shape and\n    33\t   forgotten; a loaded one has its dependency bindings checked, then\n    34\t   links over a local runtime on the node's store, asking no peer.\"\n    35\t  (:require [dao.jing.content :as content]\n    36\t            [dao.space.dht :as dht]\n    37\t            [dao.stream :as stream]\n    38\t            [dao.stream.ringbuffer :as ring]\n    39\t            [yin.vm.linker :as linker]\n    40\t            [yin.vm.linker.dht :as linker.dht]))\n    41\t\n    42\t\n    43\t(def pair-capacity\n    44\t  \"Declared capacity of each link-pair medium, in elements.  The shell\n    45\t   appends one request per require, and a response medium a receiver\n    46\t   never drains answers `gap` (an evicted request is never re-read), so\n    47\t   the bound is generous and the eviction it guards against is a host\n    48\t   assembly defect, not an operating condition.\"\n    49\t  1024)\n    50\t\n    51\t\n    52\t(def content-capacity\n    53\t  \"Declared capacity of each content-pair medium, in elements.  One\n    54\t   attempt's traffic is a handful of requests; the media persist across\n    55\t   attempts and every attempt mints its cursors at their newest end, so\n    56\t   an old element is never read again.\"\n    57\t  1024)\n    58\t\n    59\t\n    60\t(def attempt-budget\n    61\t  \"Drive rounds one link attempt may spend before it reports `:pending`.\n    62\t   A local pair answers within a few rounds per content request, so the\n    63\t   budget is reached only by a content source that never answers.\"\n    64\t  64)\n    65\t\n    66\t\n    67\t(def serve-steps\n    68\t  \"Server advances one drive round performs at most.  Each answers at\n    69\t   least one waiting content request, so a local pair drains in a bound\n    70\t   number of rounds.\"\n    71\t  32)\n    72\t\n    73\t\n    74\t(def serve-budget\n    75\t  \"Link requests one serve round answers, in request order.  It exceeds\n    76\t   what one evaluation's requires can enqueue, so a round that spends it\n    77\t   is answering a queue the shell did not write.\"\n    78\t  64)\n    79\t\n    80\t\n    81\t(def formats\n    82\t  \"The six format records a serving composition holds (sections 5 and\n    83\t   8.1): the four execution formats a requesting kernel names, and the\n    84\t   two the manifest flow fetches internally.\"\n    85\t  (into {}\n    86\t        (map (fn [r] [(:format r) r]))\n    87\t        [linker/ast-format linker/semantic-format linker/stack-format\n    88\t         linker/register-format linker/manifest-format\n    89\t         linker/record-format]))\n    90\t\n    91\t\n    92\t(defn- medium\n    93\t  [capacity]\n    94\t  (:dao.stream/handle\n    95\t    (ring/create! {:dao.stream/type ring/transport-type\n    96\t                   ring/capacity-key capacity})))\n    97\t\n    98\t\n    99\t(defn- newest\n   100\t  [handle]\n   101\t  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))\n   102\t\n   103\t\n   104\t(defn make-pair\n   105\t  \"The link pair of one session (section 6.1): the request and response\n   106\t   media, and the interpreter's own request cursor, minted before any\n   107\t   request exists.\"\n   108\t  []\n   109\t  (let [requests (medium pair-capacity)\n   110\t        responses (medium pair-capacity)]\n   111\t    {:requests requests\n   112\t     :responses responses\n   113\t     :cursor (:dao.stream/cursor\n   114\t               (stream/cursor requests stream/anchor-oldest))}))\n   115\t\n   116\t\n   117\t(defn composition\n   118\t  \"The content side of the shell's link composition, from the host's\n   119\t   creation options.  `content-store` is a `dao.jing` byte-store handle\n   120\t   served in process over its own ring-buffer content pair (the\n   121\t   single-process and durable-local rows of section 6.1);\n   122\t   `content-client` is the linker's content-pair client map\n   123\t   `{:requests w :answers r :cursor c}` on a connection whose far end\n   124\t   serves content (the remote-content row), and the drive then only\n   125\t   steps the linker, the server running elsewhere (section 6.4).  A\n   126\t   content source is optional: with none, every link stays `:pending`\n   127\t   and says so.  Supplying both is a composition defect.  `dht?` is the\n   128\t   DHT link source (yin.vm.linker.dht.md 4.1): it reads content from the\n   129\t   node each serve round is handed, holds nothing here, and is refused\n   130\t   together with either content source.\n   131\t\n   132\t   `principals` are the public keys (64 lowercase hex) whose signed name\n   133\t   assertions the reader honors (yin.vm.linker.dht.md 7.1), and `key`\n   134\t   the node's own publisher key, whose principal is declared too (6.5):\n   135\t   a node resolves the names it published.  Only the public half is\n   136\t   kept here.\"\n   137\t  [{:keys [name-env content-store content-client dht? principals key]}]\n   138\t  (when (and content-store content-client)\n   139\t    (throw (ex-info \"content-store and content-client are exclusive\"\n   140\t                    {:content-store content-store})))\n   141\t  (when (and dht? (or content-store content-client))\n   142\t    (throw (ex-info (str \"a dht:<dir> index store is the link source; \"\n   143\t                         \"content-store and content-client are refused with it\")\n   144\t                    {:dht? dht?})))\n   145\t  {:name-env (or name-env {})\n   146\t   :principals (vec (distinct (cond-> (vec principals)\n   147\t                                key (conj (:public key)))))\n   148\t   :content (cond\n   149\t              dht? {:kind :dht}\n   150\t\n   151\t              content-store\n   152\t              {:kind :local\n   153\t               :store content-store\n   154\t               :requests (medium content-capacity)\n   155\t               :responses (medium content-capacity)}\n   156\t\n   157\t              content-client\n   158\t              {:kind :remote, :client content-client}\n   159\t\n   160\t              :else nil)})\n   161\t\n   162\t\n   163\t(defn authority\n   164\t  \"The reader's authority of a link source (yin.vm.linker.dht.md 7.1):\n   165\t   its declared principals and its direct name entries, as the plain\n   166\t   `yin.vm.linker.dht/authority` composes them.\"\n   167\t  [source]\n   168\t  (linker.dht/authority (select-keys source [:principals :name-env])))\n   169\t\n   170\t\n   171\t;; =============================================================================\n   172\t;; One link attempt\n   173\t;; =============================================================================\n   174\t\n   175\t(defn- budget-spent?\n   176\t  \"Whether `e` is the pending signal an exhausted attempt budget throws.\"\n   177\t  [e]\n   178\t  (true? (get (ex-data e) ::budget)))\n   179\t\n   180\t\n   181\t(defn- budget!\n   182\t  [st]\n   183\t  (when (>= (or (::round st) 0) attempt-budget)\n   184\t    (throw (ex-info \"Link attempt budget exhausted\" {::budget true}))))\n   185\t\n   186\t\n   187\t(defn- drain-server\n   188\t  \"Answer what is waiting on the content pair from the store, in at most\n   189\t   `serve-steps` serve-step advances, and return the successor server\n   190\t   cursor.\"\n   191\t  [store requests responses cursor]\n   192\t  (loop [cursor cursor\n   193\t         left serve-steps]\n   194\t    (if (zero? left)\n   195\t      cursor\n   196\t      (let [cursor' (content/serve-step store requests cursor\n   197\t                                        responses serve-steps)]\n   198\t        (if (= cursor cursor')\n   199\t          cursor\n   200\t          (recur cursor' (dec left)))))))\n   201\t\n   202\t\n   203\t(defn- attempt-runtime\n   204\t  \"The link runtime of one attempt (section 6.4): `:state` over the\n   205\t   content pair, `:drive` the composition's driver.  Both of the pair's\n   206\t   cursors are minted before the attempt's first append -- `:newest`\n   207\t   observes next arrival -- so nothing of an earlier attempt is read\n   208\t   again and nothing of this one is skipped.  The drive counts its\n   209\t   rounds and holds the server cursor on the linker state itself, so an\n   210\t   attempt that exhausts `attempt-budget` throws the pending signal and\n   211\t   the caller reports the link `:pending` -- nothing on the pair was\n   212\t   concluded.\"\n   213\t  [source]\n   214\t  (let [content (:content source)]\n   215\t    (case (:kind content)\n   216\t      :local\n   217\t      (let [requests (:requests content)\n   218\t            responses (:responses content)\n   219\t            server0 (newest requests)]\n   220\t        {:state (linker/link-state\n   221\t                  {:content {:requests requests\n   222\t                             :answers responses\n   223\t                             :cursor (newest responses)}\n   224\t                   :formats formats})\n   225\t         :drive (fn [st]\n   226\t                  (budget! st)\n   227\t                  (assoc st\n   228\t                         ::round (inc (or (::round st) 0))\n   229\t                         ::server (drain-server (:store content) requests\n   230\t                                                responses\n   231\t                                                (or (::server st)\n   232\t                                                    server0))))})\n   233\t\n   234\t      :remote\n   235\t      {:state (linker/link-state {:content (:client content)\n   236\t                                  :formats formats})\n   237\t       :drive (fn [st]\n   238\t                (budget! st)\n   239\t                (assoc st ::round (inc (or (::round st) 0))))})))\n   240\t\n   241\t\n   242\t(defn- attempt\n   243\t  \"Link one resolved name to its manifest image, or `::pending`.  The\n   244\t   requester's contract and name travel as `link-manifest` expects them;\n   245\t   step 5b is deferred to the receiving task.\"\n   246\t  [source request address]\n   247\t  (try\n   248\t    (let [res (linker/link-manifest (attempt-runtime source)\n   249\t                                    address\n   250\t                                    (:yin.link/format request)\n   251\t                                    {}\n   252\t                                    {:contract (:yin.link/contract request)\n   253\t                                     :name (:yin.link/name request)\n   254\t                                     :defer-discharge true})]\n   255\t      (if (linker/ok? res)\n   256\t        {:status :ok\n   257\t         :image {:value (:value res)}\n   258\t         :manifest (:manifest res)\n   259\t         :obligations (:obligations res)}\n   260\t        res))\n   261\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   262\t      (when-not (budget-spent? e) (throw e))\n   263\t      ::pending)))\n   264\t\n   265\t\n   266\t;; =============================================================================\n   267\t;; The DHT link source (yin.vm.linker.dht.md 4.1)\n   268\t;; =============================================================================\n   269\t\n   270\t(defn- dht-link\n   271\t  \"Link the loaded closure of `address` over a local runtime on the\n   272\t   node's store (`yin.vm.linker/local-runtime`), `:verifying`, discharge\n   273\t   deferred.  A local store answers every content request at once, so no\n   274\t   attempt budget applies; an `:absent` refusal after the load is a\n   275\t   walker defect, `:yin.link.dht/closure-incomplete`.\"\n   276\t  [node request address]\n   277\t  (let [res (linker/link-manifest\n   278\t              (linker/local-runtime (dht/store node) {:formats formats})\n   279\t              address\n   280\t              (:yin.link/format request)\n   281\t              {}\n   282\t              {:contract (:yin.link/contract request)\n   283\t               :name (:yin.link/name request)\n   284\t               :derivation :verifying\n   285\t               :defer-discharge true})]\n   286\t    (cond\n   287\t      (linker/ok? res) {:status :ok\n   288\t                        :image {:value (:value res)}\n   289\t                        :manifest (:manifest res)\n   290\t                        :obligations (:obligations res)}\n   291\t      (= :absent (:reason res)) {:status :refused\n   292\t                                 :reason :yin.link.dht/closure-incomplete\n   293\t                                 :address (:address res)}\n   294\t      :else res)))\n   295\t\n   296\t\n   297\t(defn- dht-attempt\n   298\t  \"One attempt against the DHT source for the resolved `address`:\n   299\t   `{:node n :body b}`, `b` `::pending` with `:waits` the manifest whose\n   300\t   load the link waits on.  No record starts the load; `:loading` waits;\n   301\t   `:failed` is refused and forgotten, so a later require loads again;\n   302\t   `:loaded` checks the dependency bindings, the first that is not `:ok`\n   303\t   refusing before any link, then links.\"\n   304\t  [node authority request address]\n   305\t  (let [status (linker.dht/module-status node address)]\n   306\t    (cond\n   307\t      (nil? status) {:node (linker.dht/load-module node address)\n   308\t                     :body ::pending\n   309\t                     :waits address}\n   310\t\n   199\t(defn- hydrated\n   200\t  \"Install the loaded remote index as this directory's: HEAD first, then\n   201\t   the indexer, exactly as a restart's recovery is installed.\"\n   202\t  [shell node]\n   203\t  (let [manifest (::hydrating node)\n   204\t        recovery {:manifest manifest :datoms (dht/loaded-datoms node manifest)}]\n   205\t    ((:head-fn (dht/local node)) manifest)\n   206\t    (-> shell\n   207\t        (update :indexer index/rehydrate recovery)\n   208\t        (assoc :index-recovery recovery\n   209\t               :dht (dissoc node ::hydrating)))))\n   210\t\n   211\t\n   212\t(defn step\n   213\t  \"Advance the shell's node once at the host's clock reading `now`\n   214\t   (dao.space.dht/step) and answer `[shell' lines events]`: its events as\n   215\t   lines, and as the data the ticker reads to re-check a pending require\n   216\t   (yin.repl/recheck-on-load-events), a completed hydration installed, a\n   217\t   failed one or a failed bind recorded as the shell's refusal.  A shell\n   218\t   without a DHT store is answered unchanged.\"\n   219\t  [shell now]\n   220\t  (if-let [node (:dht shell)]\n   221\t    (let [[node events] (dht/step node now)\n   222\t          lines (mapv #(event-line node %) events)\n   223\t          hydrating (::hydrating node)\n   224\t          status (when hydrating (:status (dht/load-status node hydrating)))\n   225\t          node (cond-> node\n   226\t                 (and hydrating (= :failed status))\n   227\t                 (assoc ::refusal (str/join \"\\n\" (filter #(str/includes? % \"refused\")\n   228\t                                                         lines)))\n   229\t                 (dht/refusal node)\n   230\t                 (assoc ::refusal (dht/refusal node)))\n   231\t          shell (assoc shell :dht node)]\n   232\t      [(if (= :loaded status) (hydrated shell node) shell) lines events])\n   233\t    [shell [] []]))\n   234\t\n   235\t\n   236\t(defn refusal\n   237\t  \"The text that refused the shell's DHT store after startup — a failed\n   238\t   bind or a hydration that could not complete — or nil.\"\n   239\t  [shell]\n   240\t  (get-in shell [:dht ::refusal]))\n   241\t\n   242\t\n   243\t(defn admitting?\n   244\t  \"True when the shell may evaluate: no hydration is outstanding and none\n   245\t   was refused.\"\n   246\t  [shell]\n   247\t  (let [node (:dht shell)]\n   248\t    (or (nil? node)\n   249\t        (and (nil? (::hydrating node)) (nil? (::refusal node))))))\n   250\t\n   251\t\n   252\t(defn busy?\n   253\t  \"True while the node owes the REPL a line; the ticker keeps its base\n   254\t   cadence then.\"\n   255\t  [shell]\n   256\t  (boolean (some-> (:dht shell) dht/busy?)))\n   257\t\n   258\t\n   259\t(defn banner\n   260\t  \"What the REPL states at startup about a DHT store spec, before the\n   261\t   node steps once — and so before anything is shared.\"\n   262\t  [{:keys [dir peers publish? bind-host bind-port]}]\n   263\t  (let [content (durable/content-path dir)\n   264\t        peers-text (str/join \", \" (map #(address-text (:host %) (:port %)) peers))]\n   265\t    (cond-> []\n   266\t      (empty? peers)\n   267\t      (conj (str \"dht: solo — no --dht-peer, so no socket is opened; \"\n   268\t                 \"publications are durable in \" dir \" and acknowledged by no one\"))\n   269\t\n   270\t      (seq peers)\n   271\t      (conj (str \"dht: binding \" (address-text bind-host bind-port)\n   272\t                 (when (zero? bind-port) \" (ephemeral)\")\n   273\t                 \"; peers \" peers-text))\n   274\t\n   275\t      (and publish? (seq peers))\n   276\t      (conj (str \"dht: publishing is ON. Everything in \" content\n   277\t                 \" will be shared: the whole code index this directory holds\"\n   278\t                 \" — every program recovered from HEAD and every program\"\n   279\t                 \" evaluated from now on — with any peer that asks for its\"\n   280\t                 \" address. Omit --dht-publish to fetch only.\"))\n   281\t\n   282\t      (and publish? (empty? peers))\n   283\t      (conj (str \"dht: publishing is on, but solo: nothing in \" content\n   284\t                 \" leaves this process\"))\n   285\t\n   286\t      (and (not publish?) (seq peers))\n   287\t      (conj \"dht: fetch-only — nothing this node holds is shared (--dht-publish shares it)\")\n   288\t\n   289\t      true\n   290\t      (conj (str \"dht: a (require ...) of a module this node does not hold \"\n","exit_code":0,"status":"completed"}}
