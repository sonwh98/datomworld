 bound to `$`, the first database input it names,\n   484\t   then the AST relations it names, in declared order.  The index is\n   485\t   implicit: a query's `:in` names only the caller's inputs, with or\n   486\t   without `$` among them, and those inputs fill the other patterns in\n   487\t   order.  A query without `:in` takes none.\"\n   488\t  [query]\n   489\t  (let [declared (in-patterns query)\n   490\t        in (-> ['$] (into (ast-patterns query)) (into (caller-patterns query)))]\n   491\t    (cond (nil? declared) query\n   492\t          (map? query) (assoc query :in in)\n   493\t          :else (let [[before [_ & after]] (split-with #(not= :in %) query)]\n   494\t                  (-> (vec before)\n   495\t                      (conj :in)\n   496\t                      (into in)\n   497\t                      (into (drop-while (complement keyword?) after)))))))\n   498\t\n   499\t\n   500\t(defn- view-of\n   501\t  \"The view the options name, or a refusal.\"\n   502\t  [options]\n   503\t  (cond\n   504\t    (nil? options) (:current views)\n   505\t\n   506\t    (not= #{:view} (set (keys options)))\n   507\t    (invalid (str \"q options must be {:view :current} or {:view :history}, got \"\n   508\t                  (pr-str options)))\n   509\t\n   510\t    (contains? views (:view options)) (get views (:view options))\n   511\t\n   512\t    :else (invalid (str \"q :view must be :current or :history, got \"\n   513\t                        (pr-str (:view options))))))\n   514\t\n   515\t\n   516\t(defn- row-count\n   517\t  \"Rows of a collected result: a relation or collection counts its\n   518\t   members, a scalar or tuple is one.\"\n   519\t  [result]\n   520\t  (if (or (set? result) (sequential? result) (nil? result))\n   521\t    (count result)\n   522\t    1))\n   523\t\n   524\t\n   525\t(defn- bounded\n   526\t  \"The collected result `run` answers, `{:ok value}`, or a refusal: a\n   527\t   query the engine rejects, a result over `limits`, or one that is not\n   528\t   portable Yin data.\"\n   529\t  [run {:keys [row-limit byte-limit]}]\n   530\t  (let [result (try\n   531\t                 {:value (run)}\n   532\t                 (catch #?(:cljd Object :clj Exception :cljs :default) e\n   533\t                   {:refusal (refusal ::query-failed\n   534\t                                      (str \"query failed: \"\n   535\t                                           (or (ex-message e) (str e)))\n   536\t                                      nil)}))]\n   537\t    (if-let [r (:refusal result)]\n   538\t      r\n   539\t      (let [value (:value result)\n   540\t            rows (row-count value)\n   541\t            size (when (<= rows row-limit) (encoded-size value))]\n   542\t        (cond\n   543\t          (> rows row-limit)\n   544\t          (refusal ::result-limit\n   545\t                   (str \"the query result has \" rows\n   546\t                        \" rows, over the limit of \" row-limit)\n   547\t                   {::limit {:rows row-limit}})\n   548\t\n   549\t          (nil? size)\n   550\t          (refusal ::query-failed\n   551\t                   \"the query result is not portable Yin data\"\n   552\t                   nil)\n   553\t\n   554\t          (> size byte-limit)\n   555\t          (refusal ::result-limit\n   556\t                   (str \"the query result encodes to \" size\n   557\t                        \" bytes, over the limit of \" byte-limit)\n   558\t                   {::limit {:bytes byte-limit}})\n   559\t\n   560\t          :else {:ok value})))))\n   561\t\n   562\t\n   563\t(defn- evaluate\n   564\t  [db view query inputs limits]\n   565\t  (bounded #(query/collect (apply query/q query (view db) inputs)) limits))\n   566\t\n   567\t\n   568\t(defn answer\n   569\t  \"The response to one call-pair `request`, answered from `indexer`, and\n   570\t   from `ast-indexer` for a query naming `$ast` or `$occ`, under `limits`\n   571\t   (`{:row-limit n :byte-limit n}`).  Without an AST indexer such a query\n   572\t   is refused.\"\n   573\t  ([indexer limits request]\n   574\t   (answer indexer nil limits request))\n   575\t  ([indexer ast-indexer limits request]\n   576\t   (let [id (apply2/request-id request)\n   577\t         [query & more] (apply2/request-args request)\n   578\t         answer (cond\n   579\t                  (not= op (apply2/request-op request))\n   580\t                  (refusal :dao.stream.apply/unknown-operation\n   581\t                           \"No handler for operation\"\n   582\t                           nil)\n   583\t\n   584\t                  (nil? (encoded-size (apply2/request-args request)))\n   585\t                  (invalid (str \"q takes portable Yin data only: nil, booleans,\"\n   586\t                                \" numbers, strings, keywords, symbols, and\"\n   587\t                                \" vectors, lists, sets and maps of them\"))\n   588\t\n   589\t                  (not (or (vector? query) (map? query)))\n   590\t                  (invalid (str \"q expects a query vector or map, got \"\n   591\t                                (pr-str query)))\n   592\t\n   593\t                  :else\n   594\t                  (let [split (split-args query more)\n   595\t                        [inputs options] (when-not (refused? split) split)\n   596\t                        view (when-not (refused? split) (view-of options))\n   597\t                        db (when-not (or (refused? split) (refused? view))\n   598\t                             (snapshot indexer))\n   599\t                        sources (when-not (or (refused? split) (refused? view)\n   600\t                                              (refused? db))\n   601\t                                  (ast-relations ast-indexer\n   602\t                                                 (ast-patterns query)))]\n   603\t                    (cond\n   604\t                      (refused? split) split\n   605\t                      (refused? view) view\n   606\t                      (refused? db) db\n   607\t                      (refused? sources) sources\n   608\t                      :else (evaluate db view (with-index query)\n   609\t                                      (into sources inputs) limits))))]\n   610\t     (if (refused? answer)\n   611\t       {apply2/id-key id, apply2/error-key answer}\n   612\t       (apply2/success-response id (:ok answer))))))\n   613\t\n   614\t\n   615\t(defn- host-status\n   616\t  \"A load status as the host answers it: the status without its loaded\n   617\t   value, which an index load counts under `:datoms` instead.\"\n   618\t  [status]\n   619\t  (when status\n   620\t    (cond-> (dissoc status :value)\n   621\t      (and (= :loaded (:status status)) (= dht/index-kind (:kind status)))\n   622\t      (assoc :datoms (count (:value status))))))\n   623\t\n   624\t\n   625\t(defn- publication-call\n   626\t  \"`[node' answer]` of `retry!` or `cancel!` on `manifest`: `ok` answers\n   627\t   `ok`; the plain function's refusal is answered under its own code.\"\n   628\t  [node manifest f ok]\n   629\t  (try [(f node manifest) {:ok ok}]\n   630\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   631\t         (if-let [code (:dao.space.dht/refused (ex-data e))]\n   632\t           [node (refusal code (ex-message e) nil)]\n   633\t           (throw e)))))\n   634\t\n   635\t\n   636\t(defn- dht-answer\n   637\t  \"The response to one `dao.space.dht` call, answered from `node` — the\n   638\t   shell's DHT node — by the `dao.space.dht` function the operation\n   639\t   names, and the node after it: `load-index` starts a load and answers\n   640\t   its status at once, never waiting; `load-status` answers the load's\n   641\t   status map; `q` answers `dao.space.dht/q` under `limits`, refused\n   642\t   until the index is loaded; `retry` and `cancel` answer `:retrying`\n   643\t   and `:cancelled`, or the plain function's refusal; `load-module`\n   644\t   starts a closure load and answers its status, and `module-status`\n   645\t   answers it without the loaded closure.  Answers\n   646\t   `[node response]`.\"\n   647\t  [node limits request]\n   648\t  (let [id (apply2/request-id request)\n   649\t        [manifest & more] (apply2/request-args request)\n   650\t        [node answer]\n   651\t        (cond\n   652\t          (nil? node)\n   653\t          [node (unavailable (str \"the shell has no DHT node; start it with \"\n   654\t                                  \"--index-store dht:<dir> and --dht-peer\"))]\n   655\t\n   656\t          (nil? (encoded-size (apply2/request-args request)))\n   657\t          [node (invalid \"dao.space.dht takes portable Yin data only\")]\n   658\t\n   659\t          (not (jing/segment-address? manifest))\n   660\t          [node (invalid (str \"dao.space.dht expects a manifest address, got \"\n   661\t                              (pr-str manifest)))]\n   662\t\n   663\t          :else\n   664\t          (case (apply2/request-op request)\n   665\t            ::dht-load-index\n   666\t            (let [node (dht/load-index node manifest)]\n   667\t              [node {:ok (:status (dht/load-status node manifest))}])\n   668\t\n   669\t            ::dht-load-status\n   670\t            [node {:ok (host-status (dht/load-status node manifest))}]\n   671\t\n   672\t            ::dht-load-module\n   673\t            (let [node (linker.dht/load-module node manifest)]\n   674\t              [node {:ok (:status (linker.dht/module-status node manifest))}])\n   675\t\n   676\t            ::dht-module-status\n   677\t            [node {:ok (host-status (linker.dht/module-status node manifest))}]\n   678\t\n   679\t            ::dht-retry\n   680\t            (publication-call node manifest dht/retry! :retrying)\n   681\t\n   682\t            ::dht-cancel\n   683\t            (publication-call node manifest dht/cancel! :cancelled)\n   684\t\n   685\t            ::dht-q\n   686\t            (let [status (dht/load-status node manifest)\n   687\t                  [query & inputs] more]\n   688\t              [node (if (= :loaded (:status status))\n   689\t                      (bounded #(apply dht/q node manifest query inputs) limits)\n   690\t                      (refusal ::index-unavailable\n   691\t                               (str \"the index \" manifest \" is not loaded (\"\n   692\t                                    (if status (name (:status status)) \"never asked\")\n   693\t                                    \"); (dao.space.dht/load-index \" manifest\n   694\t                                    \") loads it\")\n   695\t                               nil))])))]\n   696\t    [node (if (refused? answer)\n   697\t            {apply2/id-key id, apply2/error-key answer}\n   698\t            (apply2/success-response id (:ok answer)))]))\n   699\t\n   700\t\n   515\t    :else :unacknowledged))\n   516\t\n   517\t\n   518\t(defn- outstanding?\n   519\t  [node address]\n   520\t  (when-let [request (get-in node [:inflight address])]\n   521\t    (not (:settled? request))))\n   522\t\n   523\t\n   524\t(defn- attempting?\n   525\t  \"Whether `address` has a queue entry or an outstanding request.\"\n   526\t  [node address]\n   527\t  (or (contains? (:queued node) address) (outstanding? node address)))\n   528\t\n   529\t\n   530\t(defn- needed?\n   531\t  \"Whether the window or a live publication other than `except` (an id)\n   532\t   still takes an outcome for `address`.\"\n   533\t  [node address except]\n   534\t  (or (open-entry? (get-in node [:window :entries address]))\n   535\t      (some #(and (not= except (:id %))\n   536\t                  (not (:cancelled? %))\n   537\t                  (open-entry? (get-in % [:entries address])))\n   538\t            (:pubs node))))\n   539\t\n   540\t\n   541\t(defn- dequeue\n   542\t  \"`node` without `address`'s queue entry.\"\n   543\t  [node address]\n   544\t  (case (get-in node [:queued address])\n   545\t    :fresh (-> node\n   546\t               (update :queued dissoc address)\n   547\t               (update :fresh (fn [q] (filterv #(not= address %) q))))\n   548\t    :repair (-> node\n   549\t                (update :queued dissoc address)\n   550\t                (update :repair-owner dissoc address)\n   885\t                                (cond-> {:address a :reason (:reason e)\n   886\t                                         :peers (or (:peers e) 0)}\n   887\t                                  (:was e) (assoc :was (:was e)))))))\n   888\t                    (sort-by (comp str :address))\n   889\t                    vec)]\n   890\t    (cond-> {::event kind\n   891\t             :manifest (:manifest pub)\n   892\t             :result r\n   893\t             :blobs (:blobs pub)\n   894\t             :sent (:sent pub)\n   895\t             :failed failed\n   896\t             :repairing? (and (not= :acknowledged r) (nil? (:ended pub)))}\n   897\t      (pos? (:sent pub)) (assoc :peers (:min-peers pub))\n   898\t      (:ended pub) (assoc :ended (:ended pub)))))\n   899\t\n   900\t\n   901\t(defn- close-cycle\n   902\t  [node pub]\n   903\t  (let [{:keys [offered next sent?] :as cycle} (:cycle pub)]\n   904\t    (if (and cycle\n   905\t             (>= next (count offered))\n   906\t             (not-any? #(attempting? node %) offered))\n   907\t      (let [delay (if sent?\n   908\t                    (limit node :repair-ticks)\n   909\t                    (min (* 2 (:delay pub)) (limit node :repair-max-ticks)))]\n   910\t        (assoc pub\n   911\t               :cycle nil\n   912\t               :delay delay\n   913\t               :due (if (:retry? pub) (:reading node) (+ (:reading node) delay))\n   914\t               :retry? false))\n   915\t      pub)))\n   916\t\n   917\t\n   918\t(defn- ending\n   919\t  [pub]\n   920\t  (or (:ended pub)\n   921\t      (when (and (not= :acknowledged (result pub)) (zero? (:retryable pub)))\n   922\t        ::terminal)))\n   923\t\n   924\t\n   925\t(defn- evaluate\n   926\t  \"One publication's report this step, if any: `[pub' event-or-nil\n   927\t   retire?]`.\"\n   928\t  [node pub]\n   929\t  (cond\n   930\t    (:cancelled? pub)\n   931\t    (let [pub (assoc pub :ended ::cancelled)]\n   932\t      [pub (report (if (:reported? pub) :republished :published) pub) true])\n   933\t\n   934\t    (not (:reported? pub))\n   935\t    (if (pos? (:waiting pub))\n   960\t      (update :pubs (fn [pubs] (filterv #(not= (:id pub) (:id %)) pubs)))\n   961\t      (release-entries (:order pub) (:id pub))))\n   962\t\n   963\t\n   964\t(defn- displace\n   965\t  \"Beyond `:max-repairing`, retire the oldest repairing publications.\"\n   966\t  [node]\n   967\t  (loop [node node\n   968\t         events []]\n   969\t    (let [repairing (filter repairing? (:pubs node))]\n   970\t      (if (<= (count repairing) (limit node :max-repairing))\n   971\t        [node events]\n   972\t        (let [oldest (assoc (first repairing) :ended ::displaced)]\n   973\t          (recur (retire node oldest)\n   974\t                 (conj events (report :republished oldest))))))))\n   975\t\n   976\t\n   977\t(defn- settle-publications\n   978\t  [node]\n   979\t  (let [[node events retired]\n   980\t        (reduce (fn [[node events retired] i]\n   981\t                  (let [[pub event retire?] (evaluate node (get-in node [:pubs i]))]\n   982\t                    [(assoc-in node [:pubs i] pub)\n   983\t                     (cond-> events event (conj event))\n   984\t                     (cond-> retired retire? (conj pub))]))\n   985\t                [node [] []]\n   986\t                (range (count (:pubs node))))\n   295\t\n   296\t\n   297\t(defn- dht-attempt\n   298\t  \"One attempt against the DHT source for the resolved `address`:\n   299\t   `{:node n :body b}`, `b` `::pending` with `:waits` the manifest whose\n   300\t   load the link waits on.  No record starts the load; `:loading` waits;\n   301\t   `:failed` is refused and forgotten, so a later require loads again;\n   302\t   `:loaded` checks the dependency bindings, the first that is not `:ok`\n   303\t   refusing before any link, then links.\"\n   304\t  [node authority request address]\n   305\t  (let [status (linker.dht/module-status node address)]\n   306\t    (cond\n   307\t      (nil? status) {:node (linker.dht/load-module node address)\n   308\t                     :body ::pending\n   309\t                     :waits address}\n   310\t\n   311\t      (= :loading (:status status)) {:node node, :body ::pending, :waits address}\n   312\t\n   313\t      (= :failed (:status status)) {:node (dht/forget node address)\n   314\t                                    :body (linker.dht/load-refusal status)}\n   315\t\n   316\t      :else\n   317\t      (let [bindings (linker.dht/dependency-bindings node authority address)\n   318\t            unbound (if (map? bindings)\n   319\t                      bindings\n   320\t                      (some (fn [b]\n   321\t                              (when-not (= :ok (:binding b))\n   322\t                                (merge {:status :refused\n   323\t                                        :reason :yin.link.dht/dependency-binding}\n   324\t                                       b)))\n   325\t                            bindings))]\n   326\t        {:node node\n   327\t         :body (or unbound (dht-link node request address))}))))\n   328\t\n   329\t\n   330\t(defn- answer\n   331\t  \"The response body for one link request under `:body`, or `::pending`\n   332\t   when nothing this round can answer it: no content source, an attempt\n   333\t   that spent its budget, or a DHT closure load not yet ended (its\n   334\t   manifest under `:waits`).  `:node` is the shell's DHT node after the\n   335\t   answer.  A request that is not by name is refused: the interpreter\n   336\t   serves what the shell's own VMs send, the by-name manifest requests\n   337\t   of section 7.2, and nothing else.\"\n   338\t  [source node request]\n   339\t  (let [name (:yin.link/name request)\n   340\t        dht? (= :dht (get-in source [:content :kind]))]\n   341\t    (cond\n   342\t      (nil? (:content source)) {:node node, :body ::pending}\n   343\t\n   344\t      (nil? name)\n   345\t      {:node node\n   346\t       :body {:status :refused, :reason :invalid-request,\n   347\t              :defect :yin.repl/name-required}}\n   348\t\n   349\t      dht?\n   350\t      (let [declared (authority source)\n   351\t            entry (linker.dht/resolve-name node declared name)]\n   352\t        (if (= :ok (:status entry))\n   353\t          (dht-attempt node declared request (:address entry))\n   354\t          {:node node, :body entry}))\n   355\t\n   356\t      :else\n   357\t      {:node node\n   358\t       :body (if-let [address (get (:name-env source) name)]\n   359\t               (attempt source request address)\n   360\t               {:status :refused, :reason :absent, :name name})})))\n   361\t\n   362\t\n   363\t(defn- respond!\n   364\t  \"Append `body` under the request's id on the response stream.  Returns\n   365\t   true when it landed, so the interpreter's cursor advances past the\n   366\t   request only then; a refused append leaves it to be re-read.\"\n   367\t  [pair request body]\n   368\t  (let [o (stream/append! (:responses pair)\n   369\t                          (assoc body :yin.link/id (:yin.link/id request)))]\n   370\t    (= :dao.stream/ok (:dao.stream/outcome o))))\n   371\t\n   372\t\n   373\t(defn serve\n22:            [yin.repl.dht :as repl.dht]\n258:       \"  (require (quote m))  - link module m; with a dht:<dir> index store\"\n263:       \" indexed code under the --dht-key principal, and (yin.link/names)\"\n843:   `{:type :dht :dir dir ...}` is the DHT store (yin.repl.dht): that\n844:   durable directory store with a `dao.jing.dht` node composed over it.\n845:   Its step-owner value is `:dht`, advanced only by `yin.repl.dht/step`\n848:   (yin.vm.linker.dht.md 4.1): a `(require ...)` of a name `name-env`\n853:   `:dht-key` is the publisher's stable key `{:seed :public}`, loaded\n854:   from its key file by the host (yin.vm.linker.dht.md 6.5); without it\n862:            index-store-spec dht-key principals]\n886:                        :dht? (= :dht (:type index-store-spec))\n888:                        :key dht-key})\n890:                         (if (= :dht (:type index-store-spec))\n891:                           (repl.dht/open index-store-spec)\n904:        :index-store (repl.dht/without-runner index-store)\n906:        :dht (:dht index-store)\n917:        :dht-key dht-key\n1317:                  ::dht (:dht state)\n1330:    (contains? d ::dht) (assoc :dht (::dht d))\n1341:   :key (:dht-key state)\n1392:                                    :dht (:dht state)}))\n1395:                                    :dht (:dht served)))\n1400:                                       :dht (:dht state)\n1409:                                      :dht (:dht answered)\n1925:   (yin.vm.linker.dht.md 8.2): `recheck-pending`, once, if and only if\n1926:   `events` -- one tick's `dao.space.dht/step` events -- hold a `:loaded`\n1933:                (and (contains? #{:loaded :load-failed} (:dao.space.dht/event e))\n1940:(defn- resume-pending\n1963:    (resume-pending state trimmed parsed)\nbb.edn:3:  {:doc \"Generate and compile the pinned grammars-v4 Python3 parser into build/antlr/python3/classes (antlr/python3/manifest.edn)\"\nbb.edn:4:   :task (shell \"clojure -M:antlr-gen\")}\nbb.edn:7:            :depends [build:yin-repl-node gen:python-antlr]\nbb.edn:10:  build:yin-repl-node\nbb.edn:11:  {:doc \"Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js\"\nbb.edn:39:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}}}\ndeps.edn:13:        ;; on; pinned to the tool version in :antlr-gen (they are one release)\ndeps.edn:20