n1625:            (pending-eval state state' vm' pending)\n1752:   new expander holds only the standard forms.  A require still pending\n1758:   published manifest (`yin.repl.index/carry-over`), so a rebuild never\n1773:          :pending-run nil}))\n1806:      abandon (abandon-pending state)\n1836:  \"Evaluate the lines retained while a require was pending, in the order\n1839:   after it stay retained, in order, on the new `:pending-run`.\"\n1846:      (:pending-run state) [(update-in state [:pending-run :pending-lines]\n1855:(defn- recheck-pending*\n1856:  \"One bounded re-check of the shell's `:pending-run`: serve the\n1859:   while it was pending, then `input`, evaluate against it -- consult\n1860:   the link policy when the re-check leaves the run pending, `:checks`\n1861:   counting this pending run's re-checks that made no progress and\n1865:   `recheck-pending`, which evaluates no line of its own.\"\n1867:  (let [parked (:pending-run state)]\n1869:      (let [[state' vm' pending progress?] (drive-links state (:vm parked))]\n1875:            (fold-queued [(assoc st :vm vm'' :pending-run nil) text]\n1876:                         (cond-> (vec (:pending-lines parked))\n1881:                                       :links pending\n1883:                          input (update :pending-lines\n1887:                                               :pending-run parked'))]\n1888:            (consult-link-policy st text (pending-text pending)))))\n1900:                                  :pending-run nil)\n1904:                  (dropped-lines-text (count (:pending-lines parked))))]\n1908:(defn recheck-pending\n1909:  \"One re-check of the shell's `:pending-run` without an input line --\n1913:   pending.  A re-check that completes the run folds the retained lines\n1915:   `text` nil when nothing is pending.  It reads no clock and takes no\n1918:  (if (:pending-run state)\n1919:    (recheck-pending* state nil)\n1924:  \"The host ticker's re-check of a pending run over a DHT link source\n1925:   (yin.vm.linker.dht.md 8.2): `recheck-pending`, once, if and only if\n1927:   or `:load-failed` event for a manifest a pending link waits on.  Any\n1931:  (let [waits (set (keep :manifest (get-in state [:pending-run :links])))]\n1936:      (recheck-pending state)\n1940:(defn- resume-pending\n1941:  \"One bounded re-check of the shell's `:pending-run` behind a typed\n1942:   line: while the run stays pending the line is retained -- the parked\n1946:  (recheck-pending* state {:trimmed trimmed, :parsed parsed}))\n1958:  (if (and (:pending-run state) (not (command-line? parsed)))\n1959:    ;; A require is still pending: re-check it first.  While it stays\n1960:    ;; pending the line is retained -- the parked VM owns the store a new\n1963:    (resume-pending state trimmed parsed)\n1970:   Input whose brackets do not balance is retained as `:pending-input` and\n1974:  (let [pending (or (:pending-input state) \"\")\n1975:        combined (if (str/blank? pending)\n1977:                   (str pending \"\\n\" (str/trim line)))]\n1979:      [(assoc state :pending-input combined) \"\"]\n1980:      (let [state' (assoc state :pending-input nil)\n1998:   further evaluation.  Each `:pending` entry carries the link policy's\n1999:   name (`:manual` or `:fn`) and the pending run's `:checks`, so a host\n2004:   is published, whether a gap lost the indexer, and its last failure.\n2023:   :pending (when-let [parked (:pending-run state)]\n2027:                         :link-id (:yin.link/id p)\n     1\t(ns yin.vm.linker.publish\n     2\t  \"Publish a complete four-format module closure into a DaoJing handle,\n     3\t   derive a module from indexed code (docs/design/yin.vm.linker.dht.md\n     4\t   5.3), and sign the name envelopes that bind it (6.1, 6.5, 6.6).\"\n     5\t  (:require [dao.jing :as jing]\n     6\t            [dao.space.query :as query]\n     7\t            [yin.vm :as vm]\n     8\t            [yin.vm.code :as code]\n     9\t            [yin.vm.debruijn-code :as dcode]\n    10\t            [yin.vm.debruijn-linearize :as dl]\n    11\t            [yin.vm.debruijn-register-code :as rcode]\n    12\t            [yin.vm.debruijn-register-compile :as rc]\n    13\t            [yin.vm.ledger :as ledger]\n    14\t            [yin.vm.linearize :as linearize]\n    15\t            [yin.vm.linker :as linker]\n    16\t            [yin.vm.linker.closure :as closure]\n    17\t            [yin.vm.linker.sign :as sign]))\n    18\t\n    19\t\n    20\t(defn- refusal\n    21\t  [reason data]\n    22\t  (merge {:status :refused :reason reason} data))\n    23\t\n    24\t\n    25\t(defn- definitions\n    26\t  [ast]\n    27\t  (letfn [(scan\n    28\t            [node]\n    29\t            (when (map? node)\n    30\t              (case (:type node)\n    31\t                :lambda #{}\n    32\t                :application\n    33\t                (let [xs (:operands node)\n    34\t                      own (when (and (vm/definition-operator? (:operator node))\n    35\t                                     (= 2 (count xs))\n    36\t                                     (= :literal (:type (first xs)))\n    37\t                                     (symbol? (:value (first xs))))\n    38\t                            #{(:value (first xs))})]\n    39\t                  (into (or own #{}) (mapcat scan)\n    40\t                        (concat (when (= :lambda (:type (:operator node)))\n    41\t                                  [(:body (:operator node))])\n    42\t                                xs)))\n    43\t                #{})))]\n    44\t    (scan ast)))\n    45\t\n    46\t\n    47\t(defn footprint\n    48\t  \"Derive the manifest footprint from tree rows, declared profiles and dependencies.\"\n    49\t  [handle {:keys [ast tree primitives requires]}]\n    50\t  (let [tree (or tree (vm/ast->semantic-bytecode ast))\n    51\t        own (vm/ast-requirements (query/relation (vals (:rows tree))))\n    52\t        bad-primitive (some (fn [[name profile]]\n    53\t                              (when-not (and (map? profile)\n    54\t                                             (keyword? (:yin.k/profile profile))\n    55\t                                             (set? (:yin.k/effects profile)))\n    56\t                                name))\n    57\t                            primitives)\n    58\t        missing (some (fn [[name address]]\n    59\t                        (let [manifest (jing/get handle address ::absent)]\n    60\t                          (when (= ::absent manifest) [name address])))\n    61\t                      requires)]\n    62\t    (cond\n    63\t      (seq (:ffi-ops own))\n    64\t      (refusal :yin.link.publish/ffi-op {:ffi-ops (:ffi-ops own)})\n    65\t\n    66\t      (seq (:parked-ids own))\n    67\t      (refusal :yin.link.publish/parked-id {:parked-ids (:parked-ids own)})\n    68\t\n    69\t      bad-primitive\n    70\t      (refusal :yin.link.publish/unprofiled-primitive\n    71\t               {:primitive bad-primitive})\n    72\t\n    73\t      missing\n    74\t      (refusal :yin.link.publish/missing-requirement\n    75\t               {:name (first missing) :manifest (second missing)})\n    76\t\n    77\t      :else\n    78\t      {:store-keys (:store-keys own)\n    79\t       :effects (into (or (:effects own) #{})\n    80\t                      (concat (mapcat :yin.k/effects (vals primitives))\n    81\t                              (mapcat (fn [address]\n    82\t                                        (get-in (jing/get handle address nil)\n    83\t                                                [:yin.module/footprint :effects]))\n    84\t                                      (vals requires))))})))\n    85\t\n    86\t\n    87\t(def code-formats\n    88\t  \"The four code format records a module manifest links through.\"\n    89\t  [linker/ast-format linker/semantic-format\n    90\t   linker/stack-format linker/register-format])\n    91\t\n    92\t\n    93\t(defn link-local\n    94\t  \"Link `format`'s image through the manifest `address` over `handle`'s\n    95\t   own content, `:verifying` with discharge deferred, as a serving\n    96\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\n    97\t   call, so no request reaches any peer.  `opts` overrides the link\n    98\t   options.\"\n    99\t  ([handle address format] (link-local handle address format nil))\n   100\t  ([handle address format opts]\n   101\t   (linker/link-manifest\n   102\t     (linker/local-runtime\n   103\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\n   104\t                              (conj code-formats linker/manifest-format\n   105\t                                    linker/record-format))})\n   106\t     address (:format format) {:primitives vm/primitives}\n   107\t     (merge {:contract (:contract format)\n   108\t             :derivation :verifying\n   109\t             :defer-discharge true}\n   110\t            opts))))\n   111\t\n   112\t\n   113\t(defn publish-module!\n   114\t  \"Mint all four code formats, derivation records, and one schema-1 manifest.\"\n   115\t  [handle {:keys [name ast exports requires primitives] :as spec}]\n   116\t  (let [undefined (first (remove (definitions ast) exports))\n   117\t        tree (when-not undefined\n   118\t               (try (vm/ast->semantic-bytecode ast)\n   119\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\n   120\t                      (refusal :yin.link.publish/malformed-tree {}))))\n   121\t        defect (when (and tree (not= :refused (:status tree)))\n   122\t                 (vm/validate-rows tree))\n   123\t        ;; each pinned closure is walked before anything is written; an\n   124\t        ;; absent pinned manifest is the footprint's missing-requirement\n   125\t        requirement\n   126\t        (when (and tree (not defect) (not= :refused (:status tree)))\n   127\t          (some (fn [[n address]]\n   128\t                  (let [w (closure/walk handle address)]\n   129\t                    (case (:yin.link.closure/outcome w)\n   130\t                      :complete nil\n   131\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n   132\t                                        {:name n})\n   133\t                      :missing (when (not= address (:address w))\n   134\t                                 (refusal :yin.link.publish/incomplete-requirement\n   135\t                                          {:name n :walk w})))))\n   136\t                (sort-by (fn [[n _]] (str n)) requires)))\n   137\t        fp (when (and tree (not defect) (not requirement)\n   138\t                      (not= :refused (:status tree)))\n   139\t             (footprint handle (assoc spec :tree tree)))]\n   140\t    (cond\n   141\t      undefined\n   142\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   143\t\n   144\t      (= :refused (:status tree)) tree\n   145\t\n   146\t      defect\n   147\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\n   148\t\n   149\t      requirement requirement\n   150\t\n   151\t      (= :refused (:status fp)) fp\n   152\t\n   153\t      :else\n   154\t      (let [tree-address (vm/materialize-tree! handle tree)\n   155\t            sem-vector (:vector (linearize/lower-rows tree))\n   156\t            sem (code/materialize-vector! handle sem-vector)\n   157\t            h-image (:image (dl/adapt (vm/ast->datoms ast)))\n   158\t            r-image (:image (rc/adapt (second (vm/ast->datoms-with-root ast))))\n   159\t            h (dcode/image-hash h-image)\n   160\t            r (rcode/register-hash r-image)\n   161\t            h-address (jing/materialize! handle h-image)\n   162\t            r-address (jing/materialize! handle r-image)\n   163\t            mint (fn [output profile]\n   164\t                   (jing/materialize!\n   165\t                     handle\n   166\t                     (assoc (ledger/derive-record tree-address output)\n   167\t                            :yin.ledger/profile profile)))\n   168\t            manifest {:yin.module/name name\n   169\t                      :yin.module/schema linker/manifest-schema\n   170\t                      :yin.module/contracts\n   171\t                      {:yin.ast/code vm/ast-contract\n   172\t                       :yin.semantic/code vm/semantic-contract\n   173\t                       :yin.debruijn.code vm/stack-contract\n   174\t                       :yin.debruijn.register vm/register-contract}\n   175\t                      :yin.module/tree tree-address\n   176\t                      :yin.module/derivations\n   177\t                      {:yin.semantic/code (mint sem ledger/lowering-profile)\n   178\t                       :yin.debruijn.code\n   179\t                       (mint h linker/stack-lowering-profile)\n   180\t                       :yin.debruijn.register\n   181\t                       (mint r linker/register-lowering-profile)}\n   182\t                      :yin.module/index {h h-address r r-address}\n   183\t                      :yin.module/exports (set exports)\n   184\t                      :yin.module/requires (or requires {})\n   185\t                      :yin.module/primitives\n   186\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   187\t                                    primitives))\n   188\t                      :yin.module/footprint fp}\n   189\t            address (jing/materialize! handle manifest)\n   190\t            walked (closure/walk handle address)]\n   191\t        (if (not= :complete (:yin.link.closure/outcome walked))\n   192\t          (refusal :yin.link.publish/incomplete-closure\n   193\t                   {:address address :walk walked})\n   194\t          (let [links (into {}\n   195\t                            (map (fn [f]\n   196\t                                   [(:format f) (link-local handle address f)]))\n   197\t                            code-formats)]\n   198\t            {:address address :manifest manifest\n   199\t             :identities {:yin.semantic/code sem\n   200\t                          :yin.debruijn.code h\n   201\t                          :yin.debruijn.register r}\n   202\t             :links links}))))))\n   203\t\n   204\t\n   205\t;; =============================================================================\n   206\t;; Deriving a module from indexed code (5.3)\n   207\t;; =============================================================================\n   208\t\n   209\t(defn- indexed-programs\n   210\t  \"Every program the index `db` holds -- a relation of `[e a v t m]` index\n   211\t   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\n   212\t   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\n   213\t   whose `m` is the program's metadata entity.\"\n   214\t  [db]\n   215\t  (let [by-m (group-by #(nth % 4)\n   216\t                       (query/collect\n   217\t                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\n   218\t                                  db)))]\n   219\t    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\n   220\t          (sort-by (juxt second first)\n   221\t                   (query/collect\n   222\t                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\n   223\t                              db))))))\n   224\t\n   225\t\n   226\t(defn- requirements\n   227\t  \"The modules `ast` requires at module level: every `(require 'm)`\n   228\t   application -- operator the variable `require`, one literal symbol\n   229\t   operand -- outside any lambda body but that of an immediately applied\n   230\t   lambda, as `definitions` scans.\"\n   231\t  [ast]\n   232\t  (letfn [(scan\n   233\t            [node]\n   234\t            (when (map? node)\n   235\t              (case (:type node)\n   236\t                :lambda #{}\n   237\t                :application\n   238\t                (let [xs (:operands node)\n   239\t                      own (when (and (= 'require (get-in node [:operator :name]))\n   240\t                                     (= :variable (get-in node [:operator :type]))\n   241\t                                     (= 1 (count xs))\n   242\t                                     (= :literal (:type (first xs)))\n   243\t                                     (symbol? (:value (first xs))))\n   244\t                            #{(:value (first xs))})]\n   245\t                  (into (or own #{}) (mapcat scan)\n   246\t                        (concat (when (= :lambda (:type (:operator node)))\n   247\t                                  [(:body (:operator node))])\n   248\t                                xs)))\n   249\t                #{})))]\n   250\t    (scan ast)))\n   251\t\n   252\t\n   253\t(defn- free-of\n   254\t  \"The free names of the map AST `ast` (`yin.vm/free-names`).\"\n   255\t  [ast]\n   256\t  (let [tree (vm/ast->semantic-bytecode ast)]\n   257\t    (vm/free-names (query/relation (vals (:rows tree)))\n   258\t                   (query/relation (vm/occurrences tree))\n   259\t                   (:root tree))))\n   260\t\n   261\t\n   262\t(def no-op-tree\n   263\t  \"The tree of a module that collects no program, which is the module of\n   264\t   an empty export list: one `nil` literal, defining nothing.\"\n   265\t  {:type :literal :value nil})\n   266\t\n   267\t\n   268\t(defn- sequenced\n   269\t  \"One tree running `asts` in order: `((fn [_] second) first)`, nested.\n   270\t   A program root in operand position is not a tail call.  No programs\n   271\t   is `no-op-tree`.\"\n   272\t  [asts]\n   273\t  (if (empty? asts)\n   274\t    no-op-tree\n   275\t    (reduce (fn [body ast]\n   276\t              {:type :application\n   277\t               :tail? true\n   278\t               :operator {:type :lambda :params '[_] :body body}\n   279\t               :operands [(cond-> ast\n   280\t                            (= :application (:type ast)) (assoc :tail? false))]})\n   281\t            (peek asts)\n   282\t            (rseq (pop asts)))))\n   283\t\n   284\t\n   285\t(defn- free-declaration\n   286\t  \"How the module declares the free name `n`: `[:requires module\n   287\t   address]`, `[:primitives n profile]`, or a refusal.\"\n   288\t  [n {:keys [primitives modules host-modules]}]\n   289\t  (let [module (some-> (namespace n) symbol)]\n   290\t    (cond\n   291\t      (and module (contains? modules module))\n   292\t      [:requires module (get modules module)]\n   293\t\n   294\t      (and module (contains? (set host-modules) module))\n   295\t      (refusal :yin.link.publish/host-module {:name n :module module})\n   296\t\n   297\t      (and (nil? module) (contains? primitives n))\n   298\t      [:primitives n (vm/profile-of primitives n)]\n   299\t\n   300\t      :else (refusal :yin.link.publish/undeclared-free {:name n}))))\n   301\t\n   302\t\n   303\t(defn module-from-index\n   304\t  \"`publish-module!`'s spec for the module `name` exporting `exports`,\n   305\t   derived from the indexed code of `db` (section 5.3), or a refusal.\n   306\t   Persists nothing.\n   307\t\n   308\t   The defining program of a symbol is the indexed program of greatest\n   309\t   `t` defining it at module level.  The exports' defining programs are\n   310\t   collected, then the defining program of every free name they hold\n   311\t   that some indexed program defines, and, for each linked module a free\n   312\t   qualified name declares, the latest program requiring that module at\n   313\t   module level (refused `:yin.link.publish/missing-require-program`\n   314\t   naming the module when none does), to a fixed point; the tree is the\n   315\t   collected programs, each once, in ascending `t`.  Each remaining free name is a\n   316\t   primitive of `primitives` (declared with its profile), or qualified by\n   317\t   a module of `modules` -- `{name manifest-address}`, the modules the\n   318\t   session linked -- (declared under `:requires`).  A name qualified by\n   319\t   one of `host-modules` refuses `:yin.link.publish/host-module`, any\n   320\t   other `:yin.link.publish/undeclared-free`.\"\n   321\t  [db {:keys [name exports modules] :as opts}]\n   322\t  (let [programs (mapv (fn [p]\n   323\t                         (assoc p\n   324\t                                :defines (definitions (:ast p))\n   325\t                                :requires (requirements (:ast p))\n   326\t                                :free (free-of (:ast p))))\n   327\t                       (indexed-programs db))\n   328\t        defining (fn [sym]\n   329\t                   (last (filter #(contains? (:defines %) sym) programs)))\n   330\t        requiring (fn [module]\n   331\t                    (last (filter #(contains? (:requires %) module) programs)))\n   332\t        ;; the linked modules the collected programs' free qualified names\n   333\t        ;; declare as requirements (closure by linked requirements)\n   334\t        linked (fn [ps]\n   335\t                 (sort-by str\n   336\t                          (distinct\n   337\t                            (keep (fn [n]\n   338\t                                    (let [m (some-> (namespace n) symbol)]\n   339\t                                      (when (and m (not (defining n))\n   340\t                                                 (contains? modules m))\n   341\t                                        m)))\n   342\t                                  (mapcat :free ps)))))\n   343\t        undefined (first (remove defining exports))]\n   344\t    (if undefined\n   345\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   346\t      (let [collected (loop [ms (set (map (comp :m defining) exports))]\n   347\t                        (let [ps (filterv #(contains? ms (:m %)) programs)\n   348\t                              unrequired (first (remove requiring (linked ps)))\n   349\t                              more (-> ms\n   350\t                                       (into (keep (comp :m defining))\n   351\t                                             (mapcat :free ps))\n   352\t                                       (into (keep (comp :m requiring))\n   353\t                                             (linked ps)))]\n   354\t                          (cond\n   355\t                            unrequired\n   356\t                            (refusal :yin.link.publish/missing-require-program\n   357\t                                     {:module unrequired})\n   358\t\n   359\t                            (= more ms) ps\n   360\t                            :else (recur more))))\n   361\t            declared (when (vector? collected)\n   362\t                       (map #(free-declaration % opts)\n   363\t                            (sort-by str\n   364\t                                     (remove defining\n   365\t                                             (distinct (mapcat :free collected))))))]\n   366\t        (or (when (map? collected) collected)\n   367\t            (some #(when (map? %) %) declared)\n   368\t            {:name name\n   369\t             :ast (sequenced (mapv :ast collected))\n   370\t             :exports (set exports)\n   371\t             :requires (into {}\n   372\t                             (keep (fn [[k n a]] (when (= :requires k) [n a])))\n   373\t                             declared)\n   374\t             :primitives (into {}\n   375\t                               (keep (fn [[k n p]] (when (= :primitives k) [n p])))\n   376\t                               declared)})))))\n   377\t\n   378\t\n   379\t;; =============================================================================\n   380\t;; Name envelopes (6.1, 6.5, 6.6)\n   381\t;; =============================================================================\n   382\t\n   383\t(defn- signed\n   384\t  [key env e]\n   385\t  (let [proof (sign/sign-envelope (:seed key) env)\n   386\t        e (if (some? e) e -1)]\n   387\t    {:envelope env\n   388\t     :proof proof\n   389\t     :datoms [[e :yin.module/envelope env] [e :yin.module/proof proof]]}))\n   390\t\n   391\t\n   392\t(defn assertion\n   393\t  \"The assertion envelope binding `name` to the module manifest\n   394\t   `manifest` at sequence `seq`, signed by `key` (`{:seed :public}`):\n   395\t   `{:envelope e :proof p :datoms [...]}`, the datoms of entity `e`\n   396\t   (default -1) as section 6.1 indexes them.\"\n   397\t  [key {:keys [name manifest seq e]}]\n   398\t  (signed key\n   399\t          {:yin.module/op :assert\n   400\t           :yin.module/name name\n   401\t           :yin.module/manifest manifest\n   402\t           :yin.module/asserted-by (sign/principal (:public key))\n   403\t           :yin.module/seq seq}\n   404\t          e))\n   405\t\n   406\t\n   407\t(defn retraction\n   408\t  \"The retraction of the assertion whose envelope id is `of`, at\n   409\t   sequence `seq`, signed by `key`; shaped as `assertion`'s answer.\"\n   410\t  [key {:keys [of seq e]}]\n   411\t  (signed key\n   412\t          {:yin.module/op :retract\n   413\t           :yin.module/of of\n   414\t           :yin.module/asserted-by (sign/principal (:public key))\n   415\t           :yin.module/seq seq}\n   416\t          e))\n   417\t\n   418\t\n   419\t(defn- own-envelopes\n   420\t  \"Every envelope of `principal` in the index `db`.\"\n   421\t  [db principal]\n   422\t  (filterv #(= principal (:yin.module/asserted-by %))\n   423\t           (map first\n   424\t                (query/collect\n   425\t                  (query/q '[:find ?env :where [_ :yin.module/envelope ?env _ _]]\n   426\t                           db)))))\n   427\t\n   428\t\n   429\t(defn next-seq\n   430\t  \"The publisher's next sequence (6.5): one more than the greatest\n   431\t   sequence among `key`'s own envelopes in its own index `db`, 1 when\n   432\t   there are none.  Derived, never stored.\"\n   433\t  [db key]\n   434\t  (inc (reduce max 0 (map :yin.module/seq\n   435\t                          (own-envelopes db (sign/principal (:public key)))))))\n   436\t\n   437\t\n   438\t(defn name-envelopes\n   439\t  \"What publishing `name` at `manifest` under `key` writes, given the\n   440\t   publisher's own index `db` (6.6): nothing when its standing assertion\n   441\t   already names `manifest`; otherwise a retraction of each standing\n   442\t   assertion naming another manifest, then the assertion, at consecutive\n   443\t   sequences from `next-seq`.  Each is `assertion`'s answer.\"\n   444\t  [db key name manifest]\n   445\t  (let [own (own-envelopes db (sign/principal (:public key)))\n   446\t        retracted (set (keep #(when (= :retract (:yin.module/op %))\n   447\t                                (:yin.module/of %))\n   448\t                             own))\n   449\t        standing (sort-by :yin.module/seq\n   450\t                          (filter #(and (= :assert (:yin.module/op %))\n   451\t                                        (= name (:yin.module/name %))\n   452\t                                        (not (contains? retracted\n   453\t                                                        (jing/segment-key %))))\n   454\t                                  own))\n   455\t        stale (remove #(= manifest (:yin.module/manifest %)) standing)\n   456\t        bound? (some #(= manifest (:yin.module/manifest %)) standing)\n   457\t        start (next-seq db key)]\n   458\t    (cond-> (vec (map-indexed (fn [i env]\n   459\t                                (retraction key {:of (jing/segment-key env)\n   460\t                                                 :seq (+ start i)}))\n   461\t                              stale))\n   462\t      (not bound?) (conj (assertion key {:name name :manifest manifest\n   463\t                                         :seq (+ start (count stale))})))))\n","exit_code":0,"status":"completed"}}
