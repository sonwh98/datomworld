     1	(ns yin.vm.integer
     2	  "The `integer` host module: exact-integer kernels a language prelude
     3	   writes its integer semantics over (C3 big-integer design, converged
     4	   rulings 1, 2, 5 and 11).
     5	
     6	   Every export is `:pure` with declared effects `#{}`. As with
     7	   `yin.vm.data`, the module is not part of `yin.vm/primitives`: a
     8	   composition whose runtime profile names it installs it explicitly with
     9	   `register-integer-module`, and Yin source reaches the exports as
    10	   `integer/add`, `integer/parse` and so on. Guest integers go through
    11	   these exports only; a VM's internal counters stay VM primitives.
    12	
    13	   Carriers. Every argument may be any exact-integer carrier the host has
    14	   (`yin.vm.integer.host`); every integer result is in its one canonical
    15	   carrier: native iff within signed 64 bits on the JVM and Dart, or
    16	   within +/-(2^53 - 1) on JS, else the host big integer. Each kernel
    17	   promotes its operands to the host big integer before it operates and
    18	   demotes the result after, so no result ever passes through a rounded
    19	   or wrapped native intermediate, and equal values are `=` on every
    20	   host. The kernels are written once here over the shim. Under a
    21	   `::max-bits` of 53 or more, `add`, `sub`, `mul` and `compare` first
    22	   try a native fast path on operands within +/-(2^53 - 1) whose result
    23	   is provably exact, and fall back to the big path otherwise.
    24	
    25	   Semantics, identical on every host:
    26	
    27	   - `add`, `sub`, `mul`, `neg` and `compare` are exact; `compare`
    28	     answers -1, 0 or 1.
    29	   - `quot-rem` answers `[q r]` truncated toward zero, `a = b*q + r`;
    30	     `floor-div-mod` answers Python's `[a // b, a % b]`: the quotient
    31	     rounds toward negative infinity and a non-zero remainder takes the
    32	     divisor's sign.
    33	   - `bit-and`, `bit-or`, `bit-xor` and `bit-not` act on infinite signed
    34	     two's complement, so `(bit-not a)` is `-a - 1`. `shift-left` is
    35	     `a * 2^k` and `shift-right` is `floor(a / 2^k)`; the count is any
    36	     exact integer and is never narrowed before it is checked, and a
    37	     right shift past the operand's length answers 0 or -1 without
    38	     building `2^k`.
    39	   - `bit-length` is the bit length of the absolute value, 0 for zero.
    40	   - The float exports (version 3) take and answer host binary64s: a JVM
    41	     `Double`, a Dart `double`, a JS `Number`. `to-float` is CPython's
    42	     `float(int)`, nearest with ties to even; `true-div` is CPython's
    43	     `int / int`, the exact ratio correctly rounded however large both
    44	     operands are, subnormal results included and a zero quotient
    45	     signed by the operands; a result that is not finite answers
    46	     `::float-overflow`. `compare-float` compares an integer with a
    47	     float exactly, -1, 0 or 1, never rounding the integer: the caller
    48	     excludes NaN, and an infinity compares by its sign. `from-float`
    49	     truncates a finite float toward zero, exactly. Each is one
    50	     algorithm over the shim, never a host conversion of a big integer.
    51	   - `pow` raises to a non-negative exponent exactly, by squaring.
    52	   - `parse` reads an optional `-` and one or more digits of `radix` (2
    53	     to 36, default 10, either letter case) exactly, never through a
    54	     float or a native-width parser. Signs other than `-`, prefixes,
    55	     underscores and whitespace are the prelude's syntax, not this
    56	     kernel's. `format` writes exact lowercase text, a `-` only when
    57	     negative, no prefix.
    58	
    59	   Limits (ruling 11) are explicit composition data with no default, in
    60	   bits and digits: `::max-bits` bounds the bit length of every integer
    61	   result, and `::max-digits` bounds the digit count `parse` reads and
    62	   `format` writes in a radix that is not a power of two. A result that
    63	   would breach `::max-bits` is refused before it is built wherever its
    64	   size is known in advance (`mul`, `shift-left`, `pow`).
    65	
    66	   A limit breach is returned, not thrown (version 2): the call answers
    67	   the keyword `::bit-limit` or `::digit-limit` in place of its result,
    68	   and a float result that is not finite answers `::float-overflow`
    69	   (version 3). Every other result is an integer, a float, a boolean, a
    70	   string or a pair, so the sum needs no tag, and a pair is never
    71	   answered with one half refused. A guest prelude translates the three
    72	   reasons into catchable guest exceptions; the Python profile maps
    73	   `::bit-limit` to `MemoryError` and `::digit-limit` to `ValueError`,
    74	   never `OverflowError` (`py/int-result`), and its translator must
    75	   learn `::float-overflow`, which is CPython's `OverflowError`, \"int too
    76	   large to convert to float\".
    77	
    78	   Every other refusal throws `ex-info` with the message
    79	   `refusal-message` and ex-data built here, never host exception text,
    80	   never an operand: `::op`, `::reason` and the reason's own keys. These
    81	   reasons are `:arity`, `:wrong-type`, `:out-of-range`, `:syntax`,
    82	   `:zero-division`, `:negative-count` and `:negative-exponent`: a
    83	   caller checks for them before the call, so reaching one is a defect
    84	   of the caller, and it stays a host failure, never a guest
    85	   exception."
    86	  (:require
    87	    [clojure.string :as str]
    88	    [yin.vm :as vm]
    89	    [yin.vm.integer.host :as host]
    90	    [yin.vm.module :as module]))
    91	
    92	
    93	(def module-name
    94	  "The module `register-integer-module` installs."
    95	  'integer)
    96	
    97	
    98	(def module-version
    99	  "The version of the kernels' contract. A change to any export's
   100	   semantics is a new version. Version 2 returns the limit reasons
   101	   instead of throwing them; version 3 adds `to-float`, `compare-float`,
   102	   `true-div`, `from-float` and the `::float-overflow` reason, and the
   103	   native fast paths inside `add`, `sub`, `mul` and `compare`, whose
   104	   results are unchanged."
   105	  3)
   106	
   107	
   108	(def refusal-message
   109	  "The message of every refusal an `integer` export throws."
   110	  "integer primitive refused")
   111	
   112	
   113	(defn- refuse!
   114	  [op reason data]
   115	  (throw (ex-info refusal-message (merge {::op op, ::reason reason} data))))
   116	
   117	
   118	(defn- wrong-type!
   119	  "Refuse argument `arg` (0-based) of `op`, which must be `expected`."
   120	  [op arg expected]
   121	  (refuse! op :wrong-type {::arg arg, ::expected expected}))
   122	
   123	
   124	;; =============================================================================
   125	;; Promotion, demotion and limits
   126	;; =============================================================================
   127	
   128	(def ^:private zero (host/from-native 0))
   129	(def ^:private one (host/from-native 1))
   130	(def ^:private neg-one (host/from-native -1))
   131	
   132	
   133	(defn- big!
   134	  "Argument `arg` of `op` promoted to the host big integer, or a
   135	   `:wrong-type` refusal."
   136	  [op arg x]
   137	  (if (host/exact-integer? x)
   138	    (host/promote x)
   139	    (wrong-type! op arg :integer)))
   140	
   141	
   142	(defn- sign
   143	  [b]
   144	  (host/compare-big b zero))
   145	
   146	
   147	(defn- bits
   148	  [b]
   149	  (host/magnitude-bit-length b))
   150	
   151	
   152	(defn- out
   153	  "Big integer result `b` in its canonical carrier, or `::bit-limit`."
   154	  [limits b]
   155	  (if (> (bits b) (::max-bits limits))
   156	    ::bit-limit
   157	    (host/demote b)))
   158	
   159	
   160	(defn- pair
   161	  "`[q r]`, or the first of them that is a limit reason."
   162	  [q r]
   163	  (cond (keyword? q) q
   164	        (keyword? r) r
   165	        :else [q r]))
   166	
   167	
   168	;; =============================================================================
   169	;; Arithmetic
   170	;; =============================================================================
   171	
   172	(defn- int-add
   173	  [limits a b]
   174	  (out limits (host/add (big! 'add 0 a) (big! 'add 1 b))))
   175	
   176	
   177	(defn- int-sub
   178	  [limits a b]
   179	  (out limits (host/sub (big! 'sub 0 a) (big! 'sub 1 b))))
   180	
   181	
   182	(defn- int-neg
   183	  [limits a]
   184	  (out limits (host/sub zero (big! 'neg 0 a))))
   185	
   186	
   187	(defn- int-mul
   188	  [limits a b]
   189	  (let [x (big! 'mul 0 a)
   190	        y (big! 'mul 1 b)]
   191	    ;; |x*y| has bits(x) + bits(y) or one fewer bits
   192	    (if (> (+ (bits x) (bits y) -1) (::max-bits limits))
   193	      ::bit-limit
   194	      (out limits (host/mul x y)))))
   195	
   196	
   197	(defn- int-compare
   198	  [_limits a b]
   199	  (host/compare-big (big! 'compare 0 a) (big! 'compare 1 b)))
   200	
   201	
   202	;; The fast table (version 3), installed only when ::max-bits >= 53, so
   203	;; a fast result needs no limit check. Results are those of the big path
   204	;; bit for bit, in the same carrier.
   205	
   206	(defn- safe-result?
   207	  [r]
   208	  (and (<= -9007199254740991 r) (<= r 9007199254740991)))
   209	
   210	
   211	(defn- small-native?
   212	  "A safe native of magnitude at most 2^26."
   213	  [x]
   214	  (and (host/safe-native? x) (<= -67108864 x) (<= x 67108864)))
   215	
   216	
   217	(defn- fast-add
   218	  [limits a b]
   219	  ;; a long cannot wrap below 2^54, and on JS a true sum of 2^53 or
   220	  ;; more rounds to 2^53 or more, so the range check is exact
   221	  (if (and (host/safe-native? a) (host/safe-native? b))
   222	    (let [r (+ a b)]
   223	      (if (safe-result? r) r (int-add limits a b)))
   224	    (int-add limits a b)))
   225	
   226	
   227	(defn- fast-sub
   228	  [limits a b]
   229	  (if (and (host/safe-native? a) (host/safe-native? b))
   230	    (let [r (- a b)]
   231	      (if (safe-result? r) r (int-sub limits a b)))
   232	    (int-sub limits a b)))
   233	
   234	
   235	(defn- fast-mul
   236	  [limits a b]
   237	  ;; |a*b| <= 2^52 with no result check: a long product can wrap back
   238	  ;; into range, so only an operand guard is sound. A zero product is
   239	  ;; the literal 0, never JS -0.
   240	  (if (and (small-native? a) (small-native? b))
   241	    (let [r (* a b)]
   242	      (if (zero? r) 0 r))
   243	    (int-mul limits a b)))
   244	
   245	
   246	(defn- fast-compare
   247	  [limits a b]
   248	  (if (and (host/safe-native? a) (host/safe-native? b))
   249	    (cond (< a b) -1
   250	          (> a b) 1
   251	          :else 0)
   252	    (int-compare limits a b)))
   253	
   254	
   255	(def ^:private fast-kernels
   256	  {'add fast-add, 'sub fast-sub, 'mul fast-mul, 'compare fast-compare})
   257	
   258	
   259	(defn- divisor!
   260	  [op b]
   261	  (let [y (big! op 1 b)]
   262	    (when (zero? (sign y))
   263	      (refuse! op :zero-division {}))
   264	    y))
   265	
   266	
   267	(defn- int-quot-rem
   268	  [limits a b]
   269	  (let [x (big! 'quot-rem 0 a)
   270	        y (divisor! 'quot-rem b)]
   271	    (pair (out limits (host/quot-trunc x y))
   272	          (out limits (host/rem-trunc x y)))))
   273	
   274	
   275	(defn- int-floor-div-mod
   276	  [limits a b]
   277	  (let [x (big! 'floor-div-mod 0 a)
   278	        y (divisor! 'floor-div-mod b)
   279	        q (host/quot-trunc x y)
   280	        r (host/rem-trunc x y)
   281	        adjust? (and (not (zero? (sign r))) (not= (sign r) (sign y)))]
   282	    (pair (out limits (if adjust? (host/sub q one) q))
   283	          (out limits (if adjust? (host/add r y) r)))))
   284	
   285	
   286	(defn- int-pow
   287	  [limits a e]
   288	  (let [x (big! 'pow 0 a)
   289	        n (big! 'pow 1 e)
   290	        max-bits (::max-bits limits)]
   291	    (cond
   292	      (neg? (sign n)) (refuse! 'pow :negative-exponent {})
   293	      (zero? (sign n)) 1
   294	      (or (zero? (sign x)) (zero? (host/compare-big x one))) (host/demote x)
   295	      (zero? (host/compare-big x neg-one))
   296	      (if (zero? (sign (host/bit-and-big n one))) 1 -1)
   297	      ;; |x| >= 2 from here, so |x^n| has at least n + 1 bits
   298	      (pos? (host/compare-big n (host/from-native max-bits))) ::bit-limit
   299	      (> (inc (* (dec (bits x)) (host/to-native n))) max-bits) ::bit-limit
   300	      :else
   301	      (out limits
   302	           (loop [result one
   303	                  base x
   304	                  n (host/to-native n)]
   305	             (let [result (if (odd? n) (host/mul result base) result)
   306	                   n (quot n 2)]
   307	               (if (zero? n)
   308	                 result
   309	                 (recur result (host/mul base base) n))))))))
   310	
   311	
   312	;; =============================================================================
   313	;; Bits
   314	;; =============================================================================
   315	
   316	(defn- int-bit-and
   317	  [limits a b]
   318	  (out limits
   319	       (host/bit-and-big (big! 'bit-and 0 a) (big! 'bit-and 1 b))))
   320	
   321	
   322	(defn- int-bit-or
   323	  [limits a b]
   324	  (out limits
   325	       (host/bit-or-big (big! 'bit-or 0 a) (big! 'bit-or 1 b))))
   326	
   327	
   328	(defn- int-bit-xor
   329	  [limits a b]
   330	  (out limits
   331	       (host/bit-xor-big (big! 'bit-xor 0 a) (big! 'bit-xor 1 b))))
   332	
   333	
   334	(defn- int-bit-not
   335	  [limits a]
   336	  (out limits (host/sub (host/sub zero (big! 'bit-not 0 a)) one)))
   337	
   338	
   339	(defn- count!
   340	  "Shift count argument `k` of `op` promoted, or a `:negative-count`
   341	   refusal."
   342	  [op k]
   343	  (let [n (big! op 1 k)]
   344	    (when (neg? (sign n))
   345	      (refuse! op :negative-count {}))
   346	    n))
   347	
   348	
   349	(defn- int-shift-left
   350	  [limits a k]
   351	  (let [x (big! 'shift-left 0 a)
   352	        n (count! 'shift-left k)
   353	        max-bits (::max-bits limits)]
   354	    (cond
   355	      (zero? (sign x)) 0
   356	      ;; |x << n| has exactly bits(x) + n bits
   357	      (pos? (host/compare-big n (host/from-native max-bits))) ::bit-limit
   358	      (> (+ (bits x) (host/to-native n)) max-bits) ::bit-limit
   359	      :else (out limits (host/shift-left-big x (host/to-native n))))))
   360	
   361	
   362	(defn- int-shift-right
   363	  [limits a k]
   364	  (let [x (big! 'shift-right 0 a)
   365	        n (count! 'shift-right k)]
   366	    (if (neg? (host/compare-big n (host/from-native (bits x))))
   367	      (out limits (host/shift-right-big x (host/to-native n)))
   368	      (if (neg? (sign x)) -1 0))))
   369	
   370	
   371	(defn- int-bit-length
   372	  [_limits a]
   373	  (bits (big! 'bit-length 0 a)))
   374	
   375	
   376	;; =============================================================================
   377	;; Floats (version 3)
   378	;; =============================================================================
   379	
   380	(defn- pow2
   381	  "2^`k` as a host double, exactly, for `k` from -1074 to 1023: every
   382	   intermediate is a power of two in range, and the base is squared only
   383	   while a higher bit of `k` remains."
   384	  [k]
   385	  (loop [result 1.0
   386	         base (if (neg? k) 0.5 2.0)
   387	         k (if (neg? k) (- k) k)]
   388	    (if (zero? k)
   389	      result
   390	      (recur (if (odd? k) (* result base) result)
   391	             (if (> k 1) (* base base) base)
   392	             (quot k 2)))))
   393	
   394	
   395	(def ^:private two-53-float (pow2 53))
   396	(def ^:private two-117-float (pow2 117))
   397	(def ^:private two-minus-64-float (pow2 -64))
   398	
   399	
   400	(defn- signed
   401	  "Host double `d`, negated when `negative?`. Multiplying by -1.0 keeps
   402	   the sign of a zero on every host."
   403	  [negative? d]
   404	  (if negative? (* -1.0 d) d))
   405	
   406	
   407	(defn- magnitude
   408	  [b]
   409	  (if (neg? (sign b)) (host/sub zero b) b))
   410	
   411	
   412	(defn- compare-scaled
   413	  "The sign of `x - y * 2^k` for big `x`, `y` and native `k`."
   414	  [x y k]
   415	  (if (neg? k)
   416	    (host/compare-big (host/shift-left-big x (- k)) y)
   417	    (host/compare-big x (host/shift-left-big y k))))
   418	
   419	
   420	(defn- ratio->float
   421	  "The binary64 nearest `x / y`, ties to even, for big `x >= 0` and
   422	   `y > 0`, negated when `negative?`; or `::float-overflow` when it is
   423	   not finite. One integer division of 53 or fewer quotient bits and one
   424	   exact scaling, so nothing rounds twice."
   425	  [x y negative?]
   426	  (let [e0 (- (bits x) (bits y))]
   427	    (cond
   428	      ;; x / y < 2^(e0 + 1): at least 2^1024, or below half the least
   429	      ;; subnormal 2^-1074
   430	      (zero? (sign x)) (signed negative? 0.0)
   431	      (> e0 1024) ::float-overflow
   432	      (< e0 -1076) (signed negative? 0.0)
   433	      :else
   434	      (let [;; 2^(e - 1) <= x / y < 2^e
   435	            e (if (neg? (compare-scaled x y e0)) e0 (inc e0))
   436	            ;; the quotient keeps 53 bits, fewer when subnormal
   437	            k (max (- e 53) -1074)
   438	            [num den] (if (neg? k)
   439	                        [(host/shift-left-big x (- k)) y]
   440	                        [x (host/shift-left-big y k)])
   441	            q (host/to-native (host/quot-trunc num den))
   442	            c (host/compare-big (host/shift-left-big
   443	                                  (host/rem-trunc num den) 1)
   444	                                den)
   445	            q (if (or (pos? c) (and (zero? c) (odd? q))) (inc q) q)]
   446	        ;; q <= 2^53, and q * 2^k is finite iff it is below 2^1024
   447	        (if (> (+ (bits (host/from-native q)) k) 1024)
   448	          ::float-overflow
   449	          (signed negative? (* (host/native->double q) (pow2 k))))))))
   450	
   451	
   452	(defn- int-to-float
   453	  [_limits a]
   454	  (let [x (big! 'to-float 0 a)]
   455	    (ratio->float (magnitude x) one (neg? (sign x)))))
   456	
   457	
   458	(defn- int-true-div
   459	  [_limits a b]
   460	  (let [x (big! 'true-div 0 a)
   461	        y (divisor! 'true-div b)]
   462	    ;; CPython: 0 / -5 is -0.0
   463	    (ratio->float (magnitude x) (magnitude y)
   464	                  (not= (neg? (sign x)) (neg? (sign y))))))
   465	
   466	
   467	(defn- float!
   468	  "Argument `arg` of `op` as a host double, or a `:wrong-type` refusal."
   469	  [op arg v]
   470	  (if (host/host-float? v) v (wrong-type! op arg :float)))
   471	
   472	
   473	(defn- trunc-big
   474	  "Finite host double `v` truncated toward zero, as an exact big integer.
   475	   At or above 2^53 `v` is integral: halve it exactly into [2^52, 2^53),
   476	   where every double is an integer, and shift the integer back."
   477	  [v]
   478	  (let [negative? (neg? v)
   479	        av (signed negative? v)]
   480	    (if (< av two-53-float)
   481	      (host/from-native (host/trunc-native v))
   482	      (let [[m k] (loop [m av
   483	                         k 0]
   484	                    (cond (>= m two-117-float)
   485	                          (recur (* m two-minus-64-float) (+ k 64))
   486	                          (>= m two-53-float) (recur (* m 0.5) (inc k))
   487	                          :else [m k]))
   488	            t (host/shift-left-big (host/from-native (host/trunc-native m))
   489	                                   k)]
   490	        (if negative? (host/sub zero t) t)))))
   491	
   492	
   493	(defn- int-compare-float
   494	  [_limits a f]
   495	  (let [x (big! 'compare-float 0 a)
   496	        v (float! 'compare-float 1 f)]
   497	    (cond
   498	      (host/nan-float? v) (wrong-type! 'compare-float 1 :non-nan-float)
   499	      (host/infinite-float? v) (if (pos? v) -1 1)
   500	      :else
   501	      ;; t = trunc(v): x < t means x < v, x > t means x >= t + 1 > v
   502	      ;; (or x > t >= v when v is negative); x = t leaves the fraction
   503	      (let [c (host/compare-big x (trunc-big v))]
   504	        (cond (not (zero? c)) c
   505	              (or (>= (signed (neg? v) v) two-53-float)
   506	                  (= v (host/native->double (host/trunc-native v))))
   507	              0
   508	              (pos? v) -1
   509	              :else 1)))))
   510	
   511	
   512	(defn- int-from-float
   513	  [limits f]
   514	  (let [v (float! 'from-float 0 f)]
   515	    (if (or (host/nan-float? v) (host/infinite-float? v))
   516	      (wrong-type! 'from-float 0 :finite-float)
   517	      (out limits (trunc-big v)))))
   518	
   519	
   520	;; =============================================================================
   521	;; Text
   522	;; =============================================================================
   523	
   524	(def ^:private digit-values
   525	  "Each digit character, either letter case, to its value."
   526	  (into {}
   527	        (mapcat (fn [i]
   528	                  (let [c (subs "0123456789abcdefghijklmnopqrstuvwxyz" i (inc i))]
   529	                    [[c i] [(str/upper-case c) i]])))
   530	        (range 36)))
   531	
   532	
   533	(def ^:private chunk-digits
   534	  "Digits accumulated natively per step: 36^10 < 2^53, so a chunk is
   535	   exact on every host."
   536	  10)
   537	
   538	
   539	(defn- radix!
   540	  "Radix argument `r` of `op` as a native integer from 2 to 36."
   541	  [op r]
   542	  (let [n (big! op 1 r)]
   543	    (when-not (and (<= 0 (host/compare-big n (host/from-native 2)))
   544	                   (<= (host/compare-big n (host/from-native 36)) 0))
   545	      (refuse! op :out-of-range {::arg 1, ::lo 2, ::hi 36}))
   546	    (host/to-native n)))
   547	
   548	
   549	(defn- power-of-two?
   550	  [r]
   551	  (zero? (bit-and r (dec r))))
   552	
   553	
   554	(defn- int-parse
   555	  ([limits s] (int-parse limits s 10))
   556	  ([limits s radix]
   557	   (when-not (string? s)
   558	     (wrong-type! 'parse 0 :string))
   559	   (let [r (radix! 'parse radix)
   560	         negative? (str/starts-with? s "-")
   561	         digits (if negative? (subs s 1) s)
   562	         n (count digits)]
   563	     (when (zero? n)
   564	       (refuse! 'parse :syntax {}))
   565	     (if (and (not (power-of-two? r)) (> n (::max-digits limits)))
   566	       ::digit-limit
   567	       (let [values (mapv (fn [i]
   568	                            (let [d (get digit-values (subs digits i (inc i)))]
   569	                              (if (and d (< d r))
   570	                                d
   571	                                (refuse! 'parse :syntax {}))))
   572	                          (range n))
   573	             magnitude
   574	             (loop [acc zero
   575	                    i 0]
   576	               (if (< i n)
   577	                 (let [end (min n (+ i chunk-digits))
   578	                       [chunk scale] (reduce (fn [[c s] d]
   579	                                               [(+ (* c r) d) (* s r)])
   580	                                             [0 1]
   581	                                             (subvec values i end))]
   582	                   (recur (host/add (host/mul acc (host/from-native scale))
   583	                                    (host/from-native chunk))
   584	                          end))
   585	                 acc))]
   586	         (out limits
   587	              (if negative? (host/sub zero magnitude) magnitude)))))))
   588	
   589	
   590	(defn- ceil-log2
   591	  [r]
   592	  (loop [c 0
   593	         p 1]
   594	    (if (< p r) (recur (inc c) (* 2 p)) c)))
   595	
   596	
   597	(defn- int-format
   598	  ([limits a] (int-format limits a 10))
   599	  ([limits a radix]
   600	   (let [x (big! 'format 0 a)
   601	         r (radix! 'format radix)
   602	         max-digits (::max-digits limits)
   603	         limited? (not (power-of-two? r))]
   604	     ;; |x| >= 2^(bits - 1), so it has more than (bits - 1) / log2(r)
   605	     ;; digits: refuse before building text that is certain to breach
   606	     (if (and limited?
   607	              (pos? (bits x))
   608	              (>= (dec (bits x)) (* (ceil-log2 r) max-digits)))
   609	       ::digit-limit
   610	       (let [text (host/to-radix-string x r)]
   611	         (if (and limited?
   612	                  (> (- (count text) (if (neg? (sign x)) 1 0)) max-digits))
   613	           ::digit-limit
   614	           text))))))
   615	
   616	
   617	;; =============================================================================
   618	;; Recognition
   619	;; =============================================================================
   620	
   621	(defn- int-integer?
   622	  [_limits x]
   623	  (host/exact-integer? x))
   624	
   625	
   626	(defn- int-normalize
   627	  [limits a]
   628	  (out limits (big! 'normalize 0 a)))
   629	
   630	
   631	;; =============================================================================
   632	;; The module
   633	;; =============================================================================
   634	
   635	(def ^:private exports
   636	  "`[name arities kernel]` of every export. Each kernel takes the
