+    (cond
+      ;; x / y < 2^(e0 + 1): at least 2^1024, or below half the least
+      ;; subnormal 2^-1074
+      (zero? (sign x)) (signed negative? 0.0)
+      (> e0 1024) ::float-overflow
+      (< e0 -1076) (signed negative? 0.0)
+      :else
+      (let [;; 2^(e - 1) <= x / y < 2^e
+            e (if (neg? (compare-scaled x y e0)) e0 (inc e0))
