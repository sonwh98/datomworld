ro produces positive zero)\\\\\\\\\\\\\\\",\\\\\\\\n   161\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/gc_007.phpt\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"GC 007: Unreferenced array cycle\\\\\\\\\\\\\\\",\\\\\\\\n   162\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/gc_047.phpt\\\\\\\\\\\\\\\"\\\\\\\\n   163\\\\\\\\t  \\\\\\\\\\\\\\\"GC 047: Leak after GC inside a foreach loop\\\\\\\\\\\\\\\",\\\\\\\\n   164\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/bug74810.phpt\\\\\\\\\\\\\\\"\\\\\\\\n   165\\\\\\\\t  \\\\\\\\\\\\\\\"Bug #74810: Something odd about ordering of func_get_args() result in 7.2\\\\\\\\\\\\\\\",\\\\\\\\n   166\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/bug63882_2.phpt\\\\\\\\\\\\\\\"\\\\\\\\n   167\\\\\\\\t  \\\\\\\\\\\\\\\"Bug #63882_2 (arsort crash on recursion)\\\\\\\\\\\\\\\",\\\\\\\\n   168\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/bug45147.phpt\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"Bug #45147 (unexpected T_ENDFOR)\\\\\\\\\\\\\\\",\\\\\\\\n   169\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/bug81076.phpt\\\\\\\\\\\\\\\"\\\\\\\\n   170\\\\\\\\t  \\\\\\\\\\\\\\\"Bug #81076 Invalid implicit binds cause incorrect static var count in closure debug info\\\\\\\\\\\\\\\",\\\\\\\\n   171\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/bug79836.phpt\\\\\\\\\\\\\\\"\\\\\\\\n   172\\\\\\\\t  \\\\\\\\\\\\\\\"Bug #79836 (Segfault in concat_function)\\\\\\\\\\\\\\\",\\\\\\\\n   173\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/foreach_undefined.phpt\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"foreach() & undefined var\\\\\\\\\\\\\\\",\\\\\\\\n   174\\\\\\\\t  \\\\\\\\\\\\\\\"Zend/tests/bug42143.phpt\\\\\\\\\\\\\\\"\\\\\\\\n   175\\\\\\\\t  \\\\\\\\\\\\\\\"bug #42143 (The constant NAN is reported as 0 on Windows build)\\\\\\\\\\\\\\\",\\\\\\\\n(ns yang.php.antlr.builtin-surfaces-test\\\\\\\\n  \\\\\\\\\\\\\\\"P9 builtin surfaces, dynamic scopes, and corner closures.\\\\\\\\\\\\\\\"\\\\\\\\n  (:require\\\\\\\\n    [clojure.test :refer [deftest is testing]]\\\\\\\\n    [yang.php.antlr.e2e-harness :as h]\\\\\\\\n    [yang.php.antlr.programs-p9 :as p9]))\\\\\\\\n\\\\\\\\n\\\\\\\\n(deftest p9-fixtures-test\\\\\\\\n  (doseq [{:keys [id source out diag]} p9/fixtures]\\\\\\\\n    (testing (name id)\\\\\\\\n      (let [r (h/run-raw source)]\\\\\\\\n        (is (= out (:php/out r)))\\\\\\\\n        (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))))\\\\\\\\n        (is (nil? (:php/uncaught r)))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(deftest p9-compile-refusals-test\\\\\\\\n  (doseq [[source reason]\\\\\\\\n          [[\\\\\\\\\\\\\\\"<?php eval('$x = 1;');\\\\\\\\\\\\\\\" :eval]\\\\\\\\n           [\\\\\\\\\\\\\\\"<?php $x = 1; $n = 'x'; $$n =& $x;\\\\\\\\\\\\\\\" :dynamic-reference]\\\\\\\\n           [\\\\\\\\\\\\\\\"<?php [[&$a]] = [[1]];\\\\\\\\\\\\\\\" :yang.php/compile-error]\\\\\\\\n           [\\\\\\\\\\\\\\\"<?php $GLOBALS = [];\\\\\\\\\\\\\\\" :yang.php/compile-error]\\\\\\\\n           [\\\\\\\\\\\\\\\"<?php unset($GLOBALS);\\\\\\\\\\\\\\\" :yang.php/compile-error]]]\\\\\\\\n    (testing reason\\\\\\\\n      (let [{:keys [diagnostics]} (h/lower-program source)\\\\\\\\n            d (first diagnostics)]\\\\\\\\n        (is (seq diagnostics))\\\\\\\\n        (is (= reason (or (:construct d) (:yang.php/diagnostic d))))))))\\\\\\\\n{:deps {org.clojure/core.async {:mvn/version \\\\\\\\\\\\\\\"1.8.741\\\\\\\\\\\\\\\"}\\\\\\\\n        org.clojure/tools.reader {:mvn/version \\\\\\\\\\\\\\\"1.5.0\\\\\\\\\\\\\\\"}\\\\\\\\n        ring/ring {:mvn/version \\\\\\\\\\\\\\\"1.14.1\\\\\\\\\\\\\\\"}\\\\\\\\n        com.cognitect/transit-clj {:mvn/version \\\\\\\\\\\\\\\"1.0.333\\\\\\\\\\\\\\\"}\\\\\\\\n        org.replikativ/boring {:mvn/version \\\\\\\\\\\\\\\"0.1.30\\\\\\\\\\\\\\\"}\\\\\\\\n        com.datomic/peer {:mvn/version \\\\\\\\\\\\\\\"1.0.7364\\\\\\\\\\\\\\\"}\\\\\\\\n        org.postgresql/postgresql {:mvn/version \\\\\\\\\\\\\\\"42.7.3\\\\\\\\\\\\\\\"}\\\\\\\\n        org.clojure/data.json {:mvn/version \\\\\\\\\\\\\\\"2.5.0\\\\\\\\\\\\\\\"}\\\\\\\\n        http-kit/http-kit {:mvn/version \\\\\\\\\\\\\\\"2.8.0\\\\\\\\\\\\\\\"}\\\\\\\\n        org.jsoup/jsoup {:mvn/version \\\\\\\\\\\\\\\"1.18.3\\\\\\\\\\\\\\\"}\\\\\\\\n        instaparse/instaparse {:mvn/version \\\\\\\\\\\\\\\"1.5.0\\\\\\\\\\\\\\\"}\\\\\\\\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\\\\\\\\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\\\\\\\\n        org.antlr/antlr4-runtime {:mvn/version \\\\\\\\\\\\\\\"4.13.2\\\\\\\\\\\\\\\"}\\\\\\\\n        criterium/criterium {:mvn/version \\\\\\\\\\\\\\\"0.4.6\\\\\\\\\\\\\\\"}\\\\\\\\n        io.github.rctcwyvrn/blake3 {:mvn/version \\\\\\\\\\\\\\\"1.3\\\\\\\\\\\\\\\"}\\\\\\\\n        stigmergy/chp {:mvn/version \\\\\\\\\\\\\\\"0.1.0-SNAPSHOT\\\\\\\\\\\\\\\"\\\\\\\\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\\\\\\\\n :cljd/opts {}\\\\\\\\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\\\\\\\\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\\\\\\\\n :paths [\\\\\\\\\\\\\\\"src/clj\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"src/cljc\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"src/cljs\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"src/cljd\\\\\\\\\\\\\\\"\\\\\\\\n         \\\\\\\\\\\\\\\"build/antlr/python3/classes\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"build/antlr/php/classes\\\\\\\\\\\\\\\"\\\\\\\\n         \\\\\\\\\\\\\\\"build/antlr/typescript/classes\\\\\\\\\\\\\\\"]\\\\\\\\n :aliases {:clean {:extra-paths [\\\\\\\\\\\\\\\"src/dev\\\\\\\\\\\\\\\"]\\\\\\\\n                   :exec-fn clean/clean}\\\\\\\\n           :profile-btree {:extra-paths [\\\\\\\\\\\\\\\"src/dev\\\\\\\\\\\\\\\"]\\\\\\\\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\\\\\\\\n                                        {:mvn/version \\\\\\\\\\\\\\\"0.3.0\\\\\\\\\\\\\\\"}}\\\\\\\\n                           :main-opts [\\\\\\\\\\\\\\\"-m\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"btree-bench\\\\\\\\\\\\\\\"]}\\\\\\\\n           :test {:extra-paths [\\\\\\\\\\\\\\\"test\\\\\\\\\\\\\\\"]\\\\\\\\n                  :extra-deps {io.github.cognitect-labs/test-runner\\\\\\\\n                               {:git/tag \\\\\\\\\\\\\\\"v0.5.1\\\\\\\\\\\\\\\" :git/sha \\\\\\\\\\\\\\\"dfb30dd\\\\\\\\\\\\\\\"}\\\\\\\\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\\\\\\\\n                               ;; the differential oracle for the yang.clojure gap\\\\\\\\n                               ;; program (pinned; MIT; dependency-free)\\\\\\\\n                               latte-kernel/latte-kernel\\\\\\\\n                               {:git/url \\\\\\\\\\\\\\\"https://github.com/latte-central/latte-kernel\\\\\\\\\\\\\\\"\\\\\\\\n                                :git/sha \\\\\\\\\\\\\\\"86fca0d1d054af005cb37395eae04500d45e6279\\\\\\\\\\\\\\\"}}\\\\\\\\n                  ;; The guest recursion limit allows depth that needs more than the\\\\\\\\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\\\\\\\\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\\\\\\\\n                  ;; before it can raise Python's RecursionError, so the same tests\\\\\\\\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\\\\\\\\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\\\\\\\\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\\\\\\\\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\\\\\\\\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\\\\\\\\n                  ;; the conformance compositions) overflow smaller stacks in\\\\\\\\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\\\\\\\\n                  ;; the 4m minimum for the prelude recursion rows still holds)\\\\\\\\n                  :jvm-opts [\\\\\\\\\\\\\\\"-Xss64m\\\\\\\\\\\\\\\"]\\\\\\\\n                  :main-opts [\\\\\\\\\\\\\\\"-m\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"cognitect.test-runner\\\\\\\\\\\\\\\"]\\\\\\\\n                  :exec-fn cognitect.test-runner.api/test}\\\\\\\\n           :nREPL {:extra-paths [\\\\\\\\\\\\\\\"test\\\\\\\\\\\\\\\"]\\\\\\\\n                   :extra-deps {nrepl/nrepl {:mvn/version \\\\\\\\\\\\\\\"1.0.0\\\\\\\\\\\\\\\"}\\\\\\\\n                                cider/cider-nrepl {:mvn/version \\\\\\\\\\\\\\\"0.58.0\\\\\\\\\\\\\\\"}}\\\\\\\\n                   :main-opts [\\\\\\\\\\\\\\\"-m\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"nrepl.cmdline\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"--middleware\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"[cider.nrepl/cider-middleware]\\\\\\\\\\\\\\\"]}\\\\\\\\n           :cljs {:extra-paths [\\\\\\\\\\\\\\\"test\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"src/dev\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"build/antlr/python3/js\\\\\\\\\\\\\\\"]\\\\\\\\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \\\\\\\\\\\\\\\"3.3.5\\\\\\\\\\\\\\\"}\\\\\\\\n                               reagent/reagent {:mvn/version \\\\\\\\\\\\\\\"2.0.1\\\\\\\\\\\\\\\"}\\\\\\\\n                               com.cognitect/transit-cljs {:mvn/version \\\\\\\\\\\\\\\"0.8.280\\\\\\\\\\\\\\\"}}}\\\\\\\\n           :dev {:extra-paths [\\\\\\\\\\\\\\\"src/dev\\\\\\\\\\\\\\\"]\\\\\\\\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \\\\\\\\\\\\\\\"3.3.5\\\\\\\\\\\\\\\"}\\\\\\\\n                              cider/cider-nrepl {:mvn/version \\\\\\\\\\\\\\\"0.58.0\\\\\\\\\\\\\\\"}\\\\\\\\n                              reagent/reagent {:mvn/version \\\\\\\\\\\\\\\"2.0.1\\\\\\\\\\\\\\\"}\\\\\\\\n                              com.cognitect/transit-cljs {:mvn/version \\\\\\\\\\\\\\\"0.8.280\\\\\\\\\\\\\\\"}\\\\\\\\n                              ;; benchmark baseline + psset-fixtures\\\\\\\\n                              ;; generator only; production uses\\\\\\\\n                              ;; dao.data.btree\\\\\\\\n                              persistent-sorte