8\\t\\n  5819\\t(defn module-spec\\n  5820\\t  \\\"`yin.vm.linker.publish/publish-module!`'s spec for the module `php` over\\n  5821\\t   the host registry `registry`, requiring the pinned `yang.call` revision\\n  5822\\t   at `call-address`; a free name nothing supplies is refused before\\n  5823\\t   anything is published. This namespace emits; it never publishes.\\\"\\n  5824\\t  [registry call-address]\\n  5825\\t  (core/module-spec {:module-name module-name,\\n  5826\\t                     :ast module-uast,\\n  5827\\t                     :exports module-exports,\\n  5828\\t                     :requires {call/module-name call-address},\\n  5829\\t                     :free-names module-free-names,\\n  5830\\t                     :skip? #(= \\\"yang.call\\\" (namespace %)),\\n  5831\\t                     :registry registry,\\n  5832\\t                     :message \\\"the php module reads an undeclared name\\\",\\n  5833\\t                     :refusal-ns \\\"yang.php\\\"}))\\n  5834\\t\\n  5835\\t\\n  5836\\t(def min-integer-bits\\n  5837\\t  \\\"The smallest `::integer/max-bits` this profile admits: the exact float\\n  5838\\t   expansion `m * 5^k` needs about 2200 bits.\\\"\\n  5839\\t  4096)\\n  5840\\t\\n  5841\\t\\n  5842\\t(def min-integer-digits\\n  5843\\t  \\\"The smallest `::integer/max-digits` this profile admits: the exact float\\n  5844\\t   expansion has up to about 770 digits.\\\"\\n  5845\\t  1000)\\n(ns yang.php.antlr.e2e-harness\\n  \\\"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\\n   program envelope -> the bundled program on each of the four VMs. Output\\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\n   here at the boundary.\\\"\\n  (:require\\n    [dao.host.text :as text]\\n    [dao.stream :as stream]\\n    [yang.php.antlr.cst :as cst]\\n    [yang.php.antlr.lower :as lower]\\n    [yang.php.antlr.portable-harness :as portable]\\n    [yang.php.antlr.safepoint :as hooks]\\n    [yang.safepoint :as safepoint]\\n    [yin.vm :as vm]\\n    [yin.vm.debruijn.register :as rvm]\\n    [yin.vm.debruijn.stack :as dvm]\\n    [yin.vm.encoder :as encoder]\\n    [yin.vm.semantic :as semantic]\\n    [yin.vm.semantic.derive :as derive]\\n    [yin.vm.semantic.linearize :as sr-linearize]\\n    [yin.vm.test-utils :as tu]))\\n\\n\\n(defn host-registry\\n  \\\"The registry the PHP compositions run over.\\\"\\n  []\\n  (portable/host-registry))\\n\\n\\n(def ^:private base-opts\\n  {:make-stream tu/make-stream,\\n   :capability-secret tu/secret,\\n   :primitives vm/primitives})\\n\\n\\n(def ^:private load-semantic\\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\n\\n\\n(defn lower-program\\n  \\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\n  The request record travels the composition path too: as a stage option it\\n  reaches `lower-program`, which emits it as `run-main`'s second operand.\\\"\\n  ([source] (lower-program source nil))\\n  ([source request]\\n   (let [cst-log (tu/new-memory-log)\\n         program (tu/new-memory-log)\\n         diagnostics (tu/new-memory-log)]\\n     (stream/append! cst-log (cst/parse-source source))\\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\\n                                         (cond-> {:medium lower/program-medium}\\n                                           (some? request) (assoc :request request))))\\n    (let [{warnings true, problems false}\\n          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\n      (if (seq problems)\\n        {:diagnostics problems}\\n        (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\n          {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)}))))))\\n\\n\\n(defn packet->form\\n  \\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\n   rule, `[\\\\\\\"TYPE\\\\\\\" \\\\\\\"text\\\\\\\"]` for a token. The inverse of\\n   `portable-harness/packet`.\\\"\\n  [{:yang.cst/keys [root nodes]}]\\n  (letfn [(form\\n            [id]\\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\\n              (if (= :token kind)\\n                [type text]\\n                (into [(keyword rule)] (map form) children))))]\\n    (form root)))\\n\\n\\n(defn latin1->text\\n  \\\"The UTF-8 text of the byte carrier `s`.\\\"\\n  [s]\\n  (text/utf8-decode (.getBytes ^String s \\\"ISO-8859-1\\\")))\\n\\n\\n(defn render\\n  \\\"The text a unit prints: its output, then, for an uncaught error, the\\n   fatal line (no path, plan section 3.9).\\\"\\n  [{:php/keys [out uncaught fatal]}]\\n  (str (latin1->text out)\\n       (when uncaught\\n         (str \\\"PHP Fatal error:  Uncaught \\\" (:class uncaught) \\\": \\\" (:message uncaught)))\\n       (when fatal\\n         (str \\\"PHP Fatal error:  \\\" fatal))))\\n\\n\\n(defn run-vms\\n  \\\"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\\n   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\\n   and starts one per-run counter; no option leaves the AST unchanged.\\\"\\n  ([registry ast] (run-vms registry ast {}))\\n  ([registry ast {:keys [execution-budget envelope]}]\\n   (let [ast (if (some? execution-budget)\\n               (let [projected (encoder/project envelope)\\nzsh:1: no matches found: src/cljc/yin/vm/*cell*\\n62:(deftest static-slot-initializes-once-when-first-reached-test\\n294:      (is (= [[2 \\\"Uninitialized string offset 3\\\"]] (diag r))))))\\n529:  (testing \\\"row 41: a reference to an initialized typed property carries the source\\\"\\n539:  (testing \\\"row 41: uninitialized nullable becomes null; non-nullable is an Error\\\"\\n545:    (is (= \\\"Error: Cannot access uninitialized non-nullable property C::$p by reference\\\"\\n595:  (testing \\\"row 44: unset removes the source and uninitializes; object free drops sources\\\"\\n