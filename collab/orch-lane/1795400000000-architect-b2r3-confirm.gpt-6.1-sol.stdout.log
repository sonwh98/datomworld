655\t   [\"InvalidArgumentException\" :class \"LogicException\" []]\n  5656\t   [\"DomainException\" :class \"LogicException\" []] [\"LengthException\" :class \"LogicException\" []]\n  5657\t   [\"OutOfRangeException\" :class \"LogicException\" []]\n  5658\t   [\"BadFunctionCallException\" :class \"LogicException\" []]\n  5659\t   [\"BadMethodCallException\" :class \"BadFunctionCallException\" []]\n  5660\t   [\"OutOfBoundsException\" :class \"RuntimeException\" []]\n  5661\t   [\"RangeException\" :class \"RuntimeException\" []]\n  5662\t   [\"OverflowException\" :class \"RuntimeException\" []]\n  5663\t   [\"UnderflowException\" :class \"RuntimeException\" []]\n  5664\t   [\"UnexpectedValueException\" :class \"RuntimeException\" []]])\n  5665\t\n  5666\t\n  5667\t(defn- throwable-members\n  5668\t  \"The properties and native methods Exception and Error declare, which every\n  5669\t   subclass inherits.\"\n  5670\t  [nm]\n  5671\t  {:props-decl (mapv (fn [[pn vis default]]\n  5672\t                       {:name pn,\n  5673\t                        :vis vis,\n  5674\t                        :declaring nm,\n  5675\t                        :id (if (= vis :private) (str nm \"::\" pn) pn),\n  5676\t                        :default default})\n  5677\t                     [[\"message\" :protected \"\"] [\"code\" :protected 0] [\"file\" :protected \"\"]\n  5678\t                      [\"line\" :protected 0] [\"previous\" :private :php/null]]),\n  5679\t   :methods (mapv (fn [[mn kind]]\n  5680\t                    {:name mn,\n  5681\t                     :lc (str/lower-case mn),\n  5682\t                     :vis :public,\n  5683\t                     :declaring nm,\n  5684\t                     :final? (not= kind :ctor),\n  5685\t                     :native kind})\n    90\t  [file unit-dir]\n    91\t  (if unit-dir\n    92\t    (str (java.util.regex.Pattern/quote unit-dir) \"/[^\\\\s:]+\")\n    93\t    (java.util.regex.Pattern/quote file)))\n    94\t\n    95\t\n    96\t(defn- strip-location\n    97\t  ([s file] (strip-location s file nil))\n    98\t  ([s file unit-dir]\n    99\t   (str/replace s\n   100\t                (re-pattern (str \" in /w/\" (location-pattern file unit-dir) \" on line \\\\d+\"))\n   101\t                \"\")))\n   102\t\n   103\t\n   104\t(defn parse-stdout\n   105\t  \"Parse PHP CLI stdout for `/w/<file>` into\n   106\t   `{:out <string> :diag [[errno msg] ...] :uncaught {:class c :message m}-or-nil}`.\n   107\t   With `unit-dir`, locations in any file below `/w/<unit-dir>` are stripped\n   108\t   (a multi-unit fixture).\"\n   109\t  ([raw file] (parse-stdout raw file nil))\n   110\t  ([raw file unit-dir]\n   111\t   (let [qfile (location-pattern file unit-dir)\n   112\t         strip-location (fn [s file] (strip-location s file unit-dir))\n   113\t         ;; The uncaught block ends at PHP's own terminator, so output written\n   114\t         ;; after it (shutdown functions, destructors) stays in :out.\n   115\t         uncaught-re (re-pattern\n   116\t                       (str \"(?s)\\\\nFatal error: Uncaught ([^:]+): ([^\\\\r\\\\n]*) in /w/\"\n   117\t                            qfile\n   118\t                            \":\\\\d+\\\\nStack trace:\\\\n.*?\\\\n  thrown in /w/\"\n   119\t                            qfile\n   120\t                            \" on line \\\\d+\\\\n\"))\n   121\t         fatal-re (re-pattern\n   122\t                    (str \"\\\\nFatal error: ([^\\\\r\\\\n]*) in /w/\"\n   123\t                         qfile\n   124\t                         \" on line \\\\d+\\\\n\"))\n   125\t         diag-re (re-pattern\n   126\t                   (str \"\\\\n(Warning|Notice|Deprecated): ([^\\\\r\\\\n]*?) in /w/\"\n   127\t                        qfile\n   128\t                        \" on line \\\\d+\\\\n\"))\n   129\t         [without-fatal uncaught fatal]\n   130\t         (if-let [[_ cls msg] (re-find uncaught-re raw)]\n   131\t           [(str/replace raw uncaught-re \"\")\n   132\t            {:class cls, :message (strip-location msg file)}\n   133\t            nil]\n   134\t           (if-let [[_ msg] (re-find fatal-re raw)]\n   135\t             ;; a plain (non-uncaught-exception) fatal: the engine's\n   136\t             ;; guest-fatal representation (`:php/fatal message`, shutdown\n   137\t             ;; already run) is preserved as `:fatal`, and `:uncaught`\n   138\t             ;; stays nil — a plain fatal populates one slot only.\n   139\t             [(str/replace raw fatal-re \"\")\n   140\t              nil\n   141\t              (strip-location msg file)]\n   142\t             [raw nil nil]))\n   143\t         diags (volatile! [])\n   144\t         out (str/replace without-fatal\n   145\t                          diag-re\n   146\t                          (fn [[_ kind msg]]\n   147\t                            (vswap! diags conj (mark-class-derived [(get errno-of kind) (strip-location msg file)]))\n   148\t                            \"\"))]\n   149\t     {:out out,\n   150\t      :diag @diags,\n   151\t      :uncaught uncaught,\n   152\t      :fatal fatal})))\n   153\t\n   154\t\n   155\t(defn run-php-file\n   156\t  \"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` and return the parsed\n   157\t   `{:out :diag :uncaught :exit}`. With `unit-dir`, the working directory is\n   158\t   `/w/<unit-dir>` and `file` is relative to it (a multi-unit fixture).\"\n   159\t  ([dir file] (run-php-file dir file nil))\n   160\t  ([dir file unit-dir]\n   161\t   (let [{:keys [out err exit]}\n   162\t         (sh/sh \"docker\" \"run\" \"--rm\"\n   163\t                \"-v\" (str (.toAbsolutePath (.toPath (io/file dir))) \":/w\")\n   164\t                \"-w\" (if unit-dir (str \"/w/\" unit-dir) \"/w\")\n   165\t                \"php:8.3-cli\" \"php\"\n   395\t                   (run-php-file dir file))\n   396\t          expected-out (or out \"\")\n   397\t          expected-diag (vec (or diag []))\n   398\t          pass? (and (not= :pending oracle)\n   399\t                     (= expected-out (:out actual))\n   400\t                     (diag-match? expected-diag (:diag actual))\n   401\t                     (= uncaught (:uncaught actual))\n   402\t                     (or (nil? status) (= status (:exit actual))))]\n   403\t      {:id id,\n   404\t       :pass? pass?,\n   405\t       :oracle oracle,\n   406\t       :expected {:out expected-out, :diag expected-diag, :uncaught uncaught, :status status},\n   407\t       :actual (assoc (select-keys actual [:out :diag :uncaught]) :exit (:exit actual))})))\n   408\t\n   409\t\n   410\t(defn run-p5\n   411\t  \"Run all `p5/fixtures` (the request-context fixtures) against\n   412\t   `php:8.3-cli`.\"\n   413\t  []\n   414\t  (let [dir (.toFile (Files/createTempDirectory \"yang-php-oracle-p5-\"\n   415\t                                                (make-array FileAttribute 0)))]\n   416\t    (try\n   417\t      (mapv #(check-p5-fixture dir %) p5/fixtures)\n   418\t      (finally\n   419\t        (doseq [f (reverse (file-seq dir))]\n   420\t          (.delete ^java.io.File f))))))\n   421\t\n   422\t\n   423\t(defn check-p5b2-fixture\n   424\t  \"Run P5b2 `fixture` in temporary directory `dir`: the fixture source plus\n   425\t   the [[p5b2-prologue]] as `auto_prepend_file` (the ruled recursive merge\n   426\t   and, for `:http-profile` fixtures, the explicit initial status 200 — bare\n   427\t   CLI starts without the engine's assumed HTTP 200). Returns a check record\n   428\t   like [[check-fixture]], with the engine's guest-fatal representation\n   429\t   (`:fatal`) compared against the parser's preserved `:fatal`.\"\n   430\t  [dir {:keys [id source out diag uncaught status fatal oracle]}]\n   431\t  (let [file (str (name id) \".php\")\n   432\t        pre (str (name id) \"-pre.php\")\n   433\t        fixture (first (filter #(= id (:id %)) p5b2/fixtures))]\n   434\t    (write-source! dir file source)\n   435\t    (write-source! dir pre (p5b2-prologue fixture))\n   436\t    (let [actual (run-php-file-with-prepend dir file pre)\n   437\t          expected-out (or out \"\")\n   438\t          expected-diag (vec (or diag []))\n   439\t          pass? (and (not= :pending oracle)\n   440\t                     (= expected-out (:out actual))\n   441\t                     (diag-match? expected-diag (:diag actual))\n   442\t                     (= uncaught (:uncaught actual))\n   443\t                     (= fatal (:fatal actual))\n   444\t                     (or (nil? status) (= status (:exit actual))))]\n   445\t      {:id id,\n   446\t       :pass? pass?,\n   447\t       :oracle oracle,\n   448\t       :expected {:out expected-out, :diag expected-diag, :uncaught uncaught,\n   449\t                  :fatal fatal, :status status},\n   450\t       :actual (assoc (select-keys actual [:out :diag :uncaught :fatal]) :exit (:exit actual))})))\n   451\t\n   452\t\n   453\t(defn run-p5b2\n   454\t  \"Run all `p5b2/fixtures` (the B2 step-7 fixtures) against `php:8.3-cli`.\"\n   455\t  []\n   456\t  (let [dir (.toFile (Files/createTempDirectory \"yang-php-oracle-p5b2-\"\n   457\t                                                (make-array FileAttribute 0)))]\n   458\t    (try\n   459\t      (mapv #(check-p5b2-fixture dir %) p5b2/fixtures)\n   460\t      (finally\n   461\t        (doseq [f (reverse (file-seq dir))]\n   462\t          (.delete ^java.io.File f))))))\n   463\t\n   464\t\n   465\t(defn print-fold\n   466\t  \"Print the fold lines for `results`: one paste-ready record per fixture\n   467\t   in the P4 [[p4/pin]] shape `{:oracle p5-banner :out :diag :uncaught}`,\n   468\t   carrying the guest-fatal representation (`:fatal`) and the process exit\n   469\t   status (`:status`) alongside.\"\n   470\t  [results]\n   471\t  (doseq [{:keys [id actual]} results]\n   472\t    (println \"FOLD\" (name id)\n   473\t             (pr-str (assoc (select-keys actual [:out :diag :uncaught :fatal])\n   474\t                            :oracle p5-banner\n   475\t                            :status (:exit actual))))))\n   476\t\n   477\t\n   478\t(defn run-all\n   479\t  \"Run all `programs/fixtures`, `matrix-source` and `float-cases` against\n   480\t   `php:8.3-cli`.\"\n   481\t  []\n   482\t  (let [dir (.toFile (Files/createTempDirectory \"yang-php-oracle-\"\n   483\t                                                (make-array FileAttribute 0)))]\n   484\t    (try\n   485\t      (-> (mapv #(check-fixture dir %) (concat programs/fixtures p3b/all-fixtures p4/all-fixtures p6/all-fixtures))\n   486\t          (conj (check-matrix dir))\n   487\t          (conj (check-floats dir)))\n   488\t      (finally\n   489\t        (doseq [f (reverse (file-seq dir))]\n   490\t          (.delete ^java.io.File f))))))\n   491\t\n   492\t\n   493\t(defn -main\n   494\t  [& args]\n   495\t  (when (some #{\"--print-prologue\"} args)\n   496\t    (let [id (keyword (or (second (drop-while #(not= \"--print-prologue\" %) args))\n   497\t                          \"superglobals-from-request\"))\n   498\t          fixture (first (filter #(= id (:id %)) p5/fixtures))\n   499\t          b2-fixture (first (filter #(= id (:id %)) p5b2/fixtures))]\n   500\t      (when-not (or fixture b2-fixture)\n   501\t        (println \"Unknown P5 fixture:\" id)\n   502\t        (System/exit 2))\n   503\t      ;; Dry run: no docker, no oracle. Print the generated prologue for\n   504\t      ;; eyeball comparison against the engine's expected superglobal\n   505\t      ;; values (the fixture's hand-derived :out is the reference).\n   506\t      (print (if b2-fixture\n   507\t               (p5b2-prologue b2-fixture)\n   508\t               (p5-prologue (:request fixture))))\n   509\t      (flush)\n   510\t      (shutdown-agents)\n","exit_code":0,"status":"completed"}}
