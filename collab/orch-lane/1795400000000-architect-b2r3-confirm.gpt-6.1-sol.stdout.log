s `{:value v :request consumed :response [...] :diag [...]}`,\\n   203\\t   the drained streams, or `{:diagnostics d}` when lowering refuses.\\\"\\n   204\\t  [pk request]\\n   205\\t  (let [request-stream (lifecycle-stream \\\"request create\\\")\\n   206\\t        response-stream (lifecycle-stream \\\"response create\\\")\\n   207\\t        diagnostics-stream (lifecycle-stream \\\"diagnostics create\\\")]\\n   208\\t    (when (some? request)\\n   209\\t      (check-ok! (stream/append! request-stream request) \\\"request append\\\"))\\n   210\\t    (let [consumed (if (some? request) (consume-one request-stream) nil)\\n   211\\t          {:keys [ast diagnostics]} (lower-through-stage pk consumed)]\\n   212\\t      (if diagnostics\\n   213\\t        {:diagnostics diagnostics}\\n   214\\t        (let [v (vm/value (vm/eval (create-vm {:modules (host-registry)}) ast))]\\n   215\\t          (emit-all! response-stream (:php/response v) \\\"response append\\\")\\n   216\\t          (emit-all! diagnostics-stream (:php/diag v) \\\"diagnostics append\\\")\\n   217\\t          {:value v,\\n   218\\t           :request consumed,\\n   219\\t           :response (drain response-stream),\\n   220\\t           :diag (drain diagnostics-stream)})))))\\n   267\\t(defn- php-literal\\n   268\\t  \\\"The PHP literal of request-record scalar `v`: strings single-quoted\\n   269\\t   (escaping backslash and quote, the only two escapes there), ints bare.\\n   270\\t   Key coercion (numeric strings to ints) is left to PHP itself, exactly as\\n   271\\t   the engine's `php/array-key` performs it.\\\"\\n   272\\t  [v]\\n   273\\t  (cond (string? v) (str \\\"'\\\" (str/replace v #\\\"\\\\\\\\|'\\\" (fn [[c]] (str \\\"\\\\\\\\\\\" c))) \\\"'\\\")\\n   274\\t        (integer? v) (str v)\\n   275\\t        :else (throw (ex-info \\\"p5 oracle: non-scalar in request record\\\" {:value v}))))\\n   276\\t\\n   277\\t\\n   278\\t(declare php-array-literal)\\n   279\\t\\n   280\\t\\n   281\\t(defn- php-value-literal\\n   282\\t  \\\"The PHP literal of request-record value `v`: nested request arrays\\n   283\\t   (engine records and ordered entry vectors alike) recurse, scalars use\\n   284\\t   [[php-literal]].\\\"\\n   285\\t  [v]\\n   286\\t  (if (or (sequential? v) (and (map? v) (= :array (:php/type v))))\\n   287\\t    (php-array-literal v)\\n   288\\t    (php-literal v)))\\n   289\\t\\n   290\\t\\n   291\\t(defn- request-pairs\\n   292\\t  \\\"Ordered `[k v]` pairs of request-array `arr`: the engine's ordered entry\\n   293\\t   vectors are accepted as-is; otherwise pairs follow the array's `:order`\\n   294\\t   (the engine's insertion order).\\\"\\n   295\\t  [arr]\\n   296\\t  (when arr\\n   297\\t    (if (sequential? arr)\\n   298\\t      (mapv vec arr)\\n   299\\t      (mapv (fn [k] [k (get (:index arr) k)]) (:order arr)))))\\n   300\\t\\n   301\\t\\n   302\\t(defn- php-array-literal\\n   303\\t  \\\"The PHP `array(...)` literal of request-array `arr`, recursing into\\n   304\\t   nested values.\\\"\\n   305\\t  [arr]\\n   306\\t  (if (empty? (request-pairs arr))\\n   307\\t    \\\"array()\\\"\\n   308\\t    (str \\\"array(\\\"\\n   309\\t         (str/join \\\", \\\" (map (fn [[k v]]\\n   310\\t                               (str (php-value-literal k) \\\" => \\\" (php-value-literal v)))\\n   311\\t                             (request-pairs arr)))\\n   312\\t         \\\")\\\")))\\n   313\\t\\n   314\\t\\n   315\\t(defn p5-prologue\\n   316\\t  \\\"The `auto_prepend_file` prologue assigning the superglobals from the\\n   317\\t   fixture `:request` record, mirroring `php/bind-request!` (prelude\\n   318\\t   section `request and output`): `$_GET` is the query, `$_POST` the body,\\n   347\\t         \\\"$_REQUEST = yang_request_merge($_GET, $_POST);\\\\n\\\")))\\n   348\\t\\n   349\\t\\n   350\\t(defn p5b2-prologue\\n   351\\t  \\\"The [[p5-prologue]] for a P5b2 `fixture`: when the fixture declares\\n   352\\t   `:http-profile`, the prologue first installs the HTTP profile's explicit\\n   353\\t   initial status 200. Bare `php:8.3-cli` starts without the engine's\\n   354\\t   assumed HTTP 200, so status-code fixtures run under this explicit\\n   355\\t   scaffold rather than against the bare CLI default.\\\"\\n   356\\t  [fixture]\\n   357\\t  (str (p5-prologue (:request fixture))\\n   358\\t       (when (:http-profile fixture)\\n   359\\t         \\\"http_response_code(200);\\\\n\\\")))\\n   360\\t\\n   361\\t\\n   362\\t(defn run-php-file-with-prepend\\n   363\\t  \\\"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` with `prepend-file`\\nsrc/cljc/yang/php/antlr/prelude.cljc\\nsrc/dev/yang/php/oracle.clj\\ntest/yang/php/antlr/p5b2_lifecycle_test.clj\\ntest/yang/php/antlr/portable_harness.cljc\\ntest/yang/php/antlr/programs_p5b2.cljc\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1795250000000-architect-b2r2-confirm.gpt-6.1-sol.stdout.log:66:{\"type\":\"item.started\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba collab/orch-lane/1795070000000-engineer-roundB2-r2.muse-spark-1.3-contributor.stdout.log | tail -12; /Library/Developer/CommandLineTools/usr/bin/git -C /Users/sto/workspace/datomworld-b2 status --short -- src/cljc/yang/php/antlr/prelude.cljc src/dev/yang/php/oracle.clj test/yang/php/antlr/p5b2_lifecycle_test.clj test/yang/php/antlr/portable_harness.cljc'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/orch-lane/1795250000000-architect-b2r2-confirm.gpt-6.1-sol.stdout.log:67:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba collab/orch-lane/1795070000000-engineer-roundB2-r2.muse-spark-1.3-contributor.stdout.log | tail -12; /Library/Developer/CommandLineTools/usr/bin/git -C /Users/sto/workspace/datomworld-b2 status --short -- src/cljc/yang/php/antlr/prelude.cljc src/dev/yang/php/oracle.clj test/yang/php/antlr/p5b2_lifecycle_test.clj test/yang/php/antlr/portable_harness.cljc'\",\"aggregated_output\":\"    27\\t- [programs_p5b2.cljc](/Users/sto/workspace/datomworld-b2/src/yang/php/antlr/programs_p5b2.cljc): fixed numeric merge fixture (`3020post`), sparse + nested-int fixtures, `ValueError` fixtures plus a caught case, handled/false-returning/shutdown-buffer guest-fatal fixtures, two-handler mask fixture, getter/status-line/replacement/setcookie fixtures, `:http-profile` flags.\\n    28\\t- [p5b2_lifecycle_test.clj](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/p5b2_lifecycle_test.clj): `:uncaught` expectations plus linked request/isolation/no-exported-cells coverage.\\n    29\\t- [oracle.clj](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/oracle.clj): B2 enumeration, nested request serializer, recursive-merge prologue, guest-fatal `:fatal` parsing, HTTP-profile 200 scaffold.\\n    30\\t\\n    31\\tWhat 520f8a3f did (item 6, verified 2 files, +134/-24):\\n    32\\t\\n    33\\t- [portable_harness.cljc](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/portable_harness.cljc): extracted the composition's ring-buffer constructor (`make-stream`), added `run-lifecycle-raw` — request appended to and consumed from a composition-supplied request stream via oldest-cursor/next, consumed record rides `run-main`'s operand channel, response/diagnostic records emitted on composition-supplied streams and drained back; `lower-through-stage`/`run-packet-raw` accept optional requests.\\n    34\\t- [p5b2_lifecycle_test.clj](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/p5b2_lifecycle_test.clj): new stream-lifecycle test covering superglobal seeding, `E_USER_NOTICE` emission, header-then-body order, nil-request defaults, drained-streams equal task value, and run-raw cross-agreement.\\n    35\\t\\n    36\\tGate (child-observed): p5b2-lifecycle + request-context 7 tests / 153 assertions pass, oracle dry-run renders, kondo 0/0, no e2e/slow. Note: cljstyle was unavailable on that laptop run; style follows file conventions.\\n    37\\t\\n    38\\tFindings files: [1795070000000-engineer-roundB2-r2](/Users/sto/workspace/datomworld-b2/collab/orch-lane/1795070000000-engineer-roundB2-r2.muse-spark-1.3-contributor.findings.md) (updated, uncommitted, untracked) and an extra untracked [1795150000000-engineer-roundB2](/Users/sto/workspace/datomworld-b2/collab/orch-lane/1795150000000-engineer-roundB2.muse-spark-1.3-contributor.findings.md) also present.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1795250000000-architect-b2r2-confirm.gpt-6.1-sol.stdout.log:68:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_35\",\"type\":\"agent_message\",\"text\":\"**Step-7: DEFECT at `520f8a3f`.** Read-only review and focused JVM probes completed; no files changed.\\n\\n1. **CONFIRMED — three escalation rulings.** Request binding runs inside the root handler after terminal escapes are installed: [prelude.cljc:5462](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:5462). An injected initialization Throwable produced the expected snapshot with empty output and no body execution. Invalid levels throw `ValueError` with the pinned message: [prelude.cljc:779](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:779). Both profiles accept requests; linked runtime cells remain task-local: [lower.cljc:3790](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/lower.cljc:3790), [prelude.cljc:5804](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:5804).\\n\\n2. **CONFIRMED — integer-key merge.** Keys are preserved, colliding scalars overwritten, and colliding arrays recursively merged: [prelude.cljc:425](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:425). Sparse and nested integer collisions have fixtures.\\n\\n3. **DEFECT — guest-fatal cleanup remains incomplete.** Matching handlers returning non-false correctly continue, and guest-fatal preserves shutdown functions and buffers. However, it never marks existing objects destructed before ordinary shutdown: [prelude.cljc:742](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:742), [prelude.cljc:4217](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:4217). A probe produced `BSD`—buffer, shutdown, **destructor**—where the destructor should be suppressed. Fatal status `255` is also absent. [PHP 8.3 fatal handling](https://raw.githubusercontent.com/php/php-src/PHP-8.3/main/main.c) establishes both requirements.\\n\\n4. **DEFECT — stream P2 remains open.** The harness consumes the request before lowering; lowering still embeds it in UAST: [lower.cljc:3791](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/lower.cljc:3791). Response and diagnostic vectors are copied into streams **after VM completion**: [portable_harness.cljc:214](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/portable_harness.cljc:214). Runtime emission still appends to cells. Header replacement additionally deletes earlier response records: [prelude.cljc:580](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:580); replacement should be interpreted from appended commands.\\n\\n5. **DEFECT — HTTP/cookie/oracle residuals.**\\n   - Status-line parsing and the two-handler/mask fixture are implemented.\\n   - `http_response_code(0)` still checks headers-sent before recognizing the getter: [prelude.cljc:613](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:613). After output, the probe returned false plus a warning.\\n   - Cookie excess arguments throw `ValueError` instead of `ArgumentCountError`; unknown-option messages differ, and array-option coercions were removed: [prelude.cljc:647](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:647), [prelude.cljc:670](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:670). These disagree with [PHP 8.3’s implementation](https://raw.githubusercontent.com/php/php-src/PHP-8.3/ext/standard/head.c).\\n   - B2 enumeration, nested serialization, recursive merge, and HTTP scaffolding are present. But plain fatal parsing populates both `:uncaught` and `:fatal`, leaving the expected fatal diagnostic absent: [oracle.clj:139](/Users/sto/workspace/datomworld-b2/src/dev/yang/php/oracle.clj:139). Fold output drops `:fatal` and exit status: [oracle.clj:471](/Users/sto/workspace/datomworld-b2/src/dev/yang/php/oracle.clj:471). Pending fixtures are excluded from failures, so a zero exit is not acceptance evidence.\\n\\n6. **CONFIRMED — reported focused gate: 7/153/0**, recorded at [seat relay:36](/Users/sto/workspace/datomworld/collab/orch-lane/1795070000000-engineer-roundB2-r2.muse-spark-1.3-contributor.stdout.log:36). Not independently rerun. Shiva e2e remains running per the seat; no completed tally received.\\n\\n**Landing authority — `feat/p5b2-lifecycle @ 520f8a3f`: WITHHELD pending these corrections and completed acceptance gates.**\"}}\n","exit_code":0,"status":"completed"}}
