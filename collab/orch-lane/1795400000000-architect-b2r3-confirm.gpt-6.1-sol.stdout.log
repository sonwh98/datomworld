  thrown in /w/f.php on line 2\\nS\")\n    26\t                   \"f.php\"))))))\n    27\t\n    28\t\n    29\t(deftest plain-fatal-keeps-shutdown-output-test\n    30\t  (testing \"a plain fatal followed by shutdown-time output\"\n    31\t    (let [r (oracle/parse-stdout \"a\\nFatal error: boom in /w/f.php on line 3\\nS\" \"f.php\")]\n    32\t      (is (= \"aS\" (:out r)))\n    33\t      (is (= {:class \"Error\", :message \"boom\"} (:uncaught r)))))\n    34\t  (testing \"a plain fatal at the very end\"\n    35\t    (is (= \"a\"\n    36\t           (:out (oracle/parse-stdout \"a\\nFatal error: boom in /w/f.php on line 3\\n\" \"f.php\"))))))\n     1\t(ns yang.php.antlr.programs-p5b2\n     2\t  \"P5b2 request-lifecycle completions: hand-derived PHP 8.3 expectations for\n     3\t  the request merge, header/cookie/status and error-triggering fixes. Every\n     4\t  fixture stays `:oracle :pending` for the shiva php:8.3 oracle pass.\")\n     5\t\n     6\t\n     7\t(defn request-array\n     8\t  [entries]\n     9\t  {:php/type :array, :index (into {} entries), :order (mapv first entries)})\n    10\t\n    11\t\n    12\t(def base-request\n    13\t  {:php.request/method \"POST\"\n    14\t   :php.request/uri \"/b2\"\n    15\t   :php.request/query (request-array [])\n    16\t   :php.request/headers (request-array [])\n    17\t   :php.request/cookies (request-array [])\n    18\t   :php.request/body (request-array [])\n    19\t   :php.request/server (request-array [])\n    20\t   :php.request/env (request-array [])\n    21\t   :php.request/files (request-array [])})\n    22\t\n    23\t\n    24\t(defn- fx\n    25\t  [id source request out & {:as more}]\n    26\t  (merge {:id id, :group :p5b2-lifecycle, :source source, :request request,\n    27\t          :out out, :oracle :pending}\n    28\t         more))\n    29\t\n    30\t\n    31\t(def numeric-merge-request\n    32\t  (assoc base-request\n    33\t         :php.request/query (request-array\n    34\t                             