d integers\n                 (define 'php.rt/constants (list 'cell/new (constants-form)))]\n                [(cons 'do\n                       (mapv (fn [[nm sym]] (list 'php/register! nm sym))\n                             builtins))]\n                ;; last, so a failed init never reports ready\n                [(define 'php.rt/state :php/ready) :php/null])\n              :php/null)))\n\n\n(def definitions\n  \"The single definition list, `[store-key form]` in definition order: every\n   prelude function, the literal state slot, then `php/init!`. Defining them\n   runs nothing.\"\n  (into (into core-definitions module-defs/definitions)\n        [['php.rt/state :php/uninit]\n         ['php/init! (init-form)]]))\n\n\n(def functions-uast\n  \"Every definition: lambdas and the literal state slot.\"\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) definitions)))\n\n\n(def uast\n  \"The bundled prelude: every definition, then the task's runtime state\n   allocated by `php/init!`.\"\n  (u/then functions-uast (u/sexp->uast '(php/init!))))\n\n\n;; =============================================================================\n;; The module emitter: the same definition list as the linker module `php`\n;; =============================================================================\n\n(def module-name\n  \"The linker module the PHP runtime profile is published as.\"\n  'php)\n\n\n(def runtime-keys\n  \"Every key `php/init!` allocates, the ready flag aside, sorted.\"\n  '[php.rt/class-index php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/error-handler\n    php.rt/class-order php.rt/exception-handler php.rt/exception-handlers php.rt/finalizable php.rt/pending-exc\n    php.rt/shutdown-fns php.rt/strict php.rt/included php.rt/path-map php.rt/unit\n    php.rt/autoloaders php.rt/autoloading php.rt/class-map php.rt/constants\n    php.rt/error-reporting php.rt/functions php.rt/globals php.rt/int-max\n    php.rt/int-min php.rt/next-cell php.rt/next-ord\n    php.rt/out php.rt/tmps])\n\n\n(defn strip\n  \"`sym` without the module's own namespace `php`; `php.rt/*` stays\n  (core/contains-rule? ctx\n                       (p/root (:pk ctx))\n                       \"returnStatement\"\n                       #{\"functionDeclaration\" \"lambdaFunctionExpr\" \"classDeclaration\"\n                         \"enumDeclaration\"}))\n\n\n(defn- unit-node\n  \"`unit-body`, inside the `return` escape when the unit has a top-level\n   `return`: the escape answers its value, the sentinel `:php/no-return`\n   when the body falls off its end (plan P6 R4). An included unit's body\n   (`module?`) always answers the sentinel at its end; the entry unit's\n   value is dropped, so its tree is unchanged when it has no `return`.\"\n  ([ctx] (unit-node ctx false))\n  ([ctx module?]\n   (cond\n     (unit-returns? ctx)\n     (app* 'php/call-ec\n           (u/lam ['%ret] (u/then (unit-body (assoc ctx :ret '%ret)) (u/lit :php/no-return))))\n     module? (u/then (unit-body ctx) (u/lit :php/no-return))\n     :else (unit-body ctx))))\n\n\n(defn lower-module-body\n  \"The unit's statements as one node, before the runtime wrapper: what\n   lowering goldens compare. Hoisted function declarations come first.\"\n  [packet]\n  (unit-body (context packet)))\n\n\n(def option-keys\n  \"The options `lower-program` and the lowering stage accept.\"\n  [:prelude :path :paths :class-map])\n\n\n(defn- path-map-node\n  \"`(php/bind-path-map! {path thunk ...})` for the composition's published\n   paths (plan P6 R3): the computed include's lookup table.\"\n  [paths]\n  (app* 'php/bind-path-map!\n        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\n                (u/lit {})\n                (sort paths))))\n\n\n(defn lower-program\n  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n   `php/run-main` after the prelude, tail calls marked. Its value is\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n   `:warnings` are the lowering's warning-severity diagnostics\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\n   `:yang.php/computed-include-path`).\n\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\n   body) or `:linked` (`(require 'php) (php/init!)`, the profile includes\n   need); `:path` the entry unit's declared path (default `entry-path`);\n","exit_code":1,"status":"failed"}}
