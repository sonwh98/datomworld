 \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n         