{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"8\\\\.10\\\\.9|8\\\\.10\\\\.11\\\" . -g '*.md' | head -30 && sed -n '40,130p' test/yang/typescript/antlr/linked_harness.cljc && rg -n \\\"publish|run-linked|run-source|source\\\\(\\\" test/yang/typescript/antlr/linked_harness.cljc\"","aggregated_output":"./docs/design/yang.antlr.md:3937:#### 8.10.9 Publication, visibility, and reproducibility\n./docs/design/yang.antlr.md:4010:#### 8.10.11 Acceptance gates\n\n(defn registry\n  \"The full host registry a linked JavaScript composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `jssp` polls a signal stream, so the\n   safepointed composition needs it even though `js` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`js` published once into its own content store:\n   `{:store s :result r :address a :call-address ca}`. `yang.call` is\n   published first so `js` pins its shared calling runtime.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store,\n       :result result,\n       :address (:address result),\n       :call-address (:address call-result)})))\n\n\n(def published-jssp\n  \"`jssp` published once into `js`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test\n   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n  ([] (source {'js (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition over the published modules: `jssp` requires\n   `js`, and `js` requires `yang.call`.\"\n  []\n  (source {'js (:address @published),\n           'jssp (:address @published-jssp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n4:   this is the publisher of `js` and `jssp`, so it publishes each module\n8:   evidence is `publish-module!`'s own `link-local` links, which\n30:            [yin.vm.linker.publish :as publish]\n55:(def published\n56:  \"`js` published once into its own content store:\n58:   published first so `js` pins its shared calling runtime.\"\n61:          call-result (publish/publish-module! store (call/module-spec (registry)))\n62:          result (publish/publish-module! store\n71:(def published-jssp\n72:  \"`jssp` published once into `js`'s own content store, which its pinned\n73:   requirement already lives in: the same shape as `published`.\"\n75:    (let [{:keys [store address]} @published\n76:          result (publish/publish-module!\n82:  \"The serving composition over the published store: `name-env` defaults\n84:   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n85:  ([] (source {'js (:address @published),\n86:               'yang.call (:call-address @published)}))\n88:   (link/composition {:content-store (:store @published),\n94:  \"The serving composition over the published modules: `jssp` requires\n97:  (source {'js (:address @published),\n98:           'jssp (:address @published-jssp),\n99:           'yang.call (:call-address @published)}))\n102:(defn publish-guest-module!\n103:  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n105:   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n106:   test may publish its own; publish imports bottom-up, the `deps` map\n109:  (publish/publish-module! (:store @published) spec))\n177:(defn run-linked\n184:  ([backend ast] (run-linked backend ast {}))\n201:                    (vm/value (run-linked k ast {:modules modules})))]))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3930,4025p' docs/design/yang.antlr.md && sed -n '170,230p' test/yang/typescript/antlr/linked_harness.cljc && rg -n \\\"defn module-spec|module-spec\\\" src/cljc/yang/typescript/antlr/prelude.cljc src/cljc/yang/typescript/antlr/lower.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3930,4025p' docs/design/yang.antlr.md && sed -n '170,230p' test/yang/typescript/antlr/linked_harness.cljc && rg -n \\\"defn module-spec|module-spec\\\" src/cljc/yang/typescript/antlr/prelude.cljc src/cljc/yang/typescript/antlr/lower.cljc\"","aggregated_output":"supported: a claiming profile must define and test restoration and\nreference lifetimes for every crossed frame.\n\nInvoking a function-valued argument is internal Yin computation.\nHost-initiated callbacks remain stream events under\n`datom.world.abi.md`; this convention adds no host callback facility.\n\n#### 8.10.9 Publication, visibility, and reproducibility\n\nShared callability creates no common global scope. An import or\ncomposition explicitly binds exports in the receiving source namespace\nunder its normal name/module rules. Missing names keep their source\nerrors. No fallback searches other frontends, the filesystem, a host\npackage registry, or ambient globals.\n\nLinked modules publish code and immutable specifications. Their bodies\ninstantiate function objects and common entries in the importing task,\nas section 8.5.6 requires. Install children must not export live function\ncells. A higher-order result is an ordinary runtime value, not a new\nlinker publication on each call.\n\nLowering/runtime profiles pin the implementation and binding/value\nextensions. Existing dependency/effect/custody checks remain. Type facts\nstay beside code under `yin.vm.typecheck`, not in lambda language tags.\nDo not duplicate existing lambda parameters in another persisted\nauthority over the private body signature.\n\nBefore admitting a compiled composition, its profile/dependency\ndeclarations must establish one compatible convention revision for the\nentries it exposes. An incompatible revision needs an explicitly pinned\nprojection or is refused before execution. Neither a common slot name nor\nan opaque runtime closure proves revision compatibility. No runtime\nlanguage registry or inspection of captured environments supplies it.\n\nChanged entry code changes code identities through the normal encoder.\nRetain source, lowered UAST, pinned profiles, and projections under\nexisting provenance/unitarity rules. A fast path may omit the record\nonly after proving equivalent evaluation, binding, foreign callability,\nexceptions, effects, suspension, and identity. Correctness must not\ndepend on that optimization.\n\n#### 8.10.10 Current code and migration\n\nThe current code records the gap, not a second normative convention:\n\n| Current implementation | Private call path |\n|---|---|\n| `yang.python.antlr.prelude` | `py/call-kw` binds arguments and applies the function cell's `:code` to one vector. |\n| `yang.typescript.antlr.prelude` | `js/call` checks `:js/type :function` and applies `:code` to receiver and argument vector. |\n| `yang.php.antlr.prelude` | `php/call` applies `:code` to the function cell and argument vector; named/reference handling is separate. |\n| `test/yang/cross_lang_test.clj` | Demonstrates PHP/TypeScript substrate composition using lookup rewriting and a test-local `js-shaped` wrapper; not proof of this convention. |\n\nImplementation proceeds as separately verified changes:\n\n1. Supply the shared guest prelude and fixtures for entry discovery,\n   record validation, and condition transfer, using existing bundled/\n   linked prelude emitter machinery.\n2. Add entries to each supported callable constructor and builtin;\n   preserve source metadata/private code while putting binding and\n   exception boundaries under the entry. Keep existing source `:call`\n   safepoint marks on their original source activation, normally the\n   private body; generated entry/binding boilerplate remains unmarked.\n   Do not copy a body's source mark onto its entry and count both. A\n   separately proved instrumentation transformation may relocate a mark\n   only while preserving its source timing and exactly one activation.\n3. Route source-resolved calls and callable tests through the convention,\n   including supported bound methods, callable objects, recursion, and\n   nested runtime re-entry.\n4. Integrate explicit export/name projections with module publication\n   and task-local instantiation; remove test-only language-pair wrappers\n   from the new conformance paths.\n5. Pass the acceptance gates before advertising a conforming frontend\n   revision. Old body signatures must not be mistaken for new entries.\n\nA frontend is not conformant while its advertised supported callable\nkinds need pairwise wrappers. Legacy non-ANTLR frontends gain no claim\nfrom this proposal; joining later requires the same entry obligations.\nThere is no implication that current Python, PHP, TypeScript, or a host\ntarget has completed this migration.\n\n#### 8.10.11 Acceptance gates\n\nExecute real lowered source bodies, not only synthetic functions with\nthe expected slot. A harness may compose published exports and namespace\nprojections explicitly. It must not rewrite call nodes, extract foreign\n`:code`, or insert test-local language-pair wrappers to make calls work.\n\nRequired evidence:\n\n- **Local semantics:** existing suites preserve argument order, defaults,\n  required/extra arguments, keyword errors, receivers, exceptions, and\n  supported reference/static behavior.\n- **Direct calls:** each implemented frontend calls every other\n  conforming frontend through the same mechanism in both directions\n  with compatible values. Derive the test matrix from admitted\n  frontends; do not hard-code it into runtime dispatch.\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`. Options:\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `js`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `jssp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\nsrc/cljc/yang/typescript/antlr/prelude.cljc:3788:(defn module-spec\nsrc/cljc/yang/typescript/antlr/prelude.cljc:3794:  (core/module-spec {:module-name module-name,\n","exit_code":0,"status":"completed"}}
