ess.cljc:66:                                       'yang.call (:call-address @published)} name-env),\ntest/yang/php/antlr/linked_harness.cljc:118:(defn name-env\ntest/yang/php/antlr/linked_harness.cljc:148:           src (or (:src opts) (source (name-env result)))]\ntest/yang/php/antlr/linked_harness.cljc:42:          call-result (publish/publish-module! store (call/module-spec (registry)))\ntest/yang/php/antlr/linked_harness.cljc:43:          result (publish/publish-module! store (prelude/module-spec (registry)\ntest/yang/php/antlr/linked_harness.cljc:60:  \"The serving composition over the published store: `name-env` names `php`\ntest/yang/php/antlr/linked_harness.cljc:63:  [name-env]\ntest/yang/php/antlr/linked_harness.cljc:65:                     :name-env (merge {'php (:address @published),\ntest/yang/php/antlr/linked_harness.cljc:66:                                       'yang.call (:call-address @published)} name-env),\ntest/yang/php/antlr/linked_harness.cljc:118:(defn name-env\ntest/yang/php/antlr/linked_harness.cljc:148:           src (or (:src opts) (source (name-env result)))]\ntest/yang/php/antlr/zz_probe_test.clj:47:                      src (lh/source (lh/name-env result))]\ntest/yang/php/antlr/zz_probe2_test.clj:47:                      src (lh/source (lh/name-env result))]\ntest/yang/php/antlr/zz_probe3_test.clj:47:                      src (lh/source (lh/name-env result))]\ntest/yang/php/antlr/include_test.clj:135:  (let [env (dissoc (lh/name-env result) (lower/path-module-symbol path))]\ntest/yang/php/antlr/zz_probe_test.clj:47:                      src (lh/source (lh/name-env result))]\ntest/yang/php/antlr/include_test.clj:135:  (let [env (dissoc (lh/name-env result) (lower/path-module-symbol path))]\ntest/yang/php/antlr/zz_probe3_test.clj:47:                      src (lh/source (lh/name-env result))]\ntest/yang/php/antlr/zz_probe2_test.clj:47:                      src (lh/source (lh/name-env result))]\ntest/yang/php/antlr/prelude_test.cljc:53:(deftest module-spec-declares-every-free-name-test\ntest/yang/php/antlr/prelude_test.cljc:55:    (let [spec (prelude/module-spec (h/host-registry) :test/call-address)]\ntest/yang/php/antlr/prelude_test.cljc:53:(deftest module-spec-declares-every-free-name-test\ntest/yang/php/antlr/prelude_test.cljc:55:    (let [spec (prelude/module-spec (h/host-registry) :test/call-address)]\n\n(def free-names\n  \"Every variable name some occurrence of the map AST reads unbound by an\n   enclosing lambda.\"\n  core/free-names)\n\n\n(def defined-keys\n  \"Every literal key the map AST defines with `yin/def`, at any depth.\"\n  core/defined-keys)\n\n\n(def ^:private module-free-names\n  \"The names the module tree reads and does not define, sorted: the\n   primitives and the host exports its manifest must declare.\"\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `js` over\n   the host registry `registry`, pinned to the published `yang.call` module\n   at `call-address`. A free name nothing supplies is refused before\n   anything is published. This namespace emits; it never publishes.\"\n  [registry call-address]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {'yang.call call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the js module reads an undeclared name\",\n                     :refusal-ns \"yang.typescript.antlr\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: every inline\n   literal (up to 2^53 - 1) must fit.\"\n  53)\n\n\n(defn register-integer-module\n  \"Return `registry` with the `integer` module installed under `limits`\n   for this profile: refused when `::integer/max-bits` is under\n   `min-integer-bits`, otherwise `integer/register-integer-module`.\"\n  [registry limits]\n  (let [b (::integer/max-bits limits)]\n    (when-not (and (int? b) (<= min-integer-bits b))\n      (throw (ex-info \"the JavaScript profile needs integer max-bits >= 53\"\n                      {:yang.typescript.antlr/refusal\n                       :yang.typescript.antlr/max-bits,\n                       ::integer/max-bits b}))))\n  (integer/register-integer-module registry limits))\n\n\n(defn admit\nsrc/cljc/yang/php/antlr/prelude.cljc:5239:(defn module-spec\nsrc/cljc/yang/php/antlr/lower.cljc:3800:(defn module-spec\n","exit_code":0,"status":"completed"}}
