cs/design/dao.space.query.md:193:`dao.space.index` aborts publication on one. Each caller keeps its own.\ndocs/design/yin.vm.debruijn-projection.md:120:whose content hash is the node-hash domain separator. Persistent publication or\n(ns yang.php.antlr.e2e-test\n  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n   envelope -> the bundled program on each of the four VMs (the AST walker,\n   the semantic, stack and register VMs). Every fixture of\n   `yang.php.antlr.programs` prints the same text on all four.\"\n  (:require\n    [clojure.walk :as walk]\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.uast :as u]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.packets-p3b :as packets-p3b]\n    [yang.php.antlr.permutations :as perms]\n    [yang.php.antlr.phpt :as phpt]\n    [yang.php.antlr.programs :as programs]\n    [yang.php.antlr.programs-p3b :as p3b]\n    [yang.typescript.antlr.e2e-test :as ts]\n    [yin.vm :as vm]\n    [yin.vm.test-utils :as tu]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(defn- rendered\n  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n  [{:keys [out uncaught]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(deftest ^:slow fixtures-on-every-vm-test\n  (doseq [{:keys [id source] :as fixture} programs/fixtures\n          :let [out (rendered fixture)]]\n    (testing (name id)\n      (let [results (h/run-php source)]\n        (is (not (contains? results :diagnostics)) (pr-str results))\n        (doseq [k vms]\n          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n\n\n(deftest fixtures-on-the-walker-test\n  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n          :let [r (h/run-raw source)]]\n    (is (not= :pending oracle) (name id))\n    (is (= out (h/latin1->text (:php/out r))) (name id))\n    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n        (name id))))\n\n\n(defn- app?\n  [node op]\n  (and (map? node)\n       (= :application (:type node))\n       (= {:type :variable, :name op} (:operator node))))\n\n\n(defn- lowered-ts\n  [source]\n  (let [{:keys [program diagnostics]} (ts/lower-source source :bundled)]\n    (assert (nil? diagnostics) (pr-str diagnostics))\n    (let [{:yin/keys [batch root]} program]\n      (nth batch root))))\n\n\n(defn- export-projection\n  \"The donor program followed by its explicitly named global export read.\"\n  [donor export-name]\n  (u/then donor (u/sexp->uast (list 'js/global-get {:js/str export-name}))))\n\n\n(defn- install-php-function-export\n  \"Project `%foreign` into PHP's function namespace before the source body.\n   The lowered PHP call and its resolve/call nodes remain untouched.\"\n  [ast export-name]\n  (let [projection (u/sexp->uast\n                     (list 'cell/set! 'php.rt/functions\n                           (list 'assoc\n                                 '(cell/get php.rt/functions)\n                                 export-name\n                                 '%foreign)))\n        seen (volatile! false)\n        result (walk/postwalk\n                 (fn [node]\n                   (if (app? node 'php/run-main)\n                     (let [body (first (:operands node))]\n                       (assert (= :lambda (:type body)) \"php/run-main body is not a lambda\")\n                       (vreset! seen true)\n                       (assoc node :operands [(update body :body #(u/then projection %))]))\n                     node))\n                 ast)]\n    (assert @seen \"PHP program has no php/run-main application\")\n    result))\n\n\n(defn- run-with-ts-export\n  [donor-source export-name php-source]\n  (let [donor (lowered-ts donor-source)\n        {:keys [ast diagnostics]} (h/lower-program php-source)\n        _ (assert (nil? diagnostics) (pr-str diagnostics))\n        php-ast (install-php-function-export ast export-name)\n        composition {:type :application,\n                     :operator {:type :lambda,\n                                :params ['%foreign],\n                                :body php-ast},\n                     :operands [(export-projection donor export-name)]}\n        result (vm/value (vm/eval (tu/create-vm {:modules (php-h/host-registry)})\n                                  composition))]\n    (h/render result)))\n\n\n(defn- run-with-ts-global\n  \"Project `%foreign` into a PHP global before the unmodified source body.\"\n  [donor-source export-name php-global php-source]\n  (let [donor (lowered-ts donor-source)\n        {:keys [ast diagnostics]} (h/lower-program php-source)\n        _ (assert (nil? diagnostics) (pr-str diagnostics))\n        global-projection (u/sexp->uast\n                            (list 'php/global-store! php-global '%foreign))\n        seen (volatile! false)\n        php-ast (walk/postwalk\n                  (fn [node]\n                    (if (app? node 'php/run-main)\n                      (let [body (first (:operands node))]\n                        (assert (= :lambda (:type body)) \"php/run-main body is not a lambda\")\n                        (vreset! seen true)\n                        (assoc node :operands [(update body :body #(u/then global-projection %))]))\n                      node))\n                  ast)\n        _ (assert @seen \"PHP program has no php/run-main application\")\n        composition {:type :application,\n                     :operator {:type :lambda,\n                                :params ['%foreign],\n                                :body php-ast},\n                     :operands [(export-projection donor export-name)]}\n        result (vm/value (vm/eval (tu/create-vm {:modules (php-h/host-registry)})\n                                  composition))]\n    (h/render result)))\n\n\n(deftest real-lowered-ts-export-called-from-php-test\n  (testing \"unmodified PHP source calls a published TS global export through yang.call\"\n    (is (= \"4\"\n           (run-with-ts-export\n             \"globalThis.donor = (x, y) => x + y;\"\n             \"donor\"\n             \"<?php echo donor(1.5, 2.5);\")))))\n\n\n(deftest real-lowered-ts-callback-called-from-php-test\n  (testing \"PHP stores a foreign function cell in an array, invokes it, and keeps its identity\"\n    (is (= \"same\"\n           (run-with-ts-global\n             \"globalThis.donor = () => { globalThis.called = true; };\"\n             \"donor\"\n             \"cb\"\n             \"<?php $items = [$cb]; $items[0](); echo ($items[0] === $cb ? 'same' : 'different');\")))))\n\n\n(deftest real-lowered-php-callback-round-trip-test\n  (testing \"TS stores and calls the received PHP closure, then returns the same cell\"\n    (is (= \"calledsame\"\n           (run-with-ts-export\n             (str \"globalThis.accept = (f) => {\"\n                  \" globalThis.stored = f;\"\n                  \" globalThis.stored(7);\"\n                  \" return globalThis.stored;\"\n                  \"};\")\n             \"accept\"\n             (str \"<?php $cb = function($x) {\"\n                  \" echo 'called'; return $x + 1;\"\n                  \"};\"\n                  \"$returned = accept($cb);\"\n                  \"echo ($returned === $cb ? 'same' : 'different');\"))))))\n\n\n(deftest packets-match-source-test\n  (doseq [[id form] packets/forms\n          :let [{:keys [source]} (first (filter #(= id (:id %)) programs/fixtures))]]\n    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\n\n\n(defn- matrix-rows\n  [out]\n  (let [[eq sp] (str/split-lines out)\n        w (count programs/matrix-values)]\n    {:eq (mapv #(apply str %) (partition w eq)),\n     :sp (mapv #(apply str (map {\\0 \"<\", \\1 \"=\", \\2 \">\"} %)) (partition w sp))}))\n\n\n(deftest scalar-comparison-matrix-test\n  (let [{:keys [eq sp]} (matrix-rows (h/run-walker programs/matrix-source))]\n    (is (= programs/equal-matrix eq))\n    (is (= programs/spaceship-matrix sp))\n    (testing \"cells reasoned from the manual, independent of the golden\"\n      (let [idx (zipmap programs/matrix-values (range))]\n        (doseq [[a b eq? cmp] programs/known-cells\n                :let [i (idx a), j (idx b)]]\n          (is (= (if eq? \\1 \\0) (get-in eq [i j])) (str a \" == \" b))\n          (is (= (get {-1 \\<, 0 \\=, 1 \\>} cmp) (get-in sp [i j])) (str a \" <=> \" b)))))))\n\n\n(deftest float-text-test\n  (let [src (str \"<?php\\n\"\n                 (apply str (for [[lit] programs/float-cases]\n                              (str \"echo \" lit \", \\\"|\\\"; var_dump(\" lit \");\\n\"))))\n        expected (str (apply str (for [[_ echo dump] programs/float-cases]\n                                   (str echo \"|float(\" dump \")\\n\"))))]\n    (is (= expected (h/run-walker src)))))\n\n\n(deftest refusals-are-named-test\n  (doseq [[source construct]\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:36:   `js/global-get`, ...), for `js.rt/*` is an internal store key invisible\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:63:  \"The linker module the hook prelude is published as.\"\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:82:                 (js/get-prop (js/global-get {:js/str \"Error\"})\nsrc/cljc/yang/typescript/antlr/safepoint.cljc:217:   is published. This namespace emits; it never publishes.\"\ntest/yang/typescript/antlr/linked_harness.cljc:55:(def published\ntest/yang/typescript/antlr/linked_harness.cljc:56:  \"`js` published once into its own content store:\ntest/yang/typescript/antlr/linked_harness.cljc:58:   published first so `js` pins its shared calling runtime.\"\ntest/yang/typescript/antlr/linked_harness.cljc:71:(def published-jssp\ntest/yang/typescript/antlr/linked_harness.cljc:72:  \"`jssp` published once into `js`'s own content store, which its pinned\ntest/yang/typescript/antlr/linked_harness.cljc:73:   requirement already lives in: the same shape as `published`.\"\ntest/yang/typescript/antlr/linked_harness.cljc:75:    (let [{:keys [store address]} @published\ntest/yang/typescript/antlr/linked_harness.cljc:82:  \"The serving composition over the published store: `name-env` defaults\ntest/yang/typescript/antlr/linked_harness.cljc:85:  ([] (source {'js (:address @published),\ntest/yang/typescript/antlr/linked_harness.cljc:86:               'yang.call (:call-address @published)}))\ntest/yang/typescript/antlr/linked_harness.cljc:88:   (link/composition {:content-store (:store @published),\ntest/yang/typescript/antlr/linked_harness.cljc:94:  \"The serving composition over the published modules: `jssp` requires\ntest/yang/typescript/antlr/linked_harness.cljc:97:  (source {'js (:address @published),\ntest/yang/typescript/antlr/linked_harness.cljc:98:           'jssp (:address @published-jssp),\ntest/yang/typescript/antlr/linked_harness.cljc:99:           'yang.call (:call-address @published)}))\ntest/yang/typescript/antlr/linked_harness.cljc:102:(defn publish-guest-module!\ntest/yang/typescript/antlr/linked_harness.cljc:103:  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\ntest/yang/typescript/antlr/linked_harness.cljc:109:  (publish/publish-module! (:store @published) spec))\nsrc/cljc/yang/typescript/antlr/prelude.cljc:1757:    [js/global-get\nsrc/cljc/yang/typescript/antlr/prelude.cljc:3730:;; The linked js module requires the separately published `yang.call` module\nsrc/cljc/yang/typescript/antlr/prelude.cljc:3734:  \"The linker module the JavaScript runtime profile is published as.\"\nsrc/cljc/yang/typescript/antlr/prelude.cljc:3790:   the host registry `registry`, pinned to the published `yang.call` module\nsrc/cljc/yang/typescript/antlr/prelude.cljc:3792:   anything is published. This namespace emits; it never publishes.\"\nsrc/cljc/yang/typescript/antlr/lower.cljc:12:     function), `js/lexical-get` (TDZ-capable) or `js/global-get` (a free\nsrc/cljc/yang/typescript/antlr/lower.cljc:542:      (app* 'js/global-get (u/lit (jstr nm))))))\nsrc/cljc/yang/typescript/antlr/lower.cljc:560:      (u/then (app* 'js/global-get (u/lit (jstr nm)))\nsrc/cljc/yang/typescript/antlr/lower.cljc:964:(defn- refuse-global!\ntest/yang/typescript/antlr/lower_test.clj:117:    (is (contains? (reads \"nope;\") 'js/global-get) \"free name\")\ntest/yang/typescript/antlr/prelude_parity_test.cljc:560:   [(throws '(js/global-get {:js/str \"nope\"})) {:js/str \"ReferenceError\"}]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:563:   ['(js/global-get {:js/str \"undefined\"}) :js/undefined]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:564:   ['(js/global-get {:js/str \"Infinity\"}) {:n :inf}]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:565:   ['(js/typeof (js/global-get {:js/str \"console\"})) {:js/str \"object\"}]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:567:   [(list 'js/call '(js/global-get {:js/str \"String\"}) :js/undefined (av {:n 1.5}))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:569:   [(list 'js/call '(js/global-get {:js/str \"String\"}) :js/undefined (av '(js/neg {:n 0})))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:571:   ['(js/call (js/global-get {:js/str \"String\"}) :js/undefined []) {:js/str \"\"}]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:572:   [(list 'js/call '(js/global-get {:js/str \"Number\"}) :js/undefined (av {:js/str \"12\"}))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:574:   [(list 'js/call '(js/global-get {:js/str \"Number\"}) :js/undefined (av 7)) {:n 7}]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:575:   ['(js/call (js/global-get {:js/str \"Number\"}) :js/undefined []) {:n 0}]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:576:   [(list 'js/call '(js/global-get {:js/str \"Boolean\"}) :js/undefined (av {:js/str \"\"}))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:578:   [(list 'js/call '(js/global-get {:js/str \"BigInt\"}) :js/undefined (av {:n 5})) 5]\ntest/yang/typescript/antlr/prelude_parity_test.cljc:579:   [(list 'js/call '(js/global-get {:js/str \"BigInt\"}) :js/undefined (av {:js/str \" 12 \"}))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:581:   [(list 'js/call '(js/global-get {:js/str \"BigInt\"}) :js/undefined (av {:js/str \"0x10\"}))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:583:   [(throws (list 'js/call '(js/global-get {:js/str \"BigInt\"}) :js/undefined (av {:n 1.5})))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:585:   [(throws (list 'js/call '(js/global-get {:js/str \"BigInt\"}) :js/undefined (av {:js/str \"x\"})))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:587:   [(throws (list 'js/call '(js/global-get {:js/str \"BigInt\"}) :js/undefined (av :js/undefined)))\ntest/yang/typescript/antlr/linked_prelude_test.cljc:7:   published modules and the linked runs are\ntest/yang/typescript/antlr/linked_prelude_test.cljc:119:  (let [call-address (:call-address @h/published)\ntest/yang/typescript/antlr/linked_prelude_test.cljc:140:  (let [{:keys [result address]} @h/published\ntest/yang/typescript/antlr/linked_prelude_test.cljc:153:      (let [{:keys [result]} @h/published-jssp]\ntest/yang/typescript/antlr/object_parity_test.cljc:31:(def ^:private object-ctor '(js/global-get {:js/str \"Object\"}))\ntest/yang/typescript/antlr/object_parity_test.cljc:146:   [(throws '(js/construct (js/global-get {:js/str \"BigInt\"}) [])) (k \"TypeError\")]\ntest/yang/typescript/antlr/object_parity_test.cljc:147:   [(throws '(js/construct (js/global-get {:js/str \"Symbol\"}) [])) (k \"TypeError\")]\ntest/yang/typescript/antlr/object_parity_test.cljc:148:   [(throws '(js/construct (js/global-get {:js/str \"String\"}) [])) (k \"TypeError\")]\ntest/yang/typescript/antlr/object_parity_test.cljc:152:   ['(let [e (js/construct (js/global-get {:js/str \"Error\"}) (js/vconj [] {:js/str \"boom\"}))]\ntest/yang/typescript/antlr/object_parity_test.cljc:156:   ['(js/object? (js/construct (js/global-get {:js/str \"Object\"}) [])) true]\ntest/yang/typescript/antlr/object_parity_test.cljc:297:        (tag true) (tag (js/global-get {:js/str \"Object\"}))\ntest/yang/typescript/antlr/object_parity_test.cljc:579:           f (js/global-get {:js/str \"Object\"})]\ntest/yang/typescript/antlr/object_parity_test.cljc:584:   [(throws '(js/call (js/global-get {:js/str \"Object\"})\ntest/yang/typescript/antlr/object_parity_test.cljc:590:                    (js/global-get {:js/str \"Object\"}))\ntest/yang/typescript/antlr/object_parity_test.cljc:591:      (js/get-prop (js/global-get {:js/str \"Object\"}) {:js/str \"name\"})\ntest/yang/typescript/antlr/object_parity_test.cljc:592:      (js/get-prop (js/global-get {:js/str \"Object\"}) {:js/str \"length\"})]\n","exit_code":0,"status":"completed"}}
