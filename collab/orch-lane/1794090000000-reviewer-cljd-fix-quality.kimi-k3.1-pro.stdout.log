(ns yang.typescript.antlr.linked-harness
  "The linked profile's composition for the JavaScript tests (T1 step S5,
   docs/design/yang.typescript.md section 13): the namespace that requires
   this is the publisher of `js` and `jssp`, so it publishes each module
   once per process into one in-memory content store and serves them to
   every linked run over a `yin.vm.linker.interpreter` composition under
   `:trusted` derivation (the remediation ruling's R6). The `:verifying`
   evidence is `publish-module!`'s own `link-local` links, which
   `linked-prelude-test` asserts.

   A linked run builds the program's task on one of the three vector VMs
   with a link pair, then runs the VM and serves the pair alternately
   until the VM stops blocking, as the REPL's drive does. The AST walker
   is not a backend here: its link of `js` is refused `:undeclared-free`
   until L-b."
  (:require [yin.vm.semantic.linearize :as sr-linearize]
            [yin.vm.semantic.derive :as derive]
            [dao.jing.mem :as mem]
            [yang.core.call :as call]
            [yang.typescript.antlr.prelude :as prelude]
            [yang.typescript.antlr.safepoint :as safepoint]
            [yin.vm :as vm]
            [yin.vm.data :as data]
            [yin.vm.debruijn-code :as dcode]
            [yin.vm.debruijn-register-code :as rcode]
            [yin.vm.debruijn.register :as rvm]
            [yin.vm.debruijn.stack :as dvm]
            [yin.vm.integer :as integer]
            [yin.vm.linker.interpreter :as link]
            [yin.vm.linker.publish :as publish]
            [yin.vm.module :as module]
            [yin.vm.semantic :as semantic]
            [yin.vm.test-utils :as tu]))


(def integer-limits
  "The ordinary JavaScript composition's `integer` limits."
  {::integer/max-bits 100000, ::integer/max-digits 4300})


(defn registry
  "The full host registry a linked JavaScript composition registers: the
   `require` handler, then `cell`, `data`, `integer` under `limits`, and
   `stream` — the hook module `jssp` polls a signal stream, so the
   safepointed composition needs it even though `js` does not."
  ([] (registry integer-limits))
  ([limits]
   (-> (module/default-registry)
       module/register-cell-module
       (data/register-data-module {::data/max-items 1048576})
       (prelude/register-integer-module limits)
       module/register-stream-module)))


(def published
  "`js` published once into its own content store:
   `{:store s :result r :address a :call-address ca}`. `yang.call` is
   published first so `js` pins its shared calling runtime."
  (delay
    (let [store (mem/create-content-mem)
          call-result (publish/publish-module! store (call/module-spec (registry)))
          result (publish/publish-module! store
                                          (prelude/module-spec (registry)
                                                               (:address call-result)))]
      {:store store,
       :result result,
       :address (:address result),
       :call-address (:address call-result)})))


(def published-jssp
  "`jssp` published once into `js`'s own content store, which its pinned
   requirement already lives in: the same shape as `published`."
  (delay
    (let [{:keys [store address]} @published
          result (publish/publish-module!
                   store (safepoint/module-spec (registry) address))]
      {:store store, :result result, :address (:address result)})))


(defn source
  "The serving composition over the published store: `name-env` defaults
   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test
   being the publisher. `jssp`-serving sources pass their own `name-env`."
  ([] (source {'js (:address @published),
               'yang.call (:call-address @published)}))
  ([name-env]
   (link/composition {:content-store (:store @published),
                      :name-env name-env,
                      :derivation :trusted})))


(defn safepoint-source
  "The serving composition over the published modules: `jssp` requires
   `js`, and `js` requires `yang.call`."
  []
  (source {'js (:address @published),
           'jssp (:address @published-jssp),
           'yang.call (:call-address @published)}))


(defn publish-guest-module!
  "One guest module's `spec` (lower/module-spec's) published into `js`'s
   own content store, where its pinned requirements already live:
   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a
   test may publish its own; publish imports bottom-up, the `deps` map
   naming each import's address."
  [spec]
  (publish/publish-module! (:store @published) spec))


(def backends
  "Each vector backend's root task over a program AST and composition."
  {:semantic (fn [ast opts]
               (semantic/load-ast (semantic/create-vm opts)
                                  (vm/ast->datoms ast)
                                  vm/ast-contract)),
   :stack (fn [ast opts]
            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))
                           (assoc opts :contract vm/stack-contract))),
   :register (fn [ast opts]
               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))
                              (assoc opts :contract vm/register-contract)))})


(def continues
  "Each vector backend's admission of the next top-level unit to a halted
   task, as `yin.repl` admits an input line: the task keeps its store,
   heap, module registry and module stores."
  {:semantic (fn [task ast]
               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),
   :stack (fn [task ast]
            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))
                  attached (dvm/attach-image task img vm/stack-contract)]
              (assoc attached
                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])
                     :frames [] :stack [] :continuation []
                     :halted? false :blocked? false :value nil))),
   :register (fn [task ast]
               (let [img (derive/register-image (:vector (sr-linearize/project ast)))
                     attached (rvm/attach-image task img vm/register-contract)
                     pc (rvm/absolute-pc attached
                                         [(rcode/register-hash img) 0])
                     body (some #(when (= pc (:start %)) %)
                                (:bodies (:segment attached)))]
    [php/not-passed
     (fn [written idx pname passed required exact]
       (if (< (- idx 1) passed)
         (php/throw-error "ArgumentCountError"
                          (data/str-concat written "(): Argument #" (integer/format idx) " ($"
                                           pname ") not passed"))
         (php/too-few written passed required exact)))]
    [php/copy-capture
     (fn [v] (if (= v :php/undef) v (php/addref v)))]
    [php/local-capture
     ;; an arrow function's by-value capture: an unset variable stays unset
     (fn [c] (let [v (cell/get c)] (if (= v :php/undef) v (php/deref v))))]
    [php/global-capture
     (fn [name] (let [v (php/global-slot name)] (if (nil? v) :php/undef (php/deref v))))]
    [php/arg (fn [args i] (get args i))]
    [php/arity-error
     (fn [name want args]
       (php/throw-error
         "ArgumentCountError"
         (data/str-concat name "() expects " want " argument"
                          (if (= want "exactly 1") "" "s") ", "
                          (integer/format (data/count args)) " given")))]
    [php/bi-var-dump
     (fn [args]
       (if (= (data/count args) 0)
         (php/throw-error "ArgumentCountError"
                          "var_dump() expects at least 1 argument, 0 given")
         (php/var-dump-each args 0)))]
    [php/var-dump-each
     (fn [args i]
       (if (< i (data/count args))
         (do (php/var-dump (get args i))
             (php/var-dump-each args (+ i 1)))
         :php/null))]
    [php/bi-intdiv
     (fn [args]
       (if (= (data/count args) 2)
         (php/intdiv (php/arg-int (get args 0) "intdiv" 1 "num1")
                     (php/arg-int (get args 1) "intdiv" 2 "num2"))
         (php/arity-error "intdiv" "exactly 2" args)))]
    [php/bi-fmod
     (fn [args]
       (if (= (data/count args) 2)
         (php/fmod (php/arg-float (get args 0) "fmod" 1 "num1")
                   (php/arg-float (get args 1) "fmod" 2 "num2"))
         (php/arity-error "fmod" "exactly 2" args)))]
    [php/bi-strlen
     (fn [args]
       (if (= (data/count args) 1)
         (data/str-length (php/to-string (get args 0)))
         (php/arity-error "strlen" "exactly 1" args)))]
(ns yang.typescript.antlr.source-call-test
  "S11: real source calls through the shared convention (§8.10.11).
   The composition publishes the separately lowered PHP body, runs it, and
   projects its resolved functions into the JS global namespace. Neither
   frontend's call nodes or function bodies are rewritten."
  (:require
    [clojure.string :as str]
    [clojure.test :refer [deftest is testing]]
    [dao.test-slow :as slow]
    [yang.core.module :as core-module]
    [yang.core.uast :as u]
    [yang.php.antlr.lower :as php-lower]
    [yang.php.antlr.portable-harness :as php-h]
    [yang.php.antlr.prelude :as php-prelude]
    [yang.typescript.antlr.linked-harness :as h]
    [yang.typescript.antlr.lower :as lower]
    [yang.typescript.antlr.prelude :as prelude]
    [yang.typescript.antlr.prelude-parity-test :as parity]
    [yang.typescript.antlr.render :as render]
    [yang.typescript.antlr.source-call-fixtures :as fixtures]
    [yin.vm :as vm]))


(def ^:private published-php
  (delay (h/publish-guest-module!
           (php-prelude/module-spec (h/registry)
                                    (:call-address @h/published)))))


(defn- source-module
  "An ordinary module exporting the unmodified lowered source body."
  [name packet]
  (core-module/module-spec
    :yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free
    (h/registry)
    {:name name,
     :ast (core-module/module-tree
            [(core-module/require-node 'php)
             (u/def! 'body (u/lam [] (php-lower/lower-module-body packet)))]),
     :exports '#{body},
     :runtime-name 'php,
     :runtime-address (:address @published-php)}))


(defn- projection
  "Namespace composition only: preserve each resolved function cell."
  [names]
  (u/sexp->uast
    (cons 'do
          (map (fn [name]
                 (list 'js/define-global! name (list 'php/resolve-fn name name)))
               names))))


(defn- check-source
  [{:keys [module php-form functions ts-form expected]}]
  (let [expected {:js/out (str/split-lines expected), :js/uncaught nil}
        php-packet (php-h/packet php-form)
        ts-packet (php-h/packet ts-form)
        project (projection functions)
        bundled (u/mark-tails
                  (u/seq-nodes [(php-lower/lower-packet php-packet)
                                prelude/uast project
                                (u/app (u/v 'js/run-main) (lower/lower-unit ts-packet))]))]
    (testing "bundled source on every VM"
      (doseq [[backend run] parity/runners]
        (is (= expected (render/output (run bundled))) (str backend))))
    (testing "published PHP source and linked JS on each admitted VM"
      (let [donor (h/publish-guest-module! (source-module module php-packet))
            source (h/source {'yang.call (:call-address @h/published),
                              'js (:address @h/published),
                              'php (:address @published-php),
                              module (:address donor)})
            ast (u/mark-tails
                  (u/seq-nodes
                    [(core-module/require-node module)
                     (u/sexp->uast '(php/init!))
                     (u/app (u/v 'php/run-main) (u/v (symbol (str module) "body")))
                     (core-module/require-node 'yang.call)
                     (core-module/require-node 'js)
                     (u/sexp->uast '(js/init!))
                     project
                     (lower/lower-packet ts-packet {:prelude :linked})]))]
        (is (some? (:address donor)))
        (doseq [backend (keys h/backends)]
          (is (= :ok (get-in donor [:links (case backend
                                             :semantic :yin.semantic/code
                                             :stack :yin.debruijn.code
                                             :register :yin.debruijn.register)
                                    :status]))
              (str backend " source publication"))
          (is (= expected
                 (render/output
                   (vm/value (h/run-linked backend ast {:link-source source}))))
              (str backend)))))))


(deftest ^:slow source-calls-php-function-test
  (slow/guard "source-calls-php-function-test" #(check-source fixtures/direct)))


(deftest ^:slow source-foreign-store-and-callback-test
  (slow/guard "source-foreign-store-and-callback-test" #(check-source fixtures/callback)))
