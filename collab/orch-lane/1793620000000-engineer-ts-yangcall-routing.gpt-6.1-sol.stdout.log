%) (concat hoisted (remove #(hoisted? ctx %) items))))))\n\n\n(defn lower-module-body\n  \"The unit's statements as one node, before the runtime wrapper: what\n   lowering goldens compare. Hoisted function declarations come first.\"\n  [packet]\n  (unit-body (context packet)))\n\n\n(defn lower-program\n  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n   `php/run-main` after the bundled prelude, tail calls marked. Its value is\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n   `:warnings` are the lowering's warning-severity diagnostics\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`).\"\n  ([packet] (lower-program packet {}))\n  ([packet {:keys [prelude], :or {prelude :bundled}}]\n   (when-not (= :bundled prelude)\n     (throw (ex-info \"the linked PHP profile is not available yet\"\n                     {:yang.php/diagnostic :yang.php/unsupported,\n                      :construct :linked-prelude})))\n   (let [ctx (context packet)\n         body (unit-body ctx)]\n     {:ast (u/mark-tails (u/then prelude/uast (app* 'php/run-main (u/lam [] body)))),\n      :warnings @(:warnings ctx)})))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The lowering stage\n;; =============================================================================\n\n(def program-medium\n  \"The program medium's logical identity when the composition names none.\"\n  :yang.php/program)\n\n\n(defn- stage-config\n  \"The shared stage config; `warned` receives the packet's warnings.\"\n  [warned]\n  {:diagnostic-ns diagnostic-ns,\n   :program-medium program-medium,\n   :ok? #(= :yang.cst/ok (:yang.cst/outcome %)),\n   :lower (fn [state packet]\n            (let [{:keys [ast warnings]}\n                  (lower-program packet {:prelude (get state :prelude :bundled)})]\n              (reset! warned warnings)\n              ast)),\n   :option-keys [:prelude]})\n\n\n(defn lower-transform\n  \"The lowering stage's transform (`yang.core.stage/lower-transform`):\n   an ok packet is one program batch, then one record on port `:diagnostics`\n(ns yang.php.antlr.portable-harness\n  \"What the JVM, Node and Dart lanes share: the host composition the PHP\n   profile runs over, the `packet` helper that builds a CST packet from a\n   nested form, and a parserless run of a packet on the AST walker.\"\n  (:require\n    [dao.stream :as stream]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.integer :as integer]\n    [yin.vm.module :as module]\n    [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The `integer` limits the PHP compositions here install.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(def data-limits {::data/max-items 1048576})\n\n\n(defn host-registry\n  \"The registry with the cell, data and integer modules installed, admitted\n   by the PHP profile.\"\n  []\n  (-> (module/empty-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      prelude/admit))\n\n\n(defn packet\n  \"A CST packet from a nested form: `[rule child ...]` for a rule (a keyword)\n   and `[type text]` (type a string) for a token. Spans are zero-width: the\n   lowering reads them only for diagnostics. Ids are preorder, as the parser\n   numbers them, so generated names match a parsed packet's.\"\n  [form]\n  (let [out (volatile! [])]\n    (letfn [(walk\n              [f]\n              (let [id (count @out)]\n                (if (string? (first f))\n                  (vswap! out conj {:id id, :kind :token, :type (first f),\n                                    :text (second f), :span [0 0]})\n                  (do (vswap! out conj nil)\n                      (let [kids (mapv walk (rest f))]\n                        (vswap! out assoc id {:id id, :kind :rule,\n                                              :rule (name (first f)),\n                                              :children kids, :span [0 0]}))))\n                id))]\n      (walk form))\n    {:yang.cst/version 1,\n     :yang.cst/unit [:hand 0],\n     :yang.cst/grammar \"hand\",\n     :yang.cst/outcome :yang.cst/ok,\n     :yang.cst/root 0,\n     :yang.cst/nodes @out,\n     :yang.cst/complete true}))\n\n\n(defn render\n  \"The text a unit prints (ASCII here: the carrier is the text), then, for an\n   uncaught error, the fatal line (no path).\"\n  [{:php/keys [out uncaught]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(defn lower-through-stage\n  \"`{:ast a :warnings w}` or `{:diagnostics d}` for `pk` through the lowering\n   stage. Warning-severity diagnostics do not stop the program.\"\n  [pk]\n  (let [cst-log (tu/new-memory-log)\n        program (tu/new-memory-log)\n        diagnostics (tu/new-memory-log)]\n    (stream/append! cst-log pk)\n    (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                        {:medium lower/program-medium}))\n    (let [{warnings true, problems false}\n          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n      (if (seq problems)\n        {:diagnostics problems}\n        (let [{:yin/keys [batch root]} (first (tu/drain program))]\n          {:ast (nth batch root), :warnings (vec warnings)})))))\n\n\n(defn run-packet-raw\n  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, of packet `pk` on\n   the AST walker, or `{:diagnostics d}`.\"\n  [pk]\n  (let [{:keys [ast diagnostics]} (lower-through-stage pk)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (vm/value (vm/eval (tu/create-vm {:modules (host-registry)}) ast)))))\n\n\n(defn run-packet\n  \"The rendered output of packet `pk` on the AST walker, or its diagnostics.\"\n  [pk]\n  (let [r (run-packet-raw pk)]\n    (if (:diagnostics r) r (render r))))\n(ns yang.php.antlr.e2e-harness\n  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n   program envelope -> the bundled program on each of the four VMs. Output\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n   here at the boundary.\"\n  (:require\n    [dao.host.text :as text]\n    [dao.stream :as stream]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn host-registry\n  \"The registry the PHP compositions run over.\"\n  []\n  (portable/host-registry))\n\n\n(def ^:private base-opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\"\n  [source]\n  (let [cst-log (tu/new-memory-log)\n        program (tu/new-memory-log)\n        diagnostics (tu/new-memory-log)]\n    (stream/append! cst-log (cst/parse-source source))\n    (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                        {:medium lower/program-medium}))\n    (let [{warnings true, problems false}\n          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n      (if (seq problems)\n        {:diagnostics problems}\n        (let [{:yin/keys [batch root]} (first (tu/drain program))]\n          {:ast (nth batch root), :warnings (vec warnings)})))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`.\"\n  [registry ast]\n  (let [opts (assoc base-opts :modules registry)\n        session (tu/make-observer-session (tu/create-vm {:modules registry}))\n        datoms (vec (vm/ast->datoms ast))\n        projected #(:vector (sr-linearize/project ast))\n        attempt (fn [f]\n                  (try (render (f))\n                       (catch Exception e [:thrown (ex-message e)])))]\n    (tu/queue-ast! session ast)\n    {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n     :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n                                                          datoms)))),\n     :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                          (:image (derive/stack-image (projected)))\n                                        