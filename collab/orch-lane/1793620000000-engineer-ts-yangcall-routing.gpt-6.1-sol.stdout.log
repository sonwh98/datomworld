escript/antlr/lower.cljc\n+++ b/src/cljc/yang/typescript/antlr/lower.cljc\n@@ -2275,6 +2275,18 @@\n     (u/lam [(:this ctx)] (module-body ctx))))\n \n \n+(defn- with-runtime\n+  \"Both source entry points install the shared convention before JS.\"\n+  [prelude main]\n+  (u/mark-tails\n+    (case prelude\n+      :bundled (u/then prelude/uast main)\n+      :linked (u/seq-nodes [(app* 'require (u/lit 'yang.call))\n+                            (app* 'require (u/lit prelude/module-name))\n+                            (app* 'js/init!)\n+                            main]))))\n+\n+\n (defn lower-units\n   \"A complete program for multiple separately parsed units. The runtime is\n    installed and initialized once; each unit receives its own lexical body\n@@ -2289,15 +2301,7 @@\n                                (u/seq-nodes\n                                  (mapv (fn [unit] (u/app unit (u/v 'this))) units))\n                                (u/lit :js/undefined)))))]\n-     (u/mark-tails\n-       (case prelude\n-         :bundled (u/then prelude/uast main)\n-         :linked (u/seq-nodes [(u/sexp->uast (list 'require\n-                                                   (list 'quote 'yang.call)))\n-                               (u/sexp->uast (list 'require\n-                                                   (list 'quote prelude/module-name)))\n-                               (app* 'js/init!)\n-                               main]))))))\n+     (with-runtime prelude main))))\n \n \n (defn lower-packet\n@@ -2312,17 +2316,7 @@\n   ([packet] (lower-packet packet {}))\n   ([packet {:keys [prelude], :or {prelude :bundled}}]\n    (let [main (names/canonicalize (app* 'js/run-main (lower-unit packet)))]\n-     (u/mark-tails\n-       (case prelude\n-         :bundled (u/then prelude/uast main)\n-         :linked (u/seq-nodes [(u/sexp->uast (list 'require\n-                                                   (list 'quote\n-                                                         'yang.call)))\n-                               (u/sexp->uast (list 'require\n-                                                   (list 'quote\n-                                                         prelude/module-name)))\n-                               (app* 'js/init!)\n-                               main]))))))\n+     (with-runtime prelude main))))\n \n \n (def program-medium\ndiff --git a/src/cljc/yang/typescript/antlr/prelude.cljc b/src/cljc/yang/typescript/antlr/prelude.cljc\nindex 49822c33..ef978488 100644\n--- a/src/cljc/yang/typescript/antlr/prelude.cljc\n+++ b/src/cljc/yang/typescript/antlr/prelude.cljc\n@@ -37,8 +37,10 @@\n \n    Calling convention: source calls are (js/call f this args), with `args`\n    a vector built by `js/vconj`; `js/call` supplies one invocation record\n-   to the shared entry. Constructors retain (js/construct F args), and a\n-   function's private code is (fn [this args] ..).\n+   to the shared entry after structural eligibility. Foreign entries use\n+   the same path; JS entries retain local receiver, class and new.target\n+   semantics. Constructors retain (js/construct F args), and a function's\n+   private code is (fn [this args] ..).\n \n    Control flow is continuations: `js/throw`, `js/try`, `js/try-finally`\n    and `js/call-ec` copy the Python prelude's escape machinery with JS\n@@ -1616,10 +1618,12 @@\n        (yang.call/invoke-with\n          f args []\n          (fn [condition]\n-           (js/throw-type-error\n-             (if (= (get condition :yang.call/reason) :yang.call/not-callable)\n-               {:js/str \"value is not a function\"}\n-               {:js/str \"invalid function invocation\"})))\n+           (if (= (get condition :yang.call/reason) :yang.call/thrown)\n+             (js/throw (get condition :yang.call/value))\n+             (js/throw-type-error\n+               (if (= (get condition :yang.call/reason) :yang.call/not-callable)\n+                 {:js/str \"value is not a function\"}\n+                 {:js/str \"invalid function invocation\"}))))\n          (assoc {} :yang.call/receiver this)))]\n     [js/is-constructor?\n      ;; [[Construct]] exists on :normal functions, class constructors and the\n(ns yang.typescript.antlr.source-call-test\n  \"S11: real source calls through the shared convention (§8.10.11).\n   The composition publishes the separately lowered PHP body, runs it, and\n   projects its resolved functions into the JS global namespace. Neither\n   frontend's call nodes or function bodies are rewritten.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.module :as core-module]\n    [yang.core.uast :as u]\n    [yang.php.antlr.cst :as php-cst]\n    [yang.php.antlr.lower :as php-lower]\n    [yang.php.antlr.prelude :as php-prelude]\n    [yang.typescript.antlr.cst :as cst]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]))\n\n\n(def ^:private published-php\n  (delay (h/publish-guest-module! (php-prelude/module-spec (h/registry)))))\n\n\n(defn- source-module\n  \"An ordinary module exporting the unmodified lowered source body.\"\n  [name packet]\n  (core-module/module-spec\n    :yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free\n    (h/registry)\n    {:name name,\n     :ast (core-module/module-tree\n            [(core-module/require-node 'php)\n             (u/def! 'body (u/lam [] (php-lower/lower-module-body packet)))]),\n     :exports '#{body},\n     :runtime-name 'php,\n     :runtime-address (:address @published-php)}))\n\n\n(defn- projection\n  \"Namespace composition only: preserve each resolved function cell.\"\n  [names]\n  (u/sexp->uast\n    (cons 'do\n          (map (fn [name]\n                 (list 'js/define-own!\n                       'js.rt/global {:js/str name}\n                       (list 'js/slot (list 'php/resolve-fn name name)\n                             true true true)))\n               names))))\n\n\n(defn- check-source\n  [name php-source names ts-source expected]\n  (let [expected {:js/out (str/split-lines expected), :js/uncaught nil}\n        php-packet (php-cst/parse-source php-source)\n        ts-packet (cst/parse-source ts-source)\n        project (projection names)\n        bundled (u/mark-tails\n                  (u/seq-nodes [(php-lower/lower-packet php-packet)\n                                prelude/uast project\n                                (u/app (u/v 'js/run-main) (lower/lower-unit ts-packet))]))]\n    (testing \"bundled source on every VM\"\n      (doseq [[backend run] parity/runners]\n        (is (= expected (render/output (run bundled))) (str backend))))\n    (testing \"published PHP source and linked JS on each admitted VM\"\n      (let [donor (h/publish-guest-module! (source-module name php-packet))\n            source (h/source {'yang.call (:call-address @h/published),\n                              'js (:address @h/published),\n                              'php (:address @published-php),\n                              name (:address donor)})\n            ast (u/mark-tails\n                  (u/seq-nodes\n                    [(core-module/require-node name)\n                     (u/sexp->uast '(php/init!))\n                     (u/app (u/v 'php/run-main) (u/v (symbol (str name) \"body\")))\n                     (core-module/require-node 'yang.call)\n                     (core-module/require-node 'js)\n                     (u/sexp->uast '(js/init!))\n                     project\n                     (lower/lower-packet ts-packet {:prelude :linked})]))]\n        (is (some? (:address donor)))\n        (doseq [backend (keys h/backends)]\n          (is (= :ok (get-in donor [:links (case backend\n                                             :semantic :yin.semantic/code\n     