                                        :extensible? true)\n                                 :kind\n                                 kind)\n                          :nt?\n                          nt?))]\n           (do (js/define-own! f\n                               {:js/str \"length\"}\n                               (js/slot (data/float64 length) false false true))\n               (js/define-own! f {:js/str \"name\"} (js/slot name false false true))\n               (if (= kind :normal)\n                 (let [p (js/make-object js.rt/obj-proto)]\n                   (do (js/define-own! f\n                                       {:js/str \"prototype\"}\n                                       (js/slot p true false false))\n                       (js/define-own! p\n                                       {:js/str \"constructor\"}\n                                       (js/slot f true false true))))\n                 :js/undefined)\n               f))))]\n    [js/call\n     (fn [f this args]\n       (yang.call/invoke-with\n         f args []\n         (fn [condition]\n           (js/throw-type-error\n             (if (= (get condition :yang.call/reason) :yang.call/not-callable)\n               {:js/str \"value is not a function\"}\n               {:js/str \"invalid function invocation\"})))\n         (assoc {} :yang.call/receiver this)))]\n    [js/is-constructor?\n     ;; [[Construct]] exists on :normal functions, class constructors and the\n     ;; builtins flagged :ctor?; arrows, methods, accessors and the rest have\n     ;; none\n     (fn [v]\n       (if (js/callable? v)\n         (let [c (cell/get v)\n               k (get c :kind)]\n           (if (= k :normal)\n             true\n             (if (= k :class)\n               true\n               (if (= k :derived)\n                 true\n                 (if (= k :builtin) (= (get c :ctor?) true) false)))))\n         false))]\n    [js/construct-with-nt\n     ;; [[Construct]](args, nt): a derived constructor allocates nothing (its\n     ;; `this` is bound by super()); every other kind allocates from\n     ;; nt.prototype. A bound function constructs its target, passing the\n     ;; target as new.target when nt is the bound function itself.\n     (fn [f args nt]\n  [packet]\n  (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n        analysis (scope/analyze pk)]\n    {:pk pk,\n     :analysis analysis,\n     :scope (:module analysis),\n     :this (gen \"this\" (p/root pk)),\n     :ret nil,\n     :loop nil,\n     :labels {},\n     :pending-labels nil,\n     :gen nil,\n     :async nil,\n     :class nil,\n     :this-cell nil,\n     :nt :undefined,\n     :home nil,\n     :class-cell nil,\n     :privates {}}))\n\n\n(defn- module-body\n  [ctx]\n  (let [root (p/root (:pk ctx))\n        s (scope-of ctx root)\n        stmts (statements-of ctx root)]\n    (bind-cells (let [{:keys [vars tdz-names]} (binding-names s)]\n                  (vec (concat (map (fn [nm] [nm undefined]) vars)\n                               (map (fn [nm] [nm tdz]) tdz-names))))\n                (seq-of (lower-stmts ctx stmts)))))\n\n\n(defn lower-module-body\n  \"The module's statements as one node, before the runtime wrapper: what\n   lowering goldens compare.\"\n  [packet]\n  (module-body (context packet)))\n\n\n(defn lower-unit\n  \"One separately scoped module body as a function of its shared global\n   receiver. Keeping this seam lets a host compose independently parsed\n   units without concatenating source or reinitializing the runtime.\"\n  [packet]\n  (let [ctx (context packet)]\n    (u/lam [(:this ctx)] (module-body ctx))))\n\n\n(defn lower-units\n  \"A complete program for multiple separately parsed units. The runtime is\n   installed and initialized once; each unit receives its own lexical body\n   while sharing the same global object and output stream.\"\n  ([packets] (lower-units packets {}))\n  ([packets {:keys [prelude], :or {prelude :bundled}}]\n   (let [units (mapv lower-unit packets)\n         main (names/canonicalize\n                (app* 'js/run-main\n                      (u/lam ['this]\n                             (if (seq units)\n                               (u/seq-nodes\n                                 (mapv (fn [unit] (u/app unit (u/v 'this))) units))\n                               (u/lit :js/undefined)))))]\n     (u/mark-tails\n       (case prelude\n         :bundled (u/then prelude/uast main)\n         :linked (u/seq-nodes [(u/sexp->uast (list 'require\n                                                   (list 'quote 'yang.call)))\n                               (u/sexp->uast (list 'require\n                                                   (list 'quote prelude/module-name)))\n                               (app* 'js/init!)\n                               main]))))))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet: the module body run by\n   `js/run-main`, generated names canonicalized, tail calls marked. Its\n   value is `{:js/out [...] :js/uncaught nil-or-snapshot}`.\n\n   `:prelude` selects how the runtime profile arrives: `:bundled` (the\n   default) carries the prelude tree ahead of the body; `:linked` requires\n   the modules `yang.call` and `js` from the task's link pair, then allocates\n   the task's runtime state with `(js/init!)`.\"\n  ([packet] (lower-packet packet {}))\n  ([packet {:keys [prelude], :or {prelude :bundled}}]\n   (let [main (names/canonicalize (app* 'js/run-main (lower-unit packet)))]\n     (u/mark-tails\n       (case prelude\n         :bundled (u/then prelude/uast main)\n         :linked (u/seq-nodes [(u/sexp->uast (list 'require\n                                                   (list 'quote\n                                                         'yang.call)))\n                               (u/sexp->uast (list 'require\n                                                   (list 'quote\n                                                         prelude/module-name)))\n                               (app* 'js/init!)\n                               main]))))))\n\n\n(def program-medium\n  \"The program medium's logical identity when the composition names none.\"\n  :yang.ts/program)\n\n\n(def ^:private stage-config\n  {:diagnostic-ns diagnostic-ns,\n   :program-medium program-medium,\n   :ok? #(= :yang.cst/ok (:yang.cst/outcome %)),\n   :lower (fn [state packet]\n            (lower-packet packet {:prelude (get state :prelude :bundled)})),\n   :option-keys [:prelude :dialect]})\n\n\n(defn lower-transform\n  \"The lowering stage's transform (`yang.core.stage/lower-transform`).\"\n  [state packet]\n  (core-stage/lower-transform stage-config state packet))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. The fourth argument may instead be\n   an options map `{:medium :prelude :dialect}`.\"\n  ([cst-stream program-stream diagnostics-stream]\n   (core-stage/open-stage stage-config\n                          cst-stream\n                           kwargs\n                           0)\n                   slots (py/fill-defaults fc (get state 0) (get fc :defaults) n 0)\n                   ko (py/fill-kwdefaults fc (get state 1) (get spec :kwonly) 0)\n                   with-star (if star\n                               (py/vconj slots\n                                         (py/tuple (if (< n given) (data/subvec args n) [])))\n                               slots)\n                   with-ko (data/into with-star ko)]\n               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\n    [py/call (fn [f args] (py/call-kw f args []))]\n    [py/call-kw\n     (fn [f args kwargs]\n       (if (= (get f :py/type) :method)\n         (py/call-kw (get f :fn) (data/into (py/vconj [] (get f :self)) args) kwargs)\n         (let [t (py/content-type f)]\n           (if (= t :function)\n             (let [fc (cell/get f)] ((get fc :code) (py/bind-args fc args kwargs)))\n             (if (= t :class)\n               (py/instantiate f args kwargs)\n               (py/type-error {:py/str \"object is not callable\"}))))))]\n    [py/instantiate\n     (fn [cls args kwargs]\n       (let [inst (py/make-instance cls)\n             init (py/class-lookup cls \"__init__\")]\n         ;; without __init__ only exception classes take arguments (they\n         ;; become `args`); any other class takes none\n         (do (if (= init :py/missing)\n               (if (py/subclass? cls py.b/BaseException)\n                 ;; the builtin exception constructor takes positional\n                 ;; arguments only; an explicit __init__ binds keywords\n                 (if (< 0 (data/count kwargs))\n                   (py/type-error\n                     (py/str (data/str-concat (get (cell/get cls) :name)\n                                              \"() takes no keyword arguments\")))\n                   (py/setattr inst \"args\" (py/tuple args)))\n                 (if (if (< 0 (data/count args)) true (< 0 (data/count kwargs)))\n                   (py/type-error\n                     (py/str (data/str-concat (get (cell/get cls) :name)\n                                              \"() takes no arguments\")))\n                   :py/None))\n               (py/call-kw init (data/into (py/vconj [] inst) args) kwargs))\n             inst)))]\n    [py/extend\n     ;; call-site *iterable and display *iterable\n     (fn [acc it] (data/into acc (py/to-vector it)))]\n    [py/kw-extend\n     ;; call-site **mapping: its string keys become keyword pairs\n     (fn [acc d]\n       (if (= (py/content-type d) :dict)\n         (py/kw-pairs acc (get (cell/get d) :keys) (get (cell/get d) :vals) 0)\n         (py/type-error {:py/str \"argument after ** must be a mapping\"})))]\n    [py/kw-pairs\n     (fn [acc ks vs i]\n       (let [k (get ks i :py/stop)]\n         (if (= k :py/stop)\n           acc\n           (if (py/str? k)\n             (py/kw-pairs (conj acc (conj (conj [] (get k :py/str)) (get vs i))) ks vs\n                          (+ i 1))\n             (py/type-error {:py/str \"keywords must be strings\"})))))]\n\n    ;; ---------------------------------------------------------- attributes\n    [py/class-lookup\n     (fn [cls name]\n       (if (= cls :py/None)\n                               slots)\n                   with-ko (data/into with-star ko)]\n               (if (get spec :kwstar?) (py/vconj with-ko (get state 2)) with-ko))))))]\n    [py/call (fn [f args] (py/call-kw f args []))]\n    [py/call-kw\n     (fn [f args kwargs]\n       (if (= (get f :py/type) :method)\n         (py/call-kw (get f :fn) (data/into (py/vconj [] (get f :self)) args) kwargs)\n         (if (= (py/content-type f) :class)\n           (py/instantiate f args kwargs)\n           (if (yang.call/eligible? f)\n             (yang.call/invoke\n               f args kwargs\n               (fn [condition]\n                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\n                   (py/raise (get condition :yang.call/value))\n                   (py/type-error {:py/str \"object is not callable\"}))))\n             (if (= (py/content-type f) :function)\n               (let [fc (cell/get f)]\n                 ((get fc :code) (py/bind-args fc args kwargs)))\n               (py/type-error {:py/str \"object is not callable\"}))))))]\n    [py/instantiate\n     (fn [cls args kwargs]\n       (let [inst (py/make-instance cls)\n             init (py/class-lookup cls \"__init__\")]\n         ;; without __init__ only exception classes take arguments (they\n         ;; become `args`); any other class takes none\n         (do (if (= init :py/missing)\n               (if (py/subclass? cls py.b/BaseException)\n                 ;; the builtin exception constructor takes positional\n                 ;; arguments only; an explicit __init__ binds keywords\n                 (if (< 0 (data/count kwargs))\n                   (py/type-error\n                     (py/str (data/str-concat (get (cell/get cls) :name)\n                                              \"() takes no keyword arguments\")))\n                   (py/setattr inst \"args\" (py/tuple args)))\n                 (if (if (< 0 (data/count args)) true (< 0 (data/count kwargs)))\n                   (py/type-error\n                     (py/str (data/str-concat (get (cell/get cls) :name)\n                                              \"() takes no arguments\")))\n                   :py/None))\n               (py/call-kw init (data/into (py/vconj [] inst) args) kwargs))\n             inst)))]\n    [py/extend\n     ;; call-site *iterable and display *iterable\n     (fn [acc it] (data/into acc (py/to-vector it)))]\n    [py/kw-extend\n     ;; call-site **mapping: its string keys become keyword pairs\n     (fn [acc d]\n       (if (= (py/content-type d) :dict)\n         (py/kw-pairs acc (get (cell/get d) :keys) (get (cell/get d) :vals) 0)\n         (py/type-error {:py/str \"argument after ** must be a mapping\"})))]\n    [py/kw-pairs\n     (fn [acc ks vs i]\n       (let [k (get ks i :py/stop)]\n         (if (= k :py/stop)\n           acc\n           (if (py/str? k)\n             (py/kw-pairs (conj acc (conj (conj [] (get k :py/str)) (get vs i))) ks vs\n                          (+ i 1))\n             (py/type-error {:py/str \"keywords must be strings\"})))))]\n\n    ;; ---------------------------------------------------------- attributes\n    [py/class-lookup\n     (fn [cls name]\n       (if (= cls :py/None)\n         :py/missing\n         (let [c (cell/get cls)\n               found (get (get c :attrs) name :py/missing)]\n           (if (= found :py/missing)\n             (py/class-lookup (get c :base) name)\n        internal-names (into {} (map (fn [nm] [(module-symbol nm) nm])) (keys keys-for))\n        internal (set (keys internal-names))\n        rewrite (fn [node]\n                  (cond\n                    (and (= :variable (:type node))\n                         (symbol? (:name node))\n                         (some? (namespace (:name node)))\n                         (contains? internal (symbol (namespace (:name node))))\n                         (= \"spec\" (name (:name node))))\n                    (let [nm (get internal-names (symbol (namespace (:name node))))\n                          u (get units-by-name nm)]\n                      (u/lit {:name nm, :package? (boolean (:package? u))}))\n                    (and (= :variable (:type node))\n                         (symbol? (:name node))\n                         (some? (namespace (:name node)))\n                         (contains? internal (symbol (namespace (:name node))))\n                         (= \"body\" (name (:name node))))\n                    (let [nm (get internal-names (symbol (namespace (:name node))))\n                          [_ body-key] (get keys-for nm)]\n                      (u/v body-key))\n                    (and (= :application (:type node))\n                         (= 'try-require (get-in node [:operator :name]))\n                         (contains? internal (get-in node [:operands 0 :value])))\n                    (u/lit {:status :ok})\n                    (and (= :application (:type node))\n                         (= 'py/import-from (get-in node [:operator :name])))\n                    (apply cyclic-import-from (:operands node))\n                    :else node))\n        wrapped-bodies\n        (mapv (fn [{:keys [name packet package?]}]\n                (let [unit {:name name, :package? (boolean package?)}\n                      body (walk/postwalk rewrite (lower-module-body packet unit))\n                      flag (fn [v]\n                             (app* 'cell/set! (u/v '%module)\n                                   (app* 'assoc (app* 'cell/get (u/v '%module))\n                                         (u/lit initializing-key) (u/lit v))))]\n                  (u/lam [globals-sym globals-fn-sym]\n                         (u/let1 '%module (app* 'py/modules-ref (u/lit {:py/str name}))\n                                 (u/then (flag true)\n                                         (app* 'py/try-finally (u/lam [] body)\n                                               (u/lam [u/discard] (flag false))))))))\n              units)\n        spec-defs\n        (mapcat (fn [{:keys [name package?]}]\n                  (let [[spec-key _] (get keys-for name)\n                        unit {:name name, :package? (boolean package?)}]\n                    [(u/def! spec-key (u/lit unit))]))\n                units)\n        body-defs\n        (map (fn [{:keys [name]} body]\n               (let [[_ body-key] (get keys-for name)]\n                 (u/def! body-key body)))\n             units wrapped-bodies)\n        ;; The linker discharges body reads only when their definitions\n        ;; precede every module-level application site. Install the pure\n        ;; sibling bindings before require; defining the lambdas runs no py.\n        needs-call? (some calls-yang-call? wrapped-bodies)\n        ast (module-tree (concat spec-defs\n                                 body-defs\n                                 (when needs-call? [(require-node 'yang.call)])\n                                 [(require-node prelude/module-name)]))\n        exports (set (mapcat val keys-for))\n        bundle (core-module/module-spec\n                 :yang.python.antlr/refusal :yang.python.antlr/undeclared-free\n                 registry\n                 {:name bundle-name,\n                  :ast ast,\n                  :exports exports,\n                  :runtime-name prelude/module-name,\n                  :runtime-address py-address,\n                  :deps (cond-> (into {} (map (fn [[n a]] [(module-symbol n) a])) deps)\n                          needs-call? (assoc 'yang.call call-address))})\n        require-profile (vm/profile-of vm/primitives 'require)]\n    (core-module/scc-module-specs\n      bundle\n      (mapv (fn [{:keys [name]}]\n              (let [[sk bk] (get keys-for name)]\n                (core-module/alias-spec (module-symbol name) module-exports\n                                        require-profile bundle-name sk bk)))\n            units))))\n\n\n(defn scc-module-specs\n  \"Canonical I5 construction: sorted members, indexed bare exports\n   m0-spec/m0-body, etc.; one pyscc.<mangled-members> bundle followed by\n   aliases in member order. Internal deliveries read those exports without\n   requiring aliases. Only py and outgoing imports are pinned by the bundle.\n   Alias :requires is filled with the bundle address after publication.\"\n  ([registry units py-address deps]\n   (scc-module-specs* registry units py-address nil deps))\n  ([registry units py-address call-address deps]\n   (scc-module-specs* registry units py-address call-address deps)))\n\n\n;; =============================================================================\n;; The lowering stage\n;; =============================================================================\n\n(def program-medium\n  \"The program medium's logical identity when the composition names none.\"\n  :yang.python.antlr/program)\n\n\n(def ^:private stage-config\n  {:diagnostic-ns diagnostic-ns,\n   :program-medium program-medium,\n   :ok? #(= :yang.cst/ok (:yang.cst/outcome %)),\n   :lower (fn [state packet]\n            (lower-packet (if (and (contains? state :max-digits)\n                                   (not (contains? packet\n                                                   :yang.python.antlr/max-digits)))\n                            (assoc packet\n                                   :yang.python.antlr/max-digits (:max-digits state))\n                            packet)\n                          {:prelude (get state :prelude :bundled)})),\n   :option-keys [:max-digits :prelude]})\n\n\n(defn lower-transform\n  \"The lowering stage's transform (`yang.core.stage/lower-transform`). The\n   state's `:max-digits`, when the composition declares one, is the digit\n   budget of a packet that declares none; its `:prelude` (`:bundled` by\n   default, or `:linked`) is `lower-packet`'s. Stateless.\"\n  [state packet]\n  (core-stage/lower-transform\n    stage-config\n    state\n    packet))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. `max-digits`, when given, is the\n   decimal digit budget of every packet that declares none. The fourth\n   argument may instead be an options map `{:medium :max-digits\n   :prelude}`; `:prelude` is `lower-packet`'s, `:bundled` by default.\"\n  ([cst-stream program-stream diagnostics-stream]\n   (core-stage/open-stage stage-config\n                          cst-stream\n                          program-stream\n                          diagnostics-stream))\n  ([cst-stream program-stream diagnostics-stream medium-or-opts]\n   (core-stage/open-stage stage-config\n                          cst-stream\n                          program-stream\n                          diagnostics-stream\n                          medium-or-opts))\n  ([cst-stream program-stream diagnostics-stream medium max-digits]\n   (core-stage/open-stage stage-config\n                          cst-stream\n                          program-stream\n                          diagnostics-stream\n                          medium\n                          max-digits)))\n\n\n(defn step-stage\n  [s]\n  (core-stage/step-stage stage-config s))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/typescript/antlr/linked_harness.cljc; cat test/yang/typescript/antlr/linked_prelude_test.cljc; cat test/yang/typescript/antlr/prelude_module_test.cljc; cat test/yang/python/antlr/call_entry_test.cljc; sed -n '3514,3735p' docs/design/yang.antlr.md; sed -n '4010,4075p' docs/design/yang.antlr.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/typescript/antlr/linked_harness.cljc; cat test/yang/typescript/antlr/linked_prelude_test.cljc; cat test/yang/typescript/antlr/prelude_module_test.cljc; cat test/yang/python/antlr/call_entry_test.cljc; sed -n '3514,3735p' docs/design/yang.antlr.md; sed -n '4010,4075p' docs/design/yang.antlr.md\"","aggregated_output":"(ns yang.typescript.antlr.linked-harness\n  \"The linked profile's composition for the JavaScript tests (T1 step S5,\n   docs/design/yang.typescript.md section 13): the namespace that requires\n   this is the publisher of `js` and `jssp`, so it publishes each module\n   once per process into one in-memory content store and serves them to\n   every linked run over a `yin.vm.linker.interpreter` composition under\n   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n   evidence is `publish-module!`'s own `link-local` links, which\n   `linked-prelude-test` asserts.\n\n   A linked run builds the program's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately\n   until the VM stops blocking, as the REPL's drive does. The AST walker\n   is not a backend here: its link of `js` is refused `:undeclared-free`\n   until L-b.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [dao.jing.mem :as mem]\n            [yang.core.call :as call]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yang.typescript.antlr.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The ordinary JavaScript composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked JavaScript composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `jssp` polls a signal stream, so the\n   safepointed composition needs it even though `js` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`js` published once into its own content store:\n   `{:store s :result r :address a :call-address ca}`. `yang.call` is\n   published first so `js` pins its shared calling runtime.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store,\n       :result result,\n       :address (:address result),\n       :call-address (:address call-result)})))\n\n\n(def published-jssp\n  \"`jssp` published once into `js`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test\n   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n  ([] (source {'js (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition over the published modules: `jssp` requires\n   `js`, and `js` requires `yang.call`.\"\n  []\n  (source {'js (:address @published),\n           'jssp (:address @published-jssp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n                 (assoc attached\n                        :pc pc :frames [] :continuation []\n                        :registers (vec (repeat (:registers body) nil))\n                        :halted? false :blocked? false :value nil)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task\n   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`. Options:\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `js`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `jssp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\n(ns yang.typescript.antlr.linked-prelude-test\n  \"T1 step S5: the JavaScript runtime profile and its hook prelude as the\n   linker modules `js` and `jssp`. Both emit from the single definition\n   lists their bundled twins load; the specs declare every free name of\n   their trees; a linked run on the three vector VMs prints what the\n   bundled run prints; the AST walker's link stays refused until L-b. The\n   published modules and the linked runs are\n   `yang.typescript.antlr.linked-harness`'s: one publication per process,\n   served `:trusted`, so every test that publishes or links is slow.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.stream :as stream]\n    [dao.test-slow :as slow]\n    [yang.safepoint :as safepoint]\n    [yang.core.uast :as u]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.lower-portable-test :as portable]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yang.typescript.antlr.safepoint :as hooks]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.encoder :as encoder]\n    [yin.vm.engine :as engine]\n    [yin.vm.module :as module]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn- refusal-of\n  \"The ex-data of what `thunk` throws, or nil when it returns.\"\n  [thunk]\n  (try (thunk)\n       nil\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         (or (ex-data e) {}))))\n\n\n(defn- def-key\n  \"The literal key of a `(yin/def k v)` application node, else nil.\"\n  [node]\n  (when (and (map? node)\n             (= :application (:type node))\n             (= 'yin/def (get-in node [:operator :name])))\n    (get-in node [:operands 0 :value])))\n\n\n;; =============================================================================\n;; The module emitters\n;; =============================================================================\n\n(deftest jssp-module-uast-is-one-wide-application-test\n  (let [ast hooks/module-uast\n        operands (:operands ast)\n        definitions (butlast operands)]\n    (is (= :application (:type ast)))\n    (is (= :lambda (:type (:operator ast))))\n    (is (= (count operands) (count (:params (:operator ast)))))\n    (is (nil? (get-in ast [:operator :body :value])))\n    (is (= (u/sexp->uast '(require (quote js)))\n           (dissoc (last operands) :tail?)))\n    (testing \"the placeholders come first, each the literal :js/uninit\"\n      (let [n (count hooks/runtime-keys)\n            placeholders (take n definitions)]\n        (is (= (mapv hooks/strip hooks/runtime-keys)\n               (mapv def-key placeholders)))\n        (is (every? #(= {:type :literal, :value :js/uninit}\n                        (dissoc (get-in % [:operands 1]) :tail?))\n                    placeholders))))\n    (testing \"then every definition, stripped, in definition order\"\n      (is (= (mapv (comp hooks/strip first) hooks/function-definitions)\n             (mapv def-key (drop (count hooks/runtime-keys) definitions)))))\n    (testing \"no symbol of the module's own namespace survives stripping\"\n      (is (not-any? (fn [x] (and (symbol? x) (= \"js.sp\" (namespace x))))\n                    (tree-seq coll? seq ast))))\n    (testing \"`js/*` references stay qualified: the base prelude's exports\"\n      (is (some (fn [x] (and (symbol? x) (= \"js\" (namespace x))))\n                (tree-seq coll? seq ast))))))\n\n\n(deftest jssp-module-exports-test\n  (is (= (set (map (comp hooks/strip first) hooks/function-definitions))\n         hooks/module-exports))\n  (is (every? #(contains? hooks/module-exports %) '[attach! loop call]))\n  (is (not-any? namespace hooks/module-exports))\n  (is (not (contains? hooks/module-exports 'cursor)))\n  (is (empty? (filter #(contains? vm/primitives %) hooks/module-exports))))\n\n\n(deftest js-module-exports-stage0-entry-points-test\n  (testing \"the lowering's literal, for-in and JSON entry points are exported\"\n    (is (every? #(contains? prelude/module-exports %)\n                '[new-object new-array literal-proto! for-in-start for-in-next\n                  install-json! define-accessor-half! json-stringify json-parse]))))\n\n\n(deftest jssp-module-spec-test\n  (let [spec (hooks/module-spec (h/registry) :test/js-address)]\n    (is (= 'jssp (:name spec) hooks/module-name))\n    (is (= hooks/module-uast (:ast spec)))\n    (is (= hooks/module-exports (:exports spec)))\n    (is (= {'js :test/js-address} (:requires spec)))\n    (testing \"a js-qualified free name is covered by the requirement\"\n      (is (empty? (filter #(= \"js\" (namespace %)) (keys (:primitives spec))))))\n    (testing \"the qualified declarations are exactly the host names\"\n      (is (= hooks/host-names\n             (set (filter namespace (keys (:primitives spec)))))))\n    (testing \"a free name no registry module supplies is refused\"\n      (let [no-cell (-> (module/empty-registry)\n                        (data/register-data-module {::data/max-items 1048576})\n                        (prelude/register-integer-module h/integer-limits))\n            refusal (refusal-of #(hooks/module-spec no-cell :test/js-address))]\n        (is (= :yang.typescript.antlr/undeclared-free\n               (:yang.typescript.antlr/refusal refusal)))))))\n\n\n(deftest js-module-spec-declares-every-free-name-test\n  (let [call-address (:call-address @h/published)\n        spec (prelude/module-spec (h/registry) call-address)]\n    (is (= 'js (:name spec)))\n    (is (= prelude/module-exports (:exports spec)))\n    (is (= {'yang.call call-address} (:requires spec)))\n    (testing \"a registry without the data module is refused\"\n      (let [no-data (-> (module/empty-registry)\n                        module/register-cell-module\n                        (prelude/register-integer-module h/integer-limits))\n            refusal (refusal-of #(prelude/module-spec no-data call-address))]\n        (is (= :yang.typescript.antlr/undeclared-free\n               (:yang.typescript.antlr/refusal refusal)))\n        (is (= \"data\" (namespace (:name refusal))))))))\n\n\n;; =============================================================================\n;; Publication\n;; =============================================================================\n\n(defn- publication\n  []\n  (let [{:keys [result address]} @h/published\n        links (:links result)]\n    (testing \"js publishes with no undeclared free name\"\n      (is (some? address))\n      (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n        (is (= :ok (get-in links [f :status])) (str f))))\n    (testing \"the AST walker is refused :undeclared-free on a sibling read\n              until L-b; L-b's landing flips this assertion\"\n      (let [walker (get links :yin.ast/code)]\n        (is (= :refused (:status walker)))\n        (is (= :undeclared-free (:reason walker)))\n        (is (contains? prelude/module-exports (:name walker)))))\n    (testing \"jssp publishes over js\"\n      (let [{:keys [result]} @h/published-jssp]\n        (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n          (is (= :ok (get-in (:links result) [f :status])) (str f)))))))\n\n\n(deftest ^:slow publication-test\n  (slow/guard \"publication-test\" publication))\n\n\n;; =============================================================================\n;; Linked runs equal bundled runs\n;; =============================================================================\n\n(def ^:private programs\n  \"Hand-built packets: name -> packet.\"\n  {:log-literal (portable/program (portable/log-stmt (portable/num-expr \"1\"))),\n   :var-and-log (portable/program\n                  (portable/var-stmt \"var\" \"x\" (portable/num-expr \"7\"))\n                  (portable/log-stmt (portable/name-expr \"x\"))),\n   :let-in-tdz (portable/program\n                 (portable/log-stmt (portable/name-expr \"y\"))\n                 (portable/var-stmt \"let\" \"y\" (portable/num-expr \"1\")))})\n\n\n(defn- bundled\n  [ast]\n  (render/output ((get parity/runners :semantic) ast)))\n\n\n(defn- linked\n  [k ast]\n  (render/output (vm/value (h/run-linked k ast))))\n\n\n(defn- linked-equals-bundled\n  []\n  (doseq [[nm pk] programs\n          :let [expected (bundled (lower/lower-packet pk))\n                ast (lower/lower-packet pk {:prelude :linked})]]\n    (doseq [k (keys h/backends)]\n      (is (= expected (linked k ast)) (str nm \" \" k)))))\n\n\n(deftest ^:slow linked-equals-bundled-test\n  (slow/guard \"linked-equals-bundled-test\" linked-equals-bundled))\n\n\n;; =============================================================================\n;; The hook prelude linked: signals through the module boundary\n;; =============================================================================\n\n(def ^:private while-loop\n  \"`while (cond) { }` over singleExpression form `cond`.\"\n  (fn [cond-form]\n    [:iterationStatement\n     [\"While\" \"while\"] [\"OpenParen\" \"(\"]\n     [:expressionSequence cond-form]\n     [\"CloseParen\" \")\"]\n     [:statement [:block [\"OpenBrace\" \"{\"] [\"CloseBrace\" \"}\"]]]]))\n\n\n(def ^:private true-expr\n  [:singleExpression [:literal [\"BooleanLiteral\" \"true\"]]])\n\n\n(def ^:private false-expr\n  [:singleExpression [:literal [\"BooleanLiteral\" \"false\"]]])\n\n\n(def ^:private spin\n  (portable/program (while-loop true-expr)))\n\n\n(def ^:private caught\n  (portable/program\n    [:tryStatement\n     [\"Try\" \"try\"]\n     [:block [\"OpenBrace\" \"{\"]\n      [:statementList [:statement (while-loop true-expr)]]\n      [\"CloseBrace\" \"}\"]]\n     [:catchProduction\n      [\"Catch\" \"catch\"] [\"OpenParen\" \"(\"]\n      [:identifier [\"Identifier\" \"e\"]]\n      [\"CloseParen\" \")\"]\n      [:block [\"OpenBrace\" \"{\"]\n       [:statementList [:statement (portable/log-stmt (portable/num-expr \"9\"))]]\n       [\"CloseBrace\" \"}\"]]]]))\n\n\n(def ^:private spin-then-log\n  (portable/program (while-loop false-expr)\n                    (portable/log-stmt (portable/num-expr \"5\"))))\n\n\n(defn- envelope\n  [pk]\n  (let [[_ [[port e]]] (lower/lower-transform {:prelude :linked} pk)]\n    (assert (= :program port))\n    e))\n\n\n(defn- derived-ast\n  \"`A'` for `pk` under the linked profile.\"\n  [pk]\n  (let [projected (encoder/project (envelope pk))\n        {:keys [envelope]} (safepoint/derive-envelope projected\n                                                      hooks/linked-profile\n                                                      :test/derived)]\n    (vm/semantic-bytecode->ast (nth (:yin/batch envelope) (:yin/root envelope)))))\n\n\n(defn- with-signals\n  \"A linked `prep` handing the task a signal stream holding `signals`.\"\n  [signals]\n  (fn [task]\n    (let [handle (tu/new-stream 8)]\n      (doseq [s signals] (stream/append! handle s))\n      (let [[ref task] (engine/attach-resource task handle)]\n        (assoc-in task [:store hooks/signals-key] ref)))))\n\n\n(defn- outcome\n  [task]\n  [(vm/halted? task) (vm/blocked? task) (render/output (vm/value task))])\n\n\n(defn- on-every-vm\n  [ast signals]\n  (into {}\n        (map (fn [k]\n               [k (try (outcome (h/run-linked k ast\n                                              {:link-source (h/safepoint-source),\n                                               :prep (with-signals signals)}))\n                       (catch #?(:cljd Object :clj Exception :cljs :default) e\n                         [:thrown (ex-message e)]))]))\n        (keys h/backends)))\n\n\n(defn- every=\n  [expected results]\n  (doseq [[k result] results]\n    (is (= expected result) (str k))))\n\n\n(defn- linked-interrupt\n  []\n  (testing \"while (true) with one signal ends Interrupt, uncaught, through\n            the module boundary\"\n    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n            (on-every-vm (hooks/linked-program (derived-ast spin)) [2])))\n  (testing \"a try/catch around the loop does not catch it\"\n    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n            (on-every-vm (hooks/linked-program (derived-ast caught)) [2]))))\n\n\n(deftest ^:slow linked-interrupt-test\n  (slow/guard \"linked-interrupt-test\" linked-interrupt))\n\n\n(defn- linked-no-park\n  []\n  (testing \"with no signal pending the derived program finishes without\n            blocking and prints what the naive one prints\"\n    (every= [true false {:js/out [\"5\"], :js/uncaught nil}]\n            (on-every-vm (hooks/linked-program (derived-ast spin-then-log))\n                         []))))\n\n\n(deftest ^:slow linked-no-park-test\n  (slow/guard \"linked-no-park-test\" linked-no-park))\n\n\n(defn- fail-closed\n  []\n  (testing \"the derived linked program with no jssp binding names the hook\"\n    (doseq [[k result] (on-every-vm (derived-ast spin) [])]\n      (is (= :thrown (first result)) (str k))\n      (is (re-find #\"jssp/loop\" (second result)) (str k)))))\n\n\n(deftest ^:slow linked-fail-closed-test\n  (slow/guard \"linked-fail-closed-test\" fail-closed))\n(ns yang.typescript.antlr.prelude-module-test\n  \"The `js` prelude as one definition list with two emitters. The module\n   emitter strips the namespace `js/`, so a definition named like a\n   primitive would shadow it inside the module, and a binder named like a\n   definition would shadow that definition inside the function that binds\n   it; neither may exist. Host free names come from the registry, and\n   shared call names come from the pinned `yang.call` requirement.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.core.uast :as u]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.integer :as integer]\n            [yin.vm.module :as module]))\n\n\n(def ^:private registry\n  (-> (module/empty-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})\n      (prelude/register-integer-module {::integer/max-bits 100000,\n                                        ::integer/max-digits 4300})\n      prelude/admit))\n\n\n(defn- binders\n  \"Every lambda parameter in the map AST `ast`.\"\n  [ast]\n  (into #{}\n        (comp (filter #(and (map? %) (= :lambda (:type %)))) (mapcat :params))\n        (tree-seq coll? seq ast)))\n\n\n(deftest no-definition-shadows-a-primitive-test\n  (let [exported (set (map name (filter #(= \"js\" (namespace %))\n                                        (map first prelude/definitions))))]\n    (is (empty? (filter #(contains? vm/primitives (symbol %)) exported)))\n    (is (not-any? #{\"fn\" \"if\" \"do\" \"let\" \"quote\" \"yin\"} exported))))\n\n\n(deftest no_binder_shadows_a_definition_test\n  (let [defined (set (map #(symbol (name %))\n                          (filter #(= \"js\" (namespace %))\n                                  (map first prelude/definitions))))\n        bound (binders (u/sexp->uast\n                         (cons 'do (map second prelude/definitions))))]\n    (is (= #{} (set (filter defined bound))))))\n\n\n(deftest module-spec-declares-every-free-name-test\n  (testing \"a registry with the host modules supplies the module's free names\"\n    (let [spec (prelude/module-spec registry :test/call-address)]\n      (is (= 'js (:name spec)))\n      (is (= prelude/module-exports (:exports spec)))\n      (is (= {'yang.call :test/call-address} (:requires spec)))\n      (is (contains? (:exports spec) 'init!))\n      (is (contains? (:exports spec) 'get-prop)))))\n(ns yang.python.antlr.call-entry-test\n  \"Synthetic constructor and binder fixtures for the Python-local S1 entry.\n   These fixtures prove the record/constructor contract only; they are not\n   conformance evidence under docs/design/yang.antlr.md §8.10.11.\"\n  (:require [clojure.test :refer [deftest is]]\n            [yang.python.antlr.int-ops-test :as ops]\n            [yang.python.antlr.prelude :as prelude]))\n\n\n(def ^:private bindings\n  '[raise-exit (fn [condition] condition)\n    record (fn [f positional named]\n             (assoc (assoc (assoc (assoc {} :yang.call/callee f)\n                                  :yang.call/positional positional)\n                           :yang.call/named named)\n                    :yang.call/raise raise-exit))\n    invoke (fn [f positional named]\n             ((get (cell/get f) :yang.call/entry) (record f positional named)))\n    positional (py/make-function \"positional\" {:params [\"x\"]} [] []\n                                 (fn [args] (get args 0)))\n    named (py/make-function \"named\" {:params [\"x\" \"y\"]} [] []\n                            (fn [args] (get args 1)))\n    defaulted (py/make-function \"defaulted\" {:params [\"x\"]} [7] []\n                                (fn [args] (get args 0)))\n    variadic (py/make-function \"variadic\" {:params [\"x\"] :star? true} [] []\n                               (fn [args] (get (get args 1) :items)))\n    duplicate (py/make-function \"duplicate\" {:params [\"x\"]} [] []\n                                (fn [args] (get args 0)))\n    substituted (py/make-function \"substituted\" {:params [\"x\"]} [] []\n                                  (fn [args] (get args 0)))\n    receiver-fn (py/make-function \"receiver\" {:params [\"x\"]} [] []\n                                  (fn [args] (get args 0)))\n    profile-fn (py/make-function \"profile\" {:params [\"x\"]} [] []\n                                 (fn [args] (get args 0)))\n    caught (fn [thunk]\n             (py/try thunk\n                     (fn [e] (get (cell/get (get (cell/get e) :class)) :name))\n                     (fn [] :py/None)))\n    source-data {:yang.call/entry (fn [invocation] :wrong)}])\n\n\n(def ^:private result-expressions\n  '[(if (get (cell/get positional) :yang.call/entry) true false)\n    (if (get (cell/get py.b/len) :yang.call/entry) true false)\n    (if (get (cell/get py.b/TypeError) :yang.call/entry) true false)\n    (let [absent (record positional [] [])\n          supplied (assoc (record positional [] []) :yang.call/receiver :py/None)]\n      (py/vconj (py/vconj [] (get absent :yang.call/receiver :py/missing))\n                (get supplied :yang.call/receiver :py/missing)))\n    (invoke positional [4] [])\n    (invoke named [1] [[\"y\" 9]])\n    (invoke defaulted [] [])\n    (invoke defaulted [:py/None] [])\n    (invoke variadic [1 2 3] [])\n    (let [r (invoke duplicate [1] [[\"x\" 2]])\n          e (get r :yang.call/value)]\n      (py/vconj (py/vconj [] (get r :yang.call/reason))\n                (get (cell/get (get (cell/get e) :class)) :name)))\n    (get ((get (cell/get positional) :yang.call/entry)\n          (record substituted [5] []))\n         :yang.call/reason)\n    (invoke receiver-fn [11] [])\n    ((get (cell/get receiver-fn) :yang.call/entry)\n     (assoc (record receiver-fn [12] []) :yang.call/receiver :py/None))\n    (get ((get (cell/get profile-fn) :yang.call/entry)\n          (assoc (record profile-fn [3] []) :yang.call/binding-profile :py/None))\n         :yang.call/reason)\n    (caught (fn [] (py/call-kw source-data [] [])))])\n\n\n(def ^:private fixtures\n  (list 'let bindings\n        (reduce (fn [acc expression] (list 'py/vconj acc expression))\n                []\n                result-expressions)))\n\n\n(deftest python-function-entry-record-contract-test\n  (let [expected [true false false [:py/missing :py/None]\n                  4 9 7 :py/None [2 3]\n                  [:yang.call/thrown \"TypeError\"]\n                  :yang.call/invalid-invocation\n                  11 12 :yang.call/unsupported-binding \"TypeError\"]]\n    (doseq [[backend result] (ops/run-with-prelude prelude/uast fixtures)]\n      (is (= expected result) (str backend)))))\n### 8.10 Shared function calling convention\n\n**Status: proposed, 2026-10-29; not implemented.** This section specifies\none invocation convention for every conforming ANTLR-based Yang frontend.\nExamples are non-exhaustive. Adding a language must not add a case to Yang\ncore, a language-pair bridge, or an evaluator transition. The words\n**must**, **must not**, and **may** state requirements on a future\nconforming implementation, not claims about current code.\n\n#### 8.10.1 Decision and scope\n\nA Yin function is a Yin function, independent of its source syntax. The\nVM applies a closure to operands. Source calling semantics are ordinary\nUAST implementing the call site and callee entry, above the VM.\n\nEvery supported source-level callable, after its source-required\nresolution, exposes `:yang.call/entry`, an ordinary Yin closure taking\nexactly one invocation record. Invoking it is an ordinary\n`:application`. No AST tag, lambda slot, instruction, host primitive,\neffect kind, or source-language test is added to the VM.\n\nThis is an internal calling convention, not a transport, another system\nABI, or a host callback interface. Calls between source languages inside\none task do not themselves cross a host boundary. Portable I/O and\ncross-task interaction continue through `dao.stream`.\n\n**Transparent calling** means that an admitted callable can be passed,\nstored, returned, and invoked by any conforming frontend without a\nhandwritten language-pair wrapper. It does not mean every foreign value\nsatisfies every source operation. Invocation, name visibility, and value\ninterpretation are distinct obligations.\n\nThe convention covers ordinary source calls and supported callable\nobjects, including higher-order calls. It does not make macros runtime\nfunctions, grant JavaScript `[[Construct]]`, turn a generator into an\nordinary returning function, or add a source feature a frontend refuses.\nConstructors and asynchronous operations keep their declared source\nsemantics; ordinary callability does not imply either capability.\n\n#### 8.10.2 Callable representation and identity\n\nKeep the callable's existing identity and source-specific data. Add the\ncommon entry beside its private code and metadata:\n\n```clojure\n;; Illustrative contents of one task-owned Python function cell.\n;; `entry` and `body-code` are live Yin closures, not literal AST maps.\n{:yang.call/entry entry\n :py/type :function\n :spec parameter-spec\n :defaults defaults\n :code body-code}\n```\n\nThe existing `:code` field is not the shared entry: its signature differs\nbetween preludes. It may remain private. Cross-language callers must not\ninspect it or extract it to bypass the entry.\n\nA cell-backed callable stores the entry in its cell contents. An\nimmutable callable descriptor, such as a bound method, may carry it\ndirectly in its map. The common prelude projects the entry structurally:\nread an existing sealed cell reference through `cell/get`, or inspect\nthe immutable descriptor, then obtain `:yang.call/entry`. It must not\ndispatch on `:py/type`, `:js/type`, `:php/type`, language names, or a\nregistry of languages.\n\nAn admitted callable is a runtime cell/descriptor constructed or exposed\nby the callable constructors or import/export projections of a pinned,\nconforming profile. The entry slot is a runtime descriptor field, not a\nsource property that promotes arbitrary data to a function. A Python\ndictionary, JavaScript object, or PHP array containing a source key\nspelled `:yang.call/entry` remains ordinary source data unless an explicit\nprofile-defined projection makes it a callable descriptor. Source\nproperty access must not overwrite or masquerade as this runtime slot.\nThis is an obligation of construction and source resolution, not a new\nVM type, descriptor seal, or runtime provenance/language registry. Once\nthe resolved descriptor is admitted, the shared projection is structural;\nUAST deliberately constructing a conforming descriptor opts into the\nconvention rather than changing a source language's data-map semantics.\n\nMissing entry means not callable. Constructors must install a genuine\nunary Yin closure, and supported source mutations must preserve that\ninvariant. Unary arity is a constructor/profile conformance obligation,\nnot a signature introspection operation: Yin closures are opaque and the\nVM's existing argument binding does not enforce this convention's arity.\nA key in a map grants no VM privilege; application, ownership, and\neffect checks still apply. A non-applicable entry remains an operational\nVM application defect, not a source exception caught by the shared helper.\n\nFor callable kinds whose eligibility can change, the same cell or\ndescriptor may also contain `:yang.call/eligible?`, a unary Yin predicate\non the original callable. Without it, an entry is eligible by default.\nWith it, the common callable test uses its boolean result. The predicate\nreads explicit runtime metadata/heap only; it must not mutate state,\nevaluate arguments, execute the target body, or invoke getters/user hooks.\nIt has the same constructor/arity obligations as the entry. For example,\nan instance can keep one dispatch entry while eligibility follows whether\nits class currently supplies a supported call method; changing the class\ndoes not require rewriting every instance.\n\nCall eligibility is tested at the callability-check point required by\nthe caller's source, not universally before argument evaluation. The\nentry resolves/rechecks a dynamic target at its source-required dispatch\npoint so argument side effects that change eligibility remain visible.\nStatic callable kinds need no predicate.\n\nSource callable designators, such as PHP function-name strings and\ncallable arrays where supported, are resolved under their source's rules\nbefore common invocation. They do not gain entry slots merely by being\nstrings or arrays. Exporting a designator as a first-class callable needs\nan explicit frontend projection to an admitted descriptor, retaining any\nsource-required late lookup and receiver semantics. Passing the raw\nstring or array as data leaves it unchanged; a foreign caller must not\nguess its language or search an ambient namespace to invoke it. This is\nsource resolution/projection, not a language-pair wrapper around an\nalready admitted function.\n\nCross-language passage must not allocate a replacement function cell.\nReturned functions retain their original identity, captures, defaults,\nbound receiver, properties, and static state. A receiving frontend's\ncallable test follows this common eligibility rule rather than rejecting\nforeign native tags. Foreign attribute access and type reflection remain\nprofile-owned; callability grants no general right to interpret another\nruntime's cell layout.\n\nCompiler-internal lambdas and host functions do not acquire this\nconvention merely by being applicable in Yin. A source import exposing\none must emit an entry from its declared signature and effect profile.\nIt must not guess an opaque closure's signature or bypass host-effect\nand custody rules. Internal helper calls need not construct records.\n\n#### 8.10.3 Invocation record\n\nThe invocation is an ephemeral in-machine value. These keys are proposed\nvocabulary, not existing repository APIs:\n\n```clojure\n{:yang.call/callee     f\n :yang.call/positional [v0 v1 ...]\n :yang.call/named      [[\"name\" value] ...]\n :yang.call/raise      raise-exit\n ;; Optional: presence means a receiver was supplied, even when nil.\n :yang.call/receiver   receiver\n ;; Optional: pinned argument-binding extension, for example locations.\n :yang.call/binding-profile \"<content-address>\"}\n```\n\nThe four required fields mean:\n\n- `:yang.call/callee`: the original resolved callable, including its\n  identity. The invocation helper supplies it; an extracted entry must\n  not be applied to another object's substituted state.\n- `:yang.call/positional`: a dense ordered vector of evaluated values.\n  Its length records presence; no missing-argument sentinel is inserted.\n- `:yang.call/named`: ordered name/value pairs, not a map. Names are\n  plain text without caller-side case folding or normalization.\n  Duplicate names remain visible until the callee's binder decides them.\n- `:yang.call/raise`: this activation's caller-supplied, non-returning\n  guest exit, accepting the condition in section 8.10.7. It closes over\n  the caller's continuation and exception machinery, never a host\n  callback or hidden global handler slot.\n\nAn absent receiver differs from one whose value is `nil`, `:py/None`,\n`:php/null`, `:js/null`, or `:js/undefined`. Empty argument vectors are\nrequired rather than represented by absent keys. Presence must not be\ninferred from truthiness.\n\nThe optional binding profile pins additional argument semantics. It\ndoes not name the caller's language or select a language-pair bridge.\nAbsent that extension, arguments are by-value runtime values as in\nsection 8.10.6. The callee entry compares the supplied profile address\nwith its declared accepted/required binding profiles before acquiring\nreferences or entering the body. An unsupported required profile or a\nmissing required extension fails there. The pinned profile defines the\nshape and validation of any extra invocation fields it requires; values\nin the base vectors alone do not establish a location protocol.\n\nThe PHP reference-argument profile is pinned as\n`sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb`.\nPHP call sites include it when their declared target has reference\nparameters; corresponding positional values may then be PHP reference\nmarkers for caller locations. The PHP entry rejects unknown profile\naddresses before parameter binding, and only this profile authorizes its\nbinder to attach a parameter to a caller marker. The markers alone carry\nno binding authority.\n\nConvention revision is pinned by the existing lowering/runtime profiles.\nIt is not a new canonical AST slot, a per-function language tag, or a\nrepeated version field in every invocation. Incompatible revisions need\nnew profiles and explicit admission, never entry-shape guessing.\n\nThe shared helper validates the record's map shape, required presence,\npositional vector, and ordered pairs with text names. The callee entry\nvalidates extension fields under its admitted binding profile; the shared\nhelper knows no extension-specific representation. A valid caller-owned\nraise exit is established before constructing the record, so structural\nfailures can be transferred through it. If no valid raise exit exists,\nthat is an operational wiring failure; do not invent a source exception\npath, default missing fields to `nil`, or broadly catch VM application\nerrors. Checking live entry/exit/predicate closure arity is not part of\nthis validation; constructor fixtures and admission under pinned\nprofiles establish those obligations.\n\n#### 8.10.4 Source semantics at caller and callee\n\nThe caller's lowering preserves its source rules for callable resolution,\nargument/receiver evaluation, and spread or unpacking. Evaluate each\nexpression exactly once, in the source-defined order. Errors required\nbefore argument evaluation must still occur before it. The record holds\nevaluated values; the callee must not reevaluate source expressions.\n\nAfter source resolution, calls use the common projection and application.\nFor a cell-backed callable, the successful path is schematically:\n\n```clojure\n;; UAST notation after source evaluation/resolution and validation.\n;; The caller has already established `raise-exit`.\n(let [entry (get (cell/get f) :yang.call/entry)\n      invocation (assoc evaluated-arguments\n                        :yang.call/callee f\n                        :yang.call/raise raise-exit)]\n  (entry invocation))\n#### 8.10.11 Acceptance gates\n\nExecute real lowered source bodies, not only synthetic functions with\nthe expected slot. A harness may compose published exports and namespace\nprojections explicitly. It must not rewrite call nodes, extract foreign\n`:code`, or insert test-local language-pair wrappers to make calls work.\n\nRequired evidence:\n\n- **Local semantics:** existing suites preserve argument order, defaults,\n  required/extra arguments, keyword errors, receivers, exceptions, and\n  supported reference/static behavior.\n- **Direct calls:** each implemented frontend calls every other\n  conforming frontend through the same mechanism in both directions\n  with compatible values. Derive the test matrix from admitted\n  frontends; do not hard-code it into runtime dispatch.\n- **Higher-order calls:** pass, return, store, recurse, and call back\n  through received functions. Assert identity and captures without\n  replacement cells.\n- **Callable admission:** source data with an entry-spelled property\n  remains data; profile-constructed descriptors are admitted. Exercise\n  supported PHP string/array designators both under local resolution and\n  explicit callable export, preserving required late lookup without\n  foreign namespace guessing.\n- **Presence and binding:** distinguish missing from explicit\n  null/None/undefined; retain duplicate keywords until binding; supply\n  bound self once; evaluate receiver/spreads/defaults at source-defined\n  times and counts.\n- **Dynamic callability:** where supported, an existing instance becomes\n  eligible after its class gains a call method and ineligible after\n  deletion. Calls whose arguments change this metadata observe the\n  correct source-required lookup time without instance rewrapping.\n- **Opaque values:** round-trip foreign objects, functions, strings,\n  float64 content, and exact integers unchanged. Assert aliasing and no\n  silent rounding/null conversion. Unsupported operations yield\n  documented guest errors.\n- **References:** absent/incompatible writable-location profiles fail\n  before reference acquisition and the body, with no reference-induced\n  writeback. Source-required side effects from evaluating arguments still\n  occur; rejection must not erase them. Compatible profiles prove\n  mutation, aliasing, cleanup, and suspension behavior.\n- **Exceptions:** cover binding failures, arbitrary foreign thrown data,\n  catch-all/typed catches, unchanged rethrow, replacement in `finally`,\n  protocol-error rethrow, condition-shaped thrown maps, and A-to-B-to-A\n  propagation. Assert original exception identity and cleanup order,\n  not only rendered text. Store/return a generated `ForeignException`,\n  finish its creating activation, then rethrow it from another activation\n  and assert recovery of the original condition and payload identity.\n- **Context lifetime:** repeated success/raise/success, cross-runtime\n  recursion, and stream suspension/resume restore handler/depth/frame\n  state and perform arguments/cleanup exactly once. Entry boilerplate\n  must not double-count source recursion or tracing activations.\n- **Publication/custody:** bundled/linked forms agree; two importing\n  tasks have independent state. Existing gates still refuse foreign-task\n  cells, forged refs, host functions, and inadmissible continuations.\n- **Portability:** execute portable packet-to-UAST fixtures on JVM,\n  Node, and Dart over the four VMs wherever existing contracts admit\n  the program. JVM-only parsers may supply checked-in CST fixtures;\n  parser availability is distinct from calling conformance.\n\nReport callable kinds, binding/value extensions, actual host/VM\ncoverage as an explicit host-by-VM matrix, refusals, and remaining gaps\nper frontend revision. A scalar example or common UAST grammar alone\ndoes not establish conformance.\n\n### 8.11 Mutable objects and collections over cells\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"TS already routes `js/call` through `yang.call/invoke-with`, and linked programs already require `yang.call`. I’ll check the remaining gaps against the Python reference and build the tests through real module exports, leaving the shared rewrite-based harness untouched."}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/typescript/antlr/linked_harness.cljc; sed -n '1,220p' test/yang/typescript/antlr/linked_prelude_test.cljc; sed -n '1,220p' test/yang/typescript/antlr/prelude_module_test.cljc; cat src/cljc/yang/core/call.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/typescript/antlr/linked_harness.cljc; sed -n '1,220p' test/yang/typescript/antlr/linked_prelude_test.cljc; sed -n '1,220p' test/yang/typescript/antlr/prelude_module_test.cljc; cat src/cljc/yang/core/call.cljc\"","aggregated_output":"(ns yang.typescript.antlr.linked-harness\n  \"The linked profile's composition for the JavaScript tests (T1 step S5,\n   docs/design/yang.typescript.md section 13): the namespace that requires\n   this is the publisher of `js` and `jssp`, so it publishes each module\n   once per process into one in-memory content store and serves them to\n   every linked run over a `yin.vm.linker.interpreter` composition under\n   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n   evidence is `publish-module!`'s own `link-local` links, which\n   `linked-prelude-test` asserts.\n\n   A linked run builds the program's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately\n   until the VM stops blocking, as the REPL's drive does. The AST walker\n   is not a backend here: its link of `js` is refused `:undeclared-free`\n   until L-b.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [dao.jing.mem :as mem]\n            [yang.core.call :as call]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yang.typescript.antlr.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The ordinary JavaScript composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked JavaScript composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `jssp` polls a signal stream, so the\n   safepointed composition needs it even though `js` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`js` published once into its own content store:\n   `{:store s :result r :address a :call-address ca}`. `yang.call` is\n   published first so `js` pins its shared calling runtime.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store,\n       :result result,\n       :address (:address result),\n       :call-address (:address call-result)})))\n\n\n(def published-jssp\n  \"`jssp` published once into `js`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test\n   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n  ([] (source {'js (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition over the published modules: `jssp` requires\n   `js`, and `js` requires `yang.call`.\"\n  []\n  (source {'js (:address @published),\n           'jssp (:address @published-jssp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n                 (assoc attached\n                        :pc pc :frames [] :continuation []\n                        :registers (vec (repeat (:registers body) nil))\n                        :halted? false :blocked? false :value nil)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task\n   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`. Options:\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `js`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `jssp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\n(ns yang.typescript.antlr.linked-prelude-test\n  \"T1 step S5: the JavaScript runtime profile and its hook prelude as the\n   linker modules `js` and `jssp`. Both emit from the single definition\n   lists their bundled twins load; the specs declare every free name of\n   their trees; a linked run on the three vector VMs prints what the\n   bundled run prints; the AST walker's link stays refused until L-b. The\n   published modules and the linked runs are\n   `yang.typescript.antlr.linked-harness`'s: one publication per process,\n   served `:trusted`, so every test that publishes or links is slow.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.stream :as stream]\n    [dao.test-slow :as slow]\n    [yang.safepoint :as safepoint]\n    [yang.core.uast :as u]\n    [yang.typescript.antlr.linked-harness :as h]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.lower-portable-test :as portable]\n    [yang.typescript.antlr.prelude :as prelude]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yang.typescript.antlr.safepoint :as hooks]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.encoder :as encoder]\n    [yin.vm.engine :as engine]\n    [yin.vm.module :as module]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn- refusal-of\n  \"The ex-data of what `thunk` throws, or nil when it returns.\"\n  [thunk]\n  (try (thunk)\n       nil\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         (or (ex-data e) {}))))\n\n\n(defn- def-key\n  \"The literal key of a `(yin/def k v)` application node, else nil.\"\n  [node]\n  (when (and (map? node)\n             (= :application (:type node))\n             (= 'yin/def (get-in node [:operator :name])))\n    (get-in node [:operands 0 :value])))\n\n\n;; =============================================================================\n;; The module emitters\n;; =============================================================================\n\n(deftest jssp-module-uast-is-one-wide-application-test\n  (let [ast hooks/module-uast\n        operands (:operands ast)\n        definitions (butlast operands)]\n    (is (= :application (:type ast)))\n    (is (= :lambda (:type (:operator ast))))\n    (is (= (count operands) (count (:params (:operator ast)))))\n    (is (nil? (get-in ast [:operator :body :value])))\n    (is (= (u/sexp->uast '(require (quote js)))\n           (dissoc (last operands) :tail?)))\n    (testing \"the placeholders come first, each the literal :js/uninit\"\n      (let [n (count hooks/runtime-keys)\n            placeholders (take n definitions)]\n        (is (= (mapv hooks/strip hooks/runtime-keys)\n               (mapv def-key placeholders)))\n        (is (every? #(= {:type :literal, :value :js/uninit}\n                        (dissoc (get-in % [:operands 1]) :tail?))\n                    placeholders))))\n    (testing \"then every definition, stripped, in definition order\"\n      (is (= (mapv (comp hooks/strip first) hooks/function-definitions)\n             (mapv def-key (drop (count hooks/runtime-keys) definitions)))))\n    (testing \"no symbol of the module's own namespace survives stripping\"\n      (is (not-any? (fn [x] (and (symbol? x) (= \"js.sp\" (namespace x))))\n                    (tree-seq coll? seq ast))))\n    (testing \"`js/*` references stay qualified: the base prelude's exports\"\n      (is (some (fn [x] (and (symbol? x) (= \"js\" (namespace x))))\n                (tree-seq coll? seq ast))))))\n\n\n(deftest jssp-module-exports-test\n  (is (= (set (map (comp hooks/strip first) hooks/function-definitions))\n         hooks/module-exports))\n  (is (every? #(contains? hooks/module-exports %) '[attach! loop call]))\n  (is (not-any? namespace hooks/module-exports))\n  (is (not (contains? hooks/module-exports 'cursor)))\n  (is (empty? (filter #(contains? vm/primitives %) hooks/module-exports))))\n\n\n(deftest js-module-exports-stage0-entry-points-test\n  (testing \"the lowering's literal, for-in and JSON entry points are exported\"\n    (is (every? #(contains? prelude/module-exports %)\n                '[new-object new-array literal-proto! for-in-start for-in-next\n                  install-json! define-accessor-half! json-stringify json-parse]))))\n\n\n(deftest jssp-module-spec-test\n  (let [spec (hooks/module-spec (h/registry) :test/js-address)]\n    (is (= 'jssp (:name spec) hooks/module-name))\n    (is (= hooks/module-uast (:ast spec)))\n    (is (= hooks/module-exports (:exports spec)))\n    (is (= {'js :test/js-address} (:requires spec)))\n    (testing \"a js-qualified free name is covered by the requirement\"\n      (is (empty? (filter #(= \"js\" (namespace %)) (keys (:primitives spec))))))\n    (testing \"the qualified declarations are exactly the host names\"\n      (is (= hooks/host-names\n             (set (filter namespace (keys (:primitives spec)))))))\n    (testing \"a free name no registry module supplies is refused\"\n      (let [no-cell (-> (module/empty-registry)\n                        (data/register-data-module {::data/max-items 1048576})\n                        (prelude/register-integer-module h/integer-limits))\n            refusal (refusal-of #(hooks/module-spec no-cell :test/js-address))]\n        (is (= :yang.typescript.antlr/undeclared-free\n               (:yang.typescript.antlr/refusal refusal)))))))\n\n\n(deftest js-module-spec-declares-every-free-name-test\n  (let [call-address (:call-address @h/published)\n        spec (prelude/module-spec (h/registry) call-address)]\n    (is (= 'js (:name spec)))\n    (is (= prelude/module-exports (:exports spec)))\n    (is (= {'yang.call call-address} (:requires spec)))\n    (testing \"a registry without the data module is refused\"\n      (let [no-data (-> (module/empty-registry)\n                        module/register-cell-module\n                        (prelude/register-integer-module h/integer-limits))\n            refusal (refusal-of #(prelude/module-spec no-data call-address))]\n        (is (= :yang.typescript.antlr/undeclared-free\n               (:yang.typescript.antlr/refusal refusal)))\n        (is (= \"data\" (namespace (:name refusal))))))))\n\n\n;; =============================================================================\n;; Publication\n;; =============================================================================\n\n(defn- publication\n  []\n  (let [{:keys [result address]} @h/published\n        links (:links result)]\n    (testing \"js publishes with no undeclared free name\"\n      (is (some? address))\n      (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n        (is (= :ok (get-in links [f :status])) (str f))))\n    (testing \"the AST walker is refused :undeclared-free on a sibling read\n              until L-b; L-b's landing flips this assertion\"\n      (let [walker (get links :yin.ast/code)]\n        (is (= :refused (:status walker)))\n        (is (= :undeclared-free (:reason walker)))\n        (is (contains? prelude/module-exports (:name walker)))))\n    (testing \"jssp publishes over js\"\n      (let [{:keys [result]} @h/published-jssp]\n        (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n          (is (= :ok (get-in (:links result) [f :status])) (str f)))))))\n\n\n(deftest ^:slow publication-test\n  (slow/guard \"publication-test\" publication))\n\n\n;; =============================================================================\n;; Linked runs equal bundled runs\n;; =============================================================================\n\n(def ^:private programs\n  \"Hand-built packets: name -> packet.\"\n  {:log-literal (portable/program (portable/log-stmt (portable/num-expr \"1\"))),\n   :var-and-log (portable/program\n                  (portable/var-stmt \"var\" \"x\" (portable/num-expr \"7\"))\n                  (portable/log-stmt (portable/name-expr \"x\"))),\n   :let-in-tdz (portable/program\n                 (portable/log-stmt (portable/name-expr \"y\"))\n                 (portable/var-stmt \"let\" \"y\" (portable/num-expr \"1\")))})\n\n\n(defn- bundled\n  [ast]\n  (render/output ((get parity/runners :semantic) ast)))\n\n\n(defn- linked\n  [k ast]\n  (render/output (vm/value (h/run-linked k ast))))\n\n\n(defn- linked-equals-bundled\n  []\n  (doseq [[nm pk] programs\n          :let [expected (bundled (lower/lower-packet pk))\n                ast (lower/lower-packet pk {:prelude :linked})]]\n    (doseq [k (keys h/backends)]\n      (is (= expected (linked k ast)) (str nm \" \" k)))))\n\n\n(deftest ^:slow linked-equals-bundled-test\n  (slow/guard \"linked-equals-bundled-test\" linked-equals-bundled))\n\n\n;; =============================================================================\n;; The hook prelude linked: signals through the module boundary\n;; =============================================================================\n\n(def ^:private while-loop\n  \"`while (cond) { }` over singleExpression form `cond`.\"\n  (fn [cond-form]\n    [:iterationStatement\n     [\"While\" \"while\"] [\"OpenParen\" \"(\"]\n     [:expressionSequence cond-form]\n     [\"CloseParen\" \")\"]\n     [:statement [:block [\"OpenBrace\" \"{\"] [\"CloseBrace\" \"}\"]]]]))\n\n\n(def ^:private true-expr\n  [:singleExpression [:literal [\"BooleanLiteral\" \"true\"]]])\n\n\n(def ^:private false-expr\n  [:singleExpression [:literal [\"BooleanLiteral\" \"false\"]]])\n\n(ns yang.typescript.antlr.prelude-module-test\n  \"The `js` prelude as one definition list with two emitters. The module\n   emitter strips the namespace `js/`, so a definition named like a\n   primitive would shadow it inside the module, and a binder named like a\n   definition would shadow that definition inside the function that binds\n   it; neither may exist. Host free names come from the registry, and\n   shared call names come from the pinned `yang.call` requirement.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yang.core.uast :as u]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.integer :as integer]\n            [yin.vm.module :as module]))\n\n\n(def ^:private registry\n  (-> (module/empty-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})\n      (prelude/register-integer-module {::integer/max-bits 100000,\n                                        ::integer/max-digits 4300})\n      prelude/admit))\n\n\n(defn- binders\n  \"Every lambda parameter in the map AST `ast`.\"\n  [ast]\n  (into #{}\n        (comp (filter #(and (map? %) (= :lambda (:type %)))) (mapcat :params))\n        (tree-seq coll? seq ast)))\n\n\n(deftest no-definition-shadows-a-primitive-test\n  (let [exported (set (map name (filter #(= \"js\" (namespace %))\n                                        (map first prelude/definitions))))]\n    (is (empty? (filter #(contains? vm/primitives (symbol %)) exported)))\n    (is (not-any? #{\"fn\" \"if\" \"do\" \"let\" \"quote\" \"yin\"} exported))))\n\n\n(deftest no_binder_shadows_a_definition_test\n  (let [defined (set (map #(symbol (name %))\n                          (filter #(= \"js\" (namespace %))\n                                  (map first prelude/definitions))))\n        bound (binders (u/sexp->uast\n                         (cons 'do (map second prelude/definitions))))]\n    (is (= #{} (set (filter defined bound))))))\n\n\n(deftest module-spec-declares-every-free-name-test\n  (testing \"a registry with the host modules supplies the module's free names\"\n    (let [spec (prelude/module-spec registry :test/call-address)]\n      (is (= 'js (:name spec)))\n      (is (= prelude/module-exports (:exports spec)))\n      (is (= {'yang.call :test/call-address} (:requires spec)))\n      (is (contains? (:exports spec) 'init!))\n      (is (contains? (:exports spec) 'get-prop)))))\n(ns yang.core.call\n  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n   §8.10). This namespace emits the same pure definitions into bundled\n   preludes and the linked `yang.call` module.\"\n  (:require [yang.core.prelude :as core]\n            [yang.core.uast :as u]))\n\n\n(def module-name\n  \"The linker module that publishes the shared calling runtime.\"\n  'yang.call)\n\n\n(def host-names\n  \"Host module names read by the guest definitions.\"\n  '#{cell/get data/callable? data/contains? data/count data/map?\n     data/string? data/vector?})\n\n\n(def definitions\n  \"The one ordered definition list used by both emitters.\"\n  '[;; Descriptor projection remains structural after callable admission.\n    [yang.call/_descriptor\n     (fn [callable]\n       (if (data/map? callable)\n         (if (= (get callable :type) :cell-ref)\n           (cell/get callable)\n           callable)\n         nil))]\n    [yang.call/entry\n     (fn [callable]\n       (get (yang.call/_descriptor callable) :yang.call/entry))]\n    [yang.call/eligible?\n     (fn [callable]\n       (let [descriptor (yang.call/_descriptor callable)]\n         (if (nil? (yang.call/entry callable))\n           false\n           (if (data/contains? descriptor :yang.call/eligible?)\n             ((get descriptor :yang.call/eligible?) callable)\n             true))))]\n    [yang.call/invocation\n     (fn [callee positional named raise]\n       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/invocation-with\n     (fn [callee positional named raise options]\n       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/_pair?\n     (fn [pair]\n       (if (data/vector? pair)\n         (= (data/count pair) 2)\n         false))]\n    [yang.call/_named-pairs?\n     (fn [pairs index]\n       (if (= index (data/count pairs))\n         true\n         (let [pair (data/nth pairs index)]\n           (if (yang.call/_pair? pair)\n             (if (data/string? (data/nth pair 0))\n               (yang.call/_named-pairs? pairs (+ index 1))\n               false)\n             false))))]\n    [yang.call/valid-invocation?\n     (fn [invocation]\n       (if (data/map? invocation)\n         (if (data/contains? invocation :yang.call/callee)\n           (if (data/contains? invocation :yang.call/positional)\n             (if (data/contains? invocation :yang.call/named)\n               (if (data/contains? invocation :yang.call/raise)\n                 (if (data/vector? (get invocation :yang.call/positional))\n                   (if (data/vector? (get invocation :yang.call/named))\n                     (yang.call/_named-pairs?\n                       (get invocation :yang.call/named) 0)\n                     false)\n                   false)\n                 false)\n               false)\n             false)\n           false)\n         false))]\n    [yang.call/condition\n     (fn [reason evidence]\n       (assoc (assoc {} :yang.call/reason reason)\n              :yang.call/data evidence))]\n    [yang.call/thrown\n     (fn [value]\n       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n              :yang.call/value value))]\n    [yang.call/transfer\n     (fn [raise condition]\n       (raise condition))]\n    [yang.call/invoke\n     (fn [callable positional named raise]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation callable positional named raise)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]\n    [yang.call/invoke-with\n     (fn [callable positional named raise options]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation-with\n                          callable positional named raise options)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]])\n\n\n(def ^:private public-exports\n  '#{entry eligible? invocation invocation-with valid-invocation? condition\n     thrown transfer invoke invoke-with})\n\n\n(def uast\n  \"The bundled definitions, in source order and tail marked.\"\n  (u/mark-tails\n    (reduce (fn [ast [key form]]\n              (u/then ast (u/def! key (u/sexp->uast form))))\n            (u/def! (ffirst definitions)\n                    (u/sexp->uast (second (first definitions))))\n            (rest definitions))))\n\n\n(def module-uast\n  \"The linked module tree built from the same `definitions`.\"\n  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n                                          [] definitions)]\n    (core/module-tree stripped [])))\n\n\n(def module-exports\n  \"Public module exports (private helper definitions stay internal).\"\n  public-exports)\n\n\n(def ^:private module-free-names\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"The linker module spec for `yang.call` over `registry`.\"\n  [registry]\n  (core/module-spec {:module-name module-name\n                     :ast module-uast\n                     :exports module-exports\n                     :requires {}\n                     :free-names module-free-names\n                     :registry registry\n                     :message \"the yang.call module reads an undeclared name\"\n                     :refusal-ns \"yang.call\"}))\n","exit_code":0,"status":"completed"}}
