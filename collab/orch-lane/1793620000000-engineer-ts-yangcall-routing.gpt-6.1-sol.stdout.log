hp/antlr/lower.cljc:1446:          (unsupported! n :namespace)))\nsrc/cljc/yang/php/antlr/lower.cljc:2384:(defn lower-module-body\nsrc/cljc/yang/php/antlr/lower.cljc:2391:(defn lower-program\nsrc/cljc/yang/php/antlr/lower.cljc:2409:(defn lower-packet\nsrc/cljc/yang/php/antlr/lower.cljc:2438:(defn lower-transform\nsed: test/yang/php/antlr/linked_prelude_test.cljc: No such file or directory\n(ns yang.cross-lang-test\n  \"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\n   bottom out in `:application`, and the engine neither knows nor cares which\n   frontend minted a closure. A TypeScript function value is called from\n   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\n   VM, one run.\n\n   The seam is the lowered tree, not a prelude change. Each direction lowers\n   a program normally, then (1) extracts the foreign function value by\n   running the donor program with its `run-main` replaced so the program's\n   value IS the function (`js/make-function` cell, `php/make-function` cell),\n   and (2) binds that value to a free variable of the receiver, replacing the\n   receiver's lookup node (`php/resolve-fn` of a name; `js/global-get` of a\n   name) by that variable. Both function values are cells whose `:code` is\n   called with a receiver slot and an argument vector, so the callee needs no\n   knowledge of the caller's prelude.\n\n   What is pinned as LIMITS (documented expectations, not failures):\n   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\n   PHP null (`:php/null`) is neither JS null nor undefined. The JVM lane runs\n   the AST walker only.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [clojure.walk :as walk]\n    [yang.php.antlr.e2e-harness :as php]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.typescript.antlr.e2e-test :as ts]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn- app?\n  [node op]\n  (and (map? node)\n       (= :application (:type node))\n       (= {:type :variable, :name op} (:operator node))))\n\n\n(defn- find-node\n  \"The first node of `tree` satisfying `pred`, preorder.\"\n  [pred tree]\n  (let [hit (volatile! nil)]\n    (walk/prewalk (fn [n] (when (and (nil? @hit) (pred n)) (vreset! hit n)) n)\n                  tree)\n    @hit))\n\n\n(defn- var-node\n  [name]\n  {:type :variable, :name name})\n\n\n(defn- donor\n  \"The AST whose value is the function value of the donor program: the\n   `run-main` application becomes a call of its body, which is replaced by\n   the first function-making node (`make-fn`) of the program.\"\n  [ast run-main make-fn body-args]\n  (let [fn-node (find-node #(app? % make-fn) ast)]\n    (assert fn-node (str \"no \" make-fn \" node in the donor\"))\n    (walk/prewalk\n      (fn [n]\n        (if (app? n run-main)\n          {:type :application,\n           :operator {:type :lambda,\n                      :params ['%body],\n                      :body {:type :application,\n                             :operator (var-node '%body),\n                             :operands body-args}},\n           :operands [{:type :lambda,\n                       :params (if (= make-fn 'js/make-function) ['%0] []),\n                       :body fn-node}]}\n          n))\n      ast)))\n\n\n(defn- lowered-php\n  [source]\n  (let [{:keys [ast diagnostics]} (php/lower-program source)]\n    (assert (nil? diagnostics) (pr-str diagnostics))\n    ast))\n\n\n(defn- lowered-ts\n  [source]\n  (let [r (ts/lower-source source :bundled)]\n    (assert (nil? (:diagnostics r)) (pr-str (:diagnostics r)))\n    (let [{:yin/keys [batch root]} (:program r)]\n      (nth batch root))))\n\n\n(defn- bind\n  \"`receiver` with `v-name` bound to the value of `donor-ast`.\"\n  [donor-ast v-name receiver]\n  {:type :application,\n   :operator {:type :lambda, :params [v-name], :body receiver},\n   :operands [donor-ast]})\n\n\n(defn- registry\n  []\n  (php-h/host-registry))\n\n\n(defn- run\n  [ast]\n  (vm/value (vm/eval (tu/create-vm {:modules (registry)}) ast)))\n\n\n(defn ts-into-php\n  \"PHP `source` calling `ts_fn(...)`, with `ts_fn` the TS function `ts-src`\n   (a program of one arrow expression). Returns the printed text.\"\n  [ts-src source]\n  (let [fn-ast (donor (lowered-ts ts-src) 'js/run-main 'js/make-function\n                      [{:type :literal, :value :js/undefined}])\n        php-ast (walk/postwalk\n                  (fn [n]\n                    (if (app? n 'php/resolve-fn)\n                      (var-node '%tsfn)\n                      n))\n                  (lowered-php source))]\n    (php-h/render (run (bind fn-ast '%tsfn php-ast)))))\n\n\n(defn php-into-ts\n  \"TS `source` calling `phpfn(...)`, with `phpfn` the PHP closure `php-src`\n   (a program holding one closure expression). Returns the rendered value.\"\n  [php-src source]\n  (let [fn-ast (donor (lowered-php php-src) 'php/run-main 'php/make-function [])\n        ts-ast (walk/postwalk\n                 (fn [n]\n                   (if (and (app? n 'js/global-get)\n                            (= \"phpfn\" (get-in n [:operands 0 :value :js/str])))\n                     (var-node '%phpfn)\n                     n))\n                 (lowered-ts source))]\n    (render/output (run (bind fn-ast '%phpfn ts-ast)))))\n\n\n(deftest ts-closure-called-from-php-test\n  (testing \"a number crosses as a number: float in, float out\"\n    (is (= \"4\"\n           (ts-into-php \"(x, y) => x + y;\" \"<?php echo ts_fn(1.5, 2.5);\"))))\n  (testing \"the PHP caller sees the result as an ordinary value\"\n    (is (= \"yes\"\n           (ts-into-php \"(x, y) => x + y;\"\n                        \"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\")))))\n\n\n(deftest php-closure-called-from-ts-test\n2033-   :py/exception nil-or-{:type :args}}`. The packet may declare the\n2034-   decimal digit budget of its literals as `:yang.python.antlr/max-digits`.\n2035-\n2036-   `:prelude` selects how the runtime profile arrives: `:bundled` (the\n2037-   default) carries the prelude tree ahead of the body; `:linked`\n2038:   requires `yang.call` and `py` from the task's link pair, then allocates\n2039-   the task's runtime state with `(py/init!)`. Either way the body names only\n2040-   `py/` exports, never a runtime key.\n2041-\n2042-   Guest imports deliver through try-require thunks at the executed\n2043-   statement, after checking sys.modules. Only py is eagerly required;\n--\n2061-                             \"Imports need the linked prelude (docs/design/yang.antlr.md 8.5.6)\"\n2062-                             {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n2063-                              :construct \"import under the bundled prelude\"}))\n2064-                    (u/then prelude/uast main))\n2065-         :linked (u/seq-nodes\n2066:                   [(app* 'require (u/lit 'yang.call))\n2067-                    (app* 'require (u/lit prelude/module-name))\n2068-                    (app* 'py/init!) main]))))))\n2069-\n2070-\n2071-;; =============================================================================\n--\n2073-;; =============================================================================\n2074-\n2075-(def ^:private require-node core-module/require-node)\n2076-\n2077-\n2078:(defn- calls-yang-call?\n2079-  [ast]\n2080-  (some (fn [n]\n2081:          (and (symbol? n) (= \"yang.call\" (namespace n))))\n2082-        (prelude/free-names ast)))\n2083-\n2084-\n2085-(def module-exports\n2086-  \"The exports of a compiled Python unit: its spec and body, immutable\n--\n2101-                     :name name}))))\n2102-\n2103-\n2104-(defn module-packet\n2105-  \"One ok packet as the linker module `pym.<mangled>`: one wide\n2106:   application requiring `yang.call` first when the body reads that\n2107-   convention, then `py`, then defining spec and body. Guest imports deliver\n2108-   at statement time; module-spec\n2109-   still pins every static import. `name` is\n2110-   the dotted Python module name and `package?` (default false) whether\n2111-   the unit is a package, which is source layout, not derivable from\n--\n2117-  (validate-module-name! name)\n2118-  (let [unit {:name name, :package? (boolean package?)}\n2119-        body (u/lam [globals-sym globals-fn-sym]\n2120-                    (lower-module-body packet unit))\n2121-        defs [(u/def! 'spec (u/lit unit)) (u/def! 'body body)]\n2122:        operands (into (vec (concat (when (calls-yang-call? body)\n2123:                                      [(require-node 'yang.call)])\n2124-                                    [(require-node prelude/module-name)]))\n2125-                       defs)\n2126-        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n2127-    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))\n2128-\n--\n2165-     :ast (module-packet packet {:name name, :package? package?}),\n2166-     :exports module-exports,\n2167-     :runtime-name prelude/module-name,\n2168-     :runtime-address py-address,\n2169-     :deps (cond-> (into {} (map (fn [[n a]] [(module-symbol n) a])) deps)\n2170:             (calls-yang-call? (module-packet packet {:name name, :package? package?}))\n2171:             (assoc 'yang.call call-address))}))\n2172-\n2173-\n2174-(def ^:private module-tree core-module/module-tree)\n2175-\n2176-\n--\n2206-\n2207-(defn- scc-module-specs*\n2208-  \"Canonical I5 construction: sorted members, indexed bare exports\n2209-   m0-spec/m0-body, etc.; one pyscc.<mangled-members> bundle followed by\n2210-   aliases in member order. Internal deliveries read those exports without\n2211:   requiring aliases. The bundle pins py, yang.call when a body reads it,\n2212-   and outgoing imports.\n2213-   Alias :requires is filled with the bundle address after publication.\"\n2214-  [registry units py-address call-address deps]\n2215-  (doseq [{:keys [name]} units]\n2216-    (validate-module-name! name))\n--\n2276-                 (u/def! body-key body)))\n2277-             units wrapped-bodies)\n2278-        ;; The linker discharges body reads only when their definitions\n2279-        ;; precede every module-level application site. Install the pure\n2280-        ;; sibling bindings before require; defining the lambdas runs no py.\n2281:        needs-call? (some calls-yang-call? wrapped-bodies)\n2282-        ast (module-tree (concat spec-defs\n2283-                                 body-defs\n2284:                                 (when needs-call? [(require-node 'yang.call)])\n2285-                                 [(require-node prelude/module-name)]))\n2286-        exports (set (mapcat val keys-for))\n2287-        bundle (core-module/module-spec\n2288-                 :yang.python.antlr/refusal :yang.python.antlr/undeclared-free\n2289-                 registry\n--\n2291-                  :ast ast,\n2292-                  :exports exports,\n2293-                  :runtime-name prelude/module-name,\n2294-                  :runtime-address py-address,\n2295-                  :deps (cond-> (into {} (map (fn [[n a]] [(module-symbol n) a])) deps)\n2296:                          needs-call? (assoc 'yang.call call-address))})\n2297-        require-profile (vm/profile-of vm/primitives 'require)]\n2298-    (core-module/scc-module-specs\n2299-      bundle\n2300-      (mapv (fn [{:keys [name]}]\n2301-              (let [[sk bk] (get keys-for name)]\ntree efc99cc4:\n\n.cljstyle\n.gitignore\n.opencode/\n.projectile\n.zcode/\n.zcodeignore\nAGENTS.md\nCLAUDE.md\nGEMINI.md\nLICENSE\nLICENSE-EXCEPTION\nREADME.md\nanalysis_options.yaml\nandroid/\nantlr/\narchive/\nassets/\nbb.edn\nbin/\nconfig.clj\ndemo/\ndemo_yang.clj\ndeps.edn\ndocker/\ndocs/\nexamples/\nios/\njolt-toolchain.edn\nlinux/\nmacos/\nmise.toml\nnative/\nnginx.conf\norchestrator-logs/\npackage-lock.json\npackage.json\npublic/\npubspec.lock\npubspec.yaml\nshadow-cljs.edn\nsrc/\ntest/\