   v))]\n    [php/tmp-prefix\n     (fn [ts i n acc] (if (< i n) (php/tmp-prefix ts (+ i 1) n (php/vconj acc (get ts i))) acc))]\n    [php/release-tmps\n     (fn [mark]\n       (let [ts (cell/get php.rt/tmps)\n             n (data/count ts)]\n         (if (> n mark)\n           (do (cell/set! php.rt/tmps (php/tmp-prefix ts 0 mark []))\n               (php/release-tmp-range ts n mark)\n               :php/null)\n           :php/null)))]\n    [php/release-tmp-range\n     (fn [ts i mark]\n       (if (> i mark)\n         (do (php/delref (get ts (- i 1))) (php/release-tmp-range ts (- i 1) mark))\n         :php/null))]\n    [php/make-closure\n     ;; a Closure value (an object, `kind` :obj) around the function cell\n     (fn [f] (assoc (assoc {} :php/type :closure) :php/closure f))]\n    [php/callable-of\n     ;; the function cell of a callable value: a name or a Closure\n     (fn [v]\n       (if (= (php/kind v) :string)\n         (php/resolve-fn (php/lc v) v)\n         (if (= (get v :php/type) :closure)\n           (get v :php/closure)\n           (php/throw-error \"Error\" \"Value not callable\"))))]\n    [php/callable-fn (fn [h] (php/callable-of h))]\n    [php/call-value (fn [v args] (php/call (php/callable-of v) args))]\n    [php/args-spread\n     ;; `f(...$xs)`: the values of `xs` appended to the argument vector; a\n     ;; string key would be a named argument, which is a known gap (C25)\n     (fn [acc xs]\n       (if (= (php/kind xs) :array)\n         (php/spread-args acc xs 0 (php/array-count xs))\n         (php/throw-error \"Error\" \"Only arrays and Traversables can be unpacked\")))]\n    [php/spread-args\n     (fn [acc xs i n]\n       (if (< i n)\n         (let [k (get (php/array-order xs) i)]\n           (if (php/int? k)\n             (php/spread-args (php/vconj acc (php/array-get xs k)) xs (+ i 1) n)\n             (php/throw-error\n               \"Error\"\n               \"spread with string keys is not supported yet (yang.php known gap G-spread-string-keys)\")))\n         acc))]\n    [php/name-index\n     (fn [names name i n]\n       (if (< i n)\n         (if (= (get names i) name) i (php/name-index names name (+ i 1) n))\n         nil))]\n    [php/pad-args\n     (fn [args n]\n       (if (< (data/count args) n) (php/pad-args (php/vconj args :php/undef) n) args))]\n    [php/call-named\n     ;; `f(pos..., name: v ...)`: named values land at their parameter's\n     ;; position, holes stay :php/undef; unknown names go to a variadic\n     ;; parameter's string keys, else they are an Error\n     (fn [f pos named]\n       (let [spec (get (cell/get f) :spec)]\n(def functions-uast\n  \"Every definition: lambdas and the literal state slot.\"\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) definitions)))\n\n\n(def uast\n  \"The bundled prelude: every definition, then the task's runtime state\n   allocated by `php/init!`.\"\n  (u/then functions-uast (u/sexp->uast '(php/init!))))\n\n\n;; =============================================================================\n;; The module emitter: the same definition list as the linker module `php`\n;; =============================================================================\n\n(def module-name\n  \"The linker module the PHP runtime profile is published as.\"\n  'php)\n\n\n(def runtime-keys\n  \"Every key `php/init!` allocates, the ready flag aside, sorted.\"\n  '[php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/error-handler\n    php.rt/error-reporting php.rt/functions php.rt/globals php.rt/int-max\n    php.rt/int-min php.rt/next-cell php.rt/next-ord\n    php.rt/out php.rt/tmps])\n\n\n(defn strip\n  \"`sym` without the module's own namespace `php`; `php.rt/*` stays\n   qualified.\"\n  [sym]\n  (core/strip \"php\" sym))\n\n\n(def ^:private module-definitions\n  (core/module-definitions \"php\" :php/uninit runtime-keys definitions))\n\n\n(def module-uast\n  \"The module tree: one application whose operands are the definitions, in\n   order. Defining runs nothing.\"\n  (core/module-tree module-definitions []))\n\n\n(def module-exports\n  \"The module's exports: every `php/` key of the definition list, stripped.\"\n  (core/exports \"php\" definitions))\n\n\n(def free-names core/free-names)\n\n\n(def defined-keys core/defined-keys)\n\n\n(def ^:private module-free-names\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `php` over\n   the host registry `registry`; a free name nothing supplies is refused\n   before anything is published. This namespace emits; it never publishes.\"\n  [registry]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {},\n                     :free-names module-free-names,\n                     :registry registry,\n                     :message \"the php module reads an undeclared name\",\n                     :refusal-ns \"yang.php\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: the exact float\n   expansion `m * 5^k` needs about 2200 bits.\"\n  4096)\n\n\n            (if (<= (count nodes) 1)\n              (first nodes)\n              (let [middle (quot (count nodes) 2)]\n                (u/then (sequence-tree (subvec nodes 0 middle))\n                        (sequence-tree (subvec nodes middle))))))]\n    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n\n\n(def functions-uast\n  \"The shared calling runtime followed by every js definition. Defining\n   them runs nothing, so this loads on any composition, with or without cells.\"\n  (definitions->uast (into call/definitions definitions)))\n\n\n(def uast\n  \"The bundled prelude: every definition, then the task's runtime state\n   allocated by `js/init!`.\"\n  (u/then functions-uast (u/sexp->uast '(js/init!))))\n\n\n;; =============================================================================\n;; The linked js module requires the separately published `yang.call` module\n;; =============================================================================\n\n(def module-name\n  \"The linker module the JavaScript runtime profile is published as.\"\n  'js)\n\n\n(def runtime-keys\n  \"Every key `js/init!` allocates, the ready flag aside, sorted.\"\n  (vec (sort-by str\n                (concat '[js.rt/ctx js.rt/out js.rt/global js.rt/obj-proto\n                          js.rt/fn-proto js.rt/symbol-proto js.rt/array-proto]\n                        (map second error-classes)\n                        (map first primitive-protos)))))\n\n\n(defn strip\n  \"`sym` without the module's own namespace `js`; any other value as it\n   is. `js.rt/*` stays qualified: an internal store key.\"\n  [sym]\n  (core/strip \"js\" sym))\n\n\n(def ^:private module-definitions\n  \"The module's definition list: a `:js/uninit` placeholder for every\n   runtime key, then every definition, stripped.\"\n  (core/module-definitions \"js\" :js/uninit runtime-keys linked-definitions))\n\n\n(def module-uast\n  \"The module tree: one application whose operands are the definitions, in\n   order, applied to a lambda that returns nil.\"\n  (core/module-tree module-definitions []))\n\n\n(def module-exports\n  \"The module's exports: every `js/` key of the definition list, stripped.\"\n  (core/exports \"js\" definitions))\n\n\n(def free-names\n  \"Every variable name some occurrence of the map AST reads unbound by an\n   enclosing lambda.\"\n  core/free-names)\n\n\n(def defined-keys\n  \"Every literal key the map AST defines with `yin/def`, at any depth.\"\n  core/defined-keys)\n\n\n(def ^:private module-free-names\n  \"The names the module tree reads and does not define, sorted: the\n   primitives and the host exports its manifest must declare.\"\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `js` over\n   the host registry `registry`, pinned to the published `yang.call` module\n   at `call-address`. A free name nothing supplies is refused before\n   anything is published. This namespace emits; it never publishes.\"\n  [registry call-address]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {'yang.call call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the js module reads an undeclared name\",\n                     :refusal-ns \"yang.typescript.antlr\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: every inline\n   literal (up to 2^53 - 1) must fit.\"\n  53)\n\n\n(defn register-integer-module\n  \"Return `registry` with the `integer` module installed under `limits`\n   for this profile: refused when `::integer/max-bits` is under\n   `min-integer-bits`, otherwise `integer/register-integer-module`.\"\n  [registry limits]\n  (let [b (::integer/max-bits limits)]\n    (when-not (and (int? b) (<= min-integer-bits b))\n      (throw (ex-info \"the JavaScript profile needs integer max-bits >= 53\"\n                      {:yang.typescript.antlr/refusal\n(ns yang.typescript.antlr.prelude-parity-test\n  \"The `js` prelude's semantics on all four VMs and every host this runs on\n   (T1 steps S1 and S2): two-form strings, ES Number::toString, ToNumber,\n   ToInt32, the operator family with exact BigInt arms, equality and order,\n   the ordered own-key map, object reads with primitive receivers, function\n   calls, the Error family, the continuation escapes, `js/init!` and the\n   console boundary.\n\n   Numbers are float64 content: a test writes one as the marker `{:n x}`,\n   which becomes `(data/float64 x)` in a program and `(cbor/float64 x)` in an\n   expectation (`:neg-zero`, `:nan`, `:inf` and `:-inf` name the specials),\n   and results compare by `cbor/content=`, which is kind strict: a bare 1 (a\n   bigint) is never a float64 1.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.jing.cbor :as cbor]\n            [dao.test-slow :as slow]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yang.typescript.antlr.render :as render]\n            [yang.core.uast :as u]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def ^:private opts\n  \"The composition over the real modules.\"\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives,\n   :modules (-> (module/empty-registry)\n                module/register-cell-module\n                (data/register-data-module {::data/max-items 1048576})\n                (prelude/register-integer-module {::integer/max-bits 100000,\n                                                  ::integer/max-digits 4300})\n                prelude/admit)})\n\n\n(def ^:private load-semantic-ast\n  (vm/fresh-code-loader semantic/load-ast\n                        vm/ast-contract))\n\n\n(def vm-runners\n  \"Each VM's runner over the composition: ast to the finished VM.\"\n  {:ast-walker (fn [ast] (vm/eval (tu/create-vm opts) ast)),\n   :semantic (fn [ast]\n               (vm/run (load-semantic-ast (semantic/create-vm opts)\n                                          (vm/ast->datoms ast)))),\n   :stack (fn [ast]\n            (vm/run (dvm/create-vm\n                      (:image (derive/stack-image\n                                (:vector (sr-linearize/project ast))))\n                      (assoc opts :contract vm/stack-contract)))),\n   :register (fn [ast]\n               (vm/run\n                 (rvm/create-vm\n                   (derive/register-image (:vector (sr-linearize/project ast)))\n                   (assoc opts :contract vm/register-contract))))})\n\n\n(def runners\n  (into {}\n        (map (fn [[k run]] [k (fn [ast] (vm/value (run ast)))]))\n        vm-runners))\n\n\n(defn run-with-prelude\n  \"The value of `form` (prelude notation) after `prelude-ast`, on each VM.\"\n  [prelude-ast form]\n  (let [ast (u/mark-tails (u/then prelude-ast (u/sexp->uast form)))\n        attempt (fn [run]\n                  (try (run ast)\n                       (catch #?(:cljd Object :clj Exception :cljs :default) e\n                         [:thrown (ex-message e)])))]\n    (into {} (map (fn [[k run]] [k (attempt run)])) runners)))\n\n\n(defn- special\n  [x]\n  (case x\n    :neg-zero (* -1.0 0.0)\n    :nan (- ##Inf ##Inf)\n    :inf ##Inf\n    :-inf ##-Inf\n    x))\n\n\n(defn- marker?\n  [x]\n  (and (map? x) (= [:n] (keys x))))\n\n\n(defn program-form\n  \"`form` with every `{:n x}` marker as float64 content, embedded as a\n   literal (on JS the carrier: a bare integral Number is an integer, and\n   one past 2^53 is refused).\"\n  [form]\n  (walk/postwalk (fn [x] (if (marker? x) (cbor/float64 (special (:n x))) x))\n                 form))\n\n\n(defn expected-value\n  \"`expected` with every `{:n x}` marker as float64 content.\"\n  [expected]\n  (program-form expected))\n\n\n(defn- same?\n  [a b]\n  (cbor/content= a b))\n\n\n(defn- throws\n  \"A form that answers the `name` of the error `expr` throws, or the value.\"\n  [expr]\n  (list 'js/try\n        (list 'fn [] expr)\n        '(fn [e] (js/get-prop e {:js/str \"name\"}))))\n\n\n(defn- av\n  \"A program form building the argument vector of `xs`.\"\n  [& xs]\n  (reduce (fn [acc a] (list 'js/vconj acc a)) [] xs))\n\n\n(defn- call-method\n  [recv method & args]\n  (list 'js/call\n        (list 'js/get-value recv {:js/str method})\n        recv\n        (reduce (fn [acc a] (list 'js/vconj acc a)) [] args)))\n\n\n(def ^:private str-cases\n  \"[form expected]: strings, S1.\"\n  [['(js/mk-str [72 105]) {:js/str \"Hi\"}]\n   ['(js/mk-str [55357]) {:js/units [55357]}]\n   ['(js/mk-str [55357 56832]) {:js/str \"😀\"}]\n   ['(js/mk-str []) {:js/str \"\"}]\n   ['(js/str-concat {:js/units [55357]} {:js/units [56832]})\n    {:js/str \"😀\"}]\n   ['(js/str-concat {:js/str \"a\"} {:js/units [55357]}) {:js/units [97 55357]}]\n   ['(js/str-concat {:js/str \"a\"} {:js/str \"b\"}) {:js/str \"ab\"}]\n   ['(js/str-unit-length {:js/str \"😀\"}) 2]\n   ['(js/str-unit-length {:js/units [55357]}) 1]\n   ['(js/str-unit-at {:js/str \"😀\"} 1) 56832]\n   ['(js/str-slice {:js/str \"😀\"} 0 1) {:js/units [55357]}]\n   ['(js/str-slice {:js/str \"abc\"} 1 3) {:js/str \"bc\"}]\n   ['(js/str-compare {:js/str \"a\"} {:js/str \"b\"}) -1]\n   ['(js/str-compare {:js/str \"b\"} {:js/str \"a\"}) 1]\n   ['(js/str-compare {:js/str \"ab\"} {:js/str \"a\"}) 1]\n   ['(js/str-compare {:js/str \"a\"} {:js/str \"a\"}) 0]\n   ;; by code unit, not code point: U+FFFF sorts after a surrogate pair\n   ['(js/str-compare (js/mk-str [65535]) (js/mk-str [55357 56832])) 1]\n   ['(js/to-string {:n 1}) {:js/str \"1\"}]\n   ['(js/to-string 12) {:js/str \"12\"}]\n   ['(js/to-string true) {:js/str \"true\"}]\n   ['(js/to-string :js/undefined) {:js/str \"undefined\"}]\n   ['(js/to-string :js/null) {:js/str \"null\"}]\n   ['(js/typeof {:n 1}) {:js/str \"number\"}]\n   ['(js/typeof 1) {:js/str \"bigint\"}]\n49:   Runtime state is allocated by `js/init!`, once per task, under\n50:   `js.rt/*` keys (`js.rt/state` is the literal :js/uninit until `js/init!`\n765:    [js/strict-eq\n804:           (js/strict-eq a b)\n810:               (js/strict-eq a (js/to-number b))\n812:                 (js/strict-eq (js/to-number a) b)\n1793:    [js/global-get\n1835:    [js/run-main\n2863:                            js/strict-eq\n3148:           (if (if (= it :js/hole) false (js/strict-eq it x))\n4018:  \"`js/init!`'s body: the context and out cells, the prototypes in\n4138:   every prelude function, the literal state slot, then `js/init!`.\n4145:        [['js.rt/state :js/uninit] ['js/init! (init-form)]]))\n4176:   allocated by `js/init!`.\"\n4177:  (u/then functions-uast (u/sexp->uast '(js/init!))))\n4190:  \"Every key `js/init!` allocates, the ready flag aside, sorted.\"\nbce0e454 feat(yang.typescript): T3 S10 — the linked publication and the cross-unit Error acceptance\ndf6abeb9 merge: origin/master — the yang.call S1 TS wiring reconciled with the T3 class machinery\n63674368 merge: J6e the websocket host adapter over the pump (jolt-j6e, clean rebuild on the repaired master)\n878a1f11 fix(jolt): drop the rebase marker left in the ws probe's header comment\n      (and (<= 3 c)\n           (p/rule? k0 \"singleExpression\")\n           (p/rule? (peek ks) \"singleExpression\")\n           (every? p/token? (butlast (rest ks))))\n      (lower-binary ctx n ks)\n      :else (default-arm n))))\n\n\n(defn- lower-named\n  \"`lower-expr` with function-name hint `nm` for an anonymous function.\"\n  [ctx n nm]\n  (let [ks (kids ctx n)]\n    (cond\n      (and (= 1 (count ks)) (p/rule? (first ks) \"anonymousFunction\"))\n      (let [f (first (kids ctx (first ks)))]\n        (if (p/rule? f \"functionDeclaration\")\n          (lower-expr ctx n)\n          (function-node ctx (first ks) nm)))\n      (and (p/token? (first ks) \"class\")\n           (nil? (first (rules ctx n \"identifier\"))))\n      (lower-class ctx n nm)\n      :else (lower-expr ctx n))))\n\n\n(defn- lower-seq\n  \"The node of an `expressionSequence`: comma sequencing.\"\n  [ctx n]\n  (u/seq-nodes (mapv #(lower-expr ctx %) (rules ctx n \"singleExpression\"))))\n\n\n;; =============================================================================\n;; Statements\n;; =============================================================================\n\n(declare lower-stmt lower-block)\n\n\n(defn statements-of\n  \"The `statement` nodes below a program, function body, block or case\n   clause.\"\n  [ctx n]\n  (let [holder (or (first (rules ctx n \"sourceElements\"))\n                   (first (rules ctx n \"statementList\")))]\n    (if holder\n      (mapv (fn [el]\n              (if (p/rule? el \"sourceElement\")\n(ns yang.core.module\n  \"Module emitter machinery shared by every language frontend\n   (docs/design/yang.typescript.md §17, lift L3): the linker module naming\n   rule, the `require` and wide-application tree nodes, free-name\n   declaration over a host registry, and the `module-spec` and SCC bundle\n   shapes `yin.vm.linker.publish/publish-module!` takes. A language supplies\n   its prefix, its runtime module and its module AST; nothing here knows a\n   source language.\"\n  (:require\n    [clojure.string :as str]\n    [yang.core.prelude :as prelude]\n    [yang.core.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.module :as module]))\n\n\n(defn module-symbol\n  \"The linker module name of source module `name` under language `prefix`\n   (\\\"py\\\", \\\"php\\\", \\\"js\\\"): `<prefix>m.` then the name with each dot a `$`,\n   so no linker module name is a dotted prefix of another.\"\n  [prefix name]\n  (symbol (str prefix \"m.\" (str/replace name \".\" \"$\"))))\n\n\n(defn require-node\n  \"(require 'm) as a tree node.\"\n  [m]\n  (u/sexp->uast (list 'require (list 'quote m))))\n\n\n(defn module-tree\n  \"A wide application: all definitions remain at module level.\"\n  [operands]\n  (prelude/wide-app operands))\n\n\n(defn declare-free-name\n  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n   when `covered` (the requirement-pinned module names) covers it. A name\n   no `vm/primitives` profile or host export supplies throws, with\n   `refusal` under `refusal-key` in its data.\"\n  [refusal-key refusal registry covered n]\n  (if (and (symbol? n) (some? (namespace n))\n           (contains? covered (symbol (namespace n))))\n    nil\n    (if-let [profile (vm/profile-of vm/primitives n)]\n      [n profile]\n      (if-let [address (module/host-export-profile registry n)]\n        (let [entry (module/module-entry (:modules registry)\n                                         (symbol (namespace n)))\n              f (get-in entry [:slice (symbol (name n))])]\n          [n {:yin.k/profile address,\n              :yin.k/effects\n              (get (:callable-effects registry) f #{})}])\n        (throw (ex-info \"the module reads an undeclared name\"\n                        {refusal-key refusal, :name n}))))))\n\n\n(defn free-primitives\n  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n  [refusal-key refusal registry covered ast]\n  (let [free (remove (conj (prelude/defined-keys ast) 'yin/def)\n                     (prelude/free-names ast))]\n    (into {}\n          (keep (partial declare-free-name refusal-key refusal registry covered))\n          (sort-by str free))))\n\n\n(defn module-spec\n  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n   ({module-symbol address}). A free name under a required module is covered\n   by it; any other is declared as `declare-free-name` does.\"\n  [refusal-key refusal registry\n   {:keys [name ast exports runtime-name runtime-address deps]}]\n  (let [requires (into {runtime-name runtime-address} deps)]\n    {:name name,\n     :ast ast,\n     :exports exports,\n     :requires requires,\n     :primitives (free-primitives refusal-key refusal registry\n                                  (set (keys requires)) ast)}))\n\n\n(defn alias-spec\n  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n   `body-key` exports.\"\n  [name exports require-profile bundle-name spec-key body-key]\n  {:name name,\n   :exports exports,\n   :primitives {'require require-profile},\n   :ast (module-tree\n          [(require-node bundle-name)\n           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n\n\n(defn scc-module-specs\n  \"The SCC publication shape: the `bundle` spec first, then the member alias\n   specs (each `alias-spec`'s output) in member order.\"\n  [bundle aliases]\n  (into [bundle] aliases))\n","exit_code":0,"status":"completed"}}
