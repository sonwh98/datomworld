 149\\\\\\\\t          (update :diag (fn [ds] (mapv (fn [[errno msg]] [errno (norm msg)]) ds)))\\\\\\\\n   150\\\\\\\\t          (update :uncaught #(some-> % (update :message norm)))))))\\\\\\\\n   151\\\\\\\\t\\\\\\\\n   152\\\\\\\\t\\\\\\\\n   153\\\\\\\\t(defn check-fixture\\\\\\\\n   154\\\\\\\\t  \\\\\\\\\\\\\\\"Run `fixture` in temporary directory `dir` and return a check record.\\\\\\\\\\\\\\\"\\\\\\\\n   155\\\\\\\\t  [dir {:keys [id source units out diag uncaught departure gap oracle], :as fixture}]\\\\\\\\n   156\\\\\\\\t  (let [file (str (name id) \\\\\\\\\\\\\\\".php\\\\\\\\\\\\\\\")]\\\\\\\\n   157\\\\\\\\t    (when-not units (write-source! dir file source))\\\\\\\\n   158\\\\\\\\t    (let [actual (if units (unit-actual dir fixture) (run-php-file dir file))\\\\\\\\n   159\\\\\\\\t          expected-out (cond departure (:zend departure)\\\\\\\\n   160\\\\\\\\t                             gap \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n   161\\\\\\\\t                             :else out)\\\\\\\\n   162\\\\\\\\t          expected-diag (vec (cond departure (:zend-diag departure)\\\\\\\\n   163\\\\\\\\t                                   gap []\\\\\\\\n   164\\\\\\\\t                                   :else (or diag [])))\\\\\\\\n   165\\\\\\\\t          expected-uncaught (cond departure (:zend-uncaught departure)\\\\\\\\n   166\\\\\\\\t                                  gap nil\\\\\\\\n   167\\\\\\\\t                                  :else uncaught)\\\\\\\\n   168\\\\\\\\t          pass? (and (not= :pending oracle)\\\\\\\\n   169\\\\\\\\t                     (= expected-out (:out actual))\\\\\\\\n   170\\\\\\\\t                     (= expected-diag (:diag actual))\\\\\\\\n   171\\\\\\\\t                     (= expected-uncaught (:uncaught actual)))]\\\\\\\\n   172\\\\\\\\t      {:id id,\\\\\\\\n   173\\\\\\\\t       :pass? pass?,\\\\\\\\n   174\\\\\\\\t       :oracle oracle,\\\\\\\\n   175\\\\\\\\t       :gap gap,\\\\\\\\n   176\\\\\\\\t       :departure depar