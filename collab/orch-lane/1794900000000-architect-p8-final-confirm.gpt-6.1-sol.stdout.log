dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\n                  ;; the conformance compositions) overflow smaller stacks in\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n                  ;; the 4m minimum for the prelude recursion rows still holds)\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n     1\t(ns yang.php.antlr.builtin-surfaces-test\n     2\t  \"P9 builtin surfaces, dynamic scopes, and corner closures.\"\n     3\t  (:require\n     4\t    [clojure.test :refer [deftest is testing]]\n     5\t    [yang.php.antlr.e2e-harness :as h]\n     6\t    [yang.php.antlr.programs-p9 :as p9]))\n     7\t\n     8\t\n     9\t(deftest p9-fixtures-test\n    10\t  (doseq [{:keys [id source out diag]} p9/fixtures]\n    11\t    (testing (name id)\n    12\t      (let [r (h/run-raw source)]\n    13\t        (is (= out (:php/out r)))\n    14\t        (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))))\n    15\t        (is (nil? (:php/uncaught r)))))))\n    16\t\n    17\t\n    18\t(deftest p9-contracts-test\n    19\t  (let [out (fn [source] (:php/out (h/run-raw source)))\n    20\t        diag (fn [source] (mapv (juxt :errno :message) (:php/diag (h/run-raw source))))]\n    21\t    (testing \"empty search returns the subject, never empty output\"\n    22\t      (is (= \"a\" (out \"<?php echo str_replace('', 'x', 'a');\")))\n    23\t      (is (= \"a\" (out \"<?php echo str_ireplace('', 'x', 'a');\"))))\n    24\t    (testing \"search/replacement/subject arrays and the count output\"\n    25\t      (is (= \"x x x\" (out \"<?php echo str_replace(['a', 'b'], 'x', 'a b a');\")))\n    26\t      (is (= \"Xb\" (out \"<?php echo str_ireplace('A', 'X', 'ab');\")))\n    27\t      (is (= \"bb2\" (out \"<?php $c = 0; echo str_replace('a', 'b', 'aa', $c), $c;\")))\n    28\t      (is (= \"ay|by\" (out \"<?php echo implode('|', str_replace('x', 'y', ['ax', 'bx']));\"))))\n    29\t    (testing \"str_pad never truncates; empty pad with work to do is a ValueError\"\n    30\t      (is (= \"abcd\" (out \"<?php echo str_pad('abcd', 2);\")))\n    31\t      (is (= \"x  \" (out \"<?php echo str_pad('x', 3);\")))\n    32\t      (is (= \"-x--\" (out \"<?php echo str_pad('x', 4, '-', STR_PAD_BOTH);\")))\n    33\t      (is (= \"ValueError\" (out \"<?php try { str_pad('x', 3, ''); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    34\t    (testing \"strrpos offsets bound the search\"\n    35\t      (is (= \"3\" (out \"<?php echo strrpos('hello', 'l', 3);\")))\n    36\t      (is (= \"\" (out \"<?php echo strrpos('hello', 'l', 4);\")))\n    37\t      (is (= \"3\" (out \"<?php echo strrpos('hello', 'l', -2);\")))\n    38\t      (is (= \"ValueError\" (out \"<?php try { strrpos('hello', 'l', 6); } catch (ValueError $e) { echo 'ValueError'; }\")))\n    39\t      (is (= \"ValueError\" (out \"<?php try { strrpos('hello', 'l', -6); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    40\t    (testing \"trim character masks with ranges\"\n    41\t      (is (= \"a\" (out \"<?php echo trim('xxaxx', 'x');\")))\n    42\t      (is (= \"def\" (out \"<?php echo trim('abcdef', 'a..c');\"))))\n    43\t    (testing \"single-array array_map keeps keys; multi-array is variadic\"\n    44\t      (is (= \"a,b\" (out \"<?php echo implode(',', array_keys(array_map(fn($x) => $x * 2, ['a' => 1, 'b' => 2])));\")))\n    45\t      (is (= \"11,22\" (out \"<?php echo implode(',', array_map(fn($a, $b) => $a + $b, [1, 2], [10, 20]));\")))\n    46\t      (is (= \"b\" (out \"<?php $r = array_map(null, [1, 2], ['a', 'b']); echo $r[1][1];\"))))\n    47\t    (testing \"array_unique dispatches on the flag: regular is loose, string is strict\"\n    48\t      (is (= \"1.0\" (out \"<?php echo implode(',', array_unique(['1.0', '1']));\")))\n    49\t      (is (= \"1.0,1\" (out \"<?php echo implode(',', array_unique(['1.0', '1'], SORT_STRING));\")))\n    50\t      (is (= \"1.0\" (out \"<?php echo implode(',', array_unique(['1.0', '1'], SORT_NUMERIC));\"))))\n    51\t    (testing \"diff/intersect take further arrays\"\n    52\t      (is (= \"1,4\" (out \"<?php echo implode(',', array_diff([1, 2, 3, 4], [2], [3]));\")))\n    53\t      (is (= \"3\" (out \"<?php echo implode(',', array_intersect([1, 2, 3], [2, 3], [3, 4]));\"))))\n    54\t    (testing \"diff/intersect compare as strings\"\n    55\t      (is (= \"1.0\" (out \"<?php echo implode(',', array_diff(['1.0'], ['1']));\")))\n    56\t      (is (= \"\" (out \"<?php echo implode(',', array_intersect(['1.0'], ['1']));\"))))\n    57\t    (testing \"array_splice normalizes bounds; omitted replacement removes\"\n    58\t      (is (= \"1,3|2\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1); echo implode(',', $a), '|', implode(',', $r);\")))\n    59\t      (is (= \"1,2|3\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, -1); echo implode(',', $a), '|', implode(',', $r);\"))))\n    60\t    (testing \"array_splice drops replacement string keys; null replaces with nothing\"\n    61\t      (is (= \"1,8,9,3|2\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1, ['x' => 8, 9]); echo implode(',', $a), '|', implode(',', $r);\")))\n    62\t      (is (= \"1,3|2\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1, null); echo implode(',', $a), '|', implode(',', $r);\"))))\n    63\t    (testing \"range with a zero step is a ValueError, not a hang\"\n    64\t      (is (= \"ValueError\" (out \"<?php try { range(1, 3, 0); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    65\t    (testing \"JSON escapes control bytes instead of replacing them\"\n    66\t      (is (= \"\\\"\\\\u0001\\\"\" (out \"<?php echo json_encode(\\\"\\\\x01\\\");\"))))\n    67\t    (testing \"JSON rejects trailing commas, bad escapes and unchecked separators\"\n    68\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('[1,]'));\")))\n    69\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('\\\"\\\\\\\\q\\\"'));\")))\n    70\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('{\\\"a\\\" 4}'));\"))))\n    71\t    (testing \"JSON enforces depth and JSON_THROW_ON_ERROR\"\n    72\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('[[1]]', true, 1));\")))\n    73\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('[1]', true, 1));\")))\n    74\t      (is (= \"threw\" (out \"<?php try { json_decode('[1,]', null, 512, JSON_THROW_ON_ERROR); } catch (JsonException $e) { echo 'threw'; }\")))\n    75\t      (is (= \"threw\" (out \"<?php try { json_encode(INF, JSON_THROW_ON_ERROR); } catch (JsonException $e) { echo 'threw'; }\")))\n    76\t      (is (= \"bool(false)\\n\" (out \"<?php var_dump(json_encode(INF));\"))))\n    77\t    (testing \"JSON rejects a leading plus, raw controls, bad depth and bad flags\"\n    78\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('+1'));\")))\n    79\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode(\\\"\\\\\\\"\\\\x01\\\\\\\"\\\"));\")))\n    80\t      (is (= \"refused\" (out \"<?php try { json_encode([1], 64); } catch (Error $e) { echo 'refused'; }\")))\n    81\t      (is (= \"refused\" (out \"<?php try { json_decode('[1]', true, 512, 64); } catch (Error $e) { echo 'refused'; }\")))\n    82\t      (is (= \"ValueError\" (out \"<?php try { json_encode([1], 0, 0); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    83\t    (testing \"a nested encoding failure warns and answers false, never a host error\"\n    84\t      (is (= \"bool(false)\\n\" (out \"<?php var_dump(json_encode([INF]));\")))\n    85\t      (is (= [[2 \"Inf and NaN cannot be JSON encoded\"]]\n    86\t             (diag \"<?php $x = json_encode([INF]);\")))\n    87\t      (is (= \"threw\" (out \"<?php try { json_encode([INF], JSON_THROW_ON_ERROR); } catch (JsonException $e) { echo 'threw'; }\"))))\n    88\t    (testing \"EXTR constants match PHP and every mode imports per PHP\"\n    89\t      (is (= \"4,5,6,7\" (out \"<?php echo EXTR_PREFIX_INVALID, ',', EXTR_PREFIX_IF_EXISTS, ',', EXTR_IF_EXISTS, ',', EXTR_PREFIX_ONLY_IF_EXISTS;\")))\n    90\t      (is (= \"6\" (out \"<?php extract(['z' => 6], EXTR_PREFIX_ALL, 'p_'); echo $p__z;\")))\n    91\t      (is (= \"12\" (out \"<?php $x = 1; extract(['x' => 2], EXTR_PREFIX_SAME, 'p'); echo $x, $p_x;\")))\n    92\t      (is (= \"34\" (out \"<?php $x = 3; extract(['x' => 4], EXTR_PREFIX_IF_EXISTS, 'p'); echo $x, $p_x;\")))\n    93\t      (is (= \"5\" (out \"<?php $n = extract(['0' => 5], EXTR_PREFIX_INVALID, 'p'); echo $p_0;\")))\n    94\t      (is (= \"5\" (out \"<?php $n = extract(['0' => 5], EXTR_PREFIX_ALL, 'p'); echo $p_0;\")))\n    95\t      (is (= \"6\" (out \"<?php $n = extract(['z' => 6], EXTR_PREFIX_ALL, ''); echo $_z;\")))\n    96\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], 8); } catch (ValueError $e) { echo 'ValueError'; }\")))\n    97\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], EXTR_PREFIX_SAME); } catch (ValueError $e) { echo 'ValueError'; }\")))\n    98\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], EXTR_PREFIX_SAME, '9x'); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    99\t    (testing \"extract uses binding existence and compact warns on missing names\"\n   100\t      (is (= \"null-kept\" (out \"<?php $x = null; extract(['x' => 4], EXTR_SKIP); echo $x === null ? 'null-kept' : $x;\")))\n   101\t      (is (= [[2 \"compact(): Undefined variable $nope\"]]\n   102\t             (diag \"<?php $a = compact('nope');\")))\n   103\t      (is (= [[2 \"compact(): Each argument must be a string or an array of strings\"]]\n   104\t             (diag \"<?php $a = compact(1);\"))))\n   105\t    (testing \"namespaced user functions shadow extract/compact builtins\"\n   106\t      (is (= \"7\" (out \"<?php namespace N; function extract($a) { return 7; } echo extract([1]);\")))\n   107\t      (is (= \"9\" (out \"<?php namespace N; function compact($a) { return 9; } echo compact('x');\"))))))\n   108\t\n   109\t\n   110\t(deftest p9-compile-refusals-test\n   111\t  (doseq [[source reason]\n   112\t          [[\"<?php eval('$x = 1;');\" :eval]\n   113\t           [\"<?php $x = 1; $n = 'x'; $$n =& $x;\" :dynamic-reference]\n   114\t           [\"<?php [[&$a]] = [[1]];\" :yang.php/compile-error]\n   115\t           [\"<?php $GLOBALS = [];\" :yang.php/compile-error]\n   116\t           [\"<?php unset($GLOBALS);\" :yang.php/compile-error]]]\n   117\t    (testing reason\n   118\t      (let [{:keys [diagnostics]} (h/lower-program source)\n   119\t            d (first diagnostics)]\n   120\t        (is (seq diagnostics))\n   121\t        (is (= reason (or (:construct d) (:yang.php/diagnostic d))))))))\n","exit_code":0,"status":"completed"}}
