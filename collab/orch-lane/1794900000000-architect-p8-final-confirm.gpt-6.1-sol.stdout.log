\\\\\\\"segment/\\\\\\\\\\\\\\\")))\\\\\\\\n                     :hex (when (seq hex) (apply str hex))}]))\\\\\\\\n          blocks)))\\\\\\\\n\\\\\\\\n\\\\\\\\n(def ^:private file* (delay (read-file)))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn fixture\\\\\\\\n  \\\\\\\\\\\\\\\"Fixture n's pinned address and its bytes: an anchor's from the file,\\\\\\\\n   non-canonical's patched from the successor anchor's, every other built\\\\\\\\n   from its pack.\\\\\\\\\\\\\\\"\\\\\\\\n  [n]\\\\\\\\n  (let [{:keys [address hex]} (get @file* n)\\\\\\\\n        anchor (fn [a] (fx/hex->bytes (:hex (get @file* a))))]\\\\\\\\n    {:address address\\\\\\\\n     :bytes (cond\\\\\\\\n              (some? hex) (fx/hex->bytes hex)\\\\\\\\n              (= \\\\\\\\\\\\\\\"non-canonical\\\\\\\\\\\\\\\" n) (patch-non-canonical (anchor \\\\\\\\\\\\\\\"successor\\\\\\\\\\\\\\\"))\\\\\\\\n              :else (cbor/encode (pack-of n)))}))\\\\\\\\ntest/yin/vm/ucf/ledger_test.cljc:122:  (testing \\\\\\\\\\\\\\\"a target this ledger did not mint at that t\\\\\\\\\\\\\\\"\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:1:(ns yin.vm.ucf.ledger-fixtures\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:2:  \\\\\\\\\\\\\\\"The cross-host ledger fixture of M-next C slice C12: one arbitration\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:6:   The pins live in test/resources/yin/vm/ucf/ledger-v2.txt: a first\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:15:   version-3 row packs (yin.vm.ucf.rows-checkpoint-fixtures), each stored\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:22:            [dao.jing.cbor-fixtures :as cfx]\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:33:            [yin.vm.ucf.rows-checkpoint-fixtures :as fx]\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:38:  \\\\\\\\\\\\\\\"The fixture file, relative to the repository root.\\\\\\\\\\\\\\\"\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:39:  \\\\\\\\\\\\\\\"test/resources/yin/vm/ucf/ledger-v2.txt\\\\\\\\\\\\\\\")\\\\\\\\ntest/yin/vm/ucf/ledger_fixtures.cljc:245: