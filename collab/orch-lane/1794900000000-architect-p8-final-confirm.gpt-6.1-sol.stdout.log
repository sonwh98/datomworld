5\\\\t    (is (= {:js/out [\\\\\\\"42n\\\\\\\"], :js/uncaught nil}\\\\n   166\\\\t           (xl/call [:clojure\\\\n   167\\\\t                     \\\\\\\"(defn probe [] ({:type :cell-ref :id :customer :seal \\\\\\\\\\\\\\\"wax\\\\\\\\\\\\\\\" :marker 42} :marker))\\\\\\\"]\\\\n   168\\\\t                    [\\\\\\\"probe\\\\\\\"]\\\\n   169\\\\t                    [:typescript \\\\\\\"console.log(probe());\\\\\\\"]))))\\\\n   170\\\\t  (testing \\\\\\\"a full-shape three-entry map with a valid-format 64-char seal is ordinary invocable data\\\\\\\"\\\\n   171\\\\t    ;; The exact issued format \\u2014 three entries, a seal string of the issued\\\\n   172\\\\t    ;; length \\u2014 with an :id the engine's heap could never have minted (heap\\\\n   173\\\\t    ;; ids are :cell-N keywords): the map can never be a reference, so the\\\\n   174\\\\t    ;; invocation is the map lookup and answers the stored seal string,\\\\n   175\\\\t    ;; where the shape gates of the previous rounds routed it to admission\\\\n   176\\\\t    ;; and the dereference refused the VM.\\\\n   177\\\\t    (is (= {:js/out [(str \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\" (apply str (repeat 64 \\\\\\\"a\\\\\\\")) \\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\")], :js/uncaught nil}\\\\n   178\\\\t           (xl/call [:clojure\\\\n   179\\\\t                     (str \\\\\\\"(defn probe [] ({:type :cell-ref :id :some-key \\\\\\\"\\\\n   180\\\\t                          \\\\\\\":seal \\\\\\\\\\\\\\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\\\\\\\\\\\\\"} :seal))\\\\\\\")]\\\\n   181\\\\t                    [\\\\\\\"probe\\\\\\\"]\\\\n   182\\\\t                    [:typescript \\\\\\\"console.log(probe());\\\\\\\"]))))\\\\n   183\\\\t  (testing \\\\\\\"a runtime-built full-shape map (assoc-constructed, not a bound literal) invokes as data\\\\\\\"\\\\n   184\\\\t    ;; The map is assembled by assoc at runtime, so no literal ever holds\\\\n   185\\\\t    ;; it; the shape test runs on the constructed