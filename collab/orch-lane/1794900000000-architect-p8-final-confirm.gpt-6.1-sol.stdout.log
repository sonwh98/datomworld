 :id id}))\\\\\\\\n   328\\\\\\\\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\\\\\\\\n   329\\\\\\\\t\\\\\\\\n   330\\\\\\\\t\\\\\\\\n   331\\\\\\\\t(defn authentic-ref?\\\\\\\\n   332\\\\\\\\t  \\\\\\\\\\\\\\\"True when `ref` is a `kind` reference this task issued: its seal\\\\\\\\n   333\\\\\\\\t   verifies under the task's secret, and it names a live resource of that\\\\\\\\n   334\\\\\\\\t   kind. A `:cell-ref` is checked against `:heap` instead: its id is live\\\\\\\\n   335\\\\\\\\t   by `contains?` (a cell may hold nil) and its seal equals the one the\\\\\\\\n   336\\\\\\\\t   heap entry recorded at allocation, so no hash is computed per access.\\\\\\\\\\\\\\\"\\\\\\\\n   337\\\\\\\\t  [state kind ref]\\\\\\\\n   338\\\\\\\\t  (let [secret (:capability-secret state)\\\\\\\\n   339\\\\\\\\t        id (when (map? ref) (:id ref))]\\\\\\\\n   340\\\\\\\\t    (if (= :cell-ref kind)\\\\\\\\n   341\\\\\\\\t      (let [heap (:heap state)]\\\\\\\\n   342\\\\\\\\t        (boolean (and (some? secret)\\\\\\\\n   343\\\\\\\\t                      (= kind (:type ref))\\\\\\\\n   344\\\\\\\\t                      (contains? heap id)\\\\\\\\n   345\\\\\\\\t                      (= (:seal ref) (:seal (get heap id))))))\\\\\\\\n   346\\\\\\\\t      (let [resource (get (:resources state) id)]\\\\\\\\n   347\\\\\\\\t        (boolean (and (some? secret)\\\\\\\\n   348\\\\\\\\t                      (= kind (:type ref))\\\\\\\\n   349\\\\\\\\t                      (some? resource)\\\\\\\\n   350\\\\\\\\t                      (= (:seal ref) (seal-of secret kind id))\\\\\\\\n   351\\\\\\\\t                      (= (= :cursor-ref kind) (cursor-cell? resource))))))))\\\\\\\\n   352\\\\\\\\t\\\\\\\\n   353\\\\\\\\t\\\\\\\\n   354\\\\\\\\t(defn check-ref!\\\\\\\\n   355\\\\\\\\t  \\\\\\\\\\\\\\\"The resource id a program-supplied `kind` reference names, once its\\\\\\\\n   356\\\\\\\\t   seal verifies (r10). Anything else fails closed with\\\\\\\\n   357\\\\\\\\t   `:forged-resource-reference`, naming the effect and the id it named;\\\\\\\\n   358\\\\\\\\t   a cell ref whose id the heap does not hold is\\\\\\\\n   359\\\\\\\\t   `:dead-or-forged-reference` instead: its cell was swept, or never was.\\\\\\\\n   360\\\\\\\\t   Ids are never reused, so such a ref is never silently reallocated.\\\\\\\\\\\\\\\"\\\\\\\\n   361\\\\\\\\t  [state effect-kind kind ref]\\\\\\\\n   362\\\\\\\\t  (if (authentic-ref? state kind ref)\\\\\\\\n   363\\\\\\\\t    (:id ref)\\\\\\\\n   364\\\\\\\\t    (let [id (when (map? ref) (:id ref))\\\\\\\\n   365\\\\\\\\t          dead? (and (= :cell-ref kind) (not (contains? (:heap state) id)))]\\\\\\\\n   366\\\\\\\\t      (fail (if dead? \\\\\\\\\\\\\\\"Dead or forged cell reference\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"Forged resource reference\\\\\\\\\\\\\\\")\\\\\\\\n   367\\\\\\\\t            {:reason (if dead?\\\\\\\\n   368\\\\\\\\t                       :dead-or-forged-reference\\\\\\\\n   369\\\\\\\\t                       :forged-resource-reference),\\\\\\\\n   370\\\\\\\\t             :effect effect-kind,\\\\\\\\n   371\\\\\\\\t             :kind kind,\\\\\\\\n   372\\\\\\\\t             :id id}))))\\\\\\\\n   373\\\\\\\\t\\\\\\\\n   374\\\\\\\\t\\\\\\\\n   375\\\\\\\\t(declare gensym)\\\\\\\\n   376\\\\\\\\t\\\\\\\\n   377\\\\\\\\t\\\\\\\\n   378\\\\\\\\t(defn attach-resource\\\\\\\\n   379\\\\\\\\t  \\\\\\\\\\\\\\\"Install the host stream `handle` a composition hands a task under a\\\\\\\\n  2710\\\\\\\\t              {:state (:state result),\\\\\\\\n  2711\\\\\\\\t               :value (:value result),\\\\\\\\n  2712\\\\\\\\t               :blocked? false}))\\\\\\\\n  2713\\\\\\\\t          :stream/close\\\\\\\\n  2714\\\\\\\\t          (let [_ (gate-refuse! state effect)\\\\\\\\n  2715\\\\\\\\t                close-result (handle-close state effect)]\\\\\\\\n  2716\\\\\\\\t            {:state (:state close-result), :value nil, :blocked? false})\\\\\\\\n  2717\\\\\\\\t          ;; `:heap` is VM state, not