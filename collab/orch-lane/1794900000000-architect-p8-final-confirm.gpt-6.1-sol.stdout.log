ined-function failure). Needs per-case budgeting, an engine perf pass on long str_repeat loops, or a documented bound. Not a guest-semantics gap.\\\"}\\ndbe9e072:test/yang/php/antlr/phpt_quick_mismatch_manifest.edn:63:  {:id \\\"Zend/tests/bug63055.phpt\\\",\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1794820000000-architect-confirm3.gpt-6.1-sol.stdout.log:75:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_37\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"/Library/Developer/CommandLineTools/usr/bin/git show dbe9e072:src/cljc/yang/php/antlr/prelude_p9.cljc | nl -ba | sed -n '1,165p'\\\"\",\"aggregated_output\":\"     1\\t(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\\n     2\\t yang.php.antlr.prelude-p9\\n     3\\t  \\\"P9 string, array, JSON and math builtins, written as guest code.\\\"\\n     4\\t  (:require\\n     5\\t    [yang.php.antlr.quoted :refer [defquoted]]))\\n     6\\t\\n     7\\t\\n     8\\t(defquoted ^:private forms\\n     9\\t  \\\"P9 definitions in dependency order.\\\"\\n    10\\t  '[[php/p9-string\\n    11\\t     (fn [v] (php/to-string v))]\\n    12\\t    [php/p9-substr\\n    13\\t     (fn [s start length]\\n    14\\t       (let [n (data/str-length s)\\n    15\\t             a (if (< start 0) (if (> (+ n start) 0) (+ n start) 0) start)\\n    16\\t             a (if (> a n) n a)\\n    17\\t             b (if (= length :php/null)\\n    18\\t                 n\\n    19\\t                 (if (< length 0) (+ n length) (+ a length)))\\n    20\\t             b (if (< b a) a (if (> b n) n b))]\\n    21\\t         (if (>= a n) \\\"\\\" (data/substring s a b))))]\\n    22\\t    [php/bi-substr\\n    23\\t     (fn [args]\\n    24\\t       (do (php/arity-between \\\"substr\\\" args 2 3 \\\"at least 2\\\")\\n    25\\t           (php/p9-substr (php/p9-string (get args 0)) (php/to-int (get args 1))\\n    26\\t                          (php/arg-or args 2 :php/null))))]\\n    27\\t