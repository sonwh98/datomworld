        ;; task could have minted and the map\\\\n  2258\\\\t                                    ;; is data. Data falls to the witness\\\\n  2259\\\\t                                    ;; branch and, entryless, is no more\\\\n  2260\\\\t                                    ;; admitted than any other source map,\\\\n  2261\\\\t                                    ;; so its invocation stays ordinary\\\\n  2262\\\\t                                    ;; map data. A candidate that passes\\\\n  2263\\\\t                                    ;; with a wrong seal is a capability\\\\n  2264\\\\t                                    ;; counterfeit: `cell/get` fails\\\\n  2265\\\\t                                    ;; closed in the VM and grants\\\\n  2266\\\\t                                    ;; nothing \\u2014 authenticity is the VM's\\\\n  2267\\\\t                                    ;; heap+seal check, never a shape.\\\\n  2268\\\\t                                    (let [dsg__cell-ref?\\\\n  2269\\\\t                                          (if (dsg__equal\\\\n  2270\\\\t                                                (dsg__get dsg__candidate :type)\\\\n  2271\\\\t                                                :cell-ref)\\\\n  2272\\\\t                                            (if (data/contains? dsg__candidate\\\\n  2273\\\\t                                                                :id)\\\\n  2274\\\\t                                              (if (data/contains? dsg__candidate\\\\n  2275\\\\t                                                                  :seal)\\\\n  2276\\\\t                                                (if (dsg__equal\\\\n  2277\\\\t                                                      (data/count dsg__candidate)\\\\n  2278\\\\t                                                      3)\\\\n  2279\\\\t                                                  (if (data/string?\\\\n  2280\\\\t                                                        (dsg__get dsg__candidate\\\\n  2281\\\\t                                                                  :seal))\\\\n  2282\\\\t                                                    (if (dsg__equal\\\\n  2283\\\\t                                                          (data/str-length\\\\n  2284\\\\t                                                            (dsg__get dsg__candidate\\\\n  2285\\\\t                                                                      :seal))\\\\n  2286\\\\t                                                          64)\\\\n  2287\\\\t                                                      (if (kind/keyword?\\\\n  2288\\\\t                                                            (dsg__get dsg__candidate\\\\n  2289\\\\t                                                                      :id))\\\\n  2290\\\\t                                                        (dsg__equal\\\\n  2291\\\\t                                                          (data/str-index-of\\\\n  2292\\\\t                                                            (kind/name\\\\n  2293\\\\t                                                              (dsg__get dsg__candidate\\\\n  2294\\\\t                                                                        :id))\\\\n  2295\\\\t                                                            \\\\\\\"cell-\\\\\\\")\\\\n  2296\\\\t                                                          0)\\\\n  2297\\\\t                                                        false)\\\\n  2298\\\\t                                                      false)\\\\n  2299\\\\t                                                    false)\\\\n  2300\\\\t                                                  false)\\\\n  2301\\\\t                                                false)\\\\n  2302\\\\t                                              false)\\\\n  2303\\\\t                                            false)]\\\\n  2304\\\\t                                      (if dsg__cell-ref?\\\\n  2305\\\\t                                        (let [dsg__descriptor\\\\n  2306\\\\t                                              (cell/get dsg__candidate)\\\\n  2307\\\\t                                              dsg__entry\\\\n  2308\\\\t                                              (dsg__get dsg__descriptor\\\\n  2309\\\\t                                                        :yang.call/entry)]\\\\n  2310\\\\t                                          (data/callable? dsg__entry))\\\\n  2311\\\\t                                        (let [dsg__entry\\\\n  2312\\\\t                                              (dsg__get dsg__candidate\\\\n  2313\\\\t                                                        :yang.call/entry)\\\\n  2314\\\\t                                              dsg__witness\\\\n  2315\\\\t                                              (dsg__get dsg__candidate\\\\n  2316\\\\t                                                        :clj/admission)]\\\\n  2317\\\\t                                          (if (data/callable? dsg__entry)\\\\n  2318\\\\t                                            (if (data/callable? dsg__witness)\\\\n  2319\\\\t                                              (dsg__equal\\\\n  2320\\\\t                                                dsg__witness\\\\n  2321\\\\t                                                (dsg__make_admission\\\\n  2322\\\\t                                                  (dsg__assoc dsg__candidate\\\\n  2323\\\\t                                                              :clj/admission\\\\n  2324\\\\t                                                              nil)))\\\\n  2325\\\\t                                              false)\\\\n  2326\\\\t                                            false))))\\\\n  2327\\\\t                                    false)))\\\\n  2328\\\\t                             ;; The intra-unit dispatcher: resolve the unit's public entry,\\\\n  2329\\\\t                             ;; apply it with the compiler's token packet [token args] - one\\\\n  2330\\\\t                             ;; variadic conj and one application, no record construction.\\\\n  2331\\\\t                             ;; Non-map callees refuse.\\\\n  2332\\\\t                             (u/sexp->uast\\\\n  2333\\\\t                               (list 'fn '[dsg__callee dsg__args]\\\\n  2334\\\\t                                     (list 'if '(data/map? dsg__callee)\\\\n  2335\\\\t                                           (list (list (if (contains? (::defined env) 'get)\\\\n  2336\\\\t                                                         'dsg__get\\\\n  2337\\\\t                                                         'get)\\\\n  2338\\\\t                                                       'dsg__callee\\\\n  2339\\\\t                                                       :yang.call/entry)\\\\n  2340\\\\t                                                 (list 'conj '[]\\\\n  2341\\\\t                                                       'dsg__call_token\\\\n  2342\\\\t                                                       'dsg__args))\\\\n  2343\\\\t                                           '(conj (conj [] :yin.k/error)\\\\n  2344\\\\t                                                  (yang.call/condition\\\\n  2345\\\\t                                                    :yang.call/not-callable\\\\n  2346\\\\t                                                    (dsg__assoc {} :yang.call/callee dsg__callee))))))))\\\\n  2347\\\\t         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\\\\n  2348\\\\t         (outcomes? env) (u/let1\\\\n  2349\\\\t                           'dsg__make_admission\\\\n  2350\\\\t                           (u/sexp->uast\\\\n  2351\\\\t                             '(fn [dsg__descriptor]\\\\n  2352\\\\t                                (fn [dsg__candidate]\\\\n  2353\\\\t                                  (if (data/callable? dsg__call_token)\\\\n  2354\\\\t                                    (dsg__get dsg__descriptor :yang.call/entry)\\\\n  2355\\\\t                                    nil)))))\\\\n  2356\\\\t         (outcomes? env) (u/then\\\\n  2357\\\\t                           (discard-result\\\\n  2358\\\\t                             (u/app (u/lam '[get = assoc empty?] call/uast)\\\\n  2359\\\\t                                    (u/v 'dsg__get) (u/v 'dsg__equal)\\\\n  2360\\\\t                                    (u/v 'dsg__assoc) (u/v 'dsg__empty))))\\\\n  2361\\\\t         (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\\\\n  2362\\\\t         ;; Guest closures keep captured environments portable: binding host\\\\n  2363\\\\t         ;; primitive values here would make UCF machine-data validation fail.\\\\n  2364\\\\t         ;; These helpers cover generated map lookups/writes and comparisons;\\\\n  2365\\\\t         ;; conj/vec are already protected by the convention's binder checks.\\\\n  2366\\\\t         ;; Evaluate siblings outside each other's bindings to avoid retaining\\\\n  2367\\\\t         ;; a chain of redundant helper environments.\\\\n  2368\\\\t         (outcomes? env) (#(u/app\\\\n  2369\\\\t                             (u/lam '[dsg__get dsg__equal dsg__assoc dsg__empty] %)\\\\n  2370\\\\t                             (if (contains? (::defined env) 'get)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\"\n    },\n    {\n      \"severity\": \"P3\",\n      \"category\": \"Debug\",\n      \"file_path\": \"collab/yang-clojure/1794320000000-architect-cell-ref-two-api-ruling.gpt-6-astra.stdout.log\",\n      \"line_number\": 24,\n      \"message\": \"Leftover debug statement detected.\",\n      \"snippet\": \"{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_11\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/yang/cross_lang_test.clj | sed -n '1,290p'; rg -n 'cell-ref|yang.call/(eligible\\\\\\\\\\\\\\\\?|invoke|entry)|defn.*call|\\\\\\\\\\\\\\\\[js/call|\\\\\\\\\\\\\\\\[php/call|\\\\\\\\\\\\\\\\[py/call' src/cljc/yang/typescript/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude_p9.cljc src/cljc/yang/python/antlr/prelude.cljc | head -160; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '350,385p'; rg -n 'cell/get|cell/set|cell/new' src/cljc/yin/vm/cell.cljc\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\t(ns yang.cross-lang-test\\\\n     2\\\\t  \\\\\\\"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\\\\n     3\\\\t   bottom out in `:application`, and the engine neither knows nor cares which\\\\n     4\\\\t   frontend minted a closure. A TypeScript function value is called from\\\\n     5\\\\t   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\\\\n     6\\\\t   task, one run.\\\\n     7\\\\t\\\\n     8\\\\t   The seam is explicit published-export composition (8.10.11), owned by\\\\n     9\\\\t   `yang.call.conformance`: the donor source is published as a module and\\\\n    10\\\\t   run unmodified, its named export is read from the donor runtime's global\\\\n    11\\\\t   namespace (`globalThis.ts_fn`, PHP's `phpfn` function) and projected into the caller\\\\n    12\\\\t   runtime's namespace under the same name, and the caller source runs\\\\n    13\\\\t   unmodified. No call node is rewritten and no foreign `:code` extracted:\\\\n    14\\\\t   the caller holds the donor's own function cell, as the identity check\\\\n    15\\\\t   (`stored === phpfn`) shows.\\\\n    16\\\\t\\\\n    17\\\\t   What is pinned as LIMITS (documented expectations, not failures):\\\\n    18\\\\t   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\\\\n    19\\\\t   PHP null (`:php/null`) is neither JS null nor undefined. Each case runs\\\\n    20\\\\t   linked on the three vector VMs, which must agree.\\\\\\\"\\\\n    21\\\\t  (:require\\\\n    22\\\\t    [clojure.test :refer [deftest is testing]]\\\\n    23\\\\t    [yang.call.conformance :as xl]))\\\\n    24\\\\t\\\\n    25\\\\t\\\\n    26\\\\t(deftest ts-closure-called-from-php-test\\\\n    27\\\\t  (testing \\\\\\\"a number crosses as a number: float in, float out\\\\\\\"\\\\n    28\\\\t    (is (= \\\\\\\"4\\\\\\\"\\\\n    29\\\\t           (xl/call [:typescript \\\\\\\"globalThis.ts_fn = (x, y) => x + y;\\\\\\\"]\\\\n    30\\\\t                    [\\\\\\\"ts_fn\\\\\\\"]\\\\n    31\\\\t                    [:php \\\\\\\"<?php echo ts_fn(1.5, 2.5);\\\\\\\"]))))\\\\n    32\\\\t  (testing \\\\\\\"the PHP caller sees the result as an ordinary value\\\\\\\"\\\\n    33\\\\t    (is (= \\\\\\\"yes\\\\\\\"\\\\n    34\\\\t           (xl/call [:typescript \\\\\\\"globalThis.ts_fn = (x, y) => x + y;\\\\\\\"]\\\\n    35\\\\t                    [\\\\\\\"ts_fn\\\\\\\"]\\\\n    36\\\\t                    [:php \\\\\\\"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\\\\\\\"])))))\\\\n    37\\\\t\\\\n    38\\\\t\\\\n    39\\\\t(deftest php-closure-called-from-ts-test\\\\n    40\\\\t  (testing \\\\\\\"TS stores and calls the same PHP function cell it received\\\\\\\"\\\\n    41\\\\t    (is (= {:js/out [\\\\\\\"true 5\\\\\\\"], :js/uncaught nil}\\\\n    42\\\\t           (xl/call [:php \\\\\\\"<?php function phpfn($a, $b) { return $a + $b; }\\\\\\\"]\\\\n    43\\\\t                    [\\\\\\\"phpfn\\\\\\\"]\\\\n    44\\\\t                    [:typescript\\\\n    45\\\\t                     \\\\\\\"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\\\\\\\"])))))\\\\n    46\\\\t\\\\n    47\\\\t\\\\n    48\\\\t(deftest python-calls-typescript-closure-test\\\\n    49\\\\t  (testing \\\\\\\"TS stores and calls the same Python function cell it received\\\\\\\"\\\\n    50\\\\t    (is (= {:py/out [\\\\\\\"22\\\\\\\"], :py/exception nil}\\\\n    51\\\\t           (xl/call [:typescript\\\\n    52\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n    53\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n    54\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n    55\\\\t                    [:python \\\\\\\"print(ts_apply(lambda x: x + 1))\\\\\\\\n\\\\\\\"])))))\\\\n    56\\\\t\\\\n    57\\\\t\\\\n    58\\\\t(deftest typescript-calls-python-closure-test\\\\n    59\\\\t  (testing \\\\\\\"Python stores and calls the same TS function cell it received\\\\\\\"\\\\n    60\\\\t    (is (= {:js/out [\\\\\\\"22n\\\\\\\"], :js/uncaught nil}\\\\n    61\\\\t           (xl/call [:python\\\\n    62\\\\t                     (str \\\\\\\"def py_apply(f):\\\\\\\\n\\\\\\\"\\\\n    63\\\\t                          \\\\\\\"    global stored\\\\\\\\n\\\\\\\"\\\\n    64\\\\t                          \\\\\\\"    stored = f\\\\\\\\n\\\\\\\"\\\\n    65\\\\t                          \\\\\\\"    return f(20) + 1 if stored is f else -1\\\\\\\")]\\\\n    66\\\\t                    [\\\\\\\"py_apply\\\\\\\"]\\\\n    67\\\\t                    [:typescript\\\\n    68\\\\t                     \\\\\\\"console.log(py_apply(x => x + 1n));\\\\\\\"])))))\\\\n    69\\\\t\\\\n    70\\\\t\\\\n    71\\\\t(deftest python-calls-php-closure-test\\\\n    72\\\\t  (testing \\\\\\\"PHP stores and calls the same Python function cell it received\\\\\\\"\\\\n    73\\\\t    (is (= {:py/out [\\\\\\\"22\\\\\\\"], :py/exception nil}\\\\n    74\\\\t           (xl/call [:php\\\\n    75\\\\t                     (str \\\\\\\"<?php function php_apply($f) { global $stored; \\\\\\\"\\\\n    76\\\\t                          \\\\\\\"$stored = $f; return $stored === $f ? $f(20) + 1 : -1; }\\\\\\\")]\\\\n    77\\\\t                    [\\\\\\\"php_apply\\\\\\\"]\\\\n    78\\\\t                    [:python \\\\\\\"print(php_apply(lambda x: x + 1))\\\\\\\\n\\\\\\\"])))))\\\\n    79\\\\t\\\\n    80\\\\t\\\\n    81\\\\t(deftest php-calls-python-closure-test\\\\n    82\\\\t  (testing \\\\\\\"Python stores and calls the same PHP function cell it received\\\\\\\"\\\\n    83\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n    84\\\\t           (xl/call [:python\\\\n    85\\\\t                     (str \\\\\\\"def py_apply(f):\\\\\\\\n\\\\\\\"\\\\n    86\\\\t                          \\\\\\\"    global stored\\\\\\\\n\\\\\\\"\\\\n    87\\\\t                          \\\\\\\"    stored = f\\\\\\\\n\\\\\\\"\\\\n    88\\\\t                          \\\\\\\"    return f(20) + 1 if stored is f else -1\\\\\\\")]\\\\n    89\\\\t                    [\\\\\\\"py_apply\\\\\\\"]\\\\n    90\\\\t                    [:php \\\\\\\"<?php echo py_apply(function($x) { return $x + 1; });\\\\\\\"])))))\\\\n    91\\\\t\\\\n    92\\\\t\\\\n    93\\\\t;; yang.clojure <-> TypeScript, both directions. yang.clojure now publishes\\\\n    94\\\\t;; its runtime module (`clj`: the run-main entry, the task-local global\\\\n    95\\\\t;; namespace and the admission surface, yang.clojure.prelude), so the named\\\\n    96\\\\t;; skip is closed: the helper drives a clojure donor or caller like any\\\\n    97\\\\t;; other admitted frontend, and the same-cell identity check runs here too.\\\\n    98\\\\t\\\\n    99\\\\t\\\\n   100\\\\t(deftest clojure-closure-called-from-typescript-test\\\\n   101\\\\t  (testing \\\\\\\"TS stores and calls the same clojure function cell it received\\\\\\\"\\\\n   102\\\\t    ;; Clojure integers are bare exact integers, the value JS spells as a\\\\n   103\\\\t    ;; BigInt, so the TS callback adds with `1n` and logs `22n`.\\\\n   104\\\\t    (is (= {:js/out [\\\\\\\"true 22n\\\\\\\"], :js/uncaught nil}\\\\n   105\\\\t           (xl/call [:clojure \\\\\\\"(defn clj_apply [f] (+ (f 20) 1))\\\\\\\"]\\\\n   106\\\\t                    [\\\\\\\"clj_apply\\\\\\\"]\\\\n   107\\\\t                    [:typescript\\\\n   108\\\\t                     (str \\\\\\\"const stored = clj_apply; \\\\\\\"\\\\n   109\\\\t                          \\\\\\\"console.log(stored === clj_apply, stored(x => x + 1n));\\\\\\\")])))))\\\\n   110\\\\t\\\\n   111\\\\t\\\\n   112\\\\t(deftest typescript-closure-called-from-clojure-test\\\\n   113\\\\t  (testing \\\\\\\"TS stores and calls the same clojure function cell it received\\\\\\\"\\\\n   114\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n   115\\\\t           (xl/call [:typescript\\\\n   116\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n   117\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n   118\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n   119\\\\t                    [:clojure \\\\\\\"(ts_apply (fn [x] (+ x 1)))\\\\\\\"])))))\\\\n   120\\\\t\\\\n   121\\\\t\\\\n   122\\\\t(deftest clojure-projection-through-runtime-globals-test\\\\n   123\\\\t  (testing \\\\\\\"the projected value is read via clj/global-get inside the caller's run\\\\\\\"\\\\n   124\\\\t    ;; `ts_apply` is no top-level definition of the caller, so its read\\\\n   125\\\\t    ;; inside `apply-it` reaches the runtime global namespace the helper\\\\n   126\\\\t    ;; projected into, not a task-store binding.\\\\n   127\\\\t    (is (= \\\\\\\"22\\\\\\\"\\\\n   128\\\\t           (xl/call [:typescript\\\\n   129\\\\t                     (str \\\\\\\"globalThis.ts_apply = f => { globalThis.stored = f; \\\\\\\"\\\\n   130\\\\t                          \\\\\\\"return stored === f ? f(20n) + 1n : -1n; };\\\\\\\")]\\\\n   131\\\\t                    [\\\\\\\"ts_apply\\\\\\\"]\\\\n   132\\\\t                    [:clojure\\\\n   133\\\\t                     \\\\\\\"(defn apply-it [] (ts_apply (fn [x] (+ x 1)))) (apply-it)\\\\\\\"]))))\\\\n   134\\\\t  (testing \\\\\\\"a second clj/run-main entry still sees the earlier unit's globals\\\\\\\"\\\\n   135\\\\t    (is (= \\\\\\\"42\\\\\\\"\\\\n   136\\\\t           (xl/call [:clojure \\\\\\\"(def answer 42)\\\\\\\"]\\\\n   137\\\\t              