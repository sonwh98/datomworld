on re-reads the array\nsrc/cljc/yang/php/antlr/lower.cljc-2436-   at its location, binds `$v` to the marker of the current slot (the array is\nsrc/cljc/yang/php/antlr/lower.cljc-2437-   separated and upgraded by the fetch) and resumes after the current key, so\nsrc/cljc/yang/php/antlr/lower.cljc-2438-   appends are visited and an unset element is skipped. The iterator is the\nsrc/cljc/yang/php/antlr/lower.cljc-2439-   ordinal `i`; nothing is registered, so `break` and exceptions leave nothing\nsrc/cljc/yang/php/antlr/lower.cljc-2440-   to free.\"\nsrc/cljc/yang/php/antlr/lower.cljc-2441-  [ctx n kids]\nsrc/cljc/yang/php/antlr/lower.cljc-2442-  (let [chains (filter #(p/rule? % \"chain\") kids)\nsrc/cljc/yang/php/antlr/lower.cljc:2443:        arrow? (boolean (some #(p/token? % \"=>\") kids))\nsrc/cljc/yang/php/antlr/lower.cljc-2444-        src-chain (first chains)\nsrc/cljc/yang/php/antlr/lower.cljc-2445-        src-loc (chain-loc ctx n src-chain :foreach-source)\nsrc/cljc/yang/php/antlr/lower.cljc-2446-        assignable (first (filter #(p/rule? % \"assignable\") kids))\nsrc/cljc/yang/php/antlr/lower.cljc:2447:        v-node (if arrow? (last chains) assignable)\nsrc/cljc/yang/php/antlr/lower.cljc:2448:        k-loc (when arrow? (foreach-target ctx n assignable))\nsrc/cljc/yang/php/antlr/lower.cljc-2449-        v-loc (foreach-target ctx n v-node)\nsrc/cljc/yang/php/antlr/lower.cljc-2450-        _ (when (seq (:path v-loc)) (unsupported! n :reference))\nsrc/cljc/yang/php/antlr/lower.cljc-2451-        fr (loop-frame n false)\nsrc/cljc/yang/php/antlr/lower.cljc-2452-        [tbl w i key m] (map #(core/gen % n) [\"tbl\" \"w\" \"i\" \"key\" \"m\"])\nsrc/cljc/yang/php/antlr/lower.cljc-2453-        body (wrap-escape fr :cont (lower (push-frame ctx fr) (body-of ctx n)))]\nsrc/cljc/yang/php/antlr/lower.cljc-2454-    (with-keys\nsrc/cljc/yang/php/antlr/lower.cljc-2455-      ctx\nsrc/cljc/yang/php/antlr/lower.cljc-2456-      (lower-path ctx src-loc)\n--\nsrc/cljc/yang/php/antlr/l