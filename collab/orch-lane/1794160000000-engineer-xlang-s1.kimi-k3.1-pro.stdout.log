          :requires {}\n184\t                     :free-names module-free-names\n185\t                     :registry registry\n186\t                     :message \"the yang.call module reads an undeclared name\"\n187\t                     :refusal-ns \"yang.call\"}))"}
{"role":"tool","tool_call_id":"tool_JnItfOmdd9IyIoH2RNOpSdZv","content":"3210\t\n3211\t(defn- lower-lambda\n3212\t  \"A `function (...) use (...) {...}` closure or an `fn (...) => e` arrow\n3213\t   function: a function cell made at run time over its captured values,\n3214\t   wrapped as a Closure value.\"\n3215\t  [ctx n]\n3216\t  (let [arrow? (boolean (some #(and (p/token? %) (= \"LambdaFn\" (:type %))) (core/kids ctx n)))\n3217\t        scope (get-in (:analysis ctx) [:scopes (:id n)])\n3218\t        params (formal-params ctx n)\n3219\t        pnames (set (map :name params))\n3220\t        caps (if arrow?\n3221\t               (->> (:vars scope)\n3222\t                    (remove #(or (contains? pnames %) (= \"$this\" %)))\n3223\t                    (mapv (fn [nm] {:name nm, :ref? false, :arrow? true})))\n3224\t               (mapv #(assoc % :arrow? false) (use-vars ctx n)))\n3225\t        caps (mapv #(assoc % :sym (symbol (str \"%cap\" (subs (:name %) 1) (:id n)))) caps)\n3226\t        _ (doseq [c caps] (checked-var n (:name c)))\n3227\t        static? (boolean (some #(and (p/token? %) (= \"Static\" (:type %))) (core/kids ctx n)))\n3228\t        [lam spec statics] (function-lam ctx n \"{closure}\" {:captures caps, :arrow? arrow?, :closure? true})\n3229\t        make (app* 'php/make-closure\n3230\t                   (app* 'php/closure-env\n3231\t                         (app* 'php/make-function (u/lit \"{closure}\") (u/lit spec) lam (u/lit statics))\n3232\t                         (if (and (:fn ctx) (not static?)) (app* 'php/this-or-nil (u/v '%fn)) (u/lit nil))\n3233\t                         (if (:fn ctx) (app* 'php/static-or-nil (u/v '%fn)) (u/lit nil))\n3234\t                         (cc-node ctx)))]\n3235\t    (reduce (fn [inner c] (u/let1 (:sym c) (capture-source ctx c) inner))\n3236\t            make\n3237\t            (reverse caps))))\n3238\t\n3239\t\n3240\t;; -----------------------------------------------------------------------------\n3241\t;; Objects and classes (P4 S1/S2)\n3242\t;; -----------------------------------------------------------------------------\n3243\t\n3244\t(defn- line-of\n3245\t  \"The source line of CST node `n` from the packet's line side table, 0 when\n3246\t   the packet carries none.\"\n3247\t  [ctx n]\n3248\t  (let [starts (:yang.php/line-starts (:pk ctx))\n3249\t        at (first (:span n))]\n3250\t    (if (and (seq starts) at) (count (take-while #(<= % at) starts)) 0)))\n3251\t\n3252\t\n3253\t(defn- lower-new\n3254\t  \"`new Class(args)`: the class is resolved and refused first (row 53), the\n3255\t   object is created, then the arguments run, then the constructor.\"\n3256\t  [ctx n]\n3257\t  (let [t (first (core/rules ctx n \"typeRef\"))]"}
