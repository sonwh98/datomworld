 \\\"import antlr4Module from 'antlr4';\\\\nconst antlr4 = antlr4Module.default || antlr4Module;\\\"]],\\n    \\\"JavaScript/Python3LexerBase.js\\\"\\n    [[\\\"import antlr4 from 'antlr4';\\\"\\n      \\\"import antlr4Module from 'antlr4';\\\\nconst antlr4 = antlr4Module.default || antlr4Module;\\\"]\\n     [\\\"            this.emitToken(this.commonToken(Python3Parser.NEWLINE, newLine));\\\"\\n      \\\"            this.emitToken(this.positionedToken(Python3Parser.NEWLINE, this._tokenStartCharIndex, this._tokenStartCharIndex + newLine.length - 1));\\\"]\\n     [\\\"        return this.commonToken(Python3Parser.DEDENT, \\\\\\\"\\\\\\\");\\\"\\n      \\\"        return this.positionedToken(Python3Parser.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);\\\"]\\n     [\\\"            this.emitToken(this.commonToken(Python3Parser.NEWLINE, \\\\\\\"\\\\\\\\n\\\\\\\"));\\\"\\n      \\\"            this.emitToken(this.positionedToken(Python3Parser.NEWLINE, this.getCharIndex(), this.getCharIndex() - 1));\\\"]\\n     [\\\"    commonToken(type, text) {\\\"\\n      \\\"    positionedToken(type, start, stop) {\\\\n        return new antlr4.CommonToken(this._tokenFactorySourcePair, type, antlr4.Lexer.DEFAULT_TOKEN_CHANNEL, start, stop);\\\\n    }\\\\n\\\\n    commonToken(type, text) {\\\"]\\n     ;; Upstream declares getIndentationCount twice, identically; Closure\\n     ;; (the shadow-cljs release/test compile) rejects the duplicate member.\\n     [\\\"    getIndentationCount(whitespace) {\\\\n        let count = 0;\\\\n        for (let i = 0; i < whitespace.length; i++) {\\\\n            if (whitespace[i] === '\\\\\\\\t') {\\\\n                count += 8 - count % 8;\\\\n            } else {\\\\n                count++;\\\\n            }\\\\n        }\\\\n        return count;\\\\n    }\\\\n\\\\n    getIndentationCount(whitespace) {\\\"\\n      \\\"    getIndentationCount(whitespace) {\\\"]]},\\n   ;; Output patches: the tool's own import line, same reason as above.\\n   :