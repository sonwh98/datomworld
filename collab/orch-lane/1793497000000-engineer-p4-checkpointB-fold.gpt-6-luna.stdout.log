257:   \\\"An identifier classifies only when its namespace and name are both\\n258:    well-formed UTF-16: ident parts are strings under NFC.\\\"\\n259:   [x]\\n260:   (and (or (nil? (namespace x))\\n261:            (well-formed-utf16? (namespace x)))\\n262:        (well-formed-utf16? (name x))))\\n263: \\n264: \\n265: (defn canonical-class\\n266:   \\\"Classify `v` under §5's canonical value table: the class keyword when\\n267:    v is inside the canonical domain, nil when v is unsupported (a\\n268:    diagnostic at the walk). Recursive over collections; maps and sets\\n269:    sort by canonical encoded bytes only at D3 encode time, so any\\n270:    iteration order classifies identically. Records are not the plain\\n271:    map they print as — their host shapes disagree — so they diagnose.\\\"\\n272:   [v]\\n273:   (cond\\n274:     (nil? v) :nil\\n275:     (boolean? v) :bool\\n276:     (string? v) (when (well-formed-utf16? v) :string)\\n277:     (keyword? v) (when (ident-parts-ok? v) :keyword)\\n278:     (symbol? v) (when (ident-parts-ok? v) :symbol)\\n279:     (bytes-like? v) :bytes\\n280:     (map? v) (when (and (not (record? v))\\n281:                         (every? (fn [entry]\\n282:                                   (and (canonical-class (key entry))\\n283:                                        (canonical-class (val entry))))\\n284:                                 v))\\n285:                :map)\\n286:     (set? v) (when (every? canonical-class v) :set)\\n287:     (vector? v) (when (every? canonical-class v) :vector)\\n288:     (sequential? v) (when (every? canonical-class v) :list)\\n289:     (number? v) (numeric-class v)))\\n290: \\n291: \\n292: (defn canonical-value?\\n293:   \\\"True when `v` is inside §5's canonical value domain — equivalently,\\n294:    when `canonical-class` is non-nil.\\\"\"}]},{\"type\":\"tool_result\",\"tool_use_id\":\"call_b53e6f26e1fe42ebbb56aa2f\",\"content\":[{\"type\":\"text\",\"text\":\"Read 1/1 file, 110 lines\\nNote: showing lines 770-879. More of the file remains. Use offset=880 to continue.\\n770: ;; =============================================================================\\n771: \\n772: (def ^:private hex-digit-chars \\\"0123456789abcdef\\\")\\n773: \\n774: \\n775: (defn- to-hex\\n776:   \\\"Width-padded lowercase hex of the non-negative integer n.\\\"\\n777:   [n width]\\n778:   (let [base (if (zero? n)\\n779:                \\\"0\\\"\\n780:                (loop [n n, acc \\\"\\\"]\\n781:                  (if (zero? n)\\n782:                    acc\\n783:                    (recur (unsigned-bit-shift-right n 4)\\n784:                           (str (nth hex-digit-chars (bit-and n 0xf)) acc)))))\\n785:         padded (str (apply str (repeat width \\\"0\\\")) base)]\\n786:     (subs padded (- (count padded) width))))\\n787: \\n788: \\n789: (def ^:private slot-tag\\n790:   \\\"The settled tag byte (hex) each canonical class and compound slot type\\n791:    renders under. Class tags are the class's index in the value table's\\n792:    declared :classes order — read through the descriptor — and the\\n793:    compound types (child refs, the fixed pair, the ordered vector) take\\n794:    bytes outside that range.\\\"\\n795:   (into {:ref \\\"c0\\\", :hash \\\"c1\\\", :tuple \\\"c2\\\", :ordered-vector \\\"c3\\\"}\\n796:         (map-indexed (fn [i class] [class (to-hex i 2)]))\\n797:         (:classes canonical-value-table)))\\n798: \\n799: \\n800: ;; code-unit-at lives with the D0 classifier: well-formed-utf16? reads\\n801: ;; code units there, before any encoder definition.\\n802: \\n803: \\n804: (defn- utf8-byte-length\\n805:   \\\"The byte length of `s` under UTF-8, from its code units: a surrogate\\n806:    pair is one 4-byte sequence, never two 3-byte ones, and an unpaired\\n807:    surrogate — which the classifier has already refused — would be the\\n808:    3-byte replacement character. Pure arithmetic over code units, so\\n809:    every host agrees without encoding anything