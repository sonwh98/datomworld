  (some #(leftmost-token-text ctx %) (core/kids ctx n))))\n\n\n(defn- catch-clause-node\n  \"`(if matches (do bind body) rest)` for one `catch` clause over error `e`.\"\n  [ctx e clause rest]\n  (let [types (mapv #(str/lower-case (class-text ctx %))\n                    (core/rules ctx clause \"qualifiedStaticTypeRef\"))\n        var (some #(when (and (p/token? %) (= \"VarName\" (:type %))) (:text %))\n                  (core/kids ctx clause))\n        test (reduce (fn [acc t]\n                       (u/if-node acc (u/lit true) (app* 'php/instance-of e (u/lit t))))\n                     (u/lit false)\n                     types)\n        body (lower ctx (first (core/rules ctx clause \"blockStatement\")))]\n    (u/if-node test\n               (if var\n                 (u/then (write-var ctx var e) body)\n                 (u/then (app* 'php/delref e) body))\n               rest)))\n\n\n(defn- lower-try\n  \"`try { } catch (T $e) { } finally { }`: `php/try` delivers the error to the\n   catch clauses in order, an unmatched one is raised again; `php/try-finally`\n   runs the finally block on every exit, escapes and errors included.\"\n  [ctx n]\n  (let [block (first (core/rules ctx n \"blockStatement\"))\n        clauses (core/rules ctx n \"catchClause\")\n        fin (first (core/rules ctx n \"finallyStatement\"))\n        e (core/gen \"e\" n)\n        mark (core/gen \"mk\" n)\n        body (lower ctx block)\n        guarded (if (seq clauses)\n                  (u/let1 mark\n                          (app* 'php/tmp-mark)\n                          (app* 'php/try\n                                (u/lam [] body)\n                                (u/lam [e]\n                                       (u/then (app* 'php/release-tmps (u/v mark))\n                                               (reduce (fn [rest clause]\n                                                         (catch-clause-node ctx (u/v e) clause rest))\n                                                       (app* 'php/raise (u/v e))\n                                                       (reverse clauses))))\n                                (u/lam [] (u/lit :php/null))))\n                  body)]\n    (u/then (if fin\n              (app* 'php/try-finally\n                    (u/lam [] guarded)\n                    (u/lam [(core/gen \"x\" n)]\n                           (lower ctx (first (core/rules ctx fin \"blockStatement\")))))\n              guarded)\n            (u/lit :php/null))))\n\n\n(defn- lower-match\n  \"`match (e) { a, b => r, default => d }`: strict comparison in order, the\n   default last, else `UnhandledMatchError`.\"\n  [ctx n]\n  (let [subject (first (core/rules ctx n \"expression\"))\n14:     `:php/undef`. Loops are self-applied `:loop`-marked lambdas whose\n16:     `%cont<id>`, created only when the body uses them; the `:loops` stack of\n717:  \"Write back a container the variable already owns: through a marker, with\n730:  \"The reference marker of the variable, made on first use.\"\n743:  \"Bind the variable to the marker `m` (`$x =& ...`).\"\n748:    (app* 'php/bind-marker cv m)\n1155:                                    (app* 'php/marker-of-cv cv)\n1156:                                    (app* 'php/marker-of-global (u/lit (bare (:var l)))))\n1346:  \"A node that answers the reference marker of location `l` (keys already\n1359:  \"A node that answers the reference marker of the location `chain`, made on\n1487:                            (let [marker (ref-source-loc ctx n (update src-loc :path conj (u/v k)))]\n1489:                                (bind-var ctx (:var target-loc) marker)\n1495:                                               marker)))))))))\n1528:  \"`$x =& $y`, `$x =& $a[k]`, `$a[k] =& $y`: the source's marker first (its\n1609:   a variable or element sends the reference marker.\"\n1643:    (core/site :call\n1761:                          (core/site :call (app* 'php/call (u/v f) (args-vector nodes)))\n1917:        mark (core/gen \"mk\" n