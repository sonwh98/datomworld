) \"chain\")) (first ks) e))\n  1386\t            e)]\n  1387\t    (cond\n  1388\t      (p/rule? e \"chain\") e\n  1389\t      ref? (unsupported! n :list)\n  1390\t      :else\n  1391\t      (let [ks (core/kids ctx e)\n  1392\t            inner (first ks)]\n  1393\t        (if (and (= 1 (count ks)) (p/rule? inner \"arrayCreation\"))\n  1394\t          (pattern-of ctx n inner)\n  1395\t          (unsupported! n :list))))))\n  1396\t\n  1397\t\n  1398\t(defn- sequence-entries\n  1399\t  \"Entries from a stream of `[:item x]` / `:comma` events: a comma that does\n  1400\t   not follow an item is a hole; trailing holes are dropped.\"\n  1401\t  [events]\n  1402\t  (let [[out _ _]\n  1403\t        (reduce (fn [[out idx pending?] ev]\n  1404\t                  (if (= ev :comma)\n  1405\t                    (if pending? [out idx false] [(conj out nil) (inc idx) false])\n  1406\t                    [(conj out ev) (inc idx) true]))\n  1407\t                [[] 0 false]\n  1408\t                events)\n  1409\t        trimmed (loop [v out] (if (and (seq v) (nil? (peek v))) (recur (pop v)) v))]\n  1410\t    (vec (keep-indexed (fn [i e] (when e (assoc e :idx i))) trimmed))))\n  1411\t\n  1412\t\n  1413\t(defn- pattern-of\n  1414\t  \"The pattern of an `arrayDestructuring`, `arrayCreation` or `assignmentList`.\"\n  1415\t  [ctx n node]\n  1416\t  (let [entry (fn [key ref? target] {:key key, :ref? ref?, :target target})]\n  1417\t    (sequence-entries\n  1418\t      (case (:rule node)\n  1419\t        \"arrayDestructuring\"\n  1420\t        (mapcat (fn [k]\n  1421\t                  (cond\n  1422\t                    (p/token? k \",\") [:comma]\n  1423\t                    (p/rule? k \"indexedDestructItem\")\n  1424\t                    (let [ref? (boolean (some #(p/token? % \"&\") (core/kids ctx k)))]\n  1425\t                      [(entry nil ref? (destructure-target ctx n (first (core/rules ctx k \"chain\")) ref?))])\n  1426\t                    (p/rule? k \"keyedDestructItem\")\n  1427\t                    (let [ref? (boolean (some #(p/token? % \"&\") (core/kids ctx k)))]\n  1428\t                      [(entry (first (core/rules ctx k \"expression\")) ref?\n  1429\t                              (destructure-target ctx n (first (core/rules ctx k \"chain\")) ref?))])\n  1430\t                    :else []))\n  1431\t                (core/kids ctx node))\n  1432\t        \"arrayCreation\"\n  1433\t        (mapcat (fn [k]\n  1434\t                  (cond\n  1435\t                    (p/token? k \",\") [:comma]\n  1436\t                    (p/rule? k \"arrayItem\")\n  1437\t                    (let [kids (core/kids ctx k)\n  1438\t                          ref? (boolean (some #(p/token? % \"&\") kids))\n  1439\t                          exprs (core/rules ctx k \"expression\")\n  1440\t                          keyed? (boolean (some #(p/token? % \"=>\") kids))\n  1441\t                          key (when keyed? (first exprs))\n  1442\t                          target (if ref? (first (core/rules ctx k \"chain\")) (last exprs))]\n  1443\t                      [(entry key ref? (destructure-target ctx n target ref?))])\n  1444\t                    :else []))\n  1445\t                (mapcat #(core/kids ctx %) (core/rules ctx node \"arrayItemList\")))\n  1550\t                            (u/then (put-var ctx (:var l) (u/v p))\n  1551\t                                    (app* 'php/ref-value (u/v m)))))))))))\n  1552\t\n  1553\t\n  1554\t(defn- lower-assign\n  1555\t  \"`$x = e`, `$a[k] = e`, `$x op= e`, `$x ??= e`. The keys run first, left to\n  1556\t   right and once, then the right side, as in PHP; a compound assignment then\n  1557\t   reads the location.\"\n  1558\t  [ctx n [target op :as ks]]\n  1559\t  (if (and (p/token? op) (= 4 (count ks)) (p/token? (nth ks 2) \"&\"))\n  1560\t    (lower-assign-ref ctx n target (nth ks 3))\n  1561\t    (lower-assign-value ctx n ks)))\n  1562\t\n  1563\t\n  1564\t(defn- lower-assign-value\n  1565\t  [ctx n [target op :as ks]]\n  1566\t  (when (p/token? op) (unsupported! n :reference))\n  1567\t  (when (not= 3 (count ks)) (unsupported! n :attribute))\n  1568\t  (if (and (p/rule? (first (core/kids ctx target)) \"arrayCreation\")\n  1569\t           (= \"Eq\" (:type (first (core/kids ctx op)))))\n  1570\t    (lower-destructure ctx n (pattern-of ctx n (first (core/kids ctx target))) (nth ks 2))\n  1571\t    (lower-assign-target ctx n ks)))\n  1572\t\n  1573\t\n  1574\t(defn- lower-assign-target\n  1575\t  [ctx n [target op :as ks]]\n  1576\t  (let [chain (first (core/kids ctx target))\n  1577\t        loc (if (p/rule? chain \"chain\")\n  1578\t              (chain-loc ctx n chain :assignment-target)\n  1579\t              (unsupported! n :list))\n  1580\t        rhs (nth ks 2)\n  1581\t        optype (:type (first (core/kids ctx op)))]\n  1582\t    (when (not= \"Eq\" optype) (forbid-append! n loc \"Cannot use [] for reading\"))\n  1583\t    (with-keys\n  1584\t      ctx\n  1585\t      loc\n  1586\t      (fn [l]\n  1587\t        (case optype\n  1588\t          \"Eq\" (write-loc ctx n l (acquired ctx rhs))\n  1589\t          \"NullCoalescingEqual\"\n  1590\t          (let [t (core/gen \"t\" n)]\n  1591\t            (u/let1 t\n  1592\t                    (peek-loc ctx l)\n  1593\t                    (u/if-node (app* '= (u/v t) (u/lit :php/null))\n  1594\t                               (write-loc ctx n l (lower ctx rhs))\n  1595\t                               (u/v t))))\n  1596\t          (if-let [f (get assignment-ops optype)]\n  1597\t            (let [r (core/gen \"r\" n)]\n  1598\t              (u/let1 r\n  1599\t                      (lower ctx rhs)\n  1600\t                      (write-loc ctx n l (app* f (read-loc ctx l) (u/v r)))))\n  1601\t            (unsupported! n (keyword (str/lower-case optype)))))))))\n  1602\t\n  1603\t\n  1604\t(defn- lower-arguments\n  1605\t  \"`[positional-node named-node]` of a call's `arguments` rule. Positional\n  1606\t   values and `...` spreads fold left to right into one vector; `name: e`\n  1607\t   arguments collect as `[name value]` pairs (nil when there are none). A\n  1608\t   position in `refs` (a by-reference parameter of a unit function) that holds\n  1807\t        (read-loc ctx (lower-path ctx loc)))\n  1808\t      (p/rule? k \"parentheses\") (lower ctx k)\n  1809\t      :else (unsupported! n :dynamic-call))))\n  1810\t\n  1811\t\n  1812\t(defn- lower-call-plain\n  1813\t  [ctx n call]\n  1814\t  (let [[fname args] (core/rule-kids ctx call)\n  1815\t        groups (core/rules ctx args \"arguments\")\n  1816\t        static? (let [ks (core/kids ctx fname)]\n  1817\t                  (and (= 1 (count ks)) (p/rule? (first ks) \"qualifiedNamespaceName\")))\n  1818\t        {primary-lc :lc, :keys [written fallback-lc fallback]} (when static? (function-name ctx fname))\n  1819\t        ;; the name builtins and special forms are keyed by, and the unit's\n  1820\t        ;; own declaration of the call, if any\n  1821\t        lc (or fallback-lc primary-lc)\n  1822\t        user-lc (first (filter #(contains? (:declared ctx) %) [primary-lc fallback-lc]))\n  1823\t        arguments (first groups)\n  1824\t        chain-dynamic (fn [callee-node more]\n  1825\t                        (reduce (fn [acc g]\n  1826\t                                  (let [f (core/gen \"f\" g)]\n  1827\t                                    (u/let1 f\n  1828\t                                            (app* 'php/callable-in acc (cc-node ctx))\n  1829\t                                            (call-node ctx (u/v f) g nil))))\n  1830\t                                callee-node\n  1831\t                                more))]\n  1832\t    (when-not (seq groups) (unsupported! n :dynamic-call))\n  1833\t    (if-not static?\n  1834\t      (let [f (core/gen \"f\" n)]\n  1835\t        (chain-dynamic\n  1836\t          (u/let1 f\n  1837\t                  (app* 'php/callable-in (callee-value ctx n fname) (cc-node ctx))\n  1838\t                  (app* 'php/tmp! (call-node ctx (u/v f) arguments nil)))\n  1839\t          (rest groups)))\n  1840\t      (chain-dynamic\n  1841\t        (case lc\n  1842\t          \"isset\" (lower-isset ctx n (argument-chains ctx n arguments))\n  1843\t          \"unset\" (lower-unset ctx n (argument-chains ctx n arguments))\n  1844\t          \"empty\" (let [cs (argument-chains ctx n arguments)]\n  1845\t                    (when (not= 1 (count cs)) (unsupported! n :argument-form))\n  1846\t                    (lower-empty ctx n (first cs)))\n  1847\t          (\"exit\" \"die\") (let [as (core/rules ctx arguments \"actualArgument\")]\n  1848\t                           (when (> (count as) 1) (unsupported! n :argument-form))\n  1849\t                           (app* 'php/exit\n  1850\t                                 (if (seq as)\n  1851\t                                   (lower ctx (first (core/kids ctx (first as))))\n  1852\t                                   (u/lit 0))))\n  1853\t          \"extract\" (app* 'php/bi-extract\n  1854\t                          (args-vector (map #(lower ctx (first (core/rules ctx % \"expression\")))\n  1855\t                                            (core/rules ctx arguments \"actualArgument\")))\n  1856\t                          (dynamic-scope-node ctx))\n  1857\t          \"compact\" (app* 'php/bi-compact\n  1858\t                          (args-vector (map #(lower ctx (first (core/rules ctx % \"expression\")))\n  1859\t                                            (core/rules ctx arguments \"actualArgument\")))\n  1860\t                          (dynamic-scope-node ctx))\n  1861\t          \"eval\" (unsupported! n :eval)\n  1862\t          (let [f (core/gen \"f\" n)\n  1863\t                by-ref (when-not user-lc\n  1864\t                         (:by-ref (get builtins/supported lc)))]\n  1865\t            (note-unknown-builtin! ctx n lc (or fallback written))\n  1866\t            (u/let1 f\n  1867\t                    (if fallback\n  1868\t                      (app* 'php/resolve-fn2 (u/lit primary-lc) (u/lit fallback-lc) (u/lit written))\n  1869\t                      (app* 'php/resolve-fn (u/lit lc) (u/lit written)))\n  1870\t                    (if by-ref\n  1871\t                      (lower-by-ref-call ctx n f by-ref arguments)\n  1872\t                      (let [call (call-node ctx (u/v f) arguments (get (:declared ctx) user-lc))]\n  1873\t                        (if user-lc (app* 'php/tmp! call) call))))))\n  1874\t        (rest groups)))))\n  1875\t\n  1876\t\n  1877\t;; -----------------------------------------------------------------------------\n  1878\t;; try, throw, match, member calls\n  1879\t;; -----------------------------------------------------------------------------\n  1880\t\n  1881\t(defn- leftmost-token-text\n  1882\t  \"The text of the first token under `n`.\"\n  1883\t  [ctx n]\n  1884\t  (if (p/token? n)\n  1885\t    (when-not (= \"\\\\\" (:text n)) (:text n))\n  1886\t    (some #(leftmost-token-text ctx %) (core/kids ctx n))))\n  1887\t\n    65\t             (if (php/include-require? kind)\n    66\t               (php/throw-error\n    67\t                 \"Error\"\n    68\t                 (data/str-concat\n    69\t                   (data/str-concat\n    70\t                     (data/str-concat \"Failed opening required '\" path)\n    71\t                     \"' (include_path='\")\n    72\t                   (data/str-concat php/include-path \"')\")))\n    73\t               (do (php/warn-refusal\n    74\t                     2\n    75\t                     (data/str-concat\n    76\t                       (data/str-concat\n    77\t                         (data/str-concat\n    78\t                           (data/str-concat nm \"(): Failed opening '\")\n    79\t                           path)\n    80\t                         \"' for inclusion (include_path='\")\n    81\t                       (data/str-concat php/include-path \"')\"))\n    82\t                     refusal)\n    83\t                   false)))))]\n    84\t    [php/include-body\n    85\t     ;; marks the path before the body runs, names the unit while it runs,\n    86\t     ;; answers the body's `return` value, else 1\n    87\t     (fn [path delivered scope ctx]\n    88\t       (let [prev (cell/get php.rt/unit)]\n    89\t         (do (cell/set! php.rt/included (assoc (cell/get php.rt/included) path true))\n    90\t             (cell/set! php.rt/unit path)\n    91\t             (php/try-finally\n    92\t               (fn []\n    93\t                 (let [v ((get delivered :body) scope ctx)]\n    94\t                   (if (= v :php/no-return) 1 v)))\n    95\t               (fn [x] (cell/set! php.rt/unit prev))))))]\n    96\t    [php/include-run\n    97\t     ;; `thunk` answers {:status :ok :body b} or the structured refusal\n    98\t     (fn [path thunk kind scope ctx]\n    99\t       (if (if (php/include-once? kind)\n   100\t             (not (nil? (get (cell/get php.rt/included) path)))\n   101\t             false)\n   102\t         true\n   103\t         (let [r (thunk)]\n   104\t           (if (= (get r :status) :ok)\n   105\t             (php/include-body path r scope ctx)\n   106\t             (php/include-missing! path kind r)))))]\n   107\t    [php/normalize-path\n   108\t     ;; the computed arm's lookup key: leading \"./\" segments dropped\n   109\t     (fn [s]\n   110\t       (if (if (>= (data/str-length s) 2) (= (data/substring s 0 2) \"./\") false)\n   111\t         (php/normalize-path (data/substring s 2))\n   112\t         s))]\n   113\t    [php/include-computed\n   114\t     ;; a computed path is a run-time lookup in the published path map; a\n   115\t     ;; miss is the run-time missing-include behaviour for the kind\n   116\t     (fn [pathv kind scope ctx]\n   117\t       (let [path (php/normalize-path (php/to-string pathv))\n   118\t             thunk (get (cell/get php.rt/path-map) path)]\n   119\t         (php/include-run\n   120\t           path\n   121\t           (if (nil? thunk)\n   122\t             (fn []\n   123\t               (assoc (assoc {} :status :refused)\n   124\t                      :reason :yang.php/computed-path-unmapped))\n   125\t             thunk)\n   126\t           kind\n   127\t           scope\n   128\t           ctx)))]\n   129\t    ;; ---------------------------------------------------------------- scopes\n   130\t    ;; An including scope is `:php/globals` (the entry unit's top level) or a\n   131\t    ;; scope cell: name to the variable's own cell, in insertion order. A\n   132\t    ;; dynamic-profile function adopts the cells its body already holds, so an\n   133\t    ;; included body and the function see one variable.\n   134\t    [php/scope-new\n   135\t     (fn [] (cell/new (assoc (assoc {} :cells {}) :order [])))]\n   136\t    [php/scope-adopt!\n   137\t     (fn [d name c]\n   138\t       (let [s (cell/get d)]\n   139\t         (do (cell/set! d (assoc (assoc s :cells (assoc (get s :cells) name c))\n   140\t                                 :order (php/vconj (get s :order) name)))\n   141\t             c)))]\n   142\t    [php/scope-cell\n   143\t     (fn [d name]\n   144\t       (let [c (get (get (cell/get d) :cells) name)]\n   145\t         (if (nil? c) (php/scope-adopt! d name (cell/new :php/undef)) c)))]\n   146\t    [php/scope-release-loop\n   147\t     (fn [cells order i]\n   148\t       (if (< i (data/count order))\n   149\t         (do (php/unset-cv (get cells (get order i)))\n   150\t             (php/scope-release-loop cells order (+ i 1)))\n   151\t         (php/flush-pending!)))]\n   152\t    [php/scope-release!\n   153\t     (fn [d] (let [s (cell/get d)] (php/scope-release-loop (get s :cells) (get s :order) 0)))]\n   154\t    [php/dict-get\n   155\t     (fn [d name]\n   156\t       (if (= d :php/globals) (php/global-get name) (php/local-get (php/scope-cell d name) name)))]\n   157\t    [php/dict-peek\n   158\t     (fn [d name]\n   1