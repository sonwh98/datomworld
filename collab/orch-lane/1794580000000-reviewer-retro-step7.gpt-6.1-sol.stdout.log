 1) c (get cs i)]\\n   491\\t         (do (php/json-index! st (+ i 1))\\n   492\\t             (if (= c 44) (php/json-array-read st out) (if (= c 93) out (php/json-fail st \\\"Syntax error\\\"))))))]\\n   493\\t    [php/json-object-read\\n   494\\t     (fn [st out]\\n   495\\t       (do (php/json-space st)\\n   496\\t           (let [cs (get (cell/get st) 0) i (get (cell/get st) 1) c (get cs i)]\\n   497\\t             (if (= c 125)\\n   498\\t               (do (php/json-index! st (+ i 1)) out)\\n   499\\t               (do (php/json-index! st (+ i 1))\\n   500\\t                   (let [k (php/json-read-string st)]\\n   501\\t                     (do (php/json-space st)\\n   502\\t                         (php/json-index! st (+ (get (cell/get st) 1) 1))\\n   503\\t                         (let [v (php/json-value st) a (php/array-put out k v)]\\n   504\\t                           (do (php/json-space st) (php/json-object-next st a))))))))))]\\n   505\\t    [php/json-object-next\\n   506\\t     (fn [st out]\\n   507\\t       (let [cs (get (cell/get st) 0) i (get (cell/get st) 1) c (get cs i)]\\n   508\\t         (do (php/json-index! st (+ i 1))\\n   509\\t             (if (= c 44) (php/json-object-read st out) (if (= c 125) out (php/json-fail st \\\"Syntax error\\\"))))))]\\n   510\\t    [php/json-value\\n   511\\t     (fn [st]\\n   512\\t       (do (php/json-space st)\\n   513\\t           (let [cs (get (cell/get st) 0) i (get (cell/get st) 1) c (get cs i)]\\n   514\\t             (do (php/json-index! st (+ i 1))\\n   515\\t                 (if (= c 34) (php/json-read-string st)\\n   516\\t                     (if (= c 123) (php/json-object-read st (php/empty-array))\\n   517\\t                         (if (= c 91) (php/json-array-read st (php/empty-array))\\n   518\\t                             (if (= c 116) (php/json-literal st \\\"rue\\\" true)\\n   519\\t                                 (if (= c 102) (php/json-literal st \\\"alse\\\" false)\\n   520\\t                                     (if (= c 110) (php/json-literal st \\\"ull\\\" :php/null)\\n   521\\t                                         (do (php/json-index! st i) (php/json-number st))))))))))))]\\n   522\\t    [php/bi-json-decode\\n   523\\t     (fn [args]\\n   524\\t       (do (php/arity-between \\\"json_decode\\\" args 1 4 \\\"at least 1\\\")\\n   525\\t           (let [flags (php/to-int (php/arg-or args 3 0)) assoc (php/to-bool (php/arg-or args 1 false))\\n   526\\t                 st (cell/new\\n   527\\t                      (php/vconj\\n   528\\t                        (php/vconj\\n   529\\t                          (php/vconj\\n   530\\t                            (php/vconj [] (data/str->code-points (php/p9-string (get args 0))))\\n   531\\t                            0)\\n   532\\t                          assoc)\\n   533\\t                        (= (integer/bit-and flags 4194304) 4194304)))\\n   534\\t                 v (php/json-value st)]\\n   535\\t             (do (php/json-space st)\\n   536\\t                 (if (= (get (cell/get st) 1) (data/count (get (cell/get st) 0))) v (php/json-fail st \\\"Syntax error\\\"))))))]\\n   537\\t\\n   538\\t    ;; math II\\n   539\\t    [php/abs (fn [x] (if (php/int? x) (if (< x 0) (integer/neg x) x) (php/f (php/abs-h (php/fl x)))))]\\n   540\\t    [php/bi-abs (fn [args] (php/abs (get args 0)))]\\n   541\\t    [php/bi-ceil\\n   542\\t     (fn [args] (let [x (php/to-float (get args 0)) h (php/h x) i (integer/from-float h)] (php/f (if (> h (integer/to-float i)) (integer/to-float (integer/add i 1)) (integer/to-float i)))))]\\n   543\\t    [php/bi-floor\\n   544\\t     (fn [args] (let [x (php/to-float (get args 0)) h (php/h x) i (integer/from-float h)] (php/f (if (< h (integer/to-float i)) (integer/to-float (integer/sub i 1)) (integer/to-float i)))))]\\n   545\\t    [php/bi-round\\n   546\\t     (fn [args] (let [h (php/h (php/to-float (get args 0))) a (php/abs-h h) i (integer/from-float a) f (- a (integer/to-float i)) r (if (>= f (data/float-value 0.5)) (integer/add i 1) i)] (php/f (if (< h 0) (php/neg-h (integer/to-float r)) (integer/to-float r)))))]\\n   547\\t    [php/p9-sqrt-loop (fn [x guess i] (if (< i 40) (php/p9-sqrt-loop x (/ (+ guess (/ x guess)) (data/float-value 2)) (+ i 1)) guess))]\\n   548\\t    [php/bi-sqrt (fn [args] (let [x (php/h (php/to-float (get args 0)))] (if (< x 0) (php/nan-const) (if (= x 0) (php/f x) (php/f (php/p9-sqrt-loop x (if (> x 1) x 1) 0))))))]\\n   549\\t    [php/bi-pow (fn [args] (php/pow (get args 0) (get args 1)))]\\n   550\\t    [php/p9-minmax (fn [args i best want-max] (if (< i (data/count args)) (let [v (get args i) c (php/cmp v best)] (php/p9-minmax args (+ i 1) (if (if want-max (> c 0) (< c 0)) v best) want-max)) best))]\\n   551\\t    [php/bi-min (fn [args] (php/p9-minmax args 1 (get args 0) false))]\\n   552\\t    [php/bi-max (fn [args] (php/p9-minmax args 1 (get args 0) true))]\\n   553\\t    [php/bi-is-finite (fn [args] (let [h (php/h (php/to-float (get args 0)))] (if (php/nan? h) false (not (= (php/abs-h h) (php/inf))))))]\\n   554\\t    [php/bi-is-infinite (fn [args] (= (php/abs-h (php/h (php/to-float (get args 0)))) (php/inf)))]\\n   555\\t    [php/bi-array-multisort (fn [args] (php/throw-error \\\"Error\\\" \\\"array_multisort is a prefer-ref builtin and is not supported (corner C6)\\\"))]])\\n   556\\t\\n   557\\t\\n   558\\t(def definitions\\n   559\\t  (vec forms))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1794580000000-reviewer-retro-step7.gpt-6.1-sol.stdout.log:33:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"agent_message\",\"text\":\"The P5 and P9 paths have likely semantic gaps that the happy-path fixtures don’t cover: exit handling, buffer finalization, and accepted builtin options. I’m tracing those paths against the design and PHP 8.3 semantics before deciding which are defects versus declared restrictions.\"}}\ncollab/orch-lane/1794580000000-reviewer-retro-step7.gpt-6.1-sol.stdout.log:35:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc '/Library/Developer/CommandLineTools/usr/bin/git diff 716326aa''^1 716326aa -- test/yang/call/conformance.clj test/yang/cross_lang_test.clj; /Library/Developer/CommandLineTools/usr/bin/git diff a7ea0796''^1 a7ea0796 -- test/yang/call/conformance.clj test/yang/cross_lang_test.clj'\",\"aggregated_output\":\"diff --git a/test/yang/call/conformance.clj b/test/yang/call/conformance.clj\\nnew file mode 100644\\nindex 00000000..af511dda\\n--- /dev/null\\n+++ b/test/yang/call/conformance.clj\\n@@ -0,0 +1,224 @@\\n+(ns yang.call.conformance\\n+  \\\"The cross-language calling gates' shared composition (docs/design/\\n+   yang.antlr.md section 8.10.11): a donor program's named export reaches a\\n+   caller program by explicit published-export composition only.\\n+\\n+   A donor is real source of any admitted frontend, lowered unmodified and\\n+   published as an ordinary linker module whose one export, `body`, is the\\n+   lowered unit. A caller task requires that module, runs its body under the\\n+   donor runtime's own entry (`js/run-main`, `php/run-main`), reads each\\n+   named export from the donor runtime's global namespace, and projects it\\n+   into the caller runtime's namespace under the same name; then the caller\\n+   source, lowered unmodified, runs under its own entry. The composition is\\n+   a sequence of top-level nodes: no call node is rewritten, no foreign\\n+   `:code` is extracted, no language-pair wrapper is inserted, and the\\n+   projected value is the donor's own function cell (identity survives).\\n+\\n+   A callable value is task-local (a function is a cell, and cells are\\n+   task-local, section 8.11), so the export is answered as a node evaluated\\n+   in the caller's task, never as a host value carried between tasks.\\n+   `export-program` answers the donor's export alone as the program's value.\\n+\\n+   Every program runs linked on the three vector VMs (`semantic`, `stack`,\\n+   `register`) over the TypeScript linked harness's content store, where\\n+   `yang.call` and `js` already live and `php` is published beside them.\\n+   The AST walker is not a backend: its links are refused until L-b.\\\"\\n+  (:require\\n+    [clojure.string :as str]\\n+    [yang.core.module :as core-module]\\n+    [yang.core.names :as names]\\n+    [yang.core.uast :as u]\\n+    [yang.php.antlr.cst :as php-cst]\\n+    [yang.php.antlr.lower :as php-lower]\\n+    [yang.php.antlr.portable-harness :as php-h]\\n+    [yang.php.antlr.prelude :as php-prelude]\\n+    [yang.typescript.antlr.cst :as ts-cst]\\n+    [yang.typescript.antlr.linked-harness :as h]\\n+    [yang.typescript.antlr.lower :as ts-lower]\\n+    [yang.typescript.antlr.render :as render]\\n+    [yin.vm :as vm]))\\n+\\n+\\n+(def ^:private published-php\\n+  \\\"`php` published once into `js`'s content store, pinning the same\\n+   `yang.call` revision (as `source-call-test` publishes it).\\\"\\n+  (delay (h/publish-guest-module!\\n+           (php-prelude/module-spec (h/registry)\\n+                                    (:call-address @h/published)))))\\n+\\n+\\n+(defn- parse-ok\\n+  \\\"The CST packet of `source` under `parse`, refused unless the parse is ok.\\\"\\n+  [parse source]\\n+  (let [pk (parse source)]\\n+    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\\n+      (throw (ex-info \\\"donor or caller source does not parse\\\"\\n+                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\\n+    pk))\\n+\\n+\\n+(def frontends\\n+  \\\"Each admitted frontend's profile, as data:\\n+\\n+   - `:runtime`, `:address`: the runtime module and its published address;\\n+   - `:refusal`: the publication refusal key and reason of its modules;\\n+   - `:parse`: source text to CST packet;\\n+   - `:unit`: packet to the unmodified lowered unit, the function its\\n+     `:run-main` entry takes;\\n+   - `:read-export`: export name to the form reading the runtime's global\\n+     namespace (JS `globalThis`, PHP's named-function table);\\n+   - `:project`: name and a value form to the form binding the value where\\n+     the runtime's source resolves a called name (a JS global, a PHP\\n+     function);\\n+   - `:render`: the `:run-main` value as test data.\\\"\\n+  {:typescript\\n+   {:runtime 'js,\\n+    :address #(:address @h/published),\\n+    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\\n+    :parse #(parse-ok ts-cst/parse-source %),\\n+    :unit #(names/canonicalize (ts-lower/lower-unit %)),\\n+    :run-main 'js/run-main,\\n+    :read-export (fn [export] (list 'js/global-get {:js/str export})),\\n+    :project (fn [name value] (list 'js/define-global! name value)),\\n+    :render render/output},\\n+   :php\\n+   {:runtime 'php,\\n+    :address #(:address @published-php),\\n+    :refusal [:yang.php/refusal :yang.php/undeclared-free],\\n+    :parse #(parse-ok php-cst/parse-source %),\\n+    :unit #(u/lam [] (php-lower/lower-module-body %)),\\n+    :run-main 'php/run-main,\\n+    :read-export (fn [export]\\n+                   (list 'php/resolve-fn (str/lower-case export) export)),\\n+    :project (fn [name value]\\n+               (list 'php/declare-function! (str/lower-case name) value)),\\n+    :render php-h/render}})\\n+\\n+\\n+(defn- profile\\n+  [frontend]\\n+  (or (get frontends frontend)\\n+      (throw (ex-info \\\"frontend not admitted\\\" {:frontend frontend}))))\\n+\\n+\\n+(defn publish-donor!\\n+  \\\"Publish the donor `source` of `frontend` as the module `module` (default\\n+   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\\n+   Answers `{:frontend :module :address :links}`.\\\"\\n+  ([frontend source]\\n+   (publish-donor! frontend source (symbol (str \\\"xlang.donor.\\\" (name frontend)))))\\n+  ([frontend source module]\\n+   (let [{:keys [runtime address refusal parse unit]} (profile frontend)\\n+         [refusal-key reason] refusal\\n+         spec (core-module/module-spec\\n+                refusal-key reason (h/registry)\\n+                {:name module,\\n+                 :ast (core-module/module-tree\\n+                        [(core-module/require-node runtime)\\n+                         (u/def! 'body (unit (parse source)))]),\\n+                 :exports '#{body},\\n+                 :runtime-name runtime,\\n+                 :runtime-address (address)})\\n+         result (h/publish-guest-module! spec)]\\n+     {:frontend frontend,\\n+      :module module,\\n+      :address (:address result),\\n+      :links (:links result)})))\\n+\\n+\\n+(defn- runtime-entry\\n+  \\\"Require and initialize each distinct runtime of `frontend-keys`, once.\\\"\\n+  [frontend-keys]\\n+  (into [(core-module/require-node 'yang.call)]\\n+        (mapcat (fn [runtime]\\n+                  [(core-module/require-node runtime)\\n+                   (u/sexp->uast (list (symbol (str runtime) \\\"init!\\\")))]))\\n+        (distinct (map (comp :runtime profile) frontend-keys))))\\n+\\n+\\n+(defn- donor-run\\n+  \\\"The donor module required and its body run under its runtime's entry.\\\"\\n+  [{:keys [frontend module]}]\\n+  [(core-module/require-node module)\\n+   (u/app (u/v (:run-main (profile frontend)))\\n+          (u/v (symbol (str module) \\\"body\\\")))])\\n+\\n+\\n+(defn export-program\\n+  \\\"The program whose value is the donor's `export`, read from its runtime's\\n+   global namespace after its body ran.\\\"\\n+  [donor export]\\n+  (let [{:keys [read-export]} (profile (:frontend donor))]\\n+    (u/mark-tails\\n+      (u/seq-nodes (concat (runtime-entry [(:frontend donor)])\\n+                           (donor-run donor)\\n+                           [(u/sexp->uast (read-export export))])))))\\n+\\n+\\n+(defn compose\\n+  \\\"The caller program: the donor's body run, each name of `exports` read\\n+   from the donor runtime and projected into `caller-frontend`'s namespace\\n+   under the same name, then `caller-source`, lowered unmodified, run under\\n+   its runtime's entry. Its value is the caller entry's value.\\\"\\n+  [donor exports caller-frontend caller-source]\\n+  (let [{:keys [read-export]} (profile (:frontend donor))\\n+        {:keys [project parse unit run-main]} (profile caller-frontend)]\\n+    (u/mark-tails\\n+      (u/seq-nodes\\n+        (concat (runtime-entry [(:frontend donor) caller-frontend])\\n+                (donor-run donor)\\n+                (map (fn [export]\\n+                       (let [value (symbol (str \\\"xlang.export.\\\" export))]\\n+                         (u/let1 value\\n+                                 (u/sexp->uast (read-export export))\\n+                                 (u/sexp->uast (project export value)))))\\n+                     exports)\\n+                [(u/app (u/v run-main) (unit (parse caller-source)))])))))\\n+\\n+\\n+(defn link-source\\n+  \\\"The serving composition naming the runtimes and the donor module.\\\"\\n+  [{:keys [module address]}]\\n+  (h/source {'yang.call (:call-address @h/published),\\n+             'js (:address @h/published),\\n+             'php (:address @published-php),\\n+             module address}))\\n+\\n+\\n+(defn- modules\\n+  \\\"The host registry, admitted by every runtime profile that checks it.\\\"\\n+  []\\n+  (php-prelude/admit (h/registry)))\\n+\\n+\\n+(defn run-program\\n+  \\\"`{backend value}` of `ast`, linked against `donor`, on each vector VM.\\\"\\n+  [donor ast]\\n+  (let [src (link-source donor)]\\n+    (into (sorted-map)\\n+          (map (fn [backend]\\n+                 [backend\\n+                  (vm/value (h/run-linked backend ast {:modules (modules),\\n+                                                       :link-source src}))]))\\n+          (keys h/backends))))\\n+\\n+\\n+(defn agreed\\n+  \\\"The one value every backend of `results` answered, else\\n+   `{:disagreement results}`.\\\"\\n+  [results]\\n+  (let [vs (set (vals results))]\\n+    (if (= 1 (count vs)) (first vs) {:disagreement results})))\\n+\\n+\\n+(defn call\\n+  \\\"Publish the donor `[frontend source]`, compose its `exports` into the\\n+   caller `[frontend source]`, run it on each vector VM and answer the\\n+   caller's rendered value when every backend agrees (else\\n+   `{:disagreement {backend rendered}}`).\\\"\\n+  [[donor-frontend donor-source] exports [caller-frontend caller-source]]\\n+  (let [donor (publish-donor! donor-frontend donor-source)\\n+        render (:render (profile caller-frontend))]\\n+    (agreed (update-vals (run-program donor (compose donor exports caller-frontend\\n+                                                     caller-source))\\n+                         render))))\\ndiff --git a/test/yang/cross_lang_test.clj b/test/yang/cross_lang_test.clj\\nindex c0bd5bb0..9b1876eb 100644\\n--- a/test/yang/cross_lang_test.clj\\n+++ b/test/yang/cross_lang_test.clj\\n@@ -3,166 +3,61 @@\\n    bottom out in `:application`, and the engine neither knows nor cares which\\n    frontend minted a closure. A TypeScript function value is called from\\n    PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\\n-   VM, one run.\\n+   task, one run.\\n \\n-   The seam is the lowered tree, not a prelude change. Each direction lowers\\n-   a program normally, then (1) extracts the foreign function value by\\n-   running the donor program with its `run-main` replaced so the program's\\n-   value IS the function (`js/make-function` cell, `php/make-function` cell),\\n-   and (2) binds that value to a free variable of the receiver, replacing the\\n-   receiver's lookup node (`php/resolve-fn` of a name; `js/global-get` of a\\n-   name) by that variable. Both function values are cells whose `:code` is\\n-   called with a receiver slot and an argument vector, so the callee needs no\\n-   knowledge of the caller's prelude.\\n+   The seam is explicit published-export composition (8.10.11), owned by\\n+  