{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' test/yang/php/antlr/portable_harness.cljc; sed -n '1,130p' test/yang/php/antlr/e2e_harness.clj; sed -n '1,130p' test/yang/php/antlr/prelude_test.cljc; rg -n \\\"php/module-spec|yang.call/module-spec|module-spec\\\" test/yang/php/antlr\"","aggregated_output":"(ns yang.php.antlr.portable-harness\n  \"What the JVM, Node and Dart lanes share: the host composition the PHP\n   profile runs over, the `packet` helper that builds a CST packet from a\n   nested form, and a parserless run of a packet on the AST walker.\"\n  (:require\n    [dao.stream :as stream]\n    [dao.stream.memory-log :as memory-log]\n    [dao.stream.ringbuffer :as ringbuffer]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]\n    [yin.vm.ast-walker :as ast-walker]\n    [yin.vm.data :as data]\n    [yin.vm.integer :as integer]\n    [yin.vm.module :as module]))\n\n\n(def ^:private capability-secret \"yin.vm.test-utils/capability-secret\")\n\n\n(defn create-vm\n  \"An AST walker composed with the harness's deterministic ring-buffer stream.\"\n  ([] (create-vm {}))\n  ([opts]\n   (ast-walker/create-vm\n     (merge {:make-stream\n             (fn [capacity]\n               (ringbuffer/create!\n                 {:dao.stream/type ringbuffer/transport-type,\n                  ringbuffer/capacity-key (or capacity vm/default-stream-capacity)}))\n             :capability-secret capability-secret}\n            opts))))\n\n\n(defn- new-memory-log\n  []\n  (let [result (memory-log/create! {:dao.stream/type memory-log/transport-type})]\n    (if (= :dao.stream/ok (:dao.stream/outcome result))\n      (:dao.stream/handle result)\n      (throw (ex-info \"PHP harness memory-log creation failed\" {:result result})))))\n\n\n(defn- drain\n  [handle]\n  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\n                      [:dao.stream/cursor])]\n    (loop [cursor start, acc []]\n      (let [result (stream/next handle cursor)]\n        (if (= :dao.stream/ok (:dao.stream/outcome result))\n          (recur (:dao.stream/cursor result)\n                 (conj acc (:dao.stream/value result)))\n          acc)))))\n\n\n(def integer-limits\n  \"The `integer` limits the PHP compositions here install.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(def data-limits {::data/max-items 1048576})\n\n\n(defn host-registry\n  \"The registry with the cell, data and integer modules installed, admitted\n   by the PHP profile.\"\n  []\n  (-> (module/empty-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      prelude/admit))\n\n\n(defn linked-registry\n  \"`host-registry` over the default registry, whose `require` handlers the\n   linked profile needs.\"\n  []\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      prelude/admit))\n\n\n(defn packet\n  \"A CST packet from a nested form: `[rule child ...]` for a rule (a keyword)\n   and `[type text]` (type a string) for a token. Spans are zero-width: the\n   lowering reads them only for diagnostics. Ids are preorder, as the parser\n   numbers them, so generated names match a parsed packet's.\"\n  [form]\n  (let [out (volatile! [])]\n    (letfn [(walk\n              [f]\n              (let [id (count @out)]\n                (if (string? (first f))\n                  (vswap! out conj {:id id, :kind :token, :type (first f),\n                                    :text (second f), :span [0 0]})\n                  (do (vswap! out conj nil)\n                      (let [kids (mapv walk (rest f))]\n                        (vswap! out assoc id {:id id, :kind :rule,\n                                              :rule (name (first f)),\n                                              :children kids, :span [0 0]}))))\n                id))]\n      (walk form))\n    {:yang.cst/version 1,\n     :yang.cst/unit [:hand 0],\n     :yang.cst/grammar \"hand\",\n     :yang.cst/outcome :yang.cst/ok,\n     :yang.cst/root 0,\n     :yang.cst/nodes @out,\n(ns yang.php.antlr.e2e-harness\n  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n   program envelope -> the bundled program on each of the four VMs. Output\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n   here at the boundary.\"\n  (:require\n    [dao.host.text :as text]\n    [dao.stream :as stream]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn host-registry\n  \"The registry the PHP compositions run over.\"\n  []\n  (portable/host-registry))\n\n\n(def ^:private base-opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\"\n  [source]\n  (let [cst-log (tu/new-memory-log)\n        program (tu/new-memory-log)\n        diagnostics (tu/new-memory-log)]\n    (stream/append! cst-log (cst/parse-source source))\n    (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                        {:medium lower/program-medium}))\n    (let [{warnings true, problems false}\n          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n      (if (seq problems)\n        {:diagnostics problems}\n        (let [{:yin/keys [batch root]} (first (tu/drain program))]\n          {:ast (nth batch root), :warnings (vec warnings)})))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`.\"\n  [registry ast]\n  (let [opts (assoc base-opts :modules registry)\n        session (tu/make-observer-session (tu/create-vm {:modules registry}))\n        datoms (vec (vm/ast->datoms ast))\n        projected #(:vector (sr-linearize/project ast))\n        attempt (fn [f]\n                  (try (render (f))\n                       (catch Exception e [:thrown (ex-message e)])))]\n    (tu/queue-ast! session ast)\n    {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n     :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n                                                          datoms)))),\n     :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                          (:image (derive/stack-image (projected)))\n                                          (assoc opts :contract vm/stack-contract))))),\n     :register (attempt #(vm/value (vm/run (rvm/create-vm\n                                             (derive/register-image (projected))\n                                             (assoc opts\n                                                    :contract\n                                                    vm/register-contract)))))}))\n\n\n(defn run-php\n  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`.\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics {:diagnostics diagnostics} (run-vms (host-registry) ast))))\n\n\n(defn run-walker\n  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [registry (host-registry)\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n        (tu/queue-ast! session ast)\n        (try (render (vm/value (:consumer (tu/run-session session))))\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, on the AST walker.\"\n(ns yang.php.antlr.prelude-test\n  \"The PHP prelude's static contract on every host: the bundled program is\n   closed over its own definitions, the declared host names and the\n   primitives; it never reaches `dao.host.*`; the lowered program names no\n   runtime key; the module emitter's exports and manifest cover the same\n   list.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.walk :as walk]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.portable-harness :as h]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]))\n\n\n(def ^:private closed-names\n  (into (conj (prelude/defined-keys prelude/uast) 'yin/def)\n        (concat prelude/host-names (keys vm/primitives))))\n\n\n(deftest bundled-prelude-is-closed-test\n  (is (empty? (remove closed-names (prelude/free-names prelude/uast)))))\n\n\n(deftest prelude-reaches-no-dao-host-test\n  (is (not-any? #(str/starts-with? (str %) \"dao.host\") (prelude/free-names prelude/uast)))\n  (is (every? #(contains? #{\"cell\" \"data\" \"integer\"} (namespace %))\n              prelude/host-names)))\n\n\n(deftest lowered-program-names-no-runtime-key-test\n  (doseq [[id form] packets/forms\n          :let [free (prelude/free-names (lower/lower-module-body (h/packet form)))]]\n    (is (empty? (remove closed-names free)) (name id))\n    (is (not-any? #(= \"php.rt\" (namespace %)) free) (name id))))\n\n\n(deftest module-exports-cover-the-definitions-test\n  (is (contains? prelude/module-exports 'init!))\n  (is (contains? prelude/module-exports 'echo))\n  (is (not-any? #(= \"php.rt\" (namespace %)) prelude/module-exports))\n  (is (every? symbol? prelude/runtime-keys)))\n\n\n(deftest admit-refuses-a-registry-without-the-host-names-test\n  (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs ExceptionInfo :cljd Object)\n        (prelude/admit {}))))\n\n\n(deftest module-spec-declares-every-free-name-test\n  (testing \"over the real host registry the manifest builds, or refuses\"\n    (let [spec (prelude/module-spec (h/host-registry))]\n      (is (= 'php (:name spec)))\n      (is (= prelude/module-exports (:exports spec)))\n      (is (every? (:primitives spec) (filter #(= \"integer\" (namespace %)) prelude/host-names))))))\n\n\n(deftest static-slot-initializes-once-when-first-reached-test\n  (let [body (u/sexp->uast\n               '(let [f (php/make-function\n                          \"f\"\n                          0\n                          (fn [me as]\n                            (do (php/echo \"enter;\")\n                                (php/static-init! me \"n\" (fn [] (do (php/echo \"init;\") 5)))\n                                (cell/set! (php/static-slot me \"n\")\n                                           (+ (cell/get (php/static-slot me \"n\")) 1))\n                                (php/echo (php/to-string (cell/get (php/static-slot me \"n\"))))\n                                (if (< (data/count as) 1) :php/null (php/call me []))))\n                          [\"n\"])]\n                  (do (php/call f []) (php/call f []) (php/call f []) (php/call f [0]))))\n        program (u/mark-tails (u/then prelude/uast (u/app (u/v 'php/run-main) (u/lam [] body))))]\n    (is (= \"enter;init;6enter;7enter;8enter;9enter;10\"\n           (h/render (vm/value (vm/eval (h/create-vm {:modules (h/host-registry)}) program)))))))\n\n\n;; -----------------------------------------------------------------------------\n;; The array value (P2 step 1): direct prelude tests, on every host\n;; -----------------------------------------------------------------------------\n\n(defn- run-raw\n  \"The unit value of the prelude expression `form` run under `php/run-main`.\"\n  [form]\n  (let [program (u/mark-tails\n                  (u/then prelude/uast\n                          (u/app (u/v 'php/run-main) (u/lam [] (u/sexp->uast form)))))]\n    (vm/value (vm/eval (h/create-vm {:modules (h/host-registry)}) program))))\n\n\n(defn- run\n  [form]\n  (h/render (run-raw form)))\n\n\n(defn- diag\n  [r]\n  (mapv (juxt :errno :message) (:php/diag r)))\n\n\n(defn- dump\n  \"`php/var-dump` of the expression `form`, as text.\"\n  [form]\n  (run (list 'php/var-dump form)))\n\n\n(defn- echo-next\n  \"The `:next-index` of the array expression `form`, as text (`none` if absent).\"\n  [form]\n  (run (list 'let ['n (list 'get form :next-index)]\n             (list 'php/echo\n                   (list 'if '(nil? n) \"none\" '(php/to-string n))))))\n\n\n(defn- echo-key\n  \"The i-th key of the array expression `form`, as text.\"\n  [form i]\n  (run (list 'php/echo