{"role":"tool","tool_call_id":"tool_QpO2T8I4L5coMgCnolErYws6","content":"1\t(ns yang.php.antlr.request-context-test\n2\t  \"P5 request records, response records, output buffering and isolation.\"\n3\t  (:require\n4\t    [clojure.test :refer [deftest is testing]]\n5\t    [yang.php.antlr.e2e-harness :as h]\n6\t    [yang.php.antlr.programs-p5 :as p5]))\n7\t\n8\t\n9\t(defn- diagnostics\n10\t  [r]\n11\t  (mapv (juxt :errno :message) (:php/diag r)))\n12\t\n13\t\n14\t(deftest request-binding-smoke-test\n15\t  (is (= \"1\" (:php/out (h/run-raw \"<?php echo 1;\" {})))))\n16\t\n17\t\n18\t(deftest request-context-fixtures-test\n19\t  (doseq [{:keys [id source request out diag response status]} p5/fixtures]\n20\t    (testing (name id)\n21\t      (let [r (h/run-raw source request)]\n22\t        (is (= out (:php/out r)))\n23\t        (is (= (vec diag) (diagnostics r)))\n24\t        (when response (is (= response (:php/response r))))\n25\t        (when status (is (= status (:php/status r))))\n26\t        (is (nil? (:php/uncaught r)))))))\n27\t\n28\t\n29\t(deftest requests-in-separate-tasks-share-nothing-test\n30\t  (let [source (str \"<?php header('X-Request: ' . $_GET['value']);\"\n31\t                    \" echo $_GET['value']; $_GET['value'] = 'changed';\")\n32\t        request-a (assoc p5/request :php.request/query (p5/request-array [[\"value\" \"A\"]]))\n33\t        request-b (assoc p5/request :php.request/query (p5/request-array [[\"value\" \"B\"]]))\n34\t        a (h/run-raw source request-a)\n35\t        b (h/run-raw source request-b)]\n36\t    (is (= \"A\" (:php/out a)))\n37\t    (is (= \"B\" (:php/out b)))\n38\t    (is (= [{:php.response/header \"X-Request: A\", :replace true}\n39\t            {:php.response/body \"A\"}]\n40\t           (:php/response a)))\n41\t    (is (= [{:php.response/header \"X-Request: B\", :replace true}\n42\t            {:php.response/body \"B\"}]\n43\t           (:php/response b)))\n44\t    (is (empty? (:php/diag a)))\n45\t    (is (empty? (:php/diag b)))))"}
{"role":"tool","tool_call_id":"tool_97kcFrJRtaEkk9za9524Am5o","content":"1\t(ns yang.php.antlr.builtins\n2\t  \"The pinned PHP builtin catalogue (docs/design/yang.php.md section 3.8): the\n3\t   lower-cased names of the PHP 8.3 core functions a program is likely to\n4\t   call. A call to a name in this set that is neither declared by the unit nor\n5\t   supplied by the prelude gets the `:yang.php/unknown-builtin` warning\n6\t   diagnostic at lowering, so an unsupported library function fails honestly\n7\t   before the program runs. At run time such a call is still\n8\t   `Error: Call to undefined function`; nothing is stubbed to return\n9\t   success. The list is checked in, not derived: regenerate it from\n10\t   `get_defined_functions()['internal']` of the pinned PHP when the target\n11\t   version moves.\")\n12\t\n13\t\n14\t(def supported\n15\t  \"The builtins the prelude supplies: lower-cased PHP name to the prelude\n16\t   definition that implements it and, for a by-reference builtin, the\n17\t   by-reference argument positions (`:by-ref`). The prelude derives its\n18\t   registration from this table and the lowering reads `:by-ref`, so a\n19\t   position is stated once. A by-reference builtin answers `[ret outs]`.\"\n20\t  (let [plain (fn [m] (into {} (map (fn [[k v]] [k {:prelude v}])) m))\n21\t        by-ref (fn [m] (into {} (map (fn [[k v]] [k {:prelude v, :by-ref [0]}])) m))]\n22\t    (merge\n23\t      (plain {\"var_dump\" 'php/bi-var-dump, \"intdiv\" 'php/bi-intdiv, \"fmod\" 'php/bi-fmod,\n24\t              \"strlen\" 'php/bi-strlen, \"intval\" 'php/bi-intval, \"floatval\" 'php/bi-floatval,\n25\t              \"strval\" 'php/bi-strval, \"boolval\" 'php/bi-boolval, \"is_nan\" 'php/bi-is-nan,\n26\t              \"set_error_handler\" 'php/bi-set-error-handler,\n27\t              \"restore_error_handler\" 'php/bi-restore-error-handler,\n28\t              \"error_reporting\" 'php/bi-error-reporting,\n29\t              \"trigger_error\" 'php/bi-trigger-error, \"user_error\" 'php/bi-trigger-error,\n30\t              \"ob_start\" 'php/bi-ob-start, \"ob_get_contents\" 'php/bi-ob-get-contents,\n31\t              \"ob_get_clean\" 'php/bi-ob-get-clean, \"ob_end_clean\" 'php/bi-ob-end-clean,\n32\t              \"ob_end_flush\" 'php/bi-ob-end-flush,\n33\t              \"header\" 'php/bi-header, \"headers_sent\" 'php/bi-headers-sent,\n34\t              \"http_response_code\" 'php/bi-http-response-code,\n35\t              \"setcookie\" 'php/bi-setcookie, \"setrawcookie\" 'php/bi-setrawcookie,\n36\t              \"php_sapi_name\" 'php/php-sapi-name, \"getenv\" 'php/bi-getenv,\n37\t              \"count\" 'php/bi-count, \"sizeof\" 'php/bi-count,\n38\t              \"array_keys\" 'php/bi-array-keys, \"array_values\" 'php/bi-array-values,\n39\t              \"array_merge\" 'php/bi-array-merge,\n40\t              \"current\" 'php/bi-current, \"pos\" 'php/bi-current, \"key\" 'php/bi-key,\n41\t              \"implode\" 'php/bi-implode, \"join\" 'php/bi-implode, \"array_sum\" 'php/bi-array-sum,\n42\t              \"array_key_exists\" 'php/bi-array-key-exists,\n43\t              \"key_exists\" 'php/bi-array-key-exists, \"in_array\" 'php/bi-in-array,\n44\t              \"is_array\" 'php/bi-is-array, \"array_key_first\" 'php/bi-array-key-first,\n45\t              \"array_key_last\" 'php/bi-array-key-last, \"get_class\" 'php/bi-get-class,\n46\t              \"register_shutdown_function\" 'php/bi-register-shutdown-function,\n47\t              \"define\" 'php/bi-define, \"defined\" 'php/bi-defined, \"constant\" 'php/bi-constant,\n48\t              \"function_exists\" 'php/bi-function-exists, \"class_exists\" 'php/bi-class-exists,\n49\t              \"spl_autoload_register\" 'php/bi-spl-autoload-register,\n50\t              \"spl_autoload_unregister\" 'php/bi-spl-autoload-unregister,\n51\t              \"spl_autoload_functions\" 'php/bi-spl-autoload-functions,\n52\t              \"spl_autoload_call\" 'php/bi-spl-autoload-call,\n53\t              \"set_exception_handler\" 'php/bi-set-exception-handler,\n54\t              \"restore_exception_handler\" 'php/bi-restore-exception-handler,\n55\t              \"substr\" 'php/bi-substr, \"strpos\" 'php/bi-strpos, \"stripos\" 'php/bi-stripos,\n56\t              \"strrpos\" 'php/bi-strrpos, \"str_replace\" 'php/bi-str-replace,\n57\t              \"str_ireplace\" 'php/bi-str-ireplace, \"str_contains\" 'php/bi-str-contains,\n58\t              \"str_starts_with\" 'php/bi-str-starts-with, \"str_ends_with\" 'php/bi-str-ends-with,\n59\t              \"trim\" 'php/bi-trim, \"ltrim\" 'php/bi-ltrim, \"rtrim\" 'php/bi-rtrim,\n60\t              \"strtolower\" 'php/bi-strtolower, \"strtoupper\" 'php/bi-strtoupper,\n61\t              \"str_repeat\" 'php/bi-str-repeat, \"str_pad\" 'php/bi-str-pad, \"strrev\" 'php/bi-strrev,\n62\t              \"strcmp\" 'php/bi-strcmp, \"strcasecmp\" 'php/bi-strcasecmp, \"strncmp\" 'php/bi-strncmp,\n63\t              \"strstr\" 'php/bi-strstr, \"strrchr\" 'php/bi-strrchr, \"substr_count\" 'php/bi-substr-count,\n64\t              \"nl2br\" 'php/bi-nl2br, \"htmlspecialchars\" 'php/bi-htmlspecialchars,\n65\t              \"html_entity_decode\" 'php/bi-html-entity-decode, \"addslashes\" 'php/bi-addslashes,\n66\t              \"stripslashes\" 'php/bi-stripslashes, \"ord\" 'php/bi-ord, \"chr\" 'php/bi-chr,\n67\t              \"bin2hex\" 'php/bi-bin2hex, \"hex2bin\" 'php/bi-hex2bin, \"explode\" 'php/bi-explode,\n68\t              \"str_split\" 'php/bi-str-split, \"array_reverse\" 'php/bi-array-reverse,\n69\t              \"array_product\" 'php/bi-array-product, \"array_search\" 'php/bi-array-search,\n70\t              \"array_is_list\" 'php/bi-array-is-list, \"array_fill\" 'php/bi-array-fill,\n71\t              \"array_fill_keys\" 'php/bi-array-fill-keys, \"array_combine\" 'php/bi-array-combine,\n72\t              \"array_flip\" 'php/bi-array-flip, \"array_pad\" 'php/bi-array-pad,\n73\t              \"array_chunk\" 'php/bi-array-chunk, \"array_column\" 'php/bi-array-column,\n74\t              \"array_slice\" 'php/bi-array-slice, \"array_map\" 'php/bi-array-map, \"array_filter\" 'php/bi-array-filter,\n75\t              \"array_reduce\" 'php/bi-array-reduce, \"array_unique\" 'php/bi-array-unique,\n76\t              \"array_diff\" 'php/bi-array-diff, \"array_intersect\" 'php/bi-array-intersect,\n77\t              \"array_diff_key\" 'php/bi-array-diff-key, \"array_intersect_key\" 'php/bi-array-intersect-key,\n78\t              \"range\" 'php/bi-range, \"array_multisort\" 'php/bi-array-multisort,\n79\t              \"abs\" 'php/bi-abs, \"ceil\" 'php/bi-ceil, \"floor\" 'php/bi-floor,\n80\t              \"round\" 'php/bi-round, \"sqrt\" 'php/bi-sqrt, \"pow\" 'php/bi-pow,\n81\t              \"min\" 'php/bi-min, \"max\" 'php/bi-max, \"is_finite\" 'php/bi-is-finite,\n82\t              \"is_infinite\" 'php/bi-is-infinite, \"json_encode\" 'php/bi-json-encode,\n83\t              \"json_decode\" 'php/bi-json-decode})\n84\t      (by-ref {\"next\" 'php/bi-next, \"prev\" 'php/bi-prev, \"reset\" 'php/bi-reset, \"end\" 'php/bi-end,\n85\t               \"array_push\" 'php/bi-array-push, \"array_pop\" 'php/bi-array-pop,\n86\t               \"array_shift\" 'php/bi-array-shift, \"array_unshift\" 'php/bi-array-unshift,\n87\t               \"array_splice\" 'php/bi-array-splice, \"sort\" 'php/bi-sort, \"rsort\" 'php/bi-rsort, \"asort\" 'php/bi-asort,\n88\t               \"arsort\" 'php/bi-arsort, \"ksort\" 'php/bi-ksort, \"krsort\" 'php/bi-krsort,\n89\t               \"usort\" 'php/bi-usort, \"uasort\" 'php/bi-uasort, \"uksort\" 'php/bi-uksort}))))\n90\t\n91\t\n92\t(def catalogue\n93\t  #{;; strings\n94\t    \"addslashes\" \"bin2hex\" \"chr\" \"chunk_split\" \"count_chars\" \"crc32\" \"explode\"\n95\t    \"html_entity_decode\" \"htmlentities\" \"htmlspecialchars\" \"implode\" \"join\"\n96\t    \"lcfirst\" \"levenshtein\" \"ltrim\" \"md5\" \"nl2br\" \"number_format\" \"ord\"\n97\t    \"printf\" \"rtrim\" \"sha1\" \"similar_text\" \"sprintf\" \"str_contains\"\n98\t    \"str_ends_with\" \"str_pad\" \"str_repeat\" \"str_replace\" \"str_split\"\n99\t    \"str_starts_with\" \"str_word_count\" \"strcasecmp\" \"strcmp\" \"strip_tags\"\n100\t    \"stripos\" \"stripslashes\" \"stristr\" \"strnatcmp\" \"strncasecmp\" \"strncmp\"\n101\t    \"strpos\" \"strrchr\" \"strrev\" \"strripos\" \"strrpos\" \"strstr\" \"strtolower\"\n102\t    \"strtoupper\" \"strtr\" \"substr\" \"substr_count\" \"substr_replace\" \"trim\"\n103\t    \"ucfirst\" \"ucwords\" \"vsprintf\" \"wordwrap\"\n104\t    ;; multibyte\n105\t    \"mb_strlen\" \"mb_substr\" \"mb_strtolower\" \"mb_strtoupper\" \"mb_strpos\"\n106\t    \"mb_str_split\" \"mb_internal_encoding\" \"mb_strwidth\"\n107\t    ;; arrays\n108\t    \"array_chunk\" \"array_column\" \"array_combine\" \"array_count_values\"\n109\t    \"array_diff\" \"array_diff_key\" \"array_fill\" \"array_fill_keys\" \"array_filter\"\n110\t    \"array_flip\" \"array_intersect\" \"array_intersect_key\" \"array_is_list\"\n111\t    \"array_key_exists\" \"array_key_first\" \"array_key_last\" \"array_keys\"\n112\t    \"array_map\" \"array_merge\" \"array_merge_recursive\" \"array_multisort\"\n113\t    \"array_pad\" \"array_pop\" \"array_product\" \"array_push\" \"array_rand\"\n114\t    \"array_reduce\" \"array_replace\" \"array_reverse\" \"array_search\" \"array_shift\"\n115\t    \"array_slice\" \"array_splice\" \"array_sum\" \"array_unique\" \"array_unshift\"\n116\t    \"array_values\" \"array_walk\" \"arsort\" \"asort\" \"compact\" \"count\" \"current\"\n117\t    \"end\" \"extract\" \"in_array\" \"key\" \"krsort\" \"ksort\" \"list\" \"natsort\" \"next\"\n118\t    \"prev\" \"range\" \"reset\" \"rsort\" \"shuffle\" \"sizeof\" \"sort\" \"uasort\" \"uksort\"\n119\t    \"usort\"\n120\t    ;; math\n121\t    \"abs\" \"acos\" \"asin\" \"atan\" \"atan2\" \"base_convert\" \"bindec\" \"ceil\" \"cos\"\n122\t    \"decbin\" \"dechex\" \"decoct\" \"deg2rad\" \"exp\" \"floor\" \"hexdec\" \"hypot\"\n123\t    \"is_finite\" \"is_infinite\" \"log\" \"log10\" \"log2\" \"max\" \"min\" \"mt_getrandmax\"\n124\t    \"mt_rand\" \"mt_srand\" \"octdec\" \"pi\" \"pow\" \"rad2deg\" \"rand\" \"random_int\"\n125\t    \"round\" \"sin\" \"sqrt\" \"srand\" \"tan\"\n126\t    ;; variables and types\n127\t    \"boolval\" \"empty\" \"floatval\" \"gettype\" \"get_debug_type\" \"intval\" \"is_array\"\n128\t    \"is_bool\" \"is_callable\" \"is_countable\" \"is_float\" \"is_int\" \"is_integer\"\n129\t    \"is_iterable\" \"is_null\" \"is_numeric\" \"is_object\" \"is_scalar\" \"is_string\"\n130\t    \"isset\" \"print_r\" \"serialize\" \"settype\" \"strval\" \"unserialize\" \"unset\"\n131\t    \"var_export\" \"json_encode\" \"json_decode\"\n132\t    ;; functions and classes\n133\t    \"call_user_func\" \"call_user_func_array\" \"class_exists\" \"func_get_arg\"\n134\t    \"func_get_args\" \"func_num_args\" \"function_exists\" \"get_class\"\n135\t    \"get_object_vars\" \"method_exists\" \"property_exists\" \"spl_autoload_register\"\n136\t    \"spl_object_id\" \"iterator_to_array\"\n137\t    ;; output, errors, runtime\n138\t    \"assert\" \"debug_zval_refcount\" \"error_log\" \"flush\" \"ini_get\" \"ini_set\"\n139\t    \"ob_end_clean\" \"ob_end_flush\" \"ob_get_clean\" \"ob_get_contents\" \"ob_start\"\n140\t    \"set_exception_handler\" \"trigger_error\" \"user_error\" \"usleep\" \"sleep\"\n141\t    \"memory_get_usage\" \"microtime\" \"time\" \"date\" \"mktime\" \"strtotime\"\n142\t    \"date_default_timezone_set\" \"hrtime\" \"uniqid\" \"define\" \"defined\"\n143\t    \"constant\" \"php_sapi_name\" \"phpversion\" \"getenv\" \"gc_collect_cycles\"\n144\t    \"file_get_contents\" \"file_put_contents\" \"fopen\" \"fclose\" \"fwrite\" \"fgets\"\n145\t    \"file_exists\" \"preg_match\" \"preg_match_all\" \"preg_replace\" \"preg_split\"\n146\t    \"preg_quote\" \"preg_replace_callback\"})\n147\t\n148\t\n149\t(def constants\n150\t  \"The builtin constants (plan P6 R7), name to value, read by the lowering\n151\t   (a fold in the global block and at fully qualified reads) and by\n152\t   `php/init!` (seeding `php.rt/constants`, so `defined` and `constant`\n153\t   agree with the folded literals). A plain value is its own literal; the\n154\t   vector forms stand for the values a literal cannot express:\n155\t   `[:int text]` an integer past the reader's range, `:nan`, `:inf`,\n156\t   `[:float text value]`.\"\n157\t  (merge\n158\t    {\"PHP_INT_MAX\" [:int \"9223372036854775807\"],\n159\t     \"PHP_INT_MIN\" [:int \"-9223372036854775808\"],\n160\t     \"PHP_INT_SIZE\" 8,\n161\t     \"PHP_EOL\" \"\\n\",\n162\t     \"NAN\" :nan,\n163\t     \"INF\" :inf,\n164\t     \"M_PI\" [:float \"3.141592653589793\" 3.141592653589793],\n165\t     \"EXTR_OVERWRITE\" 0, \"EXTR_SKIP\" 1, \"EXTR_PREFIX_SAME\" 2, \"EXTR_PREFIX_ALL\" 3,\n166\t     \"EXTR_INVALID\" 4, \"EXTR_PREFIX_INVALID\" 5, \"EXTR_IF_EXISTS\" 6,\n167\t     \"EXTR_PREFIX_IF_EXISTS\" 7, \"EXTR_ONLY_IF_EXISTS\" 8, \"EXTR_REFS\" 256,\n168\t     \"JSON_OBJECT_AS_ARRAY\" 1, \"JSON_PRETTY_PRINT\" 128, \"JSON_THROW_ON_ERROR\" 4194304,\n169\t     \"STR_PAD_RIGHT\" 1, \"STR_PAD_LEFT\" 0, \"STR_PAD_BOTH\" 2}\n170\t    (zipmap [\"SORT_REGULAR\" \"SORT_NUMERIC\" \"SORT_STRING\" \"SORT_FLAG_CASE\" \"SORT_NATURAL\"\n171\t             \"COUNT_NORMAL\" \"COUNT_RECURSIVE\" \"E_ERROR\" \"E_WARNING\" \"E_PARSE\" \"E_NOTICE\"\n172\t             \"E_CORE_ERROR\" \"E_CORE_WARNING\" \"E_COMPILE_ERROR\" \"E_COMPILE_WARNING\"\n173\t             \"E_USER_ERROR\" \"E_USER_WARNING\" \"E_USER_NOTICE\" \"E_STRICT\"\n174\t             \"E_RECOVERABLE_ERROR\" \"E_DEPRECATED\" \"E_USER_DEPRECATED\" \"E_ALL\"]\n175\t            [0 1 2 8 6 0 1 1 2 4 8 16 32 64 128 256 512 1024 2048 4096 8192 16384 32767])))"}
