{"role":"assistant","tool_calls":[{"type":"function","id":"tool_9IMha6gTdZSu5yujkDvOzXp5","function":{"name":"Grep","arguments":"{\"path\":\"src/cljc/yang/php/antlr/prelude.cljc\",\"pattern\":\"\\\\[php/(abs|ceil|floor|round|sqrt|pow|min|max|to-float|to-int|float-text|float-key|array-set|array-append|array-values|spread-loop|array-filter)\",\"output_mode\":\"content\",\"-C\":2,\"head_limit\":300}"}},{"type":"function","id":"tool_czgRpOA9sBltQ3kXSAvSdYbX","function":{"name":"Grep","arguments":"{\"path\":\"src/cljc\",\"pattern\":\"json/|json-encode|json-decode|write-str|read-str\",\"glob\":\"*.cljc\",\"output_mode\":\"files_with_matches\",\"head_limit\":100}"}},{"type":"function","id":"tool_FChaYZrR5tRUPeT2ZgFqIxf9","function":{"name":"Grep","arguments":"{\"path\":\"src/cljc/yin\",\"pattern\":\"def.*(sqrt|sin|cos|floor|ceil)|Math/|js/Math|math/\",\"glob\":\"*.cljc\",\"output_mode\":\"content\",\"-C\":2,\"head_limit\":200}"}},{"type":"function","id":"tool_qHt3ivV8TmI7vT4zI42l493O","function":{"name":"Read","arguments":"{\"path\":\"src/cljc/yin/vm/data.cljc\",\"line_offset\":1,\"n_lines\":250}"}},{"type":"function","id":"tool_Sf5QUzHCPOukBh5gHMQqdP8R","function":{"name":"Read","arguments":"{\"path\":\"src/cljc/yang/php/antlr/prelude.cljc\",\"line_offset\":4990,\"n_lines\":448}"}}]}
{"role":"tool","tool_call_id":"tool_qHt3ivV8TmI7vT4zI42l493O","content":"1\t(ns yin.vm.data\n2\t  \"The `data` host module: pure collection and string primitives a\n3\t   language prelude is written over (Architect ruling on mutable guest\n4\t   objects, Q5 and Q6).\n5\t\n6\t   Every export is `:pure` with declared effects `#{}`. The module is not\n7\t   part of `yin.vm/primitives`: a composition whose language runtime\n8\t   profile names it installs it explicitly with `register-data-module`,\n9\t   and Yin source reaches the exports as `data/count`, `data/substring`\n10\t   and so on. Under explicit limits it also exports `max-items`, the\n11\t   composition's sequence-size limit (`register-data-module`).\n12\t\n13\t   Results are identical on CLJ, CLJS and CLJD:\n14\t\n15\t   - Strings are indexed by code point, as Python indexes them, never by\n16\t     the hosts' UTF-16 code units: `(data/str-length \\\"a😀\\\")` is 2 on\n17\t     every host. An unpaired surrogate is one code point of its own.\n18\t   - `str-compare` orders by code point, which UTF-16 unit order does not\n19\t     for supplementary characters against U+E000 to U+FFFF.\n20\t   - Every string call decodes its whole argument, O(n), and search is a\n21\t     naive O(n*m) scan: a prelude loop over a string's characters calls\n22\t     `str->code-points` once and walks the vector with `nth`, never\n23\t     `char-at` per step.\n24\t   - An index is any number with an integral value, so `1.0` is index 1\n25\t     on the JVM as it is on JS and Dart, which cannot tell it from `1`.\n26\t   - Nothing iterates a host map or a host set into an ordered result:\n27\t     host iteration order differs by host. An ordered dict is prelude\n28\t     code, an index map beside an order vector.\n29\t   - A refused call throws `ex-info` with the message `refusal-message`\n30\t     and ex-data built here, never host exception text: `::op`,\n31\t     `::reason` (`:arity`, `:wrong-type`, `:out-of-range` or\n32\t     `:empty-separator`), and the reason's own keys.\n33\t\n34\t   Key equality in `contains?`, `dissoc`, `disj`, `hash-set` and `into` a\n35\t   set is the host's `=`, which differs for `1` and `1.0` on the JVM. A\n36\t   runtime profile normalizes guest keys before they reach these.\"\n37\t  (:require\n38\t    [clojure.string :as str]\n39\t    [dao.host.float :as float]\n40\t    [dao.host.integer :as integer-host]\n41\t    [dao.host.text :as text]\n42\t    [dao.jing.cbor :as cbor]\n43\t    [yin.vm :as vm]\n44\t    [yin.vm.module :as module]\n45\t    [yin.vm.values :as values])\n46\t  #?(:cljd (:import [\"dart:core\" BigInt])))\n47\t\n48\t\n49\t(def module-name\n50\t  \"The module `register-data-module` installs.\"\n51\t  'data)\n52\t\n53\t\n54\t(def refusal-message\n55\t  \"The message of every refusal a `data` export throws.\"\n56\t  \"data primitive refused\")\n57\t\n58\t\n59\t(defn- refuse!\n60\t  [op reason data]\n61\t  (throw (ex-info refusal-message (merge {::op op, ::reason reason} data))))\n62\t\n63\t\n64\t(defn- wrong-type!\n65\t  \"Refuse argument `arg` (0-based) of `op`, which must be `expected`.\"\n66\t  [op arg expected]\n67\t  (refuse! op :wrong-type {::arg arg, ::expected expected}))\n68\t\n69\t\n70\t;; =============================================================================\n71\t;; Indices\n72\t;; =============================================================================\n73\t\n74\t(def ^:private max-safe\n75\t  \"The largest integer every host represents exactly, 2^53 - 1.\"\n76\t  9007199254740991)\n77\t\n78\t\n79\t(def ^:private max-safe-big (integer-host/from-native max-safe))\n80\t(def ^:private min-safe-big (integer-host/from-native (- max-safe)))\n81\t\n82\t\n83\t(defn- integral\n84\t  \"`x` as an integer when it is a number with an integral value within\n85\t   +/- `max-safe`, else nil. The bound keeps an index identical on hosts\n86\t   whose large numbers are doubles. An exact integer in any carrier\n87\t   answers its canonical carrier; a host double answers its truncation\n88\t   when it is integral (`dao.host.float/integral?`); any other number\n89\t   (a JVM ratio, decimal or `float`) is nil.\"\n90\t  [x]\n91\t  (cond\n92\t    (integer-host/safe-native? x) x\n93\t    (integer-host/exact-integer? x)\n94\t    (let [b (integer-host/promote x)]\n95\t      (when (and (<= 0 (integer-host/compare-big b min-safe-big))\n96\t                 (<= (integer-host/compare-big b max-safe-big) 0))\n97\t        (integer-host/demote b)))\n98\t    (integer-host/host-float? x)\n99\t    (when (and (float/integral? x) (<= (- max-safe) x max-safe))\n100\t      (integer-host/trunc-native x))\n101\t    :else nil))\n102\t\n103\t\n104\t(defn- index!\n105\t  \"Argument `arg` of `op` as an integer, or a `:wrong-type` refusal.\"\n106\t  [op arg x]\n107\t  (let [i (integral x)]\n108\t    (if (nil? i)\n109\t      (wrong-type! op arg :integer)\n110\t      i)))\n111\t\n112\t\n113\t(defn- in-range!\n114\t  \"Refuse `i` unless `lo <= i <= hi`. `::index` is always the position\n115\t   the call would access: the caller's index, or for `pop` the last\n116\t   index, `(count v) - 1`, so an empty vector reports `::hi` -1 for\n117\t   both `nth` and `pop`.\"\n118\t  [op i lo hi]\n119\t  (when-not (<= lo i hi)\n120\t    (refuse! op :out-of-range {::index i, ::lo lo, ::hi hi}))\n121\t  i)\n122\t\n123\t\n124\t;; =============================================================================\n125\t;; Code points\n126\t;; =============================================================================\n127\t\n128\t(defn- code-points->string\n129\t  \"The string of code points `cps`, each already checked to lie in\n130\t   0 to 0x10FFFF.\"\n131\t  [cps]\n132\t  (text/units->string\n133\t    (mapcat (fn [cp]\n134\t              (if (< cp 0x10000)\n135\t                [cp]\n136\t                (let [c (- cp 0x10000)]\n137\t                  [(+ 0xD800 (quot c 0x400)) (+ 0xDC00 (rem c 0x400))])))\n138\t            cps)))\n139\t\n140\t\n141\t(defn- string!\n142\t  [op arg x]\n143\t  (when-not (string? x)\n144\t    (wrong-type! op arg :string))\n145\t  x)\n146\t\n147\t\n148\t(defn- find-code-points\n149\t  \"The first index at or after `from` where `needle` occurs in `hay`,\n150\t   both code point vectors, or -1.\"\n151\t  [hay needle from]\n152\t  (let [m (count needle)\n153\t        last-start (- (count hay) m)]\n154\t    (loop [i from]\n155\t      (cond (> i last-start) -1\n156\t            (= needle (subvec hay i (+ i m))) i\n157\t            :else (recur (inc i))))))\n158\t\n159\t\n160\t;; =============================================================================\n161\t;; Collection exports\n162\t;; =============================================================================\n163\t\n164\t(defn- data-count\n165\t  [coll]\n166\t  (if (or (nil? coll) (coll? coll))\n167\t    (count coll)\n168\t    (wrong-type! 'count 0 :collection)))\n169\t\n170\t\n171\t(defn- vector!\n172\t  [op arg x]\n173\t  (when-not (vector? x)\n174\t    (wrong-type! op arg :vector))\n175\t  x)\n176\t\n177\t\n178\t(defn- data-nth\n179\t  [v i]\n180\t  (vector! 'nth 0 v)\n181\t  (let [i (index! 'nth 1 i)]\n182\t    (in-range! 'nth i 0 (dec (count v)))\n183\t    (nth v i)))\n184\t\n185\t\n186\t(defn- data-contains?\n187\t  [coll k]\n188\t  (cond\n189\t    (or (nil? coll) (map? coll) (set? coll)) (contains? coll k)\n190\t    (vector? coll) (let [i (integral k)]\n191\t                     (boolean (and i (< -1 i (count coll)))))\n192\t    :else (wrong-type! 'contains? 0 :map-set-or-vector)))\n193\t\n194\t\n195\t(defn- data-dissoc\n196\t  [m & ks]\n197\t  (if (or (nil? m) (map? m))\n198\t    (apply dissoc m ks)\n199\t    (wrong-type! 'dissoc 0 :map)))\n200\t\n201\t\n202\t(defn- data-disj\n203\t  [s & ks]\n204\t  (if (or (nil? s) (set? s))\n205\t    (apply disj s ks)\n206\t    (wrong-type! 'disj 0 :set)))\n207\t\n208\t\n209\t(defn- data-peek\n210\t  [v]\n211\t  (if (or (nil? v) (vector? v))\n212\t    (peek v)\n213\t    (wrong-type! 'peek 0 :vector)))\n214\t\n215\t\n216\t(defn- data-pop\n217\t  [v]\n218\t  (cond\n219\t    (nil? v) nil\n220\t    (not (vector? v)) (wrong-type! 'pop 0 :vector)\n221\t    :else (let [last-index (dec (count v))]\n222\t            (in-range! 'pop last-index 0 last-index)\n223\t            (pop v))))\n224\t\n225\t\n226\t(defn- data-subvec\n227\t  ([v start] (data-subvec v start (if (vector? v) (count v) 0)))\n228\t  ([v start end]\n229\t   (vector! 'subvec 0 v)\n230\t   (let [start (index! 'subvec 1 start)\n231\t         end (index! 'subvec 2 end)]\n232\t     (in-range! 'subvec end 0 (count v))\n233\t     (in-range! 'subvec start 0 end)\n234\t     (into [] (subvec v start end)))))\n235\t\n236\t\n237\t(defn- data-into\n238\t  [to from]\n239\t  (cond\n240\t    (vector? to)\n241\t    (if (or (nil? from) (sequential? from))\n242\t      (into to from)\n243\t      (wrong-type! 'into 1 :sequential))\n244\t\n245\t    (set? to)\n246\t    (if (or (nil? from) (sequential? from) (set? from))\n247\t      (into to from)\n248\t      (wrong-type! 'into 1 :sequential-or-set))\n249\t\n250\t    :else (wrong-type! 'into 0 :vector-or-set)))"}
{"role":"tool","tool_call_id":"tool_Sf5QUzHCPOukBh5gHMQqdP8R","content":"4990\t       (if (= (php/slot-kind out) :arr-handle)\n4991\t         (let [c (get out :php/arr)\n4992\t               st (cell/get c)]\n4993\t           (do (cell/set! c (assoc st :value (assoc (get st :value) :next-index nx))) out))\n4994\t         (assoc out :next-index nx)))]\n4995\t    [php/triple (fn [a b c] (php/vconj (php/vconj (php/vconj [] a) b) c))]\n4996\t    [php/do-sort\n4997\t     (fn [name args by keep sign]\n4998\t       (do (php/arity-between name args 1 2 \"at least 1\")\n4999\t           (let [arr (php/arg-array (get args 0) name 1 \"array\")\n5000\t                 flag (if (> (data/count args) 1) (php/to-int (get args 1)) 0)\n5001\t                 cmp (php/field-cmp by sign (php/flag-cmp flag))]\n5002\t             (php/sort-finish arr\n5003\t                              (php/msort (php/pairs arr 0 (php/array-count arr) []) cmp)\n5004\t                              keep))))]\n5005\t    [php/do-usort\n5006\t     (fn [name args by keep]\n5007\t       (do (php/arity-between name args 2 2 \"exactly 2\")\n5008\t           (let [arr (php/arg-array (get args 0) name 1 \"array\")\n5009\t                 cmp (php/field-cmp by 1 (php/user-cmp (php/callable-fn (get args 1))))]\n5010\t             (php/sort-finish arr\n5011\t                              (php/msort (php/pairs arr 0 (php/array-count arr) []) cmp)\n5012\t                              keep))))]\n5013\t    [php/bi-sort (fn [args] (php/do-sort \"sort\" args 1 false 1))]\n5014\t    [php/bi-rsort (fn [args] (php/do-sort \"rsort\" args 1 false -1))]\n5015\t    [php/bi-asort (fn [args] (php/do-sort \"asort\" args 1 true 1))]\n5016\t    [php/bi-arsort (fn [args] (php/do-sort \"arsort\" args 1 true -1))]\n5017\t    [php/bi-ksort (fn [args] (php/do-sort \"ksort\" args 0 true 1))]\n5018\t    [php/bi-krsort (fn [args] (php/do-sort \"krsort\" args 0 true -1))]\n5019\t    [php/bi-usort (fn [args] (php/do-usort \"usort\" args 1 false