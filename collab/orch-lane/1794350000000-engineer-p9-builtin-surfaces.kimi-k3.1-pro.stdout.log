)\n104\t   (fx :inc-warning-in-included :inclusion-v1 #{:p6-s2}\n105\t       {\"a.php\" \"<?php echo $undef;\"}\n106\t       \"<?php include 'a.php'; echo 'z';\" \"z\"\n107\t       :diag [[2 \"Undefined variable $undef\"]])\n108\t   (fx :inc-throwing-body-still-marked :inclusion-v1 #{:p6-s2}\n109\t       {\"a.php\" \"<?php throw new Exception('x');\"}\n110\t       (str \"<?php try { include_once 'a.php'; } catch (Exception $e) { echo 'c'; }\"\n111\t            \" var_dump(include_once 'a.php');\")\n112\t       \"cbool(true)\\n\")\n113\t   (fx :inc-once-path-forms :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n114\t       \"<?php include_once 'lib/a.php'; var_dump(include_once './lib/a.php');\"\n115\t       \"abool(true)\\n\")\n116\t   (fx :inc-in-condition :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n117\t       \"<?php if ((include 'a.php') === 1) { echo 'one'; }\" \"aone\")\n118\t   (fx :inc-computed-path :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n119\t       \"<?php $p = 'lib/a.php'; include $p;\" \"a\"\n120\t       :computed true\n121\t       :warnings [:yang.php/computed-include-path])\n122\t   (fx :inc-computed-path-unmapped :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n123\t       \"<?php $p = 'lib/' . 'b.php'; var_dump(include $p);\" \"bool(false)\\n\"\n124\t       :computed true\n125\t       :diag (missing-warnings \"include\" \"lib/b.php\")\n126\t       :warnings [:yang.php/computed-include-path])])\n127\t\n128\t\n129\t(def missing-v1\n130\t  \"The oracle-pinned half: a genuinely missing file, every kind, each run\n131\t   twice (a refusal never marks the path), and the not-marked probe.\"\n132\t  [(fx :miss-include :missing-v1 #{:p6-s2} nil\n133\t       \"<?php var_dump(include 'x.php'); var_dump(include 'x.php');\" \"bool(false)\\nbool(false)\\n\"\n134\t       :diag (into (missing-warnings \"include\" \"x.php\") (missing-warnings \"include\" \"x.php\")))\n135\t   (fx :miss-include-once :missing-v1 #{:p6-s2} nil\n136\t       \"<?php var_dump(include_once 'x.php'); var_dump(include_once 'x.php');\"\n137\t       \"bool(false)\\nbool(false)\\n\"\n138\t       :diag (into (missing-warnings \"include_once\" \"x.php\") (missing-warnings \"include_once\" \"x.php\")))\n139\t   (fx :miss-require :missing-v1 #{:p6-s2} nil\n140\t       (str \"<?php for ($i = 0; $i < 2; $i++) {\"\n141\t            \" try { require 'x.php'; } catch (Error $e) { echo get_class($e), ': ', $e->getMessage(), \\\"\\\\n\\\"; } }\")\n142\t       (str (apply str (repeat 2 (str \"Error: Failed opening required 'x.php' (include_path='\" include-path \"')\\n\"))))\n143\t       :diag (vec (repeat 2 [2 \"require(x.php): Failed to open stream: No such file or directory\"])))\n144\t   (fx :miss-require-once :missing-v1 #{:p6-s2} nil\n145\t       (str \"<?php for ($i = 0; $i < 2; $i++) {\"\n146\t            \" try { require_once 'x.php'; } catch (Error $e) { echo get_class($e), ': ', $e->getMessage(), \\\"\\\\n\\\"; } }\")\n147\t       (str (apply str (repeat 2 (str \"Error: Failed opening required 'x.php' (include_path='\" include-path \"')\\n\"))))\n148\t       :diag (vec (repeat 2 [2 \"require_once(x.php): Failed to open stream: No such file or directory\"])))\n149\t   (fx :miss-not-marked-probe :missing-v1 #{:p6-s2} nil\n150\t       (str \"<?php try { require_once 'x.php'; } catch (Error $e) { echo get_class($e), \\\"\\\\n\\\"; }\"\n151\t            \" var_dump(include_once 'x.php');\")\n152\t       \"Error\\nbool(false)\\n\"\n153\t       :diag (into [[2 \"require_once(x.php): Failed to open stream: No such file or directory\"]]\n154\t                   (missing-warnings \"include_once\" \"x.php\")))])\n155\t\n156\t\n157\t(def strict-v1\n158\t  \"R8: the caller's unit governs argument coercion, the callee's the rest.\"\n159\t  [(fx :strict-caller-strict-callee-coercive :strict-v1 #{:p6-s2-r8}\n160\t       {\"f.php\" \"<?php function f(int $x) { return $x; }\"}\n161\t       (str \"<?php declare(strict