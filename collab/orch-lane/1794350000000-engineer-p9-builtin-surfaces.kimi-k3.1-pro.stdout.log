{"role":"tool","tool_call_id":"tool_4z5RjsvJJLPHopO2Bvqwhz03","content":"1\t{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n2\t        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n3\t        ring/ring {:mvn/version \"1.14.1\"}\n4\t        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n5\t        org.replikativ/boring {:mvn/version \"0.1.30\"}\n6\t        com.datomic/peer {:mvn/version \"1.0.7364\"}\n7\t        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n8\t        org.clojure/data.json {:mvn/version \"2.5.0\"}\n9\t        http-kit/http-kit {:mvn/version \"2.8.0\"}\n10\t        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n11\t        instaparse/instaparse {:mvn/version \"1.5.0\"}\n12\t        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n13\t        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n14\t        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n15\t        criterium/criterium {:mvn/version \"0.4.6\"}\n16\t        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n17\t        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n18\t                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n19\t :cljd/opts {}\n20\t ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n21\t ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n22\t :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n23\t         \"build/antlr/python3/classes\" \"build/antlr/php/classes\"\n24\t         \"build/antlr/typescript/classes\"]\n25\t :aliases {:clean {:extra-paths [\"src/dev\"]\n26\t                   :exec-fn clean/clean}\n27\t           :profile-btree {:extra-paths [\"src/dev\"]\n28\t                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n29\t                                        {:mvn/version \"0.3.0\"}}\n30\t                           :main-opts [\"-m\" \"btree-bench\"]}\n31\t           :test {:extra-paths [\"test\"]\n32\t                  :extra-deps {io.github.cognitect-labs/test-runner\n33\t                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n34\t                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n35\t                               ;; the differential oracle for the yang.clojure gap\n36\t                               ;; program (pinned; MIT; dependency-free)\n37\t                               latte-kernel/latte-kernel\n38\t                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n39\t                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n40\t                  ;; The guest recursion limit allows depth that needs more than the\n41\t                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n42\t                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n43\t                  ;; before it can raise Python's RecursionError, so the same tests\n44\t                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n45\t                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n46\t                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n47\t                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n48\t                  ;; deep assertion payloads (the PHPT selection diagnostics and\n49\t                  ;; the conformance compositions) overflow smaller stacks in\n50\t                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n51\t                  ;; the 4m minimum for the prelude recursion rows still holds)\n52\t                  :jvm-opts [\"-Xss64m\"]\n53\t                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n54\t                  :exec-fn cognitect.test-runner.api/test}\n55\t           :nREPL {:extra-paths [\"test\"]\n56\t                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n57\t                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n58\t                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n59\t           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n60\t                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n61\t                               reagent/reagent {:mvn/version \"2.0.1\"}\n62\t                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n63\t           :dev {:extra-paths [\"src/dev\"]\n64\t                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n65\t                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n66\t                              reagent/reagent {:mvn/version \"2.0.1\"}\n67\t                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n68\t                              ;; benchmark baseline + psset-fixtures\n69\t                              ;; generator only; production uses\n70\t                              ;; dao.data.btree\n71\t                              persistent-sorted-set/persistent-sorted-set\n72\t                              {:mvn/version \"0.3.0\"}}\n73\t                 :jvm-opts [\"-Dconfig=config.clj\"]}\n74\t           ;; The one ClojureDart pin. Compose it with the build aliases:\n75\t           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n76\t           :clojuredart {:extra-deps {sonwh98/clojuredart\n77\t                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n78\t                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n79\t                                      }}\n80\t           :cljd {:extra-paths [\"test\"]\n81\t                  :main-opts [\"-m\" \"cljd.build\"]\n82\t                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n83\t           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n84\t                    :jvm-opts [\"-Dconfig=config.clj\"]\n85\t                    :main-opts [\"-m\" \"world.server\"]}\n86\t           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n87\t           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n88\t           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n89\t           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n90\t           ;; listed for audited portable namespaces only (its JVM namespaces\n91\t           ;; are selected away by :jolt reader branches, never loaded). No\n92\t           ;; generated Java parser classes, no JS/Dart roots, and no\n93\t           ;; dependency coordinate is fetched until a jolt-loaded namespace\n94\t           ;; needs one.\n95\t           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n96\t                  :replace-deps {}}\n97\t           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n98\t           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n99\t           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n100\t           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n101\t           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n102\t           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n103\t           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n104\t           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n105\t           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n106\t           :cljs-yin-repl\n107\t           {:extra-paths [\"test\" \"src/dev\"]\n108\t            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n109\t                         reagent/reagent {:mvn/version \"2.0.1\"}\n110\t                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n111\t            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n112\t           :fmt {:extra-paths [\"src/dev\"]\n113\t                 :exec-fn tasks/fix-all}\n114\t           ;; Build-time generation of the grammars-v4 Python3 parser.\n115\t           ;; The tool version must equal the antlr4-runtime above.\n116\t           :antlr-gen {:extra-paths [\"src/dev\"]\n117\t                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n118\t                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n119\t           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n120\t                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n121\t           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n122\t           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n123\t           ;; dependency. Backend deps/config are pinned separately once selected.\n124\t           :oracle {:extra-paths [\"src/dev\" \"test\"]\n125\t                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n126\t                                 ;; oracle backend: Datomic Local, in-process,\n127\t                                 ;; run in docker/oracle (dev-scope only)\n128\t                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n129\t           :dbg {:extra-paths [\"test\"]\n130\t                 :main-opts [\"-m\" \"debug-cljd\"]\n131\t                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n132\t           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n133\t           :cljd-yin-repl-build\n134\t           {:main-opts  [\"-m\" \"cljd.build\"]\n135\t            :cljd/opts  {:kind       :dart\n136\t                         :main       yin.repl.main\n137\t                         :output-dir \"build/yin-repl\"\n138\t                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n139\t           :dep-graph {:extra-paths [\"src/dev\"]\n140\t                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n141\t                       :main-opts [\"-m\" \"dep-graph\"]}}}\n142\t\n143\t\n144\t;; clj -X:fmt\n145\t\n146\t;; clj -M:nREPL\n147\t\n148\t;; clj -M:nREPL:server\n149\t;; clj -M:test\n150\t;; clj -M:test -n yin.vm-literal-test\n151\t;; clj -M:test -n yin.vm-continuation-test\n152\t;; clj -M:test -n yin.repl.python-antlr-test\n153\t;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n154\t;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n155\t\n156\t;; clj -X:clean\n157\t\n158\t;; npx shadow-cljs compile test && node target/node-tests.js\n159\t;; npx shadow-cljs release demo\n160\t;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n161\t;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n162\t;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n163\t;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n164\t\n165\t\n166\t;; mise exec -- clj -M:clojuredart:cljd watch \n167\t;; mise exec -- flutter run \n168\t\n169\t;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n170\t;; flutter emulators --launch Pixel_3_API_34\n171\t;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n172\t;; emulator -list-avds\n173\t\n174\t;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n175\t;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n176\t;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine"}
