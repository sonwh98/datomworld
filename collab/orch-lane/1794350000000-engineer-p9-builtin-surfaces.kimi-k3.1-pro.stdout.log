ng/php/antlr/include_test.clj-32-\ntest/yang/php/antlr/include_test.clj-33-(defn- run\ntest/yang/php/antlr/include_test.clj-34-  [fixture]\ntest/yang/php/antlr/include_test.clj:35:  (lh/run-fixture (parse-units fixture) \"main.php\"\ntest/yang/php/antlr/include_test.clj-36-                  {:computed? (:computed fixture), :class-map (:class-map fixture)}))\ntest/yang/php/antlr/include_test.clj-37-\ntest/yang/php/antlr/include_test.clj-38-\n--\ntest/yang/php/antlr/include_test.clj-87-\ntest/yang/php/antlr/include_test.clj-88-\ntest/yang/php/antlr/include_test.clj-89-(deftest include-refusals-test\ntest/yang/php/antlr/include_test.clj:90:  (testing \"a bundled program cannot include\"\ntest/yang/php/antlr/include_test.clj-91-    (is (thrown-with-msg? clojure.lang.ExceptionInfo #\"(?i)include\"\ntest/yang/php/antlr/include_test.clj-92-          (lower/lower-program (cst/parse-source \"<?php include 'a.php';\")))))\ntest/yang/php/antlr/include_test.clj-93-  (testing \"an escaping or absolute literal path\"\n--\ntest/yang/php/antlr/include_test.clj-107-    (is (= [:warning] (mapv :severity warnings)))))\ntest/yang/php/antlr/include_test.clj-108-\ntest/yang/php/antlr/include_test.clj-109-\ntest/yang/php/antlr/include_test.clj:110:(deftest ^:slow linked-profile-matches-bundled-test\ntest/yang/php/antlr/include_test.clj-111-  (let [src \"<?php function f($n) { return $n < 2 ? $n : f($n - 1) + f($n - 2); } echo f(10); var_dump([1, 'a' => 2.5]);\"\ntest/yang/php/antlr/include_test.clj:112:        bundled (h/run-php src)\ntest/yang/php/antlr/include_test.clj:113:        linked (lh/run-fixture {\"main.php\" (cst/parse-source src)})]\ntest/yang/php/antlr/include_test.clj-114-    (doseq [[k v] (:values linked)]\ntest/yang/php/antlr/include_test.clj:115:      (is (= (:semantic bundled) (h/render v)) (str k)))))\ntest/yang/php/antlr/include_test.clj-116-\ntest/yang/php/antlr/include_test.clj-117-\ntest/yang/php/antlr/include_test.clj-118-(deftest publication-order-test\n--\ntest/yang/php/antlr/prelude_test.cljc-1-(ns yang.php.antlr.prelude-test\ntest/yang/php/antlr/prelude_test.cljc:2:  \"The PHP prelude's static contract on every host: the bundled program is\ntest/yang/php/antlr/prelude_test.cljc-3-   closed over its own definitions, the declared host names and the\ntest/yang/php/antlr/prelude_test.cljc-4-   primitives; it never reaches `dao.host.*`; the lowered program names no\ntest/yang/php/antlr/prelude_test.cljc-5-   runtime key; the module emitter's exports and manifest cover the same\n--\ntest/yang/php/antlr/prelude_test.cljc-21-        (concat prelude/host-names (keys vm/primitives))))\ntest/yang/php/antlr/prelude_test.cljc-22-\ntest/yang/php/antlr/prelude_test.cljc-23-\ntest/yang/php/antlr/prelude_test.cljc:24:(deftest bundled-prelude-is-closed-test\ntest/yang/php/antlr/prelude_test.cljc-25-  (is (empty? (remove closed-names (prelude/free-names prelude/uast)))))\ntest/yang/php/antlr/prelude_test.cljc-26-\ntest/yang/php/antlr/prelude_test.cljc-27-\n--\ntest/yang/php/antlr/programs_p5.cljc:1:(ns yang.php.antlr.programs-p5\ntest/yang/php/antlr/programs_p5.cljc:2:  \"P5 request-context fixtures. Expectations are hand-derived from PHP 8.3;\ntest/yang/php/antlr/programs_p5.cljc-3-  every fixture remains available to the oracle recording pass.\")\ntest/yang/php/antlr/programs_p5.cljc-4-\ntest/yang/php/antlr/programs_p5.cljc-5-\n--\ntest/yang/php/antlr/programs_p5.cljc-22-\ntest/yang/php/antlr/programs_p5.cljc-23-(defn- fx\ntest/yang/php/antlr/programs_p5.cljc-24-  [id source out & {:as more}]\ntest/yang/php/antlr/programs_p5.cljc:25:  (merge {:id id, :group :request-context, :source source, :out out,\ntest/yang/php/antlr/programs_p5.cljc-26-          :request request, :oracle :pending}\ntest/yang/php/antlr/programs_p5.cljc-27-         more))\ntest/yang/php/antlr/programs_p5.cljc-28-"}
