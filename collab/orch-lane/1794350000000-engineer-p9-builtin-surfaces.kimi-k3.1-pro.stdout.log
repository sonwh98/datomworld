{"role":"tool","tool_call_id":"tool_9p4QXQtCTGIC8bZcFWKm6WAL","content":"950\t                          [(conj bindings [sym node]) (conj path (u/v sym))])))))\n951\t                [[] []]\n952\t                (:path loc))]\n953\t    (reduce (fn [inner [sym node]] (u/let1 sym node inner))\n954\t            (f (assoc loc :path path))\n955\t            (reverse bindings))))\n956\t\n957\t\n958\t(defn- path-node\n959\t  \"The key vector of a lowered path.\"\n960\t  [path]\n961\t  (args-vector (mapv #(if (= :php/append %) (u/lit :php/append) %) path)))\n962\t\n963\t\n964\t(defn- read-loc\n965\t  [ctx loc]\n966\t  (reduce (fn [acc k] (app* 'php/dim-get acc k)) (read-var ctx (:var loc)) (:path loc)))\n967\t\n968\t\n969\t(defn- peek-loc\n970\t  \"The value at `loc`, null when anything on the way is missing; no diagnostic.\"\n971\t  [ctx loc]\n972\t  (reduce (fn [acc k] (app* 'php/dim-peek acc k)) (peek-var ctx (:var loc)) (:path loc)))\n973\t\n974\t\n975\t(defn- write-loc\n976\t  \"Store `node` at `loc`: read the holder, update it purely, store it back.\n977\t   The expression's value is the stored value.\"\n978\t  [ctx n loc node]\n979\t  (if (empty? (:path loc))\n980\t    (write-var ctx (:var loc) node)\n981\t    (let [w (core/gen \"w\" n)]\n982\t      (u/let1 w\n983\t              node\n984\t              (u/then (put-var ctx\n985\t                               (:var loc)\n986\t                               (app* 'php/path-assign\n987\t                                     (peek-var ctx (:var loc))\n988\t                                     (path-node (:path loc))\n989\t                                     (u/v w)))\n990\t                      (u/v w))))))\n991\t\n992\t\n993\t(defn- isset-loc\n994\t  [ctx loc]\n995\t  (if (empty? (:path loc))\n996\t    (isset-var ctx (:var loc))\n997\t    (app* 'not (app* '= (peek-loc ctx loc) (u/lit :php/null)))))\n998\t\n999\t\n1000\t(defn- unset-loc\n1001\t  \"Remove the offset: never vivifies; a holder that is not an array is not\n1002\t   written back.\"\n1003\t  [ctx n loc]\n1004\t  (if (empty? (:path loc))\n1005\t    (unset-var ctx (:var loc))\n1006\t    (let [o (core/gen \"o\" n)\n1007\t          pruned (app* 'php/path-unset (u/v o) (path-node (:path loc)))]\n1008\t      (u/let1 o\n1009\t              (read-var ctx (:var loc))\n1010\t              (u/if-node (app* 'php/array? (u/v o))\n1011\t                         (put-var ctx (:var loc) pruned)\n1012\t                         pruned)))))\n1013\t\n1014\t\n1015\t(defn- lower-null-coalesce\n1016\t  \"`a ?? b`: a plain variable on the left is fetched without a warning; any\n1017\t   other operand is evaluated as written.\"\n1018\t  [ctx n a b]\n1019\t  (let [t (core/gen \"t\" n)\n1020\t        loc (expression-location ctx a)]\n1021\t    (when loc\n1022\t      (checked-var n (:var loc))\n1023\t      (forbid-append! n loc \"Cannot use [] for reading\"))\n1024\t    (u/let1 t\n1025\t            (if loc (peek-loc ctx (lower-path ctx loc)) (lower ctx a))\n1026\t            (u/if-node (app* '= (u/v t) (u/lit :php/null)) (lower ctx b) (u/v t)))))\n1027\t\n1028\t\n1029\t(defn- lower-instanceof\n1030\t  [ctx n a b]\n1031\t  (when (or (not (p/rule? b \"typeRef\")) (seq (core/rules ctx b \"anonymousClass\"))\n1032\t            (empty? (core/rules ctx b \"qualifiedNamespaceName\")))\n1033\t    (unsupported! n :instanceof))\n1034\t  (app* 'php/instance-of\n1035\t        (lower ctx a)\n1036\t        (app* 'php/lc (class-name-node ctx (class-text ctx b)))))\n1037\t\n1038\t\n1039\t(defn- lower-binary\n1040\t  [ctx n [a op b]]\n1041\t  (case (:type op)\n1042\t    \"NullCoalescing\" (lower-null-coalesce ctx n a b)\n1043\t    \"InstanceOf\" (lower-instanceof ctx n a b)\n1044\t    (let [x (lower ctx a)\n1045\t          y (lower ctx b)]\n1046\t      (case (:type op)\n1047\t        (\"BooleanAnd\" \"LogicalAnd\") (u/if-node (truthy x) (truthy y) (u/lit false))\n1048\t        (\"BooleanOr\" \"LogicalOr\") (u/if-node (truthy x) (u/lit true) (truthy y))\n1049\t        \"LogicalXor\" (app* 'not (app* '= (truthy x) (truthy y)))\n1050\t        (if-let [f (get binary-ops (:type op))]\n1051\t          (app* f x y)\n1052\t          (unsupported! n (keyword (str/lower-case (:type op)))))))))\n1053\t\n1054\t\n1055\t(defn- lower-conditional\n1056\t  [ctx n ks]\n1057\t  (let [c (lower ctx (first ks))]\n1058\t    (if (= 5 (count ks))\n1059\t      (u/if-node (truthy c) (lower ctx (nth ks 2)) (lower ctx (nth ks 4)))\n1060\t      (let [t (core/gen \"t\" n)]\n1061\t        (u/let1 t c (u/if-node (truthy (u/v t)) (u/v t) (lower ctx (nth ks 3))))))))\n1062\t\n1063\t\n1064\t(defn- lower-cast\n1065\t  [ctx n [_ op _ operand]]\n1066\t  (let [t (first (core/kids ctx op))\n1067\t        e (lower ctx operand)]\n1068\t    (case (:type t)\n1069\t      \"IntType\" (app* 'php/to-int e)\n1070\t      (\"FloatCast\" \"DoubleType\") (app* 'php/to-float e)\n1071\t      \"StringType\" (app* 'php/to-string e)\n1072\t      \"BoolType\" (app* 'php/to-bool e)\n1073\t      (unsupported! n (keyword \"cast\" (str/lower-case (:type t)))))))\n1074\t\n1075\t\n1076\t(defn- lower-isset\n1077\t  [ctx n chains]\n1078\t  (let [one (fn [c]\n1079\t              (let [loc (chain-loc ctx n c :isset-target)]\n1080\t                (forbid-append! n loc \"Cannot use [] for reading\")\n1081\t                (isset-loc ctx (lower-path ctx loc))))]\n1082\t    (reduce (fn [acc c] (u/if-node acc (one c) (u/lit false)))\n1083\t            (one (first chains))\n1084\t            (rest chains))))\n1085\t\n1086\t\n1087\t(defn- lower-empty\n1088\t  [ctx n c]\n1089\t  (let [loc (chain-loc ctx n c :empty-target)]\n1090\t    (forbid-append! n loc \"Cannot use [] for reading\")\n1091\t    (app* 'not (truthy (peek-loc ctx (lower-path ctx loc))))))\n1092\t\n1093\t\n1094\t(defn- lower-unset\n1095\t  [ctx n chains]\n1096\t  (u/then (u/seq-nodes (mapv (fn [c]\n1097\t                               (let [loc (chain-loc ctx n c :unset-target)]\n1098\t                                 (forbid-append! n loc \"Cannot use [] for unsetting\")\n1099\t                                 (with-keys ctx loc #(unset-loc ctx n %))))\n1100\t                             chains))\n1101\t          (u/lit :php/null)))\n1102\t\n1103\t\n1104\t(defn- lower-incdec\n1105\t  \"`++$x`, `$x--`, `$a[k]++`: the location is read, stepped and written back,\n1106\t   its keys evaluated once; the postfix form answers the old value.\"\n1107\t  [ctx n c op-type prefix?]\n1108\t  (let [loc (chain-loc ctx n c :inc-dec-target)\n1109\t        f (if (= \"Inc\" op-type) 'php/inc 'php/dec)]\n1110\t    (forbid-append! n loc \"Cannot use [] for reading\")\n1111\t    (with-keys ctx\n1112\t      loc\n1113\t      (fn [l]\n1114\t        (let [write (fn [v]\n1115\t                      ;; `$r++` on a plain variable bound to a sourced reference\n1116\t                      ;; checks the overflow of its typed sources (row 43)\n1117\t                      (if (and (empty? (:path l)) (= \"Inc\" op-type) (not (this-var? (:var l))))\n1118\t                        (let [m (core/gen \"m\" n)]\n1119\t                          (u/let1 m\n1120\t                                  (if-let [cv (cv-node ctx (:var l))]\n1121\t                                    (app* 'php/marker-of-cv cv)\n1122\t                                    (app* 'php/marker-of-global (u/lit (bare (:var l)))))\n1123\t                                  (u/if-node (app* 'nil? (u/v m))\n1124\t                                             (write-loc ctx n l v)\n1125\t                                             (app* 'php/typed-inc (u/v m)))))\n1126\t                        (write-loc ctx n l v)))]\n1127\t          (if prefix?\n1128\t            (write (app* f (read-loc ctx l)))\n1129\t            (let [old (core/gen \"old\" n)]\n1130\t              (u/let1 old\n1131\t                      (read-loc ctx l)\n1132\t                      (u/then (write (app* f (u/v old))) (u/v old))))))))))\n1133\t\n1134\t\n1135\t(defn- lower-silence\n1136\t  \"`@e`: `e` runs with error_reporting reduced (`php/silence`).\"\n1137\t  [ctx operand]\n1138\t  (app* 'php/silence (u/lam [] (lower ctx operand))))\n1139\t\n1140\t\n1141\t;; =============================================================================\n1142\t;; include / require\n1143\t;; =============================================================================\n1144\t\n1145\t(def ^:private include-kinds\n1146\t  {\"Include\" :include, \"IncludeOnce\" :include-once, \"Require\" :require, \"RequireOnce\" :require-once})\n1147\t\n1148\t\n1149\t(defn- tokens-text\n1150\t  \"The concatenated token text below `n`.\"\n1151\t  [ctx n]\n1152\t  (apply str (map (fn [k] (if (p/rule? k) (tokens-text ctx k) (:text k))) (core/kids ctx n))))\n1153\t\n1154\t\n1155\t(defn- plain-string\n1156\t  \"The text of a `string` rule that holds no interpolation, else nil.\"\n1157\t  [ctx n]\n1158\t  (let [ks (core/kids ctx n)\n1159\t        k0 (first ks)]\n1160\t    (case (:type k0)\n1161\t      \"SingleQuoteString\" (let [t (:text k0)] (unescape-single (subs t 1 (dec (count t)))))\n1162\t      \"DoubleQuote\" (let [parts (filterv #(p/rule? % \"interpolatedStringPart\") ks)\n1163\t                          toks (mapv #(first (core/kids ctx %)) parts)]\n1164\t                      (when (every? (fn [[t part]]\n1165\t                                      (and (= 1 (count (core/kids ctx part))) (= \"StringPart\" (:type t))))\n1166\t                                    (map vector toks parts))\n1167\t                        (when-not (some #(str/includes? (:text %) \"\\\\\") toks)\n1168\t                          (apply str (map :text toks)))))\n1169\t      nil)))\n1170\t\n1171\t\n1172\t(defn- fold-path\n1173\t  \"The string expression `e` folds to over literals, `__DIR__`, `__FILE__`,\n1174\t   `dirname(<folded> [, levels])` and `.`, else nil: the include path is\n1175\t   computed (plan P6 R3). `__FILE__` is the unit's declared path, `__DIR__`\n1176\t   its directory.\"\n1177\t  [ctx e]\n1178\t  (let [ks (core/kids ctx e)\n1179\t        k0 (first ks)\n1180\t        unit-path (get-in ctx [:unit :path])]\n1181\t    (cond\n1182\t      (and (= 1 (count ks)) (p/rule? k0 \"string\")) (plain-string ctx k0)\n1183\t      (and (= 1 (count ks)) (p/rule? k0 \"parentheses\"))\n1184\t      (fold-path ctx (first (core/rules ctx k0 \"expression\")))\n1185\t      (and (= 1 (count ks)) (p/rule? k0 \"constant\"))\n1186\t      (let [m (first (core/kids ctx k0))]\n1187\t        (when (p/rule? m \"magicConstant\")\n1188\t          (case (:type (first (core/kids ctx m)))\n1189\t            \"File__\" unit-path\n1190\t            \"Dir__\" (path-dirname unit-path)\n1191\t            nil)))\n1192\t      (and (= 1 (count ks)) (p/rule? k0 \"chain\"))\n1193\t      (let [co (first (core/kids ctx k0))\n1194\t            fc (when (and (= 1 (count (core/kids ctx k0))) (p/rule? co \"chainOrigin\"))\n1195\t                 (first (core/kids ctx co)))]\n1196\t        (when (and fc\n1197\t                   (p/rule? fc \"functionCall\")\n1198\t                   (= \"dirname\" (str/lower-case (tokens-text ctx (first (core/rules ctx fc \"functionCallName\"))))))\n1199\t          (let [args (some->> (first (core/rules ctx fc \"actualArguments\"))\n1200\t                              (#(core/rules ctx % \"arguments\"))\n1201\t                              first\n1202\t                              (#(core/rules ctx % \"actualArgument\")))\n1203\t                inner (some->> (first args) (#(first (core/rules ctx % \"expression\"))) (fold-path ctx))\n1204\t                levels (if (= 2 (count args))\n1205\t                         (let [t (tokens-text ctx (second args))]\n1206\t                           (when (re-matches #\"[1-9][0-9]*\" t) (parse-long t)))\n1207\t                         (when (= 1 (count args)) 1))]\n1208\t            (when (and inner levels)\n1209\t              (nth (iterate path-dirname inner) levels)))))\n1210\t      (and (= 3 (count ks)) (p/rule? k0 \"expression\") (= \"Dot\" (:type (second ks))))\n1211\t      (let [a (fold-path ctx k0)\n1212\t            b (fold-path ctx (nth ks 2))]\n1213\t        (when (and a b) (str a b)))\n1214\t      :else nil)))\n1215\t\n1216\t\n1217\t(defn- delivery-thunk\n1218\t  \"The statement-time delivery thunk of unit `path`: a try-require that\n1219\t   answers `{:status :ok :body b}` on success, else the structured refusal\n1220\t   (the Python I4-a thunk).\"\n1221\t  [path]\n1222\t  (let [m (path-module-symbol path)]\n1223\t    (u/lam []\n1224\t           (u/let1 'r (app* 'try-require (u/lit m))\n1225\t                   (u/if-node (app* '= (u/lit :ok) (app* 'get (u/v 'r) (u/lit :status)))\n1226\t                              (app* 'assoc (u/lit {:status :ok}) (u/lit :body)\n1227\t                                    (u/v (symbol (str m) \"body\")))\n1228\t                              (u/v 'r))))))\n1229\t\n1230\t\n1231\t(defn- lower-include\n1232\t  \"`include`/`include_once`/`require`/`require_once` over the linker (plan P6\n1233\t   R3/R4). A folded path lowers to `(php/include-run path thunk kind scope\n1234\t   ctx)`; a computed one to `(php/include-computed path kind scope ctx)` and\n1235\t   a `:yang.php/computed-include-path` warning. `scope` is the including\n1236\t   scope (R5): `:php/globals` at the entry unit's top level, the function's\n1237\t   scope inside a function, the unit's own `%scope` inside an included\n1238\t   body; `ctx` the including frame's `%fn`, `%ctx` or null.\"\n1239\t  [ctx n kind operand]\n1240\t  (when-not (:linked? ctx) (unsupported! n :include))\n1241\t  (let [scope (if (or (:fn ctx) (:module? ctx)) (u/v '%scope) (u/lit :php/globals))\n1242\t        frame (cond (:fn ctx) (u/v '%fn) (:module? ctx) (u/v '%ctx) :else (u/lit :php/null))]\n1243\t    (if-let [folded (fold-path ctx operand)]\n1244\t      (let [{:keys [path error]} (normalize-unit-path folded)]\n1245\t        (when error (unsupported! n error))\n1246\t        (app* 'php/include-run (u/lit path) (delivery-thunk path) (u/lit kind) scope frame))\n1247\t      (do (warn! ctx n :yang.php/computed-include-path\n1248\t                 \"include path is computed; it resolves through the published path map at run time\" {})\n1249\t          (app* 'php/include-computed (lower ctx operand) (u/lit kind) scope frame)))))\n1250\t\n1251\t\n1252\t(defn- lower-prefix\n1253\t  [ctx n [op operand :as ks]]\n1254\t  (let [t (:type op)]\n1255\t    (case t\n1256\t      \"Minus\" (app* 'php/neg (lower ctx operand))\n1257\t      \"Plus\" (app* 'php/plus (lower ctx operand))\n1258\t      \"Bang\" (app* 'not (truthy (lower ctx operand)))\n1259\t      \"Tilde\" (app* 'php/bit-not (lower ctx operand))\n1260\t      \"SuppressWarnings\" (lower-silence ctx operand)\n1261\t      (\"Inc\" \"Dec\") (lower-incdec ctx n operand t true)\n1262\t      \"IsSet\" (lower-isset ctx n (core/rules ctx (nth ks 2) \"chain\"))\n1263\t      \"Empty\" (lower-empty ctx n (nth ks 2))\n1264\t      \"Print\" (u/then (app* 'php/echo (app* 'php/to-string (lower ctx operand)))\n1265\t                      (u/lit 1))\n1266\t      \"Exit\" (app* 'php/exit (if operand (lower ctx operand) (u/lit 0)))\n1267\t      \"OpenRoundBracket\" (lower-cast ctx n ks)\n1268\t      \"Throw\" (app* 'php/throw-value (lower ctx operand))\n1269\t      \"Clone\" (app* 'php/clone-obj (lower ctx operand) (cc-node ctx))\n1270\t      \"List\" (lower-destructure ctx n\n1271\t                                (pattern-of ctx n (first (core/rules ctx n \"assignmentList\")))\n1272\t                                (last ks))\n1273\t      (if-let [kind (get include-kinds t)]\n1274\t        (lower-include ctx n kind operand)\n1275\t        (if-let [construct (get prefix-refusals t)]\n1276\t          (unsupported! n construct)\n1277\t          (unsupported! n (keyword (str/lower-case t))))))))\n1278\t\n1279\t\n1280\t(def ^:private assignment-ops\n1281\t  {\"PlusEqual\" 'php/add,\n1282\t   \"MinusEqual\" 'php/sub,\n1283\t   \"MulEqual\" 'php/mul,\n1284\t   \"PowEqual\" 'php/pow,\n1285\t   \"DivEqual\" 'php/div,\n1286\t   \"Concaequal\" 'php/concat,\n1287\t   \"ModEqual\" 'php/mod,\n1288\t   \"ShiftLeftEqual\" 'php/shl,\n1289\t   \"ShiftRightEqual\" 'php/shr,\n1290\t   \"AndEqual\" 'php/bit-and,\n1291\t   \"OrEqual\" 'php/bit-or,\n1292\t   \"XorEqual\" 'php/bit-xor})\n1293\t\n1294\t\n1295\t(defn- fresh-value?\n1296\t  \"True when expression `e` is syntactically a literal or constant, so the\n1297\t   value it answers is not another holder's (no ADDREF needed).\"\n1298\t  [ctx e]\n1299\t  (let [ks (core/kids ctx e)]\n1300\t    (and (= 1 (count ks))\n1301\t         (p/rule? (first ks))\n1302\t         (contains? #{\"constant\" \"string\" \"arrayCreation\"} (:rule (first ks))))))\n1303\t\n1304\t\n1305\t(defn- acquired\n1306\t  \"The lowered `e`, ADDREFed unless it is syntactically fresh.\"\n1307\t  [ctx e]\n1308\t  (if (fresh-value? ctx e) (lower ctx e) (app* 'php/addref (lower ctx e))))\n1309\t\n1310\t\n1311\t(defn- ref-source-loc\n1312\t  \"A node that answers the reference marker of location `l` (keys already\n1313\t   lowered), made on first use.\"\n1314\t  [ctx n l]\n1315\t  (if (empty? (:path l))\n1316\t    (make-ref-var ctx (:var l))\n1317\t    (let [p (core/gen \"p\" n)]\n1318\t      (u/let1 p\n1319\t              (app* 'php/path-ref (peek-var ctx (:var l)) (path-node (:path l)))\n1320\t              (u/then (put-var ctx (:var l) (app* 'get (u/v p) (u/lit 0)))\n1321\t                      (app* 'get (u/v p) (u/lit 1)))))))\n1322\t\n1323\t\n1324\t(defn- ref-source\n1325\t  \"A node that answers the reference marker of the location `chain`, made on\n1326\t   first use: a variable's own, or the slot's after the path is fetched for\n1327\t   writing (separated, vivified, upgraded) and written back.\"\n1328\t  [ctx n chain]\n1329\t  (let [loc (chain-loc ctx n chain :reference-source)]\n1330\t    (with-keys ctx loc (fn [l] (ref-source-loc ctx n l)))))\n1331\t\n1332\t\n1333\t;; -----------------------------------------------------------------------------\n1334\t;; Destructuring\n1335\t;; -----------------------------------------------------------------------------\n1336\t;; `[$a, $b] = e`, `list($a, , $c) = e`, `['k' => $v] = e`, nested, and one\n1337\t;; level of `&` targets. A pattern is a vector of entries `{:key expr-or-nil\n1338\t;; :idx n :ref? bool :target chain-or-pattern}`; holes only advance `:idx`.\n1339\t;; The source is evaluated once; a missing key warns and assigns null, a"}
{"role":"tool","tool_call_id":"tool_I6PjWQ47t1nJ6OFNhmyPvCwm","content":"1\t(ns yang.php.antlr.lower\n2\t  \"The PHP lowering interpreter: CST packets in, Universal AST program\n3\t   batches out (docs/design/yang.php.md sections 3, 7). Portable.\n4\t\n5\t   Per packet: validate the tree, analyze scopes (`yang.php.antlr.scope`),\n6\t   then lower with one `case` arm per grammar rule. A rule P1 does not lower\n7\t   fails with `:yang.php/unsupported` naming the rule and construct; a rule\n8\t   with no arm fails with `:yang.php/unhandled-rule`. Nothing is silently\n9\t   dropped.\n10\t\n11\t   Decided lowering rules (collab/1792905000000 plan):\n12\t   - A top-level `$x` is `(php/global-get \\\"x\\\")` / `(php/global-set! \\\"x\\\" v)`;\n13\t     inside a function it is a lexical cell `$x` allocated at entry holding\n14\t     `:php/undef`. Loops are self-applied `:loop`-marked lambdas whose\n15\t     `break`/`continue` are `php/call-ec` escapes bound to `%brk<id>` and\n16\t     `%cont<id>`, created only when the body uses them; the `:loops` stack of\n17\t     the context resolves `break n`. `switch` is one stack level: a chain of\n18\t     lambdas whose bodies tail-call the next case.\n19\t   - A function is `(php/declare-function! name (php/make-function name spec\n20\t     (fn [%fn %args] body) statics))`; top-level unconditional declarations\n21\t     are hoisted. `return` is an escape from `php/call-ec`, bound only when\n22\t     the body has a `return`.\n23\t   - The unit is its hoisted top-level function declarations, then its\n24\t     statements in order, run under `php/run-main`.\n25\t   - Inline HTML is `(php/echo \\\"bytes\\\")`; `echo a, b` is\n26\t     `(php/echo (php/to-string a))` per operand; a PHP string is a byte\n27\t     carrier (a latin-1 string), literal text resolved here to UTF-8 bytes.\n28\t   - `&&`, `||`, `and`, `or`, `?:` are `:if` nodes over `php/to-bool`, never\n29\t     applications, so they short circuit. Every other operator is one\n30\t     application of a `php/` function of the prelude.\n31\t   - A call `f(a, b)` resolves `f` before any argument runs:\n32\t     `(let [%f (php/resolve-fn \\\"f\\\" \\\"F\\\")] (php/call %f [a b]))`.\n33\t   - Generated names are `%<prefix><cst-id>`; `%` cannot begin a PHP name, so\n34\t     no guest name shadows a name the lowering emits. The lowering never\n35\t     names a runtime key (`php.rt/*`).\n36\t\n37\t   Diagnostic namespace: \\\"yang.php\\\".\"\n38\t  (:require\n39\t    [clojure.string :as str]\n40\t    [clojure.walk :as walk]\n41\t    [dao.host.text :as text]\n42\t    [dao.jing.cbor :as cbor]\n43\t    [yang.antlr.packet :as p]\n44\t    [yang.core.lower :as core]\n45\t    [yang.core.module :as core-module]\n46\t    [yang.core.stage :as core-stage]\n47\t    [yang.core.uast :as u]\n48\t    [yang.php.antlr.builtins :as builtins]\n49\t    [yang.php.antlr.prelude :as prelude]\n50\t    [yang.php.antlr.scope :as scope]\n51\t    [yang.stage :as stage]\n52\t    [yin.vm :as vm]\n53\t    [yin.vm.integer :as integer]))\n54\t\n55\t\n56\t;; =============================================================================\n57\t;; Diagnostics\n58\t;; =============================================================================\n59\t\n60\t(def ^:private diagnostic-ns \"yang.php\")\n61\t\n62\t\n63\t(defn- unsupported!\n64\t  [n construct]\n65\t  (core/unsupported! diagnostic-ns \"PHP\" n construct))\n66\t\n67\t\n68\t(defn- compile-error!\n69\t  \"A PHP compile-time error: the program is refused, never run.\"\n70\t  [n message]\n71\t  (throw (ex-info message\n72\t                  {:yang.php/diagnostic :yang.php/compile-error,\n73\t                   :rule (:rule n),\n74\t                   :span (:span n)})))\n75\t\n76\t\n77\t(defn- warn!\n78\t  \"Record a warning-severity lowering diagnostic: the program still lowers.\"\n79\t  [ctx n kind message data]\n80\t  (swap! (:warnings ctx)\n81\t         conj\n82\t         (merge {:yang.php/diagnostic kind,\n83\t                 :severity :warning,\n84\t                 :message message,\n85\t                 :span (:span n)}\n86\t                data)))\n87\t\n88\t\n89\t(def unsupported-rules\n90\t  \"Grammar rules P1 does not lower, with the construct each names.\"\n91\t  {\"gotoStatement\" :goto,\n92\t   \"declareStatement\" :declare,\n93\t   \"importStatement\" :import,\n94\t   \"newExpr\" :new,\n95\t   \"yieldExpression\" :yield,\n96\t   \"scriptText\" :inline-script,\n97\t   \"classConstant\" :class-constant})\n98\t\n99\t\n100\t(def ^:private prefix-refusals\n101\t  \"Expression forms led by a keyword or operator token.\"\n102\t  {\"Clone\" :clone,\n103\t   \"New\" :new,\n104\t   \"Eval\" :eval,\n105\t   \"Include\" :include,\n106\t   \"IncludeOnce\" :include,\n107\t   \"Require\" :include,\n108\t   \"RequireOnce\" :include,\n109\t   \"Yield\" :yield,\n110\t   \"List\" :list})\n111\t\n112\t\n113\t;; =============================================================================\n114\t;; Unit paths and linker names (plan P6 R2/R3)\n115\t;; =============================================================================\n116\t\n117\t(def ^:private unit-path-chars #\"[A-Za-z0-9_\\-./]*\")\n118\t\n119\t\n120\t(defn normalize-unit-path\n121\t  \"`{:path p}` for the relative path `s` normalized (segments joined by `/`,\n122\t   `.` and empty segments dropped, `..` collapsed), else `{:error e}`:\n123\t   `:unit-path` for a character outside `[A-Za-z0-9_\\\\-./]`, `:include-path`\n124\t   for an absolute path or one escaping the composition root.\"\n125\t  [s]\n126\t  (cond\n127\t    (not (re-matches unit-path-chars s)) {:error :unit-path}\n128\t    (str/starts-with? s \"/\") {:error :include-path}\n129\t    :else (let [segs (reduce (fn [acc seg]\n130\t                               (cond\n131\t                                 (or (= seg \"\") (= seg \".\")) acc\n132\t                                 (= seg \"..\") (if (empty? acc) (reduced nil) (pop acc))\n133\t                                 :else (conj acc seg)))\n134\t                             []\n135\t                             (str/split s #\"/\"))]\n136\t            (if (or (nil? segs) (empty? segs))\n137\t              {:error :include-path}\n138\t              {:path (str/join \"/\" segs)}))))\n139\t\n140\t\n141\t(defn path-module-symbol\n142\t  \"The linker module of unit path `path`: `phpm.` then the path with `/` as\n143\t   `$` and `.` as `$$`, nothing dropped (injective: plan P6 R2).\"\n144\t  [path]\n145\t  (symbol (str \"phpm.\" (str/replace (str/replace path \"/\" \"$\") \".\" \"$$\"))))\n146\t\n147\t\n148\t(def classmap-name\n149\t  \"The unit name of the autoload class map; a unit path cannot begin with\n150\t   `$`, so no unit collides with it.\"\n151\t  \"$classmap\")\n152\t\n153\t\n154\t(def classmap-module\n155\t  \"The linker module of the class map.\"\n156\t  (path-module-symbol classmap-name))\n157\t\n158\t\n159\t(defn- path-dirname\n160\t  \"PHP's `dirname` of the relative path `p`: `.` for a root unit.\"\n161\t  [p]\n162\t  (let [t (str/replace p #\"/+$\" \"\")\n163\t        i (str/last-index-of t \"/\")]\n164\t    (cond\n165\t      (nil? i) \".\"\n166\t      (zero? i) \"/\"\n167\t      :else (subs t 0 i))))\n168\t\n169\t\n170\t;; =============================================================================\n171\t;; Bytes\n172\t;; =============================================================================\n173\t\n174\t(defn- bytes->str\n175\t  \"The latin-1 carrier of the byte values `bs` (a PHP string).\"\n176\t  [bs]\n177\t  (text/units->string (map #(bit-and % 255) bs)))\n178\t\n179\t\n180\t(defn- utf8-of-code-point"}
{"role":"tool","tool_call_id":"tool_ag6TkyOsRConxtLnVPpRahii","content":"1770\t\n1771\t\n1772\t(defn- lower-call-plain\n1773\t  [ctx n call]\n1774\t  (let [[fname args] (core/rule-kids ctx call)\n1775\t        groups (core/rules ctx args \"arguments\")\n1776\t        static? (let [ks (core/kids ctx fname)]\n1777\t                  (and (= 1 (count ks)) (p/rule? (first ks) \"qualifiedNamespaceName\")))\n1778\t        {primary-lc :lc, :keys [written fallback-lc fallback]} (when static? (function-name ctx fname))\n1779\t        ;; the name builtins and special forms are keyed by, and the unit's\n1780\t        ;; own declaration of the call, if any\n1781\t        lc (or fallback-lc primary-lc)\n1782\t        user-lc (first (filter #(contains? (:declared ctx) %) [primary-lc fallback-lc]))\n1783\t        arguments (first groups)\n1784\t        chain-dynamic (fn [callee-node more]\n1785\t                        (reduce (fn [acc g]\n1786\t                                  (let [f (core/gen \"f\" g)]\n1787\t                                    (u/let1 f\n1788\t                                            (app* 'php/callable-in acc (cc-node ctx))\n1789\t                                            (call-node ctx (u/v f) g nil))))\n1790\t                                callee-node\n1791\t                                more))]\n1792\t    (when-not (seq groups) (unsupported! n :dynamic-call))\n1793\t    (if-not static?\n1794\t      (let [f (core/gen \"f\" n)]\n1795\t        (chain-dynamic\n1796\t          (u/let1 f\n1797\t                  (app* 'php/callable-in (callee-value ctx n fname) (cc-node ctx))\n1798\t                  (app* 'php/tmp! (call-node ctx (u/v f) arguments nil)))\n1799\t          (rest groups)))\n1800\t      (chain-dynamic\n1801\t        (case lc\n1802\t          \"isset\" (lower-isset ctx n (argument-chains ctx n arguments))\n1803\t          \"unset\" (lower-unset ctx n (argument-chains ctx n arguments))\n1804\t          \"empty\" (let [cs (argument-chains ctx n arguments)]\n1805\t                    (when (not= 1 (count cs)) (unsupported! n :argument-form))\n1806\t                    (lower-empty ctx n (first cs)))\n1807\t          (\"exit\" \"die\") (let [as (core/rules ctx arguments \"actualArgument\")]\n1808\t                           (when (> (count as) 1) (unsupported! n :argument-form))\n1809\t                           (app* 'php/exit\n1810\t                                 (if (seq as)\n1811\t                                   (lower ctx (first (core/kids ctx (first as))))\n1812\t                                   (u/lit 0))))\n1813\t          (let [f (core/gen \"f\" n)\n1814\t                by-ref (when-not user-lc\n1815\t                         (:by-ref (get builtins/supported lc)))]\n1816\t            (note-unknown-builtin! ctx n lc (or fallback written))\n1817\t            (u/let1 f\n1818\t                    (if fallback\n1819\t                      (app* 'php/resolve-fn2 (u/lit primary-lc) (u/lit fallback-lc) (u/lit written))\n1820\t                      (app* 'php/resolve-fn (u/lit lc) (u/lit written)))\n1821\t                    (if by-ref\n1822\t                      (lower-by-ref-call ctx n f by-ref arguments)\n1823\t                      (let [call (call-node ctx (u/v f) arguments (get (:declared ctx) user-lc))]\n1824\t                        (if user-lc (app* 'php/tmp! call) call))))))\n1825\t        (rest groups)))))\n1826\t\n1827\t\n1828\t;; -----------------------------------------------------------------------------\n1829\t;; try, throw, match, member calls\n1830\t;; -----------------------------------------------------------------------------\n1831\t\n1832\t(defn- leftmost-token-text\n1833\t  \"The text of the first token under `n`.\"\n1834\t  [ctx n]\n1835\t  (if (p/token? n)\n1836\t    (when-not (= \"\\\\\" (:text n)) (:text n))\n1837\t    (some #(leftmost-token-text ctx %) (core/kids ctx n))))\n1838\t\n1839\t\n1840\t(defn- catch-clause-node\n1841\t  \"`(if matches (do bind body) rest)` for one `catch` clause over error `e`.\"\n1842\t  [ctx e clause rest]\n1843\t  (let [types (mapv #(str/lower-case (class-text ctx %))\n1844\t                    (core/rules ctx clause \"qualifiedStaticTypeRef\"))\n1845\t        var (some #(when (and (p/token? %) (= \"VarName\" (:type %))) (:text %))\n1846\t                  (core/kids ctx clause))\n1847\t        test (reduce (fn [acc t]\n1848\t                       (u/if-node acc (u/lit true) (app* 'php/instance-of e (u/lit t))))\n1849\t                     (u/lit false)\n1850\t                     types)\n1851\t        body (lower ctx (first (core/rules ctx clause \"blockStatement\")))]\n1852\t    (u/if-node test\n1853\t               (if var\n1854\t                 (u/then (write-var ctx var e) body)\n1855\t                 (u/then (app* 'php/delref e) body))\n1856\t               rest)))\n1857\t\n1858\t\n1859\t(defn- lower-try\n1860\t  \"`try { } catch (T $e) { } finally { }`: `php/try` delivers the error to the\n1861\t   catch clauses in order, an unmatched one is raised again; `php/try-finally`\n1862\t   runs the finally block on every exit, escapes and errors included.\"\n1863\t  [ctx n]\n1864\t  (let [block (first (core/rules ctx n \"blockStatement\"))\n1865\t        clauses (core/rules ctx n \"catchClause\")\n1866\t        fin (first (core/rules ctx n \"finallyStatement\"))\n1867\t        e (core/gen \"e\" n)\n1868\t        mark (core/gen \"mk\" n)\n1869\t        body (lower ctx block)\n1870\t        guarded (if (seq clauses)\n1871\t                  (u/let1 mark\n1872\t                          (app* 'php/tmp-mark)\n1873\t                          (app* 'php/try\n1874\t                                (u/lam [] body)\n1875\t                                (u/lam [e]\n1876\t                                       (u/then (app* 'php/release-tmps (u/v mark))\n1877\t                                               (reduce (fn [rest clause]\n1878\t                                                         (catch-clause-node ctx (u/v e) clause rest))\n1879\t                                                       (app* 'php/raise (u/v e))\n1880\t                                                       (reverse clauses))))\n1881\t                                (u/lam [] (u/lit :php/null))))\n1882\t                  body)]\n1883\t    (u/then (if fin\n1884\t              (app* 'php/try-finally\n1885\t                    (u/lam [] guarded)\n1886\t                    (u/lam [(core/gen \"x\" n)]\n1887\t                           (lower ctx (first (core/rules ctx fin \"blockStatement\")))))\n1888\t              guarded)\n1889\t            (u/lit :php/null))))\n1890\t\n1891\t\n1892\t(defn- lower-match\n1893\t  \"`match (e) { a, b => r, default => d }`: strict comparison in order, the\n1894\t   default last, else `UnhandledMatchError`.\"\n1895\t  [ctx n]\n1896\t  (let [subject (first (core/rules ctx n \"expression\"))\n1897\t        m (core/gen \"m\" n)\n1898\t        items (core/rules ctx n \"matchItem\")\n1899\t        default? (fn [item]\n1900\t                   (let [es (core/rules ctx item \"expression\")]\n1901\t                     (and (= 2 (count es))\n1902\t                          (= \"default\" (str/lower-case (leftmost-token-text ctx (first es)))))))\n1903\t        default-item (first (filter default? items))\n1904\t        arms (remove default? items)]\n1905\t    (u/let1 m\n1906\t            (lower ctx subject)\n1907\t            (reduce (fn [rest item]\n1908\t                      (let [es (core/rules ctx item \"expression\")\n1909\t                            conds (butlast es)\n1910\t                            result (last es)]\n1911\t                        (u/if-node (reduce (fn [acc c]\n1912\t                                             (u/if-node acc\n1913\t                                                        (u/lit true)\n1914\t                                                        (app* 'php/identical (u/v m) (lower ctx c))))\n1915\t                                           (u/lit false)\n1916\t                                           conds)\n1917\t                                   (lower ctx result)\n1918\t                                   rest)))\n1919\t                    (if default-item"}
