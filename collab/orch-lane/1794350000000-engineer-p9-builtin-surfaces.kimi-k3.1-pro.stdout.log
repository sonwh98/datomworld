 emitter strips `php/h` to the bare `h`, which a local\n5351\t   `h` would otherwise capture. Globals are qualified before stripping, so\n5352\t   every bare occurrence is the local.\"\n5353\t  [exports [k form]]\n5354\t  (let [clash (set (filter exports (binder-symbols form)))]\n5355\t    [k\n5356\t     (if (empty? clash)\n5357\t       form\n5358\t       (walk/postwalk (fn [x] (if (contains? clash x) (symbol (str x \"%l\")) x)) form))]))\n5359\t\n5360\t\n5361\t(def ^:private module-definitions\n5362\t  (core/module-definitions\n5363\t    \"php\" :php/uninit runtime-keys\n5364\t    (mapv (partial unshadow (into #{} (map (fn [[k _]] (strip k))) definitions)) definitions)))\n5365\t\n5366\t\n5367\t(def module-uast\n5368\t  \"The module tree: one application whose operands are the definitions, in\n5369\t   order. Defining runs nothing.\"\n5370\t  (core/module-tree module-definitions []))\n5371\t\n5372\t\n5373\t(def module-exports\n5374\t  \"The module's exports: every `php/` key of the definition list, stripped.\"\n5375\t  (core/exports \"php\" definitions))\n5376\t\n5377\t\n5378\t(def free-names core/free-names)\n5379\t\n5380\t\n5381\t(def defined-keys core/defined-keys)\n5382\t\n5383\t\n5384\t(def ^:private module-free-names\n5385\t  (core/free-name-vec module-uast))\n5386\t\n5387\t\n5388\t(defn module-spec\n5389\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `php` over\n5390\t   the host registry `registry`, requiring the pinned `yang.call` revision\n5391\t   at `call-address`; a free name nothing supplies is refused before\n5392\t   anything is published. This namespace emits; it never publishes.\"\n5393\t  [registry call-address]\n5394\t  (core/module-spec {:module-name module-name,\n5395\t                     :ast module-uast,\n5396\t                     :exports module-exports,\n5397\t                     :requires {call/module-name call-address},\n5398\t                     :free-names module-free-names,\n5399\t                     :skip? #(= \"yang.call\" (namespace %)),\n5400\t                     :registry registry,\n5401\t                     :message \"the php module reads an undeclared name\",\n5402\t                     :refusal-ns \"yang.php\"}))\n5403\t\n5404\t\n5405\t(def min-integer-bits\n5406\t  \"The smallest `::integer/max-bits` this profile admits: the exact float\n5407\t   expansion `m * 5^k` needs about 2200 bits.\"\n5408\t  4096)\n5409\t\n5410\t\n5411\t(def min-integer-digits\n5412\t  \"The smallest `::integer/max-digits` this profile admits: the exact float\n5413\t   expansion has up to about 770 digits.\"\n5414\t  1000)\n5415\t\n5416\t\n5417\t(defn register-integer-module\n5418\t  \"Return `registry` with the `integer` module installed under `limits`,\n5419\t   refused when they are under this profile's minimum.\"\n5420\t  [registry limits]\n5421\t  (let [b (::integer/max-bits limits)\n5422\t        d (::integer/max-digits limits)]\n5423\t    (when-not (and (int? b) (<= min-integer-bits b) (int? d) (<= min-integer-digits d))\n5424\t      (throw (ex-info \"the PHP profile needs integer max-bits >= 4096 and max-digits >= 1000\"\n5425\t                      {:yang.php/refusal :yang.php/limits,\n5426\t                       ::integer/max-bits b,\n5427\t                       ::integer/max-digits d}))))\n5428\t  (integer/register-integer-module registry limits))\n5429\t\n5430\t\n5431\t(defn admit\n5432\t  \"Return `registry` when it supplies every one of `host-names`, else refuse\n5433\t   it before any program runs, naming each missing export in\n5434\t   `:yang.php/missing`.\"\n5435\t  [registry]\n5436\t  (core/admit registry host-names\n5437\t              \"the composition lacks host names the prelude calls\""}
