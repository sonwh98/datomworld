{"role":"tool","tool_call_id":"tool_I0wJSMECeexSFAZAasbFR4W7","content":"1330\t    (with-keys ctx loc (fn [l] (ref-source-loc ctx n l)))))\n1331\t\n1332\t\n1333\t;; -----------------------------------------------------------------------------\n1334\t;; Destructuring\n1335\t;; -----------------------------------------------------------------------------\n1336\t;; `[$a, $b] = e`, `list($a, , $c) = e`, `['k' => $v] = e`, nested, and one\n1337\t;; level of `&` targets. A pattern is a vector of entries `{:key expr-or-nil\n1338\t;; :idx n :ref? bool :target chain-or-pattern}`; holes only advance `:idx`.\n1339\t;; The source is evaluated once; a missing key warns and assigns null, a\n1340\t;; non-array source assigns null silently. The expression's value is the\n1341\t;; source.\n1342\t\n1343\t(declare pattern-of)\n1344\t\n1345\t\n1346\t(defn- destructure-target\n1347\t  \"A chain node, or the nested pattern of an array literal / `list(...)`.\"\n1348\t  [ctx n e ref?]\n1349\t  (let [e (if (p/rule? e \"expression\")\n1350\t            (let [ks (core/kids ctx e)]\n1351\t              (if (and (= 1 (count ks)) (p/rule? (first ks) \"chain\")) (first ks) e))\n1352\t            e)]\n1353\t    (cond\n1354\t      (p/rule? e \"chain\") e\n1355\t      ref? (unsupported! n :list)\n1356\t      :else\n1357\t      (let [ks (core/kids ctx e)\n1358\t            inner (first ks)]\n1359\t        (if (and (= 1 (count ks)) (p/rule? inner \"arrayCreation\"))\n1360\t          (pattern-of ctx n inner)\n1361\t          (unsupported! n :list))))))\n1362\t\n1363\t\n1364\t(defn- sequence-entries\n1365\t  \"Entries from a stream of `[:item x]` / `:comma` events: a comma that does\n1366\t   not follow an item is a hole; trailing holes are dropped.\"\n1367\t  [events]\n1368\t  (let [[out _ _]\n1369\t        (reduce (fn [[out idx pending?] ev]\n1370\t                  (if (= ev :comma)\n1371\t                    (if pending? [out idx false] [(conj out nil) (inc idx) false])\n1372\t                    [(conj out ev) (inc idx) true]))\n1373\t                [[] 0 false]\n1374\t                events)\n1375\t        trimmed (loop [v out] (if (and (seq v) (nil? (peek v))) (recur (pop v)) v))]\n1376\t    (vec (keep-indexed (fn [i e] (when e (assoc e :idx i))) trimmed))))\n1377\t\n1378\t\n1379\t(defn- pattern-of\n1380\t  \"The pattern of an `arrayDestructuring`, `arrayCreation` or `assignmentList`.\"\n1381\t  [ctx n node]\n1382\t  (let [entry (fn [key ref? target] {:key key, :ref? ref?, :target target})]\n1383\t    (sequence-entries\n1384\t      (case (:rule node)\n1385\t        \"arrayDestructuring\"\n1386\t        (mapcat (fn [k]\n1387\t                  (cond\n1388\t                    (p/token? k \",\") [:comma]\n1389\t                    (p/rule? k \"indexedDestructItem\")\n1390\t                    (let [ref? (boolean (some #(p/token? % \"&\") (core/kids ctx k)))]\n1391\t                      [(entry nil ref? (destructure-target ctx n (first (core/rules ctx k \"chain\")) ref?))])\n1392\t                    (p/rule? k \"keyedDestructItem\")\n1393\t                    (let [ref? (boolean (some #(p/token? % \"&\") (core/kids ctx k)))]\n1394\t                      [(entry (first (core/rules ctx k \"expression\")) ref?\n1395\t                              (destructure-target ctx n (first (core/rules ctx k \"chain\")) ref?))])\n1396\t                    :else []))\n1397\t                (core/kids ctx node))\n1398\t        \"arrayCreation\"\n1399\t        (mapcat (fn [k]\n1400\t                  (cond\n1401\t                    (p/token? k \",\") [:comma]\n1402\t                    (p/rule? k \"arrayItem\")\n1403\t                    (let [kids (core/kids ctx k)\n1404\t                          ref? (boolean (some #(p/token? % \"&\") kids))\n1405\t                          exprs (core/rules ctx k \"expression\")\n1406\t                          keyed? (boolean (some #(p/token? % \"=>\") kids))\n1407\t                          key (when keyed? (first exprs))\n1408\t                          target (if ref? (first (core/rules ctx k \"chain\")) (last exprs))]\n1409\t                      [(entry key ref? (destructure-target ctx n target ref?))])\n1410\t                    :else []))\n1411\t                (mapcat #(core/kids ctx %) (core/rules ctx node \"arrayItemList\")))\n1412\t        \"assignmentList\"\n1413\t        (mapcat (fn [k]\n1414\t                  (cond\n1415\t                    (p/token? k \",\") [:comma]\n1416\t                    (p/rule? k \"assignmentListElement\")\n1417\t                    (let [kids (core/kids ctx k)\n1418\t                          c (first kids)]\n1419\t                      (cond\n1420\t                        (p/rule? c \"chain\") [(entry nil false c)]\n1421\t                        (p/rule? c \"arrayItem\")\n1422\t                        (let [ref? (boolean (some #(p/token? % \"&\") (core/kids ctx c)))\n1423\t                              exprs (core/rules ctx c \"expression\")\n1424\t                              keyed? (boolean (some #(p/token? % \"=>\") (core/kids ctx c)))\n1425\t                              target (if ref? (first (core/rules ctx c \"chain\")) (last exprs))]\n1426\t                          [(entry (when keyed? (first exprs)) ref?\n1427\t                                  (destructure-target ctx n target ref?))])\n1428\t                        :else [(entry nil false (pattern-of ctx n (first (core/rules ctx k \"assignmentList\"))))]))\n1429\t                    :else []))\n1430\t                (core/kids ctx node))))))\n1431\t\n1432\t\n1433\t(defn- destructure-nodes\n1434\t  \"Statements storing each entry of `pattern` from the value bound to `src-sym`.\n1435\t   `src-loc` is the source location (keys lowered) when it is one, so a\n1436\t   by-reference entry can bind the slot.\"\n1437\t  [ctx n pattern src-sym src-loc]\n1438\t  (mapv\n1439\t    (fn [{:keys [key idx ref? target]}]\n1440\t      (let [keynode (if key (lower ctx key) (u/lit idx))]\n1441\t        (cond\n1442\t          ref?\n1443\t          (do (when-not src-loc (compile-error! n \"Cannot assign reference to non referenceable value\"))\n1444\t              (when (vector? target) (unsupported! n :nested-destructure-by-ref))\n1445\t              (let [loc (chain-loc ctx n target :assignment-target)\n1446\t                    k (core/gen \"dk\" n)]\n1447\t                (u/let1 k\n1448\t                        keynode\n1449\t                        (with-keys\n1450\t                          ctx\n1451\t                          loc\n1452\t                          (fn [target-loc]\n1453\t                            (let [marker (ref-source-loc ctx n (update src-loc :path conj (u/v k)))]\n1454\t                              (if (empty? (:path target-loc))\n1455\t                                (bind-var ctx (:var target-loc) marker)\n1456\t                                (put-var ctx\n1457\t                                         (:var target-loc)\n1458\t                                         (app* 'php/path-bind\n1459\t                                               (peek-var ctx (:var target-loc))\n1460\t                                               (path-node (:path target-loc))\n1461\t                                               marker)))))))))\n1462\t          (vector? target)\n1463\t          (let [t (core/gen \"dt\" n)]\n1464\t            (u/let1 t\n1465\t                    (app* 'php/addref (app* 'php/list-get (u/v src-sym) keynode))\n1466\t                    (u/seq-nodes (destructure-nodes ctx n target t nil))))\n1467\t          :else\n1468\t          (let [loc (chain-loc ctx n target :assignment-target)]\n1469\t            (with-keys ctx loc\n1470\t              (fn [l]\n1471\t                (write-loc ctx n l (app* 'php/addref (app* 'php/list-get (u/v src-sym) keynode)))))))))\n1472\t    pattern))\n1473\t\n1474\t\n1475\t(defn- lower-destructure\n1476\t  \"Lower `pattern-node-or-pattern = rhs`.\"\n1477\t  [ctx n pattern rhs]\n1478\t  (let [src (core/gen \"ds\" n)\n1479\t        rhs-chain (when (p/rule? rhs \"expression\")\n1480\t                    (let [ks (core/kids ctx rhs)]\n1481\t                      (when (and (= 1 (count ks)) (p/rule? (first ks) \"chain\")) (first ks))))\n1482\t        src-loc (when rhs-chain (chain-location ctx rhs-chain))\n1483\t        body (fn [sl]\n1484\t               (u/let1 src\n1485\t                       (lower ctx rhs)\n1486\t                       (u/then (u/seq-nodes (destructure-nodes ctx n pattern src sl))\n1487\t                               (u/v src))))]\n1488\t    (if (and src-loc (some :ref? pattern))\n1489\t      (with-keys ctx (lower-path ctx src-loc) body)\n1490\t      (body nil))))\n1491\t\n1492\t\n1493\t(defn- lower-assign-ref\n1494\t  \"`$x =& $y`, `$x =& $a[k]`, `$a[k] =& $y`: the source's marker first (its\n1495\t   keys, then the fetch), then the target's keys, then the binding.\"\n1496\t  [ctx n target src]\n1497\t  (let [chain (first (core/kids ctx target))\n1498\t        loc (if (p/rule? chain \"chain\")\n1499\t              (chain-loc ctx n chain :assignment-target)"}
{"role":"tool","tool_call_id":"tool_KDEpWCmRHFNORzbRr9DYYET2","content":"1\t(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\n2\t yang.php.antlr.prelude\n3\t  \"The PHP runtime profile, written as Universal AST\n4\t   (docs/design/yang.php.md sections 3.5, 7, 9). PHP semantics for operators,\n5\t   juggling, comparison, output and errors live here as guest code, not in\n6\t   Clojure: the lowering only emits applications of these names.\n7\t\n8\t   Value encoding (P1):\n9\t     int             host integer in [-2^63, 2^63-1] (a BigInt carrier on JS\n10\t                     past 2^53); every operator computes the exact result\n11\t                     through the `integer` module and demotes to float when\n12\t                     it leaves the range\n13\t     float           untagged Jing float64 content (`data/float64`), the\n14\t                     shared ruling of yang.typescript.md section 2; the kind\n15\t                     test is `php/kind`, never a second tag. The prelude\n16\t                     holds no integral float literal (JS reads 1.0 as 1):\n17\t                     floats are built with `data/float64` or computed, and\n18\t                     host arithmetic only ever sees `data/float-value`\n19\t     string          a host string whose every char is one byte (a latin-1\n20\t                     carrier); the lowering resolves literal text to bytes\n21\t     bool            host true / false\n22\t     null            :php/null\n23\t     array           {:php/type :array :index {key value} :order [key ...]\n24\t                     :next-index n}: a persistent ordered map; keys are\n25\t                     ints or strings (`php/array-key`); `:next-index` is\n26\t                     absent until the first integer key is written\n27\t     error object    {:php/type :obj :class name :ord n :props {\\\"message\\\"\n28\t                     \\\"code\\\" \\\"previous\\\"}}\n29\t     function        a cell {:php/type :function :name s :code (fn [args])\n30\t                             :yang.call/entry (fn [invocation])}\n31\t\n32\t   Runtime state is allocated by `php/init!`, once per task, under the slot\n33\t   `php.rt/state` (the literal `:php/uninit` until `php/init!` flips it to\n34\t   `:php/ready` as its last write):\n35\t     php.rt/ctx            the dynamic context {:handlers :depth :base :frame}\n36\t     php.rt/out            a cell holding the buffer stack, a vector of\n37\t                           buffers, each a vector of byte-string chunks;\n38\t                           `php/echo` conjs onto the last buffer, the\n39\t                           bottom buffer is never popped\n40\t     php.rt/globals        a cell holding the plain array of section 10.1\n41\t                           (`$GLOBALS`), `(php/empty-array)` initially\n42\t     php.rt/functions      a cell holding a map of lower-cased name to\n43\t                           function cell; builtins are pre-seeded\n44\t     php.rt/classes        a cell holding a map of class name to class record\n45\t                           (the Throwable hierarchy, data only)\n46\t     php.rt/next-ord       a cell, the per-task object ordinal\n47\t     php.rt/next-cell      a cell, the per-task counted-cell id (`:id`)\n48\t     php.rt/request        a cell holding the explicit request record\n49\t     php.rt/response       a cell holding ordered response records\n50\t     php.rt/headers-sent, php.rt/status   output state and the response status\n51\t     php.rt/error-handler  a cell, :php/null or a callable\n52\t     php.rt/error-handlers a cell holding previous handlers for restoration\n53\t     php.rt/error-reporting a cell, the mask (E_ALL initially)\n54\t     php.rt/diag           a cell, the vector of diagnostic records\n55\t     php.rt/int-max, php.rt/int-min   exact integers computed in `init!`,\n56\t                           never literals (literals past 2^53 are not\n57\t                           portable)\n58\t\n59\t   Errors are raised with `php/raise`; with no handler frame above them they\n60\t   reach the unit root, `php/run-main`, which answers output, response and\n61\t   diagnostic records, any uncaught error, and an exit status when present.\n62\t\n63\t   Float text: `php/float-text x ndigit` is `zend_gcvt`; `ndigit` 14 is\n64\t   `echo` (precision), 17 is `var_dump` (serialize_precision -1, the\n65\t   shortest round trip from `integer/float-digits`).\n66\t\n67\t   Two emitters, one source: `definitions` is the only definition list.\n68\t   `uast` is the bundled prelude; `module-uast` is the same list as the\n69\t   linker module `php`. The module emitter strips only the module's own\n70\t   namespace `php/`; `php.rt/*` stays qualified.\n71\t\n72\t   Host names the prelude depends on and does not define: `host-names`.\"\n73\t  (:require\n74\t    #?(:cljd [clojure.edn :as edn])\n75\t    [clojure.string :as str]\n76\t    [clojure.walk :as walk]\n77\t    [yang.core.prelude :as core]\n78\t    [yang.core.call :as call]\n79\t    [yang.core.uast :as u]\n80\t    [yang.php.antlr.builtins :as builtins]\n81\t    [yang.php.antlr.prelude-module :as module-defs]\n82\t    [yang.php.antlr.quoted :refer [defquoted]]\n83\t    [yin.vm.integer :as integer]))\n84\t\n85\t\n86\t(def host-names\n87\t  \"Module exports the prelude calls.\"\n88\t  (into '#{cell/new cell/get cell/set! data/count data/nth data/subvec data/str-concat\n89\t           data/str-length data/str-join data/str-compare data/str->code-points\n90\t           data/code-points->str data/substring data/float64 data/float-value\n91\t           data/content= data/number? data/dissoc data/into\n92\t           integer/add integer/sub integer/neg integer/mul integer/compare\n93\t           integer/to-float integer/compare-float integer/true-div integer/pow\n94\t           integer/shift-left integer/shift-right integer/bit-and integer/bit-or\n95\t           integer/bit-xor integer/bit-not integer/from-float integer/quot-rem\n96\t           integer/floor-div-mod integer/format integer/parse\n97\t           integer/float-digits integer/decimal->float}\n98\t        call/host-names))\n99\t\n100\t\n101\t(defquoted ^:private core-definitions\n102\t  \"Pure definitions: lambdas only, so defining them runs nothing.\"\n103\t  '[;; ---------------------------------------------------------------- basics\n104\t    [php/vconj (fn [xs x] (conj xs x))]\n105\t    [php/pair (fn [a b] (php/vconj (php/vconj [] a) b))]\n106\t    [php/f (fn [h] (data/float64 h))]\n107\t    [php/h (fn [x] (data/float-value x))]\n108\t    [php/inf (fn [] (data/float-value ##Inf))]\n109\t    [php/nan (fn [] (- (php/inf) (php/inf)))]\n110\t    [php/nan? (fn [h] (not (<= h h)))]\n111\t    [php/zero-h (fn [] (data/float-value 0))]\n112\t    ;; -0.0 is built as (* -1.0 0.0): ClojureDart compiles one-argument `-`\n113\t    ;; to (0 - x), and 0 - 0.0 is +0.0\n114\t    [php/neg-zero-h (fn [] (* (data/float-value -1) (data/float-value 0)))]\n115\t    [php/abs-h (fn [h] (if (< h 0) (- 0 h) h))]\n116\t    [php/neg-h (fn [h] (* (data/float-value -1) h))]\n117\t    [php/nan-const (fn [] (php/f (php/nan)))]\n118\t    [php/inf-const (fn [] (php/f (php/inf)))]\n119\t\n120\t    ;; ---------------------------------------------------------------- kinds\n121\t    ;; A string is the only value `get` answers a char (or, empty, equals\n122\t    ;; \"\") for; typed maps answer :php/type; what is left is a number.\n123\t    [php/string?\n124\t     (fn [x] (if (= x \"\") true (not (nil? (get x 0)))))]\n125\t    [php/kind\n126\t     (fn [x]\n127\t       (if (= x :php/null)\n128\t         :null\n129\t         (if (= x true)\n130\t           :bool\n131\t           (if (= x false)\n132\t             :bool\n133\t             (if (nil? (get x :php/type))\n134\t               (if (php/string? x)\n135\t                 :string\n136\t                 (if (not (nil? (get x :php/arr)))\n137\t                   :array\n138\t                   (if (not (nil? (get x :php/obj)))\n139\t                     :obj\n140\t                     (if (not (nil? (get x :php/ref)))\n141\t                       (php/kind (php/ref-value x))\n142\t                       (if (data/content= x (data/float64 (data/float-value x)))\n143\t                         :float\n144\t                         :int)))))\n145\t               (if (= (get x :php/type) :array) :array :obj))))))]\n146\t    [php/int? (fn [x] (= (php/kind x) :int))]\n147\t    [php/float? (fn [x] (= (php/kind x) :float))]\n148\t    [php/numk? (fn [k] (if (= k :int) true (= k :float)))]\n149\t    [php/fl\n150\t     ;; the host double of an int or float\n151\t     (fn [x] (if (php/int? x) (integer/to-float x) (data/float-value x)))]\n152\t    [php/type-name\n153\t     (fn [k]\n154\t       (if (= k :string) \"string\"\n155\t           (if (= k :int) \"int\"\n156\t               (if (= k :float) \"float\"\n157\t                   (if (= k :bool) \"bool\"\n158\t                       (if (= k :null) \"null\"\n159\t                           (if (= k :array) \"array\" \"mixed\")))))))]\n160\t\n161\t    ;; ---------------------------------------------------------------- escapes\n162\t    ;; The dynamic context is one record in one cell: every capture point\n163\t    ;; saves it and every escape restores it with :base left alone. The\n164\t    ;; handler stack is a chain of frames [kind payload rest n depth].\n165\t    [php/ctx\n166\t     (fn [handlers depth base frame]\n167\t       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\n168\t                     :base base)\n169\t              :frame frame))]\n170\t    [php/restore!"}
