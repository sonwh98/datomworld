= new C; try { $c->p[] = 1; } catch (Error $e) { echo $e->getMessage(); }\"\n661\t       \"Cannot auto-initialize an array inside property C::$p of type int\")\n662\t   (fx :obj-row22-destructor-creates-global :objects-v1 [22] #{:p4-s6}\n663\t       \"<?php class B { function __destruct() { echo 'b'; } } class A { function __destruct() { global $next; $next = new B; echo 'a'; } } $x = new A;\"\n664\t       \"ab\")\n665\t   (fx :obj-row57-unknown-named-object-argument-destroyed :objects-v1 [57] #{:p4-s6}\n666\t       \"<?php class D { function __destruct() { echo 'D'; } } function f($x) {} try { f(bad: new D); } catch (Error $e) { echo get_class($e); }\"\n667\t       \"DError\")\n668\t   (fx :obj-row57-unknown-named-by-ref-callee-no-vivification :objects-v1 [57] #{:p4-s6}\n669\t       \"<?php function g(&$x) {} try { g(bad: $u); } catch (Error $e) { echo get_class($e); } var_dump(isset($u));\"\n670\t       \"Errorbool(false)\\n\")\n671\t   (assoc (fx :obj-row65-spread-string-keys :objects-v1 [65] #{:p4-s6}\n672\t              \"<?php function f($a, $b) { return $a - $b; } echo f(...['b' => 1, 'a' => 2]);\"\n673\t              nil)\n674\t          :departure {:gap \"C25\", :zend \"1\"}\n675\t          :impl-out \"\"\n676\t          :throws true)\n677\t   (assoc (fx :obj-row65-positional-after-string-key-spread :objects-v1 [65] #{:p4-s6}\n678\t              \"<?php function f($a, $b) { return $a - $b; } try { echo f(...['a' => 1], ...[2]); } catch (Error $e) { echo 'E'; }\"\n679\t              nil)\n680\t          :departure {:gap \"C25\", :zend \"-1\"}\n681\t          :impl-out \"E\"\n682\t          :throws true)\n683\t   (fx :ctor-no-constructor-zero-args :constructor-v1 [53] #{:p4-s6}\n684\t       \"<?php class A {} $a = new A(); echo get_class($a);\"\n685\t       \"A\")\n686\t   (fx :ctor-no-constructor-side-effecting-args :constructor-v1 [53] #{:p4-s6}\n687\t       \"<?php class A {} function s() { echo 'S'; return 1; } new A(s()); echo 'x';\"\n688\t       \"Sx\")