\" []]\n5118\t   [\"BadMethodCallException\" :class \"BadFunctionCallException\" []]\n5119\t   [\"OutOfBoundsException\" :class \"RuntimeException\" []]\n5120\t   [\"RangeException\" :class \"RuntimeException\" []]\n5121\t   [\"OverflowException\" :class \"RuntimeException\" []]\n5122\t   [\"UnderflowException\" :class \"RuntimeException\" []]\n5123\t   [\"UnexpectedValueException\" :class \"RuntimeException\" []]])\n5124\t\n5125\t\n5126\t(defn- throwable-members\n5127\t  \"The properties and native methods Exception and Error declare, which every\n5128\t   subclass inherits.\"\n5129\t  [nm]\n5130\t  {:props-decl (mapv (fn [[pn vis default]]\n5131\t                       {:name pn,\n5132\t                        :vis vis,\n5133\t                        :declaring nm,\n5134\t                        :id (if (= vis :private) (str nm \"::\" pn) pn),\n5135\t                        :default default})\n5136\t                     [[\"message\" :protected \"\"] [\"code\" :protected 0] [\"file\" :protected \"\"]\n5137\t                      [\"line\" :protected 0] [\"previous\" :private :php/null]]),\n5138\t   :methods (mapv (fn [[mn kind]]\n5139\t                    {:name mn,\n5140\t                     :lc (str/lower-case mn),\n5141\t                     :vis :public,\n5142\t                     :declaring nm,\n5143\t                     :final? (not= kind :ctor),\n5144\t                     :native kind})\n5145\t                  [[\"__construct\" :ctor] [\"getMessage\" :message] [\"getCode\" :code]\n5146\t                   [\"getPrevious\" :previous] [\"getFile\" :file] [\"getLine\" :line]\n5147\t                   [\"getTrace\" :trace] [\"getTraceAsString\" :trace-string]])})\n5148\t\n5149\t\n5150\t(defn- error-exception-members\n5151\t  \"ErrorException: Exception's members, the `severity` property, its own\n5152\t   constructor and `getSeverity`.\"\n5153\t  []\n5154\t  (let [m (throwable-members \"Exception\")\n5155\t        replace-method (fn [methods e] (conj (vec (remove #(= (:lc %) (:lc e)) methods)) e))\n5156\t        entry (fn [mn kind]\n5157\t                {:name mn, :lc (str/lower-case mn), :vis :public, :declaring \"ErrorException\",\n5158\t                 :final? (not= kind :ee-ctor), :native kind})]\n5159\t    (assoc m\n5160\t           :props-decl (conj (:props-decl m)\n5161\t                             {:name \"severity\", :vis :protected, :declaring \"ErrorException\",\n5162\t                              :id \"severity\", :default 1})\n5163\t           :methods (-> (:methods m)\n5164\t                        (replace-method (entry \"__construct\" :ee-ctor))\n5165\t                        (replace-method (entry \"getSeverity\" :severity))))))\n5166\t\n5167\t\n5168\t(def ^:private seed-table\n5169\t  \"Name to descriptor, with the lower-cased `:ancestors` the declaration code\n5170\t   reads. The Throwable family carries its inherited members.\"\n5171\t  (reduce (fn [table [nm kind parent ifaces final?]]\n5172\t            (let [lc (str/lower-case nm)\n5173\t                  anc (reduce (fn [acc x] (into acc (remove (set acc)) (:ancestors (get table x))))\n5174\t                              [lc]\n5175\t                              (concat (when parent [parent]) ifaces))\n5176\t                  members (if (contains? #{\"Exception\" \"Error\"} nm)\n5177\t                            (throwable-members nm)\n5178\t                            (if (= nm \"ErrorException\")\n5179\t                              (error-exception-members)\n5180\t                              (select-keys (get table parent) [:props-decl :methods])))]\n5181\t              (assoc table\n5182\t                     nm (merge {:php/type :class,\n5183\t                                :name nm,\n5184\t                                :kind kind,\n5185\t                                :parent (or parent :php/null),\n5186\t                                :interfaces ifaces,\n5187\t                                :traits [],\n5188\t                                :ancestors anc,\n5189\t                                :abstract? false,\n5190\t                                :final? (boolean final?),\n5191\t                                :constants [],\n5192\t                                :props-decl [],\n5193\t                                :static-props [],\n5194\t                                :methods [],\n5195\t                                :cases [],\n5196\t                                :attrs []}\n5197\t                               members))))\n5198\t          {}\n5199\t          seed-classes))\n5200\t\n5201\t\n5202\t(def ^:private define core/define)\n5203\t\n5204\t\n5205\t(defn- constants-form\n5206\t  \"The guest map expression seeding `php.rt/constants` from\n5207\t   `builtins/constants`, so `defined` and `constant` agree with the\n5208\t   lowering's folded literals.\"\n5209\t  []\n5210\t  (reduce (fn [m [nm v]]\n5211\t            (list 'assoc\n5212\t                  m\n5213\t                  nm\n5214\t                  (cond\n5215\t                    (= v :nan) '(php/nan-const)\n5216\t                    (= v :inf) '(php/inf-const)\n5217\t                    (and (vector? v) (= :int (first v)))\n5218\t                    (if (str/starts-with? (second v) \"-\")\n5219\t                      (list 'php/int-lit-radix (second v) 10)\n5220\t                      (list 'php/int-lit (second v)))\n5221\t                    (and (vector? v) (= :float (first v)))\n5222\t                    (list 'php/f (list 'data/float-value (nth v 2)))\n5223\t                    :else v)))\n5224\t          {}\n5225\t          (sort-by key builtins/constants)))\n5226\t\n5227\t\n5228\t(defn- init-form\n5229\t  \"`php/init!`'s body: the runtime cells, the builtins, the ready flag, under\n5230\t   the uninit guard.\"\n5231\t  []\n5232\t  (list 'fn []\n5233\t        (list 'if (list '= 'php.rt/state :php/uninit)\n5234\t              (concat\n5235\t                ['do\n5236\t                 (define 'php.rt/ctx '(cell/new (php/ctx nil 0 0 nil)))\n5237\t                 (define 'php.rt/out '(cell/new [[]]))\n5238\t                 (define 'php.rt/request '(cell/new {}))\n5239\t                 (define 'php.rt/response '(cell/new []))\n5240\t                 (define 'php.rt/headers-sent '(cell/new false))\n5241\t                 (define 'php.rt/status '(cell/new 200))\n5242\t                 (define 'php.rt/error-handlers '(cell/new []))\n5243\t                 (define 'php.rt/globals\n5244\t                   '(cell/new (php/empty-array)))\n5245\t                 (define 'php.rt/functions '(cell/new {}))\n5246\t                 (define 'php.rt/classes (list 'cell/new seed-table))\n5247\t                 (define 'php.rt/class-index\n5248\t                   (list 'cell/new\n5249\t                         (into {} (map (fn [nm] [(str/lower-case nm) nm])) (keys seed-table))))\n5250\t                 (define 'php.rt/next-ord '(cell/new 1))\n5251\t                 (define 'php.rt/finalizable '(cell/new []))\n5252\t                 (define 'php.rt/strict '(cell/new false))\n5253\t                 (define 'php.rt/exception-handler '(cell/new :php/null))\n5254\t                 (define 'php.rt/exception-handlers '(cell/new []))\n5255\t                 (define 'php.rt/class-order '(cell/new []))\n5256\t                 (define 'php.rt/shutdown-fns '(cell/new []))\n5257\t                 (define 'php.rt/pending-exc '(cell/new :php/null))\n5258\t                 (define 'php.rt/cmp-depth '(cell/new 0))\n5259\t                 (define 'php.rt/tmps '(cell/new []))\n5260\t                 (define 'php.rt/next-cell '(cell/new 1))\n5261\t                 (define 'php.rt/error-handler '(cell/new :php/null))\n5262\t                 ;; E_ALL\n5263\t                 (define 'php.rt/error-reporting '(cell/new 32767))\n5264\t                 (define 'php.rt/diag '(cell/new []))\n5265\t                 (define 'php.rt/included '(cell/new {}))\n5266\t                 (define 'php.rt/unit '(cell/new :php/null))\n5267\t                 (define 'php.rt/path-map '(cell/new {}))\n5268\t                 (define 'php.rt/class-map '(cell/new {}))\n5269\t                 (define 'php.rt/autoloaders '(cell/new []))\n5270\t                 (define 'php.rt/autoloading '(cell/new {}))\n5271\t                 (define 'php.rt/int-max\n5272\t                   '(integer/sub (integer/shift-left 1 63) 1))\n5273\t                 (define 'php.rt/int-min\n5274\t                   '(integer/neg (integer/shift-left 1 63)))\n5275\t                 ;; after the integer bounds: the seeds build integers\n5276\t                 (define 'php.rt/constants (list 'cell/new (constants-form)))]\n5277\t                [(cons 'do\n5278\t                       (mapv (fn [[nm sym]] (list 'php/register! nm sym))\n5279\t                             builtins))]\n5280\t                ;; last, so a failed init never reports ready\n5281\t                [(define 'php.rt/state :php/ready) :php/null])\n5282\t              :php/null)))\n5283\t\n5284\t\n5285\t(def definitions\n5286\t  \"The single definition list, `[store-key form]` in definition order: every\n5287\t   prelude function, the literal state slot, then `php/init!`. Defining them\n5288\t   runs nothing.\"\n5289\t  (into (into core-definitions module-defs/definitions)\n5290\t        [['php.rt/state :php/uninit]\n5291\t         ['php/init! (init-form)]]))\n5292\t\n5293\t\n5294\t(def functions-uast\n5295\t  \"The bundled shared-call definitions, PHP lambdas and literal state slot.\"\n5296\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form)))\n5297\t                    (into call/definitions definitions))))\n5298\t\n5299\t\n5300\t(def uast\n5301\t  \"The bundled prelude: every definition, then the task's runtime state\n5302\t   allocated by `php/init!`.\"\n5303\t  (u/then functions-uast (u/sexp->uast '(php/init!))))\n5304\t\n5305\t\n5306\t;; =============================================================================\n5307\t;; The