{"role":"tool","tool_call_id":"tool_fNasRjbBmUlN9foUaIGs2XHO","content":"1\t(ns yang.php.antlr.programs-p5\n2\t  \"P5 request-context fixtures. Expectations are hand-derived from PHP 8.3;\n3\t  every fixture remains available to the oracle recording pass.\")\n4\t\n5\t\n6\t(defn request-array\n7\t  [entries]\n8\t  {:php/type :array, :index (into {} entries), :order (mapv first entries)})\n9\t\n10\t\n11\t(def request\n12\t  {:php.request/method \"POST\"\n13\t   :php.request/uri \"/hello?a=1\"\n14\t   :php.request/query (request-array [[\"a\" \"1\"] [\"shared\" \"get\"]])\n15\t   :php.request/headers (request-array [[\"X-Test\" \"yes\"]])\n16\t   :php.request/cookies (request-array [[\"session\" \"abc\"]])\n17\t   :php.request/body (request-array [[\"b\" \"2\"] [\"shared\" \"post\"]])\n18\t   :php.request/server (request-array [[\"SERVER_NAME\" \"fixture.test\"]])\n19\t   :php.request/env (request-array [[\"APP_ENV\" \"test\"]])\n20\t   :php.request/files (request-array [[\"upload\" \"fixture\"]])})\n21\t\n22\t\n23\t(defn- fx\n24\t  [id source out & {:as more}]\n25\t  (merge {:id id, :group :request-context, :source source, :out out,\n26\t          :request request, :oracle :pending}\n27\t         more))\n28\t\n29\t\n30\t(def fixtures\n31\t  [(fx :superglobals-from-request\n32\t       (str \"<?php echo $_GET['a'], $_POST['b'], $_COOKIE['session'],\"\n33\t            \" $_SERVER['REQUEST_METHOD'], $_SERVER['REQUEST_URI'],\"\n34\t            \" $_SERVER['SERVER_NAME'], $_ENV['APP_ENV'], $_FILES['upload'],\"\n35\t            \" $_REQUEST['a'], $_REQUEST['b'], $_REQUEST['shared'];\")\n36\t       \"12abcPOST/hello?a=1fixture.testtestfixture12post\")\n37\t   (fx :output-buffering\n38\t       \"<?php ob_start(); echo 'a'; echo ob_get_contents(); ob_start(); echo 'b'; echo ob_get_clean(); echo ob_get_clean(); echo 'c';\"\n39\t       \"aabc\")\n40\t   (fx :output-buffer-flush\n41\t       \"<?php ob_start(); echo 'a'; ob_end_flush(); echo 'b'; var_dump(ob_end_clean());\"\n42\t       \"abbool(false)\\n\")\n43\t   (fx :headers-cookies-status\n44\t       \"<?php header('X-One: 1'); setcookie('sid', 'abc'); http_response_code(201); echo http_response_code();\"\n45\t       \"201\"\n46\t       :response [{:php.response/header \"X-One: 1\", :replace true}\n47\t                  {:php.response/cookie {:name \"sid\", :value \"abc\"}}\n48\t                  {:php.response/status 201}\n49\t                  {:php.response/body \"201\"}])\n50\t   (fx :headers-after-output\n51\t       \"<?php echo 'x'; header('X-Late: 1'); var_dump(headers_sent());\"\n52\t       \"xbool(true)\\n\"\n53\t       :diag [[2 \"Cannot modify header information - headers already sent\"]]\n54\t       :response [{:php.response/body \"xbool(true)\\n\"}])\n55\t   (fx :error-handler-and-warnings\n56\t       (str \"<?php set_error_handler(function($n, $s) { echo 'H', $n, ':', $s; });\"\n57\t            \" trigger_error('first', E_USER_WARNING); restore_error_handler();\"\n58\t            \" trigger_error('second', E_USER_NOTICE);\")\n59\t       \"H512:first\"\n60\t       :diag [[1024 \"second\"]])\n61\t   (fx :exit-runs-shutdown\n62\t       \"<?php register_shutdown_function(function() { echo 'S'; }); echo 'A'; exit(7); echo 'B';\"\n63\t       \"AS\"\n64\t       :status 7)\n65\t   (fx :exit-string\n66\t       \"<?php echo 'A'; die('B'); echo 'C';\"\n67\t       \"AB\"\n68\t       :status 0)])"}
{"role":"tool","tool_call_id":"tool_Y46hMCyNvcktVgK52rcQqzpS","content":"1\t(ns yang.php.antlr.programs-p6\n2\t  \"Slice P6 Stage 0 (S0) fixture data: include/require over the linker\n3\t   (P6 plan v2, S0). Same schema as `yang.php.antlr.programs-p3b`, plus:\n4\t     :units     {path source} for a multi-unit fixture, every unit including\n5\t                the entry unit; absent for a one-file fixture\n6\t     :main      the entry unit's path, default \\\"main.php\\\"\n7\t     :computed  true when the entry unit's computed includes resolve through\n8\t                the composition's published path map (every non-entry unit)\n9\t     :warnings  the lowering warnings the entry unit must report\n10\t   Every fixture is `:oracle :pending` until the shiva recording pass, and\n11\t   `:requires` names the P6 steps (:p6-s2 .. :p6-s5, :p6-s2-r8 for the\n12\t   per-unit strict_types rule) that must land before an implementation\n13\t   runner may execute it. `:out` and `:diag` are pinned only where the\n14\t   language fixes them; otherwise they are absent and the recorded output is\n15\t   taken. A mismatch is escalated to the Architect and never fixed by\n16\t   editing the expectation.\n17\t\n18\t   Groups: :inclusion-v1, :missing-v1 (the oracle-pinned half; the\n19\t   pinned-but-unserved half is asserted in the linked tests), :namespaces-v1,\n20\t   :constants-v1, :autoload-v1, :strict-v1. `all-fixtures` is unconditional\n21\t   (the oracle iterates it); `enabled` is the subset whose :requires have all\n22\t   landed in `completed-steps`.\"\n23\t  (:require\n24\t    [yang.php.antlr.programs-p3b :as p3b]))\n25\t\n26\t\n27\t(def completed-steps\n28\t  \"P6 steps that have landed: S1 (the linked profile, module emitter,\n29\t   publication), S2 (include/require, the two missing stages, the computed\n30\t   arm), S3 (the dynamic-scope profile), S4 (namespaces, `use`, the\n31\t   constants read path) and S5 (constant declarations, magic constants,\n32\t   the autoload runtime). `:p6-s2-r8` (per-unit strict_types) is not here.\"\n33\t  #{:p6-s0 :p6-s1 :p6-s2 :p6-s3 :p6-s4 :p6-s5})\n34\t\n35\t\n36\t(def include-path\n37\t  \"The `include_path` the missing-include texts print: php:8.3-cli's\n38\t   default, PENDING the shiva pin (plan S0 item 2).\"\n39\t  \".:/usr/local/lib/php\")\n40\t\n41\t\n42\t(defn- fx\n43\t  [id group requires units main-source out & {:as more}]\n44\t  (merge (cond-> {:id id,\n45\t                  :group group,\n46\t                  :rows [],\n47\t                  :level :program,\n48\t                  :requires requires,\n49\t                  :source main-source,\n50\t                  :oracle :pending}\n51\t           (seq units) (assoc :units (assoc units \"main.php\" main-source))\n52\t           out (assoc :out out))\n53\t         more))\n54\t\n55\t\n56\t(defn- missing-warnings\n57\t  \"The two warnings of a missing `include`/`include_once` of `path`.\"\n58\t  [kind path]\n59\t  [[2 (str kind \"(\" path \"): Failed to open stream: No such file or directory\")]\n60\t   [2 (str kind \"(): Failed opening '\" path \"' for inclusion (include_path='\" include-path \"')\")]])\n61\t\n62\t\n63\t(def inclusion-v1\n64\t  [(fx :inc-basic :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n65\t       \"<?php echo 'm'; include 'lib/a.php'; echo 'z';\" \"maz\")\n66\t   (fx :inc-return-value :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php return 5;\"}\n67\t       \"<?php $r = include 'a.php'; var_dump($r);\" \"int(5)\\n\")\n68\t   (fx :inc-default-one :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n69\t       \"<?php var_dump(include 'a.php');\" \"aint(1)\\n\")\n70\t   (fx :inc-once-repeat :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n71\t       \"<?php var_dump(include_once 'a.php'); var_dump(include_once 'a.php');\"\n72\t       \"aint(1)\\nbool(true)\\n\")\n73\t   (fx :inc-plain-then-once :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n74\t       \"<?php include 'a.php'; var_dump(inc