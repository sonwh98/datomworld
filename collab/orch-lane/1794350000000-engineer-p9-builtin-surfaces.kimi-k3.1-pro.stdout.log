{"role":"tool","tool_call_id":"tool_NA7OtrdpZYkcI8QY2APNm93F","content":"1\t(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\n2\t yang.php.antlr.prelude-module\n3\t  \"The include/require runtime of the PHP profile (docs/design/yang.php.md\n4\t   section 11, plan P6 R3/R4): the four kinds, the `_once` check, the two\n5\t   missing stages. Guest code like the rest of the prelude; the lowering\n6\t   emits only applications of these names.\n7\t\n8\t   Runtime state `php/init!` allocates for it (prelude.cljc owns the keys):\n9\t     php.rt/included   a cell, map of normalized path to true; written on\n10\t                       `:ok` delivery only, never on a refusal\n11\t     php.rt/unit       a cell, the executing unit's path or :php/null\n12\t     php.rt/path-map   a cell, map of normalized path to a delivery thunk\n13\t                       (the literal path map of the composition's `:paths`)\"\n14\t  (:require\n15\t    #?(:cljd [clojure.edn :as edn])\n16\t    [yang.php.antlr.quoted :refer [defquoted]]))\n17\t\n18\t\n19\t(def include-path-text\n20\t  \"The `include_path` the missing-include texts print: the oracle image's\n21\t   default. PENDING the S0 oracle pin (php:8.3-cli reports\n22\t   `.:/usr/local/lib/php`).\"\n23\t  \".:/usr/local/lib/php\")\n24\t\n25\t\n26\t(def include-kinds\n27\t  \"The four kinds the lowering passes to `php/include-run`.\"\n28\t  #{:include :include-once :require :require-once})\n29\t\n30\t\n31\t(defquoted ^:private module-forms\n32\t  \"The include definitions, `[store-key form]`.\"\n33\t  '[[php/include-kind-name\n34\t     (fn [kind]\n35\t       (if (= kind :include)\n36\t         \"include\"\n37\t         (if (= kind :include-once)\n38\t           \"include_once\"\n39\t           (if (= kind :require) \"require\" \"require_once\"))))]\n40\t    [php/include-require?\n41\t     (fn [kind] (if (= kind :require) true (= kind :require-once)))]\n42\t    [php/include-once?\n43\t     (fn [kind] (if (= kind :include-once) true (= kind :require-once)))]\n44\t    [php/warn-refusal\n45\t     ;; php/warn with the structured refusal on the record (plan R4)\n46\t     (fn [errno msg refusal]\n47\t       (let [rec (assoc (php/warn-record errno msg) :yang.php/refusal refusal)\n48\t             h (cell/get php.rt/error-handler)]\n49\t         (if (= h :php/null)\n50\t           (php/warn-sink rec)\n51\t           (if (= (php/invoke-handler h errno msg) false)\n52\t             (php/warn-sink rec)\n53\t             :php/null))))]\n54\t    [php/include-missing!\n55\t     ;; the refusal map follows the base kind; the texts carry the kind as\n56\t     ;; written; a refused path is never marked included\n57\t     (fn [path kind refusal]\n58\t       (let [nm (php/include-kind-name kind)]\n59\t         (do (php/warn-refusal\n60\t               2\n61\t               (data/str-concat\n62\t                 (data/str-concat (data/str-concat nm \"(\") path)\n63\t                 \"): Failed to open stream: No such file or directory\")\n64\t               refusal)\n65\t             (if (php/include-require? kind)\n66\t               (php/throw-error\n67\t                 \"Error\"\n68\t                 (data/str-concat\n69\t                   (data/str-concat\n70\t                     (data/str-concat \"Failed opening required '\" path)\n71\t                     \"' (include_path='\")\n72\t                   (data/str-concat php/include-path \"')\")))\n73\t               (do (php/warn-refusal\n74\t                     2\n75\t                     (data/str-concat\n76\t                       (data/str-concat\n77\t                         (data/str-concat\n78\t                           (data/str-concat nm \"(): Failed opening '\")\n79\t                           path)\n80\t                         \"' for inclusion (include_path='\")\n81\t                       (data/str-concat php/include-path \"')\"))\n82\t                     refusal)\n83\t                   false)))))]\n84\t    [php/include-body\n85\t     ;; marks the path before the body runs, names the unit while it runs,\n86\t     ;; answers the body's `return` value, else 1\n87\t     (fn [path delivered scope ctx]\n88\t       (let [prev (cell/get php.rt/unit)]\n89\t         (do (cell/set! php.rt/included (assoc (cell/get php.rt/included) path true))\n90\t             (cell/set! php.rt/unit path)\n91\t             (php/try-finally\n92\t               (fn []\n93\t                 (let [v ((get delivered :body) scope ctx)]\n94\t                   (if (= v :php/no-return) 1 v)))\n95\t               (fn [x] (cell/set! php.rt/unit prev))))))]\n96\t    [php/include-run\n97\t     ;; `thunk` answers {:status :ok :body b} or the structured refusal\n98\t     (fn [path thunk kind scope ctx]\n99\t       (if (if (php/include-once? kind)\n100\t             (not (nil? (get (cell/get php.rt/included) path)))\n101\t             false)\n102\t         true\n103\t         (let [r (thunk)]\n104\t           (if (= (get r :status) :ok)\n105\t             (php/include-body path r scope ctx)\n106\t             (php/include-missing! path kind r)))))]\n107\t    [php/normalize-path\n108\t     ;; the computed arm's lookup key: leading \"./\" segments dropped\n109\t     (fn [s]\n110\t       (if (if (>= (data/str-length s) 2) (= (data/substring s 0 2) \"./\") false)\n111\t         (php/normalize-path (data/substring s 2))\n112\t         s))]\n113\t    [php/include-computed\n114\t     ;; a computed path is a run-time lookup in the published path map; a\n115\t     ;; miss is the run-time missing-include behaviour for the kind\n116\t     (fn [pathv kind scope ctx]\n117\t       (let [path (php/normalize-path (php/to-string pathv))\n118\t             thunk (get (cell/get php.rt/path-map) path)]\n119\t         (php/include-run\n120\t           path\n121\t           (if (nil? thunk)\n122\t             (fn []\n123\t               (assoc (assoc {} :status :refused)\n124\t                      :reason :yang.php/computed-path-unmapped))\n125\t             thunk)\n126\t           kind\n127\t           scope\n128\t           ctx)))]\n129\t    ;; ---------------------------------------------------------------- scopes\n130\t    ;; An including scope is `:php/globals` (the entry unit's top level) or a\n131\t    ;; scope cell: name to the variable's own cell, in insertion order. A\n132\t    ;; dynamic-profile function adopts the cells its body already holds, so an\n133\t    ;; included body and the function see one variable.\n134\t    [php/scope-new\n135\t     (fn [] (cell/new (assoc (assoc {} :cells {}) :order [])))]\n136\t    [php/scope-adopt!\n137\t     (fn [d name c]\n138\t       (let [s (cell/get d)]\n139\t         (do (cell/set! d (assoc (assoc s :cells (assoc (get s :cells) name c))\n140\t                                 :order (php/vconj (get s :order) name)))\n141\t             c)))]\n142\t    [php/scope-cell\n143\t     (fn [d name]\n144\t       (let [c (get (get (cell/get d) :cells) name)]\n145\t         (if (nil? c) (php/scope-adopt! d name (cell/new :php/undef)) c)))]\n146\t    [php/scope-release-loop\n147\t     (fn [cells order i]\n148\t       (if (< i (data/count order))\n149\t         (do (php/unset-cv (get cells (get order i)))\n150\t             (php/scope-release-loop cells order (+ i 1)))\n151\t         (php/flush-pending!)))]\n152\t    [php/scope-release!\n153\t     (fn [d] (let [s (cell/get d)] (php/scope-release-loop (get s :cells) (get s :order) 0)))]\n154\t    [php/dict-get\n155\t     (fn [d name]\n156\t       (if (= d :php/globals) (php/global-get name) (php/local-get (php/scope-cell d name) name)))]\n157\t    [php/dict-peek\n158\t     (fn [d name]\n159\t       (if (= d :php/globals) (php/global-peek name) (php/local-peek (php/scope-cell d name))))]\n160\t    [php/dict-set!\n161\t     (fn [d name v]\n162\t       (if (= d :php/globals) (php/global-set! name v) (php/local-set! (php/scope-cell d name) v)))]\n163\t    [php/dict-put!\n164\t     (fn [d name v]\n165\t       (if (= 