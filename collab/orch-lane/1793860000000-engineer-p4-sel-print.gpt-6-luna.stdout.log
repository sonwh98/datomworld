named_params/duplicate_param.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6448:   :path \"Zend/tests/named_params/duplicate_param.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6455:  {:id \"Zend/tests/named_params/func_get_args.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6456:   :path \"Zend/tests/named_params/func_get_args.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6460:   \"Behavior of func_get_args() and friends with named parameters\",\ntest/yang/php/antlr/phpt_selection.edn:6463:  {:id \"Zend/tests/named_params/gh17216.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6464:   :path \"Zend/tests/named_params/gh17216.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6468:   :expect \"Cannot use positional argument after named argument\\nDone\",\ntest/yang/php/antlr/phpt_selection.edn:6470:  {:id \"Zend/tests/named_params/internal.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6471:   :path \"Zend/tests/named_params/internal.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6477:  {:id \"Zend/tests/named_params/internal_variadics.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6478:   :path \"Zend/tests/named_params/internal_variadics.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6482:   \"Named params on internal functions: Variadic functions that don't support extra named args\",\ntest/yang/php/antlr/phpt_selection.edn:6484:   \"array_merge() does not accept unknown named parameters\\narray_diff_key() does not accept unknown named parameters\",\ntest/yang/php/antlr/phpt_selection.edn:6486:  {:id \"Zend/tests/named_params/missing_param.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6487:   :path \"Zend/tests/named_params/missing_param.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6494:  {:id \"Zend/tests/named_params/references.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6495:   :path \"Zend/tests/named_params/references.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6500:  {:id \"Zend/tests/named_params/reserved.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6501:   :path \"Zend/tests/named_params/reserved.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6504:   :title \"Reserved keywords can be used with named parameters\",\ntest/yang/php/antlr/phpt_selection.edn:6506:  {:id \"Zend/tests/named_params/runtime_cache_init.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6507:   :path \"Zend/tests/named_params/runtime_cache_init.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6513:  {:id \"Zend/tests/named_params/undef_var.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6514:   :path \"Zend/tests/named_params/undef_var.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6517:   :title \"Passing undefined variable to named arg\",\ntest/yang/php/antlr/phpt_selection.edn:6520:  {:id \"Zend/tests/named_params/unknown_named_param.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6521:   :path \"Zend/tests/named_params/unknown_named_param.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6524:   :title \"Unknown named parameter\",\ntest/yang/php/antlr/phpt_selection.edn:6526:   \"Unknown named parameter $b\\nUnknown named parameter $b\\nUnknown named parameter $b\\nUnknown named parameter $unknown\",\ntest/yang/php/antlr/phpt_selection.edn:6528:  {:id \"Zend/tests/named_params/unpack.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6529:   :path \"Zend/tests/named_params/unpack.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6532:   :title \"Unpacking named parameters\",\ntest/yang/php/antlr/phpt_selection.edn:6534:   \"a = a, b = b, c = c\\na = a, b = b, c = c\\na = a, b = b, c = c\\nCannot use positional argument after named argument during unpacking\\nNamed parameter $a overwrites previous argument\\narray(1) {\\n  [\\\"b\\\"]=>\\n  int(1)\\n}\\narray(1) {\\n  [\\\"b\\\"]=>\\n  int(0)\\n}\\na = a, b = b, c = c\\na = a, b = b, c = c\\na = a, b = b, c = c\\nCannot use positional argument after named argument during unpacking\\nNamed parameter $a overwrites previous argument\\n\\nWarning: Cannot pass by-reference argument 2 of test2() by unpacking a Traversable, passing by-value instead in %s on line %d\\narray(1) {\\n  [\\\"b\\\"]=>\\n  int(0)\\n}\\narray(1) {\\n  [\\\"b\\\"]=>\\n  int(0)\\n}\",\ntest/yang/php/antlr/phpt_selection.edn:6536:  {:id \"Zend/tests/named_params/unpack_and_named_1.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6537:   :path \"Zend/tests/named_params/unpack_and_named_1.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6544:  {:id \"Zend/tests/named_params/variadic.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6545:   :path \"Zend/tests/named_params/variadic.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6547:   \"<?php\\n\\nfunction test($a, string ...$extra) {\\n    var_dump($a);\\n    var_dump($extra);\\n    // Extra named parameters do not contribute toward func_num_args() and func_get_args().\\n    var_dump(func_num_args());\\n    var_dump(func_get_args());\\n}\\n\\nfunction test2(&...$refs) {\\n    foreach ($refs as &$ref) $ref++;\\n}\\n\\ntest(b: 'b', a: 'a', c: 'c', extra: 'extra');\\necho \\\"\\\\n\\\";\\n\\ntest('a', 'b', 'c', d: 'd');\\necho \\\"\\\\n\\\";\\n\\n$x = 0;\\n$y = 0;\\ntest2(x: $x, y: $y);\\nvar_dump($x, $y);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6548:   :title \"Additional named params are collect into variadics\",\ntest/yang/php/antlr/phpt_selection.edn:6789:  {:id \"Zend/tests/readonly_props/by_ref_foreach.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6790:   :path \"Zend/tests/readonly_props/by_ref_foreach.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6792:   \"<?php\\n\\nclass Test {\\n    public readonly int $prop;\\n\\n    public function init() {\\n        $this->prop = 1;\\n    }\\n}\\n\\n$test = new Test;\\n\\n// Okay, as foreach skips over uninitialized properties.\\nforeach ($test as &$prop) {}\\n\\n$test->init();\\n\\ntry {\\n    foreach ($test as &$prop) {}\\n} catch (Error $e) {\\n    echo $e->getMessage(), \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6793:   :title \"By-ref foreach over readonly property\",\ntest/yang/php/antlr/phpt_selection.edn:7074:   \"<?php\\n\\nclass Test {\\n    public readonly int $prop;\\n\\n    public function init() {\\n        $this->prop = 1;\\n    }\\n\\n    public function r() {\\n        echo $this->prop;\\n    }\\n\\n    public function w() {\\n        $this->prop = 1;\\n        echo 'done';\\n    }\\n\\n    public function rw() {\\n        $this->prop += 1;\\n        echo 'done';\\n    }\\n\\n    public function im() {\\n        $this->prop[] = 1;\\n        echo 'done';\\n    }\\n\\n    public function is() {\\n        echo (int) isset($this->prop);\\n    }\\n\\n    public function us() {\\n        unset($this->prop);\\n        echo 'done';\\n    }\\n}\\n\\nfunction r($test) {\\n    echo $test->prop;\\n}\\n\\nfunction w($test) {\\n    $test->prop = 0;\\n    echo 'done';\\n}\\n\\nfunction rw($test) {\\n    $test->prop += 1;\\n    echo 'done';\\n}\\n\\nfunction im($test) {\\n    $test->prop[] = 1;\\n    echo 'done';\\n}\\n\\nfunction is($test) {\\n    echo (int) isset($test->prop);\\n}\\n\\nfunction us($test) {\\n    unset($test->prop);\\n    echo 'done';\\n}\\n\\nforeach ([true, false] as $init) {\\n    foreach ([true, false] as $scope) {\\n        foreach (['r', 'w', 'rw', 'im', 'is', 'us'] as $op) {\\n            $test = new Test();\\n            if ($init) {\\n                $test->init();\\n            }\\n\\n            echo 'Init: ' . ((int) $init) . ', scope: ' . ((int) $scope) . ', op: ' . $op . \\\": \\\";\\n            try {\\n                if ($scope) {\\n                    $test->{$op}();\\n                } else {\\n                    $op($test);\\n                }\\n            } catch (Error $e) {\\n                echo $e->getMessage();\\n            }\\n            echo \\\"\\\\n\\\";\\n        }\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7082:   \"<?php\\n\\nclass Inner {\\n    public int $prop = 1;\\n    public array $array = [];\\n}\\n\\nclass Test {\\n    public readonly Inner $prop;\\n\\n    public function init() {\\n        $this->prop = new Inner();\\n    }\\n}\\n\\nfunction r($test) {\\n    echo $test->prop->prop;\\n}\\n\\nfunction w($test) {\\n    $test->prop->prop = 0;\\n    echo 'done';\\n}\\n\\nfunction rw($test) {\\n    $test->prop->prop += 1;\\n    echo 'done';\\n}\\n\\nfunction im($test) {\\n    $test->prop->array[] = 1;\\n    echo 'done';\\n}\\n\\nfunction is($test) {\\n    echo (int) isset($test->prop->prop);\\n}\\n\\nfunction us($test) {\\n    unset($test->prop->prop);\\n    echo 'done';\\n}\\n\\nforeach ([true, false] as $init) {\\n    foreach (['r', 'w', 'rw', 'im', 'is', 'us'] as $op) {\\n        $test = new Test();\\n        if ($init) {\\n            $test->init();\\n        }\\n\\n        echo 'Init: ' . ((int) $init) . ', op: ' . $op . \\\": \\\";\\n        try {\\n            $op($test);\\n        } catch (Error $e) {\\n            echo $e->getMessage();\\n        }\\n        echo \\\"\\\\n\\\";\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7125:   \"<?php\\n\\nfunction ops() {\\n    throw new Exception();\\n}\\n\\n$a = [new stdClass, new stdClass];\\nforeach ([$a, [new stdClass]] as $b) {\\n    switch ($b[0]) {\\n        case false:\\n        break;\\n        default:\\n            try {\\n                $x = 2;\\n                $y = new stdClass;\\n                while ($x-- && new stdClass) {\\n                    $r = [$x] + ($y ? ((array) $x) + [2] : ops());\\n                    $y = (array) $y;\\n                }\\n            } catch (Exception $e) {\\n            }\\n    }\\n}\\n\\nforeach ([$a, [new stdClass]] as $b) {\\n    try {\\n        switch ($b[0]) {\\n            case false:\\n            break;\\n            default:\\n                $x = 2;\\n                $y = new stdClass;\\n                while ($x-- && new stdClass) {\\n                    $r = [$x] + ($y ? ((array) $x) + [2] : ops());\\n                    $y = (array) $y;\\n                }\\n        }\\n    } catch (Exception $e) {\\n    }\\n}\\n\\n?>\\n==DONE==\",\ntest/yang/php/antlr/phpt_selection.edn:7126:   :title \"Temporary leak with foreach\",\ntest/yang/php/antlr/phpt_selection.edn:7140:   \"<?php\\nclass saboteurTestController {\\n    public function isConsistent() { throw new \\\\Exception(); }\\n}\\n\\n$controllers = array(new saboteurTestController(),new saboteurTestController());\\nforeach ($controllers as $controller) {\\n    try {\\n        if ($controller->isConsistent()) {\\n            return $controller;\\n        }\\n    } catch (\\\\Exception $e) {\\n        echo \\\"Exception\\\\n\\\";\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7141:   :title \"Exception inside a foreach loop with return\",\ntest/yang/php/antlr/phpt_selection.edn:7154:   \"<?php\\nclass bar {\\n        public $foo = 1;\\n        public $bar = 1;\\n\\n        function __destruct() {\\n                throw $this->foo;\\n        }\\n}\\nforeach (new bar as &$foo) {\\n        try {\\n                $foo = new Exception;\\n                return; // frees the loop variable\\n        } catch (Exception $e) {\\n                echo \\\"exception\\\\n\\\";\\n        }\\n}\\necho \\\"end\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7208:   \"<?php\\nclass bar{\\n    public $y;\\n    function __destruct() {\\n        y;\\n    }\\n}\\nforeach(new bar as $y) {\\n    try {\\n        return new Exception;\\n    } catch(y) {\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7304:   \"<?php\\nclass Foo {\\n    public int $bar = 1;\\n}\\n\\n$foo = new Foo();\\nforeach ($foo as &$prop) {\\n    $prop++;\\n}\\nvar_dump($foo);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7305:   :title \"Test typed properties allow fetch reference for foreach\",\ntest/yang/php/antlr/phpt_selection.edn:7438:   \"<?php\\n$foo = new class {\\n    public int $bar = 10, $qux;\\n};\\n\\nforeach ($foo as $key => $bar) {\\n    var_dump($key, $bar);\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7440:   \"Test uninitialized typed properties normal foreach must not be yielded\",\ntest/yang/php/antlr/phpt_selection.edn:7462:   \"<?php\\n\\nclass A {\\n        public int $foo;\\n}\\n\\nclass B {\\n        public A $foo;\\n}\\n\\n$objs = [new A, new A];\\n$v = 1;\\n\\nforeach ($objs as $obj) {\\n        $obj->foo = $v;\\n        $v = new A;\\n        $obj = new B;\\n        $obj->foo = $v;\\n}\\n\\nvar_dump($objs);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7494:   \"<?php\\nclass Foo {\\n    public int $bar = 0;\\n    public float $baz = 0.5;\\n    private float $privateProp = 0.5;\\n\\n    public function test() {\\n        foreach ($this as $k => &$val) {\\n            if ($k == 'privateProp') {\\n                var_dump($val);\\n                $val = 20;\\n                var_dump($val);\\n                try {\\n                    $val = [];\\n                } catch (Error $e) {\\n                    echo $e->getMessage(), \\\"\\\\n\\\";\\n                }\\n            }\\n        }\\n    }\\n}\\n\\n$foo = new Foo;\\nforeach ($foo as $k => &$val) {\\n    var_dump($val);\\n\\n    $val = 20;\\n    var_dump($foo->$k);\\n\\n    try {\\n        $val = [];\\n        var_dump($foo->$k);\\n    } catch (Error $e) {\\n        echo $e->getMessage(), \\\"\\\\n\\\";\\n    }\\n}\\n$foo->test();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7495:   :title \"foreach() must return properly typed references\",\ntest/yang/php/antlr/phpt_selection.edn:7791:   \"<?php\\n\\nclass Test {\\n    public array $ary = [];\\n}\\n\\n$test = new Test;\\nforeach ($test->ary as &$value) {}\\nvar_dump($test);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7885:   \"<?php\\nclass A implements IteratorAggregate {\\n    function __construct(\\n        public string $foo = 'bar'\\n    ) {}\\n\\n    function getIterator(): Traversable {\\n        return new ArrayIterator($this);\\n    }\\n}\\n\\n$obj = new A;\\nforeach ($obj as $k => &$v) {\\n\\t$v = 42;\\n}\\n\\nvar_dump($obj);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7892:   \"<?php\\nclass A implements IteratorAggregate {\\n    function __construct(\\n        public string $foo = 'bar'\\n    ) {}\\n\\n    function getIterator(): Traversable {\\n        return new ArrayIterator($this);\\n    }\\n}\\n\\n$obj = new A;\\nforeach ($obj as $k => &$v) {\\n    try {\\n        $v = [];\\n    } catch (Throwable $e) {\\n        echo $e->getMessage(), \\\"\\\\n\\\";\\n    }\\n}\\nforeach ($obj as $k => &$v) {\\n    try {\\n        $v = [];\\n    } catch (Throwable $e) {\\n        echo $e->getMessage(), \\\"\\\\n\\\";\\n    }\\n}\\n\\nvar_dump($obj);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:7900:   \"<?php\\nclass A implements IteratorAggregate {\\n    function __construct(\\n        public readonly string $foo = 'bar'\\n    ) {}\\n\\n    function getIterator(): Traversable {\\n        return new ArrayIterator($this);\\n    }\\n}\\n\\n$obj = new A;\\n\\ntry {\\n    foreach ($obj as $k => &$v) {}\\n} catch (Throwable $e) {\\n    echo $e->getMessage(), \\\"\\\\n\\\";\\n}\\n\\nvar_dump($obj);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8042:   \"<?php\\n/*\\n * Pass arrays of different data types as $array_arg to current() to test behaviour\\n */\\n\\necho \\\"*** Testing current() : usage variations ***\\\\n\\\";\\n\\n//get an unset variable\\n$unset_var = 10;\\nunset ($unset_var);\\n\\n// get a class\\nclass classA\\n{\\n  public function __toString() {\\n    return \\\"Class A object\\\";\\n  }\\n}\\n\\n// heredoc string\\n$heredoc = <<<EOT\\nhello world\\nEOT;\\n\\n// get a resource variable\\n$fp = fopen(__FILE__, \\\"r\\\");\\n\\n// arrays of different data types to be passed to $array_arg argument\\n$inputs = array(\\n\\n       // int data\\n/*1*/  'int' => array(\\n       0,\\n       1,\\n       12345,\\n       -2345,\\n       ),\\n\\n       // float data\\n/*2*/  'float' => array(\\n       10.5,\\n       -10.5,\\n       12.3456789000e10,\\n       12.3456789000E-10,\\n       .5,\\n       ),\\n\\n       // null data\\n/*3*/ 'null' => array(\\n       NULL,\\n       null,\\n       ),\\n\\n       // boolean data\\n/*4*/ 'bool' => array(\\n       true,\\n       false,\\n       TRUE,\\n       FALSE,\\n       ),\\n\\n       // empty data\\n/*5*/ 'empty string' => array(\\n       \\\"\\\",\\n       '',\\n       ),\\n\\n/*6*/ 'empty array' => array(\\n       ),\\n\\n       // string data\\n/*7*/ 'string' => array(\\n       \\\"string\\\",\\n       'string',\\n       $heredoc,\\n       ),\\n\\n       // object data\\n/*8*/ 'object' => array(\\n       new classA(),\\n       ),\\n\\n       // undefined data\\n/*9*/ 'undefined' => array(\\n       @$undefined_var,\\n       ),\\n\\n       // unset data\\n/*10*/ 'unset' => array(\\n       @$unset_var,\\n       ),\\n\\n       // resource variable\\n/*11*/ 'resource' => array(\\n       $fp\\n       ),\\n);\\n\\n// loop through each element of $inputs to check the behavior of current()\\n$iterator = 1;\\nforeach($inputs as $key => $input) {\\n  echo \\\"\\\\n-- Iteration $iterator : $key data --\\\\n\\\";\\n  var_dump( current($input) );\\n  $iterator++;\\n};\\n\\nfclose($fp);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8328:  {:id \"tests/lang/foreachLoop.001.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8329:   :path \"tests/lang/foreachLoop.001.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8331:   \"<?php\\n\\n$a = array(\\\"a\\\",\\\"b\\\",\\\"c\\\");\\n\\nforeach ($a as $v) {\\n    var_dump($v);\\n}\\nforeach ($a as $k => $v) {\\n    var_dump($k, $v);\\n}\\n//check key and value after the loop.\\nvar_dump($k, $v);\\n\\necho \\\"\\\\n\\\";\\n//Dynamic array\\nforeach (array(\\\"d\\\",\\\"e\\\",\\\"f\\\") as $v) {\\n    var_dump($v);\\n}\\nforeach (array(\\\"d\\\",\\\"e\\\",\\\"f\\\") as $k => $v) {\\n    var_dump($k, $v);\\n}\\n//check key and value after the loop.\\nvar_dump($k, $v);\\n\\necho \\\"\\\\n\\\";\\n//Ensure counter is advanced during loop\\n$a=array(\\\"a\\\",\\\"b\\\",\\\"c\\\");\\nforeach ($a as $v);\\nvar_dump(current($a));\\n$a=array(\\\"a\\\",\\\"b\\\",\\\"c\\\");\\nforeach ($a as &$v);\\nvar_dump(current($a));\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8336:  {:id \"tests/lang/foreachLoop.002.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8337:   :path \"tests/lang/foreachLoop.002.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8339:   \"<?php\\n\\necho \\\"\\\\nDirectly changing array values.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\nforeach ($a as $k=>$v) {\\n    $a[$k]=\\\"changed.$k\\\";\\n    var_dump($v);\\n}\\nvar_dump($a);\\n\\necho \\\"\\\\nModifying the foreach \\\\$value.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\nforeach ($a as $k=>$v) {\\n    $v=\\\"changed.$k\\\";\\n}\\nvar_dump($a);\\n\\n\\necho \\\"\\\\nModifying the foreach &\\\\$value.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\nforeach ($a as $k=>&$v) {\\n    $v=\\\"changed.$k\\\";\\n}\\nvar_dump($a);\\n\\necho \\\"\\\\nPushing elements onto an unreferenced array.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\n$counter=0;\\nforeach ($a as $v) {\\n    array_push($a, \\\"new.$counter\\\");\\n\\n    //avoid infinite loop if test is failing\\n    if ($counter++>10) {\\n        echo \\\"Loop detected\\\\n\\\";\\n        break;\\n    }\\n}\\nvar_dump($a);\\n\\necho \\\"\\\\nPushing elements onto an unreferenced array, using &\\\\$value.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\n$counter=0;\\nforeach ($a as &$v) {\\n    array_push($a, \\\"new.$counter\\\");\\n\\n    //avoid infinite loop if test is failing\\n    if ($counter++>10) {\\n        echo \\\"Loop detected\\\\n\\\";\\n        break;\\n    }\\n}\\nvar_dump($a);\\n\\necho \\\"\\\\nPopping elements off an unreferenced array.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\nforeach ($a as $v) {\\n    array_pop($a);\\n    var_dump($v);\\n}\\nvar_dump($a);\\n\\necho \\\"\\\\nPopping elements off an unreferenced array, using &\\\\$value.\\\\n\\\";\\n$a = array(\\\"original.1\\\",\\\"original.2\\\",\\\"original.3\\\");\\nforeach ($a as &$v) {\\n    array_pop($a);\\n    var_dump($v);\\n}\\nvar_dump($a);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8342:   \"Directly changing array values.\\nstring(10) \\\"original.1\\\"\\nstring(10) \\\"original.2\\\"\\nstring(10) \\\"original.3\\\"\\narray(3) {\\n  [0]=>\\n  string(9) \\\"changed.0\\\"\\n  [1]=>\\n  string(9) \\\"changed.1\\\"\\n  [2]=>\\n  string(9) \\\"changed.2\\\"\\n}\\n\\nModifying the foreach $value.\\narray(3) {\\n  [0]=>\\n  string(10) \\\"original.1\\\"\\n  [1]=>\\n  string(10) \\\"original.2\\\"\\n  [2]=>\\n  string(10) \\\"original.3\\\"\\n}\\n\\nModifying the foreach &$value.\\narray(3) {\\n  [0]=>\\n  string(9) \\\"changed.0\\\"\\n  [1]=>\\n  string(9) \\\"changed.1\\\"\\n  [2]=>\\n  &string(9) \\\"changed.2\\\"\\n}\\n\\nPushing elements onto an unreferenced array.\\narray(6) {\\n  [0]=>\\n  string(10) \\\"original.1\\\"\\n  [1]=>\\n  string(10) \\\"original.2\\\"\\n  [2]=>\\n  string(10) \\\"original.3\\\"\\n  [3]=>\\n  string(5) \\\"new.0\\\"\\n  [4]=>\\n  string(5) \\\"new.1\\\"\\n  [5]=>\\n  string(5) \\\"new.2\\\"\\n}\\n\\nPushing elements onto an unreferenced array, using &$value.\\nLoop detected\\narray(15) {\\n  [0]=>\\n  string(10) \\\"original.1\\\"\\n  [1]=>\\n  string(10) \\\"original.2\\\"\\n  [2]=>\\n  string(10) \\\"original.3\\\"\\n  [3]=>\\n  string(5) \\\"new.0\\\"\\n  [4]=>\\n  string(5) \\\"new.1\\\"\\n  [5]=>\\n  string(5) \\\"new.2\\\"\\n  [6]=>\\n  string(5) \\\"new.3\\\"\\n  [7]=>\\n  string(5) \\\"new.4\\\"\\n  [8]=>\\n  string(5) \\\"new.5\\\"\\n  [9]=>\\n  string(5) \\\"new.6\\\"\\n  [10]=>\\n  string(5) \\\"new.7\\\"\\n  [11]=>\\n  &string(5) \\\"new.8\\\"\\n  [12]=>\\n  string(5) \\\"new.9\\\"\\n  [13]=>\\n  string(6) \\\"new.10\\\"\\n  [14]=>\\n  string(6) \\\"new.11\\\"\\n}\\n\\nPopping elements off an unreferenced array.\\nstring(10) \\\"original.1\\\"\\nstring(10) \\\"original.2\\\"\\nstring(10) \\\"original.3\\\"\\narray(0) {\\n}\\n\\nPopping elements off an unreferenced array, using &$value.\\nstring(10) \\\"original.1\\\"\\nstring(10) \\\"original.2\\\"\\narray(1) {\\n  [0]=>\\n  string(10) \\\"original.1\\\"\\n}\",\ntest/yang/php/antlr/phpt_selection.edn:8344:  {:id \"tests/lang/foreachLoop.003.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8345:   :path \"tests/lang/foreachLoop.003.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8347:   \"<?php\\necho \\\"\\\\nNot an array.\\\\n\\\";\\n$a = TRUE;\\nforeach ($a as $v) {\\n    var_dump($v);\\n}\\n\\n$a = null;\\nforeach ($a as $v) {\\n    var_dump($v);\\n}\\n\\n$a = 1;\\nforeach ($a as $v) {\\n    var_dump($v);\\n}\\n\\n$a = 1.5;\\nforeach ($a as $v) {\\n    var_dump($v);\\n}\\n\\n$a = \\\"hello\\\";\\nforeach ($a as $v) {\\n    var_dump($v);\\n}\\n\\necho \\\"done.\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8350:   \"Not an array.\\n\\nWarning: foreach() argument must be of type array|object, true given in %s on line %d\\n\\nWarning: foreach() argument must be of type array|object, null given in %s on line 9\\n\\nWarning: foreach() argument must be of type array|object, int given in %s on line 14\\n\\nWarning: foreach() argument must be of type array|object, float given in %s on line 19\\n\\nWarning: foreach() argument must be of type array|object, string given in %s on line 24\\ndone.\"}\ntest/yang/php/antlr/phpt_selection.edn:8351:  {:id \"tests/lang/foreachLoop.004.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8352:   :path \"tests/lang/foreachLoop.004.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8354:   \"<?php\\n\\n$a=array(\\\"a\\\", \\\"b\\\", \\\"c\\\");\\n$v=array();\\nforeach($a as $v[0]) {\\n    var_dump($v);\\n}\\nvar_dump($a);\\nvar_dump($v);\\n\\necho \\\"\\\\n\\\";\\n$a=array(\\\"a\\\", \\\"b\\\", \\\"c\\\");\\n$v=array();\\nforeach($a as $k=>$v[0]) {\\n    var_dump($k, $v);\\n}\\nvar_dump($a);\\nvar_dump($k, $v);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8358:  {:id \"tests/lang/foreachLoop.005.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8359:   :path \"tests/lang/foreachLoop.005.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8361:   \"<?php\\n$a = array(\\\"original.0\\\",\\\"original.1\\\",\\\"original.2\\\");\\nforeach ($a as $k=>&$v){\\n  $a[$k] = \\\"changed.$k\\\";\\n  echo \\\"After changing \\\\$a directly, \\\\$v@$k is: $v\\\\n\\\";\\n}\\n//--- Expected output:\\n//After changing $a directly, $v@0 is: changed.0\\n//After changing $a directly, $v@1 is: changed.1\\n//After changing $a directly, $v@2 is: changed.2\\n//--- Actual output from php.net before 5.2.2:\\n//After changing $a directly, $v@0 is: changed.0\\n//After changing $a directly, $v@1 is: original.1\\n//After changing $a directly, $v@2 is: original.2\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8366:  {:id \"tests/lang/foreachLoop.006.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8367:   :path \"tests/lang/foreachLoop.006.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8369:   \"<?php\\n$a = array(\\\"a\\\",\\\"b\\\",\\\"c\\\");\\nforeach ($a as &$k=>$v) {\\n  var_dump($v);\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8373:  {:id \"tests/lang/foreachLoop.009.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8374:   :path \"tests/lang/foreachLoop.009.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8376:   \"<?php\\n// From php.net/foreach:\\n// \\\"Unless the array is referenced, foreach operates on a copy of the specified array.\\\"\\n\\necho \\\"\\\\nRemove elements from a referenced array during loop\\\\n\\\";\\n$refedArray=array(\\\"original.0\\\", \\\"original.1\\\", \\\"original.2\\\");\\n$ref=&$refedArray;\\nforeach ($refedArray as $k=>$v1) {\\n    array_pop($refedArray);\\n    echo \\\"key: $k; value: $v1\\\\n\\\";\\n}\\n\\necho \\\"\\\\nRemove elements from a referenced array during loop, using &\\\\$value\\\\n\\\";\\n$refedArray=array(\\\"original.0\\\", \\\"original.1\\\", \\\"original.2\\\");\\n$ref=&$refedArray;\\nforeach ($refedArray as $k=>&$v2) {\\n    array_pop($refedArray);\\n    echo \\\"key: $k; value: $v2\\\\n\\\";\\n}\\n\\necho \\\"\\\\nAdd elements to a referenced array during loop\\\\n\\\";\\n$refedArray=array(\\\"original.0\\\", \\\"original.1\\\", \\\"original.2\\\");\\n$ref=&$refedArray;\\n$count=0;\\nforeach ($refedArray as $k=>$v3) {\\n    array_push($refedArray, \\\"new.$k\\\");\\n    echo \\\"key: $k; value: $v3\\\\n\\\";\\n\\n    if ($count++>5) {\\n        echo \\\"Loop detected, as expected.\\\\n\\\";\\n        break;\\n    }\\n}\\n\\necho \\\"\\\\nAdd elements to a referenced array during loop, using &\\\\$value\\\\n\\\";\\n$refedArray=array(\\\"original.0\\\", \\\"original.1\\\", \\\"original.2\\\");\\n$ref=&$refedArray;\\n$count=0;\\nforeach ($refedArray as $k=>&$v4) {\\n    array_push($refedArray, \\\"new.$k\\\");\\n    echo \\\"key: $k; value: $v4\\\\n\\\";\\n\\n    if ($count++>5) {\\n        echo \\\"Loop detected, as expected.\\\\n\\\";\\n        break;\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8378:   \"Foreach loop tests - foreach operates on the original array if the array is referenced outside the loop.\",\ntest/yang/php/antlr/phpt_selection.edn:8382:  {:id \"tests/lang/foreachLoop.010.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8383:   :path \"tests/lang/foreachLoop.010.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8385:   \"<?php\\n\\n$a = array(1,2,3);\\n$container = array(&$a);\\n\\n// From php.net:\\n//   \\\"Unless the array is referenced, foreach operates on a copy of\\n//    the specified array and not the array itself.\\\"\\n// At this point, the array $a is referenced.\\n\\n// The following line ensures $a is no longer references as a consequence\\n// of running the 'destructor' on $container.\\n$container = null;\\n\\n// At this point the array $a is no longer referenced, so foreach should operate on a copy of the array.\\n// However, P8 does not invoke 'destructors' when refcount is decremented to 0.\\n// Consequently, $a thinks it is still referenced, and foreach will operate on the array itself.\\n// This provokes a difference in behaviour when changing the number of elements in the array while\\n// iterating over it.\\n\\n$i=0;\\nforeach ($a as $v) {\\n    array_push($a, 'new');\\n    var_dump($v);\\n\\n    if (++$i>10) {\\n        echo \\\"Infinite loop detected\\\\n\\\";\\n        break;\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8387:   \"This test illustrates the impact of invoking destructors when refcount is decremented to 0 on foreach.\\nIt will pass only if the 'contentious code' in PHPValue.decReferences() is enabled.\",\ntest/yang/php/antlr/phpt_selection.edn:8390:  {:id \"tests/lang/foreachLoop.011.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8391:   :path \"tests/lang/foreachLoop.011.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8393:   \"<?php\\necho \\\"\\\\nChange from array to non iterable:\\\\n\\\";\\n$a = array(1,2,3);\\n$b=&$a;\\nforeach ($a as $v) {\\n    var_dump($v);\\n    $b=1;\\n}\\n\\necho \\\"\\\\nChange from object to non iterable:\\\\n\\\";\\n$a = new stdClass;\\n$a->a=1;\\n$a->b=2;\\n$b=&$a;\\nforeach ($a as $v) {\\n    var_dump($v);\\n    $b='x';\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8399:  {:id \"tests/lang/foreachLoop.017.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8400:   :path \"tests/lang/foreachLoop.017.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:8402:   \"<?php\\n$a = array ( \\\"\\\\x90\\\" => 10 );\\nforeach ($a as $val=>$key) echo $key;\\necho \\\"\\\\nDone\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8403:   :title \"Ensure foreach works with arrays with Binary keys.\",\n","exit_code":0,"status":"completed"}}
