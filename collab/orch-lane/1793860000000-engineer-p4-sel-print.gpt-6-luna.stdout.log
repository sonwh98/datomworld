s thrown in getIterator() within foreach)\",\ntest/yang/php/antlr/phpt_selection.edn:449:   \"<?php\\nclass A {\\n    function __construct() {\\n        debug_print_backtrace();\\n        $bt = debug_backtrace();\\n        foreach ($bt as $t) {\\n            print $t['class'].$t['type'].$t['function'].\\\"\\\\n\\\";\\n        }\\n    }\\n\\n    function foo() {\\n        debug_print_backtrace();\\n        $bt = debug_backtrace();\\n        foreach ($bt as $t) {\\n                        print $t['class'].$t['type'].$t['function'].\\\"\\\\n\\\";\\n        }\\n    }\\n\\n    static function bar() {\\n        debug_print_backtrace();\\n        $bt = debug_backtrace();\\n        foreach ($bt as $t) {\\n            print $t['class'].$t['type'].$t['function'].\\\"\\\\n\\\";\\n        }\\n    }\\n}\\n\\nclass B extends A {\\n    function __construct() {\\n        parent::__construct();\\n    }\\n\\n    function foo() {\\n        parent::foo();\\n    }\\n\\n    static function bar() {\\n        parent::bar();\\n    }\\n}\\n\\n$b = new B();\\n$b->foo();\\nB::bar();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:506:   \"<?php\\n$a = array(\\n    \\\"$     \\\\{    \\\",\\n    \\\"      \\\\{   $\\\",\\n    \\\"      \\\\{$   \\\",\\n    \\\"      $\\\\{   \\\",\\n    \\\"      \\\\$\\\\{  \\\",\\n    \\\"      \\\\{\\\\$  \\\",\\n    \\\"\\\\$    \\\\{    \\\",\\n    \\\"      \\\\{  \\\\$\\\",\\n    \\\"%     \\\\{    \\\");\\n\\nforeach ($a as $v) {\\n    echo(\\\"'$v'\\\\n\\\");\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:624:   \"<?php\\nclass collection implements Iterator {\\n\\n  private $_elements = array();\\n\\n  public function __construct() {\\n  }\\n\\n  public function rewind(): void {\\n    reset($this->_elements);\\n  }\\n\\n  public function count(): int {\\n    return count($this->_elements);\\n  }\\n\\n  public function current(): mixed {\\n    $element = current($this->_elements);\\n    return $element;\\n  }\\n\\n  public function next(): void {\\n    $element = next($this->_elements);\\n    $element;\\n  }\\n\\n  public function key(): mixed {\\n    $this->_fillCollection();\\n    $element = key($this->_elements);\\n    return $element;\\n  }\\n\\n  public function valid(): bool {\\n    throw new Exception('shit happened');\\n\\n    return ($this->current() !== false);\\n  }\\n}\\n\\nclass class2 {\\n  public $dummy;\\n}\\n\\n$obj = new class2();\\n$col = new collection();\\n\\ntry {\\n    foreach($col as $co) {\\n    //irrelevant\\n    }\\n    echo 'shouldn`t get here';\\n    //$dummy = 'this will not crash';\\n    $obj->dummy = 'this will crash';\\n} catch (Exception $e) {\\n    echo \\\"ok\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:645:   \"<?php\\nclass Test implements Iterator {\\n\\n    public $arr = array();\\n\\n    public function rewind(): void    { reset($this->arr); }\\n    public function current(): mixed   { throw new Exception(); }\\n    public function key(): mixed       { return key($this->arr); }\\n    public function next(): void      { next($this->arr); }\\n    public function valid(): bool     { return (current($this->arr) !== false); }\\n}\\n\\n$t = new Test();\\n$t->arr =  array(1, 2, 3);\\n\\ntry {\\n    foreach ($t as $v) {\\n        echo \\\"$v\\\\n\\\";\\n    }\\n} catch (Exception $e) {\\n    ; // handle exception\\n}\\necho \\\"ok\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:653:   \"<?php\\nclass A\\n{\\n    private $c = \\\"A's c\\\";\\n}\\n\\nclass B extends A\\n{\\n    private $c = \\\"B's c\\\";\\n\\n    public function go()\\n    {\\n        foreach ($this as $key => $val)\\n        {\\n            echo \\\"$key => $val\\\\n\\\";\\n        }\\n    }\\n};\\n\\n$x = new B;\\n$x->go();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:655:   \"Bug #33171 (foreach enumerates private fields declared in base classes)\",\ntest/yang/php/antlr/phpt_selection.edn:771:   \"<?php\\n$data = file(__FILE__);\\ntry {\\n  foreach ($data as $line) {\\n    throw new Exception(\\\"error\\\");\\n  }\\n} catch (Exception $e) {\\n  echo \\\"ok\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:772:   :title \"Bug #34065 (throw in foreach causes memory leaks)\",\ntest/yang/php/antlr/phpt_selection.edn:801:   \"<?php\\n\\nclass C\\n{\\n    public $d;\\n}\\n\\n$c = new C();\\n\\n$arr = array (1 => 'a', 2 => 'b', 3 => 'c');\\n\\n// Works fine:\\nforeach($arr as $x => $c->d)\\n{\\n    echo \\\"{$x} => {$c->d}\\\\n\\\";\\n}\\n\\n// Crashes:\\nforeach($arr as $c->d => $x)\\n{\\n    echo \\\"{$c->d} => {$x}\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:802:   :title \"Bug #34310 (foreach($arr as $c->d => $x) crashes)\",\ntest/yang/php/antlr/phpt_selection.edn:815:   \"<?php\\nclass abc {\\n    private $arr;\\n\\n    function __set ($key, $value) {\\n    $this->arr[$key] = $value;\\n  }\\n\\n    function __get ($key) {\\n      return $this->arr[$key];\\n    }\\n}\\n$abc = new abc();\\nforeach (array (1,2,3) as $abc->k => $abc->v) {\\n    var_dump($abc->k,$abc->v);\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:816:   :title \"Bug #34467 (foreach + __get + __set incosistency)\",\ntest/yang/php/antlr/phpt_selection.edn:851:   \"<?php\\nclass pwa {\\n    public $var;\\n\\n    function __construct(){\\n        $this->var = array();\\n    }\\n\\n    function test (){\\n        $cont = array();\\n        $cont[\\\"mykey\\\"] = \\\"myvalue\\\";\\n\\n        foreach ($cont as $this->var['key'] => $this->var['value'])\\n        var_dump($this->var['value']);\\n    }\\n}\\n$myPwa = new Pwa();\\n$myPwa->test();\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:852:   :title \"Bug #34873 (Segmentation Fault on foreach in object)\",\ntest/yang/php/antlr/phpt_selection.edn:881:   \"<?php\\n$a=array(\\\"1\\\",\\\"2\\\");\\n$b=&$a;\\nforeach($a as $i){\\n    echo $i;\\n    foreach($a as $p);\\n}\\necho \\\"\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:883:   \"Bug #35106 (nested foreach fails when array variable has a reference)\",\ntest/yang/php/antlr/phpt_selection.edn:986:   \"<?php\\nfunction s() {\\n  static $storage = array(array('x', 'y'));\\n  return $storage[0];\\n}\\n\\nforeach (s() as $k => $function) {\\n  echo \\\"op1 $k\\\\n\\\";\\n  if ($k == 0) {\\n    foreach (s() as $k => $function) {\\n      echo \\\"op2 $k\\\\n\\\";\\n    }\\n  }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:987:   :title \"Bug #37046 (foreach breaks static scope)\",\ntest/yang/php/antlr/phpt_selection.edn:1050:   \"<?php\\n$a = array(\\n    'a' => array(\\n        'A', 'B', 'C', 'D',\\n    ),\\n    'b' => array(\\n        'AA', 'BB', 'CC', 'DD',\\n    ),\\n);\\n\\n// Set the pointer of $a to 'b' and the pointer of 'b' to 'CC'\\nreset($a);\\nnext($a);\\nnext($a['b']);\\nnext($a['b']);\\nnext($a['b']);\\n\\nvar_dump(key($a['b']));\\nforeach($a as $k => $d)\\n{\\n}\\n// Alternatively $c = $a; and foreachloop removal will cause identical results.\\nvar_dump(key($a['b']));\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1064:   \"<?php\\nclass foo {\\n    public function __get($member) {\\n        $f = array(\\\"foo\\\"=>\\\"bar\\\",\\\"bar\\\"=>\\\"foo\\\");\\n        return $f;\\n    }\\n}\\n\\n$f = new foo();\\nforeach($f->bar as $key => $value) {\\n    print \\\"$key => $value\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1150:   \"<?php\\nclass A {}\\nforeach(($a=(object)new A()) as $v);\\nvar_dump($a); // UNKNOWN:0\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1152:   \"Bug #39017 (foreach(($obj = new myClass) as $v); echo $obj; segfaults)\",\ntest/yang/php/antlr/phpt_selection.edn:1235:   \"<?php\\n$array = array(1 => 2, \\\"foo\\\" => \\\"bar\\\");\\n$obj = (object)$array;\\nforeach ($obj as $name => $value)  {\\n    echo \\\"$name -> $value\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1236:   :title \"Bug #39825 (foreach produces memory error)\",\ntest/yang/php/antlr/phpt_selection.edn:1242:   \"<?php\\n  class Foo {\\n    public function __get($name) {\\n      return array('Hello', 'World');\\n    }\\n  }\\n\\n  $obj=new Foo();\\n  foreach($obj->arr as $value)\\n    echo \\\"$value\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1243:   :title \"Bug #39990 (Cannot \\\"foreach\\\" over overloaded properties)\",\ntest/yang/php/antlr/phpt_selection.edn:1257:   \"<?php\\nfunction foo()\\n{\\n    global $arr;\\n\\n    $c = $arr[\\\"v\\\"];\\n    foreach ($c as $v) {}\\n}\\n\\n$arr[\\\"v\\\"] = array(\\\"a\\\");\\n\\nvar_dump(key($arr[\\\"v\\\"]));\\nfoo();\\nvar_dump(key($arr[\\\"v\\\"]));\\nforeach ($arr[\\\"v\\\"] as $k => $v) {\\n    var_dump($k);\\n}\\nvar_dump(key($arr[\\\"v\\\"]));\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1273:   \"<?php\\nfunction doForeach($array)\\n{\\n    foreach ($array as $k => $v) {\\n        // do stuff\\n    }\\n}\\n\\n$foo = array('foo', 'bar', 'baz');\\nvar_dump(key($foo));\\ndoForeach($foo);\\nvar_dump(key($foo));\\nforeach ($foo as $k => $v) {\\n    var_dump($k);\\n}\\nvar_dump(key($foo));\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1343:   \"<?php\\n\\n$a = array();\\n\\nforeach($a[] as $b) {\\n}\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1344:   :title \"Bug #41351 (Invalid opcode with foreach ($a[] as $b))\",\ntest/yang/php/antlr/phpt_selection.edn:1349:   \"<?php\\n\\n$a = array();\\n\\nforeach($a[]['test'] as $b) {\\n}\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1350:   :title \"Bug #41351 (Invalid opcode with foreach ($a[] as $b)) - 2\",\ntest/yang/php/antlr/phpt_selection.edn:1355:   \"<?php\\n\\n$a = array();\\n\\nforeach($a['test'][] as $b) {\\n}\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1356:   :title \"Bug #41351 (Invalid opcode with foreach ($a[] as $b)) - 3\",\ntest/yang/php/antlr/phpt_selection.edn:1422:   \"<?php\\nclass C {\\n  private $priv = \\\"ok\\\";\\n\\n  function doLoop() {\\n    echo $this->priv,\\\"\\\\n\\\";\\n    foreach ($this as $k=>$v) {\\n      echo \\\"$k: $v\\\\n\\\";\\n    }\\n  }\\n}\\n\\nclass D extends C {\\n}\\n\\n$myD = new D;\\n$myD->doLoop();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1582:   \"<?php\\n$xmlstr = <<<XML\\n<?xml version='1.0' standalone='yes'?>\\n<movies>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n</movies>\\nXML;\\n\\n$Array = array( );\\nfor( $XX = 0; $XX < 2000; ++$XX )\\n{\\n $Array[] = $xml = new SimpleXMLElement($xmlstr);\\n}\\n\\ngc_collect_cycles( );\\necho \\\"ok\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1606:   \"<?php\\nfunction foo() {\\n    $x = array(1,2,3);\\n    foreach ($x as $a) {\\n        while (1) {\\n            throw new Exception();\\n        }\\n        return;\\n    }\\n}\\ntry {\\n    foo();\\n} catch (Exception $ex) {\\n    echo \\\"ok\\\\n\\\";\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1659:   \"<?php\\nfunction something() {\\n        foreach(array(1, 2) as $value) {\\n                for($i = 0; $i < 1; $i++) {\\n                        continue 2;\\n                }\\n                return;\\n        }\\n}\\nsomething();\\necho \\\"ok\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1846:   \"<?php\\nclass A\\n{\\n    public $data = [];\\n    public function __destruct()\\n    {\\n        gc_collect_cycles();\\n    }\\n\\n    public function getB()\\n    {\\n        $this->data['foo'] = new B($this);\\n        $this->data['bar'] = new B($this);\\n        // Return either of the above\\n        return $this->data['foo'];\\n    }\\n}\\n\\nclass B\\n{\\n    public function __construct(public $A) {}\\n\\n    public function __destruct()\\n    {\\n    }\\n}\\n\\nfor ($i = 0; $i < 2; $i++)\\n{\\n    $Aobj = new A;\\n    $Bobj = $Aobj->getB();\\n    unset($Bobj);\\n    unset($Aobj);\\n}\\n\\necho \\\"DONE\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1848:   \"Bug #47343 (gc_collect_cycles causes a segfault when called within a destructor in one case)\",\ntest/yang/php/antlr/phpt_selection.edn:2045:   \"<?php\\nclass TestObject implements Iterator\\n{\\n    public $n = 0;\\n    function valid(): bool\\n    {\\n        return ($this->n < 3);\\n    }\\n    function current(): mixed {return $this->n;}\\n    function next(): void {$this->n++;}\\n    function key(): mixed { }\\n    function rewind(): void {$this->n = 0;}\\n}\\n\\n\\n$array_object = new TestObject();\\n\\nforeach ((true ? $array_object : $array_object) as $item) echo \\\"$item\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2047:   \"Bug #49269 (Ternary operator fails on Iterator object when used inside foreach declaration).\",\ntest/yang/php/antlr/phpt_selection.edn:2402:   :title \"Bug #54305 (Crash in gc_remove_zval_from_buffer)\",\ntest/yang/php/antlr/phpt_selection.edn:2488:   \"<?php\\n$tree = array(array(\\\"f\\\"));\\n$category =& $tree[0];\\n\\n$iterator = new RecursiveIteratorIterator(\\n    new RecursiveArrayIterator($tree),\\n    RecursiveIteratorIterator::SELF_FIRST\\n);\\nforeach($iterator as $file);\\necho \\\"ok\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2496:   \"<?php\\nclass Foo {\\n    public $x;\\n\\n    public function __construct() {\\n        $this->x = function() {};\\n    }\\n}\\n\\nclass Bar {\\n    public $x;\\n\\n    public function __construct() {\\n        $self = $this;\\n        $this->x = function() use ($self) {};\\n    }\\n}\\n\\ngc_collect_cycles();\\nnew Foo;\\nvar_dump(gc_collect_cycles());\\nnew Bar;\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2841:   \"<?php\\n/* the default gc root size is 10,000 */\\nfor ($i=0; $i<9998; $i++) {\\n    $array = array();\\n    $array[0] = &$array;\\n    unset($array);\\n}\\n\\n$matches = array(\\\"foo\\\" => \\\"bar\\\"); /* this bucket will trigger the segfault */\\n$dummy   = array(\\\"dummy\\\");        /* used to trigger gc_collect_cycles */\\n$dummy[1] = &$dummy;\\n\\n$matches[1] = &$matches;\\n$matches[2] = $dummy;\\n\\nstr_replace(\\\"foo\\\", \\\"bar\\\", \\\"foobar\\\", $matches);\\necho \\\"okey\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2842:   :title \"Bug #63055 (Segfault in zend_gc with SF2 testsuite)\",\ntest/yang/php/antlr/phpt_selection.edn:2885:   \"<?php\\nclass Test implements ArrayAccess {\\n    public function offsetExists($offset): bool {\\n        echo \\\"offsetExists given \\\";\\n        var_dump($offset);\\n        return true;\\n    }\\n    public function offsetUnset($offset): void {\\n        echo \\\"offsetUnset given \\\";\\n        var_dump($offset);\\n    }\\n    public function offsetSet($offset, $value): void {\\n        echo \\\"offsetSet given \\\";\\n        var_dump($offset);\\n    }\\n    public function offsetGet($offset): mixed {\\n        echo \\\"offsetGet given \\\";\\n        var_dump($offset);\\n        return null;\\n    }\\n}\\n\\n$test = new Test;\\n\\n/* These should all produce string(...) \\\"...\\\" output and not int(...) */\\nisset($test['0']);\\nisset($test['123']);\\nunset($test['0']);\\nunset($test['123']);\\n$test['0'] = true;\\n$test['123'] = true;\\n$foo = $test['0'];\\n$foo = $test['123'];\\n\\n/* These caused the same bug, but in opcache rather than the compiler */\\nisset($test[(string)'0']);\\nisset($test[(string)'123']);\\nunset($test[(string)'0']);\\nunset($test[(string)'123']);\\n$test[(string)'0'] = true;\\n$test[(string)'123'] = true;\\n$foo = $test[(string)'0'];\\n$foo = $test[(string)'123'];\\n\\n/**\\n * @see https://github.com/php/php-src/pull/2607#issuecomment-313781748\\n */\\nfunction test(): string {\\n    $array[\\\"10\\\"] = 42;\\n    foreach ($array as $key => $value) {\\n        return $key;\\n    }\\n}\\n\\nvar_dump(test());\\n\\n/**\\n * Make sure we don't break arrays.\\n */\\n$array = [];\\n\\n$key = '123';\\n\\n$array[$key] = 1;\\n$array['321'] = 2;\\n$array['abc'] = 3;\\n\\nvar_dump($array);\\n\\n/**\\n * Make sure that we haven't broken ArrayObject\\n */\\n$ao = new ArrayObject();\\n\\n$key = '123';\\n\\n$ao = [];\\n$ao[$key] = 1;\\n$ao['321'] = 2;\\n$ao['abc'] = 3;\\n\\nvar_dump($ao);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2921:   :title \"Bug #63635 (Segfault in gc_collect_cycles)\",\ntest/yang/php/antlr/phpt_selection.edn:2928:   \"<?php\\nclass C {\\n    public $ref;\\n    public $ary;\\n    public function __construct() {\\n        $this->ref = $this;\\n        $this->ary[] = 42;\\n    }\\n    public function __destruct() {\\n        global $ary;\\n        $ary[] = $this->ary[0];\\n    }\\n}\\n\\n$c = new C;\\nunset($c);\\ngc_collect_cycles();\\n\\nvar_dump($ary);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2961:   \"<?php\\n$token = array();\\n$conditions = array();\\nfor ($i = 0; $i <= 2; $i++) {\\n    $tokens = $conditions;\\n    $a[0] =& $a;\\n    $a = unserialize(serialize($GLOBALS));\\n    $a[0] =& $a;\\n    $a = unserialize(serialize($GLOBALS));\\n    $a[0] =& $a;\\n    foreach($a as $v) {\\n        if ($v == 1) {\\n            arsort($a);\\n        }\\n    }\\n}\\n?>\\nDONE\",\ntest/yang/php/antlr/phpt_selection.edn:3040:   \"<?php\\n\\nclass Foo {\\n    protected $unsetme = 1;\\n    protected $keepme = 2;\\n\\n    public function test() {\\n        $a = get_object_vars($this);\\n\\n        foreach ($a as $k => $v) {\\n            if ($k == 'unsetme') {\\n                echo \\\"Unsetting: $k\\\\n\\\";\\n                unset($a[$k]);\\n            } else if ($k == 'keepme') {\\n                echo \\\"Changing: $k\\\\n\\\";\\n                $a[$k] = 42;\\n                $a['keepme'] = 43;\\n            }\\n        }\\n\\n        var_dump($a, array_keys($a));\\n    }\\n}\\n\\n$f = new Foo;\\n$f->test();\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3106:   \"<?php\\n$bar = NULL;\\nclass bad\\n{\\n    private $_private = array();\\n\\n    public function __construct()\\n    {\\n        $this->_private[] = 'php';\\n    }\\n\\n    public function __destruct()\\n    {\\n        global $bar;\\n        $bar = $this;\\n    }\\n}\\n\\n$foo = new stdclass;\\n$foo->foo = $foo;\\n$foo->bad = new bad;\\n\\ngc_disable();\\n\\nunserialize(serialize($foo));\\ngc_collect_cycles();\\nvar_dump($bar);\\ngc_enable();\\n/*  will output:\\nobject(bad)#4 (1) {\\n  [\\\"_private\\\":\\\"bad\\\":private]=>\\n  &UNKNOWN:0\\n}\\n*/\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3108:   \"Bug #64896 (Segfault with gc_collect_cycles using unserialize on certain objects)\",\ntest/yang/php/antlr/phpt_selection.edn:3116:   :title \"Bug #64960 (Segfault in gc_zval_possible_root)\",\ntest/yang/php/antlr/phpt_selection.edn:3260:   \"<?php\\n\\n$array1 = [1, 2, 3];\\n$array2 = [1, 2, 3];\\n\\nforeach ($array1 as $x) {\\n    foreach ($array2 as $y) {\\n        echo \\\"$x.$y\\\\n\\\";\\n        continue 2;\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3262:   \"Bug #67111: Memory leak when using \\\"continue 2\\\" inside two foreach loops\",\ntest/yang/php/antlr/phpt_selection.edn:3277:   \"Bug #67314 (Segmentation fault in gc_remove_zval_from_buffer)\",\ntest/yang/php/antlr/phpt_selection.edn:3350:   \"<?php\\n$arr = array(\\n    'a' => array(\\n        'a' => 'apple',\\n        'b' => 'banana',\\n        'c' => 'cranberry',\\n        'd' => 'mango',\\n        'e' => 'pineapple'\\n    ),\\n    'b' => array(\\n        'a' => 'apple',\\n        'b' => 'banana',\\n        'c' => 'cranberry',\\n        'd' => 'mango',\\n        'e' => 'pineapple'\\n    ),\\n    'c' => 'cranberry',\\n    'd' => 'mango',\\n    'e' => 'pineapple'\\n);\\n\\nfunction test(&$child, $entry)\\n{\\n    $i = 1;\\n\\n    foreach ($child AS $key => $fruit)\\n    {\\n        if (!is_numeric($key))\\n        {\\n            $child[$i] = $fruit;\\n            unset($child[$key]);\\n            $i++;\\n        }\\n    }\\n}\\n\\n$i = 1;\\n\\nforeach ($arr AS $key => $fruit)\\n{\\n    $arr[$i] = $fruit;\\n\\n    if (is_array($fruit))\\n    {\\n        test($arr[$i], $fruit);\\n    }\\n\\n    unset($arr[$key]);\\n    $i++;\\n}\\n\\nvar_dump($arr);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3351:   :title \"Bug #68215 (Behavior of foreach has changed)\",\ntest/yang/php/antlr/phpt_selection.edn:3421:   \"Bug #69084: Unclear error message when not implementing a renamed abstract trait function\",\ntest/yang/php/antlr/phpt_selection.edn:3497:   \"<?php\\n$bar = NULL;\\n#[AllowDynamicProperties]\\nclass bad {\\n    public function __destruct() {\\n        global $bar;\\n        $bar = $this;\\n        $bar->y = new stdClass;\\n    }\\n}\\n\\n$foo = new stdClass;\\n$foo->foo = $foo;\\n$foo->bad = new bad;\\n$foo->bad->x = new stdClass;\\n\\nunset($foo);\\ngc_collect_cycles();\\nvar_dump($bar);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3506:   \"<?php\\n$bar = NULL;\\nclass bad\\n{\\n    public $_private = array();\\n\\n    public function __construct()\\n    {\\n        $this->_private[] = 'php';\\n    }\\n\\n    public function __destruct()\\n    {\\n        global $bar;\\n        $bar = $this;\\n    }\\n}\\n\\n$foo = new stdclass;\\n$foo->foo = $foo;\\n$foo->bad = new bad;\\n\\nunserialize(serialize($foo));\\n//unset($foo);\\n\\ngc_collect_cycles();\\nvar_dump($bar);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3524:   \"<?php\\nclass Node extends SplObjectStorage {\\n    public $prop;\\n}\\n\\n$node1 = new Node;\\n$node2 = new Node;\\n$node1->prop = $node2;\\n$node2->prop = $node1;\\nunset($node1);\\nunset($node2);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3606:   \"<?php\\n$arr = range(1, 2);\\nforeach($arr as &$item ) {\\n    var_dump($arr === array(1, 2));\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3922:   \"<?php\\nclass A {\\n    public $b;\\n}\\n\\nclass B {\\n    public $a;\\n}\\n\\nclass C {\\n    public function __destruct() {\\n        if (isset($GLOBALS[\\\"a\\\"])) {\\n            unset($GLOBALS[\\\"array\\\"]);\\n            unset($GLOBALS[\\\"a\\\"]); // this will be called in gc_colloct_roots and put $a into gc roots buf\\n        }\\n    }\\n}\\n\\n$a = new A;\\n$a->b = new B;\\n$a->b->a = $a;\\n\\n$i = 0;\\n\\n$c = new A;\\n$array = array($c); //This is used to leave a room for $GLOBALS[\\\"a\\\"]\\nunset($c);\\n\\nwhile ($i++ < 9998) {\\n    $t = [];\\n    $t[] = &$t;\\n    unset($t);\\n}\\n$t = [new C];\\n$t[] = &$t;\\nunset($t); // This is used to trigger C::__destruct while doing gc_colloct_roots\\n\\n$e = $a;\\nunset($a); // This one cannot be put into roots buf because it's full, thus gc_colloct_roots will be called,\\n           // but C::__destructor which is called in gc_colloct_roots will put $a into buf\\n           // which will make $a be put into gc roots buf twice\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3930:   \"<?php\\nclass A {\\n    public $b;\\n}\\n\\nclass B {\\n    public $a;\\n}\\n\\nclass C {\\n    public function __destruct() {\\n        if (isset($GLOBALS[\\\"a\\\"])) {\\n            unset($GLOBALS[\\\"array\\\"]);\\n            unset($GLOBALS[\\\"a\\\"]);\\n        }\\n    }\\n}\\n\\n$a = new A;\\n$a->b = new B;\\n$a->b->a = $a;\\n\\n$i = 0;\\n\\n$c = new A;\\n$array = array($c);\\nunset($c);\\n\\nwhile ($i++ < 9998) {\\n    $t = [];\\n    $t[] = &$t;\\n    unset($t);\\n}\\n$t = [new C];\\n$t[] = &$t;\\nunset($t);\\nunset($a);\\n\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3938:   \"<?php\\nclass A {\\n    public $b;\\n}\\n\\nclass B {\\n    public $a;\\n}\\n\\nclass C {\\n    public function __destruct() {\\n        if (isset($GLOBALS[\\\"a\\\"])) {\\n            unset($GLOBALS[\\\"a\\\"]);\\n        }\\n    }\\n}\\n\\n$a = new A;\\n$a->b = new B;\\n$a->b->a = $a;\\n\\n$i = 0;\\n\\nwhile ($i++ < 9999) {\\n    $t = [];\\n    $t[] = &$t;\\n    unset($t);\\n}\\n$t = [new C];\\n$t[] = &$t;\\nunset($t);\\n\\nunset($a);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4058:   \"<?php\\n\\n$array = [1, 2, 3];\\nforeach ($array as &$ref) {\\n    /* Free array, causing free of iterator */\\n    $array = [];\\n    /* Reuse the iterator.\\n     * However it will also be reused on next foreach iteration */\\n    $it = new ArrayIterator([1, 2, 3]);\\n    $it->rewind();\\n}\\nvar_dump($it->current());\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4073:   \"<?php\\n$one = 1;\\n$two = 2;\\n$arr = ['foo' => $one, 'bar' => $two];\\n$obj = (object) $arr;\\nforeach ($obj as $val) {\\n    var_dump($val);\\n    $obj->bar = 42;\\n}\\n\\n$arr = ['foo' => $one, 'bar' => $two];\\n$obj = (object) $arr;\\nnext($obj);\\nvar_dump(current($arr));\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4075:   \"Bug #71266 (Missing separation of properties HT in foreach etc)\",\ntest/yang/php/antlr/phpt_selection.edn:4130:   \"<?php\\n\\n$array = [1, 2, 3];\\nforeach ($array as &$v) {\\n    die(\\\"foo\\\\n\\\");\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4220:   \"Bug #71737: Memory leak in closure with parameter named $this\",\ntest/yang/php/antlr/phpt_selection.edn:4290:   \"Bug #71930 (_zval_dtor_func: Assertion `(arr)->gc.refcount <= 1' failed)\",\ntest/yang/php/antlr/phpt_selection.edn:4305:   \"<?php\\nclass PHPUnit_Framework_MockObject_Stub_ReturnCallback {\\n    protected $callback;\\n    public function __construct($callback) {\\n        $this->callback = $callback;\\n    }\\n    public function invoke($invocation) {\\n        return call_user_func_array($this->callback, $invocation->parameters);\\n    }\\n}\\n\\nclass PHPUnit_Framework_MockObject_InvocationMocker {\\n    protected $matchers = [];\\n    public function addMatcher( $matcher) {\\n        $this->matchers[] = $matcher;\\n    }\\n    public function invoke( $invocation) {\\n        foreach ($this->matchers as $match) {\\n            $match->invoked($invocation);\\n        }\\n    }\\n}\\n\\nclass PHPUnit_Framework_MockObject_Matcher {\\n    public $stub = null;\\n    public $methodNameMatcher;\\n    public function invoked($invocation) {\\n        return $this->stub->invoke($invocation);\\n    }\\n}\\n\\nclass MethodCallbackByReference {\\n    public function bar(&$a, &$b, $c) {\\n        Legacy::bar($a, $b, $c);\\n    }\\n    public function callback(&$a, &$b, $c) {\\n        $b = 1;\\n    }\\n}\\nclass PHPUnit_Framework_MockObject_Invocation_Static {\\n    public $parameters;\\n    public function __construct(array $parameters) {\\n        $this->parameters = $parameters;\\n    }\\n}\\n\\nclass Mock_MethodCallbackByReference_7b180d26 extends MethodCallbackByReference {\\n    public $inv_mocker;\\n    public function bar(&$a, &$b, $c) {\\n        $arguments = array($a, $b, $c);\\n        $result = $this->inv_mocker->invoke(\\n            new PHPUnit_Framework_MockObject_Invocation_Static(\\n                $arguments\\n            )\\n        );\\n        return $result;\\n    }\\n}\\n\\nset_error_handler(function() {\\n//    var_dump(func_get_args());\\n    DoesNotExists::$nope = true;\\n}, E_ALL);\\n\\n$foo = new Mock_MethodCallbackByReference_7b180d26();\\n$InvMocker = new PHPUnit_Framework_MockObject_InvocationMocker();\\n$foo->inv_mocker = $InvMocker;\\n$OuterMatcher = new PHPUnit_Framework_MockObject_Matcher();\\n$InvMocker->addMatcher($OuterMatcher);\\n$OuterMatcher->methodNameMatcher = null;\\n$OuterMatcher->stub = new PHPUnit_Framework_MockObject_Stub_ReturnCallback([$foo, 'callback']);\\n$a = $b = $c = 0;\\n$foo->bar($a, $b, $c);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4407:   \"<?php\\n\\nclass ryat {\\n    var $ryat;\\n    var $chtg;\\n\\n    function __destruct() {\\n        $this->chtg = $this->ryat;\\n        $this->ryat = 1;\\n    }\\n}\\n\\n$o = new ryat;\\n$o->ryat = $o;\\n$x =& $o->chtg;\\n\\nunset($o);\\ngc_collect_cycles();\\nvar_dump($x);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4415:   \"<?php\\nfunction create_references(&$array) {\\n    foreach ($array as $key => $value) {\\n        create_references($array[$key]);\\n    }\\n}\\n\\nfunction change_copy($copy) {\\n        $copy['b']['z']['z'] = $copy['b'];\\n}\\n\\n$data = [\\n    'a' => [\\n        'b' => [],\\n    ],\\n];\\n\\ncreate_references($data);\\n\\n$copy = $data['a'];\\nvar_dump($copy);\\n\\nchange_copy($copy);\\nvar_dump($copy); //RECURSION\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4578:   \"<?php\\n$a = 'aaa';\\n\\nforeach ($a['2bbb'] as &$value) {\\n    echo 'loop';\\n}\\n\\nunset($value);\\necho 'done';\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:4579:   :title \"Bug #73792 (invalid foreach loop hangs script)\",\ntest/yang/php/antlr/phpt_selection.edn:4980:   \"<?php\\n\\n$examples = [\\n    \\\"Exception(Exception())\\\" => new Exception(\\\"outer\\\", 0,  new Exception(\\\"inner\\\")),\\n    \\\"Error(Error())\\\"         => new Error(\\\"outer\\\", 0, new Error(\\\"inner\\\")),\\n    \\\"Error(Exception())\\\"     => new Error(\\\"outer\\\", 0, new Exception(\\\"inner\\\")),\\n    \\\"Exception(Error())\\\"     => new Exception(\\\"outer\\\", 0, new Error(\\\"inner\\\"))\\n];\\n\\nforeach ($examples as $name => $example) {\\n    $processed = unserialize(serialize($example));\\n    $processedPrev = $processed->getPrevious();\\n    echo \\\"---- $name ----\\\\n\\\";\\n    echo \\\"before: \\\", get_class($example), \\\".previous == \\\",\\n        get_class($example->getPrevious()), \\\"\\\\n\\\";\\n    echo \\\"after : \\\", get_class($processed), \\\".previous == \\\",\\n        $processedPrev ? get_class($processedPrev) : \\\"null\\\", \\\"\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5023:   \"<?php\\n$arr = [1 => 1, 3 => 3];           // [1 => 1, 2 => 3] will print both keys\\nforeach($arr as $key => &$val) {   // without & will print both keys\\n    echo \\\"See key {$key}\\\\n\\\";\\n    $arr[0] = 0;                   // without this line will print both keys\\n    unset($arr[0]);\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5025:   \"Bug #76800 (foreach inconsistent if array modified during loop)\",\ntest/yang/php/antlr/phpt_selection.edn:5057:   \"<?php\\n\\n$it = new ArrayIterator([1, 2, 3]);\\n$it = new IteratorIterator($it);\\nforeach ($it as $v) {\\n    if (method_exists($it, 'offsetGet')) {\\n        var_dump($it->offsetGet(0));\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5077:  {:id \"Zend/tests/bug77345_gc_1.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5078:   :path \"Zend/tests/bug77345_gc_1.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5080:   \"<?php\\n\\nclass Node\\n{\\n    /** @var Node */\\n    public $previous;\\n    /** @var Node */\\n    public $next;\\n}\\n\\nvar_dump(gc_enabled());\\nvar_dump('start');\\n\\n$firstNode = new Node();\\n$firstNode->previous = $firstNode;\\n$firstNode->next = $firstNode;\\n\\n$circularDoublyLinkedList = $firstNode;\\n\\nfor ($i = 0; $i < 200000; $i++) {\\n    $currentNode = $circularDoublyLinkedList;\\n    $nextNode = $circularDoublyLinkedList->next;\\n\\n    $newNode = new Node();\\n\\n    $newNode->previous = $currentNode;\\n    $currentNode->next = $newNode;\\n    $newNode->next = $nextNode;\\n    $nextNode->previous = $newNode;\\n\\n    $circularDoublyLinkedList = $nextNode;\\n}\\nvar_dump('end');\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5085:  {:id \"Zend/tests/bug77345_gc_2.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5086:   :path \"Zend/tests/bug77345_gc_2.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5088:   \"<?php\\n\\nclass Node\\n{\\n    /** @var Node */\\n    public $previous;\\n    /** @var Node */\\n    public $next;\\n}\\n\\nvar_dump(gc_enabled());\\nvar_dump('start');\\n\\nfunction xxx() {\\n    $firstNode = new Node();\\n    $firstNode->previous = $firstNode;\\n    $firstNode->next = $firstNode;\\n\\n    $circularDoublyLinkedList = $firstNode;\\n\\n    for ($i = 0; $i < 300000; $i++) {\\n        $currentNode = $circularDoublyLinkedList;\\n        $nextNode = $circularDoublyLinkedList->next;\\n\\n        $newNode = new Node();\\n\\n        $newNode->previous = $currentNode;\\n        $currentNode->next = $newNode;\\n        $newNode->next = $nextNode;\\n        $nextNode->previous = $newNode;\\n\\n        $circularDoublyLinkedList = $nextNode;\\n    }\\n}\\n\\nxxx();\\ngc_collect_cycles();\\n\\nvar_dump('end');\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5216:   \"<?php\\nclass C {\\n    public $p;\\n    public function __construct() {\\n        $this->p = (object)[\\\"x\\\" => [1]];\\n    }\\n}\\n#[AllowDynamicProperties]\\nclass E {\\n}\\n$e = new E;\\n$e->f = new E;\\n$e->f->e = $e;\\n$e->a = new C;\\n$e = null;\\ngc_collect_cycles();\\nvar_dump(new C);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5224:   \"<?php\\n#[AllowDynamicProperties]\\nclass E {}\\nfunction f() {\\n    $e1 = new E;\\n    $e2 = new E;\\n    $a = ['e2' => $e2];\\n    $e1->a = (object)$a;\\n    $e2->e1 = $e1;\\n    $e2->a = (object)$a;\\n}\\nf();\\ngc_collect_cycles();\\necho \\\"End\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5266:   \"<?php\\n\\nclass Test {\\n    public $foo;\\n    public function __destruct() {}\\n}\\n\\n$test = new Test;\\n$test->foo = [&$test->foo];\\n$ary = [&$ary, $test];\\nunset($ary, $test);\\ngc_collect_cycles();\\n\\n?>\\n===DONE===\",\ntest/yang/php/antlr/phpt_selection.edn:5363:   \"<?php\\nfunction get() {\\n    $t = new stdClass;\\n    $t->prop = $t;\\n    return $t;\\n}\\nvar_dump(get());\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5448:   \"<?php\\n$a = [42];\\nforeach ($a as &$c) {\\n    // Make the array empty.\\n    unset($a[0]);\\n    // Destroy the array.\\n    $a = null;\\n}\\n?>\\n===DONE===\",\ntest/yang/php/antlr/phpt_selection.edn:5452:   \"Warning: foreach() argument must be of type array|object, null given in %s on line %d\\n===DONE===\"}\ntest/yang/php/antlr/phpt_selection.edn:5530:   \"<?php\\n\\ngc_disable();\\n$obj = new stdClass;\\n$obj->obj = $obj;\\n\\n?>\\n===DONE===\",\ntest/yang/php/antlr/phpt_selection.edn:5562:   \"<?php\\n\\nfinal class A\\n{\\n    public string $a;\\n\\n    public static function fromArray(array $props): self\\n    {\\n        $me = new static;\\n        foreach ($props as $k => &$v) {\\n            $me->{$k} = &$v;  # try to remove &\\n        }\\n        return $me;\\n    }\\n\\n    public function __get($name)\\n    {\\n        throw new \\\\LogicException(\\\"Property '$name' is not defined.\\\");\\n    }\\n}\\n\\nvar_dump(A::fromArray(['a' => 'foo']));\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5600:   \"<?php\\n\\ntry {\\n    $s = 'O:8:\\\"stdClass\\\":1:{s:1:\\\"x\\\";r:1;}';\\n    unserialize($s) % gc_collect_cycles();\\n} catch (Error $e) {\\n    echo $e->getMessage(), \\\"\\\\n\\\";\\n}\\n\\n$a[]=&$a == $a=&$b > gc_collect_cycles();\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5609:   \"Bug #80096: Segmentation fault with named arguments in nested call\",\ntest/yang/php/antlr/phpt_selection.edn:5687:   \"<?php\\n#[AllowDynamicProperties]\\nclass X {\\n    public $x;\\n    public function __construct() { $this->x = [$this]; }\\n}\\ngc_disable();\\nini_set('memory_limit', '10M');\\n$y = [];\\nfor ($i = 0; $i < 10000; $i++) {\\n    $y[] = new X();\\n}\\n$y[0]->y = &$y;\\n\\n?>\\n===DONE===\",\ntest/yang/php/antlr/phpt_selection.edn:5760:   \"<?php\\nclass Foo\\n{\\n    public $foo;\\n}\\n\\nfunction hydrate($properties, $object)\\n{\\n    foreach ($properties as $name => &$value) {\\n        $object->$name = &$value;\\n    }\\n};\\n\\n$object = new Foo;\\n\\nhydrate(['foo' => 123], $object);\\n\\n$arrayCast = (array) $object;\\n\\n$object->foo = 234;\\nvar_dump(ReflectionReference::fromArrayElement($arrayCast, 'foo'));\\necho $arrayCast['foo'];\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5781:  {:id \"Zend/tests/foreach_002.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5782:   :path \"Zend/tests/foreach_002.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5784:   \"<?php\\n\\nerror_reporting(E_ALL);\\n\\nforeach (($a = array('a' => array('a' => &$a))) as $a) {\\n    var_dump($a);\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5785:   :title \"Creating recursive array on foreach using same variable\",\ntest/yang/php/antlr/phpt_selection.edn:5787:  {:id \"Zend/tests/foreach_003.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5788:   :path \"Zend/tests/foreach_003.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5790:   \"<?php\\nclass IT implements Iterator {\\n    private $n = 0;\\n    private $count = 0;\\n    private $trap = null;\\n\\n    function __construct($count, $trap = null) {\\n        $this->count = $count;\\n        $this->trap = $trap;\\n    }\\n\\n    function trap($trap) {\\n        if ($trap === $this->trap) {\\n            throw new Exception($trap);\\n        }\\n    }\\n\\n    function rewind(): void  {$this->trap(__FUNCTION__); $this->n = 0;}\\n    function valid(): bool   {$this->trap(__FUNCTION__); return $this->n < $this->count;}\\n    function key(): mixed     {$this->trap(__FUNCTION__); return $this->n;}\\n    function current(): mixed {$this->trap(__FUNCTION__); return $this->n;}\\n    function next(): void    {$this->trap(__FUNCTION__); $this->n++;}\\n}\\n\\nforeach(['rewind', 'valid', 'key', 'current', 'next'] as $trap) {\\n    $obj = new IT(3, $trap);\\n    try {\\n        // IS_CV\\n        foreach ($obj as $key => $val) echo \\\"$val\\\\n\\\";\\n    } catch (Exception $e) {\\n        echo $e->getMessage() . \\\"\\\\n\\\";\\n    }\\n    unset($obj);\\n\\n    try {\\n        // IS_VAR\\n        foreach (new IT(3, $trap) as $key => $val) echo \\\"$val\\\\n\\\";\\n    } catch (Exception $e) {\\n        echo $e->getMessage() . \\\"\\\\n\\\";\\n    }\\n\\n    try {\\n        // IS_TMP_VAR\\n        foreach ((object)new IT(2, $trap) as $key => $val) echo \\\"$val\\\\n\\\";\\n    } catch (Exception $e) {\\n        echo $e->getMessage() . \\\"\\\\n\\\";\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5791:   :title \"Iterator exceptions in foreach by value\",\ntest/yang/php/antlr/phpt_selection.edn:5795:  {:id \"Zend/tests/foreach_005.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5796:   :path \"Zend/tests/foreach_005.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5798:   \"<?php\\n$a = [1,2,3];\\nforeach($a as &$x) {\\n    foreach($a as &$y) {\\n        echo \\\"$x-$y\\\\n\\\";\\n        $y++;\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5799:   :title \"Nested foreach by reference on the same array\",\ntest/yang/php/antlr/phpt_selection.edn:5801:  {:id \"Zend/tests/foreach_006.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5802:   :path \"Zend/tests/foreach_006.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5804:   \"<?php\\nfor ($i = 0; $i < 3; $i++) {\\n    foreach ([1,2,3] as &$val) {\\n        echo \\\"$val\\\\n\\\";\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5807:  {:id \"Zend/tests/foreach_007.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5808:   :path \"Zend/tests/foreach_007.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5810:   \"<?php\\n$a = [1];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    $a[1]=2;\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5814:  {:id \"Zend/tests/foreach_008.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5815:   :path \"Zend/tests/foreach_008.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5817:   \"<?php\\n$a = [0, 1, 2, 3];\\nforeach ($a as &$x) {\\n    foreach ($a as &$y) {\\n        echo \\\"$x - $y\\\\n\\\";\\n        if ($x == 0 && $y == 1) {\\n            unset($a[2]);\\n            unset($a[1]);\\n        }\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5818:   :title \"Nested foreach by reference and array modification\",\ntest/yang/php/antlr/phpt_selection.edn:5820:  {:id \"Zend/tests/foreach_009.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5821:   :path \"Zend/tests/foreach_009.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5823:   \"<?php\\n$a = [0, 1, 2, 3, 4, 5, 6, 7];\\nunset($a[0], $a[1], $a[2], $a[3]);\\nforeach ($a as &$ref) {\\n    foreach ($a as &$ref2) {\\n        echo \\\"$ref-$ref2\\\\n\\\";\\n        if ($ref == 5 && $ref2 == 6) {\\n            $a[42] = 8;\\n        }\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5825:   \"Nested foreach by reference and array modification with resize\",\ntest/yang/php/antlr/phpt_selection.edn:5828:  {:id \"Zend/tests/foreach_010.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5829:   :path \"Zend/tests/foreach_010.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5831:   \"<?php\\n$o = (object)['a'=>0, 'b'=>1, 'c'=>2, 'd'=>3, 'e'=>4, 'f'=>5, 'g'=>6, 'h'=>7];\\nunset($o->a, $o->b, $o->c, $o->d);\\nforeach ($o as $v1) {\\n    foreach ($o as $v2) {\\n        echo \\\"$v1-$v2\\\\n\\\";\\n        if ($v1 == 5 && $v2 == 6) {\\n            $o->i = 8;\\n        }\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5833:   \"Nested foreach by value over object and object modification with resize\",\ntest/yang/php/antlr/phpt_selection.edn:5837:  {:id \"Zend/tests/foreach_011.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5838:   :path \"Zend/tests/foreach_011.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5840:   \"<?php\\n$a = [1,2,3,4,5,0];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if ($v == 3) {\\n        rsort($a);\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5842:   \"sort() functions precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5844:  {:id \"Zend/tests/foreach_012.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5845:   :path \"Zend/tests/foreach_012.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5847:   \"<?php\\n$a = [1,2,3,4,5];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if ($v == 3) {\\n        array_walk($a, function (&$x) {$x+=10;});\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5849:   \"array_walk() function precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5851:  {:id \"Zend/tests/foreach_013.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5852:   :path \"Zend/tests/foreach_013.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5854:   \"<?php\\n$a = [1,2,3];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if ($v == 3) {\\n        array_push($a, 4);\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5856:   \"array_push() function precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5858:  {:id \"Zend/tests/foreach_014.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5859:   :path \"Zend/tests/foreach_014.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5861:   \"<?php\\n$a = [1,2,3];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if ($v == 2) {\\n        array_pop($a);\\n    }\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5863:   \"array_pop() function precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5865:  {:id \"Zend/tests/foreach_015.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5866:   :path \"Zend/tests/foreach_015.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5868:   \"<?php\\n$a = [1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    array_shift($a);\\n}\\nvar_dump($a);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5870:   \"array_shift() function precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5872:  {:id \"Zend/tests/foreach_016.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5873:   :path \"Zend/tests/foreach_016.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5875:   \"<?php\\n$a = [1,2,3];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if ($v == 2) {\\n        array_unshift($a, 0, 0, 0, 0, 0, 0, 0, 0);\\n    }\\n}\\nvar_dump(count($a));\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5877:   \"array_unshift() function precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5879:  {:id \"Zend/tests/foreach_017.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5880:   :path \"Zend/tests/foreach_017.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5882:   \"<?php\\n/* remove before */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 3) {\\n        $done = 1;\\n        array_splice($a, 1, 2);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* remove after */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 0) {\\n        $done = 1;\\n        array_splice($a, 2, 2);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* remove current */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 2) {\\n        $done = 1;\\n        array_splice($a, 1, 3);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n$replacement = ['x', 'y', 'z'];\\n\\n/* replace before */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 3) {\\n        $done = 1;\\n        array_splice($a, 1, 2, $replacement);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* replace after */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 0) {\\n        $done = 1;\\n        array_splice($a, 2, 2, $replacement);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* replace current */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 2) {\\n        $done = 1;\\n        array_splice($a, 1, 3, $replacement);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5884:   \"array_splice() function precerve foreach by reference iterator pointer\",\ntest/yang/php/antlr/phpt_selection.edn:5887:  {:id \"Zend/tests/foreach_018.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5888:   :path \"Zend/tests/foreach_018.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5890:   \"<?php\\n\\n$obj = (object)[\\n    \\\"\\\\0A\\\\0b\\\" => 42,\\n    \\\"\\\\0*\\\\0c\\\" => 24,\\n];\\n\\nforeach ($obj as $k => $v) {\\n    var_dump($k, $v);\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5894:  {:id \"Zend/tests/foreach_by_ref_repacking_insert.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5895:   :path \"Zend/tests/foreach_by_ref_repacking_insert.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5897:   \"\\n<?php\\n$a = [];\\n$a[1] = 1;\\nforeach ($a as $k => &$v) {\\n    var_dump($v);\\n    if ($k == 1) $a[4] = 4;\\n    if ($k == 4) $a[2] = 2;\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5901:  {:id \"Zend/tests/foreach_by_ref_to_property.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5902:   :path \"Zend/tests/foreach_by_ref_to_property.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5904:   \"<?php\\n$obj = new stdClass;\\nforeach ([0] as &$obj->prop) {\\n    var_dump($obj->prop);\\n}\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5908:  {:id \"Zend/tests/foreach_empty_loop_leak.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5909:   :path \"Zend/tests/foreach_empty_loop_leak.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5911:   \"<?php\\n\\nclass Foo implements IteratorAggregate {\\n    public function getIterator(): Traversable {\\n        return new ArrayIterator([]);\\n    }\\n    public function __destruct() {\\n        throw new Exception;\\n    }\\n}\\n\\ntry {\\n    foreach (new Foo as $x);\\n} catch (Exception $e) {\\n    echo \\\"Exception caught\\\\n\\\";\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5912:   :title \"Empty foreach loops with exception must not leak\",\ntest/yang/php/antlr/phpt_selection.edn:5915:  {:id \"Zend/tests/foreach_list_001.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5916:   :path \"Zend/tests/foreach_list_001.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5918:   \"<?php\\n\\nforeach(array(array(1,2), array(3,4)) as list($a, $b)) {\\n    var_dump($a . $b);\\n}\\n\\n$array = array(\\n    array('a', 'b'),\\n    array('c', 'd'),\\n);\\n\\nforeach ($array as list($a, $b)) {\\n    var_dump($a . $b);\\n}\\n\\n\\n$multi = array(\\n    array(array(1,2), array(3,4)),\\n    array(array(5,6), array(7,8)),\\n);\\n\\nforeach ($multi as list(list($a, $b), list($c, $d))) {\\n    var_dump($a . $b . $c . $d);\\n}\\n\\nforeach ($multi as $key => list(list($a, $b), list($c, $d))) {\\n    var_dump($key . $a . $b . $c . $d);\\n}\\n\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5919:   :title \"foreach with list syntax\",\ntest/yang/php/antlr/phpt_selection.edn:5922:  {:id \"Zend/tests/foreach_list_002.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5923:   :path \"Zend/tests/foreach_list_002.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5925:   \"<?php\\n\\nforeach (array(array(1,2), array(3,4)) as list($a, )) {\\n    var_dump($a);\\n}\\n\\n$array = [['a', 'b'], 'c', 'd'];\\n\\nforeach($array as list(, $a)) {\\n   var_dump($a);\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5926:   :title \"foreach with freak lists\",\ntest/yang/php/antlr/phpt_selection.edn:5928:  {:id \"Zend/tests/foreach_list_003.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5929:   :path \"Zend/tests/foreach_list_003.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5931:   \"<?php\\n\\n$array = [['a', 'b'], 'c', 'd'];\\n\\nforeach($array as list($key) => list(list(), $a)) {\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5932:   :title \"foreach with list key\",\ntest/yang/php/antlr/phpt_selection.edn:5934:   \"Fatal error: Cannot use list as key element in %sforeach_list_003.php on line %d\"}\ntest/yang/php/antlr/phpt_selection.edn:5935:  {:id \"Zend/tests/foreach_list_004.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5936:   :path \"Zend/tests/foreach_list_004.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5938:   \"<?php\\n\\n$array = [['a', 'b'], 'c', 'd'];\\n\\nforeach($array as $key => list()) {\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5939:   :title \"foreach with empty list\",\ntest/yang/php/antlr/phpt_selection.edn:5941:   \"Fatal error: Cannot use empty list in %sforeach_list_004.php on line %d\"}\ntest/yang/php/antlr/phpt_selection.edn:5942:  {:id \"Zend/tests/foreach_list_keyed.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5943:   :path \"Zend/tests/foreach_list_keyed.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5945:   \"<?php\\n\\n$points = [\\n    [\\\"x\\\" => 1, \\\"y\\\" => 2],\\n    [\\\"x\\\" => 2, \\\"y\\\" => 1]\\n];\\n\\nforeach ($points as list(\\\"x\\\" => $x, \\\"y\\\" => $y)) {\\n    var_dump($x, $y);\\n}\\n\\necho PHP_EOL;\\n\\n$invertedPoints = [\\n    \\\"x\\\" => [1, 2],\\n    \\\"y\\\" => [2, 1]\\n];\\n\\nforeach ($invertedPoints as list(0 => $row1, 1 => $row2)) {\\n    var_dump($row1, $row2);\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5946:   :title \"foreach with list syntax, keyed\",\ntest/yang/php/antlr/phpt_selection.edn:5949:  {:id \"Zend/tests/foreach_over_null.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5950:   :path \"Zend/tests/foreach_over_null.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5952:   \"<?php\\n\\nfunction test() {\\n    foreach (null as $v) {\\n        echo \\\"Foo\\\\n\\\";\\n    }\\n}\\ntest();\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5953:   :title \"foreach over null\",\ntest/yang/php/antlr/phpt_selection.edn:5955:   \"Warning: foreach() argument must be of type array|object, null given in %s on line %d\"}\ntest/yang/php/antlr/phpt_selection.edn:5956:  {:id \"Zend/tests/foreach_reference.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5957:   :path \"Zend/tests/foreach_reference.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5959:   \"<?php\\n\\n$array = ['a', 'b', 'c', 'd'];\\n\\nforeach ($array as &$a) {\\n}\\n\\nvar_dump($array);\\n\\nvar_dump(array_values($array));\\nvar_dump($a);\\n\\nvar_dump(array_reverse($array));\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5960:   :title \"foreach with reference\",\ntest/yang/php/antlr/phpt_selection.edn:5963:  {:id \"Zend/tests/foreach_shadowed_dyn_property.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5964:   :path \"Zend/tests/foreach_shadowed_dyn_property.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5966:   \"<?php\\n\\nclass Test {\\n    private $prop = \\\"Test\\\";\\n\\n    function run() {\\n        foreach ($this as $k => $v) {\\n            echo \\\"$k => $v\\\\n\\\";\\n        }\\n        var_dump(get_object_vars($this));\\n    }\\n}\\n\\n#[AllowDynamicProperties]\\nclass Test2 extends Test {\\n}\\n\\n$test2 = new Test2;\\n$test2->prop = \\\"Test2\\\";\\n$test2->run();\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5971:  {:id \"Zend/tests/foreach_shadowed_property.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5972:   :path \"Zend/tests/foreach_shadowed_property.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5974:   \"<?php\\n\\nclass Test {\\n    private $prop = \\\"Test\\\";\\n\\n    function run() {\\n        foreach ($this as $k => $v) {\\n            echo \\\"$k => $v\\\\n\\\";\\n        }\\n        var_dump(get_object_vars($this));\\n    }\\n}\\nclass Test2 extends Test {\\n    public $prop = \\\"Test2\\\";\\n}\\n\\n(new Test2)->run();\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5979:  {:id \"Zend/tests/foreach_temp_array_expr_with_refs.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5980:   :path \"Zend/tests/foreach_temp_array_expr_with_refs.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:5982:   \"<?php\\n\\n$a = 'a';\\n$b = 'b';\\n\\nforeach ([&$a, &$b] as &$value) {\\n    $value .= '-foo';\\n}\\n\\nvar_dump($a, $b);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:5985:  {:id \"Zend/tests/foreach_undefined.phpt\",\ntest/yang/php/