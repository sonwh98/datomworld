\\n} catch (Exception $e) {\\n    gc_collect_cycles();\\n}\\necho \\\"ok\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6150:  {:id \"Zend/tests/gc_028.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6151:   :path \"Zend/tests/gc_028.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6153:   \"<?php\\nclass Foo {\\n    public $bar;\\n    function __destruct() {\\n        if ($this->bar !== null) {\\n            unset($this->bar);\\n        }\\n    }\\n}\\nclass Bar {\\n    public $foo;\\n        function __destruct() {\\n                if ($this->foo !== null) {\\n                        unset($this->foo);\\n                }\\n        }\\n\\n}\\n$foo = new Foo();\\n$bar = new Bar();\\n$foo->bar = $bar;\\n$bar->foo = $foo;\\nunset($foo);\\nunset($bar);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6157:  {:id \"Zend/tests/gc_029.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6158:   :path \"Zend/tests/gc_029.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6160:   \"<?php\\nclass Foo {\\n    public $bar;\\n    public $x = array(1,2,3);\\n    function __destruct() {\\n        if ($this->bar !== null) {\\n            $this->x = null;\\n            unset($this->bar);\\n        }\\n    }\\n}\\nclass Bar {\\n    public $foo;\\n        function __destruct() {\\n                if ($this->foo !== null) {\\n                        unset($this->foo);\\n                }\\n        }\\n\\n}\\n$foo = new Foo();\\n$bar = new Bar();\\n$foo->bar = $bar;\\n$bar->foo = $foo;\\nunset($foo);\\nunset($bar);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6164:  {:id \"Zend/tests/gc_030.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6165:   :path \"Zend/tests/gc_030.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6167:   \"<?php\\nclass foo {\\n    public $foo;\\n\\n    public function __destruct() {\\n        throw new Exception(\\\"foobar\\\");\\n    }\\n}\\n\\n$f1 = new foo;\\n$f2 = new foo;\\n$f1->foo = $f2;\\n$f2->foo = $f1;\\nunset($f1, $f2);\\ngc_collect_cycles();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6170:   \"Fatal error: Uncaught Exception: foobar in %sgc_030.php:%d\\nStack trace:\\n#0 [internal function]: foo->__destruct()\\n#1 %sgc_030.php(%d): gc_collect_cycles()\\n#2 {main}\\n\\nNext Exception: foobar in %sgc_030.php:%d\\nStack trace:\\n#0 [internal function]: foo->__destruct()\\n#1 %sgc_030.php(%d): gc_collect_cycles()\\n#2 {main}\\n  thrown in %sgc_030.php on line %d\",\ntest/yang/php/antlr/phpt_selection.edn:6172:  {:id \"Zend/tests/gc_031.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6173:   :path \"Zend/tests/gc_031.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6174:   :source \"<?php\\ngc_collect_cycles();\\necho \\\"DONE\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6175:   :title \"GC 031: gc_collect_roots() with GC turned off.\",\ntest/yang/php/antlr/phpt_selection.edn:6177:  {:id \"Zend/tests/gc_032.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6178:   :path \"Zend/tests/gc_032.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6184:  {:id \"Zend/tests/gc_033.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6185:   :path \"Zend/tests/gc_033.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6187:   \"<?php\\n$a = new stdClass();\\n$a->a = array();\\n$a->a[0] = new Stdclass();\\n$a->a[0]->a = $a;\\n$a->a[1] = &$a->a;\\n\\n/* remove the self-reference array out of roots */\\ngc_collect_cycles();\\n\\n/* do unset */\\nunset($a);\\n\\n/* let's full the gc roots */\\nfor ($i=0; $i<9999; $i++) {\\n        $b = range(0, 1);\\n            $b[0] = &$b;\\n            unset($b);\\n}\\n\\n/* then $a will be freed, but $a->a[0] is not. reference to a freed $a */\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6191:  {:id \"Zend/tests/gc_034.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6192:   :path \"Zend/tests/gc_034.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6197:  {:id \"Zend/tests/gc_035.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6198:   :path \"Zend/tests/gc_035.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6200:   \"<?php\\nclass A {\\n    public $a;\\n    public $x;\\n    function __destruct() {\\n        unset($this->x);\\n    }\\n}\\n$a = new A;\\n$a->a = $a;\\n$a->x = [];\\n$a->x[] =& $a->x;\\n$a->x[] = $a;\\nvar_dump(gc_collect_cycles());\\nunset($a);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6204:  {:id \"Zend/tests/gc_038.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6205:   :path \"Zend/tests/gc_038.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6207:   \"<?php\\nfunction test_add() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x += 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"+=\\\\t$n\\\\n\\\";\\n}\\ntest_add();\\n\\nfunction test_sub() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x -= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"-=\\\\t$n\\\\n\\\";\\n}\\ntest_sub();\\n\\nfunction test_mul() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x *= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"*=\\\\t$n\\\\n\\\";\\n}\\ntest_mul();\\n\\nfunction test_div() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x /= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"/=\\\\t$n\\\\n\\\";\\n}\\ntest_div();\\n\\nfunction test_mod() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x %= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"%=\\\\t$n\\\\n\\\";\\n}\\ntest_mod();\\n\\nfunction test_sl() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x <<= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"<<=\\\\t$n\\\\n\\\";\\n}\\ntest_sl();\\n\\nfunction test_sr() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x >>= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\">>=\\\\t$n\\\\n\\\";\\n}\\ntest_sr();\\n\\nfunction test_or() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x |= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"|=\\\\t$n\\\\n\\\";\\n}\\ntest_or();\\n\\nfunction test_and() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x &= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"&=\\\\t$n\\\\n\\\";\\n}\\ntest_and();\\n\\nfunction test_xor() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x ^= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"^=\\\\t$n\\\\n\\\";\\n}\\ntest_xor();\\n\\nfunction test_pow() {\\n    $x = new stdClass;\\n    $x->x = $x;\\n    try {\\n        $x **= 5;\\n    } catch (TypeError $e) { unset($x); }\\n    $n = gc_collect_cycles();\\n    echo \\\"**=\\\\t$n\\\\n\\\";\\n}\\ntest_pow();\\n\\nclass Y {\\n    public $x;\\n    function __toString() {\\n        return \\\"y\\\";\\n    }\\n}\\nfunction test_concat() {\\n    $x = new Y;\\n    $x->x = $x;\\n    @$x .= \\\"x\\\";\\n    $n = gc_collect_cycles();\\n    echo \\\".=\\\\t$n\\\\n\\\";\\n}\\ntest_concat();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6213:  {:id \"Zend/tests/gc_039.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6214:   :path \"Zend/tests/gc_039.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6216:   \"<?php\\n$out = new stdClass;\\n$out->x = $out;\\nmb_parse_str(\\\"a=b\\\", $out);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6221:  {:id \"Zend/tests/gc_041.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6222:   :path \"Zend/tests/gc_041.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6224:   \"<?php\\nclass ryat {\\n        var $ryat;\\n        var $chtg;\\n        var $nested;\\n        function __destruct() {\\n                $GLOBALS['x'] = $this;\\n        }\\n}\\n$o = new ryat;\\n$o->nested = [];\\n$o->nested[] =& $o->nested;\\n$o->ryat = $o;\\n$x =& $o->chtg;\\nunset($o);\\nvar_dump(gc_collect_cycles());\\nvar_dump($x);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6230:  {:id \"Zend/tests/gc_042.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6231:   :path \"Zend/tests/gc_042.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6233:   \"<?php\\n\\n#[AllowDynamicProperties]\\nclass Test {\\n    public function __destruct() {\\n        $GLOBALS['x'] = $this;\\n    }\\n}\\n\\n$t = new Test;\\n$t->x = new stdClass;\\n$t->x->t = $t;\\n$a = (array) $t->x;\\nunset($t, $a);\\ngc_collect_cycles();\\nvar_dump($x);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6239:  {:id \"Zend/tests/gc_043.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6240:   :path \"Zend/tests/gc_043.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6242:   \"<?php\\n$s = <<<'STR'\\nO:8:\\\"stdClass\\\":2:{i:5;C:8:\\\"SplStack\\\":29:{i:4;:r:1;:O:8:\\\"stdClass\\\":0:{}}i:0;O:13:\\\"RegexIterator\\\":1:{i:5;C:8:\\\"SplStack\\\":29:{i:4;:r:1;:O:8:\\\"stdClass\\\":0:{}}}}\\nSTR;\\nvar_dump(unserialize($s));\\ngc_collect_cycles();\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6246:  {:id \"Zend/tests/gc_044.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6247:   :path \"Zend/tests/gc_044.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6253:  {:id \"Zend/tests/gc_045.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6254:   :path \"Zend/tests/gc_045.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6256:   \"<?php\\nclass GlobalData\\n{\\n    public static Bar $bar;\\n}\\n\\nclass Value\\n{\\n    public function __destruct()\\n    {\\n        new Bar();\\n    }\\n}\\n\\nclass Bar\\n{\\n    public function __construct()\\n    {\\n        GlobalData::$bar = $this;\\n    }\\n}\\n\\nclass Foo\\n{\\n    public Foo $selfRef;\\n    public Value $val;\\n\\n    public function __construct(Value $val)\\n    {\\n        $this->val = $val;\\n        $this->selfRef = $this;\\n    }\\n}\\n\\nfor ($j = 0; $j < 10; $j++) {\\n    for ($i = 0; $i < 3000; $i++) {\\n        new Foo(new Value());\\n    }\\n}\\n\\nvar_dump(gc_status());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6262:  {:id \"Zend/tests/gc_046.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6263:   :path \"Zend/tests/gc_046.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6269:  {:id \"Zend/tests/gc_047.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6270:   :path \"Zend/tests/gc_047.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6272:   \"<?php\\n$a = [0, 1];\\nforeach($a as &$v) {\\n    $a[0] =& $a;\\n    $a[1] = array();\\n    $a[1][0] =& $a[1];\\n    $b = 1;\\n    $a =& $b;\\n    gc_collect_cycles();\\n    break;\\n}\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6273:   :title \"GC 047: Leak after GC inside a foreach loop\",\ntest/yang/php/antlr/phpt_selection.edn:6293:   \"<?php\\n$coords = array(array(1, 2), array(3, 4));\\nforeach ($coords as [&$x, $y]) {\\n    $x++;\\n    $y++;\\n}\\nvar_dump($coords);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:6332:  {:id \"Zend/tests/named_params/__call.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6333:   :path \"Zend/tests/named_params/__call.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6337:   \"Check that __call() and __callStatic() work with named parameters\",\ntest/yang/php/antlr/phpt_selection.edn:6341:  {:id \"Zend/tests/named_params/__invoke.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6342:   :path \"Zend/tests/named_params/__invoke.phpt\",\ntest/yang/php/antlr/phpt_selection.edn:6345:   :title \"Check that __invoke() works with named parameters\",\ntest/yang/php/antlr/phpt_selection.edn:6347:   \"a: A, b: B\\na: a, b: B\\nUnknown named parameter $c\\n\\na: A, b: B\\narray(1) {\\n  [\\\"c\\\"]=>\\n  strin