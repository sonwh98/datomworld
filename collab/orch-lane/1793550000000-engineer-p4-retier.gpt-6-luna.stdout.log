ss (:uncaught r)) \\\": \\\"\\n353\\t                                    (:message (:uncaught r))))))\\n354\\t                      [:pass id]\\n355\\t                      :else [:fail id]))\\n356\\t          by (group-by first results)]\\n357\\t      (println \\\"php-src selection:\\\" (count (:entries sel)) \\\"entries;\\\"\\n358\\t               \\\"pass\\\" (count (:pass by)) \\\"unsupported\\\" (count (:unsupported by))\\n359\\t               \\\"fail\\\" (count (:fail by)))\\n360\\t      (is (empty? (:fail by)) (pr-str (take 5 (:fail by)))))\\n361\\t    (println \\\"php-src selection: phpt_selection.edn not generated yet (run yang.php.phpt on shiva)\\\")))\\n362\\t\\n363\\t\\n364\\t(deftest gate-fix-programs-test\\n365\\t  (testing \\\"var_dump of a self-referencing array terminates with *RECURSION*\\\"\\n366\\t    (let [r (engine-result \\\"<?php $a = [1]; $a[0] = &$a; var_dump($a);\\\")]\\n367\\t      (is (str/includes? (:out r) \\\"*RECURSION*\\\") (pr-str r))\\n368\\t      (is (nil? (:uncaught r)))))\\n369\\t  (testing \\\"comparing two cyclic arrays is a nesting Error\\\"\\n370\\t    (is (= \\\"Nesting level too deep - recursive dependency?\\\"\\n371\\t           (:out (engine-result\\n372\\t                   (str \\\"<?php $a = [1]; $a[0] = &$a; $b = [1]; $b[0] = &$b;\\\"\\n373\\t                        \\\" try { var_dump($a == $b); } catch (Error $e) { echo $e->getMessage(); }\\\"))))))\\n374\\t  (testing \\\"C25: a string-key spread is refused with the named gap\\\"\\n375\\t    (let [r (engine-result (:source (first (filter #(= :call-spread-string-key-gap (:id %))\\n376\\t                                                   p3b/all-fixtures))))]\\n377\\t      (is (= {:class \\\"Error\\\",\\n378\\t              :message \\\"spread with string keys is not supported yet (yang.php known gap G-spread-string-keys)\\\"}\\n379\\t             (:uncaught r)))))\"}\n{\"role\":\"tool\",\"tool_call_id\":\"tool_Tb1UlISqSIg9YX5EB7oPG0OX\",\"content\":\"1\\t(ns yang.php.antlr.e2e-test\\n2\\t  \\\"End to end on the JVM: source -> CST packet -> lowering stage -> program\\n3\\t   envelope -> the bundled program on each of the four VMs (the AST walker,\\n4\\t   the semantic, stack and register VMs). Every fixture of\\n5\\t   `yang.php.antlr.programs` prints the same text on all four.\\\"\\n6\\t  (:require\\n7\\t    [clojure.edn :as edn]\\n8\\t    [clojure.java.io :as io]\\n9\\t    [clojure.string :as str]\\n10\\t    [clojure.test :refer [deftest is testing]]\\n11\\t    [yang.php.antlr.cst :as cst]\\n12\\t    [yang.php.antlr.e2e-harness :as h]\\n13\\t    [yang.php.antlr.packets :as packets]\\n14\\t    [yang.php.antlr.packets-p3b :as packets-p3b]\\n15\\t    [yang.php.antlr.permutations :as perms]\\n16\\t    [yang.php.antlr.phpt :as phpt]\\n17\\t    [yang.php.antlr.programs :as programs]\\n18\\t    [yang.php.antlr.programs-p3b :as p3b]))\\n19\\t\\n20\\t\\n21\\t(def ^:private vms [:ast-walker :semantic :stack :register])\\n22\\t\\n23\\t\\n24\\t(defn- rendered\\n25\\t  \\\"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\\\"\\n26\\t  [{:keys [out uncaught]}]\\n27\\t  (str out\\n28\\t       (when uncaught\\n29\\t         (str \\\"PHP Fatal error:  Uncaught \\\" (:class uncaught) \\\": \\\" (:message uncaught)))))\\n30\\t\\n31\\t\\n32\\t(deftest ^:slow fixtures-on-every-vm-test\\n33\\t  (doseq [{:keys [id source] :as fixture} programs/fixtures\\n34\\t          :let [out (rendered fixture)]]\\n35\\t    (testing (name id)\\n36\\t      (let [results (h/run-php source)]\\n37\\t        (is (not (contains? results :diagnostics)) (pr-str results))\\n38\\t        (doseq [k vms]\\n39\\t          (is (= out (get results k)) (str (name id) \\\" on \\\" k)))))))\\n40\\t\\n41\\t\\n42\\t(deftest fixtures-on-the-walker-test\\n43\\t  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\\n44\\t          :let [r (h/run-raw source)]]\\n45\\t    (is (not= :pending oracle) (name id))\\n46\\t    (is (= out (h/latin1->