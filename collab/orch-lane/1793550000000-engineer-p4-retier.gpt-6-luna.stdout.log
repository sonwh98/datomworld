{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n '10001|9999|9998|gc_collect_cycles|gc_013|gc_023' test/yang/php/antlr\"","aggregated_output":"test/yang/php/antlr/programs_p3b.cljc:219:   `gc_collect_cycles()`, which yang.php does not provide; R2 condition 1 is\ntest/yang/php/antlr/programs_p3b.cljc:230:                 \" $n = gc_collect_cycles(); echo $n > 0 ? 'collected' : 'none';\"),\ntest/yang/php/antlr/programs_p3b.cljc:232:    :note \"recorded only; yang.php has no gc_collect_cycles\"}\ntest/yang/php/antlr/programs.cljc:874:  [\"10110001000000010010\"\ntest/yang/php/antlr/programs.cljc:878:   \"01001000110001100000\"\ntest/yang/php/antlr/programs.cljc:879:   \"01000100000000000000\"\ntest/yang/php/antlr/programs.cljc:882:   \"01001000110001100000\"\ntest/yang/php/antlr/programs.cljc:883:   \"01001000110001100000\"\ntest/yang/php/antlr/programs.cljc:887:   \"01001000110001100000\"\ntest/yang/php/antlr/programs.cljc:888:   \"01001000110001100000\"\ntest/yang/php/antlr/programs.cljc:991:   [\"99999999999999.5\" \"1.0E+14\" \"99999999999999.5\"]\ntest/yang/php/antlr/programs.cljc:992:   [\"999999999999995.0\" \"1.0E+15\" \"999999999999995\"]\ntest/yang/php/antlr/phpt_selection.edn:1579:   \"<?php\\n$xmlstr = <<<XML\\n<?xml version='1.0' standalone='yes'?>\\n<movies>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n <movie>\\n  <title>TEST</title>\\n </movie>\\n</movies>\\nXML;\\n\\n$Array = array( );\\nfor( $XX = 0; $XX < 2000; ++$XX )\\n{\\n $Array[] = $xml = new SimpleXMLElement($xmlstr);\\n}\\n\\ngc_collect_cycles( );\\necho \\\"ok\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1842:   \"<?php\\nclass A\\n{\\n    public $data = [];\\n    public function __destruct()\\n    {\\n        gc_collect_cycles();\\n    }\\n\\n    public function getB()\\n    {\\n        $this->data['foo'] = new B($this);\\n        $this->data['bar'] = new B($this);\\n        // Return either of the above\\n        return $this->data['foo'];\\n    }\\n}\\n\\nclass B\\n{\\n    public function __construct(public $A) {}\\n\\n    public function __destruct()\\n    {\\n    }\\n}\\n\\nfor ($i = 0; $i < 2; $i++)\\n{\\n    $Aobj = new A;\\n    $Bobj = $Aobj->getB();\\n    unset($Bobj);\\n    unset($Aobj);\\n}\\n\\necho \\\"DONE\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:1844:   \"Bug #47343 (gc_collect_cycles causes a segfault when called within a destructor in one case)\",\ntest/yang/php/antlr/phpt_selection.edn:2388:   \"<?php\\n\\n$time = '9999-11-33';\\t// obviously invalid ;-)\\n$timeZone = new DateTimeZone('UTC');\\n\\ntry {\\n    $dateTime = new DateTime($time, $timeZone);\\n} catch (Exception $e) {\\n    var_dump($e->getMessage());\\n}\\n\\nvar_dump(error_get_last());\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2392:   \"string(80) \\\"Failed to parse time string (9999-11-33) at position 9 (3): Unexpected character\\\"\\nNULL\",\ntest/yang/php/antlr/phpt_selection.edn:2492:   \"<?php\\nclass Foo {\\n    public $x;\\n\\n    public function __construct() {\\n        $this->x = function() {};\\n    }\\n}\\n\\nclass Bar {\\n    public $x;\\n\\n    public function __construct() {\\n        $self = $this;\\n        $this->x = function() use ($self) {};\\n    }\\n}\\n\\ngc_collect_cycles();\\nnew Foo;\\nvar_dump(gc_collect_cycles());\\nnew Bar;\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2836:   \"<?php\\n/* the default gc root size is 10,000 */\\nfor ($i=0; $i<9998; $i++) {\\n    $array = array();\\n    $array[0] = &$array;\\n    unset($array);\\n}\\n\\n$matches = array(\\\"foo\\\" => \\\"bar\\\"); /* this bucket will trigger the segfault */\\n$dummy   = array(\\\"dummy\\\");        /* used to trigger gc_collect_cycles */\\n$dummy[1] = &$dummy;\\n\\n$matches[1] = &$matches;\\n$matches[2] = $dummy;\\n\\nstr_replace(\\\"foo\\\", \\\"bar\\\", \\\"foobar\\\", $matches);\\necho \\\"okey\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:2916:   :title \"Bug #63635 (Segfault in gc_collect_cycles)\",\ntest/yang/php/antlr/phpt_selection.edn:2923:   \"<?php\\nclass C {\\n    public $ref;\\n    public $ary;\\n    public function __construct() {\\n        $this->ref = $this;\\n        $this->ary[] = 42;\\n    }\\n    public function __destruct() {\\n        global $ary;\\n        $ary[] = $this->ary[0];\\n    }\\n}\\n\\n$c = new C;\\nunset($c);\\ngc_collect_cycles();\\n\\nvar_dump($ary);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3100:   \"<?php\\n$bar = NULL;\\nclass bad\\n{\\n    private $_private = array();\\n\\n    public function __construct()\\n    {\\n        $this->_private[] = 'php';\\n    }\\n\\n    public function __destruct()\\n    {\\n        global $bar;\\n        $bar = $this;\\n    }\\n}\\n\\n$foo = new stdclass;\\n$foo->foo = $foo;\\n$foo->bad = new bad;\\n\\ngc_disable();\\n\\nunserialize(serialize($foo));\\ngc_collect_cycles();\\nvar_dump($bar);\\ngc_enable();\\n/*  will output:\\nobject(bad)#4 (1) {\\n  [\\\"_private\\\":\\\"bad\\\":private]=>\\n  &UNKNOWN:0\\n}\\n*/\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3102:   \"Bug #64896 (Segfault with gc_collect_cycles using unserialize on certain objects)\",\ntest/yang/php/antlr/phpt_selection.edn:3491:   \"<?php\\n$bar = NULL;\\n#[AllowDynamicProperties]\\nclass bad {\\n    public function __destruct() {\\n        global $bar;\\n        $bar = $this;\\n        $bar->y = new stdClass;\\n    }\\n}\\n\\n$foo = new stdClass;\\n$foo->foo = $foo;\\n$foo->bad = new bad;\\n$foo->bad->x = new stdClass;\\n\\nunset($foo);\\ngc_collect_cycles();\\nvar_dump($bar);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3500:   \"<?php\\n$bar = NULL;\\nclass bad\\n{\\n    public $_private = array();\\n\\n    public function __construct()\\n    {\\n        $this->_private[] = 'php';\\n    }\\n\\n    public function __destruct()\\n    {\\n        global $bar;\\n        $bar = $this;\\n    }\\n}\\n\\n$foo = new stdclass;\\n$foo->foo = $foo;\\n$foo->bad = new bad;\\n\\nunserialize(serialize($foo));\\n//unset($foo);\\n\\ngc_collect_cycles();\\nvar_dump($bar);\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3518:   \"<?php\\nclass Node extends SplObjectStorage {\\n    public $prop;\\n}\\n\\n$node1 = new Node;\\n$node2 = new Node;\\n$node1->prop = $node2;\\n$node2->prop = $node1;\\nunset($node1);\\nunset($node2);\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3916:   \"<?php\\nclass A {\\n    public $b;\\n}\\n\\nclass B {\\n    public $a;\\n}\\n\\nclass C {\\n    public function __destruct() {\\n        if (isset($GLOBALS[\\\"a\\\"])) {\\n            unset($GLOBALS[\\\"array\\\"]);\\n            unset($GLOBALS[\\\"a\\\"]); // this will be called in gc_colloct_roots and put $a into gc roots buf\\n        }\\n    }\\n}\\n\\n$a = new A;\\n$a->b = new B;\\n$a->b->a = $a;\\n\\n$i = 0;\\n\\n$c = new A;\\n$array = array($c); //This is used to leave a room for $GLOBALS[\\\"a\\\"]\\nunset($c);\\n\\nwhile ($i++ < 9998) {\\n    $t = [];\\n    $t[] = &$t;\\n    unset($t);\\n}\\n$t = [new C];\\n$t[] = &$t;\\nunset($t); // This is used to trigger C::__destruct while doing gc_colloct_roots\\n\\n$e = $a;\\nunset($a); // This one cannot be put into roots buf because it's full, thus gc_colloct_roots will be called,\\n           // but C::__destructor which is called in gc_colloct_roots will put $a into buf\\n           // which will make $a be put into gc roots buf twice\\nvar_dump(gc_collect_cycles());\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:3924:   \"<?php\\nclass A {\\n    public $b;\\n}\\n\\nclass B {\\n    public $a;\\n}\\n\\nclass C {\\n    public function __destruct() {\\n        if (isset($GLOBALS[\\\"a\\\"])) {\\n            unset($GLOBALS[\\\"array\