 [php/pop-frame\n180\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\n181\t     (fn [hs]\n182\t       (cell/set! php.rt/ctx\n183\t                  (assoc (assoc (cell/get php.rt/ctx) :handlers (get hs 2))\n184\t                         :depth (get hs 4))))]\n185\t    [php/raise\n186\t     ;; deliver the error to the innermost handler, running each :finally\n187\t     ;; thunk it unwinds through; the unit root always installs a handler,\n188\t     ;; so an empty stack is a defect and answers the error\n189\t     (fn [e]\n190\t       (let [hs (php/handlers)]\n191\t         (if (nil? hs)\n192\t           e\n193\t           (if (= (get hs 0) :finally)\n194\t             (do (php/pop-frame hs)\n195\t                 ((get hs 1) e)\n196\t                 (php/raise e))\n197\t             ((get hs 1) e)))))]\n198\t    [php/unwind-to\n199\t     ;; pop frames above frame count n, running each finally thunk with null\n200\t     (fn [n]\n201\t       (let [hs (php/handlers)]\n202\t         (if (nil? hs)\n203\t           :php/null\n204\t           (if (<= (get hs 3) n)\n205\t             :php/null\n206\t             (do (php/pop-frame hs)\n207\t                 (if (= (get hs 0) :finally) ((get hs 1) :php/null) :php/null)\n208\t                 (php/unwind-to n))))))]\n209\t    [php/try\n210\t     (fn [body handler orelse]\n211\t       (let [saved (cell/get php.rt/ctx)\n212\t             flag (cell/new :first)]\n213\t         ((fn [r]\n214\t            (if (= (cell/get flag) :first)\n215\t              (do (cell/set! flag :re-entered)\n216\t                  (php/set-handlers! (php/frame :handler r (get saved :handlers)))\n217\t                  (body)\n218\t                  (php/restore! saved)\n219\t                  (orelse))\n220\t              (do (php/restore! saved)\n221\t                  (handler r))))\n222\t          (%capture))))]\n223\t    [php/try-finally\n224\t     ;; normal exit runs `fin` here; raise and escapes run it as they\n225\t     ;; unwind through the :finally frame\n226\t     (fn [body fin]\n227\t       (let [saved (cell/get php.rt/ctx)]\n228\t         (do (php/set-handlers! (php/frame :finally fin (get saved :handlers)))\n229\t             (let [v (body)]\n230\t               (do (php/restore! saved)\n231\t                   (fin :php/null)\n232\t                   v)))))]\n233\t    [php/call-ec\n234\t     ;; `f` receives an escape: calling it unwinds to here and answers its\n235\t     ;; argument as this call's value (break, continue, return)\n236\t     (fn [f]\n237\t       (let [saved (cell/get php.rt/ctx)\n238\t             flag (cell/new :first)]\n239\t         ((fn [r]\n240\t            (if (= (cell/get flag) :first)\n241\t              (do (cell/set! flag :re-entered)\n242\t                  (f (fn [x]\n243\t                       (do (php/unwind-to (php/frame-depth (get saved :handlers)))\n244\t                           (php/restore! saved)\n245\t                           (r x)))))\n246\t              r))\n247\t          (%capture))))]\n248\t\n249\t    ;; ---------------------------------------------------------------- errors\n250\t    [php/make-error\n251\t     (fn [cls msg]\n252\t       (let [c (php/class-lookup cls)]\n253\t         (if (if (nil? c) true (= (data/count (get c :methods)) 0))\n254\t           (php/make-error-map cls msg)\n255\t           (let [o (php/instantiate c)]\n256\t             (do (php/obj-set-props! o (php/table-set (get (php/obj-state o) :props) \"message\" msg))\n257\t                 o)))))]\n258\t    [php/make-error-map\n259\t     (fn [cls msg]\n260\t       (let [n (cell/get php.rt/next-ord)]\n261\t         (do (cell/set! php.rt/next-ord (+ n 1))\n262\t             (assoc (assoc (assoc (assoc {} :php/type :obj) :class cls) :ord n)\n263\t                    :props\n264\t                    (assoc (assoc (assoc {} \"message\" msg) \"code\" 0)\n265\t                           \"previous\" :php/null)))))]\n266\t    [php/throw-error (fn [cls msg] (p