t\"]\n32\t                  :extra-deps {io.github.cognitect-labs/test-runner\n33\t                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n34\t                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n35\t                               ;; the differential oracle for the yang.clojure gap\n36\t                               ;; program (pinned; MIT; dependency-free)\n37\t                               latte-kernel/latte-kernel\n38\t                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n39\t                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n40\t                  ;; The guest recursion limit allows depth that needs more than the\n41\t                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n42\t                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n43\t                  ;; before it can raise Python's RecursionError, so the same tests\n44\t                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n45\t                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n46\t                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n47\t                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n48\t                  ;; deep assertion payloads (the PHPT selection diagnostics and\n49\t                  ;; the conformance compositions) overflow smaller stacks in\n50\t                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n51\t                  ;; the 4m minimum for the prelude recursion rows still holds)\n52\t                  :jvm-opts [\"-Xss64m\"]\n53\t                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n54\t                  :exec-fn cognitect.test-runner.api/test}\n55\t           :nREPL {:extra-paths [\"test\"]\n56\t                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n57\t                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n58\t                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n59\t           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n60\t                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n61\t                               reagent/reagent {:mvn/version \"2.0.1\"}\n62\t                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n63\t           :dev {:extra-paths [\"src/dev\"]\n64\t                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n65\t                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n66\t                              reagent/reagent {:mvn/version \"2.0.1\"}\n67\t                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n68\t                              ;; benchmark baseline + psset-fixtures\n69\t                              ;; generator only; production uses\n70\t                              ;; dao.data.btree\n71\t                              persistent-sorted-set/persistent-sorted-set\n72\t                              {:mvn/version \"0.3.0\"}}\n73\t                 :jvm-opts [\"-Dconfig=config.clj\"]}\n74\t           ;; The one ClojureDart pin. Compose it with the build aliases:\n75\t           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n76\t           :clojuredart {:extra-deps {sonwh98/clojuredart\n77\t                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n78\t                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n79\t                                      }}\n80\t           :cljd {:extra-paths [\"test\"]\n81\t                  :main-opts [\"-m\" \"cljd.build\"]\n82\t                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n83\t           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n84\t                    :jvm-opts [\"-Dconfig=config.clj\"]\n85\t                    :main-opts [\"-m\" \"world.server\"]}\n86\t           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n87\t           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n88\t           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n89\t           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n90\t           ;; listed for audited portable namespaces only (its JVM namespaces\n91\t           ;; are selected away by :jolt reader branches, never loaded). No\n92\t           ;; generated Java parser classes, no JS/Dart roots, and no\n93\t           ;; dependency coordinate is fetched until a jolt-loaded namespace\n94\t           ;; needs one.\n95\t           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n96\t                  :replace-deps {}}\n97\t           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n98\t           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n99\t           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n100\t           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n101\t           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n102\t           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n103\t           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n104\t           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n105\t           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n106\t           :cljs-yin-repl\n107\t           {:extra-paths [\"test\" \"src/dev\"]\n108\t            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n109\t                         reagent/reagent {:mvn/version \"2.0.1\"}\n110\t                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n111\t            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n112\t           :fmt {:extra-paths [\"src/dev\"]\n113\t                 :exec-fn tasks/fix-all}\n114\t           ;; Build-time generation of the grammars-v4 Python3 parser.\n115\t           ;; The tool version must equal the antlr4-runtime above.\n116\t           :antlr-gen {:extra-paths [\"src/dev\"]\n117\t                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n118\t                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n119\t           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n120\t                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n121\t           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n122\t           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n123\t           ;; dependency. Backend deps/config are pinned separately once selected.\n124\t           :oracle {:extra-paths [\"src/dev\" \"test\"]\n125\t                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n126\t                                 ;; oracle backend: Datomic Local, in-process,\n127\t                                 ;; run in docker/oracle (dev-scope only)\n128\t                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n129\t           :dbg {:extra-paths [\"test\"]\n130\t                 :main-opts [\"-m\" \"debug-cljd\"]\n131\t                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n132\t           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n133\t           :cljd-yin-repl-build\n134\t           {:main-opts  [\"-m\" \"cljd.build\"]\n135\t            :cljd/opts  {:kind       :dart\n136\t                         :main       yin.repl.main\n137\t                         :output-dir \"build/yin-repl\"\n138\t                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n139\t           :dep-graph {:extra-paths [\"src/dev\"]\n140\t                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n141\t                       :main-opts [\"-m\" \"dep-graph\"]}}}\n142\t\n143\t\n144\t;; clj -X:fmt\n145\t\n146\t;; clj -M:nREPL\n147\t\n148\t;; clj -M:nREPL:server\n149\t;; clj -M:test\n150\t;; clj -M:test -n yin.vm-literal-test\n151\t;; clj -M:test -n yin.vm-continuation-test\n152\t;; clj -M:test -n yin.repl.python-antlr-test\n153\t;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n154\t;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n155\t\n156\t;; clj -X:clean\n157\t\n158\t;; npx shadow-cljs compile test && node target/node-tests.js\n159\t;; npx shadow-cljs release demo\n160\t;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n161\t;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n162\t;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n163\t;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n164\t\n165\t\n166\t;; mise exec -- clj -M:clojuredart:cljd watch \n167\t;; mise exec -- flutter run \n168\t\n169\t;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n170\t;; flutter emulators --launch Pixel_3_API_34\n171\t;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n172\t;; emulator -list-avds\n173\t\n174\t;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n175\t;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n176\t;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine"}
{"role":"tool","tool_call_id":"tool_yWeSDyNo82YOnvlTZ0q7qbH4","content":"1\t## ClojureDart Test Suite\n2\t\n3\tClojureDart tests are cross-compiled to Dart and executed using the Dart VM.\n4\t\n5\t### Running ClojureDart Tests\n6\t```bash\n7\tclj -M:clojuredart:cljd test            # all namespaces (sweeps the classpath)\n8\tclj -M:clojuredart:cljd test some.ns    # a subset\n9\t```\n10\tThe native `cljd.build` test command compiles every `.cljc`/`.cljd` namespace on the classpath, generates a `*_test.dart` entrypoint under `test/cljd-out/` for each namespace containing deftests, and runs them via `flutter test`. There is no allowlist: JVM-only namespaces are excluded at the reader level with `#?(:cljd nil :clj ...)` guards (a plain `#?(:clj ...)` does NOT exclude code from the ClojureDart build, because the host pass also matches `:clj`).\n11\t\n12\t---\n13\t\n14\t## ClojureScript Test Suite\n15\t\n16\tClojureScript tests are cross-compiled to JavaScript and executed using Node.js.\n17\t\n18\t### Running ClojureScript Tests\n19\t```bash\n20\t./bin/run-cljs-tests.sh\n21\t```\n22\tThis script uses `shadow-cljs` to compile the `:test` build and runs the resulting script with `node`.\n23\t\n24\t### Supported Test Build\n25\tThe configuration for the test build is defined in `shadow-cljs.edn` under the `:test` key.\n26\t\n27\t---\n28\t\n29\t## Yin VM Formal Test Suite\n30\t\n31\t## Overview\n32\t\n33\tFormal test suite using `clojure.test` for the Yin Virtual Machine implementation.\n34\t\n35\t## Test Files\n36\t\n37\t### [yin/vm_basic_test.clj](yin/vm_basic_test.clj)\n38\tCore functionality tests covering:\n39\t- ✅ **Literal evaluation** - Numbers and strings\n40\t- ✅ **Variable lookup** - Environment binding\n41\t- ✅ **Lambda/Closure creation** - Captures environment\n42\t- ✅ **Primitive addition** - Direct function application\n43\t- ✅ **Lambda addition** - User-defined functions\n44\t- ✅ **Increment with continuations** - Step-by-step execution\n45\t- ✅ **All arithmetic primitives** - `+`, `-`, `*`, `/`\n46\t- ✅ **All comparison operations** - `=`, `<`, `>`\n47\t\n48\t**Stats:** 8 tests, 16 assertions\n49\t\n50\t## Running Tests\n51\t\n52\t### Quick Run\n53\t```bash\n54\t./run_formal_tests.sh\n55\t```\n56\t\n57\t### Manual Run\n58\t```bash\n59\tclj -M:test -e \"(require 'yin.vm-basic-test) (clojure.test/run-tests 'yin.vm-basic-test)\"\n60\t```\n61\t\n62\t### From REPL\n63\t```clojure\n64\t(require 'yin.vm-basic-test)\n65\t(clojure.test/run-tests 'yin.vm-basic-test)\n66\t```\n67\t\n68\t### Run Specific Test\n69\t```clojure\n70\t(require 'yin.vm-basic-test)\n71\t(clojure.test/test-var #'yin.vm-basic-test/test-lambda-addition)\n72\t```\n73\t\n74\t## Test Structure\n75\t\n76\tEach test follows the standard `clojure.test` pattern:\n77\t\n78\t```clojure\n79\t(deftest test-name\n80\t  (testing \"Description\"\n81\t    (let [ast {...}\n82\t          result (walker/run (walker/make-state env) ast)]\n83\t      (is (= expected (:value result))\n84\t          \"Assertion message\"))))\n85\t```\n86\t\n87\t## Test Coverage\n88\t\n89\t### Covered Features\n90\t- ✅ CESK machine state transitions\n91\t- ✅ Literal value evaluation\n92\t- ✅ Variable environment lookup\n93\t- ✅ Closure creation and application\n94\t- ✅ Primitive function application\n95\t- ✅ Lambda function application\n96\t- ✅ Continuation-based evaluation\n97\t- ✅ All arithmetic operations\n98\t- ✅ All comparison operations\n99\t\n100\t### Known Limitations\n101\t- ⚠️ Nested lambda applications (requires continuation improvements)\n102\t- ⚠️ Nested arithmetic expressions within lambda bodies\n103\t- ⚠️ Conditional (if/then/else) - not yet tested\n104\t\n105\t## Configuration\n106\t\n107\tTests use the `:test` alias from `deps.edn`:\n108\t\n109\t```clojure\n110\t:test {:extra-paths [\"test\"]\n111\t       :extra-deps {io.github.cognitect-labs/test-runner\n112\t                    {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}}}\n113\t```\n114\t\n115\t## Test Output\n116\t\n117\tSuccessful run shows:\n118\t```\n119\tTesting yin.vm-basic-test\n120\t\n121\tRan 8 tests containing 16 assertions.\n122\t0 failures, 0 errors.\n123\t```\n124\t\n125\t## Integration with CI/CD\n126\t\n127\tThese tests can be integrated into CI/CD pipelines:\n128\t\n129\t```bash\n130\t# Exit with error code on test failure\n131\tclj -M:test -e \"(require 'yin.vm-basic-test) (let [result (clojure.test/run-tests 'yin.vm-basic-test)] (System/exit (if (clojure.test/successful? result) 0 1)))\"\n132\t```\n133\t\n134\t## Adding New Tests\n135\t\n136\t1. Create test file in `test/yin/`\n137\t2. Use namespace: `(ns yin.your-test (:require [clojure.test :refer [deftest is testing]] [yin.vm :as vm]))`\n138\t3. Add tests using `deftest`, `testing`, and `is`\n139\t4. Run with: `clj -M:test -e \"(require 'yin.your-test) (clojure.test/run-tests 'yin.your-test)\"`\n140\t\n141\t## Related Documentation\n142\t\n143\t- **Implementation:** [src/cljc/yin/vm.cljc](../src/cljc/yin/vm.cljc)\n144\t- **Informal Tests:** [test_add.clj](../test_add.clj), [test_simple_continuation.clj](../test_simple_continuation.clj)\n145\t- **Full Documentation:** [YIN_VM_TESTS.md](../YIN_VM_TESTS.md)"}
{"role":"tool","tool_call_id":"tool_CEFwIQADnwqQ8JvjWwuszZ50","content":"1\t(ns yang.typescript.antlr.linked-harness\n2\t  \"The linked profile's composition for the JavaScript tests (T1 step S5,\n3\t   docs/design/yang.typescript.md section 13): the namespace that requires\n4\t   this is the publisher of `js` and `jssp`, so it publishes each module\n5\t   once per process into one in-memory content store and serves them to\n6\t   every linked run over a `yin.vm.linker.interpreter` composition under\n7\t   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n8\t   evidence is `publish-module!`'s own `link-local` links, which\n9\t   `linked-prelude-test` asserts.\n10\t\n11\t   A linked run builds the program's task on one of the three vector VMs\n12\t   with a link pair, then runs the VM and serves the pair alternately\n13\t   until the VM stops blocking, as the REPL's drive does. The AST walker\n14\t   is not a backend here: its link of `js` is refused `:undeclared-free`\n15\t   until L-b.\"\n16\t  (:require [yin.vm.semantic.linearize :as sr-linearize]\n17\t            [yin.vm.semantic.derive :as derive]\n18\t            [dao.jing.mem :as mem]\n19\t            [yang.core.call :as call]\n20\t            [yang.typescript.antlr.prelude :as prelude]\n21\t            [yang.typescript.antlr.safepoint :as safepoint]\n22\t            [yin.vm :as vm]\n23\t            [yin.vm.data :as data]\n24\t            [yin.vm.debruijn-code :as dcode]\n25\t            [yin.vm.debruijn-register-code :as rcode]\n26\t            [yin.vm.debruijn.register :as rvm]\n27\t            [yin.vm.debruijn.stack :as dvm]\n28\t            [yin.vm.integer :as integer]\n29\t            [yin.vm.linker.interpreter :as link]\n30\t            [yin.vm.linker.publish :as publish]\n31\t            [yin.vm.module :as module]\n32\t            [yin.vm.semantic :as semantic]\n33\t            [yin.vm.test-utils :as tu]))\n34\t\n35\t\n36\t(def integer-limits\n37\t  \"The ordinary JavaScript composition's `integer` limits.\"\n38\t  {::integer/max-bits 100000, ::integer/max-digits 4300})\n39\t\n40\t\n41\t(defn registry\n42\t  \"The full host registry a linked JavaScript composition registers: the\n43\t   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n44\t   `stream` — the hook module `jssp` polls a signal stream, so the\n45\t   safepointed composition needs it even though `js` does not.\"\n46\t  ([] (registry integer-limits))\n47\t  ([limits]\n48\t   (-> (module/default-registry)\n49\t       module/register-cell-module\n50\t       (data/register-data-module {::data/max-items 1048576})\n51\t       (prelude/register-integer-module limits)\n52\t       module/register-stream-module)))\n53\t\n54\t\n55\t(def published\n56\t  \"`js` published once into its own content store:\n57\t   `{:store s :result r :address a :call-address ca}`. `yang.call` is\n58\t   published first so `js` pins its shared calling runtime.\"\n59\t  (delay\n60\t    (let [store (mem/create-content-mem)\n61\t          call-result (publish/publish-module! store (call/module-spec (registry)))\n62\t          result (publish/publish-module! store\n63\t                                          (prelude/module-spec (registry)\n64\t                                                               (:address call-result)))]\n65\t      {:store store,\n66\t       :result result,\n67\t       :address (:address result),\n68\t       :call-address (:address call-result)})))\n69\t\n70\t\n71\t(def published-jssp\n72\t  \"`jssp` published once into `js`'s own content store, which its pinned\n73\t   requirement already lives in: the same shape as `published`.\"\n74\t  (delay\n75\t    (let [{:keys [store address]} @published\n76\t          result (publish/publish-module!\n77\t                   store (safepoint/module-spec (registry) address))]\n78\t      {:store store, :result result, :address (:address result)})))\n79\t\n80\t\n81\t(defn source\n82\t  \"The serving composition over the published store: `name-env` defaults\n83\t   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test\n84\t   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n85\t  ([] (source {'js (:address @published),\n86\t               'yang.call (:call-address @published)}))\n87\t  ([name-env]\n88\t   (link/composition {:content-store (:store @published),\n89\t                      :name-env name-env,\n90\t                      :derivation :trusted})))\n91\t\n92\t\n93\t(defn safepoint-source\n94\t  \"The serving composition over the published modules: `jssp` requires\n95\t   `js`, and `js` requires `yang.call`.\"\n96\t  []\n97\t  (source {'js (:address @published),\n98\t           'jssp (:address @published-jssp),\n99\t           'yang.call (:call-address @published)}))\n100\t\n101\t\n102\t(defn publish-guest-module!\n103\t  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n104\t   own content store, where its pinned requirements already live:\n105\t   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n106\t   test may publish its own; publish imports bottom-up, the `deps` map\n107\t   naming each import's address.\"\n108\t  [spec]\n109\t  (publish/publish-module! (:store @published) spec))\n110\t\n111\t\n112\t(def backends\n113\t  \"Each vector backend's root task over a program AST and composition.\"\n114\t  {:semantic (fn [ast opts]\n115\t               (semantic/load-ast (semantic/create-vm opts)\n116\t                                  (vm/ast->datoms ast)\n117\t                                  vm/ast-contract)),\n118\t   :stack (fn [ast opts]\n119\t            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n120\t                           (assoc opts :contract vm/stack-contract))),\n121\t   :register (fn [ast opts]\n122\t               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n123\t                              (assoc opts :contract vm/register-contract)))})\n124\t\n125\t\n126\t(def continues\n127\t  \"Each vector backend's admission of the next top-level unit to a halted\n128\t   task, as `yin.repl` admits an input line: the task keeps its store,\n129\t   heap, module registry and module stores.\"\n130\t  {:semantic (fn [task ast]\n131\t               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n132\t   :stack (fn [task ast]\n133\t            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n134\t                  attached (dvm/attach-image task img vm/stack-contract)]\n135\t              (assoc attached\n136\t                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n137\t                     :frames [] :stack [] :continuation []\n138\t                     :halted? false :blocked? false :value nil))),\n139\t   :register (fn [task ast]\n140\t               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n141\t                     attached (rvm/attach-image task img vm/register-contract)\n142\t                     pc (rvm/absolute-pc attached\n143\t                                         [(rcode/register-hash img) 0])\n144\t                     body (some #(when (= pc (:start %)) %)\n145\t                                (:bodies (:segment attached)))]\n146\t                 (assoc attached\n147\t                        :pc pc :frames [] :continuation []\n148\t                        :registers (vec (repeat (:registers body) nil))\n149\t                        :halted? false :blocked? false :value nil)))})\n150\t\n151\t\n152\t(defn composition\n153\t  \"A task's composition over `modules` and the link `pair`.\"\n154\t  [modules pair]\n155\t  {:make-stream tu/make-stream,\n156\t   :capability-secret tu/secret,\n157\t   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n158\t   :primitives vm/primitives,\n159\t   :modules modules,\n160\t   :link-request (:requests pair),\n161\t   :link-response (:responses pair)})\n162\t\n163\t\n164\t(defn drive\n165\t  \"Run `task` and serve `pair` from `src` alternately until the task\n166\t   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n167\t  [task pair src]\n168\t  (loop [task (vm/run task)\n169\t         pair pair\n170\t         i 0]\n171\t    (if (and (vm/blocked? task) (< i 40))\n172\t      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n173\t        (recur (vm/run task) pair (inc i)))\n174\t      [task pair])))\n175\t\n176\t\n177\t(defn run-linked\n178\t  \"The finished task of the linked program `ast` on `backend`. Options:\n179\t   `:modules` (default the full registry), `:link-source` (default the\n180\t   `:trusted` composition over `js`), and `:prep`, applied to the task\n181\t   before it runs (a composition handing the task its streams, binding\n182\t   `jssp`'s signal stream among them). A refused link throws as the task's\n183\t   own error.\"\n184\t  ([backend ast] (run-linked backend ast {}))\n185\t  ([backend ast {:keys [modules link-source prep]}]\n186\t   (let [pair (link/make-pair)\n187\t         task ((get backends backend)\n188\t               ast\n189\t               (composition (or modules (registry)) pair))]\n190\t     (first (drive (if prep (prep task) task)\n191\t                   pair (or link-source (source)))))))\n192\t\n193\t\n194\t(defn runners-under\n195\t  \"Each vector VM's runner of a linked program over `modules`: the\n196\t   program's value.\"\n197\t  [modules]\n198\t  (into {}\n199\t        (map (fn [k]\n200\t               [k (fn [ast]\n201\t                    (vm/value (run-linked k ast {:modules modules})))]))\n202\t        (keys backends)))\n203\t\n204\t\n205\t(def runners\n206\t  \"The linked runners under the ordinary limits.\"\n207\t  (runners-under (registry)))"}
{"role":"tool","tool_call_id":"tool_Kog90mfVK7i3J2qTmE7NzpSJ","content":"1\t(ns yang.typescript.antlr.safepoint-test\n2\t  \"T1 step S5, bundled profile on the JVM from source: the lowering's site\n3\t   marks reach the side table, the `yang.safepoint` stage inserts the\n4\t   `js.sp` hooks, a no-op hook prelude leaves the program's output as the\n5\t   naive one prints it, and a pending signal ends a `while (true)` loop with\n6\t   the guest value `Interrupt` uncaught: a `try`/`catch` around the loop\n7\t   does not catch it. The linked twin of these runs is in\n8\t   `yang.typescript.antlr.linked-prelude-test`.\"\n9\t  (:require\n10\t    [clojure.test :refer [deftest is testing]]\n11\t    [dao.stream :as stream]\n12\t    [dao.test-slow :as slow]\n13\t    [yang.safepoint :as safepoint]\n14\t    [yang.typescript.antlr.cst :as cst]\n15\t    [yang.typescript.antlr.lower :as lower]\n16\t    [yang.typescript.antlr.prelude :as prelude]\n17\t    [yang.typescript.antlr.render :as render]\n18\t    [yang.typescript.antlr.safepoint :as hooks]\n19\t    [yin.vm :as vm]\n20\t    [yin.vm.data :as data]\n21\t    [yin.vm.debruijn.register :as rvm]\n22\t    [yin.vm.debruijn.stack :as dvm]\n23\t    [yin.vm.encoder :as encoder]\n24\t    [yin.vm.engine :as engine]\n25\t    [yin.vm.integer :as integer]\n26\t    [yin.vm.module :as module]\n27\t    [yin.vm.semantic :as semantic]\n28\t    [yin.vm.semantic.derive :as derive]\n29\t    [yin.vm.semantic.linearize :as sr-linearize]\n30\t    [yin.vm.test-utils :as tu]))\n31\t\n32\t\n33\t(def ^:private worker (cst/make-worker :ts))\n34\t\n35\t\n36\t(defn- parse\n37\t  [src]\n38\t  (let [pk (cst/parse-source worker [:unit 0] src)]\n39\t    (is (= :yang.cst/ok (:yang.cst/outcome pk)) src)\n40\t    pk))\n41\t\n42\t\n43\t(def ^:private programs\n44\t  {:while-true \"while (true) { }\",\n45\t   :for-in (str \"const o = {a: 1, b: 2}; let t = ''; \"\n46\t                \"for (const k in o) { t += k; } console.log(t);\"),\n47\t   :for-in-forever \"const o = {a: 1}; while (true) { for (const k in o) { } }\",\n48\t   :caught \"try { while (true) { } } catch (e) { console.log('caught'); }\",\n49\t   :class-sites (str \"class A { constructor() { while (true) { } } m() { } \"\n50\t                     \"x = 1; static { } }\"),\n51\t   :ctor-loop \"class A { constructor() { while (true) { } } } new A();\",\n52\t   :ctor-loop-caught (str \"class A { constructor() { while (true) { } } } \"\n53\t                          \"try { new A(); } catch (e) { console.log('caught'); }\"),\n54\t   :method-loop \"class A { m() { while (true) { } } } new A().m();\",\n55\t   :field-loop (str \"class A { x = (() => { while (true) { } })(); } \"\n56\t                    \"new A();\"),\n57\t   :static-loop \"class A { static { while (true) { } } }\",\n58\t   :derived-loop (str \"class A { } class B extends A { constructor() { \"\n59\t                      \"super(); while (true) { } } } new B();\"),\n60\t   :def-and-while (str \"function f(n) { return n + 1; } var i = 0; \"\n61\t                       \"while (i < 5) { i = f(i); } console.log(i);\")})\n62\t\n63\t\n64\t(def ^:private opts\n65\t  {:make-stream tu/make-stream,\n66\t   :capability-secret tu/secret,\n67\t   :primitives vm/primitives,\n68\t   :modules (-> (module/empty-registry)\n69\t                module/register-cell-module\n70\t                (data/register-data-module {::data/max-items 1048576})\n71\t                (prelude/register-integer-module\n72\t                  {::integer/max-bits 100000, ::integer/max-digits 4300})\n73\t                module/register-stream-module\n74\t                prelude/admit)})\n75\t\n76\t\n77\t(def ^:private load-semantic-ast\n78\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n79\t\n80\t\n81\t(def ^:private runners\n82\t  \"Each takes an AST and `prep`, applied to the VM before it runs.\"\n83\t  {:ast-walker (fn [ast prep] (vm/eval (prep (tu/create-vm opts)) ast)),\n84\t   :semantic (fn [ast prep]\n85\t               (vm/run (load-semantic-ast (prep (semantic/create-vm opts))\n86\t                                          (vm/ast->datoms ast)))),\n87\t   :stack (fn [ast prep]\n88\t            (vm/run (prep (dvm/create-vm\n89\t                            (:image (derive/stack-image\n90\t                                      (:vector (sr-linearize/project ast))))\n91\t                            (assoc opts :contract vm/stack-contract))))),\n92\t   :register (fn [ast prep]\n93\t               (vm/run (prep (rvm/create-vm\n94\t                               (derive/register-image\n95\t                                 (:vector (sr-linearize/project ast)))\n96\t                               (assoc opts :contract vm/register-contract)))))})\n97\t\n98\t\n99\t(defn- with-signals\n100\t  \"A `prep` handing the task a signal stream holding `signals`.\"\n101\t  [signals]\n102\t  (fn [vm]\n103\t    (let [handle (tu/new-stream 8)]\n104\t      (doseq [s signals] (stream/append! handle s))\n105\t      (let [[ref vm] (engine/attach-resource vm handle)]\n106\t        (assoc-in vm [:store hooks/signals-key] ref)))))\n107\t\n108\t\n109\t(defn- outcome\n110\t  \"A finished run as `[halted? blocked? rendered-value]`.\"\n111\t  [vm]\n112\t  [(vm/halted? vm) (vm/blocked? vm) (render/output (vm/value vm))])\n113\t\n114\t\n115\t(defn- on-every-vm\n116\t  [ast prep]\n117\t  (into {}\n118\t        (map (fn [[k run]]\n119\t               [k (try (outcome (run ast prep))\n120\t                       (catch Exception e [:thrown (ex-message e)]))]))\n121\t        runners))\n122\t\n123\t\n124\t(defn- envelope\n125\t  [pk]\n126\t  (let [[_ [[port e]]] (lower/lower-transform {} pk)]\n127\t    (assert (= :program port))\n128\t    e))\n129\t\n130\t\n131\t(defn- derive*\n132\t  [pk profile]\n133\t  (let [projected (encoder/project (envelope pk))\n134\t        {:keys [envelope record]} (safepoint/derive-envelope projected profile\n135\t                                                             :test/derived)]\n136\t    {:projected projected, :derived envelope, :record record}))\n137\t\n138\t\n139\t(defn- tree-of\n140\t  [e]\n141\t  (nth (:yin/batch e) (:yin/root e)))\n142\t\n143\t\n144\t(defn- derived-ast\n145\t  [pk profile]\n146\t  (vm/semantic-bytecode->ast (tree-of (:derived (derive* pk profile)))))\n147\t\n148\t\n149\t(defn- every=\n150\t  [expected results]\n151\t  (doseq [[k result] results]\n152\t    (is (= expected result) (str k))))\n153\t\n154\t\n155\t(deftest marks-reach-the-side-table-test\n156\t  (let [{:keys [projected]} (derive* (parse (:def-and-while programs))\n157\t                                     hooks/profile)\n158\t        marks (map #(nth % 4)\n159\t                   (filter #(= :yang/site (nth %  3))\n160\t                           (:yin/frontend-metadata projected)))\n161\t        kinds (frequencies (map #(if (vector? %) (first %) %) marks))]\n162\t    (is (= {:call 1, :loop 1} kinds))\n163\t    (is (some #(and (vector? %) (= \"f\" (second %))) marks)\n164\t        \"the function's mark carries its name\")\n165\t    (testing \"every derived row validates\"\n166\t      (is (nil? (vm/validate-rows\n167\t                  (tree-of (:derived (derive* (parse (:def-and-while programs))\n168\t                                              hooks/profile)))))))))\n169\t\n170\t\n171\t(deftest class-sites-test\n172\t  (let [{:keys [projected]} (derive* (parse (:class-sites programs))\n173\t                                     hooks/profile)\n174\t        marks (map #(nth % 4)\n175\t                   (filter #(= :yang/site (nth % 3))\n176\t                           (:yin/frontend-metadata projected)))\n177\t        kinds (frequencies (map #(if (vector? %) (first %) %) marks))\n178\t        names (set (keep #(when (and (vector? %) (= :call (first %))) (second %))\n179\t                         marks))]\n180\t    (is (= {:call 4, :loop 1} kinds)\n181\t        \"constructor, method, field initializer and static block are call\n182\t         sites; the constructor's loop is a loop site\")\n183\t    (is (= #{\"A\" \"m\" \"x\" \"static\"} names)\n184\t        \"each call site carries its element's name\")\n185\t    (testing \"every derived row validates\"\n186\t      (is (nil? (vm/validate-rows\n187\t                  (tree-of (:derived (derive* (parse (:class-sites programs))\n188\t                                              hooks/profile)))))))))\n189\t\n190\t\n191\t(deftest for-in-loop-site-test\n192\t  (let [{:keys [projected]} (derive* (parse (:for-in programs)) hooks/profile)\n193\t        marks (map #(nth % 4)\n194\t                   (filter #(= :yang/site (nth % 3))\n195\t                           (:yin/frontend-metadata projected)))\n196\t        kinds (frequencies (map #(if (vector? %) (first %) %) marks))]\n197\t    (is (= 1 (:loop kinds)) \"the for-in loop lambda carries one :loop site\")))\n198\t\n199\t\n200\t(deftest insertion-is-deterministic-test\n201\t  (let [pk (parse (:def-and-while programs))]\n202\t    (is (= (derive* pk hooks/profile) (derive* pk hooks/profile)))))\n203\t\n204\t\n205\t(defn- interrupt\n206\t  []\n207\t  (testing \"while (true) with one signal appended ends Interrupt, uncaught\"\n208\t    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n209\t            (on-every-vm (hooks/program hooks/uast\n210\t                                        (derived-ast (parse (:while-true programs))\n211\t                                                     hooks/profile))\n212\t                         (with-signals [2]))))\n213\t  (testing \"a try/catch around the loop does not catch it\"\n214\t    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n215\t            (on-every-vm (hooks/program hooks/uast\n216\t                                        (derived-ast (parse (:caught programs))\n217\t                                                     hooks/profile))\n218\t                         (with-signals [2])))))\n219\t\n220\t\n221\t(deftest ^:slow interrupt-test\n222\t  (slow/guard \"interrupt-test\" interrupt))\n223\t\n224\t\n225\t(defn- no-park\n226\t  []\n227\t  (testing \"with an empty signal stream the derived program finishes without\n228\t            blocking and prints what the naive one prints\"\n229\t    (every= [true false {:js/out [\"5\"], :js/uncaught nil}]\n230\t            (on-every-vm (hooks/program hooks/uast\n231\t                                        (derived-ast (parse (:def-and-while programs))\n232\t                                                     hooks/profile))\n233\t                         (with-signals [])))))\n234\t\n235\t\n236\t(defn- for-in-interrupt\n237\t  []\n238\t  (testing \"an interrupt inside a for-in loop ends Interrupt, uncaught\"\n239\t    (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n240\t            (on-every-vm (hooks/program hooks/uast\n241\t                                        (derived-ast (parse (:for-in-forever programs))\n242\t                                                     hooks/profile))\n243\t                         (with-signals [2])))))\n244\t\n245\t\n246\t(deftest ^:slow for-in-interrupt-test\n247\t  (slow/guard \"for-in-interrupt-test\" for-in-interrupt))\n248\t\n249\t\n250\t(defn- class-interrupt\n251\t  []\n252\t  (doseq [k [:ctor-loop :ctor-loop-caught :method-loop :field-loop\n253\t             :static-loop :derived-loop]]\n254\t    (testing (name k)\n255\t      (every= [true false {:js/out [], :js/uncaught \"Interrupt: interrupted\"}]\n256\t              (on-every-vm (hooks/program hooks/uast\n257\t                                          (derived-ast (parse (get programs k))\n258\t                                                       hooks/profile))\n259\t                           (with-signals [2]))))))\n260\t\n261\t\n262\t(deftest ^:slow class-interrupt-test\n263\t  (slow/guard \"class-interrupt-test\" class-interrupt))\n264\t\n265\t\n266\t(deftest ^:slow no-park-test\n267\t  (slow/guard \"no-park-test\" no-park))\n268\t\n269\t\n270\t(defn- transparency\n271\t  []\n272\t  (testing \"under no-op hooks the derived program prints what the naive\n273\t            program prints\"\n274\t    (let [pk (parse (:def-and-while programs))\n275\t          naive (on-every-vm (tree-of (envelope pk)) (with-signals []))\n276\t          noop (on-every-vm (hooks/program hooks/noop-uast\n277\t                                           (derived-ast pk hooks/profile))\n278\t                            (with-signals []))]\n279\t      (every= [true false {:js/out [\"5\"], :js/uncaught nil}] naive)\n280\t      (is (= naive noop)))))\n281\t\n282\t\n283\t(deftest ^:slow transparency-test\n284\t  (slow/guard \"transparency-test\" transparency))"}
{"role":"tool","tool_call_id":"tool_yAiu306KMimBY9WL23XtE6HV","content":"1\t(ns yang.php.antlr.linked-harness\n2\t  \"The linked profile's composition for the PHP tests (P6, docs/design/\n3\t   yang.php.md section 11): the namespace that requires this is the\n4\t   publisher of `php`, so it publishes the module once per process into one\n5\t   in-memory content store, publishes a fixture's non-entry units beside it\n6\t   bottom-up, and serves them to the entry unit's run over a\n7\t   `yin.vm.linker.interpreter` composition under `:trusted` derivation.\n8\t\n9\t   A linked run builds the entry unit's task on one of the three vector VMs\n10\t   with a link pair, then runs the VM and serves the pair alternately until\n11\t   the VM stops blocking, as the REPL's drive does. The AST walker is not a\n12\t   backend here: its link of `php` is refused until L-b.\"\n13\t  (:require\n14\t    [dao.jing.mem :as mem]\n15\t    [yang.core.call :as call]\n16\t    [yang.php.antlr.lower :as lower]\n17\t    [yang.php.antlr.portable-harness :as portable]\n18\t    [yang.php.antlr.prelude :as prelude]\n19\t    [yang.php.antlr.publication :as publication]\n20\t    [yin.vm :as vm]\n21\t    [yin.vm.debruijn.register :as rvm]\n22\t    [yin.vm.debruijn.stack :as dvm]\n23\t    [yin.vm.linker.interpreter :as link]\n24\t    [yin.vm.linker.publish :as publish]\n25\t    [yin.vm.semantic :as semantic]\n26\t    [yin.vm.semantic.derive :as derive]\n27\t    [yin.vm.semantic.linearize :as sr-linearize]\n28\t    [yin.vm.test-utils :as tu]))\n29\t\n30\t\n31\t(defn registry\n32\t  \"The host registry a linked PHP composition registers: the `require`\n33\t   handlers, then `cell`, `data` and `integer` under the portable limits.\"\n34\t  []\n35\t  (portable/linked-registry))\n36\t\n37\t\n38\t(def published\n39\t  \"`yang.call` and `php` published once into their own content store.\"\n40\t  (delay\n41\t    (let [store (mem/create-content-mem)\n42\t          call-result (publish/publish-module! store (call/module-spec (registry)))\n43\t          result (publish/publish-module! store (prelude/module-spec (registry)\n44\t                                                                     (:address call-result)))]\n45\t      {:store store,\n46\t       :result result,\n47\t       :address (:address result),\n48\t       :call-address (:address call-result)})))\n49\t\n50\t\n51\t(defn publish-units!\n52\t  \"`units` (`[{:name path :packet p :strict-types b}]`) published into\n53\t   `php`'s own content store, where its pinned requirement already lives:\n54\t   `publication/publish-units!`'s answer.\"\n55\t  [units]\n56\t  (publication/publish-units! (:store @published) (registry) (:address @published) units))\n57\t\n58\t\n59\t(defn source\n60\t  \"The serving composition over the published store: `name-env` names `php`\n61\t   and each published module, derivation `:trusted`, the test being the\n62\t   publisher.\"\n63\t  [name-env]\n64\t  (link/composition {:content-store (:store @published),\n65\t                     :name-env (merge {'php (:address @published),\n66\t                                       'yang.call (:call-address @published)} name-env),\n67\t                     :derivation :trusted}))\n68\t\n69\t\n70\t(def backends\n71\t  \"Each vector backend's root task over a program AST and composition.\"\n72\t  {:semantic (fn [ast opts]\n73\t               (semantic/load-ast (semantic/create-vm opts)\n74\t                                  (vm/ast->datoms ast)\n75\t                                  vm/ast-contract)),\n76\t   :stack (fn [ast opts]\n77\t            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n78\t                           (assoc opts :contract vm/stack-contract))),\n79\t   :register (fn [ast opts]\n80\t               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n81\t                              (assoc opts :contract vm/register-contract)))})\n82\t\n83\t\n84\t(defn composition\n85\t  \"A task's composition over `modules` and the link `pair`.\"\n86\t  [modules pair]\n87\t  {:make-stream tu/make-stream,\n88\t   :capability-secret tu/secret,\n89\t   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n90\t   :primitives vm/primitives,\n91\t   :modules modules,\n92\t   :link-request (:requests pair),\n93\t   :link-response (:responses pair)})\n94\t\n95\t\n96\t(defn drive\n97\t  \"Run `task` and serve `pair` from `src` alternately until the task stops\n98\t   blocking, at most 80 rounds. Returns `[task pair]`.\"\n99\t  [task pair src]\n100\t  (loop [task (vm/run task)\n101\t         pair pair\n102\t         i 0]\n103\t    (if (and (vm/blocked? task) (< i 80))\n104\t      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n105\t        (recur (vm/run task) pair (inc i)))\n106\t      [task pair])))\n107\t\n108\t\n109\t(defn run-linked\n110\t  \"The finished task of the linked program `ast` on `backend`, served from\n111\t   `src`. A refused link surfaces as the program's own diagnostics.\"\n112\t  [backend ast src]\n113\t  (let [pair (link/make-pair)\n114\t        task ((get backends backend) ast (composition (registry) pair))]\n115\t    (first (drive task pair src))))\n116\t\n117\t\n118\t(defn name-env\n119\t  \"The name environment naming every published module of `result`\n120\t   (`publish-units!`'s answer): module symbol to address.\"\n121\t  [result]\n122\t  (merge (into {} (map (fn [[path address]] [(lower/path-module-symbol path) address]))\n123\t               (:addresses result))\n124\t         (:bundles result)))\n125\t\n126\t\n127\t(defn run-fixture\n128\t  \"`{backend value}` for the multi-unit fixture `units` (`{path packet}`,\n129\t   the entry unit `main`, default `lower/entry-path`) on the three vector\n130\t   VMs: the non-entry units are published bottom-up, the entry unit\n131\t   lowered `:linked` and run. `value` is `run-main`'s map.\"\n132\t  ([units] (run-fixture units lower/entry-path {}))\n133\t  ([units main opts]\n134\t   (let [entry (get units main)\n135\t         others (cond-> (mapv (fn [[path packet]] {:name path, :packet packet})\n136\t                              (dissoc units main))\n137\t                  (:class-map opts) (conj (assoc (:class-map opts) :name lower/classmap-name)))\n138\t         result (publish-units! others)]\n139\t     (when-not (= :ok (:status result))\n140\t       (throw (ex-info \"fixture units failed to publish\" {:result result})))\n141\t     (let [{:keys [ast warnings]}\n142\t           (lower/lower-program entry\n143\t                                (merge {:prelude :linked,\n144\t                                        :path main,\n145\t                                        :paths (when (:computed? opts) (keys (:addresses result)))}\n146\t                                       (cond-> (dissoc opts :computed? :src)\n147\t                                         (:class-map opts) (assoc :class-map true))))\n148\t           src (or (:src opts) (source (name-env result)))]\n149\t       {:warnings warnings,\n150\t        :values (into {}\n151\t                      (map (fn [k] [k (vm/value (run-linked k ast src))]))\n152\t                      (keys backends))}))))"}
{"role":"tool","tool_call_id":"tool_DgbXK5mvfr4aCqwsyzQP1u6l","content":"1\t(ns yang.php.antlr.e2e-harness\n2\t  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n3\t   program envelope -> the bundled program on each of the four VMs. Output\n4\t   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n5\t   here at the boundary.\"\n6\t  (:require\n7\t    [dao.host.text :as text]\n8\t    [dao.stream :as stream]\n9\t    [yang.php.antlr.cst :as cst]\n10\t    [yang.php.antlr.lower :as lower]\n11\t    [yang.php.antlr.portable-harness :as portable]\n12\t    [yin.vm :as vm]\n13\t    [yin.vm.debruijn.register :as rvm]\n14\t    [yin.vm.debruijn.stack :as dvm]\n15\t    [yin.vm.semantic :as semantic]\n16\t    [yin.vm.semantic.derive :as derive]\n17\t    [yin.vm.semantic.linearize :as sr-linearize]\n18\t    [yin.vm.test-utils :as tu]))\n19\t\n20\t\n21\t(defn host-registry\n22\t  \"The registry the PHP compositions run over.\"\n23\t  []\n24\t  (portable/host-registry))\n25\t\n26\t\n27\t(def ^:private base-opts\n28\t  {:make-stream tu/make-stream,\n29\t   :capability-secret tu/secret,\n30\t   :primitives vm/primitives})\n31\t\n32\t\n33\t(def ^:private load-semantic\n34\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n35\t\n36\t\n37\t(defn lower-program\n38\t  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n39\t   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\"\n40\t  [source]\n41\t  (let [cst-log (tu/new-memory-log)\n42\t        program (tu/new-memory-log)\n43\t        diagnostics (tu/new-memory-log)]\n44\t    (stream/append! cst-log (cst/parse-source source))\n45\t    (lower/step-stage (lower/open-stage cst-log program diagnostics\n46\t                                        {:medium lower/program-medium}))\n47\t    (let [{warnings true, problems false}\n48\t          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n49\t      (if (seq problems)\n50\t        {:diagnostics problems}\n51\t        (let [{:yin/keys [batch root]} (first (tu/drain program))]\n52\t          {:ast (nth batch root), :warnings (vec warnings)})))))\n53\t\n54\t\n55\t(defn packet->form\n56\t  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n57\t   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n58\t   `portable-harness/packet`.\"\n59\t  [{:yang.cst/keys [root nodes]}]\n60\t  (letfn [(form\n61\t            [id]\n62\t            (let [{:keys [kind rule type text children]} (nth nodes id)]\n63\t              (if (= :token kind)\n64\t                [type text]\n65\t                (into [(keyword rule)] (map form) children))))]\n66\t    (form root)))\n67\t\n68\t\n69\t(defn latin1->text\n70\t  \"The UTF-8 text of the byte carrier `s`.\"\n71\t  [s]\n72\t  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n73\t\n74\t\n75\t(defn render\n76\t  \"The text a unit prints: its output, then, for an uncaught error, the\n77\t   fatal line (no path, plan section 3.9).\"\n78\t  [{:php/keys [out uncaught]}]\n79\t  (str (latin1->text out)\n80\t       (when uncaught\n81\t         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n82\t\n83\t\n84\t(defn run-vms\n85\t  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n86\t   `[:thrown message]`.\"\n87\t  [registry ast]\n88\t  (let [opts (assoc base-opts :modules registry)\n89\t        session (tu/make-observer-session (tu/create-vm {:modules registry}))\n90\t        datoms (vec (vm/ast->datoms ast))\n91\t        projected #(:vector (sr-linearize/project ast))\n92\t        attempt (fn [f]\n93\t                  (try (render (f))\n94\t                       (catch Exception e [:thrown (ex-message e)])))]\n95\t    (tu/queue-ast! session ast)\n96\t    {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n97\t     :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n98\t                                                          datoms)))),\n99\t     :stack (attempt #(vm/value (vm/run (dvm/create-vm\n100\t                                          (:image (derive/stack-image (projected)))\n101\t                                          (assoc opts :contract vm/stack-contract))))),\n102\t     :register (attempt #(vm/value (vm/run (rvm/create-vm\n103\t                                             (derive/register-image (projected))\n104\t                                             (assoc opts\n105\t                                                    :contract\n106\t                                                    vm/register-contract)))))}))\n107\t\n108\t\n109\t(defn run-php\n110\t  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`.\"\n111\t  [source]\n112\t  (let [{:keys [ast diagnostics]} (lower-program source)]\n113\t    (if diagnostics {:diagnostics diagnostics} (run-vms (host-registry) ast))))\n114\t\n115\t\n116\t(defn run-walker\n117\t  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n118\t  [source]\n119\t  (let [{:keys [ast diagnostics]} (lower-program source)]\n120\t    (if diagnostics\n121\t      {:diagnostics diagnostics}\n122\t      (let [registry (host-registry)\n123\t            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n124\t        (tu/queue-ast! session ast)\n125\t        (try (render (vm/value (:consumer (tu/run-session session))))\n126\t             (catch Exception e [:thrown (ex-message e)]))))))\n127\t\n128\t\n129\t(defn run-raw\n130\t  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, on the AST walker.\"\n131\t  [source]\n132\t  (let [{:keys [ast diagnostics]} (lower-program source)]\n133\t    (if diagnostics\n134\t      {:diagnostics diagnostics}\n135\t      (let [session (tu/make-observer-session\n136\t                      (tu/create-vm {:modules (host-registry)}))]\n137\t        (tu/queue-ast! session ast)\n138\t        (vm/value (:consumer (tu/run-session session)))))))"}
{"role":"tool","tool_call_id":"tool_TCh5m05B2u3S4KZqN3LvcHh1","content":"1\t(ns yang.typescript.antlr.safepoint\n2\t  \"The `jssp` safepoint hook prelude (docs/design/yang.typescript.md\n3\t   section 13; T1 plan section 8): `js.sp/loop` and `js.sp/call` for the\n4\t   bundled profile and the linked `jssp` module. Universal AST, like the\n5\t   base prelude; the `yang.safepoint` stage only places `(js.sp/loop)` and\n6\t   `(js.sp/call)` at the `:loop` and `:call` sites the lowering marks, and\n7\t   what they mean is written here.\n8\t\n9\t   Signals. The composition hands the task a signal stream, a sealed\n10\t   reference in the store under `signals-key`; a host adapter appends one\n11\t   plain value per delivered signal. Each hook reads it with `stream/poll!`,\n12\t   which answers `:dao.stream/blocked` rather than parking, so a program\n13\t   with no signal pending never waits at a safepoint. On a signal (or a\n14\t   gap: values were lost, so at least one arrived) the hook delivers an\n15\t   interrupt: it unwinds the handler stack to its outermost frame, the one\n16\t   `js/run-main` installs, running every `finally` thunk on the way, and\n17\t   throws the guest value `js.sp/interrupt` builds (an Error object named\n18\t   `Interrupt`) through `js/throw` from there. No guest `catch` frame is\n19\t   left to see it, so a `try`/`catch` around the loop does not catch it;\n20\t   the run ends with it uncaught. Delivery is not journalled.\n21\t\n22\t   There is no depth accounting in T1: JavaScript has no RecursionError by\n23\t   default (section 13), so `js.sp/call` is a poll only, and there is no\n24\t   `:return` hook.\n25\t\n26\t   Two profiles, one source. `uast` is the bundled hook prelude: it loads\n27\t   before the base prelude and may not touch a base definition while\n28\t   loading, so it allocates only the signal cursor, and the hooks name base\n29\t   keys only inside their bodies. `module-uast` is the same definition list\n30\t   as the linker module `jssp`, which requires `js`, inverting the bundled\n31\t   load order: its install child defines lambdas only, for a cursor is\n32\t   runtime state a lift refuses, and a module closure cannot read the\n33\t   task's ambient signal stream; the linked wrapper passes the stream's\n34\t   reference to `(jssp/attach! signals)`, which mints the cursor. The hooks\n35\t   reach the base prelude through its exports (`js/unwind-to`, `js/throw`,\n36\t   `js/global-get`, ...), for `js.rt/*` is an internal store key invisible\n37\t   across a module boundary. Every key this prelude defines is in `js.sp`.\"\n38\t  (:require\n39\t    [yang.core.prelude :as core]\n40\t    [yang.core.uast :as u]\n41\t    [yang.typescript.antlr.prelude :as prelude]))\n42\t\n43\t\n44\t(def profile\n45\t  \"The `yang.safepoint` profile this prelude implements under the bundled\n46\t   prelude: site kind -> hook.\"\n47\t  {:loop 'js.sp/loop, :call 'js.sp/call})\n48\t\n49\t\n50\t(def linked-profile\n51\t  \"The `yang.safepoint` profile under the linked prelude: the hooks are the\n52\t   `jssp` module's exports, so `A'` applies `jssp/loop` and its sibling and\n53\t   a run without the module fails closed on the unresolved hook name.\"\n54\t  {:loop 'jssp/loop, :call 'jssp/call})\n55\t\n56\t\n57\t(def signals-key\n58\t  \"The store key the composition binds the signal stream's reference to.\"\n59\t  'js.sp/signals)\n60\t\n61\t\n62\t(def module-name\n63\t  \"The linker module the hook prelude is published as.\"\n64\t  'jssp)\n65\t\n66\t\n67\t(def host-names\n68\t  \"Module exports this prelude calls: the stream module's `cursor` and\n69\t   `poll!`.\"\n70\t  '#{stream/cursor stream/poll!})\n71\t\n72\t\n73\t(def function-definitions\n74\t  \"The single definition list, `[store-key form]` in definition order: every\n75\t   hook function, then `attach!`. Defining them runs nothing. Both emitters\n76\t   read it; the tests assert the module's shape against it.\"\n77\t  '[[js.sp/interrupt\n78\t     ;; the value an interrupt throws: an Error named Interrupt, built from\n79\t     ;; the exported intrinsics (the error prototype is `Error.prototype`)\n80\t     (fn []\n81\t       (let [e (js/make-error\n82\t                 (js/get-prop (js/global-get {:js/str \"Error\"})\n83\t                              {:js/str \"prototype\"})\n84\t                 {:js/str \"interrupted\"})]\n85\t         (do (js/define-own! e\n86\t                             {:js/str \"name\"}\n87\t                             (js/slot {:js/str \"Interrupt\"} true false true))\n88\t             e)))]\n89\t    [js.sp/deliver\n90\t     ;; down to the outermost handler frame (the run's own), then throw:\n91\t     ;; the guest handlers above it never see the interrupt\n92\t     (fn [sig] (do (js/unwind-to 1) (js/throw (js.sp/interrupt))))]\n93\t    [js.sp/poll\n94\t     (fn []\n95\t       (let [s (stream/poll! js.sp/cursor)]\n96\t         (if (= s :dao.stream/blocked)\n97\t           :js/undefined\n98\t           (if (nil? s) :js/undefined (js.sp/deliver s)))))]\n99\t    [js.sp/loop (fn [] (js.sp/poll))]\n100\t    [js.sp/call (fn [] (js.sp/poll))]\n101\t    [js.sp/attach!\n102\t     ;; the linked wrapper's call: a module closure cannot read the task's\n103\t     ;; ambient signal stream, so the wrapper passes its reference, and the\n104\t     ;; cursor it mints is runtime state, never install-time state.\n105\t     ;; Idempotent, like `js/init!`\n106\t     (fn [signals]\n107\t       (if (= js.sp/cursor :js/uninit)\n108\t         (do (yin/def (quote js.sp/cursor) (stream/cursor signals))\n109\t             :js/undefined)\n110\t         :js/undefined))]])\n111\t\n112\t\n113\t(def ^:private state-definitions\n114\t  \"The bundled profile's runtime state, allocated while loading: the signal\n115\t   cursor, nothing else.\"\n116\t  '[[js.sp/cursor (stream/cursor js.sp/signals)]])\n117\t\n118\t\n119\t(defn- definitions->uast\n120\t  [defs]\n121\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n122\t\n123\t\n124\t(def uast\n125\t  \"The bundled hook prelude: functions, then the signal cursor.\"\n126\t  (u/mark-tails (u/then (definitions->uast function-definitions)\n127\t                        (definitions->uast state-definitions))))\n128\t\n129\t\n130\t(def noop-uast\n131\t  \"Hooks that do nothing: the derived program under them is the naive one.\"\n132\t  (u/mark-tails (definitions->uast '[[js.sp/loop (fn [] :js/undefined)]\n133\t                                     [js.sp/call (fn [] :js/undefined)]])))\n134\t\n135\t\n136\t(defn program\n137\t  \"The bundled derived run's tree: `hooks` (a hook prelude), then the derived\n138\t   program `ast`.\"\n139\t  [hooks ast]\n140\t  (u/then hooks ast))\n141\t\n142\t\n143\t(defn linked-program\n144\t  \"The linked safepointed run's tree: `js` required and initialized, `jssp`\n145\t   required, the signal stream the composition bound under `signals-key`\n146\t   attached, then the derived linked program `a'`, whose own require and\n147\t   init are idempotent re-entries. The load order is the linked one, the\n148\t   inverse of the bundled hook-prelude-first order.\"\n149\t  [a']\n150\t  (u/mark-tails\n151\t    (u/seq-nodes\n152\t      [(u/sexp->uast (list 'require (list 'quote prelude/module-name)))\n153\t       (u/sexp->uast (list 'require (list 'quote module-name)))\n154\t       (u/sexp->uast '(js/init!))\n155\t       (u/app (u/v (symbol (name module-name) \"attach!\")) (u/v signals-key))\n156\t       a'])))\n157\t\n158\t\n159\t;; =============================================================================\n160\t;; The module emitter: the same definition list as the linker module `jssp`\n161\t;; =============================================================================\n162\t\n163\t(def runtime-keys\n164\t  \"Every key `jssp/attach!` defines, sorted: the signal cursor. It is held\n165\t   at install time by a `:js/uninit` placeholder so the linker's scanners\n166\t   discharge the bodies that read it.\"\n167\t  '[js.sp/cursor])\n168\t\n169\t\n170\t(defn strip\n171\t  \"`sym` without the module's own namespace `js.sp`; any other value as it\n172\t   is. `js/*` stays qualified: those are the base prelude's exports,\n173\t   resolved through the registry once `js` is linked, and stripping them\n174\t   would collide with this module's own bare keys.\"\n175\t  [sym]\n176\t  (core/strip \"js.sp\" sym))\n177\t\n178\t\n179\t(def ^:private module-definitions\n180\t  \"The module's definition list: a `:js/uninit` placeholder for every\n181\t   runtime key, so each read of one is discharged by an unconditional\n182\t   module-level definition, then every definition, stripped.\"\n183\t  (core/module-definitions \"js.sp\" :js/uninit runtime-keys function-definitions))\n184\t\n185\t\n186\t(def module-uast\n187\t  \"The module tree: one application whose operands define hooks, then\n188\t   deliver the pinned base prelude, applied to a lambda returning nil.\n189\t   Every definition precedes every call, including require, so the linker's\n190\t   scanners discharge sibling and runtime-key reads. Defining runs nothing;\n191\t   delivery never initializes either runtime.\"\n192\t  (core/module-tree module-definitions [(u/sexp->uast '(require (quote js)))]))\n193\t\n194\t\n195\t(def module-exports\n196\t  \"The module's exports: every `js.sp/` key of the definition list,\n197\t   stripped. The cursor is internal.\"\n198\t  (core/exports \"js.sp\" function-definitions))\n199\t\n200\t\n201\t(def ^:private module-free-names\n202\t  \"The names the module tree reads and does not define, sorted: the\n203\t   primitives, the host exports and the base prelude's `js/*` exports its\n204\t   manifest declares.\"\n205\t  (core/free-name-vec module-uast))\n206\t\n207\t\n208\t(defn module-spec\n209\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `jssp` over\n210\t   the host registry `registry`, requiring the base prelude `js` at manifest\n211\t   address `js-address`. A free name of the module tree is declared one of\n212\t   three ways: a name qualified by `js` is covered by the requirement,\n213\t   discharged by a linked `js` of equal manifest address; a bare name is a\n214\t   primitive declared by its `vm/primitives` profile; a `ns/name` is a host\n215\t   export declared by the profile address the registry's host module `ns`\n216\t   publishes. A free name none of these supplies is refused before anything\n217\t   is published. This namespace emits; it never publishes.\"\n218\t  [registry js-address]\n219\t  (core/module-spec {:module-name module-name,\n220\t                     :ast module-uast,\n221\t                     :exports module-exports,\n222\t                     :requires {prelude/module-name js-address},\n223\t                     :free-names module-free-names,\n224\t                     ;; the requirement declares names qualified by `js`\n225\t                     :skip? (fn [n] (= (name prelude/module-name) (namespace n))),\n226\t                     :registry registry,\n227\t                     :message \"the jssp module reads an undeclared name\",\n228\t                     :refusal-ns \"yang.typescript.antlr\"}))"}
