     (u/lam [] scoped-body)\n3141\t                                 (u/lam ['%x] (app* 'php/scope-release! (u/v '%scope))))\n3142\t                           scoped-body)))\n3143\t               (let [initialized-body (u/then init-node body)]\n3144\t                 (if (and (not generator?) (seq cvs))\n3145\t                   (app* 'php/try-finally\n3146\t                         (u/lam [] initialized-body)\n3147\t                         (u/lam ['%x]\n3148\t                                (app* 'php/release-cvs\n3149\t                                      (args-vector (map #(u/v (symbol %)) cvs))\n3150\t                                      (u/lit 0)\n3151\t                                      (u/lit (count cvs)))))\n3152\t                   initialized-body)))\n3153\t        wrapped (reduce (fn [inner [sym value]] (u/let1 sym value inner))\n3154\t                        body\n3155\t                        (reverse cell-bindings))]\n3156\t    [(u/lam (if closure?\n3157\t              ['%fn '%args '%binding-profile '%cc]\n3158\t              ['%fn '%args '%binding-profile])\n3159\t            (if closure?\n3160\t              (u/let1 '%cc (app* 'php/scope-of (u/v '%fn) (cc-node ctx)) wrapped)\n3161\t              wrapped))\n3162\t     {:required required,\n3163\t      :total total,\n3164\t      :variadic variadic?,\n3165\t      :names (mapv #(bare (:name %)) fixed)}\n3166\t     (mapv bare (:statics scope))]))\n3167\t\n3168\t\n3169\t(defn- lower-function\n3170\t  [ctx n]\n3171\t  (let [written (ns-prefixed ctx (function-written ctx n))\n3172\t        [lam spec statics] (function-lam ctx n written {})]\n3173\t    (app* 'php/declare-function!\n3174\t          (u/lit (str/lower-case written))\n3175\t          (app* 'php/make-function (u/lit written) (u/lit spec) lam (u/lit statics)))))\n3176\t\n3177\t\n3178\t(defn- use-vars\n3179\t  \"`[{:name :ref?}]` of a closure's `use` clause.\""}
