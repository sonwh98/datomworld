{"role":"tool","tool_call_id":"tool_vKY1PKnvE7zOYxDXLPBIruuA","content":"1\t(ns yang.core.uast\n2\t  \"Universal AST constructors shared by every language lowering and prelude. Every\n3\t   function returns a canonical map node (`:literal`, `:variable`, `:lambda`,\n4\t   `:application`, `:if`, `:vm/current-continuation`); nothing here adds a\n5\t   node type.\n6\t\n7\t   `sexp->uast` reads a small s-expression notation into those same nodes so\n8\t   the prelude can be written legibly:\n9\t\n10\t     symbol            -> :variable\n11\t     (fn [params] b)   -> :lambda\n12\t     (if t c a)        -> :if\n13\t     (do a b ... z)    -> sequencing through one-parameter lambdas\n14\t     (let [x v ...] b) -> nested immediately applied lambdas\n15\t     (quote x)         -> :literal x\n16\t     (%capture)        -> :vm/current-continuation\n17\t     (yin/def k v)     -> the definition application\n18\t     (f a ...)         -> :application\n19\t     any other value   -> :literal\"\n20\t  (:require\n21\t    [yang.tails :as tails]))\n22\t\n23\t\n24\t(defn lit\n25\t  [x]\n26\t  {:type :literal, :value x})\n27\t\n28\t\n29\t(defn v\n30\t  [sym]\n31\t  {:type :variable, :name sym})\n32\t\n33\t\n34\t(defn lam\n35\t  [params body]\n36\t  {:type :lambda, :params (vec params), :body body})\n37\t\n38\t\n39\t(defn app\n40\t  [op & args]\n41\t  {:type :application, :operator op, :operands (vec args)})\n42\t\n43\t\n44\t(defn if-node\n45\t  [t c a]\n46\t  {:type :if, :test t, :consequent c, :alternate a})\n47\t\n48\t\n49\t(def capture {:type :vm/current-continuation})\n50\t\n51\t\n52\t(defn def!\n53\t  \"`(yin/def key value)`: key is a literal symbol.\"\n54\t  [key value]\n55\t  (app (v 'yin/def) (lit key) value))\n56\t\n57\t\n58\t(def discard\n59\t  \"The parameter a sequencing lambda binds and ignores. `%` cannot begin a\n60\t   Python identifier, so it never shadows a guest name.\"\n61\t  '%_)\n62\t\n63\t\n64\t(defn then\n65\t  \"Evaluate `a` for effect, then `b`.\"\n66\t  [a b]\n67\t  (app (lam [discard] b) a))\n68\t\n69\t\n70\t(defn seq-nodes\n71\t  \"Evaluate every node in order; the value is the last one's.\"\n72\t  [nodes]\n73\t  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n74\t\n75\t\n76\t(defn let1\n77\t  [sym value body]\n78\t  (app (lam [sym] body) value))\n79\t\n80\t\n81\t(defn sexp->uast\n82\t  [form]\n83\t  (cond\n84\t    (symbol? form) (v form)\n85\t    (seq? form)\n86\t    (let [[head & args] form]\n87\t      (case head\n88\t        fn (lam (first args) (sexp->uast (second args)))\n89\t        if (if-node (sexp->uast (first args))\n90\t                    (sexp->uast (second args))\n91\t                    (sexp->uast (nth args 2)))\n92\t        do (seq-nodes (map sexp->uast args))\n93\t        let (let [[bindings body] args]\n94\t              (reduce (fn [inner [sym value]]\n95\t                        (let1 sym (sexp->uast value) inner))\n96\t                      (sexp->uast body)\n97\t                      (reverse (partition 2 bindings))))\n98\t        quote (lit (first args))\n99\t        %capture capture\n100\t        (apply app (sexp->uast head) (map sexp->uast args))))\n101\t    :else (lit form)))\n102\t\n103\t\n104\t(def mark-tails\n105\t  \"`yang.tails/mark-tails`: the lowering marks its tree with the same\n106\t   function a rewriting stage recomputes the marks with.\"\n107\t  tails/mark-tails)"}
{"role":"tool","tool_call_id":"tool_AQhVmhopiSxvh6ogu5naIINk","content":"1\t(ns yang.php.antlr.generators-test\n2\t  \"P4 S8 generators, live iteration and protocol integration on the JVM.\"\n3\t  (:require\n4\t    [clojure.test :refer [deftest is testing]]\n5\t    [yang.php.antlr.e2e-harness :as h]\n6\t    [yang.php.antlr.programs-p4 :as p4]\n7\t    [yin.vm :as vm]\n8\t    [yin.vm.debruijn.register :as rvm]\n9\t    [yin.vm.debruijn.stack :as dvm]\n10\t    [yin.vm.engine :as engine]\n11\t    [yin.vm.semantic :as semantic]\n12\t    [yin.vm.semantic.derive :as derive]\n13\t    [yin.vm.semantic.linearize :as sr-linearize]\n14\t    [yin.vm.test-utils :as tu]\n15\t    [yin.vm.values :as values])\n16\t  (:import\n17\t    [java.util IdentityHashMap]))\n18\t\n19\t\n20\t(def ^:private vms [:ast-walker :semantic :stack :register])\n21\t\n22\t\n23\t(deftest generator-fixtures-on-every-vm-test\n24\t  (doseq [{:keys [id source out]} p4/generators-v1]\n25\t    (testing (name id)\n26\t      (let [results (h/run-php source)]\n27\t        (is (not (contains? results :diagnostics)) (pr-str results))\n28\t        (doseq [k vms]\n29\t          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n30\t\n31\t\n32\t(deftest iteration-protocols-test\n33\t  (testing \"Iterator drives foreach directly\"\n34\t    (is (= \"01\" (:php/out (h/run-raw\n35\t                            \"<?php class I implements Iterator { private $i=0; function rewind(): void {$this->i=0;} function valid(): bool {return $this->i<2;} function current(): mixed {return $this->i;} function key(): mixed {return $this->i;} function next(): void {$this->i++;} } foreach(new I as $v) echo $v;\")))))\n36\t  (testing \"IteratorAggregate supplies the live iterator\"\n37\t    (is (= \"23\" (:php/out (h/run-raw\n38\t                            \"<?php class I implements Iterator {private $i=2;function rewind():void{}function valid():bool{return $this->i<4;}function current(){return $this->i;}function key(){return $this->i;}function next():void{$this->i++;}} class A implements IteratorAggregate {function getIterator():Iterator{return new I;}} foreach(new A as $v)echo $v;\")))))\n39\t  (testing \"property iteration filters visibility from the calling scope\"\n40\t    (is (= \"aabc\" (:php/out (h/run-raw\n41\t                              \"<?php class P {public $a='a'; protected $b='b'; private $c='c'; function f(){foreach($this as $v)echo $v;}} $p=new P;foreach($p as $v)echo $v;$p->f();\")))))\n42\t  (testing \"ArrayAccess reads by value; Countable and Stringable dispatch\"\n43\t    (is (= \"43s\" (:php/out (h/run-raw\n44\t                             \"<?php class A implements ArrayAccess, Countable, Stringable {function offsetExists($x):bool{return true;} function offsetGet($x){return 4;} function offsetSet($x,$v):void{} function offsetUnset($x):void{} function count():int{return 3;} function __toString():string{return 's';}} $a=new A;echo $a[0],count($a),(string)$a;\"))))))\n45\t\n46\t\n47\t(def ^:private opts\n48\t  {:make-stream tu/make-stream\n49\t   :capability-secret tu/secret\n50\t   :primitives vm/primitives\n51\t   :modules (h/host-registry)})\n52\t\n53\t\n54\t(def ^:private load-semantic\n55\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n56\t\n57\t\n58\t(def ^:private final-vms\n59\t  {:ast-walker (fn [ast _] (vm/eval (tu/create-vm opts) ast))\n60\t   :semantic (fn [_ datoms] (vm/run (load-semantic (semantic/create-vm opts) datoms)))\n61\t   :stack (fn [ast _]\n62\t            (vm/run (dvm/create-vm\n63\t                      (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n64\t                      (assoc opts :contract vm/stack-contract))))\n65\t   :register (fn [ast _]\n66\t               (vm/run (rvm/create-vm\n67\t                         (derive/register-image (:vector (sr-linearize/project ast)))\n68\t                         (assoc opts :contract vm/register-contract))))})\n69\t\n70\t\n71\t(defn- deep-size\n72\t  \"Count shared compound values once, including closure/continuation payloads.\"\n73\t  [x]\n74\t  (let [seen (IdentityHashMap.)]\n75\t    (loop [work [x], size 0]\n76\t      (if (empty? work)\n77\t        size\n78\t        (let [x (peek work)\n79\t              work (pop work)\n80\t              compound? (or (values/host-typed? x) (coll? x))]\n81\t          (if (and compound? (.put seen x true))\n82\t            (recur work size)\n83\t            (recur (cond\n84\t                     (values/host-typed? x) (conj work (values/payload x))\n85\t                     (map? x) (into (into work (keys x)) (vals x))\n86\t                     (coll? x) (into work x)\n87\t                     :else work)\n88\t                   (inc size))))))))\n89\t\n90\t\n91\t(defn- live-after-collection\n92\t  \"[live cell count, deep size of cell contents] after normal PHP completion\n93\t   and collection with the suspended generator h as the only extra root. The\n94\t   program's `$it->self = $it` cycle preserves h after module cleanup.\"\n95\t  [k source]\n96\t  (let [ast (:ast (h/lower-program source))\n97\t        final ((get final-vms k) ast (vm/ast->datoms ast))\n98\t        roots (into []\n99\t                    (keep (fn [[id {:keys [value seal]}]]\n100\t                            (when (and (= :obj (:php/type value))\n101\t                                       (= \"Generator\" (:class value))\n102\t                                       (= \"h\" (get-in value [:gen :name]))\n103\t                                       (= :suspended (get-in value [:gen :state])))\n104\t                              {:type :cell-ref, :id id, :seal seal})))\n105\t                    (:heap final))]\n106\t    (is (= 1 (count roots)) (str k \" one suspended delegating generator h\"))\n107\t    (let [heap (:heap (engine/collect final roots))]\n108\t      [(count heap)\n109\t       (deep-size (mapv :value (vals heap)))])))\n110\t\n111\t\n112\t(defn- changing-caller-source\n113\t  [n]\n114\t  (str \"<?php function g() { $i=0; while (true) { yield $i; $i++; } }\"\n115\t       ;; Own the delegate across caller statements, whose temporary cleanup\n116\t       ;; would otherwise release the bare g() result while h is suspended.\n117\t       \" function h() { $d=g(); yield from $d; } $it=h(); $it->self=$it;\"\n118\t       \" function byFunction($x) { $x->next(); }\"\n119\t       \" function byGenerator($x) { yield $x->current(); $x->next(); }\"\n120\t       \" $k=0; while ($k < \" n \") {\"\n121\t       \" if ($k % 2 == 0) { byFunction($it); }\"\n122\t       \" else { $j=byGenerator($it); $j->current(); $j->next(); } $k++; }\"))\n123\t\n124\t\n125\t(deftest ^:slow reachable-heap-is-stable-under-delegation-test\n126\t  (doseq [k vms]\n127\t    (testing (str k)\n128\t      (let [small (live-after-collection k (changing-caller-source 10))\n129\t            large (live-after-collection k (changing-caller-source 1000))]\n130\t        (when (and small large)\n131\t          (is (= small large)))))))"}
{"role":"tool","tool_call_id":"tool_tChMAAYwMULBQlxxWRdegRBO","content":"390\t    ;; and the slots of its state, nothing else (every transition rebuilds\n391\t    ;; the content, so no slot outlives its state):\n392\t    ;;   :created    :body      (fn [g] ...), the function body\n393\t    ;;   :suspended  :resume    the continuation captured at the yield\n394\t    ;;               :ctx       the generator's own dynamic context\n395\t    ;;   :running    :return    the active switch's continuation\n396\t    ;;               :caller-ctx the switching caller's dynamic context\n397\t    ;;   :closed     nothing\n398\t    ;; The generator owns its dynamic context (handler stack and its\n399\t    ;; depth relative to :base), so every snapshot the C1 forms take inside\n400\t    ;; the body is of that record and resumes from any caller depth. Every\n401\t    ;; crossing in sets :base to the resumer's absolute depth plus one, the\n402\t    ;; generator's own frame, so depth measures the current continuation;\n403\t    ;; every way back restores the caller's record whole, so no depth leaks\n404\t    ;; across the crossing in either direction. A start or resume whose\n405\t    ;; generator frame would exceed `py.rt/limit` is refused with\n406\t    ;; RecursionError before anything is written. `py/gen-switch` sends\n407\t    ;; [:send v] or [:throw e] and answers [:yield v], [:return v] or\n408\t    ;; [:raise e]; it never raises from the generator's side. Each crossing\n409\t    ;; restores the receiving side's dynamic context, then invokes the\n410\t    ;; receiving continuation once.\n411\t    [py/gen-content\n412\t     (fn [name state]\n413\t       (assoc (assoc (assoc {} :py/type :generator) :name name) :state state))]\n414\t    [py/make-generator\n415\t     (fn [name body] (cell/new (assoc (py/gen-content name :created) :body body)))]\n416\t    [py/outcome (fn [tag v] (py/vconj (py/vconj [] tag) v))]\n417\t    [py/gen-switch\n418\t     (fn [g msg]\n419\t       (let [c (cell/get g)\n420\t             st (get c :state)]\n421\t         (if (= st :running)\n422\t           (py/raise-new py.b/ValueError {:py/str \"generator already executing\"})\n423\t           (if (= st :closed)\n424\t             (if (= (get msg 0) :throw)\n425\t               (py/outcome :raise (get msg 1))\n426\t               (py/outcome :return :py/None))\n427\t             (if (if (= st :created) (= (get msg 0) :throw) false)\n428\t               ;; thrown into a generator that never ran: it closes, and\n429\t               ;; the exception is the caller's\n430\t               (do (cell/set! g (py/gen-content (get c :name) :closed))\n431\t                   (py/outcome :raise (get msg 1)))\n432\t               ;; admission: the generator's frame must fit under the limit,\n433\t               ;; checked before anything is written, so a refusal raises on\n434\t               ;; the caller's stack and leaves the generator as it was\n435\t               (if (< (cell/get py.rt/limit)\n436\t                      (+ 1 (py/abs-depth (cell/get py.rt/ctx))))\n437\t                 (py/raise-new py.b/RecursionError\n438\t                               {:py/str \"maximum recursion depth exceeded\"})\n439\t                 (py/gen-enter g c st msg)))))))]\n440\t    [py/gen-enter\n441\t     ;; the crossing into a generator that start or resume admitted\n442\t     (fn [g c st msg]\n443\t       (let [flag (cell/new :first)]\n444\t         ((fn [r]\n445\t            (if (= (cell/get flag) :first)\n446\t              (do (cell/set! flag :re-entered)\n447\t                  (cell/set! g (assoc (assoc (py/gen-content (get c :name) :running)\n448\t                                             :return r)\n449\t                                      :caller-ctx (cell/get py.rt/ctx)))\n450\t                  (if (= st :created)\n451\t                    (py/gen-start g (get c :body))\n452\t                    (do (cell/set! py.rt/ctx\n453\t                                   (assoc (get c :ctx) :base (py/crossing-base g)))\n454\t                        ((get c :resume) msg))))\n455\t              r))\n456\t          (%capture))))]\n457\t    [py/crossing-base\n458\t     ;; a running generator's :base: its resumer's absolute depth, plus one\n459\t     ;; for the generator's own frame\n460\t     (fn [g] (+ 1 (py/abs-depth (get (cell/get g) :caller-ctx))))]\n461\t    [py/gen-start\n462\t     ;; a fresh handler stack whose only frame is the boundary: an exception\n463\t     ;; no handler in the body catches reaches it and leaves the generator\n464\t     (fn [g body]\n465\t       (do (cell/set! py.rt/ctx (py/ctx nil 0 (py/crossing-base g) nil))\n466\t           (py/set-handlers! (py/frame :generator (fn [e] (py/gen-fail g e)) nil))\n467\t           (py/gen-exit g (py/outcome :return (body g)))))]\n468\t    [py/gen-exit\n469\t     ;; the single way out of a finishing generator: closed, the caller's\n470\t     ;; dynamic context back, the outcome delivered to the active switch\n471\t     (fn [g outcome]\n472\t       (let [c (cell/get g)]\n473\t         (do (cell/set! g (py/gen-content (get c :name) :closed))\n474\t             (cell/set! py.rt/ctx (get c :caller-ctx))\n475\t             ((get c :return) outcome))))]\n476\t    [py/gen-fail\n477\t     ;; PEP 479: a StopIteration escaping the body is a RuntimeError\n478\t     (fn [g e]\n479\t       (py/gen-exit g (py/outcome :raise\n480\t                                  (if (py/subclass? (py/type-of e) py.b/StopIteration)\n481\t                                    (py/make-exc py.b/RuntimeError\n482\t                                                 {:py/str \"generator raised StopIteration\"})\n483\t                                    e))))]\n484\t    [py/yield-raw\n485\t     ;; suspend, answering the message the next switch sends\n486\t     (fn [g v]\n487\t       (let [flag (cell/new :first)]\n488\t         ((fn [r]\n489\t            (if (= (cell/get flag) :first)\n490\t              (let [c (cell/get g)]\n491\t                (do (cell/set! flag :re-entered)\n492\t                    (cell/set! g (assoc (assoc (py/gen-content (get c :name) :suspended)\n493\t                                               :resume r)\n494\t                                        :ctx (cell/get py.rt/ctx)))\n495\t                    (cell/set! py.rt/ctx (get c :caller-ctx))\n496\t                    ((get c :return) (py/outcome :yield v))))\n497\t              r))\n498\t          (%capture))))]\n499\t    [py/yield\n500\t     ;; `yield v`: the value sent, or the exception thrown raised here, on\n501\t     ;; the generator's own stack\n502\t     (fn [g v]\n503\t       (let [m (py/yield-raw g v)]\n504\t         (if (= (get m 0) :throw) (py/raise (get m 1)) (get m 1))))]\n505\t    [py/gen-result\n506\t     ;; a switch's outcome at a protocol boundary, in the caller: the value\n507\t     ;; yielded, the exception re-raised, completion as StopIteration(value)\n508\t     ;; or, when one is given, `default`\n509\t     (fn [o default]\n510\t       (let [tag (get o 0)\n511\t             v (get o 1)]\n512\t         (if (= tag :yield)\n513\t           v\n514\t           (if (= tag :raise)\n515\t             (py/raise v)\n516\t             (if (= default :py/missing)\n517\t               (py/raise (py/call py.b/StopIteration\n518\t                                  (if (= v :py/None) [] (py/vconj [] v))))\n519\t               default)))))]"}
