{"role":"tool","tool_call_id":"tool_Enr375DVpQRZFov7MwiLqOwZ","content":"1190\t         \"    i = 0\"\n1191\t         \"    while True:\"\n1192\t         \"        yield i\"\n1193\t         \"        i += 1\"\n1194\t         \"def h():\"\n1195\t         \"    yield from g()\"\n1196\t         (if delegate? \"it = h()\" \"it = g()\")\n1197\t         \"for x in it:\"\n1198\t         (str \"    if x == \" n \":\")\n1199\t         \"        break\"))\n1200\t\n1201\t\n1202\t(deftest ^:slow resume-continuation-length-is-stable-test\n1203\t  (testing \"the suspended generator's :resume has the same size after 10 and\n1204\t            after 1000 items: no per-yield growth, the stale base fixed\"\n1205\t    (doseq [k [:ast-walker :semantic :stack :register]]\n1206\t      (testing (str k)\n1207\t        (is (= (suspended-resume-sizes k 1 (counter-source 10 false))\n1208\t               (suspended-resume-sizes k 1 (counter-source 1000 false)))))))\n1209\t  (testing \"under yield from, neither the delegating nor the inner\n1210\t            generator's :resume grows per item\"\n1211\t    (doseq [k [:ast-walker :semantic :stack :register]]\n1212\t      (testing (str k)\n1213\t        (is (= (suspended-resume-sizes k 2 (counter-source 10 true))\n1214\t               (suspended-resume-sizes k 2 (counter-source 1000 true))))))))\n1215\t\n1216\t\n1217\t(defn- deep-size\n1218\t  \"Node count of `x` with continuation and closure payloads followed; a\n1219\t   cell ref counts as itself (its cell is counted once, as a heap entry).\"\n1220\t  [x]\n1221\t  (cond\n1222\t    (values/host-typed? x) (+ 1 (deep-size (values/payload x)))\n1223\t    (map? x) (reduce + 1 (map deep-size (concat (keys x) (vals x))))\n1224\t    (coll? x) (reduce + 1 (map deep-size x))\n1225\t    :else 1))\n1226\t\n1227\t\n1228\t(defn- live-after-collection\n1229\t  \"[live cell count, deep size of all live cell content] once VM `k` ran\n1230\t   `source` and its final state was collected with the suspended\n1231\t   generator named `root` as the only extra root: everything that\n1232\t   generator reaches, continuations followed, not one `:resume` alone.\n1233\t   The module's own globals are garbage once it completes, so without the\n1234\t   root nothing of the program would be live.\"\n1235\t  [k source root]\n1236\t  (let [ast (lower/lower-packet\n1237\t              (parser/parse-source (parser/make-worker) [:u 1] source))\n1238\t        final ((get final-vms k) ast (vm/ast->datoms ast))\n1239\t        roots (into []\n1240\t                    (keep (fn [[id {:keys [value seal]}]]\n1241\t                            (when (and (= :generator (:py/type value))\n1242\t                                       (= :suspended (:state value))\n1243\t                                       (= root (:name value)))\n1244\t                              {:type :cell-ref, :id id, :seal seal})))\n1245\t                    (:heap final))\n1246\t        heap (:heap (engine/collect final roots))]\n1247\t    (is (= 1 (count roots)) (str k \" one suspended \" root))\n1248\t    [(count heap) (reduce + (map (fn [[_ {:keys [value]}]] (deep-size value)) heap))]))\n1249\t\n1250\t\n1251\t(defn- changing-caller-source\n1252\t  \"`n` items through a `yield from` level, resumed alternately by a\n1253\t   function and by a fresh generator dropped after one step.\"\n1254\t  [n]\n1255\t  (lines \"def g():\"\n1256\t         \"    i = 0\"\n1257\t         \"    while True:\"\n1258\t         \"        yield i\"\n1259\t         \"        i += 1\"\n1260\t         \"def h():\"\n1261\t         \"    yield from g()\"\n1262\t         \"it = h()\"\n1263\t         \"def by_function(x):\"\n1264\t         \"    return next(x)\"\n1265\t         \"def by_generator(x):\"\n1266\t         \"    yield next(x)\"\n1267\t         \"k = 0\"\n1268\t         (str \"while k < \" n \":\")\n1269\t         \"    if k % 2 == 0:\"\n1270\t         \"        by_function(it)\"\n1271\t         \"    else:\"\n1272\t         \"        next(by_generator(it))\"\n1273\t         \"    k += 1\"))\n1274\t\n1275\t\n1276\t(deftest ^:slow reachable-heap-is-stable-under-delegation-test\n1277\t  (testing \"after a forced collection, the live heap (cells and their content,\n1278\t            continuations followed) is the same after 10 and after 1000 items\n1279\t            resumed through yield from by changing callers: no retention\n1280\t            grows per item or per caller\"\n1281\t    (doseq [k [:ast-walker :semantic :stack :register]]\n1282\t      (testing (str k)\n1283\t        (is (= (live-after-collection k (changing-caller-source 10) \"h\")\n1284\t               (live-after-collection k (changing-caller-source 1000) \"h\")))))))\n1285\t\n1286\t\n1287\t;; =============================================================================\n1288\t;; S5 acceptance: user-defined iterators, snapshot rendering, dropped generators\n1289\t;; =============================================================================\n1290\t\n1291\t(deftest user-iterator-class-test\n1292\t  (testing \"a class with __iter__ and __next__ drives for, list, next and\n1293\t            unpacking; a shared iterator keeps its position across loops\"\n1294\t    (every-vm= (prints \"[3, 4, 5]\" \"done\" \"[1, 2, 3]\" \"1 2\")\n1295\t               (lines \"class Count:\"\n1296\t                      \"    def __init__(self, n):\"\n1297\t                      \"        self.i = 0\"\n1298\t                      \"        self.n = n\"\n1299\t                      \"    def __iter__(self):\"\n1300\t                      \"        return self\"\n1301\t                      \"    def __next__(self):\"\n1302\t                      \"        if self.i >= self.n:\"\n1303\t                      \"            raise StopIteration\"\n1304\t                      \"        self.i += 1\""}
{"role":"tool","tool_call_id":"tool_Z3m2l92eyZNsQc07GQ10n2bn","content":"800\t        (assoc (engine/put-active vm store-of key value)\n801\t               :pc (inc pc)\n802\t               :stack (conj stack value)))\n803\t\n804\t      ;; :define -- the definition transition: pop the value, write it\n805\t      ;; under the literal name, and leave it as the expression's value.\n806\t      ;; The operator is never resolved (Rule R).\n807\t      :define\n808\t      (let [value (peek stack)]\n809\t        (assoc (engine/put-active vm store-of (nth inst 1) value)\n810\t               :pc (inc pc)\n811\t               :stack (conj (pop stack) value)))\n812\t\n813\t      ;; :gensym -- a fresh id; the engine's counter advances\n814\t      :gensym\n815\t      (let [[id vm'] (engine/gensym vm (nth inst 1))]\n816\t        (assoc vm' :pc (inc pc) :stack (conj stack id)))\n817\t\n818\t      ;; :stream-make -- the composition's :make-stream, through the engine\n819\t      :stream-make\n820\t      (run-effect vm\n821\t                  (module/make-effect :stream/make {:capacity (or (nth inst 1) vm/default-stream-capacity)})\n822\t                  stack)\n823\t\n824\t      ;; :stream-put -- the value on top, its target stream ref beneath\n825\t      ;; (`lower-stack` emits target, push, value, stream-put)\n826\t      :stream-put\n827\t      (let [val (peek stack), stack' (pop stack), target (peek stack')]\n828\t        (run-effect vm\n829\t                    (module/make-effect :stream/put {:stream target, :val val})\n830\t                    (pop stack')))\n831\t\n832\t      ;; :stream-cursor -- the source stream ref on top\n833\t      :stream-cursor\n834\t      (run-effect vm (module/make-effect :stream/cursor {:stream (peek stack)}) (pop stack))\n835\t\n836\t      ;; :stream-next -- the cursor ref on top; may park as a reader\n837\t      :stream-next\n838\t      (run-effect vm (module/make-effect :stream/next {:cursor (peek stack)}) (pop stack))\n839\t\n840\t      ;; :stream-close -- the source stream ref on top; yields nil\n841\t      :stream-close\n842\t      (run-effect vm (module/make-effect :stream/close {:stream (peek stack)}) (pop stack))\n843\t\n844\t      ;; :current-continuation -- the continuation after this instruction,\n845\t      ;; as a value: the register payload under the shared tag the B0\n846\t      ;; normalizer compares by type\n847\t      :current-continuation\n848\t      (assoc vm\n849\t             :pc (inc pc)\n850\t             :stack (conj stack\n851\t                          (values/continuation\n852\t                            (:owner vm)\n853\t                            (merge {:type :reified-continuation}\n854\t                                   (registers vm (inc pc) stack)))))\n855\t\n856\t      ;; :park -- the engine records the payload under a fresh parked id,\n857\t      ;; writes the record into :value, and halts the machine\n858\t      :park\n859\t      (engine/park-continuation (assoc vm :pc (inc pc))\n860\t                                (registers vm (inc pc) stack))\n861\t\n862\t      ;; :resume -- the value on top is delivered to the parked\n863\t      ;; continuation named by the operand, through this machine's restore\n864\t      :resume\n865\t      (let [val (peek stack)]\n866\t        (engine/resume-continuation (assoc vm :stack (pop stack))\n867\t                                    (nth inst 1)\n868\t                                    val\n869\t                                    stack-restore))\n870\t\n871\t      :ffi-call\n872\t      (ffi-call vm (nth inst 1) (nth inst 2))\n873\t\n874\t      (throw (ex-info (str \"Unknown opcode in segment: \" op)\n875\t                      {:rule :unknown-opcode, :op op, :pc pc})))))\n876\t\n877\t\n878\t;; =============================================================================\n879\t;; Scheduling\n880\t;; =============================================================================\n881\t\n882\t(defn- run-scheduler\n883\t  \"The raw runner: already-loaded work only, through the shared scheduler\n884\t   loop with this machine's step function and its restore bound into the\n885\t   engine's run-queue resumption. `ffi/maybe-run` wraps this for bridge\n886\t   dispatch.\"\n887\t  [vm]\n888\t  (engine/run-loop vm\n889\t                   engine/active-continuation?\n890\t                   step1\n891\t                   #(engine/resume-from-run-queue % stack-restore)))\n892\t\n893\t\n894\t;; =============================================================================\n895\t;; IVM / IVMState\n896\t;; =============================================================================\n897\t;; No new protocol methods (section 4, point 7). `environment` is not\n898\t;; implemented at all (point 8): the design defers it until a\n899\t;; frame-to-named lift exists, and returning the raw positional frame"}
{"role":"tool","tool_call_id":"tool_KN2Y02mUsYjjUAq0hwjpjAih","content":"760\t      (let [key (nth inst 2)\n761\t            val (nth inst 3)]\n762\t        (assoc (engine/put-active vm store-of key val)\n763\t               :pc (inc pc)\n764\t               :registers (assoc registers (nth inst 1) val)))\n765\t\n766\t      ;; :define -- the definition transition: register `rs` is written\n767\t      ;; under the literal name and into `rd`. The operator is never\n768\t      ;; resolved (Rule R).\n769\t      :define\n770\t      (let [val (nth registers (nth inst 3))]\n771\t        (assoc (engine/put-active vm store-of (nth inst 2) val)\n772\t               :pc (inc pc)\n773\t               :registers (assoc registers (nth inst 1) val)))\n774\t\n775\t      :gensym\n776\t      (let [[id vm'] (engine/gensym vm (nth inst 2))]\n777\t        (assoc vm'\n778\t               :pc (inc pc)\n779\t               :registers (assoc (:registers vm') (nth inst 1) id)))\n780\t\n781\t      :stream-make\n782\t      (let [cap (or (nth inst 2) vm/default-stream-capacity)]\n783\t        (run-effect vm (module/make-effect :stream/make {:capacity cap}) inst))\n784\t\n785\t      :stream-put\n786\t      (let [sr (nth registers (nth inst 2))\n787\t            vr (nth registers (nth inst 3))]\n788\t        (run-effect vm (module/make-effect :stream/put {:stream sr, :val vr}) inst))\n789\t\n790\t      :stream-cursor\n791\t      (let [sr (nth registers (nth inst 2))]\n792\t        (run-effect vm (module/make-effect :stream/cursor {:stream sr}) inst))\n793\t\n794\t      :stream-next\n795\t      (let [cr (nth registers (nth inst 2))]\n796\t        (run-effect vm (module/make-effect :stream/next {:cursor cr}) inst))\n797\t\n798\t      :stream-close\n799\t      (let [sr (nth registers (nth inst 2))]\n800\t        (run-effect vm (module/make-effect :stream/close {:stream sr}) inst))\n801\t\n802\t      :current-continuation\n803\t      (let [payload (payload-of vm inst)\n804\t            reified (value