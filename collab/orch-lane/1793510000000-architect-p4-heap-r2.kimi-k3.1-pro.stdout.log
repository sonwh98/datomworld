                             nil env k value))\n545\t        :vm/store-update (let [key (:key node)\n546\t                               f (:fn node)\n547\t                               args (:args node)\n548\t                               store-of (engine/env-store-of env)\n549\t                               _ (engine/check-store-key! key)\n550\t                               current (get (engine/active-store state store-of)\n551\t                                            key)\n552\t                               new-value (apply f current args)]\n553\t                           (cesk-return (engine/put-active state store-of key\n554\t                                                           new-value)\n555\t                                        nil env k new-value))\n556\t        :vm/current-continuation\n557\t        (cesk-return state\n558\t                     nil\n559\t                     env\n560\t                     k\n561\t                     (values/continuation (:owner state)\n562\t                                          {:type :reified-continuation,\n563\t                                           :k k,\n564\t                                           :env env}))\n565\t        :vm/park (-> (engine/park-continuation state {:k k, :env env})\n566\t                     (assoc :control nil\n567\t                            :k nil))\n568\t        :vm/resume (cesk-return state\n569\t                                (:val node)\n570\t                                env\n571\t                                {:type :eval-resume-val,\n572\t                                 :parked-id (:parked-id node),\n573\t                                 :next k,\n574\t                                 :env env}\n575\t                                (:value state))\n576\t        :stream/make (let [capacity (or (:buffer node)\n577\t                                        vm/default-stream-capacity)\n578\t                           effect (module/make-effect :stream/make