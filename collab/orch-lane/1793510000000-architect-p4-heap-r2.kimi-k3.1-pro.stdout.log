frame hs)\n205\t                 (if (= (get hs 0) :finally) ((get hs 1) :php/null) :php/null)\n206\t                 (php/unwind-to n))))))]\n207\t    [php/try\n208\t     (fn [body handler orelse]\n209\t       (let [saved (cell/get php.rt/ctx)\n210\t             flag (cell/new :first)]\n211\t         ((fn [r]\n212\t            (if (= (cell/get flag) :first)\n213\t              (do (cell/set! flag :re-entered)\n214\t                  (php/set-handlers! (php/frame :handler r (get saved :handlers)))\n215\t                  (body)\n216\t                  (php/restore! saved)\n217\t                  (orelse))\n218\t              (do (php/restore! saved)\n219\t                  (handler r))))\n220\t          (%capture))))]\n221\t    [php/try-finally\n222\t     ;; normal exit runs `fin` here; raise and escapes run it as they\n223\t     ;; unwind through the :finally frame\n224\t     (fn [body fin]\n225\t       (let [saved (cell/get php.rt/ctx)]\n226\t         (do (php/set-handlers! (php/frame :finally fin (get saved :handlers)))\n227\t             (let [v (body)]\n228\t               (do (php/restore! saved)\n229\t                   (fin :php/null)\n230\t                   v)))))]\n231\t    [php/call-ec\n232\t     ;; `f` receives an escape: calling it unwinds to here and answers its\n233\t     ;; argument as this call's value (break, continue, return)\n234\t     (fn [f]\n235\t       (let [saved (cell/get php.rt/ctx)\n236\t             flag (cell/new :first)]\n237\t         ((fn [r]\n238\t            (if (= (cell/get flag) :first)\n239\t              (do (cell/set! flag :re-entered)\n240\t                  (f (fn [x]\n241\t                       (do (php/unwind-to (php/frame-depth (get saved :handlers)))\n242\t                           (php/restore! saved)\n243\t                           (r x)))))\n244\t              r))\n245\t          (%capture))))]\n246\t\n247\t    ;; ---------------------------------------------------------------- errors\n248\t    [php/make-error\n24