        336875a1 [yang-teststrategy]\n/Users/sto/workspace/datomworld-teststrategy-fc                   ebe94375 [yang-teststrategy-fc]\n/Users/sto/workspace/datomworld-ts-t3                             bce0e454 [yang-ts-t3]\n/Users/sto/workspace/datomworld-wp-w0a                            be1a3a25 [wp-w0a]\n/Users/sto/workspace/datomworld-wp-w0b                            750dd505 [wp-w0b]\n/Users/sto/workspace/datomworld-yang-common-call                  b06dfd5f [yang-common-call]\n/Users/sto/workspace/datomworld-yang-h2                           862520bc [yang-hardening2]\n/Users/sto/workspace/datomworld-yang-s3                           a34a2251 [yang-slice3]\n/Users/sto/workspace/datomworld-yang-s4                           efa80ae2 [yang-slice4]\n/Users/sto/workspace/datomworld-yang-s5                           a99754f1 [yang-slice5]\n/Users/sto/workspace/datomworld-yang-s6                           8125a1bb [yang-slice6]\n/Users/sto/workspace/datomworld-yang-s7                           1fe3eb07 [yang-slice7]\n/Users/sto/workspace/datomworld-yang-s8                           f7250f03 [yang-slice8]\n/Users/sto/workspace/datomworld-yang-s9                           12d14e1e [yang-slice9]\n/Users/sto/workspace/datomworld/.claude/worktrees/dao-star-demo   a98377e7 (detached HEAD)\n/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j4d-fixes  67aa4cd2 [jolt-j4d-fixes]\n/Users/sto/workspace/datomworld/.claude/worktrees/jolt-j5         0fe6ad0d [jolt-j5]\nAGENTS.md\ntest/yang/php/antlr/generators_test.clj\ntest/yang/php/antlr/class_model_test.cljc\narchive/yang-python/1790874900000-architect-python-c2-generators-design.prompt.md\narchive/yang-python/1790874900000-architect-python-c2-generators-design.claude-fable-5-1.stdout.log\narchive/yang-python/1790875890000-architect-c2-generators-crossruling.gpt-6-astra.findings.md\narchive/yang-python/1790875890000-architect-c2-generators-crossruling.prompt.md\narchive/yang-python/1790875890000-architect-c2-generators-crossruling.gpt-6-astra.stdout.log\narchive/yang-python/1790874900000-architect-python-c2-generators-design.claude-fable-5-1.findings.md\n(ns yang.php.antlr.generators-test\n  \"P4 S8 generators, live iteration and protocol integration on the JVM.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.programs-p4 :as p4]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.engine :as engine]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]\n    [yin.vm.values :as values])\n  (:import\n    [java.util IdentityHashMap]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(deftest generator-fixtures-on-every-vm-test\n  (doseq [{:keys [id source out]} p4/generators-v1]\n    (testing (name id)\n      (let [results (h/run-php source)]\n        (is (not (contains? results :diagnostics)) (pr-str results))\n        (doseq [k vms]\n          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n\n\n(deftest iteration-protocols-test\n  (testing \"Iterator drives foreach directly\"\n    (is (= \"01\" (:php/out (h/run-raw\n                            \"<?php class I implements Iterator { private $i=0; function rewind(): void {$this->i=0;} function valid(): bool {return $this->i<2;} function current(): mixed {return $this->i;} function key(): mixed {return $this->i;} function next(): void {$this->i++;} } foreach(new I as $v) echo $v;\")))))\n  (testing \"IteratorAggregate supplies the live iterator\"\n    (is (= \"23\" (:php/out (h/run-raw\n                            \"<?php class I implements Iterator {private $i=2;function rewind():void{}function valid():bool{return $this->i<4;}function current(){return $this->i;}function key(){return $this->i;}function next():void{$this->i++;}} class A implements IteratorAggregate {function getIterator():Iterator{return new I;}} foreach(new A as $v)echo $v;\")))))\n  (testing \"property iteration filters visibility from the calling scope\"\n    (is (= \"aabc\" (:php/out (h/run-raw\n                              \"<?php class P {public $a='a'; protected $b='b'; private $c='c'; function f(){foreach($this as $v)echo $v;}} $p=new P;foreach($p as $v)echo $v;$p->f();\")))))\n  (testing \"ArrayAccess reads by value; Countable and Stringable dispatch\"\n    (is (= \"43s\" (:php/out (h/run-raw\n                             \"<?php class A implements ArrayAccess, Countable, Stringable {function offsetExists($x):bool{return true;} function offsetGet($x){return 4;} function offsetSet($x,$v):void{} function offsetUnset($x):void{} function count():int{return 3;} function __toString():string{return 's';}} $a=new A;echo $a[0],count($a),(string)$a;\"))))))\n\n\n(def ^:private opts\n  {:make-stream tu/make-stream\n   :capability-secret tu/secret\n   :primitives vm/primitives\n   :modules (h/host-registry)})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(def ^:private final-vms\n  {:ast-walker (fn [ast _] (vm/eval (tu/create-vm opts) ast))\n   :semantic (fn [_ datoms] (vm/run (load-semantic (semantic/create-vm opts) datoms)))\n   :stack (fn [ast _]\n            (vm/run (dvm/create-vm\n                      (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                      (assoc opts :contract vm/stack-contract))))\n   :register (fn [ast _]\n               (vm/run (rvm/create-vm\n                         (derive/register-image (:vector (sr-linearize/project ast)))\n                         (assoc opts :contract vm/register-contract))))})\n\n\n(defn- deep-size\n  \"Count shared compound values once, including closure/continuation payloads.\"\n  [x]\n  (let [seen (IdentityHashMap.)]\n    (loop [work [x], size 0]\n      (if (empty? work)\n        size\n        (let [x (peek work)\n              work (pop work)\n              compound? (or (values/host-typed? x) (coll? x))]\n          (if (and compound? (.put seen x true))\n            (recur work size)\n            (recur (cond\n                     (values/host-typed? x) (conj work (values/payload x))\n                     (map? x) (into (into work (keys x)) (vals x))\n                     (coll? x) (into work x)\n                     :else work)\n                   (inc size))))))))\n\n\n(defn- live-after-collection\n  \"[live cell count, deep size of cell contents] after normal PHP completion\n   and collection with the suspended generator h as the only extra root. The\n   program's `$it->self = $it` cycle preserves h after module cleanup.\"\n  [k source]\n  (let [ast (:ast (h/lower-program source))\n        final ((get final-vms k) ast (vm/ast->datoms ast))\n        roots (into []\n                    (keep (fn [[id {:keys [value seal]}]]\n                            (when (and (= :obj (:php/type value))\n                                       (= \"Generator\" (:class value))\n                                       (= \"h\" (get-in value [:gen :name]))\n                                       (= :suspended (get-in value [:gen :state])))\n                              {:type :cell-ref, :id id, :seal seal})))\n                    (:heap final))]\n    (is (= 1 (count roots)) (str k \" one suspended delegating generator h\"))\n    (let [heap (:heap (engine/collect final roots))]\n      [(count heap)\n       (deep-size (mapv :value (vals heap)))])))\n\n\n(defn- changing-caller-source\n  [n]\n  (str \"<?php function g() { $i=0; while (true) { yield $i; $i++; } }\"\n       ;; Own the delegate across caller statements, whose temporary cleanup\n       ;; would otherwise release the bare g() result while h is suspended.\n       \" function h() { $d=g(); yield from $d; } $it=h(); $it->self=$it;\"\n       \" function byFunction($x) { $x->next(); }\"\n       \" function byGenerator($x) { yield $x->current(); $x->next(); }\"\n       \" $k=0; while ($k < \" n \") {\"\n       \" if ($k % 2 == 0) { byFunction($it); }\"\n       \" else { $j=byGenerator($it); $j->current(); $j->next(); } $k++; }\"))\n\n\n(deftest ^:slow reachable-heap-is-stable-under-delegation-test\n  (doseq [k vms]\n    (testing (str k)\n      (let [small (live-after-collection k (changing-caller-source 10))\n            large (live-after-collection k (changing-caller-source 1000))]\n        (when (and small large)\n          (is (= small large)))))))\ndocs/agents/build-n-test.md:31:# Run test:slow / test:all before a big merge or a commit that touches many parts.\ndocs/agents/build-n-test.md:88:change (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\ndocs/agents/build-n-test.md:89:antlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\ndocs/agents/build-n-test.md:290:clj -M:kondo --lint <path>\ndocs/agents/build-n-test.md:439:| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\ndocs/agents/build-n-test.md:440:| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\ndocs/agents/build-n-test.md:443:that is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\ndocs/agents/build-n-test.md:555:same commit, with a name like `~/ci/datomworld-<name>-dart`:\ndocs/agents/build-n-test.md:674:### Measured times (first runs, 2026-10-11, commit 84c7c9b7, 