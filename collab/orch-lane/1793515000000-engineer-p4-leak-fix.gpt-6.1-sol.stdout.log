{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"tail -30 target/profile/p4-resume-chain-focused.log && sed -n '1390,1480p' src/cljc/yang/python/antlr/prelude.cljc && rg -n 'gen-enter|gen-switch|yield-raw' src/cljc/yang/python/antlr/prelude.cljc && rg -n '\"'^'\"\\\\(def|assoc|select-keys' src/cljc/yang/php/antlr/prelude.cljc | head -35\"","aggregated_output":"Loading initial Timbre config from: :default\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.php.antlr.generators-test\nREACHABLE-HEAP :ast-walker $k < 10 [151 171339]\n     ;; floor of a finite real within 2^53, as an integer (the bound is\n     ;; built from safe integer literals)\n     (fn [x]\n       (if (if (< x (* 2 4503599627370496)) (> x (* -2 4503599627370496)) false)\n         (if (< x 0)\n           (let [y (- 0 x)\n                 f (py/floor-descend y 0 (/ (py/pow2-above y 1) 2))]\n             (if (<= y f) (- 0 f) (- (- 0 f) 1)))\n           (py/floor-descend x 0 (/ (py/pow2-above x 1) 2)))\n         (py/raise-new py.b/OverflowError\n                       {:py/str \"float floor outside the supported range\"})))]\n    [py/division-check\n     (fn [a b]\n       (if (py/numeric? a)\n         (if (py/numeric? b)\n           (if (py/zero? b)\n             (py/raise-new py.b/ZeroDivisionError\n                           {:py/str \"integer division or modulo by zero\"})\n             true)\n           (py/type-error {:py/str \"unsupported operand type\"}))\n         (py/type-error {:py/str \"unsupported operand type\"})))]\n    [py/division-operands\n     (fn [a b message]\n       (if (if (py/numeric? a) (py/numeric? b) false)\n         (if (if (py/int? a) (py/int? b) false)\n           (do (py/division-check a b)\n               (py/vconj (py/vconj [] (py/num a)) (py/num b)))\n           (let [x (py/as-float a) y (py/as-float b)]\n             (do (if (py/zero? y)\n                   (py/raise-new py.b/ZeroDivisionError (py/str message))\n                   :py/None)\n                 (py/vconj (py/vconj [] x) y))))\n         (py/type-error {:py/str \"unsupported operand type\"})))]\n    [py/divmod-values\n     (fn [a b message]\n       (let [xy (py/division-operands a b message)]\n         (if (if (py/int? a) (py/int? b) false)\n           (py/int-result (integer/floor-div-mod (get xy 0) (get xy 1)))\n           (py/float-divmod (get xy 0) (get xy 1)))))]\n    [py/floordiv\n     (fn [a b]\n       (let [q (get (py/divmod-values a b \"float floor division by zero\")\n                    0)]\n         (if (if (py/int? a) (py/int? b) false) q (py/float q))))]\n    [py/mod\n     (fn [a b]\n       (let [xy (py/division-operands a b \"float modulo\")]\n         (if (if (py/int? a) (py/int? b) false)\n           (get (py/int-result\n                  (integer/floor-div-mod (get xy 0) (get xy 1))) 1)\n           (py/float (py/float-mod (get xy 0) (get xy 1))))))]\n    [py/divmod\n     (fn [a b]\n       (let [qr (py/divmod-values a b \"float divmod()\")]\n         (py/tuple\n           (if (if (py/int? a) (py/int? b) false)\n             qr\n             (py/vconj (py/vconj [] (py/float (get qr 0)))\n                       (py/float (get qr 1)))))))]\n    [py/fpow\n     ;; float base ** e for an integer e >= 0\n     (fn [base e]\n       (if (= e 0)\n         (data/float-value 1)\n         (let [h (py/fpow base (py/int-result (integer/shift-right e 1)))\n               hh (* h h)]\n           (if (= (integer/bit-and e 1) 0) hh (* hh base)))))]\n    [py/power-overflow\n     ;; OverflowError(34, 'Result too large'), the errno pair CPython's\n     ;; float pow raises (measured on macOS, int-conv-v1)\n     (fn []\n       (let [e (py/make-instance py.b/OverflowError)]\n         (do (py/setattr e \"args\"\n                         (py/tuple [34 {:py/str \"Result too large\"}]))\n             (py/raise e))))]\n    [py/negative-power\n     ;; x ** -n for an integer n > 0: 1 / x^n while x^n is finite, so\n     ;; every exact case is exact; when x^n overflows, the reciprocals of\n     ;; its two halves, so 2 ** -1074 is 5e-324. Underflow overflows.\n     (fn [x n]\n       (let [p (py/fpow x n)]\n         (if (py/finite? p)\n           (if (py/zero? p)\n             (py/power-overflow)\n             (/ (data/float-value 1) p))\n           (let [h (py/int-result (integer/shift-right n 1))]\n             (* (/ (data/float-value 1) (py/fpow x h))\n                (/ (data/float-value 1)\n                   (py/fpow x (py/int-result (integer/sub n h)))))))))]\n    [py/power-special\n     ;; x ** y for a NaN or infinite y: CPython's table by |x| against 1\n41:                     and the slots of its state (see `py/gen-switch`)\n406:    ;; RecursionError before anything is written. `py/gen-switch` sends\n417:    [py/gen-switch\n439:                 (py/gen-enter g c st msg)))))))]\n440:    [py/gen-enter\n484:    [py/yield-raw\n503:       (let [m (py/yield-raw g v)]\n523:       (let [o (py/gen-switch g (py/outcome :send :py/None))\n530:         (py/gen-result (py/gen-switch g (py/outcome :send v)) :py/missing)))]\n537:           (py/gen-switch g (py/outcome :throw (py/throw-exc typ val)))\n568:       (let [o (py/gen-switch\n596:           (py/gen-result (py/gen-switch it (py/outcome :send :py/None)) default)\n614:           (py/delegate g d (py/yield-raw g (get o 1)))\n631:               (if gen? (py/stop-as-return (py/gen-switch d msg)) (py/outcome :raise v)))\n633:               (py/gen-switch d msg)\n81:(def host-names\n95:(defquoted ^:private core-definitions\n161:       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\n167:                  (assoc saved :base (get (cell/get php.rt/ctx) :base))))]\n170:     (fn [hs] (cell/set! php.rt/ctx (assoc (cell/get php.rt/ctx) :handlers hs)))]\n181:                  (assoc (assoc (cell/get php.rt/ctx) :handlers (get hs 2))\n260:             (assoc (assoc (assoc (assoc {} :php/type :obj) :class cls) :ord n)\n262:                    (assoc (assoc (assoc {} \"message\" msg) \"code\" 0)\n268:         (assoc (assoc {} :class (get e :class))\n270:         (assoc (assoc {} :class (get (php/obj-state e) :class))\n274:       (assoc (assoc (assoc {} :php.diag/warning true) :errno errno)\n326:         (cell/set! php.rt/out (assoc bufs i (conj (get bufs i) s)))))]\n1141:           (assoc arr :next-index (php/succ-key k))\n1143:             (assoc arr :next-index (php/succ-key k))\n1243:       (assoc {} :php/ref\n1244:              (cell/new (assoc (assoc (assoc (assoc (assoc {} :php/type :ref)\n1252:       (assoc {} :php/arr\n1253:              (cell/new (assoc (assoc (assoc (assoc (assoc (assoc (assoc {} :php/type :arr)\n1265:             (assoc {} :php/obj\n1266:                    (cell/new (assoc (assoc (assoc (assoc (assoc (assoc (assoc {} :php/type :obj)\n1275:       (cell/new (assoc (assoc (assoc (assoc {} :php/type :iter)\n1291:             (do (cell/set! c (assoc (cell/get c) :rc (+ (get (cell/get c) :rc) 1))) x)))))]\n1300:               (do (cell/set! c (assoc (cell/get c) :rc n))\n1322:             (do (cell/set! c (assoc st :released? true))\n1327:               (do (cell/set! c (assoc (cell/get c) :released? true))\n1348:           (do (cell/set! c (assoc (assoc st :destructed? true) :released? true))\n1380:                             (assoc acc :index (assoc (get acc :index) kk y))\n1381:                             (if (php/counted? y) (assoc accd kk true) accd)))))\n1393:         (do (cell/set! (get n :php/arr) (assoc (cell/get (get n :php/arr)) :ptr (get st :ptr)))\n1415:             (do (cell/set! c (assoc (assoc st :value (php/table-set (get st :value) k v))\n1418:                                       (assoc (get st :deps) k true)\n1422:             (php/new-arr (php/table-set cont k v) (assoc {} k true))\n1443:             (do (cell/set! rc (assoc st :value v3))\n1457:           (do (cell/set! c (assoc (assoc st :value (php/array-unset (get st :value) k))\n1472:             (cell/set! rc (assoc (cell/get rc) :value v)))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '417,506p' src/cljc/yang/python/antlr/prelude.cljc && rg -n 'gen-enter|gen-start|yield-raw' docs/design/yang.php.md && sed -n '1,120p' test/yang/php/antlr/zz_probe_test.clj && sed -n '1,100p' test/yang/php/antlr/objects_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '417,506p' src/cljc/yang/python/antlr/prelude.cljc && rg -n 'gen-enter|gen-start|yield-raw' docs/design/yang.php.md && sed -n '1,120p' test/yang/php/antlr/zz_probe_test.clj && sed -n '1,100p' test/yang/php/antlr/objects_test.clj\"","aggregated_output":"    [py/gen-switch\n     (fn [g msg]\n       (let [c (cell/get g)\n             st (get c :state)]\n         (if (= st :running)\n           (py/raise-new py.b/ValueError {:py/str \"generator already executing\"})\n           (if (= st :closed)\n             (if (= (get msg 0) :throw)\n               (py/outcome :raise (get msg 1))\n               (py/outcome :return :py/None))\n             (if (if (= st :created) (= (get msg 0) :throw) false)\n               ;; thrown into a generator that never ran: it closes, and\n               ;; the exception is the caller's\n               (do (cell/set! g (py/gen-content (get c :name) :closed))\n                   (py/outcome :raise (get msg 1)))\n               ;; admission: the generator's frame must fit under the limit,\n               ;; checked before anything is written, so a refusal raises on\n               ;; the caller's stack and leaves the generator as it was\n               (if (< (cell/get py.rt/limit)\n                      (+ 1 (py/abs-depth (cell/get py.rt/ctx))))\n                 (py/raise-new py.b/RecursionError\n                               {:py/str \"maximum recursion depth exceeded\"})\n                 (py/gen-enter g c st msg)))))))]\n    [py/gen-enter\n     ;; the crossing into a generator that start or resume admitted\n     (fn [g c st msg]\n       (let [flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (cell/set! g (assoc (assoc (py/gen-content (get c :name) :running)\n                                             :return r)\n                                      :caller-ctx (cell/get py.rt/ctx)))\n                  (if (= st :created)\n                    (py/gen-start g (get c :body))\n                    (do (cell/set! py.rt/ctx\n                                   (assoc (get c :ctx) :base (py/crossing-base g)))\n                        ((get c :resume) msg))))\n              r))\n          (%capture))))]\n    [py/crossing-base\n     ;; a running generator's :base: its resumer's absolute depth, plus one\n     ;; for the generator's own frame\n     (fn [g] (+ 1 (py/abs-depth (get (cell/get g) :caller-ctx))))]\n    [py/gen-start\n     ;; a fresh handler stack whose only frame is the boundary: an exception\n     ;; no handler in the body catches reaches it and leaves the generator\n     (fn [g body]\n       (do (cell/set! py.rt/ctx (py/ctx nil 0 (py/crossing-base g) nil))\n           (py/set-handlers! (py/frame :generator (fn [e] (py/gen-fail g e)) nil))\n           (py/gen-exit g (py/outcome :return (body g)))))]\n    [py/gen-exit\n     ;; the single way out of a finishing generator: closed, the caller's\n     ;; dynamic context back, the outcome delivered to the active switch\n     (fn [g outcome]\n       (let [c (cell/get g)]\n         (do (cell/set! g (py/gen-content (get c :name) :closed))\n             (cell/set! py.rt/ctx (get c :caller-ctx))\n             ((get c :return) outcome))))]\n    [py/gen-fail\n     ;; PEP 479: a StopIteration escaping the body is a RuntimeError\n     (fn [g e]\n       (py/gen-exit g (py/outcome :raise\n                                  (if (py/subclass? (py/type-of e) py.b/StopIteration)\n                                    (py/make-exc py.b/RuntimeError\n                                                 {:py/str \"generator raised StopIteration\"})\n                                    e))))]\n    [py/yield-raw\n     ;; suspend, answering the message the next switch sends\n     (fn [g v]\n       (let [flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (let [c (cell/get g)]\n                (do (cell/set! flag :re-entered)\n                    (cell/set! g (assoc (assoc (py/gen-content (get c :name) :suspended)\n                                               :resume r)\n                                        :ctx (cell/get py.rt/ctx)))\n                    (cell/set! py.rt/ctx (get c :caller-ctx))\n                    ((get c :return) (py/outcome :yield v))))\n              r))\n          (%capture))))]\n    [py/yield\n     ;; `yield v`: the value sent, or the exception thrown raised here, on\n     ;; the generator's own stack\n     (fn [g v]\n       (let [m (py/yield-raw g v)]\n         (if (= (get m 0) :throw) (py/raise (get m 1)) (get m 1))))]\n    [py/gen-result\n     ;; a switch's outcome at a protocol boundary, in the caller: the value\n344:onto the landed C2 core (switch, yield-raw, exit, flag cells, a per-generator\n(ns yang.php.antlr.zz-probe-test\n  \"Throwaway probe: run P6 fixtures of the groups in PROBE_GROUPS on the\n   semantic VM and print out/expected. Deleted before the report.\"\n  (:require\n    [clojure.test :refer [deftest is]]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.linked-harness :as lh]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.programs-p6 :as p6]\n    [yin.vm :as vm]))\n\n\n(defn- observed\n  [value]\n  [(h/latin1->text (:php/out value))\n   (mapv (juxt :errno :message) (:php/diag value))\n   (some-> (:php/uncaught value) (select-keys [:class :message]))])\n\n\n(defn- dump\n  [pk n d]\n  (println (apply str (repeat d \"  \")) (or (:rule n) (str (:type n) \" \" (pr-str (:text n)))))\n  (doseq [k (yang.antlr.packet/children pk n)] (dump pk k (inc d))))\n\n\n(deftest dump-test\n  (let [pk (cst/parse-source \"<?php namespace A; use B\\\\C as D; echo 1;\")]\n    (dump pk (yang.antlr.packet/root pk) 0)))\n\n\n(deftest probe\n  (let [groups (set (map keyword (re-seq #\"[a-z0-9-]+\" (slurp \"test/yang/php/antlr/zz_probe1.cfg\"))))\n        ids (some-> nil (clojure.string/split #\",\") (->> (map keyword) set))]\n    (doseq [{:keys [id group units source out diag] :as fx} p6/all-fixtures\n            :when (and (contains? groups group) (or (nil? ids) (contains? ids id)))]\n      (let [packets (if units (update-vals units cst/parse-source) {\"main.php\" (cst/parse-source source)})\n            r (try\n                (let [others (cond-> (mapv (fn [[path packet]] {:name path, :packet packet}) (dissoc packets \"main.php\"))\n                               (:class-map fx) (conj (assoc (:class-map fx) :name lower/classmap-name)))\n                      result (lh/publish-units! others)\n                      {:keys [ast warnings]} (lower/lower-program (get packets \"main.php\")\n                                                                  {:prelude :linked,\n                                                                   :path \"main.php\",\n                                                                   :class-map (boolean (:class-map fx))\n                                                                   :paths (when (:computed fx) (keys (:addresses result)))})\n                      src (lh/source (lh/name-env result))]\n                  {:obs (mapv (fn [k] [k (observed (vm/value (lh/run-linked k ast src)))]) [:semantic :stack :register]),\n                   :warnings warnings})\n                (catch Throwable e {:threw (str (ex-message e) \" \" (pr-str (ex-data e)))}))]\n        (let [want [out (vec diag) (:uncaught fx)]\n              ok? (and (:obs r) (every? (fn [[_ o]] (= want o)) (:obs r))\n                       (or (not (:warnings fx)) (= (:warnings fx) (mapv :yang.php/diagnostic (:warnings r)))))]\n          (println \"==\" id (if ok? \"OK\" \"DIFF\"))\n          (when-not ok?\n            (println \"   expected:\" (pr-str want) (pr-str (:warnings fx)))\n            (println \"   actual:  \" (pr-str (or (:obs r) (:threw r))))))\n        (is true)))))\n(ns yang.php.antlr.objects-test\n  \"P4 S2 end to end: classes, objects, properties, methods, visibility and\n   Throwable objects, from PHP source on the JVM. The enabled P4 fixtures run\n   against their pinned `:out`; a fixture without one (to be recorded on\n   shiva) must run to completion without an uncaught error. The tests after\n   it cover S2 behavior the fixtures do not.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.programs-p4 :as p4]))\n\n\n(defn- out\n  [source]\n  (:php/out (h/run-raw source)))\n\n\n(defn- diag\n  [source]\n  (mapv (juxt :errno :message) (:php/diag (h/run-raw source))))\n\n\n(defn- uncaught\n  [source]\n  (-> (h/run-raw source) :php/uncaught :message))\n\n\n(deftest enabled-p4-fixtures-test\n  (doseq [fixture p4/enabled\n          :let [{:keys [id source throws impl-out] oracle-out :out} fixture\n                expected (or impl-out oracle-out)]]\n    (let [r (h/run-raw source)]\n      (when-not throws (is (nil? (:php/uncaught r)) (name id)))\n      (when-let [diag (:diag fixture)]\n        (is (= diag (mapv (juxt :errno :message) (:php/diag r))) (name id)))\n      (when expected\n        (is (= expected (:php/out r)) (name id))))))\n\n\n(deftest objects-s2-test\n  (testing \"a static method call forwards the static class\"\n    (is (= \"AB\"\n           (out (str \"<?php class A { static function n() { return static::class; }\"\n                     \" static function m() { return self::n(); } }\"\n                     \" class B extends A {} echo A::m(), B::n();\")))))\n  (testing \"dynamic properties and undefined property reads\"\n    (is (= \"5\" (out \"<?php class A {} $a = new A; $a->k = 5; echo $a->k;\")))\n    (is (= \"\" (out \"<?php class A {} $a = new A; echo $a->zz;\")))\n    (is (= [[2 \"Undefined property: A::$zz\"]]\n           (diag \"<?php class A {} $a = new A; echo $a->zz;\"))))\n  (testing \"isset, unset and nested property writes\"\n    (is (= \"10\" (out (str \"<?php class A { public $x = 1; } $a = new A; echo isset($a->x) ? 1 : 0;\"\n                          \" unset($a->x); echo isset($a->x) ? 1 : 0;\"))))\n    (is (= \"7\" (out \"<?php class A { public $d = []; } $a = new A; $a->d['k'] = 7; echo $a->d['k'];\"))))\n  (testing \"property access on a non-object\"\n    (is (= [[2 \"Attempt to read property \\\"p\\\" on null\"]]\n           (diag \"<?php $n = null; echo $n->p;\")))\n    (is (= \"Attempt to assign property \\\"p\\\" on null\"\n           (uncaught \"<?php $n = null; $n->p = 1;\"))))\n  (testing \"visibility of methods and constructors\"\n    (is (= \"Call to private method A::f() from global scope\"\n           (uncaught \"<?php class A { private function f() {} } (new A)->f();\")))\n    (is (= \"Call to protected method A::f() from global scope\"\n           (uncaught \"<?php class A { protected function f() {} } $a = new A; $a->f();\")))\n    (is (= \"Call to private A::__construct() from global scope\"\n           (uncaught \"<?php class A { private function __construct() {} } new A;\")))\n    (is (= \"x\" (out (str \"<?php class A { private function f() { return 'x'; }\"\n                         \" function g() { return $this->f(); } } $a = new A; echo $a->g();\")))))\n  (testing \"a private method of the calling class is not overridden by the subclass\"\n    (is (= \"ab\"\n           (out (str \"<?php class A { private function f() { return 'a'; }\"\n                     \" function g() { return $this->f(); } }\"\n                     \" class B extends A { function f() { return 'b'; } }\"\n                     \" $b = new B; echo $b->g(), $b->f();\")))))\n  (testing \"__call, __callStatic and __invoke\"\n    (is (= \"m2\" (out \"<?php class A { function __call($n, $a) { return $n . count($a); } } $a = new A; echo $a->m(1, 2);\")))\n    (is (= \"s1\" (out \"<?php class A { static function __callStatic($n, $a) { return $n . count($a); } } echo A::s(1);\")))\n    (is (= \"7\" (out \"<?php class A { function __invoke($x) { return $x + 1; } } $f = new A; echo $f(6);\"))))\n  (testing \"class-level errors\"\n    (is (= \"Class \\\"Nope\\\" not found\" (uncaught \"<?php new Nope;\")))\n    (is (= \"Cannot instantiate interface I\" (uncaught \"<?php interface I {} new I;\")))\n    (is (= \"Non-static method A::f() cannot be called statically\"\n           (uncaught \"<?php class A { function f() {} } A::f();\"))))\n  (testing \"anonymous classes stay refused\"\n    (is (= :anonymous-class\n           (-> (h/run-php \"<?php $o = new class { public $x = 1; };\") :diagnostics first :construct))))\n  (testing \"Throwable objects: previous and code, a user constructor, an uncaught fatal\"\n    (is (= \"p3\" (out (str \"<?php $e = new Exception('o', 3, new Exception('p'));\"\n                          \" echo $e->getPrevious()->getMessage(), $e->getCode();\"))))\n    (is (= \"xabc\"\n           (out (str \"<?php class E extends Exception { function __construct($m) { parent::__construct('x' . $m); } }\"\n                     \" try { throw new E('abc'); } catch (E $e) { echo $e->getMessage(); }\"))))\n    (is (= {:class \"E\", :message \"boom\"}\n           (-> (h/run-raw \"<?php class E extends Exception {} throw new E('boom');\") :php/uncaught)))))\n\n\n(deftest checkpoint-b-typed-property-destructuring-reference-test\n  (let [r (h/run-raw\n            (str \"<?php class C { public int $p = 0; } $o = new C; $a = [5]; \"\n                 \"[&$o->p] = $a; \"\n","exit_code":0,"status":"completed"}}
