hp/json-encode (php/array-get a (get (php/array-order a) i)) pretty (+ depth 1) maxdepth throw?)]\n   694\t           (if (= (php/kind child) :string)\n   695\t             (let [k (get (php/array-order a) i) sep (if (= i 0) \"\" \",\")\n   696\t                   br (if pretty (data/str-concat \"\\n\" (php/json-indent (+ depth 1) \"\")) \"\")\n   697\t                   colon (if pretty \": \" \":\")]\n   698\t               (php/json-array-pairs a pretty depth maxdepth throw? (+ i 1)\n   699\t                                     (data/str-concat out sep br (php/json-key k) colon child)))\n   700\t             child))\n   701\t         (data/str-concat out (if (if pretty (> i 0) false) (data/str-concat \"\\n\" (php/json-indent depth \"\")) \"\") \"}\")))]\n   702\t    [php/json-encode-value\n   703\t     ;; a nested failure answers false (throw mode already threw); callers\n   704\t     ;; must not concatenate the delimiter onto it, which the host refuses\n   705\t     (fn [s open]\n   706\t       (if (= (php/kind s) :string) (data/str-concat open s) s))]\n   707\t    [php/json-encode\n   708\t     (fn [v pretty depth maxdepth throw?]\n   709\t       (let [k (php/kind v)]\n   710\t         (if (= k :null) \"null\"\n   711\t             (if (= k :bool) (if v \"true\" \"false\")\n   712\t                 (if (= k :string) (php/json-string v)\n   713\t                     (if (= k :int) (integer/format v)\n   714\t                         (if (= k :float)\n   715\t                           (let [h (php/h v)]\n   716\t                             (if (if (php/nan? h) true (= (php/abs-h h) (php/inf)))\n   717\t                               (php/json-encode-fail throw? \"Inf and NaN cannot be JSON encoded\")\n   718\t                               (php/float-text v 17)))\n   719\t                           (if (= k :array)\n   720\t                             ;; the top-level container is depth level 1, so\n   721\t                             ;; [1] at depth 1 fails,