tent\n   747\t     (fn [st out]\n   748\t       (let [cs (get (cell/get st) 0) i (get (cell/get st) 1)]\n   749\t         (if (>= i (data/count cs)) (php/json-fail st \"Unterminated string\")\n   750\t             (let [c (get cs i)]\n   751\t               (if (< c 32) (php/json-fail st \"Syntax error\")\n   752\t                   (do (php/json-index! st (+ i 1))\n   753\t                       (if (= c 34) out\n   754\t                           (if (= c 92) (php/json-read-escape st out)\n   755\t                               (php/json-read-string-loop st (php/vconj out c))))))))))]\n   756\t    [php/json-read-escape\n   757\t     ;; only the grammar's escapes are accepted; anything else is a syntax\n   758\t     ;; error, never a silent literal\n   759\t     (fn [st out]\n   760\t       (let [cs (get (cell/get st) 0) i (get (cell/get st) 1)]\n     1\t(ns yang.php.antlr.builtin-surfaces-test\n     2\t  \"P9 builtin surfaces, dynamic scopes, and corner closures.\"\n     3\t  (:require\n     4\t    [clojure.test :refer [deftest is testing]]\n     5\t    [yang.php.antlr.e2e-harness :as h]\n     6\t    [yang.php.antlr.programs-p9 :as p9]))\n     7\t\n     8\t\n     9\t(deftest p9-fixtures-test\n    10\t  (doseq [{:keys [id source out diag]} p9/fixtures]\n    11\t    (testing (name id)\n    12\t      (let [r (h/run-raw source)]\n    13\t        (is (= out (:php/out r)))\n    14\t        (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))))\n    15\t        (is (nil? (:php/uncaught r)))))))\n    16\t\n    17\t\n    18\t(deftest p9-contracts-test\n    19\t  (let [out (fn [source] (:php/out (h/run-raw source)))\n    20\t        diag (fn [source] (mapv (juxt :errno :message) (:php/diag (h/run-raw source))))]\n    21\t    (testing \"empty search returns the subject, never empty output\"\n    22\t      (is (= \"a\" (out \"<?php echo str_replace('', 'x', 'a');\")))\n    23\t      (is (= \"a\" (out \"<?php echo str_ireplace('', 'x', 'a');\"))))\n    24\t    (testing \"search/replacement/subject arrays and the count output\"\n    25\t      (is (= \"x x x\" (out \"<?php echo str_replace(['a', 'b'], 'x', 'a b a');\")))\n    26\t      (is (= \"Xb\" (out \"<?php echo str_ireplace('A', 'X', 'ab');\")))\n    27\t      (is (= \"bb2\" (out \"<?php $c = 0; echo str_replace('a', 'b', 'aa', $c), $c;\")))\n    28\t      (is (= \"ay|by\" (out \"<?php echo implode('|', str_replace('x', 'y', ['ax', 'bx']));\"))))\n    29\t    (testing \"str_pad never truncates; empty pad with work to do is a ValueError\"\n    30\t      (is (= \"abcd\" (out \"<?php echo str_pad('abcd', 2);\")))\n    31\t      (is (= \"x  \" (out \"<?php echo str_pad('x', 3);\")))\n    32\t      (is (= \"-x--\" (out \"<?php echo str_pad('x', 4, '-', STR_PAD_BOTH);\")))\n    33\t      (is (= \"ValueError\" (out \"<?php try { str_pad('x', 3, ''); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    34\t    (testing \"strrpos offsets bound the search\"\n    35\t      (is (= \"3\" (out \"<?php echo strrpos('hello', 'l', 3);\")))\n    36\t      (is (= \"\" (out \"<?php echo strrpos('hello', 'l', 4);\")))\n    37\t      (is (= \"3\" (out \"<?php echo strrpos('hello', 'l', -2);\")))\n    38\t      (is (= \"ValueError\" (out \"<?php try { strrpos('hello', 'l', 6); } catch (ValueError $e) { echo 'ValueError'; }\")))\n    39\t      (is (= \"ValueError\" (out \"<?php try { strrpos('hello', 'l', -6); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    40\t    (testing \"trim character masks with ranges\"\n    41\t      (is (= \"a\" (out \"<?php echo trim('xxaxx', 'x');\")))\n    42\t      (is (= \"def\" (out \"<?php echo trim('abcdef', 'a..c');\"))))\n    43\t    (testing \"single-array array_map keeps keys; multi-array is variadic\"\n    44\t      (is (= \"a,b\" (out \"<?php echo implode(',', array_keys(array_map(fn($x) => $x * 2, ['a' => 1, 'b' => 2])));\")))\n    45\t      (is (= \"11,22\" (out \"<?php echo implode(',', array_map(fn($a, $b) => $a + $b, [1, 2], [10, 20]));\")))\n    46\t      (is (= \"b\" (out \"<?php $r = array_map(null, [1, 2], ['a', 'b']); echo $r[1][1];\"))))\n    47\t    (testing \"array_unique defaults to SORT_STRING: '1.0' and '1' are distinct strings\"\n    48\t      (is (= \"1.0,1\" (out \"<?php echo implode(',', array_unique(['1.0', '1']));\")))\n    49\t      (is (= \"1.0,1\" (out \"<?php echo implode(',', array_unique(['1.0', '1'], SORT_STRING));\")))\n    50\t      (is (= \"1.0\" (out \"<?php echo implode(',', array_unique(['1.0', '1'], SORT_NUMERIC));\")))\n    51\t      (is (= \"1.0\" (out \"<?php echo implode(',', array_unique(['1.0', '1'], SORT_REGULAR));\"))))\n    52\t    (testing \"diff/intersect take further arrays\"\n    53\t      (is (= \"1,4\" (out \"<?php echo implode(',', array_diff([1, 2, 3, 4], [2], [3]));\")))\n    54\t      (is (= \"3\" (out \"<?php echo implode(',', array_intersect([1, 2, 3], [2, 3], [3, 4]));\"))))\n    55\t    (testing \"diff/intersect compare as strings\"\n    56\t      (is (= \"1.0\" (out \"<?php echo implode(',', array_diff(['1.0'], ['1']));\")))\n    57\t      (is (= \"\" (out \"<?php echo implode(',', array_intersect(['1.0'], ['1']));\"))))\n    58\t    (testing \"array_splice normalizes bounds; omitted replacement removes\"\n    59\t      (is (= \"1,3|2\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1); echo implode(',', $a), '|', implode(',', $r);\")))\n    60\t      (is (= \"1,2|3\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, -1); echo implode(',', $a), '|', implode(',', $r);\"))))\n    61\t    (testing \"array_splice drops replacement string keys; null replaces with nothing\"\n    62\t      (is (= \"1,8,9,3|2\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1, ['x' => 8, 9]); echo implode(',', $a), '|', implode(',', $r);\")))\n    63\t      (is (= \"1,3|2\" (out \"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1, null); echo implode(',', $a), '|', implode(',', $r);\"))))\n    64\t    (testing \"range with a zero step is a ValueError, not a hang\"\n    65\t      (is (= \"ValueError\" (out \"<?php try { range(1, 3, 0); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    66\t    (testing \"JSON escapes control bytes instead of replacing them\"\n    67\t      (is (= \"\\\"\\\\u0001\\\"\" (out \"<?php echo json_encode(\\\"\\\\x01\\\");\"))))\n    68\t    (testing \"JSON rejects trailing commas, bad escapes and unchecked separators\"\n    69\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('[1,]'));\")))\n    70\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('\\\"\\\\\\\\q\\\"'));\")))\n    71\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('{\\\"a\\\" 4}'));\"))))\n    72\t    (testing \"JSON enforces depth and JSON_THROW_ON_ERROR\"\n    73\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('[[1]]', true, 1));\")))\n    74\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('[1]', true, 1));\")))\n    75\t      (is (= \"threw\" (out \"<?php try { json_decode('[1,]', null, 512, JSON_THROW_ON_ERROR); } catch (JsonException $e) { echo 'threw'; }\")))\n    76\t      (is (= \"threw\" (out \"<?php try { json_encode(INF, JSON_THROW_ON_ERROR); } catch (JsonException $e) { echo 'threw'; }\")))\n    77\t      (is (= \"bool(false)\\n\" (out \"<?php var_dump(json_encode(INF));\"))))\n    78\t    (testing \"JSON keeps plus in exponents; rejects leading plus, leading zeros, raw controls, bad depth and bad flags\"\n    79\t      (is (= \"float(100)\\n\" (out \"<?php var_dump(json_decode('1e+2'));\")))\n    80\t      (is (= \"float(100)\\n\" (out \"<?php var_dump(json_decode('1E+2'));\")))\n    81\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('01'));\")))\n    82\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('-01'));\")))\n    83\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode('+1'));\")))\n    84\t      (is (= \"NULL\\n\" (out \"<?php var_dump(json_decode(\\\"\\\\\\\"\\\\x01\\\\\\\"\\\"));\")))\n    85\t      (is (= \"refused\" (out \"<?php try { json_encode([1], 64); } catch (Error $e) { echo 'refused'; }\")))\n    86\t      (is (= \"refused\" (out \"<?php try { json_decode('[1]', true, 512, 64); } catch (Error $e) { echo 'refused'; }\")))\n    87\t      (is (= \"ValueError\" (out \"<?php try { json_encode([1], 0, 0); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n    88\t    (testing \"an encoding failure answers false with no warning, never a host error\"\n    89\t      (is (= \"bool(false)\\n\" (out \"<?php var_dump(json_encode([INF]));\")))\n    90\t      (is (= [] (diag \"<?php $x = json_encode([INF]);\")))\n    91\t      (is (= [] (diag \"<?php $x = json_encode([1], 0, 1);\")))\n    92\t      (is (= \"bool(false)\\n\" (out \"<?php var_dump(json_encode([1], 0, 1));\")))\n    93\t      (is (= \"threw\" (out \"<?php try { json_encode([INF], JSON_THROW_ON_ERROR); } catch (JsonException $e) { echo 'threw'; }\"))))\n    94\t    (testing \"EXTR constants match PHP and every mode imports per PHP\"\n    95\t      (is (= \"4,5,6\" (out \"<?php echo EXTR_PREFIX_INVALID, ',', EXTR_PREFIX_IF_EXISTS, ',', EXTR_IF_EXISTS;\")))\n    96\t      (is (= \"0\" (out \"<?php echo defined('EXTR_PREFIX_ONLY_IF_EXISTS') ? '1' : '0';\")))\n    97\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], 7); } catch (ValueError $e) { echo 'ValueError'; }\")))\n    98\t      (is (= \"6\" (out \"<?php extract(['z' => 6], EXTR_PREFIX_ALL, 'p_'); echo $p__z;\")))\n    99\t      (is (= \"12\" (out \"<?php $x = 1; extract(['x' => 2], EXTR_PREFIX_SAME, 'p'); echo $x, $p_x;\")))\n   100\t      (is (= \"34\" (out \"<?php $x = 3; extract(['x' => 4], EXTR_PREFIX_IF_EXISTS, 'p'); echo $x, $p_x;\")))\n   101\t      (is (= \"5\" (out \"<?php $n = extract(['0' => 5], EXTR_PREFIX_INVALID, 'p'); echo $p_0;\")))\n   102\t      (is (= \"5\" (out \"<?php $n = extract(['0' => 5], EXTR_PREFIX_ALL, 'p'); echo $p_0;\")))\n   103\t      (is (= \"6\" (out \"<?php $n = extract(['z' => 6], EXTR_PREFIX_ALL, ''); echo $_z;\")))\n   104\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], 8); } catch (ValueError $e) { echo 'ValueError'; }\")))\n   105\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], EXTR_PREFIX_SAME); } catch (ValueError $e) { echo 'ValueError'; }\")))\n   106\t      (is (= \"ValueError\" (out \"<?php try { extract(['x' => 1], EXTR_PREFIX_SAME, '9x'); } catch (ValueError $e) { echo 'ValueError'; }\"))))\n   107\t    (testing \"extract uses binding existence and compact warns on missing names\"\n   108\t      (is (= \"null-kept\" (out \"<?php $x = null; extract(['x' => 4], EXTR_SKIP); echo $x === null ? 'null-kept' : $x;\")))\n   109\t      (is (= [[2 \"compact(): Undefined variable $nope\"]]\n   110\t             (diag \"<?php $a = compact('nope');\")))\n   111\t      (is (= [[2 \"compact(): Each argument must be a string or an array of strings\"]]\n   112\t             (diag \"<?php $a = compact(1);\"))))\n   113\t    (testing \"namespaced user functions shadow extract/compact builtins\"\n   114\t      (is (= \"7\" (out \"<?php namespace N; function extract($a) { return 7; } echo extract([1]);\")))\n   115\t      (is (= \"9\" (out \"<?php namespace N; function compact($a) { return 9; } echo compact('x');\"))))))\n   116\t\n   117\t\n   118\t(deftest p9-compile-refusals-test\n   119\t  (doseq [[source reason]\n   120\t          [[\"<?php eval('$x = 1;');\" :eval]\n   121\t           [\"<?php $x = 1; $n = 'x'; $$n =& $x;\" :dynamic-reference]\n   122\t           [\"<?php [[&$a]] = [[1]];\" :yang.php/compile-error]\n   123\t           [\"<?php $GLOBALS = [];\" :yang.php/compile-error]\n   124\t           [\"<?php unset($GLOBALS);\" :yang.php/compile-error]]]\n   125\t    (testing reason\n   126\t      (let [{:keys [diagnostics]} (h/lower-program source)\n   127\t            d (first diagnostics)]\n   128\t        (is (seq diagnostics))\n   129\t        (is (= reason (or (:construct d) (:yang.php/diagnostic d))))))))\n{:selection :