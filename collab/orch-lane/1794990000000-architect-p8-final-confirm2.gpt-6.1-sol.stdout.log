p binder cannot have a may-fail initializer\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                     {:bindings bindings}))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n          (lower-tail env (list 'let bindings\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                                (list 'loop (vec (mapcat (fn [t] [t t]) targets))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                                      (body-expression body)))))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n      (list 'loop bindings\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n            (lower-tail (with-locals env (mapcat binder-symbols targets))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                        (body-expression body))))))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n(defn- lower-tail\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"The form whose value is the outcome of evaluating `form` in tail position.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  [env form]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n  (cond\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    (seq? form)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n    (if (empty? form)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n      (ok-form form)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n      (let [[head & ops] form]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n        (case (when (symbol? head) head)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n          if (let [[t c & more] ops]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n               (lower-operand env t\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                              (fn [tv]\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                                (list 'if tv (lower-tail env c)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                                      (if (seq more)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                                        (lower-tail env (first more))\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n                          