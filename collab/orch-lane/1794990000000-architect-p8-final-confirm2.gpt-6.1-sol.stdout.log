 echo 'threw'; }\\\"))))\\n     (testing \\\"EXTR constants match PHP and every mode imports per PHP\\\"\\n       (is (= \\\"4,5,6,7\\\" (out \\\"<?php echo EXTR_PREFIX_INVALID, ',', EXTR_PREFIX_IF_EXISTS, ',', EXTR_IF_EXISTS, ',', EXTR_PREFIX_ONLY_IF_EXISTS;\\\")))\\n       (is (= \\\"6\\\" (out \\\"<?php extract(['z' => 6], EXTR_PREFIX_ALL, 'p_'); echo $p__z;\\\")))\\n       (is (= \\\"12\\\" (out \\\"<?php $x = 1; extract(['x' => 2], EXTR_PREFIX_SAME, 'p'); echo $x, $p_x;\\\")))\\n       (is (= \\\"34\\\" (out \\\"<?php $x = 3; extract(['x' => 4], EXTR_PREFIX_IF_EXISTS, 'p'); echo $x, $p_x;\\\")))\\n-      (is (= \\\"5\\\" (out \\\"<?php $n = extract(['0' => 5], EXTR_PREFIX_INVALID, 'p'); echo $p_0;\\\"))))\\n+      (is (= \\\"5\\\" (out \\\"<?php $n = extract(['0' => 5], EXTR_PREFIX_INVALID, 'p'); echo $p_0;\\\")))\\n+      (is (= \\\"5\\\" (out \\\"<?php $n = extract(['0' => 5], EXTR_PREFIX_ALL, 'p'); echo $p_0;\\\")))\\n+      (is (= \\\"6\\\" (out \\\"<?php $n = extract(['z' => 6], EXTR_PREFIX_ALL, ''); echo $_z;\\\")))\\n+      (is (= \\\"ValueError\\\" (out \\\"<?php try { extract(['x' => 1], 8); } catch (ValueError $e) { echo 'ValueError'; }\\\")))\\n+      (is (= \\\"ValueError\\\" (out \\\"<?php try { extract(['x' => 1], EXTR_PREFIX_SAME); } catch (ValueError $e) { echo 'ValueError'; }\\\")))\\n+      (is (= \\\"ValueError\\\" (out \\\"<?php try { extract(['x' => 1], EXTR_PREFIX_SAME, '9x'); } catch (ValueError $e) { echo 'ValueError'; }\\\"))))\\n     (testing \\\"extract uses binding existence and compact warns on missing names\\\"\\n       (is (= \\\"null-kept\\\" (out \\\"<?php $x = null; extract(['x' => 4], EXTR_SKIP); echo $x === null ? 'null-kept' : $x;\\\")))\\n       (is (= [[2 \\\"compact(): Undefined variable $nope\\\"]]\\n-             (diag \\\"<?php $a = compact('nope');\\\"))))\\n+             (diag \\\"<?php $a = compact('nope');\\\")))\\n+      (is (= [[2 \\\"compact(): Each argument must be a string or an array of strings\\\"]]\\n+             (diag \\\"<?php $a = compact(1);\\\"))))\\n     (testing \\\"namespaced user functions shadow extract/compact builtins\\\"\\n       (is (= \\\"7\\\" (out \\\"<?php namespace N; function extract($a) { return 7; } echo extract([1]);\\\")))\\n       (is (= \\\"9\\\" (out \\\"<?php namespace N; function compact($a) { return 9; } echo compact('x');\\\"))))))\\ncommit 004dfb4444ecf026acf70e7d64e45b4041d5ed72\\nAuthor: Sonny To <son.c.to@gmail.com>\\nDate:   Fri Nov 6 02:01:48 2026 +0700\\n\\n    fix(yang.php): the ruled empty-buffer notice — php/warn errno 8 + false\\n\\ndiff --git a/src/cljc/yang/php/antlr/prelude.cljc b/src/cljc/yang/php/antlr/prelude.cljc\\nindex 8c6e7619..39b6b622 100644\\n--- a/src/cljc/yang/php/antlr/prelude.cljc\\n+++ b/src/cljc/yang/php/antlr/prelude.cljc\\n@@ -391,16 +391,22 @@\\n      (fn [args]\\n        (let [bufs (cell/get php.rt/out)]\\n          (if (= (data/count bufs) 1)\\n-           false\\n+           (do (php/warn 8 \\\"ob_end_clean(): Failed to delete buffer. No buffer to delete\\\") false)\\n            (do (cell/set! php.rt/out (php/args-prefix bufs (- (data/count bufs) 1) 0 [])) true))))]\\n     [php/bi-ob-get-clean\\n      (fn [args]\\n-       (let [s (php/bi-ob-get-contents args)]\\n-         (if (= s false) false (do (php/bi-ob-end-clean args) s))))]\\n+       (let [bufs (cell/get php.rt/out)]\\n+         (if (= (data/count bufs) 1)\\n+           (do (php/warn 8 \\\"ob_get_clean(): Failed to delete buffer. No buffer to delete\\\") false)\\n+           (let [s (php/bi-ob-get-contents args)]\\n+             (do (php/bi-ob-end-clean args) s)))))]\\n     [php/bi-ob-end-flush\\n      (fn [args]\\n-       (let [s (php/bi-ob-get-contents args)]\\n-         (if (= s false) false (do (php/bi-ob-end-clean args) (php/echo s) true))))]\\n+       (let [bufs (cell/get php.rt/out)]\\n+         (if (= (data/count bufs) 1)\\n+           (do (php/warn 8 \\\"ob_end_flush(): Failed to delete and flush buffer. No buffer to delete or flush\\\") false)\\n+           (let [s (php/bi-ob-get-contents args)]\\n+             (do (php/bi-ob-end-clean args) (php/echo s) true)))))]\\n     [php/headers-refused?\\n      (fn []\\n        (if (cell/get php.rt/headers-sent)\\ndiff --git a/test/yang/php/antlr/programs_p5.cljc b/test/yang/php/antlr/programs_p5.cljc\\nindex 04c03b27..f5dbdb29 100644\\n--- a/test/yang/php/antlr/programs_p5.cljc\\n+++ b/test/yang/php/antlr/programs_p5.cljc\\n@@ -39,7 +39,8 @@\\n        \\\"aabc\\\")\\n    (fx :output-buffer-flush\\n        \\\"<?php ob_start(); echo 'a'; ob_end_flush(); echo 'b'; var_dump(ob_end_clean());\\\"\\n-       \\\"abbool(false)\\\\n\\\")\\n+       \\\"abbool(false)\\\\n\\\"\\n+       :diag [[8 \\\"ob_end_clean(): Failed to delete buffer. No buffer to delete\\\"]])\\n    (fx :headers-cookies-status\\n        \\\"<?php header('X-One: 1'); setcookie('sid', 'abc'); http_response_code(201); echo http_response_code();\\\"\\n        \\\"201\\\"\\n# Findings — Round B1-r2 residuals (engineer)\\n\\nBranch: `feat/roundB1-p9-contracts`. All six architect residuals fixed in\\nthe prelude sources, each with a regression in\\n`test/yang/php/antlr/builtin_surfaces_test.clj`.\\n\\n## 1. P1 — json_encode nested failure (fixed)\\n\\nRoot cause: `php/json-encode` concatenated `\\\"[\\\"`/`\\\"{\\\"` onto the result of\\n`php/json-array-values`/`php/json-array-pairs` unconditionally. A failed\\nchild (e.g. `INF`) answers `false`, and the host string primitive refuses\\na delimiter + `false` — the \\\"data primitive refused\\\" host error at the old\\nline 648. Fix: new `php/json-encode-value` gate passes the child through\\nwhen it is not a string (throw mode already threw inside the child; quiet\\nmode already warned once there, so no double warning). `json_encode([INF])`\\nnow warns `[2 \\\"Inf and NaN cannot be JSON encoded\\\"]` and answers `false`;\\nwith `JSON_THROW_ON_ERROR` it throws `JsonException`.\\n\\n## 2. P2 — strrpos negative offsets (fixed)\\n\\nNegative offsets now start that many characters from the end and search\\nback from there (`hi = len + off`, clamped to `len - nn`), instead of\\nshrinking the upper bound by the needle length. `strrpos(\\\"hello\\\",\\\"l\\\",-2)`\\nis 3. `off > len` or `off < -len` throws `ValueError` (\\\"must be contained\\nin argument #1 ($haystack)\\\"), and an empty needle is a `ValueError`.\\n`test/builtin_surfaces_test.clj:37` corrected 2 → 3 plus two ValueError pins.\\n\\n## 3. P2 — diff/intersect string comparison + unique dispatch (fixed)\\n\\n`php/p9-diff-others` used loose `php/p9-search`, so `array_diff([\\\"1.0\\\"],[\\\"1\\\"])`\\nwas empty. New `php/p9-diff-str-has?` compares `php/p9-string` forms:\\nthe diff keeps `\\\"1.0\\\"`. `php/p9-unique-eq?` dispatch was off by one\\n(1 = loose, 2 = numeric); now 0 = `SORT_REGULAR` loose, 1 = `SORT_NUMERIC`,\\nelse string — so default `array_unique(['1.0','1'])` keeps one value and\\n`SORT_STRING` keeps both.\\n\\n## 4. P2 — array_splice replacement conversion (fixed)\\n\\nReplacements now pass through `php/p9-splice-repl`, which re-indexes values\\n(discarding string keys); an explicit `null` replacement is the empty array\\ninstead of a one-element `[null]`.\\n\\n## 5. P2 — JSON grammar/depth/options (fixed)\\n\\n- `php/json-number-end` no longer accepts `+`, so `json_decode(\\\"+1\\\")` fails.\\n- `php/json-read-string-loop` rejects raw control bytes (< 32).\\n- Decode depth counter starts at 1, so `[1]` at depth 1 fails\\n  (\\\"Maximum stack depth exceeded\\\").\\n- `json_encode` takes its depth argument (default 512, `< 1` is a\\n  `ValueError`) and enforces it instead of a hardcoded 512.\\n- Flags outside the supported masks are refused with an `Error` naming the\\n  function (encode: only `JSON_PRETTY_PRINT` + `JSON_THROW_ON_ERROR`;\\n  decode: only `JSON_OBJECT_AS_ARRAY` + `JSON_THROW_ON_ERROR`).\\n  `JSON_THROW_ON_ERROR` propagation itself was already wired through\\n  `php/json-fail` / `php/json-encode-fail`.\\n\\n## 6. P2 — extract/compact residuals (fixed)\\n\\n- `EXTR_PREFIX_ONLY_IF_EXISTS` (= 7) is present in `builtins.cljc`.\\n- `php/extract-name` always keeps the `_` separator, so an empty prefix\\n  imports `$_z`, and `EXTR_PREFIX_ALL` imports numeric keys (`$p_0`).\\n- `php/bi-extract` validates: mode outside 0–7 is a `ValueError`; a prefix\\n  mode without a third argument, or with a non-variable-name prefix, is a\\n  `ValueError` (empty prefix stays legal per the underscore rule; `EXTR_REFS`\\n  keeps its existing `Error`).\\n- `compact(1)` warns `[2 \\\"compact(): Each argument must be a string or an\\n  array of strings\\\"]` and skips instead of silently dropping.\\n- Fixture `:extract-skip-and-prefix` in `programs_p9.cljc` pinned the old\\n  naming (`$p_z` + diag); updated to `$p__z` with out `\\\"156\\\"`.\\n\\n## Gate\\n\\n- `clojure -M:test -n yang.php.antlr.builtin-surfaces-test`: 3 tests,\\n  158 assertions, 0 failures, 0 errors.\\n- `yang.php.antlr.prelude-test`: 1 failure in `array-path-assign-test`\\n  (string-offset-write known gap) — reproduced on the untouched base via\\n  `git stash`, so pre-existing and unrelated.\\n- `yang.php.antlr.e2e-test` cannot load here (missing generated\\n  `yang.typescript.antlr.gen.TypeScriptLexer` class) — environmental,\\n  unrelated to this change.\\n- clj-kondo / cljstyle binaries are not installed in this environment, and\\n  the repo has no `.clj-kondo` config and no kondo/cljstyle task in `bb.edn`,\\n  `Makefile`, or `bin/` — there is no configured kondo invocation to run.\\n  Alternative verification performed on the committed tree (`a0c82c12`):\\n  the repo's own pre-commit formatter hook ran clean at commit time\\n  (\\\"Formatting complete\\\"); `git diff` added lines contain no trailing\\n  whitespace (the single flagged blank is a pre-existing context line);\\n  all four touched files end in newline; every new helper\\n  (`json-encode-value`, `p9-splice-repl`, `p9-diff-str-has?`,\\n  `extract-needs-prefix?`) is defined and referenced, so no dead code;\\n  and the full `builtin-surfaces-test` suite re-ran green after the hook's\\n  reformat (158 assertions, 0 failures).\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1794900000000-architect-p8-final-confirm.gpt-6.1-sol.stdout.log:18:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"/Library/Developer/CommandLineTools/usr/bin/git grep -n -E 'bug63055|bug44069|bug40809|06cd429f|3/158|158 assertions|004dfb44' 06cd429f -- orchestrator-logs collab/orch-lane ':\\\"'!*.stdout.log'\\\"'\\n/Library/Developer/CommandLineTools/usr/bin/git show 06cd429f:src/cljc/yang/php/antlr/prelude_p9.cljc | sed -n '520,555p;665,744p;786,815p;834,930p'\\n/Library/Developer/CommandLineTools/usr/bin/git show 06cd429f:src/cljc/yang/php/antlr/builtins.cljc | sed -n '157,200p'\\n/Library/Developer/CommandLineTools/usr/bin/git show 06cd429f:test/yang/php/antlr/request_context_test.clj | sed -n '1,150p'\\nls /opt/homebrew/bin/python* /opt/homebrew/bin/bb /opt/homebrew/bin/clojure 2>/dev/null\\\"\",\"aggregated_output\":\"06cd429f:collab/orch-lane/1794750000000-engineer-roundB1-r2.muse-spark-1.3-contributor.findings.md:74:  158 assertions, 0 failures, 0 errors.\\n06cd429f:collab/orch-lane/1794750000000-engineer-roundB1-r2.muse-spark-1.3-contributor.findings.md:92:  reformat (158 assertions, 0 failures).\\n    [php/bi-array-unique\\n     ;; SORT_REGULAR (0) compares loosely, SORT_NUMERIC (1) numerically,\\n     ;; anything else as strings (SORT_STRING is 2)\\n     (fn [args]\\n       (do (php/arity-between \\\"array_unique\\\" args 1 2 \\\"at least 1\\\")\\n           (php/p9-unique (php/arg-array (get args 0) \\\"array_unique\\\" 1 \\\"array\\\")\\n                          (php/to-int (php/arg-or args 1 0)) 0 (php/empty-array))))]\\n    [php/p9-unique-eq?\\n     (fn [flags a b]\\n       (if (= flags 0) (php/loose-eq a b)\\n           (if (= flags 1) (= (php/to-float a) (php/to-float b))\\n               (= (php/p9-string a) (php/p9-string b)))))]\\n    [php/p9-unique-seen?\\n     (fn [out v flags i]\\n       (if (< i (php/array-count out))\\n         (if (php/p9-unique-eq? flags (php/array-get out (get (php/array-order out) i)) v)\\n           true (php/p9-unique-seen? out v flags (+ i 1)))\\n         false))]\\n    [php/p9-unique\\n     (fn [a flags i out]\\n       (if (< i (php/array-count a))\\n         (let [k (get (php/array-order a) i) v (php/array-get a k)]\\n           (php/p9-unique a flags (+ i 1)\\n                          (if (php/p9-unique-seen? out v flags 0) out (php/array-put out k v))))\\n         out))]\\n    [php/p9-diff-str-has?\\n     ;; string comparison, like PHP: \\\"1.0\\\" and \\\"1\\\" are different strings\\n     (fn [a v i]\\n       (if (< i (php/array-count a))\\n         (if (= (php/p9-string (php/array-get a (get (php/array-order a) i))) (php/p9-string v))\\n           true (php/p9-diff-str-has? a v (+ i 1)))\\n         false))]\\n    [php/p9-diff-others\\n     ;; found in any (diff) or in every (intersect) further array\\n     (fn [v others j m all]\\n       (if (< j m)\\n                                 (data/str-concat out\\n                                                  (if (= esc :php/null)\\n                                                    (if (< c 32) (php/json-escape-ctrl c) (data/code-points->str (php/vconj [] c))) esc))))\\n         (data/str-concat \\\"\\\\\\\"\\\" (data/str-concat out \\\"\\\\\\\"\\\"))))]\\n    [php/json-string (fn [s] (php/json-escape-loop (data/str->code-points s) 0 \\\"\\\"))]\\n    [php/json-key (fn [k] (php/json-string (php/to-string k)))]\\n    [php/json-indent\\n     (fn [n out] (if (> n 0) (php/json-indent (- n 1) (data/str-concat out \\\"    \\\")) out))]\\n    [php/json-encode-fail\\n     ;; without JSON_THROW_ON_ERROR an encoding failure warns and answers false\\n     (fn [throw? message]\\n       (if throw? (php/throw-error \\\"JsonException\\\" message)\\n          