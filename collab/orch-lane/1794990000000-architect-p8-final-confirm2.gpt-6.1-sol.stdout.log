yang/python/antlr/e2e_c2_test.clj:1284:               (live-after-collection k (changing-caller-source 1000) \\\\\\\\\\\\\\\"h\\\\\\\\\\\\\\\")))))))\\\\\\\\ntest/yang/python/antlr/e2e_c2_test.clj:1595:        (is (= (live-after-collection k (cycled-source 5) \\\\\\\\\\\\\\\"keep\\\\\\\\\\\\\\\")\\\\\\\\ntest/yang/python/antlr/e2e_c2_test.clj:1596:               (live-after-collection k (cycled-source 40) \\\\\\\\\\\\\\\"keep\\\\\\\\\\\\\\\")))))))\\\\\\\\ntest/yang/python/antlr/e2e_c2_test.clj:1604:        (is (= (live-after-collection k (dropped-source 5) \\\\\\\\\\\\\\\"keep\\\\\\\\\\\\\\\")\\\\\\\\ntest/yang/python/antlr/e2e_c2_test.clj:1605:               (live-after-collection k (dropped-source 60) \\\\\\\\\\\\\\\"keep\\\\\\\\\\\\\\\")))))))\\\\\\\\ntest/yang/php/antlr/generators_test.clj:93:(defn- live-after-collection\\\\\\\\ntest/yang/php/antlr/generators_test.clj:119:(defn- changing-caller-source\\\\\\\\ntest/yang/php/antlr/generators_test.clj:132:(deftest ^:slow reachable-heap-is-stable-under-delegation-test\\\\\\\\ntest/yang/php/antlr/generators_test.clj:135:      (let [small (live-after-collection k (changing-caller-source 10))\\\\\\\\ntest/yang/php/antlr/generators_test.clj:136:            large (live-after-collection k (changing-caller-source 1000))]\\\\\\\"}\\\\n{\\\\\\\"role\\\\\\\":\\\\\\\"assistant\\\\\\\",\\\\\\\"tool_calls\\\\\\\":[{\\\\\\\"type\\\\\\\":\\\\\\\"function\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"tool_lT20OSARruxXAukgGgd9EAUR\\\\\\\",\\\\\\\"function\\\\\\\":{\\\\\\\"name\\\\\\\":\\\\\\\"Read\\\\\\\",\\\\\\\"arguments\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"test/yang/python/antlr/e2e_c2_test.clj\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"line_offset\\\\\\\\\\\\\\\":1210,\\\\\\\\\\\\\\\"n_lines\\\\\\\\\\\\\\\":90}\\\\\\\"}},{\\\\\\\"type\\\\\\\":\\\\\\\"function\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"tool_Dhy3TdSucP9fqhc6riFDoiLw\\\\\\\",\\\\\\\"function\\\\\\\":{\\\\\\\"name\\\\\\\":\\\\\\\"Read\\\\\\\",\\\\\\\"arguments\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"docs/design/yang.antlr.md\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"line_offset\\\\\\\\\\\\\\\":1940,\\\\\\\\\\\\\\\"n_lines\\\\\\\\\\\\\\\":70}\\\\\\\"}},{\\\\\\\"type\\\\\\\":\\\\\\\"function\\\\\\\",\\\\\\\"id\\\\\\\":\\\\\\\"tool_rPdsl4iKkDlp7W5jwOBId93S\\\\\\\",\\\\\\\"function\\\\\\\":{\\\\\\\"name\\\\\\\":\\\\\\\"Read\\\\\\\",\\\\\\\"arguments\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"src/cljc/yin/vm/engine.cljc\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"line_offset\\\\\\\\\\\\\\\":2470,\\\\\\\\\\\\\\\"n_lines\\\\\\\\\\\\\\\":135}\\\\\\\"}}]}\\\\n{\\\\\\\"role\\\\\\\":\\\\\\\"tool\\\\\\\",\\\\\\\"tool_call_id\\\\\\\":\\\\\\\"tool_Dhy3TdSucP9fqhc6riFDoiLw\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"1940\\\\\\\\toptimization belongs to an attached optimizer and must preserve these\\\\\\\\n1941\\\\\\\\tobservations and runtime rebinding of the consumer. List, set, and dict\\\\\\\\n1942\\\\\\\\tcomprehensions stay eager. `yield` at module or class level, or inside\\\\\\\\n1943\\\\\\\\tany comprehension or generator expression, is a syntax diagnostic.\\\\\\\\n1944\\\\\\\\t\\\\\\\\n1945\\\\\\\\t`py/iter-at` keeps its index signature as an internal compatibility\\\\\\\\n1946\\\\\\\\tinterface, not the public iterator protocol (ruling 5). A stateful\\\\\\\\n1947\\\\\\\\titerator advances once per call and ignores the index; iterable\\\\\\\\n1948\\\\\\\\tacquisition happens once per loop; `iter(iterator)` preserves identity;\\\\\\\\n1949\\\\\\\\texhaustion handling covers only the advancement, never the loop body.\\\\\\\\n1950\\\\\\\\tThe loop counter must not overflow or round under long consumption: it\\\\\\\\n1951\\\\\\\\tuses exact increment once C3 lands, without narrowing generator\\\\\\\\n1952\\\\\\\\tpayloads.\\\\\\\\n1953\\\\\\\\t\\\\\\\\n1954\\\\\\\\tUser-defined iterator classes are part of C2, in S5 (ruling 8).\\\\\\\\n1955\\\\\\\\tImplicit `__iter__` and `__next__` lookup uses the type's special-method\\\\\\\\n1956\\\\\\\\tpath, since ordinary `py/getattr` prefers instance attributes; it\\\\\\\\n1957\\\\\\\\tvalidates the returned iterator and catches `StopIteration` only around\\\\\\\\n1958\\\\\\\\tadvancement. Termination values are preserved for delegation, other\\\\\\\\n1959\\\\\\\\texceptions propagate, and optional `send`, `throw`, and `close` are\\\\\\\\n1960\\\\\\\\tforwarded per PEP 380.\\\\\\\\n1961\\\\\\\\t\\\\\\\\n1962\\\\\\\\tNo generator flag is persisted on function specs (ruling 9). Generator\\\\\\\\n1963\\\\\\\\tstatus is decided during scope-aware lowering, excluding nested function\\\\\\\\n1964\\\\\\\\tbodies and including unreachable `yield` and `yield from`, and is\\\\\\\\n1965\\\\\\\\tencoded in ordinary code. Future introspection, such as\\\\\\\\n1966\\\\\\\\t`inspect.isgeneratorfunction`, derives status from the scoped\\\\\\\\n1967\\\\\\\\tgenerator-construction pattern; a query for direct applications of\\\\\\\\n1968\\\\\\\\t`py/yield` alone is insufficient, because a body using only `yield from`\\\\\\\\n1969\\\\\\\\tneed not apply it.\\\\\\\\n1970\\\\\\\\t\\\\\\\\n1971\\\\\\\\tHeap, identity, and wire:\\\\\\\\n1972\\\\\\\\t\\\\\\\\n1973\\\\\\\\t- Tracing needs no VM change: cell content is traced as data and a\\\\\\\\n1974\\\\\\\\t  continuation is walked through its payload.\\\\\\\\n1975\\\\\\\\t- An unreachable generator is reclaimed without an implicit `close()`\\\\\\\\n1976\\\\\\\\t  (ruling 6). Python specifies a `close()` on generator finalization, so\\\\\\\\n1977\\\\\\\\t  this is an explicit finalization restriction of the support profile,\\\\\\\\n1978\\\\\\\\t  not conformance. The landed collector has no finalizers; explicit\\\\\\\\n1979\\\\\\\\t  `close()` stays supported. Pinning roots the generator cell and traces\\\\\\\\n1980\\\\\\\\t  its current content, not every historical continuation.\\\\\\\\n1981\\\\\\\\t- `%capture` is undelimited, so `:resume` holds the frames of the first\\\\\\\\n1982\\\\\\\\t  `next()` call beneath the generator's own (stale base). This fixed\\\\\\\\n1983\\\\\\\\t  retention is accepted for C2; growth per yield is rejected (ruling 7).\\\\\\\\n1984\\\\\\\\t  Delimited capture is a separate VM question.\\\\\\\\n1985\\\\\\\\t- A suspended generator does not migrate: cells refuse lift and\\\\\\\\n1986\\\\\\\\t  continuations refuse as `:non-canonicalizable`. Once heap lift and a\\\\\\\\n1987\\\\\\\\t  continuation encoding land, generators migrate with no\\\\\\\\n1988\\\\\\\\t  generator-specific wire form; until then the refusal stays.\\\\\\\\n1989\\\\\\\\t- `is` is `=` on the ref, `iter(g) is g`, and a generator is a dict key\\\\\\\\n1990\\\\\\\\t  by ref through the non-numeric arm of `py/key`. `py/snapshot-obj`\\\\\\\\n1991\\\\\\\\t  renders `{:py/generator name}`, diagnostic data, never a resumable\\\\\\\\n1992\\\\\\\\t  wire form. The prelude compares only `:state` keywords, never\\\\\\\\n1993\\\\\\\\t  generator contents, since continuation equality and hash are\\\\\\\\n1994\\\\\\\\t  structural.\\\\\\\\n1995\\\\\\\\t- The canonical tree changes only by new prelude functions: `yield` is\\\\\\\\n1996\\\\\\\\t  an `:application` of `py/yield`, and `%capture` stays inside the\\\\\\\\n1997\\\\\\\\t  prelude. The prelude grows, so every bundled unit's address changes,\\\\\\\\n1998\\\\\\\\t  a prelude-profile bump under section 11.\\\\\\\\n1999\\\\\\\\t\\\\\\\\n2000\\\\\\\\tFor safepoints, generator switches happen only at applications of\\\\\\\\n2001\\\\\\\\t`py/gen-switch`, `py/yield-raw`, and `py/yield-from`, which an attached\\\\\\\\n2002\\\\\\\\tinserter can find by query; `sys.settrace` sees nothing in C2. Future\\\\\\\\n2003\\\\\\\\tper-thread dynamic state (the frame-record stack, the recursion counter,\\\\\\\\n2004\\\\\\\\t`exc_info`) joins `:ctx` and swaps with the handler stack.\\\\\\\\n2005\\\\\\\\t\\\\\\\\n2006\\\\\\\\t```text\\\\\\\\n2007\\\\\\\\t+--------+---------------------------------------------------------------------+\\\\\\\\n2008\\\\\\\\t| Slice  | Scope                                                               |\\\\\\\\n2009\\\\\\\\t+========+=====================================================================+\\\\\\\"}\\\\n{\\\\\\\"role\\\\\\\":\\\\\\\"tool\\\\\\\",\\\\\\\"tool_call_id\\\\\\\":\\\\\\\"tool_rPdsl4iKkDlp7W5jwOBId93S\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"2470\\\\\\\\t    (let [id (:id x)\\\\\\\\n2471\\\\\\\\t          entry (get heap id)]\\\\\\\\n2472\\\\\\\\t      (when (and (some? entry) (= (:seal x) (:seal entry))) id))))\\\\\\\\n2473\\\\\\\\t\\\\\\\\n2474\\\\\\\\t\\\\\\\\n2475\\\\\\\\t(defn- moded\\\\\\\\n2476\\\\\\\\t  \\\\\\\\\\\\\\\"`work` with each of `xs` pushed in `mode`, `:kernel` or `:data`.\\\\\\\\\\\\\\\"\\\\\\\\n2477\\\\\\\\t  [work mode xs]\\\\\\\\n2478\\\\\\\\t  (into work (map (fn [x] [mode x])) xs))\\\\\\\\n2479\\\\\\\\t\\\\\\\\n2480\\\\\\\\t\\\\\\\\n2481\\\\\\\\t(defn- trace\\\\\\\\n2482\\\\\\\\t  \\\\\\\\\\\\\\\"`found` plus the ids of `heap` reachable from `roots`, a map\\\\\\\\n2483\\\\\\\\t   `{:kernel [...] :data [...]}` of root values by mode. Two modes keep\\\\\\\\n2484\\\\\\\\t   guest data from being read as kernel shapes (gemini reclamation gate,\\\\\\\\n2485\\\\\\\\t   concern 1):\\\\\\\\n2486\\\\\\\\t\\\\\\\\n2487\\\\\\\\t   - `:kernel`, a value in a kernel position (a kernel root, an engine\\\\\\\\n2488\\\\\\\\t     table entry, a closure or continuation payload, or a kernel child of\\\\\\\\n2489\\\\\\\\t     one): the kernel's `gc-children` may interpret it, and answers which\\\\\\\\n2490\\\\\\\\t     of its children are kernel positions and which are values. A value\\\\\\\\n2491\\\\\\\\t     it does not recognize is walked whole, as data.\\\\\\\\n2492\\\\\\\\t   - `:data`, a value position (an environment value, an operand, a\\\\\\\\n2493\\\\\\\\t     register, a cell's content): every map is walked whole, never\\\\\\\\n2494\\\\\\\\t     pruned, so a guest map shaped like a frame cannot hide a cell ref.\\\\\\\\n2495\\\\\\\\t     Only a closure or continuation, a host type no guest can forge,\\\\\\\\n2496\\\\\\\\t     re-enters `:kernel` mode through its payload.\\\\\\\\n2497\\\\\\\\t\\\\\\\\n2498\\\\\\\\t   Scalars hold nothing. With `follow?` a newly found id's content is\\\\\\\\n2499\\\\\\\\t   traced too, as data (marking); without, only the refs met directly\\\\\\\\n2500\\\\\\\\t   (pinning). Each value is visited once per mode, so shared environments\\\\\\\\n2501\\\\\\\\t   cost one walk and a cell holding its own ref terminates. The worklist\\\\\\\\n2502\\\\\\\\t   is explicit: a deep continuation chain does not grow the host stack.\\\\\\\\\\\\\\\"\\\\\\\\n2503\\\\\\\\t  [vm heap roots found follow?]\\\\\\\\n2504\\\\\\\\t  (let [children-of (if (satisfies? module/IModuleKernel vm)\\\\\\\\n2505\\\\\\\\t                      #(module/gc-children vm %)\\\\\\\\n2506\\\\\\\\t                      (constantly nil))]\\\\\\\\n2507\\\\\\\\t    (loop [work (-> ()\\\\\\\\n2508\\\\\\\\t                    (moded :kernel (:kernel roots))\\\\\\\\n2509\\\\\\\\t                    (moded :data (:data roots)))\\\\\\\\n2510\\\\\\\\t           seen #{}\\\\\\\\n2511\\\\\\\\t           found found]\\\\\\\\n2512\\\\\\\\t      (if (empty? work)\\\\\\\\n2513\\\\\\\\t        found\\\\\\\\n2514\\\\\\\\t        (let [[mode x :as entry] (peek work)\\\\\\\\n2515\\\\\\\\t              work (pop work)]\\\\\\\\n2516\\\\\\\\t          (if (or (scalar? x) (contains? seen entry))\\\\\\\\n2517\\\\\\\\t            (recur work seen found)\\\\\\\\n2518\\\\\\\\t            (let [id (when (map? x) (heap-ref-id heap x))\\\\\\\\n2519\\\\\\\\t                  new-id? (and (some? id) (not (contains? found id)))\\\\\\\\n2520\\\\\\\\t                  children (when (and (= :kernel mode)\\\\\\\\n2521\\\\\\\\t                                      (not (values/host-typed? x)))\\\\\\\\n2522\\\\\\\\t                             (children-of x))\\\\\\\\n2523\\\\\\\\t                  work (cond-> work\\\\\\\\n2524\\\\\\\\t                         (and new-id? follow?)\\\\\\\\n2525\\\\\\\\t                         (conj [:data (:value (get heap id))])\\\\\\\\n2526\\\\\\\\t                         (values/host-typed? x)\\\\\\\\n2527\\\\\\\\t                         (conj [:kernel (values/payload x)])\\\\\\\\n2528\\\\\\\\t                         (some? children)\\\\\\\\n2529\\\\\\\\t                         (-> (moded :kernel (:kernel children))\\\\\\\\n2530\\\\\\\\t                             (moded :data (:values children)))\\\\\\\\n2531\\\\\\\\t                         (and (nil? children) (map? x))\\\\\\\\n2532\\\\\\\\t                         (-> (moded :data (keys x))\\\\\\\\n2533\\\\\\\\t                             (moded :data (vals x)))\\\\\\\\n2534\\\\\\\\t                         (and (nil? children) (not (map? x)) (coll? x))\\\\\\\\n2535\\\\\\\\t                         (moded :data x))]\\\\\\\\n2536\\\\\\\\t              (recur work\\\\\\\\n2537\\\\\\\\t                     (conj seen entry)\\\\\\\\n2538\\\\\\\\t                     (if new-id? (conj found id) found)))))))))\\\\\\\\n2539\\\\\\\\t\\\\\\\\n2540\\\\\\\\t\\\\\\\\n2541\\\\\\\\t(defn- gc-roots\\\\\\\\n2542\\\\\\\\t  \\\\\\\\\\\\\\\"Every root of `vm` (design Q1), by mode: the kernel's registers as it\\\\\\\\n2543\\\\\\\\t   classifies them (`module/gc-roots`), each entry of `:parked`,\\\\\\\\n2544\\\\\\\\t   `:wait-set` and `:ready-queue` as a kernel position, the store and\\\\\\\\n2545\\\\\\\\t   every module store as values, then `extra` as values. Code, images,\\\\\\\\n2546\\\\\\\\t   the registry, primitives, `:callable-effects`, telemetry and\\\\\\\\n2547\\\\\\\\t   `:resources` are not roots: a literal can never be an authentic ref,\\\\\\\\n2548\\\\\\\\t   and a value inside a stream is the medium's (hence pinning).\\\\\\\\\\\\\\\"\\\\\\\\n2549\\\\\\\\t  [vm extra]\\\\\\\\n2550\\\\\\\\t  (let [kernel (when (satisfies? module/IModuleKernel vm)\\\\\\\\n2551\\\\\\\\t                 (module/gc-roots vm))]\\\\\\\\n2552\\\\\\\\t    {:kernel (-> (vec (:kernel kernel))\\\\\\\\n2553\\\\\\\\t                 (into (vals (:parked vm)))\\\\\\\\n2554\\\\\\\\t                 (into (:wait-set vm))\\\\\\\\n2555\\\\\\\\t                 (into (:ready-queue vm))),\\\\\\\\n2556\\\\\\\\t     :data (-> [(:store vm) (:module-stores vm)]\\\\\\\\n2557\\\\\\\\t               (into (:values kernel))\\\\\\\\n2558\\\\\\\\t               (into extra))}))\\\\\\\\n2559\\\\\\\\t\\\\\\\\n2560\\\\\\\\t\\\\\\\\n2561\\\\\\\\t(defn- mark\\\\\\\\n2562\\\\\\\\t  \\\\\\\\\\\\\\\"The ids of `heap` live from `roots` and from the `pinned` ids: a pinned\\\\\\\\n2563\\\\\\\\t   cell is a root, so its content is traced too, as data.\\\\\\\\\\\\\\\"\\\\\\\\n2564\\\\\\\\t  [vm heap roots pinned]\\\\\\\\n2565\\\\\\\\t  (let [pins (filterv #(contains? heap %) pinned)]\\\\\\\\n2566\\\\\\\\t    (trace vm\\\\\\\\n2567\\\\\\\\t           heap\\\\\\\\n2568\\\\\\\\t           (update roots :data into (map #(:value (get heap %))) pins)\\\\\\\\n2569\\\\\\\\t           (set pins)\\\\\\\\n2570\\\\\\\\t           true)))\\\\\\\\n2571\\\\\\\\t\\\\\\\\n2572\\\\\\\\t\\\\\\\\n2573\\\\\\\\t(defn- sweep\\\\\\\\n2574\\\\\\\\t  \\\\\\\\\\\\\\\"`heap` without each id of the cycle's `snapshot` that `marked` lacks.\\\\\\\\n2575\\\\\\\\t   An id allocated after the snapshot is not in it, so it is spared.\\\\\\\\\\\\\\\"\\\\\\\\n2576\\\\\\\\t  [heap snapshot marked]\\\\\\\\n2577\\\\\\\\t  (reduce-kv (fn [h id _] (if (contains? marked id) h (dissoc h id)))\\\\\\\\n2578\\\\\\\\t             heap\\\\\\\\n2579\\\\\\\\t             snapshot))\\\\\\\\n2580\\\\\\\\t\\\\\\\\n2581\\\\\\\\t\\\\\\\\n2582\\\\\\\\t(defn- gc-of\\\\\\\\n2583\\\\\\\\t  [state]\\\\\\\\n2584\\\\\\\\t  (or (:gc state) (vm/fresh-gc nil)))\\\\\\\\n2585\\\\\\\\t\\\\\\\\n2586\\\\\\\\t\\\\\\\\n2587\\\\\\\\t(defn collect\\\\\\\\n2588\\\\\\\\t  \\\\\\\\\\\\\\\"`vm` after one stop-the-world collection of its `:heap`, with `extra`\\\\\\\\n2589\\\\\\\\t   traced as additional roots. The