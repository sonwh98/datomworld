7\\\\t    (testing \\\\\\\"array_unique defaults to SORT_STRING: '1.0' and '1' are distinct strings\\\\\\\"\\\\n    48\\\\t      (is (= \\\\\\\"1.0,1\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_unique(['1.0', '1']));\\\\\\\")))\\\\n    49\\\\t      (is (= \\\\\\\"1.0,1\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_unique(['1.0', '1'], SORT_STRING));\\\\\\\")))\\\\n    50\\\\t      (is (= \\\\\\\"1.0\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_unique(['1.0', '1'], SORT_NUMERIC));\\\\\\\")))\\\\n    51\\\\t      (is (= \\\\\\\"1.0\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_unique(['1.0', '1'], SORT_REGULAR));\\\\\\\"))))\\\\n    52\\\\t    (testing \\\\\\\"diff/intersect take further arrays\\\\\\\"\\\\n    53\\\\t      (is (= \\\\\\\"1,4\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_diff([1, 2, 3, 4], [2], [3]));\\\\\\\")))\\\\n    54\\\\t      (is (= \\\\\\\"3\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_intersect([1, 2, 3], [2, 3], [3, 4]));\\\\\\\"))))\\\\n    55\\\\t    (testing \\\\\\\"diff/intersect compare as strings\\\\\\\"\\\\n    56\\\\t      (is (= \\\\\\\"1.0\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_diff(['1.0'], ['1']));\\\\\\\")))\\\\n    57\\\\t      (is (= \\\\\\\"\\\\\\\" (out \\\\\\\"<?php echo implode(',', array_intersect(['1.0'], ['1']));\\\\\\\"))))\\\\n    58\\\\t    (testing \\\\\\\"array_splice normalizes bounds; omitted replacement removes\\\\\\\"\\\\n    59\\\\t      (is (= \\\\\\\"1,3|2\\\\\\\" (out \\\\\\\"<?php $a = [1, 2, 3]; $r = array_splice($a, 1, 1); echo implode(',', $a), '|', implode(',', $r);\\\\\\\")))\\\\n    60\\\\t      (is (= \\\\\\\"1,2|3\\\\\\\" (out \\\\\\\"<?php $a = [1, 2, 3]; $r = array_splice($a, -1); echo implode(',', $a), '|', implode(',', $r);\\\\\\\"))))\\\\n    61\\\\t    (testing \\\\\\\"array_splice drops replacement string keys; null replaces with nothing\\\\\\\"\\\\n    62\\\\t      (is (= \\\\\\\"1,8,9,3|2\\\\\\\" (out \\\\\\\"<?php $a = [1, 2, 3]; $r = array_spl