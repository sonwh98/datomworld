ump(http_response_code());\\\"\\n    60\\t       base-request \\\"int(200)\\\\nint(201)\\\\nint(202)\\\\n\\\"\\n    61\\t       :diag [] :oracle :pending\\n    62\\t       :response [{:php.response/status 201}\\n    63\\t                  {:php.response/status 202}\\n    64\\t                  {:php.response/body \\\"int(200)\\\\nint(201)\\\\nint(202)\\\\n\\\"}])\\n    65\\t   (fx :header-replace-and-status-arg\\n    66\\t       \\\"<?php header('X-A: 1', false); header('X-B: 2', true, 202); echo http_response_code();\\\"\\n    67\\t       base-request \\\"202\\\"\\n    68\\t       :diag [] :oracle :pending\\n    69\\t       :response [{:php.response/header \\\"X-A: 1\\\", :replace false}\\n    70\\t                  {:php.response/header \\\"X-B: 2\\\", :replace true}\\n    71\\t                  {:php.response/status 202}\\n    72\\t                  {:php.response/body \\\"202\\\"}])\\n    73\\t   (fx :setcookie-positional-options\\n    74\\t       \\\"<?php var_dump(setcookie('s', 'v', 1700003600, '/app', 'example.com', true, true));\\\"\\n    75\\t       base-request \\\"bool(true)\\\\n\\\"\\n    76\\t       :diag [] :oracle :pending\\n    77\\t       :response [{:php.response/cookie\\n    78\\t                    {:name \\\"s\\\", :value \\\"v\\\",\\n    79\\t                     :options {:expires 1700003600, :path \\\"/app\\\",\\n    80\\t                               :domain \\\"example.com\\\",\\n    81\\t                               :secure true, :httponly true}}}\\n    82\\t                  {:php.response/body \\\"bool(true)\\\\n\\\"}])\\n    83\\t   (fx :setcookie-options-array\\n    84\\t       \\\"<?php var_dump(setcookie('o', 'w', ['expires' => 1700003600, 'path' => '/', 'samesite' => 'Lax']));\\\"\\n    85\\t       base-request \\\"bool(true)\\\\n\\\"\\n    86\\t       :diag [] :oracle :pending\\n    87\\t       :response [{:php.response/cookie\\n    88\\t                    {:name \\\"o\\\", :value \\\"w\\\",\\n    89\\t                     :options {:expires 1700003600, :path \\\"/\\\",\\n    90\\t                               :samesite \\\"Lax\\\"}}}\\n    91\\t                  {:php.response/body \\\"bool(true)\\\\n\\\"}])\\n    92\\t   (fx :trigger-user-error-is-fatal\\n    93\\t       \\\"<?php echo 'A'; trigger_error('boom', E_USER_ERROR); echo 'C';\\\"\\n    94\\t       base-request \\\"A\\\"\\n    95\\t       :diag [[256 \\\"boom\\\"]] :oracle :pending\\n    96\\t       :fatal \\\"boom\\\")\\n    97\\t   (fx :trigger-invalid-level-rejected\\n    98\\t       \\\"<?php var_dump(trigger_error('x', 9999));\\\"\\n    99\\t       base-request \\\"bool(false)\\\\n\\\"\\n   100\\t       :diag [[2 \\\"trigger_error(): Invalid error level\\\"]] :oracle :pending\\n   101\\t       :response [{:php.response/body \\\"bool(false)\\\\n\\\"}])\\n   102\\t   (fx :handler-mask-saved-and-restored\\n   103\\t       (str \\\"<?php set_error_handler(function($n, $s) { echo 'H', $n; return true; }, E_USER_WARNING);\\\"\\n   104\\t            \\\" trigger_error('w1', E_USER_WARNING);\\\"\\n   105\\t            \\\" trigger_error('n1', E_USER_NOTICE);\\\"\\n   106\\t            \\\" restore_error_handler();\\\"\\n   107\\t            \\\" trigger_error('w2', E_USER_WARNING);\\\")\\n   108\\t       base-request \\\"H512\\\"\\n   109\\t       :diag [[1024 \\\"n1\\\"] [512 \\\"w2\\\"]] :oracle :pending\\n   110\\t       :response [{:php.response/body \\\"H512\\\"}])])\\n(ns yang.php.antlr.request-context-test\\n  \\\"P5 request records, response records, output buffering and isolation.\\\"\\n  (:require\\n    [clojure.string :as str]\\n    [clojure.test :refer [deftest is testing]]\\n    [yang.php.antlr.e2e-harness :as h]\\n    [yang.php.antlr.programs-p5 :as p5]))\\n\\n\\n(defn- diagnostics\\n  [r]\\n  (mapv (juxt :errno :message) (:php/diag r)))\\n\\n\\n(defn- strip-output-started\\n  \\\"Strip the oracle's location suffix ` by (output started at ...)` from a\\n  recorded diagnostic message (the headers-already-sent ruling: the engine\\n  records the bare refusal text).\\\"\\n  [msg]\\n  (str/replace msg #\\\" by \\\\(output started at .*\\\\)$\\\" \\\"\\\"))\\n\\n\\n(defn- normalize-expected-diag\\n  \\\"Normalize the fixture (oracle-fold) `:diag` before comparing against the\\n  engine: the oracle's location suffix is stripped from headers-already-sent\\n  texts (the engine records the bare refusal text per the headers ruling).\\n  The empty-`ob_end_clean` notice the oracle records is kept verbatim — the\\n  engine emits it per the notice ruling. Fold records stay verbatim.\\\"\\n  [expected-diag]\\n  (mapv (fn [[errno msg]] [errno (strip-output-started msg)])\\n        expected-diag))\\n\\n\\n(deftest request-binding-smoke-test\\n  (is (= \\\"1\\\" (:php/out (h/run-raw \\\"<?php echo 1;\\\" {})))))\\n\\n\\n(deftest request-context-fixtures-test\\n  (doseq [{:keys [id source request out diag response status]} p5/fixtures]\\n    (testing (name id)\\n      (let [r (h/run-raw source request)]\\n        (is (= out (:php/out r)))\\n        (is (= (normalize-expected-diag (vec diag)) (diagnostics r)))\\n        (when response (is (= response (:php/response r))))\\n        (when status (is (= status (:php/status r))))\\n        (is (nil? (:php/uncaught r)))))))\\n\\n\\n(deftest requests-in-separate-tasks-share-nothing-test\\n  (let [source (str \\\"<?php header('X-Request: ' . $_GET['value']);\\\"\\n                    \\\" echo $_GET['value']; $_GET['value'] = 'changed';\\\")\\n        request-a (assoc p5/request :php.request/query (p5/request-array [[\\\"value\\\" \\\"A\\\"]]))\\n        request-b (assoc p5/request :php.request/query (p5/request-array [[\\\"value\\\" \\\"B\\\"]]))\\n        a (h/run-raw source request-a)\\n        b (h/run-raw source request-b)]\\n    (is (= \\\"A\\\" (:php/out a)))\\n    (is (= \\\"B\\\" (:php/out b)))\\n    (is (= [{:php.response/header \\\"X-Request: A\\\", :replace true}\\n            {:php.response/body \\\"A\\\"}]\\n           (:php/response a)))\\n    (is (= [{:php.response/header \\\"X-Request: B\\\", :replace true}\\n            {:php.response/body \\\"B\\\"}]\\n           (:php/response b)))\\n    (is (empty? (:php/diag a)))\\n    (is (empty? (:php/diag b)))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1795050000000-architect-b2-escalations-step7.gpt-6.1-sol.stdout.log:50:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_25\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '3934,3965p;4148,4173p' docs/design/yang.antlr.md; sed -n '1,220p' src/dev/yang/php/oracle.clj; nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '500,640p'; sed -n '1,80p' /Users/sto/workspace/datomworld/.agents/skills/code-review-pr/scripts/pr_reviewer.py\\\"\",\"aggregated_output\":\"valid bridge, never the raise exit of a call that already returned.\\nUnrestricted continuation escape across foreign frames is not implicitly\\nsupported: a claiming profile must define and test restoration and\\nreference lifetimes for every crossed frame.\\n\\nInvoking a function-valued argument is internal Yin computation.\\nHost-initiated callbacks remain stream events under\\n`datom.world.abi.md`; this convention adds no host callback facility.\\n\\n#### 8.10.9 Publication, visibility, and reproducibility\\n\\nShared callability creates no common global scope. An import or\\ncomposition explicitly binds exports in the receiving source namespace\\nunder its normal name/module rules. Missing names keep their source\\nerrors. No fallback searches other frontends, the filesystem, a host\\npackage registry, or ambient globals.\\n\\nLinked modules publish code and immutable specifications. Their bodies\\ninstantiate function objects and common entries in the importing task,\\nas section 8.5.6 requires. Install children must not export live function\\ncells. A higher-order result is an ordinary runtime value, not a new\\nlinker publication on each call.\\n\\nLowering/runtime profiles pin the implementation and binding/value\\nextensions. Existing dependency/effect/custody checks remain. Type facts\\nstay beside code under `yin.vm.typecheck`, not in lambda language tags.\\nDo not duplicate existing lambda parameters in another persisted\\nauthority over the private body signature.\\n\\nBefore admitting a compiled composition, its profile/dependency\\ndeclarations must establish one compatible convention revision for the\\nentries it exposes. An incompatible revision needs an explicitly pinned\\n### 8.11 Mutable objects and collections over cells\\n\\nThis section records the mutable-objects ruling. A mutable guest object\\nis one cell holding one persistent value, and the object's identity is\\nthe cell:\\n\\n- The guest reference is the bare `:cell-ref`. The type tag and payload\\n  live inside the cell's content, so `type(x)` answers the same through\\n  every alias. The content is a tagged header plus payload, for example\\n  `{type-tag, items}` for a list or `{class-ref, attrs}` for an instance;\\n  the exact encoding belongs to each language's runtime profile.\\n- Immutable guest values get no cell. Numbers, strings, tuples, `None`,\\n  and the like are plain tagged persistent values.\\n- A slot gets its own cell only when the language lets that slot itself\\n  be aliased. PHP reference slots are the case. Go interior pointers need\\n  no extra cell: they are a `(cell, path)` pair.\\n- Classes are objects too. Class attributes are assignable, so a class\\n  is a cell, and an instance holds a ref to it.\\n- A mutation is `cell/get`, then a pure update, then `cell/set!`.\\n  Persistent structures make the copy a path copy, not a whole-value\\n  copy. No atomic update form is needed: a task switches only at park\\n  points, and the prelude evaluates operands before the get/set pair.\\n  `cell/swap!` is rejected, because applying a guest closure inside\\n  effect handling would need continuation frames the engine does not\\n  build there.\\n\\n(ns yang.php.oracle\\n  \\\"PHP 8.3 CLI oracle runner for `yang.php.antlr.programs`\\n   (docs/design/yang.php.md sections 14, 17.3).\\n\\n   For every fixture in `programs/fixtures` (plus `matrix-source` and\\n   `float-cases`), writes the PHP source to a temporary file and runs:\\n     docker run --rm -v <dir>:/w -w /w php:8.3-cli php \\\\\\\\\\n       -d display_errors=1 -d html_errors=0 -d error_reporting=E_ALL \\\\\\\\\\n       -d log_errors=0 <file>\\n   Parses stdout into `:out`, `:diag` (`[[errno message] ...]`) and `:uncaught`\\n   (`{:class c :message m}`), and compares against each fixture's expectation\\n   (or `:departure/:zend` for departure fixtures).\\\"\\n  (:require\\n    [clojure.java.io :as io]\\n    [clojure.java.shell :as sh]\\n    [clojure.string :as str]\\n    [yang.php.antlr.programs :as programs]\\n    [yang.php.antlr.programs-p3b :as p3b]\\n    [yang.php.antlr.programs-p4 :as p4]\\n    [yang.php.antlr.programs-p5 :as p5]\\n    [yang.php.antlr.programs-p6 :as p6])\\n  (:import\\n    (java.nio.charset\\n      StandardCharsets)\\n    (java.nio.file\\n      Files)\\n    (java.nio.file.attribute\\n      FileAttribute)))\\n\\n\\n(def banner\\n  \\\"The pinned PHP 8.3 CLI oracle provenance banner.\\\"\\n  p3b/banner)\\n\\n\\n(def p5-banner\\n  \\\"The P5 request-context run's own provenance banner (version/host/date of\\n  the P5 recording pass, not P3-b's).\\\"\\n  \\\"php-8.3.35 shiva 2026-10-25\\\")\\n\\n\\n(def ^:private errno-of\\n  {\\\"Warning\\\" 2,\\n   \\\"Notice\\\" 8,\\n   \\\"Deprecated\\\" 8192,\\n   \\\"Fatal error\\\" 1})\\n\\n\\n(defn class-derived?\\n  \\\"Whether the recorded diag entry carries a class-derived errno: the runner\\n  parses only the `Warning|Notice|...` kind line, so the recorded number is\\n  derived from the message class, not the true constant (e.g. `Notice` parses\\n  to 8 where the engine's semantic truth for `E_USER_NOTICE` is 1024).\\\"\\n  [diag-entry]\\n  (boolean (:yang.php.oracle/class-derived (meta diag-entry))))\\n\\n\\n(defn- mark-class-derived\\n  \\\"Mark a recorded `[errno message]` pair as class-derived (see [[class-derived?]]).\\\"\\n  [pair]\\n  (with-meta pair {:yang.php.oracle/class-derived true}))\\n\\n\\n(defn errno-match?\\n  \\\"Whether expected errno `e` matches recorded diag entry `a`: identical\\n  numbers match, and a 1024-vs-8 mismatch counts as equal ONLY when the oracle\\n  record is marked class-derived.\\\"\\n  [e a]\\n  (let [[actual-errno] a]\\n    (or (= e actual-errno)\\n        (and (= 1024 e) (= 8 actual-errno) (class-derived? a)))))\\n\\n\\n(defn diag-match?\\n  \\\"Whether the expected diag vector matches the recorded one entry-wise under\\n  [[errno-match?]] (messages compare literally).\\\"\\n  [expected-diag actual-diag]\\n  (and (= (count expected-diag) (count actual-diag))\\n       (every? true? (map (fn [[e-errno e-msg] a]\\n                            (and (errno-match? e-errno a)\\n                                 (= e-msg (second a))))\\n                          expected-diag actual-diag))))\\n\\n\\n(defn- location-pattern\\n  \\\"The regex source of a PHP source location below `/w/`: the entry `file`\\n   itself, or, for a multi-unit fixture run in `/w/<unit-dir>`, any unit file\\n   below the directory.\\\"\\n  [file unit-dir]\\n  (if unit-dir\\n    (str (java.util.regex.Pattern/quote unit-dir) \\\"/[^\\\\\\\\s:]+\\\")\\n    (java.util.regex.Pattern/quote file)))\\n\\n\\n(defn- strip-location\\n  ([s file] (strip-location s file nil))\\n  ([s file unit-dir]\\n   (str/replace s\\n                (re-pattern (str \\\" in /w/\\\" (location-pattern file unit-dir) \\\" on line \\\\\\\\d+\\\"))\\n                \\\"\\\")))\\n\\n\\n(defn parse-stdout\\n  \\\"Parse PHP CLI stdout for `/w/<file>` into\\n   `{:out <string> :diag [[errno msg] ...] :uncaught {:class c :message m}-or-nil}`.\\n   With `unit-dir`, locations in any file below `/w/<unit-dir>` are stripped\\n   (a multi-unit fixture).\\\"\\n  ([raw file] (parse-stdout raw file nil))\\n  ([raw file unit-dir]\\n   (let [qfile (location-pattern file unit-dir)\\n         strip-location (fn [s file] (strip-location s file unit-dir))\\n         ;; The uncaught block ends at PHP's own terminator, so output written\\n         ;; after it (shutdown functions, destructors) stays in :out.\\n         uncaught-re (re-pattern\\n                       (str \\\"(?s)\\\\\\\\nFatal error: Uncaught ([^:]+): ([^\\\\\\\\r\\\\\\\\n]*) in /w/\\\"\\n                            qfile\\n                            \\\":\\\\\\\\d+\\\\\\\\nStack trace:\\\\\\\\n.*?\\\\\\\\n  thrown in /w/\\\"\\n                            qfile\\n                            \\\" on line \\\\\\\\d+\\\\\\\\n\\\"))\\n         fatal-re (re-pattern\\n                    (str \\\"\\\\\\\\nFatal error: ([^\\\\\\\\r\\\\\\\\n]*) in /w/\\\"\\n                         qfile\\n                         \\\" on line \\\\\\\\d+\\\\\\\\n\\\"))\\n         diag-re (re-pattern\\n                   (str \\\"\\\\\\\\n(Warning|Notice|Deprecated): ([^\\\\\\\\r\\\\\\\\n]*?) in /w/\\\"\\n                        qfile\\n                        \\\" on line \\\\\\\\d+\\\\\\\\n\\\"))\\n         [without-fatal uncaught]\\n         (if-let [[_ cls msg] (re-find uncaught-re raw)]\\n           [(str/replace raw uncaught-re \\\"\\\")\\n            {:class cls, :message (strip-location msg file)}]\\n           (if-let [[_ msg] (re-find fatal-re raw)]\\n             [(str/replace raw fatal-re \\\"\\\")\\n              {:class \\\"Error\\\", :message (strip-location msg file)}]\\n             [raw nil]))\\n         diags (volatile! [])\\n         out (str/replace without-fatal\\n                          diag-re\\n                          (fn [[_ kind msg]]\\n                            (vswap! diags conj (mark-class-derived [(get errno-of kind) (strip-location msg file)]))\\n                            \\\"\\\"))]\\n     {:out out,\\n      :diag @diags,\\n      :uncaught uncaught})))\\n\\n\\n(defn run-php-file\\n  \\\"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` and return the parsed\\n   `{:out :diag :uncaught :exit}`. With `unit-dir`, the working directory is\\n   `/w/<unit-dir>` and `file` is relative to it (a multi-unit fixture).\\\"\\n  ([dir file] (run-php-file dir file nil))\\n  ([dir file unit-dir]\\n   (let [{:keys [out err exit]}\\n         (sh/sh \\\"docker\\\" \\\"run\\\" \\\"--rm\\\"\\n                \\\"-v\\\" (str (.toAbsolutePath (.toPath (io/file dir))) \\\":/w\\\")\\n                \\\"-w\\\" (if unit-dir (str \\\"/w/\\\" unit-dir) \\\"/w\\\")\\n                \\\"php:8.3-cli\\\" \\\"php\\\"\\n                \\\"-d\\\" \\\"display_errors=1\\\"\\n                \\\"-d\\\" \\\"html_errors=0\\\"\\n                \\\"-d\\\" \\\"error_reporting=E_ALL\\\"\\n                \\\"-d\\\" \\\"log_errors=0\\\"\\n                file\\n                :out-enc \\\"UTF-8\\\")]\\n     (assoc (parse-stdout out (if unit-dir (str unit-dir \\\"/\\\" file) file) unit-dir)\\n            :err err\\n            :exit exit))))\\n\\n\\n(defn- write-source!\\n  [dir file ^String source]\\n  (Files/write (.toPath (io/file dir file))\\n               (.getBytes source StandardCharsets/UTF_8)\\n               (make-array java.nio.file.OpenOption 0)))\\n\\n\\n(defn- unit-actual\\n  \\\"Run the multi-unit `fixture`: every unit is written below `<dir>/<id>/`,\\n   `main.php` is run with that directory as the working directory, and\\n   `/w/<id>` is replaced by `.` in everything the program printed (the\\n   comparison's definition, plan P6 2.5 rule 2; corner C37).\\\"\\n  [dir {:keys [id units main], :or {main \\\"main.php\\\"}}]\\n  (let [unit-dir (name id)\\n        norm (fn [s] (str/replace s (str \\\"/w/\\\" unit-dir) \\\".\\\"))]\\n    (doseq [[path source] units]\\n      (let [f (io/file dir unit-dir path)]\\n        (io/make-parents f)\\n        (write-source! dir (str unit-dir \\\"/\\\" path) source)))\\n    (let [actual (run-php-file dir main unit-dir)]\\n      (-> actual\\n          (update :out norm)\\n          (update :diag (fn [ds] (mapv (fn [[errno msg]] [errno (norm msg)]) ds)))\\n          (update :uncaught #(some-> % (update :message norm)))))))\\n\\n\\n(defn check-fixture\\n  \\\"Run `fixture` in temporary directory `dir` and return a check record.\\\"\\n  [dir {:keys [id source units out diag uncaught departure gap oracle], :as fixture}]\\n  (let [file (str (name id) \\\".php\\\")]\\n    (when-not units (write-source! dir file source))\\n    (let [actual (if units (unit-actual dir fixture) (run-php-file dir file))\\n          expected-out (cond departure (:zend departure)\\n                             gap \\\"\\\"\\n                             :else out)\\n          expected-diag (vec (cond departure (:zend-diag departure)\\n                                   gap []\\n                                   :else (or diag [])))\\n          expected-uncaught (cond departure (:zend-uncaught departure)\\n                                  gap nil\\n                                  :else uncaught)\\n          pass? (and (not= :pending oracle)\\n                     (= expected-out (:out actual))\\n                     (= expected-diag (:diag actual))\\n                     (= expected-uncaught (:uncaught actual)))]\\n      {:id id,\\n       :pass? pass?,\\n       :oracle oracle,\\n       :gap gap,\\n       :departure departure,\\n       :expected {:out expected-out, :diag expected-diag, :uncaught expected-uncaught},\\n       :actual (select-keys actual [:out :diag :uncaught])})))\\n   500\\t         (do (php/warn 2 \\\"Cannot modify header information - headers already sent\\\") true)\\n   501\\t         false))]\\n   502\\t    [php/bi-header\\n   503\\t     ;; header(string, replace=true, status=0): the status argument sets the\\n   504\\t     ;; response code; a bare \\\"HTTP/...\\\" line sets it too. Returns null.\\n   505\\t     (fn [args]\\n   506\\t       (if (php/headers-refused?)\\n   507\\t         :php/null\\n   508\\t         (let [line (php/to-string (get args 0))\\n   509\\t               replace (if (> (data/count args) 1) (php/to-bool (get args 1)) true)\\n   510\\t               status (if (> (data/count args) 2) (php/to-int (get args 2)) 0)]\\n   511\\t           (do (php/emit-response!\\n   512\\t                 (assoc (assoc {} :php.response/header line) :replace replace))\\n   513\\t               (if (not (= status 0))\\n   514\\t                 (do (cell/set! php.rt/status status)\\n   515\\t                     (php/emit-response! (assoc {} :php.response/status status)))\\n   516\\t                 :php/null)\\n   517\\t               :php/null))))]\\n   518\\t    [php/bi-headers-sent\\n   519\\t     (fn [args] (cell/get php.rt/headers-sent))]\\n   520\\t    [php/bi-http-response-code\\n   521\\t     ;; with no argument answers the current code; with one, answers the\\n   522\\t     ;; previous code and installs the new one (false when refused).\\n   523\\t     (fn [args]\\n   524\\t       (if (= (data/count args) 0)\\n   525\\t         (cell/get php.rt/status)\\n   526\\t         (if (php/headers-refused?)\\n   527\\t           false\\n   528\\t           (let [prev (cell/get php.rt/status)\\n   529\\t                 status (php/to-int (get args 0))]\\n   530\\t             (do (cell/set! php.rt/status status)\\n   531\\t                 (php/emit-response! (assoc {} :php.response/status status))\\n   532\\t                 prev)))))]\\n   533\\t    [php/cookie-opt\\n   534\\t     (fn [opts k v]\\n   535\\t       (if (= v :php/null) opts (assoc opts k v)))]\\n   536\\t    [php/bi-setcookie\\n   537\\t     ;; setcookie(name, value=\\\"\\\", expires=0, path=\\\"\\\", domain=\\\"\\\", secure=false,\\n   538\\t     ;; httponly=false) or setcookie(name, value, [options-array]): retained\\n   539\\t     ;; expiration/path/domain/secure/httponly/samesite on the cookie record.\\n   540\\t     (fn [args]\\n   541\\t       (if (php/headers-refused?)\\n   542\\t         false\\n   543\\t         (let [n (data/count args)\\n   544\\t               name (php/to-string (get args 0))\\n   545\\t               value (if (> n 1) (php/to-string (get args 1)) \\\"\\\")\\n   546\\t               opts (if (if (> n 2) (php/array? (get args 2)) false)\\n   547\\t                      (let [o (get args 2)\\n   548\\t                            opt (fn [m s k f]\\n   549\\t                                  (if (php/array-has? o s)\\n   550\\t                                    (php/cookie-opt m k (f (php/array-get o s)))\\n   551\\t                                    m))]\\n   552\\t                        (opt (opt (opt (opt (opt (opt {} \\\"expires\\\" :expires php/to-int)\\n   553\\t                                                              \\\"path\\\" :path php/to-string)\\n   554\\t                                                        \\\"domain\\\" :domain php/to-string)\\n   555\\t                                                  \\\"secure\\\" :secure php/to-bool)\\n   556\\t                                            \\\"httponly\\\" :httponly php/to-bool)\\n   557\\t                                      \\\"samesite\\\" :samesite php/to-string))\\n   558\\t                      (let [has (fn [i] (> n i))\\n   559\\t                            put (fn [m i k f]\\n   560\\t                                  (if (has i)\\n   561\\t                                    (php/cookie-opt m k (f (get args i)))\\n   562\\t                                    m))]\\n   563\\t                        (put (put (put (put (put (put {} 2 :expires php/to-int)\\n   564\\t                                                          3 :path php/to-string)\\n   565\\t                                                    4 :domain php/to-string)\\n   566\\t                                              5 :secure php/to-bool)\\n   567\\t                                        6 :httponly php/to-bool)\\n   568\\t                                  7 :samesite php/to-string)))\\n   569\\t               cookie (assoc (assoc {} :name name)\\n   570\\t                             :value value\\n   571\\t                             :options opts)]\\n   572\\t           (do (php/emit-response! (assoc {} :php.response/cookie cookie)) true))))]\\n   573\\t    [php/bi-setrawcookie\\n   574\\t     (fn [args] (php/bi-setcookie args))]\\n   575\\t    [php/php-sapi-name\\n   576\\t     (fn [args] \\\"yin-http\\\")]\\n   577\\t    [php/bi-getenv\\n   578\\t     (fn [args]\\n   579\\t       (let [name (php/to-string (get args 0))\\n   580\\t             env (php/request-field (cell/get php.rt/request) :php.request/env)\\n   581\\t             value (php/array-get env name)]\\n   582\\t         (if (= value :php/null) false value)))]\\n   583\\t    [php/exit\\n   584\\t     ;; PHP exit: echo a string operand, then escape to the unit root,\\n   585\\t     ;; skipping exception handlers and finally blocks; shutdown functions\\n   586\\t     ;; and destructors still run and the status is preserved\\n   587\\t     (fn [value]\\n   588\\t       (if (= (php/kind value) :string)\\n   589\\t         (do (php/echo value) (php/root-exit 0))\\n   590\\t         (php/root-exit (php/to-int value))))]\\n   591\\t    [php/root-exit\\n   592\\t     ;; the distinct root exit continuation: an exit during shutdown only\\n   593\\t     ;; records its status and aborts the shutdown sequence\\n   594\\t     (fn [status]\\n   595\\t       (do (cell/set! php.rt/exit-status status)\\n   596\\t           (let [esc (if (= (cell/get php.rt/in-shutdown) true)\\n   597\\t                       (cell/get php.rt/shutdown-escape)\\n   598\\t                       (cell/get php.rt/exit-escape))]\\n   599\\t             (if (= esc :php/null)\\n   600\\t               (php/raise (assoc (assoc {} :php/type :exit) :status status))\\n   601\\t               (esc (assoc (assoc {} :php/terminal :exit) :status status))))))]\\n   602\\t    [php/root-fatal\\n   603\\t     ;; the terminal root escape for the operational fatal: guest handlers,\\n   604\\t     ;; returns and finalizers cannot replace it\\n   605\\t     (fn [message]\\n   606\\t       (let [esc (cell/get php.rt/fatal-escape)]\\n   607\\t         (if (= esc :php/null)\\n   608\\t           (do (php/unwind-to 1)\\n   609\\t               (php/raise (assoc (assoc {} :php/operational true) :message message)))\\n   610\\t           (esc (assoc (assoc (assoc {} :php/terminal :fatal)\\n   611\\t                              :php/operational true)\\n   612\\t                       :message message)))))]\\n   613\\t    [php/trigger-level-ok?\\n   614\\t     ;; trigger_error/user_error accept only the four user levels\\n   615\\t     (fn [level]\\n   616\\t       (if (= level 256) true\\n   617\\t         (if (= level 512) true\\n   618\\t           (if (= level 1024) true (= level 16384)))))]\\n   619\\t    [php/bi-trigger-error\\n   620\\t     (fn [args]\\n   621\\t       (let [msg (php/to-string (get args 0))\\n   622\\t             level (if (> (data/count args) 1) (php/to-int (get args 1)) 1024)]\\n   623\\t         (if (php/trigger-level-ok? level)\\n   624\\t           (if (= level 256)\\n   625\\t             ;; an unhandled E_USER_ERROR is fatal: the handler runs first,\\n   626\\t             ;; then the run ends through the terminal root escape\\n   627\\t             (do (php/warn level msg)\\n   628\\t                 (php/root-fatal msg)\\n   629\\t                 false)\\n   630\\t             (do (php/warn level msg) true))\\n   631\\t           (do (php/warn 2 \\\"trigger_error(): Invalid error level\\\")\\n   632\\t               false))))]\\n   633\\t    [php/zeros\\n   634\\t     (fn [n acc] (if (> n 0) (php/zeros (- n 1) (data/str-concat acc \\\"0\\\")) acc))]\\n   635\\t    [php/strip-zeros\\n   636\\t     (fn [s]\\n   637\\t       (let [n (data/str-length s)]\\n   638\\t         (if (> n 1)\\n   639\\t           (if (= (data/substring s (- n 1)) \\\"0\\\")\\n   640\\t             (php/strip-zeros (data/substring s 0 (- n 1)))\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nPR Reviewer Utility Script for Git-based Code Reviews.\\nParses git diffs, analyzes churn and file risk categories, scans for security smells\\nand debugging code, and produces structured markdown or JSON review reports.\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport json\\nimport os\\nimport re\\nimport subprocess\\nimport sys\\nfrom dataclasses import asdict, dataclass, field\\nfrom pathlib import Path\\nfrom typing import Dict, List, Optional, Tuple\\n\\n\\n@dataclass\\nclass Finding:\\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\\n    file_path: str\\n    line_number: Optional[int]\\n    message: str\\n    snippet: str\\n\\n\\n@dataclass\\nclass FileStat:\\n    path: str\\n    additions: int\\n    deletions: int\\n    category: str\\n    risk_level: str  # High, Medium, Low\\n\\n\\n@dataclass\\nclass ReviewSummary:\\n    target: str\\n    total_files: int\\n    total_additions: int\\n    total_deletions: int\\n    test_additions: int\\n    source_additions: int\\n    test_to_source_ratio: float\\n    file_stats: List[FileStat] = field(default_factory=list)\\n    findings: List[Finding] = field(default_factory=list)\\n    commits: List[str] = field(default_factory=list)\\n\\n\\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\\n    \\\"\\\"\\\"Helper to run git commands cleanly.\\\"\\\"\\\"\\n    cmd = [\\\"git\\\"] + args\\n    try:\\n        res = subprocess.run(\\n            cmd,\\n            cwd=cwd,\\n            stdout=subprocess.PIPE,\\n            stderr=subprocess.PIPE,\\n            text=True,\\n            check=True,\\n        )\\n        return res.stdout.strip()\\n    except subprocess.CalledProcessError as e:\\n        sys.stderr.write(f\\\"Git command failed: {' '.join(cmd)}\\\\nError: {e.stderr}\\\\n\\\")\\n        raise RuntimeError(f\\\"Git execution failed: {e.stderr.strip()}\\\")\\n\\n\\ndef categorize_file(file_path: str) -> Tuple[str, str]:\\n    \\\"\\\"\\\"Categorizes file type and assigns risk level.\\\"\\\"\\\"\\n    path_lower = file_path.lower()\\n\\n    # Security & Auth\\n    if any(k in path_lower for k in [\\\"auth\\\", \\\"secret\\\", \\\"crypto\\\", \\\"token\\\", \\\"permission\\\", \\\"jwt\\\", \\\"oauth\\\", \\\"password\\\"]):\\n        return \\\"Security/Auth\\\", \\\"High\\\"\\n\\n    # Database & Schema\\n    if any(k in path_lower for k in [\\\"migration\\\", \\\"schema\\\", \\\".sql\\\", \\\"entity\\\", \\\"db/\\\"]):\\n        return \\\"Database/Schema\\\", \\\"High\\\"\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1795050000000-architect-b2-escalations-step7.gpt-6.1-sol.stdout.log:67:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_34\",\"type\":\"agent_message\",\"text\":\"**Step-7: DEFECT at `03465799`.** Landing authority is withheld: the three escalations have rulings below, but additional correctness and acceptance gaps also need fixes on this branch.\\n\\nRead-only review of all six changed files, including `lower.cljc`. No files changed or suites run. Diff analysis and `git diff --check` completed; shiva execution remains outstanding.\\n\\nThe escalation rulings:\\n\\n1. **Init-time `raise` must terminate initialization and preserve the Throwable.** The ordinary `php/throw-error` path should produce the existing `:php/uncaught {:class … :message …}` result, rendered as `PHP Fatal error:  Uncaught …`. It must never become an array key or another successful value. Initialization timing alone does not turn a guest Throwable into an operational failure; operational failures retain their separate classification. This follows the project’s [exception semantics](/Users/sto/workspace/datomworld-b2/docs/design/yang.php.md:319).\\n\\n   Move request binding at [prelude.cljc:5293](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:5293) inside the root protected region, after terminal escapes and the root exception handler exist, before invoking the body. The empty-stack branch at [prelude.cljc:196](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:196) must fail loudly as an invariant violation rather than return `e`. Simply calling the current `root-fatal` there would recurse through its unset-escape fallback. Add an initialization-failure regression asserting the exception snapshot, no body execution, and no Error-valued data.\\n\\n2. **Invalid `trigger_error` levels throw `ValueError` in PHP 8.3.** The warning-plus-`false` implementation is incorrect. The pinned message for this call is:\\n\\n   ```text\\n   trigger_error(): Argument #2 ($error_level) must be one of E_USER_ERROR, E_USER_WARNING, E_USER_NOTICE, or E_USER_DEPRECATED\\n   ```\\n\\n   Use `php/throw-error \\\"ValueError\\\"` at [prelude.cljc:631](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:631). It is catchable; uncaught, it uses the ordinary exception snapshot, with no `E_WARNING` diagnostic or false return. Update the [fixture](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/programs_p5b2.cljc:97) and the test’s unconditional nil-uncaught assertion. Add a caught case too. [PHP 8.3 implementation](https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_builtin_functions.c)\\n\\n3. **`:linked` must accept requests too.** Request semantics belong to the PHP task, independent of prelude delivery. The [request model](/Users/sto/workspace/datomworld-b2/docs/design/yang.php.md:206), [§8.10.9 publication rule](/Users/sto/workspace/datomworld-b2/docs/design/yang.antlr.md:3943), and §8.11 require published code/specifications with task-local runtime state. They provide no bundled-only exception.\\n\\n   Keep one runtime request entry point for both profiles at [lower.cljc:3790](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/lower.cljc:3790); instantiate request state in the importing task. Add linked request/isolation coverage through [linked_harness.cljc:127](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/linked_harness.cljc:127). Do not publish live request cells or per-request superglobals in module exports.\\n\\nAdditional step-7 findings:\\n\\n- **P1 — Integer-key request merge is wrong.** [prelude.cljc:416](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:416) appends integer entries. PHP preserves their keys, overwrites colliding scalar values, and recurses when both colliding values are arrays—also for integer keys. Apply the same collision logic to both key kinds. The numeric fixture’s request should contain `ids[0]=\\\"30\\\"` and `ids[1]=\\\"20\\\"`, with no `ids[2]`; its current `102030post` expectation is wrong. The string-key nested case is correct. Add sparse integer keys and integer-key nested collisions. [PHP request merge](https://raw.githubusercontent.com/php/php-src/PHP-8.3/main/php_variables.c)\\n\\n- **P1 — `E_USER_ERROR` terminates even when handled.** [prelude.cljc:627](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:627) ignores whether the handler consumed the error. A matching handler returning anything except `false` permits execution to continue; absent/excluded/false-returning handlers take the default fatal path. Make handling disposition explicit rather than infer it from diagnostic emission. [Zend handler dispatch](https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend.c)\\n\\n  The default fatal path also cannot reuse operational termination unchanged: [prelude.cljc:5325](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:5325) bypasses shutdown functions and buffer draining. PHP still executes registered shutdown functions and flushes buffers after this fatal, while marking existing objects destructed. Preserve a distinct guest-fatal reason and test shutdown output, buffered output, handled continuation, and false-returning fallback. [PHP fatal and shutdown implementation](https://raw.githubusercontent.com/php/php-src/PHP-8.3/main/main.c)\\n\\n- **P2 — The stream-lifecycle finding remains open.** [lower.cljc:3791](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/lower.cljc:3791) embeds the request in compiled UAST; [prelude.cljc:456](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:456) still collects responses in a vector, as diagnostics do. Removing the postwalk establishes a production binder, but does not establish consumption/emission over composition-supplied request, response, and diagnostic streams. Wire and exercise that composition before declaring this P2 closed.\\n\\n- **P2 — HTTP behavior still has gaps.** Returning the previous status is correct for the existing 200-initialized profile. However, [prelude.cljc:524](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:524) treats `http_response_code(0)` as a setter; PHP treats it as a getter. Also, [prelude.cljc:504](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:504) claims HTTP status-line parsing that the implementation lacks. Implement and test those cases. Retaining `:replace` as an appended command is appropriate; test repeated, case-insensitive header names to establish replacement behavior. [Response-code implementation](https://raw.githubusercontent.com/php/php-src/PHP-8.3/ext/standard/head.c), [header status handling](https://raw.githubusercontent.com/php/php-src/PHP-8.3/main/SAPI.c)\\n\\n- **P2 — Cookie retention is useful, but the accepted signature is inaccurate.** [prelude.cljc:568](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:568) invents an eighth positional SameSite argument. PHP accepts at most seven positional arguments; SameSite belongs in the options array. Array option names are case-insensitive; unknown/numeric keys throw `ValueError`, and array form rejects extra positional arguments. Correct these newly interpreted forms. [PHP cookie parser](https://raw.githubusercontent.com/php/php-src/PHP-8.3/ext/standard/head.c)\\n\\nThe callback-and-mask save/restore implementation looks sound for ordinary nesting at [prelude.cljc:4623](/Users/sto/workspace/datomworld-b2/src/cljc/yang/php/antlr/prelude.cljc:4623). Its fixture only restores the default handler, though; add two distinct handlers/masks and restore the earlier pair.\\n\\nThe nine `:oracle :pending` fixtures are appropriately labelled provisional, but their passing assertions are not acceptance evidence yet:\\n\\n- The [new test](/Users/sto/workspace/datomworld-b2/test/yang/php/antlr/p5b2_lifecycle_test.clj:16) runs only the AST walker.\\n- The [oracle runner](/Users/sto/workspace/datomworld-b2/src/dev/yang/php/oracle.clj:364) does not enumerate B2. Its request serializer rejects nested values, its prologue still uses `array_merge`, and its fatal parser does not preserve the new guest-fatal representation.\\n- The initial-status expectation needs an explicit HTTP scaffold/profile treatment: bare CLI starts without the assumed HTTP 200. Header/cookie response-record shapes additionally need composition-contract checks.\\n\\n**Boundary discipline is confirmed:** no `yin.vm`, AST-tag, or codec changes. All corrections can remain in the PHP frontend, prelude, composition, and tests. Complete these fixes and run the relevant backend/e2e and corrected oracle gates before landing. The relayed occurrence-key equality requirement remains part of each frontend’s adoption acceptance; this B2 review does not discharge it.\"}}\ncollab/orch-lane/1795060000000-architect-p8-final-confirm3.gpt-6.1-sol.stdout.log:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat docs/agents/build-n-test.md && cat .agents/skills/code-review-pr/references/review_checklist.md && sed -n '1,220p' .agents/skills/code-review-pr/scripts/pr_reviewer.py\\\"\",\"aggregated_output\":\"---\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\n---\\n\\n# BUILD & TEST\\n\\n## Commands\\n\\n```sh\\n# Tests (Babashka runner)\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\nbb test:slow         # Only the slow tests, on every lane\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\n# (dao.test-slow/guard \\\"name\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\n# under test/), so the non-slow tests inside those namespaces also run there.\\n# On Node, shadow also runs the test namespaces those nine require (about\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\n# not subsystems). On the many-core remote hosts see \\\"Remote test servers\\\" below for\\n# which lanes may overlap.\\n#\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\n# (or `clojure -M:test -i :slow -n <ns>`).\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\n# When a test fails, reproduce and fix it by running ONLY the failing test\\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01.\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\n# overlap lanes, see \\\"Remote test servers\\\" below).\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\nnpm test             # Node.js tests\\n\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\n                         # and the linker L5 Node reader that requires a module\\n                         # by name): `clojure -M:test` without it fails that test\\n```\\n\\n### Changed-only tests: `bb test:changed`\\n\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\nreach: the reverse require closure of the files changed since the\\nmerge-base with master, plus fixtures that mention a changed resource path,\\ntests that walk a changed tree, and each src file's `_test` by convention.\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\n(let-bound roots count), and a change under a root selects it. The three\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\nas for a change to the core everything requires (yin.vm engine,\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\\nand spawned programs that changed (target/yin-repl.js, Dart peers).\\n\\n### Sharded quick JVM feedback and change routing\\n\\n```sh\\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\\nbb test:routed                                 # Git change set, same base as test:changed\\nbb deps:npm                                    # Content-checked local npm ci\\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\\n```\\n\\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\\nthe JVM portion of G3. Without selection flags it selects every JVM test;\\n`--changed FILE...` or `--base REF` uses `affected/select` and\\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\\nsemantics. `--workers N` must be positive (default 4 on the laptop).\\n\\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\\n`affected/select-subsystems` and the same longest-prefix ownership rule as\\n`test:sub`. As in the shiva script below, currently unowned namespaces run\\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\\nPrerequisites are derived from the entire selected JVM reach and finish\\nserially before workers start; the Node REPL build prerequisite\\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\\n\\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\\nand `summary.edn`. Before execution it checks **set equality** between selected\\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\\nThe final summary totals tests, assertions, failures and errors and separates\\nJVM wall time from total time including selection/builds. A nonzero child exit,\\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\\nDry plans write namespace evidence but execute no builds or tests. An empty\\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\\n\\n`test:routed <changed-files...>` applies this priority table to the whole change\\nset, prints the exact dispatch, executes it and propagates its result:\\n\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Change class (first match wins)                                                              | Dispatch                                                              |\\n+==============================================================================================+=======================================================================+\\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\\n|                                                                                              | lint only                                                             |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\\n|                                                                                              | selection                                                             |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\n\\nMixed changes take the widest matching route. Missing paths, an empty git change\\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\\nits zero exit is **not** a verification result. Documentation checks inspect\\nstaged and unstaged changes together against HEAD. Paths absent from\\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\\nexecutable examples or validate documentation links.\\n\\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\\nmeans the dispatched gate completed successfully, not that every landing gate\\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\\nand failed dispatches. Successful checked docs, selected tri-host, and full\\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\\nresults, so automation must inspect the scope as well as the exit code.\\n\\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\\ntri-host success: for foundation/compiler changes also run\\n`bb test:changed:cljs --changed <paths>` and\\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\\ndemo smoke checks and review/landing gates all remain required. Node and Dart\\nlanes retain their current commands. The original unsharded tasks remain\\navailable. **Individual tests may run on the laptop; suite-scale runs may\\nnot (owner ruling 2026-11-04).** A single failing test or one namespace\\nreproduces quickly and is fine locally. Everything suite-scale — subsystem\\nlane sets (G1), changed-set runs (G2), the full quick suite, the slow tier,\\n`bb test:all`, and `nightly.clj` — runs on the remote hosts: the suite has\\noutgrown the laptop. The slow tier is 52 long namespaces whose JVM\\nprocesses each multi-thread (test workers, JIT, GC threads sized by core\\ncount); four of them GC-thrashing at once drove a laptop load average over\\n100 on 2026-11-01 while making no progress (the remote hosts run this tier:\\njupiter 5,645 s at 12 workers, shiva comparable). Do not run another lane\\nset concurrently on the laptop either.\\n\\n#### Worktree-local prerequisite caches\\n\\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\\nrecorded helper/generated digests and runtime pins), the generator/cache source,\\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\\nremoved or corrupted outputs trigger a full generation, retaining the generator's\\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\\ninvalidate the complete-build stamp.\\n\\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\\nenvironment and worktree identity; it verifies the installed file tree before\\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\\nensure this dependency too. Direct `npm ci` is still available.\\n\\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\\nlock only after confirming its owning process died. Symlinked output parents\\nthat escape the worktree are refused. This is reuse **within one worktree**,\\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\\nstill require the existing worktree isolation/serialization rules; the cache\\ndoes not make overlapping builds and tests safe. Peer executables and shadow\\nbuilds themselves are not cached by this mechanism.\\n\\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\\nouter command **258.27 s**). The original `test:changed:clj` command completed\\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\\nrounds to whole seconds). The investigation's earlier unsharded command had\\ntimed out at 300 s without a summary. These are single-run observations, not\\na median/p95 claim or a replacement for tri-host landing verification.\\n\\n### Subsystem-first tests: `bb test:sub`\\n\\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\\nis by longest namespace prefix matching.\\n\\n```sh\\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\\nbb test:sub:clj <subsystem>...    # JVM lane alone\\nbb test:sub:cljs <subsystem>...   # Node lane alone\\nbb test:sub:cljd <subsystem>...   # Dart lane alone\\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\\n```\\n\\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\\n\\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\\n- **Infrastructure**: `dev`, `bench`\\n\\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:antlr`)\\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\\nselected namespaces and run automatically when needed.\\n\\n#### Gate Ladder (docs/design/test.subsystems.md)\\n\\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\\n   **Failure-reproduction rule (owner ruling 2026-11-01): when a test fails anywhere — a\\n   gate, the nightly, or a delegate report — reproduce and fix it by running ONLY the\\n   failing test, never the whole suite.** JVM: `clojure -M:test -n <ns>` (a single\\n   deftest: add `-v <ns>/<var-name>`). Node: `node target/node-tests.js --test=<ns>`\\n   (built by `bb build:yin-repl-node` first only if that test needs the Node REPL).\\n   Dart: `bb src/dev/cljd_agg.clj --only <ns>`. Fix against the failing test alone,\\n   re-run it green, then climb back up (G1 for the home subsystem, G2 for dependents).\\n   Never reproduce or chase a failure with the full suite or the slow tier — the full\\n   suite is not a debugging tool, and running it locally for one failing test is the\\n   exact misuse that drove a laptop load average over 100 (2026-11-01). A failure that\\n   only reproduces under the full suite's concurrency is diagnosed with the suite's own\\n   logs (its per-shard/per-test output), not by re-running the suite repeatedly.\\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\\n4. **G3 Master (merged in place by the 2026-11-01 owner ruling)**: The landing gate\\n   for a change is the **tests that cover the feature being built** — `bb test:changed`\\n   (G2) already includes the reverse-require closure of the changed files, and a wide\\n   change still routes to the full quick lane. The complete suite is no longer a\\n   per-merge gate: it runs twice a day on the remote hosts (see \\\"Cadence\\\" below), so a\\n   break is caught within hours without charging every merge ~400 minutes of slow tier.\\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge\\n   (`bb test:slow` or `bb test:all`), at each phase boundary of a multi-phase track\\n   (owner decision 2026-10-12), and implicitly twice daily by the scheduled run below.\\n   G0 to G3 run the quick tier; G4 runs the slow tier.\\n\\n\\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\\nslice L5) is two tests:\\n\\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\\n  processes over real loopback UDP. A JVM publisher with a key file\\n  publishes modules by name, and JVM and Node readers require them by\\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\\n  and checks each section 9 failure as data. Ports are ephemeral, and\\n  every wait is bounded. A run takes a few minutes. Run it alone with\\n  `clojure -M:test -n yin.repl.dht-process-test`, after\\n  `bb build:yin-repl-node`.\\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\\n  signed-name leg runs here, because no Dart `yin.repl.main` process\\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\\n  REPL.\\n\\n```sh\\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\\n\\n# ClojureDart\\nclj -M:clojuredart:cljd compile\\n\\n# Linting\\nclj -M:kondo --lint <path>\\n```\\n\\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\\n(greedy by file size; each imports its files and calls their `main`), runs\\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\\ndifferent namespaces share an isolate per shard. Failures stay attributable:\\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\\n\\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\\ncompile does not prune it when a source file is deleted or renamed. The\\naggregated lanes only run namespaces that still exist under `test/`, but a\\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\\nbefore relying on that to prove a deletion or rename took effect.\\n\\n## Test tiers: quick and slow\\n\\nThe suite has two tiers so that slow tests run less often than quick ones\\n(owner decision, 2026-10-12).\\n\\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\\n- **Slow tier:** the tagged deftests. `bb test:slow` or\\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\\n- **The tagging rule** is the one above (\\\"When to tag a test slow\\\"): a deftest that\\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\\n  in all (some were already tagged). Per-test times are not in the repo: measure again\\n  with the method below before changing the cut.\\n- **Cadence (owner ruling 2026-11-05):** a merge needs only the tests that cover the\\n  feature being built — the affected/dependent set from `bb test:changed` (or\\n  `bb test:sub <own> --slow` when the change touches slow-tagged code). The FULL suite,\\n  including the slow tier, runs **once a day at 04:00 Asia/Ho_Chi_Minh** as a\\n  disjoint lane pair (`src/dev/nightly.clj`): **jupiter takes the jvm lane, shiva\\n  takes node and dart** (each lane in its own clone; shiva publishes the run pin,\\n  jupiter reads it and falls back to its own current master as an advisory run).\\n  The measured long set is ~400 minutes of serial slow-tier work, so it cannot be\\n  a per-merge cost; a break is instead caught by the next scheduled run.\\n  The schedule is an **hourly cron plus a Vietnam-time guard** in\\n  `~/ci/nightly-cron.sh` on each host (the guard fires only at the 04 VN hour and\\n  `flock` skips a slot whose previous run is still active), so it is immune to the\\n  DST shifts of either host's local timezone. **The cron entries are currently\\n  REMOVED (owner instruction 2026-11-06)**: the wrappers remain installed on both\\n  hosts and re-arming is one crontab line each\\n  (`0 * * * * ~/ci/nightly-cron.sh >> ~/ci/nightly-cron.log 2>&1`). Logs:\\n  `~/ci/nightly-cron.log`; results: `~/ci/nightly-results/<stamp>/summary.txt`.\\n\\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \\\"Remote test\\nservers\\\" for how to run them):\\n\\n| Run | Time |\\n|---|---|\\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\\n\\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\\n\\n**How the per-test times were measured.** To time every deftest of a namespace alone,\\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\\notherwise swallows `-e`, and every JVM runs the whole suite):\\n\\n```sh\\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\\\"test\\\"]}}}' -M:t timing.clj\\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\\n# load) is paid by the first test in file order; check before tagging that test alone.\\n```\\n\\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\\nJVM test namespace under `test/`:\\n\\n```sh\\n#!/usr/bin/env bash\\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\ncd \\\"$1\\\" || exit 2\\nPAR=\\\"${2:-8}\\\"\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nOUT=\\\"$1/target-ci/shards\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\nts() { date +%H:%M:%S; }\\necho \\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\" | tee \\\"$OUT/summary.txt\\\"\\nnpm ci --silent >\\\"$OUT/npm.log\\\" 2>&1                   && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nbb build:yin-repl-node >\\\"$OUT/build-node.log\\\" 2>&1     && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nbb gen:antlr >\\\"$OUT/antlr.log\\\" 2>&1             && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nSUBS=\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\"\\n: > \\\"$OUT/covered.txt\\\"\\nfor s in $SUBS; do\\n  bb test:sub:list \\\"$s\\\" 2>/dev/null | awk \\\"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\"\\\\\\\");print}\\\" > \\\"$OUT/ns-$s.txt\\\"\\n  cat \\\"$OUT/ns-$s.txt\\\" >> \\\"$OUT/covered.txt\\\"\\n  echo \\\"$s $(wc -l < \\\"$OUT/ns-$s.txt\\\")\\\" >> \\\"$OUT/plan.txt\\\"\\ndone\\n# coverage: every JVM test namespace under test/ vs the union of the shards\\nfind test -type f \\\\( -name \\\"*_test.clj\\\" -o -name \\\"*_test.cljc\\\" \\\\) | sed -e \\\"s#^test/##\\\" -e \\\"s#\\\\.cljc\\\\?\\\\$##\\\" -e \\\"s#/#.#g\\\" -e \\\"s#_#-#g\\\" | sort -u > \\\"$OUT/all.txt\\\"\\nsort -u \\\"$OUT/covered.txt\\\" > \\\"$OUT/covered.sorted\\\"\\ncomm -23 \\\"$OUT/all.txt\\\" \\\"$OUT/covered.sorted\\\" > \\\"$OUT/ns-uncovered.txt\\\"\\necho \\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\nrun_shard() {\\n  s=$1; f=\\\"$OUT/ns-$s.txt\\\"; [ -s \\\"$f\\\" ] || return 0\\n  args=(); while read -r n; do args+=(-n \\\"$n\\\"); done < \\\"$f\\\"\\n  t0=$(date +%s); clojure -M:test -e :slow \\\"${args[@]}\\\" >\\\"$OUT/$s.log\\\" 2>&1; rc=$?\\n  echo \\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\"^Ran \\\" \\\"$OUT/$s.log\\\" | tail -1)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n}\\nexport -f run_shard; export OUT; export -f ts\\nprintf \\\"%s\\\\n\\\" $SUBS uncovered | xargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_shard {}\\\"\\necho \\\"done $(ts)\\\" | tee -a \\\"$OUT/summary.txt\\\"\\n```\\n\\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\\n\\n```sh\\n#!/usr/bin/env bash\\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\ncd \\\"$1\\\" || exit 2\\nPAR=\\\"${2:-6}\\\"\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nOUT=\\\"$1/target-ci/slowtier\\\"; rm -rf \\\"$OUT\\\"; mkdir -p \\\"$OUT\\\"\\nrun_ns() {\\n  n=$1; t0=$(date +%s)\\n  clojure -M:test -i :slow -n \\\"$n\\\" > \\\"$OUT/$n.log\\\" 2>&1; rc=$?\\n  echo \\\"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \\\"^Ran \\\" \\\"$OUT/$n.log\\\" | tail -1)\\\" >> \\\"$OUT/summary.txt\\\"\\n}\\nexport -f run_ns; export OUT\\necho \\\"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\\\" > \\\"$OUT/summary.txt\\\"\\nxargs -P \\\"$PAR\\\" -I{} bash -c \\\"run_ns {}\\\" < \\\"$HOME/ci/pertest-ns.txt\\\"\\necho \\\"done $(date +%H:%M:%S)\\\" >> \\\"$OUT/summary.txt\\\"\\n```\\n\\n## Remote test servers: shiva and jupiter\\n\\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\\nand `git`.\\n\\n| Host | Cores / RAM | Toolchain state (server snapshot checked 2026-10-11; repo selection comes from `mise.toml`) |\\n|---|---|---|\\n| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\\n| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\\n\\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\\n\\n### Get the code there: push to origin, never rsync\\n\\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\\nwould take about an hour), and an unanchored `--exclude build` also dropped source\\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\\nbranch from the laptop (a feature branch, never master), make one scratch clone on\\nthe host from its existing checkout (a local clone takes seconds), and fetch:\\n\\n```sh\\n# once per host: a separate scratch clone, not the working copy\\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\\n  URL=$(git remote get-url origin);\\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\\n  cd ~/ci/datomworld-<name>; git remote set-url origin \\\"$URL\\\";\\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\\n```\\n\\nTo test another branch later, fetch and check it out in the scratch clone with\\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\\nwas never pushed cannot be tested remotely.\\n\\n### A clone is only current if it updated from real master\\n\\nA scratch clone's `origin/master` ref is only as fresh as the place it fetches\\nfrom — and a clone made from another scratch clone inherits that clone's *stale*\\nrefs. Measured on shiva 2026-11-02: the `dg` clone was created from the `p4`\\nscratch clone, whose local `master` ref had not moved since October 26 because\\nevery lane on it ran detached off fetched branches; the `dg` lane's\\n`checkout origin/master` therefore produced a commit 436 commits behind real\\nmaster, and the G3 Dart leg honestly reported failures (the datagram fix) for a\\ntree that did not contain them.\\n\\nBefore any lane runs in a clone — every time, not just the first:\\n\\n```sh\\ncd ~/ci/datomworld-<name>\\ngit remote get-url origin          # must be the GitHub URL, never another scratch clone\\ngit fetch -q origin \\\"+refs/heads/*:refs/remotes/origin/*\\\"\\ngit checkout -q --detach origin/master   # or the lane's branch\\ngit merge-base --is-ancestor <the-commit-hash-you-pushed> HEAD && echo CURRENT\\n```\\n\\nIf `origin` is not GitHub, repoint it (`git remote set-url origin \\\"$URL\\\"`). If\\nthe `merge-base` check fails, the clone's bookkeeping lies: refetch, or delete\\nand recreate the clone from GitHub directly. Never trust a hash the clone\\nreports without comparing it to the hash your push from the laptop printed.\\n\\n### Activate the toolchain in the right order\\n\\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\\ninto the clone:\\n\\n```sh\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\\ncd ~/ci/datomworld-<name>\\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\\nmise install                                    # install versions selected by this checkout's mise.toml\\neval \\\"$(mise env -s bash)\\\"                       # puts the repo-selected tools on PATH\\nmise current flutter                            # verify the selected Flutter version\\n```\\n\\nActivating mise before the `cd` and `mise trust` leaves the repo-selected tools\\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \\\"Can't\\nfind flutter on PATH\\\", and so does `bb build:yin-repl-peer`.\\n\\n### Which lanes may overlap (reconciling the one-lane-set rule)\\n\\n\\\"One lane set at a time\\\" and \\\"one Dart lane at a time\\\" are per-machine rules about\\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\\n`test.subsystems.md` section 5 item 6 says the same (\\\"on one machine where\\navoidable\\\"). The laptop additionally never runs the slow tier or the nightly\\ndriver (see the sharded-lane section) — a full slow tier there reached a load\\naverage over 100 on 2026-11-01; the remote hosts own that tier. On shiva (24 cores) and jupiter (48) the cores are not the limit, so\\nlanes may overlap, with these limits:\\n\\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\\n  by the design's own reasoning (\\\"each worktree owns its own `cljd-out`\\\"), not yet\\n  verified by a measured run.\\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\\n  JVM lane only reads `target/yin-repl.js`.\\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\\n- **Different branches in different clones** are independent, so two branches may\\n  run on one host if its cores and RAM allow (62 GB each).\\n- Do not treat this as permission to overlap lanes on the laptop.\\n\\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\\nthis rule was written down; its results are advisory until repeated with a\\nseparate Dart clone.\\n\\n**The nightly driver now enforces this by construction.** `src/dev/nightly.clj`\\n(2026-11-03, kimi-reviewed) runs a multi-lane invocation as one concurrent\\nfuture per lane, each in its OWN clone — jvm keeps the primary clone, node\\nand dart get `<primary>-node` / `<primary>-dart`. The pinned SHA is resolved\\nonce and checked out in every lane clone; a cache-warm pass\\n(`clojure -P -M:test:cljs:clojuredart:cljd`) runs in the primary before\\nfan-out so two clones never fetch into the shared `~/.m2`/`~/.gitlibs`\\nconcurrently; per-lane summaries are appended serially after the futures\\njoin. A single-lane invocation (jupiter's `jvm`) is unchanged: one clone,\\none serial lane. Both hosts run the same driver — the lane list on the\\ncommand line (shiva: `node,dart` + `--pin-publish`; jupiter: `jvm` +\\n`--pin-read --pin-peer shiva...`) is the only difference.\\n\\n### Scratch-clone first-run gaps (two measured sightings)\\n\\nA fresh scratch clone needs two things the lane runner does not yet set up\\nitself; until the runner heuristic is fixed, do them by hand before the\\nfirst lane:\\n\\n1. **`npm install`** — the Node tests require npm deps (`@noble/hashes` was\\n   the measured miss on shiva 2026-11-02: the cljs lane ran but the\\n   node-tests bundle died with `MODULE_NOT_FOUND`).\\n2. **`bb gen:antlr`** — the `prerequisites` heuristic in\\n   `src/dev/affected.clj` decides `:gen:antlr` from the JVM lane's reach\\n   only (\\\"ANTLR classes are JVM only\\\" — stale: python keeps multi-target\\n   parsers), so a cljs/cljd-only selection that reaches\\n   `yang.python.antlr.parser` (e.g. `bb test:sub:cljs yang.base` via\\n   `yin.repl.frontends`) skips the generation and the shadow build dies on\\n   the missing `Python3Lexer.js`. Sighted independently on the p4 lane\\n   (PhpLexer ClassNotFoundException) and the yang.base cljs lane\\n   (2026-11-02). The lane-runner fix landed 2026-11-03 (eb27fd47).\\n\\n### Merge verification: run the suite from a fresh clone, not the authoring worktree\\n\\nA merge whose new code reads a file that was never `git add`ed passes in\\nthe authoring worktree (the untracked file is still on disk there) and\\nbreaks everywhere else. Measured: the H3-0 landing (1fd7236b) merged\\n`kernel-declarations` — which reads\\n`yang/latte_oracle/slice9_declarations.edn` via `io/resource` at load —\\nwithout the file (untracked in the authoring worktree); master's\\nyang.latte-oracle-test died at load until the file was restored\\n(2026-11-04). Before landing any merge that adds code reading a new\\nresource, or after any merge at all when in doubt:\\n\\n```sh\\ngit worktree add /tmp/merge-verify <merge-commit>\\ncd /tmp/merge-verify && <the touched subsystem's focused test>\\ngit worktree remove /tmp/merge-verify\\n```\\n\\nA fresh clone/worktree has only committed files — a missing untracked\\nresource fails there immediately.\\n\\n### Ledger commit hygiene: never commit a conflict marker\\n\\nThe append-only ledgers (`docs/agents/known-gaps.md`,\\n`orchestrator-logs/*.md`, `docs/agents/routing-status.md`) resolve rebase\\nand merge conflicts by the union rule, which means conflicts are common —\\nand a conflict marker that reaches a commit silently corrupts the record\\n(measured: the 2026-10-30 rebase landed a log with three committed\\n`<<<<<<<`/`>>>>>>>` markers and dropped records the union was supposed to\\nkeep; caught by the architect four rounds later). Before committing ANY\\nchange to a ledger file:\\n\\n```sh\\ngit diff --cached | grep -E '^\\\\+(<{7}|={7}$|>{7})' && echo CONFLICT-MARKERS-STAGED\\ngit grep -E '^(<{7}|={7}$|>{7})' -- docs/agents/known-gaps.md orchestrator-logs docs/agents/routing-status.md\\n```\\n\\nIf either hits, the commit stops until the union is redone. When resolving\\na ledger conflict, prefer regenerating the union from both sides' section\\nlists over hand-merging, and re-read the result against BOTH parents before\\nstaging.\\n\\n### The jolt J2 lane: run it with `--jobs` on the servers\\n\\nThe jolt lane's core mode (`bb src/dev/jolt_j2_lane.clj core [--jobs N]\\n[--only re] [--timeout-ms M]`) runs each test namespace as its own child jolt\\nprocess (own Chez VM, own native parser library load, own log under\\n`build/j2-logs/core/`), so the namespaces cannot corrupt one another — the\\nonly thing `--jobs N` overlaps is the waiting. The default is `jobs 1`\\n(strictly serial), which on jupiter makes the full ~179-namespace lane a\\n5-6-hour run.\\n\\nOn the servers, run it with `--jobs 16`:\\n\\n- jolt children are essentially single-threaded (the 16 MiB parse thread\\n  only burns during parses) and cost 1-2 GB each, so 16 concurrent children\\n  sit far inside jupiter's 48 cores / 62 GB and shiva's 24 / 62;\\n- the lane's wall time is dominated by a few long namespaces\\n  (`yin.repl.python-antlr-test` has an explicit 3-hour step,\\n  `yin.vm.semantic.safepoint-harness-test` needs one — see\\n  `step-timeout-ms` in `src/dev/jolt_j2_lane.clj`), so beyond ~16 workers\\n  the critical path is the longest child, not the count;\\n- **parallel is unproven until checked once**: the recorded lane evidence\\n  (J2 closure, the safepoint 60/265,225/0 pass) was all produced `jobs 1`.\\n  The first parallel run must be compared per-namespace against a serial\\n  baseline; any namespace that flips red gets one serial re-run to\\n  attribute before its evidence is trusted. Until that first comparison\\n  passes, keep `jobs 1` for anything whose verdict is timing-sensitive —\\n  timeout and wall-time measurements, native-memory/leak gates, and the\\n  merge-decision qualification runs.\\n\\nSuites that exceed the lane's default step budget are pinned in the lane's\\n`step-timeout-ms` map with their measured wall time; a namespace timing out\\nunder the default budget is a reason to measure it serially and add an\\nentry, not to re-run under the same bound.\\n\\n### The full run\\n\\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\\ntasks use (the `bb test` task runs them one after another), and records each\\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\\n\\n```sh\\n#!/usr/bin/env bash\\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (both hosts run all three lanes; a second clone for Dart is recommended)\\nset -u\\nexport PATH=\\\"$HOME/.local/bin:/snap/bin:$PATH\\\"\\nDART=\\\"${2:-}\\\"\\ncd \\\"$1\\\" || exit 2\\nmise trust >/dev/null 2>&1\\neval \\\"$(mise env -s bash)\\\"\\nLOG=\\\"$1/target-ci\\\"; mkdir -p \\\"$LOG\\\"\\nts() { date +%H:%M:%S; }\\necho \\\"start $(ts) $(git rev-parse --short HEAD)\\\" | tee \\\"$LOG/summary.txt\\\"\\nnpm ci --silent >\\\"$LOG/npm.log\\\" 2>&1               && echo \\\"npm ok $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb build:yin-repl-node >\\\"$LOG/build-node.log\\\" 2>&1 && echo \\\"node repl built $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb gen:antlr >\\\"$LOG/antlr.log\\\" 2>&1         && echo \\\"antlr ok $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nbb build:yin-repl-peer >\\\"$LOG/build-peer.log\\\" 2>&1 && echo \\\"dart peer built $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\nlane() { name=$1; shift; s=$(date +%s); \\\"$@\\\" >\\\"$LOG/$name.log\\\" 2>&1; rc=$?\\n         echo \\\"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"; }\\nlane jvm  clojure -M:test -e :slow &\\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\\nif [ -n \\\"$DART\\\" ]; then                            # its own clone (own lib/cljd-out, build/)\\n  ( cd \\\"$DART\\\" && mise trust >/dev/null 2>&1 && eval \\\"$(mise env -s bash)\\\"\\n    bb build:yin-repl-peer >\\\"$LOG/build-peer-dart.log\\\" 2>&1\\n    lane dart bb src/dev/cljd_agg.clj ) &\\nfi\\nwait\\necho \\\"done $(ts)\\\" | tee -a \\\"$LOG/summary.txt\\\"\\n```\\n\\n```sh\\nssh <host> 'tmux new-session -d -s ci-full \\\"bash -lc \\\\\\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\\\\\"\\\"'\\n```\\n\\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\\n`bb test:clj`. For the slow set use `-i :slow` (or `bb test:slow`); the slow C4\\nscanner row took about 11-19 minutes on the JVM and about 79 minutes on Node\\n(measured 2026-10-11).\\n\\n### Known differences from the laptop\\n\\n- **`dao.stream.datagram.dart-test/refusals-and-lifecycle-events` on Linux —\\n  MEASURED AND FIXED (2026-11-02).** The old entry inferred that \\\"a second UDP bind on\\n  a taken port behaves differently on Linux\\\"; confirmed, with the cause. Dart's\\n  `RawDatagramSocket.bind` defaults to `reuseAddress: true`, and **Linux honours\\n  `SO_REUSEADDR` for UDP**, so a second bind to a port a reuse-enabled socket already\\n  holds *succeeds* (`strace`: `SO_REUSEADDR=1` on both sockets, no `SO_REUSEPORT`, both\\n  kernel `bind()` calls succeed); macOS refuses with errno 48. The seam was correct\\n  throughout — given a genuinely exclusive holder (`reuseAddress: false`) it deposits\\n  `bind-failed` in ~10 ms with errno 98. The test asserted one host's binding policy\\n  rather than the contract, so it now binds its own exclusive blocker\\n  (`RawDatagramSocket.bind \\\"127.0.0.1\\\" 0 .reuseAddress false .reusePort false`) and\\n  points the seam at that port: the failure path is exercised on both hosts. Verified\\n  on shiva: the namespace passes 5/5.\\n- A JVM lane started before the Dart peer is built skips the Dart-peer tests with a\\n  printed notice. The script builds the peer first so they run.\\n- Both hosts run other work (a QEMU guest and rustdesk on shiva); idle load is\\n  under 1, but timings are not a clean benchmark.\\n\\n### The nightly full suite and the branch-testing rule (2026-10-30 owner ruling)\\n\\nOwner, verbatim: \\\"since the complete test can take a good 7-8hrs to run\\ncompletely, it should be schedule to run once a day at 3am. while\\nbranch/worktree test should only run test that are targeting code\\nchanges\\\" — and, clarifying the nightly's target: \\\"it should not be for\\nonly a worktree/branch. the nightly complete test should be for master.\\\"\\n\\nTwo tiers, by target and purpose:\\n\\n- **The nightly full suite runs MASTER ONLY** (`~/ci/nightly-cron.sh` on\\n  shiva and jupiter, hourly cron plus a 04:00 Vietnam guard and flock,\\n  documented under \\\"Cadence\\\" above; the driver fetches and checks out\\n  origin/master before anything runs). Every lane, across the host pair:\\n  the JVM full suite on jupiter, the full Node and Dart suites on shiva.\\n  Its results are a\\n  post-hoc integrity net for master, NOT a landing gate. Failures it\\n  finds route to fix rounds the next morning.\\n- **Branch/worktree testing runs only the namespaces that target the\\n  changed code** (the diff's own tests plus the surfaces the diff\\n  touches), one JVM per namespace, plus one cheap portable lane (Node)\\n  when cljc goldens or fixtures moved. Never the full tier on a branch:\\n  a branch gate needs the changed code proven, not the whole tree\\n  re-proven. A branch is never promoted by its own testing — the merge\\n  to master is what puts it under the nightly.\\n\\nAn orchestrator landing a slice cites the subset runs plus the gate\\nsign-off; the nightly catches what the subset could not see, and a red\\nnightly owns the follow-up.\\n\\n**The merge precondition (2026-10-30 owner ruling, restored 2026-10-31 —\\na dedup pass dropped this section along with a stale duplicate of the\\ntwo-tier policy; both stand):** before any merge into master, the\\n`dao.stream` tests must run and pass — dao.stream is what everything is\\nbuilt on. Concretely: `bb test:sub dao.stream` (the subsystem's tests,\\n`--slow` when the slice touches slow-guarded surfaces) is part of every\\nbranch gate regardless of which subsystems the diff's own changes\\nselect, because a change can break the foundation without touching it.\\nA red dao.stream blocks the merge until fixed or diagnosed as\\npre-existing by the owning seat.\\n\\n### Measured times (first runs, 2026-10-11, commit 84c7c9b7, all lanes concurrent)\\n\\nShiva, Dart lane: 1054 s (17.5 min) cold, with the JVM and Node lanes running beside\\nit, against about 9 minutes on the 8-core laptop run alone. Prerequisites (`npm ci`,\\nNode REPL, ANTLR) took about 30 s; the Dart peer 91 s. JVM and Node lane times are\\nnot recorded yet: fill them in from `summary.txt` after a completed run. Running the\\nlanes concurrently on one host did not make the Dart lane faster, so count on the\\nextra cores, and measure before relying on a speedup. (Historical record — the\\n\\\"free laptop\\\" comparison predates the 2026-11-04 ruling that suite-scale runs\\nbelong on the remote hosts.)\\n\\n### Jupiter verification run (2026-10-29, commit 7c0a078f, scratch clone, sequential lanes)\\n\\nFirst full tri-host verification of jupiter. Prerequisites (npm ci, Node REPL,\\nANTLR via `gen:antlr`, Dart peer) all succeeded; the stale 3.41.9 Flutter was\\nreplaced with 3.47.8 before the Dart lane. Results: **JVM quick tier\\n(`test:quick-sharded`, 12 workers) rc=0 in 702 s** (cold, every shard green);\\n**Node quick tier rc=0 in 4583 s** (all tests pass, but roughly 15x the\\nlaptop — route Node lanes to shiva; the laptop comparison is historical and\\nsuite-scale Node runs no longer belong there per the 2026-11-04 ruling);\\n**Dart quick tier\\nrc=1 in 1495 s with the ONLY failure the documented known Linux-only red**\\n(`dao.stream.datagram.dart-test/refusals-and-lifecycle-events`, same\\ntaken-port/bind-failed signature recorded above). Routing summary: jupiter\\nis the preferred JVM/sharding box (48 cores); Node stays off it when wall\\ntime matters; Dart works on either host. Timings are single cold runs, not\\nmedians, and two foreign QEMU guests idle on the host.\\n\\nOne exception to the concurrency above: never run two lanes that both trigger\\n`gen:antlr` (the quick `test:cljs`/`test:cljd` tasks) in the SAME worktree at the\\nsame time — they race on `build/antlr` and `lib/antlr` and fail with\\n\\\"Patch does not apply\\\" or \\\"Generated sources differ from the recorded digests\\\".\\nRun them sequentially, or in separate clones (as the slow-tier harness does).\\nThe fix after a collision is `rm -rf build/antlr lib/antlr` and a rerun; the\\ngenerator is not idempotent over an already-patched tree. Corroborated twice in\\none week (the M3 round and the C3 completion round, 2026-10-18).\\n\\n### Remote agent execution (delegate CLIs on shiva and jupiter)\\n\\nOwner relay, 2026-10-24: the delegate agent CLIs — `claude`, `codex`, `glm` —\\nare installed and usable **on the remote hosts themselves**, not only from the\\norchestrator's laptop. This generalizes this section from \\\"run tests remotely\\nover SSH\\\" to \\\"delegate whole work agents remotely\\\": a heavy implementation or\\nverification leg (test lanes, native builds, fault-injection runs, multi-hour\\nsuites) can be executed by a delegate agent running on the server, keeping the\\norchestrator's laptop unloaded.\\n\\nThe pattern (composed from the rules above plus the delegate-invocation\\nreference):\\n\\n1. **Land the branch on origin first** (push from the laptop; never rsync) and\\n   prepare the scratch clone per \\\"Get the code there\\\".\\n2. **Start a named tmux session** for the task; run the agent inside it with\\n   the toolchain activated *inside* the tmux command (`eval \\\"$(mise env -s\\n   bash)\\\"` after the `cd` — the non-interactive SSH shell does not have it).\\n   A fresh clone hits mise's interactive trust prompt, which blocks the whole\\n   session until answered via `tmux send-keys`; pre-empt it with `mise trust`\\n   inside the same command.\\n3. **The remote agent works in the clone**: implement, build, run lanes,\\n   write its findings artifact — the same brief form as any delegate dispatch\\n   (role template, bounded file ownership, deliverable path), just executing\\n   on the host. Long jobs survive SSH drops because of tmux.\\n4. **The orchestrator polls detached files, never the pane** (pane captures\\n   carry control characters that make output look empty): rc files, summary\\n   logs and `ls *.flag` sentinels written by the run.\\n5. **Division of labor**: bookkeeping and polling are orchestrator SSH\\n   one-liners; execution belongs to the remote agent. Do not run heavy lanes\\n   from the orchestrator's laptop while a remote agent owns the same gate.\\n6. **Same trust rules as any delegate**: remote execution does not waive\\n   Workflow steps 6–7 of the orchestrator role — artifacts are verified, and\\n   review before commit applies to remote-produced work identically.\\n   Session-ID capture and resume rules from the delegate-invocation reference\\n   apply per host (each host's `~/.claude`, `~/.codex` store is its own).\\n\\nKnown state: `claude` and `codex` verified working on shiva (2026-10-24, the\\njolt canonical-fixes verification ran there); `glm` reported available by the\\nowner on both hosts, not yet exercised. Both hosts are toolchain-verified for\\nthe full tri-host suite (jupiter verified 2026-10-29 — see Measured times;\\nits 3.41.9 Flutter was replaced with 3.47.8, and model availability per\\nhost is governed by `routing-status.md`, not this file).\\n\\n## Testing Philosophy & TDD\\n\\nWrite tests before implementing features (TDD).\\n\\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\\n\\nWhen implementing a feature or fix:\\n1. **Red phase**: Write the test first — define what should happen.\\n2. **Green phase**: Implement the minimum code to pass the test.\\n3. **Refactor phase**: Refactor if needed while keeping tests green.\\n\\nThis ensures code is testable by design and implementation matches actual requirements.\\n\\n## Debugging Malformed CLJ / EDN / CLJS\\n\\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\\n\\n1. **Run clj-kondo first**:\\n   ```sh\\n   clj -M:kondo --lint path/to/file.cljs\\n   ```\\n\\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\\n\\n3. **Fix one bracket at a time, re-run checker after each fix**:\\n   Common patterns:\\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\\n   - Both can coexist while total bracket count is zero-sum.\\n\\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\\n# Code Review PR Checklist & Taxonomy\\n\\nWhen performing code reviews, evaluate changes using this structured checklist and severity taxonomy.\\n\\n---\\n\\n## 1. Finding Severity Taxonomy\\n\\n| Severity | Label | Definition | Examples |\\n| :--- | :--- | :--- | :--- |\\n| **P0** | **Critical (Blocker)** | Security vulnerabilities, data loss risks, production crashes, secret leakage. Must be fixed before merging. | Hardcoded tokens, unhandled NullPointer on critical path, SQL injection, broken auth check. |\\n| **P1** | **High (Must Address)** | Logic bugs, breaking API changes, missing error handling on external calls, race conditions, lack of tests for complex logic. | Swallowed exceptions, broken retry loop, missing backward compatibility in API schema. |\\n| **P2** | **Medium (Recommended)** | Performance inefficiencies, code duplication, sub-optimal data structures, non-idiomatic style. | Unnecessary DB query inside loop, missing index, missing parameter validation. |\\n| **P3** | **Low (Nit / Suggestion)** | Minor formatting, naming improvements, leftover comments/TODOs, minor doc polish. | Variable naming clarity, typos in docstrings, cleaning leftover TODO comments. |\\n\\n---\\n\\n## 2. Comprehensive Review Checklist\\n\\n### A. Logic & Correctness\\n- [ ] **Edge Cases**: Does the code handle null/nil/undefined, empty collections, zero values, boundary numbers, and unexpected inputs?\\n- [ ] **State & Concurrency**: Are shared state mutations thread-safe? Are locks acquired/released properly without deadlock risks?\\n- [ ] **Control Flow**: Are all conditional branches covered? Do loops have guaranteed termination conditions?\\n- [ ] **Error Propagation**: Are errors caught and logged/surfaced appropriately, rather than swallowed silently (`catch (Exception e) {}`)?\\n\\n### B. Security & Credentials\\n- [ ] **No Hardcoded Secrets**: Are API keys, passwords, bearer tokens, or private keys excluded from code and config?\\n- [ ] **Input Validation & Sanitization**: Are external inputs validated before processing or passing to system shells, DB queries, or HTML rendering?\\n- [ ] **Authentication & Authorization**: Do endpoints verify user identity and check permissions before executing state changes?\\n- [ ] **Safe Dependencies**: Are newly added packages pinned to trusted versions without known vulnerabilities?\\n\\n### C. Architecture & API Design\\n- [ ] **Preserve API Contracts**: Are public method signatures, REST endpoints, and schema definitions backward compatible?\\n- [ ] **Single Responsibility**: Are modules, classes, and functions focused on a clear, single responsibility?\\n- [ ] **Coupling & Cohesion**: Is the new code properly modularized without introducing circular dependencies or leaky abstractions?\\n- [ ] **Idempotence**: Are retry loops or state-changing operations safe to re-execute on transient failures?\\n\\n### D. Performance & Resource Efficiency\\n- [ ] **N+1 Queries**: Are database or remote API calls executed in batches rather than inside loops?\\n- [ ] **Resource Cleanup**: Are file handles, database connections, streams, and web sockets closed explicitly (or managed via try-with-resources / context managers)?\\n- [ ] **Memory & Allocation**: Are large datasets streamed or paginated rather than loaded fully into memory at once?\\n\\n### E. Test Coverage & Quality\\n- [ ] **Test Coverage**: Do new features or bug fixes include corresponding unit or integration tests?\\n- [ ] **Test Quality**: Do tests verify actual assertions rather than just checking that code runs without throwing?\\n- [ ] **Edge Case Tests**: Are failure modes, invalid inputs, and error handlers covered by unit tests?\\n\\n---\\n\\n## 3. Review Feedback Guidelines\\n\\n1. **Be Specific**: Always reference the exact file line number, function name, and context.\\n2. **Explain the \\\"Why\\\"**: Don't just say \\\"change this\\\". Explain the risk or benefit (e.g., \\\"This could lead to a race condition if two threads call `transact!` simultaneously...\\\").\\n3. **Provide Concrete Fixes**: Offer concrete, copy-pasteable diff snippets where appropriate.\\n4. **Acknowledge Good Work**: Highlight well-crafted solutions, thorough tests, or clean refactorings.\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nPR Reviewer Utility Script for Git-based Code Reviews.\\nParses git diffs, analyzes churn and file risk categories, scans for security smells\\nand debugging code, and produces structured markdown or JSON review reports.\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport json\\nimport os\\nimport re\\nimport subprocess\\nimport sys\\nfrom dataclasses import asdict, dataclass, field\\nfrom pathlib import Path\\nfrom typing import Dict, List, Optional, Tuple\\n\\n\\n@dataclass\\nclass Finding:\\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\\n    file_path: str\\n    line_number: Optional[int]\\n    message: str\\n    snippet: str\\n\\n\\n@dataclass\\nclass FileStat:\\n    path: str\\n    additions: int\\n    deletions: int\\n    category: str\\n    risk_level: str  # High, Medium, Low\\n\\n\\n@dataclass\\nclass ReviewSummary:\\n    target: str\\n    total_files: int\\n    total_additions: int\\n    total_deletions: int\\n    test_additions: int\\n    source_additions: int\\n    test_to_source_ratio: float\\n    file_stats: List[FileStat] = field(default_factory=list)\\n    findings: List[Finding] = field(default_factory=list)\\n    commits: List[str] = field(default_factory=list)\\n\\n\\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\\n    \\\"\\\"\\\"Helper to run git commands cleanly.\\\"\\\"\\\"\\n    cmd = [\\\"git\\\"] + args\\n    try:\\n        res = subprocess.run(\\n            cmd,\\n            cwd=cwd,\\n            stdout=subprocess.PIPE,\\n            stderr=subprocess.PIPE,\\n            text=True,\\n            check=True,\\n        )\\n        return res.stdout.strip()\\n    except subprocess.CalledProcessError as e:\\n        sys.stderr.write(f\\\"Git command failed: {' '.join(cmd)}\\\\nError: {e.stderr}\\\\n\\\")\\n        raise RuntimeError(f\\\"Git execution failed: {e.stderr.strip()}\\\")\\n\\n\\ndef categorize_file(file_path: str) -> Tuple[str, str]:\\n    \\\"\\\"\\\"Categorizes file type and assigns risk level.\\\"\\\"\\\"\\n    path_lower = file_path.lower()\\n\\n    # Security & Auth\\n    if any(k in path_lower for k in [\\\"auth\\\", \\\"secret\\\", \\\"crypto\\\", \\\"token\\\", \\\"permission\\\", \\\"jwt\\\", \\\"oauth\\\", \\\"password\\\"]):\\n        return \\\"Security/Auth\\\", \\\"High\\\"\\n\\n    # Database & Schema\\n    if any(k in path_lower for k in [\\\"migration\\\", \\\"schema\\\", \\\".sql\\\", \\\"entity\\\", \\\"db/\\\"]):\\n        return \\\"Database/Schema\\\", \\\"High\\\"\\n\\n    # Infrastructure & Config\\n    if any(k in path_lower for k in [\\\"docker\\\", \\\"terraform\\\", \\\".tf\\\", \\\".env\\\", \\\"k8s\\\", \\\"helm\\\", \\\"ci/cd\\\", \\\".github/workflows\\\"]):\\n        return \\\"Infra/Config\\\", \\\"High\\\"\\n    if any(file_path.endswith(ext) for ext in [\\\"package.json\\\", \\\"deps.edn\\\", \\\"Cargo.toml\\\", \\\"go.mod\\\", \\\"requirements.txt\\\", \\\"pom.xml\\\", \\\"build.gradle\\\"]):\\n        return \\\"Dependencies\\\", \\\"Medium\\\"\\n\\n    # API / Interfaces\\n    if any(k in path_lower for k in [\\\"proto\\\", \\\"openapi\\\", \\\"swagger\\\", \\\"graphql\\\", \\\"router\\\", \\\"controller\\\", \\\"api/\\\"]):\\n        return \\\"API/Contract\\\", \\\"Medium\\\"\\n\\n    # Tests\\n    if any(k in path_lower for k in [\\\"test\\\", \\\"spec\\\", \\\"mock\\\", \\\"fixture\\\", \\\"e2e\\\"]):\\n        return \\\"Tests\\\", \\\"Low\\\"\\n\\n    # Documentation\\n    if any(file_path.endswith(ext) for ext in [\\\".md\\\", \\\".rst\\\", \\\".txt\\\", \\\"LICENSE\\\"]):\\n        return \\\"Documentation\\\", \\\"Low\\\"\\n\\n    # Core source\\n    return \\\"Source Code\\\", \\\"Medium\\\"\\n\\n\\ndef scan_diff_content(diff_text: str) -> List[Finding]:\\n    \\\"\\\"\\\"Scans diff text for added code smells and risks.\\\"\\\"\\\"\\n    findings: List[Finding] = []\\n\\n    # Patterns to match added lines\\n    patterns = [\\n        # Secret leaks\\n        (\\n            r\\\"(?i)^\\\\+.*(api[_\\\\-]?key|secret[_\\\\-]?key|bearer\\\\s+[a-z0-9_\\\\-\\\\.]{20,}|private[_\\\\-]?key)\\\\s*[:=]\\\\s*['\\\\\\\"][A-Za-z0-9%+\\\\/=\\\\-_]{8,}['\\\\\\\"]\\\",\\n            \\\"P0\\\",\\n            \\\"Security\\\",\\n            \\\"Possible hardcoded credential or secret detected.\\\",\\n        ),\\n        (\\n            r\\\"^\\\\+.*-----BEGIN (RSA|OPENSSH|EC|PRIVATE) KEY-----\\\",\\n            \\\"P0\\\",\\n            \\\"Security\\\",\\n            \\\"Embedded private key detected.\\\",\\n        ),\\n        # Debug code left behind\\n        (\\n            r\\\"^\\\\+.*\\\\b(console\\\\.log|print\\\\(|debugger;|binding\\\\.pry|import pdb; pdb\\\\.set_trace|println!|fmt\\\\.Println)\\\\b\\\",\\n            \\\"P3\\\",\\n            \\\"Debug\\\",\\n            \\\"Leftover debug statement detected.\\\",\\n        ),\\n        # Dangerous functions\\n        (\\n            r\\\"^\\\\+.*\\\\b(eval\\\\(|exec\\\\(|os\\\\.system\\\\(|subprocess\\\\.Popen\\\\(.*shell\\\\s*=\\\\s*True|dangerouslySetInnerHTML)\\\\b\\\",\\n            \\\"P1\\\",\\n            \\\"Security\\\",\\n            \\\"Potentially unsafe dynamic execution or shell invocation.\\\",\\n        ),\\n        # Swallowed exceptions\\n        (\\n            r\\\"^\\\\+.*\\\\b(catch\\\\s*\\\\([^\\\\)]*\\\\)\\\\s*\\\\{\\\\s*\\\\}|except:\\\\s*pass|rescue\\\\s*=>\\\\s*nil)\\\\b\\\",\\n            \\\"P2\\\",\\n            \\\"ErrorHandling\\\",\\n            \\\"Swallowed exception without logging or handling.\\\",\\n        ),\\n        # Potential SQL Injection\\n        (\\n            r\\\"(?i)^\\\\+.*((select|insert|update|delete)\\\\s+.*%s|(select|insert|update|delete)\\\\s+.*\\\\$[a-z0-9_]+|(select|insert|update|delete)\\\\s+.*\\\\+\\\\s*[a-z0-9_]+)\\\",\\n            \\\"P1\\\",\\n            \\\"Security\\\",\\n            \\\"Potential SQL string concatenation detected. Use parameterized queries.\\\",\\n        ),\\n        # TODO / FIXME additions\\n        (\\n            r\\\"(?i)^\\\\+.*\\\\b(TODO|FIXME|HACK|XXX)\\\\b\\\",\\n            \\\"P3\\\",\\n            \\\"Quality\\\",\\n            \\\"Added TODO/FIXME annotation. Verify if it should be resolved before merging.\\\",\\n        ),\\n        # Hardcoded Localhost / IPs\\n        (\\n            r\\\"^\\\\+.*(http://localhost|http://127\\\\.0\\\\.0\\\\.1|127\\\\.0\\\\.0\\\\.1:[0-9]+)\\\",\\n            \\\"P2\\\",\\n            \\\"Config\\\",\\n            \\\"Hardcoded localhost or loopback address found in diff.\\\",\\n        ),\\n    ]\\n\\n    current_file = \\\"\\\"\\n    line_num = 0\\n\\n    for line in diff_text.splitlines():\\n        if line.startswith(\\\"--- a/\\\"):\\n            continue\\n        if line.startswith(\\\"+++ b/\\\"):\\n            current_file = line[6:]\\n            continue\\n        if line.startswith(\\\"@@ \\\"):\\n            # Extract starting line number for b/ side\\n            match = re.search(r\\\"\\\\+([0-9]+)\\\", line)\\n            if match:\\n                line_num = int(match.group(1)) - 1\\n            continue\\n\\n        if line.startswith(\\\"+\\\") and not line.startswith(\\\"+++\\\"):\\n            line_num += 1\\n            for regex, severity, category, message in patterns:\\n                if re.search(regex, line):\\n                    findings.append(\\n                        Finding(\\n                            severity=severity,\\n                            category=category,\\n                            file_path=current_file,\\n                            line_number=line_num,\\n                            message=message,\\n                            snippet=line[1:].strip(),\\n                        )\\n                    )\\n        elif not line.startswith(\\\"-\\\"):\\n            line_num += 1\\n\\n    return findings\\n\\n\\ndef analyze_git_target(target: str, repo_dir: Optional[str] = None) -> ReviewSummary:\\n    \\\"\\\"\\\"Analyzes git target (e.g. main...HEAD, HEAD~1, staged, working).\\\"\\\"\\\"\\n    git_args = []\\n    log_args = []\\n\\n    if target == \\\"staged\\\":\\n        git_args = [\\\"diff\\\", \\\"--cached\\\"]\\n        log_args = [\\\"log\\\", \\\"-n\\\", \\\"5\\\", \\\"--oneline\\\"]\\n    elif target == \\\"working\\\":\\n        git_args = [\\\"diff\\\", \\\"HEAD\\\"]\\n        log_args = [\\\"log\\\", \\\"-n\\\", \\\"5\\\", \\\"--oneline\\\"]\\n    else:\\n        git_args = [\\\"diff\\\", target]\\n        if \\\"...\\\" in target:\\n            base, head = target.split(\\\"...\\\")\\n            log_args = [\\\"log\\\", \\\"--oneline\\\", f\\\"{base}..{head}\\\"]\\n        elif \\\"..\\\" in target:\\n            log_args = [\\\"log\\\", \\\"--oneline\\\", target]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/orch-lane/1795060000000-architect-p8-final-confirm3.gpt-6.1-sol.stdout.log:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'bug44069|bug40809|bug63055|json_encode\\\\\\\\(\\\\\\\\[1\\\\\\\\]|1e\\\\\\\\+2|depth.boundary|oracle.record' docs test src collab/orch-lane/1794990000000* collab/orch-lane/1795020000000* deps.edn\\\"\",\"aggregated_output\":\"collab/orch-lane/1795020000000-engineer-p8-fixes2.muse-spark-1.3-contributor.stdout.log:9:- Provenance: the five `06cd429f`/`2026-11-04` records were impossible (tree committed Nov 6). The results came from the Nov-4 oracle pass whose exact tree was never recorded, so `:tree` is now `\\\"unrecorded\\\"` — no hash invented — keeping date, host, and log. `bug40809` unchanged.\\ncollab/orch-lane/1795020000000-engineer-p8-fixes2.muse-spark-1.3-contributor.stdout.log:11:- Scanner: new `php/json-dot-bad?` rejects `.1` and `1.` while `1e+2` stays valid; PHP juggling untouched. New `NULL` pins added.\\ncollab/orch-lane/1795020000000-engineer-p8-fixes2.muse-spark-1.3-contributor.stdout.log:17:1. Provenance dates — `test/yang/php/antlr/phpt_quick_mismatch_manifest.edn`. Five records (`gc_013`, `gc_023`, `bug39438`, `bug64660`, `gc_012`) cited `{:tree \\\"06cd429f\\\" :date \\\"2026-11-04\\\"}`, but `06cd429f` committed 2026-11-06, so the pair is impossible. The results came from the Nov-4 oracle pass (manifest regenerated in `2e5f7f2f` on 2026-11-04) whose exact shiva checkout hash was never recorded, so per the brief no hash was invented: all five now carry `:tree \\\"unrecorded\\\"`, keeping the supported date, host, and log. `bug40809` keeps its correct `dbe9e072`/2026-11-05 remeasure record. Re-validated: 6 gaps, 6 measured via `clojure.edn`. No code reads `:measured-at`.\\ncollab/orch-lane/1795020000000-engineer-p8-fixes2.muse-spark-1.3-contributor.stdout.log:18:2. JSON depth off-by-one — `src/cljc/yang/php/antlr/prelude_p9.cljc`, `php/json-encode`: guard changed from `(>= (+ depth 1) maxdepth)` to `(> (+ depth 1) maxdepth)`, so `json_encode([1],0,1)` → `\\\"[1]\\\"` while `json_encode([[1]],0,1)` → `false`. Test pin corrected to `string(3) \\\"[1]\\\"` (diag still `[]`), plus a new `[[1]]` → `false` pin.\\ncollab/orch-lane/1795020000000-engineer-p8-fixes2.muse-spark-1.3-contributor.stdout.log:19:3. JSON number scanner — added `php/json-dot-bad-at` / `php/json-dot-bad?`: any `.` in the token without a digit on both sides is a syntax error, so `.1` and `1.` decode to `NULL` while `1e+2` stays valid. PHP juggling (`php/num-prefix`) untouched; `1e+` truncation and leading-plus/leading-zero rejection unchanged. New `NULL` pins added.\\ncollab/orch-lane/1794990000000-architect-p8-final-confirm2.gpt-6.1-sol.stdout.log:12:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"cat docs/agents/build-n-test.md && rg -n 'measured-at|slow-gap|SORT_STRING|PREFIX_ONLY_IF|landing-review|6/202|json_encode' docs/design/yang.php* test/yang/php/antlr/builtin_surfaces_test.clj collab/orch-lane deps.edn\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"---\\\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\\\n---\\\\n\\\\n# BUILD & TEST\\\\n\\\\n## Commands\\\\n\\\\n```sh\\\\n# Tests (Babashka runner)\\\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\\\nbb test:slow         # Only the slow tests, on every lane\\\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\\\n# (dao.test-slow/guard \\\\\\\"name\\\\\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\\\n# under test/), so the non-slow tests inside those namespaces also run there.\\\\n# On Node, shadow also runs the test namespaces those nine require (about\\\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\\\n# not subsystems). On the many-core remote hosts see \\\\\\\"Remote test servers\\\\\\\" below for\\\\n# which lanes may overlap.\\\\n#\\\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\\\n# (or `clojure -M:test -i :slow -n <ns>`).\\\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\\\n# When a test fails, reproduce and fix it by running ONLY the failing test\\\\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\\\\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\\\\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\\\\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\\\\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\\\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\\\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\\\\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01.\\\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\\\n# overlap lanes, see \\\\\\\"Remote test servers\\\\\\\" below).\\\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\\\nnpm test             # Node.js tests\\\\n\\\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\\\n                         # and the linker L5 Node reader that requires a module\\\\n                         # by name): `clojure -M:test` without it fails that test\\\\n```\\\\n\\\\n### Changed-only tests: `bb test:changed`\\\\n\\\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\\\nreach: the reverse require closure of the files changed since the\\\\nmerge-base with master, plus fixtures that mention a changed resource path,\\\\ntests that walk a changed tree, and each src file's `_test` by convention.\\\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\\\n(let-bound roots count), and a change under a root selects it. The three\\\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\\\nas for a change to the core everything requires (yin.vm engine,\\\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\\\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\\\\nand spawned programs that changed (target/yin-repl.js, Dart peers).\\\\n\\\\n### Sharded quick JVM feedback and change routing\\\\n\\\\n```sh\\\\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\\\\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\\\\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\\\\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\\\\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\\\\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\\\\nbb test:routed                                 # Git change set, same base as test:changed\\\\nbb deps:npm                                    # Content-checked local npm ci\\\\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\\\\n```\\\\n\\\\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\\\\nthe JVM portion of G3. Without selection flags it selects every JVM test;\\\\n`--changed FILE...` or `--base REF` uses `affected/select` and\\\\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\\\\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\\\\nsemantics. `--workers N` must be positive (default 4 on the laptop).\\\\n\\\\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\\\\n`affected/select-subsystems` and the same longest-prefix ownership rule as\\\\n`test:sub`. As in the shiva script below, currently unowned namespaces run\\\\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\\\\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\\\\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\\\\nPrerequisites are derived from the entire selected JVM reach and finish\\\\nserially before workers start; the Node REPL build prerequisite\\\\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\\\\n\\\\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\\\\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\\\\nand `summary.edn`. Before execution it checks **set equality** between selected\\\\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\\\\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\\\\nThe final summary totals tests, assertions, failures and errors and separates\\\\nJVM wall time from total time including selection/builds. A nonzero child exit,\\\\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\\\\nDry plans write namespace evidence but execute no builds or tests. An empty\\\\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\\\\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\\\\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\\\\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\\\\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\\\\n\\\\n`test:routed <changed-files...>` applies this priority table to the whole change\\\\nset, prints the exact dispatch, executes it and propagates its result:\\\\n\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Change class (first match wins)                                                              | Dispatch                                                              |\\\\n+==============================================================================================+=======================================================================+\\\\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\\\\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\\\\n|                                                                                              | lint only                                                             |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\\\\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\\\\n|                                                                                              | selection                                                             |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n\\\\nMixed changes take the widest matching route. Missing paths, an empty git change\\\\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\\\\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\\\\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\\\\nits zero exit is **not** a verification result. Documentation checks inspect\\\\nstaged and unstaged changes together against HEAD. Paths absent from\\\\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\\\\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\\\\nexecutable examples or validate documentation links.\\\\n\\\\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\\\\nmeans the dispatched gate completed successfully, not that every landing gate\\\\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\\\\nand failed dispatches. Successful checked docs, selected tri-host, and full\\\\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\\\\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\\\\nresults, so automation must inspect the scope as well as the exit code.\\\\n\\\\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\\\\ntri-host success: for foundation/compiler changes also run\\\\n`bb test:changed:cljs --changed <paths>` and\\\\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\\\\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\\\\ndemo smoke checks and review/landing gates all remain required. Node and Dart\\\\nlanes retain their current commands. The original unsharded tasks remain\\\\navailable. **Individual tests may run on the laptop; suite-scale runs may\\\\nnot (owner ruling 2026-11-04).** A single failing test or one namespace\\\\nreproduces quickly and is fine locally. Everything suite-scale — subsystem\\\\nlane sets (G1), changed-set runs (G2), the full quick suite, the slow tier,\\\\n`bb test:all`, and `nightly.clj` — runs on the remote hosts: the suite has\\\\noutgrown the laptop. The slow tier is 52 long namespaces whose JVM\\\\nprocesses each multi-thread (test workers, JIT, GC threads sized by core\\\\ncount); four of them GC-thrashing at once drove a laptop load average over\\\\n100 on 2026-11-01 while making no progress (the remote hosts run this tier:\\\\njupiter 5,645 s at 12 workers, shiva comparable). Do not run another lane\\\\nset concurrently on the laptop either.\\\\n\\\\n#### Worktree-local prerequisite caches\\\\n\\\\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\\\\nrecorded helper/generated digests and runtime pins), the generator/cache source,\\\\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\\\\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\\\\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\\\\nremoved or corrupted outputs trigger a full generation, retaining the generator's\\\\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\\\\ninvalidate the complete-build stamp.\\\\n\\\\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\\\\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\\\\nenvironment and worktree identity; it verifies the installed file tree before\\\\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\\\\nensure this dependency too. Direct `npm ci` is still available.\\\\n\\\\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\\\\nlock only after confirming its owning process died. Symlinked output parents\\\\nthat escape the worktree are refused. This is reuse **within one worktree**,\\\\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\\\\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\\\\nstill require the existing worktree isolation/serialization rules; the cache\\\\ndoes not make overlapping builds and tests safe. Peer executables and shadow\\\\nbuilds themselves are not cached by this mechanism.\\\\n\\\\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\\\\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\\\\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\\\\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\\\\nouter command **258.27 s**). The original `test:changed:clj` command completed\\\\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\\\\nrounds to whole seconds). The investigation's earlier unsharded command had\\\\ntimed out at 300 s without a summary. These are single-run observations, not\\\\na median/p95 claim or a replacement for tri-host landing verification.\\\\n\\\\n### Subsystem-first tests: `bb test:sub`\\\\n\\\\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\\\\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\\\\nis by longest namespace prefix matching.\\\\n\\\\n```sh\\\\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\\\\nbb test:sub:clj <subsystem>...    # JVM lane alone\\\\nbb test:sub:cljs <subsystem>...   # Node lane alone\\\\nbb test:sub:cljd <subsystem>...   # Dart lane alone\\\\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\\\\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\\\\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\\\\n```\\\\n\\\\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\\\\n\\\\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\\\\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\\\\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\\\\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\\\\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\\\\n- **Infrastructure**: `dev`, `bench`\\\\n\\\\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:antlr`)\\\\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\\\\nselected namespaces and run automatically when needed.\\\\n\\\\n#### Gate Ladder (docs/design/test.subsystems.md)\\\\n\\\\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\\\\n   **Failure-reproduction rule (owner ruling 2026-11-01): when a test fails anywhere — a\\\\n   gate, the nightly, or a delegate report — reproduce and fix it by running ONLY the\\\\n   failing test, never the whole suite.** JVM: `clojure -M:test -n <ns>` (a single\\\\n   deftest: add `-v <ns>/<var-name>`). Node: `node target/node-tests.js --test=<ns>`\\\\n   (built by `bb build:yin-repl-node` first only if that test needs the Node REPL).\\\\n   Dart: `bb src/dev/cljd_agg.clj --only <ns>`. Fix against the failing test alone,\\\\n   re-run it green, then climb back up (G1 for the home subsystem, G2 for dependents).\\\\n   Never reproduce or chase a failure with the full suite or the slow tier — the full\\\\n   suite is not a debugging tool, and running it locally for one failing test is the\\\\n   exact misuse that drove a laptop load average over 100 (2026-11-01). A failure that\\\\n   only reproduces under the full suite's concurrency is diagnosed with the suite's own\\\\n   logs (its per-shard/per-test output), not by re-running the suite repeatedly.\\\\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\\\\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\\\\n4. **G3 Master (merged in place by the 2026-11-01 owner ruling)**: The landing gate\\\\n   for a change is the **tests that cover the feature being built** — `bb test:changed`\\\\n   (G2) already includes the reverse-require closure of the changed files, and a wide\\\\n   change still routes to the full quick lane. The complete suite is no longer a\\\\n   per-merge gate: it runs twice a day on the remote hosts (see \\\\\\\"Cadence\\\\\\\" below), so a\\\\n   break is caught within hours without charging every merge ~400 minutes of slow tier.\\\\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge\\\\n   (`bb test:slow` or `bb test:all`), at each phase boundary of a multi-phase track\\\\n   (owner decision 2026-10-12), and implicitly twice daily by the scheduled run below.\\\\n   G0 to G3 run the quick tier; G4 runs the slow tier.\\\\n\\\\n\\\\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\\\\nslice L5) is two tests:\\\\n\\\\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\\\\n  processes over real loopback UDP. A JVM publisher with a key file\\\\n  publishes modules by name, and JVM and Node readers require them by\\\\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\\\\n  and checks each section 9 failure as data. Ports are ephemeral, and\\\\n  every wait is bounded. A run takes a few minutes. Run it alone with\\\\n  `clojure -M:test -n yin.repl.dht-process-test`, after\\\\n  `bb build:yin-repl-node`.\\\\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\\\\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\\\\n  signed-name leg runs here, because no Dart `yin.repl.main` process\\\\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\\\\n  REPL.\\\\n\\\\n```sh\\\\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\\\\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\\\\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\\\\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\\\\n\\\\n# ClojureDart\\\\nclj -M:clojuredart:cljd compile\\\\n\\\\n# Linting\\\\nclj -M:kondo --lint <path>\\\\n```\\\\n\\\\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\\\\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\\\\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\\\\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\\\\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\\\\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\\\\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\\\\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\\\\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\\\\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\\\\n(greedy by file size; each imports its files and calls their `main`), runs\\\\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\\\\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\\\\ndifferent namespaces share an isolate per shard. Failures stay attributable:\\\\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\\\\n\\\\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\\\\ncompile does not prune it when a source file is deleted or renamed. The\\\\naggregated lanes only run namespaces that still exist under `test/`, but a\\\\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\\\\nbefore relying on that to prove a deletion or rename took effect.\\\\n\\\\n## Test tiers: quick and slow\\\\n\\\\nThe suite has two tiers so that slow tests run less often than quick ones\\\\n(owner decision, 2026-10-12).\\\\n\\\\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\\\\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\\\\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\\\\n- **Slow tier:** the tagged deftests. `bb test:slow` or\\\\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\\\\n- **The tagging rule** is the one above (\\\\\\\"When to tag a test slow\\\\\\\"): a deftest that\\\\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\\\\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\\\\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\\\\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\\\\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\\\\n  in all (some were already tagged). Per-test times are not in the repo: measure again\\\\n  with the method below before changing the cut.\\\\n- **Cadence (owner ruling 2026-11-05):** a merge needs only the tests that cover the\\\\n  feature being built — the affected/dependent set from `bb test:changed` (or\\\\n  `bb test:sub <own> --slow` when the change touches slow-tagged code). The FULL suite,\\\\n  including the slow tier, runs **once a day at 04:00 Asia/Ho_Chi_Minh** as a\\\\n  disjoint lane pair (`src/dev/nightly.clj`): **jupiter takes the jvm lane, shiva\\\\n  takes node and dart** (each lane in its own clone; shiva publishes the run pin,\\\\n  jupiter reads it and falls back to its own current master as an advisory run).\\\\n  The measured long set is ~400 minutes of serial slow-tier work, so it cannot be\\\\n  a per-merge cost; a break is instead caught by the next scheduled run.\\\\n  The schedule is an **hourly cron plus a Vietnam-time guard** in\\\\n  `~/ci/nightly-cron.sh` on each host (the guard fires only at the 04 VN hour and\\\\n  `flock` skips a slot whose previous run is still active), so it is immune to the\\\\n  DST shifts of either host's local timezone. **The cron entries are currently\\\\n  REMOVED (owner instruction 2026-11-06)**: the wrappers remain installed on both\\\\n  hosts and re-arming is one crontab line each\\\\n  (`0 * * * * ~/ci/nightly-cron.sh >> ~/ci/nightly-cron.log 2>&1`). Logs:\\\\n  `~/ci/nightly-cron.log`; results: `~/ci/nightly-results/<stamp>/summary.txt`.\\\\n\\\\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \\\\\\\"Remote test\\\\nservers\\\\\\\" for how to run them):\\\\n\\\\n| Run | Time |\\\\n|---|---|\\\\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\\\\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\\\\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\\\\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\\\\n\\\\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\\\\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\\\\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\\\\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\\\\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\\\\n\\\\n**How the per-test times were measured.** To time every deftest of a namespace alone,\\\\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\\\\notherwise swallows `-e`, and every JVM runs the whole suite):\\\\n\\\\n```sh\\\\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\\\\\\\"test\\\\\\\"]}}}' -M:t timing.clj\\\\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\\\\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\\\\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\\\\n# load) is paid by the first test in file order; check before tagging that test alone.\\\\n```\\\\n\\\\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\\\\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\\\\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\\\\nJVM test namespace under `test/`:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nPAR=\\\\\\\"${2:-8}\\\\\\\"\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nOUT=\\\\\\\"$1/target-ci/shards\\\\\\\"; rm -rf \\\\\\\"$OUT\\\\\\\"; mkdir -p \\\\\\\"$OUT\\\\\\\"\\\\nts() { date +%H:%M:%S; }\\\\necho \\\\\\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\\\\\" | tee \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nnpm ci --silent >\\\\\\\"$OUT/npm.log\\\\\\\" 2>&1                   && echo \\\\\\\"npm ok $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nbb build:yin-repl-node >\\\\\\\"$OUT/build-node.log\\\\\\\" 2>&1     && echo \\\\\\\"node repl built $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nbb gen:antlr >\\\\\\\"$OUT/antlr.log\\\\\\\" 2>&1             && echo \\\\\\\"antlr ok $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nSUBS=\\\\\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\\\\\"\\\\n: > \\\\\\\"$OUT/covered.txt\\\\\\\"\\\\nfor s in $SUBS; do\\\\n  bb test:sub:list \\\\\\\"$s\\\\\\\" 2>/dev/null | awk \\\\\\\"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");print}\\\\\\\" > \\\\\\\"$OUT/ns-$s.txt\\\\\\\"\\\\n  cat \\\\\\\"$OUT/ns-$s.txt\\\\\\\" >> \\\\\\\"$OUT/covered.txt\\\\\\\"\\\\n  echo \\\\\\\"$s $(wc -l < \\\\\\\"$OUT/ns-$s.txt\\\\\\\")\\\\\\\" >> \\\\\\\"$OUT/plan.txt\\\\\\\"\\\\ndone\\\\n# coverage: every JVM test namespace under test/ vs the union of the shards\\\\nfind test -type f \\\\\\\\( -name \\\\\\\"*_test.clj\\\\\\\" -o -name \\\\\\\"*_test.cljc\\\\\\\" \\\\\\\\) | sed -e \\\\\\\"s#^test/##\\\\\\\" -e \\\\\\\"s#\\\\\\\\.cljc\\\\\\\\?\\\\\\\\$##\\\\\\\" -e \\\\\\\"s#/#.#g\\\\\\\" -e \\\\\\\"s#_#-#g\\\\\\\" | sort -u > \\\\\\\"$OUT/all.txt\\\\\\\"\\\\nsort -u \\\\\\\"$OUT/covered.txt\\\\\\\" > \\\\\\\"$OUT/covered.sorted\\\\\\\"\\\\ncomm -23 \\\\\\\"$OUT/all.txt\\\\\\\" \\\\\\\"$OUT/covered.sorted\\\\\\\" > \\\\\\\"$OUT/ns-uncovered.txt\\\\\\\"\\\\necho \\\\\\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nrun_shard() {\\\\n  s=$1; f=\\\\\\\"$OUT/ns-$s.txt\\\\\\\"; [ -s \\\\\\\"$f\\\\\\\" ] || return 0\\\\n  args=(); while read -r n; do args+=(-n \\\\\\\"$n\\\\\\\"); done < \\\\\\\"$f\\\\\\\"\\\\n  t0=$(date +%s); clojure -M:test -e :slow \\\\\\\"${args[@]}\\\\\\\" >\\\\\\\"$OUT/$s.log\\\\\\\" 2>&1; rc=$?\\\\n  echo \\\\\\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\\\\\"^Ran \\\\\\\" \\\\\\\"$OUT/$s.log\\\\\\\" | tail -1)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n}\\\\nexport -f run_shard; export OUT; export -f ts\\\\nprintf \\\\\\\"%s\\\\\\\\n\\\\\\\" $SUBS uncovered | xargs -P \\\\\\\"$PAR\\\\\\\" -I{} bash -c \\\\\\\"run_shard {}\\\\\\\"\\\\necho \\\\\\\"done $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nPAR=\\\\\\\"${2:-6}\\\\\\\"\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nOUT=\\\\\\\"$1/target-ci/slowtier\\\\\\\"; rm -rf \\\\\\\"$OUT\\\\\\\"; mkdir -p \\\\\\\"$OUT\\\\\\\"\\\\nrun_ns() {\\\\n  n=$1; t0=$(date +%s)\\\\n  clojure -M:test -i :slow -n \\\\\\\"$n\\\\\\\" > \\\\\\\"$OUT/$n.log\\\\\\\" 2>&1; rc=$?\\\\n  echo \\\\\\\"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \\\\\\\"^Ran \\\\\\\" \\\\\\\"$OUT/$n.log\\\\\\\" | tail -1)\\\\\\\" >> \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n}\\\\nexport -f run_ns; export OUT\\\\necho \\\\\\\"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\\\\\\\" > \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nxargs -P \\\\\\\"$PAR\\\\\\\" -I{} bash -c \\\\\\\"run_ns {}\\\\\\\" < \\\\\\\"$HOME/ci/pertest-ns.txt\\\\\\\"\\\\necho \\\\\\\"done $(date +%H:%M:%S)\\\\\\\" >> \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n## Remote test servers: shiva and jupiter\\\\n\\\\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\\\\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\\\\nand `git`.\\\\n\\\\n| Host | Cores / RAM | Toolchain state (server snapshot checked 2026-10-11; repo selection comes from `mise.toml`) |\\\\n|---|---|---|\\\\n| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\\\\n| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\\\\n\\\\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\\\\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\\\\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\\\\n\\\\n### Get the code there: push to origin, never rsync\\\\n\\\\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\\\\nwould take about an hour), and an unanchored `--exclude build` also dropped source\\\\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\\\\nbranch from the laptop (a feature branch, never master), make one scratch clone on\\\\nthe host from its existing checkout (a local clone takes seconds), and fetch:\\\\n\\\\n```sh\\\\n# once per host: a separate scratch clone, not the working copy\\\\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\\\\n  URL=$(git remote get-url origin);\\\\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\\\\n  cd ~/ci/datomworld-<name>; git remote set-url origin \\\\\\\"$URL\\\\\\\";\\\\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\\\\n```\\\\n\\\\nTo test another branch later, fetch and check it out in the scratch clone with\\\\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\\\\nwas never pushed cannot be tested remotely.\\\\n\\\\n### A clone is only current if it updated from real master\\\\n\\\\nA scratch clone's `origin/master` ref is only as fresh as the place it fetches\\\\nfrom — and a clone made from another scratch clone inherits that clone's *stale*\\\\nrefs. Measured on shiva 2026-11-02: the `dg` clone was created from the `p4`\\\\nscratch clone, whose local `master` ref had not moved since October 26 because\\\\nevery lane on it ran detached off fetched branches; the `dg` lane's\\\\n`checkout origin/master` therefore produced a commit 436 commits behind real\\\\nmaster, and the G3 Dart leg honestly reported failures (the datagram fix) for a\\\\ntree that did not contain them.\\\\n\\\\nBefore any lane runs in a clone — every time, not just the first:\\\\n\\\\n```sh\\\\ncd ~/ci/datomworld-<name>\\\\ngit remote get-url origin          # must be the GitHub URL, never another scratch clone\\\\ngit fetch -q origin \\\\\\\"+refs/heads/*:refs/remotes/origin/*\\\\\\\"\\\\ngit checkout -q --detach origin/master   # or the lane's branch\\\\ngit merge-base --is-ancestor <the-commit-hash-you-pushed> HEAD && echo CURRENT\\\\n```\\\\n\\\\nIf `origin` is not GitHub, repoint it (`git remote set-url origin \\\\\\\"$URL\\\\\\\"`). If\\\\nthe `merge-base` check fails, the clone's bookkeeping lies: refetch, or delete\\\\nand recreate the clone from GitHub directly. Never trust a hash the clone\\\\nreports without comparing it to the hash your push from the laptop printed.\\\\n\\\\n### Activate the toolchain in the right order\\\\n\\\\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\\\\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\\\\ninto the clone:\\\\n\\\\n```sh\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\\\\ncd ~/ci/datomworld-<name>\\\\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\\\\nmise install                                    # install versions selected by this checkout's mise.toml\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"                       # puts the repo-selected tools on PATH\\\\nmise current flutter                            # verify the selected Flutter version\\\\n```\\\\n\\\\nActivating mise before the `cd` and `mise trust` leaves the repo-selected tools\\\\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \\\\\\\"Can't\\\\nfind flutter on PATH\\\\\\\", and so does `bb build:yin-repl-peer`.\\\\n\\\\n### Which lanes may overlap (reconciling the one-lane-set rule)\\\\n\\\\n\\\\\\\"One lane set at a time\\\\\\\" and \\\\\\\"one Dart lane at a time\\\\\\\" are per-machine rules about\\\\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\\\\n`test.subsystems.md` section 5 item 6 says the same (\\\\\\\"on one machine where\\\\navoidable\\\\\\\"). The laptop additionally never runs the slow tier or the nightly\\\\ndriver (see the sharded-lane section) — a full slow tier there reached a load\\\\naverage over 100 on 2026-11-01; the remote hosts own that tier. On shiva (24 cores) and jupiter (48) the cores are not the limit, so\\\\nlanes may overlap, with these limits:\\\\n\\\\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\\\\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\\\\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\\\\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\\\\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\\\\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\\\\n  by the design's own reasoning (\\\\\\\"each worktree owns its own `cljd-out`\\\\\\\"), not yet\\\\n  verified by a measured run.\\\\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\\\\n  JVM lane only reads `target/yin-repl.js`.\\\\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\\\\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\\\\n- **Different branches in different clones** are independent, so two branches may\\\\n  run on one host if its cores and RAM allow (62 GB each).\\\\n- Do not treat this as permission to overlap lanes on the laptop.\\\\n\\\\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\\\\nthis rule was written down; its results are advisory until repeated with a\\\\nseparate Dart clone.\\\\n\\\\n**The nightly driver now enforces this by construction.** `src/dev/nightly.clj`\\\\n(2026-11-03, kimi-reviewed) runs a multi-lane invocation as one concurrent\\\\nfuture per lane, each in its OWN clone — jvm keeps the primary clone, node\\\\nand dart get `<primary>-node` / `<primary>-dart`. The pinned SHA is resolved\\\\nonce and checked out in every lane clone; a cache-warm pass\\\\n(`clojure -P -M:test:cljs:clojuredart:cljd`) runs in the primary before\\\\nfan-out so two clones never fetch into the shared `~/.m2`/`~/.gitlibs`\\\\nconcurrently; per-lane summaries are appended serially after the futures\\\\njoin. A single-lane invocation (jupiter's `jvm`) is unchanged: one clone,\\\\none serial lane. Both hosts run the same driver — the lane list on the\\\\ncommand line (shiva: `node,dart` + `--pin-publish`; jupiter: `jvm` +\\\\n`--pin-read --pin-peer shiva...`) is the only difference.\\\\n\\\\n### Scratch-clone first-run gaps (two measured sightings)\\\\n\\\\nA fresh scratch clone needs two things the lane runner does not yet set up\\\\nitself; until the runner heuristic is fixed, do them by hand before the\\\\nfirst lane:\\\\n\\\\n1. **`npm install`** — the Node tests require npm deps (`@noble/hashes` was\\\\n   the measured miss on shiva 2026-11-02: the cljs lane ran but the\\\\n   node-tests bundle died with `MODULE_NOT_FOUND`).\\\\n2. **`bb gen:antlr`** — the `prerequisites` heuristic in\\\\n   `src/dev/affected.clj` decides `:gen:antlr` from the JVM lane's reach\\\\n   only (\\\\\\\"ANTLR classes are JVM only\\\\\\\" — stale: python keeps multi-target\\\\n   parsers), so a cljs/cljd-only selection that reaches\\\\n   `yang.python.antlr.parser` (e.g. `bb test:sub:cljs yang.base` via\\\\n   `yin.repl.frontends`) skips the generation and the shadow build dies on\\\\n   the missing `Python3Lexer.js`. Sighted independently on the p4 lane\\\\n   (PhpLexer ClassNotFoundException) and the yang.base cljs lane\\\\n   (2026-11-02). The lane-runner fix landed 2026-11-03 (eb27fd47).\\\\n\\\\n### Merge verification: run the suite from a fresh clone, not the authoring worktree\\\\n\\\\nA merge whose new code reads a file that was never `git add`ed passes in\\\\nthe authoring worktree (the untracked file is still on disk there) and\\\\nbreaks everywhere else. Measured: the H3-0 landing (1fd7236b) merged\\\\n`kernel-declarations` — which reads\\\\n`yang/latte_oracle/slice9_declarations.edn` via `io/resource` at load —\\\\nwithout the file (untracked in the authoring worktree); master's\\\\nyang.latte-oracle-test died at load until the file was restored\\\\n(2026-11-04). Before landing any merge that adds code reading a new\\\\nresource, or after any merge at all when in doubt:\\\\n\\\\n```sh\\\\ngit worktree add /tmp/merge-verify <merge-commit>\\\\ncd /tmp/merge-verify && <the touched subsystem's focused test>\\\\ngit worktree remove /tmp/merge-verify\\\\n```\\\\n\\\\nA fresh clone/worktree has only committed files — a missing untracked\\\\nresource fails there immediately.\\\\n\\\\n### Ledger commit hygiene: never commit a conflict marker\\\\n\\\\nThe append-only ledgers (`docs/agents/known-gaps.md`,\\\\n`orchestrator-logs/*.md`, `docs/agents/routing-status.md`) resolve rebase\\\\nand merge conflicts by the union rule, which means conflicts are common —\\\\nand a conflict marker that reaches a commit silently corrupts the record\\\\n(measured: the 2026-10-30 rebase landed a log with three committed\\\\n`<<<<<<<`/`>>>>>>>` markers and dropped records the union was supposed to\\\\nkeep; caught by the architect four rounds later). Before committing ANY\\\\nchange to a ledger file:\\\\n\\\\n```sh\\\\ngit diff --cached | grep -E '^\\\\\\\\+(<{7}|={7}$|>{7})' && echo CONFLICT-MARKERS-STAGED\\\\ngit grep -E '^(<{7}|={7}$|>{7})' -- docs/agents/known-gaps.md orchestrator-logs docs/agents/routing-status.md\\\\n```\\\\n\\\\nIf either hits, the commit stops until the union is redone. When resolving\\\\na ledger conflict, prefer regenerating the union from both sides' section\\\\nlists over hand-merging, and re-read the result against BOTH parents before\\\\nstaging.\\\\n\\\\n### The jolt J2 lane: run it with `--jobs` on the servers\\\\n\\\\nThe jolt lane's core mode (`bb src/dev/jolt_j2_lane.clj core [--jobs N]\\\\n[--only re] [--timeout-ms M]`) runs each test namespace as its own child jolt\\\\nprocess (own Chez VM, own native parser library load, own log under\\\\n`build/j2-logs/core/`), so the namespaces cannot corrupt one another — the\\\\nonly thing `--jobs N` overlaps is the waiting. The default is `jobs 1`\\\\n(strictly serial), which on jupiter makes the full ~179-namespace lane a\\\\n5-6-hour run.\\\\n\\\\nOn the servers, run it with `--jobs 16`:\\\\n\\\\n- jolt children are essentially single-threaded (the 16 MiB parse thread\\\\n  only burns during parses) and cost 1-2 GB each, so 16 concurrent children\\\\n  sit far inside jupiter's 48 cores / 62 GB and shiva's 24 / 62;\\\\n- the lane's wall time is dominated by a few long namespaces\\\\n  (`yin.repl.python-antlr-test` has an explicit 3-hour step,\\\\n  `yin.vm.semantic.safepoint-harness-test` needs one — see\\\\n  `step-timeout-ms` in `src/dev/jolt_j2_lane.clj`), so beyond ~16 workers\\\\n  the critical path is the longest child, not the count;\\\\n- **parallel is unproven until checked once**: the recorded lane evidence\\\\n  (J2 closure, the safepoint 60/265,225/0 pass) was all produced `jobs 1`.\\\\n  The first parallel run must be compared per-namespace against a serial\\\\n  baseline; any namespace that flips red gets one serial re-run to\\\\n  attribute before its evidence is trusted. Until that first comparison\\\\n  passes, keep `jobs 1` for anything whose verdict is timing-sensitive —\\\\n  timeout and wall-time measurements, native-memory/leak gates, and the\\\\n  merge-decision qualification runs.\\\\n\\\\nSuites that exceed the lane's default step budget are pinned in the lane's\\\\n`step-timeout-ms` map with their measured wall time; a namespace timing out\\\\nunder the default budget is a reason to measure it serially and add an\\\\nentry, not to re-run under the same bound.\\\\n\\\\n### The full run\\\\n\\\\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\\\\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\\\\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\\\\ntasks use (the `bb test` task runs them one after another), and records each\\\\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\\\\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (both hosts run all three lanes; a second clone for Dart is recommended)\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\nDART=\\\\\\\"${2:-}\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nLOG=\\\\\\\"$1/target-ci\\\\\\\"; mkdir -p \\\\\\\"$LOG\\\\\\\"\\\\nts() { date +%H:%M:%S; }\\\\necho \\\\\\\"start $(ts) $(git rev-parse --short HEAD)\\\\\\\" | tee \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nnpm ci --silent >\\\\\\\"$LOG/npm.log\\\\\\\" 2>&1               && echo \\\\\\\"npm ok $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb build:yin-repl-node >\\\\\\\"$LOG/build-node.log\\\\\\\" 2>&1 && echo \\\\\\\"node repl built $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb gen:antlr >\\\\\\\"$LOG/antlr.log\\\\\\\" 2>&1         && echo \\\\\\\"antlr ok $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb build:yin-repl-peer >\\\\\\\"$LOG/build-peer.log\\\\\\\" 2>&1 && echo \\\\\\\"dart peer built $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nlane() { name=$1; shift; s=$(date +%s); \\\\\\\"$@\\\\\\\" >\\\\\\\"$LOG/$name.log\\\\\\\" 2>&1; rc=$?\\\\n         echo \\\\\\\"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"; }\\\\nlane jvm  clojure -M:test -e :slow &\\\\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\\\\nif [ -n \\\\\\\"$DART\\\\\\\" ]; then                            # its own clone (own lib/cljd-out, build/)\\\\n  ( cd \\\\\\\"$DART\\\\\\\" && mise trust >/dev/null 2>&1 && eval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\n    bb build:yin-repl-peer >\\\\\\\"$LOG/build-peer-dart.log\\\\\\\" 2>&1\\\\n    lane dart bb src/dev/cljd_agg.clj ) &\\\\nfi\\\\nwait\\\\necho \\\\\\\"done $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n```sh\\\\nssh <host> 'tmux new-session -d -s ci-full \\\\\\\"bash -lc \\\\\\\\\\\\\\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\\\\\\\\\\\\\"\\\\\\\"'\\\\n```\\\\n\\\\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\\\\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\\\\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\\\\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\\\\n`bb test:clj`. For the slow set use `-i :slow` (or `bb test:slow`); the slow C4\\\\nscanner row took about 11-19 minutes on the JVM and about 79 minutes on Node\\\\n(measured 2026-10-11).\\\\n\\\\n### Known differences from the laptop\\\\n\\\\n- **`dao.stream.datagram.dart-test/refusals-and-lifecycle-events` on Linux —\\\\n  MEASURED AND FIXED (2026-11-02).** The old entry inferred that \\\\\\\"a second UDP bind on\\\\n  a taken port behaves differently on Linux\\\\\\\"; confirmed, with the cause. Dart's\\\\n  `RawDatagramSocket.bind` defaults to `reuseAddress: true`, and **Linux honours\\\\n  `SO_REUSEADDR` for UDP**, so a second bind to a port a reuse-enabled socket already\\\\n  holds *succeeds* (`strace`: `SO_REUSEADDR=1` on both sockets, no `SO_REUSEPORT`, both\\\\n  kernel `bind()` calls succeed); macOS refuses with errno 48. The seam was correct\\\\n  throughout — given a genuinely exclusive holder (`reuseAddress: false`) it deposits\\\\n  `bind-failed` in ~10 ms with errno 98. The test asserted one host's binding policy\\\\n  rather than the contract, so it now binds its own exclusive blocker\\\\n  (`RawDatagramSocket.bind \\\\\\\"127.0.0.1\\\\\\\" 0 .reuseAddress false .reusePort false`) and\\\\n  points the seam at that port: the failure path is exercised on both hosts. Verified\\\\n  on shiva: the namespace passes 5/5.\\\\n- A JVM lane started before the Dart peer is built skips the Dart-peer tests with a\\\\n  printed notice. The script builds the peer first so they run.\\\\n- Both hosts run other work (a QEMU guest and rustdesk on shiva); idle load is\\\\n  under 1, but timings are not a clean benchmark.\\\\n\\\\n### The nightly full suite and the branch-testing rule (2026-10-30 owner ruling)\\\\n\\\\nOwner, verbatim: \\\\\\\"since the complete test can take a good 7-8hrs to run\\\\ncompletely, it should be schedule to run once a day at 3am. while\\\\nbranch/worktree test should only run test that are targeting code\\\\nchanges\\\\\\\" — and, clarifying the nightly's target: \\\\\\\"it should not be for\\\\nonly a worktree/branch. the nightly complete test should be for master.\\\\\\\"\\\\n\\\\nTwo tiers, by target and purpose:\\\\n\\\\n- **The nightly full suite runs MASTER ONLY** (`~/ci/nightly-cron.sh` on\\\\n  shiva and jupiter, hourly cron plus a 04:00 Vietnam guard and flock,\\\\n  documented under \\\\\\\"Cadence\\\\\\\" above; the driver fetches and checks out\\\\n  origin/master before anything runs). Every lane, across the host pair:\\\\n  the JVM full suite on jupiter, the full Node and Dart suites on shiva.\\\\n  Its results are a\\\\n  post-hoc integrity net for master, NOT a landing gate. Failures it\\\\n  finds route to fix rounds the next morning.\\\\n- **Branch/worktree testing runs only the namespaces that target the\\\\n  changed code** (the diff's own tests plus the surfaces the diff\\\\n  touches), one JVM per namespace, plus one cheap portable lane (Node)\\\\n  when cljc goldens or fixtures moved. Never the full tier on a branch:\\\\n  a branch gate needs the changed code proven, not the whole tree\\\\n  re-proven. A branch is never promoted by its own testing — the merge\\\\n  to master is what puts it under the nightly.\\\\n\\\\nAn orchestrator landing a slice cites the subset runs plus the gate\\\\nsign-off; the nightly catches what the subset could not see, and a red\\\\nnightly owns the follow-up.\\\\n\\\\n**The merge precondition (2026-10-30 owner ruling, restored 2026-10-31 —\\\\na dedup pass dropped this section along with a stale duplicate of the\\\\ntwo-tier policy; both stand):** before any merge into master, the\\\\n`dao.stream` tests must run and pass — dao.stream is what everything is\\\\nbuilt on. Concretely: `bb test:sub dao.stream` (the subsystem's tests,\\\\n`--slow` when the slice touches slow-guarded surfaces) is part of every\\\\nbranch gate regardless of which subsystems the diff's own changes\\\\nselect, because a change can break the foundation without touching it.\\\\nA red dao.stream blocks the merge until fixed or diagnosed as\\\\npre-existing by the owning seat.\\\\n\\\\n### Measured times (first runs, 2026-10-11, commit 84c7c9b7, all lanes concurrent)\\\\n\\\\nShiva, Dart lane: 1054 s (17.5 min) cold, with the JVM and Node lanes running beside\\\\nit, against about 9 minutes on the 8-core laptop run alone. Prerequisites (`npm ci`,\\\\nNode REPL, ANTLR) took about 30 s; the Dart peer 91 s. JVM and Node lane times are\\\\nnot recorded yet: fill them in from `summary.txt` after a completed run. Running the\\\\nlanes concurrently on one host did not make the Dart lane faster, so count on the\\\\nextra cores, and measure before relying on a speedup. (Historical record — the\\\\n\\\\\\\"free laptop\\\\\\\" comparison predates the 2026-11-04 ruling that suite-scale runs\\\\nbelong on the remote hosts.)\\\\n\\\\n### Jupiter verification run (2026-10-29, commit 7c0a078f, scratch clone, sequential lanes)\\\\n\\\\nFirst full tri-host verification of jupiter. Prerequisites (npm ci, Node REPL,\\\\nANTLR via `gen:antlr`, Dart peer) all succeeded; the stale 3.41.9 Flutter was\\\\nreplaced with 3.47.8 before the Dart lane. Results: **JVM quick tier\\\\n(`test:quick-sharded`, 12 workers) rc=0 in 702 s** (cold, every shard green);\\\\n**Node quick tier rc=0 in 4583 s** (all tests pass, but roughly 15x the\\\\nlaptop — route Node lanes to shiva; the laptop comparison is historical and\\\\nsuite-scale Node runs no longer belong there per the 2026-11-04 ruling);\\\\n**Dart quick tier\\\\nrc=1 in 1495 s with the ONLY failure the documented known Linux-only red**\\\\n(`dao.stream.datagram.dart-test/refusals-and-lifecycle-events`, same\\\\ntaken-port/bind-failed signature recorded above). Routing summary: jupiter\\\\nis the preferred JVM/sharding box (48 cores); Node stays off it when wall\\\\ntime matters; Dart works on either host. Timings are single cold runs, not\\\\nmedians, and two foreign QEMU guests idle on the host.\\\\n\\\\nOne exception to the concurrency above: never run two lanes that both trigger\\\\n`gen:antlr` (the quick `test:cljs`/`test:cljd` tasks) in the SAME worktree at the\\\\nsame time — they race on `build/antlr` and `lib/antlr` and fail with\\\\n\\\\\\\"Patch does not apply\\\\\\\" or \\\\\\\"Generated sources differ from the recorded digests\\\\\\\".\\\\nRun them sequentially, or in separate clones (as the slow-tier harness does).\\\\nThe fix after a collision is `rm -rf build/antlr lib/antlr` and a rerun; the\\\\ngenerator is not idempotent over an already-patched tree. Corroborated twice in\\\\none week (the M3 round and the C3 completion round, 2026-10-18).\\\\n\\\\n### Remote agent execution (delegate CLIs on shiva and jupiter)\\\\n\\\\nOwner relay, 2026-10-24: the delegate agent CLIs — `claude`, `codex`, `glm` —\\\\nare installed and usable **on the remote hosts themselves**, not only from the\\\\norchestrator's laptop. This generalizes this section from \\\\\\\"run tests remotely\\\\nover SSH\\\\\\\" to \\\\\\\"delegate whole work agents remotely\\\\\\\": a heavy implementation or\\\\nverification leg (test lanes, native builds, fault-injection runs, multi-hour\\\\nsuites) can be executed by a delegate agent running on the server, keeping the\\\\norchestrator's laptop unloaded.\\\\n\\\\nThe pattern (composed from the rules above plus the delegate-invocation\\\\nreference):\\\\n\\\\n1. **Land the branch on origin first** (push from the laptop; never rsync) and\\\\n   prepare the scratch clone per \\\\\\\"Get the code there\\\\\\\".\\\\n2. **Start a named tmux session** for the task; run the agent inside it with\\\\n   the toolchain activated *inside* the tmux command (`eval \\\\\\\"$(mise env -s\\\\n   bash)\\\\\\\"` after the `cd` — the non-interactive SSH shell does not have it).\\\\n   A fresh clone hits mise's interactive trust prompt, which blocks the whole\\\\n   session until answered via `tmux send-keys`; pre-empt it with `mise trust`\\\\n   inside the same command.\\\\n3. **The remote agent works in the clone**: implement, build, run lanes,\\\\n   write its findings artifact — the same brief form as any delegate dispatch\\\\n   (role template, bounded file ownership, deliverable path), just executing\\\\n   on the host. Long jobs survive SSH drops because of tmux.\\\\n4. **The orchestrator polls detached files, never the pane** (pane captures\\\\n   carry control characters that make output look empty): rc files, summary\\\\n   logs and `ls *.flag` sentinels written by the run.\\\\n5. **Division of labor**: bookkeeping and polling are orchestrator SSH\\\\n   one-liners; execution belongs to the remote agent. Do not run heavy lanes\\\\n   from the orchestrator's laptop while a remote agent owns the same gate.\\\\n6. **Same trust rules as any delegate**: remote execution does not waive\\\\n   Workflow steps 6–7 of the orchestrator role — artifacts are verified, and\\\\n   review before commit applies to remote-produced work identically.\\\\n   Session-ID capture and resume rules from the delegate-invocation reference\\\\n   apply per host (each host's `~/.claude`, `~/.codex` store is its own).\\\\n\\\\nKnown state: `claude` and `codex` verified working on shiva (2026-10-24, the\\\\njolt canonical-fixes verification ran there); `glm` reported available by the\\\\nowner on both hosts, not yet exercised. Both hosts are toolchain-verified for\\\\nthe full tri-host suite (jupiter verified 2026-10-29 — see Measured times;\\\\nits 3.41.9 Flutter was replaced with 3.47.8, and model availability per\\\\nhost is governed by `routing-status.md`, not this file).\\\\n\\\\n## Testing Philosophy & TDD\\\\n\\\\nWrite tests before implementing features (TDD).\\\\n\\\\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\\\\n\\\\nWhen implementing a feature or fix:\\\\n1. **Red phase**: Write the test first — define what should happen.\\\\n2. **Green phase**: Implement the minimum code to pass the test.\\\\n3. **Refactor phase**: Refactor if needed while keeping tests green.\\\\n\\\\nThis ensures code is testable by design and implementation matches actual requirements.\\\\n\\\\n## Debugging Malformed CLJ / EDN / CLJS\\\\n\\\\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\\\\n\\\\n1. **Run clj-kondo first**:\\\\n   ```sh\\\\n   clj -M:kondo --lint path/to/file.cljs\\\\n   ```\\\\n\\\\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\\\\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\\\\n\\\\n3. **Fix one bracket at a time, re-run checker after each fix**:\\\\n   Common patterns:\\\\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\\\\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\\\\n   - Both can coexist while total bracket count is zero-sum.\\\\n\\\\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\\\\ndocs/design/yang.php.md:170:  flags `SORT_REGULAR`, `SORT_NUMERIC`, `SORT_STRING`; `r*` variants flip the\\\\ndocs/design/yang.php.md:253:  prints `0.3`); `var_dump`, `var_export` and `json_encode` use\\\\ndocs/design/yang.php.md:1691:|                          | refused; `json_encode`/`json_decode` |            |\\\\ncollab/orch-lane/1793506000000-engineer-p4-heap-fixture.gpt-6-luna.stdout.log:9:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_3\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"cat /Users/sto/workspace/datomworld/collab/orch-lane/1793502000000-architect-p4-heap-ruling.kimi-k3.1-pro.stdout.log; rg -n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"make-generator|:php/type :generator|:gen|php/collect|engine/collect|final-vms|run-raw|deep-size\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" test/yang/php/antlr/generators_test.clj test/yang/php/antlr/e2e_harness.clj src/cljc/yang/php/antlr/prelude.cljc | head -100; sed -n '1,90p' test/yang/php/antlr/generators_test.clj\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"meta\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"system.version\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"version\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"2.4.0\\\\\\\\\\\\\\\"}\\\\\\\\n{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"assistant\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_calls\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_reOTgeR6ofJphvkwiQj2NCXq\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Read\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"arguments\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"/tmp/orch/kimi-heap-ruling.md\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"}\\\\\\\\\\\\\\\"}}]}\\\\\\\\n{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_call_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_reOTgeR6ofJphvkwiQj2NCXq\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\tCreated-Local: 2026-11-01 22:0x +0700\\\\\\\\\\\\\\\\n2\\\\\\\\\\\\\\\\tCoding-Agent: kimi\\\\\\\\\\\\\\\\n3\\\\\\\\\\\\\\\\tSession: fresh (new session id)\\\\\\\\\\\\\\\\n4\\\\\\\\\\\\\\\\tMode: read-only review/architect ruling\\\\\\\\\\\\\\\\n5\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n6\\\\\\\\\\\\\\\\t# Question: is the reachable-heap growth a leak, or is the stability assertion wrong?\\\\\\\\\\\\\\\\n7\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n8\\\\\\\\\\\\\\\\tRole: architect adjudication (yang.php P4 checkpoint B). Governing: docs/design/yang.php.md (P4 S8 generator runtime, ruling 7), test/yang/php/antlr/generators_test.clj lines ~110-147 in worktree /Users/sto/workspace/datomworld-php-p4 (branch yang-php-p4 @ 304ef51e).\\\\\\\\\\\\\\\\n9\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n10\\\\\\\\\\\\\\\\t## The contradiction\\\\\\\\\\\\\\\\n11\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n12\\\\\\\\\\\\\\\\tRuling 7 (your earlier five-step approach) asked for a blocked-VM heap scan proving the generator runtime does not retain unreachable memory under delegation. The implemented test `reachable-heap-is-stable-under-delegation-test` runs `changing-caller-source` (a delegating generator h yielding from g, driven by byFunction/byGenerator callers for N iterations, then blocks the VM, collects from the suspended generator root) at N=10 and N=1000, and asserts equal reachable sizes.\\\\\\\\\\\\\\\\n13\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n14\\\\\\\\\\\\\\\\tMeasured on all four VMs: 151 reachable cells at N=10, 5,596 at N=1000. The equality fails on every VM.\\\\\\\\\\\\\\\\n15\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n16\\\\\\\\\\\\\\\\t## The question\\\\\\\\\\\\\\\\n17\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n18\\\\\\\\\\\\\\\\tThe PHP source itself retains state across iterations: `$i` increments, the while loop's frame is suspended and resumed N times, `byGenerator` creates a fresh delegating generator `$j` per odd iteration (each `$j` is a local released each loop pass, but each `$j` yielded `$x->current()` values that may have been retained by `$it->self`'s self-reference or by the delegation chain). So is the 151 -> 5,596 growth:\\\\\\\\\\\\\\\\n19\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n20\\\\\\\\\\\\\\\\t(a) a real retention leak (per-iteration garbage that should have been collected by the temporary cleanup or the unset path — the guest runtime retains completed delegators or their yield buffers), or\\\\\\\\\\\\\\\\n21\\\\\\\\\\\\\\\\t(b) expected semantics (the suspended delegating generator's frame genuinely grows with N because the guest semantics keep the loop frame's live set, or because `yield from` accumulates), or\\\\\\\\\\\\\\\\n22\\\\\\\\\\\\\\\\t(c) a mis-designed measurement (the block point should come AFTER the caller loop finishes AND the delegator `$it` should be the only root — but the caller loop's own temporaries at block time legitimately hold the last `$j`, so the comparison at different N compares different live sets)?\\\\\\\\\\\\\\\\n23\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n24\\\\\\\\\\\\\\\\tRule as the architect: which is it, what is the correct measurement/fixture (or the correct assertion), and what (if anything) is the engineer round to change. Cite the yin.vm release/cleanup semantics you rely on. Read-only: do not edit.\\\\\\\\\\\\\\\"}\\\\\\\\n{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"assistant\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"I’ll inspect the fixture and VM cleanup semantics, then give the ruling.\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_calls\\\\\\\\\\\\\\\":[{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_NDIHy8XoOEofY0uedKrQMYRa\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Read\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"arguments\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"test/yang/php/antlr/generators_test.clj\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"line_offset\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":1,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"n_lines\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":240}\\\\\\\\\\\\\\\"}},{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_FJEtGZkUxaGKp5G0m11jtFe9\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Read\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"arguments\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"docs/design/yang.php.md\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"line_offset\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":1,\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"n_lines\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":260}\\\\\\\\\\\\\\\"}},{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_fjT9RzyoCCdxLkWyYXmahpFA\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Grep\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"arguments\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pattern\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"release|cleanup|reachable-heap|self-reference|yield from\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"src\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"output_mode\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"files_with_matches\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"head_limit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":100}\\\\\\\\\\\\\\\"}},{\\\\\\\\\\\\\\\"type\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_Ea8ix43e4V4o7klpV2NKTdHV\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"function\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"Grep\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"arguments\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"{\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"pattern\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"release|cleanup|reachable-heap|yield from\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"path\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"docs/design\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"output_mode\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"head_limit\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\":100}\\\\\\\\\\\\\\\"}}]}\\\\\\\\n{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_call_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_FJEtGZkUxaGKp5G0m11jtFe9\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\t# yang.php: the PHP frontend\\\\\\\\\\\\\\\\n2\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n3\\\\\\\\\\\\\\\\tStatus: Designed 2026-10-17. Slices P1 and P2 (section 15) are implemented on\\\\\\\\\\\\\\\\n4\\\\\\\\\\\\\\\\tthe `yang.php.antlr` route (P2: arrays, key coercion, `foreach` by value, the\\\\\\\\\\\\\\\\n5\\\\\\\\\\\\\\\\tcore array builtins and sorting, oracle-verified against `php-8.3.35`, section\\\\\\\\\\\\\\\\n6\\\\\\\\\\\\\\\\t17.3). P3 landed in two parts: P3-a (the counted-cell substrate and the\\\\\\\\\\\\\\\\n7\\\\\\\\\\\\\\\\tprelude-level reference model, merged earlier) and P3-b (the program-level\\\\\\\\\\\\\\\\n8\\\\\\\\\\\\\\\\tlowering, see \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"P3-b landing status\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" below). P4 and P5 are complete; P6 is in\\\\\\\\\\\\\\\\n9\\\\\\\\\\\\\\\\tprogress through the linked inclusion profile, dynamic scope, namespaces,\\\\\\\\\\\\\\\\n10\\\\\\\\\\\\\\\\tconstants and autoload class map. P6's oracle recording and three-host DHT\\\\\\\\\\\\\\\\n11\\\\\\\\\\\\\\\\tverification remain part of its landing. The legacy `yang/php.cljc` frontend\\\\\\\\\\\\\\\\n12\\\\\\\\\\\\\\\\tis still the installed one. Design by Fable (Lead\\\\\\\\\\\\\\\\n13\\\\\\\\\\\\\\\\tSystem Architect seat); adversarial review by codex (gpt-6.1-sol) over a\\\\\\\\\\\\\\\\n14\\\\\\\\\\\\\\\\tnine-round design loop that ended READY with sign-off granted. Section 20\\\\\\\\\\\\\\\\n15\\\\\\\\\\\\\\\\t(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Design provenance\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") cites the loop.\\\\\\\\\\\\\\\\n16\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n17\\\\\\\\\\\\\\\\t**P3-b landing status.** The program-level lowering of the P3 plan (steps S2 to\\\\\\\\\\\\\\\\n18\\\\\\\\\\\\\\\\tS12) lands on branch `yang-php-p3b`; the oracle is the pinned `php-8.3.35`\\\\\\\\\\\\\\\\n19\\\\\\\\\\\\\\\\t(`php:8.3-cli` on shiva, banner `php-8.3.35 shiva 2026-10-25`).\\\\\\\\\\\\\\\\n20\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n21\\\\\\\\\\\\\\\\t- Lowered and oracle-pinned: references (`=&` in every location form,\\\\\\\\\\\\\\\\n22\\\\\\\\\\\\\\\\t  `[&$x]` array items), `global`, `static` binding to a persistent slot,\\\\\\\\\\\\\\\\n23\\\\\\\\\\\\\\\\t  by-reference parameters, variadics, named arguments and spread, dynamic\\\\\\\\\\\\\\\\n24\\\\\\\\\\\\\\\\t  calls, closures with `use` and `use (&)`, arrow functions, `foreach` by\\\\\\\\\\\\\\\\n25\\\\\\\\\\\\\\\\t  reference, the array-pointer builtins, destructuring (`[...]`, `list(...)`,\\\\\\\\\\\\\\\\n26\\\\\\\\\\\\\\\\t  keyed, nested, one level of `&`), `try`/`catch`/`finally`, `throw`, `match`,\\\\\\\\\\\\\\\\n27\\\\\\\\\\\\\\\\t  `Closure::bind` and `bindTo`, the temporary list, and the typed-reference\\\\\\\\\\\\\\\\n28\\\\\\\\\\\\\\\\t  machinery at prelude level (rows 41 to 45; syntax stays P4).\\\\\\\\\\\\\\\\n29\\\\\\\\\\\\\\\\t- Fixtures: 72 program-level fixtures are enabled and run on the AST walker,\\\\\\\\\\\\\\\\n30\\\\\\\\\\\\\\\\t  on the semantic, stack and register VMs, and parserless from checked-in CST\\\\\\\\\\\\\\\\n31\\\\\\\\\\\\\\\\t  packets on Node; 91 oracle results are pinned in `programs_p3b`\\\\\\\\\\\\\\\\n32\\\\\\\\\\\\\\\\t  (`recorded`), 13 further oracle-only sources record texts and the cyclic\\\\\\\\\\\\\\\\n33\\\\\\\\\\\\\\\\t  release evidence (R2 condition (a): `gc_collect_cycles()` collects the\\\\\\\\\\\\\\\\n34\\\\\\\\\\\\\\\\t  cycle, the engine only terminates, closed as a known gap in C1). The permutation\\\\\\\\\\\\\\\\n35\\\\\\\\\\\\\\\\t  corpus (13-letter alphabet, flat and nested) runs 518 programs in the quick\\\\\\\\\\\\\\\\n36\\\\\\\\\\\\\\\\t  tier and about 5,900 in the slow tier; the php-src `.phpt` selection tool is\\\\\\\\\\\\\\\\n37\\\\\\\\\\\\\\\\t  in place and its list is generated on shiva.\\\\\\\\\\\\\\\\n38\\\\\\\\\\\\\\\\t- Held: `:call-dynamic-dim` and `:foreach-key-and-destructure` (grammar corner\\\\\\\\\\\\\\\\n39\\\\\\\\\\\\\\\\t  C27); the user-class closure call `:closure-call-user-class` waits for P4.\\\\\\\\\\\\\\\\n40\\\\\\\\\\\\\\\\t- Not in this landing: the per-table iterator registry (C26, slice P3-c), the\\\\\\\\\\\\\\\\n41\\\\\\\\\\\\\\\\t  php-src selection, the full permutation corpus and the linked profile (P4\\\\\\\\\\\\\\\\n42\\\\\\\\\\\\\\\\t  seam).\\\\\\\\\\\\\\\\n43\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n44\\\\\\\\\\\\\\\\t**Departures introduced by P3-b** are ratified as corners C24 to C29 (section\\\\\\\\\\\\\\\\n45\\\\\\\\\\\\\\\\t17.2) and recorded in `docs/agents/known-gaps.md`. `declare` is refused, so\\\\\\\\\\\\\\\\n46\\\\\\\\\\\\\\\\t`strict_types` for typed references has no program path; `ref-write!`'s\\\\\\\\\\\\\\\\n47\\\\\\\\\\\\\\\\t`strict` argument is the seam P4 wires when `declare` lowers.\\\\\\\\\\\\\\\\n48\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n49\\\\\\\\\\\\\\\\tParent design: [`yang.antlr.md`](yang.antlr.md). This document makes concrete\\\\\\\\\\\\\\\\n50\\\\\\\\\\\\\\\\tits section 8.6 (Object-oriented and web: PHP, mixed text and ordered maps),\\\\\\\\\\\\\\\\n51\\\\\\\\\\\\\\\\tits section 8.11 for PHP arrays, and Phase 3. Companion:\\\\\\\\\\\\\\\\n52\\\\\\\\\\\\\\\\t[`yang.typescript.md`](yang.typescript.md), whose section 2 (prerequisites\\\\\\\\\\\\\\\\n53\\\\\\\\\\\\\\\\tbinding both frontends) and section 17 (the `yang.core` lifts) this document\\\\\\\\\\\\\\\\n54\\\\\\\\\\\\\\\\tdepends on and does not repeat. Once accepted, this document governs the\\\\\\\\\\\\\\\\n55\\\\\\\\\\\\\\\\tdetail; `yang.antlr.md` section 8.6 remains the paradigm summary.\\\\\\\\\\\\\\\\n56\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n57\\\\\\\\\\\\\\\\tRequest records, bound surfaces and the refusal of ambient resolution follow\\\\\\\\\\\\\\\\n58\\\\\\\\\\\\\\\\tthe doctrine of ADR 0004 (\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"external effects are interpreted stream deposits\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"),\\\\\\\\\\\\\\\\n59\\\\\\\\\\\\\\\\twhich is Proposed and not yet committed; `yang.typescript.md` section 2.4\\\\\\\\\\\\\\\\n60\\\\\\\\\\\\\\\\tnames what its rejection would reopen.\\\\\\\\\\\\\\\\n61\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n62\\\\\\\\\\\\\\\\t## 1. Scope\\\\\\\\\\\\\\\\n63\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n64\\\\\\\\\\\\\\\\tA new ANTLR frontend replaces the current PHP compiler frontend (section 5).\\\\\\\\\\\\\\\\n65\\\\\\\\\\\\\\\\tIt compiles PHP 8.3 source, including\\\\\\\\\\\\\\\\n66\\\\\\\\\\\\\\\\tmixed HTML text, to the Universal AST, and runs one request as one task\\\\\\\\\\\\\\\\n67\\\\\\\\\\\\\\\\treading an explicit request record. The frontend id is `:yang/php` either\\\\\\\\\\\\\\\\n68\\\\\\\\\\\\\\\\tway — the one-frontend-per-language scheme (2026-10-18; the id was\\\\\\\\\\\\\\\\n69\\\\\\\\\\\\\\\\t`:yang.php/legacy` before the legacy suffix was retired) leaves no room\\\\\\\\\\\\\\\\n70\\\\\\\\\\\\\\\\tfor implementation-suffixed ids, so the ANTLR frontend lands as a new\\\\\\\\\\\\\\\\n71\\\\\\\\\\\\\\\\trevision of `:yang/php`, its implementation named by the manifest's\\\\\\\\\\\\\\\\n72\\\\\\\\\\\\\\\\trevision and profile keys; the final naming at acceptance is the owner's.\\\\\\\\\\\\\\\\n73\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n74\\\\\\\\\\\\\\\\tThe design claims a specified fragment, not Zend fidelity: the transition\\\\\\\\\\\\\\\\n75\\\\\\\\\\\\\\\\ttable of section 4 and the behaviour of the slices of section 15, each pinned\\\\\\\\\\\\\\\\n76\\\\\\\\\\\\\\\\tby oracle fixtures against the pinned PHP CLI, with every Zend behaviour\\\\\\\\\\\\\\\\n77\\\\\\\\\\\\\\\\toutside it listed as a named corner (section 17). The `yang.antlr.md` Phase 3\\\\\\\\\\\\\\\\n78\\\\\\\\\\\\\\\\texit criteria are direct fixtures:\\\\\\\\\\\\\\\\n79\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n80\\\\\\\\\\\\\\\\t1. mixed text and code produce output in statement order;\\\\\\\\\\\\\\\\n81\\\\\\\\\\\\\\\\t2. arrays keep insertion order and PHP's alias and copy semantics;\\\\\\\\\\\\\\\\n82\\\\\\\\\\\\\\\\t3. superglobals are built from an explicit request input;\\\\\\\\\\\\\\\\n83\\\\\\\\\\\\\\\\t4. type declarations are not silently ignored (including through references);\\\\\\\\\\\\\\\\n84\\\\\\\\\\\\\\\\t5. two requests share nothing.\\\\\\\\\\\\\\\\n85\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n86\\\\\\\\\\\\\\\\tLike every frontend: no new AST tag, no engine change, no codec change.\\\\\\\\\\\\\\\\n87\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n88\\\\\\\\\\\\\\\\t## 2. Prerequisites\\\\\\\\\\\\\\\\n89\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n90\\\\\\\\\\\\\\\\tEverything in `yang.typescript.md` section 2 binds this frontend: defects D1\\\\\\\\\\\\\\\\n91\\\\\\\\\\\\\\\\tto D7, the shared rulings (own null sentinel, Jing numeric kinds, JVM-only\\\\\\\\\\\\\\\\n92\\\\\\\\\\\\\\\\tparsing with three-host execution, the linked-profile matrix of bundled on\\\\\\\\\\\\\\\\n93\\\\\\\\\\\\\\\\tfour evaluators and linked on three until L-b), and the ADR 0004 dependency.\\\\\\\\\\\\\\\\n94\\\\\\\\\\\\\\\\tPHP uses the lifted namespaces of `yang.typescript.md` section 17 (L1 to L4\\\\\\\\\\\\\\\\n95\\\\\\\\\\\\\\\\tland first) and adds nothing to them (section 16). Two PHP-specific\\\\\\\\\\\\\\\\n96\\\\\\\\\\\\\\\\tdependencies: statement-level ticks wait on safepoint slice 3 (section 12),\\\\\\\\\\\\\\\\n97\\\\\\\\\\\\\\\\tand optional absent includes wait on the known-gaps ledger item for\\\\\\\\\\\\\\\\n98\\\\\\\\\\\\\\\\tpublication-time-unavailable imports (section 11.3).\\\\\\\\\\\\\\\\n99\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n100\\\\\\\\\\\\\\\\t## 3. The paradigm specification\\\\\\\\\\\\\\\\n101\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n102\\\\\\\\\\\\\\\\t### 3.1 Reference runtime\\\\\\\\\\\\\\\\n103\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n104\\\\\\\\\\\\\\\\tPHP 8.3 CLI at a pinned patch release (owner decision B8.1), with `php.ini`\\\\\\\\\\\\\\\\n105\\\\\\\\\\\\\\\\tpinning `precision=14`, `serialize_precision=-1`, `error_reporting=E_ALL` and\\\\\\\\\\\\\\\\n106\\\\\\\\\\\\\\\\t`display_errors=stderr`. The grammar's feature set (enums, `match`,\\\\\\\\\\\\\\\\n107\\\\\\\\\\\\\\\\t`readonly`, named arguments, attributes) is PHP 8.1 and later, so 8.3 is the\\\\\\\\\\\\\\\\n108\\\\\\\\\\\\\\\\tnatural pin. PHP 8.4 features (property hooks, asymmetric visibility) are not\\\\\\\\\\\\\\\\n109\\\\\\\\\\\\\\\\tparsed (corner C10).\\\\\\\\\\\\\\\\n110\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n111\\\\\\\\\\\\\\\\t### 3.2 Arrays and keys\\\\\\\\\\\\\\\\n112\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n113\\\\\\\\\\\\\\\\tA PHP array is a value: assignment and parameter passing copy it, and a write\\\\\\\\\\\\\\\\n114\\\\\\\\\\\\\\\\tnever affects another holder. Its representation is chosen by what it contains\\\\\\\\\\\\\\\\n115\\\\\\\\\\\\\\\\t(section 4.2): an array that transitively holds no reference, no\\\\\\\\\\\\\\\\n116\\\\\\\\\\\\\\\\tarray-instance handle and no object handle is a **plain** persistent ordered\\\\\\\\\\\\\\\\n117\\\\\\\\\\\\\\\\tmap stored directly in its holder, copied in O(1), with mutation as get, pure\\\\\\\\\\\\\\\\n118\\\\\\\\\\\\\\\\tupdate and `cell/set!`. Any other array is a counted **instance** cell whose\\\\\\\\\\\\\\\\n119\\\\\\\\\\\\\\\\tduplication follows the engine (section 4).\\\\\\\\\\\\\\\\n120\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n121\\\\\\\\\\\\\\\\t- **Key coercion** at every write and read: an integer stays; a\\\\\\\\\\\\\\\\n122\\\\\\\\\\\\\\\\t  decimal-integer string in canonical form (`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"8\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` yes; `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"08\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"8.0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" 8\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`\\\\\\\\\\\\\\\\n123\\\\\\\\\\\\\\\\t  no) becomes that integer; a float truncates toward zero (with the PHP 8.1\\\\\\\\\\\\\\\\n124\\\\\\\\\\\\\\\\t  deprecation emitted as a diagnostic record); `true` and `false` become 1 and\\\\\\\\\\\\\\\\n125\\\\\\\\\\\\\\\\t  0; `null` becomes `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`; any other string stays a string.\\\\\\\\\\\\\\\\n126\\\\\\\\\\\\\\\\t- `next-index` is one more than the largest integer key ever used and never\\\\\\\\\\\\\\\\n127\\\\\\\\\\\\\\\\t  decreases on unset; negative keys follow PHP 8.3's rule (next is max + 1).\\\\\\\\\\\\\\\\n128\\\\\\\\\\\\\\\\t  `$a[] = v` appends at `next-index`. The one decrement is `array_pop`, which\\\\\\\\\\\\\\\\n129\\\\\\\\\\\\\\\\t  lowers it when the popped key was `next-index - 1`.\\\\\\\\\\\\\\\\n130\\\\\\\\\\\\\\\\t- Iteration follows the key order (`php/array-keys`; the prelude's array\\\\\\\\\\\\\\\\n131\\\\\\\\\\\\\\\\t  operations are the only code that reads `:index`, `:order` or `:next-index`).\\\\\\\\\\\\\\\\n132\\\\\\\\\\\\\\\\t  Unset splices the order. Nested arrays are nested\\\\\\\\\\\\\\\\n133\\\\\\\\\\\\\\\\t  values: `$a['x']['y'] = 1` is one path update.\\\\\\\\\\\\\\\\n134\\\\\\\\\\\\\\\\t- Large arrays cost one path copy per write; a packed-vector fast path is an\\\\\\\\\\\\\\\\n135\\\\\\\\\\\\\\\\t  attached optimizer's business, not the lowering's.\\\\\\\\\\\\\\\\n136\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n137\\\\\\\\\\\\\\\\t#### 3.2.1 Reads, `isset`, `empty`, `unset` and builtins (P2)\\\\\\\\\\\\\\\\n138\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n139\\\\\\\\\\\\\\\\t- **Reads.** A missing key warns (2) `Undefined array key \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"x\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` or\\\\\\\\\\\\\\\\n140\\\\\\\\\\\\\\\\t  `Undefined array key 5` and answers null; an offset read on null, bool, int\\\\\\\\\\\\\\\\n141\\\\\\\\\\\\\\\\t  or float warns `Trying to access array offset on <type|true|false>`; a\\\\\\\\\\\\\\\\n142\\\\\\\\\\\\\\\\t  string container answers the one byte at the offset (negative counts from the\\\\\\\\\\\\\\\\n143\\\\\\\\\\\\\\\\t  end), out of range warns `Uninitialized string offset N` and answers `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`.\\\\\\\\\\\\\\\\n144\\\\\\\\\\\\\\\\t  `$a[]` in read position is a compile error `Cannot use [] for reading`.\\\\\\\\\\\\\\\\n145\\\\\\\\\\\\\\\\t- **`isset`/`empty` on a string container** coerce the offset, then test the\\\\\\\\\\\\\\\\n146\\\\\\\\\\\\\\\\t  range: int itself; `true`, `false`, null as `1`, `0`, `0` silently; a float\\\\\\\\\\\\\\\\n147\\\\\\\\\\\\\\\\t  by the float-key seam (`php/float-key`, precision deprecation when\\\\\\\\\\\\\\\\n148\\\\\\\\\\\\\\\\t  fractional, no \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"String offset cast\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" warning, which belongs to reads); an\\\\\\\\\\\\\\\\n149\\\\\\\\\\\\\\\\t  integer-numeric string as that int; anything else is not an offset (`isset`\\\\\\\\\\\\\\\\n150\\\\\\\\\\\\\\\\t  false, `empty` true).\\\\\\\\\\\\\\\\n151\\\\\\\\\\\\\\\\t- **`unset` on a non-array**: a missing key or null at any level is a no-op;\\\\\\\\\\\\\\\\n152\\\\\\\\\\\\\\\\t  a string terminal is `Error \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Cannot unset string offsets\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`; int, float and\\\\\\\\\\\\\\\\n153\\\\\\\\\\\\\\\\t  `true` are `Error \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Cannot unset offset in a non-array variable\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`; `false`\\\\\\\\\\\\\\\\n154\\\\\\\\\\\\\\\\t  emits Deprecated (8192) `Automatic conversion of false to array is\\\\\\\\\\\\\\\\n155\\\\\\\\\\\\\\\\t  deprecated` and stays `false`.\\\\\\\\\\\\\\\\n156\\\\\\\\\\\\\\\\t- **Builtin protocol.** One table (`yang.php.antlr.builtins/supported`) feeds\\\\\\\\\\\\\\\\n157\\\\\\\\\\\\\\\\t  the prelude registration and the lowering's by-reference positions. For a\\\\\\\\\\\\\\\\n158\\\\\\\\\\\\\\\\t  call with `:by-ref` positions the lowering (1) binds each by-ref location's\\\\\\\\\\\\\\\\n159\\\\\\\\\\\\\\\\t  keys at that argument's place in left-to-right order; (2) evaluates every\\\\\\\\\\\\\\\\n160\\\\\\\\\\\\\\\\t  other argument left to right into temporaries (a non-location at a by-ref\\\\\\\\\\\\\\\\n161\\\\\\\\\\\\\\\\t  position warns 8 `Only variables should be passed by reference`); (3)\\\\\\\\\\\\\\\\n162\\\\\\\\\\\\\\\\t  immediately before the call, reads each by-ref location through its bound\\\\\\\\\\\\\\\\n163\\\\\\\\\\\\\\\\t  keys and builds the argument vector; (4) calls; (5) writes each out back\\\\\\\\\\\\\\\\n164\\\\\\\\\\\\\\\\t  through the same keys, in position order.\\\\\\\\\\\\\\\\n165\\\\\\\\\\\\\\\\t- **`foreach` by value** iterates a snapshot (`php/foreach-array`, then\\\\\\\\\\\\\\\\n166\\\\\\\\\\\\\\\\t  `php/array-keys` and `php/array-get`), so writes, `unset`, appends and\\\\\\\\\\\\\\\\n167\\\\\\\\\\\\\\\\t  `sort` of the source in the body never change the iteration (the by-value\\\\\\\\\\\\\\\\n168\\\\\\\\\\\\\\\\t  half of C15). A non-array warns and iterates nothing.\\\\\\\\\\\\\\\\n169\\\\\\\\\\\\\\\\t- **Sorting** is one stable merge sort in the prelude (no host sort), with\\\\\\\\\\\\\\\\n170\\\\\\\\\\\\\\\\t  flags `SORT_REGULAR`, `SORT_NUMERIC`, `SORT_STRING`; `r*` variants flip the\\\\\\\\\\\\\\\\n171\\\\\\\\\\\\\\\\t  sign without reversing equal elements. A **bool** comparator is retried\\\\\\\\\\\\\\\\n172\\\\\\\\\\\\\\\\t  swapped and emits Deprecated 8192 `usort(): Returning bool from comparison\\\\\\\\\\\\\\\\n173\\\\\\\\\\\\\\\\t  function is deprecated, return an integer less than, equal to, or greater\\\\\\\\\\\\\\\\n174\\\\\\\\\\\\\\\\t  than zero` once per call. Parity claim: `usort` with a bool comparator\\\\\\\\\\\\\\\\n175\\\\\\\\\\\\\\\\t  `return $a > $b;` over `[3, 1, 2]` matches the CLI's order and emits the\\\\\\\\\\\\\\\\n176\\\\\\\\\\\\\\\\t  deprecation exactly once per call. Stability is not parity for a comparator\\\\\\\\\\\\\\\\n177\\\\\\\\\\\\\\\\t  that disagrees with itself (corner G-sort-inconsistent-cmp, section 17.2).\\\\\\\\\\\\\\\\n178\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n179\\\\\\\\\\\\\\\\t### 3.3 Scope\\\\\\\\\\\\\\\\n180\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n181\\\\\\\\\\\\\\\\t- PHP has function scope only, with no block scope and no implicit closure\\\\\\\\\\\\\\\\n182\\\\\\\\\\\\\\\\t  capture, except arrow `fn`, which captures by value every enclosing variable\\\\\\\\\\\\\\\\n183\\\\\\\\\\\\\\\\t  it mentions, at creation.\\\\\\\\\\\\\\\\n184\\\\\\\\\\\\\\\\t- **Locals are cells** allocated at function entry with `:php/undef`; reading\\\\\\\\\\\\\\\\n185\\\\\\\\\\\\\\\\t  one emits `Warning: Undefined variable` and yields null. Every function body\\\\\\\\\\\\\\\\n186\\\\\\\\\\\\\\\\t  that declares locals or parameters releases them on exit (row 16).\\\\\\\\\\\\\\\\n187\\\\\\\\\\\\\\\\t- `global $x` binds the local to the `$GLOBALS` entry by reference (row 17),\\\\\\\\\\\\\\\\n188\\\\\\\\\\\\\\\\t  creating it as null if absent.\\\\\\\\\\\\\\\\n189\\\\\\\\\\\\\\\\t- `static $x = <expr>;` is a cell owned by the function object, allocated at\\\\\\\\\\\\\\\\n190\\\\\\\\\\\\\\\\t  function creation with an uninitialized sentinel. Its initializer is an\\\\\\\\\\\\\\\\n191\\\\\\\\\\\\\\\\t  arbitrary expression evaluated **when execution first reaches the\\\\\\\\\\\\\\\\n192\\\\\\\\\\\\\\\\t  declaration** (PHP 8.3) and filled once.\\\\\\\\\\\\\\\\n193\\\\\\\\\\\\\\\\t- **The dynamic-scope profile**: a function whose body contains\\\\\\\\\\\\\\\\n194\\\\\\\\\\\\\\\\t  `include`/`require`, `$$name`, `extract`, `compact`, `get_defined_vars`,\\\\\\\\\\\\\\\\n195\\\\\\\\\\\\\\\\t  `eval`, or one-argument `parse_str` keeps its locals in a heap symbol-table\\\\\\\\\\\\\\\\n196\\\\\\\\\\\\\\\\t  dict (the precedent is Python's module namespace, owner decision 1 of\\\\\\\\\\\\\\\\n197\\\\\\\\\\\\\\\\t  `yang.antlr.md` 8.5.1). Scope analysis decides per function, and the\\\\\\\\\\\\\\\\n198\\\\\\\\\\\\\\\\t  lowering targets `php/local-get`/`php/local-set` on the dict. All other\\\\\\\\\\\\\\\\n199\\\\\\\\\\\\\\\\t  functions use cells (owner decision B8.3). The symbol table holds reference\\\\\\\\\\\\\\\\n200\\\\\\\\\\\\\\\\t  markers like any location.\\\\\\\\\\\\\\\\n201\\\\\\\\\\\\\\\\t- **The global scope** is always the `$GLOBALS` dict: a heap dict,\\\\\\\\\\\\\\\\n202\\\\\\\\\\\\\\\\t  insertion-ordered, with the superglobals pre-seeded from the request record.\\\\\\\\\\\\\\\\n203\\\\\\\\\\\\\\\\t  `$GLOBALS` is read-only as of PHP 8.1 except through its elements (corner\\\\\\\\\\\\\\\\n204\\\\\\\\\\\\\\\\t  C13).\\\\\\\\\\\\\\\\n205\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n206\\\\\\\\\\\\\\\\t### 3.4 Superglobals and the request context\\\\\\\\\\\\\\\\n207\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n208\\\\\\\\\\\\\\\\t- A PHP run is one task consuming one **request record** from a\\\\\\\\\\\\\\\\n209\\\\\\\\\\\\\\\\t  composition-supplied stream: `{:php.request/method :uri :query :headers\\\\\\\\\\\\\\\\n210\\\\\\\\\\\\\\\\t  :cookies :body :server :env :files}`. `php/init!` builds `$_GET`, `$_POST`,\\\\\\\\\\\\\\\\n211\\\\\\\\\\\\\\\\t  `$_COOKIE`, `$_SERVER`, `$_ENV`, `$_FILES`, `$_REQUEST` (ordered per a\\\\\\\\\\\\\\\\n212\\\\\\\\\\\\\\\\t  pinned `request_order`) and, for CLI, `$argv` and `$argc`. `$_SESSION` is a\\\\\\\\\\\\\\\\n213\\\\\\\\\\\\\\\\t  bound surface (a session-store effect), absent by default. Nothing reads\\\\\\\\\\\\\\\\n214\\\\\\\\\\\\\\\\t  ambient process or HTTP state.\\\\\\\\\\\\\\\\n215\\\\\\\\\\\\\\\\t- **Output** (`echo`, `print`, inline HTML, `printf`) appends to an output\\\\\\\\\\\\\\\\n216\\\\\\\\\\\\\\\\t  cell with the output-buffering stack; `ob_start` and `ob_get_clean` are pure\\\\\\\\\\\\\\\\n217\\\\\\\\\\\\\\\\t  prelude over that stack. The top level flushes ordered `:php.response/body`\\\\\\\\\\\\\\\\n218\\\\\\\\\\\\\\\\t  records on the response stream. `header()`, `http_response_code` and\\\\\\\\\\\\\\\\n219\\\\\\\\\\\\\\\\t  `setcookie` produce `:php.response/header` records, refused after the first\\\\\\\\\\\\\\\\n220\\\\\\\\\\\\\\\\t  body flush with PHP's warning text.\\\\\\\\\\\\\\\\n221\\\\\\\\\\\\\\\\t- `exit` and `die` are an escape to the task root, followed by the shutdown\\\\\\\\\\\\\\\\n222\\\\\\\\\\\\\\\\t  sequence (row 22).\\\\\\\\\\\\\\\\n223\\\\\\\\\\\\\\\\t- Cross-request leakage is impossible by construction: one task per request\\\\\\\\\\\\\\\\n224\\\\\\\\\\\\\\\\t  and no store writes for guest state.\\\\\\\\\\\\\\\\n225\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n226\\\\\\\\\\\\\\\\t### 3.5 Coercion, comparison and arithmetic\\\\\\\\\\\\\\\\n227\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n228\\\\\\\\\\\\\\\\t- **Loose equality** is the PHP 8 comparison table, pinned as a fixture matrix\\\\\\\\\\\\\\\\n229\\\\\\\\\\\\\\\\t  over every pair of `null`, `true`, `false`, `0`, `1`, `-1`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`,\\\\\\\\\\\\\\\\n230\\\\\\\\\\\\\\\\t  `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"01\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1e1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"10\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"abc\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" 1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1 \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `[]`, `[0]`, `0.0`,\\\\\\\\\\\\\\\\n231\\\\\\\\\\\\\\\\t  `NAN`, `INF`, an object, and a `Stringable`. For example `0 == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `0 ==\\\\\\\\\\\\\\\\n232\\\\\\\\\\\\\\\\t  []` and `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" == []` are false in PHP 8, while `0 == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"0\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" == null`, `[]\\\\\\\\\\\\\\\\n233\\\\\\\\\\\\\\\\t  == false`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"01\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"10\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1e1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` and `100 == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"1e2\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` are true.\\\\\\\\\\\\\\\\n234\\\\\\\\\\\\\\\\t  Number versus numeric string compares numerically; number versus non-numeric\\\\\\\\\\\\\\\\n235\\\\\\\\\\\\\\\\t  string compares as strings, so `0 == \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"` is false. Arrays compare by key\\\\\\\\\\\\\\\\n236\\\\\\\\\\\\\\\\t  and value; objects by property, or by identity for `===`.\\\\\\\\\\\\\\\\n237\\\\\\\\\\\\\\\\t- `<=>` uses the same ordering; `===` requires identical type and value,\\\\\\\\\\\\\\\\n238\\\\\\\\\\\\\\\\t  arrays element-wise, objects the same handle.\\\\\\\\\\\\\\\\n239\\\\\\\\\\\\\\\\t- **Numeric strings** (`is_numeric`) allow leading and trailing whitespace\\\\\\\\\\\\\\\\n240\\\\\\\\\\\\\\\\t  (8.0) and exponent forms. Leading-numeric strings in arithmetic warn (`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"5\\\\\\\\\\\\\\\\n241\\\\\\\\\\\\\\\\t  apples\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" + 1` warns and gives 6); non-numeric ones throw `TypeError`. String\\\\\\\\\\\\\\\\n242\\\\\\\\\\\\\\\\t  increment is supported (`\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"a\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"++` is `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"b\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`, `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Az\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"++` is `\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Ba\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"`).\\\\\\\\\\\\\\\\n243\\\\\\\\\\\\\\\\t- **Integer overflow converts to float**: every integer operator goes through\\\\\\\\\\\\\\\\n244\\\\\\\\\\\\\\\\t  the exact integer module and demotes to float64 when the exact result leaves\\\\\\\\\\\\\\\\n245\\\\\\\\\\\\\\\\t  `[-2^63, 2^63-1]` (`PHP_INT_MAX + 1` is a float). This is the one place C3's\\\\\\\\\\\\\\\\n246\\\\\\\\\\\\\\\\t  promotion-before-overflow is used to detect rather than to promote.\\\\\\\\\\\\\\\\n247\\\\\\\\\\\\\\\\t- `/` yields an int only when exact, else a float. `%` is int-only:\\\\\\\\\\\\\\\\n248\\\\\\\\\\\\\\\\t  `PHP_INT_MIN % -1` is `0`, and `% 0` throws `DivisionByZeroError`.\\\\\\\\\\\\\\\\n249\\\\\\\\\\\\\\\\t  `intdiv(PHP_INT_MIN, -1)` throws `ArithmeticError`, and `intdiv(x, 0)`\\\\\\\\\\\\\\\\n250\\\\\\\\\\\\\\\\t  throws `DivisionByZeroError`. `fmod` never throws. `**` is an int when exact\\\\\\\\\\\\\\\\n251\\\\\\\\\\\\\\\\t  and in range, else a float, via the pinned `fpow`.\\\\\\\\\\\\\\\\n252\\\\\\\\\\\\\\\\t- **Float to string**: `echo` uses `precision=14` (`%.14G`, so `echo 0.1+0.2`\\\\\\\\\\\\\\\\n253\\\\\\\\\\\\\\\\t  prints `0.3`); `var_dump`, `var_export` and `json_encode` use\\\\\\\\\\\\\\\\n254\\\\\\\\\\\\\\\\t  `serialize_precision=-1` (the shortest round trip, `integer/float-digits`).\\\\\\\\\\\\\\\\n255\\\\\\\\\\\\\\\\t  Fourteen-significant-digit rounding needs exact decimal rounding of a\\\\\\\\\\\\\\\\n256\\\\\\\\\\\\\\\\t  binary64: a prelude function over `integer`'s exact decomposition, with no\\\\\\\\\\\\\\\\n257\\\\\\\\\\\\\\\\t  new kernel (an `integer` version bump only if measured too slow).\\\\\\\\\\\\\\\\n258\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n259\\\\\\\\\\\\\\\\t### 3.6 Null\\\\\\\\\\\\\\\\n260\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\"}\\\\\\\\n{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_call_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_NDIHy8XoOEofY0uedKrQMYRa\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"1\\\\\\\\\\\\\\\\t(ns yang.php.antlr.generators-test\\\\\\\\\\\\\\\\n2\\\\\\\\\\\\\\\\t  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"P4 S8 generators, live iteration and protocol integration on the JVM.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n3\\\\\\\\\\\\\\\\t  (:require\\\\\\\\\\\\\\\\n4\\\\\\\\\\\\\\\\t    [clojure.test :refer [deftest is testing]]\\\\\\\\\\\\\\\\n5\\\\\\\\\\\\\\\\t    [yang.core.uast :as u]\\\\\\\\\\\\\\\\n6\\\\\\\\\\\\\\\\t    [yang.php.antlr.e2e-harness :as h]\\\\\\\\\\\\\\\\n7\\\\\\\\\\\\\\\\t    [yang.php.antlr.programs-p4 :as p4]\\\\\\\\\\\\\\\\n8\\\\\\\\\\\\\\\\t    [yang.tails :as tails]\\\\\\\\\\\\\\\\n9\\\\\\\\\\\\\\\\t    [yin.vm :as vm]\\\\\\\\\\\\\\\\n10\\\\\\\\\\\\\\\\t    [yin.vm.debruijn.register :as rvm]\\\\\\\\\\\\\\\\n11\\\\\\\\\\\\\\\\t    [yin.vm.debruijn.stack :as dvm]\\\\\\\\\\\\\\\\n12\\\\\\\\\\\\\\\\t    [yin.vm.engine :as engine]\\\\\\\\\\\\\\\\n13\\\\\\\\\\\\\\\\t    [yin.vm.semantic :as semantic]\\\\\\\\\\\\\\\\n14\\\\\\\\\\\\\\\\t    [yin.vm.semantic.derive :as derive]\\\\\\\\\\\\\\\\n15\\\\\\\\\\\\\\\\t    [yin.vm.semantic.linearize :as sr-linearize]\\\\\\\\\\\\\\\\n16\\\\\\\\\\\\\\\\t    [yin.vm.test-utils :as tu]\\\\\\\\\\\\\\\\n17\\\\\\\\\\\\\\\\t    [yin.vm.values :as values])\\\\\\\\\\\\\\\\n18\\\\\\\\\\\\\\\\t  (:import\\\\\\\\\\\\\\\\n19\\\\\\\\\\\\\\\\t    [java.util IdentityHashMap]))\\\\\\\\\\\\\\\\n20\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n21\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n22\\\\\\\\\\\\\\\\t(def ^:private vms [:ast-walker :semantic :stack :register])\\\\\\\\\\\\\\\\n23\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n24\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n25\\\\\\\\\\\\\\\\t(deftest generator-fixtures-on-every-vm-test\\\\\\\\\\\\\\\\n26\\\\\\\\\\\\\\\\t  (doseq [{:keys [id source out]} p4/generators-v1]\\\\\\\\\\\\\\\\n27\\\\\\\\\\\\\\\\t    (testing (name id)\\\\\\\\\\\\\\\\n28\\\\\\\\\\\\\\\\t      (let [results (h/run-php source)]\\\\\\\\\\\\\\\\n29\\\\\\\\\\\\\\\\t        (is (not (contains? results :diagnostics)) (pr-str results))\\\\\\\\\\\\\\\\n30\\\\\\\\\\\\\\\\t        (doseq [k vms]\\\\\\\\\\\\\\\\n31\\\\\\\\\\\\\\\\t          (is (= out (get results k)) (str (name id) \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" on \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" k)))))))\\\\\\\\\\\\\\\\n32\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n33\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n34\\\\\\\\\\\\\\\\t(deftest iteration-protocols-test\\\\\\\\\\\\\\\\n35\\\\\\\\\\\\\\\\t  (testing \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Iterator drives foreach directly\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n36\\\\\\\\\\\\\\\\t    (is (= \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"01\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\\\\\\\\\n37\\\\\\\\\\\\\\\\t                            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"<?php class I implements Iterator { private $i=0; function rewind(): void {$this->i=0;} function valid(): bool {return $this->i<2;} function current(): mixed {return $this->i;} function key(): mixed {return $this->i;} function next(): void {$this->i++;} } foreach(new I as $v) echo $v;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")))))\\\\\\\\\\\\\\\\n38\\\\\\\\\\\\\\\\t  (testing \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"IteratorAggregate supplies the live iterator\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n39\\\\\\\\\\\\\\\\t    (is (= \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"23\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\\\\\\\\\n40\\\\\\\\\\\\\\\\t                            \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"<?php class I implements Iterator {private $i=2;function rewind():void{}function valid():bool{return $this->i<4;}function current(){return $this->i;}function key(){return $this->i;}function next():void{$this->i++;}} class A implements IteratorAggregate {function getIterator():Iterator{return new I;}} foreach(new A as $v)echo $v;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")))))\\\\\\\\\\\\\\\\n41\\\\\\\\\\\\\\\\t  (testing \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"property iteration filters visibility from the calling scope\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n42\\\\\\\\\\\\\\\\t    (is (= \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"aabc\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\\\\\\\\\n43\\\\\\\\\\\\\\\\t                              \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"<?php class P {public $a='a'; protected $b='b'; private $c='c'; function f(){foreach($this as $v)echo $v;}} $p=new P;foreach($p as $v)echo $v;$p->f();\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")))))\\\\\\\\\\\\\\\\n44\\\\\\\\\\\\\\\\t  (testing \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ArrayAccess reads by value; Countable and Stringable dispatch\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n45\\\\\\\\\\\\\\\\t    (is (= \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"43s\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\\\\\\\\\n46\\\\\\\\\\\\\\\\t                             \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"<?php class A implements ArrayAccess, Countable, Stringable {function offsetExists($x):bool{return true;} function offsetGet($x){return 4;} function offsetSet($x,$v):void{} function offsetUnset($x):void{} function count():int{return 3;} function __toString():string{return 's';}} $a=new A;echo $a[0],count($a),(string)$a;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"))))))\\\\\\\\\\\\\\\\n47\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n48\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n49\\\\\\\\\\\\\\\\t(def ^:private opts\\\\\\\\\\\\\\\\n50\\\\\\\\\\\\\\\\t  {:make-stream tu/make-stream\\\\\\\\\\\\\\\\n51\\\\\\\\\\\\\\\\t   :capability-secret tu/secret\\\\\\\\\\\\\\\\n52\\\\\\\\\\\\\\\\t   :primitives vm/primitives\\\\\\\\\\\\\\\\n53\\\\\\\\\\\\\\\\t   :modules (h/host-registry)})\\\\\\\\\\\\\\\\n54\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n55\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n56\\\\\\\\\\\\\\\\t(def ^:private load-semantic\\\\\\\\\\\\\\\\n57\\\\\\\\\\\\\\\\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\\\\\\\\\\\\\\\n58\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n59\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n60\\\\\\\\\\\\\\\\t(def ^:private final-vms\\\\\\\\\\\\\\\\n61\\\\\\\\\\\\\\\\t  {:ast-walker (fn [ast _] (vm/eval (tu/create-vm opts) ast))\\\\\\\\\\\\\\\\n62\\\\\\\\\\\\\\\\t   :semantic (fn [_ datoms] (vm/run (load-semantic (semantic/create-vm opts) datoms)))\\\\\\\\\\\\\\\\n63\\\\\\\\\\\\\\\\t   :stack (fn [ast _]\\\\\\\\\\\\\\\\n64\\\\\\\\\\\\\\\\t            (vm/run (dvm/create-vm\\\\\\\\\\\\\\\\n65\\\\\\\\\\\\\\\\t                      (:image (derive/stack-image (:vector (sr-linearize/project ast))))\\\\\\\\\\\\\\\\n66\\\\\\\\\\\\\\\\t                      (assoc opts :contract vm/stack-contract))))\\\\\\\\\\\\\\\\n67\\\\\\\\\\\\\\\\t   :register (fn [ast _]\\\\\\\\\\\\\\\\n68\\\\\\\\\\\\\\\\t               (vm/run (rvm/create-vm\\\\\\\\\\\\\\\\n69\\\\\\\\\\\\\\\\t                         (derive/register-image (:vector (sr-linearize/project ast)))\\\\\\\\\\\\\\\\n70\\\\\\\\\\\\\\\\t                         (assoc opts :contract vm/register-contract))))})\\\\\\\\\\\\\\\\n71\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n72\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n73\\\\\\\\\\\\\\\\t(defn- deep-size\\\\\\\\\\\\\\\\n74\\\\\\\\\\\\\\\\t  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Count shared compound values once, including closure/continuation payloads.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n75\\\\\\\\\\\\\\\\t  [x]\\\\\\\\\\\\\\\\n76\\\\\\\\\\\\\\\\t  (let [seen (IdentityHashMap.)]\\\\\\\\\\\\\\\\n77\\\\\\\\\\\\\\\\t    (loop [work [x], size 0]\\\\\\\\\\\\\\\\n78\\\\\\\\\\\\\\\\t      (if (empty? work)\\\\\\\\\\\\\\\\n79\\\\\\\\\\\\\\\\t        size\\\\\\\\\\\\\\\\n80\\\\\\\\\\\\\\\\t        (let [x (peek work)\\\\\\\\\\\\\\\\n81\\\\\\\\\\\\\\\\t              work (pop work)\\\\\\\\\\\\\\\\n82\\\\\\\\\\\\\\\\t              compound? (or (values/host-typed? x) (coll? x))]\\\\\\\\\\\\\\\\n83\\\\\\\\\\\\\\\\t          (if (and compound? (.put seen x true))\\\\\\\\\\\\\\\\n84\\\\\\\\\\\\\\\\t            (recur work size)\\\\\\\\\\\\\\\\n85\\\\\\\\\\\\\\\\t            (recur (cond\\\\\\\\\\\\\\\\n86\\\\\\\\\\\\\\\\t                     (values/host-typed? x) (conj work (values/payload x))\\\\\\\\\\\\\\\\n87\\\\\\\\\\\\\\\\t                     (map? x) (into (into work (keys x)) (vals x))\\\\\\\\\\\\\\\\n88\\\\\\\\\\\\\\\\t                     (coll? x) (into work x)\\\\\\\\\\\\\\\\n89\\\\\\\\\\\\\\\\t                     :else work)\\\\\\\\\\\\\\\\n90\\\\\\\\\\\\\\\\t                   (inc size))))))))\\\\\\\\\\\\\\\\n91\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n92\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n93\\\\\\\\\\\\\\\\t(defn- live-after-collection\\\\\\\\\\\\\\\\n94\\\\\\\\\\\\\\\\t  [k source]\\\\\\\\\\\\\\\\n95\\\\\\\\\\\\\\\\t  (let [lowered (:ast (h/lower-program source))\\\\\\\\\\\\\\\\n96\\\\\\\\\\\\\\\\t        ;; Keep the normal unit entry point, but block its body before it\\\\\\\\\\\\\\\\n97\\\\\\\\\\\\\\\\t        ;; returns to php/run-main and shutdown. This fresh stream has no\\\\\\\\\\\\\\\\n98\\\\\\\\\\\\\\\\t        ;; producer, so h stays live and suspended in the captured heap.\\\\\\\\\\\\\\\\n99\\\\\\\\\\\\\\\\t        blocker {:type :stream/next\\\\\\\\\\\\\\\\n100\\\\\\\\\\\\\\\\t                 :source {:type :stream/cursor\\\\\\\\\\\\\\\\n101\\\\\\\\\\\\\\\\t                          :source {:type :stream/make :buffer 1}}}\\\\\\\\\\\\\\\\n102\\\\\\\\\\\\\\\\t        ast (tails/remark-tails\\\\\\\\\\\\\\\\n103\\\\\\\\\\\\\\\\t              (update-in lowered [:operator :body :operands 0 :body]\\\\\\\\\\\\\\\\n104\\\\\\\\\\\\\\\\t                         u/then blocker))\\\\\\\\\\\\\\\\n105\\\\\\\\\\\\\\\\t        blocked ((get final-vms k) ast (vm/ast->datoms ast))]\\\\\\\\\\\\\\\\n106\\\\\\\\\\\\\\\\t    (when (is (vm/blocked? blocked) (str k \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" blocked before shutdown\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"))\\\\\\\\\\\\\\\\n107\\\\\\\\\\\\\\\\t      (let [roots (into []\\\\\\\\\\\\\\\\n108\\\\\\\\\\\\\\\\t                        (keep (fn [[id {:keys [value seal]}]]\\\\\\\\\\\\\\\\n109\\\\\\\\\\\\\\\\t                                (when (and (= \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"h\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" (get-in value [:gen :name]))\\\\\\\\\\\\\\\\n110\\\\\\\\\\\\\\\\t                                           (= :suspended (get-in value [:gen :state])))\\\\\\\\\\\\\\\\n111\\\\\\\\\\\\\\\\t                                  {:type :cell-ref :id id :seal seal})))\\\\\\\\\\\\\\\\n112\\\\\\\\\\\\\\\\t                        (:heap blocked))]\\\\\\\\\\\\\\\\n113\\\\\\\\\\\\\\\\t        (when (is (= 1 (count roots)) (str k \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" one suspended delegating generator\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"))\\\\\\\\\\\\\\\\n114\\\\\\\\\\\\\\\\t          (let [heap (:heap (engine/collect blocked roots))]\\\\\\\\\\\\\\\\n115\\\\\\\\\\\\\\\\t            [(count heap)\\\\\\\\\\\\\\\\n116\\\\\\\\\\\\\\\\t             (deep-size (mapv :value (vals heap)))]))))))\\\\\\\\\\\\\\\\n117\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n118\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n119\\\\\\\\\\\\\\\\t(defn- changing-caller-source\\\\\\\\\\\\\\\\n120\\\\\\\\\\\\\\\\t  [n]\\\\\\\\\\\\\\\\n121\\\\\\\\\\\\\\\\t  (str \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"<?php function g() { $i=0; while (true) { yield $i; $i++; } }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n122\\\\\\\\\\\\\\\\t       ;; Own the delegate across caller statements, whose temporary cleanup\\\\\\\\\\\\\\\\n123\\\\\\\\\\\\\\\\t       ;; would otherwise release the bare g() result while h is suspended.\\\\\\\\\\\\\\\\n124\\\\\\\\\\\\\\\\t       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" function h() { $d=g(); yield from $d; } $it=h(); $it->self=$it;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n125\\\\\\\\\\\\\\\\t       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" function byFunction($x) { $x->next(); }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n126\\\\\\\\\\\\\\\\t       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" function byGenerator($x) { yield $x->current(); $x->next(); }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n127\\\\\\\\\\\\\\\\t       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" $k=0; while ($k < \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" n \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") {\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n128\\\\\\\\\\\\\\\\t       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" if ($k % 2 == 0) { byFunction($it); }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n129\\\\\\\\\\\\\\\\t       \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" else { $j=byGenerator($it); $j->current(); $j->next(); } $k++; }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"))\\\\\\\\\\\\\\\\n130\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n131\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\n132\\\\\\\\\\\\\\\\t(deftest ^:slow reachable-heap-is-stable-under-delegation-test\\\\\\\\\\\\\\\\n133\\\\\\\\\\\\\\\\t  (doseq [k vms]\\\\\\\\\\\\\\\\n134\\\\\\\\\\\\\\\\t    (testing (str k)\\\\\\\\\\\\\\\\n135\\\\\\\\\\\\\\\\t      (let [small (live-after-collection k (changing-caller-source 10))\\\\\\\\\\\\\\\\n136\\\\\\\\\\\\\\\\t            large (live-after-collection k (changing-caller-source 1000))]\\\\\\\\\\\\\\\\n137\\\\\\\\\\\\\\\\t        (when (and small large)\\\\\\\\\\\\\\\\n138\\\\\\\\\\\\\\\\t          (is (= small large)))))))\\\\\\\\\\\\\\\"}\\\\\\\\n{\\\\\\\\\\\\\\\"role\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"tool_call_id\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"tool_Ea8ix43e4V4o7klpV2NKTdHV\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"content\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"docs/design/dao.jing.remote.implementation-plan.md:29:explicit release. Retaining timed-out requests leaked payloads for nothing;\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:34:§5.2 #6 asserted a connect-timeout cleanup the transport does not perform.\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:247:| S2 | `stop!` detaches every session, releases the listener, stops the ticker; idempotent | `[D]` **new** |\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:333:`jing-coordinate/open!` failing before a store is retained (its P5 cleanup\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:668:   completing it releases the second in submission order.\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:858:3. `request-timeout-retires-the-call-and-the-client-recovers-once-released`\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:887:   because that is all the transport guarantees (N2)**: no cleanup claim, no\\\\\\\\\\\\\\\\ndocs/design/dao.jing.remote.implementation-plan.md:898:   handle)` is true, a second `jing/close!` is a no-op; release the latch.\\\\\\\\\\\\\\\\ndocs/design/dao.star.md:100:**The lineage is leased** (owner ruling 2026-10-07; the holder choice below is the architect's). A lineage nobody returns to is reclaimed through `dao.lease.md`, not by a timer. The peer holding the parked record is the grantor. When a lineage begins, its judge grants unsolicited on the lease medium: subject and holder `{:dao.star/lineage S}`, duration the composition's idle allowance, `:dao.lease/max` optional. Attribution is by envelope key: the session-facts medium is written only by session drivers, each stamping `:dao.star/lineage` on its facts, renewals and release, and the judge's resolver reads that key; until ShiBi, any writer of that medium can renew, the same exposure the exchange lease has. The driver observes its grant before consuming or projecting, renews at under half the duration from its own control flow, on each consumed input and on its tick while it holds an open subscription, and **stops at its bound**: past it, it consumes nothing and projects nothing, and an input arriving then is handed to the root program as begin. So a connected session is retained for as long as it stays connected, by design, bounded only by the cap; a disconnected one lapses after the idle allowance. The lease ends with the lineage: released by the driver on halt, lapsed by the judge on silence. Reclaim retires the runnable resource, the current parked record; the `:lapsed` record on the lease medium is the judge's own and is what ends the lineage for the router. History, successor facts and lease records are kept (`dao.lease.md`: a reclaim frees the resource, never the record). The subject is distinct from Mode 2's custody subject `{:yin.k/occurrence O}` on the arbitration medium. Leases are process-scoped until the composition settles the three durable duties `dao.lease.md` names.\\\\\\\\\\\\\\\\ndocs/design/dao.agent.harness.md:204:that the seat releases the claim (`:claim/status :released`) and the\\\\\\\\\\\\\\\\ndocs/design/dao.agent.harness.md:246:|             |               | :claim/status :released              |\\\\\\\\\\\\\\\\ndocs/design/dao.jing.cbor.md:76:latest release on 2026-09-16 against\\\\\\\\\\\\\\\\ndocs/design/dao.jing.cbor.md:80:preserves released tag meanings and older-output readability, but does not\\\\\\\\\\\\\\\\ndocs/design/dao.jing.cbor.md:81:promise identical encoding bytes across releases (verified against that\\\\\\\\\\\\\\\\ndocs/design/dao.space.v0.md:1307:7. **Explicit Over Implicit** — No hidden expiration, no automatic cleanup, no magic. Application logic drives coordination policy.\\\\\\\\\\\\\\\\ndocs/design/yin.vm.debruijn.stack.md:1033:- A named-VM environment-leak fix design, which owns D4's release condition.\\\\\\\\\\\\\\\\ndocs/de