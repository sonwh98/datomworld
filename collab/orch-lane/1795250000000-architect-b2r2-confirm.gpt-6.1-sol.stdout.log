   (throw (ex-info \"PHP harness memory-log creation failed\" {:result result})))))\n    62\t\n    63\t\n    64\t(defn- drain\n    65\t  [handle]\n    66\t  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\n    67\t                      [:dao.stream/cursor])]\n    68\t    (loop [cursor start, acc []]\n    69\t      (let [result (stream/next handle cursor)]\n    70\t        (if (= :dao.stream/ok (:dao.stream/outcome result))\n    71\t          (recur (:dao.stream/cursor result)\n    72\t                 (conj acc (:dao.stream/value result)))\n    73\t          acc)))))\n    74\t\n    75\t\n    76\t(def integer-limits\n    77\t  \"The `integer` limits the PHP compositions here install.\"\n    78\t  {::integer/max-bits 100000, ::integer/max-digits 4300})\n    79\t\n    80\t\n    81\t(def data-limits {::data/max-items 1048576})\n    82\t\n    83\t\n    84\t(defn host-registry\n    85\t  \"The registry with the cell, data and integer modules installed, admitted\n    86\t   by the PHP profile.\"\n    87\t  []\n    88\t  (-> (module/empty-registry)\n    89\t      module/register-cell-module\n    90\t      (data/register-data-module data-limits)\n    91\t      (prelude/register-integer-module integer-limits)\n    92\t      prelude/admit))\n    93\t\n    94\t\n    95\t(defn linked-registry\n    96\t  \"`host-registry` over the default registry, whose `require` handlers the\n    97\t   linked profile needs.\"\n    98\t  []\n    99\t  (-> (module/default-registry)\n   100\t      module/register-cell-module\n   101\t      (data/register-data-module data-limits)\n   102\t      (prelude/register-integer-module integer-limits)\n   103\t      prelude/admit))\n   104\t\n   105\t\n   106\t(defn packet\n   107\t  \"A CST packet from a nested form: `[rule child ...]` for a rule (a keyword)\n   108\t   and `[type text]` (type a string) for a token. Spans are zero-width: the\n   109\t   lowering reads them only for diagnostics. Ids are preorder, as the parser\n   110\t   n