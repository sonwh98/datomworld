"QWQW\"}] response))\n    54\t      (is (= [] diag))\n    55\t      (is (= response (:php/response value)))\n    56\t      (is (= diag (:php/diag value)))\n    57\t      (is (= \"QWQW\" (:php/out value)))\n    58\t      (is (= \"QWQW\" (:php/out (h/run-raw source request))))))\n    59\t  (testing \"diagnostic records are emitted on the diagnostics stream\"\n    60\t    (let [source \"<?php trigger_error('boom', E_USER_NOTICE); echo 'done';\"\n    61\t          {:keys [value response diag]}\n    62\t          (ph/run-lifecycle-raw (cst/parse-source source) p5b2/base-request)]\n    63\t      (is (= [[1024 \"boom\"]] (mapv (juxt :errno :message) diag)))\n    64\t      (is (= diag (:php/diag value)))\n    65\t      (is (= [{:php.response/body \"done\"}] response))))\n    66\t  (testing \"response records keep header-then-body emission order on the stream\"\n    67\t    (let [source \"<?php header('X-A: 1'); echo 'hi';\"\n    68\t          {:keys [value response diag]}\n    69\t          (ph/run-lifecycle-raw (cst/parse-source source) p5b2/base-request)]\n    70\t      (is (= [] diag))\n    71\t      (is (= response (:php/response value)))\n    72\t      (is (= \"X-A: 1\" (:php.response/header (first response))))\n    73\t      (is (= {:php.response/body \"hi\"} (last response)))))\n    74\t  (testing \"a nil request keeps the empty defaults through the streams\"\n    75\t    (let [{:keys [value response diag] :as lifecycle}\n    76\t          (ph/run-lifecycle-raw (cst/parse-source \"<?php echo 'none';\") nil)]\n    77\t      (is (nil? (:request lifecycle)))\n    78\t      (is (= [{:php.response/body \"none\"}] response))\n    79\t      (is (= [] diag))\n    80\t      (is (= \"none\" (:php/out value))))))\n    81\t\n    82\t\n    83\t(defn- linked-out\n    84\t  [source request]\n    85\t  (let [{:keys [values]} (lh/run-fixture {\"main.php\" (cst/parse-source source)}\n    86\t                                         \"main.php\"\n    87\t                                         {:request request})]\n    88\t    (into {} (map (fn [[k v]] [k (:php/out v)]) values))))\n    89\t\n    90\t\n    91\t(deftest linked-profile-consumes-request-and-isolates-test\n    92\t  (testing \"the :linked entry point takes the request operand too\"\n    93\t    (let [r (linked-out \"<?php echo $_GET['v'], $_REQUEST['w'];\"\n    94\t                        (assoc p5b2/base-request\n    95\t                               :php.request/query (p5b2/request-array [[\"v\" \"Q\"]])\n    96\t                               :php.request/body (p5b2/request-array [[\"w\" \"W\"]])))]\n    97\t      (is (= {:semantic \"QW\", :stack \"QW\", :register \"QW\"} r))))\n    98\t  (testing \"sequential linked runs do not leak request state\"\n    99\t    (let [src \"<?php echo $_GET['v'];\"\n   100\t          q (fn [v]\n   101\t              (assoc p5b2/base-request\n   102\t                     :php.request/query (p5b2/request-array [[\"v\" v]])))]\n   103\t      (is (= {:semantic \"one\", :stack \"one\", :register \"one\"} (linked-out src (q \"one\"))))\n   104\t      (is (= {:semantic \"two\", :stack \"two\", :register \"two\"} (linked-out src (q \"two\"))))))\n   105\t  (testing \"no live request cell is a module export\"\n   106\t    (is (not (contains? prelude/module-exports 'rt/request)))\n   107\t    (is (not (contains? prelude/module-exports 'rt/response)))\n   108\t    (is (not (contains? prelude/module-exports 'rt/out)))\n   109\t    (is (not (contains? prelude/module-exports 'rt/diag)))))\n","exit_code":0,"status":"completed"}}
