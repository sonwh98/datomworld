w-memory-log)\n   153\t         program (new-memory-log)\n   154\t         diagnostics (new-memory-log)]\n   155\t     (stream/append! cst-log pk)\n   156\t     (lower/step-stage (lower/open-stage cst-log program diagnostics\n   157\t                                         (cond-> {:medium lower/program-medium}\n   158\t                                           (some? request) (assoc :request request))))\n   159\t     (let [{warnings true, problems false}\n   160\t           (group-by #(= :warning (:severity %)) (drain diagnostics))]\n   161\t       (if (seq problems)\n   162\t         {:diagnostics problems}\n   163\t         (let [{:yin/keys [batch root]} (first (drain program))]\n   164\t           {:ast (nth batch root), :warnings (vec warnings)}))))))\n   165\t\n   166\t\n   167\t(defn run-packet-raw\n   168\t  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, of packet `pk` on\n   169\t   the AST walker, or `{:diagnostics d}`.\"\n   170\t  ([pk] (run-packet-raw pk nil))\n   171\t  ([pk request]\n   172\t   (let [{:keys [ast diagnostics]} (lower-through-stage pk request)]\n   173\t     (if diagnostics\n   174\t       {:diagnostics diagnostics}\n   175\t       (vm/value (vm/eval (create-vm {:modules (host-registry)}) ast))))))\n   176\t\n   177\t\n   178\t(defn- consume-one\n   179\t  \"The single value appended to `handle`, read back through a fresh oldest\n   180\t   cursor: real stream consumption, not a vector pass.\"\n   181\t  [handle]\n   182\t  (let [start (:dao.stream/cursor (check-ok! (stream/cursor handle stream/anchor-oldest)\n   183\t                                             \"request cursor\"))\n   184\t        result (check-ok! (stream/next handle start) \"request read\")]\n   185\t    (:dao.stream/value result)))\n   186\t\n   187\t\n   188\t(defn- emit-all!\n   189\t  \"Every record of `records` appended to the composition-supplied `handle`:\n   190\t   real stream emission, then drained back by the caller.\"\n   191\t  [handle records what]\n   192\t  (doseq [record records]\n   193\t    (check-ok! (stream/append! handle record) what)))\n   194\t\n   195\t\n   196\t(defn run-lifecycle-raw\n   197\t  \"The full request/response/diagnostics lifecycle for packet `pk` over\n   198\t   composition-supplied streams: `request` (nil keeps the empty defaults) is\n   199\t   appended to the request stream and consumed back from it; the consumed\n   200\t   record rides the composition path as `run-main`'s second operand; the run's\n   201\t   response and diagnostic records are emitted on the response and diagnostics\n   202\t   streams. Returns `{:value v :request consumed :response [...] :diag [...]}`,\n   203\t   the drained streams, or `{:diagnostics d}` when lowering refuses.\"\n   204\t  [pk request]\n   205\t  (let [request-stream (lifecycle-stream \"request create\")\n   206\t        response-stream (lifecycle-stream \"response create\")\n   207\t        diagnostics-stream (lifecycle-stream \"diagnostics create\")]\n   208\t    (when (some? request)\n   209\t      (check-ok! (stream/append! request-stream request) \"request append\"))\n   210\t    (let [consumed (if (some? request) (consume-one request-stream) nil)\n   211\t          {:keys [ast diagnostics]} (lower-through-stage pk consumed)]\n   212\t      (if diagnostics\n   213\t        {:diagnostics diagnostics}\n   214\t        (let [v (vm/value (vm/eval (create-vm {:modules (host-registry)}) ast))]\n   215\t          (emit-all! response-stream (:php/response v) \"response append\")\n   216\t          (emit-all! diagnostics-stream (:php/diag v) \"diagnostics append\")\n   217\t          {:value v,\n   218\t           :request consumed,\n   219\t           :response (drain response-stream),\n   220\t           :diag (drain diagnostics-stream)})))))\n   221\t\n   222\t\n   223\t(defn run-packet\n   224\t  \"The rendered output of packet `pk` on the AST walker, or its diagnostics.\"\n   225\t  [pk]\n   226\t  (let [r (run-packet-raw pk)]\n  