{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,62p' /Users/sto/workspace/datomworld-b2/test/yang/php/antlr/prelude_test.cljc; head -c 1000 /Users/sto/workspace/datomworld-b2/.cpcache/3644903311.cp; rg -n 'sexp->uast|vm/eval|prelude/uast' /Users/sto/workspace/datomworld-b2/test/yang/php/antlr/prelude_test.cljc | head -15; rg -n 'Antlr|jar|build/antlr' /Users/sto/workspace/datomworld-b2/deps.edn; ls /Users/sto/workspace/datomworld-b2/build/antlr/php\"","aggregated_output":"(ns yang.php.antlr.prelude-test\n  \"The PHP prelude's static contract on every host: the bundled program is\n   closed over its own definitions, the declared host names and the\n   primitives; it never reaches `dao.host.*`; the lowered program names no\n   runtime key; the module emitter's exports and manifest cover the same\n   list.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.walk :as walk]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.portable-harness :as h]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]))\n\n\n(def ^:private closed-names\n  (into (conj (prelude/defined-keys prelude/uast) 'yin/def)\n        (concat prelude/host-names (keys vm/primitives))))\n\n\n(deftest bundled-prelude-is-closed-test\n  (is (empty? (remove closed-names (prelude/free-names prelude/uast)))))\n\n\n(deftest prelude-reaches-no-dao-host-test\n  (is (not-any? #(str/starts-with? (str %) \"dao.host\") (prelude/free-names prelude/uast)))\n  (is (every? #(contains? #{\"cell\" \"data\" \"integer\"} (namespace %))\n              prelude/host-names)))\n\n\n(deftest lowered-program-names-no-runtime-key-test\n  (doseq [[id form] packets/forms\n          :let [free (prelude/free-names (lower/lower-module-body (h/packet form)))]]\n    (is (empty? (remove closed-names free)) (name id))\n    (is (not-any? #(= \"php.rt\" (namespace %)) free) (name id))))\n\n\n(deftest module-exports-cover-the-definitions-test\n  (is (contains? prelude/module-exports 'init!))\n  (is (contains? prelude/module-exports 'echo))\n  (is (not-any? #(= \"php.rt\" (namespace %)) prelude/module-exports))\n  (is (every? symbol? prelude/runtime-keys)))\n\n\n(deftest admit-refuses-a-registry-without-the-host-names-test\n  (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs ExceptionInfo :cljd Object)\n        (prelude/admit {}))))\n\n\n(deftest module-spec-declares-every-free-name-test\n  (testing \"over the real host registry the manifest builds, or refuses\"\n    (let [spec (prelude/module-spec (h/host-registry) :test/call-address)]\n      (is (= 'php (:name spec)))\n      (is (= prelude/module-exports (:exports spec)))\n      (is (= {'yang.call :test/call-address} (:requires spec)))\n      (is (every? (:primitives spec) (filter #(= \"integer\" (namespace %)) prelude/host-names))))))\n\n\n(deftest static-slot-initializes-once-when-first-reached-test\ntest:src/clj:src/cljc:src/cljs:src/cljd:build/antlr/python3/classes:build/antlr/php/classes:build/antlr/typescript/classes:/Users/sto/.m2/repository/com/cognitect/transit-clj/1.0.333/transit-clj-1.0.333.jar:/Users/sto/.m2/repository/com/datomic/peer/1.0.7364/peer-1.0.7364.jar:/Users/sto/.m2/repository/criterium/criterium/0.4.6/criterium-0.4.6.jar:/Users/sto/.m2/repository/http-kit/http-kit/2.8.0/http-kit-2.8.0.jar:/Users/sto/.m2/repository/instaparse/instaparse/1.5.0/instaparse-1.5.0.jar:/Users/sto/.gitlibs/libs/io.github.cognitect-labs/test-runner/dfb30dd6605cb6c0efc275e1df1736f6e90d4d73/src:/Users/sto/.m2/repository/io/github/rctcwyvrn/blake3/1.3/blake3-1.3.jar:/Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/src:/Users/sto/.m2/repository/org/antlr/antlr4-runtime/4.13.2/antlr4-runtime-4.13.2.jar:/Users/sto/.m2/repository/org/clojure/clojure/1.12.4/clojure-1.12.4.jar:/Users/sto/.m2/repository/org/clojure/cor