g/latte_oracle_test.clj:994:    (walk/postwalk\ntest/yang/latte_oracle_test.clj:1103:          c (context-bc [] (walk/postwalk-replace {'K initial-context} guest-call))]\ntest/yang/cross_lang_test.clj:10:   running the donor program with its `run-main` replaced so the program's\ntest/yang/cross_lang_test.clj:54:(defn- donor\ntest/yang/cross_lang_test.clj:55:  \"The AST whose value is the function value of the donor program: the\ntest/yang/cross_lang_test.clj:60:    (assert fn-node (str \"no \" make-fn \" node in the donor\"))\ntest/yang/cross_lang_test.clj:93:  \"`receiver` with `v-name` bound to the value of `donor-ast`.\"\ntest/yang/cross_lang_test.clj:94:  [donor-ast v-name receiver]\ntest/yang/cross_lang_test.clj:97:   :operands [donor-ast]})\ntest/yang/cross_lang_test.clj:114:  (let [fn-ast (donor (lowered-ts ts-src) 'js/run-main 'js/make-function\ntest/yang/cross_lang_test.clj:116:        php-ast (walk/postwalk\ntest/yang/cross_lang_test.clj:129:  (let [fn-ast (donor (lowered-php php-src) 'php/run-main 'php/make-function [])\ntest/yang/cross_lang_test.clj:130:        ts-ast (walk/postwalk\ntest/yang/typescript/antlr/prelude_parity_test.cljc:106:  (walk/postwalk (fn [x] (if (marker? x) (cbor/float64 (special (:n x))) x))\ntest/yang/clojure_test.clj:1056:  (let [form (walk/postwalk-replace\ntest/yang/clojure_test.clj:1067:  (walk/postwalk\ntest/yang/typescript/antlr/object_parity_test.cljc:20:  (walk/postwalk\ntest/yang/typescript/antlr/prelude_test.cljc:29:  (walk/postwalk\ntest/yang/python/antlr/int_conv_test.cljc:369:    (walk/postwalk\ntest/yang/python/antlr/int_conv_test.cljc:466:    (walk/postwalk\ntest/yang/python/antlr/int_ops_test.cljc:99:  (walk/postwalk\ntest/yang/python/antlr/int_ops_test.cljc:113:  (walk/postwalk (fn [x]\ntest/yang/python/antlr/int_ops_test.cljc:127:  (walk/postwalk (fn [n]\ntest/yang/python/antlr/int_ops_test.cljc:143:  (walk/postwalk\ntest/yang/python/antlr/prelude_parity_test.cljc:110:  (walk/postwalk (fn [x]\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` (G3) is the mandatory landing gate on master after merge.\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n# overlap lanes, see \"Remote test servers\" below).\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\nnpm test             # Node.js tests\n\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n                         # and the linker L5 Node reader that requires a module\n                         # by name): `clojure -M:test` without it fails that test\n```\n\n### Changed-only tests: `bb test:changed`\n\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\nreach: the reverse require closure of the files changed since the\nmerge-base with master, plus fixtures that mention a changed resource path,\ntests that walk a changed tree, and each src file's `_test` by convention.\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\nfs/walk-file-tree or .listFiles; each string literal argument of its\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\n(let-bound roots count), and a change under a root selects it. The three\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\nland a slice confined to a package. Exit 2 (from :list too) is a wide\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\nas for a change to the core everything requires (yin.vm engine,\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\nand spawned programs that changed (target/yin-repl.js, Dart peers).\n\n### Sharded quick JVM feedback and change routing\n\n```sh\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\nbb test:routed                                 # Git change set, same base as test:changed\nbb deps:npm                                    # Content-checked local npm ci\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\n```\n\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\nthe JVM portion of G3. Without selection flags it selects every JVM test;\n`--changed FILE...` or `--base REF` uses `affected/select` and\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\nsemantics. `--workers N` must be positive (default 4 on the laptop).\n\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\n`affected/select-subsystems` and the same longest-prefix ownership rule as\n`test:sub`. As in the shiva script below, currently unowned namespaces run\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\nPrerequisites are derived from the entire selected JVM reach and finish\nserially before workers start; the Node REPL build prerequisite\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\n\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\nand `summary.edn`. Before execution it checks **set equality** between selected\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\nThe final summary totals tests, assertions, failures and errors and separates\nJVM wall time from total time including selection/builds. A nonzero child exit,\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\nDry plans write namespace evidence but execute no builds or tests. An empty\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\n\n`test:routed <changed-files...>` applies this priority table to the whole change\nset, prints the exact dispatch, executes it and propagates its result:\n\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Change class (first match wins)                                                              | Dispatch                                                              |\n+==============================================================================================+=======================================================================+\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\n|                                                                                              | lint only                                                             |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\n|                                                                                              | selection                                                             |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n\nMixed changes take the widest matching route. Missing paths, an empty git change\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\nits zero exit is **not** a verification result. Documentation checks inspect\nstaged and unstaged changes together against HEAD. Paths absent from\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\nexecutable examples or validate documentation links.\n\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\nmeans the dispatched gate completed successfully, not that every landing gate\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\nand failed dispatches. Successful checked docs, selected tri-host, and full\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\nresults, so automation must inspect the scope as well as the exit code.\n\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\ntri-host success: for foundation/compiler changes also run\n`bb test:changed:cljs --changed <paths>` and\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\ndemo smoke checks and review/landing gates all remain required. Node and Dart\nlanes retain their current commands. The original unsharded tasks remain\navailable. Do not run another lane set concurrently on the laptop.\n\n#### Worktree-local prerequisite caches\n\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\nrecorded helper/generated digests and runtime pins), the generator/cache source,\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\nremoved or corrupted outputs trigger a full generation, retaining the generator's\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\ninvalidate the complete-build stamp.\n\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\nenvironment and worktree identity; it verifies the installed file tree before\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\nensure this dependency too. Direct `npm ci` is still available.\n\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\nlock only after confirming its owning process died. Symlinked output parents\nthat escape the worktree are refused. This is reuse **within one worktree**,\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\nstill require the existing worktree isolation/serialization rules; the cache\ndoes not make overlapping builds and tests safe. Peer executables and shadow\nbuilds themselves are not cached by this mechanism.\n\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\nouter command **258.27 s**). The original `test:changed:clj` command completed\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' test/yang/php/antlr/e2e_test.clj && sed -n '1,175p' test/yang/cross_lang_test.clj && cat deps.edn | rg -n -C 3 'test|Xss'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' test/yang/php/antlr/e2e_test.clj && sed -n '1,175p' test/yang/cross_lang_test.clj && cat deps.edn | rg -n -C 3 'test|Xss'\"","aggregated_output":"(ns yang.php.antlr.e2e-test\n  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n   envelope -> the bundled program on each of the four VMs (the AST walker,\n   the semantic, stack and register VMs). Every fixture of\n   `yang.php.antlr.programs` prints the same text on all four.\"\n  (:require\n    [clojure.walk :as walk]\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.uast :as u]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.packets-p3b :as packets-p3b]\n    [yang.php.antlr.permutations :as perms]\n    [yang.php.antlr.phpt :as phpt]\n    [yang.php.antlr.programs :as programs]\n    [yang.php.antlr.programs-p3b :as p3b]\n    [yang.typescript.antlr.e2e-test :as ts]\n    [yin.vm :as vm]\n    [yin.vm.test-utils :as tu]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(defn- rendered\n  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n  [{:keys [out uncaught]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(deftest ^:slow fixtures-on-every-vm-test\n  (doseq [{:keys [id source] :as fixture} programs/fixtures\n          :let [out (rendered fixture)]]\n    (testing (name id)\n      (let [results (h/run-php source)]\n        (is (not (contains? results :diagnostics)) (pr-str results))\n        (doseq [k vms]\n          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n\n\n(deftest fixtures-on-the-walker-test\n  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n          :let [r (h/run-raw source)]]\n    (is (not= :pending oracle) (name id))\n    (is (= out (h/latin1->text (:php/out r))) (name id))\n    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n        (name id))))\n\n\n(defn- app?\n  [node op]\n  (and (map? node)\n       (= :application (:type node))\n       (= {:type :variable, :name op} (:operator node))))\n\n\n(defn- lowered-ts\n  [source]\n  (let [{:keys [program diagnostics]} (ts/lower-source source :bundled)]\n    (assert (nil? diagnostics) (pr-str diagnostics))\n    (let [{:yin/keys [batch root]} program]\n      (nth batch root))))\n\n\n(defn- export-projection\n  \"The donor program followed by its explicitly named global export read.\"\n  [donor export-name]\n  (u/then donor (u/sexp->uast (list 'js/global-get {:js/str export-name}))))\n\n\n(defn- install-php-function-export\n  \"Project `%foreign` into PHP's function namespace before the source body.\n   The lowered PHP call and its resolve/call nodes remain untouched.\"\n  [ast export-name]\n  (let [projection (u/sexp->uast\n                     (list 'cell/set! 'php.rt/functions\n                           (list 'assoc\n                                 '(cell/get php.rt/functions)\n                                 export-name\n                                 '%foreign)))\n        seen (volatile! false)\n        result (walk/postwalk\n                 (fn [node]\n                   (if (app? node 'php/run-main)\n                     (let [body (first (:operands node))]\n                       (assert (= :lambda (:type body)) \"php/run-main body is not a lambda\")\n                       (vreset! seen true)\n                       (assoc node :operands [(update body :body #(u/then projection %))]))\n                     node))\n                 ast)]\n    (assert @seen \"PHP program has no php/run-main application\")\n    result))\n\n\n(defn- run-with-ts-export\n  [donor-source export-name php-source]\n  (let [donor (lowered-ts donor-source)\n        {:keys [ast diagnostics]} (h/lower-program php-source)\n        _ (assert (nil? diagnostics) (pr-str diagnostics))\n        php-ast (install-php-function-export ast export-name)\n        composition {:type :application,\n                     :operator {:type :lambda,\n                                :params ['%foreign],\n                                :body php-ast},\n                     :operands [(export-projection donor export-name)]}\n        result (vm/value (vm/eval (tu/create-vm {:modules (php-h/host-registry)})\n                                  composition))]\n    (h/render result)))\n\n\n(defn- run-with-ts-global\n  \"Project `%foreign` into a PHP global before the unmodified source body.\"\n  [donor-source export-name php-global php-source]\n  (let [donor (lowered-ts donor-source)\n        {:keys [ast diagnostics]} (h/lower-program php-source)\n        _ (assert (nil? diagnostics) (pr-str diagnostics))\n        global-projection (u/sexp->uast\n                            (list 'php/global-store! php-global '%foreign))\n        seen (volatile! false)\n        php-ast (walk/postwalk\n                  (fn [node]\n                    (if (app? node 'php/run-main)\n                      (let [body (first (:operands node))]\n                        (assert (= :lambda (:type body)) \"php/run-main body is not a lambda\")\n                        (vreset! seen true)\n                        (assoc node :operands [(update body :body #(u/then global-projection %))]))\n                      node))\n                  ast)\n        _ (assert @seen \"PHP program has no php/run-main application\")\n        composition {:type :application,\n                     :operator {:type :lambda,\n                                :params ['%foreign],\n                                :body php-ast},\n                     :operands [(export-projection donor export-name)]}\n        result (vm/value (vm/eval (tu/create-vm {:modules (php-h/host-registry)})\n                                  composition))]\n    (h/render result)))\n\n\n(deftest real-lowered-ts-export-called-from-php-test\n  (testing \"unmodified PHP source calls a published TS global export through yang.call\"\n    (is (= \"4\"\n           (run-with-ts-export\n             \"globalThis.donor = (x, y) => x + y;\"\n             \"donor\"\n             \"<?php echo donor(1.5, 2.5);\")))))\n\n\n(deftest real-lowered-ts-callback-called-from-php-test\n  (testing \"PHP stores a foreign function cell in an array, invokes it, and keeps its identity\"\n    (is (= \"same\"\n           (run-with-ts-global\n             \"globalThis.donor = () => { globalThis.called = true; };\"\n             \"donor\"\n             \"cb\"\n             \"<?php $items = [$cb]; $items[0](); echo ($items[0] === $cb ? 'same' : 'different');\")))))\n\n\n(deftest real-lowered-php-callback-round-trip-test\n  (testing \"TS stores and calls the received PHP closure, then returns the same cell\"\n    (is (= \"calledsame\"\n           (run-with-ts-export\n             (str \"globalThis.accept = (f) => {\"\n                  \" globalThis.stored = f;\"\n                  \" globalThis.stored(7);\"\n                  \" return globalThis.stored;\"\n                  \"};\")\n             \"accept\"\n             (str \"<?php $cb = function($x) {\"\n                  \" echo 'called'; return $x + 1;\"\n                  \"};\"\n                  \"$returned = accept($cb);\"\n                  \"echo ($returned === $cb ? 'same' : 'different');\"))))))\n\n\n(deftest packets-match-source-test\n  (doseq [[id form] packets/forms\n          :let [{:keys [source]} (first (filter #(= id (:id %)) programs/fixtures))]]\n    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\n\n\n(defn- matrix-rows\n  [out]\n  (let [[eq sp] (str/split-lines out)\n        w (count programs/matrix-values)]\n    {:eq (mapv #(apply str %) (partition w eq)),\n     :sp (mapv #(apply str (map {\\0 \"<\", \\1 \"=\", \\2 \">\"} %)) (partition w sp))}))\n\n\n(deftest scalar-comparison-matrix-test\n  (let [{:keys [eq sp]} (matrix-rows (h/run-walker programs/matrix-source))]\n    (is (= programs/equal-matrix eq))\n    (is (= programs/spaceship-matrix sp))\n    (testing \"cells reasoned from the manual, independent of the golden\"\n      (let [idx (zipmap programs/matrix-values (range))]\n        (doseq [[a b eq? cmp] programs/known-cells\n                :let [i (idx a), j (idx b)]]\n          (is (= (if eq? \\1 \\0) (get-in eq [i j])) (str a \" == \" b))\n          (is (= (get {-1 \\<, 0 \\=, 1 \\>} cmp) (get-in sp [i j])) (str a \" <=> \" b)))))))\n\n\n(deftest float-text-test\n  (let [src (str \"<?php\\n\"\n                 (apply str (for [[lit] programs/float-cases]\n                              (str \"echo \" lit \", \\\"|\\\"; var_dump(\" lit \");\\n\"))))\n        expected (str (apply str (for [[_ echo dump] programs/float-cases]\n                                   (str echo \"|float(\" dump \")\\n\"))))]\n    (is (= expected (h/run-walker src)))))\n\n\n(deftest refusals-are-named-test\n  (doseq [[source construct]\n          [[\"<?php $a = &f();\" :reference-source]\n           [\"<?php $$a[0] = 1;\" :assignment-target]\n           [\"<?php function f(int ...$a) {}\" :typed-variadic]\n           [\"<?php function f(&...$a) {}\" :variadic-reference]\n           [\"<?php $a = &new B;\" :reference]\n           [\"<?php static $a = 1;\" :static]\n           [\"<?php echo FOO;\" :constant]\n           [\"<?php echo \\\"a$b[0]\\\";\" :interpolation]\n           [\"<?php echo \\\"a$b->c\\\";\" :interpolation]\n           [\"<?php echo (array)1;\" :cast/array]\n(ns yang.cross-lang-test\n  \"The substrate claim, empirically (yang.antlr.md 8.10/8.11): both preludes\n   bottom out in `:application`, and the engine neither knows nor cares which\n   frontend minted a closure. A TypeScript function value is called from\n   PHP-lowered code and a PHP closure from TypeScript-lowered code, in one\n   VM, one run.\n\n   The seam is the lowered tree, not a prelude change. Each direction lowers\n   a program normally, then (1) extracts the foreign function value by\n   running the donor program with its `run-main` replaced so the program's\n   value IS the function (`js/make-function` cell, `php/make-function` cell),\n   and (2) binds that value to a free variable of the receiver, replacing the\n   receiver's lookup node (`php/resolve-fn` of a name; `js/global-get` of a\n   name) by that variable. Both function values are cells whose `:code` is\n   called with a receiver slot and an argument vector, so the callee needs no\n   knowledge of the caller's prelude.\n\n   What is pinned as LIMITS (documented expectations, not failures):\n   a PHP array reaching TypeScript is an opaque handle that only PHP can use;\n   PHP null (`:php/null`) is neither JS null nor undefined. The JVM lane runs\n   the AST walker only.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [clojure.walk :as walk]\n    [yang.php.antlr.e2e-harness :as php]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.typescript.antlr.e2e-test :as ts]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn- app?\n  [node op]\n  (and (map? node)\n       (= :application (:type node))\n       (= {:type :variable, :name op} (:operator node))))\n\n\n(defn- find-node\n  \"The first node of `tree` satisfying `pred`, preorder.\"\n  [pred tree]\n  (let [hit (volatile! nil)]\n    (walk/prewalk (fn [n] (when (and (nil? @hit) (pred n)) (vreset! hit n)) n)\n                  tree)\n    @hit))\n\n\n(defn- var-node\n  [name]\n  {:type :variable, :name name})\n\n\n(defn- donor\n  \"The AST whose value is the function value of the donor program: the\n   `run-main` application becomes a call of its body, which is replaced by\n   the first function-making node (`make-fn`) of the program.\"\n  [ast run-main make-fn body-args]\n  (let [fn-node (find-node #(app? % make-fn) ast)]\n    (assert fn-node (str \"no \" make-fn \" node in the donor\"))\n    (walk/prewalk\n      (fn [n]\n        (if (app? n run-main)\n          {:type :application,\n           :operator {:type :lambda,\n                      :params ['%body],\n                      :body {:type :application,\n                             :operator (var-node '%body),\n                             :operands body-args}},\n           :operands [{:type :lambda,\n                       :params (if (= make-fn 'js/make-function) ['%0] []),\n                       :body fn-node}]}\n          n))\n      ast)))\n\n\n(defn- lowered-php\n  [source]\n  (let [{:keys [ast diagnostics]} (php/lower-program source)]\n    (assert (nil? diagnostics) (pr-str diagnostics))\n    ast))\n\n\n(defn- lowered-ts\n  [source]\n  (let [r (ts/lower-source source :bundled)]\n    (assert (nil? (:diagnostics r)) (pr-str (:diagnostics r)))\n    (let [{:yin/keys [batch root]} (:program r)]\n      (nth batch root))))\n\n\n(defn- bind\n  \"`receiver` with `v-name` bound to the value of `donor-ast`.\"\n  [donor-ast v-name receiver]\n  {:type :application,\n   :operator {:type :lambda, :params [v-name], :body receiver},\n   :operands [donor-ast]})\n\n\n(defn- registry\n  []\n  (php-h/host-registry))\n\n\n(defn- run\n  [ast]\n  (vm/value (vm/eval (tu/create-vm {:modules (registry)}) ast)))\n\n\n(defn ts-into-php\n  \"PHP `source` calling `ts_fn(...)`, with `ts_fn` the TS function `ts-src`\n   (a program of one arrow expression). Returns the printed text.\"\n  [ts-src source]\n  (let [fn-ast (donor (lowered-ts ts-src) 'js/run-main 'js/make-function\n                      [{:type :literal, :value :js/undefined}])\n        php-ast (walk/postwalk\n                  (fn [n]\n                    (if (app? n 'php/resolve-fn)\n                      (var-node '%tsfn)\n                      n))\n                  (lowered-php source))]\n    (php-h/render (run (bind fn-ast '%tsfn php-ast)))))\n\n\n(defn php-into-ts\n  \"TS `source` calling `phpfn(...)`, with `phpfn` the PHP closure `php-src`\n   (a program holding one closure expression). Returns the rendered value.\"\n  [php-src source]\n  (let [fn-ast (donor (lowered-php php-src) 'php/run-main 'php/make-function [])\n        ts-ast (walk/postwalk\n                 (fn [n]\n                   (if (and (app? n 'js/global-get)\n                            (= \"phpfn\" (get-in n [:operands 0 :value :js/str])))\n                     (var-node '%phpfn)\n                     n))\n                 (lowered-ts source))]\n    (render/output (run (bind fn-ast '%phpfn ts-ast)))))\n\n\n(deftest ts-closure-called-from-php-test\n  (testing \"a number crosses as a number: float in, float out\"\n    (is (= \"4\"\n           (ts-into-php \"(x, y) => x + y;\" \"<?php echo ts_fn(1.5, 2.5);\"))))\n  (testing \"the PHP caller sees the result as an ordinary value\"\n    (is (= \"yes\"\n           (ts-into-php \"(x, y) => x + y;\"\n                        \"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\")))))\n\n\n(deftest php-closure-called-from-ts-test\n  (testing \"TS stores and calls the same PHP function cell it received\"\n    (is (= {:js/out [\"true 5\"], :js/uncaught nil}\n           (php-into-ts \"<?php fn($a, $b) => $a + $b;\"\n                        \"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\")))))\n\n\n(deftest limits-test\n  (testing \"a PHP array returned to TS is an opaque handle, usable in PHP\"\n    (let [src \"<?php fn($a = 7) => $a === 7 ? [1, 2, 3] : count($a);\"]\n      ;; the PHP int `count` returns reaches TS as an integer (`3n`), not a\n      ;; JS number: the two preludes keep their own number kinds\n      (is (= {:js/out [\"3n\"], :js/uncaught nil}\n             (php-into-ts src \"const h = phpfn(); console.log(phpfn(h));\")))))\n  (testing \"PHP null is neither JS null nor undefined\"\n    (let [src \"<?php fn() => null;\"]\n      (is (= {:js/out [\"false false\"], :js/uncaught nil}\n             (php-into-ts src\n                          \"const n = phpfn(); console.log(n === null, n === undefined);\"))))))\n28-                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n29-                                        {:mvn/version \"0.3.0\"}}\n30-                           :main-opts [\"-m\" \"btree-bench\"]}\n31:           :test {:extra-paths [\"test\"]\n32:                  :extra-deps {io.github.cognitect-labs/test-runner\n33-                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n34-                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n35-                               ;; the differential oracle for the yang.clojure gap\n--\n37-                               latte-kernel/latte-kernel\n38-                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n39-                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n40:                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n41:                  :exec-fn cognitect.test-runner.api/test}\n42:           :nREPL {:extra-paths [\"test\"]\n43-                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n44-                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n45-                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n46:           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n47-                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n48-                               reagent/reagent {:mvn/version \"2.0.1\"}\n49-                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n--\n64-                                      {:git/url \"https: