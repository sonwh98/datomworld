                   (:heap vm)\n                     (:gc vm)\n                     (:origin vm)\n                     (:origins vm)\n                     (:ancestry vm)\n                     (:installs vm)\n                     (:module-stores vm)\n                     (:link-retired vm)\n                     (:link-diagnostics vm)\n                     (:capability-secret vm)\n                     (:owner vm)\n                     (:secret-source vm)\n                     (:attach-stream vm)\n                     (:ffi-caller-id vm)\n                     (:ffi-diagnostics vm)\n                     (:callable-effects vm))\n      vm)))\n\n\n(defn- closure-of\n  \"The closure a `:lambda` `node` instantiates, owned by `owner`. Its\n   binders are checked first (`vm/check-params!`: Rule R, and symbols\n   only). A node the row decoder annotated with its source row id\n   (`vm-load-rows`, `attach-image`) passes the id on as `:lambda`\n   (yin.vm.linker.md section 7.3, the walker rule); a node from any other\n   loader carries none.\"\n  [owner node params body env]\n(def ^:private capability-secret \"yin.vm.test-utils/capability-secret\")\n\n\n(defn create-vm\n  \"An AST walker composed with the harness's deterministic ring-buffer stream.\"\n  ([] (create-vm {}))\n  ([opts]\n   (ast-walker/create-vm\n     (merge {:make-stream\n             (fn [capacity]\n               (ringbuffer/create!\n                 {:dao.stream/type ringbuffer/transport-type,\n                  ringbuffer/capacity-key (or capacity vm/default-stream-capacity)}))\n             :capability-secret capability-secret}\n            opts))))\n\n\n(defn- new-memory-log\n  []\n  (let [result (memory-log/create! {:dao.stream/type memory-log/transport-type})]\n    (if (= :dao.stream/ok (:dao.stream/outcome result))\n","exit_code":0,"status":"completed"}}
