{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"/Library/Developer/CommandLineTools/usr/bin/git show master:test/yang/php_test.clj | nl -ba | sed -n '1,240p'; /Library/Developer/CommandLineTools/usr/bin/git show master:test/yang/php_literal_test.cljc; nl -ba test/yang/php/antlr/programs.cljc | sed -n '563,586p'; nl -ba src/dev/subsystems.edn | sed -n '55,74p'; ls -lh test/yang/php/antlr/phpt_selection.edn\"","aggregated_output":"     1\t(ns yang.php-test\n     2\t  (:require [clojure.test :refer [deftest is testing]]\n     3\t            [yang.clojure :as clj]\n     4\t            [yang.php :as php]\n     5\t            [yin.vm :as vm]\n     6\t            [yin.vm.test-utils :as tu]))\n     7\t\n     8\t\n     9\t(defn compile-and-run\n    10\t  ([ast] (compile-and-run ast {}))\n    11\t  ([ast env]\n    12\t   (-> (tu/make-observer-session (tu/create-vm {:env env}))\n    13\t       (tu/queue-ast! ast)\n    14\t       tu/run-session\n    15\t       :consumer\n    16\t       vm/value)))\n    17\t\n    18\t\n    19\t(deftest test-tokenize\n    20\t  (testing \"Tokenizing PHP source\"\n    21\t    (is (= [[:number \"42\"]] (php/tokenize \"42\")))\n    22\t    (is (= [[:string \"hello\"]] (php/tokenize \"\\\"hello\\\"\")))\n    23\t    (is (= [[:variable \"$x\"] [:operator \"+\"] [:number \"1\"]]\n    24\t           (php/tokenize \"$x + 1\")))\n    25\t    (is (= [[:keyword \"function\"] [:identifier \"add\"] [:lparen \"(\"]\n    26\t            [:variable \"$x\"] [:comma \",\"] [:variable \"$y\"] [:rparen \")\"]\n    27\t            [:lbrace \"{\"] [:keyword \"return\"] [:variable \"$x\"] [:operator \"+\"]\n    28\t            [:variable \"$y\"] [:semicolon \";\"] [:rbrace \"}\"]]\n    29\t           (php/tokenize \"function add($x, $y) { return $x + $y; }\")))))\n    30\t\n    31\t\n    32\t(deftest test-compile-literals\n    33\t  (testing \"Compiling PHP literals\"\n    34\t    (testing \"Numbers\"\n    35\t      (is (= {:type :literal, :value 42} (php/compile \"42;\")))\n    36\t      (is (= {:type :literal, :value -10} (php/compile \"-10;\")))\n    37\t      (is (= {:type :literal, :value 3.14} (php/compile \"3.14;\"))))\n    38\t    (testing \"Strings\"\n    39\t      (is (= {:type :literal, :value \"hello\"} (php/compile \"\\\"hello\\\";\")))\n    40\t      (is (= {:type :literal, :value \"world\"} (php/compile \"'world';\"))))\n    41\t    (testing \"Booleans\"\n    42\t      (is (= {:type :literal, :value true} (php/compile \"true;\")))\n    43\t      (is (= {:type :literal, :value false} (php/compile \"false;\"))))\n    44\t    (testing \"null\"\n    45\t      (is (= {:type :literal, :value nil} (php/compile \"null;\"))))))\n    46\t\n    47\t\n    48\t(deftest test-compile-variables\n    49\t  (testing \"Compiling PHP variables\"\n    50\t    (is (= {:type :variable, :name 'x} (php/compile \"$x;\")))\n    51\t    (is (= {:type :variable, :name 'foo} (php/compile \"$foo;\")))))\n    52\t\n    53\t\n    54\t(deftest test-compile-binary-ops\n    55\t  (testing \"Compiling PHP binary operations\"\n    56\t    (testing \"Addition\"\n    57\t      (let [ast (php/compile \"1 + 2;\")]\n    58\t        (is (= :application (:type ast)))\n    59\t        (is (= {:type :variable, :name '+} (:operator ast)))\n    60\t        (is (= 2 (count (:operands ast))))))\n    61\t    (testing \"Multiplication\"\n    62\t      (let [ast (php/compile \"$x * 2;\")]\n    63\t        (is (= :application (:type ast)))\n    64\t        (is (= {:type :variable, :name '*} (:operator ast)))))\n    65\t    (testing \"Comparison\"\n    66\t      (let [ast (php/compile \"$x < 5;\")]\n    67\t        (is (= :application (:type ast)))\n    68\t        (is (= {:type :variable, :name '<} (:operator ast)))))\n    69\t    (testing \"Operator precedence\"\n    70\t      (let [ast (php/compile \"2 + 3 * 4;\")]\n    71\t        ;; Should be: 2 + (3 * 4)\n    72\t        (is (= :application (:type ast)))\n    73\t        (is (= '+ (get-in ast [:operator :name])))\n    74\t        (is (= :application (get-in ast [:operands 1 :type])))\n    75\t        (is (= '* (get-in ast [:operands 1 :operator :name])))))))\n    76\t\n    77\t\n    78\t(deftest test-compile-function\n    79\t  (testing \"Compiling PHP function statements\"\n    80\t    (testing \"Simple function\"\n    81\t      (let [ast (php/compile \"function double($x) { return $x * 2; }\")]\n    82\t        (is (= :application (:type ast)))))\n    83\t    (testing \"Function with multiple parameters\"\n    84\t      (let [ast (php/compile \"function add($x, $y) { return $x + $y; }\")]\n    85\t        (is (= :application (:type ast)))))))\n    86\t\n    87\t\n    88\t(deftest test-compile-call\n    89\t  (testing \"Compiling PHP function calls\"\n    90\t    (testing \"Simple call\"\n    91\t      (let [ast (php/compile \"f(5);\")]\n    92\t        (is (= :application (:type ast)))\n    93\t        (is (= {:type :variable, :name 'f} (:operator ast)))\n    94\t        (is (= 1 (count (:operands ast))))))\n    95\t    (testing \"Multiple arguments\"\n    96\t      (let [ast (php/compile \"add(1, 2);\")]\n    97\t        (is (= :application (:type ast)))\n    98\t        (is (= 2 (count (:operands ast))))))\n    99\t    (testing \"Nested calls\"\n   100\t      (let [ast (php/compile \"f(g(5));\")]\n   101\t        (is (= :application (:type ast)))\n   102\t        (is (= :application (get-in ast [:operands 0 :type])))))))\n   103\t\n   104\t\n   105\t(deftest test-end-to-end-php\n   106\t  (testing \"Compile and execute PHP code with Yin VM\"\n   107\t    (testing \"Simple literal\" (is (= 42 (compile-and-run (php/compile \"42;\")))))\n   108\t    (testing \"Variable lookup\"\n   109\t      (is (= 100 (compile-and-run (php/compile \"$x;\") {'x 100}))))\n   110\t    (testing \"Simple addition\"\n   111\t      (is (= 3 (compile-and-run (php/compile \"1 + 2;\")))))\n   112\t    (testing \"Function application\"\n   113\t      (let\n   114\t        [source\n   115\t         \"function double($x) { return $x * 2; }\n   116\t                    double(21);\"\n   117\t         ast (php/compile source)]\n   118\t        (is (= 42 (compile-and-run ast)))))\n   119\t    (testing \"Multiple parameters\"\n   120\t      (let\n   121\t        [source\n   122\t         \"function add($x, $y) { return $x + $y; }\n   123\t                    add(10, 20);\"\n   124\t         ast (php/compile source)]\n   125\t        (is (= 30 (compile-and-run ast)))))\n   126\t    (testing \"Operator precedence\"\n   127\t      (is (= 14 (compile-and-run (php/compile \"2 + 3 * 4;\")))))\n   128\t    (testing \"Nested operations\"\n   129\t      (is (= 20 (compile-and-run (php/compile \"(2 + 3) * 4;\")))))\n   130\t    (testing \"Comparison\"\n   131\t      (is (= true (compile-and-run (php/compile \"3 < 5;\")))))\n   132\t    (testing \"If statement - true branch\"\n   133\t      (let [source \"if (true) { return 10; } else { return 20; }\"\n   134\t            ast (php/compile source)]\n   135\t        (is (= 10 (compile-and-run ast)))))\n   136\t    (testing \"If statement - false branch\"\n   137\t      (let [source \"if (false) { return 10; } else { return 20; }\"\n   138\t            ast (php/compile source)]\n   139\t        (is (= 20 (compile-and-run ast)))))\n   140\t    (testing \"If with comparison\"\n   141\t      (let [source \"if (3 < 5) { return 100; } else { return 200; }\"\n   142\t            ast (php/compile source)]\n   143\t        (is (= 100 (compile-and-run ast)))))\n   144\t    (testing \"Else if\"\n   145\t      (let\n   146\t        [source\n   147\t         \"if (3 > 5) { return 1; } elseif (4 < 5) { return 2; } else { return 3; }\"\n   148\t         ast (php/compile source)]\n   149\t        (is (= 2 (compile-and-run ast)))))\n   150\t    (testing \"Complex closure with type hints and assignment\"\n   151\t      (let\n   152\t        [source\n   153\t         \"$makePower = function (int $exponent) {\n   154\t                      return function (int $base) use ($exponent): int {\n   155\t                          $result = 1;\n   156\t                          $result = $result * $base;\n   157\t                          return $result;\n   158\t                      };\n   159\t                    };\n   160\t                    $pow2 = $makePower(2);\n   161\t                    $pow2(3);\"\n   162\t         ast (php/compile source)]\n   163\t        ;; This simplified version (no for loop yet in test, and result is\n   164\t        ;; just result * base)\n   165\t        ;; should at least compile and run.\n   166\t        (is (= 3 (compile-and-run ast)))))\n   167\t    (testing \"Closure with for loop and augmented assignment\"\n   168\t      (let\n   169\t        [source\n   170\t         \"$makePower = function (int $exponent) {\n   171\t                      return function (int $base) use ($exponent): int {\n   172\t                          $result = 1;\n   173\t                          for ($i = 0; $i < $exponent; $i++) {\n   174\t                              $result *= $base;\n   175\t                          }\n   176\t                          return $result;\n   177\t                      };\n   178\t                    };\n   179\t                    $cube = $makePower(3);\n   180\t                    $cube(2);\"\n   181\t         ast (php/compile source)]\n   182\t        (is (= 8 (compile-and-run ast)))))))\n   183\t\n   184\t\n   185\t(deftest test-php-to-clojure-equivalence\n   186\t  (testing \"PHP and Clojure compile to equivalent ASTs\"\n   187\t    (testing \"Function calls\"\n   188\t      (let [php-ast (php/compile \"f(1, 2);\")\n   189\t            clj-ast (clj/compile '(f 1 2))]\n   190\t        (is (= (:type php-ast) (:type clj-ast) :application))\n   191\t        (is (= (count (:operands php-ast)) (count (:operands clj-ast)) 2))))))\n   192\t\n   193\t\n   194\t(deftest test-error-handling\n   195\t  (testing \"Error handling for invalid PHP\"\n   196\t    (testing \"Unclosed string\"\n   197\t      (is (thrown? Exception (php/compile \"\\\"unclosed;\"))))\n   198\t    (testing \"Invalid syntax\" (is (thrown? Exception (php/compile \"function\"))))\n   199\t    (testing \"Unmatched parenthesis\"\n   200\t      (is (thrown? Exception (php/compile \"(1 + 2;\"))))))\n(ns yang.php-literal-test\n  \"PHP number literals over the primitive profile, on every lane\n   (docs/design/dao.stream.host-boundary.md §8 H2, table D row (4)):\n   integers exact in their canonical carrier, floats the nearest double.\"\n  (:require\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [dao.host.integer :as host-integer]\n    [yang.php :as php]))\n\n\n(defn- decimal-text\n  [v]\n  (host-integer/to-radix-string (host-integer/promote v) 10))\n\n\n(deftest integer-literals-are-exact-in-their-canonical-carrier\n  (testing \"a small literal is a native carrier\"\n    (let [v (php/php-number \"12\")]\n      (is (host-integer/safe-native? v))\n      (is (= 12 v))))\n  (testing \"2^53 + 1 parses to that exact integer (a big carrier on JS)\"\n    (let [v (php/php-number \"9007199254740993\")]\n      (is (host-integer/exact-integer? v))\n      (is (= \"9007199254740993\" (decimal-text v)))\n      (is (not (host-integer/safe-native? v)))\n      #?(:cljs (is (host-integer/big-carrier? v)))))\n  (testing \"a 400-digit literal is an exact big\"\n    (let [text (str \"1\" (apply str (repeat 399 \"7\")))\n          v (php/php-number text)]\n      (is (host-integer/big-carrier? v))\n      (is (= text (decimal-text v)))))\n  (testing \"through the literal parser\"\n    (is (= {:php-type :literal :value 12} (php/parse-php-literal [:number \"12\"])))))\n\n\n(deftest float-literals-are-the-nearest-double\n  (is (= 1.5 (php/php-number \"1.5\")))\n  (is (= 0.1 (php/php-number \"0.1\")))\n  (is (= 1.0 (php/php-number \"1.\")) \"the lexer's digits-dot form\")\n  (is (= ##Inf (php/php-number (str (str/join (repeat 400 \"9\")) \".0\"))))\n  (is (host-integer/host-float? (php/php-number \"2.0\"))))\n   563\t    :out \"NULL\\nNULL\\nNULL\\nNULL\\nNULL\\nNULL\\nNULL\\n\",\n   564\t    :diag [[2 \"Undefined array key \\\"y\\\"\"] [2 \"Undefined array key 3\"] [2 \"Trying to access array offset on null\"] [2 \"Trying to access array offset on int\"] [2 \"Trying to access array offset on true\"] [2 \"Trying to access array offset on float\"] [2 \"Undefined variable $u\"] [2 \"Trying to access array offset on null\"]],\n   565\t    :oracle \"php-8.3.35 shiva 2026-10-25\"}\n   566\t   {:id :string-offset-read,\n   567\t    :criterion \"string offset reads, negative offsets, isset\",\n   568\t    :source \"<?php $s = 'abc'; var_dump($s[0], $s[-1], $s['1']); echo $s[5]; var_dump(isset($s[1]), isset($s[5]), isset($s['x']), isset($s['1']), empty($s[0]));\",\n   569\t    :out \"string(1) \\\"a\\\"\\nstring(1) \\\"c\\\"\\nstring(1) \\\"b\\\"\\nbool(true)\\nbool(false)\\nbool(false)\\nbool(true)\\nbool(false)\\n\",\n   570\t    :diag [[2 \"Uninitialized string offset 5\"]],\n   571\t    :oracle \"php-8.3.35 shiva 2026-10-25\"}\n   572\t   {:id :string-offset-write,\n   573\t    :criterion \"single-byte string offset writes work (G-str-offset-write closed in 91c5c8cd)\",\n   574\t    :source \"<?php $s = \\\"ab\\\"; $s[0] = \\\"c\\\"; echo $s;\",\n   575\t    :out \"cb\",\n   576\t    :diag [],\n   577\t    :oracle \"php-8.3.35 shiva 2026-10-25\"}\n   578\t   {:id :string-offset-peek,\n   579\t    :criterion \"isset/empty on a string coerce bool and null silently and deprecate fractional floats\",\n   580\t    :source \"<?php $s = 'abc'; var_dump(isset($s[true]), isset($s[false]), isset($s[null]), isset($s[1.0]), isset($s[1.5]), isset($s[-1]), isset($s[-4]), isset($s[3]), isset($s['1.5']), isset($s[' 1'])); $z = '0b'; var_dump(empty($z[true]), empty($z[0]), empty($s[true]));\",\n   581\t    :out \"bool(true)\\nbool(true)\\nbool(true)\\nbool(true)\\nbool(true)\\nbool(true)\\nbool(false)\\nbool(false)\\nbool(false)\\nbool(true)\\nbool(false)\\nbool(true)\\nbool(false)\\n\",\n   582\t    :diag [[8192 \"Implicit conversion from float 1.5 to int loses precision\"]],\n   583\t    :oracle \"php-8.3.35 shiva 2026-10-25\"}\n   584\t   {:id :array-spread-renumber,\n   585\t    :criterion \"spread renumbers int keys\",\n   586\t    :source \"<?php $a = [5 => 'x', 7 => 'y']; var_dump([...$a]);\",\n    55\t   :prefixes [\"yang.python\" \"yang.antlr\"]\n    56\t   :layer 3}\n    57\t\n    58\t  {:name \"yang.typescript\"\n    59\t   :prefixes [\"yang.typescript\"]\n    60\t   :layer 3}\n    61\t\n    62\t  {:name \"yang.php\"\n    63\t   :prefixes [\"yang.php.antlr\"]\n    64\t   :layer 3}\n    65\t\n    66\t  {:name \"yang.base\"\n    67\t   :prefixes [\"yang.clojure\" \"yang.frontend\" \"yang.safepoint\"\n    68\t              \"yang.stage\" \"yang.tails\" \"yang.io\" \"yang.core\"]\n    69\t   :layer 3}\n    70\t\n    71\t  ;; Layer 4: Demos & World Applications\n    72\t  {:name \"demo\"\n    73\t   :prefixes [\"datomworld\" \"yin.demo\"]\n    74\t   :layer 4}\n-rw-r--r--@ 1 sto  staff   755K Nov  3 15:27 test/yang/php/antlr/phpt_selection.edn\n","exit_code":0,"status":"completed"}}
