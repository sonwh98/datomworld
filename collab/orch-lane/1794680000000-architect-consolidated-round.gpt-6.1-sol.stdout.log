er reports ready\n  5401\t                [(define 'php.rt/state :php/ready) :php/null])\n  5402\t              :php/null)))\n  5403\t\n  5404\t\n  5405\t(def definitions\n  5406\t  \"The single definition list, `[store-key form]` in definition order: every\n  5407\t   prelude function, the literal state slot, then `php/init!`. Defining them\n  5408\t   runs nothing.\"\n  5409\t  (into (into (into core-definitions module-defs/definitions) p9-defs/definitions)\n  5410\t        [['php.rt/state :php/uninit]\n  5411\t         ['php/init! (init-form)]]))\n  5412\t\n  5413\t\n  5414\t(def functions-uast\n  5415\t  \"The bundled shared-call definitions, PHP lambdas and literal state slot.\"\n  5416\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form)))\n  5417\t                    (into call/definitions definitions))))\n  5418\t\n  5419\t\n  5420\t(def uast\n  5421\t  \"The bundled prelude: every definition, then the task's runtime state\n  5422\t   allocated by `php/init!`.\"\n  5423\t  (u/then functions-uast (u/sexp->uast '(php/init!))))\n  5424\t\n  5425\t\n  5426\t;; =============================================================================\n  5427\t;; The module emitter: the same definition list as the linker module `php`\n  5428\t;; =============================================================================\n  5429\t\n  5430\t(def module-name\n  5431\t  \"The linker module the PHP runtime profile is published as.\"\n  5432\t  'php)\n  5433\t\n  5434\t\n  5435\t(def runtime-keys\n  5436\t  \"Every key `php/init!` allocates, the ready flag aside, sorted.\"\n  5437\t  '[php.rt/class-index php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/error-handler\n  5438\t    php.rt/class-order php.rt/exception-handler php.rt/exception-handlers php.rt/finalizable php.rt/pending-exc\n  5439\t    php.rt/shutdown-fns php.rt/exit-status php.rt/in-shutdown php.rt/fatal-escape\n  5440\t    php.rt/exit-escape php.rt/shutdown-escape php.rt/strict php.rt/included php.rt/path-map php.rt/unit\n  5441\t    php.rt/autoloaders php.rt/autoloading php.rt/class-map php.rt/constants\n  5442\t    php.rt/error-reporting php.rt/error-handlers php.rt/functions php.rt/globals php.rt/int-max\n  5443\t    php.rt/int-min php.rt/next-cell php.rt/next-ord\n  5444\t    php.rt/out php.rt/request php.rt/response php.rt/headers-sent php.rt/status php.rt/tmps])\n  5445\t\n  5446\t\n  5447\t(defn strip\n  5448\t  \"`sym` without the module's own namespace `php`; `php.rt/*` stays\n  5449\t   qualified.\"\n  5450\t  [sym]\n  5451\t  (core/strip \"php\" sym))\n  5452\t\n  5453\t\n  5454\t(defn- binder-symbols\n  5455\t  \"Every symbol a `fn` parameter list or `let` binding vector in `form`\n  5456\t   binds.\"\n  5457\t  [form]\n  5458\t  (cond\n  5459\t    (and (seq? form) (= 'fn (first form)))\n  5460\t    (into (set (second form)) (mapcat binder-symbols) (drop 2 form))\n  5461\t    (and (seq? form) (= 'let (first form)))\n  5462\t    (into (set (take-nth 2 (second form)))\n  5463\t          (mapcat binder-symbols)\n  5464\t          (concat (take-nth 2 (rest (second form))) (drop 2 form)))\n  5465\t    (coll? form) (into #{} (mapcat binder-symbols) (seq form))\n  5466\t    :else #{}))\n  5467\t\n  5468\t\n  5469\t(defn- unshadow\n  5470\t  \"`form` with every local binder named like a module export renamed (`h` to\n  5471\t   `h%l`): the module emitter strips `php/h` to the bare `h`, which a local\n  5472\t   `h` would otherwise capture. Globals are qualified before stripping, so\n  5473\t   every bare occurrence is the local.\"\n  5474\t  [exports [k form]]\n  5475\t  (let [clash (set (filter exports (binder-symbols form)))]\n  5476\t    [k\n  5477\t     (if (empty? clash)\n  5478\t       form\n  5479\t       (walk/postwalk (fn [x] (if (contains? clash x) (symbol (str x \"%l\")) x)) form))]))\n  5480\t\n  5481\t\n  5482\t(def ^:private module-definitions\n  5483\t  (core/module-definitions\n  5484\t    \"php\" :php/uninit runtime-keys\n  5485\t    (mapv (partial unshadow (into #{} (map (fn [[k _]] (strip k))) definitions)) definitions)))\n  5486\t\n  5487\t\n  5488\t(def module-uast\n  5489\t  \"The module tree: one application whose operands are the definitions, in\n  5490\t   order. Defining runs nothing.\"\n  5491\t  (core/module-tree module-definitions []))\n  5492\t\n  5493\t\n  5494\t(def module-exports\n  5495\t  \"The module's exports: every `php/` key of the definition list, stripped.\"\n  5496\t  (core/exports \"php\" definitions))\n  5497\t\n  5498\t\n  5499\t(def free-names core/free-names)\n  5500\t\n  5501\t\n  5502\t(def defined-keys core/defined-keys)\n  5503\t\n  5504\t\n  5505\t(def ^:private module-free-names\n  3810\t(def module-exports\n  3811\t  \"The exports of a compiled PHP unit: its spec and body, immutable after\n  3812\t   install.\"\n  3813\t  '#{spec body})\n  3814\t\n  3815\t\n  3816\t(defn imported-unit-names\n  3817\t  \"The normalized paths the unit statically includes through folded literal\n  3818\t   paths, source order, distinct, the unit's own path aside. A computed path\n  3819\t   contributes nothing: it is by name at run time (plan P6 R3). A path that\n  3820\t   cannot normalize is refused as `lower-include` refuses it.\"\n  3821\t  [packet {:keys [path], :or {path entry-path}}]\n  3822\t  (let [ctx (context packet {:path path, :linked? true})]\n  3823\t    (letfn [(edges\n  3824\t              [n]\n  3825\t              (let [ks (core/kids ctx n)\n  3826\t                    k0 (first ks)]\n  3827\t                (concat\n  3828\t                  (when (and (p/rule? n \"expression\")\n  3829\t                             (= 2 (count ks))\n  3830\t                             (p/token? k0)\n  3831\t                             (contains? include-kinds (:type k0)))\n  3832\t                    (when-let [folded (fold-path ctx (second ks))]\n  3833\t                      (let [{p :path, error :error} (normalize-unit-path folded)]\n  3834\t                        (when error (unsupported! n error))\n  3835\t                        [p])))\n  3836\t                  (mapcat edges (filter p/rule? ks)))))]\n  3837\t      (into [] (comp (distinct) (remove #(= % path))) (edges (p/root (:pk ctx)))))))\n  3838\t\n  3839\t\n  3840\t(defn module-packet\n  3841\t  \"One ok packet as the linker module `phpm.<mangled-path>`: one wide\n  3842\t   application whose operands are `(require 'php)`, then the spec and body\n  3843\t   definitions. The body is `(fn [%scope %ctx] <unit>)`: the including\n  3844\t   scope arrives as arguments (P6 S3 gives them meaning; S2 includes only\n  3845\t   at an entry unit's top level, whose variables are the globals).\"\n  3846\t  [packet {:keys [path strict-types]}]\n  3847\t  (let [ctx (assoc (context packet {:path path, :linked? true}) :module? true)\n  3848\t        defs [(u/def! 'spec (u/lit {:path path, :strict-types (if strict-types 1 0)}))\n  3849\t              (u/def! 'body (u/lam ['%scope '%ctx] (unit-node ctx true)))]\n  3850\t        operands (into [(core-module/require-node prelude/module-name)] defs)\n  3851\t        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n  3852\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))\n  3853\t\n  3854\t\n  3855\t(defn module-spec\n  3856\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the unit at `path` over\n  3857\t   the host registry `registry`, requiring `php` at `php-address` and each\n  3858\t   included unit at its address in `deps` ({path address}). A free name no\n  3859\t   requirement or profile supplies is refused before anything is published.\n  3860\t   This namespace emits; it never publishes.\"\n  3861\t  [registry packet {:keys [path strict-types php-address deps]}]\n  3862\t  (core-module/module-spec\n  3863\t    :yang.php/refusal :yang.php/undeclared-free registry\n  3864\t    {:name (path-module-symbol path),\n  3865\t     :ast (module-packet packet {:path path, :strict-types strict-types}),\n  3866\t     :exports module-exports,\n  3867\t     :runtime-name prelude/module-name,\n  3868\t     :runtime-address php-address,\n  3869\t     :deps (into {} (map (fn [[p a]] [(path-module-symbol p) a])) deps)}))\n  3870\t\n  3871\t\n  3872\t;; =============================================================================\n  3873\t;; The autoload class map (plan P6 R9)\n  3874\t;; =============================================================================\n  3875\t\n     1\t(ns yang.php.antlr.safepoint-test\n     2\t  (:require\n     3\t    [clojure.test :refer [deftest is testing]]\n     4\t    [yang.php.antlr.e2e-harness :as h]\n     5\t    [yang.php.antlr.safepoint :as hooks]))\n     6\t\n     7\t\n     8\t(def ^:private vms [:ast-walker :semantic :stack :register])\n     9\t\n    10\t\n    11\t(defn- every-vm=\n    12\t  [expected results]\n    13\t  (doseq [k vms]\n    14\t    (is (= expected (get results k)) (name k))))\n    15\t\n    16\t\n    17\t(deftest exhaustion-is-an-operational-fatal-test\n    18\t  (let [source (str \"<?php class C { function __destruct() { echo 'D'; } } \"\n    19\t                    \"$c = new C; try { while (true) {} } \"\n    20\t                    \"catch (Throwable $e) { echo 'C'; }\")]\n    21\t    (every-vm= (str \"PHP Fatal error:  \" hooks/fatal-text)\n    22\t               (h/run-php source {:execution-budget 4}))))\n    23\t\n    24\t\n    25\t(deftest exhaustion-inside-try-finally-is-fatal-test\n    26\t  (let [source (str \"<?php function g() { yield 1; } \"\n    27\t                    \"try { while (true) {} } finally { echo 'F'; }\")]\n    28\t    (every-vm= (str \"PHP Fatal error:  \" hooks/fatal-text)\n    29\t               (h/run-php source {:execution-budget 4}))))\n    30\t\n    31\t\n    32\t(deftest exhaustion-in-shutdown-is-fatal-test\n    33\t  (let [source (str \"<?php register_shutdown_function(function() { while (true) {} });\"\n    34\t                    \" echo 'A';\")]\n    35\t    (every-vm= (str \"A\" \"PHP Fatal error:  \" hooks/fatal-text)\n    36\t               (h/run-php source {:execution-budget 4}))))\n    37\t\n    38\t\n    39\t(deftest budget-validation-test\n    40\t  (is (thrown? clojure.lang.ExceptionInfo (hooks/program -1 nil)))\n    41\t  (is (thrown? clojure.lang.ExceptionInfo (hooks/program 1.5 nil)))\n    42\t  (is (thrown? clojure.lang.ExceptionInfo (hooks/program \"4\" nil))))\n    43\t\n    44\t\n    45\t(deftest unbounded-and-unexhausted-runs-agree-test\n    46\t  (let [source \"<?php function f($x) { return $x + 1; } $i = 0; while ($i < 5) { $i = f($i); } echo $i;\"\n    47\t        unbounded (h/run-php source)]\n    48\t    (testing \"the default remains unbudgeted\"\n    49\t      (every-vm= \"5\" unbounded))\n    50\t    (testing \"a budget that is not exhausted is unobservable\"\n    51\t      (is (= unbounded (h/run-php source {:execution-budget 100}))))))\n","exit_code":0,"status":"completed"}}
