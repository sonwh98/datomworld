ntlr/prelude.cljc b/src/cljc/yang/typescript/antlr/prelude.cljc\nindex 22d34b8f..adfb5641 100644\n--- a/src/cljc/yang/typescript/antlr/prelude.cljc\n+++ b/src/cljc/yang/typescript/antlr/prelude.cljc\n@@ -132,7 +132,7 @@\n                  (if (data/content= x (data/float64 x)) :number :bigint)\n                  (if (js/str? x)\n                    :string\n-                   (if (js/cell? x)\n+                   (if (if (js/cell? x) (cell/authentic? x) false)\n                      (if (= (get (cell/get x) :js/type) :function)\n                        :function\n                        (if (= (get (cell/get x) :js/type) :symbol)\n@@ -142,10 +142,13 @@\n                          ;; carry a call entry, no :js/type) is a\n                          ;; function too, not an object.\n                          (if (yang.call/eligible? x) :function :object)))\n-                     ;; An admitted foreign callable that is not a JS\n-                     ;; cell (a clojure descriptor, a bound method) is\n-                     ;; still a function; only a value no profile admits\n-                     ;; keeps the bare-number fallback.\n+                     ;; A cell-ref-SHAPED value the heap does not\n+                     ;; authenticate is ordinary data (the ruling of\n+                     ;; record): it earns whatever a plain map earns\n+                     ;; here. An admitted foreign callable that is not\n+                     ;; a JS cell (a clojure descriptor, a bound\n+                     ;; method) is still a function; only a value no\n+                     ;; profile admits keeps the bare-number fallback.\n                      (if (yang.call/eligible? x) :function :number)))))))))]\n     [js/ty (fn [k] (if (= k :function) :object k))]\n     [js/prim-type?\ndiff --git a/test/yang/typescript/antlr/prelude_test.cljc b/test/yang/typescript/antlr/prelude_test.cljc\nindex b0ee60f9..1576faac 100644\n--- a/test/yang/typescript/antlr/prelude_test.cljc\n+++ b/test/yang/typescript/antlr/prelude_test.cljc\n@@ -684,3 +684,47 @@\n \n (deftest primitive-receiver-test\n   (check (conj receiver-prim-cases receiver-set-case)))\n+\n+\n+(def ^:private cell-ref-typeof-cases\n+  [;; a cell-ref-SHAPED data value is ordinary data: it earns whatever a\n+   ;; plain map earns (bare-number fallback), it does not abort\n+   ['(js/typeof {:type :cell-ref :id \"cell-1\" :seal \"x\"})\n+    {:js/str \"number\"}]\n+   ['(js/kind-of {:type :cell-ref :id \"cell-1\" :seal \"x\"}) :number]\n+   ;; a genuine reference still resolves exactly as before\n+   ['(js/typeof (js/make-object js.rt/obj-proto)) {:js/str \"object\"}]\n+   ['(js/kind-of (js/make-function {:js/str \"f\"}\n+                                   0\n+                                   :strict\n+                                   :normal\n+                                   (fn [this args] this)))\n+    :function]])\n+\n+\n+(deftest cell-ref-typeof-test\n+  (check cell-ref-typeof-cases))\n+\n+\n+(def ^:private cell-ref-receiver-cases\n+  [;; the preserved member-call receiver passes through as data: a\n+   ;; cell-ref-SHAPED receiver answers typeof as a plain map, no abort\n+   ['(let [f (js/make-function {:js/str \"f\"}\n+                               0\n+                               :strict\n+                               :normal\n+                               (fn [this args] (js/typeof this)))]\n+       (js/call f {:type :cell-ref :id \"cell-1\" :seal \"x\"} []))\n+    {:js/str \"number\"}]\n+   ;; a genuine object receiver still arrives as an object\n+   ['(let [f (js/make-function {:js/str \"f\"}\n+                               0\n+                               :strict\n+                               :normal\n+                               (fn [this args] (js/typeof this)))]\n+       (js/call f (js/make-object js.rt/obj-proto) []))\n+    {:js/str \"object\"}]])\n+\n+\n+(deftest cell-ref-receiver-test\n+  (check cell-ref-receiver-cases))\n","exit_code":0,"status":"completed"}}
