quest\\n12\\t  {:php.request/method \\\"POST\\\"\\n13\\t   :php.request/uri \\\"/hello?a=1\\\"\\n14\\t   :php.request/query (request-array [[\\\"a\\\" \\\"1\\\"] [\\\"shared\\\" \\\"get\\\"]])\\n15\\t   :php.request/headers (request-array [[\\\"X-Test\\\" \\\"yes\\\"]])\\n16\\t   :php.request/cookies (request-array [[\\\"session\\\" \\\"abc\\\"]])\\n17\\t   :php.request/body (request-array [[\\\"b\\\" \\\"2\\\"] [\\\"shared\\\" \\\"post\\\"]])\\n18\\t   :php.request/server (request-array [[\\\"SERVER_NAME\\\" \\\"fixture.test\\\"]])\\n19\\t   :php.request/env (request-array [[\\\"APP_ENV\\\" \\\"test\\\"]])\\n20\\t   :php.request/files (request-array [[\\\"upload\\\" \\\"fixture\\\"]])})\\n21\\t\\n22\\t\\n23\\t(defn- fx\\n24\\t  [id source out & {:as more}]\\n25\\t  (merge {:id id, :group :request-context, :source source, :out out,\\n26\\t          :request request, :oracle :pending}\\n27\\t         more))\\n28\\t\\n29\\t\\n30\\t(def fixtures\\n31\\t  [(fx :superglobals-from-request\\n32\\t       (str \\\"<?php echo $_GET['a'], $_POST['b'], $_COOKIE['session'],\\\"\\n33\\t            \\\" $_SERVER['REQUEST_METHOD'], $_SERVER['REQUEST_URI'],\\\"\\n34\\t            \\\" $_SERVER['SERVER_NAME'], $_ENV['APP_ENV'], $_FILES['upload'],\\\"\\n35\\t            \\\" $_REQUEST['a'], $_REQUEST['b'], $_REQUEST['shared'];\\\")\\n36\\t       \\\"12abcPOST/hello?a=1fixture.testtestfixture12post\\\")\\n37\\t   (fx :output-buffering\\n38\\t       \\\"<?php ob_start(); echo 'a'; echo ob_get_contents(); ob_start(); echo 'b'; echo ob_get_clean(); echo ob_get_clean(); echo 'c';\\\"\\n39\\t       \\\"aabc\\\")\\n40\\t   (fx :output-buffer-flush\\n41\\t       \\\"<?php ob_start(); echo 'a'; ob_end_flush(); echo 'b'; var_dump(ob_end_clean());\\\"\\n42\\t       \\\"abbool(false)\\\\n\\\")\\n43\\t   (fx :headers-cookies-status\\n44\\t       \\\"<?php header('X-One: 1'); setcookie('sid', 'abc'); http_response_code(201); echo http_response_code();\\\"\\n45\\t       \\\"201\\\"\\n46\\t       :response [{:php.response/header \\\"X-One: 1\\\", :replace true}\\n47\\t                  {:php.response/cookie {:name \\\"sid\\\", :value \\\"abc\\\"}}\\n48\\t                  {:php.response/status 201}\\n49\\t                  {:php.response/body \\\"201\\\"}])\\n50\\t   (fx :headers-after-output\\n51\\t       \\\"<?php echo 'x'; header('X-Late: 1'); var_dump(headers_sent());\\\"\\n52\\t       \\\"xbool(true)\\\\n\\\"\\n53\\t       :diag [[2 \\\"Cannot modify header information - headers already sent\\\"]]\\n54\\t       :response [{:php.response/body \\\"xbool(true)\\\\n\\\"}])\\n55\\t   (fx :error-handler-and-warnings\\n56\\t       (str \\\"<?php set_error_handler(function($n, $s) { echo 'H', $n, ':', $s; });\\\"\\n57\\t            \\\" trigger_error('first', E_USER_WARNING); restore_error_handler();\\\"\\n58\\t            \\\" trigger_error('second', E_USER_NOTICE);\\\")\\n59\\t       \\\"H1024:first\\\"\\n60\\t       :diag [[1024 \\\"second\\\"]])\\n61\\t   (fx :exit-runs-shutdown\\n62\\t       \\\"<?php register_shutdown_function(function() { echo 'S'; }); echo 'A'; exit(7); echo 'B';\\\"\\n63\\t       \\\"AS\\\"\\n64\\t       :status 7)\\n65\\t   (fx :exit-string\\n66\\t       \\\"<?php echo 'A'; die('B'); echo 'C';\\\"\\n67\\t       \\\"AB\\\"\\n68\\t       :status 0)])\"}\n{\"role\":\"tool\",\"tool_call_id\":\"tool_8PMuVTyxSNuaaynNVA9FQU4m\",\"content\":\"1\\t(ns yang.php.antlr.builtins\\n2\\t  \\\"The pinned PHP builtin catalogue (docs/design/yang.php.md section 3.8): the\\n3\\t   lower-cased names of the PHP 8.3 core functions a program is likely to\\n4\\t   call. A call to a name in this set that is neither declared by the unit nor\\n5\\t   supplied by the prelude gets the `:yang.php/unknown-builtin` warning\\n6\\t   diagnostic at lowering, so an unsupported library function fails honestly\\n7\\t   before the program runs. At run time such a call is still\\n8\\t   `Error: Call to undefined function`; nothing is stubbed to return\\n9\\t   success. The list is checked in, not derived: regenerate it from\\n10\\t   `get_defined_functions()['internal']` of the pinned PHP when the target\\n11\\t   version moves.\\\")\\n12\\t\\n13\\t\\n14\\t(def supported\\n15\\t  \\\"The builtins the prelude supplies: lower-cased PHP name to the prelude\\n16\\t   definition that implements it and, for a by-reference builtin, the\\n17\\t   by-reference argument positions (`:by-ref`). The prelude derives its\\n18\\t   registration from this table and the lowering reads `:by-ref`, so a\\n19\\t   position is stated once. A by-reference builtin answers `[ret outs]`.\\\"\\n20\\t  (let [plain (fn [m] (into {} (map (fn [[k v]] [k {:prelude v}])) m))\\n21\\t        by-ref (fn [m] (into {} (map (fn [[k v]] [k {:prelude v, :by-ref [0]}])) m))]\\n22\\t    (merge\\n23\\t      (plain {\\\"var_dump\\\" 'php/bi-var-dump, \\\"intdiv\\\" 'php/bi-intdiv, \\\"fmod\\\" 'php/bi-fmod,\\n24\\t              \\\"strlen\\\" 'php/bi-strlen, \\\"intval\\\" 'php/bi-intval, \\\"floatval\\\" 'php/bi-floatval,\\n25\\t              \\\"strval\\\" 'php/bi-strval, \\\"boolval\\\" 'php/bi-boolval, \\\"is_nan\\\" 'php/bi-is-nan,\\n26\\t              \\\"set_error_handler\\\" 'php/bi-set-error-handler,\\n27\\t              \\\"restore_error_handler\\\" 'php/bi-restore-error-handler,\\n28\\t              \\\"error_reporting\\\" 'php/bi-error-reporting,\\n29\\t              \\\"trigger_error\\\" 'php/bi-trigger-error, \\\"user_error\\\" 'php/bi-trigger-error,\\n30\\t              \\\"ob_start\\\" 'php/bi-ob-start, \\\"ob_get_contents\\\" 'php/bi-ob-get-contents,\\n31\\t              \\\"ob_get_clean\\\" 'php/bi-ob-get-clean, \\\"ob_end_clean\\\" 'php/bi-ob-end-clean,\\n32\\t              \\\"ob_end_flush\\\" 'php/bi-ob-end-flush,\\n33\\t              \\\"header\\\" 'php/bi-header, \\\"headers_sent\\\" 'php/bi-headers-sent,\\n34\\t              \\\"http_response_code\\\" 'php/bi-http-response-code,\\n35\\t              \\\"setcookie\\\" 'php/bi-setcookie, \\\"setrawcookie\\\" 'ph