  574\t    (println \"php-src selection: phpt_selection.edn not generated yet (run yang.php.phpt on shiva)\")))\n   575\t\n   576\t\n   577\t(deftest ^:slow phpt-gc-013-stress-test\n   578\t  (run-phpt-stress-case \"Zend/tests/gc_013.phpt\"))\n   579\t\n   580\t\n   581\t(deftest ^:slow phpt-gc-023-stress-test\n   582\t  (run-phpt-stress-case \"Zend/tests/gc_023.phpt\"))\n   583\t\n   584\t\n   585\t(deftest ^:slow phpt-bug39438-stress-test\n   586\t  (run-phpt-stress-case \"Zend/tests/bug39438.phpt\"))\n   587\t\n   588\t\n   589\t(deftest ^:slow phpt-bug40261-stress-test\n   590\t  (run-phpt-stress-case \"Zend/tests/bug40261.phpt\"))\n   591\t\n   592\t\n   593\t(deftest ^:slow phpt-bug40809-stress-test\n   594\t  (run-phpt-stress-case \"Zend/tests/bug40809.phpt\"))\n   595\t\n   596\t\n   597\t(deftest ^:slow phpt-bug44069-stress-test\n   598\t  (run-phpt-stress-case \"Zend/tests/bug44069.phpt\"))\n   599\t\n   600\t\n   601\t(deftest ^:slow phpt-bug63055-stress-test\n   602\t  (run-phpt-stress-case \"Zend/tests/bug63055.phpt\"))\n   603\t\n   604\t\n   605\t(deftest ^:slow phpt-gc-012-stress-test\n   606\t  (run-phpt-stress-case \"Zend/tests/gc_012.phpt\"))\n   607\t\n   608\t\n   609\t(deftest ^:slow phpt-bug64660-stress-test\n   610\t  (run-phpt-stress-case \"Zend/tests/bug64660.phpt\"))\n   611\t\n   612\t\n   613\t(deftest gate-fix-programs-test\n   614\t  (testing \"var_dump of a self-referencing array terminates with *RECURSION*\"\n   615\t    (let [r (engine-result \"<?php $a = [1]; $a[0] = &$a; var_dump($a);\")]\n   616\t      (is (str/includes? (:out r) \"*RECURSION*\") (pr-str r))\n   617\t      (is (nil? (:uncaught r)))))\n   618\t  (testing \"comparing two cyclic arrays is a nesting Error\"\n   619\t    (is (= \"Nesting level too deep - recursive dependency?\"\n   620\t           (:out (engine-result\ncommit 2e5f7f2f54c5d993a9103373b7da9d816c5da712\nAuthor: Sonny To <son.c.to@gmail.com>\nDate:   Wed Nov 4 12:36:36 2026 +0700\n\n    test(yang.php): th