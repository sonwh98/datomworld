 'php.rt/next-ord '(cell/new 1))\\n5105\\t                 (define 'php.rt/finalizable '(cell/new []))\\n5106\\t                 (define 'php.rt/strict '(cell/new false))\\n5107\\t                 (define 'php.rt/exception-handler '(cell/new :php/null))\\n5108\\t                 (define 'php.rt/exception-handlers '(cell/new []))\\n5109\\t                 (define 'php.rt/class-order '(cell/new []))\\n5110\\t                 (define 'php.rt/shutdown-fns '(cell/new []))\\n5111\\t                 (define 'php.rt/pending-exc '(cell/new :php/null))\\n5112\\t                 (define 'php.rt/cmp-depth '(cell/new 0))\\n5113\\t                 (define 'php.rt/tmps '(cell/new []))\\n5114\\t                 (define 'php.rt/next-cell '(cell/new 1))\\n5115\\t                 (define 'php.rt/error-handler '(cell/new :php/null))\\n5116\\t                 ;; E_ALL\\n5117\\t                 (define 'php.rt/error-reporting '(cell/new 32767))\\n5118\\t                 (define 'php.rt/diag '(cell/new []))\\n5119\\t                 (define 'php.rt/included '(cell/new {}))\\n5120\\t                 (define 'php.rt/unit '(cell/new :php/null))\\n5121\\t                 (define 'php.rt/path-map '(cell/new {}))\\n5122\\t                 (define 'php.rt/class-map '(cell/new {}))\\n5123\\t                 (define 'php.rt/autoloaders '(cell/new []))\\n5124\\t                 (define 'php.rt/autoloading '(cell/new {}))\\n5125\\t                 (define 'php.rt/int-max\\n5126\\t                   '(integer/sub (integer/shift-left 1 63) 1))\\n5127\\t                 (define 'php.rt/int-min\\n5128\\t                   '(integer/neg (integer/shift-left 1 63)))\\n5129\\t                 ;; after the integer bounds: the seeds build integers\\n5130\\t                 (define 'php.rt/constants (list 'cell/new (constants-form)))]\\n5131\\t                [(cons 'do\\n5132\\t                       (mapv (fn [[nm sym]] (list 'php/register! nm sym))\\n5133\\t                             builtins))]\\n5134\\t                ;; last, so a failed init never reports ready\\n5135\\t                [(define 'php.rt/state :php/ready) :php/null])\\n5136\\t              :php/null)))\\n5137\\t\\n5138\\t\\n5139\\t(def definitions\\n5140\\t  \\\"The single definition list, `[store-key form]` in definition order: every\\n5141\\t   prelude function, the literal state slot, then `php/init!`. Defining them\\n5142\\t   runs nothing.\\\"\\n5143\\t  (into (into core-definitions module-defs/definitions)\\n5144\\t        [['php.rt/state :php/uninit]\\n5145\\t         ['php/init! (init-form)]]))\\n5146\\t\\n5147\\t\\n5148\\t(def functions-uast\\n5149\\t  \\\"The bundled shared-call definitions, PHP lambdas and literal state slot.\\\"\\n5150\\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form)))\\n5151\\t                    (into call/definitions definitions))))\\n5152\\t\\n5153\\t\\n5154\\t(def uast\\n5155\\t  \\\"The bundled prelude: every definition, then the task's runtime state\\n5156\\t   allocated by `php/init!`.\\\"\\n5157\\t  (u/then functions-uast (u/sexp->uast '(php/init!))))\\n5158\\t\\n5159\\t\\n5160\\t;; =============================================================================\\n5161\\t;; The module emitter: the same definition list as the linker module `php`\\n5162\\t;; =============================================================================\\n5163\\t\\n5164\\t(def module-name\\n5165\\t  \\\"The linker module the PHP runtime profile is published as.\\\"\\n5166\\t  'php)\\n5167\\t\\n5168\\t\\n5169\\t(def runtime-keys\\n5170\\t  \\\"Every key `php/init!` allocates, the ready flag aside, sorted.\\\"\\n5171\\t  '[php.rt/class-index php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/error-handler\\n5172\\t    php.rt/class-order php.rt/exception-handler php.rt/exception-handlers php.rt/finalizable php.rt/pending-exc\\n5173\\t    php.rt/shutdown-fns php.rt/strict php.rt/included php.rt/path-map php.rt/unit\\n5174\\t    php.rt/autoloaders php.rt/autoloading php.rt/class-map php.rt/constants\\n5175\\t    php.rt/error-reporting php.rt/functions php.rt/globals php.rt/int-max\\n5176\\t    php.rt/int-min php.rt/next-cell php.rt/next-ord\\n5177\\t    php.rt/out php.rt/tmps])\\n5178\\t\\n5179\\t\\n5180\\t(defn strip\\n5181\\t  \\\"`sym` without the module's own namespace `php`; `php.rt/*` stays\\n5182\\t   qualified.\\\"\\n5183\\t  [sym]\\n5184\\t  (core/strip \\\"php\\\" sym))\\n5185\\t\\n5186\\t\\n5187\\t(defn- binder-symbols\\n5188\\t  \\\"Every symbol a `fn` parameter list or `let` binding vector in `form`\\n5189\\t   binds.\\\"\\n5190\\t  [form]\\n5191\\t  (cond\\n5192\\t    (and (seq? form) (= 'fn (first form)))\\n5193\\t    (into (set (second form)) (mapcat binder-symbols) (drop 2 form))\\n5194\\t    (and (seq? form) (= 'let (first form)))\\n5195\\t    (into (set (take-nth 2 (second form)))\\n5196\\t          (mapcat binder-symbols)\\n5197\\t          (concat (take-nth 2 (rest (second form))) (drop 2 form)))\\n5198\\t    (coll? form) (into #{} (mapcat binder-symbols) (seq form))\\n5199\\t    :else #{}))\\n5200\\t\\n5201\\t\\n5202\\t(defn- unshadow\\n5203\\t  \\\"`form` with every local binder named like a module export renamed (`h` to\\n5204\\t   `h%l`): the module emitter strips `php/h` to the bare `h`, which a local\\n5205\\t   `h` would otherwise capture. Globals are qualified before stripping, so\\n5206\\t   every bare occurrence is the local.\\\"\\n5207\\t  [exports [k form]]\\n5208\\t  (let [clash (set (filter exports (binder-symbols form)))]\\n5209\\t    [k\\n5210\\t     (if (empty? clash)\\n5211\\t       form\\n5212\\t       (walk/postwalk (fn [x] (if (contains? clash x) (symbol (str x \\\"%l\\\")) x)) form))]))\\n5213\\t\\n5214\\t\\n5215\\t(def ^:private module-definitions\\n5216\\t  (core/module-definitions\\n5217\\t    \\\"php\\\" :php/uninit runtime-keys\\n5218\\t    (mapv (partial unshadow (into #{} (map (fn [[k _]] (strip k))) definitions)) definitions)))\\n5219\\t\\n5220\\t\\n5221\\t(def module-uast\\n5222\\t  \\\"The module tree: one application whose operands are the definitions, in\\n5223\\t   order. Defining runs nothing.\\\"\\n5224\\t  (core/module-tree module-definitions []))\\n5225\\t\\n5226\\t\\n5227\\t(def module-exports\\n5228\\t  \\\"The module's exports: every `php/` key of the definition list, stripped.\\\"\\n5229\\t  (core/exports \\\"php\\\" definitions))\"}\n{\"role\":\"assistant\",\"tool_calls\":[{\"type\":\"function\",\"id\":\"tool_glQo7fTLfCN3gARXHUybVLTR\",\"function\":{\"name\":\"Read\",\"arguments\":\"{\\\"path\\\":\\\"src/cljc/yang/php/antlr/prelude_module.cljc\\\",\\\"line_offset\\\":1,\\\"n_lines\\\":360}\"}}]}\n{\"role\":\"tool\",\"tool_call_id\":\"tool_glQo7fTLfCN3gARXHUybVLTR\",\"content\":\"1\\t(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\\n2\\t yang.php.antlr.prelude-module\\n3\\t  \\\"The include/require runtime of the PHP profile (docs/design/yang.php.md\\n4\\t   section 11, plan P6 R3/R4): the four kinds, the `_once` check, the two\\n5\\t   missing stages. Guest code like the rest of the prelude; the lowering\\n6\\t   emits only applications of these names.\\n7\\t\\n8\\t   Runtime state `php/init!` allocates for it (prelude.cljc owns the keys):\\n9\\t     php.rt/included   a cell, map of normalized path to true; written on\\n10\\t                       `:ok` delivery only, never on a refusal\\n11\\t     php.rt/unit       a cell, the executing unit's path or :php/null\\n12\\t     php.rt/path-map   a cell, map of normalized path to a delivery thunk\\n13\\t                       (the literal path map of the composition's `:paths`)\\\"\\n14\\t  (:require\\n15\\t    #?(:cljd [clojure.edn :as edn])\\n16\\t    [yang.php.antlr.quoted :refer [defquoted]]))\\n17\\t\\n18\\t\\n19\\t(def include-path-text\\n20\\t  \\\"The `include_path` the missing-include texts print: the oracle image's\\n21\\t   default. PENDING the S0 oracle pin (php:8.3-cli reports\\n22\\t   `.:/usr/local/lib/php`).\\\"\\n23\\t  \\\".:/usr/local/lib/php\\\")\\n24\\t\\n25\\t\\n26\\t(def include-kinds\\n27\\t  \\\"The four kinds the lowering passes to `php/include-run`.\\\"\\n28\\t  #{:include :include-once :require :require-once})\\n29\\t\\n30\\t\\n31\\t(defquoted ^:private module-forms\\n32\\t  \\\"The include definitions, `[store-key form]`.\\\"\\n33\\t  '[[php/include-kind-name\\n34\\t     (fn [kind]\\n35\\t       (if (= kind :include)\\n36\\t         \\\"include\\\"\\n37\\t         (if (= kind :include-once)\\n38\\t           \\\"include_once\\\"\\n39\\t           (if (= kind :require) \\\"require\\\" \\\"require_once\\\"))))]\\n40\\t    [php/include-require?\\n41\\t     (fn [kind] (if (= kind :require) true (= kind :require-once)))]\\n42\\t    [php/include-once?\\n43\\t     (fn [kind] (if (= kind :include-once) true (= kind :require-once)))]\\n44\\t    [php/warn-refusal\\n45\\t     ;; php/warn with the structured refusal on the record (plan R4)\\n46\\t     (fn [errno msg refusal]\\n47\\t       (let [rec (assoc (php/warn-record errno msg) :yang.php/refusal refusal)\\n48\\t             h (cell/get php.rt/error-handler)]\\n49\\t         (if (= h :php/null)\\n50\\t           (php/warn-sink rec)\\n51\\t           (if (= (php/invoke-handler h errno msg) false)\\n52\\t             (php/warn-sink rec)\\n53\\t             :php/null))))]\\n54\\t    [php/include-missing!\\n55\\t     ;; the refusal map follows the base kind; the texts carry the kind as\\n56\\t     ;; written; a refused path is never marked included\\n57\\t     (fn [path kind refusal]\\n58\\t       (let [nm (php/include-kind-name kind)]\\n59\\t         (do (php/warn-refusal\\n60\\t               2\\n61\\t               (data/str-concat\\n62\\t                 (data/str-concat (data/str-concat nm \\\"(\\\") path)\\n63\\t                 \\\"): Failed to open stream: No such file or directory\\\")\\n64\\t               refusal)\\n65\\t             (if (php/include-require? kind)\\n66\\t               (php/throw-error\\n67\\t                 \\\"Error\\\"\\n68\\t                 (data/str-concat\\n69\\t                   (data/str-concat\\n70\\t                     (data/str-concat \\\"Failed opening required '\\\" path)\\n71\\t                     \\\"' (include_path='\\\")\\n72\\t                   (data/str-concat php/include-path \\\"')\\\")))\\n73\\t               (do (php/warn-refusal\\n74\\t                     2\\n75\\t                     (data/str-concat\\n76\\t                       (data/str-concat\\n77\\t                         (data/str-concat\\n78\\t                           (data/str-concat nm \\\"(): Failed opening '\\\")\\n79\\t                           path)\\n80\\t                         \\\"' for inclusion (include_path='\\\")\\n81\\t                       (data/str-concat php/include-path \\\"')\\\"))\\n82\\t                     refusal)\\n83\\t                   false)))))]\\n84\\t    [php/include-body\\n85\\t     ;; marks the path before the body runs, names the unit while it runs,\\n86\\t     ;; answers the body's `return` value, else 1\\n87\\t     (fn [path delivered scope ctx]\\n88\\t       (let [prev (cell/get php.rt/unit)]\\n89\\t         (do (cell/set! php.rt/included (assoc (cell/get php.rt/included) path true))\\n90\\t             (cell/set! php.rt/unit path)\\n91\\t             (php/try-finally\\n92\\t               (fn []\\n93\\t                 (let [v ((get delivered :body) scope ctx)]\\n94\\t                   (if (= v :php/no-return) 1 v)))\\n95\\t               (fn [x] (cell/set! php.rt/unit prev))))))]\\n96\\t    [php/include-run\\n97\\t     ;; `thunk` answers {:status :ok :body b} or the structured refusal\\n98\\t     (fn [path thunk kind scope ctx]\\n99\\t       (if (if (php/include-once? kind)\\n100\\t             (not (nil? (get (cell/get php.rt/included) path)))\\n101\\t             false)\\n102\\t         true\\n103\\t         (let [r (thunk)]\\n104\\t           (if (= (get r :status) :ok)\\n105\\t             (php/include-body path r scope ctx)\\n106\\t             (php/include-missing! path kind r)))))]\\n107\\t    [php/normalize-path\\n108\\t     ;; the computed arm's lookup key: leading \\\"./\\\" segments dropped\\n109\\t     (fn [s]\\n110\\t       (if (if (>= (data/str-length s) 2) (= (data/substring s 0 2) \\\"./\\\") false)\\n111\\t         (php/normalize-path (data/substring s 2))\\n112\\t         s))]\\n113\\t    [php/include-computed\\n114\\t     ;; a computed path is a run-time lookup in the published path map; a\\n115\\t     ;; miss is the run-time missing-include behaviour for the kind\\n116\\t     (fn [pathv kind scope ctx]\\n117\\t       (let [path (php/normalize-path (php/to-string pathv))\\n118\\t             thunk (get (cell/get php.rt/path-map) path)]\\n119\\t         (php/include-run\\n120\\t           path\\n121\\t           (if (nil? thunk)\\n122\\t             (fn []\\n123\\t               (assoc (assoc {} :status :refused)\\n124\\t                      :reason :yang.php/computed-path-unmapped))\\n125\\t             thunk)\\n126\\t           kind\\n127\\t           scope\\n128\\t           ctx)))]\\n129\\t    ;; ---------------------------------------------------------------- scopes\\n130\\t    ;; An including scope is `:php/globals` (the entry unit's top level) or a\\n131\\t    ;; scope cell: name to the variable's own cell, in insertion order. A\\n132\\t    ;; dynamic-profile function adopts the cells its body already holds, so an\\n133\\t    ;; included body and the function see one variable.\\n134\\t    [php/scope-new\\n135\\t     (fn [] (cell/new (assoc (assoc {} :cells {}) :order [])))]\\n136\\t    [php/scope-adopt!\\n137\\t     (fn [d name c]\\n138\\t       (let [s (cell/get d)]\\n139\\t         (do (cell/set! d (assoc (assoc s :cells (assoc (get s :cells) name c))\\n140\\t                                 :order (php/vconj (get s :order) name)))\\n141\\t             c)))]\\n142\\t    [php/scope-cell\\n143\\t     (fn [d name]\\n144\\t       (let [c (get (get (cell/get d) :ce