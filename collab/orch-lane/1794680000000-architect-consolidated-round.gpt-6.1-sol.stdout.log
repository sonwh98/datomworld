vconj (php/vconj (php/vconj [] kind) payload) rest)\n   182\t                             (+ 1 (php/frame-depth rest)))\n   183\t                  (get (cell/get php.rt/ctx) :depth)))]\n   184\t    [php/pop-frame\n   185\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\n   186\t     (fn [hs]\n   187\t       (cell/set! php.rt/ctx\n   188\t                  (assoc (assoc (cell/get php.rt/ctx) :handlers (get hs 2))\n   189\t                         :depth (get hs 4))))]\n   190\t    [php/raise\n   191\t     ;; deliver the error to the innermost handler, running each :finally\n   192\t     ;; thunk it unwinds through; the unit root always installs a handler,\n   193\t     ;; so an empty stack is a defect and answers the error\n   194\t     (fn [e]\n   195\t       (let [hs (php/handlers)]\n   196\t         (if (nil? hs)\n   197\t           e\n   198\t           (if (= (get hs 0) :finally)\n   199\t             (do (php/pop-frame hs)\n   200\t                 ((get hs 1) e)\n   201\t                 (php/raise e))\n   202\t             ((get hs 1) e)))))]\n   203\t    [php/unwind-to\n   204\t     ;; pop frames above frame count n, running each finally thunk with null\n   205\t     (fn [n]\n   206\t       (let [hs (php/handlers)]\n   207\t         (if (nil? hs)\n   208\t           :php/null\n   209\t           (if (<= (get hs 3) n)\n   210\t             :php/null\n   211\t             (do (php/pop-frame hs)\n   212\t                 (if (= (get hs 0) :finally) ((get hs 1) :php/null) :php/null)\n   213\t                 (php/unwind-to n))))))]\n   214\t    [php/abandon-to\n   215\t     ;; pop frames above frame count n WITHOUT running :finally thunks: the\n   216\t     ;; terminal root escapes (operational fatal, exit) bypass guest\n   217\t     ;; handlers, returns and finalizers\n   218\t     (fn [n]\n   219\t       (let [hs (php/handlers)]\n   220\t         (if (nil? hs)\n   221\t           :php/null\n   222\t           (if (<= (get hs 3) n)\n   223\t             :php/null\n   224\t             (do (php/pop-frame hs)\n   225\t                 (php/abandon-to n))))))]\n   226\t    [php/call-terminal\n   227\t     ;; `f` receives a terminal escape: invoking it abandons to here and\n   228\t     ;; answers its argument as this call's value, skipping :finally thunks\n   229\t     (fn [f]\n   230\t       (let [saved (cell/get php.rt/ctx)\n   231\t             flag (cell/new :first)]\n   232\t         ((fn [r]\n   233\t            (if (= (cell/get flag) :first)\n   234\t              (do (cell/set! flag :re-entered)\n   235\t                  (f (fn [x]\n   236\t                       (do (php/abandon-to (php/frame-depth (get saved :handlers)))\n   237\t                           (php/restore! saved)\n   238\t                           (r x)))))\n   239\t              r))\n   240\t          (%capture))))]\n   241\t    [php/try\n   242\t     (fn [body handler orelse]\n   243\t       (let [saved (cell/get php.rt/ctx)\n   244\t             flag (cell/new :first)]\n   245\t         ((fn [r]\n   246\t            (if (= (cell/get flag) :first)\n   247\t              (do (cell/set! flag :re-entered)\n   248\t                  (php/set-handlers! (php/frame :handler r (get saved :handlers)))\n   249\t                  (body)\n   250\t                  (php/restore! saved)\n   251\t                  (orelse))\n   252\t              (do (php/restore! saved)\n   253\t                  (handler r))))\n   254\t          (%capture))))]\n   255\t    [php/try-finally\n   256\t     ;; normal exit runs `fin` here; raise and escapes run it as they\n   257\t     ;; unwind through the :finally frame\n   258\t     (fn [body fin]\n   259\t       (let [saved (cell/get php.rt/ctx)]\n   260\t         (do (php/set-handlers! (php/frame :finally fin (get saved :handlers)))\n   261\t             (let [v (body)]\n   262\t               (do (php/restore! saved)\n   263\t                   (fin :php/null)\n   264\t                   v)))))]\n   265\t    [php/call-ec\n   266\t     ;; `f` receives an escape: calling it unwinds to here and answers its\n   267\t     ;; argument as this call's value (break, continue, return)\n   268\t     (fn [f]\n   269\t       (let [saved (cell/get php.rt/ctx)\n   270\t             flag (cell/new :first)]\n   271\t         ((fn [r]\n   272\t            (if (= (cell/get flag) :first)\n   273\t              (do (cell/set! flag :re-entered)\n   274\t                  (f (fn [x]\n   275\t                       (do (php/unwind-to (php/frame-depth (get saved :handlers)))\n   276\t                           (php/restore! saved)\n   277\t                           (r x)))))\n   278\t              r))\n   279\t          (%capture))))]\n   280\t\n   281\t    ;; ---------------------------------------------------------------- errors\n   282\t    [php/make-error\n   283\t     (fn [cls msg]\n   284\t       (let [c (php/class-lookup cls)]\n   285\t         (if (if (nil? c) true (= (data/count (get c :methods)) 0))\n   286\t           (php/make-error-map cls msg)\n   287\t           (let [o (php/instantiate c)]\n   288\t             (do (php/obj-set-props! o (php/table-set (get (php/obj-state o) :props) \"message\" msg))\n   289\t                 o)))))]\n   290\t    [php/make-error-map\n   291\t     (fn [cls msg]\n   292\t       (let [n (cell/get php.rt/next-ord)]\n   293\t         (do (cell/set! php.rt/next-ord (+ n 1))\n   294\t             (assoc (assoc (assoc (assoc {} :php/type :obj) :class cls) :ord n)\n   295\t                    :props\n   296\t                    (assoc (assoc (assoc {} \"message\" msg) \"code\" 0)\n   297\t                           \"previous\" :php/null)))))]\n   298\t    [php/throw-error (fn [cls msg] (php/raise (php/make-error cls msg)))]\n   299\t    [php/snapshot-exc\n   300\t     (fn [e]\n   301\t       (if (nil? (get e :php/obj))\n   302\t         (assoc (assoc {} :class (get e :class))\n   303\t                :message (get (get e :props) \"message\"))\n   304\t         (assoc (assoc {} :class (get (php/obj-state e) :class))\n   305\t                :message (php/prop-raw e \"message\"))))]\n   306\t    [php/warn-record\n   307\t     (fn [errno msg]\n   308\t       (assoc (assoc (assoc {} :php.diag/warning true) :errno errno)\n   309\t              :message msg))]\n   310\t    [php/warn-sink\n   311\t     ;; a diagnostic record on php.rt/diag when the mask admits it\n   312\t     (fn [rec]\n   313\t       (if (= (integer/bit-and (get rec :errno) (cell/get php.rt/error-reporting))\n   314\t              0)\n   315\t         :php/null\n   316\t         (cell/set! php.rt/diag (php/vconj (cell/get php.rt/diag) rec))))]\n   317\t    [php/invoke-handler\n   318\t     ;; the user handler is unset while it runs, so its own warnings go to\n   319\t     ;; the sink, and restored when it returns or an escape unwinds through it\n   320\t     (fn [h errno msg]\n(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\n(ns yang.php.antlr.safepoint-test\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.safepoint :as hooks]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(defn- every-vm=\n  [expected results]\n  (doseq [k vms]\n    (is (= expected (get results k)) (name k))))\n\n\n(deftest exhaustion-is-an-operational-fatal-test\n  (let [source (str \"<?php class C { function __destruct() { echo 'D'; } } \"\n                    \"$c = new C; try { while (true) {} } \"\n                    \"catch (Throwable $e) { echo 'C'; }\")]\n    (every-vm= (str \"PHP Fatal error:  \" hooks/fatal-text)\n               (h/run-php source {:execution-budget 4}))))\n\n\n(deftest exhaustion-inside-try-finally-is-fatal-test\n  (let [source (str \"<?php function g() { yield 1; } \"\n                    \"try { while (true) {} } finally { echo 'F'; }\")]\n    (every-vm= (str \"PHP Fatal error:  \" hooks/fatal-text)\n               (h/run-php source {:execution-budget 4}))))\n\n\n(deftest exhaustion-in-shutdown-is-fatal-test\n  (let [source (str \"<?php register_shutdown_function(function() { while (true) {} });\"\n                    \" echo 'A';\")]\n    (every-vm= (str \"A\" \"PHP Fatal error:  \" hooks/fatal-text)\n               (h/run-php source {:execution-budget 4}))))\n\n\n(deftest budget-validation-test\n  (is (thrown? clojure.lang.ExceptionInfo (hooks/program -1 nil)))\n  (is (thrown? clojure.lang.ExceptionInfo (hooks/program 1.5 nil)))\n  (is (thrown? clojure.lang.ExceptionInfo (hooks/program \"4\" nil))))\n\n\n(deftest unbounded-and-unexhausted-runs-agree-test\n  (let [source \"<?php function f($x) { return $x + 1; } $i = 0; while ($i < 5) { $i = f($i); } echo $i;\"\n        unbounded (h/run-php source)]\n    (testing \"the default remains unbudgeted\"\n      (every-vm= \"5\" unbounded))\n    (testing \"a budget that is not exhausted is unobservable\"\n      (is (= unbounded (h/run-php source {:execution-budget 100}))))))\n","exit_code":0,"status":"completed"}}
