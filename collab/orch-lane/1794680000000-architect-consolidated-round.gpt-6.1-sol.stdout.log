336\t                    (and (vector? v) (= :float (first v)))\n  5337\t                    (list 'php/f (list 'data/float-value (nth v 2)))\n  5338\t                    :else v)))\n  5339\t          {}\n  5340\t          (sort-by key builtins/constants)))\n  5341\t\n  5342\t\n  5343\t(defn- init-form\n  5344\t  \"`php/init!`'s body: the runtime cells, the builtins, the ready flag, under\n  5345\t   the uninit guard.\"\n  5346\t  []\n  5347\t  (list 'fn []\n  5348\t        (list 'if (list '= 'php.rt/state :php/uninit)\n  5349\t              (concat\n  5350\t                ['do\n  5351\t                 (define 'php.rt/ctx '(cell/new (php/ctx nil 0 0 nil)))\n  5352\t                 (define 'php.rt/out '(cell/new [[]]))\n  5353\t                 (define 'php.rt/request '(cell/new {}))\n  5354\t                 (define 'php.rt/response '(cell/new []))\n  5355\t                 (define 'php.rt/headers-sent '(cell/new false))\n  5356\t                 (define 'php.rt/status '(cell/new 200))\n  5357\t                 (define 'php.rt/error-handlers '(cell/new []))\n  5358\t                 (define 'php.rt/globals\n  5359\t                   '(cell/new (php/empty-array)))\n  5360\t                 (define 'php.rt/functions '(cell/new {}))\n  5361\t                 (define 'php.rt/classes (list 'cell/new seed-table))\n  5362\t                 (define 'php.rt/class-index\n  5363\t                   (list 'cell/new\n  5364\t                         (into {} (map (fn [nm] [(str/lower-case nm) nm])) (keys seed-table))))\n  5365\t                 (define 'php.rt/next-ord '(cell/new 1))\n  5366\t                 (define 'php.rt/finalizable '(cell/new []))\n  5367\t                 (define 'php.rt/strict '(cell/new false))\n  5368\t                 (define 'php.rt/exception-handler '(cell/new :php/null))\n  5369\t                 (define 'php.rt/exception-handlers '(cell/new []))\n  5370\t                 (define 'php.rt/class-order '(cell/new []))\n  5371\t                 (def