s]\ntest/yin/repl/main_test.cljc:861:       (let [deadline (+ (System/currentTimeMillis) timeout-ms)]\ntest/yin/repl/main_test.cljc:877:       [peer command kind timeout-ms]\ntest/yin/repl/main_test.cljc:881:       (take-reply! peer kind timeout-ms))\ntest/yin/repl/main_test.cljc:930:       [peer pred timeout-ms]\ntest/yin/repl/main_test.cljc:931:       (let [deadline (+ (System/currentTimeMillis) timeout-ms)]\ntest/yin/repl/main_test.cljc:944:       [peer timeout-ms]\ntest/yin/repl/main_test.cljc:945:       (let [deadline (+ (System/currentTimeMillis) timeout-ms)]\ntest/yin/repl/main_test.cljc:957:       [a needle timeout-ms]\ntest/yin/repl/main_test.cljc:958:       (let [deadline (+ (System/currentTimeMillis) timeout-ms)]\ntest/yin/repl/main_test.cljc:1016:       ^:slow evaluation-round-trips-and-two-clients-get-their-own-answers\ntest/yin/repl/main_test.cljc:1034:     (deftest ^:slow killing-the-connection-is-observable-and-requests-are-lost\ntest/yin/repl/main_test.cljc:1064:     (deftest ^:slow reattaching-resumes-the-served-stream-and-the-deposit-medium\ntest/yin/repl/main_test.cljc:1100:     (deftest ^:slow stopping-the-endpoint-ends-the-served-stream-not-closes-it\ntest/yin/repl/main_test.cljc:1186:       [pred timeout-ms message]\ntest/yin/repl/main_test.cljc:1189:           (let [deadline (+ (js/Date.now) timeout-ms)]\ntest/yin/repl/main_test.cljc:1196:                           :else (js/setTimeout tick 20))))]\ntest/yin/repl/main_test.cljc:1396:(deftest ^:slow every-vm-is-selectable-and-answers-through-the-streams\ntest/yin/repl/main_test.cljc:1397:  (slow/guard\ntest/yin/repl/main_test.cljc:1763:  owing nothing) holds or the `stop-ticks` budget ends.  Answers\ntest/yin/repl/main_test.cljc:1764:  `[state server spent-budget?]`.\"\ntest/yin/repl/main_test.cljc:1854:            \"the delivered release ended the drain, well inside the budget\")\ntest/yin/repl/main_test.cljc:1869:  ;; ends every sleep at once cannot spend the stop-ticks budget early.  A\ntest/yin/repl/main_test.cljc:1889:            \"exactly the stop-ticks budget of rounds: one control tick for the\ntest/yin/repl/main_test.cljc:1890:             stopping tick, one per drain round and the budget's last round,\ntest/yin/repl/main_test.cljc:1898:            \"the budget ran out once and said so once\"))\ntest/yin/repl/main_test.cljc:1903:(deftest ^:slow a-release-held-back-for-the-whole-drain-stays-durable-and-a-restart-sends-it-test\ntest/yin/repl/main_test.cljc:1904:  (slow/guard\ntest/yin/repl/main_test.cljc:1917:                ;; stepping for the owed release until the budget ends\ntest/yin/repl/main_test.cljc:1925:                \"the owed release held the drain open for the whole budget: the\ntest/yin/repl/main_test.cljc:1926:             budget, not the endpoint and not the release, ended it\")\ntest/yin/repl/main_test.cljc:1929:             tick, the whole budget, and the budget's own last tick\")\ntest/yin/repl/main_test.cljc:2010:                release -- not the budget -- ended it\")\ntest/yin/repl/main_test.cljc:2032:        at most `budget` ticks, then disarm it: the host loop's real\ntest/yin/repl/main_test.cljc:2035:       [w pred budget]\ntest/yin/repl/main_test.cljc:2037:         (when (and (not (pred)) (< n budget))\ntest/yin/repl/main_test.cljc:2063:                 \"the delivered release -- not the budget -- ended the drain\")\ntest/yin/repl/main_test.cljc:2070:     (deftest the-node-loop-spends-its-whole-drain-budget-while-custody-still-owes-test\ntest/yin/repl/main_test.cljc:2080:                 \"the budget, never the owed write alone, ends the drain\")\ntest/yin/repl/main_test.cljc:2084:                    tick, the whole budget, and the budget's own last tick\")\ntest/yin/repl/main_test.cljc:2086:                   \"the stream stayed full for the whole budget\")))\ntest/yin/repl/main_test.cljc:2095:        at most `budget` ticks, then disarm it: the host loop's real\ntest/yin/repl/main_test.cljc:2098:       [w pred budget]\ntest/yin/repl/main_test.cljc:2100:         (when (and (not (pred)) (< n budget))\ntest/yin/repl/main_test.cljc:2124:                 \"the delivered release -- not the budget -- ended the drain\")\ntest/yin/repl/main_test.cljc:2131:     (deftest the-dart-loop-spends-its-whole-drain-budget-while-custody-still-owes-test\ntest/yin/repl/main_test.cljc:2141:                 \"the budget, never the owed write alone, ends the drain\")\ntest/yin/repl/main_test.cljc:2145:                    tick, the whole budget, and the budget's own last tick\")\ntest/yin/repl/main_test.cljc:2147:                   \"the stream stayed full for the whole budget\")))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' test/yang/php/antlr/e2e_test.clj && sed -n '1,260p' test/yang/php/antlr/e2e_harness.clj && sed -n '1910,1965p' docs/design/yang.php.md && rg -n \\\"defn run_vm|run_vm\\\" test/yang/php -g '*.clj*' && rg -n \\\"yang.php.antlr.e2e-test|phpt-selection|phpt_selection\\\" deps.edn test scripts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' test/yang/php/antlr/e2e_test.clj && sed -n '1,260p' test/yang/php/antlr/e2e_harness.clj && sed -n '1910,1965p' docs/design/yang.php.md && rg -n \\\"defn run_vm|run_vm\\\" test/yang/php -g '*.clj*' && rg -n \\\"yang.php.antlr.e2e-test|phpt-selection|phpt_selection\\\" deps.edn test scripts\"","aggregated_output":"(ns yang.php.antlr.e2e-test\n  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n   envelope -> the bundled program on each of the four VMs (the AST walker,\n   the semantic, stack and register VMs). Every fixture of\n   `yang.php.antlr.programs` prints the same text on all four.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.packets-p3b :as packets-p3b]\n    [yang.php.antlr.permutations :as perms]\n    [yang.php.antlr.phpt :as phpt]\n    [yang.php.antlr.programs :as programs]\n    [yang.php.antlr.programs-p3b :as p3b]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(defn- rendered\n  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n  [{:keys [out uncaught]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(deftest ^:slow fixtures-on-every-vm-test\n  (doseq [{:keys [id source] :as fixture} programs/fixtures\n          :let [out (rendered fixture)]]\n    (testing (name id)\n      (let [results (h/run-php source)]\n        (is (not (contains? results :diagnostics)) (pr-str results))\n        (doseq [k vms]\n          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n\n\n(deftest fixtures-on-the-walker-test\n  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n          :let [r (h/run-raw source)]]\n    (is (not= :pending oracle) (name id))\n    (is (= out (h/latin1->text (:php/out r))) (name id))\n    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n        (name id))))\n\n\n(deftest packets-match-source-test\n  (doseq [[id form] packets/forms\n          :let [{:keys [source]} (first (filter #(= id (:id %)) programs/fixtures))]]\n    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\n\n\n(defn- matrix-rows\n  [out]\n  (let [[eq sp] (str/split-lines out)\n        w (count programs/matrix-values)]\n    {:eq (mapv #(apply str %) (partition w eq)),\n     :sp (mapv #(apply str (map {\\0 \"<\", \\1 \"=\", \\2 \">\"} %)) (partition w sp))}))\n\n\n(deftest scalar-comparison-matrix-test\n  (let [{:keys [eq sp]} (matrix-rows (h/run-walker programs/matrix-source))]\n    (is (= programs/equal-matrix eq))\n    (is (= programs/spaceship-matrix sp))\n    (testing \"cells reasoned from the manual, independent of the golden\"\n      (let [idx (zipmap programs/matrix-values (range))]\n        (doseq [[a b eq? cmp] programs/known-cells\n                :let [i (idx a), j (idx b)]]\n          (is (= (if eq? \\1 \\0) (get-in eq [i j])) (str a \" == \" b))\n          (is (= (get {-1 \\<, 0 \\=, 1 \\>} cmp) (get-in sp [i j])) (str a \" <=> \" b)))))))\n\n\n(deftest float-text-test\n  (let [src (str \"<?php\\n\"\n                 (apply str (for [[lit] programs/float-cases]\n                              (str \"echo \" lit \", \\\"|\\\"; var_dump(\" lit \");\\n\"))))\n        expected (str (apply str (for [[_ echo dump] programs/float-cases]\n                                   (str echo \"|float(\" dump \")\\n\"))))]\n    (is (= expected (h/run-walker src)))))\n\n\n(deftest refusals-are-named-test\n  (doseq [[source construct]\n          [[\"<?php $a = &f();\" :reference-source]\n           [\"<?php $$a[0] = 1;\" :assignment-target]\n           [\"<?php function f(int ...$a) {}\" :typed-variadic]\n           [\"<?php function f(&...$a) {}\" :variadic-reference]\n           [\"<?php $a = &new B;\" :reference]\n           [\"<?php static $a = 1;\" :static]\n           [\"<?php echo FOO;\" :constant]\n           [\"<?php echo \\\"a$b[0]\\\";\" :interpolation]\n           [\"<?php echo \\\"a$b->c\\\";\" :interpolation]\n           [\"<?php echo (array)1;\" :cast/array]\n           [\"<?php $o = new class { public $x = 1; };\" :anonymous-class]]\n          :when construct]\n    (let [{:keys [diagnostics]} (h/run-php source)\n          d (first diagnostics)]\n      (is (= :yang.php/unsupported (:yang.php/diagnostic d)) source)\n      (is (= construct (:construct d)) source))))\n\n\n(deftest leading-numeric-string-warns-test\n  (let [r (h/run-raw \"<?php echo \\\"5 apples\\\" + 1;\")]\n    (is (= \"6\" (:php/out r)))\n    (is (= [{:php.diag/warning true,\n             :errno 2,\n             :message \"A non-numeric value encountered\"}]\n           (:php/diag r)))\n    (is (nil? (:php/uncaught r))))\n  (testing \"a well formed numeric string does not warn\"\n    (is (= [] (:php/diag (h/run-raw \"<?php echo \\\" 5 \\\" + 1;\"))))))\n\n\n(deftest pow-fractional-refusal-test\n  (testing \"G-pow-frac: a fractional exponent refuses at run time, with the ledger id\"\n    (let [r (h/run-raw \"<?php echo 2 ** 0.5;\")]\n      (is (= \"Error\" (-> r :php/uncaught :class)))\n      (is (= \"** with a fractional exponent is not supported yet (yang.php known gap G-pow-frac)\"\n             (-> r :php/uncaught :message))))))\n\n\n(deftest compile-errors-are-named-test\n  (doseq [[source fragment]\n          [[\"<?php break;\" \"'break' not in the 'loop' or 'switch' context\"]\n           [\"<?php function f() { while (1) { } break; }\"\n            \"'break' not in the 'loop' or 'switch' context\"]\n           [\"<?php while (1) { break 0; }\" \"'break' operator accepts only positive integers\"]\n           [\"<?php while (1) { continue 0; }\" \"'continue' operator accepts only positive integers\"]\n           [\"<?php while (1) { break 2; }\" \"Cannot 'break' 2 levels\"]\n           [\"<?php while (1) { while (1) { continue 3; } }\" \"Cannot 'continue' 3 levels\"]\n           [\"<?php while (1) { break; } while (1) { break 2; }\" \"Cannot 'break' 2 levels\"]\n           [\"<?php $n = 1; while (1) { break $n; }\" \"non-integer operand\"]\n           [\"<?php function f() {} function F() {}\" \"Cannot redeclare F()\"]\n           [\"<?php function strlen() {}\" \"Cannot redeclare strlen()\"]\n           [\"<?php class A { public int $x = 'bad'; }\"\n            \"Cannot use string as default value for property A::$x of type int\"]\n           [\"<?php class A { public static float $x = 'bad'; }\"\n            \"Cannot use string as default value for property A::$x of type float\"]\n           [\"<?php class A { public int $x = null; }\"\n            \"Default value for property of type int may not be null. Use the nullable type ?int to allow null default value\"]\n           [\"<?php class A { public int $x = 1.5; }\"\n            \"Cannot use float as default value for property A::$x of type int\"]\n           [\"<?php class A { public int $x = -1.5; }\"\n            \"Cannot use float as default value for property A::$x of type int\"]\n           [\"<?php class A { public int $x = []; }\"\n            \"Cannot use array as default value for property A::$x of type int\"]\n           [\"<?php class A { public array $x = 1; }\"\n            \"Cannot use int as default value for property A::$x of type array\"]\n           [\"<?php function f(int $x = 1.5) {}\"\n            \"Cannot use float as default value for parameter $x of type int\"]\n           [\"<?php function f(int $x = 'bad') {}\"\n            \"Cannot use string as default value for parameter $x of type int\"]\n           [\"<?php switch (1) { default: echo 1; default: echo 2; }\"\n            \"Switch statements may only contain one default clause\"]\n           [\"<?php switch (1): default: echo 1; case 2: break; default: echo 2; endswitch;\"\n            \"Switch statements may only contain one default clause\"]\n           [\"<?php function f() { switch (1) { default: break; default: break; } }\"\n            \"Switch statements may only contain one default clause\"]\n           [\"<?php echo $a[];\" \"Cannot use [] for reading\"]\n           [\"<?php $a[] += 1;\" \"Cannot use [] for reading\"]\n           [\"<?php $a[]++;\" \"Cannot use [] for reading\"]\n           [\"<?php $a[] ??= 1;\" \"Cannot use [] for reading\"]\n           [\"<?php echo $a[0][] ?? 1;\" \"Cannot use [] for reading\"]\n           [\"<?php echo isset($a[]);\" \"Cannot use [] for reading\"]\n           [\"<?php unset($a[]);\" \"Cannot use [] for unsetting\"]]]\n    (let [{:keys [diagnostics]} (h/run-php source)\n          d (first diagnostics)]\n      (is (= :yang.php/compile-error (:yang.php/diagnostic d)) source)\n      (is (str/includes? (str (:message d)) fragment) source))))\n\n\n(deftest lowering-warnings-test\n  (testing \"a catalogue function the prelude lacks warns, and the program lowers\"\n    (let [{:keys [ast warnings]} (h/lower-program \"<?php echo strtoupper(\\\"a\\\");\")]\n      (is (some? ast))\n      (is (= [{:yang.php/diagnostic :yang.php/unknown-builtin,\n               :severity :warning,\n               :name \"strtoupper\"}]\n             (mapv #(select-keys % [:yang.php/diagnostic :severity :name]) warnings)))\n      (testing \"and the call is an Error at run time\"\n        (is (= \"PHP Fatal error:  Uncaught Error: Call to undefined function strtoupper()\"\n               (h/run-walker \"<?php echo strtoupper(\\\"a\\\");\"))))))\n  (testing \"a unit that declares the function, or a prelude builtin, does not\"\n    (is (empty? (:warnings (h/lower-program\n                             \"<?php function strtoupper($s) { return $s; } echo STRTOUPPER(\\\"a\\\");\"))))\n    (is (empty? (:warnings (h/lower-program \"<?php echo strlen(\\\"a\\\");\"))))\n    (is (empty? (:warnings (h/lower-program \"<?php echo not_a_php_function(1);\")))))\n  (testing \"continue aimed at a switch is a break and says so\"\n    (let [{:keys [warnings]}\n          (h/lower-program \"<?php for (;;) { switch (1) { case 1: continue; } break; }\")]\n      (is (= [:yang.php/compile-warning] (mapv :yang.php/diagnostic warnings))))\n    (is (= \"ab\" (h/run-walker \"<?php switch (1) { case 1: echo \\\"a\\\"; continue; echo \\\"no\\\"; } echo \\\"b\\\";\")))))\n\n\n(deftest undefined-variable-warns-test\n  (let [r (h/run-raw \"<?php echo $a; function f() { return $b; } echo f() ?? \\\"n\\\";\")]\n    (is (= \"n\" (:php/out r)))\n    (is (= [\"Undefined variable $a\" \"Undefined variable $b\"] (mapv :message (:php/diag r))))\n    (is (= [2 2] (mapv :errno (:php/diag r)))))\n  (testing \"isset, empty and ?? do not warn\"\n    (is (= [] (:php/diag (h/run-raw \"<?php isset($a); empty($a); echo $a ?? 1;\")))))\n  (testing \"a local read of an unset local warns, a static is its own slot\"\n    (is (= [\"Undefined variable $x\"]\n           (mapv :message\n                 (:php/diag (h/run-raw \"<?php function f() { $x = 1; unset($x); return $x; } f();\")))))))\n\n\n(deftest error-handler-test\n  (testing \"the handler sees the errno and message and may take the warning\"\n    (let [r (h/run-raw (str \"<?php function h($n, $s) { echo $n, $s, \\\";\\\"; return true; }\"\n                            \" set_error_handler('h'); echo $u;\"))]\n      (is (= \"2Undefined variable $u;\" (:php/out r)))\n      (is (= [] (:php/diag r)))))\n  (testing \"a handler that returns false falls through to the default sink\"\n    (let [r (h/run-raw (str \"<?php function h($n, $s) { return false; }\"\n                            \" set_error_handler('h'); echo $u;\"))]\n      (is (= [\"Undefined variable $u\"] (mapv :message (:php/diag r))))))\n  (testing \"@ silences the default sink, and error_reporting is restored\"\n    (let [r (h/run-raw \"<?php echo @$u; echo error_reporting(); echo $w;\")]\n      (is (= \"32767\" (:php/out r)))\n      (is (= [\"Undefined variable $w\"] (mapv :message (:php/diag r))))))\n  (testing \"set_error_handler answers the previous handler\"\n    (is (= \"NULL\\nstring(1) \\\"h\\\"\\n\"\n           (h/run-walker (str \"<?php function h() {} var_dump(set_error_handler('h'));\"\n                              \" var_dump(set_error_handler(null));\"))))))\n\n\n(deftest stage0-enabled-fixtures-on-the-walker-test\n  (doseq [{:keys [id source out diag uncaught level]} p3b/enabled\n          :when (= :program level)\n          :let [r (h/run-raw source)]]\n    (is (= out (h/latin1->text (:php/out r))) (name id))\n    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n        (name id))))\n\n\n(deftest ^:slow stage0-enabled-fixtures-on-every-vm-test\n  (doseq [{:keys [id source level] :as fixture} p3b/enabled\n          :when (= :program level)\n          :let [out (rendered fixture)]]\n    (let [results (h/run-php source)]\n      (is (not (contains? results :diagnostics)) (pr-str results))\n      (doseq [k vms]\n        (is (= out (get results k)) (str (name id) \" on \" k))))))\n\n\n(deftest stage0-packets-match-source-test\n  (doseq [[id form] packets-p3b/forms\n          :let [{:keys [source]} (first (filter #(= id (:id %)) p3b/all-fixtures))]]\n    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\n\n\n;; -----------------------------------------------------------------------------\n;; S10: permutation corpus and php-src selection\n;; -----------------------------------------------------------------------------\n\n(defn- read-edn-file\n  [path]\n  (let [f (io/file path)]\n    (when (.exists f) (edn/read-string (slurp f)))))\n\n\n(defn- engine-result\n  \"`{:out :diag :uncaught}` of `source` on the walker, in the oracle's shape, or\n   `{:refused diagnostics}` / `{:threw message}`.\"\n  [source]\n  (try\n    (let [r (h/run-raw source)]\n      (if (:diagnostics r)\n        {:refused (mapv :message (:diagnostics r))}\n        {:out (h/latin1->text (:php/out r)),\n         :diag (mapv (juxt :errno :message) (:php/diag r)),\n         :uncaught (some-> (:php/uncaught r) (select-keys [:class :message]))}))\n    (catch Throwable t {:threw (str t)})))\n(ns yang.php.antlr.e2e-harness\n  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n   program envelope -> the bundled program on each of the four VMs. Output\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n   here at the boundary.\"\n  (:require\n    [dao.host.text :as text]\n    [dao.stream :as stream]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn host-registry\n  \"The registry the PHP compositions run over.\"\n  []\n  (portable/host-registry))\n\n\n(def ^:private base-opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\"\n  [source]\n  (let [cst-log (tu/new-memory-log)\n        program (tu/new-memory-log)\n        diagnostics (tu/new-memory-log)]\n    (stream/append! cst-log (cst/parse-source source))\n    (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                        {:medium lower/program-medium}))\n    (let [{warnings true, problems false}\n          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n      (if (seq problems)\n        {:diagnostics problems}\n        (let [{:yin/keys [batch root]} (first (tu/drain program))]\n          {:ast (nth batch root), :warnings (vec warnings)})))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`.\"\n  [registry ast]\n  (let [opts (assoc base-opts :modules registry)\n        session (tu/make-observer-session (tu/create-vm {:modules registry}))\n        datoms (vec (vm/ast->datoms ast))\n        projected #(:vector (sr-linearize/project ast))\n        attempt (fn [f]\n                  (try (render (f))\n                       (catch Exception e [:thrown (ex-message e)])))]\n    (tu/queue-ast! session ast)\n    {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n     :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n                                                          datoms)))),\n     :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                          (:image (derive/stack-image (projected)))\n                                          (assoc opts :contract vm/stack-contract))))),\n     :register (attempt #(vm/value (vm/run (rvm/create-vm\n                                             (derive/register-image (projected))\n                                             (assoc opts\n                                                    :contract\n                                                    vm/register-contract)))))}))\n\n\n(defn run-php\n  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`.\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics {:diagnostics diagnostics} (run-vms (host-registry) ast))))\n\n\n(defn run-walker\n  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [registry (host-registry)\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n        (tu/queue-ast! session ast)\n        (try (render (vm/value (:consumer (tu/run-session session))))\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, on the AST walker.\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [session (tu/make-observer-session\n                      (tu/create-vm {:modules (host-registry)}))]\n        (tu/queue-ast! session ast)\n        (vm/value (:consumer (tu/run-session session)))))))\n   (\"publication-time-unavailable optional imports cannot be represented\n   without concrete segment pins\"), not solved here (owner decision B8.10).\n2. **Run time**: \"missing\" means the pinned content is unavailable or its\n   delivery is refused (`:absent` with `:address`, a mismatch, an untrusted\n   principal). `include` and `include_once` emit PHP's two warning records\n   and yield `false`; `require` and `require_once` emit the first warning and\n   throw `Error` with PHP's fatal text. The warning text retains the written\n   kind. A refused path is not added to the included-files dict, so a later\n   `_once` retries delivery. Each record carries the structured refusal under\n   `:yang.php/refusal`.\n\n## 12. Safepoints\n\n- `:loop` and `:call` hooks (`phpsp`) serve signals: `pcntl_signal` handlers\n  run at hooks via `stream/poll!` on a signal stream, and\n  `pcntl_async_signals` is the default and only mode. A recursion-depth bound\n  is available if a composition wants one (PHP has none; default off).\n- `max_execution_time` and `set_time_limit` are wall-clock in PHP and so\n  nondeterministic: the profile offers a deterministic **safepoint-count\n  budget** instead, raising the fatal with PHP's text, a recorded departure\n  (owner decision B8.5, corner C21).\n- **Statement ticks** (`declare(ticks=N)`, `register_tick_function`) need\n  `:line` sites before non-lambda statement nodes. `yang.safepoint` currently\n  refuses a selected site that is not a `:lambda` (`site-not-lambda`), and\n  `:line` insertion is safepoint slice 3, which Python tracing also needs.\n  Ticks therefore **depend on the shared `:line` extension**: P7 splits into\n  P7-a (signals, no dependency) and P7-b (ticks, behind safepoint slice 3).\n  Neither L1 to L4 nor this frontend extends `yang.safepoint`; the extension\n  is the safepoint seat's.\n- No thread switches: PHP is single-threaded, and one request is one task.\n\n## 13. Diagnostics\n\nCompile time: `:yang.php/syntax`; `:yang.php/unsupported {:construct}`;\n`:yang.php/not-php`; `:yang.php/unknown-builtin` (a warning);\n`:yang.php/compile-error` for PHP's compile-time fatals (a function redeclared\nin one unit, `break 0`, a duplicate parameter, `$this` reassignment, a\npositional argument after a named one). Run time: guest warnings, notices and\ndeprecations as records on the guest-diagnostics stream; fatals as `Error`\nthrows; the uncaught-exception text pinned. Operational failures stay\noperational (`yang.antlr.md` section 11).\n\n## 14. The differential-corpus plan\n\n- **Oracle**: the pinned PHP 8.3.x CLI with the pinned ini. The comparison\n  covers stdout and the diagnostics stream, rendered in PHP's `Warning: ... in\n  <unit> on line N` form with the path replaced by the unit name and the line\n  derived from the side table (owner decision 2 of `yang.antlr.md` 8.5.1\n  reused), against PHP's stderr with paths normalized.\n- **Groups**: juggling (every pair of the comparison matrix, numeric strings,\n  arithmetic warnings and `TypeError`); arrays (key coercion, order, next\n  index after unset, copy-on-write observable through references, nested\n  writes, sort stability); references and lifecycle (section 4.6's three\n  sources); strings (bytes, interpolation forms, heredoc indentation,\n  `precision=14` output, `var_dump` text); functions (named arguments,\n  by-reference, defaults, variadics, coercion versus `strict_types`); classes\n","exit_code":1,"status":"failed"}}
