eric-string-padding,\ntest/yang/php/antlr/programs.cljc:62:   {:id :string-supplementary-unicode,\ntest/yang/php/antlr/programs.cljc:69:   {:id :single-quote-escapes,\ntest/yang/php/antlr/programs.cljc:74:   {:id :close-tag-newline,\ntest/yang/php/antlr/programs.cljc:79:   {:id :close-tag-ends-statement,\ntest/yang/php/antlr/programs.cljc:84:   {:id :echo-scalars,\ntest/yang/php/antlr/programs.cljc:89:   {:id :echo-floats,\ntest/yang/php/antlr/programs.cljc:98:   {:id :var-dump-scalars,\ntest/yang/php/antlr/programs.cljc:107:   {:id :int-overflow,\ntest/yang/php/antlr/programs.cljc:120:   {:id :int-literals,\ntest/yang/php/antlr/programs.cljc:127:   {:id :relational,\ntest/yang/php/antlr/programs.cljc:135:   {:id :int-edges,\ntest/yang/php/antlr/programs.cljc:147:   {:id :intdiv-min-by-minus-one,\ntest/yang/php/antlr/programs.cljc:155:   {:id :modulo-by-zero,\ntest/yang/php/antlr/programs.cljc:162:   {:id :division-by-zero,\ntest/yang/php/antlr/programs.cljc:169:   {:id :intdiv-by-zero,\ntest/yang/php/antlr/programs.cljc:176:   {:id :numeric-strings,\ntest/yang/php/antlr/programs.cljc:182:   {:id :juggling,\ntest/yang/php/antlr/programs.cljc:195:   {:id :short-circuit-and-ternary,\ntest/yang/php/antlr/programs.cljc:201:   {:id :string-escapes,\ntest/yang/php/antlr/programs.cljc:206:   {:id :print-returns-one,\ntest/yang/php/antlr/programs.cljc:211:   {:id :variables-and-assignment,\ntest/yang/php/antlr/programs.cljc:219:   {:id :null-coalescing-and-elvis,\ntest/yang/php/antlr/programs.cljc:225:   {:id :increments,\ntest/yang/php/antlr/programs.cljc:234:   {:id :if-elseif-else,\ntest/yang/php/antlr/programs.cljc:243:   {:id :loops,\ntest/yang/php/antlr/programs.cljc:248:                 \" echo \\\"|\\\"; for (;;) { break; } while ($i < 2): echo \\\"w\\\", $i; $i++;\"\ntest/yang/php/antlr/programs.cljc:252:   {:id :break-continue-levels,\ntest/yang/php/antlr/programs.cljc:256:                 \" echo \\\"|\\\"; $k = 0; while (true) { $k++; if ($k < 3) continue;\"\ntest/yang/php/antlr/programs.cljc:258:                 \" do { echo \\\"once\\\"; break; echo \\\"never\\\"; } while (true);\"),\ntest/yang/php/antlr/programs.cljc:261:   {:id :switch,\ntest/yang/php/antlr/programs.cljc:273:   {:id :interpolation,\ntest/yang/php/antlr/programs.cljc:279:   {:id :functions,\ntest/yang/php/antlr/programs.cljc:293:   {:id :static-variables,\ntest/yang/php/antlr/programs.cljc:303:   {:id :local-scope,\ntest/yang/php/antlr/programs.cljc:310:   {:id :argument-count-error,\ntest/yang/php/antlr/programs.cljc:318:   {:id :silence-with-counting-handler,\ntest/yang/php/antlr/programs.cljc:325:   {:id :undefined-function,\ntest/yang/php/antlr/programs.cljc:332:   {:id :static-initializer-call,\ntest/yang/php/antlr/programs.cljc:338:   {:id :static-initializer-twice,\ntest/yang/php/antlr/programs.cljc:344:   {:id :static-initializer-expression,\ntest/yang/php/antlr/programs.cljc:350:   {:id :static-initializer-recursion,\ntest/yang/php/antlr/programs.cljc:357:   {:id :static-initializer-unreached,\ntest/yang/php/antlr/programs.cljc:364:   {:id :silence-error-reporting-zero,\ntest/yang/php/antlr/programs.cljc:370:   {:id :silence-nested,\ntest/yang/php/antlr/programs.cljc:377:   {:id :silence-intersects-saved-mask,\ntest/yang/php/antlr/programs.cljc:383:   {:id :single-quote-raw-nul,\ntest/yang/php/antlr/programs.cljc:388:   {:id :arg-int-weak-mode,\ntest/yang/php/antlr/programs.cljc:394:   {:id :arg-int-inf,\ntest/yang/php/antlr/programs.cljc:401:   {:id :arg-int-neg-inf,\ntest/yang/php/antlr/programs.cljc:408:   {:id :arg-int-nan,\ntest/yang/php/antlr/programs.cljc:415:   {:id :arg-int-1e30,\ntest/yang/php/antlr/programs.cljc:422:   {:id :arg-int-neg-1e30,\ntest/yang/php/antlr/programs.cljc:429:   {:id :arg-int-2-63,\ntest/yang/php/antlr/programs.cljc:436:   {:id :arg-int-float-int-max,\ntest/yang/php/antlr/programs.cljc:443:   {:id :arg-int-string-1e30,\ntest/yang/php/antlr/programs.cljc:450:   {:id :arg-int-string-abc,\ntest/yang/php/antlr/programs.cljc:457:   {:id :arg-int-string-5-apples,\ntest/yang/php/antlr/programs.cljc:464:   {:id :arg-float-null,\ntest/yang/php/antlr/programs.cljc:471:   {:id :arg-float-string-2,\ntest/yang/php/antlr/programs.cljc:478:   {:id :arg-float-string-1,\ntest/yang/php/antlr/programs.cljc:485:   {:id :arg-int-handler,\ntest/yang/php/antlr/programs.cljc:491:   {:id :static-initializer-increment,\ntest/yang/php/antlr/programs.cljc:496:   {:id :array-key-coercion,\ntest/yang/php/antlr/programs.cljc:501:   {:id :array-key-float-deprecation,\ntest/yang/php/antlr/programs.cljc:507:   {:id :array-key-illegal-offset,\ntest/yang/php/antlr/programs.cljc:514:   {:id :array-cow,\ntest/yang/php/antlr/programs.cljc:519:   {:id :array-order-after-unset,\ntest/yang/php/antlr/programs.cljc:524:   {:id :array-next-index,\ntest/yang/php/antlr/programs.cljc:529:   {:id :array-next-index-saturated,\ntest/yang/php/antlr/programs.cljc:536:   {:id :array-eval-order,\ntest/yang/php/antlr/programs.cljc:542:   {:id :array-vivify-undefined,\ntest/yang/php/antlr/programs.cljc:547:   {:id :array-vivify-false,\ntest/yang/php/antlr/programs.cljc:553:   {:id :array-write-scalar,\ntest/yang/php/antlr/programs.cljc:560:   {:id :array-read-warnings,\ntest/yang/php/antlr/programs.cljc:566:   {:id :string-offset-read,\ntest/yang/php/antlr/programs.cljc:572:   {:id :string-offset-write,\ntest/yang/php/antlr/programs.cljc:580:   {:id :string-offset-peek,\ntest/yang/php/antlr/programs.cljc:586:   {:id :array-spread-renumber,\ntest/yang/php/antlr/programs.cljc:591:   {:id :array-spread-mixed,\ntest/yang/php/antlr/programs.cljc:596:   {:id :array-spread-nested,\ntest/yang/php/antlr/programs.cljc:601:   {:id :array-spread-scalar,\ntest/yang/php/antlr/programs.cljc:607:   {:id :unset-dim-false,\ntest/yang/php/antlr/programs.cljc:613:   {:id :unset-dim-true,\ntest/yang/php/antlr/programs.cljc:619:   {:id :array-isset-empty-unset,\ntest/yang/php/antlr/programs.cljc:625:   {:id :array-literals,\ntest/yang/php/antlr/programs.cljc:630:   {:id :array-compound-assign,\ntest/yang/php/antlr/programs.cljc:635:   {:id :array-null-coalesce,\ntest/yang/php/antlr/programs.cljc:640:   {:id :array-to-string,\ntest/yang/php/antlr/programs.cljc:646:   {:id :array-operators,\ntest/yang/php/antlr/programs.cljc:651:   {:id :array-plus-int,\ntest/yang/php/antlr/programs.cljc:658:   {:id :array-assign-value,\ntest/yang/php/antlr/programs.cljc:663:   {:id :array-local-loop,\ntest/yang/php/antlr/programs.cljc:668:   {:id :array-dim-of-string-dim,\ntest/yang/php/antlr/programs.cljc:673:   {:id :foreach-value,\ntest/yang/php/antlr/programs.cljc:678:   {:id :foreach-key-value,\ntest/yang/php/antlr/programs.cljc:683:   {:id :foreach-snapshot,\ntest/yang/php/antlr/programs.cljc:688:   {:id :foreach-nested-escapes,\ntest/yang/php/antlr/programs.cljc:693:   {:id :foreach-non-array,\ntest/yang/php/antlr/programs.cljc:699:   {:id :foreach-alt-syntax,\ntest/yang/php/antlr/programs.cljc:704:   {:id :foreach-keyed-target,\ntest/yang/php/antlr/programs.cljc:709:   {:id :foreach-in-function,\ntest/yang/php/antlr/programs.cljc:714:   {:id :builtin-count-keys-values,\ntest/yang/php/antlr/programs.cljc:719:   {:id :builtin-array-merge,\ntest/yang/php/antlr/programs.cljc:724:   {:id :builtin-exists-in-array,\ntest/yang/php/antlr/programs.cljc:729:   {:id :builtin-push-pop,\ntest/yang/php/antlr/programs.cljc:734:   {:id :builtin-shift-unshift,\ntest/yang/php/antlr/programs.cljc:739:   {:id :builtin-by-ref-nested,\ntest/yang/php/antlr/programs.cljc:744:   {:id :builtin-by-ref-non-variable,\ntest/yang/php/antlr/programs.cljc:750:   {:id :builtin-count-type-error,\ntest/yang/php/antlr/programs.cljc:757:   {:id :sort-basic,\ntest/yang/php/antlr/programs.cljc:762:   {:id :sort-asort-stable,\ntest/yang/php/antlr/programs.cljc:767:   {:id :sort-ksort,\ntest/yang/php/antlr/programs.cljc:772:   {:id :sort-usort,\ntest/yang/php/antlr/programs.cljc:777:   {:id :sort-thousand,\ntest/yang/php/antlr/programs.cljc:782:   {:id :foreach-key-target-order,\ntest/yang/php/antlr/programs.cljc:788:   {:id :foreach-key-expr-write,\ntest/yang/php/antlr/programs.cljc:793:   {:id :foreach-key-expr-once,\ntest/yang/php/antlr/programs.cljc:798:   {:id :by-ref-late-read,\ntest/yang/php/antlr/programs.cljc:803:   {:id :by-ref-late-read-sibling,\ntest/yang/php/antlr/programs.cljc:808:   {:id :sort-mixed-scalars,\ntest/yang/php/antlr/programs.cljc:813:   {:id :sort-bool-comparator,\ntest/yang/php/antlr/programs.cljc:819:   {:id :sort-ksort-mixed-keys,\ntest/yang/php/antlr/programs.cljc:824:   {:id :sort-uasort,\ntest/yang/php/antlr/programs.cljc:829:   {:id :sort-uksort,\ntest/yang/php/antlr/programs.cljc:834:   {:id :sort-rsort-stable,\ntest/yang/php/antlr/programs.cljc:839:   {:id :foreach-sort-source-inside,\ntest/yang/php/antlr/programs.cljc:844:   {:id :sort-inconsistent-cmp-departure,\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` (G3) is the mandatory landing gate on master after merge.\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n# overlap lanes, see \"Remote test servers\" below).\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\nnpm test             # Node.js tests\n\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n                         # and the linker L5 Node reader that requires a module\n                         # by name): `clojure -M:test` without it fails that test\n```\n\n### Changed-only tests: `bb test:changed`\n\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\nreach: the reverse require closure of the files changed since the\nmerge-base with master, plus fixtures that mention a changed resource path,\ntests that walk a changed tree, and each src file's `_test` by convention.\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\nfs/walk-file-tree or .listFiles; each string literal argument of its\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\n(let-bound roots count), and a change under a root selects it. The three\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\nland a slice confined to a package. Exit 2 (from :list too) is a wide\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\nas for a change to the core everything requires (yin.vm engine,\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\nand spawned programs that changed (target/yin-repl.js, Dart peers).\n\n### Sharded quick JVM feedback and change routing\n\n```sh\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\nbb test:routed                                 # Git change set, same base as test:changed\nbb deps:npm                                    # Content-checked local npm ci\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\n```\n\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\nthe JVM portion of G3. Without selection flags it selects every JVM test;\n`--changed FILE...` or `--base REF` uses `affected/select` and\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\nsemantics. `--workers N` must be positive (default 4 on the laptop).\n\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\n`affected/select-subsystems` and the same longest-prefix ownership rule as\n`test:sub`. As in the shiva script below, currently unowned namespaces run\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\nPrerequisites are derived from the entire selected JVM reach and finish\nserially before workers start; the Node REPL build prerequisite\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\n\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\nand `summary.edn`. Before execution it checks **set equality** between selected\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\nThe final summary totals tests, assertions, failures and errors and separates\nJVM wall time from total time including selection/builds. A nonzero child exit,\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\nDry plans write namespace evidence but execute no builds or tests. An empty\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\n\n`test:routed <changed-files...>` applies this priority table to the whole change\nset, prints the exact dispatch, executes it and propagates its result:\n\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Change class (first match wins)                                                              | Dispatch                                                              |\n+==============================================================================================+=======================================================================+\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\n|                                                                                              | lint only                                                             |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\n|                                                                                              | selection                                                             |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\n\nMixed changes take the widest matching route. Missing paths, an empty git change\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\nits zero exit is **not** a verification result. Documentation checks inspect\nstaged and unstaged changes together against HEAD. Paths absent from\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\nexecutable examples or validate documentation links.\n\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\nmeans the dispatched gate completed successfully, not that every landing gate\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\nand failed dispatches. Successful checked docs, selected tri-host, and full\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\nresults, so automation must inspect the scope as well as the exit code.\n\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\ntri-host success: for foundation/compiler changes also run\n`bb test:changed:cljs --changed <paths>` and\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\ndemo smoke checks and review/landing gates all remain required. Node and Dart\nlanes retain their current commands. The original unsharded tasks remain\navailable. Do not run another lane set concurrently on the laptop.\n\n#### Worktree-local prerequisite caches\n\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\nrecorded helper/generated digests and runtime pins), the generator/cache source,\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\nremoved or corrupted outputs trigger a full generation, retaining the generator's\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\ninvalidate the complete-build stamp.\n\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\nenvironment and worktree identity; it verifies the installed file tree before\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\nensure this dependency too. Direct `npm ci` is still available.\n\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\nlock only after confirming its owning process died. Symlinked output parents\nthat escape the worktree are refused. This is reuse **within one worktree**,\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\nstill require the existing worktree isolation/serialization rules; the cache\ndoes not make overlapping builds and tests safe. Peer executables and shadow\nbuilds themselves are not cached by this mechanism.\n\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\nouter command **258.27 s**). The original `test:changed:clj` command completed\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\nAGENTS.md\nCLAUDE.md\nGEMINI.md\nLICENSE\nLICENSE-EXCEPTION\nREADME.md\nanalysis_options.yaml\nandroid\nantlr\narchive\nassets\nbb.edn\nbin\nbuild\ncollab\nconfig.clj\ndemo\ndemo_yang.clj\ndeps.edn\ndocker\ndocs\nexamples\nios\njolt-toolchain.edn\nlib\nlinux\nmacos\nmise.toml\nnative\nnginx.conf\nnode_modules\norchestrator-logs\npackage-lock.json\npackage.json\npublic\npubspec.lock\npubspec.yaml\nshadow-cljs.edn\nsrc\ntarget\ntest\ntools\nvllm.sh\nweb\nwindows\nx\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' test/yang/php/antlr/programs_p4.cljc && sed -n '730,950p' test/yang/php/antlr/programs_p4.cljc && rg -n \\\"programs-p4|programs-p6|fixtures\\\" test/yang/php/antlr/programs.cljc | tail -30 && rg -n \\\"phpt-selection|selection.*test|def.*phpt\\\" test/yang/php/antlr/e2e_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' test/yang/php/antlr/programs_p4.cljc && sed -n '730,950p' test/yang/php/antlr/programs_p4.cljc && rg -n \\\"programs-p4|programs-p6|fixtures\\\" test/yang/php/antlr/programs.cljc | tail -30 && rg -n \\\"phpt-selection|selection.*test|def.*phpt\\\" test/yang/php/antlr/e2e_test.clj\"","aggregated_output":"(ns yang.php.antlr.programs-p4\n  \"Slice P4 Stage 0 (S0) fixture data: classes, exceptions, constructors and\n   readonly groups (P4 plan v2, S0). Same schema as\n   `yang.php.antlr.programs-p3b`; `:oracle` is `:pending` until a recording is\n   folded, and `:requires` names the P4 steps (:p4-s1 .. :p4-s12) that must land\n   before an implementation runner may execute it. A recorded result is\n   authoritative and replaces any hand-authored output pin.\n\n   `all-fixtures` is unconditional (the oracle iterates it). `enabled` is the\n   subset whose :requires have all landed in `completed-steps`.\"\n  (:require\n    [clojure.string]\n    [yang.php.antlr.programs-p3b :as p3b]))\n\n\n(def completed-steps\n  \"P4 steps that have landed. A fixture whose :requires name a later step\n   stays disabled.\"\n  #{:p4-s1 :p4-s2 :p4-s3 :p4-s4 :p4-s5 :p4-s6 :p4-s8})\n\n\n(defn- fx\n  ([id group rows requires source out]\n   (fx id group rows requires source out :program))\n  ([id group rows requires source out level]\n   (cond-> {:id id,\n            :group group,\n            :rows rows,\n            :level level,\n            :requires requires,\n            :source source,\n            :oracle :pending}\n     out (assoc :out out))))\n\n\n(def classes-v1\n  [(fx :cls-new-and-method :classes-v1 [] #{:p4-s2}\n       \"<?php class A { public $x = 1; function get() { return $this->x; } } $a = new A; echo $a->get();\"\n       \"1\")\n   (fx :cls-static-prop-shared :classes-v1 [] #{:p4-s2}\n       \"<?php class A { public static $n = 0; } class B extends A {} A::$n++; B::$n++; echo A::$n, B::$n;\"\n       \"22\")\n   (fx :cls-static-prop-redeclared-unshared :classes-v1 [] #{:p4-s2}\n       \"<?php class A { public static $n = 0; } class B extends A { public static $n = 5; } A::$n++; echo A::$n, B::$n;\"\n       \"15\")\n   (fx :cls-const-and-self :classes-v1 [] #{:p4-s2}\n       \"<?php class A { const X = 3; const Y = self::X; } echo A::Y;\"\n       \"3\")\n   (fx :cls-private-identity-per-class :classes-v1 [19] #{:p4-s2}\n       (str \"<?php class A { private $p = 'a'; function a() { return $this->p; } }\"\n            \" class B extends A { public $p = 'b'; function b() { return $this->p; } }\"\n            \" $o = new B; echo $o->a(), $o->b();\")\n       \"ab\")\n   (fx :cls-private-not-visible-outside :classes-v1 [] #{:p4-s2}\n       (str \"<?php class A { private $p = 1; }\"\n            \" try { echo (new A)->p; } catch (Error $e) { echo $e->getMessage(); }\")\n       \"Cannot access private property A::$p\")\n   (fx :cls-protected-from-subclass :classes-v1 [] #{:p4-s2}\n       \"<?php class A { protected $p = 4; } class B extends A { function f() { return $this->p; } } echo (new B)->f();\"\n       \"4\")\n   (fx :cls-late-static-binding :classes-v1 [] #{:p4-s2}\n       (str \"<?php class A { static function make() { return new static; } function n() { return static::class; } }\"\n            \" class B extends A {} $o = B::make(); echo $o->n();\")\n       \"B\")\n   (fx :cls-abstract-instantiation :classes-v1 [] #{:p4-s2}\n       (str \"<?php abstract class A {}\"\n            \" try { new A; } catch (Error $e) { echo $e->getMessage(); }\")\n       \"Cannot instantiate abstract class A\")\n   (fx :cls-interface-instanceof :classes-v1 [] #{:p4-s2}\n       \"<?php interface I {} class A implements I {} var_dump(new A instanceof I);\"\n       \"bool(true)\\n\")\n   (fx :cls-interface-constant :classes-v1 [] #{:p4-s2}\n       \"<?php interface I { const K = 'k'; } class A implements I {} echo A::K, I::K;\"\n       \"kk\")\n   (fx :cls-trait-method :classes-v1 [] #{:p4-s2}\n       \"<?php trait T { function hi() { return 'hi'; } } class A { use T; } echo (new A)->hi();\"\n       \"hi\")\n   (fx :cls-trait-static-per-user :classes-v1 [] #{:p4-s2}\n       (str \"<?php trait T { static function c() { static $n = 0; return ++$n; } }\"\n            \" class A { use T; } class B { use T; } A::c(); A::c(); echo A::c(), B::c();\")\n       \"31\")\n   (fx :cls-trait-self-is-user :classes-v1 [] #{:p4-s2}\n       (str \"<?php trait T { function who() { return self::class; } } class A { use T; } class B extends A {}\"\n            \" echo (new B)->who();\")\n       \"A\")\n   (fx :cls-trait-conflict-insteadof :classes-v1 [] #{:p4-s2}\n       (str \"<?php trait T1 { function f() { return 1; } } trait T2 { function f() { return 2; } }\"\n            \" class A { use T1, T2 { T1::f insteadof T2; T2::f as g; } } $a = new A; echo $a->f(), $a->g();\")\n       \"12\")\n   (fx :cls-enum-pure :classes-v1 [] #{:p4-s2}\n       \"<?php enum S { case On; case Off; } var_dump(S::On === S::On, S::On === S::Off);\"\n       \"bool(true)\\nbool(false)\\n\")\n   (fx :cls-enum-backed-value :classes-v1 [] #{:p4-s2}\n       \"<?php enum S: string { case On = 'on'; case Off = 'off'; } $a = S::On; $b = S::Off; echo $a->value, $b->name;\"\n       \"onOff\")\n   (fx :cls-enum-cases :classes-v1 [] #{:p4-s2}\n       \"<?php enum S { case A; case B; } foreach (S::cases() as $c) { echo $c->name; }\"\n       \"AB\")\n   (fx :cls-enum-from-tryfrom :classes-v1 [] #{:p4-s9}\n       (str \"<?php enum S: int { case One = 1; } echo S::from(1)->name; var_dump(S::tryFrom(2));\"\n            \" try { S::from(2); } catch (ValueError $e) { echo $e->getMessage(); }\")\n       nil)\n   (fx :cls-hoisting :classes-v1 [] #{:p4-s1}\n       \"<?php echo (new A)->v(); class A { function v() { return 7; } }\"\n       nil)\n   (fx :cls-anonymous-refused :classes-v1 [] #{:p4-s1}\n       \"<?php $o = new class { public $x = 1; }; echo $o->x;\"\n       nil\n       :oracle-only)\n   (fx :cls-magic-get-set-call :classes-v1 [] #{:p4-s2}\n       \"<?php function g() { yield 1; yield 2; } $g = g(); foreach ($g as $v) { echo $v; break; } foreach ($g as $v) { echo $v; }\"\n       \"12\")\n   (fx :gen-return-repeatedly-readable :generators-v1 [] #{:p4-s8}\n       \"<?php function g() { yield 1; return 7; } $g = g(); foreach ($g as $v) {} echo $g->getReturn(), $g->getReturn();\"\n       \"77\")\n   (fx :gen-created-activation-releases-on-destroy :generators-v1 [48] #{:p4-s8}\n       \"<?php class D { function __destruct() { echo 'D'; } } function g($x) { yield 1; } $g = g(new D); unset($g); echo 'E';\"\n       \"DE\")\n   (fx :gen-suspended-cv-releases-on-destroy :generators-v1 [48] #{:p4-s8}\n       \"<?php class D { function __destruct() { echo 'D'; } } function g($x) { yield 1; } $g = g(new D); $g->current(); unset($g); echo 'E';\"\n       \"DE\")\n   (fx :gen-c8-pending-finally-departure :generators-v1 [48] #{:p4-s8}\n       \"<?php function g() { try { yield 1; } finally { echo 'F'; } } $g = g(); $g->current(); unset($g); echo 'E';\"\n       \"E\")\n   (fx :gen-c19-clone-refused :generators-v1 [52] #{:p4-s8}\n       \"<?php function g() { yield 1; } $g = g(); try { clone $g; } catch (Error $e) { echo $e->getMessage(); }\"\n       \"Trying to clone an uncloneable object of class Generator\")])\n\n\n(def typed-ref-v1\n  \"The ten typed-reference texts of section 4.5 (rows 41 to 45), run at program\n   level on the implementation. The vendored grammar cannot parse a nullable\n   property type (`public ?int $n`), so each program is the recorded source with\n   `?int` written `int|null` and `PHP_INT_MAX` as its literal; the pinned text is\n   the recorded one, confirmed when the oracle records the rewritten source.\"\n  (into []\n        (comp (filter #(= :typed-ref-candidates (:group %)))\n              (map (fn [f]\n                     (-> f\n                         (assoc :id (keyword (str \"p4-\" (name (:id f))))\n                                :level :program\n                                :requires #{:p4-s5}\n                                :oracle :pending)\n                         (cond-> (:uncaught f) (assoc :throws true))\n                         (update :source\n                                 #(-> %\n                                      (clojure.string/replace \"public ?int\" \"public int|null\")\n                                      (clojure.string/replace \"PHP_INT_MAX\" \"9223372036854775807\")))))))\n        p3b/all-fixtures))\n\n\n(def banner p3b/banner)\n\n\n(def recorded\n  \"Oracle RECORD values from shiva pass 6 (php-8.3.35, docker php:8.3-cli, branch\n   tip ec54182f), copied exactly from the pass log, plus the seven pass-7\n   records (branch tip 56b622ad; :exc-user-ctor-override was absent from pass 6,\n   which ran its earlier strtoupper source), and the three checkpoint-B pass-12\n   records from shiva (490 targets checked).\"\n  {:cls-new-and-method {:out \"1\", :diag [], :uncaught nil}\n   :cls-static-prop-shared {:out \"22\", :diag [], :uncaught nil}\n   :cls-static-prop-redeclared-unshared {:out \"15\", :diag [], :uncaught nil}\n   :cls-const-and-self {:out \"3\", :diag [], :uncaught nil}\n   :cls-private-identity-per-class {:out \"ab\", :diag [], :uncaught nil}\n   :cls-private-not-visible-outside {:out \"Cannot access private property A::$p\", :diag [], :uncaught nil}\n   :cls-protected-from-subclass {:out \"4\", :diag [], :uncaught nil}\n   :cls-late-static-binding {:out \"B\", :diag [], :uncaught nil}\n   :cls-abstract-instantiation {:out \"Cannot instantiate abstract class A\", :diag [], :uncaught nil}\n   :cls-interface-instanceof {:out \"bool(true)\\n\", :diag [], :uncaught nil}\n   :cls-interface-constant {:out \"kk\", :diag [], :uncaught nil}\n   :cls-trait-method {:out \"hi\", :diag [], :uncaught nil}\n   :cls-trait-static-per-user {:out \"31\", :diag [], :uncaught nil}\n   :cls-trait-self-is-user {:out \"A\", :diag [], :uncaught nil}