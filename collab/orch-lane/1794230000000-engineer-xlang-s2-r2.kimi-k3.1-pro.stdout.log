{"role":"tool","tool_call_id":"tool_RjOr8MYOyuhm6xTSGAMlQ1ia","content":"1925\t       (vary-meta ast merge (dissoc m ::fn-loop))\n1926\t       ast))))\n1927\t\n1928\t\n1929\t(defn- program-env\n1930\t  \"The compile-time env of one program. Without `opts` it is empty: the\n1931\t   native path. `{:convention :arg-vector, :native #{symbol}, :macros\n1932\t   #{symbol}}` opts into the argument-vector convention: `:native` names the\n1933\t   primitives a bare symbol may call directly (a set, or a map from name to\n1934\t   its published profile, whose `:yin.k/arities` give an adapter its admitted\n1935\t   counts), `:macros` the expander-side\n1936\t   macro names whose calls must stay ordinary applications. The program's\n1937\t   own top-level definitions are never native. `:outcomes true` adds the\n1938\t   outcome model (see its section); `:adapters` maps a primitive that\n1939\t   declares domain failures to the host adapter returning its outcome.\"\n1940\t  [forms opts]\n1941\t  (if-not opts\n1942\t    {}\n1943\t    (do (when-not (= :arg-vector (:convention opts))\n1944\t          (reject! \"Unknown compile-program convention\" {:opts opts}))\n1945\t        (when-let [hit (seq (filter control-heads (:macros opts)))]\n1946\t          (reject! \"A :macros entry names a compiler form\" {:macros (vec hit)}))\n1947\t        (let [defined (into #{}\n1948\t                            (keep (fn [f]\n1949\t                                    (when (and (seq? f)\n1950\t                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\n1951\t                                               (symbol? (second f)))\n1952\t                                      (strip-symbol-meta (second f)))))\n1953\t                            forms)]\n1954\t          ;; the compiler emits bare conj and vec (collection literals, apply),\n1955\t          ;; so a program definition of either would capture them\n1956\t          (when-let [hit (first (filter #{'conj 'vec} defined))]\n1957\t            (reject! (str \"Defining \" hit \" would capture the argument-vector constructor\")\n1958\t                     {:name hit}))\n1959\t          (cond-> {::convention {:native (set (if (map? (:native opts))\n1960\t                                                (keys (:native opts))\n1961\t                                                (:native opts)))\n1962\t                                 :arities (into {}\n1963\t                                                (keep (fn [[sym profile]]\n1964\t                                                        (when-let [a (if (map? profile)\n1965\t                                                                       (:yin.k/arities profile)\n1966\t                                                                       profile)]\n1967\t                                                          [sym a])))\n1968\t                                                (when (map? (:native opts)) (:native opts)))\n1969\t                                 :macros (set (:macros opts))}\n1970\t                   ::defined defined\n1971\t                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n1972\t                                                  (= 'invoke-value (second %))\n1973\t                                                  (:yin.k/invoker (meta (second %)))) forms))}\n1974\t            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n1975\t\n1976\t\n1977\t(defn- check-program-symbols!\n1978\t  \"The program pre-pass. Quoted data is exempt. The reserved prefix names\n1979\t   compiler temporaries, so no user symbol may carry it in ANY position\n1980\t   (binder, reference, definition name); `loop` and `recur` are special forms,\n1981\t   so they may only head a list, never stand as a value or a binder.\"\n1982\t  [form]\n1983\t  (cond\n1984\t    (symbol? form)\n1985\t    (do (when (reserved-name? form)\n1986\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n1987\t                   {:symbol form, :prefix reserved-prefix}))\n1988\t        (when (and (nil? (namespace form)) (contains? #{'loop 'recur} form))\n1989\t          (reject! (str form \" is only legal in operator position\") {:symbol form})))\n1990\t    (seq? form)\n1991\t    (when-not (= 'quote (first form))\n1992\t      (let [head (first form)]\n1993\t        (when (and (symbol? head) (reserved-name? head))\n1994\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n1995\t                   {:symbol head, :prefix reserved-prefix}))\n1996\t        (when-not (symbol? head)\n1997\t          (check-program-symbols! head))\n1998\t        (run! check-program-symbols! (rest form))))\n1999\t    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n2000\t    (coll? form) (run! check-program-symbols! form)))\n2001\t\n2002\t\n2003\t(defn- check-top-level-discard!\n2004\t  \"Only the last top-level form's outcome reaches the harness, so a non-final,\n2005\t   non-definition form that may fail would have its error silently discarded:\n2006\t   refuse it, as a def value that calls guest functions is refused. Returns\n2007\t   `form`.\"\n2008\t  [env macro-env forms form]\n2009\t  (when (and (next forms)\n2010\t             (not (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form))))\n2011\t             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\n2012\t    (reject! \"A non-final top-level form that may fail would discard its error outcome\"\n2013\t             {:form form}))\n2014\t  form)\n2015\t\n2016\t\n2017\t(defn- lower-top-form\n2018\t  \"Under the outcome model a top-level expression returns an outcome like a\n2019\t   function body; definitions keep their own lowering.\"\n2020\t  [env macro-env form]\n2021\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\n2022\t    form\n2023\t    (lower-function-body env macro-env [] [form])))\n2024\t\n2025\t\n2026\t(defn compile-program\n2027\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n2028\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n2029\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n2030\t   with :macro? true on the lambda; the encoder turns that flag into a\n2031\t   declaration row and the expander, not this compiler, recognizes calls.\n2032\t   The three-argument form takes `opts` opting into the argument-vector\n2033\t   convention (see `program-env`); without it the output is the native one.\"\n2034\t  ([forms] (compile-program forms true))\n2035\t  ([forms tail?] (compile-program forms tail? nil))\n2036\t  ([forms tail? opts]\n2037\t   (run! check-program-symbols! forms)\n2038\t   (let [env (program-env forms opts)]\n2039\t     ;; A discarded definition must not become a lexical binding in the\n2040\t     ;; following definitions. Descriptor entry and body closures both capture\n2041\t     ;; their environment: retaining the previous descriptor here doubles its\n2042\t     ;; paths at each definition during machine-data validation and UCF lift.\n2043\t     (letfn [(discard-result\n2044\t               [ast]\n2045\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n2046\t             (go\n2047\t               [forms macro-env]\n2048\t               (if (empty? forms)\n2049\t                 (compile-literal nil tail?)\n2050\t                 (let [head       (cond->> (first forms)\n2051\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\n2052\t                                    (outcomes? env) (lower-top-form env macro-env))\n2053\t                       rest-forms (rest forms)]\n2054\t                   (cond\n2055\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n2056\t                     ;; lambda the encoder declares; later forms see the name