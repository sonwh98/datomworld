{"role":"tool","tool_call_id":"tool_u7SVIo8J9cGwgbMX4DOreH1Q","content":"1\t(ns yang.clojure-test\n2\t  (:require [clojure.test :refer [deftest is testing]]\n3\t            [clojure.walk :as walk]\n4\t            [dao.stream :as stream]\n5\t            [dao.stream.observer :as observer]\n6\t            [yang.clojure :as yang]\n7\t            [yang.core.uast :as u]\n8\t            [yang.io :as yang-io]\n9\t            [yin.vm :as vm]\n10\t            [yin.vm.ast-walker :as ast-walker]\n11\t            [yin.vm.data :as data]\n12\t            [yin.vm.encoder :as encoder]\n13\t            [yin.vm.engine :as engine]\n14\t            [yin.vm.semantic.linearize :as linearize]\n15\t            [yin.vm.module :as module]\n16\t            [yin.vm.semantic :as semantic]\n17\t            [yin.vm.test-utils :as tu]\n18\t            [yin.vm.values :as values]))\n19\t\n20\t\n21\t;; v1 registered the stream module globally at load time; the v2 composition\n22\t;; registers it in the registry it hands the VM.\n23\t(def ^:private base-vm-opts\n24\t  {:modules (module/register-stream-module (module/default-registry))})\n25\t\n26\t\n27\t(defn compile-and-run\n28\t  ([form] (compile-and-run form {} {}))\n29\t  ([form env] (compile-and-run form env {}))\n30\t  ([form env vm-opts]\n31\t   (-> (tu/make-observer-session\n32\t         (tu/create-vm (merge base-vm-opts {:env env} vm-opts)))\n33\t       (tu/queue-ast! (yang/compile form))\n34\t       tu/run-session\n35\t       :consumer\n36\t       vm/value)))\n37\t\n38\t\n39\t(deftest reader-metadata-becomes-occurrence-side-tables\n40\t  (let [form (with-meta '(+ 1 2)\n41\t               {:file \"sample.clj\" :line 9 :column 3 :note :source-form})\n42\t        ast (yang/compile form)\n43\t        projected (encoder/project\n44\t                    (encoder/source-envelope :program \"batch-1\" [ast]))\n45\t        tree (first (:yin/batch projected))\n46\t        origin [:source :program \"batch-1\" 0]]\n47\t    (is (= {:file \"sample.clj\" :line 9 :column 3 :note :source-form}\n48\t           (meta ast)))\n49\t    (is (some #{[origin (:root tree) [] \"sample.clj\" 9 3]}\n50\t              (:yin/source-positions projected)))\n51\t    (is (some #{[origin (:root tree) [] :note :source-form]}\n52\t              (:yin/frontend-metadata projected)))))\n53\t\n54\t\n55\t(deftest indexing-reader-injects-nested-source-positions\n56\t  (let [ast (first (yang-io/compile-string \"(+ x\\n   (* x 2))\"))]\n57\t    (is (= {:file \"<string>\" :line 1 :column 1\n58\t            :end-line 2 :end-column 12}\n59\t           (select-keys (meta ast)\n60\t                        [:file :line :column :end-line :end-column])))\n61\t    (is (= {:file \"<string>\" :line 2 :column 4\n62\t            :end-line 2 :end-column 11}\n63\t           (select-keys (meta (second (:operands ast)))\n64\t                        [:file :line :column :end-line :end-column])))\n65\t    (is (= {:file \"<string>\" :line 2 :column 5\n66\t            :end-line 2 :end-column 6}\n67\t           (select-keys (meta (:operator (second (:operands ast))))\n68\t                        [:file :line :column :end-line :end-column])))))\n69\t\n70\t\n71\t(defn compile-program-and-run\n72\t  ([forms] (compile-program-and-run forms {} {}))\n73\t  ([forms env] (compile-program-and-run forms env {}))\n74\t  ([forms env vm-opts]\n75\t   (-> (tu/make-observer-session\n76\t         (tu/create-vm (merge base-vm-opts {:env env} vm-opts)))\n77\t       (tu/queue-ast! (yang/compile-program forms))\n78\t       tu/run-session\n79\t       :consumer\n80\t       vm/value)))\n81\t\n82\t\n83\t(deftest test-compile-literals\n84\t  (testing \"Compiling literal values\"\n85\t    (testing \"Numbers\"\n86\t      (is (= {:type :literal, :value 42} (yang/compile 42)))\n87\t      (is (= {:type :literal, :value 3.14} (yang/compile 3.14)))\n88\t      (is (= {:type :literal, :value -10} (yang/compile -10))))\n89\t    (testing \"Strings\"\n90\t      (is (= {:type :literal, :value \"hello\"} (yang/compile \"hello\"))))\n91\t    (testing \"Booleans\"\n92\t      (is (= {:type :literal, :value true} (yang/compile true)))\n93\t      (is (= {:type :literal, :value false} (yang/compile false))))\n94\t    (testing \"Nil\" (is (= {:type :literal, :value nil} (yang/compile nil))))\n95\t    (testing \"Keywords\"\n96\t      (is (= {:type :literal, :value :foo} (yang/compile :foo))))\n97\t    (testing \"Vectors\"\n98\t      (is (= {:type :literal, :value [1 2 3]} (yang/compile [1 2 3]))))\n99\t    (testing \"Maps\"\n100\t      (is (= {:type :literal, :value {:a 1, :b 2}}\n101\t             (yang/compile {:a 1, :b 2}))))\n102\t    (testing \"Sets\"\n103\t      (is (= {:type :literal, :value #{1 2 3}}\n104\t             (yang/compile #{1 2 3}))))))\n105\t\n106\t\n107\t(deftest test-set-literal-round-trips\n108\t  ;; the semantic lane carries a set literal as plain data (vm/plain-data?\n109\t  ;; accepts collections of scalars) and the ast-walker returns it unchanged\n110\t  (is (= #{1 2 3} (compile-and-run #{1 2 3})))\n111\t  (is (= #{1 2 3} (compile-and-run '(quote #{1 2 3})))))\n112\t\n113\t\n114\t(deftest test-set-literal-row-lane\n115\t  ;; the row lane: equal sets under different orders mint one address (the\n116\t  ;; code-as-tuples rule that literal maps and sets hash order-insensitively)\n117\t  (is (= (get (encoder/project (encoder/source-envelope\n118\t                                 :program \"batch-1\" [(yang/compile #{1 2 3})]))\n119\t              :root)\n120\t         (get (encoder/project (encoder/source-envelope\n121\t                                 :program \"batch-1\" [(yang/compile #{3 2 1})]))\n122\t              :root)))\n123\t  ;; a set carrying a host function is not plain data and must be refused at\n124\t  ;; the row boundary, exactly as for vectors/maps\n125\t  (is (thrown? Exception\n126\t        (encoder/project\n127\t          (encoder/source-envelope\n128\t            :program \"batch-2\"\n129\t            [{:type :literal, :value #{clojure.core/+}}])))))\n130\t\n131\t\n132\t(deftest test-set-in-application-position\n133\t  ;; a set literal in operator position compiles (like the keyword/vector\n134\t  ;; precedent) and fails at run time, not compile time\n135\t  (is (thrown-with-msg? Exception #\"apply\"\n136\t        (compile-and-run '((quote #{1 2}) 1)))))\n137\t\n138\t\n139\t(deftest test-compile-variables\n140\t  (testing \"Compiling variable references\"\n141\t    (is (= {:type :variable, :name 'x} (yang/compile 'x)))\n142\t    (is (= {:type :variable, :name 'foo} (yang/compile 'foo)))))\n143\t\n144\t\n145\t(deftest test-compile-lambda\n146\t  (testing \"Compiling lambda expressions\"\n147\t    (testing \"Simple lambda\"\n148\t      (let [ast (yang/compile '(fn [x] x))]\n149\t        (is (= :lambda (:type ast)))\n150\t        (is (= ['x] (:params ast)))\n151\t        (is (= {:type :variable, :name 'x} (:body ast)))))\n152\t    (testing \"Lambda with computation\"\n153\t      (let [ast (yang/compile '(fn [x y] (+ x y)))]\n154\t        (is (= :lambda (:type ast)))\n155\t        (is (= ['x 'y] (:params ast)))\n156\t        (is (= :application (get-in ast [:body :type])))))))\n157\t\n158\t\n159\t(deftest test-compile-application\n160\t  (testing \"Compiling function applications\"\n161\t    (testing \"Simple addition\"\n162\t      (let [ast (yang/compile '(+ 1 2))]\n163\t        (is (= :application (:type ast)))\n164\t        (is (= {:type :variable, :name '+} (:operator ast)))\n165\t        (is (= [{:type :literal, :value 1} {:type :literal, :value 2}]\n166\t               (:operands ast)))))\n167\t    (testing \"Nested application\"\n168\t      (let [ast (yang/compile '(+ (* 2 3) 4))]\n169\t        (is (= :application (:type ast)))\n170\t        (is (= :application (get-in ast [:operands 0 :type])))))))\n171\t\n172\t\n173\t(deftest test-compile-dao-stream-apply-call\n174\t  (testing \"Compiling dao.stream.apply/call special form\"\n175\t    (let [ast (yang/compile '(dao.stream.apply/call :op/echo 1 2))]\n176\t      (is (= :dao.stream.apply/call (:type ast)))\n177\t      (is (= :op/echo (:op ast)))\n178\t      (is (= [{:type :literal, :value 1} {:type :literal, :value 2}]\n179\t             (:operands ast))))))\n180\t\n181\t\n182\t(deftest test-compile-if\n183\t  (testing \"Compiling conditional expressions\"\n184\t    (testing \"If with alternate\"\n185\t      (let [ast (yang/compile '(if true 1 2))]\n186\t        (is (= :if (:type ast)))\n187\t        (is (= {:type :literal, :value true} (:test ast)))\n188\t        (is (= {:type :literal, :value 1} (:consequent ast)))\n189\t        (is (= {:type :literal, :value 2} (:alternate ast)))))\n190\t    (testing \"If without alternate\"\n191\t      (let [ast (yang/compile '(if true 1))]\n192\t        (is (= :if (:type ast)))\n193\t        (is (= {:type :literal, :value nil} (:alternate ast)))))\n194\t    (testing \"Explicit false alternate is a value, not an absence\"\n195\t      (let [ast (yang/compile '(if true 1 false))]\n196\t        (is (= {:type :literal, :value false} (:alternate ast))))\n197\t      (is (false? (compile-and-run '(if false 1 false)))))))\n198\t\n199\t\n200\t(deftest test-dynamic-collection-literals\n201\t  ;; unquoted collections evaluate their elements like Clojure; constant\n202\t  ;; collections stay literal nodes; quoted collections stay data\n203\t  (testing \"Constant collections stay literals\"\n204\t    (is (= {:type :literal, :value [1 2]} (yang/compile '[1 2])))\n205\t    (is (= {:type :literal, :value '(1 x 2)} (yang/compile '(quote (1 x 2))))))\n206\t  (testing \"Dynamic vectors lower to conj over []\"\n207\t    (let [ast (yang/compile '(let [x 7] [x 2]))]\n208\t      (is (= :application (:type ast)))\n209\t      (is (= 'conj (get-in ast [:operator :body :operator :name])))\n210\t      (is (= {:type :literal, :value []} (first (get-in ast [:operator :body :operands])))))\n211\t    (is (= [7 2] (compile-and-run '(let [x 7] [x 2])))))\n212\t  (testing \"Dynamic sets lower to conj over #{}\"\n213\t    (is (= #{7 2} (compile-and-run '(let [x 7] #{x 2})))))\n214\t  (testing \"Dynamic maps evaluate keys and values\"\n215\t    (is (= {7 8} (compile-and-run '(let [x 7] {x (+ x 1)})))\n216\t        \"map keys are evaluated, not taken as data\"))\n217\t  (testing \"Nested collections evaluate recursively\"\n218\t    (is (= [7 [8] {:k #{9}}]\n219\t           (compile-and-run '(let [x 7] [x [(+ x 1)] {:k #{(+ x 2)}}])))))\n220\t  (testing \"Quoted dynamic collections remain data\"\n221\t    (is (= '[x y] (compile-and-run '(quote [x y])))))\n222\t  (testing \"Empty lists are self-evaluating data, constant or nested\"\n223\t    (is (= [()] (compile-and-run '[()])))\n224\t    (is (= [() 1] (compile-and-run '(let [x 1] [() x])))))\n225\t  (testing \"Nested quote is stripped and the inner form evaluated\"\n226\t    ;; (quote x) counts as constant only at top level; nested inside a\n227\t    ;; collection it must reach compile-form so the quote is stripped\n228\t    (is (= '[x] (compile-and-run (list 'let '[x 7] ['(quote x)]))))))\n229\t\n230\t\n231\t(deftest test-compile-let\n232\t  (testing \"Compiling let bindings\"\n233\t    (testing \"Single binding\"\n234\t      (let [ast (yang/compile '(let [x 1] x))]\n235\t        (is (= :application (:type ast)))\n236\t        (is (= :lambda (get-in ast [:operator :type])))\n237\t        (is (= ['x] (get-in ast [:operator :params])))\n238\t        (is (= [{:type :literal, :value 1}] (:operands ast)))))\n239\t    (testing \"Multiple bindings\"\n240\t      (let [ast (yang/compile '(let [x 1 y 2] (+ x y)))]\n241\t        (is (= :application (:type ast)))\n242\t        ;; Outer lambda for x\n243\t        (is (= :lambda (get-in ast [:operator :type])))\n244\t        (is (= ['x] (get-in ast [:operator :params])))\n245\t        ;; Inner lambda for y\n246\t        (is (= :application (get-in ast [:operator :body :type])))\n247\t        (is (= :lambda (get-in ast [:operator :body :operator :type])))\n248\t        (is (= ['y] (get-in ast [:operator :body :operator :params])))))))\n249\t\n250\t"}
