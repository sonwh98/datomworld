{"role":"tool","tool_call_id":"tool_Tb1UlISqSIg9YX5EB7oPG0OX","content":"1\t(ns yang.php.antlr.e2e-test\n2\t  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n3\t   envelope -> the bundled program on each of the four VMs (the AST walker,\n4\t   the semantic, stack and register VMs). Every fixture of\n5\t   `yang.php.antlr.programs` prints the same text on all four.\"\n6\t  (:require\n7\t    [clojure.edn :as edn]\n8\t    [clojure.java.io :as io]\n9\t    [clojure.string :as str]\n10\t    [clojure.test :refer [deftest is testing]]\n11\t    [yang.php.antlr.cst :as cst]\n12\t    [yang.php.antlr.e2e-harness :as h]\n13\t    [yang.php.antlr.packets :as packets]\n14\t    [yang.php.antlr.packets-p3b :as packets-p3b]\n15\t    [yang.php.antlr.permutations :as perms]\n16\t    [yang.php.antlr.phpt :as phpt]\n17\t    [yang.php.antlr.programs :as programs]\n18\t    [yang.php.antlr.programs-p3b :as p3b]))\n19\t\n20\t\n21\t(def ^:private vms [:ast-walker :semantic :stack :register])\n22\t\n23\t\n24\t(defn- rendered\n25\t  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n26\t  [{:keys [out uncaught]}]\n27\t  (str out\n28\t       (when uncaught\n29\t         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n30\t\n31\t\n32\t(deftest ^:slow fixtures-on-every-vm-test\n33\t  (doseq [{:keys [id source] :as fixture} programs/fixtures\n34\t          :let [out (rendered fixture)]]\n35\t    (testing (name id)\n36\t      (let [results (h/run-php source)]\n37\t        (is (not (contains? results :diagnostics)) (pr-str results))\n38\t        (doseq [k vms]\n39\t          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n40\t\n41\t\n42\t(deftest fixtures-on-the-walker-test\n43\t  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n44\t          :let [r (h/run-raw source)]]\n45\t    (is (not= :pending oracle) (name id))\n46\t    (is (= out (h/latin1->text (:php/out r))) (name id))\n47\t    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n48\t    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n49\t        (name id))))\n50\t\n51\t\n52\t(deftest packets-match-source-test\n53\t  (doseq [[id form] packets/forms\n54\t          :let [{:keys [source]} (first (filter #(= id (:id %)) programs/fixtures))]]\n55\t    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\n56\t\n57\t\n58\t(defn- matrix-rows\n59\t  [out]\n60\t  (let [[eq sp] (str/split-lines out)\n61\t        w (count programs/matrix-values)]\n62\t    {:eq (mapv #(apply str %) (partition w eq)),\n63\t     :sp (mapv #(apply str (map {\\0 \"<\", \\1 \"=\", \\2 \">\"} %)) (partition w sp))}))\n64\t\n65\t\n66\t(deftest scalar-comparison-matrix-test\n67\t  (let [{:keys [eq sp]} (matrix-rows (h/run-walker programs/matrix-source))]\n68\t    (is (= programs/equal-matrix eq))\n69\t    (is (= programs/spaceship-matrix sp))\n70\t    (testing \"cells reasoned from the manual, independent of the golden\"\n71\t      (let [idx (zipmap programs/matrix-values (range))]\n72\t        (doseq [[a b eq? cmp] programs/known-cells\n73\t                :let [i (idx a), j (idx b)]]\n74\t          (is (= (if eq? \\1 \\0) (get-in eq [i j])) (str a \" == \" b))\n75\t          (is (= (get {-1 \\<, 0 \\=, 1 \\>} cmp) (get-in sp [i j])) (str a \" <=> \" b)))))))\n76\t\n77\t\n78\t(deftest float-text-test\n79\t  (let [src (str \"<?php\\n\"\n80\t                 (apply str (for [[lit] programs/float-cases]\n81\t                              (str \"echo \" lit \", \\\"|\\\"; var_dump(\" lit \");\\n\"))))\n82\t        expected (str (apply str (for [[_ echo dump] programs/float-cases]\n83\t                                   (str echo \"|float(\" dump \")\\n\"))))]\n84\t    (is (= expected (h/run-walker src)))))\n85\t"}
