   307	(deftest inbound-oversize-is-never-deposited
   308	  (let [traffic-a (ring 16)
   309	        traffic-b (ring 16)
   310	        seam-a (bind! "a" traffic-a)
   311	        ;; the receiving socket admits at most 64 bytes of payload
   312	        seam-b (bind! "b" traffic-b 0 64)
   313	        both (await (both-bounds traffic-a traffic-b 5000))]
   314	    (is (some? both) "a socket never reported bound")
   315	    (when both
   316	      (let [local-a (:dao.stream.datagram/local (bound-of traffic-a))
   317	            local-b (:dao.stream.datagram/local (bound-of traffic-b))
   318	            writer-a (writer-for seam-a "a" local-a)
   319	            dest (:dao.stream.datagram/port local-b)]
   320	        (stream/append! writer-a (outbound "127.0.0.1" dest
   321	                                           (vec (range 100))))
   322	        (stream/append! writer-a (outbound "127.0.0.1" dest [7 7]))
   323	        (let [arrived (await (poll-until
   324	                               #(= 1 (count (received-datagrams traffic-b)))
   325	                               5000))]
   326	          (is (some? arrived) "the small datagram never arrived")
   327	          (is (= [[7 7]] (mapv payload-of (received-datagrams traffic-b)))
   328	              "the oversize datagram was dropped below the transform,
   329	                 counted, never deposited"))
   330	        (stream/close! writer-a)
{"role":"tool","tool_call_id":"tool_smtIzRXIU0CDaMT4XHaPnjkD","content":"     1\t(ns dao.stream.datagram.dart-test\n     2\t  \"The dart:io host seam (dao.stream.datagram.md 3) over real loopback\n     3\t   RawDatagramSockets: the deposit writer is the seam's only channel --\n     4\t   bound, bind-failed, send-failed and closed arrive as events on the\n     5\t   traffic ring, never as invocations -- and exact bytes with their\n     6\t   observed source round trip through the writer handle and the ring.\n     7\t\n     8\t   Dart runs one isolate, so every wait here is a turn on the event loop:\n     9\t   each fact is an `await` over a poll, and the seam's own asynchronous\n    10\t   bind completes on the same loop. Nothing in the seam schedules itself.\"\n    11\t\n    12\t  (:require [clojure.test :refer [deftest is testing]]\n    13\t            [\"dart:core\" :as core]\n    14\t            [\"dart:async\" :as async]\n    15\t            [dao.stream :as stream]\n    16\t            [dao.stream.base64 :as base64]\n    17\t            [dao.stream.datagram :as datagram]\n    18\t            [dao.stream.datagram.dart :as dart]\n    19\t            [dao.stream.ringbuffer :as ringbuffer])\n    20\t  (:import [\"dart:typed_data\" Uint8List]))\n    21\t\n    22\t\n    23\t(defn- ring\n    24\t  [capacity]\n    25\t  (:dao.stream/handle\n    26\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    27\t                         ringbuffer/capacity-key capacity})))\n    28\t\n    29\t\n    30\t(defn- values\n    31\t  [h]\n    32\t  (loop [c (:dao.stream/cursor (stream/cursor h stream/anchor-oldest))\n    33\t         acc []]\n    34\t    (let [r (stream/next h c)]\n    35\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    36\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    37\t        acc))))\n    38\t\n    39\t\n    40\t(defn- now-ms\n    41\t  []\n    42\t  (.-millisecondsSinceEpoch (core/DateTime.now)))\n    43\t\n    44\t\n    45\t(defn- sleep!\n    46\t  [ms]\n    47\t  (async/Future.delayed (core/Duration .milliseconds ms)))\n    48\t\n    49\t\n    50\t(defn- poll-until\n    51\t  \"Resolve with the first truthy value `pred` returns, or nil at the\n    52\t   deadline. The pred's answer is tested for truthiness, not nil: a\n    53\t   comparison pred answers `false` while it waits, and `false` means keep\n    54\t   polling. Polling is the only honest wait here: no operation blocks, and\n    55\t   nothing notifies.\"\n    56\t  [pred timeout-ms]\n    57\t  (let [deadline (+ (now-ms) timeout-ms)]\n    58\t    (loop []\n    59\t      (let [value (pred)]\n    60\t        (cond\n    61\t          value value\n    62\t          (< deadline (now-ms)) nil\n    63\t          :else (do (await (sleep! 10))\n    64\t                    (recur)))))))\n    65\t\n    66\t\n    67\t(defn- bind!\n    68\t  ([id traffic] (bind! id traffic 0 1200))\n    69\t  ([id traffic port max-bytes]\n    70\t   (dart/bind! {:identity id\n    71\t                :deposit traffic\n    72\t                :bind-host \"127.0.0.1\"\n    73\t                :bind-port port\n    74\t                :max-bytes max-bytes})))\n    75\t\n    76\t\n    77\t(defn- bound-of\n    78\t  [traffic]\n    79\t  (some #(when (= :dao.stream.datagram/bound (:dao.stream.datagram/event %))\n    80\t           %)\n    81\t        (values traffic)))\n    82\t\n    83\t\n    84\t(defn- writer-for\n    85\t  [seam id local]\n    86\t  (datagram/writer seam\n    87\t                   {:dao.stream/type :dao.stream/datagram\n    88\t                    :dao.stream/identity id\n    89\t                    :dao.stream.datagram/bind-host\n    90\t                    (:dao.stream.datagram/host local)\n    91\t                    :dao.stream.datagram/bind-port\n    92\t                    (:dao.stream.datagram/port local)}\n    93\t                   1200))\n    94\t\n    95\t\n    96\t(defn- u8\n    97\t  [octets]\n    98\t  (let [out (Uint8List. (count octets))]\n    99\t    (dotimes [i (count octets)]\n   100\t      (aset out i (nth octets i)))\n   101\t    out))\n   102\t\n   103\t\n   104\t(defn- outbound\n   105\t  [host port octets]\n   106\t  {:dao.stream.datagram/destination {:dao.stream.datagram/host host\n   107\t                                     :dao.stream.datagram/port port}\n   108\t   :dao.stream.datagram/bytes (base64/encode (u8 octets))})\n   109\t\n   110\t\n   111\t(defn- received-datagrams\n   112\t  [traffic]\n   113\t  (filter datagram/datagram-event? (values traffic)))\n   114\t\n   115\t\n   116\t(deftest live-socket-ip-family-failure-preserves-canary\n   117\t  (let [traffic (ring 16)\n   118\t        peer-traffic (ring 16)\n   119\t        seam (bind! \"s\" traffic)\n   120\t        peer (bind! \"peer\" peer-traffic)]\n   121\t    (try\n   122\t      (is (some? (await (poll-until #(bound-of traffic) 5000))))\n   123\t      (let [bound (await (poll-until #(bound-of peer-traffic) 5000))\n   124\t            port (:dao.stream.datagram/port\n   125\t                   (:dao.stream.datagram/local bound))\n   126\t            failed ((:send! seam) \"::1\" port (u8 [1]))]\n   127\t        (is (= :dao.stream/transport-error\n   128\t               (:dao.stream/outcome failed)))\n   129\t        (is (some? (await (poll-until\n   130\t                            #(some (fn [v]\n   131\t                                     (= :dao.stream.datagram/send-failed\n   132\t                                        (:dao.stream.datagram/event v)))\n   133\t                                   (values traffic))\n   134\t                            5000))))\n   135\t        (is (not-any? #(= :dao.stream.datagram/closed\n   136\t                          (:dao.stream.datagram/event %))\n   137\t                      (values traffic)))\n   138\t        (is (= :dao.stream/ok\n   139\t               (:dao.stream/outcome\n   140\t                 ((:send! seam) \"127.0.0.1\" port (u8 [42])))))\n   141\t        (is (some? (await (poll-until\n   142\t                            #(some (fn [v]\n   143\t                                     (= \"Kg==\" (:dao.stream.datagram/bytes v)))\n   144\t                                   (received-datagrams peer-traffic))\n   145\t                            5000)))))\n   146\t      (finally ((:close! seam)) ((:close! peer))))))\n   147\t\n   148\t\n   149\t(defn- payload-of\n   150\t  [event]\n   151\t  (mapv (fn [b] (bit-and 0xff (int b)))\n   152\t        (seq (base64/decode (:dao.stream.datagram/bytes event)))))\n   153\t\n   154\t\n   155\t(defn- octets-of\n   156\t  \"Expected octets as the wire wraps them: a datagram is bytes, so an\n   157\t   octet over 255 rides its low 8 bits.\"\n   158\t  [octets]\n   159\t  (mapv #(mod (int %) 256) octets))\n   160\t\n   161\t\n   162\t(defn- both-bounds\n   163\t  \"Await both sockets' bound events; nil at the deadline.\"\n   164\t  [traffic-a traffic-b timeout-ms]\n   165\t  (await (poll-until #(and (bound-of traffic-a) (bound-of traffic-b))\n   166\t                     timeout-ms)))\n   167\t\n   168\t\n   169\t(deftest bound-then-exact-bytes-and-observed-source-round-trip\n   170\t  (let [traffic-a (ring 16)\n   171\t        traffic-b (ring 64)\n   172\t        seam-a (bind! \"a\" traffic-a)\n   173\t        seam-b (bind! \"b\" traffic-b)\n   174\t        both (await (both-bounds traffic-a traffic-b 5000))]\n   175\t    (is (some? both) \"a socket never reported bound\")\n   176\t    (when both\n   177\t      (let [local-a (:dao.stream.datagram/local (bound-of traffic-a))\n   178\t            local-b (:dao.stream.datagram/local (bound-of traffic-b))\n   179\t            _ (is (= \"127.0.0.1\" (:dao.stream.datagram/host local-a)))\n   180\t            _ (is (pos? (:dao.stream.datagram/port local-a))\n   181\t                  \"the actual ephemeral port, never 0, though 0 was\n   182\t                     asked for\")\n   183\t            writer-a (writer-for seam-a \"a\" local-a)\n   184\t            dest (:dao.stream.datagram/port local-b)\n   185\t            ;; no zero-length payload here: dart:io sends nothing at all\n   186\t            ;; for one, refused below\n   187\t            payloads [[1 2 3] (vec (range 1 256)) (vec (range 1200))]]\n   188\t        (doseq [octets payloads]\n   189\t          (is (= {:dao.stream/outcome :dao.stream/ok}\n   190\t                 (stream/append! writer-a\n   191\t                                 (outbound \"127.0.0.1\" dest octets)))))\n   192\t        (testing \"a zero-length datagram is refused cleanly on this host:\n   193\t                  dart:io would silently send nothing for it\"\n   194\t          (is (= :dao.stream/transport-error\n   195\t                 (:dao.stream/outcome\n   196\t                   (stream/append!\n   197\t                     writer-a\n   198\t                     {:dao.stream.datagram/destination\n   199\t                      {:dao.stream.datagram/host \"127.0.0.1\"\n   200\t                       :dao.stream.datagram/port dest}\n   201\t                      :dao.stream.datagram/bytes \"\"})))))\n   202\t        (let [arrived (await (poll-until\n   203\t                               #(= (count payloads)\n   204\t                                   (count (received-datagrams traffic-b)))\n   205\t                               5000))]\n   206\t          (is (some? arrived) \"not every datagram arrived as an event\")\n   207\t          (doseq [[octets event] (map vector payloads\n   208\t                                      (received-datagrams traffic-b))]\n   209\t            (is (= \"127.0.0.1\"\n   210\t                   (get-in event [:dao.stream.datagram/source\n   211\t                                  :dao.stream.datagram/host]))\n   212\t                \"the source host the socket observed\")\n   213\t            (is (= (:dao.stream.datagram/port local-a)\n   214\t                   (get-in event [:dao.stream.datagram/source\n   215\t 