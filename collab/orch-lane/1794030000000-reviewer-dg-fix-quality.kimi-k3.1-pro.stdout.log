   224	(deftest refusals-and-lifecycle-events
   225	  (let [traffic-a (ring 16)
   226	        traffic-b (ring 64)
   227	        seam-a (bind! "a" traffic-a)
   228	        seam-b (bind! "b" traffic-b)
   229	        both (await (both-bounds traffic-a traffic-b 5000))]
   230	    (is (some? both) "a socket never reported bound")
   231	    (when both
   232	      (let [local-a (:dao.stream.datagram/local (bound-of traffic-a))
   233	            local-b (:dao.stream.datagram/local (bound-of traffic-b))
   234	            writer-a (writer-for seam-a "a" local-a)
   235	            dest (:dao.stream.datagram/port local-b)]
   236	        (testing "hostname destination, bad Base64 and oversize are
   237	                    invalid-value, and nothing is sent"
   238	          (is (= :dao.stream/invalid-value
   239	                 (:dao.stream/outcome
   240	                   (stream/append! writer-a
   241	                                   (outbound "localhost" dest [1 2 3])))))
   242	          (is (= :dao.stream/invalid-value
   243	                 (:dao.stream/outcome
   244	                   (stream/append!
   245	                     writer-a
   246	                     {:dao.stream.datagram/destination
   247	                      {:dao.stream.datagram/host "127.0.0.1"
   248	                       :dao.stream.datagram/port dest}
   249	                      :dao.stream.datagram/bytes "not base64!"}))))
   250	          (is (= :dao.stream/invalid-value
   251	                 (:dao.stream/outcome
   252	                   (stream/append! writer-a (outbound "127.0.0.1" dest
   253	                                                      (vec (range 1201))))))))
   254	        ;; one valid canary: the refusals sent nothing, so it is the one
   255	        ;; and only datagram event that ever lands
   256	        (stream/append! writer-a (outbound "127.0.0.1" dest [9 9 9]))
   257	        (let [arrived (await (poll-until
   258	                               #(= 1 (count (received-datagrams traffic-b)))
   259	                               5000))]
   260	          (is (some? arrived) "the canary never arrived")
   261	          (is (= [[9 9 9]] (mapv payload-of
   262	                                 (received-datagrams traffic-b)))))
   263	        (testing "a closed socket is closed; the seam deposits closed"
   264	          (is (= {:dao.stream/outcome :dao.stream/ok}
   265	                 (
stream/close! writer-a)))
   266	          (is (= {:dao.stream/outcome :dao.stream/closed}
   267	                 (stream/append! writer-a (outbound "127.0.0.1" dest [1]))))
   268	          (let [closed (await (poll-until
   269	                                (fn []
   270	                                  (some
   271	                                    (fn [v]
   272	                                      (= :dao.stream.datagram/closed
   273	                                         (:dao.stream.datagram/event v)))
   274	                                    (values traffic-a)))
   275	                                5000))]
   276	            (is (some? closed) "no closed event deposited")))
   277	        (testing "a send the seam itself fails is a send-failed event"
   278	          (let [r ((:send! seam-a) "127.0.0.1" 4100 (u8 [1 2 3 4]))]
   279	            (is (= :dao.stream/transport-error (:dao.stream/outcome r)))
   280	            (let [failed (await (poll-until
   281	                                  (fn []
   282	                                    (some
   283	                                      (fn [v]
   284	                                        (= :dao.stream.datagram/send-failed
   285	                                           (:dao.stream.datagram/event v)))
   286	                                      (values traffic-a)))
   287	                                  5000))]
   288	              (is (some? failed) "no send-failed event deposited"))))
   289	        (testing "a bind on a taken port deposits bind-failed"
   290	          (let [t3 (ring 8)
   291	                seam-c (bind! "loser" t3 dest 1200)]
   292	            (let [failed (await (poll-until
   293	                                  (fn []
   294	                                    (some
   295	                                      (fn [v]
   296	                                        (= :dao.stream.datagram/bind-failed
   297	                                           (:dao.stream.datagram/event v)))
   298	                                      (values t3)))
   299	                                  5000))]
   300	              (is (some? failed) "no bind-failed event deposited"))
   301	            ((:close! seam-c))))
   302	        (stream/close! writer-a)
   303	        ((:close! seam-a))
   304	        ((:close! seam-b))))))
