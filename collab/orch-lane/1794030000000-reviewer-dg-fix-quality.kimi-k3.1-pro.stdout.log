   162	(defn- both-bounds
   163	  "Await both sockets' bound events; nil at the deadline."
   164	  [traffic-a traffic-b timeout-ms]
   165	  (await (poll-until #(and (bound-of traffic-a) (bound-of traffic-b))
   166	                     timeout-ms)))
