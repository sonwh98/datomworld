   169	(deftest bound-then-exact-bytes-and-observed-source-round-trip
   170	  (let [traffic-a (ring 16)
   171	        traffic-b (ring 64)
   172	        seam-a (bind! "a" traffic-a)
   173	        seam-b (bind! "b" traffic-b)
   174	        both (await (both-bounds traffic-a traffic-b 5000))]
   175	    (is (some? both) "a socket never reported bound")
   176	    (when both
   177	      (let [local-a (:dao.stream.datagram/local (bound-of traffic-a))
   178	            local-b (:dao.stream.datagram/local (bound-of traffic-b))
   179	            _ (is (= "127.0.0.1" (:dao.stream.datagram/host local-a)))
   180	            _ (is (pos? (:dao.stream.datagram/port local-a))
   181	                  "the actual ephemeral port, never 0, though 0 was
   182	                     asked for")
   183	            writer-a (writer-for seam-a "a" local-a)
   184	            dest (:dao.stream.datagram/port local-b)
   185	            ;; no zero-length payload here: dart:io sends nothing at all
   186	            ;; for one, refused below
   187	            payloads [[1 2 3] (vec (range 1 256)) (vec (range 1200))]]
   188	        (doseq [octets payloads]
   189	          (is (= {:dao.stream/outcome :dao.stream/ok}
   190	                 (stream/append! writer-a
   191	                                 (outbound "127.0.0.1" dest octets)))))
   192	        (testing "a zero-length datagram is refused cleanly on this host:
   193	                  dart:io would silently send nothing for it"
   194	          (is (= :dao.stream/transport-error
   195	                 (:dao.stream/outcome
   196	                   (stream/append!
   197	                     writer-a
   198	                     {:dao.stream.datagram/destination
   199	                      {:dao.stream.datagram/host "127.0.0.1"
   200	                       :dao.stream.datagram/port dest}
   201	                      :dao.stream.datagram/bytes ""})))))
   202	        (let [arrived (await (poll-until
   203	                               #(= (count payloads)
   204	                                   (count (received-datagrams traffic-b)))
   205	                               5000))]
   206	          (is (some? arrived) "not every datagram arrived as an event")
   207	          (doseq [[octets event] (map vector payloads
   208	                                      (received-datagrams traffic-b))]
   209	            (is (= "127.0.0.1"
   210	                   (get-in event [:dao.stream.datagram/source
   211	                                  :dao.stream.datagram/host]))
   212	                "the source host the socket observed")
   213	            (is (= (:dao.stream.datagram/port local-a)
   214	                   (get-in event [:dao.stream.datagram/source
   215	                                  :dao.stream.datagram/port]))
   216	                "the source port the socket observed")
   217	            (is (= (octets-of octets) (payload-of event))
   218	                (str "exact payload bytes, " (count octets) " octets"))))
   219	        (stream/close! writer-a)
   220	        ((:close! seam-a))
   221	        ((:close! seam-b))))))
