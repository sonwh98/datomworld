3\t\n    44\t\n    45\t(defn- sleep!\n    46\t  [ms]\n    47\t  (async/Future.delayed (core/Duration .milliseconds ms)))\n    48\t\n    49\t\n    50\t(defn- poll-until\n    51\t  \"Resolve with the first truthy value `pred` returns, or nil at the\n    52\t   deadline. The pred's answer is tested for truthiness, not nil: a\n    53\t   comparison pred answers `false` while it waits, and `false` means keep\n    54\t   polling. Polling is the only honest wait here: no operation blocks, and\n    55\t   nothing notifies.\"\n    56\t  [pred timeout-ms]\n    57\t  (let [deadline (+ (now-ms) timeout-ms)]\n    58\t    (loop []\n    59\t      (let [value (pred)]\n    60\t        (cond\n    61\t          value value\n    62\t          (< deadline (now-ms)) nil\n    63\t          :else (do (await (sleep! 10))\n    64\t                    (recur)))))))\n    65\t\n    66\t\n    67\t(defn- bind!\n    68\t  ([id traffic] (bind! id traffic 0 1200))\n    69\t  ([id traffic port max-bytes]\n    70\t   (dart/bind! {:identity id\n    71\t                :deposit traffic\n    72\t                :bind-host \"127.0.0.1\"\n    73\t                :bind-port port\n    74\t                :max-bytes max-bytes})))\n    75\t\n    76\t\n    77\t(defn- bound-of\n    78\t  [traffic]\n    79\t  (some #(when (= :dao.stream.datagram/bound (:dao.stream.datagram/event %))\n    80\t           %)\n    81\t        (values traffic)))\n    82\t\n    83\t\n    84\t(defn- writer-for\n    85\t  [seam id local]\n    86\t  (datagram/writer seam\n    87\t                   {:dao.stream/type :dao.stream/datagram\n    88\t                    :dao.stream/identity id\n    89\t                    :dao.stream.datagram/bind-host\n    90\t                    (:dao.stream.datagram/host local)\n    91\t                    :dao.stream.datagram/bind-port\n    92\t                    (:dao.stream.datagram/port local)}\n    93\t                   1200))\n    94\t\n    95\t\n    96\t(defn- u8\n    97\t  [octets]\n    98\t  (let