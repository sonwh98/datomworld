  a host string whose every char is one byte (a latin-1\\\\n20\\\\t                     carrier); the lowering resolves literal text to bytes\\\\n21\\\\t     bool            host true / false\\\\n22\\\\t     null            :php/null\\\\n23\\\\t     array           {:php/type :array :index {key value} :order [key ...]\\\\n24\\\\t                     :next-index n}: a persistent ordered map; keys are\\\\n25\\\\t                     ints or strings (`php/array-key`); `:next-index` is\\\\n26\\\\t                     absent until the first integer key is written\\\\n27\\\\t     error object    {:php/type :obj :class name :ord n :props {\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\"\\\\n28\\\\t                     \\\\\\\\\\\\\\\"code\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"previous\\\\\\\\\\\\\\\"}}\\\\n29\\\\t     function        a cell {:php/type :function :name s :code (fn [args])\\\\n30\\\\t                             :yang.call/entry (fn [invocation])}\\\\n31\\\\t\\\\n32\\\\t   Runtime state is allocated by `php/init!`, once per task, under the slot\\\\n33\\\\t   `php.rt/state` (the literal `:php/uninit` until `php/init!` flips it to\\\\n34\\\\t   `:php/ready` as its last write):\\\\n35\\\\t     php.rt/ctx            the dynamic context {:handlers :depth :base :frame}\\\\n36\\\\t     php.rt/out            a cell holding the buffer stack, a vector of\\\\n37\\\\t                           buffers, each a vector of byte-string chunks;\\\\n38\\\\t                           `php/echo` conjs onto the last buffer, the\\\\n39\\\\t                           bottom buffer is never popped\\\\n40\\\\t     php.rt/globals        a cell holding the plain array of section 10.1\\\\n41\\\\t                           (`$GLOBALS`), `(php/empty-array)` initially\\\\n42\\\\t     php.rt/functions      a cell holding a map of lower-cased name to\\\\n43\\\\t                           function cell; builtins are pre-seeded\\\\n44\\\\t     php.rt/classes        a cell holding a map of class name to class record\\\\n45\\\\t                           (the Throwable hierarchy, data only)\\\\n46\\\\t     php.rt/next-ord       a cell, the per-task object ordinal\\\\n47\\\\t     php.rt/next-cell      a cell, the per-task counted-cell id (`:id`)\\\\n48\\\\t     php.rt/error-handler  a cell, :php/null or a callable\\\\n49\\\\t     php.rt/error-reporting a cell, the mask (E_ALL initially)\\\\n50\\\\t     php.rt/diag           a cell, the vector of diagnostic records\\\\n51\\\\t     php.rt/int-max, php.rt/int-min   exact integers computed in `init!`,\\\\n52\\\\t                           never literals (literals past 2^53 are not\\\\n53\\\\t                           portable)\\\\n54\\\\t\\\\n55\\\\t   Errors are raised with `php/raise`; with no handler frame above them they\\\\n56\\\\t   reach the unit root, `php/run-main`, which answers\\\\n57\\\\t   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\\\\n58\\\\t\\\\n59\\\\t   Float text: `php/float-text x ndigit` is `zend_gcvt`; `ndigit` 14 is\\\\n60\\\\t   `echo` (precision), 17 is `var_dump` (serialize_precision -1, the\\\\n61\\\\t   shortest round trip from `integer/float-digits`).\\\\n62\\\\t\\\\n63\\\\t   Two emitters, one source: `definitions` is the only definition list.\\\\n64\\\\t   `uast` is the bundled prelude; `module-uast` is the same list as the\\\\n65\\\\t   linker module `php`. The module emitter strips only the module's own\\\\n66\\\\t   namespace `php/`; `php.rt/*` stays qualified.\\\\n67\\\\t\\\\n68\\\\t   Host names the prelude depends on and does not define: `host-names`.\\\\\\\"\\\\n69\\\\t  (:require\\\\n70\\\\t    #?(:cljd [clojure.edn :as edn])\\\\n71\\\\t    [clojure.string :as str]\\\\n72\\\\t    [clojure.walk :as walk]\\\\n73\\\\t    [yang.core.prelude :as core]\\\\n74\\\\t    [yang.core.call :as call]\\\\n75\\\\t    [yang.core.uast :as u]\\\\n76\\\\t    [yang.php.antlr.builtins :as builtins]\\\\n77\\\\t    [yang.php.antlr.prelude-module :as module-defs]\\\\n78\\\\t    [yang.php.antlr.quoted :refer [defquoted]]\\\\n79\\\\t    [yin.vm.integer :as integer]))\\\\n80\\\\t\\\\n81\\\\t\\\\n82\\\\t(def host-names\\\\n83\\\\t  \\\\\\\"Module exports the prelude calls.\\\\\\\"\\\\n84\\\\t  (into '#{cell/new cell/get cell/set! data/count data/nth data/subvec data/str-concat\\\\n85\\\\t           data/str-length data/str-join data/str-compare data/str->code-points\\\\n86\\\\t           data/code-points->str data/substring data/float64 data/float-value\\\\n87\\\\t           data/content= data/number? data/dissoc data/into\\\\n88\\\\t           integer/add integer/sub integer/neg integer/mul integer/compare\\\\n89\\\\t           integer/to-float integer/compare-float integer/true-div integer/pow\\\\n90\\\\t           integer/shift-left integer/shift-right integer/bit-and integer/bit-or\\\\n91\\\\t           integer/bit-xor integer/bit-not integer/from-float integer/quot-rem\\\\n92\\\\t           integer/floor-div-mod integer/format integer/parse\\\\n93\\\\t           integer/float-digits integer/decimal->float}\\\\n94\\\\t        call/host-names))\\\\n95\\\\t\\\\n96\\\\t\\\\n97\\\\t(defquoted ^:private core-definitions\\\\n98\\\\t  \\\\\\\"Pure definitions: lambdas only, so defining them runs nothing.\\\\\\\"\\\\n99\\\\t  '[;; ---------------------------------------------------------------- basics\\\\n100\\\\t    [php/vconj (fn [xs x] (conj xs x))]\\\\n101\\\\t    [php/pair (fn [a b] (php/vconj (php/vconj [] a) b))]\\\\n102\\\\t    [php/f (fn [h] (data/float64 h))]\\\\n103\\\\t    [php/h (fn [x] (data/float-value x))]\\\\n104\\\\t    [php/inf (fn [] (data/float-value ##Inf))]\\\\n105\\\\t    [php/nan (fn [] (- (php/inf) (php/inf)))]\\\\n106\\\\t    [php/nan? (fn [h] (not (<= h h)))]\\\\n107\\\\t    [php/zero-h (fn [] (data/float-value 0))]\\\\n108\\\\t    ;; -0.0 is built as (* -1.0 0.0): ClojureDart compiles one-argument `-`\\\\n109\\\\t    ;; to (0 - x), and 0 - 0.0 is +0.0\\\\n110\\\\t    [php/neg-zero-h (fn [] (* (data/float-value -1) (data/float-value 0)))]\\\\n111\\\\t    [php/abs-h (fn [h] (if (< h 0) (- 0 h) h))]\\\\n112\\\\t    [php/neg-h (fn [h] (* (data/float-value -1) h))]\\\\n113\\\\t    [php/nan-const (fn [] (php/f (php/nan)))]\\\\n114\\\\t    [php/inf-const (fn [] (php/f (php/inf)))]\\\\n115\\\\t\\\\n116\\\\t    ;; ---------------------------------------------------------------- kinds\\\\n117\\\\t    ;; A string is the only value `get` answers a char (or, empty, equals\\\\n118\\\\t    ;; \\\\\\\"\\\\\\\") for; typed maps answer :php/type; what is left is a number.\\\\n119\\\\t    [php/string?\\\\n120\\\\t     (fn [x] (if (= x \\\\\\\"\\\\\\\") true (not (nil? (get x 0)))))]\\\\n121\\\\t    [php/kind\\\\n122\\\\t     (fn [x]\\\\n123\\\\t       (if (= x :php/null)\\\\n124\\\\t         :null\\\\n125\\\\t         (if (= x true)\\\\n126\\\\t           :bool\\\\n127\\\\t           (if (= x false)\\\\n128\\\\t             :bool\\\\n129\\\\t             (if (nil? (get x :php/type))\\\\n130\\\\t               (if (php/string? x)\\\\n131\\\\t                 :string\\\\n132\\\\t                 (if (not (nil? (get x :php/arr)))\\\\n133\\\\t                   :array\\\\n134\\\\t                   (if (not (nil? (get x :php/obj)))\\\\n135\\\\t                     :obj\\\\n136\\\\t                     (if (not (nil? (get x :php/ref)))\\\\n137\\\\t                       (php/kind (php/ref-value x))\\\\n138\\\\t                       (if (data/content= x (data/float64 (data/float-value x)))\\\\n139\\\\t                         :float\\\\n140\\\\t                         :int)))))\\\\n141\\\\t               (if (= (get x :php/type) :array) :array :obj))))))]\\\\n142\\\\t    [php/int? (fn [x] (= (php/kind x) :int))]\\\\n143\\\\t    [php/float? (fn [x] (= (php/kind x) :float))]\\\\n144\\\\t    [php/numk? (fn [k] (if (= k :int) true (= k :float)))]\\\\n145\\\\t    [php/fl\\\\n146\\\\t     ;; the host double of an int or float\\\\n147\\\\t     (fn [x] (if (php/int? x) (integer/to-float x) (data/float-value x)))]\\\\n148\\\\t    [php/type-name\\\\n149\\\\t     (fn [k]\\\\n150\\\\t       (if (= k :string) \\\\\\\"string\\\\\\\"\\\\n151\\\\t           (if (= k :int) \\\\\\\"int\\\\\\\"\\\\n152\\\\t               (if (= k :float) \\\\\\\"float\\\\\\\"\\\\n153\\\\t                   (if (= k :bool) \\\\\\\"bool\\\\\\\"\\\\n154\\\\t                       (if (= k :null) \\\\\\\"null\\\\\\\"\\\\n155\\\\t                           (if (= k :array) \\\\\\\"array\\\\\\\" \\\\\\\"mixed\\\\\\\")))))))]\\\\n156\\\\t\\\\n157\\\\t    ;; ---------------------------------------------------------------- escapes\\\\n158\\\\t    ;; The dynamic context is one record in one cell: every capture point\\\\n159\\\\t    ;; saves it and every escape restores it with :base left alone. The\\\\n160\\\\t    ;; handler stack is a chain of frames [kind payload rest n depth].\\\\n161\\\\t    [php/ctx\\\\n162\\\\t     (fn [handlers depth base frame]\\\\n163\\\\t       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\\\\n164\\\\t                     :base base)\\\\n165\\\\t              :frame frame))]\\\\n166\\\\t    [php/restore!\\\\n167\\\\t     (fn [saved]\\\\n168\\\\t       (cell/set! php.rt/ctx\\\\n169\\\\t                  (assoc saved :base (get (cell/get php.rt/ctx) :base))))]\\\\n170\\\\t    [php/handlers (fn [] (get (cell/get php.rt/ctx) :handlers))]\\\\n171\\\\t    [php/set-handlers!\\\\n172\\\\t     (fn [hs] (cell/set! php.rt/ctx (assoc (cell/get php.rt/ctx) :handlers hs)))]\\\\n173\\\\t    [php/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\\\\n174\\\\t    [php/frame\\\\n175\\\\t     (fn [kind payload rest]\\\\n176\\\\t       (php/vconj (php/vconj (php/vconj (php/vconj (php/vconj [] kind) payload) rest)\\\\n177\\\\t                             (+ 1 (php/frame-depth rest)))\\\\n178\\\\t                  (get (cell/get php.rt/ctx) :depth)))]\\\\n179\\\\t    [php/pop-frame\\\\n180\\\\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\\\\n181\\\\t     (fn [