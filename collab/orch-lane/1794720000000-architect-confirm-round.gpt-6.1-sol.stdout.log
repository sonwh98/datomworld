m.started\",\"item\":{\"id\":\"item_27\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba test/yang/php/antlr/e2e_harness.clj | sed -n '1,260p'; nl -ba src/cljc/yang/php/antlr/lower.cljc | sed -n '3750,3810p'; nl -ba src/cljc/yang/php/antlr/prelude_module.cljc | sed -n '1,185p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_27\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba test/yang/php/antlr/e2e_harness.clj | sed -n '1,260p'; nl -ba src/cljc/yang/php/antlr/lower.cljc | sed -n '3750,3810p'; nl -ba src/cljc/yang/php/antlr/prelude_module.cljc | sed -n '1,185p'\\\"\",\"aggregated_output\":\"     1\\t(ns yang.php.antlr.e2e-harness\\n     2\\t  \\\"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\\n     3\\t   program envelope -> the bundled program on each of the four VMs. Output\\n     4\\t   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\n     5\\t   here at the boundary.\\\"\\n     6\\t  (:require\\n     7\\t    [clojure.walk :as walk]\\n     8\\t    [dao.host.text :as text]\\n     9\\t    [dao.stream :as stream]\\n    10\\t    [yang.php.antlr.cst :as cst]\\n    11\\t    [yang.php.antlr.lower :as lower]\\n    12\\t    [yang.php.antlr.portable-harness :as portable]\\n    13\\t    [yang.php.antlr.safepoint :as hooks]\\n    14\\t    [yang.core.uast :as u]\\n    15\\t    [yang.safepoint :as safepoint]\\n    16\\t    [yin.vm :as vm]\\n    17\\t    [yin.vm.debruijn.register :as rvm]\\n    18\\t    [yin.vm.debruijn.stack :as dvm]\\n    19\\t    [yin.vm.encoder :as encoder]\\n    20\\t    [yin.vm.semantic :as semantic]\\n    21\\t    [yin.vm.semantic.derive :as derive]\\n    22\\t    [yin.vm.semantic.linearize :as sr-linearize]\\n    23\\t    [yin.vm.test-utils :as tu]))\\n    24\\t\\n    25\\t\\n    26\\t(defn host-registry\\n    27\\t  \\\"The registry the PHP compositions run over.\\\"\\n    28\\t  []\\n    29\\t  (portable/host-registry))\\n    30\\t\\n    31\\t\\n    32\\t(def ^:private base-opts\\n    33\\t  {:make-stream tu/make-stream,\\n    34\\t   :capability-secret tu/secret,\\n    35\\t   :primitives vm/primitives})\\n    36\\t\\n    37\\t\\n    38\\t(def ^:private load-semantic\\n    39\\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\n    40\\t\\n    41\\t\\n    42\\t(defn lower-program\\n    43\\t  \\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\n    44\\t   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\\"\\n    45\\t  [source]\\n    46\\t  (let [cst-log (tu/new-memory-log)\\n    47\\t        program (tu/new-memory-log)\\n    48\\t        diagnostics (tu/new-memory-log)]\\n    49\\t    (stream/append! cst-log (cst/parse-source source))\\n    50\\t    (lower/step-stage (lower/open-stage cst-log program diagnostics\\n    51\\t                                        {:medium lower/program-medium}))\\n    52\\t    (let [{warnings true, problems false}\\n    53\\t          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\n    54\\t      (if (seq problems)\\n    55\\t        {:diagnostics problems}\\n    56\\t        (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\n    57\\t          {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)})))))\\n    58\\t\\n    59\\t\\n    60\\t(defn packet->form\\n    61\\t  \\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\n    62\\t   rule, `[\\\\\\\"TYPE\\\\\\\" \\\\\\\"text\\\\\\\"]` for a token. The inverse of\\n    63\\t   `portable-harness/packet`.\\\"\\n    64\\t  [{:yang.cst/keys [root nodes]}]\\n    65\\t  (letfn [(form\\n    66\\t            [id]\\n    67\\t            (let [{:keys [kind rule type text children]} (nth nodes id)]\\n    68\\t              (if (= :token kind)\\n    69\\t                [type text]\\n    70\\t                (into [(keyword rule)] (map form) children))))]\\n    71\\t    (form root)))\\n    72\\t\\n    73\\t\\n    74\\t(defn latin1->text\\n    75\\t  \\\"The UTF-8 text of the byte carrier `s`.\\\"\\n    76\\t  [s]\\n    77\\t  (text/utf8-decode (.getBytes ^String s \\\"ISO-8859-1\\\")))\\n    78\\t\\n    79\\t\\n    80\\t(defn render\\n    81\\t  \\\"The text a unit prints: its output, then, for an uncaught error, the\\n    82\\t   fatal line (no path, plan section 3.9).\\\"\\n    83\\t  [{:php/keys [out uncaught fatal]}]\\n    84\\t  (str (latin1->text out)\\n    85\\t       (when uncaught\\n    86\\t         (str \\\"PHP Fatal error:  Uncaught \\\" (:class uncaught) \\\": \\\" (:message uncaught)))\\n    87\\t       (when fatal\\n    88\\t         (str \\\"PHP Fatal error:  \\\" fatal))))\\n    89\\t\\n    90\\t\\n    91\\t(defn run-vms\\n    92\\t  \\\"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\\n    93\\t   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\\n    94\\t   and starts one per-run counter; no option leaves the AST unchanged.\\\"\\n    95\\t  ([registry ast] (run-vms registry ast {}))\\n    96\\t  ([registry ast {:keys [execution-budget envelope]}]\\n    97\\t   (let [ast (if (some? execution-budget)\\n    98\\t               (let [projected (encoder/project envelope)\\n    99\\t                     derived (:envelope (safepoint/derive-envelope\\n   100\\t                                          projected hooks/profile :test/derived))\\n   101\\t                     tree (nth (:yin/batch derived) (:yin/root derived))]\\n   102\\t                 (hooks/program execution-budget\\n   103\\t                                (vm/semantic-bytecode->ast tree)))\\n   104\\t               ast)\\n   105\\t         opts (assoc base-opts :modules registry)\\n   106\\t         session (tu/make-observer-session (tu/create-vm {:modules registry}))\\n   107\\t         datoms (vec (vm/ast->datoms ast))\\n   108\\t         projected #(:vector (sr-linearize/project ast))\\n   109\\t         attempt (fn [f]\\n   110\\t                   (try (render (f))\\n   111\\t                        (catch Exception e [:thrown (ex-message e)])))]\\n   112\\t     (tu/queue-ast! session ast)\\n   113\\t     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\\n   114\\t      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\\n   115\\t                                                           datoms)))),\\n   116\\t      :stack (attempt #(vm/value (vm/run (dvm/create-vm\\n   117\\t                                           (:image (derive/stack-image (projected)))\\n   118\\t                                           (assoc opts :contract vm/stack-contract))))),\\n   119\\t      :register (attempt #(vm/value (vm/run (rvm/create-vm\\n   120\\t                                              (derive/register-image (projected))\\n   121\\t                                              (assoc opts\\n   122\\t                                                     :contract\\n   123\\t                                                     vm/register-contract)))))})))\\n   124\\t\\n   125\\t\\n   126\\t(defn run-php\\n   127\\t  \\\"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\\n   128\\t   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\\\"\\n   129\\t  ([source] (run-php source {}))\\n   130\\t  ([source options]\\n   131\\t   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\\n   132\\t     (if diagnostics\\n   133\\t       {:diagnostics diagnostics}\\n   134\\t       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\\n   135\\t\\n   136\\t\\n   137\\t(defn run-walker\\n   138\\t  \\\"The ast-walker's rendering of `source` alone (fast iteration).\\\"\\n   139\\t  [source]\\n   140\\t  (let [{:keys [ast diagnostics]} (lower-program source)]\\n   141\\t    (if diagnostics\\n   142\\t      {:diagnostics diagnostics}\\n   143\\t      (let [registry (host-registry)\\n   144\\t            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\\n   145\\t        (tu/queue-ast! session ast)\\n   146\\t        (try (render (vm/value (:consumer (tu/run-session session))))\\n   147\\t             (catch Exception e [:thrown (ex-message e)]))))))\\n   148\\t\\n   149\\t\\n   150\\t(defn run-raw\\n   151\\t  \\\"The unit's value on the AST walker, optionally after binding a request record.\\\"\\n   152\\t  ([source] (run-raw source nil))\\n   153\\t  ([source request]\\n   154\\t   (let [{:keys [ast diagnostics]} (lower-program source)]\\n   155\\t     (if diagnostics\\n   156\\t       {:diagnostics diagnostics}\\n   157\\t       (let [session (tu/make-observer-session\\n   158\\t                       (tu/create-vm {:modules (host-registry)}))\\n   159\\t             ast (if request\\n   160\\t                   (walk/postwalk\\n   161\\t                     (fn [node]\\n   162\\t                       (if (and (map? node)\\n   163\\t                                (= :application (:type node))\\n   164\\t                                (= 'php/run-main (get-in node [:operator :name])))\\n   165\\t                         (let [body (first (:operands node))]\\n   166\\t                           (assoc node :operands\\n   167\\t                                  [(u/lam []\\n   168\\t                                          (u/then\\n   169\\t                                            (u/sexp->uast (list 'php/bind-request! request))\\n   170\\t                                            (u/app body)))]))\\n   171\\t                         node))\\n   172\\t                     ast)\\n   173\\t                   ast)]\\n   174\\t         (tu/queue-ast! session ast)\\n   175\\t         (vm/value (:consumer (tu/run-session session))))))))\\n  3750\\t  \\\"`(php/bind-path-map! {path thunk ...})` for the composition's published\\n  3751\\t   paths (plan P6 R3): the computed include's lookup table.\\\"\\n  3752\\t  [paths]\\n  3753\\t  (app* 'php/bind-path-map!\\n  3754\\t        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\\n  3755\\t                (u/lit {})\\n  3756\\t                (sort paths))))\\n  3757\\t\\n  3758\\t\\n  3759\\t(defn lower-program\\n  3760\\t  \\\"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\\n  3761\\t   `php/run-main` after the prelude, tail calls marked. Its value is\\n  3762\\t   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\\n  3763\\t   `:warnings` are the lowering's warning-severity diagnostics\\n  3764\\t   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\\n  3765\\t   `:yang.php/computed-include-path`).\\n  3766\\t\\n  3767\\t   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\\n  3768\\t   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\\n  3769\\t   need); `:path` the entry unit's declared path (default `entry-path`);\\n  3770\\t   `:paths` the normalized paths whose units the composition published,\\n  3771\\t   which a computed include resolves against; `:class-map` true requires\\n  3772\\t   the published `phpm.$classmap` and binds its classes and delivery thunks\\n  3773\\t   (plan P6 R9), which takes the place of `:paths`.\\\"\\n  3774\\t  ([packet] (lower-program packet {}))\\n  3775\\t  ([packet {:keys [prelude paths path class-map], :or {prelude :bundled}}]\\n  3776\\t   (when-not (contains? #{:bundled :linked} prelude)\\n  3777\\t     (throw (ex-info \\\"unknown PHP prelude profile\\\"\\n  3778\\t                     {:yang.php/diagnostic :yang.php/unsupported,\\n  3779\\t                      :construct :prelude,\\n  3780\\t                      :prelude prelude})))\\n  3781\\t   (let [linked? (= :linked prelude)\\n  3782\\t         ctx (context packet {:path (or path entry-path), :linked? linked?})\\n  3783\\t         main (app* 'php/run-main (u/lam [] (unit-node ctx)))]\\n  3784\\t     {:ast (u/mark-tails\\n  3785\\t             (if linked?\\n  3786\\t               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\\n  3787\\t                                     (app* 'require (u/lit prelude/module-name))\\n  3788\\t                                     (app* 'php/init!)]\\n  3789\\t                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\\n  3790\\t                                    (when class-map\\n  3791\\t                                      [(app* 'require (u/lit classmap-module))\\n  3792\\t                                       (app* 'php/bind-class-map!\\n  3793\\t                                             (u/v (symbol (str classmap-module) \\\"classes\\\"))\\n  3794\\t                                             (u/v (symbol (str classmap-module) \\\"paths\\\")))])\\n  3795\\t                                    [main]))\\n  3796\\t               (u/then prelude/uast main))),\\n  3797\\t      :warnings @(:warnings ctx)})))\\n  3798\\t\\n  3799\\t\\n  3800\\t(defn lower-packet\\n  3801\\t  \\\"The complete program for one ok packet (`lower-program`'s `:ast`).\\\"\\n  3802\\t  ([packet] (lower-packet packet {}))\\n  3803\\t  ([packet opts] (:ast (lower-program packet opts))))\\n  3804\\t\\n  3805\\t\\n  3806\\t;; =============================================================================\\n  3807\\t;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\\n  3808\\t;; =============================================================================\\n  3809\\t\\n  3810\\t(def module-exports\\n     1\\t(ns ^{:clj-kondo/config '{:lint-as {yang.php.antlr.quoted/defquoted clojure.core/def}}}\\n     2\\t yang.php.antlr.prelude-module\\n     3\\t  \\\"The include/require runtime of the PHP profile (docs/design/yang.php.md\\n     4\\t   section 11, plan P6 R3/R4): the four kinds, the `_once` check, the two\\n     5\\t   missing stages. Guest code like the rest of the prelude; the lowering\\n     6\\t   emits only applications of these names.\\n     7\\t\\n     8\\t   Runtime state `php/init!` allocates for it (prelude.cljc owns the keys):\\n     9\\t     php.rt/included   a cell, map of normalized path to true; written on\\n    10\\t                       `:ok` delivery only, never on a refusal\\n    11\\t     php.rt/unit       a cell, the executing unit's path or :php/null\\n    12\\t     php.rt/path-map   a cell, map of normalized path to a delivery thunk\\n    13\\t                       (the literal path map of the composition's `:paths`)\\\"\\n    14\\t  (:require\\n    15\\t    #?(:cljd [clojure.edn :as edn])\\n    16\\t    [yang.php.antlr.quoted :refer [defquoted]]))\\n    17\\t\\n    18\\t\\n    19\\t(def include-path-text\\n    20\\t  \\\"The `include_path` the missing-include texts print: the oracle image's\\n    21\\t   default. PENDING the S0 oracle pin (php:8.3-cli reports\\n    22\\t   `.:/usr/local/lib/php`).\\\"\\n    23\\t  \\\".:/usr/local/lib/php\\\")\\n    24\\t\\n    25\\t\\n    26\\t(def include-kinds\\n    27\\t  \\\"The four kinds the lowering passes to `php/include-run`.\\\"\\n    28\\t  #{:include :include-once :require :require-once})\\n    29\\t\\n    30\\t\\n    31\\t(defquoted ^:private module-forms\\n    32\\t  \\\"The include definitions, `[store-key form]`.\\\"\\n    33\\t  '[[php/include-kind-name\\n    34\\t     (fn [kind]\\n    35\\t       (if (= kind :include)\\n    36\\t         \\\"include\\\"\\n    37\\t         (if (= kind :include-once)\\n    38\\t           \\\"include_once\\\"\\n    39\\t           (if (= kind :require) \\\"require\\\" \\\"require_once\\\"))))]\\n    40\\t    [php/include-require?\\n    41\\t     (fn [kind] (if (= kind :require) true (= kind :require-once)))]\\n    42\\t    [php/include-once?\\n    43\\t     (fn [kind] (if (= kind :include-once) true (= kind :require-once)))]\\n    44\\t    [php/warn-refusal\\n    45\\t     ;; php/warn with the structured refusal on the record (plan R4)\\n    46\\t     (fn [errno msg refusal]\\n    47\\t       (let [rec (assoc (php/warn-record errno msg) :yang.php/refusal refusal)\\n    48\\t             h (cell/get php.rt/error-handler)]\\n    49\\t         (if (= h :php/null)\\n    50\\t           (php/warn-sink rec)\\n    51\\t           (if (= (php/invoke-handler h errno msg) false)\\n    52\\t             (php/warn-sink rec)\\n    53\\t             :php/null))))]\\n    54\\t    [php/include-missing!\\n    55\\t     ;; the refusal map follows the base kind; the texts carry the kind as\\n    56\\t     ;; written; a refused path is never marked included\\n    57\\t     (fn [path kind refusal]\\n    58\\t       (let [nm (php/include-kind-name kind)]\\n    59\\t         (do (php/warn-refusal\\n    60\\t               2\\n    61\\t               (data/str-concat\\n    62\\t                 (data/str-concat (data/str-concat nm \\\"(\\\") path)\\n    63\\t                 \\\"): Failed to open stream: No such file or directory\\\")\\n    64\\t               refusal)\\n    65\\t             (if (php/include-require? kind)\\n    66\\t               (php/throw-error\\n    67\\t                 \\\"Error\\\"\\n    68\\t                 (data/str-concat\\n    69\\t                   (data/str-concat\\n    70\\t                     (data/str-concat \\\"Failed opening required '\\\" path)\\n    71\\t                     \\\"' (include_path='\\\")\\n    72\\t                   (data/str-concat php/include-path \\\"')\\\")))\\n    73\\t               (do (php/warn-refusal\\n    74\\t                     2\\n    75\\t                     (data/str-concat\\n    76\\t                       (data/str-concat\\n    77\\t                         (data/str-concat\\n    78\\t                           (data/str-concat nm \\\"(): Failed opening '\\\")\\n    79\\t                           path)\\n    80\\t                         \\\"' for inclusion (include_path='\\\")\\n    81\\t                       (data/str-concat php/include-path \\\"')\\\"))\\n    82\\t                     refusal)\\n    83\\t                   false)))))]\\n    84\\t    [php/include-body\\n    85\\t     ;; marks the path before the body runs, names the unit while it runs,\\n    86\\t     ;; answers the body's `return` value, else 1\\n    87\\t     (fn [path delivered scope ctx]\\n    88\\t       (let [prev (cell/get php.rt/unit)]\\n    89\\t         (do (cell/set! php.rt/included (assoc (cell/get php.rt/included) path true))\\n    90\\t             (cell/set! php.rt/unit path)\\n    91\\t             (php/try-finally\\n    92\\t               (fn []\\n    93\\t                 (let [v ((get delivered :body) scope ctx)]\\n    94\\t                   (if (= v :php/no-return) 1 v)))\\n    95\\t               (fn [x] (cell/set! php.rt/unit prev))))))]\\n    96\\t    [php/include-run\\n    97\\t     ;; `thunk` answers {:status :ok :body b} or the structured refusal\\n    98\\t     (fn [path thunk kind scope ctx]\\n    99\\t       (if (if (php/include-once? kind)\\n   100\\t             (not (nil? (get (cell/get php.rt/included) path)))\\n   101\\t             false)\\n   102\\t         true\\n   103\\t         (let [r (thunk)]\\n   104\\t           (if (= (get r :status) :ok)\\n   105\\t             (php/include-body path r scope ctx)\\n   106\\t             (php/include-missing! path kind r)))))]\\n   107\\t    [php/normalize-path\\n   108\\t     ;; the computed arm's lookup key: leading \\\"./\\\" segments dropped\\n   109\\t     (fn [s]\\n   110\\t       (if (if (>= (data/str-length s) 2) (= (data/substring s 0 2) \\\"./\\\") false)\\n   111\\t         (php/normalize-path (data/substring s 2))\\n   112\\t         s))]\\n   113\\t    [php/include-computed\\n   114\\t     ;; a computed path is a run-time lookup in the published path map; a\\n   115\\t     ;; miss is the run-time missing-include behaviour for the kind\\n   116\\t     (fn [pathv kind scope ctx]\\n   117\\t       (let [path (php/normalize-path (php/to-string pathv))\\n   118\\t             thunk (get (cell/get php.rt/path-map) path)]\\n   119\\t         (php/include-run\\n   120\\t           path\\n   121\\t           (if (nil? thunk)\\n   122\\t             (fn []\\n   123\\t               (assoc (assoc {} :status :refused)\\n   124\\t                      :reason :yang.php/computed-path-unmapped))\\n   125\\t             thunk)\\n   126\\t           kind\\n   127\\t           scope\\n   128\\t           ctx)))]\\n   129\\t    ;; ---------------------------------------------------------------- scopes\\n   130\\t    ;; An including scope is `:php/globals` (the entry unit's top level) or a\\n   131\\t    ;; scope cell: name to the variable's own cell, in insertion order. A\\n   132\\t    ;; dynamic-profile function adopts the cells its body already holds, so an\\n   133\\t    ;; included body and the function see one variable.\\n   134\\t    [php/scope-new\\n   135\\t     (fn [] (cell/new (assoc (assoc {} :cells {}) :order [])))]\\n   136\\t    [php/scope-adopt!\\n   137\\t     (fn [d name c]\\n   138\\t       (let [s (cell/get d)]\\n   139\\t         (do (cell/set! d (assoc (assoc s :cells (assoc (get s :cells) name c))\\n   140\\t                                 :order (php/vconj (get s :order) name)))\\n   141\\t             c)))]\\n   142\\t    [php/scope-cell\\n   143\\t     (fn [d name]\\n   144\\t       (let [c (get (get (cell/get d) :cells) name)]\\n   145\\t         (if (nil? c) (php/scope-adopt! d name (cell/new :php/undef)) c)))]\\n   146\\t    [php/scope-release-loop\\n   147\\t     (fn [cells order i]\\n   148\\t       (if (< i (data/count order))\\n   149\\t         (do (php/unset-cv (get cells (get order i)))\\n   150\\t             (php/scope-release-loop cells order (+ i 1)))\\n   151\\t         (php/flush-pending!)))]\\n   152\\t    [php/scope-release!\\n   153\\t     (fn [d] (let [s (cell/get d)] (php/scope-release-loop (get s :cells) (get s :order) 0)))]\\n   154\\t    [php/dict-get\\n   155\\t     (fn [d name]\\n   156\\t       (if (= d :php/globals) (php/global-get name) (php/local-get (php/scope-cell d name) name)))]\\n   157\\t    [php/dict-peek\\n   158\\t     (fn [d name]\\n   159\\t       (if (= d :php/globals) (php/global-peek name) (php/local-peek (php/scope-cell d name))))]\\n   160\\t    [php/dict-set!\\n   161\\t     (fn [d name v]\\n   162\\t       (if (= d :php/globals) (php/global-set! name v) (php/local-set! (php/scope-cell d name) v)))]\\n   163\\t    [php/dict-put!\\n   164\\t     (fn [d name v]\\n   165\\t       (if (= d :php/globals) (php/global-put! name v) (php/local-put! (php/scope-cell d name) v)))]\\n   166\\t    [php/dict-make-ref!\\n   167\\t     (fn [d name]\\n   168\\t       (if (= d :php/globals) (php/global-make-ref! name) (php/make-ref-cv (php/scope-cell d name))))]\\n   169\\t    [php/dict-bind!\\n   170\\t     (fn [d name m]\\n   171\\t       (if (= d :php/globals) (php/global-bind! name m) (php/bind-marker (php/scope-cell d name) m)))]\\n   172\\t    [php/dict-isset?\\n   173\\t     (fn [d name]\\n   174\\t       (if (= d :php/globals) (php/global-isset? name) (php/local-isset? (php/scope-cell d name))))]\\n   175\\t    [php/dict-unset!\\n   176\\t     (fn [d name]\\n   177\\t       (if (= d :php/globals) (php/global-unset! name) (php/local-unset! (php/scope-cell d name))))]\\n   178\\t    [php/dict-capture\\n   179\\t     (fn [d name]\\n   180\\t       (if (= d :php/globals) (php/global-capture name) (php/local-capture (php/scope-cell d name))))]\\n   181\\t    [php/name-start?\\n   182\\t     (fn [c]\\n   183\\t       (if (if (>= c 97) (<= c 122) false) true\\n   184\\t           (if (if (>= c 65) (<= c 90) false) true (if (= c 95) true (>= c 128)))))]\\n   185\\t    [php/name-rest?\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_28\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba test/y