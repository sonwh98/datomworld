\\\\n3080\\\\t                       (cond\\\\n3081\\\\t                         checked? (app* 'php/return-none (u/lit rtype) (u/lit written))\\\\n3082\\\\t                         never? (app* 'php/never-returned (u/lit written))\\\\n3083\\\\t                         :else (u/lit :php/null))))\\\\n3084\\\\t        body (if (seq prologue) (u/then (u/seq-nodes prologue) body) body)\\\\n3085\\\\t        checks (keep-indexed (fn [i pp]\\\\n3086\\\\t                               (when (and (:type pp) (not (:variadic? pp)))\\\\n3087\\\\t                                 (app* 'php/check-param-cell! (u/v (symbol (:name pp))) (u/lit (:type pp))\\\\n3088\\\\t                                       (u/lit written) (u/lit (inc i)) (u/lit (bare (:name pp))))))\\\\n3089\\\\t                             params)\\\\n3090\\\\t        body (if (seq checks) (u/then (u/seq-nodes checks) body) body)\\\\n3091\\\\t        body (if has-return? (app* 'php/call-ec (u/lam ['%ret] body)) body)\\\\n3092\\\\t        cvs (concat (map :name params) (map :name captures) static-names-v locals)\\\\n3093\\\\t        body (if generator?\\\\n3094\\\\t               (app* 'php/make-generator\\\\n3095\\\\t                     (u/lit written)\\\\n3096\\\\t                     (u/lam ['%gen] body)\\\\n3097\\\\t                     (u/lam []\\\\n3098\\\\t                            (app* 'php/release-cvs\\\\n3099\\\\t                                  (args-vector (map #(u/v (symbol %)) cvs))\\\\n3100\\\\t                                  (u/lit 0)\\\\n3101\\\\t                                  (u/lit (count cvs)))))\\\\n3102\\\\t               body)\\\\n3103\\\\t        variadic? (boolean (some :variadic? params))\\\\n3104\\\\t        fixed (remove :variadic? params)\\\\n3105\\\\t        total (count fixed)\\\\n3106\\\\t        required (inc (or (last (keep-indexed (fn [i p] (when-not (:default p) i)) fixed)) -1))\\\\n3107\\\\t        bindings (concat\\\\n3108\\\\t                   (map-indexed (fn [i p]\\\\n3109\\\\t                                  [(symbol (:name p))\\\\n3110\\\\t                                   (param-binding fctx n written required (= required total) i p)])\\\\n3111\\\\t                                params)\\\\n3112\\\\t                   (map (fn [c]\\\\n3113\\\\t                          [(symbol (:name c))\\\\n3114\\\\t                           (if (:ref? c)\\\\n3115\\\\t                             (app* 'php/param-ref\\\\n3116\\\\t                                   (u/v (:sym c))\\\\n3117\\\\t                                   (u/lit \\\\\\\"sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb\\\\\\\"))\\\\n3118\\\\t                             (app* 'php/copy-capture (u/v (:sym c))))])\\\\n3119\\\\t                        captures)\\\\n3120\\\\t                   (map (fn [nm] [(symbol nm) (u/lit :php/undef)])\\\\n3121\\\\t                        (:statics scope))\\\\n3122\\\\t                   (map (fn [nm] [(symbol nm) (u/lit :php/undef)]) locals))\\\\n3123\\\\t        cell-bindings (map (fn [[sym _]] [sym (app* 'cell/new (u/lit :php/undef))]) bindings)\\\\n3124\\\\t        initializers (map (fn [[sym value]] (app* 'cell/set! (u/v sym) value)) bindings)\\\\n3125\\\\t        init-node (if (seq initializers) (u/seq-nodes initializers) (u/lit :php/null))\\\\n3126\\\\t        body (if dyn?\\\\n3127\\\\t               (u/let1 '%scope\\\\n3128\\\\t                       (app* 'php/scope-new)\\\\n3129\\\\t                       (let [scoped-body\\\\n3130\\\\t                             (u/then (u/seq-nodes\\\\n3131\\\\t                                       (concat [init-node]\\\\n3132\\\\t                                               (map (fn [nm]\\\\n3133\\\\t                                                      (app* 'php/scope-adopt! (u/v '%scope) (u/lit (bare nm))\\\\n3134\\\\t                                                            (u/v (symbol nm))))\\\\n3135\\\\t                                                    cvs)\\\\n3136\\\\t                                               [(u/lit :php/null)]))\\\\n3137\\\\t                                     body)]\\\\n3138\\\\t                         (if (and (not generator?) (seq cvs))\\\\n3139\\\\t                           (app* 'php/try-finally\\\\n3140\\\\t                                 (u/lam [] scoped-body)\\\\n3141\\\\t                                 (u/lam ['%x] (app* 'php/scope-release! (u/v '%scope))))\\\\n3142\\\\t                           scoped-body)))\\\\n3143\\\\t               (let [initialized-body (u/then init-node body)]\\\\n3144\\\\t                 (if (and (not generator?) (seq cvs))\\\\n3145\\\\t                   (app* 'php/try-finally\\\\n3146\\\\t                         (u/lam [] initialized-body)\\\\n3147\\\\t                         (u/lam ['%x]\\\\n3148\\\\t                                (app* 'php/release-cvs\\\\n3149\\\\t                                      (args-vector (map #(u/v (symbol %)) cvs))\\\\n3150\\\\t                                      (u/lit 0)\\\\n3151\\\\t                                      (u/lit (count cvs)))))\\\\n3152\\\\t                   initialized-body)))\\\\n3153\\\\t        wrapped (reduce (fn [inner [sym value]] (u/let1 sym value inner))\\\\n3154\\\\t                        body\\\\n3155\\\\t                        (reverse cell-bindings))]\\\\n3156\\\\t    [(u/lam (if closure?\\\\n3157\\\\t              ['%fn '%args '%binding-profile '%cc]\\\\n3158\\\\t              ['%fn '%args '%binding-profile])\\\\n3159\\\\t            (if closure?\\\\n3160\\\\t              (u/let1 '%cc (app* 'php/scope-of (u/v '%fn) (cc-node ctx)) wrapped)\\\\n3161\\\\t              wrapped))\\\\n3162\\\\t     {:required required,\\\\n3163\\\\t      :total total,\\\\n3164\\\\t      :variadic variadic?,\\\\n3165\\\\t      :names (mapv #(bare (:name %)) fixed)}\\\\n3166\\\\t     (mapv bare (:statics scope))]))\\\\n3167\\\\t\\\\n3168\\\\t\\\\n3169\\\\t(defn- lower-function\\\\n3170\\\\t  [ctx n]\\\\n3171\\\\t  (let [written (ns-prefixed ctx (function-written ctx n))\\\\n3172\\\\t        [lam spec statics] (function-lam ctx n written {})]\\\\n3173\\\\t    (app* 'php/declare-function!\\\\n3174\\\\t          (u/lit (str/lower-case written))\\\\n3175\\\\t          (app* 'php/make-function (u/lit written) (u/lit spec) lam (u/lit statics)))))\\\\n3176\\\\t\\\\n3177\\\\t\\\\n3178\\\\t(defn- use-vars\\\\n3179\\\\t  \\\\\\\"`[{:name :ref?}]` of a closure's `use` clause.\\\\\\\"\\\"}\\ncollab/orch-lane/1793545000000-architect-p4-stress-budget-ruling.kimi-k3.1-pro.stdout.log:2:{\\\"role\\\":\\\"assistant\\\",\\\"tool_calls\\\":[{\\\"type\\\":\\\"function\\\",\\\"id\\\":\\\"tool_94SiFvQKhbLiZQ5sRqfCe6Y8\\\",\\\"function\\\":{\\\"name\\\":\\\"Read\\\",\\\"arguments\\\":\\\"{\\\\\\\"path\\\\\\\":\\\\\\\"/tmp/orch/kimi-budget-ruling.md\\\\\\\"}\\\"}}]}\\ncollab/orch-lane/1793545000000-architect-p4-stress-budget-ruling.kimi-k3.1-pro.stdout.log:3:{\\\"role\\\":\\\"tool\\\",\\\"tool_call_id\\\":\\\"tool_94SiFvQKhbLiZQ5sRqfCe6Y8\\\",\\\"content\\\":\\\"1\\\\tCreated-Local: 2026-11-02 01:5x +0700\\\\n2\\\\tCoding-Agent: kimi\\\\n3\\\\tSession: fresh (read-only architect ruling)\\\\n4\\\\tMode: read-only\\\\n5\\\\t\\\\n6\\\\t# Ruling needed: the PHPT stress cost — guest execution budget or re-tiering?\\\\n7\\\\t\\\\n8\\\\tFollow-up to the P4 heap work. The engineer's fixture-by-fixture walk (collab/1793540000000-engineer-p4-hang.gpt-6-luna.findings.md in worktree /Users/sto/workspace/datomworld-php-p4) found NO unbounded guest fixture. The recorded shiva \\\\\\\"hangs\\\\\\\" in yang.php.antlr.e2e-test (93 min at 100% CPU; thread dump collab/orch-lane/p4-e2e-hang-threaddump.txt in the main checkout, stack: run_loop <- vm_step <- test-utils/run-vm) and the PHPT selection (33+ min) are now best explained as finite stress cases that are simply expensive: Zend/tests/gc_013.phpt runs a fixed 10,001-iteration loop and takes ~259 s on one VM, and e2e-test carries phpt-derived stress cases; under two concurrent lanes on shiva the wall clock multiplies.\\\\n9\\\\t\\\\n10\\\\t## The question\\\\n11\\\\t\\\\n12\\\\tRule between the remedies:\\\\n13\\\\t\\\\n14\\\\t(a) A guest execution/step budget at the test-harness or engine-safepoint level (the engineer flagged this as architect territory — it may touch the safepoint contract in yang.php.md / yin.vm semantics). If you rule this way, define the smallest contract change: where the budget lives (run-vm test harness vs the engine's safepoint marks), what happens on exhaustion (interrupt? the existing Interrupt exception?), and whether production (non-test) semantics change at all.\\\\n15\\\\t\\\\n16\\\\t(b) Re-tiering: move phpt-derived stress cases (gc_013 and friends) behind the ^:slow tag (or DATOM_SLOW_TESTS) so the quick tier stays bounded, accepting the slow tier grows.\\\\n17\\\\t\\\\n18\\\\tOr both (a) for production robustness, (b) immediately for lane stability.\\\\n19\\\\t\\\\n20\\\\tAlso rule whether the 93-minute shiva e2e sighting is closed as \\\\\\\"finite stress cost, not a defect\\\\\\\" or must stay open until the remedy lands. Cite the safepoint docs you rely on. Read-only: do not edit.\\\"}\\ncollab/orch-lane/1793545000000-architect-p4-stress-budget-ruling.kimi-k3.1-pro.stdout.log:4:{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"I’ll check the fixture findings and the safepoint contract, then give a binding read-only ruling.\\\",\\\"tool_calls\\\":[{\\\"type\\\":\\\"function\\\",\\\"id\\\":\\\"tool_yAW25Dn5JFc186g7Yv0aM55A\\\",\\\"function\\\":{\\\"name\\\":\\\"Read\\\",\\\"arguments\\\":\\\"{\\\\\\\"path\\\\\\\":\\\\\\\"/Users/sto/workspace/datomworld-php-p4/collab/1793540000000-engineer-p4-hang.gpt-6-luna.findings.md\\\\\\\"}\\\"}},{\\\"type\\\":\\\"function\\\",\\\"id\\\":\\\"tool_oXzmb1KRtS55AONVFYrBQHYe\\\",\\\"function\\\":{\\\"name\\\":\\\"Grep\\\",\\\"arguments\\\":\\\"{\\\\\\\"pattern\\\\\\\":\\\\\\\"safepoint|step budget|Interrupt\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"/Users/sto/workspace/datomworld-php-p4\\\\\\\",\\\\\\\"glob\\\\\\\":\\\\\\\"*.md\\\\\\\",\\\\\\\"output_mode\\\\\\\":\\\\\\\"content\\\\\\\",\\\\\\\"-i\\\\\\\":true,\\\\\\\"head_limit\\\\\\\":200}\\\"}}]}\\ncollab/orch-lane/1793545000000-architect-p4-stress-budget-ruling.kimi-k3.1-pro.stdout.log:5:{\\\"role\\\":\\\"tool\\\",\\\"tool_call_id\\\":\\\"tool_yAW25Dn5JFc186g7Yv0aM55A\\\",\\\"content\\\":\\\"1\\\\t# P4 runaway guest investigation\\\\n2\\\\t\\\\n3\\\\t## Result\\\\n4\\\\t\\\\n5\\\\tNo unbounded guest loop was found in the e2e corpus available in this worktree. I did not add a guest step limit or alter corpus behavior: the remaining long case is a finite PHP-src stress fixture, and the PHP harness has no installed safepoint budget or host interrupt mechanism. A bound here would require a PHP safepoint integration or VM execution-budget semantics, so this is stopped for architect review per the task scope.\\\\n6\\\\t\\\\n7\\\\t## E2E fixture isolation\\\\n8\\\\t\\\\n9\\\\tRan each source through `e2e-harness/run-walker` in a daemon thread with a per-fixture timeout, covering base `programs/fixtures`, enabled P3b program fixtures (including the heap/reference cases), and enabled P4 program fixtures (including S8 generators). All completed with the 120-second ceiling; no fixture spun.\\\\n10\\\\t\\\\n11\\\\t- `sort-thousand` took roughly 90 seconds locally and exceeded the initial 30-second cutoff, then completed. Its source loop is bounded by `$i < 1000`.\\\\n12\\\\t- `gen-c8-pending-finally-departure` exceeded an initial 10-second all-VM cutoff, then completed in isolation: AST walker, semantic, stack, and register all returned `\\\\\\\"E\\\\\\\"`. This was a timeout that was too short, not a spin.\\\\n13\\\\t- The two selected PHPT sources containing literal `while (1)` also completed: `Zend/tests/bug44184.phpt` throws from the loop and is caught; `Zend/tests/bug66608.phpt` breaks from both loops.\\\\n14\\\\t\\\\n15\\\\tThe requested `collab/orch-lane/p4-e2e-hang-threaddump.txt` is absent in this worktree, so I could not compare the reported stack to this checkout's fixture IDs.\\\\n16\\\\t\\\\n17\\\\t## PHPT selection path\\\\n18\\\\t\\\\n19\\\\t`phpt_selection.edn` has 1,088 entries. The actual `phpt-selection-runs-test` did not finish under a 300-second wall-clock timeout. The largest selected finite loop I isolated was `Zend/tests/gc_013.phpt`: it runs `for ($i = 0; $i < 10001; $i++)`, took 258,911 ms through the walker, then reached an unsupported `gc_collect_cycles()` call. The similar `Zend/tests/gc_023.phpt` has two explicit finite bounds (9,999 and 10,001); the combined stress probe was still processing it when its 300-second wrapper expired. Other large loop cases found by source scan either have explicit numeric bounds or are marked `:needs :p4` and excluded from this selection.\\\\n20\\\\t\\\\n21\\\\tThese are finite stress cases, not loops that PHP itself would run forever. Reducing their iteration counts changes the GC threshold behavior under test. The harness currently runs guests directly via `run_vm` with no PHP step budget. The PHP design doc describes a future deterministic safepoint-count budget, but this worktree has no PHP safepoint hook/profile to install; shared `:line` support is also explicitly pending safepoint slice 3.\\\\n22\\\\t\\\\n23\\\\t## Architect decision needed\\\\n24\\\\t\\\\n25\\\\tPlease adjudicate the intended local quick-tier policy for the selected PHP-src GC stress cases and the mechanism for bounding guest execution. If the selected path needs an interruptible step budget, that requires the PHP safepoint contract/profile or engine execution semantics, outside this frontend fixture fix. No fixture was identified that can correctly be “bounded” at the source level without changing its meaning.\\\\n26\\\\t\\\\n27\\\\t## Verification\\\\n28\\\\t\\\\n29\\\\t- Fixture-by-fixture walker pass: completed; no timeout at the final 120-second ceiling.\\\\n30\\\\t- PHPT special `while (1)` candidates: both completed.\\\\n31\\\\t- `phpt-selection-runs-test`: did not complete within 300 seconds.\\\\n32\\\\t- No source/test files were changed; cljstyle/kondo were therefore not applicable.\\\"}\\ncollab/orch-lane/1793545000000-architect-p4-stress-budget-ruling.kimi-k3.1-pro.stdout.log:6:{\\\"role\\\":\\\"tool\\\",\\\"tool_call_id\\\":\\\"tool_oXzmb1KRtS55AONVFYrBQHYe\\\",\\\"content\\\":\\\"Tool output exceeded 50000 characters; the full output was saved to a file.\\\\ntool_name: Grep\\\\ntool_call_id: tool_oXzmb1KRtS55AONVFYrBQHYe\\\\noutput_size_chars: 55630\\\\noutput_size_bytes: 55818\\\\noutput_path: /Users/sto/.kimi-code/sessions/wd_datomworld-php-p4_b550d22cc7d2/session_4ebef743-ae5c-42d7-b768-c4f4f66a4a05/agents/main/tool-results/Grep-tool_oXzmb1KRtS55AONVFYrBQHYe-2ab9537a-22a1-44db-ad27-0382ab4c144d.txt\\\\nnext_step: Use Read with output_path to page through the saved output, or Grep to search it.\\\\n\\\\n[preview: chars [0, 4096)]\\\\ncollab/1793540000000-engineer-p4-hang.gpt-6-luna.findings.md:5:No unbounded guest loop was found in the e2e corpus available in this worktree. I did not add a guest step limit or alter corpus behavior: the remaining long case is a finite PHP-src stress fixture, and the PHP harness has no installed safepoint budget or host interrupt mechanism. A bound here would require a PHP safepoint integration or VM execution-budget semantics, so this is stopped for architect review per the task scope.\\\\ncollab/1793540000000-engineer-p4-hang.gpt-6-luna.findings.md:21:These are finite stress cases, not loops that PHP itself would run forever. Reducing their iteration counts changes the GC threshold behavior under test. The harness currently runs guests directly via `run_vm` with no PHP step budget. The PHP design doc describes a future deterministic safepoint-count budget, but this worktree has no PHP safepoint hook/profile to install; shared `:line` support is also explicitly pending safepoint slice 3.\\\\nco