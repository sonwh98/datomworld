n            lines.append(f\\\"- {c}\\\")\\n        if len(summary.commits) > 10:\\n            lines.append(f\\\"- ... and {len(summary.commits) - 10} more commits.\\\")\\n        lines.append(\\\"\\\")\\n\\n    lines.append(\\\"## Automated Scan Findings\\\")\\n    if not summary.findings:\\n        lines.append(\\\"✅ No critical security or code quality smells detected by automated scan.\\\")\\n    else:\\n        # Group by severity\\n        for sev in [\\\"P0\\\", \\\"P1\\\", \\\"P2\\\", \\\"P3\\\"]:\\n            sev_findings = [f for f in summary.findings if f.severity == sev]\\n            if sev_findings:\\n                sev_title = {\\\"P0\\\": \\\"P0 - Critical (Blocker)\\\", \\\"P1\\\": \\\"P1 - High (Must Address)\\\", \\\"P2\\\": \\\"P2 - Medium (Recommended)\\\", \\\"P3\\\": \\\"P3 - Low (Nit / Suggestion)\\\"}[sev]\\n                lines.append(f\\\"### {sev_title}\\\")\\n                for f in sev_findings:\\n                    loc = f\\\"`{f.file_path}`\\\" + (f\\\":L{f.line_number}\\\" if f.line_number else \\\"\\\")\\n                    lines.append(f\\\"- **[{f.category}]** {loc}: {f.message}\\\")\\n                    if f.snippet:\\n                        lines.append(f\\\"  ```\\\\n  {f.snippet}\\\\n  ```\\\")\\n    lines.append(\\\"\\\")\\n\\n    lines.append(\\\"## File Churn & Risk Breakdown\\\")\\n    lines.append(\\\"| File Path | Category | +Add | -Del | Risk |\\\")\\n    lines.append(\\\"| :--- | :--- | :--- | :--- | :--- |\\\")\\n    for f in sorted(summary.file_stats, key=lambda x: (x.risk_level != \\\"High\\\", x.risk_level != \\\"Medium\\\", -(x.additions + x.deletions))):\\n        lines.append(f\\\"| `{f.path}` | {f.category} | +{f.additions} | -{f.deletions} | `{f.risk_level}` |\\\")\\n    lines.append(\\\"\\\")\\n\\n    lines.append(\\\"## Reviewer Focus & Recommendations\\\")\\n    categories_present = set(f.category for f in summary.file_stats)\\n    if \\\"Security/Auth\\\" in categories_present:\\n        lines.append(\\\"- 🔒 **Security / Auth:** Double-check credential handling, session management, and authorization checks.\\\")\\n    if \\\"Database/Schema\\\" in categories_present:\\n        lines.append(\\\"- 🗄️ **Database:** Verify migration rollback compatibility, index performance, and transaction boundaries.\\\")\\n    if \\\"API/Contract\\\" in categories_present:\\n        lines.append(\\\"- 🔌 **API Contract:** Ensure backward compatibility for public endpoints and schema definitions.\\\")\\n    if summary.test_to_source_ratio < 0.3 and summary.source_additions > 30:\\n        lines.append(\\\"- 🧪 **Testing:** Test coverage appears low relative to source code additions. Request unit/integration test additions.\\\")\\n\\n    return \\\"\\\\n\\\".join(lines)\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=\\\"PR Reviewer & Git Diff Analyzer\\\")\\n    subparsers = parser.add_subparsers(dest=\\\"command\\\", help=\\\"Subcommand to run\\\")\\n\\n    analyze_parser = subparsers.add_parser(\\\"analyze\\\", help=\\\"Analyze git target and generate report\\\")\\n    analyze_parser.add_argument(\\\"--target\\\", default=\\\"main...HEAD\\\", help=\\\"Git ref/range to analyze (e.g. main...HEAD, HEAD~1, staged, working)\\\")\\n    analyze_parser.add_argument(\\\"--output\\\", help=\\\"Output file path (Markdown or JSON depending on format)\\\")\\n    analyze_parser.add_argument(\\\"--format\\\", choices=[\\\"markdown\\\", \\\"json\\\"], default=\\\"markdown\\\", help=\\\"Output format (markdown or json)\\\")\\n    analyze_parser.add_argument(\\\"--repo-dir\\\", help=\\\"Target git repository directory\\\")\\n\\n    args = parser.parse_args()\\n\\n    if not args.command or args.command == \\\"analyze\\\":\\n        target = getattr(args, \\\"target\\\", \\\"main...HEAD\\\")\\n        output = getattr(args, \\\"output\\\", None)\\n        fmt = getattr(args, \\\"format\\\", \\\"markdown\\\")\\n        repo_dir = getattr(args, \\\"repo-dir\\\", None)\\n\\n        try:\\n            summary = analyze_git_target(target, repo_dir=repo_dir)\\n\\n            if fmt == \\\"json\\\":\\n                result = json.dumps(asdict(summary), indent=2)\\n            else:\\n                result = generate_markdown_report(summary)\\n\\n            if output:\\n                out_path = Path(output)\\n                out_path.parent.mkdir(parents=True, exist_ok=True)\\n                out_path.write_text(result, encoding=\\\"utf-8\\\")\\n                print(f\\\"✅ Review report written to: {out_path.resolve()}\\\")\\n            else:\\n                print(result)\\n\\n        except Exception as e:\\n            sys.stderr.write(f\\\"Error during PR analysis: {e}\\\\n\\\")\\n            sys.exit(1)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n?? .flutter-plugins-dependencies\\n?? collab/1793546000000-engineer-node-shard-uncovered-skip.kimi-k3.1-pro.findings.md\\n?? collab/1793546000000-engineer-node-shard-uncovered-skip.kimi-k3.1-pro.stdout.log\\n?? collab/1793546000000-engineer-node-shard-uncovered-skip.prompt.md\\n?? collab/orch-lane/1794400000000-architect-eval-bridge-design.gpt-6.1-sol.stdout.log\\n?? collab/orch-lane/1794410000000-engineer-p8-manifest-repair.muse-spark-1.3.stdout.log\\n?? collab/orch-lane/1794430000000-engineer-p8-manifest-repair.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794450000000-engineer-p8-manifest-repair-r2.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794470000000-engineer-p8-manifest-repair-r3.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794520000000-engineer-p5-oracle-record.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794530000000-engineer-p8-pin-fix-laptop.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794550000000-engineer-p8-pin-fix-r2.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794560000000-engineer-p5-runner.muse-spark-1.3-contributor.stdout.log\\n?? collab/orch-lane/1794580000000