   \\\"Zend/tests/bug72441.phpt\\\"\\n   148\\t    \\\"Zend/tests/bug72943.phpt\\\"\\n   149\\t    \\\"Zend/tests/bug73663.phpt\\\"\\n   150\\t    \\\"Zend/tests/bug73663_2.phpt\\\"\\n   151\\t    \\\"Zend/tests/bug73954.phpt\\\"\\n   152\\t    \\\"Zend/tests/bug74810.phpt\\\"\\n   153\\t    \\\"Zend/tests/bug74836.phpt\\\"\\n   154\\t    \\\"Zend/tests/bug76383.phpt\\\"\\n   155\\t    \\\"Zend/tests/bug78598.phpt\\\"\\n   156\\t    \\\"Zend/tests/bug79783.phpt\\\"\\n   157\\t    \\\"Zend/tests/bug79784.phpt\\\"\\n   158\\t    \\\"Zend/tests/bug79792.phpt\\\"\\n   159\\t    \\\"Zend/tests/bug79828.phpt\\\"\\n   160\\t    \\\"Zend/tests/bug79836.phpt\\\"\\n   161\\t    \\\"Zend/tests/bug79948.phpt\\\"\\n   162\\t    \\\"Zend/tests/bug80096.phpt\\\"\\n   163\\t    \\\"Zend/tests/bug80184.phpt\\\"\\n   164\\t    \\\"Zend/tests/bug81076.phpt\\\"]}\\n   165\\t  {:feature :gc-cycle-collection,\\n   166\\t   :engine-work-item\\n   167\\t   \\\"Implement PHP cyclic garbage collection and roots/threshold behavior.\\\",\\n   168\\t   :entries\\n   169\\t   [\\\"Zend/tests/gc_004.phpt\\\"\\n   170\\t    \\\"Zend/tests/gc_007.phpt\\\"\\n   171\\t    \\\"Zend/tests/gc_018.phpt\\\"\\n   172\\t    \\\"Zend/tests/gc_019.phpt\\\"\\n   173\\t    \\\"Zend/tests/gc_020.phpt\\\"\\n   174\\t    \\\"Zend/tests/gc_021.phpt\\\"\\n   175\\t    \\\"Zend/tests/gc_022.phpt\\\"\\n   380\\t    (is (= out (h/latin1->text (:php/out r))) (name id))\\n   381\\t    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\\n   382\\t    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\\n   383\\t        (name id))))\\n   384\\t\\n   385\\t\\n   386\\t(deftest ^:slow stage0-enabled-fixtures-on-every-vm-test\\n   387\\t  (doseq [{:keys [id source level] :as fixture} p3b/enabled\\n   388\\t          :when (= :program level)\\n   389\\t          :let [out (rendered fixture)]]\\n   390\\t    (let [results (h/run-php source)]\\n   391\\t      (is (not (contains? results :diagnostics)) (pr-str results))\\n   392\\t      (doseq [k vms]\\n   393\\t        (is (= out (get results k)) (str (name id) \\\" on \\\" k))))))\\n   394\\t\\n   395\\t\\n   396\\t(deftest stage0-packets-match-source-test\\n   397\\t  (doseq [[id form] packets-p3b/forms\\n   398\\t          :let [{:keys [source]} (first (filter #(= id (:id %)) p3b/all-fixtures))]]\\n   399\\t    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\\n   400\\t\\n   401\\t\\n   402\\t;; -----------------------------------------------------------------------------\\n   403\\t;; S10: permutation corpus and php-src selection\\n   404\\t;; -----------------------------------------------------------------------------\\n   405\\t\\n   406\\t(defn- read-edn-file\\n   407\\t  [path]\\n   408\\t  (let [f (io/file path)]\\n   409\\t    (when (.exists f) (edn/read-string (slurp f)))))\\n   410\\t\\n   411\\t\\n   412\\t(defn- engine-result\\n   413\\t  \\\"`{:out :diag :uncaught}` of `source` on the walker, in the oracle's shape, or\\n   414\\t   `{:refused diagnostics}` / `{:threw message}`.\\\"\\n   415\\t  [source]\\n   416\\t  (try\\n   417\\t    (let [r (h/run-raw source)]\\n   418\\t      (if (:diagnostics r)\\n   419\\t        {:refused (mapv :message (:diagnostics r))}\\n   420\\t        {:out (h/latin1->text (:php/out r)),\\n   421\\t         :diag (mapv (juxt :errno :message) (:php/diag r)),\\n   422\\t         :uncaught (some-> (:php/uncaught r) (select-keys [:class :message]))}))\\n   423\\t    (catch Throwable t {:threw (str t)})))\\n   424\\t\\n   425\\t\\n   426\\t(defn- run-corpus\\n   427\\t  \\\"Run `programs` against the recorded oracle map: `{:total :compared :mismatches}`\\n   428\\t   where a host throw or a refusal is always a mismatch.\\\"\\n   429\\t  [programs oracle]\\n   430\\t  (reduce (fn [acc {:keys [id source]}]\\n   431\\t            (let [r (engine-result source)\\n   432\\t                  want (get oracle id)\\n   433\\t                  bad (or (contains? r :threw) (contains? r :refused)\\n   434\\t                          (and want (not= (update want :diag vec) (update r :diag vec))))]\\n   435\\t              (cond-> (update acc :total inc)\\n   436\\t                want (update :compared inc)\\n   437\\t                bad (update :mismatches conj [id r]))))\\n   438\\t          {:total 0, :compared 0, :mismatches []}\\n   439\\t          programs))\\n   440\\t\\n   441\\t\\n   442\\t(deftest permutation-corpus-quick-test\\n   443\\t  (let [oracle (read-edn-file \\\"test/yang/php/antlr/permutation_oracle_quick.edn\\\")\\n   444\\t        {:keys [total compared mismatches]} (run-corpus (perms/quick) oracle)]\\n   445\\t    (is (= (* 2 (count perms/quick-ids)) total))\\n   446\\t    (is (empty? mismatches) (pr-str (take 3 mismatches)))\\n   447\\t    (when-not oracle\\n   448\\t      (println \\\"permutation corpus: no recorded oracle yet, ran\\\" total \\\"programs without comparison\\\"))\\n   449\\t    (when oracle\\n   450\\t      (is (= total compared) \\\"every quick program has a recorded oracle result\\\"))))\\n   451\\t\\n   452\\t\\n   453\\t(deftest ^:slow permutation-corpus-full-test\\n   454\\t  (let [oracle (read-edn-file \\\"build/yang-php/permutation_oracle_full.edn\\\")\\n   455\\t        {:keys [total mismatches]} (run-corpus (perms/full) oracle)]\\n   456\\t    (is (= (* 2 (count perms/full-ids)) total))\\n   457\\t    (is (empty? mismatches) (pr-str (take 3 mismatches)))))\\n   458\\t\\n   459\\t\\n   460\\t(deftest phpt-parsing-and-matching-test\\n   461\\t  (let [text \\\"--TEST--\\\\nt\\\\n--FILE--\\\\n<?php echo 1;\\\\n--EXPECTF--\\\\nint(%d) %s\\\\n\\\"\\n   462\\t        sections (phpt/parse-phpt text)]\\n   463\\t    (is (= \\\"t\\\" (get sections \\\"TEST\\\")))\\n   464\\t    (is (= \\\"<?php echo 1;\\\" (get sections \\\"FILE\\\")))\\n   465\\t    (is (phpt/matches-expect? sections \\\"int(42) abc\\\\n\\\"))\\n   466\\t    (is (not (phpt/matches-expect? sections \\\"int(x) abc\\\")))\\n   467\\t    (is (phpt/matches-expect? (phpt/parse-phpt \\\"--FILE--\\\\nx\\\\n--EXPECT--\\\\nhi\\\\n\\\") \\\"hi\\\\n\\\")))\\n   468\\t  (testing \\\"classification\\\"\\n   469\\t    (is (= :select (:status (phpt/classify {\\\"FILE\\\" \\\"<?php function f(&$x){} f($a); echo count([]);\\\",\\n   470\\t                                            \\\"EXPECT\\\" \\\"x\\\"}))))\\n   471\\t    (is (= :p4 (:needs (phpt/classify {\\\"FILE\\\" \\\"<?php class A {} new A;\\\", \\\"EXPECT\\\" \\\"x\\\"}))))\\n   472\\t    (is (= :unsupported-surface\\n   473\\t           (:reason (phpt/classify {\\\"FILE\\\" \\\"<?php preg_match('/a/', 'a');\\\", \\\"EXPECT\\\" \\\"x\\\"}))))\\n   474\\t    (is (= :unknown-functions\\n   475\\t           (:reason (phpt/classify {\\\"FILE\\\" \\\"<?php mystery_fn(1);\\\", \\\"EXPECT\\\" \\\"x\\\"}))))\\n   476\\t    (is (= :no-expectation (:reason (phpt/classify {\\\"FILE\\\" \\\"<?php echo 1;\\\"})))))\\n   477\\t  (testing \\\"path predicates\\\"\\n   478\\t    (is (phpt/selected-path? \\\"Zend/tests/list/list_001.phpt\\\"))\\n   479\\t    (is (phpt/selected-path? \\\"ext/standard/tests/array/current_variation1.phpt\\\"))\\n   480\\t    (is (not (phpt/selected-path? \\\"ext/standard/tests/strings/sprintf_basic1.phpt\\\")))))\\n   481\\t\\n   482\\t\\n   483\\t(defn- run-phpt-selection\\n   484\\t  [label entries manifest]\\n   485\\t  (let [results (for [{:keys [id source expect expectf]} entries\\n   486\\t                      :let [r (engine-result source)]]\\n   487\\t                  (cond\\n   488\\t                    (:refused r) [:unsupported id]\\n   489\\t                    (:threw r) [:fail id r]\\n   490\\t                    (phpt/matches-expect?\\n   491\\t                      (cond-> {} expect (assoc \\\"EXPECT\\\" expect) expectf (assoc \\\"EXPECTF\\\" expectf))\\n   492\\t                      (str (:out r)\\n   493\\t                           (when (:uncaught r)\\n   494\\t                             (str \\\"Fatal error: Uncaught \\\" (:class (:uncaught r)) \\\": \\\"\\n   495\\t                                  (:message (:uncaught r))))))\\n   496\\t                    [:pass id]\\n   497\\t                    :else [:fail id r]))\\n   498\\t        by (group-by first results)]\\n   499\\t    (println label (count entries) \\\"entries;\\\"\\n   500\\t             \\\"pass\\\" (count (:pass by)) \\\"unsupported\\\" (count (:unsupported by))\\n   501\\t             \\\"fail\\\" (count (:fail by)))\\n   502\\t    (if manifest\\n   503\\t      (let [expected (set (mapcat :entries (:known-gaps manifest)))\\n   504\\t            actual (set (map second (:fail by)))\\n   505\\t            family-of (fn [feature]\\n   506\\t                        (case feature\\n   507\\t                          :gc-cycle-collection :gc\\n   508\\t                          (:foreach-semantics :pass-by-reference) :foreach-by-ref\\n   509\\t                          :unset-cv :unset-cv\\n   510\\t                          :named-parameter-binding :named-params\\n   511\\t                          :other))\\n   512\\t            families [:gc :foreach-by-ref :unset-cv :named-params :other]\\n   513\\t            id->family (into {}\\n   514\\t                             (mapcat (fn [{:keys [feature entries]}]\\n   515\\t                                       (map (fn [id] [id (family-of feature)]) entries)))\\n   516\\t                             (:known-gaps manifest))\\n   517\\t            family-counts (fn [ids]\\n   518\\t                            (merge (zipmap families (repeat 0))\\n   519\\t                                   (frequencies (map #(get id->family % :other) ids))))\\n   520\\t            recorded-counts (:counts manifest)\\n   521\\t            expected-counts\\n   522\\t            {:gc (get recorded-counts :gc-cycle-collection 0)\\n   523\\t             :foreach-by-ref (+ (get recorded-counts :foreach-semantics 0)\\n   524\\t                                (get recorded-counts :pass-by-reference 0))\\n   525\\t             :unset-cv (get recorded-counts :unset-cv 0)\\n   526\\t             :named-params (get recorded-counts :named-parameter-binding 0)\\n   527\\t             :other (reduce + 0 (vals (apply dissoc recorded-counts\\n   528\\t                                             [:total :unsupported :gc-cycle-collection\\n   529\\t                                              :foreach-semantics :pass-by-reference :unset-cv\\n   530\\t                                              :named-parameter-binding])))}\\n   531\\t            actual-counts (family-counts actual)\\n   532\\t            ids (sort actual)]\\n   533\\t        (is (= (:total (:counts manifest)) (count expected)) \\\"manifest total is recorded\\\")\\n   534\\t        (is (= expected (set (keys (:descriptions manifest))))\\n   535\\t            (str \\\"PHPT manifest description IDs changed: \\\" (pr-str (sort expected))))\\n   536\\t        (is (= expected-counts actual-counts)\\n   537\\t            (str \\\"PHPT mismatch family counts changed; IDs: \\\" (pr-str ids)))\\n   538\\t        (is (= expected actual)\\n   539\\t            (str \\\"PHPT mismatch IDs changed; IDs: \\\" (pr-str ids)))\\n   540\\t        (is (= (:unsupported (:counts manifest)) (count (:unsupported by)))\\n   541\\t            \\\"the recorded quick-tier refusal count is stable\\\"))\\n   542\\t      (is (empty? (:fail by))\\n   543\\t          (str \\\"PHPT mismatch IDs: \\\" (pr-str (sort (map second (:fail by)))))))))\\n   544\\t\\n   545\\t\\n   546\\t(deftest phpt-selection-runs-test\\n   547\\t  (if-let [sel (read-edn-file \\\"test/yang/php/antlr/phpt_selection.edn\\\")]\\n   548\\t    (let [entries (remove #(or (:needs %) (:slow %)) (:entries sel))\\n   549\\t          manifest (read-edn-file \\\"test/yang/php/antlr/phpt_quick_mismatch_manifest.edn\\\")]\\n   550\\t      (is (= (:php-src-tag manifest) (:tag sel))\\n   551\\t          \\\"quick mismatch manifest applies to its pinned php-src selection tag\\\")\\n   552\\t      (if manifest\\n   553\\t        (run-phpt-selection \\\"php-src quick selection:\\\" entries manifest)\\n   554\\t        (is false \\\"missing PHPT quick mismatch manifest\\\")))\\n   555\\t    (println \\\"php-src selection: phpt_selection.edn not generated yet (run yang.php.phpt on shiva)\\\")))\\n   556\\t\\n   557\\t\\n   558\\t(defn- run-phpt-stress-case\\n   559\\t  [id]\\n   560\\t  (if-let [sel (read-edn-file \\\"test/yang/php/antlr/phpt_selection.edn\\\")]\\n   561\\t    (if-let [entry (first (filter #(= id (:id %)) (:entries sel)))]\\n   562\\t      (let [manifest (read-edn-file \\\"test/yang/php/antlr/phpt_quick_mismatch_manifest.edn\\\")\\n   563\\t            gap (first (filter #(= id (:id %)) (:slow-known-gaps manifest)))]\\n   564\\t        (is (:slow entry) (str id \\\" must stay in the slow tier\\\"))\\n   565\\t        (if gap\\n   566\\t          (let [actual (engine-result (:source entry))]\\n   567\\t            (println \\\"php-src recorded engine gap\\\" id actual)\\n   568\\t            (is (= (:expect entry) (:oracle-expect gap))\\n   569\\t                (str id \\\" pinned oracle expectation changed\\\"))\\n   570\\t            (is (= (:engine-result gap) (select-keys actual [:out :diag :uncaught]))\\n   571\\t                (str id \\\" engine gap result changed\\\")))\\n   572\\t          (run-phpt-selection (str \\\"php-src slow stress \\\" id \\\":\\\") [entry] nil)))\\n   573\\t      (is false (str \\\"missing PHPT stress case \\\" id)))\\n   574\\t    (println \\\"php-src selection: phpt_selection.edn not generated yet (run yang.php.phpt on shiva)\\\")))\\n   575\\t\\n   576\\t\\n   577\\t(deftest ^:slow phpt-gc-013-stress-test\\n   578\\t  (run-phpt-stress-case \\\"Zend/tests/gc_013.phpt\\\"))\\n   579\\t\\n   580\\t\\n   581\\t(deftest ^:slow phpt-gc-023-stress-test\\n   582\\t  (run-phpt-stress-case \\\"Zend/tests/gc_023.phpt\\\"))\\n   583\\t\\n   584\\t\\