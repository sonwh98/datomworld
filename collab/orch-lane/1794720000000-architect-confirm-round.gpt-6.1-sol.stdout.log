       :php/null\n             (do (php/pop-frame hs)\n                 (php/abandon-to n))))))]\n    [php/call-terminal\n     ;; `f` receives a terminal escape: invoking it abandons to here and\n     ;; answers its argument as this call's value, skipping :finally thunks\n     (fn [f]\n       (let [saved (cell/get php.rt/ctx)\n             flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (f (fn [x]\n                       (do (php/abandon-to (php/frame-depth (get saved :handlers)))\n                           (php/restore! saved)\n                           (r x)))))\n              r))\n          (%capture))))]\n\n;; -----------------------------------------------------------------------------\n;; The array value (P2 step 1): direct prelude tests, on every host\n;; -----------------------------------------------------------------------------\n\n(defn- run-raw\n  \"The unit value of the prelude expression `form` run under `php/run-main`.\"\n  [form]\n  (let [program (u/mark-tails\n                  (u/then prelude/uast\n                          (u/app (u/v 'php/run-main) (u/lam [] (u/sexp->uast form)))))]\n    (vm/value (vm/eval (h/create-vm {:modules (h/host-registry)}) program))))\n\n\n(defn- run\n  [form]\n  (h/render (run-raw form)))\n\n\n(deftest resolver-rejects-function-cells-without-shared-entry-test\n  (is (= \"PHP Fatal error:  Uncaught Error: Call to undefined function bad()\"\n         (run '(do (cell/set! php.rt/functions\n                              (assoc (cell/get php.rt/functions)\n                                     \"bad\" {:php/type :function}))\n                   (php/resolve-fn \"bad\" \"bad\"))))))\n\n","exit_code":0,"status":"completed"}}
