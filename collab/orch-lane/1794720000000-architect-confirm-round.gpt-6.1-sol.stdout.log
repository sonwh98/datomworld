->\\\\n3\\\\t   program envelope -> the bundled program on each of the four VMs. Output\\\\n4\\\\t   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\\\n5\\\\t   here at the boundary.\\\\\\\"\\\\n6\\\\t  (:require\\\\n7\\\\t    [dao.host.text :as text]\\\\n8\\\\t    [dao.stream :as stream]\\\\n9\\\\t    [yang.php.antlr.cst :as cst]\\\\n10\\\\t    [yang.php.antlr.lower :as lower]\\\\n11\\\\t    [yang.php.antlr.portable-harness :as portable]\\\\n12\\\\t    [yang.php.antlr.safepoint :as hooks]\\\\n13\\\\t    [yang.safepoint :as safepoint]\\\\n14\\\\t    [yin.vm :as vm]\\\\n15\\\\t    [yin.vm.debruijn.register :as rvm]\\\\n16\\\\t    [yin.vm.debruijn.stack :as dvm]\\\\n17\\\\t    [yin.vm.encoder :as encoder]\\\\n18\\\\t    [yin.vm.semantic :as semantic]\\\\n19\\\\t    [yin.vm.semantic.derive :as derive]\\\\n20\\\\t    [yin.vm.semantic.linearize :as sr-linearize]\\\\n21\\\\t    [yin.vm.test-utils :as tu]))\\\\n22\\\\t\\\\n23\\\\t\\\\n24\\\\t(defn host-registry\\\\n25\\\\t  \\\\\\\"The registry the PHP compositions run over.\\\\\\\"\\\\n26\\\\t  []\\\\n27\\\\t  (portable/host-registry))\\\\n28\\\\t\\\\n29\\\\t\\\\n30\\\\t(def ^:private base-opts\\\\n31\\\\t  {:make-stream tu/make-stream,\\\\n32\\\\t   :capability-secret tu/secret,\\\\n33\\\\t   :primitives vm/primitives})\\\\n34\\\\t\\\\n35\\\\t\\\\n36\\\\t(def ^:private load-semantic\\\\n37\\\\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\\\n38\\\\t\\\\n39\\\\t\\\\n40\\\\t(defn lower-program\\\\n41\\\\t  \\\\\\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\\\n42\\\\t   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\\\\\\"\\\\n43\\\\t  [source]\\\\n44\\\\t  (let [cst-log (tu/new-memory-log)\\\\n45\\\\t        program (tu/new-memory-log)\\\\n46\\\\t        diagnostics (tu/new-memory-log)]\\\\n47\\\\t    (stream/append! cst-log (cst/parse-source source))\\\\n48\\\\t    (lower/step-stage (lower/open-stage cst-log program diagnostics\\\\n49\\\\t                                        {:medium lower/program-medium}))\\\\n50\\\\t    (let [{warnings true, problems false}\\\\n51\\\\t          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\\\n52\\\\t      (if (seq problems)\\\\n53\\\\t        {:diagnostics problems}\\\\n54\\\\t        (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\\\n55\\\\t          {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)})))))\\\\n56\\\\t\\\\n57\\\\t\\\\n58\\\\t(defn packet->form\\\\n59\\\\t  \\\\\\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\\\n60\\\\t   rule, `[\\\\\\\\\\\\\\\"TYPE\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\"]` for a token. The inverse of\\\\n61\\\\t   `portable-harness/packet`.\\\\\\\"\\\\n62\\\\t  [{:yang.cst/keys [root nodes]}]\\\\n63\\\\t  (letfn [(form\\\\n64\\\\t            [id]\\\\n65\\\\t            (let [{:keys [kind rule type text children]} (nth nodes id)]\\\\n66\\\\t              (if (= :token kind)\\\\n67\\\\t                [type text]\\\\n68\\\\t                (into [(keyword rule)] (map form) children))))]\\\\n69\\\\t    (form root)))\\\\n70\\\\t\\\\n71\\\\t\\\\n72\\\\t(defn latin1->text\\\\n73\\\\t  \\\\\\\"The UTF-8 text of the byte carrier `s`.\\\\\\\"\\\\n74\\\\t  [s]\\\\n75\\\\t  (text/utf8-decode (.getBytes ^String s \\\\\\\"ISO-8859-1\\\\\\\")))\\\\n76\\\\t\\\\n77\\\\t\\\\n78\\\\t(defn render\\\\n79\\\\t  \\\\\\\"The text a unit prints: its output, then, for an uncaught error, the\\\\n80\\\\t   fatal line (no path, plan section 3.9).\\\\\\\"\\\\n81\\\\t  [{:php/keys [out uncaught fatal]}]\\\\n82\\\\t  (str (latin1->text out)\\\\n83\\\\t       (when uncaught\\\\n84\\\\t         (str \\\\\\\"PHP Fatal error:  Uncaught \\\\\\\" (:class uncaught) \\\\\\\": \\\\\\\" (:message uncaught)))\\\\n85\\\\t       (when fatal\\\\n86\\\\t         (str \\\\\\\"PHP Fatal error:  \\\\\\\" fatal))))\\\\n87\\\\t\\\\n88\\\\t\\\\n89\\\\t(defn run-vms\\\\n90\\\\t  \\\\\\\"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\\\\n91\\\\t   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\\\\n92\\\\t   and starts one per-run counter; no option leaves the AST unchanged.\\\\\\\"\\\\n93\\\\t  ([registry ast] (run-vms registry ast {}))\\\\n94\\\\t  ([registry ast {:keys [execution-budget envelope]}]\\\\n95\\\\t   (let [ast (if (some? execution-budget)\\\\n96\\\\t               (let [projected (encoder/project envelope)\\\\n97\\\\t                     derived (:envelope (safepoint/derive-envelope\\\\n98\\\\t                                          projected hooks/profile :test/derived))\\\\n99\\\\t                     tree (nth (:yin/batch derived) (:yin/root derived))]\\\\n100\\\\t                 (hooks/program execution-budget\\\\n101\\\\t                                (vm/semantic-bytecode->ast tree)))\\\\n102\\\\t               ast)\\\\n103\\\\t         opts (assoc base-opts :modules registry)\\\\n104\\\\t         session (tu/make-observer-session (tu/create-vm {:modules registry}))\\\\n105\\\\t         datoms (vec (vm/ast->datoms ast))\\\\n106\\\\t         projected #(:vector (sr-linearize/project ast))\\\\n107\\\\t         attempt (fn [f]\\\\n108\\\\t                   (try (render (f))\\\\n109\\\\t                        (catch Exception e [:thrown (ex-message e)])))]\\\\n110\\\\t     (tu/queue-ast! session ast)\\\\n111\\\\t     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\\\\n112\\\\t      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\\\\n113\\\\t                                                           datoms)))),\\\\n114\\\\t      :stack (attempt #(vm/value (vm/run (dvm/create-vm\\\\n115\\\\t                                           (:image (derive/stack-image (projected)))\\\\n116\\\\t                                           (assoc opts :contract vm/stack-contract))))),\\\\n117\\\\t      :register (attempt #(vm/value (vm/run (rvm/create-vm\\\\n118\\\\t                                              (derive/register-image (projected))\\\\n119\\\\t                                              (assoc opts\\\\n120\\\\t                                                     :contract\\\\n121\\\\t                                                     vm/register-contract)))))})))\\\\n122\\\\t\\\\n123\\\\t\\\\n124\\\\t(defn run-php\\\\n125\\\\t  \\\\\\\"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\\\\n126\\\\t   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\\\\\\\"\\\\n127\\\\t  ([source] (run-php source {}))\\\\n128\\\\t  ([source options]\\\\n129\\\\t   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\\\\n130\\\\t     (if diagnostics\\\\n131\\\\t       {:diagnostics diagnostics}\\\\n132\\\\t       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\\\\n133\\\\t\\\\n134\\\\t\\\\n135\\\\t(defn run-walker\\\\n136\\\\t  \\\\\\\"The ast-walker's rendering of `source` alone (fast iteration).\\\\\\\"\\\\n137\\\\t  [source]\\\\n138\\\\t  (let [{:keys [ast diagnostics]} (lower-program source)]\\\\n139\\\\t    (if diagnostics\\\\n140\\\\t      {:diagnostics diagnostics}\\\\n141\\\\t      (let [registry (host-registry)\\\\n142\\\\t            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\\\\n143\\\\t        (tu/queue-ast! session ast)\\\\n144\\\\t        (try (render (vm/value (:consumer (tu/run-session session))))\\\\n145\\\\t             (catch Exception e [:thrown (ex-message e)]))))))\\\\n146\\\\t\\\\n147\\\\t\\\\n148\\\\t(defn run-raw\\\\n149\\\\t  \\\\\\\"The unit's value, `{:php/out :php/diag :php/uncaught}`, on the AST walker.\\\\\\\"\\\\n150\\\\t  [source]\\\\n151\\\\t  (let [{:keys [ast diagnostics]} (lower-program source)]\\\\n152\\\\t    (if diagnostics\\\\n153\\\\t      {:diagnostics diagnostics}\\\\n154\\\\t      (let [session (tu/make-observer-session\\\\n155\\\\t               