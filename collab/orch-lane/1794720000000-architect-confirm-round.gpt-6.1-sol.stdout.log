\\n?? collab/orch-lane/1794590000000-engineer-cellref-sweep.muse-spark-1.3-contributor.findings.md\\n1636e3e9\\n     1\\t(ns yang.typescript.antlr.prelude-test\\n     2\\t  \\\"T2 step S1: the core cell primitives and the F1 guardrail. A symbol is a\\n     3\\t   cell whose `:js/type` is `:symbol`, so `js/cell?` alone no longer means\\n     4\\t   Type(x) is Object: `js/object?` does. Programs run on every VM through\\n     5\\t   the parity harness.\\\"\\n     6\\t  (:require [clojure.test :refer [deftest is testing]]\\n     7\\t            [clojure.walk :as walk]\\n     8\\t            [dao.jing.cbor :as cbor]\\n     9\\t            [dao.test-slow :as slow]\\n    10\\t            [yang.typescript.antlr.prelude :as prelude]\\n    11\\t            [yang.typescript.antlr.prelude-parity-test :as parity]))\\n    12\\t\\n    13\\t\\n    14\\t(defn- result-vector?\\n    15\\t  \\\"A vector literal of program forms: its first element is a form, not a\\n    16\\t   binder or a parameter.\\\"\\n    17\\t  [x]\\n    18\\t  (and (vector? x)\\n    19\\t       (seq x)\\n    20\\t       (not (symbol? (first x)))\\n    21\\t       (some seq? x)))\\n    22\\t\\n    23\\t\\n    24\\t(defn- unqualify\\n    25\\t  \\\"`form` with the `clojure.core/` (`cljs.core/`, `cljd.core/`) a syntax-quote\\n    26\\t   adds taken off and every\\n    27\\t   result vector literal built element by element (a vector literal in a\\n    28\\t   program is data, not a vector of values).\\\"\\n    29\\t  [form]\\n    30\\t  (walk/postwalk\\n    31\\t    (fn [x]\\n    32\\t      (cond (and (symbol? x)\\n    33\\t                 (contains? #{\\\"clojure.core\\\" \\\"cljs.core\\\" \\\"cljd.core\\\"}\\n    34\\t                            (namespace x)))\\n    35\\t            (symbol (name x))\\n    36\\t            (result-vector? x) (reduce (fn [acc a] (list 'js/vconj acc a)) [] x)\\n    37\\t            :else x))\\n    38\\t    form))\\n    39\\t\\n    40\\t\\n    41\\t(defn- check\\n    42\\t  \\\"Run