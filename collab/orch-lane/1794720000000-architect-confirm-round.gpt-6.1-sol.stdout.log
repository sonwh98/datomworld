{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"rg -l 'test' .cpcache/*.cp; ls build/antlr/php/classes; sed -n '115,170p' test/yang/php/antlr/e2e_harness.clj; sed -n '1230,1320p' src/cljc/yang/php/antlr/prelude.cljc\"","aggregated_output":".cpcache/4183786633.cp\nyang\n                                                           datoms)))),\n      :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                           (:image (derive/stack-image (projected)))\n                                           (assoc opts :contract vm/stack-contract))))),\n      :register (attempt #(vm/value (vm/run (rvm/create-vm\n                                              (derive/register-image (projected))\n                                              (assoc opts\n                                                     :contract\n                                                     vm/register-contract)))))})))\n\n\n(defn run-php\n  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\n   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\"\n  ([source] (run-php source {}))\n  ([source options]\n   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\n\n\n(defn run-walker\n  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [registry (host-registry)\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n        (tu/queue-ast! session ast)\n        (try (render (vm/value (:consumer (tu/run-session session))))\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value on the AST walker, optionally after binding a request record.\"\n  ([source] (run-raw source nil))\n  ([source request]\n   (let [{:keys [ast diagnostics]} (lower-program source)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (let [session (tu/make-observer-session\n                       (tu/create-vm {:modules (host-registry)}))\n             ast (if request\n                   (walk/postwalk\n                     (fn [node]\n                       (if (and (map? node)\n                                (= :application (:type node))\n                                (= 'php/run-main (get-in node [:operator :name])))\n                         (let [body (first (:operands node))]\n                           (assoc node :operands\n                                  [(u/lam []\n                                          (u/then\n                                            (u/sexp->uast (list 'php/bind-request! request))\n                                            (u/app body)))]))\n                           (data/str-concat \"\\\"\" (get e :name) \"\\\"\"))))]\n           (do (php/echo (data/str-concat ind \"  [\" label \"]=>\\n\"))\n               (php/var-dump-at (php/slot-get props k) (data/str-concat ind \"  \") path)\n               (php/var-dump-obj-items v props ind (+ i 1) n path)))\n         :php/null))]\n    [php/path-has?\n     (fn [path id i]\n       (if (nil? id)\n         false\n         (if (< i (data/count path))\n           (if (= (get path i) id) true (php/path-has? path id (+ i 1)))\n           false)))]\n    [php/var-dump-items\n     (fn [v ind i n path]\n       (if (< i n)\n         (let [k (get (php/array-order v) i)]\n           (do (php/echo (data/str-concat ind \"  [\"\n                                          (if (php/int? k)\n                                            (integer/format k)\n                                            (data/str-concat \"\\\"\" k \"\\\"\"))\n                                          \"]=>\\n\"))\n               (php/var-dump-at (php/slot-get v k) (data/str-concat ind \"  \") path)\n               (php/var-dump-items v ind (+ i 1) n path)))\n         :php/null))]\n\n    ;; ---------------------------------------------------------------- arrays\n    ;; The plain array of section 10.1: {:php/type :array :index {key value}\n    ;; :order [key ...] :next-index n}. Keys are already coerced\n    ;; (`php/array-key`); `:next-index` is absent until the first integer key\n    ;; is written (Zend's ZEND_LONG_MIN sentinel). Every read and write of an\n    ;; array goes through these names (P3 adds the handle branches here).\n    [php/empty-array (fn [] {:php/type :array, :index {}, :order []})]\n    [php/array? (fn [v] (= (php/kind v) :array))]\n    [php/succ-key\n     ;; k + 1, saturating at PHP_INT_MAX\n     (fn [k] (if (= (integer/compare k php.rt/int-max) 0) k (integer/add k 1)))]\n    [php/bump-next\n     ;; :next-index after integer key k is written\n     (fn [arr k]\n       (let [next (get arr :next-index)]\n         (if (nil? next)\n           (assoc arr :next-index (php/succ-key k))\n           (if (>= (integer/compare k next) 0)\n             (assoc arr :next-index (php/succ-key k))\n             arr))))]\n    [php/int-key-str\n     ;; the int a canonical decimal integer string spells (-?(0|[1-9][0-9]*),\n     ;; in int64 range), else nil\n     (fn [s]\n       (let [cs (data/str->code-points s)\n             n (data/count cs)\n             i (if (> n 0) (if (= (get cs 0) 45) 1 0) 0)]\n         (if (> n i)\n           (if (<= (- n i) 19)\n             (if (= (php/skip-digits cs i n) n)\n               (if (= (get cs i) 48)\n                 (if (= n 1) 0 nil)\n                 (let [v (integer/parse s)] (if (php/in-range? v) v nil)))\n               nil)\n             nil)\n           nil)))]\n    [php/float-key\n     ;; a float key: the P1 cast, plus the deprecation unless it was exact\n     (fn [x]\n       (let [h (php/h x)\n             n (php/float->int h)]\n         (do (if (= (integer/to-float 