tore! saved)\n253-                  (handler r))))\n254-          (%capture))))]\n255-    [php/try-finally\n256-     ;; normal exit runs `fin` here; raise and escapes run it as they\n--\n472-    [php/exit\n473-     ;; PHP exit: echo a string operand, then escape to the unit root,\n474-     ;; skipping exception handlers and finally blocks; shutdown functions\n475-     ;; and destructors still run and the status is preserved\n476-     (fn [value]\n477-       (if (= (php/kind value) :string)\n478-         (do (php/echo value) (php/root-exit 0))\n479-         (php/root-exit (php/to-int value))))]\n480:    [php/root-exit\n481-     ;; the distinct root exit continuation: an exit during shutdown only\n482-     ;; records its status and aborts the shutdown sequence\n483-     (fn [status]\n484-       (do (cell/set! php.rt/exit-status status)\n485-           (let [esc (if (= (cell/get php.rt/in-shutdown) true)\n486-                       (cell/get php.rt/shutdown-escape)\n487-                       (cell/get php.rt/exit-escape))]\n488-             (if (= esc :php/null)\n489-               (php/raise (assoc (assoc {} :php/type :exit) :status status))\n490-               (esc (assoc (assoc {} :php/terminal :exit) :status status))))))]\n491:    [php/root-fatal\n492-     ;; the terminal root escape for the operational fatal: guest handlers,\n493-     ;; returns and finalizers cannot replace it\n494-     (fn [message]\n495-       (let [esc (cell/get php.rt/fatal-escape)]\n496-         (if (= esc :php/null)\n497-           (do (php/unwind-to 1)\n498-               (php/raise (assoc (assoc {} :php/operational true) :message message)))\n499-           (esc (assoc (assoc (assoc {} :php/terminal :fatal)\n500-                             :php/operational true)\n501-                       :message message)))))]\n502-    [php/bi-trigger-error\n503-     (fn [args]\n504-       (do (php/warn (if (> (data/count args) 1) (php/to-int (get args 1)) 1024)\n505-                     (php/to-string