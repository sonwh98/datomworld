sc (cell/get php.rt/fatal-escape)]\n496-         (if (= esc :php/null)\n497-           (do (php/unwind-to 1)\n498-               (php/raise (assoc (assoc {} :php/operational true) :message message)))\n499-           (esc (assoc (assoc (assoc {} :php/terminal :fatal)\n500-                             :php/operational true)\n501-                       :message message)))))]\n502-    [php/bi-trigger-error\n503-     (fn [args]\n504-       (do (php/warn (if (> (data/count args) 1) (php/to-int (get args 1)) 1024)\n505-                     (php/to-string (get args 0)))\n506-           true))]\n507-    [php/zeros\n508-     (fn [n acc] (if (> n 0) (php/zeros (- n 1) (data/str-concat acc \"0\")) acc))]\n509-    [php/strip-zeros\n510-     (fn [s]\n511-       (let [n (data/str-length s)]\n512-         (if (> n 1)\n513-           (if (= (data/substring s (- n 1)) \"0\")\n514-             (php/strip-zeros (data/substring s 0 (- n 1)))\n515-             s)\n516-           s)))]\n517-\n518-    ;; ---------------------------------------------------------------- integers\n519-    [php/in-range?\n520-     (fn [n]\n521-       (if (< (integer/compare n php.rt/int-max) 1)\n522-         (> (integer/compare n php.rt/int-min) -1)\n523-         false))]\n524-    [php/int-result\n525-     ;; an exact result: an int in range, else the nearest float\n526-     (fn [n] (if (php/in-range? n) n (php/f (integer/to-float n))))]\n","exit_code":0,"status":"completed"}}
