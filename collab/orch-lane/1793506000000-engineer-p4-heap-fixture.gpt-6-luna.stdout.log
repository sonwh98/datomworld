{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '70,150p' test/yang/php/antlr/generators_test.clj; sed -n '1248,1305p' test/yang/python/antlr/e2e_c2_test.clj; rg --files /Users/sto/workspace/datomworld | rg '1793502000000-architect-p4-heap-ruling.kimi-k3.1-pro.stdout.log\"'$'\"' | head -5\"","aggregated_output":"                         (assoc opts :contract vm/register-contract))))})\n\n\n(defn- deep-size\n  \"Count shared compound values once, including closure/continuation payloads.\"\n  [x]\n  (let [seen (IdentityHashMap.)]\n    (loop [work [x], size 0]\n      (if (empty? work)\n        size\n        (let [x (peek work)\n              work (pop work)\n              compound? (or (values/host-typed? x) (coll? x))]\n          (if (and compound? (.put seen x true))\n            (recur work size)\n            (recur (cond\n                     (values/host-typed? x) (conj work (values/payload x))\n                     (map? x) (into (into work (keys x)) (vals x))\n                     (coll? x) (into work x)\n                     :else work)\n                   (inc size))))))))\n\n\n(defn- live-after-collection\n  [k source]\n  (let [lowered (:ast (h/lower-program source))\n        ;; Keep the normal unit entry point, but block its body before it\n        ;; returns to php/run-main and shutdown. This fresh stream has no\n        ;; producer, so h stays live and suspended in the captured heap.\n        blocker {:type :stream/next\n                 :source {:type :stream/cursor\n                          :source {:type :stream/make :buffer 1}}}\n        ast (tails/remark-tails\n              (update-in lowered [:operator :body :operands 0 :body]\n                         u/then blocker))\n        blocked ((get final-vms k) ast (vm/ast->datoms ast))]\n    (when (is (vm/blocked? blocked) (str k \" blocked before shutdown\"))\n      (let [roots (into []\n                        (keep (fn [[id {:keys [value seal]}]]\n                                (when (and (= \"h\" (get-in value [:gen :name]))\n                                           (= :suspended (get-in value [:gen :state])))\n                                  {:type :cell-ref :id id :seal seal})))\n                        (:heap blocked))]\n        (when (is (= 1 (count roots)) (str k \" one suspended delegating generator\"))\n          (let [heap (:heap (engine/collect blocked roots))]\n            [(count heap)\n             (deep-size (mapv :value (vals heap)))]))))))\n\n\n(defn- changing-caller-source\n  [n]\n  (str \"<?php function g() { $i=0; while (true) { yield $i; $i++; } }\"\n       ;; Own the delegate across caller statements, whose temporary cleanup\n       ;; would otherwise release the bare g() result while h is suspended.\n       \" function h() { $d=g(); yield from $d; } $it=h(); $it->self=$it;\"\n       \" function byFunction($x) { $x->next(); }\"\n       \" function byGenerator($x) { yield $x->current(); $x->next(); }\"\n       \" $k=0; while ($k < \" n \") {\"\n       \" if ($k % 2 == 0) { byFunction($it); }\"\n       \" else { $j=byGenerator($it); $j->current(); $j->next(); } $k++; }\"))\n\n\n(deftest ^:slow reachable-heap-is-stable-under-delegation-test\n  (doseq [k vms]\n    (testing (str k)\n      (let [small (live-after-collection k (changing-caller-source 10))\n            large (live-after-collection k (changing-caller-source 1000))]\n        (when (and small large)\n          (is (= small large)))))))\n    [(count heap) (reduce + (map (fn [[_ {:keys [value]}]] (deep-size value)) heap))]))\n\n\n(defn- changing-caller-source\n  \"`n` items through a `yield from` level, resumed alternately by a\n   function and by a fresh generator dropped after one step.\"\n  [n]\n  (lines \"def g():\"\n         \"    i = 0\"\n         \"    while True:\"\n         \"        yield i\"\n         \"        i += 1\"\n         \"def h():\"\n         \"    yield from g()\"\n         \"it = h()\"\n         \"def by_function(x):\"\n         \"    return next(x)\"\n         \"def by_generator(x):\"\n         \"    yield next(x)\"\n         \"k = 0\"\n         (str \"while k < \" n \":\")\n         \"    if k % 2 == 0:\"\n         \"        by_function(it)\"\n         \"    else:\"\n         \"        next(by_generator(it))\"\n         \"    k += 1\"))\n\n\n(deftest ^:slow reachable-heap-is-stable-under-delegation-test\n  (testing \"after a forced collection, the live heap (cells and their content,\n            continuations followed) is the same after 10 and after 1000 items\n            resumed through yield from by changing callers: no retention\n            grows per item or per caller\"\n    (doseq [k [:ast-walker :semantic :stack :register]]\n      (testing (str k)\n        (is (= (live-after-collection k (changing-caller-source 10) \"h\")\n               (live-after-collection k (changing-caller-source 1000) \"h\")))))))\n\n\n;; =============================================================================\n;; S5 acceptance: user-defined iterators, snapshot rendering, dropped generators\n;; =============================================================================\n\n(deftest user-iterator-class-test\n  (testing \"a class with __iter__ and __next__ drives for, list, next and\n            unpacking; a shared iterator keeps its position across loops\"\n    (every-vm= (prints \"[3, 4, 5]\" \"done\" \"[1, 2, 3]\" \"1 2\")\n               (lines \"class Count:\"\n                      \"    def __init__(self, n):\"\n                      \"        self.i = 0\"\n                      \"        self.n = n\"\n                      \"    def __iter__(self):\"\n                      \"        return self\"\n                      \"    def __next__(self):\"\n                      \"        if self.i >= self.n:\"\n                      \"            raise StopIteration\"\n                      \"        self.i += 1\"\n                      \"        return self.i\"\n/Users/sto/workspace/datomworld/collab/orch-lane/1793502000000-architect-p4-heap-ruling.kimi-k3.1-pro.stdout.log\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat /Users/sto/workspace/datomworld/collab/orch-lane/1793502000000-architect-p4-heap-ruling.kimi-k3.1-pro.stdout.log; rg -n \\\"make-generator|:php/type :generator|:gen|php/collect|engine/collect|final-vms|run-raw|deep-size\\\" test/yang/php/antlr/generators_test.clj test/yang/php/antlr/e2e_harness.clj src/cljc/yang/php/antlr/prelude.cljc | head -100; sed -n '1,90p' test/yang/php/antlr/generators_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat /Users/sto/workspace/datomworld/collab/orch-lane/1793502000000-architect-p4-heap-ruling.kimi-k3.1-pro.stdout.log; rg -n \\\"make-generator|:php/type :generator|:gen|php/collect|engine/collect|final-vms|run-raw|deep-size\\\" test/yang/php/antlr/generators_test.clj test/yang/php/antlr/e2e_harness.clj src/cljc/yang/php/antlr/prelude.cljc | head -100; sed -n '1,90p' test/yang/php/antlr/generators_test.clj\"","aggregated_output":"{\"role\":\"meta\",\"type\":\"system.version\",\"version\":\"2.4.0\"}\n{\"role\":\"assistant\",\"tool_calls\":[{\"type\":\"function\",\"id\":\"tool_reOTgeR6ofJphvkwiQj2NCXq\",\"function\":{\"name\":\"Read\",\"arguments\":\"{\\\"path\\\":\\\"/tmp/orch/kimi-heap-ruling.md\\\"}\"}}]}\n{\"role\":\"tool\",\"tool_call_id\":\"tool_reOTgeR6ofJphvkwiQj2NCXq\",\"content\":\"1\\tCreated-Local: 2026-11-01 22:0x +0700\\n2\\tCoding-Agent: kimi\\n3\\tSession: fresh (new session id)\\n4\\tMode: read-only review/architect ruling\\n5\\t\\n6\\t# Question: is the reachable-heap growth a leak, or is the stability assertion wrong?\\n7\\t\\n8\\tRole: architect adjudication (yang.php P4 checkpoint B). Governing: docs/design/yang.php.md (P4 S8 generator runtime, ruling 7), test/yang/php/antlr/generators_test.clj lines ~110-147 in worktree /Users/sto/workspace/datomworld-php-p4 (branch yang-php-p4 @ 304ef51e).\\n9\\t\\n10\\t## The contradiction\\n11\\t\\n12\\tRuling 7 (your earlier five-step approach) asked for a blocked-VM heap scan proving the generator runtime does not retain unreachable memory under delegation. The implemented test `reachable-heap-is-stable-under-delegation-test` runs `changing-caller-source` (a delegating generator h yielding from g, driven by byFunction/byGenerator callers for N iterations, then blocks the VM, collects from the suspended generator root) at N=10 and N=1000, and asserts equal reachable sizes.\\n13\\t\\n14\\tMeasured on all four VMs: 151 reachable cells at N=10, 5,596 at N=1000. The equality fails on every VM.\\n15\\t\\n16\\t## The question\\n17\\t\\n18\\tThe PHP source itself retains state across iterations: `$i` increments, the while loop's frame is suspended and resumed N times, `byGenerator` creates a fresh delegating generator `$j` per odd iteration (each `$j` is a local released each loop pass, but each `$j` yielded `$x->current()` values that may have been retained by `$it->self`'s self-reference or by the delegation chain). So is the 151 -> 5,596 growth:\\n19\\t\\n20\\t(a) a real retention leak (per-iteration garbage that should have been collected by the temporary cleanup or the unset path — the guest runtime retains completed delegators or their yield buffers), or\\n21\\t(b) expected semantics (the suspended delegating generator's frame genuinely grows with N because the guest semantics keep the loop frame's live set, or because `yield from` accumulates), or\\n22\\t(c) a mis-designed measurement (the block point should come AFTER the caller loop finishes AND the delegator `$it` should be the only root — but the caller loop's own temporaries at block time legitimately hold the last `$j`, so the comparison at different N compares different live sets)?\\n23\\t\\n24\\tRule as the architect: which is it, what is the correct measurement/fixture (or the correct assertion), and what (if anything) is the engineer round to change. Cite the yin.vm release/cleanup semantics you rely on. Read-only: do not edit.\"}\n{\"role\":\"assistant\",\"content\":\"I’ll inspect the fixture and VM cleanup semantics, then give the ruling.\",\"tool_calls\":[{\"type\":\"function\",\"id\":\"tool_NDIHy8XoOEofY0uedKrQMYRa\",\"function\":{\"name\":\"Read\",\"arguments\":\"{\\\"path\\\":\\\"test/yang/php/antlr/generators_test.clj\\\",\\\"line_offset\\\":1,\\\"n_lines\\\":240}\"}},{\"type\":\"function\",\"id\":\"tool_FJEtGZkUxaGKp5G0m11jtFe9\",\"function\":{\"name\":\"Read\",\"arguments\":\"{\\\"path\\\":\\\"docs/design/yang.php.md\\\",\\\"line_offset\\\":1,\\\"n_lines\\\":260}\"}},{\"type\":\"function\",\"id\":\"tool_fjT9RzyoCCdxLkWyYXmahpFA\",\"function\":{\"name\":\"Grep\",\"arguments\":\"{\\\"pattern\\\":\\\"release|cleanup|reachable-heap|self-reference|yield from\\\",\\\"path\\\":\\\"src\\\",\\\"output_mode\\\":\\\"files_with_matches\\\",\\\"head_limit\\\":100}\"}},{\"type\":\"function\",\"id\":\"tool_Ea8ix43e4V4o7klpV2NKTdHV\",\"function\":{\"name\":\"Grep\",\"arguments\":\"{\\\"pattern\\\":\\\"release|cleanup|reachable-heap|yield from\\\",\\\"path\\\":\\\"docs/design\\\",\\\"output_mode\\\":\\\"content\\\",\\\"head_limit\\\":100}\"}}]}\n{\"role\":\"tool\",\"tool_call_id\":\"tool_FJEtGZkUxaGKp5G0m11jtFe9\",\"content\":\"1\\t# yang.php: the PHP frontend\\n2\\t\\n3\\tStatus: Designed 2026-10-17. Slices P1 and P2 (section 15) are implemented on\\n4\\tthe `yang.php.antlr` route (P2: arrays, key coercion, `foreach` by value, the\\n5\\tcore array builtins and sorting, oracle-verified against `php-8.3.35`, section\\n6\\t17.3). P3 landed in two parts: P3-a (the counted-cell substrate and the\\n7\\tprelude-level reference model, merged earlier) and P3-b (the program-level\\n8\\tlowering, see \\\"P3-b landing status\\\" below). P4 and P5 are complete; P6 is in\\n9\\tprogress through the linked inclusion profile, dynamic scope, namespaces,\\n10\\tconstants and autoload class map. P6's oracle recording and three-host DHT\\n11\\tverification remain part of its landing. The legacy `yang/php.cljc` frontend\\n12\\tis still the installed one. Design by Fable (Lead\\n13\\tSystem Architect seat); adversarial review by codex (gpt-6.1-sol) over a\\n14\\tnine-round design loop that ended READY with sign-off granted. Section 20\\n15\\t(\\\"Design provenance\\\") cites the loop.\\n16\\t\\n17\\t**P3-b landing status.** The program-level lowering of the P3 plan (steps S2 to\\n18\\tS12) lands on branch `yang-php-p3b`; the oracle is the pinned `php-8.3.35`\\n19\\t(`php:8.3-cli` on shiva, banner `php-8.3.35 shiva 2026-10-25`).\\n20\\t\\n21\\t- Lowered and oracle-pinned: references (`=&` in every location form,\\n22\\t  `[&$x]` array items), `global`, `static` binding to a persistent slot,\\n23\\t  by-reference parameters, variadics, named arguments and spread, dynamic\\n24\\t  calls, closures with `use` and `use (&)`, arrow functions, `foreach` by\\n25\\t  reference, the array-pointer builtins, destructuring (`[...]`, `list(...)`,\\n26\\t  keyed, nested, one level of `&`), `try`/`catch`/`finally`, `throw`, `match`,\\n27\\t  `Closure::bind` and `bindTo`, the temporary list, and the typed-reference\\n28\\t  machinery at prelude level (rows 41 to 45; syntax stays P4).\\n29\\t- Fixtures: 72 program-level fixtures are enabled and run on the AST walker,\\n30\\t  on the semantic, stack and register VMs, and parserless from checked-in CST\\n31\\t  packets on Node; 91 oracle results are pinned in `programs_p3b`\\n32\\t  (`recorded`), 13 further oracle-only sources record texts and the cyclic\\n33\\t  release evidence (R2 condition (a): `gc_collect_cycles()` collects the\\n34\\t  cycle, the engine only terminates, closed as a known gap in C1). The permutation\\n35\\t  corpus (13-letter alphabet, flat and nested) runs 518 programs in the quick\\n36\\t  tier and about 5,900 in the slow tier; the php-src `.phpt` selection tool is\\n37\\t  in place and its list is generated on shiva.\\n38\\t- Held: `:call-dynamic-dim` and `:foreach-key-and-destructure` (grammar corner\\n39\\t  C27); the user-class closure call `:closure-call-user-class` waits for P4.\\n40\\t- Not in this landing: the per-table iterator registry (C26, slice P3-c), the\\n41\\t  php-src selection, the full permutation corpus and the linked profile (P4\\n42\\t  seam).\\n43\\t\\n44\\t**Departures introduced by P3-b** are ratified as corners C24 to C29 (section\\n45\\t17.2) and recorded in `docs/agents/known-gaps.md`. `declare` is refused, so\\n46\\t`strict_types` for typed references has no program path; `ref-write!`'s\\n47\\t`strict` argument is the seam P4 wires when `declare` lowers.\\n48\\t\\n49\\tParent design: [`yang.antlr.md`](yang.antlr.md). This document makes concrete\\n50\\tits section 8.6 (Object-oriented and web: PHP, mixed text and ordered maps),\\n51\\tits section 8.11 for PHP arrays, and Phase 3. Companion:\\n52\\t[`yang.typescript.md`](yang.typescript.md), whose section 2 (prerequisites\\n53\\tbinding both frontends) and section 17 (the `yang.core` lifts) this document\\n54\\tdepends on and does not repeat. Once accepted, this document governs the\\n55\\tdetail; `yang.antlr.md` section 8.6 remains the paradigm summary.\\n56\\t\\n57\\tRequest records, bound surfaces and the refusal of ambient resolution follow\\n58\\tthe doctrine of ADR 0004 (\\\"external effects are interpreted stream deposits\\\"),\\n59\\twhich is Proposed and not yet committed; `yang.typescript.md` section 2.4\\n60\\tnames what its rejection would reopen.\\n61\\t\\n62\\t## 1. Scope\\n63\\t\\n64\\tA new ANTLR frontend replaces the current PHP compiler frontend (section 5).\\n65\\tIt compiles PHP 8.3 source, including\\n66\\tmixed HTML text, to the Universal AST, and runs one request as one task\\n67\\treading an explicit request record. The frontend id is `:yang/php` either\\n68\\tway — the one-frontend-per-language scheme (2026-10-18; the id was\\n69\\t`:yang.php/legacy` before the legacy suffix was retired) leaves no room\\n70\\tfor implementation-suffixed ids, so the ANTLR frontend lands as a new\\n71\\trevision of `:yang/php`, its implementation named by the manifest's\\n72\\trevision and profile keys; the final naming at acceptance is the owner's.\\n73\\t\\n74\\tThe design claims a specified fragment, not Zend fidelity: the transition\\n75\\ttable of section 4 and the behaviour of the slices of section 15, each pinned\\n76\\tby oracle fixtures against the pinned PHP CLI, with every Zend behaviour\\n77\\toutside it listed as a named corner (section 17). The `yang.antlr.md` Phase 3\\n78\\texit criteria are direct fixtures:\\n79\\t\\n80\\t1. mixed text and code produce output in statement order;\\n81\\t2. arrays keep insertion order and PHP's alias and copy semantics;\\n82\\t3. superglobals are built from an explicit request input;\\n83\\t4. type declarations are not silently ignored (including through references);\\n84\\t5. two requests share nothing.\\n85\\t\\n86\\tLike every frontend: no new AST tag, no engine change, no codec change.\\n87\\t\\n88\\t## 2. Prerequisites\\n89\\t\\n90\\tEverything in `yang.typescript.md` section 2 binds this frontend: defects D1\\n91\\tto D7, the shared rulings (own null sentinel, Jing numeric kinds, JVM-only\\n92\\tparsing with three-host execution, the linked-profile matrix of bundled on\\n93\\tfour evaluators and linked on three until L-b), and the ADR 0004 dependency.\\n94\\tPHP uses the lifted namespaces of `yang.typescript.md` section 17 (L1 to L4\\n95\\tland first) and adds nothing to them (section 16). Two PHP-specific\\n96\\tdependencies: statement-level ticks wait on safepoint slice 3 (section 12),\\n97\\tand optional absent includes wait on the known-gaps ledger item for\\n98\\tpublication-time-unavailable imports (section 11.3).\\n99\\t\\n100\\t## 3. The paradigm specification\\n101\\t\\n102\\t### 3.1 Reference runtime\\n103\\t\\n104\\tPHP 8.3 CLI at a pinned patch release (owner decision B8.1), with `php.ini`\\n105\\tpinning `precision=14`, `serialize_precision=-1`, `error_reporting=E_ALL` and\\n106\\t`display_errors=stderr`. The grammar's feature set (enums, `match`,\\n107\\t`readonly`, named arguments, attributes) is PHP 8.1 and later, so 8.3 is the\\n108\\tnatural pin. PHP 8.4 features (property hooks, asymmetric visibility) are not\\n109\\tparsed (corner C10).\\n110\\t\\n111\\t### 3.2 Arrays and keys\\n112\\t\\n113\\tA PHP array is a value: assignment and parameter passing copy it, and a write\\n114\\tnever affects another holder. Its representation is chosen by what it contains\\n115\\t(section 4.2): an array that transitively holds no reference, no\\n116\\tarray-instance handle and no object handle is a **plain** persistent ordered\\n117\\tmap stored directly in its holder, copied in O(1), with mutation as get, pure\\n118\\tupdate and `cell/set!`. Any other array is a counted **instance** cell whose\\n119\\tduplication follows the engine (section 4).\\n120\\t\\n121\\t- **Key coercion** at every write and read: an integer stays; a\\n122\\t  decimal-integer string in canonical form (`\\\"8\\\"` yes; `\\\"08\\\"`, `\\\"8.0\\\"`, `\\\" 8\\\"`\\n123\\t  no) becomes that integer; a float truncates toward zero (with the PHP 8.1\\n124\\t  deprecation emitted as a diagnostic record); `true` and `false` become 1 and\\n125\\t  0; `null` becomes `\\\"\\\"`; any other string stays a string.\\n126\\t- `next-index` is one more than the largest integer key ever used and never\\n127\\t  decreases on unset; negative keys follow PHP 8.3's rule (next is max + 1).\\n128\\t  `$a[] = v` appends at `next-index`. The one decrement is `array_pop`, which\\n129\\t  lowers it when the popped key was `next-index - 1`.\\n130\\t- Iteration follows the key order (`php/array-keys`; the prelude's array\\n131\\t  operations are the only code that reads `:index`, `:order` or `:next-index`).\\n132\\t  Unset splices the order. Nested arrays are nested\\n133\\t  values: `$a['x']['y'] = 1` is one path update.\\n134\\t- Large arrays cost one path copy per write; a packed-vector fast path is an\\n135\\t  attached optimizer's business, not the lowering's.\\n136\\t\\n137\\t#### 3.2.1 Reads, `isset`, `empty`, `unset` and builtins (P2)\\n138\\t\\n139\\t- **Reads.** A missing key warns (2) `Undefined array key \\\"x\\\"` or\\n140\\t  `Undefined array key 5` and answers null; an offset read on null, bool, int\\n141\\t  or float warns `Trying to access array offset on <type|true|false>`; a\\n142\\t  string container answers the one byte at the offset (negative counts from the\\n143\\t  end), out of range warns `Uninitialized string offset N` and answers `\\\"\\\"`.\\n144\\t  `$a[]` in read position is a compile error `Cannot use [] for reading`.\\n145\\t- **`isset`/`empty` on a string container** coerce the offset, then test the\\n146\\t  range: int itself; `true`, `false`, null as `1`, `0`, `0` silently; a float\\n147\\t  by the float-key seam (`php/float-key`, precision deprecation when\\n148\\t  fractional, no \\\"String offset cast\\\" warning, which belongs to reads); an\\n149\\t  integer-numeric string as that int; anything else is not an offset (`isset`\\n150\\t  false, `empty` true).\\n151\\t- **`unset` on a non-array**: a missing key or null at any level is a no-op;\\n152\\t  a string terminal is `Error \\\"Cannot unset string offsets\\\"`; int, float and\\n153\\t  `true` are `Error \\\"Cannot unset offset in a non-array variable\\\"`; `false`\\n154\\t  emits Deprecated (8192) `Automatic conversion of false to array is\\n155\\t  deprecated` and stays `false`.\\n156\\t- **Builtin protocol.** One table (`yang.php.antlr.builtins/supported`) feeds\\n157\\t  the prelude registration and the lowering's by-reference positions. For a\\n158\\t  call with `:by-ref` positions the lowering (1) binds each by-ref location's\\n159\\t  keys at that argument's place in left-to-right order; (2) evaluates every\\n160\\t  other argument left to right into temporaries (a non-location at a by-ref\\n161\\t  position warns 8 `Only variables should be passed by reference`); (3)\\n162\\t  immediately before the call, reads each by-ref location through its bound\\n163\\t  keys and builds the argument vector; (4) calls; (5) writes each out back\\n164\\t  through the same keys, in position order.\\n165\\t- **`foreach` by value** iterates a snapshot (`php/foreach-array`, then\\n166\\t  `php/array-keys` and `php/array-get`), so writes, `unset`, appends and\\n167\\t  `sort` of the source in the body never change the iteration (the by-value\\n168\\t  half of C15). A non-array warns and iterates nothing.\\n169\\t- **Sorting** is one stable merge sort in the prelude (no host sort), with\\n170\\t  flags `SORT_REGULAR`, `SORT_NUMERIC`, `SORT_STRING`; `r*` variants flip the\\n171\\t  sign without reversing equal elements. A **bool** comparator is retried\\n172\\t  swapped and emits Deprecated 8192 `usort(): Returning bool from comparison\\n173\\t  function is deprecated, return an integer less than, equal to, or greater\\n174\\t  than zero` once per call. Parity claim: `usort` with a bool comparator\\n175\\t  `return $a > $b;` over `[3, 1, 2]` matches the CLI's order and emits the\\n176\\t  deprecation exactly once per call. Stability is not parity for a comparator\\n177\\t  that disagrees with itself (corner G-sort-inconsistent-cmp, section 17.2).\\n178\\t\\n179\\t### 3.3 Scope\\n180\\t\\n181\\t- PHP has function scope only, with no block scope and no implicit closure\\n182\\t  capture, except arrow `fn`, which captures by value every enclosing variable\\n183\\t  it mentions, at creation.\\n184\\t- **Locals are cells** allocated at function entry with `:php/undef`; reading\\n185\\t  one emits `Warning: Undefined variable` and yields null. Every function body\\n186\\t  that declares locals or parameters releases them on exit (row 16).\\n187\\t- `global $x` binds the local to the `$GLOBALS` entry by reference (row 17),\\n188\\t  creating it as null if absent.\\n189\\t- `static $x = <expr>;` is a cell owned by the function object, allocated at\\n190\\t  function creation with an uninitialized sentinel. Its initializer is an\\n191\\t  arbitrary expression evaluated **when execution first reaches the\\n192\\t  declaration** (PHP 8.3) and filled once.\\n193\\t- **The dynamic-scope profile**: a function whose body contains\\n194\\t  `include`/`require`, `$$name`, `extract`, `compact`, `get_defined_vars`,\\n195\\t  `eval`, or one-argument `parse_str` keeps its locals in a heap symbol-table\\n196\\t  dict (the precedent is Python's module namespace, owner decision 1 of\\n197\\t  `yang.antlr.md` 8.5.1). Scope analysis decides per function, and the\\n198\\t  lowering targets `php/local-get`/`php/local-set` on the dict. All other\\n199\\t  functions use cells (owner decision B8.3). The symbol table holds reference\\n200\\t  markers like any location.\\n201\\t- **The global scope** is always the `$GLOBALS` dict: a heap dict,\\n202\\t  insertion-ordered, with the superglobals pre-seeded from the request record.\\n203\\t  `$GLOBALS` is read-only as of PHP 8.1 except through its elements (corner\\n204\\t  C13).\\n205\\t\\n206\\t### 3.4 Superglobals and the request context\\n207\\t\\n208\\t- A PHP run is one task consuming one **request record** from a\\n209\\t  composition-supplied stream: `{:php.request/method :uri :query :headers\\n210\\t  :cookies :body :server :env :files}`. `php/init!` builds `$_GET`, `$_POST`,\\n211\\t  `$_COOKIE`, `$_SERVER`, `$_ENV`, `$_FILES`, `$_REQUEST` (ordered per a\\n212\\t  pinned `request_order`) and, for CLI, `$argv` and `$argc`. `$_SESSION` is a\\n213\\t  bound surface (a session-store effect), absent by default. Nothing reads\\n214\\t  ambient process or HTTP state.\\n215\\t- **Output** (`echo`, `print`, inline HTML, `printf`) appends to an output\\n216\\t  cell with the output-buffering stack; `ob_start` and `ob_get_clean` are pure\\n217\\t  prelude over that stack. The top level flushes ordered `:php.response/body`\\n218\\t  records on the response stream. `header()`, `http_response_code` and\\n219\\t  `setcookie` produce `:php.response/header` records, refused after the first\\n220\\t  body flush with PHP's warning text.\\n221\\t- `exit` and `die` are an escape to the task root, followed by the shutdown\\n222\\t  sequence (row 22).\\n223\\t- Cross-request leakage is impossible by construction: one task per request\\n224\\t  and no store writes for guest state.\\n225\\t\\n226\\t### 3.5 Coercion, comparison and arithmetic\\n227\\t\\n228\\t- **Loose equality** is the PHP 8 comparison table, pinned as a fixture matrix\\n229\\t  over every pair of `null`, `true`, `false`, `0`, `1`, `-1`, `\\\"0\\\"`, `\\\"\\\"`,\\n230\\t  `\\\"1\\\"`, `\\\"01\\\"`, `\\\"1e1\\\"`, `\\\"10\\\"`, `\\\"abc\\\"`, `\\\" 1\\\"`, `\\\"1 \\\"`, `[]`, `[0]`, `0.0`,\\n231\\t  `NAN`, `INF`, an object, and a `Stringable`. For example `0 == \\\"\\\"`, `0 ==\\n232\\t  []` and `\\\"\\\" == []` are false in PHP 8, while `0 == \\\"0\\\"`, `\\\"\\\" == null`, `[]\\n233\\t  == false`, `\\\"1\\\" == \\\"01\\\"`, `\\\"10\\\" == \\\"1e1\\\"` and `100 == \\\"1e2\\\"` are true.\\n234\\t  Number versus numeric string compares numerically; number versus non-numeric\\n235\\t  string compares as strings, so `0 == \\\"a\\\"` is false. Arrays compare by key\\n236\\t  and value; objects by property, or by identity for `===`.\\n237\\t- `<=>` uses the same ordering; `===` requires identical type and value,\\n238\\t  arrays element-wise, objects the same handle.\\n239\\t- **Numeric strings** (`is_numeric`) allow leading and trailing whitespace\\n240\\t  (8.0) and exponent forms. Leading-numeric strings in arithmetic warn (`\\\"5\\n241\\t  apples\\\" + 1` warns and gives 6); non-numeric ones throw `TypeError`. String\\n242\\t  increment is supported (`\\\"a\\\"++` is `\\\"b\\\"`, `\\\"Az\\\"++` is `\\\"Ba\\\"`).\\n243\\t- **Integer overflow converts to float**: every integer operator goes through\\n244\\t  the exact integer module and demotes to float64 when the exact result leaves\\n245\\t  `[-2^63, 2^63-1]` (`PHP_INT_MAX + 1` is a float). This is the one place C3's\\n246\\t  promotion-before-overflow is used to detect rather than to promote.\\n247\\t- `/` yields an int only when exact, else a float. `%` is int-only:\\n248\\t  `PHP_INT_MIN % -1` is `0`, and `% 0` throws `DivisionByZeroError`.\\n249\\t  `intdiv(PHP_INT_MIN, -1)` throws `ArithmeticError`, and `intdiv(x, 0)`\\n250\\t  throws `DivisionByZeroError`. `fmod` never throws. `**` is an int when exact\\n251\\t  and in range, else a float, via the pinned `fpow`.\\n252\\t- **Float to string**: `echo` uses `precision=14` (`%.14G`, so `echo 0.1+0.2`\\n253\\t  prints `0.3`); `var_dump`, `var_export` and `json_encode` use\\n254\\t  `serialize_precision=-1` (the shortest round trip, `integer/float-digits`).\\n255\\t  Fourteen-significant-digit rounding needs exact decimal rounding of a\\n256\\t  binary64: a prelude function over `integer`'s exact decomposition, with no\\n257\\t  new kernel (an `integer` version bump only if measured too slow).\\n258\\t\\n259\\t### 3.6 Null\\n260\\t\"}\n{\"role\":\"tool\",\"tool_call_id\":\"tool_NDIHy8XoOEofY0uedKrQMYRa\",\"content\":\"1\\t(ns yang.php.antlr.generators-test\\n2\\t  \\\"P4 S8 generators, live iteration and protocol integration on the JVM.\\\"\\n3\\t  (:require\\n4\\t    [clojure.test :refer [deftest is testing]]\\n5\\t    [yang.core.uast :as u]\\n6\\t    [yang.php.antlr.e2e-harness :as h]\\n7\\t    [yang.php.antlr.programs-p4 :as p4]\\n8\\t    [yang.tails :as tails]\\n9\\t    [yin.vm :as vm]\\n10\\t    [yin.vm.debruijn.register :as rvm]\\n11\\t    [yin.vm.debruijn.stack :as dvm]\\n12\\t    [yin.vm.engine :as engine]\\n13\\t    [yin.vm.semantic :as semantic]\\n14\\t    [yin.vm.semantic.derive :as derive]\\n15\\t    [yin.vm.semantic.linearize :as sr-linearize]\\n16\\t    [yin.vm.test-utils :as tu]\\n17\\t    [yin.vm.values :as values])\\n18\\t  (:import\\n19\\t    [java.util IdentityHashMap]))\\n20\\t\\n21\\t\\n22\\t(def ^:private vms [:ast-walker :semantic :stack :register])\\n23\\t\\n24\\t\\n25\\t(deftest generator-fixtures-on-every-vm-test\\n26\\t  (doseq [{:keys [id source out]} p4/generators-v1]\\n27\\t    (testing (name id)\\n28\\t      (let [results (h/run-php source)]\\n29\\t        (is (not (contains? results :diagnostics)) (pr-str results))\\n30\\t        (doseq [k vms]\\n31\\t          (is (= out (get results k)) (str (name id) \\\" on \\\" k)))))))\\n32\\t\\n33\\t\\n34\\t(deftest iteration-protocols-test\\n35\\t  (testing \\\"Iterator drives foreach directly\\\"\\n36\\t    (is (= \\\"01\\\" (:php/out (h/run-raw\\n37\\t                            \\\"<?php class I implements Iterator { private $i=0; function rewind(): void {$this->i=0;} function valid(): bool {return $this->i<2;} function current(): mixed {return $this->i;} function key(): mixed {return $this->i;} function next(): void {$this->i++;} } foreach(new I as $v) echo $v;\\\")))))\\n38\\t  (testing \\\"IteratorAggregate supplies the live iterator\\\"\\n39\\t    (is (= \\\"23\\\" (:php/out (h/run-raw\\n40\\t                            \\\"<?php class I implements Iterator {private $i=2;function rewind():void{}function valid():bool{return $this->i<4;}function current(){return $this->i;}function key(){return $this->i;}function next():void{$this->i++;}} class A implements IteratorAggregate {function getIterator():Iterator{return new I;}} foreach(new A as $v)echo $v;\\\")))))\\n41\\t  (testing \\\"property iteration filters visibility from the calling scope\\\"\\n42\\t    (is (= \\\"aabc\\\" (:php/out (h/run-raw\\n43\\t                              \\\"<?php class P {public $a='a'; protected $b='b'; private $c='c'; function f(){foreach($this as $v)echo $v;}} $p=new P;foreach($p as $v)echo $v;$p->f();\\\")))))\\n44\\t  (testing \\\"ArrayAccess reads by value; Countable and Stringable dispatch\\\"\\n45\\t    (is (= \\\"43s\\\" (:php/out (h/run-raw\\n46\\t                             \\\"<?php class A implements ArrayAccess, Countable, Stringable {function offsetExists($x):bool{return true;} function offsetGet($x){return 4;} function offsetSet($x,$v):void{} function offsetUnset($x):void{} function count():int{return 3;} function __toString():string{return 's';}} $a=new A;echo $a[0],count($a),(string)$a;\\\"))))))\\n47\\t\\n48\\t\\n49\\t(def ^:private opts\\n50\\t  {:make-stream tu/make-stream\\n51\\t   :capability-secret tu/secret\\n52\\t   :primitives vm/primitives\\n53\\t   :modules (h/host-registry)})\\n54\\t\\n55\\t\\n56\\t(def ^:private load-semantic\\n57\\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\n58\\t\\n59\\t\\n60\\t(def ^:private final-vms\\n61\\t  {:ast-walker (fn [ast _] (vm/eval (tu/create-vm opts) ast))\\n62\\t   :semantic (fn [_ datoms] (vm/run (load-semantic (semantic/create-vm opts) datoms)))\\n63\\t   :stack (fn [ast _]\\n64\\t            (vm/run (dvm/create-vm\\n65\\t                      (:image (derive/stack-image (:vector (sr-linearize/project ast))))\\n66\\t                      (assoc opts :contract vm/stack-contract))))\\n67\\t   :register (fn [ast _]\\n68\\t               (vm/run (rvm/create-vm\\n69\\t                         (derive/register-image (:vector (sr-linearize/project ast)))\\n70\\t                         (assoc opts :contract vm/register-contract))))})\\n71\\t\\n72\\t\\n73\\t(defn- deep-size\\n74\\t  \\\"Count shared compound values once, including closure/continuation payloads.\\\"\\n75\\t  [x]\\n76\\t  (let [seen (IdentityHashMap.)]\\n77\\t    (loop [work [x], size 0]\\n78\\t      (if (empty? work)\\n79\\t        size\\n80\\t        (let [x (peek work)\\n81\\t              work (pop work)\\n82\\t              compound? (or (values/host-typed? x) (coll? x))]\\n83\\t          (if (and compound? (.put seen x true))\\n84\\t            (recur work size)\\n85\\t            (recur (cond\\n86\\t                     (values/host-typed? x) (conj work (values/payload x))\\n87\\t                     (map? x) (into (into work (keys x)) (vals x))\\n88\\t                     (coll? x) (into work x)\\n89\\t                     :else work)\\n90\\t                   (inc size))))))))\\n91\\t\\n92\\t\\n93\\t(defn- live-after-collection\\n94\\t  [k source]\\n95\\t  (let [lowered (:ast (h/lower-program source))\\n96\\t        ;; Keep the normal unit entry point, but block its body before it\\n97\\t        ;; returns to php/run-main and shutdown. This fresh stream has no\\n98\\t        ;; producer, so h stays live and suspended in the captured heap.\\n99\\t        blocker {:type :stream/next\\n100\\t                 :source {:type :stream/cursor\\n101\\t                          :source {:type :stream/make :buffer 1}}}\\n102\\t        ast (tails/remark-tails\\n103\\t              (update-in lowered [:operator :body :operands 0 :body]\\n104\\t                         u/then blocker))\\n105\\t        blocked ((get final-vms k) ast (vm/ast->datoms ast))]\\n106\\t    (when (is (vm/blocked? blocked) (str k \\\" blocked before shutdown\\\"))\\n107\\t      (let [roots (into []\\n108\\t                        (keep (fn [[id {:keys [value seal]}]]\\n109\\t                                (when (and (= \\\"h\\\" (get-in value [:gen :name]))\\n110\\t                                           (= :suspended (get-in value [:gen :state])))\\n111\\t                                  {:type :cell-ref :id id :seal seal})))\\n112\\t                        (:heap blocked))]\\n113\\t        (when (is (= 1 (count roots)) (str k \\\" one suspended delegating generator\\\"))\\n114\\t          (let [heap (:heap (engine/collect blocked roots))]\\n115\\t            [(count heap)\\n116\\t             (deep-size (mapv :value (vals heap)))]))))))\\n117\\t\\n118\\t\\n119\\t(defn- changing-caller-source\\n120\\t  [n]\\n121\\t  (str \\\"<?php function g() { $i=0; while (true) { yield $i; $i++; } }\\\"\\n122\\t       ;; Own the delegate across caller statements, whose temporary cleanup\\n123\\t       ;; would otherwise release the bare g() result while h is suspended.\\n124\\t       \\\" function h() { $d=g(); yield from $d; } $it=h(); $it->self=$it;\\\"\\n125\\t       \\\" function byFunction($x) { $x->next(); }\\\"\\n126\\t       \\\" function byGenerator($x) { yield $x->current(); $x->next(); }\\\"\\n127\\t       \\\" $k=0; while ($k < \\\" n \\\") {\\\"\\n128\\t       \\\" if ($k % 2 == 0) { byFunction($it); }\\\"\\n129\\t       \\\" else { $j=byGenerator($it); $j->current(); $j->next(); } $k++; }\\\"))\\n130\\t\\n131\\t\\n132\\t(deftest ^:slow reachable-heap-is-stable-under-delegation-test\\