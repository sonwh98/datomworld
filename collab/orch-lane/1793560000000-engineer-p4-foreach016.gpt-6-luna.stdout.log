{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' test/yang/php/antlr/e2e_harness.clj && sed -n '1920,1942p' docs/design/yang.php.md && rg -n \\\"foreach|array-unshift|foreach.*iter|bi-array-unshift\\\" src/cljc/yang/php/antlr/lower.cljc src/cljc/yang/php/antlr/prelude.cljc\"","aggregated_output":"(ns yang.php.antlr.e2e-harness\n  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n   program envelope -> the bundled program on each of the four VMs. Output\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n   here at the boundary.\"\n  (:require\n    [dao.host.text :as text]\n    [dao.stream :as stream]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn host-registry\n  \"The registry the PHP compositions run over.\"\n  []\n  (portable/host-registry))\n\n\n(def ^:private base-opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\"\n  [source]\n  (let [cst-log (tu/new-memory-log)\n        program (tu/new-memory-log)\n        diagnostics (tu/new-memory-log)]\n    (stream/append! cst-log (cst/parse-source source))\n    (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                        {:medium lower/program-medium}))\n    (let [{warnings true, problems false}\n          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n      (if (seq problems)\n        {:diagnostics problems}\n        (let [{:yin/keys [batch root]} (first (tu/drain program))]\n          {:ast (nth batch root), :warnings (vec warnings)})))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`.\"\n  [registry ast]\n  (let [opts (assoc base-opts :modules registry)\n        session (tu/make-observer-session (tu/create-vm {:modules registry}))\n        datoms (vec (vm/ast->datoms ast))\n        projected #(:vector (sr-linearize/project ast))\n        attempt (fn [f]\n                  (try (render (f))\n                       (catch Exception e [:thrown (ex-message e)])))]\n    (tu/queue-ast! session ast)\n    {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n     :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n                                                          datoms)))),\n     :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                          (:image (derive/stack-image (projected)))\n                                          (assoc opts :contract vm/stack-contract))))),\n     :register (attempt #(vm/value (vm/run (rvm/create-vm\n                                             (derive/register-image (projected))\n                                             (assoc opts\n                                                    :contract\n                                                    vm/register-contract)))))}))\n\n\n(defn run-php\n  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`.\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics {:diagnostics diagnostics} (run-vms (host-registry) ast))))\n\n\n(defn run-walker\n  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [registry (host-registry)\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n        (tu/queue-ast! session ast)\n        (try (render (vm/value (:consumer (tu/run-session session))))\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, on the AST walker.\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [session (tu/make-observer-session\n                      (tu/create-vm {:modules (host-registry)}))]\n        (tu/queue-ast! session ast)\n        (vm/value (:consumer (tu/run-session session)))))))\n\n## 12. Safepoints\n\n- `:loop` and `:call` hooks (`phpsp`) serve signals: `pcntl_signal` handlers\n  run at hooks via `stream/poll!` on a signal stream, and\n  `pcntl_async_signals` is the default and only mode. A recursion-depth bound\n  is available if a composition wants one (PHP has none; default off).\n- `max_execution_time` and `set_time_limit` are wall-clock in PHP and so\n  nondeterministic: the profile offers a deterministic **safepoint-count\n  budget** instead, raising the fatal with PHP's text, a recorded departure\n  (owner decision B8.5, corner C21).\n- **Statement ticks** (`declare(ticks=N)`, `register_tick_function`) need\n  `:line` sites before non-lambda statement nodes. `yang.safepoint` currently\n  refuses a selected site that is not a `:lambda` (`site-not-lambda`), and\n  `:line` insertion is safepoint slice 3, which Python tracing also needs.\n  Ticks therefore **depend on the shared `:line` extension**: P7 splits into\n  P7-a (signals, no dependency) and P7-b (ticks, behind safepoint slice 3).\n  Neither L1 to L4 nor this frontend extends `yang.safepoint`; the extension\n  is the safepoint seat's.\n- No thread switches: PHP is single-threaded, and one request is one task.\n\n## 13. Diagnostics\n\nsrc/cljc/yang/php/antlr/lower.cljc:2405:;; foreach (by value)\nsrc/cljc/yang/php/antlr/lower.cljc:2408:(defn- foreach-target\nsrc/cljc/yang/php/antlr/lower.cljc:2409:  \"The location a `foreach` writes: an `assignable` or `chain` node that is a\nsrc/cljc/yang/php/antlr/lower.cljc:2417:(defn- foreach-store\nsrc/cljc/yang/php/antlr/lower.cljc:2424:(defn- lower-foreach-ref\nsrc/cljc/yang/php/antlr/lower.cljc:2425:  \"`foreach ($a as &$v)` / `as $k => &$v`: each iteration re-reads the array\nsrc/cljc/yang/php/antlr/lower.cljc:2435:        src-loc (chain-loc ctx n src-chain :foreach-source)\nsrc/cljc/yang/php/antlr/lower.cljc:2438:        k-loc (when arrow? (foreach-target ctx n assignable))\nsrc/cljc/yang/php/antlr/lower.cljc:2439:        v-loc (foreach-target ctx n v-node)\nsrc/cljc/yang/php/antlr/lower.cljc:2456:                                                (foreach-store ctx n k-loc (u/v key))\nsrc/cljc/yang/php/antlr/lower.cljc:2465:            (app* 'php/foreach-array (peek-loc ctx sl))\nsrc/cljc/yang/php/antlr/lower.cljc:2480:(defn- lower-foreach-value\nsrc/cljc/yang/php/antlr/lower.cljc:2481:  \"`foreach (e as $v)` / `as $k => $v`: the operand is evaluated once.\nsrc/cljc/yang/php/antlr/lower.cljc:2497:                        [(foreach-target ctx n t1) (foreach-target ctx n t2)]\nsrc/cljc/yang/php/antlr/lower.cljc:2498:                        :else [nil (foreach-target ctx n t1)])\nsrc/cljc/yang/php/antlr/lower.cljc:2506:                                  (app* 'php/addref (app* 'php/foreach-current (u/v it)))\nsrc/cljc/yang/php/antlr/lower.cljc:2508:                          (foreach-store ctx n v-loc (app* 'php/foreach-current (u/v it))))]\nsrc/cljc/yang/php/antlr/lower.cljc:2509:                 k-loc (conj (foreach-store ctx n k-loc (u/v key))))\nsrc/cljc/yang/php/antlr/lower.cljc:2511:                          (app* 'php/foreach-key (u/v it))\nsrc/cljc/yang/php/antlr/lower.cljc:2515:                                                 (app* 'php/foreach-next (u/v it))))))]\nsrc/cljc/yang/php/antlr/lower.cljc:2517:            (app* 'php/foreach-prepare node (cc-node ctx))\nsrc/cljc/yang/php/antlr/lower.cljc:2524:                                        (u/if-node (app* 'php/foreach-valid (u/v it))\nsrc/cljc/yang/php/antlr/lower.cljc:2530:(defn- lower-foreach\nsrc/cljc/yang/php/antlr/lower.cljc:2534:      (lower-foreach-ref ctx n kids)\nsrc/cljc/yang/php/antlr/lower.cljc:2535:      (lower-foreach-value ctx n))))\nsrc/cljc/yang/php/antlr/lower.cljc:3529:    \"foreachStatement\" (lower-foreach ctx n)\nsrc/cljc/yang/php/antlr/prelude.cljc:2287:     ;; by-reference foreach: is there an element at ordinal `i` of the array now?\nsrc/cljc/yang/php/antlr/prelude.cljc:4265:    ;; ---------------------------------------------------------------- foreach\nsrc/cljc/yang/php/antlr/prelude.cljc:4266:    [php/foreach-array\nsrc/cljc/yang/php/antlr/prelude.cljc:4267:     ;; the owned temporary of a by-value foreach; a non-array warns and is empty\nsrc/cljc/yang/php/antlr/prelude.cljc:4272:                           \"foreach() argument must be of type array|object, \"\nsrc/cljc/yang/php/antlr/prelude.cljc:4473:    ;; ---------------------------------------------------------------- foreach driver\nsrc/cljc/yang/php/antlr/prelude.cljc:4492:    [php/foreach-iterator\nsrc/cljc/yang/php/antlr/prelude.cljc:4497:    [php/foreach-prepare\nsrc/cljc/yang/php/antlr/prelude.cljc:4503:             (let [it (php/foreach-iterator v)]\nsrc/cljc/yang/php/antlr/prelude.cljc:4512:           (cell/new (assoc (assoc (assoc {} :kind :array) :value (php/foreach-array v))\nsrc/cljc/yang/php/antlr/prelude.cljc:4514:    [php/foreach-valid\nsrc/cljc/yang/php/antlr/prelude.cljc:4520:    [php/foreach-key\nsrc/cljc/yang/php/antlr/prelude.cljc:4526:    [php/foreach-current\nsrc/cljc/yang/php/antlr/prelude.cljc:4532:    [php/foreach-next\nsrc/cljc/yang/php/antlr/prelude.cljc:4721:    [php/bi-array-unshift\n","exit_code":0,"status":"completed"}}
