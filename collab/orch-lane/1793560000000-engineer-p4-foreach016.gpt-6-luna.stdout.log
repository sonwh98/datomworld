{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2260,2310p' src/cljc/yang/php/antlr/prelude.cljc && sed -n '2400,2540p' src/cljc/yang/php/antlr/lower.cljc && sed -n '4460,4545p' src/cljc/yang/php/antlr/prelude.cljc && sed -n '4710,4755p' src/cljc/yang/php/antlr/prelude.cljc && rg -n \\\"foreach_016|selection-runs\\\" test/yang/php/antlr/e2e_test.clj\"","aggregated_output":"    [php/bi-key\n     (fn [args]\n       (do (php/arity-between \"key\" args 1 1 \"exactly 1\")\n           (let [arr (php/arg-array (get args 0) \"key\" 1 \"array\")\n                 p (php/ptr-of arr)]\n             (if (php/ptr-valid? arr p) (get (php/array-order arr) p) :php/null))))]\n    [php/bi-next\n     (fn [args]\n       (do (php/arity-between \"next\" args 1 1 \"exactly 1\")\n           (let [arr (php/arg-array (get args 0) \"next\" 1 \"array\")]\n             (php/ptr-move arr (+ (php/ptr-of arr) 1)))))]\n    [php/bi-prev\n     (fn [args]\n       (do (php/arity-between \"prev\" args 1 1 \"exactly 1\")\n           (let [arr (php/arg-array (get args 0) \"prev\" 1 \"array\")]\n             (php/ptr-move arr (- (php/ptr-of arr) 1)))))]\n    [php/bi-reset\n     (fn [args]\n       (do (php/arity-between \"reset\" args 1 1 \"exactly 1\")\n           (let [arr (php/arg-array (get args 0) \"reset\" 1 \"array\")]\n             (php/ptr-move arr 0))))]\n    [php/bi-end\n     (fn [args]\n       (do (php/arity-between \"end\" args 1 1 \"exactly 1\")\n           (let [arr (php/arg-array (get args 0) \"end\" 1 \"array\")]\n             (php/ptr-move arr (if (> (php/array-count arr) 0) (- (php/array-count arr) 1) 0)))))]\n    [php/fe-has-next\n     ;; by-reference foreach: is there an element at ordinal `i` of the array now?\n     (fn [tbl i] (if (php/array? tbl) (< i (php/array-count tbl)) false))]\n    [php/fe-key (fn [tbl i] (get (php/array-order tbl) i))]\n    [php/fe-next\n     ;; the ordinal after `key` in the array as the body left it; an element\n     ;; the body unset leaves the ordinal where its successor now sits\n     (fn [tbl key i]\n       (if (php/array? tbl)\n         (let [order (php/array-order tbl)\n               j (php/name-index order key 0 (data/count order))]\n           (if (nil? j) i (+ j 1)))\n         i))]\n    [php/list-get\n     ;; one destructuring read: a missing key warns, a non-array answers null\n     (fn [src k]\n       (if (= (php/kind src) :array)\n         (let [key (php/array-key k)\n               v (php/array-get src key)]\n           (if (nil? v)\n             (do (php/warn 2 (php/undef-key-msg key)) :php/null)\n             v))\n         :php/null))]\n    ;; ---------------------------------------------------------------- typed references (rows 41 to 47)\n    ;; Prelude level only (P3 plan R1): a type is data, `{:t :int}` and so on,\n                                 (loop-lambda w (u/if-node c iteration (u/lit :php/null)))\n                                 step)))))\n\n\n;; -----------------------------------------------------------------------------\n;; foreach (by value)\n;; -----------------------------------------------------------------------------\n\n(defn- foreach-target\n  \"The location a `foreach` writes: an `assignable` or `chain` node that is a\n   variable and its offsets, else a refusal.\"\n  [ctx n t]\n  (let [c (if (p/rule? t \"assignable\") (first (core/kids ctx t)) t)]\n    (when-not (p/rule? c \"chain\") (unsupported! n :list))\n    (chain-loc ctx n c :list)))\n\n\n(defn- foreach-store\n  \"Store `node` into the target `loc`; its keys are bound once per iteration,\n   before the holder is fetched, as for any location write.\"\n  [ctx n loc node]\n  (with-keys ctx loc (fn [loc'] (write-loc ctx n loc' node))))\n\n\n(defn- lower-foreach-ref\n  \"`foreach ($a as &$v)` / `as $k => &$v`: each iteration re-reads the array\n   at its location, binds `$v` to the marker of the current slot (the array is\n   separated and upgraded by the fetch) and resumes after the current key, so\n   appends are visited and an unset element is skipped. The iterator is the\n   ordinal `i`; nothing is registered, so `break` and exceptions leave nothing\n   to free.\"\n  [ctx n kids]\n  (let [chains (filter #(p/rule? % \"chain\") kids)\n        arrow? (boolean (some #(p/token? % \"=>\") kids))\n        src-chain (first chains)\n        src-loc (chain-loc ctx n src-chain :foreach-source)\n        assignable (first (filter #(p/rule? % \"assignable\") kids))\n        v-node (if arrow? (last chains) assignable)\n        k-loc (when arrow? (foreach-target ctx n assignable))\n        v-loc (foreach-target ctx n v-node)\n        _ (when (seq (:path v-loc)) (unsupported! n :reference))\n        fr (loop-frame n false)\n        [tbl w i key m] (map #(core/gen % n) [\"tbl\" \"w\" \"i\" \"key\" \"m\"])\n        body (wrap-escape fr :cont (lower (push-frame ctx fr) (body-of ctx n)))]\n    (with-keys\n      ctx\n      (lower-path ctx src-loc)\n      (fn [sl]\n        (let [elem (update sl :path conj (u/v key))\n              iteration\n              (u/let1 key\n                      (app* 'php/fe-key (u/v tbl) (u/v i))\n                      (u/let1 m\n                              (ref-source-loc ctx n elem)\n                              (u/then (bind-var ctx (:var v-loc) (u/v m))\n                                      (u/then (if k-loc\n                                                (foreach-store ctx n k-loc (u/v key))\n                                                (u/lit :php/null))\n                                              (u/then body\n                                                      (u/app (u/v w) (u/v w)\n                                                             (app* 'php/fe-next\n                                                                   (peek-loc ctx sl)\n                                                                   (u/v key)\n                                                                   (u/v i))))))))]\n          (u/then\n            (app* 'php/foreach-array (peek-loc ctx sl))\n            (wrap-escape\n              fr\n              :brk\n              (u/let1 w\n                      (core/site :loop\n                                 (u/lam [w i]\n                                        (u/let1 tbl\n                                                (peek-loc ctx sl)\n                                                (u/if-node (app* 'php/fe-has-next (u/v tbl) (u/v i))\n                                                           iteration\n                                                           (u/lit :php/null)))))\n                      (u/app (u/v w) (u/v w) (u/lit 0))))))))))\n\n\n(defn- lower-foreach-value\n  \"`foreach (e as $v)` / `as $k => $v`: the operand is evaluated once.\n   Arrays retain their snapshot keys; objects use the live Iterator protocol,\n   so leaving the loop does not exhaust or close the iterator.\"\n  [ctx n]\n  (let [kids (core/kids ctx n)\n        pattern (cond\n                  (some #(p/rule? % \"arrayDestructuring\") kids)\n                  (pattern-of ctx n (first (filter #(p/rule? % \"arrayDestructuring\") kids)))\n                  (some #(p/token? % \"List\") kids)\n                  (pattern-of ctx n (first (filter #(p/rule? % \"assignmentList\") kids))))\n        src (first (filter #(or (p/rule? % \"expression\") (p/rule? % \"chain\")) kids))\n        [t1 t2] (concat (filter #(p/rule? % \"assignable\") kids)\n                        (filter #(p/rule? % \"chain\") (rest (drop-while #(not (p/token? % \"=>\")) kids))))\n        [k-loc v-loc] (cond\n                        pattern [nil nil]\n                        (some #(p/token? % \"=>\") kids)\n                        [(foreach-target ctx n t1) (foreach-target ctx n t2)]\n                        :else [nil (foreach-target ctx n t1)])\n        fr (loop-frame n false)\n        [it w key] (map #(core/gen % n) [\"it\" \"w\" \"key\"])\n        body (wrap-escape fr :cont (lower (push-frame ctx fr) (body-of ctx n)))\n        node (if (p/rule? src \"chain\") (lower-chain ctx src) (lower ctx src))\n        dsym (core/gen \"fd\" n)\n        stores (cond-> [(if pattern\n                          (u/let1 dsym\n                                  (app* 'php/addref (app* 'php/foreach-current (u/v it)))\n                                  (u/seq-nodes (destructure-nodes ctx n pattern dsym nil)))\n                          (foreach-store ctx n v-loc (app* 'php/foreach-current (u/v it))))]\n                 k-loc (conj (foreach-store ctx n k-loc (u/v key))))\n        iteration (u/let1 key\n                          (app* 'php/foreach-key (u/v it))\n                          (u/then (u/seq-nodes stores)\n                                  (u/then body\n                                          (u/app (u/v w) (u/v w)\n                                                 (app* 'php/foreach-next (u/v it))))))]\n    (u/let1 it\n            (app* 'php/foreach-prepare node (cc-node ctx))\n            (wrap-escape\n              fr\n              :brk\n              (u/let1 w\n                      (core/site :loop\n                                 (u/lam [w]\n                                        (u/if-node (app* 'php/foreach-valid (u/v it))\n                                                   iteration\n                                                   (u/lit :php/null))))\n                      (u/app (u/v w) (u/v w)))))))\n\n\n(defn- lower-foreach\n  [ctx n]\n  (let [kids (core/kids ctx n)]\n    (if (some #(p/token? % \"&\") kids)\n      (lower-foreach-ref ctx n kids)\n      (lower-foreach-value ctx n))))\n\n\n;; -----------------------------------------------------------------------------\n;; if and switch\n;; -----------------------------------------------------------------------------\n       (if (= (php/kind v) :array)\n         (php/yield-array-from g v 0)\n         (if (if (= (php/kind v) :obj) (not (nil? (get (php/obj-state v) :gen))) false)\n           (php/yield-generator-from g v (php/gen-outcome :send :php/null))\n           (if (php/instance-of v \"iterator\")\n             (php/yield-iterator-from g v)\n             (if (php/instance-of v \"iteratoraggregate\")\n               (php/yield-iterator-from g (php/method-call v \"getIterator\" [] :php/null))\n               (php/throw-error\n                 \"Error\"\n                 (data/str-concat \"Can only traverse an array or Traversable, \"\n                                  (php/type-name (php/kind v)) \" given\")))))))]\n\n    ;; ---------------------------------------------------------------- foreach driver\n    [php/visible-props\n     (fn [o ctx]\n       (let [st (php/obj-state o)\n             props (get st :props)\n             decls (get (php/class-lookup (get st :class)) :props-decl)]\n         (php/visible-props-loop props decls ctx 0 (php/empty-array))))]\n    [php/visible-props-loop\n     (fn [props decls ctx i acc]\n       (if (< i (php/array-count props))\n         (let [id (get (php/array-order props) i)\n               e (php/vfind decls :id id 0)\n               visible (if (nil? e) true (php/visible? (get e :vis) (get e :declaring) ctx))]\n           (php/visible-props-loop\n             props decls ctx (+ i 1)\n             (if visible\n               (php/array-put acc (if (nil? e) id (get e :name)) (php/array-get props id))\n               acc)))\n         acc))]\n    [php/foreach-iterator\n     (fn [v]\n       (if (php/instance-of v \"iteratoraggregate\")\n         (php/method-call v \"getIterator\" [] :php/null)\n         v))]\n    [php/foreach-prepare\n     (fn [v ctx]\n       (if (= (php/kind v) :array)\n         (cell/new (assoc (assoc (assoc {} :kind :array) :value v) :keys (php/array-order v) :i 0))\n         (if (= (php/kind v) :obj)\n           (if (php/instance-of v \"traversable\")\n             (let [it (php/foreach-iterator v)]\n               (do (if (nil? (get (php/obj-state it) :gen))\n                     (php/method-call it \"rewind\" [] :php/null)\n                     (if (= (get (php/gen-state it) :state) :created)\n                       (php/gen-start! it)\n                       (php/gen-next it)))\n                   (cell/new (assoc (assoc {} :kind :iterator) :value it))))\n             (cell/new (assoc (assoc (assoc {} :kind :array) :value (php/visible-props v ctx))\n                              :keys (php/array-order (php/visible-props v ctx)) :i 0)))\n           (cell/new (assoc (assoc (assoc {} :kind :array) :value (php/foreach-array v))\n                            :keys [] :i 0)))))]\n    [php/foreach-valid\n     (fn [it]\n       (let [s (cell/get it)]\n         (if (= (get s :kind) :array)\n           (< (get s :i) (data/count (get s :keys)))\n           (php/to-bool (php/method-call (get s :value) \"valid\" [] :php/null)))))]\n    [php/foreach-key\n     (fn [it]\n       (let [s (cell/get it)]\n         (if (= (get s :kind) :array)\n           (get (get s :keys) (get s :i))\n           (php/method-call (get s :value) \"key\" [] :php/null))))]\n    [php/foreach-current\n     (fn [it]\n       (let [s (cell/get it)]\n         (if (= (get s :kind) :array)\n           (php/array-get (get s :value) (get (get s :keys) (get s :i)))\n           (php/method-call (get s :value) \"current\" [] :php/null))))]\n    [php/foreach-next\n     (fn [it]\n       (let [s (cell/get it)]\n         (if (= (get s :kind) :array)\n           (cell/set! it (assoc s :i (+ (get s :i) 1)))\n           (php/method-call (get s :value) \"next\" [] :php/null))))]\n\n    ;; ---------------------------------------------------------------- array builtins\n    ;; A by-reference builtin answers [ret outs]: `outs` holds the new value of\n    ;; each by-reference position in ascending order; the call site writes them back.\n    [php/arg-array\n     (fn [v name i pname]\n       (if (php/array? v)\n         v\n                               rest)\n                             rest)))))))]\n    [php/bi-array-shift\n     (fn [args]\n       (do (php/arity-between \"array_shift\" args 1 1 \"exactly 1\")\n           (let [arr (php/arg-array (get args 0) \"array_shift\" 1 \"array\")\n                 n (php/array-count arr)]\n             (if (= n 0)\n               (php/out1 :php/null arr)\n               (php/out1 (php/array-get arr (get (php/array-order arr) 0))\n                         (php/spread-loop (php/empty-array) arr 1 n))))))]\n    [php/bi-array-unshift\n     (fn [args]\n       (do (php/arity-between \"array_unshift\" args 1 1000000 \"at least 1\")\n           (let [arr (php/arg-array (get args 0) \"array_unshift\" 1 \"array\")\n                 head (php/push-loop (php/empty-array) args 1 (data/count args))\n                 res (php/spread-loop head arr 0 (php/array-count arr))]\n             (php/out1 (php/array-count res) res))))]\n\n    ;; ---------------------------------------------------------------- sorting\n    ;; One stable top-down merge sort over vectors of [key value] pairs; the\n    ;; merge is tail-recursive. `cmp` answers a negative, zero or positive int.\n    [php/pairs\n     (fn [arr i n acc]\n       (if (< i n)\n         (let [k (get (php/array-order arr) i)]\n           (php/pairs arr (+ i 1) n (php/vconj acc (php/triple k (php/array-get arr k) (php/slot-get arr k)))))\n         acc))]\n    [php/take-rest\n     (fn [acc xs i n]\n       (if (< i n) (php/take-rest (php/vconj acc (get xs i)) xs (+ i 1) n) acc))]\n    [php/merge\n     (fn [l r i j nl nr cmp acc]\n       (if (>= i nl)\n         (php/take-rest acc r j nr)\n         (if (>= j nr)\n           (php/take-rest acc l i nl)\n           (if (<= (cmp (get l i) (get r j)) 0)\n             (php/merge l r (+ i 1) j nl nr cmp (php/vconj acc (get l i)))\n             (php/merge l r i (+ j 1) nl nr cmp (php/vconj acc (get r j)))))))]\n    [php/msort\n     (fn [xs cmp]\n       (let [n (data/count xs)]\n         (if (< n 2)\n           xs\n           (let [mid (get (integer/quot-rem n 2) 0)\n362:(deftest phpt-selection-runs-test\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' test/yang/php/antlr/e2e_test.clj && sed -n '5870,5883p' test/yang/php/antlr/phpt_selection.edn && cat deps.edn | head -90 && ls\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,65p' test/yang/php/antlr/e2e_test.clj && sed -n '5870,5883p' test/yang/php/antlr/phpt_selection.edn && cat deps.edn | head -90 && ls\"","aggregated_output":"(ns yang.php.antlr.e2e-test\n  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n   envelope -> the bundled program on each of the four VMs (the AST walker,\n   the semantic, stack and register VMs). Every fixture of\n   `yang.php.antlr.programs` prints the same text on all four.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.packets-p3b :as packets-p3b]\n    [yang.php.antlr.permutations :as perms]\n    [yang.php.antlr.phpt :as phpt]\n    [yang.php.antlr.programs :as programs]\n    [yang.php.antlr.programs-p3b :as p3b]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(defn- rendered\n  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n  [{:keys [out uncaught]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(deftest ^:slow fixtures-on-every-vm-test\n  (doseq [{:keys [id source] :as fixture} programs/fixtures\n          :let [out (rendered fixture)]]\n    (testing (name id)\n      (let [results (h/run-php source)]\n        (is (not (contains? results :diagnostics)) (pr-str results))\n        (doseq [k vms]\n          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n\n\n(deftest fixtures-on-the-walker-test\n  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n          :let [r (h/run-raw source)]]\n    (is (not= :pending oracle) (name id))\n    (is (= out (h/latin1->text (:php/out r))) (name id))\n    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n        (name id))))\n\n\n(deftest packets-match-source-test\n  (doseq [[id form] packets/forms\n          :let [{:keys [source]} (first (filter #(= id (:id %)) programs/fixtures))]]\n    (is (= form (h/packet->form (cst/parse-source source))) (name id))))\n\n\n(defn- matrix-rows\n  [out]\n  (let [[eq sp] (str/split-lines out)\n        w (count programs/matrix-values)]\n    {:eq (mapv #(apply str %) (partition w eq)),\n     :sp (mapv #(apply str (map {\\0 \"<\", \\1 \"=\", \\2 \">\"} %)) (partition w sp))}))\n\n\n   \"array_shift() function precerve foreach by reference iterator pointer\",\n   :expect \"1\\n2\\n3\\n4\\narray(0) {\\n}\"}\n  {:id \"Zend/tests/foreach_016.phpt\",\n   :path \"Zend/tests/foreach_016.phpt\",\n   :source\n   \"<?php\\n$a = [1,2,3];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if ($v == 2) {\\n        array_unshift($a, 0, 0, 0, 0, 0, 0, 0, 0);\\n    }\\n}\\nvar_dump(count($a));\\n?>\",\n   :title\n   \"array_unshift() function precerve foreach by reference iterator pointer\",\n   :expect \"1\\n2\\n3\\nint(11)\"}\n  {:id \"Zend/tests/foreach_017.phpt\",\n   :path \"Zend/tests/foreach_017.phpt\",\n   :source\n   \"<?php\\n/* remove before */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 3) {\\n        $done = 1;\\n        array_splice($a, 1, 2);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* remove after */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 0) {\\n        $done = 1;\\n        array_splice($a, 2, 2);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* remove current */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 2) {\\n        $done = 1;\\n        array_splice($a, 1, 3);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n$replacement = ['x', 'y', 'z'];\\n\\n/* replace before */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 3) {\\n        $done = 1;\\n        array_splice($a, 1, 2, $replacement);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* replace after */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 0) {\\n        $done = 1;\\n        array_splice($a, 2, 2, $replacement);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n\\n/* replace current */\\n$done = 0;\\n$a = [0,1,2,3,4];\\nforeach($a as &$v) {\\n    echo \\\"$v\\\\n\\\";\\n    if (!$done && $v == 2) {\\n        $done = 1;\\n        array_splice($a, 1, 3, $replacement);\\n    }\\n}\\necho \\\"\\\\n\\\";\\n?>\",\n   :title\n{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `cl