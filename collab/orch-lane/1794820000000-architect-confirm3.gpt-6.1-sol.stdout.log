{'sender}\\\\ntest/yin/vm/ucf/rows_test.cljc:1374:                       :yin.admit/address :sender-only}\\\\ntest/yin/vm/ucf/rows_test.cljc:1376:                          [:installs 'host.mod :response] merge sender-record)\\\\ntest/yin/vm/ucf/rows_test.cljc:1380:    (doseq [opts [{} {:yin.k/admitted {'other.mod address}}\\\\ntest/yin/vm/ucf/rows_test.cljc:1381:                  {:yin.k/admitted {'host.mod :wrong-address}}\\\\ntest/yin/vm/ucf/rows_test.cljc:1382:                  {:yin.k/admitted {'host.mod nil}}]]\\\\ntest/yin/vm/ucf/rows_test.cljc:1384:            refusal (error #(rows/lower-task recv wire attach! opts))]\\\\ntest/yin/vm/ucf/rows_test.cljc:1390:          restored (rows/lower-task (assoc recv :attach-stream attach!) wire attach! {:yin.k/admitted {'host.mod address}})\\\\ntest/yin/vm/ucf/rows_test.cljc:1395:      (is (not-any? #(contains? response %) (keys sender-record)))\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:6:   lower-task decodes, checks and restores one into a fresh receiver.\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1159:;; (yin.vm.ucf.rows.checkpoint) answers it, lower-task's custody stage runs\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1320:;; Task transport (continuation design §7): lift-task and lower-task\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1635:(defn- install-node\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1673:        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1830:(defn- check-install!\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1880:    (run! #(check-install! recv %) installs)))\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:1890:      (when-not (= address (get (:yin.k/admitted opts) mn))\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:2233:                                             ;; Only the receiver's admitted name/address permits\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:2234:                                             ;; this child. Drop the sender's decision before\\\\nsrc/cljc/yin/vm/ucf/rows.cljc:2236:  