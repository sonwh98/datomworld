b)\\n663:                        (= (count a) (count b))\\n664:                        (every? #(member? b %) a))\\n665:          :else (= a b)))\\n666: \\n667: \\n668:      (defn- collapse?\\n669:        \\\"True when two of xs are equiv.\\\"\\n670:        [xs]\\n671:        (boolean\\n672:          (some (fn [[_ group]]\\n673:                  (when (< 1 (count group))\\n674:                    (some (fn [[i x]]\\n675:                            (some (fn [y] (equiv x y)) (drop (inc i) group)))\\n676:                          (map-indexed vector group))))\\n677:                (group-by equiv-hash xs))))\\n678: \\n679: \\n680:      ;; ==========================================================================\\n681:      ;; Encode: normalize a value into a wire tree, then Boring writes it\\n682:      ;; ==========================================================================\\n683: \\n684:      (def ^:private reader-position-keys\\n685:        [:line :column :end-line :end-column])\\n686: \\n687: \\n688:      (defn- char-code\\n689:        [s i]\\n690:        #?(:clj (int (.charAt ^String s (int i)))\\n691:           :cljs (.charCodeAt s i)))\\n692: \\n693: \\n694:      (defn- check-text\\n695:        \\\"s itself, after refusing any unpaired UTF-16 surrogate.\\\"\\n696:        [s]\\n697:        (let [n (count s)]\\n698:          (loop [i 0]\\n699:            (when (< i n)\\n700:              (let [c (char-code s i)]\\n701:                (cond\\n702:                  (<= 0xD800 c 0xDBFF)\\n703:                  (if (and (< (inc i) n) (<= 0xDC00 (char-code s (inc i)) 0xDFFF))\\n704:                    (recur (+ i 2))\\n705:                    (refuse :unpaired-surrogate (str \\\"unpaired high surrogate at \\\" i)))\\n706:                  (<= 0xDC00 c 0xDFFF)\\n707:                  (refuse :unpaired-surrogate (str \\\"unpaired low surrogate at \\\" i))\\n708:                  :else (recur (inc i)))))))\\n709:        s)\\n710: \\n711: \\n712:      (declare wire-of)\\n713: \\n714: \\n715:      (defn- int-wire\\n716:        \\\"The wire node of exact integer b (a host big integer).\\\"\\n717:        [b]\\n718:        (cond\\n719:          (and (<= 0 (bcmp b neg-two-64)) (neg? (bcmp b two-64)))\\n720:          (b->int b)\\n721:          (pos? (bsign b)) (wire/tagged 2 (magnitude-bytes b))\\n722:          :else (wire/tagged 3 (magnitude-bytes (b- (b- zero b) one)))))\\n723: \\n724: \\n725:      (defn- float-wire\\n726:        [d]\\n727:        (let [bs #?(:clj (let [buf (ByteBuffer/allocate 8)]\\n728:                           (.putLong buf (if (Double/isNaN d)\\n729:                                           0x7ff8000000000000\\n730:                                           (Double/doubleToRawLongBits d)))\\n731:                           (.array buf))\\n732:                    :cljs (let [out (js/Uint8Array. 8)\\n733:                                view (js/DataView. (.-buffer out))]\\n734:                            (if (js/isNaN d)\\n735:                              (do (.setUint32 view 0 0x7ff80000) (.setUint32 view 4 0))\\n736:                              (.setFloat64 view 0 d))\\n737:                            out))]\\n738:          (wire/frame 'dao.jing/float64 bs)))\\n739: \\n740: \\n741:      (defn- number-wire\\n742:        [x]\\n743:        (cond\\n744:          (host-integer? x)\\n745:          (do #?(:cljs (when (and (number? x) (not (js/Number.isSafeInteger x)))\\n746:                         (refuse :unsupported-value\\n747:                                 \\\"unsafe integral JavaScript number; pass a BigInt or float64\\\")))\\n748:              (int-wire (big x)))\\n749:          (float64? x) (float-wire (float-value x))\\n750:          (decimal? x) (wire/tagged 4 [(int-wire (big (decimal-exponent x)))\\n751:                                       (int-wire (big (decimal-mantissa x)))])\\n752:          :else (wire/tagged 30 [(int-wire (big (ratio-numerator x)))\\n753:                                 (int-wire (big (ratio-denominator x)))])))\\n754: \\n755: \\n756:      (defn- members-wire\\n757:        \\\"Wire the [key value] pairs (value nil for set elements) of one\\n758:         collection, refusing duplicate canonical encodings (dup-class) and\\n759:         portable-equality collapses before the collection is built. Returns\\n760:         [[key-bytes-hex key-wire value-wire] ...].\\\"\\n761:        [pairs set? dup-class]\\n762:        (let [wired (mapv (fn [[k v]]\\n763:                            (let [kw (wire-of k)\\n764:                                  vw (when-not set? (wire-of v))]\\n765:                              [(bytes-hex (wire/encode kw)) kw vw]))\\n766:                          pairs)]\\n767:          (when (< (count (set (map first wired))) (count wired))\\n768:            (refuse dup-class))\\n769:          (when (collapse? (map first pairs))\\n770:            (refuse :equality-collapse))\\n771:          wired))\\n772: \\n773: \\n774:      (defn- map-wire\\n775:        [m]\\n776:        (let [wired (members-wire (seq m) false :duplicate-key)]\\n777:          ;; Boring's :canonical profile sorts map keys by their bytes.\\n778:          (into {} (map (fn [[_ kw vw]] [kw vw])) wired)))\\n779: \\n780: \\n781:      (defn- set-wire\\n782:        [s]\\n783:        (let [wired (members-wire (map (fn [x] [x nil]) s) true :duplicate-element)]\\n784:          (wire/tagged 258 (mapv second (sort-by first wired)))))\\n785: \\n786: \\n787:      (defn- meta-wire\\n788:        \\\"Wrap wire node w in x's metadata frame, if x carries metadata that\\n789:         survives stripping. Stripped values are validated first (ruling A9);\\n790:         a metadata map carrying its own metadata is refused (ruling A3).\\\"\\n791:        [x w]\\n792:        (let [m (meta x)]\\n793:          (if (nil? m)\\n794:            w\\n795:            (do (when (some? (meta m))\\n796:                  (refuse :malformed-frame \\\"metadata map carries metadata\\\"))\\n797:             