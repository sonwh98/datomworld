[f (io/file path)]\\n   409\\t    (when (.exists f) (edn/read-string (slurp f)))))\\n   410\\t\\n   411\\t\\n   412\\t(defn- engine-result\\n   413\\t  \\\"`{:out :diag :uncaught}` of `source` on the walker, in the oracle's shape, or\\n   414\\t   `{:refused diagnostics}` / `{:threw message}`.\\\"\\n   415\\t  [source]\\n   416\\t  (try\\n   417\\t    (let [r (h/run-raw source)]\\n   418\\t      (if (:diagnostics r)\\n   419\\t        {:refused (mapv :message (:diagnostics r))}\\n   420\\t        {:out (h/latin1->text (:php/out r)),\\n   421\\t         :diag (mapv (juxt :errno :message) (:php/diag r)),\\n   422\\t         :uncaught (some-> (:php/uncaught r) (select-keys [:class :message]))}))\\n   423\\t    (catch Throwable t {:threw (str t)})))\\n   424\\t\\n   425\\t\\n   426\\t(defn- run-corpus\\n   427\\t  \\\"Run `programs` against the recorded oracle map: `{:total :compared :mismatches}`\\n   428\\t   where a host throw or a refusal is always a mismatch.\\\"\\n   429\\t  [programs oracle]\\n   430\\t  (reduce (fn [acc {:keys [id source]}]\\n   431\\t            (let [r (engine-result source)\\n   432\\t                  want (get oracle id)\\n   433\\t                  bad (or (contains? r :threw) (contains? r :refused)\\n   434\\t                          (and want (not= (update want :diag vec) (update r :diag vec))))]\\n   435\\t              (cond-> (update acc :total inc)\\n   436\\t                want (update :compared inc)\\n   437\\t                bad (update :mismatches conj [id r]))))\\n   438\\t          {:total 0, :compared 0, :mismatches []}\\n   439\\t          programs))\\n   440\\t\\n   441\\t\\n   442\\t(deftest permutation-corpus-quick-test\\n   443\\t  (let [oracle (read-edn-file \\\"test/yang/php/antlr/permutation_oracle_quick.edn\\\")\\n   444\\t        {:keys [total compared mismatches]} (run-corpus (perms/quick) oracle)]\\n   445\\t    (is (= (* 2 (count perms/quick-ids)) total))\\n   446\\t    (is (empty? mismatches) (pr-str (take 3 mi