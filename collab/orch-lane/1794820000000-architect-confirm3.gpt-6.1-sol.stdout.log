    d (bquot d g)]\\n483:            #?(:clj (if (= one d)\\n484:                      (Rational. n d)\\n485:                      (clojure.lang.Ratio. ^BigInteger n ^BigInteger d))\\n486:               :cljs (Rational. n d)))))\\n487: \\n488: \\n489:      (defn ratio-numerator\\n490:        [r]\\n491:        #?(:clj (if (instance? Rational r)\\n492:                  (.-numerator ^Rational r)\\n493:                  (.numerator ^clojure.lang.Ratio r))\\n494:           :cljs (.-numerator ^Rational r)))\\n495: \\n496: \\n497:      (defn ratio-denominator\\n498:        [r]\\n499:        #?(:clj (if (instance? Rational r)\\n500:                  (.-denominator ^Rational r)\\n501:                  (.denominator ^clojure.lang.Ratio r))\\n502:           :cljs (.-denominator ^Rational r)))\\n503: \\n504: \\n505:      ;; ==========================================================================\\n506:      ;; Portable numeric operations\\n507:      ;; ==========================================================================\\n508: \\n509:      (defn- float-fields\\n510:        \\\"[negative? biased-exponent fraction-big] of a host double.\\\"\\n511:        [d]\\n512:        #?(:clj (let [bits (Double/doubleToRawLongBits (double d))]\\n513:                  [(neg? bits)\\n514:                   (bit-and (bit-shift-right bits 52) 0x7ff)\\n515:                   (big (bit-and bits 0xfffffffffffff))])\\n516:           :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\\n517:                   (.setFloat64 view 0 d)\\n518:                   (let [hi (.getUint32 view 0)\\n519:                         lo (.getUint32 view 4)]\\n520:                     [(>= hi 0x80000000)\\n521:                      (bit-and (unsigned-bit-shift-right hi 20) 0x7ff)\\n522:                      (b+ (b* (big (bit-and hi 0xfffff)) (bpow two 32)) (big lo))]))))\\n523: \\n524: \\n525:      (defn- reduced-fraction\\n526:        [n d]\\n527:        (let [g (bgcd n d)]\\n528:          (if (zero? (bsign g)) [:finite zero one] [:finite (bquot n g) (bquot d g)])))\\n529: \\n530: \\n531:      (defn- exact\\n532:        \\\"The exact value of numeric x: [:nan], [:inf -1|1], or\\n533:         [:finite numerator denominator] reduced with a positive denominator.\\\"\\n534:        [x]\\n535:        (cond\\n536:          (host-integer? x) [:finite (big x) one]\\n537:          (float64? x) (let [[neg e f] (float-fields (float-value x))]\\n538:                         (cond\\n539:                           (and (= e 0x7ff) (pos? (bsign f))) [:nan]\\n540:                           (= e 0x7ff) [:inf (if neg -1 1)]\\n541:                           :else (let [m (if (zero? e) f (b+ f (bpow two 52)))\\n542:                                       p (if (zero? e) -1074 (- e 1075))\\n543:                                       m (if neg (b- zero m) m)]\\n544:                                   (if (>= p 0)\\n545:                                     [:finite (b* m (bpow two p)) one]\\n546:                                     (reduced-fraction m (bpow two (- p)))))))\\n547:          (decimal? x) (let [e (decimal-exponent x)\\n548:                             m (big (decimal-mantissa x))]\\n549:                         (if (>= e 0)\\n550:                           [:finite (b* m (bpow ten e)) one]\\n551:                           (reduced-fraction m (bpow ten (- e)))))\\n552:          (ratio? x) [:finite (big (ratio-numerator x)) (big (ratio-denominator x))]\\n553:          :else (throw (ex-info \\\"not a portable number\\\" {:value x}))))\\n554: \\n555: \\n556:      (defn- exact-key\\n557:        \\\"A host-independent value key of an exact triple (strings, so every\\n558:         host compares and hashes it the same way).\\\"\\n559:        [[kind a b]]\\n560:        (case kind\\n561:          :finite [:finite (str a) (str b)]\\n562:          :inf [:inf a]\\n563:          :nan [:nan]))\\n564: \\n565: \\n566:      (defn num=\\n567:        \\\"Portable numeric equality: exact mathematical valu