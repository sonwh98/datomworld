(if (= val :py/None) typ val))\n554\t             (py/as-exception\n555\t               (py/call typ (if (= (get val :py/type) :tuple)\n556\t                              (get val :items)\n557\t                              (py/vconj [] val)))))\n558\t           (py/type-error\n559\t             (py/str (data/str-concat\n560\t                       \"exceptions must be classes or instances deriving \"\n561\t                       \"from BaseException, not type\"))))\n562\t         (if (= val :py/None)\n563\t           (py/as-exception typ)\n564\t           (py/type-error\n565\t             {:py/str \"instance exception may not have a separate value\"}))))]\n566\t    [py/gen-close\n567\t     ;; GeneratorExit thrown in: completion, or GeneratorExit raised back,\n568\t     ;; is None; any other raise propagates; a yield is a RuntimeError and\n569\t     ;; the generator stays suspended\n570\t     (fn [g]\n571\t       (let [o (py/gen-switch\n572\t                 g (py/outcome :throw (py/call py.b/GeneratorExit [])))\n573\t             tag (get o 0)]\n574\t         (if (= tag :yield)\n575\t           (py/raise-new py.b/RuntimeError\n576\t                         {:py/str \"generator ignored GeneratorExit\"})\n577\t           (if (= tag :raise)\n578\t             (if (py/subclass? (py/type-of (get o 1)) py.b/GeneratorExit)\n579\t               :py/None\n580\t               (py/raise (get o 1)))\n581\t             :py/None))))]\n582\t    [py/gen-attr\n583\t     (fn [g name]\n584\t       (if (= name \"send\")\n585\t         (py/method g py.b/gen-send)\n586\t         (if (= name \"__next__\")\n587\t           (py/method g py.b/gen-next)\n588\t           (if (= name \"throw\")\n589\t             (py/method g py.b/gen-throw)\n590\t             (if (= name \"close\")\n591\t               (py/method g py.b/gen-close)\n592\t               (if (= name \"__iter__\")\n593\t                 (py/method g py.b/gen-iter)\n594\t                 (py/attr-error name)))))))]\n595\t    [py/n