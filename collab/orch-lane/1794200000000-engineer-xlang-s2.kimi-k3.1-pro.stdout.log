ails <=; host = can answer true for one boxed NaN\n1871\t         (if (<= x x)\n1872\t           (py/vconj (py/vconj [] :py.numeric/infinite) (if (< x 0) \"-\" \"+\"))\n1873\t           (py/vconj [] :py.numeric/nan))))]\n1874\t    [py/key\n1875\t     ;; the normalized index key: a number is its exact value, so 1, 1.0\n1876\t     ;; and True are one key and 2^53 and 2^53 + 1 are two (C3 ruling 6);\n1877\t     ;; a tuple is hashable when its elements are; lists, dicts and sets\n1878\t     ;; are not\n1879\t     (fn [k]\n1880\t       (if (py/numeric? k)\n1881\t         ;; py/num reads a float's payload through data/float-value: a\n1882\t         ;; float64 carrier never meets host arithmetic\n1883\t         (if (py/float? k)\n1884\t           (py/float-key (py/num k))\n1885\t           (py/finite-key\n1886\t             (if (py/zero? k) \"0\"\n1887\t                 (py/int-result (integer/format (py/num k) 16)))\n1888\t             \"1\"))\n1889\t         (if (= (get k :py/type) :tuple)\n1890\t           (assoc {} :py/tuple-key (py/keys-of (get k :items) 0 []))\n1891\t           (let [t (py/content-type k)]\n1892\t             (if (if (= t :list) true (if (= t :dict) true (= t :set)))\n1893\t               (py/type-error {:py/str \"unhashable type\"})\n1894\t               k)))))]\n1895\t    [py/keys-of\n1896\t     (fn [xs i acc]\n1897\t       (let [x (get xs i :py/stop)]\n1898\t         (if (= x :py/stop) acc (py/keys-of xs (+ i 1) (conj acc (py/key x))))))]\n1899\t\n1900\t    ;; ---------------------------------------------------------- hash\n1901\t    ;; Python's numeric hash (C3 ruling 7) modulo P = 2^61 - 1 on every\n1902\t    ;; host, through the integer module, never a host or Jing hash: equal\n1903\t    ;; numbers hash equal, and since 2^61 = 1 (mod P), 2^e is 2^(e mod 61)\n1904\t    ;; modulo P. P is built from safe literals. Only int, bool\n1905\t    ;; and finite float hash. An identity object (any cell) is unhashable,\n1906\t    ;; since its only identity is a cell id, which is never exposed. A\n1907\t    ;; tuple is a valid dict key through py/key, but hash() of it, of a\n1908\t    ;; string and of +-inf is not yet supported (NotImplementedError).\n1909\t    [py/hash-modulus\n1910\t     (fn []\n1911\t       (py/int-result\n1912\t         (integer/sub (py/int-result (integer/shift-left 1 61)) 1)))]\n1913\t    [py/mod-p\n1914\t     (fn [n]\n1915\t       (get (py/int-result (integer/floor-div-mod n (py/hash-modulus))) 1))]\n1916\t    [py/hash-signed\n1917\t     ;; the hash of a number of sign s whose magnitude hashes to h; -1 is\n1918\t     ;; reserved, so it answers -2\n1919\t     (fn [s h]\n1920\t       (if (< s 0)\n1921\t         (let [v (py/int-result (integer/neg h))] (if (= v -1) -2 v))\n1922\t         h))]\n1923\t    [py/hash-int\n1924\t     (fn [n]\n1925\t       (let [s (integer/compare n 0)]\n1926\t         (py/hash-signed s\n1927\t                         (py/mod-p (if (< s 0)\n1928\t                                     (py/int-result (integer/neg n))\n1929\t                                     n)))))]\n1930\t    [py/hash-float\n1931\t     ;; a finite nonzero x = m * 2^e: |m| * 2^(e mod 61) modulo P\n1932\t     (fn [x]\n1933\t       (let [p (py/float-parts x)\n1934\t             m (get p 0)\n1935\t             s (integer/compare m 0)\n1936\t             k (get (py/int-result (integer/floor-div-mod (get p 1) 61)) 1)]\n1937\t         (py/hash-signed\n1938\t           s\n1939\t           (py/mod-p\n1940\t             (py/int-result\n1941\t               (integer/mul (if (< s 0) (py/int-result (integer/neg m)) m)\n1942\t                            (py/int-result (integer/shift-left 1 k))))))))]\n1943\t    [py/hash\n1944\t     (fn [x]\n1945\t       (if (py/numeric? x)\n1946\t         (if (py/float? x)\n1947\t           (let [f (py/num x)]\n1948\t             (if (py/finite? f)\n1949\t               (if (py/zero? f) 0 (py/hash-float f))\n1950\t               (py/raise-new py.b/NotImplementedError"}
{"role":"tool","tool_call_id":"tool_FTQqznAXOeJL3SwnHn9hb81z","content":"1\t(ns yang.python.antlr.publication\n2\t  \"C4 slices I3 and I5 (docs/design/yang.antlr.md 8.5.6): a set of compiled Python\n3\t   units published as linker modules. The ordering, SCC bundling and publish\n4\t   loop are `yang.core.publication`'s; this namespace supplies the Python\n5\t   hooks: the imports `lower/imported-module-names` hoists, the\n6\t   `lower/module-spec` and `lower/scc-module-specs` emitters, the I7 site\n7\t   set, and no binder table. Every Python module pins the `yang.call`\n8\t   address from the published `py` module's requirements because its\n9\t   runtime call path uses that dispatcher.\n10\t   Name assertions stay the linker's (`yin.vm.linker.publish/assertion`\n11\t   and `name-envelopes`): this namespace publishes content, it signs\n12\t   nothing.\"\n13\t  (:require [dao.jing :as jing]\n14\t            [yang.core.publication :as core]\n15\t            [yang.python.antlr.lower :as lower]\n16\t            [yang.python.antlr.siteset :as siteset]\n17\t            [yin.vm.linker.publish :as publish]))\n18\t\n19\t\n20\t(defn- unit-imports\n21\t  \"The Python modules unit `u` statically imports.\"\n22\t  [{:keys [name package? packet]}]\n23\t  (lower/imported-module-names packet\n24\t                               {:name name, :package? (boolean package?)}))\n25\t\n26\t\n27\t(defn- config\n28\t  [publish-fn call-address]\n29\t  {:imported-names unit-imports,\n30\t   :module-spec (fn [registry {:keys [name package? packet]} py-address deps]\n31\t                  (lower/module-spec registry packet\n32\t                                     {:name name, :package? package?,\n33\t                                      :py-address py-address, :call-address call-address,\n34\t                                      :deps deps})),\n35\t   :scc-module-specs (fn [registry units py-address deps]\n36\t                       (lower/scc-module-specs registry units py-address call-address deps)),\n37\t   :site-set siteset/publish!,\n38\t   :binder-table nil,\n39\t   :refusal-ns \"yang.python.antlr\",\n40\t   :publish-fn publish-fn})\n41\t\n42\t\n43\t(defn publication-order\n44\t  \"Dependency-first names, retaining the I3 order for acyclic units.\n45\t   Cyclic components appear as sorted member vectors in :order, one\n46\t   publication step per SCC. External imports must be in `published`.\"\n47\t  [units published]\n48\t  (core/publication-order (config publish/publish-module! nil) units published))\n49\t\n50\t\n51\t(defn publish-units!\n52\t  \"Publish `units` (`[{:name :package? :packet}]`) into the content store\n53\t   `handle` over the host registry `registry`, `py` pinned at\n54\t   `py-address` and each import outside the set at its address in\n55\t   `published` ({python-name address}), in `publication-order`. Answers\n56\t   `{:status :ok :addresses {python-name address}\n57\t     :bundles {bundle-symbol address}\n58\t     :sites {python-name-or-bundle-symbol site-publication}}` for the units\n59\t   of the set (`siteset/publish!`'s answer for each module published beside\n60\t   its code image, I7; an SCC member alias carries no marks and so no\n61\t   entry, its bundle does). The publisher that asserts these names\n62\t   indexes `siteset/signed-entries` of `:sites` in the same index\n63\t   transaction; a module whose entry is missing is refused by every\n64\t   hook-profile reader. Or the\n65\t   first refusal: `publication-order`'s before anything is written, else\n66\t   `publish-module!`'s with a string `:unit`: the Python name for a member,\n67\t   or the bundle module name for an SCC bundle. Every bundle name must be\n68\t   asserted/bound alongside the member names for aliases to deliver.\n69\t   Optional `publish-fn` takes `[handle spec]`, defaulting to\n70\t   `publish/publish-module!`, for both bundles and members.\"\n71\t  ([handle registry py-address units]\n72\t   (publish-units! handle registry py-address units {}))\n73\t  ([handle registry py-address units published]\n74\t   (publish-units! handle registry py-address units published publish/publish-module!))\n75\t  ([handle registry py-address units published publish-fn]\n76\t   (let [py-manifest (when (and handle py-address)\n77\t                       (jing/get handle py-address nil))\n78\t         call-address (get-in py-manifest [:yin.module/requires 'yang.call])]\n79\t     (core/publish-units! (config publish-fn call-address)\n80\t                          handle registry py-address units published))))"}
{"role":"tool","tool_call_id":"tool_2mdokcKBqzYgScce9jbEyvxe","content":"src/cljc/yang/python/antlr/repl.cljc:8:   globals dict live in `sys.modules` (ruling 18), so a name bound by one\nsrc/cljc/yang/python/antlr/repl.cljc:12:   The bundled prelude defines the runtime in the VM's store and `py/init!`\nsrc/cljc/yang/python/antlr/repl.cljc:97:                     (u/lam [lower/globals-sym lower/globals-fn-sym] body)\nsrc/cljc/yang/python/antlr/parser.cljc:98:(defn parse-source\nsrc/cljc/yang/python/antlr/prelude.cljc:51:     module globals  a dict (owner decision 1): the module body receives it\nsrc/cljc/yang/python/antlr/prelude.cljc:52:                     as `%globals` and every function closes over it, which\nsrc/cljc/yang/python/antlr/prelude.cljc:53:                     is Python's own `__globals__`; a miss falls back to the\nsrc/cljc/yang/python/antlr/prelude.cljc:65:   then discovers admitted entries through `yang.call`. Python function\nsrc/cljc/yang/python/antlr/prelude.cljc:74:   and the builtins namespace dict `py.b/builtins`, which `py/global-get`\nsrc/cljc/yang/python/antlr/prelude.cljc:102:                     generator start or resume is admitted only while its\nsrc/cljc/yang/python/antlr/prelude.cljc:136:   composition's `integer` limits must admit at least that.\nsrc/cljc/yang/python/antlr/prelude.cljc:163:   4 `integer` exports included, through `admit` before a program runs.\nsrc/cljc/yang/python/antlr/prelude.cljc:168:   module `py` (`module-exports`, `module-spec`), which a linked program\nsrc/cljc/yang/python/antlr/prelude.cljc:173:   defines it. `py/vconj` and `py/lnot` are not `py/conj` and `py/not`\nsrc/cljc/yang/python/antlr/prelude.cljc:179:   Host names the prelude depends on and does not define: `host-names`\nsrc/cljc/yang/python/antlr/prelude.cljc:444:     ;; the crossing into a generator that start or resume admitted\nsrc/cljc/yang/python/antlr/prelude.cljc:638:    ;; User-defined iterators (ruling 8). The special methods are looked up