{"role":"tool","tool_call_id":"tool_K9eRrXFAP3hN6y0qsN7H0E9x","content":"35\t                    [\"ts_fn\"]\n36\t                    [:php \"<?php echo ts_fn(1.5, 2.5) == 4 ? 'yes' : 'no';\"])))))\n37\t\n38\t\n39\t(deftest php-closure-called-from-ts-test\n40\t  (testing \"TS stores and calls the same PHP function cell it received\"\n41\t    (is (= {:js/out [\"true 5\"], :js/uncaught nil}\n42\t           (xl/call [:php \"<?php function phpfn($a, $b) { return $a + $b; }\"]\n43\t                    [\"phpfn\"]\n44\t                    [:typescript\n45\t                     \"const stored = phpfn; console.log(stored === phpfn, stored(2, 3));\"])))))\n46\t\n47\t\n48\t(deftest limits-test\n49\t  (testing \"a PHP array returned to TS is an opaque handle, usable in PHP\"\n50\t    (let [src \"<?php function phpfn($a = 7) { return $a === 7 ? [1, 2, 3] : count($a); }\"]\n51\t      ;; the PHP int `count` returns reaches TS as an integer (`3n`), not a\n52\t      ;; JS number: the two preludes keep their own number kinds\n53\t      (is (= {:js/out [\"3n\"], :js/uncaught nil}\n54\t             (xl/call [:php src]\n55\t                      [\"phpfn\"]\n56\t                      [:typescript \"const h = phpfn(); console.log(phpfn(h));\"])))))\n57\t  (testing \"PHP null is neither JS null nor undefined\"\n58\t    (let [src \"<?php function phpfn() { return null; }\"]\n59\t      (is (= {:js/out [\"false false\"], :js/uncaught nil}\n60\t             (xl/call [:php src]\n61\t                      [\"phpfn\"]\n62\t                      [:typescript\n63\t                       \"const n = phpfn(); console.log(n === null, n === undefined);\"]))))))"}
