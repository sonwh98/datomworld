{"role":"tool","tool_call_id":"tool_mvnTfhPUaPkQMl6YSo9et4MH","content":"1900\t                                         (unless (g x) 1 2))]\n1901\t                        true (assoc outcome-opts :macros #{'unless}))\n1902\t                      nil\n1903\t                      (catch clojure.lang.ExceptionInfo e (ex-message e)))))))\n1904\t\n1905\t\n1906\t;; =============================================================================\n1907\t;; Slice 7: the guest collection and higher-order library\n1908\t;; =============================================================================\n1909\t\n1910\t(def ^:private library-modules\n1911\t  \"The library's whole host surface: the `kind` module and the `portable`\n1912\t   adapters of the data exports the collection predicates read.\"\n1913\t  (let [host (fn [registry module-name fns arities]\n1914\t               (module/register-host-module\n1915\t                 registry module-name fns\n1916\t                 (into {} (map (fn [[op _]]\n1917\t                                 [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n1918\t                       fns)))\n1919\t        portable (into {}\n1920\t                       (map (fn [[source _]]\n1921\t                              (let [op (symbol (name source))]\n1922\t                                [op (yang/outcome-adapter data/refusal-message\n1923\t                                                          (get data/data-module op))])))\n1924\t                       yang/library-adapters)]\n1925\t    (-> av-modules\n1926\t        (host 'kind yang/kind-module yang/kind-arities)\n1927\t        (host 'portable portable\n1928\t              (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n1929\t                    (keys portable))))))\n1930\t\n1931\t\n1932\t(def ^:private library-opts\n1933\t  {:convention :arg-vector, :outcomes true\n1934\t   :adapters yang/library-adapters\n1935\t   :native vm/primitive-profiles})\n1936\t\n1937\t\n1938\t(defn run-guest-machine\n1939\t  \"Run an AST through either observer composition with a finite instruction\n1940\t   budget. Return the terminal machine so fixtures can observe its streams.\"\n1941\t  [ast modules lane step-limit]\n1942\t  (let [run-bounded (fn [machine]\n1943\t                      (loop [v machine, n 0]\n1944\t                        (cond\n1945\t                          (or (vm/halted? v) (vm/blocked? v)) v\n1946\t                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n1947\t                                                           {:lane lane :steps n}))\n1948\t                          :else (recur (vm/step v) (inc n)))))\n1949\t        semantic? (= lane :semantic)\n1950\t        machine (if semantic?\n1951\t                  (semantic/create-vm {:make-stream tu/make-stream\n1952\t                                       :capability-secret tu/secret :modules modules})\n1953\t                  (tu/create-vm {:modules modules}))\n1954\t        session (tu/make-observer-session machine)\n1955\t        load-program (if semantic?\n1956\t                       (fn [v rows stamp]\n1957\t                         (vm/check-contract! vm/ast-contract stamp)\n1958\t                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n1959\t                                               vm/semantic-contract))\n1960\t                       ast-walker/vm-load-program)\n1961\t        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n1962\t    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n1963\t                                (vm/fresh-code-loader load-program vm/ast-contract)\n1964\t                                run-bounded)\n1965\t        :consumer)))\n1966\t\n1967\t\n1968\t(defn run-guest-ast\n1969\t  \"The value from run-guest-machine; shared by library and oracle fixtures.\"\n1970\t  [ast modules lane step-limit]\n1971\t  (vm/value (run-guest-machine ast modules lane step-limit)))\n1972\t\n1973\t\n1974\t(defn- run-library\n1975\t  \"The raw outcome of the last of `forms`, compiled with the library\n1976\t   definitions the program needs.\"\n1977\t  ([forms] (run-library forms library-opts))\n1978\t  ([forms opts]\n1979\t   (let [walker (run-library forms opts :walker 1000000)\n1980\t         semantic (run-library forms opts :semantic 1000000)]\n1981\t     (is (= walker semantic) (str \"library lanes agree: \" (pr-str forms)))\n1982\t     walker))\n1983\t  ([forms opts lane step-limit]\n1984\t   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\n1985\t                  library-modules lane step-limit)))\n1986\t\n1987\t\n1988\t(defn- lib\n1989\t  \"The value of the single expression `form`, or the raw error outcome.\"\n1990\t  [form]\n1991\t  (let [[tag payload] (run-library [form])]\n1992\t    (if (= :yin.k/ok tag) payload [tag payload])))\n1993\t\n1994\t\n1995\t(deftest test-library-closes-over-its-own-names\n1996\t  (testing \"library-for returns the definitions a program mentions, transitively\"\n1997\t    (let [names (set (map second (yang/library-for '[(seq? x)])))]\n1998\t      (is (every? names '[seq? sequential? vector? map? set? coll?])\n1999\t          \"seq? pulls sequential?, vector?, map?, set? and coll?\")\n2000\t      (is (not (contains? names 'map))))\n2001\t    (is (= [] (yang/library-for '[(+ 1 2)])))\n2002\t    (is (= [] (yang/library-for '[(quote (map f xs))])) \"quoted data mentions nothing\")\n2003\t    (is (= [] (yang/library-for '[(defn map\n2004\t                                    [f c]\n2005\t                                    c) (map 1 2)]))\n2006\t        \"a program definition shadows the library's\")))\n2007\t\n2008\t\n2009\t(deftest test-library-kind-predicates\n2010\t  (testing \"collection predicates are derived from the data module's refusals\"\n2011\t    (is (= [true false false false false false]\n2012\t           (lib '[(vector? [1]) (vector? '(1)) (vector? {}) (vector? #{}) (vector? 1) (vector? nil)])))\n2013\t    (is (= [true false false false false]\n2014\t           (lib '[(map? {}) (map? [1]) (map? #{}) (map? nil) (map? \"s\")])))\n2015\t    (is (= [true false false]\n2016\t           (lib '[(set? #{1}) (set? [1]) (set? nil)])))\n2017\t    (is (= [true true true true false false false]\n2018\t           (lib '[(coll? []) (coll? '()) (coll? {}) (coll? #{}) (coll? nil) (coll? 1) (coll? \"s\")])))\n2019\t    (is (= [true false false false false]"}
{"role":"tool","tool_call_id":"tool_Trwa9sUhRdGzrX0pYEMbrPpL","content":"1100\t\n1101\t;; =============================================================================\n1102\t;; Slice 5: the outcome model\n1103\t;; =============================================================================\n1104\t\n1105\t(def ^:private effect-log (atom []))\n1106\t\n1107\t\n1108\t(def ^:private outcome-modules\n1109\t  (let [host (fn [name entries]\n1110\t               (fn [registry]\n1111\t                 (module/register-host-module\n1112\t                   registry name\n1113\t                   (into {} (map (fn [[op f _]] [op f])) entries)\n1114\t                   (into {} (map (fn [[op _ p]] [op p])) entries))))]\n1115\t    (-> av-modules\n1116\t        ((host 'portable\n1117\t               [['nth\n1118\t                 (yang/outcome-adapter data/refusal-message (get data/data-module 'nth))\n1119\t                 (get data/data-profiles 'nth)]]))\n1120\t        ((host 'probe\n1121\t               [['note\n1122\t                 (fn [x] (swap! effect-log conj x) x)\n1123\t                 (vm/primitive-profile 'note :pure [1] #{} :none)]])))))\n1124\t\n1125\t\n1126\t(def ^:private outcome-opts\n1127\t  {:convention :arg-vector, :outcomes true\n1128\t   :native (set (keys vm/primitives))\n1129\t   :adapters {'data/nth 'portable/nth}})\n1130\t\n1131\t\n1132\t(defn- outcome-ast\n1133\t  [forms]\n1134\t  (yang/compile-program forms true outcome-opts))\n1135\t\n1136\t\n1137\t(defn- run-outcome\n1138\t  \"The raw outcome the last form of `forms` returns.\"\n1139\t  [forms]\n1140\t  (reset! effect-log [])\n1141\t  (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n1142\t      (tu/queue-ast! (outcome-ast forms))\n1143\t      tu/run-session\n1144\t      :consumer\n1145\t      vm/value))\n1146\t\n1147\t\n1148\t(defn- run-profile-outcome\n1149\t  [forms]\n1150\t  (reset! effect-log [])\n1151\t  (let [ast (walk/postwalk\n1152\t              (fn [node]\n1153\t                (if (= node (u/v 'profile-raise)) (u/v 'probe/note) node))\n1154\t              (outcome-ast forms))]\n1155\t    (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n1156\t        (tu/queue-ast! ast)\n1157\t        tu/run-session\n1158\t        :consumer\n1159\t        vm/value)))\n1160\t\n1161\t\n1162\t(deftest test-outcome-success-and-throw\n1163\t  (is (= [:yin.k/ok 2] (run-outcome '[(defn f\n1164\t                                        [x]\n1165\t                                        (+ x 1)) (f 1)])))\n1166\t  (is (= [:yin.k/ok [:ok 1]] (run-outcome '[(defn f\n1167\t                                              [x]\n1168\t                                              [:ok x]) (f 1)]))\n1169\t      \"LaTTe's own [:ok ...] stays an ordinary value inside the payload\")\n1170\t  (is (= [:yin.k/error {:yin.k/message \"boom\", :yin.k/data {:x 1}}]\n1171\t         (run-outcome '[(defn f\n1172\t                          [x]\n1173\t                          (throw (ex-info \"boom\" {:x x}))) (f 1)])))\n1174\t  (testing \"an untaken throw branch leaves the success outcome\"\n1175\t    (is (= [:yin.k/ok :survived]\n1176\t           (run-outcome '[(defn f\n1177\t                            [x]\n1178\t                            (if x (throw (ex-info \"t\" {})) :survived))\n1179\t                          (f false)])))))\n1180\t\n1181\t\n1182\t(deftest test-common-call-descriptor-publication\n1183\t  (is (= [:yin.k/ok [:function true 2 3]]\n1184\t         (run-outcome '[(defn f\n1185\t                          [x]\n1186\t                          (+ x 1))\n1187\t                        [(get f :clj/type)\n1188\t                         (data/callable? (yang.call/entry f))\n1189\t                         (f 1)"}
{"role":"tool","tool_call_id":"tool_sUjxmdxCKCbjK0NwOLXmqfrR","content":"1\t(ns yang.python.antlr.linked-harness\n2\t  \"The linked profile's composition for the Python tests (C4 slices P2\n3\t   and P3, docs/design/yang.antlr.md 8.5.6): the namespace that requires\n4\t   this is the publisher of `py` and `pysp`, so it publishes each module\n5\t   once per process into one in-memory content store and serves them to\n6\t   every linked run over a `yin.vm.linker.interpreter` composition under\n7\t   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n8\t   evidence is `publish-module!`'s own `link-local` links, which\n9\t   `linked-prelude-test` asserts.\n10\t\n11\t   A linked run builds the program's task on one of the three vector VMs\n12\t   with a link pair, then runs the VM and serves the pair alternately\n13\t   until the VM stops blocking, as the REPL's drive does. The AST walker\n14\t   is not a backend here: its link of `py` is refused `:undeclared-free`\n15\t   until L-b.\"\n16\t  (:require [yin.vm.semantic.linearize :as sr-linearize]\n17\t            [yin.vm.semantic.derive :as derive]\n18\t            [dao.jing.mem :as mem]\n19\t            [yang.core.call :as call]\n20\t            [yang.python.antlr.prelude :as prelude]\n21\t            [yang.python.antlr.safepoint :as safepoint]\n22\t            [yin.vm :as vm]\n23\t            [yin.vm.data :as data]\n24\t            [yin.vm.debruijn-code :as dcode]\n25\t            [yin.vm.debruijn-register-code :as rcode]\n26\t            [yin.vm.debruijn.register :as rvm]\n27\t            [yin.vm.debruijn.stack :as dvm]\n28\t            [yin.vm.integer :as integer]\n29\t            [yin.vm.linker.interpreter :as link]\n30\t            [yin.vm.linker.publish :as publish]\n31\t            [yin.vm.module :as module]\n32\t            [yin.vm.semantic :as semantic]\n33\t            [yin.vm.test-utils :as tu]))\n34\t\n35\t\n36\t(def integer-limits\n37\t  \"The ordinary Python composition's `integer` limits.\"\n38\t  {::integer/max-bits 100000, ::integer/max-digits 4300})\n39\t\n40\t\n41\t(defn registry\n42\t  \"The full host registry a linked Python composition registers: the\n43\t   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n44\t   `stream` — the hook module `pysp` polls a signal stream, so the\n45\t   safepointed composition needs it even though `py` does not.\"\n46\t  ([] (registry integer-limits))\n47\t  ([limits]\n48\t   (-> (module/default-registry)\n49\t       module/register-cell-module\n50\t       (data/register-data-module {::data/max-items 1048576})\n51\t       (prelude/register-integer-module limits)\n52\t       module/register-stream-module)))\n53\t\n54\t\n55\t(def published\n56\t  \"`yang.call` and `py` published once into their own content store.\"\n57\t  (delay\n58\t    (let [store (mem/create-content-mem)\n59\t          call-result (publish/publish-module! store (call/module-spec (registry)))\n60\t          result (publish/publish-module! store\n61\t                                          (prelude/module-spec (registry)\n62\t                                                               (:address call-result)))]\n63\t      {:store store, :result result, :address (:address result),\n64\t       :call-result call-result, :call-address (:address call-result)})))\n65\t\n66\t\n67\t(def published-pysp\n68\t  \"`pysp` published once into `py`'s own content store, which its pinned\n69\t   requirement already lives in: the same shape as `published`.\"\n70\t  (delay\n71\t    (let [{:keys [store address]} @published\n72\t          result (publish/publish-module!\n73\t                   store (safepoint/module-spec (registry) address))]\n74\t      {:store store, :result result, :address (:address result)})))\n75\t\n76\t\n77\t(defn source\n78\t  \"The serving composition over the published store: `name-env` defaults\n79\t   to `{py <address> yang.call <address>}`, derivation `:trusted`, the test being the\n80\t   publisher. Explicit name environments also receive the harness's\n81\t   `yang.call` runtime module, which every linked Python body requires.\n82\t   `pysp`-serving sources pass their own `name-env`, the\n83\t   safepointed runs' `{'py a :pysp b}` both.\"\n84\t  ([] (source {'py (:address @published),\n85\t               'yang.call (:call-address @published)}))\n86\t  ([name-env]\n87\t   (link/composition {:content-store (:store @published),\n88\t                      :name-env (merge {'yang.call (:call-address @published)}\n89\t                                       name-env),\n90\t                      :derivation :trusted})))\n91\t\n92\t\n93\t(defn safepoint-source\n94\t  \"The serving composition for `pysp`, `py`, and the `yang.call` module\n95\t   required by `py`.\"\n96\t  []\n97\t  (source {'py (:address @published), 'pysp (:address @published-pysp),\n98\t           'yang.call (:call-address @published)}))\n99\t\n100\t\n101\t(defn publish-guest-module!\n102\t  \"One guest module's `spec` (lower/module-spec's) published into `py`'s\n103\t   own content store, where its pinned requirements already live:\n104\t   `publish-module!`'s answer. The test helper supplies the harness's\n105\t   `yang.call` address as the runtime dependency when a test constructs a\n106\t   spec directly. Guest modules are tiny beside `py`, so a test may publish\n107\t   its own; publish imports bottom-up, the `deps` map naming each import's\n108\t   address.\"\n109\t  [spec]\n110\t  (publish/publish-module! (:store @published)\n111\t                           (update spec :requires\n112\t                                   #(assoc (or % {}) 'yang.call\n113\t                                           (:call-address @published)))))\n114\t\n115\t\n116\t(def backends\n117\t  \"Each vector backend's root task over a program AST and composition.\"\n118\t  {:semantic (fn [ast opts]\n119\t               (semantic/load-ast (semantic/create-vm opts)\n120\t                                  (vm/ast->datoms ast)\n121\t                                  vm/ast-contract)),\n122\t   :stack (fn [ast opts]\n123\t            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n124\t                           (assoc opts :contract vm/stack-contract))),\n125\t   :register (fn [ast opts]\n126\t               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n127\t                              (assoc opts :contract vm/register-contract)))})\n128\t\n129\t\n130\t(def continues\n131\t  \"Each vector backend's admission of the next top-level unit to a halted\n132\t   task, as `yin.repl` admits an input line: the task keeps its store,\n133\t   heap, module registry and module stores.\"\n134\t  {:semantic (fn [task ast]\n135\t               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n136\t   :stack (fn [task ast]\n137\t            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n138\t                  attached (dvm/attach-image task img vm/stack-contract)]\n139\t              (assoc attached\n140\t                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n141\t                     :frames [] :stack [] :continuation []\n142\t                     :halted? false :blocked? false :value nil))),\n143\t   :register (fn [task ast]\n144\t               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n145\t                     attached (rvm/attach-image task img vm/register-contract)\n146\t                     pc (rvm/absolute-pc attached\n147\t                                         [(rcode/register-hash img) 0])\n148\t                     body (some #(when (= pc (:start %)) %)\n149\t                                (:bodies (:segment attached)))]\n150\t                 (assoc attached\n151\t                        :pc pc :frames [] :continuation []\n152\t                        :registers (vec (repeat (:registers body) nil))\n153\t                        :halted? false :blocked? false :value nil)))})\n154\t\n155\t\n156\t(defn composition\n157\t  \"A task's composition over `modules` and the link `pair`.\"\n158\t  [modules pair]\n159\t  {:make-stream tu/make-stream,\n160\t   :capability-secret tu/secret,\n161\t   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n162\t   :primitives vm/primitives,\n163\t   :modules modules,\n164\t   :link-request (:requests pair),\n165\t   :link-response (:responses pair)})\n166\t\n167\t\n168\t(defn drive\n169\t  \"Run `task` and serve `pair` from `src` alternately until the task\n170\t   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n171\t  [task pair src]\n172\t  (loop [task (vm/run task)\n173\t         pair pair\n174\t         i 0]\n175\t    (if (and (vm/blocked? task) (< i 40))\n176\t      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n177\t        (recur (vm/run task) pair (inc i)))\n178\t      [task pair])))\n179\t\n180\t\n181\t(defn run-linked\n182\t  \"The finished task of the linked program `ast` on `backend`. Options:\n183\t   `:modules` (default the full registry), `:link-source` (default the\n184\t   `:trusted` composition over `py`), and `:prep`, applied to the task\n185\t   before it runs (a composition handing the task its streams, binding\n186\t   `pysp`'s signal stream among them). A refused link throws as the task's\n187\t   own error.\"\n188\t  ([backend ast] (run-linked backend ast {}))\n189\t  ([backend ast {:keys [modules link-source prep]}]\n190\t   (let [pair (link/make-pair)\n191\t         task ((get backends backend)\n192\t               ast\n193\t               (composition (or modules (registry)) pair))]\n194\t     (first (drive (if prep (prep task) task)\n195\t                   pair (or link-source (source)))))))\n196\t\n197\t\n198\t(defn runners-under\n199\t  \"Each vector VM's runner of a linked program over `modules`: the\n200\t   program's value.\"\n201\t  [modules]\n202\t  (into {}\n203\t        (map (fn [k]\n204\t               [k (fn [ast]\n205\t                    (vm/value (run-linked k ast {:modules modules})))]))\n206\t        (keys backends)))\n207\t\n208\t\n209\t(def runners\n210\t  \"The linked runners under the ordinary limits.\"\n211\t  (runners-under (registry)))"}
{"role":"tool","tool_call_id":"tool_nGoWG2laCLPm5ZY68YQGZ8G4","content":"585\t  \"The serving composition over py and every published guest module.\"\n586\t  []\n587\t  (let [a @published-guests]\n588\t    (h/source (into {'py (:address @h/published),\n589\t                     'yang.call (:call-address @h/published)}\n590\t                    (map (fn [[n a]] [(lower/module-symbol (name n)) a]))\n591\t                    a))))\n592\t\n593\t\n594\t(defn- outcome\n595\t  \"A finished run as `[halted? blocked? rendered-value]`.\"\n596\t  [task]\n597\t  [(vm/halted? task) (vm/blocked? task) (render/output (vm/value task))])\n598\t\n599\t\n600\t(defn- on-every-vm\n601\t  \"Every vector VM's `[halted? blocked? output]` for the linked program of\n602\t   `pk` over `src` (default `guest-source`), or the throw.\"\n603\t  ([pk] (on-every-vm pk (guest-source)))\n604\t  ([pk src]\n605\t   (into {}\n606\t         (map (fn [k]\n607\t                [k (try (outcome\n608\t                          (h/run-linked\n609\t                            k (lower/lower-packet pk {:prelude :linked})\n610\t                            {:link-source src}))\n611\t                        (catch #?(:cljd Object :clj Exception :cljs :default) e\n612\t                          [:thrown (ex-message e)]))]))\n613\t         (keys h/backends))))\n614\t\n615\t\n616\t(defn- every=\n617\t  [expected results]\n618\t  (doseq [[k result] results]\n619\t    (is (= expected result) (str k))))\n620\t\n621\t\n622\t(defn- import-orders-statements-test\n623\t  []\n624\t  (testing \"print(\\\"a\\\"); import m; print(\\\"b\\\") orders a, m's output, b\"\n625\t    (every= [true false {:py/out [\"a\" \"m-body\" \"b\"], :py/exception nil}]\n626\t            (on-every-vm programs/o-packet))))\n627\t\n628\t\n629\t(deftest ^:slow import-orders-statements-test-test\n630\t  (slow/guard \"import-orders-statements-test\" import-orders-statements-test))\n631\t\n632\t\n633\t(defn- second-import-does-not-re-execute-test\n634\t  []\n635\t  (testing \"a second import does not re-execute the body: the sys.modules\n636\t            hit answers; `import m; x = m.val; print(x)` reads 7 through\n637\t            the module object\"\n638\t    (every= [true false {:py/out [\"m-body\" \"done\"], :py/exception nil}]\n639\t            (on-every-vm programs/q-packet))\n640\t    (every= [true false {:py/out [\"m-body\" \"7\"], :py/exception nil}]\n641\t            (on-every-vm programs/d-packet))))\n642\t\n643\t\n644\t(deftest ^:slow second-import-does-not-re-execute-test-test\n645\t  (slow/guard \"second-import-does-not-re-execute-test\"\n646\t              second-import-does-not-re-execute-test))\n647\t\n648\t\n649\t(defn- module-dict-mutations-are-shared-test\n650\t  []\n651\t  (testing \"m.val = 5 and del m.y reach m's dict: m.__dict__ shows them\n652\t            and m's own functions read them\"\n653\t    (every= [true false {:py/out [\"m-body\" \"5\" \"absent\" \"('gone', 5)\"],\n654\t                         :py/exception nil}]\n655\t            (on-every-vm programs/c-packet))))\n656\t\n657\t\n658\t(deftest ^:slow module-dict-mutations-are-shared-test-test\n659\t  (slow/guard \"module-dict-mutations-are-shared-test\"\n660\t              module-dict-mutations-are-shared-test))\n661\t\n662\t\n663\t(defn- raising-body-removes-its-entry-test\n664\t  []\n665\t  (testing \"a raising body propagates to the importer's handler and\n666\t            removes its sys.modules entry -- the second attempt runs the\n667\t            body again\"\n668\t    (every= [true false {:py/out [\"w-once\" \"cleaned\" \"w-once\" \"again\"],\n669\t                         :py/exception nil}]\n670\t            (on-every-vm programs/r-packet))))\n671\t\n672\t\n673\t(deftest ^:slow raising-body-removes-its-entry-test-test\n674\t  (slow/guard \"raising-body-removes-its-entry-test\"\n675\t              raising-body-removes-its-entry-test))\n676\t\n677\t\n678\t(defn- importer-catches-imported-function-exception-test\n679\t  []\n680\t  (testing \"a handler in the importer catches an exception a function of\n681\t            the imported module raises, on every VM -- cross-module raise\n682\t            through the module boundary\"\n683\t    (every= [true false {:py/out [\"caught-e\"], :py/exception nil}]\n684\t            (on-every-vm programs/x-packet))))\n685\t\n686\t\n687\t(deftest ^:slow importer-catches-imported-function-exception-test-test\n688\t  (slow/guard \"importer-catches-imported-function-exception-test\"\n689\t              importer-catches-imported-function-exception-test))\n690\t\n691\t\n692\t(defn- one-image-two-names-test\n693\t  []\n694\t  (testing \"pym.n's own body, the one export the import runs, prints its\n695\t            module name when imported\"\n696\t    (every= [true false {:py/out [\"n\"], :py/exception nil}]\n697\t            (on-every-vm programs/nn-packet)))\n698\t  (testing \"the same body value run by py/run-main prints __main__: one\n699\t            code image, two roles\"\n700\t    (let [main (u/mark-tails\n701\t                 (u/seq-nodes\n702\t                   [(u/sexp->uast '(require (quote py)))\n703\t                    (u/sexp->uast '(require (quote pym.n)))\n704\t                    (u/sexp->uast '(py/init!))\n705\t                    (u/app (u/v 'py/run-main) (u/v 'pym.n/body))]))]\n706\t      (every= [true false {:py/out [\"__main__\"], :py/exception nil}]\n707\t              (into {}\n708\t                    (map (fn [k]\n709\t                           [k (try (outcome (h/run-linked\n710\t                                              k main\n711\t                                              {:link-source (guest-source)}))\n712\t                                   (catch #?(:cljd Object\n713\t                                             :clj Exception\n714\t                                             :cljs :default) e\n715\t                                     [:thrown (ex-message e)]))]))\n716\t                    (keys h/backends))))))\n717\t\n718\t\n719\t(deftest ^:slow one-image-two-names-test-test"}
