            (yang/compile-program '[1] true (assoc av-opts :macros #{m})))\ntest/yang/clojure_test.clj:1897:                 (try (yang/compile-program\ntest/yang/clojure_test.clj:1910:(def ^:private library-modules\ntest/yang/clojure_test.clj:1911:  \"The library's whole host surface: the `kind` module and the `portable`\ntest/yang/clojure_test.clj:1913:  (let [host (fn [registry module-name fns arities]\ntest/yang/clojure_test.clj:1914:               (module/register-host-module\ntest/yang/clojure_test.clj:1915:                 registry module-name fns\ntest/yang/clojure_test.clj:1917:                                 [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\ntest/yang/clojure_test.clj:1923:                                                          (get data/data-module op))])))\ntest/yang/clojure_test.clj:1925:    (-> av-modules\ntest/yang/clojure_test.clj:1926:        (host 'kind yang/kind-module yang/kind-arities)\ntest/yang/clojure_test.clj:1928:              (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\ntest/yang/clojure_test.clj:1933:  {:convention :arg-vector, :outcomes true\ntest/yang/clojure_test.clj:1935:   :native vm/primitive-profiles})\ntest/yang/clojure_test.clj:1941:  [ast modules lane step-limit]\ntest/yang/clojure_test.clj:1952:                                       :capability-secret tu/secret :modules modules})\ntest/yang/clojure_test.clj:1953:                  (tu/create-vm {:modules modules}))\ntest/yang/clojure_test.clj:1970:  [ast modules lane step-limit]\ntest/yang/clojure_test.clj:1971:  (vm/value (run-guest-machine ast modules lane step-limit)))\ntest/yang/clojure_test.clj:1984:   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\ntest/yang/clojure_test.clj:1985:                  library-modules lane step-limit)))\ntest/yang/clojure_test.clj:2010:  (testing \"collection predicates are derived from the data module's refusals\"\ntest/yang/clojure_test.clj:2027:  (testing \"symbol?, keyword?, name, symbol, keyword, str, int? are the kind module's\"\ntest/yang/clojure_test.clj:2063:            (yang/compile-program [form '(vec [1])] true library-opts))\ntest/yang/clojure_test.clj:2148:  (testing \"parameter and loop cursors stay raw when source rest returns outcomes\"\ntest/yang/clojure_test.clj:2193:          (yang/compile-program '[(apply f)] true library-opts)))))\ntest/yang/clojure_test.clj:2212:(deftest test-adapter-counts-from-profiles\ntest/yang/clojure_test.clj:2213:  (testing \"an adapter admits exactly the profile's fixed arities\"\ntest/yang/clojure_test.clj:2219:  (testing \"a variadic profile extends to the stated bound, not a magic 4\"\ntest/yang/clojure_test.clj:2256:(deftest test-portable-try-outcomes\ntest/yang/clojure_test.clj:2273:          (yang/compile-program [form] true library-opts)))))\ntest/yang/clojure_test.clj:2305:            \"a module fn is an admitted descriptor: the call goes through admission\"))"}
{"role":"tool","tool_call_id":"tool_PvUmdvpOxsLhlLzslA3xyhmI","content":"2040\t   `py/` exports, never a runtime key.\n2041\t\n2042\t   Guest imports deliver through try-require thunks at the executed\n2043\t   statement, after checking sys.modules. Only py is eagerly required;\n2044\t   an import-free unit's tree is unchanged. The program is __main__, a\n2045\t   packageless unit, so its relative imports raise. Imports need the linked\n2046\t   prelude -- a module closure's free reads never see the ambient store,\n2047\t   so a bundled importer's `py/*` definitions are invisible to an\n2048\t   imported body -- and a bundled unit holding any import statement but\n2049\t   a plain import of sys, builtins or importlib is refused. Literal\n2050\t   import_module calls that deliver guest modules need the linked profile.\"\n2051\t  ([packet] (lower-packet packet {}))\n2052\t  ([packet {:keys [prelude], :or {prelude :bundled}}]\n2053\t   (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n2054\t         main (app* 'py/run-main\n2055\t                    (u/lam [globals-sym globals-fn-sym]\n2056\t                           (lower-module-body packet)))]\n2057\t     (u/mark-tails\n2058\t       (case prelude\n2059\t         :bundled (if-not (preseeded-imports-only? pk)\n2060\t                    (throw (ex-info\n2061\t                             \"Imports need the linked prelude (docs/design/yang.antlr.md 8.5.6)\"\n2062\t                             {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n2063\t                              :construct \"import under the bundled prelude\"}))\n2064\t                    (u/then prelude/uast main))\n2065\t         :linked (u/seq-nodes\n2066\t                   [(app* 'require (u/lit 'yang.call))\n2067\t                    (app* 'require (u/lit prelude/module-name))\n2068\t                    (app* 'py/init!) main]))))))\n2069\t\n2070\t\n2071\t;; =============================================================================\n2072\t;; The module emitter: one Python unit as the linker module pym.<name>\n2073\t;; =============================================================================\n2074\t\n2075\t(def ^:private require-node core-module/require-node)\n2076\t\n2077\t\n2078\t(def module-exports\n2079\t  \"The exports of a compiled Python unit: its spec and body, immutable\n2080\t   after install (docs/design/yang.antlr.md 8.5.6's module shape).\"\n2081\t  '#{spec body})\n2082\t\n2083\t\n2084\t(defn- validate-module-name!\n2085\t  [name]\n2086\t  (when (or (empty? name)\n2087\t            (str/starts-with? name \".\")\n2088\t            (str/ends-with? name \".\")\n2089\t            (str/includes? name \"..\")\n2090\t            (str/includes? name \"$\"))\n2091\t    (throw (ex-info \"a module name is dotted identifiers\"\n2092\t                    {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n2093\t                     :construct \"malformed module name\",\n2094\t                     :name name}))))\n2095\t\n2096\t\n2097\t(defn module-packet\n2098\t  \"One ok packet as the linker module `pym.<mangled>`: one wide\n2099\t   application requiring `yang.call` first, then `py`, then defining spec\n2100\t   and body. Every Python body can call through `py/call-kw`, whose runtime\n2101\t   dispatch uses `yang.call`, so the dependency is unconditional. Guest\n2102\t   imports deliver at statement time; module-spec still pins every static\n2103\t   import. `name` is\n2104\t   the dotted Python module name and `package?` (default false) whether\n2105\t   the unit is a package, which is source layout, not derivable from\n2106\t   rows: the spec records both, the runtime derives `__package__` from\n2107\t   them, and the lowering resolves relative imports against them. The\n2108\t   body is the same form `lower-packet` runs as `__main__`: one code\n2109\t   image, two roles.\"\n2110\t  [packet {:keys [name package?]}]\n2111\t  (validate-module-name! name)\n2112\t  (let [unit {:name name, :package? (boolean package?)}\n2113\t        body (u/lam [globals-sym globals-fn-sym]\n2114\t                    (lower-module-body packet unit))\n2115\t        defs [(u/def! 'spec (u/lit unit)) (u/def! 'body body)]\n2116\t        operands (into [(require-node 'yang.call)\n2117\t                        (require-node prelude/module-name)] defs)\n2118\t        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n2119\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))\n2120\t\n2121\t\n2122\t(defn- declare-free-name\n2123\t  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n2124\t   when `covered` (the requirement-pinned module names) covers it.\"\n2125\t  [registry covered n]\n2126\t  (core-module/declare-free-name :yang.python.antlr/refusal\n2127\t                                 :yang.python.antlr/undeclared-free\n2128\t                                 registry covered n))\n2129\t\n2130\t\n2131\t(defn primitive-declaration\n2132\t  \"The `:primitives` profile free name `n` declares over `registry` (a bare\n2133\t   primitive's `vm/primitives` profile, or a host export's), as\n2134\t   `module-spec` declares it; throws on an undeclared name.\"\n2135\t  [registry n]\n2136\t  (second (declare-free-name registry #{} n)))\n2137\t\n2138\t\n2139\t(defn module-spec\n2140\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the Python module\n2141\t   `name` over the host registry `registry`, requiring `py` at\n2142\t   `py-address` and each imported module at its manifest address in\n2143\t   `deps` ({python-name address}). A free name of the module tree is\n2144\t   declared one of three ways, as the hook prelude's emitter declares\n2145\t   its own: a name qualified by `py` or by an imported `pym.<i>` is\n2146\t   covered by that requirement, discharged by a linked module of equal\n2147\t   manifest address; a bare name is a primitive declared by its\n2148\t   `vm/primitives` profile; any other `ns/name` is a host export\n2149\t   declared by the profile address the registry's host module `ns`\n2150\t   publishes. A free name none of these supplies is refused before\n2151\t   anything is published. `package?` is `module-packet`'s. This\n2152\t   namespace emits; it never publishes.\"\n2153\t  [registry packet {:keys [name package? py-address call-address deps]}]\n2154\t  (core-module/module-spec\n2155\t    :yang.python.antlr/refusal :yang.python.antlr/undeclared-free registry\n2156\t    {:name (module-symbol name),\n2157\t     :ast (module-packet packet {:name name, :package? package?}),\n2158\t     :exports module-exports,\n2159\t     :runtime-name prelude/module-name,\n2160\t     :runtime-address py-address,\n2161\t     :deps (assoc (into {} (map (fn [[n a]] [(module-symbol n) a])) deps)\n2162\t                  'yang.call call-address)}))\n2163\t\n2164\t\n2165\t(def ^:private module-tree core-module/module-tree)\n2166\t\n2167\t\n2168\t(def ^:private initializing-key :yang.python.antlr/initializing)\n2169\t\n2170\t\n2171\t(defn- cyclic-import-from\n2172\t  \"Preserve IMPORT_FROM's attribute/submodule fallback, specializing its\n2173\t   failure only while the target's task-local module object is initializing.\"\n2174\t  [m n]\n2175\t  (u/let1 '%from-module m\n2176\t          (u/let1 '%from-name n\n2177\t                  (u/let1 '%from-result (app* 'cell/new none)\n2178\t                          (app* 'py/try\n2179\t                                (u/lam [] (app* 'cell/set! (u/v '%from-result)\n2180\t                                                (app* 'py/import-from (u/v '%from-module) (u/v '%from-name))))\n2181\t                                (u/lam ['%from-error]\n2182\t                                       (u/if-node\n2183\t                                         (app* 'get (app* 'cell/get (u/v '%from-module))\n2184\t                                               (u/lit initializing-key) (u/lit false))\n2185\t                                         (app* 'py/import-fail\n2186\t                                               (app* 'py/str\n2187\t                                                     (app* 'data/str-concat\n2188\t                                                           (u/lit \"cannot import name '\")\n2189\t                                                           (app* 'get (u/v '%from-name) (u/lit :py/str))"}
{"role":"tool","tool_call_id":"tool_UWAXdXo6F4B7Oa8PAXSmqOzY","content":"3710\t  \"The module's exports: every `py/` key of the definition list,\n3711\t   stripped. The runtime keys and the state slot are internal.\"\n3712\t  (core/exports \"py\" definitions))\n3713\t\n3714\t\n3715\t(def free-names\n3716\t  \"Every variable name some occurrence of the map AST reads unbound by an\n3717\t   enclosing lambda.\"\n3718\t  core/free-names)\n3719\t\n3720\t\n3721\t(def defined-keys\n3722\t  \"Every literal key the map AST defines with `yin/def`, at any depth.\"\n3723\t  core/defined-keys)\n3724\t\n3725\t\n3726\t(def ^:private module-free-names\n3727\t  \"The names the module tree reads and does not define, sorted: the\n3728\t   primitives and the host exports its manifest must declare.\"\n3729\t  (core/free-name-vec module-uast))\n3730\t\n3731\t\n3732\t(defn module-spec\n3733\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `py`\n3734\t   over the host registry `registry`. Every free name of the module tree\n3735\t   is declared under `:primitives`; a free name nothing supplies is\n3736\t   refused before anything is published. This namespace emits; it never\n3737\t   publishes.\"\n3738\t  [registry call-address]\n3739\t  (core/module-spec {:module-name module-name,\n3740\t                     :ast module-uast,\n3741\t                     :exports module-exports,\n3742\t                     :requires {'yang.call call-address},\n3743\t                     :free-names module-free-names,\n3744\t                     :skip? #(= \"yang.call\" (namespace %)),\n3745\t                     :registry registry,\n3746\t                     :message \"the py module reads an undeclared name\",\n3747\t                     :refusal-ns \"yang.python.antlr\"}))\n3748\t\n3749\t\n3750\t(def min-integer-bits\n3751\t  \"The smallest `::integer/max-bits` this profile admits: every inline\n3752\t   literal (up to 2^53 - 1) must fit (C3 S2).\"\n3753\t  53)\n3754\t\n3755\t\n3756\t(defn register-integer-module\n3757\t  \"Return `registry` with the `integer` module installed under `limits`\n3758\t   for this profile: refused when `::integer/max-bits` is under\n3759\t   `min-integer-bits`, otherwise `integer/register-integer-module`.\"\n3760\t  [registry limits]\n3761\t  (let [b (::integer/max-bits limits)]\n3762\t    (when-not (and (int? b) (<= min-integer-bits b))\n3763\t      (throw (ex-info \"the Python profile needs integer max-bits >= 53\"\n3764\t                      {:yang.python.antlr/refusal :yang.python.antlr/max-bits,\n3765\t                       ::integer/max-bits b}))))\n3766\t  (integer/register-integer-module registry limits))\n3767\t\n3768\t\n3769\t(defn admit\n3770\t  \"Return `registry` when it supplies every one of `host-names`, else\n3771\t   refuse it before any program runs, naming each missing export in\n3772\t   `:yang.python.antlr/missing`: a version-3 `integer` module (no\n3773\t   `float-digits`, `decimal->float`, `max-digits`) or a `data` module\n3774\t   registered without `:yin.vm.data/max-items` is a profile mismatch, not a\n3775\t   failure of the program that first calls the export. A Python\n3776\t   composition calls this after its registrars. Linking replaces it with\n3777\t   requirement discovery (yang.antlr.md 8.5.4).\"\n3778\t  [registry]\n3779\t  (core/admit registry host-names\n3780\t              \"the composition lacks host names the prelude calls\"\n3781\t              \"yang.python.antlr\"))"}
{"role":"tool","tool_call_id":"tool_N6FFnzCwAve40yYN0GUbwMgb","content":"3070\t           (cell/new (assoc (assoc (assoc {} :py/type :module) :name name) :dict d))))]\n3071\t    [py/module-dict (fn [m] (get (cell/get m) :dict))]\n3072\t    [py/module-new\n3073\t     ;; a fresh module object carrying the standard dunders (8.5.6):\n3074\t     ;; __name__ and __package__ as given, __spec__ and __loader__ None;\n3075\t     ;; __file__ is absent. `name` a py str, `package` a py str or None\n3076\t     (fn [name package]\n3077\t       (let [d (py/dict-new)]\n3078\t         (do (py/dict-set d {:py/str \"__name__\"} name)\n3079\t             (py/dict-set d {:py/str \"__package__\"} package)\n3080\t             (py/dict-set d {:py/str \"__spec__\"} :py/None)\n3081\t             (py/dict-set d {:py/str \"__loader__\"} :py/None)\n3082\t             (py/module-of (get name :py/str) d))))]\n3083\t    [py/modules-ref\n3084\t     ;; sys.modules[name]: the module object, or :py/missing\n3085\t     (fn [name]\n3086\t       (let [c (cell/get py.rt/modules)\n3087\t             slot (get (get c :index) (py/key name) :py/missing)]\n3088\t         (if (= slot :py/missing)\n3089\t           :py/missing\n3090\t           (get (get c :vals) slot))))]\n3091\t    [py/modules-put!\n3092\t     (fn [name m] (do (py/dict-set py.rt/modules name m) :py/None))]\n3093\t    [py/modules-del!\n3094\t     (fn [name] (py/dict-del-quiet py.rt/modules name))]\n3095\t    [py/module-run\n3096\t     ;; instantiate the module `name` (a py str) from `body`: the object\n3097\t     ;; is created and inserted into sys.modules BEFORE the body runs, so\n3098\t     ;; an import the body itself makes finds the partial module, and a\n3099\t     ;; raising body removes the entry again and re-raises to the\n3100\t     ;; importer; the module object is the value\n3101\t     (fn [name package body]\n3102\t       (let [m (py/module-new name package)\n3103\t             d (py/module-dict m)]\n3104\t         (do (cell/set! m (