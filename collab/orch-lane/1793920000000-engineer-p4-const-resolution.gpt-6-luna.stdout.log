efn gpu-available?\\n  \\\"True when Flutter GPU (Impeller) exposes a context AND the device is not an\\n   emulator or simulator.  Emulators run Impeller through software Vulkan\\n   (Swiftshader), which satisfies context creation but silently fails to render\\n   custom mesh pipelines — so we exclude them via synchronous detection.\\\"\\n  []\\n  (and (some? gpu/gpuContext) (not (is-emulator?))))\\n\\n\\n(defn- install-gpu-state!\\n  [^gpu/GpuContext ctx ^gpu/ShaderLibrary lib]\\n  (let [vert (. lib \\\"[]\\\" \\\"SimpleVertex\\\")\\n        frag (. lib \\\"[]\\\" \\\"SimpleFragment\\\")]\\n    (if (and vert frag)\\n      (let [pipeline (.createRenderPipeline ctx vert frag)\\n            white-texture (let [bytes (type/ByteData. 4)]\\n                            (.setUint8 bytes 0 255)\\n                            (.setUint8 bytes 1 255)\\n                            (.setUint8 bytes 2 255)\\n                            (.setUint8 bytes 3 255)\\n                            (let [texture (.createTexture\\n                                            ctx\\n                                            gpu/StorageMode.hostVisible\\n                                            1\\n                                            1)]\\n                              (.overwrite texture bytes)\\n                              texture))]\\n        (swap! gpu-state assoc\\n               :context ctx\\n               :pipeline pipeline\\n               :host-buffer (.createHostBuffer ctx)\\n               :white-texture white-texture))\\n      (dart/print \\\"GPU shaders not found in bundle.\\\"))))\\n\\n\\n(defn- init-gpu!\\n  \\\"Idempotently kicks off GPU pipeline setup. `ShaderLibrary.fromAsset`\\n   returns a `Future<ShaderLibrary?>` (not the synchronous value earlier\\n   Flutter GPU versions returned), so this cannot populate `gpu-state`\\n   before returning: every caller (`create-rgba-texture!`, `submit-gpu!`)\\n   already tolerates a still-nil `:context` — the former via its `when\\n   context` guard, the latter by rejecting the frame — so callers made\\n   during the load window simply see \\\\\\\"not ready yet\\\\\\\" and later calls,\\n   once the future resolves, see the real state. `gpu-init-inflight?`\\n   guards against firing the asset load again on every frame while one is\\n   already in progress; it is cleared on both success and failure so a\\n   transient failure (or a first call before the engine is fully up) is\\n   retried on the next frame, matching this function's prior behavior of\\n   retrying every call until `:context` is set.\\\"\\n  []\\n  (when (and (not (:context @gpu-state)) (not @gpu-init-inflight?))\\n    (let [ctx gpu/gpuContext]\\n      (if (nil? ctx)\\n        (dart/print \\\"Flutter GPU is not available on this device.\\\")\\n        (do\\n          (reset! gpu-init-inflight? true)\\n          (-> ^async/Future (gpu/ShaderLibrary.fromAsset\\n                              \\\"assets/shaders/simple_mesh.shaderbundle\\\")\\n              (.then (fn [lib]\\n                       (reset! gpu-init-inflight? false)\\n                       (if (nil? lib)\\n                         (dart/print \\\"Failed to load shader library\\\")\\n                         (install-gpu-state! ctx lib))))\\n              (.catchError (fn [e]\\n                             (reset! gpu-init-inflight? false)\\n                             (dart/print\\n                               (str \\\"Failed to load GPU shaders: \\\" e))))))))))\\n\\n\\n(defn- render-mesh-gpu!\\n  [^gpu/RenderPass pass draw ^gpu/RenderPipeline pipeline\\n   ^gpu/HostBuffer host-buffer]\\n  (let [{:keys [op]} draw\\n        verts (:vertices op)\\n        indices (:indices op)\\n        pg-tex (:texture/source op)\\n        texture (or (when (instance? tex/PgTexture pg-tex)\\n                      (.-gpu ^tex/PgTexture pg-tex))\\n                    (:white-texture @gpu-state))\\n        sampler (sampler-options op)\\n        v-data (vertices->float32-list op)\\n        ^type/Uint16List i-data (indices->uint16-list indices 3)\\n        ;; Upload vertex and index data via HostBuffer\\n        v-view (.emplace host-buffer (.asByteData (.-buffer v-data)))\\n        i-view (.emplace host-buffer (.asByteData (.-buffer i-data)))\\n        ;; Vertex-stage matrices + fragment-stage lighting, both packed by\\n        ;; the shared software helpers so the GLSL shader lights exactly\\n        ;; like the\\n        ;; CPU path.\\n        u-view (floats->view host-buffer (pack/packed-vertex-uniforms draw))\\n        f-view (floats->view host-buffer (pack/packed-lighting-block draw))\\n        vert-shader (.-vertexShader pipeline)\\n        frag-shader (.-fragmentShader pipeline)\\n        u-slot (.getUniformSlot vert-shader \\\"Uniforms\\\")\\n        frag-slot (.getUniformSlot frag-shader \\\"Frag\\\")\\n        tex-slot (.getUniformSlot frag-shader \\\"tex\\\")]\\n    (.bindPipeline pass pipeline)\\n    (.setPrimitiveType pass gpu/PrimitiveType.triangle)\\n    (.bindVertexBuffer pass v-view)\\n    (.bindIndexBuffer pass i-view gpu/IndexType.int16)\\n    (.bindUniform pass u-slot u-view)\\n    (.bindUniform pass frag-slot f-view)\\n    (.bindTexture pass tex-slot texture .sampler sampler)\\n    (.drawIndexed pass (.-length i-data))))\\n\\n\\n\\n(defn- render-lines-gpu!\\n  \\\"Renders a :draw3d/lines op as a GPU line list. Reuses the textured-mesh\\n   shader by binding the 1x1 white texture and a per-op constant vertex\\n   color, so the lit fragment becomes (1,1,1,1) * color. setPrimitiveType\\n   is set on every draw because RenderPass topology is sticky and could\\n   leak from a prior lines/triangles draw in the same pass.\\\"\\n  [^gpu/RenderPass pass draw ^gpu/RenderPipeline pipeline\\n   ^gpu/HostBuffer host-buffer]\\n  (let [;; lines are unlit and single-coloured; the shared collapse forces\\n        ;; lighting off and feeds :color through :fill for every vertex.\\n        line-draw (pack/unlit-line-draw draw)\\n        line-op (:op line-draw)\\n        verts (:vertices line-op)\\n        edges (:edges line-op)\\n        texture (:white-texture @gpu-state)\\n        sampler (sampler-options line-op)\\n        v-data (vertices->float32-list line-op)\\n        ^type/Uint16List i-data (indices->uint16-list edges 2)\\n        v-view (.emplace host-buffer (.asByteData (.-buffer v-data)))\\n        i-view (.emplace host-buffer (.asByteData (.-buffer i-data)))\\n        u-view (floats->view host-buffer\\n                             (pack/packed-vertex-uniforms line-draw))\\n        f-view (floats->view host-buffer (pack/packed-lighting-block line-draw))\\n        vert-shader (.-vertexShader pipeline)\\n        frag-shader (.-fragmentShader pipeline)\\n        u-slot (.getUniformSlot vert-shader \\\"Uniforms\\\")\\n        frag-slot (.getUniformSlot frag-shader \\\"Frag\\\")\\n        tex-slot (.getUniformSlot frag-shader \\\"tex\\\")]\\n    (.bindPipeline pass pipeline)\\n    (.setPrimitiveType pass gpu/PrimitiveType.line)\\n    (.bindVertexBuffer pass v-view)\\n    (.bindIndexBuffer pass i-view gpu/IndexType.int16)\\n    (.bindUniform pass u-slot u-view)\\n    (.bindUniform pass frag-slot f-view)\\n    (.bindTexture pass tex-slot texture .sampler sampler)\\n    (.drawIndexed pass (.-length i-data))))\\n\\n\\n(defn- gpu-supported-draw?\\n  \\\"True when a lowered draw is one this Flutter renderer can paint — either\\n   directly via Flutter GPU (clear, camera-reset, mesh-3d, draw-3d) or via\\n   the 2D Canvas overlay in PostgraphicsPainter (draw-2d, text). The name\\n   is historical; reject-non-gpu-draws! is really 'reject unrenderable\\n   draws'.\\\"\\n  [draw]\\n  (case (:pipeline draw)\\n    (:clear :camera-reset :mesh-3d :line-3d :draw-2d :text) true\\n    :draw-3d (contains? #{:draw3d/triangles :draw3d/lines}\\n                        (get-in draw [:op :op/kind]))\\n    false))\\n\\n\\n(defn- reject-non-gpu-draws!\\n  [lowered]\\n  (when-let [draw (some (fn [pass]\\n                          (some (fn [draw]\\n                                  (when-not (gpu-supported-draw? draw) draw))\\n                                (:draws pass)))\\n                        (:passes lowered))]\\n    (v/reject! :unsupported-op\\n               (str \\\"Flutter GPU renderer does not support pipeline \\\" (:pipeline\\n                                                                        draw)\\n                    \\\"; add a Flutter GPU pipeline for this op instead of \\\"\\n                    \\\"falling back to Canvas\\\"))))\\n\\n\\n(defn submit-gpu!\\n  [lowered ^double width ^double height]\\n  (reject-non-gpu-draws! lowered)\\n  (init-gpu!)\\n  (let [state @gpu-state\\n        ^gpu/GpuContext context (:context state)\\n        ^gpu/RenderPipeline pipeline (:pipeline state)\\n        ^gpu/HostBuffer host-buffer (:host-buffer state)]\\n    (if (and context pipeline host-buffer)\\n      (let [clear-col (pack/clear-color lowered)\\n            ^double r (double (nth clear-col 0))\\n            ^double g (double (nth clear-col 1))\\n            ^double b (double (nth clear-col 2))\\n            ^double a (double (or (nth clear-col 3) 1.0))\\n            ^gpu/CommandBuffer command-buffer (.createCommandBuffer context)\\n            ^gpu/Texture texture (.createTexture context\\n                                                 gpu/StorageMode.devicePrivate\\n                                                 (int width)\\n                                                 (int height))\\n            ^gpu/Texture depth-texture (.createTexture\\n                                         context\\n                                         gpu/StorageMode.devicePrivate\\n                                         (int width)\\n                                         (int height)\\n                                         .format\\n                                         gpu/PixelFormat.d24UnormS8Uint)\\n            render-target (gpu/RenderTarget.singleColor\\n                            (gpu/ColorAttachment. .texture\\n                                                  texture\\n                                                  .clearValue\\n                                                  (vm32/Vector4. r g b a)\\n                                                  .loadAction\\n                                                  gpu/LoadAction.clear\\n                                                  .storeAction\\n                                                  gpu/StoreAction.store)\\n                            .depthStencilAttachment\\n                            (gpu/DepthStencilAttachment.\\n                              .texture\\n                              depth-texture\\n                              .depthLoadAction\\n                              gpu/LoadAction.clear\\n                              .depthStoreAction\\n                              gpu/StoreAction.dontCare\\n                              .depthClearValue\\n                              1.0))\\n            ^gpu/RenderPass render-pass (.createRenderPass command-buffer\\n                                                           render-target)]\\n        (.setDepthCompareOperation render-pass gpu/CompareFunction.less)\\n        (.setDepthWriteEnable render-pass true)\\n        (.reset host-buffer)\\n        ;; TODO: implement other pipelines (clear, text, 2D)\\n        (doseq [pass (:passes lowered)\\n                draw (:draws pass)]\\n          (case (:pipeline draw)\\n            :mesh-3d (render-mesh-gpu! render-pass draw pipeline host-buffer)\\n            :line-3d (render-lines-gpu! render-pass draw pipeline host-buffer)\\n            :draw-3d\\n            (case (get-in draw [:op :op/kind])\\n              :draw3d/triangles\\n              (render-mesh-gpu! render-pass draw pipeline host-buffer)\\n              :draw3d/lines\\n              (render-lines-gpu! render-pass draw pipeline host-buffer)\\n              nil)\\n            ni