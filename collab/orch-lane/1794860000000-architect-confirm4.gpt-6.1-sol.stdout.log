ion\\\\n    12\\\\t   (or `:departure/:zend` for departure fixtures).\\\\\\\"\\\\n    13\\\\t  (:require\\\\n    14\\\\t    [clojure.java.io :as io]\\\\n    15\\\\t    [clojure.java.shell :as sh]\\\\n    16\\\\t    [clojure.string :as str]\\\\n    17\\\\t    [yang.php.antlr.programs :as programs]\\\\n    18\\\\t    [yang.php.antlr.programs-p3b :as p3b]\\\\n    19\\\\t    [yang.php.antlr.programs-p4 :as p4]\\\\n    20\\\\t    [yang.php.antlr.programs-p5 :as p5]\\\\n    21\\\\t    [yang.php.antlr.programs-p6 :as p6])\\\\n    22\\\\t  (:import\\\\n    23\\\\t    (java.nio.charset\\\\n    24\\\\t      StandardCharsets)\\\\n    25\\\\t    (java.nio.file\\\\n    26\\\\t      Files)\\\\n    27\\\\t    (java.nio.file.attribute\\\\n    28\\\\t      FileAttribute)))\\\\n    29\\\\t\\\\n    30\\\\t\\\\n    31\\\\t(def banner\\\\n    32\\\\t  \\\\\\\"The pinned PHP 8.3 CLI oracle provenance banner.\\\\\\\"\\\\n    33\\\\t  p3b/banner)\\\\n    34\\\\t\\\\n    35\\\\t\\\\n    36\\\\t(def ^:private errno-of\\\\n    37\\\\t  {\\\\\\\"Warning\\\\\\\" 2,\\\\n    38\\\\t   \\\\\\\"Notice\\\\\\\" 8,\\\\n    39\\\\t   \\\\\\\"Deprecated\\\\\\\" 8192,\\\\n    40\\\\t   \\\\\\\"Fatal error\\\\\\\" 1})\\\\n    41\\\\t\\\\n    42\\\\t\\\\n    43\\\\t(defn- location-pattern\\\\n    44\\\\t  \\\\\\\"The regex source of a PHP source location below `/w/`: the entry `file`\\\\n    45\\\\t   itself, or, for a multi-unit fixture run in `/w/<unit-dir>`, any unit file\\\\n    46\\\\t   below the directory.\\\\\\\"\\\\n    47\\\\t  [file unit-dir]\\\\n    48\\\\t  (if unit-dir\\\\n    49\\\\t    (str (java.util.regex.Pattern/quote unit-dir) \\\\\\\"/[^\\\\\\\\\\\\\\\\s:]+\\\\\\\")\\\\n    50\\\\t    (java.util.regex.Pattern/quote file)))\\\\n    51\\\\t\\\\n    52\\\\t\\\\n    53\\\\t(defn- strip-location\\\\n    54\\\\t  ([s file] (strip-location s file nil))\\\\n    55\\\\t  ([s file unit-dir]\\\\n    56\\\\t   (str/replace s\\\\n    57\\\\t                (re-pattern (str \\\\\\\" in /w/\\\\\\\" (location-pattern file unit-dir) \\\\\\\" on line \\\\\\\\\\\\\\\\d+\\\\\\\"))\\\\n    58\\\\t                \\\\\\\"\\\\\\\")))\\\\n    59\\\\t\\\\n    60\\\\t\\\\n    61\\\\t(defn parse-stdout\\\\n    62\\\\t  \\\\\\\"Parse PHP CLI stdout for `/w/<file>` into\\\\n    63\\\\t   `{:out <string> :diag [[errno msg] ...] :uncaught {:class c :message m}-or-nil}`.\\\\n    64\\\\t   With `unit-dir`, locations in any file below `/w/<unit-dir>` are stripped\\\\n    65\\\\t   (a multi-unit fixture).\\\\\\\"\\\\n    66\\\\t  ([raw file] (parse-stdout raw file nil))\\\\n    67\\\\t  ([raw file unit-dir]\\\\n    68\\\\t   (let [qfile (location-pattern file unit-dir)\\\\n    69\\\\t         strip-location (fn [s file] (strip-location s file unit-dir))\\\\n    70\\\\t         ;; The uncaught block ends at PHP's own terminator, so output written\\\\n    71\\\\t         ;; after it (shutdown functions, destructors) stays in :out.\\\\n    72\\\\t         uncaught-re (re-pattern\\\\n    73\\\\t                       (str \\\\\\\"(?s)\\\\\\\\\\\\\\\\nFatal error: Uncaught ([^:]+): ([^\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n]*) in /w/\\\\\\\"\\\\n    74\\\\t                            qfile\\\\n    75\\\\t                            \\\\\\\":\\\\\\\\\\\\\\\\d+\\\\\\\\\\\\\\\\nStack trace:\\\\\\\\\\\\\\\\n.*?\\\\\\\\\\\\\\\\n  thrown in /w/\\\\\\\"\\\\n    76\\\\t                            qfile\\\\n    77\\\\t                            \\\\\\\" on line \\\\\\\\\\\\\\\\d+\\\\\\\\\\\\\\\\n\\\\\\\"))\\\\n    78\\\\t         fatal-re (re-pattern\\\\n    79\\\\t                    (str \\\\\\\"\\\\\\\\\\\\\\\\nFatal error: ([^\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n]*) in /w/\\\\\\\"\\\\n    80\\\\t                         qfile\\\\n    81\\\\t                         \\\\\\\" on line \\\\\\\\\\\\\\\\d+\\\\\\\\\\\\\\\\n\\\\\\\"))\\\\n    82\\\\t         diag-re (re-pattern\\\\n    83\\\\t                   (str \\\\\\\"\\\\\\\\\\\\\\\\n(Warning|Notice|Deprecated): ([^\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\n]*?) in /w/\\\\\\\"\\\\n    84\\\\t                        qfile\\\\n    85\\\\t                        \\\\\\\" on line \\\\\\\\\\\\\\\\d+\\\\\\\\\\\\\\\\n\\\\\\\"))\\\\n    86\\\\t         [without-fatal uncaught]\\\\n    87\\\\t         (if-let [[_ cls msg] (re-find uncaught-re raw)]\\\\n    88\\\\t           [(str/replace raw uncaught-re \\\\\\\"\\\\\\\")\\\\n    89\\\\t            {:class cls, :message (strip-location msg file)}]\\\\n    90\\\\t           (if-let [[_ msg] (re-find fatal-re raw)]\\\\n    91\\\\t             [(str/replace raw fatal-re \\\\\\\"\\\\\\\")\\\\n    92\\\\t              {:class \\\\\\\"Error\\\\\\\", :message (strip-location msg file)}]\\\\n    93\\\\t             [raw nil]))\\\\n    94\\\\t         diags (volatile! [])\\\\n    95\\\\t         out (str/replace without-fatal\\\\n    96\\\\t                          diag-re\\\\n    97\\\\t                          (fn [[_ kind msg]]\\\\n    98\\\\t                            (vswap! diags conj [(get errno-of kind) (strip-location msg file)])\\\\n    99\\\\t                            \\\\\\\"\\\\\\\"))]\\\\n   100\\\\t     {:out out,\\\\n   101\\\\t      :diag @diags,\\\\n   102\\\\t      :uncaught uncaught})))\\\\n   103\\\\t\\\\n   104\\\\t\\\\n   105\\\\t(defn run-php-file\\\\n   106\\\\t  \\\\\\\"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` and return the parsed\\\\n   107\\\\t   `{:out :diag :uncaught :exit}`. With `unit-dir`, the working directory is\\\\n   108\\\\t   `/w/<unit-dir>` and `file` is relative to it (a multi-unit fixture).\\\\\\\"\\\\n   109\\\\t  ([dir file] (run-php-file dir file nil))\\\\n   110\\\\t  ([dir file unit-dir]\\\\n   111\\\\t   (let [{:keys [out err exit]}\\\\n   112\\\\t         (sh/sh \\\\\\\"docker\\\\\\\" \\\\\\\"run\\\\\\\" \\\\\\\"--rm\\\\\\\"\\\\n   113\\\\t                \\\\\\\"-v\\\\\\\" (str (.toAbsolutePath (.toPath (io/file dir))) \\\\\\\":/w\\\\\\\")\\\\n   114\\\\t                \\\\\\\"-w\\\\\\\" (if unit-dir (str \\\\\\\"/w/\\\\\\\" unit-dir) \\\\\\\"/w\\\\\\\")\\\\n   115\\\\t                \\\\\\\"php:8.3-cli\\\\\\\" \\\\\\\"php\\\\\\\"\\\\n   116\\\\t                \\\\\\\"-d\\\\\\\" \\\\\\\"display_errors=1\\\\\\\"\\\\n   117\\\\t                \\\\\\\"-d\\\\\\\" \\\\\\\"html_errors=0\\\\\\\"\\\\n   118\\\\t                \\\\\\\"-d\\\\\\\" \\\\\\\"error_reporting=E_ALL\\\\\\\"\\\\n   119\\\\t                \\\\\\\"-d\\\\\\\" \\\\\\\"log_errors=0\\\\\\\"\\\\n   120\\\\t                file\\\\n   121\\\\t                :out-enc \\\\\\\"UTF-8\\\\\\\")]\\\\n   122\\\\t     (assoc (parse-stdout out (if unit-dir (str unit-dir \\\\\\\"/\\\\\\\" file) file) unit-dir)\\\\n   123\\\\t            :err err\\\\n   124\\\\t            :exit exit))))\\\\n   125\\\\t\\\\n   126\\\\t\\\\n   127\\\\t(defn- write-source!\\\\n   128\\\\t  [dir file ^String source]\\\\n   129\\\\t  (Files/write (.toPath (io/file dir file))\\\\n   130\\\\t               (.getBytes source StandardCharsets/UTF_8)\\\\n   131\\\\t               (make-array java.nio.file.OpenOption 0)))\\\\n   132\\\\t\\\\n   133\\\\t\\\\n   134\\\\t(defn- unit-actual\\\\n   135\\\\t  \\\\\\\"Run the multi-unit `fixture`: every unit is written below `<dir>/<id>/`,\\\\n   136\\\\t   `main.php` is run with that directory as the working directory, and\\\\n   137\\\\t   `/w/<id>` is replaced by `.` in everything the program printed (the\\\\n   138\\\\t   comparison's definition, plan P6 2.5 rule 2; corner C37).\\\\\\\"\\\\n   139\\\\t  [dir {:keys [id units main], :or {main \\\\\\\"main.php\\\\\\\"}}]\\\\n   140\\\\t  (let [unit-dir (name id)\\\\n   141\\\\t        norm (fn [s] (str/replace s (str \\\\\\\"/w/\\\\\\\" unit-dir) \\\\\\\".\\\\\\\"))]\\\\n   142\\\\t    (doseq [[path source] units]\\\\n   143\\\\t      (let [f (io/file dir unit-dir path)]\\\\n   144\\\\t        (io/make-parents f)\\\\n   145\\\\t        (write-source! dir (str unit-dir \\\\\\\"/\\\\\\\" path) source)))\\\\n   146\\\\t    (let [actual (run-php-file dir main unit-dir)]\\\\n   147\\\\t      (-> actual\\\\n   148\\\\t          (update :out norm)\\\\n   149\\\\t          (update :diag (fn [ds] (mapv (fn [[errno msg]] [errno (norm msg)]) ds)))\\\\n   150\\\\t          (update :uncaught #(some-> % (update :message norm)))))))\\\\n   151\\\\t\\\\n   152\\\\t\\\\n   153\\\\t(defn check-fixture\\\\n   154\\\\t  \\\\\\\"Run `fixture` in temporary directory `dir` and return a check record.\\\\\\\"\\\\n   155\\\\t  [dir {:keys [id source units out diag uncaught departure gap oracle], :as fixture}]\\\\n   156\\\\t  (let [file (str (name id) \\\\\\\".php\\\\\\\")]\\\\n   157\\\\t    (when-not units (write-source! dir file source))\\\\n   158\\\\t    (let [actual (if units (unit-actual dir fixture) (run-php-file dir file))\\\\n   159\\\\t          expected-out (cond departure (:zend departure)\\\\n   160\\\\t                             gap \\\\\\\"\\\\\\\"\\\\n   161\\\\t                             :else out)\\\\n   162\\\\t          expected-diag (vec (cond departure (:zend-diag departure)\\\\n   163\\\\t                                   gap []\\\\n   164\\\\t                                   :else (or diag [])))\\\\n   165\\\\t          expected-uncaught (cond departure (:zend-uncaught departure)\\\\n   166\\\\t                                  gap nil\\\\n   167\\\\t                                  :else uncaught)\\\\n   168\\\\t          pass? (and (not= :pending oracle)\\\\n   169\\\\t                     (= expected-out (:out actual))\\\\n   170\\\\t                     (= expected-diag (:diag actual))\\\\n   171\\\\t                     (= expected-uncaught (:uncaught actual)))]\\\\n   172\\\\t      {:id id,\\\\n   173\\\\t       :pass? pass?,\\\\n   174\\\\t       :oracle oracle,\\\\n   175\\\\t       :gap gap,\\\\n   176\\\\t       :departure departure,\\\\n   177\\\\t       :expected {:out expected-out, :diag expected-diag, :uncaught expected-uncaught},\\\\n   178\\\\t       :actual (select-keys actual [:out :diag :uncaught])})))\\\\n   179\\\\t\\\\n   180\\\\t\\\\n   181\\\\t(defn- check-matrix\\\\n   182\\\\t  [dir]\\\\n   183\\\\t  (let [file \\\\\\\"scalar-comparison-matrix.php\\\\\\\"\\\\n   184\\\\t        _ (write-source! dir file programs/matrix-source)\\\\n   185\\\\t        actual (run-php-file dir file)\\\\n   186\\\\t        [eq sp] (str/split-lines (:out actual))\\\\n   187\\\\t        w (count programs/matrix-values)\\\\n   188\\\\t        actual-eq (mapv #(apply str %) (partition w eq))\\\\n   189\\\\t        actual-sp (mapv #(apply str (map {\\\\\\\\0 \\\\\\\"<\\\\\\\", \\\\\\\\1 \\\\\\\"=\\\\\\\", \\\\\\\\2 \\\\\\\">\\\\\\\"} %)) (partition w sp))]\\\\n   190\\\\t    {:id :scalar-comparison-matrix,\\\\n   191\\\\t     :pass? (and (= programs/equal-matrix actual-eq)\\\\n   192\\\\t                 (= programs/spaceship-matrix actual-sp)\\\\n   193\\\\t                 (empty? (:diag actual))\\\\n   194\\\\t                 (nil? (:uncaught actual))),\\\\n   195\\\\t     :expected {:eq programs/equal-matrix, :sp programs/spaceship-matrix},\\\\n   196\\\\t     :actual {:eq actual-eq, :sp actual-sp, :diag (:diag actual), :uncaught (:uncaught actual)}}))\\\\n   197\\\\t\\\\n   198\\\\t\\\\n   199\\\\t(defn- check-floats\\\\n   200\\\\t  [dir]\\\\n   201\\\\t  (let [file \\\\\\\"float-cases.php\\\\\\\"\\\\n   202\\\\t        src (str \\\\\\\"<?php\\\\\\\\n\\\\\\\"\\\\n   203\\\\t                 (apply str (for [[lit] programs/float-cases]\\\\n   204\\\\t                              (str \\\\\\\"echo \\\\\\\" lit \\\\\\\", \\\\\\\\\\\\\\\"|\\\\\\\\\\\\\\\"; var_dump(\\\\\\\" lit \\\\\\\");\\\\\\\\n\\\\\\\"))))\\\\n   205\\\\t        expected (apply str (for [[_ echo dump] programs/float-cases]\\\\n   206\\\\t                              (str echo \\\\\\\"|float(\\\\\\\" dump \\\\\\\")\\\\\\\\n\\\\\\\")))\\\\n   207\\\\t        _ (write-source! dir file src)\\\\n   208\\\\t        actual (run-php-file dir file)]\\\\n   209\\\\t    {:id :float-cases,\\\\n   210\\\\t     :pass? (and (= expected (:out actual))\\\\n   211\\\\t                 (empty? (:diag actual))\\\\n   212\\\\t                 (nil? (:uncaught actual))),\\\\n   213\\\\t     :expected {:out expected, :diag [], :uncaught nil},\\\\n   214\\\\t     :actual (select-keys actual [:out :diag :uncaught])}))\\\\n   215\\\\t\\\\n   216\\\\t\\\\n   217\\\\t(defn- php-literal\\\\n   218\\\\t  \\\\\\\"The PHP literal of request-record scalar `v`: strings single-quoted\\\\n   219\\\\t   (escaping backslash and quote, the only two escapes there), ints bare.\\\\n   220\\\\t   Key coercion (numeric strings to ints) is left to PHP itself, exactly as\\\\n   221\\\\t   the engine's `php/array-key` performs it.\\\\\\\"\\\\n   222\\\\t  [v]\\\\n   223\\\\t  (cond (string? v) (str \\\\\\\"'\\\\\\\" (str/replace v #\\\\\\\"\\\\\\\\\\\\\\\\|'\\\\\\\" (fn [[c]] (str \\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\" c))) \\\\\\\"'\\\\\\\")\\\\n   224\\\\t        (integer? v) (str v)\\\\n   225\\\\t        :else (throw (ex-info \\\\\\\"p5 oracle: non-scalar in request record\\\\\\\" {:value v}))))\\\\n   226\\\\t\\\\n   227\\\\t(defn- request-pairs\\\\n   228\\\\t  \\\\\\\"Ordered `[k v]` pairs of request-array `arr`, following its `:order`\\\\n   229\\\\t   (the engine's insertion order).\\\\\\\"\\\\n   230\\\\t  [arr]\\\\n   231\\\\t  (when arr\\\\n   232\\\\t    (mapv (fn [k] [k (get (:index arr) k)]) (:order arr))))\\\\n   233\\\\t\\\\n   234\\\\t(defn- php-array-literal\\\\n   235\\\\t  \\\\\\\"The PHP `array(...)` literal of request-array `arr`.\\\\\\\"\\\\n   236\\\\t  [arr]\\\\n   237\\\\t  (if (empty? (request-pairs arr))\\\\n   238\\\\t    \\\\\\\"array()\\\\\\\"\\\\n   239\\\\t    (str \\\\\\\"array(\\\\\\\"\\\\n   240\\\\t         (str/join \\\\\\\", \\\\\\\" (map (fn [[k v]]\\\\n   241\\\\t                               (str (php-literal k) \\\\\\\" => \\\\\\\" (php-literal v)))\\\\n   242\\\\t                             (request-pairs arr)))\\\\n   243\\\\t         \\\\\\\")\\\\\\\")))\\\\n   244\\\\t\\\\n   245\\\\t(defn p5-prologue\\\\n   246\\\\t  \\\\\\\"The `auto_prepend_file` prologue assigning the superglobals from the\\\\n   247\\\\t   fixture `:request` record, mirroring `php/bind-request!` (prelude\\\\n   248\\\\t   section `request and output`): `$_GET` is the query, `$_POST` the body,\\\\n   249\\\\t   `$_COOKIE` the cookies, `$_SERVER` the server fields with\\\\n   250\\\\t   `REQUEST_METHOD`/`REQUEST_URI` appended, `$_ENV` the env, `$_FILES` the\\\\n   251\\\\t   files, and `$_REQUEST` is `array_merge($_GET, $_POST)` (POST wins, the\\\\n   252\\\\t   engine's `php/merge-loop` over `[get post]`).\\\\\\\"\\\\n   253\\\\t  [request]\\\\n   254\\\\t  (let [method (or (:php.request/method request) \\\\\\\"\\\\\\\")\\\\n   255\\\\t        uri (or (:php.request/uri request) \\\\\\\"\\\\\\\")]\\\\n   256\\\\t    (str \\\\\\\"<?php\\\\\\\\n\\\\\\\"\\\\n   257\\\\t         \\\\\\\"$_GET = \\\\\\\" (php-array-literal (:php.request/query request)) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   258\\\\t         \\\\\\\"$_POST = \\\\\\\" (php-array-literal (:php.request/body request)) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   259\\\\t         \\\\\\\"$_COOKIE = \\\\\\\" (php-array-literal (:php.request/cookies request)) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   260\\\\t         \\\\\\\"$_SERVER = \\\\\\\" (php-array-literal (:php.request/server request)) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   261\\\\t         \\\\\\\"$_SERVER['REQUEST_METHOD'] = \\\\\\\" (php-literal method) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   262\\\\t         \\\\\\\"$_SERVER['REQUEST_URI'] = \\\\\\\" (php-literal uri) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   263\\\\t         \\\\\\\"$_ENV = \\\\\\\" (php-array-literal (:php.request/env request)) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   264\\\\t         \\\\\\\"$_FILES = \\\\\\\" (php-array-literal (:php.request/files request)) \\\\\\\";\\\\\\\\n\\\\\\\"\\\\n   265\\\\t         \\\\\\\"$_REQUEST = array_merge($_GET, $_POST);\\\\\\\\n\\\\\\\")))\\\\n   266\\\\t\\\\n   267\\\\t(defn run-php-file-with-prepend\\\\n   268\\\\t  \\\\\\\"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` with `prepend-file`\\\\n   269\\\\t   (a path relative to `<dir>`) as `auto_prepend_file`, and return the\\\\n   270\\\\t   parsed `{:out :diag :uncaught :exit}`.\\\\\\\"\\\\n   271\\\\t  [dir file prepend-file]\\\\n   272\\\\t  (let [{:keys [out err exit]}\\\\n   273\\\\t        (sh/sh \\\\\\\"docker\\\\\\\" \\\\\\\"run\\\\\\\" \\\\\\\"--rm\\\\\\\"\\\\n   274\\\\t               \\\\\\\"-v\\\\\\\" (str (.toAbsolutePath (.toPath (io/file dir))) \\\\\\\":/w\\\\\\\")\\\\n   275\\\\t               \\\\\\\"-w\\\\\\\" \\\\\\\"/w\\\\\\\"\\\\n   276\\\\t               \\\\\\\"php:8.3-cli\\\\\\\" \\\\\\\"php\\\\\\\"\\\\n   277\\\\t               \\\\\\\"-d\\\\\\\" \\\\\\\"display_errors=1\\\\\\\"\\\\n   278\\\\t               \\\\\\\"-d\\\\\\\" \\\\\\\"html_errors=0\\\\\\\"\\\\n   279\\\\t               \\\\\\\"-d\\\\\\\" \\\\\\\"error_reporting=E_ALL\\\\\\\"\\\\n   280\\\\t               \\\\\\\"-d\\\\\\\" \\\\\\\"log_errors=0\\\\\\\"\\\\n   281\\\\t               \\\\\\\"-d\\\\\\\" (str \\\\\\\"auto_prepend_file=/w/\\\\\\\" prepend-file)\\\\n   282\\\\t               file\\\\n   283\\\\t               :out-enc \\\\\\\"UTF-8\\\\\\\")]\\\\n   284\\\\t    (assoc (parse-stdout out file nil)\\\\n   285\\\\t           :err err\\\\n   286\\\\t           :exit exit)))\\\\n   287\\\\t\\\\n   288\\\\t(defn check-p5-fixture\\\\n   289\\\\t  \\\\\\\"Run P5 `fixture` in temporary directory `dir`: the fixture source plus,\\\\n   290\\\\t   for `:request`-bearing fixtures, the [[p5-prologue]] as\\\\n   291\\\\t   `auto_prepend_file`. Returns a check record like [[check-fixture]].\\\\\\\"\\\\n   292\\\\t  [dir {:keys [id source request out diag uncaught oracle], :as fixture}]\\\\n   293\\\\t  (let [file (str (name id) \\\\\\\".php\\\\\\\")\\\\n   294\\\\t        pre (str (name id) \\\\\\\"-pre.php\\\\\\\")]\\\\n   295\\\\t    (write-source! dir file source)\\\\n   296\\\\t    (when request (write-source! dir pre (p5-prologue request)))\\\\n   297\\\\t    (let [actual (if request\\\\n   298\\\\t                   (run-php-file-with-prepend dir file pre)\\\\n   299\\\\t                   (run-php-file dir file))\\\\n   300\\\\t          expected-out (or out \\\\\\\"\\\\\\\")\\\\n   301\\\\t          expected-diag (vec (or diag []))\\\\n   302\\\\t          pass? (and (not= :pending oracle)\\\\n   303\\\\t                     (= expected-out (:out actual))\\\\n   304\\\\t                     (= expected-diag (:diag actual))\\\\n   305\\\\t                     (= uncaught (:uncaught actual)))]\\\\n   306\\\\t      {:id id,\\\\n   307\\\\t       :pass? pass?,\\\\n   308\\\\t       :oracle oracle,\\\\n   309\\\\t       :expected {:out expected-out, :diag expected-diag, :uncaught uncaught},\\\\n   310\\\\t       :actual (select-keys actual [:out :diag :uncaught])})))\\\\n   311\\\\t\\\\n   312\\\\t(defn run-p5\\\\n   313\\\\t  \\\\\\\"Run all `p5/fixtures` (the request-context fixtures) against\\\\n   314\\\\t   `php:8.3-cli`.\\\\\\\"\\\\n   315\\\\t  []\\\\n   316\\\\t  (let [dir (.toFile (Files/createTempDirectory \\\\\\\"yang-php-oracle-p5-\\\\\\\"\\\\n   317\\\\t                                                (make-array FileAttribute 0)))]\\\\n   318\\\\t    (try\\\\n   319\\\\t      (mapv #(check-p5-fixture dir %) p5/fixtures)\\\\n   320\\\\t      (finally\\\\n   321\\\\t        (doseq [f (reverse (file-seq dir))]\\\\n   322\\\\t          (.delete ^java.io.File f))))))\\\\n   323\\\\t\\\\n   324\\\\t(defn print-fold\\\\n   325\\\\t  \\\\\\\"Print the fold lines for `results`: one paste-ready record per fixture\\\\n   326\\\\t   in the P4 [[p4/pin]] shape `{:oracle banner :out :diag :uncaught}`.\\\\\\\"\\\\n   327\\\\t  [results]\\\\n   328\\\\t  (doseq [{:keys [id actual]} results]\\\\n   329\\\\t    (println \\\\\\\"FOLD\\\\\\\" (name id)\\\\n   330\\\\t             (pr-str (assoc (select-keys actual [:out :diag :uncaught])\\\\n   331\\\\t              