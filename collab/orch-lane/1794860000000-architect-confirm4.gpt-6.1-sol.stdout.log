  ;; handlers, returns and finalizers\\\\n   218\\\\t     (fn [n]\\\\n   219\\\\t       (let [hs (php/handlers)]\\\\n   220\\\\t         (if (nil? hs)\\\\n   221\\\\t           :php/null\\\\n   222\\\\t           (if (<= (get hs 3) n)\\\\n   223\\\\t             :php/null\\\\n   224\\\\t             (do (php/pop-frame hs)\\\\n   225\\\\t                 (php/abandon-to n))))))]\\\\n   226\\\\t    [php/call-terminal\\\\n   227\\\\t     ;; `f` receives a terminal escape: invoking it abandons to here and\\\\n   228\\\\t     ;; answers its argument as this call's value, skipping :finally thunks\\\\n   229\\\\t     (fn [f]\\\\n   230\\\\t       (let [saved (cell/get php.rt/ctx)\\\\n   231\\\\t             flag (cell/new :first)]\\\\n   232\\\\t         ((fn [r]\\\\n   233\\\\t            (if (= (cell/get flag) :first)\\\\n   234\\\\t              (do (cell/set! flag :re-entered)\\\\n   235\\\\t                  (f (fn [x]\\\\n   236\\\\t                       (do (php/abandon-to (php/frame-depth (get saved :handlers)))\\\\n   237\\\\t                           (php/restore! saved)\\\\n   238\\\\t                           (r x)))))\\\\n   239\\\\t              r))\\\\n   240\\\\t          (%capture))))]\\\\n   241\\\\t    [php/try\\\\n   242\\\\t     (fn [body handler orelse]\\\\n   243\\\\t       (let [saved (cell/get php.rt/ctx)\\\\n   244\\\\t             flag (cell/new :first)]\\\\n   245\\\\t         ((fn [r]\\\\n   246\\\\t            (if (= (cell/get flag) :first)\\\\n   247\\\\t              (do (cell/set! flag :re-entered)\\\\n   248\\\\t                  (php/set-handlers! (php/frame :handler r (get saved :handlers)))\\\\n   249\\\\t                  (body)\\\\n   250\\\\t                  (php/restore! saved)\\\\n   251\\\\t                  (orelse))\\\\n   252\\\\t              (do (php/restore! saved)\\\\n   253\\\\t                  (handler r))))\\\\n   254\\\\t          (%capture))))]\\\\n   255\\\\t    [php/try-finally\\\\n   256\\\\t     ;; normal exit runs `fin` here; raise and escapes run it as they\\\\n   257\\\\t     ;; unwind through the :finally frame\\\\n   258\\\\t     (fn [body fin]\\\\n   259\\\\t       (let [saved (cell/get php.rt/ctx)]\\\\n   260\\\\t         (do (php/set-handlers! (php/frame :finally fin (get saved :handlers)))\\\\n   261\\\\t             (let [v (body)]\\\\n   262\\\\t               (do (php/restore! saved)\\\\n   263\\\\t                   (fin :php/null)\\\\n   264\\\\t                   v)))))]\\\\n   265\\\\t    [php/call-ec\\\\n   266\\\\t     ;; `f` receives an escape: calling it unwinds to here and answers its\\\\n   267\\\\t     ;; argument as this call's value (break, continue, return)\\\\n   268\\\\t     (fn [f]\\\\n   269\\\\t       (let [saved (cell/get php.rt/ctx)\\\\n   270\\\\t             flag (cell/new :first)]\\\\n   271\\\\t         ((fn [r]\\\\n   272\\\\t            (if (= (cell/get flag) :first)\\\\n   273\\\\t              (do (cell/set! flag :re-entered)\\\\n   274\\\\t                  (f (fn [x]\\\\n   275\\\\t                       (do (php/unwind-to (php/frame-depth (get saved :handlers)))\\\\n   276\\\\t                           (php/restore! saved)\\\\n   277\\\\t                           (r x)))))\\\\n   278\\\\t              r))\\\\n   279\\\\t          (%capture))))]\\\\n   280\\\\t\\\\n   281\\\\t    ;; ---------------------------------------------------------------- errors\\\\n   282\\\\t    [php/make-error\\\\n   283\\\\t     (fn [cls msg]\\\\n   284\\\\t       (let [c (php/class-lookup cls)]\\\\n   285\\\\t         (if (if (nil? c) true (= (data/count (get c :methods)) 0))\\\\n   286\\\\t           (php/make-error-map cls msg)\\\\n   287\\\\t           (let [o (php/instantiate c)]\\\\n   288\\\\t             (do (php/obj-set-props! o (php/table-set (get (php/obj-state o) :props) \\\\\\\"message\\\\\\\" msg))\\\\n   289\\\\t                 o)))))]\\\\n   290\\\\t    [php/make-error-map\\\\n   291\\\\t     (fn [cls msg]\\\\n   292\\\\t       (let [n (cell/get php.rt/next-ord)]\\\\n   293\\\\t         (do (cell/set! php.rt/next-ord (+ n 1))\\\\n   294\\\\t             (assoc (assoc (assoc (assoc {} :php/type :obj) :class cls) :ord n)\\\\n   295\\\\t                    :props\\\\n   296\\\\t                    (assoc (assoc (assoc {} \\\\\\\"message\\\\\\\" msg) \\\\\\\"code\\\\\\\" 0)\\\\n   297\\\\t                           \\\\\\\"previous\\\\\\\" :php/null)))))]\\\\n   298\\\\t    [php/throw-error (fn [cls msg] (php/raise (php/make-error cls msg)))]\\\\n   299\\\\t    [php/snapshot-exc\\\\n   300\\\\t     (fn [e]\\\\n   301\\\\t       (if (nil? (get e :php/obj))\\\\n   302\\\\t         (assoc (assoc {} :class (get e :class))\\\\n   303\\\\t                :message (get (get e :props) \\\\\\\"message\\\\\\\"))\\\\n   304\\\\t         (assoc (assoc {} :class (get (php/obj-state e) :class))\\\\n   305\\\\t                :message (php/prop-raw e \\\\\\\"message\\\\\\\"))))]\\\\n   306\\\\t    [php/warn-record\\\\n   307\\\\t     (fn [errno msg]\\\\n   308\\\\t       (assoc (assoc (assoc {} :php.diag/warning true) :errno errno)\\\\n   309\\\\t              :message msg))]\\\\n   310\\\\t    [php/warn-sink\\\\n   311\\\\t     ;; a diagnostic record on php.rt/diag when the mask admits it\\\\n   312\\\\t     (fn [rec]\\\\n   313\\\\t       (if (= (integer/bit-and (get rec :errno) (cell/get php.rt/error-reporting))\\\\n   314\\\\t              0)\\\\n   315\\\\t         :php/null\\\\n   316\\\\t         (cell/set! php.rt/diag (php/vconj (cell/get php.rt/diag) rec))))]\\\\n   317\\\\t    [php/invoke-handler\\\\n   318\\\\t     ;; the user handler is unset while it runs, so its own warnings go to\\\\n   319\\\\t     ;; the sink, and restored when it returns or an escape unwinds through it\\\\n   320\\\\t     (fn [h errno msg]\\\\n(ns yang.php.antlr.safepoint\\\\n  \\\\\\\"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\\\\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\\\\n   operational fatal, not a guest Throwable.\\\\\\\"\\\\n  (:require\\\\n    [yang.core.uast :as u]))\\\\n\\\\n\\\\n(def profile\\\\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\\\\n\\\\n\\\\n(def fatal-text\\\\n  \\\\\\\"Maximum execution time of 30 seconds exceeded\\\\\\\")\\\\n\\\\n\\\\n(def ^:private function-definitions\\\\n  '[[php.sp/exhaust!\\\\n     ;; the terminal root escape: guest handlers, returns and finalizers\\\\n     ;; cannot replace the operational fatal\\\\n     (fn []\\\\n       (php/root-fatal \\\\\\\"Maximum execution time of 30 seconds exceeded\\\\\\\"))]\\\\n    [php.sp/tick\\\\n     (fn []\\\\n       (let [n (cell/get php.sp/remaining)]\\\\n         (if (= n 0)\\\\n           (php.sp/exhaust!)\\\\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\\\\n    [php.sp/loop (fn [] (php.sp/tick))]\\\\n    [php.sp/call (fn [] (php.sp/tick))]])\\\\n\\\\n\\\\n(defn- definitions->uast\\\\n  [defs]\\\\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\\\\n\\\\n\\\\n(defn program\\\\n  \\\\\\\"The bounded run: hook definitions and a counter holding `budget`, then the\\\\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\\\\n   anything else is a named host-side error, not a guest diagnostic.\\\\\\\"\\\\n  [budget ast]\\\\n  (when-not (and (integer? budget) (not (neg? budget)))\\\\n    (throw (ex-info \\\\\\\"php.sp/remaining budget must be a non-negative integer\\\\\\\"\\\\n                    {:yang.php.antlr.safepoint/error :invalid-budget\\\\n                     :budget budget})))\\\\n  (u/mark-tails\\\\n    (u/then (definitions->uast function-definitions)\\\\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\\\\n                    ast))))\\\\n(ns yang.php.antlr.safepoint-test\\\\n  (:require\\\\n    [clojure.test :refer [deftest is testing]]\\\\n    [yang.php.antlr.e2e-harness :as h]\\\\n    [yang.php.antlr.safepoint :as hooks]))\\\\n\\\\n\\\\n(def ^:private vms [:ast-walker :semantic :stack :register])\\\\n\\\\n\\\\n(defn- every-vm=\\\\n  [expected results]\\\\n  (doseq [k vms]\\\\n    (is (= expected (get results k)) (name k))))\\\\n\\\\n\\\\n(deftest exhaustion-is-an-operational-fatal-test\\\\n  (let [source (str \\\\\\\"<?php class C { function __destruct() { echo 'D'; } } \\\\\\\"\\\\n                    \\\\\\\"$c = new C; try { while (true) {} } \\\\\\\"\\\\n                    \\\\\\\"catch (Throwable $e) { echo 'C'; }\\\\\\\")]\\\\n    (every-vm= (str \\\\\\\"PHP Fatal error:  \\\\\\\" hooks/fatal-text)\\\\n               (h/run-php source {:execution-budget 4}))))\\\\n\\\\n\\\\n(deftest exhaustion-inside-try-finally-is-fatal-test\\\\n  (let [source (str \\\\\\\"<?php function g() { yield 1; } \\\\\\\"\\\\n                    \\\\\\\"try { while (true) {} } finally { echo 'F'; }\\\\\\\")]\\\\n    (every-vm= (str \\\\\\\"PHP Fatal error:  \\\\\\\" hooks/fatal-text)\\\\n               (h/run-php source {:execution-budget 4}))))\\\\n\\\\n\\\\n(deftest exhaustion-in-shutdown-is-fatal-test\\\\n  (let [source (str \\\\\\\"<?php register_shutdown_function(function() { while (true) {} });\\\\\\\"\\\\n                    \\\\\\\" echo 'A';\\\\\\\")]\\\\n    (every-vm= (str \\\\\\\"A\\\\\\\" \\\\\\\"PHP Fatal error:  \\\\\\\" hooks/fatal-text)\\\\n               (h/run-php source {:execution-budget 4}))))\\\\n\\\\n\\\\n(deftest budget-validation-test\\\\n  (is (thrown? clojure.lang.ExceptionInfo (hooks/program -1 nil)))\\\\n  (is (thrown? clojure.lang.ExceptionInfo (hooks/program 1.5 nil)))\\\\n  (is (thrown? clojure.lang.ExceptionInfo (hooks/program \\\\\\\"4\\\\\\\" nil))))\\\\n\\\\n\\\\n(deftest unbounded-and-unexhausted-runs-agree-test\\\\n  (let [source \\\\\\\"<?php function f($x) { return $x + 1; } $i = 0; while ($i < 5) { $i = f($i); } echo $i;\\\\\\\"\\\\n        unbounded (h/run-php source)]\\\\n    (testing \\\\\\\"the default remains unbudgeted\\\\\\\"\\\\n      (every-vm= \\\\\\\"5\\\\\\\" unbounded))\\\\n    (testing \\\\\\\"a budget that is not exhausted is unobservable\\\\\\\"\\\\n      (is (= unbounded (h/run-php source {:execution-budget 100}))))))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_17\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"cat collab/orch-lane/*p8*findings*; head -90 test/yang/php/antlr/phpt_quick_mismatch_manifest.edn; rg -n 'P8|slow|manifest|mismatch' docs/agents/known-gaps.md\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_17\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"cat collab/orch-lane/*p8*findings*; head -90 test/yang/php/antlr/phpt_quick_mismatch_manifest.edn; rg -n 'P8|slow|manifest|mismatch' docs/agents/known-gaps.md\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"# Findings: PHPT manifest repair (p8 legacy retirement)\\\\n\\\\nSeat: the full e2e gate (`clojure -M:test -n yang.php.antlr.e2e-test`) was NOT run\\\\nhere per the HARD CONSTRAINT (laptop overload). EDN validity was verified locally\\\\n(`clojure.edn/read-string` round-trip, seconds). The shiva run is the deciding gate.\\\\n\\\\n## What changed (`test/yang/php/antlr/phpt_quick_mismatch_manifest.edn`, EDN round-trip)\\\\n\\\\n1. **bug64660 gap record**: the selection entry `Zend/tests/bug64660.phpt` carries\\\\n   `:expectf \\\\\\\"Parse error: memory exhausted in %s on line %d \\\\\\\"` and NO `:expect`\\\\n   (keys: `:id :path :slow :source :title :expectf`). The gap's `:oracle-expect`\\\\n   was `\\\\\\\"Okey\\\\\\\"` (stale — probably copied from bug63055's oracle). Set to `nil` so\\\\n   `(= (:expect entry) (:oracle-expect gap))` holds, and recorded the real oracle\\\\n   shape in a new `:oracle-expectf` key. `:engine-result {}` and the work-item\\\\n   text left untouched.\\\\n2. **bug63055 slow gap added** (8th record): entry `:expect \\\\\\\"okey\\\\\\\"`, `:slow true`,\\\\n   no `:needs`. Record: `:feature :undefined-builtin`, `:builtin \\\\\\\"str_replace\\\\\\\"`,\\\\n   `:oracle-expect \\\\\\\"okey\\\\\\\"`, `:engine-result {:out \\\\\\\"\\\\\\\" :diag [] :uncaught\\\\n   {:class \\\\\\\"Error\\\\\\\" :message \\\\\\\"Call to undefined function str_replace()\\\\\\\"}}`,\\\\n   `:engine-work-item \\\\\\\"Implement str_replace().\\\\\\\"` — mirroring the sibling\\\\n   str_repeat/serialize gap records. Engine result copied from the brief, NOT\\\\n   measured locally; shiva must confirm assertion `:568` (`engine-result` equality).\\\\n3. **Quick manifest regenerated from deltas**: removed 7 ids present in the\\\\n   manifest — `unset_cv08`, `bug69756`, `bug81705`, `bug67874`, `bug60350`,\\\\n   `bug45877`, `bug78502` — from `:known-gaps` entries AND `:descriptions`.\\\\n   New `:counts`: `zend-regression 61` (was a stale 70; the entries actually held\\\\n   67), `gc-cycle-collection 10`, `foreach-semantics 11`, `named-parameter-binding 3`,\\\\n   `unset-cv 3`, `array-reference 1`, `pass-by-reference 5`, `array-pointer 1`,\\\\n   `:total 95`, `:unsupported 57`. `:php-src-tag` stays `\\\\\\\"8.3.35\\\\\\\"`. All 7 slow\\\\n   records kept, plus the new bug63055 record.\\\\n\\\\n## Open items for the shiva pass\\\\n\\\\n- **Off-by-one vs the nightly note.** The brief's expected families are\\\\n  `{gc 10, foreach-by-ref 16, unset-cv 3, named-params 3, other 64}` (= 96), but\\\\n  this regeneration yields `other 63` / total 95. Of the brief's ~10 departed ids,\\\\n  3 (`bug71470`, `bug63206_1`, `bug79836_1`) were already absent from the manifest\\\\n  (removed by the earlier hand edit), leaving 7 real removals: 67-6=61 zend +\\\\n  array-ref + array-pointer = 63 other. If shiva reports `other 64` / total 96 or\\\\n  a different fail-id set, one id in this regeneration is wrong (suspect a\\\\n  `bug79836` vs `bug79836_1` mix-up — the manifest holds `bug79836.phpt`, the note\\\\n  names `bug79836_1`) or one more id needs removal; adjust `:known-gaps`,\\\\n  `:descriptions`, and `:counts` together on shiva.\\\\n- **Refusal count 58 -> 57** was taken from the brief, not measured. If shiva's\\\\n  quick run reports a different unsupported count, update `:unsupported` to match.\\\\n- **bug64660 `:engine-result {}`** was left as-is; if the shiva engine result for\\\\n  that OOM case is not `{}`, update the gap record to the measured value.\\\\n- **cljstyle/kondo**: neither binary is installed on this laptop and the repo has\\\\n  no lint config for `.edn` data files, so no lint gate was runnable here. The only\\\\n  touched file is the manifest (pure data, written by `pprint`).\\\\n- Caution: `clojure -M:test -e ...` triggers the test-runner main (it started\\\\n  \\\\\\\"Running tests\\\\\\\" here); it was killed immediately. Use `clojure -M -e` for EDN\\\\n  probes on this repo, never `-M:test` without `-n`.\\\\n# Findings: stale e2e pins task (laptop) — NOT applied, premises do not hold\\\\n\\\\nDate: 2026-11-04. Branch: feat/p8-legacy-retirement @ 34e94513. No commits made, no files changed (working tree untouched except this findings file, uncommitted).\\\\n\\\\n## Verdict: STOP — do not change pins or engine\\\\n\\\\nAll three task premises (\\\\\\\"writes now WORK\\\\\\\", \\\\\\\"strtoupper is now a prelude builtin\\\\\\\", \\\\\\\"$$a[0] = 1 no longer refused (P9)\\\\\\\") are **false on this branch**. The engine still exhibits exactly the old pinned behavior, so editing the fixtures to the \\\\\\\"new\\\\\\\" behavior would break pins against the real engine. Per the task's own stop rule, no pin/engine changes were made.\\\\n\\\\n## Evidence (code inspection, this branch)\\\\n\\\\n1. **String-offset writes still refused.** [prelude.cljc](file:///Users/sto/workspace/datomworld-p8/src/cljc/yang/php/antlr/prelude.cljc) `php/path-assign-at` still routes `:string` kind to `php/str-write-error` (\\\\\\\"string offset writes are not supported yet (yang.php known gap G-str-offset-write)\\\\\\\"); `str-write-error` definition still present. The pin in [programs.cljc](file:///Users/sto/workspace/datomworld-p8/test/yang/php/antlr/programs.cljc) (`:string-offset-write` fixture) and the [prelude_test.cljc](file:///Users/sto/workspace/datomworld-p8/test/yang/php/antlr/prelude_test.cljc) \\\\\\\"a string write is the known gap\\\\\\\" expectation match the engine.\\\\n2. **strtoupper still warns + fatals.** `strtoupper` is in `builtins/catalogue` but NOT among the ~25 names `php/init!` registers in [prelude.cljc](file:///Users/sto/workspace/datomworld-p8/src/cljc/yang/php/antlr/prelude.cljc) (`builtin-names`), so [lower.cljc](file:///Users/sto/workspace/datomworld-p8/src/cljc/yang/php/antlr/lower.cljc) `note-unknown-builtin!` still emits `:yang.php/unknown-builtin` and the call still fatals. The `lowering-warnings-test` pin (e2e_test.clj:318-338) matches the engine.\\\\n3. **`$$a[0] = 1` still refused.** `base-location` in [lower.cljc](file:///Users/sto/workspace/datomworld-p8/src/cljc/yang/php/antlr/lower.cljc) only locates plain `VarName` bases; a variable-variable base yields nil, so `chain-loc` still raises `unsupported!` with `:assignment-target`. The `refusals-are-named-test` pin (e2e_test.clj:228-245) matches the engine.\\\\n\\\\n## Oracle verification: NOT performed (no oracle available on laptop)\\\\n\\\\n- `docker`: command not found. `php`: command not found. No podman/colima/nerdctl.\\\\n- The task's first step in each item (oracle-verify via `php:8.3` docker image) could not run, so the \\\\\\\"oracle disagrees → STOP\\\\\\\" branch could not be evaluated either. The STOP above rests on engine-vs-premise mismatch, which is independent of the oracle.\\\\n\\\\n## Likely cause\\\\n\\\\nThe task appears written against a different branch/state (one where P9 strings-II and a strtoupper prelude addition landed). On `feat/p8-legacy-retirement @ 34e94513` none of that work is present: `git log -S \\\\\\\"G-str-offset-write\\\\\\\"` shows only docs/ledger mentions, no closing commit; `git log -S \\\\\\\"strtoupper\\\\\\\" -- src/` is empty.\\\\n\\\\n## G-str-offset-write ledger row\\\\n\\\\nStill OPEN and accurate — no closing commit exists on this branch, so `docs/agents/known-gaps.md` rows were left untouched (correctly).\\\\n\\\\n## Gate for the seat (shiva)\\\\n\\\\nLaptop ran no Clojure tests per the hard constraint (no `clojure -M:test` invocations were made at all). The seat should run, on shiva with the manifest:\\\\n\\\\n- `clojure -M:test -n yang.php.antlr.e2e-test` (full e2e namespace gate)\\\\n- Plus the oracle checks from the task: `$s=\\\\\\\"ab\\\\\\\"; $s[0]=\\\\\\\"c\\\\\\\"; echo $s;` must print `cb`; `echo strtoupper(\\\\\\\"a\\\\\\\");` → `A`; `$$a[0] = 1;` behavior per fixture source — and only if the seat's engine actually implements the new behavior should the pins be updated there.\\\\n# Findings: stale e2e pins on the MERGED branch (r2) — engine verified, pins updated\\\\n\\\\nDate: 2026-11-04. Branch: feat/p8-legacy-retirement @ 12e5eddc (includes origin/master P5/P7-a/P9).\\\\nNote: the predecessor's STOP verdict was correct for the pre-merge tree; on this merged tree all three\\\\npremises HOLD, so the pins were updated (commit `test(yang.php): ...` on this branch).\\\\n\\\\n## Verdict: all three items verified against the merged engine, fixtures updated\\\\n\\\\n1. **string-offset-write now works.** P9 commit `91c5c8cd` (\\\\\\\"feat(yang.php): P9 — the builtin surface\\\\n   slices\\\\\\\") deleted `php/str-write-error` and added `php/string-assign`, wired into `path-assign-at`\\\\n   (`src/cljc/yang/php/antlr/prelude.cljc`). Focused walker probe:\\\\n   `<?php $s=\\\\\\\"ab\\\\\\\"; $s[0]=\\\\\\\"c\\\\\\\"; echo $s;` renders `\\\\\\\"cb\\\\\\\"`.\\\\n   - `test/yang/php/antlr/programs.cljc` `:string-offset-write` flipped from the G-str-offset-write\\\\n     refusal pin to the working expectation (`:out \\\\\\\"cb\\\\\\\"`, `:diag []`, `:uncaught`/`:gap` removed).\\\\n   - `test/yang/php/antlr/prelude_test.cljc` `array-path-assign-test` now pins\\\\n     `(php/echo (php/path-assign \\\\\\\"abc\\\\\\\" [0] \\\\\\\"x\\\\\\\"))` → `\\\\\\\"xbc\\\\\\\"`.\\\\n   - `docs/agents/known-gaps.md`: all 4 G-str-offset-write rows marked\\\\n     `closed 2026-11-04` citing `91c5c8cd`.\\\\n2. **strtoupper is a prelude builtin.** `builtins/supported` maps `\\\\\\\"strtoupper\\\\\\\"` to `php/bi-strtoupper`\\\\n   and `prelude/builtin-names` derives from that table, so no `:yang.php/unknown-builtin` warning is\\\\n   emitted and the call runs. `e2e_test.clj` `lowering-warnings-test` updated to no-warning + `\\\\\\\"A\\\\\\\"`.\\\\n3. **`$$a[0] = 1` now assigns through.** `base-location` (`lower.cljc`) locates a `Dollar`+`VarName`\\\\n   base as `{:var {:dynamic-name ...}}`, and `write-loc` writes a dynamic var with a path back via\\\\n   `dict-put!`. Focused walker probes: `<?php $$a[0] = 1;` lowers with no diagnostics (renders `\\\\\\\"\\\\\\\"`);\\\\n   `<?php $a = \\\\\\\"x\\\\\\\"; $x = [10, 20]; $$a[0] = 1; echo $x[0]; echo \\\\\\\",\\\\\\\"; echo $x[1];` renders `\\\\\\\"1,20\\\\\\\"`;\\\\n   `<?php $a = \\\\\\\"y\\\\\\\"; $$a[0] = 1; echo $y[0];` renders `\\\\\\\"1\\\\\\\"` (vivifies). So the engine resolves it as\\\\n   `${$a}[0]`. Refusals entry removed; new `variable-variable-offset-assign-test` pins `\\\\\\\"1,20\\\\\\\"`.\\\\n\\\\n## Laptop gates (all green)\\\\n\\\\n- `clojure -M:test -v yang.php.antlr.e2e-test/fixtures-on-the-walker-test\\\\n  -v .../lowering-warnings-test -v .../refusals-are-named-test\\\\n  -v .../variable-variable-offset-assign-test` → 4 tests, 557 assertions, 0 failures.\\\\n- `clojure -M:test -n yang.php.antlr.prelude-test` → 33 tests, 373 assertions, 0 failures.\\\\n- `clojure -M:kondo --lint` over the three touched test files → 0 errors, 0 warnings.\\\\n- No cljstyle runner is configured in this repo (`.cljstyle` present, no alias/CI invocation); edits\\\\n  match surrounding formatting. Full `e2e-test` namespace NOT run locally per the hard constraint.\\\\n\\\\n## Oracle: NOT performed on laptop (no docker/php) — seat oracle-check list for shiva\\\\n\\\\nPHP-truth assumed from the unambiguous documented behavior; the seat must confirm each on `php:8.3`\\\\nbefore landing (mark any doubt — none structural, but all three are oracle-unconfirmed):\\\\n\\\\n1. `php -r '$s=\\\\\\\"ab\\\\\\\"; $s[0]=\\\\\\\"c\\\\\\\"; echo $s;'` must print `cb`.\\\\n2. `php -r 'echo strtoupper(\\\\\\\"a\\\\\\\");'` must print `A`.\\\\n3. `php -r '$a = \\\\\\\"x\\\\\\\"; $x = [10, 20]; $$a[0] = 1; echo $x[0], \\\\\\\",\\\\\\\", $x[1];'` — engine prints `1,20`\\\\n   (i.e. `${$a}[0]` resolution); confirm Zend agrees, else the new pin's reading is wrong.\\\\n4. Seat gate: full `clojure -M:test -n yang.php.antlr.e2e-test` on shiva (includes the slow\\\\n   `fixtures-on-every-vm-test`, not run here).\\\\n{:selection :quick,\\\\n :php-src-tag \\\\\\\"8.3.35\\\\\\\",\\\\n :slow-known-gaps\\\\n [{:id \\\\\\\"Zend/tests/gc_013.phpt\\\\\\\",\\\\n   :feature :gc-cycle-collection,\\\\n   :oracle-expect \\\\\\\"bool(true)\\\\\\\\nok\\\\\\\",\\\\n   :engine-result\\\\n   {:out \\\\\\\"\\\\\\\",\\\\n    :diag [],\\\\n    :uncaught\\\\n    {:class \\\\\\\"Error\\\\\\\",\\\\n     :message \\\\\\\"Call to undefined function gc_collect_cycles()\\\\\\\"}},\\\\n   :engine-work-item\\\\n   \\\\\\\"Implement PHP cyclic garbage collection and roots/threshold behavior.\\\\\\\"}\\\\n  {:id \\\\\\\"Zend/tests/gc_023.phpt\\\\\\\",\\\\n   :feature :gc-cycle-collection,\\\\n   :oracle-expect \\\\\\\"int(0)\\\\\\\\nint(9999)\\\\\\\\nint(0)\\\\\\\\nint(1)\\\\\\\\nok\\\\\\\",\\\\n   :engine-result\\\\n   {:out \\\\\\\"\\\\\\\",\\\\n    :diag [],\\\\n    :uncaught\\\\n    {:class \\\\\\\"Error\\\\\\\",\\\\n     :message \\\\\\\"Call to undefined function gc_collect_cycles()\\\\\\\"}},\\\\n   :engine-work-item\\\\n   \\\\\\\"Implement PHP cyclic garbage collection and roots/threshold behavior.\\\\\\\"}\\\\n  {:id \\\\\\\"Zend/tests/bug39438.phpt\\\\\\\",\\\\n   :feature :undefined-builtin,\\\\n   :builtin \\\\\\\"serialize\\\\\\\",\\\\n   :oracle-expect \\\\\\\"ok\\\\\\\",\\\\n   :engine-result\\\\n   {:out \\\\\\\"\\\\\\\",\\\\n    :diag [],\\\\n    :uncaught\\\\n    {:class \\\\\\\"Error\\\\\\\",\\\\n     :message \\\\\\\"Call to undefined function serialize()\\\\\\\"}},\\\\n   :engine-work-item \\\\\\\"Implement serialize().\\\\\\\"}\\\\n  {:id \\\\\\\"Zend/tests/bug64660.phpt\\\\\\\",\\\\n   :feature :host-resource-ceiling,\\\\n   :builtin nil,\\\\n   :oracle-expect nil,\\\\n   :engine-result {},\\\\n   :engine-work-item\\\\n   \\\\\\\"The engine exhausts the JVM heap on this case (java.lang.OutOfMemoryError); a host resource ceiling, not a guest-semantics gap. Revisit with heap headroom or an engine fix.\\\\\\\",\\\\n   :oracle-expectf \\\\\\\"Parse error: memory exhausted in %s on line %d \\\\\\\"}\\\\n  {:id \\\\\\\"Zend/tests/bug44069.phpt\\\\\\\",\\\\n   :feature :undefined-builtin,\\\\n   :builtin \\\\\\\"str_repeat\\\\\\\",\\\\n   :oracle-expect \\\\\\\"ok\\\\\\\",\\\\n   :engine-result\\\\n   {:out \\\\\\\"\\\\\\\",\\\\n    :diag [],\\\\n    :uncaught\\\\n    {:class \\\\\\\"Error\\\\\\\",\\\\n     :message \\\\\\\"Call to undefined function str_repeat()\\\\\\\"}},\\\\n   :engine-work-item \\\\\\\"Implement str_repeat().\\\\\\\"}\\\\n  {:id \\\\\\\"Zend/tests/bug40809.phpt\\\\\\\",\\\\n   :feature :undefined-builtin,\\\\n   :builtin \\\\\\\"str_repeat\\\\\\\",\\\\n   :oracle-expect \\\\\\\"ok\\\\\\\",\\\\n   :engine-result\\\\n   {:out \\\\\\\"\\\\\\\",\\\\n    :diag [],\\\\n    :uncaught\\\\n    {:class \\\\\\\"Error\\\\\\\",\\\\n     :message \\\\\\\"Call to undefined function str_repeat()\\\\\\\"}},\\\\n   :engine-work-item \\\\\\\"Implement str_repeat().\\\\\\\"}\\\\n  {:id \\\\\\\"Zend/tests/gc_012.phpt\\\\\\\",\\\\n   :feature :gc-cycle-collection,\\\\