s/lower-task\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1083:            restored (rows/lower-task (support/new-machine) pack (fn [_] nil))]\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1132:            ;; A fixed composition key is already reserved by lower-task,\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1146:            clean (rows/lower-task fresh pack attach! support/installer-lower-opts)\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1147:            restored (rows/lower-task populated pack attach! support/installer-lower-opts)\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1158:                        (rows/lower-task collision-receiver pack attach! support/installer-lower-opts))\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1229:        m (rows/lower-task populated wire attach! opts)]\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1248:            clean (rows/lower-task fresh pack attach! (assoc support/installer-lower-opts :fenced true))\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1249:            restored (rows/lower-task populated pack attach! (assoc support/installer-lower-opts :fenced true))]\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1269:          recv (rows/lower-task (support/new-machine) pack attach!)\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1279:          recv (rows/lower-task (support/new-machine) pack attach!)]\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1365:                (verdict (error #(rows/lower-task (support/new-machine) wire attach!)))))))\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1371:  (let [sender-record {:yin.admit/id \\\\\\\\\\\\\\\"sender-only\\\\\\\\\\\\\\\"\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1373:                       :yin.admit/asserters #{'sender}\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1374:                       :yin.admit/address :sender-only}\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1376:                          [:installs 'host.mod :response] merge sender-record)\\\\\\\\ntest/yin/vm/ucf/rows_test.cljc:1380:    (doseq [opts [{} {:yin.k/admitted {'other.mod address}}\\\\\\\\ntest/yi