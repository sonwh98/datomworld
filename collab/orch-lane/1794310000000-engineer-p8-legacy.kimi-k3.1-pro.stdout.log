{"role":"tool","tool_call_id":"tool_c58Yt8ItZNgJKJyKCb4mQRUX","content":"1\t(ns yang.php.antlr.e2e-harness\n2\t  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n3\t   program envelope -> the bundled program on each of the four VMs. Output\n4\t   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n5\t   here at the boundary.\"\n6\t  (:require\n7\t    [clojure.walk :as walk]\n8\t    [dao.host.text :as text]\n9\t    [dao.stream :as stream]\n10\t    [yang.php.antlr.cst :as cst]\n11\t    [yang.php.antlr.lower :as lower]\n12\t    [yang.php.antlr.portable-harness :as portable]\n13\t    [yang.php.antlr.safepoint :as hooks]\n14\t    [yang.core.uast :as u]\n15\t    [yang.safepoint :as safepoint]\n16\t    [yin.vm :as vm]\n17\t    [yin.vm.debruijn.register :as rvm]\n18\t    [yin.vm.debruijn.stack :as dvm]\n19\t    [yin.vm.encoder :as encoder]\n20\t    [yin.vm.semantic :as semantic]\n21\t    [yin.vm.semantic.derive :as derive]\n22\t    [yin.vm.semantic.linearize :as sr-linearize]\n23\t    [yin.vm.test-utils :as tu]))\n24\t\n25\t\n26\t(defn host-registry\n27\t  \"The registry the PHP compositions run over.\"\n28\t  []\n29\t  (portable/host-registry))\n30\t\n31\t\n32\t(def ^:private base-opts\n33\t  {:make-stream tu/make-stream,\n34\t   :capability-secret tu/secret,\n35\t   :primitives vm/primitives})\n36\t\n37\t\n38\t(def ^:private load-semantic\n39\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n40\t\n41\t\n42\t(defn lower-program\n43\t  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n44\t   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\"\n45\t  [source]\n46\t  (let [cst-log (tu/new-memory-log)\n47\t        program (tu/new-memory-log)\n48\t        diagnostics (tu/new-memory-log)]\n49\t    (stream/append! cst-log (cst/parse-source source))\n50\t    (lower/step-stage (lower/open-stage cst-log program diagnostics\n51\t                                        {:medium lower/program-medium}))\n52\t    (let [{warnings true, problems false}\n53\t          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n54\t      (if (seq problems)\n55\t        {:diagnostics problems}\n56\t        (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\n57\t          {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)})))))\n58\t\n59\t\n60\t(defn packet->form\n61\t  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n62\t   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n63\t   `portable-harness/packet`.\"\n64\t  [{:yang.cst/keys [root nodes]}]\n65\t  (letfn [(form\n66\t            [id]\n67\t            (let [{:keys [kind rule type text children]} (nth nodes id)]\n68\t              (if (= :token kind)\n69\t                [type text]\n70\t                (into [(keyword rule)] (map form) children))))]\n71\t    (form root)))\n72\t\n73\t\n74\t(defn latin1->text\n75\t  \"The UTF-8 text of the byte carrier `s`.\"\n76\t  [s]\n77\t  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n78\t\n79\t\n80\t(defn render\n81\t  \"The text a unit prints: its output, then, for an uncaught error, the\n82\t   fatal line (no path, plan section 3.9).\"\n83\t  [{:php/keys [out uncaught fatal]}]\n84\t  (str (latin1->text out)\n85\t       (when uncaught\n86\t         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n87\t       (when fatal\n88\t         (str \"PHP Fatal error:  \" fatal))))\n89\t\n90\t\n91\t(defn run-vms\n92\t  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n93\t   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\n94\t   and starts one per-run counter; no option leaves the AST unchanged.\"\n95\t  ([registry ast] (run-vms registry ast {}))\n96\t  ([registry ast {:keys [execution-budget envelope]}]\n97\t   (let [ast (if (some? execution-budget)\n98\t               (let [projected (encoder/project envelope)\n99\t                     derived (:envelope (safepoint/derive-envelope\n100\t                                          projected hooks/profile :test/derived))\n101\t                     tree (nth (:yin/batch derived) (:yin/root derived))]\n102\t                 (hooks/program execution-budget\n103\t                                (vm/semantic-bytecode->ast tree)))\n104\t               ast)\n105\t         opts (assoc base-opts :modules registry)\n106\t         session (tu/make-observer-session (tu/create-vm {:modules registry}))\n107\t         datoms (vec (vm/ast->datoms ast))\n108\t         projected #(:vector (sr-linearize/project ast))\n109\t         attempt (fn [f]\n110\t                   (try (render (f))\n111\t                        (catch Exception e [:thrown (ex-message e)])))]\n112\t     (tu/queue-ast! session ast)\n113\t     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n114\t      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n115\t                                                           datoms)))),\n116\t      :stack (attempt #(vm/value (vm/run (dvm/create-vm\n117\t                                           (:image (derive/stack-image (projected)))\n118\t                                           (assoc opts :contract vm/stack-contract))))),\n119\t      :register (attempt #(vm/value (vm/run (rvm/create-vm\n120\t                                              (derive/register-image (projected))\n121\t                                              (assoc opts\n122\t                                                     :contract\n123\t                                                     vm/register-contract)))))})))\n124\t\n125\t\n126\t(defn run-php\n127\t  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\n128\t   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\"\n129\t  ([source] (run-php source {}))\n130\t  ([source options]\n131\t   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\n132\t     (if diagnostics\n133\t       {:diagnostics diagnostics}\n134\t       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\n135\t\n136\t\n137\t(defn run-walker\n138\t  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n139\t  [source]\n140\t  (let [{:keys [ast diagnostics]} (lower-program source)]\n141\t    (if diagnostics\n142\t      {:diagnostics diagnostics}\n143\t      (let [registry (host-registry)\n144\t            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n145\t        (tu/queue-ast! session ast)\n146\t        (try (render (vm/value (:consumer (tu/run-session session))))\n147\t             (catch Exception e [:thrown (ex-message e)]))))))\n148\t\n149\t\n150\t(defn run-raw\n151\t  \"The unit's value on the AST walker, optionally after binding a request record.\"\n152\t  ([source] (run-raw source nil))\n153\t  ([source request]\n154\t   (let [{:keys [ast diagnostics]} (lower-program source)]\n155\t     (if diagnostics\n156\t       {:diagnostics diagnostics}\n157\t       (let [session (tu/make-observer-session\n158\t                       (tu/create-vm {:modules (host-registry)}))\n159\t             ast (if request\n160\t                   (walk/postwalk\n161\t                     (fn [node]\n162\t                       (if (and (map? node)\n163\t                                (= :application (:type node))\n164\t                                (= 'php/run-main (get-in node [:operator :name])))\n165\t                         (let [body (first (:operands node))]\n166\t                           (assoc node :operands\n167\t                                  [(u/lam []\n168\t                                          (u/then\n169\t                                            (u/sexp->uast (list 'php/bind-request! request))\n170\t                                            (u/app body)))]))\n171\t                         node))\n172\t      