{"role":"tool","tool_call_id":"tool_0B3TuWraiAFHZ5QdBwUvrZJr","content":"1\t(ns yang.php.antlr.portable-harness\n2\t  \"What the JVM, Node and Dart lanes share: the host composition the PHP\n3\t   profile runs over, the `packet` helper that builds a CST packet from a\n4\t   nested form, and a parserless run of a packet on the AST walker.\"\n5\t  (:require\n6\t    [dao.stream :as stream]\n7\t    [dao.stream.memory-log :as memory-log]\n8\t    [dao.stream.ringbuffer :as ringbuffer]\n9\t    [yang.php.antlr.lower :as lower]\n10\t    [yang.php.antlr.prelude :as prelude]\n11\t    [yin.vm :as vm]\n12\t    [yin.vm.ast-walker :as ast-walker]\n13\t    [yin.vm.data :as data]\n14\t    [yin.vm.integer :as integer]\n15\t    [yin.vm.module :as module]))\n16\t\n17\t\n18\t(def ^:private capability-secret \"yin.vm.test-utils/capability-secret\")\n19\t\n20\t\n21\t(defn create-vm\n22\t  \"An AST walker composed with the harness's deterministic ring-buffer stream.\"\n23\t  ([] (create-vm {}))\n24\t  ([opts]\n25\t   (ast-walker/create-vm\n26\t     (merge {:make-stream\n27\t             (fn [capacity]\n28\t               (ringbuffer/create!\n29\t                 {:dao.stream/type ringbuffer/transport-type,\n30\t                  ringbuffer/capacity-key (or capacity vm/default-stream-capacity)}))\n31\t             :capability-secret capability-secret}\n32\t            opts))))\n33\t\n34\t\n35\t(defn- new-memory-log\n36\t  []\n37\t  (let [result (memory-log/create! {:dao.stream/type memory-log/transport-type})]\n38\t    (if (= :dao.stream/ok (:dao.stream/outcome result))\n39\t      (:dao.stream/handle result)\n40\t      (throw (ex-info \"PHP harness memory-log creation failed\" {:result result})))))\n41\t\n42\t\n43\t(defn- drain\n44\t  [handle]\n45\t  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\n46\t                      [:dao.stream/cursor])]\n47\t    (loop [cursor start, acc []]\n48\t      (let [result (stream/next handle cursor)]\n49\t        (if (= :dao.stream/ok (:dao.stream/outcome result))\n50\t          (recur (:dao.stream/cursor result)\n51\t                 (conj acc (:dao.stream/value result)))\n52\t          acc)))))\n53\t\n54\t\n55\t(def integer-limits\n56\t  \"The `integer` limits the PHP compositions here install.\"\n57\t  {::integer/max-bits 100000, ::integer/max-digits 4300})\n58\t\n59\t\n60\t(def data-limits {::data/max-items 1048576})\n61\t\n62\t\n63\t(defn host-registry\n64\t  \"The registry with the cell, data and integer modules installed, admitted\n65\t   by the PHP profile.\"\n66\t  []\n67\t  (-> (module/empty-registry)\n68\t      module/register-cell-module\n69\t      (data/register-data-module data-limits)\n70\t      (prelude/register-integer-module integer-limits)\n71\t      prelude/admit))\n72\t\n73\t\n74\t(defn linked-registry\n75\t  \"`host-registry` over the default registry, whose `require` handlers the\n76\t   linked profile needs.\"\n77\t  []\n78\t  (-> (module/default-registry)\n79\t      module/register-cell-module\n80\t      (data/register-data-module data-limits)\n81\t      (prelude/register-integer-module integer-limits)\n82\t      prelude/admit))\n83\t\n84\t\n85\t(defn packet\n86\t  \"A CST packet from a nested form: `[rule child ...]` for a rule (a keyword)\n87\t   and `[type text]` (type a string) for a token. Spans are zero-width: the\n88\t   lowering reads them only for diagnostics. Ids are preorder, as the parser\n89\t   numbers them, so generated names match a parsed packet's.\"\n90\t  [form]\n91\t  (let [out (volatile! [])]\n92\t    (letfn [(walk\n93\t              [f]\n94\t              (let [id (count @out)]\n95\t                (if (string? (first f))\n96\t                  (vswap! out conj {:id id, :kind :token, :type (first f),\n97\t                                    :text (second f), :span [0 0]})\n98\t                  (do (vswap! out conj nil)\n99\t                      (let [kids (mapv walk (rest f))]\n100\t                        (vswap! out assoc id {:id id, :kind :rule,"}
