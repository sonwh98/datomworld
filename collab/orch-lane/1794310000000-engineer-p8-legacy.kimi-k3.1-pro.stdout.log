ore.prelude` (the emitters, and `admit` with `host-names` adding the"}
{"role":"tool","tool_call_id":"tool_eJEaAWwAc3Gpna3huvI8ung6","content":"1\t(ns yang.php.antlr.e2e-test\n2\t  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n3\t   envelope -> the bundled program on each of the four VMs (the AST walker,\n4\t   the semantic, stack and register VMs). Every fixture of\n5\t   `yang.php.antlr.programs` prints the same text on all four.\"\n6\t  (:require\n7\t    [clojure.edn :as edn]\n8\t    [clojure.java.io :as io]\n9\t    [clojure.string :as str]\n10\t    [clojure.test :refer [deftest is testing]]\n11\t    [yang.core.uast :as u]\n12\t    [yang.php.antlr.cst :as cst]\n13\t    [yang.php.antlr.e2e-harness :as h]\n14\t    [yang.php.antlr.portable-harness :as php-h]\n15\t    [yang.php.antlr.packets :as packets]\n16\t    [yang.php.antlr.packets-p3b :as packets-p3b]\n17\t    [yang.php.antlr.permutations :as perms]\n18\t    [yang.php.antlr.phpt :as phpt]\n19\t    [yang.php.antlr.programs :as programs]\n20\t    [yang.php.antlr.programs-p3b :as p3b]\n21\t    [yang.typescript.antlr.e2e-test :as ts]\n22\t    [yin.vm :as vm]\n23\t    [yin.vm.test-utils :as tu]))\n24\t\n25\t\n26\t(def ^:private vms [:ast-walker :semantic :stack :register])\n27\t\n28\t\n29\t(defn- rendered\n30\t  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n31\t  [{:keys [out uncaught]}]\n32\t  (str out\n33\t       (when uncaught\n34\t         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n35\t\n36\t\n37\t(deftest ^:slow fixtures-on-every-vm-test\n38\t  (doseq [{:keys [id source] :as fixture} programs/fixtures\n39\t          :let [out (rendered fixture)]]\n40\t    (testing (name id)\n41\t      (let [results (h/run-php source)]\n42\t        (is (not (contains? results :diagnostics)) (pr-str results))\n43\t        (doseq [k vms]\n44\t          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n45\t\n46\t\n47\t(deftest fixtures-on-the-walker-test\n48\t  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n49\t          :let [r (h/run-raw source)]]\n50\t    (is (not= :pending oracle) (name id))\n51\t    (is (= out (h/latin1->text (:php/out r))) (name id))\n52\t    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n53\t    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n54\t        (name id))))\n55\t\n56\t\n57\t(defn- app?\n58\t  [node op]\n59\t  (and (map? node)\n60\t       (= :application (:type node))\n61\t       (= {:type :variable, :name op} (:operator node))))\n62\t\n63\t\n64\t(defn- lowered-ts\n65\t  [source]\n66\t  (let [{:keys [program diagnostics]} (ts/lower-source source :bundled)]\n67\t    (assert (nil? diagnostics) (pr-str diagnostics))\n68\t    (let [{:yin/keys [batch root]} program]\n69\t      (nth batch root))))\n70\t\n71\t\n72\t(defn- find-path\n73\t  \"Find one node while visiting each collection identity once. Lowered trees\n74\t   share subtrees; ordinary postwalk expands those shares needlessly.\"\n75\t  [pred tree]\n76\t  (let [seen (java.util.IdentityHashMap.)\n77\t        found (volatile! nil)]\n78\t    (letfn [(visit\n79\t              [node path]\n80\t              (when (and (nil? @found) (pred node))\n81\t                (vreset! found path))\n82\t              (when (and (nil? @found) (coll? node)\n83\t                         (not (.containsKey seen node)))\n84\t                (.put seen node true)\n85\t                (cond\n86\t                  (map? node)\n87\t                  (doseq [[k v] node :while (nil? @found)]\n88\t                    (visit v (conj path k)))\n89\t\n90\t                  (sequential? node)\n91\t                  (doseq [[i v] (map-indexed vector node) :while (nil? @found)]\n92\t                    (visit v (conj path i)))\n93\t\n94\t                  :else nil)))]\n95\t      (visit tree [])\n96\t      @found)))\n97\t\n98\t\n99\t(defn- install-php-function-export\n100\t  \"Project a published JS global into PHP's function namespace before the\n101\t   source body. The caller tree contains a name reference, never donor code.\"\n102\t  [ast export-name]\n103\t  (let [projection (u/sexp->uast\n104\t                     (list 'cell/set! 'php.rt/functions\n105\t                           (list 'assoc\n106\t                                 '(cell/get php.rt/functions)\n107\t                                 export-name\n108\t                                 (list 'js/global-get {:js/str export-name}))))\n109\t        path (find-path #(app? % 'php/run-main) ast)]\n110\t    (assert path \"PHP program has no php/run-main application\")\n111\t    (update-in ast path\n112\t               (fn [node]\n113\t                 (let [body (first (:operands node))]\n114\t                   (assert (= :lambda (:type body)) \"php/run-main body is not a lambda\")\n115\t                   (assoc node :operands\n116\t                          [(update body :body #(u/then projection %))]))))))\n117\t\n118\t\n119\t(defn- run-with-ts-export\n120\t  [donor-source export-name php-source]\n121\t  (let [donor (lowered-ts donor-source)\n122\t        {:keys [ast diagnostics]} (h/lower-program php-source)\n123\t        _ (assert (nil? diagnostics) (pr-str diagnostics))\n124\t        php-ast (install-php-function-export ast export-name)\n125\t        vm0 (tu/create-vm {:modules (php-h/host-registry)})\n126\t        ;; Complete the donor first. Its global table owns the live function\n127\t        ;; cell; the caller AST below only reads the published name.\n128\t        vm1 (vm/eval vm0 donor)\n129\t        result (vm/value (vm/eval vm1 php-ast))]\n130\t    (h/render result)))"}
{"role":"tool","tool_call_id":"tool_wQYK6kXia6PO3Fpaf3ORdAK1","content":"1\t(ns yang.php.antlr.programs-p3b\n2\t  \"Stage 0 (P3 remainder, branch yang-php-p3b) fixture data: sources, expected\n3\t   output pinned from the normative rows of docs/design/yang.php.md section 4,\n4\t   the registry and the activation manifest (P4 plan v2, correction 7).\n5\t\n6\t   Schema (extends `yang.php.antlr.programs`):\n7\t     :id        keyword\n8\t     :rows      design rows (section 4) the fixture pins\n9\t     :group     :ref-lifecycle-v1 | :iteration-v1 | :temps-v1 | :calls-v1 |\n10\t                :closures-v1 | :destructure-v1 | :oracle-only\n11\t     :level     :program (lowered and run) | :prelude (cell-level, no source run)\n12\t     :requires  implementation steps (P3 plan S2..S8) that must be complete\n13\t     :source    PHP source\n14\t     :out       expected stdout pinned from the rows, or absent for oracle-only\n15\t     :oracle    `:pending` until the shiva recording pass has run; `pin` then\n16\t                folds the recorded result. A recorded result is authoritative\n17\t                and replaces any hand-authored output pin.\n18\t\n19\t   `all-fixtures` is unconditional (the oracle iterates it). `enabled` is the\n20\t   subset whose :requires are all in `completed-steps`; implementation runners\n21\t   execute only that subset. Activation is monotonic: a step is added to\n22\t   `completed-steps` when its slice lands, never removed.\")\n23\t\n24\t\n25\t(def completed-steps\n26\t  \"Implementation steps of the P3 plan that have landed. S1 is the counted-cell\n27\t   substrate (b317c139); S2 to S5 (marker-aware variables, write/unset fetches, `=&`, `global`,\n28\t   `static` binding, by-reference parameters, marker-preserving sorts) are\n29\t   confirmed by the parser run.\"\n30\t  #{:s1 :s2 :s3 :s4 :s5 :s6 :s7 :s8})\n31\t\n32\t\n33\t(defn- fx\n34\t  [id group rows requires source out]\n35\t  (cond-> {:id id,\n36\t           :group group,\n37\t           :rows rows,\n38\t           :level :program,\n39\t           :requires requires,\n40\t           :source source,\n41\t           :oracle :pending}\n42\t    out (assoc :out out)))\n43\t\n44\t\n45\t(def ref-lifecycle-v1\n46\t  [(fx :ref-alias-write :ref-lifecycle-v1 [2 4] #{:s4}\n47\t       \"<?php $x = 1; $y = &$x; $y = 2; echo $x;\" \"2\")\n48\t   (fx :ref-unset-breaks-binding :ref-lifecycle-v1 [8] #{:s4}\n49\t       \"<?php $x = 1; $y = &$x; unset($y); $y = 5; echo $x, $y;\" \"15\")\n50\t   (fx :ref-self-assign :ref-lifecycle-v1 [4] #{:s4}\n51\t       \"<?php $x = 1; $x = &$x; $x = 3; echo $x;\" \"3\")\n52\t   (fx :ref-element-survives-copy :ref-lifecycle-v1 [1 6] #{:s4}\n53\t       \"<?php $a = [1, 2]; $r = &$a[0]; $b = $a; $b[0] = 9; echo $a[0];\" \"9\")\n54\t   (fx :ref-element-unwrapped-after-unset :ref-lifecycle-v1 [1 6 8] #{:s4}\n55\t       \"<?php $a = [1]; $r = &$a[0]; unset($r); $b = $a; $b[0] = 9; echo $a[0];\" \"1\")\n56\t   (fx :ref-element-target :ref-lifecycle-v1 [5] #{:s4}\n57\t       \"<?php $x = 1; $a = []; $a[0] = &$x; $a[0] = 4; echo $x;\" \"4\")\n58\t   (fx :ref-array-literal-element :ref-lifecycle-v1 [3 5] #{:s3}\n59\t       \"<?php $x = 1; $a = [&$x]; $a[0] = 2; echo $x;\" \"2\")\n60\t   (fx :ref-array-literal-nested-path :ref-lifecycle-v1 [3 10] #{:s3}\n61\t       \"<?php $a = ['x' => [1]]; $r = &$a['x'][0]; $r = 7; echo $a['x'][0];\" \"7\")\n62\t   (fx :ref-vivify-by-reference :ref-lifecycle-v1 [3] #{:s4}\n63\t       \"<?php $r = &$a['k']; $r = 5; echo $a['k'];\" \"5\")\n64\t   (fx :ref-global-binds-local :ref-lifecycle-v1 [4 17] #{:s5}\n65\t       \"<?php $g = 1; function f() { global $g; $g = 2; } f(); echo $g;\" \"2\")\n66\t   (fx :ref-global-unset-keeps-global :ref-lifecycle-v1 [8] #{:s5}\n67\t       \"<?php $g = 1; function f() { global $g; unset($g); $g = 5; } f(); echo $g;\" \"1\")\n68\t   (fx :ref-global-at-root-noop :ref-lifecycle-v1 [4] #{:s5}\n69\t       \"<?php $g = 1; global $g; $g = 2; echo $g;\" \"2\")\n70\t   (fx :ref-static-binds-persistent-slot :ref-lifecycle-v1 [17] #{:s5}\n71\t       \"<?php function c() { static $n = 0; return ++$n; } c(); c(); echo c();\" \"3\")\n72\t   (fx :ref-static-rebind-leaves-persistent :ref-lifecycle-v1 [17] #{:s5}\n73\t       (str \"<?php function c() { static $n = 0; $y = 100; $n++; $n = &$y; return $n; }\"\n74\t            \" echo c(), c();\")\n75\t       \"100100\")\n76\t   (fx :ref-param-by-reference :ref-lifecycle-v1 [13 14] #{:s5}\n77\t       \"<?php function inc(&$n) { $n++; } $v = 1; inc($v); echo $v;\" \"2\")\n78\t   (fx :ref-param-array-element :ref-lifecycle-v1 [14 35] #{:s5}\n79\t       \"<?php function f(&$n) { $n = 7; } $a = [1]; f($a[0]); echo $a[0];\" \"7\")\n80\t   (fx :ref-param-by-value-is-a-copy :ref-lifecycle-v1 [13] #{:s5}\n81\t       \"<?php function f($n) { $n = 7; } $v = 1; f($v); echo $v;\" \"1\")\n82\t   (fx :ref-builtin-sort-over-reference-slot :ref-lifecycle-v1 [21] #{:s5}\n83\t       \"<?php $x = 3; $a = [&$x, 1, 2]; sort($a); $x = 9; echo implode(',', $a);\"\n84\t       \"1,2,9\")\n85\t   (fx :ref-function-release-cvs :ref-lifecycle-v1 [16] #{:s2}\n86\t       \"<?php function f() { $a = [1, 2]; $b = $a; $b[] = 3; return count($b); } echo f(), f();\"\n87\t       \"33\")])\n88\t\n89\t\n90\t(def iteration-v1\n91\t  [(fx :foreach-ref-doubles :iteration-v1 [24 25 27] #{:s7}\n92\t       \"<?php $a = [1, 2, 3]; foreach ($a as &$v) { $v *= 2; } unset($v); echo implode(',', $a);\"\n93\t       \"2,4,6\")\n94\t   (fx :foreach-ref-leftover-binding :iteration-v1 [24 27] #{:s7}\n95\t       \"<?php $a = [1, 2, 3]; foreach ($a as &$v) {} foreach ($a as $v) {} echo implode(',', $a);\"\n96\t       \"1,2,2\")\n97\t   (fx :foreach-ref-leftover-unset-fixes :iteration-v1 [24 27] #{:s7}\n98\t       (str \"<?php $a = [1, 2, 3]; foreach ($a as &$v) {} unset($v);\"\n99\t            \" foreach ($a as $v) {} echo implode(',', $a);\")\n100\t       \"1,2,3\")"}
