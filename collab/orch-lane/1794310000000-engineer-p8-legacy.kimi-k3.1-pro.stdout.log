{"role":"tool","tool_call_id":"tool_s0fgO58Hy8RIscl3TYv05cq0","content":"1\t(require '[clojure.java.io :as io]\n2\t         '[yang.php.antlr.cst :as cst]\n3\t         '[yang.php.antlr.e2e-harness :as h])\n4\t\n5\t(def samples\n6\t  {:basic-math \"10 + 20;\"\n7\t   :closure-power \"$makePower = function (int $exponent) {\\n  return function (int $base) use ($exponent): int {\\n    $result = 1;\\n    for ($i = 0; $i < $exponent; $i++) {\\n      $result *= $base;\\n    }\\n    return $result;\\n  };\\n};\\n$cube = $makePower(3);\\n$cube(2);\"\n8\t   :factorial \"function fact($n) {\\n  if ($n == 0) {\\n    return 1;\\n  } else {\\n    return $n * fact($n - 1);\\n  }\\n}\\nfact(5);\"\n9\t   :fibonacci \"function fib($n) {\\n  if ($n < 2) {\\n    return $n;\\n  } else {\\n    return fib($n - 1) + fib($n - 2);\\n  }\\n}\\nfib(7);\"})\n10\t\n11\t(let [target (io/file \"src/cljc/yang/php/antlr/demo_packets.cljc\")\n12\t      forms (into (sorted-map)\n13\t                  (map (fn [[id source]]\n14\t                         [id (h/packet->form (cst/parse-source (str \"<?php \" source)))])\n15\t                       samples))]\n16\t  (io/make-parents target)\n17\t  (spit target\n18\t        (str \"(ns yang.php.antlr.demo-packets\\n\"\n19\t             \"  \\\"Generated CST forms for the browser demo; see test/resources/yang/php/demo_packets.generate.clj.\\\")\\n\\n\"\n20\t             \"(def forms '\\n\"\n21\t             (pr-str forms)\n22\t             \")\\n\")))"}
{"role":"tool","tool_call_id":"tool_PIXgSi4ZUdHTDbFY4tAbUxqX","content":"151\t\n152\t\n153\t(defn- form->packet\n154\t  [form]\n155\t  (let [nodes (atom [])]\n156\t    (letfn [(visit [f]\n157\t              (let [id (count @nodes)]\n158\t                (if (string? (first f))\n159\t                  (do (swap! nodes conj {:id id, :kind :token, :type (first f),\n160\t                                         :text (second f), :span [0 0]})\n161\t                      id)\n162\t                  (do (swap! nodes conj nil)"}
