{"role":"assistant","tool_calls":[{"type":"function","id":"tool_5dWARg1tyjyKsuQqP2E91H4L","function":{"name":"Edit","arguments":"{\"path\":\"/Users/sto/workspace/datomworld-p8/src/cljs/datomworld/demo/compilation_pipeline.cljs\",\"old_string\":\"(defn compile-source!\\n  []\\n  (stop-run-loop!)\\n  (try (let [source (:source @app-state)\\n             lang (:source-lang @app-state)\\n             ast (case lang\\n                   :clojure (yang/compile-program\\n                              (reader/read-string (str \\\"[\\\" source \\\"]\\\")))\\n                   :python (py.repl/lower\\n                             (py.parser/parse-source (str source \\\"\\\\n\\\")))\\n                   :php (php-comp/compile source))\",\"new_string\":\"(defn- form->packet\\n  [form]\\n  (let [nodes (atom [])]\\n    (letfn [(visit [f]\\n              (let [id (count @nodes)]\\n                (if (string? (first f))\\n                  (do (swap! nodes conj {:id id, :kind :token, :type (first f),\\n                                         :text (second f), :span [0 0]})\\n                      id)\\n                  (do (swap! nodes conj nil)\\n                      (let [children (mapv visit (rest f))]\\n                        (swap! nodes assoc id {:id id, :kind :rule,\\n                                               :rule (name (first f)),\\n                                               :children children, :span [0 0]})\\n                        id)))))]\\n      (visit form)\\n      {:yang.cst/version 1, :yang.cst/unit [:demo 0], :yang.cst/grammar \\\"php\\\",\\n       :yang.cst/outcome :yang.cst/ok, :yang.cst/root 0,\\n       :yang.cst/nodes @nodes, :yang.cst/complete true})))\\n\\n\\n(defn- php-ast\\n  [source]\\n  (let [{:keys [id]} (some #(when (= source (:code %)) %) code-examples)\\n        form (get php.packets/forms id)]\\n    (when-not form\\n      (throw (ex-info \\\"Choose a checked-in PHP sample\\\" {:sample id})))\\n    (php.lower/lower-packet (form->packet