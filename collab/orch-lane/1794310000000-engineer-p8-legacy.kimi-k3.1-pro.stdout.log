294\t       (str \"<?php spl_autoload_register(function ($c) { require __DIR__ . '/lib/' . $c . '.php'; });\"\n295\t            \" echo (new Foo)->hi();\")\n296\t       \"foo\"\n297\t       :class-map {:classes {\"Foo\" \"lib/Foo.php\"}})\n298\t   (fx :auto-classmap-unmapped :autoload-v1 #{:p6-s5}\n299\t       {\"lib/Foo.php\" \"<?php class Foo {}\"}\n300\t       (str \"<?php spl_autoload_register(function ($c) { require 'lib/' . $c . '.php'; });\"\n301\t            \" try { new Bar; } catch (Error $e) { echo get_class($e); }\")\n302\t       \"Error\"\n303\t       :class-map {:classes {\"Foo\" \"lib/Foo.php\"}}\n304\t       :diag [[2 \"require(lib/Bar.php): Failed to open stream: No such file or directory\"]])\n305\t   (fx :auto-class-exists-without-autoload :autoload-v1 #{:p6-s5} nil\n306\t       (str \"<?php spl_autoload_register(function ($c) { echo 'L'; });\"\n307\t            \" var_dump(class_exists('Nope', false)); var_dump(class_exists('Nope'));\")\n308\t       \"bool(false)\\nLbool(false)\\n\")\n309\t   (fx :auto-unregister :autoload-v1 #{:p6-s5} nil\n310\t       (str \"<?php $f = function ($c) { echo 'L'; }; spl_autoload_register($f);\"\n311\t            \" var_dump(spl_autoload_unregister($f)); var_dump(class_exists('Nope'));\"\n312\t            \" var_dump(count(spl_autoload_functions()));\")\n313\t       \"bool(true)\\nbool(false)\\nint(0)\\n\")\n314\t   (fx :auto-recursion-guard :autoload-v1 #{:p6-s5} nil\n315\t       \"<?php spl_autoload_register(function ($c) { echo 'L'; class_exists($c); }); var_dump(class_exists('Nope'));\"\n316\t       \"Lbool(false)\\n\")\n317\t   (fx :auto-extends-loads-parent :autoload-v1 #{:p6-s5}\n318\t       {\"lib/B.php\" \"<?php class B { function hi() { return 'B'; } }\"}\n319\t       (str \"<?php spl_autoload_register(function ($c) { include 'lib/' . $c . '.php'; });\"\n320\t            \" class K extends B {} echo (new K)->hi();\")\n321\t       \"B\"\n322\t       :computed true)\n323\t   (fx :auto-static-call-loads :autoload-v1 #{:p6-s5}\n324\t       {\"lib/S.php\" \"<?php class S { static function hi() { return 'S'; } }\"}\n325\t       (str \"<?php spl_autoload_register(function ($c) { include 'lib/' . $c . '.php'; });\"\n326\t            \" echo S::hi();\")\n327\t       \"S\"\n328\t       :computed true)\n329\t   (fx :auto-instanceof-does-not-load :autoload-v1 #{:p6-s5} nil\n330\t       (str \"<?php spl_autoload_register(function ($c) { echo 'L'; });\"\n331\t            \" $o = new stdClass; var_dump($o instanceof Nope);\")\n332\t       \"bool(false)\\n\")\n333\t   (fx :auto-loader-order :autoload-v1 #{:p6-s5} nil\n334\t       (str \"<?php spl_autoload_register(function ($c) { echo '1'; });\"\n335\t            \" spl_autoload_register(function ($c) { echo '2'; });\"\n336\t            \" spl_autoload_register(function ($c) { echo '0'; }, true, true);\"\n337\t            \" class_exists('Nope');\")\n338\t       \"012\")])\n339\t\n340\t\n341\t(def banner p3b/banner)\n342\t\n343\t\n344\t(def all-fixtures\n345\t  \"Unconditional registry; the oracle iterates it regardless of activation.\"\n346\t  (vec (concat inclusion-v1 missing-v1 strict-v1 dynscope-v1 namespaces-v1 constants-v1 autoload-v1)))\n347\t\n348\t\n349\t(defn enabled?\n350\t  \"True when every step the fixture requires has landed.\"\n351\t  [fixture]\n352\t  (p3b/enabled? fixture completed-steps))\n353\t\n354\t\n355\t(def enabled\n356\t  \"The subset implementation runners execute.\"\n357\t  (vec (filter enabled? all-fixtures)))\n358\t\n359\t\n360\t(def awaiting-oracle\n361\t  \"Every enabled fixture: none has been recorded yet (the shiva pass is the\n362\t   orchestrator's).\"\n363\t  (set (map :id (filter #(= :pending (:oracle %)) enabled))))"}
{"role":"tool","tool_call_id":"tool_iE2QoBcd3tmfdbUQExSR9dpO","content":"1\t(ns yin.repl.frontends\n2\t  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n3\t   8.5.6, slice F2): the hand-written Clojure and PHP frontends and the\n4\t   ANTLR Python frontend installed into a `yang.frontend` catalog. This is\n5\t   the only place the REPL composition names a language's namespace;\n6\t   `yin.repl` core steps whatever binding the catalog selects.\n7\t\n8\t   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n9\t   `:input :forms` when the frontend consumes the forms the shell reader\n10\t   already read, else the source text.\"\n11\t  (:require\n12\t    [yang.clojure :as yang.clojure]\n13\t    [yang.frontend :as frontend]\n14\t    [yang.php :as yang.php]\n15\t    #?@(:cljd [[yang.python.antlr.repl :as python.antlr.repl]\n16\t               [yang.python.antlr.parser :as python.antlr.parser]\n17\t               [yang.python.antlr.repl-probe :as python.antlr.probe]]\n18\t        :default [[yang.python.antlr.repl :as python.antlr.repl]\n19\t                  [yang.python.antlr.parser :as python.antlr.parser]\n20\t                  [yang.python.antlr.repl-probe :as python.antlr.probe]])\n21\t    [yin.repl :as repl]))\n22\t\n23\t\n24\t(defn- manifest\n25\t  [id language]\n26\t  {:yang.frontend/id id,\n27\t   :yang.frontend/spi 1,\n28\t   :yang.frontend/revision \"legacy-1\",\n29\t   :yang.frontend/language language,\n30\t   :yang.frontend/grammar {:yang.grammar/package \"none\",\n31\t                           :yang.grammar/entries {:module \"program\"},\n32\t                           :yang.grammar/export-profile :yang.cst/v1},\n33\t   :yang.frontend/options-schema :segment/none,\n34\t   :yang.frontend/lowering-profile :segment/legacy,\n35\t   :yang.frontend/runtime-profile :segment/legacy,\n36\t   :yang.frontend/support-profile :segment/legacy})\n37\t\n38\t\n39\t(defn- clojure-lower\n40\t  [forms]\n41\t  (if (= 1 (count forms))\n42\t    (yang.clojure/compile (first forms))\n43\t    (yang.clojure/compile-program forms)))\n44\t\n45\t\n46\t(defn- antlr-manifest\n47\t  []\n48\t  (assoc (manifest :yang/python :python)\n49\t         :yang.frontend/revision \"f4\"\n50\t         :yang.frontend/grammar\n51\t         {:yang.grammar/package \"python3\",\n52\t          :yang.grammar/entries {:module \"file_input\"},\n53\t          :yang.grammar/export-profile :yang.cst/v1,\n54\t          :yang.grammar/targets #{:java :javascript :dart}}))\n55\t\n56\t\n57\t(defn standard\n58\t  \"The standard catalog. The Clojure frontend consumes the forms the\n59\t   shell's own reader read, so its parse stage is the identity.  The ANTLR\n60\t   frontend is the Python frontend, installed on every host, each running\n61\t   its own generated target of the one grammar.  It shows what a submission\n62\t   printed and the value rendered by its `:render` (Python repr).\"\n63\t  []\n64\t  (cond-> frontend/empty-catalog\n65\t    true (frontend/install (manifest :yang/clojure :clojure)\n66\t                           {:input :forms,\n67\t                            :parse identity,\n68\t                            :lower clojure-lower})\n69\t    true (frontend/install (manifest :yang/php :php)\n70\t                           {:parse identity, :lower yang.php/compile})\n71\t    #?@(:cljd [true (frontend/install\n72\t                      (antlr-manifest)\n73\t                      {:parse (fn [source]\n74\t                                (python.antlr.parser/parse-source (str source \"\\n\"))),\n75\t                       :lower python.antlr.repl/lower,\n76\t                       :primitives python.antlr.repl/primitives,\n77\t                       :lower-session python.antlr.repl/lower-session,\n78\t                       :render python.antlr.repl/display-value,\n79\t                       :probe python.antlr.probe/probe})]\n80\t        ;; jolt (J5): installed over the C++ parser when native/jolt-parser\n81\t        ;; is available; otherwise left out, so (lang :yang/python) answers\n82\t        ;; unavailable-parser, never another parser\n83\t        :jolt [(python.antlr.parser/available?)\n84\t               (frontend/install\n85\t                 (antlr-manifest)\n86\t                 {;; a :parser-budget or :unavailable-parser refusal names\n87\t                  ;; the language it refused\n88\t                  :parse (fn [source]\n89\t                           (try (python.antlr.parser/parse-source (str source \"\\n\"))\n90\t                                (catch Exception e\n91\t                                  (if (#{:parser-budget :unavailable-parser}\n92\t                                       (:diagnostic (ex-data e)))\n93\t                                    (throw (ex-info (ex-message e)\n94\t                                                    (assoc (ex-data e) :lang :yang/python)\n95\t                                                    e))\n96\t                                    (throw e))))),\n97\t                  :lower python.antlr.repl/lower,\n98\t                  :primitives python.antlr.repl/primitives,\n99\t                  :lower-session python.antlr.repl/lower-session,\n100\t                  :render python.antlr.repl/display-value,\n101\t                  :probe python.antlr.probe/probe})]\n102\t        :default [true (frontend/install\n103\t                         (antlr-manifest)\n104\t                         {:parse (fn [source]\n105\t                                   (python.antlr.parser/parse-source (str source \"\\n\"))),\n106\t                          :lower python.antlr.repl/lower,\n107\t                          :primitives python.antlr.repl/primitives,\n108\t                          :lower-session python.antlr.repl/lower-session,\n109\t                          :render python.antlr.repl/display-value,\n110\t                          :probe python.antlr.probe/probe})])))\n111\t\n112\t\n113\t(defn create-state\n114\t  \"`yin.repl/create-state` composed with the standard catalog unless the\n115\t   host supplies its own `:frontends`.  Each binding registers its own\n116\t   `:primitives`; none is merged ambiently.\"\n117\t  ([] (create-state {}))\n118\t  ([opts]\n119\t   (repl/create-state (update opts :frontends #(or % (standard))))))"}
{"role":"tool","tool_call_id":"tool_G5iizvg1O2l2sXYh72TZNeij","content":"1\t(ns datomworld.demo.compilation-pipeline\n2\t  \"The Yin compilation pipeline on Yin VM v2: Source -> AST -> canonical\n3\t   datoms -> ast-walker execution.\n4\t\n5\t   The v1 demo (`datomworld.demo.compilation-pipeline`) compiled the same\n6\t   source through four evaluators — stack, register, semantic and ast-walker —\n7\t   and showed each one's bytecode beside the shared datom store, with a\n8\t   `dao.space` query panel over the transacted datoms.\n9\t\n10\t   `yin.vm` ships one evaluator. The divergence register states it\n11\t   directly: `semantic`, `register`, `stack`, `space`, `macro` and `wasm` are\n12\t   not ported, and user macros throw. So this pipeline has one compilation\n13\t   path and one execution path:\n14\t\n15\t   - **Source -> AST** is unchanged: `yang.clojure/compile-program`.\n16\t   - **AST -> canonical datoms** is unchanged: `vm/ast->datoms` is shared\n17\t     kernel, reused by v2 rather than forked.\n18\t   - **Execution** is `yin.vm.ast-walker`, constructed with a\n19\t     composition-supplied `:make-stream` over the DaoStream v2 ring buffer.\n20\t     There is no bytecode, no assembler, no pool and no source map to show.\n21\t   - Programs are loaded with `ast-walker/vm-load-program`, the loader host\n22\t     composition hands to observer coordination. The demo calls it directly\n23\t     because it animates one `vm/step` at a time; the VM owns no program\n24\t     medium of its own and accepts no `:in-stream`.\n25\t\n26\t   What the v1 demo showed that this one cannot: register and stack\n27\t   instruction listings with active-instruction highlighting, the semantic\n28\t   evaluator's AST database, and `dao.space` queries over the transacted\n29\t   datoms. Those are v1 evaluator features, not v2 gaps in a demo.\n30\t\n31\t   The Clojure/Python/PHP language selection (`yang.clojure`, the ANTLR\n32\t   Python frontend `yang.python.antlr`, `yang.php` all compile to the same\n33\t   `:yin/*` AST) is ported from v1 unchanged — it is a Source->AST axis,\n34\t   orthogonal to which evaluator runs the result, and dropping it would be\n35\t   a product regression this plan does not make.\"\n36\t  (:require [\"@codemirror/lang-php\" :refer [php]]\n37\t            [\"@codemirror/lang-python\" :refer [python]]\n38\t            [\"@codemirror/state\" :refer [EditorState]]\n39\t            [\"@codemirror/theme-one-dark\" :refer [oneDark]]\n40\t            [\"@codemirror/view\" :refer [EditorView]]\n41\t            [\"@nextjournal/lang-clojure\" :refer [clojure]]\n42\t            [\"codemirror\" :refer [basicSetup]]\n43\t            [cljs.reader :as reader]\n44\t            [clojure.string :as str]\n45\t            [dao.stream.ringbuffer :as ringbuffer]\n46\t            [datomworld.demo.responsive :as responsive]\n47\t            [reagent.core :as r]\n48\t            [yang.clojure :as yang]\n49\t            [yang.php :as php-comp]\n50\t            [yang.python.antlr.parser :as py.parser]\n51\t            [yang.python.antlr.repl :as py.repl]\n52\t            [yin.demo.utils :as demo.utils]\n53\t            [yin.vm :as vm]\n54\t            [yin.vm.ast-walker :as ast-walker]\n55\t            [yin.vm.module :as module]))\n56\t\n57\t\n58\t(def ^:private pretty-print demo.utils/pretty-print)\n59\t\n60\t\n61\t(def default-source\n62\t  \"(defn fact [n acc]\n63\t  (if (= n 0)\n64\t    acc\n65\t    (fact (- n 1) (* n acc))))\n66\t\n67\t(fact 10 1)\")\n68\t\n69\t\n70\t;; =============================================================================\n71\t;; The composition\n72\t;; =============================================================================\n73\t\n74\t(defn- make-stream\n75\t  \"The `:make-stream` this composition hands the VM: one DaoStream v2 ring\n76\t   buffer per call. A nil capacity is the VM's default, not an unbounded\n77\t   stream; v2 has no unbounded mode.\"\n78\t  [capacity]\n79\t  (ringbuffer/create!\n80\t    {:dao.stream/type ringbuffer/transport-type,\n81\t     ringbuffer/capacity-key (or capacity vm/default-stream-capacity)}))\n82\t\n83\t\n84\t(defn- make-vm\n85\t  []\n86\t  (ast-walker/create-vm\n87\t    {:primitives (merge vm/primitives py.repl/primitives),\n88\t     :modules (module/register-stream-module (module/default-registry)),\n89\t     :make-stream make-stream,\n90\t     :capability-secret (str (random-uuid))}))\n91\t\n92\t\n93\t(defn- load-program!\n94\t  \"Load one canonical datom batch onto a fresh VM.\"\n95\t  [datoms]\n96\t  (ast-walker/vm-load-program (make-vm) (vec datoms) vm/ast-contract))\n97\t\n98\t\n99\t(defonce app-state\n100\t  (r/atom {:source default-source,\n101\t           :source-lang :clojure,\n102\t           :ast nil,\n103\t           :datom-groups nil,\n104\t           :datoms nil,\n105\t           :walker nil,\n106\t           :walker-running false,\n107\t           :walker-result nil,\n108\t           :steps 0,\n109\t           :error nil}))\n110\t\n111\t\n112\t(defonce run-raf-id (atom nil))\n113\t\n114\t\n115\t(defn stop-run-loop!\n116\t  []\n117\t  (when @run-raf-id\n118\t    (js/cancelAnimationFrame @run-raf-id)\n119\t    (reset! run-raf-id nil))\n120\t  (swap! app-state assoc :walker-running false))\n121\t\n122\t\n123\t(defn set-source!\n124\t  [next-source]\n125\t  (stop-run-loop!)\n126\t  (swap! app-state assoc\n127\t         :source next-source\n128\t         :ast nil\n129\t         :datom-groups nil\n130\t         :datoms nil\n131\t         :walker nil\n132\t         :walker-result nil\n133\t         :steps 0\n134\t         :error nil))\n135\t\n136\t\n137\t(defn set-source-lang!\n138\t  [next-lang]\n139\t  (stop-run-loop!)\n140\t  (swap! app-state assoc\n141\t         :source-lang next-lang\n142\t         :ast nil\n143\t         :datom-groups nil\n144\t         :datoms nil\n145\t         :walker nil\n146\t         :walker-result nil\n147\t         :steps 0\n148\t         :error nil))\n149\t\n150\t\n151\t(defn compile-source!\n152\t  []\n153\t  (stop-run-loop!)\n154\t  (try (let [source (:source @app-state)\n155\t             lang (:source-lang @app-state)\n156\t             ast (case lang\n157\t                   :clojure (yang/compile-program\n158\t                              (reader/read-string (str \"[\" source \"]\")))\n159\t                   :python (py.repl/lower\n160\t                             (py.parser/parse-source (str source \"\\n\")))\n161\t                   :php (php-comp/compile source))\n162\t             datoms (vec (vm/ast->datoms ast))\n163\t             walker (load-program! datoms)]\n164\t         (swap! app-state assoc\n165\t                :ast ast\n166\t                :datoms datoms\n167\t                :walker walker\n168\t                :walker-running false\n169\t                :walker-result nil\n170\t                :steps 0\n171\t                :error nil))\n172\t       (catch :default e\n173\t         (swap! app-state assoc\n174\t                :error (str \"Compile error: \" (.-message e))\n175\t                :ast nil\n176\t                :datoms nil\n177\t                :walker nil\n178\t                :walker-running false\n179\t                :walker-result nil))))\n180\t\n181\t\n182\t(defn reset-walker!\n183\t  []\n184\t  (let [{:keys [datoms]} @app-state]\n185\t    (when (seq datoms)\n186\t      (stop-run-loop!)\n187\t      (swap! app-state assoc\n188\t             :walker (load-program! datoms)\n189\t             :walker-running false\n190\t             :walker-result nil\n191\t             :steps 0\n192\t             :error nil))))\n193\t\n194\t\n195\t(defn- step-state\n196\t  \"One step as a pure state transition, shared by `step-walker!` and\n197\t   `run-frame!`'s inner loop.\"\n198\t  [state]\n199\t  (let [vm (:walker state)]\n200\t    (cond (nil? vm) (assoc state :walker-running false)\n201\t          (vm/halted? vm) (assoc state :walker-running false)\n202\t          :else (try (let [vm' (vm/step vm)]\n203\t                       (assoc state\n204\t                              :walker vm'\n205\t                              :steps (inc (:steps state))\n206\t                              :walker-result (when (vm/halted? vm')\n207\t                                               (vm/value vm'))\n208\t                              :walker-running (not (vm/halted? vm'))\n209\t                              :error nil))\n210\t                     (catch :default e\n211\t                       (assoc state\n212\t                              :walker-running false\n213\t                              :error (str \"VM step error: \"\n214\t                                          (.-message e))))))))\n215\t\n216\t\n217\t(defn step-walker!\n218\t  []\n219\t  (stop-run-loop!)\n220\t  (swap! app-state step-state))\n221\t\n222\t\n223\t(def steps-per-frame 200)\n224\t\n225\t\n226\t(defn run-frame!\n227\t  []\n228\t  (swap! app-state\n229\t         (fn [state]\n230\t           (loop [i 0\n231\t                  s state]\n232\t             (if (or (>= i steps-per-frame)\n233\t                     (not (:walker-running s))\n234\t                     (:walker-result s))\n235\t               s\n236\t               (recur (inc i) (step-state s))))))\n237\t  (let [running (:walker-running @app-state)]\n238\t    (if running\n239\t      (reset! run-raf-id (js/requestAnimationFrame run-frame!))\n240\t      (reset! run-raf-id nil))))\n241\t\n242\t\n243\t(defn toggle-run!\n244\t  []\n245\t  (let [{:keys [walker walker-running]} @app-state]\n246\t    (cond (nil? walker) nil\n247\t          walker-running (stop-run-loop!)\n248\t          (vm/halted? walker) nil\n249\t          :else (do (swap! app-state assoc :walker-running true :error nil)\n250\t                    (reset! run-raf-id\n251\t                            (js/requestAnimationFrame run-frame!))))))\n252\t\n253\t\n254\t;; =============================================================================\n255\t;; CodeMirror editor\n256\t;; =============================================================================\n257\t\n258\t(defn codemirror-editor\n259\t  [{:keys [value on-change read-only language]}]\n260\t  (let [view-ref (r/atom nil)\n261\t        el-ref (atom nil)]\n262\t    (r/create-class\n263\t      {:display-name \"pipeline-v2-codemirror-editor\",\n264\t       :component-did-mount\n265\t       (fn [_]\n266\t         (when-let [node @el-ref]\n267\t           (let [theme (.theme EditorView\n268\t                               #js {\"&\" #js {:height \"100%\"},\n269\t                                    \".cm-scroller\" #js {:overflow \"auto\"}})\n270\t                 lang-ext (case (or language :clojure)\n271\t                            :python (python)\n272\t                            :php (php #js {:plain true})\n273\t                            :clojure (clojure))\n274\t                 extensions\n275\t                 (cond-> #js [basicSetup lang-ext oneDark theme]\n276\t                   read-only (.concat #js [(.of (.-editable EditorView)\n277\t                                                false)])\n278\t                   on-change\n279\t                   (.concat\n280\t                     #js [(.of\n281\t                            (.-updateListener EditorView)\n282\t                            (fn [^js update]\n283\t                              (when (and (.-docChanged update) on-change)\n284\t                                (on-change\n285\t                                  (.. update -state -doc toString)))))]))\n286\t                 state (.create EditorState\n287\t                                #js {:doc (or value \"\"),\n288\t                                     :extensions extensions})\n289\t                 view (new EditorView #js {:state state, :parent node})]\n290\t             (reset! view-ref view)))),\n291\t       :component-did-update\n292\t       (fn [this _]\n293\t         (let [{:keys [value]} (r/props this)]\n294\t           (when-let [view @view-ref]\n295\t             (let [current (.. view -state -doc toString)]\n296\t               (when (not= value current)\n297\t                 (.dispatch view\n298\t                            #js {:changes #js\n299\t                                          {:from 0,\n300\t                                           :to (.. view -state -doc -length),\n301\t                                           :insert (or value \"\")}})))))),\n302\t       :component-will-unmount (fn [_]\n303\t                                 (when-let [view @view-ref]\n304\t                                   (.destroy view))),\n305\t       :reagent-render\n306\t       (fn [{:keys [style]}]\n307\t         [:div\n308\t          {:ref #(reset! el-ref %),\n309\t           :style (merge {:height \"100%\",\n310\t                          :width \"100%\",\n311\t                          :border \"1px solid #2d3b55\",\n312\t                          :overflow \"hidden\"}\n313\t                         style)}])})))\n314\t\n315\t\n316\t;; =============================================================================\n317\t;; UI\n318\t;; =============================================================================\n319\t\n320\t(defn- card\n321\t  [title subtitle body]\n322\t  [:div\n323\t   {:style {:background \"#0e1328\",\n324\t            :border \"1px solid #2d3b55\",\n325\t            :box-shadow \"0 10px 25px rgba(0,0,0,0.5)\",\n326\t            :display \"flex\",\n327\t            :flex-direction \"column\",\n328\t            :min-height \"0\"}}\n329\t   [:div\n330\t    {:style {:background \"#151b33\",\n331\t             :padding \"8px 10px\",\n332\t             :border-bottom \"1px solid #2d3b55\",\n333\t             :display \"flex\",\n334\t             :flex-direction \"column\",\n335\t             :gap \"2px\"}}\n336\t    [:strong {:style {:color \"#f1f5ff\", :font-size \"13px\"}} title]\n337\t    [:span {:style {:color \"#8b949e\", :font-size \"11px\"}} subtitle]]\n338\t   [:div\n339\t    {:style {:padding \"10px\",\n