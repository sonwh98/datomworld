{"role":"tool","tool_call_id":"tool_HJn6MTBQ73py7eDARCeY8HCo","content":"710\t        (is (str/includes? failed \":arity\"))\n711\t        (is (= 2 (:last-value state')) \"a failed expansion records no value\")\n712\t        (is (= (get-in state [:expander :ctx :store])\n713\t               (get-in state' [:expander :ctx :store]))\n714\t            \"a failed batch leaves the store as it was\")\n715\t        (is (str/includes? guarded \":depth-guard\"))\n716\t        (is (= \"3\" added))\n717\t        (is (= \"1\" unless-again) \"the source cursor advanced past both failures\")\n718\t        (is (= 1 (:last-value state'')))))))\n719\t\n720\t\n721\t(deftest a-clojure-macro-expands-calls-from-other-languages\n722\t  (let [[state _] (evaluate (repl.frontends/create-state) [unless-source twice-source\n723\t                                                           \"(defn inc2 [x] (+ x 2))\"])]\n724\t    (testing \"PHP\"\n725\t      (let [[_ texts] (results state [\"(lang :yang/php)\"\n726\t                                      \"unless(false, 1, 2);\"\n727\t                                      \"twice(21);\"\n728\t                                      \"inc2(3);\"])]\n729\t        (is (= [\"1\" \"42\" \"5\"] (rest texts)))))))\n730\t\n731\t\n732\t(deftest a-python-submission-cannot-see-a-clojure-defined-name\n733\t  (let [[state _] (evaluate (repl.frontends/create-state) [\"(def clj_only 41)\"])\n734\t        [_ texts] (results state [\"(lang :yang/python)\" \"print(clj_only)\"])]\n735\t    (is (= \"NameError: name 'clj_only' is not defined\\n\" (nth texts 1)))))\n736\t\n737\t\n738\t(deftest a-host-function-renders-as-a-named-portable-marker\n739\t  (doseq [vm-type (keys repl/vm-constructors)]\n740\t    (testing (str vm-type)\n741\t      (let [[_ [plus _ q nested alias _ closure]]\n742\t            (results (repl.frontends/create-state {:vm-type vm-type})\n743\t                     [\"+\"\n744\t                      \"(require (quote dao.space.query))\"\n745\t                      \"dao.space.query/q\"\n746\t                      \"(conj [] + (assoc {} :f -))\"\n747\t                      \"==\"\n748\t                      \"(defn inc [i] (+ i 1))\"\n749\t                      \"inc\"])]"}
{"role":"tool","tool_call_id":"tool_5csigBDaQ1tSfEjJj1D1MJGZ","content":"1\t(ns yin.repl.frontend-catalog-test\n2\t  \"The REPL compiles through the frontend catalog its composition supplies\n3\t   (docs/design/yang.antlr.md section 8.5.6, slice F2): a toy frontend\n4\t   defined here evaluates on every VM, a session pins its catalog snapshot,\n5\t   and an id the catalog cannot answer is an unavailable-parser diagnostic\n6\t   with no fallback.\"\n7\t  (:require\n8\t    [clojure.string :as str]\n9\t    [clojure.test :refer [deftest is testing]]\n10\t    [yang.clojure :as yang.clojure]\n11\t    [yang.frontend :as frontend]\n12\t    [yin.repl :as repl]\n13\t    [yin.repl.frontends :as repl.frontends]))\n14\t\n15\t\n16\t(defn- manifest\n17\t  [revision]\n18\t  {:yang.frontend/id :example.toy/frontend,\n19\t   :yang.frontend/spi 1,\n20\t   :yang.frontend/revision revision,\n21\t   :yang.frontend/language :toy,\n22\t   :yang.frontend/grammar {:yang.grammar/package \"grammar-address\",\n23\t                           :yang.grammar/entries {:module \"program\"},\n24\t                           :yang.grammar/export-profile :yang.cst/v1},\n25\t   :yang.frontend/options-schema \"options-address\",\n26\t   :yang.frontend/lowering-profile \"lowering-address\",\n27\t   :yang.frontend/runtime-profile \"runtime-address\",\n28\t   :yang.frontend/support-profile \"support-address\"})\n29\t\n30\t\n31\t(defn- toy-binding\n32\t  \"A toy language: a source's value is its length times `scale`.\"\n33\t  [scale]\n34\t  {:parse count,\n35\t   :lower (fn [n] (yang.clojure/compile (* scale n)))})\n36\t\n37\t\n38\t(defn- toy-catalog\n39\t  [revision scale]\n40\t  (frontend/install (repl.frontends/standard)\n41\t                    (manifest revision)\n42\t                    (toy-binding scale)))\n43\t\n44\t\n45\t(defn- run\n46\t  [state line]\n47\t  (repl/eval-input state line))\n48\t\n49\t\n50\t(deftest a-toy-frontend-evaluates-on-every-vm-test\n51\t  (let [catalog (toy-catalog \"r1\" 1)]\n52\t    (doseq [vm-type (keys repl/vm-constructors)]\n53\t      (testing (str vm-type)\n54\t        (let [state (repl/create-state {:frontends catalog,\n55\t                                        :vm-type vm-type})\n56\t              [state' switched] (run state \"(lang :example.toy/frontend)\")\n57\t              [_ refused] (run state \"(lang :toy)\")\n58\t              [_ result] (run state' \"abcd\")]\n59\t          (is (= \"Switched to :example.toy/frontend\" switched))\n60\t          (is (str/includes? refused \"unavailable-parser\")\n61\t              \"a language keyword is not a selector\")\n62\t          (is (= \"4\" result)))))))\n63\t\n64\t\n65\t(deftest the-standard-languages-select-by-id-test\n66\t  (let [state (repl.frontends/create-state)\n67\t        [python switched] (run state \"(lang :yang/python)\")\n68\t        [_ value] (run python \"1 + 2\")\n69\t        [_ compiled] (run (first (run state \"(lang :yang/php)\")) \"(compile \\\"1 + 2;\\\")\")]\n70\t    (is (= \"Switched to :yang/python\" switched))\n71\t    (is (= \"3\" value))\n72\t    (is (str/includes? compiled \"AST:\"))\n73\t    (testing \"a language keyword is not a selector\"\n74\t      (let [[_ refused] (run state \"(lang :python)\")]\n75\t        (is (str/includes? refused \"unavailable-parser\")))\n76\t      (testing \"the frontend renders the ANTLR Python repr\"\n77\t        (is (= \"'ab'\" (second (run python \"'a' + 'b'\"))))))))\n78\t\n79\t\n80\t(deftest a-newer-revision-leaves-a-live-session-unchanged-test\n81\t  (let [catalog (toy-catalog \"r1\" 1)\n82\t        state (repl/create-state {:frontends catalog})\n83\t        [state' _] (run state \"(lang :example.toy/frontend)\")\n84\t        newer (frontend/install catalog (manifest \"r2\") (toy-binding 100))]\n85\t    (is (frontend/ok? (frontend/select newer\n86\t                                       {:yang.frontend/id :example.toy/frontend,\n87\t                                        :yang.frontend/revision \"r2\"})))\n88\t    (is (= \"2\" (second (run state' \"ab\"))))\n89\t    (is (= catalog (:frontends state')))\n90\t    (testing \"a session composed with the newer catalog pins its own snapshot\"\n91\t      (let [other (repl/create-state {:frontends (toy-catalog \"r2\" 100)})\n92\t            [other' _] (run other \"(lang :example.toy/frontend)\")]\n93\t        (is (= \"200\" (second (run other' \"ab\"))))\n94\t        (is (= \"2\" (second (run state' \"ab\"))))))))\n95\t\n96\t\n97\t(deftest an-unavailable-frontend-answers-without-fallback-test\n98\t  (let [state (repl.frontends/create-state)\n99\t        [state' answer] (run state \"(lang :yang.python/uninstalled)\")]\n100\t    (testing \"selecting an id the catalog does not hold is a diagnostic\"\n101\t      (is (str/includes? answer \"unavailable-parser\"))\n102\t      (is (= :yang/clojure (:lang state'))))\n103\t    (testing \"compiling under it answers unavailable-parser, not another frontend\"\n104\t      (let [pinned (assoc state :lang :yang.python/uninstalled)\n105\t            [_ result] (run pinned \"1 + 2\")\n106\t            [_ compiled] (run pinned \"(compile \\\"1 + 2\\\")\")]\n107\t        (is (str/includes? result \"unavailable-parser\"))\n108\t        (is (not= \"3\" result))\n109\t        (is (str/includes? compiled \"unavailable-parser\"))))\n110\t    (testing \"a binding with no parse stage is unavailable too\"\n111\t      (let [catalog (frontend/install frontend/empty-catalog\n112\t                                      (manifest \"r1\")\n113\t                                      {:lower identity})\n114\t            pinned (assoc (repl/create-state {:frontends catalog})\n115\t                          :lang :toy)\n116\t            [_ result] (run pinned \"abc\")]\n117\t        (is (str/includes? result \"unavailable-parser\"))))))\n118\t\n119\t\n120\t(deftest the-antlr-id-is-installed-on-every-host-test\n121\t  (let [[state answer] (run (repl.frontends/create-state)\n122\t                            \"(lang :yang/python)\")]\n123\t    (is (= :yang/python (:lang state)))\n124\t    (is (not (str/includes? answer \"unavailable-parser\")))))\n125\t\n126\t\n127\t(deftest a-core-session-with-no-catalog-has-no-frontend-test\n128\t  (let [[_ result] (run (repl/create-state) \"(+ 1 2)\")]\n129\t    (is (str/includes? result \"unavailable-parser\"))\n130\t    (is (= {:yang.frontend/entries {}} (:frontends (repl/create-state))))))\n131\t\n132\t\n133\t(deftest a-revision-is-pinned-by-id-and-revision-test\n134\t  (let [catalog (-> (toy-catalog \"r1\" 1)\n135\t                    (frontend/install (manifest \"r2\") (toy-binding 100)))\n136\t        state (repl/create-state {:frontends catalog})]\n137\t    (testing \"an id or language with two revisions is ambiguous, not chosen\"\n138\t      (is (str/includes? (second (run state \"(lang :example.toy/frontend)\"))\n139\t                         \"unavailable-parser\"))\n140\t      (is (str/includes? (second (run state \"(lang :toy)\"))"}
{"role":"tool","tool_call_id":"tool_bHBgNsBers3PiQBt8yYCaSrV","content":"370\t    (is (= 2 (:frontend-session done)))))\n371\t\n372\t\n373\t(deftest a-refused-parked-round-keeps-the-previous-session-test\n374\t  (let [state (parked {:content-client (silent-client),\n375\t                       :name-env {'mod (second (published))}})\n376\t        [refused text] (repl/recheck-pending\n377\t                         (assoc state\n378\t                                :link-source (link/composition\n379\t                                               {:content-store\n380\t                                                (mem/create-content-mem),\n381\t                                                :name-env {}})))]\n382\t    (is (some? (:pending-run state)))\n383\t    (is (nil? (:pending-run refused)))\n384\t    (is (str/includes? text \"absent\"))\n385\t    (is (= 1 (:frontend-session refused)))))\n386\t\n387\t\n388\t(deftest an-abandoned-parked-round-keeps-the-previous-session-test\n389\t  (let [[freed text] (repl/eval-input (parked {}) \"(abandon)\")]\n390\t    (is (str/includes? text \"abandoned\"))\n391\t    (is (nil? (:pending-run freed)))\n392\t    (is (= 1 (:frontend-session freed)))\n393\t    (testing \"the next round lowers against the kept session\"\n394\t      (is (= 2 (:frontend-session\n395\t                 (first (repl/eval-input freed \"(+ 1 2)\"))))))))\n396\t\n397\t\n398\t(deftest other-frontends-still-echo-their-value-test\n399\t  (let [state (frontends/create-state)\n400\t        [php _] (repl/eval-input state \"(lang :yang/php)\")]\n401\t    (is (= \"3\" (second (repl/eval-input state \"(+ 1 2)\"))))\n402\t    (is (= \"3\" (second (repl/eval-input php \"1 + 2;\"))))))\n403\t\n404\t\n405\t;; =============================================================================\n406\t;; The parser and the probe (JVM)\n407\t;; =============================================================================\n408\t\n409\t(defn- node-shape\n410\t  [node]\n411\t  (select-keys node [:id :kind :type :text :rule :children]))\n412\t\n413\t\n414\t(deftest precompiled-packets-are-the-parsers-test\n415\t  (doseq [[source p] packets]\n416\t    (is (= [] (packet/conform (parser/parse-source (str source \"\\n\"))\n417\t                              (str source \"\\n\")))\n418\t        source)\n419\t    (is (= (map node-shape\n420\t                (:yang.cst/nodes (parser/parse-source (str source \"\\n\"))))\n421\t           (map node-shape (:yang.cst/nodes p)))\n422\t        source)))\n423\t\n424\t"}
{"role":"tool","tool_call_id":"tool_UNkHLaLiijtAiXMEPD8mm7JT","content":"3680\t  ([ctx module?]\n3681\t   (cond\n3682\t     (unit-returns? ctx)\n3683\t     (app* 'php/call-ec\n3684\t           (u/lam ['%ret] (u/then (unit-body (assoc ctx :ret '%ret)) (u/lit :php/no-return))))\n3685\t     module? (u/then (unit-body ctx) (u/lit :php/no-return))\n3686\t     :else (unit-body ctx))))\n3687\t\n3688\t\n3689\t(defn lower-module-body\n3690\t  \"The unit's statements as one node, before the runtime wrapper: what\n3691\t   lowering goldens compare. Hoisted function declarations come first.\"\n3692\t  [packet]\n3693\t  (unit-body (context packet)))\n3694\t\n3695\t\n3696\t(def option-keys\n3697\t  \"The options `lower-program` and the lowering stage accept.\"\n3698\t  [:prelude :path :paths :class-map])\n3699\t\n3700\t\n3701\t(defn- path-map-node\n3702\t  \"`(php/bind-path-map! {path thunk ...})` for the composition's published\n3703\t   paths (plan P6 R3): the computed include's lookup table.\"\n3704\t  [paths]\n3705\t  (app* 'php/bind-path-map!\n3706\t        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\n3707\t                (u/lit {})\n3708\t                (sort paths))))\n3709\t\n3710\t\n3711\t(defn lower-program\n3712\t  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n3713\t   `php/run-main` after the prelude, tail calls marked. Its value is\n3714\t   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n3715\t   `:warnings` are the lowering's warning-severity diagnostics\n3716\t   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\n3717\t   `:yang.php/computed-include-path`).\n3718\t\n3719\t   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\n3720\t   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\n3721\t   need); `:path` the entry unit's declared path (default `entry-path`);\n3722\t   `:paths` the normalized paths whose units the composition published,\n3723\t   which a computed include resolves against; `:class-map` true requires\n3724\t   the published `phpm.$classmap` and binds its classes and delivery thunks\n3725\t   (plan P6 R9), which takes the place of `:paths`.\"\n3726\t  ([packet] (lower-program packet {}))\n3727\t  ([packet {:keys [prelude paths path class-map], :or {prelude :bundled}}]\n3728\t   (when-not (contains? #{:bundled :linked} prelude)\n3729\t     (throw (ex-info \"unknown PHP prelude profile\"\n3730\t                     {:yang.php/diagnostic :yang.php/unsupported,\n3731\t                      :construct :prelude,\n3732\t                      :prelude prelude})))\n3733\t   (let [linked? (= :linked prelude)\n3734\t         ctx (context packet {:path (or path entry-path), :linked? linked?})\n3735\t         main (app* 'php/run-main (u/lam [] (unit-node ctx)))]\n3736\t     {:ast (u/mark-tails\n3737\t             (if linked?\n3738\t               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\n3739\t                                     (app* 'require (u/lit prelude/module-name))\n3740\t                                     (app* 'php/init!)]\n3741\t                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\n3742\t                                    (when class-map\n3743\t                                      [(app* 'require (u/lit classmap-module))\n3744\t                                       (app* 'php/bind-class-map!\n3745\t                                             (u/v (symbol (str classmap-module) \"classes\"))\n3746\t                                             (u/v (symbol (str classmap-module) \"paths\")))])\n3747\t                                    [main]))\n3748\t               (u/then prelude/uast main))),\n3749\t      :warnings @(:warnings ctx)})))\n3750\t\n3751\t\n3752\t(defn lower-packet\n3753\t  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n3754\t  ([packet] (lower-packet packet {}))\n3755\t  ([packet opts] (:ast (lower-program packet opts))))\n3756\t\n3757\t\n3758\t;; =============================================================================\n3759\t;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n3760\t;; =============================================================================\n3761\t\n3762\t(def module-exports\n3763\t  \"The exports of a compiled PHP unit: its spec and body, immutable after\n3764\t   install.\"\n3765\t  '#{spec body})\n3766\t\n3767\t\n3768\t(defn imported-unit-names\n3769\t  \"The normalized paths the unit statically includes through folded literal\n3770\t   paths, source order, distinct, the unit's own path aside. A computed path\n3771\t   contributes nothing: it is by name at run time (plan P6 R3). A path that\n3772\t   cannot normalize is refused as `lower-include` refuses it.\"\n3773\t  [packet {:keys [path], :or {path entry-path}}]\n3774\t  (let [ctx (context packet {:path path, :linked? true})]\n3775\t    (letfn [(edges\n3776\t              [n]\n3777\t              (let [ks (core/kids ctx n)\n3778\t                    k0 (first ks)]\n3779\t                (concat\n3780\t                  (when (and (p/rule? n \"expression\")\n3781\t                             (= 2 (count ks))\n3782\t                             (p/token? k0)\n3783\t                             (contains? include-kinds (:type k0)))\n3784\t                    (when-let [folded (fold-path ctx (second ks))]\n3785\t                      (let [{p :path, error :error} (normalize-unit-path folded)]\n3786\t                        (when error (unsupported! n error))\n3787\t                        [p])))\n3788\t                  (mapcat edges (filter p/rule? ks)))))]\n3789\t      (into [] (comp (distinct) (remove #(= % path))) (edges (p/root (:pk ctx)))))))\n3790\t\n3791\t\n3792\t(defn module-packet\n3793\t  \"One ok packet as the linker module `phpm.<mangled-path>`: one wide\n3794\t   application whose operands are `(require 'php)`, then the spec and body\n3795\t   definitions. The body is `(fn [%scope %ctx] <unit>)`: the including\n3796\t   scope arrives as arguments (P6 S3 gives them meaning; S2 includes only\n3797\t   at an entry unit's top level, whose variables are the globals).\"\n3798\t  [packet {:keys [path strict-types]}]\n3799\t  (let [ctx (assoc (context packet {:path path, :linked? true}) :module? true)\n3800\t        defs [(u/def! 'spec (u/lit {:path path, :strict-types (if strict-types 1 0)}))\n3801\t              (u/def! 'body (u/lam ['%scope '%ctx] (unit-node ctx true)))]\n3802\t        operands (into [(core-module/require-node prelude/module-name)] defs)\n3803\t        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n3804\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))"}
