{"role":"tool","tool_call_id":"tool_gHD9oGIR1Tevep9U8nnWoyJE","content":"1\t(ns build-cache\n2\t  \"Content-checked, worktree-local caches for expensive test prerequisites.\"\n3\t  (:require\n4\t    [babashka.fs :as fs]\n5\t    [babashka.process :as p]\n6\t    [clojure.edn :as edn]\n7\t    [clojure.java.io :as io]\n8\t    [clojure.string :as str])\n9\t  (:import\n10\t    [java.security MessageDigest]))\n11\t\n12\t\n13\t(defn digest\n14\t  [value]\n15\t  (let [md (MessageDigest/getInstance \"SHA-256\")]\n16\t    (.update md (.getBytes (pr-str value) \"UTF-8\"))\n17\t    (format \"%064x\" (java.math.BigInteger. 1 (.digest md)))))\n18\t\n19\t\n20\t(defn file-digest\n21\t  [path]\n22\t  (let [md (MessageDigest/getInstance \"SHA-256\")]\n23\t    (with-open [in (io/input-stream (fs/file path))]\n24\t      (let [buf (byte-array 65536)]\n25\t        (loop []\n26\t          (let [n (.read in buf)]\n27\t            (when (pos? n)\n28\t              (.update md buf 0 n)\n29\t              (recur))))))\n30\t    (format \"%064x\" (java.math.BigInteger. 1 (.digest md)))))\n31\t\n32\t\n33\t(defn snapshot\n34\t  \"Names and bytes, including missing roots; detects removed/corrupt outputs.\"\n35\t  [roots]\n36\t  (let [file-state (fn [f]\n37\t                     {:sha256 (file-digest f)\n38\t                      :executable? (.canExecute (fs/file f))})]\n39\t    (into (sorted-map)\n40\t          (mapcat (fn [root]\n41\t                    (if (fs/directory? root)\n42\t                      (cons [(str root) :directory]\n43\t                            (for [f (sort (fs/glob root \"**\" {:hidden true}))\n44\t                                  :when (fs/regular-file? f)]\n45\t                              [(str f) (file-state f)]))\n46\t                      [[(str root) (when (fs/regular-file? root)\n47\t                                     (file-state root))]])))\n48\t          roots)))\n49\t\n50\t\n51\t(defn local-path!\n52\t  \"Refuse shared mutable output directories, including symlinked parents.\"\n53\t  [path]\n54\t  (let [root (.getCanonicalFile (fs/file \".\"))\n55\t        dest (.getCanonicalFile (fs/file path))]\n56\t    (when-not (.startsWith (.toPath dest) (.toPath root))\n57\t      (throw (ex-info (str \"cache output must stay in this worktree: \" path) {})))))\n58\t\n59\t\n60\t(defn checked-output\n61\t  [& command]\n62\t  (let [{:keys [exit out err]} (apply p/sh command)]\n63\t    (when-not (zero? exit)\n64\t      (throw (ex-info (str \"failed: \" (str/join \" \" command) \"\\n\" err)\n65\t                      {:exit exit})))\n66\t    (str/trim (str out err))))\n67\t\n68\t\n69\t(defn cached!\n70\t  \"Hold a worktree-local writer lock; record inputs/outputs only after success.\"\n71\t  [id inputs outputs command]\n72\t  (doseq [path (concat [\"target/prereq-cache\"] outputs)] (local-path! path))\n73\t  (fs/create-dirs \"target/prereq-cache\")\n74\t  (let [stamp (str \"target/prereq-cache/\" id \".edn\")\n75\t        lock (str \"target/prereq-cache/\" id \".lock\")\n76\t        key (digest [(str (fs/canonicalize \".\")) inputs])]\n77\t    (try (fs/create-dir lock)\n78\t         (catch Exception _\n79\t           (throw (ex-info (str id \" cache is locked: \" lock\n80\t                                \"; serialize builds in this worktree. If its owner died, remove the lock.\")\n81\t                           {}))))\n82\t    (try\n83\t      (let [previous (when (fs/exists? stamp)\n84\t                       (try (edn/read-string (slurp stamp))\n85\t                            (catch Exception _ nil)))\n86\t            present (snapshot outputs)]\n87\t        (if (and (= key (:key previous))\n88\t                 (seq present) (every? some? (vals present))\n89\t                 (= present (:outputs previous)))\n90\t          (do (println id \"cache hit (inputs and outputs verified)\") 0)\n91\t          (do\n92\t            (println id \"cache miss; running\" (str/join \" \" command))\n93\t            (fs/delete-if-exists stamp)\n94\t            (let [exit (:exit @(p/process command {:inherit true}))]\n95\t              (when (zero? exit)\n96\t                (spit stamp (pr-str {:key key :outputs (snapshot outputs)})))\n97\t              exit))))\n98\t      (finally (fs/delete lock)))))\n99\t\n100\t"}
