{"role":"tool","tool_call_id":"tool_Yl1WOPD4nqHegVp3EHNStBdH","content":"100\t\n101\t(defn antlr!\n102\t  [args]\n103\t  ;; Filtered/discovery invocations retain the generator's exact CLI behavior;\n104\t  ;; only the complete default build can establish the complete-output cache.\n105\t  (let [manifests (sort (fs/glob \"antlr\" \"*/manifest.edn\"))\n106\t        outputs (vec (mapcat\n107\t                       (fn [path]\n108\t                         (let [m (edn/read-string (slurp (str path)))\n109\t                               grammar (str (fs/file-name (fs/parent path)))]\n110\t                           (concat (map :out (vals (:targets m)))\n111\t                                   [(str \"build/antlr/\" grammar \"/classes\")\n112\t                                    (str \"build/antlr/\" grammar \"/upstream\")])))\n113\t                       manifests))\n114\t        inputs {:files (snapshot [\"antlr\" \"src/dev/yang_antlr_gen.clj\"\n115\t                                  \"src/dev/build_cache.clj\" \"deps.edn\" \"mise.toml\"])\n116\t                :java (checked-output \"java\" \"-version\")\n117\t                :javac (checked-output \"javac\" \"-version\")}]\n118\t    (if (seq args)\n119\t      ;; Still use the same lock and invalidate the complete-build stamp.\n120\t      (do (fs/create-dirs \"target/prereq-cache\")\n121\t          (let [exit (cached! \"antlr\" (assoc inputs :args (vec args)) outputs\n122\t                              (into [\"clojure\" \"-M:antlr-gen\"] args))]\n123\t            (fs/delete-if-exists \"target/prereq-cache/antlr.edn\")\n124\t            exit))\n125\t      (cached! \"antlr\" inputs outputs [\"clojure\" \"-M:antlr-gen\"]))))\n126\t\n127\t\n128\t(defn npm!\n129\t  []\n130\t  (cached! \"npm-ci\"\n131\t           {:files (snapshot [\"package.json\" \"package-lock.json\" \".npmrc\"\n132\t                              (str (fs/home) \"/.npmrc\") \"mise.toml\"\n133\t                              \"src/dev/build_cache.clj\"]