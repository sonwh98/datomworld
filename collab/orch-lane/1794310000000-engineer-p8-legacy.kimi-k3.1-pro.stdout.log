{"role":"tool","tool_call_id":"tool_s9OniKCNWhAhtz4ZIXcQFO9q","content":"1\t(ns yang.php-literal-test\n2\t  \"PHP number literals over the primitive profile, on every lane\n3\t   (docs/design/dao.stream.host-boundary.md §8 H2, table D row (4)):\n4\t   integers exact in their canonical carrier, floats the nearest double.\"\n5\t  (:require\n6\t    [clojure.string :as str]\n7\t    [clojure.test :refer [deftest is testing]]\n8\t    [dao.host.integer :as host-integer]\n9\t    [yang.php :as php]))\n10\t\n11\t\n12\t(defn- decimal-text\n13\t  [v]\n14\t  (host-integer/to-radix-string (host-integer/promote v) 10))\n15\t\n16\t\n17\t(deftest integer-literals-are-exact-in-their-canonical-carrier\n18\t  (testing \"a small literal is a native carrier\"\n19\t    (let [v (php/php-number \"12\")]\n20\t      (is (host-integer/safe-native? v))\n21\t      (is (= 12 v))))\n22\t  (testing \"2^53 + 1 parses to that exact integer (a big carrier on JS)\"\n23\t    (let [v (php/php-number \"9007199254740993\")]\n24\t      (is (host-integer/exact-integer? v))\n25\t      (is (= \"9007199254740993\" (decimal-text v)))\n26\t      (is (not (host-integer/safe-native? v)))\n27\t      #?(:cljs (is (host-integer/big-carrier? v)))))\n28\t  (testing \"a 400-digit literal is an exact big\"\n29\t    (let [text (str \"1\" (apply str (repeat 399 \"7\")))\n30\t          v (php/php-number text)]\n31\t      (is (host-integer/big-carrier? v))\n32\t      (is (= text (decimal-text v)))))\n33\t  (testing \"through the literal parser\"\n34\t    (is (= {:php-type :literal :value 12} (php/parse-php-literal [:number \"12\"])))))\n35\t\n36\t\n37\t(deftest float-literals-are-the-nearest-double\n38\t  (is (= 1.5 (php/php-number \"1.5\")))\n39\t  (is (= 0.1 (php/php-number \"0.1\")))\n40\t  (is (= 1.0 (php/php-number \"1.\")) \"the lexer's digits-dot form\")\n41\t  (is (= ##Inf (php/php-number (str (str/join (repeat 400 \"9\")) \".0\"))))\n42\t  (is (host-integer/host-float? (php/php-number \"2.0\"))))"}
{"role":"tool","tool_call_id":"tool_UI7s5ntKH7fcG9VKA5MDMlX4","content":"1\t(ns yang.php-test\n2\t  (:require [clojure.test :refer [deftest is testing]]\n3\t            [yang.clojure :as clj]\n4\t            [yang.php :as php]\n5\t            [yin.vm :as vm]\n6\t            [yin.vm.test-utils :as tu]))\n7\t\n8\t\n9\t(defn compile-and-run\n10\t  ([ast] (compile-and-run ast {}))\n11\t  ([ast env]\n12\t   (-> (tu/make-observer-session (tu/create-vm {:env env}))\n13\t       (tu/queue-ast! ast)\n14\t       tu/run-session\n15\t       :consumer\n16\t       vm/value)))\n17\t\n18\t\n19\t(deftest test-tokenize\n20\t  (testing \"Tokenizing PHP source\"\n21\t    (is (= [[:number \"42\"]] (php/tokenize \"42\")))\n22\t    (is (= [[:string \"hello\"]] (php/tokenize \"\\\"hello\\\"\")))\n23\t    (is (= [[:variable \"$x\"] [:operator \"+\"] [:number \"1\"]]\n24\t           (php/tokenize \"$x + 1\")))\n25\t    (is (= [[:keyword \"function\"] [:identifier \"add\"] [:lparen \"(\"]\n26\t            [:variable \"$x\"] [:comma \",\"] [:variable \"$y\"] [:rparen \")\"]\n27\t            [:lbrace \"{\"] [:keyword \"return\"] [:variable \"$x\"] [:operator \"+\"]\n28\t            [:variable \"$y\"] [:semicolon \";\"] [:rbrace \"}\"]]\n29\t           (php/tokenize \"function add($x, $y) { return $x + $y; }\")))))\n30\t\n31\t\n32\t(deftest test-compile-literals\n33\t  (testing \"Compiling PHP literals\"\n34\t    (testing \"Numbers\"\n35\t      (is (= {:type :literal, :value 42} (php/compile \"42;\")))\n36\t      (is (= {:type :literal, :value -10} (php/compile \"-10;\")))\n37\t      (is (= {:type :literal, :value 3.14} (php/compile \"3.14;\"))))\n38\t    (testing \"Strings\"\n39\t      (is (= {:type :literal, :value \"hello\"} (php/compile \"\\\"hello\\\";\")))\n40\t      (is (= {:type :literal, :value \"world\"} (php/compile \"'world';\"))))\n41\t    (testing \"Booleans\"\n42\t      (is (= {:type :literal, :value true} (php/compile \"true;\")))\n43\t      (is (= {:type :literal, :value false} (php/compile \"false;\"))))\n44\t    (testing \"null\"\n45\t      (is (= {:type :literal, :value nil} (php/compile \"null;\"))))))\n46\t\n47\t\n48\t(deftest test-compile-variables\n49\t  (testing \"Compiling PHP variables\"\n50\t    (is (= {:type :variable, :name 'x} (php/compile \"$x;\")))\n51\t    (is (= {:type :variable, :name 'foo} (php/compile \"$foo;\")))))\n52\t\n53\t\n54\t(deftest test-compile-binary-ops\n55\t  (testing \"Compiling PHP binary operations\"\n56\t    (testing \"Addition\"\n57\t      (let [ast (php/compile \"1 + 2;\")]\n58\t        (is (= :application (:type ast)))\n59\t        (is (= {:type :variable, :name '+} (:operator ast)))\n60\t        (is (= 2 (count (:operands ast))))))\n61\t    (testing \"Multiplication\"\n62\t      (let [ast (php/compile \"$x * 2;\")]\n63\t        (is (= :application (:type ast)))\n64\t        (is (= {:type :variable, :name '*} (:operator ast)))))\n65\t    (testing \"Comparison\"\n66\t      (let [ast (php/compile \"$x < 5;\")]\n67\t        (is (= :application (:type ast)))\n68\t        (is (= {:type :variable, :name '<} (:operator ast)))))\n69\t    (testing \"Operator precedence\"\n70\t      (let [ast (php/compile \"2 + 3 * 4;\")]\n71\t        ;; Should be: 2 + (3 * 4)\n72\t        (is (= :application (:type ast)))\n73\t        (is (= '+ (get-in ast [:operator :name])))\n74\t        (is (= :application (get-in ast [:operands 1 :type])))\n75\t        (is (= '* (get-in ast [:operands 1 :operator :name])))))))\n76\t\n77\t\n78\t(deftest test-compile-function\n79\t  (testing \"Compiling PHP function statements\"\n80\t    (testing \"Simple function\"\n81\t      (let [ast (php/compile \"function double($x) { return $x * 2; }\")]\n82\t        (is (= :application (:type ast)))))\n83\t    (testing \"Function with multiple parameters\"\n84\t      (let [ast (php/compile \"function add($x, $y) { return $x + $y; }\")]\n85\t        (is (= :application (:type ast)))))))\n86\t\n87\t\n88\t(deftest test-compile-call\n89\t  (testing \"Compiling PHP function calls\"\n90\t    (testing \"Simple call\"\n91\t      (let [ast (php/compile \"f(5);\")]\n92\t        (is (= :application (:type ast)))\n93\t        (is (= {:type :variable, :name 'f} (:operator ast)))\n94\t        (is (= 1 (count (:operands ast))))))\n95\t    (testing \"Multiple arguments\"\n96\t      (let [ast (php/compile \"add(1, 2);\")]\n97\t        (is (= :application (:type ast)))\n98\t        (is (= 2 (count (:operands ast))))))\n99\t    (testing \"Nested calls\"\n100\t      (let [ast (php/compile \"f(g(5));\")]\n101\t        (is (= :application (:type ast)))\n102\t        (is (= :application (get-in ast [:operands 0 :type])))))))\n103\t\n104\t\n105\t(deftest test-end-to-end-php\n106\t  (testing \"Compile and execute PHP code with Yin VM\"\n107\t    (testing \"Simple literal\" (is (= 42 (compile-and-run (php/compile \"42;\")))))\n108\t    (testing \"Variable lookup\"\n109\t      (is (= 100 (compile-and-run (php/compile \"$x;\") {'x 100}))))\n110\t    (testing \"Simple addition\"\n111\t      (is (= 3 (compile-and-run (php/compile \"1 + 2;\")))))\n112\t    (testing \"Function application\"\n113\t      (let\n114\t        [source\n115\t         \"function double($x) { return $x * 2; }\n116\t                    double(21);\"\n117\t         ast (php/compile source)]\n118\t        (is (= 42 (compile-and-run ast)))))\n119\t    (testing \"Multiple parameters\"\n120\t      (let\n121\t        [source\n122\t         \"function add($x, $y) { return $x + $y; }\n123\t                    add(10, 20);\"\n124\t         ast (php/compile source)]\n125\t        (is (= 30 (compile-and-run ast)))))\n126\t    (testing \"Operator precedence\"\n127\t      (is (= 14 (compile-and-run (php/compile \"2 + 3 * 4;\")))))\n128\t    (testing \"Nested operations\"\n129\t      (is (= 20 (compile-and-run (php/compile \"(2 + 3) * 4;\")))))\n130\t    (testing \"Comparison\"\n131\t      (is (= true (compile-and-run (php/compile \"3 < 5;\")))))\n132\t    (testing \"If statement - true branch\"\n133\t      (let [source \"if (true) { return 10; } else { return 20; }\"\n134\t            ast (php/compile source)]\n135\t        (is (= 10 (compile-and-run ast)))))\n136\t    (testing \"If statement - false branch\"\n137\t      (let [source \"if (false) { return 10; } else { return 20; }\"\n138\t            ast (php/compile source)]\n139\t        (is (= 20 (compile-and-run ast)))))\n140\t    (testing \"If with comparison\"\n141\t      (let [source \"if (3 < 5) { return 100; } else { return 200; }\"\n142\t            ast (php/compile source)]\n143\t        (is (= 100 (compile-and-run ast)))))\n144\t    (testing \"Else if\"\n145\t      (let\n146\t        [source\n147\t         \"if (3 > 5) { return 1; } elseif (4 < 5) { return 2; } else { return 3; }\"\n148\t         ast (php/compile source)]\n149\t        (is (= 2 (compile-and-run ast)))))\n150\t    (testing \"Complex closure with type hints and assignment\"\n151\t      (let\n152\t        [source\n153\t         \"$makePower = function (int $exponent) {\n154\t                      return function (int $base) use ($exponent): int {\n155\t                          $result = 1;\n156\t                          $result = $result * $base;\n157\t                          return $result;\n158\t                      };\n159\t                    };\n160\t                    $pow2 = $makePower(2);\n161\t                    $pow2(3);\"\n162\t         ast (php/compile source)]\n163\t        ;; This simplified version (no for loop yet in test, and result is\n164\t        ;; just result * base)\n165\t        ;; should at least compile and run.\n166\t        (is (= 3 (compile-and-run ast)))))\n167\t    (testing \"Closure with for loop and augmented assignment\"\n168\t      (let\n169\t        [source\n170\t         \"$makePower = function (int $exponent) {\n171\t                      return function (int $base) use ($exponent): int {\n172\t                          $result = 1;\n173\t                          for ($i = 0; $i < $exponent; $i++) {\n174\t                              $result *= $base;\n175\t                          }\n176\t                          return $result;\n177\t                      };\n178\t                    };\n179\t                    $cube = $makePower(3);\n180\t                    $cube(2);\"\n181\t         ast (php/compile source)]\n182\t        (is (= 8 (compile-and-run ast)))))))\n183\t\n184\t\n185\t(deftest test-php-to-clojure-equivalence\n186\t  (testing \"PHP and Clojure compile to equivalent ASTs\"\n187\t    (testing \"Function calls\"\n188\t      (let [php-ast (php/compile \"f(1, 2);\")\n189\t            clj-ast (clj/compile '(f 1 2))]\n190\t        (is (= (:type php-ast) (:type clj-ast) :application))\n191\t        (is (= (count (:operands php-ast)) (count (:operands clj-ast)) 2))))))\n192\t\n193\t\n194\t(deftest test-error-handling\n195\t  (testing \"Error handling for invalid PHP\"\n196\t    (testing \"Unclosed string\"\n197\t      (is (thrown? Exception (php/compile \"\\\"unclosed;\"))))\n198\t    (testing \"Invalid syntax\" (is (thrown? Exception (php/compile \"function\"))))\n199\t    (testing \"Unmatched parenthesis\"\n200\t      (is (thrown? Exception (php/compile \"(1 + 2;\"))))))"}
{"role":"tool","tool_call_id":"tool_gtrA3aRpMgfWh1bPfXENQ3Uy","content":"src/cljc/yang/frontend.cljc:2:  \"The language frontend catalog (docs/design/yang.antlr.md section 3,\nsrc/cljc/yang/frontend.cljc:5:   A catalog is a plain immutable value. There is no global registry and\nsrc/cljc/yang/frontend.cljc:6:   no namespace-load registration: `install` returns a new catalog and\nsrc/cljc/yang/frontend.cljc:8:   catalog snapshot keeps its behavior (section 3.3).\nsrc/cljc/yang/frontend.cljc:24:  \"The SPI revisions (`:yang.frontend/spi`) this catalog admits.\"\nsrc/cljc/yang/frontend.cljc:29:  \"Every reason a catalog refusal may carry.\"\nsrc/cljc/yang/frontend.cljc:45:  \"True when `res` is a catalog refusal.\"\nsrc/cljc/yang/frontend.cljc:129:   this catalog admits, else the refusal naming the first defect.\"\nsrc/cljc/yang/frontend.cljc:156:(def empty-catalog\nsrc/cljc/yang/frontend.cljc:157:  \"The catalog with no frontend installed.\"\nsrc/cljc/yang/frontend.cljc:167:  \"`catalog'`: `catalog` plus `manifest` bound to the host's\nsrc/cljc/yang/frontend.cljc:171:  [catalog manifest binding]\nsrc/cljc/yang/frontend.cljc:177:            prior (get-in catalog [:yang.frontend/entries k])]\nsrc/cljc/yang/frontend.cljc:178:        (cond (nil? prior) (assoc-in catalog [:yang.frontend/entries k] entry)\nsrc/cljc/yang/frontend.cljc:179:              (= prior entry) catalog\nsrc/cljc/yang/frontend.cljc:186:  [catalog id]\nsrc/cljc/yang/frontend.cljc:187:  (->> (keys (:yang.frontend/entries catalog))\nsrc/cljc/yang/frontend.cljc:202:   than one matches: the catalog never silently chooses (section 3.3).\"\nsrc/cljc/yang/frontend.cljc:203:  [catalog request]\nsrc/cljc/yang/frontend.cljc:207:        candidates (cond->> (revisions catalog id)\nsrc/cljc/yang/frontend.cljc:210:                           (let [m (get-in catalog\nsrc/cljc/yang/frontend.cljc:224:                         (get-in catalog [:yang.frontend/entries k]))))))"}
{"role":"tool","tool_call_id":"tool_eqlDDxi4OBygdYZbDz1qU632","content":"1\t(ns yang.php.antlr.programs-p6\n2\t  \"Slice P6 Stage 0 (S0) fixture data: include/require over the linker\n3\t   (P6 plan v2, S0). Same schema as `yang.php.antlr.programs-p3b`, plus:\n4\t     :units     {path source} for a multi-unit fixture, every unit including\n5\t                the entry unit; absent for a one-file fixture\n6\t     :main      the entry unit's path, default \\\"main.php\\\"\n7\t     :computed  true when the entry unit's computed includes resolve through\n8\t                the composition's published path map (every non-entry unit)\n9\t     :warnings  the lowering warnings the entry unit must report\n10\t   Every fixture is `:oracle :pending` until the shiva recording pass, and\n11\t   `:requires` names the P6 steps (:p6-s2 .. :p6-s5, :p6-s2-r8 for the\n12\t   per-unit strict_types rule) that must land before an implementation\n13\t   runner may execute it. `:out` and `:diag` are pinned only where the\n14\t   language fixes them; otherwise they are absent and the recorded output is\n15\t   taken. A mismatch is escalated to the Architect and never fixed by\n16\t   editing the expectation.\n17\t\n18\t   Groups: :inclusion-v1, :missing-v1 (the oracle-pinned half; the\n19\t   pinned-but-unserved half is asserted in the linked tests), :namespaces-v1,\n20\t   :constants-v1, :autoload-v1, :strict-v1. `all-fixtures` is unconditional\n21\t   (the oracle iterates it); `enabled` is the subset whose :requires have all\n22\t   landed in `completed-steps`.\"\n23\t  (:require\n24\t    [yang.php.antlr.programs-p3b :as p3b]))\n25\t\n26\t\n27\t(def completed-steps\n28\t  \"P6 steps that have landed: S1 (the linked profile, module emitter,\n29\t   publication), S2 (include/require, the two missing stages, the computed\n30\t   arm), S3 (the dynamic-scope profile), S4 (namespaces, `use`, the\n31\t   constants read path) and S5 (constant declarations, magic constants,\n32\t   the autoload runtime). `:p6-s2-r8` (per-unit strict_types) is not here.\"\n33\t  #{:p6-s0 :p6-s1 :p6-s2 :p6-s3 :p6-s4 :p6-s5})\n34\t\n35\t\n36\t(def include-path\n37\t  \"The `include_path` the missing-include texts print: php:8.3-cli's\n38\t   default, PENDING the shiva pin (plan S0 item 2).\"\n39\t  \".:/usr/local/lib/php\")\n40\t\n41\t\n42\t(defn- fx\n43\t  [id group requires units main-source out & {:as more}]\n44\t  (merge (cond-> {:id id,\n45\t                  :group group,\n46\t                  :rows [],\n47\t                  :level :program,\n48\t                  :requires requires,\n49\t                  :source main-source,\n50\t                  :oracle :pending}\n51\t           (seq units) (assoc :units (assoc units \"main.php\" main-source))\n52\t           out (assoc :out out))\n53\t         more))\n54\t\n55\t\n56\t(defn- missing-warnings\n57\t  \"The two warnings of a missing `include`/`include_once` of `path`.\"\n58\t  [kind path]\n59\t  [[2 (str kind \"(\" path \"): Failed to open stream: No such file or directory\")]\n60\t   [2 (str kind \"(): Failed opening '\" path \"' for inclusion (include_path='\" include-path \"')\")]])\n61\t\n62\t\n63\t(def inclusion-v1\n64\t  [(fx :inc-basic :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n65\t       \"<?php echo 'm'; include 'lib/a.php'; echo 'z';\" \"maz\")\n66\t   (fx :inc-return-value :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php return 5;\"}\n67\t       \"<?php $r = include 'a.php'; var_dump($r);\" \"int(5)\\n\")\n68\t   (fx :inc-default-one :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n69\t       \"<?php var_dump(include 'a.php');\" \"aint(1)\\n\")\n70\t   (fx :inc-once-repeat :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n71\t       \"<?php var_dump(include_once 'a.php'); var_dump(include_once 'a.php');\"\n72\t       \"aint(1)\\nbool(true)\\n\")\n73\t   (fx :inc-plain-then-once :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n74\t       \"<?php include 'a.php'; var_dump(include_once 'a.php');\" \"abool(true)\\n\")\n75\t   (fx :inc-plain-twice :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n76\t       \"<?php include 'a.php'; include 'a.php';\" \"aa\")\n77\t   (fx :inc-require-once-repeat :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php echo 'a';\"}\n78\t       \"<?php var_dump(require_once 'a.php'); var_dump(require_once 'a.php');\"\n79\t       \"aint(1)\\nbool(true)\\n\")\n80\t   (fx :inc-scope-sharing :inclusion-v1 #{:p6-s2} {\"a.php\" \"<?php $v = $v + 1;\"}\n81\t       \"<?php $v = 1; include 'a.php'; include 'a.php'; echo $v;\" \"3\")\n82\t   (fx :inc-dir-literal :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n83\t       \"<?php include __DIR__ . '/lib/a.php';\" \"a\")\n84\t   (fx :inc-dirname-file :inclusion-v1 #{:p6-s2} {\"lib/a.php\" \"<?php echo 'a';\"}\n85\t       \"<?php include dirname(__FILE__) . '/lib/a.php';\" \"a\")\n86\t   (fx :inc-nested :inclusion-v1 #{:p6-s2}\n87\t       {\"lib/a.php\" \"<?php echo 'a'; include 'lib/b.php';\", \"lib/b.php\" \"<?php echo 'b';\"}\n88\t       \"<?php include 'lib/a.php';\" \"ab\")\n89\t   (fx :inc-return-top-level-entry :inclusion-v1 #{:p6-s2} nil\n90\t       \"<?php echo 'a'; return; echo 'b';\" \"a\")\n91\t   (fx :inc-return-in-included :inclusion-v1 #{:p6-s2}\n92\t       {\"a.php\" \"<?php echo 'a'; return 3; echo 'x';\"}\n93\t       \"<?php var_dump(include 'a.php');\" \"aint(3)\\n\")\n94\t   (fx :inc-function-declared :inclusion-v1 #{:p6-s2}\n95\t       {\"a.php\" \"<?php function f() { return 'f'; }\"}\n96\t       \"<?php include 'a.php'; echo f();\" \"f\")\n97\t   (fx :inc-mutual-once :inclusion-v1 #{:p6-s2}\n98\t       {\"a.php\" \"<?php echo 'a'; include_once 'b.php';\",\n99\t        \"b.php\" \"<?php echo 'b'; include_once 'a.php';\"}\n100\t       \"<?php include_once 'a.php';\" \"ab\")\n101\t   (fx :inc-redeclare-across-units :inclusion-v1 #{:p6-s2}\n102\t       {\"a.php\" \"<?php function f() {}\"}\n103\t       \"<?php function f() {} include 'a.php';\" nil