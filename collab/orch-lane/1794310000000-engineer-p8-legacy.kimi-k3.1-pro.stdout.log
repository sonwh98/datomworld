{"role":"tool","tool_call_id":"tool_51G0RkG7IT2TQsa9wtTzJP3j","content":"55\t\n56\t(defn ns->path\n57\t  [ns-sym]\n58\t  (-> (name ns-sym) (str/replace \"-\" \"_\") (str/replace \".\" \"/\")))\n59\t\n60\t\n61\t(defn resolve-file\n62\t  \"The repo-relative file for ns-sym on lane, or nil.\"\n63\t  [lane ns-sym]\n64\t  (let [p (ns->path ns-sym)\n65\t        lane-dir (name lane)]\n66\t    (some (fn [f] (when (.isFile (io/file f)) f))\n67\t          [(str \"src/\" lane-dir \"/\" p \".\" lane-dir)\n68\t           (str \"src/cljc/\" p \".cljc\")])))\n69\t\n70\t\n71\t(defn strip-nils\n72\t  \"Drops the nil a lane's arm leaves in a libspec position\n73\t   (`#?(:cljd nil :clj [x])` reads as nil on :cljd); deps-from-ns-decl\n74\t   refuses nil as unparsable, the compilers ignore it.\"\n75\t  [form]\n76\t  (walk/postwalk (fn [x]\n77\t                   (cond (vector? x) (vec (remove nil? x))\n78\t                         (seq? x) (apply list (remove nil? x))\n79\t                         :else x))\n80\t                 form))\n81\t\n82\t\n83\t(defn ns-decl\n84\t  [lane file]\n85\t  (with-open [r (java.io.PushbackReader. (io/reader file))]\n86\t    (strip-nils (parse/read-ns-decl r {:read-cond :allow\n87\t                                       :features (lane-features lane)}))))\n88\t\n89\t\n90\t(defn lane-closure\n91\t  \"{file ns-sym} for every file reachable from root on lane.\"\n92\t  [lane]\n93\t  (loop [todo [root]\n94\t         seen #{}\n95\t         files {}]\n96\t    (if-let [n (first todo)]\n97\t      (if (seen n)\n98\t        (recur (rest todo) seen files)\n99\t        (let [seen (conj seen n)]\n100\t          (if-let [f (resolve-file lane n)]\n101\t            (let [decl (ns-decl lane f)\n102\t                  deps (sort (parse/deps-from-ns-decl decl))]\n103\t              (when-not (= n (parse/name-from-ns-decl decl))\n104\t                (throw (ex-info \"ns name does not match its file\"\n105\t                                {:lane lane :ns n :file f\n106\t                                 :declared (parse/name-from-ns-decl decl)})))\n107\t              (recur (concat (rest todo) deps) seen (assoc files f n)))\n108\t            (recur (rest todo) seen files))))\n109\t      files)))\n110\t\n111\t\n112\t;; ---------------------------------------------------------------------------\n113\t;; §3.1 classes. Keys are namespaces; a row's namespaces are named exactly as\n114\t;; the §3.1 table names them, expanded where the table abbreviates (\".datagram\"\n115\t;; = dao.stream.datagram, \"the seams\" = the lane-specific ws/datagram files).\n116\t;; Files of the §3.2 random-uuid/rand list carry :deferred-entropy.\n117\t;; ---------------------------------------------------------------------------\n118\t\n119\t(def class-rows\n120\t  [[:profile-internal-pure \"H1-H2 (writer H4); the dao.host profile (H1, reached at H2)\"\n121\t    '[dao.host.integer dao.host.float dao.host.number dao.host.bytes dao.host.text\n122\t      dao.host.hash dao.host.sign\n123\t      dao.jing.cbor\n124\t      yin.vm.debruijn yin.vm.debruijn-code yin.vm.data yin.vm.values\n125\t      dao.stream.chunks dao.stream.base64 dao.jing.dht yin.vm.linker\n126\t      dao.stream.datagram dao.data.arrays yang.core.call]]\n127\t   [:profile-hash-sign \"H3\" '[dao.jing yin.vm.linker.sign]]\n128\t   [:consumer \"H2 (require change only)\"\n129\t    '[yin.vm yin.vm.engine yin.vm.values yin.vm.data yin.vm.integer]]\n130\t   [:external-stream-seam \"none (existing streams)\"\n131\t    '[dao.stream.ws dao.stream.datagram dao.stream.ws.jvm dao.stream.ws.node\n132\t      dao.stream.ws.dart dao.stream.datagram.jvm dao.stream.datagram.node\n133\t      dao.stream.datagram.dart dao.stream.waitset.driver yin.repl.host\n134\t      yin.repl.host.jvm yin.repl.host.common dao.stream.ringbuffer]]\n135\t   [:deferred-storage \"deferred §9.2\"\n136\t    '[dao.jing.file dao.space.store.fs dao.space.store\n137\t      dao.stream.journal.file dao.data.btree.storage\n138\t      yin.repl.store]]\n139\t   [:deferred-entropy \"deferred §9.1\"\n140\t    '[dao.stream.ringbuffer dao.stream.memory-log dao.stream.ws\n141\t      dao.stream.remote dao.stream.remote-pair dao.stream.remote-route\n142\t      dao.stream.journal dao.jing.content.step dao.lease dao.space.store.fs\n143\t      yin.vm.linker yin.vm.ucf.custody yin.vm.ucf.holder.driver yin.vm.telemetry\n144\t      yin.repl yin.repl.dht dao.stream.rpc dao.jing.dht dao.space.dht"}
