{"role":"tool","tool_call_id":"tool_18FKTOFl8In3eoWqw6nwniuf","content":"982\t\n983\t;; ---------------------------------------------------------------------------\n984\t;; Tests\n985\t;; ---------------------------------------------------------------------------\n986\t\n987\t(deftest closure-totals-are-the-design-totals\n988\t  (testing \"§3.1 after H4, the yang.core L2 regeneration, J6b's ws parser/upgrade and yang.core.call joining the closure: 156 / 154 / 155 files, 148 shared\"\n989\t    (let [files (into {} (map (fn [l] [l (set (map :file (:files (committed-closure l))))]) lanes))]\n990\t      (is (= 156 (count (files :clj))))\n991\t      (is (= 154 (count (files :cljs))))\n992\t      (is (= 155 (count (files :cljd))))\n993\t      (is (= 148 (count (apply set/intersection (vals files)))))\n994\t      (doseq [l lanes]\n995\t        (is (= (count (files l)) (:total (committed-closure l))))\n996\t        (is (every? #(seq (:classes %)) (:files (committed-closure l))))))))\n997\t\n998\t\n999\t(deftest independent-traversal-agrees-with-the-committed-closure\n1000\t  (doseq [l lanes]\n1001\t    (testing (str \"lane \" l)\n1002\t      (let [committed (set (map :file (:files (committed-closure l))))\n1003\t            walked (traverse l)]\n1004\t        (is (= #{} (set/difference committed walked)) \"committed, not walked\")\n1005\t        (is (= #{} (set/difference walked committed)) \"walked, not committed\")))))\n1006\t\n1007\t\n1008\t(deftest gate-passes-on-the-current-tree\n1009\t  (let [r @current]\n1010\t    (is (= 168 (count (closure-files))) \"the union of the three lanes\")\n1011\t    (is (= 168 (count (gate-files))) \"no profile addition outside the closure after H3\")\n1012\t    (is (= (count (gate-files)) (:scanned r)))\n1013\t    (is (= [] (:errors r)))"}
