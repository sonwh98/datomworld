1\npath.write_text(text.replace(old, ''))\nreceipt = Path('build/gambit-dht-durable/run.becstu74/dht-store/content.jing')\nassert bytes.fromhex('8825cf13621fc4200884406d5a9f0665e5ae1c9bdc70eee743eddc2cce5c9209') in receipt.read_bytes()\nPY\ngit add test/gambit/yin-dht-durable.py\ngit diff --cached --check\nprefix=\\\"\"'$HOME/.local/share/mise/installs/gambit/4.9.8\"\nJOLT_REQUIRE_GAMBIT=1 GAMBIT_DHT_TIMEOUT_SECONDS=6600 caffeinate -i sh host/gambit/ffi/watchdog.sh 13800 make -o gambitffi-bridge gambitdht-durable GAMBIT_PREFIX=\"$prefix\" >build/p2final/durable-idle.log 2>build/p2final/durable-idle.stderr'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
