{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"set -eu\npython3 - <<'PY'\nfrom pathlib import Path\nr = Path('build/p2final')\nwire = (r/'durable-wire-check.jolt').read_text()\ntimed = (r/'durable-timing-check.jolt').read_text()\nwire = wire.replace('220)', '1100)').replace('[:op :q :need-cookie :ok]', '[:op :q :need-cookie :ok :address]')\ntimed = timed[timed.index('(def \"'^:private timed-dht-limits'\"'):].replace('30000', '60000').replace('90000', '180000')\n(r/'durable-tuned-wire-check.jolt').write_text(wire + '\\\\n' + timed)\nlauncher = (r/'durable-wire-check.ss').read_text().replace('durable-wire-check.jolt', 'durable-tuned-wire-check.jolt')\n(r/'durable-tuned-wire-check.ss').write_text(launcher)\nrunner = (r/'run-durable-diagnostic.py').read_text()\nrunner = runner.replace('import tempfile', 'import tempfile\\\\nimport time')\nrunner = runner.replace(\\\"harness['exercise'](launch, run, 'dht', harness['reserve_ports']())\\\",'''def await_blob(self, directory, address):\n    digest = bytes.fromhex(address.rsplit('-', 1)[1])\n    log = directory / 'content.jing'\n    deadline = time.monotonic() + 360\n    print(f'Waiting for {address} at {time.monotonic()}', flush=True)\n    while self.process.poll() is None and time.monotonic() < deadline:\n        if log.is_file() and digest in log.read_bytes():\n            print(f'Peer persisted {address} at {time.monotonic()}', flush=True)\n            return\n        time.sleep(0.25)\n    raise RuntimeError(f'missing replicated {address} in {log}')\n\nharness['Session'].await_durable_blob = await_blob\nharness['exercise'](launch, run, 'dht', harness['reserve_ports']())''')\n(r/'run-durable-tuned-diagnostic.py').write_text(runner)\nPY\nprefix=\\\"\"'$HOME/.local/share/mise/installs/gambit/4.9.8\"\nJOLT_GAMBIT_YIN_MODE=compiled GAMBIT_DHT_TIMEOUT_SECONDS=3600 caffeinate -i sh host/gambit/ffi/watchdog.sh 4800 python3 build/p2final/run-durable-tuned-diagnostic.py \"$prefi