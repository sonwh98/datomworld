{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"set -eu\npython3 - <<'PY'\nfrom pathlib import Path\n\nfixture = Path('test/gambit/fixtures/yin-durable.jolt')\ntext = fixture.read_text()\nanchor = ';; Appended by the process gate to observe the actual selected store.\\\\n'\ninitial = '''(require '[jolt.scheme :as durable-test-scheme])\n(def \"'^:private durable-witness-trigger\n  ((durable-test-scheme/proc \"getenv\") \"JOLT_YIN_DURABLE_WITNESS\" false))\n(def ''^:private durable-trigger-exists? (durable-test-scheme/proc \"file-exists?\"))\n(def ''^:private durable-witness-written? (atom false))\n'\"'''\nassert text.count(anchor) == 1\ntext = text.replace(anchor, anchor + initial)\nold = '''(defn -main [& args]\n  (main/main\"'! args (assoc composition :open durable-test-open)))\n'\"'''\nnew = '''(defn- durable-test-step [session now]\n  (let [[next lines events] ((:step composition) session now)]\n    ;; Replicate the witness before the fixture's REPL commands publish their\n    ;; own code indexes. The actual composition and UDP owner do the transport.\n    (if (and durable-witness-trigger\n             (not @durable-witness-written?)\n             (durable-trigger-exists? durable-witness-trigger))\n      (let [address (durable-test-run :put)]\n        (reset\"'! durable-witness-written? true)\n        [next (conj lines (str \"p2 durable witness \" address)) events])\n      [next lines events])))\n\n(defn -main [& args]\n  (main/main! args (assoc composition :open durable-test-open :step durable-test-step)))\n'\"'''\nassert text.count(old) == 1\nfixture.write_text(text.replace(old, new))\n\nprobe = Path('test/gambit/yin-dht-durable.py')\ntext = probe.read_text()\nold = '''        writer = cleanup.enter_context(launch(f\\\"{kind}-write\\\", args))\n        writer.require_probe()\n        if peer is not None:\n            peer.await_output(r\\\"\"'^yin> \")\n        address = writer.probe(\"put\", ADDRESS)\n        if peer is not None:\n            peer.await_durable_blob(run / \"peer-store\", address)\n            peer.require_probe()\n            peer.probe(\"get\", VALUE)\n        writer.probe(\"get\", VALUE)\n'\"'''\nnew = '''        writer = cleanup.enter_context(launch(f\\\"{kind}-write\\\", args))\n        if peer is None:\n            writer.require_probe()\n            address = writer.probe(\\\"put\\\", ADDRESS)\n        else:\n            for owner in (writer, peer):\n                owner.await_output(r\\\"\"'^(?:yin> )*dht: node .* listening on \")\n            (run / \"dht-witness.ready\").touch()\n            address = writer.await_output(rf\"''^(?:yin> )*p2 durable witness ({ADDRESS})$\")[1]\n            peer.await_durable_blob(run / \"peer-store\", address)\n            peer.require_probe()\n            peer.probe(\"get\", VALUE)\n            writer.require_probe()\n        writer.probe(\"get\", VALUE)\n'\"'''\nassert text.count(old) == 1\ntext = text.replace(old, new)\nold = '''    def launch(name, args):\n        return Session(run, name, command, overlay, env, args)\n'''\nnew = '''    def launch(name, args):\n        if name == \\\"dht-write\\\":\n            return Session(run, name, command, overlay,\n                           dict(env, JOLT_YIN_DURABLE_WITNESS=str(run / \\\"dht-witness.ready\\\")), args)\n        return Session(run, name, command, overlay, env, args)\n'''\nassert text.count(old) == 1\nprobe.write_text(text.replace(old, new))\nPY\ngit add test/gambit/fixtures/yin-durable.jolt test/gambit/yin-dht-durable.py\ngit diff --cached --check\nprefix=\\\"\"'$HOME/.local/share/mise/installs/gambit/4.9.8\"\nsnapshot=\"$PWD/build/p2final/datomworld-bab7640f\"\nJOLT_REQUIRE_GAMBIT=1 GAMBIT_DHT_TIMEOUT_SECONDS=6600 caffeinate -i sh host/gambit/ffi/watchdog.sh 13800 make -o gambitffi-bridge gambitdht-durable GAMBIT_PREFIX=\"$prefix\" DATOMWORLD_ROOT=\"$snapshot\" >build/p2final/durable-first-gate.log 2>build/p2final/durable-first-gate.stderr'","aggregat