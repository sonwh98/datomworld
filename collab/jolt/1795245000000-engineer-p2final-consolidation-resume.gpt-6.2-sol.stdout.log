{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"set -eu\ncp test/gambit/fixtures/yin-durable.jolt build/p2final/durable-first-witness.jolt\ncat >>build/p2final/durable-first-witness.jolt <<'EOF'\n\n(require '[jolt.scheme :as probe-scheme])\n(def \"'^:private seed-trigger ((probe-scheme/proc \"getenv\") \"JOLT_YIN_DURABLE_WITNESS\" false))\n(def ''^:private seed-ready? (probe-scheme/proc \"file-exists?\"))\n(def ''^:private seeded? (atom false))\n(defn- seeded-step [session now]\n  (let [[next lines events] ((:step composition) session now)]\n    (if (and seed-trigger (not @seeded?) (seed-ready? seed-trigger))\n      (let [address (durable-test-run :put)]\n        (reset! seeded? true)\n        [next (conj lines (str \"p2 durable witness \" address)) events])\n      [next lines events])))\n(defn -main [& args]\n  (main/main! args (assoc composition :open durable-test-open :step seeded-step)))\nEOF\nsed '\"'s@../../test/gambit/fixtures/yin-durable\\\\.jolt@durable-first-witness.jolt@' build/p2final/durable-compiled-check.ss >build/p2final/durable-first-witness.ss\nprefix=\\\"\"'$HOME/.local/share/mise/installs/gambit/4.9.8\"\nJOLT_GAMBIT_YIN_MODE=compiled GAMBIT_DHT_TIMEOUT_SECONDS=1800 caffeinate -i sh host/gambit/ffi/watchdog.sh 2000 python3 - \"$prefix/bin/gsi\" >build/p2final/durable-first-witness.log 2>build/p2final/durable-first-witness.stderr <<'\"'PY'\nfrom contextlib import ExitStack\nimport os\nfrom pathlib import Path\nimport runpy\nimport sys\nimport tempfile\n\nrepo = Path.cwd()\nrun = Path(tempfile.mkdtemp(prefix='dht-first-witness-', dir=repo / 'build/p2final'))\nharness = runpy.run_path('test/gambit/yin-dht-durable.py')\nentry = repo / 'build/p2final/durable-first-witness.ss'\nprint(f'Durable first-witness receipts: {run}', flush=True)\n\ndef launch(name, args):\n    command = [sys.argv[1], entry, (repo / '../datomworld').resolve()]\n    env = dict(os.environ)\n    if name == 'dht-write':\n        env['JOLT_YIN_DURABLE_WITNESS'] = str(run / 'seed')\n    return harness['Session'](run, name, command, repo, env, args)\n\nwriter_port, peer_port = harness['reserve_ports']()\nwith ExitStack() as cleanup:\n    peer = cleanup.enter_context(launch('dht-peer', ['--no-state', '--index-store', f'dht:{run / \\\"peer-store\\\"}', '--dht-peer', f'127.0.0.1:{writer_port}', '--dht-port', str(peer_port), '--dht-publish']))\n    writer = cleanup.enter_context(launch('dht-write', ['--no-state', '--index-store', f'dht:{run / \\\"dht-store\\\"}', '--dht-peer', f'127.0.0.1:{peer_port}', '--dht-port', str(writer_port), '--dht-publish']))\n    for process in (peer, writer):\n        process.await_output(r'\"'^(?:yin> )*dht: node .* listening on '\"')\n    (run / 'seed').touch()\n    address = writer.await_output(rf'\"'^(?:yin> )*p2 durable witness ({harness[\"ADDRESS\"]})$'\"')[1]\n    peer.await_durable_blob(run / 'peer-store', address)\n    print(f'Peer persisted {address}', flush=True)\n    peer.require_probe()\n    peer.probe('get', harness['VALUE'])\n    print('Peer read the replicated value through Yin', flush=True)\n    peer.quit()\n    writer.quit()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
