{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/zsh -lc \"set -e\nmkdir -p build/p2b/synthetic/runtime/host/gambit/yin/jolt/gambit build/p2b/synthetic/runtime/build\nmkdir -p build/p2b/synthetic/source/src/cljc/{yin/repl,dao/space}\ncat > build/p2b/synthetic/runtime/host/gambit/yin/jolt/gambit/yin.jolt <<'EOF'\n(ns jolt.gambit.yin\n  (:require [yin.repl.main :as main]))\n(defmacro with-value [form]\n  (let [v (gensym \\\"test__\\\")]\n    \"'`(let [~v ~form] ~v)))\n(def scored (with-value 42))\n(defn -main [& args]\n  (println \"yin>\" (main/check scored) (gensym \"seen__\")))\nEOF\ncat > build/p2b/synthetic/source/src/cljc/yin/repl/main.cljc <<'\"'EOF'\n(ns yin.repl.main)\n(defn check [n] (+ n 1))\nEOF\ncat > build/p2b/synthetic/source/src/cljc/dao/space/dht.cljc <<'EOF'\n(ns dao.space.dht)\n(def dht-ready true)\nEOF\nln -s \\\"\"'$PWD/build/gambit-ffi\" build/p2b/synthetic/runtime/build/gambit-ffi\nroot=\"$PWD\"\ncd build/p2b/synthetic/runtime\nJOLT_GAMBIT_YIN_SOURCE_KERNEL=1 JOLT_TRACE_SOURCE=1 TMPDIR=\"$root/build/p2b/tmp\" '\"\\\\\n  sh \\\"\"'$root/host/gambit/ffi/watchdog.sh\" 240 /Users/sto/.local/share/mise/installs/gambit/4.9.8/bin/gsi '\"\\\\\n  \\\"\"'$root/host/gambit/yin-repl-native.ss\" ../source > \"$root/build/p2b/synthetic/source.log\" 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
