$launcher\" \\\n  \"$yin_root\" --no-state --index-store mem >\"$transcript\" <<'FORMS' || status=$?\n(+ 1 2)\n((fn [x] (* x x)) 7)\n(def p1c-score 100)\n(+ p1c-score 1)\n(/ 1 0)\n(lang :yang/python)\n","exit_code":0,"status":"completed"}}
