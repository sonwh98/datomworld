{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat host/gambit/yin-repl-driver.ss && ls -l bin && rg -n 'yin-repl|gambit-yin|JOLT_TRACE_SOURCE' bin host/gambit Makefile && sed -n '1920,2030p;2100,2260p' Makefile\"","aggregated_output":";; The native and interpreted boots use the same source loader and Yin owner.\n(##include \"host-apply.ss\")\n(##include \"source-loader.ss\")\n(##include \"unbound-vars-lib.ss\")\n(##include \"yin/blake3.ss\")\n\n(define (gambit-yin-random-bytes size)\n  (let* ((n (jnum->exact size))\n         (out (make-u8vector n)))\n    (call-with-input-file \"/dev/urandom\"\n      (lambda (port)\n        (unless (= (read-subu8vector out 0 n port) n)\n          (error \"Gambit could not read OS entropy\"))))\n    out))\n\n;; A single outstanding request keeps the input reader from filling the\n;; mailbox. Only Yin's owner interprets submitted lines.\n(define (gambit-yin-wake)\n  (vector\n    (thread-start!\n      (make-thread\n        (lambda ()\n          (let loop ()\n            (let* ((owner (thread-receive))\n                   (line (read-line)))\n              (thread-send owner (if (eof-object? line) jolt-nil line))\n              (unless (eof-object? line) (loop)))))))\n    #f))\n\n(define (gambit-yin-close-wake! wake)\n  (thread-terminate! (vector-ref wake 0))\n  jolt-nil)\n\n(define (gambit-yin-wait-input! wake ms on-line)\n  (let ((seconds (/ ms 1000.0)))\n    (if (jolt-nil? on-line)\n        (thread-sleep! seconds)\n        (begin\n          (unless (vector-ref wake 1)\n            (thread-send (vector-ref wake 0) (current-thread))\n            (vector-set! wake 1 #t))\n          (let ((line (thread-receive seconds #f)))\n            (when line\n              (vector-set! wake 1 #f)\n              (jolt-invoke on-line line))))))\n  jolt-nil)\n\n(set! jolt-random-bytes gambit-yin-random-bytes)\n(register-class-statics! \"System\"\n  (list (cons \"currentTimeMillis\" gambit-epoch-ms)\n        (cons \"exit\" (lambda (status) (exit (jnum->exact status))))))\n\n(let ((args (cdr (command-line))))\n  (unless (pair? args)\n    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\n    (exit 2))\n  (let ((root (path-expand (car args)))\n        (jolt-root (current-directory)))\n    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\n      (fprintf (current-error-port) \"yin.repl: no source entry under ~a\\n\" root)\n      (exit 2))\n    (with-exception-catcher\n      (lambda (e)\n        (let* ((value (jolt-unwrap-throw e))\n               (message (jolt-throwable-message value))\n               (location (jolt-current-source-string)))\n          (fprintf (current-error-port) \"yin.repl startup failed: ~a\\n\"\n                   (if (string? message) message (jolt-pr-readable value)))\n          (when (and (string? location) (not (string=? location \"\")))\n            (fprintf (current-error-port) \"Yin source: ~a\\n\" location))\n          (exit 1)))\n      (lambda ()\n        ;; Cache the qualified bridge before resolving Yin's paths relative to\n        ;; its own checkout. The source loader itself uses absolute roots.\n        (joltffi-ensure-bridge! 'yin.repl)\n        (let ((load-ns\n                (gambit-install-source-loader!\n                  (list (list (path-expand \"host/gambit/yin\" jolt-root) \".jolt\")\n                        (list (path-expand \"src/jolt\" root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"src/cljc\" root) \".cljc\" \".clj\")\n                        (list (path-expand \"src/clj\" root) \".clj\")\n                        (list (path-expand \"stdlib\" jolt-root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"jolt-core\" jolt-root) \".cljc\" \".clj\"))\n                  '(\"clojure.core\"))))\n          (parameterize ((current-directory root))\n            (let* ((audit? (getenv \"JOLT_YIN_AUDIT\" #f))\n                   (before (and audit? (unbound-var-names))))\n              (dynamic-wind\n                (lambda () #f)\n                (lambda () (load-ns \"jolt.gambit.yin\" #f))\n                (lambda ()\n                  (when audit?\n                    (let ((added (filter (lambda (name) (not (member name before)))\n                                         (unbound-var-names))))\n                      (fprintf (current-error-port) \"yin source var audit: ~a newly unbound\\n\"\n                               (length added))\n                      (for-each (lambda (name) (fprintf (current-error-port) \"  ~a\\n\" name))\n                                added))))))\n            (def-var! \"yin.repl\" \"host-text\" (string-append \"Host: jolt / Gambit \" (system-version-string)))\n            (let ((main (var-deref \"jolt.gambit.yin\" \"-main\")))\n              (unless (procedure? main)\n                (error \"jolt.gambit.yin/-main did not load\"))\n              (apply jolt-invoke main (cdr args)))))))))\ntotal 24\n-rwxr-xr-x@ 1 sto  staff  6695 Nov 26 18:26 jolt\n-rwxr-xr-x@ 1 sto  staff   485 Nov 26 18:26 joltc\nMakefile:1989:# The interpreted bootstrap is available through yin-repl-main.ss. Compiling\nMakefile:2001:\t    \"$(GAMBIT_GSC)\" \"$(abspath build/gambit-yin)\") || exit $$?; \\\nMakefile:2006:\t  JOLT_GAMBIT_YIN_BOOT=\"$$boot\" sh test/gambit/yin-repl-session.sh \\\nMakefile:2007:\t    \"$(GAMBIT_GSI)\" \"$$yin_root\" host/gambit/yin-repl-native.ss; \\\nhost/gambit/source-loader.ss:81:           (when (getenv \"JOLT_TRACE_SOURCE\" #f)\nhost/gambit/source-loader.ss:92:             (when (getenv \"JOLT_TRACE_SOURCE\" #f)\nhost/gambit/yin-repl-driver.ss:7:(define (gambit-yin-random-bytes size)\nhost/gambit/yin-repl-driver.ss:18:(define (gambit-yin-wake)\nhost/gambit/yin-repl-driver.ss:30:(define (gambit-yin-close-wake! wake)\nhost/gambit/yin-repl-driver.ss:34:(define (gambit-yin-wait-input! wake ms on-line)\nhost/gambit/yin-repl-driver.ss:48:(set! jolt-random-bytes gambit-yin-random-bytes)\nhost/gambit/yin-repl-driver.ss:55:    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\nhost/gambit/yin/blake3.ss:67:(define (gambit-yin-blake3 bytes)\nhost/gambit/yin/dao/stream/waitset/driver.jolt:5:(def ^:private wait-input (scheme/proc \"gambit-yin-wait-input!\"))\nhost/gambit/yin/dao/stream/waitset/driver.jolt:7:(def make-wake (scheme/proc \"gambit-yin-wake\"))\nhost/gambit/yin/dao/stream/waitset/driver.jolt:8:(def close! (scheme/proc \"gambit-yin-close-wake!\"))\nhost/gambit/yin-repl-main.ss:3:;; gsi host/gambit/yin-repl-main.ss /path/to/datomworld [Yin arguments...].\nhost/gambit/yin-repl-main.ss:5:(##include \"yin-repl-driver.ss\")\nhost/gambit/yin/dao/host/hash.jolt:9:(def ^:private blake3 (scheme/proc \"gambit-yin-blake3\"))\nhost/gambit/yin-repl-native.ss:6:(##include \"yin-repl-driver.ss\")\nhost/gambit/yin/dao/posix/random.jolt:4:(def rand-bytes (scheme/proc \"gambit-yin-random-bytes\"))\n\t  fi; \\\n\t  rm -f \"$$out\"\n\n# Gambit seed-mint gate: re-mint the gambit seed into a temp dir on Chez and\n# require it to match host/gambit/seed/ byte-for-byte. Fails when gen-seed.ss\n# itself cannot run (a chez-only construct reached the emission) or when the\n# chez seed was re-minted without `make gambitseed`. Runs on Chez alone, so it\n# gates in CI whether or not gambit is installed.\ngambitseedcheck:\n\t@out=$$(mktemp -d); \\\n\t  if ! GEN_SEED_OUT_DIR=\"$$out\" $(CHEZ) --script host/gambit/gen-seed.ss > \"$$out/mint.log\" 2>&1; then \\\n\t    tail -20 \"$$out/mint.log\" >&2; \\\n\t    echo \"gambitseedcheck: gen-seed.ss FAILED — the gambit seed cannot be minted from current sources\" >&2; \\\n\t    rm -rf \"$$out\"; exit 1; \\\n\t  fi; \\\n\t  if diff -q \"$$out/prelude.ss\" host/gambit/seed/prelude.ss >/dev/null \\\n\t      && diff -q \"$$out/image.ss\" host/gambit/seed/image.ss >/dev/null; then \\\n\t    echo \"gambitseedcheck: gambit seed is current with the sources\"; \\\n\t    rm -rf \"$$out\"; \\\n\t  else \\\n\t    echo \"gambitseedcheck: host/gambit/seed is STALE — run 'make gambitseed'\" >&2; \\\n\t    rm -rf \"$$out\"; exit 1; \\\n\t  fi\n\n# Skip before building the native bridge when Gambit is absent. Explicit\n# gambitffi* targets still require an installation and local provenance.\ngambitcheck: $(if $(wildcard $(GAMBIT_GSI)),gambitffi-bridge)\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh host/gambit/ffi/watchdog.sh 120 \"$(GAMBIT_GSI)\" host/gambit/gambitcheck.ss && \\\n\t\tsh host/gambit/ffi/watchdog.sh 180 \"$(GAMBIT_GSI)\" host/gambit/ffi/gambitffi-public.ss; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\n# G2 kernel-test gate (jolt-mj95.4): the full booted manifest on native gsi,\n# driven through the real natives. Same detection-gated shape as gambitcheck;\n# a second on gsi. Run from the repo root (boot's irregex load is cwd-relative).\ngambitkernel:\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh host/gambit/ffi/watchdog.sh 120 \"$(GAMBIT_GSI)\" host/gambit/kernel-test.ss; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\n# G3 eval gate: real jolt source through jolt-compile-eval on the booted\n# manifest + cross-minted seed, renders pinned to Chez captures. Detection-\n# gated like gambitcheck. In the ci list: it is the only gate that runs\n# emitted code on gsi end to end, and while it sat outside ci every row failed\n# for two weeks (jolt-cw2p) with nothing red. Run from the repo root.\ngambiteval:\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh host/gambit/ffi/watchdog.sh 180 \"$(GAMBIT_GSI)\" host/gambit/eval-test.ss; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\n# The source-loader witness is self-contained. The full Yin gate reads a separate\n# datomworld checkout and stays opt-in while its native host closure is incomplete.\ngambitsourceload:\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh host/gambit/ffi/watchdog.sh 240 \"$(GAMBIT_GSI)\" host/gambit/source-loader-test.ss; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\nDATOMWORLD_ROOT ?= ../datomworld\ngambitdaobytes:\n\tsh host/gambit/ffi/watchdog.sh 240 \"$(GAMBIT_GSI)\" host/gambit/source-loader-test.ss \"$(abspath $(DATOMWORLD_ROOT))\"\n\n# The interpreted bootstrap is available through yin-repl-main.ss. Compiling\n# the same boot makes the full app closure fit the acceptance watchdog.\nGAMBIT_YIN_BOOT ?=\ngambityinrepl gambitdht: gambitffi-bridge\n\t@yin_root=\"$(abspath $(DATOMWORLD_ROOT))\"; \\\n\tif [ ! -f \"$$yin_root/src/cljc/yin/repl/main.cljc\" ]; then \\\n\t  echo \"$@: no Yin source entry under $$yin_root. Set DATOMWORLD_ROOT to a Datomworld checkout.\" >&2; \\\n\t  exit 2; \\\n\tfi; \\\n\tboot=\"$(GAMBIT_YIN_BOOT)\"; \\\n\tif [ -z \"$$boot\" ]; then \\\n\t  boot=$$(sh host/gambit/ffi/watchdog.sh 2400 python3 host/gambit/build-yin-boot.py \\\n\t    \"$(GAMBIT_GSC)\" \"$(abspath build/gambit-yin)\") || exit $$?; \\\n\tfi; \\\n\tif [ \"$@\" = gambitdht ]; then \\\n\t  sh test/gambit/yin-dht-probe.sh \"$(GAMBIT_GSI)\" \"$$yin_root\" \"$$boot\"; \\\n\telse \\\n\t  JOLT_GAMBIT_YIN_BOOT=\"$$boot\" sh test/gambit/yin-repl-session.sh \\\n\t    \"$(GAMBIT_GSI)\" \"$$yin_root\" host/gambit/yin-repl-native.ss; \\\n\tfi\n\n# Every Scheme global the full-profile boot references is defined — Gambit's\n# own linker report over the compiled boot, minus what the record translator\n# evals at runtime, against host/gambit/unbound-allowlist.txt (untaken paths;\n# a stale line fails). The boot splices most of host/chez, so a Chez-side name\n# reaching a shared file is otherwise an unbound global no Chez gate can see;\n# mirrordrift only compares names defined on BOTH hosts. It compiles the seed\n# to JS text; time varies by compiler build. Detection-gated. Ordered\n# after gambitboot: both regenerate boot-full.ss, and under -j a reader must\n# not open the file mid-rewrite.\ngambitunbound: gambitboot\n\t@if [ -x \"$(GAMBIT_GSC)\" ]; then \\\n\t\tJOLT_GSC=\"$(GAMBIT_GSC)\" sh host/gambit/unbound-check.sh; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\ngambitunbound-regen:\n\t@JOLT_GSC=\"$(GAMBIT_GSC)\" sh host/gambit/unbound-check.sh --regen\n\n# The jolt half of the same question: every var cell the boot interned is\n# bound. Emitted code reaches a var through its cell, so after the boot the\n\n# ---- P1b-stage1: the gambitffi* gates ----------------------------------------\n#\n# The bounded FFI tier qualified per the standing codex C4 PARTIAL-GO ruling:\n# memory ops, loading, ordinary calls and invocation-local errno capture,\n# behind the ahead-of-time native bridge (host/gambit/ffi/joltffi-bridge.scm,\n# compiled by gsc into build/gambit-ffi/joltffi-bridge.o1). Blocking,\n# callables, runtime signatures and object pinning keep their message-carrying\n# refusals; the gates assert both the witnesses AND the retained refusals.\n#\n# Deterministic bootstrap: every artifact builds from the pinned inputs in\n# host/gambit/ffi/DIGESTS.txt — verified before compiling, output digests\n# recorded after. No ambient .o1/.dylib is ever trusted. The aggregate target\n# is fail-closed: it passes only when all three gate scripts pass, and a gate\n# runs under the P1a-r2 external watchdog (host/gambit/ffi/watchdog.sh, the\n# same pattern the p1a witnesses use) so a frozen VM is a recorded failure,\n# never a hang.\n\nGAMBIT-FFI-DIR := host/gambit/ffi\nGAMBIT-FFI-BUILD := build/gambit-ffi\n\n# Keep Darwin's expanded link commands unchanged. Reject other hosts when an\n# FFI fixture recipe is expanded, without disabling unrelated make targets.\nGAMBIT-FFI-HOST-OS := $(shell uname -s)\nifeq ($(GAMBIT-FFI-HOST-OS),Darwin)\nGAMBIT-FFI-SHARED-FLAGS := -dynamiclib\nGAMBIT-FFI-ERRNO-ACCESSOR := __error\nelse ifeq ($(GAMBIT-FFI-HOST-OS),Linux)\nGAMBIT-FFI-SHARED-FLAGS := -shared -fPIC\nGAMBIT-FFI-ERRNO-ACCESSOR := __errno_location\nelse\nGAMBIT-FFI-SHARED-FLAGS = $(error gambitffi: unsupported fixture-link platform '$(GAMBIT-FFI-HOST-OS)' (expected Darwin or Linux))\nGAMBIT-FFI-ERRNO-ACCESSOR = $(error gambitffi: unsupported errno-accessor platform '$(GAMBIT-FFI-HOST-OS)' (expected Darwin or Linux))\nendif\n\n# the pinned inputs must match the recorded digests BEFORE anything compiles\ngambitffi-verify-digests:\n\t@sh $(GAMBIT-FFI-DIR)/verify-digests.sh \"$(GAMBIT_PREFIX)\"\n\n$(GAMBIT-FFI-BUILD)/joltffi-bridge.o1: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-bridge.scm \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt $(GAMBIT-FFI-DIR)/generated-shims.scm\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\t@rm -f $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 $(GAMBIT-FFI-BUILD)/joltffi-bridge.o[0-9]* \\\n\t       $(GAMBIT-FFI-BUILD)/joltffi-bridge.c $(GAMBIT-FFI-BUILD)/joltffi-bridge.o \\\n\t       $(GAMBIT-FFI-BUILD)/joltffi-bridge.scm\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/\n\tcd $(GAMBIT-FFI-BUILD) && sh ../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -dynamic -keep-temp -ld-options -pthread joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n\t  > $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1.sha256\n\t@cc --version > $(GAMBIT-FFI-BUILD)/compiler.txt\n\t@shasum -a 256 $(GAMBIT_GSC) $(GAMBIT_GSI) \"$(GAMBIT_PREFIX)/include/gambit.h\" \\\n\t  \"$(GAMBIT_PREFIX)/lib/libgambit.a\" > $(GAMBIT-FFI-BUILD)/runtime.sha256\n\n$(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-fixture.c \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-fixture.c\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib.sha256\n\n$(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-fixture2.c \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-fixture2.c\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib.sha256\n\n# the present-but-unloadable candidate: a one-symbol dylib linked against a\n# dependency dylib this recipe then REMOVES, so dlopen fails with the loader's\n# own preserved reason (a missing dependency, not a missing file)\n$(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/DIGESTS.txt \\\n\t\t$(GAMBIT-FFI-DIR)/joltffi-dep.c $(GAMBIT-FFI-DIR)/joltffi-unloadable.c\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib $(GAMBIT-FFI-DIR)/joltffi-dep.c\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-unloadable.c $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib\n\trm $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib.sha256\n\n# bridge + fixtures, always current: the entry every gambitffi gate depends on\n.PHONY: gambitffi-force gambitffi-verify-digests\ngambitffi-force:\n\ngambitffi-bridge: gambitffi-verify-digests $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib\n\ngambitffi-abi: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tJOLT_FFI_ERRNO_ACCESSOR=\"$(GAMBIT-FFI-ERRNO-ACCESSOR)\" sh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-abi.ss && \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 180 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-public.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n\n$(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1: $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1\n\t@mkdir -p $(GAMBIT-FFI-BUILD)/capture-test\n\t@rm -f $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o[0-9]*\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/capture-test/\n\tcd $(GAMBIT-FFI-BUILD)/capture-test && sh ../../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -dynamic -keep-temp -ld-options -pthread -cc-options -DJOLTFFI_CAPTURE_TEST joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1 > $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1.sha256\n\ngambitffi-errno-check: gambitffi-bridge $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-errno.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\ngambitffi-load-failure-smoke: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 90 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-load-failure.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n# The aggregate includes host/name hygiene and all three native gate scripts.\n# Each prerequisite exits nonzero on failure.\ngambitffi: emittedheads deadhost gambitffi-abi gambitffi-errno-check gambitffi-load-failure-smoke\n\t@echo \"gambitffi: PASS — all stage-1 qualified-tier gates green\"\n\n# The browser bundle: the whole stack (kernel + seed + compiler + a queue-polling\n# REPL loop) compiled to one JavaScript file by the Gambit backend. ~30s, ~32MB\n# raw / ~4MB gzipped, which is what a web server ships. Point GAMBIT_WEB_OUT at\n# a site checkout to refresh the live demo:\n#   make gambitweb GAMBIT_WEB_OUT=../jolt-lang.github.io/resources/static/js/jolt-web.js\n# NEVER bare gsc — that is Ghostscript on a brew machine.\n# PROFILE selects how much of the language the bundle carries (host/gambit/\n# profiles.ss lists them: full, repl, kernel). gen-boot.ss writes the boot for it\n# on Chez — Gambit resolves ##include at expansion time, so this cannot be a\n# runtime switch — and binds every name an excluded group owned to a raise that\n# names the group.\nPROFILE ?= full\nGAMBIT_WEB_OUT ?= target/gambit/jolt-web.js\ngambitweb:\n\t@if [ -x \"$(GAMBIT_GSC)\" ]; then \\\n\t\t$(CHEZ) --script host/gambit/gen-boot.ss $(PROFILE); \\\n\t\tmkdir -p \"$$(dirname \"$(GAMBIT_WEB_OUT)\")\"; \\\n\t\tout=\"$$(cd \"$$(dirname \"$(GAMBIT_WEB_OUT)\")\" && pwd)/$$(basename \"$(GAMBIT_WEB_OUT)\")\"; \\\n\t\t(cd host/gambit && \"$(GAMBIT_GSC)\" -target js -exe -o \"$$out\" repl-main.ss); \\\n\t\techo \"gambitweb: $(GAMBIT_WEB_OUT) ($$(wc -c < \"$$out\" | tr -d ' ') bytes,\\\n $$(gzip -c \"$$out\" | wc -c | tr -d ' ') gzipped)\"; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\n# G3 compiler-on-gsi (jolt-mj95.4): cross-mint the Gambit seed from the Chez\n# seed ON CHEZ with the backend target at :gambit (R9), grep-verifying the\n# emission contains no chez-only spelling before writing host/gambit/seed/.\n# Runs on CHEZ (gambitseed), not gsi.\ngambitseed:\n\t$(CHEZ) --script host/gambit/gen-seed.ss\n","exit_code":0,"status":"completed"}}
