{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"head -40 test/gambit/fixtures/yin-dht-probe.jolt && tail -30 test/gambit/fixtures/yin-dht-probe.jolt && cat host/gambit/yin/jolt/gambit/yin.jolt && rg -n 'emit-top-form|defn.*emit-def|top-form' jolt-core && sed -n '1770,1800p' host/chez/loader.ss\"","aggregated_output":";; Appended to a scratch copy of jolt.gambit.yin. Keep the real driver and\n;; launcher composition so each attempted operation gets its own Yin reply.\n(require '[dao.stream :as p1e-stream]\n         '[dao.stream.ringbuffer :as p1e-ring]\n         '[jolt.scheme :as p1e-scheme])\n\n(def ^:private p1e-var (p1e-scheme/proc \"var-deref\"))\n(def ^:private p1e-dir (jolt.host/getenv \"JOLT_P1E_STORE\"))\n(def ^:private p1e-durable (atom nil))\n(def ^:private p1e-memory (atom nil))\n(def ^:private p1e-session-store (atom nil))\n(def ^:private p1e-requests (atom nil))\n(def ^:private p1e-value {:p1e \"yin-dht-local-round-trip\" :count 3})\n\n(defn- p1e-call [namespace var-name & args]\n  ;; Defer each dependency so a failed load becomes a reply at the prompt.\n  (require (symbol namespace))\n  (apply (p1e-var namespace var-name) args))\n\n(defn- p1e-make-ring []\n  (:dao.stream/handle\n    (p1e-ring/create! {:dao.stream/type p1e-ring/transport-type\n                      p1e-ring/capacity-key 8})))\n\n(defn- p1e-next [ring cursor]\n  (p1e-stream/next ring (:dao.stream/cursor cursor)))\n\n(defn- p1e-open-shell []\n  (let [opened (p1e-call \"yin.shell.store\" \"open\" {:type :dht :dir p1e-dir} {})]\n    (reset! p1e-durable (:index-store opened))\n    :durable-dht-opened))\n\n(defn- p1e-open-dir []\n  (let [handle (p1e-call \"dao.space.store\" \"open\" p1e-dir)]\n    (jing/close! handle)\n    :durable-directory-opened))\n\n(defn- p1e-open-memory []\n  (let [requests (p1e-make-ring)\n        handle (p1e-call \"dao.jing.dht\" \"store-handle\"\n    :memory-put (if-let [handle @p1e-memory]\n                  (jing/materialize! handle p1e-value)\n                  :blocked-no-memory-dht-handle)\n    :memory-get (if-let [handle @p1e-memory]\n                  (jing/get handle (jing/segment-key p1e-value) :missing)\n                  :blocked-no-memory-dht-handle)\n    :replicate-request (= (jing/segment-key p1e-value)\n                          (:dao.jing.dht/replicate (p1e-check-request)))\n    :session-round-trip (p1e-session-round-trip)\n    :udp-loopback (p1e-loopback)\n    :udp-native-load (do (require 'jolt.socket.native) :socket-native-loaded)\n    :c4-control (p1e-call \"dao.posix.file\" \"realpath\" p1e-dir)\n    :close (do (jing/close! @p1e-durable) (jing/close! @p1e-memory) :closed)))\n\n(defn- p1e-activate [registry]\n  (module/register-host-module\n    registry 'p1e.probe\n    {'run p1e-run}\n    {'run (vm/primitive-profile 'run :pure [1] #{} :none)}))\n\n(defn- p1e-open [spec opts]\n  (let [opened (open-store spec opts)]\n    (when (= :dht spec)\n      (reset! p1e-session-store (:index-store opened)))\n    (assoc-in opened [:engine-inputs :host-modules 'p1e.probe] p1e-activate)))\n\n(defn -main [& args]\n  (main/main! args {:composition-spec? #{:mem :dht}\n                    :parse-store-arg parse-store\n                    :open p1e-open}))\n(ns jolt.gambit.yin\n  \"The memory and memory-backed DHT compositions for the Gambit terminal.\"\n  (:require [dao.jing :as jing]\n            [jolt.ffi :as ffi]\n            [yin.repl.main :as main]\n            [yin.repl.store :as store]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n(defn- activate-ffi [registry]\n  (module/register-host-module\n    registry 'jolt.ffi\n    {'sizeof ffi/sizeof}\n    {'sizeof (vm/primitive-profile 'sizeof :pure [1] #{} :none)}))\n\n(defn- materialize-sha256 [value]\n  (jing/materialize! (store/open :mem) value {:algorithm :sha256}))\n\n(defn- activate-store [registry]\n  (module/register-host-module\n    registry 'dao.jing.mem\n    {'materialize-sha256 materialize-sha256}\n    {'materialize-sha256\n     (vm/primitive-profile 'materialize-sha256 :pure [1] #{} :none)}))\n\n(def ^:private memory-engine-inputs\n  {:host-modules {'jolt.ffi activate-ffi\n                  'dao.jing.mem activate-store}})\n\n(defn- open-memory [spec _opts]\n  {:index-store (store/open spec)\n   :engine-inputs memory-engine-inputs})\n\n(defn- open-dht []\n  (let [join (requiring-resolve 'dao.space.dht/join)\n        payload-budget (requiring-resolve 'dao.space.dht/payload-budget)\n        local (store/open :mem)\n        node (try\n               (join {:local local})\n               (catch Throwable e\n                 (jing/close! local)\n                 (throw e)))\n        handle (:handle node)]\n    (try\n      {:index-store handle\n       :publication-policy {:max-payload-bytes (payload-budget node)}}\n      (catch Throwable e\n        (jing/close! handle)\n        (throw e)))))\n\n(defn- open-store [spec opts]\n  (if (= spec :dht)\n    (assoc (open-dht) :engine-inputs memory-engine-inputs)\n    (open-memory spec opts)))\n\n(defn- parse-store [arg]\n  (if (= arg \"dht:\")\n    :dht\n    (let [spec (store/parse-arg arg [{:prefix \"dht:\" :label \"dht:\"\n                                     :parse (fn [dir]\n                                              (throw (ex-info\n                                                       \"Gambit supports --index-store dht: with memory backing. Durable dht:<dir> requires Chez.\"\n                                                       {:dir dir})))}])]\n      (when-not (= spec :mem)\n        (throw (ex-info \"The local Gambit session supports --index-store mem or dht:\"\n                        {:store spec})))\n      spec)))\n\n(defn -main [& args]\n  (main/main! args {:composition-spec? #{:mem :dht}\n                    :parse-store-arg parse-store\n                    :open open-store}))\njolt-core/jolt/backend_scheme.clj:300:(defn- emit-def-meta [node]\njolt-core/jolt/backend_scheme.clj:714:(defn- emit-deftype-slot-read [arg-nodes order-args]\njolt-core/jolt/backend_scheme.clj:727:(defn- emit-deftype-slot-write [arg-nodes order-args]\njolt-core/jolt/backend_scheme.clj:1126:(defn- emit-def-node [node]\njolt-core/jolt/backend_scheme.clj:1566:(defn- emit-def-init [node dl-self anon-variadic fn?]\njolt-core/jolt/backend_scheme.clj:1602:(defn- emit-def-cached [node]\njolt-core/jolt/backend_scheme.clj:1666:(defn emit-top-form\njolt-core/jolt/backend_scheme.clj:1667:  ([node] (emit-top-form node nil))\njolt-core/jolt/backend_scheme.clj:1702:                (str \"(begin \" (str/join \" \" (map emit-top-form (:statements node)))\njolt-core/jolt/backend_scheme.clj:1703:                     (if (empty? (:statements node)) \"\" \" \") (emit-top-form (:ret node)) \")\")\njolt-core/jolt/backend_scheme/fnsrc.clj:19:;; Bound where emit-top-form / the :def cases establish per-top-level-form\njolt-core/jolt/backend_scheme/hoist.clj:341:(defn- top-form-repeats? [node]\njolt-core/jolt/backend_scheme/hoist.clj:344:(defn- top-form-has-fn? [node]\njolt-core/jolt/backend_scheme/hoist.clj:363:    (top-form-repeats? node) (emit-with-cells emit-thunk)\njolt-core/jolt/backend_scheme/hoist.clj:364:    (top-form-has-fn? node) (emit-with-scope false emit-thunk)\njolt-core/jolt/backend_scheme/hoist.clj:402:;; that fn RUNS. This scope is opened once per top-level form (emit-top-form) and\n;; Tee the per-form emitted Scheme (compile-eval.ss jolt-aot-capture) while running\n;; the normal load loop, so a cache miss reproduces the EXACT interleaved analyze\n;; →eval semantics (forward macro refs and same-file requires expand correctly).\n;; The captured Scheme, loaded in order, reproduces every top-level effect — the\n;; same property `jolt build` / the seed mint rely on.\n;; parameterize (not a bare set!) so a require fired by this ns's forms — which\n;; itself triggers a nested aot-capture-load — restores OUR capture port on\n;; return. A bare thread-parameter set would be clobbered by the nested capture\n;; and reset to #f, dropping this ns's forms AFTER the require (the require's\n;; target would cache, but the requiring ns's own defs would vanish from its .so).\n(define (aot-capture-load file src)\n  (ldr-need-compiler! file)\n  (let ((cap (open-output-string)))\n    (parameterize ((jolt-aot-capture cap) (jolt-aot-capture-file file))\n      (load-jolt-file* file src)\n      (get-output-string cap))))\n;; On a miss: run the capture load (which also evals the ns into the running\n;; image), then fasl the captured Scheme. A compile-file failure is non-fatal —\n;; the ns is already loaded; we just skip caching this run and miss again next.\n;; mkdir -p without a subprocess. The built Windows jolt runs jolt-sh via\n;; cmd.exe, where `mkdir -p <forward/slash/path>` is invalid syntax, so the\n;; cache dir was never created and open-output-file failed. Native mkdir +\n;; path-parent recursion is portable (mirrors build.ss bld-mkdir-p).\n(define (aot-mkdir-p dir)\n  (unless (or (not dir) (string=? dir \"\") (string=? dir \"/\") (string=? dir \".\") (file-exists? dir))\n    (aot-mkdir-p (path-parent dir))\n    ;; tolerate the benign race (created concurrently); re-raise a real failure.\n    (guard (e (#t (unless (file-exists? dir) (raise e))))\n      (mkdir dir))))\n;; Publish the cached .scm/.so atomically. Parallel jolt processes (e.g. the cts\n;; gate's workers) share one cache dir and can compile the SAME namespace at once;\n","exit_code":0,"status":"completed"}}
