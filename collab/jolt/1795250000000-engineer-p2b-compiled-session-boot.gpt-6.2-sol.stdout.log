{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\n\np = Path(\\\"Makefile\\\")\ns = p.read_text()\ns = s.replace(\\\"gambitdaobytes gambityinrepl gambitdht gambitseed\\\", \\\"gambitdaobytes gambityinrepl gambitdht gambityinequivalence gambitseed\\\")\nstart = s.index(\\\"# The interpreted bootstrap is available through yin-repl-main.ss.\\\")\nstop = s.index(\\\"# Every Scheme global\\\", start)\ns = s[:start] + \\\"\\\"\\\"# The gates require the native startup by default. Use mode=source only for\n# debugging through the launcher; the equivalence gate always runs both modes.\nGAMBIT_YIN_BOOT ?=\nGAMBIT_YIN_CACHE ?= \"'$(abspath build/gambit-yin)\ngambityinrepl gambitdht gambityinequivalence: export JOLT_GAMBIT_YIN_CACHE = $(GAMBIT_YIN_CACHE)\ngambityinrepl gambitdht gambityinequivalence: export JOLT_GAMBIT_YIN_BOOT = $(GAMBIT_YIN_BOOT)\ngambityinrepl gambitdht gambityinequivalence: gambitffi-bridge\n\t@yin_root=\"$(abspath $(DATOMWORLD_ROOT))\"; '\"\\\\\\\\\n\tif [ \"'! -f \"$$yin_root/src/cljc/yin/repl/main.cljc\" ]; then '\"\\\\\\\\\n\t  echo \\\"\"'$@: no Yin source entry under $$yin_root. Set DATOMWORLD_ROOT to a Datomworld checkout.\" >&2; '\"\\\\\\\\\n\t  exit 2; \\\\\\\\\n\tfi; \\\\\\\\\n\tcase \\\"\"'$@\" in '\"\\\\\\\\\n\t  gambitdht) JOLT_GAMBIT_YIN_MODE=compiled sh test/gambit/yin-dht-probe.sh \\\"\"'$(GAMBIT_GSI)\" \"$$yin_root\" ;; '\"\\\\\\\\\n\t  gambityinrepl) JOLT_GAMBIT_YIN_MODE=compiled sh test/gambit/yin-repl-session.sh \\\"\"'$(GAMBIT_GSI)\" \"$$yin_root\" ;; '\"\\\\\\\\\n\t  gambityinequivalence) python3 test/gambit/yin-equivalence.py \\\"\"'$(GAMBIT_GSI)\" \"$$yin_root\" ;; '\"\\\\\\\\\n\tesac\n\n\\\"\\\"\\\" + s[stop:]\ns = s.replace(\\\"# The gates require the native startup by default. Use mode=source only for\\\", \\\"# The gates require the native startup by default. Use source mode\\\")\ns = s.replace(\\\"# debugging through the launcher; the e