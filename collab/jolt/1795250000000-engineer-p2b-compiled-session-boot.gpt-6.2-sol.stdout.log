e command.\nexec python3 -c '\nimport os, signal, subprocess, sys\nseconds = float(sys.argv[1])\np = subprocess.Popen(sys.argv[2:], start_new_session=True)\ntry:\n    status = p.wait(timeout=seconds)\nexcept subprocess.TimeoutExpired:\n    os.killpg(p.pid, signal.SIGKILL)\n    p.wait()\n    print(\"WATCHDOG: TIMEOUT after %ss: %s\" % (seconds, \" \".join(sys.argv[2:])), file=sys.stderr)\n    sys.exit(124)\nsys.exit(status if status >= 0 else 128 - status)\n' \"$@\"\n-14f07644080070246974942415a104228d9a6b04 vendor/cli\n-489b6743e8421687ef96cec557830acf258d1886 vendor/clojure-test-suite\n-5b273b8a943a622593fbc85fca6761c5a39d6d66 vendor/fs\n-688e0ed6618582eccc8c8b745243ceac92835e03 vendor/grenadine\n-c948a704fc732914a243c1643bfe359913d11c7b vendor/irregex\n-43bdd65e189f2ccacc56662c53a21f5470ff1500 vendor/process\n-32d62a5136ad3dc148588752f5bcc4cc30b14752 vendor/sci\nFilesystem      Size    Used   Avail Capacity iused ifree %iused  Mounted on\n/dev/disk3s5   460Gi   295Gi   128Gi    70%    3.3M  1.3G    0%   /System/Volumes/Data\n","exit_code":0,"status":"completed"}}
