in-close-wake!\"))\n(defn nudge! [_wake] nil)\n\n(defn sleep! [wake ms]\n  (wait-input wake ms nil))\n\n(defn sleep-fds! [wake ms _pump on-line]\n  (wait-input wake ms on-line))\n\n(defn sleep-input! [wake ms on-line]\n  (sleep-fds! wake ms nil on-line))\n../datomworld/src/cljc/yin/repl/main.cljc:1196:                    #(wake/sleep! w %)\n../datomworld/src/cljc/yin/repl/main.cljc:1306:                          (wake/sleep-fds! w ms (:pump adapter)\n../datomworld/src/jolt/dao/stream/waitset/driver.jolt:165:(defn sleep-fds!\n../datomworld/src/jolt/dao/stream/waitset/driver.jolt:210:(defn sleep-input!\n../datomworld/src/jolt/dao/stream/waitset/driver.jolt:214:  (sleep-fds! wake sleep-ms nil line!))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1185,1215p;1260,1325p' ../datomworld/src/cljc/yin/repl/main.cljc\nsed -n '137,217p' ../datomworld/src/jolt/dao/stream/waitset/driver.jolt\nrg -n 'defn.*(step|pump)|:pump|udp' ../datomworld/src/cljc/yin/shell/dht.cljc | tail -25\nrg -n 'dht:.*(acknowledge|error)|\"'^yin> '\"' build/gambit-dht-durable/run.j7uxsgri/{dht-write,dht-peer}.stdout | tail -17 | cut -c1-400\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1185,1215p;1260,1325p' ../datomworld/src/cljc/yin/repl/main.cljc\nsed -n '137,217p' ../datomworld/src/jolt/dao/stream/waitset/driver.jolt\nrg -n 'defn.*(step|pump)|:pump|udp' ../datomworld/src/cljc/yin/shell/dht.cljc | tail -25\nrg -n 'dht:.*(acknowledge|error)|\"'^yin> '\"' build/gambit-dht-durable/run.j7uxsgri/{dht-write,dht-peer}.stdout | tail -17 | cut -c1-400\"","aggregated_output":"       (print prompt)\n       (flush))\n\n     (defn poll-loop!\n       \"JVM policy wrapper around the portable serial owner.\"\n       ([state server headless?]\n        (poll-loop! state server headless? #(.halt (Runtime/getRuntime) 0)))\n       ([state server headless? exit!]\n        (poll-loop! state server headless? exit! (wake/make-wake)))\n       ([state server headless? exit! w]\n        (run-owner! state server headless? #(System/currentTimeMillis)\n                    #(wake/sleep! w %)\n                    (fn [status]\n                      (if (zero? status) (exit!)\n                          (.halt (Runtime/getRuntime) (int status)))))))\n\n     (defn- read-loop!\n       \"The reader parks in `read-line` and appends, nudging the step owner's\n        wake: a typed line ends the idle sleep at once.  It reads no state.\"\n       [input w]\n       (loop []\n         (if-let [line (read-line)]\n           (do (driver/submit-line! input line)\n               (wake/nudge! w)\n               (recur))\n           (do (driver/submit-line! input \"(quit)\")\n               (wake/nudge! w)))))\n\n     (defn main!\n       \"The JVM entry point body: compose from `args` and this host's\n        `composition`, print the banner, and run the reader thread beside\n                     ;; is unbounded: lines read before end-of-input still\n                     ;; evaluate ahead of its `(quit)`, and the step owner bounds\n                     ;; its own shutdown drain (`stop-ticks`) and exits the\n                     ;; process itself.\n                     (read-loop! (:input state) w)\n                     (.join poller))))\n             (.halt (Runtime/getRuntime) 0)))))\n\n     (defn -main\n       \"The engine's own JVM entry point: the `mem` and `file:<dir>` stores\n        and no storage composition.  The shipped product entry point is\n        `yin.shell.main/-main`, which supplies one.\"\n       [& args]\n       (main! args nil))))\n\n\n#?(:jolt\n   (do\n     (defn main!\n       \"One plain-thread owner. Stdin deposits only; EOF deposits (quit).\n        One host WebSocket instance serves the shell, a storage\n        composition's own endpoints and --port; every owner round polls its\n        sockets (headless included) and the instance is closed before exit,\n        however the drain ended.  Saved flags persist in the node\n        directory, as on the JVM (J4d): --reset forgets them and --no-state\n        neither reads nor writes them.\n\n        `composition` is the plain-data contribution of a storage\n        composition, nil for a host that carries none.\"\n       [args composition]\n       (let [adapter (host/websocket)\n             started (startup args {:persist? true :adapter adapter\n                                    :composition composition})]\n         (when (contains? started :exit) (exit-with! started))\n         (if-some [refusal (:refusal started)]\n           (refuse! refusal)\n           (let [{:keys [opts state server]} started\n                 headless? (boolean (:headless? opts))\n                 eof? (atom false)\n                 w (wake/make-wake)\n                 line! (fn [line]\n                         (if (nil? line)\n                           (do (reset! eof? true)\n                               (driver/submit-line! (:input state) \"(quit)\"))\n                           (driver/submit-line! (:input state) line)))\n                 sleep! (fn [ms]\n                          (wake/sleep-fds! w ms (:pump adapter)\n                                           (when-not (or headless? @eof?) line!)))]\n             (doseq [line (banner opts composition)] (println line))\n             (when-not headless? (print prompt))\n             (flush)\n             ;; the exit status leaves through System/exit, which skips the\n             ;; finally, so the exit path closes the instance itself too\n             (try\n               (run-owner! state server headless? #(System/currentTimeMillis)\n                           sleep! (fn [status]\n                                    ((:close-host! adapter))\n                                    (wake/close! w)\n                                    (flush)\n                                    (System/exit status)))\n               (finally\n                 ((:close-host! adapter))\n                 (wake/close! w)))))))\n\n     (defn -main\n       \"The engine's own jolt entry point: the `mem` and `file:<dir>` stores\n  \"Deposit a held unterminated last line, as read-line answers it, then\n   nil.\"\n  [wake line!]\n  (let [held @(:stdin wake)]\n    (reset! (:stdin wake) (byte-array 0))\n    (when (pos? (alength held)) (line! (decode-line held)))\n    (line! nil)))\n\n\n(defn- read-stdin!\n  \"One read(2) of fd 0, which poll reported ready. Answers true when it\n   deposited or reached end of input.\"\n  [wake line!]\n  (let [buf (ffi/alloc stdin-chunk)]\n    (try\n      (let [n (c-read 0 buf stdin-chunk) e (ffi/errno)]\n        (cond\n          (pos? n) (do (deposit-lines! wake (ffi/read-array buf n) line!) true)\n          (and (neg? n) (or (poller/eintr? e) (poller/eagain? e))) false\n          ;; zero, or a descriptor that cannot be read (closed fd 0): end\n          :else (do (end-of-input! wake line!) true)))\n      (finally (ffi/free buf)))))\n\n\n;; =============================================================================\n;; One owner round\n;; =============================================================================\n\n(defn sleep-fds!\n  \"One owner round's wait (plan v2 A1): poll the wake pipe, fd 0 (when\n   `line!` is given) and `pump`'s interest descriptors (when `pump` is\n   given) until one is ready or the earlier of `sleep-ms` and the pump's\n   `:deadline` (`jolt.io-poller/clock-ms`; nil, or a pump without one, is\n   the cadence alone) passes; then drain the wake pipe, run one\n   `(:pump! pump)` turn over the observed `[[fd revents] ...]` (every\n   round; `[]` after a timeout), then deposit stdin lines through `line!`\n   (nil at end of input). A deadline already due still polls once, with a\n   zero timeout, so readiness seen then reaches the same `pump!` turn as\n   the expiry. Never evaluates. Answers truthy when anything was woken,\n   moved or deposited.\"\n  [wake sleep-ms pump line!]\n  (let [interest (if pump (vec ((:interest pump))) [])\n        base (if line! 2 1)\n        n (+ base (count interest))\n        fds (native/alloc-pollfds n)\n        cadence (poller/deadline-ms sleep-ms)\n        due (when-let [f (:deadline pump)] (f))\n        deadline (if due (min due cadence) cadence)]\n    (try\n      (native/init-pollfd! fds 0 (:read wake) native/pollin)\n      (when line! (native/init-pollfd! fds 1 0 native/pollin))\n      (dotimes [i (count interest)]\n        (let [[fd events] (nth interest i)]\n          (native/init-pollfd! fds (+ base i) fd events)))\n      (loop []\n        (let [remaining (max 0 (long (Math/ceil (- deadline (poller/clock-ms)))))\n              [rc e] (native/c-poll fds n remaining)]\n          (cond\n            (and (neg? rc) (native/eintr? e)) (recur)\n            (neg? rc) (throw (ex-info \"owner poll failed\" {:errno e}))\n            :else nil)))\n      (let [ready (vec (keep (fn [i]\n                               (let [rev (native/pollfd-revents fds (+ base i))]\n                                 (when (pos? rev) [(first (nth interest i)) rev])))\n                             (range (count interest))))\n            woken? (drain! wake)\n            progressed? (when pump (:progressed? ((:pump! pump) ready)))\n            stdin? (when (and line! (pos? (native/pollfd-revents fds 1)))\n                     (read-stdin! wake line!))]\n        (or woken? progressed? stdin?))\n      (finally (ffi/free fds)))))\n\n\n(defn sleep-input!\n  \"Wait for a nudge, stdin, or the cadence deadline. `line!` only deposits\n   lines (nil at EOF). Never evaluate from this seam.\"\n  [wake sleep-ms line!]\n  (sleep-fds! wake sleep-ms nil line!))\n929:(defn- step-board\n1045:(defn- step-link\n1084:(defn- step-links\n1241:(defn- step-follow\n1291:(defn step\nbuild/gambit-dht-durable/run.j7uxsgri/dht-peer.stdout:479:yin> dht: node 21566f37a56dcc0d listening on 127.0.0.1:65194; peers: 127.0.0.1:60773; fetch-only\nbuild/gambit-dht-durable/run.j7uxsgri/dht-peer.stdout:480:yin> 'p2.probe\nbuild/gambit-dht-durable/run.j7uxsgri/dht-peer.stdout:481:yin> dht: published :segment/blake3-d30811c7599ec8f84e532d9ad67e592fb5f90f1deece5bd72f707c7129ffb5d0 (8 blobs), NOT acknowledged: publication is off: this node fetches only; start with --dht-publish to share; 8 of 8 blobs not sent; not retrying (every remaining failure is final); the local copy is durable\nbuild/gambit-dht-durable/run.j7uxsgri/dht-peer.stdout:482:yin> :missing\nbuild/gambit-dht-durable/run.j7uxsgri/dht-peer.stdout:483:yin> dht: published :segment/blake3-d5c6f21dad4da8405433e9235c9b84af0d6e306e43a5fe6ac09f85c8cf00c979 (10 blobs), NOT acknowledged: publication is off: this node fetches only; start with --dht-publish to share; 10 of 10 blobs not sent; not retrying (every remaining failure is final); the local copy is durable\nbuild/gambit-dht-durable/run.j7uxsgri/dht-peer.stdout:484:yin> \nbuild/gambit-dht-durable/run.j7uxsgri/dht-write.stdout:481:yin> dht: node d1a14104917ebb64 listening on 127.0.0.1:60773; peers: 127.0.0.1:65194; publishing\nbuild/gambit-dht-durable/run.j7uxsgri/dht-write.stdout:482:yin> 'p2.probe\nbuild/gambit-dht-durable/run.