lower.cljc-3091-        body (if (seq checks) (u/then (u/seq-nodes checks) body) body)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3092-        body (if has-return? (app* 'php/call-ec (u/lam ['%ret] body)) body)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3093-        cvs (concat (map :name params) (map :name captures) static-names-v locals)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3094-        body (if counted?\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3095-               (app* 'php/try-finally\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3096-                     (u/lam [] body)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3097-                     (u/lam ['%x]\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3098-                            (if dyn?\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3099-                              (app* 'php/scope-release! (u/v '%scope))\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc:3100:                              (app* 'php/release-cvs\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3101-                                    (args-vector (map #(u/v (symbol %)) cvs))\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3102-                                    (u/lit 0)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3103-                                    (u/lit (count cvs))))))\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3104-               (if (seq cvs)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3105-                 ;; no references or statics: release on the normal exit only (an\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3106-                 ;; error leaves the counts high, which is safe)\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3107-                 (let [rv (core/gen \\\\\\\\\\\\\\\"rv\\\\\\\\\\\\\\\" n)]\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3108-                   (u/let1 rv\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc-3109-                           body\\\\\\\\nsrc/cljc/yang/php/antlr/lower.cljc:3110:                           (u/then (app* 'php/rel