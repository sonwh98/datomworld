{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/zsh -lc \"set -eu\ncat >build/p2final/transport-check.ss <<'EOF'\n(##include \\\"../../host/gambit/yin-repl-boot.ss\\\")\n(define fixture\n  (path-expand \\\"transport-check.jolt\\\" (path-directory (this-source-file))))\n(gambit-yin-launch\n  (lambda (load-ns args)\n    (jolt-with-ns-bound\n      (lambda () (gambit-load-source-file \\\"p2final.transport-check\\\" fixture)))\n    (if (apply jolt-invoke (var-deref \\\"p2final.transport-check\\\" \\\"run\\\")\n               (map string->number args))\n        (exit 0)\n        (exit 1))))\nEOF\ncat >build/p2final/transport-check.jolt <<'EOF'\n(ns p2final.transport-check\n  (:require [dao.jing :as jing]\n            [dao.jing.dht :as dht]\n            [dao.space.dht :as space]\n            [dao.stream.udp :as udp]\n            [yin.repl.store :as store]))\n\n(defn traced-bind [label opts]\n  (update (udp/bind\"'! opts) :send!\n          (fn [send!]\n            (fn [host port payload]\n              (let [message (dht/decode-message payload)\n                    outcome (send! host port payload)]\n                (prn :wire label (select-keys message [:op :q :need-cookie :ok]) (:dao.stream/outcome outcome))\n                outcome)))))\n\n(defn node [label port peer]\n  (space/join {:local (store/open :mem)\n               :publish? true\n               :bind-port port\n               :peers [{:host \"127.0.0.1\" :port peer}]\n               :bind! (partial traced-bind label)}))\n\n(defn run [a-port b-port]\n  (let [a (node :a a-port b-port)\n        b (node :b b-port a-port)\n        witness {:p2final \"loopback diagnostic\"}\n        address (jing/materialize! (space/store a) witness)]\n    (try\n      (loop [a-step a, b-step b, i 0]\n        (let [[aa _] (space/step a-step (* i 5))\n              [bb _] (space/step b-step (* i 5))]\n          (cond\n            (= (jing/get (space/local bb) address nil) witness)\n            (do (prn :loopback-replicated i address) true)\n            (= i 60) (do (prn :loopback-not-replicated) false)\n            :else (recur aa bb (inc i)))))\n      (finally (space/close! a) (space/close! b)))))\nEOF\nports=$(python3 - <<'\"'PY'\nfrom socket import AF_INET, SOCK_DGRAM, socket\nwith socket(AF_INET, SOCK_DGRAM) as first, socket(AF_INET, SOCK_DGRAM) as second:\n    for port in (first, second):\n        port.bind(('127.0.0.1', 0))\n    print(first.getsockname()[1], second.getsockname()[1])\nPY\n)\nprefix=\\\"\"'$HOME/.local/share/mise/installs/gambit/4.9.8\"\nJOLT_GAMBIT_YIN_MODE=compiled JOLT_TRACE_SOURCE=1 caffeinate -i sh host/gambit/ffi/watchdog.sh 420 \"$prefix/bin/gsi\" build/p2final/transport-check.ss \"$(cd ../datomworld && pwd)\" ${=ports} >build/p2final/transport-check.log 2>build/p2final/transport-check.stderr'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
