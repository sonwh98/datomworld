114\\\\t                  :lower python.antlr.repl/lower,\\\\n   115\\\\t                  :primitives python.antlr.repl/primitives,\\\\n   116\\\\t                  :lower-session python.antlr.repl/lower-session,\\\\n   117\\\\t                  :render python.antlr.repl/display-value,\\\\n   118\\\\t                  :probe python.antlr.probe/probe})]\\\\n   119\\\\t        :default [true (frontend/install\\\\n   120\\\\t                         (antlr-manifest)\\\\n   121\\\\t                         {:parse (fn [source]\\\\n   122\\\\t                                   (python.antlr.parser/parse-source (str source \\\\\\\"\\\\\\\\n\\\\\\\"))),\\\\n   123\\\\t                          :lower python.antlr.repl/lower,\\\\n   124\\\\t                          :primitives python.antlr.repl/primitives,\\\\n   125\\\\t                          :lower-session python.antlr.repl/lower-session,\\\\n   126\\\\t                          :render python.antlr.repl/display-value,\\\\n   127\\\\t                          :probe python.antlr.probe/probe})])))\\\\n   128\\\\t\\\\n   129\\\\t\\\\n   130\\\\t(defn create-state\\\\n   131\\\\t  \\\\\\\"`yin.repl/create-state` composed with the standard catalog unless the\\\\n   132\\\\t   host supplies its own `:frontends`.  Each binding registers its own\\\\n   133\\\\t   `:primitives`; none is merged ambiently.\\\\\\\"\\\\n   134\\\\t  ([] (create-state {}))\\\\n   135\\\\t  ([opts]\\\\n   136\\\\t   (repl/create-state (update opts :frontends #(or % (standard))))))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_34\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The terminal escape bypasses guest handlers and finalizers as intended. The out-of-scope `fesc` also creates a free name in the linked PHP module, so the bundled safepoint tests do not establish that includes still work. The P5 diagnostics need separate rulings: missing diagnost