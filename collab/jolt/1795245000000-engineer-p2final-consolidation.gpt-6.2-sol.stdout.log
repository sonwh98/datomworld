":\\\\n        target = getattr(args, \\\\\\\"target\\\\\\\", \\\\\\\"main...HEAD\\\\\\\")\\\\n        output = getattr(args, \\\\\\\"output\\\\\\\", None)\\\\n        fmt = getattr(args, \\\\\\\"format\\\\\\\", \\\\\\\"markdown\\\\\\\")\\\\n        repo_dir = getattr(args, \\\\\\\"repo-dir\\\\\\\", None)\\\\n\\\\n        try:\\\\n            summary = analyze_git_target(target, repo_dir=repo_dir)\\\\n\\\\n            if fmt == \\\\\\\"json\\\\\\\":\\\\n                result = json.dumps(asdict(summary), indent=2)\\\\n            else:\\\\n                result = generate_markdown_report(summary)\\\\n\\\\n            if output:\\\\n                out_path = Path(output)\\\\n                out_path.parent.mkdir(parents=True, exist_ok=True)\\\\n                out_path.write_text(result, encoding=\\\\\\\"utf-8\\\\\\\")\\\\n                print(f\\\\\\\"✅ Review report written to: {out_path.resolve()}\\\\\\\")\\\\n            else:\\\\n                print(result)\\\\n\\\\n        except Exception as e:\\\\n            sys.stderr.write(f\\\\\\\"Error during PR analysis: {e}\\\\\\\\n\\\\\\\")\\\\n            sys.exit(1)\\\\n\\\\n\\\\nif __name__ == \\\\\\\"__main__\\\\\\\":\\\\n    main()\\\\n?? .flutter-plugins-dependencies\\\\n?? collab/1793546000000-engineer-node-shard-uncovered-skip.kimi-k3.1-pro.findings.md\\\\n?? collab/1793546000000-engineer-node-shard-uncovered-skip.kimi-k3.1-pro.stdout.log\\\\n?? collab/1793546000000-engineer-node-shard-uncovered-skip.prompt.md\\\\n?? collab/orch-lane/1794400000000-architect-eval-bridge-design.gpt-6.1-sol.stdout.log\\\\n?? collab/orch-lane/1794410000000-engineer-p8-manifest-repair.muse-spark-1.3.stdout.log\\\\n?? collab/orch-lane/1794430000000-engineer-p8-manifest-repair.muse-spark-1.3-contributor.stdout.log\\\\n?? collab/orch-lane/1794450000000-engineer-p8-manifest-repair-r2.muse-spark-1.3-contributor.stdout.log\\\\n?? collab/orch-lane/1794470000000-engineer-p8-manifest-repair-r3.muse-spark-1.3-contributor.stdout.log\\\\