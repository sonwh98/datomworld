  :php (php-ast source))\\\\n   198\\\\t             datoms (vec (vm/ast->datoms ast))\\\\n   199\\\\t             walker (load-program! datoms)]\\\\n   200\\\\t         (swap! app-state assoc\\\\n   201\\\\t                :ast ast\\\\n   202\\\\t                :datoms datoms\\\\n   203\\\\t                :walker walker\\\\n   204\\\\t                :walker-running false\\\\n   205\\\\t                :walker-result nil\\\\n   206\\\\t                :steps 0\\\\n   207\\\\t                :error nil))\\\\n   208\\\\t       (catch :default e\\\\n   209\\\\t         (swap! app-state assoc\\\\n   210\\\\t                :error (str \\\\\\\"Compile error: \\\\\\\" (.-message e))\\\\n   211\\\\t                :ast nil\\\\n   212\\\\t                :datoms nil\\\\n   213\\\\t                :walker nil\\\\n   214\\\\t                :walker-running false\\\\n   215\\\\t                :walker-result nil))))\\\\n   216\\\\t\\\\n   217\\\\t\\\\n   218\\\\t(defn reset-walker!\\\\n   219\\\\t  []\\\\n   220\\\\t  (let [{:keys [datoms]} @app-state]\\\\n   221\\\\t    (when (seq datoms)\\\\n   222\\\\t      (stop-run-loop!)\\\\n   223\\\\t      (swap! app-state assoc\\\\n   224\\\\t             :walker (load-program! datoms)\\\\n   225\\\\t             :walker-running false\\\\n   226\\\\t             :walker-result nil\\\\n   227\\\\t             :steps 0\\\\n   228\\\\t             :error nil))))\\\\n   229\\\\t\\\\n   230\\\\t\\\\n   231\\\\t(defn- step-state\\\\n   232\\\\t  \\\\\\\"One step as a pure state transition, shared by `step-walker!` and\\\\n   233\\\\t   `run-frame!`'s inner loop.\\\\\\\"\\\\n   234\\\\t  [state]\\\\n   235\\\\t  (let [vm (:walker state)]\\\\n    45\\\\t\\\\n    46\\\\t\\\\n    47\\\\t(defn- antlr-manifest\\\\n    48\\\\t  []\\\\n    49\\\\t  (assoc (manifest :yang/python :python)\\\\n    50\\\\t         :yang.frontend/revision \\\\\\\"f4\\\\\\\"\\\\n    51\\\\t         :yang.frontend/grammar\\\\n    52\\\\t         {:yang.grammar/package \\\\\\\"python3\\\\\\\",\\\\n    53\\\\t          :yang.grammar/entries {:module \\\\\\\"file_input\\\\\\\"},\\\\n    54\\\\t          :yang.grammar/export-profile :yang.cst/v1,\\\\n    55\\\\t          :yang.grammar/targets #{:java :javascript :dart}}))\\\\n    56\\\\t\\\\n    57\\\\t\\\\n    58\\\\t(defn php-manifest\\\\n    59\\\\t  []\\\\n    60\\\\t  (assoc (manifest :yang/php :php)\\\\n    61\\\\t         :yang.frontend/revision \\\\\\\"antlr-p8\\\\\\\"\\\\n    62\\\\t         :yang.frontend/grammar\\\\n    63\\\\t         {:yang.grammar/package \\\\\\\"php\\\\\\\",\\\\n    64\\\\t          :yang.grammar/entries {:module \\\\\\\"htmlDocument\\\\\\\"},\\\\n    65\\\\t          :yang.grammar/export-profile :yang.cst/v1,\\\\n    66\\\\t          :yang.grammar/targets #{:java :javascript}}\\\\n    67\\\\t         :yang.frontend/lowering-profile :yang.php/antlr\\\\n    68\\\\t         :yang.frontend/runtime-profile :yang.php/antlr\\\\n    69\\\\t         :yang.frontend/support-profile :yang.php/antlr))\\\\n    70\\\\t\\\\n    71\\\\t\\\\n    72\\\\t(defn standard\\\\n    73\\\\t  \\\\\\\"The standard catalog. The Clojure frontend consumes the forms the\\\\n    74\\\\t   shell's own reader read, so its parse stage is the identity. The ANTLR\\\\n    75\\\\t   frontends show what a submission printed and the value their `:render`\\\\n    76\\\\t   returns.\\\\\\\"\\\\n    77\\\\t  []\\\\n    78\\\\t  (cond-> frontend/empty-catalog\\\\n    79\\\\t    true (frontend/install (manifest :yang/clojure :clojure)\\\\n    80\\\\t                           {:input :forms,\\\\n    81\\\\t                            :parse identity,\\\\n    82\\\\t                            :lower clojure-lower})\\\\n    83\\\\t    #?@(:clj [true (frontend/install\\\\n    84\\\\t                     (php-manifest)\\\\n    85\\\\t                     {:parse php.antlr.cst/parse-source,\\\\n    86\\\\t                      :lower php.antlr.lower/lower-packet,\\\\n    87\\\\t                      :