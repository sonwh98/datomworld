{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,103p' test/gambit/fixtures/yin-dht-probe.jolt\nsed -n '272,399p' ../datomworld/src/jolt/dao/stream/udp.jolt\nsed -n '1410,1475p' ../datomworld/src/cljc/dao/space/dht.cljc\"","aggregated_output":";; Evaluated in jolt.gambit.yin by the diagnostic driver after startup.\n;; Each attempted operation gets its own reply from the real Yin session.\n(require '[dao.stream :as p1e-stream]\n         '[dao.stream.ringbuffer :as p1e-ring]\n         '[jolt.scheme :as p1e-scheme])\n\n(def ^:private p1e-var (p1e-scheme/proc \"var-deref\"))\n(def ^:private p1e-memory (atom nil))\n(def ^:private p1e-session-store (atom nil))\n(def ^:private p1e-requests (atom nil))\n(def ^:private p1e-value {:p1e \"yin-dht-local-round-trip\" :count 3})\n\n(defn- p1e-call [namespace var-name & args]\n  ;; Defer each dependency so a failed load becomes a reply at the prompt.\n  (require (symbol namespace))\n  (apply (p1e-var namespace var-name) args))\n\n(defn- p1e-make-ring []\n  (:dao.stream/handle\n    (p1e-ring/create! {:dao.stream/type p1e-ring/transport-type\n                      p1e-ring/capacity-key 8})))\n\n(defn- p1e-next [ring cursor]\n  (p1e-stream/next ring (:dao.stream/cursor cursor)))\n\n(defn- p1e-open-memory []\n  (let [requests (p1e-make-ring)\n        handle (p1e-call \"dao.jing.dht\" \"store-handle\"\n                         {:local (store/open :mem) :requests requests})]\n    (reset! p1e-memory handle)\n    (reset! p1e-requests requests)\n    :memory-dht-handle-opened))\n\n(defn- p1e-check-request []\n  (let [requests @p1e-requests\n        result (p1e-next requests (p1e-stream/cursor requests :dao.stream/oldest))]\n    (:dao.stream/value result)))\n\n(defn- p1e-loopback []\n  (let [traffic (p1e-make-ring)\n        cursor (p1e-stream/cursor traffic :dao.stream/oldest)\n        seam (p1e-call \"dao.stream.udp\" \"bind!\"\n                       {:identity \"p1e-loopback\" :deposit traffic\n                        :bind-host \"127.0.0.1\" :bind-port 0})]\n    (try\n      (let [bound (p1e-next traffic cursor)\n            local (get-in bound [:dao.stream/value :dao.stream.datagram/local])\n            port (:dao.stream.datagram/port local)\n            payload (byte-array [42 -1 0])]\n        (when-not (and (= \"127.0.0.1\" (:dao.stream.datagram/host local))\n                       (integer? port) (pos? port))\n          (throw (ex-info \"UDP loopback did not bind\" {:bound bound})))\n        (let [sent ((:send! seam) \"127.0.0.1\" port payload)\n              received (loop [attempts 16]\n                         (let [step ((:step! seam))\n                               rx (p1e-next traffic bound)]\n                           (if (or (:progressed? step) (zero? attempts))\n                             rx\n                             (recur (dec attempts)))))\n              packet (:dao.stream/value received)]\n          ((:close! seam))\n          (let [closed (:dao.stream/value (p1e-next traffic received))]\n            (if (and (= :dao.stream/ok (:dao.stream/outcome sent))\n                     (= \"Kv8A\" (:dao.stream.datagram/bytes packet))\n                     (= local (:dao.stream.datagram/source packet))\n                     (= :dao.stream.datagram/closed (:dao.stream.datagram/event closed)))\n              [:udp-loopback-ok (:dao.stream.datagram/bytes packet) :closed]\n              (throw (ex-info \"UDP loopback did not round trip\"\n                              {:sent sent :packet packet :closed closed}))))))\n      (finally\n        ((:close! seam))))))\n\n(defn- p1e-session-round-trip []\n  (let [handle @p1e-session-store\n        address (jing/segment-key p1e-value)]\n    (when (and handle\n               (= :missing (jing/get handle address :missing))\n               (= address (jing/materialize! handle p1e-value))\n               (= p1e-value (jing/get handle address :missing)))\n      [:dht-index-put-get address p1e-value])))\n\n(defn- p1e-run [op]\n  (case op\n    :memory-open (p1e-open-memory)\n    :memory-put (if-let [handle @p1e-memory]\n                  (jing/materialize! handle p1e-value)\n                  :blocked-no-memory-dht-handle)\n    :memory-get (if-let [handle @p1e-memory]\n                  (jing/get handle (jing/segment-key p1e-value) :missing)\n                  :blocked-no-memory-dht-handle)\n    :replicate-request (= (jing/segment-key p1e-value)\n                          (:dao.jing.dht/replicate (p1e-check-request)))\n    :session-round-trip (p1e-session-round-trip)\n    :udp-loopback (p1e-loopback)\n    :udp-native-load (do (require 'jolt.socket.native) :socket-native-loaded)\n    :c4-control ((p1e-scheme/proc \"joltffi-public-blocking-raise\"))\n    :close (do (jing/close! @p1e-memory) :closed)))\n\n(defn- p1e-activate [registry]\n  (module/register-host-module\n    registry 'p1e.probe\n    {'run p1e-run}\n    {'run (vm/primitive-profile 'run :pure [1] #{} :none)}))\n                                            (when (compare-and-set! closed? false true)\n                                              (try (poller/cancel! fd) (catch Throwable _ nil))\n                                              (try (poller/forget! fd) (catch Throwable _ nil))\n                                              (native/c-close fd)\n                                              (deposit-event! deposit (datagram/closed-event identity)))\n                                            nil)\n\n                                          send-fn\n                                          (fn [dest-host dest-port ^bytes payload]\n                                            (if @closed?\n                                              {:dao.stream/outcome :dao.stream/closed}\n                                              (let [parsed-dest (parse-literal-host dest-host)]\n                                                (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))\n                                                  (let [reason \"IP family mismatch\"]\n                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                    {:dao.stream/outcome :dao.stream/transport-error\n                                                     :dao.stream.datagram/reason reason})\n                                                  (let [len (bytes/length payload)\n                                                        buf (ffi/alloc (max 1 len))]\n                                                    (try\n                                                      (let [[dsa dlen] (native/make-sockaddr family (:ip parsed-dest) dest-port)]\n                                                        (try\n                                                          (if-not dsa\n                                                            (let [reason \"make-sockaddr failed for destination\"]\n                                                              (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                              {:dao.stream/outcome :dao.stream/transport-error\n                                                               :dao.stream.datagram/reason reason})\n                                                            (do\n                                                              (when (pos? len)\n                                                                (ffi/write-array buf payload))\n                                                              (let [[n e] (*sendto* fd buf len 0 dsa dlen)]\n                                                                (cond\n                                                                  (neg? n)\n                                                                  (let [reason (str \"sendto failed: errno \" e)]\n                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                                    {:dao.stream/outcome :dao.stream/transport-error\n                                                                     :dao.stream.datagram/reason reason})\n\n                                                                  (not= n len)\n                                                                  (let [reason (str \"short send: sent \" n \" of \" len \" bytes\")]\n                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                                    {:dao.stream/outcome :dao.stream/transport-error\n                                                                     :dao.stream.datagram/reason reason})\n\n                                                                  :else\n                                                                  {:dao.stream/outcome :dao.stream/ok}))))\n                                                          (finally\n                                                            (when dsa (ffi/free dsa)))))\n                                                      (finally\n                                                        (ffi/free buf))))))))\n\n                                          step-fn\n                                          (fn []\n                                            (if @closed?\n                                              {:progressed? false}\n                                              (let [cap (inc max-bytes)\n                                                    buf (ffi/alloc cap)]\n                                                (try\n                                                  (let [[rsa rlenp] (native/alloc-sockaddr)]\n                                                    (try\n                                                      (let [progressed? (volatile! false)]\n                                                        (loop [budget 64]\n                                                          (when (pos? budget)\n                                                            (ffi/write rlenp :int native/sockaddr-storage-size 0)\n                                                            (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]\n                                                              (cond\n                                                                (neg? n)\n                                                                (cond\n                                                                  ;; would-block: silent\n                                                                  (or (= e EAGAIN) (= e ENOBUFS))\n                                                                  nil\n\n                                                                  ;; interruption: recoverable, no retry inside turn\n                                                                  (= e EINTR)\n                                                                  (swap! diagnostics conj\n                                                                         {:kind :interrupted\n                                                                          :errno e\n                                                                          :reason (str \"recvfrom interrupted: errno \" e)})\n\n                                                                  ;; genuine descriptor error: close seam once\n                                                                  (or (= e EBADF) (= e ENOTSOCK) (= e EPIPE))\n                                                                  (do\n                                                                    (swap! diagnostics conj\n                                                                           {:kind :fatal-descriptor-error\n                                                                            :errno e\n                                                                            :reason (str \"recvfrom fatal error: errno \" e)})\n                                                                    (close-fn))\n\n                                                                  ;; asynchronous/non-fatal error: record diagnostic, seam stays open\n                                                                  :else\n                                                                  (swap! diagnostics conj\n                                                                         {:kind :receive-error\n                                                                          :errno e\n                                                                          :reason (str \"recvfrom error: errno \" e)}))\n\n                                                                :else\n                                                                (do\n                                                                  (vreset! progressed? true)\n                                                                  (if (> n max-bytes)\n                                                                    ;; Oversize drop\n                                                                    (recur (dec budget))\n                                                                    (let [bs (if (zero? n)\n                                                                               (bytes/alloc 0)\n                                                                               (ffi/read-array buf n))\n                                                                          src-ip (native/sockaddr-ip rsa)\n                                                                          src-port (native/sockaddr-port rsa)]\n                                                                      (deposit-event! deposit\n                                                                                      (datagram/datagram-event identity src-ip src-port bs))\n                                                                      (recur (dec budget)))))))))\n                                                        {:progressed? @progressed?})\n                                                      (finally\n                                                        (when rsa (ffi/free rsa))\n                                                        (when rlenp (ffi/free rlenp)))))\n                                                  (finally\n                                                    (ffi/free buf))))))\n\n                                          seam {:send! send-fn\n                                                :close! close-fn\n                                                :step! step-fn\n                                                :diagnostics diagnostics\n                                                :diagnostic (fn [] (last @diagnostics))}]\n                                      (deposit-event! deposit (datagram/bound-event identity (:ip local) (:port local)))\n                                      seam))))))))))))\n              (catch Throwable t\n                (close-fd!)\n                (failed-seam deposit identity (or (ex-message t) (str t)))))))))))\n                                      [node (into events more)]))\n                                  [(assoc node :client state) []]\n                                  loading)]\n        ;; every load waiting on an address has read its miss cause: keep\n        ;; only the causes of addresses still being fetched\n        [(update node :misses select-keys (fetching node)) events]))))\n\n\n;; =============================================================================\n;; The public step and reads\n;; =============================================================================\n\n(defn step\n  \"Advance the node once at the owner's millisecond reading `now`:\n   append it as a tick; finish binding; admit repairs, then the puts and\n   announcements on the ledger ring; release replicate requests; step\n   the DHT; apply its facts; advance loads; and report publications.\n   Answers `[node' events]`.  A refused node (its socket could not bind)\n   is answered unchanged.\"\n  [node now]\n  (if (:refusal node)\n    [node []]\n    (let [_ (when-let [step-fn (get-in node [:seam :step!])]\n              (step-fn))\n          node (tick node now)\n          [node bound] (bind-step node)\n          node (admit-repairs node)\n          [node unknown] (admit-ledger node)\n          node (release node)\n          node (cond-> node (:dht node) (update :dht dht/step step-budget))\n          [node lost] (read-facts node)\n          [node loaded] (advance-loads node)\n          [node reported] (settle-publications node)]\n      [node (-> bound (into unknown) (into lost) (into loaded) (into\n                                                                 reported))])))\n\n\n(defn refusal\n  \"Why the node stopped (its socket could not bind), or nil.\"\n  [node]\n  (:refusal node))\n\n\n(defn backlog\n  \"What the node retains now: queue entries (`:fresh`, `:repair`),\n   requests outstanding (`:outstanding`, split `:outstanding-fresh` and\n   `:outstanding-repair`), live publications (`:live`), those awaiting a\n   first report (`:open`) and repairing (`:repairing`), and the ledger\n   entries they hold (`:ledger-entries`).\"\n  [node]\n  {:fresh (count (:fresh node))\n   :repair (count (:repair node))\n   :outstanding (count (:inflight node))\n   :outstanding-fresh (in-flight node :fresh)\n   :outstanding-repair (in-flight node :repair)\n   :live (count (:pubs node))\n   :open (open-count node)\n   :repairing (count (filter repairing? (:pubs node)))\n   :ledger-entries (reduce + 0 (map :blobs (:pubs node)))})\n\n\n(defn- summary\n  [node pub]\n  {:manifest (:manifest pub)\n   :blobs (:blobs pub)\n   :sent (:sent pub)\n","exit_code":0,"status":"completed"}}
