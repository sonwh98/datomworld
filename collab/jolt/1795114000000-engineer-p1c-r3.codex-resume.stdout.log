 0 (+ j 1))) ((= j 16))\n            (vector-set! next j (vector-ref m (vector-ref blake3-permutation j))))\n          (round next (+ i 1)))))\n    (let ((out (make-vector 8)))\n      (do ((i 0 (+ i 1))) ((= i 8) out)\n        (vector-set! out i (bitwise-xor (vector-ref v i) (vector-ref v (+ i 8))))))))\n\n(define (blake3-chunk bytes from end counter)\n  (let loop ((at from) (cv blake3-iv))\n    (let* ((size (min 64 (- end at)))\n           (last? (= (+ at size) end))\n           (flags (+ (if (= at from) 1 0) (if last? 2 0)))\n           (words (make-vector 16 0)))\n      (do ((i 0 (+ i 1))) ((= i size))\n        (let ((word (quotient i 4)))\n          (vector-set! words word\n            (bitwise-ior (vector-ref words word)\n                         (arithmetic-shift (u8vector-ref bytes (+ at i)) (* 8 (modulo i 4)))))))\n      (if last?\n          (list cv words counter size flags)\n          (loop (+ at size) (blake3-compress cv words counter size flags))))))\n\n(define (blake3-parent left right)\n  (list blake3-iv (vector-append left right) 0 64 4))\n\n(define (gambit-yin-blake3 bytes)\n  (define (merge cv count stack)\n    (if (odd? count)\n        (cons cv stack)\n        (merge (apply blake3-compress (blake3-parent (car stack) cv))\n               (quotient count 2)\n               (cdr stack))))\n  (let ((n (u8vector-length bytes)))\n    (let loop ((from 0) (counter 0) (stack '\"'()))\n      (let* ((end (min n (+ from 1024)))\n             (output (blake3-chunk bytes from end counter)))\n        (if (< end n)\n            (loop end (+ counter 1)\n                  (merge (apply blake3-compress output) (+ counter 1) stack))\n            (let root ((output output) (left stack))\n              (if (pair? left)\n                  (root (blake3-parent (car left) (apply blake3-compress output)) (cdr left))\n                  (let* ((words (blake3-compress (car output) (cadr output) 0\n                                                 (cadddr output) (+ 8 (list-ref output 4))))\n                         (digest (make-u8vector 32)))\n                    (do ((i 0 (+ i 1))) ((= i 32) digest)\n                      (u8vector-set\"'! digest i\n                        (bitwise-and 255 (arithmetic-shift (vector-ref words (quotient i 4))\n                                                          (- (* 8 (modulo i 4)))))))))))))))\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('host/gambit/yin/dao/host/hash.jolt')\ns=p.read_text().replace(\\\"Gambit's memory-store digest boundary. Constructing the store needs no\\\\n   crypto. A digest request reaches the adapter's blocking FFI refusal.\\\", \\\"Gambit supplies BLAKE3 in process for Yin's content addresses.\\\\n   SHA-256 still uses the blocking FFI boundary.\\\")\ns=s.replace('(defn- digest [entry bs]', '(def \"'^:private blake3 (scheme/proc \"gambit-yin-blake3\"))'\"\\\\n\\\\n(defn- check-bytes\"'! [entry bs]'\"').replace(':dao.host/entry entry})))\\\\n  (refuse-blocking))', ':dao.host/entry entry}))))')\ns=s.replace(\\\"(defn blake3-bytes [bs] (digest 'blake3-bytes bs))\\\\n(defn sha256-bytes [bs] (digest 'sha256-bytes bs))\\\", \\\"(defn blake3-bytes [bs]\\\\n  (check-bytes\"'! '\"'blake3-bytes bs)\\\\n  (blake3 bs))\\\\n\\\\n(defn sha256-bytes [bs]\\\\n  (check-bytes\"'! '\"'sha256-bytes bs)\\\\n  (refuse-blocking))\\\")\np.write_text(s)\np=Path('host/gambit/host-statics.ss')\ns=p.read_text(); a=s.index('(define (gambit-arrays-sort'); b=s.index('\\\\n(register-class-statics\"'! \"System\"'\"', a)\ns=s[:a]+'''(define (gambit-arrays-sort arr . rest)\n  (unless (jolt-obj-array? arr)\n    (throw-jvm 'IllegalArgumentException \\\"Arrays/sort: unsupported array\\\"))\n  (let* ((v (jolt-obj-array-vec arr))\n         (compare (if (pair? rest) (car rest) jolt-compare))\n         (sorted (list-sort (lambda (a b) (< (jnum->exact (jolt-invoke2 compare a b)) 0))\n                            (vector->list v))))\n    (vector-copy\"'! v 0 (list->vector sorted))\n    jolt-nil))\n'\"'