s]'\"\\\\n  (wait-input wake ms nil))').replace('(defn sleep-fds\"'! [_wake ms _pump on-line]'\"\\\\n  (wait-input ms on-line))','(defn sleep-fds\"'! [wake ms _pump on-line]'\"\\\\n  (wait-input wake ms on-line))')\np.write_text(s)\np=Path('host/gambit/gen-unicode-nfc.py')\ns=p.read_text().replace('    mapping = u.decomposition(char)', '    if 0xAC00 <= cp <= 0xD7A3:  # Hangul decomposes algorithmically.\\\\n        continue\\\\n    mapping = u.decomposition(char)').replace('licenses/Unicode-DFS-2016.txt.', 'licenses/Unicode-3.0.txt.')\np.write_text(s)\nPY\n\\\"\"'$HOME/.local/bin/python3.14\" host/gambit/gen-unicode-nfc.py >host/gambit/unicode-nfc-data.ss\ngsi=\"$HOME/.local/share/mise/installs/gambit/4.9.8/bin/gsi\"\n\"$gsi\" host/gambit/yin/blake3.ss -e '\"'(write (gambit-yin-blake3 (string->utf8 \\\"\\\"))) (newline) (write (gambit-yin-blake3 (string->utf8 \\\"abc\\\"))) (newline)'\ntail -18 build/p1c-r3/latest-yin.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
