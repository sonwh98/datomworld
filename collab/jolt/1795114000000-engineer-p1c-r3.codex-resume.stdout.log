{"type":"item.started","item":{"id":"item_149","type":"command_execution","command":"/bin/zsh -lc \"cat >host/gambit/build-yin-boot.py <<'PY'\n#\"'!/usr/bin/env python3\n\"\"\"Compile Jolt'\"'s existing Gambit boot for the Yin loaded-source gate.\\\"\\\"\\\"\nfrom concurrent.futures import ThreadPoolExecutor\nimport fcntl\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\n\nINCLUDE = re.compile(r'(?m)\"'^([ '\"\\\\t]*)\\\\(##include \\\"([\"'^\"]+)\"'\"\\\\)')\nREPO = Path(__file__).resolve().parents[2]\nBOOT = REPO / \\\"host/gambit/boot.ss\\\"\nSEEDS = {\\\"seed/prelude.ss\\\": (\\\"prelude\\\", 120), \\\"seed/image.ss\\\": (\\\"compiler\\\", 125)}\n\n\ndef boot_sources(path, seen):\n    if path in seen:\n        return\n    seen.add(path)\n    text = path.read_text()\n    yield path, text\n    for match in INCLUDE.finditer(text):\n        yield from boot_sources((path.parent / match[2]).resolve(), seen)\n\n\ndef write_units(directory):\n    units = []\n\n    def rewrite(match):\n        indent, relative = match.groups()\n        path = (BOOT.parent / relative).resolve()\n        if relative not in SEEDS:\n            return f'{indent}(##include {json.dumps(str(path), ensure_ascii=False)})'\n        prefix, chunk_size = SEEDS[relative]\n        # The seed emitter writes each guarded top-level form at column zero.\n        forms = re.split(r'(?m)(?=\"'^'\"\\\\(guard )', path.read_text())\n        if forms[0].strip():\n            raise ValueError(f\\\"Unexpected seed format in {path}\\\")\n        forms = forms[1:]\n        loads = []\n        for start in range(0, len(forms), chunk_size):\n            unit = directory / f\\\"{prefix}-{start // chunk_size:02d}.ss\\\"\n            unit.write_text(\\\"\\\".join(forms[start:start + chunk_size]))\n            units.append(unit)\n            artifact = json.dumps(str(unit.with_suffix(\\\".o1\\\")), ensure_ascii=False)\n            loads.append(f\\\"{indent}(load {artifact})\\\")\n        return \\\"\\\\n\\\".join(loads)\n\n    kernel = directory / \\\"kernel.ss\\\"\n    kernel.write_text(INCLUDE.sub(rewrite, BOOT.read_text()))\n    return [kernel, *units]\n\n\ndef build(gsc, cache):\n    digest = hashlib.sha256(Path(__file__).read_bytes())\n    digest.update(gsc.read_bytes())\n    for path, text in sorted(boot_sources(BOOT, set())):\n        digest.update(str(path).encode())\n        digest.update(text.encode())\n    key = digest.hexdigest()\n    cache.mkdir(parents=True, exist_ok=True)\n    pointer = cache / key\n\n    with (cache / \\\".lock\\\").open(\\\"a\\\") as lock:\n        fcntl.flock(lock, fcntl.LOCK_EX)\n        if pointer.exists():\n            kernel = Path(pointer.read_text().strip())\n            if kernel.is_file():\n                return kernel\n\n        directory = Path(tempfile.mkdtemp(prefix=\\\"boot-\\\", dir=cache))\n        units = write_units(directory)\n\n        def compile_unit(unit):\n            # The kernel alone expands to a large C translation unit.\n            options = [\\\"-:min-heap=768M\\\"] if unit == units[0] else []\n            subprocess.run([str(gsc), *options, \\\"-dynamic\\\", \\\"-cc-options\\\", \\\"-O0\\\", unit.name],\n                           cwd=directory, stdout=sys.stderr, check=True)\n            if not unit.with_suffix(\\\".o1\\\").is_file():\n                raise RuntimeError(f\\\"Gambit did not produce an object for {unit}\\\")\n\n        with ThreadPoolExecutor(max_workers=2) as executor:\n            list(executor.map(compile_unit, units))\n\n        kernel = units[0].with_suffix(\\\".o1\\\")\n        pending = directory / \\\"cache-entry\\\"\n        pending.write_text(f\\\"{kernel}\\\\n\\\")\n        pending.replace(pointer)\n        return kernel\n\n\nif __name__ == \\\"__main__\\\":\n    print(build(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()))\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nmain = Path('host/gambit/yin-repl-main.ss')\ns = main.read_text()\nstart = s.index('(##include \\\"host-apply.ss\\\")')\nshared = main.with_name('yin-repl-driver.ss')\nshared.write_text(';; The native and interpreted boots use the same source loader and Yin owner.\\\\n' + s[start:])\nmain.write_text(s[:start] + '(##include \\\"yin-repl-driver.ss\\\")\\\\n')\nnative = main.with_name('yin-repl-native.ss')\nnative.write_text('''#\"'!/usr/bin/env gsi-script\n;; The gate builds the kernel with gsc. App namespaces still load from source.\n;; The Gambit boot omits Chez'\"'s external data-reader loader.\n(define data-readers-active #f)\n(load (getenv \\\"JOLT_GAMBIT_YIN_BOOT\\\"))\n(##include \\\"yin-repl-driver.ss\\\")\n''')\nscript = Path('test/gambit/yin-repl-session.sh')\ns = script.read_text().replace('yin_root=\"'$2'\"\\\\n','yin_root=\"'$2'\"\\\\nlauncher=\"'${3:-host/gambit/yin-repl-main.ss}'\"\\\\n')\nscript.write_text(s.replace('\\\"\"'$gsi\" host/gambit/yin-repl-main.ss'\"', '\\\"\"'$gsi\" \"$launcher\"'\"'))\np = Path('Makefile')\ns = p.read_text()\nold = 'gambityinrepl: gambitffi-bridge\\\\n\\\\tsh test/gambit/yin-repl-session.sh \\\"\"'$(GAMBIT_GSI)\" \"$(abspath $(DATOMWORLD_ROOT))\"'\"'\nnew = '''# The interpreted bootstrap is available through yin-repl-main.ss. Compiling\n# the same boot makes the full app closure fit the acceptance watchdog.\nGAMBIT_YIN_BOOT ?=\ngambityinrepl: gambitffi-bridge\n\t@boot=\\\"\"'$(GAMBIT_YIN_BOOT)\"; '\"\\\\\\\\\n\tif [ -z \\\"\"'$$boot\" ]; then '\"\\\\\\\\\n\t  boot=\"'$$(sh host/gambit/ffi/watchdog.sh 2400 python3 host/gambit/build-yin-boot.py '\"\\\\\\\\\n\t    \\\"\"'$(GAMBIT_GSC)\" \"$(abspath build/gambit-yin)\") || exit $$?; '\"\\\\\\\\\n\tfi; \\\\\\\\\n\tJOLT_GAMBIT_YIN_BOOT=\\\"\"'$$boot\" sh test/gambit/yin-repl-session.sh '\"\\\\\\\\\n\t  \\\"\"'$(GAMBIT_GSI)\" \"$(abspath $(DATOMWORLD_ROOT))\" host/gambit/yin-repl-native.ss'\"'''\nassert old in s\np.write_text(s.replace(old,new))\nPY\npython3 - <<'PY'\nimport importlib.util\nfrom pathlib import Path\nimport tempfile\nspec=importlib.util.spec_from_file_location('builder','host/gambit/build-yin-boot.py')\nmod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)\nwith tempfile.TemporaryDirectory(dir='build/p1c-r3') as directory:\n    path=Path(directory).resolve()\n    outputs=mod.write_units(path)\n    known=Path('build/p1c-r3/chunks').resolve()\n    assert (path/'kernel.ss').read_text().replace(str(path),str(known)) == (known/'kernel.ss').read_text()\n    assert all(p.read_bytes()==(known/p.name).read_bytes() for p in outputs[1:])\n    print(len(outputs), 'native source units match the verified build byte-for-byte')\nPY\ngit diff --check\nrg -n '\"'^'\"\\\\[|startup failed|gambityinrepl:|\"'^yin'\"' build/p1c-r3/yin-native-local-langs.log | tail -20\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
