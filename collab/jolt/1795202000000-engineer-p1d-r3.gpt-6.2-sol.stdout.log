{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2108,2225p' build/tools/jolt/Makefile\ncat build/tools/jolt/host/gambit/ffi/watchdog.sh build/tools/jolt/host/gambit/build-yin-boot.py\ncat src/dev/yin_repl_launch.clj\nsed -n '1,77p' src/dev/build_cache.clj\"","aggregated_output":"# recorded after. No ambient .o1/.dylib is ever trusted. The aggregate target\n# is fail-closed: it passes only when all three gate scripts pass, and a gate\n# runs under the P1a-r2 external watchdog (host/gambit/ffi/watchdog.sh, the\n# same pattern the p1a witnesses use) so a frozen VM is a recorded failure,\n# never a hang.\n\nGAMBIT-FFI-DIR := host/gambit/ffi\nGAMBIT-FFI-BUILD := build/gambit-ffi\n\n# Keep Darwin's expanded link commands unchanged. Reject other hosts when an\n# FFI fixture recipe is expanded, without disabling unrelated make targets.\nGAMBIT-FFI-HOST-OS := $(shell uname -s)\nifeq ($(GAMBIT-FFI-HOST-OS),Darwin)\nGAMBIT-FFI-SHARED-FLAGS := -dynamiclib\nGAMBIT-FFI-ERRNO-ACCESSOR := __error\nelse ifeq ($(GAMBIT-FFI-HOST-OS),Linux)\nGAMBIT-FFI-SHARED-FLAGS := -shared -fPIC\nGAMBIT-FFI-ERRNO-ACCESSOR := __errno_location\nelse\nGAMBIT-FFI-SHARED-FLAGS = $(error gambitffi: unsupported fixture-link platform '$(GAMBIT-FFI-HOST-OS)' (expected Darwin or Linux))\nGAMBIT-FFI-ERRNO-ACCESSOR = $(error gambitffi: unsupported errno-accessor platform '$(GAMBIT-FFI-HOST-OS)' (expected Darwin or Linux))\nendif\n\n# the pinned inputs must match the recorded digests BEFORE anything compiles\ngambitffi-verify-digests:\n\t@sh $(GAMBIT-FFI-DIR)/verify-digests.sh \"$(GAMBIT_PREFIX)\"\n\n$(GAMBIT-FFI-BUILD)/joltffi-bridge.o1: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-bridge.scm \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt $(GAMBIT-FFI-DIR)/generated-shims.scm\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\t@rm -f $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 $(GAMBIT-FFI-BUILD)/joltffi-bridge.o[0-9]* \\\n\t       $(GAMBIT-FFI-BUILD)/joltffi-bridge.c $(GAMBIT-FFI-BUILD)/joltffi-bridge.o \\\n\t       $(GAMBIT-FFI-BUILD)/joltffi-bridge.scm\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/\n\tcd $(GAMBIT-FFI-BUILD) && sh ../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -dynamic -keep-temp joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n\t  > $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1.sha256\n\t@cc --version > $(GAMBIT-FFI-BUILD)/compiler.txt\n\t@shasum -a 256 $(GAMBIT_GSC) $(GAMBIT_GSI) \"$(GAMBIT_PREFIX)/include/gambit.h\" \\\n\t  \"$(GAMBIT_PREFIX)/lib/libgambit.a\" > $(GAMBIT-FFI-BUILD)/runtime.sha256\n\n$(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-fixture.c \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-fixture.c\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib.sha256\n\n$(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-fixture2.c \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-fixture2.c\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib.sha256\n\n# the present-but-unloadable candidate: a one-symbol dylib linked against a\n# dependency dylib this recipe then REMOVES, so dlopen fails with the loader's\n# own preserved reason (a missing dependency, not a missing file)\n$(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/DIGESTS.txt \\\n\t\t$(GAMBIT-FFI-DIR)/joltffi-dep.c $(GAMBIT-FFI-DIR)/joltffi-unloadable.c\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib $(GAMBIT-FFI-DIR)/joltffi-dep.c\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 $(GAMBIT-FFI-SHARED-FLAGS) -o $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-unloadable.c $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib\n\trm $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib.sha256\n\n# bridge + fixtures, always current: the entry every gambitffi gate depends on\n.PHONY: gambitffi-force gambitffi-verify-digests\ngambitffi-force:\n\ngambitffi-bridge: gambitffi-verify-digests $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib\n\ngambitffi-abi: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tJOLT_FFI_ERRNO_ACCESSOR=\"$(GAMBIT-FFI-ERRNO-ACCESSOR)\" sh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-abi.ss && \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 180 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-public.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n\n$(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1: $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1\n\t@mkdir -p $(GAMBIT-FFI-BUILD)/capture-test\n\t@rm -f $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o[0-9]*\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/capture-test/\n\tcd $(GAMBIT-FFI-BUILD)/capture-test && sh ../../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -dynamic -keep-temp -cc-options -DJOLTFFI_CAPTURE_TEST joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1 > $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1.sha256\n\ngambitffi-errno-check: gambitffi-bridge $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-errno.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\ngambitffi-load-failure-smoke: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 90 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-load-failure.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n# The aggregate includes host/name hygiene and all three native gate scripts.\n# Each prerequisite exits nonzero on failure.\ngambitffi: emittedheads deadhost gambitffi-abi gambitffi-errno-check gambitffi-load-failure-smoke\n\t@echo \"gambitffi: PASS — all stage-1 qualified-tier gates green\"\n\n#!/bin/sh\n# External deadline kills the gate process group. Keep stdin for the command.\nexec python3 -c '\nimport os, signal, subprocess, sys\nseconds = float(sys.argv[1])\np = subprocess.Popen(sys.argv[2:], start_new_session=True)\ntry:\n    status = p.wait(timeout=seconds)\nexcept subprocess.TimeoutExpired:\n    os.killpg(p.pid, signal.SIGKILL)\n    p.wait()\n    print(\"WATCHDOG: TIMEOUT after %ss: %s\" % (seconds, \" \".join(sys.argv[2:])), file=sys.stderr)\n    sys.exit(124)\nsys.exit(status if status >= 0 else 128 - status)\n' \"$@\"\n#!/usr/bin/env python3\n\"\"\"Compile Jolt's existing Gambit boot for the Yin loaded-source gate.\"\"\"\nfrom concurrent.futures import ThreadPoolExecutor\nimport fcntl\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\n\nINCLUDE = re.compile(r'(?m)^([ \\t]*)\\(##include \"([^\"]+)\"\\)')\nREPO = Path(__file__).resolve().parents[2]\nBOOT = REPO / \"host/gambit/boot.ss\"\nSEEDS = {\"seed/prelude.ss\": (\"prelude\", 120), \"seed/image.ss\": (\"compiler\", 125)}\n\n\ndef boot_sources(path, seen):\n    if path in seen:\n        return\n    seen.add(path)\n    text = path.read_text()\n    yield path, text\n    for match in INCLUDE.finditer(text):\n        yield from boot_sources((path.parent / match[2]).resolve(), seen)\n\n\ndef write_units(directory):\n    units = []\n\n    def rewrite(match):\n        indent, relative = match.groups()\n        path = (BOOT.parent / relative).resolve()\n        if relative not in SEEDS:\n            return f'{indent}(##include {json.dumps(str(path), ensure_ascii=False)})'\n        prefix, chunk_size = SEEDS[relative]\n        # The seed emitter writes each guarded top-level form at column zero.\n        forms = re.split(r'(?m)(?=^\\(guard )', path.read_text())\n        if forms[0].strip():\n            raise ValueError(f\"Unexpected seed format in {path}\")\n        forms = forms[1:]\n        loads = []\n        for start in range(0, len(forms), chunk_size):\n            unit = directory / f\"{prefix}-{start // chunk_size:02d}.ss\"\n            unit.write_text(\"\".join(forms[start:start + chunk_size]))\n            units.append(unit)\n            artifact = json.dumps(str(unit.with_suffix(\".o1\")), ensure_ascii=False)\n            loads.append(f\"{indent}(load {artifact})\")\n        return \"\\n\".join(loads)\n\n    kernel = directory / \"kernel.ss\"\n    kernel.write_text(INCLUDE.sub(rewrite, BOOT.read_text()))\n    return [kernel, *units]\n\n\ndef build(gsc, cache):\n    digest = hashlib.sha256(Path(__file__).read_bytes())\n    digest.update(gsc.read_bytes())\n    for path, text in sorted(boot_sources(BOOT, set())):\n        digest.update(str(path).encode())\n        digest.update(text.encode())\n    key = digest.hexdigest()\n    cache.mkdir(parents=True, exist_ok=True)\n    pointer = cache / key\n\n    with (cache / \".lock\").open(\"a\") as lock:\n        fcntl.flock(lock, fcntl.LOCK_EX)\n        if pointer.exists():\n            kernel = Path(pointer.read_text().strip())\n            if kernel.is_file():\n                return kernel\n\n        directory = Path(tempfile.mkdtemp(prefix=\"boot-\", dir=cache))\n        units = write_units(directory)\n\n        def compile_unit(unit):\n            # The kernel alone expands to a large C translation unit.\n            options = [\"-:min-heap=768M\"] if unit == units[0] else []\n            subprocess.run([str(gsc), *options, \"-dynamic\", \"-cc-options\", \"-O0\", unit.name],\n                           cwd=directory, stdout=sys.stderr, check=True)\n            if not unit.with_suffix(\".o1\").is_file():\n                raise RuntimeError(f\"Gambit did not produce an object for {unit}\")\n\n        with ThreadPoolExecutor(max_workers=2) as executor:\n            list(executor.map(compile_unit, units))\n\n        kernel = units[0].with_suffix(\".o1\")\n        pending = directory / \"cache-entry\"\n        pending.write_text(f\"{kernel}\\n\")\n        pending.replace(pointer)\n        return kernel\n\n\nif __name__ == \"__main__\":\n    print(build(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()))\n(ns yin-repl-launch\n  (:require [babashka.fs :as fs]\n            [babashka.process :as p]\n            [build-cache :as cache]\n            [clojure.string :as str]\n            [jolt-launch :as jolt]))\n\n\n(def ^:private backends #{\"jvm\" \"node\" \"dart\" \"jolt-chez\" \"jolt-gambit\"})\n\n\n(def ^:private gambit-capabilities\n  \"Local --index-store mem session; no :yang/python frontend or WebSocket serving.\")\n\n\n(def ^:private gambit-blocking\n  \"Blocking FFI refuses inline: blocking ffi is unsupported on the gambit target.\")\n\n\n(def ^:private usage\n  (str \"Usage: bb yin-repl [--backend jvm|node|dart|jolt-chez|jolt-gambit] [yin args...]\n\n  jvm          Default. Shipped JVM shell with Python and PHP frontends.\n  node         Shipped Node shell with Python and PHP frontends.\n  dart         Dart cross-host peer with a Transit command protocol.\n  jolt-chez    Pinned Jolt shell with the native Python frontend.\n  jolt-gambit  \" gambit-capabilities \"\n               \" gambit-blocking \"\n\nUse -- --help after the backend to pass --help to the selected program.\"))\n\n\n(defn- parse-launch\n  [args]\n  (let [[backend args] (cond\n                         (= \"--backend\" (first args)) [(second args) (nnext args)]\n                         (some-> (first args) (str/starts-with? \"--backend=\"))\n                         [(subs (first args) (count \"--backend=\")) (next args)]\n                         :else [\"jvm\" args])]\n    (when-not (backends backend)\n      (throw (ex-info (str \"Unknown or missing --backend \" (pr-str backend)\n                           \". Run bb yin-repl --help.\") {:exit 2})))\n    [backend args]))\n\n\n(defn- checked-shell\n  [opts & command]\n  (let [result (apply p/shell (merge {:continue true :shutdown nil} opts) command)]\n    (when-not (zero? (:exit result))\n      (throw (ex-info (str \"yin-repl prerequisite failed: \" (str/join \" \" command))\n                      {:exit (:exit result)})))\n    result))\n\n\n(defn- task!\n  [task & args]\n  (apply checked-shell {} \"bb\" task args))\n\n\n(defn- terminal-exit\n  [command args]\n  (:exit (apply p/shell {:in :inherit :continue true :shutdown nil}\n                (into command args))))\n\n\n(defn- ensure-jolt!\n  []\n  (when-not (fs/regular-file? \"build/tools/jolt-env.sh\")\n    (task! \"bootstrap:jolt\")))\n\n\n(defn- ensure-java-parsers!\n  []\n  (when-not (and (fs/regular-file? \"build/antlr/python3/classes/yang/python/antlr/gen/Python3Parser.class\")\n                 (fs/regular-file? \"build/antlr/php/classes/yang/php/antlr/gen/PhpParser.class\"))\n    (task! \"gen:antlr\" \"--\" \"--target\" \"java\")))\n\n\n(defn- ensure-chez-native!\n  []\n  (let [darwin? (str/includes? (str/lower-case (System/getProperty \"os.name\")) \"mac\")\n        arm64? (#{\"aarch64\" \"arm64\"} (System/getProperty \"os.arch\"))\n        platform (str (if darwin? \"darwin-\" \"linux-\") (if arm64? \"arm64\" \"x86_64\"))\n        extension (if darwin? \".dylib\" \".so\")]\n    (when-not (every? #(fs/regular-file? (str \"build/native/\" platform \"/jolt-\" %\n                                              \"/lib/libjolt_\" % extension))\n                      [\"crypto\" \"file\" \"parser\"])\n      (task! \"build:jolt-native\"))))\n\n\n(def ^:private bridge \"build/gambit-ffi/joltffi-bridge.o1\")\n\n\n(defn- gambit-runtime!\n  \"Stage the bridge at the relative path the pinned driver loads. The\n   source checkout stays read-only, including when the bridge needs building.\"\n  [cache-dir jolt-home prefix chez]\n  (let [ffi \"host/gambit/ffi\"\n        makefile (str (fs/path jolt-home \"Makefile\"))\n        inputs [\"bin/gsi\" \"bin/gsc\" \"bin/gambuild-C\" \"include/gambit.h\"\n                \"lib/libgambit.a\" \"lib/libgambitgsi.a\" \"lib/libgambitgsc.a\"]\n        key (cache/digest (cache/snapshot (into [makefile (str (fs/path jolt-home ffi))]\n                                                (map #(str (fs/path prefix %))) inputs)))\n        runtime (fs/path cache-dir (str \"runtime-\" key))]\n    (with-open [lock-file (java.io.RandomAccessFile. (fs/file cache-dir \".runtime-lock\") \"rw\")\n                channel (.getChannel lock-file)\n                lock (.lock channel)]\n      (when-not (fs/regular-file? (fs/path runtime bridge))\n        (let [stage (fs/create-temp-dir {:dir cache-dir :prefix \"runtime-\"})]\n          (try\n            (fs/create-dirs (fs/path stage \"host/gambit\"))\n            (fs/copy-tree (fs/path jolt-home ffi) (fs/path stage ffi))\n            (fs/copy makefile (fs/path stage \"Makefile\"))\n            (doseq [path [\"host/gambit/yin\" \"stdlib\" \"jolt-core\"]]\n              (fs/create-sym-link (fs/path stage path) (fs/path jolt-home path)))\n            (checked-shell {:dir stage} \"sh\" \"host/gambit/ffi/record-toolchain.sh\" prefix)\n            (checked-shell {:dir stage} \"make\" (str \"CHEZ=\" chez)\n                           (str \"GAMBIT_PREFIX=\" prefix) bridge)\n            (fs/move stage runtime {:atomic-move true})\n            (finally\n              (when (fs/exists? stage)\n                (fs/delete-tree stage)))))))\n    (str runtime)))\n\n\n(defn- jolt-session\n  [target extra-env command args]\n  (apply jolt/run-terminal-child\n         {:extra-env extra-env\n          :identity-prefix jolt/identity-prefix\n          :assert-identity! #(jolt/assert-child-target! {:target target :output %\n                                                         :context \"yin-repl\"})}\n         \"sh\" \"-c\" command \"jolt\" args))\n\n\n(defn- gambit-session\n  [args]\n  (ensure-jolt!)\n  (let [[jolt-home gsi chez] (-> (checked-shell {:out :string}\n                                                \"sh\" \"-c\" (jolt/toolchain-command\n                                                            \"printf '%s\\\\n' \\\"$JOLT_HOME\\\" \\\"$JOLT_GAMBIT\\\" \\\"$JOLT_CHEZ\\\"\"))\n                                 :out\n                                 str/split-lines)\n        prefix (str (fs/parent (fs/parent gsi)))\n        cache-dir (fs/absolutize \"build/gambit-yin\")\n        _ (cache/local-path! cache-dir)\n        _ (fs/create-dirs cache-dir)\n        runtime (gambit-runtime! cache-dir jolt-home prefix chez)\n        boot (-> (checked-shell {:dir jolt-home :out :string}\n                                \"python3\" \"host/gambit/build-yin-boot.py\"\n                                (str (fs/path prefix \"bin/gsc\")) (str cache-dir))\n                 :out str/trim)\n        driver (str (fs/path jolt-home \"host/gambit/yin-repl-native.ss\"))\n        identity \"(begin (display \\\"jolt-target: gambit\\\" (current-error-port)) (newline (current-error-port)) (force-output (current-error-port)))\"]\n    (.println System/err (str \"jolt-gambit  \" gambit-capabilities))\n    (.println System/err gambit-blocking)\n    (jolt-session :gambit {\"JOLT_GAMBIT_YIN_BOOT\" boot}\n                  (jolt/launch-command {:target :gambit :cd? true})\n                  (into [runtime \"-e\" identity driver (str (fs/absolutize \".\"))] args))))\n\n\n(defn- launch\n  [backend args]\n  (case backend\n    \"jvm\" (do (ensure-java-parsers!)\n              (terminal-exit [\"clj\" \"-M:clj-yin-repl\"] args))\n    \"node\" (do (when-not (fs/regular-file? \"target/yin-repl.js\")\n                 (task! \"build:yin-repl-node\"))\n               (terminal-exit [\"node\" \"target/yin-repl.js\"] args))\n    \"dart\" (do (when-not (fs/regular-file? \"build/yin-repl-peer\")\n                 (task! \"build:yin-repl-peer\"))\n               (terminal-exit [\"build/yin-repl-peer\"] args))\n    \"jolt-chez\" (do (ensure-jolt!)\n                    (ensure-chez-native!)\n                    (jolt/preflight! :chez \"yin-repl\")\n                    (terminal-exit [\"sh\" \"-c\" (jolt/launch-command {:target :chez :alias \"jolt-yin-repl\"}) \"jolt\"]\n                                   args))\n    \"jolt-gambit\" (gambit-session args)))\n\n\n(let [exit (try\n             (let [[backend args] (parse-launch *command-line-args*)]\n               (if (#{\"-h\" \"--help\"} (first args))\n                 (do (println usage) (flush) 0)\n                 (launch backend (if (= \"--\" (first args)) (rest args) args))))\n             (catch Exception e\n               (.println System/err (ex-message e))\n               (or (:exit (ex-data e)) 1)))]\n  (System/exit exit))\n(ns build-cache\n  \"Content-checked, worktree-local caches for expensive test prerequisites.\"\n  (:require\n    [babashka.fs :as fs]\n    [babashka.process :as p]\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.string :as str])\n  (:import\n    [java.security MessageDigest]))\n\n\n(defn digest\n  [value]\n  (let [md (MessageDigest/getInstance \"SHA-256\")]\n    (.update md (.getBytes (pr-str value) \"UTF-8\"))\n    (format \"%064x\" (java.math.BigInteger. 1 (.digest md)))))\n\n\n(defn file-digest\n  [path]\n  (let [md (MessageDigest/getInstance \"SHA-256\")]\n    (with-open [in (io/input-stream (fs/file path))]\n      (let [buf (byte-array 65536)]\n        (loop []\n          (let [n (.read in buf)]\n            (when (pos? n)\n              (.update md buf 0 n)\n              (recur))))))\n    (format \"%064x\" (java.math.BigInteger. 1 (.digest md)))))\n\n\n(defn snapshot\n  \"Names and bytes, including missing roots; detects removed/corrupt outputs.\"\n  [roots]\n  (let [file-state (fn [f]\n                     {:sha256 (file-digest f)\n                      :executable? (.canExecute (fs/file f))})]\n    (into (sorted-map)\n          (mapcat (fn [root]\n                    (if (fs/directory? root)\n                      (cons [(str root) :directory]\n                            (for [f (sort (fs/glob root \"**\" {:hidden true}))\n                                  :when (fs/regular-file? f)]\n                              [(str f) (file-state f)]))\n                      [[(str root) (when (fs/regular-file? root)\n                                     (file-state root))]])))\n          roots)))\n\n\n(defn local-path!\n  \"Refuse shared mutable output directories, including symlinked parents.\"\n  [path]\n  (let [root (.getCanonicalFile (fs/file \".\"))\n        dest (.getCanonicalFile (fs/file path))]\n    (when-not (.startsWith (.toPath dest) (.toPath root))\n      (throw (ex-info (str \"cache output must stay in this worktree: \" path) {})))))\n\n\n(defn checked-output\n  [& command]\n  (let [{:keys [exit out err]} (apply p/sh command)]\n    (when-not (zero? exit)\n      (throw (ex-info (str \"failed: \" (str/join \" \" command) \"\\n\" err)\n                      {:exit exit})))\n    (str/trim (str out err))))\n\n\n(defn cached!\n  \"Hold a worktree-local writer lock; record inputs/outputs only after success.\"\n  [id inputs outputs command]\n  (doseq [path (concat [\"target/prereq-cache\"] outputs)] (local-path! path))\n  (fs/create-dirs \"target/prereq-cache\")\n  (let [stamp (str \"target/prereq-cache/\" id \".edn\")\n        lock (str \"target/prereq-cache/\" id \".lock\")\n        key (digest [(str (fs/canonicalize \".\")) inputs])]\n    (try (fs/create-dir lock)\n","exit_code":0,"status":"completed"}}
