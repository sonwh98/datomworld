{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"cat >>host/gambit/ffi/joltffi-fixture.c <<'EOF'\n\n/* P1f: the Internet address conversion and datagram call shapes. Exercise all\n   argument positions, including bits above 32 in size_t and the socklen_t. */\nint joltffi_fx_inet_pton(int af, void *src, void *dst) {\n  if (af \"'!= 6 || *(const uint8_t *)src != 0xff)\n    return 0;\n  *(uint8_t *)dst = 42;\n  return 1;\n}\n\nvoid *joltffi_fx_inet_ntop(int af, void *src, void *dst, unsigned int len) {\n  if (af != 6 || *(const uint8_t *)src != 42 || len != UINT32_MAX)\n    return NULL;\n  *(uint8_t *)dst = 0xff;\n  return dst;\n}\n\nssize_t joltffi_fx_sendto(int fd, void *buf, size_t len, int flags,\n                          void *addr, unsigned int addrlen) {\n  if (fd != 17 || *(const uint8_t *)buf != 0xff || len != UINT64_C(0x100000003)\n      || flags != -8 || *(const uint8_t *)addr != 42 || addrlen != UINT32_MAX) {\n    errno = EINVAL;\n    return -1;\n  }\n  errno = 7777;\n  return (ssize_t)len;\n}\n\nssize_t joltffi_fx_recvfrom(int fd, void *buf, size_t len, int flags,\n                            void *addr, void *addrlen) {\n  if (fd != 17 || len != UINT64_C(0x100000003) || flags != -8) {\n    errno = EAGAIN;\n    return -1;\n  }\n  *(uint8_t *)buf = 42;\n  *(uint8_t *)addr = 0xff;\n  *(unsigned int *)addrlen = 28;\n  errno = 7777;\n  return (ssize_t)len;\n}\n\nint joltffi_fx_datagram_close(int fd) {\n  if (fd == 17) {\n    errno = 7777;\n    return 0;\n  }\n  errno = EBADF;\n  return -1;\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np = Path('host/gambit/ffi/gambitffi-abi.ss')\ns = p.read_text()\nat = s.rindex('(ffi-gate-finish')\ns = s[:at] + '''(printf \\\"== P1f Internet address and datagram shapes ==\\\\\\\\n\\\")\n(let ((src (sa-foreign-alloc 8))\n      (dst (sa-foreign-alloc 8))\n      (lenp (sa-foreign-alloc 4))\n      (pton (sa-foreign-procedure \\\"joltffi_fx_inet_pton\\\" (int void* voi