{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np = Path('host/gambit/ffi/joltffi-fixture.c')\np.write_text(p.read_text().rstrip() + '\\\\n')\np = Path('host/gambit/ffi/gambitffi-abi.ss')\ns = p.read_text().replace('''(let* ((socket (sa-foreign-procedure \\\"socket\\\" (int int int) int))\n       (getsockname''','''(let* ((socket (sa-foreign-procedure-native-error posix () \\\"socket\\\" (int int int) int))\n       (getsockname''').replace('''       (fd (socket 2 2 17))) ; AF_INET, SOCK_DGRAM, IPPROTO_UDP on both legs''','''       (fd (call-with-values (lambda () (socket 2 2 17))\n             (lambda (fd _) fd)))) ; AF_INET, SOCK_DGRAM, IPPROTO_UDP on both legs''')\np.write_text(s)\np = Path('host/gambit/ffi/joltffi-bridge.scm')\ns = p.read_text().replace('''    job->result = -1;\n    job->error = error;''','''    job->result = -2; /* submission failed; close() was never called */\n    job->error = error;''')\ns = s.replace('''                (if (= result -9223372036854775808)\n                    (begin (thread-sleep\"'! 0.001) (loop))\n                    result))))'\"''','''                (cond ((= result -9223372036854775808)\n                       (thread-sleep\"'! 0.001)\n                       (loop))\n                      ((< result -4294967296)\n                       (error \"jolt.ffi: could not start datagram close worker\"\n                              (+ result 8589934592)))\n                      (else result)))))'\"''')\np.write_text(s)\np = Path('host/gambit/ffi/README.md')\ns = p.read_text().replace('''thirteen explicit scalar identity fixtures, and the P1f inet address conversion,\nand UDP send/receive shapes. S19 and S20 share one\nABI.''','''thirteen explicit scalar identity fixtures, and the P1f inet address conversion\nand UDP send/receive shapes. S19 and S20 share one ABI.''')\np.write_text(s)\nPY\nsh host/gambit/ffi/watchdog.sh 30 sh host/g