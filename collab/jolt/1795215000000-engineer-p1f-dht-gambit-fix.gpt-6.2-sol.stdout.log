{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1485,1520p' Makefile; rg -n 'JOLT-CHEZ|LOCAL-ROOT|irregex.scm:' Makefile | head -28; rg -n 'ready|ERROR' build/p1f/component.err | tail -14; tail -12 build/p1f/component.out | cut -c1-200; ls -l build/gambit-yin/boot-* | tail -12; sed -n '184,248p' /Users/sto/workspace/datomworld/src/cljc/dao/stream/datagram.cljc; sed -n '368,391p' /Users/sto/workspace/datomworld/src/jolt/dao/stream/udp.jolt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1485,1520p' Makefile; rg -n 'JOLT-CHEZ|LOCAL-ROOT|irregex.scm:' Makefile | head -28; rg -n 'ready|ERROR' build/p1f/component.err | tail -14; tail -12 build/p1f/component.out | cut -c1-200; ls -l build/gambit-yin/boot-* | tail -12; sed -n '184,248p' /Users/sto/workspace/datomworld/src/cljc/dao/stream/datagram.cljc; sed -n '368,391p' /Users/sto/workspace/datomworld/src/jolt/dao/stream/udp.jolt\"","aggregated_output":"# Top-level host procedures nothing calls. A definition whose last caller went\n# away is still compiled into every binary and still copied forward into the\n# Gambit half by gen-records.ss — four of the first batch were dead in BOTH\n# copies for exactly that reason. Counts a name referenced when it appears as a\n# token anywhere OUTSIDE a comment, string bodies included (the backend emits\n# calls as text), or when an identifier inside a string literal is its stem and\n# the tail is all digits: (str \"jolt-ffi-varargs-proc\" k) reaches proc0..proc3,\n# and a gate without that rule would have deleted every varargs FFI binding.\ndeadhost:\n\t@sh host/chez/dead-host-check.sh\n\n# A top-level define that rebinds a name a define-record-type generated. The\n# host files share one top level, so the later define wins silently and every\n# reader of the field gets the other procedure (the fiber record's waiter field\n# read through fibers-async.ss's handler allocator).\nrecordshadow:\n\t@$(CHEZ) --script host/chez/record-shadow-check.ss\n\n# Every head the back end writes into its output must be one munge-name renames\n# a user local away from; the list of those names is kept by hand and drifted\n# (a local named pair? or fx+ called itself in place of the runtime procedure).\nemittedheads:\n\t@JOLT_NO_USER_DEPS=1 bin/jolt run host/chez/emitted-heads-check.clj\n\ncensus:\n\t@sh host/chez/portability-check.sh --census\n\n# PSL R2 adapter contract gate: assert every CONTRACT.txt name is bound in\n# (chezscheme). The chez adapter defines nothing — this only fails when the\n# contract file lists a name Chez does not provide.\nadaptercheck:\n\t@$(CHEZ) --script host/scheme-adapter/chez.ss\n\n# The three derived host properties (sa-os-family / sa-arch / sa-endian) are all\n# host logic may ask about the platform, so one wrong row is a wrong SIGCHLD,\n# LC_TIME and struct-stat offset at once. The row that broke in #796 — a\n27:JOLT-CHEZ := $(or $(CHEZ),$(CHEZSCHEME))\n34:ifneq (,$(JOLT-CHEZ))\n35:SHELL-DEPS += $(JOLT-CHEZ)\n63:CHEZSCHEME-LOCAL := $(LOCAL-ROOT)/chezscheme-$(CHEZSCHEME-VERSION)\n72:JOLT-CHEZ := $(CHEZSCHEME)\n77:JOLT-CHEZ := chez-not-provisioned-on-windows\n78:.PHONY: $(JOLT-CHEZ)\n79:$(JOLT-CHEZ):\n97:CHEZ ?= $(JOLT-CHEZ)\n140:deps: submodules $(JOLT-CHEZ)\n142:\t  '$(JOLT-CHEZ)' -q 2>/dev/null | tr -d '\\r'); \\\n144:\t    echo \"Jolt requires a threaded Chez Scheme ($(JOLT-CHEZ) reported $$threaded)\" >&2; \\\n*** WARNING -- Variable \"symbol-t-ncell\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"symbol-t-ns\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"symbol-t?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"tail-claim-owner\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"tail-claim-tail\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"tail-claim-token\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"tail-claim?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"transcoded-port\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-defined?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-defined?-set!\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-dyn-bound?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-dyn-bound?-set!\" used in module \"kernel\" is-rwxr-xr-x@ 1 sto  staff   520464 Nov 22 00:16 prelude-10.o1\n-rw-r--r--@ 1 sto  staff    44491 Nov 22 00:14 prelude-10.ss\n-rwxr-xr-x@ 1 sto  staff   518992 Nov 22 00:16 prelude-11.o1\n-rw-r--r--@ 1 sto  staff    50214 Nov 22 00:14 prelude-11.ss\n-rwxr-xr-x@ 1 sto  staff   520224 Nov 22 00:16 prelude-12.o1\n-rw-r--r--@ 1 sto  staff    44451 Nov 22 00:14 prelude-12.ss\n-rwxr-xr-x@ 1 sto  staff   450400 Nov 22 00:16 prelude-13.o1\n-rw-r--r--@ 1 sto  staff    38928 Nov 22 00:14 prelude-13.ss\n-rwxr-xr-x@ 1 sto  staff   468144 Nov 22 00:16 prelude-14.o1\n-rw-r--r--@ 1 sto  staff    40528 Nov 22 00:14 prelude-14.ss\n-rwxr-xr-x@ 1 sto  staff    34480 Nov 22 00:16 prelude-15.o1\n-rw-r--r--@ 1 sto  staff     1394 Nov 22 00:14 prelude-15.ss\n  (and (map? v)\n       (string? (:dao.stream.datagram/socket v))\n       (keyword? (:dao.stream.datagram/event v))))\n\n\n(defn bound-event\n  \"The bound lifecycle event: the socket exists, with its actual local\n   address.\"\n  [id host port]\n  {:dao.stream.datagram/socket id\n   :dao.stream.datagram/event :dao.stream.datagram/bound\n   :dao.stream.datagram/local {:dao.stream.datagram/host host\n                               :dao.stream.datagram/port port}})\n\n\n(defn bind-failed-event\n  \"The failed-bind lifecycle event. There is no writer.\"\n  [id reason]\n  {:dao.stream.datagram/socket id\n   :dao.stream.datagram/event :dao.stream.datagram/bind-failed\n   :dao.stream.datagram/reason reason})\n\n\n(defn send-failed-event\n  \"The send-failure lifecycle event: the channel for a send failure the\n   host could not answer at call time, and the observers' copy of one it\n   could.\"\n  [id reason]\n  {:dao.stream.datagram/socket id\n   :dao.stream.datagram/event :dao.stream.datagram/send-failed\n   :dao.stream.datagram/reason reason})\n\n\n(defn closed-event\n  \"The closed lifecycle event, deposited while the deposit writer still\n   admits it.\"\n  [id]\n  {:dao.stream.datagram/socket id\n   :dao.stream.datagram/event :dao.stream.datagram/closed})\n\n\n(defn datagram-event\n  \"One received datagram as an event: `bytes` encoded as Base64 so no host\n   byte array crosses onto a stream, with the source the socket observed.\"\n  [id host port bytes]\n  {:dao.stream.datagram/socket id\n   :dao.stream.datagram/source {:dao.stream.datagram/host host\n                                :dao.stream.datagram/port port}\n   :dao.stream.datagram/bytes (base64/encode bytes)})\n\n\n;; =============================================================================\n;; The writer handle (section 4)\n;; =============================================================================\n\n\n(defn- check-outbound\n  \"One outbound value of section 2 as either {:bytes bs} -- the decoded\n   datagram, ready for the socket -- or {:refusal reason}: a malformed\n   destination, a host that is not an IP literal, bytes that are not\n   strict Base64, or a decoded length over the budget. Nothing was sent\n   for a refusal.\"\n  [v max-bytes]\n  (cond\n    (not (map? v))\n                                                                (do\n                                                                  (vreset! progressed? true)\n                                                                  (if (> n max-bytes)\n                                                                    ;; Oversize drop\n                                                                    (recur (dec budget))\n                                                                    (let [bs (if (zero? n)\n                                                                               (bytes/alloc 0)\n                                                                               (ffi/read-array buf n))\n                                                                          src-ip (native/sockaddr-ip rsa)\n                                                                          src-port (native/sockaddr-port rsa)]\n                                                                      (deposit-event! deposit\n                                                                                      (datagram/datagram-event identity src-ip src-port bs))\n                                                                      (recur (dec budget)))))))))\n                                                        {:progressed? @progressed?})\n                                                      (finally\n                                                        (when rsa (ffi/free rsa))\n                                                        (when rlenp (ffi/free rlenp)))))\n                                                  (finally\n                                                    (ffi/free buf))))))\n\n                                          seam {:send! send-fn\n                                                :close! close-fn\n                                                :step! step-fn\n                                                :diagnostics diagnostics\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"cat >>host/gambit/ffi/joltffi-fixture.c <<'EOF'\n\n/* P1f: the Internet address conversion and datagram call shapes. Exercise all\n   argument positions, including bits above 32 in size_t and the socklen_t. */\nint joltffi_fx_inet_pton(int af, void *src, void *dst) {\n  if (af \"'!= 6 || *(const uint8_t *)src != 0xff)\n    return 0;\n  *(uint8_t *)dst = 42;\n  return 1;\n}\n\nvoid *joltffi_fx_inet_ntop(int af, void *src, void *dst, unsigned int len) {\n  if (af != 6 || *(const uint8_t *)src != 42 || len != UINT32_MAX)\n    return NULL;\n  *(uint8_t *)dst = 0xff;\n  return dst;\n}\n\nssize_t joltffi_fx_sendto(int fd, void *buf, size_t len, int flags,\n                          void *addr, unsigned int addrlen) {\n  if (fd != 17 || *(const uint8_t *)buf != 0xff || len != UINT64_C(0x100000003)\n      || flags != -8 || *(const uint8_t *)addr != 42 || addrlen != UINT32_MAX) {\n    errno = EINVAL;\n    return -1;\n  }\n  errno = 7777;\n  return (ssize_t)len;\n}\n\nssize_t joltffi_fx_recvfrom(int fd, void *buf, size_t len, int flags,\n                            void *addr, void *addrlen) {\n  if (fd != 17 || len != UINT64_C(0x100000003) || flags != -8) {\n    errno = EAGAIN;\n    return -1;\n  }\n  *(uint8_t *)buf = 42;\n  *(uint8_t *)addr = 0xff;\n  *(unsigned int *)addrlen = 28;\n  errno = 7777;\n  return (ssize_t)len;\n}\n\nint joltffi_fx_datagram_close(int fd) {\n  if (fd == 17) {\n    errno = 7777;\n    return 0;\n  }\n  errno = EBADF;\n  return -1;\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np = Path('host/gambit/ffi/gambitffi-abi.ss')\ns = p.read_text()\nat = s.rindex('(ffi-gate-finish')\ns = s[:at] + '''(printf \\\"== P1f Internet address and datagram shapes ==\\\\\\\\n\\\")\n(let ((src (sa-foreign-alloc 8))\n      (dst (sa-foreign-alloc 8))\n      (lenp (sa-foreign-alloc 4))\n      (pton (sa-foreign-procedure \\\"joltffi_fx_inet_pton\\\" (int void* void*) int))\n      (ntop (sa-foreign-procedure \\\"joltffi_fx_inet_ntop\\\" (int void* void* unsigned-int) void*))\n      (sendto (sa-foreign-procedure-native-error ()\n                \\\"joltffi_fx_sendto\\\" (int void* size_t int void* unsigned-int) ssize_t))\n      (recvfrom (sa-foreign-procedure-native-error ()\n                  \\\"joltffi_fx_recvfrom\\\" (int void* size_t int void* void*) ssize_t))\n      (close (sa-foreign-procedure-native-error () \\\"joltffi_fx_datagram_close\\\" (int) int))\n      (eagain ((sa-foreign-procedure \\\"joltffi_fx_eagain\\\" () int)))\n      (ebadf ((sa-foreign-procedure \\\"joltffi_fx_ebadf\\\" () int))))\n  (dynamic-wind\n    (lambda () #f)\n    (lambda ()\n      (sa-foreign-set\"'! '\"'unsigned-8 src 0 255)\n      (ffi-check \\\"inet_pton int and output pointer\\\" (pton 6 src dst) 1)\n      (ffi-check \\\"inet_pton writes binary address\\\" (sa-foreign-ref 'unsigned-8 dst 0) 42)\n      (ffi-check \\\"inet_ntop unsigned socklen and returned pointer\\\" (ntop 6 dst src #xffffffff) src)\n      (ffi-check \\\"inet_ntop null result\\\" (ntop 6 dst src 0) 0)\n      (ffi-check \\\"sendto six slots, wide result and errno\\\"\n        (call-with-values (lambda () (sendto 17 src #x100000003 -8 dst #xffffffff)) list)\n        (list #x100000003 7777))\n      (ffi-check \\\"recvfrom six slots, wide result and errno\\\"\n        (call-with-values (lambda () (recvfrom 17 src #x100000003 -8 dst lenp)) list)\n        (list #x100000003 7777))\n      (ffi-check \\\"recvfrom payload, source address and in/out socklen\\\"\n        (list (sa-foreign-ref 'unsigned-8 src 0) (sa-foreign-ref 'unsigned-8 dst 0)\n              (sa-foreign-ref 'unsigned-int lenp 0))\n        '(42 255 28))\n      (ffi-check \\\"recvfrom would-block capture\\\"\n        (call-with-values (lambda () (recvfrom -1 src 8 0 dst lenp)) list)\n        (list -1 eagain))\n      (ffi-check \\\"datagram close success result and errno\\\"\n        (call-with-values (lambda () (close 17)) list) '(0 7777))\n      (ffi-check \\\"datagram close error result and errno\\\"\n        (call-with-values (lambda () (close -1)) list) (list -1 ebadf)))\n    (lambda () (sa-foreign-free lenp) (sa-foreign-free dst) (sa-foreign-free src))))\n\n''' + s[at:]\np.write_text(s)\np = Path('host/gambit/ffi/gambitffi-public.ss')\ns = p.read_text()\nat = s.index('(printf \\\"gambitffi-public:')\ns = s[:at] + '''(public-check \\\"(let [p (jolt.ffi/alloc 4)] (try [(jolt.ffi/write-array p (byte-array [0 -1 42 -128])) (vec (jolt.ffi/read-array p 4))] (finally (jolt.ffi/free p))))\\\" \\\"[4 [0 -1 42 -128]]\\\")\n(public-check \\\"(let [p (jolt.ffi/null)] [(jolt.ffi/write-array p (byte-array 0)) (alength (jolt.ffi/read-array p 0))])\\\" \\\"[0 0]\\\")\n(public-check \\\"(let [v (into [161] (vec (range 33)))] [(count v) (nth v 0) (nth v 33)])\\\" \\\"[34 161 32]\\\")\n(public-check \\\"(.getPath (java.io.File. \\\\\\\\\\\"some/path\\\\\\\\\\\"))\\\" \\\"\\\\\\\\\\\"some/path\\\\\\\\\\\"\\\")\n(public-check \\\"(try (.exists (java.io.File. \\\\\\\\\\\"some/path\\\\\\\\\\\")) (catch UnsupportedOperationException e (boolean (re-find #\\\\\\\\\\\"blocking ffi is unsupported\\\\\\\\\\\" (ex-message e)))))\\\" \\\"true\\\")\n''' + s[at:]\n# ffi/null is a numeric var, not a procedure.\np.write_text(s.replace('[p (jolt.ffi/null)]', '[p jolt.ffi/null]'))\nPY\nsh host/gambit/ffi/watchdog.sh 30 sh host/gambit/ffi/make-digests.sh\nenv TMPDIR=\\\"\"'$PWD/build/p1f/tmp\" CHEZ=/Users/sto/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme JOLT_REQUIRE_GAMBIT=1 sh host/gambit/ffi/watchdog.sh 900 make gambitffi gambitcheck gambitkernel gambiteval gambitgencheck gambitseedcheck GAMBIT_PREFIX=/Users/sto/.local/share/mise/installs/gambit/4.9.8 >build/p1f/matrix.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
