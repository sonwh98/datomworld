         (jolt-record-field-names (spec ...)))))\n    ((_ name (parent p) (fields spec ...) (nongenerative uid))\n     (define name (make-jolt-record-type 'name #f #f 'p\n                                         (jolt-record-field-names (spec ...)))))\n    ((_ name (parent p) (fields spec ...))\n     (define name (make-jolt-record-type 'name #f #f 'p\n                                         (jolt-record-field-names (spec ...)))))\n    ((_ (name ctor pred) (nongenerative uid))\n     (define name (make-jolt-record-type 'name 'ctor 'pred #f '())))\n    ((_ name (nongenerative uid))\n     (define name (make-jolt-record-type 'name #f #f #f '())))\n    ((_ name (protocol p) rest ...)\n     (error 'define-record-type \"protocol clauses are unsupported on the gambit target\" 'name))))\n\n;; ============================================================================\n;; R6RS hashtable API over Gambit tables.\nzsh:1: no matches found: host/gambit/compat*.ss\n*** ERROR -- Unbound variable: #:jolt-fiber\n    ;; The same frame ldr-with-file-vars gives a file and the loader gives a\n    ;; compiled namespace, from the one definition of which vars that is — this\n    ;; site listed two of the three by hand, so a (set! *unchecked-math* true)\n    ;; inside a load-string escaped into the caller and changed what its later\n    ;; arithmetic compiled to. It scopes through jolt-with-ns-load-vars rather\n    ;; than a hand-rolled (dynamic-wind push! body pop!): a throw mid-load must\n    ;; still unwind the frame, and so must a PARK — dyn-binding.ss documents why\n    ;; the winder shape pushes a second frame when a fiber resumes inside it.\n    (jolt-with-ns-load-vars\n      (lambda ()\n        (dyn-with-frame (cond ((not ls-file-cells) '())\n                              (path (list (cons (car (car ls-file-cells)) path)\n                                          (cons (car (cadr ls-file-cells))\n                                                (if named? (cadr source) (ls-file-name path)))))\n                              (else ls-file-cells))\n          (lambda ()\n            (parameterize ((rdr-source-file path) (jolt-load-wrap #f))\n              ;; rdr-read-top, not rdr-read-form: a stray close delimiter is\n              ;; \"Unmatched delimiter\", raised when the read reaches it, after the\n              ;; forms before it have run (Compiler.load). rdr-read-form hands it\n              ;; back unconsumed, and the loop took that for the end of input.\n              ;; pos is the reader's (line . col) at i, kept only for a wrap.\n              (let loop ((i 0) (result jolt-nil) (pos '(1 . 1)))\n                (if (>= i end)\n                    result\n                    (let* ((k (if w (ce-skip-ws s i end) i))\n                           (pos (if w (ce-advance s i k (car pos) (cdr pos)) pos)))\n                      (let-values (((form j) (rdr-read-top s k end)))\n                        (if (> j k)\n                            (loop j\n                                  (if (rdr-eof? form)\n                                      result\n                                      ;; data readers run at the read, outside the wrap\n                                      (let ((form (if drl (ldr-apply-readers form) form)))\n                                        (jolt-load-run-form w pos\n                                          (lambda ()\n                                            (jolt-compile-eval-form form (chez-current-ns))))))\n                                  (if w (ce-advance s k j (car pos) (cdr pos)) pos))\n5:;; shim macros from prelude-shims.ss (define-record-type, fx aliases,\n25:(##include \"prelude-shims.ss\")\n36:(##include \"hasheq.ss\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,245p' stdlib/jolt/ffi.clj; rg -n 'def-var\"'! \"jolt.ffi\"'\"' host/gambit/host-ffi.ss | tail -27; rg -n 'declare.*(record|unsafe)|jolt-identity-hashed' host/gambit/hasheq.ss; rg -n 'make-.*record|pvec' host/gambit/eval-test.ss | head -20; cat test/gambit/yin-repl-session.sh; rg -n 'save|index-store|manifest' test/gambit/yin* | head -60\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,245p' stdlib/jolt/ffi.clj; rg -n 'def-var\"'! \"jolt.ffi\"'\"' host/gambit/host-ffi.ss | tail -27; rg -n 'declare.*(record|unsafe)|jolt-identity-hashed' host/gambit/hasheq.ss; rg -n 'make-.*record|pvec' host/gambit/eval-test.ss | head -20; cat test/gambit/yin-repl-session.sh; rg -n 'save|index-store|manifest' test/gambit/yin* | head -60\"","aggregated_output":"  as \\\"\\\": a nil foreign type (read/write/sizeof), a nil name to loaded?, and a\n  nil value to write-bytes, whose destination is the caller's own buffer so\n  there is no pointer that could carry absence. (load-library nil) keeps its\n  documented meaning — no name at all, the process's own symbols — which is an\n  answer rather than a missing one.\n\n      (let [buf (ffi/alloc 65536)\n            frame (byte-array total)]\n        (loop [off 0]\n          (when (< off total)\n            (let [n (recv fd buf 65536 0)]\n              (ffi/read-into! buf :byte frame 0 off n)   ; no per-chunk array\n              (recur (+ off n))))))\n\n  foreign-fn lowers a compile-time-typed signature to a real Chez\n  foreign-procedure (cfn is the same macro under babashka.ffi's name). Its\n  optional trailing map accepts :blocking and :capture-native-error literal\n  Booleans; capture returns [native-result error-code] atomically and requires\n  a non-void scalar result. foreign-callable is the inverse — it wraps a jolt fn\n  as a C-callable function pointer so C can call back into jolt (e.g. GTK signal\n  handlers); free-callable releases it, and `callback` is the arena-owned form\n  that needs no explicit release. pointer-fn calls the other way through a\n  pointer: given a signature it answers a fn that takes a C function pointer\n  first, for a function a library exposes only as a struct's callback slot.\n\n  BABASHKA.FFI COMPATIBILITY. This namespace is a name-for-name, semantics-for-\n  semantics match of babashka.ffi wherever one substrate can match the other, so\n  a shim in either direction is a namespace alias plus a short list of gaps.\n  Matching: the arena constructors and every arena-taking function, alloc/free,\n  read/write (INCLUDING the argument order — the offset is last), sizeof,\n  alignof, place, copy, clone, size, address, segment, slice, reinterpret,\n  pointer?, null, null?, ptr->string, string->ptr, read-array, write-array,\n  find-symbol (with or without a library), load-library, load-system-library,\n  cfn, defcfn, callback, byte-buffer, with-open, both forms of the :& variadic\n  marker, [:union ...] layouts, and the type keywords with :bool included.\n\n  Where the two differ, they differ because the substrate does:\n\n    - A jolt pointer is a raw ADDRESS (an integer), not a sized MemorySegment.\n      So read and write do not bounds-check, and a zero-size pointer is not a\n      thing jolt can refuse. size answers the size jolt was TOLD — by an arena\n      allocation, segment or reinterpret — and 0 for everything else, so copy\n      and clone still work without an explicit count on memory jolt handed out.\n      pointer? answers true for any non-negative integer, because that is all a\n      pointer is here.\n    - cfn/foreign-fn is a MACRO: Chez's foreign-procedure needs its types at\n421:(def-var! \"jolt.ffi\" \"defining-libraries\" joltffi-defining-libraries)\n422:(def-var! \"jolt.ffi\" \"alloc\" joltffi-alloc)\n423:(def-var! \"jolt.ffi\" \"free\" joltffi-host-free)\n424:(def-var! \"jolt.ffi\" \"__alloc\" joltffi-alloc)\n425:(def-var! \"jolt.ffi\" \"__free\" joltffi-host-free)\n426:(def-var! \"jolt.ffi\" \"__calloc\" joltffi-calloc)\n427:(def-var! \"jolt.ffi\" \"read\" joltffi-read-fn)\n428:(def-var! \"jolt.ffi\" \"write\" joltffi-write-fn)\n429:(def-var! \"jolt.ffi\" \"__read\" joltffi-read-fn)\n430:(def-var! \"jolt.ffi\" \"__write\" joltffi-write-fn)\n431:(def-var! \"jolt.ffi\" \"copy\" joltffi-copy)\n432:(def-var! \"jolt.ffi\" \"__copy\" joltffi-copy)\n433:(def-var! \"jolt.ffi\" \"sizeof\" (lambda (ty) (joltffi-sizeof-chez (joltffi-type->chez ty))))\n434:(def-var! \"jolt.ffi\" \"__sizeof\" (lambda (ty) (joltffi-sizeof-chez (joltffi-type->chez ty))))\n435:(def-var! \"jolt.ffi\" \"__size\" joltffi-recorded-size)\n436:(def-var! \"jolt.ffi\" \"__remember-size!\" joltffi-remember-size!)\n437:(def-var! \"jolt.ffi\" \"__forget-sizes!\" joltffi-forget-sizes!)\n438:(def-var! \"jolt.ffi\" \"read-bytes\" joltffi-read-bytes)\n439:(def-var! \"jolt.ffi\" \"write-bytes\" joltffi-write-bytes)\n440:(def-var! \"jolt.ffi\" \"__read-bytes\" joltffi-read-bytes)\n441:(def-var! \"jolt.ffi\" \"__write-bytes\" joltffi-write-bytes)\n442:(def-var! \"jolt.ffi\" \"null?\" (lambda (p) (if (joltffi-null? p) #t #f)))\n443:(def-var! \"jolt.ffi\" \"null\" joltffi-null)\n444:(def-var! \"jolt.ffi\" \"ptr->string\" joltffi-ptr->string)\n445:(def-var! \"jolt.ffi\" \"string->ptr\" joltffi-string->ptr)\n446:(def-var! \"jolt.ffi\" \"__string->ptr\" joltffi-string->ptr)\n447:(def-var! \"jolt.ffi\" \"__utf8-length\" joltffi-utf8-length)\n536:    ((jolt-identity-hashed? x) (jolt-identity-hasheq x))\n553:(define (jolt-identity-hashed? x)\n#!/bin/sh\n# Drive the upstream Yin entry point. A shell exit status alone never passes.\nset -eu\n\ngsi=$1\nyin_root=$2\nlauncher=${3:-host/gambit/yin-repl-main.ss}\ntranscript=$(mktemp)\ntrap 'rm -f \"$transcript\"' EXIT\n\nstatus=0\nsh host/gambit/ffi/watchdog.sh 2400 \"$gsi\" \"$launcher\" \\\n  \"$yin_root\" --no-state --index-store mem >\"$transcript\" <<'FORMS' || status=$?\n(+ 1 2)\n((fn [x] (* x x)) 7)\n(def p1c-score 100)\n(+ p1c-score 1)\n(/ 1 0)\n(lang :yang/python)\n(require 'jolt.ffi)\n(jolt.ffi/sizeof :int32)\n(require 'dao.jing.mem)\n(dao.jing.mem/materialize-sha256 {:witness 1})\n(+ 21 22)\n(quit)\nFORMS\ncat \"$transcript\"\nif [ \"$status\" -ne 0 ]; then\n  echo \"gambityinrepl: a complete Yin session was not observed (status $status)\" >&2\n  exit 1\nfi\n\n# Each line must follow the previous one, with prompts on the actual replies.\nawk '\n  /^yin> 3$/ && step == 0 { step++; next }\n  /^yin> 49$/ && step == 1 { step++; next }\n  /^yin> 100$/ && step == 2 { step++; next }\n  /^yin> 101$/ && step == 3 { step++; next }\n  /^yin> Error: .*[Dd]ivid(e|ed) by zero/ && step == 4 { step++; next }\n  /^yin> Error: unavailable-parser: Yin REPL language :yang\\/python/ && step == 5 { step++; next }\n  /^yin> \\047jolt[.]ffi$/ && step == 6 { step++; next }\n  /^yin> 4$/ && step == 7 { step++; next }\n  /^yin> \\047dao[.]jing[.]mem$/ && step == 8 { step++; next }\n  /^yin> Error: .*blocking ffi is unsupported on the gambit target/ && step == 9 { step++; next }\n  /^yin> 43$/ && step == 10 { step++; next }\n  /^yin> Bye$/ && step == 11 { step++; next }\n  /^yin> / { unexpected = 1 }\n  END { exit !(step == 12 && !unexpected) }\n' \"$transcript\" || {\n  echo \"gambityinrepl: the Yin session did not produce the expected replies\" >&2\n  exit 1\n}\necho \"gambityinrepl: PASS — Yin state, evaluation error, frontend refusal, FFI, blocking refusal, and clean quit\"\ntest/gambit/yin-repl-session.sh:13:  \"$yin_root\" --no-state --index-store mem >\"$transcript\" <<'FORMS' || status=$?\ntest/gambit/yin-dht-probe.sh:25:    --no-state --index-store \"$@\" >\"$run/$name.stdout\" 2>\"$run/$name.stderr\" || status=$?\n","exit_code":0,"status":"completed"}}
