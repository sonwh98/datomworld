cs! \"RT\" (list (cons \"REQUIRE_LOCK\" rt-require-lock)))\nhost/gambit/host-statics.ss:248:(register-class-statics! \"clojure.lang.RT\" (list (cons \"REQUIRE_LOCK\" rt-require-lock)))\nhost/gambit/host-statics.ss:297:(register-class-statics! \"System\"\nhost/gambit/host-statics.ss:300:(register-class-statics! \"java.util.Arrays\"\n(def unsupported-host-text\n  \"The refusal for a durable directory on a host build that cannot open\n   files.  Refusing is the contract: a build without a filesystem is never\n   answered with an in-memory store its caller did not choose.\"\n  (str \"a durable store directory is not supported on this host: opening \"\n       \"the content log needs a filesystem, and this build has none; use \"\n       \"an in-memory store, or run on a host with file support (the JVM, \"\n       \"Node, or Dart)\"))\n\n\n(defn host-file-support\n  \"True when this build can open a file-backed store: the JVM, Node, and\n   Dart can; a CLJS build without `js/require` cannot.\"\n  []\n  #?(:cljd true\n     :cljs (exists? js/require)\n     :clj true))\n\n\n(defn- without-trailing-separator\n  \"The directory path with any trailing `/` removed, so the content log's\n   path is joined exactly once.  A path of only separators names the root,\n   which is preserved.\"\n  [dir]\n  (loop [s dir]\n    (if (and (pos? (count s)) (= \"/\" (subs s (dec (count s)))))\n      (recur (subs s 0 (dec (count s))))\n      s)))\n\n\n(defn content-path\n  \"The content log's own path inside the store directory:\n   `<dir>/content.jing`.\"\n  [dir]\n  (let [base (without-trailing-separator dir)]\n    (if (str/blank? base)\n      (str \"/\" content-name)\n      (str base \"/\" content-name))))\n\n\n(defn- error-text\n  \"The host error's own message, for the tail of a refusal.\"\n  [e]\n  #?(:cljd (str e)\n     :clj (or (ex-message e) (str e))\n     :cljs (or (ex-message e) (str e))))\n\n\n(defn- dir-refusal\n  \"Why `dir` cannot hold the durable content log, or nil when it can: a\n   path occupied by something that is not a directory, a directory this\n   process cannot write, or a directory that cannot be created.  Nothing\n   is opened here — the content log itself is opened later, and its open\n   failure is refused with its own reason.\"\n  [dir]\n  #?(:cljd (let [d (dart-io/Directory. dir)\n                 f (dart-io/File. dir)]\n             (cond\n               (.existsSync d) nil\n               (.existsSync f) (str dir \" is not a directory\")\n               :else (try (.createSync d .recursive true)\n                          nil\n                          (catch Object e\n                            (str \"cannot create \" dir \": \" (error-text e))))))\n     :clj (let [f (java.io.File. dir)]\n            (cond\n              (and (.exists f) (not (.isDirectory f)))\n              (str dir \" is not a directory\")\n\n              (and (.isDirectory f) (not (.canWrite f)))\n              (str dir \" is not writable\")\n\n              :else\n              (try (when (and (not (.isDirectory f)) (not (.mkdirs f)))\n                     (str \"cannot create \" dir))\n                   (catch Exception e\n                     (str \"cannot create \" dir \": \" (error-text e))))))\n     :cljs (let [fs (js/require \"fs\")]\n             (if (.existsSync fs dir)\n               (when-not (.isDirectory (.statSync fs dir))\n                 (str dir \" is not a directory\"))\n               (try (.mkdirSync fs dir #js {:recursive true})\n                    nil\n                    (catch :default e\n                      (str \"cannot create \" dir \": \" (error-text e))))))))\n\n#!/usr/bin/env python3\n\"\"\"Emit typed C calls and Scheme registry from the reviewed stage-1 projection.\n\nshapes.json records the source inventory and finite ABI fixture additions.\nNo runtime C compilation, libffi, or ABI-erasing dispatch is used.\n\"\"\"\nimport json\nfrom pathlib import Path\nroot = Path(__file__).resolve().parent\nshapes = json.loads((root / 'shapes.json').read_text())['shapes']\ntypes = {\n    'int': ('int', 'int'), 'integer-8': ('int8_t', 'int8'),\n    'unsigned-8': ('uint8_t', 'unsigned-int8'),\n    'integer-16': ('int16_t', 'int16'), 'unsigned-16': ('uint16_t', 'unsigned-int16'),\n    'integer-32': ('int32_t', 'int32'), 'unsigned-32': ('uint32_t', 'unsigned-int32'),\n    'integer-64': ('int64_t', 'int64'), 'unsigned-64': ('uint64_t', 'unsigned-int64'),\n    'size_t': ('size_t', 'size_t'), 'ssize_t': ('ssize_t', 'ssize_t'),\n    'unsigned-long': ('unsigned long', 'unsigned-long'),\n    'void*': ('void *', 'unsigned-long'), 'void': ('void', 'void'),\n    'string': ('char *', 'UTF-8-string'), 'float': ('float', 'float32'),\n    'double': ('double', 'float64'),\n}\nc = [';; GENERATED by generate-shims.py; edit shapes.json and regenerate.', '(c-declare #<<SHIMS']\nscheme = []; entries = []; seen = set()\nfor i, shape in enumerate(shapes):\n    args, ret, cap, var = (shape[k] for k in ('args', 'ret', 'capture', 'varargs'))\n    key = (tuple(args), ret, cap, var)\n    assert key not in seen, key\n    seen.add(key)\n    assert var is None or 0 < var <= len(args)\n    name = f'joltffi_generated_{i}'\n    params = ['unsigned long fn'] + (['unsigned long errout'] if cap else [])\n    params += [f'{(\"unsigned long\" if t == \"void*\" else types[t][0])} a{n}' for n,t in enumerate(args)]\n    target_types = [types[t][0] for t in args]\n    if var is not None: target_types = target_types[:var] + ['...']\n    signature = ', '.join(target_types) or 'void'\n    result = types[ret][0]\n    wire_result = 'unsigned long' if ret == 'void*' else result\n    call = 'f(' + ', '.join(('(void *)' if t == 'void*' else '') + f'a{n}' for n,t in enumerate(args)) + ')'\n    c += [f'/* {shape[\"id\"]}: variadic boundary {var}, capture {cap} */',\n          f'static {wire_result} {name}({\", \".join(params)})', '{',\n          f'  {result} (*f)({signature}) = ({result} (*)({signature}))fn;']\n    if ret == 'void': c += [f'  {call};']\n    else: c += [f'  {result} r = {call};']\n    if cap:\n        c += ['  int saved = errno;', '  *(int *)errout = saved;',\n              '#ifdef JOLTFFI_CAPTURE_TEST', '  errno = 4242; /* after capture, before Gambit conversion */', '#endif']\n    if ret != 'void': c += [('  return (unsigned long)r;' if ret == 'void*' else '  return r;')]\n    c += ['}']\n    scargs = ['fn'] + (['errout'] if cap else []) + [f'a{n}' for n in range(len(args))]\n    ctypes = ['unsigned-long'] * (2 if cap else 1) + [types[t][1] for t in args]\n    scheme += [f'(define (joltffi-shim-{i} {\" \".join(scargs)})',\n               f'  ((c-lambda ({\" \".join(ctypes)}) {types[ret][1]} \"{name}\") {\" \".join(scargs)}))']\n    entries += [f'    (list \\'({\" \".join(args)}) \\'{ret} {\"#t\" if cap else \"#f\"} {\"#f\" if var is None else var} joltffi-shim-{i})']\nc += ['SHIMS', ')']\noutput = '\\n'.join(c + scheme + ['(define joltffi-shims', '  (list'] + entries + ['))', '''(define (joltffi-shim-lookup args ret capture? variadic)\n  (let loop ((es joltffi-shims))\n    (if (null? es) #f\n        (let ((e (car es)))\n          (if (and (equal? args (car e)) (eq? ret (cadr e))\n                   (eq? capture? (caddr e)) (equal? variadic (cadddr e)))\n              (car (cddddr e))\n              (loop (cdr es)))))))''']) + '\\n'\nimport sys\nif '--check' in sys.argv:\n    if (root / 'generated-shims.scm').read_text() != output:\n        raise SystemExit('generated-shims.scm is stale')\nelse:\n    (root / 'generated-shims.scm').write_text(output)\n#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/../../..\"\nLC_ALL=C\nexport LC_ALL\ndigests() {\n  shasum -a 256 host/gambit/ffi/joltffi-bridge.scm \\\n    host/gambit/ffi/generated-shims.scm host/gambit/ffi/shapes.json \\\n    host/gambit/ffi/generate-shims.py host/gambit/ffi/joltffi-fixture.c \\\n    host/gambit/ffi/joltffi-fixture2.c host/gambit/ffi/joltffi-dep.c \\\n    host/gambit/ffi/joltffi-unloadable.c host/gambit/ffi/toolchain.py \\\n    host/gambit/ffi/record-toolchain.sh host/gambit/ffi/verify-toolchain.sh \\\n    host/gambit/ffi/verify-digests.sh host/gambit/ffi/make-digests.sh\n}\ncase ${1:-} in\n  \"\") digests > host/gambit/ffi/DIGESTS.txt ;;\n  --check)\n    shasum -a 256 -c host/gambit/ffi/DIGESTS.txt\n    if [ \"$(digests)\" != \"$(cat host/gambit/ffi/DIGESTS.txt)\" ]; then\n      echo \"gambitffi: pinned source catalog is stale; explicitly update the source digests\" >&2\n      exit 1\n    fi\n    ;;\n  *) echo \"usage: make-digests.sh [--check]\" >&2; exit 2 ;;\nesac\ntotal 344\ndrwxr-xr-x@  3 sto  staff      96 Nov 21 21:17 .\ndrwxr-xr-x@ 10 sto  staff     320 Nov 21 21:15 ..\n-rw-r--r--@  1 sto  staff  172424 Nov 21 21:17 irregex.scm\n","exit_code":0,"status":"completed"}}
