{"type":"item.completed","item":{"id":"item_98","type":"command_execution","command":"/bin/zsh -lc \"head -91 host/gambit/ffi/joltffi-bridge.scm; sed -n '2195,2215p' Makefile; sed -n '12,36p' stdlib/jolt/scheme.clj; wc -c build/p1f/*boot.path; tail -9 build/p1f/acceptance-boot.log; rg -n 'FAIL|PASS|Error|Exception' build/p1f/matrix-acceptance.log | tail -12\"","aggregated_output":";; Ahead-of-time native bridge for the bounded Gambit FFI tier.\n;; generated-shims.scm supplies typed calls from shapes.json (including the\n;; variadic boundary). Blocking, callables, aggregates, runtime signatures and\n;; pinning remain refused in the adapter/compiler. See README.md for coverage.\n;;\n;; Capture cells are allocated per invocation before entering C. Each typed\n;; shim saves errno immediately after its target, before conversion or cleanup,\n;; then writes the caller-owned cell. No last-errno global/TLS cell is used.\n;; The test build injects a clobber AFTER that save; the wrong-order control\n;; saves AFTER its clobber. Neither control qualifies callbacks or blocking.\n;;\n;; Native pointers cross as exact integers through unsigned-long. Static\n;; assertions enforce LP64. Only the provisioned macOS arm64 leg is qualified.\n;; Bulk copies borrow a u8vector body for one non-allocating synchronous C call;\n;; they retain no Scheme address and are never collect-safe.\n\n(c-declare #<<JOLTFFI-C-BEGIN\n\n#include <errno.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <dlfcn.h>\n#include <stdarg.h>\n#include <sys/types.h>\n_Static_assert(sizeof(void*) == 8 && sizeof(long) == 8 && sizeof(int) == 4, \"stage-1 requires LP64\");\n\nstatic int joltffi_capture_test_enabled(void)\n{\n#ifdef JOLTFFI_CAPTURE_TEST\n  return 1;\n#else\n  return 0;\n#endif\n}\nstatic char *joltffi_c_os(void)\n{\n#ifdef __APPLE__\n  return \"darwin\";\n#else\n  return \"linux\";\n#endif\n}\n\n/* ---- loader flags (compile-time platform, as the Chez loader probes them) ---\n   RTLD_NOW on every POSIX host; RTLD_LOCAL on darwin is 0x4, on Linux 0 (the\n   default, matching Chez's ffi-rtld-flags table in host/chez/java/ffi.ss). */\n#define JOLTFFI_RTLD_NOW   2\n#ifdef __APPLE__\n#define JOLTFFI_RTLD_LOCAL 0x4\n#else\n#define JOLTFFI_RTLD_LOCAL 0\n#endif\n\n/* ---- loader ----------------------------------------------------------------- */\nstatic unsigned long joltffi_c_dlopen (const char *path)\n{ return ___CAST(unsigned long, dlopen (path, JOLTFFI_RTLD_NOW | JOLTFFI_RTLD_LOCAL)); }\n\nstatic unsigned long joltffi_c_dlsym (unsigned long h, const char *name)\n{ return ___CAST(unsigned long, dlsym (___CAST(void *, h), name)); }\n\n/* process-global resolution (RTLD_DEFAULT): the process's own symbols plus\n   RTLD_GLOBAL objects. RTLD_LOCAL loaded natives are deliberately NOT visible\n   here — the scoped-before-global isolation guarantee. */\nstatic unsigned long joltffi_c_dlsym_global (const char *name)\n{ return ___CAST(unsigned long, dlsym (RTLD_DEFAULT, name)); }\n\nstatic unsigned long joltffi_c_dlopen_global (const char *path)\n{ return ___CAST(unsigned long, dlopen (path, JOLTFFI_RTLD_NOW)); }   /* sa-load-shared-object of #f */\n\nstatic char *joltffi_c_dlerror (void)\n{ return ___CAST(char *, dlerror ()); }\n\nstatic int joltffi_c_dlclose (unsigned long h)\n{ return dlclose (___CAST(void *, h)); }\n\n/* ---- memory ----------------------------------------------------------------- */\nstatic unsigned long joltffi_c_malloc (unsigned long n)\n{ return ___CAST(unsigned long, malloc (___CAST(size_t, n))); }\n\nstatic void joltffi_c_free (unsigned long p)\n{ free (___CAST(void *, p)); }\n\nstatic void joltffi_c_zero (unsigned long p, unsigned long n)\n{ memset (___CAST(void *, p), 0, ___CAST(size_t, n)); }\n\n/* foreign -> bytevector. Returns 0 ok, -1 bad count. */\nstatic int joltffi_c_bytes_to_bv (___SCMOBJ bv, unsigned long src, unsigned long n)\n{\n  ___SCMOBJ ___temp; /* the subtype test macros need a temp cell */\n  if (___HAS_TAG_AND_IS_NOT_DOUBLE (bv, ___tSUBTYPED, ___TB) && ___TESTSUBTYPE (bv, ___sU8VECTOR))\ngambitffi-abi: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tJOLT_FFI_ERRNO_ACCESSOR=\"$(GAMBIT-FFI-ERRNO-ACCESSOR)\" sh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-abi.ss && \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 180 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-public.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n\n$(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1: $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1\n\t@mkdir -p $(GAMBIT-FFI-BUILD)/capture-test\n\t@rm -f $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o[0-9]*\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/capture-test/\n\tcd $(GAMBIT-FFI-BUILD)/capture-test && sh ../../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -dynamic -keep-temp -cc-options -DJOLTFFI_CAPTURE_TEST joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1 > $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1.sha256\n\ngambitffi-errno-check: gambitffi-bridge $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-errno.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n;;\n;; Two caveats. Code using this namespace is HOST-SPECIFIC by design — tied to\n;; the Chez runtime and its primitives, unlike everything else in the stdlib.\n;; And names resolve at RUN time, so a tree-shaken binary only finds what the\n;; kept runtime still carries: a shaken-out binding is a catchable\n;; \"no top-level Scheme binding\" error, never a silent nil.\n(ns jolt.scheme)\n\n(defn proc\n  \"The top-level Scheme procedure named by scheme-name (a string), as a\n  callable value. Resolved now; throws when the name is unbound.\"\n  [scheme-name]\n  (jolt.host/scheme-proc scheme-name))\n\n(defn call\n  \"Resolve the top-level Scheme procedure named by scheme-name and apply it\n  to args. Values cross raw — see the namespace docs.\"\n  [scheme-name & args]\n  (apply (jolt.host/scheme-proc scheme-name) args))\n\n(defn eval-string\n  \"Evaluate s as Scheme text — read with the SCHEME reader, not jolt's — and\n  return the last form's value. Definitions persist in the interaction\n  environment.\"\n  [s]\n      75 build/p1f/boot.path\n       0 build/p1f/final-boot.path\n      75 build/p1f/platform-only-boot.path\n     150 total\n475:  ok     (try (jolt.ffi/write-bytes 0 nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: write-bytes value must be a string, got nil\"\n476:  ok     (try (jolt.ffi/load-library [nil]) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: library candidate must be a string, got nil\"\n477:  ok     (try (jolt.ffi/load-system-library nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: load-system-library name must be a string, got nil\"\n478:  ok     (try (jolt.ffi/system-library-candidates nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: system-library-candidates name must be a string, got nil\"\n479:  ok     (try (jolt.ffi/loaded? nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: loaded? name must be a string, got nil\"\n480:  ok     (try (jolt.ffi/find-symbol nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: symbol must be a string, got nil\"\n481:  ok     (try (jolt.ffi/find-symbol (jolt.ffi/load-library \"build/gambit-ffi/libjoltffi-fixture.dylib\") nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: symbol must be a string, got nil\"\n482:  ok     (try (jolt.ffi/defining-libraries nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: symbol must be a string, got nil\"\n483:  ok     (try (jolt.ffi/load-failure-note [nil]) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: load-failure-note candidate must be a string, got nil\"\n491:  ok     (try (.exists (java.io.File. \"some/path\")) (catch UnsupportedOperationException e (boolean (re-find #\"blocking ffi is unsupported\" (ex-message e))))) => true\n493:gambitffi-public: PASS — :gambit compiler + native gsi\n628:kernel-test: PASS — booted kernel + natives verified on native gsi\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_99","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np = Path('host/gambit/ffi/shapes.json')\ndata = json.loads(p.read_text())\ndata['source'] = data['source'].replace('UDP send/receive and guarded datagram close shapes', 'UDP send/receive shapes')\ndata['shapes'] = [s for s in data['shapes'] if s['id'] \"'!= '\"'p1f-datagram-close']\np.write_text(json.dumps(data, indent=2) + '\\\\n')\np = Path('host/gambit/ffi/joltffi-bridge.scm')\ns = p.read_text().replace('#include <stdint.h>', '#include <stdint.h>\\\\n#include <stdatomic.h>\\\\n#include <pthread.h>').replace('#include <sys/types.h>', '#include <sys/types.h>\\\\n#include <unistd.h>')\nat = s.index('/* ---- memory')\ns = s[:at] + '''/* Datagram cleanup stays off the Gambit processor. On Darwin a content\n   filter can delay close even with SO_LINGER disabled. The native worker\n   owns only a C allocation and an fd, and never enters the Scheme runtime. */\nstruct joltffi_close_job {\n  atomic_int refs;\n  atomic_int done;\n  int fd;\n  int result;\n  int error;\n};\n\nstatic void joltffi_close_job_release(unsigned long address)\n{\n  struct joltffi_close_job *job = (struct joltffi_close_job *)address;\n  if (atomic_fetch_sub_explicit(&job->refs, 1, memory_order_acq_rel) == 1)\n    free(job);\n}\n\nstatic void *joltffi_close_worker(void *arg)\n{\n  struct joltffi_close_job *job = arg;\n  errno = 0;\n  int result = close(job->fd);\n  int error = errno;\n  job->result = result;\n  job->error = error;\n  atomic_store_explicit(&job->done, 1, memory_order_release);\n  joltffi_close_job_release((unsigned long)job);\n  return NULL;\n}\n\nstatic unsigned long joltffi_start_datagram_close(int fd)\n{\n  struct joltffi_close_job *job = malloc(sizeof *job);\n  if (job == NULL)\n    return 0;\n  atomic_init(&job->refs, 2);\n  atomic_init(&job->done, 0);\n  job->fd = fd;\n\n  pthread_attr_t attrs;\n  pthread_t worker;\n  int error = pthread_attr_init(&attrs);\n  if (error == 0) {\n    error = pthread_attr_setdetachstate(&attrs, PTHREAD_CREATE_DETACHED);\n    if (error == 0)\n      error = pthread_create(&worker, &attrs, joltffi_close_worker, job);\n    pthread_attr_destroy(&attrs);\n  }\n  if (error \"'!= 0) {\n    job->result = -1;\n    job->error = error;\n    atomic_store_explicit(&job->done, 1, memory_order_release);\n    joltffi_close_job_release((unsigned long)job);\n  }\n  return (unsigned long)job;\n}\n\nstatic int64_t joltffi_poll_datagram_close(unsigned long address)\n{\n  struct joltffi_close_job *job = (struct joltffi_close_job *)address;\n  if (!atomic_load_explicit(&job->done, memory_order_acquire))\n    return INT64_MIN;\n  return job->result * INT64_C(4294967296) + job->error;\n}\n\n'\"''' + s[at:]\nat = s.index(';; ---- loader wrappers')\ns = s[:at] + ''';; The result packs close's signed int and the worker's captured errno.\n;; Yield using Gambit's scheduler while the worker holds its own reference.\n(define (joltffi-await-datagram-close fd)\n  (let* ((start (c-lambda (int) unsigned-long \\\"joltffi_start_datagram_close\\\"))\n         (poll (c-lambda (unsigned-long) int64 \\\"joltffi_poll_datagram_close\\\"))\n         (release (c-lambda (unsigned-long) void \\\"joltffi_close_job_release\\\"))\n         (job (start fd)))\n    (if (= job 0)\n        (error \\\"jolt.ffi: could not allocate datagram close job\\\")\n        (dynamic-wind\n          (lambda () #f)\n          (lambda ()\n            (let loop ()\n              (let ((result (poll job)))\n                (if (= result -9223372036854775808)\n                    (begin (thread-sleep\"'! 0.001) (loop))\n                    result))))\n          (lambda () (release job))))))\n\n'\"''' + s[at:]\np.write_text(s)\np = Path('stdlib/jolt/socket/native.clj')\ns = p.read_text()\nstart = s.index('    #?(:gambit (do\\\\n                 (declare c-close)')\nend = s.index('    ;; Linux accepts', start)\ns = s[:start] + '''    #?(:gambit (ffi/defcfn \"'^:private c-close-blocking \"close\" [:int] :int\n                  {:blocking true :capture-native-error true})\n       :default (ffi/defcfn c-close \"close\" [:int] :int\n                  {:blocking true :capture-native-error true}))\n'\"''' + s[end:]\nstart = s.index('#?(:gambit\\\\n   (defn c-close')\nend = s.index('(defn- named-address', start)\ns = s[:start] + '''#?(:gambit\n   (do\n     (def \"'^:private await-datagram-close\n       (delay ((requiring-resolve '\"'jolt.scheme/proc) \\\"joltffi-await-datagram-close\\\")))\n\n     (defn c-close [fd]\n       ;; Only the owned Internet datagram path uses the native cleanup\n       ;; worker. A content filter can delay close even without SO_LINGER.\n       (let [[sa lenp] (alloc-sockaddr)\n             opt (ffi/alloc 4)]\n         (try\n           (let [[name-result _] (c-getsockname fd sa lenp)]\n             (if (and (zero? name-result)\n                      (contains? #{af-inet af-inet6} (sockaddr-family sa))\n                      (do (ffi/write lenp :int 4)\n                          (let [[result _] (c-getsockopt fd sol-socket (if macos? 0x1008 3) opt lenp)]\n                            (and (zero? result) (= 2 (ffi/read opt :int))))))\n               (let [result ((force await-datagram-close) fd)]\n                 [(if (neg? result) -1 0) (bit-and result 0xffffffff)])\n               (c-close-blocking fd)))\n           (finally (ffi/free opt) (ffi/free lenp) (ffi/free sa)))))))\n\n''' + s[end:]\np.write_text(s)\np = Path('host/gambit/ffi/joltffi-fixture.c')\ns = p.read_text()\ns = s[:s.index('\\\\nint joltffi_fx_datagram_close')] + '\\\\n'\np.write_text(s)\np = Path('host/gambit/ffi/gambitffi-abi.ss')\ns = p.read_text()\ns = s.replace('      (close (sa-foreign-procedure-native-error posix () \\\"joltffi_fx_datagram_close\\\" (int) int))\\\\n','')\ns = s.replace('      (ebadf ((sa-foreign-procedure \\\"joltffi_fx_ebadf\\\" () int)))\\\\n      (einval', '      (einval')\ns = s.r