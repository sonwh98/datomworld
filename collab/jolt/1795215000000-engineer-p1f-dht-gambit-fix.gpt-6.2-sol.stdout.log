{"type":"item.completed","item":{"id":"item_128","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2478,2536p;2540,2585p' /Users/sto/workspace/datomworld/src/cljc/yin/repl.cljc; git status --short | tail -4; tail -6 build/p1f/matrix-verified.log; rg -n '\\\\bFAIL\\\\b|TIMEOUT|\"'^make:'\"' build/p1f/matrix-verified.log\"","aggregated_output":"           (str \"\\n\\nExpansion error:\\n\" (format-value error)))\n         (when (seq frontend-metadata)\n           (str \"\\n\\nCall sites:\\n\" (format-value frontend-metadata)))\n         \"\\n\\nEvents:\\n\" (format-value (second log)))))\n\n\n(defn- rebuild-session\n  \"Replace the VM, the expander, and their media, attachments, and\n   observers.  The value history is cleared with them: a closure in `*1`\n   names a code segment the old VM held, which the new one does not.  The\n   new expander holds only the standard forms.  A require still pending\n   on the old VM is dropped with it: its link pair is the session's, and\n   the new session answers from its own.\n\n   Over a durable store the code index is not the session's to drop: the\n   new indexer continues the old one's log, entity allocation, and\n   published manifest (`yin.repl.index/carry-over`), so a rebuild never\n   resets `t`.  Over the memory store it starts empty, as it always has.\"\n  [state vm-type]\n  (merge state\n         (cond-> (make-session vm-type (:output-stream state)\n                               (merge (selected-primitives (:frontends state)\n                                                           (:lang state))\n                                      (:extra-primitives state))\n                               (:shell-token state)\n                               (:index-store state)\n                               (:link-source state)\n                               (cond-> (:publication state)\n                                 (get-in state [:indexer :publication-media])\n                                 (assoc :media\n                                        (get-in state\n                                                [:indexer :publication-media])))\n                               (:host-modules state))\n           (store/durable? (:index-store state))\n           (update :indexer index/carry-over (:indexer state)))\n         {:vm-type vm-type\n          :ingress-loss? false\n          :last-value nil\n          :last-value-2 nil\n          :last-value-3 nil\n          :frontend-session nil\n          :pending-run nil}))\n\n\n(defn- configure-admission\n  \"Apply session configuration to the linker, retaining its live state.\"\n  [state admission]\n  (let [linker (link/reconfigure (:linker state) admission)]\n    (assoc state :admission admission :linker linker\n           :link-source (:source linker))))\n\n\n(defn- trust-command\n  [state command args]\n  (try\n    (let [p (first args)]\n      (when-not (and (= 1 (count args)) (string? p)\n                     (str/starts-with? p \"ed25519:\"))\n        (throw (ex-info \"Expected one ed25519:<64 hex> principal id\" {})))\n        (if (and (= command 'untrust)\n                 (contains? (:own (:link-source state)) p))\n          [state (str \"Own principal \" p \" is always trusted\")]\n          [(configure-admission\n             state (update admission :trusted\n                           (fn [trusted]\n                             ((if (= command 'trust) conj disj)\n                              (set trusted) p))))\n           (if (nil? (:admission (:link-source state)))\n             (str \"Recorded \" (if (= command 'trust) \"trust\" \"untrust\")\n                  \" for \" p \"; unused while admission is external\")\n             (str (if (= command 'trust) \"Trusted \" \"Untrusted \") p))])))\n    (catch #?(:cljd Object :clj Exception :cljs :default) e\n      [state (str \"Error: \" (ex-message e))])))\n\n\n(declare repl-state)\n\n\n(defn handle-command\n  \"Answer one shell command.  Unsupported arguments are answered as text, not\n   thrown, so a mistyped command cannot end a step.\"\n  [state form]\n  (let [[command & args] form]\n    (case command\n      vm (let [vm-type (first args)]\n           (if (contains? vm-constructors vm-type)\n             [(rebuild-session state vm-type)\n              (str \"Switched to \" (get vm-labels vm-type)\n                   (if (store/durable? (:index-store state))\n                     \" (VM store cleared; durable code index kept)\"\n                     \" (store cleared)\"))]\n             [state (str \"Error: Unknown Yin REPL VM type \" (pr-str vm-type)\n                         \"; supported: \"\n                         (pr-str (vec (keys vm-constructors))))]))\n      lang (let [lang (first args)]\n             (if (usable-binding (select-frontend (:frontends state) lang))\n               [(switch-lang state lang)\n                (str \"Switched to \" lang)]\n               [state (str \"Error: unavailable-parser: Yin REPL language \"\n                           (pr-str lang) \" is not in the frontend catalog; \"\n                           (installed-text (:frontends state)))]))\n      compile [state (render-compile-output\n                       state\n                       (compile-command-ast state (first args)))]\n      trust (trust-command state command args)\n M host/gambit/yin/jolt/gambit/yin.jolt\n M stdlib/jolt/socket/native.clj\n M test/gambit/fixtures/yin-dht-probe.jolt\n M test/gambit/yin-dht-probe.sh\n  ok     BLAKE3 known answer for 0 bytes\n  ok     BLAKE3 known answer for 64 bytes\n  ok     BLAKE3 known answer for 1024 bytes\n  ok     BLAKE3 known answer for 1025 bytes\n  ok     BLAKE3 known answer for 16384 bytes\ngambitsourceload: PASS — native source loading and compiler string emission\n","exit_code":1,"status":"failed"}}
