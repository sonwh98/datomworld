{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat host/gambit/yin/jolt/gambit/yin.jolt host/gambit/source-loader.ss test/gambit/yin-dht-probe.sh test/gambit/fixtures/yin-dht-probe.jolt'","aggregated_output":"(ns jolt.gambit.yin\n  \"The local-memory composition for the Gambit terminal.\"\n  (:require [dao.jing :as jing]\n            [jolt.ffi :as ffi]\n            [yin.repl.main :as main]\n            [yin.repl.store :as store]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n(defn- activate-ffi [registry]\n  (module/register-host-module\n    registry 'jolt.ffi\n    {'sizeof ffi/sizeof}\n    {'sizeof (vm/primitive-profile 'sizeof :pure [1] #{} :none)}))\n\n(defn- materialize-sha256 [value]\n  (jing/materialize! (store/open :mem) value {:algorithm :sha256}))\n\n(defn- activate-store [registry]\n  (module/register-host-module\n    registry 'dao.jing.mem\n    {'materialize-sha256 materialize-sha256}\n    {'materialize-sha256\n     (vm/primitive-profile 'materialize-sha256 :pure [1] #{} :none)}))\n\n(defn- open-memory [spec _opts]\n  {:index-store (store/open spec)\n   :engine-inputs {:host-modules {'jolt.ffi activate-ffi\n                                  'dao.jing.mem activate-store}}})\n\n(defn- parse-store [arg]\n  (let [spec (store/parse-arg arg)]\n    (when-not (= spec :mem)\n      (throw (ex-info \"The local Gambit session supports only --index-store mem\"\n                      {:store spec})))\n    spec))\n\n(defn -main [& args]\n  (main/main! args {:composition-spec? #{:mem}\n                    :parse-store-arg parse-store\n                    :open open-memory}))\n;; Opt-in native source namespace loading for embedded applications. Unlike the\n;; Chez loader, this only interprets source. It has no cache, FASL, AOT, runtime\n;; dependency discovery, or native-library discovery.\n\n(define (gambit-namespace-path name)\n  (let ((chars (string->list name)))\n    (let check ((rest chars) (need-name? #t))\n      (unless (cond\n                ((null? rest) (not need-name?))\n                ((char=? (car rest) #\\.) (and (not need-name?) (check (cdr rest) #t)))\n                ((or (char-alphabetic? (car rest)) (char-numeric? (car rest))\n                     (memv (car rest) '(#\\- #\\_)))\n                 (check (cdr rest) #f))\n                (else #f))\n        (throw-jvm 'IllegalArgumentException (string-append \"Invalid namespace: \" name))))\n    (list->string\n      (map (lambda (ch) (case ch ((#\\.) #\\/) ((#\\-) #\\_) (else ch))) chars))))\n\n;; Gambit's reader tags bracket-delimited lists. Raw Scheme in loaded\n;; Jolt libraries uses R6RS brackets as grouping delimiters.\n(define (gambit-source-scheme-form datum)\n  (define (read-list items)\n    (if (pair? items)\n        (cons (gambit-source-scheme-form (car items)) (read-list (cdr items)))\n        items))\n  (cond\n    ((pair? datum)\n     (case (car datum)\n       ((|[...]|) (read-list (cdr datum)))\n       ((endianness)\n        (unless (and (list? datum) (= (length datum) 2)\n                     (memq (cadr datum) '(big little)))\n          (error \"invalid endianness\" datum))\n        (list 'quote (cadr datum)))\n       (else (read-list datum))))\n    ((vector? datum) (vector-map gambit-source-scheme-form datum))\n    (else datum)))\n\n(define (gambit-source-scheme-eval text)\n  (let ((port (open-input-string (jolt-need-string text))))\n    (input-port-readtable-set! port\n      (readtable-sharing-allowed?-set (input-port-readtable port) #f))\n    (let loop ((last jolt-nil))\n      (let ((form (read port)))\n        (if (eof-object? form)\n            last\n            (loop (eval (gambit-source-scheme-form form))))))))\n\n;; Each root is (directory suffix ...), in classpath order. BOOTED names denote\n;; whole namespaces supplied by the embedding host and take precedence over\n;; files. A mere intern or :as-alias never satisfies a source dependency.\n(define (gambit-install-source-loader! roots booted)\n  (define loaded (make-table test: string=?))\n  (define (find-file name)\n    (let ((base (gambit-namespace-path name)))\n      (let find-root ((rest roots))\n        (and (pair? rest)\n             (let find-suffix ((suffixes (cdar rest)))\n               (if (null? suffixes)\n                   (find-root (cdr rest))\n                   (let ((file (string-append (caar rest) \"/\" base (car suffixes))))\n                     (if (and (file-exists? file) (eq? 'regular (file-type file)))\n                         file\n                         (find-suffix (cdr suffixes))))))))))\n  (define (load-namespace name force?)\n    (when force?\n      (throw-jvm 'UnsupportedOperationException\n                 \"namespace reload is unsupported on the gambit source loader\"))\n    (unless (member name booted)\n      (case (table-ref loaded name #f)\n        ((ready) #f)\n        ((loading)\n         (throw-jvm 'IllegalStateException (string-append \"Cyclic namespace load: \" name)))\n        ((failed)\n         (throw-jvm 'IllegalStateException (string-append \"Earlier namespace load failed: \" name)))\n        (else\n         (let ((file (find-file name)))\n           (unless file\n             (throw-jvm 'FileNotFoundException (string-append \"No source for namespace: \" name)))\n           (table-set! loaded name 'loading)\n           (when (getenv \"JOLT_TRACE_SOURCE\" #f)\n             (fprintf (current-error-port) \"[~as] load ~a\\n\" (inexact->exact (round (time->seconds (current-time)))) name)\n             (force-output (current-error-port)))\n           (guard (e (#t (table-set! loaded name 'failed) (raise e)))\n             (jolt-with-ns-bound\n               (lambda ()\n                 (jolt-eval-string (call-with-input-file file gambit-read-all) file)\n                 (unless (string=? name (chez-current-ns))\n                   (throw-jvm 'IllegalStateException\n                              (string-append file \": expected namespace \" name)))))\n             (when (getenv \"JOLT_TRACE_SOURCE\" #f)\n               (fprintf (current-error-port) \"[~as] ready ~a\\n\" (inexact->exact (round (time->seconds (current-time)))) name)\n               (force-output (current-error-port)))\n             (table-set! loaded name 'ready)))))))\n  (set-ns-load-target! load-namespace)\n  (set-ns-with-load-opts!\n    (lambda (flags proceed)\n      (unless (null? flags)\n        (throw-jvm 'UnsupportedOperationException\n                   (string-append \"require option is unsupported on the gambit source loader: :\"\n                                  (car flags))))\n      (proceed #f)))\n  (def-var! \"jolt.host\" \"scheme-eval-string\" gambit-source-scheme-eval)\n  (def-var! \"clojure.core\" \"require\" jolt-require)\n  (def-var! \"clojure.core\" \"use\" jolt-use)\n  load-namespace)\n#!/bin/sh\n# Capture the stock CLI and then probe each underlying path in a live Yin REPL.\n# Arguments are absolute paths. Build the bridge and compiled boot first.\nset -eu\n\ngsi=$1\ndatomworld=$2\nexport JOLT_GAMBIT_YIN_BOOT=$3\nexport JOLT_TRACE_SOURCE=1\nrepo=$(CDPATH='' cd -- \"$(dirname -- \"$0\")/../..\" && pwd)\ncd \"$repo\"\nmkdir -p build/p1e\nrun=$(mktemp -d \"$repo/build/p1e/run.XXXXXX\")\necho \"P1e receipts: $run\"\nmkdir \"$run/store\"\nexport JOLT_P1E_STORE=\"$run/store\"\n\nsession() {\n  name=$1\n  shift\n  status=0\n  started=$(date +%s)\n  sh \"$repo/host/gambit/ffi/watchdog.sh\" \"${P1E_TIMEOUT_SECONDS:-900}\" \\\n    \"$gsi\" \"$repo/host/gambit/yin-repl-native.ss\" \"$datomworld\" \\\n    --no-state --index-store \"$@\" >\"$run/$name.stdout\" 2>\"$run/$name.stderr\" || status=$?\n  echo \"$status\" >\"$run/$name.status\"\n  cat \"$run/$name.stdout\"\n  echo \"$name launcher exit $status ($(($(date +%s) - started))s)\"\n}\n\nsession stock \"dht:$JOLT_P1E_STORE\" <<'FORMS'\n(+ 20 22)\n(quit)\nFORMS\n\n# Only the entry composition is extended, inside a scratch source root. The\n# launcher, other host adapters, boot, and Datomworld source stay the same.\noverlay=\"$run/jolt\"\nmkdir -p \"$overlay/host/gambit\"\ncp -R \"$repo/host/gambit/yin\" \"$overlay/host/gambit/yin\"\ncat \"$repo/test/gambit/fixtures/yin-dht-probe.jolt\" >>\"$overlay/host/gambit/yin/jolt/gambit/yin.jolt\"\nfor name in build stdlib jolt-core; do\n  ln -s \"$repo/$name\" \"$overlay/$name\"\ndone\ncd \"$overlay\"\n\nsession diagnostics mem <<'FORMS'\n(+ 20 22)\n(require 'p1e.probe)\n(p1e.probe/run :shell-open)\n(p1e.probe/run :durable-put)\n(p1e.probe/run :durable-get)\n(p1e.probe/run :directory-open)\n(p1e.probe/run :memory-open)\n(p1e.probe/run :memory-put)\n(p1e.probe/run :memory-get)\n(p1e.probe/run :replicate-request)\n(p1e.probe/run :udp-loopback)\n(p1e.probe/run :udp-native-load)\n(p1e.probe/run :c4-control)\n(p1e.probe/run :close)\n(+ 40 3)\n(quit)\nFORMS\n\n# An expected capability refusal is an observation. Missing replies, a crash,\n# or the watchdog deadline make the evidence run fail.\ntest \"$(cat \"$run/diagnostics.status\")\" -eq 0\ntest \"$(cat \"$run/stock.status\")\" -lt 124\ntest \"$(grep -c '^yin> ' \"$run/diagnostics.stdout\")\" -eq 16\ngrep -Fx \"yin> 'p1e.probe\" \"$run/diagnostics.stdout\" >/dev/null\ngrep -Fx 'yin> 43' \"$run/diagnostics.stdout\" >/dev/null\ngrep -Fx 'yin> Bye' \"$run/diagnostics.stdout\" >/dev/null\n;; Appended to a scratch copy of jolt.gambit.yin. Keep the real driver and\n;; memory composition so each attempted operation gets its own Yin reply.\n(require '[dao.host.bytes :as p1e-bytes]\n         '[dao.stream :as p1e-stream]\n         '[dao.stream.ringbuffer :as p1e-ring]\n         '[jolt.scheme :as p1e-scheme])\n\n(def ^:private p1e-var (p1e-scheme/proc \"var-deref\"))\n(def ^:private p1e-dir (jolt.host/getenv \"JOLT_P1E_STORE\"))\n(def ^:private p1e-durable (atom nil))\n(def ^:private p1e-memory (atom nil))\n(def ^:private p1e-requests (atom nil))\n(def ^:private p1e-value {:p1e \"yin-dht-local-round-trip\" :count 3})\n\n(defn- p1e-call [namespace var-name & args]\n  ;; Defer each dependency so a failed load becomes a reply at the prompt.\n  (require (symbol namespace))\n  (apply (p1e-var namespace var-name) args))\n\n(defn- p1e-make-ring []\n  (:dao.stream/handle\n    (p1e-ring/create! {:dao.stream/type p1e-ring/transport-type\n                      p1e-ring/capacity-key 8})))\n\n(defn- p1e-next [ring cursor]\n  (p1e-stream/next ring (:dao.stream/cursor cursor)))\n\n(defn- p1e-open-shell []\n  (let [opened (p1e-call \"yin.shell.store\" \"open\" {:type :dht :dir p1e-dir} {})]\n    (reset! p1e-durable (:index-store opened))\n    :durable-dht-opened))\n\n(defn- p1e-open-dir []\n  (let [handle (p1e-call \"dao.space.store\" \"open\" p1e-dir)]\n    (jing/close! handle)\n    :durable-directory-opened))\n\n(defn- p1e-open-memory []\n  (let [requests (p1e-make-ring)\n        handle (p1e-call \"dao.jing.dht\" \"store-handle\"\n                         {:local (store/open :mem) :requests requests})]\n    (reset! p1e-memory handle)\n    (reset! p1e-requests requests)\n    :memory-dht-handle-opened))\n\n(defn- p1e-check-request []\n  (let [requests @p1e-requests\n        result (p1e-next requests (p1e-stream/cursor requests :dao.stream/oldest))]\n    (:dao.stream/value result)))\n\n(defn- p1e-loopback []\n  (let [traffic (p1e-make-ring)\n        cursor (p1e-stream/cursor traffic :dao.stream/oldest)\n        seam (p1e-call \"dao.stream.udp\" \"bind!\"\n                       {:identity \"p1e-loopback\" :deposit traffic\n                        :bind-host \"127.0.0.1\" :bind-port 0})]\n    (try\n      (let [bound (p1e-next traffic cursor)\n            event (:dao.stream/value bound)\n            port (get-in event [:dao.stream.datagram/local :dao.stream.datagram/port])]\n        (if port\n          (let [payload (p1e-bytes/alloc 1)\n                _ (p1e-bytes/set! payload 0 42)\n                sent ((:send! seam) \"127.0.0.1\" port payload)\n                step ((:step! seam))\n                received (p1e-next traffic bound)]\n            {:bound event :send sent :step step :receive (:dao.stream/value received)})\n          event))\n      (finally\n        ((:close! seam))))))\n\n(defn- p1e-run [op]\n  (case op\n    :shell-open (p1e-open-shell)\n    :durable-put (if-let [handle @p1e-durable]\n                   (jing/materialize! handle p1e-value)\n                   :blocked-no-durable-dht-handle)\n    :durable-get (if-let [handle @p1e-durable]\n                   (jing/get handle (jing/segment-key p1e-value) :missing)\n                   :blocked-no-durable-dht-handle)\n    :directory-open (p1e-open-dir)\n    :memory-open (p1e-open-memory)\n    :memory-put (if-let [handle @p1e-memory]\n                  (jing/materialize! handle p1e-value)\n                  :blocked-no-memory-dht-handle)\n    :memory-get (if-let [handle @p1e-memory]\n                  (jing/get handle (jing/segment-key p1e-value) :missing)\n                  :blocked-no-memory-dht-handle)\n    :replicate-request (when @p1e-requests (p1e-check-request))\n    :udp-loopback (p1e-loopback)\n    :udp-native-load (do (require 'jolt.socket.native) :socket-native-loaded)\n    :c4-control (p1e-call \"dao.posix.file\" \"realpath\" p1e-dir)\n    :close (do (jing/close! @p1e-durable) (jing/close! @p1e-memory) :closed)))\n\n(defn- p1e-activate [registry]\n  (module/register-host-module\n    registry 'p1e.probe\n    {'run p1e-run}\n    {'run (vm/primitive-profile 'run :pure [1] #{} :none)}))\n\n(defn- p1e-open [spec opts]\n  (assoc-in (open-memory spec opts) [:engine-inputs :host-modules 'p1e.probe]\n            p1e-activate))\n\n(defn -main [& args]\n  (main/main! args {:composition-spec? #{:mem}\n                    :parse-store-arg parse-store\n                    :open p1e-open}))\n","exit_code":0,"status":"completed"}}
