ct? v) (integer? v)) (i32 v))\n        ((and (flonum? v) (finite? v)) (i32 (exact (truncate v))))\n        (else v)))\n(define (call-declared-hash m x) (declared-hash-int (jolt-invoke m x)))\n\n;; A record no eq arm claims is = only to itself, so it hashes by identity (see\n;; the Chez file). Here a record is a vector tagged with its registered type id\n;; (prelude-shims.ss); equal-hash walked its fields, so an atom's hash moved\n;; with its value and a swap! lost it from any map it keyed.\n(define (jolt-identity-hashed? x)\n  (and (vector? x)\n       (fx>= (vector-length x) 1)\n       (fixnum? (vector-ref x 0))\n       (table-ref jolt-record-id-table (vector-ref x 0) #f)\n       ;; records and deftypes keep the structural hash they reach here with\n       (not (jrec? x))\n       (let loop ((as jolt-eq-arms))\n         (cond ((null? as) #t)\n               (((caar as) x x) #f)\n               (else (loop (cdr as)))))))\nstdlib/jolt/util.clj:32:              (list 'clojure.core/defmacro sym ['& 'args] (list 'clojure.core/cons (list 'quote target) 'args))\nstdlib/jolt/time/temporal.clj:239:  (let [cur (l/ld-dow (l/ld-epoch-day d)) delta (u/floor-mod (- cur target) 7)\nstdlib/jolt/line_editor.clj:645:          (map #(str qual \"/\" %) (keys (ns-publics target)))))\n","exit_code":0,"status":"completed"}}
