ified byte-copy rows.')\n# Full source loading needs ptr->string as a non-recursive primitive too.\np.write_text(s)\np = Path('host/gambit/host-statics.ss')\ns = p.read_text()\nat = s.index(';; ---- the statics')\ns = s[:at] + ''';; Constructing a File only wraps the path. Store preflight filesystem\n;; operations are governed by the same C4 boundary as the POSIX file overlay.\n(register-class-ctor\"'! \"java.io.File\"\n  (lambda (path) (make-jhost \"file\" (jolt-need-string path))))\n(register-host-methods! \"file\"\n  (cons (cons \"getPath\" jhost-state)\n        (map (lambda (name)\n               (cons name (lambda (_) (joltffi-public-blocking-raise))))\n             '\"'(\\\"exists\\\" \\\"isDirectory\\\" \\\"canWrite\\\" \\\"mkdirs\\\"))))\n\n''' + s[at:]\np.write_text(s)\np = Path('host/gambit/yin-repl-driver.ss')\np.write_text(p.read_text().replace(\\\"'(\\\\\\\"clojure.core\\\\\\\" \\\\\\\"jolt.ffi\\\\\\\")\\\",\\\"'(\\\\\\\"clojure.core\\\\\\\")\\\"))\nPY\ncat > build/p1f/load-ffi.ss <<'EOF'\n(define data-readers-active #f)\n(load (getenv \\\"JOLT_GAMBIT_YIN_BOOT\\\"))\n(include \\\"../../host/gambit/host-apply.ss\\\")\n(include \\\"../../host/gambit/source-loader.ss\\\")\n(gambit-install-source-loader\"'! '\"'((\\\"stdlib\\\" \\\".jolt\\\" \\\".cljc\\\" \\\".clj\\\") (\\\"jolt-core\\\" \\\".cljc\\\" \\\".clj\\\")) '(\\\"clojure.core\\\"))\n(with-exception-catcher\n  (lambda (e) (println (jolt-throwable-message (jolt-unwrap-throw e))) (exit 1))\n  (lambda () (println (jolt-pr-readable (jolt-eval-string \\\"(require 'jolt.ffi) (macro? #'jolt.ffi/defcfn)\\\")))))\nEOF\nenv TMPDIR=\\\"\"'$PWD/build/p1f/tmp\" JOLT_GAMBIT_YIN_BOOT=\"$(cat /Users/sto/workspace/jolt-ffi-p1e/build/p1e/boot.path)\" sh host/gambit/ffi/watchdog.sh 150 /Users/sto/.local/share/mise/installs/gambit/4.9.8/bin/gsi build/p1f/load-ffi.ss'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
