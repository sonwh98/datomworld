{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,148p' Makefile; rg -n 'JOLT_CHEZ|CHEZ|make|submodule' bin/jolt | head -45; tail -14 build/p1f/matrix.log; rg -n '\"'^(nil|#|'\"\\\\[\\\\[|ERROR|\\\"abc\\\")' build/p1f/component.out | tail -16; ls -l build/p1f/boot.path; find /Users/sto/workspace/jolt /Users/sto/workspace/jolt-ffi-p1c -maxdepth 4 \\\\( -name scheme -o -name jolt -o -name irregex.scm \\\\) | head -30\"","aggregated_output":"# jolt — Clojure on Chez Scheme. Single substrate, no Janet.\n#\n# bin/jolt runs jolt directly off the checked-in seed (host/chez/seed/).\n# `make build` builds the standalone binary, `make test` is the full gate, and\n# `make remint` rebuilds the seed after a source change.\n\nR := https://github.com/makeplus/makes\nM ?= .cache/makes\n# PINNED. Unpinned, this clone is whatever makeplus/makes HEAD is on the day of\n# the build — including a release build, whose toolchain would then be decided by\n# a repository this one records no version of. Bump deliberately.\nV := d14cb578c2f04e6f9d00e01c7c4e416a9baf94e9\n# Nix supplies a locked, source-only tree through M. Ordinary checkouts retain\n# the Git clone so their pinned revision is verified and provisioned on demand.\n$(shell [ -f '$M/init.mk' ] || git clone -q $R '$M')\n# Fetch only when the pin is absent, so a normal build stays offline. A\n# source-only Nix input has no .git directory, so there is nothing to fetch.\n$(shell [ ! -d '$M/.git' ] || { git -C '$M' cat-file -e '$V^{commit}' 2>/dev/null || git -C '$M' fetch -q origin; git -C '$M' rev-parse -q --verify HEAD 2>/dev/null | grep -qx '$V' || git -C '$M' checkout -q '$V'; })\n\ninclude $M/init.mk\n\n# The Chez jolt builds with always carries jolt's kernel patches\n# (host/chez/chez-patches). An explicit CHEZ= or CHEZSCHEME= is authoritative:\n# CI, the release jobs and the nix shell build a patched Chez and pass it in.\n# Otherwise the pinned Chez is built and patched below; a Chez on PATH is never\n# used, since nothing says it carries the patches.\nJOLT-CHEZ := $(or $(CHEZ),$(CHEZSCHEME))\n# bionic (Android's libc) is not readable off a machine tag — Android builds as\n# tarm64le, the same tag as glibc arm64 Linux — so ask the compiler, as\n# build.ss's bld-bionic? does. makes' xPack GCC is a glibc binary, so bionic\n# builds Chez with the host cc below.\nJOLT-BIONIC := $(if $(findstring android,$(shell cc -dumpmachine 2>/dev/null)),1,)\n\nifneq (,$(JOLT-CHEZ))\nSHELL-DEPS += $(JOLT-CHEZ)\nelse ifneq (windows,$(OS-NAME))\n$(eval $(call include-local))\n# The pinned release, patched with host/chez/chez-patches the way every CI and\n# release Chez is, so a from-source build runs the same kernel the releases\n# do. makes' chezscheme.mk can't patch (its one recipe extracts, configures\n# and installs), so host/chez/provision-chez.sh builds it instead; that\n# script says why it stages by hand. The prefix is makes' own layout, so\n# bin/jolt's .cache/local glob finds it, and it is keyed on the patches' hash:\n# the stamp names the patch set, so a prefix built before a patch changed (or\n# before patches were applied here at all) is rebuilt.\n#\n# The compiler: on Linux, makes' xPack GCC; on macOS the host compiler, Apple's\n# clang, as release.yml builds it (xPack GCC 14.2.0-1's fixed <stdio.h> doesn't\n# compile against current macOS SDKs, #1601); on bionic the host cc, since\n# xPack GCC is a glibc binary the Android loader cannot exec.\nifeq (1,$(JOLT-BIONIC))\nCHEZSCHEME-CC := cc\nelse ifeq (macos,$(OS-NAME))\nGCC-LOADED := true\nGCC := $(shell command -v cc)\nCHEZSCHEME-CC := $(GCC)\nelse\ninclude $M/gcc.mk\nCHEZSCHEME-CC := $(GCC)\nCHEZSCHEME-CC-DEP := $(GCC)\nendif\nCHEZSCHEME-VERSION ?= $(or $(shell sed -n 's/^CHEZSCHEME-VERSION ?= *//p' $M/chezscheme.mk | head -n1),10.4.1)\nCHEZSCHEME-LOCAL := $(LOCAL-ROOT)/chezscheme-$(CHEZSCHEME-VERSION)\nCHEZSCHEME := $(CHEZSCHEME-LOCAL)/bin/scheme\nPETITE-CHEZSCHEME := $(CHEZSCHEME-LOCAL)/bin/petite\nCHEZSCHEME-STAMP := $(CHEZSCHEME-LOCAL)/jolt-patches-$(shell sh host/chez/provision-chez.sh --hash)\n$(CHEZSCHEME-STAMP): $(CHEZSCHEME-CC-DEP)\n\t$Q sh host/chez/provision-chez.sh '$(CHEZSCHEME-LOCAL)' '$(CHEZSCHEME-VERSION)' '$(CHEZSCHEME-CC)'\n$(CHEZSCHEME): $(CHEZSCHEME-STAMP)\n\t@:\nSHELL-DEPS += $(CHEZSCHEME)\nJOLT-CHEZ := $(CHEZSCHEME)\nelse\n# Windows: Chez's `make install` doesn't run under MSYS2, so the Windows CI\n# jobs build and lay out a patched Chez themselves and pass it in. Only the\n# targets that need a Chez fail without one.\nJOLT-CHEZ := chez-not-provisioned-on-windows\n.PHONY: $(JOLT-CHEZ)\n$(JOLT-CHEZ):\n\t@echo \"On Windows, build Chez from source with ci/apply-chez-patches.sh and pass it as CHEZ= (see the Windows jobs in .github/workflows/tests.yml)\" >&2\n\t@exit 1\nendif\n\ninclude $M/clean.mk\ninclude $M/shell.mk\n\nMAKES-CLEAN := \\\n  build/ \\\n  target/ \\\n\nMAKES-REALCLEAN := \\\n  .jolt/ \\\n  test/chez/*/.jolt/ \\\n  test/chez/*/*/.jolt/ \\\n\nPREFIX ?= $(if $(IS-ROOT),/usr/local,$(HOME)/.local)\nCHEZ ?= $(JOLT-CHEZ)\n\n# Hand the selected Chez down to bin/jolt, so the targets that shell out to it\n# run the same interpreter as the ones that call $(CHEZ) directly. When make\n# provisions its own Chez, bin/jolt would otherwise have to find it again.\nexport JOLT_CHEZ := $(CHEZ)\n\nifneq (,$(CHEZSCHEME-LOCAL))\n# The provisioned GCC (on macOS, the host cc) built Chez, so the same driver\n# links the standalone binary: gcc.mk puts the bundle's bin FIRST on the\n# exported PATH, but the bundle ships no `cc`, so a bare cc falls through to\n# the distro driver and pairs it with the bundle's older as/ld (#788: gcc 16\n# .base64 into pre-2.43 gas). build.ss bld-cc reads JOLT_CC. A command-line\n# JOLT_CC=... still wins.\nexport JOLT_CC := $(GCC)\nendif\n\nJOLT-TARGETS-NEEDING-DEPS := \\\n  aotcacheperf aotcachesmoke aotfingerprint asynctimer buildlibsmoke buildsmoke reprobuildsmoke profilebuildsmoke embeddedresources \\\n  aotcachepathsmoke aotcachesourcepathsmoke aotcachestarfilesmoke compilepathsmoke contagion corpus cts dcerefs depssmoke depsunit devboot \\\n  readscaling vecscaling pipescaling chunkscaling printscaling complexity ioscaling hotscaling applyscaling zipmemory lazyscaling \\\n  devbootsmoke devirt directlink linkedrace mintgate ffi fibers fiberspoll fieldjoin fieldnum fieldread flarr fnform poolshape coreproc grenadine \\\n  gateboot gatebootsmoke gosm hasheq httpsfetch infer inferscaling inline inline-body irvalidate statlayout \\\n  jolt jolt-debug jolt-release joltsmoke libconformance libperf mandelbrot-num mathfl mvnhttp defmetacells staticsite gcpolicy stacklimit lazyretain \\\n  deadhost recordshadow emittedheads mirrordrift mirrordrift-regen regexdfacheck regexdfacheck-regen regexdfa regexanchor regexanchorprims regexanchorcheck regexsyntax regexbacktrack \\\n  hostarity enummodel enumregistrymodel cowpublishmodel doseqperf failfastmodel imagecoverage lazyshims narrow narrowhash numeric numwp oparity s64wrap pic protoret printperf remint sbperf sci selfhost shakelocal \\\n  traceemit tracecompilecost vfaslceiling \\\n  shakesmoke smoke sortedcoll staticnativesmoke stateimage test testbin transient unit unitcontext zlibregistersmoke zlibnativesmoke noexecsmoke \\\n  threadsafety maskedacquire ioerrno values wp ci\n\n# Only mark PHONY targets for names that have file system conflicts:\n.PHONY: nsaudit kondocheck build install test ci bionic-ci ci-shard ci-shard-list gate-run-test gate-run-ci gate-run-bionic-ci gate-run-ci-shard gate-status hooks attributioncheck noticecheck monitormodel \\\n        gambitcheck gambitkernel gambiteval gambitsourceload gambitdaobytes gambityinrepl gambitseed gambitweb gambitprofile \\\n        gambitgen gambitgencheck gambitseedcheck gambitunbound gambitunbound-regen \\\n        gambitffi gambitffi-abi gambitffi-errno-check gambitffi-load-failure-smoke gambitffi-bridge \\\n        gambitvars gambitvars-regen gambitstatics gambitstatics-regen gambittwins grenadinecheck \\\n        fibersbench dynbench \\\n        fibersresidue\n\ndefault:: build\n\n# Honor an explicit Chez or install the pinned toolchain, initialize every\n# vendored dependency, and enforce Jolt's threaded-runtime requirement.\ndeps: submodules $(JOLT-CHEZ)\n\t@threaded=$$(printf '(write (threaded?)) (newline)\\n' | \\\n\t  '$(JOLT-CHEZ)' -q 2>/dev/null | tr -d '\\r'); \\\n\t  test \"$$threaded\" = '#t' || { \\\n\t    echo \"Jolt requires a threaded Chez Scheme ($(JOLT-CHEZ) reported $$threaded)\" >&2; \\\n\t    exit 1; \\\n\t  }\n\nsubmodules:\n36:# Identify the Chez Scheme executable. $JOLT_CHEZ is authoritative and is how the\n39:# inherit that export, so it takes the Chez make recorded next to the dev boot\n40:# cache (any other pick makes that cache unusable), then the one make\n42:# kernel patches, which make builds (`make deps`) or which is passed in.\n47:if [ -z \"${JOLT_CHEZ:-}\" ]; then\n53:          JOLT_CHEZ=\"$candidate\"\n60:  if [ -z \"${JOLT_CHEZ:-}\" ]; then\n61:    echo \"No Chez Scheme for jolt: run \\`make deps\\` to build the patched Chez, or set JOLT_CHEZ.\" >&2\n65:CHEZ=\"$JOLT_CHEZ\"\n67:# JOLT_CHEZ from its own environment to find the csv dir next to the running\n70:export JOLT_CHEZ=\"$(command -v \"$CHEZ\" 2>/dev/null || echo \"$CHEZ\")\"\n72:# A Chez path with its directory resolved physically, the form make records:\n90:# than source mode. Check freshness against the input list emitted by make devboot.\n101:CACHE_CHEZ=\"target/dev/flat.chez\"\n114:  # image is older than the executable), or a different Chez entirely (make\n117:  if [ \"$stale\" = 0 ] && [ -f \"$CACHE_CHEZ\" ]; then\n119:    # Compare physical paths: make records one with its directory resolved, and\n121:    chez_path=\"$(physical_path \"$JOLT_CHEZ\")\"\n135:  exec ${CHEZ} --script host/chez/cli-devcache.ss \"$@\"\n141:    echo \"jolt: source mode; dev boot cache $cache_note (set JOLT_CHEZ, or re-run 'make devboot')\" >&2\n143:    e