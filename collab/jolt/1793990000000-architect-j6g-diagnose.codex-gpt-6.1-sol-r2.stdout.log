quest (:requests link-pair)\n   673\t                       :link-response (:responses link-pair))\n   674\t      query-pair (assoc :call-in (:call-in query-pair)\n   675\t                        :call-out (:call-out query-pair)\n   676\t                        :call-out-cursor (:out-cursor query-pair))))))\n   677\t\n   678\t\n   679\t(defn- make-runner\n   680\t  \"The run step the evaluator observer hands each loaded program: run the\n   681\t   VM through its protocol entry point, as a plain function so it can be\n   682\t   handed to observer coordination on every host, and answer a halted\n   683\t   run's value on `output-stream` under `round`.  The shell reads the value\n   684\t   from that stream, never from the VM record; the append outcome rides\n   685\t   back on the VM as `::result-append`, so a refused append is reported\n   686\t   rather than silently lost.\"\n   687\t  [output-stream round]\n   688\t  (fn [vm]\n   689\t    (let [vm' (vm/run vm)]\n   690\t      (if (vm/halted? vm')\n   691\t        (assoc vm'\n   692\t               ::result-append\n   693\t               (emit-result! output-stream round (vm/value vm')))\n   694\t        vm'))))\n   695\t\n   696\t\n   697\t(defn- make-attachment\n   698\t  \"Create one composition-owned medium of `capacity` elements, the unary\n   699\t   attachment entry bound to it for this medium's lifetime, and an observer\n   700\t   attached through that entry.  `:attach` attaches a further, independently\n  1240\t   the ones a round drives before reporting the VM wedged.\"\n  1241\t  [vm]\n  1242\t  (boolean (some #(contains? #{:link-request :link-response :install}\n  1243\t                             (:reason %))\n  1244\t                 (:wait-set vm))))\n  1245\t\n  1246\t\n  1247\t(defn- carry-link-identity\n  1248\t  \"The round's base VM with the link identity `used` has already minted\n  1249\t   carried forward: link ids `[origin counter]` and install-child origin\n  1250\t   tags are minted once and never reused on a pair (yin.vm.linker.md\n  1251\t   section 7.2), and the shell's rollback to the round's base -- whose\n  1252\t   counters never advanced -- must not let a later require or install\n  1253\t   mint an identity the pair has already answered.\"\n  1254\t  [base used]\n  1255\t  (let [n (max (or (:id-counter base) 0) (or (:id-counter used) 0))\n  1256\t        o (max (or (:origins base) 0) (or (:origins used) 0))]\n  1257\t    (cond-> base\n  1258\t      (pos? n) (assoc :id-counter n)\n  1259\t      (pos? o) (assoc :origins o))))\n  1260\t\n  1261\t\n  1262\t(defn- link-raise\n  1263\t  \"The raise of a resumed link wait, carrying the identity the parked\n  1264\t   evaluation has minted so far -- the counters of the VM the raise\n  1265\t   interrupted, whose every earlier run is in them -- so a rollback\n  1266\t   cannot reuse it.  It carries the query interpreter's pair too: the\n  1267\t   requests it has answered stay answered when the shell rolls back.\n  1268\t   The linker successor carries every cursor and settled question.\"\n  1269\t  [error vm state]\n  1270\t  (ex-info (or (ex-message error) \"Link failed\")\n  1271\t           (assoc (or (ex-data error) {})\n  1272\t                  ::link-counter (:id-counter vm)\n  1273\t                  ::link-origins (:origins vm)\n  1274\t                  ::query-pair (:query-pair state)\n  1275\t                  ::linker (:linker state)\n  1276\t                  ::dht (:dht state)\n  1277\t                  ::indexer (:indexer state))))\n  1278\t\n  1279\t\n  1280\t(defn- carry-served\n  1281\t  \"`state` rolled back by a link raise, keeping what the interpreters\n  1282\t   already concluded: the query pair, the link pair past every request\n  1283\t   answered, the linker interpreter's past every\n  1284\t   question settled, the DHT node a load started or forgot on, and the\n  1285\t   indexer a `yin.link/publish` committed its name envelopes through.\"\n  1286\t  [state d]\n  1287\t  (cond-> state\n  1288\t    (::query-pair d) (assoc :query-pair (::query-pair d))\n  1289\t    (::linker d) (assoc :linker (::linker d))\n  1290\t    (contains? d ::dht) (assoc :dht (::dht d))\n  1291\t    (::indexer d) (assoc :indexer (::indexer d))))\n  1292\t\n  1293\t\n  1294\t(defn- link-context\n  1295\t  \"What a `yin.link` call is answered under (yin.repl.query/serve): the\n  1296\t   reader's authority, the publisher's key, and the requesting VM's\n  1297\t   primitives and module registry -- the modules it linked are derived\n  1298\t   from it, never recorded -- and the round.\"\n  1299\t  [state vm]\n  1300\t  {:authority (link/authority (:link-source state))\n  1301\t   :key (:dht-key state)\n  1302\t   :primitives (:primitives vm)\n  1303\t   :modules (:modules vm)\n  1304\t   :round (:round state)})\n  1305\t\n  1306\t\n  1307\t(defn- drive-links\n  1308\t  \"Serve the linker interpreter and run the parked VM alternately, at most\n  1309\t   `link-round-budget` rounds, while `vm` waits on a link.  A round that\n  1310\t   moves nothing ends the drive: a link whose content source cannot\n  1311\t   answer will not answer by waiting longer.  Returns\n  1312\t   `[state vm pending progress?]`, `pending` the links the interpreter\n  1313\t   reported `:pending`, and `progress?` true when a round moved\n  1314\t   something -- advanced a serve cursor, delivered a response or\n  1315\t   completed an install -- the fact the pending run's `:checks` resets\n  1316\t   on (yin.repl.link-policy.md section 3.1).  A refused or lost link\n  1317\t   raises as the VM's own, carrying the interrupted VM's minted\n  1318\t   identity.\n  1319\t\n  1320\t   `initial-progress` records progress from the caller's round.  When\n  1321\t   true, the first iteration runs the VM once without a round of its own.\n  1322\t\n  1323\t   A VM waiting on a `dao.space.query/q` call is driven the same way: the\n  1324\t   query interpreter (`yin.repl.query/serve`) answers from the session's\n  1325\t   indexer and the VM runs on.  Only a round the VM spends waiting on a\n  1326\t   link counts against `link-round-budget`; a query is answered in the\n  1327\t   round it is asked, so its rounds are bounded by `query-drive-budget`\n  1328\t   calls instead: a VM still waiting on a call once the drive has\n  1329\t   answered that many raises `query-call-limit-text` as its own error,\n  1330\t   the unanswered request abandoned with it.\"\n  1331\t  [state vm initial-progress]\n  1332\t  (loop [i 0\n  1333\t         calls 0\n  1334\t         vm vm\n  1335\t         state state\n  1336\t         pending []\n  1337\t         progress? initial-progress\n  1338\t         initial? initial-progress]\n  1339\t    (let [link? (link-waiting? vm)\n  1340\t          query? (query/waiting? vm)]\n  1341\t      (cond\n  1342\t        (or (vm/halted? vm) (not (or link? query?)) (>= i link-round-budget))\n  1343\t        [state vm pending progress?]\n  1344\t\n  1345\t        (and query? (>= calls query-drive-budget))\n  1346\t        (throw (link-raise (ex-info query-call-limit-text\n  1347\t                                    {:reason :yin.repl.query/call-limit\n  1348\t                                     :limit query-drive-budget})\n  1349\t                           vm\n  1350\t                           (update state :query-pair query/abandon-requests)))\n  1351\t\n  1352\t        :else\n  1353\t        (let [served (when (and link? (not initial?))\n  1354\t                       (link/round (assoc (:linker state)\n  1355\t                                          :source (:link-source state))\n  1356\t                                   (:dht state)))\n  1357\t              state (cond-> state\n  1358\t                      served (assoc :linker (:linker served)\n  1359\t                                    :dht (:dht served)))\n  1360\t              answered (when query?\n  1361\t                         (query/serve {:pair (:query-pair state)\n  1362\t                                       :indexer (:indexer state)\n  1363\t                                       :ast-indexer (:ast-indexer state)\n  1364\t                                       :dht (:dht state)\n  1365\t                                       :link (link-context state vm)\n  1366\t                                       :limits {:row-limit query-row-limit\n  1367\t                                                :byte-limit query-byte-limit}\n  1368\t                                       :budget (min query-serve-budget\n  1369\t                                                    (- query-drive-budget\n  1370\t                                                       calls))}))\n  1371\t              state (cond-> state\n  1372\t                      answered (assoc :query-pair (:pair answered)\n  1373\t                                      :dht (:dht answered)\n  1374\t                                      :indexer (:indexer answered)))\n  1375\t              pending (if (seq (:pending served)) (:pending served) pending)]\n  1376\t          (if (or initial? (:progress? served)\n  1377\t                  (:progress? answered))\n  1378\t            (let [vm' (try (vm/run vm)\n  1379\t                           (catch #?(:cljd Object :clj Exception :cljs js/Error)\n  1380\t                                  error\n  1381\t                             (throw (link-raise error vm state))))]\n  1382\t              (recur (if link? (inc i) i)\n  1383\t                     (+ calls (:answered answered 0))\n  1384\t                     vm'\n  1385\t                     state\n  1386\t                     pending\n  1387\t                     true\n  1388\t                     false))\n  1389\t            [state vm pending progress?]))))))\n  1390\t\n634:(defn boot\n706:(defn boot-server\n","exit_code":0,"status":"completed"}}
