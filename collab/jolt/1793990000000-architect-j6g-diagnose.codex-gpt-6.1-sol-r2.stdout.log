                  (reset! last-telemetry-tick now)\n   512\t                    (let [sc (count @b-samples)\n   513\t                          cur-p99 (when (pos? sc)\n   514\t                                    (nth (sort @b-samples) (min (dec sc) (int (* 0.99 sc)))))]\n   515\t                      (println (str \"TELEMETRY: elapsed=\" (long (/ elapsed 1000)) \"s, samples=\" sc\n   516\t                                    \", running p99=\" (if cur-p99 (str cur-p99 \"ms\") \"ABSENT\") \", A-sent=\" @a-sent \"/\" total-a-frame-len\n   517\t                                    \" (\" (long (* 100 (/ (double @a-sent) (double total-a-frame-len)))) \"%), A-deliveries=\" (count @a-deliveries)\n   518\t                                    (when @a-stalled? \" [A-STALLED]\")))\n   519\t                      (println \"W-TIMINGS\" (pr-str @timings))\n   520\t                      (println \"W-PROGRESS\"\n   521\t                               (pr-str {:rounds @owner-round-count, :loop-results @repl-step-count,\n   522\t                                        :transactions (get-in @repl-state [:repl :indexer :transactions]),\n   523\t                                        :b-sent @b-req-seq, :b-completed @b-completed,\n   524\t                                        :b-outstanding (count @b-outstanding), :a-window @a-window}))\n   525\t                      (flush)))\n   526\t\n   527\t                  ;; 5. Pump I/O for server and client B\n   528\t                  (when (= 1 @owner-round-count)\n   529\t                    (println \"W-PHASE server-pump\")\n   530\t                    (flush))\n   531\t                  (timed-call! trace? timings @owner-round-count :server-pump\n   532\t                               #(wake/sleep-fds! w 5 server-pump nil))\n   533\t                  (when (= 1 @owner-round-count)\n   534\t                    (println \"W-PHASE client-b-pump\")\n   535\t                    (flush))\n   536\t                  (timed-call! trace? timings @owner-round-count :client-b-pump\n   537\t                               #(wake/sleep-fds! w 5 client-b-pump nil))\n   538\t                  (when (= 1 @owner-round-count)\n   539\t                    (println \"W-PHASE owner-round-complete\")\n   540\t                    (flush))\n   541\t\n   542\t                  ;; Check exit conditions\n   543\t                  (let [a-done? (or @a-stalled?\n   544\t                                    (and (>= @a-sent total-a-frame-len)\n   545\t                                         (seq @a-deliveries)))\n   546\t                        time-done? (>= elapsed target-duration-ms)]\n   547\t\n   548\t                    ;; Later replies cannot repair a deficient overlap sample count.\n   549\t                    (if (and a-done? time-done?)\n   550\t                      ;; Drain trailing in-flight requests briefly\n   551\t                      (let [drain-deadline (+ (poller/clock-ms) 500)]\n   552\t                        (loop []\n   553\t                          (when (and (seq @b-outstanding)\n   554\t                                     (< (poller/clock-ms) (min deadline drain-deadline)))\n   555\t                            (wake/sleep-fds! w 5 server-pump nil)\n   556\t                            (wake/sleep-fds! w 5 client-b-pump nil)\n   557\t                            (recur))))\n   558\t                      (recur)))))))\n   559\t\n   560\t          ;; Cleanup sockets\n   561\t          (raw-close! raw-a)\n   562\t          (wsj/close-host! client-b-inst)\n   563\t          (wsj/close-host! server-inst)\n   564\t          (wake/close! w)\n   565\t\n   566\t          ;; -------------------------------------------------------------------\n   567\t          ;; Evaluation of pre-registered criterion\n   568\t          ;; -------------------------------------------------------------------\n   569\t          (let [sample-count (count @b-samples)\n   570\t                elapsed-ms (- (poller/clock-ms) run-start)\n