g assoc id (poller/clock-ms))\n   485\t                                            ((:send! @b-seam) req-bs)))))))\n   486\t\n   487\t                  ;; 4. Periodic sampler flush every 10 seconds to ensure telemetry\n   488\t                  (when (>= (- now @last-telemetry-tick) 10000)\n   489\t                    (reset! last-telemetry-tick now)\n   490\t                    (let [sc (count @b-samples)\n   491\t                          cur-p99 (when (pos? sc)\n   492\t                                    (nth (sort @b-samples) (min (dec sc) (int (* 0.99 sc)))))]\n   493\t                      (println (str \"TELEMETRY: elapsed=\" (long (/ elapsed 1000)) \"s, samples=\" sc\n   494\t                                    \", running p99=\" (if cur-p99 (str cur-p99 \"ms\") \"ABSENT\") \", A-sent=\" @a-sent \"/\" total-a-frame-len\n   495\t                                    \" (\" (long (* 100 (/ (double @a-sent) (double total-a-frame-len)))) \"%), A-deliveries=\" (count @a-deliveries)\n   496\t                                    (when @a-stalled? \" [A-STALLED]\")))\n   497\t                      (println \"W-TIMINGS\" (pr-str @timings))\n   498\t                      (println \"W-PROGRESS\"\n   499\t                               (pr-str {:rounds @owner-round-count, :loop-results @repl-step-count,\n   500\t                                        :transactions (get-in @repl-state [:repl :indexer :transactions]),\n   501\t                                        :b-sent @b-req-seq, :b-completed @b-completed,\n   502\t                                        :b-outstanding (count @b-outstanding), :a-window @a-window}))\n   503\t                      (flush)))\n   504\t\n   505\t                  ;; 5. Pump I/O for server and client B\n   506\t                  (when (= 1 @owner-round-count)\n   507\t                    (println \"W-PHASE server-pump\")\n   508\t                    (flush))\n   509\t                  (timed-call! trace? timings @owner-round-count :server-pump\n   510\t                               #(wake/sleep-fds! w 5 server-pump nil))\n   511\t                  (when (= 1 @owner-round-count)\n   512\t                    (println \"W-PHASE client-b-pump\")\n   513\t                    (flush))\n   514\t                  (timed-call! trace? timings @owner-round-count :client-b-pump\n   515\t                               #(wake/sleep-fds! w 5 client-b-pump nil))\n   516\t                  (when (= 1 @owner-round-count)\n   517\t                    (println \"W-PHASE owner-round-complete\")\n   518\t                    (flush))\n   519\t\n   520\t                  ;; Check exit conditions\n   521\t                  (let [a-done? (or @a-stalled?\n   522\t                                    (and (>= @a-sent total-a-frame-len)\n   523\t                                         (seq @a-deliveries)))\n   524\t                        time-done? (>= elapsed target-duration-ms)]\n   525\t\n   526\t                    ;; Later replies cannot repair a deficient overlap sample count.\n   527\t                    (if (and a-done? time-done?)\n   528\t                      ;; Drain trailing in-flight requests briefly\n   529\t                      (let [drain-deadline (+ (poller/clock-ms) 500)]\n   530\t                        (loop []\n   531\t                          (when (and (seq @b-outstanding)\n   532\t                                     (< (poller/clock-ms) (min deadline drain-deadline)))\n   533\t                            (wake/sleep-fds! w 5 server-pump nil)\n   534\t                            (wake/sleep-fds! w 5 client-b-pump nil)\n   535\t                            (recur))))\n   536\t                      (recur)))))))\n   537\t\n   538\t          ;; Cleanup sockets\n   539\t          (raw-close! raw-a)\n   540\t          (wsj/close-host! client-b-inst)\n   541\t          (wsj/close-host! server-inst)\n   542\t          (wake/close! w)\n   543\t\n   544\t          ;; -------------------------------------------------------------------\n   545\t          ;; Evaluation of pre-registered criterion\n   546\t          ;; -------------------------------------------------------------------\n   547\t          (let [sample-count (count @b-samples)\n   548\t                elapsed-ms (- (poller/clock-ms) run-start)\n   549\t                valid-run? (>= sample-count 500)\n   550\t                target-samples-met? (>= sample-count target-samples)\n   551\t                sorted (sort @b-samples)\n   552\t                p99-idx (int (* 0.99 sample-count))\n   553\t                p99 (when (and (not @timed-out?) (pos? sample-count))\n   554\t                      (nth sorted (min (dec sample-count) p99-idx)))\n   555\t                p99-ok? (and (some? p99) (<= p99 250))\n   556\t                repl-advances? (= @owner-round-count @repl-step-count)\n   557\t                overlap-ms (when (and (:started-at @a-window) (:delivered-at @a-window))\n   558\t                             (- (:delivered-at @a-window) (:started-at @a-window)))\n   559\t                a-deliv-count (count @a-deliveries)\n   560\t                a-deliv-len (or (first @a-deliveries) 0)\n   561\t                delivered-once? (and (= 1 a-deliv-count)\n   562\t                                     (= 4194304 a-deliv-len))\n   563\t                replies-lost (count @b-outstanding)\n   564\t                no-reply-lost? (and (zero? @b-lost) (zero? replies-lost))\n   565\t                all-pass? (and (not @timed-out?)\n   566\t                               (not @a-stalled?)\n   567\t                               valid-run?\n   568\t                               target-samples-met?\n   569\t                               (some? overlap-ms)\n   570\t                               (>= overlap-ms target-duration-ms)\n   571\t                               (not trace?)\n   572\t                               p99-ok?\n   573\t                               repl-advances?\n   574\t                               delivered-once?\n   575\t                               no-reply-lost?)]\n   576\t\n   577\t            (println)\n   578\t            (println \"================================================================================\")\n   579\t            (println \"Workload W Results:\" (if all-pass? \"SUCCESS\" \"FAILURE\"))\n   580\t            (println \"================================================================================\")\n   581\t            (println \"  Hard cap timed out:           \" @timed-out?)\n   582\t            (println \"  Elapsed:                      \" elapsed-ms \"ms\")\n   583\t            (println \"  Peer A transfer stalled:      \" @a-stalled?)\n   584\t            (println \"  Transfer overlap ms:          \" overlap-ms)\n   585\t            (println \"  Diagnostic trace enabled:     \" trace?)\n   586\t            (println \"W-TIMINGS\" (pr-str @timings))\n   587\t            (println \"  Sample count:                 \" sample-count\n   588\t                     (str \"(valid >= 500: \" valid-run? \", target >= \" target-samples \": \" target-samples-met? \")\"))\n   589\t            (println \"  p99 round-trip latency:       \" (if (some? p99) (str p99 \"ms\") \"ABSENT\")\n   590\t                     (str \"(criterion <= 250 ms: \" p99-ok? \")\"))\n   591\t            (println \"  Peer B replies lost:          \" replies-lost \"(unanswered) +\" @b-lost \"(corrupt)\")\n   592\t            (println \"  Peer A delivered once:        \" delivered-once?\n   593\t                     (str \"(deliveries: \" a-deliv-count \", bytes: \" a-deliv-len \", sent: \" @a-sent \")\"))\n   594\t            (println \"  REPL per-round step advance:  \" repl-advances?\n   595\t                     (str \"(rounds: \" @owner-round-count \", REPL steps: \" @repl-step-count \")\"))\n   596\t            (println)\n   597\t\n   598\t            ;; Required report records per BRIEF-j6g.md\n   599\t            (if (some? p99)\n   600\t              (println \"RECORD p99\" p99 \"ms\")\n   601\t              (println \"RECORD p99 ABSENT\"))\n   602\t            (println \"RECORD sample count\" sample-count)\n   603\t            (println \"RECORD elapsed ms\" elapsed-ms)\n   604\t            (println \"RECORD delivered once\" delivered-once?)\n   605\t            (println \"RECORD per-round step advance\" repl-advances?)\n   606\t\n   607\t            (if all-pass?\n   608\t              (do (println \"PASS workload-w\")\n   609\t                  {:pass? true\n   610\t                   :p99 p99\n    20\t    (nth (sort samples) (min (dec (count samples)) (int (* 0.99 (count samples)))))))\n    21\t\n    22\t\n    23\t(defn- observe-line\n    24\t  [state line]\n    25\t  (cond\n    26\t    (str/starts-with? line \"W-SAMPLE \")\n    27\t    (let [sample (try (edn/read-string (subs line 9)) (catch Exception _ nil))]\n    28\t      (if (and (number? sample) (<= 0 sample))\n    29\t        (-> state\n    30\t            (update :samples conj sample)\n    31\t            (assoc :last-output-at (now-ms)))\n    32\t        (assoc state :sample-error line)))\n    33\t\n    34\t    (str/starts-with? line \"W-CALL \")\n    35\t    (let [call (try (edn/read-string (subs line 7)) (catch Exception _ nil))\n    36\t          valid? (and (map? call) (integer? (:round call)) (keyword? (:phase call))\n    37\t                      (contains? #{:enter :leave} (:event call)))]\n    38\t      (if-not valid?\n    39\t        (assoc state :trace-error line)\n    40\t        (let [state (assoc state :last-output-at (now-ms))]\n    41\t          (case (:event call)\n    42\t            :enter (assoc state :active-call call :call-entered-at (now-ms))\n    43\t            :leave (if (= (select-keys call [:round :phase])\n    44\t                          (select-keys (:active-call state) [:round :phase]))\n    45\t                     (assoc state :active-call nil :call-entered-at nil :last-call call)\n    46\t                     (assoc state :trace-error line))))))\n    47\t\n    48\t    :else\n    49\t    (do\n    50\t      (println line)\n    51\t      (flush)\n    52\t      (cond-> (assoc state :last-output-at (now-ms))\n    53\t        (str/starts-with? line \"W-PHASE \") (assoc :phase (subs line 8))\n    54\t        (= line \"FAIL workload-w\") (assoc :reported-failure? true)))))\n    55\t\n    56\t\n    57\t(defn- read-output\n    58\t  \"Only ready characters, at most 8192 per turn: a partial line or a noisy\n    59\t   worker must not block the watchdog's clock or its ten-second sampler.\"\n    60\t  [reader state]\n    61\t  (let [chunk (StringBuilder.)\n    62\t        eof? (loop [remaining 8192]\n    63\t               (if (and (pos? remaining) (.ready reader))\n    64\t                 (let [c (.read reader)]\n    65\t                   (if (= -1 c)\n    66\t                     true\n    67\t                     (do (.append chunk (char c))\n    68\t                         (recur (dec remaining)))))\n    69\t                 false))\n    70\t        lines (str/split (str (:partial state) chunk) #\"\\n\" -1)]\n    71\t    (assoc (reduce observe-line state (butlast lines))\n    72\t           :partial (last lines) :eof? eof?)))\n    73\t\n    74\t\n    75\t(defn- telemetry!\n    76\t  [state elapsed]\n    77\t  (println \"WATCHDOG TELEMETRY\"\n    78\t           (pr-str {:elapsed-ms elapsed,\n    79\t                    :samples (count (:samples state)),\n    80\t                    :running-p99-ms (or (p99 (:samples state)) \"ABSENT\"),\n    81\t                    :first-round-phase (:phase state),\n    82\t                    :active-call (:active-call state),\n    83\t                    :active-call-age-ms (when-let [entered (:call-entered-at state)]\n    84\t                                          (- (now-ms) entered)),\n    85\t                    :last-call (:last-call state),\n    86\t                    :output-age-ms (- (now-ms) (:last-output-at state))}))\n    87\t  (flush