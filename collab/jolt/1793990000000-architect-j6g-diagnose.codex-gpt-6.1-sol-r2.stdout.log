======================================\n   100\t\n   101\t(defn unmask\n   102\t  \"Fresh bytes: `bs` XOR the four-byte `key`, the key rotated by `offset`\n   103\t   (the payload position of `bs`'s first byte).  Masking is the same\n   104\t   operation.  `bs` is left unchanged.\"\n   105\t  [bs key offset]\n   106\t  (let [n (bytes/length bs)\n   107\t        out (bytes/alloc n)\n   108\t        k (bytes/to-vector key)]\n   109\t    (loop [i 0]\n   110\t      (when (< i n)\n   111\t        (bytes/set! out i (bit-xor (bytes/get bs i)\n   112\t                                   (nth k (mod (+ offset i) 4))))\n   113\t        (recur (inc i))))\n   114\t    out))\n   115\t\n   116\t\n   117\t(defn- opcode-int\n   118\t  [opcode]\n   119\t  (if (keyword? opcode) (get opcodes opcode) opcode))\n   120\t\n   121\t\n   122\t(defn- length-bytes\n   123\t  [n]\n   124\t  (cond\n   125\t    (< n 126) [n]\n   126\t    (< n 65536) [126 (quot n 256) (mod n 256)]\n   127\t    :else (let [hi (quot n 4294967296)\n   128\t                lo (mod n 4294967296)]\n   129\t            (into [127]\n   130\t                  (concat (map #(mod (quot hi %) 256) [16777216 65536 256 1])\n   131\t                          (map #(mod (quot lo %) 256) [16777216 65536 256 1]))))))\n   132\t\n   133\t\n   134\t(defn encode-frame\n   135\t  \"The wire bytes of one frame: `{:opcode :payload}` plus optional `:fin?`\n   136\t   (default true) and `:mask-key` (four bytes; present for client frames).\n   137\t   Header and masked payload are written into one fresh array; `:payload`\n   138\t   is left unchanged.  A control frame over 125 bytes or not final throws.\"\n   139\t  [{:keys [opcode payload mask-key fin?] :or {fin? true}}]\n   140\t  (let [op (opcode-int opcode)\n   141\t        n (bytes/length payload)]\n   142\t    (when (and (>= op 8) (or (> n 125) (not fin?)))\n   143\t      (throw (ex-info \"control frames are final and at most 125 bytes\"\n   144\t                      {:opcode op :length n})))\n   145\t    (let [lenb (length-bytes n)\n   146\t          mask? (some? mask-key)\n   147\t          head (into [(bit-or (if fin? 0x80 0) op)\n   148\t                      (bit-or (if mask? 0x80 0) (first lenb))]\n   149\t                     (concat (rest lenb) (when mask? (bytes/to-vector mask-key))))\n   150\t          hn (count head)\n   151\t          out (bytes/alloc (+ hn n))]\n   152\t      (loop [i 0]\n   153\t        (when (< i hn)\n   154\t          (bytes/set! out i (nth head i))\n   155\t          (recur (inc i))))\n   156\t      (if mask?\n   157\t        (bytes/copy! (unmask payload mask-key 0) 0 out hn n)\n   158\t        (bytes/copy! payload 0 out hn n))\n   159\t      out)))\n   160\t\n;; The jolt host lane's toolchain declaration (owner fork pin, 2026-10-22)\n;; (docs/design/yin.repl-jolt-implementation.md §6.1, §6.4).\n;;\n;; `bb bootstrap:jolt` materializes exactly this into build/tools/jolt and\n;; verifies it; ordinary runs never pull. Pin changes use the upgrade gate\n;; (`qualify:jolt-upgrade`, §6.4), with the explicit exception recorded below.\n{:jolt\n {:origin \"https://github.com/sonwh98/jolt\"\n  :sha \"b389f1a7fb553f63a3494d71f8fe3251790bf4d3\"\n  :committed \"2026-10-24T13:55:46+07:00\"\n  ;; owner decision 2026-10-22, pinned ahead of the first qualify:jolt-upgrade\n  ;; run (section 6.4 ruling 4 exception); requalified by the manual section 6\n  ;; checklist (collab review 1792692000000)\n  :tag :none\n  :nearest-release-tag {:tag \"v0.8.23\"\n                        :sha \"a0ac71c3f638fe55158bd01b4ecbb0dd3d7545e5\"}\n  :describe \"vnightly-17-gb389f1a7\"\n  :dir \"build/tools/jolt\"\n  ;; recursive submodule SHAs at :sha (git submodule status --recursive);\n  ;; bootstrap refuses a checkout whose submodules differ\n  :submodules {\"vendor/cli\" \"14f07644080070246974942415a104228d9a6b04\"\n               \"vendor/clojure-test-suite\" \"489b6743e8421687ef96cec557830acf258d1886\"\n               \"vendor/fs\" \"5b273b8a943a622593fbc85fca6761c5a39d6d66\"\n               \"vendor/grenadine\" \"688e0ed6618582eccc8c8b745243ceac92835e03\"\n               \"vendor/irregex\" \"c948a704fc732914a243c1643bfe359913d11c7b\"\n               \"vendor/process\" \"43bdd65e189f2ccacc56662c53a21f5470ff1500\"\n               \"vendor/sci\" \"32d62a5136ad3dc148588752f5bcc4cc30b14752\"}\n  ;; The fork pin carries the Sorted fix: sonwh98/jolt#2, source 7b7100c1\n  ;; and regenerated seeds 697b91ee. No bootstrap patch or re-mint is needed.\n  ;; Re-pinned 2026-10-24 (owner ruling: the JVM is canonical, jolt-lang is\n  ;; patched via the fork, same exception as 2026-10-22) to b389f1a7 on fork\n  ;; branch assoc-deftype-refusal, one commit on 697b91ee: assoc on a deftype\n  ;; that is not Associative throws ClassCastException, as on the JVM\n  ;; (host/chez/records-coll.ss; seeds unchanged at the remint byte-fixpoint;\n  ;; format-patch SHA-256 776019b9954113c13a74c7e8fce309040e33a99da859a9620701a9f094513c9f;\n  ;; upstream report text in collab/1792824446211-engineer-canonical-adjudication-fixes...).\n  ;; Former patch 0001-sorted-user-types (base 96d7b866) is retired;\n  ;; the patch mechanism stays available for future patches.\n  :patches []}\n\n ;; Host OS packages (owner 2026-10-20: Linux = the Debian family with apt).\n ;; `bb bootstrap:jolt` checks :required with dpkg-query on hosts whose\n ;; /etc/os-release ID or ID_LIKE names debian, BEFORE anything mise builds,\n ;; and fails naming the missing packages and the exact\n ;; `sudo apt-get install -y ...` command. It never runs sudo or apt.\n ;; :unverified entries are candidates with no step shown to need them yet;\n ;; they are listed, not checked. Chez and CMake stay mise-provided.\n :os-packages\n {:debian\n  {:required\n   {;; mise builds Chez 10.4.1 from source and links it against ncurses;\n    ;; verified on shiva (Ubuntu 24.04.5): \"cannot find -lncurses\" until\n    ;; this was installed (docs/orchestrator-log.md, J0b-on-shiva entry)\n    \"libncurses-dev\" \"mise Chez source build (link)\"\n    ;; Chez's expression editor (c/expeditor.c:1189-1212) reads the X11\n    ;; clipboard; verified on jupiter (Ubuntu 24.04.5): the build failed with\n    ;; \"c/expeditor.c:1191: fatal error: X11/Xlib.h: No such file or\n    ;; directory\" until this was installed (shiva had the headers already,\n    ;; so it never failed there). Chez's configure also offers --disable-x11\n    ;; and --disable-curses, which the mise plugin does not pass.\n    \"libx11-dev\" \"mise Chez source build (compile, X11 clipboard in the editor)\"\n    ;; the same Chez source build compiles and links C (the failing step\n    ;; above was its link); present on shiva, so not independently shown\n    \"gcc\" \"mise Chez source build (C compiler)\"\n    \"make\" \"mise Chez source build (make)\"\n    ;; bootstrap:jolt clones jolt and its submodules (src/dev/jolt_bootstrap.clj)\n    \"git\" \"bootstrap:jolt clone and verification\"\n    ;; J1b: native/jolt-crypto compiles against the libcrypto headers\n    ;; (openssl/evp.h) and links the declared :native :libcrypto path\n    \"libssl-dev\" \"J1b native build (libcrypto headers and link, native/jolt-crypto)\"}\n   ;; J1b runtime: the package owning the declared libcrypto.so.3 differs per\n   ;; release, so any ONE of these satisfies it (dpkg -S on shiva, Ubuntu\n   ;; 24.04: libssl3t64; Debian bookworm and Ubuntu 22.04: libssl3). Checked\n   ;; by `bb build:jolt-native`, not by `bb bootstrap:jolt` (which checks\n   ;; :required only). The library itself is checked against :native\n   ;; :libcrypto :qualified.\n   :runtime-any-of\n   {\"libcrypto.so.3 (J1b dao.host.hash/sign)\" [\"libssl3t64\" \"libssl3\"]}\n   :unverified\n   {;; J0c native build (jolt-j0c branch, bb build:jolt-native) compiles the\n    ;; ANTLR4 C++ runtime and wrapper and unzips the runtime source; shown on\n    ;; macOS only, not yet on a Debian host\n    \"g++\" \"J0c native build (C++ compiler)\"\n    \"unzip\" \"J0c native build (runtime source archive)\"}}\n  ;; Homebrew is assumed on macOS and not enforced; the libcrypto it provides\n  ;; is checked by path and version instead (:native :libcrypto, J1b).\n  :macos {:manager :homebrew :enforced false\n          :packages {\"openssl@3\" \"libcrypto for dao.host.hash/sign (J1b)\"}}}\n\n ;; Provisioned by mise from the exact pins in mise.toml. JOLT_CHEZ is always\n ;; set explicitly (build/tools/jolt-env.sh), never left to jolt's PATH search.\n :chez {:version \"10.4.1\"\n        :provider :mise\n        :mise-tool \"chezscheme\"\n        :threaded true\n        :binary \"bin/scheme\"}\n :cmake {:version \"4.4.4\"\n         :provider :mise\n         :mise-tool \"cmake\"}\n\n ;; Recorded at J0a round 1 on the platforms actually run.\n :observed\n {:macos-arm64 {:os \"macOS 26.6.2 (25G83)\"\n                :chez-path \"~/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme\"\n                :cmake-path \"~/.local/share/mise/installs/cmake/4.4.4/cmake-4.4.4-macos-universal/CMake.app/Contents/bin/cmake\"\n                :cc \"Apple clang version 21.0.0 (clang-2100.1.1.101)\"\n                ;; J1b, 2026-10-21 (Homebrew openssl@3)\n                :libcrypto {:path \"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\"\n                            :resolved \"/opt/homebrew/Cellar/openssl@3/3.6.3/lib/libcrypto.3.dylib\"\n                            :version \"OpenSSL 3.6.3 9 Jun 2026\"}}\n  ;; shiva.stigmergy.systems, J1b 2026-10-21 (scratch clone ~/ci/datomworld-jolt-j1b)\n  :linux-x86_64 {:os \"Ubuntu 24.04.5 LTS (kernel 6.8.0-147-generic)\"\n                 :chez-path \"~/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme\"\n                 :cmake-path \"~/.local/share/mise/installs/cmake/4.4.4/cmake-4.4.4-linux-x86_64/bin/cmake\"\n                 :cc \"cc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0\"\n                 :libcrypto {:path \"/usr/lib/x86_64-linux-gnu/libcrypto.so.3\"\n                             :resolved \"/usr/lib/x86_64-linux-gnu/libcrypto.so.3\"\n                             :version \"OpenSSL 3.0.13 30 Jan 2024\"\n                             :package \"libssl3t64 3.0.13-0ubuntu3.16\"}}}\n\n ;; Vendored native sources (§6.1, Q4): fetched by `bb build:jolt-native`\n ;; only when absent from build/native/src, accepted only at the pinned\n ;; SHA-256, built with the mise-pinned CMake into build/native/<platform>/.\n ;; Nothing downloads during namespace loading. :libcrypto is the one system\n ;; (not vendored) entry: declared by path and minimum version, never fetched.\n :native\n {:antlr4-cpp-runtime\n  {:version \"4.13.2\"\n   :license \"BSD-3-Clause\"\n   ;; the official C++ runtime source distribution (antlr4 doc/cpp-target.md);\n   ;; the GitHub release carries no C++ asset\n   :url \"https://www.antlr.org/download/antlr4-cpp-runtime-4.13.2-source.zip\"\n   :sha256 \"0ed13668906e86dbc0dcddf30fdee68c10203dea4e83852b4edb810821bee3c4\"\n   :upstream {:repo \"https://github.com/antlr/antlr4\"\n              :tag \"4.13.2\"\n              :tag-object \"2ac185af855ff39b4b8c41854b756767099c356f\"\n              :commit \"cc82115a4e7f53d71d9d905caa2c2dfa4da58899\"\n              :path \"runtime/Cpp\"}\n   ;; static, position-independent: linked into the one wrapper dylib that\n   ;; jolt loads, so no second library or rpath is resolved at load time.\n   ;; Tests off: ANTLR_BUILD_CPP_TESTS=ON downloads googletest at configure\n   ;; time.\n   :cmake-flags [\"-DCMAKE_BUILD_TYPE=Release\"\n                 \"-DANTLR_BUILD_CPP_TESTS=OFF\"\n                 \"-DANTLR_BUILD_SHARED=OFF\"\n                 \"-DANTLR_BUILD_STATIC=ON\"\n                 \"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\"\n                 \"-DCMAKE_CXX_STANDARD=17\"]}\n\n  ;; §6.2: the upstream BLAKE3 C reference (c/ of the release), built static\n  ;; and position-independent and linked into native/jolt-crypto. Portable C\n  ;; only (BLAKE3_SIMD_TYPE=none, the option name verified in c/CMakeLists.txt\n  ;; at this tag); SIMD is a later, separately measured change.\n  :blake3\n  {:version \"1.8.7\"\n   :license \"CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception\"\n   ;; GitHub's tag archive; downloaded twice 2026-10-21, both SHA-256 equal\n   :url \"https://github.com/BLAKE3-team/BLAKE3/collab/refs/tags/1.8.7.tar.gz\"\n   :sha256 \"c6782a28842b1c0478524ac06a4f2ede784038ee298d6e2162c0b089c4306a3c\"\n   ;; saved under build/native/src by this name (the URL ends in 1.8.7.tar.gz)\n   :archive-name \"BLAKE3-1.8.7.tar.gz\"\n   :upstream {:repo \"https://github.com/BLAKE3-team/BLAKE3\"\n              :tag \"1.8.7\"\n              ;; a lightweight tag: refs/tags/1.8.7 names the commit directly\n              :commit \"f3149ec5bb5449af877ba20377a11008ff499fa2\"\n              :released \"2026-08-20T09:06:20Z\"\n              :path \"c\"}\n   :cmake-flags [\"-DCMAKE_BUILD_TYPE=Release\"\n                 \"-DBUILD_SHARED_LIBS=OFF\"\n                 \"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\"\n                 \"-DCMAKE_INSTALL_LIBDIR=lib\"\n                 \"-DBLAKE3_SIMD_TYPE=none\"\n                 \"-DBLAKE3_USE_TBB=OFF\"\n                 \"-DBLAKE3_FETCH_TBB=OFF\"\n                 \"-DBUILD_TESTING=OFF\"]}\n\n  ;; §6.3 / Q4: the SYSTEM libcrypto, never vendored. native/jolt-crypto links\n  ;; it by :path (install name on macOS, -rpath on Linux). Never Apple's\n  ;; libcrypto (it aborts inside EVP_Digest).\n  ;;\n  ;; :qualified is the one library per platform that passed the J1b gates:\n  ;; its canonical real path, exact OpenSSL_version_num and the SHA-256 of\n  ;; the file. Any difference fails closed until requalified, so a Homebrew\n  ;; or apt upgrade (new version, and on Homebrew a repointed opt/ link), and\n  ;; a same-path, same-version package replacement (new digest) all refuse:\n  ;;   * `bb build:jolt-native` (check-libcrypto!) fails on a canonical path\n  ;;     or digest that differs (it cannot read the version without loading\n  ;;     the library);\n  ;;   * loading dao.host.hash fails on canonical path, version or digest, as\n  ;;     the wrapper reports them for the library the EVP entries resolved to.\n  ;; :min-version is separate: the lowest version a requalification may\n  ;; accept.\n  ;;\n  ;; Requalification (the upgrade gate, §6.4), on the platform that changed:\n  ;;   1. `bb build:jolt-native --requalify` (builds against the changed\n  ;;      library; skips only the :qualified comparison, and says so in the\n  ;;      build record);\n  ;;   2. `bb qualify:jolt-libcrypto` prints the observed {:canonical-path\n  ;;      :version-num :version :sha256} (the digest computed by bb and by\n  ;;      the library, required equal; the version at least :min-version)\n  ;;      and changes nothing;\n  ;;   3. replace this platform's :qualified entry with it, review the diff;\n  ;;   4. `bb build:jolt-native`, `bb compare:jolt-host`, `bb\n  ;;      probe:jolt-crypto`, all of which must pass.\n  :libcrypto\n  {:provider :system\n   :soname {:darwin-arm64 \"libcrypto.3.dylib\" :linux-x86_64 \"libcrypto.so.3\"}\n   :path {:darwin-arm64 \"/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib\"\n          :linux-x86_64 \"/usr/lib/x86_64-linux-gnu/libcrypto.so.3\"}\n   :include {:darwin-arm64 \"/opt/homebrew/opt/openssl@3/include\"\n             :linux-x86_64 \"/usr/include\"}\n   :min-version \"3.0.0\"\n   ;; qualified 2026-10-21 (J1b): macOS from this checkout, Linux on shiva\n   :qualified\n   {:darwin-arm64 {:canonical-path \"/opt/homebrew/Cellar/openssl@3/3.6.3/lib/libcrypto.3.dylib\"\n                   :version-num 811597872\n                   :version \"OpenSSL 3.6.3 9 Jun 2026\"\n                   :sha256 \"a12805a18cd5e4f733fa8727b91afa08b587f9da5a760517cd79cb508a3a3f71\"}\n    :linux-x86_64 {:canonical-path \"/usr/lib/x86_64-linux-gnu/libcrypto.so.3\"\n                   :version-num 805306576\n                   :version \"OpenSSL 3.0.13 30 Jan 2024\"\n                   :sha256 \"6866ed711dab8927e1bf82bf1cd30e828bdfc34f3cc1e83b1c9eb01ce6c37d9a\"}}\n   ;; Debian runtime packages: checked by `bb build:jolt-native`, NOT by\n   ;; `bb bootstrap:jolt` (which checks only :os-packages :debian :required,\n   ;; libssl-dev among them); macOS: Homebrew openssl@3, unenforced\n   :debian-runtime-any-of [\"libssl3t64\" \"libssl3\"]}}}\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n                                 ;; oracle backend: Datomic Local, in-process,\n                                 ;; run in docker/oracle (dev-scope only)\n                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.repl.main\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yin.repl.python-antlr-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:clojuredart:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine\n2:  \"The local Yin shell for DaoStream: explicit state, synchronous steps.\n53:   shell is the only appender and its one step owner serializes evaluation, so\n100:   `query-pair-capacity` times this, 16 MiB.\"\n106:   elements.  A VM makes one call at a time and the shell answers it in\n117:   time, so a round that spends it is answering requests the shell's VM\n136:       \" times and was stopped (:yin.repl.query/call-limit)\"))\n261:       \"  (host)  - the runtime this REPL runs on\\n\"\n270:  \"One line naming the runtime: JVM and Node carry their version, Dart only\n544:      (loop [remaining drain-budget\n680:  \"The run step the evaluator observer hands each loaded program: run the\n699:   attachment entry bound to it for this medium's lifetime, and an observer\n747:   lifetime.\n861:   here, never switched at runtime, and supplying it together with\n875:   Its step-owner value is `:dht`, advanced only by `yin.repl.dht/step`\n900:   host's single step owner can advance it (yin.repl.main/step-all --\n901:   the custody control step runs during hydration and through the\n902:   bounded shutdown drain; the custody program step runs only while\n904:   steps it; nil, the default, is today's behaviour.\n1035:  (loop [chars (seq s)\n1098:   shows its value as that renders it, the loop printing for every language.\"\n1126:    (loop [observer observer]\n1180:  (update state :indexer index/step (:round state)))\n1189:  (update state :ast-indexer ast-index/step))\n1193:  \"Append what the round's index steps lost, if anything, to its result\n1210:        (macro/step {:observer (:observer state), :consumer (:expander state)})\n1332:  (loop [i 0\n1395:   resumed require halts outside the observer loop, so the shell emits\n1433:  \"Give up the shell's `:pending-run` (section 7.2, step 7, the abandoned\n1546:   line re-checks the link, the host may step one itself with\n1795:   of the runtime it would run on.  The session itself is not touched.\"\n1893:   thrown, so a mistyped command cannot end a step.\"\n1975:  (loop [state state\n2048:   the step an unattended host drives at its own cadence\n2128:(defn eval-input\n2135:   driver, not this namespace, decides when the next step happens.\"\n","exit_code":0,"status":"completed"}}
