n   234\t                                      \"(loop [i 0] (if (< i 5) (recur (inc i)) i))\")\n   235\t                 (driver/repl-step state (poller/clock-ms)))]\n   236\t    (timed-call! trace? timings round :repl-step\n   237\t                 (fn []\n   238\t                   (if-not trace?\n   239\t                     (step!)\n   240\t                     (let [code-step repl.index/step\n   241\t                           ast-step repl.ast-index/step]\n   242\t                       ;; Diagnostic wrappers stay on the single owner thread.\n   243\t                       (with-redefs [repl.index/step\n   244\t                                     (fn [ix r]\n   245\t                                       (timed-call! true timings round :code-index\n   246\t                                                    #(code-step ix r)))\n   247\t                                     repl.ast-index/step\n   248\t                                     (fn [ix]\n   249\t                                       (timed-call! true timings round :ast-index\n   250\t                                                    #(ast-step ix)))]\n   251\t                         (step!))))))))\n   252\t\n   253\t\n   254\t(defn run-workload-w\n   255\t  \"Run the pre-registered Workload W benchmark:\n   256\t   - Peer A: one 4,194,304 byte binary message (:ws/max-frame-bytes) paced over >= 60 s.\n   257\t   - Peer B: 1 KiB request/reply concurrent (up to 8 outstanding) at 10 Hz.\n   258\t   - REPL loop: evaluates a submitted loop each round, step count advances every round.\n   259\t   - Criterion: p99 <= 250 ms, no reply lost, A delivered once, REPL step advances every round.\n   260\t   Run through bb workload-w:jolt for the independent five-minute watchdog.\n   261\t   Returns {:pass? ... :p99 ... :samples ... :elapsed-ms ... :delivered-once? ... :repl-advances? ...}.\"\n   262\t  [& {:keys [target-duration-ms target-samples]\n   263\t      :or {target-duration-ms 60000 target-samples 600}}]\n   264\t  (println \"================================================================================\")\n   265\t  (println \"J6g Workload W: Starting benchmark (target duration:\" target-duration-ms\n   266\t           \"ms, target samples:\" target-samples \")\")\n   267\t  (println \"================================================================================\")\n   270\t        w (wake/make-wake)\n   271\t        server-inst (wsj/create)\n   272\t        client-b-inst (wsj/create)\n   273\t\n   274\t        ;; Peer A accounting\n   275\t        a-deliveries (atom [])\n   276\t        a-window (atom {})\n   277\t        trace? (= \"1\" (System/getenv \"JOLT_WORKLOAD_W_TRACE\"))\n   278\t        timings (atom {})\n   279\t\n   280\t        ;; Server bind\n   281\t        server-bound? (atom false)\n   282\t        server-port (atom 0)\n   283\t        _ (wsj/bind! server-inst\n   284\t                     {:bind-host \"127.0.0.1\"\n   285\t                      :bind-port 0\n   286\t                      :ws/max-frame-bytes 4194304\n   287\t                      :codecs [cbor/profile]\n   288\t                      :deposit! (fn [event detail]\n   289\t                                  (when (= :bind-succeeded event)\n   290\t                                    (reset! server-port (:port detail))\n   291\t                                    (reset! server-bound? true)))\n   292\t                      :accept! (fn [path seam _now]\n   293\t                                 (cond\n   294\t                                   (= path \"/peer-a\")\n   295\t                                   {:ws/adapter\n   296\t                                    {:opened! (fn [])\n   297\t                                     :binary! (fn [payload]\n   298\t                                                (swap! a-deliveries conj (alength payload))\n   299\t                                                (swap! a-window\n   300\t                                                       #(if (:delivered-at %)\n   301\t                                                          %\n   302\t                                                          (assoc % :delivered-at (poller/clock-ms)))))\n   303\t                                     :message! (fn [_])\n   304\t                                     :closed! (fn [_ _])\n   420\t              last-10hz-tick (atom (- start-time 100))\n   421\t              last-telemetry-tick (atom start-time)\n   422\t              a-stalls (atom 0)\n   423\t              a-stalled? (atom false)\n   424\t              timed-out? (atom false)\n   425\t              max-consecutive-stalls 500\n   426\t              server-pump (wsj/host-pump server-inst)\n   427\t              client-b-pump (wsj/host-pump client-b-inst)]\n   428\t\n   429\t          (println \"Frame length for Peer A:\" total-a-frame-len \"bytes\")\n   430\t          (println \"Entering owner round loop...\")\n   431\t          (flush)\n   432\t\n   433\t          ;; Main owner loop\n   434\t          (loop []\n   435\t            (let [now (poller/clock-ms)\n   436\t                  elapsed (- now start-time)]\n   437\t\n   438\t              ;; Hard timeout guard: cap whole run at 5 minutes\n   439\t              (if (>= now deadline)\n   440\t                (do (reset! timed-out? true)\n   441\t                    (println \"HARD CAP EXCEEDED: workload-w exceeded 5 minutes (\"\n   442\t                             (- now run-start) \"ms), terminating loop.\"))\n   443\t\n   444\t                (do\n   445\t                  ;; 1. Advance owner round and step REPL loop\n   446\t                  (swap! owner-round-count inc)\n   447\t                  (when (= 1 @owner-round-count)\n   448\t                    (println \"W-PHASE repl-step\")\n   449\t                    (flush))\n   450\t                  (let [before @repl-state\n   451\t                        stepped (step-repl! before trace? timings @owner-round-count)\n   452\t                        [entries next-st] (driver/take-outbox stepped)\n   456\t                                  (get-in next-st [:repl :round]))\n   457\t                               (= [\"5\"] (mapv #(get % driver/text-key) results)))\n   458\t                      (swap! repl-step-count inc)))\n   459\t\n   460\t                  ;; 2. Paced Peer A transfer across target-duration-ms (with no-progress guard)\n   461\t                  (when (= 1 @owner-round-count)\n   462\t                    (println \"W-PHASE peer-a-send\")\n   463\t                    (flush))\n   464\t                  (when-not @a-stalled?\n   465\t                    (let [a-start (:started-at @a-window)\n   466\t                          target-bytes (if a-start\n   467\t                                         (min total-a-frame-len\n   468\t                                              (inc (long (* (dec total-a-frame-len)\n   469\t                                                            (/ (- (poller/clock-ms) a-start)\n   470\t                                                               (double target-duration-ms))))))\n   471\t                                         1)]\n   472\t                      (when (< @a-sent target-bytes)\n   473\t                        (let [to-write (min (- target-bytes @a-sent) 65536)\n   474\t                              r (timed-call! trace? timings @owner-round-count :peer-a-send\n   475\t                                             #(write-some! (:fd raw-a) a-frame @a-sent to-write))]\n   476\t                          (cond\n   477\t                            (or (= :would-block r) (= 0 r))\n   478\t                            (let [stalls (swap! a-stalls inc)]\n   479\t                              (native/poll-one (:fd raw-a) native/pollout 0)\n   480\t                              (when (>= stalls max-consecutive-stalls)\n   481\t                                (reset! a-stalled? true)\n   482\t                                (println \"TRANSFER ST