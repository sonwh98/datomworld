ic trace enabled:     \" trace?)\n   608\t            (println \"W-TIMINGS\" (pr-str @timings))\n   609\t            (println \"  Sample count:                 \" sample-count\n   610\t                     (str \"(valid >= 500: \" valid-run? \", target >= \" target-samples \": \" target-samples-met? \")\"))\n   611\t            (println \"  p99 round-trip latency:       \" (if (some? p99) (str p99 \"ms\") \"ABSENT\")\n   612\t                     (str \"(criterion <= 250 ms: \" p99-ok? \")\"))\n   613\t            (println \"  Peer B replies lost:          \" replies-lost \"(unanswered) +\" @b-lost \"(corrupt)\")\n   614\t            (println \"  Peer A delivered once:        \" delivered-once?\n   615\t                     (str \"(deliveries: \" a-deliv-count \", bytes: \" a-deliv-len \", sent: \" @a-sent \")\"))\n   616\t            (println \"  REPL per-round step advance:  \" repl-advances?\n   617\t                     (str \"(rounds: \" @owner-round-count \", REPL steps: \" @repl-step-count \")\"))\n   618\t            (println)\n   619\t\n   620\t            ;; Required report records per BRIEF-j6g.md\n   621\t            (if (some? p99)\n   622\t              (println \"RECORD p99\" p99 \"ms\")\n   623\t              (println \"RECORD p99 ABSENT\"))\n   624\t            (println \"RECORD sample count\" sample-count)\n   625\t            (println \"RECORD elapsed ms\" elapsed-ms)\n   626\t            (println \"RECORD delivered once\" delivered-once?)\n   627\t            (println \"RECORD per-round step advance\" repl-advances?)\n    23\t(defn- observe-line\n    24\t  [state line]\n    25\t  (cond\n    26\t    (str/starts-with? line \"W-SAMPLE \")\n    27\t    (let [sample (try (edn/read-string (subs line 9)) (catch Exception _ nil))]\n    28\t      (if (and (number? sample) (<= 0 sample))\n    29\t        (-> state\n    30\t            (update :samples conj sample)\n    31\t            (assoc :last-output-at (now-ms)))\n    32\t        (assoc state :sample-error line)))\n    33\t\n    34\t    (str/starts-with? line \"W-CALL \")\n    35\t    (let [call (try (edn/read-string (subs line 7)) (catch Exception _ nil))\n    36\t          valid? (and (map? call) (integer? (:round call)) (keyword? (:phase call))\n    37\t                      (contains? #{:enter :leave} (:event call)))]\n    38\t      (if-not valid?\n    39\t        (assoc state :trace-error line)\n    40\t        (let [state (assoc state :last-output-at (now-ms))]\n    41\t          (case (:event call)\n    42\t            :enter (let [call (assoc call :observed-at (now-ms))]\n    43\t                     (-> state\n    44\t                         (update :call-stack (fnil conj []) call)\n    45\t                         (assoc :active-call call :call-entered-at (:observed-at call))))\n    46\t            :leave (if (= (select-keys call [:round :phase])\n    47\t                          (select-keys (:active-call state) [:round :phase]))\n    48\t                     (let [stack (pop (:call-stack state))\n    49\t                           active (peek stack)]\n    50\t                       (assoc state :call-stack stack :active-call active\n    51\t                              :call-entered-at (:observed-at active) :last-call call))\n    52\t                     (assoc state :trace-error line))))))\n    53\t\n    54\t    :else\n    55\t    (do\n    56\t      (println line)\n    57\t      (flush)\n    58\t      (cond-> (assoc state :last-output-at (now-ms))\n    59\t        (str/starts-with? line \"W-PHASE \") (assoc :phase (subs line 8))\n    60\t        (= line \"FAIL workload-w\") (assoc :reported-failure? true)))))\n    61\t\n    81\t(defn- telemetry!\n    82\t  [state elapsed]\n    83\t  (println \"WATCHDOG TELEMETRY\"\n    84\t           (pr-str {:elapsed-ms elapsed,\n    85\t                    :samples (count (:samples state)),\n    86\t                    :running-p99-ms (or (p99 (:samples state)) \"ABSENT\"),\n    87\t                    :first-round-phase (:phase state),\n    88\t                    :active-call (:active-call state),\n    89\t                    :active-call-age-ms (when-let [entered (:call-entered-at state)]\n    90\t                                          (- (now-ms) entered)),\n    91\t                    :last-call (:last-call state),\n    92\t                    :output-age-ms (- (now-ms) (:last-output-at state))}))\n    93\t  (flush))\n    94\t\n    95\t\n    96\t(defn- failure!\n    97\t  [state elapsed reason]\n    98\t  (println \"Workload W Results: FAILURE\")\n    99\t  (println \"RECORD failure reason\" reason)\n   100\t  (println \"RECORD p99 ABSENT\")\n   101\t  (println \"RECORD sample count\" (count (:samples state)))\n   102\t  (println \"RECORD elapsed ms\" elapsed)\n   103\t  (println \"RECORD active call\" (pr-str (:active-call state)))\n   104\t  (println \"FAIL workload-w\")\n   105\t  (flush))\n   106\t\n   107\t\n   108\t(defn- kill-tree!\n   109\t  [process]\n   110\t  (let [root (.toHandle process)\n   111\t        tree (conj (vec (iterator-seq (.iterator (.descendants root)))) root)]\n   112\t    ;; Capture descendants before signaling: launcher children may be reparented.\n   150\t              (>= elapsed hard-cap-ms)\n   151\t              (do\n   152\t                (kill-tree! process)\n   153\t                (failure! state elapsed :hard-cap)\n   154\t                1)\n   155\t\n   156\t              (not (.isAlive process))\n   157\t              ;; Drain already-buffered output without waiting for another line.\n   158\t              (if (and (not (:eof? state)) (.ready reader))\n   159\t                (recur state next-telemetry)\n   160\t                (let [state (if (str/blank? (:partial state))\n   161\t                              state\n   162\t                              (observe-line state (:partial state)))\n   163\t                      status (.exitValue process)]\n   164\t                  (when (and (not (zero? status)) (not (:re