{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/jolt/dao/stream/ws/pump.jolt | sed -n '590,860p'; nl -ba src/jolt/dao/stream/ws/jolt.jolt | sed -n '148,227p'; nl -ba src/cljc/dao/stream/ws/rfc6455.cljc | sed -n '1,300p'\"","aggregated_output":"   590\t  [p h payload]\n   591\t  (cell! h update :pongs inc)\n   592\t  (enqueue! p h (frame h :pong payload) :pong))\n   593\t\n   594\t\n   595\t(defn- handle-event!\n   596\t  [p h ev]\n   597\t  (let [{:keys [local peer]} (:close (cell h))]\n   598\t    (case (:type ev)\n   599\t      :ping (when (nil? local) (pong! p h (:payload ev)))\n   600\t      :pong nil\n   601\t      :message (when (and (nil? local) (nil? peer))\n   602\t                 (when-let [f (:on-message (cell h))] (f ev)))\n   603\t      :close (when (nil? peer)\n   604\t               (peer-close! p h (if (nil? (:code ev)) :absent (:code ev)) (:code ev) (:reason ev)))\n   605\t      :fail (if (:close? ev)\n   606\t              (when (nil? peer) (peer-close! p h :invalid nil nil))\n   607\t              (fail-connection! p h (:code ev) (:reason ev)))\n   608\t      nil)))\n   609\t\n   610\t\n   611\t(defn- parse-input!\n   612\t  \"Parse `chunk` from `offset` one frame at a time until it is consumed,\n   613\t   the connection ends, or the pong budget fills; keep the unparsed rest.\"\n   614\t  [p h chunk offset]\n   615\t  (let [parse (:parse-frame (:protocol (cell h)))\n   616\t        n (alength chunk)]\n   617\t    (loop [off offset]\n   618\t      (cond\n   619\t        (not (open? h)) nil\n   620\t        (>= off n) (cell! h assoc :remainder nil)\n   621\t        (>= (:pongs (cell h)) max-pongs) (cell! h assoc :remainder {:chunk chunk, :offset off})\n   622\t        :else (let [[ev parser' off'] (parse (:parser (cell h)) chunk off)]\n   623\t                (cell! h assoc :parser parser')\n   624\t                (if (nil? ev)\n   625\t                  (cell! h assoc :remainder nil)\n   626\t                  (do (handle-event! p h ev)\n   627\t                      (recur off'))))))))\n   628\t\n   629\t\n   630\t(defn- resume!\n   631\t  \"Parse a held remainder once the pong budget has room; answers whether\n   632\t   anything was parsed.\"\n   633\t  [p h]\n   634\t  (when (and (open? h) (< (:pongs (cell h)) max-pongs))\n   635\t    (when-let [{:keys [chunk offset]} (:remainder (cell h))]\n   636\t      (parse-input! p h chunk offset)\n   637\t      true)))\n   638\t\n   639\t\n   640\t;; =============================================================================\n   641\t;; Reads and visits (A1)\n   642\t;; =============================================================================\n   643\t\n   644\t(defn- read-once!\n   645\t  \"One recv chunk into the reused buffer; answers whether anything\n   646\t   happened.\"\n   647\t  [p h]\n   648\t  (let [rbuf (:rbuf @(st p))\n   649\t        r (tcp/recv-chunk! (:fd h) rbuf chunk-bytes)\n   650\t        ws? (= :ws (:mode (cell h)))]\n   651\t    (cond\n   652\t      (= :would-block r) false\n   653\t      (= :eof r) (do (if ws?\n   654\t                       (terminate! p h :eof nil)\n   655\t                       (do (cell! h assoc :reading? false :eof? true)\n   656\t                           (when-let [f (:on-eof (cell h))] (owe! p f))))\n   657\t                     true)\n   658\t      (:error r) (do (fail! p h r) true)\n   659\t      :else (let [chunk (ffi/read-array rbuf (:n r))]\n   660\t              (if ws?\n   661\t                ;; a failed connection reads only to see EOF or reset: the\n   662\t                ;; input is discarded, never parsed\n   663\t                (when-not (:failed? (:close (cell h))) (parse-input! p h chunk 0))\n   664\t                (when-let [f (:on-data (cell h))] (f chunk)))\n   665\t              true))))\n   666\t\n   667\t\n   668\t(def ^:private write-ready (bit-or native/pollout native/pollerr native/pollhup native/pollnval))\n   669\t\n   670\t\n   671\t(defn- visit-connection!\n   672\t  [p h rev]\n   673\t  (let [wrote? (when (and (pos? (bit-and rev write-ready)) (seq (:pending (cell h))))\n   674\t                 (drain-once! p h))\n   675\t        ;; resume before read: a held remainder is parsed first, and read\n   676\t        ;; interest returns only once it is consumed\n   677\t        resumed? (resume! p h)\n   678\t        read? (when (and (not resumed?) (open? h) (read-interest? h)\n   679\t                         (pos? (bit-and rev native/poll-readable)))\n   680\t                (read-once! p h))]\n   681\t    (boolean (or wrote? resumed? read?))))\n   682\t\n   683\t\n   684\t(defn- visit-connecting!\n   685\t  [p h rev]\n   686\t  (when (pos? rev)\n   687\t    (let [r (tcp/connect-result (:fd h))]\n   688\t      (if (map? r)\n   689\t        (fail! p h r)\n   690\t        (do (cell! h assoc :kind :connection)\n   691\t            (when-let [f (:on-connected (cell h))] (owe! p f)))))\n   692\t    true))\n   693\t\n   694\t\n   695\t(defn- can-accept?\n   696\t  [p lh]\n   697\t  (let [{:keys [status accepting? max-pending-upgrades max-connections]} (cell lh)\n   698\t        mine (owned p lh)]\n   699\t    (and (= :open status) accepting?\n   700\t         (< (count (filter #(:upgrading? (cell %)) mine)) max-pending-upgrades)\n   701\t         (or (nil? max-connections) (< (count mine) max-connections)))))\n   702\t\n   703\t\n   704\t(defn- visit-listener!\n   705\t  [p h]\n   706\t  (loop [i 0, moved? false]\n   707\t    (if (or (= i accept-batch) (not (can-accept? p h)))\n   708\t      moved?\n   709\t      (let [r (tcp/accept! (:fd h))]\n   710\t        (cond\n   711\t          (= :would-block r) moved?\n   712\t          (:error r) (do (when-let [f (:on-accept-error (cell h))] (owe! p #(f r))) true)\n   713\t          ;; :on-accept runs inside the visit: the callee's registration is\n   714\t          ;; what the pending-upgrade cap counts. Without one, nobody owns\n   715\t          ;; the descriptor, so it is closed rather than leaked.\n   716\t          :else (do (if-let [f (:on-accept (cell h))]\n   717\t                      (f r)\n   718\t                      (tcp/close! (:fd r)))\n   719\t                    (recur (inc i) true)))))))\n   720\t\n   721\t\n   722\t(defn interest\n   723\t  \"`[[fd events] ...]` for this instance's next poll, registration order.\"\n   724\t  [p]\n   725\t  (vec (keep (fn [h]\n   726\t               (let [{:keys [kind pending]} (cell h)\n   727\t                     ev (case kind\n   728\t                          :listener (if (can-accept? p h) native/pollin 0)\n   729\t                          :connecting native/pollout\n   730\t                          :connection (bit-or (if (read-interest? h) native/pollin 0)\n   731\t                                              (if (seq pending) native/pollout 0)))]\n   732\t                 (when (pos? ev) [(:fd h) ev])))\n   733\t             (sort-by :id (vals (:handles @(st p)))))))\n   734\t\n   735\t\n   736\t(defn- runnable-remainder?\n   737\t  [h]\n   738\t  (let [{:keys [remainder pongs]} (cell h)]\n   739\t    (and remainder (< pongs max-pongs))))\n   740\t\n   741\t\n   742\t(defn next-deadline\n   743\t  \"The nearest due time on `jolt.io-poller/clock-ms`: now while a report is\n   744\t   owed or a held remainder can be parsed; else the nearest upgrade, close\n   745\t   or registered deadline; nil when nothing is due (an empty registry).\"\n   746\t  [p]\n   747\t  (let [{:keys [handles notify closed-listeners]} @(st p)\n   748\t        hs (vals handles)\n   749\t        ;; a closed listener is due only once its drain report is owed: while\n   750\t        ;; it still owns connections, their own deadlines bound the wait\n   751\t        drained (some (fn [[_ lh]] (empty? (owned p lh))) closed-listeners)]\n   752\t    (if (or (seq notify) drained (some runnable-remainder? hs))\n   753\t      (poller/clock-ms)\n   754\t      (let [ds (mapcat (fn [h]\n   755\t                         (let [c (cell h)]\n   756\t                           (keep identity [(:deadline c) (:upgrade-deadline c)\n   757\t                                           (:deadline (:close c))])))\n   758\t                       hs)]\n   759\t        (when (seq ds) (reduce min ds))))))\n   760\t\n   761\t\n   762\t(defn- deliver-notify!\n   763\t  [p]\n   764\t  (let [owed (:notify @(st p))]\n   765\t    (swap! (st p) assoc :notify [])\n   766\t    (doseq [f owed] (f))\n   767\t    (boolean (seq owed))))\n   768\t\n   769\t\n   770\t(defn- expire!\n   771\t  \"Run every due deadline; answers whether any fired.\"\n   772\t  [p]\n   773\t  (let [now (poller/clock-ms)\n   774\t        due? #(and % (<= % now))\n   775\t        fired (atom false)]\n   776\t    (doseq [h (sort-by :id (vals (:handles @(st p))))]\n   777\t      (let [c (cell h)]\n   778\t        (cond\n   779\t          (not (registered? p h)) nil\n   780\t          (due? (:upgrade-deadline c))\n   781\t          (do (reset! fired true)\n   782\t              (release! p h :closed)\n   783\t              (when-let [f (:on-upgrade-expired c)] (owe! p f)))\n   784\t          (due? (:deadline (:close c)))\n   785\t          (do (reset! fired true)\n   786\t              (cond\n   787\t                (= :ws (:mode c)) (terminate! p h :deadline nil)\n   788\t                (:upgrading? c) (do (release! p h :closed)\n   789\t                                    (when-let [f (:on-upgrade-expired c)] (owe! p f)))\n   790\t                ;; a plain :raw stream has no upgrade to expire: its lowered\n   791\t                ;; deadline ends it as a failure\n   792\t                :else (fail! p h {:error :close-deadline, :class :other})))\n   793\t          (due? (:deadline c))\n   794\t          (let [f (:on-deadline c)]\n   795\t            (reset! fired true)\n   796\t            (cell! h dissoc :deadline :on-deadline)\n   797\t            (when f (f))))))\n   798\t    @fired))\n   799\t\n   800\t\n   801\t(defn- report-drained!\n   802\t  [p]\n   803\t  (doseq [[id lh] (:closed-listeners @(st p))]\n   804\t    (when (empty? (owned p lh))\n   805\t      (swap! (st p) update :closed-listeners dissoc id)\n   806\t      (when-let [f (:on-drained (cell lh))] (owe! p f)))))\n   807\t\n   808\t\n   809\t(defn- rotation\n   810\t  \"The handles named in `ready`, in registration order starting after the\n   811\t   id visited last.\"\n   812\t  [p ready]\n   813\t  (let [{:keys [handles last-id]} @(st p)\n   814\t        revents (reduce (fn [m [fd rev]] (update m fd (fnil bit-or 0) rev)) {} ready)\n   815\t        hs (sort-by (comp :id first)\n   816\t                    (keep (fn [[fd rev]]\n   817\t                            (when-let [h (get handles fd)]\n   818\t                              (when (pos? rev) [h rev])))\n   819\t                          revents))\n   820\t        after? #(> (:id (first %)) last-id)]\n   821\t    (concat (filter after? hs) (remove after? hs))))\n   822\t\n   823\t\n   824\t(defn pump!\n   825\t  \"One bounded turn over `ready` (`[[fd revents] ...]` from the driver's\n   826\t   poll; `[]` after a timeout): owed reports, one visit per ready\n   827\t   descriptor, held remainders that can resume, due expiries, owed reports.\n   828\t   Answers `{:progressed? boolean}`.\"\n   829\t  [p ready]\n   830\t  (let [s (st p)]\n   831\t    (try\n   832\t      (let [notified? (deliver-notify! p)\n   833\t            turn (vec (rotation p ready))\n   834\t            visited (doall\n   835\t                      (for [[h rev] turn\n   836\t                            ;; a descriptor released earlier in this turn,\n   837\t                            ;; or its number reused, is not visited\n   838\t                            :when (registered? p h)]\n   839\t                        (let [moved? (case (:kind (cell h))\n   840\t                                       :listener (visit-listener! p h)\n   841\t                                       :connecting (visit-connecting! p h rev)\n   842\t                                       :connection (visit-connection! p h rev))]\n   843\t                          (swap! s assoc :last-id (:id h))\n   844\t                          moved?)))\n   845\t            seen (set (map (comp :id first) turn))\n   846\t            resumed (doall\n   847\t                      (for [h (sort-by :id (vals (:handles @s)))\n   848\t                            :when (and (not (seen (:id h))) (runnable-remainder? h))]\n   849\t                        (resume! p h)))\n   850\t            fired? (expire! p)\n   851\t            _ (report-drained! p)\n   852\t            late? (deliver-notify! p)]\n   853\t        {:progressed? (boolean (or notified? (some true? visited) (some true? resumed)\n   854\t                                   fired? late?))})\n   855\t      (finally\n   856\t        (maybe-release! p)))))\n   857\t\n   858\t\n   859\t;; =============================================================================\n   860\t;; Listener lifecycle (A6 seam)\n   148\t(defn host-pump\n   149\t  \"The instance as the driver's `:pump` value (A2): the pump's interest and\n   150\t   deadline (now while this edge owes a report), and `pump!`.\"\n   151\t  [inst]\n   152\t  (let [p (::pump inst)]\n   153\t    {:interest #(pump/interest p)\n   154\t     :deadline #(if (seq (:owed @(st inst))) (poller/clock-ms) (pump/next-deadline p))\n   155\t     :pump! (fn [ready]\n   156\t              (let [before? (deliver-owed! inst)\n   157\t                    r (pump/pump! p ready)\n   158\t                    after? (deliver-owed! inst)]\n   159\t                {:progressed? (boolean (or before? (:progressed? r) after?))}))}))\n   160\t\n   161\t\n   162\t;; =============================================================================\n   163\t;; Frames\n   164\t;; =============================================================================\n   165\t\n   166\t(defn- protocol\n   167\t  \"The pump's protocol map for `role` (:server or :client), whose parser\n   168\t   bounds a message at `max` bytes (nil is unbounded). Client frames are\n   169\t   masked with a fresh key each.\"\n   170\t  [role max]\n   171\t  (cond-> {:parser (rfc6455/parser {:role role, :max-message-bytes max})\n   172\t           :parse-frame rfc6455/parse-frame\n   173\t           :encode-frame rfc6455/encode-frame\n   174\t           :close-payload rfc6455/close-payload}\n   175\t    (= :client role) (assoc :mask-key crypto/mask-key)))\n   176\t\n   177\t\n   178\t(defn- data-frame\n   179\t  \"The wire bytes of one message: a string as a text frame, host bytes as a\n   180\t   binary frame; masked for the client role.\"\n   181\t  [role payload]\n   182\t  (rfc6455/encode-frame\n   183\t    (cond-> (if (string? payload)\n   184\t              {:opcode :text, :payload (text/utf8-encode payload)}\n   185\t              {:opcode :binary, :payload payload})\n   186\t      (= :client role) (assoc :mask-key (crypto/mask-key)))))\n   187\t\n   188\t\n   189\t(defn- deliver-message!\n   190\t  [cb ev]\n   191\t  (when cb\n   192\t    (let [payload (:payload ev)]\n   193\t      (if (= :text (:opcode ev))\n   194\t        ((:message! cb) (text/utf8-decode payload 0 (alength payload)))\n   195\t        ((:binary! cb) payload)))))\n   196\t\n   197\t\n   198\t(defn- report-closed!\n   199\t  \"The one terminal of an upgraded connection, from the pump's owed\n   200\t   `:on-closed`.\"\n   201\t  [cb {:keys [code reason cause]}]\n   202\t  (when cb\n   203\t    (when (and (= :fail cause) (= 1009 code))\n   204\t      ((:too-large! cb)))\n   205\t    ((:closed! cb) code reason)))\n   206\t\n   207\t\n   208\t(defn- seam\n   209\t  \"The raw-socket seam over connection record `c`, whose role frames\n   210\t   outbound messages.\"\n   211\t  [p c role]\n   212\t  {:send! (fn [payload]\n   213\t            (let [{:keys [phase h]} @c]\n   214\t              (if (= :open phase)\n   215\t                (pump/send! p h (data-frame role payload))\n   216\t                pump/closed-outcome)))\n   217\t   :close! (fn [code reason]\n   218\t             (let [{:keys [phase h]} @c]\n   219\t               (when (= :open phase) (pump/close! p h code reason)))\n   220\t             nil)\n   221\t   :queued-bytes #(if-let [h (:h @c)] (pump/queued-bytes h) 0)})\n   222\t\n   223\t\n   224\t;; =============================================================================\n   225\t;; Dialer\n   226\t;; =============================================================================\n   227\t\n     1\t(ns dao.stream.ws.rfc6455\n     2\t  \"The pure RFC 6455 framing core for hosts that own their sockets\n     3\t   (docs/design/yin.repl-jolt-implementation.md section 9).\n     4\t\n     5\t   No I/O, no clock, no entropy: bytes in, values out.  A parser is a value;\n     6\t   `feed` takes it with one received chunk and answers `[parser' events]`.\n     7\t   The chunk is never mutated and never retained: every payload piece is\n     8\t   copied (and unmasked) into fresh storage.  Chunks may split anywhere.\n     9\t\n    10\t   Events (maps with `:type`):\n    11\t   * `:message` -- `:opcode` `:text`|`:binary`, `:payload` bytes (a text\n    12\t     payload is valid UTF-8, validated incrementally as it arrives);\n    13\t   * `:ping`, `:pong` -- `:payload` bytes;\n    14\t   * `:close` -- `:code` (nil for an empty close payload) and `:reason`;\n    15\t   * `:fail` -- `:code` (1002 protocol error, 1007 invalid UTF-8, 1009\n    16\t     too big) and `:reason`; the parser is then terminal and ignores input.\n    17\t\n    18\t   The first invalid byte decides: a frame that breaks a rule fails at the\n    19\t   chunk holding the first offending byte, not at the end of the message.\n    20\t   A declared length is checked against the message bound before any\n    21\t   storage for it exists.\n    22\t\n    23\t   Roles follow RFC 6455 section 5.1: a `:server` parser requires masked\n    24\t   frames, a `:client` parser refuses masked frames.  The profile is the\n    25\t   no-extension profile: a set RSV bit is a protocol error.\"\n    26\t  (:require [dao.host.bytes :as bytes]\n    27\t            [dao.host.text :as text]))\n    28\t\n    29\t\n    30\t(def absolute-ceiling\n    31\t  \"The largest message a host byte array can be asked to hold here, 2^31-1;\n    32\t   the bound when the caller supplies none.\"\n    33\t  2147483647)\n    34\t\n    35\t\n    36\t(def opcodes\n    37\t  {:continuation 0 :text 1 :binary 2 :close 8 :ping 9 :pong 10})\n    38\t\n    39\t\n    40\t(defn accepted-close-code?\n    41\t  \"The jolt host row of docs/design/dao.stream.ws.md: an inbound close code\n    42\t   is accepted in 1000-1003, 1007-1014 and 3000-4999; anything else is\n    43\t   answered with a 1002 close.\"\n    44\t  [code]\n    45\t  (and (integer? code)\n    46\t       (or (<= 1000 code 1003)\n    47\t           (<= 1007 code 1014)\n    48\t           (<= 3000 code 4999))))\n    49\t\n    50\t\n    51\t;; =============================================================================\n    52\t;; Incremental UTF-8 validation (RFC 3629, strict)\n    53\t;; =============================================================================\n    54\t\n    55\t(def utf8-initial\n    56\t  \"A validator state at a character boundary: `[remaining lo hi]`, the count\n    57\t   of continuation bytes still owed and the range of the next one.\"\n    58\t  [0 0x80 0xBF])\n    59\t\n    60\t\n    61\t(defn utf8-step\n    62\t  \"The state after byte `b`, or nil when `b` is invalid there.\"\n    63\t  [state b]\n    64\t  (let [[remaining lo hi] state]\n    65\t    (if (zero? remaining)\n    66\t      (cond\n    67\t        (< b 0x80) state\n    68\t        (<= 0xC2 b 0xDF) [1 0x80 0xBF]\n    69\t        (= b 0xE0) [2 0xA0 0xBF]\n    70\t        (= b 0xED) [2 0x80 0x9F]\n    71\t        (<= 0xE1 b 0xEF) [2 0x80 0xBF]\n    72\t        (= b 0xF0) [3 0x90 0xBF]\n    73\t        (<= 0xF1 b 0xF3) [3 0x80 0xBF]\n    74\t        (= b 0xF4) [3 0x80 0x8F]\n    75\t        :else nil)\n    76\t      (when (<= lo b hi)\n    77\t        [(dec remaining) 0x80 0xBF]))))\n    78\t\n    79\t\n    80\t(defn utf8-feed\n    81\t  \"The state after all bytes of `bs`, or nil at the first invalid byte.\"\n    82\t  [state bs]\n    83\t  (let [n (bytes/length bs)]\n    84\t    (loop [i 0 st state]\n    85\t      (cond\n    86\t        (nil? st) nil\n    87\t        (>= i n) st\n    88\t        :else (recur (inc i) (utf8-step st (bytes/get bs i)))))))\n    89\t\n    90\t\n    91\t(defn utf8-complete?\n    92\t  \"True when `state` ends on a character boundary.\"\n    93\t  [state]\n    94\t  (and (some? state) (zero? (first state))))\n    95\t\n    96\t\n    97\t;; =============================================================================\n    98\t;; Mask, serialize\n    99\t;; =============================================================================\n   100\t\n   101\t(defn unmask\n   102\t  \"Fresh bytes: `bs` XOR the four-byte `key`, the key rotated by `offset`\n   103\t   (the payload position of `bs`'s first byte).  Masking is the same\n   104\t   operation.  `bs` is left unchanged.\"\n   105\t  [bs key offset]\n   106\t  (let [n (bytes/length bs)\n   107\t        out (bytes/alloc n)\n   108\t        k (bytes/to-vector key)]\n   109\t    (loop [i 0]\n   110\t      (when (< i n)\n   111\t        (bytes/set! out i (bit-xor (bytes/get bs i)\n   112\t                                   (nth k (mod (+ offset i) 4))))\n   113\t        (recur (inc i))))\n   114\t    out))\n   115\t\n   116\t\n   117\t(defn- opcode-int\n   118\t  [opcode]\n   119\t  (if (keyword? opcode) (get opcodes opcode) opcode))\n   120\t\n   121\t\n   122\t(defn- length-bytes\n   123\t  [n]\n   124\t  (cond\n   125\t    (< n 126) [n]\n   126\t    (< n 65536) [126 (quot n 256) (mod n 256)]\n   127\t    :else (let [hi (quot n 4294967296)\n   128\t                lo (mod n 4294967296)]\n   129\t            (into [127]\n   130\t                  (concat (map #(mod (quot hi %) 256) [16777216 65536 256 1])\n   131\t                          (map #(mod (quot lo %) 256) [16777216 65536 256 1]))))))\n   132\t\n   133\t\n   134\t(defn encode-frame\n   135\t  \"The wire bytes of one frame: `{:opcode :payload}` plus optional `:fin?`\n   136\t   (default true) and `:mask-key` (four bytes; present for client frames).\n   137\t   Header and masked payload are written into one fresh array; `:payload`\n   138\t   is left unchanged.  A control frame over 125 bytes or not final throws.\"\n   139\t  [{:keys [opcode payload mask-key fin?] :or {fin? true}}]\n   140\t  (let [op (opcode-int opcode)\n   141\t        n (bytes/length payload)]\n   142\t    (when (and (>= op 8) (or (> n 125) (not fin?)))\n   143\t      (throw (ex-info \"control frames are final and at most 125 bytes\"\n   144\t                      {:opcode op :length n})))\n   145\t    (let [lenb (length-bytes n)\n   146\t          mask? (some? mask-key)\n   147\t          head (into [(bit-or (if fin? 0x80 0) op)\n   148\t                      (bit-or (if mask? 0x80 0) (first lenb))]\n   149\t                     (concat (rest lenb) (when mask? (bytes/to-vector mask-key))))\n   150\t          hn (count head)\n   151\t          out (bytes/alloc (+ hn n))]\n   152\t      (loop [i 0]\n   153\t        (when (< i hn)\n   154\t          (bytes/set! out i (nth head i))\n   155\t          (recur (inc i))))\n   156\t      (if mask?\n   157\t        (bytes/copy! (unmask payload mask-key 0) 0 out hn n)\n   158\t        (bytes/copy! payload 0 out hn n))\n   159\t      out)))\n   160\t\n   161\t\n   162\t(defn close-payload\n   163\t  \"The payload of a close frame: the two-byte `code` then the UTF-8 `reason`\n   164\t   (nil `code` is an empty payload).  A reason over 123 bytes throws, and so\n   165\t   do 1005 and 1006, which are reported locally and never put on the wire.\"\n   166\t  [code reason]\n   167\t  (when (contains? #{1005 1006} code)\n   168\t    (throw (ex-info \"close codes 1005 and 1006 are never serialized\" {:code code})))\n   169\t  (if (nil? code)\n   170\t    (bytes/alloc 0)\n   171\t    (let [r (text/utf8-encode (or reason \"\"))\n   172\t          rn (bytes/length r)]\n   173\t      (when (> rn 123)\n   174\t        (throw (ex-info \"close reason over 123 bytes\" {:length rn})))\n   175\t      (let [out (bytes/alloc (+ 2 rn))]\n   176\t        (bytes/set! out 0 (quot code 256))\n   177\t        (bytes/set! out 1 (mod code 256))\n   178\t        (bytes/copy! r 0 out 2 rn)\n   179\t        out))))\n   180\t\n   181\t\n   182\t;; =============================================================================\n   183\t;; Parser\n   184\t;; =============================================================================\n   185\t\n   186\t(defn parser\n   187\t  \"A fresh parser.  `:role` is `:server` or `:client` (whose frames it\n   188\t   parses are the peer's); `:max-message-bytes` bounds an assembled message\n   189\t   (default `absolute-ceiling`).\"\n   190\t  [{:keys [role max-message-bytes]}]\n   191\t  {:role role\n   192\t   :max (min absolute-ceiling (or max-message-bytes absolute-ceiling))\n   193\t   :phase :header\n   194\t   :hdr []\n   195\t   :frame nil\n   196\t   :msg nil})\n   197\t\n   198\t\n   199\t(defn- fail\n   200\t  [state code reason]\n   201\t  [(assoc state :phase :done)\n   202\t   [{:type :fail :code code :reason reason}]])\n   203\t\n   204\t\n   205\t(defn- header-length\n   206\t  \"Total header bytes the first two bytes `b0 b1` promise.\"\n   207\t  [b1]\n   208\t  (+ 2\n   209\t     (case (bit-and b1 127) 126 2 127 8 0)\n   210\t     (if (pos? (bit-and b1 128)) 4 0)))\n   211\t\n   212\t\n   213\t(defn- check-first-two\n   214\t  \"A failure `[code reason]` decidable from the first two header bytes.\"\n   215\t  [state b0 b1]\n   216\t  (let [opcode (bit-and b0 15)\n   217\t        control? (>= opcode 8)\n   218\t        masked? (pos? (bit-and b1 128))]\n   219\t    (cond\n   220\t      (pos? (bit-and b0 0x70)) [1002 \"reserved bits set\"]\n   221\t      (or (<= 3 opcode 7) (> opcode 10)) [1002 \"reserved opcode\"]\n   222\t      (and control? (zero? (bit-and b0 0x80))) [1002 \"fragmented control frame\"]\n   223\t      (and control? (> (bit-and b1 127) 125)) [1002 \"oversized control frame\"]\n   224\t      (and (zero? opcode) (nil? (:msg state))) [1002 \"continuation without a start\"]\n   225\t      (and (#{1 2} opcode) (some? (:msg state))) [1002 \"data frame inside a fragmented message\"]\n   226\t      (and (= :server (:role state)) (not masked?)) [1002 \"unmasked client frame\"]\n   227\t      (and (= :client (:role state)) masked?) [1002 \"masked server frame\"]\n   228\t      :else nil)))\n   229\t\n   230\t\n   231\t(defn- payload-length\n   232\t  \"The declared payload length of a complete header `hdr`, or `[code reason]`\n   233\t   when it is not minimal or sets the top bit.\"\n   234\t  [hdr]\n   235\t  (let [l7 (bit-and (nth hdr 1) 127)]\n   236\t    (cond\n   237\t      (< l7 126) l7\n   238\t      (= l7 126) (let [n (+ (* 256 (nth hdr 2)) (nth hdr 3))]\n   239\t                   (if (< n 126) [1002 \"non-minimal length\"] n))\n   240\t      :else (let [hi (+ (* 16777216 (nth hdr 2)) (* 65536 (nth hdr 3))\n   241\t                        (* 256 (nth hdr 4)) (nth hdr 5))\n   242\t                  lo (+ (* 16777216 (nth hdr 6)) (* 65536 (nth hdr 7))\n   243\t                        (* 256 (nth hdr 8)) (nth hdr 9))]\n   244\t              (cond\n   245\t                (>= hi 2147483648) [1002 \"length with the top bit set\"]\n   246\t                :else (let [n (+ (* hi 4294967296) lo)]\n   247\t                        (if (< n 65536) [1002 \"non-minimal length\"] n)))))))\n   248\t\n   249\t\n   250\t(defn- concat-chunks\n   251\t  [chunks total]\n   252\t  (let [out (bytes/alloc total)]\n   253\t    (loop [cs (seq chunks) at 0]\n   254\t      (when cs\n   255\t        (let [c (first cs)\n   256\t              cn (bytes/length c)]\n   257\t          (bytes/copy! c 0 out at cn)\n   258\t          (recur (next cs) (+ at cn)))))\n   259\t    out))\n   260\t\n   261\t\n   262\t(defn- begin-frame\n   263\t  \"State after a complete header, or a failure.\"\n   264\t  [state hdr]\n   265\t  (let [b0 (nth hdr 0)\n   266\t        b1 (nth hdr 1)\n   267\t        len (payload-length hdr)]\n   268\t    (if (vector? len)\n   269\t      (fail state (first len) (second len))\n   270\t      (let [opcode (bit-and b0 15)\n   271\t            control? (>= opcode 8)\n   272\t            masked? (pos? (bit-and b1 128))\n   273\t            key (when masked? (bytes/from-vector (subvec hdr (- (count hdr) 4))))\n   274\t            size (+ len (if control? 0 (:size (:msg state) 0)))]\n   275\t        (if (and (not control?) (> size (:max state)))\n   276\t          (fail state 1009 \"message too big\")\n   277\t          (let [msg (cond\n   278\t                      control? (:msg state)\n   279\t                      (zero? opcode) (:msg state)\n   280\t                      :else {:opcode (if (= opcode 1) :text :binary)\n   281\t                             :chunks [] :size 0 :utf8 utf8-initial})]\n   282\t            [(assoc state\n   283\t                    :phase :payload\n   284\t                    :hdr []\n   285\t                    :msg msg\n   286\t                    :frame {:fin? (pos? (bit-and b0 0x80)) :opcode opcode\n   287\t                            :key key :len len :got 0 :chunks []})\n   288\t             []]))))))\n   289\t\n   290\t\n   291\t(defn- parse-close\n   292\t  \"Classify a close payload.  Absent (length 0) is a valid close with no\n   293\t   status: `:absent? true`, `:code nil`.  Invalid -- length 1, a code outside\n   294\t   the accepted set, or a reason that is not UTF-8 -- is a 1002 failure\n   295\t   tagged `:close? true`, so the caller can tell it from a framing failure.\"\n   296\t  [payload]\n   297\t  (let [n (bytes/length payload)\n   298\t        invalid (fn [reason] {:type :fail :close? true :code 1002 :reason reason})]\n   299\t    (cond\n   300\t      (zero? n) {:type :close :absent? true :code nil :reason \"\"}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"rg --files | rg '(j6g|plan-v3|plan.*v3|BRIEF-j6|waitset/driver|io.poller|jolt-env|rfc6455)'; cat BRIEF-j6g-diagnose.md BRIEF-j6g-fix-findings.md; ls -l build/tools/jolt-env.sh; rg -n '\"'^'\"\\\\(defn|step|parse' src/cljc/yin/repl/driver.cljc | tail -65; rg -n 'A1|A2|A3|A4|A5|A6|A7|Workload W|workload W|P2' docs/design/yin.repl-jolt*\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"rg --files | rg '(j6g|plan-v3|plan.*v3|BRIEF-j6|waitset/driver|io.poller|jolt-env|rfc6455)'; cat BRIEF-j6g-diagnose.md BRIEF-j6g-fix-findings.md; ls -l build/tools/jolt-env.sh; rg -n '\"'^'\"\\\\(defn|step|parse' src/cljc/yin/repl/driver.cljc | tail -65; rg -n 'A1|A2|A3|A4|A5|A6|A7|Workload W|workload W|P2' docs/design/yin.repl-jolt*\"","aggregated_output":"src/clj/dao/stream/waitset/driver.clj\nsrc/cljs/dao/stream/waitset/driver.cljs\nBRIEF-j6g-diagnose.md\ntest/dao/stream/ws/rfc6455_test.cljc\ntest/dao/stream/waitset/driver_test.cljs\ntest/dao/stream/waitset/driver_test.clj\ntest/dao/stream/waitset/driver_test.cljd\nsrc/jolt/dao/stream/waitset/driver.jolt\ncollab/jolt/1793990000000-architect-j6g-diagnose.brief.md\nsrc/cljd/dao/stream/waitset/driver.cljd\nsrc/cljc/dao/stream/ws/rfc6455.cljc\nBRIEF-j6g-fix.md\nBRIEF-j6g-fix-findings.md\nSession-ID: 9c4e7a12-6d83-4b25-9e51-2f84c0d7b645\n\n# J6g diagnostic round (argon tier): why does peer B starve and A stall under workload W?\n\nRole: diagnostician (agy gemini-4-argon-high). This is a HARD PROBLEM\nround — the terminal-state rule escalates it to you after two failed\nimplementation rounds. Read-only on the adapter: NO code changes to\nsrc/jolt/** or src/cljc/** — your deliverable is the diagnosis and, if the\nroot cause is in the harness, the harness fix. Edits only; the\norchestrator verifies remotely.\n\n## The measured facts (both runs on jupiter, master current)\n\n- Attempt 18 (agy's unguarded harness): server listening, peer B upgraded,\n  peer A upgraded (frame 4,194,318 bytes), \"Entering owner round loop...\"\n  — then 100% CPU spin for 69 minutes, no output flush, no completion.\n  Killed rc=143 (4,165 s).\n- Attempt 21 (codex's guarded harness): the watchdog terminated at exactly\n  the 5-minute hard cap with `:hard-cap`, `p99 ABSENT`, `sample count 70`,\n  A's transfer stalled. B's round trips starve (70 samples vs ≥600)\n  AND A's transfer makes no progress.\n- Codex's static reads (its fix round) say: the owner polls the adapter\n  after stepping; the pump visits ready descriptors in rotation, at most\n  one read chunk per visit. The runtime evidence contradicts that —\n  neither A's transfer nor B's round trips progress.\n\n## The question\n\nWhy do BOTH peers stall while the process spins at 100% CPU? Candidates\nthe evidence leaves open (you may find others):\n\n1. The pump's visit rotation starves one descriptor (fairness) — but at\n   one chunk per visit, B's 1 KiB exchanges should still progress.\n2. The 4 MiB message's decode fires synchronously in the composition\n   (plan v3 §2 P2: codec decode enters the round) — if A's final chunk\n   decode runs on the owner thread every visit, the round time explodes\n   and B's deadline is missed.\n3. The harness's peer A write loop spins without ever completing the\n   write (its own :would-block handling), consuming the single owner\n   thread — a harness defect wearing the adapter's face.\n4. The driver's sleep-fds!/poll deadline logic (R8/R9) never wakes for\n   the descriptors that matter.\n\nRead: src/jolt/dao/stream/ws/pump.jolt (visit rotation, read chunking),\nsrc/jolt/dao/stream/ws/jolt.jolt (the echo callbacks, :ws/max-frame-bytes\nhandling), src/cljc/yin/repl/main.cljc's owner round, and the harness\n(src/dev/jolt_workload_w.clj + jolt_workload_w_run.clj). State the root\ncause with file:line, and whether it is adapter, composition, or harness.\n\n## Deliverable\n\n- The diagnosis (root cause, file:line, and the mechanism).\n- If the root cause is the HARNESS: fix it in place.\n- If it is the ADAPTER or COMPOSITION: a written ruling proposal (the\n  exact change, where, and why it preserves A1-A7) — the orchestrator\n  routes it to the Architect for a ruling before any edit.\n- If it is the CRITERION itself (workload W is unsatisfiable as\n  pre-registered): say so explicitly with the mechanism.\n- cljstyle clean on anything you touch; no collab/ path in comments.\n# J6g fix findings\n\nThis round used source reads and edits only. No workload, build, test, lint, or\nformatter process was run. There is no new latency measurement. The original\n`BRIEF-j6g.md` is absent from this workspace; `BRIEF-j6g-fix.md` supplies the\ncriterion used here: A delivered once around 60 seconds, B p99 <= 250 ms,\nat least 600 samples. The default duration, sample target, and payload bound\nwere preserved.\n\n## Attribution\n\n**Confirmed harness defects, hypothesis (a); hypothesis (b) is not established.\nThe specific instruction spinning in j6ggate18 cannot be identified from these\nreads. In particular, attributing that post-upgrade spin to `write-all!` would\ncontradict the harness call order.**\n\n- `src/dev/jolt_workload_w.clj:330`: Workload W calls `write-all!` for A's HTTP\n  upgrade request. This precedes the reported successful upgrade and owner-loop\n  banner. The large-frame leg instead calls `write-some!` at line 409, which\n  makes one send attempt (line 138). There is no write-all retry loop on that leg.\n- On entry to this fix round, `write-all!` already had a 100-stall guard for\n  `:would-block`. It nevertheless reset stalls on `{:n 0}`, allowing an endless\n  zero-progress loop. It also advanced `off` without advancing the native buffer\n  contents: a short send resent the prefix. These are real defects; neither is\n  evidence that this already-completed call caused the observed hang. The fixed\n  helper begins at `src/dev/jolt_workload_w.clj:90`.\n- The workspace also already contained a five-minute owner-loop check and\n  ten-second telemetry. Both were cooperative: they could run only after the\n  preceding synchronous call returned. Setup loops were outside that deadline,\n  and the transfer's zero-result branch incremented stalls without testing the\n  limit. A spinning subcall could suppress both the cap and telemetry forever.\n- The first work after the banner submits a line and synchronously calls\n  `driver/repl-step`, before sending A or pumping either peer\n  (`src/dev/jolt_workload_w.clj:390`). That call reaches local evaluation through\n  `src/cljc/yin/repl/driver.cljc:593` and line 174. There is no evidence from the\n  supplied log that the first step returned, or that B was served during the\n  spin. A stopped synchronous evaluation remains a separate possibility.\n- The production owner calls `step-all`, then its sleep policy\n  (`src/cljc/yin/repl/main.cljc:1302`, line 1313). `step-all` includes the shell\n  driver and served endpoint (lines 1088 and 1094). The jolt sleep policy passes\n  the adapter pump to `sleep-fds!` (line 1437). That wait polls all interests and\n  calls the pump with observed readiness\n  (`src/jolt/dao/stream/waitset/driver.jolt:176`, line 201).\n- The pump constructs interests for its registered connections\n  (`src/jolt/dao/stream/ws/pump.jolt:722`), rotates ready handles (line 809),\n  and visits each ready connection (line 834). A visit reads at most one chunk\n  (lines 671 and 644). These reads show a path for A to drain alongside B, not\n  an owner rule that selects only B. They do not prove that every parser or\n  evaluator call returns under jolt.\n\nThere is also a measurement limitation: this harness manually alternates a\ndriver step and two pumps; it does not invoke production `run-owner!`.\nIts boot adapter is separate from the server instance (harness line 354), and\nits REPL counter counts returned driver calls, not VM instruction progress.\nNo production-equivalence or adapter-starvation claim is justified by the\nexisting counter alone. No adapter, driver, or production owner code was changed.\n\n## Guards and reporting\n\n- `write-all!` now resumes with the unsent bytes, checks a monotonic deadline,\n  bounds each poll by the remaining time, and aborts after **100 consecutive\n  no-progress polls**, including zero-byte sends. Only positive byte progress\n  resets the counter. Failure includes offset, total, stall count, and result.\n  Unexpected send results cannot masquerade as a completed write.\n- The paced large-frame leg now aborts after **500 consecutive no-progress\n  attempts**, including zero-byte results, and flushes its stall report. Positive\n  sends reset the count. The B sampler continues after an A stall, allowing the\n  criterion failure and B latency to be reported together.\n- The worker deadline starts before binding and is checked during setup as well\n  as the owner loop. Its trailing drain cannot extend that deadline. Reports\n  include elapsed milliseconds; timeout or zero samples yields absent p99,\n  never an invented zero-millisecond measurement.\n- `src/dev/jolt_workload_w_run.clj:89` adds an independent Babashka supervisor,\n  wired into `bb.edn:103`. Its monotonic **300,000 ms** budget starts before\n  launching jolt, including loading and setup. At the cap it forcibly kills\n  the captured process tree and flushes FAILURE, `RECORD p99 ABSENT`, the\n  observed sample count, and elapsed milliseconds; exit status is nonzero.\n  This guard remains runnable when a worker call spins. The worker CLI refuses\n  an unsupervised launch (`src/dev/jolt_workload_w.clj:1047`).\n- Each completed B reply emits a flushed sample record (harness line 295).\n  The supervisor consumes those records and flushes running p99 and sample count\n  every **10 seconds**, including when the worker stops returning\n  (`src/dev/jolt_workload_w_run.clj:58`). No samples prints `ABSENT`. On forced\n  termination the count means complete sample records received by the supervisor;\n  incomplete trailing output is not counted. Earlier running p99 remains\n  diagnostic; a capped run has no qualifying final p99.\n- First-round phase markers bracket stepping and pumping. The supervisor's\n  `:first-round-phase` is explicitly historical after round one; it does not\n  pretend to locate a stall in a later round. Worker telemetry still reports\n  A's sent bytes and delivery count every ten seconds while rounds return.\n\nAn external supervisor is necessary for the hard guarantee: a timer checked\non the same single owner thread cannot interrupt a call that never returns.\n\n## Next verification\n\nUse **`bb workload-w:jolt workload-w`**, preserving stdout, stderr, and exit\nstatus. Directly launching the worker is now a reported failure. Before the\nrun, check formatting with:\n\n```sh\ncljstyle check src/dev/jolt_workload_w.clj src/dev/jolt_workload_w_run.clj bb.edn\n```\n\n1. **Harness retry defect only:** positive writes advance to the correct unsent\n   bytes. A should complete once, B should produce at least 600 samples with\n   p99 <= 250 ms, and returned REPL steps should advance. Preserve actual elapsed\n   time to assess the registered ~60-second window. The five-minute cap is a\n   failure bound, not permission to accept a five-minute transfer. A PASS marker\n   alone does not establish that timing requirement.\n2. **A starves while B continues:** telemetry should show B samples increasing\n   while A bytes stop advancing or its complete delivery remains absent.\n   Repeated no-progress sends should produce `TRANSFER STALLED`; the final\n   verdict must be FAILURE even with good B p99. If the frame fits in the kernel\n   buffer but is never delivered, the five-minute cap still ends the run.\n   This is evidence of a composition failure to bring to the Architect; it\n   does not by itself identify which adapter/parser operation caused it.\n3. **A synchronous call spins:** first-round markers may stop at `repl-step`,\n   `server-pump`, or `client-b-pump`. Independent ten-second telemetry must\n   continue with the samples received so far, and the supervisor must report\n   FAILURE at approximately 300 seconds with absent final p99 and nonzero exit.\n   A first-round `repl-step` stall precedes the peer pumps and cannot substantiate\n   the claim that the owner kept serving B while starving A.\n\nStatic inspection found balanced delimiters, no trailing whitespace in the two\nClojure source files, and no forbidden path in their comments. Formatting was\nreviewed manually; cljstyle cleanliness, compilation, watchdog behavior, and\nbenchmark results remain unverified because execution was explicitly prohibited.\nls: build/tools/jolt-env.sh: No such file or directory\n6:   poll, print, prompt, or touch the state held here.  `repl-step` is called\n35:  \"Maximum input elements one step reads, so a flooded medium cannot make a\n36:   single step unbounded.\"\n41:  \"Maximum response-medium elements one step reads.\"\n60:(defn create-input-medium!\n62:   producer and the step owner is a stream, which is what makes it explicit and\n70:(defn- mint-cursor\n77:(defn create-state\n98:(defn submit-line!\n105:(defn take-outbox\n111:(defn attach-remote\n116:(defn detach-remote\n121:(defn- publish\n132:(defn- drain-input\n155:                              \";; input lost: typed lines were evicted before this step\"))\n172:(defn- evaluate-locally\n181:(defn- rpc-client\n186:(defn- remote-terminal\n191:(defn- remote-unsent?\n199:(defn pending-write?\n215:(defn- remote-routed?\n232:(defn- abandon-unsent\n248:(defn- abandon-unsent-now\n255:   unsent envelope is abandoned before that unconditional publication step.\"\n266:(defn- disconnect\n293:(defn- connect-failure\n300:(defn- reattach\n321:(defn- open-connection\n342:(defn- connect-command\n384:(defn- queue-line\n389:(defn- requeue-line\n394:(defn- submit-remote\n408:      ;; encoded request, with the same id, is retried on a later step.\n424:(defn- handle-line\n477:(defn- completion-text\n493:(defn- completion-event-kind\n500:(defn- clears-outstanding?\n508:(defn- publish-adapter-events\n521:(defn- poll-remote\n524:                (:connection state) (update :connection connect/step! now))]\n532:(defn- observe-connection\n547:(defn- retry-unsent\n560:(defn- release-queue\n576:;; The step\n579:(defn repl-step\n92:are folded in: A4 (the 1009/1006 ruling asserts the diagnostic at the\n94:at the peer, not identical observables at both ends; §9.6, §13.4 ruling 3), A5\n99:for non-strict results is not acceptance; §9.5, §9.6, J6 row). Astra's A1-A3\n440:|                                | O_NONBLOCK and recheck by fstat; strict UTF-8 via `text.jolt`. Node/OS-lock mixed ownership is the known-gaps P2 row,   |             |\n734:through the gate (astra A5). No rule here mandates the newest release. A re-pin\n1269:signed-head tests, bind/send failures and shutdown. P2P/DHT is outside the local\n1469:codes\"). Cross-host suites therefore assert two different things (astra A4):\n1598:| not started                                 | adapter on the    | brief (§9.5). §9.6 on both platforms, including the frame-too-large matrix (ruling 3, A4 wording).  |\n1902:**Ruling 3 (A4 wording, 2026-10-20): cross-host suites assert the diagnostic\n1915:  wire; \"identical observables at both ends\" was wrong (astra A4) and is\n1926:**Ruling 4 (A5 wording, 2026-10-20): J0a keeps `96d7b866`; from the first\n1942:  restriction and is withdrawn, astra A5).\n2165:(A1-A5 and the Autobahn point).\n","exit_code":0,"status":"completed"}}
