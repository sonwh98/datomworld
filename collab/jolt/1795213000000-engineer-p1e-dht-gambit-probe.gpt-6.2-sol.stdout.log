{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/ringbuffer.cljc | sed -n '10,34p;150,171p'; nl -ba src/cljc/yin/repl/main.cljc | sed -n '1196,1228p'\"","aggregated_output":"    10\t(defn- result\n    11\t  [outcome]\n    12\t  {:dao.stream/outcome outcome})\n    13\t\n    14\t\n    15\t(defn- valid-spec?\n    16\t  [spec]\n    17\t  (and (map? spec)\n    18\t       (= transport-type (:dao.stream/type spec))\n    19\t       (integer? (get spec capacity-key))\n    20\t       (pos? (get spec capacity-key))))\n    21\t\n    22\t\n    23\t(defn- fresh-state\n    24\t  [capacity]\n    25\t  ;; The logical identity is carried in descriptors and cursors.  It therefore\n    26\t  ;; belongs to DaoStream's portable data domain, unlike a host UUID object.\n    27\t  (atom {:identity (str (random-uuid))\n    28\t         :capacity capacity\n    29\t         :first 0\n    30\t         :tail 0\n    31\t         :values {}\n    32\t         :closed? false\n    33\t         :attachments {}}))\n    34\t\n   150\t\n   151\t\n   152\t(defn create!\n   153\t  \"Create a ring buffer from a creation specification.\"\n   154\t  [spec]\n   155\t  (if-not (valid-spec? spec)\n   156\t    (result :dao.stream/invalid-spec)\n   157\t    (let [state (fresh-state (get spec capacity-key))]\n   158\t      {:dao.stream/outcome :dao.stream/ok\n   159\t       :dao.stream/handle (RingHandle. state nil true)\n   160\t       :dao.stream/identity (:identity @state)})))\n   161\t\n   162\t\n   163\t(defn- resolve-state\n   164\t  [resolver identity]\n   165\t  (let [x (if (fn? resolver) (resolver identity) (get resolver identity))]\n   166\t    (cond (instance? RingHandle x) (.-state ^RingHandle x)\n   167\t          #?(:cljd false\n   168\t             :clj (instance? clojure.lang.IAtom x)\n   169\t             :cljs (instance? cljs.core/Atom x)) x\n   170\t          :else nil)))\n   171\t\n  1196\t     (defn -main\n  1197\t       \"The engine's own JVM entry point: the `mem` and `file:<dir>` stores\n  1198\t        and no storage composition.  The shipped product entry point is\n  1199\t        `yin.shell.main/-main`, which supplies one.\"\n  1200\t       [& args]\n  1201\t       (main! args nil))))\n  1202\t\n  1203\t\n  1204\t#?(:jolt\n  1205\t   (do\n  1206\t     (defn main!\n  1207\t       \"One plain-thread owner. Stdin deposits only; EOF deposits (quit).\n  1208\t        One host WebSocket instance serves the shell, a storage\n  1209\t        composition's own endpoints and --port; every owner round polls its\n  1210\t        sockets (headless included) and the instance is closed before exit,\n  1211\t        however the drain ended.  Saved flags persist in the node\n  1212\t        directory, as on the JVM (J4d): --reset forgets them and --no-state\n  1213\t        neither reads nor writes them.\n  1214\t\n  1215\t        `composition` is the plain-data contribution of a storage\n  1216\t        composition, nil for a host that carries none.\"\n  1217\t       [args composition]\n  1218\t       (let [adapter (host/websocket)\n  1219\t             started (startup args {:persist? true :adapter adapter\n  1220\t                                    :composition composition})]\n  1221\t         (when (contains? started :exit) (exit-with! started))\n  1222\t         (if-some [refusal (:refusal started)]\n  1223\t           (refuse! refusal)\n  1224\t           (let [{:keys [opts state server]} started\n  1225\t                 headless? (boolean (:headless? opts))\n  1226\t                 eof? (atom false)\n  1227\t                 w (wake/make-wake)\n  1228\t                 line! (fn [line]\n","exit_code":0,"status":"completed"}}
