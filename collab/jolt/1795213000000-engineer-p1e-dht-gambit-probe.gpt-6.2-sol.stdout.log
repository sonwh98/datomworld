{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba host/gambit/source-loader.ss | sed -n '1,240p'; nl -ba host/gambit/yin/dao/stream/waitset/driver.jolt; rg -n 'defcfn|defmacro|host-var|ffi.*bind' host/gambit/ffi/gambitffi-public.ss host/gambit/*.ss | rg -i 'defcfn|public-bind|joltffi.*bind' | head -100; cat host/gambit/ffi/shapes.json\"","aggregated_output":"     1\t;; Opt-in native source namespace loading for embedded applications. Unlike the\n     2\t;; Chez loader, this only interprets source. It has no cache, FASL, AOT, runtime\n     3\t;; dependency discovery, or native-library discovery.\n     4\t\n     5\t(define (gambit-namespace-path name)\n     6\t  (let ((chars (string->list name)))\n     7\t    (let check ((rest chars) (need-name? #t))\n     8\t      (unless (cond\n     9\t                ((null? rest) (not need-name?))\n    10\t                ((char=? (car rest) #\\.) (and (not need-name?) (check (cdr rest) #t)))\n    11\t                ((or (char-alphabetic? (car rest)) (char-numeric? (car rest))\n    12\t                     (memv (car rest) '(#\\- #\\_)))\n    13\t                 (check (cdr rest) #f))\n    14\t                (else #f))\n    15\t        (throw-jvm 'IllegalArgumentException (string-append \"Invalid namespace: \" name))))\n    16\t    (list->string\n    17\t      (map (lambda (ch) (case ch ((#\\.) #\\/) ((#\\-) #\\_) (else ch))) chars))))\n    18\t\n    19\t;; Gambit's reader tags bracket-delimited lists. Raw Scheme in loaded\n    20\t;; Jolt libraries uses R6RS brackets as grouping delimiters.\n    21\t(define (gambit-source-scheme-form datum)\n    22\t  (define (read-list items)\n    23\t    (if (pair? items)\n    24\t        (cons (gambit-source-scheme-form (car items)) (read-list (cdr items)))\n    25\t        items))\n    26\t  (cond\n    27\t    ((pair? datum)\n    28\t     (case (car datum)\n    29\t       ((|[...]|) (read-list (cdr datum)))\n    30\t       ((endianness)\n    31\t        (unless (and (list? datum) (= (length datum) 2)\n    32\t                     (memq (cadr datum) '(big little)))\n    33\t          (error \"invalid endianness\" datum))\n    34\t        (list 'quote (cadr datum)))\n    35\t       (else (read-list datum))))\n    36\t    ((vector? datum) (vector-map gambit-source-scheme-form datum))\n    37\t    (else datum)))\n    38\t\n    39\t(define (gambit-source-scheme-eval text)\n    40\t  (let ((port (open-input-string (jolt-need-string text))))\n    41\t    (input-port-readtable-set! port\n    42\t      (readtable-sharing-allowed?-set (input-port-readtable port) #f))\n    43\t    (let loop ((last jolt-nil))\n    44\t      (let ((form (read port)))\n    45\t        (if (eof-object? form)\n    46\t            last\n    47\t            (loop (eval (gambit-source-scheme-form form))))))))\n    48\t\n    49\t;; Each root is (directory suffix ...), in classpath order. BOOTED names denote\n    50\t;; whole namespaces supplied by the embedding host and take precedence over\n    51\t;; files. A mere intern or :as-alias never satisfies a source dependency.\n    52\t(define (gambit-install-source-loader! roots booted)\n    53\t  (define loaded (make-table test: string=?))\n    54\t  (define (find-file name)\n    55\t    (let ((base (gambit-namespace-path name)))\n    56\t      (let find-root ((rest roots))\n    57\t        (and (pair? rest)\n    58\t             (let find-suffix ((suffixes (cdar rest)))\n    59\t               (if (null? suffixes)\n    60\t                   (find-root (cdr rest))\n    61\t                   (let ((file (string-append (caar rest) \"/\" base (car suffixes))))\n    62\t                     (if (and (file-exists? file) (eq? 'regular (file-type file)))\n    63\t                         file\n    64\t                         (find-suffix (cdr suffixes))))))))))\n    65\t  (define (load-namespace name force?)\n    66\t    (when force?\n    67\t      (throw-jvm 'UnsupportedOperationException\n    68\t                 \"namespace reload is unsupported on the gambit source loader\"))\n    69\t    (unless (member name booted)\n    70\t      (case (table-ref loaded name #f)\n    71\t        ((ready) #f)\n    72\t        ((loading)\n    73\t         (throw-jvm 'IllegalStateException (string-append \"Cyclic namespace load: \" name)))\n    74\t        ((failed)\n    75\t         (throw-jvm 'IllegalStateException (string-append \"Earlier namespace load failed: \" name)))\n    76\t        (else\n    77\t         (let ((file (find-file name)))\n    78\t           (unless file\n    79\t             (throw-jvm 'FileNotFoundException (string-append \"No source for namespace: \" name)))\n    80\t           (table-set! loaded name 'loading)\n    81\t           (when (getenv \"JOLT_TRACE_SOURCE\" #f)\n    82\t             (fprintf (current-error-port) \"[~as] load ~a\\n\" (inexact->exact (round (time->seconds (current-time)))) name)\n    83\t             (force-output (current-error-port)))\n    84\t           (guard (e (#t (table-set! loaded name 'failed) (raise e)))\n    85\t             (jolt-with-ns-bound\n    86\t               (lambda ()\n    87\t                 (jolt-eval-string (call-with-input-file file gambit-read-all) file)\n    88\t                 (unless (string=? name (chez-current-ns))\n    89\t                   (throw-jvm 'IllegalStateException\n    90\t                              (string-append file \": expected namespace \" name)))))\n    91\t             (when (getenv \"JOLT_TRACE_SOURCE\" #f)\n    92\t               (fprintf (current-error-port) \"[~as] ready ~a\\n\" (inexact->exact (round (time->seconds (current-time)))) name)\n    93\t               (force-output (current-error-port)))\n    94\t             (table-set! loaded name 'ready)))))))\n    95\t  (set-ns-load-target! load-namespace)\n    96\t  (set-ns-with-load-opts!\n    97\t    (lambda (flags proceed)\n    98\t      (unless (null? flags)\n    99\t        (throw-jvm 'UnsupportedOperationException\n   100\t                   (string-append \"require option is unsupported on the gambit source loader: :\"\n   101\t                                  (car flags))))\n   102\t      (proceed #f)))\n   103\t  (def-var! \"jolt.host\" \"scheme-eval-string\" gambit-source-scheme-eval)\n   104\t  (def-var! \"clojure.core\" \"require\" jolt-require)\n   105\t  (def-var! \"clojure.core\" \"use\" jolt-use)\n   106\t  load-namespace)\n     1\t(ns dao.stream.waitset.driver\n     2\t  \"The local Gambit owner waits on the Scheme input port or its cadence timer.\"\n     3\t  (:require [jolt.scheme :as scheme]))\n     4\t\n     5\t(def ^:private wait-input (scheme/proc \"gambit-yin-wait-input!\"))\n     6\t\n     7\t(def make-wake (scheme/proc \"gambit-yin-wake\"))\n     8\t(def close! (scheme/proc \"gambit-yin-close-wake!\"))\n     9\t(defn nudge! [_wake] nil)\n    10\t\n    11\t(defn sleep! [wake ms]\n    12\t  (wait-input wake ms nil))\n    13\t\n    14\t(defn sleep-fds! [wake ms _pump on-line]\n    15\t  (wait-input wake ms on-line))\n    16\t\n    17\t(defn sleep-input! [wake ms on-line]\n    18\t  (sleep-fds! wake ms nil on-line))\n{\n  \"source\": \"p1b-inv/shim-registry.edn @ a6852ef8; selected ordinary procedure shapes, plus scalar ABI fixtures\",\n  \"shapes\": [\n    {\n      \"id\": \"s01\",\n      \"args\": [],\n      \"ret\": \"int\",\n      \"capture\": false,\n      \"varargs\": null\n    },\n    {\n      \"id\": \"s01b\",\n      \"args\": [],\n      \"ret\": \"integer-32\",\n      \"capture\": false,\n      \"varargs\": null\n    },\n    {\n      \"id\": \"s02\",\n      \"args\": [\n        \"void*\",\n        \"size_t\"\n      ],\n      \"ret\": \"int\",\n      \"capture\": false,\n      \"varargs\": null\n    },\n    {\n      \"id\": \"s03\",\n      \"args\": [\n        \"void*\",\n        \"size_t\"\n      ],\n      \"ret\": \"void\",\n      \"capture\": false,\n      \"varargs\": null\n    },\n    {\n      \"id\": \"s12\",\n      \"args\": 