t-ffi.ss:429:(def-var! \"jolt.ffi\" \"__read\" joltffi-read-fn)\nhost/gambit/host-ffi.ss:430:(def-var! \"jolt.ffi\" \"__write\" joltffi-write-fn)\nhost/gambit/host-ffi.ss:431:(def-var! \"jolt.ffi\" \"copy\" joltffi-copy)\nhost/gambit/host-ffi.ss:432:(def-var! \"jolt.ffi\" \"__copy\" joltffi-copy)\nhost/gambit/host-ffi.ss:433:(def-var! \"jolt.ffi\" \"sizeof\" (lambda (ty) (joltffi-sizeof-chez (joltffi-type->chez ty))))\nhost/gambit/host-ffi.ss:434:(def-var! \"jolt.ffi\" \"__sizeof\" (lambda (ty) (joltffi-sizeof-chez (joltffi-type->chez ty))))\nhost/gambit/host-ffi.ss:435:(def-var! \"jolt.ffi\" \"__size\" joltffi-recorded-size)\nhost/gambit/host-ffi.ss:436:(def-var! \"jolt.ffi\" \"__remember-size!\" joltffi-remember-size!)\nhost/gambit/host-ffi.ss:437:(def-var! \"jolt.ffi\" \"__forget-sizes!\" joltffi-forget-sizes!)\nhost/gambit/host-ffi.ss:438:(def-var! \"jolt.ffi\" \"read-bytes\" joltffi-read-bytes)\nhost/gambit/host-ffi.ss:439:(def-var! \"jolt.ffi\" \"write-bytes\" joltffi-write-bytes)\nhost/gambit/host-ffi.ss:440:(def-var! \"jolt.ffi\" \"__read-bytes\" joltffi-read-bytes)\nhost/gambit/host-ffi.ss:441:(def-var! \"jolt.ffi\" \"__write-bytes\" joltffi-write-bytes)\nhost/gambit/host-ffi.ss:442:(def-var! \"jolt.ffi\" \"null?\" (lambda (p) (if (joltffi-null? p) #t #f)))\nhost/gambit/host-ffi.ss:443:(def-var! \"jolt.ffi\" \"null\" joltffi-null)\nhost/gambit/host-ffi.ss:444:(def-var! \"jolt.ffi\" \"ptr->string\" joltffi-ptr->string)\nhost/gambit/host-ffi.ss:445:(def-var! \"jolt.ffi\" \"string->ptr\" joltffi-string->ptr)\nhost/gambit/host-ffi.ss:446:(def-var! \"jolt.ffi\" \"__string->ptr\" joltffi-string->ptr)\nhost/gambit/host-ffi.ss:447:(def-var! \"jolt.ffi\" \"__utf8-length\" joltffi-utf8-length)\nhost/gambit/scheme-adapter-runtime.ss:849:(define (sa-baked-global sym)\nhost/chez/compile-eval.ss:984:(def-var! \"clojure.core\" \"eval\"\nhost/chez/compile-eval.ss:1001:(def-var! \"jolt.host\" \"eval-string\" jolt-eval-string)\nhost/chez/compile-eval.ss:1019:(def-var! \"jolt.host\" \"scheme-eval-string\"\nhost/chez/rt.ss:2198:(define (var-deref ns name) (var-cell-root (jolt-var ns name)))\nhost/chez/scheme-adapter-runtime.ss:1169:(define (sa-baked-global sym)\n    30\t  numeric-address?, reverse-lookup, interface-index, interface-addresses.\n    31\t\n    32\t  Constants are plain defs (af-inet, sol-socket, pollin, eaddrinuse, ...) for\n    33\t  this host; consts-for answers the table for any of :macos :linux :windows.\"\n    34\t  (:require [jolt.ffi :as ffi]\n    35\t            [jolt.winsock :as winsock]\n    36\t            [clojure.string :as str]))\n    37\t\n    38\t;; -- platform ------------------------------------------------------------------\n    39\t\n    40\t(def os\n    41\t  \"This host's socket platform: :macos, :windows or :linux. Every other POSIX\n    42\t  host jolt runs on takes Linux's numbers.\"\n    43\t  (let [n (str/lower-case (or (System/getProperty \"os.name\") \"\"))]\n    44\t    (cond (str/includes? n \"mac\") :macos\n    45\t          (str/includes? n \"win\") :windows\n    46\t          :else :linux)))\n    47\t\n    48\t(def ^:private macos?   (= os :macos))\n    49\t(def ^:private windows? (= os :windows))\n    50\t\n    51\t(defn consts-for\n   195\t\n   196\t(def poll-readable\n   197\t  \"The revents under which a recv answers at once: data, a hangup (0) or a bad\n   198\t  fd (-1). Anything else — writability above all — means a recv would block.\"\n   199\t  (bit-or pollin pollerr pollhup pollnval))\n   200\t\n   201\t;; -- bindings -----------------------------------------------------------------\n   202\t;; POSIX: the running process's own libc. Windows: ws2_32, which has to be asked\n   203\t;; for by name — its symbols are not in jolt.exe's export table even though it is\n   204\t;; linked in (jolt.winsock says more) — and kernel32 for handle inheritance.\n   205\t(ffi/load-library)\n   206\t(when windows?\n   207\t  (ffi/load-library [\"ws2_32.dll\" \"ws2_32\"])\n   208\t  (ffi/load-library [\"kernel32.dll\" \"kernel32\"])\n   209\t  ;; if_nametoindex only — a scope zone named by interface (fe80::1%eth0) is\n   210\t  ;; the one thing that asks, so a host without it answers no index rather\n   211\t  ;; than failing the namespace\n   212\t  (try (ffi/load-library [\"iphlpapi.dll\" \"iphlpapi\"]) (catch Throwable _ nil)))\n   213\t\n   214\t;; accept/connect/recv/send/poll may block — :blocking emits them collect-safe,\n   215\t;; so a thread parked in one never holds up the collector.\n   216\t(ffi/defcfn c-socket      \"socket\"      [:int :int :int] :int {:capture-native-error true})\n   217\t(ffi/defcfn c-bind        \"bind\"        [:int :pointer :int] :int {:capture-native-error true})\n   420\t(defn close-on-exec?\n   421\t  \"Whether fd is kept from processes this one starts: FD_CLOEXEC on POSIX, a\n   422\t  socket handle that is not inheritable on Windows.\"\n   423\t  [fd]\n   424\t  (if windows?\n   425\t    (let [p (int-cell 0)]\n   426\t      (try\n   427\t        (and (not (zero? (c-get-handle-information fd p)))\n   428\t             (zero? (bit-and (ffi/read p :int 0) handle-flag-inherit)))\n   429\t        (finally (ffi/free p))))\n   430\t    (let [[flags _] (c-fcntl fd f-getfd 0)]\n   431\t      (and (not (neg? flags)) (pos? (bit-and flags fd-cloexec))))))\n   432\t\n   433\t(defn close-on-exec!\n   434\t  \"Keep fd from every process this one starts. Without it each child — a build,\n   435\t  a REPL, a test runner — holds a duplicate of the socket: a listener's port\n   436\t  stays bound while any of them lives, and an accepted connection stays open\n   437\t  past its close. Answers whether the flag is set, read back.\"\n   438\t  [fd]\n   439\t  (if windows?\n   440\t    (c-set-handle-information fd handle-flag-inherit 0)\n   441\t    (c-fcntl fd f-setfd fd-cloexec))\n   442\t  (close-on-exec? fd))\n   443\t\n   444\t(defn set-blocking!\n   445\t  \"Put fd in blocking (true) or non-blocking (false) mode: O_NONBLOCK on POSIX,\n   446\t  FIONBIO on Windows. Answers [result error].\"\n   447\t  [fd blocking?]\n   448\t  (if windows?\n   449\t    (let [p (int-cell (if blocking? 0 1))]\n   450\t      (try (c-ioctl fd fionbio p)\n   451\t           (finally (ffi/free p))))\n   452\t    (let [[flags e :as r] (c-fcntl fd f-getfl 0)]\n   453\t      (if (neg? flags)\n   454\t        r\n   455\t        (c-fcntl fd f-setfl (if blocking?\n   456\t                              (bit-and-not flags o-nonblock)\n   457\t                              (bit-or flags o-nonblock)))))))\n   458\t\n   459\t(defn available\n   460\t  \"How many bytes can be read from fd without waiting (FIONREAD), or -1 when\n   461\t  the call fails.\"\n   462\t  [fd]\n   463\t  (let [p (int-cell 0)]\n   464\t    (try\n   465\t      (let [[r _] (c-ioctl fd fionread p)]\n   550\t    (ffi/write sa :uint16 family 0)))\n   551\t\n   552\t(defn sockaddr-ip\n   553\t  \"The presentation form of sa's address: a dotted quad for v4, inet_ntop's\n   554\t  RFC 5952 form for v6 (no scope zone). nil for any other family.\"\n   555\t  [sa]\n   556\t  (let [fam (sockaddr-family sa)]\n   557\t    (cond\n   558\t      (= fam af-inet)\n   559\t      (str/join \".\" (map #(ffi/read sa :uint8 (+ 4 %)) (range 4)))\n   560\t\n   561\t      (= fam af-inet6)\n   562\t      (let [out (ffi/alloc 46)]\n   563\t        (try\n   564\t          (let [p (c-inet-ntop af-inet6 (+ sa 8) out 46)]\n   565\t            (when-not (or (nil? p) (ffi/null? p)) (ffi/ptr->string out)))\n   566\t          (finally (ffi/free out)))))))\n   567\t\n   568\t(defn sockaddr-scope-id\n   615\t\n   616\t(defn local-address\n   617\t  \"{:family :ip :port :scope-id} fd is bound to, or nil when getsockname fails.\"\n   618\t  [fd] (named-address c-getsockname fd))\n   619\t\n   620\t(defn peer-address\n   621\t  \"{:family :ip :port :scope-id} of fd's peer, or nil when getpeername fails.\"\n   622\t  [fd] (named-address c-getpeername fd))\n   623\t\n   624\t(defn local-port\n   625\t  \"The port fd is bound to — the kernel's pick after binding port 0 — or -1.\"\n   626\t  [fd]\n   627\t  (or (:port (local-address fd)) -1))\n   628\t\n   629\t;; -- name resolution --------------------------------------------------------------\n   630\t\n   631\t(def ^:private addrinfo-size 48)\n   632\t(def ^:private ai-passive 1)\n   633\t\n   634\t(defn- literal-addr\n   635\t  \"The resolve-addrs entry for host when it is a numeric literal of an allowed\n   636\t  family, else nil.\"\n   637\t  [host port family]\n   638\t  (some (fn [fam]\n   639\t          (when (or (nil? family) (= family fam))\n   640\t            (when-let [[sa len] (make-sockaddr fam host port)]\n   641\t              {:family fam :addr sa :addrlen len :ip (sockaddr-ip sa) :scope-id 0})))\n    75\t;; rather than only on a Windows runner.\n    76\t(def ^:private poll-backend?\n    77\t  (or windows? (= \"poll\" (jolt.host/getenv \"JOLT_IO_POLLER\"))))\n    78\t\n    79\t(def ^:private F-GETFL 3)\n    80\t(def ^:private F-SETFL 4)\n    81\t(def ^:private O-NONBLOCK (if macos? 0x4 0x800))\n    82\t(def ^:private EAGAIN (if macos? 35 11))\n    83\t(def ^:private EINTR 4)\n    84\t(def ^:private EINPROGRESS (if macos? 36 115))\n    85\t(def ^:private EALREADY (if macos? 37 114))\n    86\t(def ^:private SOL-SOCKET (if macos? 0xffff 1))\n    87\t(def ^:private SO-ERROR (if macos? 0x1007 4))\n    88\t\n    89\t;; -- syscalls -----------------------------------------------------------------\n    90\t(ffi/defcfn c-fcntl \"fcntl\" [:int :int :varargs :int] :int)\n    91\t(ffi/defcfn c-close \"close\" [:int] :int)\n    92\t(ffi/defcfn c-write \"write\" [:int :pointer :size_t] :ssize_t)\n    93\t(ffi/defcfn c-getsockopt \"getsockopt\" [:int :int :int :pointer :pointer] :int)\n    94\t;; macOS: kqueue/kevent. kevent's timeout is a NULL-able pointer; NULL (via\n    95\t;; ffi/null means wait forever. :blocking => __collect_safe.\n    96\t(ffi/defcfn c-kqueue \"kqueue\" [] :int)\n    97\t(ffi/defcfn c-kevent \"kevent\" [:int :pointer :int :pointer :int :pointer] :int :blocking)\n    98\t;; The same call for a registration: no event list, so it returns at once and has\n    99\t;; no need to be collect-safe. Answers [result errno].\n   100\t(ffi/defcfn c-kevent-change \"kevent\" [:int :pointer :int :pointer :int :pointer] :int\n   101\t  {:capture-native-error true})\n   102\t;; Linux: epoll. epoll_wait's timeout is milliseconds; -1 means forever.\n   103\t(ffi/defcfn c-epoll-create1 \"epoll_create1\" [:int] :int)\n   104\t(ffi/defcfn c-epoll-ctl \"epoll_ctl\" [:int :int :int :pointer] :int)\n   105\t(ffi/defcfn c-epoll-wait \"epoll_wait\" [:int :pointer :int :int] :int :blocking)\n   106\t(ffi/defcfn c-eventfd \"eventfd\" [:uint :int] :int)\n   107\t\n   108\t;; -- fd helpers (the socket layer's syscall surface) ---------------------------\n   109\t(defn errno [] (ffi/errno))\n   445\t\n   446\t;; The fd's owner is closing it. Every wait on the fd returns now, and every\n   447\t;; later one returns at once, until forget!: parked fibers are resumed, and\n   448\t;; threads blocked in wait-thread are woken through their own wake handle, since\n   449\t;; nothing about the fd itself will ever signal them. Each woken caller sees its\n   450\t;; owner closed and raises instead of retrying.\n   451\t;;\n   452\t;; The fd must still be open, and must stay open until every operation on it has\n   453\t;; left — that is the owner's use count (jolt.socket, process.ss). Closing it\n   454\t;; first frees the number for the next socket or pipe, and a woken operation\n   455\t;; would then retry on someone else's descriptor.\n   456\t(defn cancel! [fd]\n   457\t  (let [woken (locking pm\n   458\t                (let [e (get-in @state [:fds fd])]\n   459\t                  (swap! state (fn [s] (-> s\n   460\t                                           (update :cancelled conj fd)\n   461\t                                           (update :pending dissoc fd)\n   462\t                                           (update :fds dissoc fd))))\n   463\t                  (doseq [h (get-in @state [:threads fd])] (thread-wake! h))\n   464\t                  (when (and poll-backend? e) (pipe-write!))\n   465\t                  (into (vec (:waiters (:read e))) (:waiters (:write e)))))]\n   466\t    (doseq [f woken] (jolt.host/fiber-resume f))))\n   467\t\n   468\t;; The fd's story ends with its owner: it is about to be closed and nothing is\n   469\t;; using it. Drop every trace of it, so the next owner of the number starts\n   470\t;; fresh — a previous owner's cancelled mark would\n   471\t;; otherwise answer the new owner's first wait. Anything still waiting is woken\n   472\t;; as cancel! would, which only matters to an owner that skipped cancel!.\n   473\t(defn forget! [fd]\n   474\t  (let [woken (locking pm\n   475\t                (let [e (get-in @state [:fds fd])]\n   476\t                  (doseq [h (get-in @state [:threads fd])] (thread-wake! h))\n   477\t                  ;; WSAPoll is holding the fd in its current set; wake it so the\n   478\t                  ;; next round's set leaves the fd out. The owner may close the\n   479\t                  ;; fd before that round, and a new socket given the number can\n   480\t                  ;; then see a spurious wake from the old set — harmless, every\n   481\t                  ;; woken operation retries its call\n   482\t                  (when (and poll-backend? e) (pipe-write!))\n   483\t                  (swap! state (fn [s] (-> s\n   484\t                                           (update :cancelled disj fd)\n   485\t                                           (update :pending dissoc fd)\n   486\t                                           (update :fds dissoc fd))))\n   487\t                  (into (vec (:waiters (:read e))) (:waiters (:write e)))))]\n   488\t    (doseq [f woken] (jolt.host/fiber-resume f))))\n   489\t\n   490\t;; A point-in-time classification of the poller's table, for a stress gate to\n   491\t;; print WHEN it loses a wakeup — which of the stages lost it is otherwise\n   492\t;; unrecoverable after the sockets close. Cheap and lock-free on purpose: one\n   493\t;; atom read; the caller is already in a failure path.\n   494\t;;   :pending entries -> WSAPoll only: registered, its round has not run\n   495\t;;   waiters>0        -> in the kernel set (or a round's), event never fired\n       3\n","exit_code":0,"status":"completed"}}
