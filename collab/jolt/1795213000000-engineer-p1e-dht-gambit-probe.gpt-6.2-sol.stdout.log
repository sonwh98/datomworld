6), stripping brackets if present.\n   173\t   Rejects hostnames like 'localhost'.\"\n   174\t  [h]\n   175\t  (try\n   176\t    (when (string? h)\n   177\t      (let [clean (if (and (str/starts-with? h \"[\") (str/ends-with? h \"]\"))\n   178\t                    (subs h 1 (dec (count h)))\n   179\t                    h)]\n   180\t        (if-let [[sa _] (native/make-sockaddr native/af-inet clean 0)]\n   181\t          (do (ffi/free sa) {:family native/af-inet :ip clean})\n   182\t          (if-let [[sa _] (native/make-sockaddr native/af-inet6 clean 0)]\n   183\t            (do (ffi/free sa) {:family native/af-inet6 :ip clean})\n   184\t            nil))))\n   185\t    (catch Throwable _ nil)))\n   186\t\n   187\t\n   188\t(defn- deposit-event!\n   189\t  [deposit event]\n   190\t  (try\n   190\t  (try\n   191\t    (stream/append! deposit event)\n   192\t    (catch Throwable _ nil)))\n   193\t\n   194\t\n   195\t(defn- failed-seam\n   196\t  [deposit identity reason]\n   197\t  (deposit-event! deposit (datagram/bind-failed-event identity reason))\n   198\t  (let [diagnostics (atom [{:kind :bind-failed :reason reason}])]\n   199\t    {:send! (fn [_ _ _]\n   200\t              {:dao.stream/outcome :dao.stream/transport-error\n   201\t               :dao.stream.datagram/reason \"bind failed\"})\n   202\t     :close! (fn [] nil)\n   203\t     :step! (fn [] {:progressed? false})\n   204\t     :diagnostics diagnostics\n   205\t     :diagnostic (fn [] (last @diagnostics))}))\n   206\t\n   207\t\n   208\t;; =============================================================================\n   209\t;; Native Datagram Seam bind!\n   210\t;; =============================================================================\n   211\t\n   212\t(defn bind!\n   213\t  \"Bind one native datagram socket per the seam contract (§3).\n   214\t   `:bind-host` defaults to '127.0.0.1', `:bind-port` to 0 (ephemeral),\n   215\t   `:max-bytes` to 1200.\n   216\t   Returns {:send! f :close! f :step! f