tes base))))))\n   226\t\n   227\t\n   228\t(defn- store-message-size\n   229\t  \"The encoded size bound of the store message for address and bs: the\n   230\t   largest query id and a full cookie, so the check never under-counts.\"\n   231\t  [address bs]\n   232\t  (byte-count (wire/encode {::v 1, :op :store, :q max-safe-integer,\n   233\t                            :id (zero-bytes id-length),\n   234\t                            :cookie (zero-bytes cookie-length),\n   235\t                            :address address, :bytes bs})))\n   236\t\n   237\t\n   238\t(defn- oversize?\n   239\t  [max-message-bytes address bs]\n   240\t  (> (store-message-size address bs) max-message-bytes))\n   241\t\n   242\t\n   243\t(defn payload-budget\n   244\t  \"The most payload bytes one `:store` message can carry inside\n   245\t  `max-message-bytes`: the transport's own statement of the payload\n   246\t  capability a storage composition declares as its byte ceiling.\n   247\t\n   248\t  Derived, never hardcoded, and derived from the same encoder and the same\n   249\t  envelope the refusal uses (`store-message-size`): the maximal query\n   250\t  identifier, a full cookie, the longest address form the registry can\n   251\t  mint (`dao.jing/max-segment-address`) and the byte-string header widths.\n   252\t  A header widens with the payload it heads, so the empty-payload envelope\n   253\t  alone under-counts: the candidate is measured with the real encoder and\n   254\t  reduced until the whole message fits.  Terminating — the candidate\n   255\t  strictly decreases and `0` is always encodable — and exact, so a payload\n   256\t  of this length is never refused by `oversize?` and one byte longer\n   257\t  always is.\n   258\t\n   259\t  `max-message-bytes` must be a positive integer; a bound no envelope fits\n   260\t  answers `0`, which declares that this transport carries no payload at\n   261\t  all rather than silently falling back to an unbounded ceiling.\"\n   262\t  ([max-message-bytes] (payload-budget max-message-bytes (jing/max-segment-address)))\n   263\t  ([max-message-bytes address]\n   264\t   (when-not (and (integer? max-message-bytes) (pos? max-message-bytes))\n   265\t     (throw (ex-info \"payload-budget needs a positive message bound\"\n   266\t                     {:max-message-bytes max-message-bytes})))\n   267\t   (let [envelope (store-message-size address (zero-bytes 0))]\n   268\t     (loop [n (max 0 (- max-message-bytes envelope))]\n   269\t       (cond\n   270\t         (zero? n) 0\n  1362\t;; Section 5.1: the byte-store handle\n  1363\t;; =============================================================================\n  1364\t\n  1365\t(defn store-handle\n  1366\t  \"The plain-data dao.jing byte-store handle over a DHT composition's\n  1367\t   :local and :requests: put-bytes-fn validates, refuses an oversize store\n  1368\t   message, inserts into :local, appends {:dao.jing.dht/replicate address}\n  1369\t   and returns the local verdict at once -- never the acknowledgement,\n  1370\t   which is the :dao.jing.dht/sent fact. get-bytes-fn reads :local only\n  1371\t   and never touches the network; close-fn closes :local.\"\n  1372\t  [{:keys [local requests max-message-bytes]}]\n  1373\t  (when-not (and (ifn? (:put-bytes-fn local)) (ifn? (:get-bytes-fn local)))\n  1374\t    (throw (defect \"store-handle needs a :local byte-store handle\"\n  1375\t             {:local local})))\n  1376\t  (when-not (and requests (stream/writer? requests))\n  1377\t    (throw (defect \"store-handle needs a :requests writer\" {})))\n  1378\t  (let [limit (or max-message-bytes (::max-message-bytes defaults))]\n  1379\t    {:local local\n  1380\t     :requests requests\n  1381\t     :put-bytes-fn\n  1382\t     (fn [address bs]\n  1383\t       (when-not (jing/segment-bytes-match? address bs)\n  1384\t         (throw (defect \"content address does not match the bytes\"\n  1385\t                  {:address address})))\n  1386\t       (when (oversize? limit address bs)\n  1387\t         (throw (defect \"the store message exceeds max-message-bytes\"\n  1388\t                  {:address address, :reason ::oversize,\n  1389\t                   :max-message-bytes limit})))\n  1390\t       (let [verdict ((:put-bytes-fn local) address bs)]\n  1391\t         (stream/append! requests {::replicate address})\n  1392\t         verdict))\n  1393\t     :get-bytes-fn (fn [address not-found]\n  1394\t                     ((:get-bytes-fn local) address not-found))\n  1395\t     :close-fn (fn [] (jing/close! local))}))\nsrc/cljc/dao/stream/cbor.cljc:93:(defn encode\nsrc/cljc/dao/stream/cbor/boring.cljc:10:     tag 258 sets, and the `clojure/with-meta` tag 27 frame for collection\nsrc/cljc/dao/stream/cbor/boring.cljc:85:         (with-meta (mapv rewrite x) (rewrite m))\nsrc/cljc/dao/stream/cbor/boring.cljc:90:         (with-meta (into #{} (map rewrite) x) (rewrite m))\nsrc/cljc/dao/stream/cbor/boring.cljc:95:         (with-meta (into {} (map (fn [[k v]] [(rewrite k) (rewrite v)])) x)\nsrc/cljc/dao/stream/cbor/boring.cljc:101:         (with-meta x (rewrite m))\nsrc/cljc/dao/stream/cbor/boring.cljc:118:       (with-meta (apply list (mapv convert elems)) (some-> m convert)))))\nsrc/cljc/dao/stream/cbor/boring.cljc:129:       (with-meta converted (convert m))\nsrc/cljc/dao/stream/cbor/boring.cljc:162:         (with-meta x (convert m))\nsrc/cljc/dao/stream/cbor/boring.cljc:174:   (defn encode\n(ns dao.stream.cbor\n  \"The DaoStream v2 CBOR wire codec: the binary twin of the Transit codec.\n\n   The portable domain here is stream-owned and deliberately NOT Jing's: it\n   keeps the Transit profile's base domain (nil, booleans, strings, safe\n   numbers, qualified identifiers, maps, vectors, lists, sets) and widens it\n   with exactly what D7 asked the intake stream to carry — metadata,\n   reader positions included, preserved on collections and symbols, the\n   list/vector distinction, and host byte payloads as CBOR byte strings,\n   the carrier Jing's boundary adapter (`dao.jing.stream`) rides its\n   canonical bytes on.  Identifiers ride Boring's native tag 39 mapping,\n   so an identifier whose printed form would not round-trip (a name or\n   namespace containing `/`, a name starting with `:`, an empty component)\n   is rejected loudly before the wire rather than silently munged.\n\n   Implementations: pinned Boring (0.1.30) on the JVM and ClojureScript; the\n   pub.dev `cbor` package (6.5.1) behind the same interface on Dart.  The\n   byte-level contract both implement is `dao.stream.cbor.boring`'s doc.\"\n  (:require [clojure.string :as str]\n            [dao.stream.codec :as codec]\n            #?(:cljd [dao.stream.cbor.cljd :as impl]\n               :default [dao.stream.cbor.boring :as impl])))\n\n\n(defn- portable-identifier?\n  [x]\n  (and (or (keyword? x) (symbol? x))\n       (let [ns (namespace x)\n             name (name x)]\n         (and (pos? (count name))\n              (not (str/starts-with? name \":\"))\n              (not (str/includes? name \"/\"))\n              (or (nil? ns)\n                  (and (pos? (count ns))\n                       (not (str/starts-with? ns \":\"))\n                       (not (str/includes? ns \"/\"))))))))\n\n\n(declare portable-value?)\n\n\n(defn- portable-meta?\n  [x]\n  ;; ClojureDart attaches call-site metadata (with a dart Type `:tag`) to\n  ;; list call results; the Dart codec treats that as absent, so the domain\n  ;; gate must not see it either.\n  (let [m #?(:cljd (impl/strip-constructor-meta (meta x))\n             :default (meta x))]\n    (or (nil? m) (portable-value? m))))\n\n\n(defn portable-value?\n  \"True when x belongs to the CBOR profile's portable domain: the Transit\n   domain plus metadata (recursively portable) on collections and symbols,\n   plus host byte payloads, which ride as CBOR byte strings (major type 2)\n   — the carrier `dao.jing.stream`'s boundary adapter puts Jing's canonical\n   bytes on.\"\n  [x]\n  (cond\n    (nil? x) true\n    (or (true? x) (false? x) (string? x)) true\n    (impl/byte-payload? x) true\n    (or (keyword? x) (symbol? x)) (and (portable-identifier? x)\n                                       (or (keyword? x) (portable-meta? x)))\n    (number? x) (codec/safe-number? x)\n    (map? x) (and (not (record? x)) (portable-meta? x)\n                  (every? (fn [[k v]] (and (portable-value? k) (portable-value? v))) x))\n    (vector? x) (and (portable-meta? x) (every? portable-value? x))\n    (list? x) (and (portable-meta? x) (every? portable-value? x))\n    (set? x) (and (portable-meta? x) (every? portable-value? x))\n    :else false))\n\n\n(defn validate-portable\n  \"Returns nil for a portable value, or a small diagnostic map otherwise.\"\n  [x]\n  (when-not (portable-value? x)\n    {:error :non-portable-value :value x}))\n\n\n(def byte-payload?\n  \"Forwards to `dao.stream.codec/host-bytes?`.\"\n  codec/host-bytes?)\n\n\n(defn- ensure-portable!\n  [x]\n  (when-let [error (validate-portable x)]\n    (throw (ex-info \"value is outside the dao.stream.cbor portable domain\" error)))\n  x)\n\n\n(defn encode\n  \"Encode one portable value as CBOR bytes (a host byte payload: byte[] on\n   the JVM, Uint8Array on ClojureScript, Uint8List on Dart).\"\n  [value]\n  (ensure-portable! value)\n  (impl/encode value))\n\n\n(defn decode\n  \"Decode CBOR bytes into the portable domain, rejecting anything outside\n   it — trailing items, unknown tags or names, out-of-domain values.\"\n  [bytes]\n  (ensure-portable! (impl/decode bytes)))\n","exit_code":0,"status":"completed"}}
