         (str \"IPV6_V6ONLY failed: errno \" err-v6))))]\n   248\t                      (if v6-fail\n   249\t                        (do\n   250\t                          (close-fd!)\n   251\t                          (failed-seam deposit identity v6-fail))\n   252\t                        (let [[sa len] (native/make-sockaddr family bind-ip bind-port)]\n   253\t                          (if-not sa\n   254\t                            (do\n   255\t                              (close-fd!)\n   256\t                              (failed-seam deposit identity (str \"make-sockaddr failed for \" bind-ip \":\" bind-port)))\n   257\t                            (let [[bind-r bind-err] (try\n   258\t                                                      (native/c-bind fd sa len)\n   259\t                                                      (finally (ffi/free sa)))]\n   260\t                              (if (neg? bind-r)\n   261\t                                (do\n   262\t                                  (close-fd!)\n   263\t                                  (failed-seam deposit identity (str \"bind failed: errno \" bind-err)))\n   264\t                                (let [local (native/local-address fd)]\n   265\t                                  (if-not local\n   266\t                                    (do\n   267\t                                      (close-fd!)\n   268\t                                      (failed-seam deposit identity \"getsockname failed\"))\n   269\t                                    (let [diagnostics (atom [])\n   270\t                                          close-fn\n   271\t                                          (fn []\n   272\t                                            (when (compare-and-set! closed? false true)\n   273\t                                              (try (poller/cancel! fd) (catch Throwable _ nil))\n   274\t                                              (try (poller/forget! fd) (catch Throwable _ nil))\n   275\t                                              (native/c-close fd)\n   276\t                                              (deposit-event! deposit (datagram/closed-event identity)))\n   277\t                                            nil)\n   278\t\n   279\t                                          send-fn\n   280\t                                          (fn [dest-host dest-port ^bytes payload]\n   281\t                                            (if @closed?\n   282\t                                              {:dao.stream/outcome :dao.stream/closed}\n   283\t                                              (let [parsed-dest (parse-literal-host dest-host)]\n   284\t                                                (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))\n   285\t                                                  (let [reason \"IP family mismatch\"]\n   300\t                                                              (when (pos? len)\n   301\t                                                                (ffi/write-array buf payload))\n   302\t                                                              (let [[n e] (*sendto* fd buf len 0 dsa dlen)]\n   303\t                                                                (cond\n   304\t                                                                  (neg? n)\n   305\t                                                                  (let [reason (str \"sendto failed: errno \" e)]\n   306\t                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n   307\t                                                                    {:dao.stream/outcome :dao.stream/transport-error\n   308\t                                                                     :dao.stream.datagram/reason reason})\n   309\t\n   310\t                                                                  (not= n len)\n   311\t                                                                  (let [reason (str \"short send: sent \" n \" of \" len \" bytes\")]\n   312\t                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n   313\t                                                                    {:dao.stream/outcome :dao.stream/transport-error\n   314\t                                                                     :dao.stream.datagram/reason reason})\n   315\t\n   316\t                                                                  :else\n   317\t                                                                  {:dao.stream/outcome :dao.stream/ok}))))\n   318\t                                                          (finally\n   319\t                                                            (when dsa (ffi/free dsa)))))\n   320\t                                                      (finally\n   321\t                                                        (ffi/free buf))))))))\n   322\t\n   323\t                                          step-fn\n   324\t                                          (fn []\n   325\t                                            (if @closed?\n   326\t                                              {:progressed? false}\n   327\t                                              (let [cap (inc max-bytes)\n   328\t                                                    buf (ffi/alloc cap)]\n   329\t                                                (try\n   330\t                                                  (let [[rsa rlenp] (native/alloc-sockaddr)]\n   331\t                                                    (try\n   332\t                                                      (let [progressed? (volatile! false)]\n   333\t                                                        (loop [budget 64]\n   334\t                                                          (when (pos? budget)\n   335\t                                                            (ffi/write rlenp :int native/sockaddr-storage-size 0)\n   336\t                                                            (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]\n   337\t                                                              (cond\n   338\t                                                                (neg? n)\n   339\t                                                                (cond\n   340\t                                                                  ;; would-block: silent\n   341\t                                                                  (or (= e EAGAIN) (= e ENOBUFS))\n   342\t                                                                  nil\n   343\t\n   344\t                                                                  ;; interruption: recoverable, no retry inside turn\n   345\t                                                                  (= e EINTR)\n   346\t                                                                  (swap! diagnostics conj\n   347\t                                                                         {:kind :interrupted\n   348\t                                                                          :errno e\n   349\t                                                                          :reason (str \"recvfrom interrupted: errno \" e)})\n   350\t\n   351\t                                                                  ;; genuine descriptor error: close seam once\n   352\t                                                                  (or (= e EBADF) (= e ENOTSOCK) (= e EPIPE))\n   353\t                                                                  (do\n   354\t                                                                    (swap! diagnostics conj\n   355\t                                                                           {:kind :fatal-descriptor-error\n   356\t                                                                            :errno e\n   357\t                                                                            :reason (str \"recvfrom fatal error: errno \" e)})\n   358\t                                                                    (close-fn))\n   359\t\n   360\t                                                                  ;; asynchronous/non-fatal error: record diagnostic, seam stays open\n   361\t                                                                  :else\n   362\t                                                                  (swap! diagnostics conj\n   363\t                                                                         {:kind :receive-error\n   364\t                                                                          :errno e\n   365\t                                                                          :reason (str \"recvfrom error: errno \" e)}))\n   366\t\n   367\t                                                                :else\n   368\t                                                                (do\n   369\t                                                                  (vreset! progressed? true)\n   370\t                                                                  (if (> n max-bytes)\n   371\t                                                                    ;; Oversize drop\n   372\t                                                                    (recur (dec budget))\n   373\t                                                                    (let [bs (if (zero? n)\n   374\t                                                                               (bytes/alloc 0)\n   375\t                                                                               (ffi/read-array buf n))\n   376\t                                                                          src-ip (native/sockaddr-ip rsa)\n   377\t                                                                          src-port (native/sockaddr-port rsa)]\n   378\t                                                                      (deposit-event! deposit\n   379\t                                                                                      (datagram/datagram-event identity src-ip src-port bs))\n   380\t                                                                      (recur (dec budget)))))))))\n   381\t                                                        {:progressed? @progressed?})\n   382\t                                                      (finally\n   383\t                                                        (when rsa (ffi/free rsa))\n   384\t                                                        (when rlenp (ffi/free rlenp)))))\n   385\t                                                  (finally\n   386\t                                                    (ffi/free buf))))))\n   387\t\n   388\t                                          seam {:send! send-fn\n   389\t                                                :close! close-fn\n   390\t                                                :step! step-fn\n   391\t                                                :diagnostics diagnostics\n   392\t                                                :diagnostic (fn [] (last @diagnostics))}]\n   393\t                                      (deposit-event! deposit (datagram/bound-event identity (:ip local) (:port local)))\n   394\t                                      seam))))))))))))\n   395\t              (catch Throwable t\n   396\t                (close-fd!)\n   397\t                (failed-seam deposit identity (or (ex-message t) (str t)))))))))))\n   630\t\n   631\t   A refusal releases everything it opened, exactly once, and is\n   632\t   answered as itself whatever the release throws: before the join the\n   633\t   directory store is closed; once joined the node owns it, and closing\n   634\t   the node closes the socket and then the store.\"\n   635\t  ([spec] (open spec {}))\n   636\t  ([spec {:keys [key ws write-heads! open-store]}]\n   637\t   (let [{:keys [dir peers publish? bind-host bind-port max-inbound-bytes\n   638\t                 manifest bind!]\n   639\t          :as checked} (checked-spec spec)\n   640\t         follow (checked-follow checked)\n   641\t         base ((or open-store durable/open) dir)\n   642\t         [node records]\n   643\t         (try\n   644\t           (when-some [why (refused-head dir manifest\n   645\t                                         (get-in base [:recovery :manifest]))]\n   646\t             (throw (ex-info why {:dir dir :manifest manifest})))\n   647\t           (let [records (heads-records dir follow)]\n   648\t             [(dht/join {:local base\n   649\t                         :peers peers\n   650\t                         :publish? publish?\n   651\t                         :bind-host bind-host\n   652\t                         :bind-port bind-port\n   653\t                         :max-inbound-bytes max-inbound-bytes\n   654\t                         :repair-slots default-repair-slots\n   655\t                         :bind! (or bind! (dht/default-bind))})\n   656\t              records])\n   657\t           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   658\t             (quietly! #(durable/close! base))\n   659\t             (throw e)))]\n   660\t     ;; from here the node owns the store and holds a socket\n   661\t     (try\n   662\t       (let [[index-store node]\n   663\t             (compose node base checked follow records\n   664\t                      {:key key :ws ws :write-heads! write-heads!})]\n   665\t         {:index-store index-store\n   666\t          :node node\n   667\t          :recovery (:recovery index-store)\n   668\t          :publication-policy (:publication-policy index-store)\n   669\t          :retain-index-on-reset? true})\n   670\t       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   671\t         (quietly! #(dht/close! node))\n   672\t         (throw e))))))\n   673\t\n   674\t\n   675\t(defn follower\n   676\t  \"The head follower a composition's `node` carries, or nil when it\n   677\t   follows nothing.\"\n   585\t              (or (ex-message e) (str e)))]))))\n   586\t\n   587\t\n   588\t(defn startup\n   589\t  \"Parse the arguments and compose the whole shell (the store the parsed\n   590\t   `:index-store-spec` names included), or answer the refusal text.  This\n   591\t   is the one gate every host's `-main` passes through before it prints a\n   592\t   banner or starts a loop, so an invalid `--index-store`, an unsupported\n   593\t   host for it, or a directory that cannot be opened refuses startup with\n   594\t   its reason rather than composing a shell around a fallback store.\n   595\t\n   596\t   Only a designed refusal is answered: an error carrying no ex-info\n   597\t   keeps its stack trace, because it is a defect, not an operator error.\n   598\t\n   599\t   `:composition` is the plain-data contribution of a storage composition\n   600\t   (`parse-args`' and `boot`'s argument of the same name): its flags, its\n   601\t   subcommands, its key file, its help and banner text, its store and its\n   602\t   transport lifecycle.  Every one of those reaches this gate through that\n   603\t   value and none of them is named here, so a host that carries no\n   604\t   composition has the engine's own surface and nothing more.  A\n   605\t   composition's `:keygen-flag` names the one argument that composes\n   606\t   nothing at all: it writes a key file through `:keygen!` and answers\n   607\t   `{:lines [...] :exit 0}` for the host to print and exit with, and no\n   608\t   state file is read or written for such a run.  A key file named on the\n   609\t   command line is loaded by `:load-key` here, and reaches `boot` as\n   610\t   `:publisher-key`.\n   611\t\n   612\t   `:adapter` is the host WebSocket adapter the shell, the composition's\n   613\t   own endpoints and the served endpoint compose over (else\n   614\t   `host/websocket`).  `:flag-table` is the `state/flag-table` the saved\n   615\t   state is read, split, described and written by: an explicit table when\n   616\t   the caller hands one in, else the composition's, else the engine's own.\"\n   617\t  ([args] (startup args nil))\n   618\t  ([args {:keys [persist? home adapter flag-table composition]}]\n   619\t   (try\n   620\t     (if (some #{\"--help\" \"-h\"} args)\n   621\t       {:lines (or (:help-lines composition) help-lines) :exit 0}\n   622\t       (let [reset? (boolean (some #{\"--reset\"} args))\n   623\t             no-state? (boolean (some #{\"--no-state\"} args))\n   624\t             table (or flag-table (composition-flag-table composition))\n   625\t             keygen-flag (:keygen-flag composition)\n   626\t             [args {:keys [new-key unset] node-name :name dir :dir}]\n   627\t             (expand-args (remove #{\"--reset\" \"--no-state\"} args) composition)\n   628\t             node-dir (when (and persist? (not no-state?)\n   629\t                                 (not (and keygen-flag\n   630\t                                           (some #{keygen-flag} args))))\n   631\t                        (or dir\n   632\t                            (some-> (or home (home-dir*))\n   633\t                                    (str \"/.yin/\" node-name))))\n   634\t             saved (when (and node-dir (not reset?))\n   635\t                     (state/load-flags node-dir table))\n   636\t             {:keys [flags rest]} (state/split-args args table)\n   637\t             resolved (state/resolve-flags saved flags unset)\n   638\t             args (into (state/flags->args resolved table) rest)\n   639\t             made (when (and new-key (:ensure-key! composition))\n   640\t                    ((:ensure-key! composition) new-key))\n   641\t             opts (cond-> (try (parse-args args composition)\n   642\t                               (catch #?(:cljd Object\n   643\t                                         :clj Throwable\n   644\t                                         :cljs :default)\n   645\t                                      e\n   646\t                                 (throw (if (and saved (ex-data e))\n   647\t                                          (ex-info (str (ex-message e)\n   648\t                                                        \" (with the saved state in \"\n  1345\t          @wake-ref)))\n  1346\t\n  1347\t     (defn main!\n  1348\t       \"The Node entry point body: compose from `args` and this host's\n  1349\t        `composition`, print the banner, and arm the one tick owner, wiring\n  1350\t        each line producer to the nudge it hands back.\n  1351\t\n  1352\t        `composition` is the plain-data contribution of a storage\n  1353\t        composition, nil for a host that carries none.  `yin.shell.main`\n  1354\t        supplies the one this project ships; `-main` here drives the engine\n  1355\t        alone.\"\n  1356\t       [args composition]\n  1357\t       (let [started (startup args {:persist? true\n  1358\t                                    :composition composition})]\n  1359\t         (when (contains? started :exit) (exit-with! started))\n  1360\t         (if-some [refusal (:refusal started)]\n  1361\t           (refuse! refusal)\n  1362\t           (let [{:keys [opts state server]} started\n  1363\t                 readline (when-not (:headless? opts) (js/require \"readline\"))\n  1364\t                 rl (when readline\n  1365\t                      (.createInterface readline\n  1366\t                                        #js {:input (.-stdin js/process)\n  1367\t                                             :output (.-stdout js/process)\n  1368\t                                             :prompt prompt}))]\n  1369\t             (doseq [line (banner opts composition)]\n  1370\t               (js/console.log line))\n  1371\t             ;; The tick owner arms its first round, and the composition wires\n  1372\t             ;; the deposit it hands each line producer with the nudge: a typed\n  1373\t             ;; line ends the idle sleep at once.\n  1374\t             (let [w (run-node! state server rl)]\n  1375\t               (if rl\n  1376\t                 (do (.on rl \"line\" (fn [line]\n  1377\t                                      (driver/submit-line! (:input state) line)\n  1378\t                                      (wake/nudge! w)))\n  1379\t                     (.on rl \"close\" (fn []\n  1380\t                                       (driver/submit-line! (:input state)\n  1381\t                                                            \"(quit)\")\n  1382\t                                       (wake/nudge! w)))\n  1383\t                     (.prompt rl))\n  1384\t                 ;; Headless has no reader, so the explicit stop trigger is the\n  1385\t                 ;; host signal: it appends a line, nudges, and returns, like\n  1386\t                 ;; any producer.\n  1387\t                 (doseq [signal [\"SIGINT\" \"SIGTERM\"]]\n  1388\t                   (.on js/process signal (fn []\n  1389\t                                            (request-stop! state\n  1390\t                                                           w))))))))))\n  1391\t\n  1392\t     (defn -main\n  1393\t       \"The engine's own Node entry point: the `mem` and `file:<dir>` stores\n  1394\t        and no storage composition.  The shipped product entry point is\n  1395\t        `yin.shell.main/-main`, which supplies one.\"\n  1396\t       [& args]\n  1397\t       (main! args nil))))\n  1398\t\n  1399\t\n  1400\t;; =============================================================================\nrg: src/cljc/dao/jing/dir.cljc: IO error for operation on src/cljc/dao/jing/dir.cljc: No such file or directory (os error 2)\n","exit_code":2,"status":"failed"}}
