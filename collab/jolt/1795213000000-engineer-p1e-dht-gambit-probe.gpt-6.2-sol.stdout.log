  :econnrefused 61 :econnreset 54}\n    85\t    :linux {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 7 :so-rcvbuf 8\n    86\t            :eagain 11 :emsgsize 90 :enobufs 105 :ebadf 9 :enotsock 88 :epipe 32 :eintr 4\n    87\t            :econnrefused 111 :econnreset 104}\n    88\t    (throw (ex-info \"dao.stream.udp: unsupported platform\" {:platform platform}))))\n    89\t\n    90\t(def SOCK-DGRAM (:sock-dgram consts))\n    91\t(def IPPROTO-UDP (:ipproto-udp consts))\n    92\t(def EAGAIN (:eagain consts))\n    93\t(def ENOBUFS (:enobufs consts))\n    94\t(def EMSGSIZE (:emsgsize consts))\n    95\t(def EBADF (:ebadf consts))\n    96\t(def ENOTSOCK (:enotsock consts))\n    97\t(def EPIPE (:epipe consts))\n    98\t(def EINTR (:eintr consts))\n    99\t(def ECONNREFUSED (:econnrefused consts))\n   100\t(def ECONNRESET (:econnreset consts))\n   101\t\n   102\t(ffi/defcfn c-sendto \"sendto\" [:int :pointer :size_t :int :pointer :uint] :ssize_t\n   103\t            {:capture-native-error true})\n   104\t\n   105\t(ffi/defcfn c-recvfrom \"recvfrom\" [:int :pointer :size_t :int :pointer :pointer] :ssize_t\n   106\t            {:capture-native-error true})\n   107\t\n   108\t(def ^:dynamic *sendto* c-sendto)\n   109\t(def ^:dynamic *recvfrom* c-recvfrom)\n   110\t\n   111\t\n   112\t;; =============================================================================\n   113\t;; Exception-Safe Native Helpers\n   114\t;; =============================================================================\n   115\t\n   116\t(defn- int-cell [v]\n   117\t  (let [p (ffi/alloc 4)]\n   118\t    (ffi/write p :int v 0)\n   119\t    p))\n   120\t\n   121\t(defn- write-header! [sa family len]\n   122\t  (if (= platform :macos)\n   123\t    (do (ffi/write sa :uint8 len 0) (ffi/write sa :uint8 family 1))\n   124\t    (ffi/write sa :uint16 family 0)))\n   125\t\n   126\t(defn- alloc-sockaddr\n   127\t  \"Exception-safe allocation of sockaddr_storage and in/out length cell.\n   128\t   Wraps the acquisition