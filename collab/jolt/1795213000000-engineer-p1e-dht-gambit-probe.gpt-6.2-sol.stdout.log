ljd true\n    98\t(defn- dir-refusal\n    99\t  \"Why `dir` cannot hold the durable content log, or nil when it can: a\n   100\t   path occupied by something that is not a directory, a directory this\n   101\t   process cannot write, or a directory that cannot be created.  Nothing\n   102\t   is opened here — the content log itself is opened later, and its open\n   103\t   failure is refused with its own reason.\"\n   104\t  [dir]\n   105\t  #?(:cljd (let [d (dart-io/Directory. dir)\n   106\t                 f (dart-io/File. dir)]\n   107\t             (cond\n   108\t               (.existsSync d) nil\n   109\t               (.existsSync f) (str dir \" is not a directory\")\n   110\t               :else (try (.createSync d .recursive true)\n   111\t                          nil\n   112\t                          (catch Object e\n   113\t                            (str \"cannot create \" dir \": \" (error-text e))))))\n   114\t     :clj (let [f (java.io.File. dir)]\n   115\t            (cond\n   116\t              (and (.exists f) (not (.isDirectory f)))\n   117\t              (str dir \" is not a directory\")\n   118\t\n   119\t              (and (.isDirectory f) (not (.canWrite f)))\n   120\t              (str dir \" is not writable\")\n   121\t\n   122\t              :else\n   123\t              (try (when (and (not (.isDirectory f)) (not (.mkdirs f)))\n   124\t                     (str \"cannot create \" dir))\n   125\t                   (catch Exception e\n   126\t                     (str \"cannot create \" dir \": \" (error-text e))))))\n   127\t     :cljs (let [fs (js/require \"fs\")]\n   128\t             (if (.existsSync fs dir)\n   129\t               (when-not (.isDirectory (.statSync fs dir))\n   130\t                 (str dir \" is not a directory\"))\n   131\t               (try (.mkdirSync fs dir #js {:recursive true})\n   132\t                    nil\n   133\t                    (catch :default e\n   134\t                      (str \"cannot create \" dir \": \" (error-text e))))))))\n   135\t\n   136\t\n   137\t(defn file-refusal\n   138\t  \"Why a `file:<dir>` store cannot open, or nil when it can: a host without\n   281\t(defn open\n   282\t  \"Open `dir` as a durable directory store, exclusively and validating:\n   283\t   the directory lock is acquired before the content log or HEAD is\n   284\t   touched — a second owner, in this process or another, is refused\n   285\t   naming the directory — and every failure after it releases the lock\n   286\t   again.  HEAD is read and the snapshot it names walked in full: an\n   287\t   absent HEAD is an empty index; a malformed HEAD or a corrupt snapshot\n   288\t   refuses rather than opening empty.  A directory this host cannot open\n   289\t   is refused with its reason.\n   290\t\n   291\t   The handle is the content log's plain byte-store fns plus what its\n   292\t   lifecycle owns: `:close-fn`, which releases the lock with the content\n   293\t   log; `:head-fn`, `(fn [manifest-address])`, the atomic HEAD write a\n   294\t   publisher performs after its manifest reads back; `:recovery`,\n   295\t   `{:manifest <address or nil> :datoms <the walked snapshot or nil>}`;\n   296\t   and `:durable-dir`.\"\n   297\t  [dir]\n   298\t  (if-some [refusal (file-refusal dir)]\n   299\t    (throw (ex-info refusal {:dir dir}))\n   300\t    (let [{:keys [handle lock recovery]} (open-locked-dir dir)]\n   301\t      (assoc handle\n   302\t             :close-fn (lock-releasing-close (:close-fn handle) lock)\n   303\t             :head-fn (fn publish-head!\n   304\t                        [manifest-address]\n   305\t                        (fs/atomic-replace!\n   306\t                          dir head-name\n   307\t                          (head-record manifest-address)))\n   308\t             :recovery recovery\n   309\t             :durable-dir dir))))\n   310\t\n   311\t\n   312\t(defn durable?\n   313\t  \"True when `store` is a durable directory store `open` answered 