285\t  (syntax-rules ()\n   286\t    ((_ p0 i0 miss)\n   287\t     (let ((p p0) (i i0))\n   288\t       (if (and (fixnum? i) (fx>=? i 0) (fx<? i (pvec-cnt p)))\n   289\t           (pvec-nth-in-range p i)\n   290\t           miss)))))\n   291\t(define (pvec-nth! p i)\n   292\t  (pvec-ref-or p i\n   328\t  (if (fx=? level 0) node (vector (pv-new-path (fx- level pv-bits) node))))\n   329\t;; push a full tail chunk into the trie under `parent` at `level`.\n   330\t(define (pv-push-tail cnt level parent tail-node)\n   331\t  (let ((subidx (fxand (fxsra (fx- cnt 1) level) pv-mask)))\n   332\t    (if (fx=? level pv-bits)\n   333\t        (vec-set-or-snoc parent subidx tail-node)\n   334\t        (let ((child (and (fx<? subidx (vector-length parent)) (vector-ref parent subidx))))\n   335\t          (vec-set-or-snoc parent subidx\n   336\t            (if child (pv-push-tail cnt (fx- level pv-bits) child tail-node)\n   337\t                      (pv-new-path (fx- level pv-bits) tail-node)))))))\n   338\t(define (pvec-conj p x)\n   339\t  (let ((cnt (pvec-cnt p)) (shift (pvec-shift p)))\n   340\t    (cond\n   341\t      ((fx<? (vector-length (pvec-tail p)) pv-width)\n   342\t       ;; room in the tail (classic and RRB alike)\n   343\t       (mk-pvec (fx+ cnt 1) shift (pvec-root p) (vec-snoc (pvec-tail p) x) (pv-derived-ent p)))\n   344\t      ((rrbnode? (pvec-root p))\n   345\t       ;; tail full under a relaxed root: push it down the rightmost spine\n   346\t       (let* ((tail-node (pvec-tail p))\n   347\t              (pushed (rrb-push-leaf (pvec-root p) shift tail-node)))\n   348\t         (if pushed\n   349\t             ;; rrb-mk-node gives back a plain vector when the children's\n   350\t             ;; offsets line up, though its last child may still be relaxed\n   351\t             ;; (a slice one past a trie boundary): a plain root promises a\n   352\t             ;; classic trie, so the root stays relaxed\n   353\t             (mk-pvec (fx+ cnt 1) shift (rrb-force-r