{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/zsh -lc \"nl -ba stdlib/jolt/io_poller.clj | sed -n '48,76p'; nl -ba jolt-core/jolt/backend_scheme/ffi.clj | sed -n '14,36p;228,244p'; git status --porcelain=v1 --untracked-files=all\"","aggregated_output":"    48\t;; then switch.\n    49\t\n    50\t(ns jolt.io-poller\n    51\t  (:require [jolt.ffi :as ffi]\n    52\t            [jolt.socket.native :as native]\n    53\t            [clojure.string :as str]))\n    54\t\n    55\t(ffi/load-library)\n    56\t\n    57\t;; -- platform constants --------------------------------------------------------\n    58\t;; EAGAIN/EWOULDBLOCK share one value on both platforms; O_NONBLOCK, the socket\n    59\t;; error option and the connect-in-progress errno do not.\n    60\t(def ^:private os-name\n    61\t  (str/lower-case (or (System/getProperty \"os.name\") \"\")))\n    62\t(def ^:private macos?   (str/includes? os-name \"mac\"))\n    63\t;; Windows has neither kqueue nor epoll; its backend is WSAPoll, which is not a\n    64\t;; translation of the other two. WSAPoll is a stateless poll rather than a\n    65\t;; kernel-held registration set, so each round hands it the whole set — every\n    66\t;; (fd, filter) with a parked waiter — rebuilt from :fds, and there is no\n    67\t;; changelist and nothing to delete: an fd whose waiters were woken is simply\n    68\t;; not in the next round's set. Its wake channel is a loopback socket pair\n    69\t;; (native/loopback-pair), since WSAPoll accepts only sockets. See wsapoll-round.\n    70\t(def ^:private windows? (str/includes? os-name \"win\"))\n    71\t\n    72\t;; Which backend this process uses. JOLT_IO_POLLER=poll selects the WSAPoll one\n    73\t;; on POSIX too, where native/c-poll is poll(2) with the same contract: that is\n    74\t;; how the Windows backend runs under the POSIX gates (make fiberspoll),\n    75\t;; rather than only on a Windows runner.\n    76\t(def ^:private poll-backend?\n    14\t;; the compile-time signature and runtime memory halves of one public contract.\n    15\t;; This table is baked into each checked-in compiler seed.\n    16\t(def ^:private ffi-types\n    17\t  {\"int\" \"int\" \"uint\" \"unsigned-int\"\n    18\t   \"int8\" \"integer-8\" \"i8\" \"integer-8\"\n    19\t   \"int16\" \"integer-16\" \"short\" \"integer-16\"\n    20\t   \"uint16\" \"unsigned-16\" \"ushort\" \"unsigned-16\"\n    21\t   \"int32\" \"integer-32\" \"uint32\" \"unsigned-32\"\n    22\t   \"long\" \"long\" \"ulong\" \"unsigned-long\"\n    23\t   \"int64\" \"integer-64\" \"uint64\" \"unsigned-64\" \"size_t\" \"size_t\" \"ssize_t\" \"ssize_t\"\n    24\t   \"iptr\" \"iptr\" \"uptr\" \"uptr\" \"double\" \"double\" \"float\" \"float\"\n    25\t   \"pointer\" \"void*\" \"void*\" \"void*\" \"string\" \"string\" \"void\" \"void\"\n    26\t   \"uint8\" \"unsigned-8\" \"u8\" \"unsigned-8\" \"byte\" \"unsigned-8\" \"char\" \"char\"\n    27\t   ;; :bool is a ONE-BYTE C boolean (C99 _Bool / stdbool.h), so it travels as\n    28\t   ;; unsigned-8 and the value is converted at the boundary — Chez's own\n    29\t   ;; `boolean` foreign type is int-sized, which is the wrong width for _Bool\n    30\t   ;; and would read three bytes of whatever sat next to it on a return.\n    31\t   \"bool\" \"unsigned-8\"})\n    32\t(defn ffi-type->chez [t]\n    33\t  (or (ffi-types t) (throw (ex-info (str \"jolt.ffi: unknown foreign type :\" t) {}))))\n    34\t\n    35\t(defn- emit-ffi-layout-ftype [type]\n    36\t  (cond\n   228\t    (= \"string\" type) (str \"(jolt-ffi-string->c \" expr \")\")\n   229\t    (= \"bool\" type) (str \"(jolt-ffi-bool->c \" expr \")\")\n   230\t    (#{\"float\" \"double\"} type) (str \"(jolt-ffi-float->c \" expr \")\")\n   231\t    :else expr))\n   232\t\n   233\t;; A foreign-fn's :string ARGUMENT travels as u8*, an immobile copy built by\n   234\t;; jolt-ffi-string-arg (host/chez/java/ffi.ss), so a callback that collects can't\n   235\t;; move it while C holds the pointer. Results and callable positions are unchanged.\n   236\t(defn- ffi-arg-type->chez [type]\n   237\t  (if (= \"string\" type) \"u8*\" (ffi-type->chez type)))\n   238\t\n   239\t(defn- ffi-string-arg [expr]\n   240\t  (str \"(jolt-ffi-string-arg \" expr \")\"))\n   241\t\n   242\t;; Each :string argument is bound to its converted bytevector ahead of the call\n   243\t;; and kept live until C returns: the address C holds doesn't count as a\n   244\t;; reference. A :capture-native-error call answers two values, passed through.\n?? test/gambit/fixtures/yin-dht-probe.jolt\n?? test/gambit/yin-dht-probe.sh\n","exit_code":0,"status":"completed"}}
