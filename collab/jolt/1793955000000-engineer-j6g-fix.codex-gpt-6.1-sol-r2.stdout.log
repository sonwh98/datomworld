eport;\n23: ;;   6. unavailable library: a root with no parser library, and one with a\n24: ;;      wrong-layout library: Python answers unavailable-parser, Clojure and\n25: ;;      PHP evaluate in the same session; the library appearing later is\n26: ;;      picked up by the next selection.\n27: ;;\n28: ;; Needs bb bootstrap:jolt and bb build:jolt-native (the test build, for the\n29: ;; fault seam). Prints PASS/FAIL/RECORD; exits nonzero on any FAIL.\n30: (ns jolt-j5-run\n31:   (:require [babashka.fs :as fs]\n32:             [babashka.process :as p]\n33:             [clojure.edn :as edn]\n34:             [clojure.string :as str]))\n35: \n36: \n37: (def failures (atom 0))\n38: \n39: \n40: (defn- check\n41:   [label ok? detail]\n42:   (when-not ok? (swap! failures inc))\n43:   (println (if ok? \"PASS\" \"FAIL\") label (pr-str detail))\n44:   (flush))\n45: \n46: \n47: (def root (str (fs/canonicalize \".\")))\n48: \n49: \n50: (def legs\n51:   (let [named (set *command-line-args*)]\n52:     (if (empty? named)\n53:       #{\"budget\" \"below\" \"crash\" \"inject\" \"abort\" \"unavailable\"}\n54:       named)))\n55: \n56: \n57: (def scratch (fs/path root \"build/j5-probe\"))\n58: (fs/delete-tree scratch)\n59: (fs/create-dirs scratch)\n60: \n61: \n62: (def plat\n63:   (let [os (str/lower-case (System/getProperty \"os.name\"))\n64:         arch (System/getProperty \"os.arch\")]\n65:     (str (if (str/includes? os \"mac\") \"darwin\" \"linux\") \"-\"\n66:          (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\"))))\n67: \n68: \n69: (def ext (if (str/starts-with? plat \"darwin\") \".dylib\" \".so\"))\n70: \n71: \n72: (defn- jolt\n73:   [dir & args]\n74:   (let [r (apply p/shell {:dir dir :out :string :err :string :continue true}\n75:                  \"sh\" \"-c\"\n76:                  \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt:jolt-test \\\"$@\\\"\"\n77:                  \"jolt\" args)]\n78:     {:exit (:exit r) :out (:out r) :err (:err r)}))\n79: \n80: \n81: (defn- lines\n82:   [out prefix]\n83:   (filter #(str/starts-with? % prefix) (str/split-lines (str out))))\n84: \n85: \n86: (defn- result\n87:   [out]\n88:   (some-> (first (lines out \"RESULT \")) (subs 7) edn/read-string))\n89: \n90: \n91: (defn- relay\n92:   [{:keys [out]}]\n93:   (doseq [l (str/split-lines (str out))\n94:           :when (re-find #\"^(RECORD|PASS|FAIL) \" l)]\n95:     (when (str/starts-with? l \"FAIL \") (swap! failures inc))\n96:     (println l)))\n97: \n98: \n99: ;; 1. the budget, in process\n100: (when (legs \"budget\")\n101:   (let [r (jolt root \"src/dev/jolt_j5_budget.clj\")]\n102:     (relay r)\n103:     (check \"budget gates: child exited 0\" (zero? (:exit r))\n104:            {:exit (:exit r), :err (when-not (zero? (:exit r)) (:err r))})))\n105: \n106: \n107: ;; 2. below: the JVM's packets\n108: (when (legs \"below\")\n109:   (let [jvm (p/shell {:dir root :out :string :err :string :continue true}\n110:                      ;; the JVM exporter recurses per tree level: the\n111:                      ;; 20,000-deep 1+ tree overflows its default stack\n112:                      ;; (StackOverflowError at yang.antlr.cst/ops), so the\n113:                      ;; oracle runs with a 1 GiB thread stack\n114:                      \"clojure\" \"-J-Xss1g\" \"-M\" \"src/dev/jolt_j5_below.cljc\")\n115:         jolt-below (jolt root \"src/dev/jolt_j5_below.cljc\")\n116:         read-below (fn [out]\n117:                      (into {} (map (fn [l]\n118:                                      (let [[_ shape packet] (re-matches #\"BELOW (\\S+) (.*)\" l)]\n119:                                        [shape (edn/read-string packet)])))\n120:                            (lines out \"BELOW \")))\n121:         j (read-below (:out jvm))\n122:         k (read-below (:out jolt-below))\n123:         times (fn [out]\n124:                 (into {} (map (fn [l]\n125:                                 (let [[_ s t] (re-matches #\"TIME (\\S+) (\\d+)\" l)]\n126:                                   [s (parse-long t)])))\n127:                       (lines out \"TIME \")))\n128:         jt (times (:out jolt-below))]\n129:     (println \"RECORD below-walls\" (pr-str {:jvm (times (:out jvm)), :jolt jt}))\n130:     (check \"below: each carrier shape at depth 32, the 20,000-operator 1+ chain, R1c at 10,000, 100,000 `**` and the flat 1,024-not chain parse on jolt to the JVM's packet (strict equality)\"src/dev/jolt_shell_session.clj\n1: (ns jolt-shell-session\n2:   \"Foreground process transcripts, one corpus and two host lanes. A held\n3:    stdin pipe proves typed quit without EOF. Every wait has a deadline;\n4:    mismatches fail, including unlisted reader differences. Raw output and\n5:    timings remain under build/j3-logs/shell. Not a deployed sidecar.\"\n6:   (:require [babashka.fs :as fs]\n7:             [babashka.process :as p]\n8:             [clojure.edn :as edn]\n9:             [clojure.string :as str]))\n10: \n11: \n12: (def prompt \"yin> \")\n13: (def timeout-ms 180000)\n14: \n15: \n16: (defn now\n17:   []\n18:   (System/currentTimeMillis))\n19: \n20: \n21: (defn fail!\n22:   [message data]\n23:   (throw (ex-info message data)))\n24: \n25: \n26: (defn await!\n27:   [pred process deadline description]\n28:   (loop []\n29:     (cond\n30:       (pred) true\n31:       (not (.isAlive process)) (fail! (str \"process ended waiting for \" description) {})\n32:       (> (now) deadline) (fail! (str \"deadline waiting for \" description) {})\n33:       :else (do (Thread/sleep 5) (recur)))))\n34: \n35: \n36: (defn expected\n37:   [host value]\n38:   (if (and (map? value) (contains? value host)) (get value host) value))\n39: \n40: \n41: (defn matches?\n42:   [host wanted actual]\n43:   (let [wanted (expected host wanted)]\n44:     (if (and (map? wanted) (:re wanted))\n45:       (boolean (re-matches (re-pattern (:re wanted)) actual))\n46:       (= wanted actual))))\n47: \n48: \n49: (defn normalized\n50:   [text]\n51:   (-> text (str/replace #\"\\r\\n\" \"\\n\")\n52:       (str/replace #\"Host: (JVM|jolt) [^\\n]*\" \"<host>\") str/trim))\n53: \n54: \n55: (defn command\n56:   [host args]\n57:   (case host\n58:     :jolt (into [\"sh\" \"-c\"\n59:                  \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt:jolt-yin-repl --no-state \\\"$@\\\"\"\n60:                  \"jolt\"] args)\n61:     :jvm (into [\"clj\" \"-M:clj-yin-repl\" \"--no-state\"] args)))\n62: \n63: \n64: (defn run-session!\n65:   [host {:keys [id args in out quit exit startup-only idle-ms] :as case}]\n66:   (let [t0 (now)\n67:         process (.start (ProcessBuilder. ^java.util.List (command host args)))\n68:         stdout (atom \"\") stderr (atom \"\")\n69:         capture (fn [stream sink]\n70:                   (future\n71:                     (with-open [r (java.io.InputStreamReader. stream \"UTF-8\")]\n72:                       (loop []\n73:                         (let [c (.read r)]\n74:                           (when (not= -1 c)\n75:                             (swap! sink str (char c)) (recur)))))))\n76:         out-reader (capture (.getInputStream process) stdout)\n77:         err-reader (capture (.getErrorStream process) stderr)\n78:         writer (java.io.OutputStreamWriter. (.getOutputStream process) \"UTF-8\")\n79:         send! (fn [line] (.write writer (str line \"\\n\")) (.flush writer))\n80:         path (str \"build/j3-logs/shell/\" (name host) \"-\" (name id))\n81:         first-prompt (atom nil) latencies (atom [])]\n82:     (try\n83:       (when-not startup-only\n84:         (await! #(str/includes? @stdout prompt) process (+ t0 timeout-ms) \"first prompt\")\n85:         (reset! first-prompt (- (now) t0))\n86:         (println \"PROMPT\" (name host) id @first-prompt \"ms\")\n87:         (flush)\n88:         (when (= host :jolt)\n89:           (when-not (and (str/includes? @stdout \"Host: jolt \")\n90:                          (str/includes? @stdout \" / Chez \")\n91:                          (str/includes? @stdout \"python: the native C++ ANTLR4 parser\"))\n92:             (fail! \"missing jolt banner\" {:stdout @stdout})))\n93:         (when idle-ms (Thread/sleep idle-ms))\n94:         (doseq [[i line] (map-indexed vector in)]\n95:           (let [offset (count @stdout) sent (now)]\n96:             (send! line)\n97:             (await! #(str/includes? (subs @stdout offset) prompt)\n98:                     process (+ (now) timeout-ms) (str \"response \" i))\n99:             (swap! latencies conj (- (now) sent))\n100:             (let [actual (normalized (str/replace (subs @stdout offset) prompt \"\"))\n101:                   wanted (nth out i)]\n102:               (when-not (matches? host wanted actual)\n103:                 (fail! \"transcript mismatch\" {:id id :line line :expected (expected host wanted)\n104:                                               :actual actual})))\n105:             (when (and idle-ms (zero? i))\n106:               (let [before @stdout]\n107:                 (Thread/sleep idle-ms)\n108:                 (when-not (= before @stdout)\n109:                   (fail! \"duplicate output while pending/idle\" {:id id :before before :after @stdout}))))))\n110:         (if (= quit :eof) (.close writer) (send! \"(quit)\")))\n111:       (when-not (.waitFor process timeout-ms java.util.concurrent.TimeUnit/MILLISECONDS)\n112:         (fail! \"deadline waiting for exit (stdin stays open for typed quit)\" {:id id}))\n113:       @out-reader @err-reader\n114:       (when-not (= exit (.exitValue process))\n115:         (fail! \"exit mismatch\" {:id id :expected exit :actual (.exitValue process)\n116:                                 :stderr @stderr :stdout @stdout}))\n117:       (if startup-only\n118:         (when-not (matches? host out (normalized @stdout))\n119:           (fail! \"startup transcript mismatch\" {:id id :expected out :actual (normalized @stdout)}))\n120:         (when-not (str/ends-with? (str/trim @stdout) \"Bye\")\n121:           (fail! \"missing clean quit\" {:id id :stdout @stdout})))\n122:       {:host host :id id :status :pass :first-prompt-ms @first-prompt\n123:        :started-at (str (java.time.Instant/ofEpochMilli t0))\n124:        :elapsed-ms (- (now) t0) :submission-ms @latencies :exit (.exitValue process)\n125:        :jolt-divergence (:jolt-divergence case) :capability (:capability case)}\n126:       (finally\n127:         (when (.isAlive process) (.destroyForcibly process))\n128:         (spit (str path \".out\") @stdout)\n129:         (spit (str path \".err\") @stderr)))))\n130: src/dev/jolt_j2_lane.clj\n1: ;; The J2 lane driver (bb probe:jolt-j2 / bb test:jolt-core / bb\n2: ;; test:jolt-core:diag / bb test:jolt-j2-jvm), run by babashka from the\n3: ;; repository root. It never loads namespaces itself: every step is a child\n4: ;; jolt process, so one aborting namespace cannot hide the others, and every\n5: ;; step's full output is kept under build/j2-logs/.\n6: ;;\n7: ;;   bb src/dev/jolt_j2_lane.clj probe   [--jobs N] [--only re] [--timeout-ms M]\n8: ;;   bb src/dev/jolt_j2_lane.clj core    [--jobs N] [--only re] [--diag] ...\n9: ;;   bb src/dev/jolt_j2_lane.clj jvm     [--only re] [--timeout-ms M]  JVM counts\n10: ;;   bb src/dev/jolt_j2_lane.clj list                      the decisions, no run\n11: ;;   bb src/dev/jolt_j2_lane.clj report                    core vs jvm diff table\n12: ;;\n13: ;; probe: each source namespace of the J2 load order (below) through\n14: ;;   src/dev/jolt_j2_probe.clj in its own process; a step fails on any\n15: ;;   failure class or on a present dao.stream.transit; summary in\n16: ;;   build/j2-logs/probe-summary.edn, step logs build/j2-logs/probe/.\n17: ;;\n18: ;; core: each INCLUDED test namespace through src/dev/jolt_test_runner.clj\n19: ;;   (J1; per-namespace counts, every ^:slow var included — owner ruling Q3,\n20: ;;   no fast-tier shortcut) in its own process, in the dependency order below.\n21: ;;   Summary in build/j2-logs/core-summary.edn, logs build/j2-logs/core/.\n22: ;;   The EXCLUDED table is printed in every core run and written into the\n23: ;;   summary: reason, capability and owner per excluded suite (no silent\n24: ;;   skips). --diag adds the :jolt-diag alias (the J1 corpus-loader stand-in).\n25: ;;\n26: ;; jvm: the same namespaces on the JVM in one process, clojure.test run-tests\n27: ;;   per namespace (src/dev/jolt_j2_jvm_runner.clj, same NS/SUMMARY line\n28: ;;   protocol), for the per-namespace count diff the J2 report needs;\n29: ;;   build/j2-logs/jvm-summary.edn.\n30: ;;\n31: ;; Every child runs under this driver's watchdog (run-watched): past\n32: ;; --timeout-ms its whole process tree is killed and the step is recorded\n33: ;; with :status :timeout, which fails the lane.\n34: (ns jolt-j2-lane\n35:   (:require [babashka.fs :as fs]\n36:             [babashka.process :as p]\n37:             [clojure.edn :as edn]\n38:             [clojure.string :as str]))\n39: \n40: \n41: ;; Resolve relative to this script so the manifest self-test can run the\n42: ;; driver against its temporary working directory.\n43: (load-file (str (fs/path (fs/parent *file*) \"jolt_cbor_override_check.clj\")))\n44: \n45: \n46: ;; The J2 load order (architect 1792644000000 section 2): dao.host\n47: ;; primitives, dao.jing.cbor -> dao.jing, dao.host.hash/sign, linker.sign,\n48: ;; the dao.data/datom closure, the portable dao.stream tree, the jing\n49: ;; content/file/mem/dht tree, dao.space, then yin.vm in dependency order,\n50: ;; then the front-end namespaces some suites reach and the yin.repl reach\n51: ;; (informational; J3 scope). dao.stream.transit is never in the list: its\n52: ;; absence from every closure is the assertion.\n53: (def probe-order\n54:   [\"dao.host.integer\" \"dao.host.bytes\" \"dao.host.text\" \"dao.host.float\"\n55:    \"dao.host.number\" \"dao.host.hash\" \"dao.host.sign\"\n56:    \"dao.jing.cbor\" \"dao.jing\"\n57:    \"yin.vm.linker.sign\"\n58:    \"dao.datom\" \"dao.data.arrays\" \"dao.data.btree\" \"dao.data.btree.storage\"\n59:    \"dao.data\"\n60:    \"dao.stream\" \"dao.stream.codec\" \"dao.stream.cbor.boring\" \"dao.stream.cbor\"\n61:    \"dao.stream.base64\" \"dao.stream.chunks\" \"dao.stream.memory_log\"\n62:    \"dao.stream.middleware\" \"dao.stream.observe\" \"dao.stream.ringbuffer\"\n63:    \"dao.stream.apply\" \"dao.stream.forward\" \"dao.stream.observer\"\n64:    \"dao.stream.rpc\" \"dao.stream.waitset\" \"dao.stream.waitset.cadence\"\n65:    \"dao.stream.ws\" \"dao.stream.ws.rfc6455\" \"dao.stream.ws.upgrade\" \"dao.stream.datagram\" \"dao.stream.journal\"\n66:    \"dao.stream.remote\" \"dao.stream.remote_meet\" \"dao.stream.remote_pair\"\n67:    \"dao.stream.remote_channel\" \"dao.stream.remote_route\" \"dao.stream.ws_project\"\n68:    \"dao.stream.udp\" \"dao.stream.journal.file\"\n69:    \"dao.stream.datagram.jvm\"\n70:    \"dao.jing.content\" \"dao.jing.content.step\" \"dao.jing.content.async\"\n71:    \"dao.jing.content.driver\" \"dao.jing.coordinate\" \"dao.jing.file\"\n72:    \"dao.jing.mem\" \"dao.jing.stream\"\n73:    \"dao.jing.dht.kad\" \"dao.jing.dht\" \"dao.jing.dht.facade\"\n74:    \"dao.space.store.fs\" \"dao.space.index\" \"dao.space.transactor\"\n75:    \"dao.space.query\" \"dao.space.schema\" \"dao.space.transact\" \"dao.space.dht\"\n76:    \"yin.vm.effect\" \"yin.vm.values\" \"yin.vm\"\n77:    \"yin.vm.debruijn\" \"yin.vm.debruijn_code\" \"yin.vm.debruijn_register_code\"\n78:    \"yin.vm.debruijn_register_effects\" \"yin.vm.encoder\" \"yin.vm.ffi\"\n79:    \"yin.vm.module\" \"yin.vm.pipeline\" \"yin.vm.semantic.code\"\n80:    \"yin.vm.semantic.linearize\" \"yin.vm.data\" \"yin.vm.integer\" \"yin.vm.ledger\"\n81:    \"yin.vm.semantic.analysis\" \"yin.vm.semantic.scan\" \"yin.vm.ucf.custody\"\n82:    \"yin.vm.ucf\" \"yin.vm.ucf.remote\" \"yin.vm.ffi.remote_serve.caller\"\n83:    \"yin.vm.semantic.derive\" \"yin.vm.semantic.frame\" \"yin.vm.linker\"\n84:    \"yin.vm.engine\" \"yin.vm.ast_walker\" \"yin.vm.debruijn.register\"\n85:    \"yin.vm.debruijn.stack\" \"yin.vm.linker.publish\" \"yin.vm.macro\"\n86:    \"yin.vm.semantic\" \"yin.vm.ucf.rows\" \"yin.vm.linker.closure\"\n87:    \"yin.vm.linker.authority\" \"yin.vm.linker.admission\" \"yin.vm.linker.dht\"\n88:    \"yin.vm.semantic.layout\" \"yin.vm.ucf.rows.checkpoint\" \"yin.vm.linker.head\"\n89:    \"yin.vm.linker.interpreter\" \"yin.vm.ucf.authority.input\"\n90:    \"yin.vm.ucf.holder.inbox\" \"yin.vm.ucf.authority.admission\"\n91:    \"yin.vm.ucf.authority.grant\" \"yin.vm.ucf.holder.export\"\n92:    \"yin.vm.ucf.authority.completion\" \"yin.vm.ucf.ledger\" \"yin.vm.ucf.authority\"\n93:    \"yin.vm.ucf.authority.front\" \"yin.vm.ucf.authority.seam\"\n94:    \"yin.vm.ucf.holder.evidence\" \"yin.vm.ucf.holder.reader\"\n95:    \"yin.vm.ucf.holder.writer\" \"yin.vm.ucf.holder.driver\" \"yin.vm.ucf.compose\"\n96:    \"yin.vm.telemetry\" \"yin.vm.linker.requirements\" \"yin.vm.linker.head.board\"\n97:    \"yin.vm.ffi.remote_serve.holder\" \"yin.vm.ffi.remote_serve.responder\"\n98:    \"yin.vm.ffi.remote_serve\"\n99:    \"yang.clojure\" \"yang.safepoint\" \"yang.python.antlr.uast\"\n100:    \"yang.python.antlr.prelude\" \"yang.python.antlr.lower\"\n101:    \"yang.python.antlr.render\" \"yang.python.antlr.safepoint\" \"dao.await\"\n102:    \"yin.repl\" \"yin.repl.frontends\" \"yin.repl.host\" \"yin.repl.store\"\n103:    \"yin.repl.index\" \"yin.repl.dht\" \"yin.repl.main\" \"dao.space.store\"])\n104: \n105: \n106: ;; The Jing CBOR corpus guard flags any scanned file whose text names the\n107: ;; corpus resource (its name, the fixtures loader and the fixtures suite\n108: ;; all share one stem) AND carries a write marker such as spit; even a\n109: ;; COMMENT naming it counts. This driver writes its own logs, so nothing\n110: ;; here may spell that stem out: the one suite entry below is built in\n111: ;; pieces, the way the guard's own test file dodges matching itself.\n112: (def ^:private corpus-suite-name\n113:   (str \"dao.jing.\" \"cbor\" \"-fix\" \"tures-test\"))\n114: \n115: \n116: ;; The J2 applicability manifest: every test namespace under test/dao/host,\n117: ;; test/dao/jing, test/dao/data, test/dao/space, test/dao/stream (the bare\n118: ;; dao.{jing,stream,data}_test included), test/yin/vm, is either in\n119: ;; `included` (run, fast and ^:slow alike) or below in `excluded` with a\n120: ;; reason, the missing capability and its owner. Zero unexplained skips.\n121: (def excluded\n122:   [{:ns \"dao.stream.http-test\"\n123:     :reason \"loads dao.stream.http.jvm, the JVM http-kit adapter (b55fdfe1, dao.star Mode 1); jolt has no http-kit, so the namespace cannot load (J4d probe: load failure on org.httpkit.server)\"\n124:     :capability \"JVM HTTP server (http-kit)\" :owner \"dao.star\"}\n125:    {:ns \"yin.repl.shell-session-test\" :reason \"JVM process corpus runs on JVM lane; bb test:jolt-shell runs both hosts\" :capability \"JVM subprocess harness\" :owner \"J3\"}\n126:    {:ns \"yin.repl.dht-test\" :reason \"UDP + durable store fixture\" :capability \"UDP + durable store\" :owner \"J7\"}\n127:    {:ns \"yin.repl.dht-head-test\" :reason \"WebSocket + durable store fixture\" :capability \"WebSocket + durable store\" :owner \"J6/J7\"}\n128:    {:ns \"yin.repl.dht-process-test\" :reason \"JVM process + UDP fixture\" :capability \"JVM process + UDP\" :owner \"J7\"}\n129:    {:ns \"yin.repl.serve-connect-wire-test\" :reason \"JVM WebSocket peers fixture\" :capability \"JVM WebSocket peers\" :owner \"J6\"}\n130:    {:ns \"yin.repl.build-test\" :reason \"JVM build tool fixture\" :capability \"JVM build tool\" :owner \"J8\"}[]"}],"_meta":{"codex/nodeReplExecutionDurationMs":15},"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The reads do not establish adapter starvation. The production owner polls the adapter after stepping, and the pump visits ready descriptors in rotation, with at most one read chunk per visit. The observed log also places the hang after `write-all!` finished, so its retry loop cannot explain this run.\n\nI’ll fix the confirmed harness defects and add a separate watchdog to the workload task. That watchdog can flush telemetry and enforce the five-minute cap even if the owner thread stops returning. The adapter will remain unchanged."}}
