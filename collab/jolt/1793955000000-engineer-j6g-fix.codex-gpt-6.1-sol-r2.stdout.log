se-frame\n501: (defn- start-close\n511: (defn close!\n515:    control slot behind everything already queued.\"\n527: (defn- segment-done!\n540: (defn- fail-connection!\n547:    queued, the connection fails once it is written; already sent, it fails\n571: (defn- peer-close!\n573:    answer it unless this side's close is already queued or sent.\"\n589: (defn- pong!\n595: (defn- handle-event!\n611: (defn- parse-input!\n613:    the connection ends, or the pong budget fills; keep the unparsed rest.\"\n617:     (loop [off offset]\n630: (defn- resume!\n631:   \"Parse a held remainder once the pong budget has room; answers whether\n644: (defn- read-once!\n668: (def ^:private write-ready (bit-or native/pollout native/pollerr native/pollhup native/pollnval))\n671: (defn- visit-connection!\n673:   (let [wrote? (when (and (pos? (bit-and rev write-ready)) (seq (:pending (cell h))))\n684: (defn- visit-connecting!\n695: (defn- can-accept?\n704: (defn- visit-listener!\n706:   (loop [i 0, moved? false]\n722: (defn interest\n736: (defn- runnable-remainder?\n742: (defn next-deadline\n762: (defn- deliver-notify!\n770: (defn- expire!\n801: (defn- report-drained!\n809: (defn- rotation\n810:   \"The handles named in `ready`, in registration order starting after the\n812:   [p ready]\n814:         revents (reduce (fn [m [fd rev]] (update m fd (fnil bit-or 0) rev)) {} ready)\n824: (defn pump!\n825:   \"One bounded turn over `ready` (`[[fd revents] ...]` from the driver's\n826:    poll; `[]` after a timeout): owed reports, one visit per ready\n829:   [p ready]\n833:             turn (vec (rotation p ready))\n863: (defn close-listener!\n874: (defn drained?\n881: (defn lower-deadlines!\n891: (defn host-pump\n900: (defn debug-stateadapter\n140: \n141: \n142: (defn- forget!\n143:   [inst c]\n144:   (swap! (st inst) update :conns disj c)\n145:   nil)\n146: \n147: \n148: (defn host-pump\n149:   \"The instance as the driver's `:pump` value (A2): the pump's interest and\n150:    deadline (now while this edge owes a report), and `pump!`.\"\n151:   [inst]\n152:   (let [p (::pump inst)]\n153:     {:interest #(pump/interest p)\n154:      :deadline #(if (seq (:owed @(st inst))) (poller/clock-ms) (pump/next-deadline p))\n155:      :pump! (fn [ready]\n156:               (let [before? (deliver-owed! inst)\n157:                     r (pump/pump! p ready)\n158:                     after? (deliver-owed! inst)]\n159:                 {:progressed? (boolean (or before? (:progressed? r) after?))}))}))\n160: \n161: \n162: ;; =============================================================================\n163: ;; Frames\n164: ;; =============================================================================\n165: \n166: (defn- protocol\n167:   \"The pump's protocol map for `role` (:server or :client), whose parser\n168:    bounds a message at `max` bytes (nil is unbounded). Client frames are\n169:    masked with a fresh key each.\"\n170:   [role max]\n171:   (cond-> {:parser (rfc6455/parser {:role role, :max-message-bytes max})\n172:            :parse-frame rfc6455/parse-frame\n173:            :encode-frame rfc6455/encode-frame\n174:            :close-payload rfc6455/close-payload}\n175:     (= :client role) (assoc :mask-key crypto/mask-key)))\n176: \n177: \n178: (defn- data-frame\n179:   \"The wire bytes of one message: a string as a text frame, host bytes as a\n180:    binary frame; masked for the client role.\"\n181:   [role payload]\n182:   (rfc6455/encode-frame\n183:     (cond-> (if (string? payload)\n184:               {:opcode :text, :payload (text/utf8-encode payload)}\n185:               {:opcode :binary, :payload payload})\n186:       (= :client role) (assoc :mask-key (crypto/mask-key)))))\n187: \n188: \n189: (defn- deliver-message!\n190:   [cb ev]\n191:   (when cb\n192:     (let [payload (:payload ev)]\n193:       (if (= :text (:opcode ev))\n194:         ((:message! cb) (text/utf8-decode payload 0 (alength payload)))\n195:         ((:binary! cb) payload)))))\n196: \n197: \n198: (defn- report-closed!harness-tail\n909:       (wsj/close-host! ci)\n910:       (wsj/close-host! si))\n911: \n912:     ;; -------------------------------------------------------------------------\n913:     ;; Fact 4: Stopping endpoint ends served stream (terminal :ended, not :detached)\n914:     ;; -------------------------------------------------------------------------\n915:     (let [si (wsj/create)\n916:           ci (wsj/create)\n917:           port (atom 0)\n918:           server-st (atom (serve/serve! {:bind-host \"127.0.0.1\"\n919:                                          :bind-port 0\n920:                                          :host {:bind! (fn [opts]\n921:                                                          (wsj/bind! si (assoc opts :ws.jolt/adapter-of\n922:                                                                               #(some-> (:ws/handle %) ws/adapter))))\n923:                                                 :unbind! (fn [lh dep] (wsj/unbind! si lh dep))\n924:                                                 :connect! (fn [d a] (wsj/connect! si d a))}}))\n925:           _ (loop []\n926:               (let [stepped (serve/step @server-st (poller/clock-ms))\n927:                     [_ next-st] (serve/take-outbox stepped)]\n928:                 (reset! server-st next-st)\n929:                 (when-let [p (get-in next-st [:spec :port])]\n930:                   (when (pos? p) (reset! port p)))\n931:                 (when (zero? @port)\n932:                   (wake/sleep-fds! w 5 (wsj/host-pump si) nil)\n933:                   (recur))))\n934:           url (str \"daostream:ws://127.0.0.1:\" @port \"/repl\")\n935:           now (poller/clock-ms)\n936:           client-host {:connect! (fn [d a] (wsj/connect! ci d a))}\n937:           p-open (connect/open {:url url :host client-host :now now})\n938:           peer {:connection (atom (connect/connection-key p-open))\n939:                 :client (atom (connect/client-key p-open))}]\n940: \n941:       ;; Open connection and eval (+ 3 4)\n942:       (let [c (rpc/request! @(:client peer) 7 :op/eval \"(+ 3 4)\")]\n943:         (reset! (:client peer) c)\n944:         (drive-repl-peers! w [si ci] [peer]\n945:                            (fn []\n946:                              (let [stepped (serve/step @server-st (poller/clock-ms))\n947:                                    [_ next-st] (serve/take-outbox stepped)]\n948:                                (reset! server-st next-st)\n949:                                (some? (rpc/response @(:client peer) 7))))\n950:                            5000)\n951:         (check! \"Fact 4: (+ 3 4) evaluates to 7\"\n952:                 (= \"7\" (rpc/answer-ok (rpc/response @(:client peer) 7)))\n953:                 {:ans (rpc/response @(:client peer) 7)}))\n954: \n955:       ;; Stop endpoint\n956:       (swap! server-st serve/stop!)\n957:       (drive-repl-peers! w [si ci] [peer]\n958:                          (fn []\n959:                            (let [stepped (serve/step @server-st (poller/clock-ms))\n960:                                  [_ next-st] (serve/take-outbox stepped)]\n961:                              (reset! server-st next-st)\n962:                              (and (serve/stopped? next-st)\n963:                                   (some? (:terminal @(:client peer))))))\n964:                          5000)\n965: \n966:       (let [[conn' ev] (connect/observe-terminal @(:connection peer) (:terminal @(:client peer)))]\n967:         (check! \"Fact 4: client observes :ended, not bare detached\"\n968:                 (and (= :ended (:status conn'))\n969:                      (= :dao.stream.rpc/ended (:terminal @(:client peer))))\n970:                 {:conn conn' :ev ev :terminal (:terminal @(:client peer))}))\n971: \n972:       (wsj/close-host! ci)\n973:       (wsj/close-host! si))\n974: \n975:     (wake/close! w)\n976:     (println)\n977:     (println \"Served-stream rejoin:\" @passed \"passed,\" @failed \"failed\")\n978:     (if (zero? @failed)\n979:       (do (println \"PASS served-stream\") true)\n980:       (do (println \"FAIL served-stream\") false))))\n981: \n982: \n983: ;; =============================================================================\n984: ;; CLI Dispatcher\n985: ;; =============================================================================\n986: \n987: (defn -main\n988:   [& args]\n989:   (let [cmd (or (first args) \"workload-w\")\n990:         ok? (case cmd\n991:               \"workload-w\" (:pass? (run-workload-w))\n992:               \"quick-w\" (:pass? (run-workload-w :target-duration-ms 2000 :target-samples 20))\n993:               \"cross-host\" (run-cross-host-rows)\n994:               \"served-stream\" (run-served-stream-rejoin)\n995:               \"all\" (and (run-cross-host-rows)\n996:                          (run-served-stream-rejoin)\n997:                          (:pass? (run-workload-w)))\n998:               (do (println \"Unknown command:\" cmd\n999:                            \"- valid commands: workload-w, quick-w, cross-host, served-stream, all\")\n1000:                   false))]\n1001:     (System/exit (if ok? 0 1))))\n1002: \n1003: (apply -main *command-line-args*)\n1004: driver\n424: (defn- handle-line\n425:   [state line]\n426:   (let [command (adapter/local-command line)]\n427:     (cond\n428:       ;; A shell that has quit evaluates nothing more.  Hosts append an\n429:       ;; end-of-input `(quit)` that a typed `(quit)` has already answered.\n430:       (not (:running? state)) state\n431: \n432:       (not (string? line))\n433:       (publish state :yin.repl.driver/diagnostic\n434:                (str \";; ignored non-string input: \"\n435:                     (pr-str (data/summarize line diagnostic-bounds))))\n436: \n437:       (str/blank? line) state\n438: \n439:       ;; Local control commands bypass the remote queue, so a stuck or slow\n440:       ;; remote request cannot trap the operator.\n441:       (= 'connect command) (connect-command state line)\n442: \n443:       (= 'disconnect command) (disconnect state)\n444: \n445:       (= 'repl-state command)\n446:       (cond-> (evaluate-locally state line)\n447:         (:connection state)\n448:         (publish :yin.repl.driver/result\n449:                  (repl/format-value (connect/summary (:connection state)))))\n450: \n451:       (and (remote-routed? state) (not command))\n452:       (cond\n453:         ;; A dropped or ended remote evaluates nothing.  The line was never\n454:         ;; sent, so it waits for an explicit reattachment decision.\n455:         (remote-terminal state)\n456:         (-> state\n457:             (update :queued conj line)\n458:             (publish :yin.repl.driver/notice\n459:                      \";; not connected: queued until (connect …) reattaches\"))\n460: \n461:         ;; `:unsent` is the RPC client's own retained envelope, and the\n462:         ;; authority on whether the request path is free: submitting here would\n463:         ;; resend it and discard this line.  `:retrying` is only the driver's\n464:         ;; record of which line that envelope carries.\n465:         (or (:outstanding state) (:retrying state) (remote-unsent? state))\n466:         (queue-line state line)\n467: \n468:         :else (submit-remote state line queue-line))\n469: \n470:       :else (evaluate-locally state line))))\n471: \n472: \n473: ;; =============================================================================\n474: ;; Remote completions\n475: ;; =============================================================================\n476: \n477: (defn- completion-text\n478:   [event]\n479:   (case (:yin.repl.adapter/event event)\n480:     :yin.repl.adapter/response\n481:     (if (contains? event :yin.repl.adapter/error)\n482:       (str \"Error: \" (repl/format-value (:yin.repl.adapter/error event)))\n483:       (let [value (:yin.repl.adapter/value event)]\n484:         (if (string? value) value (repl/format-value value))))\n485: \n486:     :yin.repl.adapter/lost\n487:     (str \";; remote request \" (:yin.repl.adapter/id event) \" lost: \"\n488:          (pr-str (data/summarize (:yin.repl.adapter/reason event) diagnostic-bounds)))\n489: \n490:     (str \";; \" (pr-str (data/summarize event diagnostic-bounds)))))\n491: \n492: \n493: (defn- completion-event-kind\n494:   [event]\n495:   (if (= :yin.repl.adapter/response (:yin.repl.adapter/event event))\n496:     :yin.repl.driver/response\n497:     :yin.repl.driver/notice))\n498: \n499: \n500: (defn- clears-outstanding?\n501:   [state event]\n502:   (and (:outstanding state)\n503:        (contains? #{:yin.repl.adapter/response :yin.repl.adapter/lost}\n504:                   (:yin.repl.adapter/event event))\n505:        (= (:outstanding state) (:yin.repl.adapter/id event))))\n506: \n507: \n508: (defn- publish-adapter-events\n509:   \"Move the adapter's event outbox into the driver's, exactly once.\"\n510:   [state]\n511:   (let [[events adapter] (adapter/take-events (:adapter state))]\n512:     (reduce (fn [state event]\n513:               (-> state\n514:                   (cond-> (clears-outstanding? state event)\n515:                     (assoc :outstanding nil))\n516:                   (publish (completion-event-kind event) (completion-text event))))\n517:             (assoc state :adapter adapter)\n518:             events)))\n519: \n520: \n521: (defn- poll-remote\n522:   [state now]\n523:   (let [state (cond-> state"}],"_meta":{"codex/nodeReplExecutionDurationMs":5},"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"show('pump',pumpText,1,32); show('pump',pumpText,608,740); show('pump',pumpText,805,862); nodeRepl.write(entries.filter(p=>/jolt|watchdog/.test(p)&& /doc|bb\\.edn|test/.test(p)&& !/\\.git\\/|node_modules\\//.test(p)).slice(0,180)); var bbText=await fs.readFile(root+'/bb.edn','utf8'); nodeRepl.write(bbText.split('\\n').flatMap((l,i)=>/jolt|cljstyle/.test(l)?[`${i+1}: ${l}`]:[]).join('\\n'));","title":"Read bounded pump turns and locate runtime guard patterns"},"result":null,"error":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"show('pump',pumpText,1,32); show('pump',pumpText,608,740); show('pump',pumpText,805,862); nodeRepl.write(entries.filter(p=>/jolt|watchdog/.test(p)&& /doc|bb\\.edn|test/.test(p)&& !/\\.git\\/|node_modules\\//.test(p)).slice(0,180)); var bbText=await fs.readFile(root+'/bb.edn','utf8'); nodeRepl.write(bbText.split('\\n').flatMap((l,i)=>/jolt|cljstyle/.test(l)?[`${i+1}: ${l}`]:[]).join('\\n'));","title":"Read bounded pump turns and locate runtime guard patterns"},"result":{"content":[{"type":"text","text":"pump\n1: (ns dao.stream.ws.pump\n2:   \"Jolt-only owner-thread pump under the native WebSocket host adapter (J6d;\n3:    J6 plan rulings A1-A5). One instance per `create` call: its registry of\n4:    descriptors, write queues, close records and deadlines live in that\n5:    instance and nowhere else, so two instances never share state.\n6: \n7:    Ownership (A1). Every entry runs on the thread that drives the instance;\n8:    nothing here waits, parks or polls a socket. A driver polls the `interest`\n9:    descriptors until the earlier of its cadence and `next-deadline`\n10:    (`jolt.io-poller/clock-ms`, nil when nothing is due), then hands the\n11:    `[[fd revents] ...]` it observed to `pump!`, `[]` on a timeout: every\n12:    call runs the due expiries. A composition that never pumps an instance\n13:    makes no progress, by design.\n14: \n15:    Bounded turn (A1). One `pump!` visits each ready descriptor at most once,\n16:    starting after the one visited last in the previous turn (round robin in\n17:    registration order). A connection visit attempts at most one write of\n18:    the head of its queue and reads at most one chunk (one reused 64 KiB\n19:    native buffer); a listener visit accepts at most `accept-batch`.\n20: \n21:    One ordered write path (A3). Each connection owns one FIFO of whole wire\n22:    segments; the head carries an offset and is never rewritten. `send!`\n23:    writes at once only into an empty FIFO and queues the unsent tail;\n24:    otherwise it appends. Protocol output (pongs, close frames) joins the\n25:    same FIFO at generation time; nothing has priority. `send!` answers nil\n26:    or `{:dao.stream/outcome :dao.stream/closed}`, never false.\n27:    `queued-bytes` counts every byte handed over and not yet accepted by the\n28:    kernel, control frames included; 0 after the terminal.\n29: \n30:    Two connection modes. A :raw connection (an HTTP upgrade in progress, or\n31:    a plain byte stream) delivers `:on-data` chunks, `:on-eof` once and\n32:    `:on-error` once. `upgraded!` turns it into a :ws connection, which parsespump\n608:       nil)))\n609: \n610: \n611: (defn- parse-input!\n612:   \"Parse `chunk` from `offset` one frame at a time until it is consumed,\n613:    the connection ends, or the pong budget fills; keep the unparsed rest.\"\n614:   [p h chunk offset]\n615:   (let [parse (:parse-frame (:protocol (cell h)))\n616:         n (alength chunk)]\n617:     (loop [off offset]\n618:       (cond\n619:         (not (open? h)) nil\n620:         (>= off n) (cell! h assoc :remainder nil)\n621:         (>= (:pongs (cell h)) max-pongs) (cell! h assoc :remainder {:chunk chunk, :offset off})\n622:         :else (let [[ev parser' off'] (parse (:parser (cell h)) chunk off)]\n623:                 (cell! h assoc :parser parser')\n624:                 (if (nil? ev)\n625:                   (cell! h assoc :remainder nil)\n626:                   (do (handle-event! p h ev)\n627:                       (recur off'))))))))\n628: \n629: \n630: (defn- resume!\n631:   \"Parse a held remainder once the pong budget has room; answers whether\n632:    anything was parsed.\"\n633:   [p h]\n634:   (when (and (open? h) (< (:pongs (cell h)) max-pongs))\n635:     (when-let [{:keys [chunk offset]} (:remainder (cell h))]\n636:       (parse-input! p h chunk offset)\n637:       true)))\n638: \n639: \n640: ;; =============================================================================\n641: ;; Reads and visits (A1)\n642: ;; =============================================================================\n643: \n644: (defn- read-once!\n645:   \"One recv chunk into the reused buffer; answers whether anything\n646:    happened.\"\n647:   [p h]\n648:   (let [rbuf (:rbuf @(st p))\n649:         r (tcp/recv-chunk! (:fd h) rbuf chunk-bytes)\n650:         ws? (= :ws (:mode (cell h)))]\n651:     (cond\n652:       (= :would-block r) false\n653:       (= :eof r) (do (if ws?\n654:                        (terminate! p h :eof nil)\n655:                        (do (cell! h assoc :reading? false :eof? true)\n656:                            (when-let [f (:on-eof (cell h))] (owe! p f))))\n657:                      true)\n658:       (:error r) (do (fail! p h r) true)\n659:       :else (let [chunk (ffi/read-array rbuf (:n r))]\n660:               (if ws?\n661:                 ;; a failed connection reads only to see EOF or reset: the\n662:                 ;; input is discarded, never parsed\n663:                 (when-not (:failed? (:close (cell h))) (parse-input! p h chunk 0))\n664:                 (when-let [f (:on-data (cell h))] (f chunk)))\n665:               true))))\n666: \n667: \n668: (def ^:private write-ready (bit-or native/pollout native/pollerr native/pollhup native/pollnval))\n669: \n670: \n671: (defn- visit-connection!\n672:   [p h rev]\n673:   (let [wrote? (when (and (pos? (bit-and rev write-ready)) (seq (:pending (cell h))))\n674:                  (drain-once! p h))\n675:         ;; resume before read: a held remainder is parsed first, and read\n676:         ;; interest returns only once it is consumed\n677:         resumed? (resume! p h)\n678:         read? (when (and (not resumed?) (open? h) (read-interest? h)\n679:                          (pos? (bit-and rev native/poll-readable)))\n680:                 (read-once! p h))]\n681:     (boolean (or wrote? resumed? read?))))\n682: \n683: \n684: (defn- visit-connecting!\n685:   [p h rev]\n686:   (when (pos? rev)\n687:     (let [r (tcp/connect-result (:fd h))]\n688:       (if (map? r)\n689:         (fail! p h r)\n690:         (do (cell! h assoc :kind :connection)\n691:             (when-let [f (:on-connected (cell h))] (owe! p f)))))\n692:     true))\n693: \n694: \n695: (defn- can-accept?\n696:   [p lh]\n697:   (let [{:keys [status accepting? max-pending-upgrades max-connections]} (cell lh)\n698:         mine (owned p lh)]\n699:     (and (= :open status) accepting?\n700:          (< (count (filter #(:upgrading? (cell %)) mine)) max-pending-upgrades)\n701:          (or (nil? max-connections) (< (count mine) max-connections)))))\n702: \n703: \n704: (defn- visit-listener!\n705:   [p h]\n706:   (loop [i 0, moved? false]\n707:     (if (or (= i accept-batch) (not (can-accept? p h)))\n708:       moved?\n709:       (let [r (tcp/accept! (:fd h))]\n710:         (cond\n711:           (= :would-block r) moved?\n712:           (:error r) (do (when-let [f (:on-accept-error (cell h))] (owe! p #(f r))) true)\n713:           ;; :on-accept runs inside the visit: the callee's registration is\n714:           ;; what the pending-upgrade cap counts. Without one, nobody owns\n715:           ;; the descriptor, so it is closed rather than leaked.\n716:           :else (do (if-let [f (:on-accept (cell h))]\n717:                       (f r)\n718:                       (tcp/close! (:fd r)))\n719:                     (recur (inc i) true)))))))\n720: \n721: \n722: (defn interest\n723:   \"`[[fd events] ...]` for this instance's next poll, registration order.\"\n724:   [p]\n725:   (vec (keep (fn [h]\n726:                (let [{:keys [kind pending]} (cell h)\n727:                      ev (case kind\n728:                           :listener (if (can-accept? p h) native/pollin 0)\n729:                           :connecting native/pollout\n730:                           :connection (bit-or (if (read-interest? h) native/pollin 0)\n731:                                               (if (seq pending) native/pollout 0)))]\n732:                  (when (pos? ev) [(:fd h) ev])))\n733:              (sort-by :id (vals (:handles @(st p)))))))\n734: \n735: \n736: (defn- runnable-remainder?\n737:   [h]\n738:   (let [{:keys [remainder pongs]} (cell h)]\n739:     (and remainder (< pongs max-pongs))))\n740: pump\n805:       (swap! (st p) update :closed-listeners dissoc id)\n806:       (when-let [f (:on-drained (cell lh))] (owe! p f)))))\n807: \n808: \n809: (defn- rotation\n810:   \"The handles named in `ready`, in registration order starting after the\n811:    id visited last.\"\n812:   [p ready]\n813:   (let [{:keys [handles last-id]} @(st p)\n814:         revents (reduce (fn [m [fd rev]] (update m fd (fnil bit-or 0) rev)) {} ready)\n815:         hs (sort-by (comp :id first)\n816:                     (keep (fn [[fd rev]]\n817:                             (when-let [h (get handles fd)]\n818:                               (when (pos? rev) [h rev])))\n819:                           revents))\n820:         after? #(> (:id (first %)) last-id)]\n821:     (concat (filter after? hs) (remove after? hs))))\n822: \n823: \n824: (defn pump!\n825:   \"One bounded turn over `ready` (`[[fd revents] ...]` from the driver's\n826:    poll; `[]` after a timeout): owed reports, one visit per ready\n827:    descriptor, held remainders that can resume, due expiries, owed reports.\n828:    Answers `{:progressed? boolean}`.\"\n829:   [p ready]\n830:   (let [s (st p)]\n831:     (try\n832:       (let [notified? (deliver-notify! p)\n833:             turn (vec (rotation p ready))\n834:             visited (doall\n835:                       (for [[h rev] turn\n836:                             ;; a descriptor released earlier in this turn,\n837:                             ;; or its number reused, is not visited\n838:                             :when (registered? p h)]\n839:                         (let [moved? (case (:kind (cell h))\n840:                                        :listener (visit-listener! p h)\n841:                                        :connecting (visit-connecting! p h rev)\n842:                                        :connection (visit-connection! p h rev))]\n843:                           (swap! s assoc :last-id (:id h))\n844:                           moved?)))\n845:             seen (set (map (comp :id first) turn))\n846:             resumed (doall\n847:                       (for [h (sort-by :id (vals (:handles @s)))\n848:                             :when (and (not (seen (:id h))) (runnable-remainder? h))]\n849:                         (resume! p h)))\n850:             fired? (expire! p)\n851:             _ (report-drained! p)\n852:             late? (deliver-notify! p)]\n853:         {:progressed? (boolean (or notified? (some true? visited) (some true? resumed)\n854:                                    fired? late?))})\n855:       (finally\n856:         (maybe-release! p)))))\n857: \n858: \n859: ;; =============================================================================\n860: ;; Listener lifecycle (A6 seam)\n861: ;; =============================================================================\n862: [\n  'tools/jolt-autobahn/remote-testee.sh',\n  'tools/jolt-autobahn/test-readiness.sh',\n  'tools/jolt-autobahn/test_harness.py',\n  'test/yang/python/antlr/fixtures/jolt_j0c_corpus.edn',\n  'test/yang/python/antlr/fixtures/jolt_j0c_input_corpus.edn',\n  'test/yang/python/antlr/fixtures/jolt_j0c_input_oracle.edn',\n  'test/yang/python/antlr/fixtures/jolt_j0c_oracle.edn',\n  'test/resources/yin/repl/jolt-applicability.edn',\n  'src/dev/jolt_autobahn_testee.clj',\n  'src/dev/jolt_carrier_test.clj',\n  'src/dev/jolt_cbor_override_self_test.clj',\n  'src/dev/jolt_test_runner.clj',\n  'docs/jolt-experiment.md',\n  'docs/jolt-vs-jank.md',\n  'docs/design/yin.repl-jolt-implementation.md',\n  'collab/jolt/1792428745000-architect-jolt-design-doc.claude-opus-5-