t)\n566:       (do (pump/close-listener! p lh)\n572:                     (pump/discard! p h)\n576:                      (let [{:keys [local peer]} (pump/close-record h)] (and (nil? local) (nil? peer))))\n577:                 (do (pump/close! p h 1001 \"dao.stream/endpoint-stopped\")\n582:             (pump/lower-deadlines! p lh at))\n591: (defn debug-state\n592:   \"This instance's registry for diagnostics: the pump's `{:fds :buffers?\n597:     (assoc (pump/debug-state (::pump inst)) :owed (count owed) :unbind-closed unbind-closed)))\n600: (defn close-host!\n601:   \"Forced cleanup once the owner loop has ended (R5): every descriptor\n606:   (let [p (::pump inst)\n610:       (when-let [h (:h @c)] (pump/discard! p h))\n613:       (pump/discard! p (:lh @lrec)))\n615:     ;; owed pump reports and drain records leave through one turn; every\n617:     (pump/pump! p [])\n618:     (let [left (pump/debug-state p)]"}],"_meta":{"codex/nodeReplExecutionDurationMs":12},"structured_content":null},"error":null,"status":"completed"}}
