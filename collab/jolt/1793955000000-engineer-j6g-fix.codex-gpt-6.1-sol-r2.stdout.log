n1: (ns jolt-workload-w-run\n2:   \"Independent watchdog and sampler for the single-threaded Workload W worker.\n3:    Run with bb workload-w:jolt [workload-w|quick-w|cross-host|served-stream|all].\"\n4:   (:require [clojure.edn :as edn]\n5:             [clojure.string :as str]))\n6: \n7: \n8: (def hard-cap-ms 300000)\n9: (def telemetry-ms 10000)\n10: \n11: \n12: (defn- now-ms\n13:   []\n14:   (quot (System/nanoTime) 1000000))\n15: \n16: \n17: (defn- p99\n18:   [samples]\n19:   (when (seq samples)\n20:     (nth (sort samples) (min (dec (count samples)) (int (* 0.99 (count samples)))))))\n21: \n22: \n23: (defn- observe-line\n24:   [state line]\n25:   (if (str/starts-with? line \"W-SAMPLE \")\n26:     (let [sample (edn/read-string (subs line 9))]\n27:       (when-not (and (number? sample) (<= 0 sample))\n28:         (throw (ex-info \"Invalid worker sample\" {:line line})))\n29:       (update state :samples conj sample))\n30:     (do\n31:       (println line)\n32:       (flush)\n33:       (cond-> (assoc state :last-output-at (now-ms))\n34:         (str/starts-with? line \"W-PHASE \") (assoc :phase (subs line 8))))))\n35: \n36: \n37: (defn- read-output\n38:   \"Only ready characters, at most 8192 per turn: a partial line or a noisy\n39:    worker must not block the watchdog's clock or its ten-second sampler.\"\n40:   [reader state]\n41:   (let [chunk (StringBuilder.)]\n42:     (loop [remaining 8192]\n43:       (when (and (pos? remaining) (.ready reader))\n44:         (let [c (.read reader)]\n45:           (when (not= -1 c)\n46:             (.append chunk (char c))\n47:             (recur (dec remaining))))))\n48:     (let [lines (str/split (str (:partial state) chunk) #\"\\n\" -1)]\n49:       (assoc (reduce observe-line state (butlast lines)) :partial (last lines)))))\n50: \n51: \n52: (defn- telemetry!\n53:   [state elapsed]\n54:   (println \"WATCHDOG TELEMETRY\"\n55:            (pr-str {:elapsed-ms elapsed,\n56:                     :samples (count (:samples state)),\n57:                     :running-p99-ms (p99 (:samples state)),\n58:                     :first-round-phase (:phase state),\n59:                     :output-age-ms (- (now-ms) (:last-output-at state))}))\n60:   (flush))\n61: \n62: \n63: (defn- failure!\n64:   [state elapsed reason]\n65:   (println \"Workload W Results: FAILURE\")\n66:   (println \"RECORD failure reason\" reason)\n67:   (println \"RECORD p99 ABSENT\")\n68:   (println \"RECORD sample count\" (count (:samples state)))\n69:   (println \"RECORD elapsed ms\" elapsed)\n70:   (println \"FAIL workload-w\")\n71:   (flush))\n72: \n73: \n74: (defn- run-watched\n75:   [args]\n76:   (let [started (now-ms)\n77:         command (into [\"sh\" \"-c\"\n78:                        \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt src/dev/jolt_workload_w.clj \\\"$@\\\"\"\n79:                        \"jolt\"] args)\n80:         builder (ProcessBuilder. ^java.util.List command)\n81:         _ (.put (.environment builder) \"JOLT_WORKLOAD_W_SUPERVISED\" \"1\")\n82:         _ (.redirectError builder java.lang.ProcessBuilder$Redirect/INHERIT)\n83:         process (.start builder)]\n84:     (try\n85:       (with-open [reader (java.io.BufferedReader.\n86:                           (java.io.InputStreamReader. (.getInputStream process) \"UTF-8\"))]\n87:         (loop [state {:samples [], :partial \"\", :phase \"loading\", :last-output-at started}\n88:                next-telemetry (+ started telemetry-ms)]\n89:           (let [state (read-output reader state)\n90:                 now (now-ms)\n91:                 elapsed (- now started)]\n92:             (when (>= now next-telemetry)\n93:               (telemetry! state elapsed))\n94:             (cond\n95:               (>= elapsed hard-cap-ms)\n96:               (do\n97:                 ;; Kill directly: the shell execs jolt, so no worker is left behind.\n98:                 (.destroyForcibly process)\n99:                 (failure! state elapsed :har