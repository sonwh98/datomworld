)\n507:                                (not @a-stalled?)\n508:                                valid-run?\n509:                                target-samples-met?\n510:                                p99-ok?\n511:                                repl-advances?\n512:                                delivered-once?\n513:                                no-reply-lost?)]\n514: \n515:             (println)\n516:             (println \"================================================================================\")\n517:             (println \"Workload W Results:\" (if all-pass? \"SUCCESS\" \"FAILURE\"))\n518:             (println \"================================================================================\")\n519:             (println \"  Hard cap timed out:           \" @timed-out?)\n520:             (println \"  Elapsed:                      \" elapsed-ms \"ms\")\n521:             (println \"  Peer A transfer stalled:      \" @a-stalled?)\n522:             (println \"  Sample count:                 \" sample-count\n523:                      (str \"(valid >= 500: \" valid-run? \", target >= \" target-samples \": \" target-samples-met? \")\"))\n524:             (println \"  p99 round-trip latency:       \" (if (some? p99) (str p99 \"ms\") \"ABSENT\")\n525:                      (str \"(criterion <= 250 ms: \" p99-ok? \")\"))\n526:             (println \"  Peer B replies lost:          \" replies-lost \"(unanswered) +\" @b-lost \"(corrupt)\")\n527:             (println \"  Peer A delivered once:        \" delivered-once?\n528:                      (str \"(deliveries: \" a-deliv-count \", bytes: \" a-deliv-len \", sent: \" @a-sent \")\"))\n529:             (println \"  REPL per-round step advance:  \" repl-advances?\n530:                      (str \"(rounds: \" @owner-round-count \", REPL steps: \" @repl-step-count \")\"))\n531:             (println)\n532: \n533:             ;; Required report records per BRIEF-j6g.md\n534:             (if (some? p99)\n535:               (println \"RECORD p99\" p99 \"ms\")\n536:               (println \"RECORD p99 ABSENT\"))\n537:             (println \"RECORD sample count\" sample-count)\n538:             (println \"RECORD elapsed ms\" elapsed-ms)\n539:             (println \"RECORD delivered once\" delivered-once?)\n540:             (println \"RECORD per-round step advance\" repl-advances?)\n541: \n542:             (if all-pass?\n543:               (do (println \"PASS workload-w\")\n544:                   {:pass? true\n545:                    :p99 p99\n546:                    :samples sample-count\n547:                     :elapsed-ms elapsed-ms\n548:                     :timed-out? @timed-out?\n549:                     :transfer-stalled? @a-stalled?\n550:                    :delivered-once? delivered-once?\n551:                    :repl-advances? repl-advances?\n552:                    :replies-lost replies-lost})\n553:               (do (println \"FAIL workload-w\")\n554:                   {:pass? false\n555:                    :p99 p99\n556:                    :samples sample-count\n557:                     :elapsed-ms elapsed-ms\n558:                     :timed-out? @timed-out?\n559:                     :transfer-stalled? @a-stalled?\n560:                    :delivered-once? delivered-once?\n561:                    :repl-advances? repl-advances?\n562:                    :replies-lost replies-lost}))))))))\n563: \n564: \n565: ;; =============================================================================\n566: ;; Deliverable 2: Peer Cross-Host Rows\n567: ;; =============================================================================\n568: \n569: (defn run-cross-host-rows\n570:   \"Verify cross-host listener, dialer, and REPL path reachability rows:\n571:    - Hosts that listen: 127.0.0.1, 0.0.0.0, localhost, ::1; port 0 ephemeral; port collision.\n572:    - Hosts that dial: 127.0.0.1, localhost, [::1]; hostname refused; wss refused.\n573:    - REPL reachability refusals: local reachability failure, reachability failure, disclaimed path.\"\n574:   []\n575:   (println \"================================================================================\")\n576:   (println \"J6g Cross-Host Rows: Running checks...\")\n577:   (println \"================================================================================\")\n578:   (let [w (wake/make-wake)\n579:         passed (atom 0)\n580:         failed (atom 0)\n581:         check! (fn [label ok? detail]\n582:                  (if ok?\n583:                    (do (swap! passed inc)\n584:                        (println \"  ok  \" label))\n585:                    (do (swap! failed inc)boot\n634: (defn boot\n635:   \"Create the composition: one shell, one input medium, one cursor held only by\n636:    the step owner, and the host WebSocket adapter `(connect ...)` attaches\n637:    through.  The parsed `:index-store-spec` reaches the shell's store\n638:    selection, which resolves and opens it once at construction.  A custody\n639:    composition (:custody, yin.vm.ucf.compose) rides the shell as data; the\n640:    step owner below is the only thing that steps it.\n641: \n642:    `:admission` is the session's admission policy (yin.vm.linker.dht.md\n643:    7.5; `--dht-trust` sets its `:trusted`), by default `{}`: the key's\n644:    own principal only.  It is apart from `:principals`: a declared\n645:    publisher is not a trusted one.\"\n646:   ([] (boot {}))\n647:   ([opts] (driver/create-state\n648:             {:host (or (:adapter opts) (host/websocket))\n649:              :repl (repl.frontends/create-state\n650:                      (cond-> {:index-store-spec (:index-store-spec opts)\n651:                               :dht-key (:dht-key opts)\n652:                               :principals (:principals opts)\n653:                               :admission (:admission opts {})\n654:                               :ws-host (:ws-host opts)\n655:                               :write-heads! (:write-heads! opts)\n656:                               :custody (:custody opts)}\n657:                        (:vm-type opts) (assoc :vm-type (:vm-type opts))))})))\n658: \n659: \n660: (def bind-all-host\n661:   \"`--port` listens on every interface: loopback and the machine's own IP.\"\n662:   \"0.0.0.0\")\n663: \n664: \n665: (defn pick-ip\n666:   \"The address to advertise among a machine's non-loopback IPv4 addresses:\n667:    the first private-network one (10/8, 172.16/12, 192.168/16), since a\n668:    tunnel or VPN interface can list ahead of the LAN's; else the first;\n669:    else loopback.\"\n670:   [ips]\n671:   (or (first (filter #(re-matches #\"10\\..*|192\\.168\\..*|172\\.(1[6-9]|2\\d|3[01])\\..*\"\n672:                                   %)\n673:                      ips))\n674:       (first ips)\n675:       \"127.0.0.1\"))\n676: \n677: \n678: (defn local-ip\n679:   \"This machine's address for `--port`'s banner and advertised host.\n680:    ClojureDart can only list interfaces asynchronously, so it advertises\n681:    loopback.\"\n682:   []\n683:   (pick-ip\n684:     #?(:cljd nil\n685:        :clj (try (doall\n686:                    (for [^java.net.NetworkInterface ni\n687:                          (enumeration-seq\n688:                            (java.net.NetworkInterface/getNetworkInterfaces))\n689:                          :when (and (.isUp ni) (not (.isLoopback ni)))\n690:                          ^java.net.InetAddress a (enumeration-seq\n691:                                                    (.getInetAddresses ni))\n692:                          :when (instance? java.net.Inet4Address a)]\n693:                      (.getHostAddress a)))\n694:                  (catch Exception _ nil))\n695:        :cljs (try (doall\n696:                     (for [addrs (array-seq (js/Object.values\n697:                                              (.networkInterfaces\n698:                                                (js/require \"os\"))))\n699:                           ^js a (array-seq addrs)\n700:                           :when (and (contains? #{\"IPv4\" 4} (.-family a))\n701:                                      (not (.-internal a)))]\n702:                       (.-address a)))\n703:                   (catch :default _ nil)))))\n704: \n705: \n706: (defn boot-server\n707:   \"Compose the served endpoint for `--port`, or nil when no port was asked for.\n708: \n709:    `serve!` returns immediately.  Whether a listener bound is a fact the\n710:    endpoint's lifecycle medium reports, and the ticker prints it.\"\n711:   [opts]\n712:   (when (:port opts)\n713:     (serve/serve! {:bind-port (:port opts)\n714:                    :bind-host bind-all-host\n715:                    :advertised-host (local-ip)\n716:                    :host (or (:adapter opts) (host/websocket))\n717:                    :codec (get connect/codec-profiles (:codec opts :cbor))})))\n718: \n719: \n720: (def help-lines\n721:   \"What `--help` prints: every subcommand and flag `parse-args` and\n722:    `expand-args` read.\"\n723:   [\"yin-repl: the interface to datom.world\"\n724:    \"\"\n725:    \"usage: yin-repl [flags]\"\n726:    \"       yin-repl dht init|serve|join [token] [options]\"\n727:    \"       yin-repl keygen [--name n | file]\"\n728:    \"\"\n729:    \"subcommands:\"\n730:    \"  dht init          publish: share the store, make the key on first run\"\n731:    \"  dht serve         storing peer: fetch only, no key\"\n732:    \"  dht join <token>  reader: follow the head of the token's principal;\"\n733:    \"                    the token is yin:<host:port>/<principal>\"evaluate-locally\n172: (defn- evaluate-locally\n173:   [state line]\n174:   (let [[repl text] (repl/eval-input (:repl state) line)]\n175:     (-> state\n176:         (assoc :repl repl)\n177:         (assoc :running? (boolean (:running? repl)))\n178:         (publish :yin.repl.driver/result text))))\n179: \n180: \n181: (defn- rpc-client\n182:   [state]\n183:   (get-in state [:adapter :yin.repl.adapter/rpc]))\n184: \n185: \n186: (defn- remote-terminal\n187:   [state]\n188:   (:terminal (rpc-client state)))\n189: \n190: \n191: (defn- remote-unsent?\n192:   \"True while the RPC client holds an allocated request it has not managed to\n193:    append.  That request, not the driver's own record of the line, is what owns\n194:    the request path: `rpc/request!` retries it and ignores any new operation.\"\n195:   [state]\n196:   (rpc/unsent? (rpc-client state)))\n197: \n198: \n199: (defn pending-write?\n200:   \"True while a remote write the operator is owed remains in flight: a\n201:    request awaiting its response, a line held for a full writer, or an\n202:    envelope the RPC client still retains. This is one half of the tick\n203:    owner's `moved?` — a pending write must never wait out a backoff ceiling,\n204:    so cadence stays at the base interval until it clears.\"\n205:   [state]\n206:   (boolean (or (:outstanding state)\n207:                (:retrying state)\n208:                (remote-unsent? state)\n209:                ;; RPC holds every request until its response cursor is minted;\n210:                ;; a line queued behind that mint is still owed a prompt send.\n211:                (and (seq (:queued state))\n212:                     (rpc/cursor-pending? (rpc-client state))))))\n213: \n214: \n215: (defn- remote-routed?\n216:   \"True while ordinary input belongs to the remote shell.  An operator\n217:    `(disconnect)` ends that immediately — the shell is local again from the next\n218:    line, without waiting for the terminal event the boundary will deposit — while\n219:    an uninvited drop keeps routing so the input can queue for a reattachment.  A\n220:    terminal with no reattachment behind it ends it too: after a terminal an\n221:    ordinary line still has a reattachment decision to wait for only while the\n222:    binding is `connect/reattachable?`.  A reachability failure may succeed\n223:    through a *fresh* connection, but that connection cannot inherit this\n224:    binding's queued lines, so promising to deliver them would be false.\"\n225:   [state]\n226:   (and (:adapter state)bb.edn\n100:            (println \"probe:jolt-ws exits\" (pr-str results))\n101:            (System/exit (if (every? (comp zero? second) results) 0 1)))}\n102: \n103:   workload-w:jolt\n104:    {:doc \"J6g: pre-registered Workload W, with an independent five-minute watchdog and ten-second sampler; one jolt worker serves two peers while stepping the REPL (needs bb bootstrap:jolt and bb build:jolt-native)\"\n105:    :task (System/exit\n106:            (:exit (apply shell {:continue true} \"sh\" \"-c\"\n107:                           \"exec bb src/dev/jolt_workload_w_run.clj \\\"$@\\\"\"\n108:                          \"jolt\" *command-line-args*)))}\n109: \n110:   build:jolt-native"}],"_meta":{"codex/nodeReplExecutionDurationMs":39},"structured_content":null},"error":null,"status":"completed"}}
