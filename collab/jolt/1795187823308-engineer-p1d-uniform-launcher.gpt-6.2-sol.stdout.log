{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"rg --files | rg slice_peer && cat /Users/sto/workspace/datomworld/build/tools/jolt/host/gambit/yin/jolt/gambit/yin.jolt && sed -n '1985,2010p' /Users/sto/workspace/datomworld/build/tools/jolt/Makefile && rg -n 'JOLT.*BRIDGE|gambitffi-bridge' /Users/sto/workspace/datomworld/build/tools/jolt/host/gambit/ffi /Users/sto/workspace/datomworld/build/tools/jolt/Makefile | head -35\"","aggregated_output":"test/yin/repl/slice_peer.cljc\n(ns jolt.gambit.yin\n  \"The local-memory composition for the Gambit terminal.\"\n  (:require [dao.jing :as jing]\n            [jolt.ffi :as ffi]\n            [yin.repl.main :as main]\n            [yin.repl.store :as store]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n(defn- activate-ffi [registry]\n  (module/register-host-module\n    registry 'jolt.ffi\n    {'sizeof ffi/sizeof}\n    {'sizeof (vm/primitive-profile 'sizeof :pure [1] #{} :none)}))\n\n(defn- materialize-sha256 [value]\n  (jing/materialize! (store/open :mem) value {:algorithm :sha256}))\n\n(defn- activate-store [registry]\n  (module/register-host-module\n    registry 'dao.jing.mem\n    {'materialize-sha256 materialize-sha256}\n    {'materialize-sha256\n     (vm/primitive-profile 'materialize-sha256 :pure [1] #{} :none)}))\n\n(defn- open-memory [spec _opts]\n  {:index-store (store/open spec)\n   :engine-inputs {:host-modules {'jolt.ffi activate-ffi\n                                  'dao.jing.mem activate-store}}})\n\n(defn- parse-store [arg]\n  (let [spec (store/parse-arg arg)]\n    (when-not (= spec :mem)\n      (throw (ex-info \"The local Gambit session supports only --index-store mem\"\n                      {:store spec})))\n    spec))\n\n(defn -main [& args]\n  (main/main! args {:composition-spec? #{:mem}\n                    :parse-store-arg parse-store\n                    :open open-memory}))\nDATOMWORLD_ROOT ?= ../datomworld\ngambitdaobytes:\n\tsh host/gambit/ffi/watchdog.sh 240 \"$(GAMBIT_GSI)\" host/gambit/source-loader-test.ss \"$(abspath $(DATOMWORLD_ROOT))\"\n\n# The interpreted bootstrap is available through yin-repl-main.ss. Compiling\n# the same boot makes the full app closure fit the acceptance watchdog.\nGAMBIT_YIN_BOOT ?=\ngambityinrepl: gambitffi-bridge\n\t@yin_root=\"$(abspath $(DATOMWORLD_ROOT))\"; \\\n\tif [ ! -f \"$$yin_root/src/cljc/yin/repl/main.cljc\" ]; then \\\n\t  echo \"gambityinrepl: no Yin source entry under $$yin_root. Set DATOMWORLD_ROOT to a Datomworld checkout.\" >&2; \\\n\t  exit 2; \\\n\tfi; \\\n\tboot=\"$(GAMBIT_YIN_BOOT)\"; \\\n\tif [ -z \"$$boot\" ]; then \\\n\t  boot=$$(sh host/gambit/ffi/watchdog.sh 2400 python3 host/gambit/build-yin-boot.py \\\n\t    \"$(GAMBIT_GSC)\" \"$(abspath build/gambit-yin)\") || exit $$?; \\\n\tfi; \\\n\tJOLT_GAMBIT_YIN_BOOT=\"$$boot\" sh test/gambit/yin-repl-session.sh \\\n\t  \"$(GAMBIT_GSI)\" \"$$yin_root\" host/gambit/yin-repl-native.ss\n\n# Every Scheme global the full-profile boot references is defined — Gambit's\n# own linker report over the compiled boot, minus what the record translator\n# evals at runtime, against host/gambit/unbound-allowlist.txt (untaken paths;\n# a stale line fails). The boot splices most of host/chez, so a Chez-side name\n# reaching a shared file is otherwise an unbound global no Chez gate can see;\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:131:        gambitffi gambitffi-abi gambitffi-errno-check gambitffi-load-failure-smoke gambitffi-bridge \\\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:1946:gambitcheck: $(if $(wildcard $(GAMBIT_GSI)),gambitffi-bridge)\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:1992:gambityinrepl: gambitffi-bridge\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:2186:gambitffi-bridge: gambitffi-verify-digests $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:2191:gambitffi-abi: gambitffi-bridge\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:2207:gambitffi-errno-check: gambitffi-bridge $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1\n/Users/sto/workspace/datomworld/build/tools/jolt/Makefile:2214:gambitffi-load-failure-smoke: gambitffi-bridge\n","exit_code":0,"status":"completed"}}
