{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'for p in host/gambit/build-yin-boot.py host/gambit/yin-repl-native.ss host/gambit/yin-repl-driver.ss test/gambit/yin-repl-session.sh; do git -C build/tools/jolt show HEAD:$p; done'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Compile Jolt's existing Gambit boot for the Yin loaded-source gate.\"\"\"\nfrom concurrent.futures import ThreadPoolExecutor\nimport fcntl\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\n\nINCLUDE = re.compile(r'(?m)^([ \\t]*)\\(##include \"([^\"]+)\"\\)')\nREPO = Path(__file__).resolve().parents[2]\nBOOT = REPO / \"host/gambit/boot.ss\"\nSEEDS = {\"seed/prelude.ss\": (\"prelude\", 120), \"seed/image.ss\": (\"compiler\", 125)}\n\n\ndef boot_sources(path, seen):\n    if path in seen:\n        return\n    seen.add(path)\n    text = path.read_text()\n    yield path, text\n    for match in INCLUDE.finditer(text):\n        yield from boot_sources((path.parent / match[2]).resolve(), seen)\n\n\ndef write_units(directory):\n    units = []\n\n    def rewrite(match):\n        indent, relative = match.groups()\n        path = (BOOT.parent / relative).resolve()\n        if relative not in SEEDS:\n            return f'{indent}(##include {json.dumps(str(path), ensure_ascii=False)})'\n        prefix, chunk_size = SEEDS[relative]\n        # The seed emitter writes each guarded top-level form at column zero.\n        forms = re.split(r'(?m)(?=^\\(guard )', path.read_text())\n        if forms[0].strip():\n            raise ValueError(f\"Unexpected seed format in {path}\")\n        forms = forms[1:]\n        loads = []\n        for start in range(0, len(forms), chunk_size):\n            unit = directory / f\"{prefix}-{start // chunk_size:02d}.ss\"\n            unit.write_text(\"\".join(forms[start:start + chunk_size]))\n            units.append(unit)\n            artifact = json.dumps(str(unit.with_suffix(\".o1\")), ensure_ascii=False)\n            loads.append(f\"{indent}(load {artifact})\")\n        return \"\\n\".join(loads)\n\n    kernel = directory / \"kernel.ss\"\n    kernel.write_text(INCLUDE.sub(rewrite, BOOT.read_text()))\n    return [kernel, *units]\n\n\ndef build(gsc, cache):\n    digest = hashlib.sha256(Path(__file__).read_bytes())\n    digest.update(gsc.read_bytes())\n    for path, text in sorted(boot_sources(BOOT, set())):\n        digest.update(str(path).encode())\n        digest.update(text.encode())\n    key = digest.hexdigest()\n    cache.mkdir(parents=True, exist_ok=True)\n    pointer = cache / key\n\n    with (cache / \".lock\").open(\"a\") as lock:\n        fcntl.flock(lock, fcntl.LOCK_EX)\n        if pointer.exists():\n            kernel = Path(pointer.read_text().strip())\n            if kernel.is_file():\n                return kernel\n\n        directory = Path(tempfile.mkdtemp(prefix=\"boot-\", dir=cache))\n        units = write_units(directory)\n\n        def compile_unit(unit):\n            # The kernel alone expands to a large C translation unit.\n            options = [\"-:min-heap=768M\"] if unit == units[0] else []\n            subprocess.run([str(gsc), *options, \"-dynamic\", \"-cc-options\", \"-O0\", unit.name],\n                           cwd=directory, stdout=sys.stderr, check=True)\n            if not unit.with_suffix(\".o1\").is_file():\n                raise RuntimeError(f\"Gambit did not produce an object for {unit}\")\n\n        with ThreadPoolExecutor(max_workers=2) as executor:\n            list(executor.map(compile_unit, units))\n\n        kernel = units[0].with_suffix(\".o1\")\n        pending = directory / \"cache-entry\"\n        pending.write_text(f\"{kernel}\\n\")\n        pending.replace(pointer)\n        return kernel\n\n\nif __name__ == \"__main__\":\n    print(build(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()))\n#!/usr/bin/env gsi-script\n;; The gate builds the kernel with gsc. App namespaces still load from source.\n;; The Gambit boot omits Chez's external data-reader loader.\n(define data-readers-active #f)\n(load (getenv \"JOLT_GAMBIT_YIN_BOOT\"))\n(##include \"yin-repl-driver.ss\")\n;; The native and interpreted boots use the same source loader and Yin owner.\n(##include \"host-apply.ss\")\n(##include \"source-loader.ss\")\n(##include \"unbound-vars-lib.ss\")\n(##include \"yin/blake3.ss\")\n\n(define (gambit-yin-random-bytes size)\n  (let* ((n (jnum->exact size))\n         (out (make-u8vector n)))\n    (call-with-input-file \"/dev/urandom\"\n      (lambda (port)\n        (unless (= (read-subu8vector out 0 n port) n)\n          (error \"Gambit could not read OS entropy\"))))\n    out))\n\n;; A single outstanding request keeps the input reader from filling the\n;; mailbox. Only Yin's owner interprets submitted lines.\n(define (gambit-yin-wake)\n  (vector\n    (thread-start!\n      (make-thread\n        (lambda ()\n          (let loop ()\n            (let* ((owner (thread-receive))\n                   (line (read-line)))\n              (thread-send owner (if (eof-object? line) jolt-nil line))\n              (unless (eof-object? line) (loop)))))))\n    #f))\n\n(define (gambit-yin-close-wake! wake)\n  (thread-terminate! (vector-ref wake 0))\n  jolt-nil)\n\n(define (gambit-yin-wait-input! wake ms on-line)\n  (let ((seconds (/ ms 1000.0)))\n    (if (jolt-nil? on-line)\n        (thread-sleep! seconds)\n        (begin\n          (unless (vector-ref wake 1)\n            (thread-send (vector-ref wake 0) (current-thread))\n            (vector-set! wake 1 #t))\n          (let ((line (thread-receive seconds #f)))\n            (when line\n              (vector-set! wake 1 #f)\n              (jolt-invoke on-line line))))))\n  jolt-nil)\n\n(set! jolt-random-bytes gambit-yin-random-bytes)\n(register-class-statics! \"System\"\n  (list (cons \"currentTimeMillis\" gambit-epoch-ms)\n        (cons \"exit\" (lambda (status) (exit (jnum->exact status))))))\n\n(let ((args (cdr (command-line))))\n  (unless (pair? args)\n    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\n    (exit 2))\n  (let ((root (path-expand (car args)))\n        (jolt-root (current-directory)))\n    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\n      (fprintf (current-error-port) \"yin.repl: no source entry under ~a\\n\" root)\n      (exit 2))\n    (with-exception-catcher\n      (lambda (e)\n        (let* ((value (jolt-unwrap-throw e))\n               (message (jolt-throwable-message value))\n               (location (jolt-current-source-string)))\n          (fprintf (current-error-port) \"yin.repl startup failed: ~a\\n\"\n                   (if (string? message) message (jolt-pr-readable value)))\n          (when (and (string? location) (not (string=? location \"\")))\n            (fprintf (current-error-port) \"Yin source: ~a\\n\" location))\n          (exit 1)))\n      (lambda ()\n        ;; Cache the qualified bridge before resolving Yin's paths relative to\n        ;; its own checkout. The source loader itself uses absolute roots.\n        (joltffi-ensure-bridge! 'yin.repl)\n        (let ((load-ns\n                (gambit-install-source-loader!\n                  (list (list (path-expand \"host/gambit/yin\" jolt-root) \".jolt\")\n                        (list (path-expand \"src/jolt\" root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"src/cljc\" root) \".cljc\" \".clj\")\n                        (list (path-expand \"src/clj\" root) \".clj\")\n                        (list (path-expand \"stdlib\" jolt-root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"jolt-core\" jolt-root) \".cljc\" \".clj\"))\n                  '(\"clojure.core\" \"jolt.ffi\"))))\n          (parameterize ((current-directory root))\n            (let* ((audit? (getenv \"JOLT_YIN_AUDIT\" #f))\n                   (before (and audit? (unbound-var-names))))\n              (dynamic-wind\n                (lambda () #f)\n                (lambda () (load-ns \"jolt.gambit.yin\" #f))\n                (lambda ()\n                  (when audit?\n                    (let ((added (filter (lambda (name) (not (member name before)))\n                                         (unbound-var-names))))\n                      (fprintf (current-error-port) \"yin source var audit: ~a newly unbound\\n\"\n                               (length added))\n                      (for-each (lambda (name) (fprintf (current-error-port) \"  ~a\\n\" name))\n                                added))))))\n            (def-var! \"yin.repl\" \"host-text\" (string-append \"Host: jolt / Gambit \" (system-version-string)))\n            (let ((main (var-deref \"jolt.gambit.yin\" \"-main\")))\n              (unless (procedure? main)\n                (error \"jolt.gambit.yin/-main did not load\"))\n              (apply jolt-invoke main (cdr args)))))))))\n#!/bin/sh\n# Drive the upstream Yin entry point. A shell exit status alone never passes.\nset -eu\n\ngsi=$1\nyin_root=$2\nlauncher=${3:-host/gambit/yin-repl-main.ss}\ntranscript=$(mktemp)\ntrap 'rm -f \"$transcript\"' EXIT\n\nstatus=0\nsh host/gambit/ffi/watchdog.sh 2400 \"$gsi\" \"$launcher\" \\\n  \"$yin_root\" --no-state --index-store mem >\"$transcript\" <<'FORMS' || status=$?\n(+ 1 2)\n((fn [x] (* x x)) 7)\n(def p1c-score 100)\n(+ p1c-score 1)\n(/ 1 0)\n(lang :yang/python)\n(require 'jolt.ffi)\n(jolt.ffi/sizeof :int32)\n(require 'dao.jing.mem)\n(dao.jing.mem/materialize-sha256 {:witness 1})\n(+ 21 22)\n(quit)\nFORMS\ncat \"$transcript\"\nif [ \"$status\" -ne 0 ]; then\n  echo \"gambityinrepl: a complete Yin session was not observed (status $status)\" >&2\n  exit 1\nfi\n\n# Each line must follow the previous one, with prompts on the actual replies.\nawk '\n  /^yin> 3$/ && step == 0 { step++; next }\n  /^yin> 49$/ && step == 1 { step++; next }\n  /^yin> 100$/ && step == 2 { step++; next }\n  /^yin> 101$/ && step == 3 { step++; next }\n  /^yin> Error: .*[Dd]ivid(e|ed) by zero/ && step == 4 { step++; next }\n  /^yin> Error: unavailable-parser: Yin REPL language :yang\\/python/ && step == 5 { step++; next }\n  /^yin> \\047jolt[.]ffi$/ && step == 6 { step++; next }\n  /^yin> 4$/ && step == 7 { step++; next }\n  /^yin> \\047dao[.]jing[.]mem$/ && step == 8 { step++; next }\n  /^yin> Error: .*blocking ffi is unsupported on the gambit target/ && step == 9 { step++; next }\n  /^yin> 43$/ && step == 10 { step++; next }\n  /^yin> Bye$/ && step == 11 { step++; next }\n  /^yin> / { unexpected = 1 }\n  END { exit !(step == 12 && !unexpected) }\n' \"$transcript\" || {\n  echo \"gambityinrepl: the Yin session did not produce the expected replies\" >&2\n  exit 1\n}\necho \"gambityinrepl: PASS — Yin state, evaluation error, frontend refusal, FFI, blocking refusal, and clean quit\"\n","exit_code":0,"status":"completed"}}
