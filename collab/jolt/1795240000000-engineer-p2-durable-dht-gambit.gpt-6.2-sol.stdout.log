{"type":"item.completed","item":{"id":"item_72","type":"command_execution","command":"/bin/zsh -lc \"set -e\npython3 -c 'from pathlib import Path\nPath(\\\"test/gambit/fixtures/yin-durable.jolt\\\").write_text(\\\"\\\\n;; Appended by the process gate to observe the actual selected store.\\\\n(def \"'^:private durable-test-opened (atom nil))'\"\\\\n(def \"'^:private durable-test-value {:p2 '\"\\\\\\\"durable-gambit\\\\\\\" :count 7331})\\\\n\\\\n(defn- durable-test-run [operation]\\\\n  (let [opened @durable-test-opened\\\\n        handle (:index-store opened)\\\\n        address (jing/segment-key durable-test-value)]\\\\n    (case operation\\\\n      :put (when (= :missing (jing/get handle address :missing))\\\\n             (jing/materialize\"'! handle durable-test-value))'\"\\\\n      :get (jing/get handle address :missing)\\\\n      :recovered (get-in opened [:recovery :manifest]))))\\\\n\\\\n(defn- activate-durable-test [registry]\\\\n  (module/register-host-module\\\\n    registry '\\\\''p2.probe\\\\n    {'\\\\''run durable-test-run}\\\\n    {'\\\\''run (vm/primitive-profile '\\\\''run :pure [1] #{} :none)}))\\\\n\\\\n(defn- durable-test-open [spec opts]\\\\n  (let [opened (open-store spec opts)]\\\\n    (reset\"'! durable-test-opened opened)'\"\\\\n    (assoc-in opened [:engine-inputs :host-modules '\\\\''p2.probe] activate-durable-test)))\\\\n\\\\n(defn -main [& args]\\\\n  (main/main\"'! args (assoc composition :open durable-test-open)))'\"\\\\n\\\")\nPath(\\\"test/gambit/yin-dht-durable.py\\\").write_text(\\\"#\"'!/usr/bin/env python3'\"\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Drive distinct Yin processes and assert persisted bytes and UDP replication.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nfrom concurrent.futures import ThreadPoolExecutor\\\\nfrom contextlib import ExitStack\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport re\\\\nimport shutil\\\\nimport signal\\\\nimport socket\\\\nimport subprocess\\\\nimport sys\\\\nimport tempfile\\\\nimport time\\\\n\\\\n\\\\nREPO = Pa