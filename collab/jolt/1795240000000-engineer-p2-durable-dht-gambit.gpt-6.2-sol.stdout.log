{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat host/gambit/yin-repl-driver.ss; cat host/gambit/build-yin-boot.py; cat host/gambit/boot.ss | head -105; rg -n 'slurp|spit|user.dir|file-delete|current-directory|file-exists|mkdir' host/gambit/*.ss; ls -l /opt/homebrew/bin/bb /Users/sto/.local/share/mise/installs/babashka/*/bin/bb; ls -lh /Users/sto/workspace/jolt-ffi-p1f/build/gambit-yin\"","aggregated_output":";; The native and interpreted boots use the same source loader and Yin owner.\n(##include \"host-apply.ss\")\n(##include \"source-loader.ss\")\n(##include \"unbound-vars-lib.ss\")\n(##include \"yin/blake3.ss\")\n\n(define (gambit-yin-random-bytes size)\n  (let* ((n (jnum->exact size))\n         (out (make-u8vector n)))\n    (call-with-input-file \"/dev/urandom\"\n      (lambda (port)\n        (unless (= (read-subu8vector out 0 n port) n)\n          (error \"Gambit could not read OS entropy\"))))\n    out))\n\n;; A single outstanding request keeps the input reader from filling the\n;; mailbox. Only Yin's owner interprets submitted lines.\n(define (gambit-yin-wake)\n  (vector\n    (thread-start!\n      (make-thread\n        (lambda ()\n          (let loop ()\n            (let* ((owner (thread-receive))\n                   (line (read-line)))\n              (thread-send owner (if (eof-object? line) jolt-nil line))\n              (unless (eof-object? line) (loop)))))))\n    #f))\n\n(define (gambit-yin-close-wake! wake)\n  (thread-terminate! (vector-ref wake 0))\n  jolt-nil)\n\n(define (gambit-yin-wait-input! wake ms on-line)\n  (let ((seconds (/ ms 1000.0)))\n    (if (jolt-nil? on-line)\n        (thread-sleep! seconds)\n        (begin\n          (unless (vector-ref wake 1)\n            (thread-send (vector-ref wake 0) (current-thread))\n            (vector-set! wake 1 #t))\n          (let ((line (thread-receive seconds #f)))\n            (when line\n              (vector-set! wake 1 #f)\n              (jolt-invoke on-line line))))))\n  jolt-nil)\n\n(set! jolt-random-bytes gambit-yin-random-bytes)\n(register-class-statics! \"System\"\n  (list (cons \"currentTimeMillis\" gambit-epoch-ms)\n        (cons \"exit\" (lambda (status) (exit (jnum->exact status))))))\n\n(let ((args (cdr (command-line))))\n  (unless (pair? args)\n    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\n    (exit 2))\n  (let ((root (path-expand (car args)))\n        (jolt-root (current-directory)))\n    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\n      (fprintf (current-error-port) \"yin.repl: no source entry under ~a\\n\" root)\n      (exit 2))\n    (with-exception-catcher\n      (lambda (e)\n        (let* ((value (jolt-unwrap-throw e))\n               (message (jolt-throwable-message value))\n               (location (jolt-current-source-string)))\n          (fprintf (current-error-port) \"yin.repl startup failed: ~a\\n\"\n                   (if (string? message) message (jolt-pr-readable value)))\n          (when (and (string? location) (not (string=? location \"\")))\n            (fprintf (current-error-port) \"Yin source: ~a\\n\" location))\n          (exit 1)))\n      (lambda ()\n        ;; Cache the qualified bridge before resolving Yin's paths relative to\n        ;; its own checkout. The source loader itself uses absolute roots.\n        (joltffi-ensure-bridge! 'yin.repl)\n        (let ((load-ns\n                (gambit-install-source-loader!\n                  (list (list (path-expand \"host/gambit/yin\" jolt-root) \".jolt\")\n                        (list (path-expand \"src/jolt\" root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"src/cljc\" root) \".cljc\" \".clj\")\n                        (list (path-expand \"src/clj\" root) \".clj\")\n                        (list (path-expand \"stdlib\" jolt-root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"jolt-core\" jolt-root) \".cljc\" \".clj\"))\n                  '(\"clojure.core\"))))\n          (parameterize ((current-directory root))\n            (let* ((audit? (getenv \"JOLT_YIN_AUDIT\" #f))\n                   (before (and audit? (unbound-var-names))))\n              (dynamic-wind\n                (lambda () #f)\n                (lambda () (load-ns \"jolt.gambit.yin\" #f))\n                (lambda ()\n                  (when audit?\n                    (let ((added (filter (lambda (name) (not (member name before)))\n                                         (unbound-var-names))))\n                      (fprintf (current-error-port) \"yin source var audit: ~a newly unbound\\n\"\n                               (length added))\n                      (for-each (lambda (name) (fprintf (current-error-port) \"  ~a\\n\" name))\n                                added))))))\n            (def-var! \"yin.repl\" \"host-text\" (string-append \"Host: jolt / Gambit \" (system-version-string)))\n            (let ((main (var-deref \"jolt.gambit.yin\" \"-main\")))\n              (unless (procedure? main)\n                (error \"jolt.gambit.yin/-main did not load\"))\n              (apply jolt-invoke main (cdr args)))))))))\n#!/usr/bin/env python3\n\"\"\"Compile Jolt's existing Gambit boot for the Yin loaded-source gate.\"\"\"\nfrom concurrent.futures import ThreadPoolExecutor\nimport fcntl\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\n\nINCLUDE = re.compile(r'(?m)^([ \\t]*)\\(##include \"([^\"]+)\"\\)')\nREPO = Path(__file__).resolve().parents[2]\nBOOT = REPO / \"host/gambit/boot.ss\"\nSEEDS = {\"seed/prelude.ss\": (\"prelude\", 120), \"seed/image.ss\": (\"compiler\", 125)}\n\n\ndef boot_sources(path, seen):\n    if path in seen:\n        return\n    seen.add(path)\n    text = path.read_text()\n    yield path, text\n    for match in INCLUDE.finditer(text):\n        yield from boot_sources((path.parent / match[2]).resolve(), seen)\n\n\ndef write_units(directory):\n    units = []\n\n    def rewrite(match):\n        indent, relative = match.groups()\n        path = (BOOT.parent / relative).resolve()\n        if relative not in SEEDS:\n            return f'{indent}(##include {json.dumps(str(path), ensure_ascii=False)})'\n        prefix, chunk_size = SEEDS[relative]\n        # The seed emitter writes each guarded top-level form at column zero.\n        forms = re.split(r'(?m)(?=^\\(guard )', path.read_text())\n        if forms[0].strip():\n            raise ValueError(f\"Unexpected seed format in {path}\")\n        forms = forms[1:]\n        loads = []\n        for start in range(0, len(forms), chunk_size):\n            unit = directory / f\"{prefix}-{start // chunk_size:02d}.ss\"\n            unit.write_text(\"\".join(forms[start:start + chunk_size]))\n            units.append(unit)\n            artifact = json.dumps(str(unit.with_suffix(\".o1\")), ensure_ascii=False)\n            loads.append(f\"{indent}(load {artifact})\")\n        return \"\\n\".join(loads)\n\n    kernel = directory / \"kernel.ss\"\n    kernel.write_text(INCLUDE.sub(rewrite, BOOT.read_text()))\n    return [kernel, *units]\n\n\ndef build(gsc, cache):\n    digest = hashlib.sha256(Path(__file__).read_bytes())\n    digest.update(gsc.read_bytes())\n    for path, text in sorted(boot_sources(BOOT, set())):\n        digest.update(str(path).encode())\n        digest.update(text.encode())\n    key = digest.hexdigest()\n    cache.mkdir(parents=True, exist_ok=True)\n    pointer = cache / key\n\n    with (cache / \".lock\").open(\"a\") as lock:\n        fcntl.flock(lock, fcntl.LOCK_EX)\n        if pointer.exists():\n            kernel = Path(pointer.read_text().strip())\n            if kernel.is_file():\n                return kernel\n\n        directory = Path(tempfile.mkdtemp(prefix=\"boot-\", dir=cache))\n        units = write_units(directory)\n\n        def compile_unit(unit):\n            # The kernel alone expands to a large C translation unit.\n            options = [\"-:min-heap=768M\"] if unit == units[0] else []\n            subprocess.run([str(gsc), *options, \"-dynamic\", \"-cc-options\", \"-O0\", unit.name],\n                           cwd=directory, stdout=sys.stderr, check=True)\n            if not unit.with_suffix(\".o1\").is_file():\n                raise RuntimeError(f\"Gambit did not produce an object for {unit}\")\n\n        with ThreadPoolExecutor(max_workers=2) as executor:\n            list(executor.map(compile_unit, units))\n\n        kernel = units[0].with_suffix(\".o1\")\n        pending = directory / \"cache-entry\"\n        pending.write_text(f\"{kernel}\\n\")\n        pending.replace(pointer)\n        return kernel\n\n\nif __name__ == \"__main__\":\n    print(build(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()))\n;; boot.ss — the G2/G3 boot: the curated jolt runtime subset + the cross-minted\n;; compiler seed load on native gsi (Gambit 4.9.7). jolt-mj95.3/.4.\n;;\n;; ONE compilation unit: everything is ##include-spliced (NOT load'd) so the\n;; shim macros from prelude-shims.ss (define-record-type, fx aliases,\n;; with-mutex, ...) expand in the SAME unit as every manifest file — the\n;; \"compile the boot files together\" flow (see gambitcheck.ss's splice note).\n;;\n;; LOAD SHIM: rt.ss orchestrates its own loads ((load \"host/chez/...\") for the\n;; whole manifest plus the excluded java tail). Under this boot every manifest\n;; file is spliced in here and the excluded ones are deliberately skipped, so\n;; a runtime (load \"host/chez/...\") must be a no-op — re-loading the Chez\n;; copies would clobber the gambit sa-runtime/hasheq and pull in Chez-only\n;; java interop. vendor/irregex is NOT under host/chez and loads normally.\n(define %gambit-load load)\n(define (load path . rest)\n  (if (and (string? path)\n           (or (string-prefix? \"host/chez/\" path)\n               ;; irregex is ##include'd below (the js target has no\n               ;; filesystem — a runtime load cannot work there)\n               (string-prefix? \"vendor/irregex/\" path)))\n      #f\n      (apply %gambit-load path rest)))\n\n(##include \"prelude-shims.ss\")\n(##include \"scheme-adapter-runtime.ss\")\n\n;; ---- manifest, in rt.ss load order (findings doc, curated) ----------------\n;;\n;; G2-booted: values, hasheq(gambit), collections, seq, then rt-core (the gambit\n;; kernel — the rt.ss port; its port-log is in the file header). STOPS at the\n;; first file whose blocker is class (c) (a genuine Chez-only construct with no\n;; gambit seam) — see REPORT.\n\n(##include \"../chez/values.ss\")\n(##include \"hasheq.ss\")\n(##include \"../chez/collections.ss\")\n(##include \"../chez/seq.ss\")\n;; The register-*-arm! fast-type probes are LOAD-TIME SELF-CHECKS (they run\n;; each new predicate against sample values). The jrec-cl predicate probe\n;; spins on the js target (records dispatch against probe values); the\n;; invariant these checks enforce is already proven on every Chez gate run,\n;; so this target skips the probe machinery.\n(set! reject-fast-type-claim! (lambda _ #f))\n(##include \"rt-core.ss\")\n\n;; regex needs regex-translate.ss (pure; rt.ss used to preload it from java/).\n(##include \"../../vendor/irregex/irregex.scm\")\n(##include \"../chez/java/regex-translate.ss\")\n(##include \"../chez/regex.ss\")\n(##include \"../chez/atoms.ss\")\n(##include \"../chez/refs.ss\")\n(##include \"../chez/predicates.ss\")\n(##include \"../chez/converters.ss\")\n(##include \"../chez/transients.ss\")\n(##include \"../chez/natives-seq.ss\")\n(##include \"../chez/printing.ss\")\n(##include \"../chez/natives-coll.ss\")\n(##include \"../chez/natives-num.ss\")\n(##include \"../chez/multimethods.ss\")\n(##include \"../chez/java/jdk-interfaces.ss\")\n(##include \"../chez/java/class-hierarchy.ss\")\n;; Gambit has no host shims that load on first reference, so the Chez lazy-shims.ss\n;; hooks the records layer asks (an unloaded class's ctor or method) answer #f.\n(define (lazy-shims-provides? name) #f)\n(define (lazy-shims-method! name) #f)\n(##include \"records-gambit.ss\")  ;; GENERATED from records.ss (make gambitgen) — phase wall, see gen-records.ss\n(##include \"../chez/java/records-interop.ss\")\n(##include \"../chez/natives-meta.ss\")\n(##include \"../chez/java/host-class.ss\")\n(##include \"../chez/dynamic-var-defaults.ss\")\n(##include \"../chez/host-table.ss\")\n(##include \"../chez/lazy-bridge.ss\")\n(##include \"../chez/natives-transduce.ss\")\n(##include \"../chez/vars.ss\")\n(##include \"../chez/natives-misc.ss\")\n(##include \"../chez/natives-format.ss\")\n(##include \"../chez/extensions.ss\")\n(##include \"../chez/ns.ss\")\n(##include \"../chez/dyn-binding.ss\")\n(##include \"../chez/natives-reader.ss\")\n(##include \"../chez/reader.ss\")\n(##include \"../chez/syntax-quote.ss\")\n(##include \"../chez/host-contract.ss\")\n;; The interop tier: the jhost record and the registries (host-statics.ss),\n;; then the java/ files shared with Chez that register into them — Class\n;; objects and the class model core reads (class-model.ss), StringBuilder\n;; (string-builder.ss), the `.`/`.-field` dispatch arms over records, maps and\n;; transients (dot-forms.ss). Before the seed: the prelude's own (import …) forms\n;; intern through jolt-class-for (host-vars.ss, the rest of the java/ tree's\n;; names, comes after it). java-parse.ss is the NumberFormatException family\n;; Long/parseLong and its siblings raise.\n(##include \"../chez/java/java-parse.ss\")\n(##include \"host-statics.ss\")\n;; java.lang.Math and clojure.math: one portable file, shared with Chez\n(##include \"../chez/java/math.ss\")\n(##include \"../chez/java/class-model.ss\")\n(##include \"../chez/java/string-builder.ss\")\n(##include \"../chez/java/dot-forms.ss\")\n(##include \"../chez/java/jutil-colls.ss\")\n(##include \"../chez/java/tree-map.ss\")\n;; java.nio's buffers and ByteOrder, over bytevectors. The buffer array seam\n;; is excluded, so a ByteBuffer has no .array and typed buffers are views.\n(##include \"../chez/java/byte-buffer.ss\")\n(##include \"../chez/float.ss\")  ;; java.lang.Float as a value (jfloat)\nhost/gambit/gen-boot.ss:84:    (if (not (file-exists? full))\nhost/gambit/gen-boot.ss:169:    (if (file-exists? full)\nhost/gambit/host-ffi.ss:292:               (exists (guard (e (#t #f)) (file-exists? cand)))\nhost/gambit/gambitcheck.ss:110:  ;; current-directory is not the node process cwd, and command-line carries\nhost/gambit/gambitcheck.ss:114:  (if (file-exists? \"host/scheme-adapter/CONTRACT.txt\")\nhost/gambit/gambitcheck.ss:118:        (if (and sp (file-exists? sp))\nhost/gambit/host-statics.ss:205:             '(\"exists\" \"isDirectory\" \"canWrite\" \"mkdirs\"))))\nhost/gambit/host-statics.ss:271:          ((string=? k \"user.dir\") (current-directory))\nhost/gambit/host-vars.ss:69:(def-var! \"clojure.core\" \"slurp\"\nhost/gambit/host-vars.ss:75:            \"slurp on the gambit target takes a path string\")))))\nhost/gambit/host-vars.ss:77:(def-var! \"clojure.core\" \"spit\"\nhost/gambit/host-vars.ss:86:            \"spit on the gambit target takes a path string\")))))\nhost/gambit/seed-statics.ss:34:  (if (file-exists? path)\nhost/gambit/unbound-vars.ss:35:  (if (file-exists? path)\nhost/gambit/scheme-adapter-runtime.ss:353:        (if (file-exists? (car ps)) (car ps) (loop (cdr ps))))))\nhost/gambit/yin-repl-driver.ss:58:        (jolt-root (current-directory)))\nhost/gambit/yin-repl-driver.ss:59:    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\nhost/gambit/yin-repl-driver.ss:85:          (parameterize ((current-directory root))\nhost/gambit/source-loader.ss:62:                     (if (and (file-exists? file) (eq? 'regular (file-type file)))\nhost/gambit/unbound-check.ss:156:  (if (file-exists? allowlist-path)\nhost/gambit/rt-core.ss:513:  (and (file-exists? p) (eq? (file-type p) 'directory)))\nhost/gambit/rt-core.ss:1167:;; java.io.File + host file I/O: path-backed jfile record, slurp/spit/\nhost/gambit/rt-core.ss:1202:;; over Chez ports. After io.ss (extends its slurp/__close/reader-jhost?) and\nhost/gambit/rt-core.ss:1480:     (let ((cwd (or (getenv \"JOLT_PWD\") (guard (_ (#t #f)) (current-directory))))\nzsh:1: no matches found: /Users/sto/.local/share/mise/installs/babashka/*/bin/bb\ntotal 24\n-rw-r--r--@  1 sto  staff    75B Nov 22 00:25 9b1c17646f9dec86c080739961fd2c42ce634de696b4e58987aca20e78522045\ndrwx------@ 52 sto  staff   1.6K Nov 22 00:19 boot-2m6vv_t2\ndrwx------@ 52 sto  staff   1.6K Nov 22 00:31 boot-97ono01f\ndrwx------@ 52 sto  staff   1.6K Nov 22 00:25 boot-wvei78qm\n-rw-r--r--@  1 sto  staff    75B Nov 22 00:31 cafefa3899066eea2c55b6373f29e2691312e0a1f690cb5f08392f70e5f8553f\n-rw-r--r--@  1 sto  staff    75B Nov 22 00:19 e7e30dc805fcc696b65f92abcfea02a6033e5909c5556387cfba607631b3c90a\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '65,125p;160,310p;317,445p;460,486p' src/cljc/dao/space/store/fs.cljc; sed -n '80,145p;220,280p' src/cljc/dao/space/store.cljc; rg -n '(posix|\\\\.delete|\\\\.mkdir|\\\\.exists|sync-dir|defn|spit)' src/cljc/yin/repl/state.cljc | tail -48; rg -n 'Local --index-store|JOLT_GAMBIT_YIN_|jolt-gambit' src bb.edn | head -90; git rev-parse HEAD\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '65,125p;160,310p;317,445p;460,486p' src/cljc/dao/space/store/fs.cljc; sed -n '80,145p;220,280p' src/cljc/dao/space/store.cljc; rg -n '(posix|\\\\.delete|\\\\.mkdir|\\\\.exists|sync-dir|defn|spit)' src/cljc/yin/repl/state.cljc | tail -48; rg -n 'Local --index-store|JOLT_GAMBIT_YIN_|jolt-gambit' src bb.edn | head -90; git rev-parse HEAD\"","aggregated_output":"   entry (see the namespace docstring's pid-reuse contract).\"\n  \"lock\")\n\n\n(defn- refuse-locked\n  [dir]\n  (throw (ex-info (str dir \" is locked by another process\")\n                  {:dir dir})))\n\n\n(defn- read-text!\n  \"The file at `path` as text — trimmed, for one-record files read whole —\n   or nil when absent.\"\n  [path]\n  #?(:cljd (let [f (dart-io/File. path)]\n             (when (.existsSync f)\n               (str/trim (.readAsStringSync f))))\n     ;; a descriptor read, strictly decoded: absence is nil; a permission or\n     ;; I/O error, or an entry that is not a regular file, throws\n     :jolt (let [bs (posix-file/read-all path)]\n             (case bs\n               :absent nil\n               :not-regular (throw (ex-info (str path \" is not a regular file\")\n                                            {:path path}))\n               (str/trim (text/utf8-decode bs))))\n     :clj (let [f (java.io.File. ^String path)]\n            (when (.exists f) (str/trim (slurp f))))\n     :cljs (let [fs (js/require \"fs\")]\n             (when (.existsSync ^js fs path)\n               (str/trim (.readFileSync ^js fs path \"utf8\"))))))\n\n\n#?(:cljs\n   (defn- live-pid?\n     \"True when a pid names a live process — the lock file's owner is\n      alive.  A process this one may not signal (`EPERM`) is alive too.\"\n     [pid]\n     (try (.kill js/process pid 0)\n          true\n          (catch :default e\n            (= \"EPERM\" (.-code e))))))\n\n\n#?(:cljs\n   (defn- claim-entries\n     \"Every Node claim entry in the directory, as `[file-name pid]`: the\n      files `lock.<pid>.<nonce>`, each created by the one process whose\n      pid it names.\"\n     [fs dir]\n     (keep (fn [file-name]\n             (when-some [[_ pid] (re-matches #\"lock\\.(\\d+)\\.[0-9a-f-]+\"\n                                             file-name)]\n               [file-name (js/parseInt pid 10)]))\n           (.readdirSync ^js fs dir))))\n\n\n#?(:cljs\n   (defn- node-lock!\n     \"Claim the directory on Node, answering the release, or refuse.\n\n      Each contender creates its own uniquely named claim entry,\n                                     (catch :default _ nil))\n                                true)))\n                          (remove #(= own (first %)) (claim-entries fs dir)))]\n           (when (seq live)\n             (throw (ex-info (str dir \" is locked by another process\"\n                                  \" (claims: \"\n                                  (str/join \", \" (map first live)) \")\")\n                             {:dir dir :claims (mapv first live)})))\n           release!)\n         (catch :default e\n           (release!)\n           (throw e))))))\n\n\n(defonce ^:private held\n  ;; The host-ownership exception to the no-hidden-global-state invariant\n  ;; (see the namespace docstring): the canonical paths of the durable\n  ;; directories this process holds locked.\n  (atom #{}))\n\n\n(defn- canonical-dir\n  \"The directory's one canonical path: the key of this process's own\n   holdings, so two spellings of one directory are one owner.\"\n  [dir]\n  #?(:cljd (.resolveSymbolicLinksSync (dart-io/Directory. dir))\n     :jolt (posix-file/realpath dir)\n     :clj (.getCanonicalPath (java.io.File. ^String dir))\n     :cljs (.realpathSync ^js (js/require \"fs\") dir)))\n\n\n(defn- claim!\n  \"Record `key` as held by this process, answering false when it already\n   was — a second owner inside the one process, refused before it opens\n   any handle on the lock file (closing such a handle would drop this\n   process's `fcntl` lock).\"\n  [key]\n  (let [claimed? (volatile! false)]\n    (swap! held (fn [keys]\n                  (vreset! claimed? (not (contains? keys key)))\n                  (conj keys key)))\n    @claimed?))\n\n\n(defn- host-lock!\n  \"Take the host's exclusive lock on `path`, answering its release\n   function, or refuse naming the directory.\"\n  #_{:clj-kondo/ignore [:unused-binding]}\n  [dir path claimed]\n  #?(:cljd (let [raf (.openSync (dart-io/File. path)\n                                .mode dart-io/FileMode.append)]\n             (try\n               (.lockSync raf)\n               (fn []\n                 (try (.unlockSync raf) (catch Object _ nil))\n                 (try (.closeSync raf) (catch Object _ nil)))\n               (catch Object _\n                 (try (.closeSync raf) (catch Object _ nil))\n                 (refuse-locked dir))))\n     ;; the JVM's FileChannel.tryLock in the same family: a whole-file\n     ;; fcntl(F_SETLK) write lock, close-on-exec; held elsewhere refuses after\n     ;; closing this handle only, and the release is that one close\n     :jolt (let [h (posix-file/lock-file! path)]\n             (if (= :held h)\n               (refuse-locked dir)\n               (fn []\n                 (try (posix-file/close! h) (catch Throwable _ nil)))))\n     :clj (let [f (java.io.RandomAccessFile. ^String path \"rw\")]\n            (try\n              (let [fl (try (.tryLock (.getChannel f))\n                            (catch java.nio.channels.OverlappingFileLockException _\n                              nil))]\n                (if (nil? fl)\n                  (do (.close f)\n                      (refuse-locked dir))\n                  (fn []\n                    (try (.release ^java.nio.channels.FileLock fl)\n                         (catch Exception _ nil))\n                    (try (.close f)\n                         (catch Exception _ nil)))))\n              (catch Throwable t\n                (try (.close f) (catch Exception _ nil))\n                (throw t))))\n     :cljs (node-lock! dir claimed)))\n\n\n(defn lock!\n  \"Acquire the exclusive lock of the durable store directory, or refuse\n   naming the directory — whether the other owner is another process or\n   this one. The answer is a plain release; closing whatever the host\n   needs closed is all releasing takes.\n\n   `claimed`, `(fn [])`, runs on Node once this process's claim entry\n   exists and before it reads the others — the window a concurrent\n   contender can race — so the tests can interleave one there.\"\n  ([dir] (lock! dir {}))\n  ([dir {:keys [claimed]}]\n   (let [key (canonical-dir dir)]\n     (when-not (claim! key)\n       (refuse-locked dir))\n     (let [release! (try (host-lock! dir (str dir \"/\" lock-name) claimed)\n                         (catch #?(:cljd Object\n                                   :clj Throwable\n                                   :cljs :default)\n                                e\n                           (swap! held disj key)\n                           (throw e)))\n           released? (volatile! false)]\n       {:release! (fn []\n                    (when-not @released?\n                      (vreset! released? true)\n                      (release!)\n                      (swap! held disj key)))}))))\n\n\n(defn unlock!\n  \"Release a lock `lock!` answered. Idempotent: a released lock releases\n   again as a no-op, never a later owner's lock of the same directory.\"\n  [lock]\n  (when-let [release! (:release! lock)]\n    (release!)))\n\n\n(defn directory-sync-supported?\n  \"True when this host can open a directory and fsync it, so a HEAD\n   replacement's rename can be made durable, not merely visible: Node\n   and the JVM on POSIX systems can; Windows cannot open a directory for\n   sync, and Dart's core has no directory sync at all.\"\n  []\n  #?(:cljd false\n     :jolt true ; macOS and Linux only (the qualified jolt platforms)\n     :clj (not (str/starts-with? (str (System/getProperty \"os.name\"))\n                                 \"Windows\"))\n     :cljs (not= \"win32\" (.-platform js/process))))\n\n\n(defn- sync-failure\n  [dir e]\n  (ex-info (str \"cannot sync the directory \" dir \" after the rename: \" e)\n           {:dir dir}\n           e))\n\n\n#?(:cljs\n   (defn- sync-directory!\n     \"Sync the directory entry itself where the host supports it — the\n      rename is durable, not merely visible.  There, a failure throws: a\n      replacement whose directory entry is not known durable is not\n      reported done.\"\n     [fs dir]\n     (when (directory-sync-supported?)\n\n\n#?(:cljd nil\n   :jolt\n   (defn- sync-directory!\n     \"Sync the directory entry itself (open, fsync, close): the rename is\n      durable, not merely visible.  A failure throws; it never turns the\n      host into one without directory sync.\"\n     [dir]\n     (when (directory-sync-supported?)\n       (try (posix-file/sync-dir! dir)\n            (catch Throwable e\n              (throw (sync-failure dir e))))))\n   :clj\n   (defn- sync-directory!\n     \"Sync the directory entry itself where the host supports it — the\n      rename is durable, not merely visible.  There, a failure throws: a\n      replacement whose directory entry is not known durable is not\n      reported done.\"\n     [dir]\n     (when (directory-sync-supported?)\n       (try (with-open [ch (java.nio.channels.FileChannel/open\n                             (java.nio.file.Paths/get ^String dir\n                                                      (make-array String 0))\n                             ^\"[Ljava.nio.file.OpenOption;\"\n                             (into-array java.nio.file.OpenOption\n                                         [java.nio.file.StandardOpenOption/READ]))]\n              (.force ch true))\n            (catch Exception e\n              (throw (sync-failure dir e)))))))\n\n\n#?(:cljs\n   (defn- write-fully!\n     \"Write every byte of `buf` to `fd`.  `writeSync` may store fewer\n      bytes than asked and says how many in its answer, so the rest is\n      written from there until none remain; a write that stores nothing\n      fails rather than looping.  (The JVM's `OutputStream.write(byte[])`\n      and Dart's `writeAsStringSync` write the whole buffer or throw.)\"\n     [fs fd buf]\n     (loop [offset 0]\n       (when (< offset (.-length buf))\n         (let [written (.writeSync ^js fs fd buf offset\n                                   (- (.-length buf) offset))]\n           (when-not (pos? written)\n             (throw (ex-info \"the write stored no bytes\"\n                             {:offset offset :length (.-length buf)})))\n           (recur (+ offset written)))))))\n\n\n(defn atomic-replace!\n  \"Replace `<dir>/<name>` with `text` atomically: write the whole record\n   to a temp file beside it, sync the temp, rename it over the target,\n   and sync the directory where the host supports it — a failed\n   directory sync fails the replacement. A reader observes either the\n   whole previous record or the whole new one, never a partial write.\n\n   `before-rename`, `(fn [temp-path])`, runs in the one window a crash\n   can interrupt — after the temp is synced, before the rename — so a\n   test can interrupt the replacement there; a throw leaves the target\n   exactly as it was.\"\n  ([dir name text] (atomic-replace! dir name text {}))\n  ([dir name text {:keys [before-rename]}]\n   (let [target (str dir \"/\" name)\n         temp (str dir \"/\" name \".tmp-\" (random-uuid))]\n     #?(:cljd (try (.writeAsStringSync (dart-io/File. temp) text .flush true)\n                   (when before-rename (before-rename temp))\n                   (.renameSync (dart-io/File. temp) target)\n                   (catch Object e\n                     (throw (ex-info (str \"cannot replace \" target \": \" e)\n                                     {:dir dir :target target}\n                                     e))))\n        ;; temp (O_CREAT | O_EXCL, 0666 under the umask) -> write-all ->\n        ;; fsync -> close -> before-rename -> rename -> directory sync\n        :jolt (try (posix-file/write-new-synced! temp (text/utf8-encode text))\n                   (when before-rename (before-rename temp))\n                   (posix-file/rename! temp target)\n                   (sync-directory! dir)\n                   (catch Throwable e\n                     (throw (ex-info (str \"cannot replace \" target \": \" e)\n                                     {:dir dir :target target}\n                                     e))))\n        :clj (try (with-open [out (java.io.FileOutputStream. ^String temp)]\n                    (.write out (.getBytes ^String text \"UTF-8\"))\n                    (.flush out)\n                    (.sync (.getFD out)))\n                  (when before-rename (before-rename temp))\n                  (java.nio.file.Files/move\n                    (java.nio.file.Paths/get temp (make-array String 0))\n                    (java.nio.file.Paths/get target (make-array String 0))\n                    (into-array java.nio.file.StandardCopyOption\n                                [java.nio.file.StandardCopyOption/ATOMIC_MOVE\n                                 java.nio.file.StandardCopyOption/REPLACE_EXISTING]))\n                  (sync-directory! dir)\n                  (catch Throwable e\n                    (throw (ex-info (str \"cannot replace \" target \": \" e)\n                                    {:dir dir :target target}\n                                    e))))\n        :cljs (let [fs (js/require \"fs\")]\n                (try (let [fd (.openSync ^js fs temp \"w\")]\n                       (try (write-fully! fs fd (js/Buffer.from text \"utf8\"))\n                            (.fsyncSync ^js fs fd)\n                            (finally\n                              (.closeSync ^js fs fd))))\n                     (when before-rename (before-rename temp))\n                     (.renameSync ^js fs temp target)\n                     (sync-directory! fs dir)\n                     (catch :default e\n                       (throw (ex-info (str \"cannot replace \" target \": \" e)\n                                       {:dir dir :target target}\n                                       e)))))))))\n\n\n(defn read-file-text\n  \"The file `<dir>/<name>` as text, or nil when absent — the public read\n   the store's HEAD parsing uses.\"\n  [dir name]\n  (read-text! (str dir \"/\" name)))\n\n\n(defn- not-regular\n  []\n  (ex-info \"it is not a regular file\" {}))\n\n\n(defn read-bounded\n  \"At most `limit` bytes of the file at `path`, one more when it holds\n   more, or nil when no entry exists there.  Never reads the whole of a\n   larger file into memory, and never opens what is not a regular file\n             (cond\n               (= t dart-io/FileSystemEntityType.notFound)\n               ;; a dangling link is an entry, not absence\n               (when (.existsSync (dart-io/Link. path))\n                 (throw (not-regular)))\n\n               (not= t dart-io/FileSystemEntityType.file)\n               (throw (not-regular))\n\n               :else\n               (let [raf (.openSync (dart-io/File. path))]\n                 (try (.readSync raf (inc limit))\n                      (finally (.closeSync raf))))))\n     :jolt (let [bs (posix-file/read-bounded path limit)]\n             ;; classify (lstat, stat), then a non-blocking open rechecked\n             ;; by fstat: a FIFO swapped in never blocks\n             (case bs\n               :absent nil\n               :not-regular (throw (not-regular))\n               bs))\n     :clj (let [p (java.nio.file.Paths/get path (make-array String 0))]\n            (cond\n              (java.nio.file.Files/notExists\n                p (into-array java.nio.file.LinkOption\n                              [java.nio.file.LinkOption/NOFOLLOW_LINKS]))\n              nil\n\n(defn content-path\n  \"The content log's own path inside the store directory:\n   `<dir>/content.jing`.\"\n  [dir]\n  (let [base (without-trailing-separator dir)]\n    (if (str/blank? base)\n      (str \"/\" content-name)\n      (str base \"/\" content-name))))\n\n\n(defn- error-text\n  \"The host error's own message, for the tail of a refusal.\"\n  [e]\n  #?(:cljd (str e)\n     :clj (or (ex-message e) (str e))\n     :cljs (or (ex-message e) (str e))))\n\n\n(defn- dir-refusal\n  \"Why `dir` cannot hold the durable content log, or nil when it can: a\n   path occupied by something that is not a directory, a directory this\n   process cannot write, or a directory that cannot be created.  Nothing\n   is opened here — the content log itself is opened later, and its open\n   failure is refused with its own reason.\"\n  [dir]\n  #?(:cljd (let [d (dart-io/Directory. dir)\n                 f (dart-io/File. dir)]\n             (cond\n               (.existsSync d) nil\n               (.existsSync f) (str dir \" is not a directory\")\n               :else (try (.createSync d .recursive true)\n                          nil\n                          (catch Object e\n                            (str \"cannot create \" dir \": \" (error-text e))))))\n     :clj (let [f (java.io.File. dir)]\n            (cond\n              (and (.exists f) (not (.isDirectory f)))\n              (str dir \" is not a directory\")\n\n              (and (.isDirectory f) (not (.canWrite f)))\n              (str dir \" is not writable\")\n\n              :else\n              (try (when (and (not (.isDirectory f)) (not (.mkdirs f)))\n                     (str \"cannot create \" dir))\n                   (catch Exception e\n                     (str \"cannot create \" dir \": \" (error-text e))))))\n     :cljs (let [fs (js/require \"fs\")]\n             (if (.existsSync fs dir)\n               (when-not (.isDirectory (.statSync fs dir))\n                 (str dir \" is not a directory\"))\n               (try (.mkdirSync fs dir #js {:recursive true})\n                    nil\n                    (catch :default e\n                      (str \"cannot create \" dir \": \" (error-text e))))))))\n\n\n(defn file-refusal\n  \"Why a `file:<dir>` store cannot open, or nil when it can: a host without\n   file support is named first — never answered with a memory fallback —\n   then the directory's own refusal.  The one-argument arity asks this\n   build's own capability; the two-argument one answers for the capability\n   it is handed, which is how the unsupported-host refusal is tested on\n   hosts that do have file support.\"\n  ([dir] (file-refusal (host-file-support) dir))\n  ([capable? dir]\n                           (error-text e))\n                      {:dir dir :manifest manifest-address}\n                      e)))))\n\n\n(defn- open-locked-dir\n  \"Open the durable directory as its one owner: take the lock before\n   anything else in the directory is touched, then open the content log,\n   read HEAD, and walk the snapshot it names.  Every failure after the\n   lock closes the content log it opened and releases the lock again, so\n   a refused startup never leaves this process holding a directory it\n   did not open.\"\n  [dir]\n  (let [lock (fs/lock! dir)\n        opened (volatile! nil)]\n    (try\n      (let [handle (try (jing.file/create-content-file (content-path dir))\n                        (catch #?(:cljd Object\n                                  :clj Exception\n                                  :cljs :default)\n                               e\n                          (throw (ex-info (str \"cannot open the index store at \"\n                                               (content-path dir) \": \"\n                                               (error-text e))\n                                          {:dir dir}\n                                          e))))\n            _ (vreset! opened handle)\n            manifest (recovered-head dir)\n            datoms (when manifest\n                     (validated-snapshot handle dir manifest))]\n        {:handle handle\n         :lock lock\n         :recovery {:manifest manifest\n                    :datoms datoms}})\n      (catch #?(:cljd Object\n                :clj Throwable\n                :cljs :default)\n             e\n        (when-some [close-content! (:close-fn @opened)]\n          (try (close-content!)\n               (catch #?(:cljd Object\n                         :clj Throwable\n                         :cljs :default)\n                      _\n                 nil)))\n        (fs/unlock! lock)\n        (throw e)))))\n\n\n(defn lock-releasing-close\n  \"The durable handle's `:close-fn`: close the content log, then release\n   the directory lock `lock` — released even when the close throws, so a\n   failed close never keeps a live process holding the directory.\"\n  [close-content! lock]\n  (fn []\n    (try\n      (close-content!)\n      (finally\n        (fs/unlock! lock)))))\n\n\n25:                       [dao.posix.file :as posix-file]])\n31:(defn parse-trust\n74:(defn flag-table\n101:(defn- value-of\n111:(defn split-args\n145:(defn flags->args\n159:(defn resolve-flags\n167:(defn changed\n177:(defn describe\n191:(defn- config-key\n196:(defn- refuse\n202:(defn- text->config\n248:(defn path\n254:(defn- read-text\n271:                              (.existsSync (dart-io/Link. path)))\n276:     :jolt (when-not (= :absent (posix-file/classify path false))\n277:             (let [bs (posix-file/read-all path)]\n302:(defn load-flags\n320:(defn- mkdirs!\n323:     :clj (.mkdirs (java.io.File. ^String dir))\n324:     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n327:(defn- render\n340:(defn save!\nsrc/dev/gambit_ffi_cache.clj:64:  (.println System/err (str \"jolt-gambit: \" message \" [600 s watchdog]\"))\nsrc/dev/gambit_ffi_cache.clj:85:    (.println System/err \"jolt-gambit: Verifying pinned FFI sources and toolchain\")\nsrc/dev/gambit_ffi_cache.clj:119:            (do (.println System/err \"jolt-gambit: FFI bridge cache hit (digests verified)\")\nsrc/dev/gambit_ffi_cache.clj:160:              (.println System/err \"jolt-gambit: Staged digest-verified FFI artifacts for this boot\")\nsrc/dev/yin_repl_launch.clj:12:(def ^:private backends #{\"jvm\" \"node\" \"dart\" \"jolt-chez\" \"jolt-gambit\"})\nsrc/dev/yin_repl_launch.clj:16:  \"programmatic Transit peer — input is Transit-encoded lines (machine protocol); for an interactive REPL use --backend jvm, node, jolt-chez, or jolt-gambit\")\nsrc/dev/yin_repl_launch.clj:20:  \"Local --index-store mem session; no :yang/python frontend or WebSocket serving.\")\nsrc/dev/yin_repl_launch.clj:33:  (str \"Usage: bb yin-repl [--backend jvm|node|dart|jolt-chez|jolt-gambit] [yin args...]\nsrc/dev/yin_repl_launch.clj:39:  jolt-gambit  \" gambit-capabilities \"\nsrc/dev/yin_repl_launch.clj:152:        _ (.println System/err \"jolt-gambit: Checking compiled Yin boot (a cold build can take several minutes)\")\nsrc/dev/yin_repl_launch.clj:160:    (.println System/err (str \"jolt-gambit  \" gambit-capabilities))\nsrc/dev/yin_repl_launch.clj:164:    (jolt-session :gambit {\"JOLT_GAMBIT_YIN_BOOT\" boot\nsrc/dev/yin_repl_launch.clj:186:    \"jolt-gambit\" (gambit-session args)))\nsrc/cljc/yin/vm/docs/yin.repl.md:69:bb yin-repl --backend jolt-gambit # compiled Yin boot cached in build/gambit-yin/\nsrc/cljc/yin/vm/docs/yin.repl.md:72:`jolt-gambit` runs a REAL Yin session under the Gambit backend (the compiled\nsrc/cljc/yin/vm/docs/yin.repl.md:84:`jolt-gambit` = core Yin (Clojure frontend, yin.vm, qualified FFI) with\nsrc/cljc/yin/vm/docs/yin.repl.md:226:- **Gambit boundary (`jolt-gambit`, owner ruling C4):**\nsrc/cljc/yin/vm/docs/yin.repl.md:227:  - On `jolt-gambit`, `(use-store \"mem\")` (or `:mem`) on a quiesced session opens a fresh in-memory store and preserves the Gambit host modules (`jolt.ffi` and `dao.jing.mem`; re-require them in the rebuilt session before calling their exports).\n7f4898f474d02dc127e5e484254bc44ae7ff88f6\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat host/gambit/yin-repl-driver.ss; cat host/gambit/build-yin-boot.py; rg -n 'irregex|include.*host-vars|host-ffi' host/gambit/boot.ss; cat test/gambit/yin-repl-session.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat host/gambit/yin-repl-driver.ss; cat host/gambit/build-yin-boot.py; rg -n 'irregex|include.*host-vars|host-ffi' host/gambit/boot.ss; cat test/gambit/yin-repl-session.sh\"","aggregated_output":";; The native and interpreted boots use the same source loader and Yin owner.\n(##include \"host-apply.ss\")\n(##include \"source-loader.ss\")\n(##include \"unbound-vars-lib.ss\")\n(##include \"yin/blake3.ss\")\n\n(define (gambit-yin-random-bytes size)\n  (let* ((n (jnum->exact size))\n         (out (make-u8vector n)))\n    (call-with-input-file \"/dev/urandom\"\n      (lambda (port)\n        (unless (= (read-subu8vector out 0 n port) n)\n          (error \"Gambit could not read OS entropy\"))))\n    out))\n\n;; A single outstanding request keeps the input reader from filling the\n;; mailbox. Only Yin's owner interprets submitted lines.\n(define (gambit-yin-wake)\n  (vector\n    (thread-start!\n      (make-thread\n        (lambda ()\n          (let loop ()\n            (let* ((owner (thread-receive))\n                   (line (read-line)))\n              (thread-send owner (if (eof-object? line) jolt-nil line))\n              (unless (eof-object? line) (loop)))))))\n    #f))\n\n(define (gambit-yin-close-wake! wake)\n  (thread-terminate! (vector-ref wake 0))\n  jolt-nil)\n\n(define (gambit-yin-wait-input! wake ms on-line)\n  (let ((seconds (/ ms 1000.0)))\n    (if (jolt-nil? on-line)\n        (thread-sleep! seconds)\n        (begin\n          (unless (vector-ref wake 1)\n            (thread-send (vector-ref wake 0) (current-thread))\n            (vector-set! wake 1 #t))\n          (let ((line (thread-receive seconds #f)))\n            (when line\n              (vector-set! wake 1 #f)\n              (jolt-invoke on-line line))))))\n  jolt-nil)\n\n(set! jolt-random-bytes gambit-yin-random-bytes)\n(register-class-statics! \"System\"\n  (list (cons \"currentTimeMillis\" gambit-epoch-ms)\n        (cons \"exit\" (lambda (status) (exit (jnum->exact status))))))\n\n(let ((args (cdr (command-line))))\n  (unless (pair? args)\n    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\n    (exit 2))\n  (let ((root (path-expand (car args)))\n        (jolt-root (current-directory)))\n    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\n      (fprintf (current-error-port) \"yin.repl: no source entry under ~a\\n\" root)\n      (exit 2))\n    (with-exception-catcher\n      (lambda (e)\n        (let* ((value (jolt-unwrap-throw e))\n               (message (jolt-throwable-message value))\n               (location (jolt-current-source-string)))\n          (fprintf (current-error-port) \"yin.repl startup failed: ~a\\n\"\n                   (if (string? message) message (jolt-pr-readable value)))\n          (when (and (string? location) (not (string=? location \"\")))\n            (fprintf (current-error-port) \"Yin source: ~a\\n\" location))\n          (exit 1)))\n      (lambda ()\n        ;; Cache the qualified bridge before resolving Yin's paths relative to\n        ;; its own checkout. The source loader itself uses absolute roots.\n        (joltffi-ensure-bridge! 'yin.repl)\n        (let ((load-ns\n                (gambit-install-source-loader!\n                  (list (list (path-expand \"host/gambit/yin\" jolt-root) \".jolt\")\n                        (list (path-expand \"src/jolt\" root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"src/cljc\" root) \".cljc\" \".clj\")\n                        (list (path-expand \"src/clj\" root) \".clj\")\n                        (list (path-expand \"stdlib\" jolt-root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"jolt-core\" jolt-root) \".cljc\" \".clj\"))\n                  '(\"clojure.core\"))))\n          (parameterize ((current-directory root))\n            (let* ((audit? (getenv \"JOLT_YIN_AUDIT\" #f))\n                   (before (and audit? (unbound-var-names))))\n              (dynamic-wind\n                (lambda () #f)\n                (lambda () (load-ns \"jolt.gambit.yin\" #f))\n                (lambda ()\n                  (when audit?\n                    (let ((added (filter (lambda (name) (not (member name before)))\n                                         (unbound-var-names))))\n                      (fprintf (current-error-port) \"yin source var audit: ~a newly unbound\\n\"\n                               (length added))\n                      (for-each (lambda (name) (fprintf (current-error-port) \"  ~a\\n\" name))\n                                added))))))\n            (def-var! \"yin.repl\" \"host-text\" (string-append \"Host: jolt / Gambit \" (system-version-string)))\n            (let ((main (var-deref \"jolt.gambit.yin\" \"-main\")))\n              (unless (procedure? main)\n                (error \"jolt.gambit.yin/-main did not load\"))\n              (apply jolt-invoke main (cdr args)))))))))\n#!/usr/bin/env python3\n\"\"\"Compile Jolt's existing Gambit boot for the Yin loaded-source gate.\"\"\"\nfrom concurrent.futures import ThreadPoolExecutor\nimport fcntl\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\n\nINCLUDE = re.compile(r'(?m)^([ \\t]*)\\(##include \"([^\"]+)\"\\)')\nREPO = Path(__file__).resolve().parents[2]\nBOOT = REPO / \"host/gambit/boot.ss\"\nSEEDS = {\"seed/prelude.ss\": (\"prelude\", 120), \"seed/image.ss\": (\"compiler\", 125)}\n\n\ndef boot_sources(path, seen):\n    if path in seen:\n        return\n    seen.add(path)\n    text = path.read_text()\n    yield path, text\n    for match in INCLUDE.finditer(text):\n        yield from boot_sources((path.parent / match[2]).resolve(), seen)\n\n\ndef write_units(directory):\n    units = []\n\n    def rewrite(match):\n        indent, relative = match.groups()\n        path = (BOOT.parent / relative).resolve()\n        if relative not in SEEDS:\n            return f'{indent}(##include {json.dumps(str(path), ensure_ascii=False)})'\n        prefix, chunk_size = SEEDS[relative]\n        # The seed emitter writes each guarded top-level form at column zero.\n        forms = re.split(r'(?m)(?=^\\(guard )', path.read_text())\n        if forms[0].strip():\n            raise ValueError(f\"Unexpected seed format in {path}\")\n        forms = forms[1:]\n        loads = []\n        for start in range(0, len(forms), chunk_size):\n            unit = directory / f\"{prefix}-{start // chunk_size:02d}.ss\"\n            unit.write_text(\"\".join(forms[start:start + chunk_size]))\n            units.append(unit)\n            artifact = json.dumps(str(unit.with_suffix(\".o1\")), ensure_ascii=False)\n            loads.append(f\"{indent}(load {artifact})\")\n        return \"\\n\".join(loads)\n\n    kernel = directory / \"kernel.ss\"\n    kernel.write_text(INCLUDE.sub(rewrite, BOOT.read_text()))\n    return [kernel, *units]\n\n\ndef build(gsc, cache):\n    digest = hashlib.sha256(Path(__file__).read_bytes())\n    digest.update(gsc.read_bytes())\n    for path, text in sorted(boot_sources(BOOT, set())):\n        digest.update(str(path).encode())\n        digest.update(text.encode())\n    key = digest.hexdigest()\n    cache.mkdir(parents=True, exist_ok=True)\n    pointer = cache / key\n\n    with (cache / \".lock\").open(\"a\") as lock:\n        fcntl.flock(lock, fcntl.LOCK_EX)\n        if pointer.exists():\n            kernel = Path(pointer.read_text().strip())\n            if kernel.is_file():\n                return kernel\n\n        directory = Path(tempfile.mkdtemp(prefix=\"boot-\", dir=cache))\n        units = write_units(directory)\n\n        def compile_unit(unit):\n            # The kernel alone expands to a large C translation unit.\n            options = [\"-:min-heap=768M\"] if unit == units[0] else []\n            subprocess.run([str(gsc), *options, \"-dynamic\", \"-cc-options\", \"-O0\", unit.name],\n                           cwd=directory, stdout=sys.stderr, check=True)\n            if not unit.with_suffix(\".o1\").is_file():\n                raise RuntimeError(f\"Gambit did not produce an object for {unit}\")\n\n        with ThreadPoolExecutor(max_workers=2) as executor:\n            list(executor.map(compile_unit, units))\n\n        kernel = units[0].with_suffix(\".o1\")\n        pending = directory / \"cache-entry\"\n        pending.write_text(f\"{kernel}\\n\")\n        pending.replace(pointer)\n        return kernel\n\n\nif __name__ == \"__main__\":\n    print(build(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve()))\n14:;; java interop. vendor/irregex is NOT under host/chez and loads normally.\n19:               ;; irregex is ##include'd below (the js target has no\n21:               (string-prefix? \"vendor/irregex/\" path)))\n48:(##include \"../../vendor/irregex/irregex.scm\")\n129:(##include \"host-vars.ss\")\n134:(##include \"host-ffi.ss\")\n#!/bin/sh\n# Drive the upstream Yin entry point. A shell exit status alone never passes.\nset -eu\n\ngsi=$1\nyin_root=$2\nlauncher=${3:-host/gambit/yin-repl-main.ss}\ntranscript=$(mktemp)\ntrap 'rm -f \"$transcript\"' EXIT\n\nstatus=0\nsh host/gambit/ffi/watchdog.sh 2400 \"$gsi\" \"$launcher\" \\\n  \"$yin_root\" --no-state --index-store mem >\"$transcript\" <<'FORMS' || status=$?\n(+ 1 2)\n((fn [x] (* x x)) 7)\n(def p1c-score 100)\n(+ p1c-score 1)\n(/ 1 0)\n(lang :yang/python)\n(require 'jolt.ffi)\n(jolt.ffi/sizeof :int32)\n(require 'dao.jing.mem)\n(dao.jing.mem/materialize-sha256 {:witness 1})\n(+ 21 22)\n(quit)\nFORMS\ncat \"$transcript\"\nif [ \"$status\" -ne 0 ]; then\n  echo \"gambityinrepl: a complete Yin session was not observed (status $status)\" >&2\n  exit 1\nfi\n\n# Each line must follow the previous one, with prompts on the actual replies.\nawk '\n  /^yin> 3$/ && step == 0 { step++; next }\n  /^yin> 49$/ && step == 1 { step++; next }\n  /^yin> 100$/ && step == 2 { step++; next }\n  /^yin> 101$/ && step == 3 { step++; next }\n  /^yin> Error: .*[Dd]ivid(e|ed) by zero/ && step == 4 { step++; next }\n  /^yin> Error: unavailable-parser: Yin REPL language :yang\\/python/ && step == 5 { step++; next }\n  /^yin> \\047jolt[.]ffi$/ && step == 6 { step++; next }\n  /^yin> 4$/ && step == 7 { step++; next }\n  /^yin> \\047dao[.]jing[.]mem$/ && step == 8 { step++; next }\n  /^yin> Error: .*blocking ffi is unsupported on the gambit target/ && step == 9 { step++; next }\n  /^yin> 43$/ && step == 10 { step++; next }\n  /^yin> Bye$/ && step == 11 { step++; next }\n  /^yin> / { unexpected = 1 }\n  END { exit !(step == 12 && !unexpected) }\n' \"$transcript\" || {\n  echo \"gambityinrepl: the Yin session did not produce the expected replies\" >&2\n  exit 1\n}\necho \"gambityinrepl: PASS — Yin state, evaluation error, frontend refusal, FFI, blocking refusal, and clean quit\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'Local --index-store|JOLT_GAMBIT_YIN_|jolt-gambit' src bb.edn; sed -n '1,110p' src/cljc/yin/repl/store.cljc; sed -n '240,355p' src/cljc/yin/repl/state.cljc; sed -n '560,670p' src/cljc/yin/repl/main.cljc; ls /opt/homebrew/bin | rg 'bb|babashka|chez'; git rev-parse HEAD\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'Local --index-store|JOLT_GAMBIT_YIN_|jolt-gambit' src bb.edn; sed -n '1,110p' src/cljc/yin/repl/store.cljc; sed -n '240,355p' src/cljc/yin/repl/state.cljc; sed -n '560,670p' src/cljc/yin/repl/main.cljc; ls /opt/homebrew/bin | rg 'bb|babashka|chez'; git rev-parse HEAD\"","aggregated_output":"src/dev/gambit_ffi_cache.clj:64:  (.println System/err (str \"jolt-gambit: \" message \" [600 s watchdog]\"))\nsrc/dev/gambit_ffi_cache.clj:85:    (.println System/err \"jolt-gambit: Verifying pinned FFI sources and toolchain\")\nsrc/dev/gambit_ffi_cache.clj:119:            (do (.println System/err \"jolt-gambit: FFI bridge cache hit (digests verified)\")\nsrc/dev/gambit_ffi_cache.clj:160:              (.println System/err \"jolt-gambit: Staged digest-verified FFI artifacts for this boot\")\nsrc/dev/yin_repl_launch.clj:12:(def ^:private backends #{\"jvm\" \"node\" \"dart\" \"jolt-chez\" \"jolt-gambit\"})\nsrc/dev/yin_repl_launch.clj:16:  \"programmatic Transit peer — input is Transit-encoded lines (machine protocol); for an interactive REPL use --backend jvm, node, jolt-chez, or jolt-gambit\")\nsrc/dev/yin_repl_launch.clj:20:  \"Local --index-store mem session; no :yang/python frontend or WebSocket serving.\")\nsrc/dev/yin_repl_launch.clj:33:  (str \"Usage: bb yin-repl [--backend jvm|node|dart|jolt-chez|jolt-gambit] [yin args...]\nsrc/dev/yin_repl_launch.clj:39:  jolt-gambit  \" gambit-capabilities \"\nsrc/dev/yin_repl_launch.clj:152:        _ (.println System/err \"jolt-gambit: Checking compiled Yin boot (a cold build can take several minutes)\")\nsrc/dev/yin_repl_launch.clj:160:    (.println System/err (str \"jolt-gambit  \" gambit-capabilities))\nsrc/dev/yin_repl_launch.clj:164:    (jolt-session :gambit {\"JOLT_GAMBIT_YIN_BOOT\" boot\nsrc/dev/yin_repl_launch.clj:186:    \"jolt-gambit\" (gambit-session args)))\nsrc/cljc/yin/vm/docs/yin.repl.md:69:bb yin-repl --backend jolt-gambit # compiled Yin boot cached in build/gambit-yin/\nsrc/cljc/yin/vm/docs/yin.repl.md:72:`jolt-gambit` runs a REAL Yin session under the Gambit backend (the compiled\nsrc/cljc/yin/vm/docs/yin.repl.md:84:`jolt-gambit` = core Yin (Clojure frontend, yin.vm, qualified FFI) with\nsrc/cljc/yin/vm/docs/yin.repl.md:226:- **Gambit boundary (`jolt-gambit`, owner ruling C4):**\nsrc/cljc/yin/vm/docs/yin.repl.md:227:  - On `jolt-gambit`, `(use-store \"mem\")` (or `:mem`) on a quiesced session opens a fresh in-memory store and preserves the Gambit host modules (`jolt.ffi` and `dao.jing.mem`; re-require them in the rebuilt session before calling their exports).\n(ns yin.repl.store\n  \"Selection of the code index's store\n   (docs/design/yin.repl.dao.space-index.md; the durable-store startup\n   contract, slices 1-3).\n\n   The store is chosen at startup or at a quiesced prompt: `mem` — a fresh\n   in-memory `dao.jing` store, today's behaviour — or `file:<dir>`, the\n   durable directory store (dao.space.store).  This namespace parses the\n   `--index-store` value, validates the `:index-store-spec` an embedder\n   may hand `yin.repl/create-state`, and opens the store the resolved\n   spec names.  Every bad spec — a missing value, an unknown scheme, an\n   empty directory, a directory that cannot be opened, a host build\n   without file support — is refused with its reason; nothing falls back\n   to memory silently.\n\n   What it answers is a generic `dao.jing` content handle and nothing\n   more: no transport state, no node, no storage implementation the\n   engine could reach through it.  A storage implementation past `:mem`\n   and `{:type :file :dir dir}` is a composition's, never this\n   namespace's (docs/design/yin.repl.dht-composition.md sections 2, 3 and\n   6).  Such a composition opens its own store and hands the engine the\n   prepared handle as `:index-store`; it may also register its own\n   `--index-store` scheme here, as plain data (`parse-arg`'s second\n   argument), so the engine's parser knows a prefix and a label and never\n   a backend.\n\n   The durable directory itself — the exclusive lock, HEAD, the validated\n   snapshot, `:recovery` — is dao.space.store's; this namespace is one of\n   its consumers.  The shell installs the recovery before it admits any\n   evaluation (`yin.repl.index/rehydrate`), and a store whose index\n   outlives the process also carries it across `(reset)` and VM\n   selection; the memory store keeps today's empty rebuild.  That\n   retention is a declared policy, not something the engine derives from\n   a backend's own state (`retain-on-reset?`).\"\n  (:require [clojure.string :as str]\n            [dao.jing.mem :as jing.mem]\n            [dao.space.store :as durable]))\n\n\n(def file-scheme\n  \"The `--index-store` scheme prefix naming a durable file store.\"\n  \"file:\")\n\n\n(defn describe-spec\n  \"Display an engine store spec, or nil for an absent or unknown spec.\"\n  [spec]\n  (cond\n    (= :mem spec) \"mem\"\n    (and (map? spec) (= :file (:type spec))\n         (string? (:dir spec)) (not (str/blank? (:dir spec))))\n    (str file-scheme (:dir spec))))\n\n\n(defn- supported-text\n  \"The supported `--index-store` forms as one comma-separated string:\n   this namespace's own, then every registered scheme's label in order.\"\n  [extra-schemes]\n  (str/join \", \"\n            (into [\"mem\" (str file-scheme \"<dir>\")]\n                  (map :label)\n                  extra-schemes)))\n\n\n(defn parse-arg\n  \"The `--index-store` value as a spec: `:mem`, or `{:type :file :dir dir}`\n   for `file:<dir>`.  A missing value, an unknown scheme, and an empty\n   directory are refused here — with the supported forms named — so the\n   arguments parser can refuse a bad flag before anything composes.\n\n   `extra-schemes` registers the schemes a storage composition adds, each\n   `{:prefix \\\"<scheme>:\\\" :label \\\"<as documented>\\\" :parse (fn [dir]\n   spec)}`.  They are plain data: this namespace matches a prefix and\n   calls `:parse` with the directory, and never learns what the answer\n   means.  A composition's own checked spec then validates it\n   (`checked-spec` refuses a type it does not know, so a registered\n   scheme whose spec reaches the engine unchecked is still refused).\"\n  ([value] (parse-arg value nil))\n  ([value extra-schemes]\n   (let [supported (supported-text extra-schemes)\n         extra (when (string? value)\n                 (some (fn [{:keys [prefix parse]}]\n                         (when (str/starts-with? value prefix)\n                           (let [dir (subs value (count prefix))]\n                             (if (str/blank? dir)\n                               (throw (ex-info (str \"--index-store \" prefix\n                                                    \"<dir> needs a directory\")\n                                               {:value value\n                                                :supported supported}))\n                               (parse dir)))))\n                       extra-schemes))]\n     (cond\n       (nil? value)\n       (throw (ex-info (str \"--index-store needs a value: \" supported)\n                       {:value value\n                        :supported supported}))\n\n       (some? extra)\n       extra\n\n       (= value \"mem\")\n       :mem\n\n       (str/starts-with? value file-scheme)\n       (let [dir (subs value (count file-scheme))]\n         (if (str/blank? dir)\n           (throw (ex-info \"--index-store file:<dir> needs a directory\"\n                           {:value value\n                            :supported supported}))\n           {:type :file :dir dir}))\n                    (throw (refuse path (str (pr-str k) \" must be a vector of\"\n                                             \" strings\")))\n\n                    :else (assoc flags flag v))))\n              {}\n              config))))\n\n\n(defn path\n  \"The state file's path in the node directory `dir`.\"\n  [dir]\n  (str dir \"/\" file-name))\n\n\n(defn- read-text\n  \"The file at `path` as text, or nil only when no directory entry exists\n   there.  Unlike `fs/read-file-text`, which answers nil for anything it\n   cannot stat, a directory, an unreadable file and a dangling symlink all\n   throw here, so a state file is never skipped for being unreadable.  Each\n   host tells absence from an access failure by the error it gets on a\n   direct read, not by an existence test.\"\n  [path]\n  #?(:cljd (try (.readAsStringSync (dart-io/File. path))\n                (catch dart-io/PathNotFoundException e\n                  ;; Dart also raises this class for Windows errors that are\n                  ;; not absence (bad drive, bad name, name too long): only\n                  ;; OS error 2 (ENOENT, file not found) and 3 (path not\n                  ;; found) are.  A link whose target is missing is an entry,\n                  ;; not absence.\n                  (let [code (some-> (.-osError e) .-errorCode)]\n                    (when (or (not (contains? #{2 3} code))\n                              (.existsSync (dart-io/Link. path)))\n                      (throw e)))))\n     ;; lstat decides absence; a dangling link (an entry whose target is\n     ;; missing), a non-regular entry, an unreadable file or invalid UTF-8\n     ;; all throw\n     :jolt (when-not (= :absent (posix-file/classify path false))\n             (let [bs (posix-file/read-all path)]\n               (case bs\n                 :absent (throw (ex-info (str path \" is a dangling symlink\")\n                                         {:path path}))\n                 :not-regular (throw (ex-info (str path \" is not a regular file\")\n                                              {:path path}))\n                 (text/utf8-decode bs))))\n     :clj (when-not (java.nio.file.Files/notExists\n                      (java.nio.file.Paths/get path (make-array String 0))\n                      (into-array java.nio.file.LinkOption\n                                  [java.nio.file.LinkOption/NOFOLLOW_LINKS]))\n            (slurp path))\n     :cljs (let [fs (js/require \"fs\")\n                 entry? (fn []\n                          (try (.lstatSync ^js fs path) true\n                               (catch :default e\n                                 ;; only \"no such entry\" means no entry; an\n                                 ;; access or I/O failure must not read as one\n                                 (if (= \"ENOENT\" (.-code e)) false (throw e)))))]\n             (try (.readFileSync ^js fs path \"utf8\")\n                  (catch :default e\n                    (when-not (and (= \"ENOENT\" (.-code e)) (not (entry?)))\n                      (throw e)))))))\n\n\n(defn load-flags\n  \"The saved flags in the node directory `dir`, or nil when there is no\n   state file.  A file that cannot be understood or read is refused, never\n   skipped.  `table` is the `flag-table` the settings are read against.\"\n  ([dir] (load-flags dir nil))\n  ([dir table]\n   (when-some [text (try (read-text (path dir))\n                         (catch #?(:cljd Object\n                                   :clj Throwable\n                                   :cljs :default)\n                                e\n                           (throw (refuse (path dir)\n                                          (str \"it cannot be read (\"\n                                               (or (ex-message e) (str e))\n                                               \")\")))))]\n     (text->config (path dir) text (or table (flag-table))))))\n\n\n(defn- mkdirs!\n  [dir]\n  #?(:cljd (.createSync (dart-io/Directory. dir) .recursive true)\n     :clj (.mkdirs (java.io.File. ^String dir))\n     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n\n\n(defn- render\n  \"The state file's text, one setting to a line, with no space before a\n   closing bracket (ClojureDart's EDN reader refuses one).\"\n  [flags table]\n  (let [entries (for [[flag _] (:saved-flags table)\n                      :let [v (get flags flag)]\n                      :when (some? v)]\n                  (str (config-key flag) \" \" (pr-str v)))]\n    (str \"{:version \" version \"\\n :config {\"\n         (str/join \"\\n          \" entries)\n         \"}}\\n\")))\n\n\n(defn save!\n  \"Write `flags` as the state file of the node directory `dir`, creating the\n   directory and replacing any earlier file atomically.  `table` is the\n   `flag-table` whose order the settings are written in.\"\n  ([dir flags] (save! dir flags nil))\n  ([dir flags table]\n   (mkdirs! dir)\n   (fs/atomic-replace! dir file-name (render flags (or table (flag-table))))))\n   endpoint's lifecycle medium reports, and the ticker prints it.\"\n  [opts]\n  (when (:port opts)\n    (serve/serve! {:bind-port (:port opts)\n                   :bind-host bind-all-host\n                   :advertised-host (local-ip)\n                   :host (or (:adapter opts) (host/websocket))\n                   :codec (get connect/codec-profiles (:codec opts :cbor))})))\n\n\n(def help-lines\n  \"What `--help` prints for a host that carries no storage composition:\n   every flag `parse-args` and `expand-args` read.  A composition states\n   its own subcommands, its own flags and its own stores through its\n   `:help-lines` hook, so a build that composes one prints that instead.\"\n  [\"yin-repl: the interface to datom.world\"\n   \"\"\n   \"usage: yin-repl [flags]\"\n   \"\"\n   \"flags:\"\n   \"  --port n          serve this shell to other shells over WebSockets, on\"\n   \"                    all interfaces: localhost and this machine's IP\"\n   \"  --codec c         wire codec served: cbor (default) or transit\"\n   \"  --headless        no prompt, endpoint only; needs --port\"\n   \"  --index-store s   mem (default), file:<dir>, or a store the host's\"\n   \"                    storage composition registers\"\n   \"  --vm type         ast-walker, semantic (default), stack or register\"\n   \"  --name n, --dir d the node directory holding the saved state\"\n   \"                    (default ~/.yin/node)\"\n   \"  --reset           forget the saved state; start from the command line\"\n   \"  --no-state        neither read nor write the saved state\"\n   \"  --help, -h        print this and exit\"\n   \"\"\n   \"saved state: the flags a node starts with are kept in <node dir>/state.edn,\"\n   \"and a bare `yin-repl` starts that node again. Flags change it: a repeated\"\n   \"flag replaces its saved values, and the result is saved.\"\n   \"\"\n   \"--telemetry and --telemetry-stream are rejected.\"\n   \"Unrecognized arguments are ignored.\"\n   \"See src/cljc/yin/vm/docs/yin.repl.md for the walk-through.\"])\n\n\n(defn- composition-flag-table\n  \"The saved-flag table this run reads, splits, describes and writes its\n   `state.edn` by: the composition's own when it declares one, so a saved\n   flag of a composition's is resumed beside the engine's, and the\n   engine's own table otherwise.\n\n   `yin.repl.state` resolves nothing and reaches for no composition, so the\n   table is handed to it from here — and `startup`'s `:flag-table` option\n   hands one in explicitly, which is what a test or a second composition\n   does.\"\n  [composition]\n  (or (:flag-table composition) (state/flag-table)))\n\n\n(defn- save-state!\n  \"Save the flags this run resolved to the node directory's state file when\n   they differ from what was saved (nothing is written for a bare run with\n   nothing saved), and answer the banner's lines about it.  A file that\n   cannot be written is a warning, never a refusal: the node still starts.\n   `table` is the `state/flag-table` the file is described and written by.\"\n  [dir saved resolved reset? table]\n  (let [path (state/path dir)\n        changed (state/changed (or saved {}) resolved)]\n    (try\n      (cond\n        (and (nil? saved) (empty? resolved) (not reset?))\n        []\n\n        (nil? saved)\n        (do (state/save! dir resolved table)\n            [(str \"state: \" (if reset? \"reset, \" \"\") \"saved to \" path\n                  \"; a bare yin-repl starts this node again\")])\n\n        (seq changed)\n        (do (state/save! dir resolved table)\n            [(str \"state: resumed from \" path \" (\" (state/describe saved table)\n                  \"); the command line changed \" (str/join \", \" changed)\n                  \"; saved\")])\n\n        :else\n        [(str \"state: resumed from \" path \" (\" (state/describe resolved table) \")\")])\n      (catch #?(:cljd Object\n                :clj Throwable\n                :cljs :default)\n             e\n        [(str \"state: WARNING: could not save \" path \": \"\n              (or (ex-message e) (str e)))]))))\n\n\n(defn startup\n  \"Parse the arguments and compose the whole shell (the store the parsed\n   `:index-store-spec` names included), or answer the refusal text.  This\n   is the one gate every host's `-main` passes through before it prints a\n   banner or starts a loop, so an invalid `--index-store`, an unsupported\n   host for it, or a directory that cannot be opened refuses startup with\n   its reason rather than composing a shell around a fallback store.\n\n   Only a designed refusal is answered: an error carrying no ex-info\n   keeps its stack trace, because it is a defect, not an operator error.\n\n   `:composition` is the plain-data contribution of a storage composition\n   (`parse-args`' and `boot`'s argument of the same name): its flags, its\n   subcommands, its key file, its help and banner text, its store and its\n   transport lifecycle.  Every one of those reaches this gate through that\n   value and none of them is named here, so a host that carries no\n   composition has the engine's own surface and nothing more.  A\n   composition's `:keygen-flag` names the one argument that composes\n   nothing at all: it writes a key file through `:keygen!` and answers\n   `{:lines [...] :exit 0}` for the host to print and exit with, and no\npamrubber\npbmtobbnbg\n7f4898f474d02dc127e5e484254bc44ae7ff88f6\n","exit_code":0,"status":"completed"}}
