{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"set -e\npython3 -c 'from pathlib import Path\np = Path(\\\"host/gambit/yin/file.ss\\\")\ns = p.read_text().replace(\\\"(string-index path #\\\\\\\\nul)\\\", \\\"(memv #\\\\\\\\nul (string->list path))\\\")\np.write_text(s)\np = Path(\\\"host/gambit/yin/jolt/gambit/yin.jolt\\\")\ns = p.read_text().replace(\\\"The memory and memory-backed DHT compositions for the Gambit terminal.\\\", \\\"Yin'\\\\''s shared durable-store composition and Gambit'\\\\''s host modules.\\\").replace(\\\"[yin.repl.store :as store]\\\", \\\"[yin.repl.store :as store]\\\\n            [yin.shell.main :as shell]\\\")\ns = s.replace(\\\"memory-engine-inputs\\\", \\\"gambit-engine-inputs\\\")\ns = s[:s.index(\\\"(defn- open-memory\\\")] + \\\"(defn- open-memory-dht []\\\\n  (let [join (requiring-resolve '\\\\''dao.space.dht/join)\\\\n        payload-budget (requiring-resolve '\\\\''dao.space.dht/payload-budget)\\\\n        local (store/open :mem)\\\\n        node (try\\\\n               (join {:local local})\\\\n               (catch Throwable e\\\\n                 (jing/close\"'! local)'\"\\\\n                 (throw e)))\\\\n        handle (:handle node)]\\\\n    (try\\\\n      {:index-store handle\\\\n       :publication-policy {:max-payload-bytes (payload-budget node)}}\\\\n      (catch Throwable e\\\\n        (jing/close\"'! handle)'\"\\\\n        (throw e)))))\\\\n\\\\n(defn- open-store [spec opts]\\\\n  (let [opened (if (= spec :dht)\\\\n                 (open-memory-dht)\\\\n                 ((:open shell/composition) spec opts))]\\\\n    (update-in opened [:engine-inputs :host-modules]\\\\n               merge (:host-modules gambit-engine-inputs))))\\\\n\\\\n(defn- parse-store [arg]\\\\n  (if (= arg \\\\\\\"dht:\\\\\\\") :dht ((:parse-store-arg shell/composition) arg)))\\\\n\\\\n(defn- parse-store-command [args]\\\\n  (if (= [\\\\\\\"dht:\\\\\\\"] (vec args))\\\\n    {:spec :dht :label \\\\\\\"dht:\\\\\\\" :opts {:index-store-spec :dht}}\\\\n    ((:parse-store-command shell/composition) args)))\\\\n\\\\n(def \"'^:private composition'\"\\\\n  (assoc shell/composition\\\\n         :composition-spec? (constantly true)\\\\n         :parse-store-arg parse-store\\\\n         :parse-store-command parse-store-command\\\\n         :open open-store\\\\n         :help-lines (mapv (fn [line]\\\\n                             (if (= line \\\\\\\"  --index-store s   mem (default), file:<dir> or dht:<dir>\\\\\\\")\\\\n                               \\\\\\\"  --index-store s   mem (default), dht: (memory), file:<dir> or dht:<dir>\\\\\\\"\\\\n                               line))\\\\n                           (:help-lines shell/composition))))\\\\n\\\\n(defn -main [& args]\\\\n  (main/main\"'! args composition))'\"\\\\n\\\"\np.write_text(s)\n'\nsh host/gambit/ffi/make-digests.sh >/dev/null\nfor sub in cli clojure-test-suite fs grenadine irregex process sci; do\n  rev=\"'$(git ls-tree HEAD \"vendor/$sub\" | awk '\"'{print \"'$3}'\"')\n  git -C \\\"vendor/\"'$sub\" init -q\n  printf '\"'%s\\\\n' \\\"\"'$(git -C \"/Users/sto/workspace/jolt-ffi-p1f/vendor/$sub\" rev-parse --path-format=absolute --git-path objects)\" >\"vendor/$sub/.git/objects/info/alternates\"\n  git -C \"vendor/$sub\" reset -q --mixed \"$rev\"\ndone\nexport TMPDIR=\"$PWD/build/p2/tmp\"\nexport JOLT_REQUIRE_GAMBIT=1\nchez=/Users/sto/workspace/jolt-ffi-p1f/.cache/local/chezscheme-10.4.1/bin/scheme\nmake GAMBIT_PREFIX=/Users/sto/.local/share/mise/installs/gambit/4.9.8 CHEZ=\"$chez\" JOLT-CHEZ=\"$chez\" gambitffi gambitcheck gambitkernel gambiteval gambitsourceload >build/p2/native-matrix.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
