e 4096\n    (fn [buf]\n      (let [r (path-bytes! (native-path path) #(c-realpath %1 %2 buf 4096))]\n        (when (neg? r) (throw (fs-error \"realpath\" path (- r) {})))\n        (text/utf8-decode (ffi/read-array buf r))))))\n\n\n(defn- read-to!\n  \"pread from fd into buf[0, cap) until end of file or cap bytes: the count.\n   Short reads continue, EINTR retries, an error throws.\"\n  [path fd buf cap]\n  (loop [done 0]\n    (if (>= done cap)\n      done\n      (let [r (pread-once fd done buf done (- cap done))]\n        (cond\n          (pos? r) (recur (+ done r))\n          (zero? r) done\n          (= r (- eintr)) (recur done)\n          :else (throw (fs-error \"pread\" path (- r) {:read done})))))))\n\n\n(defn- with-read-descriptor\n  \"(f fd) over path opened read-only, non-blocking and close-on-exec, the\n   descriptor rechecked by fstat: :not-regular unless it is a regular file.\n   Closed however f exits.\"\n  [path f]\n  (let [fd (path-bytes! (native-path path) c-open-read)]\n    (when (neg? fd) (throw (fs-error \"open\" path (- fd) {})))\n    (let [h {:fd fd, :path path, :released (atom false)}]\n      (try\n        (let [k (c-fclassify fd)]\n          (when (neg? k) (throw (fs-error \"fstat\" path (- k) {})))\n          (if (= :regular (kinds k)) (f fd) :not-regular))\n        (finally (close! h))))))\n\n\n(def ^:private max-bound\n  ;; the JVM arm reads (int (inc limit)) bytes: one more than the limit must\n  ;; fit a signed 32-bit count\n  2147483646)\n\n\n(defn read-bounded\n  \"At most limit + 1 bytes of the regular file at path, as a fresh byte\n   array; :absent when no entry exists there (lstat); :not-regular for a\n   dangling symlink, a directory, a FIFO or anything else that is not a\n   regular file, decided by stat before the open and by fstat of the\n   non-blocking descriptor after it, so a FIFO never blocks. A symlink to a\n   regular file is followed.\"\n  [path limit]\n  (when-not (and (integer? limit) (<= 0 limit max-bound))\n    (throw