atoms\n                                            store root))]))\n                       (:indexes manifest))]\n      (doseq [[index datoms] walked]\n        (when-not (= (:count manifest) (count datoms))\n          (throw (ex-info (str \"the \" (name index) \" index covers \"\n        (throw (ex-info \"Content file is closed\" {:address address})))\n      (if (contains? content address)\n        (cbor/copy-bytes (clojure.core/get content address))\n        not-found))))\n\n\n(defn- make-close\n  [state f lock]\n  (fn content-close!\n    []\n    (with-lock\n      lock\n      (fn []\n        (when-not (:closed? @state)\n          (swap! state assoc :closed? true)\n          (close-file! f))\n        nil))))\n\n\n;; =============================================================================\n;; Constructor\n;; =============================================================================\n\n(defn create-content-file\n  \"Open or create a content file at path: validate every complete frame,\n   truncate any incomplete tail (F3), replay every record into an\n   in-memory map of address to payload bytes (F2, F4), and return the\n   plain-data byte-store handle {:put-bytes-fn :get-bytes-fn :close-fn}\n   (D1). A\n   frame that is not a canonical [digest payload] record, whose digest is\n   not its payload's under a registered algorithm, or whose payload is not\n   canonical fails the open, loudly and without mutation (F4).\"\n  [path]\n  (let [f (open-file! path)]\n    (try (let [recovered (replay-records (recover! f))\n               state (atom {:closed? false, :content recovered})\n               lock #?(:clj (Object.)\n                       :cljs (js-obj)\n                       :cljd (Object.))]\n           {:put-bytes-fn (make-put state f lock),\n            :get-bytes-fn (make-get state),\n282:(def ^:private token-query\n388:            (type! a token-query)\n400:              (type! d token-query)\n  [{:keys [lines]} re ms]\n  (let [deadline (+ (System/currentTimeMillis) ms)]\n    (loop []\n      (or (some #(when (re-find re %) %) @lines)\n          (when (< (System/currentTimeMillis) deadline)\n            (Thread/sleep 50)\n            (recur))))))\n\n\n(defn- index-of-match\n  [{:keys [lines]} re]\n  (first (keep-indexed (fn [i l] (when (re-find re l) i)) @lines)))\n\n\n(defn- stop!\n  [{:keys [process] :as p}]\n  (try (type! p \"(quit)\") (catch Exception _ nil))\n  ([node publisher-key] (transport-state node publisher-key nil))\n  ([node publisher-key limits]\n   {:node node\n    :key publisher-key\n    :limits limits\n    :awaiting {}}))\n\n\n(defn serve\n  \"One composition round over both media the engine parks on: the link\n  request media (`yin.shell.linker/serve-links`) and the query call media\n  (`yin.shell.query/serve-services`).  Answers `{:session s' :progress?\n  bool}`, `:progress?` true when either round moved something — the fact a\n  host's ticker spends another round on, and the fact a parked run is\n  resumed on.\n\n  The linker round runs first and its successor node is the one the\n  service round reads, so a load a link started this round is visible to a\n  `dao.space.dht` call answered in it.  The service round's publication\n  correlations are carried on `:awaiting`, so a signed publish parked on\n  its local publication completion is answered by a later tick and never\n  committed twice.  `budget` bounds each round and defaults to each\n  adapter's own.\"\n  ([session] (serve session nil))\n  ([{:keys [engine node] :as session} budget]\n   (let [linked (if budget\n                  (shell.linker/serve-links\n                    (shell.linker/from-engine engine node) budget)\n                  (shell.linker/serve-links\n                    (shell.linker/from-engine engine node)))\n         engine (cond-> (shell.linker/install engine (:composition linked))\n                  (and (:pending-run engine) (seq (:pending linked)))\n                  (assoc-in [:pending-run :links] (:pending linked)))\n","exit_code":0,"status":"completed"}}
