{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"sed -n '777,800p;530,645p' src/cljc/yin/shell/cli.cljc; sed -n '180,246p' src/cljc/yin/repl/main.cljc; head -74 src/cljc/yin/shell/main.cljc; rg -n 'defn.*(stopped|refusal|admitting|step)' src/cljc/yin/shell/dht.cljc\"","aggregated_output":"   flags mean nothing to a store it does not name, so `dht-spec` refuses\n   rather than ignores them.\"\n  [opts extra]\n  (update opts :index-store-spec dht-spec\n          (assoc extra :principals (:principals opts))))\n\n\n(defn parse-store-arg\n  \"The `--index-store` value as a spec, over the engine's two schemes and\n   this composition's `dht:` (yin.shell.store/parse-arg).\"\n  [value]\n  (shell.store/parse-arg value))\n\n\n(defn- store-option-text\n  [option value]\n  (when-not (and (string? value) (not (str/blank? value)))\n    (throw (ex-info (str option \" needs a non-empty string\") {:option option})))\n  value)\n\n\n(defn- store-option-values\n  [option value]\n  (when-not (sequential? value)\n    (throw (ex-info (str option \" needs a sequence of values\") {:option option})))\n  value)\n\n\n(defn- store-option-number\n  [option value]\n  (when-not (integer? value)\n    (throw (ex-info (str option \" needs an integer\") {:option option})))\n  (dht-number option (str value)))\n\n\n(defn- listen-options\n  [options value]\n  (let [[_ host port] (re-matches #\"(?:(.+):)?(\\d+)\" (store-option-text :listen value))]\n    (when-not port\n      (throw (ex-info \":listen needs [host:]port\" {:value value})))\n    (cond-> (assoc options :bind-port (dht-number :listen port))\n      host (assoc :bind-host (or (second (re-matches #\"\\[([^\\]]+)\\]\" host))\n                                 host)))))\n\n\n(defn- store-command-option\n  [options [option value]]\n  (case option\n    :peer (update options :peers conj (parse-peer (peer-text (store-option-text option value))))\n    :peers (update options :peers into\n                   (map #(parse-peer (peer-text (store-option-text :peer %))))\n                   (store-option-values option value))\n    :publish (if (boolean? value)\n               (assoc options :publish? value)\n               (throw (ex-info \":publish needs a boolean\" {:value value})))\n    :bind (assoc options :bind-host (store-option-text option value))\n    :port (assoc options :bind-port (store-option-number option value))\n    :listen (listen-options options value)\n    :max-inbound-bytes (assoc options :max-inbound-bytes (store-option-number option value))\n    :key (assoc options :publisher-key-file (store-option-text option value))\n    :principal (update options :principals conj (parse-principal value))\n    :principals (update options :principals into (map parse-principal)\n                        (store-option-values option value))\n    :trust (update-in options [:admission :trusted] (fnil into #{}) (map parse-trust)\n                      (store-option-values option value))\n    :follow (update options :follow into (map #(parse-follow (store-option-text option %)))\n                    (store-option-values option value))\n    :join (let [[contact principal] (parse-token (store-option-text option value))\n                contact (peer-text contact)\n                principal (parse-principal principal)]\n            (-> options\n                (update :peers conj (parse-peer contact))\n                (update :principals conj principal)\n                (update :follow conj (parse-follow (str principal \"@\" contact)))))\n    (throw (ex-info (str \"Unknown (use-store ...) option \" (pr-str option))\n                    {:option option}))))\n\n\n(defn parse-store-command\n  \"Check a prompt store target and its keyword options using startup's\n   DHT spec and key validation. A join token declares and follows its\n   publisher. In-session admission still uses the explicit trust options.\"\n  [[target & options :as args]]\n  (let [supported \"mem, file:<dir>, dht:<dir>\"\n        target (cond\n                 (empty? args)\n                 (throw (ex-info (str \"(use-store <store> ...) needs a store: \" supported) {}))\n\n                 (= :mem target) \"mem\"\n                 (string? target) target\n                 :else (throw (ex-info (str \"(use-store ...) expects a store: \" supported) {})))\n        spec (parse-store-arg target)\n        pairs (partition 2 options)]\n    (when-not (and (even? (count options)) (every? (comp keyword? first) pairs))\n      (throw (ex-info \"(use-store ...) options must be keyword-value pairs\" {})))\n    (when (some #(= :manifest (first %)) pairs)\n      (throw (ex-info (str \":manifest (--dht-manifest) is a startup pin; switch to dht:<dir>\"\n                           \" first, then call (dao.space.dht/load-index <manifest>)\") {})))\n    (when (and (seq pairs) (not (shell.store/composition-spec? spec)))\n      (throw (ex-info \"store options require dht:<dir>\" {})))\n    (let [normalized (reduce store-command-option\n                             {:peers [] :principals [] :follow [] :admission {}}\n                             pairs)\n          spec (dht-spec spec normalized)\n          path (:publisher-key-file normalized)]\n      {:spec spec\n       :label target\n       :opts (cond-> (assoc (select-keys normalized [:principals :admission])\n                            :index-store-spec spec)\n               path (assoc :publisher-key-file path :publisher-key (load-key path)))})))\n\n\n(def state-table\n  \"The saved-flag table this composition adds to the engine's own: every\n   `--dht-*` flag a node restarts with, and the two one-shot flags that\n   are read and never persisted.\"\n(defn hooks\n  \"The command-line half of the plain-data bundle `yin.repl.main` takes as\n   its `:composition`: every way this composition widens the engine\n   driver's argument surface, and nothing else.  The store, the session and\n   the transport lifecycle keys beside these are the outer host entry\n   point's to add (`yin.shell.main/composition`), so this namespace stays a\n   parser and never opens a socket.\"\n  []\n  {:flag-table flag-table\n   :expand-args expand-args\n   :flag-parser parse-flag\n   :parse-store-arg parse-store-arg\n   :parse-store-command parse-store-command\n   :initial-extra {:flags #{} :peers []}\n   :finalize finalize-opts\n   :keygen-flag keygen-flag\n   :keygen! keygen!\n   :ensure-key! ensure-key!\n   :load-key load-key\n   :banner-lines banner-lines\n   :help-lines help-lines})\n   else, and an argument nobody owns is collected under `:extra` exactly as\n   it always was.\"\n  ([args] (parse-args args nil))\n  ([args composition]\n   (let [flag-parser (:flag-parser composition)\n         parse-store-arg (or (:parse-store-arg composition) store/parse-arg)\n         finalize (:finalize composition)]\n     (loop [args (seq args)\n            opts {:headless? false :host nil :port nil :rejected []\n                  :index-store-spec :mem}\n            extra (:initial-extra composition)]\n       (if-let [arg (first args)]\n         (let [value (second args)\n               hooked (when flag-parser\n                        (flag-parser arg value args opts extra))]\n           (if (some? hooked)\n             (recur (drop (:advance hooked 1) args)\n                    (or (:opts hooked) opts)\n                    (get hooked :extra extra))\n             (case arg\n               \"--port\" (recur (nnext args)\n                               (assoc opts :port (when-some [p (second args)]\n                                                   (let [n (parse-int p)]\n                                                     (if (and n (<= 0 n 65535))\n                                                       n\n                                                       (throw (ex-info\n                                                                (str \"--port takes a \"\n                                                                     \"port from 0 to \"\n                                                                     \"65535, not \"\n                                                                     (pr-str p))\n                                                                {:value p}))))))\n                               extra)\n               \"--host\" (throw (ex-info (str \"--host is gone: --port serves on all \"\n                                             \"interfaces, so it answers on \"\n                                             \"localhost and on this machine's IP\")\n                                        {}))\n               \"--codec\" (recur (nnext args)\n                                (assoc opts :codec (parse-codec value))\n                                extra)\n               \"--headless\" (recur (next args) (assoc opts :headless? true) extra)\n               \"--vm\" (recur (nnext args)\n                             (assoc opts :vm-type (parse-vm (second args)))\n                             extra)\n               \"--index-store\" (recur (nnext args)\n                                      (assoc opts\n                                             :index-store-spec\n                                             (parse-store-arg (second args)))\n                                      extra)\n               \"--telemetry\" (recur (next args) (update opts :rejected conj arg)\n                                    extra)\n               \"--telemetry-stream\" (recur (nnext args)\n                                           (update opts :rejected conj arg)\n                                           extra)\n               (recur (next args) (update opts :extra (fnil conj []) arg)\n                      extra))))\n         (if finalize (finalize opts extra) opts))))))\n\n\n(defn- release-store!\n  \"Release a failed replacement or a retired store: the\n   composition's transport state first (its boards, dials and socket), then\n   the store handle (a durable directory's exclusive lock). Cleanup errors\n   leave the outcome of the swap intact.\"\n  [composition opened]\n  (let [close (:close! composition)\n        session (:session opened)]\n    (when (and close session)\n(ns yin.shell.main\n  \"The outer host entry point: the engine's driver plus this project's\n   storage composition.\n\n   `yin.repl.main` is the engine's host driver — cadence, one step owner,\n   the line producers and the bounded shutdown drain — and it names no\n   transport, no peer, no key file and no store past `mem` and `file:<dir>`.\n   Everything past that reaches it as one plain-data value, `composition`,\n   assembled here out of the composition's own namespaces: the command line\n   (`yin.shell.cli`), the store factory (`yin.shell.store`), the session\n   where the section 7 adapters meet the engine (`yin.shell.session`), and\n   the DHT composition's transport lifecycle (`yin.shell.dht`).\n\n   This is the namespace the shipped binaries run — `deps.edn`'s\n   `:clj-yin-repl` and `:jolt-yin-repl`, shadow-cljs's `:yin-repl` build and\n   the ClojureDart `:main` — and it is why the engine's own dependency\n   closure can stay free of a storage implementation\n   (docs/design/yin.repl.dht-composition.md sections 2, 6 and 10, Gate A):\n   the require runs this way, and never the other way round.  `yin.shell.cli`\n   consumes the engine driver's primitives (`parse-int`, `plain-args`); the\n   engine driver consumes nothing of a composition's except the value handed\n   to it, so there is no cycle to break and nothing to resolve at runtime.\n\n   This namespace owns no socket, atom, promise, callback, clock or namespace\n   global of its own: `composition` is one constant map of function values,\n   and each host's `-main` is a single call into the engine driver's `main!`.\"\n  (:require [yin.repl.main :as repl.main]\n            [yin.shell.cli :as cli]\n            [yin.shell.dht :as shell.dht]\n            [yin.shell.session :as shell.session]\n            [yin.shell.store :as shell.store]))\n\n\n(def composition\n  \"The plain-data bundle this project's hosts hand `yin.repl.main` as its\n   `:composition`: every key that driver documents, and nothing that reaches\n   past it.\n\n   The command-line half is `yin.shell.cli/hooks` — the flags, the\n   subcommands, the key file, the help and the banner text.  The rest is the\n   store and its transport lifecycle, each entry one function value taken\n   statically from the namespace that owns it, so the wiring is identical on\n   the JVM, on Node and on Dart and no host resolves a symbol at runtime\n   (docs/design/yin.repl.dht-composition.md sections 6 and 7).\n\n   The lifecycle functions all take the one composition session\n   `{:engine … :node … :key …}` and are driven by the engine driver's single\n   tick: `:step` advances the transport and answers its lines and its own\n   events, `:recheck-on-tick` serves the link and call media the engine\n   parks on and translates those events before they cross inward, and\n   `:stop!`/`:stopped?`/`:close!` are the one resource owner's exit — asked\n   once, completed by `:step`, and forced only by the drain's last resort.\"\n  (merge (cli/hooks)\n         {:composition-spec? shell.store/composition-spec?\n          :open shell.store/open\n          :close-store! shell.store/close!\n          :step shell.dht/step\n          :recheck-on-tick shell.session/recheck-on-tick\n          :recheck-after-input shell.session/recheck-after-input\n          :stop! shell.dht/stop!\n          :stopped? shell.dht/stopped?\n          :close! shell.dht/close!\n          :busy? shell.dht/busy?\n          :refusal shell.dht/refusal\n          :admitting? shell.dht/admitting?\n          :startup-lines shell.dht/follow-lines}))\n\n\n#?(:cljd nil\n   :jolt nil\n   :clj\n   (defn -main\n     \"The shipped JVM entry point: the engine's driver over `composition`.\"\n     [& args]\n187:(defn- dht-refusal\n719:(defn stopped?\n920:(defn- stopped-line\n929:(defn- step-board\n1045:(defn- step-link\n1084:(defn- step-links\n1241:(defn- step-follow\n1291:(defn step\n1346:(defn refusal\n1360:(defn admitting?\n","exit_code":0,"status":"completed"}}
