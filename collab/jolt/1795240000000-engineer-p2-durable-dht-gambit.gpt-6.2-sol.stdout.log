43bdd65e189f2ccacc56662c53a21f5470ff1500\"\n               \"vendor/sci\" \"32d62a5136ad3dc148588752f5bcc4cc30b14752\"}\n  ;; The fork pin carries the Sorted fix: sonwh98/jolt#2, source 7b7100c1\n  ;; and regenerated seeds 697b91ee. No bootstrap patch or re-mint is needed.\n  ;; Re-pinned 2026-10-24 (owner ruling: the JVM is canonical, jolt-lang is\n  ;; patched via the fork, same exception as 2026-10-22) to b389f1a7 on fork\n  ;; branch assoc-deftype-refusal, one commit on 697b91ee: assoc on a deftype\n  ;; that is not Associative throws ClassCastException, as on the JVM\n  ;; (host/chez/records-coll.ss; seeds unchanged at the remint byte-fixpoint;\n  ;; format-patch SHA-256 776019b9954113c13a74c7e8fce309040e33a99da859a9620701a9f094513c9f;\n  ;; upstream report text in collab/1792824446211-engineer-canonical-adjudication-fixes...).\n  ;; Former patch 0001-sorted-user-types (base 96d7b866) is retired;\n  ;; the patch mechanism stays available for future patches.\n  ;; Re-pinned 2026-11-20 (owner-directed) to dd605630 on fork branch\n  ;; gambit-ffi-p1b: the Gambit FFI stage-1 tier (loader/memory/ordinary\n  ;; calls/errno qualified on macOS arm64 + Linux x86_64; blocking,\n  ;; foreign-thread callbacks and dynamic callables keep honest refusals;\n  ;; jolt CI code-green on Linux + Android shards) PLUS the pinned\n  ;; assoc-deftype refusal fix carried as commit dd605630 (cherry-picked from\n  ;; b389f1a7; unit row records-assoc-refusal at test/chez/unit.edn:2596\n  ;; gate-holds the parity: [false \"class user.AssocRefusal cannot be cast to\n  ;; class clojure.lang.Associative\"]; seeds byte-identical). Submodule pins\n  ;; unchanged from b389f1a7. Evidence: collab/jolt/1795108300000-*\n  ;; (p1b-stage1/P1b-assoc-parity.findings.md in the clone); gate matrix in\n  ;; collab/jolt/1795042000000-* findings. Advanced 2026-11-20 (same owner direction) to f22df3c7 on fork branch\n  ;; gambit-ffi-p1c: yin.repl RUNNING under the Gambit backend — real yin>\n  ;; session (12 replies: evaluation, error handling, frontend refusal,\n  ;; qualified FFI call, blocking-ffi C4 refusal inline, clean quit) via the\n  ;; gambityinrepl gate on BOTH platforms (macOS arm64 + Linux x86_64; the\n  ;; Linux compiled-boot heap issue resolved as a missing DATOMWORLD_ROOT\n  ;; default, now fail-closed preflight). Cross-family review: glm-5.3-flash\n  ;; ACCEPT (gate honesty verified by re-run; collab/jolt/1795135000000-*).\n  :patches []}\n\n ;; Host OS packages (owner 2026-10-20: Linux = the Debian family with apt).\n ;; `bb bootstrap:jolt` checks :required with dpkg-query on hosts whose\n ;; /etc/os-release ID or ID_LIKE names debian, BEFORE anything mise builds,\n ;; and fails naming the missing packages and the exact\n ;; `sudo apt-get install -y ...` command. It never runs sudo or apt.\n ;; :unverified entries are candidates with no step shown to need them yet;\n ;; they are listed, not checked. Chez and CMake stay mise-provided.\n :os-packages\n {:debian\n  {:required\n   {;; mise builds Chez 10.4.1 from source and links it against ncurses;\n    ;; verified on shiva (Ubuntu 24.04.5): \"cannot find -lncurses\" until\n    ;; this was installed (docs/orchestrator-log.md, J0b-on-shiva entry)\n    \"libncurses-dev\" \"mise Chez source build (link)\"\n    ;; Chez's expression editor (c/expeditor.c:1189-1212) reads the X11\n    ;; clipboard; verified on jupiter (Ubuntu 24.04.5): the build failed with\n(defn child-target\n  \"The target a child reports for itself from its environment: JOLT_TARGET\n   when set, :chez otherwise (every existing launcher is a Chez one).\"\n  []\n  (resolve-target (System/getenv \"JOLT_TARGET\")))\n\n\n(defn toolchain-command\n  \"Run a shell command with the bootstrapped Jolt toolchain.\"\n  [command]\n  (str \". build/tools/jolt-env.sh && \" command))\n\n\n(defn launch-command\n  \"The sh -c command string that runs `script` (a path relative to the\n   repo root, or nil for stdin/-e style use) under `target`, with \\\"$@\\\"\n   carrying extra arguments. `alias` extends the -M: alias for :chez\n   (e.g. \\\"jolt-test\\\"). The child sees JOLT_TARGET so it can report its\n   own identity. With :cd?, the first shell argument is the child's\n   working directory, consumed before passing on the remaining arguments.\"\n  [{:keys [target script alias cd?]}]\n  (let [target (resolve-target target)\n              (is (re-find #\", acknowledged: sent to 2 peers\" (str published))\n                  (transcript a)))\n            (testing \"the round printed its result before the network answered\"\n              (is (< (index-of-match a #\"^(yin> )*4242$\")\n                     (index-of-match a #\"dht: published\"))\n                  (transcript a)))\n            (testing\n              \"the publisher's HEAD names what it announced\"\n              (is\n                (str/includes?\n                  (slurp (str (dirs 0) \"/HEAD\")) (str\n                                                   \":\"\n                                                   manifest))))\n            (type! a \"(require (quote dao.space.query))\")\n            (type! a token-query)\n            (let\n              [own (await-line a #\"#\\{\\[\\\"[0-9a-f-]+\\\"\\]\\}\" exchange-ms)\n               token (second (re-find #\"\\\"([0-9a-f-]+)\\\"\" (str own)))\n               d (spawn! \"reader-d\" [\"--index-store\" (str \"dht:\" (dirs 3))\n                                     \"--dht-peer\" (peer pa)\n                                     \"--dht-manifest\" (str \":\" manifest)])]\n              (swap! procs conj d)\n              (is (some? token) (transcript a))\n              ;; Typed before the reader has hydrated: these lines wait in its\n              ;; input medium until the remote index is installed.\n              (type! d \"(require (quote dao.space.query))\")\n              (type! d token-query)\n              (testing \"the reader hydrates the remote index over the network\"\n                (is (await-line d (re-pattern (str \"dht: hydrated :\" manifest))\n                                startup-ms)\n                    (transcript d)))\n              (testing \"and q answers the publisher's fact under its token\"\n                (let [answer (await-line d #\"#\\{\\[\\\"[0-9a-f-]+\\\"\\]\\}\"\n                                         exchange-ms)]\n(defn- head-record\n  \"The text of one HEAD record: the version and the manifest address,\n   written whole and replaced whole.\"\n  [manifest-address]\n  (str (pr-str {:version head-version :manifest manifest-address}) \"\\n\"))\n\n\n(defn- read-edn\n  [text]\n  #?(:cljd (edn/read-string text)\n     :clj (edn/read-string text)\n     :cljs (reader/read-string text)))\n\n\n(defn- recovered-head\n  \"The manifest address HEAD names, or nil for an empty index.  A missing\n   file is an empty index; a file that is not exactly the versioned\n   record naming a content address is a corrupt pointer, and a corrupt\n   pointer refuses startup rather than pretending there was no index.\"\n  [dir]\n  (if-some [text (fs/read-file-text dir head-name)]\n    (let [head (try (read-edn text)\n                    (catch #?(:cljd Object\n                              :clj Exception\n                              :cljs :default)\n                           e\n  [flag]\n  (keyword (subs flag 2)))\n\n\n(defn- refuse\n  [path why]\n  (ex-info (str \"state file \" path \": \" why \"; --reset replaces it\")\n           {:path path}))\n\n\n(defn- text->config\n  \"The flags a state file's text holds, or a refusal naming `path`.  A\n   setting the table does not name is refused, so a state file written by\n   a composition this build does not carry is never silently dropped.\"\n  [path text table]\n  (let [{:keys [kinds]} table\n        data (try #?(:cljd (edn/read-string text)\n                     :clj (edn/read-string text)\n                     :cljs (reader/read-string text))\n                  (catch #?(:cljd Object\n                            :clj Throwable\n                            :cljs :default)\n                         _\n                    (throw (refuse path \"it is not readable EDN\"))))\n        config (when (map? data) (:config data))]\n    (cond\n      (not (and (map? data) (= version (:version data))))\n      (throw (refuse path (str \"it is not a version-\" version \" state file\")))\n\n      (not (map? config))\n      (throw (refuse path \"it has no :config map\"))\n\n","exit_code":0,"status":"completed"}}
