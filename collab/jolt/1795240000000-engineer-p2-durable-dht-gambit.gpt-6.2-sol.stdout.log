r: a host asks once, here,\n   and never closes a board, a dial or the store itself\n   (docs/design/yin.repl.dht-composition.md sections 3 and 6).\"\n  [session]\n  (let [node (:node session)]\n    (if (or (nil? node) (::stopping? node))\n      session\n      (do (doseq [[_ {:keys [dial]}] (get-in node [::follow :links])]\n            (when dial (head.board/close! dial)))\n          (assoc session :node\n[1795693507s] load yin.repl.connect\n[1795693507s] load dao.stream.cbor\n[1795693508s] load dao.stream.cbor.boring\n[1795693522s] ready dao.stream.cbor.boring\n[1795693523s] ready dao.stream.cbor\n[1795693523s] load dao.stream.remote-channel\n[1795693523s] load dao.stream.remote\n[1795693523s] load dao.stream.middleware\n*** WARNING -- Variable \"tail-claim-tail\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"tail-claim-token\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"tail-claim?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"transcoded-port\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-defined?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-defined?-set!\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-dyn-bound?\" used in module \"kernel\" is undefined\n*** WARNING -- Variable \"var-cell-dyn-bound?-set!\" used in module \"kernel\" isThu Nov 26 11:45:26 UTC 2026\n","exit_code":0,"status":"completed"}}
