\\\\\\"dht:\\\\\\\" :opts {:index-store-spec :dht}}\\\\n    ((:parse-store-command shell/composition) args)))\\\\n\\\\n(def \"'^:private composition'\"\\\\n  (assoc shell/composition\\\\n         :composition-spec? (constantly true)\\\\n         :parse-store-arg parse-store\\\\n         :parse-store-command parse-store-command\\\\n         :open open-store\\\\n         :help-lines (mapv (fn [line]\\\\n                             (if (= line \\\\\\\"  --index-store s   mem (default), file:<dir> or dht:<dir>\\\\\\\")\\\\n                               \\\\\\\"  --index-store s   mem (default), dht: (memory), file:<dir> or dht:<dir>\\\\\\\"\\\\n                               line))\\\\n                           (:help-lines shell/composition))))\\\\n\\\\n(defn -main [& args]\\\\n  (main/main\"'! args composition))'\"\\\\n\\\"\np.write_text(s)\n'\nsh host/gambit/ffi/make-digests.sh >/dev/null\nfor sub in cli clojure-test-suite fs grenadine irregex process sci; do\n  rev=\"'$(git ls-tree HEAD \"vendor/$sub\" | awk '\"'{print \"'$3}'\"')\n  git -C \\\"vendor/\"'$sub\" init -q\n  printf '\"'%s\\\\n' \\\"\"'$(git -C \"/Users/sto/workspace/jolt-ffi-p1f/vendor/$sub\" rev-parse --path-format=absolute --git-path objects)\" >\"vendor/$sub/.git/objects/info/alternates\"\n  git -C \"vendor/$sub\" reset -q --mixed \"$rev\"\ndone\nexport TMPDIR=\"$PWD/build/p2/tmp\"\nexport JOLT_REQUIRE_GAMBIT=1\nchez=/Users/sto/workspace/jolt-ffi-p1f/.cache/local/chezscheme-10.4.1/bin/scheme\nmake GAMBIT_PREFIX=/Users/sto/.local/share/mise/installs/gambit/4.9.8 CHEZ=\"$chez\" JOLT-CHEZ=\"$chez\" gambitffi gambitcheck gambitkernel gambiteval gambitsourceload >build/p2/native-matrix.log 2>&1'","aggregated_output":"","exit_code":2,"status":"failed"}}
