{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'set -e\nexport MISE_TRUSTED_CONFIG_PATHS=\"$PWD\"\ntimeout 150 mise exec -- bb smoke:jolt > /tmp/p1dr4-smoke-jolt.log 2>&1\ntimeout 120 mise exec -- bb smoke:jolt-target --target chez > /tmp/p1dr4-smoke-chez.log 2>&1\ntimeout 120 mise exec -- bb smoke:jolt-target --target gambit > /tmp/p1dr4-smoke-gambit.log 2>&1\nrg '\"'SUMMARY|VERDICT' /tmp/p1dr4-smoke-{jolt,chez,gambit}.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
