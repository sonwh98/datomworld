{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '52,232p' src/dev/jolt_launch.clj; sed -n '1,105p' build/p1d-tools/jolt/bin/jolt; rg -n 'defn .*preflight|:main-opts' src/dev/jolt_launch.clj deps.edn | head -15; rg -n -- '(build:yin-repl-node|build:yin-repl-peer)' bb.edn\"","aggregated_output":"  (loop [args (vec args) target nil acc []]\n    (if (seq args)\n      (let [a (first args)]\n        (cond\n          (= \"--target\" a)\n          (do (when-not (seq (rest args))\n                (throw (ex-info \"--target needs a value (chez or gambit)\"\n                                {:arg a})))\n              (recur (subvec args 2) (resolve-target (nth args 1)) acc))\n          (str/starts-with? a \"--target=\") (recur (subvec args 1) (resolve-target (subs a 9)) acc)\n          :else (recur (subvec args 1) target (conj acc a))))\n      [(or target :chez) (vec acc)])))\n\n\n(def identity-prefix \"jolt-target: \")\n\n\n(defn identity-line\n  \"The exact identity line the CHILD prints for `target`.\"\n  [target]\n  (str identity-prefix (name (resolve-target target))))\n\n\n(defn child-target\n  \"The target a child reports for itself from its environment: JOLT_TARGET\n   when set, :chez otherwise (every existing launcher is a Chez one).\"\n  []\n  (resolve-target (System/getenv \"JOLT_TARGET\")))\n\n\n(defn toolchain-command\n  \"Run a shell command with the bootstrapped Jolt toolchain.\"\n  [command]\n  (str \". build/tools/jolt-env.sh && \" command))\n\n\n(defn launch-command\n  \"The sh -c command string that runs `script` (a path relative to the\n   repo root, or nil for stdin/-e style use) under `target`, with \\\"$@\\\"\n   carrying extra arguments. `alias` extends the -M: alias for :chez\n   (e.g. \\\"jolt-test\\\"). The child sees JOLT_TARGET so it can report its\n   own identity. With :cd?, the first shell argument is the child's\n   working directory, consumed before passing on the remaining arguments.\"\n  [{:keys [target script alias cd?]}]\n  (let [target (resolve-target target)\n        alias (if (seq alias) (str \":\" alias) \"\")\n        script (if script (str \" \" script \" \"))\n        script (or script \" \")]\n    (toolchain-command\n      (str (when cd? \"cd \\\"$1\\\" && shift && \")\n           (case target\n             :chez (str \"export JOLT_TARGET=chez\"\n                        \" && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt\" alias script \"\\\"$@\\\"\")\n             :gambit (str \"export JOLT_TARGET=gambit\"\n                          \" && exec \\\"$JOLT_GAMBIT\\\"\" script \"\\\"$@\\\"\"))))))\n\n\n(defn run-child\n  \"Run `script` with `args` under `target` (default :chez) via\n   launch-command; answers the babashka process result map with :out/:err\n   strings. `dir` selects the working directory (default: repo root).\"\n  [{:keys [target script alias dir] :or {dir \".\"}} & args]\n  (let [cmd (launch-command {:target target :script script :alias alias})\n        r (apply p/shell {:dir dir :out :string :err :string :continue true}\n                 \"sh\" \"-c\" cmd \"jolt\" (map str args))]\n    {:exit (:exit r) :out (str (:out r)) :err (str (:err r))\n     :target (resolve-target target)}))\n\n\n(defn assert-child-target!\n  \"Fail-closed gate: `output` (the child's combined stdout+err) must contain\n   the exact identity line of `target`. Throws with a diagnosis naming the\n   observed line when the line is absent or names another host — the caller\n   must not trust any pass/fail of such a child.\"\n  [{:keys [target output context]}]\n  (let [target (resolve-target target)\n        want (identity-line target)\n        observed (some #(when (str/starts-with? % identity-prefix)\n                          (str/trim %))\n                       (str/split-lines (str output)))\n        ok? (and observed (= observed want))]\n    (when-not ok?\n      (throw (ex-info (str \"jolt child target mismatch\"\n                           (when context (str \" (\" context \")\"))\n                           \": expected \" (pr-str want)\n                           \", observed \" (pr-str observed)\n                           \" — refusing to trust this child's result\")\n                      {:wanted target :observed observed})))\n    target))\n\n\n(defn run-terminal-child\n  \"Run a REPL with terminal stdin and stdout. Relay stderr and validate\n   the child's startup identity there before returning its exit status.\"\n  [{:keys [extra-env identity-prefix assert-identity!]} & command]\n  (let [child (apply p/process {:in :inherit :out :inherit :err :stream\n                                :extra-env extra-env}\n                     command)]\n    (try\n      (with-open [err (io/reader (:err child))]\n        (let [identity (loop []\n                         (when-let [line (.readLine err)]\n                           (.println System/err line)\n                           (if (str/starts-with? line identity-prefix)\n                             line\n                             (recur))))]\n          (assert-identity! identity))\n        (io/copy err System/err)\n        (.flush System/err))\n      (:exit @child)\n      (finally\n        (when (p/alive? child)\n          (p/destroy child))))))\n\n\n;; The child-side identity print, for repo scripts that run UNDER jolt (where\n;; the bb seam namespace cannot load): scripts embed this one line near their\n;; entry. Silent when JOLT_TARGET is unset, so dual-host scripts (JVM leg) and\n;; legacy invocations keep their output byte-identical.\n(def child-print-snippet\n  \"(when-let [t (System/getenv \\\"JOLT_TARGET\\\")] (println (str \\\"jolt-target: \\\" t)))\")\n\n\n(def ^:private identity-probe-forms\n  {:chez \"(do (println (str \\\"jolt-target: \\\" (or (System/getenv \\\"JOLT_TARGET\\\") \\\"chez\\\"))))\"\n   :gambit \"(begin (display \\\"jolt-target: \\\")(display (or (getenv \\\"JOLT_TARGET\\\") \\\"gambit\\\"))(newline))\"})\n\n\n(defn identity-probe-form\n  \"The -e form a trivial identity child evaluates under `target` (chez:\n   bin/jolt -e evaluates Clojure; gambit: gsi -e evaluates Scheme).\"\n  [target]\n  (get identity-probe-forms (resolve-target target)))\n\n\n(defn require-chez!\n  \"Fail-closed refusal for lanes whose children are Chez-tier only (the\n   fork's Gambit FFI tier carries no native wrapper / build CLI yet —\n   host/gambit/ffi/README.md): `lane` names the refusing driver in the error.\"\n  [target lane]\n  (when (= :gambit (resolve-target target))\n    (binding [*out* *err*]\n      (println lane \"FAILED: target gambit is not qualified for this lane;\"\n               \"the Gambit FFI tier does not carry it yet\"\n               \"(jolt fork host/gambit/ffi/README.md); refusing to run\"))\n    (System/exit 1)))\n\n\n(defn preflight!\n  \"Fail-closed identity preflight for a driver: run a trivial child through\n   the same launch seam and assert it reports `target` itself, before any\n   real child's pass/fail is trusted. `context` names the driver in errors.\n   Set :identity-opt-out true for a call that runs only JVM transcript children.\"\n  ([target context] (preflight! target context {}))\n  ([target context {:keys [identity-opt-out]}]\n   (let [t (resolve-target target)]\n     (when-not (true? identity-opt-out)\n       (let [r (run-child {:target t} \"-e\" (identity-probe-form t))]\n         (assert-child-target! {:target t\n                                :output (str (:out r) (:err r))\n                                :context context})\n         (println \"PASS identity gate: child reported\" (identity-line t))))\n     t)))\n#!/bin/sh\n# jolt — the pure-Chez jolt runtime. NO Janet.\n#\n# Compiles and evaluates jolt (Clojure) on Chez using the checked-in bootstrap\n# seed (host/chez/seed/). With only Chez installed it runs jolt end to end:\n#\n#   jolt -e \"(+ 1 2)\"             evaluate an expression\n#   jolt run -m app.core [args]   resolve deps.edn, run a namespace's -main\n#   jolt -M:alias [args]          run an alias's :main-opts\n#   jolt repl | path | <task>     REPL, print roots, or a deps.edn task\n#\n# The launcher cd's to the jolt repo root so the runtime's relative loads work;\n# the user's original cwd (the project dir, where deps.edn lives) is passed in\n# JOLT_PWD.\n#\n# $0 may be a SYMLINK. That is the natural way to put a checkout's jolt on PATH,\n# and it is what `#!/usr/bin/env jolt` executes, so follow the chain to the real\n# file before deriving the root from it: without this the root came out as the\n# symlink's own directory and the launcher died there looking for tools/version.sh\n# and host/chez/cli.ss. Hand-rolled rather than `readlink -f`, which is neither\n# POSIX nor present on older macOS.\ntarget=\"$0\"\nwhile [ -L \"$target\" ]; do\n  link=\"$(readlink \"$target\")\"\n  case \"$link\" in\n    /*) target=\"$link\" ;;\n    *)  target=\"$(CDPATH= cd -- \"$(dirname -- \"$target\")\" && pwd)/$link\" ;;\n  esac\ndone\nroot=\"$(CDPATH= cd -- \"$(dirname -- \"$target\")/..\" && pwd)\"\nexport JOLT_PWD=\"${JOLT_PWD:-$PWD}\"\n# How jolt re-invokes itself (babashka.tasks/clojure in a task). An installed\n# jolt is on PATH and needs no help; this checkout is not.\nexport JOLT_EXE=\"${JOLT_EXE:-$root/bin/jolt}\"\n\n# Identify the Chez Scheme executable. $JOLT_CHEZ is authoritative and is how the\n# Makefile hands down the one it selected — the same interpreter that mints the\n# seed and compiles target/dev/flat.so. A direct bin/jolt invocation does not\n# inherit that export, so it takes the Chez make recorded next to the dev boot\n# cache (any other pick makes that cache unusable), then the one make\n# provisioned. A Chez on PATH is never used: jolt runs on a Chez carrying its\n# kernel patches, which make builds (`make deps`) or which is passed in.\nrecorded_chez=\"\"\nif [ -f \"$root/target/dev/flat.chez\" ]; then\n  recorded_chez=\"$(cat \"$root/target/dev/flat.chez\")\"\nfi\nif [ -z \"${JOLT_CHEZ:-}\" ]; then\n  for candidate in ${recorded_chez:+\"$recorded_chez\"} \"$root\"/.cache/local/chezscheme-*/bin/scheme; do\n    [ -x \"$candidate\" ] || continue\n    case \"$(\"$candidate\" --version 2>/dev/null || true)\" in\n      10.*)\n        if [ \"$(printf '(display (threaded?))\\n' | \"$candidate\" -q 2>/dev/null)\" = \"#t\" ]; then\n          JOLT_CHEZ=\"$candidate\"\n          break\n        fi\n        ;;\n    esac\n  done\n\n  if [ -z \"${JOLT_CHEZ:-}\" ]; then\n    echo \"No Chez Scheme for jolt: run \\`make deps\\` to build the patched Chez, or set JOLT_CHEZ.\" >&2\n    exit 1\n  fi\nfi\nCHEZ=\"$JOLT_CHEZ\"\n# Resolved to a path and exported: build.ss's toolchain-dir lookup reads\n# JOLT_CHEZ from its own environment to find the csv dir next to the running\n# interpreter, rather than re-deriving it from a `command -v` PATH search that\n# can silently disagree with the interpreter actually selected above.\nexport JOLT_CHEZ=\"$(command -v \"$CHEZ\" 2>/dev/null || echo \"$CHEZ\")\"\n\n# A Chez path with its directory resolved physically, the form make records:\n# /bin/chez and /usr/bin/chez on a merged-/usr system, or a Homebrew or Nix\n# profile directory, are one Chez under two names.\nphysical_path() {\n  ( cd -P -- \"$(dirname -- \"$1\")\" 2>/dev/null && printf '%s/%s\\n' \"$(pwd -P)\" \"$(basename -- \"$1\")\" ) \\\n    || printf '%s\\n' \"$1\"\n}\n\n# Version for --version / banners: tools/version.sh (git describe of this\n# checkout against release tags, else \"dev\" — see the script for why not bare).\nexport JOLT_VERSION=\"${JOLT_VERSION:-$(\"$root/tools/version.sh\")}\"\n# Dev source mode opts OUT of the per-namespace AOT cache: the compiler is\n# volatile here (a \"dev\" version tag wouldn't invalidate the cache across edits),\n# and devboot already covers startup. A built jolt binary defaults the cache ON.\nexport JOLT_AOT_CACHE=\"${JOLT_AOT_CACHE:-0}\"\ncd \"$root\" || exit 1\n\n# Dev boot cache: precompiled target/dev/flat.so loads the runtime ~10x faster\n# than source mode. Check freshness against the input list emitted by make devboot.\n# The cache is not used for REPL (interactive stdin needed) or when the first\n# arg is \"repl\" (explicit REPL command).\n#\n# JOLT_NO_DEVCACHE=1 forces source mode with the cache present and fresh. The two\n# are not interchangeable: the cached image bakes jolt.main's require closure and\n# marks it (ldr-mark-cli-aot!), where source mode loads the same namespaces as\n# ordinary requires — so a gate that means to exercise the source-mode ordering\n# has to say so, or it silently tests the cached one instead.\nCACHE_SO=\"target/dev/flat.so\"\nCACHE_INPUTS=\"target/dev/flat.inputs\"\nCACHE_CHEZ=\"target/dev/flat.chez\"\nuse_cache=0\nif [ -z \"${JOLT_NO_DEVCACHE:-}\" ] && \\\n   [ -f \"$CACHE_SO\" ] && [ -f \"$CACHE_INPUTS\" ] && [ $# -gt 0 ] && [ \"$1\" != \"repl\" ]; then\n  stale=0\ndeps.edn:30:                           :main-opts [\"-m\" \"btree-bench\"]}\ndeps.edn:53:                  :main-opts [\"-m\" \"cognitect.test-runner\"]\ndeps.edn:58:                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\ndeps.edn:81:                  :main-opts [\"-m\" \"cljd.build\"]\ndeps.edn:85:                    :main-opts [\"-m\" \"world.server\"]}\ndeps.edn:86:           :clj-yin-repl {:main-opts [\"-m\" \"yin.shell.main\"]}\ndeps.edn:97:           :jolt-yin-repl {:main-opts [\"-m\" \"yin.shell.main\"]}\ndeps.edn:111:            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\ndeps.edn:118:                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\ndeps.edn:120:                   :main-opts [\"-m\" \"clj-kondo.main\"]}\ndeps.edn:130:                 :main-opts [\"-m\" \"debug-cljd\"]\ndeps.edn:132:           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\ndeps.edn:134:           {:main-opts  [\"-m\" \"cljd.build\"]\ndeps.edn:141:                       :main-opts [\"-m\" \"dep-graph\"]}}}\nsrc/dev/jolt_launch.clj:200:(defn preflight!\n264:  build:yin-repl-node\n273:  build:yin-repl-peer\n301:            :depends [build:yin-repl-node gen:antlr]\n309:             :depends [check:node-discovery build:yin-repl-node]\n313:             :depends [build:yin-repl-peer]\n318:                :depends [build:yin-repl-node gen:antlr]\n322:                 :depends [check:node-discovery build:yin-repl-node]\n327:                 :depends [build:yin-repl-peer]\n334:                 :depends [build:yin-repl-node gen:antlr]\n338:                  :depends [check:node-discovery build:yin-repl-node]\n349:                  :depends [build:yin-repl-peer]\n360:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n","exit_code":0,"status":"completed"}}
