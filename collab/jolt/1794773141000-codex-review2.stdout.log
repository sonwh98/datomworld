{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat build/tools/jolt-env.sh; sed -n '1,220p' src/dev/jolt_udp_probe.sh; sed -n '1,150p' src/dev/jolt_test_runner.clj; sed -n '1,160p' src/jolt/dao/stream/ws/tcp.jolt\"","aggregated_output":"# written by bb bootstrap:jolt from jolt-toolchain.edn; do not edit\nexport JOLT_CHEZ='/home/sto/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme'\nexport JOLT_HOME='/home/sto/ci/dw-j7/build/tools/jolt'\nexport JOLT_PATCHES='/home/sto/ci/dw-j7/build/tools/jolt-patches.edn'\n#!/bin/sh\n# J0b probe runner (foreground), macOS arm64 and Linux x86_64. POSIX sh\n# (Ubuntu's /bin/sh is dash). Run from the repository root.\n#\n#   JOLT       jolt binary. Default: build/tools/jolt/bin/jolt (J0a layout),\n#              else build/jolt-spike/jolt/bin/jolt (spike layout).\n#   JOLT_CHEZ  threaded Chez 10.x. Default: build/tools/jolt-env.sh's value when\n#              that file exists (J0a layout), else the mise 10.4.1 install path\n#              when present; otherwise left unset and jolt searches PATH.\ndir=$(cd \"$(dirname \"$0\")\" && pwd)\n\nif [ -z \"$JOLT_CHEZ\" ] && [ -f build/tools/jolt-env.sh ]; then\n  . build/tools/jolt-env.sh\nfi\nif [ -z \"$JOLT\" ]; then\n  if [ -x build/tools/jolt/bin/jolt ]; then\n    JOLT=build/tools/jolt/bin/jolt\n  else\n    JOLT=build/jolt-spike/jolt/bin/jolt\n  fi\nfi\nif [ -z \"$JOLT_CHEZ\" ]; then\n  mise_chez=\"$HOME/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme\"\n  [ -x \"$mise_chez\" ] && JOLT_CHEZ=$mise_chez\nfi\n[ -n \"$JOLT_CHEZ\" ] && export JOLT_CHEZ\n\njolt_home=$(cd \"$(dirname \"$JOLT\")/..\" 2>/dev/null && pwd)\necho \"jolt: $JOLT\"\necho \"jolt-sha: $(git -C \"$jolt_home\" rev-parse HEAD 2>/dev/null) dirty=$(git -C \"$jolt_home\" status --porcelain 2>/dev/null | wc -l | tr -d ' ')\"\nif [ -n \"$JOLT_CHEZ\" ]; then\n  echo \"chez: $JOLT_CHEZ $(\"$JOLT_CHEZ\" --version 2>&1)\"\nelse\n  echo \"chez: JOLT_CHEZ unset (jolt searches PATH)\"\nfi\n\ncase \"$(uname -s)\" in\n  Darwin)\n    echo \"uname: $(uname -sm) macOS $(sw_vers -productVersion 2>/dev/null)\"\n    echo \"sysctl: $(sysctl -n net.inet.udp.maxdgram net.inet.udp.recvspace kern.ipc.maxsockbuf 2>/dev/null | tr '\\n' ' ')(maxdgram recvspace maxsockbuf)\"\n    echo \"lo0 mtu: $(ifconfig lo0 2>/dev/null | sed -n 's/.*mtu \\([0-9]*\\).*/\\1/p' | head -1)\"\n    ;;\n  Linux)\n    os=$(sed -n 's/^PRETTY_NAME=\"\\(.*\\)\"$/\\1/p' /etc/os-release 2>/dev/null)\n    echo \"uname: $(uname -sm) $os\"\n    sys=\"\"\n    for k in core/wmem_default core/wmem_max core/rmem_default core/rmem_max ipv4/udp_wmem_min ipv4/udp_rmem_min ipv4/udp_mem; do\n      sys=\"$sys net.$(echo $k | tr / .)=$(tr '\\t' ' ' < /proc/sys/net/$k 2>/dev/null)\"\n    done\n    echo \"sysctl:$sys\"\n    echo \"lo mtu: $(cat /sys/class/net/lo/mtu 2>/dev/null)\"\n    ;;\n  *)\n    echo \"uname: $(uname -sm) (unsupported platform for this probe)\"\n    ;;\nesac\n\n\"$JOLT\" \"$dir/jolt_udp_probe.clj\"\nrc=$?\necho \"exit: $rc\"\nexit $rc\n;; The jolt test runner (yin.repl-jolt-implementation.md §11; J1), run UNDER\n;; jolt:\n;;\n;;   . build/tools/jolt-env.sh\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj NS...\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj --self-test\n;;\n;; How it finds the tests: it does not scan. The namespaces are the explicit\n;; command-line list (bb test:jolt-host passes the four dao.host oracle\n;; namespaces), and each is loaded by `require` through jolt's own source-root\n;; search, which the aliases set: :jolt replaces the paths with src/jolt,\n;; src/cljc, src/clj (src/jolt first, so a host override there wins) and\n;; :jolt-test adds test (the oracle) and src/dev (this runner and its\n;; sentinel). jolt resolves :extra-paths roots BEFORE the :replace-paths\n;; ones (`jolt -Srepro -Spath -A:jolt:jolt-test`: test, src/dev, src/jolt,\n;; src/cljc, src/clj); neither test nor src/dev holds a dao/host source, so\n;; the override order is unaffected. Fixture files the tests read\n;; (test/resources/...) are relative to the working directory, the\n;; repository root.\n;;\n;; Per namespace: a load failure is counted and reported, and the run goes on.\n;; Per test var, in source order: each runs through clojure.test/test-var,\n;; which reports an escaping throw as an :error, inside a second guard of this\n;; runner's own, so a throwing test never aborts the batch. Totals are tests,\n;; assertions (pass + fail + error), failures, errors and load failures; the\n;; exit status is nonzero when any of the last three is.\n;;\n;; --self-test runs the sentinel namespace jolt-runner-sentinel (a passing\n;; test, a test that throws, then a passing test) and exits 0 only when the\n;; runner counted exactly that: 3 tests, 1 error, and the test after the\n;; throwing one ran.\n(ns jolt-test-runner\n  (:require\n    [clojure.test :as t]))\n\n\n(defn- tally\n  []\n  (select-keys @t/counters [:test :pass :fail :error]))\n\n\n(defn- delta\n  [before after]\n  (merge-with - after before))\n\n\n(defn- test-vars-of\n  \"The test vars of namespace `ns-sym` in source order.\"\n  [ns-sym]\n  (->> (vals (ns-interns ns-sym))\n       (filter #(:test (meta %)))\n       (sort-by #(or (:line (meta %)) 0))))\n\n\n(defn- run-ns\n  \"Run namespace `ns-sym`; answers {:ns :load-error :counts :tests}.\"\n  [ns-sym]\n  (let [loaded (try\n                 (require ns-sym)\n                 nil\n                 (catch Throwable e e))]\n    (if loaded\n      {:ns ns-sym :load-error (str (ex-message loaded)) :counts {} :tests []}\n      (let [before (tally)\n            per-test (mapv (fn [v]\n                             (let [b (tally)]\n                               (try\n                                 (t/test-vars [v])\n                                 (catch Throwable e\n                                   ;; test-var already guards; this is the\n                                   ;; runner's own floor\n                                   (t/do-report {:type :error\n                                                 :message \"escaped test-vars\"\n                                                 :expected nil :actual e})))\n                               [(:name (meta v)) (delta b (tally))]))\n                           (test-vars-of ns-sym))]\n        {:ns ns-sym\n         :load-error nil\n         :counts (delta before (tally))\n         :tests per-test}))))\n\n\n(defn- assertions\n  [c]\n  (+ (:pass c 0) (:fail c 0) (:error c 0)))\n\n\n(defn- print-result\n  [{:keys [ns load-error counts tests]}]\n  (if load-error\n    (println \"LOAD-FAILURE\" ns \"--\" load-error)\n    (do\n      (doseq [[n c] tests]\n        (println (cond (pos? (:error c 0)) \"ERROR\"\n                       (pos? (:fail c 0)) \"FAIL \"\n                       :else \"ok   \")\n                 (str ns \"/\" n)\n                 (pr-str (select-keys c [:pass :fail :error]))))\n      (println \"NS\" ns\n               \"tests\" (count tests)\n               \"assertions\" (assertions counts)\n               \"pass\" (:pass counts 0)\n               \"fail\" (:fail counts 0)\n               \"error\" (:error counts 0)))))\n\n\n(defn run\n  \"Run `ns-syms`; answers the summary map.\"\n  [ns-syms]\n  (t/reset-report!)\n  (let [results (mapv run-ns ns-syms)\n        loaded (remove :load-error results)\n        total (fn [k] (reduce + (map #(get-in % [:counts k] 0) loaded)))\n        summary {:namespaces (count ns-syms)\n                 :load-failures (count (filter :load-error results))\n                 :tests (reduce + (map #(count (:tests %)) loaded))\n                 :assertions (reduce + (map #(assertions (:counts %)) loaded))\n                 :pass (total :pass)\n                 :fail (total :fail)\n                 :error (total :error)}]\n    (run! print-result results)\n    (doseq [line (t/failures)]\n      (println \"DETAIL\" line))\n    (println \"SUMMARY\" (pr-str summary))\n    (assoc summary :results results)))\n\n\n(defn- self-test\n  []\n  (let [{:keys [tests error results]} (run ['jolt-runner-sentinel])\n        names (mapv first (:tests (first results)))\n        after-ran? (= '[before-the-throw throws after-the-throw] names)\n        ok? (and (= 3 tests) (= 1 error) after-ran?\n                 (pos? (get-in (first results) [:tests 2 1 :pass] 0)))]\n    (println (if ok? \"SELF-TEST PASS\" \"SELF-TEST FAIL\")\n             \"a throwing test is one error and the batch continues\"\n             (pr-str {:tests tests :error error :order names}))\n    (if ok? 0 1)))\n\n\n(let [args *command-line-args*]\n  (System/exit\n    (if (= [\"--self-test\"] (vec args))\n      (self-test)\n      (let [{:keys [load-failures fail error]} (run (mapv symbol args))]\n        (if (and (seq args) (zero? (+ load-failures fail error))) 0 1)))))\n(ns dao.stream.ws.tcp\n  \"Jolt-only TCP substrate under the native WebSocket host adapter (J6d,\n   plan v2 §3; docs/design/yin.repl-jolt-implementation.md §9.3): nonblocking\n   stream sockets over `jolt.socket.native`, never the `jolt.socket` java.net\n   shim, whose write path waits for the socket to drain.\n\n   Every descriptor made here is nonblocking and close-on-exec, and carries\n   SIGPIPE suppression (SO_NOSIGPIPE on macOS from `new-socket` and\n   `guard-accepted!`, MSG_NOSIGNAL per send on Linux), so a write to a peer\n   that has gone answers an error instead of ending the process. An accepted\n   descriptor is made nonblocking explicitly: Linux does not inherit the\n   listener's mode.\n\n   Nothing here waits. Connect answers `:connecting` on EINPROGRESS and\n   `connect-result` reads SO_ERROR once the descriptor is writable; recv and\n   send are one transfer each (EINTR retried) answering data, never throwing\n   for a socket condition. End of stream, reset and broken pipe are distinct\n   classes.\n\n   Names: `parse-address` accepts IPv4 and IPv6 literals and `localhost`\n   (mapped to 127.0.0.1) and never calls the resolver (plan v2 A6); any\n   other host is `{:error :host-name-unsupported}`.\"\n  (:require\n    [clojure.string :as str]\n    [jolt.ffi :as ffi]\n    [jolt.socket.native :as native]))\n\n\n;; =============================================================================\n;; Addresses (plan v2 A6)\n;; =============================================================================\n\n(defn- literal\n  \"{:family :ip} for the numeric literal `s`, the ip in its canonical\n   presentation form, or nil. inet_pton only; no resolver.\"\n  [s]\n  (some (fn [family]\n          (when-let [[sa _] (native/make-sockaddr family s 0)]\n            (try {:family family, :ip (native/sockaddr-ip sa)}\n                 (finally (ffi/free sa)))))\n        [native/af-inet native/af-inet6]))\n\n\n(defn- literal-shaped?\n  \"Whether `s` reads as an attempted address literal rather than a name:\n   only digits and dots, or any colon.\"\n  [s]\n  (boolean (or (str/includes? s \":\") (re-matches #\"[0-9.]+\" s))))\n\n\n(defn parse-address\n  \"`{:family :ip :port}` for `host` and `port`, or `{:error kind}` with kind\n   `:host-name-unsupported` (a name other than localhost), `:malformed-address`\n   (a literal inet_pton refuses) or `:invalid-port`. A bracketed IPv6 literal\n   (`[::1]`) is accepted. Never resolves: names are decidable here and now.\"\n  [host port]\n  (let [h (when (string? host)\n            (if (and (str/starts-with? host \"[\") (str/ends-with? host \"]\"))\n              (subs host 1 (dec (count host)))\n              host))]\n    (cond\n      (not (and (int? port) (<= 0 port 65535))) {:error :invalid-port}\n      (or (nil? h) (str/blank? h)) {:error :malformed-address}\n      (= \"localhost\" (str/lower-case h)) {:family native/af-inet, :ip \"127.0.0.1\", :port port}\n      :else (if-let [lit (literal h)]\n              (assoc lit :port port)\n              {:error (if (literal-shaped? h) :malformed-address :host-name-unsupported)}))))\n\n\n(defn- with-sockaddr\n  \"(f sa len) over a fresh sockaddr for a parsed address, freed after.\"\n  [{:keys [family ip port]} f]\n  (let [[sa len] (native/make-sockaddr family ip port)]\n    (try (f sa len) (finally (ffi/free sa)))))\n\n\n;; =============================================================================\n;; Error classes\n;; =============================================================================\n\n(defn error-class\n  \"The class of socket error `e`: :reset, :broken-pipe, :refused,\n   :not-connected or :other. A reset and a broken pipe are both a peer that\n   has gone; they stay distinct for diagnostics.\"\n  [e]\n  (cond\n    (= e native/econnreset) :reset\n    (and native/epipe (= e native/epipe)) :broken-pipe\n    (= e native/econnrefused) :refused\n    (= e native/enotconn) :not-connected\n    :else :other))\n\n\n(defn- failure\n  [kind e]\n  {:error kind, :class (error-class e), :errno e, :message (native/error-message e)})\n\n\n;; =============================================================================\n;; Descriptors\n;; =============================================================================\n\n(defn close!\n  \"Close `fd` once. EINTR is not retried: on Linux the descriptor is released\n   whatever close answers, and a retry could close a reused number.\"\n  [fd]\n  (native/c-close fd)\n  nil)\n\n\n(defn shutdown!\n  \"shutdown(2) `fd` for :read, :write or :both; answers nil, ignoring\n   ENOTCONN (a peer that already went).\"\n  [fd how]\n  (native/c-shutdown fd (case how :read native/shut-rd :write native/shut-wr native/shut-rdwr))\n  nil)\n\n\n(defn- nonblocking!\n  \"O_NONBLOCK on `fd`; answers nil or the errno it failed with.\"\n  [fd]\n  (let [[r e] (native/set-blocking! fd false)]\n    (when (neg? r) e)))\n\n\n(defn- open-socket\n  \"A fresh nonblocking, close-on-exec stream socket of `family`, or a\n   failure map.\"\n  [family]\n  (let [fd (try (native/new-socket family) (catch Throwable _ nil))]\n    (if (nil? fd)\n      {:error :socket-failed}\n      (if-let [e (nonblocking! fd)]\n        (do (close! fd) (failure :socket-failed e))\n        {:fd fd}))))\n\n\n(defn local-port\n  \"The port `fd` is bound to (the kernel's pick after port 0), or -1.\"\n  [fd]\n  (native/local-port fd))\n\n\n(defn nonblocking?\n  \"Whether `fd` has O_NONBLOCK set, read back with F_GETFL.\"\n  [fd]\n  (let [[flags _] (native/c-fcntl fd 3 0)]\n    (and (not (neg? flags))\n         (pos? (bit-and flags (if (= native/os :macos) 0x4 0x800))))))\n\n\n;; =============================================================================\n;; Listener\n;; =============================================================================\n\n(defn listen!\n  \"A nonblocking listener on the parsed `addr` (`parse-address`):\n   `{:fd :port}` with the actual port, or a failure map (`:error`\n   `:bind-failed`/`:listen-failed`/`:socket-failed`). The descriptor is\n   closed on failure.\"\n","exit_code":0,"status":"completed"}}
