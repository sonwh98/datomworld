discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\nbb.edn:287:  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\nbb.edn:289:             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\nbb.edn:291:  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\nbb.edn:295:  ;; Every test, slow ones included (about 20+ minutes on the JVM).\nbb.edn:296:  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\nbb.edn:298:                :task (shell \"clojure -M:test\")}\nbb.edn:300:  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\nbb.edn:303:                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\nbb.edn:305:  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\nbb.edn:310:  ;; Only the slow tests. Node and Dart select by namespace, so the other\nbb.edn:311:  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.\nbb.edn:312:  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\nbb.edn:314:                 :task (shell \"clojure -M:test -i :slow\")}\nbb.edn:316:  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\nbb.edn:324:                                 \"compile\" \"test\" \"--config-merge\"\nbb.edn:327:  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\nbb.edn:332:  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\nbb.edn:333:             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\nbb.edn:335:  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\nbb.edn:336:            :depends [test:all:clj test:all:cljs test:all:cljd]}\nbb.edn:338:  test {:doc \"All three lanes in their fast default form (JVM, Node, Dart)\"\nbb.edn:339:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\nbb.edn:341:  test:quick-sharded\nbb.edn:347:  test:routed\nbb.edn:348:  {:doc \"Dispatch changed files by risk: docs checks, changed tests, sharded JVM or full tri-host; --dry-run plans only\"\nbb.edn:351:                         \"-m\" \"test-routed\" *command-line-args*)))}\nbb.edn:353:  ;; Only the tests a change can affect (src/dev/affected.clj): the\nbb.edn:356:  ;; Exit 2 on a wide change (deps.edn, bb.edn, src/dev/, ...): run bb test.\nbb.edn:357:  test:changed {:doc \"Fast tests a change can affect, three lanes in parallel\"\nbb.edn:364:  test:changed:clj {:doc \"JVM lane of test:changed\"\nbb.edn:370:  test:changed:cljs {:doc \"Node lane of test:changed\"\nbb.edn:378:  test:changed:cljd {:doc \"Dart lane of test:changed\"\nbb.edn:385:  test:changed:list {:doc \"What test:changed would run and why; runs nothing\"\nbb.edn:391:  ;; Subsystem tests (src/dev/affected.clj): canonical subsystems defined\nbb.edn:394:  test:sub {:doc \"Subsystem tests, three lanes in parallel: bb test:sub <subsystem>... [--slow]\"\nbb.edn:404:  test:sub:clj {:doc \"JVM lane of test:sub: bb test:sub:clj <subsystem>... [--slow]\"\nbb.edn:414:  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\nbb.edn:425:  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\nbb.edn:435:  test:sub:list {:doc \"What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>...\"\ndeps.edn:31:           :test {:extra-paths [\"test\"]\ndeps.edn:32:                  :extra-deps {io.github.cognitect-labs/test-runner\ndeps.edn:43:                  ;; before it can raise Python's RecursionError, so the same tests\ndeps.edn:50:                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\ndeps.edn:53:                  :main-opts [\"-m\" \"cognitect.test-runner\"]\ndeps.edn:54:                  :exec-fn cognitect.test-runner.api/test}\ndeps.edn:55:           :nREPL {:extra-paths [\"test\"]\ndeps.edn:59:           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\" \"build/antlr/php/js\"]\ndeps.edn:80:           :cljd {:extra-paths [\"test\"]\ndeps.edn:87:           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\ndeps.edn:88:           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\ndeps.edn:89:           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\ndeps.edn:91:           ;; are selected away by :jolt reader branches, never loaded). No\ndeps.edn:93:           ;; dependency coordinate is fetched until a jolt-loaded namespace\ndeps.edn:95:           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\ndeps.edn:97:           :jolt-yin-repl {:main-opts [\"-m\" \"yin.shell.main\"]}\ndeps.edn:98:           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\ndeps.edn:99:           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\ndeps.edn:100:           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\ndeps.edn:101:           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\ndeps.edn:103:           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\ndeps.edn:104:           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\ndeps.edn:105:           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\ndeps.edn:107:           {:extra-paths [\"test\" \"src/dev\"]\ndeps.edn:124:           :oracle {:extra-paths [\"src/dev\" \"test\"]\ndeps.edn:129:           :dbg {:extra-paths [\"test\"]\ndeps.edn:149:;; clj -M:test\ndeps.edn:150:;; clj -M:test -n yin.vm-literal-test\ndeps.edn:151:;; clj -M:test -n yin.vm-continuation-test\ndeps.edn:152:;; clj -M:test -n yin.repl.python-antlr-test\ndeps.edn:153:;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\ndeps.edn:154:;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\ndeps.edn:158:;; npx shadow-cljs compile test && node target/node-tests.js\n/usr/local/bin/clojure\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat src/jolt/dao/stream/udp.jolt && cat src/cljc/dao/stream/udp.cljc && cat src/jolt/dao/posix/random.jolt'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat src/jolt/dao/stream/udp.jolt && cat src/cljc/dao/stream/udp.cljc && cat src/jolt/dao/posix/random.jolt'","aggregated_output":"(ns dao.stream.udp\n  \"The jolt native datagram host seam and UDP value channel facade\n   (docs/design/dao.stream.datagram.md §§3-7; J7 architecture findings).\n\n   Exposes the shared value channel API from `dao.stream.udp.common`,\n   `UdpHandle`, `make-attacher`, and the production native datagram `bind!`.\"\n  (:require\n    [clojure.string :as str]\n    [dao.host.bytes :as bytes]\n    [dao.stream :as stream]\n    [dao.stream.datagram :as datagram]\n    [dao.stream.udp.common :as common]\n    [jolt.ffi :as ffi]\n    [jolt.io-poller :as poller]\n    [jolt.socket.native :as native]))\n\n\n;; =============================================================================\n;; Re-export common value-channel surface\n;; =============================================================================\n\n(def transport-type common/transport-type)\n(def max-datagram common/max-datagram)\n(def default-max-message-bytes common/default-max-message-bytes)\n(def default-max-partial-messages common/default-max-partial-messages)\n(def default-step-budget common/default-step-budget)\n\n(def descriptor? common/descriptor?)\n(def address-key common/address-key)\n(def make-port common/make-port)\n(def send-value! common/send-value!)\n(def send-to! common/send-to!)\n(def receive! common/receive!)\n(def projection common/projection)\n(def step! common/step!)\n(def reading-cursor common/reading-cursor)\n\n(defn port-step!\n  ([port] (common/port-step! port))\n  ([port budget] (common/port-step! port budget)))\n\n\n(deftype UdpHandle\n  [port host dest-port descriptor]\n\n  stream/IDaoStreamDescriptor\n\n  (descriptor\n    [_]\n    {:dao.stream/outcome :dao.stream/ok\n     :dao.stream/descriptor descriptor\n     :dao.stream/identity (:dao.stream/identity descriptor)})\n\n\n  stream/IDaoStreamWriter\n\n  (append!\n    [_ v]\n    (common/send-value! port host dest-port v)))\n\n\n(defn make-attacher\n  [config]\n  (common/make-attacher ->UdpHandle config))\n\n\n;; =============================================================================\n;; Native Datagram Constants and Syscalls\n;; =============================================================================\n\n(def platform native/os)\n\n(def consts\n  (case platform\n    :macos {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 0x1001 :so-rcvbuf 0x1002\n            :eagain 35 :emsgsize 40 :enobufs 55 :ebadf 9}\n    :linux {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 7 :so-rcvbuf 8\n            :eagain 11 :emsgsize 90 :enobufs 105 :ebadf 9}\n    (throw (ex-info \"dao.stream.udp: unsupported platform\" {:platform platform}))))\n\n(def SOCK-DGRAM (:sock-dgram consts))\n(def IPPROTO-UDP (:ipproto-udp consts))\n(def EAGAIN (:eagain consts))\n(def ENOBUFS (:enobufs consts))\n(def EMSGSIZE (:emsgsize consts))\n(def EBADF (:ebadf consts))\n\n(ffi/defcfn c-sendto \"sendto\" [:int :pointer :size_t :int :pointer :uint] :ssize_t\n            {:capture-native-error true})\n\n(ffi/defcfn c-recvfrom \"recvfrom\" [:int :pointer :size_t :int :pointer :pointer] :ssize_t\n            {:capture-native-error true})\n\n(def ^:dynamic *sendto* c-sendto)\n(def ^:dynamic *recvfrom* c-recvfrom)\n\n\n;; =============================================================================\n;; Helpers\n;; =============================================================================\n\n(defn- parse-literal-host\n  \"Parse literal IP host (IPv4 or IPv6), stripping brackets if present.\n   Rejects hostnames like 'localhost'.\"\n  [h]\n  (when (string? h)\n    (let [clean (if (and (str/starts-with? h \"[\") (str/ends-with? h \"]\"))\n                  (subs h 1 (dec (count h)))\n                  h)]\n      (if-let [[sa _] (native/make-sockaddr native/af-inet clean 0)]\n        (do (ffi/free sa) {:family native/af-inet :ip clean})\n        (if-let [[sa _] (native/make-sockaddr native/af-inet6 clean 0)]\n          (do (ffi/free sa) {:family native/af-inet6 :ip clean})\n          nil)))))\n\n\n(defn- deposit-event!\n  [deposit event]\n  (try\n    (stream/append! deposit event)\n    (catch Throwable _ nil)))\n\n\n(defn- failed-seam\n  [deposit identity reason]\n  (deposit-event! deposit (datagram/bind-failed-event identity reason))\n  {:send! (fn [_ _ _]\n            {:dao.stream/outcome :dao.stream/transport-error\n             :dao.stream.datagram/reason \"bind failed\"})\n   :close! (fn [] nil)\n   :step! (fn [] {:progressed? false})})\n\n\n;; =============================================================================\n;; Native Datagram Seam bind!\n;; =============================================================================\n\n(defn bind!\n  \"Bind one native datagram socket per the seam contract (§3).\n   `:bind-host` defaults to '127.0.0.1', `:bind-port` to 0 (ephemeral),\n   `:max-bytes` to 1200.\n   Returns {:send! f :close! f :step! f}.\"\n  [{:keys [identity deposit bind-host bind-port max-bytes]\n    :or {bind-host \"127.0.0.1\" bind-port 0}}]\n  (let [max-bytes (long (or max-bytes datagram/default-max-bytes))\n        parsed-bind (parse-literal-host bind-host)]\n    (if-not parsed-bind\n      (failed-seam deposit identity (str \"invalid bind-host literal: \" (pr-str bind-host)))\n      (let [family (:family parsed-bind)\n            bind-ip (:ip parsed-bind)\n            [fd sock-err] (native/c-socket family SOCK-DGRAM IPPROTO-UDP)]\n        (if (neg? fd)\n          (failed-seam deposit identity (str \"socket failed: errno \" sock-err))\n          (let [[r-nb err-nb] (do\n                                (native/close-on-exec! fd)\n                                (native/set-blocking! fd false))]\n            (if (neg? r-nb)\n              (do (native/c-close fd)\n                  (failed-seam deposit identity (str \"O_NONBLOCK failed: errno \" err-nb)))\n              (do\n                (when (= family native/af-inet6)\n                  (native/set-int-option! fd native/ipproto-ipv6 native/ipv6-v6only 1))\n                (let [[sa len] (native/make-sockaddr family bind-ip bind-port)]\n                  (if-not sa\n                    (do (native/c-close fd)\n                        (failed-seam deposit identity (str \"make-sockaddr failed for \" bind-ip \":\" bind-port)))\n                    (let [[bind-r bind-err] (try\n                                              (native/c-bind fd sa len)\n                                              (finally (ffi/free sa)))]\n                      (if (neg? bind-r)\n                        (do (native/c-close fd)\n                            (failed-seam deposit identity (str \"bind failed: errno \" bind-err)))\n                        (let [local (native/local-address fd)]\n                          (if-not local\n                            (do (native/c-close fd)\n                                (failed-seam deposit identity \"getsockname failed\"))\n                            (let [closed? (atom false)\n                                  close-fn\n                                  (fn []\n                                    (when (compare-and-set! closed? false true)\n                                      (try (poller/cancel! fd) (catch Throwable _ nil))\n                                      (try (poller/forget! fd) (catch Throwable _ nil))\n                                      (native/c-close fd)\n                                      (deposit-event! deposit (datagram/closed-event identity)))\n                                    nil)\n\n                                  send-fn\n                                  (fn [dest-host dest-port ^bytes payload]\n                                    (if @closed?\n                                      {:dao.stream/outcome :dao.stream/closed}\n                                      (let [parsed-dest (parse-literal-host dest-host)]\n                                        (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))\n                                          (let [reason \"IP family mismatch\"]\n                                            (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                            {:dao.stream/outcome :dao.stream/transport-error\n                                             :dao.stream.datagram/reason reason})\n                                          (let [len (bytes/length payload)\n                                                buf (ffi/alloc (max 1 len))\n                                                [dsa dlen] (native/make-sockaddr family (:ip parsed-dest) dest-port)]\n                                            (try\n                                              (if-not dsa\n                                                (let [reason \"make-sockaddr failed for destination\"]\n                                                  (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                  {:dao.stream/outcome :dao.stream/transport-error\n                                                   :dao.stream.datagram/reason reason})\n                                                (do\n                                                  (when (pos? len)\n                                                    (ffi/write-array buf payload))\n                                                  (let [[n e] (*sendto* fd buf len 0 dsa dlen)]\n                                                    (cond\n                                                      (neg? n)\n                                                      (let [reason (str \"sendto failed: errno \" e)]\n                                                        (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                        {:dao.stream/outcome :dao.stream/transport-error\n                                                         :dao.stream.datagram/reason reason})\n\n                                                      (not= n len)\n                                                      (let [reason (str \"short send: sent \" n \" of \" len \" bytes\")]\n                                                        (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                        {:dao.stream/outcome :dao.stream/transport-error\n                                                         :dao.stream.datagram/reason reason})\n\n                                                      :else\n                                                      {:dao.stream/outcome :dao.stream/ok}))))\n                                              (finally\n                                                (ffi/free buf)\n                                                (when dsa (ffi/free dsa)))))))))\n\n                                  step-fn\n                                  (fn []\n                                    (if @closed?\n                                      {:progressed? false}\n                                      (let [cap (inc max-bytes)\n                                            buf (ffi/alloc cap)\n                                            [rsa rlenp] (native/alloc-sockaddr)\n                                            progressed? (volatile! false)]\n                                        (try\n                                          (loop [budget 64]\n                                            (if (pos? budget)\n                                              (do\n                                                (ffi/write rlenp :int native/sockaddr-storage-size 0)\n                                                (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]\n                                                  (cond\n                                                    (neg? n)\n                                                    (when-not (or (= e EAGAIN) (= e ENOBUFS))\n                                                      (when (= e EBADF)\n                                                        (close-fn)))\n\n                                                    :else\n                                                    (do\n                                                      (vreset! progressed? true)\n                                                      (if (> n max-bytes)\n                                                        ;; Oversize drop\n                                                        (recur (dec budget))\n                                                        (let [bs (if (zero? n)\n                                                                   (bytes/alloc 0)\n                                                                   (ffi/read-array buf n))\n                                                              src-ip (native/sockaddr-ip rsa)\n                                                              src-port (native/sockaddr-port rsa)]\n                                                          (deposit-event! deposit\n                                                                          (datagram/datagram-event identity src-ip src-port bs))\n                                                          (recur (dec budget))))))))\n                                              nil))\n                                          (finally\n                                            (ffi/free buf)\n                                            (ffi/free rsa)\n                                            (ffi/free rlenp)))\n                                        {:progressed? @progressed?})))\n                                  seam {:send! send-fn\n                                        :close! close-fn\n                                        :step! step-fn}]\n                              (deposit-event! deposit (datagram/bound-event identity (:ip local) (:port local)))\n                              seam)))))))))))))))\n(ns dao.stream.udp\n  \"The UDP channel of dao.stream.remote.md (3.2), rebuilt on the raw\n   datagram layer (docs/design/dao.stream.datagram.md 7): the WebSocket\n   deposit model over a socket that retains nothing, with the raw layer\n   beneath it feeding and carrying it.\n\n   Public facade delegating host-free value-channel logic to\n   `dao.stream.udp.common`.\"\n  (:require [dao.stream :as stream]\n            [dao.stream.udp.common :as common]))\n\n\n(def transport-type common/transport-type)\n(def max-datagram common/max-datagram)\n(def default-max-message-bytes common/default-max-message-bytes)\n(def default-max-partial-messages common/default-max-partial-messages)\n(def default-step-budget common/default-step-budget)\n\n(def descriptor? common/descriptor?)\n(def address-key common/address-key)\n(def make-port common/make-port)\n(def send-value! common/send-value!)\n(def send-to! common/send-to!)\n(def receive! common/receive!)\n(def projection common/projection)\n(def step! common/step!)\n(def reading-cursor common/reading-cursor)\n\n(defn port-step!\n  ([port] (common/port-step! port))\n  ([port budget] (common/port-step! port budget)))\n\n\n;; =============================================================================\n;; The writer handle and attacher\n;; =============================================================================\n\n(deftype UdpHandle\n  [port host dest-port descriptor]\n\n  stream/IDaoStreamDescriptor\n\n  (descriptor\n    [_]\n    {:dao.stream/outcome :dao.stream/ok\n     :dao.stream/descriptor descriptor\n     :dao.stream/identity (:dao.stream/identity descriptor)})\n\n\n  stream/IDaoStreamWriter\n\n  (append!\n    [_ v]\n    (common/send-value! port host dest-port v)))\n\n\n(defn make-attacher\n  \"Construct the host-composed unary `attach!` entry point: `:port` is\n   an already-composed `make-port` value. `attach!` binds or reuses it\n   -- one port serves every descriptor a composition attaches through\n   it -- and answers at once with a writer handle whose `append!` sends\n   toward the descriptor's address.\"\n  [config]\n  (common/make-attacher ->UdpHandle config))\n(ns dao.posix.random\n  \"Fresh-entropy adapter for jolt drawing random bytes from the qualified\n   libcrypto CSPRNG wrapper (jolt_crypto_random).\n   dao.space and yin.vm both use this seam.\"\n  (:require\n    [clojure.string :as str]\n    [dao.host.bytes :as bytes]\n    [dao.host.hash]\n    [jolt.ffi :as ffi]))\n\n\n(def ^:private library\n  (let [os (str/lower-case (or (System/getProperty \"os.name\") \"\"))\n        arch (System/getProperty \"os.arch\")\n        darwin? (str/includes? os \"mac\")]\n    (str (System/getProperty \"user.dir\") \"/build/native/\"\n         (if darwin? \"darwin\" \"linux\") \"-\"\n         (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\")\n         \"/jolt-crypto/lib/libjolt_crypto\" (if darwin? \".dylib\" \".so\"))))\n\n\n(ffi/load-library library)\n\n\n(ffi/defcfn ^:private c-random \"jolt_crypto_random\"\n            [:pointer :size_t] :int :blocking)\n\n\n(ffi/defcfn ^:private c-cleanse \"jolt_crypto_cleanse\" [:pointer :size_t] :void)\n\n\n(defn rand-bytes\n  \"A fresh jolt byte array of `n` random bytes (n >= 0) from the qualified\n   libcrypto's CSPRNG. Randomness failure is an error: a nonzero wrapper\n   status throws.\"\n  [n]\n  (when (neg? n)\n    (throw (ex-info \"dao.posix.random/rand-bytes negative count\" {:n n})))\n  (let [size (max 1 n)\n        p (ffi/alloc size)]\n    (try\n      (when (ffi/null? p)\n        (throw (ex-info \"jolt-crypto native allocation failed\" {:bytes n})))\n      (let [status (c-random p n)]\n        (when-not (zero? status)\n          (throw (ex-info \"jolt-crypto random failed\" {:entry 'rand-bytes\n                                                       :status status})))\n        (if (pos? n) (ffi/read-array p n) (bytes/alloc 0)))\n      (finally\n        (try (c-cleanse p size)\n             (finally (ffi/free p)))))))\n","exit_code":0,"status":"completed"}}
