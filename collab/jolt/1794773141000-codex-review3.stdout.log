  node (tick node now)\n           [node bound] (bind-step node)\n           node (admit-repairs node)\n           [node unknown] (admit-ledger node)\ndiff --git a/src/cljc/yin/shell/dht.cljc b/src/cljc/yin/shell/dht.cljc\nindex 7e6da9b4..460919c6 100644\n--- a/src/cljc/yin/shell/dht.cljc\n+++ b/src/cljc/yin/shell/dht.cljc\n@@ -249,12 +249,7 @@\n    (docs/design/yin.repl.dht-composition.md section 6).\"\n   [spec]\n   ;; jolt: a :file store opens since J4; this composition needs J7's UDP\n-  ;; transport, so it is refused here, where a spec is checked for\n-  ;; composition, after every flag has been parsed and validated as on\n-  ;; the other hosts\n-  #?(:jolt\n-     (throw (ex-info \"the dht: index store arrives at J7 on jolt\"\n-                     {:spec spec})))\n+  ;; transport, joined in J7\n   (if (and (map? spec) (= :dht (:type spec)))\n     (let [spec (merge dht-defaults spec)]\n       (if-some [refusal (dht-refusal spec)]\n@@ -880,8 +875,15 @@\n ;; =============================================================================\n \n (def ^:private board-codec\n-  \"The head board's wire profile.\"\n-  (:transit connect/codec-profiles))\n+  \"The head board's dial profile: CBOR on every host.\"\n+  (:cbor connect/codec-profiles))\n+\n+\n+(def ^:private board-codecs\n+  \"Profiles served by the head board: CBOR first on every host, plus Transit where supported.\"\n+  (into [(:cbor connect/codec-profiles)]\n+        (when-let [t (:transit connect/codec-profiles)]\n+          [t])))\n \n \n (defn- serve-board\n@@ -892,7 +894,7 @@\n                                   :principal (:principal pub)\n                                   :spec {:host host :port port}\n                                   :host ws\n-                                  :codecs [board-codec]})]\n+                                  :codecs board-codecs})]\n     [(assoc pub :server server :listen [host port])\n      (when (= :refused (:status server))\n        [(case (:reason server)\ndiff --git a/src/jolt/yin/vm/linker/random.jolt b/src/jolt/yin/vm/linker/random.jolt\nindex 9bd66081..2c478cf7 100644\n--- a/src/jolt/yin/vm/linker/random.jolt\n+++ b/src/jolt/yin/vm/linker/random.jolt\n@@ -1,65 +1,10 @@\n (ns yin.vm.linker.random\n   \"The jolt-only fresh-entropy adapter behind `yin.vm.linker.sign/generate`'s\n-   `:jolt` arm (owner ruling of 2026-10-22, collab/1792655000000).\n-\n-   Fresh key generation stays in `yin.vm.linker.sign` (the deferred entropy\n-   design, yin.repl-jolt-implementation.md 9.1); this namespace is the narrow\n-   bridge that makes its jolt arm draw seed bytes from the SAME qualified\n-   system libcrypto every dao.host.hash / dao.host.sign call already resolved\n-   to, through the native/jolt-crypto wrapper's `jolt_crypto_random`\n-   (libcrypto RAND_bytes). jolt's own java.security.SecureRandom shim\n-   (host/chez/java/host-static-classes.ss, /dev/urandom backed) exists and\n-   works at this pin, but it sits outside the provenance gate, so this\n-   namespace requires `dao.host.hash` first — no seed byte is drawn before\n-   that gate has passed, exactly the dao.host.sign discipline — and a failed\n-   draw is an error (ex-info), never a silent substitute.\"\n-  (:require\n-    [clojure.string :as str]\n-    [dao.host.bytes :as bytes]\n-    ;; loaded for its provenance gate, which must pass before any draw\n-    [dao.host.hash]\n-    [jolt.ffi :as ffi]))\n-\n-\n-(def ^:private library\n-  ;; the same wrapper dao.host.hash loaded and qualified (jolt's os.name and\n-  ;; os.arch shim can answer nil, which reads as Linux and x86_64)\n-  (let [os (str/lower-case (or (System/getProperty \"os.name\") \"\"))\n-        arch (System/getProperty \"os.arch\")\n-        darwin? (str/includes? os \"mac\")]\n-    (str (System/getProperty \"user.dir\") \"/build/native/\"\n-         (if darwin? \"darwin\" \"linux\") \"-\"\n-         (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\")\n-         \"/jolt-crypto/lib/libjolt_crypto\" (if darwin? \".dylib\" \".so\"))))\n-\n-\n-(ffi/load-library library)\n-\n-\n-(ffi/defcfn ^:private c-random \"jolt_crypto_random\"\n-            [:pointer :size_t] :int :blocking)\n-\n-\n-(ffi/defcfn ^:private c-cleanse \"jolt_crypto_cleanse\" [:pointer :size_t] :void)\n+   `:jolt` arm, delegating to `dao.posix.random/rand-bytes`.\"\n+  (:require [dao.posix.random :as posix.random]))\n \n \n (defn rand-bytes\n-  \"A fresh jolt byte array of `n` random bytes (n >= 0) from the qualified\n-   libcrypto's CSPRNG. Randomness failure is an error: a nonzero wrapper\n-   status throws.\"\n+  \"Delegates to `dao.posix.random/rand-bytes`.\"\n   [n]\n-  (when (neg? n)\n-    (throw (ex-info \"yin.vm.linker.random/rand-bytes negative count\" {:n n})))\n-  (let [size (max 1 n)\n-        p (ffi/alloc size)]\n-    (try\n-      (when (ffi/null? p)\n-        (throw (ex-info \"jolt-crypto native allocation failed\" {:bytes n})))\n-      (let [status (c-random p n)]\n-        (when-not (zero? status)\n-          (throw (ex-info \"jolt-crypto random failed\" {:entry 'rand-bytes\n-                                                       :status status})))\n-        (if (pos? n) (ffi/read-array p n) (bytes/alloc 0)))\n-      (finally\n-        (try (c-cleanse p size)\n-             (finally (ffi/free p)))))))\n+  (posix.random/rand-bytes n))\n     1\t(ns dao.stream.udp\n     2\t  \"The jolt native datagram host seam and UDP value channel facade\n     3\t   (docs/design/dao.stream.datagram.md §§3-7; J7 architecture findings).\n     4\t\n     5\t   Exposes the shared value channel API from `dao.stream.udp.common`,\n     6\t   `UdpHandle`, `make-attacher`, and the production native datagram `bind!`.\"\n     7\t  (:require\n     8\t    [clojure.string :as str]\n     9\t    [dao.host.bytes :as bytes]\n    10\t    [dao.stream :as stream]\n    11\t    [dao.stream.datagram :as datagram]\n    12\t    [dao.stream.udp.common :as common]\n    13\t    [jolt.ffi :as ffi]\n    14\t    [jolt.io-poller :as poller]