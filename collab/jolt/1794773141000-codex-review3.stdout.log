\n   112\t        (if-let [[sa _] (native/make-sockaddr native/af-inet6 clean 0)]\n   113\t          (do (ffi/free sa) {:family native/af-inet6 :ip clean})\n   114\t          nil)))))\n   115\t\n   116\t\n   117\t(defn- deposit-event!\n   118\t  [deposit event]\n   119\t  (try\n   120\t    (stream/append! deposit event)\n   121\t    (catch Throwable _ nil)))\n   122\t\n   123\t\n   124\t(defn- failed-seam\n   125\t  [deposit identity reason]\n   126\t  (deposit-event! deposit (datagram/bind-failed-event identity reason))\n   127\t  {:send! (fn [_ _ _]\n   128\t            {:dao.stream/outcome :dao.stream/transport-error\n   129\t             :dao.stream.datagram/reason \"bind failed\"})\n   130\t   :close! (fn [] nil)\n   131\t   :step! (fn [] {:progressed? false})})\n   132\t\n   133\t\n   134\t;; =============================================================================\n   135\t;; Native Datagram Seam bind!\n   136\t;; =============================================================================\n   137\t\n   138\t(defn bind!\n   139\t  \"Bind one native datagram socket per the seam contract (§3).\n   140\t   `:bind-host` defaults to '127.0.0.1', `:bind-port` to 0 (ephemeral),\n   141\t   `:max-bytes` to 1200.\n   142\t   Returns {:send! f :close! f :step! f}.\"\n   143\t  [{:keys [identity deposit bind-host bind-port max-bytes]\n   144\t    :or {bind-host \"127.0.0.1\" bind-port 0}}]\n   145\t  (let [max-bytes (long (or max-bytes datagram/default-max-bytes))\n   146\t        parsed-bind (parse-literal-host bind-host)]\n   147\t    (if-not parsed-bind\n   148\t      (failed-seam deposit identity (str \"invalid bind-host literal: \" (pr-str bind-host)))\n   149\t      (let [family (:family parsed-bind)\n   150\t            bind-ip (:ip parsed-bind)\n   151\t            [fd sock-err] (native/c-socket family SOCK-DGRAM IPPROTO-UDP)]\n   152\t        (if (neg? fd)\n   153\t          (failed-seam deposit identity (str \"socket failed: errno \" sock-err))\n   154\t          (let [[r-nb err-nb] (do\n   155\t                                (native/close-on-exec! fd)\n   156\t                                (native/set-blocking! fd false))]\n   157\t            (if (neg? r-nb)\n   158\t              (do (native/c-close fd)\n   159\t                  (failed-seam deposit identity (str \"O_NONBLOCK failed: errno \" err-nb)))\n   160\t              (do\n   161\t                (when (= family native/af-inet6)\n   162\t                  (native/set-int-option! fd native/ipproto-ipv6 native/ipv6-v6only 1))\n   163\t                (let [[sa len] (native/make-sockaddr family bind-ip bind-port)]\n   164\t                  (if-not sa\n   165\t                    (do (native/c-close fd)\n   166\t                        (failed-seam deposit identity (str \"make-sockaddr failed for \" bind-ip \":\" bind-port)))\n   167\t                    (let [[bind-r bind-err] (try\n   168\t                                              (native/c-bind fd sa len)\n   169\t                                              (finally (ffi/free sa)))]\n   170\t                      (if (neg? bind-r)\n   171\t                        (do (native/c-close fd)\n   172\t                            (failed-seam deposit identity (str \"bind failed: errno \" bind-err)))\n   173\t                        (let [local (native/local-address fd)]\n   174\t                          (if-not local\n   175\t                            (do (native/c-close fd)\n   176\t                                (failed-seam deposit identity \"getsockname failed\"))\n   177\t                            (let [closed? (atom false)\n   178\t                                  close-fn\n   179\t                                  (fn []\n   180\t                                    (when (compare-and-set! closed? false true)\n   181\t                                      (try (poller/cancel! fd) (catch Throwable _ nil))\n   182\t                                      (try (poller/forget! fd) (catch Throwable _ nil))\n   183\t                                      (native/c-close fd)\n   184\t                                      (deposit-event! deposit (datagram/closed-event identity)))\n   185\t                                    nil)\n   186\t\n   187\t                                  send-fn\n   188\t                                  (fn [dest-host dest-port ^bytes payload]\n   189\t                                    (if @closed?\n   190\t                                      {:dao.stream/outcome :dao.stream/closed}\n   191\t                                      (let [parsed-dest (parse-literal-host dest-host)]\n   192\t                                        (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))\n   193\t                                          (let [reason \"IP family mismatch\"]\n   194\t                                            (deposit-event! deposit (datagram/send-failed-event identity reason))\n   195\t                                            {:dao.stream/outcome :dao.stream/transport-error\n   196\t                                             :dao.stream.datagram/reason reason})\n   197\t                                          (let [len (bytes/length payload)\n   198\t                                                buf (ffi/alloc (max 1 len))\n   199\t                                                [dsa dlen] (native/make-sockaddr family (:ip parsed-dest) dest-port)]\n   200\t                                            (try\n   201\t                                              (if-not dsa\n   202\t                                                (let [reason \"make-sockaddr failed for destination\"]\n   203\t                                                  (deposit-event! deposit (datagram/send-failed-event identity reason))\n   204\t                                                  {:dao.stream/outcome :dao.stream/transport-error\n   205\t                                                   :dao.stream.datagram/reason reason})\n   206\t                                                (do\n   207\t                                                  (when (pos? len)\n   208\t                                                    (ffi/write-array buf payload))\n   209\t                                                  (let [[n e] (*sendto* fd buf len 0 dsa dlen)]\n   210\t                                                    (cond\n   211\t                                                      (neg? n)\n   212\t                                                      (let [reason (str \"sendto failed: errno \" e)]\n   213\t                                                        (deposit-event! deposit (datagram/send-failed-event identity reason))\n   214\t                                                        {:dao.stream/outcome :dao.stream/transport-error\n   215\t                                                         :dao.stream.datagram/reason reason})\n   216\t\n   217\t                                                      (not= n len)\n   218\t                                                      (let [reason (str \"short send: sent \" n \" of \" len \" bytes\")]\n   219\t                                                        (deposit-event! deposit (datagram/send-failed-event identity reason))\n   220\t                                                        {:dao.stream/outcome :dao.stream/transport-error\n   221\t                                                         :dao.stream.datagram/reason reason})\n   222\t\n   223\t                                                      :else\n   224\t                                                      {:dao.stream/outcome :dao.stream/ok}))))\n   225\t                                              (finally\n   226\t                                                (ffi/free buf)\n   227\t                                                (when dsa (ffi/free dsa)))))))))\n   228\t\n   229\t                                  step-fn\n   230\t                                  (fn []\n   231\t                                    (if @closed?\n   232\t                                      {:progressed? false}\n   233\t                                      (let [cap (inc max-bytes)\n   234\t                                            buf (ffi/alloc cap)\n   235\t                                            [rsa rlenp] (native/alloc-sockaddr)\n   236\t                                            progressed? (volatile! false)]\n   237\t                                        (try\n   238\t                                          (loop [budget 64]\n   239\t                                            (if (pos? budget)\n   240\t                                              (do\n   241\t                                                (ffi/write rlenp :int native/sockaddr-storage-size 0)\n   242\t                                                (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]\n   243\t                                                  (cond\n   244\t                                                    (neg? n)\n   245\t                                                    (when-not (or (= e EAGAIN) (= e ENOBUFS))\n   246\t                                                      (when (= e EBADF)\n   247\t                                                        (close-fn)))\n   248\t\n   249\t                                                    :else\n   250\t                                                    (do\n   251\t                                                      (vreset! progressed? true)\n   252\t                                                      (if (> n max-bytes)\n   253\t                                                        ;; Oversize drop\n   254\t                                                        (recur (dec budget))\n   255\t                                                        (let [bs (if (zero? n)\n   256\t                                                                   (bytes/alloc 0)\n   257\t                                                                   (ffi/read-array buf n))\n   258\t                                                              src-ip (native/sockaddr-ip rsa)\n   259\t                                                              src-port (native/sockaddr-port rsa)]\n   260\t                                                          (deposit-event! deposit\n   261\t                                                                          (datagram/datagram-event identity src-ip src-port bs))\n   262\t                                                          (recur (dec budget))))))))\n   263\t                                              nil))\n   264\t                                          (finally\n   265\t                                            (ffi/free buf)\n   266\t                                            (ffi/free rsa)\n   267\t                                            (ffi/free rlenp)))\n   268\t                                        {:progressed? @progressed?})))\n   269\t                                  seam {:send! send-fn\n   270\t                                        :close! close-fn\n   271\t                                        :step! step-fn}]\n   272\t                              (deposit-event! deposit (datagram/bound-event identity (:ip local) (:port local)))\n   273\t                              seam)))))))))))))))\n     1\t(ns dao.posix.random\n     2\t  \"Fresh-entropy adapter for jolt drawing random bytes from the qualified\n     3\t   libcrypto CSPRNG wrapper (jolt_crypto_random).\n     4\t   dao.space and yin.vm both use this seam.\"\n     5\t  (:require\n     6\t    [clojure.string :as str]\n     7\t    [dao.host.bytes :as bytes]\n     8\t    [dao.host.hash]\n     9\t    [jolt.ffi :as ffi]))\n    10\t\n    11\t\n    12\t(def ^:private library\n    13\t  (let [os (str/lower-case (or (System/getProperty \"os.name\") \"\"))\n    14\t        arch (System/getProperty \"os.arch\")\n    15\t        darwin? (str/includes? os \"mac\")]\n    16\t    (str (System/getProperty \"user.dir\") \"/build/native/\"\n    17\t         (if darwin? \"darwin\" \"linux\") \"-\"\n    18\t         (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\")\n    19\t         \"/jolt-crypto/lib/libjolt_crypto\" (if darwin? \".dylib\" \".so\"))))\n    20\t\n    21\t\n    22\t(ffi/load-library library)\n    23\t\n    24\t\n    25\t(ffi/defcfn ^:private c-random \"jolt_crypto_random\"\n    26\t            [:pointer :size_t] :int :blocking)\n    27\t\n    28\t\n    29\t(ffi/defcfn ^:private c-cleanse \"jolt_crypto_cleanse\" [:pointer :size_t] :void)\n    30\t\n    31\t\n    32\t(defn rand-bytes\n    33\t  \"A fresh jolt byte array of `n` random bytes (n >= 0) from the qualified\n    34\t   libcrypto's CSPRNG. Randomness failure is an error: a nonzero wrapper\n    35\t   status throws.\"\n    36\t  [n]\n    37\t  (when (neg? n)\n    38\t    (throw (ex-info \"dao.posix.random/rand-bytes negative count\" {:n n})))\n    39\t  (let [size (max 1 n)\n    40\t        p (ffi/alloc size)]\n    41\t    (try\n    42\t      (when (ffi/null? p)\n    43\t        (throw (ex-info \"jolt-crypto native allocation failed\" {:bytes n})))\n    44\t      (let [status (c-random p n)]\n    45\t        (when-not (zero? status)\n    46\t          (throw (ex-info \"jolt-crypto random failed\" {:entry 'rand-bytes\n    47\t                                                       :status status})))\n    48\t        (if (pos? n) (ffi/read-array p n) (bytes/alloc 0)))\n    49\t      (finally\n    50\t        (try (c-cleanse p size)\n    51\t             (finally (ffi/free p)))))))\n","exit_code":0,"status":"completed"}}
