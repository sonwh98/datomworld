raffic))\n335:(defn join\n347:   * `:bind-host`, `:bind-port`: the socket's address, loopback and\n350:   * `:bind!`: the datagram host seam, `default-bind` by default;\n358:  (let [opts (merge defaults {:bind! (default-bind)} opts)]\n361:                      (dissoc opts :bind! :local))))\n365:        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n371:(defn store\n375:   closes the socket and the local store.\"\n380:(defn local\n386:(defn message-bound\n397:(defn payload-budget\n412:(defn node-id\n418:(defn ack-peers\n424:(defn announce!\n433:(defn close!\n434:  \"Close the node's socket and its local store, discarding its ledgers\n445:(defn- tick\n455:(defn- bind-step\n456:  \"While the socket binds, read its lifecycle facts: bound completes the\n475:                                (:dao.stream.datagram/socket v)\n491:                [(assoc node :refusal (str \"the socket could not bind \"\n503:(defn- read-all\n522:(defn- retryable?\n527:(defn- tally\n535:(defn- put-entry\n549:(defn- open-entry?\n555:(defn- result\n563:(defn- outstanding?\n569:(defn- attempting?\n575:(defn- needed?\n586:(defn- dequeue\n600:(defn- release-entries\n611:(defn- write-outcome\n634:(defn- limit\n639:(defn- admit\n666:(defn- open-count\n671:(defn- announce\n711:(defn- admit-ledger\n752:(defn- repairing?\n758:(defn- held-in-repair\n763:(defn- open-cycle\n784:(defn- fill-batch\n808:(defn- admit-repairs\n822:(defn- take-issuable\n834:(defn- issue\n852:(defn- in-flight\n857:(defn- release\n880:(defn- fetching\n885:(defn- apply-fact\n913:(defn- read-facts\n934:(defn- report\n957:(defn- close-cycle\n974:(defn- ending\n981:(defn- evaluate\n1011:(defn- retire\n1020:(defn- displace\n1033:(defn- settle-publications\n1053:(defn- update-pubs\n1060:(defn retry!\n1080:(defn- cancel-entry\n1088:(defn cancel!\n1132:(defn- probing\n1136:  (let [absent #?(:cljd (Object.) :clj (Object.) :cljs (js-obj))]\n1146:(defn- missing-in\n1154:(defn index-datoms\n1173:(defn index-walk\n1181:         (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1189:(defn load\n1221:(defn load-index\n1232:(defn load-status\n1247:(defn forget\n1257:(defn abandon\n1283:(defn loaded-datoms\n1291:(defn loaded-indexes\n1299:(defn- walk-outcome\n1304:               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1321:(defn- fail-load\n1330:(defn- advance-load\n1380:(defn- client-holds?\n1389:(defn- advance-loads\n1418:(defn step\n1423:   Answers `[node' events]`.  A refused node (its socket could not bind)\n1441:(defn refusal\n1442:  \"Why the node stopped (its socket could not bind), or nil.\"\n1447:(defn backlog\n1465:(defn- summary\n1481:(defn publications\n1488:(defn publication\n1496:(defn busy?\n1515:(defn db\n1527:(defn q\nsrc/clj/dao/stream/datagram/jvm.clj\nsrc/clj/dao/stream/http/jvm.clj\nsrc/clj/dao/stream/waitset/driver.clj\nsrc/clj/dao/stream/ws/jvm.clj\nsrc/cljd/dao/stream/ble/dart.cljd\nsrc/cljd/dao/stream/cbor/cljd.cljd\nsrc/cljd/dao/stream/datagram/dart.cljd\nsrc/cljd/dao/stream/transit/cljd.cljd\nsrc/cljd/dao/stream/waitset/driver.cljd\nsrc/cljd/dao/stream/ws/dart.cljd\nsrc/cljs/dao/stream/datagram/node.cljs\nsrc/cljs/dao/stream/waitset/driver.cljs\nsrc/cljs/dao/stream/ws/browser.cljs\nsrc/cljs/dao/stream/ws/node.cljs\nsrc/jolt/README.md\nsrc/jolt/clojure/data/json.jolt\nsrc/jolt/dao/host/bytes.jolt\nsrc/jolt/dao/host/float.jolt\nsrc/jolt/dao/host/hash.jolt\nsrc/jolt/dao/host/integer.jolt\nsrc/jolt/dao/host/number.jolt\nsrc/jolt/dao/host/sign.jolt\nsrc/jolt/dao/host/text.jolt\nsrc/jolt/dao/posix/file.jolt\nsrc/jolt/dao/stream/cbor.jolt\nsrc/jolt/dao/stream/cbor.reviewed.edn\nsrc/jolt/dao/stream/cbor/boring.jolt\nsrc/jolt/dao/stream/waitset/driver.jolt\nsrc/jolt/dao/stream/ws/crypto.jolt\nsrc/jolt/dao/stream/ws/jolt.jolt\nsrc/jolt/dao/stream/ws/pump.jolt\nsrc/jolt/dao/stream/ws/tcp.jolt\nsrc/jolt/yang/antlr/cst.jolt\nsrc/jolt/yin/repl/host.jolt\nsrc/jolt/yin/vm/linker/random.jolt\n","exit_code":0,"status":"completed"}}
