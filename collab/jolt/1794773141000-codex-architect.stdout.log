/digest-table.edn\ntest/resources/dao/jing/blake3-vectors.edn\ntest/yang/cross_lang_test.clj\ntest/resources/dao/jing/cbor-v1.errata.md\ntest/dao/stream/udp_test.cljc\ntest/resources/yang/python/dht-import-v1.edn\ntest/resources/yang/python/dht-import-v1.generate.clj\ntest/yang/latte_oracle/depth_post_port.edn\ntest/dao/stream/ws_project_cross_node_test.cljs\ntest/yang/latte_oracle/fixture_closure.edn\ntest/dao/jing/cbor_test.cljc\ntest/dao/jing/dht/kad_test.cljc\ntest/dao/jing/dht/socket_test.clj\ntest/dao/jing/dht/facade_test.clj\ntest/dao/jing/dht/mesh.cljc\ntest/dao/jing/content_test.cljc\ntest/dao/jing/file_test.cljc\ntest/dao/jing/cbor_content_equality_test.cljc\ntest/dao/jing/cbor_fixtures.cljc\ntest/dao/jing/stream_test.cljc\ntest/dao/jing/cbor_conformance_test.cljc\ntest/dao/jing/cbor_fixtures_test.cljc\ntest/dao/jing/hash_registry_contract_test.cljc\ntest/dao/jing/mem_test.cljc\ntest/dao/jing/dht_test.cljc\ntest/dao/stream/journal/file_test.cljc\ntest/dao/jing/content/step_test.cljc\ntest/yin/repl/dht_test.cljc\ntest/dao/gui/runtime_test.clj\ntest/yin/repl/dht_head_test.cljc\ntest/yin/repl/dht_process_test.clj\ntest/yin/repl/host/node_test.cljs\ntest/yin/repl/host/jvm_test.clj\ntest/yin/vm/host_typed_values_test.cljc\ntest/yin/vm/linker/closure_test.cljc\ntest/yin/vm/linker/dht_end_to_end_test.cljc\ntest/yin/vm/linker/dht_test.cljc\ntest/yin/vm/linker/cross_host_transfer_test.clj\ntest/yin/vm/ucf/compose_rows_test.cljc\ntest/yin/vm/ucf/stage_e_scenarios.cljc\ntest/yin/vm/ucf/compose_test.cljc\ntest/dao/gui/event/fixtures/diagnostic_keyboard-orphan-up.edn\ntest/dao/gui/event/fixtures/diagnostic_unrecognized-event-kind.edn\ntest/dao/gui/event/fixtures/diagnostic_duplicate-pointer-down.edn\ntest/dao/gui/event/fixtures/capture_across-region.edn\ntest/dao/gui/event/fixtures/diagnostic_subscription-cross-kind-gesture.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-malformed.edn\ntest/dao/gui/event/fixtures/diagnostic_input-sequence-gap.edn\ntest/dao/gui/event/fixtures/input-loss_multi-arena.edn\ntest/dao/gui/event/fixtures/capture_across-frames.edn\ntest/dao/gui/event/fixtures/timer_stale-sequence.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-focus-clear-stale.edn\ntest/dao/gui/event/fixtures/diagnostic_unsupported-region.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-focus-mismatch.edn\ntest/dao/gui/event/fixtures/diagnostic_no-active-frame.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-repeat-up.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-stale-gen.edn\ntest/dao/gui/event/fixtures/diagnostic_stale-frame.edn\ntest/dao/gui/event/fixtures/timer_deadline-tie.edn\ntest/dao/gui/event/fixtures/diagnostic_subscription-cross-kind-kb.edn\ntest/dao/gui/event/fixtures/diagnostic_late-runtime-input.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-focus-lost-mismatch.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-unknown-field.edn\ntest/dao/gui/event/fixtures/diagnostic_coordinate-space-mismatch.edn\ntest/dao/gui/event/fixtures/diagnostic_stale-generation.edn\ntest/dao/gui/event/fixtures/machine_timers.edn\ntest/dao/gui/event/fixtures/diagnostic_future-frame.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-missing-focus.edn\ntest/dao/gui/event/fixtures/diagnostic_keyboard-duplicate-down.edn\ntest/dao/gui/event/fixtures/diagnostic_profile-mismatch.edn\ntest/dao/gui/event/fixtures/diagnostic_orphan-pointer-packet.edn\n1:# DaoJing DHT: Content-Addressed Segment Distribution\n10:## 1. Overview and scope\n37:the local HEAD of the durable-store epic; a remote query is given a manifest\n39:first is now designed above this layer, in\n41:HEAD is a signed trace on a stream it writes, and the DHT learns nothing\n44:## 2. Layering and composition\n210:## 3. The stream API\n324:## 4. Writes: local insert, then acknowledged when sent to multiple peers\n332:### 4.1 What the acknowledgement asserts\n356:### 4.2 Two entry points, one pending write\n373:### 4.3 How a write proceeds, and what the caller sees when it cannot\n496:### 4.4 Publication (owner decision 1)\n513:### 4.5 Reads\n531:## 5. The `dao.jing` adapter, the JVM facade, and time\n533:### 5.1 The byte-store handle (owner decision 4)\n555:### 5.2 The JVM blocking facade\n564:### 5.3 Time\n577:## 6. Peers and routing\n608:## 7. The wire (v1)\n674:## 8. Hardening\n739:## 9. Limits and defaults\n888:## 10. Today's code, and the slices that replace it\n946:### Slice plan\n1035:HEAD, lock, recovery). Acceptance:\n1045:### The plain Clojure path (S5, owner direction 2026-10-01)\n1075:  - `:published`, the first report of an announced publication, once every\n1087:  `(announce! node manifest)` closes the publication its puts made. `step`\n1122:## Relationship to the intake-pool observer\n1132:## Lineage\n","exit_code":0,"status":"completed"}}
