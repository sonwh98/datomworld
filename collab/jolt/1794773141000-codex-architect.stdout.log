n319:(defn render-heads\n326:(defn- without-boms\n340:(defn read-heads\n349:        bs (try (fs/read-bounded path heads-max-bytes)\n350:                (catch #?(:cljd Object :clj Throwable :cljs :default) e\n353:                        (<= (fs/byte-length bs) heads-max-bytes))\n354:               (try (fs/decode-utf8 bs)\n355:                    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n380:(defn- ring\n387:(defn- deposit-head!\n393:               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n401:(defn- publisher\n407:      {:board (head/board!)\n409:       :principal (sign/principal (:public key))\n420:(defn followed-principals\n423:  (mapv #(sign/principal (:principal %)) (:follow spec)))\n430:   policy — the byte ceiling is what bounds a publication now, and a count\n432:   (docs/design/yin.repl.dht-composition.md sections 5 and 12, R3).\"\n436:(defn publication-policy\n438:   `node` (docs/design/yin.repl.dht-composition.md section 5):\n456:(defn link-source\n459:   (docs/design/yin.repl.dht-composition.md sections 3 and 7).  A\n480:(defn- checked-follow\n493:      (when-not (remote-channel/loopback-literal? host)\n495:                     \": the head board is followed on loopback only\")))\n507:(defn- heads-records\n522:(defn- follower-of\n532:        (head/follow node {:follow (mapv #(sign/principal (:principal %))\n535:        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n545:(defn- compose\n550:   HEAD write that announces and deposits are all on the node's side of\n553:   (docs/design/yin.repl.dht-composition.md sections 3 and 6).\"\n564:                                                      [(sign/principal\n570:                                :write! (or write-heads! fs/atomic-replace!)})\n581:            ;; (docs/design/yin.repl.dht-composition.md section 5), read\n593:                       (dht/announce! node manifest-address)\n598:            ;; (docs/design/yin.repl.dht-composition.md section 6)\n603:(defn- quietly!\n608:       (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n611:(defn open\n662:           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n675:       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n680:(defn follower\n687:(defn stop!\n689:   server is asked to stop (`head.board/stop!`), every follow dial is\n699:   (docs/design/yin.repl.dht-composition.md sections 3 and 6).\"\n705:            (when dial (head.board/close! dial)))\n709:                   (update-in [::publisher :server] head.board/stop!)\n715:(defn stopped?\n720:    (or (nil? server) (head.board/stopped? server))))\n723:(defn close!\n740:    (when (and server (not (head.board/stopped? server)))\n741:      (head.board/serve-step server (or (::now node) 0)))\n749:(defn- address-text\n754:(defn- reason-text\n764:                                     \"acknowledgement deadline\")\n781:(defn- result-text\n783:   acknowledged, the count of failed blobs, the first reason, and whether\n786:   publication (docs/design/yin.repl.dht-composition.md section 3).\"\n788:  (if (= :acknowledged result)\n789:    (str \"acknowledged: sent to \" peers \" peers\")\n792:           \"NOT acknowledged: \")\n802:(defn- failure-text\n815:(defn- event-line\n827:    :publication-unknown (str \"dht: published \" manifest\n828:                              \", acknowledgement unknown: facts were lost\")\n843:(defn join-token\n852:(defn- trace-text\n858:(defn- head-line\n870:    :source-lost (str \"dht: lost the head board of \" principal \" (\"\n883:  \"The head board's wire profile.\"\n887:(defn- serve-board\n891:  (let [server (head.board/serve {:board (:board pub)\n900:          (str \"dht: the head board is served on loopback only; this node \"\n902:          :dao.stream.remote-channel/no-transport\n903:          \"dht: this host has no WebSocket listener: no head board, no token\"\n904:          (str \"dht: the head board could not bind TCP \"\n909:(defn- stopped-line\n913:    \"dht: the head board stopped\"\n914:    (str \"dht: the head board stopped without host completion (\"\n918:(defn- step-board\n922:  [pub node events now]\n928:        server (when (:server pub) (head.board/serve-step (:server pub) now))\n937:                (conj (str \"dht: the head board could not bind TCP \"\n968:(defn- hydrated\n976:   (`yin.repl/install-recovery`, docs/design/yin.repl.dht-composition.md\n995:(defn- next-delay\n1002:(defn- drop-dial\n1005:  [follower link now]\n1006:  (when-some [d (:dial link)] (head.board/close! d))\n1008:    {:due (+ now delay) :delay delay :failed (:failed link)}))\n1011:(defn- lost-reason\n1019:(defn- dial-line\n1025:         \"that endpoint serves no head board for this principal\"\n1028:         :dao.stream.remote-channel/no-transport\n1034:(defn- step-link\n1035:  \"Advance the dial of `principal`'s board at `now`: compose one when\n1042:  [follower ws source link now]\n1044:    (and (nil? (:dial link)) (some? (:due link)) (< now (:due link)))\n1048:    (let [d (head.board/dial {:principal (sign/principal (:principal source))\n1054:        [follower (drop-dial follower link now) (:reason d)]\n1058:    (let [d (head.board/dial-step (:dial link) now)\n1060:          h (head.board/handle d)]\n1063:        [(head/attach follower (sign/principal (:principal source)) h)\n1068:        [follower (drop-dial follower link now) (lost-reason d)]\n1073:(defn- step-links\n1076:  [follower node now]\n1092:                                                       now)\n1101:(defn- persist\n1106:  [follower node waiting principal trace now]\n1113:                    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1118:         (assoc waiting principal {:trace trace :due (+ now delay)\n1127:(defn- retry-waiting\n1130:  [follower node waiting now]\n1137:                (< now due) [follower node waiting events]\n1141:                      (persist follower node waiting p trace now)]\n1147:(defn linked-registry\n1158:(defn moved\n1160:   differs now (`yin.vm.linker.head/moved`): derived, stored nowhere.\"\n1166:(defn- movers\n1168:   each name of `moves` to where it resolves now in `node`, `{name\n1171:   or not at all.  Derived from the two nodes, stored nowhere.  One\n1203:(defn moved-lines\n1219:                   \", now resolves to \" resolved \" (head of \"\n1230:(defn- step-follow\n1234:  [session node now]\n1241:                                        (step-links follower node now))\n1242:          [follower node events] (head/step follower node now)\n1250:                                    #(drop-dial follower % now)))\n1255:                                                         now)\n1259:                          (persist follower node waiting principal trace now)]\n1280:(defn step\n1281:  \"Advance the composition's node once at the host's clock reading `now`\n1294:   keyword (docs/design/yin.repl.dht-composition.md section 7).\"\n1295:  [session now]\n1299:      [[node events] (dht/step node now)\n1300:       node (assoc node ::now now)\n1309:                            (let [[pub ls] (step-board pub node events now)]\n1312:       [node follow-lines head-events] (step-follow session node now)\n1335:(defn refusal\n1341:   and the node is read off its `:node` key and nowhere else: one contract\n1349:(defn admitting?\n1354:   (docs/design/yin.repl.dht-composition.md section 3).\"\n1361:(defn busy?\n1369:(defn follow-lines\n1385:(defn banner\n1389:   (docs/design/yin.repl.dht-composition.md section 6).\"\n1398:                 \" and acknowledged by no one\"))\n1409:                 \" evaluated from now on, with any peer that asks for its\"\n","exit_code":0,"status":"completed"}}
