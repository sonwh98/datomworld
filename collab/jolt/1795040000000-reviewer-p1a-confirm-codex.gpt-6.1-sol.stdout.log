                  build/watchdog.sh (SIGKILL + exit 124 on timeout, so\n    12\t#                         a deadlock is a recorded FAILURE, never a hang),\n    13\t#                         records verbatim outputs under build/results/, then\n    14\t#                         VERIFYs every expected verdict marker. A missing or\n    15\t#                         wrong marker fails `make all`.\n    16\t#   make record-tracked   AFTER a full PASS-verified run: copies the repaired\n    17\t#                         witnesses' fresh outputs into the TRACKED results/.\n    18\t#                         The tracked results/*.out are overwritten ONLY by\n    19\t#                         this target, and only after `verify` passed.\n    20\t#\n    21\t# W3 repair verification: the w3 build regenerates with -keep-temp and\n    22\t# VERIFIES the generated C shows two C arguments and ___NARGS 2 for BOTH\n    23\t# exported entries BEFORE any run (review finding F1).\n    24\t#\n    25\t# Provisioned toolchain (absolute mise paths — NEVER bare gsc from PATH,\n    26\t# that gsc is Ghostscript):\n    27\tGSC ?= /Users/sto/.local/share/mise/installs/gambit/4.9.8/bin/gsc\n    28\tSH  ?= ./watchdog.sh\n    29\tBUILD ?= build\n    30\tBRES ?= $(BUILD)/results\n    31\tRES ?= results\n    32\t\n    33\t.PHONY: all build-witnesses record verify verify-w3-c record-tracked clean\n    34\t\n    35\tall: build-witnesses record verify\n    36\t\n    37\tbuild-witnesses: $(BUILD)/w0-config.exe $(BUILD)/w1.exe $(BUILD)/w2.exe $(BUILD)/w3.exe $(BUILD)/w4.exe\n    38\t\n    39\trecord: record-w0 record-w1 record-w2 record-w3 record-w4\n    40\t\n    41\t$(BUILD) $(BRES):\n    42\t\tmkdir -p $@\n    43\t\n    44\t$(BUILD)/watchdog.sh: watchdog.sh | $(BUILD)\n    45\t\tcp $< $@\n    46\t\n    47\t# ---- sources into build/ (byte-identical copies) -------------------------\n    48\t\n    49\t$(BUILD)/w0-config.scm: w0-config.scm | $(BUILD)\n    50\t\tcp $< $@\n    51\t$(BUILD)/w1-errno.scm: w1-errno.scm | $(BUILD)\n    52\t\tcp $< $@\n    53\t$(BUILD)/w1-fixture.c: w1-fixture.c | $(BUILD)\n    54\t\tcp $< $@\n    55\t$(BUILD)/w2-blocking.scm: w2-blocking.scm | $(BUILD)\n    56\t\tcp $< $@\n    57\t$(BUILD)/w2-fixture.c: w2-fixture.c | $(BUILD)\n    58\t\tcp $< $@\n    59\t$(BUILD)/w3-fthread.c: w3-fthread.c | $(BUILD)\n    60\t\tcp $< $@\n    61\t$(BUILD)/w3-server.scm: w3-server.scm | $(BUILD)\n    62\t\tcp $< $@\n    63\t$(BUILD)/w4-callables.scm: w4-callables.scm | $(BUILD)\n    64\t\tcp $< $@\n    65\t$(BUILD)/w4-fixture.c: w4-fixture.c | $(BUILD)\n    66\t\tcp $< $@\n    67\t\n    68\t# ---- builds (inside build/) ----------------------------------------------\n    69\t\n    70\t$(BUILD)/w0-config.exe: $(BUILD)/w0-config.scm $(BUILD)/watchdog.sh\n    71\t\tcd $(BUILD) && $(GSC) -warnings -exe -o w0-config.exe w0-config.scm\n    72\t\n    73\t$(BUILD)/w1.exe: $(BUILD)/w1-errno.scm $(BUILD)/w1-fixture.c $(BUILD)/watchdog.sh\n    74\t\tcd $(BUILD) && $(GSC) -warnings -exe -o w1.exe w1-errno.scm w1-fixture.c\n    75\t\n    76\t$(BUILD)/w2.exe: $(BUILD)/w2-blocking.scm $(BUILD)/w2-fixture.c $(BUILD)/watchdog.sh\n    77\t\tcd $(BUILD) && $(GSC) -warnings -exe -o w2.exe w2-blocking.scm w2-fixture.c\n    78\t\n    79\t# The manual's documented \"Scheme server\" build pattern\n    80\t# (doc/gambit.txi §c-define; tests/makefile.in:166). -keep-temp retains the\n    81\t# generated C in build/ for the F1 verification below.\n    82\t$(BUILD)/w3.exe: $(BUILD)/w3-fthread.c $(BUILD)/w3-server.scm $(BUILD)/watchdog.sh\n    83\t\tcd $(BUILD) && $(GSC) -warnings -keep-temp -exe -cc-options \"-D___LIBRARY\" -o w3.exe w3-fthread.c w3-server.scm\n    84\t\t@$(MAKE) --no-print-directory verify-w3-c\n    85\t\n    86\t# F1 repair verification: the generated C must declare TWO arguments for\n    87\t# BOTH add entries and carry ___NARGS 2 — checked BEFORE any run.\n    88\tverify-w3-c: $(BUILD)/w3.exe\n    89\t\t@echo \"verify-w3-c: generated C must show (int int) and ___NARGS 2 for both exports\"\n    90\t\t@grep -q 'extern int scheme_w3_add ___P((int ___arg1,int ___arg2)' $(BUILD)/w3-server.c \\\n    91\t\t  || { echo \"VERIFY-W3-C-FAIL: scheme_w3_add is not declared (int, int) in generated C\"; exit 1; }\n    92\t\t@grep -q 'extern int scheme_w3_add_alloc ___P((int ___arg1,int ___arg2)' $(BUILD)/w3-server.c \\\n    93\t\t  || { echo \"VERIFY-W3-C-FAIL: scheme_w3_add_alloc is not declared (int, int) in generated C\"; exit 1; }\n    94\t\t@awk '/extern int scheme_w3_add ___P/,/^}/' $(BUILD)/w3-server.c | grep -q '#define ___NARGS 2' \\\n    95\t\t  || { echo \"VERIFY-W3-C-FAIL: scheme_w3_add does not have ___NARGS 2\"; exit 1; }\n    96\t\t@awk '/extern int scheme_w3_add_alloc ___P/,/^}/' $(BUILD)/w3-server.c | grep -q '#define ___NARGS 2' \\\n    97\t\t  || { echo \"VERIFY-W3-C-FAIL: scheme_w3_add_alloc does not have ___NARGS 2\"; exit 1; }\n    98\t\t@awk '/extern int scheme_w3_phase3 ___P/,/^}/' $(BUILD)/w3-server.c | grep -q '#define ___NARGS 0' \\\n    99\t\t  || { echo \"VERIFY-W3-C-FAIL: scheme_w3_phase3 does not have ___NARGS 0 (void-arg consistency)\"; exit 1; }\n   100\t\t@echo \"VERIFY-W3-C: OK (scheme_w3_add + scheme_w3_add_alloc: two C args, ___NARGS 2; scheme_w3_phase3: ___NARGS 0)\"\n   101\t\n   102\t$(BUILD)/w4.exe: $(BUILD)/w4-callables.scm $(BUILD)/w4-fixture.c $(BUILD)/watchdog.sh\n   103\t\tcd $(BUILD) && $(GSC) -warnings -exe -o w4.exe w4-callables.scm w4-fixture.c\n   104\t\n   105\t# ---- recorded runs (into build/results/ — scratch) -----------------------\n   106\t\n   107\trecord-w0: $(BUILD)/w0-config.exe | $(BRES)\n   108\t\t@echo \"### cmd: $(SH) 60 ./w0-config.exe\" > $(BRES)/w0.out\n   109\t\t@cd $(BUILD) && $(SH) 60 ./w0-config.exe >> ../$(BRES)/w0.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w0.out\n   110\t\t@cat $(BRES)/w0.out\n   111\t\n   112\trecord-w1: $(BUILD)/w1.exe | $(BRES)\n   113\t\t@echo \"### cmd: $(SH) 120 ./w1.exe\" > $(BRES)/w1.out\n   114\t\t@cd $(BUILD) && $(SH) 120 ./w1.exe >> ../$(BRES)/w1.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w1.out\n   115\t\t@cat $(BRES)/w1.out\n   116\t\n   117\trecord-w2: $(BUILD)/w2.exe | $(BRES)\n   118\t\t@echo \"### cmd: $(SH) 60 ./w2.exe -:d5 control\" > $(BRES)/w2-control.out\n   119\t\t@cd $(BUILD) && $(SH) 60 ./w2.exe -:d5 control >> ../$(BRES)/w2-control.out 2>&1; st=$$?; echo \"### exit=$$st\" >> ../$(BRES)/w2-control.out; \\\n   120\t\tcase $$st in \\\n   121\t\t  0) echo \"### w2-outcome: run completed (verdict derived inside; see the W2-CONTROL-VERDICT line)\" >> ../$(BRES)/w2-control.out;; \\\n   122\t\t  124) echo \"### w2-outcome: FAILURE (independent watchdog timeout — recorded failure)\" >> ../$(BRES)/w2-control.out;; \\\n   123\t\t  *) echo \"### w2-outcome: FAILURE (unexpected exit $$st)\" >> ../$(BRES)/w2-control.out;; \\\n   124\t\tesac\n   125\t\t@cat $(BRES)/w2-control.out\n   126\t\t@echo \"### cmd: $(SH) 60 ./w2.exe -:d5 qualify\" > $(BRES)/w2-qualify.out\n   127\t\t@cd $(BUILD) && $(SH) 60 ./w2.exe -:d5 qualify >> ../$(BRES)/w2-qualify.out 2>&1; st=$$?; echo \"### exit=$$st\" >> ../$(BRES)/w2-qualify.out; \\\n   128\t\tcase $$st in \\\n   129\t\t  0) echo \"### w2-outcome: run completed (verdict derived from observed state; see the W2-QUALIFY-VERDICT line)\" >> ../$(BRES)/w2-qualify.out;; \\\n   130\t\t  3) echo \"### w2-outcome: FAILURE (observed state internally inconsistent)\" >> ../$(BRES)/w2-qualify.out;; \\\n   131\t\t  124) echo \"### w2-outcome: FAILURE (independent watchdog timeout — recorded failure)\" >> ../$(BRES)/w2-qualify.out;; \\\n   132\t\t  *) echo \"### w2-outcome: FAILURE (unexpected exit $$st)\" >> ../$(BRES)/w2-qualify.out;; \\\n   133\t\tesac\n   134\t\t@cat $(BRES)/w2-qualify.out\n   135\t\t@echo \"### cmd: $(SH) 60 ./w2.exe -:d5 blocked\" > $(BRES)/w2-blocked.out\n   136\t\t@cd $(BUILD) && $(SH) 60 ./w2.exe -:d5 blocked >> ../$(BRES)/w2-blocked.out 2>&1; st=$$?; echo \"### exit=$$st\" >> ../$(BRES)/w2-blocked.out; \\\n   137\t\tcase $$st in \\\n   138\t\t  0) echo \"### w2-outcome: run completed (starvation demonstration; verdict derived inside)\" >> ../$(BRES)/w2-blocked.out;; \\\n   139\t\t  2) echo \"### w2-outcome: FAILURE (observed state contradicts the documented starvation)\" >> ../$(BRES)/w2-blocked.out;; \\\n   140\t\t  124) echo \"### w2-outcome: FAILURE (independent watchdog timeout — recorded failure)\" >> ../$(BRES)/w2-blocked.out;; \\\n   141\t\t  *) echo \"### w2-outcome: FAILURE (unexpected exit $$st)\" >> ../$(BRES)/w2-blocked.out;; \\\n   142\t\tesac\n   143\t\t@cat $(BRES)/w2-blocked.out\n   144\t\n   145\t# W3 phase classification: fatal exits (70 = Gambit fatal, 134/138/139 =\n   146\t# fatal signal: SIGABRT/SIGBUS/SIGSEGV) are ALL the documented\n   147\t# refusal-failure (unsafe foreign-thread entry) — any of them is a valid\n   148\t# record of the refusal, never a success; survival (exit 0) is\n   149\t# REFUSAL-NOT-REPRODUCED — the reviewer-mandated nondeterminism caveat, also\n   150\t# never a success; wrong values are UNSAFE-ENTRY-OBSERVED; timeouts,\n   151\t# control failures and unexpected exits are failures.\n   152\tdefine W3_PHASE_RECORD\n   153\t\t@echo \"### cmd: $(SH) 60 ./w3.exe $(1)\" > $(BRES)/$(2)\n   154\t\t@cd $(BUILD) && $(SH) 60 ./w3.exe $(1) >> ../$(BRES)/$(2) 2>&1; st=$$?; echo \"### exit=$$st\" >> ../$(BRES)/$(2); \\\n   155\t\tcase $$st in \\\n   156\t\t  70|134|138|139) echo \"### w3-outcome: UNSAFE-ENTRY-REPRODUCED (documented refusal-failure: exit $$st = the foreign pthread could not safely enter Scheme; never a success)\" >> ../$(BRES)/$(2);; \\\n   157\t\t  0) echo \"### w3-outcome: REFUSAL-NOT-REPRODUCED (worker survived — undocumented serialized reuse of the single pstate, never qualification of foreign-thread entry)\" >> ../$(BRES)/$(2);; \\\n   158\t\t  1) echo \"### w3-outcome: FAILURE (owner-thread control failed)\" >> ../$(BRES)/$(2);; \\\n   159\t\t  2) echo \"### w3-outcome: UNSAFE-ENTRY-OBSERVED (worker entered with WRONG VALUES — corruption)\" >> ../$(BRES)/$(2);; \\\n   160\t\t  124) echo \"### w3-outcome: FAILURE (independent watchdog timeout)\" >> ../$(BRES)/$(2);; \\\n   161\t\t  *) echo \"### w3-outcome: FAILURE (unexpected exit $$st)\" >> ../$(BRES)/$(2);; \\\n   162\t\tesac\n   163\t\tcat $(BRES)/$(2)\n   164\tendef\n   165\t\n   166\trecord-w3: $(BUILD)/w3.exe | $(BRES)\n   167\t\t@echo \"### cmd: $(SH) 60 ./w3.exe control\" > $(BRES)/w3-control.out\n   168\t\t@cd $(BUILD) && $(SH) 60 ./w3.exe control >> ../$(BRES)/w3-control.out 2>&1; st=$$?; echo \"### exit=$$st\" >> ../$(BRES)/w3-control.out; \\\n   169\t\tcase $$st in \\\n   170\t\t  0) echo \"### w3-outcome: CONTROL-PASS (owner-thread callbacks through the same c-define entries succeeded before any foreign-thread phase)\" >> ../$(BRES)/w3-control.out;; \\\n   171\t\t  *) echo \"### w3-outcome: FAILURE (owner-thread control exit $$st)\" >> ../$(BRES)/w3-control.out;; \\\n   172\t\tesac\n   173\t\t@cat $(BRES)/w3-control.out\n   174\t\t$(call W3_PHASE_RECORD,phase1,w3-phase1.out)\n   175\t\t$(call W3_PHASE_RECORD,phase1-nobeat,w3-phase1-nobeat.out)\n   176\t\t$(call W3_PHASE_RECORD,phase2,w3-phase2-run1.out)\n   177\t\t$(call W3_PHASE_RECORD,phase2,w3-phase2-run2.out)\n   178\t\t$(call W3_PHASE_RECORD,phase3,w3-phase3.out)\n   179\t\n   180\trecord-w4: $(BUILD)/w4.exe | $(BRES)\n   181\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode1\" > $(BRES)/w4-mode1.out\n   182\t\t@cd $(BUILD) && $(SH) 60 ./w4.exe mode1 >> ../$(BRES)/w4-mode1.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w4-mode1.out\n   183\t\t@cat $(BRES)/w4-mode1.out\n   184\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode4 (run 1 of 3)\" > $(BRES)/w4-mode4-run1.out\n   185\t\t@cd $(BUILD) && $(SH) 60 ./w4.exe mode4 >> ../$(BRES)/w4-mode4-run1.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w4-mode4-run1.out\n   186\t\t@cat $(BRES)/w4-mode4-run1.out\n   187\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode4 (run 2 of 3)\" > $(BRES)/w4-mode4-run2.out\n   188\t\t@cd $(BUILD) && $(SH) 60 ./w4.exe mode4 >> ../$(BRES)/w4-mode4-run2.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w4-mode4-run2.out\n   189\t\t@cat $(BRES)/w4-mode4-run2.out\n   190\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode4 (run 3 of 3)\" > $(BRES)/w4-mode4-run3.out\n   191\t\t@cd $(BUILD) && $(SH) 60 ./w4.exe mode4 >> ../$(BRES)/w4-mode4-run3.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w4-mode4-run3.out\n   192\t\t@cat $(BRES)/w4-mode4-run3.out\n   193\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode5\" > $(BRES)/w4-mode5.out\n   194\t\t@cd $(BUILD) && $(SH) 60 ./w4.exe mode5 >> ../$(BRES)/w4-mode5.out 2>&1; echo \"### exit=$$?\" >> ../$(BRES)/w4-mode5.out\n   195\t\t@cat $(BRES)/w4-mode5.out\n   196\t\n   197\t# ---- verify: assertive checks (a missing or wrong verdict marker FAILS) --\n   198\t\n   199\tverify: \n   200\t\t@echo \"=== verify: assertive verdict-marker checks over $(BRES)/ ===\"\n   201\t\t@fail=0; \\\n   202\t\tcheck() { if grep -qF -- \"$$2\" \"$(BRES)/$$1\" 2>/dev/null; then echo \"verify: OK   $$1 :: $$2\"; else echo \"verify: FAIL $$1 :: missing [$$2]\"; fail=1; fi; }; \\\n   203\t\tchecke() { if grep -Eq -- \"$$2\" \"$(BRES)/$$1\" 2>/dev/null; then echo \"verify: OK   $$1 :: /$$2/\"; else echo \"verify: FAIL $$1 :: missing [/$2/]\"; fail=1; fi; }; \\\n   204\t\tcheck w0.out \"W0-VERDICT: PASS\"; \\\n   205\t\tcheck w0.out \"### exit=0\"; \\\n   206\t\tcheck w1.out \"W1-NEGATIVE-CONTROL: OK\"; \\\n   207\t\tcheck w1.out \"W1-FAILURES=0\"; \\\n   208\t\tcheck w1.out \"W1-VERDICT: PASS\"; \\\n   209\t\tcheck w1.out \"### exit=0\"; \\\n   210\t\tcheck w2-control.out \"W2-CONTROL-VERDICT: PASS\"; \\\n   211\t\tcheck w2-control.out \"### exit=0\"; \\\n   212\t\tcheck w2-qualify.out \"W2-QUALIFY-VERDICT: FAIL (blocking unqualified on this build\"; \\\n   213\t\tcheck w2-qualify.out \"rounds-during-block=0\"; \\\n   214\t\tcheck w2-qualify.out \"handshake-during-block=0\"; \\\n   215\t\tcheck w2-qualify.out \"### exit=0\"; \\\n   216\t\tcheck w2-blocked.out \"W2-STARVATION-DEMO-VERDICT: STARVATION-DEMONSTRATED\"; \\\n   217\t\tcheck w2-blocked.out \"### exit=0\"; \\\n   218\t\tcheck w3-control.out \"W3-CONTROL-VERDICT: PASS\"; \\\n   219\t\tcheck w3-control.out \"### exit=0\"; \\\n   220\t\tchecke w3-phase1.out \"w3-outcome: (UNSAFE-ENTRY-REPRODUCED|UNSAFE-ENTRY-OBSERVED|REFUSAL-NOT-REPRODUCED)\"; \\\n   221\t\tchecke w3-phase1-nobeat.out \"w3-outcome: (UNSAFE-ENTRY-REPRODUCED|UNSAFE-ENTRY-OBSERVED|REFUSAL-NOT-REPRODUCED)\"; \\\n   222\t\tchecke w3-phase2-run1.out \"w3-outcome: (UNSAFE-ENTRY-REPRODUCED|UNSAFE-ENTRY-OBSERVED|REFUSAL-NOT-REPRODUCED)\"; \\\n   223\t\tchecke w3-phase2-run2.out \"w3-outcome: (UNSAFE-ENTRY-REPRODUCED|UNSAFE-ENTRY-OBSERVED|REFUSAL-NOT-REPRODUCED)\"; \\\n   224\t\tchecke w3-phase3.out \"w3-outcome: (UNSAFE-ENTRY-REPRODUCED|UNSAFE-ENTRY-OBSERVED|REFUSAL-NOT-REPRODUCED)\"; \\\n   225\t\tcheck w4-mode1.out \"W4-VERDICT: PASS\"; \\\n   226\t\tcheck w4-mode4-run1.out \"W4-VERDICT: PASS-QUALIFIED\"; \\\n   227\t\tcheck w4-mode4-run2.out \"W4-VERDICT: PASS-QUALIFIED\"; \\\n   228\t\tcheck w4-mode4-run3.out \"W4-VERDICT: PASS-QUALIFIED\"; \\\n   229\t\tcheck w4-mode5.out \"### exit=70\"; \\\n   230\t\tcheck w4-mode5.out \"*** ERROR IN w4-m5\"; \\\n   231\t\tif [ $$fail -ne 0 ]; then echo \"VERIFY: FAIL (assertive verdict checks failed — refusing to record)\"; exit 1; fi; \\\n   232\t\techo \"VERIFY: PASS (every expected verdict marker present in $(BRES)/)\"\n   233\t\n   234\t# ---- tracked recording: ONLY after a full PASS-verified run ---------------\n   235\t\n   236\t# Copies the REPAIRED witnesses' fresh outputs into the tracked results/.\n   237\t# w0/w4 sources are unchanged in this round; their tracked P1a recordings\n   238\t# remain the ones in results/ (fresh equivalents live in build/results/).\n   239\trecord-tracked: all\n   240\t\tcp $(BRES)/w1.out $(RES)/w1.out\n   241\t\tcp $(BRES)/w2-control.out $(RES)/w2-control.out\n   242\t\tcp $(BRES)/w2-qualify.out $(RES)/w2-qualify.out\n   243\t\tcp $(BRES)/w2-blocked.out $(RES)/w2-blocked.out\n   244\t\tcp $(BRES)/w3-control.out $(RES)/w3-control.out\n   245\t\tcp $(BRES)/w3-phase1.out $(RES)/w3-phase1.out\n   246\t\tcp $(BRES)/w3-phase1-nobeat.out $(RES)/w3-phase1-nobeat.out\n   247\t\tcp $(BRES)/w3-phase2-run1.out $(RES)/w3-phase2-run1.out\n   248\t\tcp $(BRES)/w3-phase2-run2.out $(RES)/w3-phase2-run2.out\n   249\t\tcp $(BRES)/w3-phase3.out $(RES)/w3-phase3.out\n   250\t\t@echo \"record-tracked: repaired witnesses' verified outputs copied to $(RES)/\"\n   251\t\n   252\t# clean removes build artifacts ONLY — never build/results/ (the reviewer's\n   253\t# rerun artifacts and the working recordings live there; the p1a-r2 Makefile\n   254\t# that shipped first had `rm -rf build`, which is exactly how the reviewer\n   255\t# artifacts were lost once — never again).\n   256\tclean:\n   257\t\trm -f $(BUILD)/*.exe $(BUILD)/*.o $(BUILD)/*.c\n   258\t\trm -f $(BUILD)/*.scm $(BUILD)/watchdog.sh\n     1\t/* W1 fixture — errno-atomicity call shapes.\n     2\t *\n     3\t * p1a-r2 REPAIR of review finding F2 (the P1a shims read errno AFTER malloc\n     4\t * and shapes A/C manufactured the expected errno after the \"target\" returned,\n     5\t * which cannot qualify capture-before-allocation).\n     6\t *\n     7\t * EVERY shim below follows the astra essential sequence exactly:\n     8\t *\n     9\t *   target call  ->  int saved = errno;   IMMEDIATELY, before ANY\n    10\t *                 ->  malloc / conversion / cleanup / Scheme re-entry\n    11\t *                 ->  the pair travels out as one malloc'd struct\n    12\t *\n    13\t * The TARGETS own their errno (like real syscalls) — the shims never\n    14\t * manufacture one after the fact:\n    15\t *   w1_target_a sets EAGAIN itself and returns -1 (failure);\n    16\t *   w1_target_c sets EACCES itself and returns -2 (failure);\n    17\t *   w1_target_b is a SUCCESS that must preserve the caller's errno = 42\n    18\t *   (contract: do not normalize success to zero).\n    19\t *\n    20\t * Capture-order negative controls (the reviewer's required addition —\n    21\t * capture position must be load-bearing, i.e. observable):\n    22\t *   shape F: an intervening clobber (errno = W1_INTERVENING_CLOBBER) is\n    23\t *            written BETWEEN the target call and the use of the captured\n    24\t *            value; the immediate capture MUST defeat it — the Scheme side\n    25\t *            asserts the TARGET's errno, never the clobber.\n    26\t *   shape G: a deliberately WRONG shim that captures AFTER the intervening\n    27\t *            clobber; the witness asserts it yields the CLOBBERED value.\n    28\t *            This proves the assertions can distinguish capture order at\n    29\t *            all: a harness in which G also reported the target's errno\n    30\t *            would be insensitive, and the immediate-capture shapes would\n    31\t *            not be load-bearing.\n    32\t *\n    33\t * The pair travels out of the shim as one malloc'd struct, so the Scheme\n    34\t * side reads result and errno from a single allocation — no second read of\n    35\t * errno can intervene. A global \"last errno\" cell would fail the interleaved\n    36\t * and threaded iterations; re-reading errno after any cleanup would fail the\n    37\t * post-capture clobber; capturing after malloc (the F2 defect) would fail\n    38\t * shape F's intervening clobber whenever malloc touches errno.\n    39\t */\n    40\t\n    41\t#include <errno.h>\n    42\t#include <stdlib.h>\n    43\t#include <stdio.h>\n    44\t\n    45\t/* c-define'd in w1-errno.scm */\n    46\textern int w1_nested_cb (int x);\n    47\t\n    48\t#define W1_INTERVENING_CLOBBER 4242\n    49\t#define W1_POST_CAPTURE_CLOBBER 7777\n    50\t\n    51\ttypedef struct { int res; int err; } w1_pair;\n    52\t\n    53\tstatic int w1_target_a (void) { errno = EAGAIN; return -1; }  /* failure: target's OWN errno */\n    54\tstatic int w1_target_b (void) { return 7; }                   /* success: errno 42 preserved */\n    55\tstatic int w1_target_c (void) { errno = EACCES; return -2; }  /* failure: target's OWN errno */\n    56\t\n    57\t/* shape A: failure; the target's real EAGAIN must survive allocation */\n    58\tw1_pair *w1_shape_a (void)\n    59\t{\n    60\t  int r;\n    61\t  int saved;\n    62\t  w1_pair *p;\n    63\t  errno = 0;\n    64\t  r = w1_target_a ();\n    65\t  saved = errno;                    /* capture IMMEDIATELY after the target */\n    66\t  p = malloc (sizeof (w1_pair));    /* allocation AFTER capture */\n    67\t  p->res = r;\n    68\t  p->err = saved;\n    69\t  errno = W1_POST_CAPTURE_CLOBBER;  /* deliberate post-capture clobber */\n    70\t  return p;\n    71\t}\n    72\t\n    73\t/* shape B: success that PRESERVES errno = 42 (contract: do not normalize\n    74\t   success to zero); capture still immediately after the target */\n    75\tw1_pair *w1_shape_b (void)\n    76\t{\n    77\t  int r;\n    78\t  int saved;\n    79\t  w1_pair *p;\n    80\t  errno = 42;\n    81\t  r = w1_target_b ();\n    82\t  saved = errno;                    /* capture IMMEDIATELY, success included */\n    83\t  p = malloc (sizeof (w1_pair));\n    84\t  p->res = r;\n    85\t  p->err = saved;\n    86\t  errno = W1_POST_CAPTURE_CLOBBER;\n    87\t  return p;\n    88\t}\n    89\t\n    90\t/* shape C: failure; the target's real EACCES must survive allocation */\n    91\tw1_pair *w1_shape_c (void)\n    92\t{\n    93\t  int r;\n    94\t  int saved;\n    95\t  w1_pair *p;\n    96\t  errno = 0;\n    97\t  r = w1_target_c ();\n    98\t  saved = errno;                    /* capture IMMEDIATELY after the target */\n    99\t  p = malloc (sizeof (w1_pair));\n   100\t  p->res = r;\n   101\t  p->err = saved;\n   102\t  errno = W1_POST_CAPTURE_CLOBBER;\n   103\t  return p;\n   104\t}\n   105\t\n   106\t/* shape D: like C, but the c-lambda body adds an ___AT_END clobber that runs\n   107\t   AFTER the result conversion — the captured pair must not change. */\n   108\t\n   109\t/* shape E: nested calls. Captures EIO BEFORE any allocation and BEFORE the\n   110\t   re-entry into Scheme via the c-define'd callback w1_nested_cb (which\n   111\t   itself performs a nested foreign call and clobbers errno through its own\n   112\t   shim), then returns the pair captured BEFORE the re-entry. A shim that\n   113\t   allocated first or re-read errno after the nested call would show the\n   114\t   callback's post-clobber value instead of EIO. */\n   115\tw1_pair *w1_shape_e (void)\n   116\t{\n   117\t  w1_pair *p;\n   118\t  int saved;\n   119\t  int cb;\n   120\t  errno = EIO;\n   121\t  saved = errno;                    /* capture IMMEDIATELY, before ANY malloc */\n   122\t  p = malloc (sizeof (w1_pair));\n   123\t  p->res = -3;\n   124\t  p->err = saved;\n   125\t  cb = w1_nested_cb (5);            /* re-enter Scheme; inner shim B runs inside */\n   126\t  if (cb != 12)                     /* callback sanity: must return exactly 12 */\n   127\t    {\n   128\t      p->res = -999;\n   129\t      p->err = cb;\n   130\t    }\n   131\t  errno = W1_POST_CAPTURE_CLOBBER;  /* deliberate post-capture clobber */\n   132\t  return p;\n   133\t}\n   134\t\n   135\t/* shape F: intervening-clobber negative control (GOOD order). The clobber\n   136\t   lands BETWEEN the target call and the use of the captured value; the\n   137\t   immediate capture defeats it. */\n   138\tw1_pair *w1_shape_f (void)\n   139\t{\n   140\t  int r;\n   141\t  int saved;\n   142\t  w1_pair *p;\n   143\t  errno = 0;\n   144\t  r = w1_target_a ();\n   145\t  saved = errno;                    /* immediate capture ... */\n   146\t  errno = W1_INTERVENING_CLOBBER;   /* ... defeats this intervening clobber */\n   147\t  p = malloc (sizeof (w1_pair));\n   148\t  p->res = r;\n   149\t  p->err = saved;                   /* the TARGET's errno, never the clobber */\n   150\t  errno = W1_POST_CAPTURE_CLOBBER;\n   151\t  return p;\n   152\t}\n   153\t\n   154\t/* shape G: intervening-clobber negative control (deliberately WRONG order —\n   155\t   captures AFTER the clobber). The witness asserts this shim reports the\n   156\t   CLOBBERED value: proof that the assertions distinguish capture order. */\n   157\tw1_pair *w1_shape_g (void)\n   158\t{\n   159\t  int r;\n   160\t  int saved;\n   161\t  w1_pair *p;\n   162\t  errno = 0;\n   163\t  r = w1_target_a ();\n   164\t  errno = W1_INTERVENING_CLOBBER;   /* intervening clobber ... */\n   165\t  saved = errno;                    /* ... captured AFTER it (wrong order) */\n   166\t  p = malloc (sizeof (w1_pair));\n   167\t  p->res = r;\n   168\t  p->err = saved;                   /* the clobber leaks in — by design */\n   169\t  return p;\n   170\t}\n   171\t\n   172\tvoid w1_free_pair (w1_pair *p) { free (p); }\n   173\t\n   174\t/* Platform errno values probed by the Scheme side so the assertions hold on\n   175\t   any OS (EAGAIN/EACCES/EIO differ between macOS and Linux), plus the\n   176\t   intervening-clobber constant so the negative-control assertion compares\n   177\t   against the C-declared value, not a Scheme-side magic number. */\n   178\tint w1_errno_again (void) { return EAGAIN; }\n   179\tint w1_errno_acces (void) { return EACCES; }\n   180\tint w1_errno_io    (void) { return EIO; }\n   181\tint w1_intervening_clobber (void) { return W1_INTERVENING_CLOBBER; }\n     1\t;; W2 — blocking-GC witness (the gambitffi-blocking-gc gate evidence).\n     2\t;;\n     3\t;; p1a-r2 REPAIR of review finding F3. Three modes (first command-line\n     4\t;; argument); every run is under the external watchdog (watchdog.sh), whose\n     5\t;; exit 124 is an INDEPENDENT timeout detection and is always a recorded\n     6\t;; failure. All verdicts are DERIVED from observed state — wrong values,\n     7\t;; absent handshakes and inconsistencies are FAILURES, never unconditional\n     8\t;; prints.\n     9\t;;\n    10\t;;   ./w2.exe -:d5 control\n    11\t;;     CONTROL for the machinery. Thread A makes three NON-blocking foreign\n    12\t;;     calls with sleeps between; thread B performs REAL collections ((##gc)\n    13\t;;     — the runtime primitive whose c-code calls the documented C API\n    14\t;;     ___garbage_collect, lib/_kernel.scm:2051-2069 — plus the documented C\n    15\t;;     API itself via w2-real-gc) while mutating a LIVE ROOTED witness object\n    16\t;;     between rounds. PASS requires the OBSERVED state: B executed, >=1 B\n    17\t;;     round started while A had completed <3 calls (real overlap), and all\n    18\t;;     witness-object mutations intact after the real collections. With -:d5\n    19\t;;     the runtime's \"*** GC:\" report lines are the verbatim proof that REAL\n    20\t;;     collection completed (the adapter's sa-gc-collect no-op cannot\n    21\t;;     produce these).\n    22\t;;\n    23\t;;   ./w2.exe -:d5 qualify\n    24\t;;     THE QUALIFICATION WITNESS for sa-foreign-procedure-blocking. Both\n    25\t;;     participants are STARTED AND SYNCHRONIZED BEFORE the foreign call\n    26\t;;     blocks: thread B is proven EXECUTING on the runtime (an observed flag\n    27\t;;     set by B's first action, plus its timestamped log line) before A\n    28\t;;     enters C; B then waits for A's entry signal. A enters the blocking\n    29\t;;     foreign call (w2-block, 6s C-side deadline). B runs real GC rounds\n    30\t;;     that MUTATE A LIVE ROOTED OBJECT and calls the C release handshake\n    31\t;;     FROM SCHEME (w2-release-handshake via c-lambda) ONLY AFTER its first\n    32\t;;     REAL collection completed. PASS requires the OBSERVED state: C\n    33\t;;     returned via the handshake (cause=handshake), >=1 B round STARTED\n    34\t;;     while the C fixture's in-block flag was set, the handshake arrived\n    35\t;;     during the block, and the witness-object mutations survived real\n    36\t;;     collections. On the provisioned single-processor build B cannot\n    37\t;;     execute while C is blocked, so the OBSERVED verdict is FAIL with the\n    38\t;;     facts recorded (release-cause=deadline, rounds-during-block=0,\n    39\t;;     handshake-during-block=no) — the documented refusal evidence. The\n    40\t;;     internal-consistency guards (round counts, handshake counts, witness\n    41\t;;     slots) turn any incoherent observation into FAIL-INCONSISTENT with a\n    42\t;;     nonzero exit.\n    43\t;;\n    44\t;;   ./w2.exe -:d5 blocked\n    45\t;;     STARVATION DEMONSTRATION — the P1a variant, kept as a documented\n    46\t;;     diagnostic: B is started only AFTER A has entered the blocking call,\n    47\t;;     so on this build every B round can only run after C returns. The\n    48\t;;     verdict is derived from the same observed-state counters\n    49\t;;     (rounds-during-block, in-block flag, blocked duration); an\n    50\t;;     unexpected B progression during the block is flagged UNEXPECTED.\n    51\t\n    52\t(c-declare #<<c-declare-end\n    53\t\n    54\tint w2_block (int deadline_seconds);\n    55\tvoid w2_release_handshake (void);\n    56\tint w2_noblock (void);\n    57\tint w2_handshake_calls_total (void);\n    58\tint w2_handshake_during_block_total (void);\n    59\tint w2_in_block_p (void);\n    60\tint w2_block_blocked_ms (void);\n    61\t\n    62\tc-declare-end\n    63\t)\n    64\t\n    65\t(define w2-block   (c-lambda (int) int \"w2_block\"))\n    66\t(define w2-noblock (c-lambda () int \"w2_noblock\"))\n    67\t(define w2-release-handshake (c-lambda () void \"w2_release_handshake\"))\n    68\t(define w2-handshake-calls (c-lambda () int \"w2_handshake_calls_total\"))\n    69\t(define w2-handshake-during-block (c-lambda () int \"w2_handshake_during_block_total\"))\n    70\t(define w2-in-block-p (c-lambda () int \"w2_in_block_p\"))\n    71\t(define w2-blocked-ms (c-lambda () int \"w2_block_blocked_ms\"))\n    72\t;; REAL collection through the documented C API (gambit.h ~14769):\n    73\t;;   ___IMP_FUNC(___BOOL,___garbage_collect)\n    74\t;;      ___P((___PSD ___SIZE_TS requested_words_still),());\n    75\t(define w2-real-gc\n    76\t  (c-lambda () int\n    77\t    \"___return (___EXT(___garbage_collect) (___PSP 0) ? 1 : 0);\"))\n    78\t\n    79\t(define (w2-now) (time->seconds (current-time)))\n    80\t(define (w2-log . parts)\n    81\t  ;; one forced-flush line, so the ordering with the C fixture's\n    82\t  ;; stdout prints (also flushed) is exact in the recorded output.\n    83\t  (for-each display parts)\n    84\t  (newline)\n    85\t  (force-output))\n    86\t\n    87\t;; ---- observed-state variables (reset per mode) --------------------------\n    88\t\n    89\t(define w2-witness-obj (make-vector 4 0)) ; LIVE ROOTED object mutated by B\n    90\t(define w2-b-executing #f)                ; set by B's FIRST action\n    91\t(define w2-a-entering #f)                 ; set by A before entering C\n    92\t(define w2-c-returned #f)                 ; set by A after the C call returned\n    93\t(define w2-rounds-during-block 0)         ; B rounds STARTED while C was blocked\n    94\t(define w2-rounds-after 0)                ; B rounds started after C returned\n    95\t(define w2-rounds-overlapping 0)          ; control: B rounds started while A\n    96\t                                          ; had completed <3 calls\n    97\t(define w2-handshake-called #f)           ; did SCHEME call the handshake?\n    98\t(define w2-a-calls-done 0)                ; control: A's completed call count\n    99\t\n   100\t(define (w2-reset-state!)\n   101\t  (set! w2-witness-obj (make-vector 4 0))\n   102\t  (set! w2-b-executing #f)\n   103\t  (set! w2-a-entering #f)\n   104\t  (set! w2-c-returned #f)\n   105\t  (set! w2-rounds-during-block 0)\n   106\t  (set! w2-rounds-after 0)\n   107\t  (set! w2-rounds-overlapping 0)\n   108\t  (set! w2-handshake-called #f)\n   109\t  (set! w2-a-calls-done 0))\n   110\t\n   111\t(define (w2-mutate-witness! i)\n   112\t  ;; mutate the LIVE ROOTED witness object; the slots must hold the correct\n   113\t  ;; values AFTER B's real collections, proving the mutations survived GC.\n   114\t  (vector-set! w2-witness-obj 0 i)\n   115\t  (vector-set! w2-witness-obj 1 (+ (vector-ref w2-witness-obj 1) 1)))\n   116\t\n   117\t(define (w2-b-rounds n #!optional (handshake-after-first? #f))\n   118\t  ;; n real GC rounds: allocate, mutate the rooted witness object, (##gc),\n   119\t  ;; then the documented C API; optionally call the C release handshake\n   120\t  ;; FROM SCHEME after the first completed round.\n   121\t  (let loop ((i 1))\n   122\t    (if (<= i n)\n   123\t        (begin\n   124\t          ;; the round's observation: did it START while C was blocked?\n   125\t          (if (= (w2-in-block-p) 1)\n   126\t              (set! w2-rounds-during-block (+ w2-rounds-during-block 1))\n   127\t              (set! w2-rounds-after (+ w2-rounds-after 1)))\n   128\t          (if (< w2-a-calls-done 3)\n   129\t              (set! w2-rounds-overlapping (+ w2-rounds-overlapping 1)))\n   130\t          (w2-log \"W2-B: round \" i \" t=\" (w2-now)\n   131\t                  \" start (c-in-block=\" (w2-in-block-p)\n   132\t                  \" a-calls-done=\" w2-a-calls-done \")\")\n   133\t          (w2-mutate-witness! i)\n   134\t          (let ((v (make-vector 200000 0)))\n   135\t            (vector-set! v 0 i))\n   136\t          (##gc)\n   137\t          (let ((r (w2-real-gc)))\n   138\t            (w2-log \"W2-B: round \" i \" t=\" (w2-now)\n   139\t                    \" done (capi-gc-return=\" r \")\"))\n   140\t          (if (and handshake-after-first? (= i 1))\n   141\t              (begin\n   142\t                (w2-log \"W2-B: calling the C release handshake FROM SCHEME after round \" i\n   143\t                        \" (real collection completed) t=\" (w2-now))\n   144\t                (w2-release-handshake)\n   145\t                (set! w2-handshake-called #t)))\n   146\t          (loop (+ i 1))))))\n   147\t\n   148\t(define (w2-witness-intact? n)\n   149\t  (and (= (vector-ref w2-witness-obj 0) n)\n   150\t       (= (vector-ref w2-witness-obj 1) n)))\n   151\t\n   152\t;; ---- control -------------------------------------------------------------\n   153\t\n   154\t(define (w2-control)\n   155\t  ;; A: non-blocking foreign calls; B: real GC rounds must overlap them.\n   156\t  (define (a-work)\n   157\t    (let loop ((i 1))\n   158\t      (if (<= i 3)\n   159\t          (begin\n   160\t            (w2-log \"W2-A: non-blocking foreign call \" i \" t=\" (w2-now))\n   161\t            (w2-noblock)\n   162\t            (set! w2-a-calls-done (+ w2-a-calls-done 1))\n   163\t            (thread-sleep! 0.3)\n   164\t            (loop (+ i 1)))\n   165\t          (w2-log \"W2-A: all non-blocking calls returned\"))))\n   166\t  (w2-reset-state!)\n   167\t  (let* ((t-b (make-thread (lambda ()\n   168\t                             (set! w2-b-executing #t)\n   169\t                             (w2-log \"W2-B: executing t=\" (w2-now))\n   170\t                             (w2-b-rounds 3))\n   171\t                           'w2-b))\n   172\t         (t-a (make-thread a-work 'w2-a)))\n   173\t    (thread-start! t-b)\n   174\t    (thread-start! t-a)\n   175\t    (thread-join! t-b)\n   176\t    (thread-join! t-a)\n   177\t    ;; derive the verdict from the observed state\n   178\t    (w2-log \"W2: observed state: b-executed=\" w2-b-executing\n   179\t            \" rounds-overlapping-a-calls=\" w2-rounds-overlapping\n   180\t            \" witness-object=(last-round=\" (vector-ref w2-witness-obj 0)\n   181\t            \" round-count=\" (vector-ref w2-witness-obj 1) \")\")\n   182\t    (if (and w2-b-executing\n   183\t             (> w2-rounds-overlapping 0)\n   184\t             (w2-witness-intact? 3))\n   185\t        (w2-log \"W2-CONTROL-VERDICT: PASS (derived from observed state: B executed, \"\n   186\t                w2-rounds-overlapping \" of 3 real-GC rounds started while A had completed <3 foreign calls, witness-object mutations intact after real collections; the *** GC: report lines above are the runtime's own collection evidence)\")\n   187\t        (w2-log \"W2-CONTROL-VERDICT: FAIL (observed state: b-executed=\" w2-b-executing\n   188\t                \" rounds-overlapping=\" w2-rounds-overlapping\n   189\t                \" witness-slots=(\" (vector-ref w2-witness-obj 0)\n   190\t                \",\" (vector-ref w2-witness-obj 1) \") expected=(3,3)\"))))\n   191\t\n   192\t;; ---- qualify (the qualification witness) ----------------------------------\n   193\t\n   194\t(define (w2-qualify)\n   195\t  ;; Both participants synchronized BEFORE the foreign call blocks:\n   196\t  ;;   A (the primordial thread) waits until B is OBSERVED executing;\n   197\t  ;;   B waits until A signals entry; then A enters C and blocks.\n   198\t  (w2-reset-state!)\n   199\t  (let* ((t-b (make-thread\n   200\t               (lambda ()\n   201\t                 ;; FIRST action: prove B is executing on the runtime\n   202\t                 (set! w2-b-executing #t)\n   203\t                 (w2-log \"W2-B: EXECUTING on the runtime t=\" (w2-now))\n   204\t                 ;; synchronized start: wait for A's entry signal\n   205\t                 (let wait () (if (not w2-a-entering)\n   206\t                                  (begin (thread-sleep! 0.01) (wait))))\n   207\t                 (w2-log \"W2-B: observed A's entry signal; starting real GC rounds t=\" (w2-now))\n   208\t                 (w2-b-rounds 3 #t))\n   209\t               'w2-b)))\n   210\t    (thread-start! t-b)\n   211\t    ;; A: wait until B is provably executing BEFORE entering C\n   212\t    (let wait () (if (not w2-b-executing)\n   213\t                     (begin (thread-sleep! 0.01) (wait))))\n   214\t    (w2-log \"W2-A: OBSERVED B executing on the runtime (synchronized) t=\" (w2-now))\n   215\t    (set! w2-a-entering #t)\n   216\t    (w2-log \"W2-A: entering blocking foreign call (B synchronized and executing) t=\" (w2-now))\n   217\t    (let ((cause (w2-block 6)))\n   218\t      (set! w2-c-returned #t)\n   219\t      (w2-log \"W2-A: foreign call returned t=\" (w2-now)\n   220\t              \" release-cause=\" (if (= cause 0) \"handshake\" \"deadline\"))\n   221\t      (thread-join! t-b)\n   222\t      ;; derive the verdict from the OBSERVED state\n   223\t      (let* ((hc (w2-handshake-calls))\n   224\t           (hd (w2-handshake-during-block))\n   225\t           (bms (w2-blocked-ms))\n   226\t           (rounds-total (+ w2-rounds-during-block w2-rounds-after))\n   227\t           (consistent (and (= rounds-total 3)\n   228\t                            (= (vector-ref w2-witness-obj 0) 3)\n   229\t                            (= (vector-ref w2-witness-obj 1) 3)\n   230\t                            w2-b-executing\n   231\t                            w2-handshake-called\n   232\t                            (= hc 1)\n   233\t                            ;; a handshake release must have arrived during\n   234\t                            ;; the block, and vice versa (one handshake call)\n   235\t                            (eq? (= cause 0) (= hd 1))))\n   236\t           (qualified (and (= cause 0)\n   237\t                           (> w2-rounds-during-block 0)\n   238\t                           (= hd 1)\n   239\t                           (w2-witness-intact? 3))))\n   240\t      (w2-log \"W2: observed state: release-cause=\" (if (= cause 0) \"handshake\" \"deadline\")\n   241\t              \" rounds-during-block=\" w2-rounds-during-block\n   242\t              \" rounds-after=\" w2-rounds-after\n   243\t              \" handshake-called-from-scheme=\" w2-handshake-called\n   244\t              \" capi-handshake-calls=\" hc\n   245\t              \" handshake-during-block=\" hd\n   246\t              \" blocked-ms=\" bms\n   247\t              \" witness-object=(last-round=\" (vector-ref w2-witness-obj 0)\n   248\t              \" round-count=\" (vector-ref w2-witness-obj 1) \")\")\n   249\t      (cond ((not consistent)\n   250\t             (w2-log \"W2-QUALIFY-VERDICT: FAIL-INCONSISTENT (observation machinery disagreed with itself: rounds-total=\" rounds-total\n   251\t                     \" handshake-calls=\" hc\n   252\t                     \" handshake-during-block=\" hd\n   253\t                     \" cause-0=\" (= cause 0) \")\")\n   254\t             (exit 3))\n   255\t            (qualified\n   256\t             (w2-log \"W2-QUALIFY-VERDICT: PASS (blocking qualified: C returned via the Scheme-called handshake after B completed real collections DURING the block; rounds-during-block=\" w2-rounds-during-block\n   257\t                     \"; witness-object mutations intact)\"))\n   258\t            (else\n   259\t             (w2-log \"W2-QUALIFY-VERDICT: FAIL (blocking unqualified on this build: release-cause=\"\n   260\t                     (if (= cause 0) \"handshake\" \"deadline\")\n   261\t                     \", rounds-during-block=\" w2-rounds-during-block\n   262\t                     \", handshake-during-block=\" hd\n   263\t                     \"; B was synchronized and provably executing BEFORE A entered C, but completed all rounds only AFTER the foreign call returned — the handshake was called from Scheme only after B's real collections, which on this build can only happen after C returned; astra §2 'actual collection and another Scheme thread's progress while C remains blocked' is not satisfied)\")))))))\n   264\t\n   265\t;; ---- starvation demonstration (P1a diagnostic variant, kept) --------------\n   266\t\n   267\t(define (w2-blocked)\n   268\t  ;; A: blocking foreign call with 6s C-side deadline.\n   269\t  ;; B: started only AFTER A enters (the P1a design) — the starvation demo.\n   270\t  (w2-reset-state!)\n   271\t  (let* ((t-a (make-thread (lambda ()\n   272\t                             (w2-log \"W2-A: entering blocking foreign call t=\" (w2-now))\n   273\t                             (let ((cause (w2-block 6)))\n   274\t                               (set! w2-c-returned #t)\n   275\t                               (w2-log \"W2-A: foreign call returned t=\" (w2-now)\n   276\t                                       \" release-cause=\" (if (= cause 0) \"handshake\" \"deadline\"))))\n   277\t                           'w2-a))\n   278\t         (t-b (make-thread (lambda ()\n   279\t                             (set! w2-b-executing #t)\n   280\t                             (w2-log \"W2-B: executing (started AFTER A entered — starvation demo) t=\" (w2-now))\n   281\t                             (w2-b-rounds 3))\n   282\t                           'w2-b)))\n   283\t    (thread-start! t-a)\n   284\t    (let ((t-block-start (w2-now)))\n   285\t      ;; give A a moment to enter the foreign call, then make B runnable\n   286\t      (thread-sleep! 0.3)\n   287\t      (thread-start! t-b)\n   288\t      (thread-join! t-b)\n   289\t      (thread-join! t-a)\n   290\t      (w2-log \"W2: blocked window from t=\" t-block-start \" to t=\" (w2-now))\n   291\t      (let ((bms (w2-blocked-ms)))\n   292\t        (w2-log \"W2: observed state: rounds-during-block=\" w2-rounds-during-block\n   293\t                \" rounds-after=\" w2-rounds-after\n   294\t                \" blocked-ms=\" bms\n   295\t                \" witness-object=(last-round=\" (vector-ref w2-witness-obj 0)\n   296\t                \" round-count=\" (vector-ref w2-witness-obj 1) \")\")\n   297\t        (if (and (= w2-rounds-during-block 0)\n   298\t                 (>= bms 5500)\n   299\t                 (w2-witness-intact? 3))\n   300\t            (w2-log \"W2-STARVATION-DEMO-VERDICT: STARVATION-DEMONSTRATED (derived: \" w2-rounds-during-block \" rounds started while the C fixture's in-block flag was set; blocked \" bms \"ms — the whole deadline; every W2-B line above appears after 'W2C: foreign call RETURNING'; the qualification witness is the w2-qualify mode, not this diagnostic)\")\n   301\t            (begin\n   302\t              (w2-log \"W2-STARVATION-DEMO-VERDICT: UNEXPECTED (observed state contradicts the documented starvation: rounds-during-block=\" w2-rounds-during-block\n   303\t                      \" blocked-ms=\" bms\n   304\t                      \" — B progressed during the block; investigate before reusing this variant)\")\n   305\t              (exit 2)))))))\n   306\t\n   307\t(define (w2-run mode)\n   308\t  (w2-log \"=== W2 blocking-GC witness (p1a-r2): mode=\" mode \" ===\")\n   309\t  (w2-log \"W2: t=\" (w2-now) \" start\")\n   310\t  (case mode\n   311\t    ((control) (w2-control))\n   312\t    ((qualify) (w2-qualify))\n   313\t    ((blocked) (w2-blocked))\n   314\t    (else\n   315\t     (w2-log \"W2-usage: ./w2.exe -:d5 control|qualify|blocked\")\n   316\t     (exit 2))))\n   317\t\n   318\t;; compiled exe: the mode is the first non-(-:) command-line argument\n   319\t(let ((args (command-line)))\n   320\t  (w2-run (cond\n   321\t           ((and (pair? args)\n   322\t                 (member (car args) '(\"control\" \"qualify\" \"blocked\")))\n   323\t            (string->symbol (car args)))\n   324\t           ((and (pair? args) (pair? (cdr args))\n   325\t                 (member (cadr args) '(\"control\" \"qualify\" \"blocked\")))\n   326\t            (string->symbol (cadr args)))\n   327\t           (else 'usage))))\n","exit_code":0,"status":"completed"}}
