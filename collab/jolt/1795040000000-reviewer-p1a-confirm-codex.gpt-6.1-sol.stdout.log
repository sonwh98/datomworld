{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba p1a/witnesses/w2-blocking.scm | sed -n '40,265p'; cat p1a/witnesses/results/w1.out p1a/witnesses/results/w2-qualify.out; rg -n 'r2|SMP|claim|6528|6530|19328|19305|9843' p1a/AUDIT.md\"","aggregated_output":"    40\t;;     internal-consistency guards (round counts, handshake counts, witness\n    41\t;;     slots) turn any incoherent observation into FAIL-INCONSISTENT with a\n    42\t;;     nonzero exit.\n    43\t;;\n    44\t;;   ./w2.exe -:d5 blocked\n    45\t;;     STARVATION DEMONSTRATION — the P1a variant, kept as a documented\n    46\t;;     diagnostic: B is started only AFTER A has entered the blocking call,\n    47\t;;     so on this build every B round can only run after C returns. The\n    48\t;;     verdict is derived from the same observed-state counters\n    49\t;;     (rounds-during-block, in-block flag, blocked duration); an\n    50\t;;     unexpected B progression during the block is flagged UNEXPECTED.\n    51\t\n    52\t(c-declare #<<c-declare-end\n    53\t\n    54\tint w2_block (int deadline_seconds);\n    55\tvoid w2_release_handshake (void);\n    56\tint w2_noblock (void);\n    57\tint w2_handshake_calls_total (void);\n    58\tint w2_handshake_during_block_total (void);\n    59\tint w2_in_block_p (void);\n    60\tint w2_block_blocked_ms (void);\n    61\t\n    62\tc-declare-end\n    63\t)\n    64\t\n    65\t(define w2-block   (c-lambda (int) int \"w2_block\"))\n    66\t(define w2-noblock (c-lambda () int \"w2_noblock\"))\n    67\t(define w2-release-handshake (c-lambda () void \"w2_release_handshake\"))\n    68\t(define w2-handshake-calls (c-lambda () int \"w2_handshake_calls_total\"))\n    69\t(define w2-handshake-during-block (c-lambda () int \"w2_handshake_during_block_total\"))\n    70\t(define w2-in-block-p (c-lambda () int \"w2_in_block_p\"))\n    71\t(define w2-blocked-ms (c-lambda () int \"w2_block_blocked_ms\"))\n    72\t;; REAL collection through the documented C API (gambit.h ~14769):\n    73\t;;   ___IMP_FUNC(___BOOL,___garbage_collect)\n    74\t;;      ___P((___PSD ___SIZE_TS requested_words_still),());\n    75\t(define w2-real-gc\n    76\t  (c-lambda () int\n    77\t    \"___return (___EXT(___garbage_collect) (___PSP 0) ? 1 : 0);\"))\n    78\t\n    79\t(define (w2-now) (time->seconds (current-time)))\n    80\t(define (w2-log . parts)\n    81\t  ;; one forced-flush line, so the ordering with the C fixture's\n    82\t  ;; stdout prints (also flushed) is exact in the recorded output.\n    83\t  (for-each display parts)\n    84\t  (newline)\n    85\t  (force-output))\n    86\t\n    87\t;; ---- observed-state variables (reset per mode) --------------------------\n    88\t\n    89\t(define w2-witness-obj (make-vector 4 0)) ; LIVE ROOTED object mutated by B\n    90\t(define w2-b-executing #f)                ; set by B's FIRST action\n    91\t(define w2-a-entering #f)                 ; set by A before entering C\n    92\t(define w2-c-returned #f)                 ; set by A after the C call returned\n    93\t(define w2-rounds-during-block 0)         ; B rounds STARTED while C was blocked\n    94\t(define w2-rounds-after 0)                ; B rounds started after C returned\n    95\t(define w2-rounds-overlapping 0)          ; control: B rounds started while A\n    96\t                                          ; had completed <3 calls\n    97\t(define w2-handshake-called #f)           ; did SCHEME call the handshake?\n    98\t(define w2-a-calls-done 0)                ; control: A's completed call count\n    99\t\n   100\t(define (w2-reset-state!)\n   101\t  (set! w2-witness-obj (make-vector 4 0))\n   102\t  (set! w2-b-executing #f)\n   103\t  (set! w2-a-entering #f)\n   104\t  (set! w2-c-returned #f)\n   105\t  (set! w2-rounds-during-block 0)\n   106\t  (set! w2-rounds-after 0)\n   107\t  (set! w2-rounds-overlapping 0)\n   108\t  (set! w2-handshake-called #f)\n   109\t  (set! w2-a-calls-done 0))\n   110\t\n   111\t(define (w2-mutate-witness! i)\n   112\t  ;; mutate the LIVE ROOTED witness object; the slots must hold the correct\n   113\t  ;; values AFTER B's real collections, proving the mutations survived GC.\n   114\t  (vector-set! w2-witness-obj 0 i)\n   115\t  (vector-set! w2-witness-obj 1 (+ (vector-ref w2-witness-obj 1) 1)))\n   116\t\n   117\t(define (w2-b-rounds n #!optional (handshake-after-first? #f))\n   118\t  ;; n real GC rounds: allocate, mutate the rooted witness object, (##gc),\n   119\t  ;; then the documented C API; optionally call the C release handshake\n   120\t  ;; FROM SCHEME after the first completed round.\n   121\t  (let loop ((i 1))\n   122\t    (if (<= i n)\n   123\t        (begin\n   124\t          ;; the round's observation: did it START while C was blocked?\n   125\t          (if (= (w2-in-block-p) 1)\n   126\t              (set! w2-rounds-during-block (+ w2-rounds-during-block 1))\n   127\t              (set! w2-rounds-after (+ w2-rounds-after 1)))\n   128\t          (if (< w2-a-calls-done 3)\n   129\t              (set! w2-rounds-overlapping (+ w2-rounds-overlapping 1)))\n   130\t          (w2-log \"W2-B: round \" i \" t=\" (w2-now)\n   131\t                  \" start (c-in-block=\" (w2-in-block-p)\n   132\t                  \" a-calls-done=\" w2-a-calls-done \")\")\n   133\t          (w2-mutate-witness! i)\n   134\t          (let ((v (make-vector 200000 0)))\n   135\t            (vector-set! v 0 i))\n   136\t          (##gc)\n   137\t          (let ((r (w2-real-gc)))\n   138\t            (w2-log \"W2-B: round \" i \" t=\" (w2-now)\n   139\t                    \" done (capi-gc-return=\" r \")\"))\n   140\t          (if (and handshake-after-first? (= i 1))\n   141\t              (begin\n   142\t                (w2-log \"W2-B: calling the C release handshake FROM SCHEME after round \" i\n   143\t                        \" (real collection completed) t=\" (w2-now))\n   144\t                (w2-release-handshake)\n   145\t              