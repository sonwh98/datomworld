{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"gh api 'repos/jolt-lang/jolt/contents/.github/workflows/metrics.yml?ref=2fd6dccc49bc8fdaad699d1c11ab8a99f7345d66' --jq .content | base64 -D\"","aggregated_output":"name: metrics\n\n# Publishes the findings as a report, and fails the build (ci/metrics-gate.clj) on\n# a critical finding under a path ci/metrics-allow.edn holds critical-free, on\n# unused code beyond that file's allowlist, or on a lint finding it doesn't list.\n# On a pull request the report opens with what the refactoring queue gained and\n# lost since the base's report, which main pushes upload.\non:\n  push:\n    branches: [main]\n  pull_request:\n\npermissions:\n  contents: read\n  # gh run download fetches the baseline report from a main run\n  actions: read\n\nconcurrency:\n  group: metrics-${{ github.event.pull_request.number && format('pr-{0}', github.event.pull_request.number) || github.ref }}\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n\nenv:\n  # jolt runs the gate script. jolt-metrics is the latest release's standalone\n  # binary on purpose: each release finds more, and what it finds gets fixed,\n  # so its new findings arrive without a change here.\n  JOLT_VERSION: v0.8.30\n\njobs:\n  report:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          # hotspots read churn from the git history\n          fetch-depth: 0\n      - name: Install jolt\n        run: |\n          sudo apt-get update\n          sudo apt-get install -y liblz4-1 zlib1g libtinfo6\n          curl -sL https://raw.githubusercontent.com/jolt-lang/jolt/main/install | bash -s -- --version \"$JOLT_VERSION\"\n          echo \"$HOME/.local/bin\" >> \"$GITHUB_PATH\"\n      - name: Install jolt-metrics\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          gh release download --repo jlt-commons/jolt-metrics --pattern '*-x86_64-linux.tar.gz' --dir \"$RUNNER_TEMP\"\n          tar xzf \"$RUNNER_TEMP\"/jolt-metrics-*-x86_64-linux.tar.gz -C \"$RUNNER_TEMP\"\n          mkdir -p \"$HOME/.local/bin\"\n          install \"$RUNNER_TEMP\"/jolt-metrics-*-x86_64-linux/jolt-metrics \"$HOME/.local/bin/\"\n          gh release view --repo jlt-commons/jolt-metrics --json tagName -q '\"jolt-metrics \" + .tagName'\n      - name: Fetch the baseline report\n        if: github.event_name == 'pull_request'\n        env:\n          GH_TOKEN: ${{ github.token }}\n          BASE_REF: ${{ github.base_ref }}\n        run: |\n          # the main run for the PR's merge base, else the latest main runs\n          base=$(git merge-base HEAD \"origin/$BASE_REF\" || true)\n          runs=$( { [ -n \"$base\" ] && gh run list --workflow metrics.yml --branch main --event push \\\n                      --commit \"$base\" --limit 1 --json databaseId -q '.[].databaseId'\n                    gh run list --workflow metrics.yml --branch main --event push \\\n                      --limit 5 --json databaseId -q '.[].databaseId'; } || true)\n          dir=\"$RUNNER_TEMP/baseline\"\n          for id in $runs; do\n            rm -rf \"$dir\"\n            if gh run download \"$id\" --name metrics-report-edn --dir \"$dir\" 2>/dev/null &&\n               [ -s \"$dir/metrics-report.edn\" ]; then\n              echo \"baseline: main run $id\"\n              echo \"METRICS_BASELINE=$dir/metrics-report.edn\" >> \"$GITHUB_ENV\"\n              exit 0\n            fi\n          done\n          echo \"no baseline report from main; the report runs without one\"\n      - name: Run jolt-metrics\n        run: |\n          jolt-metrics . metrics-report.md --top 50 ${METRICS_BASELINE:+--baseline \"$METRICS_BASELINE\"}\n          {\n            # open with the comparison, then the summary up to the long per-file tables\n            awk '/^## Since the baseline/{p=1; print; next} p && /^## /{exit} p' metrics-report.md\n            if [ \"$GITHUB_EVENT_NAME\" = pull_request ] && [ -z \"$METRICS_BASELINE\" ]; then\n              printf 'No baseline report from main was found, so nothing to compare with.\\n\\n'\n            fi\n            awk '/^## Since the baseline/{skip=1; next} skip && /^## /{skip=0}\n                 /^## Cleanup candidates/{exit} !skip' metrics-report.md\n          } >> \"$GITHUB_STEP_SUMMARY\"\n      - name: Write the EDN report\n        run: |\n          # the gate reads the queue, cleanup and lints only, so it skips the\n          # slow search for abstraction opportunities\n          jolt-metrics . metrics-report.edn --format edn --no-abstractions\n      - name: Check for critical findings, unused code and lint findings\n        run: jolt ci/metrics-gate.clj metrics-report.edn ci/metrics-allow.edn\n      - uses: actions/upload-artifact@v6\n        if: always()\n        with:\n          name: metrics-report\n          path: metrics-report.md\n      # the next pull requests' baseline. The comparison reports what moved but\n      # doesn't gate: a queue entry's score folds in its callers across the\n      # project and its file's recent churn, so it moves with unrelated commits\n      # and with the calendar, and \"worse\" isn't a finding the PR made.\n      - uses: actions/upload-artifact@v6\n        if: always() && github.event_name == 'push'\n        with:\n          name: metrics-report-edn\n          path: metrics-report.edn\n          retention-days: 90\n          if-no-files-found: ignore\n","exit_code":0,"status":"completed"}}
