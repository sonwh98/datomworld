ack from a raw foreign pthread ===\np1a/witnesses/results/w4-mode4-run1.out:6:W4-VERDICT: PASS-QUALIFIED (foreign-pthread callback completed — serialized reuse of the single pstate; NO documented protocol; W3 shows the general foreign-thread entry crashes)\np1a/witnesses/results/w4-mode4-run1.out:7:### exit=0\n;; W3 — foreign-thread entry witness (C-driven \"server\" program, the manual's\n;; documented pattern: c-define procedures + ___setup from C, cf. manual §\n;; \"The c-define special form\": \"Before it can be used, the Scheme part must\n;; be initialized with a call to ___setup\", and tests/server.scm).\n;;\n;; A RAW pthread (not created by Gambit, never registered with the runtime)\n;; calls c-define'd Scheme procedures. Two phases:\n;;\n;;   phase 1 (serialized): the primordial thread (which ran ___setup) stays\n;;     parked inside a C pthread_join while the worker pthread enters Scheme.\n;;     On a ___SINGLE_THREADED_VMS build there is exactly one processor state\n;;     (gambit.h ~8625: \"Use direct access to the only pstate\"; ___SET_REAL_PSTATE\n;;     is a no-op there), so the worker is reusing the primordial's pstate\n;;     behind its back. Works only because the primordial never runs Scheme\n;;     concurrently. This documents the empirically observed serialized reuse.\n;;\n;;   phase 2 (concurrent): the worker pthread enters Scheme WHILE the\n;;     primordial thread is running Scheme (scheme_w3_spin allocates in a loop\n;;     for ~3s after spawning the worker). Two threads, one processor state,\n;;     one Scheme stack chain, one allocator: undefined behavior. Expected:\n;;     crash or corruption. Under the external watchdog, so a hang is also a\n;;     recorded failure.\n;;\n;; There is NO documented entry protocol for a foreign pthread in 4.9.8 — the\n;; C-interface chapter documents none, gambit.h declares none, and\n;; ___vm_resize_pstate (the only processor-creation path) is compiled out\n;; under ___SINGLE_THREADED_VMS (setup.c:883).\n\n(c-define (scheme-w3-add x y) (int) int \"scheme_w3_add\" \"extern\"\n  (+ x y))\n\n;; discriminator probe: same signature as scheme-w3-add but the body ALLOCATES\n;; (same shape as W4-M4's callback) — isolates why W4-M4 survives while\n;; phase1/phase3 crash on the trivial add.\n(c-define (scheme-w3-add-alloc x y) (int) int \"scheme_w3_add_alloc\" \"extern\"\n  (+ x y (vector-length (make-vector 1000 x))))\n\n(c-declare \"void w3_spawn_worker_nojoin (void); int w3_park_and_join (int unused);\")\n\n(c-define (scheme-w3-gc-rounds n) (int) int \"scheme_w3_gc_rounds\" \"extern\"\n  ;; real collections driven from a foreign pthread: allocate + ##gc, n rounds\n  (let loop ((i 1) (acc 0))\n    (if (<= i n)\n        (begin\n          (let ((v (make-vector 200000 0)))\n            (vector-set! v 0 i)\n            (##gc)\n            (loop (+ i 1) (+ acc 1))))\n        acc)))\n\n(c-define (scheme-w3-spin ms) (int) int \"scheme_w3_spin\" \"extern\"\n  ;; spawns the racing worker pthread (from C) then keeps the primordial\n  ;; thread INSIDE Scheme, allocating, for about ms milliseconds\n  (begin\n    (w3-spawn-worker)\n    (let ((deadline (+ (time->seconds (current-time)) (/ ms 1000.0))))\n      (let loop ((allocs 0))\n        (if (< (time->seconds (current-time)) deadline)\n            (loop (+ allocs 1 (vector-length (make-vector 50000 0))))\n            allocs)))))\n\n(define w3-spawn-worker\n  (c-lambda () void \"w3_spawn_worker_nojoin (); ___return;\"))\n\n;; phase3 driver: the OWNER Gambit thread parks inside this cfun while the\n;; worker pthread (spawned inside it) enters Scheme.\n(define w3-park-and-join (c-lambda (int) int \"w3_park_and_join\"))\n\n(c-define (scheme-w3-phase3) (int) int \"scheme_w3_phase3\" \"extern\"\n  (w3-park-and-join 0))\n;; W4 — callable (c-define) modes witness.\n;;\n;; Modes dispatched per process (see w4-fixture.c header):\n;;   ./w4.exe mode1  — M1 same-thread callback, M2 nested C->Scheme->C->Scheme\n;;                     (the documented nesting of manual §\"Continuations, the\n;;                     C-interface and threads\" — allowed for ONE thread),\n;;                     M3 callback from a second Gambit thread around a\n;;                     blocking foreign call (expect: B's callback can only\n;;                     run AFTER A's foreign call returns — W2's starvation).\n;;   ./w4.exe mode4  — M4 callback from a raw foreign pthread (expect: crash —\n;;                     W3's mechanism).\n;;   ./w4.exe mode5  — M5 exception raised inside a callback (empirical record).\n\n(c-declare #<<c-declare-end\n\nint w4_call_cb (int x);\nint w4_nested_a (int x);\nint w4_nested_b (int x);\nint w4_b_entry (void);\nint w4_b_completed_during_block_p (void);\nint w4_m3_note_b (int done);\nint w4_block_then_cb (int seconds);\nint w4_ft_call (void);\nint w4_call_raise (int x);\n\nc-declare-end\n)\n\n(define w4-m1       (c-lambda (int) int \"w4_call_cb\"))\n(define w4-m2       (c-lambda (int) int \"w4_nested_a\"))\n(define w4-m3-b     (c-lambda () int \"w4_b_entry\"))\n(define w4-m3-probe (c-lambda () int \"w4_b_completed_during_block_p\"))\n(define w4-m3-note  (c-lambda (int) int \"w4_m3_note_b\"))\n(define w4-m3-a     (c-lambda (int) int \"w4_block_then_cb\"))\n(define w4-m4       (c-lambda () int \"w4_ft_call\"))\n(define w4-m5       (c-lambda (int) int \"w4_call_raise\"))\n\n;; ---- the callables (c-define) ----\n(c-define (w4-cb-same x) (int) int \"w4_cb_same\" \"extern\"\n  (* x 10))\n\n(c-define (w4-cb-q x) (int) int \"w4_cb_q\" \"extern\"\n  (* x 3))\n\n(c-define (w4-cb-p x) (int) int \"w4_cb_p\" \"extern\"\n  ;; Scheme p calls C b, which calls Scheme q — the documented nesting\n  (+ (w4-nested-b (+ x 1)) 1))\n\n(define w4-nested-b (c-lambda (int) int \"w4_nested_b\"))\n\n(c-define (w4-cb-ft x) (int) int \"w4_cb_ft\" \"extern\"\n  ;; allocation inside the callback (exercises the allocator + GC path)\n  (+ x (vector-length (make-vector 1000 x))))\n\n(c-define (w4-cb-raise x) (int) int \"w4_cb_raise\" \"extern\"\n  (error \"w4-cb-raise: deliberate exception\" x))\n\n(define (w4-now) (time->seconds (current-time)))\n(define (w4-log . parts)\n  (for-each display parts)\n  (newline)\n  (force-output))\n\n(define (w4-mode1)\n  (w4-log \"=== W4 mode1: M1 + M2 + M3 ===\")\n  ;; M1: same-thread callback\n  (let ((r (w4-m1 4)))\n    (w4-log \"W4-M1: same-thread callback w4_call_cb(4) -> \" r\n            \" expected 40 => \" (if (= r 40) \"OK\" \"MISMATCH\")))\n  ;; M2: nested chain  a(1) -> p(1) -> b(2) -> q(2)=6 -> b=1006 -> p=1007 -> a=1107\n  (let ((r (w4-m2 1)))\n    (w4-log \"W4-M2: nested C->Scheme->C->Scheme w4_nested_a(1) -> \" r\n            \" expected 1107 => \" (if (= r 1107) \"OK\" \"MISMATCH\")))\n  ;; M3: A blocks in C for 2s then invokes the callback; B (another Gambit\n  ;; thread) attempts the same callback while A is inside the foreign call.\n  (let* ((b-ran-during-block #f)\n         (t-a (make-thread (lambda () (w4-m3-a 2)) 'w4-a))\n         (t-b (make-thread (lambda ()\n                             (thread-sleep! 0.3)   ; start B while A is inside C\n                             (w4-log \"W4-M3: thread B attempting callback t=\" (w4-now))\n                             (let ((r (w4-m3-b)))\n                               (w4-m3-note 1)\n                               (w4-log \"W4-M3: thread B callback completed t=\" (w4-now)\n                                       \" -> \" r)\n                               r))\n                           'w4-b)))\n    (thread-start! t-a)\n    (thread-start! t-b)\n    (let ((t-start (w4-now)))\n      (thread-join! t-a)\n      (let ((probe (w4-m3-probe)))\n        (w4-log \"W4-M3: thread A foreign call returned t=\" (w4-now)\n                \" (blocked ~2s from \" t-start \")\")\n        (thread-join! t-b)\n        (w4-log \"W4-M3: B-completed-during-A-block probe = \" probe\n                \" => \" (if (= probe 0)\n                           \"no callback from B during A's foreign call (callbacks from other Gambit threads are serialized AFTER the foreign call; no released-frame concurrency exists — see W2)\"\n                           \"B ran during A's foreign call (unexpected!)\"))\n        (w4-log \"W4-VERDICT: PASS (M1 same-thread callback, M2 documented nesting, M3 callbacks from other Gambit threads only run while no foreign call occupies the single processor)\")))))\n\n(define (w4-mode4)\n  (w4-log \"=== W4 mode4: M4 callback from a raw foreign pthread ===\")\n  (w4-log \"W4-M4: calling w4_ft_call (worker pthread will invoke the c-define'd callback while this Gambit thread parks inside the C call)\")\n  (let ((r (w4-m4)))\n    (w4-log \"W4-M4: w4_ft_call returned \" r)\n    (w4-log \"W4-VERDICT: PASS-QUALIFIED (foreign-pthread callback completed — serialized reuse of the single pstate; NO documented protocol; W3 shows the general foreign-thread entry crashes)\")))\n\n(define (w4-mode5)\n  (w4-log \"=== W4 mode5: M5 exception inside a callback ===\")\n  (w4-log \"W4-M5: calling w4_call_raise(3) — callback raises a Scheme error\")\n  (let ((r (w4-m5 3)))\n    (w4-log \"W4-M5: w4_call_raise returned \" r \" (process survived)\")\n    (w4-log \"W4-M5-VERDICT: recorded empirically (see output above)\")))\n\n(let ((args (command-line)))\n  (let ((mode (cond\n               ((and (pair? args) (member (car args) '(\"mode1\" \"mode4\" \"mode5\")))\n                (string->symbol (car args)))\n               ((and (pair? args) (pair? (cdr args))\n                     (member (cadr args) '(\"mode1\" \"mode4\" \"mode5\")))\n                (string->symbol (cadr args)))\n               (else 'mode1))))\n    (case mode\n      ((mode1) (w4-mode1))\n      ((mode4) (w4-mode4))\n      ((mode5) (w4-mode5)))))\n/* W4 fixture — callable (c-define) modes.\n *\n * Modes are dispatched per process (Makefile) so a crash in one mode cannot\n * erase the others' evidence:\n *   mode1 : M1 same-thread callback + M2 nested C->Scheme->C->Scheme\n *           + M3 callback from a second Gambit thread around a foreign call\n *   mode4 : M4 callback invoked from a raw foreign pthread\n *   mode5 : M5 exception raised inside a callback\n */\n\n#include <stdio.h>\n#include <pthread.h>\n#include <time.h>\n#include <string.h>\n\n/* c-define'd in w4-callables.scm */\nextern int w4_cb_same (int x);\nextern int w4_cb_q (int x);\nextern int w4_cb_p (int x);\nextern int w4_cb_ft (int x);\nextern int w4_cb_raise (int x);\n\n/* ---- M1: same-thread callback ---- */\nint w4_call_cb (int x)\n{\n  return w4_cb_same (x);\n}\n\n/* ---- M2: nested chain C a -> Scheme p -> C b -> Scheme q (one thread) ---- */\nint w4_nested_b (int y)\n{\n  return w4_cb_q (y) + 1000;\n}\nint w4_nested_a (int x)\n{\n  return w4_cb_p (x) + 100;\n}\n\n/* ---- M3: callback from a second Gambit thread around a foreign call ---- */\nstatic int w4_b_completed_during_block = 0;\n\nint w4_b_entry (void)                       /* called by Gambit thread B */\n{\n  int r = w4_cb_same (9);\n  return r;\n}\n\nint w4_b_completed_during_block_p (void)    /* probe read after A's call returns */\n{\n  return w4_b_completed_during_block;\n}\n\nint w4_m3_note_b (int done)                 /* Scheme side reports B's completion */\n{\n  if (done)\n    w4_b_completed_during_block = 1;\n  return 0;\n}\n\nint w4_block_then_cb (int seconds)          /* called by Gambit thread A */\n{\n  struct timespec ts;\n  ts.tv_sec = seconds;\n  ts.tv_nsec = 0;\n  nanosleep (&ts, 0);\n  return w4_cb_same (7);                    /* callback from C, thread A */\n}\n\n/* ---- M4: callback from a raw foreign pthread ---- */\nstatic void *w4_ft_worker (void *arg)\n{\n  int r;\n  (void) arg;\n  r = w4_cb_ft (5);\n  printf (\"W4-M4: foreign-pthread callback returned %d\\n\", r);\n  fflush (stdout);\n  return (void *) 0;\n}\n\nint w4_ft_call (void)   /* spawns + joins while the CALLING Gambit thread stays inside this C call */\n{\n  pthread_t t;\n  if (pthread_create (&t, 0, w4_ft_worker, 0) != 0)\n    return -1;\n  pthread_join (t, 0);\n  return 0;\n}\n\n/* ---- M5: exception inside a callback ---- */\nint w4_call_raise (int x)\n{\n  return w4_cb_raise (x);\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The Makefile writes binaries and logs beside the tracked sources, outside the permitted build directory. I’ll copy the unchanged witness inputs into `p1a/witnesses/build` and run the requested clean/build there, preserving the committed results for comparison. I also found that W2 starts its contender only after the owner thread wakes from a sleep; that limits what its output alone proves."}}
