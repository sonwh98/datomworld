0355\t if (___ps->temp1 != ___FIX(___NO_ERR)) { \\\n 10356\t  ___ps->temp3=___LBL(0); \\\n 10357\t  ___JUMPEXTPRM(___NOTHING,___ps->handler_cfun_conv_error) \\\n 10358\t}\n 10359\t\n 10360\t#define ___BEGIN_CFUN_BODY\n 10361\t#define ___END_CFUN_BODY ___AT_END\n 10362\t#define ___BEGIN_CFUN_BODY_CLEANUP ___W_ALL_INL ___BEGIN_TRY\n 10363\t#define ___END_CFUN_BODY_CLEANUP ___AT_END ___END_TRY ___R_ALL_INL\n 10364\t\n 10365\t#define ___BEGIN_CFUN_VOIDold ___BEGIN_CFUN_CTX ___SCMOBJ ___err=___FIX(___NO_ERR);___SCMOBJ ___errdata=___FAL;___SCMOBJ ___errhandler=___FAL;\n 10366\t#define ___CFUN_SET_RESULT_VOID ___CFUN_RESULT = ___VOID;\n 10367\t#define ___CFUN_ERROR_VOID ___CFUN_CONV_ERROR\n 10368\t#define ___CFUN_ERROR_CLEANUP_VOID ___CFUN_CONV_ERROR ___EXT(___propagate_error) (___PSP ___err);\n 10369\t#define ___END_CFUN_VOIDold ___END_CFUN_CTX\n 10370\t\n 10371\t#define ___BEGIN_CFUN_SCMOBJold ___BEGIN_CFUN_CTX ___SCMOBJ ___err=___FIX(___NO_ERR);___SCMOBJ ___result;___SCMOBJ ___errdata=___FAL;___SCMOBJ ___errhandler=___FAL;\n 10372\t#define ___CFUN_SET_RESULT_SCMOBJ ___CFUN_RESULT = ___result;\n 10373\t#define ___CFUN_ERROR_SCMOBJ ___CFUN_CONV_ERROR\n 10374\t#define ___CFUN_ERROR_CLEANUP_SCMOBJ ___CFUN_CONV_ERROR ___EXT(___propagate_error) (___PSP ___err);\n 10375\t#define ___END_CFUN_SCMOBJold ___END_CFUN_CTX\n 10376\t\n 10377\t#define ___BEGIN_CFUNold(decl) ___BEGIN_CFUN_CTX ___SCMOBJ ___err=___FIX(___NO_ERR);___SCMOBJ ___errdata=___FAL;___SCMOBJ ___errhandler=___FAL;decl;\n 10378\t#define ___CFUN_SET_RESULT /* done in conversion function */\n 10379\t#define ___CFUN_ERROR ___CFUN_CONV_ERROR\n 10380\t#define ___CFUN_ERROR_CLEANUP ___CFUN_CONV_ERROR ___EXT(___propagate_error) (___PSP ___err);\n 19930\t  (read))\n 19931\t@end smallexample\n 19932\t\n 19933\t@end deffn\n 19934\t\n 19935\t@node continuations, , c-define-type, C-interface\n 19936\t@section Continuations, the C-interface and threads\n 19937\t@cindex continuations\n 19938\t\n 19939\tThe C-interface allows C to Scheme calls to be nested.  This means\n 19940\tthat during a call from C to Scheme another call from C to Scheme\n 19941\tcan be performed.  This case occurs in the following program:\n 19942\t\n 19943\t@smallexample\n 19944\t@b{}(c-declare #<<c-declare-end\n 19945\t\n 19946\tint p (char *); /* forward declarations */\n 19947\tint q (void);\n 19948\t\n 19949\tint a (char *x) @{ return 2 * p (x+1); @}\n 19950\tint b (short y) @{ return y + q (); @}\n 19951\t\n 19952\tc-declare-end\n 19953\t)\n 19954\t\n 19955\t(define a (c-lambda (char-string) int \"a\"))\n 19956\t(define b (c-lambda (short) int \"b\"))\n 19957\t\n 19958\t(c-define (p z) (char-string) int \"p\" \"\"\n 19959\t  (+ (b 10) (string-length z)))\n 19960\t\n 19961\t(c-define (q) () int \"q\" \"\"\n 19962\t  123)\n 19963\t\n 19964\t(write (a \"hello\"))\n 19965\t@end smallexample\n 19966\t\n 19967\tIn this example, the main Scheme program calls the C function @samp{a}\n 19968\twhich calls the Scheme procedure @samp{p} which in turn calls the C\n 19969\tfunction @samp{b} which finally calls the Scheme procedure @samp{q}.\n 19970\t\n 19971\tGambit maintains the Scheme continuation separately from the C stack,\n 19972\tthus allowing the Scheme continuation to be unwound independently from\n 19973\tthe C stack.  The C stack frame created for the C function @samp{f} is\n 19974\tonly removed from the C stack when control returns from @samp{f} or when\n 19975\tcontrol returns to a C function ``above'' @samp{f}.  Special care is\n 19976\trequired for programs which escape to Scheme (using first-class\n 19977\tcontinuations) from a Scheme to C (to Scheme) call because the C stack\n 19978\tframe will remain on the stack.  The C stack may overflow if this\n 19979\thappens in a loop with no intervening return to a C function.  To avoid\n 19980\tthis problem make sure the C stack gets cleaned up by executing a normal\n 19981\treturn from a Scheme to C call.\n 19982\t\n 19983\tThis approach to manage Scheme to C to Scheme calls may cause problems\n 19984\twhen used with Scheme threads because context switching is implemented\n 19985\twith continuations.  If a Scheme thread T1 is in the middle of a\n 19986\tScheme to C to Scheme call and a second thread T2 does a Scheme to C\n 19987\tto Scheme call and there is a Scheme thread context switch back to T1\n 19988\twhich completes its call, the C stack frames of T2 will get removed,\n 19989\tpreventing T2 (when it gets resumed) to complete its call correctly.\n 19990\tThis situation can be avoided by having only one Scheme thread that\n 19991\tdoes Scheme to C to Scheme calls.  Other Scheme threads are limited to\n 19992\tsimple Scheme to C calls that don't call back to Scheme.\n 19993\t\n 19994\t@node System limitations, Copyright and license, C-interface, Top\n 19995\t@chapter System limitations\n 19996\t@cindex limitations\n 19997\t\n 19998\t@itemize @bullet{}\n 19999\t\n 20000\t@item\n 20001\t@cindex floating point overflow\n 20002\t@cindex overflow, floating point\n 20003\tOn some systems floating point overflows will cause the program to\n 20004\tterminate with a floating point exception.\n 20005\t\n5095:the program (i.e. some of the data that would normally be reclaimed by\n9241:The garbage collector is responsible for reclaiming objects that are\n9248:objects are reclaimed by the garbage collector.\n9258:@var{Y} will be reclaimed by the garbage collector.  The will-weak\n9308:Note that the testator object will not be reclaimed during the garbage\n9310:an object is not reachable from the roots that it is reclaimed by the\n9371:reclaimed immediately.\n9846:currently take advantage of multiprocessors (i.e. at most one thread is\n9988:before event @var{B} in real time, then the scheduler will claim that\n10097:synchronization primitive claims that the timeout has been reached\n19017:default function reclaims the copy on the C heap referenced by the\n19184:will be reclaimed when the @code{c-lambda} returns.  If the C string was\n191