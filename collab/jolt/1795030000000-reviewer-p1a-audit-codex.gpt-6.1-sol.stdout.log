val (0.0);\n   151\t      printf (\"W3-PHASE1: heartbeat DISABLED for this run\\n\");\n   152\t      fflush (stdout);\n   153\t    }\n   154\t\n   155\t  pthread_create (&w3_tid, NULL, w3_worker_serialized, NULL);\n   156\t  pthread_join (w3_tid, &ret);\n   157\t\n   158\t  if (disable_heartbeat)\n   159\t    ___set_heartbeat_interval (saved_beat);\n   160\t\n   161\t  printf (\"W3-PHASE1: worker joined, exit=%d (0 = all calls returned expected values)\\n\",\n   162\t          (int) (long) ret);\n   163\t  fflush (stdout);\n   164\t  printf (\"W3-PHASE1-VERDICT: %s\\n\",\n   165\t          (int) (long) ret == 0\n   166\t            ? (disable_heartbeat\n   167\t                 ? \"PASS-QUALIFIED (serialized entry survived with heartbeat disabled; undocumented isolation, no documented protocol)\"\n   168\t                 : \"PASS (serialized entry survived with heartbeat on)\")\n   169\t            : \"FAIL\");\n   170\t  fflush (stdout);\n   171\t  return (int) (long) ret;\n","exit_code":0,"status":"completed"}}
