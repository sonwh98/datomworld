{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"ls -ld p1a/witnesses/build; printenv CODEX_THREAD_ID; sed -n '1,240p' p1a/witnesses/w2-blocking.scm; cat p1a/witnesses/w2-fixture.c; sed -n '1,280p' p1a/witnesses/w3-fthread.c\"","aggregated_output":"ls: p1a/witnesses/build: No such file or directory\n01a1ef93-bee4-7c00-9752-4e034b3efcd1\n;; W2 — blocking-GC witness (the gambitffi-blocking-gc gate evidence).\n;;\n;; Two modes (first command-line argument):\n;;\n;;   ./w2.exe -:d5 control\n;;     Thread A makes three NON-blocking foreign calls with sleeps between;\n;;     thread B performs REAL collections ((##gc) — the runtime primitive whose\n;;     c-code calls the documented C API ___garbage_collect, lib/_kernel.scm:2032-2069 —\n;;     and the documented C API itself via w2-real-gc) while allocating between\n;;     rounds. With -:d5 the runtime prints \"*** GC:\" reports, which is the\n;;     verbatim proof that REAL collection completed (the adapter's\n;;     sa-gc-collect no-op cannot produce these). PASS means the thread/GC\n;;     machinery itself works — the control for the blocked run.\n;;\n;;   ./w2.exe -:d5 blocked\n;;     Thread A enters the blocking foreign call (w2_block, 6s C-side\n;;     deadline). Thread B is made runnable BEFORE A's call enters and performs\n;;     the same REAL collection rounds. PASS would require B's rounds to\n;;     complete WHILE C is blocked (astra §2: \"actual collection and another\n;;     Scheme thread's progress while C remains blocked\").\n;;\n;; On the provisioned build there is exactly ONE OS thread running Scheme\n;; (___SINGLE_THREADED_VMS, ___MAX_PROCESSORS=1 — see W0), so while C is\n;; blocked NO Scheme thread can be scheduled and NO collection can run: B's\n;; rounds all appear after \"W2C: foreign call RETURNING\". That is the recorded\n;; NO-GO evidence for the sa-foreign-procedure-blocking row on this build.\n;;\n;; A Scheme-internal watchdog cannot fire here (the whole VM is frozen inside\n;; the foreign call), so every run is under the external watchdog.sh.\n\n(c-declare #<<c-declare-end\n\nint w2_block (int deadline_seconds);\nvoid w2_release_handshake (void);\nint w2_noblock (void);\n\nc-declare-end\n)\n\n(define w2-block   (c-lambda (int) int \"w2_block\"))\n(define w2-noblock (c-lambda () int \"w2_noblock\"))\n;; REAL collection through the documented C API (gambit.h ~14769):\n;;   ___IMP_FUNC(___BOOL,___garbage_collect)\n;;      ___P((___PSD ___SIZE_TS requested_words_still),());\n(define w2-real-gc\n  (c-lambda () int\n    \"___return (___EXT(___garbage_collect) (___PSP 0) ? 1 : 0);\"))\n\n(define (w2-now) (time->seconds (current-time)))\n(define (w2-log . parts)\n  ;; one forced-flush line, so the ordering with the C fixture's\n  ;; stdout prints (also flushed) is exact in the recorded output.\n  (for-each display parts)\n  (newline)\n  (force-output))\n\n(define (w2-gc-rounds who n)\n  ;; allocate, then force a REAL collection via the runtime primitive and via\n  ;; the documented C API; the runtime's own \"-:d5\" GC report lines are the\n  ;; verbatim evidence that collection actually ran.\n  (let loop ((i 1))\n    (if (<= i n)\n        (begin\n          (w2-log who \": round \" i \" t=\" (w2-now)\n                  \" allocating + ##gc (runtime primitive)\")\n          (let ((v (make-vector 200000 0)))\n            (vector-set! v 0 i)\n            (##gc)\n            (let ((r (w2-real-gc)))\n              (w2-log who \": round \" i \" t=\" (w2-now)\n                      \" done (capi-gc-return=\" r \")\")\n              (loop (+ i 1))))))))\n\n(define (w2-control)\n  ;; A: non-blocking foreign calls; B: real GC rounds must overlap them.\n  (define (a-work)\n    (let loop ((i 1))\n      (if (<= i 3)\n          (begin\n            (w2-log \"W2-A: non-blocking foreign call \" i \" t=\" (w2-now))\n            (w2-noblock)\n            (thread-sleep! 0.3)\n            (loop (+ i 1)))\n          (w2-log \"W2-A: all non-blocking calls returned\"))))\n  (let* ((t-b (make-thread (lambda () (w2-gc-rounds \"W2-B\" 3)) 'w2-b))\n         (t-a (make-thread a-work 'w2-a)))\n    (thread-start! t-b)\n    (thread-start! t-a)\n    (thread-join! t-b)\n    (thread-join! t-a)\n    (w2-log \"W2-VERDICT: PASS (control: real collections completed while another thread made foreign calls; the *** GC: report lines above are the runtime's own collection evidence)\")))\n\n(define (w2-blocked)\n  ;; A: blocking foreign call with 6s C-side deadline.\n  ;; B: made runnable BEFORE A enters, performs the same real GC rounds.\n  (let* ((t-a (make-thread (lambda () (w2-block 6)) 'w2-a))\n         (t-b (make-thread (lambda () (w2-gc-rounds \"W2-B\" 3)) 'w2-b)))\n    (thread-start! t-a)\n    (let ((t-block-start (w2-now)))\n      ;; give A a moment to enter the foreign call, then make B runnable\n      (thread-sleep! 0.3)\n      (thread-start! t-b)\n      (thread-join! t-b)\n      (thread-join! t-a)\n      (w2-log \"W2: blocked window from t=\" t-block-start \" to t=\" (w2-now))\n      (w2-log \"W2-VERDICT: FAIL (blocked: no collection and no other-thread progress while the foreign call was blocked — every W2-B line above appears after 'W2C: foreign call RETURNING'; the VM has a single processor and 4.9.8 has no foreign-release mechanism, so the blocking row cannot be satisfied on this build)\"))))\n\n(define (w2-run mode)\n  (w2-log \"=== W2 blocking-GC witness: mode=\" mode \" ===\")\n  (w2-log \"W2: t=\" (w2-now) \" start\")\n  (case mode\n    ((control) (w2-control))\n    ((blocked) (w2-blocked))\n    (else\n     (w2-log \"W2-usage: ./w2.exe -:d5 control|blocked\"))))\n\n;; compiled exe: the mode is the first non-(-:) command-line argument\n(let ((args (command-line)))\n  (w2-run (cond\n           ((and (pair? args)\n                 (member (car args) '(\"control\" \"blocked\")))\n            (string->symbol (car args)))\n           ((and (pair? args) (pair? (cdr args))\n                 (member (cadr args) '(\"control\" \"blocked\")))\n            (string->symbol (cadr args)))\n           (else 'usage))))\n/* W2 fixture — the blocking-call shape.\n *\n * w2_block announces entry on stdout (flushed), then blocks on a handshake\n * that NO Scheme thread can perform while this foreign call occupies the\n * only processor of the provisioned single-threaded-VMS build. A C-side\n * deadline converts what is otherwise a permanent deadlock into structured\n * evidence; the external watchdog (watchdog.sh) is the second line of\n * defense.\n *\n * The real collection used by the witness goes through the documented runtime\n * API gambit.h:14772-14774:\n *   ___IMP_FUNC(___BOOL,___garbage_collect)\n *      ___P((___PSD ___SIZE_TS requested_words_still),());\n */\n\n#include <stdio.h>\n#include <errno.h>\n#include <time.h>\n#include <pthread.h>\n\nstatic pthread_mutex_t w2_mu = PTHREAD_MUTEX_INITIALIZER;\nstatic pthread_cond_t  w2_cv = PTHREAD_COND_INITIALIZER;\nstatic int w2_proceed = 0;\n\nint w2_block (int deadline_seconds)\n{\n  struct timespec ts;\n  clock_gettime (CLOCK_REALTIME, &ts);\n  ts.tv_sec += deadline_seconds;\n\n  fprintf (stdout, \"W2C: foreign call ENTERED, blocking on handshake (deadline %ds)\\n\",\n           deadline_seconds);\n  fflush (stdout);\n\n  pthread_mutex_lock (&w2_mu);\n  while (!w2_proceed)\n    {\n      int r = pthread_cond_timedwait (&w2_cv, &w2_mu, &ts);\n      if (r == ETIMEDOUT)\n        break;\n    }\n  pthread_mutex_unlock (&w2_mu);\n\n  fprintf (stdout, \"W2C: foreign call RETURNING after blocked interval\\n\");\n  fflush (stdout);\n  return 1;\n}\n\nvoid w2_release_handshake (void)\n{\n  pthread_mutex_lock (&w2_mu);\n  w2_proceed = 1;\n  pthread_cond_broadcast (&w2_cv);\n  pthread_mutex_unlock (&w2_mu);\n}\n\nint w2_noblock (void)\n{\n  fprintf (stdout, \"W2C: non-blocking foreign call entered+returned\\n\");\n  fflush (stdout);\n  return 1;\n}\n/* W3 fixture — raw-pthread entry into Scheme.\n *\n * Build (the manual's documented \"Scheme server\" pattern, tests/makefile.in:166):\n *   gsc -exe -cc-options \"-D___LIBRARY\" -o w3.exe w3-fthread.c w3-server.scm\n *\n * Run one phase per process so a crash in one phase cannot erase the\n * evidence of another (each run is watchdogged by the Makefile):\n *\n *   ./w3.exe phase1          serialized entry, heartbeat ON (default runtime)\n *   ./w3.exe phase1-nobeat   serialized entry, heartbeat DISABLED during the\n *                            worker run (undocumented ___set_heartbeat_interval,\n *                            lib/os_time.c:937 — used ONLY to isolate the\n *                            cause of the phase1 crash)\n *   ./w3.exe phase2          concurrent entry: worker pthread calls Scheme\n *                            WHILE the primordial thread runs Scheme\n *   ./w3.exe phase3          owner Gambit thread parked inside a cfun call\n *                            (c-lambda) while the worker enters — the shape\n *                            under which W4-M4's callback survived\n *\n * On a ___SINGLE_THREADED_VMS build there is exactly one processor state\n * (gambit.h:8625-8628: \"Use direct access to the only pstate\";\n * ___SET_REAL_PSTATE is a no-op there) and no documented protocol for a\n * foreign pthread to enter.\n */\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <pthread.h>\n#include <unistd.h>\n\n#include <gambit.h>\n\n/* c-define'd in w3-server.scm */\nextern int scheme_w3_add (int x, int y);\nextern int scheme_w3_add_alloc (int x, int y);\nextern int scheme_w3_gc_rounds (int n);\nextern int scheme_w3_spin (int ms);\nextern int scheme_w3_phase3 (void);\n\n/* Undocumented heartbeat control (lib/os_time.c:932-948). NOT in gambit.h —\n   used only to isolate the cause of the phase1 crash. */\nextern void ___set_heartbeat_interval (double seconds);\nextern double ___get_heartbeat_interval (void);\n\n#define SCHEME_LIBRARY_LINKER ___LNK_w3_2d_server__\n___BEGIN_C_LINKAGE\nextern ___mod_or_lnk SCHEME_LIBRARY_LINKER (___global_state);\n___END_C_LINKAGE\n\nstatic void *w3_worker_serialized (void *arg)\n{\n  int i, r, g;\n  (void) arg;\n  /* discriminator FIRST: the allocating shape (W4-M4's callback body) entered\n     exactly like the trivial add. Result on macOS arm64: this call ALSO fails\n     to complete (no W3-WORKER line is ever printed), so the discriminator is\n     NOT allocation-related — the first foreign-pthread Scheme entry itself\n     crashes in the phase1/phase3 contexts. */\n  r = scheme_w3_add_alloc (50, 22);\n  printf (\"W3-WORKER: scheme_w3_add_alloc(50,22) = %d (expected 1072)\\n\", r);\n  fflush (stdout);\n  for (i = 0; i < 3; i++)\n    {\n      r = scheme_w3_add (20 + i, 22);\n      printf (\"W3-WORKER: scheme_w3_add(%d,22) = %d\\n\", 20 + i, r);\n      fflush (stdout);\n      if (r != 42 + i)\n        {\n          printf (\"W3-WORKER: WRONG RESULT %d\\n\", r);\n          fflush (stdout);\n          return (void *) 1;\n        }\n    }\n  g = scheme_w3_gc_rounds (3);   /* real collections driven from the worker */\n  printf (\"W3-WORKER: drove %d real gc rounds (runtime *** GC: reports below with -:d5)\\n\", g);\n  fflush (stdout);\n  r = scheme_w3_add (1, 1);\n  printf (\"W3-WORKER: final scheme_w3_add(1,1) = %d\\n\", r);\n  fflush (stdout);\n  return (void *) (long) (r == 2 ? 0 : 2);\n}\n\nstatic void *w3_worker_concurrent (void *arg)\n{\n  int i, r;\n  long bad = 0;\n  (void) arg;\n  /* wait a moment so the primordial is definitely inside scheme_w3_spin */\n  usleep (200000);\n  for (i = 0; i < 10000; i++)\n    {\n      r = scheme_w3_add (1, 1);\n      if (r != 2)\n        bad++;\n    }\n  printf (\"W3-WORKER: completed 10000 concurrent entries, bad=%ld\\n\", bad);\n  fflush (stdout);\n  return (void *) 0;\n}\n\nstatic pthread_t w3_tid;\n\nvoid w3_spawn_worker_nojoin (void)\n{\n  pthread_create (&w3_tid, NULL, w3_worker_concurrent, NULL);\n}\n\n/* phase3: the OWNER Gambit thread parks inside a cfun (c-lambda) call while\n   the worker pthread enters Scheme — the same shape as W4-M4 but with the\n   worker also driving real collections. w3_park_and_join is reached FROM\n   Scheme (c-lambda), so the owner's Scheme frame is live and parked. */\nint w3_park_and_join (int unused)\n{\n  void *ret = 0;\n  (void) unused;\n  pthread_create (&w3_tid, NULL, w3_worker_serialized, NULL);\n  pthread_join (w3_tid, &ret);\n  return (int) (long) ret;\n}\n\nstatic void w3_setup_runtime (void)\n{\n  ___setup_params_struct setup_params;\n\n  ___setup_params_reset (&setup_params);\n  setup_params.version = ___VERSION;\n  setup_params.linker  = SCHEME_LIBRARY_LINKER;\n\n  printf (\"W3: calling ___setup from the primordial thread\\n\");\n  fflush (stdout);\n  ___setup (&setup_params);\n  printf (\"W3: ___setup returned; runtime live (___VERSION=%ld)\\n\", (long) ___VERSION);\n  fflush (stdout);\n}\n\nstatic int w3_phase1 (int disable_heartbeat)\n{\n  double saved_beat;\n  void *ret = 0;\n\n  printf (\"W3-PHASE1: spawning raw pthread (primordial will park in pthread_join)\\n\");\n  fflush (stdout);\n\n  saved_beat = ___get_heartbeat_interval ();\n  printf (\"W3-PHASE1: heartbeat interval = %f\\n\", saved_beat);\n  fflush (stdout);\n  if (disable_heartbeat)\n    {\n      ___set_heartbeat_interval (0.0);\n      printf (\"W3-PHASE1: heartbeat DISABLED for this run\\n\");\n      fflush (stdout);\n    }\n\n  pthread_create (&w3_tid, NULL, w3_worker_serialized, NULL);\n  pthread_join (w3_tid, &ret);\n\n  if (disable_heartbeat)\n    ___set_heartbeat_interval (saved_beat);\n\n  printf (\"W3-PHASE1: worker joined, exit=%d (0 = all calls returned expected values)\\n\",\n          (int) (long) ret);\n  fflush (stdout);\n  printf (\"W3-PHASE1-VERDICT: %s\\n\",\n          (int) (long) ret == 0\n            ? (disable_heartbeat\n                 ? \"PASS-QUALIFIED (serialized entry survived with heartbeat disabled; undocumented isolation, no documented protocol)\"\n                 : \"PASS (serialized entry survived with heartbeat on)\")\n            : \"FAIL\");\n  fflush (stdout);\n  return (int) (long) ret;\n}\n\nstatic int w3_phase2 (void)\n{\n  void *ret = 0;\n  int spin;\n\n  printf (\"W3-PHASE2: spawning raw pthread WHILE primordial runs scheme_w3_spin\\n\");\n  fflush (stdout);\n  spin = scheme_w3_spin (3000);   /* spawns worker, then allocates ~3s */\n  pthread_join (w3_tid, &ret);\n  printf (\"W3-PHASE2: primordial survived scheme_w3_spin (allocs=%d), worker joined exit=%d\\n\",\n          spin, (int) (long) ret);\n  fflush (stdout);\n  printf (\"W3-PHASE2-VERDICT: PASS (concurrent entry returned — treated with suspicion: two threads shared one pstate)\\n\");\n  fflush (stdout);\n  return 0;\n}\n\nstatic int w3_phase3 (void)\n{\n  int r;\n  printf (\"W3-PHASE3: owner Gambit thread parks INSIDE a cfun call while the worker pthread enters Scheme\\n\");\n  fflush (stdout);\n  r = scheme_w3_phase3 ();   /* c-define'd: Scheme calls w3_park_and_join via c-lambda */\n  printf (\"W3-PHASE3: worker joined exit=%d\\n\", r);\n  fflush (stdout);\n  printf (\"W3-PHASE3-VERDICT: %s\\n\",\n          r == 0\n            ? \"PASS (worker entry survived with owner parked in a cfun frame — undocumented serialized reuse)\"\n            : \"FAIL\");\n  fflush (stdout);\n  return r;\n}\n\nint main (int argc, char **argv)\n{\n  const char *phase = (argc > 1) ? argv[1] : \"all\";\n\n  w3_setup_runtime ();\n\n  if (strcmp (phase, \"phase1\") == 0 || strcmp (phase, \"all\") == 0)\n    w3_phase1 (0);\n  if (strcmp (phase, \"phase1-nobeat\") == 0)\n    w3_phase1 (1);\n  if (strcmp (phase, \"phase2\") == 0 || strcmp (phase, \"all\") == 0)\n    w3_phase2 ();\n  if (strcmp (phase, \"phase3\") == 0)\n    w3_phase3 ();\n\n  printf (\"W3: calling ___cleanup\\n\");\n  fflush (stdout);\n  ___cleanup ();\n  printf (\"W3: ___cleanup returned\\n\");\n  fflush (stdout);\n  return 0;\n}\n","exit_code":0,"status":"completed"}}
