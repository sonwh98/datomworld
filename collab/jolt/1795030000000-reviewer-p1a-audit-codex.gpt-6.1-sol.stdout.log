ded verbatim under\n     5\t# results/ with a \"### exit=\" line per run.\n     6\t#\n     7\t# Provisioned toolchain (absolute mise paths — NEVER bare gsc from PATH,\n     8\t# that gsc is Ghostscript):\n     9\tGSC ?= /Users/sto/.local/share/mise/installs/gambit/4.9.8/bin/gsc\n    10\tSH  ?= ./watchdog.sh\n    11\tRES ?= results\n    12\t\n    13\t.PHONY: all clean build-witnesses\n    14\t\n    15\tall: build-witnesses record\n    16\t\n    17\tbuild-witnesses: w0-config.exe w1.exe w2.exe w3.exe w4.exe\n    18\t\n    19\trecord: record-w0 record-w1 record-w2 record-w3 record-w4\n    20\t\n    21\t$(RES):\n    22\t\tmkdir -p $(RES)\n    23\t\n    24\t# ---- builds -------------------------------------------------------------\n    25\t\n    26\tw0-config.exe: w0-config.scm\n    27\t\t$(GSC) -warnings -exe -o $@ $<\n    28\t\n    29\tw1.exe: w1-errno.scm w1-fixture.c\n    30\t\t$(GSC) -warnings -exe -o $@ w1-errno.scm w1-fixture.c\n    31\t\n    32\tw2.exe: w2-blocking.scm w2-fixture.c\n    33\t\t$(GSC) -warnings -exe -o $@ w2-blocking.scm w2-fixture.c\n    34\t\n    35\t# The manual's documented \"Scheme server\" build pattern\n    36\t# (doc/gambit.txi §c-define; tests/makefile.in:166).\n    37\tw3.exe: w3-fthread.c w3-server.scm\n    38\t\t$(GSC) -warnings -exe -cc-options \"-D___LIBRARY\" -o $@ w3-fthread.c w3-server.scm\n    39\t\n    40\tw4.exe: w4-callables.scm w4-fixture.c\n    41\t\t$(GSC) -warnings -exe -o $@ w4-callables.scm w4-fixture.c\n    42\t\n    43\t# ---- recorded runs ------------------------------------------------------\n    44\t\n    45\trecord-w0: w0-config.exe | $(RES)\n    46\t\t@echo \"### cmd: $(SH) 60 ./w0-config.exe\" > $(RES)/w0.out\n    47\t\t@$(SH) 60 ./w0-config.exe >> $(RES)/w0.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w0.out\n    48\t\t@cat $(RES)/w0.out\n    49\t\n    50\trecord-w1: w1.exe | $(RES)\n    51\t\t@echo \"### cmd: $(SH) 120 ./w1.exe\" > $(RES)/w1.out\n    52\t\t@$(SH) 120 ./w1.exe >> $(RES)/w1.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w1.out\n    53\t\t@cat $(RES)/w1.out\n    54\t\n    55\trecord-w2: w2.exe | $(RES)\n    56\t\t@echo \"### cmd: $(SH) 60 ./w2.exe -:d5 control\" > $(RES)/w2-control.out\n    57\t\t@$(SH) 60 ./w2.exe -:d5 control >> $(RES)/w2-control.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w2-control.out\n    58\t\t@cat $(RES)/w2-control.out\n    59\t\t@echo \"### cmd: $(SH) 60 ./w2.exe -:d5 blocked\" > $(RES)/w2-blocked.out\n    60\t\t@$(SH) 60 ./w2.exe -:d5 blocked >> $(RES)/w2-blocked.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w2-blocked.out\n    61\t\t@cat $(RES)/w2-blocked.out\n    62\t\n    63\trecord-w3: w3.exe | $(RES)\n    64\t\t@echo \"### cmd: $(SH) 60 ./w3.exe phase1\" > $(RES)/w3-phase1.out\n    65\t\t@$(SH) 60 ./w3.exe phase1 >> $(RES)/w3-phase1.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w3-phase1.out\n    66\t\t@cat $(RES)/w3-phase1.out\n    67\t\t@echo \"### cmd: $(SH) 60 ./w3.exe phase1-nobeat\" > $(RES)/w3-phase1-nobeat.out\n    68\t\t@$(SH) 60 ./w3.exe phase1-nobeat >> $(RES)/w3-phase1-nobeat.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w3-phase1-nobeat.out\n    69\t\t@cat $(RES)/w3-phase1-nobeat.out\n    70\t\t@echo \"### cmd: $(SH) 60 ./w3.exe phase2 (run 1 of 2)\" > $(RES)/w3-phase2-run1.out\n    71\t\t@$(SH) 60 ./w3.exe phase2 >> $(RES)/w3-phase2-run1.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w3-phase2-run1.out\n    72\t\t@cat $(RES)/w3-phase2-run1.out\n    73\t\t@echo \"### cmd: $(SH) 60 ./w3.exe phase2 (run 2 of 2)\" > $(RES)/w3-phase2-run2.out\n    74\t\t@$(SH) 60 ./w3.exe phase2 >> $(RES)/w3-phase2-run2.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w3-phase2-run2.out\n    75\t\t@cat $(RES)/w3-phase2-run2.out\n    76\t\t@echo \"### cmd: $(SH) 60 ./w3.exe phase3\" > $(RES)/w3-phase3.out\n    77\t\t@$(SH) 60 ./w3.exe phase3 >> $(RES)/w3-phase3.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w3-phase3.out\n    78\t\t@cat $(RES)/w3-phase3.out\n    79\t\n    80\trecord-w4: w4.exe | $(RES)\n    81\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode1\" > $(RES)/w4-mode1.out\n    82\t\t@$(SH) 60 ./w4.exe mode1 >> $(RES)/w4-mode1.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w4-mode1.out\n    83\t\t@cat $(RES)/w4-mode1.out\n    84\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode4 (run 1 of 3)\" > $(RES)/w4-mode4-run1.out\n    85\t\t@$(SH) 60 ./w4.exe mode4 >> $(RES)/w4-mode4-run1.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w4-mode4-run1.out\n    86\t\t@cat $(RES)/w4-mode4-run1.out\n    87\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode4 (run 2 of 3)\" > $(RES)/w4-mode4-run2.out\n    88\t\t@$(SH) 60 ./w4.exe mode4 >> $(RES)/w4-mode4-run2.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w4-mode4-run2.out\n    89\t\t@cat $(RES)/w4-mode4-run2.out\n    90\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode4 (run 3 of 3)\" > $(RES)/w4-mode4-run3.out\n    91\t\t@$(SH) 60 ./w4.exe mode4 >> $(RES)/w4-mode4-run3.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w4-mode4-run3.out\n    92\t\t@cat $(RES)/w4-mode4-run3.out\n    93\t\t@echo \"### cmd: $(SH) 60 ./w4.exe mode5\" > $(RES)/w4-mode5.out\n    94\t\t@$(SH) 60 ./w4.exe mode5 >> $(RES)/w4-mode5.out 2>&1; echo \"### exit=$$?\" >> $(RES)/w4-mode5.out\n    95\t\t@cat $(RES)/w4-mode5.out\n    96\t\n    97\tclean:\n    98\t\trm -f *.exe *.o\n    99\t\trm -f w0-config.c w1-errno.c w1-errno_.c w2-blocking.c w2-blocking_.c \\\n   100\t\t      w3-server.c w3-server_.c w4-callables.c w4-callables_.c\n   101\t\trm -rf $(RES)\n    90\t    (thread-join! t-a)\n    91\t    (w2-log \"W2-VERDICT: PASS (control: real collections completed while another thread made foreign calls; the *** GC: report lines above are the runtime's own collection evidence)\")))\n    92\t\n    93\t(define (w2-blocked)\n    94\t  ;; A: blocking foreign call with 6s C-side deadline.\n    95\t  ;; B: made runnable BEFORE A enters, performs the same real GC rounds.\n    96\t  (let* ((t-a (make-thread (lambda () (w2-block 6)) 'w2-a))\n    97\t         (t-b (make-thread (lambda () (w2-gc-rounds \"W2-B\" 3)) 'w2-b)))\n    98\t    (thread-start! t-a)\n    99\t    (let ((t-block-start (w2-now)))\n   100\t      ;; give A a moment to enter the foreign call, then make B runnable\n   101\t      (thread-sleep! 0.3)\n   102\t      (thread-start! t-b)\n   103\t      (thread-join! t-b)\n   104\t      (thread-join! t-a)\n   105\t      (w2-log \"W2: blocked window from t=\" t-block-start \" to t=\" (w2-now))\n   106\t      (w2-log \"W2-VERDICT: FAIL (blocked: no collection and no other-thread progress while the foreign call was blocked — every W2-B line above appears after 'W2C: foreign call RETURNING'; the VM has a single processor and 4.9.8 has no foreign-release mechanism, so the blocking row cannot be satisfied on this build)\"))))\n   107\t\n   108\t(define (w2-run mode)\n   109\t  (w2-log \"=== W2 blocking-GC witness: mode=\" mode \" ===\")\n   110\t  (w2-log \"W2: t=\" (w2-now) \" start\")\n   111\t  (case mode\n   112\t    ((control) (w2-control))\n   113\t    ((blocked) (w2-blocked))\n   114\t    (else\n   115\t     (w2-log \"W2-usage: ./w2.exe -:d5 control|blocked\"))))\n   116\t\n   117\t;; compiled exe: the mode is the first non-(-:) command-line argument\n   118\t(let ((args (command-line)))\n   119\t  (w2-run (cond\n   120\t           ((and (pair? args)\n   121\t                 (member (car args) '(\"control\" \"blocked\")))\n   122\t            (string->symbol (car args)))\n   123\t           ((and (pair? args) (pair? (cdr args))\n   124\t                 (member (cadr args) '(\"control\" \"blocked\")))\n   125\t            (string->symbol (cadr args)))\n   126\t           (else 'usage))))\n    35\t  pthread_mutex_lock (&w2_mu);\n    36\t  while (!w2_proceed)\n    37\t    {\n    38\t      int r = pthread_cond_timedwait (&w2_cv, &w2_mu, &ts);\n    39\t      if (r == ETIMEDOUT)\n    40\t        break;\n    41\t    }\n    42\t  pthread_mutex_unlock (&w2_mu);\n    43\t\n    44\t  fprintf (stdout, \"W2C: foreign call RETURNING after blocked interval\\n\");\n    45\t  fflush (stdout);\n    46\t  return 1;\n    47\t}\n    48\t\n    49\tvoid w2_release_handshake (void)\n    50\t{\n    51\t  pthread_mutex_lock (&w2_mu);\n    52\t  w2_proceed = 1;\n    53\t  pthread_cond_broadcast (&w2_cv);\n    54\t  pthread_mutex_unlock (&w2_mu);\n    55\t}\n    56\t\n    57\tint w2_noblock (void)\n    58\t{\n    59\t  fprintf (stdout, \"W2C: non-blocking foreign call entered+returned\\n\");\n    60\t  fflush (stdout);\n    61\t  return 1;\n    62\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"W3’s crash evidence has a confound: two Scheme procedures require `(x y)`, but their `c-define` declarations export only one C argument. Retained generated C confirms `NARGS=1`, while the fixture declares and calls two arguments. The crashes reproduce 3/3, but cannot establish the claimed foreign-thread failure mechanism until the signatures are corrected and an owner-thread control passes.\n\nThe alternate build enables processor TLS, multiple processors, and a separate SMP scheduler. Its GC still requires an all-processor barrier; I have not found a transition that exempts a processor blocked in C."}}
