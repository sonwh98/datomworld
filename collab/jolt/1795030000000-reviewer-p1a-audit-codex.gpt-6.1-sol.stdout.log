*/\n   873\t\n   874\t#else\n   875\t\n   876\t    p[ 0] = 0x07000000               /* sethi HHI22(p),%g3                   */\n   877\t           + (___CAST_U64(p) >> (10+32));\n   878\t    p[ 1] = 0x8610E000               /* or    %g3,HLO10(p),%g3               */\n   879\t           + ((___CAST_U64(p) >> 32) & 0x3ff);\n   880\t    p[ 2] = 0x8728F020;              /* sllx  %g3,32,%g3                     */\n   881\t    p[ 3] = 0x03000000               /* sethi LHI22(p),%g1                   */\n   882\t           + ((___CAST_U64(p) >> 10) & 0x3fffff);\n   883\t    p[ 4] = 0x82106000               /* or    %g1,LLO10(p),%g1               */\n   884\t           + (___CAST_U64(p) & 0x3ff);\n   885\t    p[ 5] = 0x8600C001;              /* add   %g3,%g1,%g3                    */\n   886\t    p[ 6] = 0x05000000               /* sethi HHI22(c_closure_self),%g2      */\n   887\t           + (___CAST_U64(&c_closure_self) >> (10+32));\n   888\t    p[ 7] = 0x8410A000               /* or    %g2,HLO10(c_closure_self),%g2  */\n   889\t           + ((___CAST_U64(&c_closure_self) >> 32) & 0x3ff);\n   890\t    p[ 8] = 0x8528B020;              /* sllx  %g2,32,%g2                     */\n   891\t    p[ 9] = 0x03000000               /* sethi LHI22(c_closure_self),%g1      */\n   892\t           + ((___CAST_U64(&c_closure_self) >> 10) & 0x3fffff);\n   893\t    p[10] = 0x84008001;              /* add   %g2,%g1,%g2                    */\n   894\t    p[11] = 0xC670A000               /* stx   %g3,[%g2+LLO10(c_closure_self)]*/\n   895\t           + (___CAST_U64(&c_closure_self) & 0x3ff);\n  1045\t\n  1046\t\n  1047\tvoid ___c_closure_release\n  1048\t   ___P((void *c_closure),\n  1049\t        (c_closure)\n  1050\tvoid *c_closure;)\n  1051\t{\n  1052\t  ___release_rc (c_closure);\n  1053\t}\n  1054\t\n  1055\t\n  1056\tvoid *___c_closure_self ___PVOID\n  1057\t{\n  1058\t  return c_closure_self;\n  1059\t}\n  1060\t\n  1061\t\n  1062\t/*---------------------------------------------------------------------------*/\n  1063\t\n  1064\t/* Dynamic code module initialization/finalization. */\n  1065\t\n  1066\t\n  1067\t___SCMOBJ ___setup_dyn_module ___PVOID\n  1068\t{\n  1069\t  if (!___dyn_mod.setup)\n  1070\t    {\n  1071\t      setup_dynamic_load ();\n  1072\t      ___dyn_mod.setup = 1;\n  1073\t      return ___FIX(___NO_ERR);\n  1074\t    }\n  1075\t\n  1076\t  return ___FIX(___UNKNOWN_ERR);\n  1077\t}\n  1078\t\n  1079\t\n  1080\tvoid ___cleanup_dyn_module ___PVOID\n  1081\t{\n  1082\t  if (___dyn_mod.setup)\n  1083\t    {\n  1084\t      cleanup_dynamic_load ();\n  1085\t      ___dyn_mod.setup = 0;\n 19090\t@code{wchar_t-string};\n 19091\t@code{nonnull-wchar_t-string}\n 19092\t@item foreign object\n 19093\t@code{scheme-object}; @code{bool}; @code{struct}/@code{union}/@code{type}/@code{pointer}/@code{nonnull-pointer} with the appropriate tags\n 19094\t@item vector\n 19095\t@code{scheme-object}; @code{bool}\n 19096\t@item symbol\n 19097\t@code{scheme-object}; @code{bool}\n 19098\t@item procedure\n 19099\t@code{scheme-object}; @code{bool};\n 19100\t@code{function};\n 19101\t@code{nonnull-function}\n 19102\t@item other objects\n 19103\t@code{scheme-object}; @code{bool}\n 19134\tvoid object\n 19135\t@end table\n 19136\t\n 19137\tAll Scheme types are compatible with the C types @code{scheme-object}\n 19138\tand @code{bool}.  Conversion to and from the C type\n 19139\t@code{scheme-object} is the identity function on the object encoding.\n 19140\tThis provides a low-level mechanism for accessing Scheme's object\n 19141\trepresentation from C (with the help of the macros in the\n 19142\t@samp{gambit.h} header file).  When a C @code{bool} type is expected,\n 19143\tan extended Scheme boolean can be passed (@code{#f} is converted to 0\n 19144\tand all other values are converted to 1).\n 19145\t\n 19146\tThe Scheme boolean @code{#f} can be passed to the C environment where\n 19147\ta @code{char-string}, @code{ISO-8859-1-string}, @code{UTF-8-string},\n 19148\t@code{UTF-16-string}, @code{UCS-2-string}, @code{UCS-4-string},\n 19149\t@code{wchar_t-string}, @code{pointer} or @code{function} type is\n 19150\texpected.  In this case, @code{#f} is converted to the @samp{NULL}\n 19151\tpointer.  C @code{bool}s are extended booleans so any value different\n    45\t|---|---|\n    46\t| Scalar calls, native memory, `dlopen`/symbol lookup | Feasible through a compiled native bridge exposed with Gambit `c-lambda`, with declarations/helpers supplied through `c-declare`. |\n    47\t| Atomic C result plus errno | Feasible through typed C wrappers that save errno immediately after the target returns, before conversion, cleanup, allocation, or runtime re-entry. |\n    48\t| Blocking calls allowing other threads’ GC | Plain `c-lambda` is insufficient evidence. Enable only after proving the exact 4.9.8 runtime transition and independent Scheme-thread progress. |\n    49\t| Same-thread Scheme callbacks | `c-define` supplies an entry mechanism, but dynamic closure identity, rooting, lifetime, exceptions, and re-entry still require implementation. |\n    50\t| Callbacks from an unrelated C thread | Unqualified. Requires verified attachment/claim, Scheme entry, and release/detachment rules for the exact runtime build. |\n    51\t| Arbitrary runtime signatures | Not provided merely by expanding to compile-time `c-lambda`. Needs a runtime ABI engine or explicitly bounded compiled signature support. |\n    52\t| Native compilation, FASL, subprocess | Separate capabilities; remain refused unless independently implemented and qualified. |\n    53\t\n    54\tThere is an important evidence limit: **I cannot name a verified 4.9.8 release/claim API or declare these rows impossible on every 4.9.8 configuration from the available source.** Supplying exact function names or signatures here would be speculation. This is an unresolved P1 prerequisite, not an assertion that later Gambit APIs exist in 4.9.8.\n    55\t\n    56\tThe implementer must inspect the exact provisioned 4.9.8 source and record:\n    57\t\n    58\t1. Runtime build configuration and threading model.\n    59\t2. Exact declarations and implementations of any leave/re-enter or release/claim mechanism.\n    60\t3. Whether a released foreign frame permits collection and whether another Scheme thread can actually run.\n    61\t4. Rules for a previously unknown pthread entering Scheme.\n    62\t5. Root and processor-state obligations across those transitions.\n    63\t\n    64\tNeither `___ATOMIC` nor a C atomic variable establishes these properties. Object-reference release is also distinct from releasing runtime execution ownership. Do not translate Chez `__collect_safe` to a similarly named Gambit mechanism without proving its semantics.\n    65\t\n    66\tA single processor blocked inside C cannot run another green thread merely because its arguments are rooted. Conversely, enabling multiple native execution contexts does not establish that a foreign frame participates correctly in collection.\n    67\t\n    68\t**Fallback ruling:** permit explicitly documented FFI sub-capabilities. If blocking or foreign-thread entry cannot be qualified on the pinned runtime, those constructors continue to raise message-carrying unsupported errors. The basic memory/loader/call tier need not remain entirely disabled. Update `CONTRACT.txt` and `TARGET-CONTRACT.md` to describe this partial mode; do not silently redefine “FFI supported” to mean full support.\n    69\t\n    70\tA worker pool is **not** a transparent generic fallback. Moving calls changes native-thread identity, TLS, callback context, and potentially library behavior. A separately qualified worker interface for specific libraries is possible, but cannot masquerade as unrestricted `sa-foreign-procedure-blocking`.\n    71\t\n    72\t**2. Adapter and compiler design**\n    73\t\n    74\tAdd an explicit `:gambit` entry with `:unsafe-prefix \"\"` to `target-prims`. Keep generated code expressed through the adapter boundary; Gambit C forms belong in target-owned bridge compilation units.\n    75\t\n    76\tP1 must cover all foreign-call construction paths:\n    77\t\n    78\t- Ordinary and blocking `sa-foreign-procedure`.\n    79\t- `sa-foreign-procedure-native-error`, including combinations with supported conventions.\n    80\t- Both callable forms.\n    81\t- Runtime signature construction.\n    82\t- Scoped-address calls.\n    83\t- Varargs specialization.\n    84\t\n    77\t      (if (eq? (unbox b) old)\n    78\t          (begin (set-box! b new) #t)\n    79\t          #f))))\n    80\t\n    81\t(define (sa-gc-collect)\n    82\t  #f)\n    83\t\n    84\t;; (sa-gc-max-generation) -> exact integer\n    85\t;; The deepest collectable generation, for callers mapping JVM generations.\n   345\t;; (sa-foreign-procedure-blocking name args res) -> foreign procedure\n   346\t;; SYNTAX: like sa-foreign-procedure, but the call is __collect_safe. Contract:\n   347\t;; mark the call so a blocking foreign invocation does not stop other threads'\n   348\t;; GC. Degradation: no ffi tier on this target — raise, like the rest.\n   349\t(define-syntax sa-foreign-procedure-blocking\n   350\t  (syntax-rules ()\n   351\t    ((_ name args res) (sa-ffi-raise 'sa-foreign-procedure-blocking))\n   352\t    ((_ conv name args res) (sa-ffi-raise 'sa-foreign-procedure-blocking))))\n   353\t\n   354\t;; (sa-foreign-callable proc args res) -> foreign callable\n   355\t;; SYNTAX: compile-time-typed foreign-callable creation, mirroring\n   356\t;; sa-foreign-procedure. Contract: build a foreign callable around a Scheme\n   357\t;; procedure for a statically-known signature. Degradation: raise, like the rest.\n   358\t(define-syntax sa-foreign-callable\n   359\t  (syntax-rules ()\n   360\t    ((_ proc args res) (sa-ffi-raise 'sa-foreign-callable))))\n   361\t\n   362\t;; (sa-foreign-callable-collect-safe proc args res) -> foreign callable\n   363\t;; SYNTAX: like sa-foreign-callable, but the callable entry uses the\n   364\t;; __collect_safe convention. Degradation: raise, like the rest.\n   365\t(define-syntax sa-foreign-callable-collect-safe\n   366\t  (syntax-rules ()\n   367\t    ((_ proc args res) (sa-ffi-raise 'sa-foreign-callable-collect-safe))))\n   368\t\n   369\t;; (sa-foreign-procedure-runtime name args res blocking?) -> foreign procedure | #f\n   370\t;; Construct a foreign procedure from a RUNTIME-known signature. Contract:\n   371\t;; create a foreign procedure for a runtime signature. Degradation: raise —\n   372\t;; callers only ask when sa-foreign-entry? has said yes, which never happens\n   373\t;; on this target.\n   374\t(define (sa-foreign-procedure-runtime name args res blocking?)\n   375\t  (sa-ffi-raise 'sa-foreign-procedure-runtime))\n","exit_code":0,"status":"completed"}}
