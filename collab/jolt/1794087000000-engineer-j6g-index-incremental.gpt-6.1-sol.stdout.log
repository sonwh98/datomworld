294\t(deftest incremental-publication-covers-the-same-history-as-full-reconstruction\n   295\t  (let [{:keys [writer observer]} (small-medium 16)\n   296\t        initial (repl.index/make-indexer\n   297\t                  {:observer observer :session-token \"equivalence\"\n   298\t                   :content-store (mem/create-content-mem)\n   299\t                   :publish-opts {:branching-factor 4}})]\n   300\t    (reduce\n   301\t      (fn [ix round]\n   302\t        ;; More than one transaction in a round, including repeated content.\n   303\t        (doseq [v [round round (+ 100 round)]]\n   304\t          (stream/append! writer (literal-packet v)))\n   305\t        (let [next-ix (repl.index/step ix round)\n   306\t              store (:content-store next-ix)\n   307\t              incremental (index/read-manifest store (:manifest-address next-ix))\n   308\t              full (:manifest (full-publication next-ix))]\n   309\t          (is (true? (:published? (repl.index/status next-ix))))\n   310\t          (is (= (:count full) (:count incremental)))\n   311\t          (doseq [order [:eavt :aevt :avet :vaet]]\n   312\t            (is (= (vec (index/walk-index-datoms store (get-in full [:indexes order])))\n   313\t                   (vec (index/walk-index-datoms store (get-in incremental [:indexes order]))))\n   314\t                (str \"identical covered facts at round \" round \" in \" order)))\n   315\t          (is (= (:dao.stream/cursor (stream/cursor (:local next-ix) :dao.stream/newest))\n   316\t                 (get-in next-ix [:materialization :cursor])))\n   317\t          next-ix))\n   318\t      initial\n   319\t      (range 1 7))))\n   320\t\n   321\t\n   322\t(deftest a-fresh-round-does-not-reopen-the-retained-history\n   323\t  (let [[state _] (evaluate (repl.frontends/create-state) [\"1\" \"2\" \"3\"])\n   324\t        before (:indexer state)\n   325\t        snapshot index/snapshot-datoms\n   326\t        scans (atom 0)\n   327\t        [afte