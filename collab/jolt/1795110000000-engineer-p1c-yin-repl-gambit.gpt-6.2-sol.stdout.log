ter-runtime.ss:1132:  (bytevector-copy! to at from start end))\nhost/gambit/rt-core.ss:39:;;           paths) [987-1065] -- ADAPTED: jolt-random-bytes fills a bytevector\nhost/gambit/rt-core.ss:1065:;; fallback) is deleted. jolt-random-bytes fills a bytevector with\nhost/gambit/rt-core.ss:1070:  (let ((bv (make-bytevector n 0)))\nhost/gambit/rt-core.ss:1074:          (begin (bytevector-u8-set! bv i (random-integer 256))\nhost/gambit/rt-core.ss:1203:;; natives-array.ss (the byte-array <-> bytevector bridge).\nhost/gambit/rt-core.ss:1521:;; bytevector constant on chez, an inert argument here\nhost/gambit/rt-core.ss:1545:;; array exists here, so a ByteBuffer owns a bare bytevector and has no .array;\n(ns dao.host.bytes\n  \"The jolt override of src/cljc/dao/host/bytes.cljc (the :jolt alias puts\n   src/jolt first, docs/design/yin.repl-jolt-implementation.md §4.2): the\n   same public entries, arities, laws and refusal data\n   (docs/design/dao.stream.host-boundary.md §4.2, table A; §2.4).\n\n   The host byte array on jolt is jolt's own byte array (`byte-array`,\n   class `byte/1`, signed elements like the JVM's `byte[]`), so shared code\n   that reads one with `aget`/`alength`, and the test fixtures, see the\n   same value. A byte is read and written as a native integer 0 to 255.\n   Every entry is written over jolt's core array functions only, with the\n   prevalidation and memmove the laws require spelled out, rather than over\n   the `System/arraycopy` and `java.util.Arrays` shims the shared :clj arms\n   would reach.\"\n  (:refer-clojure :exclude [bytes? get set!]))\n\n\n(defn- refuse\n  [entry cls detail]\n  (throw (ex-info (str \"dao.host refused: \" entry \" \" (name cls) \" (\" detail \")\")\n                  {:dao.host/refusal cls :dao.host/entry entry :detail detail})))\n\n\n(defn bytes?\n  \"P. True when `x` is a host byte array.\"\n  [x]\n  (clojure.core/bytes? x))\n\n\n(defn- native-int?\n  [x]\n  (int? x))\n\n\n(defn- check-bytes!\n  [entry bs]\n  (when-not (bytes? bs)\n    (refuse entry :unsupported-value \"not a host byte array\")))\n\n\n(defn- check-index!\n  \"Refuse unless native integer `i` lies in [lo, hi].\"\n  [entry i lo hi]\n  (when-not (and (native-int? i) (<= lo i) (<= i hi))\n    (refuse entry :out-of-range (str i \" not in [\" lo \", \" hi \"]\"))))\n\n\n(defn- check-byte!\n  [entry v]\n  (when-not (and (native-int? v) (<= 0 v) (<= v 255))\n    (refuse entry :out-of-range (str v \" is not a byte 0-255\"))))\n\n\n(defn length\n  \"P. The number of bytes in `bs`.\"\n  [bs]\n  (check-bytes! 'length bs)\n  (alength bs))\n\n\n(defn alloc\n  \"P, fresh. A new host byte array of `n` zero bytes, `n` a native\n   integer from 0.\"\n  [n]\n  (when-not (and (native-int? n) (<= 0 n))\n    (refuse 'alloc :out-of-range (str n \" is not a length\")))\n  (byte-array n))\n\n\n(defn- byte-at\n  \"The byte at an index already checked.\"\n  [bs i]\n  (bit-and (aget bs i) 0xff))\n\n\n(defn- put!\n  \"Write byte `v` at an index already checked.\"\n  [bs i v]\n  (aset bs i (unchecked-byte v)))\n\n\n(defn get\n  \"P. The byte at index `i` of `bs`, 0 to 255.\"\n  [bs i]\n  (check-index! 'get i 0 (dec (length bs)))\n  (byte-at bs i))\n\n\n(defn slice\n  \"P, fresh. A new host byte array holding `bs[start, end)`, for\n   0 <= start <= end <= length.\"\n  [bs start end]\n  (let [n (length bs)]\n    (check-index! 'slice start 0 n)\n    (check-index! 'slice end start n))\n  (let [out (byte-array (- end start))]\n    (dotimes [i (- end start)]\n      (aset out i (aget bs (+ start i))))\n    out))\n\ntotal 8\n-rw-r--r--@ 1 sto  wheel  68 Nov 20 00:14 boot.ss\n-rw-r--r--@ 1 sto  wheel   0 Nov 20 00:14 compile.log\n  ok     (try (jolt.ffi/write-bytes 0 nil) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: write-bytes value must be a string, got nil\"\n  ok     (try (jolt.ffi/load-library [nil]) (catch IllegalArgumentException e (ex-message e))) => \"jolt.ffi: library candidate must be a string, got nil\"\n  ok     (t