{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"cat > /private/tmp/jolt-p1c-probe.ss <<'EOF'\n(##include \\\"/Users/sto/workspace/jolt-ffi-p1c/host/gambit/boot.ss\\\")\n(define probe-root \\\"/Users/sto/workspace/datomworld/\\\")\n(define probe-roots (list (cons (string-append probe-root \\\"src/jolt/\\\") '(\\\".jolt\\\" \\\".cljc\\\" \\\".clj\\\"))\n                          (cons (string-append probe-root \\\"src/cljc/\\\") '(\\\".cljc\\\" \\\".clj\\\"))\n                          (cons (string-append probe-root \\\"src/clj/\\\") '(\\\".clj\\\"))\n                          (cons \\\"stdlib/\\\" '(\\\".clj\\\" \\\".cljc\\\"))\n                          (cons \\\"jolt-core/\\\" '(\\\".clj\\\" \\\".cljc\\\"))))\n(define (probe-exn e)\n  (let ((v (jolt-unwrap-throw e)))\n    (or (and (not (eq? v e)) (jolt-pr-readable v))\n        (call-with-output-string (lambda (p) (display-exception e p))))))\n(define probe-loaded (make-table test: string=?))\n(define (probe-file n)\n  (let* ((base (list->string (map (lambda (c) (case c ((#\\\\.) #\\\\/) ((#\\\\-) #\\\\_) (else c))) (string->list n)))))\n    (let loop ((roots probe-roots))\n      (and (pair? roots)\n           (let try ((suffixes (cdar roots)))\n             (if (null? suffixes) (loop (cdr roots))\n                 (let ((p (string-append (caar roots) base (car suffixes))))\n                   (if (file-exists? p) p (try (cdr suffixes))))))))))\n(define (probe-load n force?)\n  (unless (or (table-ref probe-loaded n #f) (string=? n \\\"clojure.core\\\"))\n    (table-set\"'! probe-loaded n #t)\n    (let ((f (probe-file n)))\n      (fprintf (current-error-port) \"loading ~a ~a'\"\\\\n\\\" n f)\n      (force-output (current-error-port))\n      (if f\n          (guard (e (#t (fprintf (current-error-port) \\\"ERROR loading ~a: ~a\\\\n\\\" n (probe-exn e)) (exit 1)))\n            (jolt-with-ns-bound (lambda () (jolt-eval-string (call-with-input-file f gambit-read-all) f))