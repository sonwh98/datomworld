\n\n;; deref reads an atom; it also unwraps a `reduced` (Clojure @(reduced x) => x,\n;; which the overlay's `unreduced` relies on). The reduced record is in seq.ss.\n(define (jolt-deref x)\n  (cond\n    ((jolt-atom? x) (jolt-atom-val x))\n    ((jolt-reduced? x) (jolt-reduced-val x))\n    ;; the reference's last resort is a Future cast: nil is a NullPointerException\n    (else (jolt-cast-throw x \"java.util.concurrent.Future\"))))\n\n;; CAS the val from `old` to `nv` by identity (eq?), atomically. Returns #t on\n;; success. The compute step (f) runs outside this; a loser recomputes.\n(define (jolt-atom-cas! a old nv)\n  (when jolt-mt? (memory-order-release))\n  (sa-record-cas! a jolt-atom-val-slot old nv))\n;; Unconditional exchange (AtomicReference.getAndSet): the old value.\n389:  (def-var! \"jolt.ffi\" name (joltffi-refuse-fn name reason)))\n413:(def-var! \"jolt.ffi\" \"load-library\" joltffi-load-library)\n414:(def-var! \"jolt.ffi\" \"loaded?\" joltffi-loaded?)\n415:(def-var! \"jolt.ffi\" \"load-system-library\" joltffi-load-system-library)\n416:(def-var! \"jolt.ffi\" \"system-library-candidates\"\n418:(def-var! \"jolt.ffi\" \"load-failure-note\" joltffi-load-failure-note-var)\n419:(def-var! \"jolt.ffi\" \"find-symbol\" joltffi-find-symbol)\n420:(def-var! \"jolt.ffi\" \"dlsym-native\" jolt-ffi-dlsym-native)\n421:(def-var! \"jolt.ffi\" \"defining-libraries\" joltffi-defining-libraries)\n422:(def-var! \"jolt.ffi\" \"alloc\" joltffi-alloc)\n423:(def-var! \"jolt.ffi\" \"free\" joltffi-host-free)\n424:(def-var! \"jolt.ffi\" \"__alloc\" joltffi-alloc)\n425:(def-var! \"jolt.ffi\" \"__free\" joltffi-host-free)\n426:(def-var! \"jolt.ffi\" \"__calloc\" joltffi-calloc)\n427:(def-var! \"jolt.ffi\" \"read\" joltffi-read-fn)\n428:(def-var! \"jolt.ffi\" \"write\" joltffi-write-fn)\n429:(def-var! \"jolt.ffi\" \"__read\" joltffi-read-fn)\n430:(def-var! \"jolt.ffi\" \"__write\" joltffi-write-fn)\n431:(def-var! \"jolt.ffi\" \"copy\" joltffi-copy)\n432:(def-var! \"jolt.ffi\" \"__cop