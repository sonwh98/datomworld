r\" jolt-agent-error)\n(def-var! \"clojure.core\" \"restart-agent\" jolt-agent-restart)\n(def-var! \"clojure.core\" \"deref\" jolt-deref)\n(let ((overlay-realized? (var-deref \"clojure.core\" \"realized?\")))\n  (def-var! \"clojure.core\" \"realized?\"\n    (lambda (x)\n      (cond\n        ((or (jolt-future? x) (jolt-promise? x) (jolt-delay? x)) (jolt-conc-realized? x))\n        ;; a lazy-seq carries its own realized? flag (lazy-bridge.ss). The overlay\n        ;; realized? reads :jolt/type and throws on a jolt-lazyseq record.\n        ((jolt-lazyseq? x) (jolt-lazyseq-realized? x))\n        ;; a record/reify implementing clojure.lang.IPending answers via its\n        ;; isRealized method (the JVM casts to IPending and calls it); the\n        ;; result is boolean-cast like any interface-boolean return.\n        ((and (jrec? x) (find-method-any-protocol (jrec-tag x) \"isRealized\"))\n         => (lambda (m) (if (jolt-truthy? (jolt-invoke m x)) #t #f)))\n        ((reify-method-ref x \"isRealized\")\n         => (lambda (m) (if (jolt-truthy? (jolt-invoke m x)) #t #f)))\n        ;; a seq cell answers by its forced flag: the rest of a realized lazy\n        ;; chain is a cseq under jolt's seq model, and (realized? (rest s)) after\n        ;; a next must be true like the JVM's realized LazySeq — never a throw\n        ;; whose message renders the (possibly infinite) seq.\nhost/chez/refs.ss:618:(define (jolt-ref-deref ref)\nhost/chez/refs.ss:622:(define %pre-ref-deref jolt-deref)\nhost/chez/records-dispatch.ss:268:(define rd-extra-deref-hook #f)\nhost/chez/records-dispatch.ss:269:(define (set-rd-extra-deref-hook! f) (set! rd-extra-deref-hook f))\nhost/chez/records-dispatch.ss:270:(define (rd-deref-kind x)\nhost/chez/records-dispatch.ss:274:(define (rd-derefable? x) (and (rd-deref-kind x) #t))\nhost/chez/records-dispatch.ss:275:(define (rd-blocking-derefable? x) (eq? (quote iblocking) (rd-deref-kind x)))\nhost/chez/records-dispatch.ss:276:(define (rd-ideref-method x name argc)\nhost/chez/records-dispatch.ss:287:(define (rd-deref-as-boolean x) (jolt-boolean (jolt-deref x)))\nhost/chez/records-dispatch.ss:288:(define (rd-deref-as-int x) (jolt-int-cast (jolt-deref x)))\nhost/chez/records-dispatch.ss:289:(define (rd-deref-as-long x) (jolt-long-cast (jolt-deref x)))\nhost/chez/records-dispatch.ss:290:(define (rd-deref-as-double x) (jolt-double (jolt-deref x)))\nhost/chez/records-dispatch.ss:1017:(define (dot-coll-core name . args) (apply jolt-invoke (var-deref \"clojure.core\" name) args))\nhost/gambit/rt-core.ss:586:(define (var-deref ns name) (var-cell-root (jolt-var ns name)))\nhost/gambit/rt-core.ss:1576:(define (jolt-promise? x) #f)\nhost/chez/atoms.ss:94:(define (jolt-deref x)\n","exit_code":0,"status":"completed"}}
