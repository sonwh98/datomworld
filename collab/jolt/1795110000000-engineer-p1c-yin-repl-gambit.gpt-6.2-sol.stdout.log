SOR)\" sh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-abi.ss && \\\n2164:\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 180 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-public.ss; \\\n2177:gambitffi-errno-check: gambitffi-bridge $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1\n2179:\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-errno.ss; \\\n2184:gambitffi-load-failure-smoke: gambitffi-bridge\n2186:\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 90 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-load-failure.ss; \\\n2193:gambitffi: emittedheads deadhost gambitffi-abi gambitffi-errno-check gambitffi-load-failure-smoke\n2194:\t@echo \"gambitffi: PASS — all stage-1 qualified-tier gates green\"\n2224:# Runs on CHEZ (gambitseed), not gsi.\n2225:gambitseed:\n88630634 p1b-ci-r2: remove dead FFI helpers and classify native GC in JS audit\nf1a5c9f3 p1b-ci: guard emitted FFI heads and record per-install toolchain provenance\n3ecd20cc p1b-linux-r3: select and verify the platform errno accessor\n434dc2f9 p1b-linux-r2: select fixture shared-library flags by platform\nf5920f1f p1b-linux: record linux-x86_64 toolchain provenance pins\nbe0710cd p1b-linux: qualify toolchain provenance pins by host platform\n01a1f4c9-2302-78f0-b33d-90033750687a\n","exit_code":0,"status":"completed"}}
