\t#!/usr/bin/env gsi-script\n     2\t;; Native source launcher for the real Yin REPL. Run from the Jolt root with\n     3\t;; gsi host/gambit/yin-repl-main.ss /path/to/datomworld [Yin arguments...].\n     4\t(##include \"boot.ss\")\n     5\t(##include \"host-apply.ss\")\n     6\t(##include \"source-loader.ss\")\n     7\t\n     8\t(let ((args (cdr (command-line))))\n     9\t  (unless (pair? args)\n    10\t    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\n    11\t    (exit 2))\n    12\t  (let ((root (path-expand (car args)))\n    13\t        (jolt-root (current-directory)))\n    14\t    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\n    15\t      (fprintf (current-error-port) \"yin.repl: no source entry under ~a\\n\" root)\n    16\t      (exit 2))\n    17\t    (with-exception-catcher\n    18\t      (lambda (e)\n    19\t        (let* ((value (jolt-unwrap-throw e))\n    20\t               (message (jolt-throwable-message value)))\n    21\t          (fprintf (current-error-port) \"yin.repl startup failed: ~a\\n\"\n    22\t                   (if (string? message) message (jolt-pr-readable value)))\n    23\t          (exit 1)))\n    24\t      (lambda ()\n    25\t        ;; Cache the qualified bridge before resolving Yin's paths relative to\n    26\t        ;; its own checkout. The source loader itself uses absolute roots.\n    27\t        (joltffi-ensure-bridge! 'yin.repl)\n    28\t        (let ((load-ns\n    29\t                (gambit-install-source-loader!\n    30\t                  (list (list (path-expand \"src/jolt\" root) \".jolt\" \".cljc\" \".clj\")\n    31\t                        (list (path-expand \"src/cljc\" root) \".cljc\" \".clj\")\n    32\t                        (list (path-expand \"src/clj\" root) \".clj\")\n    33\t                        (list (path-expand \"stdlib\" jolt-root) \".jolt\" \".cljc\" \".clj\")\n    34\t                        (list (path-expand \"jolt-core\" j