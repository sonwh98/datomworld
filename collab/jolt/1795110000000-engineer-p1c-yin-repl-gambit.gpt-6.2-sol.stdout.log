(boolean (re-matches (re-pattern (:re wanted)) actual))\n    46\t      (= wanted actual))))\n    47\t\n    48\t\n    49\t(defn normalized\n    50\t  [text]\n    51\t  (-> text (str/replace #\"\\r\\n\" \"\\n\")\n    52\t      (str/replace #\"Host: (JVM|jolt) [^\\n]*\" \"<host>\") str/trim))\n    53\t\n    54\t\n    55\t(defn command\n    56\t  [host args]\n    57\t  (case host\n    58\t    :jolt (into [\"sh\" \"-c\"\n    59\t                 \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt:jolt-yin-repl --no-state \\\"$@\\\"\"\n    60\t                 \"jolt\"] args)\n    61\t    :jvm (into [\"clj\" \"-M:clj-yin-repl\" \"--no-state\"] args)))\n    62\t\n    63\t\n    64\t(defn run-session!\n    65\t  [host {:keys [id args in out quit exit startup-only idle-ms] :as case}]\n    66\t  (let [t0 (now)\n    67\t        process (.start (ProcessBuilder. ^java.util.List (command host args)))\n    68\t        stdout (atom \"\") stderr (atom \"\")\n    69\t        capture (fn [stream sink]\n    70\t                  (future\n    71\t                    (with-open [r (java.io.InputStreamReader. stream \"UTF-8\")]\n    72\t                      (loop []\n    73\t                        (let [c (.read r)]\n    74\t                          (when (not= -1 c)\n    75\t                            (swap! sink str (char c)) (recur)))))))\n    76\t        out-reader (capture (.getInputStream process) stdout)\n    77\t        err-reader (capture (.getErrorStream process) stderr)\n    78\t        writer (java.io.OutputStreamWriter. (.getOutputStream process) \"UTF-8\")\n    79\t        send! (fn [line] (.write writer (str line \"\\n\")) (.flush writer))\n    80\t        path (str \"build/j3-logs/shell/\" (name host) \"-\" (name id))\n    81\t        first-prompt (atom nil) latencies (atom [])]\n    82\t    (try\n    83\t      (when-not startup-only\n    84\t        (await! #(str/includes? @stdout prompt) process (+ t0 timeout-ms) \"first prompt\")\n    85\t        (reset! first-prompt (- (now) t0))\n    86\t        (println \"PROMPT\" (name host) id @first-prompt \"ms\")\n    87\t        (flush)\n    88\t        (when (= host :jolt)\n    89\t          (when-not (and (str/includes? @stdout \"Host: jolt \")\n    90\t                         (str/includes? @stdout \" / Chez \")\n    91\t                         (str/includes? @stdout \"python: the native C++ ANTLR4 parser\"))\n    92\t            (fail! \"missing jolt banner\" {:stdout @stdout})))\n    93\t        (when idle-ms (Thread/sleep idle-ms))\n    94\t        (doseq [[i line] (map-indexed vector in)]\n    95\t          (let [offset (count @stdout) sent (now)]\n    96\t            (send! line)\n    97\t            (await! #(str/includes? (subs @stdout offset) prompt)\n    98\t                    process (+ (now) timeout-ms) (str \"response \" i))\n    99\t            (swap! latencies conj (- (now) sent))\n   100\t            (let [actual (normalized (str/replace (subs @stdout offset) prompt \"\"))\n   101\t                  wanted (nth out i)]\n   102\t              (when-not (matches? host wanted actual)\n   103\t                (fail! \"transcript mismatch\" {:id id :line line :expected (expected host wanted)\n   104\t                                              :actual actual})))\n   105\t            (when (and idle-ms (zero? i))\n   106\t              (let [before @stdout]\n   107\t                (Thread/sleep idle-ms)\n   108\t                (when-not (= before @stdout)\n   109\t                  (fail! \"duplicate output while pending/idle\" {:id id :before before :after @stdout}))))))\n   110\t        (if (= quit :eof) (.close writer) (send! \"(quit)\")))\n   111\t      (when-not (.waitFor process timeout-ms java.util.concurrent.TimeUnit/MILLISECONDS)\n   112\t        (fail! \"deadline waiting for exit (stdin stays open for typed quit)\" {:id id}))\n   113\t      @out-reader @err-reader\n   114\t      (when-not (= exit (.exitValue process))\n   115\t        (fail! \"exit mismatch\" {:id id :expected exit :actual (.exitValue process)\n   116\t                                :stderr @stderr :stdout @stdout}))\n   117\t      (if startup-only\n   118\t        (when-not (matches? host out (normalized @stdout))\n   119\t          (fail! \"startup transcript mismatch\" {:id id :expected out :actual (normalized @stdout)}))\n   120\t        (when-not (str/ends-with? (str/trim @stdout) \"Bye\")\n   121\t          (fail! \"missing clean quit\" {:id id :stdout @stdout})))\n   122\t      {:host host :id id :status :pass :first-prompt-ms @first-prompt\n   123\t       :started-at (str (java.time.Instant/ofEpochMilli t0))\n   124\t       :elapsed-ms (- (now) t0) :submission-ms @latencies :exit (.exitValue process)\n   125\t       :jolt-divergence (:jolt-divergence case) :capability (:capability case)}\n   126\t      (finally\n   127\t        (when (.isAlive process) (.destroyForcibly process))\n   128\t        (spit (str path \".out\") @stdout)\n   129\t        (spit (str path \".err\") @stderr)))))\n   130\t\n   131\t\n   132\t(defn run-port-session!\n   133\t  \"J6e (C11): `--port 0` serves on jolt. The banner names the ephemeral\n   134\t   bind, the Serving line the bound port; a typed (quit) exits 0 once the\n   135\t   endpoint reports :stopped (Endpoint stopped: confirmed).\"\n   136\t  [host {:keys [id args]}]\n   137\t  (let [t0 (now)\n   138\t        process (.start (ProcessBuilder. ^java.util.List (command host args)))\n   139\t        stdout (atom \"\") stderr (atom \"\")\n   140\t        capture (fn [stream sink]\n   141\t                  (future\n   142\t                    (with-open [r (java.io.InputStreamReader. stream \"UTF-8\")]\n   143\t                      (loop []\n   144\t                        (let [c (.read r)]\n   145\t                          (when (not= -1 c)\n   146\t                            (swap! sink str (char c)) (recur)))))))\n   147\t        out-reader (capture (.getInputStream process) stdout)\n   148\t        err-reader (capture (.getErrorStream process) stderr)\n   149\t        writer (java.io.OutputStreamWriter. (.getOutputStream process) \"UTF-8\")\n   150\t        serving #\"Serving daostream:ws://127\\.0\\.0\\.1:(\\d+)/repl\"\n   151\t        path (str \"build/j3-logs/shell/\" (name host) \"-\" (name id))]\n   152\t    (try\n   153\t      (await! #(re-find serving @stdout) process (+ t0 timeout-ms) \"the Serving line\")\n   154\t      (let [port (parse-long (second (re-find serving @stdout)))]\n   155\t        (when-not (and (pos? port) (str/includes? @stdout \"serving on all interfaces on an ephemeral port\"))\n72:   (defn -main\n75:     (repl.main/main! args composition)))\n79:   (defn -main\n82:     (repl.main/main! args composition)))\n86:   (defn -main\n89:     (repl.main/main! args composition)))\n94:     (defn -main\n97:       (repl.main/main! args composition))\n    70\t\n    71\t(def gap-budget\n    72\t  \"Maximum `gap` answers one output drain accepts.  A gap is not an element,\n    73\t   so it is counted apart from `drain-budget`: a gap never costs the drain\n    74\t   an element, and the drain stays total against a transport that could\n    75\t   answer `gap` repeatedly.\"\n    76\t  4096)\n    77\t\n    78\t\n    79\t(def link-round-budget\n    80\t  \"How many serve-and-run rounds one evaluation drives while its VM waits\n    81\t   on a link (yin.vm.linker.md sections 6.3 and 7.2).  A round serves the\n    82\t   interpreter once and runs the VM once; a local content source answers\n    83\t   within a few, so the budget is reached only by a link that stays\n    84\t   `:pending`, which the shell then reports as its own non-blocking state\n    85\t   instead of wedging on.\"\n    86\t  40)\n    87\t\n    88\t\n    89\t(def query-row-limit\n    90\t  \"The most rows one `dao.space.query/q` answer may carry: members of a\n    91\t   relation or collection, one for a scalar or tuple.  An answer is a\n    92\t   value the REPL prints whole, so a result past a thousand rows is a\n    93\t   query to narrow rather than one to read; a `def` of ordinary size\n    94\t   projects to tens or hundreds of facts, so every fact of a few\n    95\t   definitions still fits.\"\n    96\t  1000)\n    97\t\n    98\t\n    99\t(def query-byte-limit\n   100\t  \"The most canonical CBOR bytes one `dao.space.query/q` answer may\n   101\t   encode to, 256 KiB.  Rows bound the count, not the size: one row can\n   102\t   hold a long string literal.  The byte bound keeps every answer on the\n   103\t   bounded call-out a fixed size, so the medium's retention is bounded by\n   104\t   `query-pair-capacity` times this, 16 MiB.\"\n   105\t  262144)\n   106\t\n   107\t\n   108\t(def query-pair-capacity\n   109\t  \"Declared capacity of each medium of the session's query call pair, in\n   110\t   elements.  A VM makes one call at a time and the shell answers it in\n   111\t   the same drive round, so a request and its response each occupy one\n   112\t   element, read before the next is made.  A rollback moves the base\n   113\t   VM's call-out cursor to the newest response\n   114\t   (`yin.repl.query/discard-answers`), so no reader ever falls behind by\n   115\t   more than one call.\"\n   116\t  64)\n   117\t\n   118\t\n   119\t(def query-serve-budget\n   120\t  \"Requests one query serve round answers.  A VM parks on one call at a\n   121\t   time, so a round that spends it is answering requests the shell's VM\n   122\t   did not make.\"\n   123\t  64)\n   124\t\n   125\t\n   126\t(def query-drive-budget\n   127\t  \"The most `dao.space.query/q` calls one drive answers: one evaluation,\n   128\t   or one re-check of a pending run.  A query is answered in the round\n   129\t   it is asked, so without a bound a program that calls `q` without end\n   130\t   would hold its input round in the drive forever.  Each call re-reads\n   131\t   the published index, so a thousand calls is already a long round; a\n   132\t   program past the bound is stopped with `query-call-limit-text` as its\n   133\t   error and its round rolls back like any failed round.\"\n   134\t  1024)\n   135\t\n   136\t\n   137\t(def query-call-limit-text\n   138\t  (str \"the evaluation called dao.space.query/q more than \"\n   139\t       query-drive-budget\n   140\t       \" times and was stopped (:yin.repl.query/call-limit)\"))\n   141\t\n   142\t\n   143\t(def vm-constructors\n   144\t  \"The evaluators on `yin.vm`: the ast-walker, the semantic register VM,\n   145\t   and the nameless de Bruijn stack and register kernels, each starting with an empty image.\"\n   146\t  {:ast-walker ast-walker/create-vm\n   147\t   :semantic semantic/create-vm\n   148\t   :stack #(stack/create-vm [] %)\n   149\t   :register #(register/create-vm nil %)})\n   150\t\n   935\t  (macro/make-expander\n   936\t    (macro/make-ctx {:token (str (random-uuid))\n   937\t                     :source-medium program-identity\n   938\t                     :store (standard-store)})\n   939\t    program-out))\n   940\t\n   941\t\n   942\t(defn- make-session\n   943\t  \"Build the evaluator, its media, their attachments and observers, the\n   944\t   expander, and the loader the evaluator observer feeds the VM, together.\n   945\t   Reset and VM selection call this, so the whole composition is rebuilt as\n   946\t   one and each attachment capability is bound exactly once per medium\n   947\t   lifetime.\n   948\t\n   949\t   Both evaluators sit behind the same two stages (yin.vm.macro.md §10.1):\n   950\t   the expander observes `program-in` — `:program-stream`, watched by\n   951\t   `:observer` — and appends each expanded tree packet to `program-out` —\n   952\t   `:row-stream`, watched independently by the evaluator's `:row-observer`,\n   953\t   which loads each packet and runs it.  The code indexer's observer\n   954\t   (`yin.repl.index`) is a peer attached to `program-out` beside it; the\n   955\t   round advances each, and neither calls the other.  It records\n   956\t   `shell-token` as provenance and publishes into `index-store`.  The AST\n   957\t   indexer (`yin.repl.ast-index`), holding the session's `$ast` and `$occ`\n   958\t   relations, is a third such peer.\n   959\t\n   960\t   The session owns one linker value. Its source configuration outlives\n   961\t   a session rebuild.\n   962\t\n   963\t   The query call pair is the session's too (`yin.repl.query/make-pair`):\n   964\t   the VM's half is its FFI pair, the interpreter's half with its request\n   965\t   cursor sits under `:query-pair`, and the interpreter answers from the\n   966\t   session's `:indexer`, and `:ast-indexer` for `$ast` and `$occ`, as they\n   967\t   stand when it serves.\n   968\t\n   969\t   A durable store's HEAD write is the composition's, reached over the\n   970\t   publication medium pair (`yin.repl.publication`): every session the\n   971\t   store outlives publishes through the same one.\n   972\t\n   973\t   `publication` carries that medium pair beside the composition's\n   974\t   immutable generic publication policy — `:publication-policy`,\n   975\t   `{:branching-factor n :max-payload-bytes b}`, a nil byte ceiling\n   976\t   declaring none (docs/design/yin.repl.dht-composition.md section 5).\n   977\t   The policy the composition injected wins over one the store handle\n   978\t   declares; the indexer threads whichever it is given through the bulk,\n   979\t   incremental and restore publication paths alike, and no transport's\n   980\t   page size is hardcoded here.\n   981\t\n   982\t   `host-modules` is the composition's module registrations, installed\n   983\t   into every session's registry so a rebuild never drops them\n   984\t   (`make-vm`).\"\n   985\t  [vm-type output-stream extra-primitives shell-token index-store source\n   986\t   publication host-modules]\n   987\t  (let [linker (link/make source)\n   988\t        pair (:pair linker)\n   989\t        query-pair (query/make-pair query-pair-capacity)\n   990\t        vm (make-vm vm-type output-stream extra-primitives pair query-pair\n   991\t                    host-modules)\n   992\t        program-in (make-attachment ingress-capacity)\n   993\t        program-out (make-attachment ingress-capacity)]\n   994\t    {:vm vm\n   995\t     :load-program (get program-loaders vm-type)\n   996\t     :program-stream (:stream program-in)\n   997\t     :program-identity (:identity program-in)\n   998\t     :observer (:observer program-in)\n   999\t     :expander (make-expander (:identity program-in) (:stream program-out))\n  1000\t     :call-site-admissions {}\n  1001\t     :row-stream (:stream program-out)\n  1002\t     :row-observer (:observer program-out)\n  1003\t     :indexer (index/make-indexer {:observer ((:attach program-out))\n  1004\t                                   :session-token shell-token\n  1005\t                                   :content-store index-store\n  1006\t                                   :publication-policy\n  1007\t                                   (or (:publication-policy publication)\n  1340\t;; Reading and classifying input\n  1341\t;; =============================================================================\n  1342\t\n  1343\t(defn read-forms\n  1344\t  \"The forms of one input line, as a vector, read by the host reader.\n  1345\t   Public so the cross-host reader tests can compare the forms, metadata\n  1346\t   included, that each host reads.\"\n  1347\t  [input]\n  1348\t  #?(:cljd (edn/read-string (str \"[\" input \"]\"))\n  1349\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n  1350\t     :clj (clojure.core/read-string (str \"[\" input \"]\"))))\n  1351\t\n  2340\t\n  2341\t\n  2342\t(defn- installed-text\n  2343\t  \"The languages and ids `catalog` holds, for a refused selection to name:\n  2344\t   a name that is neither is a typo, not a missing frontend.\"\n  2345\t  [catalog]\n  2346\t  (let [entries (:yang.frontend/entries catalog)\n  2347\t        listed (fn [xs] (str/join \" \" (map pr-str (sort (distinct xs)))))]\n  2348\t    (str \"installed: \"\n  2349\t         (listed (map (comp :yang.frontend/language :manifest) (vals entries)))\n  2350\t         \" (ids \" (listed (map first (keys entries))) \")\")))\n  2351\t\n  2352\t\n  2353\t(defn- select-frontend\n  2354\t  \"Select the frontend `lang` names in `catalog`: a qualified id selects\n  2355\t   by id (ambiguous when several revisions are installed), `[id revision]`\n  2356\t   pins one revision; anything else is refused — the selector is the\n  2357\t   frontend id, never a language keyword.\"\n  2358\t  [catalog lang]\n  2359\t  (cond\n  2360\t    (vector? lang) (frontend/select catalog\n  2361\t                                    {:yang.frontend/id (first lang),\n  2362\t                                     :yang.frontend/revision (second lang)})\n  2363\t    (qualified-keyword? lang) (frontend/select catalog\n  2364\t                                               {:yang.frontend/id lang})\n  2365\t    :else (frontend/refused :yang.frontend/unknown {:id lang})))\n  2366\t\n  2367\t\n  2368\t(defn- selected-primitives\n  2369\t  \"The `:primitives` the binding selected by `lang` registers, else {}.\n  2370\t   A language's primitives belong to its binding; the primitives of\n  2371\t   unselected languages are never merged into the session.\"\n  2372\t  [catalog lang]\n  2373\t  (or (:primitives (:binding (select-frontend catalog lang))) {}))\n  2374\t\n  2375\t\n  2376\t(defn- switch-lang\n  2377\t  \"Select `lang`: its binding's primitives replace the previous binding's\n  2378\t   in the live VM (host `:extra-primitives` stay over them), and the\n  2379\t   frontend session is dropped.\"\n  2380\t  [state lang]\n  2381\t  (let [new (selected-primitives (:frontends state) lang)]\n  2382\t    (-> state\n  2383\t        (assoc :lang lang :frontend-session nil)\n  2384\t        (assoc-in [:vm :primitives]\n  2385\t                  (merge (make-repl-primitives (:output-stream state))\n  2386\t                         new\n  2387\t                         (:extra-primitives state))))))\n  2388\t\n  2389\t\n     1\t(ns yin.repl.host\n     2\t  \"The jolt composition of the Yin REPL host WebSocket seam (J6e).\n     3\t\n     4\t   This jolt namespace shadows the `.cljc` one, so it carries only\n     5\t   `websocket`; the portable contract is `yin.repl.host.common`. It\n     6\t   composes the native RFC 6455 edge (`dao.stream.ws.jolt`) for the REPL:\n     7\t   upgrades reach `dao.stream.ws/accept-connection!` through the endpoint's\n     8\t   `accept!`, and each accepted connection reports through the\n     9\t   `dao.stream.ws/adapter` of its handle.\n    10\t\n    11\t   Unlike the JVM, Node and Dart packages, jolt's sockets move only when\n    12\t   their owner pumps them, so the adapter also carries `:pump` (the\n    13\t   driver's `{:interest :deadline :pump!}`, A2) and `:close-host!` (forced\n    14\t   cleanup once the owner loop has ended, A6). One instance per call: two\n    15\t   adapters never share a descriptor.\"\n    16\t  (:require [dao.stream.ws :as ws]\n    17\t            [dao.stream.ws.jolt :as wsj]))\n    18\t\n    19\t\n    20\t(defn websocket\n    21\t  \"Return a fresh jolt host adapter: `{:connect! :bind! :unbind! :pump\n    22\t   :close-host! :debug-state}` over one new instance. `opts` (tests only):\n    23\t   `:upgrade-timeout-ms`, `:close-deadline-ms`.\"\n    24\t  ([] (websocket nil))\n    25\t  ([opts]\n    26\t   (let [inst (wsj/create opts)]\n    27\t     {:connect! (fn [descriptor adapter] (wsj/connect! inst descriptor adapter))\n    28\t      :bind! (fn [options]\n    29\t               (wsj/bind! inst (assoc options :ws.jolt/adapter-of\n    30\t                                      #(some-> (:ws/handle %) ws/adapter))))\n    31\t      :unbind! (fn [listener deposit!] (wsj/unbind! inst listener deposit!))\n    32\t      :pump (wsj/host-pump inst)\n    33\t      :close-host! #(wsj/close-host! inst)\n    34\t      :debug-state #(wsj/debug-state inst)})))\nsrc/clj/dao/stream/waitset/driver.clj\nsrc/jolt/dao/stream/waitset/driver.jolt\nsrc/cljs/dao/stream/waitset/driver.cljs\nsrc/cljd/dao/stream/waitset/driver.cljd\nsrc/cljc/yang/python/antlr/parser.cljc\n","exit_code":0,"status":"completed"}}
