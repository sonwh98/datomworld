est roots))\n    27\t        (and (pair? rest)\n    28\t             (let find-suffix ((suffixes (cdar rest)))\n    29\t               (if (null? suffixes)\n    30\t                   (find-root (cdr rest))\n    31\t                   (let ((file (string-append (caar rest) \"/\" base (car suffixes))))\n    32\t                     (if (and (file-exists? file) (eq? 'regular (file-type file)))\n    33\t                         file\n    34\t                         (find-suffix (cdr suffixes))))))))))\n    35\t  (define (load-namespace name force?)\n    36\t    (when force?\n    37\t      (throw-jvm 'UnsupportedOperationException\n    38\t                 \"namespace reload is unsupported on the gambit source loader\"))\n    39\t    (unless (member name booted)\n    40\t      (case (table-ref loaded name #f)\n    41\t        ((ready) #f)\n    42\t        ((loading)\n    43\t         (throw-jvm 'IllegalStateException (string-append \"Cyclic namespace load: \" name)))\n    44\t        ((failed)\n    45\t         (throw-jvm 'IllegalStateException (string-append \"Earlier namespace load failed: \" name)))\n    46\t        (else\n    47\t         (let ((file (find-file name)))\n    48\t           (unless file\n    49\t             (throw-jvm 'FileNotFoundException (string-append \"No source for namespace: \" name)))\n    50\t           (table-set! loaded name 'loading)\n    51\t           (guard (e (#t (table-set! loaded name 'failed) (raise e)))\n    52\t             (jolt-with-ns-bound\n    53\t               (lambda ()\n    54\t                 (jolt-eval-string (call-with-input-file file gambit-read-all) file)\n    55\t                 (unless (string=? name (chez-current-ns))\n    56\t                   (throw-jvm 'IllegalStateException\n    57\t                              (string-append file \": expected namespace \" name)))))\n    58\t             (table-set! loaded name 'ready)))))))\n    59\t  (set-ns-load-target! load-namespace)\n    60\t  (set-ns-with-load-opts!\n    61\t    (lambda (flags proceed)\n    62\t      (unless (null? flags)\n    63\t        (throw-jvm 'UnsupportedOperationException\n    64\t                   (string-append \"require option is unsupported on the gambit source loader: :\"\n    65\t                                  (car flags))))\n    66\t      (proceed #f)))\n    67\t  (def-var! \"clojure.core\" \"require\" jolt-require)\n    68\t  (def-var! \"clojure.core\" \"use\" jolt-use)\n    69\t  load-namespace)\n     1\t#!/bin/sh\n     2\t# Drive the upstream Yin entry point. A shell exit status alone never passes.\n     3\tset -eu\n     4\t\n     5\tgsi=$1\n     6\tyin_root=$2\n     7\ttranscript=$(mktemp)\n     8\ttrap 'rm -f \"$transcript\"' EXIT\n     9\t\n    10\tstatus=0\n    11\tsh host/gambit/ffi/watchdog.sh 240 \"$gsi\" host/gambit/yin-repl-main.ss \\\n    12\t  \"$yin_root\" --no-state --index-store mem >\"$transcript\" <<'FORMS' || status=$?\n    13\t(+ 1 2)\n    14\t((fn [x] (* x x)) 7)\n    15\t(def p1c-score 100)\n    16\t(+ p1c-score 1)\n    17\t(lang :yang/python)\n    18\t(require 'jolt.ffi)\n    19\t(jolt.ffi/sizeof :int32)\n    20\t(+ 21 22)\n    21\t(quit)\n    22\tFORMS\n    23\tcat \"$transcript\"\n    24\tif [ \"$status\" -ne 0 ]; then\n    25\t  echo \"gambityinrepl: a complete Yin session was not observed (status $status)\" >&2\n    26\t  exit 1\n    27\tfi\n    28\t\n    29\t# Each line must follow the previous one, with prompts on the actual replies.\n    30\tawk '\n    31\t  /^yin> 3$/ && step == 0 { step++; next }\n    32\t  /^yin> 49$/ && step == 1 { step++; next }\n    33\t  /^yin> 100$/ && step == 2 { step++; next }\n    34\t  /^yin> 101$/ && step == 3 { step++; next }\n    35\t  /^yin> Error: unavailable-parser: Yin REPL language :yang\\/python/ && step == 4 { step++; next }\n    36\t  /^yin> \\047jolt[.]ffi$/ && step == 5 { step++; next }\n    37\t  /^yin> 4$/ && step == 6 { step++; next }\n    38\t  /^yin> 43$/ && step == 7 { step++; next }\n    39\t  /^yin> Bye$/ && step == 8 { step++; next }\n    40\t  /^yin> / { unexpected = 1 }\n    41\t  END { exit !(step == 9 && !unexpected) }\n    42\t' \"$transcript\" || {\n    43\t  echo \"gambityinrepl: the Yin session did not produce the expected replies\" >&2\n    44\t  exit 1\n    45\t}\n    46\techo \"gambityinrepl: PASS — Yin state, frontend refusal, FFI, and clean quit\"\n","exit_code":0,"status":"completed"}}
