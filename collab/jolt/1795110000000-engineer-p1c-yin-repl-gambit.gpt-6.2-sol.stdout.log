ntends admission publication-policy publication-media\n  1149\t            host-modules publisher-key]\n  1150\t     :or {lang :yang/clojure vm-type :semantic admission {}}}]\n  1151\t   (let [output-stream (or output-stream (make-output-medium!))\n  1152\t         output-cursor (or output-cursor (mint-cursor output-stream))\n  1153\t         shell-token (str (random-uuid))\n  1154\t         index-store-spec (cond\n  1155\t                            (and index-store index-store-spec)\n  1156\t                            (throw (ex-info\n  1157\t                                     (str \"yin.repl/create-state takes one \"\n  1158\t                                          \"index store: :index-store-spec \"\n  1159\t                                          \"(mem or a file directory) or \"\n  1160\t                                          \":index-store (a dao.jing handle), \"\n  1161\t                                          \"not both\")\n  1162\t                                     {:index-store-spec index-store-spec}))\n  1163\t\n  1164\t                            index-store nil\n  1165\t\n  1166\t                            :else (store/checked-spec index-store-spec))\n  1167\t         ;; A composition that owns a storage implementation prepares the\n  1168\t         ;; link source beside the handle and injects both; the engine\n  1169\t         ;; composes one only from the generic content inputs it was given\n  1170\t         ;; (docs/design/yin.repl.dht-composition.md section 3).  Composed\n  1171\t         ;; before the store opens: a refused composition never holds a\n  1172\t         ;; directory lock.\n  1173\t         link-source (or link-source\n  1174\t                         (link/composition\n  1175\t                           {:name-env name-env\n  1176\t                            :content-store content-store\n  1177\t                            :content-client content-client\n  1178\t                            :principals principals\n  1179\t                            :key publisher-key\n  1180\t                            :follow follow\n  1181\t                            :admission (when-not (= :external admission)\n  1182\t                                         admission)}))\n  1183\t         index-store (or index-store (store/open index-store-spec))\n  1184\t         recovery (or recovery (:recovery index-store))\n  1185\t         ;; the composition's durable-publication medium: the engine\n  1186\t         ;; emits a correlated request and promotes only the matching\n  1187\t         ;; result, and its indexer holds no writer to call\n  1188\t         ;; (yin.repl.publication).  A store that declares no durable HEAD\n  1189\t         ;; has no medium, and its round settles locally exactly as an\n  1190\t         ;; ephemeral composition always has; a composition that wants to\n  1191\t         ;; observe an ephemeral round injects the media itself.\n  1192\t         media (or publication-media\n  1193\t                   (when-let [head-fn (:head-fn index-store)]\n  1194\t                     (publication/local-media\n  1195\t                       {:head-fn head-fn\n  1196\t                        :durability :persistent})))\n  1197\t         ;; `:media` is the engine's view of the pair -- the request side\n  1198\t         ;; it appends to, the result side it reads and its cursor -- with\n  1199\t         ;; the composition's durable HEAD writer stripped off it, so no\n  1200\t         ;; callback hook sits inside the indexer.  `:local-service` is\n  1201\t         ;; that stripped half, the medium with its writer, which the\n  1202\t         ;; round boundary services (`serve-publication`); a composition\n  1203\t         ;; with transport of its own injects a medium with no `:local`,\n  1204\t         ;; has no service here, and services the request side itself.\n  1205\t         publication {:publication-policy publication-policy\n  1206\t                      :media (some-> media publication/engine-media)\n  1207\t                      :local-service (when (:local media) media)}]\n  1208\t     (merge\n  1209\t       (update (make-session vm-type output-stream\nsrc/cljc/dao/host/number.cljc:37:  (:require\nsrc/cljc/dao/host/number.cljc:57:(def ^:private zero (integer/from-native 0))\nsrc/cljc/dao/host/number.cljc:229:(def decimal-exponent-min\nsrc/cljc/dao/host/number.cljc:235:(def decimal-exponent-max\nsrc/cljc/dao/host/float.cljc:24:  (:require\nsrc/cljc/dao/host/float.cljc:61:(def ^:private hex-digits \"0123456789abcdef\")\nsrc/cljc/dao/host/float.cljc:84:(def ^:private hex-values\nsrc/cljc/dao/host/float.cljc:152:(def ^:private zero (integer/from-native 0))\nsrc/cljc/dao/host/float.cljc:153:(def ^:private one (integer/from-native 1))\nsrc/cljc/dao/host/float.cljc:183:(def ^:private two-53-float (pow2 53))\nsrc/cljc/dao/host/float.cljc:184:(def ^:private two-117-float (pow2 117))\nsrc/cljc/dao/host/float.cljc:185:(def ^:private two-minus-64-float (pow2 -64))\nsrc/cljc/dao/host/float.cljc:255:(def ^:private chunk-digits\nsrc/cljc/dao/host/float.cljc:280:(def ^:private ten (integer/from-native 10))\nsrc/cljc/dao/host/float.cljc:283:(def small-powers-of-ten\nsrc/cljc/dao/host/float.cljc:311:(def ^:private two-64-float (pow2 64))\nsrc/cljc/dao/host/float.cljc:312:(def ^:private two-minus-11-float (pow2 -11))\nsrc/cljc/dao/host/float.cljc:398:(def ^:private max-significant-digits\nsrc/cljc/dao/host/float.cljc:441:(def ^:private decimal-digit-values\nsrc/cljc/dao/host/integer.cljc:32:   namespace requires nothing in the repository. Every reader\nsrc/cljc/dao/host/integer.cljc:152:   (def ^:private js-zero (js/BigInt 0)))\nsrc/cljc/dao/host/integer.cljc:156:   (def ^:private js-max-safe (js/BigInt 9007199254740991)))\nsrc/cljc/dao/host/integer.cljc:160:   (def ^:private js-min-safe (js/BigInt -9007199254740991)))\nsrc/cljc/dao/host/integer.cljc:321:(def ^:private ascii-digits\nsrc/cljc/dao/host/sign.cljc:17:  (:require\nsrc/cljc/dao/host/sign.cljc:26