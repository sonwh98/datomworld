{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,210p' host/gambit/yin-repl-boot.ss\nsed -n '1,150p' host/gambit/yin-capture.ss\nsed -n '1,120p' test/gambit/yin-prompt-time.py\nrg '\"'^Yin first prompt|''^'\"\\\\[.*\\\\] ready (jolt.gambit.yin|dao.space.dht)' build/gambit-yin/equivalence-kq1_skyr/source/{repl/gate,stock/stock,diagnostics/diagnostics}.stderr\"","aggregated_output":";; The public launcher and the DHT diagnostic harness share boot selection.\n(define gambit-yin-host (path-directory (this-source-file)))\n(define gambit-yin-gsi (path-expand \"~~bin/gsi\"))\n(define gambit-yin-mode (getenv \"JOLT_GAMBIT_YIN_MODE\" \"auto\"))\n(define gambit-yin-strict? (string=? gambit-yin-mode \"compiled\"))\n(define gambit-yin-source-kernel? (getenv \"JOLT_GAMBIT_YIN_SOURCE_KERNEL\" #f))\n\n(define (gambit-yin-stderr . items)\n  (for-each (lambda (item) (display item (current-error-port))) items)\n  (newline (current-error-port))\n  (force-output (current-error-port)))\n\n(define (gambit-yin-resolve-boot)\n  (if (or gambit-yin-source-kernel? (null? (cdr (command-line))))\n      '(#f #f #f)\n      (let ((helper\n              (with-exception-catcher\n                (lambda (e)\n                  (gambit-yin-stderr \"jolt-gambit: Cannot start the boot builder\")\n                  (display-exception e (current-error-port))\n                  (if gambit-yin-strict? (exit 1) #f))\n                (lambda ()\n                  (open-process\n                    (list path: \"python3\"\n                          arguments: (list (path-expand \"build-yin-session.py\" gambit-yin-host)\n                                           gambit-yin-gsi (cadr (command-line)))\n                          direction: 'input stdin-redirection: #f stderr-redirection: #f))))))\n        (if helper\n            (let* ((selection (read helper))\n                   (status (process-status helper)))\n              (close-port helper)\n              (if (and (= status 0) (list? selection) (= (length selection) 3))\n                  selection\n                  (exit 1)))\n            '(#f #f #f)))))\n\n(define gambit-yin-selection (gambit-yin-resolve-boot))\n(define gambit-yin-kernel (car gambit-yin-selection))\n(define gambit-yin-code (cadr gambit-yin-selection))\n(define gambit-yin-key (caddr gambit-yin-selection))\n\n;; A compiled initializer may already have changed vars or registered FFI\n;; wrappers when it throws. Retry in a fresh process before any input was read.\n(define (gambit-yin-restart-source error source-kernel?)\n  (gambit-yin-stderr \"jolt-gambit: Compiled Yin startup failed\")\n  (display-exception error (current-error-port))\n  (force-output (current-error-port))\n  (if gambit-yin-strict?\n      (exit 1)\n      (begin\n        (gambit-yin-stderr \"jolt-gambit: Retrying from source\")\n        (setenv \"JOLT_GAMBIT_YIN_MODE\" \"source\")\n        (when source-kernel? (setenv \"JOLT_GAMBIT_YIN_SOURCE_KERNEL\" \"1\"))\n        ;; Namespace loads run under the Datomworld cwd. Restart at the\n        ;; original launcher cwd, with the script and source root absolutized.\n        (let* ((args (command-line))\n               (child (open-process\n                        (list path: gambit-yin-gsi\n                              arguments: (cons gambit-yin-launcher\n                                             (cons gambit-yin-datomworld (cddr args)))\n                              directory: gambit-yin-runtime\n                              stdin-redirection: #f stdout-redirection: #f\n                              stderr-redirection: #f)))\n               (status (process-status child)))\n          (close-port child)\n          (exit (if (= (bitwise-and status 127) 0)\n                    (arithmetic-shift status -8)\n                    (+ 128 (bitwise-and status 127))))))))\n\n(define gambit-yin-runtime (current-directory))\n(define gambit-yin-launcher (path-expand (car (command-line))))\n(define gambit-yin-datomworld\n  (and (pair? (cdr (command-line))) (path-expand (cadr (command-line)))))\n\n(define data-readers-active #f)\n(if gambit-yin-kernel\n    (with-exception-catcher\n      (lambda (e) (gambit-yin-restart-source e #t))\n      (lambda () (load gambit-yin-kernel)))\n    (load (path-expand \"boot.ss\" gambit-yin-host)))\n(##include \"yin-repl-driver.ss\")\n\n(define (gambit-yin-initializer name file)\n  (let ((entry (and gambit-yin-compiled\n                    (table-ref gambit-yin-compiled name #f))))\n    (and entry (string=? file (car entry))\n         (lambda ()\n           (with-exception-catcher\n             (lambda (e) (gambit-yin-restart-source e #f))\n             (lambda ()\n               (jolt-with-eval-source (call-with-input-file file gambit-read-all)\n                 file (ls-file-name file) (cdr entry))))))))\n\n(define (gambit-yin-launch after-load)\n  (when (and gambit-yin-strict? (not gambit-yin-code))\n    (gambit-yin-stderr \"jolt-gambit: Compiled Yin boot required\")\n    (exit 1))\n  (when gambit-yin-code\n    (with-exception-catcher\n      (lambda (e) (gambit-yin-restart-source e #f))\n      (lambda () (load gambit-yin-code))))\n  (if gambit-yin-code\n      (gambit-yin-stderr \"jolt-gambit: compiled Yin boot \" gambit-yin-key)\n      (gambit-yin-stderr \"jolt-gambit: source Yin namespaces\"))\n  (gambit-yin-run gambit-load-source-file after-load gambit-yin-initializer))\n#!/usr/bin/env gsi-script\n;; Capture only emitted Scheme for the ordinary static startup namespace loads.\n;; The capture process evaluates dependencies for macro expansion and exits\n;; before Yin initializes a session. Every initializer runs again at launch.\n(define data-readers-active #f)\n(load (getenv \"JOLT_GAMBIT_YIN_BOOT\"))\n(##include \"yin-repl-driver.ss\")\n\n(define capture-directory (getenv \"JOLT_GAMBIT_YIN_CAPTURE\"))\n\n(define (gambit-yin-capture-file name file)\n  (let ((code (open-output-string))\n        (previous (gambit-yin-gensym-counters))\n        (parent (jolt-aot-capture))\n        (parent-checkpoint (jolt-aot-form-checkpoint)))\n    (define (checkpoint port position)\n      (let ((now (gambit-yin-gensym-counters)))\n        (when port\n          ;; The reader/expander consumed these fresh names. Advance by the\n          ;; same amount before replaying this form; its runtime work still\n          ;; runs normally and accounts for its own allocations.\n          (let ((delta (map - now previous)))\n            (unless (equal? delta '(0 0 0))\n              (write (cons 'gambit-yin-advance-gensyms! delta) port)\n              (newline port)))\n          (display \"(jolt-site-reset!)\\n\" port)\n          (when (pmap? position)\n            (write `(jolt-set-form-position!\n                      (jolt-hash-map hc-kw-file ,file\n                                     hc-kw-line ,(jolt-get position hc-kw-line 0)\n                                     hc-kw-column ,(jolt-get position hc-kw-column 0)))\n                   port)\n            (newline port)))\n        (set! previous now)))\n    ;; A namespace reached while reading/expanding a form also needs to be\n    ;; initialized during replay. Runtime require runs with the tee off.\n    (when parent\n      (parent-checkpoint parent #f)\n      (write `(ns-load-target! ,name #f) parent)\n      (newline parent))\n    (parameterize ((jolt-aot-capture code) (jolt-aot-form-checkpoint checkpoint))\n      (gambit-load-source-file name file))\n    (when parent (parent-checkpoint #f #f))\n    (call-with-output-file (path-expand (string-append name \".ss\") capture-directory)\n      (lambda (out)\n        (display \"(gambit-yin-register! \" out)\n        (write name out)\n        (display \" \" out)\n        (write file out)\n        (display \"\\n  (lambda ()\\n\" out)\n        (display (get-output-string code) out)\n        (display \"\\n    jolt-nil))\\n\" out)))))\n\n(gambit-yin-run gambit-yin-capture-file\n  (lambda (load-ns args)\n    ;; open-dht requires this namespace before the first prompt. Follow the\n    ;; dependency now without opening a store or taking session input.\n    (load-ns \"dao.space.dht\" #f)))\n\"\"\"Record wall time to the first visible Yin prompt and preserve output bytes.\"\"\"\nimport os\nimport subprocess\nimport sys\nimport time\n\nprompt = b\"yin> \"\ntail = b\"\"\nseen = False\nstarted = time.monotonic()\nwith subprocess.Popen(sys.argv[1:], stdout=subprocess.PIPE) as child:\n    while chunk := os.read(child.stdout.fileno(), 65536):\n        if not seen:\n            window = tail + chunk\n            if prompt in window:\n                seen = True\n                print(f\"Yin first prompt: {time.monotonic() - started:.3f}s\",\n                      file=sys.stderr, flush=True)\n            else:\n                tail = window[-(len(prompt) - 1):]\n        sys.stdout.buffer.write(chunk)\n        sys.stdout.buffer.flush()\n    sys.exit(child.wait())\nbuild/gambit-yin/equivalence-kq1_skyr/source/stock/stock.stderr:[1795697494s] ready jolt.gambit.yin\nbuild/gambit-yin/equivalence-kq1_skyr/source/repl/gate.stderr:[1795697473s] ready jolt.gambit.yin\nbuild/gambit-yin/equivalence-kq1_skyr/source/repl/gate.stderr:Yin first prompt: 966.598s\nbuild/gambit-yin/equivalence-kq1_skyr/source/diagnostics/diagnostics.stderr:[1795697476s] ready jolt.gambit.yin\nbuild/gambit-yin/equivalence-kq1_skyr/source/diagnostics/diagnostics.stderr:[1795697529s] ready dao.space.dht\n","exit_code":0,"status":"completed"}}
