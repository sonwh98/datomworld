{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,115p' test/gambit/yin-equivalence.py && sed -n '1,65p' test/gambit/yin-dht-probe.sh && git -c core.fsmonitor=false diff --check --ignore-submodules=all\"","aggregated_output":"\"\"\"Run both native Yin startup paths and compare the actual reply bytes.\"\"\"\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport os\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\nGSI, DATOMWORLD = sys.argv[1:]\nCACHE = Path(os.environ[\"JOLT_GAMBIT_YIN_CACHE\"]).resolve()\nCACHE.mkdir(parents=True, exist_ok=True)\nRUN = Path(tempfile.mkdtemp(prefix=\"equivalence-\", dir=CACHE))\nKEY = re.compile(rb\"^jolt-gambit: compiled Yin boot ([0-9a-f]{64})$\", re.M)\n\n\ndef exercise(mode, corpus):\n    directory = RUN / mode / corpus\n    directory.mkdir(parents=True)\n    env = dict(os.environ, JOLT_GAMBIT_YIN_MODE=mode, JOLT_TRACE_SOURCE=\"1\")\n    if corpus == \"repl\":\n        script = \"test/gambit/yin-repl-session.sh\"\n        args = []\n        reply_path = directory / \"repl.stdout\"\n        env[\"JOLT_YIN_REPL_TRANSCRIPT\"] = str(reply_path)\n        launcher_log = directory / \"gate.stderr\"\n    else:\n        script = \"test/gambit/yin-dht-probe.sh\"\n        args = [corpus]\n        reply_path = directory / f\"{corpus}.stdout\"\n        env[\"JOLT_YIN_DHT_RECEIPTS\"] = str(directory)\n        launcher_log = directory / f\"{corpus}.stderr\"\n    with (directory / \"gate.stdout\").open(\"wb\") as out, (directory / \"gate.stderr\").open(\"wb\") as err:\n        status = subprocess.run([\"sh\", script, GSI, DATOMWORLD, *args],\n                                env=env, stdout=out, stderr=err).returncode\n    print(f\"gambityinequivalence: {mode} {corpus} exited {status}\", flush=True)\n    log = launcher_log.read_bytes() if launcher_log.exists() else b\"\"\n    match = KEY.search(log)\n    if mode == \"compiled\" and match is None:\n        status = status or 1\n    if mode == \"source\" and (match or b\"ready jolt.gambit.yin\\n\" not in log):\n        status = status or 1\n\n    if reply_path.exists():\n        output = reply_path.read_bytes()\n        prompt = re.search(rb\"^yin> \", output, re.M)\n        if prompt:\n            (directory / \"replies\").write_bytes(output[prompt.start():])\n    return status, match[1].decode() if match else None, directory / \"replies\"\n\n\ndef main():\n    print(f\"gambityinequivalence receipts: {RUN}\", flush=True)\n    corpora = (\"repl\", \"stock\", \"diagnostics\")\n    with ThreadPoolExecutor(max_workers=6) as pool:\n        results = {(mode, corpus): pool.submit(exercise, mode, corpus)\n                   for mode in (\"source\", \"compiled\") for corpus in corpora}\n    failed = False\n    for corpus in corpora:\n        source, _, expected = results[\"source\", corpus].result()\n        compiled, key, actual = results[\"compiled\", corpus].result()\n        different = (expected.is_file() and actual.is_file()\n                     and subprocess.run([\"diff\", \"-u\", expected, actual]).returncode != 0)\n        if source or compiled or different or not actual.is_file() or not expected.is_file():\n            failed = True\n            if not source and key:\n                # Only reject the exact key used by this process. A later\n                # launch sees the mismatch and selects source automatically.\n                (CACHE / f\"session-{key}.rejected\").touch()\n        else:\n            print(f\"gambityinequivalence: {corpus} replies match byte-for-byte\", flush=True)\n    return 1 if failed else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n#!/bin/sh\n# Run the stock launcher and the same composition with a diagnostic host module.\n# Arguments are absolute paths. Build the qualified bridge first.\nset -eu\n\ngsi=$1\ndatomworld=$2\nmode=${3:-both}\nexport JOLT_TRACE_SOURCE=1\nrepo=$(CDPATH='' cd -- \"$(dirname -- \"$0\")/../..\" && pwd)\ncd \"$repo\"\nmkdir -p build/gambit-dht\nrun=${JOLT_YIN_DHT_RECEIPTS:-}\nif [ -z \"$run\" ]; then\n  run=$(mktemp -d \"$repo/build/gambit-dht/run.XXXXXX\")\nfi\necho \"gambitdht receipts: $run\"\nmkdir -p \"$run/store\"\nexport JOLT_P1E_STORE=\"$run/store\"\n\nsession() {\n  name=$1\n  launcher=$2\n  status=0\n  started=$(date +%s)\n  python3 test/gambit/yin-prompt-time.py \\\n    sh \"$repo/host/gambit/ffi/watchdog.sh\" \"${GAMBIT_DHT_TIMEOUT_SECONDS:-5400}\" \\\n    \"$gsi\" \"$launcher\" \"$datomworld\" \\\n    --no-state --index-store dht: >\"$run/$name.stdout\" 2>\"$run/$name.stderr\" || status=$?\n  echo \"$status\" >\"$run/$name.status\"\n  cat \"$run/$name.stdout\"\n  echo \"$name launcher exit $status ($(($(date +%s) - started))s)\"\n  if [ \"$status\" -ne 0 ]; then\n    tail -30 \"$run/$name.stderr\" >&2\n    return \"$status\"\n  fi\n}\n\nstock() {\n  session stock \"$repo/host/gambit/yin-repl-native.ss\" <<'FORMS'\n(+ 20 22)\n(quit)\nFORMS\n  grep -Fx 'yin> 42' \"$run/stock.stdout\" >/dev/null\n  grep -Fx 'yin> Bye' \"$run/stock.stdout\" >/dev/null\n  test \"$(grep -c '^yin> ' \"$run/stock.stdout\")\" -eq 2\n  if [ \"${JOLT_GAMBIT_YIN_MODE:-auto}\" = source ]; then\n    grep -E 'ready dao[.]space[.]dht$' \"$run/stock.stderr\" >/dev/null\n  fi\n  echo \"gambitdht: PASS — stock launcher opened dht: and quit\"\n}\n\ndiagnostics() {\n  session diagnostics \"$repo/test/gambit/yin-dht-probe-main.ss\" <<'FORMS'\n(+ 20 22)\n(require 'p1e.probe)\n(p1e.probe/run :session-round-trip)\n(p1e.probe/run :shell-open)\n(p1e.probe/run :durable-put)\n(p1e.probe/run :durable-get)\n(p1e.probe/run :directory-open)\n(p1e.probe/run :memory-open)\n(p1e.probe/run :memory-put)\n(p1e.probe/run :memory-get)\n(p1e.probe/run :replicate-request)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-oN2f7tnv' (errno=Operation not permitted)\n2026-11-26 19:13:16.581 xcodebuild[1710:2440977]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-26 19:13:17.182 xcodebuild[1710:2440974] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-uqFhES66' (errno=Operation not permitted)\n2026-11-26 19:13:18.427 xcodebuild[1713:2441034]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-26 19:13:18.930 xcodebuild[1713:2441033] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\n","exit_code":0,"status":"completed"}}
