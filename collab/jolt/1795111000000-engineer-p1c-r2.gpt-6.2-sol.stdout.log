me path)))))\n                              (else ls-file-cells))\n          (lambda ()\n            (parameterize ((rdr-source-file path) (jolt-load-wrap #f))\n              ;; rdr-read-top, not rdr-read-form: a stray close delimiter is\n              ;; \"Unmatched delimiter\", raised when the read reaches it, after the\n              ;; forms before it have run (Compiler.load). rdr-read-form hands it\n              ;; back unconsumed, and the loop took that for the end of input.\n              ;; pos is the reader's (line . col) at i, kept only for a wrap.\n              (let loop ((i 0) (result jolt-nil) (pos '(1 . 1)))\n                (if (>= i end)\n                    result\n                    (let* ((k (if w (ce-skip-ws s i end) i))\n                           (pos (if w (ce-advance s i k (car pos) (cdr pos)) pos)))\n                      (let-values (((form j) (rdr-read-top s k end)))\n                        (if (> j k)\n                            (loop j\n                                  (if (rdr-eof? form)\nhost/chez/scheme-adapter-runtime.ss:1162:;; (sa-baked-global sym) -> value | #f\nhost/chez/scheme-adapter-runtime.ss:1169:(define (sa-baked-global sym)\nhost/chez/state-image.ss:993:  (let ((ce (sa-baked-global 'jolt-compile-eval-form)))\nhost/chez/compile-eval.ss:1012:;; scheme-proc, the other half of jolt.scheme, is a top-level lookup that needs\nhost/chez/compile-eval.ss:1015:;; bld-emit-runtime), and scheme-eval-string is a dce-compile-ref for it.\nhost/chez/compile-eval.ss:1016:;; scheme-eval-string reads SCHEME text with the Scheme reader (not jolt's) and\nhost/chez/compile-eval.ss:1019:(def-var! \"jolt.host\" \"scheme-eval-string\"\nhost/chez/run-directcall.ss:209:;; var of a file the binary left out (jolt.host/scheme-eval-string in a build\nhost/chez/rt.ss:1384:  (or (sa-baked-global 'jolt-baked-version-early)\nhost/chez/rt.ss:2188:        ;; (jolt.host/scheme-eval-string in a build that dropped the compiler\nhost/chez/rt.ss:2421:;; fire 