{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' /Users/sto/workspace/datomworld/src/jolt/dao/host/bytes.jolt; cat host/gambit/host-apply.ss; rg -n 'defn.*string|apply str|:ns |ns-.*meta' jolt-core/jolt/backend_scheme.clj\"","aggregated_output":"(ns dao.host.bytes\n  \"The jolt override of src/cljc/dao/host/bytes.cljc (the :jolt alias puts\n   src/jolt first, docs/design/yin.repl-jolt-implementation.md §4.2): the\n   same public entries, arities, laws and refusal data\n   (docs/design/dao.stream.host-boundary.md §4.2, table A; §2.4).\n\n   The host byte array on jolt is jolt's own byte array (`byte-array`,\n   class `byte/1`, signed elements like the JVM's `byte[]`), so shared code\n   that reads one with `aget`/`alength`, and the test fixtures, see the\n   same value. A byte is read and written as a native integer 0 to 255.\n   Every entry is written over jolt's core array functions only, with the\n   prevalidation and memmove the laws require spelled out, rather than over\n   the `System/arraycopy` and `java.util.Arrays` shims the shared :clj arms\n   would reach.\"\n  (:refer-clojure :exclude [bytes? get set!]))\n\n\n(defn- refuse\n  [entry cls detail]\n  (throw (ex-info (str \"dao.host refused: \" entry \" \" (name cls) \" (\" detail \")\")\n                  {:dao.host/refusal cls :dao.host/entry entry :detail detail})))\n\n\n(defn bytes?\n  \"P. True when `x` is a host byte array.\"\n  [x]\n  (clojure.core/bytes? x))\n\n\n(defn- native-int?\n  [x]\n  (int? x))\n\n\n(defn- check-bytes!\n  [entry bs]\n  (when-not (bytes? bs)\n    (refuse entry :unsupported-value \"not a host byte array\")))\n\n\n(defn- check-index!\n  \"Refuse unless native integer `i` lies in [lo, hi].\"\n  [entry i lo hi]\n  (when-not (and (native-int? i) (<= lo i) (<= i hi))\n    (refuse entry :out-of-range (str i \" not in [\" lo \", \" hi \"]\"))))\n\n\n(defn- check-byte!\n  [entry v]\n  (when-not (and (native-int? v) (<= 0 v) (<= v 255))\n    (refuse entry :out-of-range (str v \" is not a byte 0-255\"))))\n\n\n(defn length\n  \"P. The number of bytes in `bs`.\"\n  [bs]\n  (check-bytes! 'length bs)\n  (alength bs))\n\n\n(defn alloc\n  \"P, fresh. A new host byte array of `n` zero bytes, `n` a native\n   integer from 0.\"\n  [n]\n  (when-not (and (native-int? n) (<= 0 n))\n    (refuse 'alloc :out-of-range (str n \" is not a length\")))\n  (byte-array n))\n\n\n(defn- byte-at\n  \"The byte at an index already checked.\"\n  [bs i]\n  (bit-and (aget bs i) 0xff))\n\n\n(defn- put!\n  \"Write byte `v` at an index already checked.\"\n  [bs i v]\n  (aset bs i (unchecked-byte v)))\n\n\n(defn get\n  \"P. The byte at index `i` of `bs`, 0 to 255.\"\n  [bs i]\n  (check-index! 'get i 0 (dec (length bs)))\n  (byte-at bs i))\n\n\n(defn slice\n  \"P, fresh. A new host byte array holding `bs[start, end)`, for\n   0 <= start <= end <= length.\"\n  [bs start end]\n  (let [n (length bs)]\n    (check-index! 'slice start 0 n)\n    (check-index! 'slice end start n))\n  (let [out (byte-array (- end start))]\n    (dotimes [i (- end start)]\n      (aset out i (aget bs (+ start i))))\n    out))\n\n\n(defn equal?\n  \"P. True when byte arrays `a` and `b` hold the same bytes.\"\n  [a b]\n  (let [n (length a)]\n    (and (= n (length b))\n         (loop [i 0]\n           (or (= i n)\n               (and (= (byte-at a i) (byte-at b i))\n                    (recur (inc i))))))))\n\n\n(defn from-vector\n  \"P, fresh. A new host byte array of `xs`, a vector of native integers\n   0 to 255; any other element is refused `:out-of-range` before\n   anything is built.\"\n  [xs]\n  (when-not (vector? xs)\n    (refuse 'from-vector :unsupported-value \"not a vector\"))\n  (run! #(check-byte! 'from-vector %) xs)\n  (let [out (byte-array (count xs))]\n    (dotimes [i (count xs)]\n      (put! out i (nth xs i)))\n    out))\n\n\n(defn to-vector\n  \"P. The bytes of `bs` as a vector of native integers 0 to 255.\"\n  [bs]\n  (let [n (length bs)]\n    (loop [i 0\n           out (transient [])]\n      (if (< i n)\n        (recur (inc i) (conj! out (byte-at bs i)))\n        (persistent! out)))))\n\n\n(defn set!\n  \"M. Write byte `v`, 0 to 255, at index `i` of target `bs`; nil. A bad\n   index or byte is refused before the write.\"\n  [bs i v]\n  (check-index! 'set! i 0 (dec (length bs)))\n  (check-byte! 'set! v)\n  (put! bs i v)\n  nil)\n\n\n(defn copy!\n  \"M. Copy `len` bytes from `src[src-pos ...]` into target\n   `dest[dest-pos ...]`; nil. Both ranges are checked before any write,\n   and overlapping ranges in one array copy as memmove: backward when the\n   destination starts after the source, forward otherwise.\"\n  [src src-pos dest dest-pos len]\n  (let [sn (length src)\n        dn (length dest)]\n    (check-index! 'copy! len 0 (min sn dn))\n    (check-index! 'copy! src-pos 0 (- sn len))\n    (check-index! 'copy! dest-pos 0 (- dn len)))\n  (if (and (identical? src dest) (> dest-pos src-pos))\n    (loop [i (dec len)]\n      (when (<= 0 i)\n        (aset dest (+ dest-pos i) (aget src (+ src-pos i)))\n        (recur (dec i))))\n    (dotimes [i len]\n      (aset dest (+ dest-pos i) (aget src (+ src-pos i)))))\n  nil)\n;; The compiler escapes a Scheme string with (apply str ...) over its characters.\n;; Gambit limits the size of a Scheme argument frame, so join the pieces over\n;; a port without turning the list into arguments. Keep the single-argument\n;; identity and str's handling of adjacent UTF-16 surrogate units.\n(define (gambit-str-pieces xs)\n  (cond\n    ((null? xs) \"\")\n    ((null? (cdr xs)) (jolt-str (car xs)))\n    (else\n     (call-with-output-string\n       (lambda (port)\n         (let loop ((xs xs))\n           (when (pair? xs)\n             (if (and (jsurr-high? (car xs)) (pair? (cdr xs))\n                      (jsurr-low? (cadr xs)))\n                 (begin (display (jolt-str (car xs) (cadr xs)) port)\n                        (loop (cddr xs)))\n                 (begin (displ