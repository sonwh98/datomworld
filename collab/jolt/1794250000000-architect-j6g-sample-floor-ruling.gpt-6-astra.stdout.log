-built request and response media.  No socket, no\n   scheduler, no callback: the test plays the server between steps.\"\n  []\n  (let [requests (handle 8)\n        responses (handle 8)\n        state (-> (driver/create-state)\n                  (driver/attach-remote\n                    (adapter/state (rpc/client-state requests responses\n                                                     (oldest responses)))))]\n    {:requests requests\n     :responses responses\n     :request-cursor (oldest requests)\n     :state state}))\n\n\n(defn- read-request\n  [{:keys [requests]} cursor]\n  (stream/next requests cursor))\n\n\n(deftest a-line-producer-only-appends\n  (let [state (driver/create-state)]\n    (driver/submit-line! (:input state) \"(+ 1 2)\")\n    (is (empty? (texts state)) \"appending a line evaluates nothing\")\n    (let [stepped (driver/repl-step state 0)]\n      (is (= [\"3\"] (texts stepped)))\n      (is (= 0 (:last-tick stepped))))))\n\n\n(deftest lines-are-evaluated-in-order-and-published-once\n  (let [state (driver/create-state)]\n    (driver/submit-line! (:input state) \"(+ 1 2)\")\n    (driver/submit-line! (:input state) \"(+ 2 2)\")\n    (let [stepped (driver/repl-step state 0)\n          [entries drained] (driver/take-outbox stepped)]\n      (is (= [\"3\" \"4\"] (mapv :yin.repl.driver/text entries)))\n      (is (empty? (first (driver/take-outbox drained))))\n      (is (empty? (texts (driver/repl-step drained 1)))\n          \"a later step must not republish an earlier result\"))))\n\n\n(deftest blank-lines-produce-no-output\n  (let [state (driver/create-state)]\n    (driver/submit-line! (:input state) \"   \")\n    (is (empty? (texts (driver/repl-step state 0))))))\n\n\n(deftest quit-stops-the-driver\n  (let [state (driver/create-state)]\n    (driver/submit-line! (:input state) \"(quit)\")\n    (driver/submit-line! (:input state) \"(+ 1 2)\")\n    (let [stepped (driver/repl-step state 0)]\n      (is (false? (:running? stepped)))\n      (is (= [\"Bye\"] (texts stepped))\n          \"input after a quit is not evaluated\"))))\n\n\n(deftest the-input-drain-is-total-over-next\n  (let [input (handle 2)\n        state (driver/create-state {:input input :input-cursor (oldest input)})]\n    (doseq [line [\"(+ 1 1)\" \"(+ 2 2)\" \"(+ 3 3)\" \"(+ 4 4)\"]]\n      (driver/submit-line! input line))\n    (let [stepped (driver/repl-step state 0)\n          entries (texts stepped)]\n      (is (str/includes? (first entries) \"input lost\"))\n      (is (= [\"6\" \"8\"] (vec (rest entries)))\n          \"evicted lines are never evaluated\")\n      (is (= :dao.stream/blocked (:input-ledger stepped))))))\n\n\n(deftest ordinary-source-is-forwarded-while-one-request-is-outstanding\n  (let [{:keys [state] :as fixture} (remote)]\n    (driver/submit-line! (:input state) \"(+ 1 2)\")\n    (driver/submit-line! (:input state) \"(+ 2 2)\")\n    (let [stepped (driver/repl-step state 0)\n          read (read-request fixture (:request-cursor fixture))\n37:    (stream/cursor inner anchor))\n41:    [_ cursor]\n42:    (swap! reads conj [:next cursor])\n43:    (stream/next inner cursor))\n52:  \"Every value currently on a stream, read from its oldest cursor.\"\n54:  (loop [cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n56:    (let [r (stream/next s cursor)]\n58:        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n153:        \"publication lands in the shell's dao.jing store\")\n269:(deftest only-derived-publication-state-is-retained-between-rounds\n286:        (is (= (:dao.stream/cursor (stream/cursor (:local ix) :dao.stream/newest))\n287:               (get-in ix [:materialization :cursor])))\n289:                            [:cursor :transactions :manifest-address])\n290:               (:index-publication (repl/repl-state state))))\n292:            \"the local log holds transaction records only, no publication payload\")\n304:(defn- full-publication\n316:(deftest incremental-publication-covers-the-same-history-as-full-reconstruction\n330:              full (:manifest (full-publication next-ix))]\n337:          (is (= (:dao.stream/cursor (stream/cursor (:local next-ix) :dao.stream/newest))\n338:                 (get-in next-ix [:materialization :cursor])))\n353:    (is (not-any? #(= [:cursor :dao.stream/oldest] %) @reads)\n354:        \"neither allocation nor publication reopens the prefix\")\n356:        \"one suffix record and one blocked read, independent of history\")\n385:(deftest a-stale-or-foreign-live-cursor-falls-back-to-full-reconstruction\n386:  (doseq [cursor-kind [:stale :ahead :foreign]]\n390:                            {:observer observer :session-token \"cursor-validation\"\n405:          cursor (case cursor-kind\n406:                   :stale (get-in first-ix [:materialization :cursor])\n407:                   :ahead (:dao.stream/cursor (stream/cursor (:local pending) :dao.stream/newest))\n408:                   :foreign (:dao.stream/cursor (stream/cursor foreign :dao.stream/oldest)))\n411:                  (assoc-in [:materialization :cursor] cursor))\n414:      (is (some #(= [:cursor :dao.stream/oldest] %) @reads)\n415:          (str cursor-kind \" cursor triggers full reconstruction\"))\n417:      (is (= (:manifest (full-publication fixed))\n421:(deftest unreadable-dirty-content-and-head-failure-never-promote-the-cursor\n470:(deftest recovery-discards-live-cursors-and-derives-authority-from-history\n481:                  ;; No stale process cursor or allocator is recovery authority.\n491:    (is (some #(= [:cursor :dao.stream/oldest] %) @reads)\n496:    (is (= (:manifest (full-publication resumed))\n498:        \"the first recovered publication is exactly today's full reconstruction\")))\n510:        published (full-publication initial)\n522:(deftest a-publication-beyond-the-old-intake-bound-completes\n545:        \"one publication exceeds the old 4096-payload ring intake\")\n553:(deftest a-publication-failure-is-reported-in-the-round-and-repl-state\n763:              \"the round evaluates and says what its publication lost\")\n48:(`collab/jolt/1792427226000-architect-jolt-lane-plan-r7.gpt-6-astra.findings.md`),\n91:(`collab/jolt/1792454716000-architect-jolt-design-doc-review.gpt-6-astra.findings.md`)\n103:`collab/jolt/1792489765000-engineer-jolt-j0a-os-packages.claude-opus-5-5.findings.md`):\n448:|                                | J4d: on jolt a key file is created by one O_CREAT+O_EXCL open at mode 0600 (native/jolt-file layout 3), written whole,  |             |\n1581:| f5397a15, J4d merge);                       | lifecycle cleanup | persist through the jolt -main (--reset, --no-state); key files are created O_EXCL at 0600 and      |\n2164:`collab/jolt/1792454716000-architect-jolt-design-doc-review.gpt-6-astra.findings.md`\n","exit_code":0,"status":"completed"}}
