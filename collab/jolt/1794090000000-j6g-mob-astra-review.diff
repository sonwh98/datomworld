+(defn- binomial-cdf
+  [n k q]
+  (loop [i 0 log-term (* n (Math/log (- 1.0 q))) total 0.0]
+    (let [total (+ total (Math/exp log-term))]
+      (if (= i k)
+        total
+        (recur (inc i) (+ log-term (Math/log (/ (- n i) (double (inc i))))
+                          (Math/log (/ q (- 1.0 q)))) total)))))
