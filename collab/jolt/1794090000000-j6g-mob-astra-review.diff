+         :arrival-p99-ms (p99 (latencies rows :scheduled-at))}
+     :a {:sent-bytes (max 0 (- (:offset a 0) (:header-bytes a 0)))
+         :percent (* 100.0 (/ (max 0 (- (:offset a 0) (:header-bytes a 0)))
