+(defn- cursor
+  [medium]
+  (let [r (stream/cursor medium :dao.stream/oldest)]
+    (if (= :dao.stream/ok (:dao.stream/outcome r))
+      (:dao.stream/cursor r)
+      (fail! "Workload stream cursor failed" {:result r}))))
