+  [binary! error!]
+  {:opened! (fn []) :binary! binary!
+   :message! (fn [_] (error! :unexpected-text))
+   :closed! (fn [code reason] (error! {:closed code :reason reason}))
+   :error! error! :too-large! (fn [] (error! :too-large))})
