lt.ffi/__cfn \\\"joltffi_absent\\\" [] :int)) (catch Throwable e (boolean (re-find #\\\"no entry\\\" (ex-message e)))))','true'),\n]\nextra=''.join('(public-check '+json.dumps(a,ensure_ascii=False)+' '+json.dumps(b,ensure_ascii=False)+')\\\\n' for a,b in checks);s=s[:pos]+extra+s[pos:];p.write_text(s)\np=Path('Makefile');s=p.read_text().replace('''sh host/gambit/ffi/watchdog.sh 120 \\\"\"'$(GAMBIT_GSI)\" host/gambit/gambitcheck.ss;'\"''','''sh host/gambit/ffi/watchdog.sh 120 \\\"\"'$(GAMBIT_GSI)\" host/gambit/gambitcheck.ss && '\"\\\\\\\\\n\\\\t\\\\tsh host/gambit/ffi/watchdog.sh 180 \\\"\"'$(GAMBIT_GSI)\" host/gambit/ffi/gambitffi-public.ss;'\"''');p.write_text(s)\n# Simplify stale bridge discovery and remove unsupported assertions in comments.\np=Path('host/gambit/scheme-adapter-runtime.ss');s=p.read_text();a=s.index('(define (joltffi-bridge-path-candidates)');b=s.index('(define (joltffi-bridge-path-known)',a);s=s[:a]+'''(define (joltffi-bridge-path-candidates)\n  ;; Native gates run from the checkout root; no ambient module lookup.\n  (list \\\"build/gambit-ffi/joltffi-bridge.o1\\\"))\n\n''' +s[b:]\ns=s.replace(''';; root, so the path is probed cwd-relative first, then relative to the script\n;; location (the same derivation gambitcheck's contract pass uses).''',''';; root. The bridge path is deliberately checkout-relative.''')\ns=s.replace(''';; references before the call observes weak references cleared and the heap\n;; shrink — the behavioral witness in gambitcheck.ss asserts exactly that.''',''';; references before the call observes weak keys cleared; gambitcheck asserts\n;; that behavior (no heap-size or blocked-call GC claim).''')\ns=s.replace('both supported legs', 'LP64 layouts').replace('arm64 macOS, x86_64/arm64\\\\n;; Linux — LP64','LP64; only macOS arm64 is qualified here')\ns=s.replace(';; argtypes and result types',';; argtypes and result types')\np.write_text(s)\np=Path('host/gambit/ffi/joltffi-bridge.scm');s=p.read_text();s=''';; Ahead-of-time native bridge for the bounded Gambit FFI tier.\n;; generated-shims.scm supplies typed calls from shapes.json (including the\n;; variadic boundary). Blocking, callables, aggregates, runtime signatures and\n;; pinning remain refused in the adapter/compiler. See README.md for coverage.\n;;\n;; Capture cells are allocated per invocation before entering C. Each typed\n;; shim saves errno immediately after its target, before conversion or cleanup,\n;; then writes the caller-owned cell. No last-errno global/TLS cell is used.\n;; The test build injects a clobber AFTER that save; the wrong-order control\n;; saves AFTER its clobber. Neither control qualifies callbacks or blocking.\n;;\n;; Native pointers cross as exact integers through unsigned-long. Static\n;; assertions enforce LP64. Only the provisioned macOS arm64 leg is qualified.\n;; Bulk copies borrow a u8vector body for one non-allocating synchronous C call;\n;; they retain no Scheme address and are never collect-safe.\n\n''' + s[s.index('(c-declare'):];p.write_text(s)\nPY\npython3 /tmp/p1b-finish-edits.py\npython3 host/gambit/ffi/generate-shims.py\nsh host/gambit/ffi/make-digests.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
