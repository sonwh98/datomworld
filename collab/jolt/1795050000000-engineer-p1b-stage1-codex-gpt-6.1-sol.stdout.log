wned memory, viewed\n;; through the ftype the binding declares for it.\nrg: test/chez/ffi-native-error-test.clj: No such file or directory (os error 2)\ntest/chez/jolt-ffi-scoped-test.clj:112:;; over a call unboxes; a wrapper fn or a :capture-native-error binding answers\ntest/chez/jolt-ffi-scoped-test.clj:119:(ffi/defcfn c-fabsf-capture \"fabsf\" [:float] :float {:capture-native-error true})\njolt-core/jolt/analyzer.clj:56:            [jolt.analyzer.ffi :refer [analyze-ffi-layout analyze-ffi-fn analyze-ffi-pointer-fn\njolt-core/jolt/analyzer.clj:1311:             (contains? #{\"__cfn\" \"__cfn-pointer\" \"__layout\" \"__ccallable\"} (form-sym-name head)))\njolt-core/jolt/analyzer.clj:1324:    \"__layout\" (analyze-ffi-layout items)\nstdlib/jolt/ffi.clj:354:  (list 'jolt.ffi/__layout descriptor))\njolt-core/jolt/analyzer/ffi.clj:11:(def ^:private ffi-layout-scalars\njolt-core/jolt/analyzer/ffi.clj:17:(declare analyze-ffi-layout-type)\njolt-core/jolt/analyzer/ffi.clj:19:(defn- ffi-layout-form-kind [form]\njolt-core/jolt/analyzer/ffi.clj:31:(defn- analyze-ffi-layout-aggregate [form]\njolt-core/jolt/analyzer/ffi.clj:32:  (let [kind (ffi-layout-form-kind form)\njolt-core/jolt/analyzer/ffi.clj:66:                                         :type (analyze-ffi-layout-type (nth fp 1))}))))))))))))\njolt-core/jolt/analyzer/ffi.clj:68:(defn- analyze-ffi-layout-array [form]\njolt-core/jolt/analyzer/ffi.clj:79:       :type (analyze-ffi-layout-type (nth parts 1))})))\njolt-core/jolt/analyzer/ffi.clj:81:(defn- analyze-ffi-layout-type [form]\njolt-core/jolt/analyzer/ffi.clj:85:      (when-not (and (nil? (namespace form)) (contains? ffi-layout-scalars n))\njolt-core/jolt/analyzer/ffi.clj:91:    (case (ffi-layout-form-kind form)\njolt-core/jolt/analyzer/ffi.clj:92:      \"struct\" (analyze-ffi-layout-aggregate form)\njolt-core/jolt/analyzer/ffi.clj:93:      \"union\" (analyze-ffi-layout-aggregate form)\njolt-core/jolt/analyzer/ffi.clj:94:      \"array\" (analyze-ffi-layout-array form)\