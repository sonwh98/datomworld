{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"sed -n '770,845p' host/chez/java/ffi.ss; sed -n '272,300p' host/gambit/host-ffi.ss; sed -n '104,120p' host/gambit/host-ffi.ss; sed -n '458,478p' jolt-core/jolt/backend_scheme/ffi.clj; sed -n '2064,2178p' Makefile; git diff --stat\"","aggregated_output":"           out))\n        ((jolt-nil? x) #f)\n        (else (jolt-ffi-string->c x))))\n\n;; --- foreign memory ----------------------------------------------------------\n;; alloc returns a pointer (integer address). The caller frees it. read/write take\n;; a type keyword and an optional byte offset.\n(define (ffi-alloc nbytes) (sa-foreign-alloc (jnum->exact nbytes)))\n;; ZEROED allocation, in one block move. An arena hands out zeroed memory (as\n;; babashka.ffi/alloc does), because a struct a caller only partly fills is the\n;; ordinary case and malloc's leftovers in the rest of it are a C-visible bug\n;; that reproduces only under load. The fill is in place: a zeroed bytevector to\n;; copy from would put the block's whole size on the heap as garbage, which for a\n;; 64 KB block was most of the 6 us an alloc took.\n(define (ffi-calloc nbytes)\n  (let* ((n (jnum->exact nbytes)) (p (sa-foreign-alloc n)))\n    (when (> n 0) (sa-foreign-zero! p n))\n    p))\n(define (ffi-free ptr) (sa-foreign-free (jnum->exact ptr)) jolt-nil)\n;; --- :bool <-> a one-byte C boolean -----------------------------------------\n;; Named for the direction of the CONVERSION, like the :string pair above, and\n;; used from the same three places: the emitted foreign-procedure, the emitted\n;; foreign-callable, and these accessors. jolt TRUTHINESS decides the byte, so\n;; nil and false send 0 and every other value sends 1 — a C predicate reads back\n;; as true/false rather than as the truthy number 0.\n(define (jolt-ffi-bool->c v) (if (or (jolt-nil? v) (eq? v #f)) 0 1))\n(define (jolt-ffi-c->bool raw) (not (eqv? (jnum->exact raw) 0)))\n;; --- :float/:double <- a java.lang.Float -------------------------------------\n;; (float x) answers a java.lang.Float, a jfloat record, and a Chez float or\n;; double position takes only a flonum: passing one raised \"invalid\n;; foreign-procedure argument\". Every place a jolt value crosses into C as a\n;; float or double unboxes it here, as jolt-double does — an argument, a\n;; callable's result, a write, a bare :& tail. Any other value passes through\n;; unchanged, so a wrong one still meets Chez's own check.\n(define (jolt-ffi-float->c x) (if (jfloat? x) (jfloat-fl x) x))\n;; The other direction: a C float reaches Clojure on the JVM as a\n;; java.lang.Float, so a :float result, a read of :float and a :float callback\n;; argument box the flonum Chez hands over (make-jfloat; it is already single\n;; precision, and the emitter calls the constructor itself). A :double stays a\n;; double.\n;; read/write take the type, then the OFFSET LAST — the babashka.ffi order, so\n;; (write p t v) and (write p t v offset) are one binding in both APIs. The jolt\n;; wrapper in stdlib/jolt/ffi.clj supplies the offset and resolves a layout or a\n;; place before it gets here; these two see a scalar type keyword and nothing\n;; else.\n(define ffi-read\n  (case-lambda\n    ((ptr ty) (ffi-read* ptr ty 0))\n    ((ptr ty off) (ffi-read* ptr ty off))))\n(define (ffi-read* ptr ty off)\n  (let ((ct (ffi-type->chez ty)))\n    (cond\n      ((eq? ct 'jolt-bool)\n       (jolt-ffi-c->bool (sa-foreign-ref 'unsigned-8 (jnum->exact ptr) (jnum->exact off))))\n      ((eq? ct 'float)\n       (make-jfloat (sa-foreign-ref 'float (jnum->exact ptr) (jnum->exact off))))\n      (else (sa-foreign-ref ct (jnum->exact ptr) (jnum->exact off))))))\n(define ffi-write\n  (case-lambda\n    ((ptr ty val) (ffi-write* ptr ty val 0))\n    ((ptr ty val off) (ffi-write* ptr ty val off))))\n(define (ffi-write* ptr ty val off)\n  (let ((ct (ffi-type->chez ty)))\n    (cond\n      ((eq? ct 'jolt-bool)\n       (sa-foreign-set! 'unsigned-8 (jnum->exact ptr) (jnum->exact off) (jolt-ffi-bool->c val)))\n      ((memq ct '(float double))\n       (sa-foreign-set! ct (jnum->exact ptr) (jnum->exact off) (jolt-ffi-float->c val)))\n      (else (sa-foreign-set! ct (jnum->exact ptr) (jnum->exact off) val))))\n  jolt-nil)\n;; sizeof a foreign type (for laying out structs / arrays).\n(define (ffi-sizeof ty) (sa-foreign-sizeof (ffi-chez-width (ffi-type->chez ty))))\n(define (ffi-null? ptr) (and (number? ptr) (= (jnum->exact ptr) 0)))\n(define ffi-null 0)\n\n;; (copy src dst n) -> nil. The block travels through ONE bytevector, so this is\n\n(define (joltffi-load-candidates cands)\n  (joltffi-ensure-bridge! 'jolt.ffi/load-library)\n  (let loop ((cs cands))\n    (cond\n      ((null? cs)\n       (jolt-throw (jolt-ex-info\n                     (string-append \"jolt.ffi/load-library: cannot load \"\n                                    (if (null? (cdr cands)) \"\" \"any of \")\n                                    (joltffi-join-candidates cands \", \")\n                                    (let ((note (joltffi-load-failure-note cands)))\n                                      (if note (string-append \" — \" note) \"\")))\n                     (jolt-hash-map (keyword #f \"candidates\")\n                                    (make-pvec (list->vector cands))))))\n      ((joltffi-load-native (car cs)) (car cs))\n      (else (loop (cdr cs))))))\n\n(define (joltffi-load-library . args)\n  (cond\n    ((or (null? args) (jolt-nil? (car args)))\n     jolt-nil)\n    ((jolt-map? (car args))\n     (let* ((spec (car args))\n            (key (begin (joltffi-ensure-bridge! 'jolt.ffi/load-library) (joltffi-platform-key)))\n            (name (jolt-get-dispatch spec (keyword #f key) jolt-nil))\n            (name (if (and (jolt-nil? name) (string=? key \"darwin\"))\n                      (jolt-get-dispatch spec (keyword #f \"mac\") jolt-nil) name)))\n       (when (jolt-nil? name)\n         (jolt-throw (jolt-ex-info\n      ((string=? n \"double\") 'double)\n      ((string=? n \"float\") 'float)\n      ((or (string=? n \"pointer\") (string=? n \"void*\")) 'void*)\n      ((string=? n \"char\") 'char)\n      ((string=? n \"bool\") 'jolt-bool)   ; one byte wide; converted at the boundary\n      ((string=? n \"string\") 'string)\n      ((string=? n \"void\") 'void)\n      (else (error #f (string-append \"jolt.ffi: unknown foreign type :\" n))))))\n\n(define (joltffi-sizeof-chez ct) (sa-foreign-sizeof (if (eq? ct 'jolt-bool) 'unsigned-8 ct)))\n\n(define (joltffi-read ptr ty off)\n  (let ((ct (joltffi-type->chez ty)))\n    (cond\n      ((eq? ct 'jolt-bool)\n       (jolt-ffi-c->bool (sa-foreign-ref 'unsigned-8 (jnum->exact ptr) (jnum->exact off))))\n      ((eq? ct 'float)\n;; symbol in a library loaded with load-library could not be bound AT ALL --\n;; RTLD_LOCAL keeps it out of the global table, so the name found nothing and the\n;; call raised \"no entry\". curl_easy_setopt is that case. The address+convention\n;; form this emits is the one the aggregate C witness already covers on each\n;; target ABI.\n(defn- gambit-procedure-expr [node vi name]\n  ;; Gambit eval cannot see unit macros. Emit the adapter's registered-shape\n  ;; constructor with literal type data; C shims remain ahead-of-time facilities.\n  (if (:blocking node)\n    \"(joltffi-public-blocking-raise)\"\n    (let [at (:argtypes node)\n          types (if vi (vec (concat (subvec at 0 vi) (subvec at (inc vi)))) at)]\n      (str \"(joltffi-public-procedure '(\" (str/join \" \" (map ffi-arg-type->chez types)) \") '\"\n           (ffi-type->chez (:rettype node)) \" \" name \" \" (if vi vi \"#f\") \" \" (if (:capture-native-error node) \"#t\" \"#f\") \")\"))))\n\n(defn- ffi-named-procedure-expr [node vi signature]\n  (let [csym (chez-str-lit (:csym node))\n        capture (:capture-native-error node)\n        blocking (:blocking node)\n        conv (if vi (str \" (__varargs_after \" vi \")\") \"\")\n        capture-conv (cond blocking \"__collect_safe\"\n# ---- P1b-stage1: the gambitffi* gates ----------------------------------------\n#\n# The bounded FFI tier qualified per the standing codex C4 PARTIAL-GO ruling:\n# memory ops, loading, ordinary calls and invocation-local errno capture,\n# behind the ahead-of-time native bridge (host/gambit/ffi/joltffi-bridge.scm,\n# compiled by gsc into build/gambit-ffi/joltffi-bridge.o1). Blocking,\n# callables, runtime signatures and object pinning keep their message-carrying\n# refusals; the gates assert both the witnesses AND the retained refusals.\n#\n# Deterministic bootstrap: every artifact builds from the pinned inputs in\n# host/gambit/ffi/DIGESTS.txt — verified before compiling, output digests\n# recorded after. No ambient .o1/.dylib is ever trusted. The aggregate target\n# is fail-closed: it passes only when all three gate scripts pass, and a gate\n# runs under the P1a-r2 external watchdog (host/gambit/ffi/watchdog.sh, the\n# same pattern the p1a witnesses use) so a frozen VM is a recorded failure,\n# never a hang.\n\nGAMBIT-FFI-DIR := host/gambit/ffi\nGAMBIT-FFI-BUILD := build/gambit-ffi\n\n# the pinned inputs must match the recorded digests BEFORE anything compiles\ngambitffi-verify-digests:\n\t@sh $(GAMBIT-FFI-DIR)/verify-toolchain.sh \"$(GAMBIT_PREFIX)\"\n\t@sh $(GAMBIT-FFI-DIR)/verify-digests.sh\n\n$(GAMBIT-FFI-BUILD)/joltffi-bridge.o1: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-bridge.scm \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt $(GAMBIT-FFI-DIR)/generated-shims.scm\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\t@rm -f $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 $(GAMBIT-FFI-BUILD)/joltffi-bridge.o[0-9]* \\\n\t       $(GAMBIT-FFI-BUILD)/joltffi-bridge.c $(GAMBIT-FFI-BUILD)/joltffi-bridge.o \\\n\t       $(GAMBIT-FFI-BUILD)/joltffi-bridge.scm\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/\n\tcd $(GAMBIT-FFI-BUILD) && sh ../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -keep-c joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n\t  > $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1.sha256\n\t@cc --version > $(GAMBIT-FFI-BUILD)/compiler.txt\n\t@shasum -a 256 $(GAMBIT_GSC) $(GAMBIT_GSI) \"$(GAMBIT_PREFIX)/include/gambit.h\" \\\n\t  \"$(GAMBIT_PREFIX)/lib/libgambit.a\" > $(GAMBIT-FFI-BUILD)/runtime.sha256\n\n$(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-fixture.c \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 -dynamiclib -o $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-fixture.c\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib.sha256\n\n$(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/joltffi-fixture2.c \\\n\t\t$(GAMBIT-FFI-DIR)/DIGESTS.txt\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 -dynamiclib -o $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-fixture2.c\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib.sha256\n\n# the present-but-unloadable candidate: a one-symbol dylib linked against a\n# dependency dylib this recipe then REMOVES, so dlopen fails with the loader's\n# own preserved reason (a missing dependency, not a missing file)\n$(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib: gambitffi-force $(GAMBIT-FFI-DIR)/DIGESTS.txt \\\n\t\t$(GAMBIT-FFI-DIR)/joltffi-fixture2.c\n\t@$(MAKE) --no-print-directory gambitffi-verify-digests\n\t@mkdir -p $(GAMBIT-FFI-BUILD)\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 -dynamiclib -o $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib $(GAMBIT-FFI-DIR)/joltffi-dep.c\n\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 60 cc -O1 -dynamiclib -o $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib \\\n\t  $(GAMBIT-FFI-DIR)/joltffi-unloadable.c $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib\n\trm $(GAMBIT-FFI-BUILD)/libjoltffi-dep.dylib\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib \\\n\t  > $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib.sha256\n\n# bridge + fixtures, always current: the entry every gambitffi gate depends on\n.PHONY: gambitffi-force gambitffi-verify-digests\ngambitffi-force:\n\ngambitffi-bridge: gambitffi-verify-digests $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1 \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-fixture.dylib \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-fixture2.dylib \\\n                  $(GAMBIT-FFI-BUILD)/libjoltffi-unloadable.dylib\n\ngambitffi-abi: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-abi.ss && \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 180 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-public.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n\n$(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1: $(GAMBIT-FFI-BUILD)/joltffi-bridge.o1\n\t@mkdir -p $(GAMBIT-FFI-BUILD)/capture-test\n\t@rm -f $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o[0-9]*\n\tcp $(GAMBIT-FFI-DIR)/joltffi-bridge.scm $(GAMBIT-FFI-DIR)/generated-shims.scm $(GAMBIT-FFI-BUILD)/capture-test/\n\tcd $(GAMBIT-FFI-BUILD)/capture-test && sh ../../../$(GAMBIT-FFI-DIR)/watchdog.sh 120 $(GAMBIT_GSC) -keep-c -cc-options -DJOLTFFI_CAPTURE_TEST joltffi-bridge.scm\n\t@shasum -a 256 $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1 > $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1.sha256\n\ngambitffi-errno-check: gambitffi-bridge $(GAMBIT-FFI-BUILD)/capture-test/joltffi-bridge.o1\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 120 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-errno.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\ngambitffi-load-failure-smoke: gambitffi-bridge\n\t@if [ -x \"$(GAMBIT_GSI)\" ]; then \\\n\t\tsh $(GAMBIT-FFI-DIR)/watchdog.sh 90 \"$(GAMBIT_GSI)\" $(GAMBIT-FFI-DIR)/gambitffi-load-failure.ss; \\\n\telse \\\n\t\techo \"$@: required Gambit runtime is absent\" >&2; exit 1; \\\n\tfi\n\n# the aggregate: all three, fail-closed (each script exits nonzero on failure)\ngambitffi: gambitffi-abi gambitffi-errno-check gambitffi-load-failure-smoke\n\t@echo \"gambitffi: PASS — all stage-1 qualified-tier gates green\"\n\n Makefile                                  | 124 +++++-\n host/chez/seed/image.ss                   | 709 +++++++++++++++---------------\n host/gambit/boot.ss                       |   5 +\n host/gambit/gambitcheck.ss                |  83 ++--\n host/gambit/scheme-adapter-runtime.ss     | 672 ++++++++++++++++++++++------\n host/gambit/seed/image.ss                 | 658 +++++++++++++--------------\n host/scheme-adapter/CONTRACT.txt          |   5 +\n host/scheme-adapter/TARGET-CONTRACT.md    |  10 +-\n jolt-core/jolt/backend_scheme/ffi.clj     |  79 ++--\n jolt-core/jolt/backend_scheme/session.clj |   7 +-\n 10 files changed, 1470 insertions(+), 882 deletions(-)\n","exit_code":0,"status":"completed"}}
