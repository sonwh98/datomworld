}]}\n\n   ;; S-29 — collect-safe callable (callback may arrive on a foreign thread or\n   ;; a thread parked in a :blocking call). Refused on gambit until the\n   ;; foreign-thread entry protocol is qualified (astra ruling).\n   {:id :shape/s29-callable-collect-safe\n    :args [:pointer] :ret :int\n    :kind :callable :entry-convention :collect-safe\n    :blocking false :capture-native-error false\n    :disposition :raise\n    :produced-by\n    [{:sym \"svc callback\" :at \"test/chez/ffi-gc-stall-test.clj:65\"}\n     {:sym \"svc callback\" :at \"test/chez/ffi-foreign-thread-test.clj:47\"}]}\n\n   ;; S-30 — by-value aggregate argument ([:by-value [:struct ...]] positions).\n   ;; Emitted with define-ftype + (& ftype) marshaling (ffi.clj:526-608);\n   ;; refused on gambit for callables (ffi.clj:763-771), unguarded for named\n   ;; fns (gap G-2). Fixture-only on this fork.\n   {:id :shape/s30-aggregate-by-value\n    :args [[:by-value [:struct [[:a :int64] [:b :int64] [:c :int64]]]]] :ret :int64\n    :kind :procedure\n    :blocking false :capture-native-error false\n    :disposition :raise\n    :produced-by\n    [{:sym \"jolt_agg_date_score\" :at \"test/chez/jolt-ffi-aggregate-test.clj:22-25\"}\n     {:sym \"jolt_agg_packet_score\" :at \"test/chez/jolt-ffi-aggregate-test.clj:47\"}]}\n\n   ;; S-31 — bare varargs (tail inferred per call): the shape space is\n   ;; OPEN-ENDED by construction (carriers integer-64/double/u8* per position,\n   ;; host/chez/java/ffi.ss:1292-1311); each new shape compiles a\n   ;; foreign-procedure via eval at run time (ffi.ss:1373-1386). A finite\n   ;; registry cannot claim it — raise.\n   {:id :shape/s31-bare-varargs\n    :args [:int] :ret :int64\n    :variadic {:marker :& :bare true :tail :inferred-per-call}\n    :kind :procedure\n    :blocking false :capture-native-error false\n    :disposition :raise\n    :produced-by\n    [{:sym \"jolt_agg_sum_varargs\" :at \"test/chez/jolt-ffi-aggregate-test.clj:42-44\"}]}\n\n   ;; S-32 — declared-tail varargs with capture and pointer-call variants\n   ;; produced only by fixtures (curl_easy_setopt case, ffi.clj:455-462).\n   {:id :shape/s32-varargs-scoped\n    :args [:pointer :int :pointer] :ret :int\n    :variadic {:marker :varargs :tail :declared}\n    :kind :procedure\n    :blocking false :capture-native-error false\n    :disposition :fixture\n    :produced-by\n    [{:sym \"curl_easy_setopt shape\" :at \"jolt-core/jolt/backend_scheme/ffi.clj:455-462 (comment)\"}]}]\n\n  ;; ---------------------------------------------------------------------\n  ;; Classes NO current site or fixture produces → NOT registered as shapes;\n  ;; any attempt raises by design (astra: \"Unregistered shapes must raise\").\n  ;; Enumerated so the refusal messages can name them.\n  ;; ---------------------------------------------------------------------\n  :unregistered-classes\n  [{:class :aggregate-variadic\n    :why \"compile-time refusal already (ffi.clj:439-441)\"}\n   {:class :blocking-varargs\n    :why \"compile-time refusal already (ffi.clj:411-413)\"}\n   {:class :blocking-string-arg\n    :why \"compile-time refusal already (ffi.clj:424-435)\"}\n   {:class :capture-void\n    :why \"analyzer refusal (analyzer/ffi.clj:205-207)\"}\n   {:class :capture-by-value-return\n    :why \"analyzer refusal (analyzer/ffi.clj:208-209)\"}\n   {:class :union-by-value\n    :why \"analyzer refusal (analyzer/ffi.clj:141-146)\"}\n   {:class :two-convention-kernel-ops\n    :why \"(__atomic __alloc) scheme-object pairs are Chez-kernel symbols — rt.ss:1358-1371; no consumer site, Gambit refuses\"}\n   {:class :chez-internal-(cs)-entries\n    :why \"adapter file's own entries (scheme-adapter-runtime.ss:2070-2079) — Gambit adapter refuses\"}\n   {:class :runtime-signature-eval\n    :why \"ffi-varargs-compile (host/chez/java/ffi.ss:1373-1386) and sa-foreign-procedure-runtime (scheme-adapter-runtime.ss:977-980) construct procedures for shapes discovered at run time — outside any finite registry\"}]\n\n  ;; The registry's own honesty rule, restated for reviewers:\n  :unregistered-shapes-raise\n  \"Any call whose shape identity matches no entry above raises a\n   message-carrying unsupported error on the gambit target before any address\n   is dereferenced — it never reaches an unbound Chez identifier (gap G-3 in\n   ffi-call-sites.md §4 tracks the one path that does not yet honor this).\"}}\n;; foreign-procedure macro.\n(defn- check-ffi-signature! [node vi]\n  (let [at (:argtypes node)\n        marker (when vi (str \":\" (nth at vi)))\n        bare? (and vi (= vi (dec (count at))))]\n    ;; C requires a named parameter before the ellipsis.\n    (when (and vi (zero? vi))\n      (throw (ex-info (str \"jolt.ffi: \" marker \" needs at least one fixed argtype before it\")\n                      {:argtypes at})))\n    ;; A bare tail is compiled per call shape into a cache keyed by the binding's\n    ;; C symbol; a function-pointer binding has no symbol, and its address can\n    ;; change from call to call, so it declares its tail.\n    (when (and bare? (:pointer-call node))\n      (throw (ex-info (str \"jolt.ffi/pointer-fn: a bare \" marker \" is not supported through a\"\n                           \" function pointer — declare the variadic tail after the marker\")\n                      {:argtypes at})))\n    (when (and bare? (some ffi-by-value? (subvec at 0 vi)))\n      (throw (ex-info (str \"jolt.ffi: a fixed by-value aggregate cannot combine with a bare \"\n                           marker \" — the tail is compiled at the call, and an aggregate\"\n                           \" argument needs an ftype the binding declared. Declare the tail\"\n                           \" after the marker.\")\n                      {:argtypes at})))\n    ;; __collect_safe cannot combine with a varargs convention.\n    (when (and vi (:blocking node))\n      (throw (ex-info (str \"jolt.ffi: \" marker \" cannot combine with :blocking\")\n                      {:argtypes at})))\n    ;; Chez