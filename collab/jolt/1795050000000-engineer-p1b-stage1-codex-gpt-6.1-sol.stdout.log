nter :pointer :size_t :pointer] :ret :int\n    :blocking true :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_crypto_ed25519_sign\" :at \"src/jolt/dao/host/sign.jolt:52\"}\n     {:sym \"jolt_crypto_ed25519_verify\" :at \"src/jolt/dao/host/sign.jolt:54\"}]}\n\n   ;; ---- jolt-file (J4a-J4d POSIX wrapper; handles are :int64) ---------------\n   ;; S-08 — (path-ptr, int64) -> int64, blocking (open family + sync_dir +\n   ;; make_parents; J4a short/EINTR/error transfers live above these)\n   {:id :shape/s08-path-open-blocking\n    :args [:pointer :int64] :ret :int64\n    :blocking true :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_make_parents\" :at \"src/jolt/dao/posix/file.jolt:82\"}\n     {:sym \"jolt_file_open\" :at \"src/jolt/dao/posix/file.jolt:84\"}\n     {:sym \"jolt_file_open_excl\" :at \"src/jolt/dao/posix/file.jolt:101\"}\n     {:sym \"jolt_file_open_read\" :at \"src/jolt/dao/posix/file.jolt:102\"}\n     {:sym \"jolt_file_open_private\" :at \"src/jolt/dao/posix/file.jolt:104\"}\n     {:sym \"jolt_file_sync_dir\" :at \"src/jolt/dao/posix/file.jolt:111\"}]}\n\n   ;; S-09 — (handle) -> int64, blocking (length/fclassify/sync/close/lock;\n   ;; close-on-exec + poison/recovery semantics ride on close/lock)\n   {:id :shape/s09-handle-blocking\n    :args [:int64] :ret :int64\n    :blocking true :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_length\" :at \"src/jolt/dao/posix/file.jolt:85\"}\n     {:sym \"jolt_file_fclassify\" :at \"src/jolt/dao/posix/file.jolt:99\"}\n     {:sym \"jolt_file_sync\" :at \"src/jolt/dao/posix/file.jolt:91\"}\n     {:sym \"jolt_file_close\" :at \"src/jolt/dao/posix/file.jolt:92\"}\n     {:sym \"jolt_file_lock\" :at \"src/jolt/dao/posix/file.jolt:106\"}]}\n\n   ;; S-10 — positional read/write, blocking (J4a frame movers)\n   {:id :shape/s10-pread-pwrite-blocking\n    :args [:int64 :int64 :pointer :int64 :int64] :ret :int64\n    :blocking true :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_pread\" :at \"src/jolt/dao/posix/file.jolt:86\"}\n     {:sym \"jolt_file_pwrite\" :at \"src/jolt/dao/posix/file.jolt:88\"}]}\n\n   ;; S-11 — (handle, int64) -> int64, blocking (truncate)\n   {:id :shape/s11-truncate-blocking\n    :args [:int64 :int64] :ret :int64\n    :blocking true :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_truncate\" :at \"src/jolt/dao/posix/file.jolt:90\"}]}\n\n   ;; S-12 — big-endian field accessors, ordinary (metadata, never blocks)\n   {:id :shape/s12-s32be-get\n    :args [:pointer :int64] :ret :int32\n    :blocking false :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_s32be_get\" :at \"src/jolt/dao/posix/file.jolt:93\"}]}\n   {:id :shape/s12b-s32be-put\n    :args [:pointer :int64 :int32] :ret :void\n    :blocking false :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_s32be_put\" :at \"src/jolt/dao/posix/file.jolt:94\"}]}\n\n   ;; S-13 — error-text writer, ordinary\n   {:id :shape/s13-strerror\n    :args [:int64 :pointer :int64] :ret :int64\n    :blocking false :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_strerror\" :at \"src/jolt/dao/posix/file.jolt:95\"}]}\n\n   ;; S-14 — classify (J4b): (path, len, flags) -> int64, blocking\n   {:id :shape/s14-classify-blocking\n    :args [:pointer :int64 :int32] :ret :int64\n    :blocking true :capture-native-error false :variadic nil :kind :procedure\n    :disposition :shim+p2\n    :produced-by\n    [{:sym \"jolt_file_class