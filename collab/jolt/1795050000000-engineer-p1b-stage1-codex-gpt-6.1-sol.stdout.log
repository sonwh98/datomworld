{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"cat > host/gambit/ffi/watchdog.sh <<'SH'\n#\"'!/bin/sh\n# External deadline kills the entire gate process group, including make'\"'s children.\nexec python3 - \\\"\"'$@\" <<'\"'PY'\nimport os, signal, subprocess, sys\nseconds = float(sys.argv[1])\np = subprocess.Popen(sys.argv[2:], start_new_session=True)\ntry:\n    status = p.wait(timeout=seconds)\nexcept subprocess.TimeoutExpired:\n    os.killpg(p.pid, signal.SIGKILL)\n    p.wait()\n    print('WATCHDOG: TIMEOUT after %ss: %s' % (seconds, ' '.join(sys.argv[2:])), file=sys.stderr)\n    sys.exit(124)\nsys.exit(status if status >= 0 else 128 - status)\nPY\nSH\nsh host/gambit/ffi/watchdog.sh 240 make gambitffi GAMBIT_PREFIX=/Users/sto/.local/share/mise/installs/gambit/4.9.8 > /tmp/p1b-ffi.log 2>&1; st=\"'$?; tail -20 /tmp/p1b-ffi.log; exit \"$st\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
