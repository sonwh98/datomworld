KES-CLEAN := \\\n  build/ \\\n  target/ \\\n\nMAKES-REALCLEAN := \\\n  .jolt/ \\\n  test/chez/*/.jolt/ \\\n  test/chez/*/*/.jolt/ \\\n\nPREFIX ?= $(if $(IS-ROOT),/usr/local,$(HOME)/.local)\nCHEZ ?= $(JOLT-CHEZ)\n\n# Hand the selected Chez down to bin/jolt, so the targets that shell out to it\n# run the same interpreter as the ones that call $(CHEZ) directly. When make\n  (case (:op node)\n    ;; gap G-1 (inventory Q1): on :gambit a :ffi-layout emitted Chez\n    ;; define-ftype/make-ftype-pointer text that died as an unbound identifier\n    ;; at namespace load; refuse in words, at the form, instead.\n    :ffi-layout (if (= :gambit (target))\n                  (str \"(throw-jvm 'UnsupportedOperationException \"\n                       (chez-str-lit \"jolt.ffi/layout: ffi-layout (ftype aggregates) are unsupported on the gambit target\")\n                       \")\")\n                  (emit-ffi-layout node))\n    :ffi-fn (emit-ffi-fn node)\n    :ffi-callable\n    (if (and (= :gambit (target))\n             (or (ffi-by-value? (:rettype node)) (some ffi-by-value? (:argtypes node))))\n      ;; gambit has no ffi tier, and its eval knows no define-ftype, so a\n      ;; by-value callable there would die on an unbound name rather than on\n      ;; the target's own \"unsupported\" error. Raise when it is made, in words\n      ;; that name the form, as a scalar callable does there.\n      (str \"(throw-jvm 'UnsupportedOperationException \"\n           (chez-str-lit \"jolt.ffi/foreign-callable: ffi is unsupported on the gambit target\")\n           \")\")\n      (emit-ffi-callable emit node))))\n;; expression evaluates.\n;; ============================================================================\n\n(define (string-hash s) (equal?-hash s))\n\n(define (make-eq-hashtable . rest) (make-table test: eq?))\n(define (make-eqv-hashtable . rest) (make-table test: eqv?))\n(define (make-weak-eq-hashtable) (make-table test: eq? weak-keys: #t))\n;; Chez's ephemeron table: a key-weak table whose values may hold their key.\n;; Gambit's weak-keys table is the closest it has; a value that refers back to\n;; its key may keep that entry alive here (jutil-colls.ss's view cache).\n(define (make-ephemeron-eq-hashtable) (make-table test: eq? weak-keys: #t))\n(define (make-hashtable hash-fn equiv) (make-table test: equiv))\n\n(define (hashtable-ref t k d) (table-ref t k d))\n(define (hashtable-set! t k v) (table-set! t k v))\n;; Gambit deletion is (table-set! t k) with no value (G0 probe: delete = set!\n;; with no value; there is no table-delete!).\n(define (hashtable-clear! t)\n  (for-each (lambda (kv) (table-set! t (car kv))) (table->list t)))\n(define (hashtable-delete! t k) (table-set! t k))\n(define (hashtable-size t) (table-length t))\n\n(define %hashtable-missing (gensym 'hashtable-missing))\n(define (hashtable-contains? t k)\n  (not (eq? (table-ref t k %hashtable-missing) %hashtable-missing)))\n;; branches use sa-os-family / sa-arch / sa-endian. Contract: an opaque,\n;; per-build-stable host string.\n(define (sa-host-tag)\n  \"gambit\")\n\n;; (sa-os-family) -> 'macos | 'windows | 'linux\n;; The OS family every host OS branch derives. Contract: one of the three\n;; symbols. Degradation: none — the sites have no safe assumed default; an\n;; unrecognized host falls back to 'linux, matching the Chez adapter's\n;; else-branches. The G1 demo runs no OS branches, so 'linux is documented as\n;; the else-default, not probed.\n(define (sa-os-family)\n  'linux)\n\n;; (sa-arch) -> 'x86-64 | 'arm64 | 'i386 | 'other\n;; The machine architecture. Contract: the architecture symbol. Degradation:\n;; 'other for an unrecognized host; callers treat it as unverified.\n(define (sa-arch)\n  'other)\n\n;; (sa-endian) -> 'little | 'big | #f\n16:;; right for str and it is right where the boundary copies a VALUE — string->ptr\n23:;; is already used — NULL, in a :string argument and in string->ptr — so the split\n71:       (ffi-library-map (ffi-load-candidates (ffi-candidate-li