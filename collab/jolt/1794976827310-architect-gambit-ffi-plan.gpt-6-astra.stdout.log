nsrc/dev/jolt_tcp_probe.clj:1378:                                                       :on-upgrade-expired #(swap! expired inc)})))\nsrc/dev/jolt_tcp_probe.clj:1387:        (pump/upgraded! p (nth @accepted 1) stand-in nil)\nsrc/dev/jolt_tcp_probe.clj:1389:        (check \"listener: completing one upgrade admits exactly one more\"\nsrc/dev/jolt_tcp_probe.clj:1394:        (check \"listener: expiring one upgrade admits exactly one more (expiry reported once)\"\nsrc/dev/jolt_tcp_probe.clj:1396:        ;; lower-deadlines!: an upgraded connection's deadline is lowered, never raised\nsrc/dev/jolt_tcp_probe.clj:1428:                                                                             :upgrade-timeout-ms 60000}))\nnative/jolt-crypto/qualify.clj:2:;; jolt-toolchain.edn :native :libcrypto :qualified (procedure in the comment\nnative/jolt-crypto/qualify.clj:46:(let [decl (get-in (edn/read-string (slurp \"jolt-toolchain.edn\")) [:native :libcrypto])\nsrc/dev/jolt_j5_calibrate.clj:1:;; J5b calibration record (C4, docs/design/yin.repl-jolt-implementation.md\nsrc/dev/jolt_j5_calibrate.clj:3:;; frame and per lookahead link, measured with the guards off. J5c adds the\nsrc/dev/jolt_j5_calibrate.clj:82:(def n-work 600000000)  ; kMaxWork (J5c; --work asserts this by default)\nsrc/dev/jolt_j5_calibrate.clj:93:  (let [{:keys [cmake]} (edn/read-string (slurp \"jolt-toolchain.edn\"))\nsrc/dev/jolt_j5_calibrate.clj:202:;; --- the work record (J5c) ------------------------------------------------------\nsrc/dev/jolt_j0c_stack.clj:30:;; bound is chosen or enforced here; that is J5's.\nmise.toml:8:# jolt host lane (jolt-toolchain.edn): exact pins, never \"latest\"; a change of\nmise.toml:9:# either goes through the jolt upgrade gate\nsrc/dev/jolt_j5_budget.clj:1:;; J5b (known-gaps row 59; docs/design/yin.repl-jolt-implementation.md §7.6):\nsrc/dev/jolt_j5_budget.clj:104:(check \"the wrapper's bounds are the ruling's (input 4 MiB, rule 8192, lookahead 4096, full-LL 256) with the J5c wor