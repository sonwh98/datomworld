ocol-required` when nothing negotiates.               |\n;; Run under jolt -Srepro -M:jolt by probes/run.clj: the §6.3 collect-safety\n;; gate (the J0a leftover in src/dev/jolt_smoke.clj). One thread runs a\n;; 256 MiB :blocking jolt_crypto_blake3 call; once that call is under way\n;; this thread runs a full collection. The gate holds when the collection\n;; both starts and completes while the call is still running. The same input\n;; then goes through the public dao.host.hash/blake3-bytes, whose digest\n;; must equal the direct call's.\n(ns collect\n  (:require [clojure.string :as str]\n            [jolt.ffi :as ffi]))\n\n\n(require '[dao.host.hash :as hash])\n\n\n(def library\n  (let [os (str/lower-case (or (System/getProperty \"os.name\") \"\"))\n        arch (System/getProperty \"os.arch\")\n        darwin? (str/includes? os \"mac\")]\n    (str (System/getProperty \"user.dir\") \"/build/native/\"\n         (if darwin? \"darwin\" \"linux\") \"-\"\n         (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\")\n         \"/jolt-crypto/lib/libjolt_crypto\" (if darwin? \".dylib\" \".so\"))))\n\n\n(ffi/load-library library)\n(ffi/defcfn c-blake3 \"jolt_crypto_blake3\" [:pointer :size_t :pointer] :int :blocking)\n\n\n(defn- ms\n  [t0]\n  (long (/ (- (System/nanoTime) t0) 1e6)))\n\n\n(def n (* 256 1024 1024))\n(def input (byte-array n))\n(dotimes [i 4096] (aset input (* i 65536) (unchecked-byte i)))\n\n(def in (ffi/alloc n))\n(def out (ffi/alloc 32))\n(ffi/write-array in input)\n\n(def t0 (System/nanoTime))\n(def log (atom {}))\n\n\n(def th\n  (Thread. (fn []\n             (swap! log assoc :call-start (ms t0))\n             (swap! log assoc :status (c-blake3 in n out))\n             (swap! log assoc :call-end (ms t0)))))\n\n\n(.start th)\n(loop [] (when-not (:call-start @log) (Thread/sleep 1) (recur)))\n(Thread/sleep 20)\n(swap! log assoc :collect-start (ms t0))\n(jolt.host/gc-full!)\n(swap! log assoc :collect-end (ms t0))\n(.join th)\n\n(def direct (vec (ffi/read-array out 32)))\n(ffi/free in)\n(ffi/free out)\n(def via-entry (vec (hash/blake3-bytes input)))\n\n\n(let [{:keys [call-start call-end collect-start collect-end status]} @log\n      ok? (and (= 0 status)\n               (< call-start collect-start)\n               (< collect-end call-end)\n               (= direct via-entry))]\n  (println \"RECORD collect timeline, :blocking jolt_crypto_blake3 256 MiB\" (pr-str @log))\n  (println \"RECORD digest equal through dao.host.hash/blake3-bytes\" (= direct via-entry))\n  (println (if ok? \"PASS\" \"FAIL\")\n           \"a full collection starts and completes while the 256 MiB :blocking hash runs\")\n  (System/exit (if ok? 0 1)))\n;; Run under jolt -Srepro -M:jolt by probes/run.clj: collect-safety of the\n;; jolt-file bindings (design §2: GC completes during a blocked native call).\n;; One thread runs dao.posix.file's own :blocking binding of a disk entry, a\n;; 1 GiB jolt_file_pwrite and then the jolt_file_sync of that data; once the\n;; call is under way this thread runs a full collection. The gate holds when\n;; the collection both starts and completes while the pwrite is still\n;; running; the fsync's timeline is recorded (its duration is the\n;; filesystem's, so it is not gated).\n;; The file is deleted afterwards.\n(ns collect\n  (:require [jolt.ffi :as ffi]))\n\n\n(require '[dao.posix.file :as hf])\n\n\n(def c-pwrite @(ns-resolve 'dao.posix.file 'c-pwrite))\n(def c-sync @(ns-resolve 'dao.posix.file 'c-sync))\n\n\n(defn- ms\n  [t0]\n  (long (/ (- (System/nanoTime) t0) 1e6)))\n\n\n(defn- timeline\n  \"Run (call) on a thread; once it has started, run a full collection here.\n   Answers the timeline and the call's result.\"\n  [call]\n  (let [t0 (System/nanoTime)\n        log (atom {})\n        th (Thread. (fn []\n                      (swap! log assoc :call-start (ms t0))\n                      (swap! log assoc :result (call))\n                      (swap! log assoc :call-end (ms t0))))]\n    (.start th)\n    (loop [] (when-not (:call-start @log) (Thread/sleep 1) (recur)))\n    (Thread/sleep 20)\n    (swap! log assoc :collect-start (ms t0))\n    (jolt.host/gc-full!)\n    (swap! log assoc :collect-end (ms t0))\n    (.join th)\n    @log))\n\n\n(def n (* 1024 1024 1024))\n(def path \"build/j4a-probe/collect.bin\")\n(.mkdirs (java.io.File. \"build/j4a-probe\"))\n(.delete (java.io.File. path))\n\n(def h (hf/open path))\n(def fd (:fd h))\n(def buf (ffi/alloc n))\n\n\n(def results\n  (try\n    (let [w (timeline #(c-pwrite fd 0 buf 0 n))\n          s (timeline #(c-sync fd))]\n      [[\"jolt_file_pwrite 1 GiB\" w (= n (:result w))]\n       [\"jolt_file_sync of that 1 GiB\" s (= 0 (:result s))]])\n    (finally\n      (ffi/free buf)\n      (hf/close! h)\n      (.delete (java.io.File. path)))))\n\n\n(def ok?\n  ;; the gate is the pwrite; the fsync timeline is recorded, not gated: its\n  ;; duration is the filesystem's (APFS answers a 1 GiB fsync in a few ms)\n  (let [[[label {:keys [call-start call-end collect-start collect-end] :as t} result-ok?]\n         [sync-label sync-t sync-ok?]] results\n        ok (and result-ok? sync-ok? (< call-start collect-start) (< collect-end call-end))]\n    (println \"RECORD collect timeline, :blocking\" label (pr-str t))\n    (println \"RECORD collect timeline, :blocking\" sync-label (pr-str sync-t)\n             (if (and (< (:call-start sync-t) (:collect-start sync-t))\n                      (< (:collect-end sync-t) (:call-end sync-t)))\n               \"(the collection also completed inside the fsync)\"\n               \"(the fsync returned before the collection began or ended)\"))\n    (println (if ok \"PASS\" \"FAIL\")\n             (str \"a full collection starts and completes while the :blocking \" label\n                  \" runs; the fsync of that data succeeds\"))\n    ok))\n\n\n(System/exit (if ok? 0 1))\n// jolt-parser: the extern \"C\" boundary between jolt and the ANTLR4 C++\n// Python3 parser (docs/design/yin.repl-jolt-implementation.md §7.3).\n//\n// J0c round 1 probe surface. Bytes in, bytes out: the caller passes UTF-8\n// source by pointer and length and receives one private marshalling buffer,\n// which it copies and returns through jolt_parser_free. No C++ class, layout\n// or exception crosses this boundary; every entry catches std::exception and\n// (...) and answers an explicit status. This is process-local marshalling (like\n// a sockaddr), not a value codec: it never enters a stream. Packets are built\n// by the shared jolt/Clojure exporter from these records, never here.\n//\n// Buffer layout, all integers little-endian:\n//\n//   magic   \"JPT1\"\n//   u32     layout version (1)\n//   u32     status (0 ok, 1 syntax errors)\n//   u32     rule-name count R,     then R  x (u32 len, UTF-8 bytes)\n//   u32     symbolic-name count S, then S  x (u32 len, UTF-8 bytes)\n//   u32     node count N, then N preorder records:\n//             u8  kind (0 rule, 1 token)\n//             rule:  u32 rule index, u32 child count\n//             token: i32 token type, u32 start, u32 stop (code-point indexes,\n//                    0xFFFFFFFF = none), u32 text len, UTF-8 text\n//   u32     error count E, then E x (u32 line, u32 column, u32 len, UTF-8 msg)\n//\n// Status codes returned by jolt_parser_parse:\n//    0  parsed, buffer written (status field says whether errors occurred)\n//   -1  invalid arguments\n//   -2  C++ exception (std::exception); *out holds its message, UTF-8\n//   -3  unknown exception\n// On -2/-3 the message buffer is built without anything that can throw\n// (strlen/malloc/memcpy only); if even that malloc fails, *out stays NULL and\n// only the status reports the failure. No handler can throw.\n//\n//   -4  output would exceed the bound (64 MiB), checked while the buffer\n//       grows, so an oversize answer is never built in full\n//   -5  the worker is in use by another call (a worker serves one thread at\n//       a time; this call did nothing)\n//   -6  input over budget: more than kMaxInputBytes (4 MiB) of source; *out\n//       holds \"input <measured> <bound>\" (J5, known-gaps row 59), decided\n//       before any ANTLR object exists\n//   -7  nesting or work over budget: a guard inside recognition refused;\n//       *out holds \"nesting <measured> <bound> <kind>\", kind \"rule\" or\n//       \"lookahead\", or \"work <measured> <bound>\" (J5c, known-gaps rows 60-61)\n// A -7 is thrown out of recognition before any buffer is built, so no partial\n// answer can escape; the lexer, parser and tree are destroyed with the call.\n//\n// THE BUDGET (J5b, docs/design/yin.repl-jolt-implementation.md §7.6). Stack\n// exhaustion is uncatchable, so the nesting that costs native stack is\n// measured where it happens, by the parser itself, and refused before it can\n// exhaust the parse thread's stack:\n//\n//   rule       BoundedParser counts the rule frames live on the native stack\n//              (every generated rule function enters through the virtual\n//              Parser::enterRule or enterRecursionRule, Parser.h:273-290,\n//              Python3Parser.cpp:8438/:8879). Parser::exitRule is not virtual\n//              (Parser.h:275), so the count is not a counter decremented on\n//              exit: the frame depth is the length of the current context's\n//              parent chain, which equals the live rule activations because\n//              each activation contributes exactly one context to the chain\n//              at all times (a left-recursive loop replaces its frame's\n//              context and reparents the previous one beneath it; unrolling\n//              restores the caller's). The generated parser has no labelled\n//              alternatives. The depth is recorded per context at entry\n//              (its parent's plus one; a pushNewRecursionContext context\n//              inherits its frame's) rather than walked, which measured up\n//              to 2x slower at the bounds. Entering a frame deeper than\n//              kMaxRule refuses.\n//   lookahead  BoundedSimulator bounds prediction's own recursion\n//              (closureCheckingStopState pops, PredictionContext merge,\n//              equality, caching and destruction all recurse over context\n//              chains, ParserATNSimulator.cpp:851-900): on every RULE\n//              transition of a closure (getEpsilonTarget,\n//              ParserATNSimulator.h:788) the chain the transition makes, the\n//              longest parent path of config->context plus one, must not pass\n//              kMaxLook in SLL prediction, or the outer context's length plus\n//              kMaxFull in full-LL prediction (whose start state is the outer\n//              rule stack, computeStartState). The walk is memoized for the\n//              prediction, so flat input pays nothing. A prediction whose\n//              context graph exceeds 4x the bound in distinct nodes also\n//              refuses (a cap, not an undercount; not reached on the oracle\n//              corpus). A full-LL refusal throws out of the reach\n//              computation, whose caller (execATNWithFullContext) holds its\n//              previous reach set as a raw pointer freed on the normal and\n//              no-viable-alt exits only; BoundedSimulator's reach-computation\n//              override frees it on the exception exit too (J5c, the\n//              known-gaps reach-set leak row).\n//\n// The refusal (NestingRefused) derives from no exception class: the generated\n// rule bodies catch only RecognitionException (Python3Parser.cpp:762), so it\n// unwinds every rule frame, whose RAII finally (support/CPPUtils.h:23) runs\n// exitRule/unrollRecursionContexts, and adaptivePredict's, which restores the\n// input. Nothing the guards override runs during that unwinding.\n//\n// WORK (J5c, known-gaps rows 60-61). The nesting guards bound stack, not\n// time: an input under every nesting bound can still walk an adversarial\n// ambiguity for unbounded time (a flat `1+` chain parses quadratically, an\n// SLL lookahead over a `1*` chain faster still). The work guard makes the\n// parse's cost a function of its source: one counter charged at the three\n// units of recognition — every rule entry (BoundedParser::enter_frame),\n// every closure epsilon step (BoundedSimulator::getEpsilonTarget, the reach\n// computation's inner loop) and every consumed token (BoundedTokens, its\n// own or a prediction's lookahead walk) — refused past kMaxWork with the\n// same -7 as the nesting guards, message \"work <measured> <bound>\". The\n// token unit carries the quadratic: prediction's DFA walk does not accept\n// until its statement ends (precedence predicates resolve only there), so a\n// flat chain's every loop decision re-consumes the rest of the statement —\n// measured 64,024,002 consumptions for a 16,002-token 8,000-operator\n// chain; the closure unit carries the `1*` SLL walk. No unit throws inside\n// a full-context prediction (see charge_work); the bound is checked again\n","exit_code":0,"status":"completed"}}
