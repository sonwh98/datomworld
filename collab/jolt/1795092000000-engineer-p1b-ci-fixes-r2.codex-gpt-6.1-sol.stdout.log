{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' host/gambit/ffi/ffi-harness.ss; sed -n '480,557p' host/gambit/scheme-adapter-runtime.ss; cat host/gambit/unbound-check.ss; cat host/gambit/gen-boot.ss | head -60; cat host/chez/dead-host-check.sh; sed -n '1971,2000p' Makefile; /Library/Developer/CommandLineTools/usr/bin/git log -3 --oneline\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,110p' host/gambit/ffi/ffi-harness.ss; sed -n '480,557p' host/gambit/scheme-adapter-runtime.ss; cat host/gambit/unbound-check.ss; cat host/gambit/gen-boot.ss | head -60; cat host/chez/dead-host-check.sh; sed -n '1971,2000p' Makefile; /Library/Developer/CommandLineTools/usr/bin/git log -3 --oneline\"","aggregated_output":";; ffi-harness.ss — shared harness for the gambitffi* stage-1 gates.\n;;\n;; ##include-spliced by each gate script (same-unit rule as gambitcheck: the\n;; prelude's shims and the adapter's macros must expand in THIS unit). The\n;; bridge and fixture libraries are built by the Makefile BEFORE the gate runs\n;; (a c-lambda is a compiled facility; nothing here compiles anything). A\n;; missing artifact is a FAILED gate — fail-closed, never a skip.\n\n(##include \"../prelude-shims.ss\")\n(##include \"../scheme-adapter-runtime.ss\")\n\n(define ffi-failures 0)\n(define ffi-checks 0)\n\n(define (ffi-check label actual expected)\n  (set! ffi-checks (+ ffi-checks 1))\n  (if (equal? actual expected)\n      (begin (printf \"  ok     ~a\\n\" label) #t)\n      (begin (printf \"  FAIL   ~a: got ~s expected ~s\\n\" label actual expected)\n             (set! ffi-failures (+ ffi-failures 1))\n             #f)))\n\n(define (ffi-check-true label v)\n  (ffi-check label (if v #t #f) #t))\n\n(define (ffi-check-raise-message label thunk expected-msg)\n  (set! ffi-checks (+ ffi-checks 1))\n  (let ((m (guard (e (#t (condition-message e)))\n             (thunk)\n             \"NO-RAISE\")))\n    (if (string-contains m expected-msg)\n        (begin (printf \"  ok     ~a -> ~a\\n\" label m) #t)\n        (begin (printf \"  FAIL   ~a: got ~s expected message containing ~s\\n\"\n                       label m expected-msg)\n               (set! ffi-failures (+ ffi-failures 1))\n               #f))))\n\n(define (ffi-check-raise-exact label thunk expected-msg)\n  (set! ffi-checks (+ ffi-checks 1))\n  (let ((m (guard (e (#t (condition-message e)))\n             (thunk)\n             \"NO-RAISE\")))\n    (if (string=? m expected-msg)\n        (begin (printf \"  ok     ~a -> ~a\\n\" label m) #t)\n        (begin (printf \"  FAIL   ~a: got ~s expected exactly ~s\\n\"\n                       label m expected-msg)\n               (set! ffi-failures (+ ffi-failures 1))\n               #f))))\n\n(define (string-contains s sub)\n  (let ((n (string-length s)) (m (string-length sub)))\n    (let loop ((i 0))\n      (cond ((> m (- n i)) #f)\n            ((string=? (substring s i (+ i m)) sub) #t)\n            (else (loop (+ i 1)))))))\n\n;; the fixture library, built into build/gambit-ffi by the Makefile target\n(define ffi-fixture-path \"build/gambit-ffi/libjoltffi-fixture.dylib\")\n(define ffi-fixture2-path \"build/gambit-ffi/libjoltffi-fixture2.dylib\")\n\n;; Selected by the same Makefile OS branch as the fixture link flags. Keep the\n;; two supported names explicit; do not guess an accessor on another host.\n(define (ffi-errno-accessor-name)\n  (let ((name (getenv \"JOLT_FFI_ERRNO_ACCESSOR\")))\n    (if (and name (or (string=? name \"__error\")\n                      (string=? name \"__errno_location\")))\n        name\n        (error 'gambitffi-abi \"missing/unsupported errno accessor selection; run make gambitffi-abi\"))))\n\n;; every gate starts here: the qualified tier is the adapter + the bridge, so\n;; the bridge MUST load (fail-closed when absent — that IS the assertion)\n(define (ffi-load-fixture!)\n  (sa-load-shared-object ffi-fixture-path))\n\n(define (ffi-gate-finish name)\n  (printf \"\\n~a: ~a check(s), ~a failure(s)\\n\" name ffi-checks ffi-failures)\n  (if (= ffi-failures 0)\n      (begin (printf \"~a: PASS\\n\" name) (exit 0))\n      (begin (printf \"~a: FAILED\\n\" name) (exit 1))))\n;; the full signature in the message — before any address is resolved or\n;; dereferenced (astra: \"unregistered shapes must raise\", never an unbound\n;; Chez identifier).\n\n(define (joltffi-sig-string argtypes res)\n  (string-append \"(\"\n                 (let loop ((ts argtypes) (first #t) (acc \"\"))\n                   (if (null? ts)\n                       acc\n                       (loop (cdr ts) #f\n                             (string-append acc (if first \"\" \" \")\n                                            (symbol->string (car ts))))))\n                 \") -> \" (symbol->string res)))\n\n(define (joltffi-unregistered-raise who argtypes res)\n  (error who\n         (string-append \"jolt.ffi: no gambit shim for signature \"\n                        (joltffi-sig-string argtypes res)\n                        \" — unregistered shape on the gambit target\"\n                        \" (the stage-1 registry covers the non-blocking p1b-inv\"\n                        \" shapes only; see p1b-inv/shim-registry.edn)\")))\n\n;; argument-type sanity for anything the shim set cannot carry: :string\n;; arguments (emitted as u8*) need an immobile copy, which Gambit cannot\n;; provide (moving collector, no immobile allocation) — refused with a\n;; message-carrying error, and never a registered shape.\n(define (joltffi-check-argtypes! who argtypes)\n  (for-each\n   (lambda (t)\n     (if (or (eq? t 'string) (eq? t 'u8*))\n         (error who\n                (string-append\n                 \"jolt.ffi: :string arguments are unsupported on the gambit target\"\n                 \" — no immobile allocation behind the stage-1 bridge (signature: \"\n                 (symbol->string t) \" argument)\"))))\n   argtypes))\n\n;; ret-type sanity: by-value aggregates and the (& ftype) destination convention\n;; are Chez ftype facilities the stage-1 registry does not carry (the compiler's\n;; :gambit arm refuses them earlier; this is the defensive layer behind it).\n(define (joltffi-check-ret! who res)\n  (if (pair? res)\n      (error who\n             (string-append \"jolt.ffi: aggregate results are unsupported on the\"\n                            \" gambit target — no ftype engine behind the stage-1\"\n                            \" bridge (result: (& ...))\"))))\n\n;; C -> jolt at the ADAPTER level: raw values only. The compiler's emitted\n;; wrapper applies the jolt-level conversions on top (jolt-ffi-c->string maps a\n;; NULL string's #f to jolt-nil; jolt-ffi-c->bool folds the one-byte pattern;\n;; make-jfloat boxes a :float). No jolt-nil dependency here — this tier also\n;; loads under gambitcheck, where the kernel (values.ss) is not booted.\n(define (joltffi-convert-ret res v) v)\n\n;; (joltffi-foreign-procedure argtypes res name) -> procedure\n;; ARGTYPES/RES: the Chez foreign-type tokens the compiler emits (symbols).\n;; NAME: a string (by-name, resolved lazily on first call through the process's\n;; global symbols — the emitter's fallback) or an ADDRESS (the scoped branch:\n;; jolt-ffi-dlsym-native already resolved a declared native). The shim is\n;; selected from the bridge registry by (argtypes ret); the resolved address is\n;; its first argument, exactly astra §2's \"typed, generated C shims per call\n;; shape, shared across symbols with identical ABI shapes\".\n(define (joltffi-foreign-procedure argtypes res name variadic)\n  (joltffi-ensure-bridge! 'sa-foreign-procedure)\n  (joltffi-check-argtypes! 'sa-foreign-procedure argtypes)\n  (joltffi-check-ret! 'sa-foreign-procedure res)\n  (let ((wrapper (joltffi-shim-lookup argtypes res #f variadic)))\n    (if (not wrapper)\n        (joltffi-unregistered-raise 'sa-foreign-procedure argtypes res)\n        (if (string? name)\n            ;; by-name: resolve lazily on first call and cache, like the Chez\n            ;; emitter's (or p ...) first-call binding caches its resolution\n            (let ((addr #f) (resolved? #f))\n              (lambda args\n                (if (not resolved?)\n                    (begin (set! addr (or (joltffi-dlsym-loaded name) (joltffi-resolve-global name 'sa-foreign-procedure)))\n                           (set! resolved? #t)))\n                (apply wrapper addr args)))\n;; unbound-check.ss — every Scheme global the Gambit boot references is defined.\n;;\n;; The boot ##include-splices most of host/chez, and a Chez-side name that\n;; reaches a shared file is an UNBOUND GLOBAL on Gambit: nothing fails at load,\n;; the first call raises \"Unbound variable: x\" with no jolt context, and — the\n;; part this gate exists for — nothing in the Chez suite can see it. mirrordrift\n;; compares procedures defined in BOTH rt.ss and rt-core.ss, so a NEW name (a\n;; parameter host-contract.ss started reading, an R6RS list op a shared file\n;; picked up) is invisible to it. `make gambiteval` had every row failing for\n;; two weeks that way (jolt-cw2p).\n;;\n;; The oracle is Gambit's own linker: `gsc -warnings -link` reports every global\n;; referenced by the compiled unit and defined nowhere, after full macro\n;; expansion — exact, with no free-variable analysis of our own to get wrong.\n;; unbound-check.sh runs the compile and link and hands this script the link\n;; log. Two things the linker cannot know are folded in here:\n;;\n;;   - a record's constructor/predicate/accessors come from the shim's\n;;     define-record-type translator (prelude-shims.ss), which EVALS them into\n;;     the interaction environment at boot, so the compiler never sees a\n;;     define for them. Derived here from every define-record-type form in the\n;;     booted manifest, by the translator's own naming rule.\n;;   - an uninterned #:gN name is never a missing definition. It is the mark of\n;;     Gambit's case-lambda expander dropping the rest parameter of a two-clause\n;;     (fixed n / variadic n) fn (backend_scheme.clj emit-fn has the story), and\n;;     it always fails: the fix is the emitter's merge, never an allowlist line.\n;;\n;; What is left is compared against host/gambit/unbound-allowlist.txt: names\n;; referenced from paths this target never takes (the excluded java/ tree's\n;; helpers behind capability checks, gsi runtime internals the js link file\n;; does not carry). Like the portability allowlist, the list only shrinks\n;; truthfully — a line whose name is now defined is STALE and fails the gate.\n;;\n;; Modes:\n;;   <link-log>            gate — exit 1 on an unallowlisted name, a stale line,\n;;                         or a #:gN name\n;;   <link-log> --regen    rewrite the allowlist: comments and still-valid lines\n;;                         kept in place, stale lines dropped, new names appended\n;;   <link-log> --list     print every unbound name and how it was classified\n(import (chezscheme))\n(include \"host/chez/gate-scan-lib.ss\")\n\n(define allowlist-path \"host/gambit/unbound-allowlist.txt\")\n(define boot-path \"host/gambit/boot-full.ss\")\n\n;; ---- the linker's report ----------------------------------------------------\n;; Two lines per warning:\n;;   *** WARNING -- \"NAME\" is not defined,\n;;   ***            referenced in: (\"FILE\" ...)\n;; A reference from the Gambit runtime library itself (_gambit.js names a few of\n;; its own internals the js link file does not carry) is Gambit's business, not\n;; the boot's: only a reference from the compiled boot counts.\n(define (quoted-strings line)\n  (let ((n (string-length line)))\n    (let loop ((i 0) (acc '()))\n      (cond ((>= i n) (reverse acc))\n            ((char=? (string-ref line i) #\\\")\n             (let scan ((j (+ i 1)))\n               (cond ((>= j n) (reverse acc))\n                     ((char=? (string-ref line j) #\\\")\n                      (loop (+ j 1) (cons (substring line (+ i 1) j) acc)))\n                     (else (scan (+ j 1))))))\n            (else (loop (+ i 1) acc))))))\n\n(define (runtime-library? path)\n  (gs-string-suffix? \"/_gambit.js\" path))\n\n(define (parse-link-log path)\n  (let ((lines (call-with-input-file path\n                 (lambda (p)\n                   (let loop ((acc '()))\n                     (let ((l (get-line p)))\n                       (if (eof-object? l) (reverse acc) (loop (cons l acc)))))))))\n    (let loop ((ls lines) (acc '()))\n      (cond\n        ((null? ls) (reverse acc))\n        ((and (gs-string-prefix? \"*** WARNING -- \" (car ls))\n              (gs-string-contains? (car ls) \"is not defined\")\n              (pair? (cdr ls))\n              (gs-string-contains? (cadr ls) \"referenced in:\"))\n         (let ((name (car (quoted-strings (car ls))))\n               (files (quoted-strings (cadr ls))))\n           (loop (cddr ls)\n                 (if (exists (lambda (f) (not (runtime-library? f))) files)\n                     (cons name acc)\n                     acc))))\n        (else (loop (cdr ls) acc))))))\n\n;; ---- the booted manifest ------------------------------------------------------\n;; boot-full.ss (generated by gen-boot.ss) ##includes every file of the boot,\n;; some of which ##include further (repl-main's boot-active, records-gambit's\n;; none). Followed here relative to the including file, like Gambit does.\n(define (includes-of path)\n  (let loop ((fs (gs-read-forms path)) (acc '()))\n    (if (null? fs)\n        (reverse acc)\n        (let ((d (car fs)))\n          (loop (cdr fs)\n                (if (and (pair? d) (eq? (car d) 'gambit-ns:include)\n                         (pair? (cdr d)) (string? (cadr d)))\n                    (cons (cadr d) acc)\n                    acc))))))\n\n(define (resolve-include from rel)\n  (let ((dir (path-parent from)))\n    (if (string=? dir \"\") rel (string-append dir \"/\" rel))))\n\n(define (manifest root)\n  (let walk ((p root))\n    (cons p (apply append (map (lambda (r) (walk (resolve-include p r))) (includes-of p))))))\n\n;; ---- names the record translator evals at boot --------------------------------\n;; make-jolt-record-type (prelude-shims.ss): make-<name> / <name>? unless the\n;; spec names them, <name>-<field> unless the field spec names its accessor, and\n;; a -set! mutator (named or derived) for a MUTABLE field only. The translator's\n;; own define-syntax is skipped: a template is not a definition.\n(define (record-names d)\n  (let* ((spec (cadr d))\n         (name (if (pair? spec) (car spec) spec))\n         (nstr (symbol->string name))\n         (ctor (if (pair? spec) (cadr spec) (string->symbol (string-append \"make-\" nstr))))\n         (pred (if (pair? spec) (caddr spec) (string->symbol (string-append nstr \"?\"))))\n         (fields (let ((c (assq 'fields (cddr d)))) (if c (cdr c) '()))))\n    (cons ctor\n          (cons pred\n                (apply append\n                       (map (lambda (fs)\n                              (let* ((kind (if (pair? fs) (car fs) 'immutable))\n                                     (f (if (pair? fs) (cadr fs) fs))\n                                     (acc (if (and (pair? fs) (pair? (cddr fs)))\n                                              (caddr fs)\n                                              (string->symbol (string-append nstr \"-\" (symbol->string f)))))\n                                     (setter (if (and (pair? fs) (pair? (cddr fs)) (pair? (cdddr fs)))\n                                                 (cadddr fs)\n                                                 (string->symbol (string-append (symbol->string acc) \"-set!\")))))\n                                (if (eq? kind 'mutable) (list acc setter) (list acc))))\n                            fields))))))\n\n(define (record-generated-names files)\n  (let ((h (make-hashtable string-hash string=?)))\n    (define (walk d)\n      (when (pair? d)\n        (cond\n          ((eq? (car d) 'define-syntax) #f)\n          ((and (eq? (car d) 'define-record-type) (pair? (cdr d)))\n           (for-each (lambda (s) (hashtable-set! h (symbol->string s) #t)) (record-names d)))\n          (else (let loop ((x d))\n                  (when (pair? x) (walk (car x)) (loop (cdr x))))))))\n    (for-each (lambda (f) (for-each walk (gs-read-forms f))) files)\n    h))\n\n;; ---- the allowlist --------------------------------------------------------------\n;; One name per line; a line starting with # is a comment and is kept where it\n;; is by --regen, so the classification a reader needs stays next to its names.\n(define (read-allowlist-lines)\n  (if (file-exists? allowlist-path)\n      (call-with-input-file allowlist-path\n        (lambda (p)\n          (let loop ((acc '()))\n            (let ((l (get-line p)))\n              (if (eof-object? l) (reverse acc) (loop (cons l acc)))))))\n      '()))\n\n(define (comment-line? l)\n  ;; \"#\" alone or \"# text\" — a name may start with ## (Gambit's own primitives)\n  (or (string=? l \"\")\n      (and (char=? (string-ref l 0) #\\#)\n           (or (= (string-length l) 1) (char=? (string-ref l 1) #\\space)))))\n\n(define (line-name l)\n  ;; the first whitespace-delimited token\n  (let loop ((i 0))\n    (if (or (= i (string-length l)) (memv (string-ref l i) '(#\\space #\\tab)))\n        (substring l 0 i)\n        (loop (+ i 1)))))\n\n(define (allowed-names lines)\n  (map line-name (filter (lambda (l) (not (comment-line? l))) lines)))\n\n(define header\n  '(\"# unbound-allowlist.txt — Scheme globals the Gambit boot references and DOES NOT\"\n    \"# define, each on a path this target never takes.\"\n    \"#\"\n    \"# One name per line, grouped under a comment that says why the group is\"\n    \"# unreachable here. host/gambit/unbound-check.ss (make gambitunbound) pins\"\n    \"# this against Gambit's own linker report over the full-profile boot: a name\"\n    \"# missing from this list fails the gate, and so does a line whose name has\"\n    \"# since been defined — the list only shrinks truthfully. `make\"\n    \"# gambitunbound-regen` keeps the comments and still-valid lines in place,\"\n    \"# drops stale lines and appends new names at the end for classification.\"\n    \"#\"\n    \"# A name here is a documented gap, not a free pass: reaching it raises\"\n    \"# \\\"Unbound variable\\\" with no jolt context. Binding it — a mirror in\"\n    \"# rt-core.ss, a shim in prelude-shims.ss, a raise naming the absent\"\n    \"# capability — is always better than a line here.\"))\n\n(define (write-allowlist! lines unbound)\n  (let* ((kept (filter (lambda (l) (or (comment-line? l) (member (line-name l) unbound)))\n                       lines))\n         (have (allowed-names kept))\n         (new (filter (lambda (n) (not (member n have))) unbound)))\n    (call-with-output-file allowlist-path\n      (lambda (p)\n        (if (null? lines)\n            (for-each (lambda (l) (display l p) (newline p)) header)\n            (for-each (lambda (l) (display l p) (newline p)) kept))\n        (when (pair? new)\n          (display \"#\\n# NEW since the last regen — classify each under a group above, or bind it.\\n\" p)\n          (for-each (lambda (n) (display n p) (newline p)) new)))\n      'truncate)\n    (values (length kept) (length new))))\n\n;; ---- main ------------------------------------------------------------------------\n(define (gensym-name? n)\n  (and (> (string-length n) 1)\n       (char=? (string-ref n 0) #\\g)\n       (let loop ((i 1))\n         (or (= i (string-length n))\n             (and (char-numeric? (string-ref n i)) (loop (+ i 1)))))))\n\n(define (main args)\n  (when (or (null? args) (gs-string-prefix? \"--\" (car args)))\n    (printf \"usage: unbound-check.ss <gsc-link-log> [--regen|--list]\\n\")\n    (exit 2))\n  (let* ((log-path (car args))\n         (flags (cdr args))\n         (reported (parse-link-log log-path))\n         (files (manifest boot-path))\n         (records (record-generated-names files))\n         (unbound (list-sort string<?\n                    (filter (lambda (n) (not (hashtable-ref records n #f))) reported)))\n         (gensyms (filter gensym-name? unbound))\n         (unbound (filter (lambda (n) (not (gensym-name? n))) unbound))\n         (lines (read-allowlist-lines))\n         (allow (allowed-names lines))\n         (unallowed (filter (lambda (n) (not (member n allow))) unbound))\n         (stale (filter (lambda (n) (not (member n unbound))) allow)))\n    (printf \"gambit unbound: ~a name(s) reported by the linker, ~a record-generated, ~a unbound\\n\"\n            (length reported) (- (length reported) (length unbound) (length gensyms)) (length unbound))\n    (cond\n      ((member \"--list\" flags)\n       (for-each (lambda (n)\n                   (printf \"  ~a~a\\n\" n (if (member n allow) \"  (allowlisted)\" \"\")))\n                 unbound)\n       (for-each (lambda (n) (printf \"  ~a  (uninterned: case-lambda expansion)\\n\" n)) gensyms)\n       (exit 0))\n      ((member \"--regen\" flags)\n       (let-values (((kept new) (write-allowlist! lines unbound)))\n         (printf \"gambit unbound: wrote ~a (~a line(s) kept, ~a new)\\n\" allowlist-path kept new))\n       (when (pair? gensyms)\n         (printf \"\\nNOT allowlisted — uninterned names from a case-lambda Gambit miscompiles:\\n\")\n         (for-each (lambda (n) (printf \"  ~a\\n\" n)) gensyms)\n         (exit 1))\n       (exit 0))\n      (else\n       (when (pair? unallowed)\n         (printf \"\\nUNBOUND — referenced by the boot, defined nowhere, and not allowlisted:\\n\")\n         (for-each (lambda (n) (printf \"  ~a\\n\" n)) unallowed)\n         (printf \"\\nBind each one (a mirror in host/gambit/rt-core.ss, a shim in prelude-shims.ss,\\n\")\n         (printf \"a named raise in host-vars.ss), or record a genuinely untaken path with\\n\")\n         (printf \"`make gambitunbound-regen` and classify it in ~a.\\n\" allowlist-path))\n       (when (pair? stale)\n         (printf \"\\nSTALE allowlist lines — these names are defined now. Drop them with\\n\")\n         (printf \"`make gambitunbound-regen`:\\n\")\n         (for-each (lambda (n) (printf \"  ~a\\n\" n)) stale))\n       (when (pair? gensyms)\n         (printf \"\\nUNINTERNED — a two-clause case-lambda (fixed n / variadic n) somewhere in the\\n\")\n         (printf \"boot: Gambit's expander drops its rest parameter (see emit-fn in\\n\")\n         (printf \"jolt-core/jolt/backend_scheme.clj). Emitted code takes the merged shape;\\n\")\n         (printf \"a hand-written one needs a third clause or a rest lambda:\\n\")\n         (for-each (lambda (n) (printf \"  ~a\\n\" n)) gensyms))\n       (if (or (pair? unallowed) (pair? stale) (pair? gensyms))\n           (exit 1)\n           (begin (printf \"gambit unbound: passed (~a allowlisted)\\n\" (length allow))\n                  (exit 0)))))))\n\n(main (cdr (command-line)))\n;; gen-boot.ss — write host/gambit/boot-<profile>.ss for a build profile.\n;;\n;; Run on CHEZ from the repo root (make gambitweb PROFILE=... does this):\n;;   chez --script host/gambit/gen-boot.ss repl\n;;\n;; Gambit resolves ##include at expansion time, so which files a build carries\n;; cannot be a runtime choice — the boot has to be generated. Same reasoning as\n;; the seed and records-gambit.ss: derive it on Chez, check nothing by hand.\n;;\n;; boot.ss owns the load order; profiles.ss says which of its files are optional\n;; and which profile keeps which groups. Excluded files are dropped from the\n;; include list, and every clojure.core name they define is bound to a raise\n;; naming the group — read out of the files themselves, so the error surface\n;; cannot drift from the code.\n\n(import (chezscheme))\n(print-brackets #f)\n\n(define args (command-line-arguments))\n(define profile-name\n  (if (null? args)\n      (begin (display \"usage: gen-boot.ss <profile>\\n\") (exit 1))\n      (string->symbol (car args))))\n\n(define (read-all f)\n  (with-input-from-file f\n    (lambda ()\n      (let loop ((acc '()))\n        (let ((x (read)))\n          (if (eof-object? x) (reverse acc) (loop (cons x acc))))))))\n\n;; ---- profiles.ss -----------------------------------------------------------\n\n(define spec (read-all \"host/gambit/profiles.ss\"))\n\n(define (section name)\n  (let loop ((fs spec))\n    (cond ((null? fs) (error 'gen-boot \"section missing from profiles.ss\" name))\n          ((and (pair? (car fs)) (eq? (caar fs) name)) (cdar fs))\n          (else (loop (cdr fs))))))\n\n(define group-specs (section 'groups))     ; (name label (file ...))\n(define profile-specs (section 'profiles)) ; (name (group ...))\n\n(define (profile-names) (map car profile-specs))\n\n(define kept-groups\n  (let loop ((ps profile-specs))\n    (cond ((null? ps)\n           (display \"gen-boot: unknown profile \")\n           (display profile-name)\n           (display \"; profiles.ss lists \")\n           (write (profile-names))\n           (newline)\n           (exit 1))\n          ((eq? (caar ps) profile-name) (cadar ps))\n          (else (loop (cdr ps))))))\n\n(define excluded-groups\n  (let loop ((gs group-specs) (acc '()))\n#!/bin/sh\n# dead-host-check.sh — dead host procedure gate wrapper (POSIX sh).\n#\n# Runs host/chez/dead-host-check.ss under the build's Chez. The checker collects\n# every top-level (define (name ...) ...) in the handwritten host files and\n# fails when one is referenced nowhere in the repo. Flags pass through:\n#   --list   print what it found without failing\n#\n# Chez resolution mirrors portability-check.sh: JOLT_CHEZ wins (the Makefile\n# hands down the interpreter it selected), then a PATH search.\nroot=\"$(CDPATH= cd -- \"$(dirname -- \"$0\")/../..\" && pwd)\"\ncd \"$root\" || exit 1\n\nif [ -z \"${JOLT_CHEZ:-}\" ]; then\n  for c in chez chezscheme; do\n    if command -v \"$c\" >/dev/null 2>&1; then\n      JOLT_CHEZ=\"$c\"\n      break\n    fi\n  done\n  if [ -z \"${JOLT_CHEZ:-}\" ]; then\n    echo \"dead host: no Chez Scheme executable found on PATH\" >&2\n    exit 1\n  fi\nfi\n\nexec \"$JOLT_CHEZ\" --script host/chez/dead-host-check.ss \"$@\"\n\t\tsh host/gambit/ffi/watchdog.sh 180 \"$(GAMBIT_GSI)\" host/gambit/eval-test.ss; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\n# Every Scheme global the full-profile boot references is defined — Gambit's\n# own linker report over the compiled boot, minus what the record translator\n# evals at runtime, against host/gambit/unbound-allowlist.txt (untaken paths;\n# a stale line fails). The boot splices most of host/chez, so a Chez-side name\n# reaching a shared file is otherwise an unbound global no Chez gate can see;\n# mirrordrift only compares names defined on BOTH hosts. ~75s: it compiles the\n# seed to js (text only, no C compiler, no node). Detection-gated. Ordered\n# after gambitboot: both regenerate boot-full.ss, and under -j a reader must\n# not open the file mid-rewrite.\ngambitunbound: gambitboot\n\t@if [ -x \"$(GAMBIT_GSC)\" ]; then \\\n\t\tJOLT_GSC=\"$(GAMBIT_GSC)\" sh host/gambit/unbound-check.sh; \\\n\telse \\\n\t\t$(GAMBIT-SKIP); \\\n\tfi\n\ngambitunbound-regen:\n\t@JOLT_GSC=\"$(GAMBIT_GSC)\" sh host/gambit/unbound-check.sh --regen\n\n# The jolt half of the same question: every var cell the boot interned is\n# bound. Emitted code reaches a var through its cell, so after the boot the\n# var table holds every var the seed and the compiler image reference — an\n# unbound root is a reference nothing this boot defines (clojure.core/\n# chunk-first, bound by the excluded natives-array.ss, is how every `defn`\n# died). Against host/gambit/unbound-vars-allowlist.txt; a stale line fails.\nf1a5c9f3 p1b-ci: guard emitted FFI heads and record per-install toolchain provenance\n3ecd20cc p1b-linux-r3: select and verify the platform errno accessor\n434dc2f9 p1b-linux-r2: select fixture shared-library flags by platform\n","exit_code":0,"status":"completed"}}
