[_file _offset] (refuse-blocking))\n(defn read-bytes [_file _offset _size] (refuse-blocking))\n(defn truncate! [_file _size] (refuse-blocking))\n(defn append-frame! [_file _frame] (refuse-blocking))\n(defn sync! [_file] (refuse-blocking))\n(defn close! [_file] (refuse-blocking))\n(defn lock-file! [_path] (refuse-blocking))\n(defn realpath [_path] (refuse-blocking))\n(defn read-bounded [_path _limit] (refuse-blocking))\n(defn read-all [_path] (refuse-blocking))\n(defn write-new-synced! [_path _bytes] (refuse-blocking))\n(defn rename! [_from _to] (refuse-blocking))\n(defn sync-dir! [_path] (refuse-blocking))\nEOF\ncat > host/gambit/yin/yang/antlr/cst.jolt <<'\"'EOF'\n(ns yang.antlr.cst\n  \\\"The C++ parser requires a blocking foreign call on Jolt. The standard\n   frontend catalog leaves that parser out of a Gambit session.\\\")\n\n(defn available? [] false)\n\n(defn- unavailable []\n  (throw (ex-info \\\"unavailable-parser: Gambit has no qualified blocking FFI\\\"\n                  {:diagnostic :unavailable-parser})))\n\n(defn rule-names [] (unavailable))\n(defn make-worker [_profile] (unavailable))\n(defn close-worker [_worker] (unavailable))\n(defn first-failure [_worker _source] (unavailable))\n(defn parse-transform [_worker] (unavailable))\n(defn parse-unit [_worker _unit _source] (unavailable))\nEOF\ncat > host/gambit/yin/yin/repl/host.jolt <<'EOF'\n(ns yin.repl.host\n  \\\"Host adapter for a local Gambit terminal session.\\\")\n\n(defn- unavailable [& _]\n  (throw (ex-info \\\"WebSocket transport is unavailable in the local Gambit session\\\"\n                  {:kind :unsupported-host})))\n\n(defn websocket []\n  {:connect\"'! unavailable\n   :bind! unavailable\n   :unbind! unavailable\n   :close-host! (fn [] nil)})\nEOF\ncat > host/gambit/yin/dao/stream/waitset/driver.jolt <<'\"'EOF'\n(ns dao.stream.waitset.driver\n  \\\"The local Gambit owner waits on the Scheme input port or its cadence timer.\\\"\n  (:require [jolt.scheme :as scheme]))\n\n(def \"'^:priva