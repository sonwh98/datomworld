{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"ls licenses\ncat > host/gambit/gen-unicode-nfc.py <<'EOF'\n#\"'!/usr/bin/env python3\n\"\"\"Emit Gambit'\"'s canonical normalization tables using Python's Unicode 16.0 data.\\\"\\\"\\\"\nimport unicodedata as u\n\nif u.unidata_version \"'!= \"16.0.0\":\n    raise SystemExit(f\"Unicode 16.0.0 required, found {u.unidata_version}\")\n\ndecompositions = []\ncompositions = []\nclasses = []\nfor cp in range(0x110000):\n    char = chr(cp)\n    combining_class = u.combining(char)\n    if combining_class:\n        classes.append(f\"({cp} . {combining_class})\")\n    mapping = u.decomposition(char)\n    if mapping and not mapping.startswith(\"<\"):\n        parts = [int(part, 16) for part in mapping.split()]\n        decompositions.append(f\"({cp} {'\"' '.join(map(str, parts))})\\\")\n        if len(parts) == 2 and u.normalize(\\\"NFC\\\", \\\"\\\".join(map(chr, parts))) == char:\n            key = parts[0] * 0x110000 + parts[1]\n            compositions.append(f\\\"({key} . {cp})\\\")\n\nprint(\\\";; Unicode 16.0.0 canonical normalization data.\\\")\nprint(\\\";; Generated by gen-unicode-nfc.py. See licenses/Unicode-DFS-2016.txt.\\\")\nfor name, rows in ((\\\"nfc-classes\\\", classes),\n                   (\\\"nfc-decompositions\\\", decompositions),\n                   (\\\"nfc-compositions\\\", compositions)):\n    print(f\\\"(define {name}\\\")\n    print(\\\"  (list->table '(\\\")\n    for offset in range(0, len(rows), 4):\n        print(\\\"    \\\" + \\\" \\\".join(rows[offset:offset + 4]))\n    print(\\\"  ) test: eqv?))\\\")\nEOF\n\\\"\"'$HOME/.local/bin/python3.14\" host/gambit/gen-unicode-nfc.py > host/gambit/unicode-nfc-data.ss\ncat > host/gambit/unicode-nfc.ss <<'\"'EOF'\n;; Unicode 16.0 NFC for Scheme scalar strings. Decompose canonically,\n;; stably order each sequence of combining marks, then compose where\n;; the intervening classes permit. Hangul has algorithmic mappings.\n(##include \\\"unicode-nfc-data.ss\\\")\n\n(define (nfc-class cp)\n  (table-ref nfc-classes cp 0))\n\n(define (nfc-decompose cp tail)\n  (cond\n    ((<= #xac00 cp #xd7a3)\n     (let* ((s (- cp #xac00))\n            (l (+ #x1100 (quotient s 588)))\n            (v (+ #x1161 (quotient (modulo s 588) 28)))\n            (t (modulo s 28)))\n       (cons l (cons v (if (= t 0) tail (cons (+ #x11a7 t) tail))))))\n    ((table-ref nfc-decompositions cp #f)\n     => (lambda (parts) (fold-right nfc-decompose tail parts)))\n    (else (cons cp tail))))\n\n(define (nfc-compose-pair a b)\n  (cond\n    ((and (<= #x1100 a #x1112) (<= #x1161 b #x1175))\n     (+ #xac00 (* (- a #x1100) 588) (* (- b #x1161) 28)))\n    ((and (<= #xac00 a #xd7a3) (zero? (modulo (- a #xac00) 28))\n          (<= #x11a8 b #x11c2))\n     (+ a (- b #x11a7)))\n    (else (table-ref nfc-compositions (+ (* a #x110000) b) #f))))\n\n(define (nfc-order cps)\n  ;; The loop works right to left so equal-class marks reach the stable\n  ;; sort in their original order. Each starter ends the preceding run.\n  (define (flush marks tail)\n    (append (list-sort (lambda (a b) (< (nfc-class a) (nfc-class b))) marks)\n            tail))\n  (let loop ((rest (reverse cps)) (marks '()) (tail '()))\n    (if (null? rest)\n        (flush marks tail)\n        (let ((cp (car rest)))\n          (if (zero? (nfc-class cp))\n              (loop (cdr rest) '() (cons cp (flush marks tail)))\n              (loop (cdr rest) (cons cp marks) tail))))))\n\n(define (string-normalize-nfc s)\n  (let* ((n (string-length s))\n         (decomposed\n           (let loop ((i (- n 1)) (tail '()))\n             (if (< i 0) tail\n                 (loop (- i 1) (nfc-decompose (char->integer (string-ref s i)) tail)))))\n         (out (make-string (length decomposed))))\n    (let loop ((rest (nfc-order decomposed)) (i 0) (starter #f) (last-class 0))\n      (if (null? rest)\n          (substring out 0 i)\n          (let* ((cp (car rest))\n                 (class (nfc-class cp))\n                 (combined (and starter\n                                (or (zero? last-class) (< last-class class))\n                                (nfc-compose-pair (char->integer (string-ref out starter)) cp))))\n            (if combined\n                (begin\n                  (string-set\"'! out starter (integer->char combined))\n                  (loop (cdr rest) i starter last-class))\n                (begin\n                  (string-set! out i (integer->char cp))\n                  (loop (cdr rest) (+ i 1) (if (zero? class) i starter) class))))))))\nEOF\nrg -n '\"'Unicode|unicode' licenses NOTICE | head -15\nrg -n '\"'^'\"\\\\(define.*fold-right' host/gambit/prelude-shims.ss\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
