{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,245p' ../datomworld/src/jolt/dao/host/hash.jolt; sed -n '1,220p' ../datomworld/src/jolt/dao/host/text.jolt; rg -n 'jolt|Gambit' ../datomworld/src/cljc/yin/repl/main.cljc | tail -35\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat host/gambit/yin-repl-main.ss host/gambit/source-loader.ss; cat stdlib/jolt/scheme.clj | head -170; cat test/gambit/unit.edn | head -36'","aggregated_output":"#!/usr/bin/env gsi-script\n;; Native source launcher for the real Yin REPL. Run from the Jolt root with\n;; gsi host/gambit/yin-repl-main.ss /path/to/datomworld [Yin arguments...].\n(##include \"boot.ss\")\n(##include \"host-apply.ss\")\n(##include \"source-loader.ss\")\n\n(let ((args (cdr (command-line))))\n  (unless (pair? args)\n    (display \"usage: yin-repl-main.ss DATOMWORLD_ROOT [Yin arguments...]\\n\" (current-error-port))\n    (exit 2))\n  (let ((root (path-expand (car args)))\n        (jolt-root (current-directory)))\n    (unless (file-exists? (path-expand \"src/cljc/yin/repl/main.cljc\" root))\n      (fprintf (current-error-port) \"yin.repl: no source entry under ~a\\n\" root)\n      (exit 2))\n    (with-exception-catcher\n      (lambda (e)\n        (let* ((value (jolt-unwrap-throw e))\n               (message (jolt-throwable-message value)))\n          (fprintf (current-error-port) \"yin.repl startup failed: ~a\\n\"\n                   (if (string? message) message (jolt-pr-readable value)))\n          (exit 1)))\n      (lambda ()\n        ;; Cache the qualified bridge before resolving Yin's paths relative to\n        ;; its own checkout. The source loader itself uses absolute roots.\n        (joltffi-ensure-bridge! 'yin.repl)\n        (let ((load-ns\n                (gambit-install-source-loader!\n                  (list (list (path-expand \"src/jolt\" root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"src/cljc\" root) \".cljc\" \".clj\")\n                        (list (path-expand \"src/clj\" root) \".clj\")\n                        (list (path-expand \"stdlib\" jolt-root) \".jolt\" \".cljc\" \".clj\")\n                        (list (path-expand \"jolt-core\" jolt-root) \".cljc\" \".clj\"))\n                  '(\"clojure.core\"))))\n          (parameterize ((current-directory root))\n            (load-ns \"yin.repl.main\" #f)\n            (let ((main (var-deref \"yin.repl.main\" \"-main\")))\n              (unless (procedure? main)\n                (error \"yin.repl.main/-main did not load\"))\n              (apply jolt-invoke main (cdr args)))))))))\n;; Opt-in native source namespace loading for embedded applications. Unlike the\n;; Chez loader, this only interprets source. It has no cache, FASL, AOT, runtime\n;; dependency discovery, or native-library discovery.\n\n(define (gambit-namespace-path name)\n  (let ((chars (string->list name)))\n    (let check ((rest chars) (need-name? #t))\n      (unless (cond\n                ((null? rest) (not need-name?))\n                ((char=? (car rest) #\\.) (and (not need-name?) (check (cdr rest) #t)))\n                ((or (char-alphabetic? (car rest)) (char-numeric? (car rest))\n                     (memv (car rest) '(#\\- #\\_)))\n                 (check (cdr rest) #f))\n                (else #f))\n        (throw-jvm 'IllegalArgumentException (string-append \"Invalid namespace: \" name))))\n    (list->string\n      (map (lambda (ch) (case ch ((#\\.) #\\/) ((#\\-) #\\_) (else ch))) chars))))\n\n;; Each root is (directory suffix ...), in classpath order. BOOTED names denote\n;; whole namespaces supplied by the embedding host and take precedence over\n;; files. A mere intern or :as-alias never satisfies a source dependency.\n(define (gambit-install-source-loader! roots booted)\n  (define loaded (make-table test: string=?))\n  (define (find-file name)\n    (let ((base (gambit-namespace-path name)))\n      (let find-root ((rest roots))\n        (and (pair? rest)\n             (let find-suffix ((suffixes (cdar rest)))\n               (if (null? suffixes)\n                   (find-root (cdr rest))\n                   (let ((file (string-append (caar rest) \"/\" base (car suffixes))))\n                     (if (and (file-exists? file) (eq? 'regular (file-type file)))\n                         file\n                         (find-suffix (cdr suffixes))))))))))\n  (define (load-namespace name force?)\n    (when force?\n      (throw-jvm 'UnsupportedOperationException\n                 \"namespace reload is unsupported on the gambit source loader\"))\n    (unless (member name booted)\n      (case (table-ref loaded name #f)\n        ((ready) #f)\n        ((loading)\n         (throw-jvm 'IllegalStateException (string-append \"Cyclic namespace load: \" name)))\n        ((failed)\n         (throw-jvm 'IllegalStateException (string-append \"Earlier namespace load failed: \" name)))\n        (else\n         (let ((file (find-file name)))\n           (unless file\n             (throw-jvm 'FileNotFoundException (string-append \"No source for namespace: \" name)))\n           (table-set! loaded name 'loading)\n           (guard (e (#t (table-set! loaded name 'failed) (raise e)))\n             (jolt-with-ns-bound\n               (lambda ()\n                 (jolt-eval-string (call-with-input-file file gambit-read-all) file)\n                 (unless (string=? name (chez-current-ns))\n                   (throw-jvm 'IllegalStateException\n                              (string-append file \": expected namespace \" name)))))\n             (table-set! loaded name 'ready)))))))\n  (set-ns-load-target! load-namespace)\n  (set-ns-with-load-opts!\n    (lambda (flags proceed)\n      (unless (null? flags)\n        (throw-jvm 'UnsupportedOperationException\n                   (string-append \"require option is unsupported on the gambit source loader: :\"\n                                  (car flags))))\n      (proceed #f)))\n  (def-var! \"clojure.core\" \"require\" jolt-require)\n  (def-var! \"clojure.core\" \"use\" jolt-use)\n  load-namespace)\n;; jolt.scheme — the Scheme escape hatch. The portable interop layers (the\n;; Java-shaped shims, jolt.ffi for C, the curated jolt.host seams) cover what\n;; libraries need; this namespace is the level under them: call a host Scheme\n;; procedure by name, or evaluate Scheme text, from any jolt program.\n;;\n;; The contract is RAW — no marshaling layer. Numbers, strings, booleans and\n;; characters are the same representations on both sides and cross untouched;\n;; everything else crosses as whatever it is on the other side. A Scheme\n;; vector arriving in jolt is an opaque host value (hand it back to Scheme to\n;; use it); a jolt collection handed to Scheme is jolt's representation, not a\n;; Scheme list; nil is jolt's nil, not '() and not #f.\n;;\n;; Two caveats. Code using this namespace is HOST-SPECIFIC by design — tied to\n;; the Chez runtime and its primitives, unlike everything else in the stdlib.\n;; And names resolve at RUN time, so a tree-shaken binary only finds what the\n;; kept runtime still carries: a shaken-out binding is a catchable\n;; \"no top-level Scheme binding\" error, never a silent nil.\n(ns jolt.scheme)\n\n(defn proc\n  \"The top-level Scheme procedure named by scheme-name (a string), as a\n  callable value. Resolved now; throws when the name is unbound.\"\n  [scheme-name]\n  (jolt.host/scheme-proc scheme-name))\n\n(defn call\n  \"Resolve the top-level Scheme procedure named by scheme-name and apply it\n  to args. Values cross raw — see the namespace docs.\"\n  [scheme-name & args]\n  (apply (jolt.host/scheme-proc scheme-name) args))\n\n(defn eval-string\n  \"Evaluate s as Scheme text — read with the SCHEME reader, not jolt's — and\n  return the last form's value. Definitions persist in the interaction\n  environment.\"\n  [s]\n  (jolt.host/scheme-eval-string s))\n\n(defmacro defsfn\n  \"Def name to the top-level Scheme procedure named by scheme-name:\n  (defsfn fx+ \\\"fx+\\\") then (fx+ 1 2). Resolution happens at load time.\"\n  [name scheme-name]\n  (list 'def name (list 'jolt.scheme/proc scheme-name)))\n\n;; --- (scheme ...): inline Scheme, do-shaped ----------------------------------\n;; The body is READ BY JOLT (the two syntaxes share the s-expression family),\n;; so Scheme spellings jolt's reader rejects are written in jolt spellings and\n;; rendered across: true/false -> #t/#f, \\\\A -> #\\\\A, [1 2 3] -> the datum\n;; vector #(1 2 3), nil -> jolt-nil (the runtime's nil value, a bound host\n;; global). Strings, numbers, and ratios print compatibly. Keywords, maps, and\n;; sets have no Scheme reading and are refused at macroexpansion. Reader sugar\n;; that expands to clojure.core calls (@x, syntax-quote) lands as unbound\n;; Scheme names — write (unquote ...) longhand or avoid it.\n\n(def ^:private scheme-char-names\n  {\\newline \"#\\\\newline\" \\space \"#\\\\space\" \\tab \"#\\\\tab\"\n   \\return \"#\\\\return\" \\backspace \"#\\\\backspace\" \\formfeed \"#\\\\page\"})\n\n(defn- form->scheme\n  \"Render a jolt-read form as Scheme source text. quoted? tracks whether f\n  sits inside (quote ...)/(quasiquote ...) — it decides only how a VECTOR\n  renders: #(...) is a datum, not an expression, in R6RS, so an expression\n  position gets (quote #(...)) and a datum position the bare literal.\n  (unquote ...) under quasiquote re-enters expression position.\"\n  ([f] (form->scheme f false))\n  ([f quoted?]\n   (cond\n     (true? f)    \"#t\"\n     (false? f)   \"#f\"\n     (nil? f)     \"jolt-nil\"\n     (symbol? f)  (str f)\n     (string? f)  (pr-str f)\n     (char? f)    (or (get scheme-char-names f) (str \"#\\\\\" f))\n     (number? f)  (pr-str f)\n     (vector? f)  (let [datum (str \"#(\" (apply str (interpose \" \" (map (fn [x] (form->scheme x true)) f))) \")\")]\n                    (if quoted? datum (str \"(quote \" datum \")\")))\n     (seq? f)\n     (let [head (first f)]\n       (cond\n         (and (not quoted?) (= 2 (count f)) (or (= head 'quote) (= head 'quasiquote)))\n         (str \"(\" head \" \" (form->scheme (second f) true) \")\")\n         (and quoted? (= 2 (count f)) (or (= head 'unquote) (= head 'unquote-splicing)))\n         (str \"(\" head \" \" (form->scheme (second f) false) \")\")\n         :else\n         (str \"(\" (apply str (interpose \" \" (map (fn [x] (form->scheme x quoted?)) f))) \")\")))\n     :else (throw (ex-info (str \"form has no Scheme rendering: \" (pr-str f)\n                                (when (keyword? f) \" (keywords are not Scheme syntax)\"))\n                           {:form f})))))\n\n(defmacro scheme\n  \"Inline Scheme. The body forms are rendered to Scheme source at\n  macroexpansion (see the spellings note above) and evaluated with the host's\n  eval — multiple forms behave like (begin ...), so a define splices into the\n  interaction environment and the LAST form's value is returned, as with do.\n  Values cross on this namespace's raw contract.\"\n  [& forms]\n  (if (empty? forms)\n    nil\n    (list 'jolt.scheme/eval-string (form->scheme (cons 'begin forms)))))\n[\n {:suite :core-bytes\n  :label \"bytes? recognizes byte arrays only\"\n  :expr \"[(bytes? (byte-array 0)) (bytes? (byte-array [1])) (array? (byte-array 1)) (bytes? nil) (bytes? [1]) (bytes? \\\"hi\\\") (bytes? 0)]\"\n  :expected \"[true true true false false false false]\"}\n {:suite :core-bytes\n  :label \"core array operations see signed elements\"\n  :expr \"(let [b (byte-array 4 [0 128 255]) s (seq b)] [(alength b) (aget b 1) (aget b 2) (aset b 3 (unchecked-byte 254)) (vec s)])\"\n  :expected \"[4 -128 -1 -2 [0 -128 -1 -2]]\"}\n {:suite :dao-host-bytes\n  :label \"unsigned reads and fresh slices\"\n  :expr \"(let [b (dao.host.bytes/from-vector [0 128 255]) s (dao.host.bytes/slice b 1 3) z (dao.host.bytes/alloc 2)] [(dao.host.bytes/bytes? b) (dao.host.bytes/bytes? []) (dao.host.bytes/length b) (dao.host.bytes/get b 2) (dao.host.bytes/set! b 1 42) (dao.host.bytes/to-vector b) (dao.host.bytes/to-vector s) (dao.host.bytes/equal? z (dao.host.bytes/from-vector [0 0]))])\"\n  :expected \"[true false 3 255 nil [0 42 255] [128 255] true]\"}\n {:suite :dao-host-bytes\n  :label \"overlap copies as memmove and refusal leaves the target intact\"\n  :expr \"(let [b (dao.host.bytes/from-vector [0 1 128 255]) snapshot #(dao.host.bytes/to-vector b)] [(dao.host.bytes/copy! b 0 b 1 3) (snapshot) (try (dao.host.bytes/copy! b 0 b 2 3) (catch Exception e (:dao.host/refusal (ex-data e)))) (try (dao.host.bytes/set! b 0 256) (catch Exception e (:dao.host/refusal (ex-data e)))) (snapshot) (dao.host.bytes/copy! b 1 b 0 3) (snapshot)])\"\n  :expected \"[nil [0 0 1 128] :out-of-range :out-of-range [0 0 1 128] nil [0 1 128 128]]\"}\n]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,245p' ../datomworld/src/jolt/dao/host/hash.jolt; sed -n '1,220p' ../datomworld/src/jolt/dao/host/text.jolt; rg -n 'jolt|Gambit' ../datomworld/src/cljc/yin/repl/main.cljc | tail -35\"","aggregated_output":"(ns dao.host.hash\n  \"The jolt override of src/cljc/dao/host/hash.cljc (the :jolt alias puts\n   src/jolt first, docs/design/yin.repl-jolt-implementation.md §4.2, §6.2,\n   §6.3): the same public entries, arities, docstrings and refusal data\n   (docs/design/dao.stream.host-boundary.md §4.2, table A).\n\n   P entries (§2.4): `blake3-bytes` and `sha256-bytes`. They take host\n   bytes (jolt's byte array) and return fresh host bytes representing the\n   32-byte digest (256 bits). They leave their arguments unmodified.\n\n   Both are `:blocking` calls into native/jolt-crypto, which `bb\n   build:jolt-native` builds: BLAKE3 is the vendored upstream C reference,\n   SHA-256 the declared system libcrypto's EVP API. The input is copied into\n   caller-owned native memory (never a C string, so embedded NUL is data),\n   the digest is read back into a fresh jolt byte array, and the memory is\n   freed on every path: each native acquisition owns its own release,\n   established as soon as it is acquired (`with-native`), so a later\n   allocation or copy that fails still frees every earlier buffer, and each\n   free runs whether or not another failed.\n\n   Loading this namespace is the provenance gate (§6.3): it refuses, by\n   throwing, unless the wrapper writes this namespace's layout and reports\n   that every EVP entry resolved to exactly the library jolt-toolchain.edn\n   qualified for this platform (:native :libcrypto :qualified): the same\n   canonical real path (which the declared :path must also resolve to), the\n   same OpenSSL_version_num and the same file SHA-256, at no lower than\n   :min-version. An upgrade, a repointed link or a replaced file therefore\n   fails until requalified (the procedure is in jolt-toolchain.edn). No\n   digest is computed before that check passes; a missing library fails the\n   load.\n\n   String digesting is a table B portable composition over `dao.host.text`\n   and these byte primitives (`blake3`, `sha256`, `digest-string`,\n   `digest-bytes`), hosted in `dao.jing`.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.string :as str]\n    [dao.host.bytes :as bytes]\n    [jolt.ffi :as ffi]))\n\n\n;; =============================================================================\n;; The native library and its provenance\n;; =============================================================================\n\n(def ^:private platform\n  ;; as yang.antlr.cst decides it: jolt's os.name/os.arch shim can answer\n  ;; nil, which reads as Linux and x86_64\n  (let [os (str/lower-case (or (System/getProperty \"os.name\") \"\"))\n        arch (System/getProperty \"os.arch\")]\n    (str (if (str/includes? os \"mac\") \"darwin\" \"linux\") \"-\"\n         (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\"))))\n\n\n(def ^:private library\n  ;; the wrapper `bb build:jolt-native` builds, under the working directory\n  (str (System/getProperty \"user.dir\") \"/build/native/\" platform\n       \"/jolt-crypto/lib/libjolt_crypto\"\n       (if (str/starts-with? platform \"darwin\") \".dylib\" \".so\")))\n\n\n(def ^:private libcrypto-declaration\n  (get-in (edn/read-string (slurp (str (System/getProperty \"user.dir\")\n                                       \"/jolt-toolchain.edn\")))\n          [:native :libcrypto]))\n\n\n(ffi/load-library library)\n(ffi/defcfn ^:private c-layout-version \"jolt_crypto_layout_version\" [] :int)\n(ffi/defcfn ^:private c-provenance \"jolt_crypto_provenance\" [:pointer :size_t] :int)\n\n\n(ffi/defcfn ^:private c-blake3 \"jolt_crypto_blake3\"\n            [:pointer :size_t :pointer] :int :blocking)\n\n\n(ffi/defcfn ^:private c-sha256 \"jolt_crypto_sha256\"\n            [:pointer :size_t :pointer] :int :blocking)\n\n\n;; 3 (J2): the random entry joined the exported set (jolt_crypto_random for\n;; yin.vm.linker.sign/generate's :jolt arm); a J1b-built wrapper answers 2 and\n;; is refused here rather than at a missing-symbol error in the linker.\n;; 4 (J6c): jolt_crypto_sha1 joined it (dao.stream.ws.crypto) and EVP_sha1\n;; the provenance audit; a J2-built wrapper answers 3 and is refused here.\n(def ^:private layout 4)\n\n\n(defn- refuse-load\n  [message data]\n  (throw (ex-info (str \"jolt-crypto refused: \" message)\n                  (assoc data :library library))))\n\n\n(when-not (= layout (c-layout-version))\n  (refuse-load \"the library writes another layout\"\n               {:expected layout, :actual (c-layout-version)}))\n\n\n(defn- with-native\n  \"(f p) over caller-owned native memory `p` of `n` bytes (one for an empty\n   input), freed however `f` exits. The release is established before\n   anything else can fail, so nesting one call per acquisition frees each\n   buffer independently of the others.\"\n  [n f]\n  (let [p (ffi/alloc (max 1 n))]\n    (try\n      (when (ffi/null? p)\n        (throw (ex-info \"jolt-crypto native allocation failed\" {:bytes n})))\n      (f p)\n      (finally (ffi/free p)))))\n\n\n(defn- version-number\n  \"OpenSSL_version_num of a \\\"major.minor.patch\\\" text (OpenSSL 3's\n   0xMNN00PP0 form).\"\n  [text]\n  (let [[major minor patch] (map #(Long/parseLong %) (str/split text #\"\\.\"))]\n    (+ (bit-shift-left major 28) (bit-shift-left minor 20) (bit-shift-left patch 4))))\n\n\n(def ^:private provenance\n  (with-native 4096\n    (fn [buf]\n      (let [n (c-provenance buf 4096)]\n        (when (neg? n)\n          (refuse-load \"libcrypto provenance unavailable\" {:status n}))\n        (let [[num text path digest] (str/split (ffi/read-bytes buf n) #\"\\t\")]\n          {:version-num (Long/parseLong num), :version text, :path path,\n           :sha256 digest})))))\n\n\n(defn- canonical\n  [path]\n  (.getCanonicalPath (java.io.File. ^String path)))\n\n\n(let [declared (get-in libcrypto-declaration [:path (keyword platform)])\n      qualified (get-in libcrypto-declaration [:qualified (keyword platform)])\n      minimum (:min-version libcrypto-declaration)\n      refuse (fn [message]\n               (refuse-load message {:declared declared, :qualified qualified,\n                                     :provenance provenance}))]\n  (when-not (and declared qualified minimum)\n    (refuse \"jolt-toolchain.edn qualifies no libcrypto for this platform\"))\n  ;; canonical paths: dyld answers the real path behind Homebrew's opt/\n  ;; link, and a Linux loader may name the file through /lib\n  (when-not (= (canonical (:path provenance)) (:canonical-path qualified))\n    (refuse \"EVP resolved to an undeclared libcrypto (canonical path differs from the qualified one)\"))\n  (when-not (= (canonical declared) (:canonical-path qualified))\n    (refuse \"the declared libcrypto path resolves to another file than the qualified one (repointed)\"))\n  (when-not (= (:version-num provenance) (:version-num qualified))\n    (refuse \"libcrypto version differs from the qualified one (upgrade or downgrade)\"))\n  (when-not (= (:sha256 provenance) (:sha256 qualified))\n    (refuse \"libcrypto file digest differs from the qualified one (replaced)\"))\n  (when (< (:version-num provenance) (version-number minimum))\n    (refuse \"libcrypto is older than the declared minimum\")))\n\n\n(defn- digest\n  \"The 32-byte result of wrapper entry `c-fn` over `bs`, copied into a fresh\n   jolt byte array.\"\n  [entry c-fn bs]\n  (let [n (alength bs)]\n    (with-native n\n      (fn [in]\n        (when (pos? n) (ffi/write-array in bs))\n        (with-native 32\n          (fn [out]\n            (let [status (c-fn in n out)]\n              (when-not (zero? status)\n                (throw (ex-info (str \"jolt-crypto \" entry \" failed\")\n                                {:entry entry, :status status})))\n              (ffi/read-array out 32))))))))\n\n\n;; =============================================================================\n;; The profile surface\n;; =============================================================================\n\n(defn- check-bytes!\n  [entry bs]\n  (when-not (bytes/bytes? bs)\n    (throw (ex-info (str \"dao.host refused: \" entry \" unsupported-value (expected host bytes)\")\n                    {:dao.host/refusal :unsupported-value\n                     :dao.host/entry entry}))))\n\n\n(defn blake3-bytes\n  \"P. 32-byte BLAKE3 digest of host bytes `bs`, returning fresh host bytes.\"\n  [bs]\n  (check-bytes! 'blake3-bytes bs)\n  (digest 'blake3-bytes c-blake3 bs))\n\n\n(defn sha256-bytes\n  \"P. 32-byte SHA-256 digest of host bytes `bs`, returning fresh host bytes.\"\n  [bs]\n  (check-bytes! 'sha256-bytes bs)\n  (digest 'sha256-bytes c-sha256 bs))\n(ns dao.host.text\n  \"The jolt override of src/cljc/dao/host/text.cljc (the :jolt alias puts\n   src/jolt first, docs/design/yin.repl-jolt-implementation.md §4.2): the\n   same public entries, arities and refusal data\n   (docs/design/dao.stream.host-boundary.md §4.2, table A).\n\n   A jolt string is a Chez string: a sequence of Unicode scalar values\n   (code points), not of UTF-16 code units; `(count \\\"😀\\\")` is 1, and no\n   Chez string can hold a surrogate code point (V: `integer->char` refuses\n   #xD800). The code-unit entries are therefore computed over the UTF-16\n   view of the scalar values: `unit-count` counts a code point above\n   U+FFFF as two units and `code-unit` answers its high or low surrogate.\n   Exactly the strings with every surrogate paired are representable, so:\n\n   - `units->string` builds every string the profile admits EXCEPT one\n     holding an unpaired surrogate, which a Chez string cannot hold. It\n     does not invent a value for that input: it throws an ex-info whose\n     data carries `:jolt/unimplemented` (and no `:dao.host/refusal`). J1\n     stopped on that entry; the options are in the J1 report.\n   - `utf8-encode`'s unpaired-surrogate refusal can never be reached on\n     jolt, because no jolt string has an unpaired surrogate; the check is\n     kept, verbatim, over the code-unit view.\n   - `utf8-decode` is a strict RFC 3629 decoder written here over the\n     bytes (Unicode table 3-7), never Chez's `utf8->string`, which\n     substitutes; a leading BOM is content.\n   - `nfc` is Chez's `string-normalize-nfc`. Chez 10.4 implements Unicode\n     17.0.0 (release notes, \\\"Unicode 17.0.0 support (10.4.0)\\\"), not the\n     profile's pinned 16.0; by the Unicode normalization stability policy\n     the two agree on every string of 16.0-assigned code points, and may\n     differ only on code points first assigned in 17.0.\"\n  (:require\n    [jolt.scheme :as scheme]))\n\n\n(defn- refuse\n  [entry cls detail]\n  (throw (ex-info (str \"dao.host refused: \" entry \" \" (name cls) \" (\" detail \")\")\n                  {:dao.host/refusal cls :dao.host/entry entry :detail detail})))\n\n\n(def ^:private chez-string-length (scheme/proc \"string-length\"))\n(def ^:private chez-string-ref (scheme/proc \"string-ref\"))\n(def ^:private chez-char->integer (scheme/proc \"char->integer\"))\n(def ^:private chez-integer->char (scheme/proc \"integer->char\"))\n(def ^:private chez-string->utf8 (scheme/proc \"string->utf8\"))\n(def ^:private chez-bytevector-length (scheme/proc \"bytevector-length\"))\n(def ^:private chez-bytevector-u8-ref (scheme/proc \"bytevector-u8-ref\"))\n(def ^:private chez-string-normalize-nfc (scheme/proc \"string-normalize-nfc\"))\n\n\n(defn- scalar-at\n  [s i]\n  (chez-char->integer (chez-string-ref s i)))\n\n\n;; =============================================================================\n;; Code units\n;; =============================================================================\n\n(defn unit-count\n  \"P. The number of UTF-16 code units of string `s`: one per code point,\n   two for a code point above U+FFFF.\"\n  [s]\n  (let [n (chez-string-length s)]\n    (loop [i 0\n           units 0]\n      (if (< i n)\n        (recur (inc i) (if (< (scalar-at s i) 0x10000) (inc units) (+ units 2)))\n        units))))\n\n\n(def ^:private code-unit-hint\n  \"Where the last `code-unit` call stopped: `[s ci at]`, scalar `ci` of\n   `s` starts at code unit `at`. A Chez string is indexed by scalar, so\n   finding unit `i` means walking the scalars before it; a call on the\n   same (identical) string at a unit index at or past the hint resumes\n   there instead of at 0, which makes an ascending walk over the units\n   (every caller's shape, e.g. yin.vm.debruijn's) linear in the string\n   rather than quadratic. Any other call starts at 0, as without the\n   hint, and answers the same. The hint is one immutable vector swapped\n   whole, so a racing thread at worst restarts from 0; it keeps the last\n   such string reachable until the next call. The resume is sound only\n   while `s` is never mutated between calls: a Chez string is mutable,\n   and nothing under src/ mutates one (no `string-set!`).\"\n  (atom nil))\n\n\n(defn code-unit\n  \"P. The UTF-16 code unit at index `i` of `s`, 0 to 0xFFFF; the caller\n   has checked 0 <= i < `unit-count`. A code point above U+FFFF answers\n   its high surrogate at its first unit and its low at its second.\"\n  [s i]\n  (let [[hs hci hat] @code-unit-hint\n        resume? (and (identical? hs s) (<= hat i))]\n    (loop [ci (if resume? hci 0)\n           at (if resume? hat 0)]\n      (let [cp (scalar-at s ci)]\n        (if (< cp 0x10000)\n          (if (= at i)\n            (do (reset! code-unit-hint [s ci at]) cp)\n            (recur (inc ci) (inc at)))\n          (cond (= at i) (do (reset! code-unit-hint [s ci at])\n                             (+ 0xD800 (quot (- cp 0x10000) 0x400)))\n                (= (inc at) i) (do (reset! code-unit-hint [s ci at])\n                                   (+ 0xDC00 (rem (- cp 0x10000) 0x400)))\n                :else (recur (inc ci) (+ at 2))))))))\n\n\n(defn- code-units\n  \"The UTF-16 code units of `s` as a vector, in one pass over its\n   scalars: what `code-unit` answers at each index 0 to `unit-count`.\"\n  [s]\n  (let [n (chez-string-length s)]\n    (loop [ci 0\n           out (transient [])]\n      (if (< ci n)\n        (let [cp (scalar-at s ci)]\n          (recur (inc ci)\n                 (if (< cp 0x10000)\n                   (conj! out cp)\n                   (-> out\n                       (conj! (+ 0xD800 (quot (- cp 0x10000) 0x400)))\n                       (conj! (+ 0xDC00 (rem (- cp 0x10000) 0x400)))))))\n        (persistent! out)))))\n\n\n(defn- high-surrogate?\n  [u]\n  (<= 0xD800 u 0xDBFF))\n\n\n(defn- low-surrogate?\n  [u]\n  (<= 0xDC00 u 0xDFFF))\n\n\n(defn units->string\n  \"P. The host string of the UTF-16 code units `units` (each 0 to\n   0xFFFF). A surrogate pair becomes its one code point. An unpaired\n   surrogate has no Chez string: unimplemented on jolt (see the namespace\n   docstring), thrown as `:jolt/unimplemented`, not as a profile refusal.\n   An integer unit outside 0 to 0xFFFF is out of the domain; it throws\n   what the JVM's `(char u)` throws, an IllegalArgumentException\n   \\\"Value out of range for char: u\\\" with no ex-data, for the first such\n   unit in order and before anything else is looked at (the JVM reaches\n   it even past an unpaired surrogate, which it can hold), where Chez's\n   `integer->char` would silently build the scalar above 0xFFFF (review\n   J1-R5).\"\n  [units]\n  (let [units (vec units)\n        n (count units)]\n    (doseq [u units]\n      (when (and (integer? u) (not (<= 0 u 0xFFFF)))\n        (throw (IllegalArgumentException. (str \"Value out of range for char: \" u)))))\n    (loop [i 0\n           out (transient [])]\n      (if (< i n)\n        (let [u (nth units i)\n              v (when (< (inc i) n) (nth units (inc i)))]\n          (cond\n            (and (high-surrogate? u) v (low-surrogate? v))\n            (recur (+ i 2)\n                   (conj! out (chez-integer->char (+ 0x10000\n                                                     (* (- u 0xD800) 0x400)\n                                                     (- v 0xDC00)))))\n            (or (high-surrogate? u) (low-surrogate? u))\n            (throw (ex-info (str \"jolt: units->string cannot build a string holding the unpaired surrogate \"\n                                 u \" at unit \" i \": a Chez string holds only Unicode scalar values\")\n                            {:jolt/unimplemented 'dao.host.text/units->string\n                             :unit u\n                             :index i}))\n            :else (recur (inc i) (conj! out (chez-integer->char u)))))\n        (apply str (persistent! out))))))\n\n\n(defn code-points\n  \"P, table B. The code points of string `s` as a vector: a surrogate\n   pair decodes to one code point, an unpaired surrogate is its own.\n   Over a Chez string that is exactly its scalars, read in one pass: a\n   scalar below U+10000 is one unit and never a surrogate (Chez holds\n   none), so it decodes to itself; a scalar above is a high-low pair,\n   which decodes back to it; no unpaired surrogate is left to emit.\"\n  [s]\n  (let [n (chez-string-length s)]\n    (loop [ci 0\n           out (transient [])]\n      (if (< ci n)\n        (recur (inc ci) (conj! out (scalar-at s ci)))\n        (persistent! out)))))\n\n\n;; =============================================================================\n;; UTF-8\n;; =============================================================================\n\n(defn- check-surrogates!\n  \"Refuse `:unpaired-surrogate` unless every surrogate of `s` is paired,\n   over its code units built once (`code-units`).\"\n  [entry s]\n  (let [units (code-units s)\n        n (count units)]\n    (loop [i 0]\n      (when (< i n)\n        (let [c (nth units i)]\n          (cond\n            (high-surrogate? c)\n            (if (and (< (inc i) n) (low-surrogate? (nth units (inc i))))\n              (recur (+ i 2))\n              (refuse entry :unpaired-surrogate (str \"unpaired high surrogate at \" i)))\n            (low-surrogate? c)\n            (refuse entry :unpaired-surrogate (str \"unpaired low surrogate at \" i))\n            :else (recur (inc i))))))))\n\n\n(defn utf8-encode\n  \"P, fresh. The UTF-8 bytes of string `s`, as a jolt byte array (Chez's\n   `string->utf8`, copied out of its bytevector). A string holding an\n   unpaired surrogate is refused `:unpaired-surrogate` before any host\n   encoder sees it; on jolt no such string exists.\"\n  [s]\n26:                :jolt [[yang.python.antlr.parser :as python.antlr.parser]\n151:                              :jolt \"--codec takes cbor, not \"\n689:     :jolt (do (flush) (System/exit 1))\n753:     #?(:cljd false :jolt true :default false)\n757:            #?(:jolt (if (python.antlr.parser/available?)\n759:                            \" (native/jolt-parser), in process; no process\"\n761:                       \"python: unavailable-parser (the native parser library is missing or incompatible; bb build:jolt-native)\")\n772:     :jolt (do (flush) (System/exit exit))\n1079:  \"Serial shell owner shared by the JVM and jolt. Host policy supplies\n1108:   :jolt nil\n1204:#?(:jolt\n1253:       \"The engine's own jolt entry point: the `mem` and `file:<dir>` stores\n","exit_code":0,"status":"completed"}}
