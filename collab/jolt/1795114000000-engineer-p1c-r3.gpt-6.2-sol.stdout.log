bit-force-delay delay)\nhost/gambit/host-vars.ss:268:(define (gambit-signed-byte octet)\nhost/gambit/host-vars.ss:271:(define (gambit-byte-octet value)\nhost/gambit/host-vars.ss:274:(define (gambit-byte-array size-or-items . init)\nhost/gambit/host-vars.ss:294:(define (gambit-byte-ref a i) (gambit-signed-byte (u8vector-ref a i)))\nhost/gambit/host-vars.ss:296:(define (gambit-byte-index a i0)\nhost/gambit/host-vars.ss:318:(define (gambit-byte-seq a i)\nhost/gambit/host-vars.ss:324:(define gambit-byte-tail\nhost/gambit/host-vars.ss:378:(define (gambit-msg-has? m sub)\nhost/gambit/host-vars.ss:385:(define (gambit-host-error? x)\nhost/gambit/host-vars.ss:388:(define (gambit-error-class x)\nhost/gambit/host-vars.ss:398:(define (gambit-collapse-lines s)\nhost/gambit/host-vars.ss:413:(define (gambit-error-tostring x)\n(ns yang.antlr.cst\n  \"The jolt host's parser interpreter (docs/design/yin.repl-jolt-implementation.md\n   §7.3): the same surface as the JVM, Node and Dart `yang.antlr.cst`\n   (`make-worker`, `parse-unit`, `parse-transform`, `utf8-bytes`,\n   `first-failure`), over the ANTLR4 C++ Python3 parser behind\n   native/jolt-parser.\n\n   The wrapper parses and answers one private fixed-layout buffer (\\\"JPX1\\\",\n   see jolt_parser.cpp); this namespace copies it into a jolt byte array,\n   frees it through the wrapper, checks its bounds and topology, and hands the\n   shared `yang.antlr.export` an `ops` view over the decoded records. Packets,\n   spans and synthetic tokens are built by the shared exporter, never in C++.\n   No native pointer leaves `export-records`.\n\n   The calls are synchronous and `:blocking`, as §7.5 prescribes.\n\n   A worker (§7.4) holds an opaque native handle that owns the lexer and\n   parser DFA vectors and prediction-context caches its parses use; the\n   generated ATNs are shared, immutable. Its owner disposes it with\n   `close-worker` (a jolt-only addition: the other hosts' workers are\n   collected). A worker serves one thread at a time; a concurrent call on the\n   same worker is refused by the wrapper (status -5) and throws here.\n\n   The library is loaded on first use, not with this namespace (J5): a\n   missing, unloadable or wrong-layout library is recorded, `available?`\n   answers false, and asking for a worker throws the qualified\n   `unavailable-parser` diagnostic, so a host composing its frontend catalog\n   can leave Python out (never another parser) instead of failing to load.\n\n   Disclosed limits: the native library is the one Python3 grammar the\n   wrapper was built with, whatever the profile names; a worker nobody closes\n   keeps its native caches until the process exits.\"\n  (:require\n    [clojure.string :as str]\n    [jolt.ffi :as ffi]\n    [yang.antlr.export :as export]\n    [yang.antlr.packet :as packet]))\n\n\n;; =============================================================================\n;; The native library\n;; =============================================================================\n\n(def ^:private platform\n  ;; jolt's os.name/os.arch shim can answer nil (udp_probe.clj); nil reads as\n  ;; Linux, as jolt.socket.native/os decides, and as x86_64\n  (let [os (str/lower-case (or (System/getProperty \"os.name\") \"\"))\n        arch (System/getProperty \"os.arch\")]\n    (str (if (str/includes? os \"mac\") \"darwin\" \"linux\") \"-\"\n         (if (#{\"aarch64\" \"arm64\"} arch) \"arm64\" \"x86_64\"))))\n\n\n(def library\n  \"The wrapper `bb build:jolt-native` builds, under the working directory.\"\n  (str (System/getProperty \"user.dir\") \"/build/native/\" platform\n       \"/jolt-parser/lib/libjolt_parser\"\n       (if (str/starts-with? platform \"darwin\") \".dylib\" \".so\")))\n\n\n(ffi/defcfn ^:private c-export \"jolt_parser_export\"\n            [:pointer :pointer :size_t :pointer :pointer] :int :blocking)\n\n\n(ffi/defcfn ^:private c-free \"jolt_parser_free\" [:pointer] :void)\n(ffi/defcfn ^:private c-worker-new \"jolt_parser_worker_new\" [] :pointer)\n(ffi/defcfn ^:private c-worker-free \"jolt_parser_worker_free\" [:pointer] :void)\n(ffi/defcfn ^:private c-export-layout-version \"jolt_parser_export_layout_version\" [] :int)\n\n\n(def ^:private export-layout 2)\n\n\n;; jolt binds a foreign symbol when it is first called, so the bindings above\n;; are inert until a load has succeeded. The load is attempted on first use\n;; and, after a refusal, again on every later use (a cheap re-stat), so a\n;; library built after the REPL started is picked up by the next selection.\n(def ^:private loaded? (atom false))\n\n\n(defn- load-refusal\n  \"nil when the native library is loaded and writes this namespace's export\n   layout, else the refusal {:reason :message}.\"\n  []\n  (if @loaded?\n    nil\n    (let [refusal\n          (cond\n            (not (.exists (java.io.File. ^String library)))\n            {:reason :missing,\n             :message (str \"the native Python parser library is not built: \" library\n                           \" (bb build:jolt-native)\")}\n\n            :else\n            (try\n              (ffi/load-library library)\n              (let [actual (c-export-layout-version)]\n                (when-not (= export-layout actual)\n                  {:reason :incompatible,\n                   :message (str \"the native Python parser library writes export layout \"\n                                 actual \", not \" export-layout \": \" library)}))\n              (catch Throwable t\n                {:reason :unloadable,\n                 :message (str \"the native Python parser library did not load: \"\n                               (or (ex-message t) (str t)))})))]\n      (when-not refusal (reset! loaded? true))\n      refusal)))\n\n\n(defn available?\n  \"True when the native parser library is loaded and writes this namespace's\n   export layout. Attempts the load when it has not succeeded yet.\"\n  []\n  (nil? (load-refusal)))\n\n\n(defn- ensure-native!\n  []\n  (when-let [{:keys [reason message]} (load-refusal)]\n    (throw (ex-info (str \"unavailable-parser: \" message)\n                    {:diagnostic :unavailable-parser, :reason reason,\n                     :library library}))))\n\n\n;; The budget (J5b, known-gaps row 59; the work axis J5c, rows 60-61): the\n;; wrapper refuses an input over the input bound before any ANTLR object\n;; exists (status -6), and nesting or work from guards inside recognition\n;; (status -7, kind rule or lookahead, or the work axis), before any buffer\n;; is built. The input bound is mirrored here so an oversized source is\n;; refused without the call.\n(def input-bound\n  \"The largest source, in UTF-8 bytes, the native parser accepts: 4 MiB, as\n   native/jolt-parser's kMaxInputBytes.\"\n  (* 4 1024 1024))\n\n\n(defn- budget-refusal\n  \"The qualified :parser-budget diagnostic for `axis` (:input, :nesting with\n   `kind` :rule or :lookahead, or :work): an operational refusal, never a\n   syntax error, never another parser, never a partial packet.\"\n  ([axis measured bound] (budget-refusal axis measured bound nil))\n  ([axis measured bound kind]\n   (ex-info (str \"parser-budget: \" (name axis) \" \" measured \" is over the bound \"\n                 bound\n                 (case kind\n                   :rule \" rule frames\"\n                   :lookahead \" lookahead links\"\n                   (if (= :work axis) \" work units\" \" bytes\"))\n                 (if (= :input axis)\n                   \" (the native Python parser refuses before parsing)\"\n                   \" (the native Python parser refuses; no partial packet)\"))\n            (cond-> {:diagnostic :parser-budget, :axis axis, :bound bound,\n                     :measured measured}\n              kind (assoc :kind kind)))))\n\n\n14:   the backend reports durability; get hash-verifies the bytes a backend\n29:            [dao.host.hash :as hash]\n76:(defn sha256\n80:  (bytes->hex (hash/sha256-bytes (text/utf8-encode s))))\n83:(defn sha256-bytes\n85:   ClojureScript, Uint8List on Dart). `(sha256-bytes (canonical-bytes v))`\n86:   is the digest for `(content-hash v {:algorithm :sha256})`.\"\n88:  (bytes->hex (hash/sha256-bytes bs)))\n91:(def default-hash-algorithm\n92:  \"The default algorithm used for implicit minting (content-hash, segment-key,\n94:  :blake3)\n100:  {:blake3 {:address-id \"blake3\", :digest-bytes 32}\n101:   :sha256 {:address-id \"sha256\", :digest-bytes 32}})\n141:(defn blake3-bytes\n145:  (bytes->hex (hash/blake3-bytes bs)))\n148:(defn blake3\n152:  (bytes->hex (hash/blake3-bytes (text/utf8-encode s))))\n156:  \"Digest host bytes bs with the specified algorithm keyword (:blake3, :sha256).\n160:    :blake3 (blake3-bytes bs)\n161:    :sha256 (sha256-bytes bs)\n162:    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n171:    :blake3 (blake3 s)\n172:    :sha256 (sha256 s)\n173:    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n179:   of v -- the exact bytes content hashing digests, so\n181:   `(content-hash v {:algorithm algo})`.\n212:(defn content-hash\n214:   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\n217:   (content-hash v {:algorithm default-hash-algorithm}))\n219:   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\n226:   The 1-arg form defaults to default-hash-algorithm (:blake3).\n227:   The 2-arg form accepts {:algorithm :sha256} (or any registered algorithm).\"\n229:   (segment-key v {:algorithm default-hash-algorithm}))\n231:   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n234:       (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n237:           digest (content-hash v {:algorithm algo})]\n279:  \"The algorithm keyword (:blake3, :sha256) carried by a segment address.\n296:(defn segment-hash\n297:  \"The content hash carried by a segment address. Equivalent to segment-digest.\n305:   and its digest matches the hash of canonical-bytes of payload under the\n322:   segment address whose digest is the hash of bs under the address-carried\n348:  \"The canonical payload bytes of payload, which must hash to address\n366:  \"The value of payload bytes stored at address: verifies the bytes hash to\n377:      (throw (ex-info \"stored bytes do not hash to their content address\"\n387:   the bytes must hash to the address under its carried algorithm, and\n393:   :segment-address, :base64, :hash-mismatch, :non-canonical.\"\n404:      (throw (ex-info \"content address does not match payload hash\"\n405:                      {:address address, :reason :hash-mismatch})))\n416:   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\n432:   verified both by hash against the address and byte for byte against the\n434:   address. Content that does not hash to its own address is an integrity\n437:   (materialize! handle payload {:algorithm default-hash-algorithm}))\n447:     (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n450:         (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n467:               ;; the read-back must hash to the address it sits at and be\n488:   backend is consulted. The backend's bytes are hash-verified against the\n489:   address and decoded; bytes that do not hash to the address throw.\nhost/gambit/prelude-shims.ss:465:(define (%gambit-exception-text x)\nhost/gambit/prelude-shims.ss:479:(define (condition? x)\nhost/gambit/prelude-shims.ss:481:(define (message-condition? x) (condition? x))\nhost/gambit/prelude-shims.ss:482:(define (condition-message c)\nhost/gambit/prelude-shims.ss:486:(define (condition-irritants c)\nhost/gambit/prelude-shims.ss:493:(define (irritants-condition? c) (error-object? c))\nhost/gambit/prelude-shims.ss:494:(define (who-condition? c) #f)\nhost/gambit/prelude-shims.ss:498:(define (error? x) (condition? x))\nhost/gambit/prelude-shims.ss:500:(define (serious-condition? x) (condition? x))\nhost/gambit/prelude-shims.ss:506:(define (condition-who c) #f)\nhost/gambit/prelude-shims.ss:507:(define (display-condition c . port)\nhost/gambit/prelude-shims.ss:551:(define (make-condition) (make-condition-variable))\nhost/gambit/prelude-shims.ss:552:(define (condition-signal cv) (condition-variable-signal! cv))\nhost/gambit/prelude-shims.ss:553:(define (condition-broadcast cv) (condition-variable-broadcast! cv))\nhost/gambit/prelude-shims.ss:558:(define (condition-wait cv m . rest)\nhost/gambit/rt-core.ss:11:;;           define-condition-type &jolt-throw) becomes a tagged (cons 'jolt-throw v);\nhost/gambit/rt-core.ss:381:(define (jolt-throw-condition? x) (and (pair? x) (eq? (car x) 'jolt-throw)))\nhost/gambit/rt-core.ss:382:(define (jolt-throw-condition-value x) (cdr x))\n","exit_code":0,"status":"completed"}}
