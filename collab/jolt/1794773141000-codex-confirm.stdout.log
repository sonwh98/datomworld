r/cancel! fd) (catch Throwable _ nil))\n   213\t                                              (try (poller/forget! fd) (catch Throwable _ nil))\n   214\t                                              (native/c-close fd)\n   215\t                                              (deposit-event! deposit (datagram/closed-event identity)))\n   216\t                                            nil)\n   217\t\n   218\t                                          send-fn\n   219\t                                          (fn [dest-host dest-port ^bytes payload]\n   220\t                                            (if @closed?\n   221\t                                              {:dao.stream/outcome :dao.stream/closed}\n   222\t                                              (let [parsed-dest (parse-literal-host dest-host)]\n   223\t                                                (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))\n   224\t                                                  (let [reason \"IP family mismatch\"]\n   225\t                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n   226\t                                                    {:dao.stream/outcome :dao.stream/transport-error\n   227\t                                                     :dao.stream.datagram/reason reason})\n   228\t                                                  (let [len (bytes/length payload)\n   229\t                                                        buf (ffi/alloc (max 1 len))]\n   230\t                                                    (try\n   231\t                                                      (let [[dsa dlen] (native/make-sockaddr family (:ip parsed-dest) dest-port)]\n   232\t                                                        (try\n   233\t                                                          (if-not dsa\n   234\t                                                            (let [reason \"make-sockaddr failed for destination\"]\n   235\t                                                              (deposit-event! deposit (datagram/send-failed-event identity reason))\n   236\t                                                              {:dao.stream/outcome :dao.stream/transport-error\n   237\t                                                               :dao.stream.datagram/reason reason})\n   238\t                                                            (do\n   239\t                                                              (when (pos? len)\n   240\t                                                                (ffi/write-array buf payload))\n   241\t                                                              (let [[n e] (*sendto* fd buf len 0 dsa dlen)]\n   242\t                                                                (cond\n   243\t                                                                  (neg? n)\n   244\t                                                                  (let [reason (str \"sendto failed: errno \" e)]\n   245\t                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n   246\t                                                                    {:dao.stream/outcome :dao.stream/transport-error\n   247\t                                                                     :dao.stream.datagram/reason reason})\n   248\t\n   249\t                                                                  (not= n len)\n   250\t                                                                  (let [reason (str \"short send: sent \" n \" of \" len \" bytes\")]\n   251\t                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n   252\t                                                                    {:dao.stream/outcome :dao.stream/transport-error\n   253\t                                                                     :dao.stream.datagram/reason reason})\n   254\t\n   255\t                                                                  :else\n   256\t                                                                  {:dao.stream/outcome :dao.stream/ok}))))\n   257\t                                                          (finally\n   258\t                                                            (when dsa (ffi/free dsa)))))\n   259\t                                                      (finally\n   260\t                                                        (ffi/free buf))))))))\n   261\t\n   262\t                                          step-fn\n   263\t                                          (fn []\n   264\t                                            (if @closed?\n   265\t                                              {:progressed? false}\n   266\t                                              (let [cap (inc max-bytes)\n   267\t                                                    buf (ffi/alloc cap)]\n   268\t                                                (try\n   269\t                                                  (let [[rsa rlenp] (native/alloc-sockaddr)]\n   270\t                                                    (try\n   271\t                                                      (let [progressed? (volatile! false)]\n   272\t                                                        (loop [budget 64]\n   273\t                                                          (when (pos? budget)\n   274\t                                                            (ffi/write rlenp :int native/sockaddr-storage-size 0)\n   275\t                                                            (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]\n   276\t                                                              (cond\n   277\t                                                                (neg? n)\n   278\t                                                                (cond\n   279\t                                                                  ;; would-block: silent\n   280\t                                                                  (or (= e EAGAIN) (= e ENOBUFS))\n   281\t                                                                  nil\n   282\t\n   283\t                                                                  ;; interruption: recoverable, no retry inside turn\n   284\t                                                                  (= e EINTR)\n   285\t                                                                  (swap! diagnostics conj\n   286\t                                                                         {:kind :interrupted\n   287\t                                                                          :errno e\n   288\t                                                                          :reason (str \"recvfrom interrupted: errno \" e)})\n   289\t\n   290\t                                                                  ;; fatal descriptor error: close seam once\n   291\t                                                                  :else\n   292\t                                                                  (do\n   293\t                                                                    (swap! diagnostics conj\n   294\t                                                                           {:kind :fatal-descriptor-error\n   295\t                                                                            :errno e\n   296\t                                                                            :reason (str \"recvfrom fatal error: errno \" e)})\n   297\t                                                                    (close-fn)))\n   298\t\n   299\t                                                                :else\n   300\t                                                                (do\n   301\t                                                                  (vreset! progressed? true)\n   302\t                                                                  (if (> n max-bytes)\n   303\t                                                                    ;; Oversize drop\n   304\t                                                                    (recur (dec budget))\n   305\t                                                                    (let [bs (if (zero? n)\n   306\t                                                                               (bytes/alloc 0)\n   307\t                                                                               (ffi/read-array buf n))\n   308\t                                                                          src-ip (native/sockaddr-ip rsa)\n   309\t                                                                          src-port (native/sockaddr-port rsa)]\n   310\t                                                                      (deposit-event! deposit\n   311\t                                                                                      (datagram/datagram-event identity src-ip src-port bs))\n   312\t                                                                      (recur (dec budget)))))))))\n   313\t                                                        {:progressed? @progressed?})\n   314\t                                                      (finally\n   315\t                                                        (when rsa (ffi/free rsa))\n   316\t                                                        (when rlenp (ffi/free rlenp)))))\n   317\t                                                  (finally\n   318\t                                                    (ffi/free buf))))))\n   319\t\n   320\t                                          seam {:send! send-fn\n   321\t                                                :close! close-fn\n   322\t                                                :step! step-f