\t;; =============================================================================\n   109\t\n   110\t(defn- parse-literal-host\n   111\t  \"Parse literal IP host (IPv4 or IPv6), stripping brackets if present.\n   112\t   Rejects hostnames like 'localhost'.\"\n   113\t  [h]\n   114\t  (try\n   115\t    (when (string? h)\n   116\t      (let [clean (if (and (str/starts-with? h \"[\") (str/ends-with? h \"]\"))\n   117\t                    (subs h 1 (dec (count h)))\n   118\t                    h)]\n   119\t        (if-let [[sa _] (native/make-sockaddr native/af-inet clean 0)]\n   120\t          (do (ffi/free sa) {:family native/af-inet :ip clean})\n   121\t          (if-let [[sa _] (native/make-sockaddr native/af-inet6 clean 0)]\n   122\t            (do (ffi/free sa) {:family native/af-inet6 :ip clean})\n   123\t            nil))))\n   124\t    (catch Throwable _ nil)))\n   125\t\n   126\t\n   127\t(defn- deposit-event!\n   128\t  [deposit event]\n   129\t  (try\n   130\t    (stream/append! deposit event)\n   131\t    (catch Throwable _ nil)))\n   132\t\n   133\t\n   134\t(defn- failed-seam\n   135\t  [deposit identity reason]\n   136\t  (deposit-event! deposit (datagram/bind-failed-event identity reason))\n   137\t  (let [diagnostics (atom [{:kind :bind-failed :reason reason}])]\n   138\t    {:send! (fn [_ _ _]\n   139\t              {:dao.stream/outcome :dao.stream/transport-error\n   140\t               :dao.stream.datagram/reason \"bind failed\"})\n   141\t     :close! (fn [] nil)\n   142\t     :step! (fn [] {:progressed? false})\n   143\t     :diagnostics diagnostics\n   144\t     :diagnostic (fn [] (last @diagnostics))}))\n   145\t\n   146\t\n   147\t;; =============================================================================\n   148\t;; Native Datagram Seam bind!\n   149\t;; =============================================================================\n   150\t\n   151\t(defn bind!\n   152\t  \"Bind one native datagram socket per the seam contract (§3).\n   