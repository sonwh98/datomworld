t\" :test \"dht-manifest-suspends-following-for-the-run\"\n                    :reason \"J7 slice 1+2 landed; networked DHT peer/follow acceptance open per design §§6-7\" :capability \"J7 DHT transport\" :owner \"J7\"}\n                   {:ns \"yin.repl.main-test\" :test \"dht-init-publishes-with-a-key-and-localhost-peer\"\n                    :reason \"J7 slice 1+2 landed; networked DHT peer publication open per design §§6-7\" :capability \"J7 DHT transport\" :owner \"J7\"}\n                   {:ns \"yin.repl.main-test\" :test \"dht-serve-fetches-only\"\n                    :reason \"J7 slice 1+2 landed; networked DHT peer serving open per design §§6-7\" :capability \"J7 DHT transport\" :owner \"J7\"}\n                   {:ns \"yin.repl.main-test\" :test \"codec-flag-selects-the-served-wire-profile\"\n                    :reason \"J6 Transit capability unavailable in J3\" :capability \"J6 Transit\" :owner \"J6\"}\n                   {:ns \"yin.repl.main-test\" :test \"with-the-dht-store-still-hydrating-a-renewal-and-a-pending-release-are-still-sent-test\"\n                    :reason \"J7 slice 1+2 landed; networked DHT peer hydration open per design §§6-7\" :capability \"J7 DHT transport\" :owner \"J7\"}\n                   {:ns \"yin.repl.state-test\" :test \"dht-join-saves-its-follow-and-a-bare-start-resumes-it\"\n                    :reason \"J7 slice 1+2 landed; networked DHT follow persistence open per design §§6-7\" :capability \"J7 DHT transport\" :owner \"J7\"}\n                   {:ns \"yin.repl.main-test\" :test \"a-dart-client-attaches-to-this-jvm-server\"\n                    :reason \"JVM socket fixture; portable injected endpoints remain active\" :capability \"JVM WebSocket peers\" :owner \"J6\"}\n                   {:ns \"yin.repl.main-test\" :test \"killing-the-connection-is-observable-and-requests-are-lost\"\n                    :reason \"JVM socket fixture; portable injected endpoints remain active\" :capability \"JVM WebSocket peers\" :owner \"J6\"}\n                   {:ns \"yin.repl.main-test\" :test \"stopping-the-endpoint-ends-the-served-stream-not-closes-it\"\n                    :reason \"JVM socket fixture; portable injected endpoints remain active\" :capability \"JVM WebSocket peers\" :owner \"J6\"}\n                   {:ns \"yin.repl.main-test\" :test \"reattaching-resumes-the-served-stream-and-the-deposit-medium\"\n                    :reason \"JVM socket fixture; portable injected endpoints remain active\" :capability \"JVM WebSocket peers\" :owner \"J6\"}\n                   {:ns \"yin.repl.main-test\" :test \"evaluation-round-trips-and-two-clients-get-their-own-answers\"\n                    :reason \"JVM socket fixture; portable injected endpoints remain active\" :capability \"JVM WebSocket peers\" :owner \"J6\"}\n                   {:ns \"yin.repl.main-test\" :test \"a-typed-quit-exits-without-waiting-for-end-of-input\"\n                    :reason \"JVM subprocess fixture; held-pipe process corpus covers jolt\" :capability \"JVM subprocess\" :owner \"J3\"}\n                   {:ns \"yin.repl.main-test\" :test \"the-jvm-loop-drains-custody-without-an-endpoint-and-closes-its-journals-test\"\n                    :reason \"JVM poll loop; its durable-journal half runs on jolt in the-exit-path-closes-the-custody-journals-before-the-host-exits-test (J4d)\" :capability \"JVM loop\" :owner \"J3\"}]\n :host-expectations [{:ns \"yin.repl-test\" :test \"host-command-names-the-runtime\" :owner \"J3\"}\n                     {:ns \"yin.repl.main-test\" :test \"booting-yields-one-shell-one-input-medium-and-one-cursor\" :owner \"J3\"}]\n :reader-failures {:owner \"jolt-lang\" :excluded false\n                   :tests [\"a-percent-reads-alike-in-every-symbol-position\"\n                           \"tagged-literals-and-reader-conditionals-refuse-alike\"]}}\n","exit_code":0,"status":"completed"}}
