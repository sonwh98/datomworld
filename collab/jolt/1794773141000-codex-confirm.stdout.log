{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat src/dev/jolt_udp_failures_probe.clj'","aggregated_output":";; J7 failure-injection probe: native UDP setup failure handling,\n;; exception and buffer cleanup, fatal error seam closure, and diagnostics.\n;; Run with:\n;;   bb probe:jolt-udp-failures\n(ns jolt-udp-failures-probe\n  (:require [dao.stream :as stream]\n            [dao.stream.datagram :as datagram]\n            [dao.stream.ringbuffer :as ring]\n            [dao.stream.udp :as udp]\n            [jolt.ffi :as ffi]\n            [jolt.io-poller :as poller]\n            [jolt.socket.native :as native]))\n\n(def pass-count (atom 0))\n(def fail-count (atom 0))\n\n(defn check [leg label condition data]\n  (if condition\n    (do\n      (swap! pass-count inc)\n      (println \"PASS\" leg label data))\n    (do\n      (swap! fail-count inc)\n      (println \"FAIL\" leg label data))))\n\n(defn traffic []\n  (:dao.stream/handle (ring/create! {:dao.stream/type ring/transport-type\n                                     ring/capacity-key 256})))\n\n(defn events [r]\n  (loop [c (:dao.stream/cursor (stream/cursor r stream/anchor-oldest)) out []]\n    (let [v (stream/next r c)]\n      (if (= :dao.stream/ok (:dao.stream/outcome v))\n        (recur (:dao.stream/cursor v) (conj out (:dao.stream/value v)))\n        out))))\n\n(def closes (atom []))\n(def frees (atom []))\n\n(defn fake-host [f]\n  (reset! closes [])\n  (reset! frees [])\n  (with-redefs [native/c-socket (fn [& _] [123 0])\n                native/close-on-exec! (fn [_] true)\n                native/set-blocking! (fn [& _] [0 0])\n                native/set-int-option! (fn [& _] [0 0])\n                native/c-bind (fn [& _] [0 0])\n                native/local-address (fn [_] {:ip \"127.0.0.1\" :port 40001})\n                native/sockaddr-ip (fn [_] \"127.0.0.1\")\n                native/sockaddr-port (fn [_] 40002)\n                native/c-close (fn [fd] (swap! closes conj fd) [0 0])\n                poller/cancel! (fn [& _] nil)\n                poller/forget! (fn [& _] nil)]\n    (f)))\n\n(defn bind-seam [r & {:keys [bind-host bind-port] :or {bind-host \"127.0.0.1\" bind-port 0}}]\n  (udp/bind! {:identity \"probe-test\" :deposit r :bind-host bind-host :bind-port bind-port}))\n\n(def descriptor {:dao.stream/type :dao.stream/datagram\n                 :dao.stream/identity \"probe-test\"\n                 :dao.stream.datagram/bind-host \"127.0.0.1\"\n                 :dao.stream.datagram/bind-port 40001})\n\n(def outbound {:dao.stream.datagram/destination\n               {:dao.stream.datagram/host \"127.0.0.1\" :dao.stream.datagram/port 40002}\n               :dao.stream.datagram/bytes \"BQY=\"})\n\n;; -----------------------------------------------------------------------------\n;; 1. Setup Failures: close-on-exec! and IPV6_V6ONLY (Fix 1)\n;; -----------------------------------------------------------------------------\n\n(fake-host\n  (fn []\n    (let [r (traffic)\n          seam (with-redefs [native/close-on-exec! (fn [_] false)]\n                 (bind-seam r))\n          evs (events r)]\n      (check 1 \"close-on-exec! failure closes acquired fd\"\n             (= [123] @closes)\n             {:closes @closes})\n      (check 1 \"close-on-exec! failure deposits bind-failed\"\n             (and (= 1 (count evs))\n                  (= :dao.stream.datagram/bind-failed (:dao.stream.datagram/event (first evs)))\n                  (= \"close-on-exec! failed\" (:dao.stream.datagram/reason (first evs))))\n             {:events evs})\n      (check 1 \"close-on-exec! returns failed-seam (inert close and step)\"\n             (and (= {:progressed? false} ((:step! seam)))\n                  (nil? ((:close! seam))))\n             {}))))\n\n(fake-host\n  (fn []\n    (let [r (traffic)\n          seam (with-redefs [native/set-int-option! (fn [& _] [-1 1])\n                             native/local-address (fn [_] {:ip \"::1\" :port 40001})]\n                 (bind-seam r :bind-host \"::1\"))\n          evs (events r)]\n      (check 1 \"IPV6_V6ONLY failure closes acquired fd\"\n             (= [123] @closes)\n             {:closes @closes})\n      (check 1 \"IPV6_V6ONLY failure deposits bind-failed with errno\"\n             (and (= 1 (count evs))\n                  (= :dao.stream.datagram/bind-failed (:dao.stream.datagram/event (first evs)))\n                  (= \"IPV6_V6ONLY failed: errno 1\" (:dao.stream.datagram/reason (first evs))))\n             {:events evs})\n      (check 1 \"IPV6_V6ONLY failure returns failed-seam\"\n             (= {:progressed? false} ((:step! seam)))\n             {}))))\n\n;; -----------------------------------------------------------------------------\n;; 2. Setup and Buffer Ownership Cleanup (Fix 2)\n;; -----------------------------------------------------------------------------\n\n(fake-host\n  (fn []\n    (let [r (traffic)\n          seam (with-redefs [native/local-address (fn [_] (throw (ex-info \"injected getsockname failure\" {})))]\n                 (bind-seam r))\n          evs (events r)]\n      (check 2 \"Setup exception closes acquired fd\"\n             (= [123] @closes)\n             {:closes @closes})\n      (check 2 \"Setup exception deposits bind-failed preserving original reason\"\n             (and (= 1 (count evs))\n                  (= :dao.stream.datagram/bind-failed (:dao.stream.datagram/event (first evs)))\n                  (= \"injected getsockname failure\" (:dao.stream.datagram/reason (first evs))))\n             {:events evs})\n      (check 2 \"Setup exception returns failed-seam\"\n             (= {:progressed? false} ((:step! seam)))\n             {}))))\n\n(fake-host\n  (fn []\n    (let [r (traffic)\n          orig-ms native/make-sockaddr\n          seam (with-redefs [native/make-sockaddr\n                             (fn [fam ip port]\n                               (if (= port 40001)\n                                 (throw (ex-info \"injected make-sockaddr failure\" {}))\n                                 (orig-ms fam ip port)))]\n                 (bind-seam r :bind-port 40001))\n          evs (events r)]\n      (check 2 \"make-sockaddr bind failure closes acquired fd\"\n             (= [123] @closes)\n             {:closes @closes})\n      (check 2 \"make-sockaddr bind failure deposits bind-failed\"\n             (and (= 1 (count evs))\n                  (= \"injected make-sockaddr failure\" (:dao.stream.datagram/reason (first evs))))\n             {:events evs}))))\n\n(fake-host\n  (fn []\n    ;; Verify send-fn buffer cleanup when second allocation throws\n    (let [r (traffic)\n          seam (bind-seam r)\n          orig-alloc ffi/alloc\n          orig-free ffi/free\n          orig-ms native/make-sockaddr\n          freed (atom [])]\n      (with-redefs [ffi/free (fn [p] (swap! freed conj p) (orig-free p))\n                    native/make-sockaddr (fn [fam ip port]\n                                           (if (= port 40002)\n                                             (throw (ex-info \"injected destination make-sockaddr error\" {}))\n                                             (orig-ms fam ip port)))]\n        (let [res (try ((:send! seam) \"127.0.0.1\" 40002 (byte-array 32))\n                       (catch Throwable t (ex-message t)))]\n          (check 2 \"send-fn frees payload buffer when destination sockaddr fails\"\n                 (pos? (count @freed))\n                 {:freed-count (count @freed) :res res}))))))\n\n(fake-host\n  (fn []\n    ;; Verify step-fn buffer cleanup when alloc-sockaddr throws\n    (let [r (traffic)\n          seam (bind-seam r)\n          orig-free ffi/free\n          freed (atom [])]\n      (with-redefs [ffi/free (fn [p] (swap! freed conj p) (orig-free p))\n                    native/alloc-sockaddr (fn [] (throw (ex-info \"injected alloc-sockaddr error\" {})))]\n        (let [res (try ((:step! seam))\n                       (catch Throwable t (ex-message t)))]\n          (check 2 \"step-fn frees receive buffer when alloc-sockaddr throws\"\n                 (pos? (count @freed))\n                 {:freed-count (count @freed) :res res}))))))\n\n;; -----------------------------------------------------------------------------\n;; 3. Fatal Descriptor Errors, Interruption and Diagnostics (Fix 3)\n;; -----------------------------------------------------------------------------\n\n(fake-host\n  (fn []\n    ;; Fatal error: ENOTSOCK (88)\n    (let [r (traffic)\n          seam (bind-seam r)\n          calls (atom 0)]\n      (binding [udp/*recvfrom* (fn [& _] (swap! calls inc) [-1 88])]\n        (let [turn1 ((:step! seam))\n              turn2 ((:step! seam))\n              turn3 ((:step! seam))\n              evs (events r)\n              diag (udp/diagnostics seam)]\n          (check 3 \"Fatal receive error returns not progressed\"\n                 (and (= {:progressed? false} turn1)\n                      (= {:progressed? false} turn2)\n                      (= {:progressed? false} turn3))\n                 {:turns [turn1 turn2 turn3]})\n          (check 3 \"Fatal receive error closes fd once\"\n                 (= [123] @closes)\n                 {:closes @closes})\n          (check 3 \"Fatal receive error deposits bound then closed\"\n                 (and (= 2 (count evs))\n                      (= :dao.stream.datagram/bound (:dao.stream.datagram/event (first evs)))\n                      (= :dao.stream.datagram/closed (:dao.stream.datagram/event (second evs))))\n                 {:events evs})\n          (check 3 \"Fatal receive error stops turn and ceases retrying\"\n                 (= 1 @calls)\n                 {:calls @calls})\n          (check 3 \"Fatal receive error retains diagnostic with errno\"\n                 (and (seq diag)\n                      (= 88 (:errno (last diag)))\n                      (= :fatal-descriptor-error (:kind (last diag))))\n                 {:diagnostics diag})\n          ;; Repeated close! is idempotent\n          ((:close! seam))\n          (check 3 \"Subsequent close! is idempotent\"\n                 (= [123] @closes)\n                 {:closes @closes}))))))\n\n(fake-host\n  (fn []\n    ;; Fatal error: EBADF (9)\n    (let [r (traffic)\n          seam (bind-seam r)\n          calls (atom 0)]\n      (binding [udp/*recvfrom* (fn [& _] (swap! calls inc) [-1 9])]\n        (let [turn1 ((:step! seam))\n              evs (events r)]\n          (check 3 \"EBADF fatal error closes fd once\"\n                 (= [123] @closes)\n                 {:closes @closes})\n          (check 3 \"EBADF deposits closed event\"\n                 (= :dao.stream.datagram/closed (:dao.stream.datagram/event (last evs)))\n                 {:events evs})\n          (check 3 \"EBADF retains diagnostic with errno 9\"\n                 (= 9 (:errno (last (udp/diagnostics seam))))\n                 {:diagnostics (udp/diagnostics seam)}))))))\n\n(fake-host\n  (fn []\n    ;; Recoverable interruption: EINTR (4)\n    (let [r (traffic)\n          seam (bind-seam r)\n          calls (atom 0)]\n      (binding [udp/*recvfrom* (fn [& _] (swap! calls inc) [-1 4])]\n        (let [turn1 ((:step! seam))\n              diag (udp/diagnostics seam)]\n          (check 3 \"EINTR does not progress turn\"\n                 (= {:progressed? false} turn1)\n                 {:turn1 turn1})\n          (check 3 \"EINTR does not close fd\"\n                 (empty? @closes)\n                 {:closes @closes})\n          (check 3 \"EINTR retains recoverable diagnostic with errno 4\"\n                 (and (seq diag)\n                      (= 4 (:errno (last diag)))\n                      (= :interrupted (:kind (last diag))))\n                 {:diagnostics diag})))\n      ;; Socket remains open and usable for subsequent turns\n      (let [turn (atom 0)]\n        (binding [udp/*recvfrom* (fn [fd buf cap flags rsa rlenp]\n                                   (swap! calls inc)\n                                   (if (zero? @turn)\n                                     (do (swap! turn inc)\n                                         (ffi/write rlenp :int 16 0)\n                                         [10 0])\n                                     [-1 udp/EAGAIN]))]\n          (let [turn2 ((:step! seam))]\n            (check 3 \"Turn after EINTR recovers and receives packets\"\n                   (= {:progressed? true} turn2)\n                   {:turn2 turn2 :calls @calls})\n            (check 3 \"Datagram event deposited after recovery\"\n                   (datagram/datagram-event? (last (events r)))\n                   {:events (events r)})))))))\n\n(fake-host\n  (fn []\n    ;; Silent would-block: EAGAIN (11) and ENOBUFS (105)\n    (let [r (traffic)\n          seam (bind-seam r)]\n      (binding [udp/*recvfrom* (fn [& _] [-1 11])]\n        (let [t ((:step! seam))]\n          (check 3 \"EAGAIN returns {:progressed? false}\"\n                 (= {:progressed? false} t)\n                 {:turn t})\n          (check 3 \"EAGAIN does not close fd\"\n                 (empty? @closes)\n                 {:closes @closes})\n          (check 3 \"EAGAIN stays silent with no error diagnostics\"\n                 (empty? (udp/diagnostics seam))\n                 {:diagnostics (udp/diagnostics seam)})))\n      (binding [udp/*recvfrom* (fn [& _] [-1 105])]\n        (let [t ((:step! seam))]\n          (check 3 \"ENOBUFS returns {:progressed? false}\"\n                 (= {:progressed? false} t)\n                 {:turn t})\n          (check 3 \"ENOBUFS does not close fd\"\n                 (empty? @closes)\n                 {:closes @closes})\n          (check 3 \"ENOBUFS stays silent with no error diagnostics\"\n                 (empty? (udp/diagnostics seam))\n                 {:diagnostics (udp/diagnostics seam)}))))))\n\n;; -----------------------------------------------------------------------------\n;; 4. Production Writer Contract Assertions (Preserving Reviewer Checks)\n;; -----------------------------------------------------------------------------\n\n(fake-host\n  (fn []\n    (doseq [[label result] [[:eagain [-1 udp/EAGAIN]] [:enobufs [-1 udp/ENOBUFS]]\n                            [:emsgsize [-1 udp/EMSGSIZE]] [:eintr [-1 4]] [:short [1 0]]]]\n      (let [r (traffic)\n            seam (bind-seam r)\n            w (datagram/writer seam descriptor)\n            calls (atom 0)]\n        (binding [udp/*sendto* (fn [& _] (swap! calls inc) result)\n                  udp/*recvfrom* (fn [& _] [-1 udp/EAGAIN])]\n          (check 4 (str label \" outcome is transport-error\")\n                 (= :dao.stream/transport-error (:dao.stream/outcome (stream/append! w outbound)))\n                 {})\n          (check 4 (str label \" syscall count is 1\")\n                 (= 1 @calls)\n                 {:calls @calls})\n          (check 4 (str label \" failure count is 1\")\n                 (= 1 (count (filter #(= :dao.stream.datagram/send-failed\n                                         (:dao.stream.datagram/event %)) (events r))))\n                 {})\n          ((:step! seam)) ((:step! seam))\n          (check 4 (str label \" no replay on step\")\n                 (= 1 @calls)\n                 {:calls @calls})\n          (stream/close! w) (stream/close! w)\n          (check 4 (str label \" writer append after close returns :dao.stream/closed\")\n                 (= :dao.stream/closed (:dao.stream/outcome (stream/append! w outbound)))\n                 {:outcome (:dao.stream/outcome (stream/append! w outbound))})\n          (check 4 (str label \" step after close answers {:progressed? false}\")\n                 (= {:progressed? false} ((:step! seam)))\n                 {}))))))\n\n(fake-host\n  (fn []\n    (let [r (traffic) seam (bind-seam r) calls (atom 0)]\n      (binding [udp/*recvfrom* (fn [& _] (swap! calls inc) [1201 0])]\n        (check 4 \"oversize progress is true\"\n               (= {:progressed? true} ((:step! seam)))\n               {})\n        (check 4 \"bounded receives max 64\"\n               (= 64 @calls)\n               {:calls @calls})\n        (check 4 \"oversize dropped without packet delivery\"\n               (= 1 (count (events r))) ; bound only\n               {:events (events r)}))\n      (binding [udp/*recvfrom* (fn [& _] [-1 udp/EAGAIN])]\n        (check 4 \"empty turn answers {:progressed? false}\"\n               (= {:progressed? false} ((:step! seam)))\n               {}))\n      ((:close! seam)) ((:close! seam))\n      (check 4 \"close! closes fd once\"\n             (= [123] @closes)\n             {:closes @closes}))))\n\n(println (str \"SUMMARY \" (+ @pass-count @fail-count) \" assertions: \"\n              @pass-count \" pass, \" @fail-count \" fail\"))\n(if (pos? @fail-count)\n  (System/exit 1)\n  (System/exit 0))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '70,215p' src/jolt/dao/stream/udp.jolt && sed -n '215,335p' src/jolt/dao/stream/udp.jolt && cat src/dev/jolt_udp_failures_probe.sh && command -v bb clojure mise && sed -n '160,228p' src/dev/jolt_j2_lane.clj && cat test/resources/yin/repl/jolt-applicability.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '70,215p' src/jolt/dao/stream/udp.jolt && sed -n '215,335p' src/jolt/dao/stream/udp.jolt && cat src/dev/jolt_udp_failures_probe.sh && command -v bb clojure mise && sed -n '160,228p' src/dev/jolt_j2_lane.clj && cat test/resources/yin/repl/jolt-applicability.edn\"","aggregated_output":"  [config]\n  (common/make-attacher ->UdpHandle config))\n\n\n;; =============================================================================\n;; Native Datagram Constants and Syscalls\n;; =============================================================================\n\n(def platform native/os)\n\n(def consts\n  (case platform\n    :macos {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 0x1001 :so-rcvbuf 0x1002\n            :eagain 35 :emsgsize 40 :enobufs 55 :ebadf 9 :eintr 4}\n    :linux {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 7 :so-rcvbuf 8\n            :eagain 11 :emsgsize 90 :enobufs 105 :ebadf 9 :eintr 4}\n    (throw (ex-info \"dao.stream.udp: unsupported platform\" {:platform platform}))))\n\n(def SOCK-DGRAM (:sock-dgram consts))\n(def IPPROTO-UDP (:ipproto-udp consts))\n(def EAGAIN (:eagain consts))\n(def ENOBUFS (:enobufs consts))\n(def EMSGSIZE (:emsgsize consts))\n(def EBADF (:ebadf consts))\n(def EINTR (:eintr consts))\n\n(ffi/defcfn c-sendto \"sendto\" [:int :pointer :size_t :int :pointer :uint] :ssize_t\n            {:capture-native-error true})\n\n(ffi/defcfn c-recvfrom \"recvfrom\" [:int :pointer :size_t :int :pointer :pointer] :ssize_t\n            {:capture-native-error true})\n\n(def ^:dynamic *sendto* c-sendto)\n(def ^:dynamic *recvfrom* c-recvfrom)\n\n\n;; =============================================================================\n;; Helpers\n;; =============================================================================\n\n(defn- parse-literal-host\n  \"Parse literal IP host (IPv4 or IPv6), stripping brackets if present.\n   Rejects hostnames like 'localhost'.\"\n  [h]\n  (try\n    (when (string? h)\n      (let [clean (if (and (str/starts-with? h \"[\") (str/ends-with? h \"]\"))\n                    (subs h 1 (dec (count h)))\n                    h)]\n        (if-let [[sa _] (native/make-sockaddr native/af-inet clean 0)]\n          (do (ffi/free sa) {:family native/af-inet :ip clean})\n          (if-let [[sa _] (native/make-sockaddr native/af-inet6 clean 0)]\n            (do (ffi/free sa) {:family native/af-inet6 :ip clean})\n            nil))))\n    (catch Throwable _ nil)))\n\n\n(defn- deposit-event!\n  [deposit event]\n  (try\n    (stream/append! deposit event)\n    (catch Throwable _ nil)))\n\n\n(defn- failed-seam\n  [deposit identity reason]\n  (deposit-event! deposit (datagram/bind-failed-event identity reason))\n  (let [diagnostics (atom [{:kind :bind-failed :reason reason}])]\n    {:send! (fn [_ _ _]\n              {:dao.stream/outcome :dao.stream/transport-error\n               :dao.stream.datagram/reason \"bind failed\"})\n     :close! (fn [] nil)\n     :step! (fn [] {:progressed? false})\n     :diagnostics diagnostics\n     :diagnostic (fn [] (last @diagnostics))}))\n\n\n;; =============================================================================\n;; Native Datagram Seam bind!\n;; =============================================================================\n\n(defn bind!\n  \"Bind one native datagram socket per the seam contract (§3).\n   `:bind-host` defaults to '127.0.0.1', `:bind-port` to 0 (ephemeral),\n   `:max-bytes` to 1200.\n   Returns {:send! f :close! f :step! f :diagnostics a :diagnostic f}.\"\n  [{:keys [identity deposit bind-host bind-port max-bytes]\n    :or {bind-host \"127.0.0.1\" bind-port 0}}]\n  (let [max-bytes (long (or max-bytes datagram/default-max-bytes))\n        parsed-bind (parse-literal-host bind-host)]\n    (if-not parsed-bind\n      (failed-seam deposit identity (str \"invalid bind-host literal: \" (pr-str bind-host)))\n      (let [family (:family parsed-bind)\n            bind-ip (:ip parsed-bind)\n            [fd sock-err] (native/c-socket family SOCK-DGRAM IPPROTO-UDP)]\n        (if (neg? fd)\n          (failed-seam deposit identity (str \"socket failed: errno \" sock-err))\n          (let [closed? (atom false)\n                close-fd! (fn []\n                            (when (compare-and-set! closed? false true)\n                              (try (poller/cancel! fd) (catch Throwable _ nil))\n                              (try (poller/forget! fd) (catch Throwable _ nil))\n                              (native/c-close fd)))]\n            (try\n              (if-not (native/close-on-exec! fd)\n                (do\n                  (close-fd!)\n                  (failed-seam deposit identity \"close-on-exec! failed\"))\n                (let [[r-nb err-nb] (native/set-blocking! fd false)]\n                  (if (neg? r-nb)\n                    (do\n                      (close-fd!)\n                      (failed-seam deposit identity (str \"O_NONBLOCK failed: errno \" err-nb)))\n                    (let [v6-fail (when (= family native/af-inet6)\n                                    (let [[r-v6 err-v6] (native/set-int-option! fd native/ipproto-ipv6 native/ipv6-v6only 1)]\n                                      (when (neg? r-v6)\n                                        (str \"IPV6_V6ONLY failed: errno \" err-v6))))]\n                      (if v6-fail\n                        (do\n                          (close-fd!)\n                          (failed-seam deposit identity v6-fail))\n                        (let [[sa len] (native/make-sockaddr family bind-ip bind-port)]\n                          (if-not sa\n                            (do\n                              (close-fd!)\n                              (failed-seam deposit identity (str \"make-sockaddr failed for \" bind-ip \":\" bind-port)))\n                            (let [[bind-r bind-err] (try\n                                                      (native/c-bind fd sa len)\n                                                      (finally (ffi/free sa)))]\n                              (if (neg? bind-r)\n                                (do\n                                  (close-fd!)\n                                  (failed-seam deposit identity (str \"bind failed: errno \" bind-err)))\n                                (let [local (native/local-address fd)]\n                                  (if-not local\n                                    (do\n                                      (close-fd!)\n                                      (failed-seam deposit identity \"getsockname failed\"))\n                                    (let [diagnostics (atom [])\n                                          close-fn\n                                          (fn []\n                                            (when (compare-and-set! closed? false true)\n                                              (try (poller/cancel! fd) (catch Throwable _ nil))\n                                              (try (poller/forget! fd) (catch Throwable _ nil))\n                                              (native/c-close fd)\n                                              (deposit-event! deposit (datagram/closed-event identity)))\n                                              (deposit-event! deposit (datagram/closed-event identity)))\n                                            nil)\n\n                                          send-fn\n                                          (fn [dest-host dest-port ^bytes payload]\n                                            (if @closed?\n                                              {:dao.stream/outcome :dao.stream/closed}\n                                              (let [parsed-dest (parse-literal-host dest-host)]\n                                                (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))\n                                                  (let [reason \"IP family mismatch\"]\n                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                    {:dao.stream/outcome :dao.stream/transport-error\n                                                     :dao.stream.datagram/reason reason})\n                                                  (let [len (bytes/length payload)\n                                                        buf (ffi/alloc (max 1 len))]\n                                                    (try\n                                                      (let [[dsa dlen] (native/make-sockaddr family (:ip parsed-dest) dest-port)]\n                                                        (try\n                                                          (if-not dsa\n                                                            (let [reason \"make-sockaddr failed for destination\"]\n                                                              (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                              {:dao.stream/outcome :dao.stream/transport-error\n                                                               :dao.stream.datagram/reason reason})\n                                                            (do\n                                                              (when (pos? len)\n                                                                (ffi/write-array buf payload))\n                                                              (let [[n e] (*sendto* fd buf len 0 dsa dlen)]\n                                                                (cond\n                                                                  (neg? n)\n                                                                  (let [reason (str \"sendto failed: errno \" e)]\n                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                                    {:dao.stream/outcome :dao.stream/transport-error\n                                                                     :dao.stream.datagram/reason reason})\n\n                                                                  (not= n len)\n                                                                  (let [reason (str \"short send: sent \" n \" of \" len \" bytes\")]\n                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))\n                                                                    {:dao.stream/outcome :dao.stream/transport-error\n                                                                     :dao.stream.datagram/reason reason})\n\n                                                                  :else\n                                                                  {:dao.stream/outcome :dao.stream/ok}))))\n                                                          (finally\n                                                            (when dsa (ffi/free dsa)))))\n                                                      (finally\n                                                        (ffi/free buf))))))))\n\n                                          step-fn\n                                          (fn []\n                                            (if @closed?\n                                              {:progressed? false}\n                                              (let [cap (inc max-bytes)\n                                                    buf (ffi/alloc cap)]\n                                                (try\n                                                  (let [[rsa rlenp] (native/alloc-sockaddr)]\n                                                    (try\n                                                      (let [progressed? (volatile! false)]\n                                                        (loop [budget 64]\n                                                          (when (pos? budget)\n                                                            (ffi/write rlenp :int native/sockaddr-storage-size 0)\n                                                            (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]\n                                                              (cond\n                                                                (neg? n)\n                                                                (cond\n                                                                  ;; would-block: silent\n                                                                  (or (= e EAGAIN) (= e ENOBUFS))\n                                                                  nil\n\n                                                                  ;; interruption: recoverable, no retry inside turn\n                                                                  (= e EINTR)\n                                                                  (swap! diagnostics conj\n                                                                         {:kind :interrupted\n                                                                          :errno e\n                                                                          :reason (str \"recvfrom interrupted: errno \" e)})\n\n                                                                  ;; fatal descriptor error: close seam once\n                                                                  :else\n                                                                  (do\n                                                                    (swap! diagnostics conj\n                                                                           {:kind :fatal-descriptor-error\n                                                                            :errno e\n                                                                            :reason (str \"recvfrom fatal error: errno \" e)})\n                                                                    (close-fn)))\n\n                                                                :else\n                                                                (do\n                                                                  (vreset! progressed? true)\n                                                                  (if (> n max-bytes)\n                                                                    ;; Oversize drop\n                                                                    (recur (dec budget))\n                                                                    (let [bs (if (zero? n)\n                                                                               (bytes/alloc 0)\n                                                                               (ffi/read-array buf n))\n                                                                          src-ip (native/sockaddr-ip rsa)\n                                                                          src-port (native/sockaddr-port rsa)]\n                                                                      (deposit-event! deposit\n                                                                                      (datagram/datagram-event identity src-ip src-port bs))\n                                                                      (recur (dec budget)))))))))\n                                                        {:progressed? @progressed?})\n                                                      (finally\n                                                        (when rsa (ffi/free rsa))\n                                                        (when rlenp (ffi/free rlenp)))))\n                                                  (finally\n                                                    (ffi/free buf))))))\n\n                                          seam {:send! send-fn\n                                                :close! close-fn\n                                                :step! step-fn\n                                                :diagnostics diagnostics\n                                                :diagnostic (fn [] (last @diagnostics))}]\n                                      (deposit-event! deposit (datagram/bound-event identity (:ip local) (:port local)))\n                                      seam))))))))))))\n              (catch Throwable t\n                (close-fd!)\n                (failed-seam deposit identity (or (ex-message t) (str t)))))))))))\n#!/bin/sh\n# J7 UDP failure-injection probe runner, macOS arm64 and Linux x86_64. POSIX sh.\ndir=$(cd \"$(dirname \"$0\")\" && pwd)\n\nif [ -z \"$JOLT_CHEZ\" ] && [ -f build/tools/jolt-env.sh ]; then\n  . build/tools/jolt-env.sh\nfi\nif [ -z \"$JOLT\" ]; then\n  if [ -x build/tools/jolt/bin/jolt ]; then\n    JOLT=build/tools/jolt/bin/jolt\n  else\n    JOLT=build/jolt-spike/jolt/bin/jolt\n  fi\nfi\nif [ -z \"$JOLT_CHEZ\" ]; then\n  mise_chez=\"$HOME/.local/share/mise/installs/chezscheme/10.4.1/bin/scheme\"\n  [ -x \"$mise_chez\" ] && JOLT_CHEZ=$mise_chez\nfi\n[ -n \"$JOLT_CHEZ\" ] && export JOLT_CHEZ\n\n\"$JOLT\" -Srepro -M:jolt \"$dir/jolt_udp_failures_probe.clj\"\nrc=$?\necho \"exit: $rc\"\nexit $rc\n/usr/local/bin/clojure\n/home/sto/.local/bin/mise\n    :owner \"jolt seat (design 9.4 ruling)\"}\n   {:ns \"dao.stream.ws-test\"\n    :reason \"requires dao.stream.transit\" :capability \"transit codec\"\n    :owner \"jolt seat (design 9.4 ruling)\"}\n   {:ns \"dao.stream.ws-project-test\"\n    :reason \"requires dao.stream.transit\" :capability \"transit codec\"\n    :owner \"jolt seat (design 9.4 ruling)\"}\n   {:ns \"dao.stream.ws.jvm-test\"\n    :reason \"JVM websocket socket lane\" :capability \"ws sockets\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.ws.node-test\"\n    :reason \"Node websocket lane (cljs)\" :capability \"ws sockets + Node peer\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.ws.dart-test\"\n    :reason \"Dart websocket lane (cljd)\" :capability \"ws sockets + Dart peer\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.ws.browser-test\"\n    :reason \"browser websocket lane (cljs)\" :capability \"ws sockets + browser\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.ws-project-cross-jvm-test\"\n    :reason \"cross-host ws peer suite\" :capability \"ws sockets + peer\" :owner \"J6/J7 (J2b oracle)\"}\n   {:ns \"dao.stream.ws-project-cross-node-test\"\n    :reason \"cross-host ws peer suite (Node)\" :capability \"ws sockets + Node peer\"\n    :owner \"J6/J7 (J2b oracle)\"}\n   {:ns \"dao.stream.ws-project-jvm-test\"\n    :reason \"cross-host ws peer suite (JVM)\" :capability \"ws sockets + peer\" :owner \"J6/J7 (J2b oracle)\"}\n   {:ns \"dao.stream.udp-test\"\n    :reason \"J7 slice 1 landed; portable suite passing on jolt test runner, excluded from J2 core lane pending full J7 acceptance\"\n    :capability \"udp sockets\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.udp-raw-test\"\n    :reason \"J7 slice 1 landed; portable suite passing on jolt test runner, excluded from J2 core lane pending full J7 acceptance\"\n    :capability \"udp sockets\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.datagram.jvm-test\"\n    :reason \"JVM datagram socket fixture; jolt native UDP host seam landed in slice 1\"\n    :capability \"udp sockets\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.datagram.node-test\"\n    :reason \"Node datagram lane (cljs); jolt native UDP host seam landed in slice 1\"\n    :capability \"udp sockets + Node\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.datagram.dart-test\"\n    :reason \"Dart datagram lane (cljd); jolt native UDP host seam landed in slice 1\"\n    :capability \"udp sockets + Dart\" :owner \"J6/J7\"}\n   {:ns \"dao.jing.stream-test\"\n    :reason \"requires dao.stream.transit (missed by the round-1 manifest; found by the round-2 load evidence)\"\n    :capability \"transit codec\" :owner \"jolt seat (design 9.4 ruling)\"}\n   {:ns \"dao.jing.dht.socket-test\"\n    :reason \"binds real JVM datagram sockets; native jolt process acceptance open per design §§6-7\"\n    :capability \"udp sockets\" :owner \"J6/J7\"}\n   {:ns \"yin.vm.ffi.remote-serve-test\"\n    :reason \"the FFI remote serve suite\" :capability \"FFI-remote\" :owner \"J7\"}\n   {:ns \"yin.vm.ffi.remote-serve.responder-test\"\n    :reason \"the FFI remote responder suite\" :capability \"FFI-remote\" :owner \"J7\"}\n   {:ns \"yin.vm.ucf.stage-e-process-test\"\n    :reason \"spawns child processes\" :capability \"child processes\" :owner \"J7\"}\n   {:ns \"yin.vm.linker.cross-host-transfer-test\"\n    :reason \"cross-host transfer over dao.stream.transit + remote peers\"\n    :capability \"transit codec + peer\" :owner \"J2b + J6/J7\"}\n   {:ns \"dao.space.dht-test\"\n    :reason \"J7 slice 1+2 landed; multi-process network DHT acceptance open per design §§6-7\"\n    :capability \"udp datagram host seam (java.net.DatagramSocket)\" :owner \"J6/J7\"}\n   {:ns \"yin.vm.linker.dht-test\"\n    :reason \"J7 slice 1+2 landed; multi-process network DHT acceptance open per design §§6-7\"\n    :capability \"udp datagram host seam\" :owner \"J6/J7\"}\n   {:ns \"yin.vm.linker.dht-end-to-end-test\"\n    :reason \"J7 slice 1+2 landed; multi-process network DHT acceptance open per design §§6-7\"\n    :capability \"udp datagram host seam + yin.repl\" :owner \"J6/J7 + J3\"}\n   {:ns \"yin.vm.linker.head-board-test\"\n    :reason \"J7 slice 1+2 landed; board fixture requires Transit; CBOR-only process acceptance open per design §§6-7\"\n    :capability \"udp datagram host seam\" :owner \"J6/J7\"}\n   {:ns \"yin.vm.linker.head-follow-test\"\n    :reason \"J7 slice 1+2 landed; multi-process head follower acceptance open per design §§6-7\"\n    :capability \"udp datagram host seam\" :owner \"J6/J7\"}\n   {:ns \"dao.stream.ble-test\"\n    :reason \"BLE radio transport tests (dao.stream.ble)\"\n;; Per-def