{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/dev/jolt_launch.clj\nnl -ba src/dev/jolt_target_run.clj\nnl -ba src/dev/jolt_shell_session.clj\nnl -ba test/yin/repl/shell_session_test.clj'","aggregated_output":"     1\t;; Target-aware jolt launcher seam (Lane B, astra plan C5).\n     2\t;;\n     3\t;; One place resolves HOW a jolt child process is launched, from an explicit\n     4\t;; target (default :chez, so every existing caller is unchanged):\n     5\t;;\n     6\t;;   :chez   -> \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\"\n     7\t;;               -Srepro -M:jolt[...] script args...\"\n     8\t;;             (the invocation every existing launcher uses today)\n     9\t;;   :gambit -> \". build/tools/jolt-env.sh && exec \\\"$JOLT_GAMBIT\\\" ...\"\n    10\t;;             (gsi resolved by bb bootstrap:jolt into JOLT_GAMBIT; the\n    11\t;;             fork's own gates invoke the same binary directly, e.g.\n    12\t;;             `sh host/gambit/ffi/watchdog.sh 120 \"$GAMBIT_GSI\"\n    13\t;;             host/gambit/gambitcheck.ss` under GAMBIT_PREFIX — see\n    14\t;;             host/gambit/ffi/README.md in the jolt checkout)\n    15\t;;\n    16\t;; Every launch exports JOLT_TARGET=<chez|gambit> into the child; the child\n    17\t;; (or the driver on its behalf) prints the identity line\n    18\t;; \"jolt-target: <target>\" and the driver ASSERTS the observed line equals the\n    19\t;; requested target before trusting any pass/fail. Absent line or mismatch is\n    20\t;; a failure (fail-closed): a Chez result can never qualify a Gambit claim.\n    21\t;;\n    22\t;; Babashka-only (bb script), like the rest of src/dev/jolt_*.\n    23\t(ns jolt-launch\n    24\t  (:require [babashka.process :as p]\n    25\t            [clojure.string :as str]))\n    26\t\n    27\t\n    28\t(def known-targets #{:chez :gambit})\n    29\t\n    30\t\n    31\t(defn resolve-target\n    32\t  \"Resolve `t` (nil, \\\"chez\\\", \\\"gambit\\\", :chez, :gambit) to a known target\n    33\t   keyword; nil answers :chez (today's default). Anything else throws.\"\n    34\t  [t]\n    35\t  (let [t (cond\n    36\t            (nil? t) :chez\n    37\t            (keyword? t) t\n    38\t            :else (keyword (str/trim (str t))))]\n    39\t    (when-not (known-targets t)\n    40\t      (throw (ex-info (str \"unknown jolt target \" (pr-str (str t))\n    41\t                           \" (known: \" (pr-str (sort (map name known-targets))) \")\")\n    42\t                      {:target t})))\n    43\t    t))\n    44\t\n    45\t\n    46\t(defn parse-target-arg\n    47\t  \"Pull [--target <t> | --target=<t>] out of `args`; answers\n    48\t   [target remaining-args]. Throws on an unknown target or a trailing bare\n    49\t   --target with no value.\"\n    50\t  [args]\n    51\t  (loop [args (vec args) target nil acc []]\n    52\t    (if (seq args)\n    53\t      (let [a (first args)]\n    54\t        (cond\n    55\t          (= \"--target\" a)\n    56\t          (do (when-not (seq (rest args))\n    57\t                (throw (ex-info \"--target needs a value (chez or gambit)\"\n    58\t                                {:arg a})))\n    59\t              (recur (subvec args 2) (resolve-target (nth args 1)) acc))\n    60\t          (str/starts-with? a \"--target=\") (recur (subvec args 1) (resolve-target (subs a 9)) acc)\n    61\t          :else (recur (subvec args 1) target (conj acc a))))\n    62\t      [(or target :chez) (vec acc)])))\n    63\t\n    64\t\n    65\t(def identity-prefix \"jolt-target: \")\n    66\t\n    67\t\n    68\t(defn identity-line\n    69\t  \"The exact identity line the CHILD prints for `target`.\"\n    70\t  [target]\n    71\t  (str identity-prefix (name (resolve-target target))))\n    72\t\n    73\t\n    74\t(defn child-target\n    75\t  \"The target a child reports for itself from its environment: JOLT_TARGET\n    76\t   when set, :chez otherwise (every existing launcher is a Chez one).\"\n    77\t  []\n    78\t  (resolve-target (System/getenv \"JOLT_TARGET\")))\n    79\t\n    80\t\n    81\t(defn launch-command\n    82\t  \"The sh -c command string that runs `script` (a path relative to the\n    83\t   repo root, or nil for stdin/-e style use) under `target`, with \\\"$@\\\"\n    84\t   carrying extra arguments. `alias` extends the -M: alias for :chez\n    85\t   (e.g. \\\"jolt-test\\\"). The child sees JOLT_TARGET so it can report its\n    86\t   own identity.\"\n    87\t  [{:keys [target script alias]}]\n    88\t  (let [target (resolve-target target)\n    89\t        alias (if (seq alias) (str \":\" alias) \"\")\n    90\t        script (if script (str \" \" script \" \"))\n    91\t        script (or script \" \")]\n    92\t    (case target\n    93\t      :chez (str \". build/tools/jolt-env.sh && export JOLT_TARGET=chez\"\n    94\t                 \" && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt\" alias script \"\\\"$@\\\"\")\n    95\t      :gambit (str \". build/tools/jolt-env.sh && export JOLT_TARGET=gambit\"\n    96\t                   \" && exec \\\"$JOLT_GAMBIT\\\"\" script \"\\\"$@\\\"\"))))\n    97\t\n    98\t\n    99\t(defn run-child\n   100\t  \"Run `script` with `args` under `target` (default :chez) via\n   101\t   launch-command; answers the babashka process result map with :out/:err\n   102\t   strings. `dir` selects the working directory (default: repo root).\"\n   103\t  [{:keys [target script alias dir] :or {dir \".\"}} & args]\n   104\t  (let [cmd (launch-command {:target target :script script :alias alias})\n   105\t        r (apply p/shell {:dir dir :out :string :err :string :continue true}\n   106\t                 \"sh\" \"-c\" cmd \"jolt\" (map str args))]\n   107\t    {:exit (:exit r) :out (str (:out r)) :err (str (:err r))\n   108\t     :target (resolve-target target)}))\n   109\t\n   110\t\n   111\t(defn assert-child-target!\n   112\t  \"Fail-closed gate: `output` (the child's combined stdout+err) must contain\n   113\t   the exact identity line of `target`. Throws with a diagnosis naming the\n   114\t   observed line when the line is absent or names another host — the caller\n   115\t   must not trust any pass/fail of such a child.\"\n   116\t  [{:keys [target output context]}]\n   117\t  (let [target (resolve-target target)\n   118\t        want (identity-line target)\n   119\t        observed (some #(when (str/starts-with? % identity-prefix)\n   120\t                          (str/trim %))\n   121\t                       (str/split-lines (str output)))\n   122\t        ok? (and observed (= observed want))]\n   123\t    (when-not ok?\n   124\t      (throw (ex-info (str \"jolt child target mismatch\"\n   125\t                           (when context (str \" (\" context \")\"))\n   126\t                           \": expected \" (pr-str want)\n   127\t                           \", observed \" (pr-str observed)\n   128\t                           \" — refusing to trust this child's result\")\n   129\t                      {:wanted target :observed observed})))\n   130\t    target))\n   131\t\n   132\t\n   133\t;; The child-side identity print, for repo scripts that run UNDER jolt (where\n   134\t;; the bb seam namespace cannot load): scripts embed this one line near their\n   135\t;; entry. Silent when JOLT_TARGET is unset, so dual-host scripts (JVM leg) and\n   136\t;; legacy invocations keep their output byte-identical.\n   137\t(def child-print-snippet\n   138\t  \"(when-let [t (System/getenv \\\"JOLT_TARGET\\\")] (println (str \\\"jolt-target: \\\" t)))\")\n   139\t\n   140\t\n   141\t(def ^:private identity-probe-forms\n   142\t  {:chez \"(do (println (str \\\"jolt-target: \\\" (or (System/getenv \\\"JOLT_TARGET\\\") \\\"chez\\\"))))\"\n   143\t   :gambit \"(begin (display \\\"jolt-target: \\\")(display (or (getenv \\\"JOLT_TARGET\\\") \\\"gambit\\\"))(newline))\"})\n   144\t\n   145\t\n   146\t(defn identity-probe-form\n   147\t  \"The -e form a trivial identity child evaluates under `target` (chez:\n   148\t   bin/jolt -e evaluates Clojure; gambit: gsi -e evaluates Scheme).\"\n   149\t  [target]\n   150\t  (get identity-probe-forms (resolve-target target)))\n   151\t\n   152\t\n   153\t(defn require-chez!\n   154\t  \"Fail-closed refusal for lanes whose children are Chez-tier only (the\n   155\t   fork's Gambit FFI tier carries no native wrapper / build CLI yet —\n   156\t   host/gambit/ffi/README.md): `lane` names the refusing driver in the error.\"\n   157\t  [target lane]\n   158\t  (when (= :gambit (resolve-target target))\n   159\t    (binding [*out* *err*]\n   160\t      (println lane \"FAILED: target gambit is not qualified for this lane;\"\n   161\t               \"the Gambit FFI tier does not carry it yet\"\n   162\t               \"(jolt fork host/gambit/ffi/README.md); refusing to run\"))\n   163\t    (System/exit 1)))\n   164\t\n   165\t\n   166\t(defn preflight!\n   167\t  \"Fail-closed identity preflight for a driver: run a trivial child through\n   168\t   the same launch seam and assert it reports `target` itself, before any\n   169\t   real child's pass/fail is trusted. `context` names the driver in errors.\"\n   170\t  [target context]\n   171\t  (let [t (resolve-target target)\n   172\t        r (run-child {:target t} \"-e\" (identity-probe-form t))]\n   173\t    (assert-child-target! {:target t\n   174\t                           :output (str (:out r) (:err r))\n   175\t                           :context context})\n   176\t    (println \"PASS identity gate: child reported\" (identity-line t))\n   177\t    t))\n     1\t;; bb -cp src/dev src/dev/jolt_target_run.clj — the Lane B generic\n     2\t;; target-aware jolt task driver (astra plan C5). Two modes:\n     3\t;;\n     4\t;;   --script <path> [--alias <alias>] -- <child args...>\n     5\t;;       Run the repo script as a jolt child through the jolt-launch seam\n     6\t;;       (the same command string the task used before, plus the exported\n     7\t;;       JOLT_TARGET), ASSERT the child's own \"jolt-target: <target>\" line\n     8\t;;       fail-closed, and propagate its exit only after the gate passes.\n     9\t;;       The child prints the line via the seam's child-print-snippet.\n    10\t;;\n    11\t;;   (no --script) -- <args passed to the jolt binary...>\n    12\t;;       Passthrough (the old `bb jolt` behavior): an arbitrary child's\n    13\t;;       output cannot be forced to carry the identity line, so the driver\n    14\t;;       runs the fail-closed identity preflight child first and only then\n    15\t;;       passes the arguments through unchanged.\n    16\t;;\n    17\t;; --target chez (default) or --target gambit. Babashka-only.\n    18\t(ns jolt-target-run\n    19\t  (:require [jolt-launch :as jlt]))\n    20\t\n    21\t\n    22\t;; babashka does NOT flush its buffered stdout before System/exit — every\n    23\t;; relayed output must be printed AND flushed, or the child's output is lost\n    24\t;; (review round 3, P1-A).\n    25\t(defn- emit!\n    26\t  \"Print `x` to `w` (default *out*) and flush immediately.\"\n    27\t  ([x] (print x) (flush))\n    28\t  ([w x] (binding [*out* w] (print x) (flush))))\n    29\t\n    30\t\n    31\t(let [[target args] (jlt/parse-target-arg *command-line-args*)\n    32\t      [mode script alias child-args]\n    33\t      (loop [xs args script nil alias nil]\n    34\t        (cond\n    35\t          (nil? (seq xs)) [:passthrough nil nil []]\n    36\t          (= \"--script\" (first xs)) (recur (nnext xs) (second xs) alias)\n    37\t          (= \"--alias\" (first xs)) (recur (nnext xs) script (second xs))\n    38\t          (= \"--\" (first xs)) (if script\n    39\t                                [:script script alias (vec (rest xs))]\n    40\t                                [:passthrough nil nil (vec (rest xs))])\n    41\t          :else [:passthrough script alias (vec xs)]))]\n    42\t  (println \"== jolt-target-run\" (name target)\n    43\t           (when script (str \"--script \" script)))\n    44\t  (flush)\n    45\t  (if (= :script mode)\n    46\t    ;; Known repo child: assert the child's own identity line before\n    47\t    ;; trusting its exit. The child is a Clojure script, so :gambit (a bare\n    48\t    ;; gsi) cannot run it — refused fail-closed; use bb smoke:jolt-target\n    49\t    ;; for the Gambit host-scheme smoke.\n    50\t    (do (jlt/require-chez! target (str \"jolt-target-run --script \" script))\n    51\t        (let [{:keys [exit out err]} (jlt/run-child {:target target\n    52\t                                                     :script script\n    53\t                                                     :alias alias}\n    54\t                                                    child-args)\n    55\t              combined (str out err)]\n    56\t          (emit! out)\n    57\t          (emit! *err* err)\n    58\t          (flush)\n    59\t          (jlt/assert-child-target! {:target target :output combined\n    60\t                                     :context (str \"jolt-target-run --script \" script)})\n    61\t          (when-not (zero? exit)\n    62\t            (println \"jolt-target-run: child exited\" exit)\n    63\t            (flush))\n    64\t          (System/exit exit)))\n    65\t    ;; Passthrough: preflight identity gate, then hand the arguments to the\n    66\t    ;; child unchanged.\n    67\t    (let [{:keys [exit out err]} (jlt/run-child {:target target}\n    68\t                                                \"-e\" (jlt/identity-probe-form target))]\n    69\t      (jlt/assert-child-target! {:target target\n    70\t                                 :output (str out err)\n    71\t                                 :context \"jolt-target-run passthrough preflight\"})\n    72\t      (emit! (str out \"\\n\"))\n    73\t      (when-not (zero? exit)\n    74\t        (println \"jolt-target-run: preflight child exited\" exit)\n    75\t        (flush)\n    76\t        (System/exit exit))\n    77\t      (println \"PASS identity gate: child reported\" (jlt/identity-line target))\n    78\t      (flush)\n    79\t      ;; The real child, byte-identical command shape, exit propagated.\n    80\t      (let [{:keys [exit out err]} (apply jlt/run-child\n    81\t                                          {:target target}\n    82\t                                          child-args)]\n    83\t        (emit! out)\n    84\t        (emit! *err* err)\n    85\t        (flush)\n    86\t        (System/exit exit)))))\n     1\t;; Lane B target-awareness (C5): --target chez (the default, unchanged) or\n     2\t;; --target gambit, refused fail-closed — the REPL transcript lane is\n     3\t;; Chez-tier (fork host/gambit/ffi/README.md). A trivial child through the\n     4\t;; launch seam must report the requested target itself before a transcript\n     5\t;; verdict is trusted. The REPL children intentionally get NO JOLT_TARGET:\n     6\t;; their output is compared byte-for-byte between the hosts, and an identity\n     7\t;; line would corrupt the transcript contract.\n     8\t(when-not (resolve 'jolt-launch/run-child)\n     9\t  ((requiring-resolve 'babashka.classpath/add-classpath) \"src/dev\"))\n    10\t\n    11\t\n    12\t(ns jolt-shell-session\n    13\t  \"Foreground process transcripts, one corpus and two host lanes. A held\n    14\t   stdin pipe proves typed quit without EOF. Every wait has a deadline;\n    15\t   mismatches fail, including unlisted reader differences. Raw output and\n    16\t   timings remain under build/j3-logs/shell. Not a deployed sidecar.\"\n    17\t  (:require [babashka.fs :as fs]\n    18\t            [babashka.process :as p]\n    19\t            [clojure.edn :as edn]\n    20\t            [clojure.string :as str]\n    21\t            [jolt-launch :as jlt]))\n    22\t\n    23\t\n    24\t(def ^:private cli\n    25\t  (let [[t remaining] (jlt/parse-target-arg *command-line-args*)]\n    26\t    {:target t :args (vec remaining)}))\n    27\t\n    28\t\n    29\t(def prompt \"yin> \")\n    30\t(def timeout-ms 180000)\n    31\t\n    32\t\n    33\t(defn now\n    34\t  []\n    35\t  (System/currentTimeMillis))\n    36\t\n    37\t\n    38\t(defn fail!\n    39\t  [message data]\n    40\t  (throw (ex-info message data)))\n    41\t\n    42\t\n    43\t(defn await!\n    44\t  [pred process deadline description]\n    45\t  (loop []\n    46\t    (cond\n    47\t      (pred) true\n    48\t      (not (.isAlive process)) (fail! (str \"process ended waiting for \" description) {})\n    49\t      (> (now) deadline) (fail! (str \"deadline waiting for \" description) {})\n    50\t      :else (do (Thread/sleep 5) (recur)))))\n    51\t\n    52\t\n    53\t(defn expected\n    54\t  [host value]\n    55\t  (if (and (map? value) (contains? value host)) (get value host) value))\n    56\t\n    57\t\n    58\t(defn matches?\n    59\t  [host wanted actual]\n    60\t  (let [wanted (expected host wanted)]\n    61\t    (if (and (map? wanted) (:re wanted))\n    62\t      (boolean (re-matches (re-pattern (:re wanted)) actual))\n    63\t      (= wanted actual))))\n    64\t\n    65\t\n    66\t(defn normalized\n    67\t  [text]\n    68\t  (-> text (str/replace #\"\\r\\n\" \"\\n\")\n    69\t      (str/replace #\"Host: (JVM|jolt) [^\\n]*\" \"<host>\") str/trim))\n    70\t\n    71\t\n    72\t(defn command\n    73\t  [host args]\n    74\t  (case host\n    75\t    :jolt (into [\"sh\" \"-c\"\n    76\t                 \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt:jolt-yin-repl --no-state \\\"$@\\\"\"\n    77\t                 \"jolt\"] args)\n    78\t    :jvm (into [\"clj\" \"-M:clj-yin-repl\" \"--no-state\"] args)))\n    79\t\n    80\t\n    81\t(defn run-session!\n    82\t  [host {:keys [id args in out quit exit startup-only idle-ms] :as case}]\n    83\t  (let [t0 (now)\n    84\t        process (.start (ProcessBuilder. ^java.util.List (command host args)))\n    85\t        stdout (atom \"\") stderr (atom \"\")\n    86\t        capture (fn [stream sink]\n    87\t                  (future\n    88\t                    (with-open [r (java.io.InputStreamReader. stream \"UTF-8\")]\n    89\t                      (loop []\n    90\t                        (let [c (.read r)]\n    91\t                          (when (not= -1 c)\n    92\t                            (swap! sink str (char c)) (recur)))))))\n    93\t        out-reader (capture (.getInputStream process) stdout)\n    94\t        err-reader (capture (.getErrorStream process) stderr)\n    95\t        writer (java.io.OutputStreamWriter. (.getOutputStream process) \"UTF-8\")\n    96\t        send! (fn [line] (.write writer (str line \"\\n\")) (.flush writer))\n    97\t        path (str \"build/j3-logs/shell/\" (name host) \"-\" (name id))\n    98\t        first-prompt (atom nil) latencies (atom [])]\n    99\t    (try\n   100\t      (when-not startup-only\n   101\t        (await! #(str/includes? @stdout prompt) process (+ t0 timeout-ms) \"first prompt\")\n   102\t        (reset! first-prompt (- (now) t0))\n   103\t        (println \"PROMPT\" (name host) id @first-prompt \"ms\")\n   104\t        (flush)\n   105\t        (when (= host :jolt)\n   106\t          (when-not (and (str/includes? @stdout \"Host: jolt \")\n   107\t                         (str/includes? @stdout \" / Chez \")\n   108\t                         (str/includes? @stdout \"python: the native C++ ANTLR4 parser\"))\n   109\t            (fail! \"missing jolt banner\" {:stdout @stdout})))\n   110\t        (when idle-ms (Thread/sleep idle-ms))\n   111\t        (doseq [[i line] (map-indexed vector in)]\n   112\t          (let [offset (count @stdout) sent (now)]\n   113\t            (send! line)\n   114\t            (await! #(str/includes? (subs @stdout offset) prompt)\n   115\t                    process (+ (now) timeout-ms) (str \"response \" i))\n   116\t            (swap! latencies conj (- (now) sent))\n   117\t            (let [actual (normalized (str/replace (subs @stdout offset) prompt \"\"))\n   118\t                  wanted (nth out i)]\n   119\t              (when-not (matches? host wanted actual)\n   120\t                (fail! \"transcript mismatch\" {:id id :line line :expected (expected host wanted)\n   121\t                                              :actual actual})))\n   122\t            (when (and idle-ms (zero? i))\n   123\t              (let [before @stdout]\n   124\t                (Thread/sleep idle-ms)\n   125\t                (when-not (= before @stdout)\n   126\t                  (fail! \"duplicate output while pending/idle\" {:id id :before before :after @stdout}))))))\n   127\t        (if (= quit :eof) (.close writer) (send! \"(quit)\")))\n   128\t      (when-not (.waitFor process timeout-ms java.util.concurrent.TimeUnit/MILLISECONDS)\n   129\t        (fail! \"deadline waiting for exit (stdin stays open for typed quit)\" {:id id}))\n   130\t      @out-reader @err-reader\n   131\t      (when-not (= exit (.exitValue process))\n   132\t        (fail! \"exit mismatch\" {:id id :expected exit :actual (.exitValue process)\n   133\t                                :stderr @stderr :stdout @stdout}))\n   134\t      (if startup-only\n   135\t        (when-not (matches? host out (normalized @stdout))\n   136\t          (fail! \"startup transcript mismatch\" {:id id :expected out :actual (normalized @stdout)}))\n   137\t        (when-not (str/ends-with? (str/trim @stdout) \"Bye\")\n   138\t          (fail! \"missing clean quit\" {:id id :stdout @stdout})))\n   139\t      {:host host :id id :status :pass :first-prompt-ms @first-prompt\n   140\t       :started-at (str (java.time.Instant/ofEpochMilli t0))\n   141\t       :elapsed-ms (- (now) t0) :submission-ms @latencies :exit (.exitValue process)\n   142\t       :jolt-divergence (:jolt-divergence case) :capability (:capability case)}\n   143\t      (finally\n   144\t        (when (.isAlive process) (.destroyForcibly process))\n   145\t        (spit (str path \".out\") @stdout)\n   146\t        (spit (str path \".err\") @stderr)))))\n   147\t\n   148\t\n   149\t(defn run-port-session!\n   150\t  \"J6e (C11): `--port 0` serves on jolt. The banner names the ephemeral\n   151\t   bind, the Serving line the bound port; a typed (quit) exits 0 once the\n   152\t   endpoint reports :stopped (Endpoint stopped: confirmed).\"\n   153\t  [host {:keys [id args]}]\n   154\t  (let [t0 (now)\n   155\t        process (.start (ProcessBuilder. ^java.util.List (command host args)))\n   156\t        stdout (atom \"\") stderr (atom \"\")\n   157\t        capture (fn [stream sink]\n   158\t                  (future\n   159\t                    (with-open [r (java.io.InputStreamReader. stream \"UTF-8\")]\n   160\t                      (loop []\n   161\t                        (let [c (.read r)]\n   162\t                          (when (not= -1 c)\n   163\t                            (swap! sink str (char c)) (recur)))))))\n   164\t        out-reader (capture (.getInputStream process) stdout)\n   165\t        err-reader (capture (.getErrorStream process) stderr)\n   166\t        writer (java.io.OutputStreamWriter. (.getOutputStream process) \"UTF-8\")\n   167\t        serving #\"Serving daostream:ws://127\\.0\\.0\\.1:(\\d+)/repl\"\n   168\t        path (str \"build/j3-logs/shell/\" (name host) \"-\" (name id))]\n   169\t    (try\n   170\t      (await! #(re-find serving @stdout) process (+ t0 timeout-ms) \"the Serving line\")\n   171\t      (let [port (parse-long (second (re-find serving @stdout)))]\n   172\t        (when-not (and (pos? port) (str/includes? @stdout \"serving on all interfaces on an ephemeral port\"))\n   173\t          (fail! \"ephemeral banner or bound port missing\" {:stdout @stdout}))\n   174\t        (.write writer \"(quit)\\n\")\n   175\t        (.flush writer)\n   176\t        (when-not (.waitFor process timeout-ms java.util.concurrent.TimeUnit/MILLISECONDS)\n   177\t          (fail! \"deadline waiting for exit after (quit)\" {:id id}))\n   178\t        @out-reader @err-reader\n   179\t        (when-not (zero? (.exitValue process))\n   180\t          (fail! \"exit mismatch\" {:id id :expected 0 :actual (.exitValue process) :stderr @stderr}))\n   181\t        (when-not (and (str/includes? @stdout \"Bye\")\n   182\t                       (str/ends-with? (str/trim @stdout) \"Endpoint stopped: confirmed\"))\n   183\t          (fail! \"missing clean quit after :stopped\" {:id id :stdout @stdout}))\n   184\t        {:host host :id id :status :pass :port port :elapsed-ms (- (now) t0) :exit 0})\n   185\t      (finally\n   186\t        (when (.isAlive process) (.destroyForcibly process))\n   187\t        (spit (str path \".out\") @stdout)\n   188\t        (spit (str path \".err\") @stderr)))))\n   189\t\n   190\t\n   191\t(def port-cases\n   192\t  \"Rows run by `run-port-session!` (C11), jolt only: the JVM's own --port\n   193\t   rows are its socket fixtures.\"\n   194\t  [{:id :port-serve-ephemeral :args [\"--port\" \"0\"] :hosts [:jolt] :port-session? true}])\n   195\t\n   196\t\n   197\t(defn corpus\n   198\t  []\n   199\t  (mapcat (fn [case]\n   200\t            (if-let [vms (:vms case)]\n   201\t              (for [vm vms]\n   202\t                (-> case (assoc :id (keyword (str (name (:id case)) \"-\" (name vm))))\n   203\t                    (assoc :args [\"--vm\" (name vm)])))\n   204\t              [case]))\n   205\t          (concat (edn/read-string (slurp \"test/resources/yin/repl/transcripts/local.edn\"))\n   206\t                  port-cases)))\n   207\t\n   208\t\n   209\t(defn demo!\n   210\t  [host]\n   211\t  (let [cmd (case host\n   212\t              :jolt [\"sh\" \"-c\" \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt -m yin.demo\"]\n   213\t              :jvm [\"clj\" \"-M\" \"-m\" \"yin.demo\"])\n   214\t        t0 (now) r @(apply p/process {:out :string :err :string :shutdown nil} cmd)]\n   215\t    (spit (str \"build/j3-logs/demo-\" (name host) \".log\") (str (:out r) (:err r)))\n   216\t    (when-not (and (zero? (:exit r))\n   217\t                   (str/includes? (:out r) \"SUCCESS: sum(0..100) = 5050\"))\n   218\t      (fail! \"demo failed\" {:host host :result (select-keys r [:exit :out :err :cmd])}))\n   219\t    {:host host :elapsed-ms (- (now) t0) :exit (:exit r)}))\n   220\t\n   221\t\n   222\t(defn probe!\n   223\t  [ns-name]\n   224\t  (let [cmd [\"sh\" \"-c\"\n   225\t             \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt src/dev/jolt_j2_probe.clj \\\"$@\\\"\"\n   226\t             \"jolt\" ns-name]\n   227\t        t0 (now)\n   228\t        proc (apply p/process {:out :string :err :string :shutdown nil} cmd)\n   229\t        r (deref proc timeout-ms ::timeout)]\n   230\t    (when (= ::timeout r)\n   231\t      (p/destroy-tree proc)\n   232\t      (fail! \"tracked-root probe timeout\" {:ns ns-name}))\n   233\t    (spit (str \"build/j3-logs/probe-\" ns-name \".log\") (str (:out r) (:err r)))\n   234\t    (when-not (and (zero? (:exit r))\n   235\t                   (str/includes? (:out r) (str \"PROBE \" ns-name \" load-ok\"))\n   236\t                   (str/includes? (:out r) \"TRANSIT absent\"))\n   237\t      (fail! \"tracked-root load failed\" {:ns ns-name :exit (:exit r) :out (:out r) :err (:err r)}))\n   238\t    {:ns ns-name :status :pass :elapsed-ms (- (now) t0)\n   239\t     :probe (second (re-find #\"(?m)^(PROBE .*load-ok .*?)$\" (:out r)))\n   240\t     :transit :absent :roots [\"src/jolt\" \"src/cljc\" \"src/clj\"]}))\n   241\t\n   242\t\n   243\t;; Lane B fail-closed target gate before any jolt child is started.\n   244\t(jlt/require-chez! (:target cli) \"test:jolt-shell\")\n   245\t(println \"jolt-target:\" (name (:target cli)))\n   246\t(jlt/preflight! (:target cli) \"test:jolt-shell identity gate\")\n   247\t\n   248\t\n   249\t(let [args (:args cli)\n   250\t      host (some-> (second (drop-while #(not= \"--host\" %) args)) keyword)\n   251\t      only (second (drop-while #(not= \"--only\" %) args))\n   252\t      probe? (some #{\"--probe\"} args)\n   253\t      hosts (if probe? [:jolt] (if (and host (not= :all host)) [host] [:jvm :jolt]))\n   254\t      demo? (some #{\"--demo\"} args)]\n   255\t  (fs/create-dirs \"build/j3-logs/shell\")\n   256\t  (let [results (for [h hosts\n   257\t                      case (cond probe? (mapv #(hash-map :id (keyword %))\n   258\t                                              [\"yin.repl\" \"yin.repl.dht\" \"yin.repl.main\" \"yin.repl.frontends\" \"yin.repl.host\"])\n   259\t                                 demo? [{:id :demo}]\n   260\t                                 :else (corpus))\n   261\t                      :when (and (or (nil? only) (re-find (re-pattern only) (name (:id case))))\n   262\t                                 (or (nil? (:hosts case)) (some #{h} (:hosts case))))]\n   263\t                  (try\n   264\t                    (let [r (cond probe? (probe! (name (:id case)))\n   265\t                                  demo? (demo! h)\n   266\t                                  (:port-session? case) (run-port-session! h case)\n   267\t                                  :else (run-session! h case))]\n   268\t                      (println \"PASS\" (name h) (:id case) (pr-str r)) (flush) r)\n   269\t                    (catch Exception e\n   270\t                      (let [r {:host h :id (:id case) :status :fail\n   271\t                               :message (ex-message e) :detail (ex-data e)}]\n   272\t                        (println \"FAIL\" (pr-str r)) (flush) r))))\n   273\t        results (vec results)\n   274\t        path (str \"build/j3-logs/\" (cond probe? \"probe\" demo? \"demo\" :else \"shell\") \"-\" (or (some-> host name) \"all\") \"-summary.edn\")]\n   275\t    (spit path (pr-str results))\n   276\t    (shutdown-agents)\n   277\t    (System/exit (if (some #(= :fail (:status %)) results) 1 0))))\n     1\t(ns yin.repl.shell-session-test\n     2\t  \"The process corpus is also a JVM test, sharing the exact fixtures and\n     3\t   deadline runner used by bb test:jolt-shell.\"\n     4\t  (:require [clojure.java.shell :as sh]\n     5\t            [clojure.test :refer [deftest is]]))\n     6\t\n     7\t\n     8\t(deftest local-shell-process-corpus\n     9\t  (let [{:keys [exit out err]}\n    10\t        (sh/sh \"bb\" \"src/dev/jolt_shell_session.clj\" \"--host\" \"jvm\")]\n    11\t    (is (zero? exit) (str out \"\\n\" err))))\n","exit_code":0,"status":"completed"}}
