{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"ls -l /Users/sto/workspace/datomworld/.git/hooks/pre-commit\nsed -n '1,160p' /Users/sto/workspace/datomworld/.git/hooks/pre-commit\"","aggregated_output":"-rwxr-xr-x@ 1 sto  staff  3036 Oct 31 19:17 /Users/sto/workspace/datomworld/.git/hooks/pre-commit\n#!/bin/sh\n# Pre-commit hook: format only staged Clojure files.\n# Works per-file to avoid stash conflicts with unstaged changes.\n\n# 0. Refuse to commit collab/ IN-FLIGHT artifacts. Flat files directly under\n#    collab/ are the untracked in-flight workspace: append-only, never staged\n#    or committed, and never ignored/excluded (docs/agents/roles/orchestrator.md,\n#    artifact protocol). Owner-approved 2026-09-30. Since the 2026-10-31 owner\n#    ruling, collab/ is also the archive root: its topic SUBFOLDERS\n#    (collab/yang-python/ etc.) are version-controlled and committable — only\n#    single-segment collab/<file> paths are refused. Deletions are always\n#    allowed so tracked files can be untracked with `git rm --cached`.\nCOLLAB=$(git diff --cached --name-only --diff-filter=ACMR -- collab/ | grep -E '^collab/[^/]+$' || true)\nif [ -n \"$COLLAB\" ]; then\n    echo \"pre-commit: refusing to commit in-flight collab/ artifacts (flat collab/<file> paths are never committed; topic subfolders are allowed):\" >&2\n    echo \"$COLLAB\" | sed 's/^/  /' >&2\n    echo \"Unstage them with: git restore --staged -- <paths>\" >&2\n    exit 1\nfi\n\n# 1. Get staged .clj* files (Added, Copied, Modified only)\nSTAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\\.clj' || true)\n\nif [ -z \"$STAGED\" ]; then\n    exit 0\nfi\n\necho \"Running formatters on staged files...\"\n\nTMPDIR=$(mktemp -d)\ntrap 'rm -rf \"$TMPDIR\"' EXIT\n\nfor file in $STAGED; do\n    mkdir -p \"$TMPDIR/$(dirname \"$file\")\"\n\n    # Save working tree version (may have unstaged changes)\n    cp \"$file\" \"$TMPDIR/worktree_$( echo \"$file\" | tr '/' '_' )\"\n\n    # Extract staged content to work on\n    git show \":$file\" > \"$file\"\n\n    # Save staged content before formatting\n    cp \"$file\" \"$TMPDIR/staged_$( echo \"$file\" | tr '/' '_' )\"\n\n    # Format the staged content in place.\n    # cljstyle only, matching src/dev/tasks.clj fix-all. zprint was removed:\n    # with no .zprintrc it ran on its own defaults, rewrote ~546 lines of an\n    # already-canonical file, and cljstyle fix then restored it exactly -- a\n    # net no-op that churned every staged file on every commit. It was also a\n    # latent hazard: anything zprint changes that cljstyle has no rule to\n    # normalise back would be silently committed (e.g. reader-conditional\n    # branch order, whose cljstyle :namespaces rule is disabled project-wide).\n    mise exec -- cljstyle fix \"$file\" 2>/dev/null\n\n    # Re-stage the formatted version\n    git add \"$file\"\n\n    # Save formatted version\n    cp \"$file\" \"$TMPDIR/formatted_$( echo \"$file\" | tr '/' '_' )\"\n\n    # Restore working tree: if the file had no unstaged changes\n    # (worktree == staged), use the formatted version. Otherwise\n    # restore the original worktree to preserve unstaged edits.\n    KEY=$( echo \"$file\" | tr '/' '_' )\n    if diff -q \"$TMPDIR/worktree_$KEY\" \"$TMPDIR/staged_$KEY\" > /dev/null 2>&1; then\n        cp \"$TMPDIR/formatted_$KEY\" \"$file\"\n    else\n        cp \"$TMPDIR/worktree_$KEY\" \"$file\"\n    fi\ndone\n\necho \"Formatting complete.\"\nexit 0\n","exit_code":0,"status":"completed"}}
