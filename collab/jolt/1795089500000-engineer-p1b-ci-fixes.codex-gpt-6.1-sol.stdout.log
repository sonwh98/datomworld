he Chez Scheme executable. $JOLT_CHEZ is authoritative and is how the\n# Makefile hands down the one it selected — the same interpreter that mints the\n# seed and compiles target/dev/flat.so. A direct bin/jolt invocation does not\n# inherit that export, so it takes the Chez make recorded next to the dev boot\n# cache (any other pick makes that cache unusable), then the one make\n# provisioned. A Chez on PATH is never used: jolt runs on a Chez carrying its\n# kernel patches, which make builds (`make deps`) or which is passed in.\nrecorded_chez=\"\"\nif [ -f \"$root/target/dev/flat.chez\" ]; then\n  recorded_chez=\"$(cat \"$root/target/dev/flat.chez\")\"\nfi\nif [ -z \"${JOLT_CHEZ:-}\" ]; then\n  for candidate in ${recorded_chez:+\"$recorded_chez\"} \"$root\"/.cache/local/chezscheme-*/bin/scheme; do\n    [ -x \"$candidate\" ] || continue\n    case \"$(\"$candidate\" --version 2>/dev/null || true)\" in\n      10.*)\n        if [ \"$(printf '(display (threaded?))\\n' | \"$candidate\" -q 2>/dev/null)\" = \"#t\" ]; then\n          JOLT_CHEZ=\"$candidate\"\n          break\n        fi\n        ;;\n    esac\n  done\n\n  if [ -z \"${JOLT_CHEZ:-}\" ]; then\n    echo \"No Chez Scheme for jolt: run \\`make deps\\` to build the patched Chez, or set JOLT_CHEZ.\" >&2\n    exit 1\n  fi\nfi\nCHEZ=\"$JOLT_CHEZ\"\n# Resolved to a path and exported: build.ss's toolchain-dir lookup reads\n# JOLT_CHEZ from its own environment to find the csv dir next to the running\n# interpreter, rather than re-deriving it from a `command -v` PATH search that\n# can silently disagree with the interpreter actually selected above.\nexport JOLT_CHEZ=\"$(command -v \"$CHEZ\" 2>/dev/null || echo \"$CHEZ\")\"\n\n# A Chez path with its directory resolved physically, the form make records:\n# /bin/chez and /usr/bin/chez on a merged-/usr system, or a Homebrew or Nix\n# profile directory, are one Chez under two names.\nphysical_path() {\n  ( cd -P -- \"$(dirname -- \"$1\")\" 2>/dev/null && printf '%s/%s\\n' \"$(p