 -e $probe 2>&1 | Out-String).Trim()\n.github/workflows/tests.yml:535:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n.github/workflows/tests.yml:556:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n.github/workflows/tests.yml:575:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n.github/workflows/tests.yml:599:          $out = (& $scheme --script host\\chez\\cli.ss $probe 2>&1 | Out-String).Trim()\n.github/workflows/tests.yml:613:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n.github/workflows/tests.yml:631:          $out = (& $scheme --script host\\chez\\cli.ss $probe 2>&1 | Out-String).Trim()\n.github/workflows/tests.yml:647:        run: TMPDIR=\"$(cygpath -m \"$RUNNER_TEMP\")\" make CHEZ=./chez-install/bin/chez httpsfetch\n.github/workflows/tests.yml:652:        run: TMPDIR=\"$(cygpath -w \"$RUNNER_TEMP\")\" make CHEZ=./chez-install/bin/chez httpsfetch\n(ns jolt.backend-scheme.names\n  \"How the Scheme back end spells what it writes: Chez string literals, the\n  injective munging of a Clojure name into a Scheme identifier (and the names it\n  must stay clear of), and the direct-link binding name of a var. Pure text — no\n  emit-session state — so every other back-end namespace can lean on it.\"\n  (:require [clojure.string :as str]\n            [jolt.op-registry :as op-registry]))\n\n;; A Chez string literal. Every char outside printable ASCII becomes a\n;; codepoint hex escape \\x<cp>; ; the named escapes (\\n \\t \\r \\\" \\\\) match what\n;; Chez's reader accepts. For pure printable ASCII this is byte-identical to %j.\n(defn- char-escape [cp]\n  (cond\n    (= cp 34) \"\\\\\\\"\"\n    (= cp 92) \"\\\\\\\\\"\n    (= cp 10) \"\\\\n\"\n    (= cp 9) \"\\\\t\"\n    (= cp 13) \"\\\\r\"\n    (and (>= cp 32) (< cp 127)) (str (char cp))\n    :else (str \"\\\\x\" (format \"%x\" cp) \";\")))\n\n(defn chez-str-lit [s]\n  (str \"\\\"\" (apply str (map (fn [c] (char-escape (int c))) s)) \"\\\"\"))\n;; --- identifier munging ------------------------------------------------------\n;; Every Clojure name the emitter writes as a Scheme IDENTIFIER — a local, a\n;; param, a fn's letrec self-name, a direct-link binding — goes through\n;; munge-chars. A Clojure symbol can hold any character: the reader lets ' # |\n;; and $ through, and (symbol s) lets everything through, including the chars\n;; the Scheme reader takes as delimiters (a space, ; ( ) [ ] { } \" , ` \\) — an\n;; identifier emitted bare with one of those either fails to read, reads as two\n;; datums, or (a backslash, which Chez swallows) silently ALIASES a different\n;; name. The escape is INJECTIVE, so two distinct Clojure names never munge to\n;; one Scheme identifier: $ is the escape lead and is itself escaped FIRST\n;; ($$ = a literal $), then ' -> $P, # -> $H, | -> $V, and any other unsafe\n;; char -> $U<hex>$ (self-delimiting, so the codepoint width is free). Every $\n;; in the output therefore begins one of those tokens, and decoding is a plain\n;; left-to-right inverse. The same mapping runs at a binding and at every\n;; reference, so resolution stays consistent.\n;;\n;; The unsafe set was derived by probing both readers (Chez 10.4, Gambit 4.9),\n;; not from the standards: whitespace and controls (code < 33), the fourteen\n;; ASCII chars below, and the non-ASCII Unicode White_Space characters, which\n;; Chez's char-whitespace? delimits on while the reference reader lets them\n;; through (Java's isWhitespace excludes NBSP). test/chez/unit.edn\n;; munge-injective pins one row per class.\n(def ^:private munge-unsafe-ascii\n  ;; \" # $ ' ( ) , ; [ \\ ] ` { | }\n  #{34 35 36 39 40 41 44 59 91 92 93 96 123 124 125})\n(defn- munge-unicode-space? [cp]\n  (or (= cp 0x85) (= cp 0xA0) (= cp 0x1680)\n      (and (>= cp 0x2000) (<= cp 0x200A))\n      (= cp 0x2028) (= cp 0x2029) (= cp 0x202F) (= cp 0x205F) (= cp 0x3000)))\n(defn- munge-unsafe? [cp]\n  (or (< cp 33)\n      (contains? munge-unsafe-ascii cp)\n      (and (> cp 127) (munge-unicode-space? cp))))\n(defn- munge-char [cp]\n  (cond (= cp 36) \"$$\"\n        (= cp 39) \"$P\"\n        (= cp 35) \"$H\"\n        (= cp 124) \"$V\"\n        :else (str \"$U\" (format \"%x\" cp) \"$\")))\n(defn munge-chars [s]\n  ;; a name with nothing to escape (nearly all of them) is returned as-is\n  (if (some (fn [c] (munge-unsafe? (int c))) s)\n    (apply str (map (fn [c] (let [cp (int c)] (if (munge-unsafe? cp) (munge-char cp) c))) s))\n    s))\n;; Scheme syntactic keywords. A jolt local with one of these names would, when\n;; emitted verbatim, shadow the Scheme form in operator position (a local named\n;; `if` would turn the special form (if …) the back end emits into a call), so\n;; such locals are prefixed. Matches the spec: special-form heads are not\n;; shadowable, but a value local may legally be named `if`.\n(def ^:private scheme-reserved\n  #{\"if\" \"begin\" \"lambda\" \"let\" \"let*\" \"letrec\" \"letrec*\" \"quote\" \"quasiquote\"\n    \"unquote\" \"set!\" \"define\" \"define-syntax\" \"cond\" \"case\" \"when\" \"unless\"\n    \"and\" \"or\" \"do\" \"else\" \"guard\" \"parameterize\" \"delay\" \"values\"})\n\n;; clojure.core ops emitted as a BARE Scheme name (where native-ops maps the op\n;; to itself: + - * / < > min max …). A local binding with one of these names\n;; would otherwise shadow the emitted prim — e.g. (fn [max] (clojure.core/max …))\n;; emits (max …) calling the param — so such locals are prefixed, like reserved\n;; words. Derived from native-ops so the two never drift.\n(def ^:private bare-native-names\n  (set (keep (fn [[k v]] (when (= k v) k)) op-registry/native-ops)))\n\n;; All Scheme identifiers the back end emits bare — every :call, :dbl, :lng,\n;; :fixed, :value, and :bd name from op-registry, plus a closed set of runtime\n;; helpers the registry doesn't enumerate (devirt dispatchers, jolt-invokeN,\n;; var-deref, list->cseq, literal/interop heads, etc.). Derived from op-registry\n;; so it stays in sync with per-op facts. A local whose munged name matches ANY\n;; of these would shadow the emitted runtime procedure (e.g. (let [jolt-nil 5]\n;; nil) returns 5 if the local is emitted verbatim).\n;; INVARIANT: any NEW bare Scheme head an emit* clause outputs — a procedure or\n;; special-form name emitted as a call head that a user local could shadow —\n;; MUST be added to the `helpers` set below. The op-registry derivation covers\n;; registry-driven heads; everything else is enumerated there by emission site.\n(def ^:private rt-emitted-names\n  (let [from-registry op-registry/registry-emitted-names\n        helpers #{\"jolt-nil\" \"jolt-invoke\" \"jolt-invoke0\" \"jolt-invoke1\"\n                  \"jolt-invoke2\" \"jolt-invoke3\" \"jolt-invoke4\"\n                  \"jolt-invoke-t0\" \"jolt-invoke-t1\" \"jolt-invoke-t2\" \"jolt-invoke-t3\" \"jolt-invoke-t4\"\n                  \"var-deref\" \"list->cseq\" \"cseq->list\"\n                  \"jolt-rest-seq\" \"jolt-register-variadic!\"\n                  \"make-jrec\" \"jrec-field-at\" \"jrec-field-set!\"\n                  \"devirt-resolve\" \"devirt-resolve-fl\"\n                  \"register-clone*\" \"protocol-resolve\"\n                  \"protocol-dispatch1\" \"protocol-dispatch2\" \"protocol-dispatch3\"\n                  \"jolt->fl\" \"jolt->fx\" \"jolt->fx-ret\"\n                  ;; the bit-op inline (bit-fx-ops): its fixnum guard and the\n                  ;; four Chez fixnum ops it open-codes to; flonum?/fixnum? also\n                  ;; guard the hint-coercion inline (emit-nhint-coerce) and the\n                  ;; :fl-coerce contagion widening, whose fixnum->flonum has been\n                  ;; emitted bare since before this set existed.\n                  \"fixnum?\" \"flonum?\" \"fixnum->flonum\"\n                  ;; the cast fast path on a proven double (the :coerce arm's\n                  ;; :fl-arg branch): its lane and the runtime's window\n                  ;; constants, which the emitted test reads by name\n                  \"flonum->fixnum\"\n                  \"jolt-cast-lo-long\" \"jolt-cast-hi-long\" \"jolt-cast-lo-int\" \"jolt-cast-hi-int\"\n                  \"jolt-cast-lo-short\" \"jolt-cast-hi-short\" \"jolt-cast-lo-byte\" \"jolt-cast-hi-byte\"\n                  \"jolt-cast-lo-char\" \"jolt-cast-hi-char\"\n                  ;; the trace site-restore around a non-tail call (site-restore,\n                  ;; lookup-restore) and a fn clause's read of the site slot at\n                  ;; entry (lambda.clj site-entry): they read and write the slot and\n                  ;; test and unbox its value (unbox is listed below). honeysql's (let [pair? ...]) turned\n                  ;; such a test into a call to its boolean. Gambit's two-slot\n                  ;; restore still tests pair?.\n                  \"pair?\" \"box?\" \"virtual-register\" \"set-virtual-register!\"\n                  \"fxand\" \"fxior\" \"fxxor\" \"fxnot\"\n                  \"jolt-register-source!\" \"jolt-proto-epoch\"\n                  ;; --- bare heads emitted at sites the registry doesn't cover ---\n                  ;; INVARIANT: any new bare Scheme head an emit* clause outputs\n                  ;; (a head a user local could shadow) MUST be added here. Literal\n                  ;; + form emission (emit-const): keyword/char construction.\n                  \"keyword\" \"integer->char\"\n                  ;; fn forms (emit-fn): a multi-arity fn lowers to case-lambda.\n                  \"case-lambda\"\n                  ;; binding + try/finally (emit-try): both thread through\n                  ;; dynamic-wind; a binding form and a finally both emit it.\n                  ;; jolt-finally-in is that dynamic-wind's before-thunk, emitted\n                  ;; by name because the fiber park recognises it with eq? — a\n                  ;; shadowed or inlined copy would make the finally run mid-park.\n                  \"dynamic-wind\" \"jolt-finally-in\"\n                  ;; host interop (emit-invoke static call, :host-new,\n                  ;; :host-static field ref).\n                  \"host-new\" \"host-static-call\" \"host-static-ref\"\n                  ;; per-site caches: the static member site and the instance?\n                  ;; site, each with the constructor its hoisted cell calls\n                  \"jolt-once-tag\" \"jolt-once-clear!\" \"host-static-ref-site\" \"host-static-proc-site\" \"host-static-site-make\"\n                  \"jolt-instance-site\" \"jolt-instance-site-make\"\n                  \"jolt-class-for-site\" \"jolt-class-for-site-make\"\n                  ;; record/reify protocol-method dispatch (:host-call fallback\n                  ;; for any .method not in supported-host-methods).\n                  \"record-method-dispatch\"\n                  ;; proven-target interop natives (string-direct-emit,\n                  ;; keyword-direct-emit, sb-direct-emit). These are bare heads a\n                  ;; user local could shadow and the \"jolt-\" prefix net does not\n                  ;; catch them, so they are enumerated per the invariant above:\n                  ;; (let [str-trim (fn [_] :shadowed)] (.trim ^String s)) would\n                  ;; otherwise emit a call to the local.\n                  \"str-trim\" \"str-needle\" \"str-starts-with?\" \"str-ends-with?\"\n                  \"str-index-of\" \"str-index-of-any\" \"str-replace-literal\"\n                  \"java-string-hash\" \"java-symbol-hash\"\n                  \"keyword-t-ns\" \"keyword-t-name\"\n                  \"sb-append!\" \"sb-str\" \"sb-length\" \"sb-piece\" \"sb-char-at\" \"->num\"\n                  \"sb-append*!\" \"sb-str*\" \"sb-length*\" \"sb-char-at*\"\n                  ;; cell-cached var deref (the whole-program var-cache? path).\n                  \"var-cell-deref\"\n                  ;; devirt cached-desc lookup (emit-invoke ctor inlining).\n                  \"hashtable-ref\"\n                  ;; top-level def / forward-declare / ns-value splice\n                  ;; (emit-def-cached, :forward-decl, :the-ns).\n                  \"define\" \"def-var!\" \"def-var-plain!\" \"def-var-with-meta!\"\n                  \"declare-var!\" \"intern-ns!\"\n                  ;; ffi lowering (emit-ffi-fn/emit-ffi-callable: the sa-* adapter\n                  ;; syntaxes a Chez foreign-procedure/callable expands to).\n                  \"sa-foreign-procedure\" \"sa-foreign-procedure-blocking\"\n                  \"sa-foreign-callable\" \"sa-foreign-callable-collect-safe\"\n                  \"jolt-ffi-native-error-procedure\" \"call-with-values\"\n                  ;; the pointer-fn entry check (ffi-pointer-procedure-expr).\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/bin/gambuild-C\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h:1520: * configure script normally determines this because it depends on\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h:1574: * by the compiler (this is determined by the configure script) unless\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h:8626: * determined by ifdefs or the configure script.  However, this would\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h:8633: * configured with a different C compiler (for example Xcode's clang\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h:8640: * to the configure script, i.e.:\n/Users/sto/.local/share/mise/installs/gambit/4.9.8/include/gambit.h:8642: *   ./configure --enable-dynamic-tls\n2026-11-19 12:51:08 GMT\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"/Library/Developer/CommandLineTools/usr/bin/git status --short --branch; /Library/Developer/CommandLineTools/usr/bin/git log -4 --oneline; rg -n 'rt-emitted-names|ftype|per-call|joltffi-public|gambitffi:|emittedheads' jolt-core/jolt/backend_scheme/names.clj jolt-core/jolt/backend_scheme/ffi.clj Makefile test/chez/*emitted*; cat host/gambit/ffi/toolchain.py host/gambit/ffi/record-toolchain.sh host/gambit/ffi/verify-toolchain.sh host/gambit/ffi/verify-digests.sh host/gambit/ffi/make-digests.sh; rg --files .github/workflows; rg --files --hidden -g AGENTS.md -g '\"'!.git/**'\"' .\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"/Library/Developer/CommandLineTools/usr/bin/git status --short --branch; /Library/Developer/CommandLineTools/usr/bin/git log -4 --oneline; rg -n 'rt-emitted-names|ftype|per-call|joltffi-public|gambitffi:|emittedheads' jolt-core/jolt/backend_scheme/names.clj jolt-core/jolt/backend_scheme/ffi.clj Makefile test/chez/*emitted*; cat host/gambit/ffi/toolchain.py host/gambit/ffi/record-toolchain.sh host/gambit/ffi/verify-toolchain.sh host/gambit/ffi/verify-digests.sh host/gambit/ffi/make-digests.sh; rg --files .github/workflows; rg --files --hidden -g AGENTS.md -g '\"'!.git/**'\"' .\"","aggregated_output":"## gambit-ffi-p1b\n3ecd20cc p1b-linux-r3: select and verify the platform errno accessor\n434dc2f9 p1b-linux-r2: select fixture shared-library flags by platform\nf5920f1f p1b-linux: record linux-x86_64 toolchain provenance pins\nbe0710cd p1b-linux: qualify toolchain provenance pins by host platform\nzsh:1: no matches found: test/chez/*emitted*\n#!/usr/bin/env python3\n\"\"\"Record or verify the running platform's explicit Gambit provenance pins.\"\"\"\nimport hashlib\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\nMANIFEST_DIR = Path(__file__).resolve().parent\nPATHS = (\n    \"bin/gsi\", \"bin/gsc\", \"bin/gambuild-C\", \"include/gambit.h\",\n    \"lib/libgambit.a\", \"lib/libgambitgsi.a\", \"lib/libgambitgsc.a\",\n)\nFORMAT = \"# joltffi toolchain manifest v1\"\n\n\ndef platform_key():\n    host = os.uname()\n    system, machine = host.sysname.lower(), host.machine.lower()\n    machine = {\"aarch64\": \"arm64\", \"amd64\": \"x86_64\"}.get(machine, machine)\n    key = system + \"-\" + machine\n    if not re.fullmatch(r\"[a-z0-9_-]+\", key):\n        raise ValueError(\"invalid uname platform key: \" + repr(key))\n    return key\n\n\ndef selected_manifest():\n    key = platform_key()\n    path = MANIFEST_DIR / (\"TOOLCHAIN.\" + key + \".sha256\")\n    print(\"gambitffi: platform=\" + key + \" manifest=host/gambit/ffi/\" + path.name,\n          flush=True)\n    return key, path\n\n\ndef digest(path):\n    result = hashlib.sha256()\n    with path.open(\"rb\") as stream:\n        for block in iter(lambda: stream.read(1024 * 1024), b\"\"):\n            result.update(block)\n    return result.hexdigest()\n\n\ndef render_manifest(prefix, key):\n    # Hash everything before writing: a missing input cannot leave partial pins.\n    rows = [digest(prefix / name) + \"  \" + name for name in PATHS]\n    return \"\\n\".join([FORMAT, \"# platform: \" + key] + rows) + \"\\n\"\n\n\ndef read_manifest(path, key):\n    if not path.is_file():\n        raise ValueError(\"missing toolchain manifest: \" + str(path) +\n                         \"; record this platform explicitly with record-toolchain.sh\")\n    lines = path.read_text(encoding=\"ascii\").splitlines()\n    if lines[:2] != [FORMAT, \"# platform: \" + key]:\n        raise ValueError(\"toolchain manifest format/platform header mismatch: \" + str(path))\n    rows = [re.fullmatch(r\"([0-9a-f]{64})  (.+)\", line) for line in lines[2:]]\n    if (len(rows) != len(PATHS) or any(row is None for row in rows)\n            or tuple(row.group(2) for row in rows) != PATHS):\n        raise ValueError(\"toolchain manifest must pin exactly the seven ordered inputs: \" + str(path))\n    return [(row.group(1), row.group(2)) for row in rows]\n\n\ndef main(argv=None):\n    argv = sys.argv[1:] if argv is None else argv\n    if len(argv) != 2 or argv[0] not in (\"record\", \"verify\"):\n        print(\"usage: toolchain.py record|verify GAMBIT_PREFIX\", file=sys.stderr)\n        return 2\n    try:\n        key, path = selected_manifest()\n        prefix = Path(argv[1]).resolve()\n        if argv[0] == \"record\":\n            content = render_manifest(prefix, key)\n            temporary = None\n            try:\n                with tempfile.NamedTemporaryFile(mode=\"w\", encoding=\"ascii\",\n                                                 dir=MANIFEST_DIR,\n                                                 prefix=\".\" + path.name + \".\",\n                                                 delete=False) as stream:\n                    temporary = Path(stream.name)\n                    stream.write(content)\n                os.replace(temporary, path)\n            finally:\n                if temporary is not None and temporary.exists():\n                    temporary.unlink()\n            # Explicit recording also pins the new manifest in the source index.\n            # Verification never calls this recording/update path.\n            subprocess.run([\"sh\", str(MANIFEST_DIR / \"make-digests.sh\")], check=True)\n            print(\"gambitffi: recorded 7 toolchain inputs\")\n            print(\"gambitffi: refreshed host/gambit/ffi/DIGESTS.txt\")\n        else:\n            failures = []\n            for expected, name in read_manifest(path, key):\n                if digest(prefix / name) == expected:\n                    print(name + \": OK\")\n                else:\n                    print(name + \": FAILED\", file=sys.stderr)\n                    failures.append(name)\n            if failures:\n                raise ValueError(\"toolchain digest mismatch (\" + str(len(failures)) + \" inputs)\")\n            print(\"gambitffi: toolchain verified (7 inputs)\")\n        return 0\n    except (OSError, ValueError, subprocess.CalledProcessError) as error:\n        print(\"gambitffi: \" + str(error), file=sys.stderr)\n        return 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n#!/bin/sh\nset -eu\nexec python3 \"$(dirname \"$0\")/toolchain.py\" record \"$@\"\n#!/bin/sh\nset -eu\nexec python3 \"$(dirname \"$0\")/toolchain.py\" verify \"$@\"\n#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/../../..\"\nprefix=${1:-${GAMBIT_PREFIX:-}}\nif [ -z \"$prefix\" ]; then\n  echo \"usage: verify-digests.sh GAMBIT_PREFIX (or set GAMBIT_PREFIX)\" >&2\n  exit 2\nfi\nsh host/gambit/ffi/verify-toolchain.sh \"$prefix\"\nsh host/gambit/ffi/make-digests.sh --check\npython3 host/gambit/ffi/generate-shims.py --check\n#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/../../..\"\nLC_ALL=C\nexport LC_ALL\ndigests() {\n  shasum -a 256 host/gambit/ffi/joltffi-bridge.scm \\\n    host/gambit/ffi/generated-shims.scm host/gambit/ffi/shapes.json \\\n    host/gambit/ffi/generate-shims.py host/gambit/ffi/joltffi-fixture.c \\\n    host/gambit/ffi/joltffi-fixture2.c host/gambit/ffi/joltffi-dep.c \\\n    host/gambit/ffi/joltffi-unloadable.c host/gambit/ffi/toolchain.py \\\n    host/gambit/ffi/record-toolchain.sh host/gambit/ffi/verify-toolchain.sh \\\n    host/gambit/ffi/verify-digests.sh host/gambit/ffi/make-digests.sh \\\n    host/gambit/ffi/TOOLCHAIN.*.sha256\n}\ncase ${1:-} in\n  \"\") digests > host/gambit/ffi/DIGESTS.txt ;;\n  --check)\n    shasum -a 256 -c host/gambit/ffi/DIGESTS.txt\n    if [ \"$(digests)\" != \"$(cat host/gambit/ffi/DIGESTS.txt)\" ]; then\n      echo \"gambitffi: pinned source/manifest catalog is stale; explicitly record/update the digests\" >&2\n      exit 1\n    fi\n    ;;\n  *) echo \"usage: make-digests.sh [--check]\" >&2; exit 2 ;;\nesac\n.github/workflows/windows-static.yml\n.github/workflows/debug-nrepl.yml\n.github/workflows/tests.yml\n.github/workflows/glibc-floor.yml\n.github/workflows/metrics.yml\n.github/workflows/cross-smoke.yml\n.github/workflows/pgo-bench.yml\n.github/workflows/release.yml\n.github/workflows/jvm-gap.yml\n.github/workflows/flake.yml\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'ftype|per-call|joltffi-public|emit-ffi-node|emit-ffi-fn' jolt-core/jolt/backend_scheme/ffi.clj; sed -n '164,250p' jolt-core/jolt/backend_scheme/names.clj; sed -n '1488,1515p' Makefile; rg --files | rg 'emitted.head|emitted-head|setup.*gambit|bionic|\\\\.github/actions/setup'; rg -n 'emittedheads|emitted-head' test host; sed -n '1,260p' .github/workflows/tests.yml; cat ci/bionic-ci.sh 2>/dev/null; cat host/chez/remint.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'ftype|per-call|joltffi-public|emit-ffi-node|emit-ffi-fn' jolt-core/jolt/backend_scheme/ffi.clj; sed -n '164,250p' jolt-core/jolt/backend_scheme/names.clj; sed -n '1488,1515p' Makefile; rg --files | rg 'emitted.head|emitted-head|setup.*gambit|bionic|\\\\.github/actions/setup'; rg -n 'emittedheads|emitted-head' test host; sed -n '1,260p' .github/workflows/tests.yml; cat ci/bionic-ci.sh 2>/dev/null; cat host/chez/remint.sh\"","aggregated_output":"35:(defn- emit-ffi-layout-ftype [type]\n38:    ;; A union is the same member list under Chez's other aggregate ftype, so it\n39:    ;; gets its size, alignment and (all-equal) member offsets from ftype-sizeof\n40:    ;; and ftype-&ref exactly as a struct does — no layout arithmetic here.\n47:             (str \"[f\" i \" \" (emit-ffi-layout-ftype (:type field)) \"]\"))\n51:    (str \"(array \" (:count type) \" \" (emit-ffi-layout-ftype (:type type)) \")\")\n147:;; Each entry's byte offset, read off a pointer at address 0 to the layout's ftype.\n149:  (let [base (str \"(make-ftype-pointer \" type-name \" 0)\")]\n153:            \"(ftype-pointer-address (ftype-&ref \" type-name \" (\"\n166:;; The define-ftype forms the layout's metadata is computed with: the layout\n169:(defn- emit-layout-ftypes [type-name align-name layout arrays]\n170:  (str \"(define-ftype \" type-name \" \" (emit-ffi-layout-ftype layout) \") \"\n171:       \"(define-ftype \" align-name \" (struct [prefix unsigned-8] [value \" type-name \"])) \"\n175:               (str \"(define-ftype \" (:element-name entry) \" \"\n176:                    (emit-ffi-layout-ftype (:element-type entry)) \")\"))\n195:                                \" (ftype-sizeof \" (:element-name entry) \")\"))\n198:         (emit-layout-ftypes type-name align-name layout arrays)\n202:         \"(keyword #f \\\"size\\\") (ftype-sizeof \" type-name \") \"\n204:         \"(ftype-pointer-address (ftype-&ref \" align-name \" (value) \"\n205:         \"(make-ftype-pointer \" align-name \" 0))) \"\n386:;; Every shape emit-ffi-fn cannot compile, refused with a message that names the\n407:                           \" argument needs an ftype the binding declared. Declare the tail\"\n444:;; through the ftype the binding declares for it.\n450:       \"(make-ftype-pointer \" type-name \" address)))\"))\n467:    \"(joltffi-public-blocking-raise)\"\n470:      (str \"(joltffi-public-procedure '(\" (str/join \" \" (map ffi-arg-type->chez types)) \") '\"\n504:;; (emit-ffi-fn).\n525:;; aggregates get an ftype each, defined once around the lambda; an aggregate\n530:  ftype name.\"\n540:;; its ftype, then the result's. SCALAR->CHEZ maps the rest: a foreign-fn sends a\n550:;; The define-ftype forms for the aggregates a binding passes or returns.\n551:(defn- ffi-ftype-defs [aggregates return-name rettype]\n554:          (str \"(define-ftype \" (:name entry) \" \"\n555:               (emit-ffi-layout-ftype (:type entry)) \")\"))\n558:     [(str \"(define-ftype \" return-name \" \"\n559:           (emit-ffi-layout-ftype (:type rettype)) \")\")])))\n607:        ftypes (ffi-ftype-defs aggregates return-name rettype)]\n608:    (if (seq ftypes)\n609:      (str \"(let () \" (str/join \" \" ftypes) \" \" binding \")\")\n619:(defn- emit-ffi-fn [node]\n631:      ;; gap G-2: a by-value aggregate needs define-ftype / (& ftype), unbound\n632:      ;; on the gambit boot — refuse in words instead of dying on the ftype\n637:             (chez-str-lit \"jolt.ffi/foreign-fn: by-value aggregates are unsupported on the gambit target (no ftype engine behind the stage-1 bridge)\")\n646:             (chez-str-lit \"jolt.ffi/foreign-fn: bare :& varargs are unsupported on the gambit target (per-call tail shapes compile at run time, outside the stage-1 registry)\")\n662:                       (str \"(ftype-pointer-address \" param \")\")\n666:               (into [\"(ftype-pointer-address destination)\"] args)\n704:;; an (& ftype) position, so Chez hands the procedure an ftype-pointer to the\n706:;; owns, valid until the callback returns. An aggregate RESULT is (& ftype) too,\n716:  ;; The mirror of the :blocking/:string rule in emit-ffi-fn, with the direction\n771:        ftypes (ffi-ftype-defs aggregates return-name rettype)]\n772:    (if (seq ftypes)\n773:      (str \"(let () \" (str/join \" \" ftypes) \" \" register \")\")\n777:(defn emit-ffi-node [emit node]\n780:    ;; define-ftype/make-ftype-pointer text that died as an unbound identifier\n784:                       (chez-str-lit \"jolt.ffi/layout: ffi-layout (ftype aggregates) are unsupported on the gambit target\")\n787:    :ffi-fn (emit-ffi-fn node)\n790:      ;; gambit has no ffi tier, and its eval knows no define-ftype, so a\n                  \"keyword-t-ns\" \"keyword-t-name\"\n                  \"sb-append!\" \"sb-str\" \"sb-length\" \"sb-piece\" \"sb-char-at\" \"->num\"\n                  \"sb-append*!\" \"sb-str*\" \"sb-length*\" \"sb-char-at*\"\n                  ;; cell-cached var deref (the whole-program var-cache? path).\n                  \"var-cell-deref\"\n                  ;; devirt cached-desc lookup (emit-invoke ctor inlining).\n                  \"hashtable-ref\"\n                  ;; top-level def / forward-declare / ns-value splice\n                  ;; (emit-def-cached, :forward-decl, :the-ns).\n                  \"define\" \"def-var!\" \"def-var-plain!\" \"def-var-with-meta!\"\n                  \"declare-var!\" \"intern-ns!\"\n                  ;; ffi lowering (emit-ffi-fn/emit-ffi-callable: the sa-* adapter\n                  ;; syntaxes a Chez foreign-procedure/callable expands to).\n                  \"sa-foreign-procedure\" \"sa-foreign-procedure-blocking\"\n                  \"sa-foreign-callable\" \"sa-foreign-callable-collect-safe\"\n                  \"jolt-ffi-native-error-procedure\" \"call-with-values\"\n                  ;; the pointer-fn entry check (ffi-pointer-procedure-expr).\n                  \"jolt-ffi-function-pointer\"\n                  ;; bare :& lowering (emit-ffi-bare-varargs-fn): the dispatcher\n                  ;; spreads the inferred tail with Scheme's own apply, keeping\n                  ;; the fixed arguments as arguments rather than appending them.\n                  \"apply\"\n                  ;; layout lowering (emit-ffi-layout): the ftype heads the\n                  ;; struct/array metadata is computed with. A local named\n                  ;; ftype-pointer-address answered ITS value as the layout's\n                  ;; :alignment; the other four broke the compile.\n                  \"define-ftype\" \"make-ftype-pointer\" \"ftype-sizeof\"\n                  \"ftype-&ref\" \"ftype-pointer-address\"\n                  ;; ftype and foreign-procedure syntax keywords, matched by\n                  ;; binding, so a local of the same name breaks the form.\n                  \"array\" \"struct\" \"foreign-procedure\" \"__varargs_after\"\n                  ;; Scheme procedures emitted bare: the try/finally fiber mask\n                  ;; (fx+ fx- fx>), the PIC and record-ctor caches, string and\n                  ;; keyword interop, symbol hashing, and the unsafe-prefixed ops\n                  ;; (fx= fl+ fl- vector-ref) on a target with no unsafe prefix.\n                  ;; (let [fx+ 1] (try 1 (finally nil))) called the local.\n                  \"+\" \"=\" \"not\" \"eq?\" \"null?\" \"procedure?\" \"string?\"\n                  \"car\" \"cdr\" \"cons\" \"vector\" \"vector-ref\" \"vector-set!\"\n                  ;; debug locals (*dbg-scope*): every tail leaf and recur\n                  \"keep-live\"\n                  \"string-append\" \"string-length\" \"string-downcase\" \"string-upcase\"\n                  \"fx+\" \"fx-\" \"fx>\" \"fx=\" \"fx=?\" \"fx>=?\" \"fl+\" \"fl-\"\n                  \"flsingle\" \"flvector-ref\" \"flvector-set!\"\n                  ;; runtime helpers emitted bare at boxed-float, record-field,\n                  ;; PIC, ffi, def, and image sites.\n                  \"make-jfloat\" \"jfloat?\" \"jfloat-fl\" \"jfloat-unbox\" \"jnum->exact\"\n                  \"jrec-field-site-make\" \"jrec-field-site-ref\" \"jrec-own-field\" \"jolt-set-own-field!\" \"jrec-pic-desc\" \"jrec?\" \"jrec-desc\"\n                  \"jrec-own-slot-miss\" \"jrec-own-slot-set-miss!\" \"jrec*-vals\" \"unbox\"\n                  \"pvec?\" \"pvec-cnt\" \"pvec-nth-in-range\" \"fx<?\"\n                  \"jrec1?\" \"jrec2?\" \"jrec3?\" \"jrec4?\" \"jrec5?\" \"jrec6?\" \"jrec7?\" \"jrec8?\"\n                  \"keyword-t?\" \"mark-macro!\" \"set-var-meta!\" \"throw-jvm\"\n                  \"def-var-linked!\" \"amap-slots->pmap\"\n                  ;; the per-arity record slot accessors and their setters,\n                  ;; built by name at deftype field sites\n                  ;; (emit-deftype-slot-read/-write) and record field reads\n                  ;; (calls.clj direct-field-accessor)\n                  \"jrec1-f0\" \"jrec1-f0-set!\"\n                  \"jrec2-f0\" \"jrec2-f0-set!\" \"jrec2-f1\" \"jrec2-f1-set!\"\n                  \"jrec3-f0\" \"jrec3-f0-set!\" \"jrec3-f1\" \"jrec3-f1-set!\" \"jrec3-f2\" \"jrec3-f2-set!\"\n                  \"jrec4-f0\" \"jrec4-f0-set!\" \"jrec4-f1\" \"jrec4-f1-set!\" \"jrec4-f2\" \"jrec4-f2-set!\" \"jrec4-f3\" \"jrec4-f3-set!\"\n                  \"jrec5-f0\" \"jrec5-f0-set!\" \"jrec5-f1\" \"jrec5-f1-set!\" \"jrec5-f2\" \"jrec5-f2-set!\" \"jrec5-f3\" \"jrec5-f3-set!\" \"jrec5-f4\" \"jrec5-f4-set!\"\n                  \"jrec6-f0\" \"jrec6-f0-set!\" \"jrec6-f1\" \"jrec6-f1-set!\" \"jrec6-f2\" \"jrec6-f2-set!\" \"jrec6-f3\" \"jrec6-f3-set!\" \"jrec6-f4\" \"jrec6-f4-set!\" \"jrec6-f5\" \"jrec6-f5-set!\"\n                  \"jrec7-f0\" \"jrec7-f0-set!\" \"jrec7-f1\" \"jrec7-f1-set!\" \"jrec7-f2\" \"jrec7-f2-set!\" \"jrec7-f3\" \"jrec7-f3-set!\" \"jrec7-f4\" \"jrec7-f4-set!\" \"jrec7-f5\" \"jrec7-f5-set!\" \"jrec7-f6\" \"jrec7-f6-set!\"\n                  \"jrec8-f0\" \"jrec8-f0-set!\" \"jrec8-f1\" \"jrec8-f1-set!\" \"jrec8-f2\" \"jrec8-f2-set!\" \"jrec8-f3\" \"jrec8-f3-set!\" \"jrec8-f4\" \"jrec8-f4-set!\" \"jrec8-f5\" \"jrec8-f5-set!\" \"jrec8-f6\" \"jrec8-f6-set!\" \"jrec8-f7\" \"jrec8-f7-set!\"\n                  \"image-fn-form-maker!\" \"image-fn-form-src\" \"image-register-fn-form!\"}]\n    (into from-registry helpers)))\n\n;; A munged name both Scheme readers would take for a NUMBER rather than an\n;; identifier. The reference reader yields SYMBOLS for +i, -i, +inf.0, -nan.0,\n;; .5, -.5 and the like (its number match needs a digit right after the sign),\n;; and emitted bare they abort compilation (\"invalid bound variable 0+1i\").\n;; Derived by probing both readers over the sign/dot-led tokens a symbol can\n;; start with: a number begins with a digit; with . and a digit; or with a sign\n;; and then a digit, a dot, a lone i, or inf.0/nan.0 in any case. A lone . is\n;; the pair dot, unreadable in a binding position. Over-approximates on purpose\n;; (+.. and +inf.0x are identifiers): a spare prefix costs nothing where a\n;; missed number is a reader error. The common -name/+name shapes (-invoke,\n;; +inc, -i0) are untouched. A digit-led name can only come from (symbol s).\n(defn- digit-char? [c] (let [cp (int c)] (and (>= cp 48) (<= cp 57))))\n(defn- number-lookalike? [s]\n  (let [n (count s) c0 (nth s 0) c1 (when (> n 1) (nth s 1))]\n    (or (digit-char? c0)\n        (and (= c0 \\.) (or (nil? c1) (digit-char? c1)))\n        (and (or (= c0 \\+) (= c0 \\-))\n             (some? c1)\n             (or (digit-char? c1)\n                 (= c1 \\.)\n# copies for exactly that reason. Counts a name referenced when it appears as a\n# token anywhere OUTSIDE a comment, string bodies included (the backend emits\n# calls as text), or when an identifier inside a string literal is its stem and\n# the tail is all digits: (str \"jolt-ffi-varargs-proc\" k) reaches proc0..proc3,\n# and a gate without that rule would have deleted every varargs FFI binding.\ndeadhost:\n\t@sh host/chez/dead-host-check.sh\n\n# A top-level define that rebinds a name a define-record-type generated. The\n# host files share one top level, so the later define wins silently and every\n# reader of the field gets the other procedure (the fiber record's waiter field\n# read through fibers-async.ss's handler allocator).\nrecordshadow:\n\t@$(CHEZ) --script host/chez/record-shadow-check.ss\n\n# Every head the back end writes into its output must be one munge-name renames\n# a user local away from; the list of those names is kept by hand and drifted\n# (a local named pair? or fx+ called itself in place of the runtime procedure).\nemittedheads:\n\t@JOLT_NO_USER_DEPS=1 bin/jolt run host/chez/emitted-heads-check.clj\n\ncensus:\n\t@sh host/chez/portability-check.sh --census\n\n# PSL R2 adapter contract gate: assert every CONTRACT.txt name is bound in\n# (chezscheme). The chez adapter defines nothing — this only fails when the\n# contract file lists a name Chez does not provide.\nadaptercheck:\nhost/chez/emitted-heads-check.clj\nhost/chez/build-smoke.sh:2299:echo \"build smoke: passed (release + optimized + direct-link + tree-shake + compiler+core shake + data-reader + no-main + optional-native + deps-opt + cljc-cond + jolt-ext + vendored-fs + petite-only-fs + vendored-process + petite-only-process + ffi-clj-layer + petite-only-ffi + declare-only-var + install-owned-order + split-provider-order + embedded-value + sdeps-before-build + source-mode-driver + build-error-location + compile-error-position + scan-alias-set + as-alias + flat-split + runtime-cache + unit-cache + boot-modes + compiler-verdict + gzip-round-trip + signable + include + dep-resources + emitted-head-defs + lazy-shim-absent)\"\nhost/chez/emitted-heads-check.clj:64:                \" host/chez/emitted-heads-check.clj\")))\nname: tests\n\n# Run the gate (make test) on every push and pull request. Chez is the sole\n# substrate; the JVM is used only as the conformance oracle (certify).\non:\n  push:\n  pull_request:\n\n# A newer push to the same branch or PR makes the run in flight moot, so it is\n# cancelled rather than left to hold runners for half an hour. main keeps\n# every run: each commit there is one someone may bisect to. A PR's runs are\n# grouped by its number, not its branch name: head_ref is the bare branch name,\n# so two PRs from different forks that both use, say, fix/typo would share a\n# group and cancel each other. A push groups by its ref.\nconcurrency:\n  group: tests-${{ github.event.pull_request.number && format('pr-{0}', github.event.pull_request.number) || github.ref }}\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n\njobs:\n  # The gate (make test) as parallel shards. The runner has 4 cores and the\n  # gate is ~180 independent targets, so one job spent ~27 minutes working\n  # through them; `make ci-shard` deals the sorted gate list out SHARD of\n  # SHARDS, so the shards between them still run every gate exactly once, a\n  # new gate needs no edit here, and each shard's log holds only its own\n  # targets. fail-fast is off so one red shard doesn't hide another's result.\n  gate:\n    name: test (${{ matrix.shard }}/4)\n    runs-on: ubuntu-latest\n    strategy:\n      fail-fast: false\n      matrix:\n        shard: [1, 2, 3, 4]\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          submodules: recursive   # vendor/irregex, used by the Chez regex shim\n\n      - name: Set up Chez, Gambit and the certify oracle\n        uses: ./.github/actions/setup-chez\n\n      - name: Gate (shard ${{ matrix.shard }}/4)\n        # `make test` = the self-host byte-fixpoint (the rebuilt seed must equal\n        # the checked-in seed byte-for-byte — holds cross-platform on the pinned\n        # source-built Chez) + the behavior gates (`make ci`: corpus/unit/smoke/\n        # buildsmoke/sci/certify). buildsmoke links a real binary (the source\n        # build ships the kernel dev files).\n        # -j overlaps the independent gates (ci is a plain dependency list);\n        # -Oline keeps per-recipe output contiguous for failure reading.\n        env:\n          # The Chez built above is PIC, so `jolt build --library` links here and\n          # buildlibsmoke must actually run. This makes its skip paths fatal, so\n          # the gate cannot go back to reporting green without testing.\n          JOLT_REQUIRE_BUILDLIB: \"1\"\n          # Same for the gambit gates: with a Gambit built above, a skip is a\n          # failure, so they cannot go back to being the no-ops they were.\n          JOLT_REQUIRE_GAMBIT: \"1\"\n          # Every Chez CI builds carries jolt's kernel patches\n          # (ci/apply-chez-patches.sh); a kernel without them is a stale cache\n          # or a patch that stopped applying, not a stock install to tolerate.\n          JOLT_REQUIRE_LOCKFREE_CHEZ: \"1\"\n        # TMPDIR on the runner's disk: from ubuntu-26.04, /tmp is a tmpfs with a\n        # size limit, and the build gates' mktemp dirs (shakelocal keeps two\n        # binaries per app until it exits) ran it out with EDQUOT.\n        run: TMPDIR=\"$RUNNER_TEMP\" make CHEZ=/opt/chez/bin/chez GAMBIT_PREFIX=/opt/gambit -j\"$(nproc)\" -Oline ci-shard SHARD-SET=test SHARD=${{ matrix.shard }} SHARDS=4\n\n  # The check that says the whole gate passed, under the name the single job\n  # had, so anything that waits on \"test\" (a required status check, a person)\n  # still waits on all of it.\n  test:\n    name: test\n    needs: gate\n    if: always()\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    steps:\n      - run: test \"${{ needs.gate.result }}\" = success\n\n  # The gate on bionic (Android/Termux, #943): jolt and its pinned Chez build in\n  # termux/termux-docker on an arm64 runner, the release smokes run there\n  # (ci/termux-build.sh), and then `make bionic-ci` -- the full CI gate: the ten\n  # gates #1148 used to exclude (charsets, PIC kernel, CTS, the off-Android\n  # fixtures) all pass on bionic now. Android has no\n  # /tmp and many gates' fixtures write there by name, so the entrypoint makes one\n  # as root before dropping to the Termux user: the gates are there to exercise\n  # jolt, and jolt itself uses $TMPDIR.\n  #\n  # bionic-ci's gates run as shards, like the gate job's, three ways: each shard repeats the container\n  # setup and the jolt build (~2 minutes), so more shards stop paying. The\n  # bionic Chez the Makefile provisions (provision-chez.sh, ~2 minutes\n  # of the build) is cached between runs: termux-build.sh copies the\n  # workspace in, so a restored prefix is there for make to find, and copies a\n  # fresh one back out to target/bionic-chez for the save step.\n  android-gate:\n    name: Android (bionic ${{ matrix.shard }}/3)\n    runs-on: ubuntu-24.04-arm\n    timeout-minutes: 90\n    strategy:\n      fail-fast: false\n      matrix:\n        shard: [1, 2, 3]\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          submodules: recursive\n      - name: Month (Termux image cache key)\n        id: month\n        run: echo \"month=$(date -u +%Y-%m)\" >> \"$GITHUB_OUTPUT\"\n      # The image comes from the cache, not Docker Hub, when it can: anonymous\n      # pulls from the shared runners hit Docker Hub's rate limit (ci/pull-image.sh).\n      - name: Restore Termux image\n        id: termux-image\n        uses: actions/cache/restore@v5\n        with:\n          path: ~/termux-image.tar\n          key: termux-docker-aarch64-${{ steps.month.outputs.month }}\n      - name: Pull Termux image\n        run: sh ci/pull-image.sh termux/termux-docker:aarch64 \"$HOME/termux-image.tar\"\n      - name: Save Termux image\n        if: steps.termux-image.outputs.cache-hit != 'true'\n        uses: actions/cache/save@v5\n        with:\n          path: ~/termux-image.tar\n          key: termux-docker-aarch64-${{ steps.month.outputs.month }}\n      # Keyed on what decides the build: the makes pin (which names the Chez\n      # version), the provisioning script and jolt's kernel patches.\n      - name: Bionic Chez cache key\n        id: bionic-chez\n        run: echo \"key=bionic-chez-$(sed -n 's/^V := //p' Makefile)-${{ hashFiles('host/chez/provision-chez.sh', 'host/chez/chez-patches/*.patch') }}\" >> \"$GITHUB_OUTPUT\"\n      - name: Restore bionic Chez\n        id: bionic-chez-cache\n        uses: actions/cache/restore@v5\n        with:\n          path: .cache/local\n          key: ${{ steps.bionic-chez.outputs.key }}\n      - name: Build and gate jolt in Termux (shard ${{ matrix.shard }}/3)\n        run: |\n          mkdir -p target/release\n          chmod 777 target target/release\n          docker run --rm --entrypoint /system/bin/sh -v \"$PWD\":/src \\\n            termux/termux-docker:aarch64 \\\n            -c 'mkdir -p /tmp && chmod 1777 /tmp && exec /entrypoint.sh sh /src/ci/termux-build.sh ci-shard SHARD-SET=ci SHARD=${{ matrix.shard }} SHARDS=3'\n      - name: Stage bionic Chez for the cache\n        if: steps.bionic-chez-cache.outputs.cache-hit != 'true'\n        run: |\n          rm -rf .cache/local\n          mkdir -p .cache\n          cp -R target/bionic-chez .cache/local\n      - name: Save bionic Chez\n        if: steps.bionic-chez-cache.outputs.cache-hit != 'true'\n        uses: actions/cache/save@v5\n        with:\n          path: .cache/local\n          key: ${{ steps.bionic-chez.outputs.key }}\n\n  android:\n    name: Android (bionic)\n    needs: android-gate\n    if: always()\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    steps:\n      - run: test \"${{ needs.android-gate.result }}\" = success\n\n  # `make build` on a Mac with no Chez on PATH, so makes provisions Chez 10.4.1\n  # and the Makefile builds it with the host cc (#1601: xPack GCC 14.2.0-1's\n  # <stdio.h> fails against current SDKs). No other job builds this path.\n  macos-provisioned:\n    name: macOS build, provisioned Chez\n    runs-on: macos-15\n    timeout-minutes: 30\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          submodules: recursive\n      - name: No Chez on PATH\n        run: |\n          for n in chez chezscheme scheme; do\n            if command -v \"$n\"; then echo \"::error::$n is on PATH\"; exit 1; fi\n          done\n      - name: Build\n        run: make build\n      - name: Run\n        run: ./target/release/jolt -e '(println (+ 1 2))'\n\n  # No AI-assistant attribution in what a push or PR adds: tools/attributioncheck.sh\n  # over the pushed range (push) or the PR's commits and its description (PR).\n  # Its own job because it needs history — the test job's checkout is shallow,\n  # so origin/main..HEAD is not there to scan — and needs no Chez.\n  clj-kondo:\n    name: clj-kondo\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    env:\n      KONDO_VERSION: 2026.08.04\n      KONDO_SHA256: 25dce55f597cc7f034f6c5f8bf4195128e3efeb3b22710a066fb67b489e70a3b\n    steps:\n      - uses: actions/checkout@v5\n\n      - name: Install clj-kondo\n        run: |\n          zip=\"clj-kondo-$KONDO_VERSION-linux-static-amd64.zip\"\n          curl -fsSL -o \"$RUNNER_TEMP/$zip\" \\\n            \"https://github.com/clj-kondo/clj-kondo/releases/download/v$KONDO_VERSION/$zip\"\n          echo \"$KONDO_SHA256  $RUNNER_TEMP/$zip\" | sha256sum -c -\n          unzip -q \"$RUNNER_TEMP/$zip\" -d \"$RUNNER_TEMP/kondo\"\n          echo \"$RUNNER_TEMP/kondo\" >> \"$GITHUB_PATH\"\n\n      - name: Lint\n        run: make kondocheck\n\n  attribution:\n    name: No AI attribution in commits\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          fetch-depth: 0\n      - name: Commits in range\n        env:\n          EVENT: ${{ github.event_name }}\n          BEFORE: ${{ github.event.before }}\n          BASE_REF: ${{ github.base_ref }}\n        run: |\n          if [ \"$EVENT\" = pull_request ]; then\n            range=\"origin/$BASE_REF..HEAD\"\n          elif [ -n \"$BEFORE\" ] && ! echo \"$BEFORE\" | grep -q '^0*$' && git cat-file -e \"$BEFORE\" 2>/dev/null; then\n            range=\"$BEFORE..HEAD\"\n          else\n            range=\"HEAD~20..HEAD\"   # a new branch or a force-push: the recent commits\n          fi\n          echo \"scanning $range\"\n          sh tools/attributioncheck.sh \"$range\"\n      - name: PR description\n        if: github.event_name == 'pull_request'\n        env:\n          BODY: ${{ github.event.pull_request.body }}\n        run: printf '%s\\n' \"$BODY\" | sh tools/attributioncheck.sh --text\n\n  windows-deps:\n    name: Windows dependency paths\n    runs-on: windows-latest\n    timeout-minutes: 45\n    defaults:\n      run:\n        shell: msys2 {0}\n    steps:\n      - uses: actions/checkout@v5\n        with:\n          submodules: recursive   # vendor/irregex, used by the Chez regex shim\n\n      # Match the release builder: a native MINGW64 toolchain and threaded\n      # Chez 10.4.1 built as ta6nt. Keep this job focused on dependency paths;\n      # the full gate still contains POSIX-specific cases and runs above.\n      - name: Set up MSYS2\n        uses: msys2/setup-msys2@v2\n        with:\n          msystem: MINGW64\n          update: false\n          # inherit the runner PATH so GITHUB_PATH additions (the chez wrapper\n#!/bin/sh\n# Re-mint the checked-in Chez seed. Run after changing a seed source — the reader\n# (host/chez/reader.ss), the analyzer/IR/backend (jolt-core/jolt/*.clj), or the\n# clojure.core overlay (jolt-core/clojure/core/*.clj). Iterates bootstrap.ss from the\n# current seed to a byte-fixpoint and overwrites host/chez/seed/, then cross-mints\n# host/gambit/seed/ from it.\nset -e\nroot=\"$(CDPATH= cd -- \"$(dirname -- \"$0\")/../..\" && pwd)\"\ncd \"$root\"\n# JOLT_CHEZ wins (see host/chez/selfcheck.sh) — re-minting the seed under the\n# wrong Chez is exactly the mistake this script exists to avoid.\nCHEZ=\"${JOLT_CHEZ:-${CHEZ:-$(command -v chez || command -v chezscheme || command -v scheme)}}\"\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\n\ncp host/chez/seed/prelude.ss \"$tmp/cur-p.ss\"\ncp host/chez/seed/image.ss   \"$tmp/cur-i.ss\"\ni=0\nwhile [ \"$i\" -lt 8 ]; do\n  i=$((i + 1))\n  # capture stderr so the fixpoint pass can be checked for skipped forms; the\n  # skip count is only trustworthy once converged (an earlier pass compiling off\n  # an older seed may skip a form that a later pass, off the rebuilt seed, emits).\n  # a bootstrap failure must leave its error readable: the temp dir dies with\n  # the trap, so surface stderr before set -e aborts the loop\n  # JOLT_MINT_DEBUG puts each skipped form's reason in the log. A form a pass\n  # skips is missing from the seed the next pass runs, so when that form is part\n  # of the compiler, the pass that fails is a later one and its own error (an\n  # unbound jv$ name, say) points nowhere near the cause: show what the passes\n  # before it skipped, and why.\n  if ! JOLT_MINT_DEBUG=1 \"$CHEZ\" --script host/chez/bootstrap.ss \\\n      \"$tmp/cur-p.ss\" \"$tmp/cur-i.ss\" \"$tmp/new-p.ss\" \"$tmp/new-i.ss\" >/dev/null 2>\"$tmp/err\"; then\n    echo \"re-mint: bootstrap pass $i failed:\" >&2\n    grep -v '^mint: ' \"$tmp/err\" >&2 || true\n    if [ -s \"$tmp/skips\" ]; then\n      echo \"re-mint: forms the earlier passes skipped:\" >&2\n      cat \"$tmp/skips\" >&2\n    fi\n    exit 1\n  fi\n  grep '^mint: .* raised: ' \"$tmp/err\" | sed \"s/^/pass $i: /\" >>\"$tmp/skips\" || true\n  if diff -q \"$tmp/cur-p.ss\" \"$tmp/new-p.ss\" >/dev/null \\\n     && diff -q \"$tmp/cur-i.ss\" \"$tmp/new-i.ss\" >/dev/null; then\n    skipped=$(sed -n 's/^mint: \\([0-9][0-9]*\\) form(s) skipped$/\\1/p' \"$tmp/err\" | tail -1)\n    if [ -n \"$skipped\" ] && [ \"$skipped\" -ne 0 ]; then\n      echo \"re-mint: $skipped form(s) failed to compile in the fixpoint pass:\" >&2\n      grep '^mint: .* raised: ' \"$tmp/err\" >&2\n      exit 1\n    fi\n    cp \"$tmp/new-p.ss\" host/chez/seed/prelude.ss\n    cp \"$tmp/new-i.ss\" host/chez/seed/image.ss\n    echo \"re-minted seed (converged after $i pass(es))\"\n    # The gambit seed is cross-minted FROM this one (host/gambit/gen-seed.ss\n    # re-emits it with the :gambit target), and gambitseedcheck in CI holds the\n    # two to the same sources. Re-minting only the chez half left it stale, which\n    # is how a contributor who did exactly what CONTRIBUTING said arrived with a\n    # red gate (#1057). set -e: a gen-seed failure fails the remint.\n    \"$CHEZ\" --script host/gambit/gen-seed.ss\n    exit 0\n  fi\n  cp \"$tmp/new-p.ss\" \"$tmp/cur-p.ss\"\n  cp \"$tmp/new-i.ss\" \"$tmp/cur-i.ss\"\ndone\necho \"re-mint did not converge in 8 passes\" >&2\nexit 1\n","exit_code":0,"status":"completed"}}
