\n175:      - name: No Chez on PATH\n177:          for n in chez chezscheme scheme; do\n188:  # so origin/main..HEAD is not there to scan — and needs no Chez.\n250:          submodules: recursive   # vendor/irregex, used by the Chez regex shim\n253:      # Chez 10.4.1 built as ta6nt. Keep this job focused on dependency paths;\n260:          # inherit the runner PATH so GITHUB_PATH additions (the chez wrapper\n270:      - name: Cache Chez Scheme\n271:        id: cache-chez-win\n274:          path: chez-install\n275:          key: chez-windows-latest-v10.4.1-mingw64-${{ hashFiles('host/chez/chez-patches/*.patch') }}\n277:      - name: Build Chez Scheme from source\n278:        if: steps.cache-chez-win.outputs.cache-hit != 'true'\n280:          git clone --depth 1 --branch v10.4.1 https://github.com/cisco/ChezScheme.git /tmp/chez-src\n281:          sh \"$GITHUB_WORKSPACE/ci/apply-chez-patches.sh\" /tmp/chez-src\n282:          cd /tmp/chez-src\n288:          inst=\"$GITHUB_WORKSPACE/chez-install\"\n298:      - name: Put chez on PATH\n300:          bindir=\"$GITHUB_WORKSPACE/chez-install/bin\"\n301:          { echo '#!/bin/sh'; echo \"exec \\\"$bindir/scheme.exe\\\" \\\"\\$@\\\"\"; } > \"$bindir/chez\"\n302:          chmod +x \"$bindir/chez\"\n304:          # make and bin/jolt never take a Chez from PATH.\n305:          echo \"CHEZ=$(cygpath -u \"$bindir\")/chez\" >> \"$GITHUB_ENV\"\n306:          echo \"JOLT_CHEZ=$(cygpath -u \"$bindir\")/chez\" >> \"$GITHUB_ENV\"\n307:          echo \"JOLT_CHEZ_CSV=$GITHUB_WORKSPACE/chez-install/csv\" >> \"$GITHUB_ENV\"\n312:      - name: Show Chez version\n313:        run: chez --version\n316:        run: make CHEZ=./chez-install/bin/chez depsunit mvnhttp\n327:        run: make CHEZ=./chez-install/bin/chez winplatform winpath winparity closedstdout stderrsplit\n336:          make CHEZ=./chez-install/bin/chez flonumdisp\n337:          ./chez-install/bin/scheme.exe --script host/chez/cli.ss -e '(println 1)' > merged.txt 2>&1\n351:          got=\"$(./chez-install/bin/chez --script host/chez/cli.ss -e '(let [b (java.io.ByteArrayOutputStream.)] (with-open [o (java.util.zip.GZIPOutputStream. b)] (.write o (.getBytes (apply str (repeat 1000 \"zip\")) \"UTF-8\"))) [(count (slurp (java.util.zip.GZIPInputStream. (java.io.ByteArrayInputStream. (.toByteArray b))))) (< (.size b) 100)])')\"\n371:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n372:          $resolved = (& $scheme --script host\\chez\\cli.ss -Spath 2>&1 | Out-String)\n382:          $rooted = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n399:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n409:            $out = (& $scheme --script host\\chez\\cli.ss $spelling 2>&1 | Out-String)\n429:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n447:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n455:      # test/chez/win-platform-test.ss pins the decisions with the platform as a\n464:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n480:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n490:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n503:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n513:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n525:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n535:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n556:          $out = (& $scheme --script host\\chez\\cli.ss -e $probe 2>&1 | Out-String).Trim()\n575:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n599:          $out = (& $scheme --script host\\chez\\cli.ss $probe 2>&1 | Out-String).Trim()\n613:          $scheme = Join-Path $env:GITHUB_WORKSPACE 'chez-install\\bin\\scheme.exe'\n631:          $out = (& $scheme --script host\\chez\\cli.ss $probe 2>&1 | Out-String).Trim()\n647:        run: TMPDIR=\"$(cygpath -m \"$RUNNER_TEMP\")\" make CHEZ=./chez-install/bin/chez httpsfetch\n652:        run: TMPDIR=\"$(cygpath -w \"$RUNNER_TEMP\")\" make CHEZ=./chez-install/bin/chez httpsfetch\n#!/usr/bin/env python3\n\"\"\"Record or verify the running platform's explicit Gambit provenance pins.\"\"\"\nimport hashlib\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport tempfile\n\nMANIFEST_DIR = Path(__file__).resolve().parent\nPATHS = (\n    \"bin/gsi\", \"bin/gsc\", \"bin/gambuild-C\", \"include/gambit.h\",\n    \"lib/libgambit.a\", \"lib/libgambitgsi.a\", \"lib/libgambitgsc.a\",\n)\nFORMAT = \"# joltffi toolchain manifest v1\"\n\n\ndef platform_key():\n    host = os.uname()\n    system, machine = host.sysname.lower(), host.machine.lower()\n    machine = {\"aarch64\": \"arm64\", \"amd64\": \"x86_64\"}.get(machine, machine)\n    key = system + \"-\" + machine\n    if not re.fullmatch(r\"[a-z0-9_-]+\", key):\n        raise ValueError(\"invalid uname platform key: \" + repr(key))\n    return key\n\n\ndef selected_manifest():\n    key = platform_key()\n    path = MANIFEST_DIR / (\"TOOLCHAIN.\" + key + \".sha256\")\n    print(\"gambitffi: platform=\" + key + \" manifest=host/gambit/ffi/\" + path.name,\n          flush=True)\n    return key, path\n\n\ndef digest(path):\n    result = hashlib.sha256()\n    with path.open(\"rb\") as stream:\n        for block in iter(lambda: stream.read(1024 * 1024), b\"\"):\n            result.update(block)\n    return result.hexdigest()\n\n\ndef render_manifest(prefix, key):\n    # Hash everything before writing: a missing input cannot leave partial pins.\n    rows = [digest(prefix / name) + \"  \" + name for name in PATHS]\n    return \"\\n\".join([FORMAT, \"# platform: \" + key] + rows) + \"\\n\"\n\n\ndef read_manifest(path, key):\n    if not path.is_file():\n        raise ValueError(\"missing toolchain manifest: \" + str(path) +\n                         \"; record this platform explicitly with record-toolchain.sh\")\n    lines = path.read_text(encoding=\"ascii\").splitlines()\n    if lines[:2] != [FORMAT, \"# platform: \" + key]:\n        raise ValueError(\"toolchain manifest format/platform header mismatch: \" + str(path))\n    rows = [re.fullmatch(r\"([0-9a-f]{64})  (.+)\", line) for line in lines[2:]]\n    if (len(rows) != len(PATHS) or any(row is None for row in rows)\n            or tuple(row.group(2) for row in rows) != PATHS):\n        raise ValueError(\"toolchain manifest must pin exactly the seven ordered inputs: \" + str(path))\n    return [(row.group(1), row.group(2)) for row in rows]\n\n\ndef main(argv=None):\n    argv = sys.argv[1:] if argv is None else argv\n    if len(argv) != 2 or argv[0] not in (\"record\", \"verify\"):\n        print(\"usage: toolchain.py record|verify GAMBIT_PREFIX\", file=sys.stderr)\n        return 2\n    try:\n        key, path = selected_manifest()\n        prefix = Path(argv[1]).resolve()\n        if argv[0] == \"record\":\n            content = render_manifest(prefix, key)\n            temporary = None\n            try:\n                with tempfile.NamedTemporaryFile(mode=\"w\", encoding=\"ascii\",\n                                                 dir=MANIFEST_DIR,\n                                                 prefix=\".\" + path.name + \".\",\n                                                 delete=False) as stream:\n                    temporary = Path(stream.name)\n                    stream.write(content)\n                os.replace(temporary, path)\n            finally:\n                if temporary is not None and temporary.exists():\n                    temporary.unlink()\n            # Explicit recording also pins the new manifest in the source index.\n            # Verification never calls this recording/update path.\n            subprocess.run([\"sh\", str(MANIFEST_DIR / \"make-digests.sh\")], check=True)\n            print(\"gambitffi: recorded 7 toolchain inputs\")\n            print(\"gambitffi: refreshed host/gambit/ffi/DIGESTS.txt\")\n        else:\n            failures = []\n            for expected, name in read_manifest(path, key):\n                if digest(prefix / name) == expected:\n                    print(name + \": OK\")\n                else:\n                    print(name + \": FAILED\", file=sys.stderr)\n                    failures.append(name)\n            if failures:\n                raise ValueError(\"toolchain digest mismatch (\" + str(len(failures)) + \" inputs)\")\n            print(\"gambitffi: toolchain verified (7 inputs)\")\n        return 0\n    except (OSError, ValueError, subprocess.CalledProcessError) as error:\n        print(\"gambitffi: \" + str(error), file=sys.stderr)\n        return 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/../../..\"\nLC_ALL=C\nexport LC_ALL\ndigests() {\n  shasum -a 256 host/gambit/ffi/joltffi-bridge.scm \\\n    host/gambit/ffi/generated-shims.scm host/gambit/ffi/shapes.json \\\n    host/gambit/ffi/generate-shims.py host/gambit/ffi/joltffi-fixture.c \\\n    host/gambit/ffi/joltffi-fixture2.c host/gambit/ffi/joltffi-dep.c \\\n    host/gambit/ffi/joltffi-unloadable.c host/gambit/ffi/toolchain.py \\\n    host/gambit/ffi/record-toolchain.sh host/gambit/ffi/verify-toolchain.sh \\\n    host/gambit/ffi/verify-digests.sh host/gambit/ffi/make-digests.sh \\\n    host/gambit/ffi/TOOLCHAIN.*.sha256\n}\ncase ${1:-} in\n  \"\") digests > host/gambit/ffi/DIGESTS.txt ;;\n  --check)\n    shasum -a 256 -c host/gambit/ffi/DIGESTS.txt\n    if [ \"$(digests)\" != \"$(cat host/gambit/ffi/DIGESTS.txt)\" ]; then\n      echo \"gambitffi: pinned source/manifest catalog is stale; explicitly record/update the digests\" >&2\n      exit 1\n    fi\n    ;;\n  *) echo \"usage: make-digests.sh [--check]\" >&2; exit 2 ;;\nesac\n#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/../../..\"\nprefix=${1:-${GAMBIT_PREFIX:-}}\nif [ -z \"$prefix\" ]; then\n  echo \"usage: verify-digests.sh GAMBIT_PREFIX (or set GAMBIT_PREFIX)\" >&2\n  exit 2\nfi\nsh host/gambit/ffi/verify-toolchain.sh \"$prefix\"\nsh host/gambit/ffi/make-digests.sh --check\npython3 host/gambit/ffi/generate-shims.py --check\n","exit_code":0,"status":"completed"}}
