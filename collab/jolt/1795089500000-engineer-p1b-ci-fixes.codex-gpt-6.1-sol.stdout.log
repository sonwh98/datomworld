on\":\"success\",\"name\":\"Pull Termux image\",\"number\":5,\"startedAt\":\"2026-11-19T10:51:00Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:51:05Z\",\"conclusion\":\"skipped\",\"name\":\"Save Termux image\",\"number\":6,\"startedAt\":\"2026-11-19T10:51:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:51:05Z\",\"conclusion\":\"success\",\"name\":\"Bionic Chez cache key\",\"number\":7,\"startedAt\":\"2026-11-19T10:51:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:51:06Z\",\"conclusion\":\"success\",\"name\":\"Restore bionic Chez\",\"number\":8,\"startedAt\":\"2026-11-19T10:51:05Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:52:48Z\",\"conclusion\":\"failure\",\"name\":\"Build and gate jolt in Termux (shard 3/3)\",\"number\":9,\"startedAt\":\"2026-11-19T10:51:06Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:52:48Z\",\"conclusion\":\"skipped\",\"name\":\"Stage bionic Chez for the cache\",\"number\":10,\"startedAt\":\"2026-11-19T10:52:48Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:52:48Z\",\"conclusion\":\"skipped\",\"name\":\"Save bionic Chez\",\"number\":11,\"startedAt\":\"2026-11-19T10:52:48Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:52:48Z\",\"conclusion\":\"success\",\"name\":\"Post Run actions/checkout@v5\",\"number\":22,\"startedAt\":\"2026-11-19T10:52:48Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-11-19T10:52:48Z\",\"conclusion\":\"success\",\"name\":\"Complete job\",\"number\":23,\"startedAt\":\"2026-11-19T10:52:48Z\",\"status\":\"completed\"}],\"url\":\"https://github.com/sonwh98/jolt/actions/runs/44509339647/job/135509348217\"},{\"completedAt\":\"2026-11-19T11:05:45Z\",\"conclusion\":\"cancelled\",\"databaseId\":135509348256,\"name\":\"macOS build, provisioned Chez\",\"startedAt\":\"2026-11-19T10:50:43Z\",\"status\":\"completed\",\"steps\":[],\"url\":\"https://github.com/sonwh98/jolt/actions/runs/44509339647/job/135509348256\"},{\"