{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"cat 'host/gambit/ffi/verify-digests.sh'\"","aggregated_output":"#!/bin/sh\nset -eu\ncd \"$(dirname \"$0\")/../../..\"\nprefix=${1:-${GAMBIT_PREFIX:-}}\nif [ -z \"$prefix\" ]; then\n  echo \"usage: verify-digests.sh GAMBIT_PREFIX (or set GAMBIT_PREFIX)\" >&2\n  exit 2\nfi\nsh host/gambit/ffi/verify-toolchain.sh \"$prefix\"\nsh host/gambit/ffi/make-digests.sh --check\npython3 host/gambit/ffi/generate-shims.py --check\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"/Library/Developer/CommandLineTools/usr/bin/python3 -c 'import hashlib,json,sys; print(json.dumps({k:hashlib.sha256(v.encode()).hexdigest() for k,v in json.loads(sys.argv[1]).items()}))' '{\\\"host/gambit/ffi/toolchain.py\\\":\\\"#\"'!/usr/bin/env python3'\"\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Record and verify this checkout'\\\\''s Gambit installation, never global pins.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport hashlib\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport shlex\\\\nimport subprocess\\\\nimport sys\\\\nimport tempfile\\\\n\\\\nROOT = Path(__file__).resolve().parents[3]\\\\nRECORD_DIR = ROOT / \\\\\\\"build/gambit-ffi/provenance\\\\\\\"\\\\nPATHS = (\\\\n    \\\\\\\"bin/gsi\\\\\\\", \\\\\\\"bin/gsc\\\\\\\", \\\\\\\"bin/gambuild-C\\\\\\\", \\\\\\\"include/gambit.h\\\\\\\",\\\\n    \\\\\\\"lib/libgambit.a\\\\\\\", \\\\\\\"lib/libgambitgsi.a\\\\\\\", \\\\\\\"lib/libgambitgsc.a\\\\\\\",\\\\n)\\\\nFORMAT = \\\\\\\"joltffi toolchain provenance v2\\\\\\\"\\\\n\\\\n\\\\ndef platform_key():\\\\n    host = os.uname()\\\\n    system, machine = host.sysname.lower(), host.machine.lower()\\\\n    machine = {\\\\\\\"aarch64\\\\\\\": \\\\\\\"arm64\\\\\\\", \\\\\\\"amd64\\\\\\\": \\\\\\\"x86_64\\\\\\\"}.get(machine, machine)\\\\n    key = system + \\\\\\\"-\\\\\\\" + machine\\\\n    # Android/bionic reports Linux/aarch64. Each install records its own\\\\n    # configuration and bytes under linux-arm64; no glibc binary pins are used.\\\\n    if system not in (\\\\\\\"darwin\\\\\\\", \\\\\\\"linux\\\\\\\") or machine not in (\\\\\\\"arm64\\\\\\\", \\\\\\\"x86_64\\\\\\\"):\\\\n        raise ValueError(\\\\\\\"unsupported uname platform: \\\\\\\" + repr(key) +\\\\n                         \\\\\\\"; expected Darwin/Linux on arm64/x86_64\\\\\\\")\\\\n    return key\\\\n\\\\n\\\\ndef digest(path):\\\\n    result = hashlib.sha256()\\\\n    with path.open(\\\\\\\"rb\\\\\\\") as stream:\\\\n        for block in iter(lambda: stream.read(1024 * 1024), b\\\\\\\"\\\\\\\"):\\\\n            result.update(block)\\\\n    return result.hexdigest()\\\\n\\\\n\\\\ndef current_record(prefix, key):\\\\n    inputs = {name: digest(prefix / name) for name in PATHS}\\\\n    version = subprocess.run([str(prefix / \\\\\\\"bin/gsi\\\\\\\"), \\\\\\\"-v\\\\\\\"], check=True,\\\\n                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\\\\n                             text=True, timeout=15).stdout.strip()\\\\n    # Gambit -v: version, build stamp, target triplet, quoted configure command.\\\\n    # Hash the configure summary without surrounding double quotes/newline.\\\\n    parts = version.split(None, 3)\\\\n    if (len(parts) \"'!= 4 or parts[0] != '\"\\\\\\\"v4.9.8\\\\\\\"\\\\n            or not parts[3].startswith('\\\\''\\\\\\\"./configure'\\\\'') or not parts[3].endswith('\\\\''\\\\\\\"'\\\\'')\\\\n            or \\\\\\\"\\\\\\\\n\\\\\\\" in version):\\\\n        raise ValueError(\\\\\\\"unsupported Gambit version/configure summary: \\\\\\\" + repr(version))\\\\n    return {\\\\\\\"format\\\\\\\": FORMAT, \\\\\\\"platform\\\\\\\": key, \\\\\\\"install_path\\\\\\\": str(prefix),\\\\n            \\\\\\\"gambit_version_string\\\\\\\": version,\\\\n            \\\\\\\"configure_summary_sha256\\\\\\\": hashlib.sha256(parts[3][1:-1].encode(\\\\\\\"utf-8\\\\\\\")).hexdigest(),\\\\n            \\\\\\\"inputs_sha256\\\\\\\": inputs}\\\\n\\\\n\\\\ndef render(record):\\\\n    return json.dumps(record, sort_keys=True, indent=2) + \\\\\\\"\\\\\\\\n\\\\\\\"\\\\n\\\\n\\\\ndef main(argv=None):\\\\n    argv = sys.argv[1:] if argv is None else argv\\\\n    if len(argv) \"'!= 2 or argv[0] not in ('\"\\\\\\\"record\\\\\\\", \\\\\\\"verify\\\\\\\"):\\\\n        print(\\\\\\\"usage: toolchain.py record|verify GAMBIT_PREFIX\\\\\\\", file=sys.stderr)\\\\n        return 2\\\\n    try:\\\\n        key = platform_key()\\\\n        path = RECORD_DIR / (\\\\\\\"TOOLCHAIN.\\\\\\\" + key + \\\\\\\".json\\\\\\\")\\\\n        prefix = Path(argv[1]).resolve()\\\\n        command = \\\\\\\"sh host/gambit/ffi/record-toolchain.sh \\\\\\\" + shlex.quote(str(prefix))\\\\n        print(\\\\\\\"gambitffi: platform=\\\\\\\" + key + \\\\\\\" manifest=\\\\\\\" + str(path), flush=True)\\\\n        if argv[0] == \\\\\\\"verify\\\\\\\" and not path.is_file():\\\\n            raise ValueError(\\\\\\\"missing local toolchain provenance; record with: \\\\\\\" + command)\\\\n        record = current_record(prefix, key)\\\\n        if argv[0] == \\\\\\\"record\\\\\\\":\\\\n            path.parent.mkdir(parents=True, exist_ok=True)\\\\n            temporary = None\\\\n            try:\\\\n                with tempfile.NamedTemporaryFile(mode=\\\\\\\"w\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\",\\\\n                                                 dir=path.parent, prefix=\\\\\\\".TOOLCHAIN.\\\\\\\",\\\\n                                                 delete=False) as stream:\\\\n                    temporary = Path(stream.name)\\\\n                    stream.write(render(record))\\\\n                os.replace(temporary, path)\\\\n            finally:\\\\n                if temporary is not None and temporary.exists():\\\\n                    temporary.unlink()\\\\n            print(\\\\\\\"gambitffi: recorded local toolchain provenance (7 inputs); source digests unchanged\\\\\\\")\\\\n        else:\\\\n            if path.read_text(encoding=\\\\\\\"utf-8\\\\\\\") \"'!= render(record):'\"\\\\n                raise ValueError(\\\\\\\"stale local toolchain provenance (platform/version/configure/\\\\\\\"\\\\n                                 \\\\\\\"install path/input mismatch); record with: \\\\\\\" + command)\\\\n            print(\\\\\\\"gambitffi: local toolchain provenance verified (7 inputs)\\\\\\\")\\\\n        return 0\\\\n    except (OSError, ValueError, subprocess.SubprocessError) as error:\\\\n        print(\\\\\\\"gambitffi: \\\\\\\" + str(error), file=sys.stderr)\\\\n        return 1\\\\n\\\\n\\\\nif __name__ == \\\\\\\"__main__\\\\\\\":\\\\n    sys.exit(main())\\\\n\\\",\\\"host/gambit/ffi/test-toolchain.py\\\":\\\"#\"'!/usr/bin/env python3'\"\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Local provenance acceptance/refusals; synthetic hosts do not qualify an ABI.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport contextlib\\\\nimport hashlib\\\\nimport io\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport shlex\\\\nimport shutil\\\\nimport subprocess\\\\nimport sys\\\\nimport tempfile\\\\nfrom types import SimpleNamespace\\\\nimport unittest\\\\nfrom unittest.mock import patch\\\\n\\\\nsys.dont_write_bytecode = True\\\\nimport toolchain\\\\n\\\\nVERSION = '\\\\''v4.9.8 20261119000000 aarch64-linux-android \\\\\\\"./configure \\\\\\\\'\\\\''--enable-single-host\\\\\\\\'\\\\''\\\\\\\"'\\\\''\\\\n\\\\n\\\\nclass ToolchainChecks(unittest.TestCase):\\\\n    def setUp(self):\\\\n        temporary = tempfile.TemporaryDirectory(dir=os.environ.get(\\\\\\\"TMPDIR\\\\\\\"))\\\\n        self.addCleanup(temporary.cleanup)\\\\n        self.root = Path(temporary.name)\\\\n        self.prefix = self.root / \\\\\\\"install\\\\\\\"\\\\n        self.records = self.root / \\\\\\\"records\\\\\\\"\\\\n        for name in toolchain.PATHS:\\\\n            path = self.prefix / name\\\\n            path.parent.mkdir(parents=True, exist_ok=True)\\\\n            path.write_bytes((\\\\\\\"synthetic input: \\\\\\\" + name).encode())\\\\n        self.set_version(VERSION)\\\\n        self.linux = SimpleNamespace(sysname=\\\\\\\"Linux\\\\\\\", machine=\\\\\\\"x86_64\\\\\\\")\\\\n        self.record = self.records / \\\\\\\"TOOLCHAIN.linux-x86_64.json\\\\\\\"\\\\n\\\\n    def set_version(self, version):\\\\n        gsi = self.prefix / \\\\\\\"bin/gsi\\\\\\\"\\\\n        gsi.write_text(\\\\\\\"#\"'!/bin/sh'\"\\\\\\\\nprintf '\\\\''%s\\\\\\\\\\\\\\\\n'\\\\'' \\\\\\\" + shlex.quote(version) + \\\\\\\"\\\\\\\\n\\\\\\\")\\\\n        gsi.chmod(0o755)\\\\n\\\\n    def invoke(self, action, host=None, prefix=None):\\\\n        out, err = io.StringIO(), io.StringIO()\\\\n        with patch.object(toolchain, \\\\\\\"RECORD_DIR\\\\\\\", self.records), \\\\\\\\\\\\n                patch.object(toolchain.os, \\\\\\\"uname\\\\\\\", return_value=host or self.linux), \\\\\\\\\\\\n                contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):\\\\n            code = toolchain.main([action, str(prefix or self.prefix)])\\\\n        return code, out.getvalue(), err.getvalue()\\\\n\\\\n    def valid_record(self):\\\\n        code, _, err = self.invoke(\\\\\\\"record\\\\\\\")\\\\n        self.assertEqual(code, 0, err)\\\\n\\\\n    def test_record_and_accept_current_install(self):\\\\n        self.valid_record()\\\\n        record = json.loads(self.record.read_text())\\\\n        self.assertEqual(record[\\\\\\\"platform\\\\\\\"], \\\\\\\"linux-x86_64\\\\\\\")\\\\n        self.assertEqual(record[\\\\\\\"install_path\\\\\\\"], str(self.prefix))\\\\n        self.assertEqual(record[\\\\\\\"gambit_version_string\\\\\\\"], VERSION)\\\\n        self.assertEqual(record[\\\\\\\"configure_summary_sha256\\\\\\\"],\\\\n                         hashlib.sha256(b\\\\\\\"./configure '\\\\''--enable-single-host'\\\\''\\\\\\\").hexdigest())\\\\n        self.assertEqual(set(record[\\\\\\\"inputs_sha256\\\\\\\"]), set(toolchain.PATHS))\\\\n        code, out, err = self.invoke(\\\\\\\"verify\\\\\\\")\\\\n        self.assertEqual(code, 0, err)\\\\n        self.assertIn(\\\\\\\"platform=linux-x86_64\\\\\\\", out)\\\\n        self.assertIn(str(self.record), out)\\\\n        self.assertIn(\\\\\\\"local toolchain provenance verified (7 inputs)\\\\\\\", out)\\\\n\\\\n    def test_missing_record_never_uses_another_platform(self):\\\\n        self.valid_record()\\\\n        self.record.rename(self.records / \\\\\\\"TOOLCHAIN.darwin-arm64.json\\\\\\\")\\\\n        code, _, err = self.invoke(\\\\\\\"verify\\\\\\\")\\\\n        self.assertEqual(code, 1)\\\\n        self.assertIn(\\\\\\\"missing local toolchain provenance\\\\\\\", err)\\\\n        self.assertIn(\\\\\\\"sh host/gambit/ffi/record-toolchain.sh \\\\\\\" + str(self.prefix), err)\\\\n\\\\n    def test_each_provenance_field_is_checked(self):\\\\n        self.valid_record()\\\\n        before = self.record.read_text()\\\\n        for field in json.loads(before):\\\\n            with self.subTest(field=field):\\\\n                record = json.loads(before)\\\\n                record[field] = \\\\\\\"stale\\\\\\\"\\\\n                self.record.write_text(json.dumps(record))\\\\n                code, _, err = self.invoke(\\\\\\\"verify\\\\\\\")\\\\n                self.assertEqual(code, 1)\\\\n                self.assertIn(\\\\\\\"stale local toolchain provenance\\\\\\\", err)\\\\n\\\\n    def test_fresh_build_requires_record_then_is_accepted(self):\\\\n        self.valid_record()\\\\n        (self.prefix / \\\\\\\"bin/gsc\\\\\\\").write_bytes(b\\\\\\\"another legitimate build\\\\\\\")\\\\n        self.set_version(VERSION.replace(\\\\\\\"20261119000000\\\\\\\", \\\\\\\"20261119111111\\\\\\\"))\\\\n        self.assertEqual(self.invoke(\\\\\\\"verify\\\\\\\")[0], 1)\\\\n        self.valid_record()\\\\n        self.assertEqual(self.invoke(\\\\\\\"verify\\\\\\\")[0], 0)\\\\n\\\\n    def test_changed_configure_summary_is_rejected(self):\\\\n        self.valid_record()\\\\n        self.set_version(VERSION.replace(\\\\\\\"--enable-single-host\\\\\\\", \\\\\\\"--enable-multiple-hosts\\\\\\\"))\\\\n        self.assertEqual(self.invoke(\\\\\\\"verify\\\\\\\")[0], 1)\\\\n\\\\n    def test_install_path_is_checked_and_explicitly_recordable(self):\\\\n        self.valid_record()\\\\n        second = self.root / \\\\\\\"different install\\\\\\\"\\\\n        shutil.copytree(self.prefix, second)\\\\n        self.assertEqual(self.invoke(\\\\\\\"verify\\\\\\\", prefix=second)[0], 1)\\\\n        self.assertEqual(self.invoke(\\\\\\\"record\\\\\\\", prefix=second)[0], 0)\\\\n        self.assertEqual(self.invoke(\\\\\\\"verify\\\\\\\", prefix=second)[0], 0)\\\\n\\\\n    def test_record_is_deterministic(self):\\\\n        self.valid_record()\\\\n        before = self.record.read_bytes()\\\\n        os.utime(self.prefix / \\\\\\\"bin/gsc\\\\\\\", (0, 0))\\\\n        self.valid_record()\\\\n        self.assertEqual(self.record.read_bytes(), before)\\\\n\\\\n    def test_missing_input_does_not_replace_record(self):\\\\n        self.valid_record()\\\\n        before = self.record.read_bytes()\\\\n        (self.prefix / \\\\\\\"bin/gsc\\\\\\\").unlink()\\\\n        self.assertEqual(self.invoke(\\\\\\\"record\\\\\\\")[0], 1)\\\\n        self.assertEqual(self.record.read_bytes(), before)\\\\n\\\\n    def test_unrecognized_version_refuses(self):\\\\n        self.set_version(\\\\\\\"v4.9.9 no configure summary\\\\\\\")\\\\n        self.assertEqual(self.invoke(\\\\\\\"record\\\\\\\")[0], 1)\\\\n        self.assertFalse(self.record.exists())\\\\n\\\\n    def test_bionic_uname_can_record_linux_arm64(self):\\\\n        host = SimpleNamespace(sysname=\\\\\\\"Linux\\\\\\\", machine=\\\\\\\"aarch64\\\\\\\")\\\\n        code, out, err = self.invoke(\\\\\\\"record\\\\\\\", host)\\\\n        self.assertEqual(code, 0, err)\\\\n        self.assertIn(\\\\\\\"platform=linux-arm64\\\\\\\", out)\\\\n        self.assertTrue((self.records / \\\\\\\"TOOLCHAIN.linux-arm64.json\\\\\\\").exists())\\\\n        self.assertEqual(self.invoke(\\\\\\\"verify\\\\\\\", host)[0], 0)\\\\n\\\\n    def test_unsupported_uname_refuses_clearly(self):\\\\n        for system, machine in ((\\\\\\\"FreeBSD\\\\\\\", \\\\\\\"amd64\\\\\\\"), (\\\\\\\"../Linux\\\\\\\", \\\\\\\"arm64\\\\\\\"), (\\\\\\\"Linux\\\\\\\", \\\\\\\"riscv64\\\\\\\")):\\\\n            code, _, err = self.invoke(\\\\\\\"record\\\\\\\", SimpleNamespace(sysname=system, machine=machine))\\\\n            self.assertEqual(code, 1)\\\\n            self.assertIn(\\\\\\\"unsupported uname platform\\\\\\\", err)\\\\n\\\\n    def test_real_shell_entrypoints_keep_sources_pinned_and_records_local(self):\\\\n        destination = self.root / \\\\\\\"checkout/host/gambit/ffi\\\\\\\"\\\\n        shutil.copytree(Path(toolchain.__file__).parent, destination)\\\\n        before = (destination / \\\\\\\"DIGESTS.txt\\\\\\\").read_bytes()\\\\n        command = [\\\\\\\"sh\\\\\\\", str(destination / \\\\\\\"record-toolchain.sh\\\\\\\"), str(self.prefix)]\\\\n        result = subprocess.run(command, capture_output=True, text=True, timeout=20)\\\\n        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)\\\\n        self.assertEqual((destination / \\\\\\\"DIGESTS.txt\\\\\\\").read_bytes(), before)\\\\n        verify = [\\\\\\\"sh\\\\\\\", str(destination / \\\\\\\"verify-digests.sh\\\\\\\"), str(self.prefix)]\\\\n        result = subprocess.run(verify, capture_output=True, text=True, timeout=20)\\\\n        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)\\\\n        records = self.root / \\\\\\\"checkout/build/gambit-ffi/provenance\\\\\\\"\\\\n        shutil.rmtree(records)\\\\n        result = subprocess.run(verify, capture_output=True, text=True, timeout=20)\\\\n        self.assertNotEqual(result.returncode, 0)\\\\n        self.assertIn(\\\\\\\"missing local toolchain provenance\\\\\\\", result.stderr)\\\\n        # Source corruption is checked even when provenance is missing.\\\\n        with (destination / \\\\\\\"joltffi-fixture.c\\\\\\\").open(\\\\\\\"a\\\\\\\") as stream:\\\\n            stream.write(\\\\\\\"\\\\\\\\n/* changed input */\\\\\\\\n\\\\\\\")\\\\n        result = subprocess.run(verify, capture_output=True, text=True, timeout=20)\\\\n        self.assertNotEqual(result.returncode, 0)\\\\n        self.assertIn(\\\\\\\"joltffi-fixture.c: FAILED\\\\\\\", result.stdout)\\\\n\\\\n\\\\nif __name__ == \\\\\\\"__main__\\\\\\\":\\\\n    unittest.main(verbosity=2)\\\\n\\\",\\\"host/gambit/ffi/make-digests.sh\\\":\\\"#\"'!/bin/sh'\"\\\\nset -eu\\\\ncd \\\\\\\"\"'$(dirname '\"\\\\\\\"\"'$0'\"\\\\\\\")/../../..\\\\\\\"\\\\nLC_ALL=C\\\\nexport LC_ALL\\\\ndigests() {\\\\n  shasum -a 256 host/gambit/ffi/joltffi-bridge.scm \\\\\\\\\\\\n    host/gambit/ffi/generated-shims.scm host/gambit/ffi/shapes.json \\\\\\\\\\\\n    host/gambit/ffi/generate-shims.py host/gambit/ffi/joltffi-fixture.c \\\\\\\\\\\\n    host/gambit/ffi/joltffi-fixture2.c host/gambit/ffi/joltffi-dep.c \\\\\\\\\\\\n    host/gambit/ffi/joltffi-unloadable.c host/gambit/ffi/toolchain.py \\\\\\\\\\\\n    host/gambit/ffi/record-toolchain.sh host/gambit/ffi/verify-toolchain.sh \\\\\\\\\\\\n    host/gambit/ffi/verify-digests.sh host/gambit/ffi/make-digests.sh\\\\n}\\\\ncase \"'${1:-} in'\"\\\\n  \\\\\\\"\\\\\\\") digests > host/gambit/ffi/DIGESTS.txt ;;\\\\n  --check)\\\\n    shasum -a 256 -c host/gambit/ffi/DIGESTS.txt\\\\n    if [ \\\\\\\"\"'$(digests)'\"\\\\\\\" \"'!= '\"\\\\\\\"\"'$(cat host/gambit/ffi/DIGESTS.txt)'\"\\\\\\\" ]; then\\\\n      echo \\\\\\\"gambitffi: pinned source catalog is stale; explicitly update the source digests\\\\\\\" >&2\\\\n      exit 1\\\\n    fi\\\\n    ;;\\\\n  *) echo \\\\\\\"usage: make-digests.sh [--check]\\\\\\\" >&2; exit 2 ;;\\\\nesac\\\\n\\\",\\\"host/gambit/ffi/verify-digests.sh\\\":\\\"#\"'!/bin/sh'\"\\\\nset -eu\\\\ncd \\\\\\\"\"'$(dirname '\"\\\\\\\"\"'$0'\"\\\\\\\")/../../..\\\\\\\"\\\\n# Reviewed bridge inputs are checked even when local provenance is absent.\\\\nsh host/gambit/ffi/make-digests.sh --check\\\\npython3 host/gambit/ffi/generate-shims.py --check\\\\nprefix=\"'${1:-${GAMBIT_PREFIX:-}}'\"\\\\nif [ -z \\\\\\\"\"'$prefix'\"\\\\\\\" ]; then\\\\n  echo \\\\\\\"usage: verify-digests.sh GAMBIT_PREFIX (or set GAMBIT_PREFIX)\\\\\\\" >&2\\\\n  exit 2\\\\nfi\\\\nsh host/gambit/ffi/verify-toolchain.sh \\\\\\\"\"'$prefix'\"\\\\\\\"\\\\n\\\"}'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"/Library/Developer/CommandLineTools/usr/bin/python3 -c 'import hashlib,json,sys; print(json.dumps({k:hashlib.sha256(v.encode()).hexdigest() for k,v in json.loads(sys.argv[1]).items()}))' '{\\\"host/gambit/ffi/toolchain.py\\\":\\\"#\"'!/usr/bin/env python3'\"\\\\n\\\\\\\"\\\\\\\"\\\\\\\"Record and verify this checkout'\\\\''s Gambit installation, never global pins.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport hashlib\\\\nimport json\\\\nimport os\\\\nfrom pathlib import Path\\\\nimport shlex\\\\nimport subprocess\\\\nimport sys\\\\nimport tempfile\\\\n\\\\nROOT = Path(__file__).resolve().parents[3]\\\\nRECORD_DIR = ROOT / \\\\\\\"build/gambit-ffi/provenance\\\\\\\"\\\\nPATHS = (\\\\n    \\\\\\\"bin/gsi\\\\\\\", \\\\\\\"bin/gsc\\\\\\\", \\\\\\\"bin/gambuild-C\\\\\\\", \\\\\\\"include/gambit.h\\\\\\\",\\\\n    \\\\\\\"lib/libgambit.a\\\\\\\", \\\\\\\"lib/libgambitgsi.a\\\\\\\", \\\\\\\"lib/libgambitgsc.a\\\\\\\",\\\\n)\\\\nFORMAT = \\\\\\\"joltffi toolchain provenance v2\\\\\\\"\\\\n\\\\n\\\\ndef platform_key():\\\\n    host = os.uname()\\\\n    system, machine = host.sysname.lower(), host.machine.lower()\\\\n    machine = {\\\\\\\"aarch64\\\\\\\": \\\\\\\"arm64\\\\\\\", \\\\\\\"amd64\\\\\\\": \\\\\\\"x86_64\\\\\\\"}.get(machine, machine)\\\\n    key = system + \\\\\\\"-\\\\\\\" + machine\\\\n    # Android/bionic reports Linux/aarch64. Each install records its own\\\\n    # configuration and bytes under linux-arm64; no glibc binary pins are used.\\\\n    if system not in (\\\\\\\"darwin\\\\\\\", \\\\\\\"linux\\\\\\\") or machine not in (\\\\\\\"arm64\\\\\\\", \\\\\\\"x86_64\\\\\\\"):\\\\n        raise ValueError(\\\\\\\"unsupported uname platform: \\\\\\\" + repr(key) +\\\\n                         \\\\\\\"; expected Darwin/Linux on arm64/x86_64\\\\\\\")\\\\n    return key\\\\n\\\\n\\\\ndef digest(path):\\\\n    result = hashlib.sha256()\\\\n    with path.open(\\\\\\\"rb\\\\\\\") as stream:\\\\n        for block in iter(lambda: stream.read(1024 * 1024), b\\\\\\\"\\\\\\\"):\\\\n            result.update(block)\\\\n    return result.hexdigest()\\\\n\\\\n\\\\ndef current_record(prefix, key):\\\\n    inputs = {name: digest(prefix / name) for name in PATHS}\\\\n    version = subprocess.run([str(prefix / \\\\\\\"bin/gsi\\\\\\\"), \\\\\\\"-v\\\\\\\"], check=True,\\\\n                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\\\\n                             text=True, timeout=15).stdout.strip()\\\\n    # Gambit -v: version, build stamp, target triplet, quoted configure command.\\\\n    # Hash the configure summary without surrounding double quotes/newline.\\\\n    parts = version.split(None, 3)\\\\n    if (len(parts) \"'!= 4 or parts[0] != '\"\\\\\\\"v4.9.8\\\\\\\"\\\\n            or not parts[3].startswith('\\\\''\\\\\\\"./configure'\\\\'') or not parts[3].endswith('\\\\''\\\\\\\"'\\\\'')\\\\n            or \\\\\\\"\\\\\\\\n\\\\\\\" in version):\\\\n        raise ValueError(\\\\\\\"unsupported Gambit version/configure summary: \\\\\\\" + repr(version))\\\\n    return {\\\\\\\"format\\\\\\\": FORMAT, \\\\\\\"platform\\\\\\\": key, \\\\\\\"install_path\\\\\\\": str(prefix),\\\\n            \\\\\\\"gambit_version_string\\\\\\\": version,\\\\n            \\\\\\\"configure_summary_sha256\\\\\\\": hashlib.sha256(parts[3][1:-1].encode(\\\\\\\"utf-8\\\\\\\")).hexdigest(),\\\\n            \\\\\\\"inputs_sha256\\\\\\\": inputs}\\\\n\\\\n\\\\ndef render(record):\\\\n    return json.dumps(record, sort_keys=True, indent=2) + \\\\\\\"\\\\\\\\n\\\\\\\"\\\\n\\\\n\\\\ndef main(argv=None):\\\\n    argv = sys.argv[1:] if argv is None else argv\\\\n    if len(argv) \"'!= 2 or argv[0] not in ('\"\\\\\\\"record\\\\\\\", \\\\\\\"verify\\\\\\\"):\\\\n        print(\\\\\\\"usage: toolchain.py record|verify GAMBIT_PREFIX\\\\\\\", file=sys.stderr)\\\\n        return 2\\\\n    try:\\\\n        key = platform_key()\\\\n        path = RECORD_DIR / (\\\\\\\"TOOLCHAIN.\\\\\\\" + key + \\\\\\\".json\\\\\\\")\\\\n        prefix = Path(argv[1]).resolve()\\\\n        command = \\\\\\\"sh host/gambit/ffi/record-toolchain.sh \\\\\\\" + shlex.quote(str(prefix))\\\\n        print(\\\\\\\"gambitffi: platform=\\\\\\\" + key + \\\\\\\" manifest=\\\\\\\" + str(path), flush=True)\\\\n        if argv[0] == \\\\\\\"verify\\\\\\\" and not path.is_file():\\\\n            raise ValueError(\\\\\\\"missing local toolchain provenance; record with: \\\\\\\" + command)\\\\n        record = current_record(prefix, key)\\\\n        if argv[0] == \\\\\\\"record\\\\\\\":\\\\n            path.parent.mkdir(parents=True, exist_ok=True)\\\\n            temporary = None\\\\n            try:\\\\n                with tempfile.NamedTemporaryFile(mode=\\\\\\\"w\\\\\\\", encoding=\\\\\\\"utf-8\\\\\\\",\\\\n                                                 dir=path.parent, prefix=\\\\\\\".TOOLCHAIN.\\\\\\\",\\\\n                                                 delete=False) as stream:\\\\n                    temporary = Path(stream.name)\\\\n                    stream.write(render(record))\\\\n                os.replace(temporary, path)\\\\n            finally:\\\\n                if temporary is not None and temporary.exists():\\\\n                    temporary.unlink()\\\\n            print(\\\\\\\"gambitffi: recorded local toolchain provenance (7 inputs); source digests unchanged\\\\\\\")\\\\n        else:\\\\n            if path.read_text(encoding=\\\\\\\"utf-8\\\\\\\") \"'!= render(record):'\"\\\\n                raise ValueError(\\\\\\\"stale local toolchain provenance (platform/version/configure/\\\\\\\"\\\\n                                 \\\\\\\"install path/input mismatch); record with: \\\\\\\" + command)\\\\n            print(\\\\\\\"gambitffi: local toolchain provenance verified (7 inputs)\\\\\\\")\\\\n        return 0\\\\n    except (OSError, ValueError, subprocess.SubprocessError) as error:\\\\n        print(\\\\\\\"gambitffi: \\\\\\\" + str(