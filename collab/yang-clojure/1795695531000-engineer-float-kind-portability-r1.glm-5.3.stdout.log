{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_03e1e57ed70045acae6b31f1","type":"tool_result","content":"1\t(ns yang.clojure.core-module\n2\t  \"Cell-free publication and task-local initialization of the Clojure library.\"\n3\t  (:require [yang.clojure.core-impl :as impl]\n4\t            [yang.clojure.prelude :as clj]\n5\t            [yang.core.prelude :as core]\n6\t            [yang.core.prelude-admission :as admission]\n7\t            [yang.core.uast :as u]))\n8\t\n9\t\n10\t(def module-name 'clojure.core)\n11\t\n12\t(def ^:private table-key 'clojure.core.rt/exports)\n13\t(def ^:private uninitialized :clojure.core/uninitialized)\n14\t\n15\t\n16\t(defn accessor-name [name]\n17\t  (symbol (str module-name) (str name)))\n18\t\n19\t\n20\t(defn entry-key [name]\n21\t  (symbol \"clojure.core.rt\" (str name)))\n22\t\n23\t\n24\t(def source-names\n25\t  ;; The Clojure lowerer already emits these predicates as VM primitives.\n26\t  ;; The facade also offers cell accessors for descriptor projections.\n27\t  (disj (set impl/public-names) 'empty? 'nil?))\n28\t\n29\t\n30\t(defn referenced-exports [free-names]\n31\t  (into #{}\n32\t        (keep (fn [sym]\n33\t                (when (= \"clojure.core\" (namespace sym))\n34\t                  (let [name (symbol (name sym))]\n35\t                    (when (contains? source-names name) name)))))\n36\t        free-names))\n37\t\n38\t\n39\t(defn- facade-definitions [names]\n40\t  (let [populate\n41\t        (reduce (fn [table name]\n42\t                  (list 'clj/prim-assoc table (list 'quote name)\n43\t                        (list 'clj/make-source-callable (list 'quote (entry-key name))\n44\t                              {:clj/type :function} (impl/callable-entry name))))\n45\t                {} names)]\n46\t    (into [[table-key uninitialized]\n47\t           ['clojure.core/init!\n48\t            (list 'fn []\n49\t                  (list 'if (list 'data/content= table-key uninitialized)\n50\t                        (core/define table-key populate)\n51\t                        nil))]\n52\t           ['clojure.core/export '(fn [name] (clj/prim-get clojure.core.rt/exports name))]]\n53\t          (map (fn [name]\n54\t                 [(accessor-name name) (list 'fn [] (list 'clojure.core/export (list 'quote name)))]))\n55\t          names)))\n56\t\n57\t\n58\t(def ^:private definitions (facade-definitions impl/public-names))\n59\t\n60\t\n61\t(def module-exports (core/exports (str module-name) definitions))\n62\t\n63\t\n64\t(defn bundled-uast\n65\t  \"Install the same facade over the subset of exports the bundled unit reads.\"\n66\t  [names]\n67\t  (let [names (filterv names impl/public-names)]\n68\t    (u/seq-nodes [(impl/bundled-uast names)\n69\t                  (core/balanced-definitions->uast (facade-definitions names))\n70\t                  (u/app (u/v 'clojure.core/init!))])))\n71\t\n72\t\n73\t(def module-uast\n74\t  (let [nodes (mapv (fn [[name body]] (u/def! name (u/sexp->uast body)))\n75\t                    (core/module-definitions (str module-name) uninitialized [] definitions))\n76\t        [facade accessors] (split-at 3 nodes)\n77\t        requires (mapv u/sexp->uast '[(require 'clj) (require 'clojure.core.impl)])]\n78\t    ;; The table and export reader dominate the accessor bodies. Load the\n79\t    ;; dependencies before installing accessors named after VM primitives.\n80\t    (u/annotate-call-sites (core/wide-app (concat facade requires accessors)))))\n81\t\n82\t\n83\t(def ^:private free-names (core/free-name-vec module-uast))\n84\t\n85\t\n86\t(defn module-spec [registry clj-address impl-address]\n87\t  (let [requires {clj/module-name clj-address impl/module-name impl-address}]\n88\t    (admission/module-spec\n89\t      {:module-name module-name :ast module-uast :exports module-exports\n90\t       :requires requires :free-names free-names\n91\t       :skip? #(contains? requires (some-> % namespace symbol))\n92\t       :registry registry :message \"clojure.core reads an undeclared name\"\n93\t       :refusal-ns \"yang.clojure\"})))\n94\t"}]},"parent_tool_use_id":null,"session_id":"519cc353-4ebf-4ee9-a727-f6a51287dd1a","uuid":"d8bd9562-8046-437b-a9de-88f8cbe2d410","timestamp":"2026-11-26T12:27:47.596Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-floatkind/src/cljc/yang/clojure/core_module.cljc","content":"(ns yang.clojure.core-module\n  \"Cell-free publication and task-local initialization of the Clojure library.\"\n  (:require [yang.clojure.core-impl :as impl]\n            [yang.clojure.prelude :as clj]\n            [yang.core.prelude :as core]\n            [yang.core.prelude-admission :as admission]\n            [yang.core.uast :as u]))\n\n\n(def module-name 'clojure.core)\n\n(def ^:private table-key 'clojure.core.rt/exports)\n(def ^:private uninitialized :clojure.core/uninitialized)\n\n\n(defn accessor-name [name]\n  (symbol (str module-name) (str name)))\n\n\n(defn entry-key [name]\n  (symbol \"clojure.core.rt\" (str name)))\n\n\n(def source-names\n  ;; The Clojure lowerer already emits these predicates as VM primitives.\n  ;; The facade also offers cell accessors for descriptor projections.\n  (disj (set impl/public-names) 'empty? 'nil?))\n\n\n(defn referenced-exports [free-names]\n  (into #{}\n        (keep (fn [sym]\n                (when (= \"clojure.core\" (namespace sym))\n                  (let [name (symbol (name sym))]\n                    (when (contains? source-names name) name)))))\n        free-names))\n\n\n(defn- facade-definitions [names]\n  (let [populate\n        (reduce (fn [table name]\n                  (list 'clj/prim-assoc table (list 'quote name)\n                        (list 'clj/make-source-callable (list 'quote (entry-key name))\n                              {:clj/type :function} (impl/callable-entry name))))\n                {} names)]\n    (into [[table-key uninitialized]\n           ['clojure.core/init!\n            (list 'fn []\n                  (list 'if (list 'data/content= table-key uninitialized)\n                        (core/define table-key populate)\n                        nil))]\n           ['clojure.core/export '(fn [name] (clj/prim-get clojure.core.rt/exports name))]]\n          (map (fn [name]\n                 [(accessor-name name) (list 'fn [] (list 'clojure.core/export (list 'quote name)))]))\n          names)))\n\n\n(def ^:private definitions (facade-definitions impl/public-names))\n\n\n(def module-exports (core/exports (str module-name) definitions))\n\n\n(defn bundled-uast\n  \"Install the same facade over the subset of exports the bundled unit reads.\"\n  [names]\n  (let [names (filterv names impl/public-names)]\n    (u/seq-nodes [(impl/bundled-uast names)\n                  (core/balanced-definitions->uast (facade-definitions names))\n                  (u/app (u/v 'clojure.core/init!))])))\n\n\n(def module-uast\n  (let [nodes (mapv (fn [[name body]] (u/def! name (u/sexp->uast body)))\n                    (core/module-definitions (str module-name) uninitialized [] definitions))\n        [facade accessors] (split-at 3 nodes)\n        requires (mapv u/sexp->uast '[(require 'clj) (require 'clojure.core.impl)])]\n    ;; The table and export reader dominate the accessor bodies. Load the\n    ;; dependencies before installing accessors named after VM primitives.\n    (u/annotate-call-sites (core/wide-app (concat facade requires accessors)))))\n\n\n(def ^:private free-names (core/free-name-vec module-uast))\n\n\n(defn module-spec [registry clj-address impl-address]\n  (let [requires {clj/module-name clj-address impl/module-name impl-address}]\n    (admission/module-spec\n      {:module-name module-name :ast module-uast :exports module-exports\n       :requires requires :free-names free-names\n       :skip? #(contains? requires (some-> % namespace symbol))\n       :registry registry :message \"clojure.core reads an undeclared name\"\n       :refusal-ns \"yang.clojure\"})))\n","numLines":94