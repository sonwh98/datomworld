{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_54600b608c224c2e9e96522c","type":"tool_result","content":"380\t    (apply hash-set elements)))\n381\t\n382\t\n383\t(defn- sized-map-entries\n384\t  \"n recorded entries with constant keys :k0.. and dynamic values.\"\n385\t  [n]\n386\t  (into [] (map (fn [i] [(keyword (str \"k\" i)) (list '+ 'n i)])) (range n)))\n387\t\n388\t\n389\t(defn- sized-set-elements\n390\t  \"n recorded dynamic elements.\"\n391\t  [n]\n392\t  (into [] (map (fn [i] (list '+ 'n i))) (range n)))\n393\t\n394\t\n395\t;; =============================================================================\n396\t;; RULING 3 test 2: map representation/permutation property\n397\t;; =============================================================================\n398\t\n399\t(def ^:private quoted-pair-key\n400\t  \"A quoted collection key, one plain and one carrying semantic (non\n401\t   position) metadata inside the literal payload.\"\n402\t  (list 'quote [1 2]))\n403\t\n404\t\n405\t(def ^:private quoted-meta-key\n406\t  ;; a different value than quoted-pair-key: host = ignores metadata, so\n407\t  ;; two metadata-variants of one value cannot coexist as map keys (the\n408\t  ;; host map collapses them); metadata-as-content is asserted separately\n409\t  ;; in the oracle test\n410\t  (list 'quote (with-meta [3 4] {:sem true})))\n411\t\n412\t\n413\t(def ^:private map-corpus\n414\t  \"The recorded corpus of distinct source-entry pairs. Every case holds at\n415\t   least one dynamic expression, so each reaches the emitter as a\n416\t   constructed collection.\"\n417\t  [[:constant-keys-dynamic-values\n418\t    [[:a (list '+ 'n 0)] [:b (list '+ 'n 1)]]]\n419\t   [:dynamic-keys\n420\t    [[(list 'first 'xs) :v1] [(list 'first (list 'rest 'xs)) :v2]]]\n421\t   [:heterogeneous-keys\n422\t    [[:kw (list '+ 'n 0)] [\"str\" 1] [3 1.5] ['sym 2]\n423\t     [quoted-pair-key 3] [quoted-meta-key 4] [true 5] [nil 6]]]\n424\t   [:nested-collections\n425\t    [[:inner-map {:inner (list '+ 'n 1)}]\n426\t     [:inner-set #{(list '+ 'n 2) 3}]\n427\t     [:inner-vec [(list '+ 'n 3)]]\n428\t     [:deep {:a #{[(list '+ 'n 4)]}}]]]\n429\t   ;; non-integral floats only: a bare INTEGRAL-valued double (0.0) is a\n430\t   ;; documented host numeric-identity boundary -- the JVM's codec wraps\n431\t   ;; every double in the float64 carrier while the JS host encodes a bare\n432\t   ;; integral Number as an integer, so such a literal mints different\n433\t   ;; content per host (first caught by the cross-host reference on its\n434\t   ;; first Node run; divergent digests recorded in the r3 findings). That\n435\t   ;; boundary is encoder/float-carrier territory and stays outside this\n436\t   ;; round's bounds; float coverage here uses non-integral doubles, which\n437\t   ;; travel as float64 on every host.\n438\t   [:floats\n439\t    [[1.5 (list '+ 'n 1.5)] [2.25 -0.5] [3.75 2.5]]]\n440\t   [:duplicate-subtrees\n441\t    [[:a (list 'first 'xs)] [:b (list 'first 'xs)] [:c (list 'first 'xs)]]]])\n442\t\n443\t\n444\t(def ^:private map-corpus-sizes\n445\t  \"Sizes crossing the array-map/hash-map representation thresholds; each\n446\t   gets the full recorded permutation set under both representations.\"\n447\t  [8 9 16 32])\n448\t\n449\t\n450\t(deftest map-permutation-invariance-test\n451\t  (testing \"sizes 0-4: every insertion permutation, both representations\"\n452\t    (doseq [n (range 5)\n453\t            :let [entries (sized-map-entries n)]]\n454\t      (testing (str \"size \" n)\n455\t        (let [variants (into []\n456\t                             (mapcat (fn [p]\n457\t                                       (for [rep [:array-map :hash-map]]\n458\t                                         (build-map rep (permute entries p)))))\n459\t                             (all-permutations n))\n460\t              snaps (mapv compile-snapshot variants)]\n461\t          (is (pos? (count variants)))\n462\t          (is (apply = snaps)\n463\t              (str n \"-entry permutations diverge: \"\n464\t                   (pr-str (distinct snaps))))\n465\t          (when (pos? n)\n466\t            (doseq [form variants\n467\t                    :let [ctors (map-constructors (yang/compile form))]]\n468\t              (is (= 1 (count ctors)))\n469\t              (is (every? #(strictly-ascending? (pair-keys %)) ctors))))))))\n470\t  (testing \"recorded corpus: permutations of the recorded entries\"\n471\t    (doseq [[label entries] map-corpus]\n472\t      (testing (str label)\n473\t        (let [variants (into []\n474\t                             (mapcat (fn [p]\n475\t                                       (for [rep [:array-map :hash-map]]\n476\t                                         (build-map rep (permute entries p)))))\n477\t                             (all-permutations (count entries)))\n478\t              snaps (mapv compile-snapshot variants)]\n479\t          (is (apply = snaps))\n480\t          (doseq [form variants\n481\t                  :let [ctors (map-constructors (yang/compile form))]]\n482\t            (is (every? #(strictly-ascending? (pair-keys %)) ctors)))))))\n483\t  (testing \"sizes 8/9/16/32: recorded permutations cross the thresholds\"\n484\t    (doseq [n map-corpus-sizes\n485\t            :let [entries (sized-map-entries n)]]\n486\t      (testing (str \"size \" n)\n487\t        (let [variants (into []\n488\t                             (mapcat (fn [p]\n489\t                                       (for [rep [:array-map :hash-map]]\n490\t                                         (build-map rep (permute entries p)))))\n491\t                             (recorded-permutations n 1795017757000))\n492\t              snaps (mapv compile-snapshot variants)]\n493\t          (is (apply = snaps))\n494\t          (doseq [form variants\n495\t                  :let [ctors (map-constructors (yang/compile form))]]\n496\t            (is (every? #(strictly-ascending? (pair-keys %)) ctors)))))))\n497\t  (