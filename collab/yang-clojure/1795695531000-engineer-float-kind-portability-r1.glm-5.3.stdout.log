{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bee56e5cf99b46d9a271b64d","type":"tool_result","content":"1\t(ns yin.repl.frontends\n2\t  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n3\t   8.5.6, slice F2): the hand-written Clojure frontend and the ANTLR PHP and\n4\t   Python frontends installed into a `yang.frontend` catalog. This is\n5\t   the only place the REPL composition names a language's namespace;\n6\t   `yin.repl` core steps whatever binding the catalog selects.\n7\t\n8\t   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n9\t   `:input :forms` when the frontend consumes the forms the shell reader\n10\t   already read, else the source text.\"\n11\t  (:require\n12\t    [yang.clojure :as yang.clojure]\n13\t    [yang.frontend :as frontend]\n14\t    #?@(:cljd []\n15\t        :jolt []\n16\t        :default [[yang.php.antlr.cst :as php.antlr.cst]\n17\t                  [yang.php.antlr.lower :as php.antlr.lower]])\n18\t    [yang.clojure.prelude :as clj-runtime]\n19\t    [yang.python.antlr.contract :as python.contract]\n20\t    [yang.python.antlr.profiles :as python.profiles]\n21\t    [yang.python.antlr.repl :as python.repl]\n22\t    [yang.python.antlr.parser :as python.parser]\n23\t    [yang.python.antlr.repl-probe :as python.probe]\n24\t    [yin.repl :as repl]))\n25\t\n26\t\n27\t(defn- manifest\n28\t  [id language]\n29\t  {:yang.frontend/id id,\n30\t   :yang.frontend/spi 1,\n31\t   :yang.frontend/revision \"legacy-1\",\n32\t   :yang.frontend/language language,\n33\t   :yang.frontend/grammar {:yang.grammar/package \"none\",\n34\t                           :yang.grammar/entries {:module \"program\"},\n35\t                           :yang.grammar/export-profile :yang.cst/v1},\n36\t   :yang.frontend/options-schema :segment/none,\n37\t   :yang.frontend/lowering-profile :segment/legacy,\n38\t   :yang.frontend/runtime-profile :segment/legacy,\n39\t   :yang.frontend/support-profile :segment/legacy})\n40\t\n41\t\n42\t(defn clojure-manifest\n43\t  \"The Clojure frontend's manifest. Its coverage promise changed under\n44\t   the call-site occurrence contract C1 — every final `:application`\n45\t   occurrence carries `:yang/call-site` in the frontend-metadata side\n46\t   table, finalized over the post-expansion tree that executes and\n47\t   retained beside a published module's manifest — and that promise is\n48\t   a support claim, so the revision and the support profile name it.\n49\t   Revision c1-2 additionally declares the constructed-collections\n50\t   lowering profile: a dynamically constructed map or set literal now\n51\t   orders its constructor operands by compiled content\n52\t   (:yang.clojure/constructed-collections-v1), a one-time canonical\n53\t   shift for affected newly compiled artifacts; the C1 support claim,\n54\t   the C1 marker value and the execution grammar versions are\n55\t   unchanged.\"\n56\t  []\n57\t  (assoc (manifest :yang/clojure :clojure)\n58\t         :yang.frontend/revision \"c1-2\"\n59\t         :yang.frontend/lowering-profile :yang.clojure/constructed-collections-v1\n60\t         :yang.frontend/support-profile :yang.clojure/c1))\n61\t\n62\t\n63\t(defn- clojure-lower\n64\t  [forms]\n65\t  (if (= 1 (count forms))\n66\t    (yang.clojure/compile (first forms))\n67\t    (yang.clojure/compile-program forms)))\n68\t\n69\t\n70\t(defn- antlr-manifest\n71\t  [id {:keys [descriptor-address runtime-address]}]\n72\t  (assoc (manifest :yang/python :python)\n73\t         :yang.frontend/revision (name id)\n74\t         :yang.frontend/lowering-profile descriptor-address\n75\t         :yang.frontend/runtime-profile runtime-address\n76\t         :yang.frontend/support-profile descriptor-address\n77\t         :yang.frontend/grammar\n78\t         {:yang.grammar/package \"python3\",\n79\t          :yang.grammar/entries {:module \"file_input\"},\n80\t          :yang.grammar/export-profile :yang.cst/v1,\n81\t          :yang.grammar/targets #{:java :javascript :dart}}))\n82\t\n83\t\n84\t(defn php-manifest\n85\t  []\n86\t  (assoc (manifest :yang/php :php)\n87\t         :yang.frontend/revision \"antlr-p8\"\n88\t         :yang.frontend/grammar\n89\t         {:yang.grammar/package \"php\",\n90\t          :yang.grammar/entries {:module \"htmlDocument\"},\n91\t          :yang.grammar/export-profile :yang.cst/v1,\n92\t          :yang.grammar/targets #{:java :javascript}}\n93\t         :yang.frontend/lowering-profile :yang.php/antlr\n94\t         :yang.frontend/runtime-profile :yang.php/antlr\n95\t         :yang.frontend/support-profile :yang.php/antlr))\n96\t\n97\t\n98\t(defn- parse-python [source]\n99\t  #?(:jolt\n100\t     (try (python.parser/parse-source (str source \"\\n\"))\n101\t          (catch Exception e\n102\t            (if (#{:parser-budget :unavailable-parser} (:diagnostic (ex-data e)))\n103\t              (throw (ex-info (ex-message e) (assoc (ex-data e) :lang :yang/python) e))\n104\t              (throw e))))\n105\t     :default (python.parser/parse-source (str source \"\\n\"))))\n106\t\n107\t\n108\t(defn- install-python [catalog id]\n109\t  (let [profile (python.profiles/builtin id)\n110\t        manifest (antlr-manifest id profile)\n111\t        legacy? (= id python.contract/legacy-id)\n112\t        lower (if legacy? python.repl/lower-session python.repl/lower-clojure-session)\n113\t        lower-session (fn [packet session]\n114\t                        (python.profiles/verify-builtin! id)\n115\t                        (lower packet session (:descriptor profile)))]\n116\t    (frontend/install catalog manifest\n117\t      (cond-> {:parse (fn [source]\n118\t                         (python.profiles/verify-builtin! id)\n119\t                         (parse-python source))\n120\t               :lower (fn [packet] (first (lower-session packet nil)))\n121\t               :lower-session lower-session\n122\t               :derive (fn [packet ast] (python.profiles/derivation manifest profile packet ast))\n123\t               :probe (fn [source]\n124\t                        (python.profiles/verify-builtin! id)\n125\t                        (python.probe/probe source))\n126\t               :render (if legacy? python.repl/display-value python.repl/display-clojure-value)}\n127\t        legacy? (assoc :primitives python.repl/primitives)\n128\t        (not legacy?) (assoc :admit clj-runtime/admit)))))\n129\t\n130\t\n131\t(defn standard\n132\t  \"The standard immutable frontend catalog and the preferred Python revision.\"\n133\t  []\n134\t  (let [catalog (cond-> frontend/empty-catalog\n135\t                  true (frontend/install (clojure-manifest)\n136\t                                         {:input :forms :parse identity :lower clojure-lower})\n137\t                  #?@(:cljd []\n138\t                      :jolt []\n139\t                      :default [true (frontend/install\n140\t                                       (php-manifest)\n141\t                                       {:parse php.antlr.cst/parse-source\n142\t                                        :lower php.antlr.lower/lower-packet\n143\t                                        :render :php/out})]))]\n144\t    (if #?(:jolt (python.parser/available?) :default true)\n145\t      (-> catalog\n146\t          (install-python python.contract/legacy-id)\n147\t          (install-python python.contract/clojure-id)\n148\t          (assoc :yang.frontend/preferred [:yang/python \"clojure-core-v1\"]))\n149\t      catalog)))\n150\t\n151\t(defn create-state\n152\t  \"`yin.repl/create-state` composed with the standard catalog unless the\n153\t   host supplies its own `:frontends`.  Each binding registers its own\n154\t   `:primitives`; none is merged ambiently.\"\n155\t  ([] (create-state {}))\n156\t  ([opts]\n157\t   (repl/create-state (update opts :frontends #(or % (standard))))))\n158\t"}]},"parent_tool_use_id":null,"session_id":"519cc353-4ebf-4ee9-a727-f6a51287dd1a","uuid":"a194f285-7f0d-49f7-be33-436cad1e9965","timestamp":"2026-11-26T12:21:03.658Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-floatkind/src/cljc/yin/repl/frontends.cljc","content":"(ns yin.repl.frontends\n  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n   8.5.6, slice F2): the hand-written Clojure frontend and the ANTLR PHP and\n   Python frontends installed into a `yang.frontend` catalog. This is\n   the only place the REPL composition names a language's namespace;\n   `yin.repl` core steps whatever binding the catalog selects.\n\n   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n   `:input :forms` when the frontend consumes the forms the shell reader\n   already read, else the source text.\"\n  (:require\n    [yang.clojure :as yang.clojure]\n    [yang.frontend :as frontend]\n    #?@(:cljd []\n        :jolt []\n        :default [[yang.php.antlr.cst :as php.antlr.cst]\n                  [yang.php.antlr.lower :as php.antlr.lower]])\n    [yang.clojure.prelude :as clj-runtime]\n    [yang.python.antlr.contract :as python.contract]\n    [yang.python.antlr.profiles :as python.profiles]\n    [yang.python.antlr.repl :as python.repl]\n    [yang.python.antlr.parser :as python.parser]\n    [yang.python.antlr.repl-probe :as python.probe]\n    [yin.repl :as repl]))\n\n\n(defn- manifest\n  [id language]\n  {:yang.frontend/id id,\n   :yang.frontend/spi 1,\n   :yang.frontend/revision \"legacy-1\",\n   :yang.frontend/language language,\n   :yang.frontend/grammar {:yang.grammar/package \"none\",\n                           :yang.grammar/entries {:module \"program\"},\n                           :yang.grammar/export-profile :yang.cst/v1},\n   :yang.frontend/options-schema :segment/none,\n   :yang.frontend/lowering-profile :segment/legacy,\n   :yang.frontend/runtime-profile :segment/legacy,\n   :yang.frontend/support-profile :segment/legacy})\n\n\n(defn clojure-manifest\n  \"The Clojure frontend's manifest. Its coverage promise changed under\n   the call-site occurrence contract C1 — every final `:application`\n   occurrence carries `:yang/call-site` in the frontend-metadata side\n   table, finalized over the post-expansion tree that executes and\n   retained beside a published module's manifest — and that promise is\n   a support claim, so the revision and the support profile name it.\n   Revision c1-2 additionally declares the constructed-collections\n   lowering profile: a dynamically constructed map or set literal now\n   orders its constructor operands by compiled content\n   (:yang.clojure/constructed-collections-v1), a one-time canonical\n   shift for affected newly compiled artifacts; the C1 support claim,\n   the C1 marker value and the execution grammar versions are\n   unchanged.\"\n  []\n  (assoc (manifest :yang/clojure :clojure)\n         :yang.frontend/revision \"c1-2\"\n         :yang.frontend/lowering-profile :yang.clojure/constructed-collections-v1\n         :yang.frontend/support-profile :yang.clojure/c1))\n\n\n(defn- clojure-lower\n  [forms]\n  (if (= 1 (count forms))\n    (yang.clojure/compile (first forms))\n    (yang.clojure/compile-program forms)))\n\n\n(defn- antlr-manifest\n  [id {:keys [descriptor-address runtime-address]}]\n  (assoc (manifest :yang/python :python)\n         :yang.frontend/revision (name id)\n         :yang.frontend/lowering-profile descriptor-address\n         :yang.frontend/runtime-profile runtime-address\n         :yang.frontend/support-profile descriptor-address\n         :yang.frontend/grammar\n         {:yang.grammar/package \"python3\",\n          :yang.grammar/entries {:module \"file_input\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript :dart}}))\n\n\n(defn php-manifest\n  []\n  (assoc (manifest :yang/php :php)\n         :yang.frontend/revision \"antlr-p8\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"php\",\n          :yang.grammar/entries {:module \"htmlDocument\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript}}\n         :yang.frontend/lowering-profile :yang.php/antlr\n         :yang.frontend/runtime-profile :yang.php/antlr\n         :yang.frontend/support-profile :yang.php/antlr))\n\n\n(defn- parse-python [source]\n  #?(:jolt\n     (try (python.parser/parse-source (str source \"\\n\"))\n          (catch Exception e\n            (if (#{:parser-budget :unavailable-parser} (:diagnostic (ex-data e)))\n              (throw (ex-info (ex-message e) (assoc (ex-data e) :lang :yang/python) e))\n              (throw e))))\n     :default (python.parser/parse-source (str source \"\\n\"))))\n\n\n(defn- install-python [catalog id]\n  (let [profile (python.profiles/builtin id)\n        manifest (antlr-manifest id profile)\n        legacy? (= id python.contract/legacy-id)\n        lower (if legacy? python.repl/lower-session python.repl/lower-clojure-session)\n        lower-session (fn [packet session]\n                        (python.profiles/verify-builtin! id)\n                        (lower packet session (:descriptor profile)))]\n    (frontend/install catalog manifest\n      (cond-> {:parse (fn [source]\n                         (python.profiles/verify-builtin! id)\n                         (parse-python source))\n               :lower (fn [packet] (first (lower-session packet nil)))\n               :lower-session lower-session\n               :derive (fn [packet ast] (python.profiles/derivation manifest profile packet ast))\n               :probe (fn [source]\n                        (python.profiles/verify-builtin! id)\n                        (python.probe/probe source))\n               :render (if legacy? python.repl/display-value python.repl/display-clojure-value)}\n        legacy? (assoc :primitives python.repl/primitives)\n        (not legacy?) (assoc :admit clj-runtime/admit)))))\n\n\n(defn standard\n  \"The standard immutable frontend catalog and the preferred Python revision.\"\n  []\n  (let [catalog (cond-> frontend/empty-catalog\n                  true (frontend/install (clojure-manifest)\n                                         {:input :forms :parse identity :lower clojure-lower})\n                  #?@(:cljd []\n                      :jolt []\n                      :default [true (frontend/install\n                                       (php-manifest)\n                                       {:parse php.antlr.cst/parse-source\n                                        :lower php.antlr.lower/lower-packet\n                                        :render :php/out})]))]\n    (if #?(:jolt (python.parser/available?) :default true)\n      (-> catalog\n          (install-python python.contract/legacy-id)\n          (install-python python.contract/clojure-id)\n          (assoc :yang.frontend/preferred [:yang/python \"clojure-core-v1\"]))\n      catalog)))\n\n(defn create-state\n  \"`yin.repl/create-state` composed with the standard catalog unless the\n   host supplies its own `:frontends`.  Each binding registers its own\n   `:primitives`; none is merged ambiently.\"\n  ([] (create-state {}))\n  ([opts]\n   (repl/create-state (update opts :frontends #(or % (standard))))))\n","numLines":158,"startLine":1,"totalLines":158}},"tool_result_meta":[{"id":"call_bee56e5cf99b46d9a271b64d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
