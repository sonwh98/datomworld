in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n                                 ;; oracle backend: Datomic Local, in-process,\n                                 ;; run in docker/oracle (dev-scope only)\n                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.shell.main\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yin.repl.python-antlr-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:clojuredart:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call_b18b6ecf553f4ce1b104f926","permission_de