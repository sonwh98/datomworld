uarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:antlr]\n                :task (shell \"clojure -M:test\")}\n\n  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [check:node-discovery build:yin-repl-node]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-peer]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"bb src/dev/cljd_agg.clj\")}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"call_a5c2f2cc774a4a168bd2c252","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
