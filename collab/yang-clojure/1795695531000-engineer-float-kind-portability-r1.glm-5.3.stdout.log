{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_521ae42bf7934c7492e408e2","type":"tool_result","content":"245\t                       (str \"(let [c (stream/cursor s)]\"\n246\t                            \" (stream/next! c) (stream/next! c))\")])\n247\t            [_ _ _ refused next-round _ drained past-end] results]\n248\t        (is (error? refused) \"put! on a closed stream is an error\")\n249\t        (is (str/includes? refused \"Stream append failed\"))\n250\t        (is (= \"3\" next-round) \"the failed round is consumed, not replayed\")\n251\t        (is (= \"[1]\" drained) \"the elements before the close remain\")\n252\t        (is (= \"nil\" past-end) \"reading past a closed stream's end is nil\")\n253\t        (is (true? (:running? state)))))))\n254\t\n255\t\n256\t(deftest a-read-on-an-empty-stream-parks-and-the-round-is-consumed\n257\t  (doseq [vm-type vm-types]\n258\t    (testing (str vm-type)\n259\t      (let [[state results]\n260\t            (evaluate (session vm-type)\n261\t                      [\"(def e (stream/make 2))\"\n262\t                       \"(stream/next! (stream/cursor e))\"\n263\t                       \"(+ 1 2)\"\n264\t                       \"(stream/put! e 5)\"\n265\t                       \"(stream/next! (stream/cursor e))\"])\n266\t            [_ parked next-round put after] results\n267\t            summary (repl/repl-state state)]\n268\t        (is (error? parked)\n269\t            \"a program that blocks on its own stream is not a halted one\")\n270\t        (is (str/includes? parked \"runnable\"))\n271\t        (is (= \"3\" next-round) \"the next input runs on the restored VM\")\n272\t        (is (= [\"5\" \"5\"] [put after])\n273\t            \"the stream outlives the parked round; a later read succeeds\")\n274\t        (is (true? (get-in summary [:vm :halted?])))\n275\t        (is (false? (get-in summary [:vm :blocked?])))))))\n276\t\n277\t\n278\t;; =============================================================================\n279\t;; The shell's own media: program-in, program-out, and output\n280\t;; =============================================================================\n281\t\n282\t(deftest output-and-results-are-emitted-on-the-output-medium\n283\t  (doseq [vm-type vm-types]\n284\t    (testing (str vm-type)\n285\t      (let [output (ring-handle 16)\n286\t            [state results]\n287\t            (evaluate (session vm-type output)\n288\t                      [\"(do (print \\\"a\\\") (println \\\"b\\\") 7)\"\n289\t                       \"(prn :k)\"])\n290\t            token (:shell-token state)]\n291\t        (is (= [\"ab\\n7\" \":k\\nnil\"] results)\n292\t            \"printed text precedes the value in what the shell answers\")\n293\t        (is (= [{:type :repl/output :op :print :text \"a\"}\n294\t                {:type :repl/output :op :println :text \"b\\n\"}\n295\t                {:type :repl/result :round [token 1] :value 7}\n296\t                {:type :repl/output :op :prn :text \":k\\n\"}\n297\t                {:type :repl/result :round [token 2] :value nil}\n298\t                [:end :dao.stream/blocked]]\n299\t               (read-all output))\n300\t            \"every print is an element, and each round ends in its result\")\n301\t        (is (= :dao.stream/blocked (get-in state [:ledger :output]))\n302\t            \"the drain ran to the end of the medium\")))))\n303\t\n304\t\n305\t(deftest programs-are-ingested-as-batches-on-the-program-media\n306\t  (doseq [vm-type vm-types]\n307\t    (testing (str vm-type)\n308\t      (let [[state results]\n309\t            (evaluate (session vm-type)\n310\t                      [\"(+ 1 2)\"\n311\t                       \"(help)\"\n312\t                       \"(let [s (stream/make 2)] (stream/put! s :v))\"\n313\t                       \"(repl-state)\"\n314\t                       \"(stream/put! 1 2)\"])\n315\t            batches (butlast (read-all (:program-stream state)))\n316\t            packets (butlast (read-all (:row-stream state)))]\n317\t        (is (= [\"3\" \":v\"] [(nth results 0) (nth results 2)]))\n318\t        (is (error? (nth results 4)) \"a bad put! fails in the evaluator\")\n319\t        (is (= 3 (count batches))\n320\t            \"one batch per program; a command appends nothing\")\n321\t        (doseq [batch batches]\n322\t          (is (= :yin.program/batch (first batch)))\n323\t          (is (vector? (second batch)) \"the batch carries its rows\"))\n324\t        (is (= 3 (count packets))\n325\t            \"the expander forwards every program, the failing one too\")\n326\t        (doseq [[root rows] packets]\n327\t          (is (some #(= root (first %)) rows)\n328\t              \"a packet's root names one of its own rows\"))\n329\t        (is (zero? (get-in (repl/repl-state state) [:vm :in-stream :gaps]))"}]},"parent_tool_use_id":null,"session_id":"519cc353-4ebf-4ee9-a727-f6a51287dd1a","uuid":"6a81a324-e4ab-49ea-a05f-615fec038970","timestamp":"2026-11-26T12:55:44.571Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-floatkind/test/yang/clojure/stream_eval_test.cljc","content":"                       (str \"(let [c (stream/cursor s)]\"\n                            \" (stream/next! c) (stream/next! c))\")])\n            [_ _ _ refused next-round _ drained past-end] results]\n        (is (error? refused) \"put! on a closed stream is an error\")\n        (is (str/includes? refused \"Stream append failed\"))\n        (is (= \"3\" next-round) \"the failed round is consumed, not replayed\")\n        (is (= \"[1]\" drained) \"the elements before the close remain\")\n        (is (= \"nil\" past-end) \"reading past a closed stream's end is nil\")\n        (is (true? (:running? state)))))))\n\n\n(deftest a-read-on-an-empty-stream-parks-and-the-round-is-consumed\n  (doseq [vm-type vm-types]\n    (testing (str vm-type)\n      (let [[state results]\n            (evaluate (session vm-type)\n                      [\"(def e (stream/make 2))\"\n                       \"(stream/next! (stream/cursor e))\"\n                       \"(+ 1 2)\"\n                       \"(stream/put! e 5)\"\n                       \"(stream/next! (stream/cursor e))\"])\n            [_ parked next-round put after] results\n            summary (repl/repl-state state)]\n        (is (error? parked)\n            \"a program that blocks on its own stream is not a halted one\")\n        (is (str/includes? parked \"runnable\"))\n        (is (= \"3\" next-round) \"the next input runs on the restored VM\")\n        (is (= [\"5\" \"5\"] [put after])\n            \"the stream outlives the parked round; a later read succeeds\")\n        (is (true? (get-in summary [:vm :halted?])))\n        (is (false? (get-in summary [:vm :blocked?])))))))\n\n\n;; =============================================================================\n;; The shell's own media: program-in, program-out, and output\n;; =============================================================================\n\n(deftest output-and-results-are-emitted-on-the-output-medium\n  (doseq [vm-type vm-types]\n    (testing (str vm-type)\n      (let [output (ring-handle 16)\n            [state results]\n            (evaluate (session vm-type output)\n                      [\"(do (print \\\"a\\\") (println \\\"b\\\") 7)\"\n                       \"(prn :k)\"])\n            token (:shell-token state)]\n        (is (= [\"ab\\n7\" \":k\\nnil\"] results)\n            \"printed text precedes the value in what the shell answers\")\n        (is (= [{:type :repl/output :op :print :text \"a\"}\n                {:type :repl/output :op :println :text \"b\\n\"}\n                {:type :repl/result :round [token 1] :value 7}\n                {:type :repl/output :op :prn :text \":k\\n\"}\n                {:type :repl/result :round [token 2] :value nil}\n                [:end :dao.stream/blocked]]\n               (read-all output))\n            \"every print is an element, and each round ends in its result\")\n        (is (= :dao.stream/blocked (get-in state [:ledger :output]))\n            \"the drain ran to the end of the medium\")))))\n\n\n(deftest programs-are-ingested-as-batches-on-the-program-media\n  (doseq [vm-type vm-types]\n    (testing (str vm-type)\n      (let [[state results]\n            (evaluate (session vm-type)\n                      [\"(+ 1 2)\"\n                       \"(help)\"\n                       \"(let [s (stream/make 2)] (stream/put! s :v))\"\n                       \"(repl-state)\"\n                       \"(stream/put! 1 2)\"])\n            batches (butlast (read-all (:program-stream state)))\n            packets (butlast (read-all (:row-stream state)))]\n        (is (= [\"3\" \":v\"] [(nth results 0) (nth results 2)]))\n        (is (error? (nth results 4)) \"a bad put! fails in the evaluator\")\n        (is (= 3 (count batches))\n            \"one batch per program; a command appends nothing\")\n        (doseq [batch batches]\n          (is (= :yin.program/batch (first batch)))\n          (is (vector? (second batch)) \"the batch carries its rows\"))\n        (is (= 3 (count packets))\n            \"the expander forwards every program, the failing one too\")\n        (doseq [[root rows] packets]\n          (is (some #(= root (first %)) rows)\n              \"a packet's root names one of its own rows\"))\n        (is (zero? (get-in (repl/repl-state state) [:vm :in-stream :gaps]))","numLines":85,"startLine":245,"totalLines":446}},"tool_result_meta":[{"id":"call_521ae42bf7934c7492e408e2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
