             (and variadic-from (>= n variadic-from)))\n633\t          (refuse! op :arity {::argc n}))\n634\t        (apply f args)))))\n635\t\n636\t\n637\t(def data-module\n638\t  \"The `data` module's exports, export symbol to host function.\"\n639\t  (into {}\n640\t        (map (fn [[op arities f]] [op (arity-checked op arities f)]))\n641\t        exports))\n642\t\n643\t\n644\t(def data-profiles\n645\t  \"UCF 7.5.2 profiles for the `data` module: every export `:pure`,\n646\t   declaring no effects and no host state.\"\n647\t  (into {}\n648\t        (map (fn [[op arities _]]\n649\t               [op (vm/primitive-profile op :pure arities #{} :none)]))\n650\t        exports))\n651\t\n652\t\n653\t(defn- check-limits!\n654\t  \"Refuse `limits` unless `::max-items` is a positive native integer: the\n655\t   limit has no default.\"\n656\t  [limits]\n657\t  (let [v (get limits ::max-items)]\n658\t    (when-not (and (integer-host/exact-integer? v)\n659\t                   (not (integer-host/big-carrier? v))\n660\t                   (pos? v))\n661\t      (throw (ex-info \"data module needs an explicit max-items\"\n662\t                      {::reason :limits, ::limit ::max-items})))))\n663\t\n664\t\n665\t(defn register-data-module\n666\t  \"Return registry with the `data` module installed. Composition-only:\n667\t   the module is never in `yin.vm/primitives`.\n668\t\n669\t   Under `limits`, the module also exports `max-items`, of no arguments,\n670\t   answering the composition's `::max-items`: the largest item or\n671\t   character count one sequence repetition may produce (a language\n672\t   profile checks it before it builds). `::max-items` must be a positive\n673\t   native integer; there is no default, and without `limits` the export\n674\t   is absent.\"\n675\t  ([registry]\n676\t   (module/register-host-module registry module-name data-module\n677\t                                data-profiles))\n678\t  ([registry limits]\n679\t   (check-limits! limits)\n680\t   (