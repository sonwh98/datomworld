{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0d144179fed84effb70a7dac","type":"tool_result","content":"440\t    (wrong-type! 'float-value 0 :number))\n441\t  #?(:cljd (if (dart/is? x BigInt) (.toDouble ^BigInt x) (.toDouble ^num x))\n442\t     :clj (double x)\n443\t     :cljs (cond (number? x) x\n444\t                 (cbor/float64? x) (.-v ^not-native x)\n445\t                 :else (js/Number x))))\n446\t\n447\t\n448\t(defn float64\n449\t  \"Float content with the value of number `x`: Jing's float64, the form a\n450\t   float keeps in any value that can reach an addressed row or image (a\n451\t   double on the JVM and Dart, the float64 carrier on JS, where a bare\n452\t   integral Number is an integer; dao.jing.cbor.md, Numeric identity). The\n453\t   producer carries float kind; the codec never infers it.\"\n454\t  [x]\n455\t  (cbor/float64 (float-value x)))\n456\t\n457\t\n458\t(defn- callable?\n459\t  \"True when `x` can be applied: a host function, a closure or a\n460\t   continuation. A map is never callable, whatever keys it carries.\"\n461\t  [x]\n462\t  (or (fn? x) (values/closure? x) (values/continuation? x)))\n463\t\n464\t\n465\t(defn- data-map?\n466\t  [x]\n467\t  (map? x))\n468\t\n469\t\n470\t(defn- data-vector?\n471\t  [x]\n472\t  (vector? x))\n473\t\n474\t\n475\t(defn- data-string?\n476\t  [x]\n477\t  (string? x))\n478\t\n479\t\n480\t(defn- ref?\n481\t  \"True when `x` is a stream, cursor or cell reference.\"\n482\t  [x]\n483\t  (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x))))\n484\t\n485\t\n486\t(defn- data-content=\n487\t  \"True when `a` and `b` have one identity under content addressing:\n488\t   Jing's kind-strict content equality, so every NaN is one value, 0.0 is\n489\t   not -0.0, 1 is not 1.0, and collections recurse. A callable or a\n490\t   reference compares by host `=`, so content addressing never walks it.\"\n491\t  [a b]\n492\t  (or (identical? a b)\n493\t      (if (or (callable? a) (callable? b) (ref? a) (ref? b))\n494\t        (= a b)\n495\t        (cbor/content= a b))))\n496\t\n497\t\n498\t(defn- identifier-equal? [a b]\n499\t  (and (= (namespace a) (namespace b)) (= (name a) (name b))))\n500\t\n501\t(declare data-equiv)\n502\t\n503\t(defn- matching? [xs ys match?]\n504\t  (and (= (count xs) (count ys))\n505\t       (loop [xs (seq xs), ys (vec ys)]\n506\t         (if-not xs\n507\t           true\n508\t           (if-let [i (first (keep-indexed #(when (match? (first xs) %2) %1) ys))]\n509\t             (recur (next xs) (into (subvec ys 0 i) (subvec ys (inc i))))\n510\t             false)))))\n511\t\n512\t(defn- data-equiv [a b]\n513\t  (cond\n514\t    (or (ref? a) (ref? b) (callable? a) (callable? b)) (= a b)\n515\t    (or (cbor/float64? a) (cbor/float64? b))\n516\t    (and (cbor/float64? a) (cbor/float64? b)\n517\t         (let [x (float-value a), y (float-value b)]\n518\t           (and (not (integer-host/nan-float? x))\n519\t                (not (integer-host/nan-float? y)) (== x y))))\n520\t    (or (integer-host/exact-integer? a) (integer-host/exact-integer? b))\n521\t    (and (integer-host/exact-integer? a) (integer-host/exact-integer? b)\n522\t         (zero? (integer-host/compare-big (integer-host/promote a) (integer-host/promote b))))\n523\t    (or (keyword? a) (keyword? b))\n524\t    (and (keyword? a) (keyword? b) (identifier-equal? a b))\n525\t    (or (symbol? a) (symbol? b))\n526\t    (and (symbol? a) (symbol? b) (identifier-equal? a b))\n527\t    (or (sequential? a) (sequential? b))\n528\t    (and (sequential? a) (sequential? b) (= (count a) (count b))\n529\t         (every? true? (map data-equiv a b)))\n530\t    (or (map? a) (map? b))\n531\t    (and (map? a) (map? b)\n532\t         (matching? a b (fn [[ka va] [kb vb]]\n533\t                          (and (data-equiv ka kb) (data-equiv va vb)))))\n534\t    (or (set? a) (set? b))\n535\t    (and (set? a) (set? b) (matching? a b data-equiv))\n536\t    :else (= a b)))\n537\t\n538\t(defn- admit-key? [x]\n539\t  (cond\n540\t    (or (ref? x) (callable? x) (cbor/float64? x)) false\n541\t    (or (nil? x) (boolean? x) (string? x) (integer-host/exact-integer? x)) true\n542\t    (or (keyword? x) (symbol? x))\n543\t    (let [n (name x), ns (namespace x)]\n544\t      (and (not (str/includes? n \"/\")) (not (str/starts-with? n \":\"))\n545\t           (or (nil? ns) (and (not (empty? ns)) (not (str/includes? ns \"/\"))))))\n546\t    (vector? x) (every? admit-key? x)\n547\t    (map? x) (every? (fn [[k v]] (and (admit-key? k) (admit-key? v))) x)\n548\t    (set? x) (every? admit-key? x)\n549\t    :else false))\n550\t\n551\t(defn- normalize-key\n552\t  \"Canonicalize integer carriers throughout an admitted key. Apply at both\n553\t   insertion and lookup; other key equality remains host equality.\"\n554\t  [x]\n555\t  (when-not (admit-key? x)\n556\t    (wrong-type! 'normalize-key 0 :admitted-key))\n557\t  (key/normalize x))\n558\t\n559\t\n560\t(defn- canonical-compare [a b]\n561\t  (let [a (cbor/encode a), b (cbor/encode b), n (min (bytes/length a) (bytes/length b))]\n562\t    (loop [i 0]\n563\t      (if (= i n)\n564\t        (compare (bytes/length a) (bytes/length b))\n565\t        (let [c (compare (bytes/get a i) (bytes/get b i))]\n566\t          (if (zero? c) (recur (inc i)) c))))))\n567\t\n568\t(defn- canonical-entries [coll]\n569\t  (cond\n570\t    (map? coll) (vec (sort (fn [[a _] [b _]] (canonical-compare a b)) coll))\n571\t    (set? coll) (vec (sort canonical-compare coll))\n572\t    :else (wrong-type! 'canonical-entries 0 :map-or-set)))\n573\t\n574\t\n575\t;; =============================================================================\n576\t;; The module\n577\t;; =============================================================================\n578\t\n579\t(def ^:private exports\n580\t  \"`[name arities f]` of every export. `:variadic` means the greatest\n581\t   listed fixed arity extends to further arguments.\"\n582\t  [['count [1] data-count]\n583\t   [