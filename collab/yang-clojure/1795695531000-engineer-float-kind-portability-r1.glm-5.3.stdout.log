{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9769c88ac054468ca0439d59","type":"tool_result","content":"860\t\n861\t\n862\t(def ^:private adapter-variadic-cap\n863\t  \"How far an adapter extends a `:variadic` profile arity: an adapter is a\n864\t   finite dispatch, so an open-ended arity needs a stated bound.\"\n865\t  8)\n866\t\n867\t\n868\t(defn- core-source-name [env sym]\n869\t  (when (and (::outcomes env)\n870\t             (symbol? sym)\n871\t             (not (contains? (locals env) sym))\n872\t             (not (contains? (::defined env) sym)))\n873\t    (let [name (case (namespace sym)\n874\t                 nil sym\n875\t                 \"clojure.core\" (symbol (name sym))\n876\t                 nil)]\n877\t      (when (contains? core-module/source-names name)\n878\t        name))))\n879\t\n880\t\n881\t(defn- native-name?\n882\t  \"True when `sym` statically names a primitive or host-module export.\"\n883\t  [env sym]\n884\t  (when-let [conv (::convention env)]\n885\t    (and (symbol? sym)\n886\t         (not (contains? (locals env) sym))\n887\t         (not (contains? (::defined env) sym))\n888\t         (not (core-source-name env sym))\n889\t         (or (some? (namespace sym))\n890\t             (contains? (:native conv) sym)))))\n891\t\n892\t\n893\t(defn- macro-call?\n894\t  [env macro-env sym]\n895\t  (and (symbol? sym)\n896\t       (not (contains? (locals env) sym))\n897\t       (or (contains? macro-env sym)\n898\t           (contains? (:macros (::convention env)) sym))))\n899\t\n900\t\n901\t;; =============================================================================\n902\t;; The continuation lane (slice 5, ported off the outcome model)\n903\t;; =============================================================================\n904\t;;\n905\t;; Opted in with `:outcomes true` beside the argument-vector convention (the\n906\t;; flag now selects the continuation lane, not the retired outcome tuples).\n907\t;; Guest functions return plain values; `throw` lowers to `clj/throw`, `try`\n908\t;; to `clj/try`/`clj/try-finally` (the `%capture` handler-stack family), and a\n909\t;; guest call delivers an escaping condition through the §8.10.7 raise exit.\n910\t;; The public entry installs the same bridge before argument binding. Only the\n911\t;; `compile-program` boundary still wraps the program in `[:yin.k/ok value]` /\n912\t;; `[:yin.k/error raised]` for the harness. `ex-info` becomes a portable map\n913\t;; under namespaced keys, `ex-message`/`ex-data` its accessors. Generated names\n914\t;; carry the reserved `dsg__` prefix; the program pre-pass keeps user code out\n915\t;; of that prefix. A macro call is opaque to the pass: the expander owns it.\n916\t\n917\t(defn- outcomes?\n918\t  [env]\n919\t  (some? (::outcomes env)))\n920\t\n921\t\n922\t(defn- rebuild\n923\t  \"A list of `items` carrying the reader metadata of `form`.\"\n924\t  [form items]\n925\t  (let [out (apply list items)]\n926\t    (if-let [m (meta form)]\n927\t      (with-meta out m)\n928\t      out)))\n929\t\n930\t\n931\t(def ^:private ex-message-form\n932\t  '(fn [value] (clj/prim-get (clj/condition-view value) :yin.k/message)))\n933\t\n934\t\n935\t(def ^:private ex-data-form\n936\t  '(fn [value] (clj/prim-get (clj/condition-view value) :yin.k/data)))\n937\t\n938\t\n939\t(def continuation-family-names prelude/bundled-names)\n940\t\n941\t\n942\t(defn- rewrite-ex-info\n943\t  \"(ex-info msg data cause?) as the portable map holding its parts. The\n944\t   accessors read through the generated exception wrapper: a retained\n945\t   condition's wrapper carries the original payload privately, so\n946\t   (ex-message e)/(ex-data e) answer the payload's parts while a plain\n947\t   value still answers by keyword lookup.\"\n948\t  [form]\n949\t  (cond\n950\t    (seq? form)\n951\t    (cond\n952\t      (empty? form) form\n953\t      (= 'quote (first form)) form\n954\t      (#{'.getMessage 'ex-message 'ex-data} (first form))\n955\t      (do (when-not (= 2 (count form))\n956\t            (reject! \"Error accessor requires one portable error value\" {:form form}))\n957\t          (list (if (= 'ex-data (first form)) 'dsg__ex_data 'dsg__ex_message)\n958\t                (rewrite-ex-info (second form))))\n959\t      (and (symbol? (first form)) (= \\. (first (name (first form)))))\n960\t      (reject! \"Host exception/interop accessor is not portable\" {:form form})\n961\t      (= 'ex-info (first form))\n962\t      (let [[_ msg data cause] (map rewrite-ex-info form)]\n963\t        (cond-> {:yin.k/message msg, :yin.k/data data}\n964\t          (< 3 (count form)) (assoc :yin.k/cause cause)))\n965\t      :else (rebuild form (map rewrite-ex-info form)))\n966\t    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\n967\t    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\n968\t    (set? form) (into #{} (map rewrite-ex-info) form)\n969\t    :else form))"}]},"parent_tool_use_id":null,"session_id":"519cc353-4ebf-4ee9-a727-f6a51287dd1a","uuid":"2053af20-f947-47e2-bac0-71243d0dcb52","timestamp":"2026-11-26T12:27:38.281Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-floatkind/src/cljc/yang/clojure.cljc","content":"\n\n(def ^:private adapter-variadic-cap\n  \"How far an adapter extends a `:variadic` profile arity: an adapter is a\n   finite dispatch, so an open-ended arity needs a stated bound.\"\n  8)\n\n\n(defn- core-source-name [env sym]\n  (when (and (::outcomes env)\n             (symbol? sym)\n             (not (contains? (locals env) sym))\n             (not (contains? (::defined env) sym)))\n    (let [name (case (namespace sym)\n                 nil sym\n                 \"clojure.core\" (symbol (name sym))\n                 nil)]\n      (when (contains? core-module/source-names name)\n        name))))\n\n\n(defn- native-name?\n  \"True when `sym` statically names a primitive or host-module export.\"\n  [env sym]\n  (when-let [conv (::convention env)]\n    (and (symbol? sym)\n         (not (contains? (locals env) sym))\n         (not (contains? (::defined env) sym))\n         (not (core-source-name env sym))\n         (or (some? (namespace sym))\n             (contains? (:native conv) sym)))))\n\n\n(defn- macro-call?\n  [env macro-env sym]\n  (and (symbol? sym)\n       (not (contains? (locals env) sym))\n       (or (contains? macro-env sym)\n           (contains? (:macros (::convention env)) sym))))\n\n\n;; =============================================================================\n;; The continuation lane (slice 5, ported off the outcome model)\n;; =============================================================================\n;;\n;; Opted in with `:outcomes true` beside the argument-vector convention (the\n;; flag now selects the continuation lane, not the retired outcome tuples).\n;; Guest functions return plain values; `throw` lowers to `clj/throw`, `try`\n;; to `clj/try`/`clj/try-finally` (the `%capture` handler-stack family), and a\n;; guest call delivers an escaping condition through the §8.10.7 raise exit.\n;; The public entry installs the same bridge before argument binding. Only the\n;; `compile-program` boundary still wraps the program in `[:yin.k/ok value]` /\n;; `[:yin.k/error raised]` for the harness. `ex-info` becomes a portable map\n;; under namespaced keys, `ex-message`/`ex-data` its accessors. Generated names\n;; carry the reserved `dsg__` prefix; the program pre-pass keeps user code out\n;; of that prefix. A macro call is opaque to the pass: the expander owns it.\n\n(defn- outcomes?\n  [env]\n  (some? (::outcomes env)))\n\n\n(defn- rebuild\n  \"A list of `items` carrying the reader metadata of `form`.\"\n  [form items]\n  (let [out (apply list items)]\n    (if-let [m (meta form)]\n      (with-meta out m)\n      out)))\n\n\n(def ^:private ex-message-form\n  '(fn [value] (clj/prim-get (clj/condition-view value) :yin.k/message)))\n\n\n(def ^:private ex-data-form\n  '(fn [value] (clj/prim-get (clj/condition-view value) :yin.k/data)))\n\n\n(def continuation-family-names prelude/bundled-names)\n\n\n(defn- rewrite-ex-info\n  \"(ex-info msg data cause?) as the portable map holding its parts. The\n   accessors read through the generated exception wrapper: a retained\n   condition's wrapper carries the original payload privately, so\n   (ex-message e)/(ex-data e) answer the payload's parts while a plain\n   value still answers by keyword lookup.\"\n  [form]\n  (cond\n    (seq? form)\n    (cond\n      (empty? form) form\n      (= 'quote (first form)) form\n      (#{'.getMessage 'ex-message 'ex-data} (first form))\n      (do (when-not (= 2 (count form))\n            (reject! \"Error accessor requires one portable error value\" {:form form}))\n          (list (if (= 'ex-data (first form)) 'dsg__ex_data 'dsg__ex_message)\n                (rewrite-ex-info (second form))))\n      (and (symbol? (first form)) (= \\. (first (name (first form)))))\n      (reject! \"Host exception/interop accessor is not portable\" {:form form})\n      (= 'ex-info (first form))\n      (let [[_ msg data cause] (map rewrite-ex-info form)]\n        (cond-> {:yin.k/message msg, :yin.k/data data}\n          (< 3 (count form)) (assoc :yin.k/cause cause)))\n      :else (rebuild form (map rewrite-ex-info form)))\n    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\n    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\n    (set? form) (into #{} (map rewrite-ex-info) form)\n    :else form))","numLines":110,"startLine":860,"totalLines":2253}},"tool_result_meta":[{"id":"call_9769c88ac054468ca0439d59","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
