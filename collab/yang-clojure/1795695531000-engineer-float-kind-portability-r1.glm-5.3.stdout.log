{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2ff7bb9770dc46c998ac3360","type":"tool_result","content":"1352\t  \"test/resources/yang/clojure/constructed-collections-legacy-c1-1.cbor\")\n1353\t\n1354\t\n1355\t(defn- read-fixture-bytes\n1356\t  \"The fixture file's bytes on the host (the yin.repl.store-test raw\n1357\t   content-log pattern: nio on the JVM, fs on Node, dart-io on Dart).\"\n1358\t  [path]\n1359\t  #?(:cljd (.readAsBytesSync (dart-io/File. path))\n1360\t     :clj (java.nio.file.Files/readAllBytes\n1361\t            (.toPath (java.io.File. path)))\n1362\t     :cljs (.readFileSync (js/require \"fs\") path)))\n1363\t\n1364\t\n1365\t(deftest legacy-fixture-custody-test\n1366\t  \"B2 custody: the retained binary artifact at the fixture path and the\n1367\t   portable base64 copy embedded in this file are provably ONE artifact --\n1368\t   their bytes are equal on every host -- and the file's payload decodes,\n1369\t   carries the recorded c1-1 root, and runs to the recorded old value\n1370\t   without recompilation.\"\n1371\t  (let [embedded (base64/decode legacy-c1-1-payload-b64)\n1372\t        from-file (read-fixture-bytes legacy-fixture-path)]\n1373\t    (is (= (bytes/length embedded) (bytes/length from-file) 5403)\n1374\t        (str \"both custody copies are 5,403 bytes; file has \"\n1375\t             (bytes/length from-file)))\n1376\t    (is (bytes/equal? embedded from-file)\n1377\t        \"the fixture file's bytes EQUAL the decoded embedded copy\")\n1378\t    (let [payload (cbor/decode from-file)]\n1379\t      (is (= \"c1-1\" (:manifest-revision payload)))\n1380\t      (is (= (:root payload)\n1381\t             (get-in payload [:rows (:root payload) 0])))\n1382\t      (is (= {0 :b} (:old-value payload)))\n1383\t      (let [vm (ast-walker/vm-load-rows (tu/create-vm base-opts)\n1384\t                                        (select-keys payload [:root :rows])\n1385\t                                        vm/ast-contract)]\n1386\t        (is (= (:old-value payload) (vm/value (vm/run vm)))\n1387\t            \"the file-loaded artifact executes to its old value\")))))\n1388\t\n1389\t\n1390\t(deftest legacy-artifact-loads-and-runs-test\n1391\t  \"RULING 4: a retained pre-fix artifact loads at its old address and\n1392\t   executes without recompilation, keeping its old operand order and old\n1393\t   behavior; the same source freshly compiled under c1-2 canonicalizes.\"\n1394\t  (let [payload (legacy-payload)\n1395\t        rows (select-keys payload [:root :rows])\n1396\t        program (list (list (quote fn) [(quote x)]\n1397\t                            (insertion-map\n1398\t                              [(list (quote -) (quote x) 1) :a\n1399\t                               (list (quote -) 1 (quote x)) :b]))\n1400\t                      1)\n1401\t        recompiled (yang/compile program)]\n1402\t    (testing \"the artifact is complete and self-consistent\"\n1403\t      (is (= (:root payload) (get-in payload [:rows (:root payload) 0])))\n1404\t      (is (= \"c1-1\" (:manifest-revision payload))))\n1405\t    (testing \"the rows load through the walker loader and run unchanged\"\n1406\t      (let [vm (ast-walker/vm-load-rows (tu/create-vm base-opts)\n1407\t                                        rows vm/ast-contract)]\n1408\t        (is (= (:old-value payload) (vm/value (vm/run vm)))\n1409\t            \"old operand order stays old executable behavior\")))\n1410\t    (testing \"the old order is not the new canonical order\"\n1411\t      (is (pos? (count (get-in payload [:old-operand-roots]))))\n1412\t      (is (not= (:root (vm/ast->semantic-bytecode recompiled))\n1413\t                (:root payload))\n1414\t          \"recompiling the same source mints the canonicalized tree\"))\n1415\t    (testing \"the fresh compilation canonicalizes and changes the winner\"\n1416\t      (let [ctor (first (map-constructors recompiled))]\n1417\t        (is (strictly-ascending? (pair-keys ctor)))\n1418\t        (is (not= (child-roots ctor)\n1419\t                  (vec (:old-operand-roots payload))))\n1420\t        ;; both keys evaluate to 0; the canonically last pair wins now\n1421\t        (is (= (:old-value payload) {0 :b}))\n1422\t        (is (not= {0 :b} (:ast-walker (run-form program {}))))))))\n1423\t\n1424\t\n1425\t(deftest token-admission-distinct-origins-test\n1426\t  \"Admitting the same content under two tokens yields one root and two\n1427\t   distinct origin sets and occurrence-key vectors (the cohort negative\n1428\t   member rule).\"\n1429\t  (let [form {(list (quote tap) :k) (list (quote tap) :v)}\n1430\t        a (project-batch (yang/compile form) \"order-a\")\n1431\t        b (project-batch (yang/compile form) \"order-b\")\n1432\t        origins (fn [batch]\n1433\t                  (into #{} (comp (filter (fn [row] (= :yang/call-site (nth row 3))))\n1434\t                                  (map first))\n1435\t                        (:rows batch)))]\n1436\t    (is (= (:root (:tree a)) (:root (:tree b))))\n1437\t    (is (not= (origins a) (origins b)))\n1438\t    (is (not= (digest-snapshot a) (digest-snapshot b)))))\n1439\t\n1440\t\n1441\t(def ^:private corpus-reference\n1442\t  \"B3: the recorded cross-host reference for the broader corpus -- one\n1443\t   canonical construction per corpus case (forward insertion through\n1444\t   the array-map/vec-set builders), JVM-recorded under the cc4 cohort's\n1445\t   digest model: root, application count, the canonical-sorted C1\n1446\t   marker relation, the sorted occurrence-key vector, and all three\n1447\t   instruction formats' call-provenance. Every host compares against\n1448\t   THIS bundle, not only against its own permutations.\n1449\t   Recorded at fix/constructed-collection-order base 7e6d720c with the\n1450\t   r3 repairs applied (seed-normalized generator, restored legacy\n1451\t   fixture), JVM OpenJDK 21.0.2+13-58, Clojure CLI 1.12.4.1602.\"\n1452\t  [{:case :constant-keys-dynamic-values,\n145