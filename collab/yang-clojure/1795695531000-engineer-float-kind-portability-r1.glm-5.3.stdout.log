.clojure.floatkind/host host\n                 :yang.clojure.floatkind/source legacy-source\n                 :yang.clojure.floatkind/pre-fix-ref \\\"7f4898f4 c1-2\\\"\n                 :manifest-revision \\\"c1-2\\\"\n                 :root (:root tree)\n                 :rows (:rows tree)}\n        path (case host\n               :jvm \\\"test/resources/yang/clojure/float-kind-legacy-jvm-float.cbor\\\"\n               :node \\\"test/resources/yang/clojure/float-kind-legacy-node-integer.cbor\\\"\n               nil)\n        bytes (when path (write-bytes! path payload))]\n    (when path\n      (println :floatkind-legacy-capture host\n               :bytes (count bytes)\n               :content-hash (jing/content-hash {:host host :bytes (count bytes)}))\n      ;; the captured literal keeps the HOST current kind: JVM float64\n      ;; content, Node whatever cljs.tools.reader produced (pre-fix, an\n      ;; integer). Both facts are the evidence; neither is corrected here.\n      (is (pos? (count bytes))))))\n\"\"\")'","description":"Write legacy capture test namespace via python"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"519cc353-4ebf-4ee9-a727-f6a51287dd1a","uuid":"d4674a88-571a-4c45-8f29-257756b864a6","timestamp":"2026-11-26T12:44:06.617Z","wire_tool_inputs":{"call_557e7302c78c48d98daf5095":{"command":"python3 -c 'import pathlib\npathlib.Path(\"test/yang/floatkind_legacy_capture_test.cljc\").write_text(\"\"\"(ns yang.floatkind-legacy-capture-test\n  \\\"\\\"\\\"ONE-SHOT pre-fix evidence capture (float-kind portability r1, RULING 5\n   gate 6): mints the legacy custody fixtures from the CURRENT compiler —\n   the JVM float-bearing artifact and the Node integer-bearing artifact of\n   the SAME source — and writes them under test/resources/yang/clojure/.\n\n   Run once on each host against the UNREPAIRED tree, then delete this\n   namespace. The fixtures it leaves behind are the genuine pre-fix bytes\n   the custody test loads and executes without recompilation afterwards;\n   an artifact synthesized by the repaired compiler would not be legacy\n   evidence.\\\"\\\"\\\"\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yang.clojure :as yang]\n            [yin.vm :as vm]))\n\n\n(def ^:private legacy-source\n  \\\"\\\"\\\"The custody witness program: a float literal under a closure call.\\\"\\\"\\\"\n  \\\"((fn [] 1.0))\\\")\n\n\n(defn- write-bytes!\n  [path payload]\n  (let [bytes (cbor/encode payload)]\n    #?(:clj (clojure.java.io/make-parents path)\n       :cljs (js/require \\\"fs\\\"))\n    #?(:clj (with-open [w (clojure.java.io/output-stream path)]\n               (.write w ^bytes bytes))\n       :cljs (.writeFileSync (js/require \\\"fs\\\") path bytes))\n    bytes))\n\n\n(deftest capture-legacy-float-kind-artifact\n  (let [ast (yang/compile-program (yang/read-forms legacy-source))\n        tree (vm/ast->semantic-bytecode ast)\n        host #?(:clj :jvm :cljs :node :default :other)\n        payload {:yang.clojure.floatkind/legacy true\n                 :yang.clojure.floatkind/host host\n                 :yang.clojure.floatkind/source legacy-source\n                 :yang.clojure.floatkind/pre-fix-ref \\\"7f4898f4 c1-2\\\"\n                 :manifest-revision \\\"c1-2\\\"\n                 :root (:root tree)\n                 :rows (:rows tree)}\n        path (case host\n               :jvm \\\"test/resources/yang/clojure/float-kind-legacy-jvm-float.cbor\\\"\n               :node \\\"test/resources/yang/clojure/float-kind-legacy-node-integer.cbor\\\"\n               nil)\n        bytes (when path (write-bytes! path payload))]\n    (when path\n      (println :floatkind-legacy-capture host\n               :bytes (count bytes)\n               :content-hash (jing/content-hash {:host host :bytes (count bytes)}))\n      ;; the captured literal keeps the HOST current kind: JVM float64\n      ;; content, Node whatever cljs.tools.reader produced (pre-fix, an\n      ;; integer). Both facts are the evidence; neither is corrected here.\n      (is (pos? (count bytes))))))\n\"\"\")'","description":"Write legacy capture test namespace via python"}}}
