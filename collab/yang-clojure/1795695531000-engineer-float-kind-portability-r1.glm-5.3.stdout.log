ild-map :array-map entries))])\n                            map-corpus)\n                       (map (fn [[label elements]]\n                              [(keyword (name label))\n                               (compile-snapshot (build-set :vec-set elements))])\n                            set-corpus)\n                       (mapcat (fn [n]\n                                 [[(keyword (str \"map-\" n))\n                                   (compile-snapshot (build-map :array-map\n                                                                (sized-map-entries n)))]\n                                  [(keyword (str \"set-\" n))\n                                   (compile-snapshot (build-set :vec-set\n                                                                (sized-set-elements n)))]])\n                               map-corpus-sizes)))]\n    (is (= (count corpus-reference) (count actual) 18))\n    (doseq [{:keys [case] :as expected} corpus-reference]\n      (testing (str case)\n        (is (= expected (assoc (get actual case) :case case))\n            (str \"cross-host corpus divergence at \" case))))))","numLines":240,"startLine":1352,"totalLines":1592}},"tool_result_meta":[{"id":"call_2ff7bb9770dc46c998ac3360","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
