      :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\n                  ;; the conformance compositions) overflow smaller stacks in\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n                  ;; the 4m minimum for the prelude recursion rows still holds)\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts