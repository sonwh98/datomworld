.\"\n  2535\t  [run fixture]\n  2536\t  (kernel-compile fixture (:scope run) (admission-run-ordinal run)))\n  2537\t\n  2538\t\n  2539\t(defn- kernel-c\n  2540\t  [compiled lane]\n  2541\t  (if (= :compiled (:status compiled))\n  2542\t    (assoc (kernel-attempt\n  2920\t\n  2921\t\n  2922\t(defn- kernel-row\n  2923\t  \"One fixture row, admitted under an explicit coordinate: the\n  2924\t   admitting run composition supplies `run-scope` and the fixture's\n  2925\t   distinct `admission-ordinal` within that run (see\n  2926\t   `fresh-admission-run` / `kernel-row-in-run`). The retained\n  2927\t   admission origin is recorded on the row so caller-path tests can\n  2928\t   pin per-fixture distinctness within one run.\"\n  2929\t  [fixture run-scope admission-ordinal]\n  2930\t  (let [a (kernel-a fixture)\n  2931\t        b (kernel-b fixture)\n  2932\t        compiled (kernel-attempt #(kernel-compile fixture run-scope admission-ordinal))\n  2933\t        compiled (if (and (= :blocked (:status compiled)) (not (:blocked-by compiled)))\n  2934\t                   (assoc compiled :phase :compile\n  2935\t                          :blocked-by (if-let [n (get-in compiled [:data :name])] [n] [:compiler-exception])\n  2936\t                          :minimal-source (get kernel-sources (get-in compiled [:data :name]))) compiled)\n  2937\t        walker (kernel-c compiled :walker)\n  2938\t        semantic (kernel-c compiled :semantic)\n  2939\t        match? (and (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n  2940\t                    (= (:outcome a) (:outcome b))\n  2941\t                    (agrees? (get a :outcome) (get walker :outcome))\n  2942\t                    (= (:outcome walker) (:outcome semantic))\n  2943\t                    (= (result-shape (:outcome a)) (result-shape (:outcome b)))\n  2944\t                    (if (contains? (:outcome a) :value)\n  2945\t                      (= (result-shape (:value (:outcome a)))\n  2946\t                         (result-shape (second (:outcome walker))))\n  2947\t                      (= (result-shape (get-in a [:outcome :thrown :data]))\n  2948\t                         (result-shape (get-in walker [:outcome 1 :yin.k/data])))))\n  2949\t        deviation (kernel-host-value-deviation fixture a b walker semantic)\n  2950\t        upstream-failure (kernel-upstream-failure fixture a b walker semantic)\n  2951\t        status (cond match? :pass\n  2952\t                     upstream-failure :recorded-upstream-failure\n  2953\t                     (some #(= :blocked (:status %)) [a b walker semantic]) :blocked\n  2954\t                     deviation :recorded-deviation\n  2955\t                     :else :mismatch)]\n  2956\t    {:id (:id fixture) :mode (:mode fixture) :negative? (boolean (:negative? fixture)) :status status\n  2957\t     :admission-origin (:admission-origin compiled)\n  2958\t     :admission-scope run-scope :admission-ordinal admission-ordinal\n  2959\t     :recorded-deviation deviation\n  2960\t     :recorded-upstream-failure upstream-failure\n  2961\t     :dependency-of (:dependency-of fixture)\n  2962\t     :call (or (:call fixture) (kernel-c-program fixture))\n  2963\t     :adapted-call (:guest-call fixture)\n  2964\t     :site-table (:site-table compiled)\n  2965\t     :site-table-hash (:site-table-hash compiled)\n  2966\t     :canonical-source-hash (:canonical-source-hash compiled)\n  2967\t     :agreement {:a-b (and (= :completed (:status a) (:status b)) (= (:outcome a) (:outcome b)))\n  2968\t                 :a-c-walker (and (= :completed (:status a) (:status walker))\n  2969\t                                  (agrees? (:outcome a) (:outcome walker)))\n  2970\t                 :a-c-semantic (and (= :completed (:status a) (:status semantic))\n  2971\t                                    (agrees? (:outcome a) (:outcome semantic)))\n  2972\t                 :c-lanes (and (= :completed (:status walker) (:status semantic))\n  2973\t                               (= (:outcome walker) (:outcome semantic)))}\n  2974\t     :a a :b b :c-walker walker :c-semantic semantic\n  2975\t     :included-functions (mapv second (kernel-closure (kernel-c-program fixture)))}))\n  2976\t\n  2977\t\n  2978\t(defn- kernel-row-in-run\n  2979\t  \"The next fixture row of `run`: the run's scope with a distinct\n  2980\t   ordinal assigned by the run composition.\"\n  2981\t  [run fixture]\n  2982\t  (kernel-row fixture (:scope run) (admission-run-ordinal run)))\n  2983\t\n  2984\t\n  2985\t(deftest test-kernel-unused-arity-execution\n  2986\t  (let [fixture (first (filter #(= :parse-to-normalize-to-type (:id %)) (:fixtures kernel-gate-corpus)))\n  2987\t        fname 'gate-presyntax-parse\n  2988\t        source (get kernel-sources fname)\n  2989\t        ;; Preserve parse/2; poison the uncalled parse/1 body in memory.\n  2990\t        poisoned (list* 'defn fname\n  2991\t                        (map (fn [arity]\n  2992\t                               (if (= 1 (count (first arity)))\n  2993\t                                 (list (first arity) '(throw (ex-info \"Uncalled parse/1 entered\" {})))\n  2994\t                                 arity)) (drop 2 source)))\n  2995\t        row (with-redefs [kernel-sources (assoc kernel-sources fname poisoned)]\n  2996\t              (kernel-row-in-run (fresh-admission-run :kernel-unused-arity) fixture))\n  2997\t        inventory [{:symbol 'latte-kernel.presyntax/parse :arities [1 2] :disposition :admitted}]\n  2998\t        entries (kernel-exercise-entries inventory [fixture] [row])]\n  3250\t        (is (vector? stale) \"the diagnostic is recorded data\")))))\n  3251\t\n  3252\t\n  3253\t(defn kernel-gate-evidence\n  3254\t  \"Run every fixture in A and independently in both C lanes. Compilation or\n  3255\t   VM errors are blockers, never successful LaTTe rejections. Exact arities\n  3256\t   require recorded body entry in both C lanes of a passing fixture.\"\n  3257\t  []\n  3258\t  ;; The evidence run is the run composition: it allocates its scope\n  3259\t  ;; ONCE here and threads it through every fixture row, each taking\n  3260\t  ;; a distinct ordinal within this run.\n  3261\t  (let [run (fresh-admission-run :kernel-gate-evidence)\n  3262\t        results (mapv (fn [fixture]\n  3263\t                        (let [row (kernel-row-in-run run fixture)]\n  3264\t                          (println \"KERNEL-FIXTURE\" (:id row) (:status row))\n  3265\t                          row)) (:fixtures kernel-gate-corpus))\n  3266\t        inventory (mapv #(select-keys % [:symbol :kind :arities :disposition :admission-reason]) kernel-entries)\n  3267\t        exercise-entries (kernel-exercise-entries inventory (:fixtures kernel-gate-corpus) results)\n  3268\t        direct (set (map :function-arity (filter #(= :direct (:exercise %)) exercise-entries)))\n  3269\t        exercised (set (map :function-arity (remove #(= :unexercised (:exercise %)) exercise-entries)))\n  3270\t        all-arities (set (for [{:keys [symbol arities]} inventory n arities] [symbol n]))\n  3271\t        admitted-arities (set (for [{:keys [symbol arities disposition]} inventory\n  3272\t                                    :when (= :admitted disposition) n arities] [symbol n]))\n  3273\t        unexercised (vec (sort-by pr-str (remove exercised admitted-arities)))]\n  3274\t    {:slice 9 :gate-status (if (and (every? #(contains? #{:pass :recorded-deviation :recorded-upstream-failure} (:status %)) results)\n  3275\t                                    (empty? unexercised)) :pass :blocked)\n  3276\t     :baseline {:revision \"7dc18478\" :fixture-count 54 :counts {:pass 4 :mismatch 2 :blocked 48}}\n  3277\t     :generated-at (str (java.time.Instant/now))\n  3278\t     :adaptation-version {:context 2 :kernel-assembly 4}\n  3350\t     ;; credit from them); the evidence writer omits them from the\n  3351\t     ;; inline rows and lands them in the versioned companion file\n  3352\t     :fixtures results}))\n  3353\t\n  3354\t\n  3355\t(defn write-kernel-gate-evidence!\n  3356\t  \"Explicit evidence/coverage refresh; normal tests never update these files.\n  3357\t   With `dir`, writes into that directory (the round-trip test's temp dir);\n  3358\t   without it, the checked-in locations.\"\n  3359\t  ([] (write-kernel-gate-evidence! \"test/yang/latte_oracle\"))\n  3360\t  ([dir]\n  3361\t   (let [evidence (kernel-gate-evidence)]\n  3362\t     (spit (str dir \"/slice9_unexercised.edn\")\n  3363\t           (str \";; GENERATED from exact execution evidence in both C lanes.\\n\"\n  3364\t                (pr-str (into (sorted-map-by #(compare (pr-str %1) (pr-str %2)))\n  3365\t                              (for [entry (get-in evidence [:coverage :entries])\n  3366\t                                    :when (= :unexercised (:exercise entry))]\n  3367\t                                [(:function-arity entry) (:missing-dependency entry)]))) \"\\n\"))\n  3368\t     ;; The versioned site tables (R1b/R7): one derived table and one\n  3369\t     ;; canonical-source-hash per fixture, stable across refreshes so the\n  3370\t     ;; later durable correspondence record lands additively.\n  3371\t     (spit (str dir \"/slice9_site_tables.edn\")\n  3372\t           (str \";; GENERATED from the compiled AST of each fixture's C program.\\n\"\n  3373\t                (pr-str {:version 1\n  3374\t                         :fixtures\n  3375\t                         (into (sorted-map)\n  3376\t                               (for [row (:fixtures evidence)]\n  3377\t                                 [(:id row)\n  3378\t                                  {:canonical-source-hash (:canonical-source-hash row)\n  3379\t                                   :site-table (:site-table row)}]))})\n  3380\t                \"\\n\"))\n  3381\t     (with-open [w (io/writer (str dir \"/slice9_evidence.edn\"))]\n  3382\t       ;; prn keeps (quote ...) in valid EDN rather than pprint's reader\n  3383\t       ;; shorthand. One fixture per line keeps refreshes independently diffable.\n  3384\t       (binding [*out* w *print-length* nil *print-level* nil]\n  3385\t         (print \"{\")\n  3386\t         (doseq [[k v] (dissoc evidence :fixtures)] (pr k) (print \" \") (prn v))\n  3387\t         (println \":fixtures [\")\n  3388\t         (doseq [row (:fixtures evidence)]\n  3389\t           ;; the per-run admission coordinate (fresh scope per run) is\n  3390\t           ;; retained on the in-memory row for caller-path pins, not\n  3391\t           ;; landed in the versioned evidence file\n  3392\t           (prn (dissoc row :site-table :admission-origin\n  3393\t                        :admission-scope :admission-ordinal)))\n  3394\t         (println \"]}\")))\n  3395\t     (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage :attribution]))))\n  3396\t\n  3397\t\n  3398\t(deftest test-kernel-differential-gate\n  3399\t  (let [evidence (kernel-gate-evidence)]\n  3400\t    (is (= (count (:fixtures kernel-gate-corpus)) (count (set (map :id (:fixtures evidence)))))\n  3401\t        \"Every named fixture runs exactly once, including negatives\")\n  3402\t    (doseq [row (:fixtures evidence)\n  3403\t            :when (and (:negative? row) (= :completed (get-in row [:a :status])))\n  3404\t            :let [outcome (get-in row [:a :outcome]) value (:value outcome)\n  3405\t                  fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n  3785\t(deftest test-cc3-oracle-site-c1-binding\n  3786\t  ;; Bounds for this tagged run are recorded in the cc3 findings'\n  3787\t  ;; PREFLIGHT BOUNDS section before this test was first run:\n  3788\t  ;; 4,000,000 guest instructions and 1,000,000 trace records per C\n  3789\t  ;; lane, restated and not raised.\n  3790\t  (let [;; this binding run allocates its enclosing run identity ONCE\n  3791\t        ;; here; the compilation is its ordinal-0 admission\n  3792\t        run (fresh-admission-run :cc3-binding-run)\n  3793\t        fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n  3794\t        compiled (kernel-compile-in-run run fixture)]\n  3795\t    (is (= :compiled (:status compiled)))\n  3796\t    (is (= [(:scope run) 0] (nth (:admission-origin compiled) 2))\n  3797\t        \"the binding run's scope is the enclosing run identity, threaded in\")\n  3798\t    (let [{:keys [origin tree rows marked eligible binding correspondence\n  3799\t                  stamped-paths stamped-tree stamped-marked stamped-eligible]}\n  3800\t          (cc3-oracle-binding compiled)\n  3801\t          sites (:sites compiled)]\n  3802\t      (testing \"the origin is the retained admission record, not content synthesis\"\n  3803\t        (is (= (:admission-origin compiled) origin)\n  3804\t            \"the binding consumes the coordinate recorded when admitting\")\n  3805\t        (is (true? (vm/occurrence-origin? origin)))\n  3806\t        (is (= :program (nth origin 1)))\n  3807\t        (is (not= [:source :program (:canonical-source-hash compiled) 0]\n  3808\t                  origin)\n  4105\t          \"the same sites bind under each ordinal's own origin\"))))\n  4106\t\n  4107\t\n  4108\t(deftest test-cc3-caller-run-threads-distinct-admissions\n  4109\t  ;; cc3 r5 F2 residue: pin through the ACTUAL caller path. One\n  4110\t  ;; evidence run allocates its scope ONCE; `kernel-row` (the caller\n  4111\t  ;; every fixture row goes through) assigns DISTINCT ordinals within\n  4112\t  ;; that run, so identical content admitted twice in one run mints\n  4113\t  ;; distinct origins. A fresh run supplies a distinct scope (ordinal\n  4114\t  ;; restarting at 0 still mints a new origin), and replay explicitly\n  4115\t  ;; re-supplies the retained run's scope+ordinal.\n  4116\t  (let [fixture {:id :cc3-binding\n  4117\t                 :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n  4118\t        run (fresh-admission-run :caller-evidence-run)\n  4119\t        row-0 (kernel-row-in-run run fixture)\n  4120\t        row-1 (kernel-row-in-run run fixture)\n  4121\t        fresh-row (kernel-row-in-run\n  4122\t                    (fresh-admission-run :caller-evidence-run) fixture)\n  4123\t        replay-row (kernel-row fixture (:scope run) 0)]\n  4124\t    (is (= :pass (:status row-0)))\n  4125\t    (is (= :pass (:status row-1)))\n  4126\t    (is (= [(:scope run) 0] (nth (:admission-origin row-0) 2))\n  4127\t        \"the first fixture in the run takes ordinal 0 under the run scope\")\n  4128\t    (is (= [(:scope run) 1] (nth (:admission-origin row-1) 2))\n  4129\t        \"the second fixture in the same run takes a distinct ordinal\")\n  4130\t    (is (not= (:admission-origin row-0) (:admission-origin row-1))\n  4131\t        \"identical content admitted twice in one run mints distinct origins\")\n  4132\t    (is (not= (:scope run) (nth (:admission-origin fresh-row) 2))\n  4133\t        \"a fresh run supplies a distinct scope\")\n  4134\t    (is (= 0 (nth (nth (:admission-origin fresh-row) 2) 1))\n  4135\t        \"the fresh run restarts its ordinals\")\n  4136\t    (is (not= (:admission-origin row-0) (:admission-origin fresh-row))\n  4137\t        \"a restarted ordinal under a fresh scope still mints a new origin\")\n  4138\t    (is (= (:admission-origin row-0) (:admission-origin replay-row))\n  4139\t        \"replay explicitly re-supplies the retained scope+ordinal\")))\n     1\t;; cc3 F6 measurement — v2 bounded run (declaration:\n     2\t;; collab/yang-clojure/1794390804000-cc3-bounded-run-declaration-v2.md).\n     3\t;; Method (unchanged corrections from r4): (a) no structure is held by\n     4\t;; a global Var — everything is built inside functions, held only by\n     5\t;; locals, sampled while provably alive, released on return; (b) the\n     6\t;; peak sampler spans lowering -> binding/projection/derives -> actual\n     7\t;; serialization (canonical bytes) AND durable persistence\n     8\t;; (materialize! into a file-backed store, closed) -> tagged\n     9\t;; execution; (c) a discarded warmup + GC pin precedes measurement.\n    10\t;; r5 changes: pass/fail is MAXIMUM-based (any sample over its ceiling\n    11\t;; = EXCEEDED; medians are informational only); the acceptance holder\n    12\t;; is the compiled-inclusive variant; repetitions are 5 retained per\n    13\t;; variant and 3 pipeline runs, ALL samples recorded; every admission\n    14\t;; takes a distinct ordinal within this one measurement run's scope.\n    15\t(require 'yang.latte-oracle-test 'dao.jing 'yin.vm.semantic.linearize\n    16\t         'yin.vm.semantic.derive 'yin.repl.store)\n    17\t(import '(java.lang Runtime System)\n    18\t        '(java.util UUID))\n    19\t\n    20\t(def ^:private run-scope (str \"cc3-f6-measure-v2-\" (UUID/randomUUID)))\n    21\t(def ^:private next-ordinal (atom 0))\n    22\t(defn- admit-ordinal [] (let [o @next-ordinal] (swap! next-ordinal inc) o))\n    23\t\n    24\t(defn- used [] (let [rt (Runtime/getRuntime)] (- (.totalMemory rt) (.freeMemory rt))))\n    25\t(defn- gc-used [] (System/gc) (Thread/sleep 50) (System/gc) (used))\n    26\t\n    27\t(def ^:private ceilings-v2\n    28\t  {:per-artifact-bytes 2000000\n    29\t   :aggregate-storage-bytes 4000000\n    30\t   :retained-aggregate 12000000\n    31\t   :heap 1073741824 :time-ms 10000})\n    32\t\n    33\t(defn- build-retained [compiled-inclusive?]\n    34\t  ;; A fresh retained structure built and held ONLY by the caller's\n    35\t  ;; local. Returns plain data; nothing here is def'd. The\n    36\t  ;; compiled-inclusive variant also retains the compiled input and\n    37\t  ;; the binding's reconstruction evidence (correspondence etc.).\n    38\t  (let [kc @#'yang.latte-oracle-test/kernel-compile\n    39\t        binding @#'yang.latte-oracle-test/cc3-oracle-binding\n    40\t        c (kc {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n    41\t              run-scope (admit-ordinal))\n    42\t        b (binding c)\n    43\t        sem (yin.vm.semantic.linearize/project-rows (:tree b) nil (:rows b))\n    44\t        stack (yin.vm.semantic.derive/stack-image\n    45\t                (:vector sem) {:segment-address :seg/stack\n    46\t                               :call-provenance (:call-provenance sem)})\n    47\t        reg (yin.vm.semantic.derive/register-image\n    48\t              (:vector sem) {:segment-address :seg/register\n    49\t                             :call-provenance (:call-provenance sem)})\n    50\t        relation {:yin.vm.provenance/schema 1\n    51\t                  :yin.vm.provenance/admission (:origin b)\n    52\t                  :yin.vm.provenance/root (:root (:tree b))\n    53\t                  :yin.vm.provenance/semantic (:call-provenance sem)\n    54\t                  :yin.vm.provenance/stack (:call-provenance stack)\n    55\t                  :yin.vm.provenance/register (:call-provenance reg)}\n    56\t        holder {:binding b :sem sem :stack stack :reg reg :relation relation}]\n    57\t    (if compiled-inclusive? (assoc holder :compiled c) holder)))\n    58\t\n    59\t(defn- measure-retained [compiled-inclusive?]\n    60\t  ;; Baseline and retained samples are taken in this one scope; the\n    61\t  ;; holder local is used AFTER the second sample so it cannot be\n    62\t  ;; collected early. Returns [delta alive-check].\n    63\t  (let [b0 (gc-used)\n    64\t        holder (build-retained compiled-inclusive?)\n    65\t        a (gc-used)\n    66\t        alive (System/identityHashCode holder)]\n    67\t    [(- a b0) alive]))\n    68\t\n    69\t(defn- measure-pipeline []\n    70\t  ;; Peak used-heap sampled every 2 ms across the whole pipeline,\n    71\t  ;; INCLUDING serialization + durable persistence. All state local.\n    72\t  (let [kc @#'yang.latte-oracle-test/kernel-compile\n    73\t        binding @#'yang.latte-oracle-test/cc3-oracle-binding\n    74\t        kernel-c @#'yang.latte-oracle-test/kernel-c\n    75\t        peak (atom 0)\n    76\t        stop (atom false)\n    77\t        sampler (Thread. (fn [] (while (not @stop)\n    78\t                                  (swap! peak max (used))\n    79\t                                  (Thread/sleep 2))))\n    80\t        stages (atom [])\n    81\t        mark (fn [label] (swap! stages conj [label (used)]))\n    82\t        t0 (System/currentTimeMillis)\n    83\t        base (gc-used)]\n    84\t    (.start sampler)\n    85\t    (let [compiled (kc {:id :cc3-binding\n    86\t                        :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n    87\t                       run-scope (admit-ordinal))\n    88\t          _ (mark :after-compile)\n    89\t          b (binding compiled)\n    90\t          _ (mark :after-binding)\n    91\t          sem (yin.vm.semantic.linearize/project-rows (:tree b) nil (:rows b))\n    92\t          _ (mark :after-project-rows)\n    93\t          stack (yin.vm.semantic.derive/stack-image\n    94\t                  (:vector sem) {:segment-address :seg/stack\n    95\t                                 :call-provenance (:call-provenance sem)})\n    96\t          reg (yin.vm.semantic.derive/register-image\n    97\t                (:vector sem) {:segment-address :seg/register\n    98\t                               :call-provenance (:call-provenance sem)})\n    99\t          _ (mark :after-derives)\n   100\t          relation {:yin.vm.provenance/schema 1\n   101\t                    :yin.vm.provenance/admission (:origin b)\n   102\t                    :yin.vm.provenance/root (:root (:tree b))\n   103\t                    :yin.vm.provenance/semantic (:call-provenance sem)\n   104\t                    :yin.vm.provenance/stack (:call-provenance stack)\n   105\t                    :yin.vm.provenance/register (:call-provenance reg)}\n   106\t          record {:yin.repl.call-provenance/schema 1\n   107\t                  :yin.repl.call-provenance/admission (:origin b)\n   108\t                  :yin.repl.call-provenance/root (:root (:tree b))\n   109\t                  :yin.repl.call-provenance/relation nil}\n   110\t          ;; actual serialization, inside the sampled window\n   111\t          rows-bytes (count (dao.jing/canonical-bytes (:rows b)))\n   112\t          rel-bytes (count (dao.jing/canonical-bytes relation))\n   113\t          _ (mark :after-serialization)\n   114\t          ;; durable persistence, inside the sampled window: a\n   115\t          ;; file-backed content store, materialized and closed\n   116\t          dir (str \"/tmp/cc3-f6-store-\" (System/currentTimeMillis))\n   117\t          store (yin.repl.store/open {:type :file :dir dir})\n   118\t          rel-addr (dao.jing/materialize! store relation)\n   119\t          rec-addr (dao.jing/materialize!\n   120\t                     store (assoc record :yin.repl.call-provenance/relation rel-addr))\n   121\t          record-bytes (count (dao.jing/canonical-bytes\n   122\t                                (assoc record :yin.repl.call-provenance/relation rel-addr)))\n   123\t          _ (yin.repl.store/close! store)\n   124\t          _ (mark :after-persistence)\n   125\t          c-walker (kernel-c compiled :c-walker)\n   126\t          c-sem (kernel-c compiled :c-semantic)\n   127\t          _ (mark :after-tagged-execution)\n   128\t          elapsed (- (System/currentTimeMillis) t0)]\n   129\t      (reset! stop true)\n   130\t      (.join sampler)\n   131\t      {:compiled-status (:status compiled)\n   132\t       :c-status [(:status c-walker) (:status c-sem)]\n   133\t       :rows-canonical-bytes rows-bytes\n   134\t       :relation-canonical-bytes rel-bytes\n   135\t       :record-canonical-bytes record-bytes\n   136\t       :aggregate-storage-bytes (+ rows-bytes rel-bytes record-bytes)\n   137\t       :store-dir dir :relation-address rel-addr :record-address rec-addr\n   138\t       :heap-baseline-gc-used base\n   139\t       :stage-used @stages\n   140\t       :peak-used-during-pipeline @peak\n   141\t       :peak-over-baseline (- @peak base)\n   142\t       :elapsed-ms elapsed})))\n   143\t\n   144\t;; warmup: build + persist + execute once, DISCARD, GC-pin, so the\n   145\t;; measured runs do not charge class loading / JIT to the structures.\n   146\t(build-retained true)\n   147\t(measure-pipeline)\n   148\t(gc-used)\n   149\t(let [binding-only (mapv (fn [_] (first (measure-retained false))) (range 5))\n   150\t      compiled-incl (mapv (fn [_] (first (measure-retained true))) (range 5))\n   151\t      after-release (gc-used)\n   152\t      pipes (mapv (fn [_] (measure-pipeline)) (range 3))\n   153\t      median (fn [xs] (nth (sort xs) (quot (count xs) 2)))\n   154\t      retained-max (apply max compiled-incl)\n   155\t      binding-max (apply max binding-only)\n   156\t      peak-max (apply max (map :peak-used-during-pipeline pipes))\n   157\t      elapsed-max (apply max (map :elapsed-ms pipes))\n   158\t      storage-max (apply max (map (fn [p] (max (:rows-canonical-bytes p)\n   159\t                                               (:relation-canonical-bytes p))) pipes))\n   160\t      aggregate-max (apply max (map :aggregate-storage-bytes pipes))]\n   161\t  (println :run-scope run-scope)\n   162\t  (println :retained-binding-only-samples binding-only)\n   163\t  (println :retained-binding-only-max binding-max)\n   164\t  (println :retained-binding-only-median-informational (median binding-only))\n   165\t  (println :retained-compiled-inclusive-samples compiled-incl)\n   166\t  (println :retained-compiled-inclusive-max retained-max)\n   167\t  (println :retained-compiled-inclusive-median-informational (median compiled-incl))\n   168\t  (println :after-release-gc-used after-release)\n   169\t  (doseq [[i pipe] (map-indexed vector pipes)]\n   170\t    (println :pipeline-repetition i)\n   171\t    (doseq [[k v] (sort-by key pipe)] (println (str \"  \" k) v)))\n   172\t  (println :ceilings-v2 ceilings-v2)\n   173\t  ;; MAXIMUM-based pass/fail (v2 declaration section 4): any single\n   174\t  ;; sample over its ceiling = EXCEEDED. Medians never decide.\n   175\t  (println :under-ceilings-v2\n   176\t           {:relation-bytes (<= storage-max (:per-artifact-bytes ceilings-v2))\n   177\t            :rows-bytes (<= storage-max (:per-artifact-bytes ceilings-v2))\n   178\t            :per-artifact-storage (<= storage-max (:per-artifact-bytes ceilings-v2))\n   179\t            :aggregate-storage (<= aggregate-max (:aggregate-storage-bytes ceilings-v2))\n   180\t            :retained-aggregate-max (<= retained-max (:retained-aggregate ceilings-v2))\n   181\t            :retained-binding-only-max-informational (<= binding-max (:retained-aggregate ceilings-v2))\n   182\t            :peak-heap-max (<= peak-max (:heap ceilings-v2))\n   183\t            :elapsed-max (<= elapsed-max (:time-ms ceilings-v2))\n   184\t            :all-c-lanes-completed (every? #(= [:completed :completed] (:c-status %)) pipes)}))\n   185\t(System/exit 0)\n","exit_code":0,"status":"completed"}}
