5\t(deftest test-d1-capture-refusal-names-admission\n  4336\t  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n  4337\t        run (fresh-admission-run :d1-capture-refusal)\n  4338\t        failure (with-redefs [correspondence-text/read-one! (fn [_ _] nil)]\n  4339\t                  (try (kernel-compile-in-run run fixture true) nil\n  4340\t                       (catch Exception e (ex-data e))))]\n  4341\t    (is (= {:fixture :beta-eq-false :scope (:scope run) :ordinal 0 :input :forms}\n  4342\t           (:compilation failure)))\n  4343\t    (is (= :fidelity (:stage failure)))))\n  4344\t\n  4345\t\n  4346\t(deftest test-d1-amended-replay-closed-store\n  4347\t  ;; One static fixture only; no tagged execution and no independent verifier.\n  4348\t  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n  4470\t              @peak)}))\n  4471\t\n  4472\t\n  4473\t(defn- d1-persist-and-check-fixture!\n  4474\t  \"Exercise one live admission through a temporary file store and the\n  4475\t   independent static gate; with opts, also run one mutated-input check\n  4476\t   per distinct gate refusal class. Does not produce a D1 record or a\n  4477\t   verifier result.\"\n  4478\t  [dir run fixture & [{:keys [spot-check? handle]}]]\n  4479\t  (let [compiled (kernel-compile-in-run run fixture true)\n  4480\t        _ (when-not (= :compiled (:status compiled))\n  4481\t            (throw (ex-info \"Fixture did not compile\" {:fixture (:id fixture) :stage :compile})))\n  4482\t        origin (:admission-origin compiled)\n  4483\t        evidence (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_site_tables.edn\")))\n  4484\t        expected (get-in evidence [:fixtures (:id fixture)])\n  4485\t        _ (when-not (and (= 1 (:version evidence)) (map? expected))\n  4486\t            (throw (ex-info \"Fixture evidence missing\" {:fixture (:id fixture) :stage :evidence})))\n  4487\t    