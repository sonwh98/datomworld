n4160:  ;; `[run-scope admission-ordinal]` with member index zero, retained\n4166:  ;; end-to-end, projected and searched keys agreeing; replaying one\n4167:  ;; retained admission keeps its one origin.\n4200:          \"replay reuses the recorded coordinate of scope run-a\")\n4215:  ;; restarting at 0 still mints a new origin), and replay explicitly\n4216:  ;; re-supplies the retained run's scope+ordinal.\n4224:        replay-row (kernel-row fixture (:scope run) 0)]\n4239:    (is (= (:admission-origin row-0) (:admission-origin replay-row))\n4240:        \"replay explicitly re-supplies the retained scope+ordinal\")))\n4289:  \"Producer-side static replay check. This shares cc3's derivation and is\n4300:            (throw (ex-info \"Missing retained admission\" {:fixture fixture :stage :admission})))\n4346:(deftest test-d1-amended-replay-closed-store\n4349:        run (fresh-admission-run :d1-replay)\n4360:        dir (str \"target/test-d1-replay-\" (random-uuid))\n4365:                            :profile (jing/materialize! handle correspondence-text/profile)\n4372:          (let [retained (jing/get reopened (:input addresses) ::missing)\n4374:            (is (= correspondence-text/profile (jing/get reopened (:profile addresses) ::missing)))\n4376:            (is (true? (= expected* (d1-check-reconstruction! (:id fixture) retained expected*))))\n4492:        snapshot {:fixture (:id fixture) :origin origin\n4501:                          :profile (jing/materialize! handle correspondence-text/profile)\n4502:                          :snapshot (jing/materialize! handle (assoc snapshot :root root :stamped-root stamped-root))\n4509:            stored-snapshot (jing/get reopened (:snapshot addresses) ::missing)\n4510:            stored-profile (jing/get reopened (:profile addresses) ::missing)\n4512:            before-tree (correspondence-verifier/fetch-tree! reopened (:root stored-snapshot) 100000)\n4513:            stamped-tree (correspondence-verifier/fetch-tree! reope