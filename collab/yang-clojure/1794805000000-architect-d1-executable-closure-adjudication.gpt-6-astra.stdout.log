{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yang/correspondence_dependency.clj; nl -ba test/yang/correspondence_dependency_test.clj; nl -ba test/yang/correspondence_static.clj | head -230'","aggregated_output":"     1\t(ns yang.correspondence-dependency\n     2\t  \"Byte-preserving dependency bundle storage. A bundle does not assert that\n     3\t   its contents are a complete or executable reconstruction closure.\"\n     4\t  (:require [clojure.string :as string]\n     5\t            [dao.jing :as jing])\n     6\t  (:import [java.util Base64]))\n     7\t\n     8\t(defn- path? [p]\n     9\t  (and (string? p) (not (string/blank? p))\n    10\t       (not (string/starts-with? p \"/\"))\n    11\t       (not (string/includes? p \"\\\\\"))\n    12\t       (every? #(and (not (string/blank? %)) (not (#{\".\" \"..\"} %)))\n    13\t               (string/split p #\"/\" -1))))\n    14\t\n    15\t(defn- fail! [reason]\n    16\t  (throw (ex-info \"Invalid correspondence dependency bundle\" {:reason reason})))\n    17\t\n    18\t(defn store-bundle!\n    19\t  \"Store explicit [relative-path byte-array] entries and an addressed index.\n    20\t   The caller is responsible for identifying the complete dependency set.\"\n    21\t  [handle entries]\n    22\t  (when-not (and (vector? entries) (seq entries)\n    23\t                 (every? #(and (vector? %) (= 2 (count %))\n    24\t                               (path? (first %)) (bytes? (second %))) entries)\n    25\t                 (= (count entries) (count (set (map first entries)))))\n    26\t    (fail! :entries))\n    27\t  (let [encoder (Base64/getEncoder)\n    28\t        index (mapv (fn [[path data]]\n    29\t                      [path (jing/materialize! handle\n    30\t                                              {:schema 1 :base64 (.encodeToString encoder data)})])\n    31\t                    entries)]\n    32\t    (jing/materialize! handle {:schema 1 :entries index})))\n    33\t\n    34\t(defn fetch-bundle!\n    35\t  \"Fetch and validate the index and every byte object, returning path/bytes.\n    36\t   dao.jing verifies each address. No files are written or executed.\"\n    37\t  [handle address]\n    38\t  (let [missing (Object.)\n    39\t        index (jing/get handle address missing)\n    40\t        entries (:entries index)]\n    41\t    (when-not (and (map? index) (= #{:schema :entries} (set (keys index)))\n    42\t                   (= 1 (:schema index)) (vector? entries) (seq entries)\n    43\t                   (every? #(and (vector? %) (= 2 (count %))\n    44\t                                 (path? (first %)) (jing/segment-address? (second %))) entries)\n    45\t                   (= (count entries) (count (set (map first entries)))))\n    46\t      (fail! :index))\n    47\t    (mapv (fn [[path ref]]\n    48\t            (let [blob (jing/get handle ref missing)]\n    49\t              (when-not (and (map? blob) (= #{:schema :base64} (set (keys blob)))\n    50\t                             (= 1 (:schema blob)) (string? (:base64 blob)))\n    51\t                (fail! :blob))\n    52\t              (let [data (try (.decode (Base64/getDecoder) ^String (:base64 blob))\n    53\t                              (catch IllegalArgumentException _ (fail! :base64)))]\n    54\t                (when-not (= (:base64 blob) (.encodeToString (Base64/getEncoder) data))\n    55\t                  (fail! :base64))\n    56\t                [path data])))\n    57\t          entries)))\n     1\t(ns yang.correspondence-dependency-test\n     2\t  (:require [clojure.test :refer [deftest is]]\n     3\t            [dao.jing :as jing]\n     4\t            [dao.jing.mem :as mem]\n     5\t            [yang.correspondence-dependency :as dependency]\n     6\t            [yin.repl.store :as store]))\n     7\t\n     8\t(deftest dependency-bundle-roundtrip-and-refusal\n     9\t  (let [store (mem/create-content-mem)\n    10\t        inputs [[\"src/example.clj\" (byte-array [0 1 -1 10])]\n    11\t                [\"lib/runtime.jar\" (byte-array [42 0 13])]]\n    12\t        address (dependency/store-bundle! store inputs)\n    13\t        bundle (dependency/fetch-bundle! store address)]\n    14\t    (is (jing/segment-address? address))\n    15\t    (is (= (mapv first inputs) (mapv first bundle)))\n    16\t    (is (= (mapv (comp vec second) inputs) (mapv (comp vec second) bundle)))\n    17\t    (is (thrown? Exception (dependency/store-bundle! store [[\"x\" (byte-array 0)] [\"x\" (byte-array 0)]])))\n    18\t    (is (thrown? Exception (dependency/store-bundle! store [[\"../escape\" (byte-array 0)]])))\n    19\t    (let [missing (jing/materialize! store {:schema 1 :entries [[\"x\" address]]})]\n    20\t      (is (thrown? Exception (dependency/fetch-bundle! store missing))))))\n    21\t\n    22\t\n    23\t(deftest bundle-reopens-and-missing-dependencies-refuse\n    24\t  (let [dir (.toFile (java.nio.file.Files/createTempDirectory\n    25\t                       \"d1-dependencies-\" (make-array java.nio.file.attribute.FileAttribute 0)))\n    26\t        spec {:type :file :dir (.getPath dir)}\n    27\t        handle (store/open spec)\n    28\t        address (dependency/store-bundle! handle [[\"compiler.clj\" (.getBytes \"source\\n\" \"UTF-8\")]])]\n    29\t    (try\n    30\t      (jing/close! handle)\n    31\t      (let [reopened (store/open spec)]\n    32\t        (try\n    33\t          (is (= \"source\\n\" (String. ^bytes (second (first (dependency/fetch-bundle! reopened address))) \"UTF-8\")))\n    34\t          (finally (jing/close! reopened))))\n    35\t      (let [other (mem/create-content-mem)\n    36\t            index (let [h (store/open spec)]\n    37\t                    (try (jing/get h address nil) (finally (jing/close! h))))\n    38\t            dangling (jing/materialize! other index)]\n    39\t        (is (thrown? Exception (dependency/fetch-bundle! other dangling))))\n    40\t      (finally\n    41\t        (doseq [f (reverse (file-seq dir))] (.delete f))))))\n     1\t(ns yang.correspondence-static\n     2\t  \"Static C1 production, storage and query measurement; not D1 verification.\"\n     3\t  (:require [dao.jing :as jing]\n     4\t            [dao.jing.cbor :as cbor]\n     5\t            [dao.space.query :as query]\n     6\t            [yang.correspondence-verifier :as verifier]\n     7\t            [yin.vm :as vm]))\n     8\t\n     9\t\n    10\t(defn measure-static!\n    11\t  \"For a retained tree and recorded origin, rederive C1 rows, compare them to\n    12\t   supplied metadata, materialize and fetch both, then query C1 markers. The\n    13\t   handle is caller-supplied so experiments can use fresh stores. No guest runs.\"\n    14\t  [tree origin metadata handle clock]\n    15\t  (when-not (vm/occurrence-origin? origin)\n    16\t    (throw (ex-info \"Invalid occurrence origin\" {:stage :admission})))\n    17\t  (let [elapsed (fn [t] (quot (+ (- (clock) t) 999999) 1000000))\n    18\t        t (clock)\n    19\t        baseline (vm/ast->semantic-bytecode (vm/semantic-bytecode->ast tree))\n    20\t        baseline-ms (elapsed t)\n    21\t        _ (when-not (= tree baseline)\n    22\t            (throw (ex-info \"Baseline row projection differs\" {:stage :root})))\n    23\t        t (clock)\n    24\t        applications (vm/application-occurrences tree)\n    25\t        markers (mapv (fn [[root path]] [origin root path :yang/call-site 1])\n    26\t                      (sort-by pr-str applications))\n    27\t        supplied (filterv #(and (vector? %) (= 5 (count %))\n    28\t                                (= :yang/call-site (nth % 3))) metadata)\n    29\t        _ (when-not (and (= (count supplied) (count (set supplied)))\n    30\t                         (= (set markers) (set supplied)))\n    31\t            (throw (ex-info \"C1 markers differ\" {:stage :metadata})))\n    32\t        marker-ms (elapsed t)\n    33\t        t (clock)\n    34\t        root (vm/materialize-tree! handle tree)\n    35\t        marker-address (jing/materialize! handle markers)\n    36\t        publish-ms (elapsed t)\n    37\t        t (clock)\n    38\t        loaded-tree (verifier/fetch-tree! handle root (inc (count (:rows tree))))\n    39\t        loaded-markers (jing/get handle marker-address ::missing)\n    40\t        _ (when-not (and (= tree loaded-tree) (= markers loaded-markers))\n    41\t            (throw (ex-info \"C1 content differs after fetch\" {:stage :load})))\n    42\t        load-ms (elapsed t)\n    43\t        t (clock)\n    44\t        relation (query/relation (mapv (fn [[o r p a value]] [[o r p] a value 0 nil]) loaded-markers))\n    45\t        relation-ms (elapsed t)\n    46\t        t (clock)\n    47\t        found (set (query/collect (query/q '[:find ?e :where [?e :yang/call-site 1 _ _]] relation)))\n    48\t        expected (set (map (fn [[o r p]] [[o r p]]) loaded-markers))\n    49\t        _ (when-not (= expected found)\n    50\t            (throw (ex-info \"C1 marker query differs\" {:stage :query})))\n    51\t        query-ms (elapsed t)]\n    52\t    {:status :pass :root root :marker-address marker-address :marker-count (count markers)\n    53\t     :marker-bytes (alength (cbor/encode markers))\n    54\t     :phases {:baseline-project-ms baseline-ms :marker-derive-ms marker-ms\n    55\t              :publish-ms publish-ms :load-ms load-ms :relation-build-ms relation-ms :query-ms query-ms}}))\n    56\t\n    57\t\n    58\t(defn compare-static!\n    59\t  \"Measure baseline tree publication/retrieval in one fresh store and C1\n    60\t   rederivation/publication/retrieval/query in another. Both use the exact\n    61\t   same retained root; no guest executes and no new source origin is minted.\"\n    62\t  [tree origin metadata baseline-store c1-store clock]\n    63\t  (when (identical? baseline-store c1-store)\n    64\t    (throw (ex-info \"Baseline and C1 stores must be distinct\" {:stage :configur