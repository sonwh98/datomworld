e (get bindings (:name node))]\n    77\t          (shape value bindings params constructors (inc depth)) :variable))\n    78\t    (and (intra? node) (contains? constructors (get-in node [:operands 0 :name])))\n    79\t    (let [args (args-of (second (:operands node)))\n    80\t          first-arg (first args)]\n    81\t      (cond\n    82\t        (and (= 'kernel-context (get-in node [:operands 0 :name]))\n    83\t             (= :literal (:type first-arg)) (= [{} {}] (:value first-arg))) :ambient-literal\n    84\t        (and (sequential? args) (= 1 (count args))\n    85\t             (= :ambient-literal (shape first-arg bindings params constructors (inc depth)))) :ambient-literal\n    86\t        :else :computed))\n    87\t    (and (= :application (:type node)) (var-node? (:operator node) 'data/nth)\n    88\t         (= 2 (count (:operands node)))\n    89\t         (= :literal (:type (second (:operands node))))\n    90\t         (number? (:value (second (:operands node))))\n    91\t         (pos? (:value (second (:operands node)))))\n   106\t\n   107\t(defn store-recipe!\n   108\t  \"Store a structurally valid recipe after its profile and coverage are present.\n   109\t   This is a publication precondition, not interpretation of either object.\"\n   110\t  [handle recipe]\n   111\t  (when-not (recipe? recipe)\n   112\t    (throw (ex-info \"Malformed correspondence recipe\" {:rule :correspondence/recipe})))\n   113\t  (doseq [address [(:yang.correspondence.recipe/profile recipe)\n   114\t                   (:yang.correspondence.recipe/coverage recipe)]]\n   115\t    (require-content! handle address))\n   116\t  (jing/materialize! handle recipe))\n   117\t\n   118\t\n   119\t(defn store-record!\n   120\t  \"Store a structurally valid correspondence with its direct references present.\n   121\t   Checks declared roots and markers, but not paths, transitive closures,\n   122\t   derivations, or attribution.\"\n   123\t  [handle record]\n   124\t  (when-not (correspond