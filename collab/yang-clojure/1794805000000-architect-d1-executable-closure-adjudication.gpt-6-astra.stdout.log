     row (get-in stored-evidence [:fixtures (:id fixture)])\n  4512\t            before-tree (correspondence-verifier/fetch-tree! reopened (:root stored-snapshot) 100000)\n  4513\t            stamped-tree (correspondence-verifier/fetch-tree! reopened (:stamped-root stored-snapshot) 100000)\n  4514\t            input (assoc stored-snapshot\n  4515\t                         :before (vm/semantic-bytecode->ast before-tree)\n  4516\t                         :stamped (vm/semantic-bytecode->ast stamped-tree)\n  4517\t                         :forms (correspondence-text/read-one! (:id fixture) (:forms-edn stored-input))\n  4518\t                         :call (correspondence-text/read-one! (:id fixture) (:call-edn stored-input))\n  4519\t                         :source-hash (:canonical-source-hash row)\n  4520\t                         :site-table (:site-table row))\n  4521\t            _ (when-not (= correspondence-text/profile stored-profile)\n  4522\t                (throw (ex-info \"Profile missing or changed\" {:fixture (:id fixture) :stage :profile})))\n  4523\t            _ (when-not (= (:admission-origin stored-input) (:origin stored-snapshot))\n  4524\t                (throw (ex-info \"Retained admission differs\" {:fixture (:id fixture) :stage :admission})))\n  4525\t            replay-program (correspondence-text/read-one! (:id fixture) (:program-edn stored-input))\n  4526\t            replay-options (correspondence-text/read-one! (:id fixture) (:options-edn stored-input))\n  4527\t            _ (correspondence-verifier/check-replay-root!\n  4528\t                (:id fixture) (yang/compile-program replay-program true replay-options) (:root stored-snapshot))\n  4529\t            gate (correspondence-verifier/check-fixture! input)\n  4530\t            site-id (first (keys (:site-table row)))\n  4531\t            _ (when-not site-id\n  4532\t                (throw (ex-info \"No declaration to mutate\" {:fixture (:id fixture) :stage :mutation})))\n  4533\t            mutated (assoc-in input [:site-table site-id :arg-shapes] [:forged])\n  4534\t            mutation (try (correspondence-verifier/check-fixture! mutated) nil\n  4535\t                          (catch Exception e (ex-data e)))]\n  4536\t        (when-not (= :site-declarations (:stage mutation))\n  4537\t          (throw (ex-info \"Mutated declaration was not refused\" {:fixture (:id fixture) :stage :mutation})))\n  4538\t        {:gate gate :mutation-stage (:stage mutation) :addresses addresses\n  4539\t         :admission-origin (:origin stored-snapshot) :evidence-address (:evidence addresses)\n  4540\t         :rows {:pre-stamp (count (:rows before-tree))\n  4541\t                :stamped (count (:rows stamped-tree))}\n  4542\t         :sites (count (:site-table row))\n  4543\t         :spot-checks (when spot-check? (d1-spot-check-refusals! input))})\n  4544\t      (finally (when own-store? (file-store/close! reopened))))))\n  4545\t\n  4546\t\n  4547\t(deftest test-d1-persisted-per-fixture-static-gate\n  4548\t  ;; A single fixture and temporary store; this is not a published D1 record.\n   270\t   This query does not validate those inputs or authorize reliance on them.\"\n   271\t  [{:keys [site-table bindings lanes origin root guest-symbol requested-arity carriers]}]\n   272\t  (letfn [(eligible?\n   273\t            [entry]\n   274\t            (when (and (vector? entry) (= 3 (count entry)))\n   275\t              (let [[function arity site] entry\n   276\t                    row (get site-table site)\n   277\t                    key (get bindings site)]\n   278\t                (and row (= site (:site row)) (vector? key) (= 3 (count key))\n   279\t                     (vm/occurrence-origin? origin) (= origin (first key))\n   280\t                     (jing/segment-address? root) (= root (second key)) (vector? (nth key 2))\n   281\t                     (not= :gate-site/none site)\n   282\t                     (or (and (= function guest-symbol) (= arity requested-arity))\n   283\t                         (some (fn [[carrier carrier-arity mode]]\n   284\t                                 (and (contains? #{:ambient-delegation :context-shift :context-copy} mode)\n   285\t                                      (= function carrier) (= arity carrier-arity)\n   286\t                                      (= carrier (:callee row)) (not (:delegation? row))\n   287\t                                      (or (not= :ambient-delegation mode)\n   288\t                                          (= :ambient-literal (first (:arg-shapes row))))))\n   289\t                               carriers))))))]\n   290\t    (every? (fn [lane-id]\n   291\t              (let [lane (get lanes lane-id)]\n   292\t                (and (= :completed (:status lane)) (true? (:complete? lane))\n   293\t                     (some eligible? (:executed-calls lane)))))\n   294\t            [:c-walker :c-semantic])))\n   295\t\n   296\t\n   297\t(defn check-fixture!\n   298\t  \"Run independent static checks for one supplied compilation. This does not\n   299\t   establish admission authenticity, executable-image derivations, trace\n   300\t   completeness, durable retrieval, or D1 reliance.\"\n   301\t  [{:keys [fixture before stamped origin constructors forms call source-hash\n   302\t           site-table bindings metadata]}]\n   303\t  (letfn [(require!\n   304\t            [condition stage]\n   305\t            (when-not condition\n   306\t              (throw (ex-info \"Independent fixture check refused\"\n   307\t                              {:rule :verifier/fixture :fixture fixture :stage stage}))))]\n   308\t    (require! (and fixture (vm/occurrence-origin? origin) (map? before)\n   309\t                   (map? stamped) (set? constructors) (some? forms) (some? call)\n   310\t                   (string? source-hash) (map? site-table) (map? bindings)\n   311\t                   (vector? metadata)) :inputs)\n   312\t    (let [actual-hash (try (yang.correspondence-verifier/source-hash forms call)\n   313\t                           (catch Exception e\n   314\t                             (throw (ex-info \"Source hash reconstruction failed\"\n   315\t                                             {:rule :verifier/fixture :fixture fixture :stage :source-hash} e))))]\n   316\t      (require! (= source-hash actual-hash) :source-hash))\n   317\t    (let [actual-sites (try (site-declarations stamped constructors)\n   318\t                            (catch Exception e\n   319\t                              (throw (ex-info \"Site reconstruction failed\"\n   320\t                                              {:rule :verifier/fixture :fixture fixture :stage :site-declarations} e))))]\n   321\t      (require! (= site-table actual-sites) :site-declarations))\n   322\t    (let [actual-bindings (try (reconstruct-bindings before stamped origin)\n   323\t                               (catch Exception e\n   324\t                                 (throw (ex-info \"Binding reconstruction failed\"\n   325\t                                                 {:rule :verifier/fixture :fixture fixture :stage :bindings} e))))]\n   326\t      (require! (= bindings actual-bindings) :bindings))\n   327\t    (let [tree (vm/ast->semantic-bytecode before)\n   328\t          markers (filterv #(and (vector? %) (= 5 (count %))\n   329\t                                 (= :yang/call-site (nth % 3))) metadata)\n   330\t          keys (mapv #(subvec % 0 3) markers)\n   331\t          expected (into #{} (map (fn [[root path]] [origin root path]))\n   332\t                         (vm/application-occurrences tree))]\n   333\t      (require! (and (nil? (vm/validate-rows tree))\n   334\t                     (every? #(and (vector? %) (= 5 (count %))) metadata)\n   335\t                     (every? #(= 1 (nth % 4)) markers)\n   336\t                     (= (count keys) (count (set keys)))\n   337\t                     (= expected (set keys))) :metadata))\n   338\t    {:fixture fixture :status :static-pass}))\n   339\t\n   340\t\n   341\t(defn fetch-tree!\n   342\t  \"Fetch a bounded complete canonical row closure; refuse missing or invalid rows.\"\n   343\t  [handle root max-rows]\n   344\t  (when-not (and (jing/segment-address? root) (integer? max-rows) (pos? max-rows))\n   345\t    (throw (ex-info \"Invalid row retrieval request\" {:rule :verifier/tree-request})))\n   346\t  (loop [pending [root] rows {}]\n   347\t    (if-let [address (peek pending)]\n   348\t      (if (contains? rows address)\n   349\t        (recur (pop pending) rows)\n   350\t        (do\n   351\t          (when (>= (count rows) max-rows)\n   352\t            (throw (ex-info \"Row closure exceeds bound\" {:rule :verifier/tree-bound :limit max-rows})))\n   353\t          (let [body (jing/get handle address ::missing)\n   354\t                grammar (when (and (vector? body) (seq body))\n   355\t                          (get vm/semantic-bytecode-grammar (first body)))]\n   356\t            (when-not (and grammar (= (count body) (inc (count grammar))))\n   357\t              (throw (ex-info \"Missing or malformed row\" {:rule :verifier/tree-row :address address})))\n   358\t            (let [row (into [address] body)\n   359\t                  children (into []\n   360\t                                 (mapcat (fn [[j [_ kind]]]\n   361\t                                           (let [v (nth row (+ j 2))]\n   362\t                                             (case kind :node [v] :nodes v []))))\n   363\t                                 (map-indexed vector grammar))]\n   364\t              (when-not (every? jing/segment-address? children)\n   365\t                (throw (ex-info \"Malformed child reference\" {:rule :verifier/tree-row :address address})))\n   366\t              (recur (into (pop pending) children) (assoc rows address row))))))\n   367\t      (let [tree {:root root :rows rows}]\n   368\t        (when-let [defect (vm/validate-rows tree)]\n   369\t          (throw (ex-info \"Invalid canonical row closure\" {:rule :verifier/tree :defect defect})))\n   370\t        tree))))\n   371\t\n   372\t\n   373\t(defn check-replay-root!\n   374\t  \"Refuse if a newly compiled replay does not name the retained root.\"\n   375\t  [fixture replayed-ast expected-root]\n   140\t     :refused (get counts :refused 0)\n   141\t     :not-run (get counts :not-run 0)}))\n   142\t\n   143\t(defn corpus-index!\n   144\t  \"Build an index of retained fixture addresses after checking their direct\n   145\t   content and admission coordinates. This is not a recipe or D1 record;\n   146\t   it does not verify transitive row closures or executable dependencies.\"\n   147\t  [handle progress]\n   148\t  (let [outcomes (:outcomes progress)\n   149\t        missing ::missing]\n   150\t    (when-not (and (map? outcomes) (pos-int? (:fixture-count progress))\n   151\t                   (= (:fixture-count progress) (count outcomes)))\n   152\t      (throw (outcome-refusal :corpus-shape {})))\n   153\t    {:scope :retained-static-corpus-index\n   154\t     :not-a-verification-result true\n   155\t     :fixtures\n   156\t     (into {}\n   157\t           (for [[fixture outcome] outcomes]\n   158\t             (do\n   159\t               (checked-outcome fixture outcome)\n   160\t               (when-not (= :pass (:status outcome))\n   161\t                 (throw (outcome-refusal :corpus-incomplete {:fixture fixture})))\n   162\t               (let [addresses (:addresses outcome)\n   163\t                     content (into {} (map (fn [[role address]]\n   164\t                                             [role (jing/get handle address missing)]))\n   165\t                                   (select-keys addresses [:input :snapshot :evidence :profile :root :stamped-root]))\n   166\t                     input (:input content)\n   167\t                     snapshot (:snapshot content)\n   168\t                     origin (:admission-origin outcome)]\n   169\t                 (when (or (some #{missing} (vals content))\n   170\t                           (not= fixture (get-in input [:fixture :id]) (:fixture snapshot))\n   171\t                           (not= origin (:admission-origin input) (:origin snapshot))\n   172\t                           (not= (:root addresses) (:root snapshot))\n   173\t                           (not= (:stamped-root addresses) (:stamped-root snapshot))\n   174\t                           (not (contains? (get-in content [:evidence :fixtures]) fixture)))\n   175\t                   (throw (outcome-refusal :corpus-content {:fixture fixture})))\n   176\t                 [fixture {:admission-origin origin :addresses addresses}]))))}))\n","exit_code":0,"status":"completed"}}
