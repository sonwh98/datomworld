 403\t           (pure 'vec vec [1])\n   404\t           ;; one arity: strict UTF-8 on every host (dao.host.text, slice\n   405\t           ;; H2, ratified OQ11: encoding arity 2 removed from portable profile)\n   406\t           (pure 'bytes->str\n   407\t                 (fn [b] (text/utf8-decode b))\n   408\t                 [1])\n   409\t           ['require (primitive-entry\n   410\t                       'require\n   411\t                       (fn [spec]\n   412\t                         (let [ns-sym (if (vector? spec) (first spec) spec)]\n   413\t                           (effect/make :module/require {:module ns-sym})))\n   414\t                       :effectful [1] #{:module/require})]\n   415\t           ['try-require (primitive-entry\n   416\t                           'try-require\n   417\t                           (fn [spec]\n   418\t                             (let [ns-sym (if (vector? spec) (first spec) spec)]\n   419\t                               (effect/make :module/try-require\n   420\t                                            {:module ns-sym})))\n   421\t                           :effectful [1] #{:module/try-require})]])))\n   422\t\n   423\t\n   424\t(def ^:private primitive-profile-keys\n   425\t  [:yin.k/profile :yin.k/class :yin.k/arities :yin.k/effects\n   426\t   :yin.k/host-state])\n   427\t\n   428\t\n   429\t(def primitive-profiles\n   430\t  \"Portable projection of the standard registry, retained as a convenience.\"\n   431\t  (into {} (map (fn [[name entry]]\n   432\t                  [name (select-keys entry primitive-profile-keys)]))\n   433\t        primitives))\n   434\t\n   435\t\n   436\t(def primitive-canonical-names\n   437\t  \"Canonical-name declarations for intentional aliases in `primitives`.\n   438\t\n   439\t   The table is name -> canonical name, not function -> name, so it remains\n   440\t   plain portable data. `=` and `==` intentionally share one host function.\"\n   441\t  {'== '=})\n   442\t\n   443\t\n   444\t(defn profile-of\n   445\t  \"Return `name`'s published profile from a registry, or nil.\"\n   446\t  [registry name]\n   447\t  (when-let [entry (get registry name)]\n   448\t    (when (and (map? entry) (contains? entry :yin.k/profile))\n   449\t      (select-keys entry primitive-profile-keys))))\n   450\t\n   451\t\n   452\t(defn name-of\n   453\t  \"Reverse-look up `primitive` by host-object identity.\n   454\t\n   455\t   Returns nil when unnamed, `::ambiguous` when several names remain after\n   456\t   applying `canonical-names`, or the one resolved name. The two-argument\n   457\t   form declares no aliases.\"\n   458\t  ([primitive-map primitive]\n   459\t   (name-of primitive-map {} primitive))\n   460\t  ([primitive-map canonical-names primitive]\n   461\t   (let [names (->> primitive-map\n   462\t                    (keep (fn [[name entry]]\n   463\t                            (when (identical? (primitive-function entry)\n   464\t                                              primitive)\n   465\t                              name)))\n   466\t                    (sort-by str)\n   467\t                    vec)]\n   468\t     (case (count names)\n   899\t\n   900\t\n   901\t(defn plain-data?\n   902\t  \"True when `x` is data a row or code datom may carry (§2.2, §2.5): scalars\n   903\t   and collections of them, never a host function or object. Jing's float64\n   904\t   carrier is a scalar: on JS it is how a float keeps its kind in a row.\n   905\t   Metadata travels with the value, so it must be plain data too.\"\n   906\t  [x]\n   907\t  (or (nil? x)\n   908\t      (and (cond (or (boolean? x) (number? x) (cbor/float64? x) (string? x)\n   909\t                     (keyword? x) (symbol? x))\n   910\t                 true\n   911\t                 (map? x) (and (every? plain-data? (keys x))\n   912\t                               (every? plain-data? (vals x)))\n   913\t                 (coll? x) (every? plain-data? x)\n   914\t                 :else false)\n   915\t           (plain-data? (meta x)))))\n   916\t\n   917\t\n   918\t(defn machine-data?\n  1585\t                  nil)))\n  1586\t            (range (count slots)) slots (drop 2 row))))\n  1587\t\n  1588\t\n  1589\t(defn occurrences\n  1590\t  \"§6.1: the occurrence relation of a projected row set — one\n  1591\t   `[root path node]` tuple per place, so a structurally shared subtree\n  1592\t   (§4.4) yields one tuple per place and one node id. Computed by the same\n  1593\t   walk as the projection, so it is generic over every §2.3 tag. It is a\n  1594\t   pure function of the tree and carries no origin; a query fixes origin\n  1595\t   from the composition's side and joins on `[root path]` (§6.1). Assumes\n  1596\t   the walk terminates: projected ids are content addresses of their\n  1597\t   children, so a projected set is acyclic by construction (§4.1).\"\n  1598\t  [{:keys [root rows]}]\n  1599\t  (loop [frontier [[[] root]]\n  1600\t         tuples []]\n  1601\t    (if (empty? frontier)\n  1602\t      (set tuples)\n  1603\t      (let [children (mapcat (fn [[path id]]\n  1604\t                               (let [row (get rows id)]\n  1605\t                                 (map (fn [[step cid]] [(conj path step) cid])\n  1606\t                                      (when row (occurrence-child-places row)))))\n  1607\t                             frontier)]\n  1608\t        (recur children\n  1609\t               (into tuples (map (fn [[path id]] [root path id]) frontier)))))))\n  1610\t\n  1611\t\n  1612\t(defn application-occurrences\n  1613\t  \"The `[root path]` of every `:application` occurrence of the projected\n  1614\t   row set `tree`: the occurrence relation joined on the row tags, with\n  1615\t   no origin — a composition fixes the origin from its own side, as with\n  1616\t   `occurrences`. This is the eligible-site derivation of the call-site\n  1617\t   occurrence contract: one pair per place, so a shared application row\n  1618\t   at two places counts twice.\"\n  1619\t  [{:keys [rows] :as tree}]\n  1620\t  (into #{}\n  1621\t        (comp (filter (fn [[_ _ id]] (= :application (nth (get rows id) 1))))\n  1622\t              (map (fn [[root path _]] [root path])))\n  1623\t        (occurrences tree)))\n  1624\t\n  1625\t\n   145\t  [algorithm s]\n   146\t  (case algorithm\n   147\t    :blake3 (blake3 s)\n   148\t    :sha256 (sha256 s)\n   149\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   150\t                    {:algorithm algorithm}))))\n   151\t\n   152\t\n   153\t(defn canonical-bytes\n   154\t  \"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\n   155\t   of v -- the exact bytes content hashing digests, so\n   156\t   `(digest-bytes algo (canonical-bytes v))` is\n   157\t   `(content-hash v {:algorithm algo})`.\n   158\t   This is the byte form Jing content travels in across a `dao.stream`\n   159\t   boundary.\"\n   160\t  [v]\n   161\t  (cbor/encode v))\n   162\t\n   163\t\n   164\t(defn content-hash\n   165\t  \"Hash the canonical-bytes of v using the specified algorithm (defaulting to\n   166\t   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\n   167\t   Arities: [v] and [v {:keys [algorithm]}].\"\n   168\t  ([v]\n   169\t   (content-hash v {:algorithm default-hash-algorithm}))\n   170\t  ([v opts]\n   171\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\n   172\t     (digest-bytes algo (canonical-bytes v)))))\n   173\t\n   174\t\n   175\t(defn segment-key\n   176\t  \"Mint the content-addressed key for an opaque payload, derived solely from\n   177\t   the payload: :segment/<algorithm-id>-<digest>.\n   178\t   The 1-arg form defaults to default-hash-algorithm (:blake3).\n   179\t   The 2-arg form accepts {:algorithm :sha256} (or any registered algorithm).\"\n   180\t  ([v]\n   181\t   (segment-key v {:algorithm default-hash-algorithm}))\n   182\t  ([v opts]\n   183\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n   184\t         reg (clojure.core/get registry algo)]\n   185\t     (when-not reg\n   186\t       (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n   187\t                       {:algorithm algo})))\n   188\t     (let [algo-id (:address-id reg)\n   189\t           digest (content-hash v {:algorithm algo})]\n   190\t       (keyword \"segment\" (str algo-id \"-\" digest))))))\n   191\t\n   192\t\n   193\t(defn parse-segment-address\n   529\t### 5.3 Row-native prelude\n   530\t\n   531\tThe prelude consumes and returns tree packets. Constructors intern canonical\n   532\trow bodies and return self-contained packets.\n   533\t\n   534\t| Primitive | Meaning |\n   535\t|---|---|\n   536\t| `yin/tag tree` | Root tag. |\n   537\t| `yin/slot tree n` | Root slot at zero-based full-row position `n`; a child slot returns a tree packet. Positions `0` and `1` are invalid. |\n   538\t| `yin/literal value`, `yin/variable sym` | Leaf constructors. |\n   539\t| `yin/lambda params body` | Lambda constructor. |\n   540\t| `yin/application operator operands` | Application with `tail? false`. |\n   541\t| `yin/if test consequent alternate` | Conditional constructor. |\n   542\t| `yin/sequence-body trees` | Reference `do` lowering; empty becomes nil. |\n   543\t| `yin/make-lambda params-tree body` | Reads a literal parameter vector. |\n   544\t| `yin/make-def name-tree value-tree` | Constructs ordinary `yin/def` syntax. |\n   545\t| `yin/name-of tree` | Reads a variable, literal symbol, or literal string name. |\n   546\t| `yin/gensym-sym prefix` | Returns `prefix__<incarnation>_<attempt>_<n>`. |\n   547\t\n   548\tMerging packets verifies that one address denotes one body. Packets are closed\n   549\tplain data; a host object or function in any slot is invalid. Invocation-local\n   550\t`n` starts at zero and escapes only through generated symbols.\n   551\t\n   552\t### 5.4 Standard forms and hygiene\n   668\tit; a newly constructed expander has a new incarnation.\n   669\t\n   670\t### 8.2 Expansion event\n   671\t\n   672\tEach attempt emits one content-addressed row:\n   673\t\n   674\t```clojure\n   675\t[event-address :yin.macro/expand\n   676\t attempt                 ; [incarnation counter]\n   677\t source-batch            ; logical ctx :t\n   678\t origin                  ; [:source source-medium source-batch tree-index] | nil\n   679\t parent-event            ; parent event address | nil\n   680\t input-root              ; call tree root | nil on admission failure\n   681\t call-path               ; occurrence path | nil on admission failure\n   682\t macro-root              ; lambda root | nil on admission failure\n   683\t output-root             ; successful result root | nil on failure\n   684\t error]                  ; plain error map | nil on success\n   685\t```\n   686\t\n   687\t`event-address` hashes the row body. `attempt` makes identical expansions in\n   688\ttwo attempts distinct events. `source-batch` is the pre-increment logical\n   689\t`ctx :t`; there is no duplicate timestamp slot and no host clock. An initial\n   690\texpansion carries `[:source (:source-medium ctx) source-batch tree-index]` and\n   691\tnil `parent-event`. A nested expansion carries its enclosing event address and\n   692\tnil `origin`. Success carries an output and nil error; failure does the\n   693\tinverse.\n   694\t\n   695\tAn admission failure carries its allocated `attempt`, the same\n   696\t`source-batch`, `origin` as\n   697\t`[:source (:source-medium ctx) source-batch nil]`, the plain admission error,\n   698\tand nil for `parent-event`, `input-root`, `call-path`, `macro-root`, and\n   699\t`output-root`. The nil tree index states that the rejected batch could not\n   700\tsafely identify a member tree; the source medium and batch remain observable.\n   701\t\n   702\tThe root slots are content addresses with the same meaning on every medium.\n   703\t`call-path` distinguishes shared application occurrences. It is relative to\n   704\tthe event's `input-root` frame: the selected source tree root after stand-in\n   705\treplacement for an initial expansion, and the parent event's `output-root` for\n   706\ta nested one. A call recognized only after its operator was rewritten is not\n   707\tnested in the operator's expansion. It logs its source occurrence coordinates:\n   708\tthe source `origin`, nil `parent-event`, the frame's `input-root`, and its\n   709\t`call-path` in that frame. Guard and invalid-output errors instead name\n   710\tthe absolute path in the run tree. No medium-local code\n   711\tidentity or identity repair appears in provenance.\n   712\t\n   713\t### 8.3 Log packet\n   714\t\n   715\tWhen a log writer exists, it receives:\n   716\t\n   717\t```clojure\n   718\t[:yin.macro/log event-rows produced-trees]\n   719\t```\n   720\t\n   721\tEvents are in attempt order. `produced-trees` contains the self-contained\n   722\tpackets named by successful events, deduplicated by root address in first-use\n   723\torder. This makes the log independently inspectable. The program medium still\n   724\treceives only the final program tree packet.\n   725\t\n   726\tThe portable chain is:\n   939\t;; Tail marking and lowering (§6, §3.2 steps 6-7)\n   940\t;; =============================================================================\n   941\t\n   942\t(defn- retail\n   943\t  \"Recompute every `tail?` slot below `root`, in context `tail?`, over a\n   944\t   working index; `[index' root']`. Tail-ness is contextual, so one shared\n   945\t   row in two contexts becomes two rows.\"\n   946\t  [index root]\n   947\t  (let [memo (volatile! {})]\n   948\t    (letfn [(go\n   949\t              [index a tail?]\n   950\t              (if-let [hit (get @memo [a tail?])]\n   951\t                [index hit]\n   952\t                (let [row (get index a)\n   953\t                      tag (row-tag row)\n   954\t                      ctxs (case tag\n   955\t                             :lambda [true]\n   956\t                             :if [false tail? tail?]\n   957\t                             (repeat false))\n   958\t                      [index children']\n   959\t                      (reduce (fn [[index acc] [[_ c] t]]\n   960\t                                (let [[index c'] (go index c t)]\n   961\t                                  [index (conj acc c')]))\n   962\t                              [index []]\n   963\t                              (map vector (child-places row) ctxs))\n   964\t                      [index a'] (rebuild-row index row children')\n   965\t                      [index a'] (if (and (= :application tag)\n   966\t                                          (not= tail? (nth (get index a') 4)))\n   967\t                                   (intern-body index (assoc (subvec (get index a') 1) 3 tail?))\n   968\t                                   [index a'])]\n   969\t                  (vswap! memo assoc [a tail?] a')\n   970\t                  [index a'])))]\n   971\t      (go index root true))))\n   972\t\n   973\t\n   974\t(defn mark-tail\n   975\t  \"Recompute all observable tail slots of a tree packet, setting and\n   976\t   clearing marks (§6): the root is in tail context, an `:if` test is\n   977\t   non-tail and its branches inherit, application operators and operands are\n   978\t   non-tail, a lambda body is tail, and every other child is non-tail.\"\n   979\t  [packet]\n   980\t  (let [[index root] (retail (packet-index packet) (first packet))]\n   981\t    (packet-of index root)))\n   982\t\n   983\t\n   984\t(defn- lower-standins\n   985\t  \"Replace every stand-in by the canonical literal of its name.\"\n","exit_code":0,"status":"completed"}}
