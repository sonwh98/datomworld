tree)\n  1236\t                            ev (begin out nil corr)\n  1237\t                            st' (-> st'\n  1238\t                                    (record-event ev)\n  1239\t                                    (update :produced\n  1240\t                                            (fn [p]\n  1241\t                                              (if (some #(= out (first %)) p)\n  1242\t                                                p\n  1243\t                                                (conj p (packet-of (:index st') out))))))]\n  1244\t                        (expand-node st' out\n  1245\t                                     {:path path,\n  1246\t                                      :rel [],\n  1247\t                                      :frame {:parent (first ev), :root out},\n  1248\t                                      :shadow shadow,\n  1249\t                                      :depth (inc depth),\n  1250\t                                      ;; per-occurrence origins read from\n  1251\t                                      ;; the RETAINED correspondence (§2.1,\n  1252\t                                      ;; §8): a `[:retained origin]` names\n  1253\t                                      ;; the incoming origin the syntax\n  1254\t                                      ;; already carried, a `:constructed`\n  1255\t                                      ;; occurrence names the recorded\n  1256\t                                      ;; expansion event — the record the\n  1257\t                                      ;; correspondence is retained in\n  1258\t                                      :origin-of\n  1259\t                                      (fn [abs-path]\n  1260\t                                        (let [o (get corr (subvec abs-path (count path)))]\n  1261\t                                          (if (and (vector? o) (= :retained (first o)))\n  1262\t                                            (second o)\n  1263\t                                            [:expansion (first ev)])))})))))))))))))\n  1264\t\n  1265\t\n  1266\t(defn- expand-children\n  1267\t  \"Expand `row`'s children in order `places` under per-child shadows;\n  1268\t   `[st address']`, rebuilding the row when any child changed.\"\n  1269\t  [st row places shadow-of {:keys [path rel] :as loc}]\n  1270\t  (let [[st children']\n  1271\t        (reduce (fn [[st acc] [coord c]]\n  1272\t                  (if (:error st)\n  1273\t                    (reduced [st acc])\n  1274\t                    (let [[st c'] (expand-node st c\n  1275\t                                               (assoc loc\n  1276\t                                                      :path (conj path coord)\n  1277\t                                                      :rel (conj rel coord)\n  1278\t                                                      :shadow (shadow-of coord)))]\n  1279\t                      [st (conj acc c')])))\n  1280\t                [st []]\n  1281\t                places)]\n  1282\t    (if (:error st)\n  1283\t      [st (first row)]\n  1284\t      (let [[index a'] (rebuild-row (:index st) row places children')]\n  1285\t        [(assoc st :index index) a']))))\n  1286\t\n  1287\t\n  1288\t(defn- expand-node\n  1289\t  \"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\n  1290\t   `rel` path within the current `frame` (`{:root r :parent event|nil\n  1291\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\n  1292\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\n  1293\t   answers, for an ABSOLUTE occurrence path, the origin of the\n  1294\t   admission or generation event that produced the syntax there.\n  1295\t   Every application\n  1296\t   occurrence is recorded under its absolute path as it is visited, so\n  1297\t   the finalizer can name each occurrence's real origin; an occurrence\n  1298\t   replaced by an expansion is re-recorded by the expansion's own walk,\n  1299\t   and a stale entry for a path the finished tree no longer applies at\n  1300\t   is simply never read. Returns `[st address']`; a failure sets\n  1301\t   `(:error st)`.\"\n  1302\t  [st address {:keys [shadow] :as loc}]\n  1303\t  (if (:error st)\n  1304\t    [st address]\n  1305\t    (let [row (get (:index st) address)\n  1306\t          tag (row-tag row)]\n  1307\t      (cond\n  1308\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\n  1309\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\n  1310\t\n  1311\t        (= :application tag)\n  1312\t        (let [st (update-in st [:call-site-origins]\n  1313\t                            assoc (:path loc) ((:origin-of loc) (:path loc)))\n  1314\t              op (nth row 2)\n  1315\t              [st op'] (expand-node st op (-> loc\n  1316\t                                              (update :path conj 2)\n  1317\t                                              (update :rel conj 2)))]\n  1318\t          (if (:error st)\n  1319\t            [st address]\n  1320\t            (let [[index app'] (if (= op op')\n  1321\t                                 [(:index st) address]\n  1322\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\n  1323\t                  st (assoc st :index index)\n  1324\t                  row' (get index app')]\n  1325\t              (if (macro-of st op' shadow)\n  1326\t                ;; recognition is not expansion: depth is unchanged\n  1327\t                (expand-node st app' loc)\n  1328\t                (expand-children st row' (rest (child-places row'))\n  1329\t                                 (constantly shadow) loc)))))\n  1330\t\n  1331\t        :else\n  1332\t        (let [shadow' (if (= :lambda tag) (into shadow (nth row 2)) shadow)]\n  1333\t          (expand-children st row (child-places row)\n  1334\t                           (constantly shadow') loc))))))\n  1335\t\n  1336\t\n  1337\t;; =============================================================================\n  1338\t;; The batch (§3.1, §3.2)\n  1339\t;; =============================================================================\n  1340\t\n  1341\t(defn- log-packet\n  1342\t  [st]\n  1343\t  [:yin.macro/log (:events st) (:produced st)])\n  1344\t\n  1345\t\n  1346\t(defn- with-default-guards\n  1347\t  [ctx]\n  1348\t  (update ctx :guards #(merge default-guards %)))\n  1349\t\n  1350\t\n  1351\t(defn- batch-call-site-claims\n  1352\t  \"The per-member call-site (C1) claim verdicts the encoder recorded on\n  1353\t   `batch`: nil when no member claimed coverage, otherwise one boolean\n  1354\t   per member — the encoder validated every member's markers against\n  1355\t   its own tree at the boundary, so a member whose markers do not\n  1356\t   exactly cover it was refused there, never delivered here. Each\n  1357\t   member's own verdict decides its metadata: only a member that\n  1358\t   claimed coverage finalizes a side table, whatever its siblings\n  1359\t   claimed.\"\n  1360\t  [batch]\n  1361\t  (nth batch 5 nil))\n  1362\t\n  1363\t\n  1364\t(defn- final-call-site-metadata\n  1365\t  \"The call-site occurrence contract's (C1) side table of an expanded\n  1366\t   final tree, as frontend-metadata rows `[origin root path\n  1367\t   :yang/call-site 1]` in printed-row order: one row per\n  1368\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\n  1369\t   that actually executes. The frontend's own markers named the\n  1370\t   pre-expansion tree; expansion, tail marking and stand-in lowering\n  1371\t   recompute roots and paths, so no pre-expansion table can cover this\n  1372\t   tree and the table is finalized here, over the finished rows.\n  1373\t\n  1374\t   Each row's origin is that occurrence's REAL origin (design §2.1,\n  1375\t   §2.3): `occurrence-origins` maps the final occurrence path to the\n  1376\t   origin of the admission or generation event that produced the\n  1377\t   application syntax at that path — the admitted run member's source\n  1378\t   origin for retained syntax (a no-op expansion keeps it valid), and\n  1379\t   the `[:expansion record-address]` of the recorded expansion event\n  1380\t   whose output introduced generated syntax. No expansion-record\n  1381\t   address is fabricated: only event rows the expander actually\n  1382\t   recorded appear. The table is therefore the explicit\n  1383\t   final-root correspondence §2.3 requires — every generated occurrence\n  1384\t   names its producing record, so an attribution consumer can reach the\n  1385\t   event (its input root, call path, macro root, output root) from the\n  1386\t   row alone.\"\n  1387\t  [row-set occurrence-origins admission-origin]\n  1388\t  (vec (sort-by pr-str\n  1389\t                (map (fn [[root path]]\n  1390\t                       [(get occurrence-origins path admission-origin)\n  1391\t                        root path :yang/call-site 1])\n  1392\t                     (vm/application-occurrences row-set)))))\n  1393\t\n  1394\t\n  1395\t(defn expand-batch\n  1396\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1397\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1398\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1399\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1400\t   success changes the store, to the post-harvest store. A success also\n  1401\t   carries `:frontend-metadata` — the C1 side table finalized over the\n  1402\t   final tree (`final-call-site-metadata`), covering the tree that\n  1403\t   actually executes — when, and only when, the selected member itself\n  1404\t   claimed C1 coverage (its own verdict in `batch-call-site-claims`); a\n  1405\t   sibling's claim never manufactures a table for it, and an unclaimed\n  1406\t   batch carries no table at all, never an empty one. The admission\n  1407\t   this expansion produced the tree under rides beside it as\n  1408\t   `:call-site-origin` — the source origin of the admitted run member,\n  1409\t   the key the table is stored and resolved under beside the final\n  1410\t   root address. It is the table's admission key, not a blanket\n  1411\t   stamp: each row's origin is that occurrence's own (§2.1, §2.3) —\n  1412\t   a retained occurrence keeps its own incoming provenance (its\n  1413\t   source origin, or the generating expansion's, however deeply it\n  1414\t   was passed through), and generated syntax carries the\n  1415\t   `[:expansion record-address]` of the recorded expansion event\n  1416\t   whose output introduced it. A context\n  1417\t   store binding a\n  1418\t   reserved name, or holding an entry without the current AST contract,\n  1419\t   is refused (Rule R): it is a composition defect, so it throws rather\n  1420\t   than returning an error.\"\n  1421\t  [batch ctx]\n  1422\t  (check-store! (:store ctx))\n  1423\t  (let [ctx (with-default-guards ctx)\n  1424\t        source-batch (:t ctx)\n  1425\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1426\t        finish (fn [st]\n  1427\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1428\t                   (if-let [e (:error st)]\n  1429\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1430\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1431\t                      :frontend-metadata (:frontend-metadata st),\n  1432\t                      :call-site-origin (:call-site-origin st),\n  1433\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1434\t        {:keys [admitted error]} (admit batch)]\n  1435\t    (if error\n  1436\t      (let [[st counter] (allocate-attempt base)]\n  1437\t        (finish (-> st\n  1438\t                    (record-event (event-row (attempt-id ctx counter) source-batch\n  1439\t                                             (source-origin ctx source-batch nil)\n  1440\t                                             nil nil nil nil nil error nil))\n  1441\t                    (fail error))))\n  1442\t      (let [{:keys [trees indexes index run-index definitions]} admitted\n  1443\t            store0 (or (:store ctx) {})\n  1444\t            store (harvest store0 #(nth indexes %) definitions)\n  1445\t            catalogue (into []\n  1446\t                            (comp (filter :declared?)\n  1447\t                                  (map (fn [{:keys [name tree path value]}]\n  1448\t                                         {:name name,\n  1449\t                                          :macro-tree (packet-of (nth indexes tree) value),\n  1450\t                                          :source [tree path]})))\n  1451\t                            definitions)\n  1452\t            ;; only the run tree is expanded, so only its declarations are\n  1453\t            ;; replaced; every catalogue entry still resolves by index\n  1454\t            [index standins]\n  1455\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1456\t                      (if (= run-index (first source))\n  1457\t                        (let [[index s] (intern-body index [standin-tag name k])]\n  1458\t                          [index (assoc acc (second source) s)])\n  1459\t                        [index acc]))\n  1460\t                    [index {}]\n  1461\t                    (map-indexed vector catalogue))\n  1462\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n  1463\t            st (assoc base :index index :store store)]\n  1464\t        (if-let [e (guard-batch-rows st)]\n  1465\t          (finish (fail st e))\n  1466\t          (let [[st root'] (expand-node st root\n  1467\t                                        {:path [], :rel [],\n  1468\t                                         :frame {:parent nil, :root root,\n  1469\t                                                 :tree-index run-index},\n  1470\t                                         :shadow #{}, :depth 0,\n  1471\t                                         ;; every syntax of the admitted\n  1472\t                                         ;; run tree starts as source\n  1473\t                                         ;; (§2.1); expansions override\n  1474\t                                         ;; below their outputs. The\n  1475\t                                         ;; function answers by absolute\n  1476\t                                         ;; occurrence path and ignores it\n  1477\t                                         ;; here: admitted syntax is all\n  1478\t                                         ;; source\n  1479\t                                         :origin-of\n  1480\t                                         (fn [_]\n  1481\t                                           (source-origin\n  1482\t                                             ctx source-batch run-index))})]\n  1483\t            (if (:error st)\n  1484\t              (finish st)\n  1485\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1486\t                    [index root'] (retail (:index st) root')\n  1487\t                    [index root'] (lower-standins index root')\n  1488\t                    tree (packet-of index root')\n  1489\t                    ;; the ADMISSION origin of this expansion (§2.1):\n  1490\t                    ;; the admitted run member's source origin — the key\n  1491\t                    ;; the side table is stored and resolved under beside\n  1492\t                    ;; the final root address. It is NOT blindly stamped\n  1493\t                    ;; on every row: each row's own origin is the one the\n  1494\t                    ;; occurrence walk recorded (source for retained\n  1495\t                    ;; syntax, the generating event's `[:expansion …]`\n  1496\t                    ;; for generated syntax)\n  1497\t                    origin (source-origin ctx source-batch run-index)\n  1498\t                    ;; the selected member's own verdict decides its\n  1499\t                    ;; metadata; a sibling's claim never manufactures a\n  1500\t                    ;; table for a member that made none\n  1501\t                    claims (batch-call-site-claims batch)\n  1502\t                     metadata (when (and claims (nth claims run-index))\n  1503\t                                (final-call-site-metadata\n  1504\t                                  (packet->row-set tree)\n  1505\t                                  (:call-site-origins st) origin))]\n  1506\t                (if-let [e (valid-tree? tree)]\n  1507\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1508\t                  (finish (assoc st :tree tree :next-store next-store\n  1509\t                                 :frontend-metadata metadata\n  1510\t                                  :call-site-origin (when metadata origin))))))))))))\n  1511\t\n  1512\t\n  1513\t(defn expand\n  1514\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1515\t   the error data.\"\n  1516\t  [batch ctx]\n  1517\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1518\t    (if (= :ok status)\n  1519\t      tree\n  1520\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1521\t\n  1522\t\n  1523\t(defn make-ctx\n  1524\t  \"An expander context. The composition supplies the incarnation `token`\n  1525\t   and the opaque `source-medium` identity (S3.1); the store may be\n  1526\t   seeded with `macro-entry` values. A seeded store binding a reserved\n  1527\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\n  1528\t   whose AST contract is absent (`:contract-missing`) or old\n  1529\t   (`:contract-mismatch`).\"\n  1530\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/clojure_callsite_test.cljc | sed -n '1,140p;250,565p'; rg -n 'expand|origin|correspondence' src/cljc/dao/jing* src/cljc/yin/vm.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/clojure_callsite_test.cljc | sed -n '1,140p;250,565p'; rg -n 'expand|origin|correspondence' src/cljc/dao/jing* src/cljc/yin/vm.cljc\"","aggregated_output":"     1\t(ns yang.clojure-callsite-test\n     2\t  \"Contract C1 for production yang.clojure (Addendum A, design §2): the\n     3\t   `:yang/call-site 1` frontend-metadata annotation of every final\n     4\t   `:application` occurrence, and the complete-coverage validation a\n     5\t   consumer runs against canonical rows.\"\n     6\t  (:require [clojure.test :refer [deftest is testing]]\n     7\t            [clojure.walk :as walk]\n     8\t            [dao.jing :as jing]\n     9\t            [dao.jing.mem :as mem]\n    10\t            [yang.clojure :as yang]\n    11\t            [yang.clojure.prelude :as clj-prelude]\n    12\t            [yang.core.call :as call]\n    13\t            [yang.safepoint :as safepoint]\n    14\t            [yin.vm :as vm]\n    15\t            [yin.vm.data :as data]\n    16\t            [yin.vm.encoder :as encoder]\n    17\t            [yin.vm.linker.closure :as closure]\n    18\t            [yin.vm.linker.publish :as publish]\n    19\t            [yin.vm.macro :as macro]\n    20\t            [yin.vm.module :as module]))\n    21\t\n    22\t\n    23\t(def ^:private origin [:source :program \"batch-1\" 0])\n    24\t\n    25\t\n    26\t(defn- project\n    27\t  [ast]\n    28\t  (let [projected (encoder/project\n    29\t                    (encoder/source-envelope :program \"batch-1\" [ast]))]\n    30\t    {:tree (first (:yin/batch projected))\n    31\t     :metadata (:yin/frontend-metadata projected)}))\n    32\t\n    33\t\n    34\t(defn- eligible-under\n    35\t  \"The eligible set of canonical `tree` under `origin`, derived here\n    36\t   directly from canonical rows and the occurrence relation,\n    37\t   independently of the producer's own helpers.\"\n    38\t  [tree origin]\n    39\t  (into #{}\n    40\t        (comp (filter (fn [[_ _ id]]\n    41\t                        (= :application (nth (get (:rows tree) id) 1))))\n    42\t              (map (fn [[_ path _]] [origin (:root tree) path])))\n    43\t        (vm/occurrences tree)))\n    44\t\n    45\t\n    46\t(defn- eligible\n    47\t  [tree]\n    48\t  (eligible-under tree origin))\n    49\t\n    50\t\n    51\t(defn- occurrence-pairs\n    52\t  \"The `[root-address path]` of every `:application` occurrence of\n    53\t   canonical `tree` — the projection a consumer derives from canonical\n    54\t   rows alone, origin-free (design §2.2: the origin values of a\n    55\t   per-occurrence table are the producer's correspondence claim).\"\n    56\t  [tree]\n    57\t  (into #{}\n    58\t        (comp (filter (fn [[_ _ id]]\n    59\t                        (= :application (nth (get (:rows tree) id) 1))))\n    60\t              (map (fn [[_ path _]] [(:root tree) path])))\n    61\t        (vm/occurrences tree)))\n    62\t\n    63\t\n    64\t(defn- marked-pairs\n    65\t  \"The `[root-address path]` projection of a C1 marker relation.\"\n    66\t  [metadata]\n    67\t  (into #{}\n    68\t        (comp (filter #(= :yang/call-site (nth % 3)))\n    69\t              (map (fn [[_ r path _ _]] [r path])))\n    70\t        metadata))\n    71\t\n    72\t\n    73\t(defn- row-origins\n    74\t  \"The distinct occurrence origins a C1 marker relation carries.\"\n    75\t  [metadata]\n    76\t  (into #{} (map first) (filter #(= :yang/call-site (nth % 3)) metadata)))\n    77\t\n    78\t\n    79\t(defn- expansion-origin?\n    80\t  [o]\n    81\t  (and (vector? o) (= :expansion (first o))))\n    82\t\n    83\t\n    84\t(defn- marked\n    85\t  [metadata]\n    86\t  (into #{}\n    87\t        (comp (filter #(= :yang/call-site (nth % 3)))\n    88\t              (map (fn [[o r path _ _]] [o r path])))\n    89\t        metadata))\n    90\t\n    91\t\n    92\t(defn- failure-rule\n    93\t  [f]\n    94\t  (try (f) ::no-failure\n    95\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n    96\t         (:rule (ex-data e)))))\n    97\t\n    98\t\n    99\t(deftest equality-gate-test\n   100\t  (testing \"native compile: eligible set equals marker set\"\n   101\t    (let [ast (yang/compile '(+ (* 2 3) 4))\n   102\t          {:keys [tree metadata]} (project ast)]\n   103\t      (is (= #{[origin (:root tree) []]\n   104\t               [origin (:root tree) [[3 0]]]}\n   105\t             (marked metadata)))\n   106\t      (is (= (eligible tree) (marked metadata)))\n   107\t      (is (true? (yang/validate-call-site-coverage! tree metadata origin)))\n   108\t      (is (true? (yang/validate-ast-call-sites! ast origin)))\n   109\t      (is (every? (fn [[o r _ k v]]\n   110\t                    (and (= origin o) (= (:root tree) r)\n   111\t                         (= :yang/call-site k) (= 1 v)))\n   112\t                  (filter #(= :yang/call-site (nth % 3)) metadata)))))\n   113\t  (testing \"compile-program, native and argument-vector/outcome paths\"\n   114\t    (doseq [ast [(yang/compile-program\n   115\t                   '[(defn f [x] (+ x 1)) (defn g [x] (f (* x 2))) (g 21)])\n   116\t                 (yang/compile-program\n   117\t                   '[(defn f [x] (+ x 1)) (f 2)] true yang/unit-opts)]]\n   118\t      (let [{:keys [tree metadata]} (project ast)]\n   119\t        (is (= (eligible tree) (marked metadata)))\n   120\t        (is (true? (yang/validate-call-site-coverage! tree metadata origin))))))\n   121\t  (testing \"lower-unit: the linked production path, library included\"\n   122\t    (let [ast (yang/lower-unit '[(defn f [x] (+ x 1)) (f 2)])\n   123\t          {:keys [tree metadata]} (project ast)]\n   124\t      (is (< 10 (count (marked metadata))))\n   125\t      (is (= (eligible tree) (marked metadata)))\n   126\t      (is (true? (yang/validate-call-site-coverage! tree metadata origin)))))\n   127\t  (testing \"the clj prelude module tree is finalized\"\n   128\t    (let [ast yang.clojure.prelude/module-uast\n   129\t          {:keys [tree metadata]} (project ast)]\n   130\t      (is (= (eligible tree) (marked metadata)))\n   131\t      (is (true? (yang/validate-call-site-coverage! tree metadata origin))))))\n   132\t\n   133\t\n   134\t(deftest boundary-test\n   135\t  (testing \"yin/def gets an occurrence annotation\"\n   136\t    (let [ast (yang/compile '(def x (fn [a] (+ a 1))))]\n   137\t      (is (= 1 (:yang/call-site ast)))\n   138\t      (is (= 1 (get-in ast [:operands 1 :body :yang/call-site])))\n   139\t      (is (true? (yang/validate-ast-call-sites! ast origin)))))\n   140\t  (testing \"a dedicated stream operation is not an application site\"\n   250\t                     \"the diagnostic names the double-claimed occurrence\")\n   251\t                 (is (= #{origin other-origin} (set (:origins d)))\n   252\t                     \"the diagnostic names both origins\"))))))))\n   253\t\n   254\t\n   255\t(deftest safepoint-independence-test\n   256\t  (testing \":yang/site marks and :yang/call-site markers are distinct\"\n   257\t    (let [ast (yang/annotate-call-sites\n   258\t                (vary-meta (yang/compile '(fn [x] (inc x)))\n   259\t                           assoc :yang/site :call))\n   260\t          tree (vm/ast->semantic-bytecode ast)\n   261\t          tables (vm/ast-side-tables ast tree origin)]\n   262\t      (is (= {[] :call}\n   263\t             (safepoint/sites (:frontend-metadata tables) origin (:root tree))))\n   264\t      (is (true? (yang/validate-call-site-coverage!\n   265\t                   tree (:frontend-metadata tables) origin)))\n   266\t      (is (not-any? (fn [[_ _ _ k _]] (= :yang/site k))\n   267\t                    (filter #(= :yang/call-site (nth % 3))\n   268\t                            (:frontend-metadata tables)))))))\n   269\t\n   270\t\n   271\t(deftest canonical-invariance-test\n   272\t  (testing \"marking changes no canonical row, root, or outcome input\"\n   273\t    (let [form '(defn f [x] (+ (* x 2) 1))\n   274\t          marked (yang/compile-program [form '(f 21)])\n   275\t          strip (fn strip [node]\n   276\t                  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\n   277\t                    (reduce (fn [n [field kind]]\n   278\t                              (case kind\n   279\t                                :node (update n field strip)\n   280\t                                :nodes (update n field\n   281\t                                               #(mapv strip %))\n   282\t                                n))\n   283\t                            (dissoc node :yang/call-site)\n   284\t                            slots)))]\n   285\t      (is (= (vm/ast->semantic-bytecode (strip marked))\n   286\t             (vm/ast->semantic-bytecode marked))))))\n   287\t\n   288\t\n   289\t(deftest encoder-claim-test\n   290\t  (testing \"canonical-row production refuses a broken C1 claim instead of dropping it\"\n   291\t    (let [ast (yang/compile '(+ (* 2 3) 4))]\n   292\t      (is (= :yang/call-site-incomplete-coverage\n   293\t             (failure-rule\n   294\t               #(encoder/program-batch\n   295\t                  (update-in ast [:operands 0] dissoc :yang/call-site)))))\n   296\t      (is (= :yang/call-site-unsupported-version\n   297\t             (failure-rule\n   298\t               #(encoder/program-batch (assoc ast :yang/call-site 2))))))))\n   299\t\n   300\t\n   301\t(defn- expand-like-the-repl\n   302\t  \"Expand compiled `ast` through the REPL pipeline's production stages:\n   303\t   `encoder/program-batch` (what `yin.repl`'s eval-program appends to\n   304\t   program-in) into the row-native expander, seeded as the REPL seeds\n   305\t   its session expander — the standard forms folded through a throwaway\n   306\t   context, then a fresh session context holding that store. Answers\n   307\t   `{:ctx ctx :result expansion}`, where `ctx`